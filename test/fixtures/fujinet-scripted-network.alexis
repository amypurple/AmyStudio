project "FujiNet scripted network runtime test"

u8 Sequence = 0
u8 Poll = 0
u8 Opened = 0

asm {
  ld d,$71
  ld e,$4F
  ld b,2
  call FN_BEGIN
  ld a,12
  call FN_PARAM8
  xor a
  call FN_PARAM8
  ld ix,TestSpec
  ld b,0
TestSpecLoop:
  ld a,(ix+0)
  inc ix
  call FN_TX_BYTE
  djnz TestSpecLoop
}

call asm FN_COMMIT_BEGIN with hl = address of Sequence
while Poll = 0
  wait 1 frame
  asm {
    ld hl,amy(Sequence)
    call FN_POLL
    ld (amy(Poll)),a
  }
end while
if Poll = 1 then Opened = 1

while 1 = 1
  wait 1 frame
end while

asm {
TestSpec:
  db "N:TCP://127.0.0.1:6502/",0
  ds 229,0
}

include "include/fujinet_mailbox.inc"
