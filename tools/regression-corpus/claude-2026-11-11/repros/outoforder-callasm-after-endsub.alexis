cartridge "CALL ASM AFTER END SUB/CLAUDE/2026"
' Repro: a `call asm` that is the first main-program statement after a
' `sub ... end sub` block is silently dropped (no code emitted, no message).
' Expected at every profile: Hits = 2 (two calls of MyAsm), Other = 7,
' Done = 1. Measured (r7 and r8, all 5 profiles): Hits = 0.
u8 Hits = 0
u8 Other = 0
u8 Done = 0
sub SetOther:
  Other = 7
end sub
  call asm MyAsm
  call asm MyAsm
  SetOther
  Done = 1
idle_here:
  wait
  goto idle_here
asm {
MyAsm:
  ld hl,amy(Hits)
  inc (hl)
  ret
}
