cartridge "FRAMED MODE2 R8 FIX/CLAUDE/2026"
' Regression test for the r8 change (IX/IY guard around Mode 2 setup in
' framed routines): a recursive sub with an IX frame sets Mode 2 and loads
' the font, then reads its local after the nested calls.
' Expected: Got = 100+101+102+103 = 406, Done = 1.
' r7: Got = 56, Done = 0 (IX clobbered, hang) at all 5 profiles.
' r8: Got = 406, Done = 1 at all 5 profiles (fixed).
u16 Got = 0
u8 Done = 0
sub Story(u8 Sn)
  u8 Loc = 0
  Loc = Sn + 100
  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  if Sn > 0 then Story(Sn - 1)
  Got += Loc
end sub
  Story(3)
  Done = 1
  screen on
  nmi on
idle_here:
  wait
  goto idle_here
