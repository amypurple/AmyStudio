cartridge "DECL AFTER STATEMENT/CLAUDE/2026"
' Repro: a global declared after the first executable statement is not
' visible inside subs. Expected: compiles; T = 4 at run time. Measured (r7,
' r8, all profiles): "Transpile failed: Invalid runtime assignment:   T = 4".
  cls
u8 T = 0
sub SetT:
  T = 4
end sub
  SetT
idle_here:
  wait
  goto idle_here
