cartridge "MAIN AFTER SUB/CLAUDE/2026"
' Repro: one executable statement before the first sub definition makes the
' compiler end the main program at that sub: every statement after
' `end sub` up to the next label is silently dropped and the program falls
' into the hidden `AMY_START_FOREVER: jr AMY_START_FOREVER` loop.
' Expected at every profile: Early = 1, Hits = 3, Done = 1 (then idles).
' Measured (r7 and r8, all 5 profiles): Early = 1, Hits = 0, Done = 0, the
' console hangs in AMY_START_FOREVER. No error, no warning.
u8 Early = 0
u8 Hits = 0
u8 Done = 0
  Early = 1
sub Add(u8 N)
  Hits += N
end sub
  Add(3)
  Done = 1
idle_here:
  wait
  goto idle_here
