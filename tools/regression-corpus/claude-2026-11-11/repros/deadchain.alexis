cartridge "DEAD SUB CHAIN/CLAUDE/2026"
' Main code ends in an unconditional goto, then four subs follow with nothing
' between them. r8: no code between the subs, Init inlined at its only call.
' r9: a 3-byte "jp AMY_MAIN_AFTER_SUB_n" after every sub (unreachable chain),
' a "jr AMY_START_FOREVER" at the end, and Init no longer inlined.
u8 A = 0
u8 B = 0
u8 C = 0
  Init
idle_here:
  wait
  StepA
  StepB
  StepC
  goto idle_here
sub Init:
  A = 1
  B = 2
  C = 3
end sub
sub StepA:
  A = A + 1
end sub
sub StepB:
  B = B + A
end sub
sub StepC:
  C = C + B
end sub
