cartridge "BASKET CASE/J. LATIMER/1990"
' BASKET CASE by J. Latimer (C-64, BASIC; ReRUN disk August/September/
' October 1990, listed as "Apple Harvest"), ported to the ColecoVision.
'
' The orchard: 26 apples hang in two trees and fall one after another,
' straight down, 10 pixels a step, to a spot on the grass. The picker
' walks all the time in the last direction chosen (B = left, N = right in
' the original; here the stick); any other key (here the button or stick
' down) stops him. An apple in the basket: 100 points and one bonus
' catch. After the 26th apple: 50 points per catch, the trees are filled
' again and the round restarts. An apple that hits the picker (and not
' the basket) ends the game. That is the whole original game.
'
' Faithfulness: the logic runs in the original's own units (C-64 sprite
' pixels: DX 70..170 in steps of 5, apples 10 px a step, the catch window
' AY D3+10..D3+20 / AX D2..D2+36, the sprite-collision rule PEEK(V+30)=13
' tested with the original sprite masks), and at the original's pace: one
' BASIC pass of the main loop takes 8.4 frames while walking, 3.9 standing,
' 12 for a catch, 7 for a landing (traced in jsc64). Drawing is scaled
' 0.8 x 0.72 to fit the field in columns 4-27, rows 5-22.

const NFT0 = 111
const NFT1 = 45
const NFT2 = 118
const FB1 = 111
const FB2 = 156
const SBody0 = 0
const SFace0 = 4
const SHair0 = 8
const SBody1 = 12
const SFace1 = 16
const SHair1 = 20
const SLegs2 = 24
const SShoe2 = 28
const SLegs3 = 32
const SShoe3 = 36
const SLegs4 = 40
const SShoe4 = 44
const SLegs5 = 48
const SShoe5 = 52
const SBasket = 56
const SApple = 60
const BodyY = 99
const LegsY = 131
const BasketY = 114
const HairY = 82
const FR0 = 2
const FPatAll = 2192
const NP0 = 888
const NP1 = 360
const NP2 = 944
const OP1 = 888
const OP2 = 1248
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndCatch = 6
const SndDie = 7
const SndBonus1 = 8
const SndBonus2 = 9
const SndBonus3 = 10
const SndBonus4 = 11
const SndBonus5 = 12
const SndBonus6 = 13
const SndBonus7 = 14
const SndBonus8 = 15
const SndBonus9 = 16
const SndBonus10 = 17
const SndBonus11 = 18
const SndBonus12 = 19
const SndBonus13 = 20
const SndBonus14 = 21
const SndBonus15 = 22
const SndBonus16 = 23
const SndBonus17 = 24
const SndBonus18 = 25
const SndBonus19 = 26
const SndBonus20 = 27
const SndBonus21 = 28
const SndBonus22 = 29
const SndBonus23 = 30
const SndBonus24 = 31
const SndBonus25 = 32
const SndBonus26 = 33
const SndBonus27 = 34
const SndBonus28 = 35
const SndBonus29 = 36
const SndBonus30 = 37
const SndGameA = 38
const SndGameB = 39
const SndGameC = 40
const SndGameD = 41
const TuneFrames = 512
const GameFrames = 1280
const TxtCredits = 0
const TxtHow1 = 1
const TxtHow2 = 2
const TxtHow3 = 3
const NSpr = 7
const HideY = 192
const DY = 160
const D3 = 168
const D5 = 201
' sprite slots: 0 apple, 1 face, 2 coat, 3 basket, 4 legs, 5 shoes
' (body lines: apple, face, coat, basket = 4; legs lines: apple, basket,
' legs, shoes = 4)
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StRound = 5
const StDie = 6
const StNext = 7
const StOver = 9

' the original's variables
u8 DX = 130
u8 D2 = 179
u8 D4 = 122
u8 P0 = 1
u8 P2 = 4
u8 F1 = 0
u8 F2 = 0
u8 KB = 1
u8 Want = 0
u8 Xi = 0
u8 GP = 26
u8 Ai = 0
u8 AX = 0
u8 AY = 0
u8 AT = 0
u8 AOn = 0
u8 BN = 0
u8 LHit = 0
u8 LBask = 0
u8 Dead = 0
u8 Targets = 0
u8 DrawnX = 130
u8 DrawnX2 = 179
u8 DrawnX4 = 122
u8 AP3[52]
u8 Bd[8]
u8 Bi = 0
u8 Bj = 0
bcd digits 7 SC = 0
bcd digits 7 HS = 0
' what kind of pass ran last (bots): 1 walk, 2 stand, 3 catch, 4 land
u8 PassK = 0
u16 Passes = 0
' frame pacing in 1/16 frames
u8 Acc = 0
u8 Need = 0
' apple drawing into the field tiles
u8 Px = 0
u8 Py = 0
u8 Aj = 0
u8 Ay2 = 0
u8 Tr = 0
u8 Tc = 0
u8 Nm = 0
u8 Mk = 0
u8 Mk2 = 0
u8 Bv = 0
u8 Mode = 0
u16 Va = 0
u16 Ro = 0
' collision test
u8 CM = 0
u8 CSX = 0
u8 CSY = 0
u8 CR = 0
u16 Cx16 = 0
u16 Cy16 = 0
u16 Co = 0
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u16 GzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 GzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  mode 2 screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  sprites double
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

' --- one apple after another (lines 430-480 of the original)
next_apple:
  NewApple
  if Xi = 0 then
    ' the round's first apple: KB$="B" and straight to the walk (line 450)
    KB = 1
    Wt(16)
    MoveMan
    Wt(54)
  end if
apple_step:
  ' line 460: the apple falls 10 pixels
  AY += 10
  AOn = 1
  ShowApple
  Latch
  if AY >= AT then goto landed
  ' line 520: in the basket?
  if AY >= D3 + 10 then
    if AY <= D3 + 20 then
      if AX >= D2 then
        V = D2 + 36
        if AX <= V then goto caught
      end if
    end if
  end if
  Wt(40)
  ' line 580: PEEK(V+30)=13: the apple touched the man and not the basket
  if LHit = 1 then
    if LBask = 0 then goto died
  end if
  LHit = 0
  LBask = 0
  ' line 590: GET K$ (the last key pressed since the last pass)
  if Want > 0 then
    KB = Want
    Want = 0
  end if
  inc Passes
  if KB = 3 then
    PassK = 2
    Wt(23)
    goto apple_step
  end if
  PassK = 1
  Wt(8)
  MoveMan
  Wt(54)
  goto apple_step

caught:
  PassK = 3
  inc Passes
  Wt(48)
  play sound SndCatch
  Wt(16)
  ' line 540: the apple goes, 100 points
  AOn = 0
  ShowApple
  Latch
  SC += 100
  ShowScore
  Wt(32)
  inc BN
  ShowBonus
  Wt(24)
  inc Xi
  if Xi = 26 then goto round_end
  Wt(16)
  goto next_apple

landed:
  ' line 470: it lies on the grass at its spot
  PassK = 4
  inc Passes
  Wt(16)
  T = ApC[Ai]
  Px = ColX[T]
  T = AP3[Ai]
  Py = RowY[T]
  Mode = 1
  DrawApple
  inc Xi
  if Xi = 26 then goto round_end
  Wt(40)
  goto next_apple

round_end:
  ' lines 490-510: 50 points per catch, the grass cleared, the trees filled
  State = StRound
  AOn = 0
  ShowApple
  Latch
  Wt(16)
  for Oi = 1 to 30
    if Oi > BN then goto re_bonus_done
    SC += 50
    ShowScore
    BonusBeep
    Wt(42)
  next
re_bonus_done:
  Wt(16)
  ClearGrass
  NewRound
  goto next_apple

died:
  ' lines 820-930: the picker flashes, the game is over
  State = StDie
  stop sound SndGameA
  stop sound SndGameB
  stop sound SndGameC
  stop sound SndGameD
  GzOn = 0
  for Oi = 0 to 5
    T = DieCol[Oi]
    V = P0 * 12
    V += SFace0
    K = DX + FCrop[P0]
    C = XMap[K]
    set sprite 1 to BodyY,C,V,T
    update sprites
    play sound SndDie
    for Li = 0 to 9
      Frame1
      ReadPad
    next
  next
  HideSprites
  if SC > HS then HS = SC
  ShowHigh
  State = StOver
  print at 2,22, "GAME OVER - PRESS BUTTON"
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub NewGame:
  State = StNext
  ' line 330: each apple's spot on the grass, chosen once per power-on
  if Targets = 0 then
    for Oi = 0 to 51
      Rand
      W16 = Rs % 5
      T = W16
      AP3[Oi] = T + 19
    next
    Targets = 1
  end if
  ' line 340-360: score 0; the apple order alternates between games
  SC = 0
  AOn = 0
  LHit = 0
  LBask = 0
  if GP = 0 then
    GP = 26
  else
    GP = 0
  end if
  DrawField
  ShowScore
  ShowHigh
  StartGameMusic
  NewRound
  return
end sub

' lines 370-420: the man back in the middle, bonus 0, the trees filled
sub NewRound:
  BN = 0
  DX = 130
  D2 = DX + 49
  D4 = DX - 8
  ShowBonus
  for Oi = 0 to 25
    Ai = GP + Oi
    T = ApR[Ai]
    Py = RowY[T]
    T = ApC[Ai]
    Px = ColX[T]
    Mode = 1
    DrawApple
    Wt(27)
  next
  ShowHigh
  Xi = 0
  ' the pass clock and the key buffer start clean every round
  Acc = 0
  Want = 0
  State = StPlay
  return
end sub

' lines 430-440: the next apple leaves its branch
sub NewApple:
  Ai = GP + Xi
  T = ApR[Ai]
  AY = T << 3
  AY += 50
  T = ApC[Ai]
  AX = T << 3
  AX += 23
  T = AP3[Ai]
  AT = T << 3
  AT += 50
  Wt(32)
  T = ApR[Ai]
  Py = RowY[T]
  T = ApC[Ai]
  Px = ColX[T]
  Mode = 0
  DrawApple
  Wt(24)
  return
end sub

' lines 610-800: one step of the walk (pointer, legs, then positions)
sub MoveMan:
  if KB = 1 then
    P0 = 1
    if DX > 74 then
      DX -= 5
    else
      DX = 70
    end if
    Latch
    Wt(16)
    if F1 = 4 then
      F1 = 5
    else
      F1 = 4
    end if
    P2 = F1
    Latch
    Wt(16)
    D2 = DX - 46
    D4 = DX + 8
  else
    P0 = 0
    if DX < 166 then
      DX += 5
    else
      DX = 170
    end if
    Latch
    Wt(16)
    if F2 = 2 then
      F2 = 3
    else
      F2 = 2
    end if
    P2 = F2
    Latch
    Wt(16)
    D2 = DX + 49
    D4 = DX - 8
  end if
  DrawMan
  Latch
  return
end sub

' the collision register: every sprite picture since the last read is
' tested with the original masks (apple 9x8 hi-res; man, legs, basket
' multicolour, expanded). DX is drawn one step late on purpose: the
' pointer changes (lines 610-650) come before the positions (770-790).
sub Latch:
  if AOn = 0 then return
  CM = P0
  CSX = DrawnX
  CSY = DY
  CollT
  if CR > 0 then LHit = 1
  CM = P2
  CSX = DrawnX4
  CSY = D5
  CollT
  if CR > 0 then LHit = 1
  CM = 6
  CSX = DrawnX2
  CSY = D3
  CollT
  if CR > 0 then LBask = 1
  return
end sub

' CR = apple (AX,AY) over mask CM at (CSX,CSY)
sub CollT:
  CR = 0
  Cx16 = AX
  Cx16 += 8
  if Cx16 < CSX then return
  Cx16 -= CSX
  if Cx16 > 55 then return
  Cy16 = AY
  Cy16 += 7
  if Cy16 < CSY then return
  Cy16 -= CSY
  if Cy16 > 48 then return
  Co = CM
  Co = Co * 343
  W16 = Cy16 * 7
  Co += W16
  W16 = Cx16 >> 3
  Co += W16
  Co = Co + @CollTab
  T = peek(Co)
  V = Cx16
  V = V & 7
  K = BitM[V]
  CR = T & K
  return
end sub

' wait N/16 frames (the original's BASIC pace)
sub Wt(u8 N16):
  Need = N16
  Acc += Need
wt_more:
  if Acc < 16 then return
  Acc -= 16
  Frame1
  ReadPad
  goto wt_more
end sub

' 16-bit xorshift
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawMan:
  DrawnX = DX
  DrawnX2 = D2
  DrawnX4 = D4
  ' colours (C-64 -> TMS9918, nearest in CIELAB): grey coat 14, yellow
  ' face 11, brown belt/shoes 10 (dark yellow), orange trousers and basket
  ' 6 (dark red); brown hair 6 too (dark yellow vanishes on the face)
  V = P0 * 12
  K = DX + Crop[P0]
  T = XMap[K]
  set sprite 2 to BodyY,T,V,14
  V += 4
  set sprite 1 to BodyY,T,V,11
  V += 4
  set sprite 6 to HairY,T,V,6
  K = D2 + Crop[7]
  T = XMap[K]
  set sprite 3 to BasketY,T,SBasket,6
  V = P2 - 2
  V = V << 3
  V += SLegs2
  K = D4 + Crop[P2]
  T = XMap[K]
  set sprite 4 to LegsY,T,V,6
  V += 4
  set sprite 5 to LegsY,T,V,10
  update sprites
  return
end sub

sub ShowApple:
  if AOn = 0 then
    set sprite 0 to HideY,0,SApple,0
  else
    T = YMap[AY]
    T -= 1
    V = XMap[AX]
    set sprite 0 to T,V,SApple,8
  end if
  update sprites
  return
end sub

' an apple char drawn into (Mode 1) or erased from (Mode 0) the field
' tiles at pixel Px,Py (6 rows, 7 pixels)
sub DrawApple:
  for Aj = 0 to 5
    Ay2 = Py + Aj
    Tr = Ay2 >> 3
    Tc = Px >> 3
    T = Px & 7
    V = T * 12
    K = Aj << 1
    V += K
    Mk = AppleMask[V]
    inc V
    Mk2 = AppleMask[V]
    ApCell
    inc Tc
    Mk = Mk2
    ApCell
  next
  return
end sub

sub ApCell:
  if Mk = 0 then return
  T = Tr - FR0
  Ro = T
  Ro = Ro << 5
  Ro += Tc
  Ro = Ro + @FieldNames
  Nm = peek(Ro)
  if Nm < 128 then return
  ' VRAM: third * 2048 + name * 8 + line
  T = Tr >> 3
  Va = T
  Va = Va << 11
  W16 = Nm
  W16 = W16 << 3
  Va += W16
  T = Ay2 & 7
  Va += T
  if Mode = 1 then
    vpeek vram.pattern + Va into Bv
    Bv = Bv | Mk
    vpoke vram.pattern + Va, Bv
    vpeek vram.color + Va into Bv
    Bv = Bv & 15
    Bv = Bv | $80
    vpoke vram.color + Va, Bv
    return
  end if
  ' erase: the original bytes (FieldPat/FieldCol: third's tiles in order)
  Ro = Nm - 128
  Ro = Ro << 3
  T = Ay2 & 7
  Ro += T
  T = Tr >> 3
  if T = 0 then W16 = Ro + @FieldPat0
  if T = 1 then W16 = Ro + @FieldPat1
  if T = 2 then W16 = Ro + @FieldPat2
  Bv = peek(W16)
  vpoke vram.pattern + Va, Bv
  if T = 0 then W16 = Ro + @FieldCol0
  if T = 1 then W16 = Ro + @FieldCol1
  if T = 2 then W16 = Ro + @FieldCol2
  Bv = peek(W16)
  vpoke vram.color + Va, Bv
  return
end sub

' line 2000: the grass is cleared, one spot after another
sub ClearGrass:
  for Oi = 0 to 25
    Ai = GP + Oi
    T = ApC[Ai]
    Px = ColX[T]
    T = AP3[Ai]
    Py = RowY[T]
    Mode = 0
    DrawApple
    Wt(26)
  next
  return
end sub

sub BonusBeep:
  T = SndBonus1 - 1
  T += Oi
  play sound T
  return
end sub

' the panel's value bars (rows 7, 10, 14, cols 22-28): the value is
' printed in ASCII, then rewritten left-aligned without leading zeros in
' the bar's own red-on-green digit tiles (names 128-139), as the C-64
' PRINTs it (one space, then the number) -- all within one frame
sub ShowScore:
  print at 22,7, SC
  Ro = 7 * 32 + 22
  BarFix
  return
end sub

sub ShowHigh:
  print at 22,14, HS
  Ro = 14 * 32 + 22
  BarFix
  return
end sub

sub ShowBonus:
  W16 = BN
  print at 22,10, digits$(W16, 4)
  print at 26,10, "*50"
  Ro = 10 * 32 + 22
  BarFix
  return
end sub

sub BarFix:
  for Bi = 0 to 6
    Va = Ro + Bi
    vpeek vram.name + Va into Bv
    Bd[Bi] = Bv
  next
  ' skip leading zeros, keep the last digit before '*' or the end
  Bj = 0
bf_skip:
  if Bj < 6 then
    if Bd[Bj] = 48 then
      T = Bj + 1
      Bv = Bd[T]
      if Bv >= 48 then
        if Bv <= 57 then
          inc Bj
          goto bf_skip
        end if
      end if
    end if
  end if
  ' first cell: a space, unless all 7 cells are needed
  Va = Ro
  if Bj > 0 then
    vpoke vram.name + Va, 139
    inc Va
  end if
  for Bi = Bj to 6
    Bv = Bd[Bi]
    if Bv = 42 then
      Bv = 138
    else
      Bv += 80
    end if
    vpoke vram.name + Va, Bv
    inc Va
  next
  ' pad with spaces to the bar's end
  Bv = Ro + 7
bf_pad:
  T = Va
  if T < Bv then
    vpoke vram.name + Va, 139
    inc Va
    goto bf_pad
  end if
  return
end sub

' the orchard: font in all thirds, field tiles at 96+ of each third
sub DrawField:
  NewScreen
  fill $00 count 256 to vram.color
  fill $00 count 256 to vram.color + 2048
  fill $00 count 256 to vram.color + 4096
  copy FieldPat0 count NP0 to vram.pattern + 1024
  copy FieldPat1 count NP1 to vram.pattern + 3072
  copy FieldPat2 count NP2 to vram.pattern + 5120
  copy FieldCol0 count NP0 to vram.color + 1024
  copy FieldCol1 count NP1 to vram.color + 3072
  copy FieldCol2 count NP2 to vram.color + 5120
  copy FieldNames count 608 to vram.name + 64
  ShowScreen
  DrawMan
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  if GzOn = 1 then
    dec GzLeft
    if GzLeft = 0 then StartGameMusic
  end if
  nmi off
  nmi on
  return
end sub

' the in-game tune loops quietly under the effects
sub StartGameMusic:
  play sound SndGameA
  play sound SndGameB
  play sound SndGameC
  play sound SndGameD
  GzLeft = GameFrames
  GzOn = 1
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = new directions, Press = new button press. In play the stick
' stands for the original's keys: left = B, right = N, down or the
' button = any other key (stop).
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  K = Jk & 4
  if K > 0 then Want = 1
  K = Jk & 8
  if K > 0 then Want = 2
  K = Jk & 2
  if K > 0 then Want = 3
  if Btn > 0 then Want = 3
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker off
  for J = 0 to 6
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: display off, the font in all three thirds
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  load default ascii
  duplicate mode 2 patterns
  fill $F0 count 2048 to vram.color
  fill $F0 count 2048 to vram.color + 2048
  fill $F0 count 2048 to vram.color + 4096
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the orchard with the picker, the menu on a sign in the sky
sub TitlePage:
  State = StNext
  DX = 130
  D2 = 179
  D4 = 122
  P0 = 0
  P2 = 2
  DrawField
  fill $F1 count 512 to vram.color + 256
  fill $F1 count 512 to vram.color + 2304
  ShowScore
  ShowBonus
  ShowHigh
  print at 2,22, "BY J. LATIMER  1990"
  fill 32 count 14 at 4,5
  fill 32 count 14 at 4,6
  fill 32 count 14 at 4,7
  fill 32 count 14 at 4,8
  fill 32 count 14 at 4,9
  fill 32 count 14 at 4,10
  fill 32 count 14 at 4,11
  print at 7,6, "START"
  print at 7,8, "HOW TO PLAY"
  print at 7,10, "CREDITS"
  ' a few apples on the trees
  for Oi = 0 to 25
    T = ApR[Oi]
    Py = RowY[T]
    T = ApC[Oi]
    Px = ColX[T]
    Mode = 1
    DrawApple
  next
  Menu = 0
  ShowMenu
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Want = 0
  return
end sub

sub ShowMenu:
  put char 32 at 5,6
  put char 32 at 5,8
  put char 32 at 5,10
  C = Menu << 1
  C += 6
  put char 62 at 5,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StNext
  NewScreen
  print at 10,2, "BASKET CASE"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,22, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: three pages with the game's own sprites
sub HowTo:
  State = StNext
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the picker with his basket, an apple dropping in
  DX = 110
  D2 = 159
  D4 = 102
  P0 = 0
  P2 = 2
  DrawMan
  AX = 178
  AY = 150
  AOn = 1
  ShowApple
  State = StHow
  PageWait
  if TimedOut = 0 then
    State = StNext
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    print at 8,22, "PRESS THE BUTTON"
    State = StHow
    PageWait
  end if
  if TimedOut = 0 then
    State = StNext
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    ' an apple about to land on his hat
    DX = 110
    D2 = 64
    D4 = 118
    P0 = 1
    P2 = 4
    DrawMan
    AX = 140
    AY = 140
    AOn = 1
    ShowApple
    State = StHow
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

