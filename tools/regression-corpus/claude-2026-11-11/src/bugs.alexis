cartridge "BUGS!/STEVE PROPER/1984"
' BUGS! - Steve Proper, November 1984 (ReRUN "Game Pak", C64 BASIC).
' ColecoVision port in Amy.
'
' Giant, mutant, killer ants walk from the left towards the house; spray
' each six times to kill it. Every few ant steps a mosquito or a bee flies
' across; bees sometimes turn and attack the spray can. Overrun (an ant,
' the mosquito or a bee reaching the right side), stung, or out of spray
' (33 sprays a wave) ends the game. Four kills complete a wave: the ants
' get faster and the spray is refilled.
'
' How the port keeps the original's pace: the C64 game is a BASIC loop
' whose speed is the interpreter's. Each BASIC line of the play loop is one
' label below (Ln50 = line 50 ...) doing exactly what the line does, and
' each one is charged the C64 cycles that line took, measured in jsc64
' (c64/cyc.mjs, traces/*.json; units of 16 cycles). A frame gives 875 units
' (14000 cycles: an NTSC frame minus the KERNAL IRQ and bad lines), so the
' lines run at the original's speed and order, with the original's
' half-step ant animation and sprite updates where the original POKEd them.
' All rules use the original's C64 sprite coordinates; XMap/YMap place the
' sprites on the ColecoVision picture.

const TP0 = 128
const TP1 = 129
const TP2 = 130
const TP3 = 131
const TP4 = 132
const TP5 = 133
const TP6 = 134
const TP7 = 135
const TP8 = 136
const TP9 = 137
const TP10 = 138
const TP11 = 139
const TP12 = 140
const TP13 = 141
const TP14 = 142
const TP15 = 143
const TP16 = 144
const TP17 = 145
const TP18 = 146
const TP19 = 147
const TP20 = 148
const TP21 = 149
const TP22 = 150
const TP23 = 151
const TP24 = 152
const TP25 = 153
const TP26 = 154
const TP27 = 155
const TP28 = 156
const TP29 = 157
const TP30 = 158
const TP31 = 159
const TP32 = 160
const TP33 = 161
const TP34 = 162
const TP35 = 163
const TP36 = 164
const TP37 = 165
const TP38 = 166
const TP39 = 167
const TP40 = 168
const TP41 = 169
const TP42 = 170
const TP43 = 171
const TP44 = 172
const TP45 = 173
const TP46 = 174
const TP47 = 175
const TP48 = 176
const TP49 = 177
const TGred = 178
const TGyel = 179
const TGgrn = 180
const TGoff = 181
const TBlk = 182
const TSky = 183
const TGrass = 184
const SAnt1 = 0
const SAnt2 = 4
const SCan = 8
const SCany = 12
const SCap = 16
const SSprayl = 20
const SSprayr = 24
const SBeer1k = 28
const SBeer1y = 32
const SBeer2k = 36
const SBeer2y = 40
const SBeel2k = 44
const SBeel2y = 48
const SBeelk = 52
const SBeely = 56
const SMosq = 60
const NTiles8 = 456
const SprBytes = 512
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndSpray = 6
const SndHit = 7
const SndKill = 8
const SndZap = 9
const SndBuzz = 10
const SndWhine = 11
const SndAlarm = 12
const SndWave = 13
const SndFall = 14
const SndRise = 15
const SndGameA = 16
const SndGameB = 17
const SndGameC = 18
const SndGameD = 19
const TuneFrames = 504
const TxtHow1 = 0
const TxtHow2 = 1
const TxtHow3 = 2
const TxtCredits = 3
const NSpr = 11
const HideY = 192
const Budget = 875
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StEnd = 8
const StOver = 9
' line indexes for the dispatcher (on Pc goto)
const P50 = 1
const P60 = 2
const P70 = 3
const P80 = 4
const P90 = 5
const P100 = 6
const P110 = 7
const P120 = 8
const P130 = 9
const P140 = 10
const P180 = 11
const P190 = 12
const P200 = 13
const P210 = 14
const P230 = 15
const P240 = 16
const P270 = 17
const P280 = 18
const P290 = 19
const P340 = 20
const P350 = 21
const P360 = 22
const P370 = 23
const P380 = 24
const P390 = 25
const P400 = 26
const P410 = 27
const P420 = 28
const P460 = 29
const P470 = 30
const P480 = 31
const P490 = 32
const P500 = 33
const P510 = 34
const P520 = 35
const P530 = 36
const P570 = 37
const P610 = 38
const P620 = 39
const P630 = 40
const P640 = 41
const P820 = 42
const P830 = 43
const P840 = 44
const P850 = 45
const P860 = 46
' how a game ended (DA in the original: 0 overrun, 4 stung, 5 no spray)
const EOver = 1
const EStung = 4
const ESpray = 5

' ---- the original's variables (C64 units)
i16 AX[4]
u8 AY[4]
u8 AH[4]
u8 ADX[4]
u8 ADY[4]
u8 ACol[4]
u8 AFr[4]
u8 Kills = 0
u8 PX = 150
u8 PY = 150
u8 Joy = 0
i16 BX = 0
u8 BY = 0
u8 DA = 0
u8 D = 6
u8 DL = 5
u8 C = 0
u8 C2 = 0
u8 C3 = 10
u8 C4 = 0
u8 Led = 11
u16 W = 0
u16 Score = 0
u16 Hi = 0
u8 Bonus = 0
' what the C64 screen shows (sprite registers)
u8 CanX = 0
u8 CanY = 0
u8 SprOn = 0
u8 SprX = 0
u8 SprY = 0
u8 BeeX = 0
u8 BeeY = 0
u8 BeePtr = 197
u8 MosX = 0
u8 MosY = 0
' line machine
i16 Credit = 0
u8 Pc = 1
u8 Ended = 0
u8 Ai = 0
u8 Dirty = 0
u16 Passes = 0
' frame / input / misc
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Li = 0
u8 Sx = 0
u8 Sy = 0
u8 Hit = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
i16 Q = 0
i16 Q2 = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 3 then
    HowTo
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  DL = 5
  if Menu = 1 then DL = 11
  if Menu = 2 then DL = 18
  NewGame

play_loop:
  Frame1
  ReadPad
  Joy = Jk | Btn
  Credit += Budget
  goto rl_next
rl_done:
  DrawSprites
  if Ended = 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the play loop, line by line. Each label ends with "Credit -= cost" and
' the next line in Pc; the dispatcher stops when the frame's credit is spent. (Top level, not a
' sub: see work/codex-bugs/repros/bugs-ongoto-sub-target.md)

rl_next:
  if Ended <> 0 then goto rl_done
  if Credit < 0 then goto rl_done
  on Pc goto Ln50,Ln60,Ln70,Ln80,Ln90,Ln100,Ln110,Ln120,Ln130,Ln140,Ln180,Ln190,Ln200,Ln210,Ln230,Ln240,Ln270,Ln280,Ln290,Ln340,Ln350,Ln360,Ln370,Ln380,Ln390,Ln400,Ln410,Ln420,Ln460,Ln470,Ln480,Ln490,Ln500,Ln510,Ln520,Ln530,Ln570,Ln610,Ln620,Ln630,Ln640,Ln820,Ln830,Ln840,Ln850,Ln860
  goto rl_done

' 50 X(C)=X(C)+D: IF X(C)>255 THEN 1660 (overrun)
Ln50:
  inc Passes
  Q = AX[C]
  Q += D
  AX[C] = Q
  ' the C64 lines of a pass cost more while the ant is on screen (traced)
  if Q > 0 then
    Credit -= 1956
  else
    Credit -= 1114
  end if
  Pc = P60
  if Q > 255 then
    Ended = EOver
    goto rl_done
  end if
  goto rl_next

' 60 IF X(C)-D/2>0 THEN POKE V+V(C),X(C)-D/2 (the half step)
Ln60:
  Q = AX[C]
  Q = Q << 1
  Q2 = D
  if Q > Q2 then
    Q = AX[C]
    T = D + 1
    T = T >> 1
    Q2 = T
    Q -= Q2
    ADX[C] = Q
  end if
  Credit -= 406
  Pc = P70
  goto rl_next

' 70 P=PEEK(56320): IF P<117 THEN 460 (fire)
Ln70:
  Credit -= 581
  V = Joy & 16
  if V > 0 then
    Pc = P460
  else
    Pc = P80
  end if
  goto rl_next

' 80 Y=Y+P(P): IF Y>233 OR Y<64 THEN Y=Y-P(P)
Ln80:
  Credit -= 981
  V = Joy & 1
  if V > 0 then
    if PY >= 69 then PY -= 5
  end if
  V = Joy & 2
  if V > 0 then
    if PY <= 228 then PY += 5
  end if
  Pc = P90
  goto rl_next

' 90 X=X+P(P-20): IF X>255 OR X<46 THEN X=X-P(P-20)  (8 directions, 5 px)
Ln90:
  Credit -= 900
  V = Joy & 4
  if V > 0 then
    if PX >= 51 then PX -= 5
  end if
  V = Joy & 8
  if V > 0 then
    if PX <= 250 then PX += 5
  end if
  Pc = P100
  goto rl_next

' 100 POKE V+11,Y: POKE V+10,X: POKE 2040,(PEEK(2040)OR2)-1
Ln100:
  Q = AX[C]
  if Q > 0 then
    Credit -= 2063
  else
    Credit -= 1540
  end if
  CanX = PX
  CanY = PY
  BeeFlip
  Pc = P110
  goto rl_next

' 110 IF X(C)>0 THEN POKE V+V(C),X(C): POKE 2040+C,(PEEK(2040+C)OR2)-1
Ln110:
  Q = AX[C]
  if Q > 0 then
    ADX[C] = Q
    T = AFr[C] ^ 1
    AFr[C] = T
    Credit -= 1281
  else
    Credit -= 199
  end if
  Pc = P120
  goto rl_next

' 120 IF DA=3 THEN 350
Ln120:
  Credit -= 238
  Pc = P130
  if DA = 3 then Pc = P350
  goto rl_next

' 130 C=C+1: IF C<5 THEN 50
Ln130:
  Q = AX[C]
  inc C
  if C < 4 then
    Credit -= 666
    if Q > 0 then Credit -= 121
    Pc = P50
  else
    Credit -= 331
    Pc = P140
  end if
  goto rl_next

' 140 C=1: C2=C2+1: IF C2<C3 THEN 50   (150-170 are REM lines)
Ln140:
  C = 0
  inc C2
  if C2 = 0 then C2 = 255
  Credit -= 1237
  Pc = P50
  if C2 >= C3 then
    Credit -= 350
    Pc = P180
  end if
  goto rl_next

' 180 IF DA THEN ON DA GOTO 230,270
Ln180:
  Credit -= 375
  Pc = P190
  if DA = 1 then Pc = P230
  if DA = 2 then Pc = P270
  goto rl_next

' 190 X(5)=0: DANGER=INT(RND(1)*2)+1 (DA: 1 mosquito, 2 bee)
Ln190:
  Credit -= 1894
  BX = 0
  DA = RandBelow(2)
  inc DA
  Pc = P200
  goto rl_next

' 200 IF DA=2 THEN (bee sound) POKE 2040,198: GOTO 270
Ln200:
  Credit -= 1913
  Pc = P210
  if DA = 2 then
    BeePtr = 198
    play sound SndBuzz
    Pc = P270
  end if
  goto rl_next

' 210 (mosquito sound)
Ln210:
  Credit -= 1875
  play sound SndWhine
  Pc = P230
  goto rl_next

' 230 Y(5)=INT(RND(1)*12)+130: POKE V+13,Y(5): X(5)=X(5)+15
Ln230:
  Credit -= 2188
  T = RandBelow(12)
  T += 130
  BY = T
  MosY = T
  BX += 15
  Pc = P240
  goto rl_next

' 240 IF X(5)<255 THEN POKE V+12,X(5): GOTO 50 / 250 GOTO 1660
Ln240:
  Credit -= 1250
  if BX < 255 then
    MosX = BX
    play sound SndWhine
    Pc = P50
    goto rl_next
  end if
  Ended = EOver
  goto rl_done

' 270 Y(5)=130: POKE V+1,130: IF INT(RND(TI)*14)=1 THEN 340
Ln270:
  Credit -= 1563
  BY = 130
  BeeY = 130
  Pc = P280
  T = RandBelow(14)
  if T = 1 then Pc = P340
  goto rl_next

' 280 IF X(5)>X THEN IF INT(RND(TI)*7)=1 THEN 340
Ln280:
  Credit -= 531
  Pc = P290
  Q = PX
  if BX > Q then
    T = RandBelow(7)
    if T = 1 then Pc = P340
  end if
  goto rl_next

' 290 X(5)=X(5)+12: IF X(5)<255 THEN POKE V,X(5): (flip): GOTO 50 / 300 GOTO 1660
Ln290:
  Credit -= 2219
  BX += 12
  if BX < 255 then
    BeeX = BX
    BeeFlip
    play sound SndBuzz
    Pc = P50
    goto rl_next
  end if
  Ended = EOver
  goto rl_done

' 340 (clear) PRINT "BEE IS ATTACKING": DA=3
Ln340:
  Credit -= 1213
  DA = 3
  ClearMsg
  print at 6,1, "BEE IS ATTACKING"
  play sound SndAlarm
  Pc = P350
  goto rl_done

' 350 T=PEEK(2040): IF X(5)>X THEN X(5)=X(5)-6: IF T>196 THEN POKE 2040,13
Ln350:
  Credit -= 1563
  T = BeePtr
  Q = PX
  if BX > Q then
    BX -= 6
    if T > 196 then BeePtr = 13
  end if
  Pc = P360
  goto rl_next

' 360 IF X(5)<X THEN X(5)=X(5)+6: IF T<196 THEN POKE 2040,198
Ln360:
  Credit -= 500
  Q = PX
  if BX < Q then
    BX += 6
    if T < 196 then BeePtr = 198
  end if
  Pc = P370
  goto rl_next

' 370 IF Y(5)>Y THEN Y(5)=Y(5)-6
Ln370:
  Credit -= 938
  if BY > PY then BY -= 6
  Pc = P380
  goto rl_next

' 380 IF Y(5)<Y-10 THEN Y(5)=Y(5)+6
Ln380:
  Credit -= 294
  T = PY - 10
  if BY < T then BY += 6
  Pc = P390
  goto rl_next

' 390 POKE V,X(5): POKE V+1,Y(5)
Ln390:
  Credit -= 2500
  BeeX = BX
  BeeY = BY
  play sound SndBuzz
  Pc = P400
  goto rl_next

' 400 IF X-18<X(5) AND X+18>X(5) AND Y-14<Y(5) AND Y+14>Y(5) THEN DA=4: GOTO 1670
Ln400:
  Credit -= 500
  Pc = P410
  Q = PX
  Q -= 18
  if BX > Q then
    Q += 36
    if BX < Q then
      T = BY + 14
      if T > PY then
        T = PY + 14
        if BY < T then
          DA = 4
          Ended = EStung
          goto rl_done
        end if
      end if
    end if
  end if
  goto rl_next

' 410 C=C+1: IF C<5 THEN 50
Ln410:
  Credit -= 688
  inc C
  Pc = P50
  if C >= 4 then Pc = P420
  goto rl_next

' 420 C=1: GOTO 50
Ln420:
  Credit -= 606
  C = 0
  Pc = P50
  goto rl_next

' 460 P=P+16: (spray sound on)
Ln460:
  Credit -= 2313
  play sound SndSpray
  Pc = P470
  goto rl_next

' 470 C4=C4+1: IF C4=3 THEN LED=LED-1: C4=0: POKE LED,0: IF LED=55353 THEN DA=5: GOTO 1670
Ln470:
  Credit -= 1363
  inc C4
  Pc = P480
  if C4 = 3 then
    C4 = 0
    dec Led
    T = Led + 12
    put char TGoff at T,2
    if Led = 0 then
      DA = 5
      Ended = ESpray
      goto rl_done
    end if
  end if
  goto rl_next

' 480 (spray sprite on) POKE V+14,X-45: POKE V+15,Y-7
Ln480:
  Ai = 0
  Credit -= 1094
  SprOn = 1
  SprX = PX - 45
  SprY = PY - 7
  Pc = P490
  goto rl_next

' 490 IF DA=1 THEN IF Y(5)<Y-16 OR Y(5)>Y OR X-10<X(5) OR X-40>X(5)+25 THEN 570
Ln490:
  Credit -= 2069
  Pc = P500
  if DA = 1 then
    Hit = 1
    T = PY - 16
    if BY < T then Hit = 0
    if BY > PY then Hit = 0
    Q = PX
    Q -= 10
    if Q < BX then Hit = 0
    Q -= 30
    Q2 = BX
    Q2 += 25
    if Q > Q2 then Hit = 0
    if Hit = 0 then Pc = P570
  end if
  goto rl_next

' 500 IF Y(5)<Y-16 OR Y(5)>Y OR 5+X<X(5) OR X-45>X(5)+25 THEN 570
Ln500:
  Credit -= 213
  Hit = 1
  T = PY - 16
  if BY < T then Hit = 0
  if BY > PY then Hit = 0
  Q = PX
  Q += 5
  if Q < BX then Hit = 0
  Q -= 50
  Q2 = BX
  Q2 += 25
  if Q > Q2 then Hit = 0
  Pc = P510
  if Hit = 0 then Pc = P570
  goto rl_next

' 510 IF DA=2 THEN SC=SC+6
Ln510:
  Credit -= 250
  if DA = 2 then Score += 6
  Pc = P520
  goto rl_next

' 520 IF DA=3 THEN (clear) BONUS POINTS: T (0-50), SC=SC+T+6
Ln520:
  Credit -= 313
  if DA = 3 then
    Credit -= 1563
    T = RandBelow(6)
    Bonus = T * 10
    ClearMsg
    print at 6,1, "BONUS POINTS:"
    NumU = Bonus
    Sx = 20
    PrintNum
    Score += Bonus
    Score += 6
  end if
  Pc = P530
  goto rl_done

' 530 SC=SC+12: (bee and mosquito off) DA=0: C2=0: C3=INT(RND(TI)*10)
' (X(5), Y(5) are NOT cleared, as in the original)
Ln530:
  Credit -= 2813
  Score += 12
  MosY = 0
  BeeX = 0
  BeeY = 0
  stop sound SndBuzz
  stop sound SndWhine
  play sound SndZap
  DA = 0
  C2 = 0
  C3 = RandBelow(10)
  Pc = P570
  goto rl_next

' 570-600 FOR I=1 TO 4: (flip) IF ant I in the spray THEN GOSUB 700 (hit)
'          IF H(I)=6 THEN (hide) H(I)=0: H(6)=H(6)+1: GOSUB 680 (respawn)
' (one ant per dispatch: each iteration costs ~4 frames of C64 time anyway)
Ln570:
  SprayAnt
  inc Ai
  if Ai < 4 then goto rl_done
  Ai = 0
  Credit -= 310
  Pc = P610
  goto rl_done

' 610-620 (spray sound and sprite off)
Ln610:
  Credit -= 1856
  SprOn = 0
  Pc = P620
  goto rl_next

Ln620:
  Credit -= 706
  Pc = P630
  goto rl_next

' 630 IF H(6)>3 THEN W=W+1: GOTO 820
Ln630:
  Credit -= 94
  Pc = P640
  if Kills > 3 then
    inc W
    Pc = P820
  end if
  goto rl_next

' 640 GOTO 80
Ln640:
  Credit -= 269
  Pc = P80
  goto rl_next

' 820 FOR I=1 TO 5: H(I)=0: NEXT: H(6)=H(6)-4
Ln820:
  Credit -= 2444
  for Li = 0 to 3
    AH[Li] = 0
  next
  Kills -= 4
  Pc = P830
  goto rl_next

' 830 (volume) C=1
Ln830:
  Credit -= 881
  C = 0
  Pc = P840
  goto rl_next

' 840 IF D<20 THEN D=D+1
Ln840:
  Credit -= 975
  if D < 20 then inc D
  Pc = P850
  goto rl_next

' 850 SPRAY gauge full
Ln850:
  Credit -= 869
  Led = 11
  DrawGauge
  Pc = P860
  goto rl_done

' 860 (all sprites on) GOSUB 750 (WAVE: W COMPLETED): GOTO 50
Ln860:
  Credit -= 1669
  ClearMsg
  print at 6,1, "WAVE:"
  NumU = W
  Sx = 12
  PrintNum
  Sx += 1
  print at Sx,1, "COMPLETED"
  if W > 0 then play sound SndWave
  Pc = P50
  goto rl_done

' ---------------------------------------------------------------------------
' random numbers: 16-bit xorshift (byte steps), stirred every title frame

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  ' (Rs low byte * M) / 256: a modulo here cost up to 2 frames
  W16 = Rs & 255
  W16 = W16 * M
  W16 = W16 >> 8
  Rv = W16
  return Rv

' ---------------------------------------------------------------------------
' NEW GAME SET UP (lines 900-930), then WAVE SET UP (820-860)

sub NewGame:
  Score = 0
  W = 0
  D = DL
  DA = 0
  PX = 150
  PY = 150
  C2 = 0
  C3 = 10
  C4 = 0
  BX = 0
  BY = 0
  BeeX = 0
  BeeY = 0
  BeePtr = 197
  MosX = 0
  MosY = 0
  SprOn = 0
  CanX = 0
  Kills = 4
  AX[0] = 0
  AX[1] = -60
  AX[2] = -120
  AX[3] = -180
  for Li = 0 to 3
    AH[Li] = 0
    ADX[Li] = 0
    ACol[Li] = 10
    AFr[Li] = 0
    T = RandBelow(55)
    T += 165
    AY[Li] = T
    ADY[Li] = T
  next
  Ended = 0
  Passes = 0
  Led = 11
  Credit = 0
  DrawPlay
  play sound SndGameA
  play sound SndGameB
  play sound SndGameC
  play sound SndGameD
  Pc = P820
  State = StPlay
  return
end sub

' one iteration of the spray loop (lines 570-600) for ant Ai, with its cost
sub SprayAnt:
  Credit -= 3000
  BeeFlip
  ' 580 IF 5+X>X(I) AND X-35<X(I)+35 AND Y(I)>Y-20 AND Y(I)<Y+2 THEN GOSUB 700
  Credit -= 394
  Hit = 0
  Q = PX
  Q += 5
  Q2 = AX[Ai]
  if Q > Q2 then
    Q -= 75
    if Q < Q2 then
      T = PY - 20
      if AY[Ai] > T then
        T = PY + 2
        if AY[Ai] < T then Hit = 1
      end if
    end if
  end if
  if Hit = 1 then
    ' 700 H(I)=H(I)+1: POKE V+39+I,C(H(I)): SC=SC+1
    Credit -= 938
    T = AH[Ai] + 1
    AH[Ai] = T
    ACol[Ai] = HitCol[T]
    inc Score
    play sound SndHit
  end if
  ' 590 IF H(I)=6 THEN POKE V+V(I),0: H(I)=0: H(6)=H(6)+1: GOSUB 680
  Credit -= 150
  if AH[Ai] = 6 then
    ADX[Ai] = 0
    AH[Ai] = 0
    inc Kills
    play sound SndKill
    ' 680 X(I)=-(INT(RND(TI)*170)+1)  690 Y(I)=INT(RND(TI)*55)+1+164
    Credit -= 2552
    T = RandBelow(170)
    inc T
    Q = 0
    Q2 = T
    Q -= Q2
    AX[Ai] = Q
    T = RandBelow(55)
    T += 165
    AY[Ai] = T
    ADY[Ai] = T
  end if
  return
end sub

' POKE 2040,(PEEK(2040)OR2)-1: the bee's two wing frames (197/198 or 13/14)
sub BeeFlip:
  T = BeePtr | 2
  T -= 1
  BeePtr = T
  return
end sub

' NumU printed at (Sx, 1) without leading spaces; Sx = the column after it
sub PrintNum:
  if NumU < 10 then
    print NumU at Sx,1 width 1
    Sx += 1
    return
  end if
  if NumU < 100 then
    print NumU at Sx,1 width 2
    Sx += 2
    return
  end if
  if NumU < 1000 then
    print NumU at Sx,1 width 3
    Sx += 3
    return
  end if
  print NumU at Sx,1 width 5
  Sx += 5
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,1
  return
end sub

' the spray gauge, as on the C64 (row 1 under the WAVE message, "SPRAY:"
' then 4 red, 3 yellow, 4 green solid cells): row 2, columns 12-22
sub DrawGauge:
  print at 6,2, "SPRAY:"
  for J = 0 to 10
    T = TGgrn
    if J < 7 then T = TGyel
    if J < 4 then T = TGred
    if J >= Led then T = TGoff
    K = J + 12
    put char T at K,2
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite slots: 0 cap, 1 can (white), 10 can (yellow stripes), 2-3 spray,
' 4-5 bee (or 4 the mosquito), 6-9 ants
sub DrawSprites:
  Sx = XMap[CanX]
  Sy = YMap[CanY]
  if CanX = 0 then Sy = HideY
  set sprite 0 to Sy,Sx,SCap,1
  set sprite 1 to Sy,Sx,SCan,15
  set sprite 10 to Sy,Sx,SCany,11
  if SprOn = 1 then
    Sx = XMap[SprX]
    Sy = YMap[SprY]
    ' the C64 border hid what was left of the picture
    if Sx < 16 then Sx = 16
    set sprite 2 to Sy,Sx,SSprayl,11
    Sx += 16
    set sprite 3 to Sy,Sx,SSprayr,11
  else
    set sprite 2 to HideY,0,SSprayl,0
    set sprite 3 to HideY,0,SSprayr,0
  end if
  if DA = 1 then
    Sx = XMap[MosX]
    Sy = YMap[MosY]
    if MosY = 0 then Sy = HideY
    if MosX = 0 then Sy = HideY
    if Sx < 16 then Sy = HideY
    set sprite 4 to Sy,Sx,SMosq,1
    set sprite 5 to HideY,0,SMosq,0
  else
    Sx = XMap[BeeX]
    Sy = YMap[BeeY]
    if BeeY = 0 then Sy = HideY
    if BeeX = 0 then Sy = HideY
    if Sx < 16 then Sy = HideY
    T = SBeer1k
    if BeePtr = 198 then T = SBeer2k
    if BeePtr = 13 then T = SBeel2k
    if BeePtr = 14 then T = SBeelk
    set sprite 4 to Sy,Sx,T,1
    T += 4
    set sprite 5 to Sy,Sx,T,11
  end if
  for Li = 0 to 3
    K = Li + 6
    T = ADX[Li]
    Sx = XMap[T]
    V = ADY[Li]
    Sy = YMap[V]
    if T = 0 then Sy = HideY
    if Sx < 16 then Sy = HideY
    T = SAnt1
    if AFr[Li] = 1 then T = SAnt2
    V = ACol[Li]
    set sprite K to Sy,Sx,T,V
  next
  update sprites
  return
end sub

sub DrawPlay:
  NewScreen
  fill $D1 count 1024 to vram.color
  decompress zx0 PicNameZ to vram.name
  DrawGauge
  ShowScreen
  DrawSprites
  return
end sub

' TAB KEEPER (lines 1660-1760): the ending message with the falling
' sound, the score, the high score; then one press returns to the title
sub GameOver:
  State = StEnd
  SprOn = 0
  DrawSprites
  ClearMsg
  if Ended = EOver then print at 4,1, "YOU'VE BEEN OVER RUN!"
  if Ended = EStung then print at 4,1, "YOU HAVE BEEN STUNG!"
  if Ended = ESpray then print at 4,1, "RAN OUT OF SPRAY!"
  stop sound SndBuzz
  stop sound SndWhine
  stop sound SndGameA
  stop sound SndGameB
  stop sound SndGameC
  stop sound SndGameD
  mute all
  play sound SndFall
  WaitN(150)
  ClearMsg
  print at 4,1, "SCORE:"
  NumU = Score
  Sx = 11
  PrintNum
  WaitN(140)
  ClearMsg
  if Score = Hi then
    print at 4,1, "TIED HIGH SCORE!"
  end if
  if Score < Hi then
    print at 4,1, "HIGH SCORE:"
    NumU = Hi
    Sx = 16
    PrintNum
  end if
  if Score > Hi then
    print at 4,1, "NEW HIGH SCORE:"
    NumU = Score
    Sx = 20
    PrintNum
    play sound SndRise
    Hi = Score
  end if
  WaitN(140)
  ClearMsg
  print at 4,1, "SCORE:"
  NumU = Score
  Sx = 11
  PrintNum
  fill 32 count 28 at 2,22
  print at 8,22, "PRESS THE BUTTON"
  WaitN(30)
  return
end sub

sub WaitN(u8 N):
  Sy = N
  while Sy > 0
    Frame1
    dec Sy
  end while
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 10
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  ' the logo: rows 2-6, from LogoMap (0 = empty, 1 = block)
  for Li = 0 to 4
    for J = 0 to 19
      K = Li * 20
      K += J
      if LogoMap[K] = 1 then
        T = J + 6
        V = Li + 2
        put char TBlk at T,V
      end if
    next
  next
  print at 8,8, "BY STEVE PROPER"
  print at 11,10, "BEGINNER"
  print at 11,12, "INTERMEDIATE"
  print at 11,14, "PROFESSIONAL"
  print at 11,16, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  ' a grass strip with two ants marching under the menu
  fill TGrass count 28 at 2,21
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
  Sx = 0
tp_loop:
  Frame1
  Rand
  ReadPad
  ' two ants walking along the grass
  T = Tick & 7
  if T = 0 then
    Sx += 3
    if Sx < 16 then Sx = 16
    if Sx > 124 then Sx = 16
    V = Tick & 8
    K = SAnt1
    if V > 0 then K = SAnt2
    set sprite 6 to 151,Sx,K,10
    V = Sx + 96
    set sprite 7 to 151,V,K,10
    update sprites
  end if
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  for J = 0 to 4
    K = J << 1
    K += 10
    put char 32 at 9,K
  next
  K = Menu << 1
  K += 10
  put char 62 at 9,K
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  print at 13,2, "BUGS!"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: three pages, pictures made of the game's own sprites/tiles
sub HowTo:
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the picture: the house, the grass, ants walking to it, the can spraying
  fill TGrass count 28 at 2,17
  put char TGrass at 2,17
  set sprite 6 to 119,40,SAnt1,10
  set sprite 7 to 119,96,SAnt2,10
  set sprite 0 to 111,180,SCap,1
  set sprite 1 to 111,180,SCan,15
  set sprite 10 to 111,180,SCany,11
  set sprite 2 to 116,140,SSprayl,11
  set sprite 3 to 116,156,SSprayr,11
  update sprites
  print at 8,21, "PRESS THE BUTTON"
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    ' an ant after each hit: its colour
    for Li = 0 to 5
      K = Li * 32
      K += 24
      V = HitCol[Li]
      set sprite Li to 143,K,SAnt1,V
    next
    update sprites
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    for J = 15 to 17
      fill TSky count 18 at 3,J
    next
    set sprite 0 to 119,40,SBeer1k,1
    set sprite 1 to 119,40,SBeer1y,11
    set sprite 2 to 119,120,SMosq,1
    update sprites
    for J = 0 to 10
      T = TGgrn
      if J < 7 then T = TGyel
      if J < 4 then T = TGred
      K = J + 13
      put char T at K,19
    next
    print at 4,19, "SPRAY"
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

' the ant's colour after each hit (C64 6 blue, 2 red, 11 grey, 7 yellow,
' 13 light green, 9 brown; brown is also the starting colour). TMS has no
' brown: C64 brown (VICE 119,83,0) -> 10 dark yellow (same hue, ochre);
' red (175,60,88) -> 6 dark red (nearest)
data HitCol bytes 10,4,6,14,11,3,10

