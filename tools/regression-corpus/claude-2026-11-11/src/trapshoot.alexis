cartridge "TRAP SHOOT/LEE FRALEY/1985"
' TRAP SHOOT by Lee Fraley (C64 BASIC, ReRUN "Game Pak", RUN magazine).
' ColecoVision port in Amy. The game: a clay bird flies out of the trap house;
' move the black sight with the stick and fire (one shot a bird). 25 birds,
' five from each of five posts; the man walks to the next post by himself.
' Score = birds hit out of 25; the high score stays until power off.
'
' How the port keeps the original's pace: the C64 runs the BASIC listing at
' about 4.8 passes a second. The port runs the listing as a "line machine":
' every frame gets 14000 C64 cycles (875 units of 16 cycles) and each group
' of lines (a segment) costs what it was measured to cost in jsc64
' (c64/cyc.mjs traces, README "Timing"). Input is read, sprites are moved
' and collisions are latched at the same points of the pass as on the C64.
' All game logic runs in the C64's own sprite coordinates (X 0..511 with the
' MSB register $D010, Y 0..255); the screen shows them through tables made by
' art.py (x = 16 + 0.7 sx, y = 16 + 0.87 (sy - 16)). Collisions are pixel
' exact against the C64 sprite shapes (bit tables from art.py), latched like
' $D01E: the shot hits when the latch read at line 111 is exactly 6 (sight +
' clay, the man not touching either).

const SSight = 0
const SClay3 = 4
const SClay2 = 8
const SClay1 = 12
const SPiece1 = 16
const SPiece2 = 20
const SPiece3 = 24
const SPiece4 = 28
const SPiece5 = 32
const SPiece6 = 36
const SPiece7 = 40
const SPiece8 = 44
const SPiece9 = 48
const SPiece10 = 52
const SPiece11 = 56
const SPiece12 = 60
const SPiece13 = 64
const SPiece14 = 68
const SPiece15 = 72
const SPiece16 = 76
const SPiece17 = 80
const SPiece18 = 84
const SPiece19 = 88
const SPiece20 = 92
const SPiece21 = 96
const TGreen = 131
const NbS = 6
const NbM = 9
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndShot = 6
const TuneFrames = 896
const TxtHow1 = 0
const TxtHow2 = 1
const TxtHow3 = 2
const TxtCredits = 3
const HideY = 192
const FrameCyc = 875
' segment costs (C64 cycles / 16), from c64/cyc.mjs traces (README)
const CL100 = 695
const CL100W = 651
const CMove = 4414
const CAxis = 306
const CL111 = 1784
const CL111W = 1743
const CShot = 3217
const CHit = 918
const CL200 = 1403
const CL210 = 451
const CL211 = 159
const CL212 = 254
const CL299 = 1861
const CL300 = 1509
const CL302 = 733
const CPost1 = 2672
const CPostN = 2542
const CL502 = 1822
const CL900 = 260
const CWalk1 = 1631
const CWalk2a = 2141
const CWalk2b = 1901
const CL512 = 1638
const CL590 = 1714
const CL591 = 1252
const CL303 = 231
const CL397 = 925
const CL398 = 3694
const CL399 = 928
' segments of the pass (Pc)
const P100 = 0
const P101 = 1
const P111 = 2
const P200 = 3
const P299 = 4
const P300 = 5
const PPost = 6
const P502 = 7
const P900 = 8
const PW1 = 9
const PW2 = 10
const P512 = 11
const P590 = 12
const P591 = 13
const P303 = 14
const P397 = 15
const P398 = 16
const P399 = 17
const PEnd = 18
const P811 = 19
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StSee = 5
const StNext = 8
const StOver = 9

' --- the C64 program's variables (same names as the listing)
i16 X2 = 0
i16 Y2 = 0
i16 X3 = 0
i16 Y3 = 0
i16 D1 = 0
i16 D2 = 0
i16 X1 = 0
i16 Xo = 0
i16 Tw = 0
i16 Tend = 0
u8 H = 0
u8 WB = 0
u8 SC = 0
u8 PO = 0
u8 DI = 5
u8 S = 15
u8 KL = 0
u8 JV = 0
u8 U = 0
u8 Hi = 0
' --- the VIC-II registers the listing pokes (what the screen shows)
u8 VM = 0
u8 RX1 = 0
u8 RX2 = 0
u8 RY2 = 0
u8 RX3 = 0
u8 RY3 = 0
u8 CP = 193
u8 MP = 191
u8 Lat = 0
u8 SightOn = 0
u8 ManOn = 0
u8 ClayOn = 0
' --- the line machine
i16 Credit = 0
u8 Pc = 0
u8 HudDirty = 0
u8 ManDirty = 0
u8 ManL = 255
u8 ManP = 0
u8 PendMan = 0
' --- collision scratch
u16 SXf = 0
u16 CXf = 0
u16 MXf = 0
i16 Dx = 0
i16 Dy = 0
u16 Iw = 0
u16 Ib = 0
u8 Cb = 0
u8 Bm = 0
' --- frame, menus
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u16 Waited = 0
u16 NumU = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 Rep = 0
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Li = 0
u8 Ri = 0
u8 Li2 = 0
u8 C = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u16 Q = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 3 then
    SeeOne
    goto title
  end if
  if Menu = 4 then
    HowTo
    goto title
  end if
  if Menu = 5 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  Flush
  ReadPad
  Credit += FrameCyc
run_seg:
  if Credit > 0 then
    RunSeg
    if Pc <> PEnd then goto run_seg
  end if
  if Pc <> PEnd then goto play_loop

  ' game over (listing 600-601): the last HUD stays, then GAME OVER
  Frame1
  Flush
  State = StOver
  GameOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  State = StNext
  goto title

' ---------------------------------------------------------------------------
' the listing, segment by segment

sub RunSeg:
  if Pc = P100 then
    ' 100: JV = FN JO(.): IF WB THEN 111
    JV = Jk
    if WB = 1 then
      Credit -= CL100W
      Pc = P111
    else
      Credit -= CL100
      Pc = P101
    end if
    return
  end if
  if Pc = P101 then
    MoveSight
    Pc = P111
    return
  end if
  if Pc = P111 then
    ' 111: KL = PEEK(53278): POKE V+2,X2: POKE V+3,Y2: IF FN FB(.)=. AND WB=. THEN 800
    KL = Lat
    Lat = 0
    T = X2
    RX2 = T
    T = Y2
    RY2 = T
    SightOn = 1
    if WB = 1 then
      Credit -= CL111W
    else
      Credit -= CL111
      Pc = P200
      if Btn > 0 then Shoot
      return
    end if
    Pc = P200
    return
  end if
  if Pc = P811 then
    ' 811: POKE 2042,194: D2=-D2: SC=SC+1 (after the shot's lines 800-810)
    CP = 194
    D2 = 0 - D2
    inc SC
    Credit -= CHit
    Pc = P200
    return
  end if
  if Pc = P200 then
    ' 200: H=H+1: X3=X3+D1: Y3=Y3+D2: IF X3>255 THEN X3=.: POKE V+16,PEEK(V+16)+4
    inc H
    X3 += D1
    Y3 += D2
    if X3 > 255 then
      X3 = 0
      VM += 4
    end if
    Credit -= CL200
    Credit -= CL210
    Pc = P300
    ' 210: IF Y3<. OR Y3>255 THEN 300
    if Y3 < 0 then return
    if Y3 > 255 then return
    ' 211: IF H>40 AND WB=1 THEN 300
    Credit -= CL211
    if H > 40 then
      if WB = 1 then return
    end if
    ' 212: IF X3<. THEN 300
    Credit -= CL212
    if X3 < 0 then return
    Pc = P299
    return
  end if
  if Pc = P299 then
    ' 299: POKE V+4,X3: POKE V+5,Y3: POKE 54276,128: GOTO 100
    T = X3
    RX3 = T
    T = Y3
    RY3 = T
    ClayOn = 1
    Credit -= CL299
    Pc = P100
    return
  end if
  if Pc = P300 then
    ' 300: WB=.: H=.: PO=PO+1: IF (PEEK(V+16)AND2)=2 THEN POKE V+16,PEEK(V+16)-2
    WB = 0
    H = 0
    inc PO
    V = VM & 2
    if V > 0 then VM -= 2
    ' 302: ON INT((PO+5)/5) GOSUB 500,510,520,530,540,540
    Credit -= CL300
    Credit -= CL302
    Pc = PPost
    return
  end if
  if Pc = PPost then
    PostSetup
    return
  end if
  if Pc = P502 then
    ' 502: POKE V+1,Y1: POKE V+2,X2: POKE V+3,Y2 (now) ... POKE V+4,X3:
    ' POKE V+5,Y3: POKE V,X1 (at the line's end): GOTO 590
    PokeSight
    PendMan = 1
    Credit -= CL502
    Pc = P590
    return
  end if
  if Pc = P900 then
    ' 900: IF X=X1 THEN RETURN / 901: POKE V+16,.: IF X<X1 THEN FOR T=X TO X1 ...
    Credit -= CL900
    Pc = P512
    if Xo = X1 then return
    VM = 0
    Tw = Xo
    if Xo < X1 then
      Pc = PW1
    else
      U = 0
      Tend = X1 + 255
      Pc = PW2
    end if
    return
  end if
  if Pc = PW1 then
    ' 901: ... POKE V,T: FOR Y=1 TO 10: NEXT Y,T
    T = Tw
    RX1 = T
    ManDirty = 1
    Credit -= CWalk1
    inc Tw
    if Tw > X1 then Pc = P512
    return
  end if
  if Pc = PW2 then
    ' 910-913: FOR T=X TO X1+255: IF T>255 THEN MSB on: U=1 / POKE V,T(-256) / FOR Y=1 TO 5
    if Tw > 255 then
      VM = VM | 1
      U = 1
    end if
    if U = 1 then
      Dx = Tw - 256
      T = Dx
      Credit -= CWalk2b
    else
      T = Tw
      Credit -= CWalk2a
    end if
    RX1 = T
    ManDirty = 1
    inc Tw
    if Tw > Tend then Pc = P512
    return
  end if
  if Pc = P512 then
    ' 512: POKE V+1,Y1: POKE V+2,X2: POKE V+3,Y2 (now): POKE V+4,X3:
    ' POKE V+5,Y3 (at the line's end): GOTO 590
    PokeSight
    Credit -= CL512
    Pc = P590
    return
  end if
  if Pc = P590 then
    ' (the end of 502/512: the clay's and the man's pokes, a moment before)
    T = X3
    RX3 = T
    T = Y3
    RY3 = T
    ClayOn = 1
    if PendMan = 1 then
      T = X1
      RX1 = T
      ManOn = 1
      ManDirty = 1
      PendMan = 0
    end if
    ' 590: POKE 2042,193: D1=INT(RND(.)*5)+DI: D=INT(RND(.)*100)+1: IF D>50 THEN D1=-D1
    CP = 193
    T = RandBelow5()
    D1 = T
    D1 += DI
    Rand
    V = Rs & 128
    if V > 0 then D1 = 0 - D1
    Credit -= CL590
    Pc = P591
    return
  end if
  if Pc = P591 then
    ' 591: D2=INT(RND(.)*5)+DI: D2=-D2: IF (PEEK(V+16)AND4)=4 THEN POKE V+16,PEEK(V+16)-4
    T = RandBelow5()
    D2 = T
    D2 += DI
    D2 = 0 - D2
    V = VM & 4
    if V > 0 then VM -= 4
    Credit -= CL591
    Credit -= CL302
    Pc = P303
    return
  end if
  if Pc = P303 then
    ' 303: PRINT "SCORE=";SC;"/25","ROUND";PO
    HudDirty = 1
    Credit -= CL303
    Pc = P397
    return
  end if
  if Pc = P397 then
    ' 397: IF PO=25 THEN 600
    Credit -= CL397
    Pc = P398
    if PO = 25 then Pc = PEnd
    return
  end if
  if Pc = P398 then
    ' 398: JV=FN JO(.): FB=FN FB(.): IF JV=. AND FB=16 THEN 398
    Credit -= CL398
    V = Jk | Btn
    if V > 0 then Pc = P399
    return
  end if
  if Pc = P399 then
    Credit -= CL399
    Pc = P100
    return
  end if
  return
end sub

' 101-110: the sight moves S pixels; X2 carries into the MSB register as the
' listing does (+2 / -2 on $D010, X2-255, 255+X2: its own small seam)
sub MoveSight:
  Credit -= CMove
  ' 101: IF JV=1 OR JV=5 OR JV=9 THEN Y2=Y2-S
  V = JV & 3
  if V = 1 then
    Y2 -= S
    Credit -= CAxis
  end if
  ' 102: IF JV=2 OR JV=6 OR JV=10 THEN Y2=Y2+S
  if V = 2 then
    Y2 += S
    Credit -= CAxis
  end if
  ' 103: IF JV>3 AND JV<7 THEN X2=X2-S   (104: JV>7 AND JV<11: X2=X2+S)
  if JV > 3 then
    if JV < 7 then
      X2 -= S
      Credit -= CAxis
    end if
  end if
  if JV > 7 then
    if JV < 11 then
      X2 += S
      Credit -= CAxis
    end if
  end if
  ' 105: IF X2>255 THEN POKE V+16,PEEK(V+16)+2: X2=X2-255
  if X2 > 255 then
    VM += 2
    X2 -= 255
  end if
  ' 106: IF X2<. AND (PEEK(V+16)AND2)=2 THEN X2=255--X2: POKE V+16,PEEK(V+16)-2
  if X2 < 0 then
    V = VM & 2
    if V > 0 then
      X2 += 255
      VM -= 2
    end if
  end if
  ' 107-110: clamp to 0..255
  if Y2 < 0 then Y2 = 0
  if Y2 > 255 then Y2 = 255
  if X2 < 0 then X2 = 0
  if X2 > 255 then X2 = 255
  return
end sub

' 800-811: the shot. The noise starts; a hit needs the latch to read exactly 6
sub Shoot:
  WB = 1
  play sound SndShot
  Credit -= CShot
  ' 810: IF KL<>6 THEN 200
  if KL = 6 then Pc = P811
  return
end sub

' 500-541: the post's places (the man walks from X to X1 in 900-913)
sub PostSetup:
  Xo = X1
  K = PO + 5
  K = K / 5
  Y2 = 157
  X3 = 170
  Y3 = 167
  if K = 1 then
    MP = 191
    X1 = 33
    X2 = 126
    Credit -= CPost1
    Pc = P502
    return
  end if
  Credit -= CPostN
  Pc = P900
  if K = 2 then
    MP = 191
    X1 = 97
    X2 = 149
  end if
  if K = 3 then
    MP = 191
    X1 = 161
    X2 = 169
  end if
  if K = 4 then
    MP = 190
    X1 = 220
    X2 = 189
  end if
  if K >= 5 then
    MP = 190
    X1 = 28
    X2 = 216
  end if
  ManDirty = 1
  return
end sub

sub PokeSight:
  T = X2
  RX2 = T
  T = Y2
  RY2 = T
  SightOn = 1
  return
end sub

' 16-bit xorshift (stepped every title frame)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' INT(RND(.)*5): 0..4 from the low byte (byte * 5 >> 8)
function RandBelow5() as u8
  u8 Rv = 0
  Rand
  W16 = Rs & 255
  W16 = W16 * 5
  W16 = W16 >> 8
  Rv = W16
  return Rv

' ---------------------------------------------------------------------------
' collisions: the bits $D01E would latch for what the screen shows now
' (bit 0 man, 1 sight, 2 clay); pixel exact, from art.py's bit tables

sub FullX:
  SXf = RX2
  V = VM & 2
  if V > 0 then SXf += 256
  CXf = RX3
  V = VM & 4
  if V > 0 then CXf += 256
  MXf = RX1
  V = VM & 1
  if V > 0 then MXf += 256
  return
end sub

sub Collide:
  Cb = 0
  FullX
  if SightOn = 0 then return
  if ClayOn = 1 then
    ' sight at (0,0), clay or pieces at (Dx, Dy): dx -23..23, dy -20..20
    Dx = CXf - SXf
    Dy = RY3 - RY2
    if Dx >= -23 then
      if Dx <= 23 then
        if Dy >= -20 then
          if Dy <= 20 then
            Dx += 23
            Dy += 20
            Iw = Dy
            Ib = Iw << 2
            Iw = Iw << 1
            Iw += Ib
            Ib = Dx
            Ib = Ib >> 3
            Iw += Ib
            if CP = 193 then
              T = HitSC[Iw]
            else
              T = HitSP[Iw]
            end if
            V = Dx & 7
            Bm = BitM[V]
            T = T & Bm
            if T > 0 then Cb = Cb | 6
          end if
        end if
      end if
    end if
  end if
  if ManOn = 0 then return
  ' man at (0,0) (48x42 expanded), sight at (Dx, Dy): dx -23..47, dy -20..41
  Dx = SXf - MXf
  Dy = RY2 - 192
  if Dx >= -23 then
    if Dx <= 47 then
      if Dy >= -20 then
        if Dy <= 41 then
          Dx += 23
          Dy += 20
          ManIndex
          if MP = 190 then
            T = HitMS0[Iw]
          else
            T = HitMS1[Iw]
          end if
          V = Dx & 7
          Bm = BitM[V]
          T = T & Bm
          if T > 0 then Cb = Cb | 3
        end if
      end if
    end if
  end if
  ' the falling pieces against the man (the clay itself never gets that low)
  if CP <> 194 then return
  if ClayOn = 0 then return
  Dx = CXf - MXf
  Dy = RY3 - 192
  if Dx >= -23 then
    if Dx <= 47 then
      if Dy >= -20 then
        if Dy <= 41 then
          Dx += 23
          Dy += 20
          ManIndex
          if MP = 190 then
            T = HitMP0[Iw]
          else
            T = HitMP1[Iw]
          end if
          V = Dx & 7
          Bm = BitM[V]
          T = T & Bm
          if T > 0 then Cb = Cb | 5
        end if
      end if
    end if
  end if
  return
end sub

' Iw = Dy * 9 + Dx / 8 (man tables: 9 bytes a row)
sub ManIndex:
  Iw = Dy
  Ib = Iw << 3
  Iw += Ib
  Ib = Dx
  Ib = Ib >> 3
  Iw += Ib
  return
end sub

' ---------------------------------------------------------------------------
' drawing: right after the frame wait, what the registers say (sprites, the
' man's tiles, the HUD), then the collision latch for this frame

sub Flush:
  FullX
  ' slot 0: the sight (black)
  X = 255
  Y = 255
  if SightOn = 1 then
    X = XMap[SXf]
    T = RY2
    Y = YMap[T]
  end if
  if X = 255 then Y = 255
  if Y = 255 then
    set sprite 0 to HideY,0,SSight,0
  else
    dec Y
    set sprite 0 to Y,X,SSight,1
  end if
  ' slot 1: the clay or its pieces (white), cut where the C64 shows the
  ' background in front of it (trap house, ground, the HUD bar)
  ClayShape
  if K = 255 then
    set sprite 1 to HideY,0,SClay3,0
  else
    dec Y
    set sprite 1 to Y,X,K,15
  end if
  update sprites
  if ManDirty = 1 then DrawMan
  if HudDirty = 1 then ShowHud
  Collide
  Lat = Lat | Cb
  return
end sub

' -> X, Y (screen) and K (pattern, 255 = hidden)
sub ClayShape:
  K = 255
  if ClayOn = 0 then return
  X = XMap[CXf]
  if X = 255 then return
  T = RY3
  Y = YMapC[T]
  if Y = 255 then return
  if CXf < 12 then return
  Q = CXf - 12
  Q = Q >> 3
  if Q > 63 then return
  V = FgTop[Q]
  if CP = 193 then
    ' the clay's 3 rows are sprite rows 8-10: screen rows RY3-42 .. RY3-40
    if RY3 < 58 then return
    T = RY3 - 42
    if T >= V then return
    V = V - T
    K = SClay1
    if V >= 2 then K = SClay2
    if V >= 3 then K = SClay3
    return
  end if
  if RY3 < 58 then return
  T = RY3 - 50
  if T >= V then return
  V = V - T
  if V > 21 then V = 21
  dec V
  K = PieceCut[V]
  return
end sub

' the man: a 5x5 tile block (rows 16-20), 4-pixel steps, two facings
sub DrawMan:
  ManDirty = 0
  if ManOn = 0 then return
  T = ManX[MXf]
  if T = ManL then
    if MP = ManP then return
  end if
  if ManL <> 255 then
    ' the field comes back where he stood (grass, or a numbered post)
    C = ManL >> 3
    Q = C
    for Ri = 17 to 21
      put FieldRows + Q count 5 at C,Ri
      Q += 32
    next
  end if
  ManL = T
  ManP = MP
  ManPut
  return
end sub

' the man's 5x5 block at pixel T (rows 17-21), facing MP; at a post he
' stands on its grey numbered box (blocks drawn over the field there)
sub ManPut:
  C = T >> 3
  V = T & 4
  Q = 0
  if V > 0 then Q = 25
  if MP = 191 then Q += 50
  for Li2 = 0 to 5
    if PostT[Li2] = T then
      if PostP[Li2] = MP then
        Q = Li2 * 25
        for Ri = 17 to 21
          put PostBlk + Q count 5 at C,Ri
          Q += 5
        next
        return
      end if
    end if
  next
  for Ri = 17 to 21
    put ManBlk + Q count 5 at C,Ri
    Q += 5
  next
  return
end sub

' 303: "SCORE= n/25" and "ROUND n" (row 1), left-aligned like the C64's PRINT
sub ShowHud:
  HudDirty = 0
  print at 2,1, "SCORE="
  NumU = SC
  PrintLeft
  print at 20,1, "ROUND"
  X = 26
  NumU = PO
  print at X,1, str$(NumU)
  if PO < 10 then put char 32 at 27,1
  return
end sub

' SC at column 9, then "/25" right after it
sub PrintLeft:
  print at 9,1, str$(NumU)
  if SC < 10 then
    print at 10,1, "/25 "
  else
    print at 11,1, "/25"
  end if
  return
end sub

sub ShowHi:
  print at 2,2, "HI SCORE"
  NumU = Hi
  print at 11,2, str$(NumU)
  return
end sub

' ---------------------------------------------------------------------------
' a game

sub NewGame:
  State = StNext
  ' the listing's RUN: everything from 0, the high score stays (PEEK(2))
  SC = 0
  PO = 255
  WB = 0
  H = 0
  X1 = 0
  VM = 0
  RX1 = 0
  RX2 = 0
  RY2 = 0
  RX3 = 0
  RY3 = 0
  CP = 193
  MP = 191
  Lat = 0
  SightOn = 0
  ClayOn = 0
  ManOn = 0
  PendMan = 0
  ManL = 255
  Page = 0
  HudDirty = 0
  DrawField
  ShowHi
  ' 98: IF DI=. THEN 400 (asked on the title) / 99: GOTO 300
  Pc = P300
  Credit = 0
  State = StPlay
  return
end sub

sub GameOver:
  ' 600-601: GAME OVER; a new high score is shown
  print at 11,9, "GAME OVER"
  print at 8,11, "PRESS THE BUTTON"
  if SC > Hi then
    Hi = SC
    ShowHi
  end if
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub LoadField:
  decompress zx0 FieldP0 to vram.pattern + 1024
  decompress zx0 FieldC0 to vram.color + 1024
  decompress zx0 FieldP1 to vram.pattern + 3072
  decompress zx0 FieldC1 to vram.color + 3072
  decompress zx0 FieldP2 to vram.pattern + 5120
  decompress zx0 FieldC2 to vram.color + 5120
  return
end sub

sub DrawField:
  NewScreen
  LoadField
  ' text: dark blue on white in thirds 1 and 3 (the HUD bars), white on the
  ' sky in the middle third (GAME OVER)
  fill $4F count 1024 to vram.color
  fill $4F count 1024 to vram.color + 4096
  decompress zx0 FieldNamesZ to vram.name
  backdrop light blue
  ShowScreen
  return
end sub

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right: the
' C64's FN JO bits), Edge = newly pressed, Btn = button held, Press = new press
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  set sprite 0 to HideY,0,0,0
  set sprite 1 to HideY,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill $F4 count 1024 to vram.color
  fill $F4 count 1024 to vram.color + 2048
  fill $F4 count 1024 to vram.color + 4096
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title (listing 2000-2016): the italic name, the gun's bang, the author;
' then the menu (the listing's questions 400-414 become ROCK / SIGHT SPEED)
sub TitlePage:
  NewScreen
  decompress zx0 TitleP0 to vram.pattern + 1024
  decompress zx0 TitleC0 to vram.color + 1024
  decompress zx0 TitleP1 to vram.pattern + 3072
  decompress zx0 TitleC1 to vram.color + 3072
  decompress zx0 TitleP2 to vram.pattern + 5120
  decompress zx0 TitleC2 to vram.color + 5120
  decompress zx0 TitleNamesZ to vram.name
  backdrop light blue
  print at 9,10, "BY LEE FRALEY"
  print at 9,12, "START"
  print at 9,14, "ROCK SPEED"
  print at 9,16, "SIGHT SPEED"
  print at 9,18, "SEE ONE"
  print at 9,20, "HOW TO PLAY"
  print at 9,22, "CREDITS"
  ShowSpeeds
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndShot
  TzLeft = 50
  TzOn = 2
  WasBtn = 16
  Rep = 0
tp_loop:
  Frame1
  Rand
  ' the bang first (listing 2014), then the tune once
  if TzOn = 2 then
    dec TzLeft
    if TzLeft = 0 then
      play sound SndTuneA
      play sound SndTuneB
      play sound SndTuneC
      play sound SndTuneD
      TzLeft = TuneFrames
      TzOn = 1
    end if
  end if
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 5
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 5 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  ' left/right: the speeds (held: repeats every 6 frames after 20)
  K = Jk & 12
  if K = 0 then
    Rep = 0
  else
    V = 0
    if Rep = 0 then V = 1
    inc Rep
    if Rep >= 20 then
      Rep = 14
      V = 1
    end if
    if V = 1 then ChangeSpeed
  end if
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  if Menu = 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  State = StNext
  return
end sub

sub ChangeSpeed:
  if Menu = 1 then
    if K = 4 then
      if DI > 1 then dec DI
    else
      if DI < 15 then inc DI
    end if
  end if
  if Menu = 2 then
    if K = 4 then
      if S > 1 then dec S
    else
      if S < 40 then inc S
    end if
  end if
  play sound SndClick
  ShowSpeeds
  return
end sub

sub ShowSpeeds:
  NumU = DI
  print NumU at 22,14 width 2
  NumU = S
  print NumU at 22,16 width 2
  return
end sub

sub ShowMenu:
  for Ri = 0 to 5
    C = Ri << 1
    C += 12
    put char 32 at 7,C
  next
  C = Menu << 1
  C += 12
  put char 62 at 7,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,1, "TRAP SHOOT"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  State = StNext
  return
end sub

' HOW TO PLAY: three pages, each with the man at his post, the sight and a
' clay bird (the game's own tiles and sprites)
sub HowTo:
  Page = 1
  for Li = 1 to 3
    if TimedOut = 0 then
      NewScreen
      LoadField
      print at 7,1, "HOW TO PLAY"
      C = Li + 48
      put char C at 20,1
      print at 21,1, "/3"
      TxT = Li - 1
      TxX0 = 2
      TxY = 3
      TxGap = 2
      TextShow
      ' the man at post 2, as in the game
      T = 68
      MP = 191
      ManPut
      set sprite 0 to 119,151,SSight,1
      set sprite 1 to 117,160,SClay3,15
      update sprites
      print at 8,22, "PRESS THE BUTTON"
      State = StHow
      PageWait
      State = StNext
    end if
  next
  TimedOut = 0
  HideSprites
  return
end sub

' SEE ONE (listing 406-409): one bird flies 10 steps over the field (the man
' and the sight are hidden), then back to the title
sub SeeOne:
  NewGame
  ' listing 400: the black ">>>>> TRAP SHOOT <<<<<" bar over HI SCORE
  put BarNames count 28 at 2,1
  State = StSee
  ManOn = 0
  T = RandBelow5()
  D1 = T
  D1 += DI
  Rand
  V = Rs & 128
  if V > 0 then D1 = 0 - D1
  T = RandBelow5()
  D2 = T
  D2 += DI
  D2 = 0 - D2
  X3 = 170
  Y3 = 167
  VM = 0
  CP = 193
  for Li = 1 to 10
    X3 += D1
    Y3 += D2
    if X3 > 255 then
      X3 = 0
      VM += 4
    end if
    if Y3 < 0 then Y3 = 0
    T = X3
    RX3 = T
    T = Y3
    RY3 = T
    ClayOn = 1
    for Ri = 1 to 8
      Frame1
      Flush
    next
  next
  for Ri = 1 to 60
    Frame1
  next
  State = StNext
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

