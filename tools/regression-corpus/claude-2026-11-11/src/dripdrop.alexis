cartridge "DRIP-DROP/JOHN FEDOR/1988"
' DRIP-DROP - ColecoVision port of John Fedor's C-64 game from ReRUN
' (May/June 1988). Port in Amy from the original's machine code (DATA lines
' of the BASIC loader, rebuilt and disassembled: orig/dripml.dis).
'
' The game: a storm cloud wanders over the sky and lets drips fall. Move
' your trays (one per life, stacked at C-64 rows 21, 18 and 15) left and
' right and catch every drip: 5 points each. Level L drops 10 x L drips
' (240 from level 26); all caught: a jingle and the next level. A drip
' that reaches the ground costs a tray and restarts the level.
'
' Timing: the original is one CPU-bound machine-code loop with no frame
' wait. Each pass decrements three counters: ground (64 passes), tray
' (128), cloud (192); the cloud's event also runs the drip counter (1 or 2
' cloud steps) and the spawn counter (2..10 drip steps). The port runs the
' original's passes against a C-64 cycle budget per frame (cycles measured
' in jsc64: c64/cyc.mjs), so speeds stay in the original's units.
'
' Controls: either controller; stick left/right moves the trays; the
' button pauses (the original's SHIFT key). Menus by stick and button.

const TGrass1 = 128
const TGrass2 = 129
const TSoil1 = 130
const TSoil2 = 131
const TDrop = 132
const TLogo00 = 133
const TLogo01 = 134
const TLogo02 = 135
const TLogo03 = 136
const TLogo04 = 137
const TLogo05 = 138
const TLogo06 = 139
const TLogo07 = 140
const TLogo08 = 141
const TLogo09 = 142
const TLogo010 = 143
const TLogo011 = 144
const TLogo012 = 145
const TLogo013 = 146
const TLogo014 = 147
const TLogo015 = 148
const TLogo016 = 149
const TLogo017 = 150
const TLogo018 = 151
const TLogo019 = 152
const TLogo020 = 153
const TLogo10 = 154
const TLogo11 = 155
const TLogo12 = 156
const TLogo13 = 157
const TLogo14 = 158
const TLogo15 = 159
const TLogo16 = 160
const TLogo17 = 161
const TLogo18 = 162
const TLogo19 = 163
const TLogo110 = 164
const TLogo111 = 165
const TLogo112 = 166
const TLogo113 = 167
const TLogo114 = 168
const TLogo115 = 169
const TLogo116 = 170
const TLogo117 = 171
const TLogo118 = 172
const TLogo119 = 173
const TLogo120 = 174
const TLogo20 = 175
const TLogo21 = 176
const TLogo22 = 177
const TLogo23 = 178
const TLogo24 = 179
const TLogo25 = 180
const TLogo26 = 181
const TLogo27 = 182
const TLogo28 = 183
const TLogo29 = 184
const TLogo210 = 185
const TLogo211 = 186
const TLogo212 = 187
const TLogo213 = 188
const TLogo214 = 189
const TLogo215 = 190
const TLogo216 = 191
const TLogo217 = 192
const TLogo218 = 193
const TLogo219 = 194
const TLogo220 = 195
const TLogo30 = 196
const TLogo31 = 197
const TLogo32 = 198
const TLogo33 = 199
const TLogo34 = 200
const TLogo35 = 201
const TLogo36 = 202
const TLogo37 = 203
const TLogo38 = 204
const TLogo39 = 205
const TLogo310 = 206
const TLogo311 = 207
const TLogo312 = 208
const TLogo313 = 209
const TLogo314 = 210
const TLogo315 = 211
const TLogo316 = 212
const TLogo317 = 213
const TLogo318 = 214
const TLogo319 = 215
const TLogo320 = 216
const TCloud00 = 217
const TCloud01 = 218
const TCloud02 = 219
const TCloud03 = 220
const TCloud04 = 221
const TCloud05 = 222
const TCloud10 = 223
const TCloud11 = 224
const TCloud12 = 225
const TCloud13 = 226
const TCloud14 = 227
const TCloud15 = 228
const TCloud20 = 229
const TCloud21 = 230
const TCloud22 = 231
const TCloud23 = 232
const TCloud24 = 233
const TCloud25 = 234
const SRim = 0
const STray = 4
const SDrip = 8
const SCloudu = 12
const SCloud = 16
const SSplash = 20
const NTiles8 = 856
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndDrip = 6
const SndCatch = 7
const SndSplash = 8
const SndNoteA = 9
const SndNoteB = 10
const SndOver = 11
const TuneFrames = 768
const TxtCredits = 0
const NSpr = 28
const HideY = 192
' C-64 cycles in units of 8: free cycles per NTSC frame (17045 - 1075 bad
' lines - 210 KERNAL IRQ) and the measured cost of each kind of pass
const Budget = 1970
const LightU = 40
const GroundU = 156
const TrayU = 70
const CloudU = 30
const RndU = 416
const DripU = 2019
const DripEach = 9
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StMiss = 5
const StLevel = 6
const StNext = 7
const StOver = 9

u8 DripR[25]
u8 GrassBuf[28]
u16 ScK = 0
u16 ScL = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Cyc = 0
u16 Debt = 0
u16 Cost = 0
u8 TzOn = 0
u8 State = 0
u8 Lives = 0
u8 Level = 1
u8 SelLevel = 1
u8 Need = 0
u8 Got = 0
u8 Remain = 0
u8 DripP = 0
u8 SpawnS = 0
u8 Gc = 1
u8 Bc = 128
u8 Cc = 3
u8 Dc = 0
u8 Spc = 0
u8 Bx = 20
u8 Cl = 20
u8 Ct = 20
u8 EndF = 0
u8 MissC = 0
u8 Paused = 0
u8 HudDirty = 0
u8 GrassT = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 Lp = 0
u8 M = 0
u8 Ri = 0
u8 R1 = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Li = 0
u8 Ni = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Y = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 2 then
    HowTo
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  Flush
  ReadPad
  if Press = 1 then TogglePause
  if Paused = 0 then
    RunFrame
    GrassTick
  end if
  SetSprites
  if EndF = 0 then goto play_loop
  if EndF = 2 then
    LevelDone
    goto play_loop
  end if
  MissPause
  dec Lives
  if Lives > 0 then
    StartLevel
    goto play_loop
  end if

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (the original's machine code, pass by pass)

' 16-bit xorshift: stepped every title frame, so each game is different
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' game start ($C517): three trays, trays and cloud at column 20
sub NewGame:
  State = StNext
  ScK = 0
  ScL = 0
  Lives = 3
  Level = SelLevel
  Bx = 20
  Cl = 20
  Ct = 20
  Cc = 3
  StartLevel
  return
end sub

' level start ($C537 + $C357): the level's numbers, an empty sky
sub StartLevel:
  State = StNext
  ' drips: 10 x level, 240 from level 26
  Need = 240
  if Level < 26 then
    Need = Level * 10
  end if
  ' spawn every SpawnS drip steps: 10 - min(L/2, 10), at least 3
  T = Level >> 1
  if T > 10 then T = 10
  SpawnS = 10 - T
  if SpawnS < 3 then SpawnS = 3
  ' a drip step every DripP cloud steps: 2 below level 10, else 1;
  ' from level 20 one spawn step less
  DripP = 2
  if Level >= 10 then DripP = 1
  if Level >= 20 then dec SpawnS
  Remain = Need
  Got = 0
  Dc = 64
  Spc = 1
  Gc = 1
  EndF = 0
  Paused = 0
  Cyc = 0
  Debt = 0
  fill array DripR with 255
  DrawPlay
  State = StPlay
  return
end sub

' one frame of the original: passes against the frame's cycle budget; a
' pass that does not fit ends in the next frame (Debt)
sub RunFrame:
  if Debt >= Budget then
    Debt -= Budget
    return
  end if
  Cyc = Budget - Debt
  Debt = 0
rf_loop:
  ' passes before the next counter event are light (320 cycles each)
  M = Gc
  if Bc < M then M = Bc
  if Cc < M then M = Cc
  dec M
  Lp = 0
rf_light8:
  ' eight light passes at a time while they fit
  if M >= 8 then
    if Cyc > 320 then
      Cyc -= 320
      Lp += 8
      M -= 8
      goto rf_light8
    end if
  end if
rf_light:
  if M = 0 then goto rf_event
  if Cyc <= LightU then
    Debt = LightU - Cyc
    Cyc = 0
    inc Lp
    Gc -= Lp
    Bc -= Lp
    Cc -= Lp
    return
  end if
  Cyc -= LightU
  inc Lp
  dec M
  goto rf_light
rf_event:
  Gc -= Lp
  Bc -= Lp
  Cc -= Lp
  Cost = LightU
  OnePass
  if EndF <> 0 then
    Cyc = 0
    Debt = 0
    return
  end if
  if Cost < Cyc then
    Cyc -= Cost
    goto rf_loop
  end if
  Debt = Cost - Cyc
  Cyc = 0
  return
end sub

' one pass with an event: ground ($C070), trays ($C096), cloud and drips
' ($C176, $C214, $C2AB), the level check ($C315)
sub OnePass:
  dec Gc
  if Gc = 0 then
    Gc = 64
    Cost += GroundU
  end if
  dec Bc
  if Bc = 0 then
    Bc = 128
    TrayStep
  end if
  dec Cc
  if Cc = 0 then
    Cc = 192
    Cost += CloudU
    CloudStep
  end if
  if Got = Need then EndF = 2
  return
end sub

' the trays: one column a step, columns 0-37; drips in the cells they move
' onto are caught
sub TrayStep:
  V = Jk & 12
  if V = 0 then return
  Cost += TrayU
  V = Jk & 4
  if V > 0 then
    if Bx > 0 then dec Bx
  end if
  V = Jk & 8
  if V > 0 then
    if Bx < 37 then inc Bx
  end if
  R1 = 21
  TrayCatch
  if Lives >= 2 then
    R1 = 18
    TrayCatch
  end if
  if Lives >= 3 then
    R1 = 15
    TrayCatch
  end if
  return
end sub

' a drip in row R1 inside the trays' three columns is caught
sub TrayCatch:
  C = DripR[R1]
  if C = 255 then return
  if C < Bx then return
  T = Bx + 2
  if C > T then return
  DripR[R1] = 255
  Caught1
  return
end sub

sub Caught1:
  inc Got
  ScL += 5
  if ScL >= 1000 then
    ScL -= 1000
    inc ScK
  end if
  HudDirty = 1
  play sound SndCatch
  return
end sub

' the cloud: a new random target column when it got there, then one
' column toward it; then the drip counter
sub CloudStep:
  if Ct = Cl then
cs_pick:
    Cost += RndU
    Rand
    W16 = Rs & 63
    T = W16
    if T >= 38 then goto cs_pick
    if T = Cl then goto cs_pick
    Ct = T
  end if
  if Cl >= Ct then
    dec Cl
  else
    inc Cl
  end if
  dec Dc
  if Dc > 0 then return
  Dc = DripP
  Cost += DripU
  DripStep
  ' a new drip under the cloud's middle, every SpawnS drip steps
  dec Spc
  if Spc > 0 then return
  Spc = SpawnS
  if Remain = 0 then return
  dec Remain
  T = Cl + 1
  DripR[4] = T
  play sound SndDrip
  return
end sub

' every drip one row down (rows 22 .. 4, bottom first): into a tray's
' cells it is caught; into row 23 (the grass) it is lost
sub DripStep:
  for Ri = 22 downto 4
    C = DripR[Ri]
    if C <> 255 then
      Cost += DripEach
      R1 = Ri + 1
      K = 0
      if R1 = 21 then K = 1
      if R1 = 18 then
        if Lives >= 2 then K = 1
      end if
      if R1 = 15 then
        if Lives >= 3 then K = 1
      end if
      if K = 1 then
        if C < Bx then K = 0
        T = Bx + 2
        if C > T then K = 0
      end if
      DripR[Ri] = 255
      if K = 1 then
        Caught1
      else
        DripR[R1] = C
        if R1 = 23 then
          EndF = 1
          MissC = C
          play sound SndSplash
        end if
      end if
    end if
  next
  return
end sub

sub TogglePause:
  if Paused = 0 then
    Paused = 1
    backdrop light blue
  else
    Paused = 0
    backdrop cyan
  end if
  return
end sub

' the original redraws the tufts at random every 64 passes (about 45 times
' a second); here at most 3 times a second (house rule on flashing)
sub GrassTick:
  inc GrassT
  if GrassT < 20 then return
  GrassT = 0
  DrawGrass
  return
end sub

sub DrawGrass:
  Rand
  W16 = Rs & 31
  T = W16
  copy GrassTab + T count 28 to GrassBuf
  put GrassBuf at 2,21
  return
end sub

' drip lost: the original's pause (329,000 cycles, 21 frames)
sub MissPause:
  State = StMiss
  for Ni = 0 to 20
    Frame1
    Flush
  next
  return
end sub

' level done: pause, the original's 5-note jingle ($C425: 456 and 349 Hz,
' 22 frames each), the next level (up to 99)
sub LevelDone:
  State = StLevel
  for Ni = 0 to 20
    Frame1
    Flush
  next
  for Ni = 0 to 4
    V = Ni & 1
    if V = 0 then
      play sound SndNoteA
    else
      play sound SndNoteB
    end if
    for Li = 0 to 22
      Frame1
    next
  next
  if Level < 99 then inc Level
  StartLevel
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' slots: 0-5 the trays (rim, body; bottom tray first), 6-7 the cloud,
' 8-28 one drip per row 4..23 (a row never holds two drips)
sub SetSprites:
  Y = YRow[21] - 1
  set sprite 0 to Y,XMap[Bx],SRim,1
  set sprite 1 to Y,XMap[Bx],STray,6
  T = HideY
  if Lives >= 2 then T = YRow[18] - 1
  set sprite 2 to T,XMap[Bx],SRim,1
  set sprite 3 to T,XMap[Bx],STray,6
  T = HideY
  if Lives >= 3 then T = YRow[15] - 1
  set sprite 4 to T,XMap[Bx],SRim,1
  set sprite 5 to T,XMap[Bx],STray,6
  Y = YRow[2] - 1
  set sprite 6 to Y,XMap[Cl],SCloudu,14
  set sprite 7 to Y,XMap[Cl],SCloud,1
  for Li = 4 to 23
    C = DripR[Li]
    K = Li + 4
    if C = 255 then
      set sprite K to HideY,0,SDrip,0
    else
      T = YRow[Li] - 1
      set sprite K to T,XMap[C],SDrip,4
    end if
  next
  if EndF = 1 then
    T = YRow[23] - 1
    set sprite 27 to T,XMap[MissC],SSplash,4
  end if
  return
end sub

' right after the frame wait: the sprites and the HUD of the last pass
sub Flush:
  update sprites
  if HudDirty = 1 then ShowHud
  return
end sub

sub ShowHud:
  HudDirty = 0
  ' the original's two HUD lines (C-64 rows 0-1)
  print at 4,1, "DRIP-DROP  BY JOHN FEDOR"
  print at 4,2, "SCORE:"
  NumU = ScK
  print at 11,2, digits$(NumU, 3)
  NumU = ScL
  print at 14,2, digits$(NumU, 3)
  print at 19,2, "LEVEL:"
  NumU = Level
  print at 26,2, digits$(NumU, 2)
  return
end sub

sub DrawGround:
  DrawGrass
  for J = 2 to 29
    T = J & 1
    T += TSoil1
    put char T at J,22
  next
  return
end sub

sub DrawPlay:
  NewScreen
  DrawGround
  ShowHud
  ShowScreen
  SetSprites
  update sprites
  return
end sub

sub GameOver:
  HideSprites
  print at 11,10, "GAME OVER"
  print at 9,12, "SCORE"
  NumU = ScK
  print at 15,12, digits$(NumU, 3)
  NumU = ScL
  print at 18,12, digits$(NumU, 3)
  print at 10,14, "PRESS BUTTON"
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker off
  for J = 0 to 27
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles, clear (black text on the cyan sky)
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $17
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop cyan
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub DrawLogo:
  for J = 0 to 20
    T = TLogo00 + J
    put char T at J + 5,5
    T = TLogo10 + J
    put char T at J + 5,6
    T = TLogo20 + J
    put char T at J + 5,7
    T = TLogo30 + J
    put char T at J + 5,8
  next
  for J = 0 to 5
    T = TCloud00 + J
    put char T at J + 13,1
    T = TCloud10 + J
    put char T at J + 13,2
    T = TCloud20 + J
    put char T at J + 13,3
  next
  return
end sub

' the title: cloud and logo, author, menu (cursor back on START), the tune
sub TitlePage:
  State = StBoot
  NewScreen
  DrawLogo
  put char TDrop at 15,4
  put char TDrop at 7,2
  put char TDrop at 24,3
  put char TDrop at 3,10
  put char TDrop at 28,9
  print at 10,10, "BY JOHN FEDOR"
  print at 11,12, "START"
  print at 11,14, "LEVEL"
  print at 11,16, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  DrawGround
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Menu = 1 then
    K = Edge & 12
    if K > 0 then
      if K = 4 then
        if SelLevel > 1 then dec SelLevel
      else
        if SelLevel < 25 then inc SelLevel
      end if
      play sound SndClick
      ShowMenu
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  put char 32 at 9,18
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  NumU = SelLevel
  print at 17,14, digits$(NumU, 2)
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 11,2, "DRIP-DROP"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' a picture: ground on rows 8-9 and a tray at C-64 column Ni
sub HowGround:
  fill TGrass1 count 12 at 10,8
  fill TSoil1 count 12 at 10,9
  return
end sub

' HOW TO PLAY: three airy pages with the game's own sprites and tiles
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  HowGround
  set sprite 6 to 23,112,SCloudu,14
  set sprite 7 to 23,112,SCloud,1
  set sprite 8 to 40,114,SDrip,4
  set sprite 0 to 57,108,SRim,1
  set sprite 1 to 57,108,STray,6
  update sprites
  print at 2,11, "A STORM CLOUD DRIFTS OVER"
  print at 2,13, "THE SKY AND DROPS RAIN."
  print at 2,15, "MOVE YOUR TRAYS LEFT AND"
  print at 2,17, "RIGHT AND CATCH EVERY DRIP."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    print at 2,3, "EACH DRIP CAUGHT: 5 POINTS."
    print at 2,5, "CATCH ALL THE DRIPS OF A"
    print at 2,7, "LEVEL (10 TIMES ITS NUMBER)"
    print at 2,9, "TO GO ON TO THE NEXT ONE."
    print at 2,11, "HIGHER LEVELS: FASTER DRIPS"
    print at 2,13, "AND MORE OF THEM."
    print at 2,15, "CHOOSE THE FIRST LEVEL ON"
    print at 2,17, "THE TITLE. BUTTON: PAUSE."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    HowGround
    set sprite 0 to 54,100,SRim,1
    set sprite 1 to 54,100,STray,6
    set sprite 2 to 40,100,SRim,1
    set sprite 3 to 40,100,STray,6
    set sprite 4 to 26,100,SRim,1
    set sprite 5 to 26,100,STray,6
    set sprite 8 to 62,140,SSplash,4
    update sprites
    print at 2,11, "THREE TRAYS, ONE ABOVE THE"
    print at 2,13, "OTHER. A DRIP THAT HITS THE"
    print at 2,15, "GROUND TAKES ONE AWAY, AND"
    print at 2,17, "THE LEVEL STARTS AGAIN."
    print at 2,19, "NO TRAYS LEFT: GAME OVER."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

