cartridge "BLOCK BUST/AUTHOR UNKNOWN (RERUN)/1985"
' BLOCK BUST - ReRUN (Summer 1985, side A), Commodore 64, BASIC + ML,
' author not named on the disk. ColecoVision port in Amy.
'
' The rules are the original's, pass for pass (model.mjs has them, checked
' against jsc64 traces of the C64 game: c64/check.mjs):
' - the C64 text screen is kept as the grid: 40 x 25 cells (walls on row 0,
'   row 24, columns 0 and 39), drawn 5 x 6 pixels a cell
' - 95 blocks in a checkerboard on rows 1-5; the ball always moves one cell
'   diagonally per pass; the block in the diagonal cell ahead is busted
'   (the ball moves into it and turns vertically)
' - the paddle (row 23) moves one cell per pass when the stick is exactly
'   left or right; it is 6 cells wide (5 before its first move) and a turn
'   costs one pass, as on the C64
' - the ball is lost on row 22 when no paddle is below it
' - 5 balls a game; clearing the 95 blocks goes on at SPEED - 1
' - pace: the C64 pass costs 1234 + 1286 x SPEED cycles (+21130 a beep);
'   here a cycle budget of 14000 C64 cycles a frame pays for the passes
'   (units of 1286/16 cycles: frame 174, pass 15 + 16 x SPEED, beep 263)

const TBrick = 128
const TWall = 129
const TField = 130
const SBall = 0
const SPl24 = 4
const SPr24 = 8
const SPl29 = 12
const SPr29 = 16
const NTiles8 = 24
const SprBytes = 160
const NPlay0 = 816
const NPlay1 = 32
const NPlay2 = 96
const NTitle0 = 336
const NTitle1 = 472
const NTitle2 = 144
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndBeep = 6
const SndLost = 7
const SndWon = 8
const SndOver = 9
const TuneFrames = 512
const TxtHow1 = 0
const TxtHow2 = 1
const TxtCredits = 2
const NSpr = 3
const HideY = 192
const FrameU = 174
const BeepU = 263
const Bias = 32768
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StLost = 5
const StWon = 6
const StNext = 7
const StOver = 9

' blocks: (row - 1) * 40 + column, rows 1-5
u8 Br[200]
u16 Total = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Cr = 0
u16 Cost = 0
u16 Sp16 = 0
u16 Ad = 0
u16 Ad2 = 0
u8 TzOn = 0
u8 State = 0
u8 Speed = 40
u8 Sc = 0
u8 Balls = 0
u8 Br0 = 0
u8 Bc = 0
u8 Bv = 0
u8 Bh = 0
u8 First = 0
u8 Pp = 0
u8 Pm = 0
u8 Out = 0
u8 Beeps = 0
u8 FrBeeps = 0
u8 Passes = 0
u8 Dr = 0
u8 Dc = 0
u8 Er = 0
u8 Ec = 0
u8 Ey = 0
u8 Ty = 0
u8 Tl = 0
u8 Pa = 0
u8 Pb = 0
u8 ShownSc = 255
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 Rep = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 Jall = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Li = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 2 then
    HowTo
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  if Out = 0 then goto play_loop
  if Out = 2 then
    WaveWon
    goto play_loop
  end if
  ' a ball lost
  BallLost
  if Balls > 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (the C64 code at $C10D-$C3AF, one pass = one ball step)

sub NewGame:
  State = StNext
  Total = 0
  Balls = 5
  NewWave
  return
end sub

' blocks back, count 0, paddle back to its start pointer ($07AA: p = 18)
sub NewWave:
  fill array Br with 0
  for Li = 0 to 37
    C = Li + 1
    V = C & 1
    if V = 1 then
      Br[C] = 1
      T = C + 80
      Br[T] = 1
      T = C + 160
      Br[T] = 1
    else
      T = C + 40
      Br[T] = 1
      T = C + 120
      Br[T] = 1
    end if
  next
  Sc = 0
  Pp = 18
  Pm = 0
  SetCost
  DrawPlay
  NewBall
  return
end sub

sub SetCost:
  Sp16 = Speed
  if Speed = 0 then Sp16 = 256
  Sp16 = Sp16 << 4
  Cost = Sp16 + 15
  return
end sub

sub NewBall:
  Br0 = 12
  Bc = 22
  Bv = 1
  Bh = 1
  First = 1
  Cr = Bias
  Out = 0
  DrawSprites
  State = StPlay
  return
end sub

' one frame: the cycle budget pays for passes (as many as the C64 made)
sub PlayFrame:
  Cr += FrameU
  FrBeeps = 0
  Passes = 0
pf_loop:
  if Cr <= Bias then goto pf_done
  if Out <> 0 then goto pf_done
  PassStep
  inc Passes
  Cr -= Cost
  if Beeps > 0 then
    FrBeeps += Beeps
    for Li = 1 to 3
      if Li <= Beeps then Cr -= BeepU
    next
  end if
  goto pf_loop
pf_done:
  if FrBeeps > 0 then play sound SndBeep
  DrawSprites
  if Sc <> ShownSc then ShowScore
  return
end sub

sub PassStep:
  Beeps = 0
  if Bv = 1 then
    Dr = Br0 - 1
  else
    Dr = Br0 + 1
  end if
  if Bh = 1 then
    Dc = Bc + 1
  else
    Dc = Bc - 1
  end if
  K = 0
  if First = 0 then
    if Dr >= 1 then
      if Dr <= 5 then
        T = Dr - 1
        Ad = T * 40
        Ad += Dc
        if Br[Ad] = 1 then K = 1
      end if
    end if
  end if
  Br0 = Dr
  Bc = Dc
  First = 0
  if K = 1 then
    Br[Ad] = 0
    inc Sc
    inc Beeps
    Bv = Bv ^ 1
    Er = Dr
    Ec = Dc
    EraseBrick
    if Sc = 95 then
      Out = 2
      return
    end if
  end if
  if Br0 = 23 then
    Out = 1
    return
  end if
  if Br0 = 22 then
    PadCells
    K = 0
    if Bc >= Pa then
      if Bc <= Pb then K = 1
    end if
    if K = 0 then
      Out = 1
      return
    end if
    Bv = 1
    inc Beeps
  end if
  if Br0 = 1 then
    Bv = 0
    inc Beeps
  end if
  if Bc = 38 then
    Bh = 0
    inc Beeps
  end if
  if Bc = 1 then
    Bh = 1
    inc Beeps
  end if
  ' the paddle: exactly left or exactly right ($DC00 = $7B / $77)
  if Jall = 4 then
    if Pp >= 1 then
      dec Pp
      Pm = 1
    end if
  end if
  if Jall = 8 then
    if Pp <= 32 then
      inc Pp
      Pm = 2
    end if
  end if
  return
end sub

' the paddle's cells Pa..Pb from its pointer and last move
sub PadCells:
  Pa = Pp + 1
  Pb = Pp + 5
  if Pm = 1 then Pb = Pp + 6
  if Pm = 2 then Pa = Pp
  return
end sub

' clears block (Er, Ec) in the pattern table: 5 lines, 4 pixels each,
' in one or two tiles of the field's first third
sub EraseBrick:
  Ey = Er * 6
  Ey += 28
  for Li = 0 to 4
    Ty = Ey >> 3
    Tl = Ey & 7
    Ad = Ty * 32
    T = BrTx1[Ec]
    Ad += T
    vpeek vram.name + Ad into V
    Ad2 = V
    Ad2 = Ad2 << 3
    Ad2 += Tl
    vpeek vram.pattern + Ad2 into X
    T = BrK1[Ec]
    X = X & T
    vpoke vram.pattern + Ad2, X
    T = BrK2[Ec]
    if T <> 255 then
      inc Ad
      vpeek vram.name + Ad into V
      Ad2 = V
    Ad2 = Ad2 << 3
      Ad2 += Tl
      vpeek vram.pattern + Ad2 into X
      X = X & T
      vpoke vram.pattern + Ad2, X
    end if
    inc Ey
  next
  return
end sub

' ---------------------------------------------------------------------------
' between balls and waves (the BASIC driver)

sub BallLost:
  State = StLost
  dec Balls
  ' the ball is taken off, as the BASIC's POKE ...,32
  set sprite 0 to HideY,0,SBall,0
  update sprites
  play sound SndLost
  ShowHud
  if Balls = 0 then return
  print at 9,12, "BALL LOST"
  print at 8,14, "PRESS BUTTON"
  WaitPress
  State = StNext
  RestoreRows
  NewBall
  return
end sub

sub WaveWon:
  State = StWon
  play sound SndWon
  print at 7,11, "YOU WON AT"
  print at 18,11, "SPEED"
  NumU = Speed
  print at 24,11, digits$(NumU, 3)
  T = Speed - 1
  print at 7,13, "NEXT SPEED"
  NumU = T
  print at 18,13, digits$(NumU, 3)
  print at 8,15, "PRESS BUTTON"
  WaitPress
  State = StNext
  Total += 95
  dec Speed
  NewWave
  return
end sub

' at least one second on screen, then a new press
sub WaitPress:
  Waited = 0
  WasBtn = 16
wp_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited < 60 then goto wp_loop
  if Press = 0 then goto wp_loop
  return
end sub

sub RestoreRows:
  copy PlayNames + 320 count 32 to vram.name + 320
  copy PlayNames + 352 count 32 to vram.name + 352
  copy PlayNames + 384 count 32 to vram.name + 384
  copy PlayNames + 416 count 32 to vram.name + 416
  copy PlayNames + 448 count 32 to vram.name + 448
  copy PlayNames + 480 count 32 to vram.name + 480
  copy PlayNames + 512 count 32 to vram.name + 512
  return
end sub

sub GameOver:
  ShowHud
  print at 10,11, "GAME OVER"
  print at 9,13, "SCORE"
  NumU = Total + Sc
  print at 15,13, digits$(NumU, 5)
  print at 8,15, "PRESS BUTTON"
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' ball: x = 27 + 5 col, y = 28 + 6 row; paddle on row 23
sub DrawSprites:
  X = Bc * 5
  X += 27
  Y = Br0 * 6
  Y += 27
  set sprite 0 to Y,X,SBall,4
  PadCells
  X = Pa * 5
  X += 27
  set sprite 1 to 165,X,SPl29,9
  X += 16
  if Pm = 0 then
    set sprite 2 to 165,X,SPr24,9
  else
    set sprite 2 to 165,X,SPr29,9
  end if
  update sprites
  return
end sub

sub ShowScore:
  NumU = Total + Sc
  print at 8,1, digits$(NumU, 5)
  ShownSc = Sc
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 14,1, "BALL"
  NumU = Balls
  print at 19,1, digits$(NumU, 1)
  print at 21,1, "SPEED"
  NumU = Speed
  if Speed = 0 then NumU = 256
  print at 27,1, digits$(NumU, 3)
  return
end sub

' a Graphics II picture: font in every third (black on the backdrop in the
' first third, dark blue on white in the field), picture tiles from 128
sub PicScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  fill $10 count 768 to vram.color + 256
  fill $4F count 768 to vram.color + 2304
  fill $4F count 768 to vram.color + 4352
  backdrop 3
  return
end sub

sub DrawPlay:
  PicScreen
  decompress zx0 PlayPat0Z to vram.pattern + 1024
  decompress zx0 PlayCol0Z to vram.color + 1024
  decompress zx0 PlayPat1Z to vram.pattern + 3072
  decompress zx0 PlayCol1Z to vram.color + 3072
  decompress zx0 PlayPat2Z to vram.pattern + 5120
  decompress zx0 PlayCol2Z to vram.color + 5120
  copy PlayNames count 768 to vram.name
  ShowHud
  ShowScreen
  DrawSprites
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' every text page starts here (tile screen, the small tiles at 128)
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  tile screen
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

' the title: the brick logo, the menu (cursor back on START), the tune once
sub TitlePage:
  PicScreen
  decompress zx0 TitlePat0Z to vram.pattern + 1024
  decompress zx0 TitleCol0Z to vram.color + 1024
  decompress zx0 TitlePat1Z to vram.pattern + 3072
  decompress zx0 TitleCol1Z to vram.color + 3072
  decompress zx0 TitlePat2Z to vram.pattern + 5120
  decompress zx0 TitleCol2Z to vram.color + 5120
  decompress zx0 TitleNamesZ to vram.name
  print at 7,1, "RERUN SUMMER 1985"
  print at 10,13, "START"
  print at 10,15, "SPEED"
  print at 10,17, "HOW TO PLAY"
  print at 10,19, "CREDITS"
  Menu = 0
  ShowMenu
  ShowSpeed
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
  Rep = 0
tp_loop:
  Frame1
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  ' SPEED: left/right, held: repeats
  K = Jk & 12
  if K = 0 then Rep = 0
  if K > 0 then
    if Menu = 1 then
      T = 0
      if Rep = 0 then T = 1
      inc Rep
      if Rep >= 20 then
        V = Rep & 3
        if V = 0 then T = 1
        Rep = 20 + V
      end if
      if T = 1 then
        if K = 4 then
          if Speed > 1 then dec Speed
        end if
        if K = 8 then
          if Speed < 255 then inc Speed
        end if
        ShowSpeed
      end if
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

sub ShowSpeed:
  NumU = Speed
  print at 17,15, digits$(NumU, 3)
  return
end sub

sub ShowMenu:
  put char 32 at 8,13
  put char 32 at 8,15
  put char 32 at 8,17
  put char 32 at 8,19
  C = Menu << 1
  C += 13
  put char 62 at 8,C
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 11,1, "BLOCK BUST"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages; pictures from the game's tiles and sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the picture: blocks, the ball, the paddle
  fill TWall count 20 at 6,13
  fill TBrick count 18 at 7,14
  fill TField count 18 at 7,15
  fill TField count 18 at 7,16
  fill TField count 18 at 7,17
  fill TField count 18 at 7,18
  for Li = 14 to 18
    put char TWall at 6,Li
    put char TWall at 25,Li
  next
  set sprite 0 to 128,140,SBall,4
  set sprite 1 to 140,104,SPl29,9
  set sprite 2 to 140,120,SPr29,9
  update sprites
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jall = V
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker off
  for J = 0 to 2
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

data TilePatZ bytes
  $26,$00,$08,$2A,$00,$84,$00,$57,$55,$55,$80
end data
data TileColZ bytes
  $6B,$0F,$F9,$F8,$F1,$AF,$F6,$04,$FE,$29,$0F,$75,$55,$58
end data
data SpritePatZ bytes
  $22,$60,$F0,$24,$60,$00,$58,$AE,$7F,$FF,$7F,$E0,$5A,$FF,$29,$FF,$0A,$FE,$2F,$FE,$80,$45,$F5,$E0
  $82,$F0,$F8,$F8,$F0,$17,$55,$55,$80
end data
data TitleNamesZ bytes
  $90,$80,$12,$21,$81,$82,$58,$86,$83,$80,$1A,$84,$85,$86,$87,$88,$7A,$85,$89,$88,$F6,$65,$86,$8A
  $8B,$8A,$89,$8C,$F2,$8D,$C0,$03,$8E,$8F,$90,$91,$92,$8E,$93,$92,$E2,$FF,$ED,$94,$95,$E2,$E3,$96
  $97,$63,$98,$95,$D8,$C0,$28,$99,$9A,$9B,$9C,$9E,$99,$9D,$F7,$39,$9E,$9F,$EC,$FF,$D8,$C0,$60,$B8
  $A0,$A1,$A2,$A3,$F7,$B8,$A4,$A5,$ED,$96,$A6,$A7,$2F,$A8,$A9,$C0,$2D,$81,$DB,$EF,$FA,$DB,$F7,$F7
  $89,$8B,$05,$87,$8C,$9B,$F6,$8D,$BC,$14,$C0,$8E,$89,$89,$03,$E1,$93,$0F,$EF,$91,$96,$89,$97,$98
  $EC,$4A,$BF,$9D,$F7,$D5,$87,$C0,$E9,$15,$38,$FB,$9E,$A3,$89,$4F,$EC,$BF,$3B,$89,$47,$D9,$96,$C0
  $1E,$AA,$AB,$AC,$AD,$AE,$F6,$82,$AF,$B0,$B1,$B2,$67,$89,$B3,$B4,$C6,$C0,$78,$B5,$B6,$B7,$F6,$88
  $B8,$B9,$62,$89,$BA,$E5,$C0,$B9,$20,$FE,$4E,$C0,$55,$69,$83,$05,$2D,$84,$21,$C0,$82,$85,$86,$86
  $87,$12,$93,$88,$5E,$D5,$FE,$08,$AE,$8B,$8C,$8D,$E4,$1B,$8E,$9D,$C0,$79,$B1,$FE,$48,$80,$91,$80
  $4D,$55,$56
end data
data PlayPat0Z bytes
  $85,$00,$A6,$1F,$9A,$00,$FF,$69,$00,$A6,$F8,$96,$1F,$A8,$FF,$F0,$3A,$C8,$FE,$3C,$FE,$F0,$BF,$0F
  $FE,$AF,$F0,$03,$FE,$EB,$F0,$C0,$EE,$FE,$00,$B0,$10,$1B,$00,$8A,$FE,$F8,$5A,$07,$08,$A8,$00,$F0
