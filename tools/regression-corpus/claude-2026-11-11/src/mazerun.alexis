cartridge "MAZE RUN/LYSLE E. SHIELDS/1989"
' MAZE RUN by Lysle E. Shields (RUN magazine's ReRUN disk, Sept./Oct. 1989),
' ported to the ColecoVision in Amy.
'
' The original (ML at $3000, studied in jsc64 and VICE 3.10 x64sc):
' - a new random maze of 34 x 16 cells each level (depth-first carving with
'   backtracking, started at cell 1,1; random first direction, then the
'   next free one in the order down, up, right, left)
' - the ball starts top-left (cell 0,0), the exit "E" is bottom-right
'   (cell 33,15); both blink through 14 colours
' - one pass of the game every ~6 frames (an 82k-cycle delay loop): the
'   stick is read once per pass; exactly one open direction moves one cell
' - a cell never visited before: +1 point; stepping on a visited cell:
'   -1 point (never below 0)
' - the clock starts at 60 and counts seconds (60 IRQs); it ticks each
'   second and beeps under 10. At 0 the game ends.
' - at the exit: each second left gives 100 points (counted up with a
'   beep); the next maze gets (left + left / 2 + 5) seconds, at most 90
' Port: cells are 6 x 8 pixels (4 cells per 3 tiles) so the whole maze fits
' in columns 3-28; everything else as the original.

const TMza0 = 128
const TMza1 = 129
const TMza2 = 130
const TMza3 = 131
const TMza4 = 132
const TMza5 = 133
const TMza6 = 134
const TMza7 = 135
const TMza8 = 136
const TMza9 = 137
const TMza10 = 138
const TMza11 = 139
const TMza12 = 140
const TMza13 = 141
const TMza14 = 142
const TMza15 = 143
const TMza16 = 144
const TMza17 = 145
const TMza18 = 146
const TMza19 = 147
const TMza20 = 148
const TMza21 = 149
const TMza22 = 150
const TMza23 = 151
const TMza24 = 152
const TMza25 = 153
const TMza26 = 154
const TMza27 = 155
const TMza28 = 156
const TMza29 = 157
const TMza30 = 158
const TMza31 = 159
const TMzb0 = 160
const TMzb1 = 161
const TMzb2 = 162
const TMzb3 = 163
const TMzb4 = 164
const TMzb5 = 165
const TMzb6 = 166
const TMzb7 = 167
const TMzc0 = 168
const TMzc1 = 169
const TMzc2 = 170
const TMzc3 = 171
const TMzc4 = 172
const TMzc5 = 173
const TMzc6 = 174
const TMzc7 = 175
const TO1l = 176
const TO1m = 177
const TO1r = 178
const TOsl = 179
const TOsr = 180
const TO3l = 181
const TO3m = 182
const TO3r = 183
const TO22l = 184
const TO22m = 185
const TO22r = 186
const TGrey = 187
const TBlk = 188
const SBall = 0
const SExit = 4
const SArrow = 8
const NTiles8 = 488
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndStep = 6
const SndBack = 7
const SndTick = 8
const SndBeep = 9
const SndBonus = 10
const SndOver = 11
const TuneFrames = 896
const TxtCredits = 0
const NSpr = 4
const HideY = 192
const MW = 34
const MH = 16
const MCells = 544
' screen position of cell 0,0 (pixels) and of the maze tiles
const MX0 = 24
const MY0 = 40
' frames per pass (measured: 10 cells a second = 5.9 frames)
const PassFrames = 6
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StBonus = 5
const StNext = 6
const StOver = 9

const MBase = 1024
u8 Sc[6]
u8 Hi[6]
data BlinkCol bytes = 4, 6, 12, 13, 4, 5, 7, 3, 2, 11, 10, 6, 8, 9
u16 Cur = 0
u16 Nb = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 TzLoop = 0
u8 State = 0
u8 Px = 0
u8 Py = 0
u8 LastX = 255
u8 LastY = 255
u8 Secs = 60
u8 SecFr = 60
u8 Clock = 0
u8 PassFr = 0
u8 ColI = 0
u8 ColFr = 0
u8 Level = 0
u8 Gc = 0
u8 Gr = 0
u8 Av = 0
u8 Dir = 0
u8 Cell = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
u8 Ri = 0
u8 Gi = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Lw = 0
u8 Tw = 0
u8 Cc = 0
u8 Ta = 0
u8 Tb = 0
u8 Tc = 0
u8 Td = 0
u8 La = 0
u8 Lb = 0
u8 Lc = 0
u8 Ld = 0
u8 Pd = 0
u8 Rb = 0
u8 Left = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  for Oi = 0 to 5
    Hi[Oi] = 0
    Sc[Oi] = 0
  next
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  if State = StPlay then goto play_loop
  if State = StBonus then
    LevelDone
    goto play_loop
  end if

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' a byte xorshift16 (7,9,8); stepped every title frame
sub RandB:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  Rb = Rs
  return
end sub

sub NewGame:
  for Oi = 0 to 5
    Sc[Oi] = 0
  next
  Secs = 60
  Level = 1
  StartMaze
  return
end sub

' a new maze, the ball top-left, the clock running
sub StartMaze:
  State = StNext
  NewScreen
  DrawFrame
  GenMaze
  DrawMaze
  Px = 0
  Py = 0
  LastX = 255
  LastY = 255
  SecFr = 60
  Clock = 1
  PassFr = 1
  ColI = 0
  ColFr = 20
  ShowHud
  ShowTime
  ShowScreen
  DrawSprites
  TzOn = 0
  StartTune
  State = StPlay
  return
end sub

' one frame of play: the clock (the original's IRQ), then a pass every
' PassFrames frames (the original's main loop with its delay)
sub PlayFrame:
  if Clock = 1 then
    dec SecFr
    if SecFr = 0 then
      SecFr = 60
      dec Secs
      ShowTime
      if Secs = 0 then
        Clock = 0
      else
        if Secs < 10 then
          play sound SndBeep
        else
          play sound SndTick
        end if
      end if
    end if
  end if
  ' both sprites blink through the original's 14 colours, at 3 Hz
  dec ColFr
  if ColFr = 0 then
    ColFr = 20
    inc ColI
    if ColI >= 14 then ColI = 0
    DrawSprites
  end if
  dec PassFr
  if PassFr > 0 then return
  PassFr = PassFrames
  if Clock = 0 then
    State = StOver
    return
  end if
  ' the cell under the ball: new +1, visited -1 (only when the ball moved)
  if Px <> LastX then
    MarkCell
  else
    if Py <> LastY then MarkCell
  end if
  MoveBall
  DrawSprites
  if Px = 33 then
    if Py = 15 then
      Clock = 0
      State = StBonus
    end if
  end if
  return
end sub

sub MarkCell:
  LastX = Px
  LastY = Py
  Cur = Py * MW
  Cur += Px
  vpeek vram.spr_pat + MBase + Cur into Cell
  V = Cell & 16
  if V = 0 then
    Cell = Cell | 16
    vpoke vram.spr_pat + MBase + Cur, Cell
    ScoreUp
    play sound SndStep
  else
    ScoreIsZero
    if V = 0 then
      ScoreDown
      play sound SndBack
    end if
  end if
  ShowScore
  return
end sub

' the stick: exactly one open direction moves one cell (a diagonal into a
' wall becomes the open half, as in the original)
sub MoveBall:
  Cur = Py * MW
  Cur += Px
  vpeek vram.spr_pat + MBase + Cur into Cell
  V = Cell & 15
  V = V ^ 15
  V = V & Jk
  if V = 1 then dec Py
  if V = 2 then inc Py
  if V = 4 then dec Px
  if V = 8 then inc Px
  return
end sub

' 6-digit score (as the original's digit array)
sub ScoreUp:
  J = 5
su_loop:
  K = Sc[J]
  inc K
  if K < 10 then
    Sc[J] = K
    return
  end if
  Sc[J] = 0
  if J = 0 then return
  dec J
  goto su_loop
end sub

sub ScoreDown:
  J = 5
sd_loop:
  K = Sc[J]
  if K > 0 then
    dec K
    Sc[J] = K
    return
  end if
  Sc[J] = 9
  if J = 0 then return
  dec J
  goto sd_loop
end sub

' V = 0 when the score is 0, else 1
sub ScoreIsZero:
  V = 1
  for J = 0 to 5
    K = Sc[J]
    if K > 0 then V = 0
  next
  return
end sub

' the exit reached: each second left = 100 points, counted up with a beep
' (the clock counts down as it pays), then the next maze's time
sub LevelDone:
  Left = Secs
  T = Secs
  for Oi = 1 to 90
    if T = 0 then goto ld_paid
    Frame1
    Frame1
    ' + 100
    J = 3
    ScoreCarry
    dec T
    Secs = T
    ShowTime
    ShowScore
    play sound SndBonus
  next
ld_paid:
  ' the score stays on screen for a second and a half
  for Oi = 1 to 90
    Frame1
  next
  ' next time: left + left/2 + 5, at most 90
  Secs = Left
  T = Secs >> 1
  Secs += T
  Secs += 5
  if Secs > 90 then Secs = 90
  inc Level
  StartMaze
  return
end sub

' add 1 at digit J (J = 3: 100 points)
sub ScoreCarry:
sc_loop:
  K = Sc[J]
  inc K
  if K < 10 then
    Sc[J] = K
    return
  end if
  Sc[J] = 0
  if J = 0 then return
  dec J
  goto sc_loop
end sub

' ---------------------------------------------------------------------------
' the maze: in VRAM (sprite pattern table + 1024, unused), r * 34 + c: bits 1 up, 2 down, 4 left, 8 right walls,
' 16 visited by the ball, 32 carved, 64-128 the way back (0 up 1 down
' 2 left 3 right) while carving

sub GenMaze:
  fill 15 count MCells to vram.spr_pat + MBase
  Gc = 1
  Gr = 1
  Cur = 35
  vpoke vram.spr_pat + MBase + Cur, 47
gm_loop:
  ' free neighbours: 1 down, 2 up, 4 right, 8 left (the original's order)
  Av = 0
  if Gr < 15 then
    Nb = Cur + MW
    vpeek vram.spr_pat + MBase + Nb into V
    V = V & 32
    if V = 0 then Av = Av | 1
  end if
  if Gr > 0 then
    Nb = Cur - MW
    vpeek vram.spr_pat + MBase + Nb into V
    V = V & 32
    if V = 0 then Av = Av | 2
  end if
  if Gc < 33 then
    Nb = Cur + 1
    vpeek vram.spr_pat + MBase + Nb into V
    V = V & 32
    if V = 0 then Av = Av | 4
  end if
  if Gc > 0 then
    Nb = Cur - 1
    vpeek vram.spr_pat + MBase + Nb into V
    V = V & 32
    if V = 0 then Av = Av | 8
  end if
  if Av = 0 then goto gm_back
  RandB
  Dir = Rb & 3
gm_pick:
  V = 1 << Dir
  V = V & Av
  if V = 0 then
    inc Dir
    Dir = Dir & 3
    goto gm_pick
  end if
  vpeek vram.spr_pat + MBase + Cur into Cell
  if Dir = 0 then
    Cell = Cell & 253
    vpoke vram.spr_pat + MBase + Cur, Cell
    Cur += MW
    inc Gr
    ' came from above: the way back is up (0)
    vpeek vram.spr_pat + MBase + Cur into Cell
    Cell = Cell & 254
    Cell = Cell | 32
    vpoke vram.spr_pat + MBase + Cur, Cell
    goto gm_loop
  end if
  if Dir = 1 then
    Cell = Cell & 254
    vpoke vram.spr_pat + MBase + Cur, Cell
    Cur -= MW
    dec Gr
    vpeek vram.spr_pat + MBase + Cur into Cell
    Cell = Cell & 253
    Cell = Cell | 96
    vpoke vram.spr_pat + MBase + Cur, Cell
    goto gm_loop
  end if
  if Dir = 2 then
    Cell = Cell & 247
    vpoke vram.spr_pat + MBase + Cur, Cell
    Cur += 1
    inc Gc
    vpeek vram.spr_pat + MBase + Cur into Cell
    Cell = Cell & 251
    Cell = Cell | 160
    vpoke vram.spr_pat + MBase + Cur, Cell
    goto gm_loop
  end if
  Cell = Cell & 251
  vpoke vram.spr_pat + MBase + Cur, Cell
  Cur -= 1
  dec Gc
  vpeek vram.spr_pat + MBase + Cur into Cell
    Cell = Cell & 247
  Cell = Cell | 224
  vpoke vram.spr_pat + MBase + Cur, Cell
  goto gm_loop
gm_back:
  if Cur = 35 then return
  vpeek vram.spr_pat + MBase + Cur into Cell
  V = Cell >> 6
  if V = 0 then
    Cur -= MW
    dec Gr
    goto gm_loop
  end if
  if V = 1 then
    Cur += MW
    inc Gr
    goto gm_loop
  end if
  if V = 2 then
    Cur -= 1
    dec Gc
    goto gm_loop
  end if
  Cur += 1
  inc Gc
  goto gm_loop
end sub

' the walls of cell Cc on maze row Ri (16 = the line under the maze):
' Lw = left wall, Tw = top wall (0/1); cell 34 is the right border
sub CellWalls:
  Lw = 0
  Tw = 0
  if Cc > 34 then return
  if Ri = 16 then
    if Cc < 34 then Tw = 1
    return
  end if
  if Cc = 34 then
    Lw = 1
    return
  end if
  Cur = Ri * MW
  Cur += Cc
  vpeek vram.spr_pat + MBase + Cur into Cell
  V = Cell & 4
  if V > 0 then Lw = 1
  V = Cell & 1
  if V > 0 then Tw = 1
  return
end sub

sub DrawMaze:
  for Ri = 0 to 16
    Gr = Ri + 5
    for Gi = 0 to 8
      Cc = Gi << 2
      CellWalls
      La = Lw
      Ta = Tw
      inc Cc
      CellWalls
      Lb = Lw
      Tb = Tw
      inc Cc
      CellWalls
      Lc = Lw
      Tc = Tw
      inc Cc
      CellWalls
      Ld = Lw
      Td = Tw
      Gc = Gi * 3
      Gc += 3
      T = Lb << 1
      T += La
      V = Ta << 2
      T += V
      V = Tb << 3
      T += V
      if Gi > 0 then
        V = Pd << 4
        T += V
      end if
      Pd = Td
      T += TMza0
      put char T at Gc,Gr
      inc Gc
      T = Lc << 1
      T += Tb
      V = Tc << 2
      T += V
      T += TMzb0
      put char T at Gc,Gr
      if Gi < 8 then
        inc Gc
        T = Ld << 1
        T += Tc
        V = Td << 2
        T += V
        T += TMzc0
        put char T at Gc,Gr
      end if
    next
  next
  return
end sub

' the original's nested raised grey panels: the outer one (columns 2-29,
' rows 1-22) holding the HUD panel (rows 1-3) and the maze panel (rows
' 3-22). Text turns black on grey (the HUD; one colour table for the
' three thirds); the black border outside the panel is the solid black tile
sub DrawFrame:
  fill $1E count 1024 to vram.color
  fill TBlk count 32 at 0,0
  fill TBlk count 32 at 0,23
  for Li = 1 to 22
    fill TBlk count 2 at 0,Li
    fill TBlk count 2 at 30,Li
  next
  put char TO1l at 2,1
  fill TO1m count 26 at 3,1
  put char TO1r at 29,1
  fill TGrey count 26 at 3,2
  put char TO3l at 2,3
  fill TO3m count 26 at 3,3
  put char TO3r at 29,3
  fill TGrey count 26 at 3,4
  for Li = 2 to 21
    if Li <> 3 then
      put char TOsl at 2,Li
      put char TOsr at 29,Li
    end if
  next
  put char TO22l at 2,22
  fill TO22m count 26 at 3,22
  put char TO22r at 29,22
  return
end sub

sub DrawSprites:
  T = BlinkCol[ColI]
  V = Py << 3
  V += MY0
  V += 1
  K = Px * 6
  K += MX0
  K += 2
  set sprite 0 to V,K,SBall,T
  set sprite 1 to 161,224,SExit,T
  update sprites
  return
end sub

' HUD (row 1): high score left, the clock in the middle, score right
sub ShowHud:
  print at 9,2, "-HI"
  print at 17,2, "SCORE-"
  for J = 0 to 5
    K = Hi[J] + 48
    C = J + 3
    put char K at C,2
  next
  ShowScore
  return
end sub

sub ShowScore:
  for J = 0 to 5
    K = Sc[J] + 48
    C = J + 23
    put char K at C,2
  next
  return
end sub

sub ShowTime:
  NumU = Secs
  print at 14,2, digits$(NumU, 2)
  return
end sub

' the high score (as the original: only when beaten)
sub NewHigh:
  for J = 0 to 5
    K = Sc[J]
    V = Hi[J]
    if K > V then goto nh_copy
    if K < V then return
  next
  return
nh_copy:
  for J = 0 to 5
    Hi[J] = Sc[J]
  next
  return
end sub

sub GameOver:
  NewHigh
  ShowHud
  for Li = 11 to 15
    fill 32 count 16 at 8,Li
  next
  print at 11,12, "TIME UP"
  print at 9,14, "PRESS BUTTON"
  StopTune
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' music: the title tune once; in play it loops, quietly

sub StartTune:
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  TzOn = 0
  return
end sub

' before every wait: the tune's countdown (in play it starts again), then
' the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      StopTune
      if State = StPlay then StartTune
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the HUD, a fresh maze in its box, the menu on a plain grey panel
' (cursor back on START), the tune once
sub TitlePage:
  NewScreen
  DrawFrame
  GenMaze
  DrawMaze
  ShowHud
  for Li = 7 to 19
    fill 32 count 22 at 5,Li
  next
  print at 12,8, "MAZE RUN"
  print at 9,10, "BY LYSLE SHIELDS"
  print at 12,13, "START"
  print at 12,15, "HOW TO PLAY"
  print at 12,17, "CREDITS"
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  StartTune
  WasBtn = 16
tp_loop:
  Frame1
  RandB
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  StopTune
  mute all
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 10,13
  put char 32 at 10,15
  put char 32 at 10,17
  C = Menu << 1
  C += 13
  put char 62 at 10,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  print at 12,2, "MAZE RUN"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

sub HowTo:
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "RUN THE BALL THROUGH THE"
  print at 2,5, "MAZE TO THE EXIT E IN THE"
  print at 2,7, "LOWER RIGHT CORNER."
  ' the picture: a corridor of real maze tiles, the ball and the exit
  fill TMza12 count 12 at 10,9
  put char TMza1 at 10,10
  fill TGrey count 10 at 11,10
  put char TMzb2 at 21,10
  fill TMza12 count 12 at 10,11
  set sprite 0 to 81,90,SBall,4
  set sprite 1 to 81,160,SExit,8
  update sprites
  print at 2,13, "THE STICK MOVES THE BALL"
  print at 2,15, "ONE SQUARE AT A TIME. HOLD"
  print at 2,17, "IT TO KEEP RUNNING."
  print at 2,19, "THE CLOCK STARTS AT 60."
  print at 8,21, "PRESS THE BUTTON"
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "A NEW SQUARE: 1 POINT."
    print at 2,5, "BACK OVER YOUR PATH:"
    print at 2,7, "1 POINT LOST."
    print at 2,9, "AT THE EXIT EACH SECOND"
    print at 2,11, "LEFT IS WORTH 100 POINTS."
    print at 2,13, "NEXT MAZE: THE TIME LEFT,"
    print at 2,15, "HALF OF IT AGAIN, PLUS 5"
    print at 2,17, "SECONDS (90 AT MOST)."
    print at 2,19, "TIME UP: GAME OVER."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

