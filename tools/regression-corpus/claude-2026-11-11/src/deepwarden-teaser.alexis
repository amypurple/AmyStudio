  mode 2 screen
  sprites 16x16
  sprites double
  set sound table DwSoundTable areas 8
  enable spinner
  nmi off
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame
  StoryPage(0)
  Running = 1

floor_start:
  EnterFloor

play_loop:
  ReadPad
  ' pages: the hero sheet (*), the map (# or blue); a potion (1 or purple)
  if KpE = 10 then
    SheetPage
    goto floor_view
  end if
  V = PadE & 16
  if KpE = 11 then V = 1
  if V <> 0 then
    MapPage
    goto floor_view
  end if
  V = PadE & 32
  if KpE = 1 then V = 1
  if V <> 0 then Drink
  ' turning: the stick, or the speed roller
  if Lf1 = 1 then Ang = Ang - 4
  if Rt1 = 1 then Ang = Ang + 4
  V = Spin
  Ang = Ang + V
  Ang = Ang + V
  Walk = 0
  HitSlot = 255
  if Up1 = 1 then Advance(22, 0)
  Guard = 0
  if Dn1 = 1 then
    Advance(10, 1)
    Guard = 1
  end if
  if HitSlot <> 255 then Bump(HitSlot)
  if State <> StPlay then goto floor_start
  Weapon
  V = PadE & 64
  if V <> 0 then Flare
  Monsters
  World
  if Hp = 0 then goto game_over
  if Won = 1 then goto the_end
  ' the rules of this pass are done (the bots read the state here)
  inc Tick
  Moved = 0
  if Px <> LPx then Moved = 1
  if Py <> LPy then Moved = 1
  if Ang <> LAng then Moved = 1
  if RuneT = 1 then Moved = 1
  if Moved = 1 then
    LPx = Px
    LPy = Py
    LAng = Ang
    call asm StRays
    call asm StDraw
    Mark
  end if
  DrawMon
  DrawWeapon
  Hud
  PassEnd
  goto play_loop

floor_view:
  ' back from a page: the play screen again
  PlayScreen
  goto play_loop

game_over:
  Running = 0
  MuWant = MuNone
  MuSt = SndDieA
  MusicSting
  Hold(90)
  TextScreen
  TxN = TxOver
  call asm StPrint
  State = StOver
  PageWait
  goto title

the_end:
  Running = 0
  MuSt = SndWinA
  MusicSting
  Hold(120)
  ' the session's best: the fastest finished run, and the most secrets
  V = 0
  if TMin < BestMin then V = 1
  if TMin = BestMin then
    if TFr < BestFr then V = 1
  end if
  if V = 1 then
    BestMin = TMin
    BestFr = TFr
  end if
  if Secrets > BestSec then BestSec = Secrets
  TextScreen
  TxN = TxEnd
  call asm StPrint
  NumU = Secrets
  print at 19,7, digits$(NumU, 1)
  print at 20,7, "/"
  NumU = SecretsAll
  print at 21,7, digits$(NumU, 1)
  ClockAt(19, 9)
  NumU = Lv
  print at 19,11, digits$(NumU, 1)
  NumU = Gold
  print at 19,13, digits$(NumU, 5)
  play sound SndBellToll
  State = StEnd
  PageWait
  goto title

' ---------------------------------------------------------------------------
' you: walking

' Advance(speed, back): along Ang, one axis at a time (walls are slid
' along); HitSlot = a slot cell walked into (going forward); never within
' 1.25 cells of a monster that stands (the cart is pushed instead)
sub Advance(u8 Sv, u8 Back):
  V = Ang
  call asm StCosV
  Dx = V
  if V > 127 then Dx = Dx - 256
  K = Ang - 64
  V = K
  call asm StCosV
  Dy = V
  if V > 127 then Dy = Dy - 256
  V16 = Sv
  Cx = V16
  Dx = Dx * Cx
  Dx = Dx >> 6
  Dy = Dy * Cx
  Dy = Dy >> 6
  if Back = 1 then
    Dx = 0 - Dx
    Dy = 0 - Dy
  end if
  Nx = Px + Dx
  Cx = 48
  if Dx < 0 then Cx = -48
  V16 = Nx + Cx
  Solid(V16, Py, Back)
  if K = 0 then
    MonBlock(Nx, Py)
    if K = 0 then Px = Nx
  end if
  Ny = Py + Dy
  Cx = 48
  if Dy < 0 then Cx = -48
  V16 = Ny + Cx
  Solid(Px, V16, Back)
  if K = 0 then
    MonBlock(Px, Ny)
    if K = 0 then Py = Ny
  end if
  Walk = 1
  return
end sub

' Solid(x, y, back): K = 1 if the cell of (x, y) is a wall (an open slot is
' floor); a closed slot walked into going forward -> HitSlot
sub Solid(u16 Qx, u16 Qy, u8 Bk):
  V = highbyte Qy
  Qc = V
  Qc = Qc << 4
  V = highbyte Qx
  Qc = Qc + V
  call asm StPeekMap
  K = 0
  if Pk <> 0 then
    K = 1
    if Bk = 0 then
      if Pk >= 4 then
        if Pk < 20 then HitSlot = Pk - 4
      end if
    end if
  end if
  return
end sub


' ---------------------------------------------------------------------------
' you: the slots you walk into

sub Bump(u8 Sl):
  SlotKind(Sl)
  if K = KStairs then
    ' the foreman guards the stairs; a build with fewer floors ends at its
    ' last stairs
    if FmDead = 0 then
      Msg(TxMForeman)
      return
    end if
    if MapNo = Floors - 1 then Won = 1
  end if
  if SlotOpen[Sl] <> 0 then return
  if K = KChest then
    SlotOpen[Sl] = 2
    Loot(V)
  end if
  if K = KGate then
    if Keys > 0 then
      dec Keys
      SlotOpen[Sl] = 1
      play sound SndGate
      Msg(TxMGate)
    else
      play sound SndLocked
      Msg(TxMLocked)
    end if
  end if
  if K = KRune then
    if RuneT > 0 then
      SlotOpen[Sl] = 1
      Secret
    end if
  end if
  if K = KShrine then
    SlotOpen[Sl] = 2
    play sound SndBellToll
    Msg(TxMShrine)
    GainXp(12)
  end if
  if K = KCrack then Msg(TxMCracked)
  if K = KPush then Msg(TxMLoose)
  SetTex
  return
end sub

' SlotKind(slot): K = its kind, V = its arg (the floor's block +272, +288)
sub SlotKind(u8 Sl):
  Qc = 272 + Sl
  call asm StPeekMap
  K = Pk
  Qc = 288 + Sl
  call asm StPeekMap
  V = Pk
  return
end sub


sub Secret:
  inc Secrets
  play sound SndKey
  Msg(TxMSecret)
  return
end sub

' Loot(item): a chest's contents (map.py ITEMS)
sub Loot(u8 It):
  play sound SndGold
  if It = 0 then Gold = Gold + 50
  if It = 1 then inc Pot
  if It = 2 then
    Oil = Oil + 48
    if Oil > 96 then Oil = 96
  end if
  if It = 3 then
    inc Keys
    play sound SndKey
  end if
  if It = 4 then
    HavePick = 1
    if Wpn < 1 then Wpn = 1
  end if
  if It = 8 then
    MaxHp = MaxHp + 2
    Hp = MaxHp
  end if
  if It = 9 then MapFull = MapFull | Bits[MapNo]
  V = It + TxMI0
  Msg(V)
  if It >= 4 then
    MuSt = SndItemA
    MusicSting
  end if
  return
end sub

sub Drink:
  if Pot = 0 then return
  if Hp = MaxHp then return
  dec Pot
  Hp = Hp + 6
  if Hp > MaxHp then Hp = MaxHp
  play sound SndPotion
  return
end sub

sub GainXp(u8 G):
  Xp = Xp + G
  if Lv < 8 then
    V = LvXpT[Lv]
    if Xp >= V then
      inc Lv
      inc Pts
      MuSt = SndLvlA
      MusicSting
      Msg(TxMLevelUp)
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' you: the weapon and the flare

' Weapon: the button swings (drawn back, the slash, the follow-through;
' the dagger is quick, the pick slow); down holds the guard
sub Weapon:
  V = PadE & 128
  if WSt = 0 then
    if V <> 0 then
      WSt = 1
      WT = 0
    end if
  end if
  if WSt > 0 then
    if WSt < 4 then
      inc WT
      if WSt = 1 then
        V = SwingT[Wpn]
        if WT >= V then
          WSt = 2
          WT = 0
          V = SndSwing
          if Wpn = 1 then V = SndPickSwing
          play sound V
          Strike
        end if
      end if
      if WSt = 2 then
        if WT >= 2 then
          WSt = 3
          WT = 0
        end if
      end if
      if WSt = 3 then
        if WT >= 3 then
          WSt = 0
          WT = 0
        end if
      end if
    end if
  end if
  if WSt = 4 then WSt = 0
  if WSt = 0 then
    if Guard = 1 then WSt = 4
  end if
  WFr = WSt
  if Kick > 0 then dec Kick
  return
end sub

' Strike: the slash meets the monster in front (within the weapon's reach,
' near the middle of the view, standing), else the wall in front: a
' cracked wall (with the pick), a push wall (no monster near)
sub Strike:
  V = ReachT[Wpn]
  if MDr <> 255 then
    if MZ < V then
      if MCol >= 12 then
        if MCol <= 19 then
          Hit(MDr)
          return
        end if
      end if
    end if
  end if
  if CSlot = 255 then
    ' a rat burrow in front: smash it (XP once; no rat comes back)
    call asm StBurrow
    if TxN <> 255 then
      Msg(TxN)
      GainXp(8)
      LPx = 0
    end if
    return
  end if
  if CZ > 30 then return
  SlotKind(CSlot)
  if SlotOpen[CSlot] <> 0 then return
  if K = KCrack then
    if HavePick = 1 then
      play sound SndHitBone
      inc CrackHits
      if CrackHits >= 3 then
        SlotOpen[CSlot] = 1
        play sound SndMonDeath
        Secret
      end if
      SetTex
    else
      play sound SndClang
      Msg(TxMCracked)
    end if
  end if
  if K = KPush then
    if PushT = 0 then
      if SeeAny = 0 then
        PushS = CSlot
        PushT = 30
        play sound SndGate
      end if
    end if
  end if
  return
end sub

' Hit(m): your blow on monster m (STR and the weapon; a stunned
' bell-wraith takes double; the Servant in its bell takes nothing)
sub Hit(u8 Hm):
  J = Hm
  K = MSt[J]
  if K >= 3 then
    if K < 6 then return
  end if
  if K = 7 then
    play sound SndClang
    return
  end if
  V = DmgT[Wpn] + Str
  dec V
  if MK[J] = 2 then
    if MStn[J] > 0 then V = V + V
  end if
  K = MHp[J]
  if K > V then
    K = K - V
  else
    K = 0
  end if
  MHp[J] = K
  MSt[J] = 3
  MT[J] = 0
  MRet[J] = 4
  V = MK[J]
  K = HitSndT[V]
  play sound K
  return
end sub

' Flare: the lantern's oil (12) lights the tunnel: monsters in view within
' 5 cells are stunned ~2 s, bell-wraiths take 2, the Servant is driven out
' of its bell; hidden runes glow for 3 s
sub Flare:
  if Oil < 12 then
    play sound SndLocked
    Msg(TxMNoOil)
    return
  end if
  Oil = Oil - 12
  FlareT = 4
  RuneT = 180
  SetTex
  backdrop white
  play sound SndWraithWail
  call asm StViewTrig
  for Mi = 0 to 8
    if MSt[Mi] < 4 then
      call asm StProjOne
      if POn = 1 then
        if PZ < 80 then
          MStn[Mi] = 40
          if MSt[Mi] = 1 then MSt[Mi] = 0
          if MSt[Mi] = 2 then MSt[Mi] = 0
          if MK[Mi] = 2 then
            V = MHp[Mi]
            if V > 2 then
              MHp[Mi] = V - 2
            else
              MHp[Mi] = 0
              MSt[Mi] = 3
              MT[Mi] = 0
            end if
          end if
          if MK[Mi] = 3 then
            MStn[Mi] = 150
            MSt[Mi] = 0
          end if
        end if
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the world: oil, the flare's glow, runes, the push wall, the cart, music

sub World:
  if FlareT > 0 then
    dec FlareT
    if FlareT = 0 then backdrop black
  end if
  if RuneT > 0 then
    dec RuneT
    if RuneT = 0 then SetTex
  end if
  if HurtT > 0 then
    dec HurtT
    if HurtT = 0 then backdrop black
  end if
  ' the lantern burns 1 oil every 48 passes; without oil the light shrinks
  inc OilT
  if OilT >= 48 then
    OilT = 0
    if Oil > 0 then dec Oil
  end if
  DimL = 0
  if Oil = 0 then DimL = 1
  ' the push wall slides (2 cells in about a second)
  if PushT > 0 then
    dec PushT
    J = PushS
    if PushT = 20 then
      SlotOpen[J] = 1
      SetTex
    end if
    if PushT = 6 then
      SlotKind(J)
      SlotOpen[V] = 1
      SetTex
      Secret
    end if
  end if
  ' the cart rolls until a wall; it smashes the barricade, crushes monsters
  ' music: the Servant's chamber, a fight, low health, or the tunnels
  V = MuExplore
  ' (the fight music holds about 8 s after a monster was last in sight)
  if SeeAny = 1 then FightT = 40
  if FightT > 0 then
    V = MuCombat
    dec FightT
  end if
  K = MaxHp >> 2
  if Hp <= K then V = MuLow
  if Boss = 1 then V = MuBoss
  MuWant = V
  ' hints at a hidden rune wall in front (once each; StHint)
  call asm StHint
  if TxN <> 255 then Msg(TxN)
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 28 to vram.name + 706
  end if
  return
end sub


' SetTex: each slot's picture by its kind and state (255: none)
sub SetTex:
  for I = 0 to 15
    SlotKind(I)
    X = 255
    Y = SlotOpen[I]
        if K = KLantern then X = PLantern
    if K = KStairs then X = PShaft
    if K = KChest then
      X = PChest
      if Y <> 0 then X = PChestO
    end if
    if K = KGate then X = PLock
    if K = KCrack then
      if CrackHits = 1 then X = PCrack1
      if CrackHits = 2 then X = PCrack2
    end if
    if K = KPush then X = PMortar
    if K = KRune then
      ' a faint slab, the rune glowing in it under the flare
      X = PSlab
      if RuneT > 0 then X = PRune
    end if
    if K = KShrine then
      X = PShrine
      if Y <> 0 then X = PShrine0
    end if
    if K = KPath then
      ' the push block sits on the first closed path cell after an open one
      if Y = 0 then
        J = I - 1
        if SlotOpen[J] <> 0 then X = PMortar
      end if
    end if
    SlotTex[I] = X
  next
  LPx = 0
  return
end sub

' Mark: the automap: your cell is seen
sub Mark:
  V = highbyte Py
  V = V << 4
  K = highbyte Px
  V = V + K
  K = V >> 3
  J = V & 7
  SeenAt(K)
  V = V | Bits[J]
  SeenPut(K)
  return
end sub

' SeenAt(byte): V = seen byte K of this floor (spare VRAM $1BB0 +
' floor x 32); SeenPut(byte): writes V there
sub SeenAt(u8 Sb):
  V16 = MapNo
  V16 = V16 << 5
  V16 = V16 + Sb
  vpeek vram.name + 944 + V16 into V
  return
end sub

sub SeenPut(u8 Sb):
  V16 = MapNo
  V16 = V16 << 5
  V16 = V16 + Sb
  vpoke vram.name + 944 + V16, V
  return
end sub

' ---------------------------------------------------------------------------
' the monsters

sub Monsters:
  call asm StMonsters
  return
end sub

' Killed: monster Mi dies (from StMonsters): XP, gold, the dead list; the
' Servant's fall ends the game (after its death frames)
sub Killed:
  ' a rat back from its burrow is worth nothing
  call asm StBackQ
  if V = 0 then
    V = MK[Mi]
    V = XpT[V]
    GainXp(V)
    Gold = Gold + 10
  end if
  if Mi < 7 then
    V = Dead[MapNo]
    V = V | Bits[Mi]
    Dead[MapNo] = V
  end if
  if MK[Mi] = 3 then Won = 2
  ' the foreman (wave 64): the way down is open
  V = MonFirst[MapNo] + Mi
  if MonWT[V] = 64 then FmDead = 1
  return
end sub

' MonBlock(x, y): K = 1 when (x, y) is within 20/16 cells of a monster
' that stands (StMonBlock; walking into the cart pushes it)
sub MonBlock(u16 Bx, u16 By):
  V16 = Bx >> 4
  Nx8 = lowbyte V16
  V16 = By >> 4
  Ny8 = lowbyte V16
  call asm StMonBlock
  return
end sub







' Blow: monster Mi's blow lands: on the guard (a clang, nothing lost) or
' on you (its damage less your armour, at least 1, in half hearts)
sub Blow:
  if Guard = 1 then
    play sound SndClang
    Kick = 3
    return
  end if
  V = MK[Mi]
  V = HurtT2[V]
  if MapNo = 2 then inc V
  if V > Arm then
    V = V - Arm
  else
    V = 1
  end if
  play sound SndHurt
  Kick = 4
  if Hp > V then
    Hp = Hp - V
  else
    Hp = 0
  end if
  HurtT = 3
  backdrop dark red
  return
end sub


' DrawMon: the nearest monster in view, its frame by state and size, cut
' by the walls (StMon)
sub DrawMon:
  call asm StWaitSat
  call asm StPickMon
  if MDr <> 255 then
    J = MDr
    X = 3
    if MZ < 82 then X = 2
    if MZ < 52 then X = 1
    if MZ < 33 then X = 0
    K = MSt[J]
    K = ArtT[K]
    V = MK[J] * 6
    V = V + K
    V = V << 2
    MonIx = V + X
    call asm StSel
    MonZ = MZ
    call asm StHgt
    MonY = MonH + 96
    if MK[J] = 2 then
      V = Tick >> 2
      V = V & 7
      Bob = BobT[V]
      MonY = MonY - Bob
    end if
    MonColB = MCol + 16
    MonFlash = 0
    ' the foreman's bones are gold
    V = MonFirst[MapNo] + J
    if MonWT[V] = 64 then MonFlash = 139
    V = MT[J]
    if MSt[J] = 3 then
      if V < 3 then
        K = MK[J]
        MonFlash = FlashT[K]
      end if
    end if
    if MSt[J] = 4 then
      if V >= 18 then MonFlash = 4
    end if
    if MStn[J] > 0 then
      if MK[J] <> 3 then MonFlash = 7
    end if
    K = Moved
    if MonFr <> LFr then K = 1
    if MonColB <> LCol then K = 1
    if MonY <> LY then K = 1
    if MonZ <> LZ then K = 1
    if MonFlash <> LFl then K = 1
    if K = 1 then
      MonBuf = MonBuf ^ 1
      call asm StMon
      LFr = MonFr
      LCol = MonColB
      LY = MonY
      LZ = MonZ
      LFl = MonFlash
    end if
  else
    if ShownN > 0 then
      SpN = 0
      call asm StMnHide
      LFr = 0
    end if
  end if
  ShownN = SpN
  return
end sub

' DrawWeapon: the weapon's frame (one sprite a line), knocked down a few
' lines by a blow, bobbing as you walk; the pick swaps its top piece for
' a head and colours the blade as a handle; the dagger is drawn lower
sub DrawWeapon:
  J = WFr * 17
  N = WpnT[J]
  V = Kick << 1
  if Walk = 1 then
    X = Tick & 4
    V = V + X
  end if
  if Wpn = 0 then V = V + 22
  ' (the lowest piece ends at line 160 + V: kept above line 184, the CRT's
  ' safe area)
  if V > 24 then V = 24
  for K = 0 to 3
    if K < N then
      I = K << 2
      I = I + J
      inc I
      Y = WpnT[I] + V
      dec Y
      inc I
      X = WpnT[I]
      inc I
      Nx8 = WpnT[I]
      inc I
      Ny8 = WpnT[I]
      if Ny8 = 15 then
        if Wpn = 0 then Ny8 = 14
        if Wpn = 1 then
          Ny8 = 10
          I = N - 1
          if K = I then
            Ny8 = 14
            I = PickT[WFr]
            if I <> 255 then Nx8 = I
          end if
        end if
      end if
      if Y > 200 then Y = HideY
      set sprite K to Y,X,Nx8,Ny8
    else
      set sprite K to HideY,0,0,0
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' floors

sub NewGame:
  MapNo = 0
  Hp = 10
  MaxHp = 10
  Str = 1
  Lv = 1
  Xp = 0
  Pts = 0
  Gold = 0
  Oil = 64
  Pot = 1
  Keys = 0
  Wpn = 0
  HavePick = 0
  Arm = 0
  Secrets = 0
  Won = 0
  TFr = 0
  TMin = 0
  for I = 0 to 2
    Dead[I] = 0
  next
  MapFull = 0
  ' the floors' saved state (slots, seen cells) in spare VRAM
  for I = 0 to 143
    vpoke vram.name + 896 + I, 0
  next
  Flr = 0
  return
end sub

' EnterFloor: floor MapNo's state, its monsters, the play screen. Flr =
' 255 after the ladder: arrive by the stairs down of this floor.
sub EnterFloor:
  V = MapNo
  Off = V
  Off = Off << 4
  for I = 0 to 15
    vpeek vram.name + 896 + Off + I into V
    SlotOpen[I] = V
  next
  CrackHits = 0
  PushT = 0
  CartDx = 0
  CartDy = 0
  RuneT = 0
  CallT = 0
  ' the start, or in front of the stairs down (back up the ladder)
  X = StartXT[MapNo]
  Y = StartYT[MapNo]
  Ang = 0
  Px = X
  Px = Px << 8
  Px = Px + 128
  Py = Y
  Py = Py << 8
  Py = Py + 128
  Flr = MapNo
  ' its monsters (the dead stay dead); the way down is open unless a
  ' living foreman is placed
  FmDead = 1
  BossT = 0
  BurD[0] = 255
  BurD[1] = 255
  BurD[2] = 255
  Back = 0
  call asm StInitMons
  ' the cart rolls only once (gone after the barricade)
  ' the Servant's summoned rats: slots 7 and 8, gone until called
  SetTex
  State = StPlay
  MuWant = MuExplore
  MusicNow
  PlayScreen
  return
end sub

' SaveFloor: this floor's slots to spare VRAM (the seen cells live there)
sub SaveFloor:
  V = MapNo
  Off = V
  Off = Off << 4
  for I = 0 to 15
    vpoke vram.name + 896 + Off + I, SlotOpen[I]
  next
  return
end sub

' the play screen: font, walls (in this floor's colours), HUD icons, the
' wall pictures, the weapon's patterns, the HUD, the view
sub PlayScreen:
  TextScreen
  decompress zx0 FeatPZ to vram.pattern + 2048
  decompress zx0 FeatCZ to vram.color + 2048
  copy WpnPat count WpnBytes to vram.spr_pat
  HudAll
  call asm StRays
  call asm StDraw
  LPx = Px
  LPy = Py
  LAng = Ang
  LFr = 0
  ShownN = 16
  State = StPlay
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' the HUD: row 1 the level, its XP bar (and a green arrow: a point to
' spend on the hero sheet), the run's clock (if shown), gold; row 21 the
' hearts, the oil, potions, keys, the weapon and armour; row 22 messages
sub HudAll:
  print at 2,1, "LV"
  put char HCoin at 22,1
  put char HDrop at 12,21
  put char HPotion at 18,21
  put char HKey at 21,21
  ShownHp = 255
  ShownXp = 255
  ShownOil = 255
  ShownInv = 255
  ShownGold = 65535
  MsgT = 0
  Hud
  return
end sub

sub Hud:
  if Hp <> ShownHp then
    ShownHp = Hp
    for K = 0 to 7
      X = K + 2
      V = K << 1
      J = HHblank
      if V < MaxHp then J = HHearte
      if V < Hp then J = HHearth
      inc V
      if V < Hp then J = HHeart
      put char J at X,21
    next
  end if
  V = Xp + Pts
  V = V + Lv
  if V <> ShownXp then
    ShownXp = V
    NumU = Lv
    print at 4,1, digits$(NumU, 1)
    ' XP within this level: 6 cells
    J = Lv - 1
    K = LvXpT[J]
    if Lv = 1 then K = 0
    N = LvXpT[Lv]
    I = N - K
    V = Xp - K
    V16 = V
    V16 = V16 * 6
    V = I
    V16 = V16 / V
    BarV = lowbyte V16
    Bar(6, 6, 1, HXpf, HXpe)
    J = HHblank
    ' (the font's ^: a level-up to spend)
    if Pts > 0 then J = 94
    put char J at 13,1
  end if
  V = Oil >> 3
  if V <> ShownOil then
    ShownOil = V
    BarV = (V + 2) / 3
    Bar(4, 13, 21, HOilf, HOile)
  end if
  V = Pot << 4
  V = V + Keys
  V = V + Wpn
  V = V + Arm
  if V <> ShownInv then
    ShownInv = V
    NumU = Pot
    print at 19,21, digits$(NumU, 1)
    NumU = Keys
    print at 22,21, digits$(NumU, 1)
    J = HDagger
    if Wpn = 1 then J = HPick
    if Wpn = 2 then J = HSword
    put char J at 25,21
    J = HHblank
    if Arm = 1 then J = HLeather
    if Arm = 2 then J = HChain
    put char J at 27,21
  end if
  if Gold <> ShownGold then
    ShownGold = Gold
    NumU = Gold
    print at 23,1, digits$(NumU, 5)
  end if
  if ShowClock = 1 then
    V = Tick & 7
    if V = 0 then ClockAt(14, 1)
  end if
  return
end sub

' Bar(n, x, y, full, empty): a bar of n tiles, the first BarV full
sub Bar(u8 Bn, u8 Bx8, u8 By8, u8 Bf, u8 Be):
  BarN = Bn
  BarX = Bx8
  BarY = By8
  BarF = Bf
  BarE = Be
  call asm StBar
  return
end sub

' ClockAt(x, y): the run's time as M:SS.CC
sub ClockAt(u8 Cx8, u8 Cy8):
  NumU = TMin
  print at Cx8,Cy8, digits$(NumU, 1)
  X = Cx8 + 1
  print at X,Cy8, ":"
  NumU = TFr / 60
  inc X
  print at X,Cy8, digits$(NumU, 2)
  X = X + 2
  print at X,Cy8, "."
  V16 = NumU * 60
  NumU = TFr - V16
  NumU = NumU * 100
  NumU = NumU / 60
  inc X
  print at X,Cy8, digits$(NumU, 2)
  return
end sub

' Msg(n): a line on row 22 for about 3 s
sub Msg(u8 Mn):
  fill 32 count 28 to vram.name + 706
  TxN = Mn
  call asm StPrint
  MsgT = 90
  return
end sub

' ---------------------------------------------------------------------------
' pages

' StoryPage(n): the intro (0), between floors (1, 2)
sub StoryPage(u8 Sn):
  MusicOff
  TextScreen
  TxN = TxStory0 + Sn
  call asm StPrint
  State = StText
  PageWait
  return
end sub

' SheetPage: the hero (keypad *): bars, gear, supplies; spend level-up
' points (+STR or +1 heart); the clock on or off
sub SheetPage:
  State = StSheet
  Menu = 0
sh_draw:
  TextScreen
  TxN = TxSheet
  call asm StPrint
  NumU = Lv
  print at 10,3, digits$(NumU, 1)
  for K = 0 to 7
    X = K + 10
    V = K << 1
    J = HHblank
    if V < MaxHp then J = HHearte
    if V < Hp then J = HHeart
    put char J at X,5
  next
  for K = 0 to 7
    X = K + 12
    J = HHblank
    if K < Str then J = HStrf
    put char J at X,7
  next
  NumU = Xp
  print at 10,9, digits$(NumU, 3)
  put char HDagger at 3,11
  if HavePick = 1 then put char HPick at 5,11
  if Wpn = 2 then put char HSword at 7,11
  if Arm = 1 then put char HLeather at 9,11
  if Arm = 2 then put char HChain at 9,11
  put char HPotion at 13,11
  NumU = Pot
  print at 14,11, digits$(NumU, 1)
  put char HDrop at 17,11
  NumU = Oil
  print at 18,11, digits$(NumU, 2)
  put char HKey at 22,11
  NumU = Keys
  print at 23,11, digits$(NumU, 1)
  put char HCoin at 3,13
  NumU = Gold
  print at 5,13, digits$(NumU, 5)
  NumU = Secrets
  print at 21,13, digits$(NumU, 1)
  print at 22,13, "/"
  NumU = SecretsAll
  print at 23,13, digits$(NumU, 1)
  if Pts > 0 then
    TxN = TxSheet1
    call asm StPrint
  else
    print at 3,15, "TIME"
    ClockAt(9, 15)
  end if
  if ShowClock = 1 then print at 21,20, "ON"
  if ShowClock = 0 then print at 21,20, "OFF"
  ShowScreen
sh_loop:
  for K = 0 to 3
    ' (each option its own row: 16, 18, 20, 22)
    Y = K << 1
    Y = Y + 16
    V = 32
    if K = Menu then V = 62
    put char V at 3,Y
  next
  Frame1
  ReadPad
  if Dn1 = 1 then
    if WasDn = 0 then
      inc Menu
      if Menu > 3 then Menu = 0
      if Pts = 0 then
        if Menu < 2 then Menu = 2
      end if
    end if
  end if
  if Up1 = 1 then
    if WasUp = 0 then
      if Menu = 0 then Menu = 4
      dec Menu
      if Pts = 0 then
        if Menu < 2 then Menu = 3
      end if
    end if
  end if
  WasDn = Dn1
  WasUp = Up1
  if Pts = 0 then
    if Menu < 2 then Menu = 2
  end if
  if KpE = 10 then return
  V = PadE & 192
  if V <> 0 then
    if Menu = 0 then
      if Str < 8 then
        inc Str
        dec Pts
      end if
      goto sh_draw
    end if
    if Menu = 1 then
      if MaxHp < 16 then
        MaxHp = MaxHp + 2
        Hp = Hp + 2
      end if
      dec Pts
      goto sh_draw
    end if
    if Menu = 2 then
      ShowClock = ShowClock ^ 1
      goto sh_draw
    end if
    return
  end if
  goto sh_loop
end sub


' MapPage: the floor's cells you have seen (all of them, the secrets as
' "?", with the floor's map scrap); you are the green arrow
sub MapPage:
  State = StMapPg
  TextScreen
  ' the map's tiles in the middle third too (rows 8-15 hold the view's
  ' wall pictures there otherwise)
  decompress zx0 HudPZ to vram.pattern + 2048
  decompress zx0 HudCZ to vram.color + 2048
  TxN = TxMap
  call asm StPrint
  NumU = MapNo + 1
  print at 12,1, digits$(NumU, 1)
  ' a frame round the 16 x 16 cells (columns 8-23, rows 4-19)
  for I = 7 to 24
    put char 43 at I,3
    put char 43 at I,20
  next
  for I = 4 to 19
    put char 43 at 7,I
    put char 43 at 24,I
  next
  MapAll = MapFull & Bits[MapNo]
  call asm StMapDraw
  ' the foreman, while he stands
  for I = 0 to 8
    if MK[I] < 4 then
      V = MonFirst[MapNo] + I
      if MonWT[V] = 64 then
        if MSt[I] <> 5 then
          X = MX[I] >> 4
          X = X + 8
          Y = MY[I] >> 4
          Y = Y + 4
          put char HMfore at X,Y
        end if
      end if
    end if
  next
  ' you: a white arrow sprite on your cell, the way you face (8 ways),
  ' blinking (under 2 Hz)
  sprites 8x8
  sprites simple
  copy ArrowT count 64 to vram.spr_pat
  ' (its own variables: ReadPad uses K and V)
  Ox = highbyte Px
  Ox = Ox << 3
  Ox = Ox + 64
  Oy = highbyte Py
  Oy = Oy << 3
  Oy = Oy + 31
  Nx8 = Ang + 16
  Nx8 = Nx8 >> 5
  ' the way you face, in words (FACING E, SE ... NE)
  J = Nx8 << 1
  V = DirNT[J]
  put char V at 23,1
  inc J
  V = DirNT[J]
  put char V at 24,1
  ShowScreen
mp_loop:
  Frame1
  ' on 3/4 of the time (off 8 frames in 32), a dark blue shadow behind it
  J = Oy
  V = Tick & 24
  if V = 24 then J = HideY
  set sprite 0 to J,Ox,Nx8,15
  inc J
  N = Ox + 1
  set sprite 1 to J,N,Nx8,4
  update sprites
  ReadPad
  if KpE = 11 then return
  V = PadE & 208
  if V <> 0 then return
  goto mp_loop
end sub

' the title: the picture (the menu drawn in it), the session's best
sub TitlePage:
  State = 0
  Running = 0
  Rearm
  wait
  nmi off
  display off
  HideSprites
  picture screen
  decompress zx0 TitleP to vram $0000
  decompress zx0 TitleC to vram $2000
  fill vram.name with sequence $00..$FF repeat 3
  backdrop black
  sprites 16x16
  sprites double
  DemoStamp
  if BestMin <> 255 then BestLine
  Menu = 0
  TitleMenu
  MusicTitle
  ShowScreen
  State = StTitle
  Waited = 0
tp_loop:
  Frame1
  ReadPad
  if Dn1 = 1 then
    if WasDn = 0 then
      inc Menu
      if Menu = 3 then Menu = 0
      TitleMenu
      play sound SndFootstep
    end if
  end if
  if Up1 = 1 then
    if WasUp = 0 then
      if Menu = 0 then Menu = 3
      dec Menu
      TitleMenu
      play sound SndFootstep
    end if
  end if
  WasDn = Dn1
  WasUp = Up1
  V = PadE & 240
  if V <> 0 then
    MusicOff
    return
  end if
  goto tp_loop
end sub

' TitleMenu: the chosen item white with its sword cursor, the others grey
' (colour bytes of rows 18, 20, 22 of the picture)
sub TitleMenu:
  for I = 0 to 2
    Off = I
    Off = Off * 512 + 4632
    V = $E1
    K = $11
    if I = Menu then
      V = $F1
      K = $B1
    end if
    fill K count 8 to vram.color + Off
    Off = Off + 16
    fill V count 88 to vram.color + Off
  next
  return
end sub

' BestLine: the session's records on row 16 of the picture (cleared to a
' black line): "BEST M:SS.CC   SECRETS n/N" (the fastest finish; the most
' secrets found in a finished run)
sub BestLine:
  fill 0 count 256 to vram.pattern + 4096
  fill $F1 count 256 to vram.color + 4096
  GBase = 4096
  GCol = $F1
  N = 3
  Glyph(13)
  Glyph(14)
  Glyph(15)
  Glyph(16)
  inc N
  V = BestMin
  if BestMin > 9 then V = 9
  Glyph(V)
  Glyph(10)
  NumU = BestFr / 60
  V = lowbyte NumU
  K = V / 10
  Glyph(K)
  K = V - K * 10
  Glyph(K)
  Glyph(11)
  V16 = NumU * 60
  NumU = BestFr - V16
  NumU = NumU * 100
  NumU = NumU / 60
  V = lowbyte NumU
  K = V / 10
  Glyph(K)
  K = V - K * 10
  Glyph(K)
  N = N + 2
  Glyph(15)
  Glyph(14)
  Glyph(17)
  Glyph(18)
  Glyph(14)
  Glyph(16)
  Glyph(15)
  inc N
  Glyph(BestSec)
  Glyph(12)
  Glyph(SecretsAll)
  return
end sub

' DemoStamp: "DEMO" cut into the gold beam under the subtitle (row 6,
' columns 14-17)
sub DemoStamp:
  GBase = 0
  GCol = $1A
  N = 206
  Glyph(19)
  Glyph(14)
  Glyph(20)
  Glyph(21)
  return
end sub

' Glyph(n): glyph n of GlyT into the picture's pattern N (GBase: the
' third's offset), colour GCol
sub Glyph(u8 Gn):
  Off = Gn
  Off = Off << 3
  V16 = N
  V16 = V16 << 3
  V16 = V16 + GBase
  for I = 0 to 7
    J = lowbyte Off
    X = GlyT[J]
    vpoke vram.pattern + V16, X
    vpoke vram.color + V16, GCol
    inc V16
    inc Off
  next
  inc N
  return
end sub

sub CreditsPage:
  TextScreen
  TxN = TxCredits
  call asm StPrint
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: page 1 the two controllers, page 2 the monsters and items
sub HowTo:
  TextScreen
  TxN = TxHow1
  call asm StPrint
  State = StHow
  PageWait
  TextScreen
  TxN = TxHow2
  call asm StPrint
  put char HPotion at 2,17
  put char HDrop at 2,18
  put char HKey at 2,19
  put char HPick at 2,20
  put char HMsecret at 2,21
  ' the three monsters as sprites (their idle frames, far size)
  for Mi = 0 to 2
    MonIx = Mi * 24
    MonIx = MonIx + 2
    call asm StSel
    MonZ = 0
    ' (the floor line under the names; sprite boxes rows 4-12, text from row 13)
    MonY = 74
    V = Mi * 7
    MonColB = V + 22
    MonFlash = 0
    MonBuf = 0
    MonSp0 = SpN
    if Mi = 0 then MonSp0 = 0
    call asm StMon
  next
  MonSp0 = 0
  State = StHowPic
  PageWait
  HideSprites
  return
end sub

sub PageWait:
  ShowScreen
  update sprites
  WasPad = 255
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    return
  end if
  V = PadE & 240
  if V = 0 then goto pw_loop
  return
end sub

' Hold(n): n frames (the music runs)
sub Hold(u8 Hn):
  for J = 1 to Hn
    Frame1
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 20
  sprites flicker off
  for K = 0 to 19
    set sprite K to HideY,0,0,0
  next
  update sprites
  ShownN = 16
  return
end sub

' every text screen starts here: the font, the wall tiles in all three
' thirds, the HUD icons in the top and bottom thirds
sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  ' (mode 2 screen and the default font through StMode2: the BIOS's
  ' INIT_TABLE and LOAD_ASCII change IX)
  call asm StMode2
  sprites 16x16
  sprites double
  duplicate mode 2 patterns
  fill $F1 count 1024 to vram.color
  fill $F1 count 1024 to vram.color + 2048
  fill $F1 count 1024 to vram.color + 4096
  decompress zx0 WallPZ to vram.pattern + 768
  decompress zx0 WallCZ to vram.color + 768
  decompress zx0 WallPZ to vram.pattern + 2816
  decompress zx0 WallCZ to vram.color + 2816
  decompress zx0 WallPZ to vram.pattern + 4864
  decompress zx0 WallCZ to vram.color + 4864
  decompress zx0 HudPZ to vram.pattern
  decompress zx0 HudCZ to vram.color
  decompress zx0 HudPZ to vram.pattern + 4096
  decompress zx0 HudCZ to vram.color + 4096
  backdrop black
  fill 32 count 768 to vram.name
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

' the end of a play pass: the NMI's work and the music for each vblank
' the pass ran through; a pass lasts at least 3 frames; the sprites go up
' in a vblank (after the wait, or at the next pass's first vblank)
sub PassEnd:
  call asm StPoll
  FrPass = FrPass + VbMiss
  SoftNmis
  if FrPass < 3 then
    PassFrames
  else
    SatPend = 1
  end if
  FrPass = 0
  return
end sub

sub SoftNmis:
pe_soft:
  if VbMiss > 0 then
    call asm StSoftNmi
    PlayTick
    dec VbMiss
    goto pe_soft
  end if
  return
end sub

sub PassFrames:
pe_wait:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  PlayTick
  inc FrPass
  if FrPass < 3 then goto pe_wait
  call asm StSatUp
  SatPend = 0
  VbMiss = 0
  return
end sub

' PlayTick: one frame of play: the music, the run's clock
sub PlayTick:
  MusicTick
  if Running = 1 then
    inc TFr
    if TFr >= 3600 then
      TFr = 0
      inc TMin
    end if
  end if
  return
end sub

' Frame1: one frame on a page (the music runs, the clock does not)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  MusicTick
  inc Tick
  return
end sub

' ReadPad: both controllers (stick, the four buttons), the keypad, the
' speed roller; PadE / KpE: what was pressed since the last read
sub ReadPad:
  V = joypad(1)
  K = joypad(2)
  V = V | K
  V = V | LatchJ
  LatchJ = 0
  Up1 = V & 1
  K = V >> 1
  Rt1 = K & 1
  K = V >> 2
  Dn1 = K & 1
  K = V >> 3
  Lf1 = K & 1
  K = WasPad ^ 255
  PadE = V & K
  WasPad = V
  Kp = keypad(1)
  if LatchK <> 255 then Kp = LatchK
  LatchK = 255
  KpE = 255
  if Kp <> WasKp then KpE = Kp
  WasKp = Kp
  Spin = spinner(1)
  return
end sub

' --- DEEPWARDEN music driver: subs (paste with the other subs) ---
' Every in-game loop has a 96-frame bar. MusicTick counts the bar (MuF);
' a new loop asked for in MuWant starts on the next bar line, so explore,
' combat, boss and low-health hand over in tempo (at most 1.6 s later).
'   MuWant = MuCombat            ' smooth: switches on the next bar line
'   MuWant = MuCombat : MusicNow ' at once (the first fight of a level, the boss door)
'   MuSt = SndLvlA : MusicSting  ' sting (SndLvlA, SndItemA, SndWinA, SndDieA); MuWant resumes after it
'   MusicTitle                   ' title tune twice (55 s), then silence
'   MusicOff                     ' everything off
' Call MusicTick once per frame (the play loop and every wait loop).
sub MusicTick:
  if MuTT > 0 then
    MuTT = MuTT - 1
    if MuTT = 0 then
      if MuPass > 1 then
        dec MuPass
        MuTitleGo
      else
        MuTitleStop
      end if
    end if
    return
  end if
  if MuHold > 0 then
    dec MuHold
    if MuHold = 0 then MuStart
    return
  end if
  inc MuF
  if MuF >= 96 then
    MuF = 0
    if MuWant <> MuCur then
      MuStart
    else
      if MuDrum > 0 then play sound MuDrum
    end if
  end if
  return
end sub

sub MusicNow:
  MuHold = 0
  MuStart
  return
end sub

' start MuWant on its bar 1 (the drum bar is replayed by MusicTick on each bar line)
sub MuStart:
  MuF = 0
  MuCur = MuWant
  MuDrum = 0
  stop sound SndCmbDrum
  if MuCur = MuNone then
    stop sound SndExpA
    stop sound SndExpB
    return
  end if
  if MuCur = MuExplore then
    play sound SndExpA
    play sound SndExpB
  end if
  if MuCur = MuCombat then
    play sound SndCmbA
    play sound SndCmbB
    MuDrum = SndCmbDrum
  end if
  if MuCur = MuBoss then
    play sound SndBossA
    play sound SndBossB
    MuDrum = SndBossDrum
  end if
  if MuCur = MuLow then
    play sound SndLowA
    play sound SndLowB
  end if
  if MuDrum > 0 then play sound MuDrum
  return
end sub

' MuSt = SndLvlA, SndItemA, SndWinA or SndDieA. For game over set MuWant = MuNone first.
sub MusicSting:
  MuTT = 0
  MuDrum = 0
  MuCur = MuNone
  stop sound SndCmbDrum
  play sound MuSt
  MuX = MuSt + 1
  play sound MuX
  MuHold = LvlStingFrames
  if MuSt = SndItemA then MuHold = ItemStingFrames
  if MuSt = SndWinA then MuHold = WinStingFrames
  if MuSt = SndDieA then
    play sound SndDieC
    MuHold = DieStingFrames
  end if
  return
end sub

sub MusicTitle:
  MuHold = 0
  MuCur = MuNone
  MuWant = MuNone
  MuPass = 2
  MuTitleGo
  return
end sub

sub MuTitleGo:
  play sound SndTitleC
  play sound SndTitleD
  play sound SndTitleA
  play sound SndTitleB
  MuTT = TitleFrames
  return
end sub

sub MuTitleStop:
  stop sound SndTitleA
  stop sound SndTitleB
  stop sound SndTitleC
  stop sound SndTitleD
  MuTT = 0
  return
end sub

sub MusicOff:
  MuTitleStop
  MuHold = 0
  MuWant = MuNone
  MuStart
  return
end sub

