    db 0,13,247,247,247,247,247,243,255,255,255,191,190,28,12,0
    db 11,240,240,240,248,248,248,252,252,124,30,6
MonP88:
    db 0,16,1,1,7,31,63,63,126,120,112,240,247,239,102,112
    db 112,120,0,16,128,128,224,248,252,252,126,30,14,15,239,247
    db 102,14,14,30
