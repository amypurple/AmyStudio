    db 9,6,1,1,1,15,31,31,0,16,30,63,127,63,127,127
    db 255,255,255,255,255,255,255,255,255,12
MonP97:
    db 0,3,30,30,12,0,0
; DEEPWARDEN: the monsters' rules, one pass (hand asm: the Amy version
; compiled to 4 KB). Arrays MK, MX, MY, MSt, MT, MHp, MRet, MStn (9 each,
; Amy RAM); the monster being stepped is copied to Qk..Qn (8 bytes in the
; same order) and back. Amy subs called from here: Blow (a blow lands on
; you), Killed (a monster dies: XP, gold, the dead list, the Servant).
; Rules (the rules model checks them):
;  - Dist = the larger axis distance to you (1/16 cells); Reach: <= 30.
;  - Moving (state 0): sees you along a clear row or column within 96:
;    comes to 22 at its pace (rat 3/16 a pass, skeleton and the Servant 1,
;    wraith 1 every other pass), else wanders 1/16 every other pass;
;    backing off (MRet) after a blow. At <= 26, rested (MT >= RestT) and
;    not backing off: wind-up (sound WarnT).
;  - Wind-up: WindT passes, then attack (AtkSndT); the attack's pass 2
;    lands (Blow) when in reach; after 8 passes back to moving (rat and
;    wraith back off 8 passes).
;  - Struck (3): 6 passes; at 0 hit points it dies (4: 30 passes, 5 gone).
;  - Stunned (MStn): stands still.
;  - The Servant: phase 1 above 8 hit points, 2 above 4, else 3; phase 2
;    calls two rats every 150 passes (state 6, 20 passes); phase 3 hides in
;    its bell (state 7) unless stunned; in the bell it tolls every 90
;    passes (a blow within 40). It never leaves rows 12-14.

StMonsters:
    xor a
    ld (AMY_UVAR_SeeAny),a
    ld (AMY_UVAR_Boss),a
    ld (AMY_UVAR_Mi),a
    ld hl,(AMY_UVAR_Px)
    call StSh4
    ld (AMY_UVAR_PX16),a
    ld hl,(AMY_UVAR_Py)
    call StSh4
    ld (AMY_UVAR_PY16),a
StMsLoop:
    ld a,(AMY_UVAR_Mi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_MK
    add hl,de
    ld a,(hl)
    cp 4
    jr nc,StMsNext
    call StMLoad
    call StMOne
    call StMSave
StMsNext:
    ld a,(AMY_UVAR_Mi)
    inc a
    ld (AMY_UVAR_Mi),a
    cp 9
    jr nz,StMsLoop
    ; the boss music: BossT passes left
    ld hl,AMY_UVAR_BossT
    ld a,(hl)
    or a
    ret z
    dec (hl)
    ld a,1
    ld (AMY_UVAR_Boss),a
    ret

; StSh4: A = low byte of HL >> 4
StSh4:
    ld a,l
    srl h
    rra
    srl h
    rra
    srl h
    rra
    srl h
    rra
    ret

; StMLoad / StMSave: monster Mi's 8 fields <-> Qk..Qn
StMLoad:
    call StMAddr
StMl1:
    ld a,(hl)
    ld (de),a
    inc de
    ld a,l
    add a,9
    ld l,a
    jr nc,StMl1c
    inc h
StMl1c:
    djnz StMl1
    ret
StMSave:
    call StMAddr
StMs1:
    ld a,(de)
    ld (hl),a
    inc de
    ld a,l
    add a,9
    ld l,a
    jr nc,StMs1c
    inc h
StMs1c:
    djnz StMs1
    ret
StMAddr:
    ld a,(AMY_UVAR_Mi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_MK
    add hl,de
    ld de,AMY_UVAR_Qk
    ld b,8
    ret

; StAbsD: A = |A - B|
StAbsD:
    sub b
    ret nc
    neg
    ret

; StSnd: play sound A (over the music areas)
StSnd:
    push bc
    push de
    push hl
    ld b,a
    ld a,1
    ld (AMY_SOUND_ENABLED),a
    call AMY_PLAY_SOUND
    pop hl
    pop de
    pop bc
    ret

; StKTab: A = table HL [Qk]
StKTab:
    ld a,(AMY_UVAR_Qk)
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    ret

; StMOne: one monster's pass (Qk..Qn)
StMOne:
    ld a,(AMY_UVAR_Qx)
    ld b,a
    ld a,(AMY_UVAR_PX16)
    call StAbsD
    ld (AMY_UVAR_Ox),a
    ld c,a
    ld a,(AMY_UVAR_Qy)
    ld b,a
    ld a,(AMY_UVAR_PY16)
    call StAbsD
    ld (AMY_UVAR_Oy),a
    cp c
    jr nc,StMo1
    ld a,c
StMo1:
    ld (AMY_UVAR_Dist),a
    ld b,0
    cp 31
    jr nc,StMo2
    inc b
StMo2:
    ld a,b
    ld (AMY_UVAR_Reach),a
    ld a,(AMY_UVAR_Qs)
    cp 5
    jp z,StGone
    ; the foreman: the boss music while he fights (any state but moving);
    ; none once he falls (seeing you refreshes it too: StS0)
    call StWave
    cp 64
    jr nz,StMoF
    ld a,(AMY_UVAR_Qs)
    or a
    jr z,StMoF
    ld b,100
    cp 4
    jr c,StMoB
    ld b,0
StMoB:
    ld a,b
    ld (AMY_UVAR_BossT),a
StMoF:
    ; the Servant: in its chamber's music, its phase
    ld a,(AMY_UVAR_Qk)
    cp 3
    jr nz,StMo4
    ld a,(AMY_UVAR_Dist)
    cp 112
    jr nc,StMo3
    ld a,1
    ld (AMY_UVAR_Boss),a
StMo3:
    ld a,(AMY_UVAR_Qh)
    ld b,1
    cp 9
    jr nc,StMoP
    inc b
    cp 5
    jr nc,StMoP
    inc b
StMoP:
    ld a,b
    ld (AMY_UVAR_Phase),a
StMo4:
    ld hl,AMY_UVAR_Qt
    inc (hl)
    ; stunned: it stands
    ld a,(AMY_UVAR_Qn)
    or a
    jr z,StMo5
    dec a
    ld (AMY_UVAR_Qn),a
    ld a,(AMY_UVAR_Qs)
    cp 3
    ret c
StMo5:
    ld a,(AMY_UVAR_Qs)
    or a
    jp z,StS0
    dec a
    jp z,StS1
    dec a
    jp z,StS2
    dec a
    jp z,StS3
    dec a
    jp z,StS4
    dec a
    ret z
    dec a
    jp z,StS6
    jp StS7

; moving
StS0:
    call StMove
    ld a,(AMY_UVAR_MSee)
    or a
    jr z,StS0a
    ld (AMY_UVAR_SeeAny),a
    ; the foreman has seen you: the boss music for ~8 s more
    call StWave
    cp 64
    jr nz,StS0a
    ld a,100
    ld (AMY_UVAR_BossT),a
StS0a:
    ld a,(AMY_UVAR_Qk)
    cp 3
    jr nz,StS0c
    ld a,(AMY_UVAR_Phase)
    cp 3
    jr nz,StS0b
    ld a,(AMY_UVAR_Qn)
    or a
    jr nz,StS0c
    ld a,7
    jp StNewSt
StS0b:
    cp 2
    jr nz,StS0c
    ld hl,AMY_UVAR_CallT
    inc (hl)
    ld a,(hl)
    cp 150
    jr c,StS0c
    ld (hl),0
    ld a,AMY_UCONST_SndRatSqueak
    call StSnd
    ld a,6
    jp StNewSt
StS0c:
    ld a,(AMY_UVAR_Dist)
    cp 27
    ret nc
    ld a,(AMY_UVAR_Qr)
    or a
    ret nz
    ld hl,AMY_UDATA_RestT
    call StKTab
    ld b,a
    ld a,(AMY_UVAR_Qt)
    cp b
    ret c
    ; only one you can see may raise its weapon at you
    call StCanHit
    ret nz
    ld hl,AMY_UDATA_WarnT
    call StKTab
    call StSnd
    ld a,1
StNewSt:
    ld (AMY_UVAR_Qs),a
    xor a
    ld (AMY_UVAR_Qt),a
    ret

; wind-up
StS1:
    ld hl,AMY_UDATA_WindT
    call StKTab
    ld b,a
    ld a,(AMY_UVAR_Qt)
    cp b
    ret c
    ld hl,AMY_UDATA_AtkSndT
    call StKTab
    call StSnd
    ld a,2
    jr StNewSt

; attack
StS2:
    ld a,(AMY_UVAR_Qt)
    cp 2
    jr nz,StS2a
    ld a,(AMY_UVAR_Reach)
    or a
    jr z,StS2a
    call StCanHit
    call z,StBlow
StS2a:
    ld a,(AMY_UVAR_Qt)
    cp 8
    ret c
    ld a,(AMY_UVAR_Qk)
    cp 1
    jr z,StS2b
    ld a,8
    ld (AMY_UVAR_Qr),a
StS2b:
    xor a
    jr StNewSt

; struck
StS3:
    ld a,(AMY_UVAR_Qt)
    cp 6
    ret c
    ld a,(AMY_UVAR_Qh)
    or a
    jr nz,StS2b
    ld a,AMY_UCONST_SndMonDeath
    call StSnd
    call StMSave
    push ix
    push iy
    call AMY_UPROC_Killed
    pop iy
    pop ix
    ld a,4
    jr StNewSt

; dying
StS4:
    ld a,(AMY_UVAR_Qt)
    cp 30
    ret c
    ld a,(AMY_UVAR_Won)
    cp 2
    jr nz,StS4a
    ld a,1
    ld (AMY_UVAR_Won),a
StS4a:
    ; gone: it waits at its home (a rat's burrow), unseen
    call StHome
    ld a,5
    jr StNewSt

; the Servant calls two rats (monsters 7 and 8, when gone)
StS6:
    ld a,(AMY_UVAR_Qt)
    cp 20
    ret c
    ld c,7
StS6a:
    ld b,0
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld a,(hl)
    cp 4
    jr c,StS6b
    xor a
    ld (hl),a
    ld hl,AMY_UVAR_MK
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MT
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MRet
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MStn
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MHp
    add hl,bc
    ld (hl),2
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld (hl),216
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld (hl),40
    ld a,c
    cp 8
    jr nz,StS6b
    ld (hl),216
StS6b:
    inc c
    ld a,c
    cp 9
    jr nz,StS6a
    xor a
    jp StNewSt

; in the bell: out when stunned; it tolls
StS7:
    ld a,(AMY_UVAR_Qn)
    or a
    jr z,StS7a
    xor a
    jp StNewSt
StS7a:
    ld a,(AMY_UVAR_Qt)
    cp 90
    ret c
    xor a
    ld (AMY_UVAR_Qt),a
    ld a,AMY_UCONST_SndBellToll
    call StSnd
    ld a,(AMY_UVAR_Dist)
    cp 41
    ret nc
StBlow:
    call StMSave
    push ix
    push iy
    call AMY_UPROC_Blow
    pop iy
    pop ix
    ret

; StMove: moving (state 0): sight, backing off, coming at you, wandering
StMove:
    xor a
    ld (AMY_UVAR_MSee),a
    ld a,(AMY_UVAR_Dist)
    cp 113
    ret nc
    ; the pace
    ld b,1
    ld a,(AMY_UVAR_Qk)
    or a
    jr nz,StMv1
    ld b,3
StMv1:
    cp 2
    jr nz,StMv2
    ld a,(AMY_UVAR_Tick)
    and 1
    jr z,StMv2
    ld b,0
StMv2:
    ld a,b
    ld (AMY_UVAR_Sp),a
    call StSees
    ld a,(AMY_UVAR_Qr)
    or a
    jr z,StMv3
    dec a
    ld (AMY_UVAR_Qr),a
    ; away from you, along the longer axis
    call StToward
    ld a,(AMY_UVAR_Km)
    neg
    ld (AMY_UVAR_Km),a
    ld a,(AMY_UVAR_Jm)
    neg
    ld (AMY_UVAR_Jm),a
    jr StStepSp
StMv3:
    ld a,(AMY_UVAR_MSee)
    or a
    jr z,StWander
    ld a,(AMY_UVAR_Dist)
    sub 22
    ret c
    ret z
    ld b,a
    ld a,(AMY_UVAR_Sp)
    cp b
    jr c,StMv4
    ld a,b
    ld (AMY_UVAR_Sp),a
StMv4:
    call StToward
StStepSp:
    ; Km, Jm (-1, 0, 1) times the pace
    ld a,(AMY_UVAR_Sp)
    or a
    ret z
    ld b,a
    ld a,(AMY_UVAR_Km)
    ld c,a
    xor a
StSp1:
    add a,c
    djnz StSp1
    ld (AMY_UVAR_Km),a
    ld a,(AMY_UVAR_Sp)
    ld b,a
    ld a,(AMY_UVAR_Jm)
    ld c,a
    xor a
StSp2:
    add a,c
    djnz StSp2
    ld (AMY_UVAR_Jm),a
    jp StStep
StWander:
    ld a,(AMY_UVAR_Tick)
    ld c,a
    and 1
    ret nz
    ld a,c
    and 63
    jr nz,StWd1
    ; a new way every 64 passes (the jitter: from the pass counter)
    ld a,(AMY_UVAR_Mi)
    add a,c
    ld b,a
    add a,a
    add a,a
    add a,b
    rrca
    rrca
    and 3
    ld (AMY_UVAR_Qt),a
    xor a
    ld (AMY_UVAR_Qr),a
    ld (AMY_UVAR_Qn),a
StWd1:
    ld a,(AMY_UVAR_Qt)
    and 3
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_DirX
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Km),a
    ld hl,AMY_UDATA_DirY
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Jm),a
    call StStep
    ld a,(AMY_UVAR_Ok)
    or a
    ret nz
    ld hl,AMY_UVAR_Qt
    inc (hl)
    ret

; StToward: Km, Jm = the unit step toward you along the longer axis
StToward:
    xor a
    ld (AMY_UVAR_Km),a
    ld (AMY_UVAR_Jm),a
    ld a,(AMY_UVAR_Ox)
    ld b,a
    ld a,(AMY_UVAR_Oy)
    cp b
    jr nc,StTwY
    ld a,(AMY_UVAR_Qx)
    ld b,a
    ld a,(AMY_UVAR_PX16)
    cp b
    ld a,1
    jr nc,StTwX1
    ld a,255
StTwX1:
    ld (AMY_UVAR_Km),a
    ret
StTwY:
    ld a,(AMY_UVAR_Qy)
    ld b,a
    ld a,(AMY_UVAR_PY16)
    cp b
    ld a,1
    jr nc,StTwY1
    ld a,255
StTwY1:
    ld (AMY_UVAR_Jm),a
    ret

; StSees: MSee = 1 when you share a row or a column of cells with it,
; within 96, with no closed cell between
StSees:
    ld a,(AMY_UVAR_Dist)
    cp 97
    ret nc
    ld a,(AMY_UVAR_Qx)
    rrca
    rrca
    rrca
    rrca
    and 15
    ld c,a
    ld a,(AMY_UVAR_Qy)
    and $F0
    or c
    ld c,a
    ld a,(AMY_UVAR_PX16)
    rrca
    rrca
    rrca
    rrca
    and 15
    ld b,a
    ld a,(AMY_UVAR_PY16)
    and $F0
    or b
    ld b,a
    ; c = its cell, b = yours
    ld a,c
    xor b
    and $F0
    jr nz,StSe1
    ; the same row
    ld d,1
    ld a,c
    cp b
    jr c,StSe3
    ld d,255
    jr StSe3
StSe1:
    ld a,c
    xor b
    and $0F
    ret nz
    ld d,16
    ld a,c
    cp b
    jr c,StSe3
    ld d,240
StSe3:
    ld a,c
    add a,d
    ld c,a
    cp b
    jr z,StSe4
    push bc
    push de
    ld l,a
    ld h,0
    ld (AMY_UVAR_Qc),hl
    call StPeekMap
    pop de
    pop bc
    ld a,(AMY_UVAR_Pk)
    or a
    ret nz
    jr StSe3
StSe4:
    ld a,1
    ld (AMY_UVAR_MSee),a
    ret

; StStep: a step of Km, Jm (signed 1/16 cells), sliding to the middle of
; the tunnel on the other axis; Ok = 0 when a wall (5/16 margin), another
; monster (within 16) or you (within 20) is in the way; the Servant keeps
; to its chamber (y >= 200)
StStep:
    xor a
    ld (AMY_UVAR_Ok),a
    ld a,(AMY_UVAR_Km)
    ld b,a
    ld a,(AMY_UVAR_Qx)
    add a,b
    ld (AMY_UVAR_Nx8),a
    ld a,(AMY_UVAR_Jm)
    ld b,a
    ld a,(AMY_UVAR_Qy)
    add a,b
    ld (AMY_UVAR_Ny8),a
    ld a,(AMY_UVAR_Km)
    or a
    jr z,StSt2
    ld a,(AMY_UVAR_Qk)
    cp 3
    jr z,StSt2
    ld hl,AMY_UVAR_Ny8
    call StCentre
StSt2:
    ld a,(AMY_UVAR_Jm)
    or a
    jr z,StSt3
    ld hl,AMY_UVAR_Nx8
    call StCentre
StSt3:
    ld a,(AMY_UVAR_Qk)
    cp 3
    jr nz,StSt4
    ld a,(AMY_UVAR_Ny8)
    cp 200
    ret c
StSt4:
    ; the leading edge's cell
    ld a,(AMY_UVAR_Km)
    ld b,0
    or a
    jr z,StSt5
    ld b,5
    jp p,StSt5
    ld b,251
StSt5:
    ld a,(AMY_UVAR_Nx8)
    add a,b
    rrca
    rrca
    rrca
    rrca
    and 15
    ld c,a
    ld a,(AMY_UVAR_Jm)
    ld b,0
    or a
    jr z,StSt6
    ld b,5
    jp p,StSt6
    ld b,251
StSt6:
    ld a,(AMY_UVAR_Ny8)
    add a,b
    and $F0
    or c
    ld l,a
    ld h,0
    ld (AMY_UVAR_Qc),hl
    call StPeekMap
    ld a,(AMY_UVAR_Pk)
    or a
    ret nz
    ; the others
    ld c,0
StSt7:
    ld a,(AMY_UVAR_Mi)
    cp c
    jr z,StSt8
    ld b,0
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld a,(hl)
    cp 4
    jr nc,StSt8
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld a,(AMY_UVAR_Nx8)
    sub (hl)
    jr nc,StSt7a
    neg
StSt7a:
    cp 16
    jr nc,StSt8
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld a,(AMY_UVAR_Ny8)
    sub (hl)
    jr nc,StSt7b
    neg
StSt7b:
    cp 16
    ret c
StSt8:
    inc c
    ld a,c
    cp 9
    jr nz,StSt7
    ; you
    ld a,(AMY_UVAR_PX16)
    ld b,a
    ld a,(AMY_UVAR_Nx8)
    call StAbsD
    cp 20
    jr nc,StSt9
    ld a,(AMY_UVAR_PY16)
    ld b,a
    ld a,(AMY_UVAR_Ny8)
    call StAbsD
    cp 20
    ret c
StSt9:
    ld a,(AMY_UVAR_Nx8)
    ld (AMY_UVAR_Qx),a
    ld a,(AMY_UVAR_Ny8)
    ld (AMY_UVAR_Qy),a
    ld a,1
    ld (AMY_UVAR_Ok),a
    ret

; StCentre: (HL) one step toward the middle of its cell (x16 + 8)
StCentre:
    ld a,(hl)
    and $F0
    add a,8
    cp (hl)
    ret z
    jr c,StCe1
    inc (hl)
    ret
StCe1:
    dec (hl)
    ret

; StMonBlock: K = 1 when (Nx8, Ny8) (1/16 cells: where you would step) is
; within 20 of a standing monster; walking into the cart starts it rolling
; along the nearer axis (CartDx/CartDy, 3/16 a pass)
StMonBlock:
    xor a
    ld (AMY_UVAR_K),a
    ld c,0
StMb1:
    ld b,0
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld a,(hl)
    cp 4
    jr nc,StMb9
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld a,(AMY_UVAR_Nx8)
    sub (hl)
    jr nc,StMb2
    neg
StMb2:
    cp 20
    jr nc,StMb9
    ld d,a
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld a,(AMY_UVAR_Ny8)
    sub (hl)
    jr nc,StMb3
    neg
StMb3:
    cp 20
    jr nc,StMb9
    ld e,a
    ld a,1
    ld (AMY_UVAR_K),a
    ld hl,AMY_UVAR_MK
    add hl,bc
    ld a,(hl)
    cp 4
    jr nz,StMb9
    ld a,(AMY_UVAR_CartDx)
    ld hl,AMY_UVAR_CartDy
    or (hl)
    jr nz,StMb9
    ; push it: away from you along the axis you are farther apart on
    ld a,d
    cp e
    jr c,StMb5
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld a,(AMY_UVAR_Nx8)
    cp (hl)
    ld a,3
    jr c,StMb4
    ld a,253
StMb4:
    ld (AMY_UVAR_CartDx),a
    jr StMb6
StMb5:
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld a,(AMY_UVAR_Ny8)
    cp (hl)
    ld a,3
    jr c,StMb5a
    ld a,253
StMb5a:
    ld (AMY_UVAR_CartDy),a
StMb6:
    ld a,AMY_UCONST_SndGate
    call StSnd
StMb9:
    inc c
    ld a,c
    cp 9
    jr nz,StMb1
    ret

; StWave: A = this monster's wave byte (MonWT; DE = its index in the
; floor tables)
StWave:
    ld a,(AMY_UVAR_MapNo)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_MonFirst
    add hl,de
    ld a,(AMY_UVAR_Mi)
    add a,(hl)
    ld e,a
    ld hl,AMY_UDATA_MonWT
    add hl,de
    ld a,(hl)
    ret

; StGone: a gone monster. A rat (wave 1-63) comes back from its burrow
; after wave x 4 passes, once you are 6 cells away; a sleeper (128 + d)
; rises when you come within d / 2 cells, unless it was killed already
StGone:
    call StWave
    or a
    ret z
    jp m,StGSleep
    cp 64
    ret nc
    add a,a
    add a,a
    ld b,a
    ; its burrow smashed: never
    push bc
    ld hl,AMY_UDATA_BurrowT
    add hl,de
    ld a,(hl)
    call StBurGone
    pop bc
    ret z
    ld hl,AMY_UVAR_Qt
    ld a,(hl)
    inc a
    jr z,StGo1
    ld (hl),a
StGo1:
    cp b
    ret c
    ld a,(AMY_UVAR_Dist)
    cp 96
    ret c
    ; back from the burrow: worth nothing (Back, bit Mi)
    call StBackBit
    or (hl)
    ld (hl),a
    jr StRise
StGSleep:
    and $7F
    add a,a
    add a,a
    add a,a
    ld b,a
    ld a,(AMY_UVAR_Dist)
    cp b
    ret nc
    ; killed already (the floor's record)
    ld a,(AMY_UVAR_MapNo)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Dead
    add hl,de
    ld b,(hl)
    ld a,(AMY_UVAR_Mi)
    ld e,a
    ld hl,AMY_UDATA_Bits
    add hl,de
    ld a,(hl)
    and b
    ret nz
; StRise: back at its home, full hit points, a moment's stagger (state 3),
; its warning sound
StRise:
    call StHome
    ld hl,AMY_UDATA_HpT
    call StKTab
    ld (AMY_UVAR_Qh),a
    xor a
    ld (AMY_UVAR_Qn),a
    ld a,4
    ld (AMY_UVAR_Qr),a
    ld hl,AMY_UDATA_WarnT
    call StKTab
    call StSnd
    ld a,3
    jp StNewSt

; StCanHit: Z when this monster may strike you: it is the one drawn on
; screen (MDr) and has a clear straight line to you (StSees); never through
; a wall or a corner, never unseen
StCanHit:
    ld a,(AMY_UVAR_MDr)
    ld b,a
    ld a,(AMY_UVAR_Mi)
    cp b
    ret nz
    xor a
    ld (AMY_UVAR_MSee),a
    call StSees
    ld a,(AMY_UVAR_MSee)
    cp 1
    ret

; StBackBit: HL = the Back byte of monster Mi, A = its bit (9 monsters:
; Back and Back + 1)
StBackBit:
    ld a,(AMY_UVAR_Mi)
    ld hl,AMY_UVAR_Back
    cp 8
    jr c,StBb1
    inc hl
    sub 8
StBb1:
    ld b,a
    inc b
    ld a,1
StBb2:
    dec b
    ret z
    add a,a
    jr StBb2

; StBackQ: V = 1 when monster Mi came back from a burrow (the bit is
; cleared), else 0
StBackQ:
    call StBackBit
    ld b,a
    and (hl)
    jr z,StBq1
    ld a,b
    cpl
    and (hl)
    ld (hl),a
    ld a,1
StBq1:
    ld (AMY_UVAR_V),a
    ret

; StHome: Qx, Qy = this monster's home (MonXT, MonYT)
StHome:
    call StWave
    ld hl,AMY_UDATA_MonXT
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Qx),a
    ld hl,AMY_UDATA_MonYT
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Qy),a
    ret
; DEEPWARDEN: more of the game in hand asm (the Amy versions were too big
; for the 32 KB cartridge): projecting monsters into the view, choosing
; the one to draw, setting up a floor's monsters, the ore cart, the
; automap page, HUD bars.

; StProjOne: monster Mi into the view: POn = 1 when in front within 150,
; inside the view's width (plus a half monster); PZ its depth, PCol its
; screen column (rounded). CsB, SnB: the view's cos, sin (x 64).
StProjOne:
    xor a
    ld (AMY_UVAR_POn),a
    ld a,(AMY_UVAR_Mi)
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld a,(AMY_UVAR_PX16)
    call StSub8
    ld (AMY_UVAR_Dx),hl
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld a,(AMY_UVAR_PY16)
    call StSub8
    ld (AMY_UVAR_Dy),hl
    call StProj
    ; 8 <= Zf < 150
    ld hl,(AMY_UVAR_Zf)
    ld a,h
    or a
    ret nz
    ld a,l
    cp 8
    ret c
    cp 150
    ret nc
    ; |Xl| <= Zf + 16
    ld hl,(AMY_UVAR_Xl)
    bit 7,h
    jr z,StPj2
    xor a
    sub l
    ld l,a
    sbc a,a
    sub h
    ld h,a
StPj2:
    ld a,h
    or a
    ret nz
    ld a,(AMY_UVAR_Zf)
    add a,16
    jr c,StPj3
    cp l
    ret c
StPj3:
    call StScr
    ; Lp = 132 +- |Xl| x 194 / Zf; 0..380
    ld hl,(AMY_UVAR_Lp)
    ld a,(AMY_UVAR_Xl+1)
    bit 7,a
    ld de,132
    jr z,StPj4
    ex de,hl
    or a
    sbc hl,de
    ret c
    jr StPj5
StPj4:
    add hl,de
StPj5:
    ld de,381
    ld a,l
    sub e
    ld a,h
    sbc a,d
    ret nc
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,l
    ld (AMY_UVAR_PCol),a
    ld a,(AMY_UVAR_Zf)
    ld (AMY_UVAR_PZ),a
    ld a,1
    ld (AMY_UVAR_POn),a
    ret

; StSub8: HL = (HL) - A as a signed 16-bit difference (both 0-255)
StSub8:
    ld e,a
    ld d,0
    ld l,(hl)
    ld h,0
    or a
    sbc hl,de
    ret

; StViewTrig: CsB, SnB from Ang (cos x 64: StCosV)
StViewTrig:
    ld a,(AMY_UVAR_Ang)
    ld (AMY_UVAR_V),a
    call StCosV
    ld (AMY_UVAR_CsB),a
    ld a,(AMY_UVAR_Ang)
    sub 64
    ld (AMY_UVAR_V),a
    call StCosV
    ld (AMY_UVAR_SnB),a
    ld hl,(AMY_UVAR_Px)
    call StSh4
    ld (AMY_UVAR_PX16),a
    ld hl,(AMY_UVAR_Py)
    call StSh4
    ld (AMY_UVAR_PY16),a
    ret

; StPickMon: MDr = the nearest monster shown (standing, struck, calling,
; in the bell, or dying for 26 passes), MZ its depth, MCol its column
StPickMon:
    call StViewTrig
    ld a,255
    ld (AMY_UVAR_MDr),a
    ld (AMY_UVAR_BestZ),a
    xor a
    ld (AMY_UVAR_Mi),a
StPm1:
    ld a,(AMY_UVAR_Mi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_MK
    add hl,de
    ld a,(hl)
    cp 255
    jr z,StPm9
    ld hl,AMY_UVAR_MSt
    add hl,de
    ld a,(hl)
    cp 4
    jr c,StPm2
    cp 6
    jr nc,StPm2
    cp 5
    jr z,StPm9
    ld hl,AMY_UVAR_MT
    add hl,de
    ld a,(hl)
    cp 26
    jr nc,StPm9
StPm2:
    call StProjOne
    ld a,(AMY_UVAR_POn)
    or a
    jr z,StPm9
    ld a,(AMY_UVAR_BestZ)
    ld b,a
    ld a,(AMY_UVAR_PZ)
    cp b
    jr nc,StPm9
    ld (AMY_UVAR_BestZ),a
    ld (AMY_UVAR_MZ),a
    ld a,(AMY_UVAR_PCol)
    ld (AMY_UVAR_MCol),a
    ld a,(AMY_UVAR_Mi)
    ld (AMY_UVAR_MDr),a
StPm9:
    ld a,(AMY_UVAR_Mi)
    inc a
    ld (AMY_UVAR_Mi),a
    cp 9
    jr nz,StPm1
    ret

; StInitMons: floor MapNo's monsters (MonFirst/MonCount, the dead list):
; kind, place, hit points (HpT + the floor; the Servant 12); the others
; (and the Servant's two callable rats) none
StInitMons:
    ld a,(AMY_UVAR_MapNo)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_MonFirst
    add hl,de
    ld c,(hl)
    ld hl,AMY_UDATA_MonCount
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_N),a
    ld hl,AMY_UVAR_Dead
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_V),a
    ld b,0
StIm1:
    ; clear monster b
    push bc
    ld c,b
    ld b,0
    ld hl,AMY_UVAR_MK
    add hl,bc
    ld (hl),255
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld (hl),5
    xor a
    ld hl,AMY_UVAR_MStn
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MRet
    add hl,bc
    ld (hl),a
    ld hl,AMY_UVAR_MT
    add hl,bc
    ld (hl),a
    pop bc
    ; placed?
    ld a,(AMY_UVAR_N)
    cp b
    jr z,StIm8
    jr c,StIm8
    push bc
    ld a,c
    add a,b
    ld e,a
    ld d,0
    ld c,b
    ld b,0
    ld hl,AMY_UDATA_MonKT
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_MK
    add hl,bc
    ld (hl),a
    push af
    ld hl,AMY_UDATA_MonXT
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_MX
    add hl,bc
    ld (hl),a
    ld hl,AMY_UDATA_MonYT
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_MY
    add hl,bc
    ld (hl),a
    ; dead on this floor already?
    ld hl,AMY_UDATA_Bits
    add hl,bc
    ld a,(AMY_UVAR_V)
    and (hl)
    jr nz,StIm7
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld (hl),0
    ; a sleeper starts gone (it rises later: StGone); the foreman has 10
    ; hit points
    ld hl,AMY_UDATA_MonWT
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Qn),a
    or a
    jp p,StImW
    ld hl,AMY_UVAR_MSt
    add hl,bc
    ld (hl),5
StImW:
    pop af
    push af
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_HpT
    add hl,de
    ld a,(AMY_UVAR_MapNo)
    add a,(hl)
    ld d,a
    ld a,e
    cp 3
    jr nz,StIm6
    ld d,12
StIm6:
    ld a,(AMY_UVAR_Qn)
    cp 64
    jr nz,StIm6a
    ld d,10
    xor a
    ld (AMY_UVAR_FmDead),a
StIm6a:
    ld hl,AMY_UVAR_MHp
    add hl,bc
    ld (hl),d
StIm7:
    pop af
    pop bc
StIm8:
    inc b
    ld a,b
    cp 9
    jr nz,StIm1
    ret


; StMapDraw: the automap: every cell seen (or all, with the floor's map
; scrap: MapAll = 1) as a tile at column 8 + x, row 4 + y: rock, floor,
; and for slots MapTileT[kind] (the secrets as "?" only with the scrap)
StMapDraw:
    ld c,0
StMd1:
    ; seen? (VRAM $1BB0 + MapNo x 32 + c / 8, bit c & 7)
    ld a,(AMY_UVAR_MapAll)
    or a
    jr nz,StMd2
    ld a,c
    rrca
    rrca
    rrca
    and 31
    ld e,a
    ld a,(AMY_UVAR_MapNo)
    rrca
    rrca
    rrca
    add a,e
    add a,$B0
    ld e,a
    ld d,$1B
    jr nc,StMd1a
    inc d
StMd1a:
    ld a,e
    out ($BF),a
    ld a,d
    out ($BF),a
    ld a,c
    and 7
    ld b,a
    inc b
    in a,($BE)
StMd1b:
    rrca
    djnz StMd1b
    jr nc,StMd9
StMd2:
    push bc
    ld l,c
    ld h,0
    ld (AMY_UVAR_Qc),hl
    call StPeekMap
    pop bc
    ld a,(AMY_UVAR_Pk)
    ld e,AMY_UCONST_HMfloor
    or a
    jr z,StMd5
    ld e,AMY_UCONST_HMwall
    cp 4
    jr c,StMd5
    cp 20
    jr nc,StMd5
    ; a slot: its kind's map tile (decor cells, 20 and up, are walls)
    sub 4
    push bc
    ld l,a
    ld h,1
    ld de,16
    add hl,de
    ld (AMY_UVAR_Qc),hl
    call StPeekMap
    pop bc
    ld a,(AMY_UVAR_Pk)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_MapTileT
    ld a,(AMY_UVAR_MapAll)
    or a
    jr nz,StMd2s
    ; (an opened slot shows what it is: a found secret is a "?")
    ld a,(AMY_UVAR_Qc)
    sub 16
    push hl
    push bc
    ld l,a
    ld h,0
    ld bc,AMY_UVAR_SlotOpen
    add hl,bc
    ld a,(hl)
    pop bc
    pop hl
    and 1
    jr z,StMd3
StMd2s:
    ld hl,AMY_UDATA_MapTileS
StMd3:
    add hl,de
    ld e,(hl)
StMd5:
    ; the name table: row 4 + c / 16, column 8 + c & 15
    ld a,c
    and $F0
    ld l,a
    ld h,0
    add hl,hl
    ld a,c
    and 15
    add a,8
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    push de
    ld de,128
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    pop de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,e
    out ($BE),a
StMd9:
    inc c
    jp nz,StMd1
    ret

; StBar: BarN tiles from (BarX, BarY) on: the first BarV are BarF, the
; others BarE
StBar:
    ld a,(AMY_UVAR_BarY)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_BarX)
    ld e,a
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_BarN)
    ld b,a
    ld a,(AMY_UVAR_BarV)
    ld c,a
StBr1:
    ld a,c
    or a
    ld a,(AMY_UVAR_BarE)
    jr z,StBr2
    dec c
    ld a,(AMY_UVAR_BarF)
StBr2:
    out ($BE),a
    djnz StBr1
    ret

; StMode2: `mode 2 screen` keeping IX/IY (the runtime's routine ends in the
; BIOS INIT_TABLE, which changes IX; amyc's ABI table says it does not)
StMode2:
    ; (the sprite table back at $1B00: register 5 is set again here)
    xor a
    ld (AMY_UVAR_SatBank),a
    push ix
    push iy
    call AMY_SET_GRAPHICS_MODE2_RAW
    call AMY_LOAD_DEFAULT_ASCII
    pop iy
    pop ix
    ret

; StLatch: the controllers polled as Amy's NMI does (BIOS
; UPDATE_CONTROLLERS, copied to JOYPAD_1.., AMY_DECODE_CONTROLLERS), then a
; press of fire, purple or blue (bits $F0, both controllers) is ORed into
; LatchJ and a keypad key kept in LatchK; ReadPad takes and clears them.
; Keeps BC, DE, HL (and IX, IY).
StLatch:
    push bc
    push de
    push hl
    push ix
    push iy
    call UPDATE_CONTROLLERS
    ld hl,JOYPAD_1
    ld a,($73EE)
    and $4F
    ld (hl),a
    inc hl
    ld a,($73F0)
    and $4F
    ld (hl),a
    inc hl
    ld a,($73EF)
    and $4F
    ld (hl),a
    inc hl
    ld a,($73F1)
    and $4F
    ld (hl),a
    call AMY_DECODE_CONTROLLERS
    ld hl,JOYPAD_1
    ld a,(hl)
    inc hl
    inc hl
    or (hl)
    and $F0
    ld hl,AMY_UVAR_LatchJ
    or (hl)
    ld (hl),a
    ld a,(JOYPAD_1+1)
    cp $FF
    jr z,StLat9
    ld (AMY_UVAR_LatchK),a
StLat9:
    pop iy
    pop ix
    pop hl
    pop de
    pop bc
    ; interrupts back on for the speed roller: Amy's NMI leaves with them
    ; off when the NMI is held off (its NO_NMI exit has no EI)
    ei
    ret

; StCosV: V = cos(V) x 64 (signed; the angle in 256ths), from the quarter
; table StAbsCos (|cos| x 255)
StCosV:
    ld a,(AMY_UVAR_V)
    ld c,a
    and 127
    cp 65
    jr c,StCo1
    neg
    add a,128
StCo1:
    ld e,a
    ld d,0
    ld hl,StAbsCos
    add hl,de
    ld a,(hl)
    srl a
    srl a
    ld b,a
    ld a,c
    sub 65
    cp 127
    ld a,b
    jr nc,StCo2
    neg
StCo2:
    ld (AMY_UVAR_V),a
    ret

; StHint: facing a rune wall not yet open within 3 cells: TxN = MDraft
; (and the wraith's warning) the first time, MRune once it glows (the
; flare); else TxN = 255
StHint:
    ld a,255
    ld (AMY_UVAR_TxN),a
    ld a,(AMY_UVAR_CSlot)
    cp 16
    ret nc
    ld c,a
    ld a,(AMY_UVAR_CZ)
    cp 48
    ret nc
    ld b,0
    ld hl,AMY_UVAR_SlotOpen
    add hl,bc
    ld a,(hl)
    or a
    ret nz
    ld hl,272
    add hl,bc
    ld (AMY_UVAR_Qc),hl
    call StPeekMap
    ld a,(AMY_UVAR_Pk)
    cp AMY_UCONST_KRune
    ret nz
    ld hl,AMY_UVAR_Hint
    ld a,(AMY_UVAR_RuneT)
    or a
    jr z,StHi1
    ld a,(hl)
    cp 2
    ret nc
    ld (hl),2
    ld a,AMY_UCONST_TxMRune
    ld (AMY_UVAR_TxN),a
    ret
StHi1:
    ld a,(hl)
    or a
    ret nz
    inc (hl)
    ld a,AMY_UCONST_TxMDraft
    ld (AMY_UVAR_TxN),a
    ld a,1
    ld (AMY_SOUND_ENABLED),a
    ld b,AMY_UCONST_SndWarnWraith
    jp AMY_PLAY_SOUND

; StBurGone: A = a cell index (StBurGoneP: HL its grid address); Z when it
; is a smashed burrow (BurD)
StBurGoneP:
    ; (HL a grid address: its cell index first)
    ld a,(AMY_UVAR_MapBase)
    ld b,a
    ld a,l
    sub b
StBurGone:
    ld hl,AMY_UVAR_BurD
    cp (hl)
    ret z
    inc hl
    cp (hl)
    ret z
    inc hl
    cp (hl)
    ret

; StBurrow: the sword button facing a rat burrow (the middle ray's cell,
; within reach): TxN = 255, or MBurrow once it breaks (3 hits, 2 with the
; pick: BurHit); it goes into BurD
StBurrow:
    ld a,255
    ld (AMY_UVAR_TxN),a
    ld a,(AMY_UVAR_CZ)
    cp 31
    ret nc
    ld hl,(AMY_UVAR_CCell)
    ld a,(hl)
    cp 38
    ret nz
    call StBurGoneP
    ret z
    ld a,(AMY_UVAR_MapBase)
    ld b,a
    ld a,(AMY_UVAR_CCell)
    sub b
    ld hl,AMY_UVAR_BurCell
    cp (hl)
    jr z,StBu1
    ld (hl),a
    xor a
    ld (AMY_UVAR_BurHit),a
StBu1:
    ld hl,AMY_UVAR_BurHit
    inc (hl)
    ld a,(AMY_UVAR_Wpn)
    cp 1
    ld a,3
    jr nz,StBu2
    dec a
StBu2:
    cp (hl)
    jr z,StBu3
    jr nc,StBuSnd
StBu3:
    ld a,(AMY_UVAR_BurCell)
    ld hl,AMY_UVAR_BurD
    ld b,3
StBu4:
    ld c,(hl)
    inc c
    jr z,StBu5
    inc hl
    djnz StBu4
    ret
StBu5:
    ld (hl),a
    ld a,AMY_UCONST_TxMBurrow
    ld (AMY_UVAR_TxN),a
    ld b,AMY_UCONST_SndMonDeath
    jr StBuS
StBuSnd:
    ld b,AMY_UCONST_SndHitBone
StBuS:
    ld a,1
    ld (AMY_SOUND_ENABLED),a
    jp AMY_PLAY_SOUND
