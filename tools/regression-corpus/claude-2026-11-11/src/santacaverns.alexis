const SXl1rb = 124
const SRob00t = 128
const SRob00b = 132
const SRob01t = 136
const SRob01b = 140
const SRob10t = 144
const SRob10b = 148
const SRob11t = 152
const SRob11b = 156
const STreet = 160
const STreeb = 164
const SPrest = 168
const SPresb = 172
const SSleight = 176
const SSleighb = 180
const SSleighrt = 184
const SSleighrb = 188
const NTiles8 = 216
const SprBytes = 1536
const LvBase = 155
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndJump = 6
const SndGift = 7
const SndDie = 8
const SndTick = 9
const SndOver = 10
const TuneFrames = 952
const TxtCredits = 0
const TxtHow1 = 1
const TxtHow2 = 2
const TxtHow3 = 3
const HideY = 192
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StCard = 5
const StDie = 6
const StBonus = 7
const StNext = 8
const StOver = 9
' phases of the original's main loop (one action each, paid in cycles)
const PhMain = 0
const PhPush = 1
const PhJoy = 2
const PhWalk = 3
const PhJump = 4
const PhGlide = 5
const PhFallO = 6
const PhFallI = 7
const PhDeath = 8
const PhBonus = 9
' CONTROLS: CLIMB (title menu; not in the original): a step on a ladder
const PhClimb = 10
' costs in units of 8 C64 cycles (c64/cyc.mjs measured in jsc64: a jump or
' fall step 9264 cycles, an idle pass 364; the delay loop $4742 is X * 1286,
' so a walk step = 70 * 1286 + ~630 = 90650, a glide step ($474B) 12870, a
' bonus step = delay 30 + the score print ~ 41600); 14000 free cycles a frame
const FrameU = 1750
const CIdle = 46
const CPush = 1140
const CWalk = 11331
const CStep = 1158
const CGlide = 1609
const CBonus = 5200
' CLIMB: 1 px a step, a quarter of a walk step's delay (walk 4 px = 11331):
' Santa climbs at his walking speed (~36 px a second)
const CClimb = 2833
' the side panel: the vertical time bar (2 columns x 8 rows), the numbers
const BarX = 26
const BarX1 = 27
const BarY = 12
' the hidden C64 map for the rules: vram.name + 1024 ($1C00)
const MapOff = 1024

' the original's level tables ($5610, $552E, $5538, $5542, $562C, $5636,
' $5640, $55E9): Santa's start Y, conveyor, robot, robot limits, tree,
' present, sleigh (x, y pairs per screen), the timer speeds
data OSantaY bytes = 198,198,162,75,60
data OConvXY bytes = 110,135,112,135,100,83,111,155,133,170
data ORobXY bytes = 58,124,132,78,225,127,52,143,70,159
data ORobMM bytes = 58,93,132,231,225,250,52,83,70,110
data OTreeXY bytes = 110,87,188,223,176,180,107,212,107,210
data OPresXY bytes = 36,105,252,47,200,52,140,210,39,208
data OExitXY bytes = 40,218,249,218,200,223,37,76,249,71
data OSpeed bytes = 100,75,50,35,25,20
data LeftM bytes = 255,127,63,31,15,7,3,1
data RightM bytes = 128,192,224,240,248,252,254,255
' speed tables (frame budget: u16 multiplies and constant u16 shifts are
' loops in the compiled code; a lookup is a few instructions)
data Row40 words = 0,40,80,120,160,200,240,280,320,360,400,440,480,520,560,600,640,680,720,760,800,840,880,920,960,1000,1040,1080,1120,1160,1200,1240
data Hi256 words = 0,256,512,768
data FeetIdx bytes = 0,12,24,36
data Row32 words = 0,32,64,96,128,160,192,224,256,288,320,352,384,416,448,480,512,544,576,608,640,672,704,736
data Third words = 0,2048,4096

u16 Score = 0
u16 Hi = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Budget = 0
u16 Need = 0
u16 P = 0
u16 Q = 0
u16 W = 0
u16 Wa = 0
u16 Off = 0
u16 CMaskP = 0
u16 CrA = 0
u16 CrP = 0
u16 CrLo = 0
u16 CrHi = 0
u16 ZP = 0
u16 CrN = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' the game (original's variable in brackets)
u8 Lv = 0
u8 Diff = 0
u8 Lives = 0
u8 SX = 0
u8 SY = 0
u8 OldX = 0
u8 NewX = 0
u8 WasPush = 0
u8 Face = 0
u8 DFr = 0
u8 AIdx = 0
u8 Rot = 0
u8 Dir = 0
u8 Fire1 = 0
u8 FallD = 0
u8 FallH = 0
u8 Ph = 0
u8 PhN = 0
u8 Ev = 0
u8 RX = 0
u8 RY = 0
u8 RDir = 0
u8 RFr = 0
u8 RMir = 0
u8 RMin = 0
u8 RMax = 0
u8 AnimCnt = 0
u8 CrumbCnt = 0
u8 TimerSt = 0
u8 TimeCnt = 0
u8 Speed = 0
u8 BarRow = 0
u8 BarSub = 0
u8 Taken = 0
u8 CrFall = 0
u8 ConvF = 0
u8 CvX = 0
u8 CvY = 0
u8 TrX = 0
u8 TrY = 0
u8 PrX = 0
u8 PrY = 0
u8 ExX = 0
u8 ExY = 0
u8 GameEnd = 0
u8 DeathT = 0
u8 Atoms = 0
' CONTROLS: 0 ORIGINAL (ladders are ledges, up/down do nothing, as on the
' C64), 1 CLIMB (up/down climb the ladder characters $6B/$73)
u8 Ctl = 0
u8 ConvPend = 0
u8 Vd = 0
u8 Zn = 0
u8 Zc = 0
u8 Zv = 0
u8 ZTop = 0
u8 ZBot = 0
u8 ZLb = 0
' the crumbled cells still to redraw on the screen (RenderCell, one a
' frame): map offset low byte, high byte + 16 * state (1 = $44, 2 = gone)
u8 RqA[16]
u8 RqB[16]
u8 RqH = 0
u8 RqT = 0
u8 RqN = 0
u8 RqLost = 0
u16 EqW = 0
u8 EqS = 0
u8 Ek = 0
u16 RdW = 0
u16 RdP = 0
u16 RdO = 0
u16 RdA = 0
u8 RdS = 0
u8 RdR = 0
u8 RdK = 0
u8 RdT = 0
u8 RdX = 0
u8 RdG = 0
u8 RdM = 0
u8 RdJ = 0
u8 RdY = 0
u8 RdC = 0
u8 RdB = 0
u8 RdQ = 0
u8 RdMC = 0
u8 RdPart = 0
u8 RdMore = 0
u8 VisPend = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Li = 0
u8 Ri = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Hx = 0
u8 Hy = 0
u8 Ho = 0
u8 Hr = 0
u8 Gx = 0
u8 Gy = 0
u8 Gl = 0
u8 Gc = 0
u8 Gt = 0
u8 Gm = 0
u8 Gr = 0
u8 Ga = 0
u8 Gb = 0
u8 Gk = 0
u8 Si = 0
u8 HObj = 0
u8 HOx = 0
u8 HOy = 0
u8 Gv = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  ' Graphics II with three independent thirds (R3 = $FF): the scaled
  ' cavern has its own tiles and colours in each third
  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  FrameIrq
  RunAtoms
  DrawFrame
  if GameEnd = 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift (only the menus use it: the original has no randomness)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  Score = 0
  Lives = 5
  Lv = 0
  Diff = 0
  GameEnd = 0
  StartScreen
  return
end sub

' the original's $430D: the screen drawn again from its data (crumbled
' ledges back, the present back, the time bar full), Santa at the start
sub StartScreen:
  State = StNext
  ShowCard
  Taken = 0
  CrFall = 0
  TimerSt = 0
  Speed = OSpeed[Diff]
  TimeCnt = Speed
  BarRow = 8
  BarSub = 0
  SX = 40
  SY = OSantaY[Lv]
  Face = 0
  DFr = 0
  AIdx = 0
  Rot = 0
  Dir = 0
  K = Lv << 1
  RX = ORobXY[K]
  CvX = OConvXY[K]
  TrX = OTreeXY[K]
  PrX = OPresXY[K]
  ExX = OExitXY[K]
  RMin = ORobMM[K]
  inc K
  RY = ORobXY[K]
  CvY = OConvXY[K]
  TrY = OTreeXY[K]
  PrY = OPresXY[K]
  ExY = OExitXY[K]
  RMax = ORobMM[K]
  RDir = 0
  RFr = 0
  RMir = 0
  ConvF = 1
  ConvPend = 0
  RqH = 0
  RqT = 0
  RqN = 0
  RdPart = 0
  VisPend = 0
  AnimCnt = 8
  CrumbCnt = 11
  CMaskP = CMaskT[Lv]
  ' CLIMB: the ladders are not ground (a ladder zone holds Santa instead)
  if Ctl = 1 then CMaskP = CMaskNT[Lv]
  DrawLevel
  Ph = PhMain
  Budget = 0
  State = StPlay
  return
end sub

' the original's IRQ ($4F09), once a frame: time bar, robot and conveyor
' every 8 frames, crumbling every 11 frames (screens 2-5)
sub FrameIrq:
  if TimerSt = 0 then
    dec TimeCnt
    if TimeCnt = 0 then
      TimeCnt = Speed
      BarStep
    end if
  end if
  dec AnimCnt
  if AnimCnt = 0 then
    AnimCnt = 8
    ConvF = ConvF ^ 1
    ConvPend = 1
    RFr = RFr ^ 1
    if RDir = 0 then
      if RX < RMax then
        inc RX
      else
        RDir = 1
        RMir = RMir ^ 1
      end if
    else
      if RX >= RMin then
        dec RX
      else
        RDir = 0
        RMir = RMir ^ 1
      end if
    end if
  end if
  dec CrumbCnt
  if CrumbCnt = 0 then
    CrumbCnt = 11
    if Lv > 0 then Crumble
  end if
  ' the conveyor picture (graphics only): not in a frame that crumbled
  ' (frame budget: both together with 3 fall steps overran)
  if CrumbCnt <> 11 then
    if ConvPend = 1 then
      ConvPend = 0
      DrawConv
    else
      ' the screen's side of a taken present, then the crumbled cells, one
      ' a frame (graphics only; the rules use the hidden map at once)
      if VisPend = 1 then
        VisPend = 0
        VisPresent
      else
        if RqN > 0 then RenderNext
      end if
    end if
  end if
  return
end sub

' the time bar ($4E63): 8 cells, 7 shrinking steps each, then the next cell
sub BarStep:
  if BarSub <> 7 then
    C = 8 - BarRow
    T = C + BarY
    if BarSub = 6 then
      put char 32 at BarX,T
      put char 32 at BarX1,T
    else
      K = 0
      if C >= 3 then K = 8
      if C >= 6 then K = 16
      K += TBarw0
      K += BarSub
      inc K
      put char K at BarX,T
      put char K at BarX1,T
    end if
    inc BarSub
  else
    BarSub = 0
    dec BarRow
    if BarRow = 0 then TimerSt = 2
  end if
  return
end sub

' the original's main loop as actions paid from the cycle budget
sub RunAtoms:
  if Ph = PhDeath then
    DeathFrame
    return
  end if
  Budget += FrameU
  Atoms = 0
ra_next:
  Need = CIdle
  if Ph = PhPush then Need = CPush
  if Ph = PhWalk then Need = CWalk
  if Ph = PhJump then Need = CStep
  if Ph = PhGlide then Need = CGlide
  if Ph = PhFallI then Need = CStep
  if Ph = PhBonus then Need = CBonus
  if Ph = PhClimb then Need = CClimb
  if Budget < Need then return
  Budget -= Need
  inc Atoms
  if Ph = PhMain then
    AtMain
  else
    if Ph = PhPush then
      AtPush
    else
      if Ph = PhJoy then
        AtJoy
      else
        if Ph = PhWalk then
          AtWalk
        else
          if Ph = PhJump then
            AtJump
          else
            if Ph = PhGlide then
              AtGlide
            else
              if Ph = PhFallO then
                AtFallO
              else
                if Ph = PhFallI then
                  AtFallI
                else
                  if Ph = PhBonus then AtBonus
                  if Ph = PhClimb then AtClimb
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  ' a new screen or the end: stop for this frame
  if State <> StPlay then
    if State <> StBonus then return
  end if
  if Ph = PhDeath then return
  if Atoms >= 12 then
    Budget = 0
    return
  end if
  goto ra_next
end sub

' $439F..$4460: time out, crumbled ledge, collisions, conveyor
sub AtMain:
  if TimerSt = 2 then
    StartDeath
    return
  end if
  if CrFall = 1 then
    CrFall = 0
    Dir = 0
    FallD = 31
    FallStart
    return
  end if
  Check4898
  if Ev <> 0 then return
  WasPush = 0
  Si = Face << 1
  Si += DFr
  HObj = 7
  HOx = CvX
  HOy = CvY
  HitObj
  if Ho = 1 then
    Ph = PhPush
  else
    Ph = PhJoy
  end if
  return
end sub

' $4425: the conveyor carries Santa 1 px the way he faces, then $49D3
' (the conveyor's end on screens 1, 2, 3, 5) may drop him
sub AtPush:
  WasPush = 1
  if Face = 0 then
    inc SX
  else
    dec SX
  end if
  T = 1
  if Lv = 0 then
    if Face = 0 then
      if SX >= $92 then T = 0
    end if
  end if
  if Lv = 1 then
    if Face = 1 then
      if SX < $68 then T = 0
    else
      if SX >= $90 then T = 0
    end if
  end if
  if Lv = 2 then
    if Face = 1 then
      if SX < $60 then T = 0
    else
      if SX >= $88 then T = 0
    end if
  end if
  if Lv = 4 then
    if Face = 0 then
      if SX >= $A6 then T = 0
    end if
  end if
  if T = 0 then
    Dir = 0
    FallD = 31
    FallStart
  else
    Ph = PhJoy
  end if
  return
end sub

' $4460: the stick and the button
sub AtJoy:
  Fire1 = Btn
  Dir = 0
  K = Jk & 4
  if K > 0 then Dir = 2
  K = Jk & 8
  if K > 0 then Dir = 1
  if Dir = 0 then
    if Ctl = 1 then
      K = Jk & 3
      if K > 0 then
        InZone
        if Zn = 1 then
          Vd = K
          Ph = PhClimb
          return
        end if
      end if
    end if
    FireCheck
    return
  end if
  if Dir = 2 then
    Face = 1
    if SX < $28 then
      ' blocked: the C64 toggles the legs every pass (~35 times a frame, a
      ' flicker); here Santa just stands (3 Hz rule)
      FireCheck
      return
    end if
  else
    Face = 0
    if SX >= $F9 then
      FireCheck
      return
    end if
  end if
  Ph = PhWalk
  return
end sub

' a step: 4 px after the delay; the ground is the one Santa stood on during
' the delay (the C64's collision latch, read after the move)
sub AtWalk:
  OldX = SX
  if Dir = 2 then
    SX -= 4
  else
    SX += 4
  end if
  Check4898
  if Ev <> 0 then return
  Gx = OldX
  Ground
  T = Gv
  ' CLIMB: a step from a ladder zone never drops Santa
  if T = 0 then
    if Ctl = 1 then
      NewX = SX
      SX = OldX
      InZone
      SX = NewX
      T = Zn
    end if
  end if
  if T = 0 then
    Si = Face << 1
    Si += DFr
    NewX = SX
    SX = OldX
    HObj = 7
    HOx = CvX
    HOy = CvY
    HitObj
    SX = NewX
    if Ho = 0 then
      Dir = 0
      FallD = 31
      FallStart
      return
    end if
  end if
  AnimToggle
  FireCheck
  return
end sub

' CLIMB: is Santa (SX, SY) in a ladder zone of this screen? (Zone tables
' from art.py: SX min, max, SY top, ladder end, bottom = floor + 7)
' -> Zn, ZTop, ZLb, ZBot
sub InZone:
  Zn = 0
  ZP = ZoneT[Lv]
  Zc = peek(ZP)
iz_next:
  if Zc = 0 then return
  dec Zc
  Zv = peek(ZP + 1)
  if SX >= Zv then
    Zv = peek(ZP + 2)
    if SX <= Zv then
      Zv = peek(ZP + 3)
      if SY >= Zv then
        ZTop = Zv
        ZLb = peek(ZP + 4)
        Zv = peek(ZP + 5)
        if SY <= Zv then
          ZBot = Zv
          Zn = 1
          return
        end if
      end if
    end if
  end if
  ZP += 5
  goto iz_next
end sub

' CLIMB: 1 px up or down; up stops at the zone's top, down (past the
' ladder's end) stops on the ground; past the zone's bottom Santa falls;
' the button jumps from the ladder as from the ground
sub AtClimb:
  K = Vd & 1
  if K > 0 then
    if SY > ZTop then dec SY
  else
    if SY >= ZLb then
      Gx = SX
      Ground
      if Gv = 0 then inc SY
    else
      inc SY
    end if
  end if
  K = SY & 3
  if K = 0 then AnimToggle
  Check4898
  if Ev <> 0 then return
  if SY > ZBot then
    Dir = 0
    FallD = 31
    FallStart
    return
  end if
  if Fire1 > 0 then
    DFr = 0
    PhN = 37
    play sound SndJump
    Ph = PhJump
  else
    Ph = PhMain
  end if
  return
end sub

sub AnimToggle:
  AIdx = AIdx ^ 1
  DFr = AIdx
  return
end sub

' $4527: the button jumps (the way the stick was held)
sub FireCheck:
  if Fire1 > 0 then
    DFr = 0
    PhN = 37
    play sound SndJump
    Ph = PhJump
  else
    Ph = PhMain
    ' standing still: nothing more happens before the next frame (on a
    ' conveyor the passes go on: it carries Santa ~1.5 px a frame)
    if WasPush = 0 then Budget = 0
  end if
  return
end sub

' $4619 going up: 37 steps of 1 px, sideways 1 px a step
sub AtJump:
  dec SY
  inc FallD
  Side1
  Check4898
  if Ev <> 0 then return
  dec PhN
  if PhN > 0 then return
  ' $457C: then 7 px sideways with no checks
  PhN = 0
  if Dir = 2 then
    if SX >= $28 then PhN = 7
  end if
  if Dir = 1 then
    if SX < $F2 then PhN = 7
  end if
  if PhN > 0 then
    Ph = PhGlide
  else
    FallD = 0
    FallStart
  end if
  return
end sub

sub AtGlide:
  if Dir = 2 then
    dec SX
  else
    inc SX
  end if
  dec PhN
  if PhN = 0 then
    FallD = 0
    FallStart
  end if
  return
end sub

sub FallStart:
  FallH = 6
  Ph = PhFallO
  return
end sub

' $45C9: the falling loop's outer check, then 8 steps down
sub AtFallO:
  Check4898
  if Ev <> 0 then return
  PhN = 8
  Ph = PhFallI
  return
end sub

sub AtFallI:
  inc SY
  inc FallD
  if Dir > 0 then
    dec FallH
    if FallH = 0 then
      FallH = 6
      Side1
    end if
  end if
  Check4898
  if Ev <> 0 then return
  Gx = SX
  Ground
  T = Gv
  if T = 0 then
    Si = Face << 1
    Si += DFr
    HObj = 7
    HOx = CvX
    HOy = CvY
    HitObj
    T = Ho
  end if
  if T = 1 then
    ' $4601: landed; too far down kills
    if FallD >= $4A then
      StartDeath
    else
      Ph = PhMain
    end if
    return
  end if
  dec PhN
  if PhN = 0 then Ph = PhFallO
  return
end sub

' 1 px sideways inside the original's limits
sub Side1:
  if Dir = 2 then
    if SX >= $28 then dec SX
  end if
  if Dir = 1 then
    if SX < $F9 then inc SX
  end if
  return
end sub

' $4898: robot, tree (death); present (taken) or sleigh (end of the screen)
sub Check4898:
  Ev = 0
  Si = Face << 1
  Si += DFr
  K = RMir << 1
  K += RFr
  HObj = K
  HOx = RX
  HOy = RY
  HitObj
  if Ho = 0 then
    HObj = 4
    HOx = TrX
    HOy = TrY
    HitObj
  end if
  if Ho = 1 then
    StartDeath
    Ev = 1
    return
  end if
  if Taken = 0 then
    HObj = 5
  HOx = PrX
  HOy = PrY
  HitObj
    if Ho = 1 then TakePresent
  else
    HObj = 6
  HOx = ExX
  HOy = ExY
  HitObj
    if Ho = 1 then
      StartBonus
      Ev = 2
    end if
  end if
  return
end sub

' Santa (shape Si) against object Ho at Hx,Hy: the hit table holds, per
' vertical offset, two ranges of horizontal offsets that touch (pixel exact
' from the C64 sprites, art.py)
sub HitObj:
  Ho = 0
  W = HOy
  W += 20
  if W < SY then return
  W -= SY
  if W > 40 then return
  Hy = W
  W = HOx
  W += 64
  if W < SX then return
  W -= SX
  if W > 127 then return
  Hx = W
  ' row Hy of the table for (Santa picture Si, object HObj)
  T = Si << 3
  T += HObj
  P = HitBase[T]
  W = Hy
  W = W << 2
  P += W
  W = @HitTab
  P += W
  Hr = peek(P)
  if Hx >= Hr then
    Hr = peek(P + 1)
    if Hx <= Hr then Ho = 1
  end if
  Hr = peek(P + 2)
  if Hx >= Hr then
    Hr = peek(P + 3)
    if Hx <= Hr then Ho = 1
  end if
  return
end sub

' the C64's sprite-background collision of Santa's feet layer (sprite 1,
' $D01F bit 1) at Gx,SY: the feet runs against the screen's collision masks
sub Ground:
  Gv = 0
  Gk = Face << 1
  Gk += DFr
  Gk = FeetIdx[Gk]
  for Gr = 0 to 3
    Ga = FeetRuns[Gk]
    inc Gk
    Gb = FeetRuns[Gk]
    inc Gk
    Gc = FeetRuns[Gk]
    inc Gk
    if Ga <> 255 then
      W = SY
      W += Ga
      if W >= 50 then
        W -= 50
        if W < 192 then
          Gy = W
          Gl = Gy & 7
          Wa = Gy & 248
          Wa = Wa << 2
          ' the run covers CV x Gt..Gm: one or two cells, a bit mask in each
          Gt = Gx + Gb
          Gt -= 32
          Gm = Gx + Gc
          Gm -= 32
          GroundCell
          Gy = Gt >> 3
          Ga = Gm >> 3
          if Ga <> Gy then
            Gt = Ga << 3
            GroundCell
          end if
        else
          ' C64 row 24, the brick base under the screen (not drawn): solid
          if W < 200 then Gv = 1
        end if
      end if
    end if
  next
  return
end sub

' the cell holding CV x Gt on name row Wa, run up to Gm, line Gl
sub GroundCell:
  if Gv = 1 then return
  Gy = Gt >> 3
  Off = Wa + Gy
  vpeek vram.name + MapOff + Off into Ga
  if Ga < LvBase then return
  Ga -= LvBase
  W = Ga
  W = W << 3
  W += Gl
  Q = CMaskP + W
  Ga = peek(Q)
  if Ga = 0 then return
  Gy = Gt & 7
  Gy = LeftM[Gy]
  Ga = Ga & Gy
  Gy = Gt | 7
  if Gm < Gy then
    Gy = Gm & 7
    Gy = RightM[Gy]
    Ga = Ga & Gy
  end if
  if Ga <> 0 then Gv = 1
  return
end sub

' $4FB7 every 11 frames: the cell under Santa's feet in a crumbling range
' turns $43 -> $44 -> nothing (and the next cell too), Santa sinks 1 px; a
' ledge that is gone drops him ($55AF)
sub Crumble:
  K = SX - 24
  K = K >> 3
  T = SY - 54
  T = T >> 3
  CrA = Row40[T]
  CrA += K
  CrA += 121
  CrP = CrumbT[Lv]
  Ri = peek(CrP)
  CrP += 1
cr_range:
  if Ri = 0 then return
  dec Ri
  Gc = peek(CrP + 1)
  CrLo = Hi256[Gc]
  Gc = peek(CrP)
  CrLo += Gc
  Gc = peek(CrP + 3)
  CrHi = Hi256[Gc]
  Gc = peek(CrP + 2)
  CrHi += Gc
  Gc = peek(CrP + 5)
  CrN = Hi256[Gc]
  Gc = peek(CrP + 4)
  CrN += Gc
  CrP += 6
  if CrA >= CrLo then
    if CrA < CrHi then
      Q = CrA - CrLo
      Q *= 5
      Q += CrP
      CrumbCell
    end if
  end if
  ' this range's cells lo..hi, 5 bytes each (length from pack.mjs)
  CrP += CrN
  goto cr_range
end sub

' Q: the cell's entry (CV offset, tiles for $43, $44, space); Q + 5 the next cell
sub CrumbCell:
  W = peek(Q + 1)
  W = W << 8
  Gc = peek(Q)
  W += Gc
  if W = 65535 then return
  vpeek vram.name + MapOff + W into Gt
  Gm = 0
  Ga = peek(Q + 2)
  Gb = peek(Q + 3)
  if Gt = Ga then Gm = 1
  if Gt = Gb then Gm = 2
  if Gm = 0 then return
  Gc = peek(Q + 2 + Gm)
  vpoke vram.name + MapOff + W, Gc
  EqW = W
  EqS = Gm
  Enq
  Wa = peek(Q + 6)
  Wa = Wa << 8
  Gc = peek(Q + 5)
  Wa += Gc
  if Wa <> 65535 then
    Gc = peek(Q + 7 + Gm)
    vpoke vram.name + MapOff + Wa, Gc
    EqW = Wa
    EqS = Gm
    Enq
  end if
  if Gm = 2 then CrFall = 1
  inc SY
  return
end sub

' a crumbled cell to redraw on the screen (FrameIrq, one a frame)
sub Enq:
  if RqN >= 16 then
    inc RqLost
    return
  end if
  Ek = RqT
  RqA[Ek] = lowbyte EqW
  RdQ = highbyte EqW
  RdB = EqS << 4
  RdQ += RdB
  RqB[Ek] = RdQ
  inc RqT
  RqT = RqT & 15
  inc RqN
  return
end sub

' one part (CV column) of the cell at the head of the queue a frame
sub RenderNext:
  Ek = RqH
  RdQ = RqB[Ek]
  RdS = RdQ >> 4
  RdQ = RdQ & 15
  RdW = Hi256[RdQ]
  RdT = RqA[Ek]
  RdW += RdT
  RenderCell
  if RdPart = 0 then
    if RdMore = 1 then
      RdPart = 1
      return
    end if
  end if
  RdPart = 0
  inc RqH
  RqH = RqH & 15
  dec RqN
  return
end sub

' the C64 cell at map offset RdW (row RdR, column RdK) is now $44 (RdS = 1)
' or gone (RdS = 2): its 7 lines on the screen (CV y = 8 + 7 RdR + 0..6) are
' redrawn in CV column part RdPart of the 1-2 it covers (KTab: column,
' part), keeping the other cell's bits (OwnM) and an object's (the tree,
' the sleigh: Obj). RdMore = 1 when the cell has a second part.
sub RenderCell:
  RdR = RdQ << 3
  RdB = RdT >> 5
  RdR += RdB
  RdK = RdT & 31
  inc RdK
  ' an object or multicolour entry for this cell?
  RdO = 0
  RdMC = 0
  RdP = ObjT[Lv]
  RdC = peek(RdP)
  RdP += 1
rc_obj:
  if RdC > 0 then
    dec RdC
    RdA = peek(RdP + 1)
    RdA = Hi256[RdA]
    RdB = peek(RdP)
    RdA += RdB
    if RdA = RdW then
      RdMC = peek(RdP + 2)
      RdO = RdP + 3
    else
      RdP += 17
      goto rc_obj
    end if
  end if
  RdB = RdK << 2
  RdB += 2
  RdMore = 0
  RdT = KTab[RdB]
  if RdT <> 255 then RdMore = 1
  RdB -= 2
  RdB += RdPart
  RdB += RdPart
  RdX = KTab[RdB]
  inc RdB
  RdG = KTab[RdB]
  if RdX = 255 then return
  if RdO <> 0 then
    if RdPart = 1 then RdO += 7
  end if
  RdC = OwnM[RdG]
  if RdMC = 1 then RdG += 4
  RdG = RdG << 3
  ' CV y of line 0, its tile and the pattern byte address
  RdY = RdR << 3
  RdY -= RdR
  RdY += 8
  RcAddr
  for RdJ = 0 to 6
    ' the bits this cell owns in this line, minus the object's
    RdQ = RdC
    if RdO <> 0 then
      RdP = RdO + RdJ
      RdB = peek(RdP)
      RdB = RdB ^ 255
      RdQ = RdQ & RdB
    end if
    vpeek vram.pattern + RdA into RdB
    RdT = RdQ ^ 255
    RdB = RdB & RdT
    if RdS = 1 then
      RdT = RdG + RdJ
      RdT = G44[RdT]
      RdT = RdT & RdQ
      RdB = RdB | RdT
    end if
    vpoke vram.pattern + RdA, RdB
    inc RdY
    RdB = RdY & 7
    if RdB = 0 then
      RcAddr
    else
      inc RdA
    end if
  next
  return
end sub

' RdA = the pattern byte of CV line RdY in column RdX (by its tile's code)
sub RcAddr:
  RdB = RdY >> 3
  RdA = Row32[RdB]
  RdA += RdX
  vpeek vram.name + RdA into RdT
  RdB = RdB >> 3
  RdA = Third[RdB]
  RdP = RdT
  RdP = RdP << 3
  RdA += RdP
  RdB = RdY & 7
  RdA += RdB
  return
end sub

' $49C4: the present is taken, the sleigh appears
sub TakePresent:
  Taken = 1
  VisPend = 1
  play sound SndGift
  P = PatchBT[Lv]
  Ri = peek(P)
  P += 1
tp_cell:
  if Ri = 0 then return
  dec Ri
  W = peek(P + 1)
  W = W << 8
  Gc = peek(P)
  W += Gc
  T = peek(P + 2)
  vpoke vram.name + MapOff + W, T
  P += 3
  goto tp_cell
end sub

' the screen's side of TakePresent (a frame later, FrameIrq): the sleigh's
' cells, and its pictures inside crumbling tiles
sub VisPresent:
  P = VPatchBT[Lv]
  Ri = peek(P)
  P += 1
vp_cell:
  if Ri > 0 then
    dec Ri
    W = peek(P + 1)
    W = Hi256[W]
    Gc = peek(P)
    W += Gc
    T = peek(P + 2)
    vpoke vram.name + W, T
    P += 3
    goto vp_cell
  end if
  P = VPatchBPT[Lv]
  Ri = peek(P)
  P += 1
vp_pat:
  if Ri = 0 then return
  dec Ri
  W = peek(P + 1)
  W = W << 8
  Gc = peek(P)
  W += Gc
  P += 2
  for Gr = 0 to 7
    T = peek(P)
    vpoke vram.pattern + W, T
    Q = P + 8
    T = peek(Q)
    vpoke vram.color + W, T
    inc W
    inc P
  next
  P += 8
  goto vp_pat
end sub

' the conveyor's two pictures: in the hidden map (as before) and on the screen
sub DrawConv:
  P = ConvT[Lv]
  Ri = peek(P)
  P += 1
dc_cell:
  if Ri = 0 then
    P = VConvT[Lv]
    Ri = peek(P)
    P += 1
    goto dc_vis
  end if
  dec Ri
  W = peek(P + 1)
  W = W << 8
  Gc = peek(P)
  W += Gc
  T = peek(P + 2 + ConvF)
  vpoke vram.name + MapOff + W, T
  P += 4
  goto dc_cell
dc_vis:
  if Ri = 0 then return
  dec Ri
  W = peek(P + 1)
  W = Hi256[W]
  Gc = peek(P)
  W += Gc
  T = peek(P + 2 + ConvF)
  vpoke vram.name + W, T
  P += 4
  goto dc_vis
end sub

sub StartDeath:
  Ph = PhDeath
  State = StDie
  DeathT = 0
  play sound SndDie
  return
end sub

' $4887: Santa tumbles (the original flips him 15 times in ~1.3 s; here 4
' slower turns, nothing faster than 3 Hz), then a life is lost
sub DeathFrame:
  inc DeathT
  T = DeathT / 20
  Rot = T & 1
  if DeathT < 80 then return
  Rot = 0
  if Lives > 1 then
    dec Lives
    StartScreen
  else
    GameEnd = 1
  end if
  return
end sub

' $4931: the time left counts down into the score, 10 points a step
sub StartBonus:
  if TimerSt = 2 then
    NextScreen
    return
  end if
  TimerSt = 1
  State = StBonus
  Ph = PhBonus
  return
end sub

sub AtBonus:
  BarStep
  Score += 10
  play sound SndTick
  ShowScore
  if TimerSt = 2 then NextScreen
  return
end sub

sub NextScreen:
  State = StNext
  inc Lv
  if Lv = 5 then
    Lv = 0
    if Diff < 4 then inc Diff
    inc Lives
  end if
  StartScreen
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawFrame:
  if State = StNext then return
  ' Santa (16 x 18, scaled as the screen): white and red layers, top and
  ' bottom; the position tables put him where the scaled screen shows him
  K = Rot << 2
  T = Face << 1
  K += T
  K += DFr
  K = K << 4
  V = SprXT[SX]
  T = SprYT[SY]
  set sprite 0 to T,V,K,15
  C = K + 4
  set sprite 1 to T,V,C,6
  T += 16
  if T = 208 then T = 207
  C = K + 8
  set sprite 2 to T,V,C,15
  C = K + 12
  set sprite 3 to T,V,C,6
  ' the robot: top and bottom
  K = RMir << 1
  K += RFr
  K = K << 3
  K += SRob00t
  V = SprXT[RX]
  T = SprYT[RY]
  set sprite 4 to T,V,K,7
  T += 16
  if T = 208 then T = 207
  C = K + 4
  set sprite 5 to T,V,C,7
  update sprites
  return
end sub

sub ShowScore:
  NumU = Score
  print at 25,3, digits$(NumU, 5)
  return
end sub

' the side panel (its labels are in the screen's name table): score, HI,
' the lives as small Santas (up to 6 shown), LV n, SCR n, the time bar
sub ShowHud:
  ShowScore
  NumU = Hi
  print at 25,7, digits$(NumU, 5)
  for Li = 0 to 5
    K = 32
    if Li < Lives then K = TLife
    T = Li + 24
    put char K at T,11
  next
  K = Diff + 49
  put char K at 28,20
  K = Lv + 49
  put char K at 29,22
  ' the time bar as it stands (8 - BarRow cells used, BarSub steps in the next)
  for Li = 0 to 7
    K = 0
    if Li >= 3 then K = 8
    if Li >= 6 then K = 16
    K += TBarw0
    T = 8 - BarRow
    if Li < T then K = 32
    if Li = T then
      if BarSub >= 7 then
        K = 32
      else
        if BarSub = 6 then
          K = 32
        else
          K += BarSub
        end if
      end if
    end if
    T = Li + BarY
    put char K at BarX,T
    put char K at BarX1,T
  next
  return
end sub

' the screen: shared tiles, this screen's tiles and name table (ZX0), HUD
sub DrawLevel:
  NewScreen
  ' the C64 map for the rules (hidden: vram.name + 1024 = $1C00)
  decompress zx0 LvNameZT[Lv] to vram.name + MapOff
  ' the scaled cavern: its tiles (a stream per run of codes in a third)
  P = VRunT[Lv]
  Ri = peek(P)
  P += 1
dl_run:
  if Ri > 0 then
    dec Ri
    W = peek(P + 1)
    W = W << 8
    Gc = peek(P)
    W += Gc
    K = peek(P + 2)
    decompress zx0 VRunPT[K] to vram.pattern + W
    decompress zx0 VRunCT[K] to vram.color + W
    P += 3
    goto dl_run
  end if
  decompress zx0 VNameZT[Lv] to vram.name
  ' the panel's words in the original's yellow (letters A-Z, all thirds)
  fill $A1 count 208 to vram.color + 520
  fill $A1 count 208 to vram.color + 2568
  fill $A1 count 208 to vram.color + 4616
  DrawConv
  ShowHud
  DrawFrame
  ShowScreen
  return
end sub

' before each screen: where we are (kept from the 1:1 layout, whose HUD was
' in the overscan; the panel shows it all now)
sub ShowCard:
  NewScreen
  print at 9,6, "SANTA'S CAVERNS"
  print at 9,9, "SCREEN"
  K = Lv + 49
  put char K at 21,9
  print at 9,11, "LEVEL"
  K = Diff + 49
  put char K at 21,11
  print at 9,13, "SANTAS"
  NumU = Lives
  print at 20,13, digits$(NumU, 2)
  print at 9,15, "SCORE"
  NumU = Score
  print at 17,15, digits$(NumU, 5)
  if Ctl = 1 then print at 9,17, "CONTROLS: CLIMB"
  ShowScreen
  State = StCard
  for Li = 0 to 89
    Frame1
  next
  State = StNext
  return
end sub

sub GameOver:
  State = StOver
  if Score > Hi then Hi = Score
  ' $48E3: GAME OVER! on the screen, ~2 s
  print at 8,11, "GAME OVER!"
  ShowHud
  for Li = 0 to 119
    Frame1
  next
  HideSprites
  NewScreen
  print at 10,6, "GAME OVER!"
  print at 9,9, "SCORE"
  NumU = Score
  print at 17,9, digits$(NumU, 5)
  print at 9,11, "HI PT"
  NumU = Hi
  print at 17,11, digits$(NumU, 5)
  print at 8,15, "PRESS THE BUTTON"
  ShowScreen
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to 7
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TileColZ to vram.color + 3072
  decompress zx0 TileColZ to vram.color + 5120
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Bricks:
  for Li = 1 to 22
    put char TBrick at 0,Li
    put char TBrick at 1,Li
    put char TBrick at 30,Li
    put char TBrick at 31,Li
  next
  return
end sub

sub TitlePage:
  NewScreen
  Bricks
  fill TLedge count 18 at 7,3
  print at 8,5, "SANTA'S CAVERNS"
  print at 11,10, "START"
  print at 11,12, "HOW TO PLAY"
  print at 11,14, "CREDITS"
  ShowCtl
  fill TLedge count 24 at 4,21
  ' Santa, the present and the tree on the bottom ledge
  set sprite 0 to 140,48,SSr0wt,15
  set sprite 1 to 140,48,SSr0rt,6
  set sprite 2 to 156,48,SSr0wb,15
  set sprite 3 to 156,48,SSr0rb,6
  set sprite 4 to 145,180,SPrest,7
  set sprite 5 to 161,180,SPresb,7
  set sprite 6 to 148,204,STreet,3
  set sprite 7 to 164,204,STreeb,3
  update sprites
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  ' CONTROLS: the button or left/right switch ORIGINAL / CLIMB
  if Menu = 3 then
    K = Edge & 12
    if K > 0 then Press = 1
    if Press = 1 then
      Ctl = Ctl ^ 1
      play sound SndClick
      ShowCtl
      Press = 0
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

sub ShowMenu:
  put char 32 at 9,10
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 10
  put char 62 at 9,C
  return
end sub

sub ShowCtl:
  if Ctl = 0 then
    print at 11,16, "CONTROLS: ORIGINAL"
  else
    print at 11,16, "CONTROLS: CLIMB   "
  end if
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  print at 8,2, "SANTA'S CAVERNS"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,22, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: three pages with the game's own sprites
sub HowTo:
  Page = 1
  NewScreen
  print at 7,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  set sprite 0 to 150,40,SSr1wt,15
  set sprite 1 to 150,40,SSr1rt,6
  set sprite 2 to 166,40,SSr1wb,15
  set sprite 3 to 166,40,SSr1rb,6
  set sprite 4 to 155,112,SPrest,7
  set sprite 5 to 171,112,SPresb,7
  set sprite 6 to 154,176,SSleight,8
  set sprite 7 to 154,192,SSleighrt,8
  update sprites
  fill TLedge count 24 at 4,22
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 7,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    set sprite 0 to 150,64,SRob00t,7
    set sprite 1 to 166,64,SRob00b,7
    set sprite 4 to 154,168,STreet,3
    set sprite 5 to 170,168,STreeb,3
    update sprites
    fill TLedge count 24 at 4,22
    State = StHow
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 7,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    for Li = 0 to 7
      K = 0
      if Li >= 3 then K = 8
      if Li >= 6 then K = 16
      K += TBarw0
      T = Li + 12
      put char K at T,21
    next
    State = StHow
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

