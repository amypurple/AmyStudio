cartridge "SWISH/MARK JORDAN/1986"
' SWISH - a game of HORSE for two players, ported from the Commodore 64
' original published on ReRUN May/June 1986 (BASIC + machine language; the
' article in RUN credits Mark Jordan).
'
' The rules are the original's, taken from its BASIC lines and from the
' disassembly of its machine code (orig/ml.dis):
' - the "IRQ" part runs once a frame (C64 jiffy = one frame here): the shot
'   clock, the dribble, and three 1-pixel steps per player per frame
'   ($C046-$C140);
' - the shot (SYS 49152, $C157) and the fetch (SYS 49155, $C2F2) are the
'   original's loop, one step per delay call ($C143, X*256 empty loops);
'   the port spends a C64 cycle budget per frame (14000 cycles free per
'   NTSC frame, 1287*D+60 per delay) so balls fly at the original's pace;
' - every position is kept in C64 sprite units and drawn through
'   x' = 8 + (x - 24) * 3 / 4, y' = y - 54 (the C64 court is 320 wide).
' Controls: controller 1 = player 1 (blue, the C64's port 2), controller 2
' = player 2 (purple, port 1). Menus answer either controller.

const TC0 = 128
const TC1 = 129
const TC2 = 130
const TC3 = 131
const TC4 = 132
const TC5 = 133
const TC6 = 134
const TC7 = 135
const TC8 = 136
const TC9 = 137
const TC10 = 138
const TC11 = 139
const TC12 = 140
const TC13 = 141
const TC14 = 142
const TC15 = 143
const TC16 = 144
const TC17 = 145
const TC18 = 146
const TC19 = 147
const TC20 = 148
const TC21 = 149
const TC22 = 150
const TC23 = 151
const TC24 = 152
const TC25 = 153
const TC26 = 154
const TC27 = 155
const TC28 = 156
const TC29 = 157
const TC30 = 158
const TC31 = 159
const TC32 = 160
const TC33 = 161
const TC34 = 162
const TC35 = 163
const TC36 = 164
const TC37 = 165
const TC38 = 166
const TC39 = 167
const TC40 = 168
const TC41 = 169
const TC42 = 170
const TC43 = 171
const TC44 = 172
const TC45 = 173
const TC46 = 174
const TC47 = 175
const TC48 = 176
const TC49 = 177
const TC50 = 178
const TC51 = 179
const TC52 = 180
const TC53 = 181
const TC54 = 182
const TC55 = 183
const TC56 = 184
const TC57 = 185
const TC58 = 186
const TC59 = 187
const TC60 = 188
const TC61 = 189
const TC62 = 190
const TC63 = 191
const TC64 = 192
const TC65 = 193
const TC66 = 194
const TC67 = 195
const TC68 = 196
const TBand = 197
const TDot = 198
const SStand = 0
const SShoot = 4
const SBall = 8
const SBig = 12
const SNet = 16
const NTiles8 = 568
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndBounce = 6
const SndShot = 7
const SndSwish = 8
const SndBuzz = 9
const SndJingle = 10
const TuneFrames = 1024
const TxtHelp1 = 0
const TxtHelp2 = 1
const TxtHelp3 = 2
const TxtCredits = 3
const NSpr = 4
const HideY = 192
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9
' turn phases (the BASIC lines they stand for)
const TpWait = 1
const TpRel = 2
const TpPress = 3
const TpShot = 4
const TpPause = 5
const TpPick = 6
' C64 limits ($C0E6 .. $C123)
const PyMin = 112
const PyMax = 220
const PxMin = 24
const PxMax = 240
' free C64 cycles per frame for the BASIC/ML side, and one delay call
const FrameCyc = 14000

' players: C64 sprite coordinates (index 0 = player 1 = sprite 0)
u8 Px[2]
u8 Py[2]
u8 Pose[2]
u8 Lt[2]
' the ball and the machine-code state ($02A9..$02C4, $FD, $FE)
u8 Bx = 0
u8 By = 0
u8 Fe = 0
u8 Bd = 0
u8 Bdir = 0
u8 ClockOn = 0
u8 Cnt60 = 60
u8 Digit = 7
u8 ShownDigit = 255
u8 Ys = 1
u8 Xs = 1
u8 Dl = 8
u8 Yc = 0
u8 Xc = 0
u8 YEx = 0
u8 SkipX = 0
u8 Nd = 0
u8 PassStart = 0
u8 ArcOn = 0
u8 ArcHalf = 0
u8 ArcRound = 0
u8 ArcN = 0
u8 ArcXc = 0
u8 ArcNeedY = 0
u8 Up = 1
u8 Xinc = 1
u8 Falling = 0
u8 Rnd = 0
u8 Bf = 0
u8 Landed = 0
u8 Board = 0
u8 SndOff = 0
u8 Made = 0
u8 StartY = 0
u8 Big = 0
u8 MPhase = 0
u8 ShotOver = 0
u8 Picked = 0
u8 Guard = 0
i16 Budget = 0
i16 Cost = 0
' the BASIC side: XX shooter, L matching, O1/O2 last spot, options
u8 Xx = 0
u8 Lm = 0
u8 XY = 0
u8 YX = 0
u8 O1 = 0
u8 O2 = 0
u8 Tp = 0
u8 PauseLeft = 0
u8 PauseNext = 0
u8 Lv = 5
u8 Bs = 5
u8 BankOpt = 0
u8 MinX = 247
u8 Loser = 0
u8 Shots = 0
' mapping scratch
u16 Wm = 0
u8 Sx = 0
u8 Sy = 0
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input: J1/J2 per controller (1 up, 2 down, 4 left, 8 right, 16 fire)
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 Jq = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Oi = 0
u8 Li = 0
u8 Mi = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u16 Ua = 0
u16 Ub = 0
u16 Uc = 0
u16 Ud = 0
u16 Ra = 0
u16 Rb = 0
u16 Rc = 0
u16 Rd = 0
u8 Hit = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 4 then
    HowTo
    goto title
  end if
  if Menu = 5 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Loser = 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' RUN: lines 40-65 and 260 (sprite places), 105-110 (options)
sub NewGame:
  Px[0] = 35
  Py[0] = 174
  Px[1] = 50
  Py[1] = 155
  Pose[0] = 0
  Pose[1] = 0
  Lt[0] = 0
  Lt[1] = 0
  Bx = 65
  By = 179
  Fe = 0
  Bd = 0
  Bdir = 0
  Big = 0
  Made = 0
  Lm = 0
  XY = 0
  YX = 0
  Loser = 0
  Shots = 0
  MinX = 242 + Lv
  Dl = Bs + 3
  Ys = 1
  Xs = 1
  MPhase = 0
  ArcOn = 0
  ClockOn = 0
  Cnt60 = 60
  Xx = 1
  DrawPlay
  State = StPlay
  play sound SndJingle
  ' line 260: X = 1, then 265-270: the clock shows 7, X = -X (player 1)
  NewTurn
  return
end sub

' lines 265-275: the clock back to 7, the other player's turn
sub NewTurn:
  Digit = 7
  NextTurn
  return
end sub

' line 270-275 (also reached straight from the fetch, clock not reset)
sub NextTurn:
  Xx = 1 - Xx
  ClockOn = 1
  Bd = 0
  Tp = TpWait
  return
end sub

' one frame: the interrupt part, then the BASIC/ML part
sub PlayStep:
  Irq
  if Tp = TpWait then
    ' 280-285: too late, or the first press
    if Digit = 0 then
      ClockOn = 0
      Say(3)
      if Made = 1 then inc Lm
      GiveAway
      BuzzPause(0)
    else
      FirePad(Fe)
      if K > 0 then Press320
    end if
  elseif Tp = TpRel then
    FirePad(Fe)
    if K = 0 then Tp = TpPress
  elseif Tp = TpPress then
    FirePad(Fe)
    if K > 0 then StartShot
  elseif Tp = TpShot then
    ShotRun
    if ShotOver = 1 then AfterShot
  elseif Tp = TpPause then
    dec PauseLeft
    if PauseLeft = 0 then AfterPause
  elseif Tp = TpPick then
    ShotRun
    if Picked = 1 then NextTurn
  end if
  DrawSprites
  if Digit <> ShownDigit then ShowClock
  return
end sub

' K = the fire button of player P (BASIC line 480 reads port PEEK(254))
sub FirePad(u8 P):
  K = J1
  if P = 1 then K = J2
  K = K & 16
  return
end sub

' lines 320-350: the feet are set
sub Press320:
  ClockOn = 0
  Bd = 1
  Fe = Xx
  O1 = XY
  O2 = YX
  XY = Px[Xx]
  YX = Py[Xx]
  if Made = 1 then
    inc Lm
    if Lm > 1 then
      Lm = 0
    else
      if Digit = 0 then
        ' 340
        Say(3)
        inc Lm
        GiveAway
        BuzzPause(0)
        return
      end if
      ' 345: more than 16 pixels from the shot to match
      T = 0
      if XY > O1 then
        V = XY - O1
      else
        V = O1 - XY
      end if
      if V > 16 then T = 1
      if YX > O2 then
        V = YX - O2
      else
        V = O2 - YX
      end if
      if V > 16 then T = 1
      if T = 1 then
        Say(4)
        GiveAway
        BuzzPause(0)
        return
      end if
    end if
  end if
  ' 350-355: the shooting pose, the ball in the hands
  Pose[Xx] = 1
  Bx = Px[Xx] + 3
  By = Py[Xx] - 4
  Tp = TpRel
  return
end sub

' lines 365-390 and 295: the second press throws; the stick picks the arc
' (only on a free shot: a matching shot keeps the last one's arc)
sub StartShot:
  if Lm <> 1 then
    Ys = 1
    Xs = 1
    Dl = Bs + 3
    K = J1
    if Fe = 1 then K = J2
    K = K & 15
    if K = 1 then
      Ys = 2
    elseif K = 2 then
      Xs = 2
      Dl = Bs + 1
    end if
  end if
  Pose[Xx] = 0
  Digit = 7
  inc Shots
  ' SYS 49152 ($C157)
  Falling = 0
  Rnd = 0
  Bf = 0
  Landed = 0
  Board = 0
  SndOff = 0
  Made = 0
  Up = 1
  Xinc = 1
  Bd = 1
  ArcOn = 0
  PassStart = 1
  ShotOver = 0
  Picked = 0
  MPhase = 1
  Cost = Dl * 1287
  Cost += 60
  Budget = 0
  play sound SndShot
  Tp = TpShot
  return
end sub

' lines 300-315 after the ball first lands
sub AfterShot:
  if Made = 0 then
    Say(1)
    Letter
  elseif BankOpt = 1 and Lm = 1 and Board = 0 then
    Say(5)
    Made = 0
    BuzzPause(1)
    return
  else
    Say(0)
  end if
  StartFetch
  return
end sub

' 315: SYS 49155 - the ball rolls until the other player touches it
sub StartFetch:
  if Loser > 0 then return
  MPhase = 2
  PassStart = 0
  Picked = 0
  Budget = 0
  Yc = Ys
  Xc = Xs
  Tp = TpPick
  return
end sub

' 425: the ball goes to the other player
sub GiveAway:
  Fe = 1 - Xx
  By = Py[Fe] + 7
  return
end sub

' 430: the buzzer and the FOR T=1 TO 1000 wait (about 66 frames), then
' 435; N = 0: then 265 (new turn), N = 1: then the fetch (NOBANK)
sub BuzzPause(u8 N):
  Made = 0
  play sound SndBuzz
  PauseLeft = 66
  PauseNext = N
  Tp = TpPause
  return
end sub

sub AfterPause:
  Letter
  if Loser > 0 then return
  if PauseNext = 1 then
    StartFetch
  else
    NewTurn
  end if
  return
end sub

' 435-450: a missed match earns the shooter a letter; five is HORSE
sub Letter:
  if Lm = 0 then return
  Lt[Xx] += 1
  ShowLetters
  if Lt[Xx] >= 5 then
    Loser = Xx + 1
  end if
  Lm = 0
  return
end sub

' --- the interrupt ($C046): clock, dribble, three moves per player
sub Irq:
  if ClockOn = 1 then
    dec Cnt60
    if Cnt60 = 0 then
      if Digit > 0 then dec Digit
      if Digit < 1 then ClockOn = 0
      Cnt60 = 60
    end if
  else
    Cnt60 = 60
  end if
  if Bd = 0 then
    if Bdir = 0 then
      dec By
    else
      inc By
    end if
    Bx = Px[Fe] + 10
    T = By - Py[Fe]
    if T < 1 then
      inc By
      Bdir = 1
      play sound SndBounce
    elseif T >= 10 then
      dec By
      Bdir = 0
      play sound SndBounce
    end if
  end if
  for Mi = 1 to 3
    MoveOne(1)
    MoveOne(0)
  next
  return
end sub

sub MoveOne(u8 P):
  if Bd = 1 and P = Fe then return
  K = J1
  if P = 1 then K = J2
  V = K & 1
  if V > 0 then
    if Py[P] <> PyMin then
      Py[P] -= 1
      if P = Fe then dec By
    end if
  end if
  V = K & 2
  if V > 0 then
    if Py[P] <> PyMax then
      Py[P] += 1
      if P = Fe then inc By
    end if
  end if
  V = K & 4
  if V > 0 then
    if Px[P] <> PxMin then Px[P] -= 1
  end if
  V = K & 8
  if V > 0 then
    if Px[P] < PxMax then Px[P] += 1
  end if
  return
end sub

' --- the shot / fetch loop, one delay call at a time
sub ShotRun:
  Budget += FrameCyc
  Guard = 0
sr_loop:
  if Budget <= 0 then return
  if MPhase = 0 then return
  ShotIter
  if Nd > 0 then Budget -= Cost
  if Nd > 1 then Budget -= Cost
  inc Guard
  if Guard > 40 then return
  goto sr_loop
end sub

sub ShotIter:
  Nd = 0
  if ArcOn = 1 then
    ArcIter
    return
  end if
  if PassStart = 1 then
    ' $C178
    if Landed = 1 then
      if MPhase = 1 then
        ' $C2D0: back to BASIC, the clock runs again
        ClockOn = 1
        MPhase = 0
        ShotOver = 1
        return
      end if
      Touch
      if Hit = 1 then
        ' $C2FA: the other player has the ball
        Bd = 0
        Fe = 1 - Fe
        By = Py[Fe] + 5
        MPhase = 0
        Picked = 1
        return
      end if
    end if
    Yc = Ys
    Xc = Xs
    PassStart = 0
  end if
  SkipX = 0
  if Yc > 0 then
    dec Yc
    YEx = 0
    YPart
  else
    YEx = 1
  end if
  if SkipX = 1 then return
  if Xc > 0 then
    dec Xc
    XPart
  else
    if YEx = 1 then
      EndPass
    else
      Nd = 1
    end if
  end if
  return
end sub

' $C18C-$C24D
sub YPart:
  if By = 0 then
    if Falling = 1 then
      Up = 0
      MoveY
      return
    end if
    if Bx = 255 then
      OutBehind
      SkipX = 1
    end if
    return
  end if
  if Rnd > 0 then
    dec Rnd
    if Rnd = 0 then Up = 0
    MoveY
    return
  end if
  if Falling = 0 then
    MoveY
    return
  end if
  if By >= 180 then
    ' $C21C: on the floor
    Big = 0
    Landed = 1
    StopTone
    play sound SndBounce
    Up = 1
    MoveY
    return
  end if
  if By = 150 then
    Up = 0
    MoveY
    return
  end if
  if By <> 97 or Bf = 1 then
    MoveY
    return
  end if
  ' rim height
  if Bx < 236 then
    if Board = 0 then Big = 1
    MoveY
    return
  end if
  if Bx < 254 and Bx >= MinX then
    ' $C20D: SWISH
    Made = 1
    Bx = 252
    StopTone
    play sound SndSwish
    MoveY
    return
  end if
  ' $C1EA: off the rim, up a random 1-16 (1-32 from a high release) steps
  T = 15
  if StartY < 65 then T = 31
  Rand
  V = Rs
  V = V & T
  Rnd = V + 1
  play sound SndBounce
  Up = 1
  MoveY
  return
end sub

sub MoveY:
  if Up = 1 then
    dec By
  else
    inc By
  end if
  return
end sub

sub StopTone:
  if SndOff = 0 then
    stop sound SndShot
  end if
  SndOff = 1
  return
end sub

' $C259-$C2BA
sub XPart:
  Nd = 1
  if Board = 1 then
    V = By & 3
    if V = 0 then return
  end if
  if Made = 1 then return
  if Bf = 1 and Landed = 0 then
    Nd = 2
    return
  end if
  if Bx < 26 then
    Xinc = 1
  elseif Bx = 255 then
    if Landed = 1 then
      Xinc = 0
    elseif By >= 60 and By < 110 then
      ' off the backboard
      play sound SndBounce
      Board = 1
      Xinc = 0
    else
      OutBehind
      return
    end if
  end if
  if Xinc = 1 then
    inc Bx
  else
    dec Bx
  end if
  return
end sub

' $C2A9: past the board - the ball drops behind it
sub OutBehind:
  Up = 0
  Big = 1
  Bf = 1
  Falling = 1
  Nd = 2
  return
end sub

' $C2C0: end of a pass; still rising: has the shooter let go?
sub EndPass:
  PassStart = 1
  if Falling = 1 then return
  FirePad(Fe)
  if K > 0 then return
  ' $C317: released
  StartY = By
  Falling = 1
  if Board = 1 then
    Up = 0
    MoveY
    return
  end if
  ArcOn = 1
  ArcN = 1
  ArcRound = 4
  ArcHalf = 0
  ArcNeedY = 1
  return
end sub

' $C337-$C380: the top of the arc, 1+2+3+4 then 5+4+3+2 steps across
sub ArcIter:
  if ArcNeedY = 1 then
    if By = 0 then
      inc By
    elseif ArcHalf = 0 then
      dec By
    else
      inc By
    end if
    ArcXc = ArcN
    ArcNeedY = 0
  end if
  if Bx = 255 then
    Up = 0
    ArcOn = 0
    PassStart = 1
    return
  end if
  inc Bx
  Nd = 1
  dec ArcXc
  if ArcXc = 0 then
    if ArcHalf = 0 then
      inc ArcN
    else
      dec ArcN
    end if
    dec ArcRound
    ArcNeedY = 1
    if ArcRound = 0 then
      if ArcHalf = 0 then
        ArcHalf = 1
        Up = 0
        ArcRound = 4
      else
        ArcOn = 0
        PassStart = 1
      end if
    end if
  end if
  return
end sub

' the ball (pixels x+6..x+18, y+1..y+10) touches the other player's shoe
' (heel x..x+7 y..y+20, sole x..x+23 y+13..y+20, top x+1..x+23 y..y+2)
sub Touch:
  Hit = 0
  K = 1 - Fe
  Ua = Bx + 6
  Ub = Bx + 18
  Uc = By + 1
  Ud = By + 10
  Ra = Px[K]
  Rc = Py[K]
  Rb = Ra + 7
  Rd = Rc + 20
  Box1
  Rb = Ra + 23
  Rc = Py[K] + 13
  Box1
  Ra = Px[K] + 1
  Rc = Py[K]
  Rd = Rc + 2
  Box1
  return
end sub

sub Box1:
  if Ua <= Rb and Ub >= Ra and Uc <= Rd and Ud >= Rc then Hit = 1
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' C64 x -> screen x (Sx), C64 y -> screen y - 1 for `set sprite` (Sy)
sub MapXY(u8 X, u8 Y, u8 Dy):
  Wm = X
  if Wm < 24 then Wm = 24
  Wm -= 24
  Wm = Wm * 3
  Wm = Wm >> 2
  Sx = Wm + 8
  Sy = Y - Dy
  return
end sub

sub DrawSprites:
  set sprite 0 to 47,181,SNet,9
  for Li = 0 to 1
    MapXY(Px[Li], Py[Li], 53)
    C = Li + 1
    T = SStand
    if Pose[Li] = 1 then T = SShoot
    V = 4
    if Li = 1 then V = 13
    set sprite C to Sy,Sx,T,V
  next
  if By < 24 then
    set sprite 3 to HideY,0,SBall,0
  else
    if Big = 1 then
      MapXY(Bx, By, 53)
      set sprite 3 to Sy,Sx,SBig,1
    else
      MapXY(Bx, By, 55)
      set sprite 3 to Sy,Sx,SBall,10
    end if
  end if
  update sprites
  return
end sub

sub ShowClock:
  ShownDigit = Digit
  print at 3,6, "SHOTCLOCK:"
  put char 48 + Digit at 14,6
  return
end sub

' the BASIC's messages (row 8): 0 GOOD, 1 MISSED, 3 TOO LATE, 4 TOO FAR,
' 5 NOBANK
sub Say(u8 N):
  if N = 0 then
    print at 3,8, "  GOOD  "
  elseif N = 1 then
    print at 3,8, " MISSED "
  elseif N = 3 then
    print at 3,8, "TOO LATE"
  elseif N = 4 then
    print at 3,8, "TOO FAR "
  else
    print at 3,8, " NOBANK "
  end if
  return
end sub

sub ShowLetters:
  for Li = 0 to 1
    C = 3
    if Li = 1 then C = 13
    for Oi = 1 to 5
      T = 46
      if Oi <= Lt[Li] then
        if Oi = 1 then T = 72
        if Oi = 2 then T = 79
        if Oi = 3 then T = 82
        if Oi = 4 then T = 83
        if Oi = 5 then T = 69
      end if
      put char T at C,4
      C += 2
    next
  next
  return
end sub

sub DrawCourt:
  decompress zx0 CourtMapZ to vram.name
  return
end sub

sub DrawPlay:
  NewScreen
  DrawCourt
  print at 3,2, "PLAYER 1"
  print at 13,2, "PLAYER 2"
  ShowLetters
  ShownDigit = 255
  ShowScreen
  DrawSprites
  return
end sub

sub GameOver:
  ClockOn = 0
  stop sound SndShot
  play sound SndJingle
  for Li = 7 to 22
    fill 32 count 21 at 1,Li
  next
  if Loser = 1 then
    print at 5,11, "PLAYER 1 IS"
    print at 5,13, "A HORSE"
    print at 5,16, "PLAYER 2 WINS"
  else
    print at 5,11, "PLAYER 2 IS"
    print at 5,13, "A HORSE"
    print at 5,16, "PLAYER 1 WINS"
  end if
  print at 5,19, "PRESS BUTTON"
  for Li = 1 to 3
    set sprite Li to HideY,0,0,0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker off
  for J = 0 to 3
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $13
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop light green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the court's board and HORSE column, the menu with the
' original's three questions (level, ball speed, bank shots)
sub TitlePage:
  NewScreen
  DrawCourt
  for Li = 6 to 22
    fill 32 count 22 at 0,Li
  next
  for Li = 10 to 16
    fill 32 count 27 at 0,Li
  next
  for Li = 17 to 23
    fill 32 count 32 at 0,Li
  next
  put char 32 at 12,3
  print at 8,2, "S W I S H"
  print at 4,4, "A GAME OF HORSE"
  Menu = 0
  ShowMenu
  ShowScreen
  set sprite 0 to 47,181,SNet,9
  set sprite 1 to 152,176,SStand,4
  set sprite 2 to 152,204,SShoot,13
  set sprite 3 to 46,180,SBall,10
  update sprites
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 5
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 5 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  K = Edge & 12
  if K > 0 then
    if Menu = 1 then
      if K = 4 then
        if Lv > 0 then dec Lv
      else
        if Lv < 9 then inc Lv
      end if
    end if
    if Menu = 2 then
      if K = 4 then
        if Bs > 0 then dec Bs
      else
        if Bs < 9 then inc Bs
      end if
    end if
    if Menu = 3 then BankOpt = 1 - BankOpt
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu >= 1 and Menu <= 3 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  print at 6,8, "START"
  print at 6,10, "LEVEL"
  put char 48 + Lv at 18,10
  print at 6,12, "BALL SPEED"
  put char 48 + Bs at 18,12
  print at 6,14, "BANKSHOTS"
  if BankOpt = 1 then
    print at 18,14, "Y"
  else
    print at 18,14, "N"
  end if
  print at 6,16, "HOW TO PLAY"
  print at 6,18, "CREDITS"
  for Li = 0 to 5
    C = Li << 1
    C += 8
    put char 32 at 4,C
  next
  C = Menu << 1
  C += 8
  put char 62 at 4,C
  ' the original's prompts, for the line under the cursor
  if Menu = 1 then
    print at 3,21, "LEFT/RIGHT: EASY 0-9 HARD"
  elseif Menu = 2 then
    print at 3,21, "LEFT/RIGHT: FAST 0-9 SLOW"
  elseif Menu = 3 then
    print at 3,21, "MATCH BANKSHOTS: Y OR N  "
  else
    print at 3,21, "                         "
  end if
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 13,2, "SWISH"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' a HOW TO PLAY page: title row 1, text rows 3-13, picture rows 15-19
sub HowPage(u8 N):
  NewScreen
  print at 8,1, "HOW TO PLAY  /3"
  put char 48 + N at 20,1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  return
end sub

sub HowTo:
  State = StHow
  Page = 1
  TxT = TxtHelp1
  HowPage(1)
  ' two shoes and the ball, as in the game
  set sprite 1 to 125,60,SStand,4
  set sprite 2 to 125,160,SStand,13
  set sprite 3 to 129,88,SBall,10
  update sprites
  PageWait
  if TimedOut = 0 then
    Page = 2
    TxT = TxtHelp2
    HowPage(2)
    ' the shooting pose under the net, the ball on its way up
    set sprite 0 to 119,170,SNet,9
    set sprite 1 to 135,80,SShoot,4
    set sprite 3 to 117,120,SBall,10
    update sprites
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    TxT = TxtHelp3
    HowPage(3)
    print at 8,17, "H O R S E"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

