cartridge "YOU'RE IT!/GERALD CODDINGTON/1985"
' YOU'RE IT! - a ColecoVision port of "You're It!" by Gerald Coddington,
' RUN Magazine (ReRUN Spring 1985, disk file TAG; also on the Game Pak),
' Commodore 64, Basic + a machine-language joystick driver.
'
' Tag for two players. Controller 1 moves the green man (the C64's port
' 1), controller 2 the red man (port 2). Whoever is "it" chases the other;
' run into him and he is it. While the other player is it, your free time
' grows. The first to two minutes of free time wins.
'
' Rules kept from the original (listing + jsc64 traces, see README.md):
' - positions in the C64's sprite units (X 0-255, Y 0-255, both wrap round,
'   as the ML driver only INCs/DECs the low bytes); 2 units per frame (the
'   driver runs in the 60 Hz IRQ and moves 2 pixels per call)
' - a move only when the stick reads exactly one direction (no diagonals,
'   a held button stops the man): the driver compares the whole port byte
' - the touch test is the VIC's pixel-exact sprite-sprite collision of the
'   two expanded men (table CollDx from the original sprite, art.py); the
'   collision latch is read twice per Basic pass (lines 240 and 280), and
'   only the read that matches who is it can tag: a tag costs the Basic loop
'   16-17 frames, then the other read may tag straight back if the men are
'   still touching (traced: flips every 16-17 frames while they overlap)
' - free time is the jiffy clock: TI$ = H$ on each tag, so the clock restarts
'   at the new free player's whole seconds; the first to 2:00 wins
' - green starts as "it" at the top left, red at the bottom right
' - the border (backdrop) shows the colour of whoever is it
'
' House rules: title menu START / HOW TO PLAY / CREDITS by joystick, one
' press to start, game over -> one press or 30 s -> title.

const TChkr = 128
const TChkg = 129
const TChky = 130
const TMang = 131
const TManr = 132
const TItig = 133
const TIttg = 134
const TItir = 135
const TIttr = 136
const TEdge = 137
const TEdgeb = 138
const TFloor = 139
const SMan = 0
const NTiles8 = 96
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndTagR = 6
const SndTagG = 7
const SndOver = 8
const SndGameA = 9
const SndGameB = 10
const SndGameC = 11
const SndGameD = 12
const TuneFrames = 448
const TxtCredits = 0
const TxtHow1 = 1
const TxtHow1b = 2
const TxtHow2 = 3
const TxtHow2b = 4
const TxtHow2c = 5
const TxtHow3 = 6
const GameFrames = 1152
const NSpr = 2
const HideY = 192
' colours: the C64's green (5) and red (2)
const ColG = 3
const ColR = 8
' 2:00 of free time wins
const WinSec = 120
' Basic pass timing (frames, from the jsc64 traces): reads of the collision
' latch alternate every 5 frames; after a tag the next read comes 16 (after
' line 240) or 17 (after line 280) frames later
const ReadGap = 5
const TagGapA = 16
const TagGapB = 17
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9

' the men: 1 = green (controller 1), 2 = red (controller 2)
u8 X1 = 0
u8 Y1 = 0
u8 X2 = 0
u8 Y2 = 0
u8 It = 1
u8 Latch = 0
u8 ChkWait = 0
u8 ChkB = 0
u8 Frac = 0
u8 Sec1 = 0
u8 Sec2 = 0
u8 Winner = 0
u8 GameOn = 0
u16 GzLeft = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 W16 = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' title animation
u8 AtPh = 0
u8 AtT = 0
u8 Ag = 0
u8 Ar = 0
' sprite placing (PlaceMan)
u8 Px = 0
u8 Py = 0
u8 Pc = 0
u8 Ps = 0
' loop counter
u8 Li = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  sprites double
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Winner = 0 then goto play_loop

  ' the final time stays on the HUD for a second
  StopGameTune
  play sound SndOver
  for Li = 1 to 60
    Frame1
  next
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub NewGame:
  X1 = 15
  Y1 = 47
  X2 = 255
  Y2 = 215
  It = 1
  Latch = 0
  ChkB = 0
  ChkWait = ReadGap
  Frac = 0
  Sec1 = 0
  Sec2 = 0
  Winner = 0
  DrawPlay
  State = StPlay
  StartGameTune
  GameOn = 1
  return
end sub

' controller value J (1 up, 2 down, 4 left, 8 right, 16 button): the C64
' driver moves only on an exact single direction, 2 units per frame
sub PlayStep:
  if J1 = 4 then X1 -= 2
  if J1 = 8 then X1 += 2
  if J1 = 1 then Y1 -= 2
  if J1 = 2 then Y1 += 2
  if J2 = 4 then X2 -= 2
  if J2 = 8 then X2 += 2
  if J2 = 1 then Y2 -= 2
  if J2 = 2 then Y2 += 2
  Touch
  ' the Basic loop reads the collision latch (V+30) at lines 240 and 280
  dec ChkWait
  if ChkWait = 0 then ReadLatch
  ' the jiffy clock: free time for whoever is not it
  inc Frac
  if Frac >= 60 then
    Frac = 0
    if It = 1 then
      inc Sec2
      if Sec2 >= WinSec then Winner = 2
    else
      inc Sec1
      if Sec1 >= WinSec then Winner = 1
    end if
    ShowTimes
  end if
  DrawMen
  GameTuneStep
  return
end sub

' pixel-exact touch of the two expanded men: |dx| <= CollDx[|dy| + 40]
sub Touch:
  if Y1 >= Y2 then
    T = Y1 - Y2
  else
    T = Y2 - Y1
  end if
  if T > 40 then return
  T += 40
  K = CollDx[T]
  if K = 255 then return
  if X1 >= X2 then
    V = X1 - X2
  else
    V = X2 - X1
  end if
  if V <= K then Latch = 1
  return
end sub

sub ReadLatch:
  V = Latch
  Latch = 0
  if ChkB = 0 then
    ' line 240: green is it and touching -> red is it
    ChkB = 1
    ChkWait = ReadGap
    if V = 1 then
      if It = 1 then
        It = 2
        Frac = 0
        ChkWait = TagGapA
        play sound SndTagR
        ShowIt
      end if
    end if
  else
    ' line 280: red is it and touching -> green is it
    ChkB = 0
    ChkWait = ReadGap
    if V = 1 then
      if It = 2 then
        It = 1
        Frac = 0
        ChkWait = TagGapB
        play sound SndTagG
        ShowIt
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a man at C64 position Px,Py in colour Pc, sprite Ps. Screen mapping:
' x = X - X/16 - 14 (early clock below 0), y = Y - Y/32 - 47; off the top
' or bottom of the screen the man is hidden (the hiding spots)
sub PlaceMan:
  T = Px >> 4
  T = Px - T
  C = Pc
  if T >= 14 then
    T -= 14
  else
    T += 18
    C = C | 128
  end if
  V = Py >> 5
  V = Py - V
  if V < 16 then
    set sprite Ps to HideY,0,SMan,0
    return
  end if
  if V >= 239 then
    set sprite Ps to HideY,0,SMan,0
    return
  end if
  V -= 47
  set sprite Ps to V,T,SMan,C
  return
end sub

sub DrawMen:
  Px = X1
  Py = Y1
  Pc = ColG
  Ps = 0
  PlaceMan
  Px = X2
  Py = Y2
  Pc = ColR
  Ps = 1
  PlaceMan
  update sprites
  return
end sub

' m:ss of NumU seconds at column C, row 1
sub PrintTime:
  T = NumU / 60
  V = NumU % 60
  NumU = T
  print at C,1, digits$(NumU, 1)
  K = C + 1
  print at K,1, ":"
  NumU = V
  K += 1
  print at K,1, digits$(NumU, 2)
  return
end sub

sub ShowTimes:
  NumU = Sec1
  C = 4
  PrintTime
  NumU = Sec2
  C = 26
  PrintTime
  return
end sub

' the IT badge beside whoever is it, and the border in his colour
sub ShowIt:
  if It = 1 then
    put char TItig at 9,1
    put char TIttg at 10,1
    put char 32 at 21,1
    put char 32 at 22,1
    backdrop ColG
  else
    put char 32 at 9,1
    put char 32 at 10,1
    put char TItir at 21,1
    put char TIttr at 22,1
    backdrop ColR
  end if
  return
end sub

sub DrawPlay:
  NewScreen
  put char TMang at 2,1
  put char TManr at 24,1
  print at 12,1, "FREE TIME"
  fill TEdge count 28 at 2,2
  for Li = 3 to 21
    fill TFloor count 28 at 2,Li
  next
  fill TEdgeb count 28 at 2,22
  ShowTimes
  ShowIt
  ShowScreen
  DrawMen
  return
end sub

sub GameOver:
  HideSprites
  NewScreen
  backdrop black
  print at 11,3, "GAME OVER"
  print at 11,6, "FREE TIME"
  put char TMang at 6,8
  print at 8,8, "PLAYER 1"
  put char TManr at 6,10
  print at 8,10, "PLAYER 2"
  NumU = Sec1
  C = 21
  PrintTimeAt8
  NumU = Sec2
  C = 21
  PrintTimeAt10
  ' the original: player 1 wins unless player 2's time is greater
  if Sec2 > Sec1 then
    print at 9,13, "PLAYER 2 WINS!"
    put char TManr at 7,13
  else
    print at 9,13, "PLAYER 1 WINS!"
    put char TMang at 7,13
  end if
  print at 8,16, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

sub PrintTimeAt8:
  T = NumU / 60
  V = NumU % 60
  NumU = T
  print at C,8, digits$(NumU, 1)
  K = C + 1
  print at K,8, ":"
  NumU = V
  K += 1
  print at K,8, digits$(NumU, 2)
  return
end sub

sub PrintTimeAt10:
  T = NumU / 60
  V = NumU % 60
  NumU = T
  print at C,10, digits$(NumU, 1)
  K = C + 1
  print at K,10, ":"
  NumU = V
  K += 1
  print at K,10, digits$(NumU, 2)
  return
end sub

' ---------------------------------------------------------------------------
' music: the in-game tune loops quietly under the tag sounds

sub StartGameTune:
  play sound SndGameA
  play sound SndGameB
  play sound SndGameC
  play sound SndGameD
  GzLeft = GameFrames
  return
end sub

sub GameTuneStep:
  dec GzLeft
  if GzLeft = 0 then StartGameTune
  return
end sub

sub StopGameTune:
  stop sound SndGameA
  stop sound SndGameB
  stop sound SndGameC
  stop sound SndGameD
  GameOn = 0
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' J1, J2 = each controller (1 up, 2 down, 4 left, 8 right, 16 a button);
' for the menus: Jk = directions of either, Edge = newly pressed, Press =
' a button newly pressed on either controller
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  for J = 0 to 1
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the original's big checkered TAG (title screen of the C64 version)
sub BigTag:
  ' T (red)
  fill TChkr count 5 at 7,4
  for Li = 5 to 8
    put char TChkr at 9,Li
  next
  ' A (green)
  fill TChkg count 3 at 14,4
  fill TChkg count 5 at 13,6
  for Li = 5 to 8
    put char TChkg at 13,Li
    put char TChkg at 17,Li
  next
  ' G (red)
  fill TChkr count 4 at 20,4
  fill TChkr count 3 at 20,8
  for Li = 5 to 7
    put char TChkr at 19,Li
  next
  put char 32 at 19,4
  put char TChkr at 19,5
  put char TChkr at 23,7
  put char TChkr at 22,6
  put char TChkr at 23,6
  return
end sub

' the title: name, big TAG, author, menu (cursor back on START), the tune
' once, and the original's little chase ("GOT YOU!")
sub TitlePage:
  NewScreen
  backdrop black
  print at 11,2, "YOU'RE IT!"
  BigTag
  print at 6,10, "BY GERALD CODDINGTON"
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  Menu = 0
  ShowMenu
  AtPh = 0
  AtT = 0
  Ag = 16
  Ar = 70
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  TitleAnim
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  HideSprites
  return
end sub

' green chases red to the right; GOT YOU!; red chases green back to the left
sub TitleAnim:
  inc AtT
  if AtPh = 0 then
    inc Ar
    inc Ag
    V = AtT & 1
    if V = 0 then inc Ag
    T = Ar - Ag
    if T <= 20 then
      AtPh = 1
      AtT = 0
      print at 12,18, "GOT YOU!"
    end if
  else
    if AtPh = 1 then
      if AtT >= 90 then
        AtPh = 2
        AtT = 0
        print at 5,18, "NOW I AM CHASING YOU!"
      end if
    else
      if AtPh = 2 then
        if Ag > 16 then dec Ag
        if AtT > 30 then
          dec Ar
          V = AtT & 1
          if V = 0 then dec Ar
          T = Ag + 20
          if Ar <= T then
            AtPh = 3
            AtT = 0
            print at 5,18, "                     "
            print at 7,18, "DARN, YOU GOT ME."
          end if
        end if
      else
        if AtT >= 90 then
          print at 7,18, "                 "
          AtPh = 0
          AtT = 0
          Ag = 16
          Ar = 70
        end if
      end if
    end if
  end if
  set sprite 0 to 151,Ag,SMan,ColG
  set sprite 1 to 151,Ar,SMan,ColR
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop black
  print at 11,2, "YOU'RE IT!"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

sub HowTo:
  Page = 1
  NewScreen
  backdrop black
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the picture: the two men, the original's sprites
  set sprite 0 to 63,48,SMan,ColG
  set sprite 1 to 63,168,SMan,ColR
  update sprites
  print at 2,13, "CONTROLLER 1"
  print at 17,13, "CONTROLLER 2"
  TxT = TxtHow1b
  TxY = 15
  TextShow
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    put char TItig at 2,9
    put char TIttg at 3,9
    put char TItir at 2,11
    put char TIttr at 3,11
    TxT = TxtHow2b
    TxX0 = 5
    TxY = 9
    TextShow
    TxT = TxtHow2c
    TxX0 = 2
    TxY = 15
    TextShow
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    fill TEdge count 28 at 2,2
    fill TEdgeb count 28 at 2,22
    TxT = TxtHow3
    TxX0 = 2
    TxY = 4
    TxGap = 2
    TextShow
    print at 8,20, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

data CollDx bytes
  255,255,255,255,255,255,255,255,255,13,13,15,15,17,17,19,19,19,19,19,19,19,19,19,19,19,19,21,21,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,23,21,21,19,19,19,19,19,19,19,19,19,19,19,19,17,17,15,15,13,13,255,255,255,255,255,255,255,255,255
end data
' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

data TilePatZ bytes
  $85,$CC,$60,$3D,$C3,$81,$A5,$81,$C3,$24,$99,$00,$F0,$EE,$EF,$18,$FE,$BA,$C3,$F1,$81,$FE,$FE,$E0
  $03,$94,$FE,$B5,$01,$55,$58
end data
data TileColZ bytes
  $AB,$81,$18,$E0,$F8,$82,$31,$31,$13,$13,$08,$B1,$B1,$1B,$1B,$2F,$13,$FE,$E3,$E1,$01,$18,$F8,$FE
  $C1,$B8,$01,$03,$DE,$B9,$03,$F0,$AB,$13,$08,$FB,$D9,$CE,$08,$BE,$F0,$FE,$24,$08,$01,$AA,$04,$01
  $46,$D5,$41,$55,$60
end data
data SpritePatZ bytes
  $0A,$07,$0F,$1F,$3F,$89,$39,$A8,$3F,$1F,$0F,$04,$86,$0E,$E0,$F0,$F8,$FC,$A2,$9C,$6A,$FC,$F8,$F0
  $20,$2D,$70,$55,$56
end data

data TxD_0 bytes
  $03,$41,$4E,$44,$03,$54,$48,$45,$02,$49,$53,$03,$41,$4D,$59,$02,$42,$59,$03,$4F,$4E,$45,$01,$41
  $04,$46,$52,$45,$45,$03,$49,$54,$2C,$02,$4F,$4E,$08,$4F,$52,$49,$47,$49,$4E,$41,$4C,$06,$50,$4C
  $41,$59,$45,$52,$03,$52,$55,$4E,$03,$54,$41,$47,$04,$54,$49,$4D,$45,$03,$54,$57,$4F
