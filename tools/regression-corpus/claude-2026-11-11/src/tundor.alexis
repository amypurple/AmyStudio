' ---------------------------------------------------------------------------
' ShiftRow (a = cavern row 0..18): screen row a+3 moves one column left
' (columns 3..29 read into Ln, written back from column 2) and column 29
' gets the new column's cell (CK = its top row or 255, CV = its bottom row,
' T1/T2 its slope tiles). ~38 cycles per VDP access (far enough apart with
' the display on). Called with the NMI off. Destroys af, bc, de, hl.
asm {
ShiftRows:
  push af
  push bc
  call ShiftRow
  pop bc
  pop af
  inc a
  djnz ShiftRows
  ret
ShiftRow:
  ld e,a
  ld l,a
  ld h,0
  ld bc,1
  add hl,bc
  add hl,hl
  add hl,hl
  add hl,hl
  add hl,hl
  add hl,hl
  ld bc,$1803
  add hl,bc
  ld a,l
  out ($BF),a
  ld a,h
  out ($BF),a
  push hl
  ld hl,Ln
  ld b,27
  ld c,$BE
SR_rd:
  in a,(c)
  ld (hl),a
  inc hl
  djnz SR_rd
  ; the new cell for row e
  ld a,(CK)
  cp 255
  jr z,SR_sp
  ld d,a
  ld a,e
  cp d
  jr c,SR_wall
  jr z,SR_t1
  ld a,(CV)
  ld d,a
  ld a,e
  cp d
  jr c,SR_sp
  jr z,SR_t2
SR_wall:
  ld a,TWall
  jr SR_put
SR_t1:
  ld a,(T1)
  jr SR_put
SR_t2:
  ld a,(T2)
  jr SR_put
SR_sp:
  ld a,32
SR_put:
  ld (hl),a
  pop hl
  dec hl
  ld a,l
  out ($BF),a
  ld a,h
  or $40
  out ($BF),a
  ld hl,Ln
  ld b,28
SR_wr:
  ld a,(hl)
  out (c),a
  inc hl
  djnz SR_wr
  ret
}

' TopRange: MinT / MaxT of Top[0..28], Full = 1 if any slot is empty (255)
asm {
TopRange:
  ld hl,Top
  ld b,29
  ld de,$00FF
  xor a
  ld (Full),a
TR_loop:
  ld a,(hl)
  inc hl
  cp 255
  jr z,TR_full
  cp e
  jr nc,TR_nomin
  ld e,a
TR_nomin:
  cp d
  jr c,TR_next
  ld d,a
TR_next:
  djnz TR_loop
  ld a,e
  ld (MinT),a
  ld a,d
  ld (MaxT),a
  ret
TR_full:
  ld a,1
  ld (Full),a
  djnz TR_loop
  ld a,e
  ld (MinT),a
  ld a,d
  ld (MaxT),a
  ret
}

asm {
XRand:
  ld hl,(Rs)
  ld a,h
  rra
  ld a,l
  rra
  xor h
  ld h,a
  ld a,l
  rra
  ld a,h
  rra
  xor l
  ld l,a
  xor h
  ld h,a
  ld (Rs),hl
  ret
}
