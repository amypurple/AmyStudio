cartridge "TUNDOR CAVERNS/TONY BRANTNER/1992"
' TUNDOR CAVERNS - by Tony Brantner (ReRUN, Nov/Dec 1992, C-64).
' ColecoVision port in Amy. Rules from the TUNDOR.ML disassembly (see
' README "Original vs port"):
' - the C-64 main loop is not tied to the frame: ~1052 passes a second
'   (jsc64), i.e. 17.5 passes per NTSC frame. Every timer below keeps the
'   original's pass counts and adds 17.5 passes (175 tenths) each frame.
' - the cavern scrolls one column every 75 - 4*level passes ($1100); a
'   level is level*32 + 256 columns ($10FB/$10FC), then an open stretch,
'   then the level ends: tune ($0ED5), the screen wiped, "MOVE JOYSTICK TO
'   BEGIN", next level. Losing a ship replays the level from the start.
' - 6 mines ($10D5..): each fly straight left at a fixed height, slot k
'   one pixel every (6-k) mine updates, an update every 21 - 2*level
'   passes; a free slot is refilled at the next update until the level's
'   columns run out. Shot mines: 10 x level; extra ship every 2000.
' Coordinates: C-64 x 0.7 across (320 -> 224 px), x 0.905 down.

const TWall = 128
const TTdn = 129
const TTup = 130
const TBdn = 131
const TBup = 132
const TLogo00 = 133
const TLogo01 = 134
const TLogo02 = 135
const TLogo03 = 136
const TLogo04 = 137
const TLogo05 = 138
const TLogo06 = 139
const TLogo07 = 140
const TLogo08 = 141
const TLogo09 = 142
const TLogo10 = 143
const TLogo11 = 144
const TLogo12 = 145
const TLogo13 = 146
const TLogo14 = 147
const TLogo15 = 148
const TLogo16 = 149
const TLogo17 = 150
const TLogo18 = 151
const TLogo19 = 152
const TCav00 = 153
const TCav01 = 154
const TCav02 = 155
const TCav03 = 156
const TCav04 = 157
const TCav05 = 158
const TCav06 = 159
const TCav07 = 160
const TCav08 = 161
const TCav09 = 162
const TLife = 163
const SShipa = 0
const SShipb = 4
const SMine = 8
const SShot = 12
const SEx0 = 16
const SEx1 = 20
const SEx2 = 24
const SEx3 = 28
const NTiles8 = 288
const SprBytes = 256
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayA = 5
const SndPlayB = 6
const SndPlayC = 7
const SndPlayD = 8
const SndClick = 9
const SndPop = 10
const SndZap = 11
const SndFanfare = 12
const SndDirge = 13
const TuneFrames = 512
const PlayFrames = 1152
const TxtCredits = 0
const NSpr = 9
const HideY = 192
const NCol = 28
const NRing = 29
const NRow = 18
const PlayTop = 1
const Ring = $0380
const PPF = 175
const WorkBudget = 8
const OpenCols = 20
const ShXMin = 26
const ShXMax = 124
const ShYMin = 11
const ShYMax = 141
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9
' Phase (read by the bots): 0 flying, 1 waiting for the stick, 2 level end,
' 3 ship lost (tune + wipe)
const PhFly = 0
const PhWait = 1
const PhClear = 2
const PhLost = 3

u8 Top[29]
u8 Dr[29]
u8 Ln[28]
u8 Mx[6]
u8 My[6]
u8 MOn[6]
u8 MEx[6]
u8 MCol[6]
u8 MFr[6]
u16 Vel[6]
u8 McTab[8]
u16 Score = 0
u16 HiScore = 0
u16 Bonus = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 PzLeft = 0
u16 Waited = 0
u16 VA = 0
u16 VB = 0
u16 Remain = 0
u16 ScAcc = 0
u16 ScPer = 0
u16 MuAcc = 0
u16 MuPer = 0
u16 SxF = 0
u16 SyF = 0
u16 FxF = 0
u8 TzOn = 0
u8 PzOn = 0
u8 State = 0
u8 Phase = 0
u8 Ships = 0
u8 Level = 0
u8 Hd = 0
u8 Sp = 0
u8 EndNext = 0
u8 CTop = 0
u8 CDir = 0
u8 GapR = 0
u8 OpenLeft = 0
u8 Sx = 0
u8 Sy = 0
u8 Fx = 0
u8 Fy = 0
u8 FOn = 0
u8 Dead = 0
u8 Half = 0
u8 BandA = 0
u8 BandB = 0
u8 BandN = 0
u16 PA = 0
u16 PB = 0
u16 PC = 0
u16 DA = 0
u16 DB = 0
u8 CK = 0
u8 CV = 0
u8 QA0 = 1
u8 QA1 = 0
u8 QB0 = 1
u8 QB1 = 0
u8 QC0 = 1
u8 QC1 = 0
u8 Busy = 0
u8 Units = 0
u8 BandQ = 0
u8 R0 = 0
u8 R1 = 0
u8 OldT = 0
u8 C0 = 0
u8 C1 = 0
u8 T1 = 0
u8 T2 = 0
u8 MinT = 0
u8 MaxT = 0
u8 Full = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Oi = 0
u8 Li = 0
u8 Pi = 0
u8 Px = 0
u8 Py = 0
u8 Hit = 0
u8 WHit = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Q = 0
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on
  ' the mines' C-64 colours 8..15 as TMS9918 colours: nearest TMS colour to
  ' the whole saucer (body + red and blue centre, VICE palette); orange and
  ' brown (nearest: dark red, the cave's colour) take medium red
  McTab[0] = 8
  McTab[1] = 8
  McTab[2] = 13
  McTab[3] = 4
  McTab[4] = 13
  McTab[5] = 3
  McTab[6] = 4
  McTab[7] = 13

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ' the sprite table goes up here, in the vertical blank: uploaded at the
  ' end of a pass (which can end just as the frame does) it was half
  ' written when the frame was sampled and depended on code timing
  update sprites
  ReadPad
  PlayStep
  if Phase = PhClear then
    LevelClear
    goto play_loop
  end if
  if Phase = PhLost then
    ShipLost
    if Ships > 0 then
      LevelStart
      goto play_loop
    end if
  else
    goto play_loop
  end if

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' 16-bit xorshift (7,9,8), in asm: the Amy shifts cost ~2k cycles a call
sub Rand:
  call asm XRand
  return
end sub

function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

sub NewGame:
  Score = 0
  Bonus = 2000
  Ships = 3
  Level = 1
  State = StPlay
  NewScreen
  for Li = 0 to 28
    Top[Li] = 255
  next
  DrawLogo
  ShowHud
  ShowScreen
  LevelStart
  return
end sub

' $087C: a level (also after a lost ship): the playfield is empty (cleared
' or wiped), the cavern comes in from the right; the stick starts it
sub LevelStart:
  Phase = PhWait
  T = Level >> 1
  ' C-64 gap 13 - level/2 of 21 rows -> x 6/7 for the 18 rows here
  T = 13 - T
  T = T * 6
  T += 3
  GapR = T / 7
  Rand
  T = Rs & 3
  CTop = T + 3
  CDir = 0
  Remain = Level << 5
  Remain += 256
  OpenLeft = OpenCols
  T = Level << 2
  T = 75 - T
  ScPer = T * 10
  ScAcc = 0
  T = Level << 1
  T = 21 - T
  MuPer = T * 10
  MuAcc = 0
  ' mine slot k: one pixel per (6 - k) updates of MuPer passes, x 0.7:
  ' 0.7 * 17.5 * 256 / ((6 - k) * (21 - 2 * level)) = 3136 / ...
  for Li = 0 to 5
    K = 6 - Li
    K = K * T
    Vel[Li] = 3136 / K
    MOn[Li] = 0
    MEx[Li] = 0
    MFr[Li] = 0
  next
  Dead = 0
  Half = 0
  Busy = 0
  FOn = 0
  Sx = 111
  Sy = 65
  SxF = Sx * 256
  SyF = Sy * 256
  EndNext = 0
  Sp = Hd + 28
  if Sp >= NRing then Sp -= NRing
  MakeCol
  CaveColour
  ShowHud
  DrawSprites
  ' $0C68: "MOVE JOYSTICK TO BEGIN" until the stick moves
  print at 5,10, "MOVE JOYSTICK TO BEGIN"
lw_loop:
  Frame1
  update sprites
  ReadPad
  if Jk = 0 then goto lw_loop
  fill 32 count 22 at 5,10
  Phase = PhFly
  StartPlayTune
  return
end sub

' $0D47: the cavern's colour by level & 3 (orange, green, brown, purple)
sub CaveColour:
  T = Level & 3
  ' C-64 orange (183,99,30 in VICE) is closest to TMS dark red
  V = 6
  if T = 0 then V = 13
  if T = 2 then V = 2
  if T = 3 then V = 10
  ' rock = pattern bits 1 (the ROM glyphs), fg = cave colour, bg = black
  K = V << 4
  K = K | 1
  fill K count 40 to vram.color + 1024
  return
end sub

' $0AEE: the next column. The top moves one row in direction CDir; out of
' range, or on a coin toss, the direction flips and the top stays.
sub MakeCol:
  if Remain = 0 then
    Top[Sp] = 255
    if OpenLeft > 0 then
      dec OpenLeft
    else
      EndNext = 1
    end if
    return
  end if
  dec Remain
  if CDir = 0 then
    T = CTop + 1
  else
    T = CTop - 1
  end if
  V = T + GapR
  K = 0
  if T > 200 then K = 1
  if V >= NRow then K = 1
  if K = 0 then
    Rand
    V = Rs & 1
    if V = 0 then K = 1
  end if
  if K = 1 then
    CDir = CDir ^ 1
  else
    CTop = T
  end if
  Top[Sp] = CTop
  Dr[Sp] = CDir
  return
end sub

' after a scroll: which rows changed? Rows above every top and below every
' bottom are solid in all columns, rows between the lowest top and the
' highest bottom are open in all: only the two edge bands change
sub Bands:
  call asm TopRange
  if Full = 1 then
    BandA = 0
    BandB = 17
    R0 = 1
    R1 = 0
  else
    BandA = MinT
    BandB = MaxT
    R0 = MinT + GapR
    R1 = MaxT + GapR
  end if
  return
end sub

' one scroll step: new column, the oldest column dropped
sub ScrollOne:
  inc Hd
  if Hd >= NRing then Hd = 0
  Bands
  QA0 = BandA
  QA1 = BandB
  QB0 = R0
  QB1 = R1
  if Full = 1 then
    QA1 = 17
    QB0 = 1
    QB1 = 0
  end if
  ' overlapping bands: one
  if QB0 <= QA1 then
    if QB1 > QA1 then QA1 = QB1
    QB0 = 1
    QB1 = 0
  end if
  ' the column now entering on the right (slot Hd + 27)
  Sp = Hd + 27
  if Sp >= NRing then Sp -= NRing
  ColPrep
  ' the next column goes into the free slot (the one just dropped)
  Sp = Hd + 28
  if Sp >= NRing then Sp -= NRing
  MakeCol
  Busy = 1
  return
end sub

sub ColPrep:
  CK = Top[Sp]
  CV = CK + GapR
  T1 = TTdn
  T2 = TBdn
  if Dr[Sp] = 1 then
    T1 = TTup
    T2 = TBup
  end if
  return
end sub

' the redraw queue, spread over frames by cost: a row shifted by ShiftRow
' costs ~2.75k Z80 cycles, the rest of a pass ~22k: Units rows a frame
sub Work:
  if QA0 <= QA1 then
    T = QA1 - QA0
    inc T
    if T > Units then T = Units
    call asm ShiftRows with a = QA0, b = T
    QA0 += T
    Units -= T
  end if
  if Units = 0 then return
  if QB0 <= QB1 then
    T = QB1 - QB0
    inc T
    if T > Units then T = Units
    call asm ShiftRows with a = QB0, b = T
    QB0 += T
    Units -= T
  end if
  if QA0 > QA1 then
    if QB0 > QB1 then Busy = 0
  end if
  return
end sub

sub PlayStep:
  ' $1100: the scroll timer (frozen while the ship explodes); a new column
  ' waits until the previous redraw is done
  if Dead = 0 then ScAcc += PPF
  Units = WorkBudget
  if Busy = 0 then
    if ScAcc >= ScPer then
      ScAcc -= ScPer
      if ScAcc >= ScPer then ScAcc = ScPer - 1
      if EndNext = 1 then
        Phase = PhClear
        return
      end if
      ScrollOne
      Units -= 3
    end if
  end if
  if Busy = 1 then Work
  if Dead = 0 then
    MoveShip
    if FOn = 0 then
      if Btn > 0 then
        FOn = 1
        Fx = Sx + 18
        FxF = Fx * 256
        Fy = Sy - 6
        play sound SndZap
      end if
    end if
  end if
  MoveShot
  MoveMines
  if Dead = 0 then
    ShipWalls
  else
    inc Dead
    if Dead >= 16 then
      Phase = PhLost
    end if
  end if
  DrawSprites
  return
end sub

' $0965: one step every 25 passes (0.7 a frame): y +-1 C-64 px, right +2,
' left -1 (tables $0DCE/$0DD2); kept in 8.8 fixed point
sub MoveShip:
  V = Jk & 1
  if V > 0 then
    if Sy > ShYMin then SyF -= 154
  end if
  V = Jk & 2
  if V > 0 then
    if Sy < ShYMax then SyF += 154
  end if
  V = Jk & 4
  if V > 0 then
    if Sx > ShXMin then SxF -= 125
  end if
  V = Jk & 8
  if V > 0 then
    if Sx < ShXMax then SxF += 251
  end if
  W16 = SxF >> 8
  Sx = W16
  W16 = SyF >> 8
  Sy = W16
  return
end sub

' the ship against the cavern: four points of its outline
sub ShipWalls:
  Px = Sx + 1
  Py = Sy + 3
  WallAt
  WHit = Hit
  Px = Sx + 14
  Py = Sy + 1
  WallAt
  WHit = WHit | Hit
  Py = Sy + 5
  WallAt
  WHit = WHit | Hit
  Px = Sx + 31
  Py = Sy + 3
  WallAt
  WHit = WHit | Hit
  if WHit > 0 then LoseShip
  return
end sub

' Hit = 1 when screen pixel (Px, Py) is rock (slopes: the triangle)
sub WallAt:
  Hit = 0
  T = Px >> 3
  if T < 2 then return
  T -= 2
  if T > 27 then return
  T += Hd
  if T >= NRing then T -= NRing
  V = Py >> 3
  if V < PlayTop then return
  V -= PlayTop
  if V >= NRow then return
  K = Top[T]
  if K = 255 then return
  Q = Dr[T]
  if V < K then
    Hit = 1
    return
  end if
  J = K + GapR
  if V > J then
    Hit = 1
    return
  end if
  C = Px & 7
  T = Py & 7
  if V = K then
    if Q = 0 then
      if C >= T then Hit = 1
    else
      C += T
      if C <= 7 then Hit = 1
    end if
    return
  end if
  if V = J then
    if Q = 0 then
      if T >= C then Hit = 1
    else
      C += T
      if C >= 7 then Hit = 1
    end if
  end if
  return
end sub

' $09C6: the shot, 1 C-64 px every 2 passes (6.1 px a frame), ends at the
' right ($013C) or on rock; hits a mine when (mine y - shot y) is 0..7 and
' (mine x + 17 - shot x) is 0..26 (C-64 px)
sub MoveShot:
  if FOn = 0 then return
  FxF += 1568
  W16 = FxF >> 8
  if W16 >= 220 then
    FOn = 0
    return
  end if
  Fx = W16
  Px = Fx + 10
  Py = Fy + 13
  WallAt
  if Hit > 0 then
    FOn = 0
    return
  end if
  for Pi = 0 to 5
    if MOn[Pi] > 0 then
      if MEx[Pi] = 0 then
        T = My[Pi]
        if T >= Fy then
          T -= Fy
          if T <= 6 then
            K = Mx[Pi] + 12
            if K >= Fx then
              K -= Fx
              if K <= 18 then
                MEx[Pi] = 1
                FOn = 0
                NumU = Level * 10
                Score += NumU
                play sound SndPop
                if Score > HiScore then HiScore = Score
                if Score >= Bonus then
                  Bonus += 2000
                  if Ships < 99 then inc Ships
                end if
                ShowHud
                return
              end if
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' $0A68: mine updates every MuPer passes refill free slots (until the
' level's columns run out); every frame each mine drifts left at its slot's
' speed; an exploding mine keeps drifting for 256 passes (15 frames)
sub MoveMines:
  MuAcc += PPF
  if MuAcc >= MuPer then
    MuAcc -= MuPer
    if Remain > 0 then SpawnAll
  end if
  for Oi = 0 to 5
    if MOn[Oi] > 0 then
      W16 = MFr[Oi]
      W16 += Vel[Oi]
      T = W16 >> 8
      V = W16 & 255
      MFr[Oi] = V
      V = Mx[Oi]
      if V < T + 16 then
        MOn[Oi] = 0
        MEx[Oi] = 0
      else
        V -= T
        Mx[Oi] = V
        if MEx[Oi] > 0 then
          K = MEx[Oi] + 1
          MEx[Oi] = K
          if K >= 16 then
            MOn[Oi] = 0
            MEx[Oi] = 0
          end if
        else
          if Dead = 0 then
            ' the ship (rows Sy..Sy+6, x Sx..Sx+31) against the mine
            ' (rows My+7..My+11, x Mx+2..Mx+12)
            if V <= 224 then
              K = My[Oi] + 7
              T = Sy + 6
              if K <= T then
                K += 4
                if K >= Sy then
                  K = V + 2
                  T = Sx + 31
                  if K <= T then
                    K = V + 12
                    if K >= Sx then LoseShip
                  end if
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' a free slot gets a new mine at the right edge (C-64 x 326..357, mostly
' off screen), height C-64 100..163 -> 51..107
sub SpawnAll:
  for Li = 0 to 5
    if MOn[Li] = 0 then
      Rand
      T = Rs & 63
      V = T >> 3
      T -= V
      My[Li] = T + 51
      W16 = Rs >> 8
      T = W16 & 31
      V = T >> 2
      T -= V
      Mx[Li] = T + 227
      W16 = Rs >> 13
      T = W16 & 7
      MCol[Li] = McTab[T]
      MOn[Li] = 1
      MEx[Li] = 0
    end if
  next
  return
end sub

sub LoseShip:
  if Dead > 0 then return
  play sound SndPop
  Dead = 1
  FOn = 0
  return
end sub

' sprites: 0-1 the ship (stable), 2 the shot, 3-8 the six mines (the
' sprite flicker shares the lines that hold more than four)
sub DrawSprites:
  if Dead > 0 then
    T = Dead >> 2
    T = T << 2
    T += SEx0
    V = Sx + 8
    set sprite 0 to Sy,V,T,11
    set sprite 1 to HideY,0,SShipb,0
  else
    set sprite 0 to Sy,Sx,SShipa,4
    V = Sx + 16
    set sprite 1 to Sy,V,SShipb,4
  end if
  if FOn > 0 then
    set sprite 2 to Fy,Fx,SShot,8
  else
    set sprite 2 to HideY,0,SShot,0
  end if
  for Li = 0 to 5
    C = Li + 3
    V = Mx[Li]
    if MOn[Li] > 0 then
      if V > 224 then
        set sprite C to HideY,0,SMine,0
      else
        T = My[Li]
        K = MCol[Li]
        Q = MEx[Li]
        if Q > 0 then
          Q = Q >> 2
          Q = Q << 2
          Q += SEx0
          set sprite C to T,V,Q,K
        else
          set sprite C to T,V,SMine,K
        end if
      end if
    else
      set sprite C to HideY,0,SMine,0
    end if
  next
  ' uploaded by play_loop / lw_loop right after the wait
  return
end sub

' $0923 / $093B: a tune (after 20 jiffies), then $0D31: sprites off and
' the screen scrolled empty (40 steps of 2 jiffies on the C-64; here the
' 28 visible columns, 2 frames each)
sub EndTune:
  StopPlayTune
  for Li = 1 to 20
    Frame1
    update sprites
  next
  return
end sub

sub WipeOut:
  HideSprites
  CK = 255
  for Pi = 1 to 28
    Sp = Hd + 28
    if Sp >= NRing then Sp -= NRing
    Top[Sp] = 255
    inc Hd
    if Hd >= NRing then Hd = 0
    Frame1
    for Li = 0 to 8
      call asm ShiftRow with a = Li
    next
    Frame1
    for Li = 9 to 17
      call asm ShiftRow with a = Li
    next
  next
  return
end sub

sub LevelClear:
  EndTune
  play sound SndFanfare
  for Waited = 1 to 222
    Frame1
    update sprites
  next
  WipeOut
  if Level < 9 then inc Level
  LevelStart
  return
end sub

sub ShipLost:
  EndTune
  play sound SndDirge
  for Waited = 1 to 226
    Frame1
    update sprites
  next
  WipeOut
  dec Ships
  ShowHud
  return
end sub

sub StartPlayTune:
  play sound SndPlayA
  play sound SndPlayB
  play sound SndPlayC
  play sound SndPlayD
  PzLeft = PlayFrames
  PzOn = 1
  return
end sub

sub StopPlayTune:
  stop sound SndPlayA
  stop sound SndPlayB
  stop sound SndPlayC
  stop sound SndPlayD
  mute all
  PzOn = 0
  return
end sub

' the C-64's bottom panel (rows 22-24 there, 20-22 here): SC and HI,
' the green "THE CAVERNS OF / TUNDOR" logo, LEVEL and LIVES
sub ShowHud:
  print at 2,20, "SC"
  NumU = Score
  print at 5,20, digits$(NumU, 6)
  print at 21,20, "HI"
  NumU = HiScore
  print at 24,20, digits$(NumU, 6)
  print at 2,22, "LEVEL"
  NumU = Level
  print at 8,22, digits$(NumU, 2)
  print at 22,22, "LIVES"
  NumU = Ships
  print at 28,22, digits$(NumU, 2)
  return
end sub

sub DrawLogo:
  for Li = 0 to 9
    T = TCav00 + Li
    C = Li + 11
    put char T at C,20
    T = TLogo00 + Li
    put char T at C,21
    T = TLogo10 + Li
    put char T at C,22
  next
  return
end sub

sub GameOver:
  HideSprites
  print at 6,8, "GAME OVER...PRESS FIRE"
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  if PzOn = 1 then
    dec PzLeft
    if PzLeft = 0 then
      play sound SndPlayA
      play sound SndPlayB
      play sound SndPlayC
      play sound SndPlayD
      PzLeft = PlayFrames
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  ' art packed with ZX0 (pack.mjs); unpacked with the display off
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  ' the C-64's character ROM font for all text (ASCII 32..95)
  copy C64Font count 512 to vram.pattern + 256
  copy C64Font count 512 to vram.pattern + 2304
  copy C64Font count 512 to vram.pattern + 4352
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: banner, name, menu (cursor back on START), the tune once
sub TitlePage:
  State = StTitle
  NewScreen
  Level = 1
  CaveColour
  fill TWall count 28 at 2,2
  fill TTdn count 28 at 2,3
  print at 9,5, "TUNDOR CAVERNS"
  print at 8,7, "BY TONY BRANTNER"
  fill TBup count 28 at 2,9
  fill TWall count 28 at 2,10
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  fill TBup count 28 at 2,19
  print at 9,21, "RERUN 1992"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 9,2, "TUNDOR CAVERNS"
  ' packed text (text.mjs -> kit/textpack.mjs), airy: lines 2 rows apart,
  ' inside the text area [2,4,29,20] of areas.json
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages, each with a picture made of the game's own
' sprites and tiles
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  Level = 1
  CaveColour
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "FLY THROUGH THE CAVERNS"
  print at 2,5, "OF TUNDOR AND DESTROY THE"
  print at 2,7, "ROVING AIR MINES."
  fill TWall count 16 at 8,9
  put char TTdn at 24,9
  fill TBup count 1 at 8,13
  fill TWall count 15 at 9,13
  set sprite 0 to 83,72,SShipa,5
  set sprite 1 to 83,88,SShipb,5
  set sprite 2 to 77,112,SShot,11
  set sprite 3 to 76,152,SMine,9
  update sprites
  print at 2,16, "STICK MOVES THE SHIP,"
  print at 2,18, "BUTTON FIRES. A MINE IS"
  print at 2,20, "WORTH 10 POINTS X LEVEL."
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "YOU HAVE THREE SHIPS."
    for Li = 0 to 2
      C = Li << 1
      C += 12
      put char TLife at C,5
    next
    print at 2,7, "A WALL OR A MINE COSTS A"
    print at 2,9, "SHIP: THE LEVEL STARTS"
    print at 2,11, "AGAIN. EXTRA SHIP EVERY"
    print at 2,13, "2000 POINTS. EACH LEVEL"
    print at 2,15, "IS NARROWER AND FASTER."
    print at 2,17, "MOVE THE STICK TO BEGIN."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

