cartridge "KETCHUP CONFRONTATION/C. ADAMS & B. KAPILIK/1989"
' INTER-STELLAR KETCHUP CONFRONTATION
' Original: Colin Adams & Brett Kapilik, Ahoy! (July 1989), C64 machine
' language, ReRUN disk 1989-07-08. ColecoVision port in Amy.
'
' The rules, from the original's 6502 code (orig/k.dis):
' - one main-loop pass of the original = one unit; this port runs Passes
'   of them per frame (measured: 211 C64 cycles a pass, ~14400 free
'   cycles a frame -> 68 passes a frame)
' - the stick is read every 20 passes: 1 px left/right (X 25..235);
'   fire (held = auto fire) launches the one ketchup drop at the bottle,
'   which climbs 1 px every 10 passes until it leaves the top
' - three Killer Fries fall 1 px every FDel passes (30, then -3 a level),
'   two Psycho Burgers every BDel (25, -3 a level); one that wraps past
'   the bottom (Y back to 0) comes back at a new random X (25..234)
' - drop hits a fry: 20 points; a burger: 30 points and TO GO - 1
' - TO GO 0: next level, +1 life, TO GO = 10 x level
' - a fry or burger touching the bottle: -1 life (4 at the start)
' Positions are kept in the original's C64 sprite units and only scaled
' for drawing (X - 12, Y about 4/5): same play-field, same speeds.

const TStar1 = 128
const TBlue = 129
const TLife = 130
const TDrip = 131
const TGog = 132
const TGoa = 133
const TGom = 134
const TGoe = 135
const TGoo = 136
const TGov = 137
const TGor = 138
const TGox = 139
const TBar0 = 140
const TBar1 = 141
const TBar2 = 142
const TBar3 = 143
const TBar4 = 144
const TBar5 = 145
const TBar6 = 146
const TBar7 = 147
const TBar8 = 148
const TLab000 = 149
const TLab001 = 150
const TLab010 = 151
const TLab011 = 152
const TLab100 = 153
const TLab101 = 154
const TLab110 = 155
const TLab111 = 156
const TLab201 = 157
const TLab210 = 158
const TLab211 = 159
const TLab301 = 160
const TLab310 = 161
const TLab311 = 162
const TLab401 = 163
const TLab411 = 164
const TLab501 = 165
const TLab511 = 166
const TLab512 = 167
const TLab601 = 168
const TLab611 = 169
const TLab612 = 170
const TLab701 = 171
const TLab702 = 172
const TLab711 = 173
const TLab712 = 174
const SBottle = 0
const SDrop = 4
const SSplat = 8
const SLeak = 12
const SFry = 16
const SBurger = 20
const NTiles8 = 376
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayA = 5
const SndPlayB = 6
const SndPlayC = 7
const SndPlayD = 8
const SndClick = 9
const SndShot = 10
const SndSplat = 11
const SndDie = 12
const SndLevel = 13
const SndOver = 14
const TuneFrames = 448
const PlayFrames = 1024
const TxtCredits = 0
const NSpr = 8
' second colour blocks for objects >= BlkFirst (0: fries and burgers, 3: burgers only, 5: none)
const BlkFirst = 3
const HideY = 192
const Passes = 68
const PlayerY = 208
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StWait = 5
const StOver = 9

u8 FX[3]
u8 FY[3]
u8 BX[2]
u8 BY[2]
u16 Score = 0
u16 Rs = 1
u16 W16 = 0
u16 W2 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 PlayLeft = 0
' original pass counters (u16: they start at 256 like the 6502's 0)
u16 JcC = 0
u16 ScC = 0
u16 FcC = 0
u16 BcC = 0
u16 TcC = 0
u16 TcD = 0
u16 TcN = 0
u16 Ax = 0
u16 Ay = 0
u16 Bx2 = 0
u16 By2 = 0
u16 Ex0 = 0
u16 Ex1 = 0
u16 Ey0 = 0
u16 Ey1 = 0
u8 TzOn = 0
u8 PlayOn = 0
u8 State = 0
u8 Lives = 0
u8 Level = 0
u8 ToGo = 0
u8 ToGoNext = 0
u8 FDel = 0
u8 BDel = 0
u8 PX = 0
u8 SX = 0
u8 SY = 0
u8 ShotOn = 0
u8 Want = 0
u8 ExX = 0
u8 ExY = 0
u8 ExT = 0
u8 Hit = 0
u8 HitK = 0
u8 Dead = 0
u8 Done = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
u8 Ni = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Dx = 0
u8 Dc = 0
u8 JN = 0
u8 SN = 0
u8 Dy = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2
' the bottle's label and cap as tiles under its sprite (LabPut)
u16 BkP = 0
u8 BkX = 0
u8 BkT = 0
u8 BkL = 0
u8 BkR = 0
u8 BkC = 0
u8 BkS = 0
u8 BkW = 0
u8 BkV = 0
u8 BkI = 0
u8 BkJ = 0
u8 BgC = 0
u8 BgR = 0
u8 BgV = 0
u8 BgK = 0
u8 LabC = 255
u8 LabR = 255
u8 LabS = 255
u8 StarsOn = 0
u8 ExLeak = 0
' the field dots' rows (DrawStars): 1 = columns 6/11/16, 2 = 4/9/14
data StarRow bytes
  0,0,1,0,0,2,0,1,0,0,2,0,0,1,0,2,0,0,1,0,2,0,0,0
end data

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Dead = 1 then
    LoseLife
    if Lives = 0 then
      ' the last splat stays one second before GAME OVER
      for Oi = 1 to 60
        Frame1
      next
      goto game_over
    end if
    WaitPress
    StartRound
  end if
  if Done = 1 then
    LevelDone
    WaitPress
    StartRound
  end if
  goto play_loop

game_over:
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift: stepped every title frame, so each game is different
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new X for a fry or burger: 25..234 (the original rejects SID noise
' bytes outside that range)
function RandX() as u8
  u8 Rv = 0
  Rand
  W16 = Rs % 210
  Rv = W16
  Rv += 25
  return Rv

sub NewGame:
  Score = 0
  Lives = 4
  Level = 1
  ToGo = 10
  ToGoNext = 10
  FDel = 30
  BDel = 25
  JcC = 256
  ScC = 256
  FcC = 256
  BcC = 256
  PlayMusic
  StartRound
  return
end sub

' the original's restart (C00C): every fry and burger back at Y 0, the
' bottle in the middle, no drop
sub StartRound:
  fill array FX with 0
  fill array FY with 0
  fill array BX with 0
  fill array BY with 0
  PX = 125
  ShotOn = 0
  Want = 0
  ExT = 0
  ExLeak = 0
  Dead = 0
  Done = 0
  DrawPlay
  State = StPlay
  return
end sub

' how many times a pass counter (TcC, reload TcD) reaches 0 in Passes
' passes: TcN; TcC is left as the 6502's counter would be
sub Ticks:
  if TcC > Passes then
    TcC -= Passes
    TcN = 0
    return
  end if
  ' (subtraction, not u16 '/' and '%': ~1600 cycles each, profiled)
  W16 = Passes - TcC
  TcN = 1
tk_sub:
  if W16 >= TcD then
    W16 -= TcD
    inc TcN
    goto tk_sub
  end if
  TcC = TcD - W16
  return
end sub

' one frame = Passes passes of the original's main loop
sub PlayStep:
  ' the stick, read every 20 passes (C136)
  TcC = JcC
  TcD = 20
  Ticks
  JcC = TcC
  JN = TcN
  if TcN > 0 then
    Want = 0
    V = Btn
    if V > 0 then Want = 1
    V = Jk & 4
    if V > 0 then
      for Ni = 1 to 6
        if Ni <= TcN then
          if PX >= 25 then dec PX
        end if
      next
    end if
    V = Jk & 8
    if V > 0 then
      for Ni = 1 to 6
        if Ni <= TcN then
          if PX < 235 then inc PX
        end if
      next
    end if
  end if
  ' the drop (C307): launched at the bottle, 1 px up every 10 passes
  if ShotOn = 0 then
    if Want = 1 then
      ShotOn = 1
      SX = PX
      SY = PlayerY
      play sound SndShot
    end if
  else
    TcC = ScC
    TcD = 10
    Ticks
    ScC = TcC
    SN = TcN
    if TcN >= SY then
      ShotOn = 0
    else
      T = TcN
      SY -= T
    end if
  end if
  ' the fries (C357)
  TcC = FcC
  TcD = FDel
  Ticks
  FcC = TcC
  for Ni = 1 to 12
    if Ni <= TcN then FryTick
  next
  ' the burgers (C3C6)
  TcC = BcC
  TcD = BDel
  Ticks
  BcC = TcC
  for Ni = 1 to 12
    if Ni <= TcN then BurgerTick
  next
  ' the splat stays 256 passes (C033)
  if ExT > 0 then dec ExT
  ' the original checks the bottle first (C18F) and leaves the loop on a
  ' hit, so the drop's check (C40C) does not run then
  BottleHits
  if Dead = 0 then ShotHits
  DrawSprites
  return
end sub

sub FryTick:
  if FY[0] = 0 then
    FX[0] = RandX()
    FY[0] = 10
    return
  end if
  if FY[1] = 0 then
    FX[1] = RandX()
    FY[1] = 5
    return
  end if
  if FY[2] = 0 then
    FX[2] = RandX()
    FY[2] = 1
    return
  end if
  for J = 0 to 2
    FY[J] = FY[J] + 1
  next
  return
end sub

sub BurgerTick:
  if BY[0] = 0 then
    BX[0] = RandX()
    BY[0] = 7
    return
  end if
  if BY[1] = 0 then
    BX[1] = RandX()
    BY[1] = 3
    return
  end if
  BY[0] = BY[0] + 1
  BY[1] = BY[1] + 1
  return
end sub

' box overlap of A (Ax..Bx2, Ay..By2) and E (Ex0..Ex1, Ey0..Ey1), both
' clipped to the C64's visible rows 50..249 -> Hit
sub Overlap:
  Hit = 0
  if Ex0 > Bx2 then return
  if Ax > Ex1 then return
  if Ey0 > By2 then return
  if Ay > Ey1 then return
  ' the overlap's rows must be on the visible screen
  W16 = Ay
  if Ey0 > W16 then W16 = Ey0
  W2 = By2
  if Ey1 < W2 then W2 = Ey1
  if W2 < 50 then return
  if W16 > 249 then return
  Hit = 1
  return
end sub

' the drop against fries (20) and burgers (30); first hit only
sub ShotHits:
  if ShotOn = 0 then return
  Ax = SX
  Ax += 9
  Bx2 = SX
  Bx2 += 15
  Ay = SY
  Ay += 2
  By2 = SY
  By2 += 23
  for Oi = 0 to 2
    Ex0 = FX[Oi]
    Ex1 = Ex0
    Ex1 += 19
    Ey0 = FY[Oi]
    Ey0 += 4
    Ey1 = FY[Oi]
    Ey1 += 35
    Overlap
    if Hit = 1 then
      ExX = FX[Oi]
      ExY = FY[Oi]
      FY[Oi] = 0
      Score += 20
      Killed
      return
    end if
  next
  for Oi = 0 to 1
    Ex0 = BX[Oi]
    Ex1 = Ex0
    Ex1 += 23
    Ey0 = BY[Oi]
    Ey0 += 10
    Ey1 = BY[Oi]
    Ey1 += 25
    Overlap
    if Hit = 1 then
      ExX = BX[Oi]
      ExY = BY[Oi]
      BY[Oi] = 0
      Score += 30
      dec ToGo
      Killed
      if ToGo = 0 then Done = 1
      return
    end if
  next
  return
end sub

sub Killed:
  ShotOn = 0
  ExLeak = 0
  ExT = 4
  play sound SndSplat
  ' only the score and the TO GO bar change (keeps the frame short)
  NumU = Score
  TxY = 5
  PrintLeft
  ShowBar
  return
end sub

' a fry or burger touching the bottle
sub BottleHits:
  Ax = PX
  Ax += 6
  Bx2 = PX
  Bx2 += 17
  Ay = 210
  By2 = 249
  for Oi = 0 to 2
    Ex0 = FX[Oi]
    Ex1 = Ex0
    Ex1 += 19
    Ey0 = FY[Oi]
    Ey0 += 4
    Ey1 = FY[Oi]
    Ey1 += 35
    Overlap
    if Hit = 1 then Dead = 1
  next
  for Oi = 0 to 1
    Ex0 = BX[Oi]
    Ex1 = Ex0
    Ex1 += 23
    Ey0 = BY[Oi]
    Ey0 += 10
    Ey1 = BY[Oi]
    Ey1 += 25
    Overlap
    if Hit = 1 then Dead = 1
  next
  return
end sub

sub LoseLife:
  dec Lives
  ExX = PX
  ExY = PlayerY
  ExT = 255
  ExLeak = 1
  ShotOn = 0
  DrawSprites
  play sound SndDie
  ShowHud
  return
end sub

' TO GO 0 (C520): next level, faster fries and burgers, +1 life
sub LevelDone:
  inc Level
  if FDel > 5 then FDel -= 3
  if BDel > 5 then BDel -= 3
  inc Lives
  ToGoNext += 10
  ToGo = ToGoNext
  ShotOn = 0
  DrawSprites
  ShowHud
  print at 3,11, "LEVEL COMPLETED"
  play sound SndLevel
  return
end sub

' after a lost life or a level: the original waits for the button
sub WaitPress:
  State = StWait
  print at 5,13, "PRESS BUTTON"
  WasBtn = 16
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' C64 sprite X,Y (the top-left of its 24 x 42 box) -> the same box on the
' screen. Sprites are magnified: one pattern pixel is one C64 multicolour
' pixel, 1:1. X: the C64 field (sprite X 24..232, 29 columns) into columns
' 2-19 (x 16..136, the box ends by x 160) next to the panel. Y: the visible
' C64 lines 50..250 into rows 1-22 (box top 8..141, x 0.85); shown for C64 Y
' 11..245 (11: past the respawn values 1..10; 245: the last Y that can still
' touch the bottle), held on row 1 while in the C64 top border.
' Out: Dx, Dy = the box (Dy = SAT Y, top line Dy+1), Dy = HideY if hidden.
sub ScreenXY:
  ' (tables from art.py, same formulas as above)
  Dx = XMap[Dx]
  Dy = YMap[Dy]
  return
end sub

' v3: one sprite per object (v1's 16 x 16 sprites, not magnified), placed
' in the middle of the C64 box: bottle +11 lines, drop +2, splat/leak +9,
' fry +9, burger +7 (the v1 picture centres, x 0.85). The bottle's white
' label/cap are tiles under its sprite (LabPut, art.py); fries and burgers
' stay one colour as in v1 (their tiles did not fit the frame: README).
' Slots: 0 bottle
' (stable), 1 drop, 2 splat, 3-5 fries, 6-7 burgers.
sub DrawSprites:
  Dx = PX
  Dy = PlayerY
  ScreenXY
  if Lives = 0 then Dy = HideY
  T = Dy
  if Dy < HideY then T = Dy + 11
  set sprite 0 to T,Dx,SBottle,8
  BkX = Dx
  BkT = T
  LabPut
  Dy = HideY
  if ShotOn = 1 then
    Dx = SX
    Dy = SY
    ScreenXY
  end if
  T = Dy
  if Dy < HideY then T = Dy + 2
  set sprite 1 to T,Dx,SDrop,8
  Dy = HideY
  if ExT > 0 then
    Dx = ExX
    Dy = ExY
    ScreenXY
  end if
  T = Dy
  if Dy < HideY then T = Dy + 9
  ' the bottle's own splat (a lost life) is the "leak": the label shows
  ' through it as in v1 (art.py); on the last life the bottle is gone
  K = SSplat
  if ExLeak = 1 then
    if Lives > 0 then K = SLeak
  end if
  set sprite 2 to T,Dx,K,9
  for Li = 0 to 2
    Dx = FX[Li]
    Dy = FY[Li]
    ScreenXY
    T = Dy
    if Dy < HideY then T = Dy + 9
    C = Li + 3
    set sprite C to T,Dx,SFry,11
  next
  for Li = 0 to 1
    Dx = BX[Li]
    Dy = BY[Li]
    ScreenXY
    T = Dy
    if Dy < HideY then T = Dy + 7
    C = Li + 6
    set sprite C to T,Dx,SBurger,10
  next
  update sprites
  return
end sub

' the background of cell BgC,BgR -> BgV: a field dot or a blank
sub BgAt:
  BgV = 32
  if StarsOn = 0 then return
  if BgR > 23 then return
  BgK = StarRow[BgR]
  if BgK = 1 then
    if BgC = 6 then BgV = TStar1
    if BgC = 11 then BgV = TStar1
    if BgC = 16 then BgV = TStar1
  end if
  if BgK = 2 then
    if BgC = 4 then BgV = TStar1
    if BgC = 9 then BgV = TStar1
    if BgC = 14 then BgV = TStar1
  end if
  return
end sub

' the bottle's white label and cap under its sprite at BkX, SAT Y BkT
' (the top line on a row boundary): 2 rows x 3 cells, pre-shifted (LabTile)
sub LabPut:
  if BkT >= HideY then
    if LabR < 24 then
      BgC = LabC
      for BkJ = 0 to 2
        BgR = LabR
        BgAt
        put char BgV at BgC,BgR
        inc BgR
        BgAt
        put char BgV at BgC,BgR
        inc BgC
      next
      LabR = 255
    end if
    return
  end if
  BkL = BkT + 1
  BkR = BkL >> 3
  BkC = BkX >> 3
  BkS = BkX & 7
  BkW = 0
  if BkS <> LabS then BkW = 1
  if BkC <> LabC then BkW = 1
  if BkR <> LabR then BkW = 1
  if BkW = 0 then return
  ' the old cells outside the new ones: background
  if LabR < 24 then
    BgC = LabC
    for BkJ = 0 to 2
      BkW = 0
      if BgC < BkC then BkW = 1
      BkV = BkC + 2
      if BgC > BkV then BkW = 1
      if BkR <> LabR then BkW = 1
      if BkW = 1 then
        BgR = LabR
        BgAt
        put char BgV at BgC,BgR
        inc BgR
        BgAt
        put char BgV at BgC,BgR
      end if
      inc BgC
    next
  end if
  LabS = BkS
  LabC = BkC
  LabR = BkR
  BkP = BkS * 6
  BgR = BkR
  for BkJ = 0 to 1
    BgC = BkC
    for BkI = 0 to 2
      BgV = LabTile[BkP]
      if BgV = 0 then BgAt
      put char BgV at BgC,BgR
      inc BkP
      inc BgC
    next
    inc BgR
  next
  return
end sub

' label state: nothing on the (new, cleared) screen
sub BlkReset:
  LabR = 255
  LabC = 255
  LabS = 255
  return
end sub

' a still bottle / fry / burger on the title and HOW TO PLAY pages
sub StillBottle:
  set sprite 0 to BkT,BkX,SBottle,8
  LabPut
  return
end sub

sub StillFry:
  set sprite 3 to BkT,BkX,SFry,11
  return
end sub

sub StillBurger:
  set sprite 6 to BkT,BkX,SBurger,10
  return
end sub

' the original's right-hand panel (C64 columns 29-38): blue frame, green
' labels. Here columns 20-29, rows 1-21: four boxes of 4 rows (the C64's
' have 5: 22 rows instead of 25). Readability: score in digits, level as
' "LV n", lives as small bottles, TO GO as a bar (full at a level's start)
sub DrawPanel:
  fill TBlue count 10 at 20,1
  fill TBlue count 10 at 20,6
  fill TBlue count 10 at 20,11
  fill TBlue count 10 at 20,16
  fill TBlue count 10 at 20,21
  for Li = 2 to 20
    put char TBlue at 20,Li
    put char TBlue at 29,Li
  next
  print at 22,3, "SCORE:"
  print at 22,8, "LEVEL:"
  print at 22,13, "LIVES:"
  print at 22,18, "TO GO:"
  return
end sub

' a number at 22,TxY, left-aligned as the C64 prints it, blanks after it
sub PrintLeft:
  print at 22,TxY, "      "
  if NumU < 10 then
    print NumU at 22,TxY digits 1
    return
  end if
  if NumU < 100 then
    print NumU at 22,TxY digits 2
    return
  end if
  if NumU < 1000 then
    print NumU at 22,TxY digits 3
    return
  end if
  if NumU < 10000 then
    print NumU at 22,TxY digits 4
    return
  end if
  print NumU at 22,TxY digits 5
  return
end sub

sub ShowHud:
  NumU = Score
  TxY = 5
  PrintLeft
  print at 22,10, "LV    "
  NumU = Level
  if NumU < 10 then
    print NumU at 25,10 digits 1
  else
    print NumU at 25,10 digits 2
  end if
  ' lives: up to 6 small bottles; more: one bottle, "x" and the number
  print at 22,15, "      "
  if Lives <= 6 then
    if Lives > 0 then fill TLife count Lives at 22,15
  else
    put char TLife at 22,15
    print at 23,15, "X"
    NumU = Lives
    if NumU < 10 then
      print NumU at 24,15 digits 1
    else
      print NumU at 24,15 digits 2
    end if
  end if
  ShowBar
  return
end sub

' TO GO: a 48-pixel bar (6 cells), ToGo / ToGoNext of it, rounded up
sub ShowBar:
  W16 = ToGo
  W16 = W16 * 48
  W2 = ToGoNext
  W16 += W2
  W16 -= 1
  W16 = W16 / W2
  BgV = W16
  BgC = 22
  for BkJ = 0 to 5
    if BgV >= 8 then
      put char TBar8 at BgC,20
      BgV -= 8
    else
      BgK = TBar0 + BgV
      put char BgK at BgC,20
      BgV = 0
    end if
    inc BgC
  next
  return
end sub

' the original's field: green full stops, 3 per row on every third row,
' rows shifted by half a step (C64 columns 7/15/23 and 4/12/20 on rows
' 1,4,..,22), scaled into columns 2-19 / rows 1-22
sub DrawStars:
  for Li = 0 to 7
    T = Li * 21
    T += 4
    T = T >> 3
    T += 2
    V = Li & 1
    if V = 0 then
      put char TStar1 at 6,T
      put char TStar1 at 11,T
      put char TStar1 at 16,T
    else
      put char TStar1 at 4,T
      put char TStar1 at 9,T
      put char TStar1 at 14,T
    end if
  next
  return
end sub

sub DrawPlay:
  NewScreen
  ' the C64 prints the play screen's text in green (colour 5)
  fill $21 count 1024 to vram.color
  StarsOn = 1
  DrawStars
  DrawPanel
  ShowHud
  ShowScreen
  DrawSprites
  return
end sub

sub GameOver:
  stop sound SndPlayA
  stop sound SndPlayB
  stop sound SndPlayC
  stop sound SndPlayD
  PlayOn = 0
  HideSprites
  ClearUnder
  ' "GAME OVER!" in red, as on the C64 (red copies of the letters, art.py)
  put char TGog at 6,6
  put char TGoa at 7,6
  put char TGom at 8,6
  put char TGoe at 9,6
  put char 32 at 10,6
  put char TGoo at 11,6
  put char TGov at 12,6
  put char TGoe at 13,6
  put char TGor at 14,6
  put char TGox at 15,6
  print at 5,13, "PRESS BUTTON"
  play sound SndOver
  return
end sub

' the label tiles off the screen (the bottle sprite is hidden)
sub ClearUnder:
  BkT = HideY
  LabPut
  return
end sub

' the quiet in-game tune (tune.py, ScPlay*), restarted when it ends
sub PlayMusic:
  play sound SndPlayA
  play sound SndPlayB
  play sound SndPlayC
  play sound SndPlayD
  PlayLeft = PlayFrames
  PlayOn = 1
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  if PlayOn = 1 then
    dec PlayLeft
    if PlayLeft = 0 then PlayMusic
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 7
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  ' art packed with ZX0 (pack.mjs); unpacked with the display off
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  StarsOn = 0
  BlkReset
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: banner, name, menu (cursor back on START), the tune once
sub TitlePage:
  State = StTitle
  NewScreen
  ' plain black like the C64's title page (the dots are the play field's)
  fill TDrip count 28 at 2,1
  print at 4,4, "INTER-STELLAR KETCHUP"
  print at 9,6, "CONFRONTATION"
  print at 6,8, "C. ADAMS & B. KAPILIK"
  ' the game's sprites: fry and burger left of the menu, the bottle right
  BkX = 208
  BkT = 87
  StillBottle
  BkX = 28
  BkT = 91
  StillFry
  BkT = 123
  StillBurger
  update sprites
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 7,20, "AHOY! 1989   C64"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 9,2, "CREDITS"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages, pictures made of the game's own sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "THE GOOD GUY: OUR HERO"
  BkX = 120
  BkT = 39
  StillBottle
  set sprite 1 to 33,144,SDrop,8
  print at 2,9, "THE BAD GUYS:"
  BkX = 28
  BkT = 83
  StillFry
  print at 9,11, "KILLER FRY"
  print at 9,13, "20 POINTS"
  BkX = 28
  BkT = 115
  StillBurger
  print at 9,15, "PSYCHO BURGER"
  print at 9,17, "30 POINTS"
  print at 8,21, "PRESS THE BUTTON"
  update sprites
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "STICK LEFT/RIGHT MOVES"
    print at 2,5, "THE BOTTLE. THE BUTTON"
    print at 2,7, "SQUIRTS KETCHUP UP."
    print at 2,9, "DON'T LET THEM TOUCH YOU."
    print at 2,11, "SHOOT TO GO BURGERS TO"
    print at 2,13, "CLEAR A LEVEL: +1 LIFE,"
    print at 2,15, "AND THEY FALL FASTER."
    print at 2,17, "FOUR LIVES TO START."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

