cartridge "CHOPPER RUN/HOWARD CAMPBELL/1984"
' CHOPPER RUN - ColecoVision port of Howard Campbell's C64 BASIC game from
' the ReRUN Game Pak. Port in Amy (README.md has the traced numbers).
'
' You fly a reconnaissance chopper (seen from above) behind enemy lines. The
' ground's "projections" (brown balls) scroll down the screen one row per
' pass of the original's BASIC loop; a heat-seeking missile rises from the
' bottom of the screen right under you (the original's IRQ copies the
' chopper's X into the missile every frame). The missile can only be shaken
' off by making it strike a ground projection: fly over one and let the
' missile hit it. Touching a projection, being hit, or climbing above the
' top limit ends the run. The score is the distance flown.
'
' Logic in the original's units: C64 sprite coordinates, 60 Hz IRQ moves of
' 1 px, the BASIC pass timed in 1/16 frames (traced in jsc64), collisions
' tested on the C64 pixel masks. Drawing: columns scaled 0.7, rows 1:1.

const TG0 = 128
const TG1 = 129
const TG2 = 130
const TG3 = 131
const TG4 = 132
const TG5 = 133
const TG6 = 134
const TG7 = 135
const TG8 = 136
const TG9 = 137
const TG10 = 138
const TG11 = 139
const TG12 = 140
const TG13 = 141
const TG14 = 142
const TG15 = 143
const TG16 = 144
const TG17 = 145
const TG18 = 146
const TG19 = 147
const TG20 = 148
const TG21 = 149
const TG22 = 150
const TG23 = 151
const TG24 = 152
const TG25 = 153
const THeli00 = 154
const THeli01 = 155
const THeli02 = 156
const THeli03 = 157
const THeli04 = 158
const THeli05 = 159
const THeli10 = 160
const THeli11 = 161
const THeli12 = 162
const THeli13 = 163
const THeli14 = 164
const THeli15 = 165
const THeli20 = 166
const THeli21 = 167
const THeli22 = 168
const THeli23 = 169
const THeli24 = 170
const THeli25 = 171
const THeli30 = 172
const THeli31 = 173
const THeli32 = 174
const THeli33 = 175
const THeli34 = 176
const THeli35 = 177
const THeli40 = 178
const THeli41 = 179
const THeli42 = 180
const THeli43 = 181
const THeli44 = 182
const THeli45 = 183
const TBall = 184
const TRule = 185
const SCw0 = 0
const SCb0 = 4
const SCg0 = 8
const SCh0 = 12
const SCw1 = 16
const SCb1 = 20
const SCg1 = 24
const SCh1 = 28
const SCw2 = 32
const SCb2 = 36
const SCg2 = 40
const SCh2 = 44
const SCw3 = 48
const SCb3 = 52
const SCg3 = 56
const SCh3 = 60
const SMr = 64
const SMg = 68
const SMw = 72
const SEx0 = 76
const SEx1 = 80
const NTiles8 = 464
const SprBytes = 672
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndClick = 5
const SndChop = 6
const SndCrash = 7
const SndOver = 8
const TuneFrames = 512
const TxtCredits = 0
const TxtHow1 = 1
const TxtHow2 = 2
const TxtHow3 = 3
const NSpr = 6
const HideY = 192
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StCrash = 5
const StNext = 6
const StOver = 9

u16 Rs = 1
u16 W16 = 0
u16 T16 = 0
u16 NumU = 0
u16 Waited = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 Skill = 3
' the chopper: C64 sprite X (low byte + MSB as in the original's IRQ), Y
u8 XL = 155
u8 XM = 0
u8 Cy = 200
u8 My = 255
u8 Anim = 0
u8 Fr = 0
u8 Fo = 0
u8 Ph = 90
u8 Alive = 0
u8 LatSS = 0
u8 LatBG = 0
u8 Sp = 0
u8 E1 = 0
u8 Ev = 0
u8 Stp = 0
u8 MStp = 2
u8 C200 = 0
u16 Dist = 0
u16 MaxD = 0
u16 Pass = 0
u16 Tq = 0
u16 Cx = 0
' hit test in/out
u16 HX = 0
u8 HY = 0
u8 HH = 0
u8 HMis = 0
u8 HHit = 0
u8 CLo = 0
u8 CHi = 0
u8 RLo = 0
u8 RHi = 0
u8 HR = 0
u8 HC = 0
u8 HJ = 0
u8 Bi = 0
u8 Gy = 0
u8 Sy = 0
u8 Dxp = 0
u8 Ib = 0
u8 B0 = 0
u8 B1 = 0
u8 Wm = 0
u16 Mi = 0
u16 Y16 = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 Li = 0
u8 Ai = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u16 Off = 0
u8 RowJ[21]
u16 FrOff = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

data AnimTab bytes 0,3,1,2
data SSBase bytes 0,43,86,129
data Bit8 bytes $80,$40,$20,$10,$08,$04,$02,$01
' 1/16 frames from the pass start (line 550) to line 575, per skill 0-5
data E1Tab bytes 10,17,24,30,39,47

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 2 then
    HowTo
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  IrqStep
  PassStep
  DrawSprites
  if Alive = 1 then goto play_loop

  Crash
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub NewGame:
  State = StNext
  XL = 155
  XM = 0
  Cy = 200
  My = 255
  Anim = 0
  Ph = 90
  Dist = 0
  Pass = 0
  MStp = 2
  C200 = 0
  Tq = 0
  Ev = 0
  LatSS = 0
  LatBG = 0
  Sp = 6 - Skill
  E1 = E1Tab[Skill]
  Alive = 1
  DrawPlay
  State = StPlay
  return
end sub

' the original's IRQ, once a frame: stick moves 1 px, the missile takes the
' chopper's X, the rotor turns (pictures 0,3,1,2); then what the VIC shows
' this frame latches the collisions (read by the pass like $D01E/$D01F)
sub IrqStep:
  V = Jk & 1
  if V > 0 then dec Cy
  V = Jk & 2
  if V > 0 then inc Cy
  V = Jk & 4
  if V > 0 then
    if XL = 0 then
      if XM = 0 then
        XM = 1
        XL = 80
      else
        XM = 0
        XL = 255
      end if
    else
      dec XL
    end if
  else
    V = Jk & 8
    if V > 0 then
      inc XL
      if XL = 0 then
        XM = 1
      else
        if XL = 80 then
          if XM = 1 then
            XM = 0
            XL = 0
          end if
        end if
      end if
    end if
  end if
  inc Anim
  Anim = Anim & 3
  Fr = AnimTab[Anim]
  FrOff = Fr << 7
  W16 = Fr << 4
  FrOff -= W16
  Cx = XM
  Cx = Cx << 8
  Cx += XL
  ' missile on the chopper (same X): table by picture and Y difference
  T16 = My + 21
  Y16 = Cy
  if T16 >= Y16 then
    T16 -= Y16
    if T16 <= 42 then
      Mi = SSBase[Fr]
      Mi += T16
      if SSHit[Mi] = 1 then LatSS = 1
    end if
  end if
  ' chopper and missile against the ground
  HX = Cx
  HY = Cy
  HH = 21
  HMis = 0
  HitTest
  if HHit = 1 then LatBG = LatBG | 1
  HY = My
  HH = 14
  HMis = 1
  HitTest
  if HHit = 1 then LatBG = LatBG | 2
  return
end sub

' the BASIC pass (lines 550-640), timed in 1/16 frames from jsc64 traces:
' 550 chop sound, distance; 575 missile hit?; 580 sound off, HUD; the
' screen scroll; 610 ground hit?; 635 missile climbs; 638 too high?
sub PassStep:
  Tq += 16
ps_again:
  if Ev = 0 then
    play sound SndChop
    Dist += Sp
    Ev = 1
  end if
  if Ev = 1 then
    if Tq < E1 then return
    if LatSS = 1 then
      Alive = 0
      return
    end if
    Ev = 2
  end if
  if Ev = 2 then
    T = E1 + 8
    if Tq < T then return
    stop sound SndChop
    ShowHud
    Ev = 3
  end if
  if Ev = 3 then
    T = E1 + 37
    if Tq < T then return
    inc Ph
    if Ph >= 91 then Ph = 0
    DrawFieldA
    Ev = 8
    return
  end if
  if Ev = 8 then
    DrawFieldB
    Ev = 4
  end if
  if Ev = 4 then
    T = E1 + 53
    if Tq < T then return
    V = LatBG & 1
    if V > 0 then
      Alive = 0
      return
    end if
    if LatBG > 0 then My = 255
    LatBG = 0
    Ev = 5
  end if
  if Ev = 5 then
    T = E1 + 70
    if Tq < T then return
    ' F = 2 + 0.005 * pass; POKE truncates: 2 on pass 0, then 2 + ceil
    if Pass > 0 then
      if C200 = 0 then inc MStp
      inc C200
      if C200 >= 200 then C200 = 0
    end if
    Stp = MStp
    if My < Stp then
      My = 255
    else
      My -= Stp
      if My < 25 then My = 255
    end if
    inc Pass
    Ev = 6
  end if
  if Ev = 6 then
    T = E1 + 80
    if Tq < T then return
    if Cy < 55 then
      Alive = 0
      return
    end if
    Ev = 7
  end if
  T = E1 + 91
  if Skill = 0 then T = E1 + 87
  if Tq < T then return
  Tq -= T
  Ev = 0
  goto ps_again
end sub

' collision of a C64 sprite (X = HX, Y = HY, HH rows; chopper picture Fr or
' the missile) with the ground balls of the screen (C64 rows 2-20). Row r
' shows ring cells 8 * RowJ[r] + column (row 20: its first 8 columns only);
' a ball in a cell hits when the precomputed C64 pixel table (art.py: ball
' glyph against the sprite's DATA, by cell offset dx, dy) says so
sub HitTest:
  HHit = 0
  if HX = 0 then return
  if HX > 343 then return
  CLo = 0
  if HX >= 24 then
    W16 = HX - 24
    W16 = W16 >> 3
    CLo = W16
  end if
  W16 = HX - 1
  W16 = W16 >> 3
  CHi = W16
  if CHi > 39 then CHi = 39
  Y16 = HY + HH
  if Y16 < 67 then return
  Y16 -= 51
  Y16 = Y16 >> 3
  if Y16 > 20 then Y16 = 20
  RHi = Y16
  RLo = 2
  if HY >= 50 then
    T = HY - 50
    T = T >> 3
    if T > 2 then RLo = T
  end if
  if RLo > RHi then return
  HR = RLo
ht_row:
  HJ = RowJ[HR]
  ' quick reject: no ball in the row's bytes under the sprite
  T = CLo >> 3
  Bi = HJ + T
  if Bi >= 91 then Bi -= 91
  V = RingBits[Bi]
  T = CHi >> 3
  Bi = HJ + T
  if Bi >= 91 then Bi -= 91
  V = V | RingBits[Bi]
  if V = 0 then goto ht_nextrow
  ' dy + 7 = 50 + 8 HR - HY + 7
  T = HR << 3
  T += 57
  T -= HY
  Mi = T << 2
  if HMis = 0 then Mi += FrOff
  HC = CLo
ht_col:
  if HR = 20 then
    if HC >= 8 then goto ht_nextrow
  end if
  T = HC >> 3
  Bi = HJ + T
  if Bi >= 91 then Bi -= 91
  T = HC & 7
  V = RingBits[Bi] & Bit8[T]
  if V > 0 then
    ' dx + 7 = 24 + 8 HC - HX + 7
    W16 = HC << 3
    W16 += 31
    W16 -= HX
    Dxp = W16
    T = Dxp >> 3
    Off = Mi + T
    T = Dxp & 7
    if HMis = 0 then
      V = ChHit[Off] & Bit8[T]
    else
      V = MsHit[Off] & Bit8[T]
    end if
    if V > 0 then
      HHit = 1
      return
    end if
  end if
  inc HC
  if HC <= CHi then goto ht_col
ht_nextrow:
  inc HR
  if HR <= RHi then goto ht_row
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' C64 Y -> sprite row: CV pixel row = Y - 42 (C64 char row r is CV row r + 1)
sub SprY:
  ' in: Y16 = C64 Y + layer offset; out: T (HideY when off the screen)
  T = HideY
  if Y16 >= 43 then
    Y16 -= 43
    if Y16 < 192 then T = Y16
  end if
  return
end sub

sub DrawSprites:
  if XM = 0 then
    C = XMapA[XL]
  else
    C = XMapB[XL]
  end if
  ' missile: light red body, grey exhaust
  Y16 = My
  SprY
  set sprite 0 to T,C,SMr,9
  set sprite 1 to HideY,0,0,0
  Fo = Fr << 4
  Y16 = Cy + 1
  SprY
  K = SCw0 + Fo
  set sprite 2 to T,C,K,15
  Y16 = Cy + 4
  SprY
  K = SCb0 + Fo
  set sprite 3 to T,C,K,4
  Y16 = Cy + 1
  SprY
  K = SCg0 + Fo
  set sprite 4 to T,C,K,14
  Y16 = Cy + 17
  SprY
  K = SCh0 + Fo
  set sprite 5 to T,C,K,14
  update sprites
  return
end sub

' the ground: C64 rows 2-19 from RowTab (window J), row 20 from Row20Tab
sub DrawField:
  DrawFieldA
  DrawFieldB
  return
end sub

' top half (C64 rows 2-10): sets the row windows for the new phase
sub DrawFieldA:
  W16 = Ph * 5
  W16 = 455 - W16
  while W16 >= 91
    W16 -= 91
  end while
  J = W16
  Off = J * 28
  for Li = 2 to 10
    RowJ[Li] = J
    C = Li + 1
    put RowTab + Off count 28 at 2,C
    J += 5
    Off += 140
    if J >= 91 then
      J -= 91
      Off -= 2548
    end if
  next
  for Li = 11 to 20
    RowJ[Li] = J
    J += 5
    if J >= 91 then J -= 91
  next
  return
end sub

' bottom half (C64 rows 11-20), drawn one frame later
sub DrawFieldB:
  J = RowJ[11]
  Off = J * 28
  for Li = 11 to 19
    C = Li + 1
    put RowTab + Off count 28 at 2,C
    Off += 140
    if Off >= 2548 then Off -= 2548
  next
  J = RowJ[20]
  Off = J * 6
  put Row20Tab + Off count 6 at 2,21
  return
end sub

sub ShowHud:
  print at 2,1, "DISTANCE"
  NumU = Dist
  print at 11,1, str$(NumU)
  return
end sub

sub DrawPlay:
  NewScreen
  W16 = 0
  YellowDigits
  DrawField
  ShowHud
  ShowScreen
  DrawSprites
  return
end sub

' the original: noise burst, the sprite pointed at RAM garbage for a moment
sub Crash:
  State = StCrash
  stop sound SndChop
  play sound SndCrash
  for Ai = 0 to 59
    Rearm
    wait
    nmi off
    inc Tick
    T = Ai & 4
    K = SEx0
    if T > 0 then K = SEx1
    Y16 = Cy + 2
    SprY
    set sprite 2 to T,C,K,11
    set sprite 3 to T,C,K,8
    Y16 = Cy + 1
    SprY
    set sprite 4 to HideY,0,0,0
    set sprite 5 to HideY,0,0,0
    update sprites
  next
  return
end sub

sub GameOver:
  if Dist > MaxD then MaxD = Dist
  NewScreen
  W16 = 2048
  YellowDigits
  print at 9,4, "CHOPPER DOWN"
  print at 6,8, "DISTANCE"
  NumU = Dist
  print at 17,8, str$(NumU)
  print at 6,10, "MAX. DIST"
  NumU = MaxD
  print at 17,10, str$(NumU)
  print at 6,12, "SKILL"
  NumU = Skill
  print at 17,12, str$(NumU)
  fill TRule count 24 at 4,15
  print at 8,18, "PRESS THE BUTTON"
  ShowScreen
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker on
  for J = 0 to 5
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' the original prints the labels white and the numbers yellow ({5} / {158}):
' digits 0-9 in yellow on black in one screen third (in: W16 = 0 / 2048 / 4096)
sub YellowDigits:
  W16 += 384
  for Ai = 0 to 79
    vpoke vram.color + W16, $B1
    inc W16
  next
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub DrawHeli:
  ' the chopper picture (6 x 5 tiles) at column 13, row 2
  for Li = 0 to 4
    K = Li * 6
    K += THeli00
    T = Li + 2
    for J = 0 to 5
      C = J + 13
      put char K at C,T
      inc K
    next
  next
  return
end sub

sub TitlePage:
  State = StNext
  NewScreen
  DrawHeli
  put char TBall at 5,4
  put char TBall at 8,6
  put char TBall at 23,3
  put char TBall at 26,6
  print at 10,8, "CHOPPER RUN"
  print at 6,10, "BY HOWARD CAMPBELL"
  print at 11,13, "START"
  print at 11,15, "SKILL"
  print at 11,17, "HOW TO PLAY"
  print at 11,19, "CREDITS"
  print at 4,21, "0 = HARDEST  5 = EASIEST"
  Menu = 0
  ShowMenu
  ShowSkill
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Menu = 1 then
    K = Edge & 12
    if K > 0 then
      if K = 4 then
        if Skill > 0 then dec Skill
      else
        if Skill < 5 then inc Skill
      end if
      play sound SndClick
      ShowSkill
    end if
    if Press = 1 then
      inc Skill
      if Skill > 5 then Skill = 0
      play sound SndClick
      ShowSkill
      Press = 0
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

sub ShowSkill:
  NumU = Skill
  print at 18,15, str$(NumU)
  return
end sub

sub ShowMenu:
  put char 32 at 9,13
  put char 32 at 9,15
  put char 32 at 9,17
  put char 32 at 9,19
  C = Menu << 1
  C += 13
  put char 62 at 9,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StNext
  NewScreen
  print at 10,2, "CHOPPER RUN"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: three pages, pictures from the game's own sprites and tiles
sub HowTo:
  Page = 1
  State = StNext
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the chopper over a ball, the missile below it
  put char TBall at 14,13
  XL = 161
  XM = 0
  Fr = 0
  Cy = 114
  My = 160
  DrawSprites
  print at 8,22, "PRESS THE BUTTON"
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    State = StNext
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    print at 8,22, "PRESS THE BUTTON"
    State = StHow
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    State = StNext
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    print at 8,22, "PRESS THE BUTTON"
    State = StHow
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
