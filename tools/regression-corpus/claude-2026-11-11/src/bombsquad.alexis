cartridge "BOMB SQUAD/AUTHOR UNKNOWN/1991"
' BOMB SQUAD - ColecoVision port of the C64 game published on ReRUN
' (May/June 1991 disk; no author named in the program or the listing).
'
' The game (traced from the original's 6502 code, see README.md): a maze
' of 27 x 17 rooms (55 x 35 characters) is dug at random and seen through
' a scrolling window (cyan walls, green border, as on the C64, whose font
' is the ROM charset copied to $3800 with a few custom characters). Defuse (touch) all five
' bombs, then walk out through the exit before the clock (3:00) runs out.
' A charge, once picked up, lets you blow one wall: hold the button and
' push the stick against it. The level sets how much of the maze the
' window shows (NOVICE large .. MASTER small) and how fast it moves.
' SAME MAZE plays the last maze again (blown walls are rebuilt).
'
' Original's units: one pass of its main loop is a delay of ~41k C64
' cycles; a pass that moves also redraws the window (bigger on NOVICE).
' Port: a move-cooldown in 1/16 frames per level (Period), 41 for a pass
' that does not move; the clock is checked once per pass like the C64's
' jiffy test ($A2 >= 60).

const TFloor = 128
const TWall = 129
const TEdge = 130
const THero = 131
const TBomb = 132
const TCharge = 133
const TExitshut = 134
const TExitopen = 135
const TBoom = 136
const THudbomb = 137
const THuddone = 138
const THudcharge = 139
const THudnone = 140
const TRope = 141
const TSpark = 142
const TBlank = 143
const TFtop = 144
const TFbot = 145
const TFleft = 146
const TFright = 147
const TFtl = 148
const TFtr = 149
const TFbl = 150
const TFbr = 151
const SDummy = 0
const NTiles8 = 192
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayA = 5
const SndPlayB = 6
const SndPlayC = 7
const SndPlayD = 8
const SndClick = 9
const SndStep = 10
const SndTick = 11
const SndDefuse = 12
const SndPickup = 13
const SndBlast = 14
const SndBoom = 15
const SndWin = 16
const TuneFrames = 512
const PlayFrames = 1152
const TxtCredits = 0
const NSpr = 1
const HideY = 192
' maze: characters 0-54 x 0-34; rooms at odd x,y: 27 x 17
const MW = 55
const MH = 35
const CW = 27
const CH = 17
const NCell = 459
' objects: 0-4 bombs, 5-7 charges, 8 exit
const NObj = 9
const OExit = 8
const IdlePass = 41
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9

' the maze, 2 rooms a byte (a nibble each; see GenMaze): 230 bytes, not 459,
' so the OS7 stack has room below the variables
u8 Mz[230]
u16 Mi = 0
u8 Mb = 0
u8 ObX[9]
u8 ObY[9]
u8 ObOn[9]
u8 BlX[3]
u8 BlY[3]
u16 Best[4]
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Ci = 0
u16 Ni = 0
u16 Secs = 0
u8 TzOn = 0
u8 TzPlay = 0
u8 State = 0
u8 Level = 1
u8 Result = 0
u8 HaveMaze = 0
u8 SameMaze = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' play
u8 Px = 1
u8 Py = 1
u8 Camx = 0
u8 Camy = 0
u8 Vw = 28
u8 Vh = 20
u8 Vox = 13
u8 Voy = 9
u8 Wx0 = 2
u8 Wy0 = 3
u8 Period = 93
u8 Cool = 0
u8 Jif = 0
u8 Defused = 0
u8 Charges = 0
u8 Blown = 0
u8 Moved = 0
u8 Gx = 0
u8 Gy = 0
u8 Gd = 0
u8 Gn = 0
u8 Tx = 0
u8 Ty = 0
u8 Dx = 0
u8 Dy = 0
u8 Hit = 0
u8 Nx = 0
u8 RedrawRow = 99
u8 El = 0
u8 LastFr = 0
u8 RowBuf[28]
u8 OCx = 0
u8 OCy = 0
u16 VAddr = 0
u8 Ri = 0
u8 Ci2 = 0
u8 Erased = 0
u8 Ny = 0
u8 PutMode = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 Fire1 = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Sx = 0
u8 Sy = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 3 then
    HowTo
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Result = 0 then goto play_loop

  State = StOver
  StopPlayTune
  GameOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift: stepped every title frame, so each game is different
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random number from 0 to M - 1
function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

' the window for the level: width, height, where the hero sits in it
' (the C64 kept the hero 18/14/8/4 columns and 10/7/4/2 rows from the
' window's left/top edge before scrolling), and the move period in 1/16
' frames (C64: 41k delay cycles + the window redraw, at 16k NTSC cycles
' a frame: NOVICE 5.8 frames .. MASTER 3.7 frames)
sub SetLevel:
  if Level = 1 then
    Vw = 28
    Vh = 20
    Vox = 13
    Voy = 9
    Period = 93
  end if
  if Level = 2 then
    Vw = 28
    Vh = 17
    Vox = 13
    Voy = 7
    Period = 78
  end if
  if Level = 3 then
    Vw = 19
    Vh = 11
    Vox = 8
    Voy = 4
    Period = 66
  end if
  if Level = 4 then
    Vw = 10
    Vh = 6
    Vox = 4
    Voy = 2
    Period = 59
  end if
  T = 28 - Vw
  T = T >> 1
  Wx0 = T + 2
  T = 20 - Vh
  T = T >> 1
  Wy0 = T + 3
  return
end sub

' the room index of room (Gx, Gy) -> Ci
sub CellIndex:
  Ci = Gy
  Ci = Ci * 27
  Ci += Gx
  return
end sub

' dig the maze like the C64: start in the middle room (27,17 = room 13,8),
' try the four directions from a random one; dig two characters into an
' undug room, marking the way back; when stuck, walk back one room.
' Mz nibble of a room: 0 not dug yet, 1-4 the way back (dir + 1), 5 the start.
' Every passage is the way back of the room it led into, so "open east" and
' "open south" are worked out from the nibbles (EastOpen, SouthOpen).
sub GenMaze:
  for Ci = 0 to 229
    Mz[Ci] = 0
  next
  Gx = 13
  Gy = 8
  CellIndex
  Ni = Ci
  V = 5
  MzPut
gm_new:
  Rand
  W16 = Rs >> 3
  Gd = W16 & 3
  Gn = 0
gm_try:
  ' dir 0 right, 1 up, 2 left, 3 down (the C64's order)
  Tx = Gx
  Ty = Gy
  Hit = 0
  if Gd = 0 then
    if Gx < 26 then
      Tx = Gx + 1
      Hit = 1
    end if
  end if
  if Gd = 1 then
    if Gy > 0 then
      Ty = Gy - 1
      Hit = 1
    end if
  end if
  if Gd = 2 then
    if Gx > 0 then
      Tx = Gx - 1
      Hit = 1
    end if
  end if
  if Gd = 3 then
    if Gy < 16 then
      Ty = Gy + 1
      Hit = 1
    end if
  end if
  if Hit = 1 then
    Ni = Ty
    Ni = Ni * 27
    Ni += Tx
    MzGet
    if V = 0 then
      V = Gd + 1
      MzPut
      Gx = Tx
      Gy = Ty
      goto gm_new
    end if
  end if
  inc Gd
  Gd = Gd & 3
  inc Gn
  if Gn < 4 then goto gm_try
  ' stuck: back one room (opposite of the way we came in)
  CellIndex
  Ni = Ci
  MzGet
  if V = 5 then return
  dec V
  if V = 0 then dec Gx
  if V = 1 then inc Gy
  if V = 2 then inc Gx
  if V = 3 then dec Gy
  goto gm_new
end sub

' room Ni's nibble -> V
' (Mb before Mi: with Mi = Ni >> 1 first, 2e9 safe/balanced reuse the
' shifted HL as Ni for Ni & 1; see work/codex-bugs/repros/2e9-shift-reload*)
sub MzGet:
  Mb = Ni & 1
  Mi = Ni >> 1
  V = Mz[Mi]
  if Mb = 1 then V = V >> 4
  V = V & 15
  return
end sub

' room Ni's nibble = V (each room is written once, while still 0)
sub MzPut:
  Mb = Ni & 1
  Mi = Ni >> 1
  if Mb = 1 then V = V << 4
  Mz[Mi] = Mz[Mi] | V
  return
end sub

' V = 1 if room Ni is open east (Ni clobbered): it led east (way back 3),
' or the room east of it was entered from the west (way back 1)
sub EastOpen:
  MzGet
  if V = 3 then
    V = 1
    return
  end if
  inc Ni
  MzGet
  if V = 1 then return
  V = 0
  return
end sub

' V = 1 if room Ni is open south (Ni clobbered): it led south (way back 2),
' or the room below it was entered from above (way back 4)
sub SouthOpen:
  MzGet
  if V = 2 then
    V = 1
    return
  end if
  Ni += 27
  V = 0
  if Ni >= 459 then return
  MzGet
  if V = 4 then
    V = 1
    return
  end if
  V = 0
  return
end sub

' is character (Tx, Ty) a wall? Hit = 0 open, 1 wall, 2 border (cannot be blown)
sub WallAt:
  Hit = 2
  if Tx = 0 then return
  if Tx >= 54 then return
  if Ty = 0 then return
  if Ty >= 34 then return
  for J = 0 to 2
    if J < Blown then
      if BlX[J] = Tx then
        if BlY[J] = Ty then
          Hit = 0
          return
        end if
      end if
    end if
  next
  Hit = 1
  V = Tx & 1
  K = Ty & 1
  if V = 1 then
    if K = 1 then
      Hit = 0
      return
    end if
    ' x odd, y even: the south wall of room (x/2, y/2 - 1)
    Gx = Tx >> 1
    Gy = Ty >> 1
    dec Gy
    CellIndex
    Ni = Ci
    SouthOpen
    if V > 0 then Hit = 0
    return
  end if
  if K = 0 then return
  ' x even, y odd: the east wall of room (x/2 - 1, y/2)
  Gx = Tx >> 1
  dec Gx
  Gy = Ty >> 1
  CellIndex
  Ni = Ci
  EastOpen
  if V > 0 then Hit = 0
  return
end sub

' the exit: a random border character next to an open one (the C64 drew
' random addresses until one fitted)
sub PlaceExit:
pe_again:
  T = RandBelow(4)
  if T < 2 then
    Tx = RandBelow(53)
    inc Tx
    Ty = 1
    ObX[OExit] = Tx
    ObY[OExit] = 0
    if T = 1 then
      Ty = 33
      ObY[OExit] = 34
    end if
  else
    Ty = RandBelow(33)
    inc Ty
    Tx = 1
    ObX[OExit] = 0
    ObY[OExit] = Ty
    if T = 3 then
      Tx = 53
      ObX[OExit] = 54
    end if
  end if
  WallAt
  if Hit <> 0 then goto pe_again
  return
end sub

' the C64's fixed places: bombs at (13,9) (41,9) (27,17) (13,25) (41,25),
' charges at (13,17) (41,17) (27,25)
sub PlaceObjects:
  ObX[0] = 13
  ObY[0] = 9
  ObX[1] = 41
  ObY[1] = 9
  ObX[2] = 27
  ObY[2] = 17
  ObX[3] = 13
  ObY[3] = 25
  ObX[4] = 41
  ObY[4] = 25
  ObX[5] = 13
  ObY[5] = 17
  ObX[6] = 41
  ObY[6] = 17
  ObX[7] = 27
  ObY[7] = 25
  for J = 0 to 8
    ObOn[J] = 1
  next
  return
end sub

sub NewGame:
  StopTitleTune
  SetLevel
  if SameMaze = 0 then
    GenMaze
    PlaceExit
    HaveMaze = 1
  end if
  PlaceObjects
  RedrawRow = 99
  Blown = 0
  BuildMap
  Defused = 0
  Charges = 0
  Result = 0
  Px = 1
  Py = 1
  Secs = 180
  Jif = 0
  Cool = 0
  Camera
  DrawPlay
  T = frame
  LastFr = T
  State = StPlay
  StartPlayTune
  return
end sub

' the camera: hero Vox/Voy from the window's corner, kept inside the maze
sub Camera:
  Camx = 0
  if Px > Vox then Camx = Px - Vox
  T = MW - Vw
  if Camx > T then Camx = T
  Camy = 0
  if Py > Voy then Camy = Py - Voy
  T = MH - Vh
  if Camy > T then Camy = T
  return
end sub

' one frame of play
sub PlayStep:
  ' frames since the last pass (a window redraw can take more than one)
  T = frame
  El = T - LastFr
  LastFr = T
  ' a pass that comes back before a new frame (the wait can return at once
  ' after a long pass) does nothing
  if El = 0 then return
  if El > 8 then El = 8
  ' a scroll redraws the window half a window a frame (VRAM map rows; the
  ' whole window at once took 1.4 frames); the cooldown and the clock run on
  if RedrawRow < Vh then
    for Li = 0 to 9
      if RedrawRow < Vh then
        Ri = RedrawRow
        DrawRow
        inc RedrawRow
      end if
    next
    if RedrawRow >= Vh then
      RedrawRow = 99
      PutMode = 1
      PutAll
    end if
  end if
pe_frames:
  if Jif < 255 then inc Jif
  dec El
  if Cool >= 16 then
    Cool -= 16
    if El > 0 then goto pe_frames
    return
  end if
  ' frames left over after the cooldown ran out still count for the clock
  if Jif < 200 then Jif += El
  ' a pass of the C64 loop: the clock first (checked once per pass)
  if Jif >= 60 then
    Jif = 0
    dec Secs
    play sound SndTick
    ShowTime
    if Secs = 0 then
      Result = 2
      return
    end if
  end if
  ' no move while the window is still being redrawn
  if RedrawRow < Vh then return
  Moved = 0
  Dx = 0
  Dy = 0
  V = Jk & 1
  if V > 0 then Dy = 255
  V = Jk & 2
  if V > 0 then Dy = 1
  V = Jk & 4
  if V > 0 then Dx = 255
  V = Jk & 8
  if V > 0 then Dx = 1
  ' one direction at a time, as the C64 read only the four exact values
  T = Jk & 15
  if T = 1 then TryMove
  if T = 2 then TryMove
  if T = 4 then TryMove
  if T = 8 then TryMove
  if Moved = 1 then
    Cool += Period
  else
    Cool += IdlePass
  end if
  return
end sub

' the target character is (Px+Dx, Py+Dy); with the button held only a
' wall can be blown (needs a charge); without it walls stop you
sub TryMove:
  Tx = Px + Dx
  Ty = Py + Dy
  if Fire1 > 0 then
    if Charges = 0 then return
    WallAt
    if Hit <> 1 then return
    BlX[Blown] = Tx
    BlY[Blown] = Ty
    inc Blown
    MapFloor
    dec Charges
    play sound SndBlast
    DrawCharges
    GoThere
    return
  end if
  if Ty > 34 then return
  if Tx > 54 then return
  ' the exit opens once the five bombs are defused
  if Tx = ObX[OExit] then
    if Ty = ObY[OExit] then
      if Defused = 5 then
        GoThere
        Result = 1
      end if
      return
    end if
  end if
  WallAt
  if Hit <> 0 then return
  ' erase first, while a thing about to be picked up is still listed (a
  ' scroll on this move would otherwise leave its old tile behind)
  Nx = Tx
  Ny = Ty
  PutMode = 0
  PutAll
  Erased = 1
  Tx = Nx
  Ty = Ny
  for Li = 0 to 7
    if ObOn[Li] = 1 then
      if ObX[Li] = Tx then
        if ObY[Li] = Ty then
          ObOn[Li] = 0
          if Li < 5 then
            inc Defused
            play sound SndDefuse
            DrawBombs
          else
            inc Charges
            play sound SndPickup
            DrawCharges
          end if
        end if
      end if
    end if
  next
  GoThere
  return
end sub

sub GoThere:
  Nx = Tx
  Ny = Ty
  PutMode = 0
  if Erased = 0 then PutAll
  Erased = 0
  Px = Nx
  Py = Ny
  OCx = Camx
  OCy = Camy
  Camera
  if OCx <> Camx then
    RedrawRow = 0
  else
    if OCy <> Camy then
      RedrawRow = 0
    else
      PutMode = 1
      PutAll
    end if
  end if
  Moved = 1
  if Result = 0 then play sound SndStep
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' The maze as tiles (55 x 35 bytes) is built once per game into spare VRAM
' (the sprite pattern table after the one sprite, vram.spr_pat + 32); a
' window row is then one VRAM->RAM copy and one RAM->VRAM copy, so a whole
' scroll redraw fits in one frame (building it per character took 7).
const MapOff = 32

' maze row Ty, columns Tx .. Tx+27, into RowBuf (from the room bits)
sub RowBuild:
  K = Ty & 1
  Gy = Ty >> 1
  if K = 0 then dec Gy
  Ci = Gy
  Ci = Ci * 27
  for Ci2 = 0 to 27
    T = TEdge
    if Ty > 0 then
      if Ty < 34 then
        if Tx > 0 then
          if Tx < 54 then
            V = Tx & 1
            Gx = Tx >> 1
            if K = 1 then
              T = TFloor
              if V = 0 then
                dec Gx
                Ni = Ci + Gx
                EastOpen
                if V = 0 then T = TWall
              end if
            else
              T = TWall
              if V = 1 then
                Ni = Ci + Gx
                SouthOpen
                if V > 0 then T = TFloor
              end if
            end if
          end if
        end if
      end if
    end if
    RowBuf[Ci2] = T
    inc Tx
  next
  return
end sub

' the whole map, each row in two halves (28 + 27 characters)
sub BuildMap:
  for Ty = 0 to 34
    VAddr = Ty
    VAddr = VAddr * 55
    VAddr += MapOff
    Tx = 0
    RowBuild
    copy RowBuf count 28 to vram.spr_pat + VAddr
    VAddr += 28
    Tx = 28
    RowBuild
    copy RowBuf count 27 to vram.spr_pat + VAddr
  next
  return
end sub

' a blown wall (Tx, Ty) becomes floor in the VRAM map
sub MapFloor:
  VAddr = Ty
  VAddr = VAddr * 55
  VAddr += Tx
  VAddr += MapOff
  RowBuf[0] = TFloor
  copy RowBuf count 1 to vram.spr_pat + VAddr
  return
end sub

sub DrawRow:
  Ty = Camy + Ri
  VAddr = Ty
  VAddr = VAddr * 55
  VAddr += Camx
  VAddr += MapOff
  copy vram.spr_pat + VAddr count Vw to RowBuf
  VAddr = Wy0 + Ri
  VAddr = VAddr << 5
  VAddr += Wx0
  copy RowBuf count Vw to vram.name + VAddr
  return
end sub

sub DrawWindow:
  for Li = 0 to 19
    if Li < Vh then
      Ri = Li
      DrawRow
    end if
  next
  PutMode = 1
  PutAll
  return
end sub

' object Oi's (or the hero's, Oi = 9) place in the window -> Sx, Sy; Hit = 1 if visible
sub ObjScreen:
  Hit = 0
  if Oi = 9 then
    Tx = Px
    Ty = Py
  else
    Tx = ObX[Oi]
    Ty = ObY[Oi]
  end if
  if Tx < Camx then return
  if Ty < Camy then return
  Sx = Tx - Camx
  Sy = Ty - Camy
  if Sx >= Vw then return
  if Sy >= Vh then return
  Sx += Wx0
  Sy += Wy0
  Hit = 1
  return
end sub

' PutMode 0: floor over every visible thing, 1: draw them
sub PutAll:
  for Oi = 0 to 9
    if Oi = 9 then
      PutObj
    else
      if ObOn[Oi] = 1 then PutObj
    end if
  next
  return
end sub

sub PutObj:
  ObjScreen
  if Hit = 0 then return
  T = TFloor
  if PutMode = 1 then
    if Oi = 9 then
      T = THero
    else
      if Oi < 5 then
        T = TBomb
      else
        T = TCharge
        if Oi = 8 then
          T = TExitshut
          if Defused = 5 then T = TExitopen
        end if
      end if
    end if
  end if
  put char T at Sx,Sy
  return
end sub

' HUD, row 1: the C64's white bar (screen row 0, from a real-VICE dump):
' BOMB SQUAD, the charges in hand ($3C), the five bomb ticks ($3B, $3D when
' defused), TIME m:ss; black text on white (font colour $1F while playing)
sub ShowTime:
  print at 21,1, "TIME"
  W16 = Secs / 60
  NumU = W16
  print at 26,1, digits$(NumU, 1)
  print at 27,1, ":"
  W16 = W16 * 60
  NumU = Secs - W16
  print at 28,1, digits$(NumU, 2)
  return
end sub

sub DrawBombs:
  for J = 0 to 4
    C = J + 15
    T = THudbomb
    if J < Defused then T = THuddone
    put char T at C,1
  next
  return
end sub

sub DrawCharges:
  for J = 0 to 2
    C = J + 12
    T = THudnone
    if J < Charges then T = THudcharge
    put char T at C,1
  next
  return
end sub

' the play screen around the window: transparent (light-blue backdrop, the
' C64's border colour 14), the half-character light-blue frame ($EC $E2 $FB,
' $61 $E1, $FC $62 $FE) round the window, and the white bar on row 1
sub DrawFrame:
  backdrop light blue
  for J = 0 to 31
    RowBuf[J & 15] = TBlank
  next
  for J = 0 to 23
    VAddr = J
    VAddr = VAddr << 5
    copy RowBuf count 16 to vram.name + VAddr
    VAddr += 16
    copy RowBuf count 16 to vram.name + VAddr
  next
  ' black text on white for the bar (font chars 32..95)
  for J = 0 to 15
    RowBuf[J] = $1F
  next
  for J = 0 to 31
    VAddr = J
    VAddr = VAddr << 4
    VAddr += 256
    copy RowBuf count 16 to vram.color + VAddr
  next
  print at 2,1, "BOMB SQUAD                  "
  ' frame: only the parts inside the safe area (columns 2-29, rows 1-22);
  ' outside it the light-blue backdrop alone borders the NOVICE/AMATEUR
  ' window (their half-black frame halves would sit in the overscan)
  C = Wx0 - 1
  Sy = Wy0 - 1
  K = Wx0 + Vw
  V = Wy0 + Vh
  if C >= 2 then
    put char TFtl at C,Sy
    put char TFtr at K,Sy
    put char TFbl at C,V
    put char TFbr at K,V
  end if
  for J = 0 to 27
    if J < Vw then
      Sx = Wx0 + J
      put char TFtop at Sx,Sy
      if V <= 22 then put char TFbot at Sx,V
    end if
  next
  if C >= 2 then
    for J = 0 to 19
      if J < Vh then
        Sy = Wy0 + J
        put char TFleft at C,Sy
        put char TFright at K,Sy
      end if
    next
  end if
  return
end sub

sub ShowLevelName:
  if Level = 1 then print at Sx,Sy, "NOVICE "
  if Level = 2 then print at Sx,Sy, "AMATEUR"
  if Level = 3 then print at Sx,Sy, "EXPERT "
  if Level = 4 then print at Sx,Sy, "MASTER "
  return
end sub

sub DrawPlay:
  NewScreen
  DrawFrame
  ShowTime
  DrawBombs
  DrawCharges
  DrawWindow
  ShowScreen
  return
end sub

sub GameOver:
  if Result = 2 then
    ' time ran out: the C64 flashed the screen every colour; here a slow
    ' red pulse (2 Hz) with the blast
    Oi = 9
    ObjScreen
    if Hit = 1 then put char TBoom at Sx,Sy
    play sound SndBoom
    for Li = 0 to 7
      backdrop red
      Rearm
      wait 15 frames
      backdrop light blue
      Rearm
      wait 15 frames
    next
    NewScreen
    print at 12,5, "BOOM!"
    print at 6,8, "THE CLOCK RAN OUT."
    T = 5 - Defused
    print at 6,10, "BOMBS LEFT:"
    NumU = T
    print at 18,10, digits$(NumU, 1)
  else
    play sound SndWin
    NewScreen
    print at 8,5, "SQUAD SAFE!"
    print at 5,8, "ALL FIVE BOMBS DEFUSED"
    print at 5,10, "TIME LEFT"
    ShowTimeAt15
    ' best time per level: the most time left (the C64 kept it the same way)
    T = Level - 1
    if Secs > Best[T] then Best[T] = Secs
  end if
  Sx = 5
  Sy = 13
  print at 5,13, "LEVEL"
  Sx = 11
  ShowLevelName
  print at 5,15, "BEST TIME LEFT"
  T = Level - 1
  Secs = Best[T]
  W16 = Secs / 60
  NumU = W16
  print at 20,15, digits$(NumU, 1)
  print at 21,15, ":"
  W16 = W16 * 60
  NumU = Secs - W16
  print at 22,15, digits$(NumU, 2)
  print at 8,20, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

sub ShowTimeAt15:
  W16 = Secs / 60
  NumU = W16
  print at 15,10, digits$(NumU, 1)
  print at 16,10, ":"
  W16 = W16 * 60
  NumU = Secs - W16
  print at 17,10, digits$(NumU, 2)
  return
end sub

' ---------------------------------------------------------------------------
' music

sub StopTitleTune:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

' the quiet play tune loops (restarted when it ends)
sub StartPlayTune:
  play sound SndPlayA
  play sound SndPlayB
  play sound SndPlayC
  play sound SndPlayD
  TzLeft = PlayFrames
  TzPlay = 1
  return
end sub

sub StopPlayTune:
  stop sound SndPlayA
  stop sound SndPlayB
  stop sound SndPlayC
  stop sound SndPlayD
  mute all
  TzPlay = 0
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tunes' countdowns, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  if TzPlay = 1 then
    dec TzLeft
    if TzLeft = 0 then
      play sound SndPlayA
      play sound SndPlayB
      play sound SndPlayC
      play sound SndPlayD
      TzLeft = PlayFrames
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Fire1 = button held, Press = newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Fire1 = Btn
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to HideY,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: name, a lit fuse, the menu (cursor back on START), the tune once
sub TitlePage:
  NewScreen
  State = StTitle
  fill TRope count 14 at 7,3
  put char TSpark at 21,3
  put char TBomb at 6,3
  print at 11,5, "BOMB SQUAD"
  print at 4,7, "DEFUSE FIVE BOMBS IN 3:00"
  print at 11,10, "START"
  print at 11,12, "SAME MAZE"
  print at 11,14, "LEVEL"
  print at 11,16, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  print at 4,21, "PORT OF A RERUN C64 GAME"
  Menu = 0
  ShowMenu
  ShowLevel
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  ' left/right (or the button) on LEVEL changes the level
  K = Edge & 12
  if K > 0 then
    if Menu = 2 then
      if K = 4 then
        dec Level
        if Level = 0 then Level = 4
      else
        inc Level
        if Level > 4 then Level = 1
      end if
      play sound SndClick
      ShowLevel
    end if
  end if
  if Press = 0 then goto tp_loop
  if Menu = 2 then
    inc Level
    if Level > 4 then Level = 1
    play sound SndClick
    ShowLevel
    goto tp_loop
  end if
  SameMaze = 0
  if Menu = 1 then
    if HaveMaze = 1 then SameMaze = 1
  end if
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowLevel:
  Sx = 17
  Sy = 14
  ShowLevelName
  return
end sub

sub ShowMenu:
  put char 32 at 9,10
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  put char 32 at 9,18
  C = Menu << 1
  C += 10
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  State = StCredits
  print at 11,2, "BOMB SQUAD"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: three pages, pictures made of the game's own tiles
sub HowTo:
  NewScreen
  State = StHow
  Page = 1
  print at 8,1, "HOW TO PLAY  1/3"
  print at 2,3, "FIVE TIME BOMBS ARE HIDDEN"
  print at 2,5, "IN A MAZE. FIND AND TOUCH"
  print at 2,7, "EACH ONE TO DEFUSE IT."
  fill TWall count 12 at 10,9
  fill TWall count 12 at 10,11
  put char THero at 11,10
  put char TBomb at 15,10
  put char TBomb at 19,10
  put char TExitshut at 21,11
  print at 2,13, "THE WINDOW SHOWS PART OF"
  print at 2,15, "THE MAZE AND SCROLLS AS"
  print at 2,17, "YOU MOVE THROUGH IT."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    NewScreen
    Page = 2
    print at 8,1, "HOW TO PLAY  2/3"
    fill TFloor count 3 at 14,3
    put char TExitshut at 14,3
    put char TExitopen at 16,3
    print at 2,5, "WHEN ALL FIVE ARE DEFUSED"
    print at 2,7, "THE EXIT LIGHTS UP: WALK"
    print at 2,9, "OUT BEFORE THE CLOCK"
    print at 2,11, "(3:00) RUNS OUT."
    fill TFloor count 3 at 14,13
    put char TCharge at 15,13
    print at 2,15, "PICK UP A CHARGE, THEN HOLD"
    print at 2,17, "THE BUTTON AND PUSH THE"
    print at 2,19, "STICK TO BLOW ONE WALL."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    NewScreen
    Page = 3
    print at 8,1, "HOW TO PLAY  3/3"
    print at 2,3, "LEVEL ON THE TITLE SETS THE"
    print at 2,5, "WINDOW: NOVICE SEES A LOT,"
    print at 2,7, "MASTER ONLY A LITTLE."
    print at 2,10, "SAME MAZE PLAYS THE LAST"
    print at 2,12, "MAZE AGAIN, TO LEARN IT."
    print at 2,15, "THE MOST TIME LEFT IS"
    print at 2,17, "KEPT FOR EACH LEVEL."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

