cartridge "ALIEN STRIKE/AUTHOR UNKNOWN/1990"
' ALIEN STRIKE - ColecoVision port of the C-64 game from RUN magazine's
' ReRUN disk (March/April 1990; the author is not named in the files).
' Port in Amy by Claude (Anthropic), 2026, built on the Space Condors port.
'
' The game (from the original's 6502 code, orig/alien.dis): your ship moves
' left/right along the bottom (1 px per pass) and fires one slow shot at a
' time (1 px per pass). Five aliens start at the left edge, one above the
' other (Y $4C, $65, $7E, $97, $B0), all sliding right together; each one
' drops straight down when its X reaches its random target column, and
' starts again from the left edge once it reaches the bottom. A saucer
' wanders along the top. Any hit of the shot scores 20; a shot that touches
' exactly one alien sends it back (it drops down again at the left edge);
' the saucer scores 100 more, flies off the top, and every alien that
' starts again takes the next shape and colour. An alien that touches your
' ship costs one of 3 ships (the very first touch of a game is forgiven, as
' in the original). Endless: no waves, no speed-up.
'
' Units: the logic keeps the C-64's coordinates (sprite X/Y 0-255) and runs
' whole passes against a C-64 cycle budget per frame (a pass costs ~6,650
' cycles with the KERNAL interrupt, measured in real VICE NTSC: 2.56 passes per 60 Hz jiffy, c64/vrate.py; an NTSC frame is 17,045: ~2.56
' passes a frame). The random targets come from a frame counter (the
' original reads the jiffy clock $A2). Collisions: the VIC-II latches
' sprite collisions while it draws, once a frame: here they are computed
' once a frame (first pass) from boxes around each shape's pixels.

const TBar = 128
const TLife = 129
const TStar = 130
const SShipw = 0
const SShipg = 4
const SShot = 8
const SAlien0 = 12
const SAlien1 = 16
const SAlien2 = 20
const SAlien3 = 24
const SUfo = 28
const SUfog = 32
const SBoom0 = 36
const SBoom1 = 40
const SBoom2 = 44
const NTiles8 = 24
const SprBytes = 384
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayA = 5
const SndPlayB = 6
const SndPlayC = 7
const SndPlayD = 8
const SndClick = 9
const SndShot = 10
const SndBoom = 11
const SndUfo = 12
const SndDie = 13
const SndOver = 14
const TuneFrames = 512
const TxtCredits = 0
const PlayFrames = 640
const NSpr = 11
const HideY = 192
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9
' C-64 cycle budget per frame and per pass, in units of 10 cycles
const Budget = 1705
const PassCost = 665
const MaxPass = 3

' five aliens (the original's sprites 2-6)
u8 AX[5]
u8 AY[5]
u8 AT[5]
u8 AR[5]
u8 AD[5]
u8 AP[5]
u8 AC[5]
u16 Score = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Acc = 0
u16 PlayLeft = 0
u8 TzOn = 0
u8 State = 0
' the ship, the shot
u8 Px = 0
u8 Py = 0
u8 Sa = 0
u8 Sb = 0
u8 Sx = 0
u8 Sy = 0
u8 Ships = 0
u8 Armed = 0
u8 Ef = 0
u8 Ee = 0
' the saucer
u8 Ux = 0
u8 Uy = 0
u8 Udir = 0
u8 Uhit = 0
u8 Ec = 0
u8 NewPtr = 0
u8 Ptr = 0
u8 Col = 0
u8 Jiffy = 0
u8 Mask = 0
u8 CollNow = 0
u8 Passes = 0
u8 Over = 0
u8 HudOld = 0
u8 HudDirty = 0
' cosmetic burst where an alien was shot (does not touch the rules)
u8 Bx = 0
u8 By = 0
u8 Bt = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
u8 Qi = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 A = 0
u8 B = 0
u8 D = 0
u8 Ka = 0
u8 Kb = 0
u8 Hit = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 6
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  if Over = 0 then goto play_loop

  ' the last score and SHIP 0 stay on screen for a second
  for Oi = 1 to 60
    Frame1
    DrawSprites
  next
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (the original's main loop at $C21A, one call = one pass)

' $C000: a new game
sub NewGame:
  Score = 0
  Ships = 3
  Armed = 0
  Ef = 0
  Ee = 0
  Over = 0
  Bt = 0
  Acc = 0
  Px = $82
  Py = $FF
  Sa = 0
  Sb = 1
  Sy = $D2
  Sx = $82
  Ux = $FF
  Uy = $33
  Udir = 0
  Uhit = 0
  Ec = 0
  NewPtr = 0
  Ptr = 0
  Col = 2
  for Li = 0 to 4
    AX[Li] = 0
    AY[Li] = StartY[Li]
    AT[Li] = $FF
    AR[Li] = 0
    AD[Li] = 0
    AP[Li] = 0
    AC[Li] = 2
  next
  DrawPlay
  State = StPlay
  PlayTune
  return
end sub

sub PlayTune:
  play sound SndPlayA
  play sound SndPlayB
  play sound SndPlayC
  play sound SndPlayD
  PlayLeft = PlayFrames
  return
end sub

' one frame: whole passes while the C-64 cycle budget lasts; collisions
' are seen by the first pass only (the VIC-II latches them once a frame)
sub PlayFrame:
  inc Jiffy
  Acc += Budget
  Passes = 0
  CollNow = 1
pf_loop:
  if Acc >= PassCost then
    Acc -= PassCost
    OnePass
    CollNow = 0
    inc Passes
    if Over = 1 then goto pf_end
    if Passes < MaxPass then goto pf_loop
  end if
pf_end:
  ' the in-game tune loops
  dec PlayLeft
  if PlayLeft = 0 then PlayTune
  if Bt > 0 then dec Bt
  DrawSprites
  if HudOld <> Ships then ShowHud
  if HudDirty = 1 then ShowHud
  return
end sub

sub OnePass:
  ' $C227: the stick, compared as exact values (right, right+fire, left,
  ' left+fire; diagonals do nothing)
  V = Jk & 15
  if V = 8 then
    if Btn > 0 then Sb = 1
    if Px <> $FF then inc Px
  end if
  if V = 4 then
    if Btn > 0 then Sb = 1
    if Px <> $19 then dec Px
  end if
  ' $C29A: fire alone ($6F), launch, the shot 1 px per pass up to $2F
  if Sa = 0 then
    if V = 0 then
      if Btn > 0 then Sb = 1
    end if
    if Sb = 1 then
      Sx = Px
      Sa = 1
      play sound SndShot
    end if
  end if
  if Sa = 1 then
    dec Sy
    if Sy = $2F then ResetShot
  end if
  ' the ship appears when the game's first shot passes Y $D0
  if Sy = $D0 then Py = $E5
  MoveAliens
  ' $C504: the collision register
  Mask = 0
  if CollNow = 1 then Collide
  V = Mask & 2
  if V > 0 then
    ResetShot
    Score += 20
    HudDirty = 1
  end if
  V = Mask & 128
  if V > 0 then
    inc Col
    if Col = 8 then Col = 1
    Uhit = 1
    NewPtr = 1
    Score += 100
    play sound SndUfo
  end if
  for Li = 0 to 4
    V = Bit[Li] | 2
    if Mask = V then
      Bx = AX[Li]
      By = AY[Li]
      Bt = 18
      AX[Li] = 0
      AY[Li] = StartY[Li]
      AR[Li] = 1
      AD[Li] = 1
      play sound SndBoom
    end if
  next
  V = Mask & 1
  if V > 0 then
    if Armed = 1 then
      if Ef = 0 then play sound SndDie
      Ef = 1
    end if
    Armed = 1
  end if
  MoveUfo
  ' $C738: 80 passes after a touch, one ship less
  if Ef = 1 then
    inc Ee
    if Ee = 80 then
      Ee = 0
      Ef = 0
      dec Ships
      if Ships = 0 then Over = 1
    end if
  end if
  ' $C745: after a saucer hit, aliens that start again take the next shape
  if NewPtr = 1 then
    NewPtr = 0
    inc Ptr
    if Ptr = 4 then Ptr = 0
  end if
  return
end sub

' $C619
sub ResetShot:
  Sa = 0
  Sb = 0
  Sy = $E6
  return
end sub

' $C330: all aliens slide right until their target column, then all drop
sub MoveAliens:
  if AR[0] = 0 then
    if AT[0] = $FF then
      ' $C33E: the five targets from the clock, the 6502's carry chain
      W16 = Jiffy
      AT[0] = Jiffy
      W16 += $5B
      AT[1] = W16 & 255
      W16 = W16 >> 8
      W16 += AT[1]
      W16 += $64
      AT[2] = W16 & 255
      W16 = W16 >> 8
      W16 += AT[2]
      W16 += $C8
      AT[3] = W16 & 255
      W16 = W16 >> 8
      W16 += AT[3]
      W16 += $AA
      AT[4] = W16 & 255
    end if
  end if
  for Li = 0 to 4
    if AR[Li] = 0 then
      A = AX[Li] + 1
      AX[Li] = A
      if A = AT[Li] then
        AR[Li] = 1
        AD[Li] = 1
      end if
    end if
  next
  for Li = 0 to 4
    if AD[Li] = 1 then
      A = AY[Li] + 1
      AY[Li] = A
      if A = $FA then
        AX[Li] = 0
        AR[Li] = 0
        AD[Li] = 0
        AY[Li] = StartY[Li]
        AP[Li] = Ptr
        AC[Li] = Col
        if Li = 0 then AT[0] = $FF
      end if
    end if
  next
  return
end sub

' $C637: the saucer, 1 px every second pass, turning when its X meets the
' clock; after a hit it flies up from Y $33 to $0A, then starts at X 0
sub MoveUfo:
  inc Ec
  if Ec = 2 then
    Ec = 0
    if Udir = 0 then
      inc Ux
      if Ux = Jiffy then Udir = 1
    end if
    if Udir = 1 then
      dec Ux
      if Ux = Jiffy then Udir = 0
    end if
  end if
  if Uhit = 1 then
    dec Uy
    if Uy = $0A then
      Uhit = 0
      Udir = 0
      Ux = 0
      Uy = $33
    end if
  end if
  return
end sub

' the collision register from boxes (kinds: 0-3 alien shapes, 4 saucer,
' 5 shot, 6 ship top, 7 ship base). Bit 0 ship, 1 shot, 2-6 aliens, 7
' saucer. Pairs that cannot meet are skipped: aliens never reach the
' saucer's rows (Y >= $4C vs <= $46), the shot never reaches the ship's
' pixel rows; alien pairs matter only for "exactly one alien" when the
' shot hit something.
sub Collide:
  for Oi = 0 to 4
    Ka = AP[Oi]
    A = AX[Oi]
    B = AY[Oi]
    if Py = $E5 then
      Kb = 6
      C = Px
      D = Py
      Overlap
      if Hit = 0 then
        Kb = 7
        Overlap
      end if
      if Hit = 1 then Mask = Mask | 1 | Bit[Oi]
    end if
    if Sa = 1 then
      Kb = 5
      C = Sx
      D = Sy
      Overlap
      if Hit = 1 then Mask = Mask | 2 | Bit[Oi]
    end if
  next
  if Sa = 1 then
    Ka = 4
    A = Ux
    B = Uy
    Kb = 5
    C = Sx
    D = Sy
    Overlap
    if Hit = 1 then Mask = Mask | 130
  end if
  V = Mask & 2
  if V = 0 then return
  for Oi = 0 to 3
    T = Oi + 1
    for Qi = T to 4
      Ka = AP[Oi]
      A = AX[Oi]
      B = AY[Oi]
      D = AY[Qi]
      ' quick reject: rows more than 23 lines apart never overlap
      K = D - B
      K += 24
      if K < 48 then
        Kb = AP[Qi]
        C = AX[Qi]
        Overlap
        if Hit = 1 then Mask = Mask | Bit[Oi] | Bit[Qi]
      end if
    next
  next
  return
end sub

' boxes of kind Ka at (A,B) and kind Kb at (C,D) overlap: D-B+64 and
' C-A+64 inside the pair's ranges (tables from build.py). u8 maths: the
' difference is taken mod 256, so a wrapped difference (sprites more than
' 128 px apart) is refused by its sign (u8 compare of the coordinates).
sub Overlap:
  Hit = 0
  T = Ka << 3
  T += Kb
  V = D - B
  K = V + 64
  if K < OYlo[T] then return
  if K > OYhi[T] then return
  if D >= B then
    if V >= 128 then return
  else
    if V < 128 then return
  end if
  V = C - A
  K = V + 64
  if K < OXlo[T] then return
  if K > OXhi[T] then return
  if C >= A then
    if V >= 128 then return
  else
    if V < 128 then return
  end if
  Hit = 1
  return
end sub

' ---------------------------------------------------------------------------
' drawing: C-64 coordinates -> screen through XT / YT (0 = hidden)

sub DrawSprites:
  A = XT[Px]
  B = Py + 8
  B = YT[B]
  if B = 0 then A = 0
  if A = 0 then
    set sprite 0 to HideY,0,0,0
    set sprite 1 to HideY,0,0,0
  else
    if Ef = 1 then
      set sprite 0 to B,A,SShipw,8
      set sprite 1 to B,A,SShipg,6
    else
      set sprite 0 to B,A,SShipw,15
      set sprite 1 to B,A,SShipg,14
    end if
  end if
  ' the shot
  A = 0
  if Sa = 1 then
    A = XT[Sx]
    B = YT[Sy]
    if B = 0 then A = 0
  end if
  if A = 0 then
    set sprite 2 to HideY,0,0,0
  else
    set sprite 2 to B,A,SShot,8
  end if
  for Li = 0 to 4
    C = Li + 3
    A = AX[Li]
    A = XT[A]
    K = AP[Li]
    B = AY[Li] + Top[K]
    B = YT[B]
    T = K << 2
    T += SAlien0
    V = AC[Li]
    V = C64Col[V]
    if A = 0 then B = 0
    if B = 0 then
      set sprite C to HideY,0,0,0
    else
      set sprite C to B,A,T,V
    end if
  next
  ' the saucer (grey layer + colour layer)
  A = XT[Ux]
  B = YT[Uy]
  if B = 0 then A = 0
  if A = 0 then
    set sprite 8 to HideY,0,0,0
    set sprite 9 to HideY,0,0,0
  else
    V = 9
    if Uhit = 1 then V = 11
    set sprite 8 to B,A,SUfo,V
    set sprite 9 to B,A,SUfog,14
  end if
  ' cosmetic burst where an alien was hit (the original only makes a noise)
  if Bt > 0 then
    A = XT[Bx]
    B = By + 4
    B = YT[B]
    T = 18 - Bt
    T = T / 6
    T = T << 2
    T += SBoom0
    if A = 0 then B = 0
    if B = 0 then
      set sprite 10 to HideY,0,0,0
    else
      set sprite 10 to B,A,T,11
    end if
  else
    set sprite 10 to HideY,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  HudOld = Ships
  HudDirty = 0
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  ' lives as ship icons (HUD readability rule; the original: SHIP n)
  fill 32 count 5 at 23,1
  if Ships > 0 then
    for J = 1 to Ships
      K = J << 1
      K += 21
      put char TLife at K,1
    next
  end if
  return
end sub

sub DrawField:
  for Li = 1 to 22
    put char TBar at 29,Li
  next
  return
end sub

sub DrawPlay:
  NewScreen
  DrawField
  ShowHud
  ShowScreen
  DrawSprites
  return
end sub

sub GameOver:
  stop sound SndPlayA
  stop sound SndPlayB
  stop sound SndPlayC
  stop sound SndPlayD
  mute all
  HideSprites
  print at 10,9, "GAME OVER"
  print at 8,11, "SCORE"
  NumU = Score
  print at 14,11, digits$(NumU, 5)
  print at 8,13, "PRESS BUTTON"
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 10
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  ' text light blue on black, as the original's (C64 14 -> TMS 5)
  fill mode 2 text color with $51
  ' art packed with ZX0 (pack.mjs); unpacked with the display off
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: banner, name, menu (cursor back on START), the tune once
' the title: name, a picture from the game's sprites, menu (cursor back on
' START), the tune once
sub TitlePage:
  NewScreen
  DrawField
  print at 10,3, "ALIEN STRIKE"
  set sprite 8 to 34,40,SUfo,9
  set sprite 9 to 34,40,SUfog,14
  set sprite 3 to 50,180,SAlien0,6
  set sprite 4 to 62,100,SAlien2,7
  set sprite 5 to 74,150,SAlien1,13
  set sprite 0 to 82,120,SShipw,15
  set sprite 1 to 82,120,SShipg,14
  update sprites
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 4,19, "C-64 ORIGINAL: RUN, 1990"
  print at 7,21, "PORT IN AMY, 2026"
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  inc Jiffy
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,2, "ALIEN STRIKE"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

' HOW TO PLAY: two pages with pictures from the game's sprites
sub HowTo:
  Page = 1
  NewScreen
  print at 7,1, "HOW TO PLAY  1/2"
  print at 2,3, "ALIENS SLIDE IN FROM THE"
  print at 2,5, "LEFT, THEN EACH DROPS"
  print at 2,7, "STRAIGHT DOWN AT ITS OWN"
  print at 2,9, "SPOT. DON'T LET ONE HIT YOU."
  set sprite 3 to 92,60,SAlien0,6
  set sprite 4 to 92,170,SAlien0,6
  set sprite 0 to 112,116,SShipw,15
  set sprite 1 to 112,116,SShipg,14
  set sprite 2 to 100,116,SShot,8
  update sprites
  print at 2,17, "STICK: LEFT AND RIGHT."
  print at 2,19, "BUTTON: FIRE (HOLD IT)."
  print at 8,21, "PRESS THE BUTTON"
  State = StHow
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 7,1, "HOW TO PLAY  2/2"
    print at 2,3, "ANY HIT OF YOUR SHOT: 20."
    print at 2,5, "THE SAUCER: 100 MORE."
    set sprite 8 to 49,120,SUfo,9
    set sprite 9 to 49,120,SUfog,14
    print at 2,9, "AFTER A SAUCER HIT, NEW"
    print at 2,11, "ALIENS TAKE A NEW SHAPE."
    set sprite 3 to 102,40,SAlien0,6
    set sprite 4 to 102,90,SAlien1,7
    set sprite 5 to 102,140,SAlien2,13
    set sprite 6 to 102,190,SAlien3,3
    update sprites
    print at 2,15, "AN ALIEN THAT TOUCHES YOU"
    print at 2,17, "COSTS ONE OF YOUR 3 SHIPS."
    print at 2,19, "THEY NEVER STOP COMING!"
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

