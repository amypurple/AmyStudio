{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Amy",
  "scopeName": "source.amy",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#keywords" },
    { "include": "#hardware" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.apostrophe.amy", "match": "'.*$" }]
    },
    "strings": {
      "patterns": [{ "name": "string.quoted.double.amy", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.amy", "match": "\\\\." }] }]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.amy", "match": "\\$[0-9A-Fa-f]+" },
        { "name": "constant.numeric.decimal.amy", "match": "\\b\\d+(?:\\.\\d+)?\\b" }
      ]
    },
    "types": {
      "patterns": [{ "name": "storage.type.amy", "match": "\\b(?:u8|i8|u16|i16|u32|i32|fixed|ufixed|fixed32|bcd|fp5)\\b" }]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.amy", "match": "\\b(?:if|then|else|elseif|end if|for|to|step|next|while|end while|do|loop|until|select|case|end select|goto|gosub|return|exit|continue)\\b" },
        { "name": "keyword.declaration.amy", "match": "\\b(?:const|sub|function|record|end record|overlay|end overlay|scene|end scene|data|end data|include amy|include asm|asm|with|end with)\\b" },
        { "name": "keyword.operator.word.amy", "match": "\\b(?:and|or|not|mod|between|collides|contain)\\b" }
      ]
    },
    "hardware": {
      "patterns": [{ "name": "support.function.amy", "match": "\\b(?:joypad|keypad|spinner|vpoke|vpeek|random|play sound|play song|stop sound|screen on|screen off|nmi on|nmi off|tile screen|bitmap screen|text screen|copy|decompress|put char|get char|get frame|chars in box)\\b" }]
    }
  }
}
