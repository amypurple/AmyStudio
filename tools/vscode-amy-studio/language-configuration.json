{
  "comments": { "lineComment": "'" },
  "brackets": [["{", "}"], ["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"" }
  ],
  "surroundingPairs": [["{", "}"], ["(", ")"], ["[", "]"], ["\"", "\""]],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:sub|function|record|overlay|scene|if\\b.*then\\s*$|else(?:if)?\\b|for\\b|while\\b|do\\b|select\\b|case\\b|with\\b|asm\\s*\\{)",
    "decreaseIndentPattern": "^\\s*(?:end\\s+(?:sub|function|record|overlay|scene|if|while|select|with)|next\\b|loop\\b|else(?:if)?\\b|case\\b|})"
  }
}
