{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Amy Studio project",
  "type": "object",
  "required": ["entry"],
  "properties": {
    "name": { "type": "string", "description": "Human-readable project name." },
    "entry": { "type": "string", "description": "Main .alexis source, relative to this file." },
    "target": {
      "type": "string",
      "enum": ["colecovision-cartridge", "adam-native-program", "adam-disk", "adam-data-pack"]
    },
    "medium": { "type": "string", "enum": ["dsk", "ddp"] },
    "memoryProfile": { "type": "string" },
    "optimization": {
      "type": "string",
      "enum": ["off", "safe", "balanced", "aggressive", "experimental"]
    },
    "hardware": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "defines": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
