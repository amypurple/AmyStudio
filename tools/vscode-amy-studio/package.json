{
  "name": "amy-studio",
  "displayName": "Amy Studio",
  "description": "ColecoVision and ADAM development with the Amy language.",
  "version": "0.1.2",
  "publisher": "amypurple",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages", "Other"],
  "keywords": ["Amy", "ColecoVision", "Coleco ADAM", "Z80", "retro"],
  "activationEvents": [
    "onLanguage:amy",
    "workspaceContains:amy.project.json",
    "onCommand:amyStudio.compile"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "amy",
        "aliases": ["Amy", "amy"],
        "extensions": [".alexis", ".amy"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "amy",
        "scopeName": "source.amy",
        "path": "./syntaxes/amy.tmLanguage.json"
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "amy.project.json",
        "url": "./amy-project.schema.json"
      }
    ],
    "commands": [
      { "command": "amyStudio.createProject", "title": "Amy: Create Project" },
      { "command": "amyStudio.compile", "title": "Amy: Compile Project" },
      { "command": "amyStudio.compileOff", "title": "Amy: Compile Project (Optimization Off)" },
      { "command": "amyStudio.compileAggressive", "title": "Amy: Compile Project (Aggressive)" },
      { "command": "amyStudio.openGeneratedAsm", "title": "Amy: Open Generated Assembly" },
      { "command": "amyStudio.revealRom", "title": "Amy: Reveal Compiled ROM" }
    ],
    "menus": {
      "editor/title": [
        { "command": "amyStudio.compile", "when": "editorLangId == amy", "group": "navigation@1" }
      ],
      "explorer/context": [
        { "command": "amyStudio.compile", "when": "resourceExtname == .alexis || resourceFilename == amy.project.json", "group": "amy@1" }
      ]
    },
    "configuration": {
      "title": "Amy Studio",
      "properties": {
        "amyStudio.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to tools/amyc.mjs. Empty uses the bundled compiler, then an Amy Studio workspace checkout."
        },
        "amyStudio.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional Node.js executable. Empty uses the Node executable available in PATH."
        },
        "amyStudio.optimization": {
          "type": "string",
          "enum": ["off", "safe", "balanced", "aggressive", "experimental"],
          "default": "balanced",
          "description": "Default Amy optimization profile."
        },
        "amyStudio.compileOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Compile the active Amy project whenever an Amy source file is saved."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "amy",
        "owner": "amy",
        "fileLocation": ["absolute"],
        "pattern": {
          "regexp": "^(.*?):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "test": "node test/extension-model.test.mjs",
    "stage": "node scripts/stage-toolchain.mjs",
    "package": "npm run stage && npx @vscode/vsce package --allow-missing-repository --out dist/amy-studio-0.1.2.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.2"
  }
}
