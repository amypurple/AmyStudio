	.DB $51,$71,$F1,$41,$51,$71,$F1,$41
	.DB $51,$71,$F1,$41,$51,$71,$F1,$41
	.DB $51,$71,$F1,$41,$51,$71,$F1,$41
	.DB $51,$71,$F1,$41,$51,$71,$F1,$41
	.DB $B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1
	.DB $61,$61,$61,$61,$61,$61,$61,$61
	.DB $41,$41,$41,$41,$41,$41,$41,$41
	.DB $21,$21,$21,$21,$21,$21,$21,$21
	.DB $D1,$D1,$D1,$D1,$D1,$F1,$D1,$D1

MODE_2_REGISTERS:
	.DB %00000010,128+0  ; REG 0: MODE 2
	.DB %11000000,128+1  ; REG 1: MODE 2, 16K, NO INTERRUPTS, C0=8X8 C2=16X16 C1=ENLARGED C3=NORMAL
	.DB %00000110,128+2  ; REG 2: NAME TABLE 1800H
	.DB %11111111,128+3  ; REG 3: COLOR TABLE 2000H
	.DB %00000011,128+4  ; REG 4: PATTERN TABLE 0000H
	.DB %00110110,128+5  ; REG 5: SPRITE ATTRIBUTE TABLE 1B00H
	.DB %00000111,128+6  ; REG 6: SRITE PATTERN TABLE 3800H
	.DB %11110000,128+7  ; REG 7: BACKGROUND COLOR
	
TheEnd:
   jp TheEnd
   .end   

SET_LINES:              ; SET 3 LINES OF PATTERNS TO THE SCREEN IN THE MIDDLE $19  LD A WITH LINE ROW NUMBER AND STARTING COLUMN BEFORE CALLING. B = NUMBER OF PATTERNS
	OUT (CTRL_PORT), A
	LD A, $19
	OR $40
	OUT (CTRL_PORT), A
	LD B, $05           ; NUMBER OF TEXT PATTERNS
	LD C, DATA_PORT
	OTIR
    RET

SET_COLORS:             ; ALL COLORS START AT $2808
	LD A, $08
	OUT (CTRL_PORT), A
	LD A, $28
	OR $40
	OUT (CTRL_PORT), A

	LD B, $78           ; NUMBER OF PATTERNS (COLOR DATA) 15 PATTERNS * 8 LINES
	LD C, DATA_PORT
	OTIR

	LD B, $FF           ; START OF DELAY ROUTINE TO SLOW DOWN THE COLORS
	LD C, $5D           ; COLOR CYCLE SPEED 
SLOW_COLORS:
    DJNZ SLOW_COLORS
    DEC C
    JR NZ, SLOW_COLORS
    RET


SprAttrib:
    .db 60,50,0,15 ; Y=88 x=120 pattern#0, color=10
    .db 8,20,0,15 ; Y=88 x=120 pattern#0, color=10
    .db 88,120,0,15 ; Y=88 x=120 pattern#0, color=10

star:
    .db 00000000b 
    .db 00001000b 
    .db 00001100b 
    .db 00001110b 
    .db 00001111b 
    .db 11111111b 
    .db 00111111b 
    .db 00011111b 
    .db 00001111b 
    .db 00011111b 
    .db 00111111b 
    .db 11111111b 
	.db 00001111b 
	.db 00001110b 
	.db 00001100b 
	.db 00001000b 
		 
	.db 00000000b		     
