cartridge "CLAUDE SILENT/REGRESSION TEST/2026"

const LetterCount = 3
u16 RandomSeed = 1000
u8 ReturnModulo = 0
u8 ReturnSum = 0
u8 ReturnLiteral = 0

u8 SpriteJ = 1
u8 SpriteY = 100
u8 SpriteX = 60

i8 Squares[64]
u8 LookupX = 1
u8 LookupY = 7
u8 SignedCompare = 0

function ModuloNamed as u8
  return RandomSeed % 26 + LetterCount

function SumNamed as u8
  return RandomSeed + LetterCount

function ModuloLiteral as u8
  return RandomSeed % 26 + 3

function SquareAt(u8 X, u8 Y) as i8
  return Squares[X * 8 + Y]

  ReturnModulo = ModuloNamed
  ReturnSum = SumNamed
  ReturnLiteral = ModuloLiteral
  clear sprites
  set sprite 2 to SpriteY,SpriteX,0,13 - SpriteJ * 2
  Squares[15] = 1
  if SquareAt(LookupX, LookupY) = 1 then SignedCompare = 1

forever:
  wait
  goto forever
