project "CLAUDE FINAL OPEN REGRESSIONS"
memory "colecovision_legacy_sdcc"

const TBase = 16
data ExprTable bytes = TBase + 8, TBase + 9

i16 SignedValue = -300
i16 MinimumWord = -32768
i16 SignedLimit = 300
u16 WordValue = $1234
u8 AbsTrue = 0
u8 AbsFalse = 0
u8 AbsMinimum = 0
u8 LowResult = 0
u8 DataFirst = 0
u8 DataSecond = 0
u8 Done = 0

function LowPart(u16 Value) as u8
  return lowbyte(Value)

sub start:
  nmi off
  if abs(SignedValue) <= SignedLimit then AbsTrue = 1
  if abs(SignedValue) < 300 then AbsFalse = 1
  if abs(MinimumWord) > SignedLimit then AbsMinimum = 1
  LowResult = LowPart(WordValue)
  DataFirst = ExprTable[0]
  DataSecond = ExprTable[1]
  Done = 1
  loop forever
end sub
