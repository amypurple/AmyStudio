cartridge "CLAUDE NOV EXPR/REGRESSION TEST/2026"

i16 Product = 3
u8 CloudX = 16
i8 CloudDirection = 1
u8 Index = 0
u16 WordA = $F0F0
u16 WordB = $0FF0
u16 WordAnd = 0
u16 WordXor = 0

  Product = Product * -6
  for Index = 1 to 4
    if Index > 0 then bounce CloudX by CloudDirection between 16 and 196
  next
  WordAnd = WordA and WordB
  WordXor = WordA xor WordB

forever:
  wait
  goto forever
