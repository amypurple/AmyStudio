cartridge "FOR LIMIT SLOT/AMY/2026"
u8 State = 0
u8 N = 2
u8 I = 0

  mode 2 screen
  screen on
  ShowIt
  State = 2
main_loop:
  wait
  goto main_loop

sub NewScr:
  display off
  load default ascii
  return
end sub

sub ShowIt:
  NewScr
  for I = 0 to N - 1
    put char 65 + I at 2,I
  next
  State = 1
  return
end sub
