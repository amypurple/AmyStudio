+
+void Audio::SetOutputProfile(int profile)
+{
+    int selected = CLAMP(profile, static_cast<int>(OutputProfile_Accurate),
+        static_cast<int>(OutputProfile_ColecoTV));
+    if (selected != m_outputProfile)
+    {
+        m_outputProfile = selected;
+        ResetOutputFilter();
+    }
+}
+
+int Audio::GetOutputProfile() const
+{
+    return m_outputProfile;
+}
+
+void Audio::ResetOutputFilter()
+{
+    for (int channel = 0; channel < 2; ++channel)
+    {
+        m_tvPreviousInput[channel] = 0;
+        m_tvHighPass[channel] = 0;
+        m_tvLowPass1[channel] = 0;
+        m_tvLowPass2[channel] = 0;
+    }
+}
+
+void Audio::ApplyOutputProfile(s16* pSampleBuffer, int sampleCount)
+{
+    if (m_outputProfile != OutputProfile_ColecoTV || !IsValidPointer(pSampleBuffer))
+        return;
+
+    // Fixed-point AC coupling and two-pole speaker roll-off. The response follows
+    // the broad bandwidth of ADAMEm's ColecoVision hardware-sampled sound banks
+    // without embedding or redistributing those historical samples.
+    const s32 highPassCoefficient = 32351; // 90 Hz at 44.1 kHz, Q15
+    const s32 lowPassCoefficient = 18839;  // 6 kHz at 44.1 kHz, Q15
+
+    for (int index = 0; index < sampleCount; ++index)
+    {
+        int channel = index & 1;
+        s32 input = pSampleBuffer[index];
+        s32 highPass = input - m_tvPreviousInput[channel] +
+            static_cast<s32>((static_cast<s64>(highPassCoefficient) * m_tvHighPass[channel]) >> 15);
+        m_tvPreviousInput[channel] = input;
+        m_tvHighPass[channel] = highPass;
+
+        m_tvLowPass1[channel] += static_cast<s32>(
+            (static_cast<s64>(lowPassCoefficient) * (highPass - m_tvLowPass1[channel])) >> 15);
+        m_tvLowPass2[channel] += static_cast<s32>(
+            (static_cast<s64>(lowPassCoefficient) * (m_tvLowPass1[channel] - m_tvLowPass2[channel])) >> 15);
+
+        pSampleBuffer[index] = static_cast<s16>(CLAMP(m_tvLowPass2[channel], -32768, 32767));
+    }
 }
 
