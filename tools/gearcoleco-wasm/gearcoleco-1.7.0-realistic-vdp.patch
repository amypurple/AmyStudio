+void TMS9918A::SetAccurateVramTiming(bool enabled)
+{
+    m_bAccurateVramTiming = enabled;
+    m_bPendingVramAccess = false;
+    m_iPendingVramCycles = 0;
+    m_iDroppedVramAccesses = 0;
+}
+
+bool TMS9918A::GetAccurateVramTiming() const
+{
+    return m_bAccurateVramTiming;
+}
+
+u32 TMS9918A::GetDroppedVramAccessCount() const
+{
+    return m_iDroppedVramAccesses;
+}
+
+void TMS9918A::QueueVramAccess(bool read, u8 data)
+{
+    // The TMS99x8 has one pending VRAM request. A new request arriving before
+    // the next free slot replaces the old one; the address advances only when
+    // the surviving request executes.
+    if (m_bPendingVramAccess)
+        m_iDroppedVramAccesses++;
+    m_bPendingVramAccess = true;
+    m_bPendingVramRead = read;
+    m_PendingVramData = data;
+    m_iPendingVramCycles = VramAccessWaitCycles();
+}
+
+void TMS9918A::AdvancePendingVramAccess(unsigned int clockCycles)
+{
+    if (!m_bAccurateVramTiming || !m_bPendingVramAccess)
+        return;
+    m_iPendingVramCycles -= static_cast<int>(clockCycles);
+    if (m_iPendingVramCycles <= 0)
+        ExecutePendingVramAccess();
+}
+
+void TMS9918A::ExecutePendingVramAccess()
+{
+    const u16 address = m_VdpAddress & 0x3FFF;
+    if (m_bPendingVramRead)
+        m_VdpBuffer = m_pVdpVRAM[address];
+    else
+        m_pVdpVRAM[address] = m_PendingVramData;
+#if !defined(GEARCOLECO_DISABLE_DISASSEMBLER)
+    m_pProcessor->CheckMemoryBreakpoints(Processor::GC_BREAKPOINT_TYPE_VRAM, address, m_bPendingVramRead);
+#endif
+    m_VdpAddress = (address + 1) & 0x3FFF;
+    m_bPendingVramAccess = false;
+    m_iPendingVramCycles = 0;
+}
+
+int TMS9918A::VramAccessWaitCycles() const
+{
+    // Slot positions are TMS99x8 ticks (6 ticks per Z80 T-state). These
+    // measured tables are shared with the independent Claude/openMSX checker.
+    static const short off[] = {4,12,20,28,36,44,52,60,68,76,84,92,100,108,116,124,132,140,148,156,164,172,180,188,196,204,220,236,252,268,284,300,316,332,348,364,380,396,412,428,444,460,476,492,508,524,540,556,572,588,604,620,636,652,668,684,700,716,732,748,764,780,796,812,828,844,860,876,892,908,924,940,956,972,988,1004,1020,1036,1052,1068,1084,1100,1116,1132,1148,1164,1180,1196,1212,1228,1236,1244,1252,1260,1268,1276,1284,1292,1300,1308,1316,1324,1332,1340,1348,1356,1364};
+    static const short g12[] = {4,12,20,28,116,124,132,140,220,348,476,604,732,860,988,1116,1236,1244,1364};
+    static const short g3[] = {4,12,20,28,116,124,132,140,220,228,260,292,324,348,356,388,420,452,476,484,516,548,580,604,612,644,676,708,732,740,772,804,836,860,868,900,932,964,988,996,1028,1060,1092,1116,1124,1156,1188,1220,1236,1244,1364};
+    static const short text[] = {4,12,20,28,36,44,52,60,68,76,84,92,100,108,116,124,132,140,148,156,164,172,180,188,196,204,212,220,228,244,268,292,316,340,364,388,412,436,460,484,508,532,556,580,604,628,652,676,700,724,748,772,796,820,844,868,892,916,940,964,988,1012,1036,1060,1084,1108,1132,1156,1180,1196,1204,1212,1220,1228,1236,1244,1252,1260,1268,1276,1284,1292,1300,1308,1316,1324,1332,1340,1348,1356,1364};
+    const short* slots = off;
+    size_t count = sizeof(off) / sizeof(off[0]);
+    const bool active = m_bDisplayEnabled && m_iRenderLine < GC_RESOLUTION_HEIGHT;
+    if (active && (m_VdpRegister[1] & 0x10)) { slots = text; count = sizeof(text) / sizeof(text[0]); }
+    else if (active && (m_VdpRegister[1] & 0x08)) { slots = g3; count = sizeof(g3) / sizeof(g3[0]); }
+    else if (active) { slots = g12; count = sizeof(g12) / sizeof(g12[0]); }
+    // GearColeco raises F at CPU cycle 220 on line 192; the measured TMS slot
+    // tables place the same event at tick 202. The 250-tick phase aligns both
+    // beam origins: (220 * 6 + 250) mod 1368 == 202.
+    const int tick = (m_iCycleCounter * 6 + 250) % 1368;
+    const int earliest = tick + 28;
+    int slot = -1;
+    for (size_t i = 0; i < count; ++i)
+        if (slots[i] >= earliest) { slot = slots[i]; break; }
+    if (slot < 0)
+        slot = slots[0] + 1368;
+    return (slot - tick + 5) / 6;
+}
