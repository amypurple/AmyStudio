+}
+
+u16 Processor::GetStackWatermarkMinimum() const
+{
+    return m_stack_watermark_minimum;
+}
+
+void Processor::SampleStackWatermark()
+{
+    if (!m_stack_watermark_active)
+        return;
+    const u16 current = SP.GetValue();
+    if (current < m_stack_watermark_minimum)
+        m_stack_watermark_minimum = current;
+}
