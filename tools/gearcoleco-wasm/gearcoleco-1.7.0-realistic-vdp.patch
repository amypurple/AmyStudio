+void Processor::BeginStackWatermark()
+{
+    m_stack_watermark_active = true;
+    m_stack_watermark_start = SP.GetValue();
+    m_stack_watermark_minimum = m_stack_watermark_start;
+}
+
+void Processor::EndStackWatermark()
+{
+    m_stack_watermark_active = false;
+}
