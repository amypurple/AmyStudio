project "Amy State Update Benchmark"
memory "colecovision_legacy_sdcc"

const ActorCount = 6
const TickCount = 48

const ActorPatrol = 0
const ActorChase = 1
const ActorCooldown = 2

record ActorState:
  u8 X
  u8 Y
  u8 Direction
  u8 Timer
  u8 Mode
  u8 Hits
end record

state machine WorldBehavior:
  Running calls UpdateActors
  Bonus calls UpdateBonus
end state machine

ActorState Actors[ActorCount]
u8 WorldMode = WorldBehavior.Running
u8 PlayerX = 88
u8 PlayerY = 80
u8 Tick = 0
u8 ActorIndex = 0
u8 CollisionCount = 0
u16 Score = 0
u16 Checksum = 0

text screen
print centered at 3, "STATE UPDATE BENCHMARK"
print at 5,6, "ACTORS"
print ActorCount at 14,6 digits 2
print at 5,8, "RUNNING..."
screen on

for ActorIndex = 0 to ActorCount - 1
  Actors[ActorIndex].X = 24 + ActorIndex * 24
  Actors[ActorIndex].Y = 48 + ActorIndex * 8
  Actors[ActorIndex].Direction = ActorIndex & 1
  Actors[ActorIndex].Timer = 3 + ActorIndex
  Actors[ActorIndex].Mode = ActorPatrol
  Actors[ActorIndex].Hits = 0
next

for Tick = 0 to TickCount - 1
  asm {
    push af
    ld a,$CA
    xor $FE
    xor $FE
    cp $CA
    pop af
  }
  dispatch WorldMode using WorldBehavior
  asm {
    push af
    ld a,$BE
    xor $EF
    xor $EF
    cp $BE
    pop af
  }
next

for ActorIndex = 0 to ActorCount - 1
  Checksum += Actors[ActorIndex].X
  Checksum += Actors[ActorIndex].Y
  Checksum += Actors[ActorIndex].Timer
  Checksum += Actors[ActorIndex].Mode
  Checksum += Actors[ActorIndex].Hits
next
Checksum += Score
Checksum += CollisionCount

print at 5,8, "DONE      "
print at 5,10, "SCORE"
print Score at 14,10 digits 5
print at 5,12, "CHECK"
print Checksum at 14,12 digits 5

StateUpdateDone:
loop forever

sub UpdateActors:
  for each Actor, ActorIndex in Actors
    if Actor.Mode = ActorPatrol then
      if Actor.Direction = 0 then
        Actor.X += 1
        if Actor.X >= 208 then Actor.Direction = 1
      else
        Actor.X -= 1
        if Actor.X <= 16 then Actor.Direction = 0
      end if
    elseif Actor.Mode = ActorChase then
      if Actor.X < PlayerX then
        Actor.X += 2
      elseif Actor.X > PlayerX then
        Actor.X -= 2
      end if
      if Actor.Y < PlayerY then Actor.Y += 1
      if Actor.Y > PlayerY then Actor.Y -= 1
    else
      if Actor.Timer = 0 then
        Actor.Mode = ActorPatrol
        Actor.Timer = 5 + ActorIndex
      end if
    end if

    if Actor.Timer > 0 then Actor.Timer -= 1
    if Actor.Timer = 0 and Actor.Mode = ActorPatrol then
      Actor.Mode = ActorChase
      Actor.Timer = 8
    elseif Actor.Timer = 0 and Actor.Mode = ActorChase then
      Actor.Mode = ActorCooldown
      Actor.Timer = 4
    end if

    if Actor.Mode <> ActorCooldown then
      if box PlayerX,PlayerY size 12,12 collides with box Actor.X,Actor.Y size 8,8 then
        Actor.Hits += 1
        CollisionCount += 1
        Score += 25
        Actor.Mode = ActorCooldown
        Actor.Timer = 6
      end if
    end if
  next Actor

  if Tick = 23 then WorldMode = WorldBehavior.Bonus
  return
end sub

sub UpdateBonus:
  Score += 100
  PlayerX += 4
  WorldMode = WorldBehavior.Running
  return
end sub
