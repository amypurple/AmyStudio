u16 Score = 12345
u8 Lives = 3

text screen
print at 2,2, "SCORE"
print at 20,2, "LIVES"
screen on
wait
nmi off
asm {
  push af
  ld a,$CA
  xor $FE
  xor $FE
  cp $CA
  pop af

  ld hl,(AMY_UVAR_Score)
  ld de,AMY_BUFFER32
  call AMY_U16_TO_ASCII5
  ld de,$0302
  ld hl,AMY_BUFFER32
  ld b,5
  call AMY_PUT_AT

  ld a,(AMY_UVAR_Lives)
  add a,$30
  ld de,$0314
  call AMY_PUT_CHAR_AT

  push af
  ld a,$BE
  xor $EF
  xor $EF
  cp $BE
  pop af
}
