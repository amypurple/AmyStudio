record SignedState:
  i16 Value
end record

SignedState State
i16 Delta = 1

text screen
screen on
State.Value = -100
wait
nmi off
asm {
  push af
  ld a,$CA
  xor $FE
  xor $FE
  cp $CA
  pop af
}
print State.Value at 5,8 digits 3
print State.Value + Delta at 5,9 digits 3
asm {
  push af
  ld a,$BE
  xor $EF
  xor $EF
  cp $BE
  pop af
}
