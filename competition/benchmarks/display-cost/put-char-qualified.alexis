record CursorState:
  u8 Column
  u8 Row
  u8 Tile
end record

CursorState Cursor

text screen
Cursor.Column = 5
Cursor.Row = 8
Cursor.Tile = $41
screen on
wait
nmi off
asm {
  push af
  ld a,$CA
  xor $FE
  xor $FE
  cp $CA
  pop af
}
put char Cursor.Tile at Cursor.Column,Cursor.Row
asm {
  push af
  ld a,$BE
  xor $EF
  xor $EF
  cp $BE
  pop af
}
