project "Fly Swatter Timer Quest"
cartridge "FLY SWATTER/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' Three timer roles: movement cadence, round clock, and boss phases.
timer FlyStep every 8 ticks stopped
timer RoundSecond every 60 ticks stopped
timer BossPhase after 24 ticks stopped
timer BossStep every 4 ticks stopped
timer SwatterLock after 15 ticks stopped

' VBlank timers keep movement, round time, and attack phases independent.

const FlyFlying = 1
const FlySplat = 2
const FlyDefeated = 3
const BossSleeping = 1
const BossHunting = 2
const BossCharging = 3
const BossRecovering = 4
const BossDefeated = 5

record Actor:
  u8 X
  u8 Y
  i8 DX
  i8 DY
  u8 State
end record

Actor Swatter
Actor Flies[4]
Actor BigFly
u8 ActiveFly = 0
u8 Level = 1
u8 PendingStage = 0
u8 FliesLeft = 3
u8 EnemiesLeft = 17
u8 BossHealth = 0
u8 BossActive = 0
u8 FireWasDown = 0
u8 SwatterLocked = 0
u8 RoundTime = 30
u8 WingFrame = 0
u8 FlyColor = 10
u8 LevelOffset = 0
u8 SplatTicks[4]
u8 BossOldX = 13, BossOldY = 8, BossPixelX = 104, BossPixelY = 64
u16 Score = 0

hitbox SwatterHit = 2,2 size 12,12
hitbox FlyHit = 2,2 size 12,12

data SwatterSprite sprite16
  "......XXXX......"
  "....XXXXXXXX...."
  "...XX......XX..."
  "..XX.X.X.X..XX.."
  "..X.X.X.X.X..X.."
  ".XX..X.X.X.X.XX."
  ".X..X.X.X.X.X.X."
  ".XX..X.X.X.X.XX."
  "..X.X.X.X.X..X.."
  "..XX.X.X.X..XX.."
  "...XX......XX..."
  "....XXXXXXXX...."
  "......XXXX......"
  ".......XX......."
  ".......XX......."
  ".......XX......."
end data

data FlySprite sprite16
  "XXX...X..X...XXX"
  ".XXX.XXXXXX.XXX."
  "..XXX.XXXX.XXX.."
  "....XXXXXXXX...."
  "..XX..XXXX..XX.."
  ".XX..XXXXXX..XX."
  "XX....XXXX....XX"
  "......XXXX......"
  "......XXXX......"
  ".......XX......."
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
end data

data FlySpriteB sprite16
  "......X..X......"
  ".....XXXXXX....."
  "......XXXX......"
  "....X.XXXX.X...."
  ".XXX..XXXX..XXX."
  "XXX..XXXXXX..XXX"
  "XX....XXXX....XX"
  "X.....XXXX.....X"
  "......XXXX......"
  ".......XX......."
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
end data

data FlySplatSprite sprite16
  "................"
  ".....X...X......"
  "..X.XXX.XXX..X.."
  "....XXXXXXXX...."
  "..XXXXXXXXXXX..."
  ".XXXXXXXXXXXXX.."
  "XXXXXXXXXXXXXXX."
  ".XXXXXXXXXXXXXXX"
  "XXXXXXXXXXXXXX.."
  ".XXXXXXXXXXXXX.."
  "..XXXXXXXXXXX..."
  "....XXXXXXX.X..."
  "..X..XXXXX......"
  ".....X..X..X...."
  "................"
  "................"
end data

data FlySplatSpriteB sprite16
  "..X.......X....."
  "................"
  ".X...XX.XX....X."
  "...XXXXXXXXX...."
  ".XXXXXXXXXXXX..."
  "XXXXXXXXXXXXXXX."
  "XXXXXXXXXXXXXXXX"
  "XXXXXXXXXXXXXXXX"
  "XXXXXXXXXXXXXXXX"
  "XXXXXXXXXXXXXXX."
  ".XXXXXXXXXXXXX.."
  "...XXXXXXXXX...."
  ".X....XXXX....X."
  "..............X."
  "....X.....X....."
  "................"
end data

data BossTileFrame bytes = $20,$20,$6F,$20,$6F,$20,$20,$2F,$3C,$23,$23,$23,$3E,$5C,$20,$2F,$20,$76,$20,$5C,$20

data BossTileFrameB bytes = $5C,$20,$6F,$20,$6F,$20,$2F,$20,$3C,$23,$23,$23,$3E,$20,$2F,$20,$20,$5E,$20,$20,$5C
data BossDeadFrame bytes = $20,$20,$58,$20,$58,$20,$20,$3C,$3C,$23,$23,$23,$3E,$3E,$20,$5C,$5F,$5F,$5F,$2F,$20

data BossBlankFrame bytes = $20 count 21

data LevelColors bytes = 10,6,14,7,9
data LevelFlyCounts bytes = 2,3,3,4,4
data BossNextStates bytes = BossHunting,BossCharging,BossRecovering,BossHunting
data LevelOffsets bytes = 0,20,40,60,80
data LevelMessageOffsets bytes = 0,25,50,75,100

' Every row is 25 tiles; embedded spaces preserve compile-time centering.
data LevelMessages chars
  "   LEVEL 1 - TWO FLIES   "
  "  LEVEL 2 - THREE FLIES  "
  "  LEVEL 3 - FAST FLIES   "
  "  LEVEL 4 - FOUR FLIES   "
  "LEVEL 5 - FOUR FLY FRENZY"
end data

data LevelFlies records Actor
  48,56,5,3,FlyFlying
  192,104,-4,5,FlyFlying
  120,136,3,-5,FlyDefeated
  16,32,0,0,FlyDefeated

  40,48,6,5,FlyFlying
  200,88,-6,4,FlyFlying
  120,144,5,-6,FlyFlying
  16,32,0,0,FlyDefeated

  32,40,7,6,FlyFlying
  208,96,-7,5,FlyFlying
  112,152,6,-7,FlyFlying
  16,32,0,0,FlyDefeated

  28,44,9,8,FlyFlying
  216,92,-9,8,FlyFlying
  112,148,8,-9,FlyFlying
  196,68,-8,-10,FlyFlying

  24,36,11,10,FlyFlying
  220,100,-11,10,FlyFlying
  104,150,10,-11,FlyFlying
  196,68,-10,-12,FlyFlying
end data

sub start:
  tile screen
  backdrop dark blue
  sprites 16x16
  sprites simple
  copy SwatterSprite to vram.spr_pat
  copy FlySprite to vram.spr_pat + 32
  copy FlySpriteB to vram.spr_pat + 64
  copy FlySplatSprite to vram.spr_pat + 96
  copy FlySplatSpriteB to vram.spr_pat + 128
  set sound table FlySoundTable areas 6
  clear sprites
  set sprite count 5
  screen on
  goto TitleScreen

sub TitleScreen:
  mute all
  cls
  print centered at 3, "FLY SWATTER"
  print centered at 5, "TIMER QUEST"
  print centered at 9, "MOVE THE SWATTER"
  print centered at 10, "FIRE TO SWAT"
  print centered at 13, "FIVE WAVES THEN THE BOSS"
  print centered at 17, "TIMERS DRIVE EVERY PHASE"
  print centered at 21, "PRESS FIRE"
  pause until press and release blank after 10 seconds
  NewGame
  goto GameLoop

sub NewGame:
  cls
  print at 1,0, "TIME"
  print at 12,0, "FLIES"
  print at 22,0, "SCORE"
  print at 1,1, "LEVEL"
  Swatter.X = 120
  Swatter.Y = 152
  BigFly.X = 13
  BigFly.Y = 8
  BigFly.DX = 1
  BigFly.DY = 1
  BossOldX = 13
  BossOldY = 8
  BigFly.State = BossSleeping
  Level = 1
  PendingStage = 0
  EnemiesLeft = 17  ' 2 + 3 + 3 + 4 + 4 flies, then the boss.
  BossHealth = 0
  BossActive = 0
  Score = 0
  FireWasDown = 0
  SwatterLocked = 0
  WingFrame = 0
  clear sprites
  set sprite count 5
  StopGameTimers
  start timer FlyStep
  play sound 1
  StartFlyLevel
  return

sub GameLoop:
  wait
  if timer SwatterLock then SwatterLocked = 0
  ReadSwatter
  if timer FlyStep then GameplayTick
  if timer RoundSecond then SecondTick
  ' Time expiration is terminal; do not process a final boss step or hit.
  if RoundTime = 0 then goto GameOver
  if timer BossStep then BossGameplayTick
  if BossActive = 1 then
    if timer BossPhase then
      if BigFly.State < BossDefeated then
        BigFly.State = BossNextStates[BigFly.State - 1]
        start timer BossPhase
      end if
    end if
  end if
  CheckSwat
  DrawActors
  if BigFly.State = BossDefeated then goto Victory
  goto GameLoop

sub GameplayTick:
  if WingFrame = 0 then
    WingFrame = 1
  else
    WingFrame = 0
  end if
  for each Fly, ActiveFly in Flies
    on Fly.State gosub MoveFly, AnimateSplat, DeadFly
  next
  if PendingStage = 1 then
    if Flies[0].State = FlyDefeated and Flies[1].State = FlyDefeated and Flies[2].State = FlyDefeated and Flies[3].State = FlyDefeated then
      PendingStage = 0
      if Level < 5 then
        Level += 1
        StartFlyLevel
      else
        StartBoss
      end if
    end if
  end if
  return

sub BossGameplayTick:
  if BossActive = 0 then return
  if BigFly.State = BossHunting or BigFly.State = BossCharging then MoveBoss
  DrawBoss
  return

sub MoveFly:
  Flies[ActiveFly].X += Flies[ActiveFly].DX
  Flies[ActiveFly].Y += Flies[ActiveFly].DY
  if Flies[ActiveFly].X < 18 then Flies[ActiveFly].DX = 0 - Flies[ActiveFly].DX
  if Flies[ActiveFly].X > 222 then Flies[ActiveFly].DX = 0 - Flies[ActiveFly].DX
  if Flies[ActiveFly].Y < 30 then Flies[ActiveFly].DY = 0 - Flies[ActiveFly].DY
  if Flies[ActiveFly].Y > 154 then Flies[ActiveFly].DY = 0 - Flies[ActiveFly].DY
  return

sub AnimateSplat:
  if SplatTicks[ActiveFly] > 0 then SplatTicks[ActiveFly] -= 1
  if SplatTicks[ActiveFly] = 0 then Flies[ActiveFly].State = FlyDefeated
  return

sub DeadFly:
  return

sub MoveBoss:
  BigFly.X += BigFly.DX
  BigFly.Y += BigFly.DY
  if BigFly.X < 3 then
    BigFly.X = 3
    BigFly.DX = 1
  end if
  if BigFly.X > 22 then
    BigFly.X = 22
    BigFly.DX = -1
  end if
  if BigFly.Y < 4 then
    BigFly.Y = 4
    BigFly.DY = 1
  end if
  if BigFly.Y > 17 then
    BigFly.Y = 17
    BigFly.DY = -1
  end if
  return

sub ReadSwatter:
  if SwatterLocked = 1 then return
  if joypad(1).left then
    if Swatter.X > 10 then Swatter.X -= 3
  end if
  if joypad(1).right then
    if Swatter.X < 230 then Swatter.X += 3
  end if
  if joypad(1).up then
    if Swatter.Y > 24 then Swatter.Y -= 3
  end if
  if joypad(1).down then
    if Swatter.Y < 164 then Swatter.Y += 3
  end if
  return

sub CheckSwat:
  if not joypad(1).fire then
    FireWasDown = 0
    return
  end if
  if FireWasDown = 1 then return
  if SwatterLocked = 1 then return
  ' Trigger once per press; the lock supplies the visible swatter recoil.
  FireWasDown = 1
  SwatterLocked = 1
  start timer SwatterLock
  play sound 2
  for each Fly, ActiveFly in Flies
    if Fly.State = FlyFlying then
      if sprite 0 hitbox SwatterHit collides with sprite ActiveFly + 1 hitbox FlyHit then
        SwatFly
        return
      end if
    end if
  next
  if BossActive = 1 then
    ' The boss is tile-rendered, so convert its tile origin to logical pixels.
    BossPixelX = BigFly.X << 3
    BossPixelY = BigFly.Y << 3
    if box Swatter.X,Swatter.Y size 15,15 collides with box BossPixelX,BossPixelY size 56,24 then
      BossHealth -= 1
      Score += 50
      play sound 3
      if BossHealth = 0 then
        BigFly.State = BossDefeated
        EnemiesLeft -= 1
        stop sound 5
        play sound 4
        DrawBoss
        wait 120 frames
      end if
      DrawStatus
      return
    end if
  end if
  return

sub SwatFly:
  Flies[ActiveFly].State = FlySplat
  SplatTicks[ActiveFly] = 4
  FliesLeft -= 1
  EnemiesLeft -= 1
  Score += 100
  if FliesLeft = 0 then PendingStage = 1
  DrawStatus
  return

sub StartFlyLevel:
  u8 LevelIndex = 0
  LevelIndex = Level - 1
  LevelOffset = LevelOffsets[LevelIndex]
  FlyColor = LevelColors[LevelIndex]
  FliesLeft = LevelFlyCounts[LevelIndex]
  RoundTime = 30
  copy LevelFlies + LevelOffset count 20 to Flies
  for ActiveFly = 0 to 3
    SplatTicks[ActiveFly] = 0
  next
  start timer RoundSecond
  LevelOffset = LevelMessageOffsets[LevelIndex]
  put LevelMessages + LevelOffset count 25 at 4,22
  DrawStatus
  DrawActors
  return

sub StartBoss:
  stop sound 1
  BossActive = 1
  BossHealth = 10
  BigFly.State = BossSleeping
  start timer BossPhase
  start timer BossStep
  play sound 5
  ClearBottomMessage
  print centered at 22, "BIG FLY INCOMING!"
  DrawBoss
  return

sub ClearBottomMessage:
  fill row 22 from 1 count 30 with 32
  return

sub SecondTick:
  if RoundTime > 0 then RoundTime -= 1
  DrawStatus
  return

sub DrawStatus:
  print Level at 7,1 digits 1
  print RoundTime at 6,0 digits 2
  print EnemiesLeft at 18,0 digits 2
  print Score at 28,0 digits 4
  return

sub DrawActors:
  if SwatterLocked = 1 then
    set sprite 0 to Swatter.Y,Swatter.X,0,8
  else
    set sprite 0 to Swatter.Y,Swatter.X,0,15
  end if
  for each Fly, ActiveFly in Flies
    if Fly.State = FlyDefeated then
      set sprite ActiveFly + 1 y to 207
    elseif Fly.State = FlySplat then
      if WingFrame = 0 then
        set sprite ActiveFly + 1 to Fly.Y,Fly.X,12,8
      else
        set sprite ActiveFly + 1 to Fly.Y,Fly.X,16,8
      end if
    else
      if WingFrame = 0 then
        set sprite ActiveFly + 1 to Fly.Y,Fly.X,4,FlyColor
      else
        set sprite ActiveFly + 1 to Fly.Y,Fly.X,8,FlyColor
      end if
    end if
  next
  update sprites
  return
sub DrawBoss:
  put BossBlankFrame frame size 7,3 at BossOldX,BossOldY
  if BossActive = 1 then
    if BigFly.State = BossDefeated then
      put BossDeadFrame frame size 7,3 at BigFly.X,BigFly.Y
    elseif WingFrame = 0 then
      put BossTileFrame frame size 7,3 at BigFly.X,BigFly.Y
    else
      put BossTileFrameB frame size 7,3 at BigFly.X,BigFly.Y
    end if
  end if
  BossOldX = BigFly.X
  BossOldY = BigFly.Y
  return

sub StopGameTimers:
  stop timer FlyStep
  stop timer RoundSecond
  stop timer BossPhase
  stop timer BossStep
  stop timer SwatterLock
  return

sub GameOver:
  StopGameTimers
  mute all
  ClearBottomMessage
  clear sprites
  update sprites
  print centered at 10, "TIME IS UP"
  print centered at 13, "PRESS FIRE TO TRY AGAIN"
  play sound 6
  pause until press and release blank after 10 seconds
  goto TitleScreen

sub Victory:
  ClearBottomMessage
  StopGameTimers
  clear sprites
  update sprites
  BossActive = 0
  DrawBoss
  print centered at 9, "THE BIG FLY IS DOWN!"
  print centered at 12, "TIMER QUEST COMPLETE"
  print centered at 16, "PRESS FIRE"
  pause until press and release blank after 10 seconds
  goto TitleScreen

asm {
FlyBuzzSound:
    db $80,$19,$93,$01
    db $80,$15,$A3,$03
    db $80,$21,$93,$02
    db $80,$0C,$93,$02
    db $80,$13,$93,$01
    db $80,$0C,$A3,$03
    db $80,$21,$93,$02
    db $80,$15,$93,$02
    db $98
SwatterSound:
    db $40,$25,$62,$01,$40,$74,$51,$01,$40,$86,$00,$02,$50
BossSplatSound:
    db $02,$15,$20,$1B,$32,$10
VictorySound:
    db $40,$1D,$51,$06,$40,$D5,$50,$06,$40,$A9,$50,$06
    db $40,$8E,$50,$06,$40,$6A,$50,$18,$50
BossBuzzSound:
    db $80,$49,$73,$01
    db $80,$45,$63,$03
    db $80,$51,$73,$02
    db $80,$1C,$63,$02
    db $80,$33,$73,$01
    db $80,$1C,$63,$03
    db $80,$41,$73,$02
    db $80,$45,$63,$02
    db $98
LostSound:
    db $81,$F6,$31,$02,$CC,$7C
    db $81,$20,$52,$02,$CC,$7D
    db $81,$3F,$72,$02,$DD,$7E
    db $81,$60,$92,$02,$DD,$7F
    db $81,$60,$C2,$02,$EE,$7F
    db $90
FlySoundTable:
    dw FlyBuzzSound,$702B
    dw SwatterSound,$7035
    dw BossSplatSound,$703F
    dw VictorySound,$7049
    dw BossBuzzSound,$7053
    dw LostSound,$705D
}