project "ARCADE OVERLAY MEMORY LAB"
memory "colecovision_legacy_sdcc"

' Measured Balanced RAM footprints of the standalone examples:
' Explosion 162 + Diamond Dash 101 + Fly Swatter 87 = 350 logical bytes.
record ExplosionMemory:
  u8 Bytes[162]
end record

record DiamondDashMemory:
  u8 Bytes[101]
end record

record FlySwatterMemory:
  u8 Bytes[87]
end record

overlay ArcadeRam
  Explosion as ExplosionMemory
  DiamondDash as DiamondDashMemory
  FlySwatter as FlySwatterMemory
end overlay

' These remain alive while any game is active.
u8 ActiveGame = 0
u8 Passed = 0

text screen
backdrop dark blue
print centered at 5, "ARCADE RAM OVERLAY"
print at 3,8, "SEPARATE RAM: 350 BYTES"
print at 3,10, "OVERLAY RAM:  162 BYTES"
print at 3,12, "SAVED RAM:    188 BYTES"

' All three first bytes share one address. Each game must initialize its part.
ActiveGame = 1
ArcadeRam.Explosion.Bytes[0] = 17
if ArcadeRam.DiamondDash.Bytes[0] = 17 then Passed += 1
ActiveGame = 2
ArcadeRam.DiamondDash.Bytes[0] = 42
if ArcadeRam.FlySwatter.Bytes[0] = 42 then Passed += 1
ActiveGame = 3
ArcadeRam.FlySwatter.Bytes[0] = 99
if ArcadeRam.Explosion.Bytes[0] = 99 then Passed += 1

if Passed = 3 then
  print centered at 16, "ALIAS TEST PASS"
else
  print centered at 16, "ALIAS TEST FAIL"
end if
screen on
loop forever
