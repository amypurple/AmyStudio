cartridge "BLAM!/KEVIN DEWEY, COMPUTE!/1983"

' BLAM!
' Kevin Dewey's BLAM! (COMPUTE!'s Gazette, December 1983, "Educational
' Games: A Kid's View"; he was 12), for the ColecoVision in Amy by Amy
' Bienvenu. Ported by Claude (an AI made by Anthropic) for Amy Studio,
' 2026.
'
' Source: the VIC-20 version's listing (orig/blam_vic.bas, typed in from
' the magazine's pages 231-232). Line numbers in the comments are its.
'
' Terrorists have filled a building with time bombs. Walk into a bomb to
' disarm it: subtract the number at the bottom from the number at the top
' and give the answer. Right, and the bomb is safe; wrong, and it blows up
' (three blasts and the building falls). Clear a story within five
' minutes; each story has ten bombs more than the one before (10 to 60),
' six stories in all. The skill level (1-100) sets how big the numbers
' are: the top number is below 100 times the level.
'
' Controls (either joystick): the stick walks; at a bomb, up/down change
' the digit under the cursor, left/right move the cursor, the left button
' gives the answer. Before the game: up/down the skill level (held, it
' repeats), the left button. Keypad not used.
'
' Kept as the listing has them: the skill level and B = level x 100, the
' story's top number (one for the whole story), a new bottom number for
' each bomb (below the top one), the answer, CORRECT!! and WRONG... with
' the right answer, three blasts, the five minutes, ten more bombs a
' story up to 60, the messages, the walk (moving onto the blue line sends
' you four rows up; left and right run on round the rows).
' Liberties taken:
' - The answer is chosen with the stick (the listing typed it): four
'   digits, enough for the largest numbers.
' - 28 columns by 16 rows of floor (the VIC had 22 by 17); the time is
'   shown as minutes and seconds.
' - "EF NO.?" (the listing's prompt) is spelled out as the subtraction.
' House rules kept: text in columns 2-29, rows 1-22; tiles from 128; an
' original title tune that plays once; a credits page; the screens are
' drawn with the NMI off.

const TFloor = 128
const TBomb = 129
const TBomb2 = 130
const TBlast = 131
const TLine = 132
const TWall = 133
const TBox = 134
const TSel0 = 135
const TSel1 = 136
const TSel2 = 137
const TSel3 = 138
const TSel4 = 139
const TSel5 = 140
const TSel6 = 141
const TSel7 = 142
const TSel8 = 143
const TSel9 = 144
const TArrow = 145
const SSuit = 0
const SVisor = 4
const NTiles8 = 144
const SprBytes = 64
const SndHush = 1
const SndTick = 2
const SndStep = 3
const SndRight = 4
const SndBoom = 5
const SndStory = 6
const SndGood = 7
const SndWin = 8
const SndTuneA = 9
const SndTuneB = 10
u16 TzLeft = 0
u8 TzOn = 0

' --- the listing's variables -------------------------------------------------
' Lv the skill level, B its range, I the top number, J the bottom one, K
' the answer, M bombs done this story, H bombs this story, NN blasts; the
' floor is Bm[] (1 a bomb), C the place you stand (row * 28 + column)
u8 Lv = 10
u16 B = 1000
u16 I = 0
u16 J = 0
u16 K = 0
u8 M = 0
u8 H = 10
u8 NN = 0
u8 Bm[448]
u16 C = 211
u16 Secs = 0
u8 Fr = 0
u8 Dg[4]
u8 Cu = 0
u8 Ask = 0
u8 Idle = 0
u8 Ended = 0

u16 Rs = $6B2D
u16 Rw = 0
u16 Rt = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rn = 0
u16 Rv = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Fire1 = 0
u8 WasF1 = 0
u8 WasDir = 0
u8 HoldT = 0
u8 Tick = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 N = 0
u8 Tl = 0
u8 Tx = 0
u8 Ty = 0
u16 V16 = 0
u16 W16 = 0
u16 Q16 = 0
u16 NumU = 0

  tile screen
  set sound table BlSoundTable areas 4
  sprites 16x16
  set sprite count 2
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  CreditsPage
  TitlePage
' 5-8: the skill level
l5:
  Skill
  B = Lv
  B = B * 100
  M = 0
  H = 10
  NN = 0

' 30-37: a story: H bombs, the line, the tune, the clock, the top number
l30:
  Story
  Rn = B
  RndK
  I = Rv
  Hud

' 38-60: walk
l38:
  Frame1
  Clock
  if Secs >= 300 then goto l200
  ReadPad
  Walk
  ' 54: a bomb
  V16 = C
  if Bm[V16] = 1 then goto l9
  goto l38

' 9-16: disarm it
l9:
  Rn = I
  RndK
  J = Rv
  Ask9
  if Ended = 0 then goto l38
  if Ended = 2 then goto l110
  goto l200

' 110-135: the story cleared
l110:
  HideYou
  NewScreen
  print at 9,3, "GOOD WORK!!"
  ShowPage
  M = 0
  play sound SndGood
  Pause(150)
  H = H + 10
  if H = 70 then goto l600
  print at 2,6, "YOU GOT ALL THE BOMBS OUT"
  print at 2,7, "OF THAT STORY, BUT THE"
  print at 2,8, "TERRORISTS PUT EVEN MORE IN"
  print at 2,9, "THE NEXT!"
  print at 4,12, "GET READY AGAIN!!"
  Pause(180)
  play sound SndGood
  Pause(120)
  goto l30

' 200-220: the building blew up
l200:
  HideYou
  play sound SndBoom
  for J8 = 0 to 15
    V = J8 & 1
    if V = 0 then backdrop dark red
    if V = 1 then backdrop light yellow
    Frame1
    Frame1
    Frame1
  next
  backdrop black
  NewScreen
  print at 6,6, "THE PLACE BLEW UP!"
  print at 9,8, "GAME OVER!"
  print at 9,15, "PLAY AGAIN?"
  print at 6,21, "PRESS A BUTTON"
  ShowPage
  Ask = 9
  WaitPress
  Ask = 0
  goto l5

' 600-630: the building cleared
l600:
  NewScreen
  print at 2,4, "YOU CLEARED THE BUILDING OF"
  print at 2,5, "BOMBS. YOU ARE A VERY GREAT"
  print at 2,6, "PERSON."
  print at 9,15, "PLAY AGAIN?"
  print at 6,21, "PRESS A BUTTON"
  ShowPage
  play sound SndWin
  Pause(120)
  Ask = 9
  WaitPress
  Ask = 0
  goto l5

' ---------------------------------------------------------------------------
' The story

sub Story:
  NewScreen
  for J8 = 3 to 18
    fill TFloor count 28 at 2,J8
  next
  for V16 = 0 to 447
    Bm[V16] = 0
  next
  ' 31-33: H bombs, anywhere but where you start
  for N = 1 to H
st_again:
    Rn = 448
    RndK
    if Rv = 211 then goto st_again
    V16 = Rv
    if Bm[V16] = 1 then goto st_again
    Bm[V16] = 1
    DrawCell
  next
  ' 34: the blue line
  fill TLine count 28 at 2,19
  C = 211
  Secs = 0
  Fr = 0
  ShowPage
  ' 35: the story's tune
  play sound SndStory
  Pause(60)
  Ask = 1
  ShowYou
  return
end sub

' DrawCell: cell V16 (a bomb or the floor)
sub DrawCell:
  W16 = V16 / 28
  Ty = W16 + 3
  W16 = V16 % 28
  Tx = W16 + 2
  Tl = TFloor
  if Bm[V16] = 1 then Tl = TBomb
  if Bm[V16] = 2 then Tl = TBlast
  put char Tl at Tx,Ty
  return
end sub

' Walk: 40-53, one step a press (repeating while held)
sub Walk:
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 0 then return
  ' 45-48: the stick moves you a row or a column (on round the rows)
  if Dn1 = 1 then C = C + 28
  if Lf1 = 1 then
    if C = 0 then
      C = 447
    else
      dec C
    end if
  end if
  if Up1 = 1 then
    if C < 28 then
      ' 53: not above the top row
    else
      C = C - 28
    end if
  end if
  if Rt1 = 1 then inc C
  ' 52: onto the blue line: four rows up
  if C >= 448 then C = C - 112
  play sound SndStep
  ShowYou
  return
end sub

' Clock: TI$, the seconds since the story began
sub Clock:
  inc Fr
  if Fr < 60 then return
  Fr = 0
  inc Secs
  Hud
  ' the bombs tick: the bomb tile's picture swaps (every bomb at once)
  V = Secs & 1
  if V = 1 then
    copy TilePat + 16 count 8 to vram.pattern + 1032
    copy TileCol + 16 count 8 to vram.color + 1032
    copy TilePat + 16 count 8 to vram.pattern + 3080
    copy TileCol + 16 count 8 to vram.color + 3080
    copy TilePat + 16 count 8 to vram.pattern + 5128
    copy TileCol + 16 count 8 to vram.color + 5128
  else
    copy TilePat + 8 count 8 to vram.pattern + 1032
    copy TileCol + 8 count 8 to vram.color + 1032
    copy TilePat + 8 count 8 to vram.pattern + 3080
    copy TileCol + 8 count 8 to vram.color + 3080
    copy TilePat + 8 count 8 to vram.pattern + 5128
    copy TileCol + 8 count 8 to vram.color + 5128
  end if
  return
end sub

' Hud: 55, the clock and the top number; the story, the blasts
sub Hud:
  print at 2,1, "TIME"
  W16 = Secs / 60
  V = W16 + 0
  print at 7,1, digits$(V, 1)
  print at 8,1, ":"
  W16 = Secs % 60
  V = W16 + 0
  print at 9,1, digits$(V, 2)
  print at 13,1, "TOP NUMBER"
  NumU = I
  print at 24,1, digits$(NumU, 4)
  print at 2,2, "STORY"
  V = H / 10
  print at 8,2, digits$(V, 1)
  print at 11,2, "BOMBS"
  V = H - M
  print at 17,2, digits$(V, 2)
  print at 21,2, "BLASTS"
  print at 28,2, digits$(NN, 1)
  return
end sub

' Ask9: 9-16 and 80-85, the subtraction at a bomb (Ended: 2 the story
' cleared, 3 the building blew up)
sub Ask9:
  Ended = 0
  for J8 = 0 to 3
    Dg[J8] = 0
  next
  Cu = 3
  for J8 = 20 to 22
    fill 32 count 28 at 2,J8
  next
  print at 2,20, "DEFUSE IT:"
  NumU = I
  print at 13,20, digits$(NumU, 4)
  print at 18,20, "-"
  NumU = J
  print at 20,20, digits$(NumU, 4)
  print at 25,20, "="
  play sound SndTick
  Ask = 2
a9_loop:
  ' the answer and the cursor under it
  for J8 = 0 to 3
    Tx = J8 + 13
    V = Dg[J8] + 48
    W = 32
    if J8 = Cu then
      ' the digit being set: boxed in cyan, an arrow under it
      V = Dg[J8] + TSel0
      W = TArrow
    end if
    put char V at Tx,21
    put char W at Tx,22
  next
  print at 2,21, "ANSWER:"
  Frame1
  Clock
  if Secs >= 300 then
    Ended = 3
    return
  end if
  ReadPad
  if Up1 = 1 then
    V = Dg[Cu] + 1
    if V = 10 then V = 0
    Dg[Cu] = V
    play sound SndTick
  end if
  if Dn1 = 1 then
    V = Dg[Cu]
    if V = 0 then V = 10
    dec V
    Dg[Cu] = V
    play sound SndTick
  end if
  if Lf1 = 1 then
    if Cu > 0 then dec Cu
  end if
  if Rt1 = 1 then
    if Cu < 3 then inc Cu
  end if
  if Fire1 = 0 then goto a9_loop
  Ask = 1
  ' 10-12: K + J = I?
  K = Dg[0]
  K = K * 10
  V = Dg[1]
  K = K + V
  K = K * 10
  V = Dg[2]
  K = K + V
  K = K * 10
  V = Dg[3]
  K = K + V
  fill 32 count 28 at 2,22
  V16 = K + J
  if V16 = I then
    print at 2,22, "CORRECT!!"
    play sound SndRight
    ' 13: the bomb is safe
    V16 = C
    Bm[V16] = 0
    DrawCell
    ShowYou
    inc M
    Hud
    Pause(60)
    ClearAsk
    if M = H then Ended = 2
    return
  end if
  ' 80-85: the bomb blows up
  print at 2,22, "WRONG..."
  V16 = C
  Bm[V16] = 2
  DrawCell
  play sound SndBoom
  for J8 = 0 to 15
    V = J8 & 1
    if V = 0 then backdrop dark red
    if V = 1 then backdrop black
    Frame1
    Frame1
  next
  backdrop black
  V16 = C
  Bm[V16] = 0
  DrawCell
  ShowYou
  fill 32 count 28 at 2,22
  print at 2,22, "CORRECT NO. ="
  V16 = I - J
  NumU = V16
  print at 16,22, digits$(NumU, 4)
  inc NN
  inc M
  Hud
  Pause(120)
  ClearAsk
  if NN = 3 then
    Ended = 3
    return
  end if
  if M = H then Ended = 2
  return
end sub

sub ClearAsk:
  for J8 = 20 to 22
    fill 32 count 28 at 2,J8
  next
  return
end sub

sub ShowYou:
  W16 = C / 28
  Ty = W16 + 3
  Ty = Ty * 8
  Ty = Ty - 9
  W16 = C % 28
  Tx = W16 + 2
  Tx = Tx * 8
  Tx = Tx - 4
  set sprite 0 to Ty,Tx,SVisor,7
  set sprite 1 to Ty,Tx,SSuit,15
  update sprites
  return
end sub

sub HideYou:
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

' Skill: 5-6, the level (1-100)
sub Skill:
  NewScreen
  print at 11,3, "BLAM!"
  print at 7,7, "SKILL LEVEL (1-100)"
  print at 4,14, "UP/DOWN (HOLD TO REPEAT),"
  print at 4,15, "THEN THE LEFT BUTTON."
  print at 4,17, "LEVEL 1: NUMBERS UP TO 100."
  print at 4,18, "LEVEL 2: UP TO 200, ..."
  ShowPage
  Ask = 3
sk_loop:
  print at 14,10, digits$(Lv, 3)
  Frame1
  ReadPad
  if Up1 = 1 then
    if Lv < 100 then inc Lv
    play sound SndTick
  end if
  if Dn1 = 1 then
    if Lv > 1 then dec Lv
    play sound SndTick
  end if
sk_fire:
  if Fire1 = 0 then goto sk_loop
  Ask = 0
  return
end sub

' ---------------------------------------------------------------------------
' Screens, frames, input, random numbers

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideYou
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowPage:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Pause(u8 Nf):
  for J8 = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: a new push of the stick (repeating every 8 frames while held)
sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Fire1 = 0
  V = 0
  W = joypad(1).up | joypad(2).up
  if W = 1 then V = 1
  W = joypad(1).down | joypad(2).down
  if W = 1 then V = 2
  W = joypad(1).left | joypad(2).left
  if W = 1 then V = 3
  W = joypad(1).right | joypad(2).right
  if W = 1 then V = 4
  W = 0
  if V <> WasDir then
    W = 1
    HoldT = 0
  else
    if V <> 0 then
      inc HoldT
      if HoldT >= 12 then
        HoldT = 4
        W = 1
      end if
    end if
  end if
  if W = 1 then
    if V = 1 then Up1 = 1
    if V = 2 then Dn1 = 1
    if V = 3 then Lf1 = 1
    if V = 4 then Rt1 = 1
  end if
  WasDir = V
  W = joypad(1).button1 | joypad(2).button1
  if W = 1 then
    if WasF1 = 0 then Fire1 = 1
  end if
  WasF1 = W
  return
end sub

sub WaitPress:
  WasF1 = 1
wp_loop:
  Frame1
  ReadPad
  if Fire1 = 0 then goto wp_loop
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' RndK: Rv = INT(RND * Rn)
sub RndK:
  Rnd16
  Uq = Rw
  Uq2 = Rn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

sub CreditsPage:
  NewScreen
  print at 12,1, "BLAM!"
  print at 2,3, "BY KEVIN DEWEY (AGE 12),"
  print at 2,4, "FROM COMPUTE!'S GAZETTE,"
  print at 2,5, "DECEMBER 1983 (VIC-20 AND"
  print at 2,6, "COMMODORE 64)."
  print at 2,8, "FOR THE COLECOVISION BY"
  print at 2,9, "CLAUDE (AN AI MADE BY"
  print at 2,10, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,11, "2026, IN AMY, THE LANGUAGE"
  print at 2,12, "BY AMY BIENVENU."
  print at 2,14, "MUSIC: TICK TOCK"
  print at 2,15, "(ORIGINAL)."
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  Ask = 4
  WaitPress
  Ask = 0
  return
end sub

sub TitlePage:
  NewScreen
  fill TWall count 28 at 2,3
  print at 12,5, "BLAM!"
  fill TWall count 28 at 2,7
  print at 2,9, "THE BUILDING IS FULL OF"
  print at 2,10, "TIME BOMBS. WALK INTO ONE"
  print at 2,11, "AND SUBTRACT TO DISARM IT:"
  print at 2,12, "THE TOP NUMBER MINUS THE"
  print at 2,13, "BOTTOM ONE. WRONG, AND IT"
  print at 2,14, "BLOWS UP (THREE AND THE"
  print at 2,15, "PLACE FALLS). FIVE MINUTES"
  print at 2,16, "A STORY, SIX STORIES."
  put char TBomb at 9,5
  put char TBomb at 20,5
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  ' Amy's Tiny Sound "once" form: both voices stop at the tune's end
  play song BlSong once
  Ask = 4
  WaitPress
  Ask = 0
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $6B2D
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $02,$04,$1C,$C1,$80,$80,$80,$C1
  $0A,$04,$1C,$C1,$80,$80,$80,$C1
  $92,$54,$38,$01,$38,$54,$92,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $01,$01,$01,$00,$10,$10,$10,$00
  $00,$81,$81,$81,$81,$81,$81,$00
  $00,$38,$28,$28,$28,$38,$00,$00
  $00,$10,$30,$10,$10,$38,$00,$00
  $00,$38,$08,$38,$20,$38,$00,$00
  $00,$38,$08,$18,$08,$38,$00,$00
  $00,$28,$28,$38,$08,$08,$00,$00
  $00,$38,$20,$38,$08,$38,$00,$00
  $00,$38,$20,$38,$28,$38,$00,$00
  $00,$38,$08,$10,$10,$10,$00,$00
  $00,$38,$28,$38,$28,$38,$00,$00
  $00,$38,$28,$38,$08,$38,$00,$00
  $10,$38,$83,$01,$38,$38,$38,$00
end data
data TileCol bytes
  $0A,$0A,$0A,$0A,$0A,$0A,$0A,$06
  $BA,$1A,$1A,$A1,$A1,$A1,$A1,$61
  $8A,$8A,$1A,$A1,$A1,$A1,$A1,$61
  $8A,$8A,$8A,$A8,$8A,$8A,$8A,$06
  $05,$05,$04,$04,$04,$04,$05,$05
  $1E,$1E,$1E,$01,$1E,$1E,$1E,$01
  $0F,$F1,$F1,$F1,$F1,$F1,$F1,$0F
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $07,$17,$17,$17,$17,$17,$07,$07
  $F1,$F1,$1F,$1F,$F1,$F1,$F1,$01
end data
data SpritePat bytes
  $00,$07,$0F,$0C,$0C,$07,$1F,$3F,$37,$37,$07,$06,$06,$0E,$00,$00
  $00,$E0,$F0,$30,$30,$E0,$F8,$FC,$EC,$EC,$E0,$60,$60,$70,$00,$00
  $00,$00,$00,$03,$03,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$C0,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
BlHush:
    db $00,$00,$F0,$01,$10
BlTick:
    db $40,$40,$40,$01,$40,$40,$F0,$01,$50
BlStep:
    db $00,$00,$51,$01,$00,$00,$F1,$02,$10
BlRight:
    db $40,$8F,$20,$04,$40,$6B,$20,$04,$40,$55,$20,$04,$40,$47,$30,$0A,$50
BlBoom:
    db $00,$00,$06,$08,$00,$00,$27,$0C,$00,$00,$47,$12,$00,$00,$77,$18,$10
BlStory:
    db $40,$7F,$30,$06,$40,$7F,$30,$06,$40,$8F,$30,$06,$40,$8F,$30,$06,$40,$7F,$30,$06,$40,$71,$30,$06
    db $40,$7F,$40,$0A,$50
BlGood:
    db $40,$D6,$20,$0A,$40,$AA,$20,$0A,$40,$8F,$20,$14,$50
BlWin:
    db $40,$AB,$21,$04,$40,$53,$21,$04,$40,$1D,$21,$04,$40,$D6,$20,$04,$40,$AA,$20,$04,$40,$8F,$20,$04
    db $40,$6B,$20,$14,$50

BlSoundTable:
    dw BlHush,$702B
    dw BlTick,$7035
    dw BlStep,$702B
    dw BlRight,$7035
    dw BlBoom,$702B
    dw BlStory,$7035
    dw BlGood,$7035
    dw BlWin,$7035
    dw BlTuneMel,$703F
    dw BlTuneBass,$7049
; Tick Tock (original)
; Tiny Sound, 7 frames per step
BlTuneMel:
    db $44
    dw sndtiny_1
