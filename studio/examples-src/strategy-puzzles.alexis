cartridge "STRATEGY PUZZLES/PRESENTS DISHAROON AND KOHL'S/1984"

' STRATEGY PUZZLES
' From "41 1/2 Fun Projects for the Atari" by Dale Disharoon and Herbert
' Kohl (Reston Publishing, 1984), Part IV, Strategy Puzzles: 20 The
' Pattern Game, 21-22 3 x 3 and 4 x 4 Number Puzzlers, 23 Dozo. All
' credit belongs to Dale Disharoon and Herbert Kohl.
'
' Historical context (summary of the chapter):
' Games and puzzles decided by thought, not by a spinner or dice.
' The Pattern Game asks for cooperation in an indirect way: one player
' makes a hidden pattern of stars on a 4 x 4 grid, a friend reconstructs
' it, and can ask for a clue that reveals one square; a random pattern
' makes the game no fun, a regular one makes it a fair challenge.
' The Number Puzzlers are computer versions of the century-old sliding
' block puzzles: the computer shuffles the numbers, the empty square is
' moved with the joystick, and a counter shows how many numbers are
' already in their place. Not every mix can be solved: Sam Loyd's
' "14-15 Puzzle" of the 1870s offered $1,000 for a solution that cannot
' exist, since only an even number of interchanges leaves it solvable.
' Dozo, used by Japanese GO masters to warm up, is played on a
' triangle of 28 points with four kinds of pieces that belong to
' nobody: each player places any piece on any empty point, and the
' first to complete an equilateral triangle of any size and slant with
' three identical pieces wins. You play not to lose: every move must
' avoid handing the opponent a triangle. The computer plays Dozo, and
' it is hard to beat.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the joystick moves the cursor, fire places or slides; keypad
' # stands for the Atari's SELECT, * for OPTION; keypad 1-4 choose a
' Dozo piece.
' The rules follow the book's listings:
' - Pattern Game: each press cycles a square through dot, star and
'   cross (C(1-3), lines 200, 400); SELECT ends the hidden pattern
'   (line 240), OPTION reveals the square under the cursor and counts a
'   clue (lines 440, 900-920); the patterns are compared square by
'   square (line 460), then "YOU DID IT WITH n CLUES".
' - Number Puzzlers: a random mix, the empty square (**) moved by the
'   stick, the slide sound (line 310), the score = numbers in place from
'   the first one on (lines 320-370). Adaptation: a choice between the
'   book's random mix (half of them cannot be solved, as the chapter
'   explains) and a mix made by random slides (always solvable), and a
'   message when the puzzle is solved.
' - Dozo: the seven-row triangle (lines 8040-8060), the four pieces and
'   the empty point (lines 8510-8550), at most seven of each kind (CC(),
'   line 3100), "WILL YOU GO FIRST?", the winner's triangle flashed
'   (lines 2300-2350). The computer takes a winning move when it has
'   one, otherwise a random move that gives its opponent no triangle,
'   otherwise any move (lines 2200-2550, 6400). The triangles, which the
'   book lists in 756 DATA bytes (lines 9000-9370), are computed here:
'   126 triangles, stored as pairs for each point.
' Adaptation liberties: one cartridge with a menu for the three games;
' framed number blocks; joystick menus for the Y/N questions; an
' editorial page.

const Empty = 132
const Star = 141
const Cross = 142
const Dot = 143
const NumberBase = 144
const GridCross = 174
const GridHorizontal = 175
const GridVertical = 176
const DozoHorizontal = 177
const DozoSlash = 178
const DozoBackslash = 179

' Sound table slots (sz/s.mjs)
const SndSweep = 1
const SndSlide = 2
const SndDone = 3
const SndPlace = 4
const SndWin = 5
const SndLose = 6
const SndBad = 7

u8 P1[16]                      ' Pattern Game: hidden pattern (128 + n: revealed)
u8 P2[16]                      ' the guess
u8 Pz[16]                      ' Number Puzzler
u8 Sz = 3
u8 PX = 0
u8 PY = 0
u8 CX = 0                      ' cursor
u8 CY = 0
u8 Clues = 0
u8 Mix = 2
u8 Bd[28]                      ' Dozo: 0 empty, 1-4 piece
u8 Used[4]
u8 Piece = 1
u8 Who = 0                     ' 0 player, 1 computer
u8 Pt = 0
u8 PA = 0
u8 PB = 0
u8 WinA = 0
u8 WinB = 0
u8 BestPt = 0
u8 BestPc = 0
u8 NSafe = 0
bool Won = false
bool Threat = false
u8 Filled = 0
u8 Stick = 0
u8 LastStick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cnt = 0
u8 Choice = 1
u8 FromCell = 0
u8 ToCell = 0
u8 OtherPiece = 0
u8 TileValue = 0
u16 Moves = 0
bool Moved = false
u16 Ptr = 0
u16 Dst16 = 0
u16 NumU = 0

  tile screen
  set sound table StratSoundTable areas 2
  LoadTiles
  screen on
  EditorialPage

menu:
  Page
  print at 9,2, "STRATEGY PUZZLES"
  print at 4,4, "THREE CLASSIC LOGIC GAMES"
  print at 6,6, "THE PATTERN GAME"
  print at 6,8, "3 X 3 NUMBER PUZZLER"
  print at 6,10, "4 X 4 NUMBER PUZZLER"
  print at 6,12, "DOZO"
  print at 5,16, "FIRE SELECTS A GAME"
  print at 3,18, "KEYPAD * RETURNS TO MENU"
  wait no fire
  choose menu 1 to 4 into Choice cursor $3E at 4,6 step 2
  wait no fire
  if Choice = 1 then goto pattern_game
  if Choice = 4 then goto dozo
  Sz = Choice + 1
  goto puzzler

' ---------------------------------------------------------------------------
' 20 The Pattern Game

pattern_game:
  Page
  print at 9,1, "THE PATTERN GAME"
  print at 4,3, "MAKE YOUR HIDDEN PATTERN"
  for I = 0 to 15
    P1[I] = 1
    P2[I] = 1
  next
  Clues = 0
  X = 9
  DrawPatternFrame
  ShowGrid1
  print at 2,21, "FIRE 1: CHANGE SYMBOL"
  print at 2,22, "FIRE 2 OR #: PATTERN READY"
  CX = 0
  CY = 0
pg_make:
  ReadStepStick
  N = keypad(1)
  if N = 11 then goto pg_guess
  if joypad(1).button2.pressed then goto pg_guess
  if Stick > 0 then MoveCursor4
  I = CY * 4
  I += CX
  if joypad(1).button1.pressed then
    V = P1[I] + 1
    if V > 3 then V = 1
    P1[I] = V
    play sound SndSweep
    wait no fire
  end if
  X = 9
  V = P1[I]
  ShowCell
  goto pg_make

pg_guess:
  ' Lines 300-310: the hidden pattern is covered, the guess begins
  KeyRelease
  Page
  print at 4,3, "NOW GUESS THE HIDDEN PATTERN"
  print at 9,6, "SECRET"
  print at 20,6, "YOUR COPY"
  X = 9
  DrawPatternFrame
  X = 19
  DrawPatternFrame
  for I = 0 to 15
    X = I & 3
    X *= 2
    X += 9
    Y = I >> 2
    Y *= 2
    Y += 8
    put char 63 at X,Y
  next
  X = 19
  ShowGrid2
  print at 2,21, "FIRE 1: CHANGE  FIRE 2: CLUE"
  CX = 0
  CY = 0
pg_loop:
  ReadStepStick
  if Stick > 0 then MoveCursor4
  I = CY * 4
  I += CX
  N = keypad(1)
  if N = 10 or joypad(1).button2.pressed then
    ' Lines 900-920: a clue: the square under the cursor
    KeyRelease
    V = P1[I]
    if V < 128 then
      X = I & 3
      X *= 2
      X += 9
      Y = I >> 2
      Y *= 2
      Y += 8
      N = DotTile[V]
      put char N at X,Y
      P2[I] = V
      P1[I] = V + 128
      inc Clues
      play sound SndPlace
    end if
  end if
  if joypad(1).button1.pressed then
    V = P2[I] + 1
    if V > 3 then V = 1
    P2[I] = V
    play sound SndSweep
    wait no fire
  end if
  X = 19
  V = P2[I]
  ShowCell
  ' Line 460: compared square by square
  N = 0
  for J = 0 to 15
    V = P1[J] & 127
    K = P2[J]
    if V <> K then N = 1
  next
  if N = 1 then goto pg_loop
  play sound SndDone
  NumU = Clues
  print at 3,4, "YOU DID IT WITH " + str$(NumU) + " CLUES! "
  if Clues < 10 then put char 32 at 26,4
  print at 2,21, "PRESS FIRE                  "
  wait 60 frames
  wait no fire
  pause until press
  wait no fire
  goto menu






' ---------------------------------------------------------------------------
' 21, 22 The Number Puzzlers

puzzler:
  Page
  print at 8,2, "NUMBER PUZZLER"
  print at 4,6, "BOOK'S RANDOM MIX"
  print at 4,7, "(MAY BE IMPOSSIBLE!)"
  print at 4,9, "SOLVABLE MIX"
  Choice = Mix
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 2,6 step 3
  Mix = Choice
  wait no fire
  N = Sz * Sz
  for I = 0 to 15
    Pz[I] = 0
  next
  if Mix = 1 then
    ' Lines 160-210: each number at random, the 0 being the empty square
    for I = 0 to N - 1
pz_pick:
      V = random(0, N - 1)
      for J = 0 to I
        if J < I then
          K = Pz[J]
          if K = V then goto pz_pick
        end if
      next
      Pz[I] = V
    next
  else
    for I = 0 to N - 2
      Pz[I] = I + 1
    next
    Pz[N - 1] = 0
    PX = Sz - 1
    PY = Sz - 1
    Cnt = 72
    if Sz = 4 then Cnt = 128
    for J = 1 to Cnt
      Stick = random(1, 4)
      Slide
    next
  end if
  Moves = 0
  for I = 0 to N - 1
    V = Pz[I]
    if V = 0 then
      PX = I % Sz
      PY = I / Sz
    end if
  next
  Page
  print at 8,2, "NUMBER PUZZLER"
  nmi off
  for I = 0 to N - 1
    DrawBlock
  next
  nmi on
  ShowScore
pz_loop:
  ReadStepStick
  N = keypad(1)
  if N = 10 or joypad(1).button2.pressed then goto menu
  if Stick = 0 then goto pz_loop
  Slide
  if not Moved then goto pz_loop
  inc Moves
  nmi off
  I = FromCell
  DrawBlock
  I = ToCell
  DrawBlock
  nmi on
  play sound SndSlide
  ShowScore
  N = Sz * Sz
  dec N
  if Cnt = N then
    play sound SndDone
    print at 9,21, "SOLVED! PRESS FIRE"
    wait no fire
    pause until press
    wait no fire
    goto menu
  end if
  goto pz_loop




' ---------------------------------------------------------------------------
' 23 Dozo

dozo:
  for I = 0 to 27
    Bd[I] = 0
  next
  for I = 0 to 3
    Used[I] = 0
  next
  Filled = 0
  Piece = 1
  Page
  DrawDozoFrame
  DrawDozo
  print at 2,1, "WILL YOU GO FIRST?"
  print at 4,3, "YES"
  print at 4,4, "NO"
  Choice = 1
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 2,3 step 1
  wait no fire
  fill 32 count 20 at 2,1
  fill 32 count 5 at 2,3
  fill 32 count 5 at 2,4
  Who = Choice - 1
  CY = 6
  CX = 3

dz_turn:
  if Filled = 28 then
    fill 32 count 28 at 2,1
    print at 2,1, "THE BOARD IS FULL: A DRAW."
    goto dz_end
  end if
  if Who = 1 then goto dz_cpu

  ' Lines 3000-3820: the player's turn
  fill 32 count 28 at 2,1
  print at 2,1, "YOUR TURN"
dz_player:
  ShowPieces
  ReadStepStick
  N = keypad(1)
  if N = 10 then goto menu
  if N >= 1 then
    if N <= 4 then Piece = N
  end if
  if joypad(1).button2.pressed then
    inc Piece
    if Piece > 4 then Piece = 1
    play sound SndSweep
  end if
  if Stick > 0 then
    ' The cursor moves from point to point
    Pt = CY * 7
    if Stick = 1 then
      if CY > 0 then
        dec CY
        if CX > CY then CX = CY
      end if
    end if
    if Stick = 2 then
      if CY < 6 then inc CY
    end if
    if Stick = 3 then
      if CX > 0 then dec CX
    end if
    if Stick = 4 then
      if CX < CY then inc CX
    end if
    DrawDozo
  end if
  PointOf
  DozoCursor
  if not joypad(1).button1.pressed then goto dz_player
  wait no fire
  V = Bd[Pt]
  if V <> 0 then goto dz_bad
  N = Piece - 1
  V = Used[N]
  if V >= 7 then goto dz_bad
  BestPt = Pt
  BestPc = Piece
  PlayMove
  if Won then
    fill 32 count 28 at 2,1
    print at 2,1, "YOU WON THE GAME!"
    play sound SndWin
    FlashWin
    goto dz_end
  end if
  Who = 1
  goto dz_turn
dz_bad:
  play sound SndBad
  goto dz_player

  ' Lines 2100-2700, 6400: the computer's turn
dz_cpu:
  fill 32 count 28 at 2,1
  print at 2,1, "MY TURN"
  wait 30 frames
  ComputerMove
  PlayMove
  if Won then
    fill 32 count 28 at 2,1
    print at 2,1, "YIPPEE! I WIN!!!"
    play sound SndLose
    FlashWin
    goto dz_end
  end if
  Who = 0
  goto dz_turn

dz_end:
  print at 2,23, "PRESS FIRE"
  wait no fire
  pause until press
  wait no fire
  goto menu










' ---------------------------------------------------------------------------

' ---------------------------------------------------------------------------

' The hidden grid at columns 9-15 (and, with X = 19, the guess)
sub ShowGrid1:
  for I = 0 to 15
    V = P1[I]
    ShowCellI
  next
  return
end sub

sub ShowGrid2:
  for I = 0 to 15
    V = P2[I]
    ShowCellI
  next
  return
end sub

' A compact 4 x 4 board around the symbols. X is the first cell column.
sub DrawPatternFrame:
  for J = 0 to 4
    Y = J * 2
    Y += 7
    for K = 0 to 4
      N = K * 2
      N += X
      dec N
      put char GridCross at N,Y
      if K < 4 then put char GridHorizontal at N + 1,Y
      if J < 4 then put char GridVertical at N,Y + 1
    next
  next
  return
end sub

' Cell I with value V, the grid's left column in X
sub ShowCellI:
  K = I & 3
  K *= 2
  K += X
  Y = I >> 2
  Y *= 2
  Y += 8
  N = DotTile[V]
  put char N at K,Y
  return
end sub

' The cursor's cell, blinking
sub ShowCell:
  N = frame
  N &= 16
  if N = 0 then
    ShowCellI
  else
    K = I & 3
    K *= 2
    K += X
    Y = I >> 2
    Y *= 2
    Y += 8
    put char 32 at K,Y
  end if
  ' Restore the cell left behind
  if LastStick <> 255 then return
  return
end sub

sub MoveCursor4:
  ' Redraw the cell left as it is
  I = CY * 4
  I += CX
  if X = 9 then
    V = P1[I]
  else
    V = P2[I]
  end if
  if Choice = 1 then
    V &= 127
  end if
  ShowCellI
  if Stick = 1 then
    if CY > 0 then dec CY
  end if
  if Stick = 2 then
    if CY < 3 then inc CY
  end if
  if Stick = 3 then
    if CX > 0 then dec CX
  end if
  if Stick = 4 then
    if CX < 3 then inc CX
  end if
  play sound SndSweep
  return
end sub

' Lines 220-300: the empty square moves; the number there moves back
sub Slide:
  Moved = false
  X = PX
  Y = PY
  if Stick = 1 then
    if PY = 0 then return
    dec PY
  end if
  if Stick = 2 then
    if PY = Sz - 1 then return
    inc PY
  end if
  if Stick = 3 then
    if PX = 0 then return
    dec PX
  end if
  if Stick = 4 then
    if PX = Sz - 1 then return
    inc PX
  end if
  FromCell = Y * Sz
  FromCell += X
  ToCell = PY * Sz
  ToCell += PX
  V = Pz[ToCell]
  Pz[FromCell] = V
  Pz[ToCell] = 0
  Moved = true
  return
end sub

' Lines 320-370: the numbers in place, from the first one on
sub ShowScore:
  Cnt = 0
  N = Sz * Sz
  for I = 0 to N - 1
    V = Pz[I]
    if V <> 0 then
      K = Cnt + 1
      if V <> K then goto ss_out
      inc Cnt
    end if
  next
ss_out:
  print at 6,19, "PLACED:"
  NumU = Cnt
  print at 14,19, digits$(NumU, 2)
  print at 18,19, "MOVES:"
  NumU = Moves
  print at 24,19, digits$(NumU, 3)
  return
end sub

' Block I as a framed 4 x 3 box
sub DrawBlock:
  X = I % Sz
  X *= 5
  X += 6
  if Sz = 3 then X += 2
  Y = I / Sz
  Y *= 4
  Y += 4
  V = Pz[I]
  K = X
  put char 133 at K,Y
  inc K
  put char 137 at K,Y
  inc K
  put char 137 at K,Y
  inc K
  put char 134 at K,Y
  inc Y
  K = X
  put char 139 at K,Y
  inc K
  if V = 0 then
    put char 32 at K,Y
    inc K
    put char 32 at K,Y
  else
    TileValue = V - 1
    TileValue *= 2
    TileValue += NumberBase
    put char TileValue at K,Y
    inc K
    inc TileValue
    put char TileValue at K,Y
  end if
  inc K
  put char 140 at K,Y
  inc Y
  K = X
  put char 135 at K,Y
  inc K
  put char 138 at K,Y
  inc K
  put char 138 at K,Y
  inc K
  put char 136 at K,Y
  return
end sub

' Places BestPc at BestPt; Won when it completes a triangle
sub PlayMove:
  Pt = BestPt
  V = BestPc
  Bd[Pt] = V
  N = V - 1
  inc Used[N]
  inc Filled
  play sound SndPlace
  DrawDozo
  TestPoint
  return
end sub

' Won if the piece at Pt makes a triangle (WinA, WinB the other two)
sub TestPoint:
  Won = false
  V = Bd[Pt]
  Cnt = PairCount[Pt]
  Ptr = PairBase[Pt]
  for J = 1 to Cnt
    PA = peek(Ptr)
    inc Ptr
    PB = peek(Ptr)
    inc Ptr
    N = Bd[PA]
    if N = V then
      N = Bd[PB]
      if N = V then
        Won = true
        WinA = PA
        WinB = PB
      end if
    end if
  next
  return
end sub

' Threat when piece V at empty point Pt would leave a triangle with two
' identical pieces and its third point empty
sub TestThreat:
  Threat = false
  Cnt = PairCount[Pt]
  Ptr = PairBase[Pt]
  for J = 1 to Cnt
    PA = peek(Ptr)
    inc Ptr
    PB = peek(Ptr)
    inc Ptr
    N = Bd[PA]
    OtherPiece = Bd[PB]
    if N = V then
      if OtherPiece = 0 then Threat = true
    end if
    if OtherPiece = V then
      if N = 0 then Threat = true
    end if
  next
  return
end sub

' A winning move, else a random safe move, else any move
sub ComputerMove:
  ' A win?
  for I = 0 to 27
    N = Bd[I]
    if N = 0 then
      for K = 1 to 4
        N = K - 1
        N = Used[N]
        if N < 7 then
          Pt = I
          Bd[I] = K
          TestPoint
          Bd[I] = 0
          if Won then
            BestPt = I
            BestPc = K
            return
          end if
        end if
      next
    end if
  next
  ' A safe move, chosen at random among them
  NSafe = 0
  BestPt = 255
  for I = 0 to 27
    N = Bd[I]
    if N = 0 then
      for K = 1 to 4
        N = K - 1
        N = Used[N]
        if N < 7 then
          Pt = I
          V = K
          TestThreat
          if not Threat then
            inc NSafe
            N = random(1, NSafe)
            if N = 1 then
              BestPt = I
              BestPc = K
            end if
          end if
        end if
      next
    end if
  next
  if BestPt <> 255 then return
  ' Any move
  for I = 0 to 27
    N = Bd[I]
    if N = 0 then
      for K = 1 to 4
        N = K - 1
        N = Used[N]
        if N < 7 then
          BestPt = I
          BestPc = K
        end if
      next
    end if
  next
  return
end sub

' Point number Pt from row CY and column CX
sub PointOf:
  Pt = CY * CY
  Pt += CY
  Pt >>= 1
  Pt += CX
  return
end sub

sub DrawDozo:
  for I = 0 to 27
    X = PtX[I]
    Y = PtY[I]
    V = Bd[I]
    N = Empty
    if V > 0 then N = V + 127
    put char N at X,Y
  next
  return
end sub

' Draw the triangular lattice once; pieces and cursor then replace only
' the 28 intersection cells without disturbing the connecting lines.
sub DrawDozoFrame:
  for CY = 0 to 6
    for CX = 0 to CY
      PointOf
      X = PtX[Pt]
      Y = PtY[Pt]
      if CX < CY then put char DozoHorizontal at X + 1,Y
      if CY < 6 then
        put char DozoSlash at X - 1,Y + 1
        put char DozoBackslash at X + 1,Y + 1
      end if
    next
  next
  print at 2,21, "FIRE 2: CHANGE PIECE"
  print at 2,22, "JOYSTICK: MOVE  FIRE 1: PLACE"
  return
end sub

sub DozoCursor:
  X = PtX[Pt]
  Y = PtY[Pt]
  N = frame
  N &= 16
  if N = 0 then
    V = Bd[Pt]
    N = Empty
    if V > 0 then N = V + 127
    if V = 0 then N = Piece + 127
  else
    N = 32
  end if
  put char N at X,Y
  return
end sub

' The pieces at the left, the chosen one marked, with what is left
sub ShowPieces:
  for K = 1 to 4
    Y = K * 2
    Y += 5
    N = K + 127
    put char N at 3,Y
    V = 32
    if K = Piece then V = 62
    put char V at 2,Y
    N = K - 1
    NumU = Used[N]
    NumU = 7 - NumU
    print at 5,Y, digits$(NumU, 1)
  next
  return
end sub

sub FlashWin:
  for K = 1 to 6
    X = PtX[BestPt]
    Y = PtY[BestPt]
    put char 32 at X,Y
    X = PtX[WinA]
    Y = PtY[WinA]
    put char 32 at X,Y
    X = PtX[WinB]
    Y = PtY[WinB]
    put char 32 at X,Y
    wait 15 frames
    DrawDozo
    wait 15 frames
  next
  return
end sub

' One move per push of the stick (Stick 1 up, 2 down, 3 left, 4 right)
sub ReadStepStick:
  nmi on
  wait
  N = 0
  if joypad(1).up then N = 1
  if joypad(1).down then N = 2
  if joypad(1).left then N = 3
  if joypad(1).right then N = 4
  Stick = 0
  if N <> LastStick then Stick = N
  LastStick = N
  return
end sub

sub KeyRelease:
kr_loop:
  wait
  N = keypad(1)
  if N <> 255 then goto kr_loop
  return
end sub

sub Page:
  nmi on
  fill mode 2 text color with $F0
  LoadTiles
  cls
  backdrop dark blue
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 416 to vram.pattern + Dst16
    copy TileCol count 416 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub EditorialPage:
  Page
  backdrop white
  fill mode 2 text color with $10
  LoadTiles
  print at 8,1, "STRATEGY PUZZLES"
  print at 3,3, "FROM 41 1/2 FUN PROJECTS"
  print at 3,4, "FOR THE ATARI, BY DALE"
  print at 3,5, "DISHAROON AND HERBERT KOHL"
  print at 3,6, "(RESTON, 1984)"
  print at 2,8, "THREE GAMES OF THOUGHT, NOT"
  print at 2,9, "LUCK: THE PATTERN GAME, THE"
  print at 2,10, "NUMBER PUZZLERS OF SAM"
  print at 2,11, "LOYD'S DAY, AND DOZO, A"
  print at 2,12, "WARM-UP OF THE GO MASTERS."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  return
end sub

