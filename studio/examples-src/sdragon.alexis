  $00,$01,$01,$01,$03,$03,$07,$0D,$1D,$3F,$7F,$FF,$DB,$60,$00,$00
  $00,$80,$80,$80,$C0,$C0,$E0,$B0,$B8,$FC,$FE,$FF,$DB,$06,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$01,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$80,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$01,$02,$04,$08,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$10,$20,$40,$80,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$20,$10,$08,$04,$02,$01
  $00,$00,$00,$00,$80,$40,$20,$10,$08,$04,$00,$00,$00,$00,$00,$00
  $01,$03,$03,$87,$6F,$3F,$33,$33,$3F,$7F,$3F,$1F,$1E,$38,$60,$00
  $00,$80,$80,$C2,$EC,$F8,$98,$98,$F8,$FC,$F8,$F0,$F0,$38,$0C,$00
  $00,$03,$23,$17,$0F,$7F,$33,$33,$3F,$3F,$7F,$1F,$1D,$30,$40,$00
  $00,$80,$88,$D0,$E0,$FC,$98,$98,$F8,$F8,$FC,$F0,$70,$18,$04,$00
  $01,$03,$01,$01,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $80,$C0,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$01,$03,$03,$01,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$80,$C0,$C0,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$01,$01,$09,$05,$3F,$05,$09,$01,$01,$00,$00,$00,$00
