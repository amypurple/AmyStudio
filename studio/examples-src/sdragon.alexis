const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndPing = 4
const SndHit = 5
const SndBoom = 6
const SndClear = 7
const SndOver = 8
const SndWin = 9
const NSpr = 9
const NBody = 14
const GunY = 160
const XMin = 4096
const XMax = 57344
const YMax = 40960
' the floor line the head bounces off, 3 rows above the gun (unless diving)
const YFloor = 34816

data TilePat bytes
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $10,$10,$54,$38,$01,$38,$54,$10
  $00,$44,$28,$10,$83,$10,$28,$44
  $00,$60,$40,$01,$01,$01,$01,$00
  $00,$AA,$00,$44,$00,$00,$00,$00
end data
data TileCol bytes
  $81,$81,$81,$81,$18,$81,$81,$81
  $01,$81,$81,$81,$18,$81,$81,$81
  $71,$71,$71,$71,$17,$71,$71,$71
  $01,$71,$71,$71,$17,$71,$71,$71
