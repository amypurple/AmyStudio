  $01,$51,$51,$51,$15,$51,$51,$51
  $B1,$B1,$B1,$B1,$1B,$B1,$B1,$B1
  $01,$B1,$B1,$B1,$1B,$B1,$B1,$B1
  $05,$F5,$F5,$15,$15,$15,$14,$01
  $02,$C2,$0C,$C1,$01,$01,$01,$01
