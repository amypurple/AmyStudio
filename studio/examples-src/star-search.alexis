cartridge "STAR SEARCH/JIM SANDERS/1986"

' STAR SEARCH
' A ColecoVision game based on "Star Search" by Jim Sanders, Ahoy! May 1986
' (Commodore 64, BASIC with a machine-language star mover and sky
' scroller loaded by STAR SEARCH BOOT; author from the title screen, whose
' "BY JIM SANDERS" is written in the program's own cipher letters). Made
' for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/STAR SEARCH.bas and orig/STAR SEARCH BOOT.bas), the game is
' built for the ColecoVision: smooth 16 x 16 sprites, a three-layer star
' field that scrolls, tiled gauges, sound effects and an original tune.
'
' The game ("MISSION: STAR SEARCH"): rogue stars drift across the sky and
' shake the solar system with tremors. Move the gamma gun left and right
' along the foot of the sky and fire gamma rays up at them. A hit destroys
' a star; a ray that reaches the top of the sky is a miss and burns one of
' the 22 ammo cells. Three hits in a row win back a cell and calm three
' tremors. SCORE = 10 x (hits - misses) + a bonus of up to 10 for the
' height of the last hit. Score over 300: the solar system is saved. No
' ammo left, or 16 tremors: the mission ends.
'
' From the original: the five stars (the C64's sprites 0-4) at fixed rows
' (a random height plus 8 more for each star, rolled once a game) and
' start columns 25 pixels apart; stars 0 and 1 drift right and 2 and 3
' left at random speeds of 0-3 (the boot's machine code), star 4 still;
' a random set of the stars is in the sky for each shot (64 + RND*30 in
' the sprite enable register), a hit star goes and a new set is drawn
' after a hit, the same set stays after a miss; one ray at a time, fired
' while the button is held, travelling 120 pixels; the gun's 5-pixel
' steps between the frame's sides; HITS, SCORE and MISSES on screen; the
' score formula (H - MS) * 10 + A / 2 and the win at more than 300; 22
' ammo cells, the last 6 shown red, a miss spends one, three hits in a
' row give one back (if not full) and take 3 off the tremor count; a
' tremor, rolled 1 in 50 on each pass of the main loop while no ray is
' out, shakes the screen with a rumble; warnings at 4, 8 and 12 tremors;
' more than 15 ends the game "CONDITION: ERADICATED"; out of ammo ends it
' with STARS DESTROYED, SCORE and TIME; a win shows "SOLAR SYSTEM SAVED".
'
' Liberties: the speeds are per frame: the gun moves 1 pixel a frame,
' the ray 3 (40 steps of the original's 6-pixel moves become 32 steps of
' 3 to the top of the sky, the bonus is steps / 3, still 0-10), a star
' drifts 0-1.5 pixels a frame. A tremor is rolled 1 in 256 each frame
' with no ray out (about every 4 seconds of aiming) and lasts 30 frames.
' The stars' speeds are rolled again every 256 frames: on the C64 they
' changed only when star 0 stood exactly at X 55, so a star 0 rolled at
' speed 0 kept every speed fixed for the whole game. The gun can move
' while the ray flies (the C64 froze it; the ray keeps its own column).
' Three hits in a row always calm 3 tremors, and win back a cell only
' when one is spent: on the C64 a streak with full ammo never reset, so it
' calmed nothing until a miss. Star 5 (never enabled on the C64) is left
' out. The stars wrap inside the frame (columns 3-28) instead of across
' the whole C64 sprite range. The tremor gauge shows all 16 steps (the
' C64 showed one coloured block at 4, 8 and 12). Time is shown in seconds
' instead of "centons". The C64's ANOTHER TRY Y/N is replaced by the
' house ending (a press goes back to the title).
'
' Controls: either controller; the stick left and right moves the gun,
' either button fires. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TFrl = 128
const TFrt = 129
const TFrtl = 130
const TFrtr = 131
const TFrbl = 132
const TFrbr = 133
const TFrb = 134
const TDeck = 135
const TCell = 136
const TCellow = 137
const TCellx = 138
const TTrq = 139
const TTry = 140
const TTro = 141
const TTrr = 142
const TPla00 = 143
const TPla01 = 144
const TPla10 = 145
const TPla11 = 146
const TMoon = 147
const TSk00 = 148
const TSk01 = 149
const TSk02 = 150
const TSk03 = 151
const TSk10 = 152
const TSk11 = 153
const TSk12 = 154
const TSk13 = 155
const TSk20 = 156
const TSk21 = 157
const TSk22 = 158
const TSk23 = 159
const TLgS00 = 160
const TLgS01 = 161
const TLgS10 = 162
const TLgS11 = 163
const TLgT00 = 164
const TLgT01 = 165
const TLgT10 = 166
const TLgT11 = 167
const TLgA00 = 168
const TLgA01 = 169
const TLgA10 = 170
const TLgA11 = 171
const TLgR00 = 172
const TLgR01 = 173
const TLgR10 = 174
const TLgR11 = 175
const TLgE00 = 176
const TLgE01 = 177
const TLgE10 = 178
const TLgE11 = 179
const TLgC00 = 180
const TLgC01 = 181
const TLgC10 = 182
const TLgC11 = 183
const TLgH00 = 184
const TLgH01 = 185
const TLgH10 = 186
const TLgH11 = 187
const SGunl = 0
const SGun = 4
const SRay = 8
const SSt0 = 12
const SSt1 = 16
const SSt2 = 20
const SSt3 = 24
const SSt4 = 28
const SBurst0 = 32
const SBurst1 = 36
const NTiles8 = 480
const SprBytes = 320
const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndBurst = 4
const SndMiss = 5
const SndRumble = 6
const SndCell = 7
const SndStart = 8
const SndLose = 9
const SndWin = 10
const NSpr = 8
const NStars = 5
const PlY = 128
const PxMin = 24
const PxMax = 208
const RayY0 = 118
const RayN = 32
const RaySpd = 3
const StL = 24
const StR = 216
const AmmoMax = 22
const AmmoLow = 6
const TremMax = 15
const QuakeN = 30
const BurstN = 16
const WinScore = 300

' the stars' start columns (the C64's 55 + 25 * n, moved to the CV)
data StX0 bytes
  31, 56, 81, 106, 131
end data
' drift direction by star: 1 right, 2 left, 0 still
data StDir bytes
  1, 1, 2, 2, 0
end data
data StCol bytes
  11, 9, 7, 13, 15
end data
data StPat bytes
  12, 16, 20, 24, 28
end data

record Star:
  u8 X
  u8 Y
  u8 Sp
  u8 Ph
end record

Star St[5]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u16 Secs = 0
u8 SecT = 0
i16 Score = 0
i16 Best = 0
bcd digits 4 Hits = 0
u8 Misses = 0
u8 HitN = 0
u8 Ammo = 22
u8 Tremor = 0
u8 Streak = 0
u8 Bonus = 0
' the gun
u8 Px = 108
' the ray: in flight, top row, steps, column
u8 RayOn = 0
u8 Ry = 0
u8 RaySt = 0
u8 Rx = 0
' the stars in the sky (bit n = star n), the speed clock
u8 Vis = 0
u8 SpT = 0
' a star bursting: frames left, which, where
u8 BurstT = 0
u8 BurstI = 0
u8 BurstX = 0
u8 BurstY = 0
' a tremor: frames left
u8 QuakeT = 0
' the end: 1 out of ammo, 2 eradicated, 3 saved
u8 Over = 0
u8 GPh[3]
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Si = 0
u8 Ri = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  ScrollSky
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Score > Best then Best = Score
  mute all
  HideSprites
  EndPage
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc SecT
  if SecT >= 60 then
    SecT = 0
    inc Secs
  end if
  if BurstT > 0 then dec BurstT
  if QuakeT > 0 then
    dec QuakeT
    if QuakeT = 0 then EndQuake
    return
  end if
  MoveStars
  MoveGun
  if RayOn = 1 then
    RayStep
  else
    ' a tremor is rolled only while no ray is out (as on the C64)
    Rand
    V = Rs & 255
    if V = 0 then
      QuakeT = QuakeN
      play sound SndRumble
      return
    end if
    K = J1 | J2
    V = K & 16
    if V > 0 then ShootRay
  end if
  return
end sub

sub EndQuake:
  inc Tremor
  ShowTremor
  if Tremor > TremMax then Over = 2
  return
end sub

sub ShootRay:
  RayOn = 1
  RaySt = 0
  Ry = RayY0
  Rx = Px
  play sound SndZap
  return
end sub

' the ray climbs RaySpd pixels a step; a star in the sky under it is hit
sub RayStep:
  u8 Who = 0
  inc RaySt
  Ry = Ry - RaySpd
  Who = RayHits
  if Who < NStars then
    StarDown(Who)
    return
  end if
  if RaySt >= RayN then MissShot
  return
end sub

' which star the ray's tip is in (NStars: none)
function RayHits as u8
  u8 Q = 0
  u8 Mask = 1
  u8 Cx = 0
  u8 Sy = 0
  Cx = Rx + 8
  for Q = 0 to 4
    V = Vis & Mask
    if V > 0 then
      Sy = St[Q].Y
      if absdiff(St[Q].X + 8, Cx) <= 5 then
        if Ry + 1 >= Sy + 2 then
          if Ry + 1 <= Sy + 13 then return Q
        end if
      end if
    end if
    Mask = Mask << 1
  next
  return NStars

sub StarDown(u8 Which):
  u8 Bit = 0
  Bit = 1 << Which
  Vis = Vis & (255 - Bit)
  BurstT = BurstN
  BurstI = Which
  BurstX = St[Which].X
  BurstY = St[Which].Y
  Hits += 1
  inc HitN
  Bonus = RaySt / 3
  inc Streak
  if Streak = 3 then
    Streak = 0
    if Ammo < AmmoMax then
      inc Ammo
      play sound SndCell
    else
      play sound SndBurst
    end if
    if Tremor > 3 then
      Tremor = Tremor - 3
    else
      Tremor = 0
    end if
    ShowAmmo
    ShowTremor
  else
    play sound SndBurst
  end if
  NewSet
  RayOn = 0
  ScoreUp
  return
end sub

sub MissShot:
  RayOn = 0
  inc Misses
  Streak = 0
  Bonus = 0
  dec Ammo
  ShowAmmo
  play sound SndMiss
  ScoreUp
  if Ammo = 0 then Over = 1
  return
end sub

' SCORE = 10 x (hits - misses) + the last hit's bonus
sub ScoreUp:
  i16 H = 0
  H = NetHits
  Score = H * 10
  Score = Score + Bonus
  ShowHud
  if Score > WinScore then
    if Over = 0 then Over = 3
  end if
  return
end sub

' hits less misses (can be below zero)
function NetHits as i16
  i16 R = 0
  R = HitN
  R = R - Misses
  return R

' a new random set of stars (1-31, never empty)
sub NewSet:
  Rand
  V = Rs & 31
  if V = 0 then V = 31
  Vis = V
  return
end sub

sub MoveGun:
  K = J1 | J2
  V = K & 4
  if V > 0 then
    if Px > PxMin then dec Px
  end if
  V = K & 8
  if V > 0 then
    if Px < PxMax then inc Px
  end if
  return
end sub

' stars 0-1 drift right, 2-3 left, by Sp half pixels a frame; 4 is still
sub MoveStars:
  u8 Sx = 0
  u8 D = 0
  inc SpT
  if SpT = 0 then RollSpeeds
  for Si = 0 to 4
    D = StDir[Si]
    if D = 0 then continue for
    Sx = St[Si].X
    V = St[Si].Ph + St[Si].Sp
    St[Si].Ph = V & 1
    V = V >> 1
    select case D
    case 1
      Sx = Sx + V
      if Sx > StR then Sx = StL
    case else
      Sx = Sx - V
      if Sx < StL then Sx = StR
    end select
    St[Si].X = Sx
  next
  return
end sub

sub RollSpeeds:
  for Si = 0 to 4
    Rand
    St[Si].Sp = Rs & 3
  next
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the three sky layers roll left: the far one every 8 frames, then 4, 2
sub ScrollSky:
  for Gi = 0 to 2
    V = 8 >> Gi
    V = V - 1
    U = Tick & V
    if U = 0 then
      V = GPh[Gi] + 1
      V = V & 31
      GPh[Gi] = V
      W16 = Gi << 5
      W16 = (W16 + V) << 5
      A16 = Gi << 5
      A16 = A16 + (TSk00 << 3)
      copy SkyPat + W16 count 32 to vram.pattern + A16
      copy SkyPat + W16 count 32 to vram.pattern + 2048 + A16
      copy SkyPat + W16 count 32 to vram.pattern + 4096 + A16
    end if
  next
  return
end sub

' sprites 0-1 the gun, 2 the ray, 3-7 the stars; a tremor shakes them
sub DrawSprites:
  u8 Sh = 0
  u8 Mask = 1
  if QuakeT > 0 then
    V = QuakeT >> 2
    V = V & 1
    Sh = V << 2
  end if
  Y = PlY - 1
  X = Px + Sh
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  else
    set sprite 0 to Y,X,SGunl,11
    set sprite 1 to Y,X,SGun,14
  end if
  if RayOn = 1 then
    Y = Ry - 1
    set sprite 2 to Y,Rx,SRay,15
  else
    set sprite 2 to 192,0,0,0
  end if
  for Si = 0 to 4
    J = Si + 3
    V = Vis & Mask
    X = St[Si].X + Sh
    Y = St[Si].Y - 1
    if BurstT > 0 then
      if BurstI = Si then
        V = 0
        K = BurstT >> 3
        K = K & 1
        K = K << 2
        K = K + SBurst0
        X = BurstX + Sh
        Y = BurstY - 1
        set sprite J to Y,X,K,10
        Mask = Mask << 1
        continue for
      end if
    end if
    if V > 0 then
      K = StPat[Si]
      C = StCol[Si]
      set sprite J to Y,X,K,C
    else
      set sprite J to 192,0,0,0
    end if
    Mask = Mask << 1
  next
  update sprites
  return
end sub

' a signed score: sign then three digits
sub PrintScore(u8 Col, u8 Row):
  i16 S = 0
  S = Score
  if S < 0 then
    put char 45 at Col,Row
    S = 0 - S
  else
    put char 32 at Col,Row
  end if
  NumU = S
  N = Col + 1
  print at N,Row, digits$(NumU, 3)
  return
end sub

sub ShowHud:
  print at 2,1, "HITS"
  print at 7,1, Hits
  print at 12,1, "SCORE"
  PrintScore(18, 1)
  print at 23,1, "MISS"
  NumU = Misses
  print at 28,1, digits$(NumU, 2)
  return
end sub

' 22 ammo cells: green, the last six red, spent ones dark
sub ShowAmmo:
  u8 Cell = 0
  for Ri = 0 to 21
    if Ri >= Ammo then
      Cell = TCellx
    elseif Ammo <= AmmoLow then
      Cell = TCellow
    else
      Cell = TCell
    end if
    X = Ri + 7
    put char Cell at X,20
  next
  return
end sub

function TremTile(u8 Seg) as u8
  if Seg >= Tremor then return TTrq
  select case Seg
  case 0 to 7
    return TTry
  case 8 to 11
    return TTro
  case else
    return TTrr
  end select
  return TTrr

sub ShowTremor:
  for Ri = 0 to 15
    T = TremTile(Ri)
    X = Ri + 10
    put char T at X,21
  next
  return
end sub

' the frame, the sky and the gun's deck
sub DrawField:
  put char TFrtl at 2,2
  fill TFrt count 26 at 3,2
  put char TFrtr at 29,2
  for Ri = 3 to 18
    put char TFrl at 2,Ri
    put char TFrl at 29,Ri
    V = Ri % 3
    U = V << 2
    U = U + TSk00
    for J = 3 to 28
      V = J & 3
      T = U + V
      put char T at J,Ri
    next
  next
  fill TDeck count 26 at 3,18
  put char TFrbl at 2,19
  fill TFrb count 26 at 3,19
  put char TFrbr at 29,19
  return
end sub

sub DrawPlanets:
  put char TPla00 at 6,5
  put char TPla01 at 7,5
  put char TPla10 at 6,6
  put char TPla11 at 7,6
  put char TMoon at 24,10
  return
end sub

sub NewGame:
  Score = 0
  Hits = 0
  HitN = 0
  Misses = 0
  Ammo = AmmoMax
  Tremor = 0
  Streak = 0
  Bonus = 0
  Secs = 0
  SecT = 0
  Px = 108
  RayOn = 0
  BurstT = 0
  QuakeT = 0
  SpT = 0
  for Si = 0 to 4
    St[Si].X = StX0[Si]
    Rand
    V = Rs & 63
    W16 = Si << 3
    St[Si].Y = V + 24 + W16
    St[Si].Ph = 0
  next
  RollSpeeds
  NewSet
  NewScreen
  DrawField
  DrawPlanets
  ShowHud
  print at 2,20, "AMMO"
  print at 2,21, "TREMOR"
  ShowAmmo
  ShowTremor
  Over = 0
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' the end of the mission, over the sky
sub EndPage:
  for Ri = 5 to 15
    fill 32 count 22 at 5,Ri
  next
  print at 7,6, "MISSION: STAR SEARCH"
  select case Over
  case 3
    print at 6,8, "SOLAR SYSTEM SAVED!"
    play sound SndWin
  case 2
    print at 6,8, "CONDITION:"
    print at 9,9, "ERADICATED"
    play sound SndLose
  case else
    print at 6,8, "OUT OF AMMO"
    play sound SndLose
  end select
  print at 6,11, "STARS DESTROYED"
  print at 22,11, Hits
  print at 6,12, "SCORE"
  PrintScore(22, 12)
  print at 6,13, "TIME"
  NumU = Secs
  print at 18,13, digits$(NumU, 4)
  print at 23,13, "SEC"
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  for Gi = 0 to 2
    GPh[Gi] = 0
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' STAR SEARCH in the original's letters, two tiles by two each
sub DrawLogo:
  u16 Ix = 0
  u8 L = 0
  u8 Lx = 0
  u8 Ly = 0
  u8 Col = 0
  for L = 0 to 9
    Col = L << 1
    Col = Col + 5
    if L >= 4 then Col = Col + 2
    Ix = L << 2
    for Ly = 0 to 1
      for Lx = 0 to 1
        T = LogoT[Ix + (Ly << 1) + Lx]
        X = Col + Lx
        Y = Ly + 5
        put char T at X,Y
      next
    next
  next
  return
end sub

' the title: the logo, drifting stars, the tune once, START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawField
  DrawPlanets
  for Ri = 8 to 16
    fill 32 count 24 at 4,Ri
  next
  DrawLogo
  print at 9,9, "BY JIM SANDERS"
  print at 10,12, "START GAME"
  print at 10,13, "CREDITS"
  print at 8,16, "AHOY! MAY 1986"
  print at 2,1, "BEST SCORE"
  Score = Best
  PrintScore(13, 1)
  ShowMenu
  for Si = 0 to 4
    St[Si].X = StX0[Si] + 40
    St[Si].Y = 24
    St[Si].Ph = 0
    St[Si].Sp = Si & 1
  next
  St[0].Y = 112
  St[1].Y = 112
  St[2].Y = 112
  Vis = 7
  RayOn = 0
  BurstT = 0
  QuakeT = 0
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ScrollSky
  MoveStars
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 8,12
  put char 32 at 8,13
  J = Menu + 12
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "STAR SEARCH"
  print at 2,5, "BASED ON STAR SEARCH BY"
  print at 2,6, "JIM SANDERS, AHOY! MAY 1986"
  print at 2,7, "(COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: GAMMA WATCH"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

