u8 I = 0
u8 Tile = 0
u16 Offset = 0
u8 Wall[64]

data WallPatterns bitmap8
  "XXX.XXXX"
  "XXX.XXXX"
  "XXX.XXXX"
  "........"
  "XXXXXXX."
  "XXXXXXX."
  "XXXXXXX."
  "........"
  "XXXXXXX."
  "X..X..XX"
  "X..X..XX"
  "X..X..XX"
  "X..X..XX"
  "X..X..XX"
  "XXXXXXXX"
  ".XXXXXXX"
end data

data WallColors bytes
  $6E,$6E,$6E,$6E,$6E,$6E,$6E,$6E
  $F1,$F5,$F5,$F4,$F4,$F4,$F1,$F1
end data

  text screen
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "VRAM COPY"
  print centered at 9, "BULK READBACK"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  tile screen
  define chars WallPatterns at 16 count 2
  define colors WallColors at 16 count 2
  cls
  for I = 0 to 63
    vpoke vram.name + I, random(2) + 16
  next
  copy vram.name count 64 to Wall
  for Offset = 64 to 704 step 64
    copy Wall count 64 to vram.name + Offset
  next
  screen on