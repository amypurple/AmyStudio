u8 Crashed = 0
' the pulses: cell index, column, row, steps across and down (0-15),
' direction (0 right, 1 left, 2 up, 3 down)
u8 PCel[8]
u8 PX[8]
u8 PY[8]
u8 SX[8]
u8 SY[8]
u8 PD[8]
' input
u8 Pads = 0
u8 OldPads = 0
u8 Act = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
u16 Steps = 0
' loop counters (never shared with the helpers)
u8 Pk = 0
u8 Ci = 0
u8 Si = 0
u8 Ti = 0
' scratch
u8 C = 0
u8 D = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tl = 0
u8 Sp = 0
u8 Sh = 0
u8 Da = 0

  tile screen
  set sound table CuSoundTable areas 6
  sprites 16x16
  sprites flicker on
  set sprite count 9
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 2 then goto title
  NewGame

play_loop:
  Frame1
  ReadPads
  PlayStep
  DrawPulses
  if Phase = 0 then goto play_loop
  if Phase = 1 then
    LoseLife
  else
    BoardDone
  end if
  if Over = 0 then goto play_loop

  ' the end: GAME OVER over the board, then back to the title on a press
  print at 9,MsgRow, " GAME  OVER "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------

sub NewGame:
  Score = 0
  NP = Pulses
  Lvl = 0
  Lives = 3
  Over = 0
  StartBoard
  return
end sub

' a board: copied from ROM, counted, drawn; safeties back to three
sub StartBoard:
  Off = Lvl
  Off = Off * NCell
  copy Maps + Off count NCell to Map
  NPyr = 0
  RMax = 0
  Gone = 0
  for Ci = 0 to NCell - 1
    T = Map[Ci]
    if T = $21 then inc NPyr
    if T >= $26 then
      if T >= RMax then RMax = T + 1
    end if
  next
  Safes = 3
  DrawBoard
  StartPulses
  return
end sub

sub StartPulses:
  for Pk = 0 to 7
    V = Lvl * 8 + Pk
    T = StartPos[V]
    PX[Pk] = T & 15
    PY[Pk] = T >> 4
    PCel[Pk] = PY[Pk] * 17 + PX[Pk]
    D = StartDir[V]
    PD[Pk] = D
    if D >= 2 then
      SX[Pk] = 5
      SY[Pk] = 0
    else
      SX[Pk] = 0
      SY[Pk] = 5
    end if
  next
  Delay = StartWait
  Acc = 0
  SafeT = 0
  Phase = 0
  Crashed = 255
  return
end sub

' one pass of play: the stick, the safety's clock, the pulses' steps
sub PlayStep:
  select case Act
  case 1
    Toggle($15, $16)
    play sound SndBridge
  case 2
    Toggle($0D, $0E)
    play sound SndShunt
  case 4
    Toggle($0B, $0C)
    play sound SndShunt
  case 8
    CyclePads
    play sound SndPads
  case 16
    if SafeT = 0 then
      if Safes > 0 then
        dec Safes
        SafeT = SafeLen
        play sound SndSafe
        ShowStatus
      end if
    end if
  end select
  if SafeT > 0 then
    dec SafeT
    if SafeT = 0 then ShowStatus
  end if
  Acc = Acc + 7
  while Acc >= 20
    Acc = Acc - 20
    if Phase = 0 then
      if Delay > 0 then
        dec Delay
      else
        MovePulses
      end if
    end if
  end while
  return
end sub

' throw every switch of one kind: A <-> B
sub Toggle(u8 A, u8 B):
  for Ti = 0 to NCell - 1
    T = Map[Ti]
    if T = A then
      Map[Ti] = B
      DrawCell(Ti)
    else
      if T = B then
        Map[Ti] = A
        DrawCell(Ti)
      end if
    end if
  next
  return
end sub

' the second pads ($26 and up) take the next colour, round to $26
sub CyclePads:
  for Ti = 0 to NCell - 1
    T = Map[Ti]
    if T >= $26 then
      inc T
      if T = RMax then T = $26
      Map[Ti] = T
      DrawCell(Ti)
    end if
  next
  return
end sub

' every pulse a step, the last one first (as the C64 did)
sub MovePulses:
  inc Steps
  Pk = NP
  while Pk > 0
    dec Pk
    StepOne
    if Phase <> 0 then Pk = 0
  end while
  return
end sub

sub StepOne:
  D = PD[Pk]
  select case D
  case 0
    Sp = SX[Pk] + 1
    if Sp = 16 then
      Sp = 0
      inc PCel[Pk]
      inc PX[Pk]
    end if
    SX[Pk] = Sp
    Sh = 8
    Da = 8
  case 1
    Sp = SX[Pk]
    if Sp = 0 then
      Sp = 15
      dec PCel[Pk]
      dec PX[Pk]
    else
      dec Sp
    end if
    SX[Pk] = Sp
    Sh = 8
    Da = 12
  case 2
    Sp = SY[Pk]
    if Sp = 0 then
      Sp = 15
      PCel[Pk] = PCel[Pk] - 17
      dec PY[Pk]
    else
      dec Sp
    end if
    SY[Pk] = Sp
    Sh = 0
    Da = 4
  case else
    Sp = SY[Pk] + 1
    if Sp = 16 then
      Sp = 0
      PCel[Pk] = PCel[Pk] + 17
      inc PY[Pk]
    end if
    SY[Pk] = Sp
    Sh = 0
    Da = 0
  end select
  Tl = Map[PCel[Pk]]
  ' a bridge set the other way
  if Tl = $16 then
    if D < 2 then
      Crash
      return
    end if
  end if
  if Tl = $15 then
    if D >= 2 then
      Crash
      return
    end if
  end if
  if Tl >= $1F then
    if Tl < $22 then
      PyrHit
      return
    end if
  end if
  if Sp <> 5 then return
  ' the cell's turn, at its 5th step
  if Tl >= 3 then
    if Tl <= 10 then D = TurnT[Sh + Tl - 3]
  end if
  if Tl >= 11 then
    if Tl <= 14 then
      V = ShuntT[Da + Tl - 11]
      if V <> 5 then D = V
    end if
  end if
  PD[Pk] = D
  select case Tl
  case $17
    PD[Pk] = D ^ 1
  case $18
    Crash
  case else
    if Tl >= $22 then Warp
  end select
  return
end sub

' a crash: with a safety on the pulse only bounces back
sub Crash:
  if SafeT > 0 then
    PD[Pk] = PD[Pk] ^ 1
    play sound SndBounce
  else
    Crashed = Pk
    Phase = 1
  end if
  return
end sub

sub PyrHit:
  C = PCel[Pk]
  T = Map[C] - 1
  Map[C] = T
  AddScore(1)
  if T = $1E then
    Map[C] = $18
    AddScore(2)
    inc Gone
    play sound SndBoom
  else
    play sound SndHit
  end if
  DrawCell(C)
  ShowStatus
  if Gone = NPyr then
    Phase = 2
  else
    PD[Pk] = PD[Pk] ^ 1
  end if
  return
end sub

' a pad: out of the first cell holding its partner, going back
sub Warp:
  if Tl >= $26 then
    T = Tl - 4
  else
    T = Tl + 4
  end if
  C = FindCell(T)
  if C < NCell then
    PCel[Pk] = C
    PX[Pk] = C mod 17
    PY[Pk] = C / 17
    play sound SndWarp
  end if
  PD[Pk] = PD[Pk] ^ 1
  return
end sub

function FindCell(u8 Want) as u8
  for Si = 0 to NCell - 1
    if Map[Si] = Want then return Si
  next
  return 255

' points: kind 1 a hit (10), 2 a pyramid (100), 3 a board (1000), 4 all
' five boards (10000), each times the number of pulses
sub AddScore(u8 Kind):
  for Si = 1 to NP
    select case Kind
    case 1
      Score += 10
    case 2
      Score += 100
    case 3
      Score += 1000
    case else
      Score += 10000
    end select
  next
  return
end sub

sub LoseLife:
  play sound SndCrash
  ShowSpark
  dec Lives
  ShowStatus
  if Lives = 0 then
    Over = 1
    if Score > Hi then Hi = Score
    ShowStatus
    return
  end if
  print at 9,MsgRow, "CIRCUIT CRASH"
  Pause(60)
  StartPulses
  RedrawRow(MsgRow)
  return
end sub

sub BoardDone:
  HideSprites
  play sound SndClear
  AddScore(3)
  print at 9,MsgRow, " SHUT DOWN! "
  inc Lvl
  if Lvl = 5 then
    Lvl = 0
    AddScore(4)
    if NP < 8 then inc NP
  end if
  if Score > Hi then Hi = Score
  ShowStatus
  Pause(120)
  StartBoard
  return
end sub

sub Pause(u8 Fr):
  for Ti = 1 to Fr
    Frame1
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawBoard:
  NewScreen
  for Ci = 0 to NCell - 1
    DrawCell(Ci)
  next
  print at 2,1, "SCORE"
  print at 18,1, "HIGH"
  print at 25,4, "UP"
  print at 24,5, "BRIDGE"
  print at 24,7, "LEFT"
  print at 24,8, "SHUNT"
  put char TCell + $16 at 29,7
  put char TCell + $17 at 29,8
  print at 24,10, "DOWN"
  print at 24,11, "SHUNT"
  put char TCell + $1A at 29,10
  put char TCell + $1B at 29,11
  print at 24,13, "RIGHT"
  print at 24,14, "PADS"
  print at 24,16, "FIRE"
  print at 24,17, "SAFE"
  print at 2,4, "BOARD"
  print at 2,7, "PULSE"
  print at 2,10, "PYRA-"
  print at 2,11, "MIDS"
  print at 2,14, "LIVES"
  print at 2,17, "SAFE"
  ShowStatus
  DrawPulses
  ShowScreen
  return
end sub

' a cell's two tiles; the chip's side edges share codes with the
' damaged pyramids, told apart by the chip beside them
sub DrawCell(u8 I):
  T = Map[I]
  K = TCell + T * 2
  if T = $20 then
    V = Map[I + 1]
    if V = $1F then K = TChipL
    if IsChip(V) = 1 then K = TChipL
  end if
  if T = $1F then
    V = Map[I - 1]
    if V = $20 then K = TChipR
    if IsChip(V) = 1 then K = TChipR
  end if
  X = I mod 17
  Y = I / 17
  X = X + BoardC
  Y = Y * 2 + BoardR
  put char K at X,Y
  put char K + 1 at X,Y + 1
  return
end sub

function IsChip(u8 Cd) as u8
  if Cd >= 7 then
    if Cd <= 10 then return 1
  end if
  select case Cd
  case $10, $11, $12, $17
    return 1
  end select
  return 0

' a row of the board again (after a message)
sub RedrawRow(u8 R):
  N = R - BoardR
  N = N / 2
  C = N * 17
  for Si = 0 to 16
    DrawCell(C + Si)
  next
  return
end sub

sub ShowStatus:
  print Score at 8,1
  print Hi at 23,1
  print at 3,5, digits$(Lvl + 1, 1)
  print at 3,8, digits$(NP, 1)
  N = NPyr - Gone
  print at 3,12, digits$(N, 2)
  for Si = 0 to 2
    if Si < Lives then
      put char TLife at 2 + Si,15
    else
      put char 32 at 2 + Si,15
    end if
    if Si < Safes then
      put char TSafe at 2 + Si,18
    else
      put char 32 at 2 + Si,18
    end if
  next
  if SafeT > 0 then
    print at 2,19, "ON "
  else
    print at 2,19, "   "
  end if
  return
end sub

' the pulses: sprite x from the steps across (half a pixel each), y from
' the steps down; step 5 is the cell's middle
sub DrawPulses:
  if SafeT > 0 then
    C = 15
  else
    C = 11
  end if
  for Si = 0 to 7
    if Si < NP then
      X = PX[Si] * 8 + 45
      X = X + ((SX[Si] + 11) >> 1)
      Y = PY[Si] * 16 + 19
      Y = Y + SY[Si]
      set sprite Si to Y,X,SPulse,C
    else
      set sprite Si to 207,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowSpark:
  if Crashed < 8 then
    X = PX[Crashed] * 8 + 45
    X = X + ((SX[Crashed] + 11) >> 1)
    Y = PY[Crashed] * 16 + 19
    Y = Y + SY[Crashed]
    set sprite 8 to Y,X,SSpark,9
    update sprites
  end if
  Pause(40)
  set sprite 8 to 207,0,0,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' input: Pads is either controller (1 up, 2 down, 4 left, 8 right, 16 a
' button); Act is a change to one single direction or the button alone

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  Act = 0
  if Pads <> OldPads then
    select case Pads
    case 1, 2, 4, 8, 16
      Act = Pads
    end select
  end if
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites flicker on
  for K = 0 to 8
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: CIRCUITS over a strip of board, START / PULSES / CREDITS

sub TitlePage:
  NewScreen
  print at 12,3, "CIRCUITS"
  print at 10,5, "BY ERIC HAINES"
  ' a strip of board: a wire with a shunt, a bridge, a pad, a pyramid
  for Si = 0 to 16
    K = TCell + 2
    select case Si
    case 4
      K = TCell + $1A
    case 8
      K = TCell + $2A
    case 12
      K = TCell + $44
    case 16
      K = TCell + $42
    end select
    put char K at BoardC + Si,9
    put char K + 1 at BoardC + Si,10
  next
  Sel = 0
  ShowMenu
  print at 4,21, "STICK: SWITCH THE BOARD"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 392
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  ReadPads
  ' a pulse runs along the strip
  X = Tick & 127
  if X < 68 then
    X = X * 2 + BoardC * 8 - 7
    set sprite 0 to 71,X,SPulse,11
  else
    set sprite 0 to 207,0,0,0
  end if
  update sprites
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 2 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 4) <> 0 then
    if Pulses > 2 then dec Pulses
    play sound SndPick
    ShowMenu
  end if
  if (N & 8) <> 0 then
    if Pulses < 8 then inc Pulses
    play sound SndPick
    ShowMenu
  end if
  if (N & 16) <> 0 then goto tp_done
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Sel = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for Si = 0 to 2
    put char 32 at 9,Si + 14
  next
  put char 62 at 9,Sel + 14
  print at 11,14, "START"
  print at 11,15, "PULSES <" + digits$(Pulses, 1) + ">"
  print at 11,16, "CREDITS"
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "CIRCUITS"
  print at 2,5, "BASED ON CIRCUITS BY ERIC"
  print at 2,6, "HAINES, COMPUTE!'S GAZETTE"
  print at 2,7, "DECEMBER 1989 (COMMODORE"
  print at 2,8, "64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: LIVE WIRE"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
CuBridge:
    db $40,$47,$30,$02,$40,$5F,$40,$02,$50
CuShunt:
    db $00,$00,$44,$01,$00,$00,$65,$02,$10
CuPads:
    db $40,$7F,$30,$02,$40,$55,$30,$02,$40,$40,$40,$02,$50
CuSafe:
    db $40,$D6,$20,$03,$40,$8F,$20,$03,$40,$6B,$20,$03,$40,$47,$30,$06,$50
CuBounce:
    db $40,$35,$30,$02,$40,$47,$50,$02,$50
CuHit:
    db $40,$6B,$10,$02,$40,$55,$20,$02,$40,$47,$30,$04,$50
CuBoom:
    db $00,$00,$14,$03,$00,$00,$25,$04,$00,$00,$36,$06,$00,$00,$67,$08,$10
CuWarp:
    db $40,$18,$31,$02,$40,$8C,$30,$02,$40,$46,$30,$02,$40,$23,$40,$02,$50
CuCrash:
    db $00,$00,$04,$04,$00,$00,$15,$06,$00,$00,$36,$08,$00,$00,$57,$0A,$00,$00,$77,$0C,$10
CuClear:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05,$40,$8F,$20,$04,$40,$6B,$20,$10
    db $50
CuOver:
    db $40,$AA,$10,$0A,$40,$BF,$20,$0A,$40,$D6,$20,$0A,$40,$E2,$20,$0A,$40,$1D,$31,$1E,$50
CuPick:
    db $40,$55,$40,$02,$50

CuSoundTable:
    dw CuTuneMel,$702B
    dw CuTuneBass,$7035
    dw CuBridge,$7049
    dw CuShunt,$703F
    dw CuPads,$7049
    dw CuSafe,$7049
    dw CuBounce,$7049
    dw CuHit,$7049
    dw CuBoom,$703F
    dw CuWarp,$7049
    dw CuCrash,$703F
    dw CuClear,$7049
    dw CuOver,$7049
    dw CuPick,$7049
; Live Wire (original)
; Tiny Sound, 7 frames per step
CuTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$1C,$1F,$23,$28,$26,$23,$1F,$23,$18,$1C,$1F,$24
    db $23,$1F,$1C,$1F,$1A,$1E,$21,$26,$24,$21,$1E,$21,$17,$1B,$1E,$23
    db $21,$1E,$1B,$1E,$1C,$1F,$23,$28,$2B,$28,$23,$1F,$21,$24,$28,$2D
    db $2A,$27,$23,$01,$28,$01,$01,$01,$00,$01,$01,$01
    db $FF
CuTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$10,$01,$17,$01,$10,$01,$17,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$0B,$01,$12,$01
    db $0B,$01,$12,$01,$10,$01,$17,$01,$10,$01,$17,$01,$15,$01,$15,$01
    db $17,$01,$17,$01,$10,$01,$01,$01,$00,$01,$01,$01
    db $FF
}
