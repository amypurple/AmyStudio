u8 X = 120
u8 Y = 88

data HappyFace sprite16
  "......XXXX......"
  "....XXXXXXXX...."
  "...XXXXXXXXXX..."
  "..XXXXXXXXXXXX.."
  ".XXXXXXXXXXXXXX."
  ".XXXXXXXXXXXXXX."
  "XXXX..XXXX..XXXX"
  "XXXX..XXXX..XXXX"
  "XXXXXXXXXXXXXXXX"
  "XXXXXXXXXXXXXXXX"
  ".XXXXXXXXXXXXXX."
  ".XXX..XXXX..XXX."
  "..XXX......XXX.."
  "...XXX....XXX..."
  "....XXXXXXXX...."
  "......XXXX......"
end data

  text screen
  sprites 16x16
  sprites simple
  copy HappyFace to vram.spr_pat
  clear sprites
  set sprite count 1
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "SPINNER CONTROL"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  cls
  print at 4,1, "Happy face!"
  ' Spinner deltas are available as direct expressions.
  enable spinner
  reset spinners
game_loop:
  wait 2 frames
  X += spinner(1)
  Y += spinner(2)
  set sprite 0 to Y - 1,X,0,10
  update sprites
  goto game_loop