asm {
; LF_MASKHIT: HL = the left sprite's mask rows, DE = the right one's (words,
; bit 11 = the leftmost multicolour pixel), B = rows, C = the shift (pixels
; between them); HitOdd = 1 when they are an odd number of screen pixels
; apart (a right pixel then covers two left pixels). HitRes = 1 on overlap.
LF_MASKHIT:
    ld a,b
    or a
    ret z
LF_ROW:
    push bc
    push hl
    ex de,hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ld a,c
    or a
    jr z,LF_NOSH
LF_SH:
    srl d
    rr e
    dec a
    jr nz,LF_SH
LF_NOSH:
    ld a,(HitOdd)
    or a
    jr z,LF_EVEN
    ld h,d
    ld l,e
    srl h
    rr l
    ld a,d
    or h
    ld d,a
    ld a,e
    or l
    ld e,a
LF_EVEN:
    pop bc
    pop hl
    ld a,(hl)
    and e
    jr nz,LF_YES
    inc hl
    ld a,(hl)
    and d
    jr nz,LF_YES
    inc hl
    ld d,b
    ld e,c
    pop bc
    djnz LF_ROW
    ret
LF_YES:
    pop bc
    ld a,1
    ld (HitRes),a
    ret
