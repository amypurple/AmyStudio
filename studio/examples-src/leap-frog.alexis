cartridge "LEAP FROG/TONY BRANTNER/1992"

' LEAP FROG - after the Commodore 64 game by Tony Brantner (RUN magazine,
' ReRUN disk July/August 1992: LEAP + LEAP FROG, machine code typed in as
' LEAPFROG.HEX). ColecoVision port in Amy.
'
' Ribbit the frog sits on a log. Dragonflies come down from the sky and
' flutter about; the button shoots his tongue straight up to swat one
' (10 points x the level). A swatted fly jumps and drops: dodge it. A snake
' wanders the log with its head bobbing: hop over it (stick up-left or
' up-right; up alone hops in place). Touch the snake or a fly and Ribbit
' hops away: one frog lost. Three frogs, one more every 2000 points. Catch
' all the flies of a level (13 to 20) for the next, faster level (15 levels).
'
' Controls: either controller; stick left/right walks, up / up-left /
' up-right hops, either button the tongue. Menus: stick up/down, button.
'
' The rules are the original's machine code, kept in its own units: sprite
' X 0-511 and Y 0-255 of the C64 screen, the main loop's passes and
' counters (frog every 17 passes, flies every 45 - 2 x level, swatted
' flies every 8th pass), its random choices, its pixel-exact collisions
' (the C64 sprites' shapes are kept as masks: Masks, MaskTest). The C64
' loop was not tied to the frame; an NTSC C64 runs 24 passes a frame, 22
' while the stick or button is held (measured in c64/, see README): the
' port runs exactly that many passes per frame. The C64 screen is then
' drawn scaled (x 0.7, y 0.83) on the ColecoVision (XMap, YMap).
'
' Liberties (README): new pictures (sky, log, reeds, title picture),
' ColecoVision sprites redrawn from the original shapes; collisions tested
' once a frame (the C64 latched them every pass); the wings flap at 7.5 Hz
' on screen (the C64 changed them about 45 times a second); the frog
' appears / vanishes at the playfield edges instead of in the border;
' title menu, HOW TO PLAY, CREDITS, GAME OVER message (the original just
' waited for the button), an original title tune; the SHIFT LOCK pause and
' RUN/STOP are left out.
'
' House rules: everything in columns 2-29 / rows 1-22; music first in the
' sound table; screens drawn with the display off; one press at game over
' back to the title; nothing flashes faster than 3 Hz.

const PFF4K = 0
const PFF4G = 4
const PFF5K = 8
const PFF5G = 12
const PFF6K = 16
const PFF6G = 20
const PFF7K = 24
const PFF7G = 28
const PFF8K = 32
const PFF8G = 36
const PFF9K = 40
const PFF9G = 44
const PSFA0K = 48
const PSFA0G = 52
const PSFA1K = 56
const PSFA1G = 60
const PSFB0K = 64
const PSFB0G = 68
const PSFB1K = 72
const PSFB1G = 76
const PSFC0K = 80
const PSFC0G = 84
const PSFC1K = 88
const PSFC1G = 92
const PSFD0K = 96
const PSFD0G = 100
const PSFD1K = 104
const PSFD1G = 108
const PFLY0 = 112
const PFLY1 = 116
const PTBAR = 120
const PTTIP = 124
const PBLANK = 128
const SprBytes = 1056
const SndMel = 1
const SndHarm = 2
const SndBassV = 3
const SndBassP = 4
const SndStep = 5
const SndStep2 = 6
const SndJump = 7
const SndTick0 = 8
const SndTick1 = 9
const SndTick2 = 10
const SndTick3 = 11
const SndTick4 = 12
const SndHit = 13
const SndDie = 14
const SndExtra = 15
const SndLevel = 16
const SndOver = 17
const SndClick = 18
const TuneFrames = 596

' game states, read by the bots
enum GameState:
  StBoot = 0
  StTitle = 1
  StHow = 2
  StCredits = 3
  StPlay = 4
  StOver = 9
end enum

' how a play phase ended (EndOf)
enum EndKind:
  EndNone = 0
  EndLost = 1
  EndLevel = 2
end enum

const HideY = 207
const FrogSlot = 0
const SnakeSlot = 2
const FlySlot = 6
const TongueSlot = 12
const NSpr = 19
const MaxLevel = 15
' the original's constants
const FrogY0 = $B4
const SnakeY0 = $BC
const WalkStop = $AC

' sprite poses of the original ($F4..$FF), as metasprites: outline + colour
data FrogMeta metasprite layers 2
  frame PFF4K,1, PFF4G,3
  frame PFF5K,1, PFF5G,3
  frame PFF6K,1, PFF6G,3
  frame PFF7K,1, PFF7G,3
  frame PFF8K,1, PFF8G,3
  frame PFF9K,1, PFF9G,3
end data
data SnakeHead metasprite layers 2
  frame PSFA0K,1, PSFA0G,2
  frame PSFB0K,1, PSFB0G,2
  frame PSFC0K,1, PSFC0G,2
  frame PSFD0K,1, PSFD0G,2
end data
data SnakeBody metasprite layers 2
  frame PSFA1K,1, PSFA1G,2
  frame PSFB1K,1, PSFB1G,2
  frame PSFC1K,1, PSFC1G,2
  frame PSFD1K,1, PSFD1G,2
end data

' the original's tables ($0E76..$0EA3)
data T76 bytes = 0, 1, 255, 0
data T7E bytes = $F6, $F6, $F8, $F9
data T82 bytes = 7, 0, 7, 5
data T86 bytes = $FB, $FA, $FB, $FC, $FD, $FC
data T90 bytes = 4, 7, 10, 12, 14, 16, 17, 18, 18, 19, 18, 18, 17, 16, 14, 12, 10, 7, 4, 0
' C64 fly colours 1-8 (white, red, cyan, purple, green, blue, yellow,
' orange) as TMS9918 colours; a fly never takes the sky's colour
data FlyCol bytes = 15, 15, 8, 7, 13, 12, 4, 11, 9
' bits of the 12 multicolour pixels of a mask row (pixel 0 = bit 11)
data PxBit words = $0800, $0400, $0200, $0100, $0080, $0040, $0020, $0010, $0008, $0004, $0002, $0001
' a sprite's height in mask rows: the snake (sprite 6) is doubled
data SprRows bytes = 21, 21, 21, 21, 21, 21, 42

' sprites 0-5 flies, 6 snake, 7 frog: the original's arrays $13A9...
u8 Sy[8]
u16 Sx[8]
u8 Fptr[6]
u8 Col[6]
u8 Hit[6]
u8 Vc[7]
u8 Vl[7]
u8 Vd[7]
u8 Hc[7]
u8 Hl[7]
u8 Hd[7]
u8 Ptr6 = $FB
u8 Ptr7 = $F5
u8 Wing = $FE
u8 Left = 0
u8 Level = 1
u8 Lives = 3
u8 Ton = 0
u8 A7 = 0
u8 Glyph = 0
u16 Tx = 0
u8 Jmp = 0
u8 Dir = 0
u8 Dead = 0
u8 T1 = 0
u8 T2 = 0
u8 P04 = 0
u8 A3c = 0
u8 EndOf = 0
u8 DiedNow = 0
bcd digits 6 Score = 0
bcd digits 6 High = 0
u16 Pts = 0
u16 Rmd = 0
u16 Kilo = 0
' play phases
state machine Phase:
  Walking calls DoWalk
  Playing calls DoPlay
  Frozen calls DoFrozen
  Hopping calls DoHop
  Pausing calls DoPause
end state machine
u8 Ph = 0
u8 Acc = 0
u8 Fz = 0
u8 Hops = 0
u8 Over = 0
u8 Np = 0
u8 Pi = 0
' frog tick arguments (the original's A, $3A, $3B)
u8 Ja = 0
u8 Lo = 0
u8 Hb = 0
u8 Joy = $1F
' collision scratch
u8 Cn = 0
u8 Pose = 0
u16 Ox = 0
u16 Fx = 0
u8 Oy = 0
u8 Fy = 0
u8 Oh = 0
u8 Ys = 0
u8 Ye = 0
u16 Dx = 0
u16 Lp = 0
u16 Rp = 0
u8 Rows = 0
u8 Shf = 0
u8 HitOdd = 0
u8 HitRes = 0
u16 Tm = 0
u16 Um = 0
' drawing
u8 Dy = 0
u8 Dxs = 0
u8 Ty = 0
u8 Tb = 0
u8 Tc = 0
' misc
u16 Rs = 1
u16 W16 = 0
u16 N16 = 0
u16 Waited = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 J1 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Fi = 0
u8 Li = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X8 = 0
u8 Rv = 0
u8 Msg = 0
u8 NHit = 0
u8 TgEnd = NSpr

  tile screen
  ColourThirds
  set sound table LfSoundTable areas 8
  sprites 16x16
  nmi off
  copy SprPat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  dispatch Ph using Phase
  DrawSprites
  if Over = 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random: 16-bit xorshift, its low byte (the original read SID noise)

' (Rs ^= Rs << 7; Rs ^= Rs >> 9; Rs ^= Rs << 8, in Z80: up to 37 calls
' a frame when six flies come at once)
function Rnd() as u8
  asm {
    ld hl,(Rs)
    ld a,h
    rra
    ld a,l
    rra
    ld b,a
    ld a,0
    rra
    xor l
    ld l,a
    ld a,b
    xor h
    ld h,a
    ld a,h
    srl a
    xor l
    ld l,a
    xor h
    ld h,a
    ld (Rs),hl
  }
  return lowbyte(Rs)

' ---------------------------------------------------------------------------
' the original's rules

' $0CC5: new step rates and directions for slot X8
sub Reroll:
  V = Rnd()
  Vl[X8] = V & 3
  V = Rnd()
  Vd[X8] = V & 1
  V = Rnd()
  Hl[X8] = V & 3
  V = Rnd()
  Hd[X8] = V & 1
  return
end sub

' $0C9D: a new fly in slot X8, if any are left to come
sub Spawn:
  if Left = 0 then return
  dec Left
  V = Rnd()
  V = V & 7
  Col[X8] = V + 1
  Sy[X8] = $1E
  V = Rnd()
  V = V | $20
  Sx[X8] = V
  Hit[X8] = 0
  Reroll
  return
end sub

' $0C57: one horizontal step (when its counter runs out), off the edges or
' 1 in 128: new rates and direction instead
sub Horiz:
  inc Hc[X8]
  if Hc[X8] < Hl[X8] then return
  Hc[X8] = 0
  if Hd[X8] = 0 then
    N16 = Sx[X8] + 1
  else
    N16 = Sx[X8] - 1
  end if
  if highbyte(N16) = 0 then
    if lowbyte(N16) < $18 then
      Reroll
      return
    end if
  else
    if lowbyte(N16) >= $41 then
      Reroll
      return
    end if
  end if
  V = Rnd()
  V = V & $7F
  if V = 0 then
    Reroll
    return
  end if
  Sx[X8] = N16
  return
end sub

' $0C28: a fly: down into the sky, then up/down between rows $32 and $B1
sub FlyMove:
  inc Vc[X8]
  if Vc[X8] >= Vl[X8] then
    Vc[X8] = 0
    if Sy[X8] < $33 then
      inc Sy[X8]
    else
      V = Sy[X8]
      if Vd[X8] = 0 then
        inc V
      else
        dec V
      end if
      select case V
        case $32, $B1
          Reroll
          return
      end select
      Sy[X8] = V
    end if
  end if
  Horiz
  return
end sub

' $0C0F: the six fly slots
sub FlyTick:
  X8 = 5
  for Fi = 0 to 5
    if Sy[X8] = 0 then
      Spawn
    else
      if Hit[X8] = 0 then FlyMove
    end if
    dec X8
  next
  return
end sub

sub SnakeAnim:
  inc A3c
  V = A3c >> 3
  if V >= 6 then
    V = 0
    A3c = 0
  end if
  Ptr6 = T86[V]
  return
end sub

' $0BCD: swatted flies rise 13 px, then drop until they leave (Y wraps to 0)
sub DeadFlies:
  asm {
    ld hl,Sy
    ld de,Hit
    ld b,6
DF_LOOP:
    ld a,(de)
    or a
    jr z,DF_NEXT
    ld c,a
    ld a,(hl)
    or a
    jr z,DF_NEXT
    ld a,c
    cp 14
    jr nc,DF_FALL
    inc a
    ld (de),a
    dec (hl)
    jr DF_NEXT
DF_FALL:
    inc (hl)
    jr nz,DF_NEXT
    ld a,(NHit)
    dec a
    ld (NHit),a
DF_NEXT:
    inc hl
    inc de
    djnz DF_LOOP
  }
  return
end sub

' points: 10 x level; a frog more when the thousands digit turns even
sub AddPoints:
  Pts = Level * 10
  Score += Pts
  K = Kilo % 10
  Rmd += Pts
  if Rmd >= 1000 then
    Rmd -= 1000
    inc Kilo
    if Kilo >= 1000 then Kilo = 0
  end if
  T = Kilo % 10
  if T <> K then
    V = T & 1
    if V = 0 then
      if Lives < 99 then
        inc Lives
        play sound SndExtra
        ShowLives
      end if
    end if
  end if
  print at 8,21, Score
  if Score > High then
    High = Score
    print at 23,21, High
  end if
  return
end sub

' a tongue blip: higher as the tip goes up
sub TongueSound:
  V = 17 - A7
  V = V >> 2
  select case V
    case 0
      play sound SndTick0
    case 1
      play sound SndTick1
    case 2
      play sound SndTick2
    case 3
      play sound SndTick3
    case is >= 4
      play sound SndTick4
  end select
  return
end sub

' $0B8F: a fly over the tongue whose top is 0-4 rows below the tip
sub HitCheck:
  for Fi = 0 to 5
    if Hit[Fi] = 0 then
      if Sy[Fi] >= $32 then
        V = Sy[Fi] - $32
        V = V >> 3
        V = V - A7
        if V < 5 then
          if TongueOver(Fi) = 1 then
            Fptr[Fi] = Wing
            inc Ton
            Hit[Fi] = 1
            inc NHit
            play sound SndHit
            AddPoints
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' does fly F's shape (all its rows: a fly 0-4 rows below the tip is
' entirely beside the tongue) cover the tongue's 2-pixel column?
function TongueOver(u8 F) as u8
  u8 Pz = 0
  Um = FlyUnion[0]
  if Wing = $FF then Um = FlyUnion[1]
  if Hit[F] <> 0 then
    Um = FlyUnion[0]
    if Fptr[F] = $FF then Um = FlyUnion[1]
  end if
  Tm = 0
  Ox = Sx[F]
  ' d = Tx - fly X, for d and d + 1 inside 0..23
  if Tx + 1 >= Ox then
    Dx = Tx + 1
    Dx = Dx - Ox
    if Dx <= 24 then
      if Dx >= 1 then
        Pz = Dx - 1
        Pz = Pz >> 1
        Tm = Tm | PxBit[Pz]
      end if
      if Dx <= 23 then
        Pz = Dx >> 1
        Tm = Tm | PxBit[Pz]
      end if
    end if
  end if
  Tm = Tm & Um
  if Tm <> 0 then return 1
  return 0

sub Retract:
  inc A7
  if A7 < $12 then
    TongueSound
  else
    Ton = 0
  end if
  return
end sub

' $0AD1: the tongue grows one cell a tick up to row 1, then shrinks back
sub TongueTick:
  if Ton < 2 then
    dec A7
    if A7 = 0 then
      inc Ton
      Retract
      return
    end if
    TongueSound
    HitCheck
  else
    Retract
  end if
  return
end sub

' $0B32: a hop tick: the height from T90, sideways with Dir, turned back
' at the stops
sub JumpTick:
  V = Jmp >> 2
  Sy[7] = FrogY0 - T90[V]
  N16 = Sx[7]
  select case Dir
    case 1
      inc N16
    case 2
      dec N16
  end select
  if N16 <> Sx[7] then
    T = 0
    if highbyte(N16) = 0 then
      if lowbyte(N16) = Lo then T = 1
    else
      if lowbyte(N16) = Hb then T = 1
    end if
    if T = 1 then
      Dir = Dir ^ 3
    else
      Sx[7] = N16
    end if
  end if
  V = FrogY0 - Sy[7]
  Ptr7 = $F5
  if V >= 6 then inc Ptr7
  if V >= 14 then inc Ptr7
  inc Jmp
  if Jmp >= $50 then Jmp = 0
  return
end sub

' $0A2D: a frog tick with stick bits Ja (0 = pressed: 1 up, 4 left,
' 8 right, 16 button) and stops Lo / Hb
sub FrogTick:
  if Ton <> 0 then
    TongueTick
    return
  end if
  if Jmp <> 0 then
    JumpTick
    return
  end if
  V = Ja & $10
  if V = 0 then
    ' the tongue: its column from the frog's X ($0A97)
    Ptr7 = $F4
    N16 = Sx[7] - 21
    V = lowbyte(N16)
    V = V >> 1
    Glyph = V & 3
    Tx = N16 & $FFFE
    Tx += 32
    A7 = $11
    Ton = 1
    TongueTick
    return
  end if
  V = Ja & 1
  if V = 0 then
    V = Ja >> 2
    Dir = V & 3
    play sound SndJump
    JumpTick
    return
  end if
  V = Ja >> 2
  V = V & 3
  T = T76[V]
  if T = 0 then
    Ptr7 = $F5
    return
  end if
  N16 = Sx[7]
  if T = 1 then
    inc N16
  else
    dec N16
  end if
  T = 0
  if highbyte(N16) = 0 then
    if lowbyte(N16) = Lo then T = 1
  else
    if lowbyte(N16) = Hb then T = 1
  end if
  if T = 1 then
    Ptr7 = $F5
    return
  end if
  Sx[7] = N16
  V = lowbyte(N16)
  K = V >> 3
  K = K & 3
  V = V & 7
  if V = 0 then
    T = T82[K]
    if T = 7 then play sound SndStep
    if T = 5 then play sound SndStep2
  end if
  Ptr7 = T7E[K]
  return
end sub

' one pass of the original's main loop ($0938), without the collisions
sub PassCore:
  inc P04
  inc T2
  if T2 >= $11 then
    T2 = 0
    if Dead <> 0 then
      Ja = $16
      Lo = $17
      Hb = $C8
      FrogTick
      if Jmp = 0 then
        if Sx[7] >= $15A then
          EndOf = EndLost
          return
        end if
      end if
    else
      Ja = Joy
      Lo = $17
      Hb = $41
      FrogTick
    end if
  end if
  V = P04 >> 4
  V = V & 1
  Wing = $FE | V
  V = P04 & 7
  if V = 0 then
    if NHit <> 0 then DeadFlies
  end if
  inc T1
  if T1 >= $2D then
    T1 = Level << 1
    X8 = 6
    Horiz
    SnakeAnim
    FlyTick
  end if
  return
end sub

' the frog against the snake and every fly, pixel-exact on the original's
' shapes (bounding boxes first, then MaskTest)
sub CheckFrog:
  Fx = Sx[7]
  Fy = Sy[7]
  for Cn = 0 to 6
    Oy = Sy[Cn]
    ' (the frog's top is at Y 161 or lower on the screen: a sprite whose
    ' bottom is above that can't touch him)
    if Oy >= 141 then
      Ox = Sx[Cn]
      Oh = SprRows[Cn]
      T = 0
      if Ox + 24 > Fx then
        if Fx + 24 > Ox then
          W16 = Oy + Oh
          N16 = Fy + 21
          if W16 > Fy then
            if N16 > Oy then T = 1
          end if
        end if
      end if
      if T = 1 then
        Pose = Ptr6
        if Cn < 6 then
          Pose = Wing
          if Hit[Cn] <> 0 then Pose = Fptr[Cn]
        end if
        MaskTest
        if HitRes <> 0 then
          Dead = 1
          DiedNow = 1
          return
        end if
      end if
    end if
  next
  return
end sub

' rows Ys..Ye-1 of the frog (pose Ptr7 at Fx,Fy) and of sprite Cn (pose
' Pose at Ox,Oy): the left sprite's mask rows AND the right one's, shifted
' by the multicolour pixels between them (and one more when the gap is odd)
sub MaskTest:
  Ys = Fy
  if Oy > Ys then Ys = Oy
  W16 = Oy + Oh
  N16 = Fy + 21
  if W16 < N16 then
    Ye = lowbyte(W16)
  else
    Ye = lowbyte(N16)
  end if
  Rows = Ye - Ys
  ' the frog's rows, the other's rows
  V = Ptr7 - $F4
  Lp = MaskAt[V]
  T = Ys - Fy
  W16 = T << 1
  Lp += W16
  V = Pose - $F4
  Rp = MaskAt[V]
  T = Ys - Oy
  W16 = T << 1
  Rp += W16
  if Ox >= Fx then
    Dx = Ox - Fx
  else
    Dx = Fx - Ox
    W16 = Lp
    Lp = Rp
    Rp = W16
  end if
  V = lowbyte(Dx)
  Shf = V >> 1
  HitOdd = V & 1
  HitRes = 0
  call asm LF_MASKHIT with hl = Lp, de = Rp, b = Rows, c = Shf
  return
end sub

' ---------------------------------------------------------------------------
' the phases of play (one call a frame)

' $08BB: a level (re)starts: slots cleared, a new count of flies, the
' snake on the right with new steps, Ribbit walks in from the left
sub LevelStart:
  fill array Sy with 0
  for Fi = 0 to 7
    Sx[Fi] = 0
  next
  fill array Hit with 0
  NHit = 0
  fill array Col with 0
  fill array Vc with 0
  fill array Vl with 0
  fill array Vd with 0
  fill array Hc with 0
  fill array Hl with 0
  fill array Hd with 0
  Ton = 0
  Jmp = 0
  Dead = 0
  T1 = 0
  T2 = 0
  EndOf = EndNone
  Sy[6] = SnakeY0
  V = Rnd()
  V = V & $3F
  W16 = V
  Sx[6] = W16 + 256
  SnakeAnim
  X8 = 6
  Reroll
  Sy[7] = FrogY0
  V = Rnd()
  V = V & 7
  Left = V + 13
  Acc = 0
  ShowLevel
  ShowMsg(1)
  Ph = Phase.Walking
  return
end sub

' $0908: the walk-in, 1.4 ticks a frame (7 every 5 frames)
sub DoWalk:
  Acc += 7
  while Acc >= 5
    Acc -= 5
    Ja = $17
    Lo = 0
    Hb = $41
    FrogTick
    if Sx[7] = WalkStop then
      Acc = 0
      ClearMsg
      Ph = Phase.Playing
      return
    end if
  end while
  return
end sub

sub DoPlay:
  DiedNow = 0
  Np = 24
  if Joy <> $1F then Np = 22
  ' passes where nothing happens but the counters are skipped in one go:
  ' K passes up to the next frog tick, fly tick or swatted-fly step
  while Np > 0
    K = $11 - T2
    T = $2D - T1
    if T < K then K = T
    if NHit <> 0 then
      T = P04 & 7
      T = 8 - T
      if T < K then K = T
    end if
    if K > Np then K = Np
    Np -= K
    dec K
    P04 += K
    T2 += K
    T1 += K
    V = P04 >> 4
    V = V & 1
    Wing = $FE | V
    PassCore
    if EndOf <> EndNone then exit while
  end while
  if EndOf = EndLost then
    dec Lives
    ShowLives
    if Lives = 0 then
      Over = 1
      return
    end if
    LevelStart
    return
  end if
  if Dead = 0 then
    CheckFrog
    if DiedNow = 1 then
      play sound SndDie
      Fz = 78
      Ph = Phase.Frozen
      return
    end if
    if Ton = 0 then
      if Jmp = 0 then
        if Left = 0 then
          T = 0
          for Fi = 0 to 5
            if Sy[Fi] <> 0 then T = 1
          next
          if T = 0 then
            play sound SndLevel
            ShowMsg(2)
            Hops = 4
            Acc = 0
            Ph = Phase.Hopping
          end if
        end if
      end if
    end if
  end if
  return
end sub

' the C64's death sound held everything for 78 jiffies
sub DoFrozen:
  dec Fz
  if Fz = 0 then Ph = Phase.Playing
  return
end sub

' $09D8: four hops in place, then the next level after 25 frames
sub DoHop:
  Acc += 7
  while Acc >= 5
    Acc -= 5
    Ja = $1E
    Lo = $18
    Hb = $41
    FrogTick
    if Jmp = 0 then
      dec Hops
      if Hops = 0 then
        ClearMsg
        if Level < MaxLevel then inc Level
        Fz = 25
        Ph = Phase.Pausing
        return
      end if
    end if
  end while
  return
end sub

sub DoPause:
  dec Fz
  if Fz = 0 then LevelStart
  return
end sub

sub NewGame:
  Score = 0
  Pts = 0
  Rmd = 0
  Kilo = 0
  Lives = 3
  Level = 1
  Over = 0
  P04 = 0
  A3c = 0
  Ptr7 = $F5
  Wing = $FE
  Msg = 0
  DrawPlay
  State = StPlay
if defined ROM_TEST_CHECKPOINTS
  test checkpoint "new_game"
end defined
  LevelStart
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  ' Ribbit: shown inside the playfield stops only (the C64 hid him in the
  ' border)
  V = Sy[7]
  Dy = YMap[V]
  N16 = Sx[7]
  Dxs = XMap[N16]
  V = Ptr7 - $F4
  if Dxs = 0 then Dy = HideY
  if Dxs = 255 then Dy = HideY
  set metasprite FrogMeta frame V to Dy,Dxs using sprite 0
  ' the snake: head and body
  V = Sy[6]
  Dy = YMap[V]
  N16 = Sx[6]
  Dxs = XMap[N16]
  V = Ptr6 - $FA
  set metasprite SnakeHead frame V to Dy,Dxs using sprite 2
  Dy += 16
  set metasprite SnakeBody frame V to Dy,Dxs using sprite 4
  ' the flies (wings at 7.5 Hz on screen)
  T = Tick >> 2
  T = T & 1
  for Li = 0 to 5
    C = Li + FlySlot
    V = Sy[Li]
    Dy = HideY
    if V <> 0 then Dy = YMap[V]
    N16 = Sx[Li]
    Dxs = XMap[N16]
    K = PFLY0
    if T = 1 then K = PFLY1
    if Hit[Li] <> 0 then K = PFLY1
    V = Col[Li]
    V = FlyCol[V]
    set sprite C to Dy,Dxs,K,V
  next
  ' the tongue: from its top row down to Ribbit's mouth (C64 row 17)
  Tb = 17
  if Ton <> 0 then
    Tb = A7
    if Ton = 2 then inc Tb
  end if
  C = TongueSlot
  if Tb <= 16 then
    V = Tb << 3
    V += 50
    Ty = YMap[V]
    Tc = XMap[Tx]
    K = PTTIP
    while Ty < 120
      set sprite C to Ty,Tc,K,9
      K = PTBAR
      Ty += 16
      inc C
    end while
  end if
  ' hide the tongue sprites the last frame used and this one doesn't
  T = C
  while C < TgEnd
    set sprite C to HideY,0,PBLANK,0
    inc C
  end while
  TgEnd = T
  update sprites
  return
end sub

sub ShowScore:
  print at 2,21, "SCORE "
  print at 8,21, Score
  print at 18,21, "HIGH "
  print at 23,21, High
  return
end sub

sub ShowLevel:
  print at 2,22, "LEVEL "
  N16 = Level
  print at 8,22, digits$(N16, 2)
  return
end sub

sub ShowLives:
  print at 18,22, "FROGS "
  N16 = Lives
  print at 27,22, digits$(N16, 2)
  return
end sub

' messages on a dark band across the sky (row 10), erased by writing the
' scene's own cells back
sub ShowMsg(u8 M):
  Msg = M
  print at 6,10, "                    "
  if M = 1 then print at 11,10, "GET READY!"
  if M = 2 then print at 8,10, "LEVEL COMPLETED!"
  return
end sub

sub ClearMsg:
  copy PlayCells + 320 count 32 to vram.name + 320
  Msg = 0
  return
end sub

sub DrawPlay:
  NewScreen
  decompress zx0 PlayNam to vram.name
  decompress zx0 PlayP0 to vram.pattern + 768
  decompress zx0 PlayP1 to vram.pattern + 2816
  decompress zx0 PlayP2 to vram.pattern + 4864
  decompress zx0 PlayC0 to vram.color
  decompress zx0 PlayC1 to vram.color + 2048
  decompress zx0 PlayC2 to vram.color + 4096
  ShowScore
  ShowLevel
  ShowLives
  ShowScreen
  return
end sub

sub GameOver:
  print at 6,10, "                    "
  print at 11,10, "GAME  OVER"
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens (as the toolbox template)

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      StopTune
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub StopTune:
  stop sound SndMel
  stop sound SndHarm
  stop sound SndBassV
  stop sound SndBassP
  TzOn = 0
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = 1 up, 2 down, 4 left, 8 right; Joy = the C64
' port bits (0 = pressed, 16 = a button)
sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Jk = J1 & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Joy = J1 ^ $1F
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 5
  sprites flicker on
  for J = 0 to 18
    set sprite J to HideY,0,PBLANK,0
  next
  update sprites
  return
end sub

' each screen third its own colour table (VDP R3 = $FF; `tile screen`
' shares one, R3 = $9F): the pictures need it (OS7 WRITE_REGISTER)
sub ColourThirds:
  asm {
    ld bc,$03FF
    call $1FD9
  }
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub LoadPage:
  NewScreen
  decompress zx0 PageNam to vram.name
  decompress zx0 PageP0 to vram.pattern + 768
  decompress zx0 PageP1 to vram.pattern + 2816
  decompress zx0 PageP2 to vram.pattern + 4864
  decompress zx0 PageC0 to vram.color
  decompress zx0 PageC1 to vram.color + 2048
  decompress zx0 PageC2 to vram.color + 4096
  return
end sub

sub TitlePage:
  NewScreen
  decompress zx0 TitleNam to vram.name
  decompress zx0 TitleP0 to vram.pattern + 768
  decompress zx0 TitleP1 to vram.pattern + 2816
  decompress zx0 TitleP2 to vram.pattern + 4864
  decompress zx0 TitleC0 to vram.color
  decompress zx0 TitleC1 to vram.color + 2048
  decompress zx0 TitleC2 to vram.color + 4096
  print at 13,15, "START"
  print at 13,17, "HOW TO PLAY"
  print at 13,19, "CREDITS"
  print at 7,21, "BY TONY BRANTNER"
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndMel
  play sound SndHarm
  play sound SndBassV
  play sound SndBassP
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  V = Rnd()
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  StopTune
  mute all
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 11,15
  put char 32 at 11,17
  put char 32 at 11,19
  C = Menu << 1
  C += 15
  put char 62 at 11,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  LoadPage
  State = StCredits
  print at 11,2, "LEAP FROG"
  print at 3,5, "A C64 GAME BY"
  print at 3,7, "TONY BRANTNER, RUN"
  print at 3,9, "MAGAZINE, RERUN DISK"
  print at 3,11, "JULY/AUGUST 1992."
  print at 3,14, "COLECOVISION PORT IN AMY"
  print at 3,16, "BY CLAUDE (ANTHROPIC)"
  print at 3,18, "FOR AMY BIENVENU, 2026."
  print at 3,20, "MUSIC: RIBBIT'S HOP (NEW)"
  print at 8,22, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages, pictures made of the game's own sprites
sub HowTo:
  Page = 1
  LoadPage
  State = StHow
  print at 8,2, "HOW TO PLAY  1/2"
  print at 3,4, "RIBBIT SWATS DRAGONFLIES"
  print at 3,6, "WITH HIS LONG TONGUE."
  set metasprite FrogMeta frame 0 to 87,64 using sprite 0
  set sprite 12 to 47,70,PTTIP,9
  set sprite 13 to 63,70,PTBAR,9
  set sprite 14 to 79,70,PTBAR,9
  set sprite 6 to 40,63,PFLY0,8
  set sprite 7 to 64,150,PFLY1,15
  update sprites
  print at 13,9, "BUTTON: TONGUE"
  print at 13,11, "10 POINTS X LEVEL"
  print at 3,14, "STICK LEFT/RIGHT WALKS."
  print at 3,16, "A SWATTED FLY DROPS:"
  print at 3,18, "STEP OUT OF ITS WAY!"
  print at 3,20, "ALL SWATTED: NEXT LEVEL"
  print at 8,22, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    LoadPage
    print at 8,2, "HOW TO PLAY  2/2"
    print at 3,4, "THE SNAKE WANDERS THE LOG."
    set metasprite FrogMeta frame 3 to 63,72 using sprite 0
    set metasprite SnakeHead frame 1 to 79,104 using sprite 2
    set metasprite SnakeBody frame 1 to 95,104 using sprite 4
    update sprites
    print at 16,8, "STICK UP-LEFT"
    print at 16,10, "OR UP-RIGHT:"
    print at 16,12, "HOP OVER IT."
    print at 3,15, "TOUCH IT OR A FLY: ONE FROG"
    print at 3,17, "LOST. 3 FROGS, ONE MORE"
    print at 3,19, "EVERY 2000 POINTS."
    print at 8,22, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

