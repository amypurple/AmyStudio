asm {
ShBeam:
    db $40,$BA,$10,$01,$40,$70,$10,$01,$40,$50,$10,$01,$40,$3E,$10,$01,$40,$33,$10,$01,$40,$2B,$10,$01
    db $40,$25,$10,$01,$50
ShHitT:
    db $80,$7C,$40,$02,$80,$68,$30,$02,$80,$59,$20,$02,$80,$4E,$20,$02,$80,$45,$10,$02,$80,$3E,$00,$02
    db $80,$45,$10,$02,$80,$4E,$20,$02,$80,$59,$20,$02,$80,$68,$30,$02,$80,$7C,$40,$02,$90
ShHitN:
    db $00,$00,$04,$03,$00,$00,$25,$04,$00,$00,$46,$05,$00,$00,$86,$06,$10
ShMiss:
    db $C0,$6D,$32,$04,$C0,$EA,$52,$06,$C0,$EA,$F2,$02,$D0
ShCry:
    db $C0,$3B,$40,$02,$C0,$4B,$40,$02,$C0,$3B,$40,$02,$C0,$4B,$40,$02,$C0,$3B,$40,$02,$C0,$4B,$40,$02
    db $C0,$3B,$40,$02,$C0,$4B,$40,$02,$D0
ShLand:
    db $00,$00,$04,$04,$00,$00,$05,$08,$00,$00,$26,$0A,$00,$00,$56,$0C,$00,$00,$96,$10,$10
ShWave:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$06,$40,$6B,$F0,$02,$50
ShOver:
    db $40,$7C,$21,$0A,$40,$7C,$F1,$02,$40,$94,$21,$0A,$40,$94,$F1,$02,$40,$AB,$21,$0A,$40,$AB,$F1,$02
    db $40,$C5,$21,$0A,$40,$C5,$F1,$02,$40,$E0,$21,$0A,$40,$E0,$F1,$02,$40,$FC,$21,$0A,$40,$FC,$F1,$02
    db $40,$3B,$22,$0A,$40,$3B,$F2,$02,$40,$F9,$22,$28,$40,$F9,$F2,$02,$50
ShGood:
    db $40,$8F,$10,$04,$40,$8F,$F0,$01,$40,$71,$10,$04,$40,$71,$F0,$01,$40,$5F,$10,$04,$40,$5F,$F0,$01
    db $40,$47,$10,$09,$40,$47,$F0,$01,$40,$5F,$10,$04,$40,$5F,$F0,$01,$40,$47,$10,$1D,$40,$47,$F0,$01
    db $50
ShPick:
    db $C0,$55,$30,$02,$C0,$40,$50,$02,$D0

StoneSoundTable:
    dw ShBeam,$702B
    dw ShHitT,$703F
    dw ShHitN,$702B
    dw ShMiss,$7049
    dw ShCry,$7049
    dw ShLand,$702B
