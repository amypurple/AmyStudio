  $FC,$FE,$FE,$FC,$FC,$F8,$FC,$F8,$00,$00,$10,$44,$AA,$FF,$55,$FF
  $22,$88,$11,$44,$22,$88,$11,$44,$00,$1F,$7F,$7B,$FF,$F7,$FF,$FF
