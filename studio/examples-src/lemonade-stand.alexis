cartridge "LEMONADE STAND/AMY BIENVENU/2026"

' LEMONADE STAND
' Apple Computer's LEMONADE STAND (the DOS 3.3 System Master's
' Applesoft program, "COPYRIGHT 1979 APPLE COMPUTER INC.", after Bob
' Jamison's 1973 game for the Minnesota Educational Computing
' Consortium), for the ColecoVision in Amy by Amy Bienvenu.
' Ported by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: the program's listing (orig/lemonade.bas). Labels such as l521
' are its line numbers; the lines starting with @ are its own arithmetic
' (expr.py compiles them): it runs on Applesoft's floating point routines
' translated to Z80 (fp/xlate.py), so every sale, every cent and every
' RND is the Apple's, rounding and all.
'
' One to thirty stands. Each morning: the weather report, then for each
' stand how many glasses to make, how many signs, what price; then the
' day's report. Hot days sell more, cloudy ones less, a thunderstorm
' ruins everything; the street department may close your street.
'
' Controls (either joystick): an amount is set with the stick (up and
' down 1, right and left 10, held for faster) and the left button; a
' choice with the stick and the left button. Where the Apple said PRESS
' RETURN TO CONTINUE, ESC TO END, the left button goes on, the right
' one ends. Keypad not used.
'
' Kept as the listing has them:
' - The arithmetic, as said. A typed amount is a whole number here, as
'   the listing's checks needed.
' - The random numbers: Applesoft's RND, from the seed its cold start
'   leaves, so a game with the same answers sees the same weather, as on
'   the Apple. RND(-1) on line 651 always gives the same small number:
'   when the street department works, your street has no traffic (R1 =
'   .1); the street crews never buy your lemonade (line 691).
' - Bankrupt stands keep their last answers, and their assets keep
'   changing with them.
' - With one player, going bankrupt ends the program with ?UNDEF'D
'   STATEMENT ERROR IN 581 (line 581 jumps to a line 1511 that isn't
'   there).
' Liberties taken:
' - Text rewrapped for 28 columns; the lo-res pictures are the Apple's
'   40x48 blocks, the bottom rows of grass (36-39) under the screen's
'   edge.
' - Amounts with the stick, so the listing's checks for typing a wrong
'   number can't be met (COME ON, LET'S BE REASONABLE...).
'
' House rules kept: columns 2-29, rows 1-22; the screen is drawn with
' the NMI off; the title tune is the listing's and plays once.

' --- the listing's numbers ----------------------------------------------
' floats (Applesoft's 5 bytes: exponent, sign and mantissa)
u8 F_C1[5]
u8 F_R1[5]
u8 F_N1[5]
u8 F_W[5]
u8 F_V[5]
u8 F_N2[5]
u8 F_M[5]
u8 F_E[5]
u8 F_P1[5]
u8 F_STI[5]
u8 F_SC[5]
u8 F_J[5]
u8 F_X[5]
u8 F_Y[5]
u8 F_FI[5]
u8 F_AC[5]
u8 F_TT[5]
' whole numbers: D day, C cost, N stands, I stand, the stand's L S P G H B
u16 D = 0
u16 C = 0
u16 N = 1
u16 I = 1
u16 Lc = 0
u16 Sc = 0
u16 Pc = 0
u16 Gc = 0
u16 Hc = 0
u16 Bc = 0
u16 R2 = 0
u16 Kv = 0
u16 Av = 0
u16 Nv = 0
' SC as a whole number once set (2 sunny, 7 hot, 10 cloudy, 5 storm)
u8 Sw = 0
u8 C5 = 0
u8 R3 = 0

' --- the floating point routines and VmRun ------------------------------
u8 FpZ[81]
u8 FpR[5]
u8 FpCh = 0
u8 FpBuf[20]
u8 VmStk[30]
u16 VmSp = 0
u16 VmPc = 0
u8 VmT = 0
u8 VmM = 0
u16 VmW = 0

' --- the Apple's screen (lores.asm): window, cursor, COLOR ----------------
u8 WndL = 0
u8 WndW = 40
u8 WndT = 0
u8 WndB = 24
u8 Ch = 0
u8 Cv = 0
u8 Col = 0
u8 LrOld = 0
u8 LrShow = 1
u8 GrOn = 0
u8 LrNoTx = 0
u8 LrT = 0
u8 LrT2 = 0
u8 Lx = 0
u8 Lx1 = 0
u8 Lx2 = 0
u8 Ly = 0
u8 Ly1 = 0
u8 Ly2 = 0

' --- text (text.asm) ----------------------------------------------------
u8 TxX = 2
u8 TxY = 1
u8 TxTop = 1
u8 TxLine[32]
u8 TxNum[6]
u8 StiS[16]
u8 MsgBuf[120]
u16 MsgP = 0

' --- sound ---------------------------------------------------------------
u8 TnP = 0
u8 TnJ = 0
u16 LpN = 0
u16 Tp = 0

' --- input ---------------------------------------------------------------
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0
u8 Held = 0
u8 Tick = 0
u16 Nmax = 0
u16 Nmin = 0
u8 Sel = 0
u8 Nx = 0
u8 Ny = 0
u8 Money = 0
u8 NoQ = 0
u8 NoEcho = 0
' for the test bot: what the game waits for (1 a button, 2 yes or no,
' 3 an amount, 9 the end)
u8 Ask = 0
u8 Quit = 0

' --- scratch -------------------------------------------------------------
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Jl = 0
u16 V16 = 0
u16 W16 = 0

  tile screen
  nmi off
  clear sprites
  set sprite count 1
  set sprite 0 to 208,0,0,0
  update sprites
  asm {
    call Hush
    ld bc,$03FF
    call WRITE_REGISTER
  }
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  copy Percent count 8 to vram.pattern + 296
  copy Percent count 8 to vram.pattern + 2344
  copy Percent count 8 to vram.pattern + 4392
  screen on

power_on:
  asm {
    ld hl,AMY_UVAR_VmStk
    ld (AMY_UVAR_VmSp),hl
  }
  CreditsPage
  ' Applesoft's cold start: RND's seed
  asm {
    ld hl,RndSeed0
    ld de,AMY_UVAR_FpR
    ld bc,5
    ldir
  }

' ---------------------------------------------------------------------------
' 1: the tone routine (781, kept in sound.asm), the title, the game
l1:
  ' RUN clears the variables (CLEAR); RND's seed stays
  asm {
    ld hl,AMY_UVAR_F_C1
    ld de,AMY_UVAR_F_C1+1
    ld (hl),0
    ld bc,5*17-1
    ldir
  }
  D = 0
  C = 0
  N = 0
  Sw = 0
  R2 = 0
  R3 = 0
  C5 = 0
  asm {
    ld hl,Ex_1
    call VmRun
  }
  ApTitle
  goto l101

' ---------------------------------------------------------------------------
' 101: the game
l101:
  asm {
    ld hl,Ex_2
    call VmRun
  }
  ' (DIM: P9 = 10, S3 = .15, S2 = 30, A2 = 2.00, C9 = .5, C2 = 1 are the
  ' constants Kc_ of expr.py)
  Welcome
  for I = 1 to N
    Bc = 0
    Lc = 0
    Sc = 0
    Pc = 0
    Gc = 0
    Hc = 0
    asm {
      ld hl,Ex_3
      call VmRun
    }
    RecPut
  next
  if Sel = 1 then
    Instructions
    goto l121
  end if
  ' 111
  OldGame
l121:
  asm {
    ld hl,Ex_4
    call VmRun
  }
  asm {
    ld hl,Ex_5
    call VmRun
  }
  if VmT = 1 then goto l121a
  asm {
    ld hl,Ex_6
    call VmRun
  }
  if VmT = 1 then goto l131a
  Sw = 7
  goto l151
l121a:
  Sw = 2
  goto l151
l131a:
  Sw = 10
l151:
  if D < 3 then Sw = 2
  SetSc
  ' 161
  Weather
  ApText
  TxTop = 1
  PHome
  inc D
  C = 2
  if D > 2 then C = 4
  if D > 6 then C = 5
  TxWrite(@TxOnDay)
  V16 = D
  TxInt
  TxWrite(@TxCostIs)
  TxWrite(@TxCents0)
  V16 = C
  TxInt
  PNl
  ' 181
  asm {
    ld hl,Ex_7
    call VmRun
  }
  if D = 3 then
    TxWrite(@TxSugar)
  end if
  if D = 7 then
    TxWrite(@TxMixUp)
  end if
  if D > 2 then goto l601
l231:
  ' PRINT : POKE 34,PEEK(37): the window starts on the next line
  PNl
  TxTop = TxY
  for I = 1 to N
    RecGet
    asm {
      ld hl,Ex_8
      call VmRun
    }
    RecPut
l241:
    Gc = 1
    Hc = 0
    RecPutI
    asm {
      ld hl,Ex_9
      call VmRun
    }
    Sti731
    TxWrite(@TxStand)
    V16 = I
    TxInt
    PNl
    TxWrite(@TxAssets)
    TxPutSti
    PNl
    PNl
    if Bc = 0 then goto l261
    TxWrite(@TxNoDecide)
    Wait1461
    goto l441
l261:
    TxWrite(@TxGlasses)
    Nmin = 0
    Nmax = 1000
    Nv = Lc
    AskNum
    Lc = Nv
    RecPutI
    PNl
    asm {
      ld hl,Ex_10
      call VmRun
    }
    if VmT = 1 then goto l321
    ' 311
    TxWrite(@TxThink1)
    TxPutSti
    TxWrite(@TxThink2)
    V16 = Lc
    TxInt
    TxWrite(@TxThink3)
    asm {
      ld hl,Ex_11
      call VmRun
    }
    TxPutBuf
    TxWrite(@TxThink4)
    PNl
    goto l261
l321:
    PNl
    TxWrite(@TxSigns1)
    asm {
      ld hl,Ex_12
      call VmRun
    }
    TxPutBuf
    TxWrite(@TxSigns2)
    Nmin = 0
    Nmax = 50
    Nv = Sc
    AskNum
    Sc = Nv
    RecPutI
    PNl
    asm {
      ld hl,Ex_13
      call VmRun
    }
    if VmT = 1 then goto l381
    ' 371
    PNl
    asm {
      ld hl,Ex_14
      call VmRun
    }
    Sti731
    TxWrite(@TxThink5)
    TxPutSti
    TxWrite(@TxThink6)
    PNl
    goto l321
l381:
    PNl
    TxWrite(@TxPrice)
    Nmin = 0
    Nmax = 100
    Nv = Pc
    AskNum
    Pc = Nv
    RecPutI
    PNl
    ' 421/431: VTAB 23
    TxWrite(@TxChange)
    AskYes
    if Sel = 1 then
      PHome
      C5 = 1
      goto l241
    end if
l441:
    PHome
  next
  C5 = 0
  ApText
  TxTop = 1
  PHome
  PNl
  ' IF SC = 10 AND RND(1) < .25 THEN 701 (RND is drawn either way)
  asm {
    ld hl,Ex_15
    call VmRun
  }
  if VmT = 1 then goto l701
  ' 451
  TxWrite(@TxReport)
  PNl
  Tp = address of TuneReport
  PlayTune
  ' (R2 is never 2: 691 can't be reached)
  if R3 = 3 then goto l711
l471:
  ' (POKE 34,5 in 761: the report's window starts under the heading)
  PNl
  TxTop = TxY
  for I = 1 to N
    RecGet
    asm {
      ld hl,Ex_16
      call VmRun
    }
    if VmT = 1 then goto l471a
    goto l481
l471a:
    asm {
      ld hl,Ex_17
      call VmRun
    }
    RecPut
l481:
    if R2 = 2 then goto l531
    asm {
      ld hl,Ex_18
      call VmRun
    }
    if VmT = 1 then goto l511
    asm {
      ld hl,Ex_19
      call VmRun
    }
    goto l521
l511:
    asm {
      ld hl,Ex_20
      call VmRun
    }
l521:
    asm {
      ld hl,Ex_21
      call VmRun
    }
    asm {
      ld hl,Ex_22
      call VmRun
    }
    if VmT = 1 then goto l541
l531:
    asm {
      ld hl,Ex_23
      call VmRun
    }
l541:
    asm {
      ld hl,Ex_24
      call VmRun
    }
    RecPut
    ' (H(I) is never 1)
    PNl
    if Bc <> 1 then goto l571
    ' 561
    TxWrite(@TxStand2)
    V16 = I
    TxInt
    TxWrite(@TxBankrupt)
    Wait1461
    ' VTAB 5 : CALL -958
    TxY = TxTop - 1
    TxX = 2
    asm {
      call TxClrEop
    }
    goto l591
l571:
    Report761
    asm {
      ld hl,Ex_25
      call VmRun
    }
    if VmT = 1 then goto l591
    ' 581
    PHome
    TxWrite(@TxBroke)
    Bc = 1
    RecPutI
    Wait1461
    PHome
    if N = 1 then
      UndefError
      goto l1
    end if
l591:
  next
  asm {
    ld hl,Ex_26
    call VmRun
  }
  R2 = 0
  goto l121

' 601-721: the day's news
l601:
  if Sw = 10 then goto l641
  if Sw = 7 then goto l721
  asm {
    ld hl,Ex_27
    call VmRun
  }
  if VmT = 1 then goto l651
  goto l231
l641:
  asm {
    ld hl,Ex_28
    call VmRun
  }
  TxWrite(@TxRain1)
  asm {
    ld hl,Ex_29
    call VmRun
  }
  TxPutBuf
  TxWrite(@TxRain2)
  asm {
    ld hl,Ex_30
    call VmRun
  }
  goto l231
l651:
  TxWrite(@TxStreet)
  asm {
    ld hl,Ex_31
    call VmRun
  }
  if VmT = 1 then goto l671
  R2 = 2
  goto l231
l671:
  asm {
    ld hl,Ex_32
    call VmRun
  }
  goto l231
l701:
  R3 = 0
  Sw = 5
  SetSc
  Weather
  ApText
  TxTop = 1
  PHome
  TxWrite(@TxStorm1)
l711:
  TxWrite(@TxStorm2)
  for I = 1 to N
    RecGet
    Gc = 0
    RecPutI
  next
  goto l471
l721:
  TxWrite(@TxHeat)
  asm {
    ld hl,Ex_33
    call VmRun
  }
  goto l231

' an Applesoft error in the arithmetic (?OVERFLOW, ?DIVISION BY ZERO):
' the listing can't meet one, but the Apple stopped there
fp_error:
  ApText
  TxTop = 1
  PHome
  TxWrite(@TxFpErr)
  TxWrite(@TxPrompt)
  ProgramEnd
  goto l1

' 801-861: the title on the lo-res screen
sub ApTitle:
  ApText
  ApGr
  Col = $CC
  for Y = 0 to 39
    Ly = Y
    Lx1 = 0
    Lx2 = 39
    asm {
      call LrHlin
    }
  next
  Cv = 1
  LrVtab
  LrNoTx = 1
  Tp = address of TtTop
  ApPrint
  Cv = 10
  LrVtab
  Tp = address of TtBottom
  ApPrint
  Cv = 22
  LrVtab
  Tp = address of TtCopy
  ApPrint
  print at 4,21, "COPYRIGHT 1979"
  print at 6,22, "APPLE COMPUTER INC."
  ' 901: the tune
  Tp = address of TuneTitle
  PlayTune
  LpN = 2000
  PLoops
  WndW = 1
  WndT = 9
  WndB = 19
  Tp = address of TtColumns
  for X = 39 to 7 step -1
    Col = $FF
    Lx = X
    Ly1 = 18
    Ly2 = 37
    asm {
      call LrVlin
    }
    Col = $CC
    if X < 39 then
      Lx = X + 1
      Ly2 = 36
      asm {
        call LrVlin
      }
    end if
    Col = $FF
    if X < 30 then
      Lx = X + 10
      Ly2 = 36
      asm {
        call LrVlin
      }
    end if
    Col = $CC
    if X < 29 then
      Lx = X + 11
      Ly2 = 37
      asm {
        call LrVlin
      }
      WndL = X + 11
      Cv = 10
      LrVtab
      Ch = X + 11
      ' PRINT : READ A$ : PRINT A$;
      asm {
        ld a,$8D
        call LrCout
      }
      ApPrint
      inc Tp
    end if
    ' FOR J = 14 TO I + I : NEXT
    V16 = X + X
    LpN = 0
    if V16 >= 14 then LpN = V16 - 13
    PLoops
  next
  LpN = 1000
  PLoops
  Col = $DD
  Lx = 12
  Ly1 = 14
  Ly2 = 36
  asm {
    call LrVlin
  }
  for Y = 36 to 20 step -1
    Lx1 = 8
    Lx2 = 16
    Ly = Y
    asm {
      call LrHlin
    }
    LpN = 50
    PLoops
    TnP = Y * 3
    TnP = TnP - 12
    TnJ = 12
    asm {
      call Tone
    }
  next
  Col = $CC
  Lx = 12
  Ly1 = 14
  Ly2 = 19
  asm {
    call LrVlin
  }
  WndL = 0
  WndW = 40
  WndT = 20
  WndB = 23
  Cv = 21
  LrVtab
  LpN = 4000
  PLoops
  LrNoTx = 0
  return
end sub


' 731: STI$, the money as the listing writes it (StiS: "$" STR$ ...)
sub Sti731:
  asm {
    ld hl,Ex_34
    call VmRun
  }
  asm {
    ld hl,Ex_35
    call VmRun
  }
  asm {
    ld hl,AMY_UVAR_FpBuf
    ld de,AMY_UVAR_StiS+1
    ld a,'$'
    ld (AMY_UVAR_StiS),a
StiCp:
    ld a,(hl)
    ld (de),a
    or a
    inc hl
    inc de
    jr nz,StiCp
  }
  asm {
    ld hl,Ex_36
    call VmRun
  }
  if VmT = 1 then
    asm {
      ld hl,TxDot0
      call StiCat
    }
  end if
  asm {
    ld hl,Ex_37
    call VmRun
  }
  if VmT = 1 then
    asm {
      ld hl,TxZero
      call StiCat
    }
  end if
  return
end sub

' 761-771: a stand's report
sub Report761:
  TxY = TxTop
  TxX = 2
  TxWrite(@TxDay)
  V16 = D
  TxInt
  TxPadTo(22)
  TxWrite(@TxStand3)
  V16 = I
  TxInt
  PNl
  PNl
  PNl
  TxWrite(@TxSp2)
  asm {
    ld hl,Ex_38
    call VmRun
  }
  TxPutBuf
  TxPadTo(9)
  TxWrite(@TxSold)
  PNl
  PNl
  asm {
    ld hl,Ex_39
    call VmRun
  }
  Sti731
  TxPutSti
  TxPadTo(9)
  TxWrite(@TxPerGlass)
  PNl
  asm {
    ld hl,Ex_40
    call VmRun
  }
  Sti731
  TxPadTo(15)
  TxWrite(@TxIncome)
  TxPutSti
  PNl
  PNl
  TxWrite(@TxSp2)
  V16 = Lc
  TxInt
  TxPadTo(9)
  TxWrite(@TxMade)
  PNl
  PNl
  asm {
    ld hl,Ex_41
    call VmRun
  }
  Sti731
  TxWrite(@TxSp2)
  V16 = Sc
  TxInt
  TxPadTo(9)
  TxWrite(@TxSignsMade)
  PNl
  TxPadTo(13)
  TxWrite(@TxExpenses)
  TxPutSti
  PNl
  PNl
  asm {
    ld hl,Ex_42
    call VmRun
  }
  Sti731
  TxPadTo(15)
  TxWrite(@TxProfit)
  TxPutSti
  PNl
  asm {
    ld hl,Ex_43
    call VmRun
  }
  Sti731
  TxPadTo(15)
  TxWrite(@TxAssets2)
  TxPutSti
  Wait1461
  PHome
  return
end sub

' the error of line 581
sub UndefError:
  ApText
  TxTop = 1
  PHome
  PNl
  TxWrite(@TxUndef)
  PNl
  TxWrite(@TxPrompt)
  ProgramEnd
  return
end sub

' END (1491) and line 1511's error: the Apple went back to its ]
' prompt; a button starts again from the title
sub ProgramEnd:
  TxFlush
  print at 2,22, "PRESS A BUTTON"
  Ask = 9
  WaitPress
  Ask = 0
  Quit = 1
  return
end sub

' ---------------------------------------------------------------------------
' 921-961: welcome, new game, how many
sub Welcome:
  ApText
  TxTop = 1
  PHome
  TxWrite(@TxHi)
  PNl
  PNl
  for Jl = 1 to 10
    asm {
      ld hl,Ex_44
      call VmRun
    }
    asm {
      ld hl,Ex_45
      call VmRun
    }
    TnP = VmT
    TnJ = 10
    asm {
      call Tone
    }
  next
  TxWrite(@TxTown)
  PNl
  PNl
  TxWrite(@TxNewGame)
  PNl
  TxWrite(@TxPlease)
  AskYes
  K = Sel
  PNl
  TxWrite(@TxPeople)
  Nmin = 1
  Nmax = 30
  Nv = 1
  AskNum
  N = Nv
  ' A$ = "Y" for a new game
  Sel = K
  return
end sub

' 971-1011: the instructions
sub Instructions:
  ApText
  TxTop = 1
  PHome
  TxWrite(@TxHow1)
  Wait1461
  PHome
  TxWrite(@TxHow2)
  Wait1461
  PHome
  return
end sub

' 1021-1121: an old game continued
sub OldGame:
  ApText
  TxTop = 1
  PHome
  asm {
    call Bell
  }
  TxWrite(@TxAgain)
  AskYes
  if Sel = 1 then
    PNl
    TxWrite(@TxGood)
    Nmin = 1
    Nmax = 99
    Nv = 1
    NoQ = 1
    AskNum
    NoQ = 0
    D = Nv
    PNl
  end if
  PNl
  TxWrite(@TxOkay)
  V16 = D + 1
  TxInt
  PNl
  for I = 1 to N
    PNl
    TxWrite(@TxPlayer)
    V16 = I
    TxInt
    TxWrite(@TxHowMuch)
    Money = 1
    NoQ = 1
    Nmin = 0
    Nmax = 9999
    Nv = 200
    AskNum
    Money = 0
    NoQ = 0
    Av = Nv
    PNl
    if Av < 200 then
      TxWrite(@TxStart2)
      Av = 200
    else
      if Av > 4000 then
        TxWrite(@TxFair)
        Av = 1000
      end if
    end if
    RecGet
    asm {
      ld hl,Ex_46
      call VmRun
    }
    RecPut
  next
  PNl
  asm {
    call Bell
  }
  TxWrite(@TxReady)
  AskYes
  if Sel = 2 then
    Instructions
  end if
  return
end sub

' ---------------------------------------------------------------------------
' 1131-1391: the weather report (GR, mixed)
sub Weather:
  ApGr
  WndT = 20
  ApHome
  Col = Sw * 17
  for Y = 0 to 25
    Ly = Y
    Lx1 = 0
    Lx2 = 39
    asm {
      call LrHlin
    }
  next
  Col = $CC
  if Sw = 5 then Col = $44
  for Y = 26 to 39
    Ly = Y
    Lx1 = 0
    Lx2 = 39
    asm {
      call LrHlin
    }
  next
  Col = $88
  for Y = 24 to 32
    Ly = Y
    Lx1 = 15
    Lx2 = 25
    asm {
      call LrHlin
    }
  next
  Ly = 14
  Lx1 = 15
  Lx2 = 25
  asm {
    call LrHlin
  }
  Ly1 = 14
  Ly2 = 23
  Lx = 15
  asm {
    call LrVlin
  }
  Lx = 25
  asm {
    call LrVlin
  }
  Col = $DD
  for X = 17 to 23 step 2
    Ly1 = 22
    Ly2 = 23
    Lx = X
    asm {
      call LrVlin
    }
  next
  if Sw = 2 then goto w1191
  if Sw = 7 then goto w1191
  if Sw = 10 then Col = $FF
  if Sw = 5 then Col = $00
  ' 1171: clouds
  ApH(6, 10, 2)
  ApH(4, 14, 3)
  ApH(7, 12, 4)
  ApH(22, 30, 4)
  ApH(20, 36, 5)
  ApH(23, 33, 6)
  if Sw = 5 then Lightning
  goto w1211
w1191:
  if Sw = 7 then Col = $99
  ApH(3, 5, 1)
  ApH(2, 6, 2)
  for Y = 3 to 6
    ApH(1, 7, Y)
  next
  ApH(2, 6, 7)
  ApH(3, 5, 8)
w1211:
  ' VTAB 22: HTAB 8: PRINT " LEMONSVILLE WEATHER REPORT ": PRINT (twice)
  for K = 1 to 2
    Cv = 21
    LrVtab
    Ch = 7
    Tp = address of TtReport
    ApPrint
    asm {
      ld a,$8D
      call LrCout
      ld a,$8D
      call LrCout
    }
  next
  if Sw = 2 then
    Ch = 17
    Tp = address of TtSunny
  end if
  if Sw = 7 then
    Ch = 14
    Tp = address of TtHot
  end if
  if Sw = 10 then
    Ch = 16
    Tp = address of TtCloudy
  end if
  if Sw = 5 then
    Ch = 13
    Tp = address of TtStorm
  end if
  ApPrint
  if Sw = 5 then Lightning
  ' 1251-1371: the weather's tune
  if Sw = 2 then
    Tp = address of TuneSunny
    PlaySunny
  else
    if Sw = 7 then Tp = address of TuneHot
    if Sw = 10 then Tp = address of TuneCloudy
    if Sw = 5 then Tp = address of TuneStorm
    PlayTune
  end if
  if Sw = 5 then Lightning
  LpN = 2000
  PLoops
  return
end sub

' SC as a float too, and COLOR= SC
sub SetSc:
  if Sw = 2 then
    asm {
      ld hl,Ex_47
      call VmRun
    }
  end if
  if Sw = 7 then
    asm {
      ld hl,Ex_48
      call VmRun
    }
  end if
  if Sw = 10 then
    asm {
      ld hl,Ex_49
      call VmRun
    }
  end if
  if Sw = 5 then
    asm {
      ld hl,Ex_50
      call VmRun
    }
  end if
  return
end sub

' 1451: two bolts, each with five flashes
sub Lightning:
  for K = 1 to 2
    Bolt
    for Jl = 1 to 5
      Col = $44
      LrOld = Col
      Col = $CC
      asm {
        call LrLight
      }
      Col = $FF
      LrOld = Col
      Col = $99
      asm {
        call LrLight
      }
      Col = $FF
      asm {
        call LrLight
      }
      Col = $CC
      LrOld = Col
      Col = $44
      asm {
        call LrLight
      }
    next
    Col = $FF
    LrOld = Col
    Col = $55
    asm {
      call LrLight
    }
  next
  return
end sub

' 11-91: a bolt, from the left (21) or the right (51)
sub Bolt:
  Col = $FF
  asm {
    ld hl,Ex_51
    call VmRun
  }
  if VmT = 1 then goto b51
  asm {
    ld hl,Ex_52
    call VmRun
  }
  BoltVlin
  for Jl = 1 to 6
    asm {
      ld hl,Ex_53
      call VmRun
    }
    asm {
      ld hl,Ex_54
      call VmRun
    }
    if VmT = 1 then goto b21a
    goto b31
b21a:
    asm {
      ld hl,Ex_55
      call VmRun
    }
b31:
    asm {
      ld hl,Ex_56
      call VmRun
    }
    if VmT = 1 then goto b91
    asm {
      ld hl,Ex_57
      call VmRun
    }
    if VmT = 1 then goto b41
    goto b51
b41:
    BoltVlin
  next
  return
b51:
  asm {
    ld hl,Ex_58
    call VmRun
  }
  BoltVlin
b61:
  asm {
    ld hl,Ex_59
    call VmRun
  }
  asm {
    ld hl,Ex_60
    call VmRun
  }
  if VmT = 1 then goto b61a
  goto b71
b61a:
  asm {
    ld hl,Ex_61
    call VmRun
  }
b71:
  asm {
    ld hl,Ex_62
    call VmRun
  }
  if VmT = 1 then goto b91
  BoltVlin
  goto b61
b91:
  return
end sub

' VLIN Y,I AT X (the whole parts)
sub BoltVlin:
  asm {
    ld hl,Ex_63
    call VmRun
  }
  Ly1 = VmT
  asm {
    ld hl,Ex_64
    call VmRun
  }
  Ly2 = VmT
  asm {
    ld hl,Ex_65
    call VmRun
  }
  Lx = VmT
  asm {
    call LrVlin
  }
  return
end sub

' ---------------------------------------------------------------------------
' The Apple's screen: TEXT, GR, VTAB, HOME, HLIN, PRINT (lores.asm)
sub ApText:
  Rearm
  wait
  nmi off
  display off
  asm {
    call LrKeep
    call LOAD_ASCII
    call AMY_DUPLICATE_PATTERN_THIRDS
    call TxFontCol
    call LrSpaces
  }
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  copy Percent count 8 to vram.pattern + 296
  copy Percent count 8 to vram.pattern + 2344
  copy Percent count 8 to vram.pattern + 4392
  fill 32 count 768 to vram.name
  screen on
  nmi off
  WndL = 0
  WndW = 40
  WndT = 0
  WndB = 24
  Cv = 23
  Ch = 0
  return
end sub

' GR: the lo-res screen, CLRTOP, the window's top at 20, VTAB 24
sub ApGr:
  Rearm
  wait
  nmi off
  display off
  asm {
    call LrPrep
    call LrClrTop
  }
  LrShow = 1
  GrOn = 1
  screen on
  nmi off
  WndL = 0
  WndW = 40
  WndT = 20
  WndB = 24
  Cv = 23
  LrVtab
  return
end sub

sub ApHome:
  asm {
    call LrHome
  }
  return
end sub

' VTAB: nothing more to do than CV (the page address is worked out each time)
sub LrVtab:
  return
end sub

' ApPrint: PRINT the string at Tp; (the bytes with the high bit)
sub ApPrint:
  asm {
    ld hl,(AMY_UVAR_Tp)
ApPr2:
    ld a,(hl)
    or a
    jr z,ApPr3
    push hl
    or $80
    call LrCout
    pop hl
    inc hl
    jr ApPr2
ApPr3:
    ld (AMY_UVAR_Tp),hl
  }
  return
end sub

' HLIN Lx1,Lx2 AT Ly from the arguments
sub ApH(u8 A1, u8 A2, u8 A3):
  Lx1 = A1
  Lx2 = A2
  Ly = A3
  asm {
    call LrHlin
  }
  return
end sub

' ---------------------------------------------------------------------------
' text helpers
' Text goes through MsgBuf, so a sentence with numbers in it wraps as one
' (TxFlush prints it: before a new line, a TAB, a question, a page)
sub TxWrite(u16 Ad):
  Tp = Ad
  asm {
    ld hl,(AMY_UVAR_Tp)
    call MsgAdd
  }
  return
end sub

sub TxFlush:
  asm {
    call MsgFlush
  }
  return
end sub

sub PNl:
  asm {
    call MsgFlush
    call TxNl
  }
  return
end sub

sub PHome:
  asm {
    call MsgClear
    call TxHome
  }
  return
end sub

sub TxInt:
  asm {
    ld de,(AMY_UVAR_V16)
    call TxNumStr
    call MsgAdd
  }
  return
end sub

sub TxPadTo(u8 A1):
  V = A1
  asm {
    call MsgFlush
    ld a,(AMY_UVAR_V)
    call TxPad
  }
  return
end sub

sub TxPutBuf:
  asm {
    ld hl,AMY_UVAR_FpBuf
    call MsgAdd
  }
  return
end sub

sub TxPutSti:
  asm {
    ld hl,AMY_UVAR_StiS
    call MsgAdd
  }
  return
end sub

' the stand's record in VRAM ($3800 + 12 I): A(I) 5 bytes, L, S, P, G, H, B
sub RecGet:
  asm {
    call RecAddr
    call VRd
    ld hl,AMY_UVAR_F_AC
    ld b,5
RgA:
    nop
    nop
    in a,(VDPD)
    ld (hl),a
    inc hl
    djnz RgA
    in a,(VDPD)
    ld (AMY_UVAR_Lc),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Lc+1),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Sc),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Pc),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Gc),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Hc),a
    nop
    nop
    in a,(VDPD)
    ld (AMY_UVAR_Bc),a
    xor a
    ld (AMY_UVAR_Sc+1),a
    ld (AMY_UVAR_Pc+1),a
    ld (AMY_UVAR_Gc+1),a
    ld (AMY_UVAR_Hc+1),a
    ld (AMY_UVAR_Bc+1),a
  }
  return
end sub

sub RecPut:
  RecPutI
  return
end sub

sub RecPutI:
  asm {
    call RecAddr
    call VWr
    ld hl,AMY_UVAR_F_AC
    ld b,5
RpA:
    ld a,(hl)
    out (VDPD),a
    inc hl
    nop
    djnz RpA
    ld a,(AMY_UVAR_Lc)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Lc+1)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Sc)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Pc)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Gc)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Hc)
    out (VDPD),a
    nop
    nop
    ld a,(AMY_UVAR_Bc)
    out (VDPD),a
  }
  return
end sub

' ---------------------------------------------------------------------------
' input
' 1461: PRESS RETURN TO CONTINUE, ESC TO END... (left button, right button)
sub Wait1461:
  TxFlush
  print at 2,22, "LEFT: GO ON  RIGHT: END..."
  Ask = 1
w1471:
  Frame1
  ReadPad
  if Press = 1 then goto w1481
  if Press2 = 1 then goto w1491
  goto w1471
w1481:
  Ask = 0
  fill 32 count 32 at 0,22
  return
w1491:
  ' HOME : VTAB 8 : ARE YOU SURE YOU WANT TO QUIT ? (GET: Y ends)
  Ask = 0
  PHome
  TxY = 7
  TxX = 2
  TxWrite(@TxSure)
  ' (GET: the key isn't shown)
  NoEcho = 1
  AskYes
  NoEcho = 0
  if Sel = 2 then
    PHome
    return
  end if
  PNl
  TxWrite(@TxPrompt)
  ProgramEnd
  asm {
    ld sp,$73B9
    jp AMY_ULBL_l1
  }
  return
end sub

' YES or NO after the question (Sel 1 = YES)
sub AskYes:
  TxFlush
  Ask = 2
  Sel = 1
  WasBtn = 1
  X = TxX
  Y = TxY
  if X > 22 then
    PNl
    X = TxX
    Y = TxY
  end if
yn_draw:
  print at X,Y, " YES  NO"
  V = X
  if Sel = 2 then V = X + 5
  print at V,Y, ">"
yn_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then Sel = 1
    if Up1 = 1 then Sel = 1
    if Rt1 = 1 then Sel = 2
    if Dn1 = 1 then Sel = 2
    goto yn_draw
  end if
  if Press = 0 then goto yn_loop
  ' the answer stays, as typed
  print at X,Y, "        "
  TxX = X
  if NoEcho = 0 then
    if Sel = 1 then
      TxWrite(@TxY1)
    else
      TxWrite(@TxN1)
    end if
  end if
  Ask = 0
  return
end sub

' an amount Nmin-Nmax after the question ("?" then the number)
sub AskNum:
  TxFlush
  Ask = 3
  WasBtn = 1
  X = TxX
  Y = TxY
  if X > 24 then
    PNl
    X = TxX
    Y = TxY
  end if
  if Money = 1 then
    if X > 21 then
      PNl
      X = TxX
      Y = TxY
    end if
  end if
an_draw:
  TxX = X
  TxY = Y
  if Money = 1 then
    NumMoney
  else
    asm {
      ld a,(AMY_UVAR_NoQ)
      or a
      jr nz,$+7
      ld a,'?'
      call TxOut
      ld de,(AMY_UVAR_Nv)
      call TxU16
      ld a,' '
      call TxOut
      ld a,' '
      call TxOut
      ld a,' '
      call TxOut
    }
  end if
an_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    V16 = 1
    W16 = 10
    if Money = 1 then W16 = 100
    if Held > 40 then
      V16 = 10
      W16 = 100
      if Money = 1 then W16 = 1000
    end if
    if Up1 = 1 then Nv = Nv + V16
    if Dn1 = 1 then
      if Nv < Nmin + V16 then
        Nv = Nmin
      else
        Nv = Nv - V16
      end if
    end if
    if Rt1 = 1 then Nv = Nv + W16
    if Lf1 = 1 then
      if Nv < Nmin + W16 then
        Nv = Nmin
      else
        Nv = Nv - W16
      end if
    end if
    if Nv > Nmax then Nv = Nmax
    goto an_draw
  end if
  if Press = 0 then goto an_loop
  ' what was typed stays: ?100
  TxX = X
  TxY = Y
  if Money = 1 then
    NumMoney
  else
    asm {
      ld a,(AMY_UVAR_NoQ)
      or a
      jr nz,$+7
      ld a,'?'
      call TxOut
      ld de,(AMY_UVAR_Nv)
      call TxU16
    }
  end if
  Ask = 0
  return
end sub

' ?12.34: an amount of money in cents
sub NumMoney:
  V16 = Nv / 100
  W16 = Nv - V16 * 100
  if NoQ = 0 then
    asm {
      ld a,'?'
      call TxOut
    }
  end if
  asm {
    ld de,(AMY_UVAR_V16)
    call TxU16
    ld a,'.'
    call TxOut
    ld a,(AMY_UVAR_W16)
    ld e,a
    ld d,0
    cp 10
    jr nc,NmM2
    ld a,'0'
    call TxOut
    ld a,(AMY_UVAR_W16)
    ld e,a
    ld d,0
NmM2:
    call TxU16
    ld a,' '
    call TxOut
    ld a,' '
    call TxOut
  }
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then
    if Press2 = 0 then goto wp_loop
  end if
  return
end sub

sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).button1 | joypad(2).button1
  Btn2 = joypad(1).button2 | joypad(2).button2
  Press = 0
  Press2 = 0
  V = Btn | Btn2
  if V = 1 then
    if WasBtn = 0 then
      Press = Btn
      Press2 = Btn2
    end if
  end if
  WasBtn = V
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 16
      Held = 0
    else
      if Held < 250 then inc Held
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

' PlayTune: the pairs at Tp until a length of 0; pitch 1 is a pause of J
' empty FOR loops (the hot and the storm tunes, line 1361)
sub PlayTune:
  asm {
PtNext:
    ld hl,(AMY_UVAR_Tp)
    ld a,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld (AMY_UVAR_Tp),hl
    ld c,a
    ld a,b
    or a
    ret z
    ld a,c
    cp 1
    jr nz,PtTone
    ld l,b
    ld h,0
    ld (AMY_UVAR_LpN),hl
    call Loops
    jr PtNext
PtTone:
    ld (AMY_UVAR_TnP),a
    ld a,b
    ld (AMY_UVAR_TnJ),a
    call Tone
    ; the loop's own time in BASIC (READ, IF, POKE, POKE, CALL): about 29 ms
    ld hl,4300
    call SpinHL
    jr PtNext
  }
  return
end sub

' 1281-1291: the sunny tune: each note J times, length 10, the pause after
' the K-th of J being J - K + 1 empty loops
sub PlaySunny:
  asm {
PsNext:
    ld hl,(AMY_UVAR_Tp)
    ld a,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld (AMY_UVAR_Tp),hl
    ld c,a
    ld a,b
    or a
    ret z
    ld e,b              ; J
    ld d,1              ; K
PsRep:
    push de
    push bc
    ld a,c
    ld (AMY_UVAR_TnP),a
    ld a,10
    ld (AMY_UVAR_TnJ),a
    call Tone
    pop bc
    pop de
    push de
    push bc
    ld a,e
    sub d
    inc a
    ld l,a
    ld h,0
    ld (AMY_UVAR_LpN),hl
    call Loops
    pop bc
    pop de
    ld a,d
    cp e
    jr z,PsNext
    inc d
    jr PsRep
  }
  return
end sub

sub PLoops:
  asm {
    call Loops
  }
  return
end sub

' ---------------------------------------------------------------------------
sub CreditsPage:
  ApText
  print at 6,1, "LEMONADE STAND"
  print at 2,3, "APPLE COMPUTER'S LEMONADE"
  print at 2,4, "STAND (1979), FROM BOB"
  print at 2,5, "JAMISON'S 1973 GAME FOR"
  print at 2,6, "MECC."
  print at 2,8, "FOR THE COLECOVISION BY"
  print at 2,9, "CLAUDE (AN AI MADE BY"
  print at 2,10, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,11, "2026, IN AMY, THE LANGUAGE"
  print at 2,12, "BY AMY BIENVENU."
  print at 2,14, "THE ARITHMETIC IS APPLESOFT'S"
  print at 2,15, "OWN, TRANSLATED TO THE Z80."
  print at 2,17, "MUSIC: THE PROGRAM'S OWN"
  print at 2,18, "TUNES."
  print at 2,21, "PRESS A BUTTON"
  Ask = 1
  WaitPress
  Ask = 0
  return
end sub

