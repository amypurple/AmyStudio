data Percent bytes $C4, $C8, $10, $20, $40, $98, $18, $00

asm {
FpError:
    ld sp,$73B9
    jp AMY_ULBL_fp_error
; StiCat: the string at HL added to StiS
StiCat:
    ld de,AMY_UVAR_StiS
StiC2:
    ld a,(de)
    or a
    jr z,StiC3
    inc de
    jr StiC2
StiC3:
    ld a,(hl)
    ld (de),a
    or a
    inc hl
    inc de
    jr nz,StiC3
    ret
; LrKeep: the lo-res page kept at $3A00 when leaving GR (for the test bot,
; which compares it with the Apple's)
LrKeep:
    ld a,(AMY_UVAR_GrOn)
    or a
    ret z
    xor a
    ld (AMY_UVAR_GrOn),a
    ld de,0
LrKp2:
    ld hl,LrPage
    add hl,de
    call VRd
    ld hl,AMY_UVAR_TxLine
    ld b,32
LrKp3:
    nop
    nop
    in a,(VDPD)
    ld (hl),a
    inc hl
    djnz LrKp3
    ld hl,$3A00
    add hl,de
    call VWr
    ld hl,AMY_UVAR_TxLine
    ld b,32
LrKp4:
    ld a,(hl)
    out (VDPD),a
    inc hl
    djnz LrKp4
    ld hl,32
    add hl,de
    ex de,hl
    ld a,d
    cp 3
    jr nz,LrKp2
    ld a,e
    cp $C0
    jr nz,LrKp2
    ret
; LrSpaces: the Apple's page all spaces ($A0)
LrSpaces:
    ld hl,LrPage
    call VWr
    ld bc,960
LrSp2:
    ld a,$A0
    out (VDPD),a
    dec bc
    ld a,b
    or c
    jr nz,LrSp2
    ret
TxDot0:
    db ".0", 0
TxZero:
    db "0", 0
; MsgAdd: the string at HL added to MsgBuf; MsgFlush: MsgBuf printed
MsgAdd:
    ; its length: a long text is printed now (after what waits)
    push hl
    ld bc,0
MsgL1:
    ld a,(hl)
    or a
    jr z,MsgL2
    inc hl
    inc bc
    jr MsgL1
MsgL2:
    pop hl
    ld a,b
    or a
    jr nz,MsgLong
    ld a,c
    cp 60
    jr nc,MsgLong
    ld de,(AMY_UVAR_MsgP)
    ld a,d
    or e
    jr nz,MsgA1
    ld de,AMY_UVAR_MsgBuf
MsgA1:
    ; room for it?
    push hl
    ld hl,AMY_UVAR_MsgBuf+118
    or a
    sbc hl,de
    sbc hl,bc
    pop hl
    jr nc,MsgA2
    push hl
    call MsgFlush
    pop hl
    ld de,AMY_UVAR_MsgBuf
MsgA2:
    ld a,(hl)
    ld (de),a
    or a
    jr z,MsgA3
    inc hl
    inc de
    jr MsgA2
MsgA3:
    ld (AMY_UVAR_MsgP),de
    ret
MsgLong:
    push hl
    call MsgFlush
    pop hl
    jp TxStr
MsgFlush:
    ld hl,(AMY_UVAR_MsgP)
    ld a,h
    or l
    ret z
    ld hl,AMY_UVAR_MsgBuf
    call TxStr
MsgClear:
    ld hl,0
    ld (AMY_UVAR_MsgP),hl
    ret
; TxNumStr: HL = the digits of DE (in TxNum)
TxNumStr:
    ld hl,AMY_UVAR_TxNum+5
    ld (hl),0
TxNs2:
    dec hl
    push hl
    ex de,hl
    ld c,10
    call TxDiv
    ex de,hl
    pop hl
    add a,48
    ld (hl),a
    ld a,d
    or e
    jr nz,TxNs2
    ret
; RecAddr: HL = $3800 + 12 * I
RecAddr:
    ld a,(AMY_UVAR_I)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,de
    ld de,$3800
    add hl,de
    ret
; TxFontCol: the font's colours, white on black, in the three thirds
TxFontCol:
    ld hl,$2000
    call VWr
    ld de,$1800
TxFc2:
    ld a,$F1
    out (VDPD),a
    dec de
    ld a,d
    or e
    jr nz,TxFc2
    ret
; ---------------------------------------------------------------------------
; VmRun: runs the expression code at HL (written by expr.py from the
; listing's own expressions), with the Applesoft routines of fp.asm. The
; steps are the ones Applesoft's FRMEVL takes: a left operand is pushed
; rounded with its sign, the right one stays in the FAC with its extension
; byte, then the operator runs on ARG and FAC.
;   0 end           1 nn FAC = (nn)      2 nn FAC = literal (7 bytes at nn)
;   3 nn FAC = u16 (nn)                  4 push FAC
;   5 add 6 sub 7 mul 8 div 9 power      10 m compare (bits >1 =2 <4)
;   11 negate 12 INT 13 EXP 14 RND       15 nn store FAC to (nn)
;   16 truth -> VmT                      17 whole part -> VmT, VmW
;   18 STR$ -> FpBuf                     19 AND 20 OR
; FAC is FpZ+63 ($9D-$A2), extension FpZ+78 ($AC), ARG FpZ+71 ($A5-$AA).
FAC     EQU AMY_UVAR_FpZ+63
FACX    EQU AMY_UVAR_FpZ+78
ARG     EQU AMY_UVAR_FpZ+71
VmRun:
    ld (AMY_UVAR_VmPc),hl
VmNext:
    ld hl,(AMY_UVAR_VmPc)
    ld a,(hl)
    inc hl
    or a
    ret z
    ld e,(hl)
    inc hl
    ld d,(hl)
    dec hl
    ld (AMY_UVAR_VmPc),hl
    ld hl,VmNext
    push hl
    ld hl,VmTab-2
    add a,a
    add a,l
    ld l,a
    jr nc,$+3
    inc h
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jp (hl)
VmTab:
    dw VmLd, VmLit, VmInt, VmPush, VmAdd, VmSub, VmMul, VmDiv, VmPow, VmCmp
    dw VmNeg, VmIntF, VmExp, VmRnd, VmSto, VmTruth, VmWhole, VmStr, VmAnd, VmOr
; operand fetched: DE = the 16-bit operand; VmSkip2/VmSkip1 move past it
VmSkip2:
    ld hl,(AMY_UVAR_VmPc)
    inc hl
    inc hl
    ld (AMY_UVAR_VmPc),hl
    ret
VmSkip1:
    ld hl,(AMY_UVAR_VmPc)
    inc hl
    ld (AMY_UVAR_VmPc),hl
    ret
VmLd:
    call VmSkip2
    ld a,e
    ld b,d
    jp Fp_EAF9
VmLit:
    call VmSkip2
    ex de,hl
    ld de,FAC
    ld bc,6
    ldir
    ld a,(hl)
    ld (FACX),a
    ret
VmInt:
    call VmSkip2
    ex de,hl
    ld a,(hl)
    ld (FAC+2),a
    inc hl
    ld a,(hl)
    ld (FAC+1),a
    ld c,$90
    scf
    jp Fp_EBA0
; push: the sign, then the FAC rounded (as $DE10 does), 6 bytes
VmPush:
    ld a,(FAC+5)
    push af
    call Fp_EB72
    pop af
    ld hl,(AMY_UVAR_VmSp)
    ld (hl),a
    inc hl
    ld de,FAC
    ex de,hl
    ld bc,5
    ldir
    ld (AMY_UVAR_VmSp),de
    ret
; pop into ARG ($DE41), SGNCPR = ARG sign xor FAC sign, A = FAC exponent
VmPop:
    ld hl,(AMY_UVAR_VmSp)
    ld de,-6
    add hl,de
    ld (AMY_UVAR_VmSp),hl
    ld a,(hl)
    ld (ARG+5),a
    inc hl
    ld de,ARG
    ld bc,5
    ldir
    ld a,(ARG+5)
    ld hl,FAC+5
    xor (hl)
    ld (ARG+6),a
    ld a,(FAC)
    or a
    ret
VmAdd:
    call VmPop
    jp Fp_E7C1
VmSub:
    call VmPop
    jp Fp_E7AA
VmMul:
    call VmPop
    jp Fp_E982
VmDiv:
    call VmPop
    jp Fp_EA69
VmPow:
    call VmPop
    jp Fp_EE97
; compare ($DF6A-$DFCA): ARG packed in place, FCOMP, then 1 or 0
VmCmp:
    call VmSkip1
    ld a,e
    ld (AMY_UVAR_VmM),a
    call VmPop
    ld a,(ARG+5)
    or $7F
    ld hl,ARG+1
    and (hl)
    ld (hl),a
    ld hl,ARG
    ld a,l
    ld b,h
    call Fp_EBB2
    ; FF -> 1, 0 -> 2, 1 -> 4
    ld b,1
    inc a
    jr z,VmCmp2
    ld b,2
    dec a
    jr z,VmCmp2
    ld b,4
VmCmp2:
    ld a,(AMY_UVAR_VmM)
    and b
    jr z,$+4
    ld a,1
    jp Fp_EB93
VmNeg:
    jp Fp_EED0
VmIntF:
    jp Fp_EC23
VmExp:
    jp Fp_EF09
VmRnd:
    jp Fp_EFAE
VmSto:
    call VmSkip2
    ld c,e
    ld b,d
    jp Fp_EB2B
VmTruth:
    ld a,(FAC)
    or a
    jr z,$+4
    ld a,1
    ld (AMY_UVAR_VmT),a
    ret
; the whole part (QINT, as CONINT): VmT the low byte, VmW the low word
VmWhole:
    call Fp_EBF2
    ld a,(FAC+4)
    ld (AMY_UVAR_VmT),a
    ld (AMY_UVAR_VmW),a
    ld a,(FAC+3)
    ld (AMY_UVAR_VmW+1),a
    ret
VmStr:
    jp Fp_ED34
; AND / OR of two truths (the listing only joins comparisons)
VmAnd:
    call VmPop
    ld a,(ARG)
    or a
    jr z,VmFalse
    ld a,(FAC)
    or a
    jr z,VmFalse
VmTrue:
    ld a,1
    jp Fp_EB93
VmFalse:
    xor a
    jp Fp_EB93
VmOr:
    call VmPop
    ld a,(ARG)
    or a
    jr nz,VmTrue
    ld a,(FAC)
    or a
    jr nz,VmTrue
    jr VmFalse

; ---------------------------------------------------------------------------
; The Apple's screen for the lo-res pictures. The 40x24 text page (the
; bytes the Apple keeps at $400, row after row) is kept in VRAM at LrPage;
; HLIN, VLIN, PRINT and the lightning routine change it there as the
; monitor did, then the changed blocks are shown: a block is 6x4 pixels
; (x 8-247, lo-res rows 0-35 on y 8-151; rows 36-39 are grass under the
; screen's edge), the mixed text lines 21-24 on tile rows 19-22.
; Each 8-pixel byte holds parts of two blocks: the pattern bits say which
; pixels are the second block (foreground), the colour byte gives both.
LrPage  EQU $1B80
VDPD    EQU $BE
VDPC    EQU $BF

; VWr: VRAM write address HL. VRd: read address HL. Both keep A.
VWr:
    push af
    ld a,l
    out (VDPC),a
    ld a,h
    or $40
    out (VDPC),a
    pop af
    ret
VRd:
    push af
    ld a,l
    out (VDPC),a
    ld a,h
    and $3F
    out (VDPC),a
    pop af
    ret

; LrAddr: HL = the page byte of text row C, column B (0-based)
LrAddr:
    push de
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,de          ; row * 40
    ld e,b
    ld d,0
    add hl,de
    ld de,LrPage
    add hl,de
    pop de
    ret

; LrPeek: A = page byte at row C, column B
LrPeek:
    call LrAddr
    call VRd
    nop
    nop
    nop
    in a,(VDPD)
    ret

; LrPoke: page byte at row C, column B = A
LrPoke:
    call LrAddr
    call VWr
    out (VDPD),a
    ret

; Apple colour -> TMS9918 colour
LrTms:
    db 1, 13, 4, 13, 12, 14, 5, 7, 6, 8, 14, 9, 3, 11, 7, 15

; LrNib: A = the colour of lo-res block B (column), E (row), as TMS colour
LrNib:
    push bc
    ld c,e
    srl c
    call LrPeek
    bit 0,e
    jr z,LrNib2
    rrca
    rrca
    rrca
    rrca
LrNib2:
    and $0F
    ld hl,LrTms
    add a,l
    ld l,a
    jr nc,$+3
    inc h
    ld a,(hl)
    pop bc
    ret

; LrByteCol: draws byte column D (0-29) for lo-res row E (0-35)
LrByteCol:
    ld a,e
    cp 36
    ret nc
    push bc
    push de
    ; the two blocks: 4*(D/3) + D%3 and the next
    ld a,d
    ld c,0
LrBc1:
    cp 3
    jr c,LrBc2
    sub 3
    inc c
    jr LrBc1
LrBc2:
    ld b,a              ; k = D % 3
    ld a,c
    add a,a
    add a,a
    add a,b             ; block of the background
    ld b,a
    push bc
    call LrNib
    ld (AMY_UVAR_LrT),a
    pop bc
    inc b
    call LrNib
    add a,a
    add a,a
    add a,a
    add a,a
    ld hl,AMY_UVAR_LrT
    or (hl)
    ld (hl),a
    pop de
    push de
    ; the cell: tile row 1 + E/2, pixel row (E & 1) * 4
    ld a,e
    srl a
    inc a               ; tile row 1-18
    ld c,a
    and $07
    ld b,a              ; row in its third
    ld a,c
    rrca
    rrca
    rrca
    and $03             ; third
    ld c,a
    ; code = (third 2: 128) + row*30 + D
    ld a,b
    add a,a             ; *2
    ld h,a
    add a,a
    add a,a
    add a,a             ; *16
    sub h               ; *14
    add a,a             ; *28
    add a,h             ; *30
    add a,d
    ld b,a
    ld a,c
    cp 2
    jr nz,LrBc3
    ld a,b
    add a,128
    ld b,a
LrBc3:
    ; address = $2000 + third*$800 + code*8 + (E & 1)*4
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,$20
    add a,h
    ld h,a
    bit 0,e
    jr z,LrBc4
    ld a,l
    add a,4
    ld l,a
LrBc4:
    call VWr
    ld a,(AMY_UVAR_LrT)
    out (VDPD),a
    nop
    nop
    nop
    nop
    nop
    out (VDPD),a
    nop
    nop
    nop
    nop
    out (VDPD),a
    nop
    nop
    nop
    nop
    nop
    out (VDPD),a
    pop de
    pop bc
    ret

; LrBlock: shows block B (column 0-39), E (row 0-47)
LrBlock:
    push bc
    push de
    ld a,b
    add a,a
    ld c,a
    add a,a
    add a,c             ; 6x (x < 40: fits a byte)
    ld c,a
    rrca
    rrca
    rrca
    and $1F
    ld d,a
    call LrByteCol
    ld a,c
    add a,5
    rrca
    rrca
    rrca
    and $1F
    cp d
    jr z,LrBlk2
    ld d,a
    call LrByteCol
LrBlk2:
    pop de
    pop bc
    ret

; LrRow: shows lo-res row E (all 30 byte columns)
LrRow:
    ld d,0
LrRow2:
    call LrByteCol
    inc d
    ld a,d
    cp 30
    jr c,LrRow2
    ret

; LrShowAll: the lo-res rows 0-35, from the page
LrShowAll:
    ld e,0
LrSa2:
    call LrRow
    inc e
    ld a,e
    cp 36
    jr c,LrSa2
    ret

; LrPlot: block B, E in COLOR (PLOT's mask: even rows the low nibble)
LrPlot:
    push bc
    ld c,e
    srl c
    call LrPeek
    ld d,a
    ld a,(AMY_UVAR_Col)
    bit 0,e
    jr nz,LrPl2
    and $0F
    ld h,a
    ld a,d
    and $F0
    jr LrPl3
LrPl2:
    and $F0
    ld h,a
    ld a,d
    and $0F
LrPl3:
    or h
    call LrPoke
    pop bc
    ld a,(AMY_UVAR_LrShow)
    or a
    ret z
    jp LrBlock

; LrHlin: HLIN Lx1,Lx2 AT Ly
LrHlin:
    ld a,(AMY_UVAR_Lx1)
    ld b,a
LrHl2:
    ld a,(AMY_UVAR_Ly)
    ld e,a
    call LrPlot
    ld a,(AMY_UVAR_Lx2)
    cp b
    ret z
    inc b
    jr LrHl2

; LrVlin: VLIN Ly1,Ly2 AT Lx
LrVlin:
    ld a,(AMY_UVAR_Ly1)
    ld e,a
LrVl2:
    ld a,(AMY_UVAR_Lx)
    ld b,a
    call LrPlot
    ld a,(AMY_UVAR_Ly2)
    cp e
    ret z
    inc e
    jr LrVl2

; LrClrTop: GR's CLRTOP, lo-res rows 0-39 black (page rows 0-19 = 0)
LrClrTop:
    ld hl,LrPage
    call VWr
    ld bc,800
LrCt2:
    xor a
    out (VDPD),a
    dec bc
    ld a,b
    or c
    jr nz,LrCt2
    ret

; LrClrRow: page row C, columns WndL to WndL+WndW-1, spaces ($A0)
LrClrRow:
    ld a,(AMY_UVAR_WndL)
    ld b,a
    ld a,(AMY_UVAR_WndW)
    ld d,a
LrCr2:
    ld a,$A0
    call LrPoke
    call LrShowCh
    inc b
    dec d
    jr nz,LrCr2
    ret

; LrHome: HOME (the window cleared, the cursor at its top left)
LrHome:
    ld a,(AMY_UVAR_WndT)
    ld c,a
LrHo2:
    ld a,(AMY_UVAR_WndB)
    cp c
    jr z,LrHo3
    push bc
    call LrClrRow
    pop bc
    inc c
    jr LrHo2
LrHo3:
    xor a
    ld (AMY_UVAR_Ch),a
    ld a,(AMY_UVAR_WndT)
    ld (AMY_UVAR_Cv),a
    ret

; LrShowCh: shows page byte B, C just written (A = the byte): a lo-res
; row as its two blocks, a text line below as a letter (Apple column B on
; tile column B - 5, kept to 2-29; tile row C - 1)
LrShowCh:
    push af
    push bc
    push de
    push hl
    and $7F
    cp $20
    jr nc,$+4
    add a,$40
    ld (AMY_UVAR_LrT2),a
    ld a,(AMY_UVAR_LrShow)
    or a
    jr z,LrSc9
    ld a,c
    cp 20
    jr nc,LrSc5
    add a,a
    ld e,a
    call LrBlock
    inc e
    call LrBlock
    jr LrSc9
LrSc5:
    ld a,(AMY_UVAR_LrNoTx)
    or a
    jr nz,LrSc9
    ld a,b
    sub 7
    cp 28
    jr nc,LrSc9
    add a,2
    ld e,a
    ld d,0
    ld a,c
    dec a
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de
    ld de,$1800
    add hl,de
    call VWr
    ld a,(AMY_UVAR_LrT2)
    out (VDPD),a
LrSc9:
    pop hl
    pop de
    pop bc
    pop af
    ret

; LrCout: the monitor's COUT1 for the byte in A (printing $A0-$FF, $8D CR)
LrCout:
    cp $8D
    jr z,LrCr
    cp $8A
    jr z,LrLf
    cp $A0
    ret c
    ld e,a
    ld a,(AMY_UVAR_Cv)
    ld c,a
    ld a,(AMY_UVAR_WndL)
    ld b,a
    ld a,(AMY_UVAR_Ch)
    add a,b
    ld b,a
    ld a,e
    call LrPoke
    call LrShowCh
    ; ADVANCE
    ld a,(AMY_UVAR_Ch)
    inc a
    ld (AMY_UVAR_Ch),a
    ld hl,AMY_UVAR_WndW
    cp (hl)
    ret c
LrCr:
    xor a
    ld (AMY_UVAR_Ch),a
LrLf:
    ld a,(AMY_UVAR_Cv)
    inc a
    ld (AMY_UVAR_Cv),a
    ld hl,AMY_UVAR_WndB
    cp (hl)
    ret c
    dec a
    ld (AMY_UVAR_Cv),a
    ; SCROLL: each window row takes the next one's bytes, the last is cleared
    ld a,(AMY_UVAR_WndT)
    ld c,a
LrScr2:
    ld a,c
    inc a
    ld hl,AMY_UVAR_WndB
    cp (hl)
    jr nc,LrScr4
    ld a,(AMY_UVAR_WndL)
    ld b,a
    ld a,(AMY_UVAR_WndW)
    ld d,a
LrScr3:
    inc c
    call LrPeek
    dec c
    call LrPoke
    call LrShowCh
    inc b
    dec d
    jr nz,LrScr3
    inc c
    jr LrScr2
LrScr4:
    jp LrClrRow

; LrLight: the listing's lightning routine at 803 (POKEd at 1401-1441):
; in page rows 0 to WndT-1, the low nibbles equal to the old colour's
; take the new colour's, then the high nibbles likewise; the new colour
; becomes the old one. (CALL 800 only notes the old colour: LrOld.)
LrLight:
    ld c,0
LrLi2:
    ld a,(AMY_UVAR_WndT)
    cp c
    jr z,LrLi9
    ld b,0
LrLi3:
    call LrPeek
    ld d,a
    and $0F
    ld e,a
    ld a,(AMY_UVAR_LrOld)
    and $0F
    cp e
    jr nz,LrLi4
    ld a,(AMY_UVAR_Col)
    and $0F
    ld e,a
    ld a,d
    and $F0
    add a,e
    ld d,a
LrLi4:
    ld a,d
    and $F0
    ld e,a
    ld a,(AMY_UVAR_LrOld)
    and $F0
    cp e
    jr nz,LrLi5
    ld a,(AMY_UVAR_Col)
    and $F0
    ld e,a
    ld a,d
    and $0F
    add a,e
    ld d,a
LrLi5:
    ld a,d
    call LrPoke
    inc b
    ld a,b
    cp 40
    jr c,LrLi3
    inc c
    jr LrLi2
LrLi9:
    ld a,(AMY_UVAR_Col)
    ld (AMY_UVAR_LrOld),a
    ld a,(AMY_UVAR_LrShow)
    or a
    ret z
    jp LrShowAll

; LrPrep: the VRAM for the lo-res screen: names, the three masks as
; patterns, black colours (shown with the display off)
LrPrep:
    ; names: rows 0 and 23 and columns 0 and 31 blank, the rest by cell
    ld hl,$1800
    call VWr
    ld c,0              ; tile row
LrPp1:
    ld b,0              ; tile column
LrPp2:
    ld a,c
    or a
    jr z,LrPpBl
    cp 19
    jr nc,LrPpTx
    ld a,b
    or a
    jr z,LrPpBl
    cp 31
    jr z,LrPpBl
    ; code = row-in-third*30 + column-1 (+128 in the last third)
    ld a,c
    and 7
    ld e,a
    add a,a
    ld d,a
    add a,a
    add a,a
    add a,a
    sub d
    add a,a
    add a,d
    add a,b
    dec a
    ld e,a
    ld a,c
    cp 16
    ld a,e
    jr c,LrPp3
    add a,128
LrPp3:
    out (VDPD),a
    jr LrPp4
LrPpBl:
    ld a,c
    cp 16
    ld a,255
    jr c,LrPp3
    ld a,32
    jr LrPp3
LrPpTx:
    ld a,32
    out (VDPD),a
LrPp4:
    inc b
    ld a,b
    cp 32
    jr c,LrPp2
    inc c
    ld a,c
    cp 24
    jr c,LrPp1
    ; patterns: thirds 0 and 1 codes 0-255, third 2 codes 128-255; a lo-res
    ; cell's index i (code, -128 in the last third) has the mask of its
    ; byte column (i mod 30) mod 3; i >= 240 (or >= 90 below) is blank
    ld hl,0
    call VWr
    ld e,0
LrPp5:
    ld b,0
LrPp6:
    ld a,b
    call LrMask
    call LrOut8
    inc b
    jr nz,LrPp6
    inc e
    ld a,e
    cp 2
    jr c,LrPp5
    ld hl,$1000+128*8
    call VWr
    ld b,0
LrPp7:
    ld a,b
    cp 90
    ld a,0
    jr nc,LrPp8
    ld a,b
    call LrMask
LrPp8:
    call LrOut8
    inc b
    ld a,b
    cp 128
    jr c,LrPp7
    ; colours: black (1 on 1) for the lo-res codes, the font's white on black
    ld hl,$2000
    call VWr
    ld de,$1800
LrPpF:
    ld a,$11
    out (VDPD),a
    dec de
    ld a,d
    or e
    jr nz,LrPpF
    ld hl,$3000+32*8
    call VWr
    ld de,64*8
LrPpG:
    ld a,$F1
    out (VDPD),a
    dec de
    ld a,d
    or e
    jr nz,LrPpG
    ret

; LrMask: A = the pattern byte of lo-res cell index A (0 when >= 240)
LrMask:
    cp 240
    jr c,LrMk1
    xor a
    ret
LrMk1:
    cp 30
    jr c,LrMk2
    sub 30
    jr LrMk1
LrMk2:
    cp 3
    jr c,LrMk3
    sub 3
    jr LrMk2
LrMk3:
    or a
    jr nz,LrMk4
    ld a,$03
    ret
LrMk4:
    dec a
    ld a,$0F
    ret z
    ld a,$3F
    ret
; LrOut8: A out 8 times
LrOut8:
    push bc
    ld b,8
LrO8:
    out (VDPD),a
    nop
    djnz LrO8
    pop bc
    ret

; ---------------------------------------------------------------------------
; The text screens: a console on columns 2-29, rows TxTop-22, that wraps
; between words (the Apple's 40 columns don't fit; the words keep their
; order) and scrolls its window as the Apple's did.
;   TxStr HL: a string ending in 0 (13 = new line, 1 = blank line)
;   TxNl: new line; TxHome: the window cleared, cursor at its top
TXL     EQU 2
TXR     EQU 30

; TxName: HL = the name table address of TxX, TxY
TxName:
    ld a,(AMY_UVAR_TxY)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_TxX)
    add a,l
    ld l,a
    ld a,h
    adc a,$18
    ld h,a
    ret

; TxOut: the letter in A at the cursor, then the cursor moves right
TxOut:
    push af
    ld a,(AMY_UVAR_TxX)
    cp TXR
    call nc,TxNl
    call TxName
    call VWr
    pop af
    out (VDPD),a
    ld hl,AMY_UVAR_TxX
    inc (hl)
    ret

TxNl:
    push af
    push bc
    push de
    push hl
    ld a,TXL
    ld (AMY_UVAR_TxX),a
    ld a,(AMY_UVAR_TxY)
    inc a
    cp 23
    jr c,TxNl2
    call TxScroll
    ld a,22
TxNl2:
    ld (AMY_UVAR_TxY),a
    pop hl
    pop de
    pop bc
    pop af
    ret

; TxScroll: rows TxTop+1-22 up one, row 22 blank
TxScroll:
    ld a,(AMY_UVAR_TxTop)
    ld c,a
TxSc2:
    ld a,c
    cp 22
    jr nc,TxSc4
    ; read row c+1 into TxLine, write it on row c
    ld a,c
    inc a
    call TxRowAddr
    call VRd
    ld hl,AMY_UVAR_TxLine
    ld b,32
TxSc3:
    nop
    nop
    nop
    in a,(VDPD)
    ld (hl),a
    inc hl
    djnz TxSc3
    ld a,c
    call TxRowAddr
    call VWr
    ld hl,AMY_UVAR_TxLine
    ld b,32
TxSc5:
    ld a,(hl)
    out (VDPD),a
    inc hl
    nop
    djnz TxSc5
    inc c
    jr TxSc2
TxSc4:
    ld a,22
    jp TxBlankRow

; TxRowAddr: HL = name table address of row A, column 0
TxRowAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,h
    add a,$18
    ld h,a
    ret

; TxBlankRow: row A all spaces
TxBlankRow:
    call TxRowAddr
    call VWr
    ld b,32
    ld a,32
TxBr2:
    out (VDPD),a
    nop
    nop
    djnz TxBr2
    ret

; TxHome: rows TxTop-22 cleared, the cursor at TxTop, column 2
TxHome:
    ld a,(AMY_UVAR_TxTop)
TxHo2:
    cp 23
    jr nc,TxHo3
    push af
    call TxBlankRow
    pop af
    inc a
    jr TxHo2
TxHo3:
    ld a,(AMY_UVAR_TxTop)
    ld (AMY_UVAR_TxY),a
    ld a,TXL
    ld (AMY_UVAR_TxX),a
    ret

; TxClrEop: from the cursor to the end of the window (CALL -958)
TxClrEop:
    call TxName
    call VWr
    ld a,(AMY_UVAR_TxX)
    ld b,a
    ld a,32
    sub b
    ld b,a
    ld a,32
TxCe2:
    out (VDPD),a
    nop
    nop
    djnz TxCe2
    ld a,(AMY_UVAR_TxY)
TxCe3:
    inc a
    cp 23
    ret nc
    push af
    call TxBlankRow
    pop af
    jr TxCe3

; TxStr: prints the string at HL, wrapping between words
TxStr:
    ld a,(hl)
    or a
    ret z
    cp 13
    jr nz,TxSt2
    inc hl
    push hl
    call TxNl
    pop hl
    jr TxStr
TxSt2:
    cp 1
    jr nz,TxSt3
    inc hl
    push hl
    call TxNl
    call TxNl
    pop hl
    jr TxStr
TxSt3:
    cp 32
    jr nz,TxSt4
    ; a space: at the start of a wrapped line it is left out
    inc hl
    ld a,(AMY_UVAR_TxX)
    cp TXR
    jr nc,TxStr
    push hl
    ld a,32
    call TxOut
    pop hl
    jr TxStr
TxSt4:
    ; a word: its length, then a new line first if it doesn't fit
    push hl
    ld b,0
TxSt5:
    ld a,(hl)
    or a
    jr z,TxSt6
    cp 32
    jr z,TxSt6
    cp 13
    jr z,TxSt6
    cp 1
    jr z,TxSt6
    inc b
    inc hl
    jr TxSt5
TxSt6:
    ld a,(AMY_UVAR_TxX)
    add a,b
    cp TXR+1
    jr c,TxSt7
    ld a,(AMY_UVAR_TxX)
    cp TXL
    call nz,TxNl
TxSt7:
    pop hl
TxSt8:
    ld a,(hl)
    or a
    ret z
    cp 32
    jr z,TxStr
    cp 13
    jr z,TxStr
    cp 1
    jr z,TxStr
    push hl
    call TxOut
    pop hl
    inc hl
    jr TxSt8

; TxPad: spaces up to column A (TAB)
TxPad:
    ld b,a
TxPd2:
    ld a,(AMY_UVAR_TxX)
    cp b
    ret nc
    push bc
    ld a,32
    call TxOut
    pop bc
    jr TxPd2

; TxU16: the whole number in DE, as PRINT shows it
TxU16:
    ld hl,AMY_UVAR_TxNum+5
    ld (hl),0
TxU2:
    dec hl
    push hl
    ex de,hl
    ld c,10
    call TxDiv
    ex de,hl
    pop hl
    add a,48
    ld (hl),a
    ld a,d
    or e
    jr nz,TxU2
    jp TxStr
; HL = HL / C, A = remainder
TxDiv:
    xor a
    ld b,16
TxDv2:
    add hl,hl
    rla
    cp c
    jr c,TxDv3
    sub c
    inc l
TxDv3:
    djnz TxDv2
    ret

; ---------------------------------------------------------------------------
; The listing's tone routine (POKEd at 770 by line 781): a square wave of
; half period 10P + 10 + 7P/256 Apple cycles for J units of 2567 +
; 2560/P cycles (P 0 counts as 256), played here on channel 0 for the same
; time (the tables are made by tune.py). The Apple did nothing else while
; it played, so neither does this.
SNDP    EQU $FF
; Tone: pitch TnP, length TnJ
Tone:
    ld a,(AMY_UVAR_TnP)
    ld l,a
    ld h,0
    add hl,hl
    push hl
    ld de,TnDiv
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,e
    and $0F
    or $80
    out (SNDP),a
    ld a,e
    srl d
    rra
    srl d
    rra
    srl d
    rra
    srl d
    rra
    and $3F
    out (SNDP),a
    ld a,$90
    out (SNDP),a
    pop hl
    ld de,TnLoop
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,(AMY_UVAR_TnJ)
    ld c,a
TnUnit:
    ld h,d
    ld l,e
TnSpin:
    dec hl
    ld a,h
    or l
    jp nz,TnSpin
    dec c
    jr nz,TnUnit
    ld a,$9F
    out (SNDP),a
    ret

; Hush: all four channels off
Hush:
    ld a,$9F
    out (SNDP),a
    ld a,$BF
    out (SNDP),a
    ld a,$DF
    out (SNDP),a
    ld a,$FF
    out (SNDP),a
    ret

; Bell: the monitor's BELL (CHR$(7)): 11 ms quiet, then 192 half waves of
; 545 cycles (about 940 Hz for 0.1 s)
Bell:
    ld hl,1630
    call SpinHL
    ld a,$80+7
    out (SNDP),a
    ld a,7
    out (SNDP),a
    ld a,$90
    out (SNDP),a
    ld hl,15300
    call SpinHL
    ld a,$9F
    out (SNDP),a
    ret

; SpinHL: HL times 24 cycles
SpinHL:
    dec hl
    ld a,h
    or l
    jp nz,SpinHL
    ret

; Loops: the time of AMY_UVAR_LpN empty FOR loops of Applesoft (about 0.95 ms
; each: 3330 Z80 cycles)
Loops:
    ld hl,(AMY_UVAR_LpN)
    ld a,h
    or l
    ret z
Lp2:
    push hl
    ld hl,138
    call SpinHL
    pop hl
    dec hl
    ld a,h
    or l
    jr nz,Lp2
    ret

; generated by tune.py: the tone routine's divider and length
TnDiv:
    dw 565,4,7,9,11,13,15,18,20,22,24,26,29,31,33,35
    dw 37,40,42,44,46,48,51,53,55,57,59,62,64,66,68,70
    dw 73,75,77,79,81,84,86,88,90,92,95,97,99,101,103,106
    dw 108,110,112,114,117,119,121,123,125,127,130,132,134,136,138,141
    dw 143,145,147,149,152,154,156,158,160,163,165,167,169,171,174,176
    dw 178,180,182,185,187,189,191,193,196,198,200,202,204,207,209,211
    dw 213,215,218,220,222,224,226,229,231,233,235,237,240,242,244,246
    dw 248,251,253,255,257,259,262,264,266,268,270,273,275,277,279,281
    dw 284,286,288,290,292,295,297,299,301,303,306,308,310,312,314,317
    dw 319,321,323,325,328,330,332,334,336,339,341,343,345,347,350,352
    dw 354,356,358,361,363,365,367,369,372,374,376,378,380,382,385,387
    dw 389,391,393,396,398,400,402,404,407,409,411,413,415,418,420,422
    dw 424,426,429,431,433,435,437,440,442,444,446,448,451,453,455,457
    dw 459,462,464,466,468,470,473,475,477,479,481,484,486,488,490,492
    dw 495,497,499,501,503,506,508,510,512,514,517,519,521,523,525,528
    dw 530,532,534,536,539,541,543,545,547,550,552,554,556,558,561,563
TnLoop:
    dw 377,749,562,500,469,450,438,429,422,417,413,409,406,404,402,400
    dw 399,397,396,395,394,393,392,391,391,390,390,389,389,388,388,387
    dw 387,387,386,386,386,385,385,385,385,384,384,384,384,383,383,383
    dw 383,383,383,383,382,382,382,382,382,382,382,382,381,381,381,381
    dw 381,381,381,381,381,381,381,380,380,380,380,380,380,380,380,380
    dw 380,380,380,380,380,380,380,379,379,379,379,379,379,379,379,379
    dw 379,379,379,379,379,379,379,379,379,379,379,379,379,379,379,379
    dw 379,378,378,378,378,378,378,378,378,378,378,378,378,378,378,378
    dw 378,378,378,378,378,378,378,378,378,378,378,378,378,378,378,378
    dw 378,378,378,378,378,378,378,378,378,378,378,378,378,378,378,378
    dw 378,378,377,377,377,377,377,377,377,377,377,377,377,377,377,377
    dw 377,377,377,377,377,377,377,377,377,377,377,377,377,377,377,377
    dw 377,377,377,377,377,377,377,377,377,377,377,377,377,377,377,377
    dw 377,377,377,377,377,377,377,377,377,377,377,377,377,377,377,377
    dw 377,377,377,377,377,377,377,377,377,377,377,377,377,377,377,377
    dw 377,377,377,377,377,377,377,377,377,377,377,377,377,377,377,377

; Applesoft II floating point, translated to Z80 by xlate.py
Fp_E7A0:
