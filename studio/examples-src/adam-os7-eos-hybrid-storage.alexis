' OS7-style game code with optional EOS storage when running on ADAM.
u8 SaveStatus = 255
u8 SaveData[4]

text screen
print centered at 4, "OS7 + EOS HYBRID"
print centered at 7, "GAMEPLAY USES OS7"
print centered at 9, "SAVES USE EOS MEDIA"
screen on

SaveData[0] = $41
SaveData[1] = $4D
SaveData[2] = $59
SaveData[3] = $21

create "HYBRID" 1024 status SaveStatus
write "HYBRID" from SaveData count 4 status SaveStatus

print at 5,13, "EOS SAVE STATUS"
print SaveStatus at 22,13 width 1
print centered at 18, "PRESS FIRE"
pause until press

loop forever
