  tile screen
  set sound table WwSoundTable areas 4
  ShareTables
  sprites 16x16
  nmi off
  copy SprPat count SprBytes to vram.spr_pat + 64
  HideSpr
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  BuildSat
  HudUpdate
  SndSvc
  if State = StPlay then goto play_loop
  InPlay = 0
  if State = StClear then
    SectClear
    goto play_loop
  end if
  GameOver
  goto title

' ===========================================================================
' trig: Sn = 127 * sin(D * 2 pi / 64) from the quarter wave SinQ

sub Sin64:
  T = D & 63
  U = T >> 4
  T = T & 15
  if U = 1 then T = 16 - T
  if U = 3 then T = 16 - T
  Sn = SinQ[T]
  if U >= 2 then Sn = 0 - Sn
  return
end sub

' ===========================================================================
' game flow

sub NewGame:
  SndQ = 0
  Score = 0
  Hull = 3
  TimeL = Time0
  Sect = 0
  Lap = 0
  Streak = 0
  Clears = 0
  HitsN = 0
  Picks = 0
  GateTot = 0
  MissTot = 0
  SectIntro
  return
end sub

' a section: the card, the map unpacked into VRAM, the lists, the kayak
sub SectIntro:
  InPlay = 0
  NewScreen
  State = 12
  print at 9,6, "SECTION"
  NumU = Sect + 1
  print at 17,6, digits$(NumU, 1)
  if Lap > 0 then print at 19,6, "+"
  select case Sect
    case 0
      print at 9,9, "MEADOW RUN"
    case 1
      print at 9,9, "BIRCH BEND"
    case 2
      print at 9,9, "LOG FLUME"
    case 3
      print at 7,9, "BOULDER GARDEN"
    case 4
      print at 9,9, "THE NARROWS"
    case 5
      print at 8,9, "DEVILS CHUTE"
  end select
  put char TGate at 8,13
  put char TGater at 9,13
  NumU = NGates[Sect]
  print at 11,13, digits$(NumU, 2)
  print at 14,13, "GATES"
  print at 6,17, "GREEN LEFT, RED RIGHT"
  ShowScreen
  ' the map store (display off: the unpacker reads VRAM back)
  Rearm
  wait
  nmi off
  display off
  select case Sect
    case 0
      decompress zx0 StA0 to vram.pattern + 2048
      decompress zx0 StB0 to vram.color + 2048
    case 1
      decompress zx0 StA1 to vram.pattern + 2048
      decompress zx0 StB1 to vram.color + 2048
    case 2
      decompress zx0 StA2 to vram.pattern + 2048
      decompress zx0 StB2 to vram.color + 2048
    case 3
      decompress zx0 StA3 to vram.pattern + 2048
      decompress zx0 StB3 to vram.color + 2048
    case 4
      decompress zx0 StA4 to vram.pattern + 2048
      decompress zx0 StB4 to vram.color + 2048
    case 5
      decompress zx0 StA5 to vram.pattern + 2048
      decompress zx0 StB5 to vram.color + 2048
  end select
  screen on
  nmi off
  ' the lists of this section
  W = GateOff[Sect]
  GCount = NGates[Sect]
  GNext = 0
  LoadGate
  W = WhirlOff[Sect]
  copy WhirlAll + W count 16 to Wh
  WhN = 0
  for K = 0 to 3
    T = K << 2
    if Wh[T] <> 255 then
      if WhN = K then inc WhN
    end if
    W = Wh[T + 1]
    W = W << 8
    W += Wh[T]
    WhY[K] = W
    WhX[K] = Wh[T + 2]
    WhD[K] = Wh[T + 3]
  next
  WNext = 0
  W = PickOff[Sect]
  copy PickAll + W count 24 to Pk
  PkN = 0
  for K = 0 to 5
    T = K << 2
    if Pk[T] <> 255 then
      if PkN = K then inc PkN
    end if
    W = Pk[T + 1]
    W = W << 8
    W += Pk[T]
    PkY[K] = W
    PkX[K] = Pk[T + 2]
  next
  PNext = 0
  Taken = 0
  LgOff = LogOff[Sect]
  LgR = 65535
  LNext = 0
  LgOn[0] = 0
  LgOn[1] = 0
  SecBase = Sect * 5
  Boost = 0
  for K = 1 to 9
    if Lap >= K then Boost += 48
  next
  ' the kayak at the start pool
  CamY = 0
  CamR = 0
  CamS = 0
  KX = StartX[Sect]
  KX = KX << 8
  W = StartRow * 8
  W += 16
  KY = W << 8
  T = SecBase + 1
  Si = CurC[T]
  VY = Si + Boost
  VX = 0
  Hd = 0
  StrokeT = 0
  TurnT = 0
  Run2 = 0
  Ft = 0
  Side = 0
  Inv = 0
  HitT = 0
  PopT = 0
  GatesOk = 0
  GatesMiss = 0
  ' wait for the button to be let go, a short look at the card
  Waited = 0
sc_wait:
  Frame1
  ReadPad
  inc Waited
  if Waited < 50 then goto sc_wait
  if Waited < 150 then
    if Btn = 0 then goto sc_wait
  end if
  ' the river screen (display off while it is built; no NewScreen here:
  ' its colour fill would overwrite the map store at $2800)
  Rearm
  wait
  nmi off
  display off
  HideSpr
  CamS = 0
  FlowPh = 0
  HudF = 1
  BarN = 255
  HudUpdate
  BuildSat
  FullR = 1
  Blit
  ShowScreen
  InPlay = 1
  State = StPlay
  return
end sub

' the next gate (4 bytes from GateAll + W) and its line
sub LoadGate:
  T = GNext << 2
  W2 = W + T
  copy GateAll + W2 count 4 to GCur
  GY = GCur[1]
  GY = GY << 8
  GY += GCur[0]
  return
end sub

sub SectClear:
  inc Clears
  play sound SndClear
  NewScreen
  print at 9,5, "SECTION"
  NumU = Sect + 1
  print at 17,5, digits$(NumU, 1)
  print at 9,7, "CLEAR!"
  put char TGate at 8,11
  put char TGater at 9,11
  NumU = GatesOk
  print at 11,11, digits$(NumU, 2)
  print at 13,11, "/"
  NumU = GCount
  print at 14,11, digits$(NumU, 2)
  print at 17,11, "GATES"
  put char THull at 8,14
  print at 10,14, "HULL +1 (MAX 3)"
  ShowScreen
  Waited = 0
cl_wait:
  Frame1
  ReadPad
  inc Waited
  if Waited < 100 then goto cl_wait
  inc Sect
  if Sect >= NSect then
    Sect = 0
    inc Lap
  end if
  SectIntro
  return
end sub

sub GameOver:
  play sound SndOver
  NewScreen
  if OverWhy = 1 then
    print at 11,6, "CAPSIZED!"
  else
    print at 11,6, "TIME UP!"
  end if
  print at 9,10, "SCORE"
  NumU = Score
  print at 15,10, digits$(NumU, 5)
  print at 20,10, "0"
  print at 9,12, "SECTION"
  NumU = Sect + 1
  print at 17,12, digits$(NumU, 1)
  if Lap > 0 then print at 19,12, "+"
  put char TGate at 9,14
  put char TGater at 10,14
  NumU = GateTot
  print at 12,14, digits$(NumU, 3)
  print at 16,14, "GATES"
  print at 8,20, "PRESS THE BUTTON"
  ShowScreen
  ' one press returns to the title (after 1 s); the screen sleeps when idle
  nmi on
  wait 60 frames
  pause until press and release sleep after 10 seconds
  nmi off
  return
end sub

' ===========================================================================
' one play frame (the rules of model.mjs, step for step)

sub PlayStep:
  inc Ft
  dec TimeL
  if TimeL = 0 then
    OverWhy = 2
    State = StOver
    return
  end if
  OKX = KX
  OKY = KY
  OHd = Hd
  T = highbyte KY
  OWY = CamY + T
  OWY -= 16
  ' turn
  T = Jk & 4
  if T > 0 then Hd -= Turn
  T = Jk & 8
  if T > 0 then Hd += Turn
  ' paddle stroke: 16 frames, thrust in frames 12..5
  if StrokeT > 0 then dec StrokeT
  if StrokeT = 0 then
    if Btn > 0 then
      StrokeT = 16
      T = Jk & 12
      if T = 4 then
        Side = 0
      elseif T = 8 then
        Side = 1
      else
        Side = 1 - Side
      end if
      SndN = SndStroke
      SndQue
    end if
  end if
  D = Hd >> 2
  Sin64
  SnH = Sn
  D += 16
  Sin64
  CsH = Sn
  HdS = Hd
  if StrokeT >= 5 then
    if StrokeT <= 12 then
      Si = SnH >> 2
      VX += Si
      Si = CsH >> 2
      VY += Si
    end if
  end if
  ' the current under the kayak's centre
  Qx = highbyte KX
  Qy = OWY
  KindAt
  Current
  if CY > 0 then CY += Boost
  Whirls
  ' drag toward the current
  Si = CX - VX
  Si = Si >> 4
  VX += Si
  Si = CY - VY
  Si = Si >> 4
  VY += Si
  if VX > VMax then VX = VMax
  if VX < -VMax then VX = -VMax
  if VY > VMax then VY = VMax
  if VY < -VMax then VY = -VMax
  KX += VX
  KY += VY
  T = highbyte KY
  if T < 24 then
    KY = 6144
    if VY < 0 then VY = 0
  end if
  if T > 176 then KY = 45056
  ' hull probes: centre, bow, stern
  if Hd <> HdS then
    D = Hd >> 2
    Sin64
    SnH = Sn
    D += 16
    Sin64
    CsH = Sn
  end if
  BX = SnH >> 4
  BY = CsH >> 4
  ' collision response (r12): every try uses the NEW heading, so turning is
  ' never blocked by itself: the full move; slide (old x, new y); slide
  ' (new x, old y); the old spot; a 2 px push-out up, left, right, down;
  ' only if all fail the old state. Never a pin, never a penetration.
  Dmg = 0
  T = highbyte KY
  WY = CamY + T
  WY -= 16
  PX = highbyte KX
  PY = WY
  Probe3
  if Hit > 0 then
    ' a try equal to one already made is not probed again (same answer):
    ' XS / YS = the pixel x / world y did not change this frame
    PX = highbyte OKX
    XS = 0
    T = highbyte KX
    if PX = T then XS = 1
    YS = 0
    if WY = OWY then YS = 1
    if XS = 0 then Probe3
    if Hit = 0 then
      KX = OKX
      Si = VX >> 2
      VX = 0 - Si
    else
      PX = highbyte KX
      PY = OWY
      if YS = 0 then Probe3
      if Hit = 0 then
        KY = OKY
        Si = VY >> 2
        VY = 0 - Si
      else
        Si = VX >> 1
        VX = 0 - Si
        Si = VY >> 1
        VY = 0 - Si
        KX = OKX
        KY = OKY
        PX = highbyte OKX
        ' the old spot: free with the old heading (it was accepted), else
        ' a new try only if it differs from the ones above
        if Hd = OHd then
          Hit = 0
        else
          T = XS | YS
          if T = 0 then Probe3
        end if
        if Hit > 0 then
          PY -= 2
          Probe3
          if Hit = 0 then
            KY -= 512
          else
            PY = OWY
            PX -= 2
            Probe3
            if Hit = 0 then
              KX -= 512
            else
              PX += 4
              Probe3
              if Hit = 0 then
                KX += 512
              else
                PX -= 2
                PY += 2
                Probe3
                if Hit = 0 then
                  KY += 512
                else
                  Hd = OHd
                end if
              end if
            end if
          end if
        end if
      end if
    end if
    if Dmg > 0 then
      Damage
      if State = StOver then return
    else
      SndN = SndBump
      SndQue
    end if
  end if
  ' camera: the kayak at the anchor, 2 px a frame at most
  T = highbyte KY
  U = 0
  if T > Anchor then
    T -= Anchor
    if T > 2 then T = 2
    ' never three 2-px steps in a row (the hidden page: at most 5 rows a frame)
    if T = 2 then
      if Run2 >= 2 then T = 1
    end if
    W = CamY + T
    if W > CamMax then
      W = CamMax - CamY
      T = lowbyte W
    end if
    CamY += T
    W = T
    W = W << 8
    KY -= W
    U = T
  end if
  if U = 2 then
    inc Run2
  else
    Run2 = 0
  end if
  T = highbyte KY
  WY = CamY + T
  WY -= 16
  Logs
  if State = StOver then return
  Gates
  Pickups
  if Inv > 0 then dec Inv
  if HitT > 0 then dec HitT
  W = FinRow * 8
  W += 4
  if WY >= W then
    Score += 20
    for K = 1 to 3
      if Hull >= K then Score += 10
    next
    if Hull < 3 then inc Hull
    State = StClear
  end if
  ' scroll state for the next blit; the water texture drifts (1 px / 8 frames)
  W = CamY >> 3
  CamR = W
  T = lowbyte CamY
  CamS = T & 7
  T = Tick & 7
  if T = 0 then
    dec FlowPh
    FlowPh = FlowPh & 7
  end if
  RowSched
  if PopT > 0 then dec PopT
  ' the last 10 s tick
  if TimeL < 600 then
    T = lowbyte TimeL
    T = T & 63
    if T = 0 then
      SndN = SndTick
      SndQue
    end if
  end if
  return
end sub

' the current of cell kind Qk at x Qx: CY from the section's 5 class values,
' CX only in eddies (into the wake: + on an even column, - on an odd one)
sub Current:
  U = KindCls[Qk]
  T = SecBase + U
  CY = CurC[T]
  CX = 0
  if U = 3 then
    T = Qx >> 3
    T = T & 1
    if T = 0 then
      CX = 72
    else
      CX = -72
    end if
  end if
  return
end sub

' rows of the hidden page for the next blit: the rows left, spread over the
' frames before the next flip can come (at the top speed, 2 px a frame)
sub RowSched:
  if CamR <> DrR then
    U = 21
  else
    U = 23 - BldRow
  end if
  ' frames before the next crossing at the fastest camera (2,2,1 px...)
  T = 8 - CamS
  T = FrT[T]
  ' rows = ceil(U / T), from a table (T 1-5, U 0-21)
  T = RowOff[T]
  T += U
  RowsN = RowDiv[T]
  return
end sub

' the hull's three probes (centre, bow, stern = centre +- BX, BY) at the
' centre PX (screen x), PY (world y), asm: stops at the first solid probe
' (centre, bow, stern) -> Hit; that probe on a rock -> Dmg
sub Probe3:
  asm {
    xor a
    ld (Hit),a
    ld a,(PX)
    ld (Qx),a
    ld hl,(PY)
    ld (Qy),hl
    call WwP1
    ret nz
    ld a,(BX)
    ld b,a
    ld a,(PX)
    add a,b
    ld (Qx),a
    ld hl,(PY)
    ld de,(BY)
    add hl,de
    ld (Qy),hl
    call WwP1
    ret nz
    ld a,(BX)
    ld b,a
    ld a,(PX)
    sub b
    ld (Qx),a
    ld hl,(PY)
    ld de,(BY)
    or a
    sbc hl,de
    ld (Qy),hl
WwP1:
    call WwKA
    ld a,(Qs)
    or a
    ret z
    ld (Hit),a
    ld a,(Qk)
    ld e,a
    ld d,0
    ld hl,DmgT
    add hl,de
    ld a,(hl)
    or a
    jr z,WwP1b
    ld (Dmg),a
WwP1b:
    ld a,1
    or a
    ret
  }
end sub

' a probe at Qx, Qy: solid -> Hit, rock -> Dmg
sub Probe1:
  KindAt
  if Qs > 0 then
    Hit = 1
    T = DmgT[Qk]
    if T > 0 then Dmg = 1
  end if
  return
end sub

sub Damage:
  if Inv > 0 then return
  dec Hull
  inc HitsN
  Inv = InvT
  HitT = HitTT
  SndN = SndHit
  SndQue
  HudF = 1
  if Hull = 0 then
    OverWhy = 1
    State = StOver
  end if
  return
end sub

' whirlpools: the field table + the velocity turned (shear rotation)
sub Whirls:
  if WhN = 0 then return
  WFound = 0
  ' whirlpools left above the view are never reached again
wh_adv:
  if WNext < WhN then
    W = WhY[WNext]
    W += 16
    if W < CamY then
      inc WNext
      goto wh_adv
    end if
  end if
  Li = WNext
  while Li < WhN
    W = WhY[Li]
    W2 = Qy + 16
    if W > W2 then goto wh_done
    W2 = W + 16
    if Qy >= W2 then goto wh_next
    U = WhX[Li]
    Si = Qx
    Sj = U
    Si -= Sj
    Sj = Qy
    Sj -= W
    if Si >= -16 then
      if Si < 16 then
        if Sj >= -16 then
          if Sj < 16 then
            Si += 16
            Si = Si >> 3
            Sj += 16
            Sj = Sj >> 3
            U = lowbyte Sj
            U = U << 2
            U += lowbyte Si
            U = U << 1
            T = WhD[Li]
            if T = 0 then U += 32
            Si = WhirlF[U]
            CX += Si
            inc U
            Si = WhirlF[U]
            CY += Si
            if T = 1 then
              Si = VX >> 4
              VY += Si
              Si = VY >> 4
              VX -= Si
              Hd -= 2
            else
              Si = VX >> 4
              VY -= Si
              Si = VY >> 4
              VX += Si
              Hd += 2
            end if
            if InWh = 0 then
              SndN = SndWhirl
              SndQue
            end if
            InWh = 30
            WFound = 1
            goto wh_done
          end if
        end if
      end if
    end if
wh_next:
    inc Li
  end while
wh_done:
  if WFound = 0 then
    if InWh > 0 then dec InWh
  end if
  return
end sub

' drifting logs: spawn when their row comes into view, drift at half the
' current, crack the hull
sub Logs:
  ' spawn (only when the camera reached a new row)
  W = CamY >> 3
  if W = LgR then goto lg_mv
  LgR = W
lg_sp:
  T = LNext << 2
  W2 = LgOff + T
  copy LogAll + W2 count 4 to LBuf
  if LBuf[1] <> 255 then
    W = LBuf[1]
    W = W << 8
    W += LBuf[0]
    W2 = CamY >> 3
    W2 += 23
    if W <= W2 then
      inc LNext
      K = 2
      if LgOn[1] = 0 then K = 1
      if LgOn[0] = 0 then K = 0
      if K < 2 then
        LgOn[K] = 1
        LgCy[K] = 65535
        W2 = LBuf[2]
        LgX[K] = W2 << 8
        W = W << 3
        W += 4
        LgY[K] = W << 4
        T = LNext << 5
        LgT[K] = T
      end if
      goto lg_sp
    end if
  end if
lg_mv:
  for Li = 0 to 1
    if LgOn[Li] = 1 then LogOne
  next
  return
end sub

sub LogOne:
  asm {
    ; Lx, Ly of log Li
    ld a,(Li)
    add a,a
    ld e,a
    ld d,0
    ld hl,LgX
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld (Lx),hl
    ld hl,LgY
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld (Ly),hl
    ; a log drifts every other frame (slot parity), a double step
    ld a,(Ft)
    ld b,a
    ld a,(Li)
    add a,b
    and 1
    jp nz,WwLo4
    ; the current at the log
    ld a,(Lx+1)
    ld (Qx),a
    call WwSh4
    ld (Qy),hl
    ld (W3),hl
    ; the kind under the log: cached when the pixel did not change
    call WwLc
    jr nz,WwLoK
    ld a,(hl)
    ld (Qk),a
    jr WwLoC
WwLoK:
    call AMY_UPROC_KindAt
    call WwLcSet
WwLoC:
    call AMY_UPROC_Current
    ; W = Lx + (CX >> 1), W2 = Ly + (CY >> 5) (arithmetic shifts)
    ld hl,(CX)
    ld de,(Lx)
    add hl,de
    ld (W),hl
    ld hl,(CY)
    ld b,4
WwLo1:
    sra h
    rr l
    djnz WwLo1
    ld de,(Ly)
    add hl,de
    ld (W2),hl
    ; the new pixel: probe only when it differs (a log stands on water)
    xor a
    ld (Qs),a
    ld a,(W+1)
    ld (Qx),a
    ld hl,(W2)
    call WwSh4
    ld (Qy),hl
    ld a,(Lx+1)
    ld b,a
    ld a,(Qx)
    cp b
    jr nz,WwLo2
    ld de,(W3)
    or a
    sbc hl,de
    jr z,WwLo3
WwLo2:
    call AMY_UPROC_KindAt
    call WwLcSet
WwLo3:
    ld a,(Qs)
    or a
    jr nz,WwLo4
    ld hl,(W)
    ld (Lx),hl
    ld hl,(W2)
    ld (Ly),hl
    ld a,(Li)
    add a,a
    ld e,a
    ld d,0
    ld hl,LgX
    add hl,de
    ld bc,(Lx)
    ld (hl),c
    inc hl
    ld (hl),b
    ld hl,LgY
    add hl,de
    ld bc,(Ly)
    ld (hl),c
    inc hl
    ld (hl),b
WwLo4:
    ; off the view: Ly/16 + 8 < CamY, or Ly/16 > CamY + 196
    ld hl,(Ly)
    call WwSh4
    ld (W),hl
    ld de,8
    add hl,de
    ld de,(CamY)
    or a
    sbc hl,de
    jr c,WwLoOff
    ld hl,(CamY)
    ld de,196
    add hl,de
    ld de,(W)
    or a
    sbc hl,de
    jr c,WwLoOff
    ; the kayak: |dy| < 8
    ld hl,(WY)
    ld de,8
    add hl,de
    ld de,(W)
    or a
    sbc hl,de
    ret c
    ret z
    ld hl,(W)
    ld de,8
    add hl,de
    ld de,(WY)
    or a
    sbc hl,de
    ret c
    ret z
    ; |dx| < 10
    ld a,(KX+1)
    ld b,a
    ld a,(Lx+1)
    sub b
    jr nc,WwLo5
    neg
WwLo5:
    cp 10
    ret nc
    ld a,(Inv)
    or a
    ret nz
    ; bounce back (v = -(v >> 1)) and crack the hull
    ld hl,(VX)
    sra h
    rr l
    call WwNeg
    ld (VX),hl
    ld hl,(VY)
    sra h
    rr l
    call WwNeg
    ld (VY),hl
    jp AMY_UPROC_Damage
WwLoOff:
    ld a,(Li)
    ld e,a
    ld d,0
    ld hl,LgOn
    add hl,de
    ld (hl),0
    ret
; cache of log Li: LgCx (x px), LgCy (y px), LgCk (kind). WwLc: z = Qx, Qy
; are the cached pixel (hl -> its kind); WwLcSet stores Qx, Qy, Qk
WwLc:
    ld a,(Li)
    ld e,a
    ld d,0
    ld hl,LgCx
    add hl,de
    ld a,(Qx)
    cp (hl)
    ret nz
    ld a,e
    add a,a
    ld e,a
    ld hl,LgCy
    add hl,de
    ld a,(Qy)
    cp (hl)
    ret nz
    inc hl
    ld a,(Qy+1)
    cp (hl)
    ret nz
    ld a,(Li)
    ld e,a
    ld d,0
    ld hl,LgCk
    add hl,de
    xor a
    ret
WwLcSet:
    ld a,(Li)
    ld e,a
    ld d,0
    ld hl,LgCx
    add hl,de
    ld a,(Qx)
    ld (hl),a
    ld hl,LgCk
    add hl,de
    ld a,(Qk)
    ld (hl),a
    ld a,e
    add a,a
    ld e,a
    ld hl,LgCy
    add hl,de
    ld a,(Qy)
    ld (hl),a
    inc hl
    ld a,(Qy+1)
    ld (hl),a
    ret
WwSh4:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ret
WwNeg:
    xor a
    sub l
    ld l,a
    sbc a,a
    sub h
    ld h,a
    ret
  }
end sub

' the next gate: crossing its line between the buoys = passed
sub Gates:
  if GNext >= GCount then return
  T = 0
  if WY >= GY then
    if OWY < GY then T = 1
  end if
  W = GY + 24
  if WY > W then T = 1
  if T = 0 then return
  U = highbyte KX
  T = 0
  if U >= GCur[2] then
    if U < GCur[3] then
      if WY < W then T = 1
    end if
  end if
  if T = 1 then
    if Streak < 3 then inc Streak
    T = GatePts[Streak]
    Score += T
    inc GatesOk
    inc GateTot
    if Lap > 0 then
      TimeL += 60
    else
      T = GateTT[Sect]
      TimeL += T
    end if
    if TimeL > TimeMax then TimeL = TimeMax
    SndN = SndGate
    SndQue
    PopP = SPopP100
    if Streak = 2 then PopP = SPopP200
    if Streak = 3 then PopP = SPopP300
    PopC = 15
  else
    Streak = 0
    inc GatesMiss
    inc MissTot
    if TimeL > MissT then
      TimeL -= MissT
    else
      TimeL = 1
    end if
    SndN = SndMiss
    SndQue
    PopP = SPopMISS
    PopC = 15
  end if
  PopT = 40
  PopX = U
  PopY = GY
  HudF = 1
  inc GNext
  W = GateOff[Sect]
  LoadGate
  return
end sub

' bottles and fish
sub Pickups:
  if PNext >= PkN then return
  U = highbyte KX
  for Li = PNext to 5
    if Li < PkN then
      W = PkY[Li]
      W2 = WY + 16
      if W > W2 then exit for
      K = BitT[Li]
      K = K & Taken
      if K = 0 then
        Si = PkX[Li]
        Sj = U
        Si -= Sj
        Sj = W
        Sj -= WY
        if Si > -10 then
          if Si < 10 then
            if Sj > -10 then
              if Sj < 10 then
                K = BitT[Li]
                Taken = Taken | K
                Score += 5
                inc Picks
                TimeL += PickT
                if TimeL > TimeMax then TimeL = TimeMax
                SndN = SndPick
                SndQue
                PopP = SPopP50
                PopC = 15
                PopT = 40
                PopX = PkX[Li]
                PopY = W
                HudF = 1
              end if
            end if
          end if
        end if
      end if
    end if
  next
  ' the ones left behind
pk_adv:
  if PNext < PkN then
    W = PkY[PNext]
    W += 16
    if W < CamY then
      inc PNext
      goto pk_adv
    end if
  end if
  return
end sub

' ===========================================================================
' sprites: kayak (two layers), logs, whirls, pickups, popup

sub BuildSat:
  asm {
    xor a
    ld (SatN),a
    ld a,208
    ld (Sat),a
    ; drawn direction 0-15 (9-15 = 7-1 mirrored)
    ld a,(Hd)
    add a,8
    rrca
    rrca
    rrca
    rrca
    and 15
    ld (BsD),a
    ld c,0
    cp 9
    jr c,WwBs1
    neg
    add a,16
    ld c,1
WwBs1:
    ld (BsK),a
    ld a,c
    ld (KpM),a
    ld a,(BsK)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld (KpB),hl
    ; the paddler layer: splash when hit, else stroke catch / pull
    ; (side swapped when mirrored), else a sweep while turning
    ld a,(HitT)
    or a
    jr z,WwBs2
    rrca
    rrca
    and 1
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,SplOff
    add hl,de
    ld (KpA),hl
    jr WwBs5
WwBs2:
    ld b,0
    ld a,(StrokeT)
    or a
    jr z,WwBs3
    ld b,1
    cp 13
    jr nc,WwBs2a
    ld b,2
    cp 5
    jr nc,WwBs2a
    ld b,0
    jr WwBs4
WwBs2a:
    ld a,(Side)
    xor c
    jr z,WwBs4
    inc b
    inc b
    jr WwBs4
WwBs3:
    ld a,(Jk)
    and 12
    jr z,WwBs4
    ld hl,TurnT
    inc (hl)
    ld a,(hl)
    and 8
    ld b,1
    jr z,WwBs3a
    ld b,2
WwBs3a:
    ld a,(Jk)
    and 8
    jr z,WwBs3b
    ld a,1
WwBs3b:
    xor c
    jr z,WwBs4
    inc b
    inc b
WwBs4:
    ld a,(BsK)
    ld e,a
    add a,a
    add a,a
    add a,e
    add a,b
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,PadOff
    add hl,de
    ld (KpA),hl
WwBs5:
    ; which layers changed -> KMake rebuilds them, the blit sends them
    ld e,0
    ld hl,(KpA)
    ld bc,(KpOA)
    or a
    sbc hl,bc
    jr z,WwBs5a
    set 0,e
WwBs5a:
    ld hl,(KpB)
    ld bc,(KpOB)
    or a
    sbc hl,bc
    jr z,WwBs5b
    set 1,e
WwBs5b:
    ld a,(KpOM)
    ld b,a
    ld a,(KpM)
    cp b
    jr z,WwBs5c
    ld e,3
WwBs5c:
    ld a,e
    ld (KpL),a
    ld hl,(KpA)
    ld (KpOA),hl
    ld hl,(KpB)
    ld (KpOB),hl
    ld a,(KpM)
    ld (KpOM),a
    ld a,(KpL)
    or a
    jr z,WwBs6
    call AMY_UPROC_KMake
    ld a,1
    ld (KpNew),a
WwBs6:
    ; the kayak: paddler (yellow, white splash) over the hull (red, blinking
    ; white at 2 Hz while protected after a hit)
    ld a,(KY+1)
    sub 9
    ld (SpY),a
    ld a,(KX+1)
    sub 8
    ld (SpX),a
    xor a
    ld (SpP),a
    ld a,(HitT)
    or a
    ld a,11
    jr z,WwBs7
    ld a,15
WwBs7:
    ld (SpC),a
    call AMY_UPROC_SprAdd
    ld a,4
    ld (SpP),a
    ld a,(Inv)
    and 16
    ld a,8
    jr z,WwBs8
    ld a,15
WwBs8:
    ld (SpC),a
    call AMY_UPROC_SprAdd
    jp AMY_UPROC_SatObj
  }
end sub

' the objects into the sprite table (asm: plumbing, no game maths): logs,
' whirlpools, bottles and fish, the score popup; each through SprAdd
sub SatObj:
  asm {
    push ix
    ld a,(LgOn)
    or a
    jr z,WwSo1
    ld hl,(LgY)
    ld de,(LgX)
    ld a,(LgT)
    call WwSoLog
WwSo1:
    ld a,(LgOn+1)
    or a
    jr z,WwSo2
    ld hl,(LgY+2)
    ld de,(LgX+2)
    ld a,(LgT+1)
    call WwSoLog
WwSo2:
    ld a,(WNext)
    ld c,a
    ld a,(WhN)
    sub c
    jr z,WwSo5
    jr c,WwSo5
    ld b,a
    ld a,c
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld ix,Wh
    add ix,de
WwSo3:
    push bc
    ld l,(ix+0)
    ld h,(ix+1)
    call WwObjY
    jr nc,WwSo3v
    or a
    jr z,WwSo4
    pop bc
    jr WwSo5
WwSo3v:
    ld (SpY),a
    ld a,(ix+2)
    sub 8
    ld (SpX),a
    ld a,(Tick)
    rrca
    rrca
    and 3
    ld c,a
    ld a,(ix+3)
    or a
    ld a,c
    jr nz,WwSo3a
    neg
    and 3
WwSo3a:
    add a,a
    add a,a
    add a,SWhirl0
    ld (SpP),a
    ld a,15
    ld (SpC),a
    call AMY_UPROC_SprAdd
WwSo4:
    pop bc
    inc ix
    inc ix
    inc ix
    inc ix
    djnz WwSo3
WwSo5:
    ld a,(PNext)
    ld c,a
    ld a,(PkN)
    sub c
    jr z,WwSo9
    jr c,WwSo9
    ld b,a
    ld a,c
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld ix,Pk
    add ix,de
WwSo6:
    push bc
    ld a,c
    ld (SoI),a
    ld e,a
    ld d,0
    ld hl,BitT
    add hl,de
    ld a,(Taken)
    and (hl)
    jr nz,WwSo8
    ld l,(ix+0)
    ld h,(ix+1)
    call WwObjY
    jr nc,WwSo7
    or a
    jr nz,WwSo8x
    jr WwSo8
WwSo7:
    ld (SpY),a
    ld a,(ix+2)
    sub 8
    ld (SpX),a
    ld a,(ix+3)
    or a
    jr nz,WwSoF
    ld a,(Tick)
    and 16
    ld a,SBottleA
    jr z,WwSoB
    ld a,SBottleB
WwSoB:
    ld (SpP),a
    ld a,3
    ld (SpC),a
    jr WwSoA
WwSoF:
    ld a,(SoI)
    ld e,a
    ld d,0
    ld hl,FishPh
    add hl,de
    ld a,(Tick)
    add a,(hl)
    and 63
    ld c,SFishR
    ld b,15
    cp 40
    jr c,WwSoF1
    ld c,SFishU
    ld b,11
    cp 52
    jr c,WwSoF1
    ld c,SFishD
WwSoF1:
    ld a,c
    ld (SpP),a
    ld a,b
    ld (SpC),a
WwSoA:
    call AMY_UPROC_SprAdd
WwSo8:
    pop bc
    ld a,(SoI)
    inc a
    ld c,a
    inc ix
    inc ix
    inc ix
    inc ix
    djnz WwSo6
    jr WwSo9
WwSo8x:
    pop bc
WwSo9:
    ld a,(PopT)
    or a
    jr z,WwSoE
    ld hl,(PopY)
    call WwObjY
    jr c,WwSoE
    ld c,a
    ld a,(PopT)
    ld b,a
    ld a,40
    sub b
    srl a
    ld b,a
    ld a,c
    sub b
    jr c,WwSoE
    cp 16
    jr c,WwSoE
    ld (SpY),a
    ld a,(PopX)
    sub 8
    ld (SpX),a
    ld a,(PopP)
    ld (SpP),a
    ld a,(PopC)
    ld (SpC),a
    call AMY_UPROC_SprAdd
WwSoE:
    pop ix
    ret
; a log: hl = y (1/16 px), de = x (8.8), a = its rotation phase
WwSoLog:
    push de
    push af
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    call WwObjY
    jr c,WwSoL9
    ld (SpY),a
    pop af
    ld c,a
    pop de
    ld a,d
    sub 8
    ld (SpX),a
    ld a,(Tick)
    add a,c
    rrca
    rrca
    rrca
    rrca
    and 3
    add a,a
    add a,a
    add a,SLog0
    ld (SpP),a
    ld a,10
    ld (SpC),a
    jp AMY_UPROC_SprAdd
WwSoL9:
    pop af
    pop de
    ret
; world y hl (an object's centre) -> a = sprite table y, carry clear when
; inside the field; carry set: a = 0 above it, a = 1 below it
WwObjY:
    ld de,(CamY)
    or a
    sbc hl,de
    jr c,WwOyA
    ld a,h
    or a
    jr nz,WwOyB
    ld a,l
    cp 8
    jr c,WwOyA
    cp 169
    jr nc,WwOyB
    add a,7
    or a
    ret
WwOyA:
    xor a
    scf
    ret
WwOyB:
    ld a,1
    scf
    ret
  }
end sub

' the kayak's two patterns into KBuf (32 + 32 bytes), mirrored left-right
' when KpM = 1 (directions 9-15 are directions 7-1 seen in a mirror; both
' layers: 9 hull frames stored, not 16)
sub KMake:
  asm {
    ld a,(KpL)
    and 1
    jr z,WwKmB
    ld hl,(KpA)
    ld de,KayakPat
    add hl,de
    ld de,KBuf
    call WwKm
WwKmB:
    ld a,(KpL)
    and 2
    ret z
    ld hl,(KpB)
    ld de,KayakPat
    add hl,de
    ld de,KBuf + 32
    jr WwKm
WwKm:
    ld a,(KpM)
    or a
    jr nz,WwKm1
    ld bc,32
    ldir
    ret
WwKm1:
    ; left column (bytes 0-15) <- reversed right column (16-31), and back
    push hl
    ld bc,16
    add hl,bc
    call WwKr
    pop hl
WwKr:
    ; (source in bc, the table page in h: a repeated `ld a,(bc)` after
    ; `ld c,(hl)` is dropped by the r11 asm pass, see whitewater-r11-bugs.md)
    ld b,h
    ld c,l
    ld h,WwRev / 256
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ld a,(bc)
    ld l,a
    ld a,(hl)
    ld (de),a
    inc bc
    inc de
    ret
  }
end sub

' add the sprite SpY, SpX, SpP, SpC unless 4 accepted sprites overlap its lines
sub SprAdd:
  asm {
    ld a,(SatN)
    cp 11
    ret nc
    or a
    jr z,WwSa3
    ld b,a
    ld hl,Sat
    ld c,0
    ld a,(SpY)
    ld d,a
WwSa1:
    ld a,(hl)
    sub d
    jr nc,WwSa2
    neg
WwSa2:
    cp 16
    jr nc,WwSa2n
    inc c
WwSa2n:
    inc hl
    inc hl
    inc hl
    inc hl
    djnz WwSa1
    ld a,c
    cp 4
    ret nc
WwSa3:
    ld a,(SatN)
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld hl,Sat
    add hl,de
    ld a,(SpY)
    ld (hl),a
    inc hl
    ld a,(SpX)
    ld (hl),a
    inc hl
    ld a,(SpP)
    ld (hl),a
    inc hl
    ld a,(SpC)
    ld (hl),a
    inc hl
    ld (hl),208
    ld hl,SatN
    inc (hl)
    ret
  }
end sub

' ===========================================================================
' HUD: hull icons, clock + time bar, gate streak, section, score

sub HudUpdate:
  ' the bar: 8 cells of 512 frames, a quarter cell = 128 frames (shifts)
  W = TimeL >> 7
  T = lowbyte W
  if T <> BarN then HudF = 1
  if HudF = 0 then return
  if RowsN >= 3 then return
  HudF = 0
  BarN = T
  U = T
  for K = 5 to 12
    if U >= 4 then
      HudBuf[K] = TBar4
      U -= 4
    else
      HudBuf[K] = TBar0 + U
      U = 0
    end if
  next
  for K = 0 to 2
    HudBuf[K] = THulle
    if Hull > K then HudBuf[K] = THull
  next
  HudBuf[3] = 32
  HudBuf[4] = TClock
  HudBuf[13] = 32
  HudBuf[14] = TGate
  HudBuf[15] = TX
  HudBuf[16] = 48 + Streak
  HudBuf[17] = 32
  HudBuf[18] = TFlag
  T = Sect + 1
  HudBuf[19] = 48 + T
  HudBuf[20] = 32
  if Lap > 0 then HudBuf[20] = 43
  HudBuf[21] = 32
  ' score: 5 digits and a 0
  asm {
    push ix
    ld hl,(Score)
    ld de,HudBuf + 22
    ld ix,Pow10
    ld b,5
WwSd1:
    push bc
    ld c,(ix+0)
    ld b,(ix+1)
    ld a,48
WwSd2:
    or a
    sbc hl,bc
    jr c,WwSd3
    inc a
    jr WwSd2
WwSd3:
    add hl,bc
    ld (de),a
    inc de
    inc ix
    inc ix
    pop bc
    djnz WwSd1
    pop ix
  }
  HudBuf[27] = 48
  HudW = 1
  return
end sub

' ===========================================================================
' map probe (asm): Qx screen x, Qy world y -> Qk kind, Qs solid ($80) / 0

sub KindAt:
  asm {
WwKA:
    ld a,(Qx)
    rrca
    rrca
    rrca
    and $1F
    sub 2
    jr c,WwKoff
    cp 28
    jr nc,WwKoff
    ld c,a
    ld hl,(Qy)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld de,288
    or a
    sbc hl,de
    jr nc,WwKwat
    add hl,de
    add hl,hl
    ld de,RowAd
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld b,0
    add hl,bc
    call WwRa
    ld hl,TopK - Code0
    ex (sp),hl
    ex (sp),hl
    in a,(VDP_DATA_PORT)
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
WwKk:
    ld (Qk),a
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(Qy)
    and 7
    ld e,a
    ld d,0
    add hl,de
    ld de,SolidT
    add hl,de
    ld b,(hl)
    ld a,(Qx)
    and 7
    ld e,a
    ld d,0
    ld hl,BitR
    add hl,de
    ld a,b
    and (hl)
    ld (Qs),a
    ret
WwKoff:
    ld a,KB
    jr WwKk
WwKwat:
    xor a
    jr WwKk
  }
end sub

' ===========================================================================
' the blit (asm), right after the vertical blank:
'  fast (in the blank): sprite table; kayak patterns; page flip when the
'  camera crossed a cell row; static combos for the new shift; water combos
'  for the new flow phase.  slow (29+ cycles a write): HUD row on both pages;
'  RowsPF rows of the hidden page from the map store.

sub Blit:
  asm {
    push ix
    push iy
    call WwBlitM
    pop iy
    pop ix
    ret
WwBlitM:
    xor a
    ld (SlowN),a
    ld hl,2400
    ld (Est),hl
    ld hl,$1B00
    call WwWa
    ld a,(SatN)
    add a,a
    add a,a
    inc a
    ld b,a
    ld c,VDP_DATA_PORT
    ld hl,Sat
    otir
    ld a,(KpNew)
    or a
    jr z,WwB2
    xor a
    ld (KpNew),a
    ld hl,$3800
    call WwWa
    ld hl,KBuf
    ld e,8
    call WwOutG
    ld hl,(Est)
    ld de,1500
    add hl,de
    ld (Est),hl
WwB2:
    ld a,(FullR)
    or a
    jp nz,WwFull
    ld hl,(CamR)
    ld de,(DrR)
    or a
    sbc hl,de
    jr z,WwB3
    ld a,23
    ld (SlowN),a
    ld b,23
    call WwBuildN
    call WwFlip
WwB3:
    ld a,(CamS)
    ld hl,LastCS
    cp (hl)
    jr z,WwB4
    ld (hl),a
    add a,a
    ld e,a
    ld d,0
    ld hl,ShOff
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    push de
    ld hl,StatVram
    call WwWa
    pop de
    push de
    ld hl,ComboPat + FlowBytes
    add hl,de
    ld e,NStat
    call WwOutG
    ld hl,StatVram + $2000
    call WwWa
    pop de
    ld hl,ComboCol + FlowBytes
    add hl,de
    ld e,NStatC
    call WwOutG
    ld hl,(Est)
    ld de,7900
    add hl,de
    ld (Est),hl
WwB4:
    ld a,(FlowPh)
    ld hl,LastFS
    cp (hl)
    jr z,WwB5
    ld (hl),a
    add a,a
    ld e,a
    ld d,0
    ld hl,ShOff
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    push de
    ld hl,FlowVram
    call WwWa
    pop de
    push de
    ld hl,ComboPat
    add hl,de
    ld e,NFlow
    call WwOutG
    ld hl,FlowVram + $2000
    call WwWa
    pop de
    ld hl,ComboCol
    add hl,de
    ld e,NFlowC
    call WwOutG
    ld hl,(Est)
    ld de,2300
    add hl,de
    ld (Est),hl
WwB5:
    ; hidden-page rows at full speed while the blank lasts (estimated:
    ; a row about 1650 cycles, the blank ends at 15960, estimate kept under 13700)
    xor a
    ld (FastN),a
WwB5f:
    ld a,(RowsN)
    or a
    jr z,WwB5g
    ld a,(BldRow)
    cp 23
    jr nc,WwB5g
    ld hl,(Est)
    ld de,1650
    add hl,de
    ld (Est),hl
    ld de,13700
    or a
    sbc hl,de
    jr nc,WwB5g
    call WwBuildF
    ld hl,RowsN
    dec (hl)
    ld hl,FastN
    inc (hl)
    jr WwB5f
WwB5g:
    call PLAY_SOUNDS
    call UPDATE_SOUND_ADDR
    ld a,(HudW)
    or a
    jr z,WwB6
    ld a,(RowsN)
    cp 3
    jr nc,WwB6
    xor a
    ld (HudW),a
    ld a,(PgFH)
    call WwHudRow
    ld a,(PgFH)
    xor $04
    call WwHudRow
WwB6:
    ld a,(RowsN)
    ld hl,SlowN
    add a,(hl)
    ld (hl),a
    ld a,(RowsN)
    or a
    ret z
    ld b,a
    jp WwBuildN
; e groups of 8 bytes from hl, fast (vertical blank or display off)
WwOutG:
    ld c,VDP_DATA_PORT
WwOg1:
    outi
    outi
    outi
    outi
    outi
    outi
    outi
    outi
    dec e
    jp nz,WwOg1
    ret
; show the hidden page (built for CamR): R2, then start building the next
WwFlip:
    ld a,(PgFH)
    xor $04
    ld (PgFH),a
    rrca
    rrca
    and $3F
    out (VDP_CTRL_PORT),a
    ld a,$82
    out (VDP_CTRL_PORT),a
    ld hl,(CamR)
    ld (DrR),hl
    inc hl
    ld (BldBase),hl
    ld a,2
    ld (BldRow),a
    ret
; up to b rows of the hidden page: row BldRow (2-22) = map name row
; BldBase + BldRow - 2, read from the store into RowBuf, written to the page.
; BldSrc / BldDst run along (set by WwBldSet when BldRow is 2)
WwBuildN:
    ld a,(BldRow)
    cp 23
    ret nc
    cp 2
    jr nz,WwBu1
    push bc
    call WwBldSet
    pop bc
WwBu1:
    push bc
    ld hl,(BldSrc)
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    and $3F
    out (VDP_CTRL_PORT),a
    ld de,28
    add hl,de
    ; the store's second bank starts at name row 144 ($0800 + 144 * 28 = $17C0)
    ld a,h
    cp $17
    jr nz,WwBu1a
    ld a,l
    cp $C0
    jr nz,WwBu1a
    ld hl,$2800
WwBu1a:
    ld (BldSrc),hl
    ld hl,RowBuf
    ld bc,$1C00 + VDP_DATA_PORT
WwBu2:
    ini
    nop
    jp nz,WwBu2
    ld hl,(BldDst)
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld de,32
    add hl,de
    ld (BldDst),hl
    ld hl,RowBuf
    ld bc,$1C00 + VDP_DATA_PORT
WwBu3:
    outi
    nop
    jp nz,WwBu3
    ld hl,BldRow
    inc (hl)
    pop bc
    ld a,(hl)
    cp 23
    ret nc
    djnz WwBu1
    ret
; one row at full speed (vertical blank only)
WwBuildF:
    ld a,(BldRow)
    cp 2
    call z,WwBldSet
    ld hl,(BldSrc)
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    and $3F
    out (VDP_CTRL_PORT),a
    ld de,28
    add hl,de
    ld a,h
    cp $17
    jr nz,WwBf1
    ld a,l
    cp $C0
    jr nz,WwBf1
    ld hl,$2800
WwBf1:
    ld (BldSrc),hl
    ld hl,RowBuf
    ld bc,$1C00 + VDP_DATA_PORT
    inir
    ld hl,(BldDst)
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld de,32
    add hl,de
    ld (BldDst),hl
    ld hl,RowBuf
    ld bc,$1C00 + VDP_DATA_PORT
    otir
    ld hl,BldRow
    inc (hl)
    ret
WwBldSet:
    ld hl,(BldBase)
    call WwRowAddr
    ld (BldSrc),hl
    ld a,(PgFH)
    xor $04
    ld h,a
    ld l,66
    ld (BldDst),hl
    ret
; name row hl (0-287) -> its store address in VRAM
WwRowAddr:
    ld de,BankRows
    or a
    sbc hl,de
    jr nc,WwRaB
    add hl,de
    ld de,$0800
    jr WwRa2
WwRaB:
    ld de,$2800
WwRa2:
    push de
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,hl
    or a
    sbc hl,de
    pop de
    add hl,de
    ret
WwHudRow:
    ld h,a
    ld l,34
    call WwWa
    ld hl,HudBuf
WwOut28:
    ld bc,$1C00 + VDP_DATA_PORT
WwO28:
    outi
    nop
    jp nz,WwO28
    ret
WwWa:
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ret
WwRa:
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    and $3F
    out (VDP_CTRL_PORT),a
    ret
; a new river screen (display off): invariant combos, both pages, combos
WwFull:
    xor a
    ld (FullR),a
    ld hl,InvCode * 8
    call WwWa
    ld hl,InvPat
    ld e,NInv
    call WwOutG
    ld hl,InvCode * 8 + $2000
    call WwWa
    ld hl,InvCol
    ld e,NInv
    call WwOutG
    ; colours of every shifted combo once (the colour-invariant ones are
    ; never rewritten after this)
    ld hl,FlowVram + $2000
    call WwWa
    ld hl,ComboCol
    ld e,NSh
    call WwOutG
    ld hl,$1800
    call WwFillPage
    ld hl,$1C00
    call WwFillPage
    ld a,$18
    call WwHudRow
    ld a,$1C
    call WwHudRow
    ld hl,(CamR)
    ld (BldBase),hl
    ld a,2
    ld (BldRow),a
    ld a,23
    ld (SlowN),a
    ld b,23
    call WwBuildN
    call WwFlip
    ld b,23
    call WwBuildN
    ld a,255
    ld (LastCS),a
    ld (LastFS),a
    jp WwB3
; a page: rows 0-1 blank, rows 2-22 grass (the map is copied over it), row 23 blank
WwFillPage:
    call WwWa
    ld b,64
WwFp0:
    ld a,32
    out (VDP_DATA_PORT),a
    nop
    djnz WwFp0
    ld de,672
WwFp1:
    ld a,BBCode
    out (VDP_DATA_PORT),a
    dec de
    ld a,d
    or e
    jr nz,WwFp1
    ld b,32
WwFp2:
    ld a,32
    out (VDP_DATA_PORT),a
    nop
    djnz WwFp2
    ret
  }
end sub

' the sprite table alone (menus)
sub SatOut:
  asm {
    ld hl,$1B00
    call WwWa
    ld hl,Sat
    ld bc,$2D00 + VDP_DATA_PORT
    otir
    ret
  }
end sub

' name table back at $1800 (Amy's print and cls write there)
sub Page0:
  asm {
    ld a,$06
    out (VDP_CTRL_PORT),a
    ld a,$82
    out (VDP_CTRL_PORT),a
    ld a,$18
    ld (PgFH),a
    ret
  }
end sub

' one pattern table and one colour table for the three thirds
sub ShareTables:
  asm {
    ld a,$9F
    out (VDP_CTRL_PORT),a
    ld a,$83
    out (VDP_CTRL_PORT),a
    ld a,$00
    out (VDP_CTRL_PORT),a
    ld a,$84
    out (VDP_CTRL_PORT),a
    ret
  }
end sub

' ===========================================================================
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      TuneOff
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub SndQue:
  T = SndPri[SndN]
  if SndQ > 0 then
    if T < SndQP then return
  end if
  SndQ = SndN
  SndQP = T
  SndAge = 0
  return
end sub

sub SndSvc:
  if SndQ = 0 then return
  inc SndAge
  if SlowN > 2 then
    if SndAge < 4 then return
  end if
  asm {
    ld a,1
    ld (AMY_SOUND_ENABLED),a
    ld a,(SndQ)
    ld b,a
    call AMY_PLAY_SOUND
  }
  SndQ = 0
  return
end sub

' priority of each sound id for the queue (hit > gate > miss > pick > bump > whirl > tick > stroke)
data SndPri bytes
  0,0,0,0,0,1,8,4,7,6,0,0,0,5,3,2
end data

sub Frame1:
  ' in play the NMI skips the sound update (it would eat the vertical blank
  ' before the blit): the blit runs it after the fast writes
  if InPlay = 1 then
    asm {
      xor a
      ld (AMY_SOUND_ENABLED),a
    }
  end if
  Rearm
  wait
  nmi off
  inc Tick
  if InPlay = 1 then Blit
  return
end sub

sub ReadPad:
  T = 0
  if joypad(1).up then T = T | 1
  if joypad(1).down then T = T | 2
  if joypad(1).left then T = T | 4
  if joypad(1).right then T = T | 8
  if joypad(1).fire then T = T | 16
  if joypad(2).up then T = T | 1
  if joypad(2).down then T = T | 2
  if joypad(2).left then T = T | 4
  if joypad(2).right then T = T | 8
  if joypad(2).fire then T = T | 16
  Jk = T & 15
  U = WasJ ^ 15
  Edge = Jk & U
  WasJ = Jk
  Btn = T & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSpr:
  Sat[0] = 208
  SatOut
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  Page0
  HideSpr
  fill mode 2 text color with $F1
  copy IconPat count IconBytes to vram.pattern + IcVram
  copy IconCol count IconBytes to vram.color + IcVram
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TuneOff:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  TzOn = 0
  return
end sub

sub TitlePage:
  InPlay = 0
  NewScreen
  State = 12
  if TzOn = 1 then TuneOff
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzOn = 1
  TzLeft = TuneFrames
  ' the logo: WHITE / WATER in block letters (rows 2-6 and 8-12)
  DrawLogo
  ' a strip of river with the kayak on it
  fill TWave count 28 at 2,14
  fill TWave count 28 at 2,15
  print at 12,17, "START"
  print at 12,19, "HOW TO PLAY"
  print at 12,21, "CREDITS"
  Menu = 0
  ShowMenu
  KpOA = 65535
  TtStart
  ShowScreen
  State = StTitle
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  TtScene
  TtFish
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    ShowMenu
    if TzOn = 0 then play sound SndClick
  end if
  if Press = 0 then goto tp_loop
  if TzOn = 1 then TuneOff
  HideSpr
  return
end sub

' the title scene: the kayak (paddler + hull: two colour layers) paddles
' right along the river strip, entering at the left edge (early-clock bit
' for x < 0); it surges on the pull of each stroke. Spray flies off the
' blade at each catch (one side a stroke, 1.9 Hz). Every 4 s a fish jumps
' out of the strip on a Sin64 arc (nose up, then down) and lands with a
' ring of drops (the game's hit-splash frames, copied to the sprite
' patterns after SprPat: SRing). Sprites: 0 fish / ring, 1 spray, 2 paddler, 3 hull: 4 at most.
sub TtStart:
  copy KayakPat + SplOff count 64 to vram.spr_pat + 64 + SprBytes
  TtX = 0
  TtW = 120
  TtF = 0
  TtScene
  TtFish
  return
end sub

sub TtScene:
  ' the stroke frame (1-4, 8 frames each); new patterns only when it changes
  T = Tick >> 3
  U = T & 3
  U += 1
  T = Tick & 7
  if T = 0 then
    W = U + 20
    W = W << 5
    KpA = PadOff + W
    KpB = 128
    KpM = 0
    KpL = 3
    KMake
    asm {
      ld hl,$3800
      call WwWa
      ld hl,KBuf
      ld bc,$4000 + VDP_DATA_PORT
WwTk1:
      outi
      nop
      jp nz,WwTk1
    }
  end if
  ' the surge (1/128 px a frame: glide 56, catch 112, pull 96, release 56),
  ' x + 32 = TtX >> 7 -> sprite x (b) and the early-clock bit (c); slots
  ' 2-3: paddler (yellow) over the hull (red); slot 1: spray at the catch,
  ' on the blade's side (top / bottom by stroke), not while entering
  asm {
    ld a,(amy(U))
    ld hl,56
    cp 2
    jr nz,WwTt1
    ld l,112
WwTt1:
    cp 3
    jr nz,WwTt2
    ld l,96
WwTt2:
    ld de,(amy(TtX))
    add hl,de
    ld de,$10000 - 36864
    push hl
    add hl,de
    pop hl
    jr nc,WwTt3
    ld hl,0
WwTt3:
    ld (amy(TtX)),hl
    add hl,hl
    ld a,h
    ld c,0
    jr c,WwTt4
    cp 32
    jr nc,WwTt4
    ld c,128
    add a,32
WwTt4:
    sub 32
    ld b,a
    ld hl,amy(Sat) + 8
    ld e,0
    ld d,11
    call WwTt9
    ld e,4
    ld d,8
    call WwTt9
    ld hl,amy(Sat) + 4
    ld (hl),207
    ld a,(amy(Tick))
    ld e,a
    and 31
    cp 12
    ret nc
    ld a,c
    or a
    ret nz
    ld a,b
    cp 240
    ret nc
    ld a,99
    ld d,4
    bit 5,e
    jr z,WwTt5
    ld a,115
    ld d,-2
WwTt5:
    ld (hl),a
    inc hl
    ld a,b
    add a,d
    ld (hl),a
    inc hl
    ld (hl),SSpray
    inc hl
    ld (hl),15
    ret
; one kayak layer at hl: y 111, x b, pattern e, colour d | c
WwTt9:
    ld (hl),111
    inc hl
    ld (hl),b
    inc hl
    ld (hl),e
    inc hl
    ld a,d
    or c
    ld (hl),a
    inc hl
    ret
  }
end sub

' the fish: 64 frames up and down (slot 0), then the ring (16 frames)
sub TtFish:
  Sat[0] = 207
  if TtF = 0 then
    dec TtW
    if TtW = 0 then
      TtF = 1
      inc TtJ
      TtJ = TtJ & 3
    end if
  else
    T = TtJx[TtJ]
    Ri = TtF >> 1
    Ri += T
    if TtF <= 64 then
      D = TtF >> 1
      Sin64
      T = Sn >> 3
      U = Sn >> 4
      T += U
      Sat[0] = 108 - T
      Sat[1] = Ri
      Sat[2] = SJumpU
      if TtF > 32 then Sat[2] = SJumpD
      Sat[3] = 14
    else
      Sat[0] = 111
      Sat[1] = Ri
      Sat[2] = SRing
      if TtF > 72 then Sat[2] = SRing + 4
      Sat[3] = 15
    end if
    inc TtF
    if TtF > 80 then
      TtF = 0
      TtW = 160
    end if
  end if
  Sat[16] = 208
  SatOut
  return
end sub

data TtJx bytes
  48, 152, 96, 176
end data

sub DrawLogo:
  W = 2
  for Li = 0 to 1
    K = Logo[Li]
    T = 28 - K
    T = T >> 1
    T += 2
    U = Li * 6
    U += 2
    for Gi = 0 to 4
      for Hi = 1 to K
        if Logo[W] = 1 then
          Ci = T + Hi
          Ci -= 1
          Ri = U + Gi
          put char TWblk at Ci,Ri
        end if
        inc W
      next
    next
  next
  return
end sub

sub ShowMenu:
  put char 32 at 10,17
  put char 32 at 10,19
  put char 32 at 10,21
  T = Menu << 1
  T += 17
  put char 62 at 10,T
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  State = StCredits
  DrawLogo
  print at 5,15, "A GAME BY AMY & CLAUDE"
  print at 8,17, "AMY STUDIO 2026"
  print at 4,19, "AN ORIGINAL GAME, MADE"
  print at 4,20, "IN AMY FOR COLECOVISION"
  print at 8,22, "PRESS THE BUTTON"
  PageWait
  return
end sub

sub HowTo:
  NewScreen
  State = StHow
  print at 8,1, "HOW TO PLAY  1/2"
  print at 3,3, "PADDLE DOWN THE RIVER"
  print at 3,4, "TO THE FINISH LINE."
  print at 3,6, "LEFT/RIGHT: TURN"
  print at 3,7, "BUTTON: PADDLE FORWARD"
  print at 3,8, "(HOLD IT FOR A RHYTHM)"
  put char TGate at 3,10
  put char 32 at 4,10
  put char TGater at 7,10
  print at 9,10, "PASS GATES BETWEEN"
  print at 3,11, "GREEN (LEFT) AND RED"
  print at 3,12, "(RIGHT): POINTS + TIME."
  print at 3,13, "A STREAK SCORES X2, X3."
  print at 3,14, "MISSED GATE: -2 SECONDS."
  put char TClock at 3,16
  put char TBar4 at 4,16
  put char TBar2 at 5,16
  put char TBar0 at 6,16
  print at 8,16, "TIME: AT 0 IT ENDS."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    put char TRock at 3,3
    put char TLog at 4,3
    print at 6,3, "ROCKS AND LOGS CRACK"
    print at 3,4, "THE HULL."
    put char THull at 3,5
    put char THull at 4,5
    put char THulle at 5,5
    print at 7,5, "3 HULL: 0 = CAPSIZED."
    put char TWhirl at 3,7
    print at 5,7, "WHIRLPOOLS SPIN YOU:"
    print at 3,8, "PADDLE OUT OF THEM."
    put char TEddy at 3,10
    print at 5,10, "BEHIND ROCKS THE WATER"
    print at 3,11, "PULLS BACK UPSTREAM."
    print at 3,12, "WHITE WATER IS FAST."
    put char TBottle at 3,14
    put char TFish at 4,14
    print at 6,14, "BOTTLES, FISH: BONUS."
    put char TFlag at 3,16
    print at 5,16, "6 SECTIONS, NARROWER"
    print at 3,17, "AND FASTER. A CLEARED"
    print at 3,18, "SECTION GIVES 1 HULL BACK."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSpr
  return
end sub

