const TDk5 = 215
const TDk6 = 216
const TDk7 = 217
const TDk8 = 218
const TDk9 = 219
const TDg0 = 220
const TDg1 = 221
const TDg2 = 222
const TDg3 = 223
const TDg4 = 224
const TDg5 = 225
const TDg6 = 226
const TDg7 = 227
const TDg8 = 228
const TDg9 = 229
