const SndClick = 4
const SndChip = 5
const SndWin = 6
const SndBigWin = 7
const SndLose = 8
const SndTuneA = 9
const SndTuneB = 10

' the wheel's pockets clockwise from the right (37 = double zero)
data Pockets bytes
  $00,$1C,$09,$1A,$1E,$0B,$07,$14,$20,$11,$05,$16,$22,$0F,$03,$18
  $24,$0D,$01,$25,$1B,$0A,$19,$1D,$0C,$08,$13,$1F,$12,$06,$15,$21
  $10,$04,$17,$23,$0E,$02
