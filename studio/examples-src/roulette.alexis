  $80,$83,$86,$89,$8C,$90,$93,$96,$99,$9C,$9F,$A2,$A5,$A8,$AB,$AE
  $B1,$B3,$B6,$B9,$BC,$BF,$C1,$C4,$C7,$C9,$CC,$CE,$D1,$D3,$D5,$D8
  $DA,$DC,$DE,$E0,$E2,$E4,$E6,$E8,$EA,$EB,$ED,$EF,$F0,$F1,$F3,$F4
  $F5,$F6,$F8,$F9,$FA,$FA,$FB,$FC,$FD,$FD,$FE,$FE,$FE,$FF,$FF,$FF
  $FF,$FF,$FF,$FF,$FE,$FE,$FE,$FD,$FD,$FC,$FB,$FA,$FA,$F9,$F8,$F6
  $F5,$F4,$F3,$F1,$F0,$EF,$ED,$EB,$EA,$E8,$E6,$E4,$E2,$E0,$DE,$DC
  $DA,$D8,$D5,$D3,$D1,$CE,$CC,$C9,$C7,$C4,$C1,$BF,$BC,$B9,$B6,$B3
  $B1,$AE,$AB,$A8,$A5,$A2,$9F,$9C,$99,$96,$93,$90,$8C,$89,$86,$83
  $80,$7D,$7A,$77,$74,$70,$6D,$6A,$67,$64,$61,$5E,$5B,$58,$55,$52
  $4F,$4D,$4A,$47,$44,$41,$3F,$3C,$39,$37,$34,$32,$2F,$2D,$2B,$28
  $26,$24,$22,$20,$1E,$1C,$1A,$18,$16,$15,$13,$11,$10,$0F,$0D,$0C
  $0B,$0A,$08,$07,$06,$06,$05,$04,$03,$03,$02,$02,$02,$01,$01,$01
  $01,$01,$01,$01,$02,$02,$02,$03,$03,$04,$05,$06,$06,$07,$08,$0A
  $0B,$0C,$0D,$0F,$10,$11,$13,$15,$16,$18,$1A,$1C,$1E,$20,$22,$24
  $26,$28,$2B,$2D,$2F,$32,$34,$37,$39,$3C,$3F,$41,$44,$47,$4A,$4D
  $4F,$52,$55,$58,$5B,$5E,$61,$64,$67,$6A,$6D,$70,$74,$77,$7A,$7D
end data
data SpinA words
  0,24,48,72,95,119,142,165,187,210,232,255,277,298,320,341
  363,384,405,425,446,466,486,506,526,545,565,584,603,621,640,658
  677,695,712,730,747,765,782,799,815,832,848,864,880,896,911,927
  942,957,971,986,1000,1015,1029,1042,1056,1069,1083,1096,1109,1121,1134,1146
  1158,1170,1182,1193,1204,1216,1227,1237,1248,1258,1268,1278,1288,1298,1307,1317
  1326,1334,1343,1352,1360,1368,1376,1384,1391,1398,1406,1413,1419,1426,1432,1438
  1444,1450,1456,1461,1467,1472,1476,1481,1486,1490,1494,1498,1502,1505,1508,1512
  1515,1517,1520,1522,1524,1526,1528,1530,1531,1533,1534,1534,1535,1536,1536,1536
