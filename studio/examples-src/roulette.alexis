asm {
; RlLow: Uw = the low 16 bits of Chips (only used when Chips < 65536;
; Amy refuses to narrow a u32 into a u16)
RlLow:
    ld hl,(AMY_UVAR_Chips)
    ld (AMY_UVAR_Uw),hl
    ret

; RlThirds: VDP register 3 = $FF, a colour table for each third
RlThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER
RlRoll:
    db $00,$00,$85,$5A,$00,$00,$95,$5A,$00,$00,$B5,$50,$10
RlClack:
    db $00,$00,$24,$01,$00,$00,$55,$02,$10
RlDrop:
    db $00,$00,$14,$02,$00,$00,$45,$03,$00,$00,$76,$04,$10
RlClick:
    db $40,$40,$70,$01,$50
RlChip:
    db $40,$30,$40,$01,$40,$28,$60,$02,$50
RlWin:
    db $40,$8F,$20,$04,$40,$8F,$F0,$01,$40,$71,$20,$04,$40,$71,$F0,$01,$40,$5F,$20,$04,$40,$5F,$F0,$01
    db $40,$47,$20,$0D,$40,$47,$F0,$01,$50
RlBigWin:
    db $40,$6B,$10,$03,$40,$6B,$F0,$01,$40,$55,$10,$03,$40,$55,$F0,$01,$40,$47,$10,$03,$40,$47,$F0,$01
    db $40,$35,$10,$03,$40,$35,$F0,$01,$40,$47,$10,$03,$40,$47,$F0,$01,$40,$35,$10,$03,$40,$35,$F0,$01
    db $40,$2A,$10,$13,$40,$2A,$F0,$01,$50
RlLose:
    db $40,$1D,$41,$07,$40,$1D,$F1,$01,$40,$41,$41,$07,$40,$41,$F1,$01,$40,$53,$41,$13,$40,$53,$F1,$01
    db $50

RlSoundTable:
    dw RlRoll,$702B
    dw RlClack,$702B
    dw RlDrop,$702B
    dw RlClick,$7035
    dw RlChip,$7035
    dw RlWin,$7035
    dw RlBigWin,$7035
    dw RlLose,$7035
    dw RlTuneMel,$703F
    dw RlTuneBass,$7049
; Valse du Croupier, A minor (original for this game)
; Tiny Sound, 7 frames per step
RlTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$F1,$22,$23,$00,$28,$00,$2B,$00,$2A,$00,$28,$00,$23,$00
    db $24,$00,$00,$00,$2D,$00,$2B,$00,$2A,$00,$28,$00,$27,$00,$2A,$00
    db $2F,$00,$2D,$00,$2B,$00,$2A,$00,$28,$00,$00,$00,$23,$00,$28,$00
    db $00,$00,$00,$00
    db $FF
RlTuneBass:
