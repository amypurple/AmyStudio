    dw sndtiny_2
    db 7
    db $02,$70,$F1,$22,$10,$00,$13,$00,$17,$00,$10,$00,$13,$00,$17,$00
    db $09,$00,$0C,$00,$10,$00,$09,$00,$0C,$00,$10,$00,$0B,$00,$0F,$00
    db $12,$00,$0B,$00,$0F,$00,$12,$00,$10,$00,$13,$00,$17,$00,$10,$00
    db $00,$00,$00,$00
