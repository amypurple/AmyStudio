asm {
ScClick:
    db $40,$40,$30,$01,$50
ScHit:
    db $40,$38,$10,$01,$40,$38,$30,$02,$40,$38,$50,$03,$40,$38,$80,$03,$50
ScBell:
    db $40,$D1,$10,$04,$40,$D1,$30,$04,$40,$D1,$50,$04,$40,$D1,$70,$03,$40,$D1,$F0,$02,$40,$D1,$10,$04
    db $40,$D1,$30,$04,$40,$D1,$50,$04,$40,$D1,$70,$03,$40,$D1,$F0,$02,$40,$D1,$10,$04,$40,$D1,$30,$04
    db $40,$D1,$50,$04,$40,$D1,$70,$03,$50
ScOut:
    db $40,$D1,$60,$02,$40,$D1,$80,$02,$40,$D1,$A0,$02,$40,$D1,$C0,$02,$50
ScGone:
    db $40,$1F,$20,$03,$40,$1F,$40,$06,$40,$1F,$70,$05,$50
ScPush:
    db $00,$00,$56,$02,$00,$00,$86,$03,$10
ScWin:
    db $40,$1D,$21,$06,$40,$1D,$51,$02,$40,$D6,$20,$06,$40,$D6,$50,$02,$40,$AA,$20,$06,$40,$AA,$50,$02
    db $40,$8F,$20,$06,$40,$8F,$50,$02,$40,$AA,$20,$06,$40,$AA,$50,$02,$40,$8F,$20,$10,$40,$8F,$50,$02
    db $50
ScWin2:
    db $80,$7C,$21,$06,$80,$7C,$51,$02,$80,$1D,$21,$06,$80,$1D,$51,$02,$80,$E2,$20,$06,$80,$E2,$50,$02
    db $80,$BF,$20,$06,$80,$BF,$50,$02,$80,$E2,$20,$06,$80,$E2,$50,$02,$80,$BF,$20,$10,$80,$BF,$50,$02
    db $90
ScLose:
    db $40,$1D,$21,$0A,$40,$53,$31,$0A,$40,$AB,$31,$0A,$40,$3B,$42,$18,$50

ScSoundTable:
    dw ScTuneMel,$702B
    dw ScTuneHarm,$7035
    dw ScTuneBassVol,$703F
    dw ScTuneBassPitch,$7049
    dw ScClick,$705D
    dw ScHit,$705D
    dw ScBell,$705D
    dw ScOut,$705D
    dw ScGone,$705D
    dw ScPush,$7053
    dw ScWin,$705D
    dw ScWin2,$7067
    dw ScLose,$705D
; Deck Shuffle (original) - Tiny Sound tone 1/2 + OS7 noise bass/drums (kit/music/tinybass.py)
ScTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$40,$1A,$21,$1A,$01,$1F,$01,$23,$01,$26,$01,$01,$01,$23,$01
    db $26,$01,$01,$01,$28,$01,$26,$01,$23,$01,$1F,$01,$21,$01,$01,$01
    db $23,$01,$01,$01,$1A,$01,$1F,$01,$23,$01,$26,$01,$01,$01,$28,$01
