    db $C0,$5A,$F0,$48,$C0,$72,$F0,$24,$C0,$66,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$98,$F0,$24,$C0,$88,$F0,$48,$C0,$98,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$88,$F0,$24,$C0,$66,$F0,$24,$C0,$72,$F0,$24,$C0,$66,$F0,$24
    db $C0,$5A,$F0,$48,$D8
SfxClick:
    db $00,$00,$15,$01,$02,$36,$02,$23,$11,$10
SfxTock:
    db $82,$55,$20,$02,$23,$11,$90
SfxLift:
    db $41,$2C,$31,$06,$11,$E2,$50
SfxMove:
    db $80,$39,$40,$02,$90
SfxRefuse:
    db $42,$57,$23,$05,$24,$11,$50
SfxAgain:
    db $42,$AA,$00,$08,$14,$22,$42,$8F,$00,$08,$14,$22,$42,$71,$00,$08
    db $14,$22,$42,$55,$00,$10,$14,$32,$50
SfxStart:
    db $42,$AA,$00,$0A,$14,$22,$42,$8F,$00,$0A,$14,$22,$42,$71,$00,$0A
    db $14,$22,$42,$55,$00,$1E,$14,$32,$50
SfxWin:
    db $42,$AA,$00,$0C,$14,$22,$42,$8F,$00,$0C,$14,$22,$42,$71,$00,$0C
    db $14,$22,$42,$55,$00,$0C,$14,$22,$66,$42,$71,$00,$0C,$14,$22,$42
    db $55,$00,$30,$14,$32,$50
SfxLose:
    db $42,$71,$00,$18,$14,$32,$42,$8F,$00,$18,$14,$32,$42,$AA,$00,$18
    db $14,$32,$42,$E2,$00,$18,$14,$32,$42,$53,$01,$40,$14,$32,$50
SfxDraw:
    db $42,$AA,$00,$12,$14,$32,$42,$E2,$00,$12,$14,$32,$42,$AA,$00,$12
    db $14,$32,$42,$71,$00,$30,$14,$32,$50
SfxSlide:
    db $02,$36,$03,$14,$21,$10
SfxSolved:
    db $42,$7F,$00,$0A,$14,$22,$42,$6B,$00,$0A,$14,$22,$42,$55,$00,$0A
    db $14,$22,$42,$40,$00,$0A,$14,$22,$65,$42,$55,$00,$0A,$14,$22,$42
    db $40,$00,$28,$14,$32,$50
SfxFlip:
    db $00,$00,$25,$01,$02,$44,$02,$23,$11,$10
  }
end sub

' ShellForce (called only when Keep[15] = 77, which never happens): uses what the games use from Amy's runtime
' (number printing, 8 and 16-bit division, the sprite flicker switch), so
' the runtime part of the fixed bank is the same in every compile
sub ShellForce:
  print Wt at 2,2 width 3
  print Wf at 2,2 width 5
  Wt = Tx / 6
  Wt = Tx % 6
  Wf = Wf / Rs
  sprites flicker off
  return
end sub

' the end of the fixed bank (its ret is at $BFFF): the games start at $C000
sub ShellEnd:
  return
  asm {
    ds $BFFF-$,$FF
  }
end sub

' ---- the gate: the first bytes of the bank ($C000), the shell calls it
sub GameGate:
  asm {
    jp AMY_UPROC_ParitesMain
  }
end sub

' ---------------------------------------------------------------------------
' games/parites.alexis - PARITES & MEMORY (module of THE THINKER'S CABINET):
' the pairs game of two Oric books, merged. "Parites" by Jean-Francois Sehan
' ("L'Oric a l'affiche", Editions du P.S.I., 1984): 36 cards, 18 pairs of
' figures in 6 x 6. "Memory Cards" by Czes Kosniowski ("Games to Play on
' Your Oric-1", Shiva, 1983): a flashing cursor moved with the arrows, RED
' and BLUE players. ColecoVision version: Amy & Claude 2026.
' Entry: ParitesMain (its card: START / LEVEL < 1-5 > / HOW TO PLAY / BACK).
'
' THE GAME (both books): turn two cards; the same figure = a point, the two
' cards leave the table and the same player goes again; else they turn back
' and the other player plays. When all 18 pairs are found, the most pairs win.
' Sehan's 36 cards and 18 figures (his DATA, coloured), Kosniowski's cursor.
'
' LIBERTIES (listed for Amy):
' - One player against the computer (both books are for 2 to 5 people): YOU
'   (cyan) against CPU (red). The first player is drawn, then the loser of
'   the last game starts.
' - The computer remembers the last cards it saw, as many as its level:
'   LV 1 4 cards, LV 2 5, LV 3 6, LV 4 8, LV 5 12 (model/memory.py: a player
'   who remembers 6 wins about 89 / 66 / 44 / 13 / 2 % of the games). It plays
'   a pair it knows, else an unknown card, then its match if it knows it.
' - Kosniowski's odd card '@' (45 cards) is not kept: Sehan's 36 are even.
' - Cards flip (back, edge, face); a pair flies to the finder's corner.
' ---------------------------------------------------------------------------

const PaX0 = 4           ' card (c, r) at col 4 + 4c, row 3 + 3r
const PaY0 = 3
' Scr[0..35] the deal (figure 0-17), Scr[36..71] the state (0 back, 1 up,
' 2 gone), Scr[72..83] the CPU's memory (positions, oldest first)
const PaDeal = 0
const PaState = 36
const PaMem = 72

u8 PCur = 0              ' the cursor (0-35)
u8 PA1 = 0               ' the two cards turned this turn
u8 PA2 = 0
u8 PTurn = 0             ' 0 you, 1 CPU
u8 PFirst = 0
u8 PYou = 0
u8 PCpu = 0
u8 PLeft = 0
u8 PLv = 0
u8 PCap = 0
u8 PMenu = 0
u8 PMemN = 0
u8 Pi = 0
u8 Pj = 0
u8 Pk = 0
u8 Pn = 0
u8 Pc = 0
u8 Pr = 0
u8 Pf = 0
u8 Pg = 0
u8 Ph = 0
u8 PxS = 0
u8 PyS = 0
u8 PWant = 0
u8 PMatch = 0
u8 PSlot = 0
u8 Pa = 0
u8 Pb = 0
u8 Pp = 0
u8 Pq = 0
u8 PSeen = 0             ' for the test bots: a card was just shown (its position + 1)

data PCaps bytes 4,5,6,8,12

sub ParitesMain:
  ' kept in the shell's Keep[10..11]
  PLv = Keep[10]
  PFirst = Keep[11]
  if PLv = 0 then
    PLv = 1
    PFirst = 2
  end if
pa_card:
  ParitesCard
  if PMenu = 3 then
    Keep[10] = PLv
    Keep[11] = PFirst
    return
  end if
  if PMenu = 2 then
    PaHelpScreen
    goto pa_card
  end if
  PaPlay
  goto pa_card
end sub

sub PaTiles:
  fill mode 2 text color with $F0
  copy PaPat count PaBytes to vram.pattern + 1024
  copy PaPat count PaBytes to vram.pattern + 3072
  copy PaPat count PaBytes to vram.pattern + 5120
  copy PaCol count PaBytes to vram.color + 1024
  copy PaCol count PaBytes to vram.color + 3072
  copy PaCol count PaBytes to vram.color + 5120
  backdrop 12
  cls
  return
end sub

' card Pk -> its top-left cell PxS,PyS
sub PaPlace:
  Pc = Pk % 6
  Pr = Pk / 6
  PxS = Pc << 2
  PxS += PaX0
  PyS = Pr * 3
  PyS += PaY0
  return
end sub

' draw card Pk with the 3 x 3 tiles from code Pn (32 = gone)
sub PaDraw:
  PaPlace
  for Pj = 0 to 2
    Pr = PyS + Pj
    for Pi = 0 to 2
      Pc = PxS + Pi
      if Pn = 32 then
        put char 32 at Pc,Pr
      else
        V = Pj * 3
        V += Pi
        V += Pn
        put char V at Pc,Pr
      end if
    next
  next
  return
end sub

' card Pk as it is now (back, lit back under the cursor, face, gone)
sub PaShow:
  Pf = PaState + Pk
  Pg = Scr[Pf]
  Pn = PaBack00
  if Pk = PCur then Pn = PaLit00
  if Pg = 1 then Pn = PaFace00
  if Pg = 2 then Pn = 32
  PaDraw
  return
end sub

' the figure sprites over a face-up card: slot Pi (0 or 1) shows card Pk
sub PaFig:
  PaPlace
  Pf = PaDeal + Pk
  Pg = Scr[Pf]
  V = Pg << 3
  V += SpFig0a
  X = PxS << 3
  X += 4
  Y = PyS << 3
  Y += 3
  Pj = Pi << 1
  Pf = Pg << 1
  N = FigCol[Pf]
  set sprite Pj to Y,X,V,N
  inc Pj
  inc Pf
  N = FigCol[Pf]
  V += 4
  set sprite Pj to Y,X,V,N
  update sprites
  return
end sub

sub PaNoFig:
  for Pj = 0 to 3
    set sprite Pj to 209,0,0,0
  next
  update sprites
  return
end sub

' turn card Pk face up (edge, then face) into sprite slot PSlot (0 or 1)
sub PaFlipUp:
  Pn = PaHalf00
  PaDraw
  play sound SndFlip
  for Wt = 1 to 4
    Frame1
    Phase = 1
  next
  Pf = PaState + Pk
  Scr[Pf] = 1
  Pn = PaFace00
  PaDraw
  Pi = PSlot
  PaFig
  Frame1
  Phase = 1
  ' everybody sees it: the CPU may remember it
  PaRemember
  V = Pk + 1
  PSeen = V
  return
end sub

' the CPU's memory: Pk goes to the newest place (once), the oldest leaves
sub PaRemember:
  Pn = 99
  Pj = 0
  while Pj < PMemN
    Pf = PaMem + Pj
    if Scr[Pf] = Pk then Pn = Pj + 1
    inc Pj
  end while
  if Pn <> 99 then
    ' already known: take it out, it comes back as the newest
    Pj = Pn
    while Pj < PMemN
      Pf = PaMem + Pj
      Pg = Scr[Pf]
      dec Pf
      Scr[Pf] = Pg
      inc Pj
    end while
    dec PMemN
  end if
  if PMemN >= PCap then
    ' forget the oldest
    Pj = 1
    while Pj < PMemN
      Pf = PaMem + Pj
      Pg = Scr[Pf]
      dec Pf
      Scr[Pf] = Pg
      inc Pj
    end while
    dec PMemN
  end if
  Pf = PaMem + PMemN
  Scr[Pf] = Pk
  inc PMemN
  return
end sub

' a pair left the table: the CPU forgets those two places
sub PaForget:
  Pj = 0
  while Pj < PMemN
    Pf = PaMem + Pj
    Pg = Scr[Pf]
    if Pg = PA1 then Pg = 99
    if Pg = PA2 then Pg = 99
    if Pg = 99 then
      Pn = Pj
      while Pn < PMemN
        Pf = PaMem + Pn
        inc Pf
        Pg = Scr[Pf]
        dec Pf
        Scr[Pf] = Pg
        inc Pn
      end while
      dec PMemN
    else
      inc Pj
    end if
  end while
  return
end sub

' ------------------------------------------------------------ the deal
sub PaDeal36:
  for Pk = 0 to 35
    V = Pk >> 1
    Pf = PaDeal + Pk
    Scr[Pf] = V
    Pf = PaState + Pk
    Scr[Pf] = 0
  next
  ' shuffle (Fisher-Yates; the book makes 120 random swaps)
  Pk = 35
  while Pk > 0
    Rnd
    V = Pk + 1
    Pj = R2 % V
    Pf = PaDeal + Pk
    Pg = Scr[Pf]
    Pn = PaDeal + Pj
    Ph = Scr[Pn]
    Scr[Pf] = Ph
    Scr[Pn] = Pg
    dec Pk
  end while
  PMemN = 0
  return
end sub

' ------------------------------------------------------------ HUD
sub PaHud:
  put char PaHyou at 3,1
  put char PaHpair at 4,1
  print PYou at 5,1 width 2
  print at 12,1, "LV"
  print PLv at 14,1 width 1
  put char PaHcpu at 25,1
  put char PaHpair at 26,1
  print PCpu at 27,1 width 2
  return
end sub

sub PaSay:
  fill 32 count 26 at 3,22
  return
end sub

' ------------------------------------------------------------ a game
sub PaPlay:
  BlankScreen
  PaTiles
  PaDeal36
  PCur = 0
  for Pk = 0 to 35
    PaShow
  next
  PYou = 0
  PCpu = 0
  PLeft = 18
  V = PLv - 1
  PCap = PCaps[V]
  PaHud
  ShowScreen
  nmi off
  play sound SndMqLead
  play sound SndMqTwo
  play sound SndMqNoise
  play sound SndMqPitch
  nmi on
  nmi off
  if PFirst = 2 then
    Rnd
    PFirst = R2 & 1
  end if
  PTurn = PFirst
pa_turn:
  Frame1
  Phase = 1
  PA1 = 99
  PA2 = 99
  PaSay
  if PTurn = 0 then
    print at 11,22, "YOUR TURN"
    PSlot = 0
    PaPick
    PA1 = PCur
    PSlot = 1
    PaPick
    PA2 = PCur
  else
    print at 11,22, "MY TURN"
    PaCpuPick
  end if
  ' a look at both (the book: WAIT 300)
  for Wt = 1 to 50
    Frame1
    Phase = 1
  next
  Pf = PaDeal + PA1
  Pg = Scr[Pf]
  Pf = PaDeal + PA2
  Ph = Scr[Pf]
  if Pg = Ph then
    PaPair
    if PLeft = 0 then goto pa_end
    goto pa_turn
  end if
  ' not a pair: they turn back, the other player
  play sound SndRefuse
  PaNoFig
  Pk = PA1
  Pn = PaHalf00
  PaDraw
  Pk = PA2
  Pn = PaHalf00
  PaDraw
  for Wt = 1 to 4
    Frame1
    Phase = 1
  next
  Pf = PaState + PA1
  Scr[Pf] = 0
  Pf = PaState + PA2
  Scr[Pf] = 0
  Pk = PA1
  PaShow
  Pk = PA2
  PaShow
  PTurn = PTurn ^ 1
  goto pa_turn
pa_end:
  Phase = 0
  StopMusic
  PaNoFig
  PaSay
  if PYou > PCpu then
    print at 9,22, "YOU WIN!"
    PFirst = 1
    play sound SndWin
  end if
  if PYou < PCpu then
    print at 9,22, "I WIN!"
    PFirst = 0
    play sound SndLose
  end if
  if PYou = PCpu then
    print at 9,22, "A DRAW"
    PFirst = 2
    play sound SndDraw
  end if
  print PYou at 18,22 width 2
  print at 21,22, "TO"
  print PCpu at 24,22 width 2
  for Wt = 1 to 90
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' a pair: a point, both figures fly to the finder's corner, the cards go
sub PaPair:
  play sound SndAgain
  Pf = PaState + PA1
  Scr[Pf] = 2
  Pf = PaState + PA2
  Scr[Pf] = 2
  Pk = PA1
  Pn = 32
  PaDraw
  Pk = PA2
  PaDraw
  PaForget
  Frame1
  Phase = 1
  dec PLeft
  ' the flight: 16 frames to the corner (sprites 0-3 move together)
  PWant = 8
  if PTurn = 1 then PWant = 216
  Pk = PA1
  PaPlace
  PxS = PxS << 3
  PyS = PyS << 3
  Pc = PxS
  Pr = PyS
  Pk = PA2
  PaPlace
  PxS = PxS << 3
  PyS = PyS << 3
  ' the figure's two patterns and colours
  Pf = PaDeal + PA1
  Pg = Scr[Pf]
  Pf = Pg << 1
  Pa = FigCol[Pf]
  inc Pf
  Pb = FigCol[Pf]
  Pp = Pg << 3
  Pp += SpFig0a
  Pq = Pp + 4
  for Wt = 1 to 16
    Frame1
    Phase = 1
    ' each card moves 1/16 of its way a frame (to x PWant, y 0)
    for Pi = 0 to 1
      if Pi = 0 then
        X = Pc
        Y = Pr
      else
        X = PxS
        Y = PyS
      end if
      if X > PWant then
        V = X - PWant
        V = V >> 4
        V = V * Wt
        X -= V
      else
        V = PWant - X
        V = V >> 4
        V = V * Wt
        X += V
      end if
      V = Y >> 4
      V = V * Wt
      Y -= V
      X += 4
      Y += 3
      Pj = Pi << 1
      set sprite Pj to Y,X,Pp,Pa
      inc Pj
      set sprite Pj to Y,X,Pq,Pb
    next
    update sprites
  next
  PaNoFig
  if PTurn = 0 then
    inc PYou
  else
    inc PCpu
  end if
  PaHud
  return
end sub

' your card: move the cursor (lit back) with the joystick, a button turns it
sub PaPick:
  Pk = PCur
  PaShow
  WaitIn = 1
pp_loop:
  Frame1
  Phase = 1
  ReadPad
  if StickHit = 1 then
    Pn = PCur
    Pc = PCur % 6
    if Lf1 = 1 then
      if Pc > 0 then dec PCur
    end if
    if Rt1 = 1 then
      if Pc < 5 then inc PCur
    end if
    if Up1 = 1 then
      if PCur >= 6 then PCur -= 6
    end if
    if Dn1 = 1 then
      if PCur < 30 then PCur += 6
    end if
    if PCur <> Pn then
      play sound SndMove
      Pk = Pn
      PaShow
      Pk = PCur
      PaShow
    end if
  end if
  if Press = 0 then goto pp_loop
  ' only a card that is face down
  Pf = PaState + PCur
  if Scr[Pf] <> 0 then
    play sound SndRefuse
    goto pp_loop
  end if
  WaitIn = 0
  Pk = PCur
  PaFlipUp
  return
end sub

' the CPU: a pair it remembers, else an unknown card, then its match if known
sub PaCpuPick:
  for Wt = 1 to 20
    Frame1
    Phase = 1
  next
  PA1 = 99
  PA2 = 99
  ' a known pair?
  Pi = 0
  while Pi < PMemN
    ' one remembered card a frame (12 at most: no frame lost)
    Frame1
    Phase = 1
    Pj = Pi + 1
    while Pj < PMemN
      if Pi < Pj then
        Pf = PaMem + Pi
        Pk = Scr[Pf]
        Pf = PaMem + Pj
        Pn = Scr[Pf]
        Pf = PaDeal + Pk
        Pg = Scr[Pf]
        Pf = PaDeal + Pn
        Ph = Scr[Pf]
        if Pg = Ph then
          PA1 = Pk
          PA2 = Pn
        end if
      end if
      inc Pj
    end while
    inc Pi
  end while
  if PA1 = 99 then
    PaUnknown
    PA1 = PWant
  end if
  PWant = PA1
  PaWalk
  Pk = PA1
  PSlot = 0
  PaFlipUp
  for Wt = 1 to 20
    Frame1
    Phase = 1
  next
  if PA2 = 99 then
    ' its match, if it remembers it
    Pf = PaDeal + PA1
    Pg = Scr[Pf]
    Pj = 0
    while Pj < PMemN
      Pf = PaMem + Pj
      Pk = Scr[Pf]
      if Pk <> PA1 then
        Pf = PaDeal + Pk
        if Scr[Pf] = Pg then PA2 = Pk
      end if
      inc Pj
    end while
  end if
  if PA2 = 99 then
    PaUnknown
    PA2 = PWant
  end if
  PWant = PA2
  PaWalk
  Pk = PA2
  PSlot = 1
  PaFlipUp
  return
end sub

' a random face-down card it does not remember -> PWant (any face-down if
' none): from a random place, the first such card (36 looks at most)
sub PaUnknown:
  Rnd
  Pk = R2 % 36
  PWant = 99
  Pc = 99
  for Pn = 1 to 36
    inc Pk
    if Pk >= 36 then Pk = 0
    Pf = PaState + Pk
    if Scr[Pf] = 0 then
      if Pc = 99 then Pc = Pk
      if PWant = 99 then
        Pg = 0
        Pj = 0
        while Pj < PMemN
          Pf = PaMem + Pj
          if Scr[Pf] = Pk then Pg = 1
          inc Pj
        end while
        if Pg = 0 then PWant = Pk
      end if
    end if
  next
  if PWant = 99 then PWant = Pc
  return
end sub

' the cursor walks to card PWant (one card every 6 frames)
sub PaWalk:
  while PCur <> PWant
    Pn = PCur
    Pc = PCur % 6
    Pr = PCur / 6
    Pg = PWant % 6
    Ph = PWant / 6
    if Pc < Pg then inc PCur
    if Pc > Pg then dec PCur
    if Pc = Pg then
      if Pr < Ph then PCur += 6
      if Pr > Ph then PCur -= 6
    end if
    Pk = Pn
    PaShow
    Pk = PCur
    PaShow
    play sound SndMove
    for Wt = 1 to 6
      Frame1
      Phase = 1
    next
  end while
  return
end sub

' ------------------------------------------------------------ the card
sub ParitesCard:
  BlankScreen
  PaTiles
  print at 8,2, "PARITES & MEMORY"
  print at 7,4, "ORIGINAL GAMES BY"
  print at 6,5, "JEAN-FRANCOIS SEHAN"
  print at 8,6, "CZES KOSNIOWSKI"
  ' a row of cards: backs and two faces (the figures as sprites)
  for Pk = 0 to 35
    Pf = PaState + Pk
    Scr[Pf] = 0
    Pf = PaDeal + Pk
    Scr[Pf] = Pk >> 1
  next
  PCur = 99
  for Pk = 12 to 17
    PaShow
  next
  Pf = PaState + 13
  Scr[Pf] = 1
  Pf = PaState + 16
  Scr[Pf] = 1
  Pf = PaDeal + 16
  Scr[Pf] = 6
  Pk = 13
  PaShow
  Pk = 16
  PaShow
  print at 11,13, "START"
  print at 11,15, "LEVEL"
  print at 11,17, "HOW TO PLAY"
  print at 11,19, "BACK"
  print at 8,21, "AMY & CLAUDE 2026"
  PaShowLv
  ShowScreen
  Pi = 0
  Pk = 13
  PaFig
  Pi = 1
  Pk = 16
  PaFig
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  PMenu = 0
  Phase = 6
  Rearm
  wait no fire
  WasBtn = 0
  nmi off
pc_loop:
  Frame1
  ReadPad
  Rnd
  V = PMenu << 4
  V += 100
  set sprite 4 to V,70,SpCu0,SpCuC0
  set sprite 5 to V,70,SpCu1,SpCuC1
  update sprites
  if StickHit = 1 then
    if Up1 = 1 then
      if PMenu = 0 then
        PMenu = 3
      else
        dec PMenu
      end if
      play sound SndMove
    end if
    if Dn1 = 1 then
      inc PMenu
      if PMenu > 3 then PMenu = 0
      play sound SndMove
    end if
    if PMenu = 1 then
      if Lf1 = 1 then
        if PLv > 1 then dec PLv
      end if
      if Rt1 = 1 then
        if PLv < 5 then inc PLv
      end if
      PaShowLv
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto pc_loop
  if PMenu = 1 then goto pc_loop
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub PaShowLv:
  print at 18,15, "< >"
  put char PLv + 48 at 19,15
  return
end sub

sub PaHelpScreen:
  BlankScreen
  PaTiles
  PagePaHelp
  put char PaHstick at 3,9
  put char PaHbtn at 3,11
  put char PaHyou at 2,13
  put char PaHcpu at 3,13
  put char PaHpair at 3,15
  WaitPage
  return
end sub

' the end of this game's code in its bank (build.py: the literal pool after it
' starts at the same address in every bank, the shell's strings first)
sub PaEnd:
  return
  asm {
    ds $DC00-$,$FF
  }
end sub

u8 RamPadParites[129]   ' build.py: same RAM end in every bank

' text pages (generated by _common/tools/textpages.py)
sub PagePaHelp:
  print at 8,1, "PARITES & MEMORY"
  print at 2,3, "36 CARDS FACE DOWN: 18 PAIRS"
  print at 2,4, "OF FIGURES. TURN TWO CARDS."
  print at 2,5, "THE SAME FIGURE: A PAIR, THE"
  print at 2,6, "CARDS LEAVE THE TABLE AND"
  print at 2,7, "YOU PLAY AGAIN. ELSE THEY"
  print at 2,8, "TURN BACK: THE CPU PLAYS."
  print at 5,9, "JOYSTICK: PICK A CARD"
  print at 5,11, "BUTTON: TURN A CARD"
  print at 5,13, "YOU AND THE CPU"
  print at 5,15, "PAIRS FOUND"
  print at 2,17, "THE CPU REMEMBERS WHAT IT"
  print at 2,18, "SEES: 4 CARDS AT LV 1, UP TO"
  print at 2,19, "12 AT LV 5. WATCH ITS MOVES!"
  print at 2,20, "MOST PAIRS WINS."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

