' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- shell
u8 Menu = 0
u8 GameNo = 0
u8 Wt = 0
u8 AnF = 0
u8 Tx = 0
u8 Ty = 0
u16 Rs = 0              ' xorshift random state
u16 Wf = 0
u8 R2 = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title, 3+ game cards
u8 RollX = 0
u8 RollC = 0
u8 SoonT = 0
u8 WaitIn = 0           ' for the test bots: a game waits for your move
u8 Scr[256]             ' scratch shared by the game modules (one game runs at a time)
u8 Keep[16]             ' what a game keeps between visits (levels, tallies, bests)

' ================================================================== program
  tile screen
  mode 2 screen
  ' the window shows AWARI's bank (any game bank holds the shell's strings)
  asm {
    ld a,($FFC0)
  }
  set sound table TcSoundTable areas MtAreas
  sprites 16x16
  nmi off
  asm {
    call AMY_VRAM_BEGIN
    ld hl,SpPatA
    ld de,VRAM_SPR_PAT
    ld bc,AMY_UCONST_SpBytes
    call AMY_COPY_BYTES_TO_VRAM
    call AMY_VRAM_END
  }
  HideSprites
  if Keep[15] = 77 then ShellForce
  Rs = $5A3C
  screen on
  CreditsScreen

main_menu:
  TitleScreen
  if Menu = 0 then
    ' AwariMain, through the gate at $C000 of bank 0
    asm {
      ld a,($FFC0)
      call $C000
    }
    goto main_menu
  end if
  if Menu = 1 then
    ' TaquinMain, through the gate at $C000 of bank 1
    asm {
      ld a,($FFC1)
      call $C000
    }
    goto main_menu
  end if
  if Menu = 2 then
    ' ParitesMain, through the gate at $C000 of bank 2
    asm {
      ld a,($FFC2)
      call $C000
    }
    goto main_menu
  end if
  if Menu = 3 then
    ' NimMain, through the gate at $C000 of bank 3
    asm {
      ld a,($FFC3)
      call $C000
    }
    goto main_menu
  end if
  if Menu = 4 then
    CreditsScreen
    goto main_menu
  end if
  goto main_menu

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ shell tiles
sub ShellTiles:
  fill mode 2 text color with $F0
  asm {
    call AMY_VRAM_BEGIN
    ld hl,ShPatA
    ld de,VRAM_PATTERN + 1024
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    ld hl,ShPatA
    ld de,VRAM_PATTERN + 3072
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    ld hl,ShPatA
    ld de,VRAM_PATTERN + 5120
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    ld hl,ShColA
    ld de,VRAM_COLOR + 1024
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    ld hl,ShColA
    ld de,VRAM_COLOR + 3072
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    ld hl,ShColA
    ld de,VRAM_COLOR + 5120
    ld bc,AMY_UCONST_ShBytes
    call AMY_COPY_BYTES_TO_VRAM
    call AMY_VRAM_END
  }
  backdrop 12
  cls
  return
end sub

' the cabinet's carved frame around the whole safe area (cols 2-29, rows 1-22)
sub CabinetFrame:
  fill ShFh count 26 at 3,1
  fill ShFb count 26 at 3,22
  for Ty = 2 to 21
    put char ShFl at 2,Ty
    put char ShFr at 29,Ty
  next
  put char ShStud at 2,1
  put char ShStud at 29,1
  put char ShStud at 2,22
  put char ShStud at 29,22
  return
end sub

' ------------------------------------------------------------ music
sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  stop sound SndMqLead
  stop sound SndMqTwo
  stop sound SndMqNoise
  stop sound SndMqPitch
  mute all
  nmi on
  nmi off
  return
end sub

sub TitleMusic:
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub CreditsScreen:
  BlankScreen
  ShellTiles
  PageCredits
  WaitPage
  return
end sub

' ------------------------------------------------------------ title + menu
sub TitleScreen:
  BlankScreen
  ShellTiles
  CabinetFrame
  print at 14,2, "THE"
  DrawTitleLogo
  ' a shelf of stones under the logo (row 9)
  for Tx = 4 to 27
    V = Tx & 3
    put char ShSt0 + V at Tx,9
  next
  ' the games (rows 11-19, one blank row between lines; row 21 = messages)
  put char ShIaw at 6,11
  print at 8,11, "AWARI"
  put char ShIta at 6,13
  print at 8,13, "TAQUIN"
  put char ShIpa at 6,15
  print at 8,15, "PARITES&MEMORY"
  put char ShIni at 6,17
  print at 8,17, "SQUARE NIM"
  print at 8,19, "CREDITS"
  ShowScreen
  TitleMusic
  RollX = 32
  RollC = 0
  SoonT = 0
  Phase = 2
  Rearm
  wait no fire
  WasBtn = 0
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  inc AnF
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
      play sound SndMove
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 4 then Menu = 0
      play sound SndMove
    end if
    SoonT = 0
    fill 32 count 11 at 11,21
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

' the menu cursor (a stone) and a stone rolling along the shelf
sub TitleAnim:
  V = Menu << 4
  V += 81
  J = AnF & 16
  J = J >> 3
  set sprite 0 to V,34 + J,SpCu0,SpCuC0
  set sprite 1 to V,34 + J,SpCu1,SpCuC1
  ' the rolling stone: one pixel a frame, a little hop at every stud
  inc RollX
  if RollX >= 216 then
    RollX = 24
    inc RollC
    RollC = RollC & 3
  end if
  V = RollX & 7
  Y = 59
  if V < 3 then dec Y
  N = 7
  if RollC = 1 then N = 13
  if RollC = 2 then N = 11
  if RollC = 3 then N = 3
  set sprite 2 to Y,RollX,SpSt0,N
  set sprite 3 to Y,RollX,SpSt1,15
  update sprites
  if SoonT > 0 then
    dec SoonT
    if SoonT = 0 then fill 32 count 11 at 11,21
  end if
  return
end sub

' the shell's tiles and sprites, inline in the fixed bank (never called)
sub ShellData:
  return
  asm {
ShPatA:
    db $00,$00,$00,$20,$02,$00,$00,$00,$00,$00,$00,$08,$40,$00,$00,$00
    db $81,$81,$91,$81,$81,$85,$81,$81,$81,$81,$85,$81,$81,$A1,$81,$81
    db $00,$80,$80,$80,$80,$80,$81,$81,$00,$01,$01,$01,$01,$01,$81,$81
    db $81,$81,$80,$80,$80,$80,$80,$00,$81,$81,$01,$01,$01,$01,$01,$00
    db $00,$C3,$81,$81,$81,$81,$C3,$00,$00,$81,$00,$93,$93,$00,$93,$81
    db $11,$11,$11,$00,$E0,$E0,$E0,$00,$81,$81,$81,$00,$81,$81,$81,$81
    db $00,$60,$93,$0C,$9C,$9C,$1A,$1A,$00,$00,$18,$C3,$C3,$18,$00,$00
    db $00,$00,$18,$C3,$C3,$18,$00,$00,$00,$00,$18,$C3,$C3,$18,$00,$00
    db $00,$00,$18,$C3,$C3,$18,$00,$00,$00,$00,$07,$03,$03,$03,$03,$03
    db $00,$00,$E0,$C0,$C0,$C0,$C0,$C0,$60,$F0,$F0,$F0,$F0,$07,$00,$00
    db $06,$F0,$F0,$F0,$F0,$E0,$00,$00,$C0,$C0,$07,$03,$03,$03,$03,$03
    db $03,$03,$E0,$C0,$C0,$C0,$C0,$C0,$60,$07,$07,$01,$01,$00,$0C,$0E
    db $06,$F0,$F0,$F0,$F0,$70,$70,$30,$60,$F0,$F0,$0E,$0E,$0C,$00,$00
    db $1C,$83,$87,$E0,$E0,$80,$00,$00,$80,$00,$07,$F0,$F0,$07,$00,$00
    db $03,$03,$00,$00,$00,$00,$F0,$F0,$E0,$07,$87,$C3,$C3,$87,$07,$F0
    db $18,$C3,$C3,$87,$07,$E0,$00,$00,$E0,$80,$87,$F0,$F0,$87,$80,$E0
    db $E0,$07,$83,$1C,$00,$00,$E0,$07,$03,$03,$03,$03,$03,$01,$00,$00
    db $C0,$C0,$C0,$C0,$C0,$80,$00,$00,$07,$F0,$F0,$F0,$F0,$60,$00,$00
    db $E0,$F0,$F0,$F0,$F0,$06,$00,$00,$03,$03,$03,$07,$C0,$C0,$00,$00
    db $C0,$C0,$C0,$E0,$03,$03,$00,$00,$0E,$F0,$F0,$F0,$F0,$60,$00,$00
    db $00,$80,$80,$E0,$E0,$06,$00,$00,$0C,$0E,$0E,$F0,$F0,$60,$00,$00
    db $80,$E0,$E0,$87,$83,$1C,$00,$00,$07,$F0,$F0,$07,$00,$80,$00,$00
    db $00,$00,$00,$00,$03,$03,$00,$00,$06,$F0,$F0,$F0,$F0,$60,$00,$00
