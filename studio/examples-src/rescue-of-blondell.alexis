cartridge "RESCUE OF BLONDELL/PRESENTS GRANT ALBRECHT'S/1985"

' RESCUE OF BLONDELL
' By Grant Albrecht, COMPUTE! magazine, January 1985: a fast-action game
' with smooth horizontal scrolling, entirely in machine language, for the
' Atari, the Commodore 64 and the VIC-20 with 8K (64 and VIC versions by
' Kevin Mykytyn). All credit belongs to Grant Albrecht and Kevin Mykytyn.
'
' Historical context (summary of the article):
' The king's daughter Blondell has been kidnapped by an evil sorcerer and
' held captive in a tower; the king sends the most reputable genie in
' the kingdom to rescue her on his magic carpet. Fly toward the tower,
' pick her up, and fly back to your base. The sorcerer's swift and
' powerful birds are intelligent and home in on the carpet, and they can
' summon the elements and hurl lightning bolts. Each time a bird crashes
' into you or strikes you, you lose magic; the genie can throw lightning
' too. The score, the magic left and the bonus for the rescue, which
' drops with time, are shown at the bottom. The Commodore versions award
' 10 points for each bird, however it meets its end (shot, or crashed into
' the ground chasing you), and let you choose one to three birds on the
' 64. Do not land on your base without her: it has unfortunate results.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the joystick flies the carpet in eight directions; fire
' throws a lightning bolt the way the genie last flew (either joystick).
' The program is rebuilt from the article and the screenshots: the 64
' and VIC listings are machine language in DATA statements, and the scans
' were not sharp enough to transcribe the 2,800 bytes of the 64 version
' reliably (its own checksum would have caught errors, not located them).
' Rules of this rewrite: a world 96 columns wide, the base at the left,
' a range of brick hills, the tower at the right with the princess on
' top; touch her to pick her up, land on the base pad with her to win
' the bonus and a new, faster round. Magic starts at 100: a bird crashing
' into the genie costs 10, a bolt 10, scraping a hill 5, landing on the
' base without her 20; none left ends the game. Birds home in on the
' carpet a pixel at a time, fire when level with it, and come back from
' the edge of the screen when lost; 10 points each. The bonus starts at
' 2000 and drops by one every six frames.
' Adaptation liberties: smooth scrolling in software: 36 tiles, one per
' pair of neighbouring terrain kinds, redrawn shifted by 0-7 pixels, in
' two tile ranges and two name tables ($1800, $1C00) used in turn; each
' step is drawn out of sight (name rows by a Z80 routine) and shown with
' one VDP register write, so no step is ever seen half drawn; the carpet flutters, the
' genie bobs, the princess waves, the bolts flicker; a ding for every 10
' bonus points counted; the graphics are drawn for this port; an
' original title tune (Tiny Sound); joystick menus; an editorial page.
' The frame loop is protected from the NMI.
' Screen: score and round on row 1; play area rows 3-20; magic and bonus
' on rows 21-22.

const Brick = 128
const HillTop = 129
const TowerWall = 130
const TowerTop = 131
const Pad = 132
const WorldW = 96
const TowerCol = 87
const MaxBirds = 3

' Sound table slots (rb/s.mjs)
const SndZap = 1
const SndZapB = 2
const SndDownA = 3
const SndDownB = 4
const SndHurtA = 5
const SndHurtB = 6
const SndPick = 7
const SndFanfare = 8
const SndOver = 9
const SndBirdZap = 10
const SndDing = 11
const SndTuneA = 12
const SndTuneB = 13

bcd digits 6 Score
bcd digits 6 HighScore
u8 H[WorldW]                   ' hill height of each column (rows)
u8 RowBuf[28]
u16 ScrollPx = 0              ' the view's left edge, world pixels
u8 Fine = 0
u8 OldFine = 255
u16 ZBase = 0
u8 ZRange = 128
u8 ZKL = 0
u8 ZCnt = 0
u8 ZShow = 0                   ' the name table on screen
u8 ZOnlyShadow = 0
u8 Hid = 1
u8 TCam[2]                     ' the column each name table was drawn at
u16 OldScroll = 65535
bool Pending = false
u8 Birds = 2
u8 Round = 1
u8 Magic = 100
u16 Bonus = 2000
u8 BonusT = 0
u8 Cam = 0                     ' first world column on screen
u16 PX = 24                    ' genie, world pixels
u8 PY = 80
u8 Face = 1                    ' 1 right, 0 left
u8 Hurt = 0                    ' frames of grace after a hit
bool Carry = false
bool ShotOn = false
u16 ShX = 0
u8 ShY = 0
u8 ShD = 1
u8 BOn[MaxBirds]
u16 BX[MaxBirds]
u8 BY[MaxBirds]
u8 BBOn[MaxBirds]              ' the birds' bolts
u16 BBX[MaxBirds]
u8 BBY[MaxBirds]
u8 BBD[MaxBirds]
u8 Boom = 0
u8 BoomX = 0
u8 BoomY = 0
u8 Speed = 1
u8 Frame2 = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 C = 0
u8 Top = 0
u8 Choice = 0
u16 T16 = 0
u16 W16 = 0
u16 Dst16 = 0
u16 NumU = 0

  tile screen
  ' Share one Graphics II pattern table across all three screen thirds.
  ' Colors remain independent, but each fine-scroll step now transfers
  ' 288 pattern bytes instead of repeating 864 bytes.
  call asm ZSharePatterns
  set sound table BlondellSoundTable areas 4
  sprites 16x16
  copy SpritePat count 288 to vram.spr_pat
  HideSprites
  LoadTiles
  screen on
  play sounds SndTuneA, SndTuneB
  EditorialPage

title:
  TitlePage
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  Score = 0
  Round = 1
  Magic = 100

new_round:
  MakeWorld
  Bonus = 2000
  PX = 20
  PY = 100
  Face = 1
  Carry = false
  ShotOn = false
  Hurt = 0
  Boom = 0
  Speed = Round + 1
  Speed >>= 1
  if Speed > 3 then Speed = 3
  for I = 0 to MaxBirds - 1
    BOn[I] = 0
    BBOn[I] = 0
  next
  nmi on
  ClearBoth
  nmi off
  Camera
  ZShow = Hid
  call asm ZFlip
  Pending = false
  Camera
  nmi on
  StatusBoth
  NumU = Round
  print at 11,10, "ROUND " + digits$(NumU, 2)
  wait 90 frames
  fill 32 count 10 at 11,10

main_loop:
  nmi on
  wait
  nmi off
  if Pending then
    ZShow = Hid
    call asm ZFlip
    Pending = false
  end if
  inc Frame2
  MovePlayer
  Camera
  MoveShot
  MoveBirds
  MoveBirdShots
  CheckPrincess
  ' The bonus drops with time
  inc BonusT
  if BonusT >= 6 then
    BonusT = 0
    if Bonus > 0 then dec Bonus
    N = Frame2 & 31
    if N = 0 then StatusBoth
  end if
  DrawSprites
  if Magic = 0 then goto game_over
  ' Home with her: the rescue
  if Carry then
    if PX < 32 then
      C = 1
      GroundTop
      N = PY + 18
      if N >= Top then goto rescued
    end if
  end if
  goto main_loop

rescued:
  nmi on
  play sound SndFanfare
  print at 6,8, "BLONDELL IS RESCUED!"
  NumU = Bonus
  print at 8,10, "BONUS " + digits$(NumU, 4)
  wait 60 frames
add_bonus:
  if Bonus >= 10 then
    Bonus -= 10
    Score += 10
    play sound SndDing
    StatusBoth
    wait 3 frames
    goto add_bonus
  end if
  wait 60 frames
  inc Round
  if Round > 99 then Round = 99
  goto new_round

game_over:
  nmi on
  play sound SndOver
  if Score > HighScore then HighScore = Score
  print at 7,9, "THE MAGIC IS GONE!"
  print at 11,11, "GAME OVER"
  wait 120 frames
  play sounds SndTuneA, SndTuneB
  goto title

' ---------------------------------------------------------------------------

' The stick flies the carpet; fire throws a bolt
sub MovePlayer:
  if Hurt > 0 then dec Hurt
  N = 0
  if joypad(1).left then N = 1
  if joypad(2).left then N = 1
  if joypad(1).right then N = 2
  if joypad(2).right then N = 2
  if N = 1 then
    Face = 0
    if PX > 1 then PX -= 1
  end if
  if N = 2 then
    Face = 1
    T16 = WorldW * 8
    T16 -= 18
    if PX < T16 then PX += 1
  end if
  N = 0
  if joypad(1).up then N = 1
  if joypad(2).up then N = 1
  if joypad(1).down then N = 2
  if joypad(2).down then N = 2
  if N = 1 then
    if PY > 22 then PY -= 2
  end if
  if N = 2 then
    if PY < 146 then PY += 2
  end if
  ' The ground and the hills
  T16 = PX + 8
  T16 >>= 3
  C = T16
  GroundTop
  N = PY + 16
  if N > Top then
    ' On the base pad
    if C < 4 then
      PY = Top - 16
      if not Carry then
        if Hurt = 0 then
          Hurt = 60
          play sounds SndHurtA, SndHurtB
          LoseMagic
          if Magic >= 10 then
            Magic -= 10
          else
            Magic = 0
          end if
          StatusBoth
        end if
        PY -= 24
        PX += 16
      end if
      return
    end if
    PY = Top - 22
    if Hurt = 0 then
      Hurt = 40
      play sounds SndHurtA, SndHurtB
      if Magic >= 5 then
        Magic -= 5
      else
        Magic = 0
      end if
      StatusBoth
    end if
  end if
  ' Lightning
  N = 0
  if joypad(1).fire then N = 1
  if joypad(2).fire then N = 1
  if N = 1 then
    if not ShotOn then
      ShotOn = true
      ShX = PX
      ShY = PY + 2
      ShD = Face
      play sounds SndZap, SndZapB
    end if
  end if
  return
end sub

' Ten points of magic (a bird or a bolt); the base costs twenty
sub LoseMagic:
  if Magic >= 10 then
    Magic -= 10
  else
    Magic = 0
  end if
  return
end sub

' Top = the first solid pixel row in world column C
sub GroundTop:
  N = H[C]
  Top = 21 - N
  Top *= 8
  return
end sub

' Smooth scrolling in software: the view follows the genie a pixel at a
' time; the name table changes once every 8 pixels, and between those the
' shared pattern set is redrawn shifted (ShiftPat, set Fine)
sub Camera:
  if PX > 112 then
    T16 = PX - 112
  else
    T16 = 0
  end if
  if T16 > 536 then T16 = 536
  if T16 = OldScroll then return
  OldScroll = T16
  ScrollPx = T16
  T16 >>= 3
  Cam = T16
  N = ScrollPx & 7
  Fine = N
  ' The hidden table and its tile range get this step
  Hid = 1 - ZShow
  W16 = Fine * 288
  Dst16 = 1024
  if Hid = 1 then Dst16 = 1312
  copy ShiftPat + W16 count 288 to vram.pattern + Dst16
  N = TCam[Hid]
  if N <> Cam then
    ZBase = $1800
    ZRange = 128
    if Hid = 1 then
      ZBase = $1C00
      ZRange = 164
    end if
    call asm ZNames
    TCam[Hid] = Cam
  end if
  Pending = true
  return
end sub

' Both name tables get the same status lines
sub StatusBoth:
  call asm ZShadow with a = 0
  ShowStatus
  call asm ZShadow with a = 1
  ShowStatus
  N = ZShow
  call asm ZShadow with a = N
  return
end sub

' Clears both name tables and shows the first
sub ClearBoth:
  call asm ZShadow with a = 1
  cls
  call asm ZShadow with a = 0
  cls
  ZShow = 0
  call asm ZFlip
  TCam[0] = 255
  TCam[1] = 255
  OldScroll = 65535
  Pending = false
  return
end sub

sub MoveShot:
  if not ShotOn then return
  if ShD = 1 then
    ShX += 5
  else
    if ShX < 5 then
      ShotOn = false
      return
    end if
    ShX -= 5
  end if
  ' Off screen?
  T16 = ScrollPx
  if ShX < T16 then ShotOn = false
  T16 += 224
  if ShX > T16 then ShotOn = false
  if not ShotOn then return
  for I = 0 to MaxBirds - 1
    N = BOn[I]
    if N = 1 then
      T16 = BX[I]
      if T16 > ShX then
        W16 = T16 - ShX
      else
        W16 = ShX - T16
      end if
      if W16 < 12 then
        Y = BY[I]
        if Y > ShY then
          N = Y - ShY
        else
          N = ShY - Y
        end if
        if N < 10 then
          ShotOn = false
          BirdDown
          return
        end if
      end if
    end if
  next
  return
end sub

' Bird I is destroyed: 10 points
sub BirdDown:
  BOn[I] = 0
  Score += 10
  play sounds SndDownA, SndDownB
  Boom = 20
  T16 = BX[I]
  W16 = ScrollPx
  if T16 >= W16 then
    T16 -= W16
    T16 += 16
    BoomX = T16
  else
    BoomX = 0
  end if
  BoomY = BY[I]
  StatusBoth
  return
end sub

' The birds come in from the edge and home in on the carpet
sub MoveBirds:
  for I = 0 to MaxBirds - 1
    if I < Birds then
      N = BOn[I]
      if N = 0 then
        N = random(0, 60)
        if N = 0 then
          BOn[I] = 1
          T16 = ScrollPx
          N = random(0, 1)
          if N = 0 then
            T16 += 230
          else
            if T16 > 8 then T16 -= 8
          end if
          BX[I] = T16
          BY[I] = random(24, 80)
        end if
      else
        ' Homing: one pixel a frame, faster in later rounds
        for K = 1 to Speed
          T16 = BX[I]
          if T16 < PX then inc T16
          if T16 > PX then dec T16
          BX[I] = T16
        next
        N = Frame2 & 1
        if N = 0 then
          Y = BY[I]
          if Y < PY then inc Y
          if Y > PY then dec Y
          BY[I] = Y
        end if
        ' Into the hills: down it goes
        T16 = BX[I] + 8
        T16 >>= 3
        C = T16
        GroundTop
        N = BY[I] + 12
        if N > Top then
          BirdDown
        else
          ' Into the genie
          T16 = BX[I]
          if T16 > PX then
            W16 = T16 - PX
          else
            W16 = PX - T16
          end if
          if W16 < 12 then
            Y = BY[I]
            if Y > PY then
              N = Y - PY
            else
              N = PY - Y
            end if
            if N < 12 then
              BOn[I] = 0
              GenieHit
            end if
          end if
          ' Level with the genie: a bolt
          Y = BY[I]
          if Y > PY then
            N = Y - PY
          else
            N = PY - Y
          end if
          if N < 6 then
            V = BBOn[I]
            if V = 0 then
              V = random(0, 40)
              if V = 0 then
                BBOn[I] = 1
                BBX[I] = BX[I]
                BBY[I] = BY[I] + 2
                BBD[I] = 0
                T16 = BX[I]
                if T16 < PX then BBD[I] = 1
                play sound SndBirdZap
              end if
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub MoveBirdShots:
  for I = 0 to MaxBirds - 1
    N = BBOn[I]
    if N = 1 then
      T16 = BBX[I]
      N = BBD[I]
      if N = 1 then
        T16 += 3
      else
        if T16 < 3 then T16 = 3
        T16 -= 3
      end if
      BBX[I] = T16
      W16 = ScrollPx
      if T16 < W16 then BBOn[I] = 0
      W16 += 230
      if T16 > W16 then BBOn[I] = 0
      if T16 > PX then
        W16 = T16 - PX
      else
        W16 = PX - T16
      end if
      if W16 < 10 then
        Y = BBY[I]
        if Y > PY then
          N = Y - PY
        else
          N = PY - Y
        end if
        if N < 10 then
          BBOn[I] = 0
          GenieHit
        end if
      end if
    end if
  next
  return
end sub

sub GenieHit:
  if Hurt > 0 then return
  Hurt = 40
  play sounds SndHurtA, SndHurtB
  LoseMagic
  StatusBoth
  return
end sub

' Touch the princess on the tower to pick her up
sub CheckPrincess:
  if Carry then return
  C = TowerCol + 1
  GroundTop
  T16 = C * 8
  if T16 > PX then
    W16 = T16 - PX
  else
    W16 = PX - T16
  end if
  if W16 >= 14 then return
  Y = Top - 16
  if Y > PY then
    N = Y - PY
  else
    N = PY - Y
  end if
  if N >= 18 then return
  Carry = true
  play sound SndPick
  return
end sub

' Sprites: 0 genie, 1 carpet, 2 princess, 3 the genie's bolt, 4-6 birds,
' 7-9 their bolts, 10 a burst
sub DrawSprites:
  W16 = ScrollPx
  T16 = PX - W16
  T16 += 16
  X = T16
  Y = PY
  N = Frame2 & 16
  if N <> 0 then dec Y
  V = 11
  N = Hurt & 4
  if N <> 0 then V = 15
  set sprite 0 to Y,X,0,V
  N = Frame2 & 8
  V = 4
  if N <> 0 then V = 28
  set sprite 1 to Y,X,V,8
  ' The princess: on the tower, or under the carpet
  if Carry then
    Y = PY + 14
    set sprite 2 to Y,X,16,13
  else
    C = TowerCol + 1
    GroundTop
    T16 = C * 8
    if T16 >= W16 then
      T16 -= W16
      T16 += 16
      if T16 < 240 then
        X = T16
        Y = Top - 15
        N = Frame2 & 16
        V = 16
        if N <> 0 then V = 32
        set sprite 2 to Y,X,V,13
      else
        set sprite 2 to 192,0,0,0
      end if
    else
      set sprite 2 to 192,0,0,0
    end if
  end if
  if ShotOn then
    T16 = ShX - W16
    T16 += 16
    X = T16
    N = Frame2 & 2
    V = 11
    if N <> 0 then V = 15
    set sprite 3 to ShY,X,20,V
  else
    set sprite 3 to 192,0,0,0
  end if
  for I = 0 to MaxBirds - 1
    K = I + 4
    N = BOn[I]
    if N = 1 then
      T16 = BX[I]
      if T16 >= W16 then
        T16 -= W16
        T16 += 16
        if T16 < 245 then
          X = T16
          Y = BY[I]
          N = Frame2 & 8
          V = 8
          if N <> 0 then V = 12
          set sprite K to Y,X,V,1
        else
          set sprite K to 192,0,0,0
        end if
      else
        set sprite K to 192,0,0,0
      end if
    else
      set sprite K to 192,0,0,0
    end if
    K += 3
    N = BBOn[I]
    if N = 1 then
      T16 = BBX[I]
      if T16 >= W16 then
        T16 -= W16
        T16 += 16
        X = T16
        Y = BBY[I]
        set sprite K to Y,X,20,9
      else
        set sprite K to 192,0,0,0
      end if
    else
      set sprite K to 192,0,0,0
    end if
  next
  if Boom > 0 then
    dec Boom
    set sprite 10 to BoomY,BoomX,24,9
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

' The world: the base, the hills, the tower
sub MakeWorld:
  H[0] = 2
  H[1] = 2
  H[2] = 2
  H[3] = 2
  N = 3
  for C = 4 to WorldW - 1
    V = random(0, 3)
    if V = 0 then
      if N > 1 then dec N
    end if
    if V = 1 then
      if N < 11 then inc N
    end if
    H[C] = N
  next
  H[4] = 1
  H[5] = 1
  for C = TowerCol - 2 to WorldW - 1
    H[C] = 3
  next
  for C = TowerCol to TowerCol + 2
    H[C] = 14
  next
  return
end sub

sub ShowStatus:
  print at 2,1, "SCORE"
  print Score at 8,1
  print at 17,1, "HI"
  print HighScore at 20,1
  print at 2,21, "MAGIC"
  NumU = Magic
  print at 8,21, digits$(NumU, 3)
  print at 14,21, "BONUS"
  NumU = Bonus
  print at 20,21, digits$(NumU, 4)
  print at 2,22, "ROUND"
  NumU = Round
  print at 8,22, digits$(NumU, 2)
  if Carry then
    print at 14,22, "BLONDELL ABOARD"
  else
    fill 32 count 15 at 14,22
  end if
  return
end sub

' Graphics II: tiles 128-133 with their row colors, in all three thirds
sub LoadTiles:
  Dst16 = 1024
  copy ShiftPat count 288 to vram.pattern + Dst16
  Dst16 += 288
  copy ShiftPat count 288 to vram.pattern + Dst16
  Dst16 = 1024
  for J = 0 to 2
    copy ShiftCol count 288 to vram.color + Dst16
    Dst16 += 288
    copy ShiftCol count 288 to vram.color + Dst16
    Dst16 += 1760
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 11
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub TitlePage:
  nmi on
  ZShow = 0
  call asm ZFlip
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  cls
  backdrop light blue
  print at 7,2, "RESCUE OF BLONDELL"
  print at 2,4, "GOAL: FLY YOUR MAGIC CARPET"
  print at 2,5, "TO THE SORCERER'S TOWER,"
  print at 2,6, "PICK UP THE PRINCESS AND"
  print at 2,7, "BRING HER BACK TO YOUR"
  print at 2,8, "BASE AT THE FAR LEFT."
  print at 2,10, "THE BIRDS HOME IN ON YOU."
  print at 2,11, "FIRE THROWS LIGHTNING:"
  print at 2,12, "10 POINTS A BIRD. EVERY HIT"
  print at 2,13, "COSTS MAGIC. THE BONUS"
  print at 2,14, "SHRINKS AS TIME PASSES."
  print at 2,17, "BIRDS"
  print at 10,17, "1"
  print at 10,18, "2"
  print at 10,19, "3"
  print at 16,17, "HIGH"
  print HighScore at 21,17
  Choice = Birds
  wait no fire
  choose menu 1 to 3 into Choice cursor $3E at 8,17 step 1
  Birds = Choice
  wait no fire
  return
end sub

sub EditorialPage:
  ZShow = 0
  call asm ZFlip
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  backdrop white
  cls
  print at 7,1, "RESCUE OF BLONDELL"
  print at 7,3, "BY GRANT ALBRECHT"
  print at 5,4, "COMPUTE! JANUARY 1985"
  print at 2,6, "MACHINE LANGUAGE FOR THE"
  print at 2,7, "ATARI, 64 AND VIC-20, WITH"
  print at 2,8, "SMOOTH SCROLLING AND"
  print at 2,9, "INTELLIGENT BIRDS."
  print at 2,11, "THE CODE COULD NOT BE READ"
  print at 2,12, "FROM THE SCANS: THIS GAME"
  print at 2,13, "WAS REBUILT FROM THE"
  print at 2,14, "ARTICLE AND ITS PICTURES,"
  print at 2,15, "WITH SMOOTH SCROLLING DONE"
  print at 2,16, "IN SOFTWARE."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  return
end sub

' Sprites (16 x 16): genie, carpet, bird (two wingbeats), princess, bolt,
' burst (drawn for this port)
data SpritePat bytes
  $03,$07,$02,$03,$01,$0F,$1B,$33
  $03,$07,$00,$00,$00,$00,$00,$00
  $C0,$E0,$40,$C0,$80,$F0,$D8,$CC
  $C0,$E0,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
