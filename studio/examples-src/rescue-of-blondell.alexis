asm {
; ---------------------------------------------------------------------------
; Software scrolling helpers. Two name tables ($1800 and $1C00) and two
; ranges of pair tiles (128-163 and 164-199): the hidden table and its
; tile range are rewritten, then one register write shows them, so the
; screen never shows a half-drawn step.
; ---------------------------------------------------------------------------

; Kind of world column C at screen row B (0 sky, 1 brick, 2 hill top,
; 3 tower stone, 4 battlements, 5 landing pad), in A
ZKind:
    push de
    push hl
    ld e,c
    ld d,0
    ld hl,AMY_UVAR_H
    add hl,de
    ld a,21
    sub (hl)
    ld d,a
    ld a,b
    cp d
    jr nc,zk_solid
    xor a
    jr zk_out
zk_solid:
    ld e,1
    jr nz,zk_t1
    ld e,2
zk_t1:
    ld a,c
    cp 87
    jr c,zk_pad
    cp 90
    jr nc,zk_pad
    ld e,3
    ld a,b
    cp d
    jr nz,zk_done
    ld e,4
    jr zk_done
zk_pad:
    ld a,c
    cp 4
    jr nc,zk_done
    ld a,b
    cp d
    jr nz,zk_done
    ld e,5
zk_done:
    ld a,e
zk_out:
    pop hl
    pop de
    ret

; Rows 3-20 of the name table at ZBase, from world column Cam, tiles
; ZRange + 6 x left kind + right kind
ZNames:
    ld b,3
zn_row:
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    inc hl
    inc hl
    ld de,(AMY_UVAR_ZBase)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Cam)
    ld c,a
    call ZKind
    ld (AMY_UVAR_ZKL),a
    ld a,28
    ld (AMY_UVAR_ZCnt),a
zn_col:
    inc c
    call ZKind
    ld e,a
    ld a,(AMY_UVAR_ZKL)
    ld d,a
    add a,a
    add a,d
    add a,a
    add a,e
    ld d,a
    ld a,(AMY_UVAR_ZRange)
    add a,d
    out ($BE),a
    ld a,e
    ld (AMY_UVAR_ZKL),a
    ld a,(AMY_UVAR_ZCnt)
    dec a
    ld (AMY_UVAR_ZCnt),a
    jr nz,zn_col
    inc b
    ld a,b
    cp 21
    jr c,zn_row
    ret

; Shows name table ZShow (0: $1800, 1: $1C00) and points the text
; routines at it
ZSharePatterns:
    ld bc,$0400
    jp WRITE_REGISTER

ZFlip:
    ld a,(AMY_UVAR_ZShow)
ZShadowA:
    ld hl,$1800
    ld b,6
    or a
    jr z,zf_set
    ld hl,$1C00
    ld b,7
zf_set:
    ld (VDP_NAME_SHADOW),hl
    ld a,(AMY_UVAR_ZOnlyShadow)
    or a
    ret nz
    ld a,b
    out ($BF),a
    ld a,$82
    out ($BF),a
    ret

; Points the text routines at table A (0 or 1) without showing it
ZShadow:
    push af
    ld a,1
    ld (AMY_UVAR_ZOnlyShadow),a
    pop af
    call ZShadowA
    xor a
    ld (AMY_UVAR_ZOnlyShadow),a
    ret
