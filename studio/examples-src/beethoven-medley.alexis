hold:
  wait
  Animate
  if joypad(1).fire then goto medley
  goto hold

' Waits until Target frames have passed since the music started
sub WaitUntil:
wait_loop:
  Elapsed = frame
  Elapsed -= StartFrame
  if Elapsed >= 336 then StarsLit = true
  if Elapsed >= Target then return
  wait
  Animate
  goto wait_loop
end sub

' Adaptation (the TI picture is static): notes bob gently, every other one
' in opposite phase; blossoms sway; stars twinkle once they are lit
sub Animate:
  inc NoteTick
  if NoteTick >= 24 then
    NoteTick = 0
    inc NotePhase
    if NotePhase = 4 then NotePhase = 0
    select case NotePhase
      case 1
        copy NoteUp count 8 to vram.pattern + 1536
        copy NoteDown count 8 to vram.pattern + 1544
      case 3
        copy NoteDown count 8 to vram.pattern + 1536
        copy NoteUp count 8 to vram.pattern + 1544
      case else
        copy NoteMid count 8 to vram.pattern + 1536
        copy NoteMid count 8 to vram.pattern + 1544
    end select
  end if
  inc BloomTick
  if BloomTick >= 40 then
    BloomTick = 0
    toggle BloomSway
    if BloomSway then
      copy BlossomB count 32 to vram.pattern + 1472
    else
      copy BlossomA count 32 to vram.pattern + 1472
    end if
  end if
  if StarsLit then
    inc StarTick
    if StarTick >= 16 then
      StarTick = 0
      toggle StarGlow
      if StarGlow then
        vpoke vram.color + 5, $B2
      else
        vpoke vram.color + 5, $F2
      end if
    end if
  end if
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  set text colors 1 count 32
  backdrop 15
  cls
  print at 8,1, "BEETHOVEN MEDLEY"
  print at 6,2, "ORIGINAL TITLE: LUDWIG"
  print at 9,4, "BY C. REGENA"
  print at 3,5, "COMPUTE! OCTOBER 1983"
  print at 2,8, "FOUR FAMILIAR PIECES, PLAYED"
  print at 2,9, "WITH CALL SOUND WHILE THE"
  print at 2,10, "PICTURE IS DRAWN BETWEEN"
  print at 2,11, "THE NOTES:"
  print at 4,13, "ODE TO JOY"
  print at 4,14, "ECOSSAISES"
  print at 4,15, "FUR ELISE"
  print at 4,16, "FIFTH SYMPHONY, ANDANTE"
  print at 2,18, "WATCH THE TREE GROW, THEN"
  print at 2,19, "PRESS FIRE TO PLAY AGAIN."
  print at 4,22, "PRESS FIRE TO BEGIN"
  pause until press
  wait no fire
  return
end sub

