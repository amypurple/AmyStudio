; GetCh: V = name-table code at (GcX,GcY). Reads the VDP directly so it
; does not depend on the BIOS READ_VRAM count convention. Call with NMI off.
GetCh:
    ld a,(AMY_UVAR_GcY)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_GcX)
    add a,l
    ld l,a
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    nop
    nop
    in a,($BE)
    ld (AMY_UVAR_V),a
    ret

; VCopy: copy VCnt bytes from HL (ROM/RAM) to VRAM VDst, direct to the VDP.
; Independent of the BIOS WRITE_VRAM count convention. Call with NMI off.
VCopy:
    push hl
    ld de,(AMY_UVAR_VDst)
    ld a,e
    out ($BF),a
    ld a,d
    and $3F
    or $40
    out ($BF),a
    pop hl
    ld bc,(AMY_UVAR_VCnt)
VCopyLoop:
    ld a,(hl)
    out ($BE),a
    inc hl
    dec bc
    ld a,b
    or c
    jr nz,VCopyLoop
    ret
}
