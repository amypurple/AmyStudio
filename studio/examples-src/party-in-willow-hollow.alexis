  tile screen
  set sound table WhSoundTable areas 4
  sprites 16x16
  nmi off
  VDst = $3800
  VCnt = SprBytes
  call asm VCopy with hl = address of SpritePat
  HideSprites
  screen on
  EditorialPage

title:
  TitlePage

new_party:
  for G = 0 to 7
    Gift[G] = 0
  next
  GiftN = 0
  Score = 0
  Stage = 0

party_map:
  MapPage
  if Stage = 0 then TreasureHunt
  if Stage = 1 then HideAndSeek
  if Stage = 2 then BalloonPop
  if Stage = 3 then MusicalChairs
  if Stage = 4 then PinTail
  if Stage = 5 then PassParcel
  if Stage = 6 then SackRace
  if Stage = 7 then Fireflies
  if Stage = 8 then
    Finale
    goto title
  end if
  if Won = 1 then
    Gift[Stage] = 1
    inc GiftN
  end if
  ResultCard
  inc Stage
  goto party_map

' ---------------------------------------------------------------------------

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' Pip walks inside a box (X from Hp to Hq, Y from 24 to 152)
sub WalkPip:
  V = 0
  if Lf1 = 1 then
    if Px > Hp then
      dec Px
      V = 1
    end if
  end if
  if Rt1 = 1 then
    if Px < Hq then
      inc Px
      V = 1
    end if
  end if
  if Up1 = 1 then
    if Py > Vmin then
      dec Py
      V = 1
    end if
  end if
  if Dn1 = 1 then
    if Py < 150 then
      inc Py
      V = 1
    end if
  end if
  if V = 1 then
    inc AnimT
    if AnimT >= 8 then
      AnimT = 0
      Anim = Anim ^ 1
      play sound SndStep
    end if
  end if
  return
end sub

sub DrawPip:
  Y = Py - 1
  V = SPip1
  if Anim = 1 then V = SPip2
  set sprite 0 to Y,Px,V,9
  V = SPipw1
  if Anim = 1 then V = SPipw2
  set sprite 1 to Y,Px,V,15
  return
end sub

' Guest G's sprite pattern and colour: K (pattern), C (colour)
sub GuestLook:
  N = Tick & 16
  V = GT[G]
  if V = 0 then
    K = SOwl1
    C = 11
  elseif V = 1 then
    K = SHedge1
    C = 10
  elseif V = 2 then
    K = SCoon1
    C = 14
  elseif V = 3 then
    K = SBunny1
    C = 15
  else
    K = SBear1
    C = 6
  end if
  if N > 0 then K += 4
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' A clean screen with the tiles loaded, the display off (call ShowScreen after)
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  Vmin = 24
  HideSprites
  fill mode 2 text color with $F0
  LoadTiles
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    VDst = Dst16
    VCnt = NTiles8
    call asm VCopy with hl = address of TilePat
    VDst = Dst16 + $2000
    call asm VCopy with hl = address of TileCol
    Dst16 += 2048
  next
  return
end sub

sub FillGrass:
  for Y = 3 to 20
    for X = 2 to 29
      V = X + Y
      V = V & 3
      if V = 0 then
        put char TGrass2 at X,Y
      else
        put char TGrass at X,Y
      end if
    next
  next
  return
end sub

' PutBig: a picture of BigW x BigH tiles, numbered row by row from BigT
sub PutBig:
  V = BigT
  for R = 0 to 15
    if R < BigH then
      Y = BigY + R
      for C = 0 to 3
        if C < BigW then
          X = BigX + C
          put char V at X,Y
          inc V
        end if
      next
    end if
  next
  return
end sub

' ShapePath: give each path cell the tile matching its path neighbours
sub ShapePath:
  for Y = 3 to 20
    for X = 2 to 29
      GcX = X
      GcY = Y
      call asm GetCh
      if V >= TPth0 then
        if V <= TPth15 then
          K = 0
          GcY = Y - 1
          IsPath
          if N = 1 then K += 1
          GcX = X + 1
          GcY = Y
          IsPath
          if N = 1 then K += 2
          GcX = X
          GcY = Y + 1
          IsPath
          if N = 1 then K += 4
          GcX = X - 1
          GcY = Y
          IsPath
          if N = 1 then K += 8
          V = TPth0 + K
          put char V at X,Y
        end if
      end if
    next
  next
  return
end sub

sub IsPath:
  call asm GetCh
  N = 0
  if V >= TPth0 then
    if V <= TPth15 then N = 1
  end if
  return
end sub

' Birds: two far-off birds drift across the sky
sub Birds:
  V = Tick & 1
  if V = 0 then
    inc BdX
  end if
  K = SBird1
  V = Tick & 8
  if V > 0 then K = SBird2
  V = Tick & 32
  Y = BdY
  if V > 0 then inc Y
  set sprite 8 to Y,BdX,K,1
  return
end sub

sub Bunting:
  for X = 2 to 29
    V = X & 1
    if V = 0 then
      put char TBunting at X,2
    else
      put char TBunting2 at X,2
    end if
  next
  return
end sub

sub ShowTimer:
  print at 24,1, "TIME"
  NumU = Tm
  print at 28,1, digits$(NumU, 2)
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,22
  return
end sub

' One second of the countdown: Tm reaches 0 at the end
sub Clock:
  inc TmT
  if TmT >= 60 then
    TmT = 0
    if Tm > 0 then dec Tm
    ShowTimer
    if Tm < 6 then play sound SndTick
  end if
  return
end sub

' ---------------------------------------------------------------------------
' The party map: the stations along the path, the presents so far

sub MapPage:
  NewScreen
  backdrop dark green
  FillGrass
  Bunting
  print at 5,1, "PIP'S BIRTHDAY PARTY"
  ' the path between the stations
  for G = 0 to 7
    X = StaC[G]
    Y = StaR[G]
    V = G + 1
    C = StaC[V]
    R = StaR[V]
    while X <> C
      if X < C then
        inc X
      else
        dec X
      end if
      put char TPth15 at X,Y
    end while
    while Y <> R
      if Y < R then
        inc Y
      else
        dec Y
      end if
      put char TPth15 at X,Y
    end while
  next
  ShapePath
  for G = 0 to 8
    X = StaC[G]
    Y = StaR[G]
    V = TStation + G
    if G < Stage then V = TDone
    if G = 8 then V = TCakeic
    put char V at X,Y
  next
  ' bushes and a pond around the garden
  BigT = TBush00
  BigW = 2
  BigH = 2
  for G = 0 to 5
    BigX = BushC[G]
    BigY = BushR[G]
    PutBig
  next
  for Y = 10 to 11
    fill TPond count 3 at 11,Y
  next
  ' the presents
  print at 3,20, "PRESENTS:"
  for G = 0 to 7
    X = G * 2
    X += 13
    V = TGiftoff
    if Gift[G] = 1 then V = TGift
    put char V at X,20
  next
  ClearMsg
  if Stage = 0 then print at 2,22, "1. TREASURE HUNT"
  if Stage = 1 then print at 2,22, "2. HIDE AND SEEK"
  if Stage = 2 then print at 2,22, "3. BALLOON POP"
  if Stage = 3 then print at 2,22, "4. MUSICAL CHAIRS"
  if Stage = 4 then print at 2,22, "5. PIN THE TAIL"
  if Stage = 5 then print at 2,22, "6. PASS THE PARCEL"
  if Stage = 6 then print at 2,22, "7. SACK RACE"
  if Stage = 7 then print at 2,22, "8. FIREFLIES AT DUSK"
  if Stage = 8 then print at 2,22, "THE CAKE!"
  ShowScreen
  ' Pip walks from the last station to this one
  G = 0
  if Stage > 0 then G = Stage - 1
  X = StaC[G]
  X *= 8
  Y = StaR[G]
  Y *= 8
  Px = X - 4
  Py = Y - 16
  X = StaC[Stage]
  X *= 8
  C = X - 4
  Y = StaR[Stage]
  Y *= 8
  R = Y - 16
  Tm = 0
map_walk:
  Frame1
  V = 0
  if Px < C then
    inc Px
    V = 1
  elseif Px > C then
    dec Px
    V = 1
  elseif Py < R then
    inc Py
    V = 1
  elseif Py > R then
    dec Py
    V = 1
  end if
  if V = 1 then
    inc AnimT
    if AnimT >= 8 then
      AnimT = 0
      Anim = Anim ^ 1
      play sound SndStep
    end if
    DrawPip
    update sprites
    goto map_walk
  end if
  DrawPip
  update sprites
  print at 17,21, "PRESS BUTTON"
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  play sound SndPick
  return
end sub

sub ResultCard:
  HideSprites
  ClearMsg
  if Won = 1 then
    print at 2,22, "YOU WIN A PRESENT!"
    play sound SndWin
  else
    print at 2,22, "NO PRESENT THIS TIME."
    play sound SndAww
  end if
  Rearm
  wait 120 frames
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' 1. Treasure Hunt: five favours buried in the garden

sub TreasureHunt:
  NewScreen
  backdrop dark green
  FillGrass
  print at 2,1, "TREASURE HUNT"
  ' flower beds (no digging there)
  for G = 1 to 14
    Mix += 57
    X = random(0, 25)
    X += Mix
    X = X & 31
    if X > 26 then X -= 8
    X += 2
    Y = random(0, 15)
    Y += Mix
    Y = Y & 15
    Y += 4
    V = TFlower
    N = G & 1
    if N = 1 then V = TFlowery
    put char V at X,Y
  next
  ' the favours: grass squares away from the flowers
  for G = 0 to 4
fav_again:
    Mix += 31
    X = random(0, 25)
    X += Mix
    X = X & 31
    if X > 26 then goto fav_again
    X += 3
    Y = random(0, 15)
    Y += Mix
    Y = Y & 15
    Y += 4
    GcX = X
    GcY = Y
    call asm GetCh
    if V = TFlower then goto fav_again
    if V = TFlowery then goto fav_again
    Fav[G] = X
    FavF[G] = Y
  next
  print at 2,22, "DIG WITH THE BUTTON"
  Tm = 60
  TmT = 0
  ShowTimer
  ShowFound
  Px = 120
  Py = 140
  Hp = 16
  Hq = 224
  ' the raccoon, who buried them, wanders
  GT[0] = 2
  GX[0] = 40
  GY[0] = 40
  GS[0] = 1
  Got = 0
  Cool = 0
  Last = 99
  ShowScreen
th_loop:
  Frame1
  ReadPad
  WalkPip
  Clock
  if Cool > 0 then dec Cool
  ' the warmer / colder beep, every 40 frames
  V = Tick & 63
  if V = 0 then Hint
  if Press = 1 then
    if Cool = 0 then Dig
  end if
  ' the raccoon
  N = Tick & 1
  if N = 0 then
    V = GS[0]
    if V = 0 then inc GX[0]
    if V = 1 then dec GY[0]
    if V = 2 then dec GX[0]
    if V = 3 then inc GY[0]
    if GX[0] < 20 then GS[0] = 0
    if GX[0] > 220 then GS[0] = 2
    if GY[0] < 30 then GS[0] = 3
    if GY[0] > 145 then GS[0] = 1
    V = Tick & 127
    if V = 0 then
      Mix += 13
      V = Mix & 3
      GS[0] = V
    end if
  end if
  DrawPip
  G = 0
  GuestLook
  Y = GY[0] - 1
  X = GX[0]
  set sprite 2 to Y,X,K,C
  update sprites
  if Got = 5 then goto th_done
  if Tm = 0 then goto th_done
  goto th_loop
th_done:
  Won = 0
  if Got >= 3 then Won = 1
  NumU = Got * 20
  Score += NumU
  Rearm
  wait 40 frames
  nmi off
  return
end sub

sub ShowFound:
  print at 16,1, "FOUND"
  NumU = Got
  print at 22,1, digits$(NumU, 1)
  return
end sub

' The square under Pip's feet: C, R
sub PipSquare:
  C = Px + 8
  C = C >> 3
  R = Py + 12
  R = R >> 3
  return
end sub

sub Dig:
  Cool = 20
  PipSquare
  GcX = C
  GcY = R
  call asm GetCh
  if V = TFlower then
    play sound SndBump
    return
  end if
  if V = TFlowery then
    play sound SndBump
    return
  end if
  if V = THole then
    play sound SndBump
    return
  end if
  if V = THoleb then
    play sound SndBump
    return
  end if
  play sound SndDig
  N = 0
  for G = 0 to 4
    if Fav[G] = C then
      if FavF[G] = R then N = 1
      if FavF[G] = R then Fav[G] = 99
    end if
  next
  if N = 1 then
    put char THoleb at C,R
    inc Got
    ShowFound
    play sound SndFound
    ClearMsg
    print at 2,22, "A PARTY FAVOUR!"
    X = C * 8
    Y = R * 8
    Y -= 9
    set sprite 3 to Y,X,SFavour,11
    update sprites
    Rearm
    wait 30 frames
    nmi off
    set sprite 3 to 192,0,0,0
  else
    put char THole at C,R
  end if
  return
end sub

' Warmer or colder: the nearest favour left
sub Hint:
  PipSquare
  Best = 99
  for G = 0 to 4
    X = Fav[G]
    if X < 40 then
      Y = FavF[G]
      if X > C then
        Dx = X - C
      else
        Dx = C - X
      end if
      if Y > R then
        Dy = Y - R
      else
        Dy = R - Y
      end if
      Md = Dx + Dy
      if Md < Best then Best = Md
    end if
  next
  if Best = 99 then return
  if Best <= 1 then
    play sound SndHot
  elseif Best <= 4 then
    play sound SndWarm
  elseif Best <= 9 then
    play sound SndCool
  else
    play sound SndCold
  end if
  ClearMsg
  if Best < Last then print at 2,22, "WARMER..."
  if Best > Last then print at 2,22, "COLDER..."
  if Best = Last then print at 2,22, "HMM..."
  if Best <= 1 then print at 2,22, "VERY HOT!"
  Last = Best
  return
end sub

' ---------------------------------------------------------------------------
' 2. Hide and Seek: four friends in the burrow

sub HideAndSeek:
  NewScreen
  backdrop dark red
  for Y = 3 to 20
    fill TFloor count 28 at 2,Y
  next
  fill TWall count 28 at 2,3
  fill TWall count 28 at 2,20
  for Y = 3 to 20
    put char TWall at 2,Y
    put char TWall at 29,Y
  next
  for Y = 10 to 13
    fill TRug count 8 at 12,Y
  next
  for X = 7 to 25 step 6
    put char TWallwin at X,3
    put char TWallwin at X,20
  next
  for G = 0 to 7
    X = SpotC[G]
    Y = SpotR[G]
    K = SpotK[G]
    V = K * 4
    V += TBed00
    put char V at X,Y
    inc V
    C = X + 1
    put char V at C,Y
    inc V
    R = Y + 1
    put char V at X,R
    inc V
    put char V at C,R
  next
  print at 2,1, "HIDE AND SEEK"
  ' four friends hide in four of the eight places
  for G = 0 to 3
    GT[G] = G
    Found[G] = 0
hide_again:
    Mix += 37
    V = random(0, 7)
    V += Mix
    V = V & 7
    N = 0
    for J = 0 to 3
      if J < G then
        if HideAt[J] = V then N = 1
      end if
    next
    if N = 1 then goto hide_again
    HideAt[G] = V
  next
  Got = 0
  ShowFound
  Tm = 60
  TmT = 0
  ShowTimer
  ClearMsg
  print at 2,22, "SEARCH WITH THE BUTTON"
  Px = 120
  Py = 88
  Hp = 24
  Hq = 216
  Cool = 0
  ShowScreen
hs_loop:
  Frame1
  ReadPad
  WalkPip
  Clock
  if Cool > 0 then dec Cool
  ' a giggle now and then, louder when Pip is near
  V = Tick & 127
  if V = 0 then Giggle
  if Press = 1 then
    if Cool = 0 then Search
  end if
  DrawPip
  ' found friends stand beside their hiding place; the bunny's ears peek out
  for G = 0 to 3
    J = G + 2
    set sprite J to 192,0,0,0
    V = HideAt[G]
    X = SpotC[V]
    X *= 8
    Y = SpotR[V]
    Y *= 8
    if Found[G] = 1 then
      X += 16
      Y -= 1
      GuestLook
      set sprite J to Y,X,K,C
    elseif G = 3 then
      N = Tick & 127
      if N < 24 then
        Y -= 10
        set sprite J to Y,X,SEars,15
      end if
    end if
  next
  update sprites
  if Got = 4 then goto hs_done
  if Tm = 0 then goto hs_done
  goto hs_loop
hs_done:
  Won = 0
  if Got = 4 then Won = 1
  NumU = Got * 25
  Score += NumU
  Rearm
  wait 40 frames
  nmi off
  return
end sub

' The hiding place next to Pip: Bi (255: none)
sub NearSpot:
  Bi = 255
  for G = 0 to 7
    X = SpotC[G]
    X *= 8
    Y = SpotR[G]
    Y *= 8
    if Px + 16 >= X then
      if Px <= X + 16 then
        if Py + 16 >= Y then
          if Py <= Y + 20 then Bi = G
        end if
      end if
    end if
  next
  return
end sub

sub Search:
  Cool = 20
  NearSpot
  if Bi = 255 then return
  ClearMsg
  for G = 0 to 3
    if HideAt[G] = Bi then
      if Found[G] = 0 then
        Found[G] = 1
        inc Got
        ShowFound
        play sound SndGiggle
        if G = 0 then print at 2,22, "FOUND THE OWL!"
        if G = 1 then print at 2,22, "FOUND THE HEDGEHOG!"
        if G = 2 then print at 2,22, "FOUND THE RACCOON!"
        if G = 3 then print at 2,22, "FOUND THE BUNNY!"
        return
      end if
    end if
  next
  play sound SndBump
  print at 2,22, "NOBODY HERE."
  return
end sub

sub Giggle:
  ' a friend still hiding
  Mix += 19
  for J = 0 to 3
    G = Mix + J
    G = G & 3
    if Found[G] = 0 then goto gg_found
  next
  return
gg_found:
  V = HideAt[G]
  X = SpotC[V]
  X *= 8
  Y = SpotR[V]
  Y *= 8
  if X > Px then
    Dx = X - Px
  else
    Dx = Px - X
  end if
  if Y > Py then
    Dy = Y - Py
  else
    Dy = Py - Y
  end if
  Md = Dx >> 1
  N = Dy >> 1
  Md += N
  if Md < 40 then
    play sound SndGiggle
  elseif Md < 80 then
    play sound SndGiggle2
  else
    play sound SndGiggle3
  end if
  return
end sub

' ---------------------------------------------------------------------------
' 3. Balloon Pop: the owl lets balloons go from the big branch

sub BalloonPop:
  NewScreen
  backdrop light blue
  for Y = 3 to 18
    fill TSky count 28 at 2,Y
  next
  for Y = 3 to 20
    put char TTrunk at 2,Y
    put char TTrunk at 3,Y
  next
  fill TLeaves count 6 at 2,3
  fill TLeaves count 6 at 2,4
  put char TLeafr at 8,3
  fill TDroop count 6 at 2,5
  fill TBranch count 22 at 8,5
  BigT = TCloud00
  BigW = 4
  BigH = 2
  BigX = 10
  BigY = 9
  PutBig
  BigX = 22
  BigY = 14
  PutBig
  for Y = 19 to 20
    for X = 4 to 29
      put char TGrass at X,Y
    next
  next
  print at 2,1, "BALLOON POP"
  for G = 0 to 3
    BlT[G] = 0
    BlK[G] = G * 25
  next
  Pts = 0
  ShowPts
  Tm = 45
  TmT = 0
  ShowTimer
  Px = 120
  Py = 136
  Hp = 32
  Hq = 224
  AcOn = 0
  Bad = 0
  BadT = 0
  NewBad
  ShowScreen
  BdY = 70
bp_loop:
  Frame1
  ' every few seconds the owl changes which colour must not be popped
  V = Tick & 1
  if V = 0 then inc BadT
  if BadT >= 250 then
    BadT = 0
    NewBad
  end if
  ReadPad
  Up1 = 0
  Dn1 = 0
  WalkPip
  Clock
  ' throw an acorn straight up
  if Press = 1 then
    if AcOn = 0 then
      AcOn = 1
      Ax = Px
      Ay = Py - 8
      play sound SndThrow
    end if
  end if
  if AcOn = 1 then
    if Ay < 30 then
      AcOn = 0
    else
      Ay -= 4
    end if
  end if
  MoveBalloons
  DrawPip
  ' the owl on the branch
  G = 0
  GT[0] = 0
  GuestLook
  Y = 23
  if Shout > 0 then
    dec Shout
    C = Bad
    V = Tick & 8
    if V > 0 then Y = 20
  end if
  set sprite 2 to Y,200,K,C
  if AcOn = 1 then
    Y = Ay - 1
    set sprite 3 to Y,Ax,SAcorn,10
  else
    set sprite 3 to 192,0,0,0
  end if
  for G = 0 to 3
    J = G + 4
    V = BlT[G]
    if V = 0 then
      set sprite J to 192,0,0,0
    else
      Y = BlY[G] - 1
      C = BlC[G]
      if V = 2 then
        X = BlX[G]
        set sprite J to Y,X,SPop,15
      else
        X = BlX[G]
        set sprite J to Y,X,SBalloon,C
      end if
    end if
  next
  Birds
  update sprites
  if Tm = 0 then goto bp_done
  goto bp_loop
bp_done:
  Won = 0
  if Pts >= 15 then Won = 1
  NumU = Pts * 5
  Score += NumU
  Rearm
  wait 40 frames
  nmi off
  return
end sub

sub ShowPts:
  print at 15,1, "POPPED"
  NumU = Pts
  print at 21,1, digits$(NumU, 2)
  return
end sub

' BlT: 0 none, 1 floating, 2 popping; BlK: wait / pop timer
' NewBad: the owl hoots a new colour not to pop (never the same twice)
sub NewBad:
nb_again:
  Mix += 41
  N = random(0, 5)
  N += Mix
  while N >= 6
    N -= 6
  end while
  V = BalCol[N]
  if V = Bad then goto nb_again
  Bad = V
  Shout = 120
  play sound SndCool
  ClearMsg
  print at 2,22, "OWL: DON'T POP"
  if Bad = 8 then print at 17,22, "RED!"
  if Bad = 4 then print at 17,22, "BLUE!"
  if Bad = 13 then print at 17,22, "PURPLE!"
  if Bad = 12 then print at 17,22, "GREEN!"
  if Bad = 11 then print at 17,22, "YELLOW!"
  if Bad = 15 then print at 17,22, "WHITE!"
  return
end sub

sub MoveBalloons:
  for G = 0 to 3
    V = BlT[G]
    if V = 0 then
      if BlK[G] > 0 then
        dec BlK[G]
      else
        Mix += 29
        X = random(0, 180)
        X += Mix
        if X > 190 then X -= 70
        X += 34
        BlX[G] = X
        BlY[G] = 150
        BlT[G] = 1
        ' colours; one in four is the forbidden one
        N = Mix & 7
        if N >= 6 then
          BlC[G] = Bad
        else
          BlC[G] = BalCol[N]
        end if
      end if
    elseif V = 1 then
      ' rise: faster ones now and then
      N = Tick & 1
      if N = 0 then dec BlY[G]
      N = Tick & 3
      if N = 0 then dec BlY[G]
      if BlY[G] < 32 then
        BlT[G] = 0
        BlK[G] = 30
      end if
      ' the acorn
      if AcOn = 1 then
        X = BlX[G]
        Y = BlY[G]
        if Ax + 12 >= X then
          if Ax <= X + 12 then
            if Ay + 8 >= Y then
              if Ay <= Y + 12 then
                AcOn = 0
                BlT[G] = 2
                BlK[G] = 12
                play sound SndPop
                if BlC[G] = Bad then
                  ' the forbidden colour: three back
                  if Pts >= 3 then
                    Pts -= 3
                  else
                    Pts = 0
                  end if
                  play sound SndAww
                else
                  inc Pts
                end if
                ShowPts
              end if
            end if
          end if
        end if
      end if
    else
      dec BlK[G]
      if BlK[G] = 0 then
        BlT[G] = 0
        BlK[G] = 20
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' 4. Musical Chairs round the stump

sub MusicalChairs:
  NewScreen
  backdrop dark green
  FillGrass
  print at 2,1, "MUSICAL CHAIRS"
  for X = 2 to 29
    V = X & 1
    if V = 0 then
      put char TFlower at X,3
      put char TFlowery at X,20
    else
      put char TFlowery at X,3
      put char TFlower at X,20
    end if
  next
  ' the stump in the middle
  put char TStump00 at 14,10
  put char TStump01 at 15,10
  put char TStump02 at 16,10
  put char TStump10 at 14,11
  put char TStump11 at 15,11
  put char TStump12 at 16,11
  Players = 5
  for G = 0 to 3
    GT[G] = G + 1
    GS[G] = 1
  next
  ShowScreen
mc_round:
  Stools = Players - 1
  ' the stools for this round
  for G = 0 to 7
    StoolOn[G] = 0
    X = StoolC[G]
    Y = StoolR[G]
    C = X + 1
    R = Y + 1
    V = TGrass
    if G < Stools then V = 255
    if V = 255 then
      put char TMush00 at X,Y
      put char TMush01 at C,Y
      put char TMush10 at X,R
      put char TMush11 at C,R
    else
      put char TGrass at X,Y
      put char TGrass at C,Y
      put char TGrass at X,R
      put char TGrass at C,R
    end if
  next
  ' everyone walks round
  Ang = 0
  Music = 1
  Mix += 41
  V = random(0, 120)
  V += Mix
  V = V & 127
  MusT = V + 150
  ClearMsg
  print at 2,22, "WALK... AND LISTEN"
  play sound SndTuneA
  play sound SndTuneB
  Seated = 0
  for G = 0 to 7
    StoolBy[G] = 255
  next
  for G = 0 to 3
    GS[G] = GS[G] & 1
  next
mc_walk:
  Frame1
  ReadPad
  N = Tick & 3
  if N = 0 then
    inc Ang
    Ang = Ang & 31
  end if
  ' Pip is on the circle with the others
  Px = CirX[Ang]
  Py = CirY[Ang]
  inc AnimT
  if AnimT >= 8 then
    AnimT = 0
    Anim = Anim ^ 1
  end if
  J = 0
  for G = 0 to 3
    if GS[G] = 1 then
      inc J
      V = J * 32
      V = V / Players
      V += Ang
      V = V & 31
      GX[G] = CirX[V]
      GY[G] = CirY[V]
    end if
  next
  DrawChairs
  dec MusT
  if MusT > 0 then goto mc_walk
  ' the music stops!
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  play sound SndStop
  ClearMsg
  print at 2,22, "SIT DOWN!"
  ' each friend picks a stool, after a moment that gets shorter
  for G = 0 to 3
    if GS[G] = 1 then
      Mix += 23
      V = random(0, 20)
      V += Mix
      V = V & 31
      N = 6 - Players
      N *= 4
      if V > N then V -= N
      V += 6
      GT[G] = GT[G] & 7
      HideAt[G] = V
    end if
  next
  Out = 0
  Hp = 16
  Hq = 224
mc_rush:
  Frame1
  ReadPad
  if Out = 0 then
    WalkPip
    ' sitting: on a free stool
    for G = 0 to 7
      if G < Stools then
        if StoolOn[G] = 0 then
          X = StoolX[G]
          Y = StoolY[G]
          if Px + 6 >= X then
            if Px <= X + 6 then
              if Py + 6 >= Y then
                if Py <= Y + 6 then
                  StoolOn[G] = 1
                  StoolBy[G] = 9
                  Px = X
                  Py = Y
                  inc Seated
                  Out = 2
                  play sound SndSit
                end if
              end if
            end if
          end if
        end if
      end if
    next
  end if
  for G = 0 to 3
    if GS[G] = 1 then
      if HideAt[G] > 0 then
        dec HideAt[G]
      else
        RushGuest
      end if
    end if
  next
  DrawChairs
  if Seated < Stools then goto mc_rush
  ' who is left standing?
  Rearm
  wait 50 frames
  nmi off
  if Out = 0 then
    ClearMsg
    print at 2,22, "PIP IS OUT!"
    play sound SndAww
    Won = 0
    Rearm
    wait 80 frames
    nmi off
    goto mc_end
  end if
  for G = 0 to 3
    if GS[G] = 1 then
      GS[G] = 0
      for J = 0 to 7
        if StoolBy[J] = G then GS[G] = 1
      next
      if GS[G] = 0 then
        ClearMsg
        if GT[G] = 1 then print at 2,22, "THE HEDGEHOG IS OUT!"
        if GT[G] = 2 then print at 2,22, "THE RACCOON IS OUT!"
        if GT[G] = 3 then print at 2,22, "THE BUNNY IS OUT!"
        if GT[G] = 4 then print at 2,22, "THE BEAR IS OUT!"
      end if
    end if
  next
  play sound SndPick
  Rearm
  wait 90 frames
  nmi off
  dec Players
  if Players > 1 then goto mc_round
  ClearMsg
  print at 2,22, "PIP WINS MUSICAL CHAIRS!"
  Won = 1
  Score += 100
  Rearm
  wait 60 frames
  nmi off
mc_end:
  HideSprites
  return
end sub

' Friend G runs to the nearest free stool
sub RushGuest:
  ' already seated?
  for J = 0 to 7
    if StoolBy[J] = G then return
  next
  Best = 255
  Bi = 255
  for J = 0 to 7
    if J < Stools then
      if StoolOn[J] = 0 then
        X = StoolX[J]
        Y = StoolY[J]
        if X > GX[G] then
          Dx = X - GX[G]
        else
          Dx = GX[G] - X
        end if
        if Y > GY[G] then
          Dy = Y - GY[G]
        else
          Dy = GY[G] - Y
        end if
        Md = Dx >> 1
        N = Dy >> 1
        Md += N
        if Md < Best then
          Best = Md
          Bi = J
        end if
      end if
    end if
  next
  if Bi = 255 then return
  X = StoolX[Bi]
  Y = StoolY[Bi]
  N = Tick & 3
  if N <> 0 then
    if GX[G] < X then inc GX[G]
    if GX[G] > X then dec GX[G]
    if GY[G] < Y then inc GY[G]
    if GY[G] > Y then dec GY[G]
  end if
  if GX[G] = X then
    if GY[G] = Y then
      StoolOn[Bi] = 1
      StoolBy[Bi] = G
      inc Seated
      play sound SndSit
    end if
  end if
  return
end sub

sub DrawChairs:
  DrawPip
  for G = 0 to 3
    J = G + 2
    if GS[G] = 1 then
      GuestLook
      Y = GY[G] - 1
      X = GX[G]
      set sprite J to Y,X,K,C
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' 5. Pin the Tail on the Bear: look where the tail goes, then do it
'    blindfolded, listening to the warmer / colder hints. Three tries.

sub PinTail:
  NewScreen
  backdrop dark blue
  for Y = 2 to 16
    fill TPaper count 28 at 2,Y
  next
  for Y = 17 to 20
    fill TFloor count 28 at 2,Y
  next
  for Y = 4 to 14
    fill TTable count 10 at 11,Y
  next
  for Y = 5 to 13
    fill TPoster count 8 at 12,Y
  next
  print at 2,1, "PIN THE TAIL"
  Pts = 0
  ShowPin
  Tries = 0
  Px = 40
  Py = 120
  Anim = 0
  DrawPip
  DrawBear
  update sprites
  ShowScreen
pt_try:
  ' the spot, for a moment
  ClearMsg
  print at 2,22, "THE TAIL GOES THERE..."
  K = 0
pt_look:
  Frame1
  inc K
  V = Tick & 8
  if V > 0 then
    set sprite 9 to TgY,TgX,STail,9
  else
    set sprite 9 to 192,0,0,0
  end if
  update sprites
  if K < 100 then goto pt_look
  set sprite 9 to 192,0,0,0
  ' spun round three times: the tail starts somewhere else
  Mix += 53
  X = random(0, 63)
  X += Mix
  X = X & 63
  if X < 32 then
    Ax = X + 88
  else
    Ax = X + 108
  end if
  Mix += 29
  Y = random(0, 63)
  Y += Mix
  Y = Y & 63
  Ay = Y + 40
  ClearMsg
  print at 2,22, "BLINDFOLDED! PIN IT!"
  play sound SndStop
  Tm = 12
  TmT = 0
  ShowTimer
  Cool = 0
pt_move:
  Frame1
  ReadPad
  Clock
  if Lf1 = 1 then
    if Ax > 80 then dec Ax
  end if
  if Rt1 = 1 then
    if Ax < 176 then inc Ax
  end if
  if Up1 = 1 then
    if Ay > 32 then dec Ay
  end if
  if Dn1 = 1 then
    if Ay < 120 then inc Ay
  end if
  inc Cool
  if Cool >= 24 then
    Cool = 0
    PinDist
    if Dd < 8 then
      play sound SndHot
    elseif Dd < 20 then
      play sound SndWarm
    elseif Dd < 40 then
      play sound SndCool
    else
      play sound SndCold
    end if
  end if
  update sprites
  if Press = 1 then goto pt_pin
  if Tm > 0 then goto pt_move
pt_pin:
  play sound SndPick
  set sprite 6 to Ay,Ax,STail,10
  PinDist
  N = 0
  if Dd < 28 then N = 1
  if Dd < 14 then N = 2
  if Dd < 6 then N = 3
  Pts += N
  ShowPin
  ClearMsg
  if N = 3 then print at 2,22, "SPOT ON!"
  if N = 2 then print at 2,22, "VERY CLOSE!"
  if N = 1 then print at 2,22, "CLOSE."
  if N = 0 then print at 2,22, "WAY OFF! THE GUESTS GIGGLE"
  if N = 0 then play sound SndGiggle
  ' where it should have gone
  set sprite 9 to TgY,TgX,STail,15
  update sprites
  Rearm
  wait 120 frames
  nmi off
  set sprite 6 to 192,0,0,0
  set sprite 9 to 192,0,0,0
  update sprites
  inc Tries
  if Tries < 3 then goto pt_try
  Won = 0
  if Pts >= 4 then Won = 1
  NumU = Pts * 15
  Score += NumU
  return
end sub

' Dd = how far the tail is from the spot (sum of both distances)
sub PinDist:
  if Ax > TgX then
    Dd = Ax - TgX
  else
    Dd = TgX - Ax
  end if
  if Ay > TgY then
    V = Ay - TgY
  else
    V = TgY - Ay
  end if
  Dd += V
  return
end sub

sub DrawBear:
  set sprite 2 to 63,112,SBig00,6
  set sprite 3 to 63,128,SBig01,6
  set sprite 4 to 79,112,SBig10,6
  set sprite 5 to 79,128,SBig11,6
  return
end sub

sub ShowPin:
  print at 15,1, "POINTS"
  NumU = Pts
  print at 22,1, digits$(NumU, 1)
  return
end sub

' ---------------------------------------------------------------------------
' 6. Pass the Parcel: when the music stops, be the quickest to grab it.
'    Pressing while the music still plays is a fumble. Five layers.

sub PassParcel:
  NewScreen
  backdrop dark green
  FillGrass
  for Y = 9 to 13
    fill TRug count 8 at 12,Y
  next
  print at 2,1, "PASS THE PARCEL"
  Got = 0
  ShowLayers
  for G = 0 to 4
    GT[G] = G
  next
  Px = 120
  Py = 137
  Anim = 0
  PcS = 0
  Tries = 0
  DrawParcel
  ShowScreen
pp_round:
  ClearMsg
  print at 2,22, "PASS IT ROUND..."
  play sound SndTuneA
  play sound SndTuneB
  Mix += 37
  V = random(0, 120)
  V += Mix
  V = V & 127
  MusT = V + 120
  Early = 0
  PcK = 0
pp_music:
  Frame1
  ReadPad
  if Press = 1 then
    if Early = 0 then
      Early = 1
      ClearMsg
      print at 2,22, "TOO EARLY! FUMBLED IT"
      play sound SndBump
    end if
  end if
  inc PcK
  if PcK >= 14 then
    PcK = 0
    inc PcS
    if PcS >= 6 then PcS = 0
  end if
  DrawParcel
  dec MusT
  if MusT > 0 then goto pp_music
  ' the music stops
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  play sound SndStop
  ClearMsg
  print at 2,22, "GRAB IT!"
  ' the quickest friend's reaction gets sharper every round
  Mix += 23
  V = random(0, 15)
  V += Mix
  V = V & 15
  Fast = V + 18
  N = Tries * 2
  Fast -= N
  Mix += 7
  V = Mix & 3
  if V = 3 then V = 4
  Who = V
  PcK = 0
pp_grab:
  Frame1
  ReadPad
  inc PcK
  if Early = 0 then
    if Press = 1 then goto pp_pip
  end if
  DrawParcel
  if PcK < Fast then goto pp_grab
  ' a friend was quicker
  PcS = Who
  if Who >= 3 then inc PcS
  DrawParcel
  ClearMsg
  G = Who
  GuestName
  print at 11,22, "UNWRAPS A LAYER"
  play sound SndAww
  goto pp_next
pp_pip:
  PcS = 3
  DrawParcel
  inc Got
  ShowLayers
  ClearMsg
  print at 2,22, "PIP UNWRAPS A LAYER!"
  play sound SndFound
pp_next:
  Rearm
  wait 100 frames
  nmi off
  inc Tries
  if Tries < 5 then goto pp_round
  ClearMsg
  if Got >= 3 then
    print at 2,22, "INSIDE: A KAZOO FOR PIP!"
  else
    print at 2,22, "INSIDE: A KAZOO. NOT PIP'S"
  end if
  Rearm
  wait 90 frames
  nmi off
  Won = 0
  if Got >= 3 then Won = 1
  NumU = Got * 20
  Score += NumU
  return
end sub

' the five friends round the blanket, Pip at the bottom seat (3)
sub DrawParcel:
  DrawPip
  for Q = 0 to 5
    if Q <> 3 then
      G = Q
      if Q > 3 then dec G
      GuestLook
      X = SeatX[Q]
      Y = SeatY[Q] - 1
      J = G + 3
      set sprite J to Y,X,K,C
    end if
  next
  ' the parcel is held up above whoever has it
  X = SeatX[PcS]
  Y = SeatY[PcS]
  Y -= 13
  set sprite 2 to Y,X,SFavour,13
  update sprites
  return
end sub

sub GuestName:
  if G = 0 then print at 2,22, "THE OWL"
  if G = 1 then print at 2,22, "HEDGEHOG"
  if G = 2 then print at 2,22, "RACCOON"
  if G = 3 then print at 2,22, "BUNNY"
  if G = 4 then print at 2,22, "THE BEAR"
  return
end sub

sub ShowLayers:
  print at 18,1, "LAYERS"
  NumU = Got
  print at 25,1, digits$(NumU, 1)
  return
end sub

' ---------------------------------------------------------------------------
' 7. Sack Race: press the button to hop, but only once you have landed;
'    pressing in mid-air trips Pip over. First to the finish wins.

sub SackRace:
  NewScreen
  backdrop dark green
  FillGrass
  for G = 0 to 3
    Y = G * 4
    Y += 7
    fill TLane count 28 at 2,Y
  next
  for Y = 3 to 19
    put char TFinish at 27,Y
  next
  print at 2,1, "SACK RACE"
  GT[0] = 3
  GT[1] = 1
  GT[2] = 4
  for G = 0 to 3
    RcX[G] = 20
    RcH[G] = 0
    RcR[G] = 10
    RcS[G] = 0
  next
  Px = 20
  Py = 129
  Anim = 0
  DrawRace
  ClearMsg
  print at 2,22, "READY..."
  ShowScreen
  Rearm
  wait 60 frames
  nmi off
  ClearMsg
  print at 2,22, "GO! HOP WHEN YOU LAND"
  play sound SndWin
  Won = 2
sr_loop:
  Frame1
  ReadPad
  ' Pip is racer 3
  if Press = 1 then
    if RcS[3] = 0 then
      if RcH[3] = 0 then
        if RcR[3] >= 4 then
          RcH[3] = 1
          play sound SndStep
        end if
      else
        ' pressed in mid-air: a tumble
        RcS[3] = 40
        RcH[3] = 0
        play sound SndBump
      end if
    end if
  end if
  ' the friends hop on their own rhythm
  for G = 0 to 2
    if RcS[G] = 0 then
      if RcH[G] = 0 then
        Mix += 13
        V = Mix & 15
        N = 4 + V
        N = N >> 1
        N += 4
        if RcR[G] >= N then
          RcH[G] = 1
          V = Mix & 31
          if V = 7 then
            RcS[G] = 40
            RcH[G] = 0
          end if
        end if
      end if
    end if
  next
  for G = 0 to 3
    if RcS[G] > 0 then
      dec RcS[G]
      RcR[G] = 0
    elseif RcH[G] > 0 then
      inc RcH[G]
      inc RcX[G]
      if RcH[G] > 10 then
        RcH[G] = 0
        RcR[G] = 0
      end if
    else
      if RcR[G] < 200 then inc RcR[G]
    end if
    if Won = 2 then
      if RcX[G] >= 200 then
        Won = 0
        if G = 3 then Won = 1
        Who = G
      end if
    end if
  next
  DrawRace
  if Won = 2 then goto sr_loop
  ClearMsg
  if Won = 1 then
    print at 2,22, "PIP WINS THE RACE!"
    NumU = 100
    Score += NumU
  else
    G = GT[Who]
    GuestName
    print at 11,22, "WINS THE RACE"
  end if
  Rearm
  wait 90 frames
  nmi off
  return
end sub

sub DrawRace:
  for Q = 0 to 3
    X = RcX[Q]
    Y = Q * 32
    Y += 41
    V = RcH[Q]
    if V > 0 then
      dec V
      N = HopArc[V]
      Y -= N
    end if
    if RcS[Q] > 0 then Y += 3
    if Q = 3 then
      ' Pip: the sack (0) in front of the white (1) and the body (2)
      Px = X
      Py = Y + 1
      set sprite 0 to Y,X,SSack,10
      set sprite 1 to Y,X,SPipw1,15
      set sprite 2 to Y,X,SPip1,9
    else
      J = Q * 2
      J += 3
      set sprite J to Y,X,SSack,10
      inc J
      R = Y
      Last = X
      G = Q
      GuestLook
      set sprite J to R,Last,K,C
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' 8. Fireflies at dusk: catch them while they glow. Ten to win.

sub Fireflies:
  NewScreen
  backdrop black
  for Y = 3 to 12
    for X = 2 to 29
      V = X * 5
      N = Y * 3
      V += N
      V = V & 15
      if V = 0 then
        put char TNstar at X,Y
      else
        put char TNsky at X,Y
      end if
    next
  next
  for Y = 13 to 20
    fill TNgrass count 28 at 2,Y
  next
  print at 2,1, "FIREFLIES"
  Got = 0
  ShowCaught
  for G = 0 to 5
    FfNew
  next
  Tm = 45
  TmT = 0
  ShowTimer
  Px = 120
  Py = 120
  Hp = 24
  Hq = 216
  ' Pip stays on the grass; the fireflies come down low enough to reach
  Vmin = 92
  ClearMsg
  print at 2,22, "CATCH THEM WHILE THEY GLOW"
  ShowScreen
ff_loop:
  Frame1
  ReadPad
  WalkPip
  Clock
  V = Tick & 1
  for G = 0 to 5
    if V = 0 then
      if FfH[G] = 1 then
        inc FfX[G]
        if FfX[G] > 224 then FfH[G] = 0
      else
        dec FfX[G]
        if FfX[G] < 24 then FfH[G] = 1
      end if
    else
      if FfV[G] = 1 then
        inc FfY[G]
        if FfY[G] > 148 then FfV[G] = 0
      else
        dec FfY[G]
        if FfY[G] < 72 then FfV[G] = 1
      end if
    end if
  next
  ' now and then one changes its mind
  N = Tick & 31
  if N = 0 then
    Mix += 19
    G = Mix & 7
    if G < 6 then
      V = Mix & 1
      FfH[G] = V
      V = Mix & 2
      if V > 0 then
        FfV[G] = 1
      else
        FfV[G] = 0
      end if
    end if
  end if
  if Press = 1 then
    for G = 0 to 5
      FfLit
      if N = 1 then
        X = FfX[G]
        Y = FfY[G]
        if Px + 14 >= X then
          if Px <= X + 14 then
            if Py + 14 >= Y then
              if Py <= Y + 14 then
                inc Got
                ShowCaught
                play sound SndPick
                FfNew
              end if
            end if
          end if
        end if
      end if
    next
  end if
  DrawFlies
  if Got >= 10 then goto ff_done
  if Tm > 0 then goto ff_loop
ff_done:
  Won = 0
  if Got >= 10 then Won = 1
  NumU = Got * 8
  Score += NumU
  Rearm
  wait 40 frames
  nmi off
  return
end sub

' N = 1 when firefly G is glowing
sub FfLit:
  V = G * 21
  V += Tick
  V = V & 63
  N = 0
  if V < 36 then N = 1
  return
end sub

sub FfNew:
  Mix += 47
  V = random(0, 180)
  V += Mix
  if V > 200 then V -= 100
  FfX[G] = V + 24
  Mix += 31
  V = random(0, 60)
  V += Mix
  V = V & 63
  if V > 70 then V -= 10
  FfY[G] = V + 76
  V = Mix & 1
  FfH[G] = V
  V = Mix & 2
  FfV[G] = 0
  if V > 0 then FfV[G] = 1
  return
end sub

sub DrawFlies:
  DrawPip
  for G = 0 to 5
    J = G + 2
    FfLit
    X = FfX[G]
    Y = FfY[G]
    if N = 1 then
      set sprite J to Y,X,SFirefly,11
    else
      set sprite J to Y,X,SFirefly,12
    end if
  next
  update sprites
  return
end sub

sub ShowCaught:
  print at 13,1, "CAUGHT"
  NumU = Got
  print at 20,1, digits$(NumU, 2)
  return
end sub

' ---------------------------------------------------------------------------
' The cake: one candle a present, plus one; blow them out

' The five guests are too excited to stand still: they jump one after the
' other, so at most four ever share the floor line (no sprite flicker).
data HopX bytes = 24, 56, 172, 196, 220

sub GuestHop:
  inc HopT
  if HopT >= 16 then
    HopT = 0
    inc HopG
    if HopG >= 5 then HopG = 0
  end if
  for G = 0 to 4
    J = G + 2
    GuestLook
    X = HopX[G]
    Y = 120
    if G = HopG then
      if HopT >= 3 then
        if HopT < 13 then Y = 102
      end if
      if Y = 120 then
        if HopT >= 1 then
          if HopT < 15 then Y = 110
        end if
      end if
    end if
    set sprite J to Y,X,K,C
  next
  return
end sub

sub Finale:
  NewScreen
  backdrop dark blue
  for Y = 2 to 16
    fill TPaper count 28 at 2,Y
  next
  Bunting
  print at 7,1, "MAKE A WISH, PIP!"
  BigT = TWindow00
  BigW = 2
  BigH = 2
  BigX = 4
  BigY = 5
  PutBig
  BigX = 25
  PutBig
  ' the table and the cake
  for Y = 17 to 20
    fill TFloor count 28 at 2,Y
  next
  fill TTabedge count 14 at 9,14
  fill TPlate count 10 at 11,14
  fill TTable count 14 at 9,15
  fill TCloth count 14 at 9,16
  for Y = 11 to 13
    fill TCake count 8 at 12,Y
  next
  fill TCakeband count 8 at 12,12
  fill TIcing count 8 at 12,10
  ' one candle per present (at least one), centred on the cake
  N = GiftN
  if N = 0 then N = 1
  X = 8 - N
  X = X >> 1
  X += 12
  for G = 1 to N
    put char TCandle at X,9
    inc X
  next
  ' the guests around the table
  for G = 0 to 4
    GT[G] = G
  next
  ClearMsg
  print at 2,22, "PRESS THE BUTTON TO BLOW"
  ShowScreen
  Px = 120
  Py = 104
fin_wait:
  Frame1
  ReadPad
  ' the flames flicker
  N = Tick & 7
  if N = 0 then
    V = Tick & 8
    K = TCandle
    if V > 0 then K = TCandle2
    for X = 11 to 20
      GcX = X
      GcY = 9
      call asm GetCh
      if V = TCandle then put char K at X,9
      if V = TCandle2 then put char K at X,9
    next
  end if
  DrawPip
  GuestHop
  update sprites
  if Press = 0 then goto fin_wait
  ' whoosh
  play sound SndBlow
  for X = 11 to 20
    GcX = X
    GcY = 9
    call asm GetCh
    if V = TCandle then put char TCandleoff at X,9
    if V = TCandle2 then put char TCandleoff at X,9
    Rearm
    wait 4 frames
    nmi off
  next
  ClearMsg
  print at 5,22, "HAPPY BIRTHDAY, PIP!"
  nmi off
  ' the song from the 2006 cake demo
  play sound SndBday1
  play sound SndBday2
  print at 4,4, "PRESENTS"
  NumU = GiftN
  print at 13,4, digits$(NumU, 1)
  print at 14,4, "/8"
  print at 18,4, "SCORE"
  NumU = Score
  print at 24,4, digits$(NumU, 4)
  for G = 0 to 7
    X = G * 2
    X += 8
    V = TGiftoff
    if Gift[G] = 1 then V = TGift
    put char V at X,6
  next
  Tm = 0
fin_song:
  Frame1
  inc Tm
  ' the guests hop
  GuestHop
  update sprites
  if Tm < 240 then goto fin_song
  ReadPad
  if Btn = 0 then goto fin_song
  Rearm
  wait no fire
  nmi off
  stop sound SndBday1
  stop sound SndBday2
  mute all
  HideSprites
  return
end sub

' ---------------------------------------------------------------------------

sub TitlePage:
  NewScreen
  backdrop light blue
  for Y = 3 to 15
    fill TSky count 28 at 2,Y
  next
  ' the willow
  put char TLeafl at 3,3
  fill TLeaftop count 8 at 4,3
  put char TLeafr at 12,3
  for Y = 4 to 6
    fill TLeaves count 10 at 3,Y
  next
  fill TDroop count 10 at 3,7
  for Y = 8 to 15
    put char TTrunk at 7,Y
    put char TTrunk at 8,Y
  next
  put char THilll at 12,14
  fill THilltop count 14 at 13,14
  put char THillr at 27,14
  put char THilll2 at 11,15
  fill TGrass count 16 at 12,15
  put char THillr2 at 28,15
  BigT = TSun00
  BigW = 2
  BigH = 2
  BigX = 26
  BigY = 3
  PutBig
  BigT = TCloud00
  BigW = 4
  BigX = 16
  BigY = 3
  PutBig
  Bunting
  for Y = 16 to 18
    for X = 2 to 29
      V = X * 7
      V += Y
      V = V & 7
      if V = 0 then
        put char TFlower at X,Y
      elseif V = 4 then
        put char TFlowery at X,Y
      else
        put char TGrass at X,Y
      end if
    next
  next
  print at 12,5, "PARTY IN"
  print at 12,7, "WILLOW HOLLOW"
  print at 12,10, "PIP TURNS TEN!"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
  Px = 72
  Py = 120
  BdY = 40
title_loop:
  Frame1
  N = Tick & 15
  if N = 0 then Anim = Anim ^ 1
  DrawPip
  for G = 0 to 4
    J = G + 2
    GT[G] = G
    GuestLook
    X = TitleX[G]
    Y = TitleY[G]
    V = Tick + G * 8
    V = V & 32
    if V > 0 then Y -= 4
    set sprite J to Y,X,K,C
  next
  Birds
  update sprites
  if joypad(1).fire then goto title_go
  if joypad(2).fire then goto title_go
  goto title_loop
title_go:
  play sound SndPick
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  HideSprites
  return
end sub

sub EditorialPage:
  nmi off
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 4,1, "PARTY IN WILLOW HOLLOW"
  print at 2,3, "PIP THE FOX TURNS TEN, AND"
  print at 2,4, "HER FRIENDS THROW A PARTY:"
  print at 2,5, "AN OWL, A HEDGEHOG, A"
  print at 2,6, "RACCOON, A BUNNY AND A BEAR."
  print at 2,8, "WIN THE PARTY GAMES TO EARN"
  print at 2,9, "PRESENTS AND CANDLES FOR"
  print at 2,10, "THE CAKE."
  print at 2,12, "THE BIRTHDAY SONG COMES"
  print at 2,13, "FROM THE 2006 COLECOVISION"
  print at 2,14, "10-YEARS CAKE DEMO."
  print at 2,16, "A TRIBUTE TO THE PARTY"
  print at 2,17, "GAMES OF THE COLECOVISION."
  print at 2,19, "BY AMY BIENVENU, 2026."
  print at 7,22, "PRESS A BUTTON"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

