data PlL bytes 4,4,4,4,3,3,2,2
data PlR bytes 4,4,4,4,5,5,6,6
data AtL bytes 3,2,2,3,3,4
data AtR bytes 5,6,6,5,5,4

asm {
ChBoomN:
    db $00,$00,$06,$03,$10
ChBoomT:
    db $40,$71,$03,$03,$50
ChBell:
    db $40,$5D,$10,$02,$40,$FF,$F3,$02,$40,$5D,$10,$02,$40,$FF,$F3,$02,$40,$5D,$20,$02,$50

ChSoundTable:
    dw ChBoomN,$702B
    dw ChBoomT,$7035
    dw ChBell,$7035
    dw ChTuneMel,$703F
    dw ChTuneBass,$7049
; Down the Chutes, E minor (original for this game)
; Tiny Sound, 7 frames per step
ChTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$23,$01,$01,$01,$21,$01,$1E,$01,$01,$01,$1A,$01
    db $1C,$01,$1E,$01,$1F,$01,$01,$01,$1E,$01,$1C,$01,$01,$01,$19,$01
    db $1A,$01,$1C,$01,$1E,$01,$01,$01,$1C,$01,$1A,$01,$01,$01,$17,$01
    db $19,$01,$1A,$01,$19,$01,$17,$01,$16,$01,$17,$01,$01,$01,$01,$01
    db $00,$01,$01,$01,$1A,$01,$1E,$01,$23,$01,$01,$01,$21,$01,$1F,$01
    db $1E,$01,$01,$01,$1C,$01,$1F,$01,$23,$01,$01,$01,$21,$01,$1E,$01
    db $1A,$01,$01,$01,$19,$01,$1C,$01,$1F,$01,$1E,$01,$1C,$01,$1A,$01
    db $19,$01,$01,$01,$17,$01,$1A,$01,$1E,$01,$23,$01,$01,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
ChTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0B,$01,$0B,$01,$06,$01,$06,$01,$0B,$01,$0B,$01
    db $06,$01,$06,$01,$04,$01,$04,$01,$0B,$01,$0B,$01,$09,$01,$09,$01
    db $04,$01,$04,$01,$0E,$01,$0E,$01,$09,$01,$09,$01,$07,$01,$07,$01
    db $0E,$01,$0E,$01,$06,$01,$06,$01,$0D,$01,$0D,$01,$06,$01,$01,$01
    db $00,$01,$01,$01,$0B,$01,$0B,$01,$06,$01,$06,$01,$0B,$01,$0B,$01
    db $0E,$01,$0E,$01,$04,$01,$04,$01,$07,$01,$07,$01,$0E,$01,$0E,$01
    db $06,$01,$06,$01,$09,$01,$09,$01,$04,$01,$04,$01,$06,$01,$06,$01
    db $0A,$01,$0A,$01,$0B,$01,$06,$01,$0B,$01,$06,$01,$0B,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
ChSong:
    dw $0001
    db $40+4,5
    dw $0000
; ---------------------------------------------------------------------------
; Text on the bitmap screen (after games/hs/ztext.asm): character ZCh at
; cell ZCol,ZRow (pattern at row*256 + col*8, colour at $2000 + the same),
; colour byte ZClr; the font is ChFont (characters 32-95, art.py)
; ---------------------------------------------------------------------------
ZCellAddr:
    ld a,(AMY_UVAR_ZRow)
    ld h,a
    ld a,(AMY_UVAR_ZCol)
    add a,a
    add a,a
    add a,a
    ld l,a
    ret

; HL = 8 pattern bytes for the current cell, then its colour
ZPut8:
    push hl
    call ZCellAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop hl
    ld b,8
zp8_p:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz zp8_p
    call ZCellAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_ZClr)
    ld b,8
zp8_c:
    out ($BE),a
    nop
    nop
    djnz zp8_c
    ld hl,AMY_UVAR_ZCol
    inc (hl)
    ret

ZPutCh:
    ld a,(AMY_UVAR_ZCh)
    sub 32
    jr nc,zpc_ok
    xor a
zpc_ok:
    cp 64
    jr c,zpc_in
    ld a,31
zpc_in:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,ChFont
    add hl,de
    jp ZPut8

; the zero-ended string at ZPtr
ZPrint:
    ld hl,(AMY_UVAR_ZPtr)
zpr_loop:
    ld a,(hl)
    or a
    ret z
    ld (AMY_UVAR_ZCh),a
    push hl
    call ZPutCh
    pop hl
    inc hl
    jr zpr_loop

; ---------------------------------------------------------------------------
; ChPix: the pixel Px,Py set (Pc 1, colour byte $A0 there) or cleared (Pc 0)
; ---------------------------------------------------------------------------
ChPix:
    ld a,(AMY_UVAR_Py)
    ld c,a
    rrca
    rrca
    rrca
    and $1F
    ld h,a
    ld a,(AMY_UVAR_Px)
    and $F8
    ld l,a
    ld a,c
    and 7
    or l
    ld l,a              ; HL = pattern address
    ld a,(AMY_UVAR_Px)
    and 7
    ld b,a
    ld a,$80
    jr z,cp_m
cp_sh:
    rrca
    djnz cp_sh
cp_m:
    ld e,a              ; E = the pixel's bit
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld d,a
    ld a,(AMY_UVAR_Pc)
    or a
    jr z,cp_clr
    ld a,d
    or e
    jr cp_put
cp_clr:
    ld a,e
    cpl
    and d
cp_put:
    ld d,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,d
    out ($BE),a
    ld a,(AMY_UVAR_Pc)
    or a
    ret z
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,$A0
    out ($BE),a
    ret
; the 5 x 7 font, characters 32-95 (art.py)
ChFont:
