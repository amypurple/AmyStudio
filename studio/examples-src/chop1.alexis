record Bomb:
  u8 St
  u8 X
  u16 Yf
  u8 T
  u8 Low
end record

Bomb Bs[NBomb]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Fall = 0
u16 StepS = 0
u16 StepAcc = 0
u16 CXf = 0
u16 CYf = 0
u16 SXf = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 DomeOk[28]
u8 Hgt[28]
u8 RowB[28]
u8 CX = 0
u8 CY = 0
u8 Face = 0
u8 ChSt = 0
u8 CrT = 0
u8 PY = 0
u8 SX = 0
u8 SD = 0
u8 ShOn = 0
u8 ShX = 0
u8 ShY = 0
u8 ShD = 0
u8 BlT = 0
u8 BlX = 0
u8 BlY = 0
u8 Lv = 1
u8 StartLv = 1
u8 Left = 0
u8 Str = 6
u8 Sunk = 0
u8 Spares = 3
u8 Over = 0
u8 WaveEnd = 0
u8 Shot = 0
u8 Burnt = 0
u8 Landed = 0
u8 Wrecks = 0
u8 Waves = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
u8 Fr2 = 0
' loop counters (never shared with the helpers)
u8 Bi = 0
u8 Ds = 0
u8 Ci = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ChSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if WaveEnd > 0 then EndWave
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "  BEST  ", Hi, "  "
  print at 8,14, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  inc Anim
  MoveSaucer
  MoveChopper
  MoveShot
  W16 = StepAcc + StepS
  StepAcc = W16 & 255
  K = W16 >> 8
  while K > 0
    BombStep
    dec K
  end while
  for Bi = 0 to NBomb - 1
    FallBomb(Bi)
  next
  if BlT > 0 then dec BlT
  CheckWave
  return
end sub

' the saucer: 0.47 C64 pixels a frame, turning at the edges
sub MoveSaucer:
  if SD = 0 then
    SXf = SXf + 108
    if SXf >= 57344 then SD = 1
  else
    SXf = SXf - 108
    if SXf < 4096 then SD = 0
  end if
  SX = SXf >> 8
  return
end sub

' the chopper flies 1.25 pixels a frame; wrecked, it hangs, then the
' pilot drops
sub MoveChopper:
  select case ChSt
    case 0
      K = J1 & 12
      if K = 4 then
        Face = 1
        if CXf > 4416 then
          CXf = CXf - 320
        else
          CXf = 4096
        end if
      end if
      if K = 8 then
        Face = 0
        if CXf < 57024 then
          CXf = CXf + 320
        else
          CXf = 57344
        end if
      end if
      K = J1 & 3
      if K = 1 then
        if CYf > 6464 then
          CYf = CYf - 320
        else
          CYf = 6144
        end if
      end if
      if K = 2 then
        if CYf < 42688 then
          CYf = CYf + 320
        else
          CYf = 43008
        end if
      end if
      CX = CXf >> 8
      CY = CYf >> 8
      if Press = 1 then Laser
      if HitSaucer() = 1 then Wreck
    case 1
      dec CrT
      if CrT = 0 then
        ChSt = 2
        PY = CY
      end if
    case 2
      inc PY
      if PY >= PilotEnd then
        if Spares = 0 then
          Over = 1
        else
          dec Spares
          ShowSpares
          NewChopper
        end if
      end if
  end select
  return
end sub

function HitSaucer as u8
  if CY > 31 then return 0
  V = SX + 14
  if CX > V then return 0
  V = CX + 14
  if SX > V then return 0
  return 1

sub NewChopper:
  CXf = 112 * 256
  CYf = 64 * 256
  CX = 112
  CY = 64
  Face = 0
  ChSt = 0
  return
end sub

sub Wreck:
  ChSt = 1
  CrT = 65
  ShOn = 0
  BlX = CX
  BlY = CY
  BlT = 30
  inc Wrecks
  play sound SndCrash
  return
end sub

' the laser: one shot at a time, 6 pixels a frame the way the chopper faces
sub Laser:
  if ShOn = 1 then return
  ShOn = 1
  ShY = CY + 7
  ShD = Face
  if Face = 0 then
    ShX = CX + 14
  else
    ShX = CX - 6
  end if
  play sound SndShot
  return
end sub

sub MoveShot:
  if ShOn = 0 then return
  if ShD = 0 then
    if ShX >= 230 then
      ShOn = 0
      return
    end if
    ShX = ShX + 6
  else
    if ShX < 16 then
      ShOn = 0
      return
    end if
    ShX = ShX - 6
  end if
  return
end sub

' one C64 bomb step: parked bombs may drop, finished ones come back
sub BombStep:
  for Ds = 0 to NBomb - 1
    C = Bs[Ds].St
    select case C
      case 0
        if Left > 0 then
          Rand
          V = Rs & 63
          if V = 3 then
            Bs[Ds].St = 1
            Bs[Ds].X = SX + 1
            Bs[Ds].Yf = BombY0 * 256
            Bs[Ds].Low = 0
            dec Left
            ShowLeft
            play sound SndDrop
          end if
        end if
      case 2
        V = Bs[Ds].T + 1
        Bs[Ds].T = V
        if V >= 13 then Bs[Ds].St = 0
    end select
  next
  return
end sub

' a falling bomb: the shot, the chopper, the dome, the street
sub FallBomb(u8 N):
  u8 By
  u8 Bx
  u8 Col
  if Bs[N].St <> 1 then return
  W16 = Bs[N].Yf + Fall
  Bs[N].Yf = W16
  By = W16 >> 8
  Bx = Bs[N].X
  if ShotHits(Bx, By) = 1 then
    ShOn = 0
    Score += 10
    if Score > Hi then Hi = Score
    ShowScore
    inc Shot
    Gone(N, Bx, By)
    play sound SndPop
    return
  end if
  if ChSt = 0 then
    if Touches(Bx, By) = 1 then
      Gone(N, Bx, By)
      Wreck
      return
    end if
  end if
  if Bs[N].Low = 0 then
    Col = Bx + 7
    Col = (Col >> 3) - 2
    V = DomeH[Col] + 119
    if By >= V then
      Bs[N].Low = 1
      if DomeOk[Col] = 1 then
        DomeOk[Col] = 0
        put char TSky0 at Col + 2,16
        inc Burnt
        Gone(N, Bx, By)
        play sound SndZap
        return
      end if
    end if
  end if
  if By >= GroundY then
    Gone(N, Bx, By)
    inc Landed
    play sound SndBoom
    Sink
  end if
  return
end sub

' the bomb is finished: a blast where it was, back to the saucer later
sub Gone(u8 N, u8 Gx, u8 Gy):
  Bs[N].St = 2
  Bs[N].T = 0
  BlX = Gx
  BlY = Gy - 3
  BlT = 12
  return
end sub

' the laser touches the bomb (within its height, 5 pixels above or below)
function ShotHits(u8 Hx, u8 Hy) as u8
  u8 L
  u8 R
  if ShOn = 0 then return 0
  if Hy < 34 then return 0
  if ShY + 5 < Hy then return 0
  if ShY > Hy + 14 then return 0
  ' the stretch the tracer covered this frame
  if ShD = 0 then
    L = ShX - 6
    R = ShX + 7
  else
    L = ShX
    R = ShX + 13
  end if
  if R < Hx + 4 then return 0
  if L > Hx + 9 then return 0
  return 1

' the bomb's box against the chopper's
function Touches(u8 Tx, u8 Ty) as u8
  i16 Dx
  i16 Dy
  Dx = Tx
  Dx = Dx - CX
  Dy = Ty
  Dy = Dy - CY
  if Dx < -12 then return 0
  if Dx > 9 then return 0
  if Dy < -13 then return 0
  if Dy > 11 then return 0
  return 1

' a bomb in the street: the city sinks a row; the sixth ends the wave
sub Sink:
  inc Sunk
  DrawCity
  dec Str
  if Str = 0 then WaveEnd = 2
  return
end sub

' the wave is over when the saucer is empty and the sky clear
sub CheckWave:
  if WaveEnd > 0 then return
  if ChSt <> 0 then return
  if Left > 0 then return
  for Ci = 0 to NBomb - 1
    if Bs[Ci].St = 1 then return
  next
  WaveEnd = 1
  return
end sub

sub EndWave:
  u8 Q
  HideBombs
  if WaveEnd = 2 then
    print at 5,9, "                      "
    print at 5,10, " CITY DESTROYED -     "
    print at 5,11, "    NO BONUS          "
    print at 5,12, "                      "
    play sound SndLost
    Pause(150)
  else
    print at 6,9, "                    "
    print at 6,10, "    CITY SAVED!     "
    print at 6,11, "    BONUS: ", Str, "00     "
    print at 6,12, "                    "
    play sound SndSaved
    Pause(60)
    ' count the bonus in
    Q = Str
    while Q > 0
      Score += 100
      if Score > Hi then Hi = Score
      dec Q
      ShowScore
      print at 17,11, Q, "00"
      play sound SndBonus
      Pause(15)
    end while
    Pause(60)
    inc Waves
    if Lv < 9 then inc Lv
  end if
  NewWave
  return
end sub

sub Pause(u8 F):
  for Ci = 1 to F
    Frame1
  next
  return
end sub

sub NewWave:
  for Ci = 0 to NBomb - 1
    Bs[Ci].St = 0
    Bs[Ci].T = 0
  next
  Fall = FallT[Lv - 1]
  StepS = StepT[Lv - 1]
  StepAcc = 0
  Left = 100
  Str = 6
  Sunk = 0
  ShOn = 0
  BlT = 0
  WaveEnd = 0
  for Ci = 0 to 27
    DomeOk[Ci] = 1
  next
  NewCity
  Rearm
  wait
  nmi off
  DrawField
  ShowAll
  return
end sub

' a new skyline: towers 2 or 3 columns wide, 1 to 6 storeys
sub NewCity:
  u8 Wd
  u8 Ht
  Ci = 0
  while Ci < 28
    Rand
    Wd = (Rs & 1) + 2
    Ht = ((Rs >> 4) & 3) + 3
    V = (Rs >> 8) & 7
    if V = 0 then Ht = 1
    if V = 1 then Ht = 6
    if V = 2 then Ht = 2
    while Wd > 0
      if Ci < 28 then Hgt[Ci] = Ht
      inc Ci
      dec Wd
    end while
  end while
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing
sub DrawField:
  for Ci = 3 to 22
    fill TSky0 count 32 at 0,Ci
  next
  for Ci = 0 to 15
    J = Ci * 2
    K = Stars[J]
    V = Stars[J + 1]
    C = (Ci & 1) + TSky1
    if Ci > 11 then C = TSky3
    put char C at K,V
  next
  put char TMoon00 at 24,4
  put char TMoon01 at 25,4
  put char TMoon10 at 24,5
  put char TMoon11 at 25,5
  for Ci = 0 to 27
    if DomeOk[Ci] = 1 then
      put char TDome0 + DomeH[Ci] at Ci + 2,16
    end if
  next
  fill TStreet count 32 at 0,23
  DrawCity
  return
end sub

' the city rows 17-22: each tower its height less the rows sunk; each
' row is built in RowB and copied to the name table in one go
sub DrawCity:
  u8 H
  u8 Top
  u8 R
  u8 T
  u16 Va
  for R = 17 to 22
    for Ci = 0 to 27
      H = Hgt[Ci]
      if H > Sunk then
        H = H - Sunk
      else
        H = 0
      end if
      Top = 23 - H
      if R < Top then
        T = TSky0
      else
        if R = Top then
          T = (Ci >> 1) & 1
          T = T + TRoofA
          if Hgt[Ci] = 6 then T = TRoofB
          if Hgt[Ci] = 2 then T = TRoofC
        else
          T = R - Top
          T = T + Ci
          T = T % 3
          T = T + TWinA
        end if
      end if
      RowB[Ci] = T
    next
    Va = R
    Va = Va * 32 + 2
    copy RowB count 28 to vram.name + Va
  next
  return
end sub

sub ShowAll:
  print at 2,1, "SCORE"
  print at 18,1, "HI"
  print at 2,2, "WAVE"
  print at 10,2, "BOMBS"
  ShowScore
  ShowLeft
  NumU = Lv
  print at 7,2, digits$(NumU, 1)
  ShowSpares
  return
end sub

sub ShowScore:
  print at 8,1, Score
  print at 21,1, Hi
  return
end sub

sub ShowLeft:
  NumU = Left
  print at 16,2, digits$(NumU, 3)
  return
end sub

sub ShowSpares:
  fill 32 count 3 at 26,2
  if Spares > 0 then fill TChute count Spares at 26,2
  return
end sub

sub HideBombs:
  for Ci = 0 to NBomb - 1
    J = Ci + 4
    set sprite J to 192,0,0,0
  next
  set sprite 9 to 192,0,0,0
  set sprite 10 to 192,0,0,0
  update sprites
  return
end sub

' sprites 0-1 the chopper or the pilot, 2-3 the saucer, 4-8 the bombs,
' 9 the laser, 10 the blast
sub DrawSprites:
  u8 Fr
  u8 By
  Fr = (Anim >> 2) & 1
  select case ChSt
    case 0
      K = Face * 8 + Fr * 16 + SChR0d
      set sprite 0 to CY - 1,CX,K,15
      set sprite 1 to CY - 1,CX,K + 4,8
    case 1
      K = Face * 8 + SChR0d
      set sprite 0 to CY - 1,CX,K,14
      set sprite 1 to CY - 1,CX,K + 4,6
    case 2
      if Spares > 0 then
        set sprite 0 to PY - 1,CX,SPcd,15
        set sprite 1 to PY - 1,CX,SPcb,11
      else
        set sprite 0 to PY - 1,CX,SPfb,11
        set sprite 1 to 192,0,0,0
      end if
  end select
  ' the lights chase three times a second
  Fr = Anim / 10
  Fr = Fr & 1
  K = Fr * 4 + SSa0d
  set sprite 2 to SaucerY - 1,SX,K,11
  set sprite 3 to SaucerY - 1,SX,SSa0b,14
  for Ds = 0 to NBomb - 1
    J = Ds + 4
    if Bs[Ds].St = 1 then
      W16 = Bs[Ds].Yf
      By = W16 >> 8
      set sprite J to By - 1,Bs[Ds].X,SBomb,9
    else
      set sprite J to 192,0,0,0
    end if
  next
  if ShOn = 1 then
    set sprite 9 to ShY - 1,ShX,SShot,11
  else
    set sprite 9 to 192,0,0,0
  end if
  if BlT > 0 then
    K = SBl0
    if BlT > 6 then K = SBl1
    set sprite 10 to BlY - 1,BlX,K,10
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  Score = 0
  Lv = StartLv
  Spares = 3
  Over = 0
  Shot = 0
  Burnt = 0
  Landed = 0
  Wrecks = 0
  Waves = 0
  SXf = 80 * 256
  SX = 80
  SD = 0
  Anim = 0
  NewChopper
  NewWave
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: CHOPPER 1 in dome-blue blocks, the saucer crossing, START /
' WAVE / HOW TO PLAY / CREDITS, the best score, the tune once
data Glyphs bytes 7,4,4,4,7,5,5,7,5,5,7,5,5,5,7,7,5,7,4,4,7,5,7,4,4,7,4,6,4,7,6,5,6,5,5,2,6,2,2,7
sub BigLetters:
  ' C H O P P E R in 3 x 5 blocks (rows 2-6), the 1 below (rows 8-12)
  u8 L
  u8 Row
  u8 B
  u8 Px
  u8 Gy2
  for L = 0 to 7
    for Row = 0 to 4
      J = L * 5 + Row
      B = Glyphs[J]
      Px = L * 4 + 2
      Gy2 = Row + 2
      if L = 7 then
        Px = 14
        Gy2 = Row + 8
      end if
      V = B & 4
      if V > 0 then put char TTblk at Px,Gy2
      V = B & 2
      if V > 0 then put char TTblk at Px + 1,Gy2
      V = B & 1
      if V > 0 then put char TTblk at Px + 2,Gy2
    next
  next
  return
end sub

sub TitlePage:
  NewScreen
  for Ci = 0 to 15
    J = Ci * 2
    K = Stars[J]
    V = Stars[J + 1]
    if V > 7 then V = V + 9
    put char TTstar at K,V
  next
  BigLetters
  print at 7,14, "COMPUTE!'S GAZETTE"
  print at 10,15, "AUGUST 1986"
  print at 8,16, "BY MIKE SEDORE"
  print at 12,18, "START"
  print at 12,19, "WAVE"
  print at 12,20, "HOW TO PLAY"
  print at 12,21, "CREDITS"
  if Hi > 0 then
    print at 10,22, "BEST ", Hi
  end if
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 568
  TzOn = 1
  SXf = 16 * 256
  SD = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  inc Anim
  ReadPad
  MoveSaucer
  Fr2 = Anim / 10
  Fr2 = Fr2 & 1
  K = Fr2 * 4 + SSa0d
  set sprite 2 to 55,SX,K,11
  set sprite 3 to 55,SX,SSa0b,14
  update sprites
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      end if
      if V & 2 then
        if Menu < 3 then inc Menu
      end if
      if Menu = 1 then
        if V & 4 then
          if StartLv > 1 then dec StartLv
        end if
        if V & 8 then
          if StartLv < 9 then inc StartLv
        end if
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,18
  put char 32 at 10,19
  put char 32 at 10,20
  put char 32 at 10,21
  J = Menu + 18
  put char 62 at 10,J
  NumU = StartLv
  print at 17,19, "< ", digits$(NumU, 1), " >"
  return
end sub

' a little night city for the HOW TO PLAY pages: sky rows 15-20, the
' dome on row 17 (with a hole at column 9), towers on rows 18-20, the
' street on row 21
sub MiniCity:
  for Ci = 15 to 20
    fill TSky0 count 28 at 2,Ci
  next
  for Ci = 0 to 27
    if Ci <> 7 then put char TDome0 + DomeH[Ci] at Ci + 2,17
  next
  for Ci = 0 to 27
    K = Ci & 3
    if K <> 3 then
      put char TRoofA + (Ci & 1) at Ci + 2,18
      put char TWinA + (Ci % 3) at Ci + 2,19
      put char TWinB at Ci + 2,20
    end if
  next
  fill TStreet count 28 at 2,21
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "AN ALIEN SAUCER DROPS"
    print at 2,4, "BOMBS ON YOUR CITY. FLY"
    print at 2,5, "YOUR RED CHOPPER AND SHOOT"
    print at 2,6, "THE BOMBS BEFORE THEY FALL."
    print at 2,8, "A BOMB BURNS A HOLE IN THE"
    print at 2,9, "BLUE DOME. A BOMB THAT GETS"
    print at 2,10, "THROUGH A HOLE KNOCKS THE"
    print at 2,11, "CITY DOWN ONE FLOOR."
    MiniCity
    set sprite 2 to 119,48,SSa0d,11
    set sprite 3 to 119,48,SSa0b,14
    set sprite 4 to 128,72,SBomb,9
    set sprite 5 to 126,160,SBomb,9
    set sprite 0 to 121,192,SChL0d,15
    set sprite 1 to 121,192,SChL0b,8
    set sprite 9 to 126,176,SShot,11
  case 2
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "THE JOYSTICK FLIES THE"
    print at 2,4, "CHOPPER. A BUTTON FIRES THE"
    print at 2,5, "LASER THE WAY IT FACES."
    print at 2,7, "DON'T TOUCH A BOMB OR THE"
    print at 2,8, "SAUCER! THE PILOT JUMPS"
    print at 2,9, "OUT WITH A PARACHUTE AND"
    print at 2,10, "A NEW CHOPPER COMES. AFTER"
    print at 2,11, "3 PARACHUTES THE GAME IS"
    print at 2,12, "OVER."
    print at 2,14, "ON THE TITLE, PICK THE"
    print at 2,15, "WAVE (1-9) WITH LEFT/RIGHT."
    for Ci = 17 to 20
      fill TSky0 count 28 at 2,Ci
    next
    set sprite 0 to 143,64,SChR0d,15
    set sprite 1 to 143,64,SChR0b,8
    set sprite 9 to 148,88,SShot,11
    set sprite 4 to 139,120,SBomb,9
    set sprite 5 to 135,176,SPcd,15
    set sprite 6 to 135,176,SPcb,11
  case 3
    print at 2,1, "SCORING                3/3"
    print at 2,3, "EVERY BOMB YOU SHOOT IS"
    print at 2,4, "WORTH 10 POINTS."
    print at 2,6, "STOP ALL 100 BOMBS OF A"
    print at 2,7, "WAVE: 100 POINTS FOR EACH"
    print at 2,8, "FLOOR LEFT. THE NEXT WAVE"
    print at 2,9, "IS FASTER. IF THE CITY IS"
    print at 2,10, "HIT 6 TIMES, NO BONUS AND"
    print at 2,11, "THE WAVE STARTS AGAIN."
    print at 2,12, "TIP: STAY LOW, NEAR THE"
    print at 2,13, "DOME, AND SHOOT SIDEWAYS."
    MiniCity
    set sprite 0 to 127,120,SChR0d,15
    set sprite 1 to 127,120,SChR0b,8
    set sprite 9 to 132,144,SShot,11
    set sprite 10 to 124,168,SBl0,10
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "CHOPPER 1"
  print at 2,5, "BASED ON CHOPPER 1 BY MIKE"
  print at 2,6, "SEDORE, COMPUTE!'S GAZETTE"
  print at 2,7, "AUGUST 1986 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: NIGHT PATROL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

