project "AMY NUMERIC COMPARISON SELFTEST"
memory "colecovision_legacy_sdcc"

u8 U8Zero = 0
u8 U8Max = 255
i8 I8Neg = -1
i8 I8Min = -128
i8 I8Max = 127
u16 U16Zero = 0
u16 U16Byte = 255
u16 U16Next = 256
u16 U16Max = 65535
i16 I16Neg = -1
i16 I16Min = -32768
i16 I16Max = 32767
fixed FixedNeg = -1.5
fixed FixedZero = 0.0
fixed FixedPos = 1.5
ufixed UFixedZero = 0.0
ufixed UFixedPos = 255.5
u32 U32Zero = 0
u32 U32High = 4000000000
i32 I32Neg = -1
i32 I32Zero = 0
i32 I32Max = 2147483647
fixed32 Fixed32Neg = -1.5
fixed32 Fixed32Zero = 0.0
fixed32 Fixed32Pos = 1.5
fp5 FloatNeg = -1.5
fp5 FloatZero = 0.0
fp5 FloatPos = 1.5
bcd digits 6 BcdZero
bcd digits 6 BcdHigh
u8 Passed = 0

clear BcdZero
clear BcdHigh
BcdHigh += 654321

' Same-width and reversed-operand integer comparisons.
if U8Zero = 0 then Passed += 1
if 0 = U8Zero then Passed += 1
if U8Max <> 0 then Passed += 1
if 0 <> U8Max then Passed += 1
if I8Neg < 0 then Passed += 1
if 0 > I8Neg then Passed += 1
if I8Min < I8Max then Passed += 1
if I8Max >= I8Min then Passed += 1

' Mixed-width promotion must preserve mathematical values.
if U8Max < U16Next then Passed += 1
if U16Next > U8Max then Passed += 1
if U8Max = U16Byte then Passed += 1
if I8Neg = I16Neg then Passed += 1
if I8Max < I16Max then Passed += 1
if I16Min < I8Min then Passed += 1
if I16Neg < U8Max then Passed += 1
if U8Max > I16Neg then Passed += 1
if U16Max > I8Neg then Passed += 1
if I8Neg < U16Max then Passed += 1

' Fixed-point comparisons retain their fractional bits.
if FixedNeg < 0 then Passed += 1
if 0 > FixedNeg then Passed += 1
if FixedZero = 0 then Passed += 1
if 0 = FixedZero then Passed += 1
if FixedPos > 1 then Passed += 1
if UFixedZero = 0 then Passed += 1
if 0 = UFixedZero then Passed += 1
if UFixedPos > 255 then Passed += 1

' Wide integer and 16.16 zero comparisons use both operand orders.
if U32Zero = 0 then Passed += 1
if 0 = U32Zero then Passed += 1
if U32High > 0 then Passed += 1
if 0 < U32High then Passed += 1
if I32Neg < 0 then Passed += 1
if 0 > I32Neg then Passed += 1
if I32Zero >= 0 then Passed += 1
if 0 <= I32Zero then Passed += 1
if I32Max <> 0 then Passed += 1
if Fixed32Neg < 0 then Passed += 1
if 0 > Fixed32Neg then Passed += 1
if Fixed32Zero = 0 then Passed += 1
if 0 = Fixed32Zero then Passed += 1
if Fixed32Pos > 0 then Passed += 1

' FP5 and BCD must use numeric helpers, never raw byte ordering.
if FloatNeg < FloatZero then Passed += 1
if FloatZero = 0 then Passed += 1
if 0 = FloatZero then Passed += 1
if FloatPos > FloatZero then Passed += 1
if BcdZero = 0 then Passed += 1
if 0 = BcdZero then Passed += 1
if BcdHigh > BcdZero then Passed += 1
if BcdZero < BcdHigh then Passed += 1

text screen
if Passed = 48 then
  print centered at 10, "NUMERIC COMPARE PASS"
else
  print centered at 9, "NUMERIC COMPARE FAIL"
  print at 8,11, "PASSED"
  print Passed at 15,11 digits 2
end if
screen on
loop forever
