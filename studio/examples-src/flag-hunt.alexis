  32,32,32,32,32,143,32,32,32,32,32,143,32,32,32,32,32,143,32,32,32,143,32,143,32,32,32,32,32,32,32,32
  32,32,32,32,32,143,143,143,143,32,32,143,32,32,32,32,32,143,143,143,143,143,32,143,32,143,143,143,32,32,32,32
