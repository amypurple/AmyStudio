record Pl:
  u8 X
  u8 Y
  u8 Face
  u8 Carry
  u8 Spr
end record

' a timer for the title tune (kit/tuneonce.py)
u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
' the two players and their shots
Pl Ps[2]
u8 Bx[2]
u8 By[2]
u8 Bd[2]
u8 Sc[2]
u8 Pad[2]
u8 OldPad[2]
u8 NPl = 1
u8 Cpu = 1
u8 Phase = 0
u8 Over = 0
u8 Winner = 0
u8 Sel = 0
u16 Rounds = 0
' the computer's player
u8 AiSee = 0
u8 AiCool = 0
' which ladder of a pair the computer takes on each floor (a bit each)
u8 AiWay = 0
' input
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u16 Hits = 0
u16 Shots = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Si = 0
u8 Ri = 0
' scratch
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FhSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count 6
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 2 then goto title
  Sc[0] = 0
  Sc[1] = 0
  Over = 0

round_loop:
  RunRound
  if Over = 0 then goto round_loop

  ' the end: the winner, then back to the title on a press
  HideSprites
  ClearBand
  if Winner = 0 then
    print at 9,MsgRow, "GREEN  WINS!"
  else
    print at 10,MsgRow, "RED  WINS!"
  end if
  mute all
  play sound SndWin
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Phase = 0
  goto title

' ---------------------------------------------------------------------------
' one round: both players home, flags in place, play until a capture

sub RunRound:
  DrawField
  for Ri = 0 to 1
    PlaceHome(Ri)
    Bd[Ri] = 0
    OldPad[Ri] = 31
  next
  AiSee = 0
  AiCool = AiRest
  AiWay = random(0, 15)
  DrawSprites
  ShowScreen
  Phase = 1
rr_loop:
  Frame1
  PlayStep
  if Phase = 1 then goto rr_loop
  ' a capture
  inc Rounds
  inc Sc[Winner]
  ShowHud
  play sound SndScore
  for Ri = 0 to 60
    Frame1
    DrawSprites
  next
  HideSprites
  ClearBand
  if Winner = 0 then
    print at 6,MsgRow, "GREEN CAPTURES A FLAG"
  else
    print at 7,MsgRow, "RED CAPTURES A FLAG"
  end if
  if Sc[Winner] >= NWin then Over = 1
  Rearm
  wait 100 frames
  nmi off
  Phase = 0
  return
end sub

sub PlaceHome(u8 P):
  Ps[P].X = SpawnX[P]
  Ps[P].Y = HomeY[P]
  Ps[P].Face = P
  Ps[P].Carry = 0
  Ps[P].Spr = SRunr1
  if P = 1 then Ps[P].Spr = SRunl1
  return
end sub

' one pass of play: the sticks (or the computer), walking and climbing,
' shots, hits, flags
sub PlayStep:
  ReadPads
  if Cpu = 1 then AiThink
  for Pi = 0 to 1
    MovePlayer(Pi)
  next
  for Pi = 0 to 1
    N = Pad[Pi] & (Pad[Pi] ^ OldPad[Pi])
    if (N & 16) <> 0 then
      if Bd[Pi] = 0 then Shoot(Pi)
    end if
    OldPad[Pi] = Pad[Pi]
  next
  MoveShots
  CheckHits
  CheckFlags
  DrawSprites
  return
end sub

' the stick: 1 up, 2 down, 4 left, 8 right, 16 a button
function StickOf(u8 C) as u8
  u8 S = 0
  if joypad(C).up then S = S | 1
  if joypad(C).down then S = S | 2
  if joypad(C).left then S = S | 4
  if joypad(C).right then S = S | 8
  if joypad(C).fire then S = S | 16
  return S

sub ReadPads:
  K = StickOf(1)
  N = StickOf(2)
  OldPads = Pads
  Pads = K | N
  if Cpu = 1 then
    Pad[0] = Pads
  else
    Pad[0] = K
    Pad[1] = N
  end if
  return
end sub

' the x of a ladder between floors B and B+1 near X (4 pixels of slack),
' or 0
function LadderAt(u8 B, u8 Lx) as u8
  u8 A = LadA[B]
  if Lx + 4 >= A then
    if Lx <= A + 4 then return A
  end if
  A = LadB[B]
  if A = 0 then return 0
  if Lx + 4 >= A then
    if Lx <= A + 4 then return A
  end if
  return 0

' walk on a floor, climb on a ladder (a pixel a frame)
sub MovePlayer(u8 P):
  u8 S = Pad[P]
  u8 Mx = Ps[P].X
  u8 My = Ps[P].Y
  u8 Off = (My - TopY) & 31
  u8 L = (My - TopY) >> 5
  u8 Lad = 0
  u8 Clm = 0
  if Off <> 0 then
    ' on a ladder: up or down only
    if (S & 1) <> 0 then
      dec My
    elseif (S & 2) <> 0 then
      inc My
    end if
    Clm = 1
  else
    if (S & 1) <> 0 then
      if L > 0 then
        Lad = LadderAt(L - 1, Mx)
        if Lad > 0 then
          Mx = Lad
          dec My
          Clm = 1
        end if
      end if
    end if
    if Clm = 0 then
      if (S & 2) <> 0 then
        if L < 4 then
          Lad = LadderAt(L, Mx)
          if Lad > 0 then
            Mx = Lad
            inc My
            Clm = 1
          end if
        end if
      end if
    end if
    if Clm = 0 then
      if (S & 4) <> 0 then
        if Mx > MinX then dec Mx
        Ps[P].Face = 1
      elseif (S & 8) <> 0 then
        if Mx < MaxX then inc Mx
        Ps[P].Face = 0
      end if
    end if
  end if
  Ps[P].X = Mx
  Ps[P].Y = My
  ' the picture: climbing on a ladder, running on a floor
  Off = (My - TopY) & 31
  if Off <> 0 then
    if (My & 4) = 0 then
      Ps[P].Spr = SClimb1
    else
      Ps[P].Spr = SClimb2
    end if
  else
    Lad = (Mx >> 2) & 1
    select case (Ps[P].Face, Lad)
    case (0, 0)
      Ps[P].Spr = SRunr1
    case (0, 1)
      Ps[P].Spr = SRunr2
    case (1, 0)
      Ps[P].Spr = SRunl1
    case else
      Ps[P].Spr = SRunl2
    end select
  end if
  return
end sub

' a shot in the stick's direction (or the way the player faces)
sub Shoot(u8 P):
  u8 D = Pad[P] & 15
  if D = 0 then
    D = 8
    if Ps[P].Face = 1 then D = 4
  end if
  Bd[P] = D
  Bx[P] = Ps[P].X + 6
  By[P] = Ps[P].Y + 5
  if (D & 1) <> 0 then By[P] -= 6
  if (D & 2) <> 0 then By[P] += 6
  if (D & 4) <> 0 then Bx[P] -= 6
  if (D & 8) <> 0 then Bx[P] += 6
  inc Shots
  play sound SndShot
  return
end sub

sub MoveShots:
  for Si = 0 to 1
    V = Bd[Si]
    if V <> 0 then
      if (V & 1) <> 0 then By[Si] -= ShotSpd
      if (V & 2) <> 0 then By[Si] += ShotSpd
      if (V & 4) <> 0 then Bx[Si] -= ShotSpd
      if (V & 8) <> 0 then Bx[Si] += ShotSpd
      X = Bx[Si]
      Y = By[Si]
      if X < 8 then Bd[Si] = 0
      if X > 244 then Bd[Si] = 0
      if Y < 8 then Bd[Si] = 0
      if Y > 180 then Bd[Si] = 0
    end if
  next
  return
end sub

' a shot on the other player, or the two players touching
sub CheckHits:
  u8 Q = 0
  u16 Dd = 0
  for Si = 0 to 1
    Q = Si ^ 1
    if Bd[Si] <> 0 then
      X = Ps[Q].X
      Y = Ps[Q].Y
      if Bx[Si] + 2 >= X + 3 then
        if Bx[Si] <= X + 12 then
          if By[Si] + 2 >= Y then
            if By[Si] <= Y + 15 then
              Bd[Si] = 0
              inc Hits
              play sound SndHit
              SendHome(Q)
            end if
          end if
        end if
      end if
    end if
  next
  ' touching: closer than 8 pixels across and 14 up or down
  Dd = AbsDiff(Ps[0].X, Ps[1].X)
  if Dd < 8 then
    Dd = AbsDiff(Ps[0].Y, Ps[1].Y)
    if Dd < 14 then
      play sound SndHit
      SendHome(0)
      SendHome(1)
    end if
  end if
  return
end sub

function BitOf(u8 B) as u8
  select case B
  case 0
    return 1
  case 1
    return 2
  case 2
    return 4
  end select
  return 8

function AbsDiff(u8 A, u8 B) as u16
  if A >= B then return A - B
  return B - A

' a player goes home; the flag he carried goes back to its spot
sub SendHome(u8 Q):
  if Ps[Q].Carry = 1 then DrawFlag(Q ^ 1)
  PlaceHome(Q)
  if Q = 1 then AiWay = random(0, 15)
  return
end sub

' take the other flag on its spot; bring it to your own flag's spot
sub CheckFlags:
  u8 Q = 0
  for Si = 0 to 1
    Q = Si ^ 1
    X = Ps[Si].X
    Y = Ps[Si].Y
    if Ps[Si].Carry = 0 then
      if Y = HomeY[Q] then
        if AbsDiff(X, FlagX[Q]) <= 3 then
          Ps[Si].Carry = 1
          EraseFlag(Q)
          play sound SndGrab
        end if
      end if
    else
      if Y = HomeY[Si] then
        if AbsDiff(X, FlagX[Si]) <= 3 then
          if Phase = 1 then
            Winner = Si
            Phase = 2
          end if
        end if
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the computer plays red: up and down the ladders to green's flag, home
' with it, and a shot when green has stood in its line for a moment

sub AiThink:
  u8 S = 0
  u8 Gf = 0
  u8 Gx = 120
  u8 Mx = Ps[1].X
  u8 My = Ps[1].Y
  u8 Off = (My - TopY) & 31
  u8 L = (My - TopY) >> 5
  u8 B = 0
  u8 T = 0
  u8 Want = 0
  u16 Dx = 0
  u16 Dy = 0
  if Ps[1].Carry = 1 then
    Gf = 4
    Gx = 80
  end if
  if Off <> 0 then
    if Gf <= L then
      S = 1
    else
      S = 2
    end if
  elseif L = Gf then
    if Mx + 1 < Gx then S = 8
    if Mx > Gx + 1 then S = 4
  else
    B = L
    if Gf < L then B = L - 1
    T = LadA[B]
    if LadB[B] <> 0 then
      if (AiWay & BitOf(B)) <> 0 then T = LadB[B]
    end if
    if Mx + 2 < T then
      S = 8
    elseif Mx > T + 2 then
      S = 4
    elseif Gf < L then
      S = 1
    else
      S = 2
    end if
  end if
  ' a shot?
  if AiCool > 0 then dec AiCool
  if Bd[1] = 0 then
    if AiCool = 0 then
      Dx = AbsDiff(Mx, Ps[0].X)
      Dy = AbsDiff(My, Ps[0].Y)
      if Dy = 0 then
        if Off = 0 then
          if Dx < 150 then
            Want = 8
            if Ps[0].X < Mx then Want = 4
          end if
        end if
      elseif Dx < 6 then
        Want = 2
        if Ps[0].Y < My then Want = 1
      elseif AbsDiff(Dx, Dy) < 8 then
        if Dy < 100 then
          Want = 2
          if Ps[0].Y < My then Want = 1
          if Ps[0].X < Mx then
            Want = Want | 4
          else
            Want = Want | 8
          end if
        end if
      end if
      if Want <> 0 then
        inc AiSee
        if AiSee >= AiReact then
          S = Want | 16
          AiSee = 0
          AiCool = AiRest
        end if
      else
        AiSee = 0
      end if
    end if
  end if
  Pad[1] = S
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub DrawField:
  NewScreen
  for Ri = 0 to 4
    Y = Ri * 4 + 5
    fill TFloor count 28 at 2,Y
  next
  for Ri = 0 to 3
    DrawLadder(Ri, LadA[Ri])
    if LadB[Ri] <> 0 then DrawLadder(Ri, LadB[Ri])
  next
  ' home pads and flags
  X = FlagX[0] >> 3
  fill TPadg count 2 at X,5
  X = FlagX[1] >> 3
  fill TPadr count 2 at X,21
  DrawFlag(0)
  DrawFlag(1)
  ShowHud
  return
end sub

' a ladder from floor B down to floor B+1, at pixel x Lx
sub DrawLadder(u8 B, u8 Lx):
  u8 C = Lx >> 3
  u8 R = B * 4 + 5
  u8 C2 = C + 1
  put char THatchl at C,R
  put char THatchr at C2,R
  for K = 1 to 3
    put char TLadl at C,R + K
    put char TLadr at C2,R + K
  next
  return
end sub

sub DrawFlag(u8 Q):
  u8 C = FlagX[Q] >> 3
  u8 R = HomeFl[Q] * 4 + 3
  u8 T = TFlagg00 + Q * 4
  put char T at C,R
  put char T + 1 at C + 1,R
  put char T + 2 at C,R + 1
  put char T + 3 at C + 1,R + 1
  return
end sub

sub EraseFlag(u8 Q):
  u8 C = FlagX[Q] >> 3
  u8 R = HomeFl[Q] * 4 + 3
  fill 32 count 2 at C,R
  fill 32 count 2 at C,R + 1
  return
end sub

sub ClearBand:
  fill 32 count 28 at 2,MsgRow - 1
  fill 32 count 28 at 2,MsgRow
  fill 32 count 28 at 2,MsgRow + 1
  return
end sub

sub ShowHud:
  print at 2,1, "GREEN"
  NumU = Sc[0]
  print at 8,1, digits$(NumU, 1)
  print at 12,1, "FLAG HUNT"
  print at 24,1, "RED"
  NumU = Sc[1]
  print at 28,1, digits$(NumU, 1)
  return
end sub

sub DrawSprites:
  for Si = 0 to 1
    Y = Ps[Si].Y - 1
    set sprite Si to Y,Ps[Si].X,Ps[Si].Spr,PlCol[Si]
    if Ps[Si].Carry = 1 then
      Y = Ps[Si].Y - 8
      set sprite Si + 2 to Y,Ps[Si].X,SCarry,PlCol[Si ^ 1]
    else
      set sprite Si + 2 to 192,0,SCarry,0
    end if
    if Bd[Si] <> 0 then
      Y = By[Si] - 1
      set sprite Si + 4 to Y,Bx[Si],SShot,ShotCol[Si]
    else
      set sprite Si + 4 to 192,0,SShot,0
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for K = 0 to 5
    set sprite K to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: FLAG HUNT in blocks, the two flags on a floor, START /
' PLAYERS / CREDITS, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 512 to vram.name + 32
  fill TFloor count 28 at 2,18
  put char TFlagg00 at 3,16
  put char TFlagg01 at 4,16
  put char TFlagg10 at 3,17
  put char TFlagg11 at 4,17
  put char TFlagr00 at 26,16
  put char TFlagr01 at 27,16
  put char TFlagr10 at 26,17
  put char TFlagr11 at 27,17
  Sel = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  K = StickOf(1)
  N = StickOf(2)
  OldPads = Pads
  Pads = K | N
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 2 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  if Sel = 1 then
    if (N & 28) <> 0 then
      NPl = 3 - NPl
      play sound SndPick
      ShowMenu
    end if
  else
    if (N & 16) <> 0 then goto tp_done
  end if
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Cpu = 0
  if NPl = 1 then Cpu = 1
  if Sel = 2 then
    CreditsPage
  end if
  return
end sub

sub ShowMenu:
  for K = 0 to 2
    put char 32 at 7,K + 20
  next
  put char 62 at 7,Sel + 20
  print at 9,20, "START"
  if NPl = 1 then
    print at 9,21, "ONE VS COMPUTER"
  else
    print at 9,21, "TWO PLAYERS    "
  end if
  print at 9,22, "CREDITS"
  return
end sub

sub CreditsPage:
  NewScreen
  print at 11,2, "FLAG  HUNT"
  print at 2,5, "BASED ON FLAG HUNT BY"
  print at 2,6, "JOHN FEDOR, AHOY! JANUARY"
  print at 2,7, "1989 (COMMODORE 64)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "MUSIC: COLOUR GUARD"
  print at 2,16, "(ORIGINAL)"
  print at 2,18, "TAKE THE OTHER FLAG HOME."
  print at 2,19, "THREE CAPTURES WIN."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
FhShot:
    db $00,$00,$25,$02,$00,$00,$46,$02,$00,$00,$76,$03,$10
FhHit:
    db $40,$7F,$10,$03,$40,$A9,$20,$03,$40,$E2,$20,$03,$40,$2E,$31,$04,$40,$94,$41,$06,$50
FhGrab:
    db $40,$8F,$20,$03,$40,$71,$20,$03,$40,$55,$30,$05,$50
FhScore:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$0C,$50
FhWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$20,$08,$40,$6B,$20,$18
    db $50
FhPick:
    db $40,$55,$40,$02,$50

FhSoundTable:
    dw FhTuneMel,$702B
    dw FhTuneBass,$7035
    dw FhShot,$703F
    dw FhHit,$7049
    dw FhGrab,$7049
    dw FhScore,$7049
    dw FhWin,$7049
    dw FhPick,$7049
; Colour Guard (original)
; Tiny Sound, 8 frames per step
FhTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$26,$01,$26,$2A,$2D,$01,$2A,$01,$26,$01
    db $28,$01,$01,$01,$25,$01,$28,$01,$28,$2B,$2D,$01,$2B,$01,$28,$01
    db $2A,$01,$01,$01,$21,$01,$26,$01,$26,$2A,$2D,$01,$2F,$01,$2D,$01
    db $2A,$01,$2B,$01,$28,$01,$25,$01,$28,$01,$01,$01,$26,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
FhTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$0E,$01,$15,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $09,$01,$01,$01,$09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$10,$01
    db $0E,$01,$01,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$13,$01,$0E,$01
    db $0B,$01,$01,$01,$09,$01,$10,$01,$09,$01,$0D,$01,$0E,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
