const PosCheck = 18

' each line's three squares: rows 0-2, then columns 0-2
data LineCell bytes
  0, 1, 2, 3, 4, 5, 6, 7, 8, 0, 3, 6, 1, 4, 7, 2, 5, 8
end data
' screen place of each square
data CellC bytes
  6, 12, 18, 6, 12, 18, 6, 12, 18
end data
data CellR bytes
  3, 3, 3, 7, 7, 7, 11, 11, 11
end data
' the signs (two per line, lines in LineCell order)
data OpC bytes
  9, 15, 9, 15, 9, 15, 6, 6, 12, 12, 18, 18
end data
data OpR bytes
  3, 3, 7, 7, 11, 11, 5, 9, 5, 9, 5, 9
end data
' the equals sign, the total and the mark of each line
data EqC bytes
  21, 21, 21, 6, 12, 18
end data
data EqR bytes
  3, 7, 11, 13, 13, 13
end data
data TotC bytes
  24, 24, 24, 6, 12, 18
end data
data TotR bytes
  3, 7, 11, 15, 15, 15
end data
data MarkC bytes
  27, 27, 27, 8, 14, 20
end data
data MarkR bytes
  4, 8, 12, 16, 16, 16
end data
' cursor moves: up, down, left, right for each place (255 = stay);
' places 0-8 squares, 9-17 tray, 18 CHECK
data Nav bytes
  255, 3, 255, 1, 255, 4, 0, 2, 255, 5, 1, 255
  0, 6, 255, 4, 1, 7, 3, 5, 2, 8, 4, 255
  3, 10, 255, 7, 4, 12, 6, 8, 5, 14, 7, 18
  6, 255, 255, 10, 6, 255, 9, 11, 6, 255, 10, 12
  7, 255, 11, 13, 7, 255, 12, 14, 8, 255, 13, 15
  8, 255, 14, 16, 18, 255, 15, 17, 18, 255, 16, 255
  8, 17, 8, 255
end data
' the title's key row lights up in this "dialled" order
data DialT bytes
  4, 0, 8, 2, 6, 1, 7, 3, 5
end data

' the title letters: N U M B E R P L A S ? glyph order
data TitleGl bytes
  0, 1, 2, 3, 4, 5, 6, 7, 4, 8, 9, 4, 10
end data

record Square:
  u8 V
  u8 Fix
end record

Square Cl[9]
' the puzzle: the made-up answer, the signs (0 + 1 - 2 x 3 /), the totals
u8 Nn[9]
u8 Ops[12]
u8 Tot[6]
u8 Tray[9]
u8 Mark[6]
u8 Used[10]
' game state
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u8 Hints = 0
u8 CallN = 1
u8 TryN = 1
u8 Solved = 0
u8 Pos = 0
u8 Held = 0
u8 Over = 0
u8 St = 0
u8 MsgT = 0
u8 After = 0
u8 Units = 0
u16 PSeed = 0
' arithmetic
i16 Wq = 0
u8 Bad = 0
' random numbers, title
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Menu = 0
u8 TitleOn = 0
u8 DialI = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Lj = 0
u8 Ki = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table NpSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowToPage
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Sc > Hi then Hi = Sc
  EndPage
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a number from 1 to N
function Roll(u8 Nr) as u8
  u16 Wm = 0
  u8 Res = 0
  Rand
  Wm = Nr
  Wm = Rs % Wm
  Res = Wm
  Res = Res + 1
  return Res

' one step of a line, left to right; Bad = 1 when a division is not exact
function Apply(i16 Ua, i16 Va, u8 Ra) as i16
  i16 Wa = 0
  select case Ra
  case 0
    Wa = Ua + Va
  case 1
    Wa = Ua - Va
  case 2
    Wa = Ua * Va
  case else
    Wa = Ua / Va
    Wq = Wa * Va
    if Wq <> Ua then Bad = 1
  end select
  return Wa

' the signs and totals of all six lines (lines 480-650)
sub MakeOps:
  u8 Big = 1
  u8 Base = 0
  u8 Cn = 0
  u8 Rr = 0
  u8 Okk = 0
  i16 Acc = 0
  i16 Nx = 0
  i16 Wv = 0
  while Big = 1
    for Li = 0 to 5
      Base = Li * 3
      Cn = LineCell[Base]
      Acc = Nn[Cn]
      for Lj = 0 to 1
        Cn = Base + Lj
        Cn = Cn + 1
        Cn = LineCell[Cn]
        Nx = Nn[Cn]
        Okk = 0
        while Okk = 0
          Rr = Roll(4) - 1
          Bad = 0
          Wv = Apply(Acc, Nx, Rr)
          if Bad = 0 then
            if Wv >= 1 then Okk = 1
          end if
        end while
        Cn = Li * 2 + Lj
        Ops[Cn] = Rr
        Acc = Wv
      next
      Tot[Li] = Acc
    next
    Big = 0
    for Li = 0 to 5
      if Tot[Li] > 99 then Big = 1
    next
  end while
  return
end sub

' a new puzzle (lines 470-830)
sub NewPuzzle:
  PSeed = Rs
  for Ki = 0 to 8
    Nn[Ki] = Roll(9)
    Cl[Ki].V = 0
    Cl[Ki].Fix = 0
    Tray[Ki] = 0
  next
  MakeOps
  ' the tray: each digit in a free random place
  for Ki = 0 to 8
    V = Roll(9) - 1
    while Tray[V] > 0
      V = Roll(9) - 1
    end while
    Tray[V] = Nn[Ki]
  next
  ' the given squares, and their digits out of the tray
  for Ki = 1 to Hints
    V = Roll(9) - 1
    while Cl[V].Fix = 1
      V = Roll(9) - 1
    end while
    T = Nn[V]
    Cl[V].V = T
    Cl[V].Fix = 1
    TakeFromTray(T)
  next
  for Ki = 0 to 5
    Mark[Ki] = 0
  next
  TryN = 1
  Held = 0
  Pos = 0
  St = 0
  return
end sub

sub TakeFromTray(u8 Dt):
  u8 Ft = 0
  u8 St2 = 0
  for St2 = 0 to 8
    if Ft = 0 then
      if Tray[St2] = Dt then
        Tray[St2] = 0
        Ft = 1
      end if
    end if
  next
  return
end sub

' 1 when a line of the board works out to its total, else 2
function LineOk(u8 Ln) as u8
  u8 Bs = 0
  u8 Cq = 0
  u8 Oq = 0
  i16 Acq = 0
  i16 Nq = 0
  Bad = 0
  Bs = Ln * 3
  Cq = LineCell[Bs]
  Acq = Cl[Cq].V
  for Oq = 0 to 1
    Cq = LineCell[Bs + Oq + 1]
    Nq = Cl[Cq].V
    Cq = Ln * 2 + Oq
    Acq = Apply(Acq, Nq, Ops[Cq])
  next
  if Bad = 1 then return 2
  if Acq = Tot[Ln] then return 1
  return 2

' squares still empty
function Empties as u8
  u8 Ne = 0
  u8 Ie = 0
  for Ie = 0 to 8
    if Cl[Ie].V = 0 then inc Ne
  next
  return Ne

' 25 points per unit
sub AddPts(u8 Nu):
  u8 Iu = 0
  for Iu = 1 to Nu
    Sc += 25
  next
  return
end sub

' ---------------------------------------------------------------------------
' play

sub PlayStep:
  select case St
  case 0
    Control
  case else
    dec MsgT
    if MsgT = 0 then AfterMsg
  end select
  return
end sub

sub Control:
  K = 255
  if Edge & 1 then K = 0
  if Edge & 2 then K = 1
  if Edge & 4 then K = 2
  if Edge & 8 then K = 3
  if K < 4 then
    C = Pos << 2
    C = C + K
    V = Nav[C]
    if V < 255 then
      Pos = V
      play sound SndMove
    end if
  end if
  if Press = 1 then Act
  return
end sub

sub Act:
  if Pos = PosCheck then
    TryCheck
    return
  end if
  if Pos >= 9 then
    TrayAct
    return
  end if
  SquareAct
  return
end sub

sub SquareAct:
  V = Cl[Pos].V
  if Cl[Pos].Fix = 1 then
    play sound SndBuzz
    Say(1)
    return
  end if
  if Held = 0 then
    if V = 0 then
      play sound SndBuzz
      return
    end if
    play sound SndPick
  else
    play sound SndDrop
  end if
  Cl[Pos].V = Held
  Held = V
  DrawSquare(Pos)
  Say(0)
  return
end sub

sub TrayAct:
  K = Pos - 9
  V = Tray[K]
  if Held = 0 then
    if V = 0 then
      play sound SndBuzz
      return
    end if
    play sound SndPick
  else
    play sound SndDrop
  end if
  Tray[K] = Held
  Held = V
  DrawTraySlot(K)
  Say(0)
  return
end sub

sub TryCheck:
  if Held > 0 then
    play sound SndBuzz
    Say(2)
    return
  end if
  if Empties > 0 then
    play sound SndBuzz
    Say(3)
    return
  end if
  Solved = 1
  for Ki = 0 to 5
    V = LineOk(Ki)
    Mark[Ki] = V
    if V = 2 then Solved = 0
  next
  if Solved = 1 then
    V = 4 - Hints
    K = 4 - TryN
    Units = V * K
    AddPts(Units)
    play sound SndRight
    DrawMarks
    ShowHud
    Say(4)
    MsgT = 180
    After = 1
    St = 1
    return
  end if
  DrawMarks
  if TryN >= NTries then
    play sound SndReveal
    Reveal
    Say(5)
    MsgT = 240
    After = 1
  else
    play sound SndWrong
    inc TryN
    ShowTry
    Say(6)
    MsgT = 90
    After = 2
  end if
  St = 1
  return
end sub

sub AfterMsg:
  if After = 1 then
    inc CallN
    if CallN > NCalls then
      Over = 1
      return
    end if
    play sound SndRing
    NewPuzzle
    DrawBoard
    ShowHud
  end if
  Say(0)
  St = 0
  return
end sub

' the made-up answer on blue plates
sub Reveal:
  for Ki = 0 to 8
    Cl[Ki].V = Nn[Ki]
    Cl[Ki].Fix = 1
    DrawSquare(Ki)
  next
  Held = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a 2 x 2 picture whose four tiles follow each other from Tb
sub PutBig(u8 Tb, u8 Bc, u8 Br):
  u8 Bc1 = 0
  Bc1 = Bc + 1
  put char Tb at Bc,Br
  inc Tb
  put char Tb at Bc1,Br
  inc Tb
  Br = Br + 1
  put char Tb at Bc,Br
  inc Tb
  put char Tb at Bc1,Br
  return
end sub

function KeyTile(u8 Dk, u8 Fk) as u8
  u8 Tk = 0
  if Dk = 0 then return TE00
  Tk = Dk - 1
  Tk = Tk << 2
  if Fk = 1 then
    Tk = Tk + TG100
  else
    Tk = Tk + TP100
  end if
  return Tk

sub DrawSquare(u8 Sq):
  u8 Ts = 0
  Ts = KeyTile(Cl[Sq].V, Cl[Sq].Fix)
  PutBig(Ts, CellC[Sq], CellR[Sq])
  return
end sub

sub DrawTraySlot(u8 Sl):
  u8 Ct = 0
  u8 Vt = 0
  Ct = Sl * 3
  Ct = Ct + 3
  Vt = Tray[Sl]
  if Vt = 0 then
    fill TBlk count 2 at Ct,TrayRow
    fill TBlk count 2 at Ct,TrayRow + 1
  else
    PutBig(KeyTile(Vt, 0), Ct, TrayRow)
  end if
  return
end sub

' a total in two lamp digits (the tens dark when 0)
sub DrawTotal(u8 Tl):
  u8 Tv = 0
  u8 Td = 0
  u8 Tc = 0
  u8 Tr = 0
  Tv = Tot[Tl]
  Tc = TotC[Tl]
  Tr = TotR[Tl]
  Td = Tv / 10
  if Td = 0 then
    put char TBlk at Tc,Tr
    put char TBlk at Tc,Tr + 1
  else
    put char TR0t + Td * 2 at Tc,Tr
    put char TR0b + Td * 2 at Tc,Tr + 1
  end if
  Td = Tv % 10
  inc Tc
  put char TR0t + Td * 2 at Tc,Tr
  put char TR0b + Td * 2 at Tc,Tr + 1
  return
end sub

sub DrawMarks:
  for Ki = 0 to 5
    select case Mark[Ki]
    case 1
      T = TOk
    case 2
      T = TBad
    case else
      T = TWood
    end select
    put char T at MarkC[Ki],MarkR[Ki]
  next
  return
end sub

sub DrawBoard:
  Rearm
  wait
  nmi off
  for Ki = 0 to 8
    DrawSquare(Ki)
    DrawTraySlot(Ki)
  next
  for Ki = 0 to 11
    T = Ops[Ki] << 2
    T = T + TO000
    PutBig(T, OpC[Ki], OpR[Ki])
  next
  for Ki = 0 to 5
    T = TEq00
    if Ki >= 3 then T = TVeq00
    PutBig(T, EqC[Ki], EqR[Ki])
    DrawTotal(Ki)
  next
  DrawMarks
  ShowTry
  return
end sub

sub ShowTry:
  print at 23,15, "CHECK"
  print at 23,16, "TRY "
  put char 48 + TryN at 27,16
  return
end sub

sub ShowHud:
  print at 2,1, "CALL   OF  "
  put char 48 + CallN at 7,1
  put char 48 + NCalls at 12,1
  print at 16,1, "SCORE"
  print Sc at 22,1
  return
end sub

' the message line
sub Say(u8 Mw):
  select case Mw
  case 1
    print at 2,MsgRow, "  THAT NUMBER IS GIVEN.     "
  case 2
    print at 2,MsgRow, "  PUT YOUR KEY DOWN FIRST.  "
  case 3
    print at 2,MsgRow, "  FILL EVERY SQUARE FIRST.  "
  case 4
    print at 2,MsgRow, "  CORRECT!  +               "
    W16 = Units * 25
    print W16 at 15,MsgRow width 3
  case 5
    print at 2,MsgRow, " INCORRECT. THE ANSWER WAS: "
  case 6
    print at 2,MsgRow, " INCORRECT. SAME PUZZLE...  "
  case else
    print at 2,MsgRow, "                            "
  end select
  return
end sub

' sprites: 0 held key ink, 1 held key face, 2-3 the cursor corners
sub DrawSprites:
  X = 0
  Y = 192
  K = 192
  if St = 0 then
    if TitleOn = 0 then
      if Pos < 9 then
        X = CellC[Pos] << 3
        Y = CellR[Pos] << 3
        K = X
      else
        if Pos < PosCheck then
          X = Pos - 9
          X = X * 3
          X = X + 3
          X = X << 3
          Y = TrayRow << 3
          K = X
        else
          X = 176
          K = 216
          Y = 120
        end if
      end if
      dec Y
    end if
  end if
  set sprite 2 to Y,X,SBl,7
  set sprite 3 to Y,K,SBr,7
  if Held > 0 then
    if Y < 192 then
      T = Held - 1
      T = T << 2
      T = T + SK1
      X = X + 4
      Y = Y - 6
      set sprite 0 to Y,X,T,1
      set sprite 1 to Y,X,SKeyf,11
    end if
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub DrawWood:
  for Ki = 2 to 17
    fill TWood count 28 at 2,Ki
  next
  for Ki = 2 to 17
    V = Ki & 1
    if V = 0 then
      put char TWood2 at 4,Ki
      put char TWood2 at 26,Ki
    else
      put char TWood2 at 15,Ki
    end if
  next
  fill TRail count 28 at 2,18
  fill TBlk count 28 at 2,19
  fill TBlk count 28 at 2,20
  fill TRail count 28 at 2,21
  return
end sub

sub NewGame:
  Sc = 0
  CallN = 1
  Over = 0
  TitleOn = 0
  NewScreen
  DrawWood
  NewPuzzle
  DrawBoard
  ShowHud
  Say(0)
  DrawSprites
  ShowScreen
  play sound SndRing
  Rearm
  wait no fire
  nmi off
  return
end sub

sub EndPage:
  Rearm
  wait
  nmi off
  HideSprites
  for Ki = 2 to 21
    fill TBlk count 28 at 2,Ki
  next
  print at 6,5, "THE SWITCHBOARD IS"
  print at 10,6, "CLOSED."
  print at 6,9, "FINAL SCORE"
  print Sc at 18,9
  print at 6,11, "HIGH SCORE"
  print Hi at 18,11
  print at 6,14, "PRESS THE BUTTON"
  Say(0)
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a word of the title in big brass letters (glyph numbers from Wd)
sub TitleWord(u8 Wc, u8 Wr, u8 Wn, u8 Wf):
  u8 Iw = 0
  u8 Tw = 0
  for Iw = 0 to Wn
    Tw = Wf + Iw
    Tw = TitleGl[Tw]
    Tw = Tw << 2
    Tw = Tw + QLn00
    PutBig(Tw, Wc, Wr)
    Wc = Wc + 2
  next
  return
end sub

' the title: NUMBER PLEASE? in brass on the walnut, a row of keys being
' dialled, the tune once, and the choices
sub TitlePage:
  TitleOn = 1
  Menu = 0
  NewScreen
  copy TitlePat count NTitle8 to vram.pattern + 1024
  copy TitleCol count NTitle8 to vram.color + 1024
  copy TitlePat count NTitle8 to vram.pattern + 3072
  for Ki = 2 to 12
    fill QWood count 28 at 2,Ki
  next
  fill QRail count 28 at 2,13
  ' NUMBER (6 letters, columns 10-21) and PLEASE? (7, columns 9-22)
  TitleWord(10, 3, 5, 0)
  TitleWord(9, 6, 6, 6)
  for Ki = 0 to 8
    T = Ki << 2
    T = T + QP100
    C = Ki * 3
    C = C + 3
    PutBig(T, C, 10)
  next
  print at 5,15, "COMPUTE!'S GAZETTE 1987"
  print at 5,17, "HINTS"
  print at 5,18, "START"
  print at 5,19, "HOW TO PLAY"
  print at 5,20, "CREDITS"
  print at 19,21, "HI"
  print Hi at 22,21
  ShowHints
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 470
  TzOn = 1
  DialI = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' a cursor dials the keys in turn, one every half second
  V = Tick & 31
  if V = 0 then
    inc DialI
    if DialI > 8 then DialI = 0
  end if
  C = DialT[DialI]
  X = C * 3
  X = X + 3
  X = X << 3
  set sprite 2 to 79,X,SBl,7
  set sprite 3 to 79,X,SBr,7
  update sprites
  if Edge & 1 then
    if Menu > 0 then dec Menu
    ShowMenu
  end if
  if Edge & 2 then
    if Menu < 3 then inc Menu
    ShowMenu
  end if
  K = Edge & 12
  if K > 0 then
    if Menu = 0 then ChangeHints
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub


sub ChangeHints:
  if Edge & 8 then
    if Hints < 3 then inc Hints
  else
    if Hints > 0 then dec Hints
  end if
  play sound SndMove
  ShowHints
  return
end sub

sub ShowHints:
  put char 48 + Hints at 14,17
  if Hints = 0 then
    print at 16,17, "(HARDEST)"
  else
    print at 16,17, "         "
  end if
  return
end sub

sub ShowMenu:
  for Ki = 0 to 3
    C = Ki + 17
    put char 32 at 3,C
  next
  C = Menu + 17
  put char 62 at 3,C
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "PUT THE NINE NUMBER KEYS"
    print at 2,4, "FROM THE TRAY INTO THE 3 X 3"
    print at 2,5, "BOARD SO THAT EVERY ROW AND"
    print at 2,6, "EVERY COLUMN MAKES THE"
    print at 2,7, "NUMBER AT ITS END."
    print at 2,9, "WORK EACH LINE LEFT TO"
    print at 2,10, "RIGHT (OR TOP TO BOTTOM),"
    print at 2,11, "ONE STEP AT A TIME:"
    print at 2,12, "3 + 4 = 7, THEN 7 X 2 = 14."
    PutBig(KeyTile(3, 0), 4, 15)
    PutBig(TO000, 7, 15)
    PutBig(KeyTile(4, 0), 10, 15)
    PutBig(TO200, 13, 15)
    PutBig(KeyTile(2, 0), 16, 15)
    PutBig(TEq00, 19, 15)
    put char TR0t + 2 at 22,15
    put char TR0b + 2 at 22,16
    put char TR0t + 8 at 23,15
    put char TR0b + 8 at 23,16
  else
    print at 2,1, "CONTROLS AND SCORE     2/2"
    print at 2,3, "THE STICK MOVES THE FRAME."
    print at 2,4, "THE BUTTON PICKS A KEY UP"
    print at 2,5, "AND PUTS IT DOWN. WHEN THE"
    print at 2,6, "BOARD IS FULL, PRESS THE"
    print at 2,7, "BUTTON ON CHECK."
    print at 2,9, "A GAME IS FIVE CALLS. YOU"
    print at 2,10, "GET THREE CHECKS EACH. A"
    print at 2,11, "RIGHT BOARD ON AN EARLY"
    print at 2,12, "CHECK SCORES MORE; HINTS"
    print at 2,13, "(KEYS ALREADY IN PLACE)"
    print at 2,14, "SCORE LESS."
    print at 2,15, "TIP: AFTER A WRONG CHECK,"
    print at 2,16, "A TICK MARKS EVERY LINE"
    print at 2,17, "THAT IS ALREADY RIGHT."
    for Ki = 0 to 4
      C = Ki * 3
      C = C + 9
      T = Ki + 5
      PutBig(KeyTile(T, 0), C, 19)
    next
    set sprite 2 to 151,72,SBl,7
    set sprite 3 to 151,72,SBr,7
    update sprites
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B1
  print at 9,2, "NUMBER PLEASE?"
  print at 2,5, "BASED ON NUMBER PLEASE?,"
  print at 2,6, "COMPUTE!'S GAZETTE,"
  print at 2,7, "OCTOBER 1987 (COMMODORE 64"
  print at 2,8, "AND 128). NO AUTHOR IS"
  print at 2,9, "NAMED IN THE LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: HELLO, CENTRAL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

