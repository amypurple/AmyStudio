const LogoW = 20
const LogoH = 2

data Logo bytes 133,134,135,136,135,137,138,139,133,140,141,142,143,144,141,128,141,128,135,137,145,146,147,145,148,149,150,151,145,152,145,152,153,154,155,149,155,149,148,149
const SndMtLead = 1
const SndMtTwo = 2
const SndMtNoise = 3
const SndMtPitch = 4
const SndMgLead = 5
const SndMgTwo = 6
const SndMgNoise = 7
const SndMgPitch = 8
const SndHop = 9
const SndSide = 10
const SndSplat = 11
const SndSplash = 12
const SndRock = 13
const SndLevel = 14
const SndFly = 15
const SndOver = 16
const SndStart = 17
const MtAreas = 7
const MtLoopFrames = 1344
const MgLoopFrames = 576

' ---------------------------------------------------------------- constants
const StartX = 120      ' frog sprite x on the start bank (columns 15-16)
const MinX = 16         ' side hops keep the frog inside columns 2-29
const MaxX = 224
const LostLo = 8        ' carried this far: lost (centre outside the safe area)
const LostHi = 232
const GoalSlot = 10
const MaxLives = 5

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u8 Off[8]               ' lane offsets: screen x shows content x + Off
u8 Acc[8]               ' speed accumulators (1/16 pixel)
u8 Spd[8]               ' this level's speeds (1/16 pixel per frame)
u8 Mv[8]                ' pixels moved this frame
u8 Dirty = 0            ' lanes to redraw (bit per lane)
u8 Fx = 0               ' frog sprite position
u8 Fy = 0
u8 Slot = 0             ' 0 start bank, 1-4 road, 5 middle bank, 6-9 river, 10 rocks
u8 FDir = 0             ' 0 up, 1 down, 2 left, 3 right
u8 HopT = 0             ' frames left in the hop
u8 HopV = 0             ' 1 up, 2 down, 3 left, 4 right
u8 Best = 0             ' best slot this trip (points)
u8 Mode = 0             ' 0 play, 1 lost, 2 rock reached, 3 level done
u8 ModeT = 0
u8 Lost = 0             ' 1 squashed, 2 drowned
u8 Lives = 3
u8 Level = 1
u8 StartLevel = 1
u8 Filled = 0           ' rocks taken (bit per rock)
u8 RockI = 0
u8 FlyR = 255           ' rock with the fly (255: none)
u16 FlyT = 0
u16 Score = 0
u8 Sd[5]                ' the score as 5 ASCII digits (cheap to draw)
u8 Add = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title
u8 Menu = 0
u16 Cnt = 0
u8 Ln = 0               ' lane scratch
u8 Lh = 0
u8 Q = 0
u8 S = 0
u8 Cn = 0
u16 Base = 0
u8 DlBits = 0           ' DrawLanes (ASM) scratch
u8 DlLane = 0
u8 DlQ = 0
u8 DlS = 0
u8 DlRow = 0
u8 DlI = 0
u16 Dst = 0
u8 Px = 0               ' hit test: pixel x on screen, lane
u8 Hit = 0
u8 Cx = 0
u16 Hx = 0
u8 Bit = 0
u8 K = 0
u8 P = 0
u8 Tx = 0
u8 Ty = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 Hold = 0             ' frames the stick has been held (title)
u8 Tf = 0               ' title frog: hop timer, pad, position
u8 Tp = 0
u8 Tq = 0
u8 Tfx = 0
u8 Tfy = 0

' lanes: top tile row, direction (1 = content moves left), tile row -> lane
data LaneRow bytes 3,5,7,9,13,15,17,19
data LaneLeft bytes 1,0,1,0,1,0,1,0
data RowLane bytes 255,255,255,0,0,1,1,2,2,3,3,255,255,4,4,5,5,6,6,7,7,255,255,255
data Bits bytes 1,2,4,8,16,32,64,128
' slot -> lane (255: a bank)
data SlotLane bytes 255,7,6,5,4,255,3,2,1,0,255
' rocks: sprite x and tile column
data RockX bytes 24,72,120,168,216
data RockC bytes 3,9,15,21,27
' lane speeds per level (1/16 pixel per frame), lanes 0-7 (river top to
' bottom, then road top to bottom); level 10 and up use the last line.
' Tuned with model/frogsim.c (RAPPORT.md).
data Speeds bytes
  5,6,4,7, 6,8,5,7
  6,8,5,9, 8,10,6,9
  8,9,6,10, 9,12,8,10
  9,10,7,12, 10,14,9,12
  10,12,8,14, 12,16,10,14
  11,14,9,16, 14,18,11,16
  12,15,10,18, 15,20,12,18
  14,16,11,19, 16,22,14,19
  15,18,12,21, 18,24,15,21
  16,20,13,23, 20,26,16,23
end data

' ================================================================== program
  tile screen
  set sound table GrSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $5EAD
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLevel
  Lives = 3
  Score = 0
  for K = 0 to 4
    Sd[K] = 48
  next

new_level:
  Phase = 0
  NewLevel
  play sound SndStart
  NewFrog
  StartMusic

play_loop:
  Frame1
  Phase = 1
  update sprites
  DrawLanes
  ReadPad
  StepLanes
  if Mode = 0 then
    FrogPlay
  else
    FrogEvent
  end if
  FlyStep
  if Mode = 9 then goto level_done
  if Mode = 8 then goto game_over
  goto play_loop

level_done:
  Phase = 0
  if Level < 99 then inc Level
  if Lives < MaxLives then inc Lives
  goto new_level

game_over:
  Phase = 0
  GameOver
  goto title

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ the screen
' the play screen's tiles: each third gets its own set (art.py); the font
' keeps space, 0-9 and A-Z: white on dark green in the HUD third, white on
' black elsewhere (the game over panel)
sub LoadPlayTiles:
  LoadT0
  LoadT1
  LoadT2
  fill $F1 count 8 to vram.color + 256
  fill $F1 count 80 to vram.color + 384
  fill $F1 count 208 to vram.color + 520
  fill $F1 count 8 to vram.color + 2304
  fill $F1 count 80 to vram.color + 2432
  fill $F1 count 208 to vram.color + 2568
  fill $FC count 8 to vram.color + 4352
  fill $FC count 80 to vram.color + 4480
  fill $FC count 208 to vram.color + 4616
  return
end sub

sub NewLevel:
  BlankScreen
  ' independent pattern and colour thirds (tile screen mirrors the colours)
  mode 2 screen
  nmi off
  display off
  sprites 16x16
  HideSprites
  ' at most 4 sprites on a line in play: no rotation needed
  sprites flicker off
  LoadPlayTiles
  backdrop black
  copy ScrTop count 96 to vram.name
  copy ScrMid count 64 to vram.name + 352
  copy ScrBot count 96 to vram.name + 672
  ' speeds and random start offsets
  K = Level
  if K > 10 then K = 10
  dec K
  Base = K
  Base = Base << 3
  for Ln = 0 to 7
    Spd[Ln] = Speeds[Base]
    inc Base
    Rnd
    Off[Ln] = R2
    Acc[Ln] = 0
    Mv[Ln] = 0
  next
  Dirty = 255
  DrawLanes
  Filled = 0
  FlyR = 255
  FlyT = 400
  DrawHud
  ShowScreen
  return
end sub

sub DrawHud:
  fill 32 count 28 at 2,22
  HudIcons(T2Life, T2Nolife, Lives, MaxLives, 2, 22)
  print at 9,22, "LV"
  print Level at 12,22 width 2
  ShowScore
  return
end sub

' add Add points to Score and to its 5 digits
sub AddScore:
  Score += Add
  K = 4
  Sd[K] += Add
  ' carry each digit fully before moving left (Add can be 60)
  while K > 0
    P = K - 1
    while Sd[K] >= 58
      Sd[K] -= 10
      inc Sd[P]
    end while
    dec K
  end while
  if Sd[0] >= 58 then Sd[0] = 57
  return
end sub

sub ShowScore:
  put Sd count 5 at 24,22
  return
end sub

' a rock: empty (Filled bit clear) or with a frog
sub DrawRock:
  Tx = RockC[RockI]
  Bit = Bits[RockI]
  P = Filled & Bit
  if P = 0 then
    PutRun(T0Rock00, 2, Tx, 1)
    PutRun(T0Rock10, 2, Tx, 2)
  else
    PutRun(T0Rockf00, 2, Tx, 1)
    PutRun(T0Rockf10, 2, Tx, 2)
  end if
  return
end sub

' ------------------------------------------------------------ the lanes
' redraw the lanes moved last frame: two name rows a lane; each row is one
' VRAM address set, then window q..31 and window 0..q-1 of the pre-shifted
' row (LaneNm + ((lane * 2 + half) * 8 + s) * 32). Inline ASM: 32 BIOS copies
' a frame were too slow when all 8 lanes moved at once (lost frames every 17
' frames at level 2). OUTI + NOP + JP NZ = 30 T between VRAM writes (>= 29).
' NMI is off here (it only runs during Frame1's wait).
sub DrawLanes:
  if Dirty = 0 then return
  asm {
    ld a,(Dirty)
    ld (DlBits),a
    xor a
    ld (DlLane),a
DL_next:
    ld a,(DlBits)
    srl a
    ld (DlBits),a
    jr nc,DL_skip
    ld a,(DlLane)
    ld e,a
    ld d,0
    ld hl,Off
    add hl,de
    ld a,(hl)
    ld b,a
    rrca
    rrca
    rrca
    and 31
    ld (DlQ),a
    ld a,b
    and 7
    ld (DlS),a
    ld hl,LaneRow
    add hl,de
    ld a,(hl)
    ld (DlRow),a
    ld a,e
    add a,a
    ld (DlI),a
    call DL_row
    ld hl,DlRow
    inc (hl)
    ld hl,DlI
    inc (hl)
    call DL_row
DL_skip:
    ld hl,DlLane
    inc (hl)
    ld a,(hl)
    cp 8
    jr nz,DL_next
    jr DL_done
DL_row:
    ld a,(DlRow)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$5800
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld a,(DlI)
    add a,a
    add a,a
    add a,a
    ld hl,DlS
    add a,(hl)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,LaneNm
    add hl,de
    push hl
    ld a,(DlQ)
    ld e,a
    ld d,0
    add hl,de
    ld a,32
    sub e
    ld b,a
    ld c,$BE
DL_o1:
    outi
    nop
    jp nz,DL_o1
    pop hl
    ld a,(DlQ)
    or a
    ret z
    ld b,a
DL_o2:
    outi
    nop
    jp nz,DL_o2
    ret
DL_done:
  }
  Dirty = 0
  return
end sub

' advance every lane by its speed; Mv = pixels moved, Dirty = lanes to
' redraw (inline ASM for the frame budget: at level 9 and up every lane
' moves every frame). For each lane: k = Acc + Spd; Acc = k & 15;
' Mv = k >> 4; Off += Mv (content moving left) or Off -= Mv; Dirty |= bit.
' Uses DrawLanes' scratch bytes (DlLane, DlBits); AF BC DE HL only.
sub StepLanes:
  asm {
    xor a
    ld (DlLane),a
    inc a
    ld (DlBits),a
SL_loop:
    ld a,(DlLane)
    ld e,a
    ld d,0
    ld hl,Spd
    add hl,de
    ld b,(hl)
    ld hl,Acc
    add hl,de
    ld a,(hl)
    add a,b
    ld b,a
    and 15
    ld (hl),a
    ld a,b
    rrca
    rrca
    rrca
    rrca
    and 15
    ld b,a
    ld hl,Mv
    add hl,de
    ld (hl),a
    or a
    jr z,SL_next
    ld a,(DlBits)
    ld hl,Dirty
    or (hl)
    ld (hl),a
    ld hl,LaneLeft
    add hl,de
    ld a,(hl)
    ld hl,Off
    add hl,de
    or a
    ld a,b
    jr nz,SL_add
    neg
SL_add:
    add a,(hl)
    ld (hl),a
SL_next:
    ld hl,DlBits
    sla (hl)
    ld hl,DlLane
    inc (hl)
    ld a,(hl)
    cp 8
    jr nz,SL_loop
  }
  return
end sub

' Hit = 1 if lane Ln has an object at screen pixel Px (4-pixel columns)
sub LaneHitAt:
  Cx = Px + Off[Ln]
  Cx = Cx >> 2
  Hx = Ln
  Hx = Hx << 6
  Hx += Cx
  Hit = LaneHit[Hx]
  return
end sub

' ------------------------------------------------------------ the frog
sub NewFrog:
  Fx = StartX
  Slot = 0
  Fy = 167
  FDir = 0
  HopT = 0
  HopV = 0
  Best = 0
  Mode = 0
  Lost = 0
  DrawFrog
  return
end sub

sub DrawFrog:
  P = FDir << 4
  if HopT > 0 then P += 8
  set sprite 0 to Fy,Fx,P,3
  P += 4
  set sprite 1 to Fy,Fx,P,1
  return
end sub

' one frame of play: ride, hop, input, collisions
sub FrogPlay:
  ' the lane under the frog's centre
  K = Fy + 9
  K = K >> 3
  Ln = RowLane[K]
  ' riding: the river carries the frog (even in the air)
  if Ln < 4 then
    P = Mv[Ln]
    if LaneLeft[Ln] = 1 then
      Fx -= P
    else
      Fx += P
    end if
  end if
  ' the hop in progress
  if HopT > 0 then
    if HopV = 1 then Fy -= 2
    if HopV = 2 then Fy += 2
    if HopV = 3 then Fx -= 2
    if HopV = 4 then Fx += 2
    dec HopT
    if HopT = 0 then
      HopV = 0
      if Slot = GoalSlot then
        Landed
        return
      end if
    end if
  end if
  ' a new hop
  if HopT = 0 then
    P = Up1 | Btn
    if P = 1 then
      if Slot < GoalSlot then
        inc Slot
        HopV = 1
        HopT = 8
        FDir = 0
        play sound SndHop
        if Slot > Best then
          Best = Slot
          Add = 1
          AddScore
          ShowScore
        end if
      end if
    else
      if Dn1 = 1 then
        if Slot > 0 then
          dec Slot
          HopV = 2
          HopT = 8
          FDir = 1
          play sound SndHop
        end if
      else
        if Lf1 = 1 then
          FDir = 2
          if Fx >= 24 then
            HopV = 3
            HopT = 4
            play sound SndSide
          end if
        end if
        if Rt1 = 1 then
          FDir = 3
          if Fx <= 216 then
            HopV = 4
            HopT = 4
            play sound SndSide
          end if
        end if
      end if
    end if
  end if
  ' collisions, with the lane under the centre now
  K = Fy + 9
  K = K >> 3
  Ln = RowLane[K]
  if Ln < 8 then
    if Ln >= 4 then
      ' road: a vehicle at either side of the frog's body
      Px = Fx + 4
      LaneHitAt
      if Hit = 0 then
        Px = Fx + 11
        LaneHitAt
      end if
      if Hit = 1 then
        Lose(1)
        return
      end if
    else
      ' river: standing (not in a forward or back hop) on wood or a crocodile
      P = HopV
      if P > 2 then P = 0
      if P = 0 then
        Px = Fx + 5
        LaneHitAt
        if Hit = 0 then
          Px = Fx + 10
          LaneHitAt
        end if
        if Hit = 0 then
          Lose(2)
          return
        end if
      end if
    end if
  end if
  ' carried off the side
  if Fx < LostLo then
    Lose(2)
    return
  end if
  if Fx > LostHi then
    Lose(2)
    return
  end if
  DrawFrog
  return
end sub

' the frog landed on the rock row: a free rock, or the bank (lost)
sub Landed:
  RockI = 255
  for K = 0 to 4
    P = RockX[K] + 7
    if Fx <= P then
      P = RockX[K] - 7
      if Fx >= P then RockI = K
    end if
  next
  if RockI = 255 then
    Lose(2)
    return
  end if
  Bit = Bits[RockI]
  P = Filled & Bit
  if P <> 0 then
    Lose(2)
    return
  end if
  ' home on the rock
  Filled = Filled | Bit
  Add = 10
  if FlyR = RockI then
    Add = 60
    FlyR = 255
    FlyT = 600
    hide sprite 2
  end if
  AddScore
  hide sprite 0
  hide sprite 1
  Fx = RockX[RockI]
  Mode = 2
  ModeT = 50
  play sound SndRock
  if Filled = 31 then
    Mode = 3
    ModeT = 180
    Add = 50
    AddScore
    StopMusic
    play sound SndLevel
  end if
  return
end sub

' the frog is lost: 1 = squashed (or bumped the bank), 2 = drowned
sub Lose(u8 How):
  Lost = How
  Mode = 1
  ModeT = 90
  StopMusic
  if How = 1 then
    play sound SndSplat
    set sprite 0 to Fy,Fx,SpSplat0,SpSplatC0
    set sprite 1 to Fy,Fx,SpSplat1,SpSplatC1
  else
    play sound SndSplash
    hide sprite 0
    hide sprite 1
    if Fx < 16 then Fx = 16
    if Fx > 224 then Fx = 224
  end if
  return
end sub

' lost / rock / level done: the lanes keep moving while these play
sub FrogEvent:
  dec ModeT
  if Mode = 1 then
    if Lost = 2 then
      ' splash rings, three sizes, twice
      P = ModeT >> 3
      P = P % 3
      P = 2 - P
      P = P << 2
      P += SpSplash0
      if ModeT > 40 then
        set sprite 3 to Fy,Fx,P,15
      else
        hide sprite 3
      end if
    end if
    if ModeT = 0 then
      hide sprite 3
      dec Lives
      if Lives = 0 then
        Mode = 8
        return
      end if
      DrawHud
      NewFrog
      StartMusic
    end if
    return
  end if
  ' the frame after the landing: the frog on its rock, the new score
  if ModeT = 49 then DrawRock
  if ModeT = 179 then DrawRock
  if ModeT = 48 then ShowScore
  if ModeT = 178 then ShowScore
  ' a sparkle over the rock just taken (Mode 2) or over each rock in turn
  if Mode = 3 then
    P = ModeT >> 4
    P = P % 5
    Tx = RockX[P]
  else
    Tx = Fx
  end if
  P = ModeT >> 3
  P = P & 1
  P = P << 2
  P += SpSpark0
  set sprite 3 to 7,Tx,P,11
  if ModeT = 0 then
    hide sprite 3
    if Mode = 3 then
      Mode = 9
      return
    end if
    NewFrog
  end if
  return
end sub

' the fly: rests on a free rock for 6 seconds now and then
sub FlyStep:
  if Mode = 3 then
    hide sprite 2
    return
  end if
  dec FlyT
  if FlyR = 255 then
    if FlyT = 0 then
      Rnd
      K = R2 % 5
      Bit = Bits[K]
      P = Filled & Bit
      if P = 0 then
        FlyR = K
        FlyT = 360
        play sound SndFly
      else
        FlyT = 60
      end if
    end if
    return
  end if
  if FlyT = 0 then
    FlyR = 255
    Rnd
    FlyT = 300 + R2
    hide sprite 2
    return
  end if
  Tx = RockX[FlyR]
  P = Tick >> 3
  P = P & 1
  P = P << 2
  P += SpFly0
  set sprite 2 to 5,Tx,P,1
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  HideSprites
  ' a panel over the road: rows 8-14, columns 7-24 (third 1: black text)
  for Ty = 8 to 14
    fill 32 count 18 at 7,Ty
  next
  for Tx = 7 to 24
    put char T1Kerb0 at Tx,8
    put char T1Kerb1 at Tx,14
  next
  print at 11,10, "GAME OVER"
  print at 10,12, "LV"
  print Level at 13,12 width 2
  print Score at 17,12 width 5
  play sound SndOver
  for Cnt = 1 to 150
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  tile screen
  nmi off
  display off
  sprites 16x16
  HideSprites
  copy TiPat count TiBytes to vram.pattern + 1024
  copy TiCol count TiBytes to vram.color + 1024
  copy TiPat count TiBytes to vram.pattern + 3072
  copy TiCol count TiBytes to vram.color + 3072
  copy TiPat count TiBytes to vram.pattern + 5120
  copy TiCol count TiBytes to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' a strip of pond (rows Ty and Ty+1): water, pads, reeds
sub PondStrip:
  fill TiPond count 32 at 0,Ty
  K = Ty + 1
  fill TiPond count 32 at 0,K
  put char TiReed at 2,Ty
  put char TiReedr at 29,Ty
  PutRun(TiPad00, 2, 6, K)
  PutRun(TiPadf00, 2, 15, K)
  PutRun(TiPad00, 2, 24, K)
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  Ty = 18
  PondStrip
  ShowScreen
  set sprite 0 to 135,120,SpFrogusit0,3
  set sprite 1 to 135,120,SpFrogusit1,1
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  ShowScreen
  ' the frog, a car, a log-riding frog
  set sprite 0 to 23,24,SpFrogusit0,3
  set sprite 1 to 23,24,SpFrogusit1,1
  set sprite 2 to 131,24,SpTcar0,SpTcarC0
  set sprite 3 to 131,24,SpTcar1,SpTcarC1
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  TextScreen
  PageHelp2
  ShowScreen
  set sprite 0 to 31,24,SpFrogusit0,3
  set sprite 1 to 31,24,SpFrogusit1,1
  set sprite 2 to 90,24,SpFly0,11
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' ------------------------------------------------------------ title
data Stars bytes 2,0, 7,1, 29,0, 26,4, 3,4, 12,0, 19,1, 23,0, 0,2, 31,3
data PadX bytes 48,120,192,120

sub TitleScreen:
  TextScreen
  ' sky: dark blue rows 0-4 with stars, light blue row 5, tree line rows 6-7
  for Ty = 0 to 4
    fill TiSkyn count 32 at 0,Ty
  next
  fill TiSkyb count 32 at 0,5
  for K = 0 to 9
    P = K << 1
    Tx = Stars[P]
    inc P
    Ty = Stars[P]
    S = K & 1
    S += TiStar0
    put char S at Tx,Ty
  next
  for Ty = 0 to LogoH - 1
    P = Ty * LogoW
    K = Ty + 2
    put Logo + P count LogoW at 6,K
  next
  for Tx = 0 to 31
    P = Tx % 3
    P += TiTrees00
    put char P at Tx,6
    P += 3
    put char P at Tx,7
  next
  ' the pond (rows 8-11), the road (row 12)
  Ty = 8
  PondStrip
  Ty = 10
  PondStrip
  fill TiMud count 32 at 0,12
  fill TiRoad count 32 at 0,13
  ' menu (rows 14-20)
  print at 11,14, "START"
  print at 11,16, "LEVEL"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowLevelChoice
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Tf = 0
  Tp = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLevel > 1 then dec StartLevel
      end if
      if Rt1 = 1 then
        if StartLevel < 9 then inc StartLevel
      end if
      ShowLevelChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLevelChoice:
  print at 18,16, "< >"
  put char StartLevel + 48 at 19,16
  return
end sub

' title sprites: the cursor (0), the frog hopping from pad to pad (1-2),
' a fly (3), a car on the road (4-5)
sub TitleAnim:
  inc Cnt
  P = Menu << 4
  P += 108
  set sprite 0 to P,72,SpCursor,3
  ' the frog: 40 frames on a pad, then a 24-frame hop to the next one
  inc Tf
  if Tf >= 64 then
    Tf = 0
    inc Tp
    if Tp > 3 then Tp = 0
  end if
  K = Tp
  Tq = Tp + 1
  if Tq > 3 then Tq = 0
  ' pads: 0 and 2 on row 9, 1 and 3 on row 11 (pad tiles at y 72 / 88)
  Tfx = PadX[Tp]
  S = Tp & 1
  Tfy = 63
  if S = 1 then Tfy = 79
  ' facing the next pad: right (48) or left (32)
  P = 32
  K = PadX[Tq]
  S = PadX[Tp]
  if K > S then P = 48
  if Tf >= 40 then
    ' in the air: glide x and y, a small arc
    K = Tf - 40
    TitleHop
    P += 8
  end if
  set sprite 1 to Tfy,Tfx,P,3
  P += 4
  set sprite 2 to Tfy,Tfx,P,1
  ' the fly circles over the pond
  K = Cnt & 63
  Tx = Sine[K]
  K = Cnt + 16
  K = K & 63
  Ty = Sine[K]
  Ty = Ty >> 1
  Ty += 52
  Tx += 96
  P = Cnt >> 2
  P = P & 1
  P = P << 2
  P += SpFly0
  set sprite 3 to Ty,Tx,P,1
  ' the car drives along the road, right to left
  Tx = 0 - Cnt
  Tx = Tx - Cnt
  set sprite 4 to 99,Tx,SpTcar0,SpTcarC0
  set sprite 5 to 99,Tx,SpTcar1,SpTcarC1
  update sprites
  ' stars twinkle (about 1 Hz)
  K = Cnt & 31
  if K = 0 then
    K = Cnt & 32
    if K = 0 then
      copy TiPat + 24 count 8 to vram.pattern + 1048
    else
      copy TiPat + 32 count 8 to vram.pattern + 1048
    end if
  end if
  return
end sub

' a 0-63 circle table (radius 0-48), for the fly
data Sine bytes 24,26,28,31,33,35,37,39,41,42,44,45,46,47,48,48,48,48,48,47,46,45,44,42,41,39,37,35,33,31,28,26,24,22,20,17,15,13,11,9,7,6,4,3,2,1,0,0,0,0,0,1,2,3,4,6,7,9,11,13,15,17,20,22

' the title frog hop: K = frame 0-23 of the hop from pad Tp to pad Tq
data HopArc bytes 0,3,6,8,10,12,13,14,15,16,16,16,16,16,16,15,14,13,12,10,8,6,3,0
sub TitleHop:
  Tx = PadX[Tq]
  ' x: 3 pixels a frame towards the next pad (72 pixels in 24 frames)
  P = K * 3
  if Tx > Tfx then
    Tfx += P
  else
    Tfx -= P
  end if
  ' y: from row to row (16 px) in 24 frames, minus the arc
  S = Tq & 1
  P = K * 2
  P = P / 3
  if S = 1 then
    Tfy += P
  else
    Tfy -= P
  end if
  P = HopArc[K]
  Tfy -= P
  return
end sub

' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 11,2, "GRENOUILLE"
  print at 8,5, "ORIGINAL GAME BY"
  print at 6,7, "JEAN-FRANCOIS SEHAN"
  print at 7,9, "L'ORIC A L'AFFICHE"
  print at 3,10, "EDITIONS DU P.S.I. (1984)"
  print at 6,12, "COLECOVISION VERSION"
  print at 7,13, "AMY & CLAUDE 2026"
  print at 2,15, "MADE IN AMY WITH AMY STUDIO"
  print at 9,21, "PRESS A BUTTON"
  return
end sub

sub PageHelp1:
  print at 8,1, "HOW TO PLAY  1/2"
  print at 6,3, "THE FROG HAS FALLEN"
  print at 6,4, "ASLEEP AND DREAMS..."
  print at 2,6, "CROSS THE ROAD: DO NOT"
  print at 2,7, "TOUCH THE CARS AND TRUCKS."
  print at 2,9, "CROSS THE RIVER ON THE LOGS"
  print at 2,10, "AND THE CROCODILES: THE"
  print at 2,11, "WATER IS DEEP, AND THE"
  print at 2,12, "CURRENT CARRIES YOU AWAY."
  print at 2,14, "REACH THE FIVE ROCKS OF THE"
  print at 2,15, "FAR BANK, ONE FROG ON EACH."
  print at 6,17, "MIND THE TRAFFIC!"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp2:
  print at 8,1, "HOW TO PLAY  2/2"
  print at 6,3, "UP OR A BUTTON: HOP"
  print at 6,4, "LEFT, RIGHT, DOWN TOO"
  print at 2,7, "+1  A HOP TO A NEW ROW"
  print at 2,8, "+10 A ROCK"
  print at 2,9, "+50 FIVE ROCKS: NEXT LEVEL,"
  print at 6,10, "FASTER, ONE MORE FROG"
  print at 6,12, "A FLY ON A ROCK: +50"
  print at 2,15, "A ROCK HOLDS ONE FROG ONLY."
  print at 2,16, "YOUR FROGS AND THE LEVEL"
  print at 2,17, "ARE SHOWN AT THE BOTTOM."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

