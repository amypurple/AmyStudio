sub LoadT2:
  copy T2Pat + 0 count 256 to vram.pattern + 4096
  copy T2Col + 0 count 256 to vram.color + 4096
  copy T2Pat + 256 count 120 to vram.pattern + 4360
  copy T2Col + 256 count 120 to vram.color + 4360
  copy T2Pat + 376 count 56 to vram.pattern + 4560
  copy T2Col + 376 count 56 to vram.color + 4560
  copy T2Pat + 432 count 1024 to vram.pattern + 5120
  copy T2Col + 432 count 1024 to vram.color + 5120
  return
end sub

