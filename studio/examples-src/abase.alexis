data SpritePat bytes
  $00,$00,$00,$00,$00,$00,$03,$07,$07,$03,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$80,$80,$00,$00,$00,$00,$00,$00,$00
  $03,$07,$03,$03,$0F,$17,$17,$37,$03,$02,$06,$04,$04,$0C,$00,$00
  $80,$C0,$80,$80,$E0,$D0,$D0,$D8,$80,$80,$C0,$40,$40,$60,$00,$00
  $03,$07,$03,$03,$1F,$27,$47,$07,$03,$06,$0C,$18,$30,$00,$00,$00
  $80,$C0,$80,$80,$E0,$D0,$C8,$C6,$80,$80,$40,$40,$60,$00,$00,$00
  $03,$07,$03,$03,$07,$0F,$0F,$07,$07,$06,$04,$0C,$08,$18,$00,$00
  $80,$C0,$B0,$30,$F0,$C0,$C0,$C0,$C0,$C0,$40,$60,$20,$30,$00,$00
  $08,$0C,$06,$03,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$C0,$40,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$40,$30,$0E,$01,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$FF,$FE,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$18,$30,$60,$C0,$80,$00,$00,$00,$00,$00,$00,$00,$00
  $03,$07,$03,$03,$0F,$17,$27,$07,$04,$08,$10,$30,$00,$00,$00,$00
  $80,$C0,$80,$00,$C0,$A0,$90,$80,$80,$40,$20,$10,$18,$00,$00,$00
  $03,$07,$03,$03,$07,$07,$0F,$07,$03,$02,$04,$04,$0C,$00,$00,$00
  $80,$C0,$80,$00,$C0,$A0,$A0,$80,$00,$80,$80,$80,$C0,$00,$00,$00
end data
data HitVx words
  64, 87, 100, 113, 126, 152, 165, 188, 201, 214, 227, 240, 256, 272, 285, 298, 311, 324, 347, 360, 373, 399, 412, 425, 448
end data

record Runner:
  u8 Act
  u8 Base
  u8 Togo
  u8 X
  u8 Y
  u8 Stp
end record

Runner Rn[4]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 NumU = 0
bcd digits 3 RunsV = 0
bcd digits 3 RunsH = 0
u8 Mode = 1
u8 Tm = 0
u8 Inn = 1
u8 Half = 0
u8 Outs = 0
u8 Strikes = 0
u8 Pitches = 20
u8 Over = 0
' the play: state, its timer, the pitch, the swing, the result
u8 St = 0
u16 StT = 0
u16 Delay = 0
u8 PType = 0
u8 PitF = 0
u8 Sw = 0
u8 Res = 0
u8 Homer = 0
u8 Shown = 0
i16 Bx = 0
i16 By = 0
i16 Vx = 0
i16 Vy = 0
i16 Ax = 0
u8 BallOn = 0
u8 HitD = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Bp = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 P1 = 0
u8 P2 = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 1
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters
u8 Ri = 0
u8 Ci = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  fill TBlk count 28 at 2,22
  select case Mode
  case 0
    print at 8,22, "PRACTICE OVER"
  case 1
    NumU = Outs
    print at 6,22, "GAME OVER: ", RunsH, " RUNS"
  case else
    if RunsV > RunsH then
      print at 5,22, "GAME OVER: VISITOR WINS"
    else
      print at 6,22, "GAME OVER: HOME WINS"
    end if
  end select
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc StT
  select case St
  case 0
    WaitPitch
  case 1
    ' the wind-up: the throwing frame for the last 8 frames
    if StT >= 12 then PitF = 1
    if StT >= 20 then Release
  case 2
    PitchFlight
  case 3
    HitFlight
  case 4
    MoveRunners
    if StT >= 100 then
      if RunnersBusy() = 0 then EndPlay
    end if
  end select
  return
end sub

' the computer pitches after 64-127 frames; a player pitches with a button
sub WaitPitch:
  if Mode < 2 then
    if StT >= Delay then
      Rand
      PType = Rs & 3
      St = 1
      StT = 0
    end if
    return
  end if
  if Tm = 0 then
    K = J2
    T = P2
  else
    K = J1
    T = P1
  end if
  if T = 0 then return
  PType = 1
  V = K & 2
  if V > 0 then PType = 2
  V = K & 4
  if V > 0 then PType = 3
  V = K & 8
  if V > 0 then PType = 0
  St = 1
  StT = 0
  fill TBlk count 28 at 2,22
  return
end sub

sub Release:
  St = 2
  StT = 0
  Bx = MidX * 64
  By = 118 * 64
  Vx = 0
  Vy = PitVy[PType]
  Ax = PitAx[PType]
  Ax = Ax - 128
  BallOn = 1
  Sw = 0
  play sound SndPitch
  return
end sub

' the pitch: the curve every two frames, the swing, the contact, the strike
sub PitchFlight:
  i16 D = 0
  i16 BatX = 0
  u8 Py = 0
  u8 OldPy = 0
  OldPy = By / 64
  V = Tick & 3
  if V = 0 then Vx = Vx + Ax
  Bx = Bx + Vx
  By = By + Vy
  if Sw = 0 then
    if Bp = 1 then
      Sw = 1
      play sound SndSwing
    end if
  else
    if Sw < 21 then inc Sw
  end if
  ' the bat meets the ball on the frame the ball crosses the bat's line
  Py = By / 64
  if OldPy < BatLine then
    if Py >= BatLine then
      if Sw >= 4 then
        if Sw <= 19 then
          BatX = 100 + 2 * Sw
          D = Bx / 64 - BatX + 12
          if D >= 0 then
            if D <= 24 then
              HitD = D
              Contact
            end if
          end if
        end if
      end if
    end if
  end if
  if St = 2 then
    if By > StrikeY then
      BallOn = 0
      Res = 0
      Result
    end if
  end if
  return
end sub

sub Contact:
  NumU = HitVx[HitD]
  Vx = NumU - 256
  Vy = -140
  Homer = 0
  St = 3
  StT = 0
  play sound SndCrack
  return
end sub

' the hit: walls bounce it, the mound line makes a home run, the zone row
' catches it
sub HitFlight:
  i16 OldY = 0
  i16 Dx = 0
  u8 Zone = 0
  OldY = By
  Bx = Bx + Vx
  By = By + Vy
  if Bx < WallL then
    Bx = WallL
    Vx = 0 - Vx
  end if
  if Bx > WallR then
    Bx = WallR
    Vx = 0 - Vx
  end if
  if OldY >= MoundY * 64 then
    if By < MoundY * 64 then
      Dx = Bx - MidX * 64
      if Dx < 0 then Dx = 0 - Dx
      if Dx <= 256 then Homer = 1
    end if
  end if
  if Homer = 1 then
    if By <= OutY then
      BallOn = 0
      Res = 4
      Result
    end if
  else
    if By <= LandY then
      Zone = ZoneOf(Bx)
      BallOn = 0
      Res = ZoneRes[Zone]
      Result
    end if
  end if
  return
end sub

function ZoneOf(i16 Px) as u8
  i16 Q = 0
  Q = Px / 64 - 16
  if Q < 0 then Q = 0
  Q = Q / 24
  if Q > 8 then Q = 8
  return Q

' the result of the pitch: the message, the runners start running
sub Result:
  St = 4
  StT = 0
  fill TBlk count 28 at 2,22
  select case Res
  case 0
    if Strikes = 2 then
      if Mode > 0 then
        print at 9,22, "STRIKE THREE!"
      else
        print at 12,22, "STRIKE"
      end if
    else
      print at 12,22, "STRIKE"
    end if
    play sound SndStrike
  case 1
    print at 12,22, "SINGLE!"
    play sound SndRun
  case 2
    print at 12,22, "DOUBLE!"
    play sound SndRun
  case 3
    print at 12,22, "TRIPLE!"
    play sound SndRun
  case 4
    print at 11,22, "HOME RUN!"
    play sound SndHomer
  case else
    print at 9,22, "OUT - CAUGHT!"
    play sound SndOut
  end select
  if Mode = 0 then return
  if Res = 0 then return
  if Res = 5 then return
  ' everybody on base moves up Res bases; the batter starts at home
  for Ci = 0 to 3
    if Rn[Ci].Act = 1 then Rn[Ci].Togo = Res
  next
  for Ci = 0 to 3
    if Rn[Ci].Act = 0 then
      Rn[Ci].Act = 1
      Rn[Ci].Base = 0
      Rn[Ci].Togo = Res
      Rn[Ci].Stp = 0
      Ci = 4
    end if
  next
  return
end sub

' the runners: 2 pixels a frame along the base paths, 20 frames a base
sub MoveRunners:
  u8 B = 0
  u8 Dx = 0
  u8 Dy = 0
  for Ci = 0 to 3
    if Rn[Ci].Act = 1 then
      if Rn[Ci].Togo > 0 then
        B = Rn[Ci].Base
        Dx = BaseDx[B]
        Dy = BaseDy[B]
        Rn[Ci].Stp = Rn[Ci].Stp + 1
        if Rn[Ci].Stp = 20 then
          Rn[Ci].Stp = 0
          Rn[Ci].Togo = Rn[Ci].Togo - 1
          B = B + 1
          Rn[Ci].Base = B
          if B = 4 then
            Rn[Ci].Act = 0
            Rn[Ci].Togo = 0
            ScoreRun
          end if
        end if
        B = Rn[Ci].Base & 3
        K = Rn[Ci].Stp * 2
        V = BaseX[B] + K * Dx
        Rn[Ci].X = V
        V = BaseY[B] + K * Dy
        Rn[Ci].Y = V
      end if
    end if
  next
  return
end sub

function RunnersBusy as u8
  u8 Busy = 0
  for Ri = 0 to 3
    if Rn[Ri].Act = 1 then
      if Rn[Ri].Togo > 0 then Busy = 1
    end if
  next
  return Busy

sub ScoreRun:
  if Tm = 0 then
    RunsV += 1
  else
    RunsH += 1
  end if
  play sound SndRun
  ShowHud
  return
end sub

' after the result: strikes, outs, the end of a half inning or of the game
sub EndPlay:
  fill TBlk count 28 at 2,22
  St = 0
  StT = 0
  BallOn = 0
  Sw = 0
  PitF = 0
  NextDelay
  if Mode = 0 then
    dec Pitches
    if Pitches = 0 then Over = 1
    ShowHud
    return
  end if
  select case Res
  case 0
    inc Strikes
    if Strikes = 3 then
      Strikes = 0
      inc Outs
    end if
  case 5
    Strikes = 0
    inc Outs
  case else
    Strikes = 0
  end select
  ShowHud
  if Outs < 3 then return
  if Mode = 1 then
    Over = 1
    return
  end if
  if Inn >= 3 then
    if Half = 1 then
      if RunsV <> RunsH then
        Over = 1
        return
      end if
    end if
  end if
  ChangeSides
  return
end sub

sub ChangeSides:
  Outs = 0
  Strikes = 0
  ClearRunners
  inc Half
  if Half = 2 then
    Half = 0
    inc Inn
  end if
  Tm = Half
  print at 8,22, "CHANGE BATTERS"
  ShowHud
  DrawSprites
  Rearm
  wait 90 frames
  nmi off
  fill TBlk count 28 at 2,22
  PitchHint
  return
end sub

sub PitchHint:
  if Mode < 2 then return
  if Tm = 0 then
    print at 3,22, "HOME: STICK + BUTTON PITCH"
  else
    print at 2,22, "VISITOR: STICK+BUTTON PITCH"
  end if
  return
end sub

sub ClearRunners:
  for Ri = 0 to 3
    Rn[Ri].Act = 0
    Rn[Ri].Togo = 0
  next
  return
end sub

sub NextDelay:
  Rand
  Delay = Rs & 63
  Delay = Delay + 64
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Fr = 0
  u8 Col = 9
  ' the ball (pattern centred on the 16 x 16 sprite)
  if BallOn = 1 then
    Sx = Bx / 64 - 8
    Sy = By / 64 - 9
    set sprite 0 to Sy,Sx,SBall,15
  else
    set sprite 0 to 192,0,0,0
  end if
  ' the bat and the batter, left of the plate (hidden while running)
  if Mode = 2 then
    if Tm = 1 then Col = 7
  end if
  if Mode = 1 then Col = 7
  Fr = 0
  if Sw > 0 then
    Fr = Sw - 1
    Fr = Fr / 3
    if Fr > 3 then Fr = 3
  end if
  if St = 4 then
    if Res > 0 then
      if Res < 5 then Fr = 255
    end if
  end if
  if Fr = 255 then
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  else
    set sprite 1 to 147,112,SBw0 + Fr * 4,10
    set sprite 2 to 147,100,SBat0,Col
  end if
  ' the pitcher (the fielding team's colour)
  K = 7
  if Col = 7 then K = 9
  Fr = SPit0
  if PitF = 1 then Fr = SPit1
  if Mode = 0 then K = 14
  set sprite 3 to 107,116,Fr,K
  ' the runners
  for Ri = 0 to 3
    C = Ri + 4
    if Rn[Ri].Act = 1 then
      Fr = SRun0
      V = Rn[Ri].Stp & 4
      if V > 0 then Fr = SRun1
      Sx = Rn[Ri].X - 8
      Sy = Rn[Ri].Y - 13
      set sprite C to Sy,Sx,Fr,Col
    else
      set sprite C to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  if Mode = 0 then
    print at 2,1, "PRACTICE"
    NumU = Pitches
    print at 16,1, "PITCHES ", digits$(NumU, 2)
    return
  end if
  if Mode = 1 then
    print at 2,1, "RUNS ", RunsH
  else
    if Tm = 0 then put char 62 at 2,1
    if Tm = 1 then put char 62 at 15,1
    print at 3,1, "VISITOR ", RunsV
    print at 16,1, "HOME ", RunsH
  end if
  NumU = Inn
  print at 2,2, "INNING ", digits$(NumU, 1)
  NumU = Strikes
  print at 12,2, "STRIKES ", digits$(NumU, 1)
  NumU = Outs
  print at 23,2, "OUTS ", digits$(NumU, 1)
  return
end sub

' the zone row (rows 3-4, columns 2-28, a post at 29)
sub DrawZones:
  for Ci = 0 to 8
    X = Ci * 3 + 2
    V = ZoneRes[Ci]
    if V = 5 then
      put char TOpost2 at X,3
      put char TFhead at X + 1,3
      put char TGrassd at X + 2,3
      put char TOpost at X,4
      put char TFbody at X + 1,4
      put char TOpad at X + 2,4
    else
      put char TZpost2 at X,3
      put char TZ1 + V - 1 at X + 1,3
      put char TZB at X + 2,3
      put char TZpost at X,4
      put char TZpad at X + 1,4
      put char TZpad at X + 2,4
    end if
  next
  put char TZpost2 at 29,3
  put char TZpost at 29,4
  return
end sub

sub DrawField:
  fill TBlk count 32 at 0,0
  for Ri = 5 to 21
    T = TGrass
    V = Ri & 2
    if V > 0 then T = TGrassd
    fill T count 32 at 0,Ri
  next
  fill TGrassd count 32 at 0,3
  fill TGrassd count 32 at 0,4
  DrawZones
  ' chalk lines between the bases
  for Ci = 1 to 4
    put char TLnf at 15 + Ci,20 - Ci
    put char TLnb at 10 + Ci,10 + Ci
    put char TLnb at 15 + Ci,10 + Ci
    put char TLnf at 10 + Ci,20 - Ci
  next
  put char TBase at 20,15
  put char TBase at 15,10
  put char TBase at 10,15
  put char TMound at 15,15
  fill TDirt count 5 at 13,19
  fill TDirt count 5 at 13,21
  put char TBoxl at 13,20
  put char TPlate at 15,20
  put char TBoxr at 17,20
  put char TDirt at 14,20
  put char TDirt at 16,20
  fill TBlk count 32 at 0,22
  fill TBlk count 32 at 0,23
  return
end sub

' ---------------------------------------------------------------------------

sub NewGame:
  RunsV = 0
  RunsH = 0
  Inn = 1
  Half = 0
  Tm = 0
  if Mode = 1 then Tm = 1
  Outs = 0
  Strikes = 0
  Pitches = 20
  Over = 0
  St = 0
  StT = 0
  BallOn = 0
  Sw = 0
  PitF = 0
  Res = 0
  ClearRunners
  NextDelay
  NewScreen
  DrawField
  ShowHud
  PitchHint
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

sub Rand:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' J1/J2: 1 up, 2 down, 4 left, 8 right, 16 button. P1/P2: button pressed
' this frame. Bp: the batter's press (either controller unless two play)
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  P1 = 0
  P2 = 0
  V = J1 & 16
  if V > 0 then
    if WasB1 = 0 then P1 = 1
  end if
  WasB1 = V
  V = J2 & 16
  if V > 0 then
    if WasB2 = 0 then P2 = 1
  end if
  WasB2 = V
  Press = P1 | P2
  if Mode = 2 then
    if Tm = 0 then
      Bp = P1
    else
      Bp = P2
    end if
  else
    Bp = Press
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the field, the menu, the tune once
sub TitlePage:
  NewScreen
  DrawField
  for Ri = 7 to 17
    fill 32 count 22 at 5,Ri
  next
  print at 8,8, "ARCADE BASEBALL"
  print at 7,10, "COMPUTE!S GAZETTE"
  print at 11,11, "MAY 1986"
  print at 11,13, "PRACTICE"
  print at 11,14, "1 PLAYER"
  print at 11,15, "2 PLAYERS"
  print at 11,16, "HOW TO PLAY"
  print at 11,17, "CREDITS"
  if Menu > 4 then Menu = 1
  ShowMenu
  St = 0
  BallOn = 0
  Sw = 0
  PitF = 0
  Mode = 1
  ClearRunners
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 504
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 4 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 3 then
    HowToPage
    return
  end if
  if Menu = 4 then
    CreditsPage
    return
  end if
  Mode = Menu
  return
end sub

sub ShowMenu:
  for Ri = 13 to 17
    put char 32 at 9,Ri
  next
  J = Menu + 13
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    DrawZones
    print at 2,6, "THE PITCHER THROWS THE BALL."
    print at 2,7, "PRESS THE BUTTON TO SWING."
    print at 2,8, "SWING EARLY: THE BALL GOES"
    print at 2,9, "LEFT. SWING LATE: RIGHT."
    print at 2,11, "THE BALL FLIES TO THE ZONES"
    print at 2,12, "UP TOP: 1B, 2B AND 3B ARE"
    print at 2,13, "HITS WORTH 1, 2 OR 3 BASES."
    print at 2,14, "A ZONE WITH A FIELDER IS AN"
    print at 2,15, "OUT. STRAIGHT OVER THE"
    print at 2,16, "PITCHER IS A HOME RUN!"
    set sprite 3 to 150,48,SPit0,9
    set sprite 0 to 152,96,SBall,15
    set sprite 1 to 150,168,SBw0,10
    set sprite 2 to 150,156,SBat0,7
  elseif Pg = 1 then
    print at 2,3, "A MISS IS A STRIKE."
    print at 2,4, "3 STRIKES MAKE AN OUT."
    print at 2,5, "3 OUTS END THE INNING."
    print at 2,7, "ON A HIT, YOU AND EVERY"
    print at 2,8, "RUNNER MOVE UP THAT MANY"
    print at 2,9, "BASES. EACH RUNNER WHO GETS"
    print at 2,10, "HOME SCORES A RUN."
    print at 2,12, "TIP: DON'T SWING TOO SOON."
    print at 2,13, "WATCH THE BALL COME ALL THE"
    print at 2,14, "WAY TO THE PLATE, AND AIM"
    print at 2,15, "FOR THE 3B ZONES!"
    put char TPlate at 15,19
    set sprite 4 to 131,120,SRun0,7
    set sprite 5 to 131,88,SRun1,7
  else
    print at 2,3, "PRACTICE: 20 PITCHES, NO"
    print at 2,4, "SCORE. TRY YOUR SWING."
    print at 2,6, "1 PLAYER: ONE INNING. HOW"
    print at 2,7, "MANY RUNS CAN YOU SCORE?"
    print at 2,9, "2 PLAYERS: 3 INNINGS. THE"
    print at 2,10, "VISITOR (CONTROLLER 1) BATS"
    print at 2,11, "FIRST, THEN YOU SWAP. THE"
    print at 2,12, "PITCHER PICKS A PITCH WITH"
    print at 2,13, "THE STICK: UP FAST, DOWN"
    print at 2,14, "SLOW, LEFT OR RIGHT CURVE."
    print at 2,15, "A BUTTON THROWS IT."
    print at 2,17, "MOST RUNS WINS. A TIE PLAYS"
    print at 2,18, "EXTRA INNINGS."
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  Wt = 0
ht_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 3 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "ARCADE BASEBALL"
  print at 2,5, "BASED ON ARCADE BASEBALL,"
  print at 2,6, "A TYPE-IN GAME FROM"
  print at 2,7, "COMPUTE!S GAZETTE, MAY 1986"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SEVENTH INNING"
  print at 2,19, "STRIDE (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

