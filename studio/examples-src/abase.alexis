const SndSwing = 4
const SndCrack = 5
const SndStrike = 6
const SndOut = 7
const SndRun = 8
const SndHomer = 9
const SndStart = 10
const SndOver = 11
const NSpr = 8
const BatLine = 161
const MoundY = 124
const MidX = 124
const WallL = 1024
const WallR = 14848
const LandY = 2304
const OutY = 512
const StrikeY = 11776

data ZoneRes bytes
  1, 5, 2, 5, 3, 5, 2, 5, 1
end data
' pitches: speed (64ths of a pixel a frame), curve (per four frames, +128)
data PitVy bytes
  52, 64, 40, 52
end data
data PitAx bytes
  129, 128, 128, 127
end data
' bases: centre X, Y; steps toward the next base
data BaseX bytes
  124, 164, 124, 84
end data
data BaseY bytes
  164, 124, 84, 124
end data
data BaseDx bytes
  1, 255, 255, 1
end data
data BaseDy bytes
  255, 255, 1, 1
end data
data TilePat bytes
  $00,$10,$00,$02,$00,$40,$00,$08
  $00,$10,$00,$02,$00,$40,$00,$08
  $01,$03,$06,$0C,$18,$30,$60,$C0
  $80,$C0,$60,$30,$18,$0C,$06,$03
  $C3,$81,$C3,$C3,$C3,$C3,$81,$C3
