  $02,$32,$02,$32,$02,$32,$02,$32
  $0C,$2C,$0C,$2C,$0C,$2C,$0C,$2C
  $F2,$F2,$F2,$F2,$F2,$F2,$F2,$F2
  $F2,$F2,$F2,$F2,$F2,$F2,$F2,$F2
  $2A,$2A,$AF,$AF,$AF,$AF,$2A,$2A
  $2A,$2A,$0A,$AF,$0A,$0A,$2A,$2A
  $0A,$AF,$AF,$AF,$FA,$0A,$0A,$0A
  $0A,$BA,$0A,$BA,$0A,$BA,$0A,$0A
  $0A,$AF,$FA,$FA,$FA,$FA,$AF,$0A
  $0A,$AF,$FA,$FA,$FA,$FA,$AF,$0A
  $04,$F4,$F4,$F4,$F4,$F4,$F4,$04
  $04,$F4,$F4,$F4,$F4,$F4,$4F,$04
  $04,$4F,$F4,$F4,$F4,$F4,$4F,$04
  $04,$4F,$F4,$4F,$F4,$F4,$4F,$04
  $04,$04,$04,$04,$04,$04,$04,$0F
  $F4,$F4,$F4,$F4,$F4,$F4,$F4,$0F
  $F4,$F4,$F4,$F4,$F4,$F4,$F4,$F4
  $0C,$0C,$0C,$0C,$0C,$0C,$0C,$0F
