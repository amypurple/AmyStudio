  $00,$08,$00,$40,$00,$02,$00,$00
  $00,$80,$40,$40,$40,$40,$80,$00
  $00,$01,$02,$02,$02,$02,$01,$00
  $00,$10,$30,$10,$10,$10,$38,$00
  $00,$38,$44,$08,$10,$20,$83,$00
