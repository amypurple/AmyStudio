u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the fighters (0 white, 1 black)
u8 Fx[2]
u8 Fs[2]
u8 Fm[2]
u8 Ft[2]
u8 Lat[2]
u8 Up[2]
u8 Wc[2]
u8 Mv[2]
u8 Hd[2]
u8 Jp[2]
u16 Score[2]
u8 NPl = 1
u8 Hard = 0
u8 React = 5
u8 ClkS = 90
u8 ClkF = 60
u8 Cpu = 1
u8 Phase = 0
u8 PtT = 0
u8 Winner = 0
u8 Hits = 0
' the computer
u8 AiT = 0
u8 AiJ = 0
u8 AiN = 0
u8 AiD = 0
u8 AiRep = 0
u8 AiLast = 9
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Hi = 0
u8 Ti = 0
u8 Li = 0
u8 Ci = 0
' scratch
u8 G = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table RkSoundTable areas 6
  sprites 16x16
  sprites flicker off
  set sprite count 8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel >= 3 then goto title
  NewMatch
  DrawRing
  ShowScores
  ResetBout
  DrawFighters
  ShowScreen

play_loop:
  Frame1
  GetInput
  select case Phase
  case 0
    ReadyStep
  case 1
    FightStep
  case 2
    PointStep
  end select
  DrawFighters
  if Phase <> 3 then goto play_loop

  ' the end: WHITE WINS! / BLACK WINS!, then back to the title on a press
  if Winner < 2 then
    Fs[Winner] = SWon
    DrawFighters
  end if
  select case Winner
  case 0
    print at 10,MsgRow, "WHITE WINS!"
  case 1
    print at 10,MsgRow, "BLACK WINS!"
  case else
    print at 13,MsgRow, "DRAW"
  end select
  mute all
  play sound SndWin
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the bout

sub NewMatch:
  Score[0] = 0
  Score[1] = 0
  AiRep = 0
  AiLast = 9
  Hits = 0
  ClkS = Bout
  ClkF = 60
  React = AiEasy
  if Hard = 1 then React = AiReact
  return
end sub

' both fighters back to their marks, READY, then the bell
sub ResetBout:
  Fx[0] = X0W
  Fx[1] = X0B
  for Pi = 0 to 1
    Fs[Pi] = SIdle
    Fm[Pi] = 0
    Ft[Pi] = 0
    Wc[Pi] = 0
    Mv[Pi] = 0
    Hd[Pi] = 0
    ' a button still held must be let go first
    Lat[Pi] = 1
    Up[Pi] = 0
  next
  AiT = 20
  AiJ = 0
  AiD = 0
  Phase = 0
  PtT = 50
  print at 2,MsgRow, "            READY           "
  return
end sub

sub ReadyStep:
  dec PtT
  if PtT = 0 then
    Phase = 1
    play sound SndBell
    print at 2,MsgRow, "                            "
  end if
  return
end sub

sub FightStep:
  for Pi = 0 to 1
    Control(Pi)
  next
  HitCheck
  if Phase = 1 then Clock
  return
end sub

' the match clock: Bout seconds of fighting; at time-out the higher score
' wins, equal scores are a DRAW (Winner 2)
sub Clock:
  dec ClkF
  if ClkF = 0 then
    ClkF = 60
    dec ClkS
    ShowClock
    if ClkS = 0 then
      Phase = 3
      Winner = 2
      if Score[0] > Score[1] then Winner = 0
      if Score[1] > Score[0] then Winner = 1
      print at 2,MsgRow, "          TIME UP           "
      Rearm
      wait 60 frames
      nmi off
      print at 2,MsgRow, "                            "
    end if
  end if
  return
end sub

sub ShowClock:
  print at 14,1, digits$(ClkS, 2)
  return
end sub

function Gap as u8
  V = Fx[1] - Fx[0]
  return V

' one fighter's pass: the button (let go between moves), moves, walking
sub Control(u8 P):
  u8 Jx = 0
  u8 Pr = 0
  u8 Tw = 8
  u8 Aw = 4
  u8 M = 0
  Jx = Jp[P]
  if (Jx & 16) = 0 then
    Lat[P] = 0
    if Up[P] < 250 then inc Up[P]
  else
    if Lat[P] = 0 then
      Pr = 1
      ' pressed again too soon after letting go: the fighter freezes
      if Up[P] < TapMin then Pr = 2
      Lat[P] = 1
      Up[P] = 0
    end if
  end if
  if P = 1 then
    Tw = 4
    Aw = 8
  end if
  if Mv[P] > 0 then dec Mv[P]
  select case Fs[P]
  case SIdle
    if Pr = 2 then
      Fs[P] = SRec
      Fm[P] = 3
      Ft[P] = Froze
    else
    if Pr = 1 then
      if (Jx & Tw) <> 0 then
        M = 0
        if (Jx & 1) <> 0 then
          M = 1
        else
          if (Jx & 2) <> 0 then M = 2
        end if
        Fs[P] = SWind
        Fm[P] = M
        Ft[P] = WindT[M]
        Hd[P] = 0
        play sound SndWhoosh
        if P = 0 then Track(M)
      else
        Fs[P] = SBlock
        Ft[P] = BlockT
      end if
    else
      Wc[P] = Wc[P] ^ 1
      if Wc[P] = 1 then Walk(P, Jx & Tw, Jx & Aw)
    end if
    end if
  case SWind
    dec Ft[P]
    if Ft[P] = 0 then
      Fs[P] = SAct
      M = Fm[P]
      Ft[P] = ActT[M]
    end if
  case SAct
    dec Ft[P]
    if Ft[P] = 0 then
      Fs[P] = SRec
      M = Fm[P]
      Ft[P] = RecT[M]
    end if
  case SBlock
    dec Ft[P]
    if Ft[P] = 0 then
      Fs[P] = SRec
      Fm[P] = 3
      Ft[P] = BlockRec
    end if
  case else
    dec Ft[P]
    if Ft[P] = 0 then Fs[P] = SIdle
  end select
  return
end sub

' a pixel toward (In) or away from (Out) the other fighter
sub Walk(u8 P, u8 In, u8 Out):
  if In <> 0 then
    if Gap() > MinGap then
      if P = 0 then
        inc Fx[0]
      else
        dec Fx[1]
      end if
      Mv[P] = 8
    end if
  else
    if Out <> 0 then
      if P = 0 then
        if Fx[0] > MinXW then dec Fx[0]
      else
        if Fx[1] < MaxXB then inc Fx[1]
      end if
      Mv[P] = 8
    end if
  end if
  return
end sub

' the computer remembers the player's last move and how often in a row
sub Track(u8 M):
  if M = AiLast then
    if AiRep < 4 then inc AiRep
  else
    AiRep = 0
  end if
  AiLast = M
  return
end sub

' a move at its striking moment: within reach it scores, unless the other
' fighter strikes too (both pushed apart) or blocks (the attacker staggers)
sub HitCheck:
  u8 O = 0
  u8 M = 0
  for Hi = 0 to 1
    if Phase = 1 then
      if Fs[Hi] = SAct and Hd[Hi] = 0 then
        M = Fm[Hi]
        if Gap() <= ReachT[M] then
          Hd[Hi] = 1
          O = 1 - Hi
          if Fs[O] = SAct then
            Hd[O] = 1
            Clash
          else
            ' a block stops a punch or a kick, not a foot sweep
            if Fs[O] = SBlock and M < 2 then
              Fs[Hi] = SRec
              Ft[Hi] = RecT[M] + Stagger
              play sound SndClack
            else
              Point(Hi)
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub Clash:
  for Ci = 0 to 1
    Fs[Ci] = SRec
    K = Fm[Ci]
    Ft[Ci] = RecT[K]
  next
  if Fx[0] >= MinXW + 4 then Fx[0] -= 4
  if Fx[1] <= MaxXB - 4 then Fx[1] += 4
  play sound SndClack
  return
end sub

sub Point(u8 W):
  u8 L = 0
  Winner = W
  L = 1 - W
  Score[W] += 100
  inc Hits
  Fs[L] = SHit
  Phase = 2
  PtT = 90
  play sound SndThump
  play sound SndKiai
  ShowScores
  if W = 0 then
    print at 2,MsgRow, "     KNOCKDOWN FOR WHITE    "
  else
    print at 2,MsgRow, "     KNOCKDOWN FOR BLACK    "
  end if
  return
end sub

' the hit fighter is knocked back, then the next bout or the end
sub PointStep:
  dec PtT
  if PtT >= 78 then
    if Winner = 0 then
      if Fx[1] < MaxXB then inc Fx[1]
    else
      if Fx[0] > MinXW then dec Fx[0]
    end if
  end if
  if PtT = 0 then
    if Score[Winner] >= Win then
      Phase = 3
      print at 2,MsgRow, "                            "
    else
      ResetBout
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' input: controller 1 white, controller 2 black or the computer

sub GetInput:
  ReadPads
  if NPl = 1 then
    Jp[0] = Pads
  else
    Jp[0] = PadOf(1)
  end if
  if Cpu = 1 then
    if Phase = 1 then
      Jp[1] = AiPad()
    else
      Jp[1] = 0
    end if
  else
    Jp[1] = PadOf(2)
  end if
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' the computer (black): it looks at the bout every 8 to 15 frames, like a
' person reacting; between looks it keeps its stick (the button only on
' the look itself). Toward white is left (4), away is right (8).
function AiPad as u8
  u8 R8 = 0
  u8 Ch = 0
  u8 Mx = 0
  u8 Ps = 0
  if Fs[1] <> SIdle then
    AiT = 0
    AiJ = 0
    AiD = 0
    return 0
  end if
  if AiD > 0 then
    ' the decision is carried out a reaction time after the look
    dec AiD
    if AiD = 0 then
      AiJ = AiN
      return AiJ
    end if
    V = AiJ & 15
    return V
  end if
  if AiT > 0 then
    dec AiT
    V = AiJ & 15
    return V
  end if
  Rand
  R8 = Rs & 255
  W16 = Rs >> 8
  AiT = 7 + (W16 & 7)
  G = Gap()
  Ps = Fs[0]
  AiN = 0
  if Ps = SWind or Ps = SAct then
    ' white is attacking: block (more often against a repeated move) or
    ' step back
    Mx = Fm[0]
    if G <= ReachT[Mx] + 4 then
      Ch = 90 + AiRep * 40
      if Mx = 2 then
        ' a block doesn't stop a sweep: punch into its wind-up, or back off
        AiN = 8
        if G <= ReachP and R8 < Ch then AiN = 20
      else
        if R8 < Ch then
          AiN = 16
        else
          AiN = 8
        end if
      end if
    end if
  else
    if Ps = SRec then
      ' white is open: punish
      Ch = 130 + AiRep * 25
      if AiRep >= 2 and G > ReachP and G <= ReachL then
        ' against a move repeated over and over: the long low kick into
        ' its recovery, from outside the punch's reach
        if R8 < 230 then AiN = 22
      else
      if G <= ReachP then
        if R8 < Ch then AiN = 20
      else
        if G <= ReachL then
          if R8 < 160 then AiN = 22
        else
          if R8 < 200 then AiN = 4
        end if
      end if
      end if
    else
      if Ps = SBlock then
        if R8 < 120 then AiN = 8
      else
        ' white is waiting. After the same move three times running it
        ' expects it again: a punch into a sweep, a block for the others
        Mx = AiLast
        if AiRep >= 2 and Mx < 3 then
          Ch = ReachT[Mx] + 3
          ' a sweeper must come close: wait for him just outside
          if Mx = 2 then Ch = 20
        else
          Ch = 0
        end if
        if G <= Ch then
          if Mx = 2 then
            if G <= ReachP then
              if R8 < 245 then AiN = 20
            else
              AiT = 1
            end if
          else
            if R8 < 245 then AiN = 16
          end if
        else
        if G > ReachH then
          if R8 < 200 then AiN = 4
        else
          if R8 < 80 then
            Mx = R8 % 3
            if G <= ReachT[Mx] then
              AiN = 20
              if Mx = 1 then AiN = 21
              if Mx = 2 then AiN = 22
            else
              AiN = 4
            end if
          else
            if R8 < 130 then AiN = 8
          end if
        end if
        end if
      end if
    end if
  end if
  ' walking in: look again sooner
  if AiN = 4 then AiT = 3 + (W16 & 1)
  AiD = React
  ' a move it has seen three times running it answers at once
  if AiRep >= 2 then AiD = AiReact
  V = AiJ & 15
  return V

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

function PoseOf(u8 P) as u8
  u8 M = 0
  M = Fm[P]
  select case Fs[P]
  case SWind
    V = WindPose[M]
  case SAct
    V = ActPose[M]
  case SRec
    V = PoStance
    if M < 3 then
      if Ft[P] > 6 then V = WindPose[M]
    end if
  case SBlock
    V = PoBlock
  case SHit
    V = PoHit
  case SWon
    V = PoWin
  case else
    V = PoStance
    if Mv[P] > 0 then
      if (Fx[P] & 4) <> 0 then V = PoWalk
    end if
  end select
  return V

sub DrawFighters:
  u8 Po = 0
  u8 Base = 0
  u8 Sp = 0
  u8 Cl = 0
  u8 Px = 0
  u8 Pt = 0
  for Pi = 0 to 1
    Po = PoseOf(Pi)
    Base = Po * 4
    for Li = 0 to 3
      K = Base + Li
      if Pi = 0 then
        Pt = PosePat0[K]
        Px = Fx[0] + PoseX0[K]
      else
        Pt = PosePat1[K]
        Px = Fx[1] + PoseX1[K]
      end if
      Cl = 9
      if (Li & 1) = 0 then Cl = GiCol[Pi]
      Sp = Pi * 4 + Li
      Y = FY + LayerDY[Li]
      set sprite Sp to Y,Px,Pt,Cl
    next
  next
  update sprites
  return
end sub

' row 1: WHITE 0000 ... BLACK 0000
sub ShowScores:
  print at 2,1, "WHITE"
  NumU = Score[0]
  print at 8,1, digits$(NumU, 4)
  print at 20,1, "BLACK"
  NumU = Score[1]
  print at 26,1, digits$(NumU, 4)
  ShowClock
  return
end sub

sub DrawRing:
  NewScreen
  ' the crowd (decoration may run to the screen's edges)
  for Ti = 2 to 11
    for Ci = 0 to 31
      K = (Ci + Ti * 2) % 3
      put char TCrowd1 + K at Ci,Ti
    next
  next
  ' corner posts and two ropes
  put char TPtop at 2,8
  put char TPtop at 29,8
  for Ti = 9 to 11
    put char TPost at 2,Ti
    put char TPost at 29,Ti
  next
  fill TRope count 26 at 3,9
  fill TRope count 26 at 3,11
  ' the canvas
  fill TCanvasf count 32 at 0,12
  for Ti = 13 to 16
    fill TCanvas count 32 at 0,Ti
  next
  fill TCanvasl count 32 at 0,17
  put char TMark at 12,16
  put char TMark at 19,16
  ' the apron with the name
  fill TApron count 32 at 0,18
  fill TApronb count 32 at 0,19
  print at 8,18, "RINGSIDE KARATE"
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  for K = 0 to 7
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: RINGSIDE KARATE, two fighters bowing in, the menu, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 224 to vram.name + 64
  fill TCanvasf count 28 at 2,12
  for Ti = 13 to 15
    fill TCanvas count 28 at 2,Ti
  next
  fill TCanvasl count 28 at 2,16
  Fx[0] = 84
  Fx[1] = 124
  for Pi = 0 to 1
    Fs[Pi] = SIdle
    Mv[Pi] = 0
  next
  Sel = 0
  ShowMenu
  print at 6,22, "COMPUTE!'S GAZETTE 1986"
  TitleSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 648
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 4 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  if Sel = 2 then
    ' the computer's level: a button or left/right changes it
    if (N & 28) <> 0 then
      Hard = Hard ^ 1
      play sound SndPick
      ShowMenu
    end if
    goto tp_loop
  end if
  if (N & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  NPl = 1
  Cpu = 1
  if Sel = 1 then
    NPl = 2
    Cpu = 0
  end if
  if Sel = 3 then HowToPage
  if Sel = 4 then CreditsPage
  return
end sub

sub TitleSprites:
  for Pi = 0 to 1
    Fs[Pi] = SIdle
  next
  DrawTitleFighters
  return
end sub

' the fighters stand on the title's strip of canvas (rows 12-15)
sub DrawTitleFighters:
  u8 Px = 0
  u8 Pt = 0
  u8 Cl = 0
  for Li = 0 to 3
    Y = 95 + LayerDY[Li]
    Pt = PosePat0[Li]
    Px = Fx[0] + PoseX0[Li]
    Cl = 9
    if (Li & 1) = 0 then Cl = 15
    set sprite Li to Y,Px,Pt,Cl
    Pt = PosePat1[Li]
    Px = Fx[1] + PoseX1[Li]
    if (Li & 1) = 0 then Cl = 1
    set sprite Li + 4 to Y,Px,Pt,Cl
  next
  update sprites
  return
end sub

sub ShowMenu:
  for Ti = 0 to 4
    put char 32 at 7,Ti + 17
  next
  put char 62 at 7,Sel + 17
  print at 9,17, "ONE PLAYER"
  print at 9,18, "TWO PLAYERS"
  if Hard = 0 then
    print at 9,19, "COMPUTER: EASY  "
  else
    print at 9,19, "COMPUTER: NORMAL"
  end if
  print at 9,20, "HOW TO PLAY"
  print at 9,21, "CREDITS"
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  Fx[0] = 96
  Fx[1] = 128
  for Pi = 0 to 1
    Fs[Pi] = SIdle
    Fm[Pi] = 0
    Mv[Pi] = 0
  next
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "WHITE AND BLACK FIGHT IN A"
    print at 2,4, "RING. HIT THE OTHER FIGHTER"
    print at 2,5, "WHEN HE IS NOT ATTACKING OR"
    print at 2,6, "BLOCKING: HE FALLS AND YOU"
    print at 2,7, "GET 100 POINTS."
    print at 2,9, "1000 POINTS WINS. AFTER 90"
    print at 2,10, "SECONDS, MORE POINTS WINS."
    Fs[0] = SAct
    Fm[0] = 1
    Fs[1] = SHit
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: WALK IN AND OUT"
    print at 2,4, "BUTTON + TOWARD: PUNCH"
    print at 2,5, "BUTTON + UP-TOWARD: KICK"
    print at 2,6, "BUTTON + DOWN-TOWARD: SWEEP"
    print at 2,7, "BUTTON ALONE: BLOCK"
    print at 2,9, "A BLOCK STOPS PUNCHES AND"
    print at 2,10, "KICKS, BUT NOT A SWEEP."
    Fs[0] = SAct
    Fs[1] = SBlock
  case 3
    print at 2,1, "TIPS                    3/3"
    print at 2,3, "LET GO OF THE BUTTON AFTER"
    print at 2,4, "EACH MOVE. PRESS TOO FAST"
    print at 2,5, "AND YOU FREEZE!"
    print at 2,7, "WHITE: CONTROLLER 1. BLACK:"
    print at 2,8, "CONTROLLER 2 OR COMPUTER."
    print at 2,10, "TIP: DON'T REPEAT ONE MOVE."
    print at 2,11, "THE COMPUTER LEARNS IT!"
    Fs[0] = SAct
    Fm[0] = 2
  end select
  fill TCanvasf count 28 at 2,13
  for Ti = 14 to 16
    fill TCanvas count 28 at 2,Ti
  next
  fill TCanvasl count 28 at 2,17
  DrawFighters
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 31
  Wt = 0
ht_wait:
  Frame1
  ReadPads
  N = Pads & (Pads ^ OldPads)
  Wt = Wt + 1
  if Wt >= 1800 then return
  if (N & 16) = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F6
  backdrop dark red
  print at 8,2, "RINGSIDE KARATE"
  print at 2,5, "BASED ON RINGSIDE KARATE"
  print at 2,6, "BY ANTHONY BERTRAM,"
  print at 2,7, "COMPUTE!'S GAZETTE"
  print at 2,8, "OCTOBER 1986 (COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: BOW IN (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

