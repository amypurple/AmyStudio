cartridge "BOUNTY HUNTER/COMPUTE!'S GAZETTE/1987"

' BOUNTY HUNTER
' A ColecoVision game based on "Bounty Hunter", COMPUTE!'s Gazette disk,
' August 1987 (Commodore 64, BASIC). The listing names no author (only
' the COMPUTE! Publications copyright).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: a map of the 48 contiguous United States. A crook hides in
' one of them; you start in another (your home). Ride from state to
' neighbouring state to reach the crook's state. The crook flees every few
' seconds and each of its moves takes $100 off the $10,000 bounty. Catch
' it ("GOT HIM!") and it escapes at once: now ride home before it catches
' you ("GOT YOU!", the bounty is lost). Get home and the bounty is yours.
' COUNT DOWN: no crook; in 1 to 5 minutes visit as many different states
' as you can. Either game can name the states or their capitals, and the
' map can be shown or hidden (only names and the riders' markers).
'
' From the original (orig/bounty.bas): the 48 states with their capitals
' and neighbour lists (DATA lines 1750-2110); the two games, BOUNTY HUNTER
' and COUNT DOWN (1-5 minutes, one point a new state, "ALREADY CHOSEN");
' STATES or CAPITALS; VISIBLE or INVISIBLE map; three difficulties (the
' crook moves after 3, 2 or 1 passes of its search); the random start
' with the crook elsewhere and your start as home; the crook's choice: in
' the chase it takes the neighbour with the largest score |dx| * R8 / R9
' + |dy| (R8 random 1-3, R9 random 1-2), less 1000 for a state next to
' you, a negative score becoming a random 0-3; after the catch it goes
' to a random state and then takes the neighbour with the smallest
' |dx| + |dy| (same 1000 rule): it runs at you. $100 off the bounty per
' crook move in the chase; GOT HIM / GO HOME / YOU WIN / GOT YOU / TIME
' IS UP.
'
' Liberties: no typing (the ColecoVision has no keyboard): the stick
' points at a neighbouring state, the right button steps through the
' neighbours in turn, the left button rides there. The neighbours are
' lit on the visible map; with the hidden map only their names show.
' One map of the whole country instead of the C64's two halves, drawn
' from real outlines on a 28 x 16 grid (a few tiny states touch only at a
' corner there; the listing's neighbour lists still rule). The crook's
' randomness is applied to the distance (|dx| * R8 / R9) instead of to
' the two C64 X positions, which made the score depend on the map half.
' You start at least two states from the crook. The crook's timer is in seconds (about 1.8, 1.25 or 0.9) instead of passes of a
' BASIC loop, and your ride takes a moment (a smooth slide). When the bounty
' reaches $0 the crook gets away (game over; the listing went on forever). In the chase the crook never steps onto your state
' (it could, by chance, with no effect); riding into the crook on the way home loses like the crook
' landing on you (the listing only checked the crook's moves). After the
' catch the crook reappears at least two states away from you and never
' at your home (it could reappear on or next to you). The listing's
' crook could keep a stale choice when every score was below zero; here
' it always picks a neighbour.
'
' Controls: either controller. Stick: point at a neighbour. Right
' button: next neighbour. Left button: ride. On the title, up/down choose
' a line, left/right change it, a button starts.
'
' House rules: text in columns 2-29; tiles from code 128; music first in
' the sound table, the title tune once; screens drawn with the NMI off,
' display off; `set sprite count` always given; own xorshift random
' numbers; nothing flashes.

const TC00 = 128
const TC01 = 129
const TC02 = 130
const TC03 = 131
const TC10 = 132
const TC11 = 133
const TC12 = 134
const TC13 = 135
const TC20 = 136
const TC21 = 137
const TC22 = 138
const TC23 = 139
const TC30 = 140
const TC31 = 141
const TC32 = 142
const TC33 = 143
const TNb0 = 144
const TNb1 = 145
const TNb2 = 146
const TNb3 = 147
const TPk0 = 148
const TPk1 = 149
const TPk2 = 150
const TPk3 = 151
const THr0 = 152
const THr1 = 153
const THr2 = 154
const THr3 = 155
const TSn0 = 156
const TSn1 = 157
const TSn2 = 158
const TSn3 = 159
const TSea = 160
const TRule = 161
const TStar = 162
const SHunter = 0
const SBadge = 4
const SCrook = 8
const SHouse = 12
const NTiles8 = 280
const SprBytes = 128
const NCells = 320
const NNb = 214
const SndTuneA = 1
const SndTuneB = 2
const SndRide = 3
const SndStep = 4
const SndClick = 5
const SndNope = 6
const SndGot = 7
const SndLost = 8
const SndWin = 9
const SndTime = 10
const NSpr = 4
const RideStep = 2
const MsgN = 150
const FirstWait = 60

record Rider:
  u8 X
  u8 Y
  u8 Tx
  u8 Ty
  u8 St
  u8 Dest
end record

data PerT bytes
  0, 110, 75, 55
end data

Rider Hunter
Rider Crook
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 Bounty = 10000
u16 TimeLeft = 0
u16 Nm16 = 0
' settings: game (0 hunter, 1 count down), names (0 states, 1 capitals),
' map (0 visible, 1 hidden), difficulty 1-3, minutes 1-5
u8 GameK = 0
u8 NameK = 0
u8 MapK = 0
u8 Diff = 2
u8 Mins = 2
u8 Line = 0
' play state
u8 Here = 1
u8 Pick = 0
u8 Home = 1
u8 Phase = 0
u8 Hidden = 0
u8 CrookT = 0
u8 Count = 0
u8 SecT = 0
u8 MsgT = 0
u8 Over = 0
u8 Moving = 0
u8 Seen[49]
u8 TitleOn = 0
u8 InPlay = 0
' input
u8 J1 = 0
u8 Btn1 = 0
u8 Btn2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 Press1 = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u16 TzLeft = 0
u8 TzOn = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Si = 0

  tile screen
  set sound table BhSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  ClearMsg
  select case Over
  case 1
    print at 2,21, "YOU WIN!"
    print at 2,22, "THE BOUNTY IS YOURS"
    play sound SndWin
  case 2
    print at 2,21, "GOT YOU!"
    print at 2,22, "THE BOUNTY IS LOST"
    Bounty = 0
    ShowHud
    play sound SndLost
  case 4
    print at 2,22, "THE CROOK GOT AWAY"
    play sound SndLost
  case else
    print at 2,21, "TIME IS UP"
    print at 2,22, "STATES VISITED:"
    print Count at 18,22 width 2
    play sound SndTime
  end select
  InPlay = 0
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearMsg
  end if
  if GameK = 1 then
    inc SecT
    if SecT >= 60 then
      SecT = 0
      if TimeLeft > 0 then dec TimeLeft
      ShowHud
      if TimeLeft = 0 then Over = 3
    end if
  end if
  if Over > 0 then return
  if Moving = 1 then
    Slide(0)
    if Hunter.X = Hunter.Tx then
      if Hunter.Y = Hunter.Ty then Arrive
    end if
  else
    TakeInput
  end if
  if Over > 0 then return
  if GameK = 0 then
    Slide(1)
    dec CrookT
    if CrookT = 0 then
      CrookT = PerT[Diff]
      CrookMove
    end if
  end if
  return
end sub

' the stick points at a neighbour, the right button steps through them,
' the left button rides
sub TakeInput:
  u8 Old = 0
  Old = Pick
  V = J1 & 15
  if V > 0 then
    if V <> WasStick then PointAt(V)
  end if
  WasStick = V
  if Press2 = 1 then NextNb
  if Pick <> Old then
    PaintState(Old)
    PaintState(Pick)
    ShowPick
    play sound SndClick
  end if
  if Press1 = 1 then
    if Pick > 0 then
      Moving = 1
      Hunter.Dest = Pick
      Hunter.Tx = StX[Pick]
      Hunter.Ty = StY[Pick]
      play sound SndRide
    end if
  end if
  return
end sub

' the neighbour most in the stick's direction (score: the projection on
' the direction over the distance |dx| + |dy|)
sub PointAt(u8 Stk):
  i16 Sx = 0
  i16 Sy = 0
  i16 Dx = 0
  i16 Dy = 0
  i16 Sc = 0
  i16 Best = 0
  u8 N0 = 0
  u8 N1 = 0
  u8 I = 0
  u8 M = 0
  u16 Ln = 0
  if Stk & 4 then Sx = -1
  if Stk & 8 then Sx = 1
  if Stk & 1 then Sy = -1
  if Stk & 2 then Sy = 1
  N0 = NbOff[Here]
  N1 = NbOff[Here + 1]
  for I = N0 to N1 - 1
    M = NbList[I]
    Dx = StX[M]
    Dx = Dx - StX[Here]
    Dy = StY[M]
    Dy = Dy - StY[Here]
    Ln = abs(Dx) + abs(Dy)
    Sc = Dx * Sx + Dy * Sy
    Sc = Sc * 16
    Sc = Sc / Ln
    if Sc > Best then
      Best = Sc
      Pick = M
    end if
  next
end sub

' the next neighbour in the listing's order
sub NextNb:
  u8 N0 = 0
  u8 N1 = 0
  u8 I = 0
  u8 Fnd = 0
  N0 = NbOff[Here]
  N1 = NbOff[Here + 1]
  Fnd = N0
  for I = N0 to N1 - 1
    if NbList[I] = Pick then Fnd = I + 1
  next
  if Fnd >= N1 then Fnd = N0
  Pick = NbList[Fnd]
end sub

' the hunter reaches a state
sub Arrive:
  u8 Old = 0
  Moving = 0
  Old = Here
  Here = Hunter.Dest
  Hunter.St = Here
  Pick = 0
  RepaintAround(Old)
  ShowHud
  if GameK = 1 then
    if Seen[Here] = 0 then
      Seen[Here] = 1
      inc Count
      ShowHud
      play sound SndStep
    else
      Say(1)
    end if
    PaintState(Here)
    return
  end if
  if Phase = 0 then
    if Here = Crook.St then Caught
  else
    if Here = Home then
      Over = 1
    elseif Here = Crook.St then
      Over = 2
    end if
  end if
  return
end sub

sub Caught:
  Phase = 1
  Hidden = 1
  Crook.X = 0
  Crook.Y = 208
  play sound SndGot
  Say(2)
  ShowHud
  return
end sub

' the crook's move
sub CrookMove:
  u8 Old = 0
  Old = Crook.St
  if Hidden = 1 then
    Reappear
  else
    Crook.St = ChooseFor(Old)
  end if
  Crook.Tx = StX[Crook.St]
  Crook.Ty = StY[Crook.St]
  if Phase = 0 then
    if Bounty >= 100 then Bounty = Bounty - 100
    play sound SndStep
    ShowHud
    if Bounty = 0 then Over = 4
  end if
  if Phase = 1 then
    if Crook.St = Here then
      if Moving = 0 then Over = 2
    end if
  end if
  if MapK = 1 then ShowHud
  return
end sub

' after the catch: a random state at least two states from the hunter,
' not home
sub Reappear:
  u8 C = 0
  u8 Ok = 0
  while Ok = 0
    C = RandN(48) + 1
    Ok = 1
    if C = Here then Ok = 0
    if C = Home then Ok = 0
    if IsNb(C, Here) = 1 then Ok = 0
  end while
  Crook.St = C
  Crook.X = StX[C]
  Crook.Y = StY[C]
  Hidden = 0
  return
end sub

' the crook's choice among its neighbours (the listing's scores)
function ChooseFor(u8 From) as u8
  u8 N0 = 0
  u8 N1 = 0
  u8 I = 0
  u8 M = 0
  u8 R8 = 1
  u8 R9 = 1
  u8 Rd = 0
  u8 Skip = 0
  i16 V1 = 0
  i16 Vx = 0
  i16 V2 = 0
  i16 Best = 0
  if Phase = 0 then
    Best = -1
  else
    Best = 30000
  end if
  Rd = From
  N0 = NbOff[From]
  N1 = NbOff[From + 1]
  for I = N0 to N1 - 1
    M = NbList[I]
    Skip = 0
    if Phase = 0 then
      if M = Here then Skip = 1
    end if
    if Skip = 0 then
      R8 = 1
      R9 = 1
      if Phase = 0 then
        R8 = RandN(3) + 1
        R9 = RandN(2) + 1
      end if
      Vx = abs(StX[Here] - StX[M])
      Vx = Vx * R8
      Vx = Vx / R9
      V1 = abs(StY[Here] - StY[M])
      if IsNb(M, Here) = 1 then Vx = Vx - 1000
      V2 = Vx + V1
      if V2 < 0 then V2 = RandN(4)
      if Phase = 0 then
        if V2 > Best then
          Best = V2
          Rd = M
        end if
      else
        if V2 < Best then
          Best = V2
          Rd = M
        end if
      end if
    end if
  next
  return Rd

function IsNb(u8 A, u8 B) as u8
  u8 N0 = 0
  u8 N1 = 0
  u8 I = 0
  u8 Res = 0
  N0 = NbOff[A]
  N1 = NbOff[A + 1]
  for I = N0 to N1 - 1
    if NbList[I] = B then Res = 1
  next
  return Res

' xorshift random 0..N-1
function RandN(u8 N) as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  W16 = Rs % N
  return W16

' a rider slides 2 pixels a frame toward its target
sub Slide(u8 Who):
  u8 Px = 0
  u8 Py = 0
  u8 Tx = 0
  u8 Ty = 0
  if Who = 0 then
    Px = Hunter.X
    Py = Hunter.Y
    Tx = Hunter.Tx
    Ty = Hunter.Ty
  else
    Px = Crook.X
    Py = Crook.Y
    Tx = Crook.Tx
    Ty = Crook.Ty
  end if
  if Px < Tx then
    Px = Px + RideStep
    if Px > Tx then Px = Tx
  elseif Px > Tx then
    Px = Px - RideStep
    if Px < Tx then Px = Tx
  end if
  if Py < Ty then
    Py = Py + RideStep
    if Py > Ty then Py = Ty
  elseif Py > Ty then
    Py = Py - RideStep
    if Py < Ty then Py = Ty
  end if
  if Who = 0 then
    Hunter.X = Px
    Hunter.Y = Py
  else
    Crook.X = Px
    Crook.Y = Py
  end if
end sub

' ---------------------------------------------------------------------------
' drawing

' a state's look: here, chosen, neighbour, visited, or its map colour
function StatusOf(u8 S) as u8
  u8 Res = 0
  Res = StCol[S]
  if GameK = 1 then
    if Seen[S] = 1 then Res = 7
  end if
  if Moving = 0 then
    if IsNb(Here, S) = 1 then Res = 4
  end if
  if S = Pick then Res = 5
  if S = Here then Res = 6
  return Res

' every cell of one state (nothing on the hidden map)
sub PaintState(u8 S):
  u16 I = 0
  u16 I0 = 0
  u16 I1 = 0
  u8 T = 0
  u8 Base = 0
  if S > 0 then
    Base = StatusOf(S) << 2
    Base = Base + TC00
    I0 = CellOff[S]
    I1 = CellOff[S + 1]
    while I < I1
      if I < I0 then I = I0
      T = Base + CellE[I]
      if MapK = 1 then T = TSea
      put char T at CellC[I],CellR[I]
      inc I
    end while
  end if
end sub

' a state and its neighbours, the old and the new
sub RepaintAround(u8 Old):
  u8 I = 0
  u8 N0 = 0
  u8 N1 = 0
  PaintState(Old)
  N0 = NbOff[Old]
  N1 = NbOff[Old + 1]
  for I = N0 to N1 - 1
    PaintState(NbList[I])
  next
  N0 = NbOff[Here]
  N1 = NbOff[Here + 1]
  for I = N0 to N1 - 1
    PaintState(NbList[I])
  next
  PaintState(Here)
  ShowPick
end sub

sub DrawMap:
  for Si = 1 to 16
    fill TSea count 28 at 2,Si
  next
  for Si = 1 to 48
    PaintState(Si)
  next
  fill TRule count 28 at 2,17
end sub

' a name from the chosen list (states or capitals), 14 letters
sub PutName(u8 S, u8 Px, u8 Py):
  u16 Off = 0
  Off = S * 14
  if NameK = 0 then
    put StName + Off count 14 at Px,Py
  else
    put CapName + Off count 14 at Px,Py
  end if
end sub

sub ShowPick:
  print at 2,19, "GO TO"
  PutName(Pick, 9, 19)
end sub

sub ShowHud:
  print at 2,18, "IN"
  PutName(Here, 9, 18)
  if GameK = 0 then
    print at 2,21, "BOUNTY $"
    print Bounty at 10,21 width 5
    if Phase = 1 then
      print at 2,20, "HOME "
      PutName(Home, 9, 20)
    elseif MapK = 1 then
      print at 2,20, "CROOK"
      PutName(Crook.St, 9, 20)
    end if
  else
    print at 2,21, "TIME"
    print TimeLeft at 7,21 width 3
    print at 14,21, "STATES"
    print Count at 21,21 width 2
  end if
end sub

sub ClearMsg:
  fill 32 count 28 at 2,22
end sub

' the message line: 1 already chosen, 2 got him, 3 the crook's start
sub Say(u8 Which):
  ClearMsg
  select case Which
  case 1
    print at 2,22, "ALREADY CHOSEN"
    play sound SndNope
  case 2
    print at 2,22, "GOT HIM! GO HOME!"
  case 3
    print at 2,22, "THE CROOK IS IN"
    PutName(Crook.St, 18, 22)
  end select
  MsgT = MsgN
end sub

' sprite 0 the badge, 1 the hunter, 2 the crook, 3 home (after the catch)
sub DrawSprites:
  if InPlay = 0 then return
  X = Hunter.X - 8
  Y = Hunter.Y - 10
  set sprite 0 to Y,X,SBadge,11
  set sprite 1 to Y,X,SHunter,15
  if GameK = 0 then
    if Hidden = 0 then
      X = Crook.X - 8
      Y = Crook.Y - 9
      set sprite 2 to Y,X,SCrook,8
    else
      set sprite 2 to 208,0,0,0
    end if
  end if
  if Phase = 1 then
    X = StX[Home] - 8
    Y = StY[Home] - 9
    set sprite 3 to Y,X,SHouse,10
  end if
  update sprites
end sub

' ---------------------------------------------------------------------------
' a new game

sub NewGame:
  NewScreen
  backdrop dark blue
  for Si = 0 to 48
    Seen[Si] = 0
  next
  Phase = 0
  Hidden = 0
  Over = 0
  Moving = 0
  Pick = 0
  Count = 0
  MsgT = 0
  SecT = 0
  Bounty = 10000
  W16 = Mins
  TimeLeft = W16 * 60
  Crook.St = RandN(48) + 1
  Here = Crook.St
  while Here = Crook.St
    Here = RandN(48) + 1
    if IsNb(Here, Crook.St) = 1 then Here = Crook.St
  end while
  Home = Here
  Hunter.St = Here
  Hunter.X = StX[Here]
  Hunter.Y = StY[Here]
  Hunter.Tx = Hunter.X
  Hunter.Ty = Hunter.Y
  Crook.X = StX[Crook.St]
  Crook.Y = StY[Crook.St]
  Crook.Tx = Crook.X
  Crook.Ty = Crook.Y
  if GameK = 1 then
    Seen[Here] = 1
    Count = 1
  end if
  DrawMap
  ShowHud
  ShowPick
  CrookT = PerT[Diff] + FirstWait
  if GameK = 0 then Say(3)
  InPlay = 1
  DrawSprites
  ShowScreen
  play sound SndStep
  return
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  Btn1 = 0
  Btn2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then Btn1 = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).button1 then Btn1 = 1
  if joypad(2).button2 then Btn2 = 1
  Press1 = 0
  Press2 = 0
  if Btn1 = 1 then
    if WasB1 = 0 then Press1 = 1
  end if
  if Btn2 = 1 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB1 = Btn1
  WasB2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 208,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  InPlay = 0
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: settings menu, the tune once
sub TitlePage:
  NewScreen
  backdrop dark blue
  put char TStar at 7,2
  print at 9,2, "BOUNTY HUNTER"
  put char TStar at 23,2
  print at 6,4, "COMPUTE!'S GAZETTE"
  print at 10,5, "AUGUST 1987"
  ShowMenu
  print at 3,18, "UP/DOWN: LINE"
  print at 3,19, "LEFT/RIGHT: CHANGE"
  print at 3,20, "BUTTON: START"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 440
  TzOn = 1
  TitleOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 1
  WasB2 = 1
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 15
  if V <> WasStick then
    if V > 0 then MenuKey(V)
  end if
  WasStick = V
  K = Press1 | Press2
  if K = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Line = 5 then
    CreditsPage
    goto title
  end if
  return
end sub

sub MenuKey(u8 Stk):
  if Stk & 1 then
    if Line > 0 then dec Line
  end if
  if Stk & 2 then
    if Line < 5 then inc Line
  end if
  if Stk & 12 then
    select case Line
    case 0
      GameK = GameK ^ 1
    case 1
      NameK = NameK ^ 1
    case 2
      MapK = MapK ^ 1
    case 3
      if GameK = 0 then
        if Stk & 8 then
          if Diff < 3 then inc Diff
        else
          if Diff > 1 then dec Diff
        end if
      else
        if Stk & 8 then
          if Mins < 5 then inc Mins
        else
          if Mins > 1 then dec Mins
        end if
      end if
    end select
  end if
  ShowMenu
  play sound SndClick
end sub

sub ShowMenu:
  u8 Row = 0
  for Si = 8 to 13
    put char 32 at 3,Si
  next
  Row = Line + 8
  put char 62 at 3,Row
  if GameK = 0 then
    print at 5,8, "GAME   BOUNTY HUNTER"
  else
    print at 5,8, "GAME   COUNT DOWN   "
  end if
  if NameK = 0 then
    print at 5,9, "NAMES  STATES  "
  else
    print at 5,9, "NAMES  CAPITALS"
  end if
  if MapK = 0 then
    print at 5,10, "MAP    VISIBLE  "
  else
    print at 5,10, "MAP    INVISIBLE"
  end if
  if GameK = 0 then
    print at 5,11, "LEVEL  "
    print Diff at 12,11 width 1
    print at 13,11, " (1-3)  "
  else
    print at 5,11, "MINUTES"
    print Mins at 13,11 width 1
    print at 14,11, " (1-5) "
  end if
  print at 5,12, "START"
  print at 5,13, "CREDITS"
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "BOUNTY HUNTER"
  print at 2,5, "BASED ON BOUNTY HUNTER,"
  print at 2,6, "COMPUTE!'S GAZETTE DISK,"
  print at 2,7, "AUGUST 1987 (COMMODORE 64)."
  print at 2,8, "COPYRIGHT 1987 COMPUTE!"
  print at 2,9, "PUBLICATIONS, INC."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: TRAIL OF THE CROOK"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

