asm {
; OmSpr: the 16 objects (Oy Ox Op Oc, fixed order) into sprite table
; entries 2-17 of SprTab, object k at entry 2 + ((k + Rot) and 15)
OmSpr:
    push ix
    ld a,(AMY_UVAR_Rot)
    ld c,a
    ld b,0
OmSprL:
    ld a,b
    add a,c
    and 15
    add a,2
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld ix,AMY_UVAR_SprTab
    add ix,de
    ld e,b
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld a,(hl)
    ld (ix+0),a
    ld hl,AMY_UVAR_Ox
    add hl,de
    ld a,(hl)
    ld (ix+1),a
    ld hl,AMY_UVAR_Op
    add hl,de
    ld a,(hl)
    ld (ix+2),a
    ld hl,AMY_UVAR_Oc
    add hl,de
    ld a,(hl)
    ld (ix+3),a
    inc b
    ld a,b
    cp 16
    jr nz,OmSprL
    pop ix
    ret
; OmCopy: SprTab (76 bytes) to the sprite attribute table at $1B00, at 32
; cycles a byte (outi, nop): safe in the active display with the NMI off
OmCopy:
    ld a,$00
    out (VDP_CTRL_PORT),a
    ld a,$5B
    out (VDP_CTRL_PORT),a
    ld hl,AMY_UVAR_SprTab
    ld b,76
    ld c,$BE
OmCopyL:
    outi
    nop
    jr nz,OmCopyL
    ret
; OmMove: see sub Move (Gx Gy Gvx Gvy -> X Y Gb)
OmMove:
    xor a
    ld (AMY_UVAR_Gb),a
    ld hl,(AMY_UVAR_Gx)
    ld a,(AMY_UVAR_Gvx)
    call OmAddV
    ld (AMY_UVAR_Gx),hl
    call OmPix
    ld (AMY_UVAR_X),a
    ld hl,(AMY_UVAR_Gy)
    ld a,(AMY_UVAR_Gvy)
    call OmAddV
    ld (AMY_UVAR_Gy),hl
    call OmPix
    ld (AMY_UVAR_Y),a
    ; x edges
    ld a,(AMY_UVAR_X)
    cp 241
    jr c,OmMx1
    xor a
OmMx1:
    cp 16
    jr nc,OmMx2
    ld hl,256
    ld (AMY_UVAR_Gx),hl
    ld a,16
    ld (AMY_UVAR_X),a
    ld a,(AMY_UVAR_Gvx)
    cp 128
    call c,OmNegX
    call OmBnc
    jr OmMy
OmMx2:
    cp 225
    jr c,OmMy
    ld hl,3584
    ld (AMY_UVAR_Gx),hl
    ld a,224
    ld (AMY_UVAR_X),a
    ld a,(AMY_UVAR_Gvx)
    cp 129
    call nc,OmNegX
    call OmBnc
OmMy:
    ld a,(AMY_UVAR_Y)
    cp 241
    jr c,OmMy1
    xor a
OmMy1:
    cp 12
    jr nc,OmMy2
    ld hl,192
    ld (AMY_UVAR_Gy),hl
    ld a,12
    ld (AMY_UVAR_Y),a
    ld a,(AMY_UVAR_Gvy)
    cp 128
    call c,OmNegY
    call OmBnc
    jr OmMb
OmMy2:
    cp 169
    jr c,OmMb
    ld hl,2688
    ld (AMY_UVAR_Gy),hl
    ld a,168
    ld (AMY_UVAR_Y),a
    ld a,(AMY_UVAR_Gvy)
    cp 129
    call nc,OmNegY
    call OmBnc
OmMb:
    ; the board: out if X+13 <= 80, X+2 >= 176, Y+13 <= 72, Y+2 >= 120
    ld a,(AMY_UVAR_X)
    cp 68
    ret c
    cp 174
    ret nc
    ld a,(AMY_UVAR_Y)
    cp 60
    ret c
    cp 118
    ret nc
    call OmBnc
    ld a,(AMY_UVAR_X)
    add a,8
    cp 80
    jr nc,OmMb2
    ld hl,1056
    ld (AMY_UVAR_Gx),hl
    ld a,66
    ld (AMY_UVAR_X),a
    ld a,(AMY_UVAR_Gvx)
    cp 129
    ret c
    jp OmNegX
OmMb2:
    cp 176
    jr c,OmMb3
    ld hl,2784
    ld (AMY_UVAR_Gx),hl
    ld a,174
    ld (AMY_UVAR_X),a
    ld a,(AMY_UVAR_Gvx)
    cp 128
    ret nc
    jp OmNegX
OmMb3:
    ld a,(AMY_UVAR_Y)
    add a,8
    cp 96
    jr nc,OmMb4
    ld hl,928
    ld (AMY_UVAR_Gy),hl
    ld a,58
    ld (AMY_UVAR_Y),a
    ld a,(AMY_UVAR_Gvy)
    cp 129
    ret c
    jp OmNegY
OmMb4:
    ld hl,1888
    ld (AMY_UVAR_Gy),hl
    ld a,118
    ld (AMY_UVAR_Y),a
    ld a,(AMY_UVAR_Gvy)
    cp 128
    ret nc
    jp OmNegY
OmBnc:
    ld a,1
    ld (AMY_UVAR_Gb),a
    ret
OmNegX:
    ld a,(AMY_UVAR_Gvx)
    neg
    ld (AMY_UVAR_Gvx),a
    ret
OmNegY:
    ld a,(AMY_UVAR_Gvy)
    neg
    ld (AMY_UVAR_Gvy),a
    ret
; OmAddV: HL += A - 128 (A a biased speed)
OmAddV:
    sub 128
    ld e,a
    ld d,0
    bit 7,a
    jr z,OmAddV1
    dec d
OmAddV1:
    add hl,de
    ret
; OmPix: A = low byte of HL >> 4
OmPix:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,l
    ret
; OmMoveE: enemy Gi's arrays (Ex Ey Evx Evy) through OmMove, back, and
; its pixel place into E8x E8y
OmMoveE:
    ld a,(AMY_UVAR_Gi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Ex
    add hl,de
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Gx),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_Gx+1),a
    ld hl,AMY_UVAR_Ey
    add hl,de
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Gy),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_Gy+1),a
    ld hl,AMY_UVAR_Evx
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Gvx),a
    ld hl,AMY_UVAR_Evy
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Gvy),a
    call OmMove
    ld a,(AMY_UVAR_Gi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Ex
    add hl,de
    add hl,de
    ld a,(AMY_UVAR_Gx)
    ld (hl),a
    inc hl
    ld a,(AMY_UVAR_Gx+1)
    ld (hl),a
    ld hl,AMY_UVAR_Ey
    add hl,de
    add hl,de
    ld a,(AMY_UVAR_Gy)
    ld (hl),a
    inc hl
    ld a,(AMY_UVAR_Gy+1)
    ld (hl),a
    ld hl,AMY_UVAR_Evx
    add hl,de
    ld a,(AMY_UVAR_Gvx)
    ld (hl),a
    ld hl,AMY_UVAR_Evy
    add hl,de
    ld a,(AMY_UVAR_Gvy)
    ld (hl),a
    ld hl,AMY_UVAR_E8x
    add hl,de
    ld a,(AMY_UVAR_X)
    ld (hl),a
    ld hl,AMY_UVAR_E8y
    add hl,de
    ld a,(AMY_UVAR_Y)
    ld (hl),a
    ret
; OmNear: V = 1 if |X-X2| < 10 and |Y-Y2| < 10
OmNear:
    xor a
    ld (AMY_UVAR_V),a
    ld a,(AMY_UVAR_X)
    ld hl,AMY_UVAR_X2
    sub (hl)
    jr nc,OmN1
    neg
OmN1:
    cp 10
    ret nc
    ld a,(AMY_UVAR_Y)
    ld hl,AMY_UVAR_Y2
    sub (hl)
    jr nc,OmN2
    neg
OmN2:
    cp 10
    ret nc
    ld a,1
    ld (AMY_UVAR_V),a
    ret
; OmScanE: Gi = the first enemy J with Gs <= Es[J] <= 4 near X,Y, or 255
OmScanE:
    ld b,0
OmSE1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Es
    add hl,de
    ld a,(hl)
    cp 5
    jr nc,OmSE2
    ld hl,AMY_UVAR_Gs
    cp (hl)
    jr c,OmSE2
    ld hl,AMY_UVAR_E8x
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_E8y
    add hl,de
    ld a,(hl)
    call OmNr
    jr c,OmSHit
OmSE2:
    inc b
    ld a,b
    cp 6
    jr nz,OmSE1
OmSNone:
    ld a,255
    ld (AMY_UVAR_Gi),a
    ret
OmSHit:
    ld a,b
    ld (AMY_UVAR_Gi),a
    ret
; OmScanB: the first bomb near X,Y
OmScanB:
    ld b,0
OmSB1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Bk
    add hl,de
    ld a,(hl)
    cp 255
    jr z,OmSB2
    ld hl,AMY_UVAR_Bx
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_By
    add hl,de
    ld a,(hl)
    call OmNr
    jr c,OmSHit
OmSB2:
    inc b
    ld a,b
    cp 6
    jr nz,OmSB1
    jr OmSNone
; OmScanQ: the first enemy shot near X,Y
OmScanQ:
    ld b,0
OmSQ1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Ql
    add hl,de
    ld a,(hl)
    or a
    jr z,OmSQ2
    ld hl,AMY_UVAR_Q8x
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_Q8y
    add hl,de
    ld a,(hl)
    call OmNr
    jr c,OmSHit
OmSQ2:
    inc b
    ld a,b
    cp 2
    jr nz,OmSQ1
    jr OmSNone
; OmNr: carry if |X - C| < 10 and |Y - A| < 10 (keeps B, DE)
OmNr:
    ld hl,AMY_UVAR_Y
    sub (hl)
    jr nc,OmNr1
    neg
OmNr1:
    cp 10
    ret nc
    ld a,(AMY_UVAR_X)
    sub c
    jr nc,OmNr2
    neg
OmNr2:
    cp 10
    ret
; OmDraw: the 16 objects' sprites into Oy Ox Op Oc (fixed order: enemies,
; bombs, missiles, shots). Patterns: SDr0 128, SB0 160, SMi 184, SX0 188
; (build.py checks them against gfxconst.txt)
OmDraw:
    ld b,0
OmD1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Es
    add hl,de
    ld a,(hl)
    or a
    jr nz,OmD2
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),192
    jr OmD9
OmD2:
    ld c,a
    ld hl,AMY_UVAR_E8y
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),a
    ld hl,AMY_UVAR_E8x
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Ox
    add hl,de
    ld (hl),a
    ld a,c
    cp 5
    jr nz,OmD3
    ld hl,AMY_UVAR_Ef
    add hl,de
    ld a,(hl)
    srl a
    srl a
    srl a
    ld c,a
    ld a,2
    sub c
    add a,a
    add a,a
    add a,188
    ld hl,AMY_UVAR_Op
    add hl,de
    ld (hl),a
    ld hl,AMY_UVAR_Oc
    add hl,de
    ld (hl),11
    jr OmD9
OmD3:
    push bc
    ld hl,AMY_UDATA_ECol
    ld b,0
    add hl,bc
    ld a,(hl)
    pop bc
    ld hl,AMY_UVAR_Oc
    add hl,de
    ld (hl),a
    ld a,c
    dec a
    add a,a
    add a,a
    add a,a
    add a,128
    ld c,a
    ld a,(AMY_UVAR_Tick)
    and 8
    jr z,OmD4
    ld a,4
OmD4:
    add a,c
    ld hl,AMY_UVAR_Op
    add hl,de
    ld (hl),a
OmD9:
    inc b
    ld a,b
    cp 6
    jr nz,OmD1
    ; the bombs: objects 6-11
    ld b,0
OmDB1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Bk
    add hl,de
    ld a,(hl)
    ld c,a
    ld e,b
    ld a,b
    add a,6
    ld e,a
    cp a
    ld a,c
    cp 255
    jr nz,OmDB2
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),192
    jr OmDB9
OmDB2:
    push bc
    ld b,0
    ld hl,AMY_UDATA_BCol
    add hl,bc
    ld a,(hl)
    pop bc
    ld hl,AMY_UVAR_Oc
    add hl,de
    ld (hl),a
    ld a,c
    add a,a
    add a,a
    add a,160
    ld hl,AMY_UVAR_Op
    add hl,de
    ld (hl),a
    push de
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Bx
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_By
    add hl,de
    ld a,(hl)
    pop de
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),a
    ld hl,AMY_UVAR_Ox
    add hl,de
    ld (hl),c
OmDB9:
    inc b
    ld a,b
    cp 6
    jr nz,OmDB1
    ; missiles 12-13, shots 14-15
    ld b,0
OmDM1:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Ml
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_M8x
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_M8y
    add hl,de
    ld h,(hl)
    push af
    ld a,b
    add a,12
    ld e,a
    pop af
    ld l,15
    call OmDObj
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Ql
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Q8x
    add hl,de
    ld c,(hl)
    ld hl,AMY_UVAR_Q8y
    add hl,de
    ld h,(hl)
    push af
    ld a,b
    add a,14
    ld e,a
    pop af
    ld l,10
    call OmDObj
    inc b
    ld a,b
    cp 2
    jr nz,OmDM1
    ret
; OmDObj: object E: hidden if A = 0, else at y H, x C, colour L, SMi
OmDObj:
    ld d,0
    or a
    jr nz,OmDO1
    push hl
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),192
    pop hl
    ret
OmDO1:
    ld a,h
    push hl
    ld hl,AMY_UVAR_Oy
    add hl,de
    ld (hl),a
    ld hl,AMY_UVAR_Ox
    add hl,de
    ld (hl),c
    ld hl,AMY_UVAR_Op
    add hl,de
    ld (hl),184
    pop hl
    ld a,l
    ld hl,AMY_UVAR_Oc
    add hl,de
    ld (hl),a
    ret
OmBoom:
    db $00,$00,$04,$02,$00,$00,$25,$04,$00,$00,$46,$06,$00,$00,$67,$0A,$00,$00,$97,$0C,$10
OmPop:
    db $00,$00,$05,$02,$00,$00,$26,$03,$00,$00,$56,$04,$10
OmFire:
    db $40,$40,$10,$01,$40,$4C,$20,$01,$40,$5A,$30,$01,$40,$6B,$50,$02,$50
OmZap:
    db $40,$FE,$20,$01,$40,$D6,$20,$01,$40,$1D,$31,$01,$40,$53,$51,$02,$50
OmDrop:
    db $80,$AB,$31,$02,$80,$FC,$41,$02,$80,$3B,$52,$03,$90
OmClear:
    db $80,$D6,$10,$04,$80,$AA,$10,$04,$80,$8F,$10,$04,$80,$6B,$10,$04,$80,$55,$20,$0C,$90
OmLost:
    db $80,$1D,$11,$04,$80,$41,$21,$04,$80,$53,$31,$04,$80,$7C,$41,$06,$80,$AB,$51,$0C,$90
OmExtra:
    db $80,$6B,$10,$03,$80,$55,$10,$03,$80,$47,$10,$03,$80,$35,$20,$08,$90

OmSoundTable:
    dw OmTuneMel,$702B
    dw OmTuneBass,$7035
    dw OmRunMel,$702B
    dw OmRunBass,$7035
    dw OmBoom,$703F
    dw OmPop,$703F
    dw OmFire,$7049
    dw OmZap,$7049
    dw OmDrop,$7053
    dw OmClear,$7053
    dw OmLost,$7053
    dw OmExtra,$7053
; Omicron Rising (original)
; Tiny Sound, 6 frames per step
OmTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$1A,$21,$23,$01,$1E,$01,$23,$01,$26,$01,$2A,$01,$01,$01
    db $28,$01,$01,$01,$26,$01,$25,$01,$23,$01,$21,$01,$23,$01,$01,$01
    db $00,$01,$01,$01,$1F,$01,$23,$01,$26,$01,$2B,$01,$2A,$01,$28,$01
    db $26,$01,$25,$01,$26,$01,$23,$01,$22,$01,$25,$01,$23,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
OmTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$60,$18,$32,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13
    db $07,$13,$07,$13,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12
    db $06,$12,$06,$12
    db $FF

; Swarm (original)
; Tiny Sound, 6 frames per step
OmRunMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$50,$1A,$21,$23,$01,$01,$01,$01,$01,$1E,$01,$01,$01,$26,$01
    db $01,$01,$25,$01,$01,$01,$01,$01,$01,$01,$21,$01,$01,$01,$23,$01
    db $01,$01,$01,$01,$1F,$01,$01,$01,$01,$01,$1A,$01,$01,$01,$23,$01
    db $01,$01,$22,$01,$01,$01,$01,$01,$01,$01,$1E,$01,$01,$01,$01,$01
    db $01,$01,$01,$01
    db $FF
OmRunBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$70,$18,$32,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13
    db $07,$13,$07,$13,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12
    db $06,$12,$06,$12
    db $FF
}
