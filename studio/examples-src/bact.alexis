cartridge "BACTERIA/COMPUTE!'S GAZETTE/1989"

' BACTERIA
' A ColecoVision game based on "Bacteria", COMPUTE!'s Gazette disk of
' March 1989 (Commodore 128, BASIC 7.0 with a machine-language IRQ core).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the
' listing and its machine code, orig/), the game is built for the
' ColecoVision: smooth 16 x 16 sprites, a tiled cell with three membrane
' rings and a globe grid, sound effects and an original title tune.
'
' The game: you are a white blood cell circling inside a big cell. Bacteria
' are born in its centre and wander; one that reaches the membrane infects
' the cell and costs a unit of health. Shoot them (the shot flies through
' the centre to the far wall) or ram them. A virus creeps slowly round your
' orbit: touching it costs health and sends you back to the bottom, the
' virus to the top. The clock bar on the right fills; when it is full the
' round ends and the next has one more bacterium (1 to 5). After round 5,
' the next level: one bacterium again, everything faster, health restored.
' 24 infections or stings and you have failed the mission.
'
' From the original (orig/bacteria.bas, orig/bacteria-ml.dis): the orbit
' round the cell, the joystick turning left/right, one shot at a time aimed
' at the centre and dying on the far wall; bacteria born in the centre with
' random headings, turning often; a bacterium touching the membrane costs
' health and is born again; a shot hitting one scores 10 x round, the
' player touching one scores 100 x level (counters at $131E and $1320 of
' the IRQ code); the virus (sprite 3) creeping round the same orbit, its
' sting resetting both; 24 units of health; the round clock; rounds of 1
' to 5 bacteria, then a level up with health restored and more speed; the
' best score; the message "YOU FAILED THE MISSION".
'
' Liberties: the bacteria lean outwards (a heading pointing inwards is
' turned round a quarter of the time); on the C-128 they barely drifted out of
' the slow BASIC random walk, so rounds were mostly empty. Points are added
' as they are earned (the listing recomputes the whole score from its two
' counters times the CURRENT level and round, so the score could drop when
' the round number wrapped to 1). The player's speed is fixed (the C-128
' sped up everything, the player too, with each level); bacteria and virus
' speed up. The round clock is 24 seconds. A round banner between rounds.
' Health and time bars are tiles at both sides.
'
' Controls: either controller; left and right turn round the orbit, a
' button fires. On the title, up and down choose START GAME, HOW TO PLAY
' (three pages) or CREDITS; a button picks.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128 (each
' screen third has its own tile set, R3 = $FF); the frame loop is
' protected from the NMI; screens drawn with the NMI off after a wait,
' display off. Music first in the sound table; the title tune is played
' once. `set sprite count` always given. Own xorshift random numbers.
' Nothing flashes.

const SPl0 = 0
const SPl1 = 4
const SPl2 = 8
const SPl3 = 12
const SPl4 = 16
const SPl5 = 20
const SPl6 = 24
const SPl7 = 28
const SShot = 32
const SBac0 = 36
const SBac1 = 40
const SVir0 = 44
const SVir1 = 48
const NTiles8 = 0
const SprBytes = 416
const TBlank = 128
const THp0 = 129
const THp1 = 130
const THp2 = 131
const TTm0 = 132
const TTm1 = 133
const TTm2 = 134
const NCell08 = 672
const NCell18 = 832
const NCell28 = 672
const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndPop = 4
const SndGrab = 5
const SndInfect = 6
const SndSting = 7
const SndRound = 8
const SndLevel = 9
const SndStart = 10
const SndOver = 11
const NSpr = 8
const MsgN = 90
const RoundN = 1440
const WallD2 = 3481
const PlaySpd = 12
const ShotLife = 37

data GermCol bytes
  3, 11, 9, 2, 10
end data

record Germ:
  u16 X
  u16 Y
  i8 Vx
  i8 Vy
  u8 Turn
end record

Germ G[5]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
' player: angle in 1/16 steps of the 128-step orbit
u16 Pa = 0
u8 Ang = 0
u8 Plx = 0
u8 Ply = 0
' shot (centre in 1/16 pixel)
u16 Sx = 0
u16 Sy = 0
i8 Svx = 0
i8 Svy = 0
u8 SOn = 0
u8 SLife = 0
' virus
u8 Ca = 64
u8 CrC = 0
u8 CrN = 26
u8 Vrx = 0
u8 Vry = 0
' game
u8 Hp = 24
u8 Lv = 1
u8 Rd = 1
u8 Spd = 8
u16 RoundT = 0
u8 Sec = 0
u8 Units = 0
u8 MsgT = 0
u8 Over = 0
bcd digits 6 Score = 0
bcd digits 6 Best = 0
bcd digits 6 Ten = 10
bcd digits 6 Hund = 100
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 InPlay = 0
' loop counters
u8 Gi = 0
u8 Ri = 0
u8 Ki = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  ' Graphics II with three independent thirds (R3 = $FF): a tile set each
  ' (mode 2 screen, not tile screen + an asm SetR3: any asm call or jump
  ' makes Amy refuse the `with` alias in GermStep, bugs/bact-with-asm-call)
  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  set sound table BcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop
  InPlay = 0

  ' the end: the original's message, then back to the title on a press
  if Score > Best then Best = Score
  ShowHud
  mute all
  print at 10,10, "            "
  print at 10,11, " YOU FAILED "
  print at 10,12, " THE MISSION"
  print at 10,13, "            "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

function Scale(i8 Vv, u8 S) as i8
  i16 Wv = 0
  Wv = Vv
  Wv = Wv * S
  Wv = Wv >> 6
  return Wv

' squared distance of a screen point from the cell centre
function Dist2(u8 Px, u8 Py) as u16
  i16 Dx = 0, Dy = 0
  Dx = Px
  Dx = Dx - 128
  Dy = Py
  Dy = Dy - 96
  return Dx * Dx + Dy * Dy

function Near(u8 A, u8 B, u8 R) as u8
  if absdiff(A, B) < R then return 1
  return 0

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub PlayStep:
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearMsg
    return
  end if
  MovePlayer
  MoveShot
  MoveVirus
  MoveGerms
  CheckVirus
  inc RoundT
  if RoundT >= RoundN then
    NextRound
    return
  end if
  inc Sec
  if Sec >= 60 then
    Sec = 0
    inc Units
    ShowTime
  end if
  if Hp = 0 then Over = 1
  return
end sub

sub MovePlayer:
  K = J1 | J2
  V = K & 8
  if V > 0 then Pa = Pa + PlaySpd
  V = K & 4
  if V > 0 then Pa = Pa - PlaySpd
  Pa = Pa & 2047
  Ang = Pa >> 4
  Plx = OrbX[Ang]
  Ply = OrbY[Ang]
  if Press = 1 then
    if SOn = 0 then Shoot
  end if
  return
end sub

' the shot leaves the player towards the centre at 3 pixels a frame
sub Shoot:
  i8 Sv = 0
  SOn = 1
  SLife = ShotLife
  Sx = Plx
  Sx = Sx << 4
  Sy = Ply
  Sy = Sy << 4
  Sv = SinT[Ang]
  Svx = 0 - Scale(Sv, 48)
  Sv = CosT[Ang]
  Svy = 0 - Scale(Sv, 48)
  play sound SndZap
  return
end sub

sub MoveShot:
  if SOn = 0 then return
  Sx = Sx + Svx
  Sy = Sy + Svy
  dec SLife
  if SLife = 0 then SOn = 0
  return
end sub

sub MoveVirus:
  inc CrC
  if CrC >= CrN then
    CrC = 0
    Ca = Ca + 1
    Ca = Ca & 127
  end if
  Vrx = OrbX[Ca]
  Vry = OrbY[Ca]
  return
end sub

sub CheckVirus:
  if Near(Plx, Vrx, 11) = 0 then return
  if Near(Ply, Vry, 11) = 0 then return
  Hurt
  play sound SndSting
  Pa = 0
  Ang = 0
  Plx = OrbX[0]
  Ply = OrbY[0]
  Ca = 64
  CrC = 0
  return
end sub

sub Hurt:
  if Hp > 0 then dec Hp
  ' only the tile that changed: units Hp and Hp + 1 share tile 11 - Hp / 2
  V = Hp >> 1
  Ri = 11 - V
  K = Hp & 1
  if K = 1 then
    K = THp1
  else
    K = THp0
  end if
  put char K at 3,Ri + 5
  return
end sub

sub MoveGerms:
  for Gi = 0 to Rd - 1
    GermStep(Gi)
  next
  return
end sub

sub GermStep(u8 I):
  u16 Gx = 0, Gy = 0
  u8 Px = 0, Py = 0, Hit = 0, Tn = 0
  with G[I] as Gm
    Tn = Gm.Turn - 1
    Gm.Turn = Tn
    if Tn = 0 then NewDir(I)
    Gx = Gm.X + Gm.Vx
    Gy = Gm.Y + Gm.Vy
    Gm.X = Gx
    Gm.Y = Gy
  end with
  Px = Gx >> 4
  Py = Gy >> 4
  ' well inside (a 41 x 41 square) needs no distance
  if absdiff(Px, 128) >= 41 then Hit = 2
  if absdiff(Py, 96) >= 41 then Hit = 2
  if Hit = 2 then
    Hit = 0
    if Dist2(Px, Py) >= WallD2 then
      Hurt
      play sound SndInfect
      Hit = 1
    end if
  end if
  if Hit = 0 then
    if SOn = 1 then
      X = Sx >> 4
      Y = Sy >> 4
      if absdiff(Px, X) < 7 then
        if absdiff(Py, Y) < 7 then
          SOn = 0
          for Ki = 1 to Rd
            Score += Ten
          next
          ShowScore
          play sound SndPop
          Hit = 1
        end if
      end if
    end if
  end if
  if Hit = 0 then
    if absdiff(Px, Plx) < 10 then
      if absdiff(Py, Ply) < 10 then
        for Ki = 1 to Lv
          Score += Hund
        next
        ShowScore
        play sound SndGrab
        Hit = 1
      end if
    end if
  end if
  if Hit = 1 then Respawn(I)
  return
end sub

sub Respawn(u8 I):
  G[I].X = 2048
  G[I].Y = 1536
  NewDir(I)
  return
end sub

' a new heading: random; a quarter of the time one pointing inwards is
' turned round
sub NewDir(u8 I):
  u8 D = 0
  i8 Vx = 0, Vy = 0
  i16 Dot = 0, Dx = 0, Dy = 0
  Rand
  D = Rs & 127
  Vx = SinT[D]
  Vx = Scale(Vx, Spd)
  Vy = CosT[D]
  Vy = Scale(Vy, Spd)
  W16 = Rs & 768
  if W16 = 768 then
    Dx = G[I].X >> 4
    Dx = Dx - 128
    Dy = G[I].Y >> 4
    Dy = Dy - 96
    Dot = Dx * Vx + Dy * Vy
    if Dot < 0 then
      Vx = 0 - Vx
      Vy = 0 - Vy
    end if
  end if
  G[I].Vx = Vx
  G[I].Vy = Vy
  W16 = Rs >> 12
  G[I].Turn = W16 + 12
  return
end sub

sub SetSpeeds:
  V = Lv << 1
  Spd = V + 6
  if Spd > 20 then Spd = 20
  V = Lv << 2
  if V >= 24 then
    CrN = 6
  else
    CrN = 30 - V
  end if
  return
end sub

sub StartRound:
  for Gi = 0 to 4
    G[Gi].X = 2048
    G[Gi].Y = 1536
    NewDir(Gi)
  next
  RoundT = 0
  Sec = 0
  Units = 0
  SOn = 0
  ShowTime
  ShowHud
  ClearMsg
  print at 11,11, "          "
  print at 11,12, " ROUND "
  print at 18,12, digits$(Rd, 1)
  print at 19,12, "  "
  print at 11,13, "          "
  MsgT = MsgN
  return
end sub

sub NextRound:
  inc Rd
  if Rd > 5 then
    Rd = 1
    inc Lv
    Hp = 24
    SetSpeeds
    ShowHp
    play sound SndLevel
  else
    play sound SndRound
  end if
  StartRound
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  if SOn = 1 then
    X = Sx >> 4
    Y = Sy >> 4
    set sprite 1 to Y - 9, X - 8, SShot, 15
  else
    set sprite 1 to 192,0,0,0
  end if
  V = Ang + 8
  V = V >> 4
  V = V & 7
  V = V << 2
  set sprite 0 to Ply - 9, Plx - 8, V, 15
  V = Tick >> 4
  V = V & 1
  V = V << 2
  set sprite 2 to Vry - 9, Vrx - 8, SVir0 + V, 8
  for Gi = 0 to 4
    J = Gi + 3
    if Gi < Rd then
      W16 = G[Gi].X
      X = W16 >> 4
      W16 = G[Gi].Y
      Y = W16 >> 4
      K = Tick + Gi
      K = K >> 3
      K = K & 1
      K = K << 2
      set sprite J to Y - 9, X - 8, SBac0 + K, GermCol[Gi]
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowScore:
  print Score at 2,22
  return
end sub

sub ShowHud:
  print at 2,1, "LEVEL"
  print at 8,1, digits$(Lv, 2)
  print at 22,1, "ROUND "
  print at 28,1, digits$(Rd, 1)
  print at 2,21, "SCORE"
  print at 24,21, "BEST"
  print Best at 24,22
  print at 2,4, "LIFE"
  print at 26,4, "TIME"
  ShowScore
  ShowHp
  ShowTime
  return
end sub

' a bar of 12 tiles, two units each, filled from the bottom
sub ShowHp:
  for Ri = 0 to 11
    V = 11 - Ri
    V = V << 1
    select case Hp - V
    case 1
      K = THp1
    case 2 to 24
      K = THp2
    case else
      K = THp0
    end select
    put char K at 3,Ri + 5
  next
  return
end sub

sub ShowTime:
  for Ri = 0 to 11
    V = 11 - Ri
    V = V << 1
    if Units >= V + 2 then
      K = TTm2
    elseif Units = V + 1 then
      K = TTm1
    else
      K = TTm0
    end if
    put char K at 28,Ri + 5
  next
  return
end sub

' the rows of a banner back to the cell picture
sub ClearMsg:
  for Ri = 10 to 13
    W16 = Ri
    W16 = W16 << 5
    W16 = W16 + 4
    put CellMap + W16 count 24 at 4,Ri
  next
  return
end sub

sub DrawCell:
  copy CellMap count 768 to vram.name
  return
end sub

sub ResetPlay:
  Pa = 0
  Ang = 0
  Plx = OrbX[0]
  Ply = OrbY[0]
  Ca = 64
  CrC = 0
  Vrx = OrbX[64]
  Vry = OrbY[64]
  SOn = 0
  return
end sub

sub NewGame:
  Score = 0
  Lv = 1
  Rd = 1
  Hp = 24
  Over = 0
  SetSpeeds
  NewScreen
  DrawCell
  ResetPlay
  StartRound
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  InPlay = 1
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every screen: the three thirds get their own cell tiles
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy CellPat0 count NCell08 to vram.pattern + 1024
  copy CellCol0 count NCell08 to vram.color + 1024
  copy CellPat1 count NCell18 to vram.pattern + 3072
  copy CellCol1 count NCell18 to vram.color + 3072
  copy CellPat2 count NCell28 to vram.pattern + 5120
  copy CellCol2 count NCell28 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  DrawCell
  for Ri = 6 to 15
    fill 32 count 14 at 9,Ri
  next
  print at 12,7, "BACTERIA"
  print at 10,9, "GAZETTE 1989"
  print at 11,12, "START GAME"
  print at 11,13, "HOW TO PLAY"
  print at 11,14, "CREDITS"
  print at 2,21, "BEST"
  print Best at 2,22
  Menu = 0
  ShowMenu
  ResetPlay
  Rd = 3
  Spd = 8
  for Gi = 0 to 4
    G[Gi].X = 2048
    G[Gi].Y = 1536
    NewDir(Gi)
  next
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  MoveVirus
  TitleGerms
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' on the title, three bacteria wander and are born again at the wall
sub TitleGerms:
  u8 Px = 0, Py = 0
  for Gi = 0 to 2
    G[Gi].Turn = G[Gi].Turn - 1
    if G[Gi].Turn = 0 then NewDir(Gi)
    G[Gi].X = G[Gi].X + G[Gi].Vx
    G[Gi].Y = G[Gi].Y + G[Gi].Vy
    Px = G[Gi].X >> 4
    Py = G[Gi].Y >> 4
    if Dist2(Px, Py) >= WallD2 then Respawn(Gi)
  next
  return
end sub

' HOW TO PLAY: 3 pages; a button turns the page; after the last page,
' or 30 seconds untouched, back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "YOU ARE A WHITE BLOOD CELL"
    print at 2,4, "CIRCLING INSIDE A BIG CELL."
    print at 2,5, "BACTERIA ARE BORN IN THE"
    print at 2,6, "MIDDLE AND WANDER. IF ONE"
    print at 2,7, "REACHES THE WALL, THE CELL"
    print at 2,8, "IS INFECTED AND LOSES LIFE."
    print at 2,10, "STOP THEM: SHOOT THEM OR"
    print at 2,11, "BUMP INTO THEM!"
    set sprite 0 to 150,56,SPl0,15
    set sprite 1 to 132,92,SShot,15
    set sprite 3 to 116,136,SBac0,GermCol[0]
    set sprite 4 to 136,184,SBac1,GermCol[1]
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "JOYSTICK LEFT AND RIGHT"
    print at 2,4, "MOVE YOU AROUND THE CELL."
    print at 2,6, "A BUTTON FIRES A SHOT"
    print at 2,7, "ACROSS THE MIDDLE. ONLY ONE"
    print at 2,8, "SHOT AT A TIME."
    print at 2,10, "WATCH OUT FOR THE VIRUS! IT"
    print at 2,11, "CREEPS AROUND YOUR PATH."
    print at 2,12, "TOUCHING IT COSTS LIFE."
    set sprite 0 to 140,80,SPl2,15
    set sprite 2 to 140,160,SVir0,8
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "SHOT BACTERIUM: 10 X ROUND."
    print at 2,4, "BUMPED: 100 X LEVEL."
    print at 2,6, "WHEN THE TIME BAR IS FULL,"
    print at 2,7, "THE ROUND ENDS. EACH ROUND"
    print at 2,8, "HAS ONE MORE BACTERIUM."
    print at 2,9, "AFTER ROUND 5 COMES A NEW"
    print at 2,10, "LEVEL: FASTER, LIFE FULL."
    print at 2,11, "WHEN THE LIFE BAR IS EMPTY,"
    print at 2,12, "THE GAME IS OVER."
    print at 2,14, "TIP: BUMPING SCORES MORE!"
    fill THp2 count 4 at 3,18
    print at 8,18, "LIFE"
    fill TTm2 count 4 at 16,18
    print at 21,18, "TIME"
  end select
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub


sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,13
  put char 32 at 9,14
  J = Menu + 12
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 11,2, "BACTERIA"
  print at 2,5, "BASED ON BACTERIA,"
  print at 2,6, "COMPUTE!'S GAZETTE DISK,"
  print at 2,7, "MARCH 1989 (COMMODORE 128)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: PETRI DISH"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

