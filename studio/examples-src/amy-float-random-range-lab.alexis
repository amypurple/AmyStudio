' FP5 random range lab: random(min,max) for fp5 targets.
fp5 Low = 10
fp5 High = 20
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = random(2, 3)
u8 BA[5] = 0
u8 BB[5] = 0
u8 BC[5] = 0

  text screen
  print at 5,0, "FP5 RANDOM RANGE LAB"
  print at 1,2, "A=random(10,20)"
  print at 1,3, "B=random(Low,High)"
  print at 1,4, "C=random(-5,5)"
  print at 1,5, "D init random(2,3)"

  A = random(10, 20)
  B = random(Low, High)
  C = random(-5, 5)

  print A at 13,2 digits 16
  print B at 13,3 digits 16
  print C at 13,4 digits 16
  print D at 13,5 digits 16

  copy bytes of A to BA
  copy bytes of B to BB
  copy bytes of C to BC

  print at 1,7, "RAW A"
  print BA[4] at 11,7 digits 3
  print BA[3] at 15,7 digits 3
  print BA[2] at 19,7 digits 3
  print BA[1] at 23,7 digits 3
  print BA[0] at 27,7 digits 3

  print at 1,9, "RAW B"
  print BB[4] at 11,9 digits 3
  print BB[3] at 15,9 digits 3
  print BB[2] at 19,9 digits 3
  print BB[1] at 23,9 digits 3
  print BB[0] at 27,9 digits 3

  print at 1,11, "RAW C"
  print BC[4] at 11,11 digits 3
  print BC[3] at 15,11 digits 3
  print BC[2] at 19,11 digits 3
  print BC[1] at 23,11 digits 3
  print BC[0] at 27,11 digits 3

  print at 1,14, "EXPECT VALUES INSIDE RANGES"
  screen on