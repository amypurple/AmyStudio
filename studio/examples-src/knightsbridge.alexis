data TileCol bytes
  $0B,$0B,$0B,$0B,$0B,$0B,$0B,$0B
  $0B,$0B,$0B,$0B,$0B,$0B,$0B,$0B
  $0B,$0B,$0B,$0B,$0B,$0B,$0B,$0B
  $0B,$0B,$0B,$0B,$0B,$0B,$0B,$0B
  $0B,$FB,$FB,$BF,$BF,$BF,$BF,$BF
  $0B,$FB,$FB,$FB,$BF,$BF,$BF,$BF
  $0B,$FB,$FB,$FB,$FB,$BF,$BF,$0B
  $BF,$BF,$BF,$BF,$BF,$BF,$BF,$0B
  $0B,$1B,$1B,$B1,$B1,$B1,$B1,$B1
  $0B,$1B,$1B,$1B,$B1,$B1,$B1,$B1
  $B1,$B1,$B1,$B1,$B1,$B1,$B1,$0B
  $0B,$1B,$1B,$1B,$1B,$1B,$B1,$0B
  $0B,$0B,$0B,$0B,$0B,$0B,$8B,$8B
  $0B,$0B,$0B,$0B,$0B,$0B,$8B,$8B
