  Board[18] = BlackKnight
  Board[19] = BlackPawn
  Board[20] = BlackBishop
  Board[21] = BlackKnight
  Board[26] = WhiteBishop
  Board[42] = WhiteKnight
  Board[43] = WhitePawn
  Board[44] = WhiteQueen
  Board[45] = WhiteKnight
  Board[48] = WhitePawn
  Board[49] = WhitePawn
  Board[50] = WhitePawn
  Board[52] = WhitePawn
  Board[53] = WhitePawn
  Board[54] = WhitePawn
  Board[55] = WhitePawn
  Board[58] = WhiteKing
  Board[59] = WhiteRook
  Board[61] = WhiteBishop
  Board[63] = WhiteRook
