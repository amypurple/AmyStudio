  ChessFindPreferredMove
  ExpertPolicyDepth = MinimaxDepth
  ExpertHangTestFinished = 1
  return
#endif
#ifdef CHESS_LEVEL_MATCH_TEST
sub ChessLevelMatchTest:
  ChessInitialPosition
  ChessResetRepetitionHistory
  MatchFinished = 0
  MatchReason = 0
  MatchPly = 0
  while MatchPly < 80 and MatchFinished = 0
    if Side = 0 then ChessLevel = MatchWhiteLevel else ChessLevel = MatchBlackLevel
    ChessFindPreferredMove
    if SelectedMoveFrom = 255 then
      ChessFindKings
      if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
      AttackSide = 1 - Side
      ChessIsSquareAttacked
      if AttackResult = 1 then MatchReason = 1 else MatchReason = 2
      MatchFinished = 1
    else
      MatchFrom[MatchPly] = SelectedMoveFrom
      MatchTo[MatchPly] = SelectedMoveTo
      MatchPromotion[MatchPly] = SelectedMovePromotion
      MatchFlags[MatchPly] = SelectedMoveFlags
      MoveFrom = SelectedMoveFrom
      MoveTo = SelectedMoveTo
      MovePromotion = SelectedMovePromotion
      MoveFlags = SelectedMoveFlags
      MovingSide = Side
      ChessApplyMove
      ChessRecordPosition
      MatchPly += 1
      ChessClassifyInsufficientMaterial
      ChessClassifyRepetition
      if InsufficientMaterial = 1 then MatchReason = 3
      if AutomaticFivefold = 1 then MatchReason = 4
      if Halfmove >= 150 then MatchReason = 5
      if MatchReason <> 0 then MatchFinished = 1
    end if
  end while
  if MatchFinished = 0 then MatchReason = 6
  MatchFinished = 1
  return
#endif
#ifdef CHESS_GAME
  ChessGameStart
#endif
ChessKernelDone:
  goto ChessKernelDone
end sub

#ifdef CHESS_GAME
sub ChessGameStart:
  show picture ChessTitlePicture
  play voxpcm ChessVoiceMeow
  pause until press and release on joypad 1
  MoveVariation = frame & 3
  set sound table ChessMoveSoundTable areas 3
  screen off
  ChessMainMenu
  ChessConfigurationMenu
  ChessInitialPosition
  ChessResetRepetitionHistory
  ChessPrepareBoardGraphics
  ChessRenderBoard
  LastMoveValid = 0
  ChessRenderMoveNotation
  ChessDrawCursor
  GameReady = 0
  ChessEvaluateGameEnd
  if GameEndReason = 0 then GameReady = 1
  screen on
  ChessHumanInputLoop
  ChessGameOverScreen
  goto ChessGameStart

sub ChessMainMenu:
  MainMenuChoice = 2
  while MainMenuChoice == 2
    text screen
    backdrop black
    cls
    print centered at 1, "AMY CHESS"
    print centered at 3, "OPTIONS"
    print at 11,8, "PLAY GAME"
    print at 11,10, "TEST VOICES"
    screen on
    MainMenuChoice = 1
    choose menu 1 to 2 into MainMenuChoice cursor $3E at 9,8 step 2
    if MainMenuChoice = 2 then ChessVoiceTestMenu
  end while
  screen off
  return

sub ChessVoiceTestMenu:
  VoiceMenuChoice = 1
  while VoiceMenuChoice <> 6
    text screen
    backdrop black
    cls
    print centered at 1, "AMY CHESS"
    print centered at 3, "VOICES"
    print at 12,5, "DRAW"
    print at 12,7, "WHITE"
    print at 12,9, "BLACK"
    print at 12,11, "WINS"
    print at 12,13, "MEOW"
    print at 12,15, "BACK"
    screen on
    choose menu 1 to 6 into VoiceMenuChoice cursor $3E at 10,5 step 2
    if VoiceMenuChoice = 1 then
      play voxpcm ChessVoiceDraw
    end if
    if VoiceMenuChoice = 2 then
      play voxpcm ChessVoiceWhite
    end if
    if VoiceMenuChoice = 3 then
      play voxpcm ChessVoiceBlack
    end if
    if VoiceMenuChoice = 4 then
      play voxpcm ChessVoiceWins
    end if
    if VoiceMenuChoice = 5 then
      play voxpcm ChessVoiceMeow
    end if
    mute all
  end while
  screen off
  return

sub ChessConfigurationMenu:
  text screen
  backdrop black
  cls
  print centered at 1, "AMY CHESS"
  print centered at 3, "LEVEL SELECTION"
  print at 7,6, "WHITE"
  print at 7,8, "HUMAN"
  print at 7,9, "BLITZ"
  print at 7,10, "NORMAL"
  print at 19,6, "BLACK"
  print at 19,8, "HUMAN"
  print at 19,9, "BLITZ"
  print at 19,10, "NORMAL"
  screen on
  choose menu 1 to 3 into WhiteMenuChoice cursor $3E at 5,8 step 1
  choose menu 1 to 3 into BlackMenuChoice cursor $3E at 17,8 step 1
  WhiteControl = WhiteMenuChoice - 1
  BlackControl = BlackMenuChoice - 1
  screen off
  return

sub ChessPrepareBoardGraphics:
  tile screen
  sprites 16x16
  sprites simple
  decompress zx0 ChessBoardPatterns to vram.pattern
  decompress zx0 ChessBoardColors to vram.color
  decompress zx0 ChessBoardColors to vram.color + $0800
  decompress zx0 ChessBoardColors to vram.color + $1000
  duplicate mode 2 text patterns
  copy ChessCursorPattern count 32 to vram.spr_pat
  cls with 0
  clear sprites
  set sprite count 1
  return

sub ChessRenderBoard:
  for BoardDrawRow = 0 to 7
    for BoardDrawColumn = 0 to 7
      I = (BoardDrawRow << 3) + BoardDrawColumn
      ChessRenderSquare
    next
  next
  ChessRenderCoordinates
  ChessRenderGameHud
  return

sub ChessRenderGameHud:
  for I = 0 to 8
    put char ChessTextAmyChess[I] at 12 + I,0
    put char ChessTextLastMove[I] at 12 + I,21
  next
  ChessRenderTurn
  return

sub ChessRenderTurn:
  for I = 0 to 31
    put char 0 at I,1
  next
  if Side = 0 then
    for I = 0 to 9
      put char ChessTextWhiteTurn[I] at 11 + I,1
    next
  else
    for I = 0 to 9
      put char ChessTextBlackTurn[I] at 11 + I,1
    next
  end if
  return

sub ChessRenderCoordinates:
  for BoardDrawColumn = 0 to 7
    BoardDrawTile = 136 + BoardDrawColumn
    ScanColumn = 8 + (BoardDrawColumn << 1)
    put char BoardDrawTile at ScanColumn,3
    put char BoardDrawTile at ScanColumn,20
  next
  for BoardDrawRow = 0 to 7
    BoardDrawTile = 151 - BoardDrawRow
    ScanRow = 4 + (BoardDrawRow << 1)
    put char BoardDrawTile at 7,ScanRow
    put char BoardDrawTile at 24,ScanRow
  next
  return

sub ChessRenderSquare:
  BoardDrawRow = I >> 3
  BoardDrawColumn = I & 7
  BoardDrawPiece = Board[I]
  BoardDrawKind = ChessPieceKinds[BoardDrawPiece]
  if ((BoardDrawRow + BoardDrawColumn) & 1) = 1 then BoardDrawKind += 13
  BoardDrawTile = 32 + (BoardDrawKind << 2)
  ScanColumn = 8 + (BoardDrawColumn << 1)
  ScanRow = 4 + (BoardDrawRow << 1)
  put char BoardDrawTile at ScanColumn,ScanRow
  put char BoardDrawTile + 1 at ScanColumn,ScanRow + 1
  put char BoardDrawTile + 2 at ScanColumn + 1,ScanRow
  put char BoardDrawTile + 3 at ScanColumn + 1,ScanRow + 1
  return

sub ChessRenderChangedSquares:
  wait 1 frame
  I = GameMoveFrom
  ChessRenderSquare
  I = GameMoveTo
  ChessRenderSquare
  if GameMoveFlags & FlagEnPassant then
    if Side = 1 then I = GameMoveTo + 8 else I = GameMoveTo - 8
    ChessRenderSquare
  end if
  if GameMoveFlags & FlagCastleKing then
    if Side = 1 then
      I = 63
      ChessRenderSquare
      I = 61
      ChessRenderSquare
    else
      I = 7
      ChessRenderSquare
      I = 5
      ChessRenderSquare
    end if
  end if
  if GameMoveFlags & FlagCastleQueen then
    if Side = 1 then
      I = 56
      ChessRenderSquare
      I = 59
      ChessRenderSquare
    else
      I = 0
      ChessRenderSquare
      I = 3
      ChessRenderSquare
    end if
  end if
  LastMoveValid = 1
  ChessRenderMoveNotation
  ChessRenderTurn
  return

sub ChessRenderMoveNotation:
  for I = 0 to 31
    put char 0 at I,22
  next
  MoveNotationColumn = 18
  if LastMoveValid = 0 then return
  if GameMoveFlags & FlagCastleKing then
    put char 158 at 14,22
    put char 170 at 15,22
    put char 158 at 16,22
    MoveNotationColumn = 17
    return
  end if
  if GameMoveFlags & FlagCastleQueen then
    put char 158 at 12,22
    put char 170 at 13,22
    put char 158 at 14,22
    put char 170 at 15,22
    put char 158 at 16,22
    MoveNotationColumn = 17
    return
  end if
  put char 136 + (GameMoveFrom & 7) at 13,22
  put char 151 - (GameMoveFrom >> 3) at 14,22
  if GameMoveCapture = 0 then
    put char 170 at 15,22
  else
    put char 167 at 15,22
  end if
  put char 136 + (GameMoveTo & 7) at 16,22
  put char 151 - (GameMoveTo >> 3) at 17,22
  if GameMovePromotion = WhiteQueen or GameMovePromotion = BlackQueen then
    put char 160 at 18,22
  end if
  if GameMovePromotion = WhiteRook or GameMovePromotion = BlackRook then
    put char 161 at 18,22
  end if
  if GameMovePromotion = WhiteBishop or GameMovePromotion = BlackBishop then
    put char 137 at 18,22
  end if
  if GameMovePromotion = WhiteKnight or GameMovePromotion = BlackKnight then
    put char 157 at 18,22
  end if
  if GameMovePromotion <> 0 then MoveNotationColumn = 19
  return

sub ChessDrawCursor:
  BoardDrawRow = CursorSquare >> 3
  BoardDrawColumn = CursorSquare & 7
  ScanColumn = 64 + (BoardDrawColumn << 4)
  ScanRow = 31 + (BoardDrawRow << 4)
  CursorColor = 13
  set sprite 0 to ScanRow,ScanColumn,0,CursorColor
  update sprites
  return

sub ChessHumanInputLoop:
  while GameReady = 1
    wait 1 frame
    if Side = 0 and WhiteControl > 0 then
      ChessLevel = WhiteControl - 1
      ChessRunCpuTurn
    elseif Side = 1 and BlackControl > 0 then
      ChessLevel = BlackControl - 1
      ChessRunCpuTurn
    else
      if keypad(1) = 11 then ChessClaimDraw
      if joypad(1).up.pressed and CursorSquare >= 8 then CursorSquare -= 8
      if joypad(1).down.pressed and CursorSquare < 56 then CursorSquare += 8
      if joypad(1).left.pressed and (CursorSquare & 7) > 0 then CursorSquare -= 1
      if joypad(1).right.pressed and (CursorSquare & 7) < 7 then CursorSquare += 1
      if joypad(1).fire.pressed then ChessHandleHumanFire
    end if
    if GameReady = 1 then ChessDrawCursor
  end while
  clear sprites
  update sprites
  return

sub ChessRunCpuTurn:
  ChessClaimDrawIfUseful
  if GameReady = 0 then return
  ChessFindPreferredMove
  if SelectedMoveFrom = 255 then
    GameReady = 0
    return
  end if
  MoveFrom = SelectedMoveFrom
  MoveTo = SelectedMoveTo
  MovePromotion = SelectedMovePromotion
  MoveFlags = SelectedMoveFlags
  GameMoveFrom = MoveFrom
  GameMoveTo = MoveTo
  GameMoveFlags = MoveFlags
  GameMoveCapture = Board[MoveTo]
  if MoveFlags & FlagEnPassant then GameMoveCapture = BlackPawn
  GameMovePromotion = MovePromotion
  ChessCommitMove
  CursorSquare = GameMoveTo
  SelectedSquare = 255
  ChessRenderChangedSquares
  ChessEvaluateGameEnd
  ChessAnnounceCheck
  GameCpuMoves += 1
  return

sub ChessClaimDraw:
  if CanClaimThreefold = 1 then GameEndReason = 6
  if GameEndReason = 0 and CanClaimFiftyMove = 1 then GameEndReason = 7
  if GameEndReason <> 0 then GameReady = 0
  return

sub ChessClaimDrawIfUseful:
  ChessEvaluateMaterial
  if Side = 0 and MaterialBalance <= 0 then ChessClaimDraw
  if Side = 1 and MaterialBalance >= 0 then ChessClaimDraw
  return

sub ChessHandleHumanFire:
  if SelectedSquare = 255 then
    BoardDrawPiece = Board[CursorSquare]
    if Side = 0 and BoardDrawPiece >= WhitePawn and BoardDrawPiece <= WhiteKing then SelectedSquare = CursorSquare
    if Side = 1 and BoardDrawPiece >= BlackPawn and BoardDrawPiece <= BlackKing then SelectedSquare = CursorSquare
    return
  end if

  if CursorSquare = SelectedSquare then
    SelectedSquare = 255
    return
  end if

  RequestedMoveFrom = SelectedSquare
  RequestedMoveTo = CursorSquare
  RequestedMovePromotion = 0
  if Side = 0 and Board[SelectedSquare] = WhitePawn and CursorSquare < 8 then ChessChoosePromotion
  if Side = 1 and Board[SelectedSquare] = BlackPawn and CursorSquare >= 56 then ChessChoosePromotion
  ChessValidateRequestedMove
  if RequestedMoveLegal = 1 then
    MoveFrom = RequestedMoveFrom
    MoveTo = RequestedMoveTo
    MovePromotion = RequestedMovePromotion
    MoveFlags = RequestedMoveFlags
    GameMoveFrom = MoveFrom
    GameMoveTo = MoveTo
    GameMoveFlags = MoveFlags
    GameMoveCapture = Board[MoveTo]
    if MoveFlags & FlagEnPassant then GameMoveCapture = WhitePawn
    GameMovePromotion = MovePromotion
    ChessCommitMove
    CursorSquare = GameMoveTo
    SelectedSquare = 255
    ChessRenderChangedSquares
    ChessEvaluateGameEnd
    ChessAnnounceCheck
  end if
  return

sub ChessChoosePromotion:
  screen off
  clear sprites
  text screen
  backdrop black
  cls
  print centered at 5, "PROMOTE TO"
  print at 11,8, "QUEEN"
  print at 11,10, "ROOK"
  print at 11,12, "BISHOP"
  print at 11,14, "KNIGHT"
  screen on
  PromotionMenuChoice = 1
  choose menu 1 to 4 into PromotionMenuChoice cursor $3E at 9,8 step 2
  if Side = 0 then
    RequestedMovePromotion = WhiteQueen
    if PromotionMenuChoice = 2 then RequestedMovePromotion = WhiteRook
    if PromotionMenuChoice = 3 then RequestedMovePromotion = WhiteBishop
    if PromotionMenuChoice = 4 then RequestedMovePromotion = WhiteKnight
  else
    RequestedMovePromotion = BlackQueen
    if PromotionMenuChoice = 2 then RequestedMovePromotion = BlackRook
    if PromotionMenuChoice = 3 then RequestedMovePromotion = BlackBishop
    if PromotionMenuChoice = 4 then RequestedMovePromotion = BlackKnight
  end if
  screen off
  ChessPrepareBoardGraphics
  ChessRenderBoard
  ChessDrawCursor
  screen on
  return

sub ChessEvaluateGameEnd:
  GameEndReason = 0
  GameWinner = 255
  ChessClassifyInsufficientMaterial
  ChessClassifyRepetition
  ChessClassifyMoveCountDraw
  if InsufficientMaterial = 1 then GameEndReason = 3
  if AutomaticFivefold = 1 then GameEndReason = 4
  if AutomaticSeventyFiveMove = 1 then GameEndReason = 5
  if GameEndReason = 0 then
    StopAfterFirstLegal = 1
    FindMateMode = 0
    ChessCountLegalMoves
    StopAfterFirstLegal = 0
    if LegalMoveCount = 0 then
      ChessFindKings
      if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
      AttackSide = 1 - Side
      ChessIsSquareAttacked
      if AttackResult = 1 then
        GameEndReason = 1
        GameWinner = 1 - Side
      else
        GameEndReason = 2
      end if
    end if
  end if
  if GameEndReason <> 0 then GameReady = 0
  return

sub ChessAnnounceCheck:
  if GameEndReason = 1 then
    put char 171 at MoveNotationColumn,22
    return
  end if
  if GameEndReason <> 0 then return
  ChessFindKings
  if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
  AttackSide = 1 - Side
  ChessIsSquareAttacked
  if AttackResult = 1 then
    put char 171 at MoveNotationColumn,22
    play sound 3
    return
  end if
  if GameMoveCapture <> 0 then
    play sound 2
  else
    play sound 1
  end if
  return

sub ChessGameOverScreen:
  clear sprites
  update sprites
  for I = 0 to 31
    put char 0 at I,0
    put char 0 at I,1
    put char 0 at I,2
  next
  if GameEndReason = 1 then
    for I = 0 to 8
      put char ChessTextCheckmate[I] at 11 + I,0
    next
    if GameWinner = 0 then
      for I = 0 to 9
        put char ChessTextWhiteWins[I] at 11 + I,1
      next
    end if
    if GameWinner = 1 then
      for I = 0 to 9
        put char ChessTextBlackWins[I] at 11 + I,1
      next
    end if
  elseif GameEndReason = 2 then
    for I = 0 to 8
      put char ChessTextStalemate[I] at 11 + I,0
    next
  else
    for I = 0 to 3
      put char ChessTextDraw[I] at 14 + I,0
    next
  end if
  for I = 0 to 31
    put char 0 at I,23
  next
  for I = 0 to 9
    put char ChessTextPressFire[I] at 11 + I,23
  next
  if GameEndReason = 1 then
    if GameWinner = 0 then
      play voxpcm ChessVoiceWhite
    else
      play voxpcm ChessVoiceBlack
    end if
    play voxpcm ChessVoiceWins
  else
    play voxpcm ChessVoiceDraw
  end if
  pause until press and release on joypad 1
  mute all
  return

asm {
ChessMoveSoundTable:
    dw ChessRegularMove,$702B
    dw ChessMoveCapture,$7035
    dw ChessMoveCheck,$703F

ChessRegularMove:
    db $43,$25,$72,$04,$11,$C8,$11,$DE
    db $50

ChessMoveCapture:
    db $80,$DB,$31,$01
    db $80,$7B,$22,$01
    db $80,$F0,$31,$01
    db $80,$2C,$52,$01
    db $80,$4C,$72,$01
    db $80,$98,$92,$01
    db $90

ChessMoveCheck:
    db $C0,$CC,$60,$01
    db $C0,$DC,$20,$01
    db $C1,$3F,$41,$06,$11,$48
    db $ED
    db $C0,$BB,$B0,$01
    db $C0,$B8,$A0,$01
    db $C1,$3D,$A1,$03,$11,$48
    db $C0,$B1,$B3,$01
    db $D0
}

include "@project/assets/amy-chess-voices.asm"
#endif

sub ChessDetectExpandedRam:
  MirrorSaveLow = peek($7200)
  MirrorSaveHigh = peek($7600)
  poke($7200, $5A)
  poke($7600, $A5)
  ExpandedRam = 0
  if peek($7200) = $5A and peek($7600) = $A5 then ExpandedRam = 1
  poke($7200, MirrorSaveLow)
  poke($7600, MirrorSaveHigh)
  return

#ifdef CHESS_STALL_TEST
sub ChessReportedStallTest:
  ChessClearBoard
  Board[0] = BlackRook
  Board[2] = BlackBishop
  Board[3] = BlackQueen
  Board[4] = BlackKing
  Board[5] = BlackBishop
  Board[7] = BlackRook
  for I = 8 to 15
    Board[I] = BlackPawn
  next
  Board[41] = WhitePawn
  Board[48] = WhitePawn
  for I = 50 to 55
    Board[I] = WhitePawn
  next
  Board[56] = WhiteRook
  Board[58] = WhiteBishop
  Board[59] = WhiteQueen
  Board[60] = WhiteKing
  Board[61] = WhiteBishop
  Board[63] = WhiteRook
  Side = 1
  Castling = 15
  EnPassant = 255
  Halfmove = 0
  Fullmove = 6
  ChessLevel = 1
  test checkpoint "reported_stall_start"
  ChessFindPreferredMove
  StallTestFrom = SelectedMoveFrom
  StallTestTo = SelectedMoveTo
  StallTestFinished = 1
  return

#endif

#ifdef CHESS_KQK_PLAY_TEST
sub ChessKqkPlayTest:
  ChessClearBoard
  Board[0] = BlackKing
  Board[18] = WhiteKing
  Board[59] = WhiteQueen
  Side = 0
  Castling = 0
  EnPassant = 255
  Halfmove = 0
  Fullmove = 1
  ChessLevel = 1
  KqkPlayTestResult = 0
  KqkPlayTestPlies = 0
  ChessResetRepetitionHistory
  ChessClassifyRepetition
  while KqkPlayTestPlies < 100 and KqkPlayTestResult = 0
    ChessFindPreferredMove
    ChessAvoidKqkTestRepetition
    if SelectedMoveFrom = 255 then
      ChessFindKings
      if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
      AttackSide = 1 - Side
      ChessIsSquareAttacked
      if AttackResult = 1 then KqkPlayTestResult = 1 else KqkPlayTestResult = 2
    else
      KqkPlayFrom[KqkPlayTestPlies] = SelectedMoveFrom
      KqkPlayTo[KqkPlayTestPlies] = SelectedMoveTo
      MoveFrom = SelectedMoveFrom
      MoveTo = SelectedMoveTo
      MoveFlags = SelectedMoveFlags
      MovePromotion = SelectedMovePromotion
      ChessApplyMove
      ChessRecordPosition
      ChessClassifyRepetition
      KqkPlayTestPlies += 1
    end if
  end while
  if KqkPlayTestResult = 0 then KqkPlayTestResult = 3
  KqkPlayTestFinished = 1
  return

sub ChessAvoidKqkTestRepetition:
  if SelectedMoveFrom = 255 or RepetitionCount < 2 then return
  MoveFrom = SelectedMoveFrom
  MoveTo = SelectedMoveTo
  MoveFlags = SelectedMoveFlags
  MovePromotion = SelectedMovePromotion
  ChessClassifyAnnouncedMove
  if AnnouncedThreefold = 0 then return
  SavedMoveFrom = SelectedMoveFrom
  SavedMoveTo = SelectedMoveTo
  SavedMoveFlags = SelectedMoveFlags
  SavedMovePromotion = SelectedMovePromotion
  MinimaxExcludeEnabled = 1
  MinimaxExcludeFrom = SelectedMoveFrom
  MinimaxExcludeTo = SelectedMoveTo
  MinimaxExcludeFlags = SelectedMoveFlags
  MinimaxExcludePromotion = SelectedMovePromotion
  ChessFindPreferredMove
  MinimaxExcludeEnabled = 0
  if SelectedMoveFrom = 255 then
    SelectedMoveFrom = SavedMoveFrom
    SelectedMoveTo = SavedMoveTo
    SelectedMoveFlags = SavedMoveFlags
    SelectedMovePromotion = SavedMovePromotion
  end if
  return
#endif

#ifdef CHESS_PAWN_BLUNDER_TEST
sub ChessPawnBlunderTest:
  ChessClearBoard
  Board[3] = BlackRook
  Board[7] = BlackKing
  Board[27] = BlackBishop
  Board[34] = WhitePawn
  Board[63] = WhiteKing
  Side = 0
  MovingSide = 1
  MoveTo = 27
  ChessFindKings
  ChessEvaluatePosition
  PawnBlunderScoreBefore = PositionScore
  ChessPenalizeLooseMovedPiece
  PawnBlunderScoreAfter = PositionScore
  PawnBlunderAttack = MovedPieceAttacked
  PawnBlunderTestFinished = 1
  return
#endif

sub ChessClearBoard:
  for I = 0 to 63
    Board[I] = Empty
  next
  WhiteKingSquare = 255
  BlackKingSquare = 255
  return

sub ChessClassifyInsufficientMaterial:
  InsufficientMaterial = 1
  MaterialMinorCount = 0
  BishopOnlyMaterial = 1
  BishopSquareColor = 255
  BishopColorMismatch = 0
  for I = 0 to 63
    if Board[I] = WhitePawn or Board[I] = BlackPawn then InsufficientMaterial = 0
    if Board[I] = WhiteRook or Board[I] = BlackRook then InsufficientMaterial = 0
    if Board[I] = WhiteQueen or Board[I] = BlackQueen then InsufficientMaterial = 0
    if Board[I] = WhiteKnight or Board[I] = BlackKnight then
      MaterialMinorCount += 1
      BishopOnlyMaterial = 0
    end if
    if Board[I] = WhiteBishop or Board[I] = BlackBishop then
      MaterialMinorCount += 1
      if BishopSquareColor = 255 then BishopSquareColor = ((I >> 3) + (I & 7)) & 1
      if BishopSquareColor <> (((I >> 3) + (I & 7)) & 1) then BishopColorMismatch = 1
    end if
  next
  if MaterialMinorCount > 1 and (BishopOnlyMaterial = 0 or BishopColorMismatch = 1) then InsufficientMaterial = 0
  return

sub ChessClassifyMoveCountDraw:
  CanClaimFiftyMove = 0
  AutomaticSeventyFiveMove = 0
  if Halfmove >= 100 then CanClaimFiftyMove = 1
  if Halfmove >= 150 then AutomaticSeventyFiveMove = 1
  return

sub ChessFindEffectiveEnPassant:
  EffectiveEnPassant = 255
  if EnPassant = 255 then return
  ChessFindKings
  MoveTo = EnPassant
  MovePromotion = 0
  MoveFlags = FlagEnPassant
  if Side = 0 then
    if (EnPassant & 7) > 0 and Board[EnPassant + 7] = WhitePawn then
      MoveFrom = EnPassant + 7
      KingSquare = WhiteKingSquare
      ChessApplyMove
      AttackSquare = KingSquare
      AttackSide = Side
      ChessIsSquareAttacked
      ChessUndoMove
      if AttackResult = 0 then EffectiveEnPassant = EnPassant
    end if
    if EffectiveEnPassant = 255 and (EnPassant & 7) < 7 and Board[EnPassant + 9] = WhitePawn then
      MoveFrom = EnPassant + 9
      KingSquare = WhiteKingSquare
      ChessApplyMove
      AttackSquare = KingSquare
      AttackSide = Side
      ChessIsSquareAttacked
      ChessUndoMove
      if AttackResult = 0 then EffectiveEnPassant = EnPassant
    end if
  else
    if (EnPassant & 7) > 0 and Board[EnPassant - 9] = BlackPawn then
      MoveFrom = EnPassant - 9
      KingSquare = BlackKingSquare
      ChessApplyMove
      AttackSquare = KingSquare
      AttackSide = Side
      ChessIsSquareAttacked
      ChessUndoMove
      if AttackResult = 0 then EffectiveEnPassant = EnPassant
    end if
    if EffectiveEnPassant = 255 and (EnPassant & 7) < 7 and Board[EnPassant - 7] = BlackPawn then
      MoveFrom = EnPassant - 7
      KingSquare = BlackKingSquare
      ChessApplyMove
      AttackSquare = KingSquare
      AttackSide = Side
      ChessIsSquareAttacked
      ChessUndoMove
      if AttackResult = 0 then EffectiveEnPassant = EnPassant
    end if
  end if
  MoveFlags = 0
  return

sub ChessComputePositionSignature:
  ChessFindEffectiveEnPassant
  PositionHashA = 5381
  PositionHashB = 257
  for I = 0 to 63
    PositionHashA = PositionHashA * 33 + Board[I] + 1
    PositionHashB = PositionHashB * 257 + Board[I] + I + 1
  next
  PositionHashA = PositionHashA * 33 + Side + Castling * 2 + EffectiveEnPassant
  PositionHashB = PositionHashB * 257 + Side * 17 + Castling * 31 + EffectiveEnPassant
  return

sub ChessResetRepetitionHistory:
  RepetitionLength = 0
  ChessComputePositionSignature
  HistoryIndex = 0
  ChessWriteHistoryEntry
  RepetitionLength = 1
  return

sub ChessWriteHistoryEntry:
  if ExpandedRam = 1 then
    HistoryAddress = ChessHistoryRam + HistoryIndex * 4
    HistoryByte = PositionHashA & 255
    poke(HistoryAddress, HistoryByte)
    HistoryByte = PositionHashA >> 8
    poke(HistoryAddress + 1, HistoryByte)
    HistoryByte = PositionHashB & 255
    poke(HistoryAddress + 2, HistoryByte)
    HistoryByte = PositionHashB >> 8
    poke(HistoryAddress + 3, HistoryByte)
  else
    HistoryAddress = ChessHistoryNameOffset + HistoryIndex * 4
    HistoryByte = PositionHashA & 255
    vpoke vram.name + HistoryAddress, HistoryByte
    HistoryByte = PositionHashA >> 8
    vpoke vram.name + HistoryAddress + 1, HistoryByte
    HistoryByte = PositionHashB & 255
    vpoke vram.name + HistoryAddress + 2, HistoryByte
    HistoryByte = PositionHashB >> 8
    vpoke vram.name + HistoryAddress + 3, HistoryByte
  end if
  return

sub ChessReadHistoryEntry:
  if ExpandedRam = 1 then
    HistoryAddress = ChessHistoryRam + HistoryIndex * 4
    HistoryReadA = peek(HistoryAddress)
    HistoryByte = peek(HistoryAddress + 1)
    HistoryReadA += HistoryByte << 8
    HistoryReadB = peek(HistoryAddress + 2)
    HistoryByte = peek(HistoryAddress + 3)
    HistoryReadB += HistoryByte << 8
  else
    HistoryAddress = ChessHistoryNameOffset + HistoryIndex * 4
    vpeek vram.name + HistoryAddress into HistoryByte
    HistoryReadA = HistoryByte
    vpeek vram.name + HistoryAddress + 1 into HistoryByte
    HistoryReadA += HistoryByte << 8
    vpeek vram.name + HistoryAddress + 2 into HistoryByte
    HistoryReadB = HistoryByte
    vpeek vram.name + HistoryAddress + 3 into HistoryByte
    HistoryReadB += HistoryByte << 8
  end if
  return

sub ChessRecordPosition:
  if Halfmove = 0 then
    ChessResetRepetitionHistory
    return
  end if
  ChessComputePositionSignature
  if RepetitionLength < 150 then
    HistoryIndex = RepetitionLength
    ChessWriteHistoryEntry
    RepetitionLength += 1
  end if
  return

sub ChessCommitMove:
  ChessApplyMove
  ChessRecordPosition
  return

sub ChessClassifyRepetition:
  ChessComputePositionSignature
  RepetitionCount = 0
  for HistoryIndex = 0 to RepetitionLength - 1
    ChessReadHistoryEntry
    if HistoryReadA = PositionHashA and HistoryReadB = PositionHashB then RepetitionCount += 1
  next
  CanClaimThreefold = 0
  AutomaticFivefold = 0
  if RepetitionCount >= 3 then CanClaimThreefold = 1
  if RepetitionCount >= 5 then AutomaticFivefold = 1
  return

sub ChessClassifyAnnouncedMove:
  AnnouncedThreefold = 0
  AnnouncedFiftyMove = 0
  AnnouncedRepetitionCount = 0
  ChessApplyMove
  SavedMoveFrom = MoveFrom
  SavedMoveTo = MoveTo
  SavedMovePromotion = MovePromotion
  SavedMoveFlags = MoveFlags
  SavedUndoPiece = UndoPiece
  SavedUndoCaptured = UndoCaptured
  SavedUndoCapturedSquare = UndoCapturedSquare
  SavedUndoCastling = UndoCastling
  SavedUndoEnPassant = UndoEnPassant
  SavedUndoHalfmove = UndoHalfmove
  SavedUndoFullmove = UndoFullmove
  ChessComputePositionSignature
  for HistoryIndex = 0 to RepetitionLength - 1
    ChessReadHistoryEntry
    if HistoryReadA = PositionHashA and HistoryReadB = PositionHashB then AnnouncedRepetitionCount += 1
  next
  AnnouncedRepetitionCount += 1
  if AnnouncedRepetitionCount >= 3 then AnnouncedThreefold = 1
  if Halfmove >= 100 then AnnouncedFiftyMove = 1
  MoveFrom = SavedMoveFrom
  MoveTo = SavedMoveTo
  MovePromotion = SavedMovePromotion
  MoveFlags = SavedMoveFlags
  UndoPiece = SavedUndoPiece
  UndoCaptured = SavedUndoCaptured
  UndoCapturedSquare = SavedUndoCapturedSquare
  UndoCastling = SavedUndoCastling
  UndoEnPassant = SavedUndoEnPassant
  UndoHalfmove = SavedUndoHalfmove
  UndoFullmove = SavedUndoFullmove
  ChessUndoMove
  return

sub ChessInitialPosition:
  copy InitialBoard to Board count 64
  Side = 0
  Castling = 15
  EnPassant = 255
  Halfmove = 0
  Fullmove = 1
  WhiteKingSquare = 60
  BlackKingSquare = 4
  return

sub ChessFindKings:
  WhiteKingSquare = 255
  BlackKingSquare = 255
  for I = 0 to 63
    if Board[I] = WhiteKing then WhiteKingSquare = I
    if Board[I] = BlackKing then BlackKingSquare = I
  next
  return

sub ChessIsSquareAttacked:
  AttackResult = 0
  AttackRow = AttackSquare >> 3
  AttackColumn = AttackSquare & 7

  ' Pawn attacks are deliberately different from pawn pushes.
  if AttackSide = 0 and AttackRow < 7 then
    if AttackColumn > 0 and Board[AttackSquare + 7] = WhitePawn then AttackResult = 1
    if AttackColumn < 7 and Board[AttackSquare + 9] = WhitePawn then AttackResult = 1
  elseif AttackSide = 1 and AttackRow > 0 then
    if AttackColumn > 0 and Board[AttackSquare - 9] = BlackPawn then AttackResult = 1
    if AttackColumn < 7 and Board[AttackSquare - 7] = BlackPawn then AttackResult = 1
  end if

  if AttackRow > 1 and AttackColumn > 0 then
    ScanPiece = Board[AttackSquare - 17]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow > 1 and AttackColumn < 7 then
    ScanPiece = Board[AttackSquare - 15]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow > 0 and AttackColumn > 1 then
    ScanPiece = Board[AttackSquare - 10]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow > 0 and AttackColumn < 6 then
    ScanPiece = Board[AttackSquare - 6]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow < 7 and AttackColumn > 1 then
    ScanPiece = Board[AttackSquare + 6]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow < 7 and AttackColumn < 6 then
    ScanPiece = Board[AttackSquare + 10]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow < 6 and AttackColumn > 0 then
    ScanPiece = Board[AttackSquare + 15]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if
  if AttackRow < 6 and AttackColumn < 7 then
    ScanPiece = Board[AttackSquare + 17]
    if AttackSide = 0 and ScanPiece = WhiteKnight then AttackResult = 1
    if AttackSide = 1 and ScanPiece = BlackKnight then AttackResult = 1
  end if

  ' Adjacent enemy king, using the position cache maintained by move generation.
  if AttackSide = 0 then ScanSquare = WhiteKingSquare else ScanSquare = BlackKingSquare
  if ScanSquare <> 255 then
    ScanRow = ScanSquare >> 3
    ScanColumn = ScanSquare & 7
    if ScanRow + 1 >= AttackRow and ScanRow <= AttackRow + 1 and ScanColumn + 1 >= AttackColumn and ScanColumn <= AttackColumn + 1 and ScanSquare <> AttackSquare then AttackResult = 1
  end if

  ' Orthogonal rays: first occupied square decides the attack.
  ScanRow = AttackRow
  while ScanRow > 0
    ScanRow -= 1
    ScanSquare = ScanRow * 8 + AttackColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteRook or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackRook or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanRow = AttackRow
  while ScanRow < 7
    ScanRow += 1
    ScanSquare = ScanRow * 8 + AttackColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteRook or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackRook or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanColumn = AttackColumn
  while ScanColumn > 0
    ScanColumn -= 1
    ScanSquare = AttackRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteRook or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackRook or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanColumn = AttackColumn
  while ScanColumn < 7
    ScanColumn += 1
    ScanSquare = AttackRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteRook or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackRook or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while

  ' Diagonal rays.
  ScanRow = AttackRow
  ScanColumn = AttackColumn
  while ScanRow > 0 and ScanColumn > 0
    ScanRow -= 1
    ScanColumn -= 1
    ScanSquare = ScanRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteBishop or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackBishop or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanRow = AttackRow
  ScanColumn = AttackColumn
  while ScanRow > 0 and ScanColumn < 7
    ScanRow -= 1
    ScanColumn += 1
    ScanSquare = ScanRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteBishop or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackBishop or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanRow = AttackRow
  ScanColumn = AttackColumn
  while ScanRow < 7 and ScanColumn > 0
    ScanRow += 1
    ScanColumn -= 1
    ScanSquare = ScanRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteBishop or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackBishop or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  ScanRow = AttackRow
  ScanColumn = AttackColumn
  while ScanRow < 7 and ScanColumn < 7
    ScanRow += 1
    ScanColumn += 1
    ScanSquare = ScanRow * 8 + ScanColumn
    ScanPiece = Board[ScanSquare]
    if ScanPiece <> Empty then
      if AttackSide = 0 and (ScanPiece = WhiteBishop or ScanPiece = WhiteQueen) then AttackResult = 1
      if AttackSide = 1 and (ScanPiece = BlackBishop or ScanPiece = BlackQueen) then AttackResult = 1
      exit while
    end if
  end while
  return

sub ChessTryLegalMove:
  MovingSide = Side
  if MovingSide = 0 then KingSquare = WhiteKingSquare else KingSquare = BlackKingSquare
  if Board[MoveFrom] = WhiteKing or Board[MoveFrom] = BlackKing then KingSquare = MoveTo
  ChessApplyMove
  AttackResult = 1
  if KingSquare <> 255 then
    AttackSquare = KingSquare
    AttackSide = Side
    ChessIsSquareAttacked
  end if
  if AttackResult = 0 and FindMateMode = 1 then ChessEvaluateAppliedMoveForMate
  if AttackResult = 0 and FindMateMode = 3 then ChessEvaluateAppliedMoveForPromotionApproach
  if AttackResult = 0 and FindMateMode = 4 then ChessEvaluateAppliedMoveForKeySquare
  if AttackResult = 0 and FindMateMode = 5 then ChessEvaluateAppliedCapture
  if AttackResult = 0 and FindMateMode = 6 then ChessSelectAppliedMove
  if AttackResult = 0 and FindMateMode = 7 then ChessEvaluateAppliedMovePosition
  if AttackResult = 0 and FindMateMode = 8 then ChessEvaluateAppliedMoveSafety
  if AttackResult = 0 and FindMateMode = 9 then ChessEvaluateMinimaxReply
  if AttackResult = 0 and FindMateMode = 10 then
    if MoveFrom <> MinimaxSeedFrom or MoveTo <> MinimaxSeedTo or MoveFlags <> MinimaxSeedFlags or MovePromotion <> MinimaxSeedPromotion then
      if MinimaxExcludeEnabled = 0 or MoveFrom <> MinimaxExcludeFrom or MoveTo <> MinimaxExcludeTo or MoveFlags <> MinimaxExcludeFlags or MovePromotion <> MinimaxExcludePromotion then ChessEvaluateMinimaxRoot
    end if
  end if
  if AttackResult = 0 and FindMateMode = 11 then ChessMatchRequestedMove
  if AttackResult = 0 and FindMateMode = 12 then ChessEvaluateRecapture
  if AttackResult = 0 and FindMateMode = 13 then ChessEvaluateMinimaxContinuation
  ChessUndoMove
  if AttackResult = 0 then
    LegalMoveCount += 1
    if StopAfterFirstLegal = 1 then StopAfterFirstLegal = 2
  end if
  return

sub ChessGeneratePawnMoves:
  GenerateRow = GenerateFrom >> 3
  GenerateColumn = GenerateFrom & 7
  MoveFrom = GenerateFrom
  MovePromotion = 0
  MoveFlags = 0
  if Side = 0 then
    if GenerateRow > 0 then
      MoveTo = GenerateFrom - 8
    end if
    if GenerateRow > 0 and Board[MoveTo] = Empty then
      if GenerateRow = 1 then ChessTryWhitePromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      if GenerateRow = 6 and Board[GenerateFrom - 16] = Empty then
        MoveTo = GenerateFrom - 16
        MoveFlags = FlagDoublePawn
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
    if GenerateColumn > 0 then
      MoveTo = GenerateFrom - 9
      if Board[MoveTo] >= BlackPawn then
        if GenerateRow = 1 then ChessTryWhitePromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      end if
      if MoveTo = EnPassant then
        MoveFlags = FlagEnPassant
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
    if GenerateColumn < 7 then
      MoveTo = GenerateFrom - 7
      if Board[MoveTo] >= BlackPawn then
        if GenerateRow = 1 then ChessTryWhitePromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      end if
      if MoveTo = EnPassant then
        MoveFlags = FlagEnPassant
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
  else
    if GenerateRow < 7 then
      MoveTo = GenerateFrom + 8
    end if
    if GenerateRow < 7 and Board[MoveTo] = Empty then
      if GenerateRow = 6 then ChessTryBlackPromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      if GenerateRow = 1 and Board[GenerateFrom + 16] = Empty then
        MoveTo = GenerateFrom + 16
        MoveFlags = FlagDoublePawn
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
    if GenerateColumn > 0 then
      MoveTo = GenerateFrom + 7
      if Board[MoveTo] > Empty and Board[MoveTo] < BlackPawn then
        if GenerateRow = 6 then ChessTryBlackPromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      end if
      if MoveTo = EnPassant then
        MoveFlags = FlagEnPassant
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
    if GenerateColumn < 7 then
      MoveTo = GenerateFrom + 9
      if Board[MoveTo] > Empty and Board[MoveTo] < BlackPawn then
        if GenerateRow = 6 then ChessTryBlackPromotions else ChessTryLegalMove
  if StopAfterFirstLegal = 2 then return
      end if
      if MoveTo = EnPassant then
        MoveFlags = FlagEnPassant
        ChessTryLegalMove
        MoveFlags = 0
  if StopAfterFirstLegal = 2 then return
      end if
    end if
  end if
  return

sub ChessTryWhitePromotions:
  MovePromotion = WhiteQueen
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = WhiteRook
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = WhiteBishop
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = WhiteKnight
  ChessTryLegalMove
  MovePromotion = 0
  return

sub ChessTryBlackPromotions:
  MovePromotion = BlackQueen
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = BlackRook
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = BlackBishop
  ChessTryLegalMove
  if StopAfterFirstLegal = 2 then
    MovePromotion = 0
    return
  end if
  MovePromotion = BlackKnight
  ChessTryLegalMove
  MovePromotion = 0
  return

sub ChessTryKnightTarget:
  ScanPiece = Board[MoveTo]
  if Side = 0 and (ScanPiece = Empty or ScanPiece >= BlackPawn) then ChessTryLegalMove
  if Side = 1 and ScanPiece < BlackPawn then ChessTryLegalMove
  return

sub ChessGenerateKnightMoves:
  GenerateRow = GenerateFrom >> 3
  GenerateColumn = GenerateFrom & 7
  MoveFrom = GenerateFrom
  MovePromotion = 0
  MoveFlags = 0
  if GenerateRow > 1 and GenerateColumn > 0 then
    MoveTo = GenerateFrom - 17
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow > 1 and GenerateColumn < 7 then
    MoveTo = GenerateFrom - 15
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow > 0 and GenerateColumn > 1 then
    MoveTo = GenerateFrom - 10
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow > 0 and GenerateColumn < 6 then
    MoveTo = GenerateFrom - 6
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow < 7 and GenerateColumn > 1 then
    MoveTo = GenerateFrom + 6
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow < 7 and GenerateColumn < 6 then
    MoveTo = GenerateFrom + 10
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow < 6 and GenerateColumn > 0 then
    MoveTo = GenerateFrom + 15
    ChessTryKnightTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateRow < 6 and GenerateColumn < 7 then
    MoveTo = GenerateFrom + 17
    ChessTryKnightTarget
  end if
  return

sub ChessCountPawnKnightLegalMoves:
  LegalMoveCount = 0
  ChessFindKings
  for GenerateFrom = 0 to 63
    ScanPiece = Board[GenerateFrom]
    if Side = 0 and ScanPiece = WhitePawn then ChessGeneratePawnMoves
    if Side = 1 and ScanPiece = BlackPawn then ChessGeneratePawnMoves
    if Side = 0 and ScanPiece = WhiteKnight then ChessGenerateKnightMoves
    if Side = 1 and ScanPiece = BlackKnight then ChessGenerateKnightMoves
  next
  return

sub ChessTrySlidingTarget:
  RayDone = 0
  ScanPiece = Board[MoveTo]
  if ScanPiece = Empty then
    ChessTrySlidingLegalMove(ScanRow, ScanColumn)
  else
    RayDone = 1
    if Side = 0 and ScanPiece >= BlackPawn and ScanPiece <> BlackKing then
      ChessTrySlidingLegalMove(ScanRow, ScanColumn)
    end if
    if Side = 1 and ScanPiece > Empty and ScanPiece < BlackPawn and ScanPiece <> WhiteKing then
      ChessTrySlidingLegalMove(ScanRow, ScanColumn)
    end if
  end if
  if StopAfterFirstLegal = 2 then RayDone = 1
  return

sub ChessTrySlidingLegalMove(u8 SavedRow, u8 SavedColumn):
  ChessTryLegalMove
  ScanRow = SavedRow
  ScanColumn = SavedColumn
  return

sub ChessGenerateOrthogonalMoves:
  MoveFrom = GenerateFrom
  MovePromotion = 0
  MoveFlags = 0
  GenerateRow = GenerateFrom >> 3
  GenerateColumn = GenerateFrom & 7

  ScanRow = GenerateRow
  RayDone = 0
  while ScanRow > 0 and RayDone = 0
    ScanRow -= 1
    MoveTo = ScanRow * 8 + GenerateColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanRow = GenerateRow
  RayDone = 0
  while ScanRow < 7 and RayDone = 0
    ScanRow += 1
    MoveTo = ScanRow * 8 + GenerateColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanColumn > 0 and RayDone = 0
    ScanColumn -= 1
    MoveTo = GenerateRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanColumn < 7 and RayDone = 0
    ScanColumn += 1
    MoveTo = GenerateRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  return

sub ChessGenerateDiagonalMoves:
  MoveFrom = GenerateFrom
  MovePromotion = 0
  MoveFlags = 0
  GenerateRow = GenerateFrom >> 3
  GenerateColumn = GenerateFrom & 7

  ScanRow = GenerateRow
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanRow > 0 and ScanColumn > 0 and RayDone = 0
    ScanRow -= 1
    ScanColumn -= 1
    MoveTo = ScanRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanRow = GenerateRow
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanRow > 0 and ScanColumn < 7 and RayDone = 0
    ScanRow -= 1
    ScanColumn += 1
    MoveTo = ScanRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanRow = GenerateRow
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanRow < 7 and ScanColumn > 0 and RayDone = 0
    ScanRow += 1
    ScanColumn -= 1
    MoveTo = ScanRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  if StopAfterFirstLegal = 2 then return
  ScanRow = GenerateRow
  ScanColumn = GenerateColumn
  RayDone = 0
  while ScanRow < 7 and ScanColumn < 7 and RayDone = 0
    ScanRow += 1
    ScanColumn += 1
    MoveTo = ScanRow * 8 + ScanColumn
    ChessTrySlidingTarget
  end while
  return

sub ChessCountSlidingLegalMoves:
  LegalMoveCount = 0
  ChessFindKings
  for GenerateFrom = 0 to 63
    if Side = 0 and (Board[GenerateFrom] = WhiteRook or Board[GenerateFrom] = WhiteQueen) then ChessGenerateOrthogonalMoves
    if Side = 1 and (Board[GenerateFrom] = BlackRook or Board[GenerateFrom] = BlackQueen) then ChessGenerateOrthogonalMoves
    if Side = 0 and (Board[GenerateFrom] = WhiteBishop or Board[GenerateFrom] = WhiteQueen) then ChessGenerateDiagonalMoves
    if Side = 1 and (Board[GenerateFrom] = BlackBishop or Board[GenerateFrom] = BlackQueen) then ChessGenerateDiagonalMoves
  next
  return

sub ChessTryKingTarget:
  ScanPiece = Board[MoveTo]
  if Side = 0 and (ScanPiece = Empty or (ScanPiece >= BlackPawn and ScanPiece <> BlackKing)) then ChessTryLegalMove
  if Side = 1 and ScanPiece <> BlackKing and ScanPiece < BlackPawn and ScanPiece <> WhiteKing then ChessTryLegalMove
  return

sub ChessGenerateKingMoves:
  GenerateRow = GenerateFrom >> 3
  GenerateColumn = GenerateFrom & 7
  MoveFrom = GenerateFrom
  MovePromotion = 0
  MoveFlags = 0
  if GenerateRow > 0 then
    MoveTo = GenerateFrom - 8
    ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    if GenerateColumn > 0 then
      MoveTo = GenerateFrom - 9
      ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    end if
    if GenerateColumn < 7 then
      MoveTo = GenerateFrom - 7
      ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    end if
  end if
  if GenerateRow < 7 then
    MoveTo = GenerateFrom + 8
    ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    if GenerateColumn > 0 then
      MoveTo = GenerateFrom + 7
      ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    end if
    if GenerateColumn < 7 then
      MoveTo = GenerateFrom + 9
      ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
    end if
  end if
  if GenerateColumn > 0 then
    MoveTo = GenerateFrom - 1
    ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
  end if
  if GenerateColumn < 7 then
    MoveTo = GenerateFrom + 1
    ChessTryKingTarget
  if StopAfterFirstLegal = 2 then return
  end if

  ' Castling is the only move whose intermediate square must also be safe.
  if Side = 0 and GenerateFrom = 60 then
    AttackSide = 1
    AttackSquare = 60
    ChessIsSquareAttacked
    if AttackResult = 0 and Castling & 1 and Board[61] = Empty and Board[62] = Empty and Board[63] = WhiteRook then
      AttackSquare = 61
      ChessIsSquareAttacked
      if AttackResult = 0 then
        MoveTo = 62
        MoveFlags = FlagCastleKing
        ChessTryLegalMove
        MoveFlags = 0
      end if
    end if
    AttackSquare = 60
    ChessIsSquareAttacked
    if AttackResult = 0 and Castling & 2 and Board[59] = Empty and Board[58] = Empty and Board[57] = Empty and Board[56] = WhiteRook then
      AttackSquare = 59
      ChessIsSquareAttacked
      if AttackResult = 0 then
        MoveTo = 58
        MoveFlags = FlagCastleQueen
        ChessTryLegalMove
        MoveFlags = 0
      end if
    end if
  elseif Side = 1 and GenerateFrom = 4 then
    AttackSide = 0
    AttackSquare = 4
    ChessIsSquareAttacked
    if AttackResult = 0 and Castling & 4 and Board[5] = Empty and Board[6] = Empty and Board[7] = BlackRook then
      AttackSquare = 5
      ChessIsSquareAttacked
      if AttackResult = 0 then
        MoveTo = 6
        MoveFlags = FlagCastleKing
        ChessTryLegalMove
        MoveFlags = 0
      end if
    end if
    AttackSquare = 4
    ChessIsSquareAttacked
    if AttackResult = 0 and Castling & 8 and Board[3] = Empty and Board[2] = Empty and Board[1] = Empty and Board[0] = BlackRook then
      AttackSquare = 3
      ChessIsSquareAttacked
      if AttackResult = 0 then
        MoveTo = 2
        MoveFlags = FlagCastleQueen
        ChessTryLegalMove
        MoveFlags = 0
      end if
    end if
  end if
  return

sub ChessCountLegalMoves:
  LegalMoveCount = 0
  ChessFindKings
  for GenerateFrom = 0 to 63
    if Side = 0 and Board[GenerateFrom] = WhitePawn then ChessGeneratePawnMoves
    if Side = 1 and Board[GenerateFrom] = BlackPawn then ChessGeneratePawnMoves
    if Side = 0 and Board[GenerateFrom] = WhiteKnight then ChessGenerateKnightMoves
    if Side = 1 and Board[GenerateFrom] = BlackKnight then ChessGenerateKnightMoves
    if Side = 0 and (Board[GenerateFrom] = WhiteRook or Board[GenerateFrom] = WhiteQueen) then ChessGenerateOrthogonalMoves
    if Side = 1 and (Board[GenerateFrom] = BlackRook or Board[GenerateFrom] = BlackQueen) then ChessGenerateOrthogonalMoves
    if Side = 0 and (Board[GenerateFrom] = WhiteBishop or Board[GenerateFrom] = WhiteQueen) then ChessGenerateDiagonalMoves
    if Side = 1 and (Board[GenerateFrom] = BlackBishop or Board[GenerateFrom] = BlackQueen) then ChessGenerateDiagonalMoves
    if Side = 0 and Board[GenerateFrom] = WhiteKing then ChessGenerateKingMoves
    if Side = 1 and Board[GenerateFrom] = BlackKing then ChessGenerateKingMoves
    if StopAfterFirstLegal = 2 then exit for
    if StopAfterFirstMate = 1 and MateMoveCount > 0 then exit for
    if FindMateMode = 11 and RequestedMoveLegal = 1 then exit for
  next
  return

sub ChessMatchRequestedMove:
  if MoveFrom = RequestedMoveFrom and MoveTo = RequestedMoveTo and MovePromotion = RequestedMovePromotion then
    RequestedMoveLegal = 1
    RequestedMoveFlags = MoveFlags
  end if
  return

sub ChessValidateRequestedMove:
  RequestedMoveLegal = 0
  RequestedMoveFlags = 0
  FindMateMode = 11
  ChessCountLegalMoves
  FindMateMode = 0
  return

sub ChessEvaluateAppliedMoveForMate:
  SavedLegalMoveCount = LegalMoveCount
  SavedMoveFrom = MoveFrom
  SavedMoveTo = MoveTo
  SavedMovePromotion = MovePromotion
  SavedMoveFlags = MoveFlags
  SavedUndoPiece = UndoPiece
  SavedUndoCaptured = UndoCaptured
  SavedUndoCapturedSquare = UndoCapturedSquare
  SavedUndoCastling = UndoCastling
  SavedUndoEnPassant = UndoEnPassant
  SavedUndoHalfmove = UndoHalfmove
  SavedUndoFullmove = UndoFullmove
  SavedGenerateFrom = GenerateFrom
  SavedGenerateRow = GenerateRow
  SavedGenerateColumn = GenerateColumn
  SavedScanRow = ScanRow
  SavedScanColumn = ScanColumn
  SavedRayDone = RayDone
  SavedStopAfterFirstLegal = StopAfterFirstLegal

  ChessFindKings
  if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
  AttackSide = RootSide
  ChessIsSquareAttacked
  OpponentInCheck = AttackResult

  if OpponentInCheck = 1 then
    FindMateMode = 2
    StopAfterFirstLegal = 1
    ChessCountLegalMoves
    if LegalMoveCount = 0 then
      MateMoveCount += 1
      BestMoveFrom = SavedMoveFrom
      BestMoveTo = SavedMoveTo
      BestMoveFlags = SavedMoveFlags
      BestMovePromotion = SavedMovePromotion
    end if
  end if
  FindMateMode = 1
  StopAfterFirstLegal = SavedStopAfterFirstLegal

  LegalMoveCount = SavedLegalMoveCount
  MoveFrom = SavedMoveFrom
  MoveTo = SavedMoveTo
  MovePromotion = SavedMovePromotion
  MoveFlags = SavedMoveFlags
  UndoPiece = SavedUndoPiece
  UndoCaptured = SavedUndoCaptured
  UndoCapturedSquare = SavedUndoCapturedSquare
  UndoCastling = SavedUndoCastling
  UndoEnPassant = SavedUndoEnPassant
  UndoHalfmove = SavedUndoHalfmove
  UndoFullmove = SavedUndoFullmove
  GenerateFrom = SavedGenerateFrom
  GenerateRow = SavedGenerateRow
  GenerateColumn = SavedGenerateColumn
  ScanRow = SavedScanRow
  ScanColumn = SavedScanColumn
  RayDone = SavedRayDone
  MovingSide = RootSide
  AttackResult = 0
  return

sub ChessFindMateInOne:
  RootSide = Side
  MateMoveCount = 0
  BestMoveFrom = 255
  BestMoveTo = 255
  BestMoveFlags = 0
  BestMovePromotion = 0
  FindMateMode = 1
  ChessCountLegalMoves
  FindMateMode = 0
  return

sub ChessEvaluateAppliedMoveForPromotionApproach:
  if MovingSide = 0 and Board[MoveTo] = WhitePawn and MoveTo >= 8 and MoveTo <= 15 then
    PromotionApproachCount += 1
    BestMoveFrom = MoveFrom
    BestMoveTo = MoveTo
  end if
  if MovingSide = 1 and Board[MoveTo] = BlackPawn and MoveTo >= 48 and MoveTo <= 55 then
    PromotionApproachCount += 1
    BestMoveFrom = MoveFrom
    BestMoveTo = MoveTo
  end if
  return

sub ChessFindPromotionApproachMoves:
  PromotionApproachCount = 0
  BestMoveFrom = 255
  BestMoveTo = 255
  FindMateMode = 3
  ChessCountLegalMoves
  FindMateMode = 0
  return

sub ChessEvaluateAppliedMoveForKeySquare:
  if MovingSide = 0 and Board[MoveTo] = WhiteKing then
    KeyCandidateRow = MoveTo >> 3
    KeyCandidateColumn = MoveTo & 7
    if KeyCandidateRow > KeyTargetRow then KeyRowDistance = KeyCandidateRow - KeyTargetRow else KeyRowDistance = KeyTargetRow - KeyCandidateRow
    KeyColumnDistance = 0
    if KeyCandidateColumn + 1 < KeyPawnColumn then KeyColumnDistance = KeyPawnColumn - 1 - KeyCandidateColumn
    if KeyCandidateColumn > KeyPawnColumn + 1 then KeyColumnDistance = KeyCandidateColumn - KeyPawnColumn - 1
    KeyCandidateScore = KeyRowDistance
    if KeyColumnDistance > KeyCandidateScore then KeyCandidateScore = KeyColumnDistance
    if KeyCandidateScore < KeyBestScore then
      KeyBestScore = KeyCandidateScore
      KeyBestMoveFrom = MoveFrom
      KeyBestMoveTo = MoveTo
    end if
  end if
  return

sub ChessFindWhiteKeySquareMove:
  KeyPawnSquare = 255
  for I = 0 to 63
    if Board[I] = WhitePawn then KeyPawnSquare = I
  next
  KeyBestScore = 255
  KeyBestMoveFrom = 255
  KeyBestMoveTo = 255
  if KeyPawnSquare < 64 then
    KeyPawnRow = KeyPawnSquare >> 3
    KeyPawnColumn = KeyPawnSquare & 7
    if KeyPawnRow >= 2 then KeyTargetRow = KeyPawnRow - 2 else KeyTargetRow = 0
    FindMateMode = 4
    ChessCountLegalMoves
    FindMateMode = 0
  end if
  return

sub ChessEvaluateAppliedCapture:
  if UndoCaptured <> Empty or MoveFlags & FlagEnPassant then
    CaptureMoveCount += 1
    CaptureBestMoveFrom = MoveFrom
    CaptureBestMoveTo = MoveTo
    CaptureBestMoveFlags = MoveFlags
    CaptureBestMovePromotion = MovePromotion
  end if
  return

sub ChessFindLegalCaptures:
  CaptureMoveCount = 0
  CaptureBestMoveFrom = 255
  CaptureBestMoveTo = 255
  CaptureBestMoveFlags = 0
  CaptureBestMovePromotion = 0
  FindMateMode = 5
  ChessCountLegalMoves
  FindMateMode = 0
  return

sub ChessSelectAppliedMove:
  if SelectedMoveFrom = 255 then
    SelectedMoveFrom = MoveFrom
    SelectedMoveTo = MoveTo
    SelectedMoveFlags = MoveFlags
    SelectedMovePromotion = MovePromotion
  end if
  return

sub ChessFindFirstLegalMove:
  SelectedMoveFrom = 255
  SelectedMoveTo = 255
  SelectedMoveFlags = 0
  SelectedMovePromotion = 0
  StopAfterFirstLegal = 1
  FindMateMode = 6
  ChessCountLegalMoves
  FindMateMode = 0
  StopAfterFirstLegal = 0
  return

sub ChessEvaluatePosition:
  ChessEvaluateMaterial
  PositionScore = MaterialBalance
  for I = 0 to 63
    if Board[I] <> Empty then
      PieceSquare = I
      PieceSquareKind = Board[I]
      if PieceSquareKind >= BlackPawn then
        PieceSquareKind -= 8
        PieceSquare = I ^ 56
      end if
#ifdef CHESS_COMPACT_PST
      asm {
        ld a,(AMY_UVAR_PieceSquareKind)
        cp AMY_UCONST_WhitePawn
        jr z,AMY_CHESS_PST_PAWN
        ld c,a
        ld a,(AMY_UVAR_EndgamePieceCount)
        cp 17
        jr c,AMY_CHESS_PST_END_OFFSET
        ld a,c
        cp AMY_UCONST_WhiteRook
        jr z,AMY_CHESS_PST_MIDDLE_ROOK
        ld hl,ChessCenterOffsets
        jr AMY_CHESS_PST_OFFSET
AMY_CHESS_PST_END_OFFSET:
        ld a,c
        add a,7
        ld hl,ChessCenterOffsets
AMY_CHESS_PST_OFFSET:
        ld e,a
        ld d,0
        add hl,de
        ld b,(hl)
        ld a,(AMY_UVAR_PieceSquare)
        ld c,a
        and 7
        cp 4
        jr c,AMY_CHESS_PST_COLUMN_READY
        xor 7
AMY_CHESS_PST_COLUMN_READY:
        ld e,a
        ld a,c
        rrca
        rrca
        rrca
        and 7
        cp 4
        jr c,AMY_CHESS_PST_ROW_READY
        xor 7
AMY_CHESS_PST_ROW_READY:
        add a,e
        add a,b
        ld e,a
        ld d,0
        ld hl,ChessCenterBonus
        add hl,de
        ld c,(hl)
        ld a,(AMY_UVAR_EndgamePieceCount)
        cp 17
        jr c,AMY_CHESS_PST_CENTER_STORE
        ld a,(AMY_UVAR_PieceSquareKind)
        cp AMY_UCONST_WhiteKing
        jr nz,AMY_CHESS_PST_CENTER_STORE
        ld a,(AMY_UVAR_PieceSquare)
        cp 58
        jr z,AMY_CHESS_PST_CASTLED_KING
        cp 62
        jr nz,AMY_CHESS_PST_CENTER_STORE
AMY_CHESS_PST_CASTLED_KING:
        ld a,c
        add a,40
        jr AMY_CHESS_PST_STORE
AMY_CHESS_PST_CENTER_STORE:
        ld a,c
        jr AMY_CHESS_PST_STORE
AMY_CHESS_PST_MIDDLE_ROOK:
        ld a,(AMY_UVAR_PieceSquare)
        and $38
        ld c,0
        cp 8
        jr nz,AMY_CHESS_PST_CENTER_STORE
        ld c,14
        jr AMY_CHESS_PST_CENTER_STORE
AMY_CHESS_PST_PAWN:
        ld a,(AMY_UVAR_PieceSquare)
        ld e,a
        ld a,(AMY_UVAR_EndgamePieceCount)
        cp 17
        jr nc,AMY_CHESS_PST_PAWN_OFFSET_READY
        ld a,e
        add a,64
        ld e,a
AMY_CHESS_PST_PAWN_OFFSET_READY:
        ld d,0
        ld hl,ChessPawnBonus
        add hl,de
        ld a,(hl)
AMY_CHESS_PST_STORE:
        ld (AMY_UVAR_PieceSquareValue),a
      }
#else
      PieceSquareIndex = PieceSquareKind - 1
      PieceSquareIndex <<= 6
      PieceSquareIndex += PieceSquare
      if EndgamePieceCount <= 16 then PieceSquareIndex += 384
      asm {
        ld hl,ChessPieceSquareBonus
        ld bc,(AMY_UVAR_PieceSquareIndex)
        add hl,bc
        ld a,(hl)
        ld (AMY_UVAR_PieceSquareValue),a
      }
#endif
      if Board[I] >= BlackPawn then
        PositionScore -= PieceSquareValue
      else
        PositionScore += PieceSquareValue
      end if
    end if
  next
  if EndgamePieceCount <= 16 then
    asm {
      push ix
      ld ix,AMY_UVAR_Board
      ld hl,0
      ld b,8
      ld c,48
AMY_CHESS_PAWN_ROW:
      push bc
      ld b,8
AMY_CHESS_PAWN_SQUARE:
      ld a,(ix+0)
      inc ix
      cp AMY_UCONST_WhitePawn
      jr z,AMY_CHESS_PAWN_WHITE
      cp AMY_UCONST_BlackPawn
      jr nz,AMY_CHESS_PAWN_NEXT
      ld a,c
      sub 40
      ld e,a
      ld d,0
      bit 7,e
      jr z,AMY_CHESS_PAWN_ADD
      dec d
      jr AMY_CHESS_PAWN_ADD
AMY_CHESS_PAWN_WHITE:
      ld e,c
      ld d,0
AMY_CHESS_PAWN_ADD:
      add hl,de
AMY_CHESS_PAWN_NEXT:
      djnz AMY_CHESS_PAWN_SQUARE
      pop bc
      ld a,c
      sub 8
      ld c,a
      djnz AMY_CHESS_PAWN_ROW
      ld de,(AMY_UVAR_PositionScore)
      add hl,de
      ld (AMY_UVAR_PositionScore),hl
      pop ix
    }
  end if
  if EndgamePieceCount <= 6 and (MaterialBalance >= 400 or MaterialBalance <= -400) then
    EndgameKingRowDistance = WhiteKingSquare >> 3
    CenterValue = BlackKingSquare >> 3
    if EndgameKingRowDistance > CenterValue then EndgameKingRowDistance -= CenterValue else EndgameKingRowDistance = CenterValue - EndgameKingRowDistance
    EndgameKingColumnDistance = WhiteKingSquare & 7
    CenterValue = BlackKingSquare & 7
    if EndgameKingColumnDistance > CenterValue then EndgameKingColumnDistance -= CenterValue else EndgameKingColumnDistance = CenterValue - EndgameKingColumnDistance
    EndgameKingDistance = EndgameKingRowDistance
    if EndgameKingColumnDistance > EndgameKingDistance then EndgameKingDistance = EndgameKingColumnDistance
    if MaterialBalance >= 400 then
      CenterValue = ChessKingConfinement[BlackKingSquare]
      PositionScore += (6 - CenterValue) * 14
      PositionScore -= CenterValue * 22
      CenterValue = ChessKingConfinement[WhiteKingSquare]
      PositionScore += CenterValue * 22
      PositionScore += (7 - EndgameKingDistance) * 50
    else
      CenterValue = ChessKingConfinement[WhiteKingSquare]
      PositionScore -= (6 - CenterValue) * 14
      PositionScore += CenterValue * 22
      CenterValue = ChessKingConfinement[BlackKingSquare]
      PositionScore -= CenterValue * 22
      PositionScore -= (7 - EndgameKingDistance) * 50
    end if
  end if
  if MovingSide = 1 then PositionScore = 0 - PositionScore
  return

sub ChessEvaluateAppliedMovePosition:
  ChessEvaluatePosition
  ChessPenalizeLooseMovedPiece
  if PositionScore > PositionalBestScore then
    PositionalBestScore = PositionScore
    PositionalTieCount = 0
    PositionalBestFrom = MoveFrom
    PositionalBestTo = MoveTo
    PositionalBestFlags = MoveFlags
    PositionalBestPromotion = MovePromotion
  elseif PositionScore = PositionalBestScore then
    PositionalTieCount += 1
    if ChessLevel = 0 and PositionalTieCount = MoveVariation then
      PositionalBestFrom = MoveFrom
      PositionalBestTo = MoveTo
      PositionalBestFlags = MoveFlags
      PositionalBestPromotion = MovePromotion
    end if
  end if
  return

sub ChessPenalizeLooseMovedPiece:
  MovedPieceValue = 0
  if Board[MoveTo] = WhitePawn or Board[MoveTo] = BlackPawn then MovedPieceValue = 100
  if Board[MoveTo] = WhiteKnight or Board[MoveTo] = BlackKnight then MovedPieceValue = 255
  if Board[MoveTo] = WhiteBishop or Board[MoveTo] = BlackBishop then MovedPieceValue = 255
  if Board[MoveTo] = WhiteRook or Board[MoveTo] = BlackRook then MovedPieceValue = 255
  if Board[MoveTo] = WhiteQueen or Board[MoveTo] = BlackQueen then MovedPieceValue = 255
  if MovedPieceValue = 0 then return

  SavedAttackSquare = AttackSquare
  SavedAttackSide = AttackSide
  SavedAttackRow = AttackRow
  SavedAttackColumn = AttackColumn
  SavedScanRow = ScanRow
  SavedScanColumn = ScanColumn
  SavedScanSquare = ScanSquare
  SavedScanPiece = ScanPiece
  SavedRayDone = RayDone

  AttackSquare = MoveTo
  AttackSide = Side
  ChessIsSquareAttacked
  MovedPieceAttacked = AttackResult
  if MovedPieceAttacked = 1 then
    PositionScore -= MovedPieceValue
    if Board[MoveTo] = WhiteRook or Board[MoveTo] = BlackRook then PositionScore -= 255
    if Board[MoveTo] = WhiteQueen or Board[MoveTo] = BlackQueen then PositionScore -= 765
  end if

  AttackSquare = SavedAttackSquare
  AttackSide = SavedAttackSide
  AttackRow = SavedAttackRow
  AttackColumn = SavedAttackColumn
  ScanRow = SavedScanRow
  ScanColumn = SavedScanColumn
  ScanSquare = SavedScanSquare
  ScanPiece = SavedScanPiece
  RayDone = SavedRayDone
  AttackResult = 0
  return

sub ChessFindPositionalMove:
  PositionalBestScore = -30000
  PositionalTieCount = 0
  PositionalBestFrom = 255
  PositionalBestTo = 255
  PositionalBestFlags = 0
  PositionalBestPromotion = 0
  FindMateMode = 7
  ChessCountLegalMoves
  FindMateMode = 0
  SelectedMoveFrom = PositionalBestFrom
  SelectedMoveTo = PositionalBestTo
  SelectedMoveFlags = PositionalBestFlags
  SelectedMovePromotion = PositionalBestPromotion
  return

sub ChessEvaluateAppliedMoveSafety:
  ChessSaveSearchFrame(SearchStack[0])

  ' A minimax cutoff must not truncate the opponent's mate-in-one scan.
  StopAfterFirstLegal = 0
  StopAfterFirstMate = 1
  ChessFindMateInOne
  StopAfterFirstMate = 0

  ChessRestoreSearchFrame(SearchStack[0])
  MovingSide = 1 - Side
  FindMateMode = 8

  if MateMoveCount = 0 then
    SafeMoveCount += 1
    ChessEvaluateAppliedMovePosition
  end if
  return

sub ChessSaveSearchFrame(ref ChessSearchFrame Context):
  Context.MoveFrom = MoveFrom
  Context.MoveTo = MoveTo
  Context.MovePromotion = MovePromotion
  Context.MoveFlags = MoveFlags
  Context.UndoPiece = UndoPiece
  Context.UndoCaptured = UndoCaptured
  Context.UndoCapturedSquare = UndoCapturedSquare
  Context.UndoCastling = UndoCastling
  Context.UndoEnPassant = UndoEnPassant
  Context.UndoHalfmove = UndoHalfmove
  Context.UndoFullmove = UndoFullmove
  Context.GenerateFrom = GenerateFrom
  Context.GenerateRow = GenerateRow
  Context.GenerateColumn = GenerateColumn
  Context.ScanRow = ScanRow
  Context.ScanColumn = ScanColumn
  Context.RayDone = RayDone
  Context.WhiteKingSquare = WhiteKingSquare
  Context.BlackKingSquare = BlackKingSquare
  Context.LegalMoveCount = LegalMoveCount
  return

sub ChessRestoreSearchFrame(ref ChessSearchFrame Context):
  MoveFrom = Context.MoveFrom
  MoveTo = Context.MoveTo
  MovePromotion = Context.MovePromotion
  MoveFlags = Context.MoveFlags
  UndoPiece = Context.UndoPiece
  UndoCaptured = Context.UndoCaptured
  UndoCapturedSquare = Context.UndoCapturedSquare
  UndoCastling = Context.UndoCastling
  UndoEnPassant = Context.UndoEnPassant
  UndoHalfmove = Context.UndoHalfmove
  UndoFullmove = Context.UndoFullmove
  GenerateFrom = Context.GenerateFrom
  GenerateRow = Context.GenerateRow
  GenerateColumn = Context.GenerateColumn
  ScanRow = Context.ScanRow
  ScanColumn = Context.ScanColumn
  RayDone = Context.RayDone
  WhiteKingSquare = Context.WhiteKingSquare
  BlackKingSquare = Context.BlackKingSquare
  LegalMoveCount = Context.LegalMoveCount
  return

sub ChessFindAnySafePositionalMove:
  SafeMoveCount = 0
  PositionalBestScore = -30000
  PositionalTieCount = 0
  PositionalBestFrom = 255
  PositionalBestTo = 255
  PositionalBestFlags = 0
  PositionalBestPromotion = 0
  FindMateMode = 8
  ChessCountLegalMoves
  FindMateMode = 0
  if SafeMoveCount = 0 then
    ChessFindPositionalMove
  else
    SelectedMoveFrom = PositionalBestFrom
    SelectedMoveTo = PositionalBestTo
    SelectedMoveFlags = PositionalBestFlags
    SelectedMovePromotion = PositionalBestPromotion
  end if
  return

sub ChessFindSafePositionalMove:
  ChessFindPositionalMove
  MoveFrom = SelectedMoveFrom
  MoveTo = SelectedMoveTo
  MoveFlags = SelectedMoveFlags
  MovePromotion = SelectedMovePromotion
  MovingSide = Side
  ChessApplyMove
  SafeMoveCount = 0
  ChessEvaluateAppliedMoveSafety
  ChessUndoMove
  if SafeMoveCount = 0 then ChessFindAnySafePositionalMove
  return

sub ChessEvaluateMinimaxReply:
  MinimaxReplyCount += 1
  if MinimaxDepth = 2 then
    MinimaxNodes += 1
    MovingSide = MinimaxRootSide
    ChessEvaluatePosition
    ChessPenalizeAttackedMinimaxRootPiece
    if UndoCaptured <> Empty or MoveFlags & FlagEnPassant then
      RecaptureBestScore = PositionScore
      RecaptureTarget = MoveTo
      ChessSaveSearchFrame(SearchStack[1])
      ChessFindShortRangeRecaptures
      ChessRestoreSearchFrame(SearchStack[1])
      FindMateMode = 9
      MovingSide = MinimaxRootSide
      PositionScore = RecaptureBestScore
    end if
  else
    ChessSaveSearchFrame(SearchStack[1])
    SavedStopAfterFirstLegal = StopAfterFirstLegal
    StopAfterFirstLegal = 0
    MinimaxContinuationBestScore = -30000
    FindMateMode = 13
    ChessCountLegalMoves
    if LegalMoveCount = 0 then
      ChessFindKings
      if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
      AttackSide = 1 - MinimaxRootSide
      ChessIsSquareAttacked
      if AttackResult = 1 then MinimaxContinuationBestScore = -29000 else MinimaxContinuationBestScore = 0
    end if
    ChessRestoreSearchFrame(SearchStack[1])
    StopAfterFirstLegal = SavedStopAfterFirstLegal
    MovingSide = MinimaxRootSide
    FindMateMode = 9
    PositionScore = MinimaxContinuationBestScore
  end if
  if PositionScore < MinimaxWorstScore then MinimaxWorstScore = PositionScore
  if MinimaxUseCutoff = 1 and MinimaxWorstScore <= MinimaxBestScore then
    StopAfterFirstLegal = 1
    MinimaxCutoffs += 1
  end if
  return

sub ChessPenalizeAttackedMinimaxRootPiece:
  if Board[MinimaxRootTarget] <> MinimaxRootPiece then return
  MovedPieceValue = 0
  if MinimaxRootPiece = WhiteQueen or MinimaxRootPiece = BlackQueen then MovedPieceValue = 255
  if MovedPieceValue = 0 then return

  SavedAttackSquare = AttackSquare
  SavedAttackSide = AttackSide
  SavedAttackRow = AttackRow
  SavedAttackColumn = AttackColumn
  SavedScanRow = ScanRow
  SavedScanColumn = ScanColumn
  SavedScanSquare = ScanSquare
  SavedScanPiece = ScanPiece
  SavedRayDone = RayDone
  AttackSquare = MinimaxRootTarget
  AttackSide = 1 - MinimaxRootSide
  ChessIsSquareAttacked
  if AttackResult = 1 then PositionScore -= MovedPieceValue
  AttackSquare = SavedAttackSquare
  AttackSide = SavedAttackSide
  AttackRow = SavedAttackRow
  AttackColumn = SavedAttackColumn
  ScanRow = SavedScanRow
  ScanColumn = SavedScanColumn
  ScanSquare = SavedScanSquare
  ScanPiece = SavedScanPiece
  RayDone = SavedRayDone
  AttackResult = 0
  return

sub ChessEvaluateMinimaxContinuation:
  MinimaxNodes += 1
  MovingSide = MinimaxRootSide
  ChessEvaluatePosition
  if UndoCaptured <> Empty or MoveFlags & FlagEnPassant then
    RecaptureBestScore = PositionScore
    RecaptureTarget = MoveTo
    ChessSaveSearchFrame(SearchStack[2])
    ChessFindShortRangeRecaptures
    ChessRestoreSearchFrame(SearchStack[2])
    FindMateMode = 13
    MovingSide = MinimaxRootSide
    PositionScore = RecaptureBestScore
  end if
  if PositionScore > MinimaxContinuationBestScore then MinimaxContinuationBestScore = PositionScore
  if MinimaxUseCutoff = 1 and MinimaxContinuationBestScore >= MinimaxWorstScore then StopAfterFirstLegal = 1
  return

sub ChessEvaluateRecapture:
  MovingSide = MinimaxRootSide
  ChessEvaluatePosition
  if PositionScore > RecaptureBestScore then RecaptureBestScore = PositionScore
  return

sub ChessTryRecaptureCandidate:
  MoveTo = RecaptureTarget
  MoveFlags = 0
  MovePromotion = 0
  if Side = 0 and Board[MoveFrom] = WhitePawn and RecaptureTarget < 8 then MovePromotion = WhiteQueen
  if Side = 1 and Board[MoveFrom] = BlackPawn and RecaptureTarget >= 56 then MovePromotion = BlackQueen
  FindMateMode = 12
  ChessTryLegalMove
  return

sub ChessTryKnightRecapture:
  if Side = 0 and Board[MoveFrom] = WhiteKnight then ChessTryRecaptureCandidate
  if Side = 1 and Board[MoveFrom] = BlackKnight then ChessTryRecaptureCandidate
  return

sub ChessFindShortRangeRecaptures:
  RecaptureRow = RecaptureTarget >> 3
  RecaptureColumn = RecaptureTarget & 7

  if Side = 0 and RecaptureRow < 7 then
    if RecaptureColumn > 0 and Board[RecaptureTarget + 7] = WhitePawn then
      MoveFrom = RecaptureTarget + 7
      ChessTryRecaptureCandidate
    end if
    if RecaptureColumn < 7 and Board[RecaptureTarget + 9] = WhitePawn then
      MoveFrom = RecaptureTarget + 9
      ChessTryRecaptureCandidate
    end if
  elseif Side = 1 and RecaptureRow > 0 then
    if RecaptureColumn > 0 and Board[RecaptureTarget - 9] = BlackPawn then
      MoveFrom = RecaptureTarget - 9
      ChessTryRecaptureCandidate
    end if
    if RecaptureColumn < 7 and Board[RecaptureTarget - 7] = BlackPawn then
      MoveFrom = RecaptureTarget - 7
      ChessTryRecaptureCandidate
    end if
  end if

  if RecaptureRow > 1 and RecaptureColumn > 0 then
    MoveFrom = RecaptureTarget - 17
    ChessTryKnightRecapture
  end if
  if RecaptureRow > 1 and RecaptureColumn < 7 then
    MoveFrom = RecaptureTarget - 15
    ChessTryKnightRecapture
  end if
  if RecaptureRow > 0 and RecaptureColumn > 1 then
    MoveFrom = RecaptureTarget - 10
    ChessTryKnightRecapture
  end if
  if RecaptureRow > 0 and RecaptureColumn < 6 then
    MoveFrom = RecaptureTarget - 6
    ChessTryKnightRecapture
  end if
  if RecaptureRow < 7 and RecaptureColumn > 1 then
    MoveFrom = RecaptureTarget + 6
    ChessTryKnightRecapture
  end if
  if RecaptureRow < 7 and RecaptureColumn < 6 then
    MoveFrom = RecaptureTarget + 10
    ChessTryKnightRecapture
  end if
  if RecaptureRow < 6 and RecaptureColumn > 0 then
    MoveFrom = RecaptureTarget + 15
    ChessTryKnightRecapture
  end if
  if RecaptureRow < 6 and RecaptureColumn < 7 then
    MoveFrom = RecaptureTarget + 17
    ChessTryKnightRecapture
  end if

  if Side = 0 then MoveFrom = WhiteKingSquare else MoveFrom = BlackKingSquare
  if MoveFrom <> 255 then
    ScanRow = MoveFrom >> 3
    ScanColumn = MoveFrom & 7
    if ScanRow + 1 >= RecaptureRow and ScanRow <= RecaptureRow + 1 and ScanColumn + 1 >= RecaptureColumn and ScanColumn <= RecaptureColumn + 1 and MoveFrom <> RecaptureTarget then ChessTryRecaptureCandidate
  end if
  return

sub ChessEvaluateMinimaxRoot:
  MinimaxRootTarget = MoveTo
  MinimaxRootPiece = UndoPiece
  ChessSaveSearchFrame(SearchStack[0])
  MinimaxRootSide = MovingSide
  MinimaxWorstScore = 30000
  SavedStopAfterFirstLegal = StopAfterFirstLegal
  StopAfterFirstLegal = 0
  MinimaxReplyCount = 0
  FindMateMode = 9
  ChessCountLegalMoves
  if MinimaxReplyCount = 0 then
    ChessFindKings
    if Side = 0 then AttackSquare = WhiteKingSquare else AttackSquare = BlackKingSquare
    AttackSide = MinimaxRootSide
    ChessIsSquareAttacked
    if AttackResult = 1 then MinimaxWorstScore = 29000 else MinimaxWorstScore = 0
  end if
  ChessRestoreSearchFrame(SearchStack[0])
  StopAfterFirstLegal = SavedStopAfterFirstLegal
  MovingSide = MinimaxRootSide
  FindMateMode = 10
  if EndgamePieceCount <= 6 then
    if MinimaxRootSide = 0 and MaterialBalance >= 400 then MinimaxWorstScore -= MinimaxReplyCount * 20
    if MinimaxRootSide = 1 and MaterialBalance <= -400 then MinimaxWorstScore -= MinimaxReplyCount * 20
  end if
  if MinimaxWorstScore > MinimaxBestScore then
    MinimaxBestScore = MinimaxWorstScore
    MinimaxBestFrom = MoveFrom
    MinimaxBestTo = MoveTo
    MinimaxBestFlags = MoveFlags
    MinimaxBestPromotion = MovePromotion
  end if
  return

sub ChessFindDepthTwoMove:
  MinimaxDepth = 2
  MinimaxBestScore = -30000
  MinimaxBestFrom = 255
  MinimaxBestTo = 255
  MinimaxBestFlags = 0
  MinimaxBestPromotion = 0
  MinimaxNodes = 0
  MinimaxCutoffs = 0
  MinimaxSeedFrom = 255
  MinimaxSeedTo = 255
  MinimaxSeedFlags = 0
  MinimaxSeedPromotion = 0
  if MinimaxSeedEnabled = 1 then
    ChessFindPositionalMove
    MoveFrom = SelectedMoveFrom
    MoveTo = SelectedMoveTo
    MoveFlags = SelectedMoveFlags
    MovePromotion = SelectedMovePromotion
    FindMateMode = 10
    ChessTryLegalMove
    MinimaxSeedFrom = SelectedMoveFrom
    MinimaxSeedTo = SelectedMoveTo
    MinimaxSeedFlags = SelectedMoveFlags
    MinimaxSeedPromotion = SelectedMovePromotion
  end if
  FindMateMode = 10
  ChessCountLegalMoves
  FindMateMode = 0
  SelectedMoveFrom = MinimaxBestFrom
  SelectedMoveTo = MinimaxBestTo
  SelectedMoveFlags = MinimaxBestFlags
  SelectedMovePromotion = MinimaxBestPromotion
  return

sub ChessFindDepthThreeMove:
  MinimaxBestScore = -30000
  MinimaxBestFrom = 255
  MinimaxBestTo = 255
  MinimaxBestFlags = 0
  MinimaxBestPromotion = 0
  MinimaxNodes = 0
  MinimaxCutoffs = 0
  MinimaxSeedFrom = 255
  MinimaxSeedTo = 255
  MinimaxSeedFlags = 0
  MinimaxSeedPromotion = 0
  if MinimaxSeedEnabled = 1 then
    ChessFindDepthTwoMove
    MinimaxSeedFrom = SelectedMoveFrom
    MinimaxSeedTo = SelectedMoveTo
    MinimaxSeedFlags = SelectedMoveFlags
    MinimaxSeedPromotion = SelectedMovePromotion
    MinimaxBestScore = -30000
    MinimaxBestFrom = 255
    MinimaxBestTo = 255
    MinimaxBestFlags = 0
    MinimaxBestPromotion = 0
    MinimaxNodes = 0
    MinimaxCutoffs = 0
  end if
  MinimaxDepth = 3
  if MinimaxSeedFrom <> 255 then
    MoveFrom = MinimaxSeedFrom
    MoveTo = MinimaxSeedTo
    MoveFlags = MinimaxSeedFlags
    MovePromotion = MinimaxSeedPromotion
    FindMateMode = 10
    ChessTryLegalMove
  end if
  FindMateMode = 10
  ChessCountLegalMoves
  FindMateMode = 0
  SelectedMoveFrom = MinimaxBestFrom
  SelectedMoveTo = MinimaxBestTo
  SelectedMoveFlags = MinimaxBestFlags
  SelectedMovePromotion = MinimaxBestPromotion
  return

sub ChessEnsureSelectedMoveSafe:
  if SelectedMoveFrom = 255 then return
  MoveFrom = SelectedMoveFrom
  MoveTo = SelectedMoveTo
  MoveFlags = SelectedMoveFlags
  MovePromotion = SelectedMovePromotion
  MovingSide = Side
  ChessApplyMove
  SafeMoveCount = 0
  ChessEvaluateAppliedMoveSafety
  ChessUndoMove
  if SafeMoveCount = 0 then ChessFindAnySafePositionalMove
  return

sub ChessFindPreferredMove:
  ChessFindMateInOne
  if MateMoveCount > 0 then
    SelectedMoveFrom = BestMoveFrom
    SelectedMoveTo = BestMoveTo
    SelectedMoveFlags = BestMoveFlags
    SelectedMovePromotion = BestMovePromotion
  else
    if ChessLevel = 0 then
      ChessFindPositionalMove
    else
      MovingSide = Side
      ChessEvaluatePosition
      if EndgamePieceCount <= 10 then ChessFindDepthThreeMove else ChessFindDepthTwoMove
      if SelectedMoveFrom = 255 then ChessFindSafePositionalMove else ChessEnsureSelectedMoveSafe
    end if
  end if
  return

sub ChessRunDeterministicSelfPlay:
  ChessInitialPosition
  ChessResetRepetitionHistory
  SelfPlayPly = 0
  SelfPlayFinished = 0
  SelfPlayReason = 0
  while SelfPlayPly < 300 and SelfPlayFinished = 0
    ChessFindFirstLegalMove
    if SelectedMoveFrom = 255 then
      SelfPlayFinished = 1
      SelfPlayReason = 1
    else
      MoveFrom = SelectedMoveFrom
      MoveTo = SelectedMoveTo
      MoveFlags = SelectedMoveFlags
      MovePromotion = SelectedMovePromotion
      ChessApplyMove
      ChessRecordPosition
      SelfPlayPly += 1
      ChessClassifyInsufficientMaterial
      ChessClassifyRepetition
      if InsufficientMaterial = 1 then
        SelfPlayFinished = 1
        SelfPlayReason = 2
      elseif AutomaticFivefold = 1 then
        SelfPlayFinished = 1
        SelfPlayReason = 5
      elseif Halfmove >= 150 then
        SelfPlayFinished = 1
        SelfPlayReason = 3
      end if
    end if
  end while
  if SelfPlayFinished = 0 then SelfPlayReason = 4
  return

sub ChessEvaluateMaterial:
  MaterialBalance = 0
  EndgamePieceCount = 0
  for I = 0 to 63
    if Board[I] <> Empty then EndgamePieceCount += 1
    if Board[I] = WhitePawn then MaterialBalance += 100
    if Board[I] = WhiteKnight then MaterialBalance += 320
    if Board[I] = WhiteBishop then MaterialBalance += 330
    if Board[I] = WhiteRook then MaterialBalance += 500
    if Board[I] = WhiteQueen then MaterialBalance += 900
    if Board[I] = BlackPawn then MaterialBalance -= 100
    if Board[I] = BlackKnight then MaterialBalance -= 320
    if Board[I] = BlackBishop then MaterialBalance -= 330
    if Board[I] = BlackRook then MaterialBalance -= 500
    if Board[I] = BlackQueen then MaterialBalance -= 900
  next
  return

sub ChessEvaluateForcedCaptureExchange:
  ExchangeStaticBalance = 0
  ExchangeQuietBalance = 0
  ExchangeReplyCount = 0
  ChessFindLegalCaptures
  if CaptureMoveCount = 1 then
    MoveFrom = CaptureBestMoveFrom
    MoveTo = CaptureBestMoveTo
    MoveFlags = CaptureBestMoveFlags
    MovePromotion = CaptureBestMovePromotion
    ChessApplyMove
    ChessEvaluateMaterial
    ExchangeStaticBalance = MaterialBalance

    SavedMoveFrom = MoveFrom
    SavedMoveTo = MoveTo
    SavedMovePromotion = MovePromotion
    SavedMoveFlags = MoveFlags
    SavedUndoPiece = UndoPiece
    SavedUndoCaptured = UndoCaptured
    SavedUndoCapturedSquare = UndoCapturedSquare
    SavedUndoCastling = UndoCastling
    SavedUndoEnPassant = UndoEnPassant
    SavedUndoHalfmove = UndoHalfmove
    SavedUndoFullmove = UndoFullmove

    ChessFindLegalCaptures
    ExchangeReplyCount = CaptureMoveCount
    if CaptureMoveCount = 1 then
      MoveFrom = CaptureBestMoveFrom
      MoveTo = CaptureBestMoveTo
      MoveFlags = CaptureBestMoveFlags
      MovePromotion = CaptureBestMovePromotion
      ChessApplyMove
      ChessEvaluateMaterial
      ExchangeQuietBalance = MaterialBalance
      ChessUndoMove
    end if

    MoveFrom = SavedMoveFrom
    MoveTo = SavedMoveTo
    MovePromotion = SavedMovePromotion
    MoveFlags = SavedMoveFlags
    UndoPiece = SavedUndoPiece
    UndoCaptured = SavedUndoCaptured
    UndoCapturedSquare = SavedUndoCapturedSquare
    UndoCastling = SavedUndoCastling
    UndoEnPassant = SavedUndoEnPassant
    UndoHalfmove = SavedUndoHalfmove
    UndoFullmove = SavedUndoFullmove
    ChessUndoMove
  end if
  return

sub ChessApplyMove:
  UndoPiece = Board[MoveFrom]
  UndoCaptured = Board[MoveTo]
  UndoCapturedSquare = MoveTo
  UndoCastling = Castling
  UndoEnPassant = EnPassant
  UndoHalfmove = Halfmove
  UndoFullmove = Fullmove
  EnPassant = 255

  if UndoPiece = WhiteKing then Castling = Castling & 12
  if UndoPiece = BlackKing then Castling = Castling & 3
  if UndoPiece = WhiteRook and MoveFrom = 63 then Castling = Castling & 14
  if UndoPiece = WhiteRook and MoveFrom = 56 then Castling = Castling & 13
  if UndoPiece = BlackRook and MoveFrom = 7 then Castling = Castling & 11
  if UndoPiece = BlackRook and MoveFrom = 0 then Castling = Castling & 7
  if UndoCaptured = WhiteRook and MoveTo = 63 then Castling = Castling & 14
  if UndoCaptured = WhiteRook and MoveTo = 56 then Castling = Castling & 13
  if UndoCaptured = BlackRook and MoveTo = 7 then Castling = Castling & 11
  if UndoCaptured = BlackRook and MoveTo = 0 then Castling = Castling & 7

  if MoveFlags & FlagEnPassant then
    if Side = 0 then UndoCapturedSquare = MoveTo + 8 else UndoCapturedSquare = MoveTo - 8
    UndoCaptured = Board[UndoCapturedSquare]
    Board[UndoCapturedSquare] = Empty
  end if

  Board[MoveFrom] = Empty
  if MovePromotion <> 0 then Board[MoveTo] = MovePromotion else Board[MoveTo] = UndoPiece

  if MoveFlags & FlagCastleKing then
    if Side = 0 then
      Board[61] = Board[63]
      Board[63] = Empty
    else
      Board[5] = Board[7]
      Board[7] = Empty
    end if
  elseif MoveFlags & FlagCastleQueen then
    if Side = 0 then
      Board[59] = Board[56]
      Board[56] = Empty
    else
      Board[3] = Board[0]
      Board[0] = Empty
    end if
  end if

  if MoveFlags & FlagDoublePawn then EnPassant = (MoveFrom + MoveTo) >> 1
  if UndoPiece = WhitePawn or UndoPiece = BlackPawn or UndoCaptured <> Empty then Halfmove = 0 else Halfmove += 1
  if Side = 1 then Fullmove += 1
  Side = 1 - Side
  return

sub ChessUndoMove:
  Side = 1 - Side
  Castling = UndoCastling
  EnPassant = UndoEnPassant
  Halfmove = UndoHalfmove
  Fullmove = UndoFullmove

  if MoveFlags & FlagCastleKing then
    if Side = 0 then
      Board[63] = Board[61]
      Board[61] = Empty
    else
      Board[7] = Board[5]
      Board[5] = Empty
    end if
  elseif MoveFlags & FlagCastleQueen then
    if Side = 0 then
      Board[56] = Board[59]
      Board[59] = Empty
    else
      Board[0] = Board[3]
      Board[3] = Empty
    end if
  end if

  Board[MoveFrom] = UndoPiece
  Board[MoveTo] = Empty
  Board[UndoCapturedSquare] = UndoCaptured
  return

#ifdef CHESS_SELF_TEST
sub ChessKernelSelfTest:
  TestResult = 0
  PendingResult = 0
  MoveFrom = 17
  UndoCaptured = BlackQueen
  GenerateColumn = 6
  RayDone = 1
  WhiteKingSquare = 41
  BlackKingSquare = 22
  ChessSaveSearchFrame(SearchStack[1])
  MoveFrom = 0
  UndoCaptured = 0
  GenerateColumn = 0
  RayDone = 0
  WhiteKingSquare = 0
  BlackKingSquare = 0
  ChessRestoreSearchFrame(SearchStack[1])
  if MoveFrom = 17 and UndoCaptured = BlackQueen and GenerateColumn = 6 and RayDone = 1 and WhiteKingSquare = 41 and BlackKingSquare = 22 then TestResult += 1
  ChessInitialPosition
  MoveFrom = 52
  MoveTo = 36
  MovePromotion = 0
  MoveFlags = FlagDoublePawn
  ChessApplyMove
  if Board[36] = WhitePawn and Board[52] = Empty and EnPassant = 44 and Side = 1 then TestResult += 1
  ChessUndoMove
  if Board[52] = WhitePawn and Board[36] = Empty and EnPassant = 255 and Side = 0 then TestResult += 1

  ChessClearBoard
  Board[60] = WhiteKing
  Board[63] = WhiteRook
  Side = 0
  Castling = 3
  MoveFrom = 60
  MoveTo = 62
  MoveFlags = FlagCastleKing
  ChessApplyMove
  if Board[62] = WhiteKing and Board[61] = WhiteRook and Board[63] = Empty and Castling = 0 then TestResult += 1
  ChessUndoMove
  if Board[60] = WhiteKing and Board[63] = WhiteRook and Board[61] = Empty then TestResult += 1

  ChessClearBoard
  Board[28] = WhitePawn
  Board[27] = BlackPawn
  Side = 0
  EnPassant = 19
  MoveFrom = 28
  MoveTo = 19
  MovePromotion = 0
  MoveFlags = FlagEnPassant
  ChessApplyMove
  if Board[19] = WhitePawn and Board[27] = Empty then TestResult += 1
  ChessUndoMove
  if Board[28] = WhitePawn and Board[27] = BlackPawn and Board[19] = Empty then TestResult += 1

  ChessClearBoard
  Board[8] = WhitePawn
  Side = 0
  MoveFrom = 8
  MoveTo = 0
  MovePromotion = WhiteQueen
  MoveFlags = 0
  ChessApplyMove
  if Board[0] = WhiteQueen and Board[8] = Empty then TestResult += 1
  ChessUndoMove
  if Board[8] = WhitePawn and Board[0] = Empty then TestResult += 1

  ChessClearBoard
  AttackSquare = 28
  AttackSide = 0
  Board[35] = WhitePawn
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessClearBoard
  AttackSide = 1
  Board[21] = BlackPawn
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessClearBoard
  AttackSide = 0
  Board[11] = WhiteKnight
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessClearBoard
  Board[27] = WhiteKing
  ChessFindKings
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessClearBoard
  Board[4] = WhiteRook
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  Board[20] = BlackPawn
  ChessIsSquareAttacked
  if AttackResult = 0 then TestResult += 1

  ChessClearBoard
  Board[1] = WhiteBishop
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessClearBoard
  Board[55] = WhiteQueen
  ChessIsSquareAttacked
  if AttackResult = 1 then TestResult += 1

  ChessInitialPosition
  ChessCountPawnKnightLegalMoves
  InitialLegalCount = LegalMoveCount
  if LegalMoveCount = 20 then PendingResult += 1

  ChessClearBoard
  Board[60] = WhiteKing
  Board[52] = WhiteKnight
  Board[4] = BlackRook
  Board[0] = BlackKing
  Side = 0
  Castling = 0
  EnPassant = 255
  ChessCountPawnKnightLegalMoves
  PinnedLegalCount = LegalMoveCount
  if LegalMoveCount = 0 then PendingResult += 1

  ChessClearBoard
  Board[62] = WhiteKing
  Board[1] = BlackKing
  Board[27] = WhiteQueen
  Side = 0
  ChessCountSlidingLegalMoves
  QueenLegalCount = LegalMoveCount
  if LegalMoveCount = 27 then PendingResult += 1

  ChessClearBoard
  Board[62] = WhiteKing
  Board[1] = BlackKing
  Board[27] = WhiteRook
  Board[25] = WhitePawn
  Board[29] = BlackPawn
  Side = 0
  ChessCountSlidingLegalMoves
  RookLegalCount = LegalMoveCount
  if LegalMoveCount = 10 then PendingResult += 1

  ' FEN: k1KQ4/8/8/8/8/8/8/8 w - - 0 1
  ChessClearBoard
  Board[0] = BlackKing
  Board[2] = WhiteKing
  Board[3] = WhiteQueen
  Side = 0
  Castling = 0
  EnPassant = 255
  FenStarted = 1
  test checkpoint "fen_count_start"
  ChessCountLegalMoves
  test checkpoint "fen_count_done"
  FenFinished = 1
  FenLegalCount = LegalMoveCount
  if LegalMoveCount = 20 then PendingResult += 1
  MateSearchStarted = 1
  ChessFindMateInOne
  MateSearchFinished = 1
  FenBestMoveFrom = BestMoveFrom
  FenBestMoveTo = BestMoveTo
  FenMateMoveCount = MateMoveCount
  if MateMoveCount = 1 and BestMoveFrom = 3 and BestMoveTo = 24 then PendingResult += 1
  ChessFindPreferredMove
  PreferredMateFrom = SelectedMoveFrom
  PreferredMateTo = SelectedMoveTo
  if PreferredMateFrom = 3 and PreferredMateTo = 24 then PendingResult += 1

  ' The compact cartridge evaluator develops a knight toward the centre rather
  ' than selecting the first legal edge-pawn or knight move.
  ChessInitialPosition
  ChessFindAnySafePositionalMove
  OpeningBestFrom = SelectedMoveFrom
  OpeningBestTo = SelectedMoveTo
  OpeningSafeCount = SafeMoveCount
  if OpeningBestFrom = 57 and OpeningBestTo = 42 and OpeningSafeCount = 20 then PendingResult += 1

  ChessInitialPosition
  ChessLevel = 0
  ChessFindPreferredMove
  ChessLevel = 1
  OpeningFastFrom = SelectedMoveFrom
  OpeningFastTo = SelectedMoveTo
  if OpeningFastFrom = 57 and OpeningFastTo = 42 then PendingResult += 1

  ' BLITZ may vary only between candidates carrying the same positional score.
  ChessInitialPosition
  ChessLevel = 0
  MoveVariation = 1
  ChessFindPreferredMove
  OpeningVariantFrom = SelectedMoveFrom
  OpeningVariantTo = SelectedMoveTo
  if OpeningVariantFrom <> OpeningFastFrom or OpeningVariantTo <> OpeningFastTo then PendingResult += 1
  RequestedMoveFrom = OpeningVariantFrom
  RequestedMoveTo = OpeningVariantTo
  RequestedMovePromotion = 0
  ChessValidateRequestedMove
  if RequestedMoveLegal = 1 then PendingResult += 1
  MoveVariation = 0

  ChessInitialPosition
  MinimaxUseCutoff = 0
  MinimaxSeedEnabled = 1
  ChessFindDepthTwoMove
  OpeningMinimaxFrom = SelectedMoveFrom
  OpeningMinimaxTo = SelectedMoveTo
  OpeningFullNodes = MinimaxNodes
  OpeningFullScore = MinimaxBestScore
  ChessInitialPosition
  MinimaxUseCutoff = 1
  MinimaxSeedEnabled = 1
  ChessFindDepthTwoMove
  OpeningCutFrom = SelectedMoveFrom
  OpeningCutTo = SelectedMoveTo
  OpeningCutNodes = MinimaxNodes
  OpeningCutScore = MinimaxBestScore
  if OpeningMinimaxFrom = OpeningCutFrom and OpeningMinimaxTo = OpeningCutTo and OpeningFullScore = OpeningCutScore and OpeningCutNodes <= OpeningFullNodes and MinimaxCutoffs > 0 then PendingResult += 1

  ' Syzygy DTM 1: 5K1k/8/8/8/8/8/2R5/8 w - - 0 1, Rh2#.
  ChessClearBoard
  Board[5] = WhiteKing
  Board[7] = BlackKing
  Board[50] = WhiteRook
  Side = 0
  ChessFindMateInOne
  KrkBestMoveFrom = BestMoveFrom
  KrkBestMoveTo = BestMoveTo
  if MateMoveCount = 1 and BestMoveFrom = 50 and BestMoveTo = 55 then PendingResult += 1

  ' Syzygy DTM 1: k7/8/K7/4B3/8/8/B7/8 w - - 0 1, Bd5#.
  ChessClearBoard
  Board[0] = BlackKing
  Board[16] = WhiteKing
  Board[28] = WhiteBishop
  Board[48] = WhiteBishop
  Side = 0
  ChessFindMateInOne
  KbbkBestMoveFrom = BestMoveFrom
  KbbkBestMoveTo = BestMoveTo
  if MateMoveCount = 1 and BestMoveFrom = 48 and BestMoveTo = 27 then PendingResult += 1

  ' Syzygy DTM 1: 1B6/8/8/8/1N6/8/8/k1K5 w - - 0 1, Be5#.
  ChessClearBoard
  Board[1] = WhiteBishop
  Board[33] = WhiteKnight
  Board[56] = BlackKing
  Board[58] = WhiteKing
  Side = 0
  ChessFindMateInOne
  KbnkBestMoveFrom = BestMoveFrom
  KbnkBestMoveTo = BestMoveTo
  if MateMoveCount = 1 and BestMoveFrom = 1 and BestMoveTo = 28 then PendingResult += 1

  ' Syzygy DTM 1: k7/8/1K6/8/8/3Q4/8/8 w - - 0 1, Qd8#.
  ChessClearBoard
  Board[0] = BlackKing
  Board[17] = WhiteKing
  Board[43] = WhiteQueen
  Side = 0
  ChessFindMateInOne
  KqkBestMoveFrom = BestMoveFrom
  KqkBestMoveTo = BestMoveTo
  if MateMoveCount = 1 and BestMoveFrom = 43 and BestMoveTo = 3 then PendingResult += 1

  ' Automatic FIDE draws: KK, KBK, and KNK cannot produce checkmate.
  ChessClearBoard
  Board[0] = BlackKing
  Board[56] = WhiteKing
  ChessClassifyInsufficientMaterial
  if InsufficientMaterial = 1 then PendingResult += 1

  Board[57] = WhiteBishop
  ChessClassifyInsufficientMaterial
  if InsufficientMaterial = 1 then PendingResult += 1

  Board[57] = WhiteKnight
  ChessClassifyInsufficientMaterial
  if InsufficientMaterial = 1 then PendingResult += 1

  Board[58] = WhiteBishop
  ChessClassifyInsufficientMaterial
  if InsufficientMaterial = 0 then PendingResult += 1

  Board[58] = Empty
  Board[57] = WhiteBishop
  Board[43] = BlackBishop
  ChessClassifyInsufficientMaterial
  if InsufficientMaterial = 1 then PendingResult += 1

  ' Wikipedia KPK rule-one exception. d7 is the sole tablebase win.
  ChessClearBoard
  Board[3] = BlackKing
  Board[18] = WhiteKing
  Board[19] = WhitePawn
  Side = 0
  ChessFindPromotionApproachMoves
  KpkBestMoveFrom = BestMoveFrom
  KpkBestMoveTo = BestMoveTo
  if PromotionApproachCount = 1 and BestMoveFrom = 19 and BestMoveTo = 11 then PendingResult += 1

  ' Wikipedia: Kc5 is the sole tablebase win by reaching a key square.
  ChessClearBoard
  Board[20] = BlackKing
  Board[34] = WhitePawn
  Board[35] = WhiteKing
  Side = 0
  ChessFindWhiteKeySquareMove
  if KeyBestScore = 1 and KeyBestMoveFrom = 35 and KeyBestMoveTo = 26 then PendingResult += 1

  ' Horizon fixture: Rxa8+ is legal but Black can answer Kxa8.
  ChessClearBoard
  Board[0] = BlackRook
  Board[1] = BlackKing
  Board[56] = WhiteRook
  Board[63] = WhiteKing
  Side = 0
  ChessFindLegalCaptures
  HorizonCaptureFrom = CaptureBestMoveFrom
  HorizonCaptureTo = CaptureBestMoveTo
  if CaptureMoveCount = 1 and CaptureBestMoveFrom = 56 and CaptureBestMoveTo = 0 then PendingResult += 1

  ChessEvaluateForcedCaptureExchange
  if ExchangeStaticBalance = 500 and ExchangeQuietBalance = 0 and ExchangeReplyCount = 1 then PendingResult += 1
  if Board[0] = BlackRook and Board[1] = BlackKing and Board[56] = WhiteRook and Board[63] = WhiteKing and Side = 0 then PendingResult += 1

  ' The targeted recapture probe tests only geometrical short-range attackers,
  ' validates king safety, scores the capture and restores the board.
  ChessClearBoard
  Board[0] = BlackKing
  Board[36] = BlackRook
  Board[53] = WhiteKnight
  Board[63] = WhiteKing
  Side = 0
  ChessFindKings
  RecaptureTarget = 36
  RecaptureBestScore = -180
  MinimaxRootSide = 0
  LegalMoveCount = 0
  ChessFindShortRangeRecaptures
  RecaptureTestResult = 0
  if RecaptureBestScore > -180 then RecaptureTestResult += 1
  if LegalMoveCount = 1 then RecaptureTestResult += 2
  if Board[36] = BlackRook and Board[53] = WhiteKnight then RecaptureTestResult += 4
  if Side = 0 then RecaptureTestResult += 8
  if RecaptureTestResult = 15 then PendingResult += 1

  ' All four FIDE promotion choices are distinct legal moves.
  ChessClearBoard
  Board[4] = BlackKing
  Board[8] = WhitePawn
  Board[60] = WhiteKing
  Side = 0
  ChessCountLegalMoves
  PromotionLegalCount = LegalMoveCount
  if PromotionLegalCount = 9 then PendingResult += 1

  ChessRunDeterministicSelfPlay

  ' Both white castling moves are legal on an otherwise empty back rank.
  ChessClearBoard
  Board[4] = BlackKing
  Board[56] = WhiteRook
  Board[60] = WhiteKing
  Board[63] = WhiteRook
  Side = 0
  Castling = 3
  ChessCountLegalMoves
  CastleOpenCount = LegalMoveCount
  if CastleOpenCount = 26 then PendingResult += 1

  ' A rook attacking f1 forbids O-O but must not forbid O-O-O.
  Board[5] = BlackRook
  ChessCountLegalMoves
  CastleTransitCount = LegalMoveCount
  if CastleTransitCount = 23 then PendingResult += 1

  ' Two reversible knight cycles create a threefold claim; four make the
  ' fifth occurrence an automatic FIDE draw.
  ChessInitialPosition
  ChessResetRepetitionHistory
  for RepetitionCycle = 1 to 2
    MoveFrom = 62
    MoveTo = 45
    MoveFlags = 0
    MovePromotion = 0
    ChessCommitMove
    MoveFrom = 6
    MoveTo = 21
    ChessCommitMove
    MoveFrom = 45
    MoveTo = 62
    ChessCommitMove
    MoveFrom = 21
    MoveTo = 6
    ChessCommitMove
  next
  ChessClassifyRepetition
  RepetitionThreeTest = RepetitionCount
  if RepetitionCount = 3 and CanClaimThreefold = 1 and AutomaticFivefold = 0 then PendingResult += 1
  for RepetitionCycle = 1 to 2
    MoveFrom = 62
    MoveTo = 45
    ChessCommitMove
    MoveFrom = 6
    MoveTo = 21
    ChessCommitMove
    MoveFrom = 45
    MoveTo = 62
    ChessCommitMove
    MoveFrom = 21
    MoveTo = 6
    ChessCommitMove
  next
  ChessClassifyRepetition
  RepetitionFiveTest = RepetitionCount
  if RepetitionCount = 5 and CanClaimThreefold = 1 and AutomaticFivefold = 1 then PendingResult += 1

  ' A player may claim before announcing the move that creates occurrence 3.
  ChessInitialPosition
  ChessResetRepetitionHistory
  MoveFrom = 62
  MoveTo = 45
  MoveFlags = 0
  MovePromotion = 0
  ChessCommitMove
  MoveFrom = 6
  MoveTo = 21
  ChessCommitMove
  MoveFrom = 45
  MoveTo = 62
  ChessCommitMove
  MoveFrom = 21
  MoveTo = 6
  ChessCommitMove
  MoveFrom = 62
  MoveTo = 45
  ChessCommitMove
  MoveFrom = 6
  MoveTo = 21
  ChessCommitMove
  MoveFrom = 45
  MoveTo = 62
  ChessCommitMove
  MoveFrom = 21
  MoveTo = 6
  ChessClassifyAnnouncedMove
  AnnouncedThreefoldTest = AnnouncedThreefold
  if AnnouncedThreefold = 1 and AnnouncedRepetitionCount = 3 and Board[21] = BlackKnight and Board[6] = Empty and Side = 1 then PendingResult += 1

  ' The same prospective operation recognizes the announced 100th halfmove.
  ChessClearBoard
  Board[4] = BlackKing
  Board[56] = WhiteRook
  Board[60] = WhiteKing
  Side = 0
  Castling = 0
  EnPassant = 255
  Halfmove = 99
  ChessResetRepetitionHistory
  MoveFrom = 56
  MoveTo = 57
  MoveFlags = 0
  MovePromotion = 0
  ChessClassifyAnnouncedMove
  AnnouncedFiftyMoveTest = AnnouncedFiftyMove
  if AnnouncedFiftyMove = 1 and Halfmove = 99 and Board[56] = WhiteRook and Board[57] = Empty and Side = 0 then PendingResult += 1

  Halfmove = 99
  ChessClassifyMoveCountDraw
  if CanClaimFiftyMove = 0 and AutomaticSeventyFiveMove = 0 then PendingResult += 1
  Halfmove = 100
  ChessClassifyMoveCountDraw
  if CanClaimFiftyMove = 1 and AutomaticSeventyFiveMove = 0 then PendingResult += 1
  Halfmove = 149
  ChessClassifyMoveCountDraw
  if CanClaimFiftyMove = 1 and AutomaticSeventyFiveMove = 0 then PendingResult += 1
  Halfmove = 150
  ChessClassifyMoveCountDraw
  if CanClaimFiftyMove = 1 and AutomaticSeventyFiveMove = 1 then PendingResult += 1

  ChessClearBoard
  Board[4] = BlackKing
  Board[60] = WhiteKing
  Board[63] = WhiteRook
  Side = 0
  Castling = 1
  EnPassant = 255
  RequestedMoveFrom = 60
  RequestedMoveTo = 62
  RequestedMovePromotion = 0
  ChessValidateRequestedMove
  if RequestedMoveLegal = 1 and RequestedMoveFlags = FlagCastleKing then PendingResult += 1

  ChessClearBoard
  Board[4] = BlackKing
  Board[60] = WhiteKing
  Board[28] = WhitePawn
  Board[27] = BlackPawn
  Side = 0
  Castling = 0
  EnPassant = 19
  RequestedMoveFrom = 28
  RequestedMoveTo = 19
  RequestedMovePromotion = 0
  ChessValidateRequestedMove
  if RequestedMoveLegal = 1 and RequestedMoveFlags = FlagEnPassant then PendingResult += 1

  ChessClearBoard
  Board[7] = BlackKing
  Board[56] = WhiteKing
  Board[8] = WhitePawn
  Side = 0
  Castling = 0
  EnPassant = 255
  RequestedMoveFrom = 8
  RequestedMoveTo = 0
  RequestedMovePromotion = WhiteQueen
  ChessValidateRequestedMove
  if RequestedMoveLegal = 1 and RequestedMoveFlags = 0 then PendingResult += 1

  ' Nested safety search must restore king locations before testing the next root move.
  ChessClearBoard
  Board[0] = BlackRook
  Board[4] = BlackKing
  Board[7] = BlackRook
  Board[8] = BlackPawn
  Board[9] = BlackPawn
  Board[10] = BlackPawn
  for I = 12 to 15
    Board[I] = BlackPawn
  next
  Board[48] = WhiteKing
  Board[50] = BlackQueen
  Board[52] = WhitePawn
  Board[54] = WhitePawn
  Board[55] = WhitePawn
  Board[61] = WhiteBishop
  Board[63] = WhiteRook
  Side = 0
  Castling = 12
  EnPassant = 255
  Halfmove = 2
  Fullmove = 18
  ChessLevel = 1
  ChessFindSafePositionalMove
  if SelectedMoveFrom = 48 and (SelectedMoveTo = 40 or SelectedMoveTo = 56) then PendingResult += 1

  ' Preserve the original externally inspected completion fixture.
  ChessClearBoard
  Board[8] = WhitePawn
  Side = 0
  Castling = 3
  EnPassant = 19
  TestResult += PendingResult
  return
#endif
