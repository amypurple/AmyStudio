  EnPassant = 255
  Halfmove = 10
  Fullmove = 9
  ChessLevel = 1
  ChessFindKings
  ChessFindPreferredMove
  SkilledQueenTestFrom = SelectedMoveFrom
  SkilledQueenTestTo = SelectedMoveTo

  ' Pawn advancement must become more valuable near promotion.
  ChessClearBoard
  Board[4] = BlackKing
  Board[51] = WhitePawn
  Board[60] = WhiteKing
  Side = 0
  ChessFindKings
  MovingSide = 0
  ChessEvaluatePosition
