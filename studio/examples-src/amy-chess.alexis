  Board[28] = BlackRook
  Board[29] = BlackPawn
  Board[35] = BlackPawn
  Board[39] = BlackPawn
  Board[46] = BlackQueen
  Board[47] = WhitePawn
  Board[50] = WhiteRook
  Board[54] = WhitePawn
  Board[62] = WhiteKing
  Side = 0
  Castling = 0
  EnPassant = 255
  Halfmove = 0
  Fullmove = 49
  ChessLevel = 2
  ChessFindKings
  ChessFindPreferredMove
  ExpertMateSafetyFrom = SelectedMoveFrom
  ExpertMateSafetyTo = SelectedMoveTo
  MoveFrom = SelectedMoveFrom
  MoveTo = SelectedMoveTo
  MoveFlags = SelectedMoveFlags
  MovePromotion = SelectedMovePromotion
  MovingSide = Side
  ChessApplyMove
  ChessFindMateInOne
  ExpertMateReplyCount = MateMoveCount
  ExpertMateReplyFrom = BestMoveFrom
  ExpertMateReplyTo = BestMoveTo
  RequestedMoveFrom = 46
  RequestedMoveTo = 60
  RequestedMovePromotion = 0
  ChessValidateRequestedMove
  ExpertMateQueenLegal = RequestedMoveLegal

  ' r2qkb1r/ppp1pppp/2n1bn2/2Bp4/8/2NPQN2/PPP1PPPP/2KR1B1R w k - 10 9
  ChessClearBoard
  Board[0] = BlackRook
  Board[3] = BlackQueen
  Board[4] = BlackKing
  Board[5] = BlackBishop
  Board[7] = BlackRook
  Board[8] = BlackPawn
  Board[9] = BlackPawn
