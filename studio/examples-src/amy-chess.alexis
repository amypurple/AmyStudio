#ifdef CHESS_EXPERT_HANG_TEST
sub ChessExpertHangTest:
  ChessClearBoard
  Board[0] = BlackRook
  Board[4] = BlackKing
  Board[5] = BlackKnight
  Board[7] = BlackRook
  Board[12] = BlackKnight
  Board[16] = BlackPawn
