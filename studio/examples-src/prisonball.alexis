cartridge "PRISONBALL/JOHN SCARBOROUGH/1986"

' PRISONBALL
' Based on "Prisonball" by John Scarborough, COMPUTE! October 1986 (pages
' 38-49; the Atari original, the Commodore 64 version by Kevin Mykytyn,
' the Apple II version by Tim Victor). Made for the ColecoVision in Amy
' (the language by Amy Bienvenu) by Claude (an AI made by Anthropic) for
' Amy Studio, 2026.
'
' Not a line-for-line port: the three listings are machine code in DATA
' lines, so this is a ColecoVision game built on the article's rules
' (orig/ has the scans).
' Kept from the article: two players, each with two paddles on their own
' side (red on the left, blue on the right); five brick walls running
' down the middle; three balls, neutral (white) at the start; a ball you
' hit takes your colour; you can only hit a ball coming toward your
' paddles (one going away passes through them); a ball you miss wraps
' round to the other side; every ball that meets a wall knocks out the
' brick it hits, and scores for its colour's player: 30 for the centre
' wall, 20 for the two next to it, 10 for the two outer walls (the
' Commodore 64 and Apple values); a wall knocked out completely is built
' again at once, so a ball can be trapped between two walls and score
' many times; a countdown (3 minutes as on the 64 and Apple, or the
' Atari's 5), the border flashing in the last 20 seconds; the higher
' score wins.
' Made for this machine: the yard fills the screen inside the overscan;
' the walls are brick tiles, one colour per pair of walls; the balls and
' paddles are sprites moving every frame (60 a second), the balls in
' 1/16 pixel steps, exact against each brick; where a ball meets a paddle
' sets its angle (6 zones); the balls speed up every 40 seconds; a
' computer opponent can play blue; a note per wall (pitched by its
' value), a knock for neutral balls, the paddles and the warning beeps on
' their own channels; "Yard Time" quietly under play (music first in the
' sound table), an original title tune, "Cell Block Shuffle".
'
' Controls: up and down move your two paddles together (as one paddle
' knob moved both on the Atari): red on joystick 1, blue on joystick 2
' (against the computer either joystick moves red); the button starts.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TWol = 128
const TWor = 129
const TWml = 130
const TWmr = 131
const TWcl = 132
const TWcr = 133
const TKwo = 134
const TKwm = 135
const TKwc = 136
const TRailt = 137
const TRailb = 138
const SBall = 0
const SPad = 4
const NTiles8 = 88
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndYardA = 3
const SndYardB = 4
const SndKnock = 5
const SndWo = 6
const SndWm = 7
const SndWc = 8
const SndBuild = 9
const SndPad = 10
const SndGo = 11
const SndBeep = 12
const SndEnd = 13

' the ball being moved: Xs, Ys its place in 1/16 pixels; Dx 0 right /
' 1 left, Dy 0 down / 1 up; Ang 0 flat .. 2 steep; Own 0 neutral, 1 red,
' 2 blue; Vx, Vy its speed now; Bxp, Byp its place in pixels
u16 Xs = 0
u16 Ys = 0
u8 Dx = 0
u8 Dy = 0
u8 Ang = 0
u8 Own = 0
u8 Vx = 0
u8 Vy = 0
u8 Bxp = 0
u8 Byp = 0
' the three balls, kept here between moves
u16 BX[3]
u16 BY[3]
u8 BDx[3]
u8 BDy[3]
u8 BAng[3]
u8 BOwn[3]
' the paddles: the top of each side's upper paddle (24-88); the lower one
' is 80 pixels further down
u8 P1y = 56
u8 P2y = 56
u16 Sc1 = 0
u16 Sc2 = 0
' the walls: Br[wall * 20 + row] 1 while the brick is there; WLeft counts
u8 Br[100]
u8 WLeft[5]
' Lv the speed level (0-3); Tsec the seconds left, Tfr the frames of this
' second, El the seconds played
u8 Lv = 0
u16 Tsec = 0
u8 Tfr = 0
u16 El = 0
' Ph: 1 waiting to start, 2 in play, 3 game over
u8 Ph = 0
u8 Idle = 0
' the menu: Cpu 1 = blue is the computer; Mins 3 or 5
u8 Cpu = 1
u8 Mins = 3
u8 Item = 0

' hits: Hk the brick met (255 none), its wall Wl and row Rr; Qx, Qy the
' point looked at; Pt, Who the paddle side being tried
u8 Hk = 0
u8 Wl = 0
u8 Rr = 0
u8 Qx = 0
u8 Qy = 0
u8 Pt = 0
u8 Who = 0
u8 Hp = 0
u8 Tp = 0
u8 Zn = 0
u8 Best = 0
u8 Bm = 0
u8 Tg = 0
u8 Cx = 0
u8 Cy = 0
u8 Ok = 0
u8 Nb = 0
u8 Mm = 0
u8 Rot = 0
u8 Sl = 0

u16 NumU = 0
u8 U1 = 0
u8 D1 = 0
u8 U2 = 0
u8 D2 = 0
u8 Lf = 0
u8 Rt = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table PbSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Item = 3 then
    CreditsPage
    goto title
  end if

new_game:
  Sc1 = 0
  Sc2 = 0
  P1y = 56
  P2y = 56
  Lv = 0
  El = 0
  Tfr = 0
  Tsec = Mins * 60
  NewWalls
  DrawField
  DrawWalls
  ShowHud
  ShowTime
  ' the three balls: in the outer yards, neutral, going toward the walls
  for I = 0 to 2
    V = random(0, 1)
    if V = 0 then
      BX[I] = 640
      BDx[I] = 0
    else
      BX[I] = 3328
      BDx[I] = 1
    end if
    V = random(32, 168)
    NumU = V
    NumU = NumU << 4
    BY[I] = NumU
    V = random(0, 1)
    BDy[I] = V
    V = random(0, 2)
    BAng[I] = V
    BOwn[I] = 0
  next
  ShowScreen
  Ph = 1
  print at 10,12, " PRESS FIRE "
  DrawSprites
  WasBtn = 1
start_loop:
  Frame1
  ReadPad
  if Press = 0 then goto start_loop
  ' the walls under the message again
  print at 10,12, "            "
  DrawWalls
  play sound SndGo
  play song PbYardSong
  Ph = 2

play_loop:
  Frame1
  ReadPad
  MovePads
  for I = 0 to 2
    MoveBall
  next
  DrawSprites
  Clock
  if Tsec = 0 then goto game_over
  goto play_loop

game_over:
  Ph = 3
  stop song
  backdrop black
  HideSprites
  play sound SndEnd
  print at 9,11, "              "
  print at 9,13, "              "
  if Sc1 > Sc2 then
    print at 9,12, "  RED  WINS!  "
  end if
  if Sc2 > Sc1 then
    print at 9,12, "  BLUE WINS!  "
  end if
  if Sc1 = Sc2 then
    print at 9,12, "   A  TIE!    "
  end if
  for Tm = 1 to 120
    Frame1
  next
  WasBtn = 1
over_wait:
  Frame1
  ReadPad
  if Press = 0 then goto over_wait
  goto title

' ---------------------------------------------------------------------------

' MoveBall: ball I across (bricks, paddles, the wrap), then up or down
' (the rails, bricks)
sub MoveBall:
  Xs = BX[I]
  Ys = BY[I]
  Dx = BDx[I]
  Dy = BDy[I]
  Ang = BAng[I]
  Own = BOwn[I]
  V = Lv * 3
  V = V + Ang
  Vx = Vxt[V]
  Vy = Vyt[V]
  ' across
  if Dx = 0 then
    Xs = Xs + Vx
  else
    Xs = Xs - Vx
  end if
  Bxp = Xs >> 4
  Byp = Ys >> 4
  Qx = Bxp
  if Dx = 0 then Qx = Bxp + 3
  Qy = Byp
  BrickAt
  if Hk = 255 then
    Qy = Byp + 3
    BrickAt
  end if
  if Hk < 255 then
    HitBrick
    if Dx = 0 then
      Xs = Xs - Vx
      Dx = 1
    else
      Xs = Xs + Vx
      Dx = 0
    end if
    Bxp = Xs >> 4
  end if
  ' the paddles: red's only hit balls going left, blue's going right
  if Dx = 1 then
    if Bxp >= 15 then
      if Bxp <= 21 then
        Pt = P1y
        Who = 1
        PadHit
      end if
    end if
  else
    if Bxp >= 231 then
      if Bxp <= 237 then
        Pt = P2y
        Who = 2
        PadHit
      end if
    end if
  end if
  ' missed: round to the other side
  if Dx = 1 then
    if Bxp < 10 then Xs = 3872
  else
    if Bxp > 242 then Xs = 160
  end if
  Bxp = Xs >> 4
  ' up or down
  if Dy = 0 then
    Ys = Ys + Vy
  else
    Ys = Ys - Vy
  end if
  Byp = Ys >> 4
  if Byp < 24 then
    Ys = 384
    Dy = 0
    Byp = 24
  end if
  if Byp > 180 then
    Ys = 2880
    Dy = 1
    Byp = 180
  end if
  Qy = Byp
  if Dy = 0 then Qy = Byp + 3
  Qx = Bxp
  BrickAt
  if Hk = 255 then
    Qx = Bxp + 3
    BrickAt
  end if
  if Hk < 255 then
    HitBrick
    if Dy = 0 then
      Ys = Ys - Vy
      Dy = 1
    else
      Ys = Ys + Vy
      Dy = 0
    end if
  end if
  BX[I] = Xs
  BY[I] = Ys
  BDx[I] = Dx
  BDy[I] = Dy
  BAng[I] = Ang
  BOwn[I] = Own
  return
end sub

' PadHit: does the ball meet side Who's upper paddle (top Pt) or lower
' one (Pt + 80)? Then it bounces, takes the side's colour, and where it
' met (0-17 from the paddle's top) sets its angle
sub PadHit:
  Hp = 0
  Tp = Pt
  V = Byp + 3
  if V >= Tp then
    W = Tp + 15
    if Byp <= W then Hp = 1
  end if
  if Hp = 0 then
    Tp = Pt + 80
    if V >= Tp then
      W = Tp + 15
      if Byp <= W then Hp = 1
    end if
  end if
  if Hp = 0 then return
  V = Byp + 2
  if V < Tp then
    N = 0
  else
    N = V - Tp
    if N > 17 then N = 17
  end if
  Zn = Zone[N]
  if Zn < 3 then
    Dy = 1
    Ang = 2 - Zn
  else
    Dy = 0
    Ang = Zn - 3
  end if
  if Who = 1 then
    Dx = 0
    Xs = 352
    Own = 1
  else
    Dx = 1
    Xs = 3680
    Own = 2
  end if
  Bxp = Xs >> 4
  play sound SndPad
  return
end sub

' BrickAt: the brick under the point Qx,Qy (Hk = its number, 255 none;
' Wl its wall, Rr its row). Wall w covers x 56 + 32w to 71 + 32w.
sub BrickAt:
  Hk = 255
  if Qy < 24 then return
  if Qy >= 184 then return
  if Qx < 56 then return
  V = Qx - 56
  if V >= 144 then return
  W = V & 31
  if W >= 16 then return
  Wl = V >> 5
  Rr = Qy - 24
  Rr = Rr >> 3
  K = Wl * 20
  K = K + Rr
  if Br[K] = 1 then Hk = K
  return
end sub

' HitBrick: brick Hk goes; the ball's player scores the wall's points; a
' wall with no brick left is built again
sub HitBrick:
  Br[Hk] = 0
  X = Wl * 4
  X = X + 7
  Y = Rr + 3
  put char 32 at X,Y
  inc X
  put char 32 at X,Y
  V = WLeft[Wl]
  dec V
  WLeft[Wl] = V
  if Own = 0 then
    play sound SndKnock
  else
    V = WallPts[Wl]
    if Own = 1 then
      Sc1 = Sc1 + V
    else
      Sc2 = Sc2 + V
    end if
    ShowScores
    if Wl = 2 then
      play sound SndWc
    else
      if Wl = 1 then
        play sound SndWm
      else
        if Wl = 3 then
          play sound SndWm
        else
          play sound SndWo
        end if
      end if
    end if
  end if
  if WLeft[Wl] = 0 then Rebuild
  return
end sub

' Rebuild: wall Wl again, every brick but those a ball is in (the ball
' being moved is at Xs, Ys; the others at BX, BY)
sub Rebuild:
  Nb = 0
  X = Wl * 4
  X = X + 7
  V = WallKind[Wl]
  V = V << 1
  N = V + TWol
  for Rr = 0 to 19
    Cx = Wl << 5
    Cx = Cx + 56
    Cy = Rr << 3
    Cy = Cy + 24
    Ok = 1
    for J = 0 to 2
      if J = I then
        Qx = Xs >> 4
        Qy = Ys >> 4
      else
        NumU = BX[J]
        NumU = NumU >> 4
        Qx = NumU
        NumU = BY[J]
        NumU = NumU >> 4
        Qy = NumU
      end if
      V = Qx + 3
      if V >= Cx then
        W = Cx + 15
        if Qx <= W then
          V = Qy + 3
          if V >= Cy then
            W = Cy + 7
            if Qy <= W then Ok = 0
          end if
        end if
      end if
    next
    if Ok = 1 then
      K = Wl * 20
      K = K + Rr
      Br[K] = 1
      inc Nb
      Y = Rr + 3
      put char N at X,Y
      W = X + 1
      V = N + 1
      put char V at W,Y
    end if
  next
  WLeft[Wl] = Nb
  play sound SndBuild
  return
end sub

' MovePads: red from joystick 1, blue from joystick 2 or the computer
sub MovePads:
  if U1 = 1 then
    if P1y >= 27 then
      P1y = P1y - 3
    else
      P1y = 24
    end if
  end if
  if D1 = 1 then
    if P1y <= 85 then
      P1y = P1y + 3
    else
      P1y = 88
    end if
  end if
  if Cpu = 1 then
    CpuMove
    return
  end if
  if U2 = 1 then
    if P2y >= 27 then
      P2y = P2y - 3
    else
      P2y = 24
    end if
  end if
  if D2 = 1 then
    if P2y <= 85 then
      P2y = P2y + 3
    else
      P2y = 88
    end if
  end if
  return
end sub

' CpuMove: blue follows the ball coming its way nearest to it (past the
' centre wall), with whichever paddle is nearer; otherwise it waits in
' the middle; 2 pixels a frame (red moves 3)
sub CpuMove:
  Best = 255
  Bm = 135
  for J = 0 to 2
    if BDx[J] = 0 then
      NumU = BX[J]
      NumU = NumU >> 4
      V = NumU
      if V > Bm then
        Bm = V
        Best = J
      end if
    end if
  next
  Tg = 56
  if Best < 255 then
    NumU = BY[Best]
    NumU = NumU >> 4
    V = NumU
    W = P2y + 48
    if V < W then
      if V < 30 then
        Tg = 24
      else
        Tg = V - 6
      end if
    else
      if V < 110 then
        Tg = 24
      else
        Tg = V - 86
      end if
    end if
    if Tg > 88 then Tg = 88
  end if
  if P2y < Tg then
    P2y = P2y + 2
    if P2y > Tg then P2y = Tg
  else
    if P2y > Tg then
      P2y = P2y - 2
      if P2y < Tg then P2y = Tg
    end if
  end if
  return
end sub

' Clock: a second gone every 60 frames; faster every 40 seconds; the last
' 20 seconds beep and flash the border
sub Clock:
  inc Tfr
  ' (photosensitivity: one slow pulse a second, half on and half off,
  ' well under the 3 flashes a second limit; it was about 4 a second)
  if Tsec <= 20 then
    V = Tsec & 1
    if V = 0 then
      backdrop black
    else
      backdrop dark red
    end if
  end if
  if Tfr < 60 then return
  Tfr = 0
  dec Tsec
  inc El
  Lv = 0
  if El >= 40 then Lv = 1
  if El >= 80 then Lv = 2
  if El >= 120 then Lv = 3
  ShowTime
  if Tsec <= 20 then
    if Tsec > 0 then play sound SndBeep
  end if
  return
end sub

' DrawSprites: the four paddles (0-3) first; the balls take turns in
' sprites 4-6 so on a crowded line they flicker instead of vanishing
sub DrawSprites:
  V = P1y - 1
  set sprite 0 to V,18,SPad,9
  V = V + 80
  set sprite 1 to V,18,SPad,9
  V = P2y - 1
  set sprite 2 to V,234,SPad,5
  V = V + 80
  set sprite 3 to V,234,SPad,5
  inc Rot
  if Rot >= 3 then Rot = 0
  for J = 0 to 2
    Sl = J + Rot
    if Sl >= 3 then Sl = Sl - 3
    Sl = Sl + 4
    NumU = BX[J]
    NumU = NumU >> 4
    X = NumU
    NumU = BY[J]
    NumU = NumU >> 4
    Y = NumU
    dec Y
    V = BOwn[J]
    W = OwnCol[V]
    set sprite Sl to Y,X,SBall,W
  next
  update sprites
  return
end sub

sub NewWalls:
  for J = 0 to 99
    Br[J] = 1
  next
  for J = 0 to 4
    WLeft[J] = 20
  next
  return
end sub

sub DrawWalls:
  for J = 0 to 4
    X = J * 4
    X = X + 7
    V = WallKind[J]
    V = V << 1
    N = V + TWol
    W = N + 1
    K = J * 20
    for Y = 3 to 22
      if Br[K] = 1 then
        put char N at X,Y
        inc X
        put char W at X,Y
        dec X
      else
        put char 32 at X,Y
        inc X
        put char 32 at X,Y
        dec X
      end if
      inc K
    next
  next
  return
end sub

' the yard: the rails above (row 2) and below (row 23)
sub DrawField:
  NewScreen
  for X = 1 to 30
    put char TRailt at X,2
    put char TRailb at X,23
  next
  return
end sub

sub ShowHud:
  print at 2,1, "RED"
  print at 25,1, "BLUE"
  ShowScores
  return
end sub

sub ShowScores:
  NumU = Sc1
  print at 6,1, digits$(NumU, 5)
  NumU = Sc2
  print at 19,1, digits$(NumU, 5)
  return
end sub

sub ShowTime:
  Mm = 0
  NumU = Tsec
  while NumU >= 60
    NumU = NumU - 60
    inc Mm
  end while
  V = NumU
  NumU = Mm
  print at 13,1, digits$(NumU, 1)
  print at 14,1, ":"
  NumU = V
  print at 15,1, digits$(NumU, 2)
  return
end sub

' one frame: the NMI runs during the wait, then stays off
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadPad:
  U1 = 0
  D1 = 0
  U2 = 0
  D2 = 0
  Lf = 0
  Rt = 0
  Btn = 0
  if joypad(1).up then U1 = 1
  if joypad(1).down then D1 = 1
  if joypad(2).up then U2 = 1
  if joypad(2).down then D2 = 1
  if joypad(1).left then Lf = 1
  if joypad(2).left then Lf = 1
  if joypad(1).right then Rt = 1
  if joypad(2).right then Rt = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if Cpu = 1 then
    ' against the computer either joystick moves red
    V = U1 | U2
    U1 = V
    V = D1 | D2
    D1 = V
  end if
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 7
  for J = 0 to 6
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: PRISON over BALL in brick blocks, a joystick menu
sub TitlePage:
  NewScreen
  K = 0
  for Y = 0 to 9
    V = Y
    if V >= 5 then V = V - 5
    N = TKwo
    if V = 2 then N = TKwc
    if V = 1 then N = TKwm
    if V = 3 then N = TKwm
    W = Y + 2
    if Y >= 5 then W = Y + 3
    for X = 5 to 27
      if Dots[K] = 1 then put char N at X,W
      inc K
    next
  next
  print at 4,15, "KNOCK THE BRICKS OUT!"
  print at 10,17, "START"
  print at 10,18, "PLAYERS"
  print at 10,19, "TIME"
  print at 10,20, "CREDITS"
  print at 3,22, "WARNING: THE SCREEN FLASHES"
  ShowMenu
  ShowScreen
  play song PbTitleSong once
  Item = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadPad
  V = U1 | U2
  W = D1 | D2
  N = V | W
  N = N | Lf
  N = N | Rt
  if N = 1 then
    if WasStick = 0 then
      if V = 1 then
        if Item > 0 then dec Item
      end if
      if W = 1 then
        if Item < 3 then inc Item
      end if
      V = Lf | Rt
      if V = 1 then
        if Item = 1 then Cpu = Cpu ^ 1
        if Item = 2 then
          if Mins = 3 then
            Mins = 5
          else
            Mins = 3
          end if
        end if
      end if
      ShowMenu
    end if
  end if
  WasStick = N
  if Press = 0 then goto tp_loop
  if Item = 1 then goto tp_loop
  if Item = 2 then goto tp_loop
  stop song
  mute all
  return
end sub

sub ShowMenu:
  for J = 17 to 20
    put char 32 at 8,J
  next
  V = Item + 17
  put char 62 at 8,V
  if Cpu = 1 then
    print at 18,18, "1 VS CPU"
  else
    print at 18,18, "2       "
  end if
  NumU = Mins
  print at 18,19, digits$(NumU, 1)
  print at 20,19, "MINUTES"
  return
end sub

sub CreditsPage:
  NewScreen
  for X = 3 to 28
    V = X & 1
    V = V + TKwo
    put char V at X,2
    put char V at X,21
  next
  print at 11,4, "PRISONBALL"
  print at 4,6, "BASED ON PRISONBALL BY"
  print at 4,7, "JOHN SCARBOROUGH, COMPUTE!"
  print at 4,8, "OCTOBER 1986 (ATARI; 64 BY"
  print at 4,9, "KEVIN MYKYTYN, APPLE BY"
  print at 4,10, "TIM VICTOR)."
  print at 4,12, "MADE FOR THE COLECOVISION"
  print at 4,13, "BY CLAUDE (AN AI MADE BY"
  print at 4,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 4,15, "2026, IN AMY BY AMY"
  print at 4,16, "BIENVENU."
  print at 4,18, "MUSIC: CELL BLOCK SHUFFLE"
  print at 11,19, "AND YARD TIME"
  print at 3,20, "WARNING: THE SCREEN FLASHES"
  print at 4,21, "RED IN THE LAST 20 SECONDS"
  print at 9,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

