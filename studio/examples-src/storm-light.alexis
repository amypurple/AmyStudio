' --- the world -------------------------------------------------------------
' Oil your lantern's oil (0-128), LanOn its shutter; OilT passes to the
' next drop; LampLit bit i = wall lamp i lit; BLit the beacon, BFuel its
' oil (passes); ShipT the ship's way in (passes), ShipDur its whole way,
' ShipsLeft tonight, Buoys the wrecks you may still suffer (3); GustT the
' next gust; FogLv/FogTo/FogT the fog; KeyAt the hook with the key (255
' none), KeyHeld, DoorOpen
u8 Oil = 0
u8 LanOn = 0
u8 OilT = 0
u8 LampLit = 0
u8 BLit = 0
u16 BFuel = 0
u16 ShipT = 0
u16 ShipDur = 0
u8 ShipsLeft = 0
u8 Stage = 0
u8 Buoys = 0
u16 GustT = 0
u16 GustBase = 0
u8 BOdds = 0
u8 FogLv = 0
u8 FogTo = 0
u8 FogT = 0
u8 FogMax = 0
u8 KeyAt = 0
u8 KeyHeld = 0
u8 DoorOpen = 0
u8 Flash = 0
u8 Gusted = 0
u8 Event = 0
u8 Saved = 0
u8 Wrecked = 0
u8 HitSlot = 0
u8 ClimbTo = 0
u8 WinShown = 0
u8 SkyShown = 0
u8 InPlay = 0
u8 LastStage = 0
u8 Ci = 0
u8 Fm = 0
u8 ShownFm = 255

' --- the game --------------------------------------------------------------
u16 Score = 0
u16 NightT = 0
u16 ShownScore = 0
u8 Night = 0
u8 MsgT = 0
u8 HudKey = 0
u8 HOil = 0
u8 HLamps = 0
u8 HBeac = 0
u8 HShip = 0
u8 Tick = 0
u8 Idle = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u16 Waited = 0

i16 Dx = 0
i16 Dy = 0
i16 Cx = 0
u16 Nx = 0
u16 Ny = 0
u16 NumU = 0
u16 V16 = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Rw = 0
u16 Wsrc = 0
u16 Wdst = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Edge = 0
u8 WasJ = 0
u8 Jk = 0

  mode 2 screen
  sprites 16x16
  sprites double
  set sound table LhSoundTable areas 8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  ' a new game
  Score = 0
  Night = 1
  Buoys = 3

night_loop:
  NightIntro
  NewNight
  State = StPlay
  GameTune
  call asm StPoll
  VbMiss = 0
  FrPass = 0

walk:
  ReadPad
  ' the button: the thing you face (close by), else the lantern's shutter
  if Press = 1 then Act
  if Lf1 = 1 then Ang = Ang - 4
  if Rt1 = 1 then Ang = Ang + 4
  HitSlot = 255
  if Up1 = 1 then Advance(24, 0)
  if Dn1 = 1 then Advance(16, 1)
  World
  ' the rules of this pass are done (the bots read the state here)
  inc Tick
  if HitSlot <> 255 then
    StairsAt(HitSlot)
    if ClimbTo <> 255 then
      Climb
      if Buoys = 0 then goto game_over
      if ShipsLeft = 0 then goto dawn
      goto walk
    end if
  end if
  ' the view
  Prof = 1
  call asm StRays
  Prof = 2
  call asm StDraw
  Prof = 3
  WinTiles
  Prof = 5
  Hud
  FaceMsg
  Prof = 0
  PassEnd
  if Buoys = 0 then goto game_over
  if ShipsLeft = 0 then goto dawn
  goto walk

dawn:
  ' the last ship of the night is past: dawn
  State = StNext
  StopGameTune
  play sound SndDawn
  Msg(4)
  Hold(60)
  NumU = Buoys
  NumU = NumU * 200
  V16 = Night
  V16 = V16 * 500
  NumU = NumU + V16
  Score = Score + NumU
  TextScreen
  print at 11,5, "NIGHT"
  V16 = Night
  print at 17,5, digits$(V16, 1)
  print at 5,8, "DAWN. THE STORM IS OVER"
  print at 5,10, "AND THE LIGHT HELD."
  print at 4,13, "BONUS:"
  print at 21,13, digits$(NumU, 4)
  print at 4,15, "SCORE:"
  NumU = Score
  print at 20,15, digits$(NumU, 5)
  print at 8,19, "PRESS THE BUTTON"
  State = StDawn
  PageWait
  inc Night
  if Night > 9 then Night = 9
  goto night_loop

game_over:
  State = StNext
  StopGameTune
  play sound SndWreck
  Hold(60)
  TextScreen
  print at 10,6, "GAME OVER"
  print at 4,9, "THREE SHIPS ON THE ROCKS."
  print at 4,11, "THE LIGHT FAILED ON NIGHT"
  NumU = Night
  print at 4,13, digits$(NumU, 1)
  print at 4,16, "SCORE:"
  NumU = Score
  print at 20,16, digits$(NumU, 5)
  print at 8,19, "PRESS THE BUTTON"
  ShowScreen
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules: you

' Advance(speed, back): forward (or back) along Ang, one axis at a time, so
' walls are slid along, not stuck to; HitSlot = a feature walked into
sub Advance(u8 Sv, u8 Back):
  V = CosT[Ang]
  Dx = V
  if V > 127 then Dx = Dx - 256
  K = Ang - 64
  V = CosT[K]
  Dy = V
  if V > 127 then Dy = Dy - 256
  V16 = Sv
  Cx = V16
  Dx = Dx * Cx
  Dx = Dx >> 6
  Dy = Dy * Cx
  Dy = Dy >> 6
  if Back = 1 then
    Dx = 0 - Dx
    Dy = 0 - Dy
  end if
  ' x, with a margin of 3/16 of a cell
  Nx = Px + Dx
  Cx = 48
  if Dx < 0 then Cx = -48
  V16 = Nx + Cx
  Solid(V16, Py)
  if K = 0 then Px = Nx
  Ny = Py + Dy
  Cx = 48
  if Dy < 0 then Cx = -48
  V16 = Ny + Cx
  Solid(Px, V16)
  if K = 0 then Py = Ny
  return
end sub

' Solid(x, y): K = 1 if the cell of (x, y) is a wall; a feature's slot
' walked into (going forward) -> HitSlot
sub Solid(u16 Qx, u16 Qy):
  V = highbyte Qy
  Qc = V
  Qc = Qc << 4
  V = highbyte Qx
  Qc = Qc + V
  call asm StPeekMap
  K = 0
  if Pk <> 0 then
    K = 1
    if Pk >= 2 then HitSlot = Pk - 2
  end if
  return
end sub

' StairsAt(slot): ClimbTo = the floor those stairs lead to (255: none)
sub StairsAt(u8 Sl):
  ClimbTo = 255
  SlotInfo(Sl)
  if V = 4 then ClimbTo = MapNo + 1
  if V = 6 then
    if DoorOpen = 1 then ClimbTo = MapNo + 1
  end if
  if V = 5 then ClimbTo = MapNo - 1
  return
end sub

' SlotInfo(slot): V = its kind, K = its argument
sub SlotInfo(u8 Sl):
  Qc = 288 + Sl
  call asm StPeekMap
  K = Pk
  Qc = 272 + Sl
  call asm StPeekMap
  V = Pk
  return
end sub

' Act: the button. Facing a feature within 1.75 cells: its use; else the
' lantern's shutter
sub Act:
  if CSlot <> 255 then
    if CZ <= 28 then
      SlotInfo(CSlot)
      if V = 2 then
        ' the barrel: a full lantern
        Oil = OilMax
        play sound SndRain
        return
      end if
      if V = 1 then
        J = Bits[K]
        V = LampLit & J
        if V = 0 then
          if Oil >= 4 then
            Oil = Oil - 4
            LampLit = LampLit | J
            play sound SndLampLit
            SetTex
          else
            play sound SndOilLow
          end if
        end if
        return
      end if
      if V = 3 then
        if KeyAt = K then
          KeyAt = 255
          KeyHeld = 1
          play sound SndKey
          SetTex
        end if
        return
      end if
      if V = 6 then
        if DoorOpen = 0 then
          if KeyHeld = 1 then
            KeyHeld = 0
            DoorOpen = 1
            play sound SndDoor
            SetTex
          else
            play sound SndOilLow
          end if
        end if
        return
      end if
      if V = 7 then
        ' the beacon: pour all but 16 of your oil, then light it
        if Oil > 16 then
          V16 = Oil - 16
          V16 = V16 * 10
          BFuel = BFuel + V16
          if BFuel > 1500 then BFuel = 1500
          Oil = 16
          play sound SndRain
          SetTex
        end if
        if BLit = 0 then
          if BFuel > 0 then
            if Oil >= 4 then
              Oil = Oil - 4
              BLit = 1
              play sound SndLampLit
              SetTex
            end if
          end if
        end if
        return
      end if
    end if
  end if
  ' the lantern's shutter
  LanOn = LanOn ^ 1
  play sound SndDoor
  return
end sub

' ---------------------------------------------------------------------------
' the rules: the world, once a pass (also while you climb)
sub World:
  Event = 0
  inc NightT
  ' your lantern
  if LanOn = 1 then
    if Oil > 0 then
      inc OilT
      if OilT >= 12 then
        OilT = 0
        dec Oil
      end if
    end if
  end if
  ' the beacon burns its oil
  if BLit = 1 then
    if BFuel = 300 then Event = 1
    if BFuel > 0 then dec BFuel
    if BFuel = 0 then
      BLit = 0
      Event = 1
    end if
  end if
  ' gusts of wind
  if Flash > 0 then dec Flash
  dec GustT
  if GustT = 0 then
    play sound SndWind
    Flash = 2
    Rnd16
    V = lowbyte Rw
    V = V & 7
    if V < 5 then
      J = Bits[V]
      J = J ^ 255
      LampLit = LampLit & J
    end if
    V = highbyte Rw
    if V < BOdds then
      if BLit = 1 then play sound SndThunder
      BLit = 0
    end if
    Rnd16
    V = lowbyte Rw
    GustT = GustBase + V
    Event = 1
  end if
  ' the fog: a new aim every 200 passes, a step toward it every 32
  inc FogT
  if FogT = 200 then FogT = 0
  V = FogT
  if V = 0 then
    Rnd16
    V = lowbyte Rw
    J = FogMax + 1
    V16 = V
    V16 = V16 * J
    FogTo = highbyte V16
  end if
  J = FogT & 31
  if J = 0 then
    if FogLv < FogTo then inc FogLv
    if FogLv > FogTo then dec FogLv
  end if
  ' the ship
  inc ShipT
  if ShipT >= ShipDur then
    ShipT = 0
    dec ShipsLeft
    if BLit = 1 then
      play sound SndKey
      V16 = 100
      for J = 0 to 4
        V = Bits[J]
        V = V & LampLit
        if V <> 0 then V16 = V16 + 25
      next
      Score = Score + V16
      inc Saved
      MsgPending(1)
    else
      play sound SndWreck
      dec Buoys
      inc Wrecked
      MsgPending(2)
    end if
  end if
  V16 = ShipDur / 5
  Nx = V16
  Stage = 0
  for J = 1 to 4
    if ShipT >= Nx then Stage = J
    Nx = Nx + V16
  next
  if ShipsLeft = 0 then Stage = 0
  ' the ship's horn, louder as she comes nearer
  if Stage <> LastStage then
    LastStage = Stage
    if Stage = 2 then play sound SndHorn3
    if Stage = 3 then play sound SndHorn2
    if Stage = 4 then play sound SndHorn1
  end if
  if Event = 1 then SetTex
  SetLight
  return
end sub

' SetLight: the light: fog level x 3 + your lantern + the floor's lamps
sub SetLight:
  V = 0
  if LanOn = 1 then
    if Oil > 0 then V = 1
  end if
  Rfogt = TFds
  if V = 1 then Rfogt = TFls
  K = FloorLamps[MapNo]
  K = K & LampLit
  if K <> 0 then inc V
  J = FogLv * 3
  Light = J + V
  if FogLv = 0 then
    FogD = 511
  else
    J = FogDT[FogLv]
    FogD = J
  end if
  return
end sub

' SetTex: each slot's texture on this floor, by its state
sub SetTex:
  J = NSlotT[MapNo]
  for I = 0 to 15
    if I < J then
      SlotInfo(I)
      X = 0
      if V = 1 then
        X = 2
        Y = Bits[K]
        Y = Y & LampLit
        if Y <> 0 then X = 1
      end if
      if V = 2 then X = 3
      if V = 3 then
        X = 5
        if KeyAt = K then X = 4
      end if
      if V = 4 then X = 6
      if V = 5 then X = 7
      if V = 6 then
        X = 8
        if DoorOpen = 1 then X = 6
      end if
      if V = 7 then
        X = 10
        if BLit = 1 then
          X = 9
          if BFuel < 300 then X = 11
        end if
      end if
      SlotTex[I] = X
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the window's tiles: the ship's light by stage, the sky (beam, lightning)
sub WinTiles:
  if Stage <> WinShown then
    WinShown = Stage
    Wsrc = Stage
    Wsrc = Wsrc * 96
    WinTile(WinV10)
    WinTile(WinV11)
    WinTile(WinV12)
    WinTile(WinV20)
    WinTile(WinV21)
    WinTile(WinV22)
  end if
  V = BLit
  if Flash > 0 then V = 2
  if V <> SkyShown then
    SkyShown = V
    Wsrc = V
    Wsrc = Wsrc * 48
    WinSkyT(WinV00)
    WinSkyT(WinV01)
    WinSkyT(WinV02)
  end if
  return
end sub

' WinTile(code): 16 bytes from WinShip + Wsrc (8 pattern, 8 colour) to the
' middle third's tile `code`; Wsrc moves on
sub WinTile(u8 Cd):
  Wdst = Cd
  Wdst = Wdst << 3
  Wdst = Wdst + 2048
  copy WinShip + Wsrc count 8 to vram.pattern + Wdst
  Wsrc = Wsrc + 8
  copy WinShip + Wsrc count 8 to vram.color + Wdst
  Wsrc = Wsrc + 8
  return
end sub

' WinSkyT(code): the same from WinSky
sub WinSkyT(u8 Cd):
  Wdst = Cd
  Wdst = Wdst << 3
  Wdst = Wdst + 2048
  copy WinSky + Wsrc count 8 to vram.pattern + Wdst
  Wsrc = Wsrc + 8
  copy WinSky + Wsrc count 8 to vram.color + Wdst
  Wsrc = Wsrc + 8
  return
end sub

' ---------------------------------------------------------------------------
' screens

' the night: the tower lit, the lantern full, ships, wind and fog by night
sub NewNight:
  MapNo = 0
  Px = 7 * 256 + 128
  Py = 10 * 256 + 128
  Ang = 192
  Oil = OilMax
  LanOn = 1
  OilT = 0
  LampLit = 31
  BLit = 1
  BFuel = 900
  KeyHeld = 0
  DoorOpen = 0
  KeyAt = Night & 1
  KeyAt = KeyAt ^ 1
  V = Night - 1
  if V > 6 then V = 6
  ShipsLeft = V + 3
  if ShipsLeft > 6 then ShipsLeft = 6
  V16 = V
  V16 = V16 * 80
  ShipDur = 1300 - V16
  V16 = V
  V16 = V16 * 50
  GustBase = 420 - V16
  GustT = GustBase
  J = V * 24
  BOdds = 56 + J
  FogMax = V + 1
  if FogMax > 3 then FogMax = 3
  FogLv = 0
  FogTo = 0
  FogT = 1
  ShipT = 0
  Flash = 0
  NightT = 0
  Saved = 0
  Wrecked = 0
  MsgT = 0
  SetLight
  PlayScreen
  return
end sub

' Climb: the stairs to floor ClimbTo; 20 passes of the world go by
sub Climb:
  State = StClimb
  InPlay = 0
  TextScreen
  print at 9,2, "FL"
  NumU = ClimbTo + 1
  print at 12,2, digits$(NumU, 1)
  ' a flight of steps (rows 6-17), the keeper on it
  for J = 0 to 5
    Y = J << 1
    Y = Y + 6
    X = 18 - J
    X = X - J
    fill TTread count 3 at X,Y
    Y = Y + 1
    fill TRiser count 3 at X,Y
  next
  ShowScreen
  ' the keeper stands on a tread and steps tread to tread (6 treads in
  ' 20 passes): up and to the right, or down and to the left, facing
  ' his way; a step sound at each tread
  K = 255
  for Ci = 0 to 19
    V16 = Ci
    V16 = V16 * 77
    V = highbyte V16
    if ClimbTo > MapNo then V = 5 - V
    if V <> K then
      K = V
      play sound SndStepStone
    end if
    ' tread V: columns 18 - 2V.., row 6 + 2V; his feet (pattern row 14,
    ' magnified) on its top line
    X = V << 1
    X = 18 - X
    X = X << 3
    X = X - 4
    Y = V << 1
    Y = Y + 6
    Y = Y << 3
    Y = Y - 31
    J = SKeeper
    if ClimbTo < MapNo then J = SKeeperl
    set sprite 0 to Y,X,J,11
    update sprites
    World
    inc Tick
    PassFrames
  next
  ' the arrival: in front of the stairs you came by, facing away
  K = ClimbTo * 3
  if ClimbTo > MapNo then
    X = ArrUp[K]
    inc K
    Y = ArrUp[K]
    inc K
    Ang = ArrUp[K]
  else
    X = ArrDn[K]
    inc K
    Y = ArrDn[K]
    inc K
    Ang = ArrDn[K]
  end if
  MapNo = ClimbTo
  Px = X
  Px = Px << 8
  Px = Px + 128
  Py = Y
  Py = Py << 8
  Py = Py + 128
  HideSprites
  SetLight
  PlayScreen
  State = StPlay
  return
end sub

' the feature tiles: codes 0-127 of the middle third and the shared codes
' it leaves free (FeatHighV)
sub FeatTiles:
  decompress zx0 PaintPatZ to vram.pattern + 2048
  decompress zx0 PaintColZ to vram.color + 2048
  decompress zx0 PaintHiPZ to vram.pattern + FeatHighV
  decompress zx0 PaintHiCZ to vram.color + FeatHighV
  return
end sub

' the floor's walls (stone, wood, plaster, brass and glass): the 64 wall
' tiles in the three thirds
sub FloorWalls:
  if MapNo = 0 then
    decompress zx0 Wall0P to vram.pattern + 1024
    decompress zx0 Wall0C to vram.color + 1024
    decompress zx0 Wall0P to vram.pattern + 3072
    decompress zx0 Wall0C to vram.color + 3072
    decompress zx0 Wall0P to vram.pattern + 5120
    decompress zx0 Wall0C to vram.color + 5120
  end if
  if MapNo = 1 then
    decompress zx0 Wall1P to vram.pattern + 1024
    decompress zx0 Wall1C to vram.color + 1024
    decompress zx0 Wall1P to vram.pattern + 3072
    decompress zx0 Wall1C to vram.color + 3072
    decompress zx0 Wall1P to vram.pattern + 5120
    decompress zx0 Wall1C to vram.color + 5120
  end if
  if MapNo = 2 then
    decompress zx0 Wall2P to vram.pattern + 1024
    decompress zx0 Wall2C to vram.color + 1024
    decompress zx0 Wall2P to vram.pattern + 3072
    decompress zx0 Wall2C to vram.color + 3072
    decompress zx0 Wall2P to vram.pattern + 5120
    decompress zx0 Wall2C to vram.color + 5120
  end if
  if MapNo = 3 then
    decompress zx0 Wall3P to vram.pattern + 1024
    decompress zx0 Wall3C to vram.color + 1024
    decompress zx0 Wall3P to vram.pattern + 3072
    decompress zx0 Wall3C to vram.color + 3072
    decompress zx0 Wall3P to vram.pattern + 5120
    decompress zx0 Wall3C to vram.color + 5120
  end if
  return
end sub

' the play screen: the font, the shared tiles, the feature tiles in the
' middle third, the HUD, the view
sub PlayScreen:
  TextScreen
  FeatTiles
  FloorWalls
  for J = 8 to 15
    put char TBlank at 0,J
    put char TBlank at 1,J
    put char TBlank at 30,J
    put char TBlank at 31,J
  next
  SetTex
  WinShown = 255
  SkyShown = 255
  WinTiles
  HudAll
  call asm StRays
  call asm StDraw
  InPlay = 1
  ShowScreen
  return
end sub

sub HudAll:
  print at 2,1, "FL"
  NumU = MapNo + 1
  print at 5,1, digits$(NumU, 1)
  put char TDrop at 2,21
  put char TRocks at 24,21
  ShownScore = 65535
  HudKey = 255
  HOil = 255
  HLamps = 255
  HBeac = 255
  HShip = 255
  MsgT = 0
  ShownFm = 255
  Hud
  if Event > 0 then Event = 0
  return
end sub

' the HUD: score, oil bar, key, lamps, beacon, the ship's way, buoys;
' a message (row 1) for a few seconds
sub Hud:
  if Score <> ShownScore then
    ShownScore = Score
    NumU = Score
    print at 25,1, digits$(NumU, 5)
  end if
  ' oil: 6 cells (each part redrawn only when it changes)
  V = Oil + 20
  V16 = V
  V16 = V16 * 12
  V = highbyte V16
  if Oil = 0 then V = 0
  if V <> HOil then
    HOil = V
    for K = 0 to 5
      X = K + 3
      J = TBarempty
      if K < V then J = TBarfull
      put char J at X,21
    next
  end if
  if KeyHeld <> HudKey then
    HudKey = KeyHeld
    V = TBlank
    if KeyHeld = 1 then V = TKey
    put char V at 10,21
  end if
  V = TBeac0
  if BLit = 1 then
    V = TBeac2
    if BFuel < 300 then V = TBeac1
  end if
  if LampLit <> HLamps then
    HLamps = LampLit
    HBeac = 0
  end if
  if V <> HBeac then
    HBeac = V
    put char V at 17,21
    for K = 0 to 4
      X = K + 12
      V = Bits[K]
      V = V & LampLit
      J = TLamp0
      if V <> 0 then J = TLamp1
      put char J at X,21
    next
  end if
  ' the ship: on cell Stage of five, then the rocks; the buoys
  V = Buoys << 3
  V = V + Stage
  if V <> HShip then
    HShip = V
    for K = 0 to 4
      X = K + 19
      V = TSea
      if K = Stage then V = TShip
      put char V at X,21
    next
    for K = 0 to 2
      X = K + 26
      V = TBuoyx
      if K < Buoys then V = TBuoy
      put char V at X,21
    next
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then
      print at 7,1, "                "
      ShownFm = 255
    end if
  end if
  return
end sub

' FaceMsg: row 1 names what you face within reach and what the button
' does there (ship messages first)
sub FaceMsg:
  if MsgT > 0 then return
  Fm = 0
  if CSlot <> 255 then
    if CZ <= 28 then
      Fm = SlotTex[CSlot]
      inc Fm
      if Fm = 9 then
        if KeyHeld = 1 then Fm = 13
      end if
    end if
  end if
  if Fm = ShownFm then return
  ShownFm = Fm
  if Fm = 0 then print at 7,1, "                "
  if Fm = 1 then print at 7,1, "WINDOW: THE SEA "
  if Fm = 2 then print at 7,1, "LAMP: LIT       "
  if Fm = 3 then print at 7,1, "LAMP OUT:RELIGHT"
  if Fm = 4 then print at 7,1, "BARREL: FILL OIL"
  if Fm = 5 then print at 7,1, "KEY: TAKE IT    "
  if Fm = 6 then print at 7,1, "EMPTY HOOK      "
  if Fm = 7 then print at 7,1, "STAIRS UP       "
  if Fm = 8 then print at 7,1, "STAIRS DOWN     "
  if Fm = 9 then print at 7,1, "LOCKED: NEED KEY"
  if Fm = 10 then print at 7,1, "BEACON: POUR OIL"
  if Fm = 11 then print at 7,1, "BEACON OUT:LIGHT"
  if Fm = 12 then print at 7,1, "BEACON LOW: POUR"
  if Fm = 13 then print at 7,1, "DOOR: UNLOCK    "
  return
end sub

' MsgPending(n): a message on the play screen (or the next one)
sub MsgPending(u8 Mn):
  Msg(Mn)
  return
end sub

' Msg(n): 1 ship safe, 2 wrecked, 4 dawn
sub Msg(u8 Mn):
  if InPlay = 1 then
    MsgT = 40
  end if
  if InPlay = 0 then Mn = 0
  if Mn = 1 then print at 7,1, "   SHIP SAFE!   "
  if Mn = 2 then print at 7,1, "  SHIP WRECKED  "
  if Mn = 4 then print at 7,1, "      DAWN      "
  return
end sub

' the night's first page
sub NightIntro:
  State = StNext
  InPlay = 0
  TextScreen
  print at 11,6, "NIGHT"
  NumU = Night
  print at 17,6, digits$(NumU, 1)
  print at 4,10, "A STORM. SHIPS ARE OUT"
  print at 4,12, "THERE. KEEP THE LIGHT."
  V = Night - 1
  if V > 6 then V = 6
  NumU = V + 3
  if NumU > 6 then NumU = 6
  print at 4,15, "SHIPS TONIGHT:"
  print at 19,15, digits$(NumU, 1)
  print at 8,19, "PRESS THE BUTTON"
  State = StIntro
  PageWait
  return
end sub

' the title: name, menu (cursor back on START)
sub TitlePage:
  State = StNext
  InPlay = 0
  ' the title picture (assets helper's title.py: a Mode 2 bitmap with the
  ' menu drawn in it, ZX0-packed); the cursor is a sprite
  Rearm
  wait
  nmi off
  display off
  HideSprites
  picture screen
  sprites 16x16
  sprites double
  decompress zx0 TitleP to vram $0000
  decompress zx0 TitleC to vram $2000
  call asm StIdName
  backdrop black
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  if TuneOnce = 0 then
    ' the title tune, once (Rearm stops it after TuneFrames)
    TitleTune
    TzLeft = TuneFrames
    TzOn = 1
  end if
  TuneOnce = 1
  WasBtn = 1
tp_loop:
  Frame1
  Rnd16
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndStepMetal
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu = 0 then
    StopTune
    mute all
    TuneOnce = 0
  end if
  V16 = Tick
  Rs = Rs ^ V16
  if Rs = 0 then Rs = $5A3C
  return
end sub

sub ShowMenu:
  V = Menu << 3
  V = V + MenuY
  set sprite 4 to V,MenuX,SCursor,11
  update sprites
  return
end sub

sub CreditsPage:
  State = StNext
  TextScreen
  print at 10,2, "STORM LIGHT"
  print at 2,5, "AN ORIGINAL GAME BY CLAUDE"
  print at 2,7, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,9, "2026."
  print at 2,12, "AMY LANGUAGE AND STUDIO BY"
  print at 2,14, "AMY BIENVENU."
  print at 2,17, "MUSIC: ORIGINAL TUNES."
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

sub HowTo:
  State = StNext
  Page = 1
  TextScreen
  ' the picture, in the middle third: a lamp, the beacon, a window, the
  ' storm door, in the game's own tiles
  FeatTiles
  for J = 8 to 15
    fill TBlank count 32 at 0,J
  next
  ' six features as the walls show them (3 tile columns each), named
  for I = 0 to 5
    Ci = HowFeat[I]
    Ci = Ci * 3
    X = HowX[I]
    Y = 9
    inc Ci
    HowCol(Ci)
    inc X
    inc Ci
    HowCol(Ci)
    inc X
    inc Ci
    HowCol(Ci)
  next
  print at 7,1, "HOW TO PLAY  1/2"
  print at 2,3, "KEEP THE BEACON LIT WHEN A"
  print at 2,5, "SHIP REACHES THE ROCKS."
  ' one row of names, each centred under its picture (28 columns: the
  ' stairs are "UP", as their arrow)
  print at 2,17, "OIL"
  print at 6,17, "LAMP"
  print at 11,17, "BEACON"
  print at 18,17, "KEY"
  print at 22,17, "DOOR"
  print at 28,17, "UP"
  print at 2,21, "STICK WALKS. BUTTON: USE IT."
  State = StHowPic
  PageWait
  if TimedOut = 0 then
    Page = 2
    State = StNext
    TextScreen
    print at 7,1, "HOW TO PLAY  2/2"
    put char TDrop at 2,4
    for K = 3 to 8
      put char TBarfull at K,4
    next
    print at 11,4, "OIL: THE BARREL"
    put char TLamp1 at 2,7
    put char TLamp0 at 3,7
    print at 5,7, "LAMPS THE WIND BLOWS OUT"
    put char TBeac2 at 2,10
    print at 5,10, "THE BEACON: POUR OIL IN,"
    print at 5,12, "LIGHT IT AGAIN"
    put char TShip at 2,15
    put char TSea at 3,15
    put char TRocks at 4,15
    print at 6,15, "THE SHIP COMING IN"
    put char TKey at 2,18
    print at 5,18, "THE KEY TO THE STORM DOOR"
    put char TBuoy at 2,21
    print at 5,21, "3 WRECKS: GAME OVER"
    State = StHow
    PageWait
  end if
  HideSprites
  return
end sub

' HowCol(code): a feature column (cap, v0, v1, v1, v2, v2, v3, sill) at X,Y
sub HowCol(u8 Cd):
  ' a feature column (column id Cd) at X, rows Y..Y+5: lintel, its four
  ' rows, sill
  put char TFt at X,Y
  K = Y + 1
  V = IdV0T[Cd]
  put char V at X,K
  J = IdV1T[Cd]
  inc K
  put char J at X,K
  J = MirT[J]
  inc K
  put char J at X,K
  J = MirT[V]
  inc K
  put char J at X,K
  inc K
  put char TFb at X,K
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 1
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub HideSprites:
  clear sprites
  set sprite count 5
  sprites flicker off
  for K = 0 to 4
    set sprite K to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: the font in all three thirds, the shared tiles
sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  mode 2 screen
  sprites 16x16
  sprites double
  load default ascii
  duplicate mode 2 patterns
  fill $F1 count 1024 to vram.color
  fill $F1 count 1024 to vram.color + 2048
  fill $F1 count 1024 to vram.color + 4096
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TileColZ to vram.color + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  decompress zx0 TileColZ to vram.color + 5120
  backdrop black
  fill 32 count 768 to vram.name
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub GameTune:
  play sound SndGameA
  play sound SndGameB
  return
end sub

sub StopGameTune:
  stop sound SndGameA
  stop sound SndGameB
  return
end sub

sub TitleTune:
  play sound SndTitleA
  play sound SndTitleB
  play sound SndTitleC
  play sound SndTitleD
  return
end sub

sub StopTune:
  stop sound SndTitleA
  stop sound SndTitleB
  stop sound SndTitleC
  stop sound SndTitleD
  TzOn = 0
  return
end sub

sub Rearm:
  ' a tune plays once: stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      StopTune
    end if
  end if
  nmi off
  nmi on
  return
end sub

' the end of a play pass: the NMI's work for each vblank the pass ran
' through (polled), then wait so that a pass lasts at least 3 frames
sub PassEnd:
  call asm StPoll
  FrPass = FrPass + VbMiss
pe_soft:
  if VbMiss > 0 then
    call asm StSoftNmi
    dec VbMiss
    goto pe_soft
  end if
  PassFrames
  return
end sub

sub PassFrames:
pe_wait:
  if FrPass < 3 then
    Rearm
    Idle = 1
    wait
    Idle = 0
    nmi off
    inc FrPass
    goto pe_wait
  end if
  FrPass = 0
  VbMiss = 0
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  ' one read of each controller (bits: 1 up, 2 right, 4 down, 8 left,
  ' 64 and 128 the buttons)
  V = joypad(1)
  K = joypad(2)
  V = V | K
  Up1 = V & 1
  K = V >> 1
  Rt1 = K & 1
  K = V >> 2
  Dn1 = K & 1
  K = V >> 3
  Lf1 = K & 1
  Btn = 0
  K = V & 192
  if K <> 0 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = Dn1 << 1
  Jk = Up1 | V
  K = WasJ ^ 3
  Edge = Jk & K
  WasJ = Jk
  return
end sub

' Rnd16: a 16-bit xorshift (7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

data Bits bytes 1, 2, 4, 8, 16, 32, 64, 128
' HOW TO PLAY's features (texture numbers): barrel, lamp, beacon, key, door, stairs up
data HowFeat bytes 3, 1, 9, 4, 8, 6
data HowX bytes 2, 7, 12, 18, 22, 27

data SpritePat bytes
  $C0,$F0,$F0,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $03,$07,$07,$03,$0F,$1F,$1B,$1B,$33,$03,$03,$06,$06,$06,$0E,$00
  $C0,$E0,$E0,$C0,$F0,$F8,$D8,$D8,$CE,$CE,$C0,$60,$60,$60,$70,$00
  $03,$07,$07,$03,$0F,$1F,$1B,$1B,$73,$73,$03,$06,$06,$06,$0E,$00
  $C0,$E0,$E0,$C0,$F0,$F8,$D8,$D8,$CC,$C0,$C0,$60,$60,$60,$70,$00
  $30,$78,$FC,$FC,$78,$30,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data
' the window's horizon and sea tiles by ship stage (v1 u0-u2, v2 u0-u2: 8 pattern + 8 colour bytes each)
data WinShip bytes
  $40,$00,$08,$80,$01,$00,$00,$00,$E4,$04,$E4,$E4,$E4,$04,$04,$05,$08,$00,$01,$10,$00,$00,$20,$00,$E4,$04,$E4,$E4,$04,$04,$E4,$05,$01,$00,$00,$02,$20,$00,$04,$00,$E4,$04,$04,$E4,$E4,$04,$E4,$05,$C3,$00,$18,$00,$C3,$00,$18,$00,$54,$04,$54,$04,$54,$04,$54,$04,$0C,$00,$61,$00,$0C,$00,$61,$00,$54,$04,$54,$04,$54,$04,$54,$04,$30,$00,$86,$00,$30,$00,$86,$00,$54,$04,$54,$04,$54,$04,$54,$04
  $40,$00,$08,$80,$01,$08,$08,$00,$E4,$04,$E4,$E4,$E4,$B4,$B4,$05,$08,$00,$01,$10,$00,$00,$20,$00,$E4,$04,$E4,$E4,$04,$04,$E4,$05,$01,$00,$00,$02,$20,$00,$04,$00,$E4,$04,$04,$E4,$E4,$04,$E4,$05,$C3,$00,$18,$00,$C3,$00,$18,$00,$54,$04,$54,$04,$54,$04,$54,$04,$0C,$00,$61,$00,$0C,$00,$61,$00,$54,$04,$54,$04,$54,$04,$54,$04,$30,$00,$86,$00,$30,$00,$86,$00,$54,$04,$54,$04,$54,$04,$54,$04
  $40,$00,$08,$80,$01,$00,$00,$00,$E4,$04,$E4,$E4,$E4,$04,$04,$05,$08,$00,$01,$10,$00,$80,$A0,$00,$E4,$04,$E4,$E4,$04,$B4,$B4,$05,$01,$00,$00,$02,$20,$00,$04,$00,$E4,$04,$04,$E4,$E4,$04,$E4,$05,$C3,$00,$18,$00,$C3,$00,$18,$00,$54,$04,$54,$04,$54,$04,$54,$04,$8C,$00,$E1,$00,$0C,$00,$61,$00,$54,$04,$54,$04,$54,$04,$54,$04,$30,$00,$86,$00,$30,$00,$86,$00,$54,$04,$54,$04,$54,$04,$54,$04
  $40,$00,$08,$80,$01,$00,$00,$00,$E4,$04,$E4,$E4,$E4,$04,$04,$05,$08,$00,$01,$10,$08,$1C,$C3,$08,$E4,$04,$E4,$E4,$B4,$B4,$4B,$B5,$01,$00,$00,$02,$20,$00,$04,$00,$E4,$04,$04,$E4,$E4,$04,$E4,$05,$C3,$00,$18,$00,$C3,$00,$18,$00,$54,$04,$54,$04,$54,$04,$54,$04,$0C,$00,$96,$00,$0C,$00,$61,$00,$54,$04,$45,$04,$54,$04,$54,$04,$30,$00,$86,$00,$30,$00,$86,$00,$54,$04,$54,$04,$54,$04,$54,$04
  $40,$00,$08,$80,$01,$00,$00,$00,$E4,$04,$E4,$E4,$E4,$04,$04,$05,$08,$00,$01,$11,$07,$07,$D8,$07,$E4,$04,$E4,$B4,$B4,$B4,$4B,$B5,$01,$00,$00,$02,$E0,$C0,$C4,$C0,$E4,$04,$04,$E4,$B4,$B4,$B4,$B5,$C3,$00,$18,$00,$C3,$00,$18,$00,$54,$04,$54,$04,$54,$04,$54,$04,$E0,$00,$61,$00,$0D,$00,$61,$00,$41,$04,$54,$04,$54,$04,$54,$04,$07,$00,$86,$00,$30,$00,$86,$00,$41,$04,$54,$04,$54,$04,$54,$04
end data
' the window's sky tiles: plain, the beacon's beam, lightning (v0 u0-u2)
data WinSky bytes
  $80,$00,$10,$00,$02,$00,$00,$04,$E4,$04,$E4,$04,$E4,$04,$04,$E4,$10,$00,$02,$20,$00,$00,$40,$00,$E4,$04,$E4,$E4,$04,$04,$E4,$04,$02,$00,$00,$04,$40,$00,$08,$80,$E4,$04,$04,$E4,$E4,$04,$E4,$E4
  $E0,$07,$C3,$E0,$07,$01,$00,$04,$54,$45,$45,$45,$54,$54,$04,$E4,$10,$00,$02,$20,$C0,$E0,$07,$C1,$E4,$04,$E4,$E4,$54,$54,$45,$45,$02,$00,$00,$04,$40,$00,$08,$80,$E4,$04,$04,$E4,$E4,$04,$E4,$E4
