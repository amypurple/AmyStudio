cartridge "HARDHAT CLIMBER/CHRIS LESHER, COMPUTE!/1984"

' HARDHAT CLIMBER
' Chris Lesher's HARDHAT CLIMBER (COMPUTE!'s Gazette, January 1984, for the
' VIC-20, with a Commodore 64 adaptation), for the ColecoVision in Amy by
' Amy Bienvenu. Ported by Claude (an AI made by Anthropic) for Amy Studio,
' 2026.
'
' Source: the 64 version's listing (orig/hardhat64.bas, typed in from the
' magazine's pages 196-197). Labels such as l100 are its line numbers. The
' game PEEKs and POKEs the screen: here Pk and Po on the name table, one
' character per cell, codes as the listing's (56 a girder, 57 a ladder,
' 58 the climber, 60 a barrel, 61 a toolbox, 62 nothing, 63 nothing where
' barrels fall).
'
' Four levels of girders joined by ladders; at the top a pile of 12
' barrels that roll down one at a time, falling at the ends, down some
' ladders and through the holes. Pick up the 16 toolboxes (150 each)
' without being hit; jump over a barrel for 1000. All the toolboxes: 100
' for each barrel left, and a harder screen (more holes, more broken
' ladders). A climber is lost when hit, when walking off a girder, or when
' the 12 barrels have rolled away first. Three climbers, one more every
' 10,000 points.
'
' Controls (either joystick): left/right walk, up/down climb, the left
' button jumps the way you last walked. Keypad not used.
'
' Kept as the listing has them: the screen (rows 7, 12, 17 and 22 to walk
' on), the barrel pile and its order, one barrel moving at a time with
' one move of yours, where barrels turn, fall and leave, the ladders
' (three a level, some broken, some with a barrel drop on top), holes
' and toolboxes placed at random, the jump (up and over, landing beyond),
' the scores, the extra climbers, the fall when a climber is lost and
' where play goes on (the next barrel; a new screen after the eleventh).
' Liberties taken:
' - 28 columns (the 64 had 40): the random places are taken over 26
'   columns instead of 38; the pile and its ladders moved six columns
'   left; rows 2-23 are screen rows 1-22, the score line shares row 1
'   with the top of the pile.
' - Line 340 (the twelfth barrel gone) loses a climber, as the VIC
'   version's line 51 does and the article says (the 64 line is hard to
'   read in the scan).
' - The loop waits five frames a turn; new sounds.
' House rules kept: text in columns 2-29, rows 1-22; tiles from 128; an
' original title tune that plays once; a credits page; the screens are
' drawn with the NMI off.

const TGirder = 128
const TLadder = 129
const TClimber = 130
const TUnused = 131
const TBarrel = 132
const TToolbox = 133
const TBlank = 134
const TDrop = 135
const NTiles8 = 64
const SprBytes = 0
const SndHush = 1
const SndTick = 2
const SndStep = 3
const SndJump = 4
const SndTool = 5
const SndOver = 6
const SndFall = 7
const SndClear = 8
const SndExtra = 9
const SndTuneA = 10
const SndTuneB = 11

' --- the listing's variables -------------------------------------------------
' S the climber (row * 28 + column), T what he stands in front of, DI the
' way he faces, V the barrel, W what it covers, Dw (the listing's DO) its way (1, -1 as 255,
' 28 falling), Y the barrel's number, H toolboxes taken, SS score, CH
' climbers left, SC the screen, E1 holes a girder, E2 the chance of a
' broken ladder (in 1/256), E3 the next 10,000
u16 S = 0
u8 T = 62
u8 DI = 1
u16 V = 0
u8 W = 62
u8 Dw = 1
u8 Y = 0
u8 H = 0
u16 SS = 0
u8 CH = 2
u8 SC = 1
u8 E1 = 0
u8 E2 = 0
u8 E3 = 1
u8 T1 = 0
u8 JV = 0
u16 R = 0
u16 M = 0
u16 N16 = 0
u8 O = 0
u8 Ask = 0
u8 Idle = 0
u16 Turns = 0
u8 InTurn = 0

data Tens words 0,10000,20000,30000,40000,50000,60000
data Bp bytes 0,1,27,28,29,30,54,55,56,57,58,59

u16 Rs = $4E1F
u16 Seed = 0
u16 Rw = 0
u16 Rt = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rn = 0
u16 Rv = 0
u8 Fire1 = 0
u8 WasF1 = 0
u8 Tick = 0
u8 Pv = 0
u8 V8 = 0
u8 J8 = 0
u8 K = 0
u8 Tx = 0
u8 Ty = 0
u16 Q16 = 0
u16 P16 = 0
u16 NumU = 0

  tile screen
  set sound table HcSoundTable areas 4
  nmi off
  CreditsPage
l2:
  TitlePage
' 20-50
  Rnd16
  DI = 1
  if Rw < 32768 then DI = 255
  E2 = 0
  SC = 1
  CH = 2
  E1 = 0
  E3 = 1
  SS = 0
' 60: a new screen
l60:
  Screen500
  H = 0
  Y = 0
' 70-80: the climber on the bottom row
l70:
  Rn = 26
  RndK
  S = Rv + 617
  Q16 = S + 28
  Pk(Q16)
  if Pv = 62 then goto l70
  Pk(S)
  if Pv = 59 then goto l70
  T = Pv
  Po(S, 58)
' 90: the next barrel from the pile
l90:
  V8 = Bp[Y]
  V = V8
  V = V + 69
  W = 62
  RndDir

' 100-109: the stick (one move a turn)
l100:
  Frame4
  JV = 0
  K = joypad(1).up | joypad(2).up
  if K = 1 then JV = 4
  K = joypad(1).left | joypad(2).left
  if K = 1 then JV = 3
  K = joypad(1).right | joypad(2).right
  if K = 1 then JV = 5
  K = joypad(1).down | joypad(2).down
  if K = 1 then JV = 2
  K = joypad(1).button1 | joypad(2).button1
  if K = 1 then JV = 1
  if JV = 1 then goto l210
  if JV = 2 then goto l120
  if JV = 3 then goto l140
  if JV = 4 then goto l170
  if JV = 5 then goto l190
  goto l260

' 120: down a ladder
l120:
  Q16 = S + 28
  Pk(Q16)
  if Pv <> 57 then goto l260
  Po(S, T)
  S = S + 28
  goto l250
' 140-160: left (off the girder's end: a fall)
l140:
  DI = 255
  Q16 = S + 27
  Pk(Q16)
  if Pv < 62 then
    Po(S, T)
    dec S
    goto l250
  end if
l150:
  if T = 57 then goto l260
  Po(S, T)
  if DI = 1 then
    inc S
  else
    dec S
  end if
  Pk(S)
  T = Pv
  goto l360
' 170: up a ladder
l170:
  if T <> 57 then goto l260
  Po(S, T)
  S = S - 28
  goto l250
' 190-200: right
l190:
  DI = 1
  Q16 = S + 29
  Pk(Q16)
  if Pv < 62 then
    Po(S, T)
    inc S
    goto l250
  end if
  goto l150

' 210-240: the jump: up and over, down beyond
l210:
  play sound SndJump
  Po(S, T)
  S = S - 28
  if DI = 1 then
    inc S
  else
    dec S
  end if
  Pk(S)
  T = Pv
  Po(S, 58)
  if T = 60 then goto l360
  ' 220: over a barrel
  Q16 = S + 28
  Pk(Q16)
  if Pv = 60 then
    SS = SS + 1000
    play sound SndOver
    Hud
  end if
  Frame4
  Po(S, T)
  S = S + 28
  if DI = 1 then
    inc S
  else
    dec S
  end if
  Pk(S)
  T = Pv
  Po(S, 58)
  ' 235: off the bottom, or nothing to land on
  if S > 643 then goto l360
  Q16 = S + 28
  Pk(Q16)
  if Pv > 61 then goto l360
  goto l260
' 250: a step
l250:
  play sound SndStep
  Pk(S)
  T = Pv
  Po(S, 58)
' 260-280: a toolbox, a barrel, an extra climber
l260:
  if T = 61 then
    SS = SS + 150
    play sound SndTool
    Hud
    inc H
    T = 62
    if H = 16 then goto l440
  end if
  if T = 60 then goto l360
  Extra690

' 290-350: the barrel moves
  Po(V, W)
  if Dw = 1 then V = V + 1
  if Dw = 255 then V = V - 1
  if Dw = 28 then V = V + 28
  Pk(V)
  W = Pv
  Po(V, 60)
  if Dw = 28 then
    Q16 = V + 28
    Pk(Q16)
    if Pv = 56 then
      RndDir
      goto l320
    end if
  end if
  if W = 63 then Dw = 28
l320:
  if W = 58 then goto l360
  if V < 644 then goto l100
  inc Y
  if Y = 12 then goto l360
  Po(V, 62)
  goto l90

' 360-430: a climber lost: he falls to the girder below
l360:
  play sound SndFall
  O = 0
  if T = 60 then T = W
  Pause(15)
  T1 = T
l370:
  if S < 644 then
    Q16 = S + 28
    Pk(Q16)
    if Pv <> 56 then
      Po(S, T)
      S = S + 28
      Pk(S)
      T = Pv
      Po(S, 58)
    end if
  end if
  Pause(8)
  inc O
  if O < 20 then goto l370
  O = 0
  Pause(40)
  if CH = 0 then goto l1000
  dec CH
  Hud
  Po(V, W)
  inc Y
  if W = 58 then Po(V, T1)
  if Y > 10 then goto l60
  if S > 643 then
    Po(S, T)
    goto l70
  end if
  Po(S, 58)
  goto l90

' 440-480: all the toolboxes: 100 a barrel left, a harder screen
l440:
  if Y = 11 then goto l470
  K = Y + 1
  for O = K to 11
    V8 = Bp[O]
    Q16 = V8
    Q16 = Q16 + 69
    Po(Q16, 62)
    SS = SS + 100
    Hud
    play sound SndTick
    Pause(6)
    Extra690
  next
  play sound SndClear
  Pause(60)
l470:
  E2 = E2 + 13
  inc SC
  inc E1
  if E1 > 8 then E1 = 8
  goto l60

' 1000-1050: the end
l1000:
  NewScreen
  print at 9,8, "YOUR SCORE IS"
  NumU = SS
  print at 12,10, digits$(NumU, 5)
  print at 6,15, "PRESS A BUTTON TO"
  print at 9,16, "PLAY AGAIN"
  ShowPage
  play sound SndOver
  Ask = 9
  WaitPress
  Ask = 0
  goto l2

' ---------------------------------------------------------------------------
' 500-685: the screen

sub Screen500:
  NewScreen
  ' 510-515: the barrel pile's platform and its two ladders
  Po(121, 63)
  Po(130, 63)
  Po(149, 57)
  for N16 = 150 to 157
    Po(N16, 56)
  next
  Po(158, 57)
  Po(177, 57)
  Po(186, 57)
  Po(205, 57)
  Po(214, 57)
  ' 520: the four girders (column 0 open; the bottom one open at both ends)
  for N16 = 225 to 251
    Po(N16, 56)
  next
  for N16 = 365 to 391
    Po(N16, 56)
  next
  for N16 = 505 to 531
    Po(N16, 56)
  next
  for N16 = 645 to 670
    Po(N16, 56)
  next
  Hud
  ' 535: the barrels
  for J8 = 0 to 11
    V8 = Bp[J8]
    Q16 = V8
    Q16 = Q16 + 69
    Po(Q16, 60)
  next
  ' 540-660: each girder: three ladders (not the bottom one), holes,
  ' four toolboxes on the row above
  N16 = 224
s540:
  if N16 = 644 then goto s600
  for O = 1 to 3
s560:
    Rn = 26
    RndK
    R = N16 + 1
    R = R + Rv
    Pk(R)
    if Pv <> 56 then goto s560
    M = R
    for J8 = 0 to 4
      Po(M, 57)
      M = M + 28
    next
    ' 575: a broken rung
    if O > 1 then
      Rnd16
      V8 = Rw / 256
      if V8 < E2 then
        Rnd16
        K = Rw & 1
        M = K + 2
        M = M * 28
        M = M + R
        Po(M, 63)
      end if
    end if
    ' 580: a barrel drop over the ladder
    Rnd16
    if Rw < 32768 then
      Q16 = R - 28
      Pk(Q16)
      if Pv = 62 then Po(Q16, 63)
    end if
  next
s600:
  if E1 = 0 then goto s640
  for O = 1 to E1
    Rn = 24
    RndK
    R = N16 + 3
    R = R + Rv
    Pk(R)
    if Pv <> 56 then goto s630
    Q16 = R - 28
    Pk(Q16)
    if Pv <> 62 then goto s630
    Q16 = R + 1
    Pk(Q16)
    if Pv = 62 then goto s630
    Q16 = R - 1
    Pk(Q16)
    if Pv = 62 then goto s630
    Po(R, 62)
    Q16 = R - 28
    Po(Q16, 63)
s630:
  next
s640:
  for O = 1 to 4
s650:
    Rn = 26
    RndK
    R = N16 - 27
    R = R + Rv
    Pk(R)
    if Pv <> 62 then goto s650
    Q16 = R + 28
    Pk(Q16)
    if Pv = 62 then goto s650
    Po(R, 61)
  next
  if N16 < 644 then
    N16 = N16 + 140
    goto s540
  end if
  ' 670-680: where barrels fall: round the pile, the rows' ends
  Po(68, 63)
  Po(71, 63)
  Po(95, 63)
  Po(100, 63)
  for N16 = 196 to 616 step 140
    Po(N16, 63)
  next
  for N16 = 223 to 643 step 140
    Po(N16, 63)
  next
  ShowPage
  Ask = 1
  return
end sub

' 690: a climber more every 10,000
sub Extra690:
  if E3 > 6 then return
  NumU = Tens[E3]
  if SS < NumU then return
  inc CH
  inc E3
  play sound SndExtra
  Hud
  return
end sub

' ---------------------------------------------------------------------------
' The screen as the listing PEEKed it (row * 28 + column; rows 2-23 are
' screen rows 1-22)

sub Pk(u16 Aa):
  Pv = 62
  if Aa < 56 then return
  if Aa > 671 then return
  P16 = Aa / 28
  Ty = P16 + 0
  dec Ty
  P16 = Aa % 28
  Tx = P16 + 2
  K = get char at Tx,Ty
  Pv = 62
  if K >= 128 then
    if K < 136 then Pv = K - 72
  end if
  return
end sub

sub Po(u16 Aa, u8 Cc):
  if Aa < 56 then return
  if Aa > 671 then return
  P16 = Aa / 28
  Ty = P16 + 0
  dec Ty
  P16 = Aa % 28
  Tx = P16 + 2
  K = Cc + 72
  put char K at Tx,Ty
  return
end sub

' RndDir: Dw = DO(INT(RND(1)*2))
sub RndDir:
  Rnd16
  Dw = 1
  if Rw < 32768 then Dw = 255
  return
end sub

' Hud: 530, the score, the climbers in reserve, the screen
sub Hud:
  NumU = SS
  print at 2,1, digits$(NumU, 5)
  print at 20,1, "MEN"
  print at 24,1, digits$(CH, 1)
  print at 26,1, "S"
  print at 27,1, digits$(SC, 2)
  return
end sub

' ---------------------------------------------------------------------------
' Screens, frames, input, random numbers

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  ' the text shows on the night colour of the empty tiles
  backdrop dark blue
  cls
  ' 500: the screen filled with nothing (character 62)
  for Ty = 1 to 22
    fill TBlank count 28 at 2,Ty
  next
  return
end sub

sub ShowPage:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Pause(u8 Nf):
  for J8 = 1 to Nf
    Frame1
  next
  return
end sub

' Frame4: a turn of the loop
sub Frame4:
  InTurn = 1
  Frame1
  Frame1
  Frame1
  Frame1
  Frame1
  InTurn = 0
  inc Turns
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub WaitPress:
  WasF1 = 1
wp_loop:
  Frame1
  K = joypad(1).button1 | joypad(2).button1
  Fire1 = 0
  if K = 1 then
    if WasF1 = 0 then Fire1 = 1
  end if
  WasF1 = K
  if Fire1 = 0 then goto wp_loop
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

sub RndK:
  Rnd16
  Uq = Rw
  Uq2 = Rn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

sub CreditsPage:
  NewScreen
  print at 7,2, "HARDHAT CLIMBER"
  print at 2,4, "BY CHRIS LESHER, FROM"
  print at 2,5, "COMPUTE!'S GAZETTE,"
  print at 2,6, "JANUARY 1984 (VIC-20 AND"
  print at 2,7, "COMMODORE 64)."
  print at 2,9, "FOR THE COLECOVISION BY"
  print at 2,10, "CLAUDE (AN AI MADE BY"
  print at 2,11, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "2026, IN AMY, THE LANGUAGE"
  print at 2,13, "BY AMY BIENVENU."
  print at 2,15, "MUSIC: STEEL TOES"
  print at 2,16, "(ORIGINAL)."
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  Ask = 2
  WaitPress
  Ask = 0
  return
end sub

sub TitlePage:
  NewScreen
  print at 7,3, "HARDHAT CLIMBER"
  for Tx = 2 to 29
    put char TGirder at Tx,5
    put char TGirder at Tx,12
  next
  put char TBarrel at 6,4
  put char TBarrel at 9,4
  put char TClimber at 15,11
  put char TToolbox at 21,11
  put char TLadder at 25,12
  print at 2,14, "PICK UP ALL 16 TOOLBOXES"
  print at 2,15, "(150 EACH), JUMP BARRELS"
  print at 2,16, "(1000). STICK: WALK, CLIMB."
  print at 2,17, "BUTTON: JUMP."
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  ' Amy's Tiny Sound "once" form: both voices stop at the tune's end
  play song HcSong once
  Ask = 2
  WaitPress
  Ask = 0
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $4E1F
  ' the game's seed, for the tests
  Seed = Rs
  return
end sub

data TilePat bytes
  $00,$00,$42,$00,$00,$42,$00,$00
  $42,$81,$42,$42,$42,$81,$42,$42
  $C3,$81,$C3,$18,$81,$42,$24,$99
  $00,$00,$00,$00,$00,$00,$00,$00
  $C3,$81,$42,$00,$00,$42,$81,$C3
  $00,$C3,$24,$00,$00,$81,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $08,$06,$18,$08,$08,$18,$06,$08
  $B4,$4B,$B4,$B4,$B4,$4B,$B4,$B4
  $4B,$4B,$49,$94,$45,$45,$54,$45
  $04,$04,$04,$04,$04,$04,$04,$04
  $4A,$4A,$8A,$0A,$0A,$8A,$4A,$4A
  $04,$4E,$E4,$08,$08,$81,$08,$08
  $04,$04,$04,$04,$04,$04,$04,$04
  $04,$04,$04,$04,$04,$04,$04,$04
end data

asm {
HcHush:
    db $00,$00,$F0,$01,$10
HcTick:
    db $40,$40,$40,$01,$40,$40,$F0,$01,$50
HcStep:
    db $40,$BA,$50,$01,$40,$BA,$F0,$01,$50
HcJump:
    db $40,$E0,$30,$02,$40,$A0,$30,$02,$40,$7C,$40,$02,$40,$A0,$50,$02,$50
HcTool:
    db $40,$6B,$20,$03,$40,$55,$20,$03,$40,$47,$30,$06,$50
HcOver:
    db $40,$8F,$20,$04,$40,$71,$20,$04,$40,$5F,$20,$04,$40,$47,$20,$0A,$50
HcFall:
    db $40,$5D,$20,$06,$40,$70,$30,$06,$40,$84,$30,$06,$40,$A0,$40,$06,$40,$BA,$40,$06,$40,$E0,$50,$06
    db $40,$18,$51,$0A,$50
HcClear:
    db $40,$D6,$20,$04,$40,$AA,$20,$04,$40,$8F,$20,$04,$40,$6B,$20,$04,$40,$55,$20,$0C,$50
HcExtra:
    db $40,$47,$20,$03,$40,$35,$20,$03,$40,$47,$20,$03,$40,$35,$20,$08,$50

HcSoundTable:
    dw HcHush,$702B
    dw HcTick,$7035
    dw HcStep,$7035
    dw HcJump,$7035
    dw HcTool,$7035
    dw HcOver,$7035
    dw HcFall,$7035
    dw HcClear,$7035
    dw HcExtra,$7035
    dw HcTuneMel,$703F
    dw HcTuneBass,$7049
; Steel Toes (original)
; Tiny Sound, 7 frames per step
HcTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$1A,$01,$1F,$01,$23,$01,$26,$01,$23,$01,$1F,$01
    db $21,$01,$23,$01,$24,$01,$21,$01,$1E,$01,$1A,$01,$1C,$01,$1E,$01
    db $1F,$01,$01,$01,$1A,$01,$1F,$01,$23,$01,$26,$01,$28,$01,$26,$01
    db $24,$01,$23,$01,$21,$01,$26,$01,$24,$01,$21,$01,$1F,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
HcTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$0C,$01,$0E,$01
    db $07,$01,$0E,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$0E,$01,$15,$01,$0E,$01,$12,$01,$07,$01,$0E,$01
    db $07,$01,$01,$01
    db $FF
; the title song: both voices at once (SndTuneA, SndTuneB)
HcSong:
    dw $0001
    db $40+10,11
    dw $0000
}
