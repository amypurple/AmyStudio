cartridge "SANTA'S SLEIGH RUN/PRESENTS AMY STUDIO/2026"

' SANTA'S SLEIGH RUN
' A Christmas game for the ColecoVision, written in Amy.
'
' Fly Santa's sleigh over five snowy houses and drop a gift down every
' chimney before the gifts run out. Fly with the joystick (either one),
' drop a gift with a fire button. The gift falls straight down, so judge
' where it will land. A gift that lands dead centre in a chimney is a
' perfect delivery: 50 bonus points and one extra gift. From level 2 the
' wind pushes a falling gift (the arrows at the top right show which way
' and how hard, and change after every gift) and crows try to snatch the
' gifts out of the air. Gifts left at the end of a level are worth 25
' points each.
'
' Everything that matters stays in columns 2-29, inside the TV overscan.
' The frame loop is protected from the NMI. The title tune is the public
' domain "Jingle Bells"; the level jingle is the start of the traditional
' "We Wish You a Merry Christmas".

const TlStar = 128
const TlStarDim = 129
const TlMoonTL = 130
const TlMoonTR = 131
const TlMoonBL = 132
const TlMoonBR = 133
const TlRoofL = 134
const TlRoofM = 135
const TlRoofR = 136
const TlWallA = 137
const TlWallB = 138
const TlWinOff = 139
const TlWinOn = 140
const TlDoor = 141
const TlWreath = 142
const TlChimBody = 143
const TlChimTop = 144
const TlChimTopOn = 145
const TlSmoke1 = 146
const TlSmoke2 = 147
const TlSnow = 148
const TlSnow2 = 149
const TlFlake = 150
const TlArrowL = 151
const TlArrowR = 152
const TlTree00 = 153
const TlTree01 = 154
const TlTree02 = 155
const TlTree10 = 156
const TlTree11 = 157
const TlTree12 = 158
const TlTree20 = 159
const TlTree21 = 160
const TlTree22 = 161
const TlTree30 = 162
const TlTree31 = 163
const TlTree32 = 164
const TlLightR = 165
const TlLightG = 166
const TlLightY = 167
const TlLightB = 168
const SpWhiteR = 0
const SpWhiteL = 4
const SpNoseR = 8
const SpNoseL = 12
const SpSleighR = 16
const SpSleighL = 20
const SpDeerR1 = 24
const SpDeerR2 = 28
const SpDeerL1 = 32
const SpDeerL2 = 36
const SpGift = 40
const SpCrowR1 = 44
const SpCrowR2 = 48
const SpCrowL1 = 52
const SpCrowL2 = 56
const SpSpark = 60
const SpSplat = 64
const SpPuff = 68
const TileBytes = 328
const SpriteBytes = 576

const SndDrop = 1
const SndDing = 2
const SndPerfect = 3
const SndSplat = 4
const SndCaw = 5
const SndLevel = 6
const SndOver = 7
const SndGood = 8
const SndPick = 9
const SndTuneA = 10
const SndTuneB = 11

const SleighY = 38
const Houses = 5

u16 Score = 0
u16 HighScore = 500
u16 W16 = 0
u16 T16 = 0
u8 HighName[3]
u8 Level = 1
u8 Gifts = 8
u8 Done = 0
u8 LvlDone = 0
u8 Over = 0
u8 SX = 100                     ' the sleigh and its reindeer: left edge of the pair
u8 SY = SleighY
u8 SDir = 1                     ' 1 flying right, 0 flying left
u8 GalF = 0
u8 GalT = 0
u8 PrOn = 0                     ' a gift is falling
u8 PX = 0
u8 PY = 0
u8 WStr = 0                     ' wind strength 0-3 and direction 1 left, 2 right
u8 WDir = 0
u8 WRate = 6
u8 WCnt = 0
u8 CrOn = 0                     ' the crow
u8 CrX = 0
u8 CrY = 0
u8 CrDir = 0
u8 CrSpd = 1
u8 CrF = 0
u8 CrFT = 0
u8 CrT = 100
u8 EfT = 0                      ' the little burst where a gift lands
u8 EfX = 0
u8 EfY = 0
u8 EfP = 0
u8 EfC = 0
u8 MsgT = 0
u8 SmokeF = 0
u8 SmokeT = 0
u8 Tick = 0
u8 HR[5]                        ' each house: roof row, chimney column, delivered
u8 HC[5]
u8 HD[5]
u8 StarX[10]
u8 StarY[10]
u8 FlX[8]
u8 FlY[8]
u8 CX = 0
u8 ChX = 0
u8 TopY = 0
u8 Dd = 0
u8 Stick = 0
u8 Btn = 0
u8 BtnWas = 0
u8 Up = 0
u8 Wt = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 R = 0
u8 X = 0
u8 Y = 0
u8 Choice = 1

  tile screen
  set sound table XmasSoundTable areas 4
  sprites 16x16
  sprites stable 0 to 3
  sprites flicker on
  copy SpritePat count SpriteBytes to vram.spr_pat
  HideSprites
  LoadTiles
  HighName[0] = 83
  HighName[1] = 78
  HighName[2] = 84
  screen on

title:
  TitlePage

new_game:
  Score = 0
  Level = 1
  SX = 100
  SDir = 1
  SY = SleighY
  BtnWas = 1
  StartLevel
  Rearm
  wait no fire
  nmi off

main_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MoveSleigh
  MovePresent
  MoveCrow
  Animate
  DrawSprites
  if LvlDone = 1 then goto level_done
  if Over = 1 then goto lost
  goto main_loop

  ' --- every house has its gift ---
level_done:
  LvlDone = 0
  W16 = Gifts
  W16 *= 25
  Score += W16
  ShowStatus
  print at 5,8, "ALL FIVE HOUSES DONE!"
  print at 8,10, "GIFTS LEFT"
  print Gifts at 19,10 digits 1
  print at 8,11, "BONUS"
  print W16 at 14,11 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  inc Level
  StartLevel
  goto main_loop

  ' --- the sack is empty ---
lost:
  Over = 0
  play sound SndOver
  print at 6,8, "SANTA RAN OUT OF GIFTS!"
  print at 11,10, "GAME OVER"
  Rearm
  wait 150 frames
  nmi off
  ClearPanel
  print at 11,5, "GAME OVER"
  print at 8,7, "FINAL SCORE"
  print Score at 20,7 digits 5
  if Score > HighScore then
    HighScore = Score
    print at 8,9, "NEW HIGH SCORE!"
    play sound SndGood
    Rearm
    wait 60 frames
    nmi off
    EnterName
  end if
  ShowStatus
  print at 9,14, "ANOTHER GAME"
  print at 9,15, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,14 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

' "nmi on" reads the VDP status, so a frame interrupt lost to the guard race
' cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadStick:
  Stick = 0
  Btn = 0
  Up = 0
  if joypad(1).left then Stick = 1
  if joypad(2).left then Stick = 1
  if joypad(1).right then Stick = 2
  if joypad(2).right then Stick = 2
  if joypad(1).up then Up = 1
  if joypad(2).up then Up = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  return
end sub

' Fly the sleigh; a fresh press of fire drops a gift
sub MoveSleigh:
  if Stick = 1 then
    SDir = 0
    if SX > 8 then SX -= 2
  end if
  if Stick = 2 then
    SDir = 1
    if SX < 216 then SX += 2
  end if
  N = 0
  if Btn = 1 then
    if BtnWas = 0 then N = 1
  end if
  BtnWas = Btn
  if N = 0 then return
  if PrOn = 1 then return
  if Gifts = 0 then return
  X = SX
  if SDir = 0 then X += 16
  PX = X + 4
  PY = SleighY + 12
  PrOn = 1
  WCnt = 0
  dec Gifts
  play sound SndDrop
  ShowStatus
  return
end sub

' The gift falls two pixels a frame, pushed by the wind, and meets a crow or a roof
sub MovePresent:
  if PrOn = 0 then return
  if WStr > 0 then
    inc WCnt
    if WCnt >= WRate then
      WCnt = 0
      if WDir = 1 then
        if PX > 6 then dec PX
      else
        if PX < 240 then inc PX
      end if
    end if
  end if
  PY += 2
  ' a crow in the way?
  if CrOn = 1 then
    N = PX + 8
    if N > CrX then
      T16 = CrX
      T16 += 16
      if PX < T16 then
        N = PY + 8
        P = CrY + 2
        if N > P then
          P = CrY + 12
          if PY < P then
            PrOn = 0
            EfX = PX - 4
            EfY = PY - 4
            EfP = SpPuff
            EfC = 15
            EfT = 20
            play sound SndCaw
            Resolve
            return
          end if
        end if
      end if
    end if
  end if
  ' which house is below the middle of the gift?
  CX = PX + 4
  N = CX - 8
  K = 0
  while N >= 48
    N -= 48
    inc K
  end while
  R = HR[K]
  Y = R - 2
  Y <<= 3
  TopY = Y
  P = PY + 8
  if P < Y then return
  ' it has reached the height of the chimney top
  X = HC[K]
  X <<= 3
  ChX = X
  if CX >= X then
    N = X + 8
    if CX < N then
      Deliver
      return
    end if
  end if
  ' a miss: the gift lands on the roof
  PrOn = 0
  Y = R << 3
  EfX = PX - 4
  EfY = Y - 12
  EfP = SpSplat
  EfC = 11
  EfT = 20
  play sound SndSplat
  Resolve
  return
end sub

' A gift goes down the chimney of house K
sub Deliver:
  PrOn = 0
  EfX = ChX - 4
  EfY = TopY - 12
  EfP = SpSpark
  EfC = 11
  EfT = 24
  if HD[K] = 1 then
    play sound SndSplat
    Resolve
    return
  end if
  HD[K] = 1
  inc Done
  Score += 100
  Dd = CX - ChX
  N = 0
  if Dd = 3 then N = 1
  if Dd = 4 then N = 1
  if N = 1 then
    Score += 50
    if Gifts < 9 then inc Gifts
    play sound SndPerfect
    print at 7,9, "PERFECT! +1 GIFT +50"
    MsgT = 45
  else
    play sound SndDing
  end if
  DrawHouse
  ShowStatus
  Resolve
  return
end sub

' After every gift: is the level won, the game lost, or is there another go?
sub Resolve:
  PrOn = 0
  if Done >= Houses then
    LvlDone = 1
    return
  end if
  if Gifts = 0 then
    Over = 1
    return
  end if
  NewWind
  return
end sub

' A new wind for the next gift: none on level 1, stronger every level up to 3
sub NewWind:
  WStr = 0
  WDir = 0
  N = Level - 1
  if N > 3 then N = 3
  if N > 0 then
    WStr = random(0, N)
    if WStr > 0 then WDir = random(1, 2)
  end if
  WRate = 6
  if WStr = 2 then WRate = 3
  if WStr = 3 then WRate = 2
  WCnt = 0
  ShowWind
  return
end sub

sub ShowWind:
  fill 32 count 3 at 26,1
  if WStr = 0 then
    put char 45 at 27,1
    return
  end if
  N = TlArrowR
  if WDir = 1 then N = TlArrowL
  for J = 1 to WStr
    X = J + 25
    put char N at X,1
  next
  return
end sub

' Crows start on level 2, cross the sky and take any gift they touch
sub MoveCrow:
  if Level < 2 then return
  if CrOn = 0 then
    if CrT > 0 then
      dec CrT
      return
    end if
    CrOn = 1
    CrDir = random(0, 1)
    CrY = random(64, 84)
    CrSpd = 1
    if Level >= 3 then CrSpd = 2
    CrX = 240
    if CrDir = 1 then CrX = 0
    return
  end if
  if CrDir = 1 then
    CrX += CrSpd
    if CrX >= 240 then CrOn = 0
  else
    if CrX <= CrSpd then
      CrOn = 0
    else
      CrX -= CrSpd
    end if
  end if
  inc CrFT
  if CrFT >= 6 then
    CrFT = 0
    CrF = CrF ^ 4
  end if
  if CrOn = 0 then CrT = random(40, 120)
  return
end sub

' Gallop, chimney smoke, twinkling stars, falling snow, messages
sub Animate:
  inc GalT
  if GalT >= 5 then
    GalT = 0
    GalF = GalF ^ 4
  end if
  inc SmokeT
  if SmokeT >= 16 then
    SmokeT = 0
    SmokeF = SmokeF ^ 1
    DrawSmoke
  end if
  N = Tick & 15
  if N = 0 then Twinkle
  SnowStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 22 at 5,9
  end if
  return
end sub

sub DrawSmoke:
  for K = 0 to 4
    if HD[K] = 1 then
      N = HR[K]
      Y = N - 3
      X = HC[K]
      P = TlSmoke1
      if SmokeF = 1 then P = TlSmoke2
      put char P at X,Y
    end if
  next
  return
end sub

sub Twinkle:
  J = random(0, 9)
  X = StarX[J]
  Y = StarY[J]
  N = get char at X,Y
  if N = TlStar then
    put char TlStarDim at X,Y
  elseif N = TlStarDim then
    put char TlStar at X,Y
  end if
  return
end sub

' One snowflake a frame drops a row, never over anything already drawn
sub SnowStep:
  I = Tick & 7
  X = FlX[I]
  Y = FlY[I]
  N = get char at X,Y
  if N = TlFlake then put char 32 at X,Y
  inc Y
  if Y > 21 then
    Y = 2
    X = random(2, 29)
  end if
  N = get char at X,Y
  if N = 32 then put char TlFlake at X,Y
  FlX[I] = X
  FlY[I] = Y
  return
end sub

sub InitFlakes:
  for I = 0 to 7
    FlX[I] = random(2, 29)
    FlY[I] = random(2, 21)
  next
  return
end sub

' Santa, Rudolph and the sleigh: four sprites, the first three never flicker
sub DrawSleigh:
  X = SX + 16
  if SDir = 1 then
    set sprite 0 to SY,SX,SpWhiteR,15
    set sprite 1 to SY,X,SpNoseR,9
    set sprite 2 to SY,SX,SpSleighR,8
    P = SpDeerR1 + GalF
    set sprite 3 to SY,X,P,10
  else
    set sprite 0 to SY,X,SpWhiteL,15
    set sprite 1 to SY,SX,SpNoseL,9
    set sprite 2 to SY,X,SpSleighL,8
    P = SpDeerL1 + GalF
    set sprite 3 to SY,SX,P,10
  end if
  return
end sub

sub DrawSprites:
  DrawSleigh
  if PrOn = 1 then
    set sprite 4 to PY,PX,SpGift,11
  else
    set sprite 4 to 192,0,0,0
  end if
  if CrOn = 1 then
    P = SpCrowR1
    if CrDir = 0 then P = SpCrowL1
    P += CrF
    set sprite 5 to CrY,CrX,P,14
  else
    set sprite 5 to 192,0,0,0
  end if
  if EfT > 0 then
    dec EfT
    set sprite 6 to EfY,EfX,EfP,EfC
  else
    set sprite 6 to 192,0,0,0
  end if
  update sprites
  return
end sub

' A new level: new houses, a full sack, a fresh sky
sub StartLevel:
  nmi off
  Gifts = 6
  if Level = 1 then Gifts = 8
  if Level = 2 then Gifts = 7
  Done = 0
  LvlDone = 0
  Over = 0
  PrOn = 0
  CrOn = 0
  CrT = random(60, 120)
  EfT = 0
  MsgT = 0
  for K = 0 to 4
    HD[K] = 0
    HR[K] = random(15, 17)
    X = K
    X *= 6
    N = random(2, 5)
    X += N
    HC[K] = X
  next
  DrawField
  for K = 0 to 4
    DrawHouse
  next
  NewWind
  ShowStatus
  print at 11,9, "LEVEL"
  print Level at 17,9 digits 2
  MsgT = 50
  return
end sub

sub DrawField:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  cls
  backdrop black
  for I = 0 to 9
    N = I & 1
    if N = 0 then
      X = random(2, 24)
      Y = random(3, 10)
    else
      X = random(25, 29)
      Y = random(6, 10)
    end if
    StarX[I] = X
    StarY[I] = Y
    put char TlStar at X,Y
  next
  put char TlMoonTL at 26,3
  put char TlMoonTR at 27,3
  put char TlMoonBL at 26,4
  put char TlMoonBR at 27,4
  fill TlSnow count 32 at 0,22
  fill TlSnow2 count 32 at 0,23
  InitFlakes
  return
end sub

' House K: a snowy roof, brick or board walls, two windows, a wreathed door, a chimney
sub DrawHouse:
  X = K
  X *= 6
  inc X
  R = HR[K]
  put char TlRoofL at X,R
  N = X + 5
  put char TlRoofR at N,R
  for J = 1 to 4
    N = X + J
    put char TlRoofM at N,R
  next
  P = R + 1
  Wt = TlWallA
  N = K & 1
  if N = 1 then Wt = TlWallB
  for Y = P to 21
    for J = 0 to 5
      N = X + J
      put char Wt at N,Y
    next
  next
  Wt = TlWinOff
  if HD[K] = 1 then Wt = TlWinOn
  Y = R + 2
  N = X + 1
  put char Wt at N,Y
  N = X + 4
  put char Wt at N,Y
  N = X + 2
  put char TlDoor at N,20
  put char TlDoor at N,21
  N = X + 3
  put char TlWreath at N,20
  ' the chimney
  Y = R - 1
  X = HC[K]
  put char TlChimBody at X,Y
  Y = R - 2
  Wt = TlChimTop
  if HD[K] = 1 then Wt = TlChimTopOn
  put char Wt at X,Y
  return
end sub

sub ShowStatus:
  print at 2,0, "SCORE"
  print Score at 8,0 digits 5
  print at 16,0, "HIGH"
  print HighScore at 21,0 digits 5
  for J = 0 to 2
    X = J + 27
    N = HighName[J]
    put char N at X,0
  next
  print at 2,1, "GIFTS"
  print Gifts at 8,1 digits 1
  print at 11,1, "LEVEL"
  print Level at 17,1 digits 2
  print at 21,1, "WIND"
  return
end sub

sub EnterName:
  print at 6,13, "YOUR INITIALS:"
  print at 5,16, "UP/DOWN, FIRE: NEXT"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,13
  next
  X = I + 21
  fill 32 count 3 at 21,14
  put char 45 at X,14
  Rearm
  wait 8 frames
  nmi off
  ReadStick
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then goto name_done
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  K = 0
  if joypad(1).down then K = 1
  if joypad(2).down then K = 1
  if K = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
name_done:
  fill 32 count 3 at 21,14
  fill 32 count 20 at 5,16
  fill 32 count 20 at 5,13
  return
end sub

' Game over: clear the sky and the houses, leaving room for the score, the initials and the menu, between two trees
sub ClearPanel:
  HideSprites
  for Y = 2 to 21
    fill 32 count 32 at 0,Y
  next
  X = 2
  Y = 14
  DrawTree
  X = 27
  Y = 14
  DrawTree
  return
end sub

sub LoadTiles:
  W16 = 1024
  for J = 0 to 2
    copy TilePat count TileBytes to vram.pattern + W16
    copy TileCol count TileBytes to vram.color + W16
    W16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 7
  for J = 0 to 6
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' The title tree: 3 x 4 tiles with its top-left corner at column X, row Y
sub DrawTree:
  for I = 0 to 3
    for J = 0 to 2
      N = I * 3
      N += J
      N += TlTree00
      P = X + J
      R = Y + I
      put char N at P,R
    next
  next
  return
end sub

sub TitlePage:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  cls
  backdrop black
  for I = 0 to 31
    N = I & 3
    N += TlLightR
    put char N at I,0
    put char N at I,23
  next
  X = 2
  Y = 2
  DrawTree
  X = 27
  Y = 2
  DrawTree
  print at 7,3, "SANTA'S SLEIGH RUN"
  print at 8,5, "A CHRISTMAS GAME"
  print at 4,8, "DROP A GIFT DOWN EVERY"
  print at 4,9, "CHIMNEY BEFORE YOU RUN"
  print at 4,10, "OUT OF GIFTS!"
  print at 4,12, "STICK: FLY LEFT OR RIGHT"
  print at 4,13, "FIRE: DROP A GIFT"
  print at 4,14, "DEAD CENTRE: BONUS GIFT"
  print at 4,15, "BEWARE THE WIND AND CROWS"
  print at 7,17, "HIGH"
  print HighScore at 12,17 digits 5
  for J = 0 to 2
    X = J + 18
    N = HighName[J]
    put char N at X,17
  next
  print at 6,21, "PRESS FIRE TO START"
  InitFlakes
  SX = 8
  SDir = 1
  SY = 148
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
title_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  SnowStep
  inc GalT
  if GalT >= 5 then
    GalT = 0
    GalF = GalF ^ 4
  end if
  if SX >= 216 then SX = 8
  SX += 1
  DrawSleigh
  update sprites
  if Btn = 0 then goto title_loop
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  HideSprites
  return
end sub

' Tiles 128-: Star, StarDim, MoonTL, MoonTR, MoonBL, MoonBR, RoofL, RoofM, RoofR, WallA, WallB, WinOff, WinOn, Door, Wreath, ChimBody, ChimTop, ChimTopOn, Smoke1, Smoke2, Snow, Snow2, Flake, ArrowL, ArrowR, Tree00, Tree01, Tree02, Tree10, Tree11, Tree12, Tree20, Tree21, Tree22, Tree30, Tree31, Tree32, LightR, LightG, LightY, LightB
data TilePat bytes
  $00,$00,$10,$00,$00,$00,$00,$00,$00,$00,$00,$00,$04,$00,$00,$00
  $00,$0F,$1F,$3F,$7F,$79,$7F,$7F,$00,$F0,$F8,$FC,$CE,$FE,$FE,$FE
