u8 ClY[3]

  tile screen
  set sound table XmasSoundTable areas 4
  sprites 16x16
  sprites stable 0 to 3
  sprites flicker on
  HighName[0] = 83
  HighName[1] = 78
  HighName[2] = 84
  screen on

if defined DBG_SKIP_TITLE
  goto new_game
end defined

title:
  TitlePage

new_game:
  Score = 0
  Lives = 3
  Round = 0
  StageNo = 0
if defined DBG_STAGE_2
  StageNo = 1
end defined
if defined DBG_STAGE_3
  StageNo = 2
end defined
if defined DBG_STAGE_4
  StageNo = 3
end defined
if defined DBG_STAGE_5
  StageNo = 4
end defined
if defined DBG_ROUND_2
  Round = 1
end defined
if defined DBG_ROUND_3
  Round = 2
end defined
if defined DBG_ROUND_4
  Round = 3
end defined
if defined DBG_LIVES_5
  Lives = 5
end defined

stage_loop:
  StageIntro
  Result = 0
  if StageNo = 0 then PlayDelivery
  if StageNo = 1 then PlayFactory
  if StageNo = 2 then PlayDefense
  if StageNo = 3 then PlayIceWall
  if StageNo = 4 then PlaySkyDash
  if Result = 1 then goto stage_won
  if Lives = 0 then goto lost
  goto stage_loop

stage_won:
  inc StageNo
  if StageNo >= 5 then
    StageNo = 0
    inc Round
    if Lives < MaxLives then
      inc Lives
      Extra = 1
    end if
  end if
  goto stage_loop

  ' --- no lives left ---
lost:
  SetNo = 0
  NewScreen
  LightsLow
  X = 2
  Y = 14
  DrawTree
  X = 27
  Y = 14
  DrawTree
  print at 11,5, "GAME OVER"
  print at 8,7, "FINAL SCORE"
  print Score at 20,7 digits 5
  play sound SndOver
  Rearm
  wait 120 frames
  nmi off
  if Score > HighScore then
    HighScore = Score
    print at 8,9, "NEW HIGH SCORE!"
    play sound SndGood
    Rearm
    wait 60 frames
    nmi off
    EnterName
  end if
  ShowHud
  print at 9,14, "ANOTHER GAME"
  print at 9,15, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,14 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------
' Title, stage intro, stage clear, name entry
' ---------------------------------------------------------------------------

sub TitlePage:
  SetNo = 0
  NewScreen
  LightStrings
  X = 2
  Y = 2
  DrawTree
  X = 27
  Y = 2
  DrawTree
  print at 7,3, "SANTA'S SLEIGH RUN"
  print at 8,5, "A CHRISTMAS GAME"
  print at 4,8, "DELIVER GIFTS DOWN THE"
  print at 4,9, "CHIMNEYS, CATCH TOYS IN"
  print at 4,10, "THE FACTORY, FIGHT THE"
  print at 4,11, "COAL GOBLINS AND SMASH"
  print at 4,12, "THE GOBLINS' ICE WALL!"
  print at 4,14, "STICK: MOVE   FIRE: ACT"
  print at 4,15, "FIVE STAGES, THEN ROUND"
  print at 4,16, "AGAIN, HARDER AND HARDER"
  print at 7,18, "HIGH"
  print HighScore at 12,18 digits 5
  for J = 0 to 2
    X = J + 18
    N = HighName[J]
    put char N at X,18
  next
  print at 6,21, "PRESS FIRE TO START"
  InitFlakes
  SX = 8
  SDir = 1
  SY = 150
  GalF = 0
  play sound SndTuneTA
  play sound SndTuneTB
  Rearm
  wait no fire
  nmi off
title_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  SnowStep
  inc GalT
  if GalT >= 4 then
    GalT = 0
    inc GalF
    GalF &= 3
  end if
  if SX >= 216 then SX = 8
  SX += 1
  DrawSleigh
  update sprites
  if Btn = 0 then goto title_loop
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneTA
  stop sound SndTuneTB
  mute all
  HideSprites
  return
end sub

' Before every stage: round, rank, the stage's name and a line on what to do
sub StageIntro:
  SetNo = 0
  NewScreen
  LightsLow
  X = 2
  Y = 19
  DrawTree
  X = 27
  Y = 19
  DrawTree
  ShowHud
  print at 8,4, "ROUND"
  N = Round
  inc N
  print N at 14,4 digits 2
  print at 8,8, "RANK"
  PrintRank
  if StageNo = 0 then
    print at 6,11, "STAGE 1: DELIVERY"
    print at 4,13, "FLY OVER THE HOUSES AND"
    print at 4,14, "DROP A GIFT DOWN EVERY"
    print at 4,15, "CHIMNEY. DEAD CENTRE IS"
    print at 4,16, "WORTH A BONUS GIFT!"
  end if
  if StageNo = 1 then
    print at 5,11, "STAGE 2: TOY FACTORY"
    print at 4,13, "CATCH FALLING TOYS: JUST"
    print at 4,14, "STAND UNDER THEM. DODGE"
    print at 4,15, "THE COAL! FIRE = RUSH."
    print at 4,16, "SIX MISSES AND YOU LOSE."
  end if
  if StageNo = 2 then
    print at 5,11, "STAGE 3: COAL GOBLINS"
    print at 5,13, "THROW SNOWBALLS AT THE"
    print at 5,14, "GOBLINS. HIDE BEHIND THE"
    print at 5,15, "IGLOOS. SHOOT THE FLYING"
    print at 5,16, "FRUITCAKE FOR A BONUS!"
  end if
  if StageNo = 3 then
    print at 5,11, "STAGE 4: ICE WALL"
    print at 5,13, "THE GOBLINS WALLED UP THE"
    print at 5,14, "GIFTS IN ICE! BOUNCE THE"
    print at 5,15, "SNOWBALL OFF YOUR SLEIGH"
    print at 5,16, "AND SMASH EVERY BLOCK."
  end if
  if StageNo = 4 then
    print at 5,11, "STAGE 5: SKY DASH"
    print at 5,13, "FLY THE SLEIGH THROUGH A"
    print at 5,14, "SKY OF PLANES, BALLOONS"
    print at 5,15, "AND BIRDS. STICK MOVES UP,"
    print at 5,16, "DOWN, LEFT, RIGHT. GRAB GIFTS!"
  end if
  if Extra = 1 then
    Extra = 0
    print at 10,19, "EXTRA LIFE!"
    play sound SndExtra
  else
    play sound SndStart
  end if
  Rearm
  wait 130 frames
  nmi off
  return
end sub

sub EnterName:
  print at 6,13, "YOUR INITIALS:"
  print at 5,16, "UP/DOWN, FIRE: NEXT"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,13
  next
  X = I + 21
  fill 32 count 3 at 21,14
  put char 45 at X,14
  Rearm
  wait 8 frames
  nmi off
  ReadStick
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then goto name_done
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  if Down = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
name_done:
  fill 32 count 3 at 21,14
  fill 32 count 20 at 5,16
  fill 32 count 20 at 5,13
  return
end sub

' ---------------------------------------------------------------------------
' Shared routines
' ---------------------------------------------------------------------------

' "nmi on" reads the VDP status, so a frame interrupt lost to the guard race
' cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadStick:
  Stick = 0
  Btn = 0
  Up = 0
  Down = 0
  if joypad(1).left then Stick = 1
  if joypad(2).left then Stick = 1
  if joypad(1).right then Stick = 2
  if joypad(2).right then Stick = 2
  if joypad(1).up then Up = 1
  if joypad(2).up then Up = 1
  if joypad(1).down then Down = 1
  if joypad(2).down then Down = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  return
end sub

' Unpack an art set (ZX0) into all three thirds of the pattern and colour tables, and its sprites.
' SetNo: 0 title, 1 delivery, 2 factory, 3 defence
sub LoadSet:
  W16 = 1024
  for J = 0 to 2
    if SetNo = 0 then
      decompress zx0 PatT to vram.pattern + W16
      decompress zx0 ColT to vram.color + W16
    end if
    if SetNo = 1 then
      decompress zx0 PatA to vram.pattern + W16
      decompress zx0 ColA to vram.color + W16
    end if
    if SetNo = 2 then
      decompress zx0 PatB to vram.pattern + W16
      decompress zx0 ColB to vram.color + W16
    end if
    if SetNo = 3 then
      decompress zx0 PatC to vram.pattern + W16
      decompress zx0 ColC to vram.color + W16
    end if
    if SetNo = 4 then
      decompress zx0 PatD to vram.pattern + W16
      decompress zx0 ColD to vram.color + W16
    end if
    if SetNo = 5 then
      decompress zx0 PatE to vram.pattern + W16
      decompress zx0 ColE to vram.color + W16
    end if
    W16 += 2048
  next
  if SetNo < 2 then
    decompress zx0 SprA to vram.spr_pat
  end if
  if SetNo = 2 then
    decompress zx0 SprB to vram.spr_pat
  end if
  if SetNo = 3 then
    decompress zx0 SprC to vram.spr_pat
  end if
  if SetNo = 4 then
    decompress zx0 SprD to vram.spr_pat
  end if
  if SetNo = 5 then
    decompress zx0 SprE to vram.spr_pat
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 16
  for J = 0 to 15
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' A new screen: clean pattern/colour state, the right art set, a black sky
sub NewScreen:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadSet
  cls
  backdrop black
  EfT = 0
  MsgT = 0
  return
end sub

sub ShowLives:
  for J = 0 to 4
    X = J + 2
    if J < Lives then
      put char TlHeart at X,1
    else
      put char 32 at X,1
    end if
  next
  return
end sub

sub ShowHud:
  print at 2,0, "SCORE"
  print Score at 8,0 digits 5
  print at 16,0, "HIGH"
  print HighScore at 21,0 digits 5
  for J = 0 to 2
    X = J + 27
    N = HighName[J]
    put char N at X,0
  next
  ShowLives
  return
end sub

' Stars (never over the HUD or the moon) and falling snow
sub DrawStars:
  for I = 0 to 9
    N = I & 1
    if N = 0 then
      X = random(2, 24)
      Y = random(3, 10)
    else
      X = random(25, 29)
      Y = random(6, 10)
    end if
    StarX[I] = X
    StarY[I] = Y
    put char TlStar at X,Y
  next
  InitFlakes
  return
end sub

sub DrawMoon:
  put char TlMoonTL at 26,3
  put char TlMoonTR at 27,3
  put char TlMoonBL at 26,4
  put char TlMoonBR at 27,4
  return
end sub

sub Twinkle:
  J = random(0, 9)
  X = StarX[J]
  Y = StarY[J]
  N = get char at X,Y
  if N = TlStar then
    put char TlStarDim at X,Y
  elseif N = TlStarDim then
    put char TlStar at X,Y
  end if
  return
end sub

' One snowflake a frame drops a row, never over anything already drawn
sub SnowStep:
  I = Tick & 7
  X = FlX[I]
  Y = FlY[I]
  N = get char at X,Y
  if N = TlFlake then put char 32 at X,Y
  inc Y
  if Y > 21 then
    Y = 2
    X = random(2, 29)
  end if
  N = get char at X,Y
  if N = 32 then put char TlFlake at X,Y
  FlX[I] = X
  FlY[I] = Y
  return
end sub

sub InitFlakes:
  for I = 0 to 7
    FlX[I] = random(2, 29)
    FlY[I] = random(2, 21)
  next
  return
end sub

' A burst of sparkle, dust or a splat plays its four frames, which come four patterns apart,
' on sprite EfS: EfP is the first frame
sub DrawEffect:
  if EfT > 0 then
    N = EfT
    dec EfT
    N >>= 3
    N = 3 - N
    N <<= 2
    N += EfP
    set sprite EfS to EfY,EfX,N,EfC
  else
    set sprite EfS to 192,0,0,0
  end if
  return
end sub

' The title tree: 3 x 4 tiles with its top-left corner at column X, row Y
sub DrawTree:
  for I = 0 to 3
    for J = 0 to 2
      N = I * 3
      N += J
      N += TlTree00
      P = X + J
      R = Y + I
      put char N at P,R
    next
  next
  return
end sub

' only the bottom string, for screens that show the score at the top
sub LightsLow:
  for I = 0 to 31
    N = I & 3
    N += TlLightR
    put char N at I,23
  next
  return
end sub

sub LightStrings:
  for I = 0 to 31
    N = I & 3
    N += TlLightR
    put char N at I,0
    put char N at I,23
  next
  return
end sub

' Santa's rank grows with every round through the five stages
sub PrintRank:
  if Round = 0 then print at 14,8, "ELF"
  if Round = 1 then print at 14,8, "HEAD ELF"
  if Round = 2 then print at 14,8, "REINDEER"
  if Round = 3 then print at 14,8, "SLEIGH PILOT"
  if Round = 4 then print at 14,8, "NORTH POLE HERO"
  if Round > 4 then print at 14,8, "FATHER CHRISTMAS"
  return
end sub

' --- stage music: each tune is two Tiny Sound voices, restarted when it has played through ---
sub StartMusic:
  MusT = 0
  if StageNo = 0 then
    play sound SndTuneAA
    play sound SndTuneAB
  end if
  if StageNo = 1 then
    play sound SndTuneBA
    play sound SndTuneBB
  end if
  if StageNo = 2 then
    play sound SndTuneCA
    play sound SndTuneCB
  end if
  if StageNo = 3 then
    play sound SndTuneDA
    play sound SndTuneDB
  end if
  if StageNo = 4 then
    play sound SndTuneEA
    play sound SndTuneEB
  end if
  return
end sub

sub MusicTick:
  MusT += 1
  T16 = LenA
  if StageNo = 1 then T16 = LenB
  if StageNo = 2 then T16 = LenC
  if StageNo = 3 then T16 = LenD
  if StageNo = 4 then T16 = LenE
  if MusT >= T16 then StartMusic
  return
end sub

sub StopMusic:
  stop sound SndTuneAA
  stop sound SndTuneAB
  stop sound SndTuneBA
  stop sound SndTuneBB
  stop sound SndTuneCA
  stop sound SndTuneCB
  stop sound SndTuneDA
  stop sound SndTuneDB
  stop sound SndTuneEA
  stop sound SndTuneEB
  mute all
  return
end sub

' a life is lost (never, with the DBG_GOD shortcut)
sub LoseOne:
if defined DBG_GOD
  return
else defined
  dec Lives
end defined
  return
end sub

' ---------------------------------------------------------------------------
' Stage 1: the delivery.  Fly Santa's sleigh over five houses and drop a gift
' down every chimney.  Wind and crows arrive from round 2.
' ---------------------------------------------------------------------------

sub PlayDelivery:
  SetNo = 1
  NewScreen
  Gifts = 6
  if Round = 0 then Gifts = 8
  if Round = 1 then Gifts = 7
  Done = 0
  LvlDone = 0
  Over = 0
  PrOn = 0
  CrOn = 0
  CrT = random(60, 120)
  WaveT = 0
  SmokeT = 0
  SmokePh = 0
  SX = 100
  SDir = 1
  SY = SleighY
  GalF = 0
  GalT = 0
  Street = 0
  Streets = 2
  if Round >= 2 then Streets = 3
  Heat = Round
  MakeStreet
  DrawStars
  DrawMoon
  for J = 0 to 31
    N = J & 1
    N += TlSnow0
    put char N at J,22
    N = J & 1
    N += TlSnow1
    put char N at J,23
  next
  DrawStreet
  NewWind
  ShowHud
  ShowGiftHud
  print at 7,9, "DELIVER THE GIFTS!"
  MsgT = 50
  BtnWas = 1
  Rearm
  wait no fire
  nmi off
  StartMusic
da_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MusicTick
  MoveSleigh
  MovePresent
  MoveCrow
  AnimateDelivery
  DrawSpritesDelivery
  if LvlDone = 1 then goto da_done
  if Over = 1 then goto da_fail
  goto da_loop

  ' --- every house has its gift ---
da_done:
  inc Street
  if Street >= Streets then goto da_final
  Score += 200
  Gifts += 4
  if Gifts > 9 then Gifts = 9
  Heat = Round
  Heat += Street
  play sound SndLevel
  fill 32 count 28 at 2,9
  print at 5,9, "STREET CLEAR! +4 GIFTS"
  MsgT = 90
  LvlDone = 0
  PrOn = 0
  CrOn = 0
  CrT = random(40, 90)
  MakeStreet
  Rearm
  wait 70 frames
  nmi off
  DrawStreet
  NewWind
  ShowHud
  ShowGiftHud
  goto da_loop

da_final:
  W16 = Gifts
  W16 *= 25
  Score += W16
  ShowHud
  fill 32 count 28 at 2,9
  print at 5,7, "ALL FIVE HOUSES DONE!"
  print at 8,9, "GIFTS LEFT"
  print Gifts at 19,9 digits 1
  print at 8,10, "BONUS"
  print W16 at 14,10 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  Result = 1
  return

  ' --- the sack is empty ---
da_fail:
  StopMusic
  LoseOne
  play sound SndOver
  print at 6,7, "SANTA RAN OUT OF GIFTS!"
  ShowLives
  Rearm
  wait 120 frames
  nmi off
  Result = 0
  return
end sub

' Five new houses: random roofs, random chimneys
sub MakeStreet:
  Done = 0
  for K = 0 to 4
    HD[K] = 0
    HR[K] = random(15, 17)
    X = K
    X *= 6
    N = random(2, 5)
    X += N
    HC[K] = X
  next
  return
end sub

' The houses under the sky: clears the old street first
sub DrawStreet:
  for Y = 11 to 21
    fill 32 count 32 at 0,Y
  next
  for K = 0 to 4
    DrawHouse
  next
  return
end sub

sub ShowGiftHud:
  print at 8,1, "GIFTS"
  print Gifts at 14,1 digits 1
  print at 17,1, "WIND"
  return
end sub

' Fly the sleigh; a fresh press of fire drops a gift
sub MoveSleigh:
  if Stick = 1 then
    SDir = 0
    if SX > 8 then SX -= 2
  end if
  if Stick = 2 then
    SDir = 1
    if SX < 216 then SX += 2
  end if
  N = 0
  if Btn = 1 then
    if BtnWas = 0 then N = 1
  end if
  BtnWas = Btn
  if N = 0 then return
  if PrOn = 1 then return
  if Gifts = 0 then return
  X = SX
  if SDir = 0 then X += 16
  PX = X + 4
  PY = SY + 12
  PrOn = 1
  WCnt = 0
  N = random(0, 3)
  GiftC = 8
  if N = 1 then GiftC = 3
  if N = 2 then GiftC = 5
  if N = 3 then GiftC = 13
  dec Gifts
  play sound SndDrop
  ShowGiftHud
  return
end sub

' The gift falls two pixels a frame, pushed by the wind, and meets a crow or a roof
sub MovePresent:
  if PrOn = 0 then return
  if WStr > 0 then
    inc WCnt
    if WCnt >= WRate then
      WCnt = 0
      if WDir = 1 then
        if PX > 6 then dec PX
      else
        if PX < 240 then inc PX
      end if
    end if
  end if
  PY += 2
  ' a crow in the way?
  if CrOn = 1 then
    N = PX + 8
    if N > CrX then
      T16 = CrX
      T16 += 16
      if PX < T16 then
        N = PY + 8
        P = CrY + 2
        if N > P then
          P = CrY + 12
          if PY < P then
            PrOn = 0
            EfX = PX - 4
            EfY = PY - 4
            EfP = SpPuff0
            EfC = 15
            EfT = 24
            play sound SndCaw
            Resolve
            return
          end if
        end if
      end if
    end if
  end if
  ' which house is below the middle of the gift?
  CX = PX + 4
  N = CX - 8
  K = 0
  while N >= 48
    N -= 48
    inc K
  end while
  R = HR[K]
  Y = R - 2
  Y <<= 3
  TopY = Y
  P = PY + 8
  if P < Y then return
  ' it has reached the height of the chimney top
  X = HC[K]
  X <<= 3
  ChX = X
  if CX >= X then
    N = X + 8
    if CX < N then
      Deliver
      return
    end if
  end if
  ' a miss: the gift lands on the roof
  PrOn = 0
  Y = R << 3
  EfX = PX - 4
  EfY = Y - 12
  EfP = SpSplat0
  EfC = 11
  EfT = 24
  play sound SndSplat
  Resolve
  return
end sub

' A gift goes down the chimney of house K
sub Deliver:
  PrOn = 0
  EfX = ChX - 4
  EfY = TopY - 12
  EfP = SpSpark0
  EfC = 11
  EfT = 24
  if HD[K] = 1 then
    play sound SndSplat
    Resolve
    return
  end if
  HD[K] = 1
  inc Done
  Score += 100
  WaveT = 50
  Dd = CX - ChX
  N = 0
  if Dd = 3 then N = 1
  if Dd = 4 then N = 1
  if N = 1 then
    Score += 50
    if Gifts < 9 then inc Gifts
    play sound SndPerfect
    print at 7,9, "PERFECT! +1 GIFT +50"
    MsgT = 45
  else
    play sound SndDing
  end if
  UpdateHouse
  ShowHud
  ShowGiftHud
  Resolve
  return
end sub

' After every gift: is the stage won, lost, or is there another go?
sub Resolve:
  PrOn = 0
  if Done >= Houses then
    LvlDone = 1
    return
  end if
  if Gifts = 0 then
    Over = 1
    return
  end if
  NewWind
  return
end sub

' A new wind for the next gift: none in round 1, stronger every round up to 3
sub NewWind:
  WStr = 0
  WDir = 0
  N = Heat
  if N > 3 then N = 3
  if N > 0 then
    WStr = random(0, N)
    if WStr > 0 then WDir = random(1, 2)
  end if
  WRate = 6
  if WStr = 2 then WRate = 3
  if WStr = 3 then WRate = 2
  WCnt = 0
  ShowWind
  return
end sub

sub ShowWind:
  fill 32 count 3 at 22,1
  if WStr = 0 then
    put char 45 at 23,1
    return
  end if
  N = TlArrowR
  if WDir = 1 then N = TlArrowL
  for J = 1 to WStr
    X = J + 21
    put char N at X,1
  next
  return
end sub

' Crows start in round 2, cross the sky and take any gift they touch
sub MoveCrow:
  if Heat < 1 then return
  if CrOn = 0 then
    if CrT > 0 then
      dec CrT
      return
    end if
    CrOn = 1
    CrDir = random(0, 1)
    CrY = random(64, 84)
    CrSpd = 1
    if Heat >= 2 then CrSpd = 2
    CrX = 240
    if CrDir = 1 then CrX = 0
    return
  end if
  if CrDir = 1 then
    CrX += CrSpd
    if CrX >= 240 then CrOn = 0
  else
    if CrX <= CrSpd then
      CrOn = 0
    else
      CrX -= CrSpd
    end if
  end if
  inc CrFT
  if CrFT >= 3 then
    CrFT = 0
    inc CrF
    CrF &= 3
  end if
  if CrOn = 0 then CrT = random(40, 120)
  return
end sub

' Gallop, chimney smoke, twinkling lights and stars, falling snow, messages
sub AnimateDelivery:
  inc GalT
  if GalT >= 4 then
    GalT = 0
    inc GalF
    GalF &= 3
  end if
  if WaveT > 0 then dec WaveT
  inc SmokeT
  if SmokeT >= 10 then
    SmokeT = 0
    inc SmokePh
    SmokePh &= 3
    DrawLife
  end if
  N = Tick & 15
  if N = 0 then Twinkle
  SnowStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 22 at 5,9
  end if
  return
end sub

' Delivered houses: rising smoke and twinkling eave lights
sub DrawLife:
  for K = 0 to 4
    if HD[K] = 1 then
      R = HR[K]
      X = HC[K]
      Y = R - 3
      if SmokePh = 3 then
        put char 32 at X,Y
      else
        N = TlSmoke0 + SmokePh
        put char N at X,Y
      end if
      Y = R - 4
      N = 32
      if SmokePh = 2 then N = TlSmoke0
      if SmokePh = 3 then N = TlSmoke3
      put char N at X,Y
      DrawEave
    end if
  next
  return
end sub

' The soffit under house K's roof: dark until a gift arrives, then coloured lights
sub DrawEave:
  X = K
  X *= 6
  inc X
  R = HR[K]
  Y = R + 1
  for J = 0 to 5
    N = TlEaveOff
    if HD[K] = 1 then
      N = J + SmokePh
      N &= 3
      N += TlEaveR
    end if
    P = X + J
    put char N at P,Y
  next
  return
end sub

' Santa, Rudolph and the sleigh: four sprites, the first three never flicker
sub DrawSleigh:
  X = SX + 16
  N = Tick
  N >>= 4
  N &= 1
  P = GalF
  P <<= 2
  if SDir = 1 then
    Wt = SpWhite0R
    if WaveT > 0 then Wt = SpWhite1R
    set sprite 0 to SY,SX,Wt,15
    Wt = SpNose0R
    if N = 1 then Wt = SpNose1R
    set sprite 1 to SY,X,Wt,9
    set sprite 2 to SY,SX,SpSleighR,8
    P += SpDeerR0
    set sprite 3 to SY,X,P,10
  else
    Wt = SpWhite0L
    if WaveT > 0 then Wt = SpWhite1L
    set sprite 0 to SY,X,Wt,15
    Wt = SpNose0L
    if N = 1 then Wt = SpNose1L
    set sprite 1 to SY,SX,Wt,9
    set sprite 2 to SY,X,SpSleighL,8
    P += SpDeerL0
    set sprite 3 to SY,SX,P,10
  end if
  return
end sub

sub DrawSpritesDelivery:
  N = Tick
  N >>= 3
  N &= 3
  SY = SleighY
  if N = 1 then inc SY
  if N = 2 then inc SY
  DrawSleigh
  if PrOn = 1 then
    N = Tick
    N >>= 2
    N &= 3
    N <<= 2
    P = N + SpGiftRib0
    set sprite 4 to PY,PX,P,11
    P = N + SpGiftBox0
    set sprite 5 to PY,PX,P,GiftC
    P = N + SpGiftShine0
    set sprite 8 to PY,PX,P,15
  else
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
    set sprite 8 to 192,0,0,0
  end if
  if CrOn = 1 then
    P = CrF
    P <<= 2
    if CrDir = 1 then
      P += SpCrowR0
    else
      P += SpCrowL0
    end if
    set sprite 6 to CrY,CrX,P,14
  else
    set sprite 6 to 192,0,0,0
  end if
  EfS = 7
  DrawEffect
  update sprites
  return
end sub

' House K: a snowy roof, walls, a wreathed door, then the parts that change when a gift arrives
sub DrawHouse:
  X = K
  X *= 6
  inc X
  R = HR[K]
  I = K
  if I >= 3 then I -= 3
  N = I * 3
  N += TlRoof0L
  put char N at X,R
  inc N
  for J = 1 to 4
    P = X + J
    put char N at P,R
  next
  inc N
  P = X + 5
  put char N at P,R
  Wt = I
  Wt += TlWall0
  P = R + 2
  for Y = P to 21
    for J = 0 to 5
      N = X + J
      put char Wt at N,Y
    next
  next
  N = X + 2
  put char TlDoor at N,20
  put char TlDoor at N,21
  N = X + 3
  put char TlWreath at N,20
  UpdateHouse
  return
end sub

' Eave lights, windows and chimney top of house K: dark before its gift, lit after
sub UpdateHouse:
  DrawEave
  X = K
  X *= 6
  inc X
  R = HR[K]
  Wt = TlWinOff
  if HD[K] = 1 then Wt = TlWinOn
  Y = R + 2
  N = X + 1
  put char Wt at N,Y
  N = X + 4
  put char Wt at N,Y
  Y = R - 1
  X = HC[K]
  put char TlChimBody at X,Y
  Y = R - 2
  Wt = TlChimTop
  if HD[K] = 1 then Wt = TlChimTopOn
  put char Wt at X,Y
  return
end sub

' ---------------------------------------------------------------------------
' Stage 2: the toy factory.  Toys drop from three hoppers onto a conveyor belt
' that slowly drags Santa along; catch them in his sack and avoid the coal.
' ---------------------------------------------------------------------------

sub PlayFactory:
  SetNo = 2
  NewScreen
  Need = Round * 3
  Need += 12
  if Need > 27 then Need = 27
if defined DBG_QUICK
  Need = 3
end defined
  Caught = 0
  Misses = 0
  Combo = 0
  BeltDir = 1
  BeltT = 0
  SpawnT = 60
  BulgeT = 0
  SWF = 0
  SWT = 0
  SX = 120
  DashT = 0
  DashCD = 0
  LastDir = 2
  HappyT = 0
  SadT = 0
  SootT = 0
  for I = 0 to 3
    ToyS[I] = 0
  next
  DrawFactory
  ShowHud
  ShowFactoryHud
  print at 8,9, "CATCH THE TOYS!"
  MsgT = 50
  BtnWas = 1
  Rearm
  wait no fire
  nmi off
  StartMusic
fa_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MusicTick
  MoveSanta
  SpawnToy
  MoveToys
  AnimateFactory
  DrawSpritesFactory
  if Caught >= Need then goto fa_done
  if Misses >= MissMax then goto fa_fail
  goto fa_loop

fa_done:
  StopMusic
  W16 = Need
  W16 *= 10
  Score += W16
  ShowHud
  print at 4,7, "THE SACK IS FULL!"
  print at 8,9, "STAGE BONUS"
  print W16 at 20,9 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  Result = 1
  return

fa_fail:
  StopMusic
  LoseOne
  play sound SndOver
  print at 3,7, "TOO MANY TOYS ON THE FLOOR!"
  ShowLives
  Rearm
  wait 120 frames
  nmi off
  Result = 0
  return
end sub

' the rush is ready when a D shows next to the belt arrow
sub ShowDash:
  N = 45
  if DashCD = 0 then N = 68
  put char N at 29,1
  return
end sub

sub ShowFactoryHud:
  print at 8,1, "TOYS"
  print Caught at 13,1 digits 2
  print at 15,1, "/"
  print Need at 16,1 digits 2
  print at 19,1, "MISS"
  print Misses at 24,1 digits 1
  print at 25,1, "/6"
  N = TlArrowR
  if BeltDir = 2 then N = TlArrowL
  put char N at 27,1
  ShowDash
  return
end sub

' The workshop: panelled wall, ceiling pipe, three hoppers, shelves, gears, the belt and the floor
sub DrawFactory:
  for Y = 2 to 21
    N = Y & 3
    if N = 2 then
      Wt = TlWallP1
    elseif N = 0 then
      Wt = TlWallP0
    else
      Wt = TlWallP2
    end if
    fill Wt count 32 at 0,Y
  next
  fill TlPipeH count 32 at 0,2
  for I = 0 to 2
    X = I * 9
    X += 6
    put char TlPipeJ at X,2
    put char TlLampOff at X,3
    P = X - 1
    put char TlHopTL at P,4
    put char TlHopTM at X,4
    P = X + 1
    put char TlHopTR at P,4
    P = X - 1
    put char TlHopBL at P,5
    put char TlHopBM at X,5
    P = X + 1
    put char TlHopBR at P,5
  next
  for Y = 11 to 16 step 5
    for X = 2 to 29
      N = X % 5
      N += TlShelfA
      put char N at X,Y
    next
  next
  for J = 0 to 31
    N = J & 1
    N += TlMetal0
    put char N at J,22
    put char N at J,23
  next
  DrawBelt
  DrawGears
  return
end sub

sub DrawBelt:
  N = Tick
  N >>= 1
  N &= 3
  if BeltDir = 1 then N = 3 - N
  N += TlBelt0
  fill N count 32 at 0,21
  return
end sub

sub DrawGears:
  N = Tick
  N >>= 3
  N &= 3
  P = N * 4
  P += TlGear00
  put char P at 2,7
  inc P
  put char P at 3,7
  inc P
  put char P at 2,8
  inc P
  put char P at 3,8
  N = 3 - N
  P = N * 4
  P += TlGear00
  put char P at 28,7
  inc P
  put char P at 29,7
  inc P
  put char P at 28,8
  inc P
  put char P at 29,8
  return
end sub

' Walk the sack left and right; the belt drags Santa along.  Fire is a rush: a quick dash the way he is
' walking (or last walked), then a short wait before the next one.
sub MoveSanta:
  if Stick = 1 then LastDir = 1
  if Stick = 2 then LastDir = 2
  N = 0
  if Btn = 1 then
    if BtnWas = 0 then N = 1
  end if
  BtnWas = Btn
  if N = 1 then
    if DashCD = 0 then
      DashT = 10
      DashCD = 40
      DashDir = LastDir
      play sound SndDash
      EfX = SX
      EfY = SantaY + 4
      EfP = SpPuff0
      EfC = 15
      EfT = 24
      ShowDash
    end if
  end if
  if DashCD > 0 then
    dec DashCD
    if DashCD = 0 then ShowDash
  end if
  if DashT > 0 then
    dec DashT
    if DashDir = 1 then
      if SX > 20 then
        SX -= 5
      else
        SX = 16
      end if
    else
      if SX < 220 then
        SX += 5
      else
        SX = 224
      end if
    end if
    SWF = 1
    return
  end if
  if Stick = 1 then
    if SX > 16 then SX -= 2
  end if
  if Stick = 2 then
    if SX < 224 then SX += 2
  end if
  if Stick = 0 then
    SWF = 0
  else
    inc SWT
    if SWT >= 4 then
      SWT = 0
      inc SWF
      SWF &= 3
    end if
  end if
  N = Round
  if N > 2 then N = 2
  N = 4 - N
  P = Tick % N
  if P = 0 then
    if BeltDir = 1 then
      if SX < 224 then inc SX
    else
      if SX > 16 then dec SX
    end if
  end if
  return
end sub

' A hopper lights its lamp, then lets a toy go
sub SpawnToy:
  if SpawnT > 0 then
    dec SpawnT
    return
  end if
  for I = 0 to 3
    if ToyS[I] = 0 then goto fa_spawn
  next
  SpawnT = 10
  return
fa_spawn:
  ToyS[I] = 1
  ToyW[I] = 24
  N = random(0, 2)
  ToyH[I] = N
  X = N * 9
  X += 6
  put char TlLampOn at X,3
  X = X * 8
  X -= 4
  ToyX[I] = X
  ToyY[I] = 46
  N = random(0, 5)
  if Round = 0 then N = random(0, 7)
  K = N
  if N > 5 then K = 6
  ToyK[I] = K
  N = Round * 8
  N = 64 - N
  if N < 32 then N = 32
  SpawnT = random(0, 15)
  SpawnT += N
  return
end sub

sub MoveToys:
  for I = 0 to 3
    if ToyS[I] = 1 then
      dec ToyW[I]
      if ToyW[I] = 0 then
        ToyS[I] = 2
        X = ToyH[I]
        X *= 9
        X += 6
        put char TlLampOff at X,3
      end if
    end if
    if ToyS[I] = 2 then
      Y = ToyY[I]
      N = Y >> 6
      inc N
      if Round >= 3 then inc N
      Y += N
      ToyY[I] = Y
      if Y >= 126 then
        if Y < 150 then
          X = ToyX[I]
          if X >= SX then
            P = X - SX
          else
            P = SX - X
          end if
          if P <= 12 then
            ToyS[I] = 0
            CatchToy
          end if
        end if
      end if
      if ToyS[I] = 2 then
        if Y >= 154 then
          ToyS[I] = 0
          LandToy
        end if
      end if
    end if
  next
  return
end sub

' Toy I lands in the sack
sub CatchToy:
  BulgeT = 8
  HappyT = 14
  EfX = SX
  EfY = SantaY - 14
  if ToyK[I] = 6 then
    Misses += 2
    Combo = 0
    EfP = SpPuff0
    EfC = 14
    EfT = 24
    HappyT = 0
    SadT = 40
    SootT = 70
    play sound SndCoal
    ShowFactoryHud
    return
  end if
  N = Combo
  inc N
  W16 = N * 50
  Score += W16
  if Combo < 3 then inc Combo
  inc Caught
  EfP = SpSpark0
  EfC = 11
  EfT = 24
  play sound SndCatch
  ShowHud
  ShowFactoryHud
  return
end sub

' Toy I reaches the belt: a lump of coal is no loss, a toy is
sub LandToy:
  play sound SndClunk
  if ToyK[I] = 6 then return
  inc Misses
  Combo = 0
  SadT = 28
  EfX = ToyX[I]
  EfY = 152
  EfP = SpSplat0
  EfC = 11
  EfT = 24
  ShowFactoryHud
  return
end sub

sub AnimateFactory:
  N = Tick & 1
  if N = 0 then DrawBelt
  N = Tick & 7
  if N = 0 then DrawGears
  if BulgeT > 0 then dec BulgeT
  if HappyT > 0 then dec HappyT
  if SadT > 0 then dec SadT
  if SootT > 0 then dec SootT
  inc BeltT
  if BeltT >= 200 then
    BeltT = 0
    if Round > 0 then
      BeltDir = 3 - BeltDir
      ShowFactoryHud
    end if
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill TlWallP2 count 22 at 5,9
  end if
  return
end sub

' body and accent colours of toy K
sub ToyColor:
  P = 10
  Wt = 15
  if K = 1 then
    P = 8
    Wt = 11
  end if
  if K = 2 then
    P = 5
    Wt = 15
  end if
  if K = 3 then
    P = 13
    Wt = 11
  end if
  if K = 4 then
    P = 3
    Wt = 9
  end if
  if K = 5 then
    P = 11
    Wt = 9
  end if
  if K = 6 then
    P = 14
    Wt = 9
  end if
  return
end sub

' Santa: his face and mittens (white), his suit (red), the sack above; four toys in two colours each
sub DrawSpritesFactory:
  Y = SantaY
  X = SX
  P = SWF
  P <<= 2
  P += SpSanta0
  N = SpSantaW
  K = SpSack0
  if BulgeT > 0 then K = SpSack1
  if HappyT > 0 then
    Y -= 3
    P = SpSantaH
    N = SpSantaWH
  end if
  if SadT > 0 then
    K = SpSack2
    J = Tick
    J >>= 1
    J &= 1
    X += J
    P = SpSanta0
  end if
  J = 15
  if SootT > 0 then J = 14
  set sprite 0 to Y,X,N,J
  set sprite 1 to Y,X,P,8
  Y -= 10
  set sprite 2 to Y,X,K,10
  for I = 0 to 3
    if ToyS[I] = 2 then
      K = ToyK[I]
      N = K * 16
      N += SpTeddyB0
      Y = Tick
      Y >>= 3
      Y &= 1
      Y <<= 3
      N += Y
      ToyColor
      Y = ToyY[I]
      X = ToyX[I]
      J = I * 2
      J += 3
      set sprite J to Y,X,N + 4,Wt
      inc J
      set sprite J to Y,X,N,P
    else
      J = I * 2
      J += 3
      set sprite J to 192,0,0,0
      inc J
      set sprite J to 192,0,0,0
    end if
  next
  EfS = 11
  DrawEffect
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Stage 3: the defence of the pole.  Coal goblins march in formation (drawn with
' tiles, like the arcade invaders) and drop lumps of coal; Santa throws snowballs
' from behind three igloos.  A flying fruitcake crosses the top for a bonus.
' ---------------------------------------------------------------------------

sub PlayDefense:
  SetNo = 3
  NewScreen
  GobLeft = 18
  for I = 0 to 17
    EAlive[I] = 1
  next
if defined DBG_QUICK
  for I = 3 to 17
    EAlive[I] = 0
  next
  GobLeft = 3
end defined
  FX = 7
  FY = FStartY
  FDir = 1
  FF = 0
  FT = 0
  FPhase = 0
  Fail = 0
  SX = 120
  SHit = 0
  ThrowT = 0
  BallMax = 1
  if Round >= 1 then BallMax = 2
  BombMax = Round
  inc BombMax
  if BombMax > 3 then BombMax = 3
  for I = 0 to 1
    BallOn[I] = 0
  next
  for I = 0 to 2
    BombOn[I] = 0
  next
  BombT = 80
  UfoOn = 0
  UfoT = 75
  DrawDefField
  DrawFormation
  ShowHud
  ShowDefHud
  print at 9,13, "HOLD THE POLE!"
  MsgT = 60
  BtnWas = 1
  Rearm
  wait no fire
  nmi off
  StartMusic
de_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MusicTick
  MoveSantaC
  MoveBalls
  MoveBombs
  MoveUfo
  FormationTimer
  AnimateDefense
  DrawSpritesDefense
  if Fail = 1 then goto de_fail
  if GobLeft = 0 then goto de_done
  goto de_loop

de_done:
  StopMusic
  W16 = Lives
  W16 *= 100
  Score += W16
  ShowHud
  print at 5,7, "ALL GOBLINS BEATEN!"
  print at 8,9, "LIVES BONUS"
  print W16 at 20,9 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  Result = 1
  return

de_fail:
  StopMusic
  play sound SndOver
  print at 4,9, "THE POLE HAS FALLEN!"
  Rearm
  wait 120 frames
  nmi off
  Result = 0
  return
end sub

sub ShowDefHud:
  print at 8,1, "GOBLINS"
  print GobLeft at 16,1 digits 2
  return
end sub

' Stars over a snowy field, three igloos and a few pines
sub DrawDefField:
  DrawStars
  for J = 0 to 31
    N = J & 1
    N += TlGround0
    put char N at J,22
    N = 1 - N
    N += TlGround0
    N -= 0
    put char N at J,23
  next
  for J = 0 to 2
    X = J * 9
    X += 10
    put char TlPineT at X,20
    put char TlPineB at X,21
  next
  for J = 0 to 2
    X = J * 8
    X += 5
    put char TlIceTL0 at X,16
    P = X + 1
    put char TlIceM0 at P,16
    inc P
    put char TlIceM0 at P,16
    inc P
    put char TlIceTR0 at P,16
    put char TlIceB0 at X,17
    put char TlIceB0 at P,17
  next
  return
end sub

sub MoveSantaC:
  if Stick = 1 then
    if SX > 16 then SX -= 2
  end if
  if Stick = 2 then
    if SX < 224 then SX += 2
  end if
  N = 0
  if Btn = 1 then
    if BtnWas = 0 then N = 1
  end if
  BtnWas = Btn
  if N = 0 then return
  if SHit > 0 then return
  for I = 0 to 1
    if I < BallMax then
      if BallOn[I] = 0 then
        BallOn[I] = 1
        BallX[I] = SX + 4
        BallY[I] = SantaCY - 4
        ThrowT = 8
        play sound SndShoot
        return
      end if
    end if
  next
  return
end sub

' Snowballs fly up four pixels a frame and stop at the first goblin, igloo or the fruitcake
sub MoveBalls:
  for I = 0 to 1
    if BallOn[I] = 1 then
      Y = BallY[I]
      Y -= 4
      BallY[I] = Y
      X = BallX[I]
      if Y < 20 then BallOn[I] = 0
      if BallOn[I] = 1 then
        if UfoOn = 1 then
          if Y < 34 then
            P = X + 8
            if P > UfoX then
              T16 = UfoX
              T16 += 16
              if X < T16 then
                BallOn[I] = 0
                HitUfo
              end if
            end if
          end if
        end if
      end if
      if BallOn[I] = 1 then
        TC = X + 4
        TC >>= 3
        TR = Y + 3
        TR >>= 3
        N = get char at TC,TR
        if N >= TlE0a0 then
          if N < TlIceTL0 then
            BallOn[I] = 0
            KillGoblin
          end if
        end if
        if BallOn[I] = 1 then
          if N >= TlIceTL0 then
            if N <= TlIceB1 then
              BallOn[I] = 0
              CrackIce
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' The goblin whose tile is at TC,TR is hit: rows may be a tile out of step for a few frames, so each has its own place
sub KillGoblin:
  ER = 9
  for J = 0 to 2
    P = RowY[J]
    if TR >= P then
      N = P + 1
      if TR <= N then ER = J
    end if
  next
  if ER = 9 then return
  if TC < RowX[ER] then return
  P = TC - RowX[ER]
  EC = 0
  while P >= 3
    P -= 3
    inc EC
  end while
  N = ER * 6
  N += EC
  if EAlive[N] = 0 then return
  EAlive[N] = 0
  dec GobLeft
  X = EC * 3
  X += RowX[ER]
  Y = RowY[ER]
  put char 32 at X,Y
  put char 32 at X,Y+1
  P = X + 1
  put char 32 at P,Y
  put char 32 at P,Y+1
  X <<= 3
  Y <<= 3
  EfX = X
  EfY = Y
  EfP = SpPuff0
  EfC = 15
  EfT = 24
  N = 3 - ER
  W16 = N * 50
  Score += W16
  play sound SndBoom
  ShowHud
  ShowDefHud
  return
end sub

' An igloo tile is chipped: whole -> cracked -> gone
sub CrackIce:
  N = get char at TC,TR
  P = N - TlIceTL0
  P &= 1
  if P = 0 then
    inc N
    put char N at TC,TR
  else
    put char 32 at TC,TR
  end if
  return
end sub

sub HitUfo:
  N = random(1, 6)
  W16 = N * 50
  Score += W16
  UfoOn = 0
  UfoT = random(120, 200)
  EfX = UfoX
  EfY = 14
  EfP = SpSpark0
  EfC = 11
  EfT = 24
  play sound SndUfoHit
  ShowHud
  return
end sub

' Lumps of coal fall from the front goblin of a column
sub MoveBombs:
  if BombT > 0 then
    dec BombT
  else
    SpawnBomb
  end if
  for I = 0 to 2
    if BombOn[I] = 1 then
      Y = BombY[I]
      Y += 2
      if Round >= 2 then Y += 1
      BombY[I] = Y
      X = BombX[I]
      TC = X + 4
      TC >>= 3
      TR = Y + 7
      TR >>= 3
      N = get char at TC,TR
      if N >= TlIceTL0 then
        if N <= TlIceB1 then
          BombOn[I] = 0
          CrackIce
        end if
      end if
      if BombOn[I] = 1 then
        if Y >= 152 then
          if SHit = 0 then
            if X >= SX then
              P = X - SX
            else
              P = SX - X
            end if
            if P < 11 then
              BombOn[I] = 0
              LoseLife
            end if
          end if
        end if
      end if
      if BombOn[I] = 1 then
        if Y >= 172 then BombOn[I] = 0
      end if
    end if
  next
  return
end sub

sub SpawnBomb:
  N = Round * 6
  N = 60 - N
  if N < 24 then N = 24
  BombT = random(0, 30)
  BombT += N
  for I = 0 to 2
    if BombOn[I] = 0 then
      if I < BombMax then
        for J = 1 to 8
          K = random(0, 5)
          for R = 0 to 2
            P = 2 - R
            N = P * 6
            N += K
            if EAlive[N] = 1 then
              BombOn[I] = 1
              X = K * 3
              X += FX
              X <<= 3
              X += 4
              BombX[I] = X
              Y = P * 3
              Y += FY
              Y += 2
              Y <<= 3
              BombY[I] = Y
              return
            end if
          next
        next
      end if
    end if
  next
  return
end sub

' Santa is hit: a life is lost, the coal clears and he is safe for a moment
sub LoseLife:
  LoseOne
  play sound SndHit
  ShowLives
  EfX = SX
  EfY = SantaCY
  EfP = SpPuff0
  EfC = 14
  EfT = 24
  SHit = 90
  for J = 0 to 2
    BombOn[J] = 0
  next
  if Lives = 0 then Fail = 1
  return
end sub

sub MoveUfo:
  if UfoOn = 0 then
    if UfoT > 0 then
      N = Tick & 3
      if N = 0 then dec UfoT
      return
    end if
    UfoOn = 1
    UfoDir = random(0, 1)
    UfoX = 0
    if UfoDir = 0 then UfoX = 240
    return
  end if
  if UfoDir = 1 then
    inc UfoX
    if UfoX >= 240 then
      UfoOn = 0
      UfoT = random(120, 200)
    end if
  else
    dec UfoX
    if UfoX <= 1 then
      UfoOn = 0
      UfoT = random(120, 200)
    end if
  end if
  N = Tick & 15
  if N = 0 then play sound SndUfo
  return
end sub

' The goblins take a step every so often, faster as there are fewer of them; the step is then
' drawn one row of goblins a frame so no single frame has too much to do
sub FormationTimer:
  if FPhase > 0 then
    ER = 3 - FPhase
    RedrawRow
    dec FPhase
    return
  end if
  inc FT
  N = GobLeft + 8
  P = Round * 2
  if N > P then
    N -= P
  else
    N = 4
  end if
  if N < 4 then N = 4
  if FT < N then return
  FT = 0
  StepFormation
  return
end sub

sub StepFormation:
  ' which columns and rows are still alive?
  MinC = 5
  MaxC = 0
  MaxR = 0
  for ER = 0 to 2
    for EC = 0 to 5
      N = ER * 6
      N += EC
      if EAlive[N] = 1 then
        if EC < MinC then MinC = EC
        if EC > MaxC then MaxC = EC
        if ER > MaxR then MaxR = ER
      end if
    next
  next
  FF = FF ^ 1
  if FDir = 1 then
    P = MaxC * 3
    P += FX
    inc P
    if P >= 29 then
      inc FY
      FDir = 0
    else
      inc FX
    end if
  else
    P = MinC * 3
    P += FX
    if P <= 2 then
      inc FY
      FDir = 1
    else
      dec FX
    end if
  end if
  ' have they reached the ground?
  P = MaxR * 3
  P += FY
  inc P
  if P >= 19 then
    play sound SndHit
    LoseOne
    ShowLives
    FY = FStartY
    if Lives = 0 then Fail = 1
  end if
  FPhase = 3
  return
end sub

' Row ER of goblins: erase where it was, draw where it now belongs
sub RedrawRow:
  for EC = 0 to 5
    N = ER * 6
    N += EC
    if EAlive[N] = 1 then
      X = EC * 3
      X += RowX[ER]
      Y = RowY[ER]
      put char 32 at X,Y
      put char 32 at X,Y+1
      P = X + 1
      put char 32 at P,Y
      put char 32 at P,Y+1
    end if
  next
  RowX[ER] = FX
  Y = ER * 3
  Y += FY
  RowY[ER] = Y
  for EC = 0 to 5
    N = ER * 6
    N += EC
    if EAlive[N] = 1 then
      K = ER * 2
      K += FF
      K <<= 2
      K += TlE0a0
      X = EC * 3
      X += FX
      put char K at X,Y
      inc K
      P = X + 1
      put char K at P,Y
      inc K
      put char K at X,Y+1
      inc K
      put char K at P,Y+1
    end if
  next
  return
end sub

sub DrawFormation:
  for ER = 0 to 2
    RowX[ER] = FX
    RowY[ER] = FY + 3 * ER
    RedrawRow
  next
  return
end sub

sub AnimateDefense:
  if ThrowT > 0 then dec ThrowT
  if SHit > 0 then dec SHit
  N = Tick & 15
  if N = 0 then Twinkle
  SnowStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 22 at 5,13
  end if
  return
end sub

sub DrawSpritesDefense:
  N = Tick & 4
  if SHit > 0 then
    if N = 0 then
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
      goto df_balls
    end if
  end if
  P = SpSantaCW0
  K = SpSantaC0
  if ThrowT > 0 then
    P = SpSantaCW1
    K = SpSantaC1
  end if
  set sprite 0 to SantaCY,SX,P,15
  set sprite 1 to SantaCY,SX,K,8
df_balls:
  N = Tick
  N >>= 2
  N &= 1
  N <<= 2
  N += SpSnowball0
  for I = 0 to 1
    J = I + 2
    if BallOn[I] = 1 then
      Y = BallY[I]
      X = BallX[I]
      set sprite J to Y,X,N,15
    else
      set sprite J to 192,0,0,0
    end if
  next
  N = Tick
  N >>= 2
  N &= 3
  N <<= 2
  N += SpBomb0
  for I = 0 to 2
    J = I + 4
    if BombOn[I] = 1 then
      Y = BombY[I]
      X = BombX[I]
      set sprite J to Y,X,N,14
    else
      set sprite J to 192,0,0,0
    end if
  next
  if UfoOn = 1 then
    N = Tick
    N >>= 3
    N &= 1
    N <<= 2
    N += SpCake0
    set sprite 7 to 14,UfoX,N,8
  else
    set sprite 7 to 192,0,0,0
  end if
  EfS = 8
  DrawEffect
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Stage 4: the ice wall.  Santa's sleigh and reindeer are the paddle; bounce the
' snowball into the wall of wrapped gifts and ice blocks (two hits each).  Gifts
' shaken loose fall back: catch them with the sleigh for a bonus.
' ---------------------------------------------------------------------------

sub PlayIceWall:
  SetNo = 4
  NewScreen
  Fail = 0
  PadX = 104
  PadDir = 1
  PGal = 0
  SnowOn = 0
  HitCnt = 0
  DropOn = 0
  BSY = 2
  if Round >= 1 then BSY = 3
  WallRows = Round
  WallRows += 4
  if WallRows > 7 then WallRows = 7
  DrawStars
  DrawWall
  ShowHud
  ShowWallHud
  print at 7,15, "SMASH THE ICE WALL!"
  MsgT = 70
  BtnWas = 1
  Rearm
  wait no fire
  nmi off
  StartMusic
iw_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MusicTick
  MovePaddle
  MoveBall
  MoveDrop
  AnimateWall
  DrawSpritesWall
  if Fail = 1 then goto iw_fail
  if BrickLeft = 0 then goto iw_done
  goto iw_loop

iw_done:
  StopMusic
  W16 = Lives
  W16 *= 100
  Score += W16
  ShowHud
  print at 4,7, "THE GIFTS ARE FREE!"
  print at 8,9, "LIVES BONUS"
  print W16 at 20,9 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  Result = 1
  return

iw_fail:
  StopMusic
  play sound SndOver
  print at 3,9, "THE ICE WALL STANDS!"
  Rearm
  wait 120 frames
  nmi off
  Result = 0
  return
end sub

sub ShowWallHud:
  print at 8,1, "BLOCKS"
  print BrickLeft at 15,1 digits 3
  return
end sub

' Ice walls round the field, the wall of gifts (the top row is ice from round 2), and a snowy floor
sub DrawWall:
  fill TlWallTop count 30 at 1,2
  for Y = 3 to 22
    put char TlWallSide at 1,Y
    put char TlWallSide at 30,Y
  next
  for J = 0 to 31
    N = J & 1
    N += TlFloor0
    put char N at J,23
  next
  BrickLeft = 0
  for J = 0 to 6
    if J < WallRows then
      Y = J + 5
      for K = 0 to 13
        X = K * 2
        X += 2
        if J = 0 then
          if Round >= 1 then
            put char TlIceL0 at X,Y
            P = X + 1
            put char TlIceR0 at P,Y
          else
            DrawGiftBlock
          end if
        else
          DrawGiftBlock
        end if
        inc BrickLeft
      next
    end if
  next
if defined DBG_QUICK
  fill 32 count 28 at 2,5
  for J = 1 to 6
    Y = J + 5
    fill 32 count 28 at 2,Y
  next
  for K = 5 to 9
    X = K * 2
    X += 2
    Y = 5
    J = 1
    DrawGiftBlock
  next
  BrickLeft = 5
end defined
  return
end sub

' a wrapped gift at X,Y in the colour of row J
sub DrawGiftBlock:
  N = J % 6
  N <<= 1
  N += TlBrk0L
  put char N at X,Y
  inc N
  P = X + 1
  put char N at P,Y
  return
end sub

sub MovePaddle:
  if Stick = 1 then
    PadDir = 0
    if PadX > 16 then PadX -= 3
  end if
  if Stick = 2 then
    PadDir = 1
    if PadX < 208 then PadX += 3
  end if
  if Stick > 0 then
    inc PGalT
    if PGalT >= 3 then
      PGalT = 0
      inc PGal
      PGal &= 3
    end if
  end if
  if SnowOn = 0 then
    BX = PadX + 12
    BY = PadY - 6
    N = 0
    if Btn = 1 then
      if BtnWas = 0 then N = 1
    end if
    BtnWas = Btn
    if N = 1 then
      SnowOn = 1
      BDY = 0
      BDX = random(0, 1)
      BSX = 1
      play sound SndShoot
    end if
  end if
  return
end sub

' The snowball moves a pixel or three on each axis in turn and bounces off walls, blocks and the sleigh
sub MoveBall:
  if SnowOn = 0 then return
  ' --- sideways ---
  NX = BX
  if BDX = 1 then
    NX += BSX
    P = NX + 7
  else
    NX -= BSX
    P = NX
  end if
  K = 0
  if P < 16 then
    BDX = 1
    K = 1
  end if
  if P >= 240 then
    BDX = 0
    K = 1
  end if
  if K = 0 then
    Tx = P >> 3
    Ty = BY + 1
    Ty >>= 3
    ProbeBall
    if K = 0 then
      Ty = BY + 6
      Ty >>= 3
      ProbeBall
    end if
    if K = 1 then
      BDX = 1 - BDX
    end if
  end if
  if K = 0 then BX = NX
  ' --- up and down ---
  NY = BY
  if BDY = 1 then
    NY += BSY
    P = NY + 7
  else
    NY -= BSY
    P = NY
  end if
  K = 0
  if P < 24 then
    BDY = 1
    K = 1
  end if
  if K = 0 then
    Ty = P >> 3
    Tx = BX + 1
    Tx >>= 3
    ProbeBall
    if K = 0 then
      Tx = BX + 6
      Tx >>= 3
      ProbeBall
    end if
    if K = 1 then
      BDY = 1 - BDY
    end if
  end if
  if K = 0 then BY = NY
  ' --- the sleigh ---
  if BDY = 1 then
    P = BY + 7
    N = PadY + 4
    if P >= N then
      N = PadY + 12
      if P < N then
        T16 = BX
        T16 += 8
        if T16 > PadX then
          T16 = PadX
          T16 += 32
          if BX < T16 then
            BounceOffSleigh
          end if
        end if
      end if
    end if
  end if
  ' --- lost below the sleigh ---
  if BY >= 184 then
    LoseOne
    play sound SndHit
    ShowLives
    EfX = BX
    EfY = 168
    EfP = SpPuff0
    EfC = 15
    EfT = 24
    SnowOn = 0
    if Lives = 0 then Fail = 1
  end if
  return
end sub

' Is there a block under tile Tx,Ty?  If so it is hit and K is set so the ball bounces
sub ProbeBall:
  N = get char at Tx,Ty
  if N < TlBrk0L then return
  if N > TlIceR1 then return
  K = 1
  Wt = N
  HitBlock
  return
end sub

' The block whose tile Wt sits at Tx,Ty is hit: gifts break, ice cracks and then breaks
sub HitBlock:
  if Wt >= TlIceL0 then
    P = Wt - TlIceL0
    ' left tile of the block
    X = Tx
    if P = 1 then X -= 1
    if P = 3 then X -= 1
    if P < 2 then
      put char TlIceL1 at X,Ty
      N = X + 1
      put char TlIceR1 at N,Ty
      Score += 10
      play sound SndClunk
      ShowHud
      return
    end if
    N = X + 1
    put char 32 at X,Ty
    put char 32 at N,Ty
    W16 = 150
  else
    P = Wt - TlBrk0L
    X = Tx
    P &= 1
    if P = 1 then X -= 1
    N = X + 1
    put char 32 at X,Ty
    put char 32 at N,Ty
    W16 = 14 - Ty
    W16 *= 10
  end if
  Score += W16
  dec BrickLeft
  inc HitCnt
  if HitCnt = 14 then
    if BSY < 4 then inc BSY
  end if
  if HitCnt = 34 then
    if BSY < 4 then inc BSY
  end if
  EfX = X * 8
  EfY = Ty * 8
  if EfY > 4 then EfY -= 4
  EfP = SpSpark0
  EfC = 11
  EfT = 24
  play sound SndCatch
  ' sometimes a gift is shaken loose
  if DropOn = 0 then
    N = random(0, 5)
    if N = 0 then
      DropOn = 1
      DropX = X * 8
      DropX += 4
      DropY = Ty * 8
      N = random(0, 3)
      DropC = 8
      if N = 1 then DropC = 3
      if N = 2 then DropC = 5
      if N = 3 then DropC = 13
    end if
  end if
  ShowHud
  ShowWallHud
  return
end sub

' The ball meets the sleigh: where it lands decides the angle
sub BounceOffSleigh:
  BDY = 0
  BY = PadY - 4
  N = BX + 4
  if N < PadX then
    N = 0
  else
    N -= PadX
    N >>= 3
  end if
  if N > 3 then N = 3
  if N = 0 then
    BDX = 0
    BSX = 3
  end if
  if N = 1 then
    BDX = 0
    BSX = 1
  end if
  if N = 2 then
    BDX = 1
    BSX = 1
  end if
  if N = 3 then
    BDX = 1
    BSX = 3
  end if
  play sound SndShoot
  return
end sub

' A shaken-loose gift falls; the sleigh catches it for a bonus
sub MoveDrop:
  if DropOn = 0 then return
  DropY += 2
  N = DropY + 8
  P = PadY + 4
  if N >= P then
    P = PadY + 14
    if N < P then
      T16 = DropX
      T16 += 8
      if T16 > PadX then
        T16 = PadX
        T16 += 32
        if DropX < T16 then
          DropOn = 0
          Score += 200
          EfX = DropX - 4
          EfY = PadY - 8
          EfP = SpSpark0
          EfC = 11
          EfT = 24
          play sound SndDing
          ShowHud
          return
        end if
      end if
    end if
  end if
  if DropY >= 184 then DropOn = 0
  return
end sub

sub AnimateWall:
  N = Tick & 15
  if N = 0 then Twinkle
  SnowStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 22 at 5,15
  end if
  return
end sub

sub DrawSpritesWall:
  X = PadX + 16
  P = PGal
  P <<= 2
  if PadDir = 1 then
    set sprite 0 to PadY,PadX,SpPWhite0R,15
    set sprite 1 to PadY,X,SpPNose0R,9
    set sprite 2 to PadY,PadX,SpPSleighR,8
    P += SpPDeerR0
    set sprite 3 to PadY,X,P,10
  else
    set sprite 0 to PadY,X,SpPWhite0L,15
    set sprite 1 to PadY,PadX,SpPNose0L,9
    set sprite 2 to PadY,X,SpPSleighL,8
    P += SpPDeerL0
    set sprite 3 to PadY,PadX,P,10
  end if
  N = Tick
  N >>= 2
  N &= 1
  N <<= 2
  N += SpIceBall0
  set sprite 4 to BY,BX,N,15
  if DropOn = 1 then
    N = Tick
    N >>= 3
    N &= 1
    N <<= 2
    P = N + SpDropRib0
    set sprite 5 to DropY,DropX,P,11
    P = N + SpDropBox0
    set sprite 6 to DropY,DropX,P,DropC
  else
    set sprite 5 to 192,0,0,0
    set sprite 6 to 192,0,0,0
  end if
  EfS = 7
  DrawEffect
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Stage 5: sky dash.  Fly the sleigh up and down and left and right through a
' sky of planes, balloons and birds; floating gifts are worth a bonus.  The
' stage ends when the distance bar is full.
' ---------------------------------------------------------------------------

sub PlaySkyDash:
  SetNo = 5
  NewScreen
  Fail = 0
  FlyX = 112
  FlyY = 140
  FlyDir = 1
  FlyHit = 0
  DistU = 0
  DistT = 0
  Goal = Round * 15
  Goal += 110
  if Goal > 200 then Goal = 200
if defined DBG_QUICK
  Goal = 6
end defined
  SpawnE = 50
  for I = 0 to 3
    ObOn[I] = 0
  next
  DrawStars
  for I = 0 to 2
    ClX[I] = I * 9
    ClX[I] += 2
    ClY[I] = random(3, 17)
    DrawCloud
  next
  ShowHud
  ShowSkyHud
  print at 7,11, "DODGE EVERYTHING!"
  MsgT = 60
  Rearm
  wait no fire
  nmi off
  StartMusic
sk_loop:
  nmi on
  wait
  nmi off
  ReadStick
  inc Tick
  MusicTick
  MoveFlyer
  SpawnObstacle
  MoveObstacles
  AnimateSky
  DrawSpritesSky
  if Fail = 1 then goto sk_fail
  if DistU >= Goal then goto sk_done
  goto sk_loop

sk_done:
  StopMusic
  W16 = Lives
  W16 *= 100
  W16 += 300
  Score += W16
  ShowHud
  print at 5,7, "THE SKY IS CLEAR!"
  print at 8,9, "FLIGHT BONUS"
  print W16 at 21,9 digits 3
  play sound SndLevel
  Rearm
  wait 150 frames
  nmi off
  Result = 1
  return

sk_fail:
  StopMusic
  play sound SndOver
  print at 3,9, "THE SLEIGH WENT DOWN!"
  Rearm
  wait 120 frames
  nmi off
  Result = 0
  return
end sub

sub ShowSkyHud:
  print at 8,1, "SKY"
  print DistU at 12,1 digits 3
  print at 15,1, "/"
  print Goal at 16,1 digits 3
  return
end sub

' Up, down, left and right; the sleigh stays in the lower part of the sky
sub MoveFlyer:
  if Stick = 1 then
    FlyDir = 0
    if FlyX > 10 then FlyX -= 3
  end if
  if Stick = 2 then
    FlyDir = 1
    if FlyX < 214 then FlyX += 3
  end if
  if Up = 1 then
    if FlyY > 96 then FlyY -= 2
  end if
  if Down = 1 then
    if FlyY < 156 then FlyY += 2
  end if
  inc FlyGalT
  if FlyGalT >= 4 then
    FlyGalT = 0
    inc FlyGal
    FlyGal &= 3
  end if
  if FlyHit > 0 then dec FlyHit
  inc DistT
  if DistT >= 16 then
    DistT = 0
    inc DistU
    ShowSkyHud
  end if
  return
end sub

' A new obstacle drops in from the top; faster and more often as the flight goes on
sub SpawnObstacle:
  if SpawnE > 0 then
    dec SpawnE
    return
  end if
  N = DistU >> 3
  P = Round * 3
  N += P
  if N > 28 then N = 28
  SpawnE = 46 - N
  N = random(0, 12)
  SpawnE += N
  for I = 0 to 3
    if ObOn[I] = 0 then
      ObOn[I] = 1
      ObX[I] = random(16, 220)
      ObY[I] = 14
      ObDir[I] = random(0, 1)
      N = random(0, 9)
      K = 0
      if N = 4 then K = 1
      if N = 5 then K = 1
      if N = 6 then K = 2
      if N = 7 then K = 2
      if N = 8 then K = 3
      ObK[I] = K
      N = random(0, 3)
      P = 8
      if N = 1 then P = 3
      if N = 2 then P = 13
      if N = 3 then P = 11
      ObC[I] = P
      return
    end if
  next
  return
end sub

sub MoveObstacles:
  for I = 0 to 3
    if ObOn[I] = 1 then
      K = ObK[I]
      Y = ObY[I]
      N = 2
      if K = 1 then N = 1
      if Round >= 2 then inc N
      Y += N
      ObY[I] = Y
      X = ObX[I]
      if K = 0 then
        if ObDir[I] = 1 then
          X += 1
          if Round >= 1 then X += 1
        else
          if X > 1 then X -= 1
          if Round >= 1 then
            if X > 1 then X -= 1
          end if
        end if
      end if
      if K = 2 then
        if ObDir[I] = 1 then
          X += 2
        else
          if X > 2 then X -= 2
        end if
      end if
      if K = 1 then
        N = Tick & 31
        if N = 0 then ObDir[I] = 1 - ObDir[I]
        N = Tick & 1
        if N = 0 then
          if ObDir[I] = 1 then
            X += 1
          else
            if X > 1 then X -= 1
          end if
        end if
      end if
      ObX[I] = X
      if X < 4 then ObOn[I] = 0
      if X > 236 then ObOn[I] = 0
      if Y >= 186 then ObOn[I] = 0
      if ObOn[I] = 1 then CheckHit
    end if
  next
  return
end sub

' Obstacle I against the sleigh (the sleigh is 32 wide, its body a band across the middle)
sub CheckHit:
  X = ObX[I]
  Y = ObY[I]
  if ObK[I] = 3 then
    P = X + 8
    N = Y + 8
  else
    X += 3
    Y += 3
    P = X + 10
    N = Y + 10
  end if
  T16 = FlyX
  T16 += 30
  if X >= T16 then return
  T16 = FlyX
  T16 += 2
  if P <= T16 then return
  T16 = FlyY
  T16 += 13
  if Y >= T16 then return
  T16 = FlyY
  T16 += 3
  if N <= T16 then return
  ObOn[I] = 0
  if ObK[I] = 3 then
    Score += 100
    EfX = ObX[I]
    EfY = ObY[I]
    EfP = SpSpark0
    EfC = 11
    EfT = 24
    play sound SndDing
    ShowHud
    return
  end if
  if FlyHit > 0 then return
  LoseOne
  play sound SndHit
  ShowLives
  EfX = FlyX + 8
  EfY = FlyY
  EfP = SpPuff0
  EfC = 15
  EfT = 24
  FlyHit = 90
  if Lives = 0 then Fail = 1
  return
end sub

' Clouds drift down a row now and then; stars and snow fall past
sub AnimateSky:
  N = Tick & 7
  if N = 0 then
    I = Tick >> 3
    I &= 3
    if I < 3 then MoveCloud
  end if
  N = Tick & 15
  if N = 0 then Twinkle
  SnowStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 22 at 5,11
  end if
  return
end sub

' Cloud I: one row down (its top row becomes its bottom row's neighbour), or back to the top
sub MoveCloud:
  X = ClX[I]
  Y = ClY[I]
  fill 32 count 3 at X,Y
  inc Y
  if Y > 21 then
    fill 32 count 3 at X,Y
    ClY[I] = 2
    ClX[I] = random(2, 25)
    DrawCloud
    return
  end if
  ClY[I] = Y
  DrawCloud
  return
end sub

sub DrawCloud:
  X = ClX[I]
  Y = ClY[I]
  put char TlCloud00 at X,Y
  P = X + 1
  put char TlCloud01 at P,Y
  P = X + 2
  put char TlCloud02 at P,Y
  Y += 1
  put char TlCloud10 at X,Y
  P = X + 1
  put char TlCloud11 at P,Y
  P = X + 2
  put char TlCloud12 at P,Y
  return
end sub

' the sleigh with Rudolph, then four obstacles of two sprites each
sub DrawSpritesSky:
  X = FlyX + 16
  P = FlyGal
  P <<= 2
  N = Tick & 4
  J = 1
  if FlyHit > 0 then
    if N = 0 then J = 0
  end if
  if J = 0 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  else
    if FlyDir = 1 then
      set sprite 0 to FlyY,FlyX,SpFWhite0R,15
      set sprite 1 to FlyY,X,SpFNose0R,9
      set sprite 2 to FlyY,FlyX,SpFSleighR,8
      P += SpFDeerR0
      set sprite 3 to FlyY,X,P,10
    else
      set sprite 0 to FlyY,X,SpFWhite0L,15
      set sprite 1 to FlyY,FlyX,SpFNose0L,9
      set sprite 2 to FlyY,X,SpFSleighL,8
      P += SpFDeerL0
      set sprite 3 to FlyY,FlyX,P,10
    end if
  end if
  for I = 0 to 3
    J = I * 2
    J += 4
    if ObOn[I] = 1 then
      K = ObK[I]
      X = ObX[I]
      Y = ObY[I]
      N = Tick
      N >>= 3
      N &= 1
      N <<= 3
      if K = 0 then
        if ObDir[I] = 1 then
          P = SpPlRB0
        else
          P = SpPlLB0
        end if
        P += N
        set sprite J to Y,X,P + 4,8
        inc J
        set sprite J to Y,X,P,5
      end if
      if K = 1 then
        P = SpBalB0
        P += N
        set sprite J to Y,X,P + 4,15
        inc J
        set sprite J to Y,X,P,ObC[I]
      end if
      if K = 2 then
        P = Tick
        P >>= 2
        P &= 3
        P <<= 2
        if ObDir[I] = 1 then
          P += SpBirdR0
        else
          P += SpBirdL0
        end if
        set sprite J to 192,0,0,0
        inc J
        set sprite J to Y,X,P,14
      end if
      if K = 3 then
        P = SpGBox0
        P += N
        set sprite J to Y,X,P + 4,11
        inc J
        set sprite J to Y,X,P,ObC[I]
      end if
    else
      set sprite J to 192,0,0,0
      inc J
      set sprite J to 192,0,0,0
    end if
  next
  EfS = 12
  DrawEffect
  update sprites
  return
end sub


data ColA bytes
  $96,$F1,$96,$E1,$96,$F1,$95,$B1,$69,$81,$7D,$D0,$7B,$8A,$EE,$D2
  $61,$F0,$12,$EE,$21,$FE,$F0,$16,$EE,$51,$FE,$F0,$02,$F2,$86,$FE
  $96,$54,$96,$A6,$96,$E4,$92,$AB,$25,$11,$A1,$8A,$11,$21,$2A,$31
  $21,$91,$A4,$E4,$88,$44,$E4,$A7,$84,$E9,$F1,$FF,$34,$FA,$F1,$FF
  $B4,$7F,$F0,$EF,$62,$44,$40,$76,$C4,$E6,$F0,$2F,$8B,$8B,$FE,$A5
  $E1,$73,$C0,$5B,$FF,$BB,$FF,$EF,$F8,$CF,$F2,$EC,$7D,$FD,$55,$56
end data
data ColB bytes
  $96,$F1,$96,$E1,$96,$F1,$95,$B1,$69,$81,$69,$B1,$5A,$E1,$5A,$41
  $03,$AE,$4C,$11,$F2,$F7,$D0,$9F,$2E,$DB,$87,$E0,$C1,$FE,$FF,$8E
  $DA,$5B,$41,$A2,$35,$F1,$FA,$A1,$53,$BC,$9E,$1E,$F0,$57,$80,$90
  $F6,$FE,$82,$A1,$AA,$61,$41,$9F,$51,$F1,$69,$75,$F1,$EB,$E0,$D1
