data RoadCol bytes
  $FF,$FE,$FE,$EE,$1E,$1E,$1E,$1E,$FF,$FE,$FE,$EE,$1E,$1E,$1E,$1E,$FF,$FE,$FE,$EE,$1E,$1E,$1E,$1E,$FF,$FE,$FE,$EE,$1E,$1E,$1E,$1E
  $1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E,$1E
  $1E,$1E,$1E,$1E,$44,$44,$E4,$E4,$1E,$1E,$1E,$1E,$44,$44,$E4,$E4,$1E,$1E,$1E,$1E,$44,$44,$E4,$E4,$1E,$1E,$1E,$1E,$44,$44,$E4,$E4
  $E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4,$E4
  $E4,$E4,$41,$41,$41,$41,$41,$41,$E4,$E4,$41,$41,$41,$41,$41,$41,$E4,$E4,$41,$41,$41,$41,$41,$41,$E4,$E4,$41,$41,$41,$41,$41,$41
  $41,$41,$41,$41,$41,$41,$11,$11,$41,$41,$41,$41,$41,$41,$11,$11,$41,$41,$41,$41,$41,$41,$11,$11,$41,$41,$41,$41,$41,$41,$11,$11
