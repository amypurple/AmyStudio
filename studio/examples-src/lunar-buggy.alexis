asm {
; LbR3: VDP register 3 = $FF, so each screen third has its own colour
; table (the strips' codes need their own colours)
LbR3:
    ld bc,$03FF
    call WRITE_REGISTER
    ret

; BgScroll: the three strips for the scroll Gt (frames of driving).
;   road  rows 16-21, codes 232-255 of third 3, 2 pixels a frame,
;         period 32: fine (Gt & 3) x 2, coarse (Gt >> 2) & 3
;   hills rows 14-15, codes 240-255 of third 2, 1 pixel a frame,
;         period 64: fine Gt & 7, coarse (Gt >> 3) & 7
;   far   rows 11-13, codes 192-239 of third 2, 1 pixel every 4 frames,
;         period 128: S = ((Gt + 2) >> 2) & 127, written when Gt & 3 = 2
; Patterns every time they change, names when the fine shift is 0 (or
; BgAll is set: all of it, then BgAll = 0). 32 cycles or more between
; VDP writes, safe with the display on; NMI off.
BgScroll:
    ld a,(AMY_UVAR_Gt)
    and 3
    ld hl,AMY_UDATA_RoadPat
    ld de,192
    call BgIdx
    ld de,$1740
    ld b,192
    call BgOut
    ld a,(AMY_UVAR_BgAll)
    or a
    jr nz,BgR1
    ld a,(AMY_UVAR_Gt)
    and 3
    jr nz,BgH
BgR1:
    ld hl,$1A00
    call BgAddr
    ld a,(AMY_UVAR_Gt)
    srl a
    srl a
    and 3
    ld e,a
    ld d,232
    ld h,3
    ld l,6
    call BgNames
BgH:
    ld a,(AMY_UVAR_Gt)
    and 7
    ld hl,AMY_UDATA_HillPat
    ld de,128
    call BgIdx
    ld de,$0F80
    ld b,128
    call BgOut
    ld a,(AMY_UVAR_BgAll)
    or a
    jr nz,BgH1
    ld a,(AMY_UVAR_Gt)
    and 7
    jr nz,BgF
BgH1:
    ld hl,$19C0
    call BgAddr
    ld a,(AMY_UVAR_Gt)
    srl a
    srl a
    srl a
    and 7
    ld e,a
    ld d,240
    ld h,7
    ld l,2
    call BgNames
BgF:
    ld a,(AMY_UVAR_BgAll)
    or a
    jr nz,BgF0
    ld a,(AMY_UVAR_Gt)
    and 3
    cp 2
    ret nz
BgF0:
    ld hl,(AMY_UVAR_Gt)
    inc hl
    inc hl
    srl h
    rr l
    srl h
    rr l
    ld a,l
    and 127
    ld (AMY_UVAR_BgS),a
    and 7
    ld hl,AMY_UDATA_FarPat
    ld de,384
    call BgIdx
    ld de,$0E00
    ld b,192
    call BgOut
    ld b,192
    call BgOutC
    ld a,(AMY_UVAR_BgAll)
    or a
    jr nz,BgF1
    ld a,(AMY_UVAR_BgS)
    and 7
    ret nz
BgF1:
    xor a
    ld (AMY_UVAR_BgAll),a
    ld hl,$1960
    call BgAddr
    ld a,(AMY_UVAR_BgS)
    srl a
    srl a
    srl a
    and 15
    ld e,a
    ld d,192
    ld h,15
    ld l,3
    jp BgNames

; HL += A x DE
BgIdx:
    or a
    ret z
BgI1:
    add hl,de
    dec a
    jr nz,BgI1
    ret

; the VRAM write address HL
BgAddr:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ret

; B bytes (0: 256) from HL to VRAM at DE; BgOutC goes on where the last
; write ended
BgOut:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
BgOutC:
    ld c,$BE
BgO1:
    outi
    nop
    jr nz,BgO1
    ret

; L rows of 32 names: code D + ((x + E) & H), D grows by H + 1 a row
BgNames:
    ld b,32
    push de
BgN1:
    ld a,e
    and h
    add a,d
    out ($BE),a
    inc e
    djnz BgN1
    pop de
    ld a,h
    inc a
    add a,d
    ld d,a
    dec l
    jr nz,BgNames
    ret

LbJump:
    db $40,$75,$21,$02,$40,$18,$21,$02,$40,$D7,$30,$02,$40,$A9,$30,$02,$40,$88,$40,$02,$40,$70,$60,$03
    db $50
LbShot:
    db $40,$2F,$20,$01,$40,$3B,$20,$01,$40,$4B,$30,$01,$40,$5D,$40,$01,$40,$76,$60,$02,$50
LbBoom:
    db $00,$00,$04,$04,$00,$00,$25,$06,$00,$00,$46,$08,$00,$00,$76,$0A,$10
LbCrash:
    db $00,$00,$04,$0A,$00,$00,$15,$0C,$00,$00,$36,$0E,$00,$00,$56,$12,$00,$00,$77,$18,$10
LbBase:
    db $40,$D6,$10,$05,$40,$AA,$10,$05,$40,$8F,$10,$05,$40,$6B,$20,$0E,$50
LbStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$0E,$50
LbWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$20,$06,$40,$6B,$10,$18
    db $40,$55,$20,$0A,$40,$47,$20,$1E,$50
LbEnd:
    db $40,$D6,$10,$0A,$40,$FE,$20,$0A,$40,$41,$21,$0A,$40,$AB,$31,$1E,$50

LbSoundTable:
    dw LbTuneMel,$702B
    dw LbTuneBass,$7035
    dw LbJump,$7049
    dw LbShot,$7049
    dw LbBoom,$703F
    dw LbCrash,$703F
    dw LbBase,$7049
    dw LbStart,$7049
    dw LbWin,$7049
    dw LbEnd,$7049
; Earthrise Rally (original)
; Tiny Sound, 8 frames per step
LbTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$1A,$21,$1C,$01,$1F,$23,$01,$28,$01,$26,$23,$01,$1F,$01
    db $21,$01,$23,$01,$24,$01,$23,$21,$01,$1F,$01,$21,$1E,$01,$1A,$01
    db $1E,$01,$01,$01,$1C,$01,$1F,$23,$01,$28,$01,$2A,$2B,$01,$2A,$01
    db $28,$01,$26,$01,$23,$01,$26,$24,$23,$01,$21,$01,$1F,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
LbTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$04,$01,$10,$01,$04,$01,$10,$01,$07,$01,$13,$01
    db $07,$01,$13,$01,$0C,$01,$18,$01,$0C,$01,$18,$01,$0E,$01,$1A,$01
    db $0E,$01,$1A,$01,$04,$01,$10,$01,$04,$01,$10,$01,$0B,$01,$17,$01
    db $0B,$01,$17,$01,$0C,$01,$18,$01,$0E,$01,$1A,$01,$07,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
