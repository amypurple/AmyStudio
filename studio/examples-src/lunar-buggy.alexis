  $00,$00,$00,$00,$00,$00,$00,$01,$00,$00,$07,$1F,$3F,$1F,$47,$F0,$03,$00,$00,$C0,$E0,$C0,$00,$00,$F8,$E0,$00,$00,$00,$00,$00,$00
