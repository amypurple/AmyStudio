u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u16 Sc = 0
u16 Hi = 0
u16 Spd = 0
u16 Pp = 0
' the snake: length, head cell, moving (1 growing, 2 snapping back), frame
' of the move, direction of the move, facing, what the new cell held, the
' direction of every segment from the one before
u8 Len = 0
u8 Hc = 0
u8 Hr = 0
u8 Mv = 0
u8 Mt = 0
u8 Md = 0
u8 Face = 0
u8 Pv = 0
u8 Dir[201]
' the lanes: which lane cells the snake is on (bit 1 and 2 for the two
' cells across the lane): LnV rows 0-23 of lane 0 then lane 1, LnH columns
' 0-31 of lane 2 then lane 3
u8 LnV[48]
u8 LnH[64]
' the rats: position along the lane (pixels) and its fraction (1/256)
u16 Rp[8]
u8 Rf[8]
u8 Lv = 0
u8 Eg = 0
u8 Lives = 3
u8 Dead = 0
u8 Dw = 0
u8 Clr = 0
u8 Over = 0
u8 Hit = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 TRx = 0
' loop counters (never shared with the helpers)
u8 Rk = 0
u8 Pe = 0
u8 Pa = 0
u8 Dd = 0
u8 Rn = 0
u8 R2 = 0
u8 Moved = 0
' MarkCell's work
u8 Mo = 0
u8 Mi = 0
u8 Mb = 0
' scratch
u8 B = 0
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 M = 0
u8 N = 0
u8 S = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0
u8 L2 = 0

  tile screen
  set sound table SnSoundTable areas 6
  sprites 16x16
  set sprite count 5
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Sc > Hi then Hi = Sc
  print at 9,10, "             "
  print at 9,11, "  GAME OVER  "
  print at 9,12, "             "
  print at 9,13, "  BEST       "
  NumU = Hi
  print at 16,13, digits$(NumU, 5)
  print at 21,13, "0 "
  print at 9,14, "             "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveRats
  if Dead > 0 then
    DeadStep
    return
  end if
  if Clr = 1 then
    ClrStep
    return
  end if
  SnakeStep
  if Clr = 0 then
    HitTest
    if Hit = 1 then
      Dead = 1
      Dw = 20
      Mv = 0
      play sound SndDie
    end if
  end if
  return
end sub

' all eight rats run, the hidden set too; a rat moves Spd/256 pixel a
' frame along its lane and wraps round
sub MoveRats:
  for Rk = 0 to 7
    N = (Rf[Rk] + Spd) >> 8
    Rf[Rk] = Rf[Rk] + Spd
    W16 = N
    Pp = Rp[Rk]
    L2 = RLane[Rk]
    if RFwd[Rk] = 1 then
      Pp = Pp + W16
      if L2 >= 2 then
        if Pp >= HPer then Pp = Pp - HPer
      else
        if Pp >= VPer then Pp = Pp - VPer
      end if
    else
      if Pp < W16 then
        if L2 >= 2 then
          Pp = Pp + HPer
        else
          Pp = Pp + VPer
        end if
      end if
      Pp = Pp - W16
    end if
    Rp[Rk] = Pp
  next
  return
end sub

' Hit = 1 when a rat of this level's set covers a lane cell the snake is on
sub HitTest:
  Hit = 0
  S = Lv & 1
  S = S << 2
  for Rk = 0 to 3
    K = S + Rk
    L2 = RLane[K]
    Pp = Rp[K]
    Rn = (Pp + 2) >> 3
    R2 = (Pp + 13) >> 3
    while Rn <= R2
      C = Rn - 2
      if L2 < 2 then
        if C >= 2 then
          if C <= 22 then
            J = L2 * 24 + C
            if LnV[J] > 0 then Hit = 1
          end if
        end if
      else
        if C >= 2 then
          if C <= 28 then
            J = (L2 - 2) * 32 + C
            if LnH[J] > 0 then Hit = 1
          end if
        end if
      end if
      inc Rn
    end while
  next
  return
end sub

' the snake: finish the move under way; then the button pulls back, the
' stick grows
sub SnakeStep:
  if Mv > 0 then
    inc Mt
    if Mt >= 4 then
      if Mv = 1 then Arrive
      Mv = 0
    end if
  end if
  if Mv > 0 then return
  if Clr = 1 then return
  if Btn > 0 then
    if Len > 0 then StartBack
    return
  end if
  K = J1 & 15
  if K = 0 then return
  ' first a direction that turns, then the one it faces
  Moved = 0
  for Pa = 0 to 1
    for Dd = 0 to 3
      if Moved = 0 then
        V = StickBit[Dd]
        V = V & K
        if V > 0 then
          Got = 0
          if Pa = 0 then
            if Dd <> Face then Got = 1
          else
            if Dd = Face then Got = 1
          end if
          if Got = 1 then TryGrow
        end if
      end if
    next
  next
  return
end sub

' 1 when cell (Cx, Cy) is open to the snake (floor, egg, frog, jewel); Pv
' is then what it holds
function Open(u8 Cx, u8 Cy) as u8
  if Cx < 2 or Cx > 28 or Cy < 2 or Cy > 22 then return 0
  V = get char at Cx,Cy
  if V < TFloor or V > TJewel then return 0
  Pv = V
  return 1

' grow one cell in direction Dd if it is open
sub TryGrow:
  if Len >= MaxLen then return
  X = Hc + DCol[Dd]
  Y = Hr + DRow[Dd]
  if Open(X, Y) = 0 then return
  Moved = 1
  ' the head's cell becomes a piece joining the old way in and the new way
  M = Bit[Dd]
  if Len > 0 then M = M | Bit[Dir[Len] ^ 2]
  put char TSn0 + M at Hc,Hr
  if FloorAt(X, Y) = TLane then
    put char TPendl at X,Y
  else
    put char TPend at X,Y
  end if
  MarkCell(X, Y, 1)
  inc Len
  Dir[Len] = Dd
  Hc = X
  Hr = Y
  Mv = 1
  Mt = 0
  Md = Dd
  Face = Dd
  V = Len / 25
  if V > 7 then V = 7
  play sound SndGrow0 + V
  return
end sub

' the head has slid into its new cell: an end piece there, and what it held
' is eaten
sub Arrive:
  put char TSn0 + Bit[Md ^ 2] at Hc,Hr
  select case Pv
    case TEgg
      Sc = Sc + 5
      dec Eg
      play sound SndEgg
      ShowScore
      if Eg = 0 then
        Clr = 1
        play sound SndLevel
      end if
    case TFrog
      Sc = Sc + (Lv + 1) * 10
      play sound SndFrog
      ShowScore
    case TJewel
      V = 5
      while V >= 5
        Rand
        V = Rs & 7
      end while
      Sc = Sc + V * 20 + 20
      play sound SndJewel
      ShowScore
  end select
  return
end sub

' the button: the head snaps back one cell
sub StartBack:
  V = Dir[Len]
  Md = V ^ 2
  PopSeg
  Mv = 2
  Mt = 0
  if Len > 0 then Face = Dir[Len]
  play sound SndBack
  return
end sub

' take the head's cell off the snake; the head is then the cell before
sub PopSeg:
  put char FloorAt(Hc, Hr) at Hc,Hr
  MarkCell(Hc, Hr, 0)
  V = Dir[Len] ^ 2
  Hc = Hc + DCol[V]
  Hr = Hr + DRow[V]
  dec Len
  if Len > 0 then
    put char TSn0 + Bit[Dir[Len] ^ 2] at Hc,Hr
  else
    put char TNest at Hc,Hr
  end if
  return
end sub

' the floor tile of cell (Cx, Cy): a lane or the plain floor
function FloorAt(u8 Cx, u8 Cy) as u8
  if Cx = 9 or Cx = 10 or Cx = 20 or Cx = 21 then return TLane
  if Cy = 7 or Cy = 8 or Cy = 16 or Cy = 17 then return TLane
  return TFloor

' the snake is on (Put1 1) or off (Put1 0) cell (Cx, Cy): note it in the lanes
sub MarkCell(u8 Cx, u8 Cy, u8 Put1)
  Mo = Put1
  if Cx >= 9 and Cx <= 10 then
    Mi = Cy
    Mb = Cx - 8
    MarkV
  end if
  if Cx >= 20 and Cx <= 21 then
    Mi = Cy + 24
    Mb = Cx - 19
    MarkV
  end if
  if Cy >= 7 and Cy <= 8 then
    Mi = Cx
    Mb = Cy - 6
    MarkH
  end if
  if Cy >= 16 and Cy <= 17 then
    Mi = Cx + 32
    Mb = Cy - 15
    MarkH
  end if
  return
end sub

sub MarkV:
  V = LnV[Mi]
  if Mo = 1 then
    V = V | Mb
  else
    U = 3 - Mb
    V = V & U
  end if
  LnV[Mi] = V
  return
end sub

sub MarkH:
  V = LnH[Mi]
  if Mo = 1 then
    V = V | Mb
  else
    U = 3 - Mb
    V = V & U
  end if
  LnH[Mi] = V
  return
end sub

' bitten: a moment, then the snake goes, head first, a cell every three
' frames; then a pause; then the
' next snake in the den, or the end
sub DeadStep:
  if Dead = 1 then
    if Dw > 0 then
      dec Dw
    elseif Len > 0 then
      PopSeg
      play sound SndCrunch
      Dw = 2
    else
      Dead = 2
      Dw = 60
    end if
    return
  end if
  dec Dw
  if Dw = 0 then
    dec Lives
    ShowLives
    if Lives = 0 then
      Over = 1
    else
      Dead = 0
      Face = 0
      Mv = 0
    end if
  end if
  return
end sub

' every egg eaten: the snake goes home a cell a frame, then the next level
sub ClrStep:
  if Len > 0 then
    PopSeg
    V = Len & 1
    if V = 0 then play sound SndBack
    return
  end if
  if Lv < 8 then inc Lv
  SetLevel
  Clr = 0
  Mv = 0
  Face = 0
  return
end sub

' a level: the rats' speed, the eggs, the walls' colours, the score line
sub SetLevel:
  Spd = SpdT[Lv]
  Eg = Lv * 4 + 1
  for Pe = 1 to Eg
    T = TEgg
    PlaceOne
  next
  for Pe = 1 to 4
    T = TFrog
    PlaceOne
  next
  ' one try for the jewel
  RandSpot
  X = SpotC[K]
  Y = SpotR[K]
  V = get char at X,Y
  if V = TFloor then put char TJewel at X,Y
  W16 = Lv * 128
  copy WallCol + W16 count WallBytes to vram.color + TW0 * 8
  ShowLevel
  return
end sub

' put tile T on a random hiding place that is empty or holds a frog
sub PlaceOne:
  Got = 0
  while Got = 0
    RandSpot
    X = SpotC[K]
    Y = SpotR[K]
    V = get char at X,Y
    if V = TFloor then Got = 1
    if V = TFrog then Got = 1
  end while
  put char T at X,Y
  return
end sub

' K = a random hiding place (0 .. NSpots - 1)
sub RandSpot:
  K = 255
  while K >= NSpots
    Rand
    K = Rs & 63
  end while
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the head, 1-4 the rats of this level's set
sub DrawSprites:
  if Dead = 2 then
    set sprite 0 to 192,0,0,0
  else
    X = Hc * 8 - 4
    Y = Hr * 8 - 4
    if Mv > 0 then
      V = Mt << 1
      V = 8 - V
      if Md = 0 then Y = Y + V
      if Md = 1 then X = X - V
      if Md = 2 then Y = Y - V
      if Md = 3 then X = X + V
    end if
    if Dead = 1 then
      K = Face << 2
      K = K + SHx0
    else
      K = Face << 3
      K = K + SHd00
      V = Tick & 16
      if V > 0 then K = K + 4
    end if
    set sprite 0 to Y - 1,X,K,11
  end if
  S = Lv & 1
  S = S << 2
  for Rk = 0 to 3
    J = Rk + 1
    K = S + Rk
    RatSprite
  next
  update sprites
  return
end sub

' rat K as sprite J
sub RatSprite:
  L2 = RLane[K]
  Pp = Rp[K]
  T = ((Pp >> 2) & 1) * 4
  C = 14
  V = L2 & 1
  if V = 1 then C = 9
  if L2 < 2 then
    if Pp >= 208 then
      set sprite J to 192,0,0,0
      return
    end if
    if Pp >= 17 then
      Y = Pp - 17
    else
      Y = Pp + 239
    end if
    X = 72
    if L2 = 1 then X = 160
    D = 0
    if RFwd[K] = 1 then D = 2
  else
    if Pp >= 272 then
      set sprite J to 192,0,0,0
      return
    end if
    if Pp < 16 then
      X = Pp + 16
      C = C | 128
    else
      X = Pp - 16
    end if
    Y = 55
    if L2 = 3 then Y = 127
    D = 3
    if RFwd[K] = 1 then D = 1
  end if
  T = T + D * 8 + SRt00
  set sprite J to Y,X,T,C
  return
end sub

sub ShowScore:
  print at 2,1, digits$(Sc, 5)
  print at 7,1, "0"
  return
end sub

sub ShowLevel:
  print at 12,1, "LEVEL "
  NumU = Lv + 1
  print at 18,1, digits$(NumU, 1)
  return
end sub

sub ShowLives:
  for J = 0 to 2
    if J < Lives then
      put char TLife at J * 2 + 23,1
    else
      put char 32 at J * 2 + 23,1
    end if
  next
  return
end sub

sub NewGame:
  NewScreen
  copy MazeMap count 768 to vram.name
  fill array LnV with 0
  fill array LnH with 0
  for Rk = 0 to 7
    Rf[Rk] = 0
    Pp = 224
    if RLane[Rk] >= 2 then Pp = 304
    Rp[Rk] = Pp
  next
  Lv = 0
  Sc = 0
  Lives = 3
  Len = 0
  Hc = StartC
  Hr = StartR
  Face = 0
  Mv = 0
  Mt = 0
  Dead = 0
  Clr = 0
  Over = 0
  SetLevel
  ShowScore
  ShowLives
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 5
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SNAP SNAKE in snake pieces, the head flicking its tongue, a
' rat running by, what things are worth, START / CREDITS, the tune once
sub TitlePage:
  NewScreen
  fill TGrass count 32 at 0,0
  fill TGrass count 32 at 0,23
  copy TitleMap count 384 to vram.name + 96
  print at 8,1, "AHOY! JUNE 1988"
  put char TEgg at 7,16
  print at 9,16, "  50 POINTS"
  put char TFrog at 7,17
  print at 9,17, " 100 X LEVEL"
  put char TJewel at 7,18
  print at 9,18, " MYSTERY"
  print at 12,20, "START"
  print at 12,21, "CREDITS"
  if Hi > 0 then
    print at 10,22, "BEST "
    NumU = Hi
    print at 15,22, digits$(NumU, 5)
    print at 20,22, "0"
  end if
  ShowMenu
  TRx = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub TitleAnim:
  K = Tick & 16
  T = SHd10
  if K > 0 then T = SHd11
  set sprite 0 to 99,204,T,11
  inc TRx
  W16 = TRx
  W16 = W16 >> 2
  T = W16 & 1
  T = T << 2
  T = T + SRt10
  set sprite 1 to 111,TRx,T,14
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,20
  put char 32 at 10,21
  J = Menu + 20
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "SNAP  SNAKE"
  print at 2,5, "BASED ON SNAP SNAKE BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! JUNE 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: RATTLER RIDGE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

