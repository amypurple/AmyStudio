data TitleMap bytes
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$8B,$8F,$8D,$80,$8B,$8F,$91,$80,$8B,$8F,$91,$80,$8B,$8F,$91,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$8A,$80,$80,$80,$8A,$80,$8A,$80,$8A,$80,$8A,$80,$8A,$80,$8A,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$88,$8F,$91,$80,$8A,$80,$8A,$80,$8C,$8F,$92,$80,$8A,$87,$8E,$80,$80,$80,$80,$80,$80,$80,$80
