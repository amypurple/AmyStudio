project "3D Solar System"
memory "colecovision_legacy_sdcc"

asset SolarSunPattern from "@project/solar-system-encyclopedia-assets/sun.pattern.zx0" codec zx0
asset SolarSunColor from "@project/solar-system-encyclopedia-assets/sun.color.zx0" codec zx0
asset SolarSunFrames0 from "@project/solar-system-encyclopedia-assets/sun.frames-0.zx0" codec zx0
asset SolarSunFrames1 from "@project/solar-system-encyclopedia-assets/sun.frames-1.zx0" codec zx0
asset SolarMercuryPattern from "@project/solar-system-encyclopedia-assets/mercury.pattern.zx0" codec zx0
asset SolarMercuryColor from "@project/solar-system-encyclopedia-assets/mercury.color.zx0" codec zx0
asset SolarMercuryFrames0 from "@project/solar-system-encyclopedia-assets/mercury.frames-0.zx0" codec zx0
asset SolarMercuryFrames1 from "@project/solar-system-encyclopedia-assets/mercury.frames-1.zx0" codec zx0
asset SolarVenusPattern from "@project/solar-system-encyclopedia-assets/venus.pattern.zx0" codec zx0
asset SolarVenusColor from "@project/solar-system-encyclopedia-assets/venus.color.zx0" codec zx0
asset SolarVenusFrames0 from "@project/solar-system-encyclopedia-assets/venus.frames-0.zx0" codec zx0
asset SolarVenusFrames1 from "@project/solar-system-encyclopedia-assets/venus.frames-1.zx0" codec zx0
asset SolarEarthPattern from "@project/solar-system-encyclopedia-assets/earth.pattern.zx0" codec zx0
asset SolarEarthColor from "@project/solar-system-encyclopedia-assets/earth.color.zx0" codec zx0
asset SolarEarthFrames0 from "@project/solar-system-encyclopedia-assets/earth.frames-0.zx0" codec zx0
asset SolarEarthFrames1 from "@project/solar-system-encyclopedia-assets/earth.frames-1.zx0" codec zx0
asset SolarMoonPattern from "@project/solar-system-encyclopedia-assets/moon.pattern.zx0" codec zx0
asset SolarMoonColor from "@project/solar-system-encyclopedia-assets/moon.color.zx0" codec zx0
asset SolarMoonFrames0 from "@project/solar-system-encyclopedia-assets/moon.frames-0.zx0" codec zx0
asset SolarMoonFrames1 from "@project/solar-system-encyclopedia-assets/moon.frames-1.zx0" codec zx0
asset SolarMarsPattern from "@project/solar-system-encyclopedia-assets/mars.pattern.zx0" codec zx0
asset SolarMarsColor from "@project/solar-system-encyclopedia-assets/mars.color.zx0" codec zx0
asset SolarMarsFrames0 from "@project/solar-system-encyclopedia-assets/mars.frames-0.zx0" codec zx0
asset SolarMarsFrames1 from "@project/solar-system-encyclopedia-assets/mars.frames-1.zx0" codec zx0
asset SolarJupiterPattern from "@project/solar-system-encyclopedia-assets/jupiter.pattern.zx0" codec zx0
asset SolarJupiterColor from "@project/solar-system-encyclopedia-assets/jupiter.color.zx0" codec zx0
asset SolarJupiterFrames0 from "@project/solar-system-encyclopedia-assets/jupiter.frames-0.zx0" codec zx0
asset SolarJupiterFrames1 from "@project/solar-system-encyclopedia-assets/jupiter.frames-1.zx0" codec zx0
asset SolarSaturnPattern from "@project/solar-system-encyclopedia-assets/saturn.pattern.zx0" codec zx0
asset SolarSaturnColor from "@project/solar-system-encyclopedia-assets/saturn.color.zx0" codec zx0
asset SolarSaturnFrames0 from "@project/solar-system-encyclopedia-assets/saturn.frames-0.zx0" codec zx0
asset SolarSaturnFrames1 from "@project/solar-system-encyclopedia-assets/saturn.frames-1.zx0" codec zx0
asset SolarUranusPattern from "@project/solar-system-encyclopedia-assets/uranus.pattern.zx0" codec zx0
asset SolarUranusColor from "@project/solar-system-encyclopedia-assets/uranus.color.zx0" codec zx0
asset SolarUranusFrames0 from "@project/solar-system-encyclopedia-assets/uranus.frames-0.zx0" codec zx0
asset SolarUranusFrames1 from "@project/solar-system-encyclopedia-assets/uranus.frames-1.zx0" codec zx0
asset SolarNeptunePattern from "@project/solar-system-encyclopedia-assets/neptune.pattern.zx0" codec zx0
asset SolarNeptuneColor from "@project/solar-system-encyclopedia-assets/neptune.color.zx0" codec zx0
asset SolarNeptuneFrames0 from "@project/solar-system-encyclopedia-assets/neptune.frames-0.zx0" codec zx0
asset SolarNeptuneFrames1 from "@project/solar-system-encyclopedia-assets/neptune.frames-1.zx0" codec zx0
asset SolarPlutoPattern from "@project/solar-system-encyclopedia-assets/pluto.pattern.zx0" codec zx0
asset SolarPlutoColor from "@project/solar-system-encyclopedia-assets/pluto.color.zx0" codec zx0
asset SolarPlutoFrames0 from "@project/solar-system-encyclopedia-assets/pluto.frames-0.zx0" codec zx0
asset SolarPlutoFrames1 from "@project/solar-system-encyclopedia-assets/pluto.frames-1.zx0" codec zx0
asset SolarSharedSprites from "@project/solar-system-encyclopedia-assets/shared-sprites.pattern.zx0" codec zx0

data SolarPatternAssets words
  @SolarSunPattern,@SolarMercuryPattern,@SolarVenusPattern,@SolarEarthPattern,
  @SolarMoonPattern,@SolarMarsPattern,@SolarJupiterPattern,@SolarSaturnPattern,
  @SolarUranusPattern,@SolarNeptunePattern,@SolarPlutoPattern
end data

data SolarColorAssets words
  @SolarSunColor,@SolarMercuryColor,@SolarVenusColor,@SolarEarthColor,
  @SolarMoonColor,@SolarMarsColor,@SolarJupiterColor,@SolarSaturnColor,
  @SolarUranusColor,@SolarNeptuneColor,@SolarPlutoColor
end data

u8 SolarFrames[512]
u8 SolarChoice = 1
u8 SolarIndex = 0
u8 SolarFrame = 0
u8 SolarTicks = 0
u8 SolarFrameHalf = 0
u8 SolarFrameAsset = 1
u8 SolarLocalFrame = 0
u8 SolarMenuActive = 0
u8 SolarStarTicks = 0
u8 SolarStarFrame = 64

on vblank SolarAnimateStars

text screen
backdrop black
nmi off
sprites 16x16
fill $F0 count 2048 to vram.color
' Graphics II has three independent character banks. Reuse only the visible
' BIOS glyph range (space through Z) in the bottom bank for rows 18-21.
copy vram.pattern + $0100 count 32 to vram.pattern + $1100
copy vram.pattern + $0120 count 32 to vram.pattern + $1120
copy vram.pattern + $0140 count 32 to vram.pattern + $1140
copy vram.pattern + $0160 count 32 to vram.pattern + $1160
copy vram.pattern + $0180 count 32 to vram.pattern + $1180
copy vram.pattern + $01A0 count 32 to vram.pattern + $11A0
copy vram.pattern + $01C0 count 32 to vram.pattern + $11C0
copy vram.pattern + $01E0 count 32 to vram.pattern + $11E0
copy vram.pattern + $0200 count 32 to vram.pattern + $1200
copy vram.pattern + $0220 count 32 to vram.pattern + $1220
copy vram.pattern + $0240 count 32 to vram.pattern + $1240
copy vram.pattern + $0260 count 32 to vram.pattern + $1260
copy vram.pattern + $0280 count 32 to vram.pattern + $1280
copy vram.pattern + $02A0 count 32 to vram.pattern + $12A0
copy vram.pattern + $02C0 count 24 to vram.pattern + $12C0
fill $F0 count 2048 to vram.color + $1000
decompress zx0 SolarSharedSprites to vram.spr_pat
call asm SolarUploadStarPattern with a = 64
nmi on

SolarMenu:
screen off
nmi off
text screen
clear sprites
sprites 8x8
set sprite count 6
set sprite 0 to 23,24,64,15
set sprite 1 to 39,216,65,11
set sprite 2 to 79,40,65,7
set sprite 3 to 103,224,64,15
set sprite 4 to 135,16,65,11
set sprite 5 to 159,232,64,7
update sprites
fill $00 count 768 to vram.name
print centered at 2, "3D SOLAR SYSTEM"
print at 5,5, "SUN"
print at 5,6, "MERCURY"
print at 5,7, "VENUS"
print at 5,8, "EARTH"
print at 5,9, "MOON"
print at 5,10, "MARS"
print at 5,11, "JUPITER"
print at 5,12, "SATURN"
print at 5,13, "URANUS"
print at 5,14, "NEPTUNE"
print at 5,15, "PLUTO"
SolarMenuActive = 1
nmi on
screen on
choose menu 1 to 11 into SolarChoice cursor $3E at 3,5 step 1 sleep after 10 seconds

SolarMenuActive = 0
SolarIndex = SolarChoice - 1
nmi off
call asm SolarPlayCompressedVoice with a = SolarIndex
screen off
picture screen
sprites 16x16
decompress zx0 SolarPatternAssets[SolarIndex] to vram.pattern + $0800
decompress zx0 SolarColorAssets[SolarIndex] to vram.color + $0800
SolarFrameHalf = 0
SolarFrameAsset = SolarIndex * 2 + 1
call asm SolarLoadFrames with a = SolarFrameAsset
fill $00 count 768 to vram.name
SolarFrame = 0
SolarTicks = 0
call asm SolarDrawFrame with a = SolarFrame
if SolarChoice = 8 then
  call asm SolarUseSaturnSprites
else
  call asm SolarUseNormalSprites
end if
SolarPrintFacts
nmi on
screen on
wait no fire

SolarView:
wait
if joypad(1).fire then goto SolarLeaveView
SolarTicks += 1
if SolarTicks = 10 then
  SolarTicks = 0
  SolarFrame += 1
  if SolarFrame = 16 then
    SolarFrame = 0
    SolarFrameHalf = 0
    SolarFrameAsset = SolarIndex * 2 + 1
    nmi off
    call asm SolarLoadFrames with a = SolarFrameAsset
    nmi on
  elseif SolarFrame = 8 then
    SolarFrameHalf = 1
    SolarFrameAsset = SolarIndex * 2 + 2
    nmi off
    call asm SolarLoadFrames with a = SolarFrameAsset
    nmi on
  end if
  SolarLocalFrame = SolarFrame
  and SolarLocalFrame with 7
  nmi off
  call asm SolarDrawFrame with a = SolarLocalFrame
  nmi on
end if
goto SolarView

SolarLeaveView:
wait no fire
goto SolarMenu

sub SolarAnimateStars:
  if SolarMenuActive = 0 then return
  SolarStarTicks += 1
  if SolarStarTicks < 10 then return
  SolarStarTicks = 0
  if SolarStarFrame = 64 then
    SolarStarFrame = 65
  else
    SolarStarFrame = 64
  end if
  call asm SolarUploadStarPattern with a = SolarStarFrame
  return

sub SolarPrintFacts:
  print at 2,17, "DIAMETER"
  print at 2,19, "MASS"
  if SolarChoice = 1 then
    print centered at 2, "SUN"
    print centered at 5, "STAR"
    print at 11,17, "1.39 MILLION KM"
    print at 7,19, "333,000 EARTHS"
    print at 2,21, "HYDROGEN AND HELIUM"
  elseif SolarChoice = 2 then
    print centered at 2, "MERCURY"
    print centered at 5, "SMALLEST PLANET"
    print at 11,17, "4,879 KM"
    print at 7,19, "0.055 EARTHS"
    print at 2,21, "YEAR 88 EARTH DAYS"
  elseif SolarChoice = 3 then
    print centered at 2, "VENUS"
    print centered at 5, "HOTTEST PLANET"
    print at 11,17, "12,104 KM"
    print at 7,19, "0.815 EARTHS"
    print at 2,21, "THICK CO2 ATMOSPHERE"
  elseif SolarChoice = 4 then
    print centered at 2, "EARTH"
    print centered at 5, "ROCKY PLANET"
    print at 11,17, "12,742 KM"
    print at 7,19, "1.000 EARTH"
    print at 2,21, "LIQUID SURFACE WATER"
  elseif SolarChoice = 5 then
    print centered at 2, "MOON"
    print centered at 5, "EARTH'S MOON"
    print at 11,17, "3,475 KM"
    print at 7,19, "0.0123 EARTHS"
    print at 2,21, "AIRLESS AND CRATERED"
  elseif SolarChoice = 6 then
    print centered at 2, "MARS"
    print centered at 5, "ROCKY PLANET"
    print at 11,17, "6,779 KM"
    print at 7,19, "0.107 EARTHS"
    print at 2,21, "TWO SMALL MOONS"
  elseif SolarChoice = 7 then
    print centered at 2, "JUPITER"
    print centered at 5, "LARGEST PLANET"
    print at 11,17, "139,820 KM"
    print at 7,19, "317.8 EARTHS"
    print at 2,21, "GAS GIANT - GREAT RED SPOT"
  elseif SolarChoice = 8 then
    print centered at 2, "SATURN"
    print centered at 5, "RINGED GAS GIANT"
    print at 11,17, "116,460 KM"
    print at 7,19, "95.2 EARTHS"
    print at 2,21, "BRIGHT ICY RINGS"
  elseif SolarChoice = 9 then
    print centered at 2, "URANUS"
    print centered at 5, "ICE GIANT"
    print at 11,17, "50,724 KM"
    print at 7,19, "14.5 EARTHS"
    print at 2,21, "ROTATES ON ITS SIDE"
  elseif SolarChoice = 10 then
    print centered at 2, "NEPTUNE"
    print centered at 5, "DISTANT ICE GIANT"
    print at 11,17, "49,244 KM"
    print at 7,19, "17.1 EARTHS"
    print at 2,21, "FASTEST PLANET WINDS"
  else
    print centered at 2, "PLUTO"
    print centered at 5, "DWARF PLANET"
    print at 11,17, "2,377 KM"
    print at 7,19, "0.0022 EARTHS"
    print at 2,21, "KUIPER BELT - ICY HEART"
  end if
end sub

include "@project/solar-system-encyclopedia-assets/runtime.asm"
include "@project/solar-system-encyclopedia-assets/stars.asm"
include "@project/solar-system-encyclopedia-assets/voices.asm"
