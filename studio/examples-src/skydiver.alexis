data SpritePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
SdHush:
    db $00,$00,$F4,$01,$10
SdTick:
    db $40,$40,$50,$01,$50
SdJump:
    db $00,$00,$35,$03,$00,$00,$65,$03,$00,$00,$96,$03,$10
SdOpen:
    db $00,$00,$14,$02,$00,$00,$45,$04,$00,$00,$85,$04,$10
SdMiss:
    db $40,$1D,$21,$07,$40,$1D,$F1,$01,$40,$41,$21,$07,$40,$41,$F1,$01,$40,$53,$21,$07,$40,$53,$F1,$01
    db $40,$7C,$21,$07,$40,$7C,$F1,$01,$40,$AB,$21,$13,$40,$AB,$F1,$01,$50
SdCrash:
    db $00,$00,$05,$03,$00,$00,$16,$05,$00,$00,$37,$08,$00,$00,$67,$0A,$10
SdAdvance:
    db $40,$AA,$20,$05,$40,$AA,$F0,$01,$40,$A0,$20,$05,$40,$A0,$F0,$01,$40,$8F,$20,$09,$40,$8F,$F0,$01
    db $40,$AA,$20,$05,$40,$AA,$F0,$01,$40,$A0,$20,$05,$40,$A0,$F0,$01,$40,$BF,$20,$05,$40,$BF,$F0,$01
    db $40,$AA,$20,$05,$40,$AA,$F0,$01,$40,$D6,$20,$05,$40,$D6,$F0,$01,$40,$BF,$20,$0F,$40,$BF,$F0,$01
    db $50
SdPoint:
    db $40,$55,$60,$01,$50

SdSoundTable:
    dw SdHush,$702B
    dw SdTick,$7035
    dw SdJump,$702B
    dw SdOpen,$702B
    dw SdMiss,$7035
    dw SdCrash,$702B
    dw SdAdvance,$7035
    dw SdPoint,$7035
    dw SdTuneMel,$703F
    dw SdTuneBass,$7049
    dw SdLandMel,$703F
    dw SdLandBass,$7049
; Open Sky, C major (original for this game)
; Tiny Sound, 7 frames per step
SdTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$F1,$22,$1F,$00,$23,$00,$26,$00,$2B,$00,$00,$00,$2A,$00
    db $28,$00,$26,$00,$23,$00,$00,$00,$24,$00,$23,$00,$21,$00,$1F,$00
    db $21,$00,$23,$00,$1F,$00,$00,$00,$00,$00,$00,$00
    db $FF
SdTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$70,$F1,$22,$07,$0E,$13,$0E,$07,$0E,$13,$0E,$10,$0B,$10,$0B
    db $10,$0B,$10,$0B,$0C,$07,$0C,$07,$0E,$09,$0E,$09,$07,$0E,$13,$0E
    db $0B,$0E,$13,$0E,$07,$0E,$13,$0E,$07,$00,$00,$00
    db $FF
; the landing tune of Program 2 (Super Expander), from its DATA
; Tiny Sound, 6 frames per step
SdLandMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$1A,$21,$21,$00,$1F,$00,$24,$00,$26,$2B,$28,$00,$26,$2B
    db $28,$00,$24,$00,$26,$00,$21,$00,$1F,$00,$2C,$00,$2B,$00,$00,$00
    db $00
    db $FF
SdLandBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$80,$18,$32,$15,$00,$13,$00,$18,$00,$1A,$1F,$1C,$00,$1A,$1F
    db $1C,$00,$18,$00,$1A,$00,$15,$00,$13,$00,$20,$00,$1F,$00,$00,$00
    db $00
    db $FF

; OrCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
OrCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
OrCellDiv:
    or a
    sbc hl,de
    jr c,OrCellRem
    inc b
    jr OrCellDiv
OrCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; OrPeek: Pk = the tile at B (PEEK(B))
OrPeek:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; OrPoke: the tile Tl at B (POKE B,Tl)
OrPoke:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret
}
