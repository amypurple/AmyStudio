' Runtime regression for compound arithmetic with indexed array operands.
' Expected: both word results are 600 and both byte results are 45.
u16 Words[3]
u8 Bytes[3]
u8 Index = 1
u16 WordDynamic = 0
u16 WordConstant = 0
u8 ByteDynamic = 0
u8 ByteConstant = 0
u8 Done = 0

Words[0] = 7
Words[1] = 30
Words[2] = 1000
Bytes[0] = 3
Bytes[1] = 9
Bytes[2] = 11

WordDynamic = 20
WordDynamic *= Words[Index]
WordConstant = 20
WordConstant *= Words[1]
ByteDynamic = 5
ByteDynamic *= Bytes[Index]
ByteConstant = 5
ByteConstant *= Bytes[1]
Done = 1
loop forever
