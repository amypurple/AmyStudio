const CursorTile = $40
const EmptyTile = $20

u8 X = 15
u8 Y = 11
u8 OldX = 15
u8 OldY = 11

' Inline joypad input with a text-mode cursor.
  text screen
  print at 10,3, "INLINE INPUT"
  put char CursorTile at X,Y
  screen on
  goto main_loop

main_loop:
  wait 2 frames
  OldX = X
  OldY = Y
  if joypad(1).left then
    if X > 0 then X -= 1
  elseif joypad(1).right then
    if X < 31 then X += 1
  elseif joypad(1).up then
    if Y > 0 then Y -= 1
  elseif joypad(1).down then
    if Y < 23 then Y += 1
  end if
  put char EmptyTile at OldX,OldY
  put char CursorTile at X,Y
  goto main_loop