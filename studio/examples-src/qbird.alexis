QbSoundTable:
    dw QbTuneMel,$702B
    dw QbTuneBass,$7035
    dw QbHop,$7049
    dw QbLeap,$7049
    dw QbPaint,$7049
    dw QbFall,$7049
    dw QbCaught,$703F
    dw QbWorm,$7049
    dw QbClear,$7049
    dw QbReady,$7049
    dw QbOver,$7049
; First Flight (original)
; Tiny Sound, 8 frames per step
QbTuneMel:
    db $44
    dw sndtiny_1
