    db $02,$60,$F1,$22,$26,$01,$2A,$01,$2D,$01,$2A,$01,$2B,$01,$28,$01
    db $01,$01,$25,$01,$28,$01,$2B,$01,$28,$01,$2A,$01,$26,$01,$01,$01
    db $23,$01,$26,$01,$2A,$01,$26,$01,$28,$01,$25,$01,$21,$01,$01,$01
    db $01,$21,$01,$26,$01,$28,$01,$2A,$01,$2D,$01,$2A,$01,$32,$01,$01
    db $01,$01,$00,$01
