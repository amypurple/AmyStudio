' BCD self-test
bcd digits 4 Coins

  text screen
  print at 11,0, "BCD TEST"
  print at 1,4, "EXPECT 0000"
  print at 1,7, "EXPECT 0025"
  print at 1,10, "EXPECT 0035"
  print at 1,13, "EXPECT 0030"
  print at 1,16, "EXPECT 0000"
  print at 1,19, "EXPECT 0042"
  Coins = 0
  screen on

  print at 14,4, Coins
  Coins += 25
  print at 14,7, Coins
  Coins += 10
  print at 14,10, Coins
  Coins -= 5
  print at 14,13, Coins
  Coins -= 99
  print at 14,16, Coins
  show_local_bcd

sub show_local_bcd:
  bcd digits 4 Temp
  Temp += 42
  print at 14,19, Temp
end sub