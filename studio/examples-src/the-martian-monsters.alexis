asm {
; MmStars: the star cells, rows 2-18, columns 2-29, from StarMap (17 rows
; of 128 bytes, each row's 64 cells stored twice) at offset Soff: 28 bytes a
; row at 32 cycles a byte (outi, nop), with the NMI off
MmStars:
    ld hl,AMY_UDATA_StarMap
    ld a,(AMY_UVAR_Soff)
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    ld de,VRAM_NAME+66
    ld a,17
MmS1:
    push af
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    push hl
    ld b,28
    ld c,$BE
MmS2:
    outi
    nop
    jr nz,MmS2
    pop hl
    ld bc,128
    add hl,bc
    ex de,hl
    ld bc,32
    add hl,bc
    ex de,hl
    pop af
    dec a
    jr nz,MmS1
    ret
MmZap:
