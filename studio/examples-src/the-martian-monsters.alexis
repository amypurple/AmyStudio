cartridge "THE MARTIAN MONSTERS/J. C. HILTY, AHOY!/1986"

' THE MARTIAN MONSTERS
' After the game by J. C. Hilty, Ahoy! January 1986 (Commodore 64 BASIC,
' with machine-language sprite and scroll routines), made for the
' ColecoVision in Amy by Amy Bienvenu. By Claude (an AI made by
' Anthropic) for Amy Studio, 2026.
'
' The game (the listing, orig/): your rocket flies across the screen by
' itself, left to right, coming back on the left; the stick moves it up
' and down. Five Martian monsters drift along the top, each at its own
' speed. The button fires a laser straight up: a monster hit is 100
' points; a shot that reaches the top is a missed shot. A monster that
' touches your rocket eats it. Five rockets; the game ends when the last
' is eaten or at the fifth missed shot ("YUMMY... YUMMY... YUMMY... WE GOT
' SPACESHIPS IN OUR TUMMY!!!!").
'
' Made for this machine (the improvements, the listing's rules kept):
' - the stars scroll smoothly by (two star tiles moved a pixel at a time,
'   their cells moved by an asm routine every 8 pixels), over the red
'   Martian ground;
' - the monsters bob as they drift, wave their arms, and the hungry ones
'   swoop down at you now and then (more often at each level); a swooping
'   monster goes back up when it misses;
' - left and right speed your rocket up or slow it down (it never stops,
'   as in the listing);
' - a level every 1000 points: faster monsters, more swoops; an extra
'   rocket every 3000 points (nine at most);
' - the monster that eats you gobbles (the listing's GOBBLE pictures) and
'   your next rocket arrives safe for two seconds, drawn grey (no
'   blinking).
'
' Controls (either joystick): up and down move the rocket, left slows it,
' right speeds it, the button fires. Keypad not used.
'
' House rules: text in columns 2-29; tiles from code 128; screens drawn
' with the NMI off after a wait; music first in the sound table ($702B,
' $7035), effects after by channel; `set sprite count` given;
' nothing flashes faster than 3 times a second.
'
' Workarounds for Amy bugs 25 (sprite count) removed 2026-11-01.

const TStar = 128
const TStar2 = 129
const THillL = 130
const THillR = 131
const TRock = 132
const TRock2 = 133
const TCratL = 134
const TCratR = 135
const TSky = 136
const TCR = 137
const TCB = 138
const TCG = 139
const TShipIcon = 140
const TMissOn = 141
const TMissOff = 142
const SShipD = 0
const SShipD2 = 4
const SShip = 8
const SLaser = 12
const SMon = 16
const SMon2 = 20
const SGob = 24
const SGob2 = 28
const SBoom = 32
const SBoom2 = 36
const NTiles8 = 120
const SprBytes = 320
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndZap = 5
const SndBoom = 6
const SndMiss = 7
const SndGobble = 8
const SndCrunch = 9
const SndSwoop = 10
const SndHungry = 11
const SndExtra = 12
const SndLevel = 13
const SndOver = 14
u16 TzLeft = 0
u8 TzOn = 0

u16 Score = 0
u16 Hi = 0
u16 NextX = 3000
u16 NextL = 1000
u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
u16 Rs = 1
u8 Ships = 5
u8 Missed = 0
u8 Level = 1
u8 Over = 0
u8 Why = 0
' the rocket: Sx in 1/16 pixel (24-216 pixels), Sy in pixels;
' Safe frames it can't be eaten; Gob 1 while a monster gobbles it, Gt
' frames left of it, Gm the monster
u16 Sx = 2048
u8 Sy = 120
u8 Safe = 0
u8 Gob = 0
u8 Gt = 0
u8 Gm = 0
' the laser
u8 Lon = 0
u8 Lx = 0
u8 Ly = 0
' the five monsters: Mx My in 1/16 pixel; Ms 0 drifting, 1 swooping,
' 2 going back up, 3 bursting, 4 waiting to come back, 5 gobbling; Mt a
' timer; Md 0 left 1 right; Msp the speed (1/16 a frame)
u16 Mx[5]
u16 My[5]
u8 Ms[5]
u8 Mt[5]
u8 Md[5]
u8 Msp[5]
' the stars: Spx the pixel (0-7) of the cell, Soff the map's place (0-63)
u8 Spx = 0
u8 Soff = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Rot = 0
' for the bot: Ev events this frame (1 hit, 2 miss, 4 eaten, 8 swoop)
u8 Ev = 0
' scratch
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 T = 0
u8 X = 0
u8 Y = 0
u8 Hx = 0
u8 Hy = 0

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  Score = 0
  Ships = 5
  Missed = 0
  Level = 1
  NextX = 3000
  NextL = 1000
  Over = 0
  Why = 0
  Gob = 0
  Lon = 0
  ResetMonsters
  NewShip
  DrawField
  play sound SndHungry
  play sound SndRunA
  play sound SndRunB

play_loop:
  Frame1
  ReadPad
  Ev = 0
  Stars
  if Gob = 0 then
    PlayStep
  else
    GobStep
  end if
  DrawSprites
  if Over = 0 then goto play_loop

  stop sound SndRunA
  stop sound SndRunB
  if Score > Hi then Hi = Score
  YummyPage
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveShip
  MoveLaser
  MoveMonsters
  if Safe > 0 then dec Safe
  CheckEaten
  CheckLevel
  return
end sub

' MoveShip: the stick moves the rocket in all directions, 2 pixels a
' frame, kept well inside the screen (x 24-216, inside the overscan); the
' ground scrolls by itself so the flight goes on
sub MoveShip:
  if Rt1 = 1 then
    if Sx < 3456 then Sx = Sx + 32
  end if
  if Lf1 = 1 then
    if Sx > 384 then Sx = Sx - 32
  end if
  if Up1 = 1 then
    if Sy > 58 then Sy = Sy - 2
  end if
  if Dn1 = 1 then
    if Sy < 140 then Sy = Sy + 2
  end if
  if Press = 1 then
    if Lon = 0 then
      Lon = 1
      W16 = Sx >> 4
      Lx = W16
      Ly = Sy - 6
      play sound SndZap
    end if
  end if
  return
end sub

' MoveLaser: 6 pixels up a frame; it hits a monster whose body holds its
' tip; past the top it is a missed shot
sub MoveLaser:
  if Lon = 0 then return
  if Ly < 20 then
    Lon = 0
    inc Missed
    Ev = Ev | 2
    ShowMisses
    play sound SndMiss
    if Missed >= 5 then
      Over = 1
      Why = 1
    end if
    return
  end if
  Ly = Ly - 6
  ' the tip: 2 pixels into the sprite
  Hy = Ly + 2
  for I = 0 to 4
    if Ms[I] < 3 then
      W16 = Mx[I] >> 4
      X = W16
      V = Dist(X, Lx)
      if V < 9 then
        W16 = My[I] >> 4
        Y = W16
        if Hy >= Y then
          T = Y + 13
          if Hy <= T then
            Lon = 0
            Ms[I] = 3
            Mt[I] = 24
            Score = Score + 100
            Ev = Ev | 1
            ShowScore
            play sound SndBoom
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' MoveMonsters: each drifts at its speed (wrapping round the sides) and
' bobs; a hungry one swoops at the rocket; a burst counts down, then the
' monster waits and comes back from its side
sub MoveMonsters:
  ' a swoop now and then (Level in 256 a frame), when none is swooping
  W = 0
  for I = 0 to 4
    if Ms[I] = 1 then W = 1
    if Ms[I] = 2 then W = 1
  next
  if W = 0 then
    Rand
    W16 = Rs & 255
    V = W16
    if V < Level then
      Rand
      W16 = Rs & 7
      V = W16
      if V < 5 then
        if Ms[V] = 0 then
          Ms[V] = 1
          Ev = Ev | 8
          play sound SndSwoop
        end if
      end if
    end if
  end if
  for I = 0 to 4
    V = Ms[I]
    if V < 3 then
      W16 = Msp[I]
      if Md[I] = 0 then
        Mx[I] = Mx[I] - W16
      else
        Mx[I] = Mx[I] + W16
      end if
      Mx[I] = Mx[I] & 4095
      if V = 0 then
        ' bobbing at its home height
        W = Tick >> 1
        T = I * 6
        W = W + T
        W = W & 31
        Y = BaseY[I] + Bob[W]
        W16 = Y
        My[I] = W16 << 4
      end if
      if V = 1 then
        ' the swoop: down at 1.5 pixels a frame, steering to the rocket
        My[I] = My[I] + 24
        W16 = Sx >> 4
        X = W16
        W16 = Mx[I] >> 4
        Y = W16
        if Y < X then
          Mx[I] = Mx[I] + 8
        else
          Mx[I] = Mx[I] - 8
        end if
        Mx[I] = Mx[I] & 4095
        W16 = My[I] >> 4
        Y = W16
        T = Sy + 14
        if Y >= T then Ms[I] = 2
        if Y >= 150 then Ms[I] = 2
      end if
      if V = 2 then
        ' back up to its home height
        My[I] = My[I] - 16
        W16 = My[I] >> 4
        Y = W16
        T = BaseY[I] + 4
        if Y <= T then Ms[I] = 0
      end if
    else
      if V = 3 then
        dec Mt[I]
        if Mt[I] = 0 then
          Ms[I] = 4
          Mt[I] = 40
        end if
      elseif V = 4 then
        dec Mt[I]
        if Mt[I] = 0 then
          Ms[I] = 0
          if Md[I] = 0 then
            Mx[I] = 3840
          else
            Mx[I] = 0
          end if
        end if
      end if
    end if
  next
  return
end sub

' CheckEaten: a monster touching the rocket eats it
sub CheckEaten:
  if Safe > 0 then return
  W16 = Sx >> 4
  Hx = W16
  for I = 0 to 4
    if Ms[I] < 3 then
      W16 = Mx[I] >> 4
      X = W16
      V = Dist(X, Hx)
      if V < 11 then
        W16 = My[I] >> 4
        Y = W16
        V = Dist(Y, Sy)
        if V < 11 then
          Gob = 1
          Gt = 72
          Gm = I
          Ms[I] = 5
          Lon = 0
          Ev = Ev | 4
          play sound SndGobble
          play sound SndCrunch
          return
        end if
      end if
    end if
  next
  return
end sub

' GobStep: the monster gobbles; then a rocket less, and the next arrives
' safe (or the game ends)
sub GobStep:
  MoveMonsters
  dec Gt
  if Gt > 0 then return
  Gob = 0
  Ms[Gm] = 2
  dec Ships
  ShowShips
  if Ships = 0 then
    Over = 1
    Why = 2
    return
  end if
  NewShip
  return
end sub

' CheckLevel: a level every 1000 points, an extra rocket every 3000
sub CheckLevel:
  if Score >= NextL then
    NextL = NextL + 1000
    if Level < 9 then
      inc Level
      SetSpeeds
      ShowLevel
      play sound SndLevel
    end if
  end if
  if Score >= NextX then
    NextX = NextX + 3000
    if Ships < 9 then
      inc Ships
      ShowShips
      play sound SndExtra
    end if
  end if
  return
end sub

sub NewShip:
  Sx = 2048
  Sy = 120
  Safe = 120
  Lon = 0
  return
end sub

sub ResetMonsters:
  for I = 0 to 4
    V = StartX[I]
    W16 = V
    Mx[I] = W16 << 4
    Y = BaseY[I] + 4
    W16 = Y
    My[I] = W16 << 4
    Ms[I] = 0
    Mt[I] = 0
    Md[I] = MonDir[I]
  next
  SetSpeeds
  return
end sub

' SetSpeeds: the listing's speeds (1, 2, 2, 1, 3 pixels a step, here in
' 1/16 pixel a frame) and 2 more at each level
sub SetSpeeds:
  T = Level - 1
  T = T << 1
  for I = 0 to 4
    V = MonSpd[I]
    Msp[I] = V + T
  next
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function Dist(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

' ---------------------------------------------------------------------------
' the stars: a pixel left every 2 frames; every 8 pixels the cells move
' (MmStars), and the dot goes back to the right of its tile

sub Stars:
  V = Tick & 1
  if V = 1 then return
  inc Spx
  if Spx >= 8 then
    Spx = 0
    inc Soff
    Soff = Soff & 63
    call asm MmStars
  end if
  StarPat
  return
end sub

' StarPat: row 3 of the star tile, rows 3-4 of the bright one, in the
' three pattern tables
sub StarPat:
  V = Dot[Spx]
  W16 = TStar
  W16 = W16 << 3
  W16 = W16 + 3
  vpoke vram.pattern + W16, V
  A16 = W16 + 2048
  vpoke vram.pattern + A16, V
  A16 = W16 + 4096
  vpoke vram.pattern + A16, V
  W16 = TStar2
  W16 = W16 << 3
  W16 = W16 + 3
  vpoke vram.pattern + W16, V
  A16 = W16 + 2048
  vpoke vram.pattern + A16, V
  A16 = W16 + 4096
  vpoke vram.pattern + A16, V
  W16 = W16 + 1
  vpoke vram.pattern + W16, V
  A16 = W16 + 2048
  vpoke vram.pattern + A16, V
  A16 = W16 + 4096
  vpoke vram.pattern + A16, V
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0-1 the rocket, 2 the laser, 3-7 the monsters (their order
' turns every frame, so a crowded line flickers instead of losing one)

sub DrawSprites:
  if Gob = 0 then
    W16 = Sx >> 4
    X = W16
    Y = Sy - 1
    K = SShipD
    V = Tick & 4
    if V > 0 then K = SShipD2
    set sprite 0 to Y,X,K,9
    T = 15
    if Safe > 0 then T = 14
    set sprite 1 to Y,X,SShip,T
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  end if
  if Lon = 1 then
    Y = Ly - 1
    set sprite 2 to Y,Lx,SLaser,11
  else
    set sprite 2 to 192,0,0,0
  end if
  inc Rot
  if Rot >= 5 then Rot = 0
  for I = 0 to 4
    J = I + Rot
    if J >= 5 then J = J - 5
    J = J + 3
    V = Ms[I]
    if V = 4 then
      set sprite J to 192,0,0,0
    else
      W16 = Mx[I] >> 4
      X = W16
      W16 = My[I] >> 4
      W16 = W16 - 1
      Y = W16
      T = MonCol[I]
      if V = 3 then
        K = SBoom
        if Mt[I] < 12 then K = SBoom2
        T = 11
      elseif V = 5 then
        K = SGob
        W = Gt & 8
        if W > 0 then K = SGob2
      else
        K = SMon
        W = Tick & 16
        if W > 0 then K = SMon2
        ' near the rocket, the big mouth opens and snaps (as the listing's
        ' monsters do when they close in): within 40 pixels each way
        if Gob = 0 then
          W16 = Sx >> 4
          W = W16
          W = Dist(X, W)
          if W < 40 then
            W = Dist(Y, Sy)
            if W < 40 then
              K = SGob
              W = Tick & 8
              if W > 0 then K = SGob2
            end if
          end if
        end if
      end if
      set sprite J to Y,X,K,T
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' screens

' DrawField: the stars, the hills and the red ground, the counts
sub DrawField:
  NewScreen
  W16 = TStar * 8
  fill $F1 count 8 to vram.color + W16
  W16 = TStar2 * 8
  fill $B1 count 8 to vram.color + W16
  Spx = 0
  Soff = 0
  StarPat
  call asm MmStars
  for X = 0 to 31
    V = HillRow[X]
    put char V at X,19
    V = X & 3
    if V = 1 then
      put char TCratL at X,20
    elseif V = 2 then
      put char TCratR at X,20
    else
      put char TRock at X,20
    end if
    V = X & 1
    if V = 0 then
      put char TRock2 at X,21
    else
      put char TRock at X,21
    end if
  next
  ShowHud
  ShowScreen
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 15,1, "HI"
  NumU = Hi
  print at 18,1, digits$(NumU, 5)
  print at 25,1, "LV"
  ShowLevel
  ShowShips
  ShowMisses
  return
end sub

sub ShowScore:
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  return
end sub

sub ShowLevel:
  NumU = Level
  print at 28,1, digits$(NumU, 1)
  return
end sub

' the rockets left (up to 9 icons) and the missed shots (5 lamps)
sub ShowShips:
  for X = 0 to 8
    V = 32
    if X < Ships then V = TShipIcon
    T = X + 2
    put char V at T,22
  next
  return
end sub

sub ShowMisses:
  print at 15,22, "MISSED"
  for X = 0 to 4
    V = TMissOff
    if X < Missed then V = TMissOn
    T = X + 22
    put char V at T,22
  next
  return
end sub

' YummyPage: the listing's ending, then a press goes back to the title;
' left alone, Amy's sleep blanks the screen after 30 seconds
sub YummyPage:
  NewScreen
  print at 3,6, "YUMMY..."
  print at 11,7, "YUMMY..."
  print at 19,8, "YUMMY..."
  print at 6,11, "WE GOT SPACESHIPS"
  print at 8,12, "IN OUR TUMMY!!!!"
  if Why = 1 then print at 6,14, "(FIVE MISSED SHOTS)"
  print at 8,17, "SCORE"
  NumU = Score
  print at 15,17, digits$(NumU, 5)
  if Score >= Hi then
    if Score > 0 then print at 8,19, "A NEW HIGH SCORE!"
  end if
  ShowScreen
  set sprite 3 to 110,120,SGob,3
  update sprites
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  HideSprites
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' TitlePage: the listing's own monster, cell for cell, its two lines, a
' joystick menu
sub TitlePage:
  NewScreen
  print at 6,1, "THE MARTIAN MONSTERS"
  for J = 0 to 11
    W16 = J * 19
    A16 = J + 3
    A16 = A16 << 5
    A16 = A16 + 6
    copy TitlePic + W16 count 19 to vram.name + A16
  next
  print at 2,16, "...SPACESHIPS ARE OUR"
  print at 8,17, "FAVORITE FOOD..."
  print at 2,18, "...AND WE ARE GETTING"
  print at 10,19, "HUNGRY..."
  print at 2,22, "HI"
  NumU = Hi
  print at 5,22, digits$(NumU, 5)
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 476
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Lf1 | Rt1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  print at 13,21, " START   CREDITS"
  if Menu = 0 then
    print at 13,21, ">"
  else
    print at 21,21, ">"
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 6,2, "THE MARTIAN MONSTERS"
  print at 2,4, "BASED ON THE MARTIAN"
  print at 2,5, "MONSTERS BY J. C. HILTY,"
  print at 2,6, "AHOY! JANUARY 1986"
  print at 2,7, "(COMMODORE 64)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "UP, DOWN: MOVE THE ROCKET"
  print at 2,16, "LEFT, RIGHT: SLOWER, FASTER"
  print at 2,17, "BUTTON: LASER"
  print at 2,19, "MUSIC: HUNGRY MARTIANS,"
  print at 2,20, "SAUCER SNACK"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' tables

' the monsters: start x, home height, direction, speed, colour
data StartX bytes
  20, 70, 120, 170, 220
end data
data BaseY bytes
  22, 34, 26, 38, 30
end data
data MonDir bytes
  0, 1, 0, 1, 0
end data
data MonSpd bytes
  16, 32, 32, 16, 40
end data
data MonCol bytes
  3, 13, 11, 9, 5
end data
' the bob: 0-8 over 32 steps (subtracting 4 is folded into BaseY - 4)
