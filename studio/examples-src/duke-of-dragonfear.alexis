const CardDuke = 0
const CardDragon = 1
const CardSleep = 2
const CardGold = 3
const CardMagic = 4
const CardSand = 5
const CardFlown = 6
const CardSlain = 7

' the caves, as the book: Cv[row * 10 + column] for rows 1-8 and columns
' 2-9 (the rest is the outer wall); 0 empty, 1 wall, 2 magic, 3 dragon,
' 4 quicksand, 5 gold. Seen = 1 for caves shown on your map.
u8 Cv[100]
u8 Seen[100]
u8 Nm[8]
u8 Nl = 0
u8 E = 55
u8 H = 0
u8 Ar = 6
u16 Gold = 0
u16 Best = 0
u16 NumU = 0
u16 NumW = 0
u8 Ends = 0
u8 Cd = 255
u8 Px = 0
u8 Py = 0
u16 Off16 = 0
u8 Dir = 0
u8 Nx = 0
u8 Yt = 0
u8 Ok = 0
u8 Cell = 0
u8 Kind = 0
u8 Menu = 0
u8 Mode = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u16 Rs = $4D2B
u16 Rt = 0
u8 Rb = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table DfSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Nl = 3
  Nm[0] = 84
  Nm[1] = 73
  Nm[2] = 77

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if
  NamePage
  NewWorld
  GameScreen
  ' a first look at the caves
  Glimpse

turn:
  ' now and then, a glimpse of the whole system
  Rnd
  V = Rb & 7
  if V = 0 then
    if E <> 55 then Glimpse
  end if
  Message
  print at 2,21, "DUKE "
  ShowName
  X = Nl + 7
  print at X,21, ", YOU ARE IN"
  print at 2,22, "CAVE"
  NumU = E
  print at 7,22, digits$(NumU, 2)
  ShowPanel
  if Cd <> CardDuke then
    Cd = CardDuke
    ShowCard
  end if
  Amulet
  Mode = 1
wait_turn:
  Frame1
  ReadPad
  if Press2 = 1 then
    Ends = 1
    goto game_over
  end if
  if Press = 1 then
    Mode = 0
    Fight
    goto spent
  end if
  if Stick = 0 then goto wait_turn
  Dir = 0
  if Up1 = 1 then Dir = 246
  if Dn1 = 1 then Dir = 10
  if Lf1 = 1 then Dir = 255
  if Rt1 = 1 then Dir = 1
  if Dir = 0 then goto wait_turn
  Nx = E + Dir
  if Cv[Nx] = 1 then
    ' a wall: it shows on the map now; no charisma lost
    Seen[Nx] = 1
    Cell = Nx
    DrawCave
    Message
    print at 2,21, "YOU CANNOT MOVE THAT WAY!"
    play sound SndBump
    goto wait_turn
  end if
  Mode = 0
  ' the cave you leave is emptied (gold taken, a dragon gone)
  Cv[E] = 0
  Cell = E
  DrawCave
  Walk
  E = Nx
  Seen[E] = 1
  Cell = E
  DrawCave
  ' (what is in the cave is kept in Kind: the events use V)
  Kind = Cv[E]
  if Kind = 2 then Magic
  if Kind = 3 then
    Dragon
    if Ends > 0 then goto game_over
  end if
  if Kind = 4 then
    Quicksand
    goto game_over
  end if
  if Kind = 5 then Treasure
spent:
  inc H
  if H >= 25 then
    Ends = 2
    goto game_over
  end if
  goto turn

game_over:
  ' Ends: 1 you quit, 2 charisma gone, 3 a dragon, 4 quicksand
  Mode = 2
  HideSprites
  Message
  if Ends = 1 then
    print at 2,21, "YOU HAVE"
    V = 25 - H
    NumU = V
    print at 11,21, digits$(NumU, 2)
    print at 14,21, "UNITS OF CHARISMA"
    print at 2,22, "LEFT"
  end if
  if Ends = 2 then
    print at 2,21, "ALL YOUR CHARISMA IS"
    print at 2,22, "....EXHAUSTED..."
  end if
  if Ends = 3 then
    print at 2,21, "GOODBYE DUKE "
    ShowNameAt
  end if
  if Ends = 4 then print at 2,21, "SWALLOWED BY THE QUICKSAND"
  Pause
  Pause
  ' the whole system, and the gold
  for Cell = 12 to 89
    Seen[Cell] = 1
  next
  Glimpse
  Message
  print at 2,21, "YOU AMASSED $"
  NumU = Gold
  print at 15,21, digits$(NumU, 4)
  if Gold > Best then
    Best = Gold
    print at 2,22, "THE BEST HAUL SO FAR!"
  else
    print at 2,22, "BEST: $"
    NumU = Best
    print at 9,22, digits$(NumU, 4)
  end if
  play sound SndEnd
  Rearm
  wait 60 frames
  pause until press
  wait no fire
  nmi off
  Mode = 0
  goto title

' ---------------------------------------------------------------------------
' The caves

' the eight caves around, in the amulet's order
data Around bytes 245, 246, 247, 255, 1, 9, 10, 11

sub NewWorld:
  for I = 0 to 99
    Cv[I] = 0
    Seen[I] = 0
    V = I / 10
    K = V * 10
    K = I - K
    W = 0
    if I < 12 then W = 1
    if I > 90 then W = 1
    if K = 0 then W = 1
    if K = 1 then W = 1
    if W = 1 then Cv[I] = 1
  next
  ' five rounds of a wall, a magic cave, a dragon, quicksand and gold
  for I = 1 to 5
    for J = 1 to 5
nw_again:
      Rnd
      NumW = Rb
      NumW = NumW * 76
      NumW = NumW >> 8
      V = NumW
      V = V + 12
      if Cv[V] = 1 then goto nw_again
      Cv[V] = J
    next
  next
  E = 55
  Cv[55] = 0
  Seen[55] = 1
  H = 0
  Gold = 0
  Ar = 6
  Ends = 0
  return
end sub

' Amulet: what lies in the first of the eight caves around that is not
' empty (the book's order), without saying which
sub Amulet:
  K = 0
  for I = 0 to 7
    V = Around[I]
    V = E + V
    if K = 0 then K = Cv[V]
  next
  print at 21,13, "         "
  print at 21,14, "         "
  if K = 0 then return
  print at 21,13, "AMULET:"
  if K = 1 then print at 21,14, "A WALL"
  if K = 2 then print at 21,14, "MAGIC"
  if K = 3 then print at 21,14, "A DRAGON"
  if K = 4 then print at 21,14, "QUICKSAND"
  if K = 5 then print at 21,14, "GOLD"
  play sound SndAmulet
  return
end sub

sub Magic:
  Message
  print at 2,21, "A MAGIC CAVE! YOU ARE"
  print at 2,22, "WHISKED TO ANOTHER CAVE..."
  Cd = CardMagic
  ShowCard
  play sound SndMagic
  for K = 1 to 24
    V = K & 2
    if V = 0 then
      HideDuke
    else
      DrawDuke
    end if
    Frame1
  next
  ' the magic cave is used up
  Cv[E] = 0
  Cell = E
  DrawCave
mg_again:
  Rnd
  NumW = Rb
  NumW = NumW * 76
  NumW = NumW >> 8
  V = NumW
  V = V + 12
  if Cv[V] = 1 then goto mg_again
  E = V
  Seen[E] = 1
  Cell = E
  DrawCave
  DrawDuke
  Pause
  return
end sub

sub Dragon:
  Message
  print at 2,21, "YOU HAVE WANDERED INTO A"
  print at 2,22, "DRAGON'S LAIR..."
  Cd = CardDragon
  ShowCard
  play sound SndRoar
  Pause
  Rnd
  if Rb < 51 then
    Message
    print at 2,21, "IT HAS FLOWN AWAY"
    Cd = CardFlown
    ShowCard
    Pause
    return
  end if
  Message
  print at 2,21, "IT AWAKENS... AND IT HAS"
  print at 2,22, "SEEN YOU"
  Pause
  Rnd
  if Rb < 38 then
    Message
    print at 2,21, "BUT IT HAS RECENTLY EATEN"
    print at 2,22, "AND SO GOES BACK TO SLEEP"
    Cd = CardSleep
    ShowCard
    Pause
    return
  end if
  Message
  print at 2,21, "AND NOW IT ATTACKS..."
  play sound SndRoar
  Pause
  Rnd
  if Rb < 13 then
    print at 2,22, "BUT YOU FIGHT BACK...& WIN"
    Cd = CardSlain
    ShowCard
    play sound SndGold
    Pause
    return
  end if
  Ends = 3
  return
end sub

sub Quicksand:
  Message
  print at 2,21, "HORRORS... QUICKSAND!"
  Cd = CardSand
  ShowCard
  play sound SndSink
  ' the Duke sinks
  Cell = E
  CaveXY
  for K = 0 to 15
    V = Y + K
    set sprite 0 to V, X, SFace, 11
    set sprite 1 to V, X, SBody, 8
    update sprites
    for J = 1 to 6
      Frame1
    next
  next
  HideDuke
  Ends = 4
  return
end sub

sub Treasure:
  Message
  print at 2,21, "TREASURE!!!"
  Cd = CardGold
  ShowCard
  play sound SndGold
  Rnd
  NumW = Rb
  NumW = NumW * 100
  NumW = NumW >> 8
  NumW = NumW + 100
  Gold = Gold + NumW
  print at 2,22, "DRAGON-GOLD, WORTH $"
  NumU = NumW
  print at 22,22, digits$(NumU, 3)
  ShowPanel
  Pause
  return
end sub

' Fight: an arrow at the dragon in the cave you aim at
sub Fight:
  dec Ar
  ShowPanel
  if Ar = 0 then
    Message
    print at 2,21, "YOU HAVE USED UP ALL"
    print at 2,22, "YOUR ARROWS..."
    Ar = 1
    ShowPanel
    Pause
    return
  end if
  Message
  print at 2,21, "WHICH DIRECTION DO YOU WANT"
  print at 2,22, "TO SHOOT IN?"
fg_aim:
  Frame1
  ReadPad
  if Stick = 0 then goto fg_aim
  Dir = 0
  if Up1 = 1 then Dir = 246
  if Dn1 = 1 then Dir = 10
  if Lf1 = 1 then Dir = 255
  if Rt1 = 1 then Dir = 1
  if Dir = 0 then goto fg_aim
  Shoot
  Yt = E + Dir
  Message
  if Cv[Yt] <> 3 then
    print at 2,21, "THERE WAS NO DRAGON THERE"
    print at 2,22, "YOU HAVE WASTED AN ARROW"
    Pause
    return
  end if
  print at 2,21, "WELL DONE: YOU HAVE HIT A"
  print at 2,22, "FEROCIOUS DRAGON"
  Cd = CardDragon
  ShowCard
  play sound SndRoar
  Seen[Yt] = 1
  Cell = Yt
  DrawCave
  Pause
  Message
  Rnd
  if Rb >= 77 then
    print at 2,21, "BUT YOU ONLY WOUNDED IT..."
    Pause
    return
  end if
  Cv[Yt] = 0
  Cell = Yt
  DrawCave
  Rnd
  NumW = Rb
  NumW = NumW * 100
  NumW = NumW >> 8
  NumW = NumW + 100
  Gold = Gold + NumW
  print at 2,21, "YOU KILLED IT! REWARD: $"
  Cd = CardSlain
  ShowCard
  NumU = NumW
  print at 26,21, digits$(NumU, 3)
  play sound SndGold
  ShowPanel
  Pause
  return
end sub

' Rnd: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' CaveXY: X, Y = the sprite position of cave Cell
sub CaveXY:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  X = X - 2
  X = X * 16
  X = X + 24
  V = Y - 1
  Y = V * 16
  Y = Y + 23
  return
end sub

' DrawCave: cave Cell as you know it
sub DrawCave:
  W = 0
  if Seen[Cell] = 1 then
    W = Cv[Cell]
    inc W
  end if
  DrawKind
  return
end sub

' DrawKind: the picture W (0 unexplored, 1 floor, 2 wall, 3 magic,
' 4 dragon, 5 quicksand, 6 gold) for cave Cell
sub DrawKind:
  W = W * 4
  W = W + TFoga
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  X = X - 2
  X = X * 2
  X = X + 3
  V = Y - 1
  Y = V * 2
  Y = Y + 3
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub DrawMap:
  for Cell = 12 to 89
    V = Cell / 10
    K = V * 10
    K = Cell - K
    if K >= 2 then DrawCave
  next
  return
end sub

' Glimpse: the whole cave system for a moment
sub Glimpse:
  play sound SndAmulet
  for Cell = 12 to 89
    V = Cell / 10
    K = V * 10
    K = Cell - K
    if K >= 2 then
      W = Cv[Cell]
      inc W
      DrawKind
    end if
  next
  for K = 1 to 3
    Pause
  next
  DrawMap
  DrawDuke
  return
end sub

sub DrawDuke:
  Cell = E
  CaveXY
  set sprite 0 to Y, X, SFace, 11
  set sprite 1 to Y, X, SBody, 8
  update sprites
  return
end sub

sub HideDuke:
  set sprite 0 to 192, 0, 0, 0
  set sprite 1 to 192, 0, 0, 0
  update sprites
  return
end sub

' Walk: the Duke goes to the next cave
sub Walk:
  Cell = E
  CaveXY
  Sx = X
  Sy = Y
  Cell = Nx
  DrawCave
  for K = 1 to 8
    if Dir = 1 then Sx = Sx + 2
    if Dir = 255 then Sx = Sx - 2
    if Dir = 10 then Sy = Sy + 2
    if Dir = 246 then Sy = Sy - 2
    set sprite 0 to Sy, Sx, SFace, 11
    set sprite 1 to Sy, Sx, SBody, 8
    update sprites
    Frame1
  next
  play sound SndStep
  return
end sub

' Shoot: an arrow flies one cave in direction Dir
sub Shoot:
  Cell = E
  CaveXY
  Sx = X
  Sy = Y
  W = SArrowh
  if Dir = 10 then W = SArrowv
  if Dir = 246 then W = SArrowv
  play sound SndArrow
  for K = 1 to 8
    if Dir = 1 then Sx = Sx + 2
    if Dir = 255 then Sx = Sx - 2
    if Dir = 10 then Sy = Sy + 2
    if Dir = 246 then Sy = Sy - 2
    set sprite 2 to Sy, Sx, W, 15
    update sprites
    Frame1
  next
  set sprite 2 to 192, 0, 0, 0
  update sprites
  return
end sub

sub ShowName:
  for I = 1 to Nl
    J = I - 1
    V = Nm[J]
    X = J + 7
    put char V at X,21
  next
  return
end sub

sub ShowNameAt:
  for I = 1 to Nl
    J = I - 1
    V = Nm[J]
    X = J + 15
    put char V at X,21
  next
  return
end sub

sub ShowPanel:
  print at 21,2, "CHARISMA"
  V = 25 - H
  NumU = V
  print at 21,3, digits$(NumU, 2)
  print at 21,4, "GOLD $"
  NumU = Gold
  print at 21,5, digits$(NumU, 4)
  print at 21,16, "ARROWS"
  V = Ar - 1
  NumU = V
  print at 28,16, digits$(NumU, 1)
  return
end sub

' ShowCard: picture card Cd into tile codes 200-247 (screen thirds 1, 2)
sub ShowCard:
  Off16 = Cd
  Off16 = Off16 * 384
  copy CardPat + Off16 count 384 to vram.pattern + 1600
  copy CardCol + Off16 count 384 to vram.color + 1600
  copy CardPat + Off16 count 384 to vram.pattern + 3648
  copy CardCol + Off16 count 384 to vram.color + 3648
  return
end sub

' PlaceCard: the card's 8 x 6 tiles with their top left at Px, Py
sub PlaceCard:
  W = 200
  for I = 0 to 5
    Y = Py + I
    for J = 0 to 7
      X = Px + J
      put char W at X,Y
      inc W
    next
  next
  return
end sub

sub DrawFrame:
  for I = 2 to 19
    put char TRock at 2,I
    put char TRock at 19,I
  next
  fill TRock count 18 at 2,2
  fill TRock count 18 at 2,19
  return
end sub

sub Message:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub GameScreen:
  NewScreen
  DrawFrame
  DrawMap
  Px = 21
  Py = 6
  PlaceCard
  Cd = CardDuke
  ShowCard
  ShowPanel
  ShowScreen
  DrawDuke
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 18
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 10
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  sprites stable 0 to 2
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  set sprite 2 to 192,0,0,0
  update sprites
  return
end sub

data Dollar bytes
  $10,$7C,$90,$7C,$12,$7C,$10,$00
end data

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  ' the font has no dollar sign: one is drawn over '$'
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

' NamePage: your name, letter by letter with the stick
sub NamePage:
  NewScreen
  print at 5,4, "WELCOME TO THE WORLD"
  print at 9,5, "OF DRAGONFEAR"
  print at 5,8, "WHAT IS YOUR NAME?"
  print at 3,15, "UP, DOWN: CHANGE A LETTER"
  print at 3,16, "LEFT, RIGHT: MOVE"
  print at 3,17, "BUTTON: DONE"
  ShowScreen
  K = Nl - 1
  WasBtn = 1
np_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    V = Nm[K]
    if Up1 = 1 then
      inc V
      if V = 33 then V = 65
      if V > 90 then V = 32
    end if
    if Dn1 = 1 then
      dec V
      if V = 64 then V = 32
      if V = 31 then V = 90
    end if
    Nm[K] = V
    if Rt1 = 1 then
      if K < 7 then
        inc K
        if K >= Nl then
          Nl = K + 1
          Nm[K] = 65
        end if
      end if
    end if
    if Lf1 = 1 then
      if K > 0 then dec K
    end if
    play sound SndStep
  end if
  ' the name, and the letter being changed
  print at 10,11, "DUKE         "
  for I = 1 to Nl
    J = I - 1
    V = Nm[J]
    X = J + 15
    put char V at X,11
  next
  print at 15,12, "        "
  V = Tick & 16
  if V = 0 then
    X = K + 15
    print at X,12, "^"
  end if
  if Press = 0 then goto np_loop
  ' trailing spaces off
np_trim:
  if Nl > 1 then
    V = Nl - 1
    if Nm[V] = 32 then
      dec Nl
      goto np_trim
    end if
  end if
  NewScreen
  print at 5,9, "ALL HAIL, DUKE"
  for I = 1 to Nl
    J = I - 1
    V = Nm[J]
    X = J + 20
    put char V at X,9
  next
  print at 3,12, "YOU START THIS EXPLORATION"
  print at 3,13, "WITH 25 UNITS OF CHARISMA,"
  print at 3,14, "AND YOU MUST COMPLETE YOUR"
  print at 3,15, "TASK BEFORE IT IS WORN OUT."
  print at 3,16, "YOU LOSE ONE UNIT FOR EVERY"
  print at 3,17, "MOVE YOU MAKE."
  print at 7,21, "PRESS A BUTTON TO BEGIN"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  print at 9,2, "THE DUKE OF"
  print at 9,3, "DRAGONFEAR"
  ' the dragon
  Px = 12
  Py = 5
  PlaceCard
  Cd = CardDragon
  ShowCard
  print at 9,12, "PLAY"
  print at 9,13, "HOW TO PLAY"
  print at 9,14, "CREDITS"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndStep
  end if
  print at 7,12, " "
  print at 7,13, " "
  print at 7,14, " "
  Y = Menu + 12
  print at 7,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "EXPLORE THE CAVES OF DRAGON-"
  print at 2,4, "WORLD FOR TREASURE, AND SLAY"
  print at 2,5, "ITS DRAGONS. EVERY MOVE COSTS"
  print at 2,6, "ONE OF 25 UNITS OF CHARISMA."
  print at 2,8, "BEWARE QUICKSAND AND DRAGONS'"
  print at 2,9, "LAIRS. MAGIC CAVES WHISK YOU"
  print at 2,10, "AWAY. YOUR AMULET SENSES ONE"
  print at 2,11, "OF THE EIGHT CAVES AROUND."
  print at 2,13, "STICK: MOVE N, S, E OR W."
  print at 2,14, "BUTTON: SHOOT AN ARROW AT A"
  print at 2,15, "DRAGON NEXT TO YOU (THEN AIM"
  print at 2,16, "WITH THE STICK)."
  print at 2,17, "SECOND BUTTON: QUIT."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  NewScreen
  print at 9,1, "THE DUKE OF"
  print at 9,2, "DRAGONFEAR"
  print at 2,4, "FROM TIM HARTNELL'S GIANT"
  print at 2,5, "BOOK OF COMPUTER GAMES"
  print at 2,6, "(BALLANTINE BOOKS, 1984;"
  print at 2,7, "INTERFACE PUBLICATIONS,"
  print at 2,8, "1983). A DEVELOPMENT OF"
  print at 2,9, "GREGORY YOB'S HUNT THE"
  print at 2,10, "WUMPUS (1975)."
  print at 2,12, "NEW MUSIC: DRAGONWORLD."
  print at 2,14, "COLECOVISION VERSION BY"
  print at 2,15, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $80,$02,$00,$00,$20,$00,$00,$00
  $00,$00,$08,$00,$00,$80,$02,$00
  $08,$00,$00,$80,$02,$00,$00,$20
  $00,$20,$00,$00,$00,$08,$00,$00
  $80,$08,$00,$02,$40,$00,$10,$01
  $40,$04,$00,$01,$20,$00,$08,$00
  $00,$80,$08,$00,$02,$40,$00,$10
  $00,$40,$04,$00,$01,$20,$00,$08
  $00,$81,$81,$81,$81,$00,$08,$08
  $00,$02,$02,$02,$02,$00,$10,$10
  $08,$08,$00,$40,$40,$40,$40,$00
  $10,$10,$00,$81,$81,$81,$81,$00
  $00,$01,$01,$11,$09,$05,$03,$80
  $00,$80,$80,$88,$90,$A0,$C0,$01
  $80,$03,$05,$09,$11,$01,$01,$00
  $01,$C0,$A0,$90,$88,$80,$80,$00
