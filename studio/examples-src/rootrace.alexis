cartridge "ROOT RACE/COMPUTE!'S GAZETTE/1987"

' ROOT RACE
' A ColecoVision game based on "Root Race", COMPUTE!'s Gazette December
' 1987 (Commodore 64, BASIC with a small machine-language helper; the
' listing names no author).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/rootrace.bas; the machine language, orig/rootrace-ml.dis,
' only copies the character set and slides the sound's pitch in a raster
' interrupt), the game is built for the ColecoVision: trees and roots drawn
' in tiles, a cursor sprite, sound effects and an original title tune.
'
' The game: a row of trees, alternately player 1's (yellow) and player 2's
' (green), grows roots down through a triangle of ground towards the water
' at its point. Players take turns; a turn grows one root one step from a
' root tip of the current row into the row below, down-left or down-right,
' into a free place (lines 620-770). A row is finished before the next one
' starts. A player with no possible move passes (line 790). When the last
' row (two places, just above the water) is full, the two roots that
' reached the water compare their whole systems: the bigger system wins for
' its owner; equal systems tie (lines 420-520, "SYSTEM IS N YARDS LARGER").
'
' From the original: 3 or more trees per player, the ground colour, the
' two-step move (a button on a root tip, then left or right: "WHICH WAY???"),
' "IMPOSSIBLE MOVE", "NO MOVES ARE POSSIBLE", two players or one against
' the computer (or the computer against itself, the listing's demo), the
' ending fanfare.
'
' Liberties: 3 to 7 trees a player (the listing allows 9: 36 columns do not
' fit the 28 safe ones). Fixed root colours (yellow, green) instead of
' typed numbers; ground colour from four (CLAY, PEAT, SLATE, PLUM) chosen
' on the title. The listing compares the bottom roots wrongly when both
' belong to the same player (it could name the other player, or call two
' cells of one tree a tie); here the owner of both wins. A new computer
' player (the listing's lines 850-1080 are tangled): it scores each legal
' growth by the size of the tree it extends, a bonus for taking a place
' the opponent could also reach, and a pull towards the middle of the
' triangle, plus a little randomness. Who moves first is a title option
' (the listing: always player 1): with an odd number of trees each the
' second player makes the last move, with an even number the first,
' which matters. Each tree's root count is shown above it. Either
' controller drives the human to move (the listing gives player 2 the
' second joystick when there are two). No names typed, no play-again
' question: the end message, then the title.
'
' Controls: either controller. Stick left/right moves the ring from one of
' your root tips to the next (in the current row); a side button picks it;
' then push left or right to grow down-left or down-right (up or a button
' cancels). On the title, up and down choose a line, left/right/button
' change it, a button on START GAME or CREDITS goes there.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TSoil = 128
const TRock = 129
const TDr1a = 130
const TDr1b = 131
const TDl1a = 132
const TDl1b = 133
const TDr2a = 134
const TDr2b = 135
const TDl2a = 136
const TDl2b = 137
const TCl1 = 138
const TCr1 = 139
const TCl2 = 140
const TCr2 = 141
const TGrass = 142
const TWater = 143
const TSky = 144
const TTree100 = 145
const TTree101 = 146
const TTree110 = 147
const TTree111 = 148
const TTree200 = 149
const TTree201 = 150
const TTree210 = 151
const TTree211 = 152
const TN0 = 153
const TN1 = 154
const TN2 = 155
const TN3 = 156
const TN4 = 157
const TN5 = 158
const TN6 = 159
const TN7 = 160
const TN8 = 161
const TN9 = 162
const TSun00 = 163
const TSun01 = 164
const TSun10 = 165
const TSun11 = 166
const SRing = 0
const SWays = 4
const NTiles8 = 312
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndTick = 3
const SndPick = 4
const SndGrow = 5
const SndGrow2 = 6
const SndBuzz = 7
const SndPass = 8
const SndThink = 9
const SndStart = 10
const SndWin = 11
const SndTie = 12
const NSpr = 2
const BW = 14
const Yb = 5
const TuneLen = 675
const NoCell = 255

record Side:
  u8 Kind
  u8 Roots
  u8 Passes
end record

Side Plr[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 RsAt = 0
u16 W16 = 0
u16 NumU = 0
u16 Best = 0
bcd digits 4 MoveB
' the board: tree number + 1 (0 free), BW cells to a row; root counts
u8 Brd[196]
u8 Sz[14]
' the game: trees each, cells in row 0, left column, row being played
' from, cells grown into the next row, player to move (0 / 1)
u8 Tn = 5
u8 Qn = 10
u8 X0 = 6
u8 Rc = 0
u8 Mcnt = 0
u8 Pl = 0
u8 Over = 0
u8 Win = 0
u8 S1 = 0
u8 S2 = 0
u16 MoveN = 0
' the move: cell of row Rc, direction (0 down-right, 1 down-left)
u8 Mx = 0
u8 Md = 0
u8 Cx = 0
u8 Found = 0
u8 Phase = 0
' menu
u8 Opt1 = 0
u8 Opt2 = 1
u8 OptT = 5
u8 OptG = 0
u8 OptF = 0
u8 Mrow = 0
u8 Menu = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 NewStick = 0
u8 Rep = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ra = 0
u8 Rb = 0
u8 Ri = 0
u8 Bl = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table RrSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if

  NewGame

turn_loop:
  V = Qn - 2
  if Rc = V then goto game_end
  ShowTurn
  K = CountMoves(Pl)
  if K = 0 then
    DoPass
  else
    if Plr[Pl].Kind = 1 then
      CpuTurn
    else
      HumanTurn
    end if
    GrowRoot
  end if
  Pl = Pl xor 1
  goto turn_loop

game_end:
  Over = 1
  HideSprites
  Judge
  ClearHud
  select case Win
  case 2
    print at 9,20, "A TIE GAME."
    play sound SndTie
  case else
    PutName(Win, 4, 20)
    print at 15,20, "WINS!"
    play sound SndWin
  end select
  ShowWater
  print at 7,22, "PRESS A BUTTON"
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' the cell number of (x, r)
function Ix(u8 Ax, u8 Ar) as u8
  u8 Q = 0
  Q = Ar * BW
  Q = Q + Ax
  return Q

' the owner (0 / 1) of cell x of row Rc, or 255 when it is free
function OwnerAt(u8 Ax, u8 Ar) as u8
  u8 Q = 0
  Q = Ix(Ax, Ar)
  Q = Brd[Q]
  if Q = 0 then return NoCell
  Q = Q - 1
  Q = Q & 1
  return Q

' the free child of cell x of row Rc in direction d, or NoCell
function Child(u8 Ax, u8 Ad) as u8
  u8 Q = 0
  u8 Last = 0
  u8 Kx = 0
  Last = Qn - Rc
  Last = Last - 2
  if Ad = 0 then
    Kx = Ax
  else
    if Ax = 0 then return NoCell
    Kx = Ax - 1
  end if
  if Kx > Last then return NoCell
  Q = Rc + 1
  Q = Ix(Kx, Q)
  if Brd[Q] <> 0 then return NoCell
  return Kx

' 1 when cell x of row Rc is player p's and can still grow
function IsTip(u8 Ax, u8 Ap) as u8
  u8 Q = 0
  Q = OwnerAt(Ax, Rc)
  if Q <> Ap then return 0
  if Child(Ax, 0) <> NoCell then return 1
  if Child(Ax, 1) <> NoCell then return 1
  return 0

' how many growths player p has
function CountMoves(u8 Ap) as u8
  u8 Q = 0
  u8 N = 0
  u8 Lim = 0
  Lim = Qn - Rc
  for Q = 1 to Lim
    Ri = Q - 1
    if OwnerAt(Ri, Rc) = Ap then
      if Child(Ri, 0) <> NoCell then inc N
      if Child(Ri, 1) <> NoCell then inc N
    end if
  next
  return N

' grow from Mx in direction Md for player Pl (lines 620-770)
sub GrowRoot:
  u8 Kx = 0
  u8 Kr = 0
  u8 Tr = 0
  u8 Ci = 0
  Kx = Child(Mx, Md)
  Kr = Rc + 1
  Ci = Ix(Mx, Rc)
  Tr = Brd[Ci]
  Ci = Ix(Kx, Kr)
  Brd[Ci] = Tr
  Tr = Tr - 1
  Sz[Tr] += 1
  Plr[Pl].Roots += 1
  inc MoveN
  MoveB += 1
  ' the drawing: "\" in the child's left half, "/" in its right half
  X = Kx << 1
  X = X + X0
  X = X + Kr
  if Md = 1 then inc X
  Y = Yb + Kr
  T = Pl << 2
  T = T + TDr1a
  if Md = 1 then T = T + 2
  Rand
  V = Rs & 1
  T = T + V
  put char T at X,Y
  ShowSize(Tr)
  if Pl = 0 then
    play sound SndGrow
  else
    play sound SndGrow2
  end if
  inc Mcnt
  V = Qn - 1
  V = V - Rc
  if Mcnt = V then
    inc Rc
    Mcnt = 0
  end if
  ShowHud
  return
end sub

' no move: the listing's "NO MOVES ARE POSSIBLE FOR ..." (line 800)
sub DoPass:
  HideSprites
  Plr[Pl].Passes += 1
  fill 32 count 28 at 2,21
  print at 2,21, "NO MOVES POSSIBLE FOR"
  PutName(Pl, 2, 22)
  play sound SndPass
  for Bl = 1 to 100
    Frame1
  next
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

' the end: the two roots at the water; the bigger system wins
sub Judge:
  u8 A1 = 0
  u8 A2 = 0
  u8 Ci = 0
  V = Qn - 2
  Ci = Ix(0, V)
  A1 = Brd[Ci] - 1
  inc Ci
  A2 = Brd[Ci] - 1
  S1 = Sz[A1]
  S2 = Sz[A2]
  J = A1 & 1
  K = A2 & 1
  if J = K then
    Win = J
  elseif S1 = S2 then
    Win = 2
  elseif S1 > S2 then
    Win = J
  else
    Win = K
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the human: choose a tip, then a way (lines 1090-1410)
sub HumanTurn:
  Found = 0
  Phase = 1
  if IsTip(Cx, Pl) = 0 then NextTip(1)
  fill 32 count 28 at 2,21
  print at 2,21, "STICK: TIP  BUTTON: CHOOSE"
  Rep = 0
  while Found = 0
    Frame1
    ReadPad
    if Phase = 1 then
      if Press = 1 then
        Phase = 2
        play sound SndPick
        fill 32 count 28 at 2,21
        print at 2,21, "WHICH WAY? LEFT OR RIGHT"
      else
        StickRepeat
        V = NewStick & 8
        if V > 0 then NextTip(1)
        V = NewStick & 4
        if V > 0 then NextTip(0)
      end if
    else
      V = Stick & 1
      if Press = 1 then V = 1
      if V > 0 then
        Phase = 1
        fill 32 count 28 at 2,21
        print at 2,21, "STICK: TIP  BUTTON: CHOOSE"
        fill 32 count 28 at 2,22
      else
        T = 2
        V = NewStick & 8
        if V > 0 then T = 0
        V = NewStick & 4
        if V > 0 then T = 1
        if T < 2 then
          if Child(Cx, T) = NoCell then
            print at 7,22, "IMPOSSIBLE MOVE"
            play sound SndBuzz
          else
            Mx = Cx
            Md = T
            Found = 1
          end if
        end if
      end if
    end if
    DrawCursor
  end while
  Phase = 0
  fill 32 count 28 at 2,22
  return
end sub

' held stick: a step now, then every 8 frames after 16
sub StickRepeat:
  V = Stick & 12
  if V = 0 then
    Rep = 0
    return
  end if
  inc Rep
  if Rep = 16 then
    NewStick = V
    Rep = 8
  end if
  return
end sub

' the cursor to the next tip of player Pl to the right (1) or left (0),
' round the row (the listing wraps the same way, lines 1120-1130)
sub NextTip(u8 Dir):
  u8 Lim = 0
  u8 Nn = 0
  Lim = Qn - Rc
  Nn = 0
  while Nn < Lim
    if Dir = 1 then
      inc Cx
      if Cx >= Lim then Cx = 0
    else
      if Cx = 0 then
        Cx = Lim - 1
      else
        dec Cx
      end if
    end if
    if IsTip(Cx, Pl) = 1 then
      Nn = Lim
    else
      inc Nn
    end if
  end while
  play sound SndTick
  return
end sub

' ---------------------------------------------------------------------------
' the computer: think, choose, show the ring, grow
sub CpuTurn:
  Phase = 3
  HideSprites
  play sound SndThink
  for Bl = 1 to 30
    Frame1
  next
  CpuChoose
  Cx = Mx
  for Bl = 1 to 40
    Frame1
    DrawCursor
  next
  Phase = 0
  return
end sub

' every legal growth scored; the first best is kept
sub CpuChoose:
  u8 Lim = 0
  u8 Q = 0
  u8 D = 0
  u16 Sc = 0
  RsAt = Rs
  Best = 0
  Lim = Qn - Rc
  for Q = 1 to Lim
    Ra = Q - 1
    if OwnerAt(Ra, Rc) = Pl then
      for D = 0 to 1
        if Child(Ra, D) <> NoCell then
          Sc = CpuScore(Ra, D)
          if Sc > Best then
            Best = Sc
            Mx = Ra
            Md = D
          end if
        end if
      next
    end if
  next
  return
end sub

function CpuScore(u8 Ax, u8 Ad) as u16
  u16 S = 0
  u8 Kx = 0
  u8 Kr = 0
  u8 Ox = 0
  u8 Mid = 0
  u8 Off = 0
  u8 Tr = 0
  u8 Ci = 0
  Kx = Child(Ax, Ad)
  Kr = Rc + 1
  Ci = Ix(Ax, Rc)
  Tr = Brd[Ci] - 1
  S = Sz[Tr]
  S = S * 2
  S = S + 40
  ' the other parent of the child: the opponent's, a place taken from it
  if Ad = 0 then
    Ox = Ax + 1
  else
    Ox = Ax - 1
  end if
  Ci = Qn - Rc
  if Ox < Ci then
    if OwnerAt(Ox, Rc) <> Pl then S = S + 8
  end if
  Mid = Qn - Kr
  Mid = Mid - 1
  Off = Kx << 1
  Off = absdiff(Off, Mid)
  Off = Off << 1
  S = S - Off
  Rand
  Ci = Rs & 3
  S = S + Ci
  return S

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawCursor:
  if Phase = 0 then
    HideSprites
    return
  end if
  X = Cx << 1
  X = X + X0
  X = X + Rc
  X = X + 1
  X = X << 3
  X = X - 8
  Y = Yb + Rc
  Y = Y + 1
  Y = Y << 3
  Y = Y - 9
  C = 11
  if Pl = 1 then C = 3
  set sprite 0 to Y,X,SRing,C
  if Phase = 2 then
    set sprite 1 to Y,X,SWays,15
  else
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

' the root count of tree t above it (player 1's on row 2, player 2's on 1)
sub ShowSize(u8 Tt):
  u8 Zx = 0
  u8 Zy = 0
  u8 Hi = 0
  u8 Lo = 0
  Zx = Tt << 1
  Zx = Zx + X0
  Zy = Tt & 1
  Zy = 2 - Zy
  Hi = Sz[Tt] / 10
  Lo = Hi * 10
  Lo = Sz[Tt] - Lo
  if Hi = 0 then
    put char TSky at Zx,Zy
  else
    V = TN0 + Hi
    put char V at Zx,Zy
  end if
  inc Zx
  V = TN0 + Lo
  put char V at Zx,Zy
  return
end sub

sub DrawBoard:
  ' sky, ground of rock, the triangle of soil, the trees and the water
  for Ri = 1 to 4
    fill TSky count 32 at 0,Ri
  next
  for Ri = 5 to 18
    fill TRock count 32 at 0,Ri
  next
  fill TGrass count 32 at 0,Yb
  for Ri = 1 to Qn
    DrawRow
  next
  for Ri = 1 to Qn
    J = Ri - 1
    X = J << 1
    X = X + X0
    K = J & 1
    DrawTree(X, K, 3)
    ShowSize(J)
  next
  X = X0 + Qn
  X = X - 2
  Y = Yb + Qn
  Y = Y - 1
  fill TWater count 4 at X,Y
  return
end sub

' row Ri - 1 of the triangle: soil, or the trees' crowns on row 0
sub DrawRow:
  u8 Rr = 0
  u8 Wd = 0
  Rr = Ri - 1
  X = X0 + Rr
  Y = Yb + Rr
  if Rr = 0 then
    for Rb = 1 to Qn
      V = Rb - 1
      V = V & 1
      V = V << 1
      V = V + TCl1
      put char V at X,Y
      inc X
      inc V
      put char V at X,Y
      inc X
    next
  else
    Wd = Qn - Rr
    Wd = Wd << 1
    fill TSoil count Wd at X,Y
  end if
  return
end sub

' a tree of player Zo at column Zx, top row Ty
sub DrawTree(u8 Zx, u8 Zo, u8 Ty):
  u8 Zt = 0
  Zt = Zo << 2
  Zt = Zt + TTree100
  put char Zt at Zx,Ty
  inc Zt
  inc Zx
  put char Zt at Zx,Ty
  inc Zt
  dec Zx
  inc Ty
  put char Zt at Zx,Ty
  inc Zt
  inc Zx
  put char Zt at Zx,Ty
  return
end sub

' player p's name at x, y
sub PutName(u8 Pk, u8 Nx, u8 Ny):
  u8 Q = 0
  Q = Plr[Pk].Kind
  if Q = 1 then
    J = Plr[0].Kind + Plr[1].Kind
    if J = 2 then
      Q = 3 + Pk
    end if
  else
    Q = 5 + Pk
  end if
  select case Q
  case 1
    print at Nx,Ny, "COMPUTER  "
  case 3
    print at Nx,Ny, "COMPUTER 1"
  case 4
    print at Nx,Ny, "COMPUTER 2"
  case 5
    print at Nx,Ny, "PLAYER 1  "
  case else
    print at Nx,Ny, "PLAYER 2  "
  end select
  return
end sub

sub ClearHud:
  for Ri = 19 to 22
    fill 32 count 28 at 2,Ri
  next
  return
end sub

' the roots of each player, the move number
sub ShowHud:
  put char TDr1a at 2,19
  NumU = Plr[0].Roots
  print at 4,19, digits$(NumU, 2)
  print at 12,19, "MOVE"
  print MoveB at 17,19
  NumU = Plr[1].Roots
  print at 24,19, digits$(NumU, 2)
  put char TDr2a at 27,19
  return
end sub

sub ShowTurn:
  fill 32 count 28 at 2,20
  PutName(Pl, 2, 20)
  print at 13,20, "TO GROW"
  return
end sub

' the end: the roots at the water ("SYSTEM IS N YARDS LARGER")
sub ShowWater:
  NumU = S1
  print at 2,21, "AT THE WATER:"
  print at 16,21, digits$(NumU, 2)
  print at 19,21, "AND"
  NumU = S2
  print at 23,21, digits$(NumU, 2)
  return
end sub

sub NewGame:
  fill array Brd with 0
  fill array Sz with 0
  Tn = OptT
  Qn = Tn << 1
  X0 = 16 - Qn
  for Ri = 1 to Qn
    J = Ri - 1
    Brd[J] = Ri
  next
  Plr[0].Kind = Opt1
  Plr[1].Kind = Opt2
  for Ri = 0 to 1
    Plr[Ri].Roots = 0
    Plr[Ri].Passes = 0
  next
  Rc = 0
  Mcnt = 0
  Pl = OptF
  Cx = 0
  Over = 0
  MoveN = 0
  MoveB = 0
  TitleOn = 0
  Phase = 0
  NewScreen
  DrawBoard
  ShowHud
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Stick = V & 15
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = WasStick ^ 255
  NewStick = Stick & V
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub SetGround:
  select case OptG
  case 0
    backdrop dark red
  case 1
    backdrop black
  case 2
    backdrop dark blue
  case else
    backdrop magenta
  end select
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  SetGround
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: sky, sun, four trees and their roots, the tune once, the menu
sub TitlePage:
  TitleOn = 1
  NewScreen
  DrawTitleArt
  print at 11,1, "ROOT RACE"
  print at 2,12, "PLAYER 1"
  print at 2,13, "PLAYER 2"
  print at 2,14, "TREES EACH"
  print at 2,15, "GROUND"
  print at 2,16, "FIRST MOVE"
  print at 2,18, "START GAME"
  print at 2,19, "CREDITS"
  print at 5,22, "STICK AND BUTTON"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 15
  Menu = 0
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if NewStick > 0 then
    K = NewStick & 1
    if K > 0 then
      if Mrow > 0 then dec Mrow
    end if
    K = NewStick & 2
    if K > 0 then
      if Mrow < 6 then inc Mrow
    end if
    K = NewStick & 8
    if K > 0 then Toggle(1)
    K = NewStick & 4
    if K > 0 then Toggle(0)
    ShowMenu
  end if
  if Press = 1 then
    if Mrow < 5 then
      Toggle(1)
      ShowMenu
    elseif Mrow = 6 then
      Menu = 1
      goto tp_go
    else
      Menu = 0
      goto tp_go
    end if
  end if
  goto tp_loop
tp_go:
  StopTune
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub DrawTitleArt:
  for Ri = 3 to 6
    fill TSky count 28 at 2,Ri
  next
  put char TSun00 at 26,3
  put char TSun01 at 27,3
  put char TSun10 at 26,4
  put char TSun11 at 27,4
  for Ri = 0 to 3
    X = Ri << 2
    X = X + 11
    K = Ri & 1
    DrawTree(X, K, 5)
  next
  fill TGrass count 28 at 2,7
  for Ri = 0 to 3
    X = Ri << 2
    X = X + 11
    V = Ri & 1
    V = V << 1
    V = V + TCl1
    put char V at X,7
    inc X
    inc V
    put char V at X,7
  next
  ' a few roots under them
  put char TDr1a at 12,8
  put char TDl1b at 12,9
  put char TDl2a at 14,8
  put char TDl2b at 13,9
  put char TDr1b at 20,8
  put char TDr1a at 21,9
  put char TDl2b at 22,8
  put char TDr2a at 22,9
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

sub Toggle(u8 Up):
  select case Mrow
  case 0
    Opt1 = 1 - Opt1
  case 1
    Opt2 = 1 - Opt2
  case 2
    if Up = 1 then
      inc OptT
      if OptT > 7 then OptT = 3
    else
      dec OptT
      if OptT < 3 then OptT = 7
    end if
  case 3
    if Up = 1 then
      inc OptG
      OptG = OptG & 3
    else
      dec OptG
      OptG = OptG & 3
    end if
    SetGround
  case 4
    OptF = 1 - OptF
  end select
  return
end sub

sub ShowMenu:
  if Opt1 = 0 then
    print at 15,12, "HUMAN   "
  else
    print at 15,12, "COMPUTER"
  end if
  if Opt2 = 0 then
    print at 15,13, "HUMAN   "
  else
    print at 15,13, "COMPUTER"
  end if
  NumU = OptT
  print at 15,14, digits$(NumU, 1)
  select case OptG
  case 0
    print at 15,15, "CLAY "
  case 1
    print at 15,15, "PEAT "
  case 2
    print at 15,15, "SLATE"
  case else
    print at 15,15, "PLUM "
  end select
  if OptF = 0 then
    print at 15,16, "PLAYER 1"
  else
    print at 15,16, "PLAYER 2"
  end if
  J = Mrow + 12
  if Mrow > 4 then J = J + 1
  put char 62 at 13,J
  for Ri = 12 to 19
    if Ri <> J then put char 32 at 13,Ri
  next
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,2, "ROOT RACE"
  print at 2,5, "BASED ON ROOT RACE,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "DECEMBER 1987 (COMMODORE 64;"
  print at 2,8, "NO AUTHOR NAMED)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: TAPROOT WALTZ"
  print at 2,19, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

