cartridge "CIRCUS/PRESENTS COMPUTE!'S TI VERSION/1984"

' CIRCUS
' COMPUTE! magazine, February 1984, Program 5: the TI-99/4A version of
' "Circus" (Extended BASIC). All credit belongs to the authors of Circus
' and of its TI translation.
'
' Historical context (summary of the program's instructions):
' A circus act: an acrobat bounces on a trampoline to pop the rows of
' balloons above the ring. The player slides the trampoline under him;
' where he lands on it decides whether he flies off to the left, straight
' up or to the right. Every border except the bottom bounces him back; if
' he misses the trampoline and reaches the floor, a man is lost. Beware
' the balloons of the top row, which change color: popped while black,
' one blows up in the acrobat's face; popped while yellow, it is worth
' 250 points. An extra man comes every 2000 points. A flock of birds
' crosses the big top as a distraction, and the title plays a circus
' march while the balloon colors cycle.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the joystick moves the trampoline left and right (either
' joystick; the TI used the < and > keys).
' The rules follow the TI listing: the acrobat moves one cell per step,
' diagonally or straight (DX -1, 0, 1 and DY -1, 1); the left, middle and
' right of the trampoline send him left, up or right (lines 350-360,
' V()); the borders bounce him (line 340); a popped balloon sends him
' back down (line 390); the floor costs a man (lines 370, 820-860); the
' top row turns yellow or black at random after every pop (lines 80,
' 160, M1), and popping it black costs a man (line 60); a full rack of
' 84 balloons is redrawn (line 70); a man every 2000 points (line 90);
' three birds fly about at random (lines 210-220, CALL MOTION); the title
' plays the march of lines 500-580.
' Adaptation liberties: balloons are worth 250 (top row, yellow), 100 and
' 75 (the listing's line 50 is only partly legible); the trampoline moves
' every third frame instead of once per step, so it can keep up; the
' acrobat glides between cells; each new rack is a little faster; the
' playfield is 26 balloons wide (columns 3-28, inside the overscan), so a
' rack is 78 balloons; the birds flap; joystick menus replace the Y/N
' questions; an editorial page. The frame loop is protected from the NMI.
' Screen: score and lives on row 1; top border row 2; balloons rows 3-5;
' side borders columns 2 and 29; trampoline on row 21; floor on row 22.

const TopBorder = 128
const SideBorder = 129
const FloorTile = 130
const TopBalloon = 131         ' 128: the balloon that changes color
const RedBalloon = 132         ' 104, row 3
const BlueBalloon = 133        ' 112, row 4
const GreenBalloon = 134       ' 120, row 5
const TrampL = 135             ' 97-99: the trampoline
const TrampM = 136
const TrampR = 137
const Platform = 138           ' line 200: the two ledges
const Blank = 32
const TrampRow = 21

' Sound table slots (ci/s.mjs)
const SndTheme = 1
const SndBoing = 2
const SndPop = 3
const SndLoseA = 4
const SndLoseB = 5
const SndExtra = 6
const SndOver = 7
const SndBeep = 8

bcd digits 5 Score             ' SC
bcd digits 5 HighScore
bcd digits 5 NextLife          ' the next 2000 points
u8 Lives = 3                   ' LIFE
u8 Bal = 0                     ' BAL, balloons popped this rack
u8 Row = 6                     ' the acrobat
u8 Col = 15
u8 ORow = 6
u8 OCol = 15
u8 DXs = 1                     ' DX + 1
u8 DYs = 2                     ' DY + 1
u8 TX = 14                     ' trampoline left column
u8 M1 = 1                      ' 1 yellow, 0 black
u8 StepN = 7                   ' frames per step
u8 Frm = 0
u8 TFrm = 0
u8 Rack = 0
bool LostMan = false
u8 BX[3]                       ' birds
u8 BY[3]
u8 BVX[3]                      ' velocities + 2 (pixels per 2 frames)
u8 BVY[3]
u8 I = 0
u8 K = 0
u8 ColorBand = 0
u8 N = 0
u8 H = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Off = 0
u8 Col1 = 7                      ' F1, F2, F3 (TI colors) on the title
u8 Col2 = 13
u8 Col3 = 5
u16 Ad16 = 0
u8 Choice = 0
u16 Dst16 = 0
u16 NumU = 0

  tile screen
  set sound table CircusSoundTable areas 3
  sprites 16x16
  copy SpritePat count 96 to vram.spr_pat
  HideSprites
  LoadTiles
  screen on
  nmi on
  EditorialPage

title:
  ' --- Lines 530-600: the title, with the march ---
  TitlePage
  Score = 0
  NextLife = 2000
  Lives = 3
  Rack = 0
  StepN = 7

new_rack:
  ' --- Lines 150-260: the ring ---
  DrawRing
  Bal = 0
  M1 = random(0, 1)
  SetTopColor
  ShowStatus
  StartMan
  InitBirds
  nmi on
  print at 10,12, "PRESS FIRE"
  wait no fire
  pause until press
  wait no fire
  fill 32 count 10 at 10,12

  ' --- Lines 290-420: the main loop ---
main_loop:
  nmi on
  wait
  nmi off
  MoveTrampoline
  MoveBirds
  inc Frm
  if Frm >= StepN then
    Frm = 0
    StepMan
    if LostMan then goto lose_man
    if Bal >= 81 then goto rack_done
  end if
  DrawMan
  goto main_loop

  ' --- Lines 820-860: a man is lost ---
lose_man:
  nmi on
  play sounds SndLoseA, SndLoseB
  for K = 0 to 47
    N = K & 4
    V = 1
    if N = 0 then V = 9
    X = Col * 8
    Y = Row * 8
    dec Y
    set sprite 0 to Y,X,0,V
    update sprites
    wait
  next
  dec Lives
  ShowStatus
  if Lives = 0 then goto game_over
  StartMan
  wait 30 frames
  goto main_loop

  ' --- Line 70: a full rack, the balloons come back ---
rack_done:
  nmi on
  play sound SndExtra
  print at 10,12, "WELL DONE!"
  wait 90 frames
  inc Rack
  if StepN > 4 then dec StepN
  goto new_rack

  ' --- Lines 870-880: game over ---
game_over:
  nmi on
  play sound SndOver
  if Score > HighScore then HighScore = Score
  print at 10,9, "G A M E"
  print at 10,11, "O V E R"
  print at 9,14, "PLAY AGAIN"
  print at 9,15, "TITLE PAGE"
  Choice = 1
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,14 step 1
  wait no fire
  if Choice = 1 then
    Score = 0
    NextLife = 2000
    Lives = 3
    Rack = 0
    StepN = 7
    goto new_rack
  end if
  goto title

' ---------------------------------------------------------------------------

' Lines 330-410: one step of the acrobat
sub StepMan:
  LostMan = false
  ORow = Row
  OCol = Col
  X = Col + DXs
  dec X
  Y = Row + DYs
  dec Y
  H = get char at X,Y
  ' Line 340: the borders bounce him
  if H = SideBorder then
    DXs = 2 - DXs
    return
  end if
  if H = TopBorder then
    DYs = 2
    return
  end if
  if H = Platform then
    DYs = 2 - DYs
    return
  end if
  ' Lines 350-360: the trampoline; its part sets the direction
  if H = TrampL then
    DXs = 0
    DYs = 0
    play sound SndBoing
    return
  end if
  if H = TrampM then
    DXs = 1
    DYs = 0
    play sound SndBoing
    return
  end if
  if H = TrampR then
    DXs = 2
    DYs = 0
    play sound SndBoing
    return
  end if
  ' Line 370: the floor
  if H = FloorTile then
    LostMan = true
    return
  end if
  ' Lines 380-390: a balloon pops and he falls back
  if H >= TopBalloon then
    if H <= GreenBalloon then
      PopBalloon
      DYs = 2
      return
    end if
  end if
  Row = Y
  Col = X
  return
end sub

' Lines 50-110: a balloon pops
sub PopBalloon:
  put char Blank at X,Y
  inc Bal
  play sound SndPop
  if H = TopBalloon then
    ' Line 60: black, it blows up in his face
    if M1 = 0 then
      LostMan = true
      return
    end if
    Score += 250
  end if
  if H = RedBalloon then Score += 100
  if H = BlueBalloon then Score += 75
  if H = GreenBalloon then Score += 50
  ' Line 90: a man every 2000 points
  if Score >= NextLife then
    NextLife += 2000
    if Lives < 9 then inc Lives
    play sound SndExtra
  end if
  ShowStatus
  ' Line 80: the top row turns yellow or black
  M1 = random(0, 1)
  SetTopColor
  return
end sub

' Line 300: < and > move the trampoline (here every third frame)
sub MoveTrampoline:
  inc TFrm
  if TFrm < 3 then return
  TFrm = 0
  N = 0
  if joypad(1).left then N = 1
  if joypad(2).left then N = 1
  if joypad(1).right then N = 2
  if joypad(2).right then N = 2
  if N = 0 then return
  if N = 1 then
    if TX <= 2 then return
    dec TX
    put char Blank at TX + 3,TrampRow
  else
    if TX >= 27 then return
    put char Blank at TX,TrampRow
    inc TX
  end if
  DrawTrampoline
  return
end sub

sub DrawTrampoline:
  put char TrampL at TX,TrampRow
  X = TX + 1
  put char TrampM at X,TrampRow
  inc X
  put char TrampR at X,TrampRow
  return
end sub

' Line 830: the acrobat starts again under the balloons, falling
sub StartMan:
  Row = 7
  Col = random(8, 23)
  ORow = Row
  OCol = Col
  DXs = 1
  DYs = 2
  Frm = 0
  LostMan = false
  return
end sub

' The acrobat (sprite 0, 16 x 16 with the figure in the top-left 8 x 8),
' gliding between cells
sub DrawMan:
  Off = Frm * 8
  Off /= StepN
  X = OCol * 8
  if Col > OCol then X += Off
  if Col < OCol then X -= Off
  Y = ORow * 8
  if Row > ORow then Y += Off
  if Row < ORow then Y -= Off
  dec Y
  set sprite 0 to Y,X,0,1
  update sprites
  return
end sub

' Lines 210-220: three birds in random motion
sub InitBirds:
  for I = 0 to 2
    BX[I] = random(16, 220)
    BY[I] = random(56, 140)
    BVX[I] = random(0, 4)
    BVY[I] = random(1, 3)
  next
  return
end sub

sub MoveBirds:
  N = frame
  N &= 1
  if N = 0 then return
  for I = 0 to 2
    X = BX[I] + BVX[I]
    X -= 2
    Y = BY[I] + BVY[I]
    Y -= 2
    if Y < 56 then Y = 140
    if Y > 140 then Y = 56
    BX[I] = X
    BY[I] = Y
    ' Line 220: now and then a new random motion
    N = random(0, 99)
    if N = 0 then
      BVX[I] = random(0, 4)
      BVY[I] = random(1, 3)
    end if
    K = I + 1
    N = frame
    N &= 16
    V = 4
    if N <> 0 then V = 8
    set sprite K to Y,X,V,1
  next
  return
end sub

' Lines 160-200: borders, balloons, floor and trampoline
sub DrawRing:
  nmi on
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  cls
  backdrop cyan
  ' TI columns 2-31 become 1-30 (borders on 1 and 30, balloons on 2-29)
  fill TopBorder count 30 at 1,2
  for Y = 3 to 21
    put char SideBorder at 1,Y
    put char SideBorder at 30,Y
  next
  ' Line 180: three rows, the third with a gap in the middle
  fill RedBalloon count 28 at 2,3
  fill BlueBalloon count 28 at 2,4
  fill GreenBalloon count 13 at 2,5
  fill GreenBalloon count 12 at 18,5
  ' Line 230: one balloon of the top row changes color
  X = random(2, 28)
  put char TopBalloon at X,3
  ' Line 200: two ledges that bounce the man
  fill Platform count 7 at 2,17
  fill Platform count 7 at 23,17
  fill FloorTile count 30 at 1,22
  TX = 14
  DrawTrampoline
  return
end sub

' CALL COLOR(10,F1,11,F2,12,F3): the three balloon tiles, TI colors - 1
sub SetSetColors:
  Ad16 = 1056
  for ColorBand = 0 to 2
    V = Col1 - 1
    V <<= 4
    fill V count 5 to vram.color + Ad16
    Ad16 += 8
    V = Col2 - 1
    V <<= 4
    fill V count 5 to vram.color + Ad16
    Ad16 += 8
    V = Col3 - 1
    V <<= 4
    fill V count 5 to vram.color + Ad16
    Ad16 += 2032
  next
  return
end sub

' The changing balloon's color: yellow or black (CALL COLOR set 13)
sub SetTopColor:
  if M1 = 1 then
    copy YellowCol count 8 to vram.color + 1048
  else
    copy BlackCol count 8 to vram.color + 1048
  end if
  return
end sub

sub ShowStatus:
  print at 2,1, "SCORE:"
  print Score at 9,1
  print at 18,1, "LIVES:"
  NumU = Lives
  print at 25,1, digits$(NumU, 1)
  return
end sub

' Graphics II: tiles 128-136 with their row colors, in all three thirds
sub LoadTiles:
  Dst16 = 1024
  for K = 0 to 2
    copy TilePat count 88 to vram.pattern + Dst16
    copy TileCol count 88 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for K = 0 to 3
    set sprite K to 192,0,0,0
  next
  update sprites
  return
end sub

' Lines 530-600: the title, a frame of balloons around CIRCUS whose three
' colors rotate with each note of the march, then the instructions on
' request (lines 610-800)
sub TitlePage:
  nmi on
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  cls
  backdrop gray
  ' Lines 550-560: "hpxhpxhpxh" around "h CIRCUS p"
  for X = 0 to 9
    N = X % 3
    V = RedBalloon + N
    Y = X + 9
    put char V at Y,8
    put char V at Y,12
  next
  put char BlueBalloon at 9,9
  put char GreenBalloon at 18,9
  put char RedBalloon at 9,10
  print at 11,10, "CIRCUS"
  put char BlueBalloon at 18,10
  put char GreenBalloon at 9,11
  put char RedBalloon at 18,11
  print at 3,15, "GOAL: BOUNCE THE ACROBAT"
  print at 3,16, "ON THE TRAMPOLINE AND POP"
  print at 3,17, "EVERY BALLOON."
  ' Lines 570-580: twenty notes, the colors turning on each
  Col1 = 7
  Col2 = 13
  Col3 = 5
  play sound SndTheme
  for K = 0 to 19
    N = Col1
    Col1 = Col2
    Col2 = Col3
    Col3 = N
    SetSetColors
    N = NoteFrames[K]
    for I = 1 to N
      wait
    next
  next
  print at 9,20, "PLAY"
  print at 9,21, "INSTRUCTIONS"
  Choice = 1
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,20 step 1
  wait no fire
  if Choice = 2 then InstructionsPage
  return
end sub

sub InstructionsPage:
  cls
  backdrop cyan
  print at 9,1, "THIS IS THE GAME"
  print at 9,2, "OF CIRCUS."
  print at 2,4, "THE OBJECT OF THE GAME IS"
  print at 2,5, "TO POP ALL THE BALLOONS"
  print at 2,6, "WITH THE MAN. TO CATCH THE"
  print at 2,7, "MAN, POSITION THE"
  print at 2,8, "TRAMPOLINE WITH THE STICK."
  print at 2,10, "ALL BORDERS, BUT THE BOTTOM,"
  print at 2,11, "WILL BOUNCE THE MAN BACK."
  print at 2,13, "AN EXTRA MAN EVERY 2000"
  print at 2,14, "POINTS."
  print at 2,16, "BEWARE THE TOP ROW: WHEN IT"
  print at 2,17, "IS BLACK, IT BLOWS UP IN"
  print at 2,18, "YOUR MAN'S FACE. YELLOW, IT"
  print at 2,19, "IS WORTH 250 POINTS."
  print at 2,20, "OTHERS: 100, 75 AND 50."
  print at 10,22, "GOOD LUCK!"
  play sound SndBeep
  pause until press
  wait no fire
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  backdrop white
  cls
  print at 13,1, "CIRCUS"
  print at 4,3, "COMPUTE! FEBRUARY 1984,"
  print at 4,4, "THE TI-99/4A VERSION"
  print at 2,6, "AN ACROBAT, A TRAMPOLINE"
  print at 2,7, "AND THREE ROWS OF BALLOONS:"
  print at 2,8, "A BREAKOUT UNDER THE BIG"
  print at 2,9, "TOP, WRITTEN IN EXTENDED"
  print at 2,10, "BASIC WITH CHARACTERS FOR"
  print at 2,11, "THE PLAYFIELD AND SPRITES"
  print at 2,12, "FOR THE BIRDS."
  print at 2,14, "THE MARCH ON THE TITLE PAGE"
  print at 2,15, "IS THE ONE OF THE LISTING."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  return
end sub

' Sprites (16 x 16): the acrobat (line 460, top-left quarter), the bird
' with wings up (line 480) and wings down
data SpritePat bytes
  $3A,$3A,$12,$7C,$10,$38,$44,$44
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $0F,$0C,$07,$03,$C1,$EF,$7F,$7F
  $3F,$0F,$03,$07,$0F,$1E,$38,$00
  $00,$00,$C0,$DE,$FA,$EF,$FF,$CF
  $E0,$E0,$C0,$B0,$80,$00,$00,$00
  $00,$00,$00,$00,$C0,$EF,$7F,$7F
  $3F,$1F,$3F,$77,$E3,$C0,$80,$00
  $00,$00,$00,$00,$00,$CE,$FA,$EF
  $FF,$CF,$E0,$C0,$00,$00,$00,$00
end data

' Tiles 128-138: top border, side border, floor, four balloons (lines
' 410-450), trampoline (left, middle, right), ledge; all on transparent
data TilePat bytes
  $FF,$AA,$55,$AA,$55,$AA,$55,$FF
  $C3,$A5,$99,$C3,$A5,$99,$C3,$A5
  $FF,$FF,$00,$FF,$FF,$00,$FF,$FF
  $1C,$3E,$3E,$3E,$1C,$08,$04,$08
  $1C,$3E,$3E,$3E,$1C,$08,$04,$08
  $1C,$3E,$3E,$3E,$1C,$08,$04,$08
  $1C,$3E,$3E,$3E,$1C,$08,$04,$08
  $FF,$FF,$40,$40,$40,$40,$40,$E0
  $FF,$FF,$00,$00,$00,$00,$00,$00
  $FF,$FF,$02,$02,$02,$02,$02,$07
  $FF,$FF,$AA,$55,$AA,$55,$00,$00
end data

data TileCol bytes
  $D0,$D0,$D0,$D0,$D0,$D0,$D0,$D0
  $D0,$D0,$D0,$D0,$D0,$D0,$D0,$D0
  $6E,$6E,$6E,$6E,$6E,$6E,$6E,$6E
  $A0,$A0,$A0,$A0,$A0,$10,$10,$10
  $80,$80,$80,$80,$80,$10,$10,$10
  $40,$40,$40,$40,$40,$10,$10,$10
  $C0,$C0,$C0,$C0,$C0,$10,$10,$10
  $D0,$D0,$10,$10,$10,$10,$10,$10
  $D0,$D0,$10,$10,$10,$10,$10,$10
  $D0,$D0,$10,$10,$10,$10,$10,$10
  $D0,$D0,$D0,$D0,$D0,$D0,$D0,$D0
end data

' Lines 510-520: the note lengths of the march, in frames (200 ms = 12)
data NoteFrames bytes 12,12,6,6,6,6,12,12,12,12,12,12,6,6,6,6,12,12,12,12

' Line 80: the top row, yellow or black (tile 131, top third)
data YellowCol bytes $A0,$A0,$A0,$A0,$A0,$10,$10,$10
data BlackCol bytes $10,$10,$10,$10,$10,$10,$10,$10

asm {
ThemeT1:
    db $40,$D6,$10,$0B,$40,$D6,$F0,$01,$40,$E2,$10,$0B,$40,$E2,$F0,$01,$40,$F0,$10,$05,$40,$F0,$F0,$01
    db $40,$E2,$10,$05,$40,$E2,$F0,$01,$40,$F0,$10,$05,$40,$F0,$F0,$01,$40,$FE,$10,$05,$40,$FE,$F0,$01
    db $40,$0E,$11,$0B,$40,$0E,$F1,$01,$40,$1D,$11,$0B,$40,$1D,$F1,$01,$40,$F0,$10,$0B,$40,$F0,$F0,$01
    db $40,$FE,$10,$0B,$40,$FE,$F0,$01,$40,$1D,$11,$0B,$40,$1D,$F1,$01,$40,$2E,$11,$05,$40,$2E,$F1,$01
    db $40,$1D,$11,$05,$40,$1D,$F1,$01,$40,$2E,$11,$05,$40,$2E,$F1,$01,$40,$41,$11,$05,$40,$41,$F1,$01
    db $40,$53,$11,$0B,$40,$53,$F1,$01,$40,$68,$11,$0B,$40,$68,$F1,$01,$40,$7C,$11,$0B,$40,$7C,$F1,$01
    db $40,$68,$11,$0B,$40,$68,$F1,$01,$40,$7C,$11,$17,$40,$7C,$F1,$01,$50
BoingT1:
    db $40,$F0,$13,$03,$40,$BC,$43,$03,$40,$8D,$73,$03,$40,$63,$A3,$03,$40,$3D,$D3,$03,$50
PopN:
    db $00,$00,$14,$03,$10
LoseT1:
    db $40,$6D,$02,$03,$40,$8A,$12,$03,$40,$AA,$22,$03,$40,$CD,$32,$03,$40,$F4,$42,$03,$40,$1F,$53,$03
    db $40,$4F,$63,$03,$40,$86,$73,$03,$40,$C4,$83,$03,$40,$FF,$93,$03,$40,$FF,$A3,$03,$40,$FF,$B3,$03
    db $40,$FF,$C3,$03,$40,$FF,$D3,$03,$40,$FF,$E3,$03,$40,$FF,$F3,$03,$50
LoseN:
    db $00,$00,$06,$03,$00,$00,$16,$03,$00,$00,$26,$03,$00,$00,$36,$03,$00,$00,$46,$03,$00,$00,$56,$03
    db $00,$00,$66,$03,$00,$00,$76,$03,$00,$00,$86,$03,$00,$00,$96,$03,$00,$00,$A6,$03,$00,$00,$B6,$03
    db $00,$00,$C6,$03,$00,$00,$D6,$03,$00,$00,$E6,$03,$00,$00,$F6,$03,$10
ExtraT1:
    db $40,$6B,$10,$05,$40,$55,$10,$05,$40,$47,$10,$05,$40,$35,$10,$0C,$50
OverT1:
    db $40,$1D,$11,$04,$40,$28,$11,$04,$40,$33,$11,$04,$40,$40,$11,$04,$40,$4D,$11,$04,$40,$5B,$11,$04
    db $40,$6B,$11,$04,$40,$7C,$11,$04,$40,$90,$11,$04,$40,$A5,$11,$04,$40,$BC,$11,$04,$40,$D6,$11,$04
    db $40,$F3,$11,$04,$40,$15,$12,$04,$40,$3B,$12,$04,$50
BeepT1:
    db $40,$50,$00,$0C,$50

CircusSoundTable:
    dw ThemeT1,$702B
    dw BoingT1,$7035
    dw PopN,$702B
    dw LoseT1,$7035
    dw LoseN,$702B
    dw ExtraT1,$7035
    dw OverT1,$7035
    dw BeepT1,$7035
}
