; ---------------------------------------------------------------------------
; The Dark House, Z80 helpers (called with the NMI off)
; LdFloor: copies floor Lvl's 16 x 16 map into Map.
; Bfs: distances from cell Tgt to every open cell, into Dist (255: none);
;      a breadth-first flood with a 64-entry ring queue.
; DvDraw: draws the view from BandSt (nine band states, left to right),
;      28 columns by 16 rows at row 2, column 2, a row at a time.
; ---------------------------------------------------------------------------
LdFloor:
    ld a,(AMY_UVAR_Lvl)
    ld h,a
    ld l,0
    ld de,DhMaps
    add hl,de
    ld (AMY_UVAR_MapBase),hl
    ret

Bfs:
    ld hl,AMY_UVAR_Dist
    ld (hl),255
    ld de,AMY_UVAR_Dist+1
    ld bc,255
    ldir
    ld a,(AMY_UVAR_Tgt)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Dist
    add hl,de
    ld (hl),0
    ld (AMY_UVAR_Q),a
    xor a
    ld (AMY_UVAR_QH),a
    inc a
    ld (AMY_UVAR_QT),a
bf_lp:
    ld a,(AMY_UVAR_QH)
    ld hl,AMY_UVAR_QT
    cp (hl)
    ret z
    ld e,a
    inc a
    and 63
    ld (AMY_UVAR_QH),a
    ld d,0
    ld hl,AMY_UVAR_Q
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_QC),a
    ld e,a
    ld hl,AMY_UVAR_Dist
    add hl,de
    ld a,(hl)
    inc a
    ld (AMY_UVAR_QD),a
    ld a,(AMY_UVAR_QC)
    inc a
    call bf_try
    ld a,(AMY_UVAR_QC)
    dec a
    call bf_try
    ld a,(AMY_UVAR_QC)
    add a,16
    call bf_try
    ld a,(AMY_UVAR_QC)
    sub 16
    call bf_try
    jr bf_lp
bf_try:
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_MapBase)
    add hl,de
    ld a,(hl)
    or a
    ret nz
    ld hl,AMY_UVAR_Dist
    add hl,de
    ld a,(hl)
    cp 255
    ret nz
    ld a,(AMY_UVAR_QD)
    ld (hl),a
    ld a,(AMY_UVAR_QT)
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_Q
    add hl,bc
    ld (hl),e
    inc a
    and 63
    ld (AMY_UVAR_QT),a
    ret

DvDraw:
    push ix
    push iy
    ld ix,AMY_UVAR_BandSt
    ld iy,AMY_UVAR_DvPtr
    ld hl,DvTab
    ld b,9
dv_p:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld c,(hl)
    inc hl
    ld a,(hl)
    inc hl
    inc hl
    push hl
    ld h,a
    ld l,c
    ex de,hl
    ld a,(ix+0)
    or a
    jr nz,dv_m
    ld hl,DvBlack
    jr dv_md
dv_m:
    add hl,de
    dec a
    jr nz,dv_m
dv_md:
    ld (iy+0),l
    ld (iy+1),h
    inc ix
    inc iy
    inc iy
    pop hl
    djnz dv_p
    ld de,$1842
    ld c,16
dv_r:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    push de
    push bc
    ld iy,AMY_UVAR_DvPtr
    ld ix,DvTab
    ld c,9
dv_b:
    ld l,(iy+0)
    ld h,(iy+1)
    ld b,(ix+4)
dv_o:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz dv_o
    ld (iy+0),l
    ld (iy+1),h
    inc iy
    inc iy
    ld de,5
    add ix,de
    dec c
    jr nz,dv_b
    pop bc
    pop de
    ld hl,32
    add hl,de
    ex de,hl
    dec c
    jr nz,dv_r
    pop iy
    pop ix
    ret

; Colour table: three independent thirds (R3 = $FF), so each third's
; tiles keep their own colours
SetR3:
    ld bc,$03FF
    jp WRITE_REGISTER
; The Dark House: view strips, generated by art.py
; Band order: L0 L1 L2 L3 centre R3 R2 R1 R0; each state is width x 16 name bytes, row by row
DvTab:
    dw DvS0-80
    dw 80
    db 5
    dw DvS1-64
    dw 64
    db 4
    dw DvS2-48
    dw 48
    db 3
    dw DvS3-16
    dw 16
    db 1
    dw DvS4-32
    dw 32
    db 2
    dw DvS5-16
    dw 16
    db 1
    dw DvS6-48
    dw 48
    db 3
    dw DvS7-64
    dw 64
    db 4
    dw DvS8-80
    dw 80
    db 5
DvBlack:
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
DvS0:
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
    db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
