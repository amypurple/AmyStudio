cartridge "THE DARK HOUSE/AMY BIENVENU/2026"

' THE DARK HOUSE
' An original ColecoVision game in Amy by Amy Bienvenu, 2026.
'
' Historical context:
' First-person mazes are almost as old as home computers. Malcolm
' Evans's 3D Monster Maze (J.K. Greye Software, 1981) put a ZX81 owner
' in a maze with a tyrannosaur that could be heard before it was seen,
' and it is often called the first 3-D horror game. Dungeon crawlers
' (Wizardry, 1981; Dungeon Master, 1987) made the same step-by-step
' view famous. The ColecoVision never had one of its own, so this is
' that game: a house at night, a flashlight, and something that lives
' in the walls.
'
' The game: three floors (the attic, the bedrooms, the great hall). On
' each, find the key and open the locked door; the great hall's door
' is the way out. The Tenant walks the house. It cannot see in the
' dark, but it sees your light down any straight hallway, and it hears
' your footsteps. Tiptoe (hold the left button while you walk) and it
' only hears you from right next to you. Hide in a wardrobe (face it,
' press the left button). An old camera's flash makes it flee, if you
' have film. Batteries keep the light on. Nine notes tell the story of
' the house, and the first ones explain the rules.
'
' Controls (either joystick): up steps forward, down steps back, left
' and right turn. Left button: open, hide, take a photo; hold it to
' tiptoe. Right button: the flashlight on or off. The keypad is not used.
'
' How the 3-D works: the view is nine vertical bands (four depths on
' each side and the middle). Each band has a few possible pictures (a
' side wall, the end of a side passage, a wall ahead at a given depth,
' a door, a wardrobe, darkness), all drawn ahead of time by art.py as
' rows of tiles. Drawing the view is picking one picture per band and
' copying 448 name bytes (DvDraw, in Z80). The flashlight lights four
' cells; without it only the walls next to you show, in deep blue.
' The Tenant and the things on the floor are sprites in four sizes.
' The Tenant finds its way with a breadth-first flood of the floor
' (Bfs, in Z80) toward what it heard or saw, or toward a random room.
' Everything stays in columns 2-29, inside the TV overscan. At most
' seven sprites share a line, with flicker on. The frame loop is
' protected from the NMI.
' Liberties: none (an original game); the voice is synthesized.

const TBarOn = 153
const TBarOff = 154
const TKey = 155
const TFilm = 156
const THeart = 157
const THeartOff = 158
const TSlat0 = 227
const TSlat1 = 228
const TSlat2 = 254
const TSlat3 = 255
const TSlat4 = 151
const TSlat5 = 152
const ViewN0 = 808
const ViewN1 = 1024
const ViewN2 = 248
const SpBig1 = 0
const SpMid1 = 24
const SpSml1 = 32
const SpBig2 = 36
const SpMid2 = 60
const SpSml2 = 68
const SpEyeBig = 72
const SpEyeMid = 76
const SpEyeSml = 80
const SpEyeDot = 84
const SpKeyB = 88
const SpKeyS = 92
const SpKeyT = 96
const SpNoteB = 100
const SpNoteS = 104
const SpNoteT = 108
const SpFilmB = 112
const SpFilmS = 116
const SpFilmT = 120
const SpBatB = 124
const SpBatS = 128
const SpBatT = 132
const SprBytes = 1088
const FaceN0 = 256
const FaceN1 = 480
const FaceN2 = 64
const TitleN0 = 464
const TitleN1 = 360
const SndStepP = 1
const SndCr0 = 2
const SndCr1 = 3
const SndCr2 = 4
const SndCr3 = 5
const SndHeart = 6
const SndBump = 7
const SndLocked = 8
const SndKey = 9
const SndPaper = 10
const SndClick = 11
const SndBattery = 12
const SndFlashT = 13
const SndFlashN = 14
const SndCreak = 15
const SndSting = 16
const SndScream = 17
const SndScreamN = 18
const SndStairs = 19
const SndThunder = 20
const SndWin = 21
const SndOver = 22
const SndPick = 23
const SndTuneA = 24
const SndTuneB = 25

u16 MapBase = 0
u8 MapV = 0
u8 Ci = 0
u8 Dist[256]
u8 Q[64]
u8 QH = 0
u8 QT = 0
u8 QC = 0
u8 QD = 0
u8 Tgt = 0
u8 Lvl = 0
u8 BandSt[9]
u8 DvPtr[18]
u8 ItC[8]
u8 ItT[8]
u16 Score = 0
u16 HighScore = 2000
u8 HighName[3]
u16 NumU = 0
u16 W16 = 0
u16 Dst16 = 0
u16 Secs = 0
u8 SecT = 0
u8 PC = 0
u8 PD = 0
u8 Fw = 0
u8 Lw = 0
u8 Rw = 0
u8 StepT = 0
u8 TurnT = 0
u8 Lit = 1
u8 Bat = 255
u8 BatT = 0
u8 Film = 1
u8 HasKey = 0
u8 Nerve = 3
u8 Hidden = 0
u8 HideT = 0
u8 Notes = 0
u8 CrC = 0
u8 CrMode = 0
u8 CrT = 0
u8 Stun = 0
u8 VoiceT = 0
u16 VoiceW = 0
u8 HeartT = 0
u8 Caught = 0
u8 Leave = 0
u8 Redraw = 0
u8 FrontJ = 0
u8 FrontT = 0
u8 CrDep = 0
u8 ItDep = 0
u8 ItK = 0
u8 MsgT = 0
u8 Ls = 0
u8 Rs = 0
u8 Cl = 0
u8 Md = 0
u8 Seen = 0
u8 Why = 0
u8 Best = 0
u8 St = 0
u8 Up = 0
u8 Dn = 0
u8 Lf = 0
u8 Rt = 0
u8 BtnA = 0
u8 BtnB = 0
u8 WasA = 0
u8 WasB = 0
u8 Tick = 0
u8 Mix = 0
u8 Choice = 1
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 R = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tm = 0
u8 Si = 0
u8 Wi = 0
u8 Dj = 0
u8 Hb = 0
u8 SprDirty = 1

  tile screen
  call asm SetR3
  set sound table DhSoundTable areas 4
  sprites 16x16
  sprites flicker on
  copy SpritePat count 1088 to vram.spr_pat
  QH = 0
  QT = 0
  DvPtr[0] = 0
  Q[0] = 0
  HideSprites
  HighName[0] = 77
  HighName[1] = 65
  HighName[2] = 82
  screen on
  EditorialPage
  CreditsPage

title:
  TitlePage

new_game:
  Score = 0
  Nerve = 3
  Film = 1
  Bat = 255
  Notes = 0
  Secs = 0
  Lvl = 0
  VoiceT = 0
  FloorCard

floor_start:
  SetupFloor

main_loop:
  nmi on
  wait
  nmi off
  inc Tick
  inc SecT
  if SecT >= 60 then
    SecT = 0
    inc Secs
  end if
  if VoiceT > 0 then dec VoiceT
  ReadPad
  if Hidden = 1 then
    HiddenTick
  else
    PlayerTick
  end if
  CreatureTick
  LightTick
  HeartTick
  if Redraw = 1 then
    Redraw = 0
    DrawView
  end if
  ' Sprites only change when something moves (and for its sway)
  N = Tick & 15
  if N = 0 then SprDirty = 1
  if SprDirty = 1 then
    SprDirty = 0
    DrawSprites
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 28 at 2,22
  end if
  if Caught = 1 then goto got_caught
  if Leave = 1 then goto floor_done
  goto main_loop

got_caught:
  JumpScare
  dec Nerve
  if Nerve = 0 then goto game_over
  ' You come to at the top of the stairs; it has gone back to its lair
  nmi off
  LoadView
  DrawHud
  PC = StartCell[Lvl]
  PD = StartDir[Lvl]
  CrC = LairCell[Lvl]
  CrMode = 0
  Caught = 0
  Hidden = 0
  Stun = 90
  NewWander
  ClearMsg
  print at 2,22, "YOU COME TO. IT IS GONE."
  MsgT = 180
  Redraw = 1
  Rearm
  wait no fire
  nmi off
  goto main_loop

floor_done:
  HideSprites
  Score += 500
  play sound SndStairs
  inc Lvl
  if Lvl = 3 then goto escaped
  FloorCard
  goto floor_start

escaped:
  nmi off
  cls
  backdrop black
  play sound SndWin
  print at 4,3, "YOU STEP OUT INTO THE"
  print at 4,4, "NIGHT AIR. BEHIND YOU,"
  print at 4,5, "THE FRONT DOOR CLOSES"
  print at 4,6, "BY ITSELF."
  print at 4,9, "YOU ESCAPED"
  print at 4,10, "THE DARK HOUSE!"
  ' Bonuses: nerve left, film left, notes read
  NumU = Nerve * 300
  Score += NumU
  NumU = Film * 50
  Score += NumU
  print at 4,13, "NOTES READ"
  NumU = Notes
  print at 20,13, digits$(NumU, 1)
  print at 21,13, "/9"
  print at 4,14, "NERVE LEFT"
  NumU = Nerve
  print at 20,14, digits$(NumU, 1)
  print at 4,15, "TIME"
  NumU = Secs
  print at 18,15, digits$(NumU, 4)
  print at 22,15, "S"
  print at 4,17, "SCORE"
  NumU = Score
  print at 18,17, digits$(NumU, 5)
  Rearm
  wait 240 frames
  nmi off
  goto final_score

game_over:
  nmi off
  cls
  backdrop black
  play sound SndOver
  print at 7,8, "THE TENANT KEEPS YOU."
  print at 7,10, "THE HOUSE IS QUIET"
  print at 7,11, "AGAIN."
  print at 7,14, "SCORE"
  NumU = Score
  print at 16,14, digits$(NumU, 5)
  Rearm
  wait 240 frames
  nmi off

final_score:
  if Score > HighScore then
    HighScore = Score
    cls
    print at 8,9, "NEW HIGH SCORE!"
    play sound SndKey
    EnterName
  end if
  cls
  print at 10,10, "ANOTHER NIGHT"
  print at 10,11, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 8,10 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

' Re-arm the VDP interrupt before waiting
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadPad:
  Up = 0
  Dn = 0
  Lf = 0
  Rt = 0
  BtnA = 0
  BtnB = 0
  if joypad(1).up then Up = 1
  if joypad(2).up then Up = 1
  if joypad(1).down then Dn = 1
  if joypad(2).down then Dn = 1
  if joypad(1).left then Lf = 1
  if joypad(2).left then Lf = 1
  if joypad(1).right then Rt = 1
  if joypad(2).right then Rt = 1
  if joypad(1).button1 then BtnA = 1
  if joypad(2).button1 then BtnA = 1
  if joypad(1).button2 then BtnB = 1
  if joypad(2).button2 then BtnB = 1
  return
end sub

' A new floor: its map, its things, the Tenant in its lair
sub SetupFloor:
  nmi off
  HideSprites
  call asm LdFloor
  N = Lvl * 16
  for G = 0 to 7
    ItC[G] = ItemData[N]
    inc N
    ItT[G] = ItemData[N]
    inc N
  next
  PC = StartCell[Lvl]
  PD = StartDir[Lvl]
  CrC = LairCell[Lvl]
  CrMode = 0
  CrT = 120
  Stun = 0
  HasKey = 0
  Hidden = 0
  Caught = 0
  Leave = 0
  StepT = 20
  TurnT = 20
  if Bat > 0 then Lit = 1
  NewWander
  fill mode 2 text color with $F1
  LoadView
  backdrop black
  cls
  DrawHud
  ClearMsg
  if Lvl = 0 then print at 2,22, "THE DOOR BELOW IS LOCKED."
  if Lvl = 1 then print at 2,22, "FIND THIS FLOOR'S KEY."
  if Lvl = 2 then print at 2,22, "THE FRONT DOOR. THE KEY?"
  MsgT = 200
  Redraw = 1
  Rearm
  wait no fire
  nmi off
  return
end sub

sub PlayerTick:
  if StepT > 0 then dec StepT
  if TurnT > 0 then dec TurnT
  ' Right button: the flashlight
  if BtnB = 1 then
    if WasB = 0 then
      play sound SndClick
      if Lit = 1 then
        Lit = 0
      else
        if Bat > 0 then Lit = 1
      end if
      Redraw = 1
      SeeCheck
    end if
  end if
  WasB = BtnB
  ' Left button: open, hide, photograph
  if BtnA = 1 then
    if WasA = 0 then Action
  end if
  WasA = BtnA
  if Hidden = 1 then return
  if StepT = 0 then
    if Up = 1 then
      N = PC + Fw
      TryMove
    elseif Dn = 1 then
      N = PC - Fw
      TryMove
    end if
  end if
  if TurnT = 0 then
    if Lf = 1 then
      PD += 3
      PD = PD & 3
      TurnT = 12
      Redraw = 1
    elseif Rt = 1 then
      inc PD
      PD = PD & 3
      TurnT = 12
      Redraw = 1
    end if
  end if
  return
end sub

sub TryMove:
  Ci = N
  CellV
  if MapV > 0 then
    play sound SndBump
    StepT = 10
    return
  end if
  PC = N
  Redraw = 1
  if BtnA = 1 then
    ' Tiptoe: slow and silent
    StepT = 26
    X = PC
    Y = CrC
    Manh
    if Md <= 1 then
      Why = 1
      Alert
    end if
  else
    StepT = 11
    play sound SndStepP
    X = PC
    Y = CrC
    Manh
    N = HearR[Lvl]
    if Md <= N then
      Why = 1
      Alert
    end if
  end if
  Pickup
  SeeCheck
  if PC = CrC then
    if Stun = 0 then Caught = 1
  end if
  return
end sub

sub Action:
  N = PC + Fw
  Ci = N
  CellV
  V = MapV
  if V = 2 then
    if HasKey = 1 then
      play sound SndKey
      Leave = 1
    else
      play sound SndLocked
      ClearMsg
      print at 2,22, "LOCKED. YOU NEED THE KEY."
      MsgT = 150
    end if
    StepT = 20
    return
  end if
  if V = 3 then
    ' Into the wardrobe
    play sound SndCreak
    Hidden = 1
    HideT = 40
    DrawSlats
    ClearMsg
    print at 2,22, "YOU HIDE. HOLD YOUR BREATH."
    MsgT = 150
    return
  end if
  if CrDep > 0 then
    if Film > 0 then
      Flash
      return
    end if
    ClearMsg
    print at 2,22, "NO FILM LEFT!"
    MsgT = 90
  end if
  return
end sub

' The camera: a flash, a shriek, and it flees to its lair for a while
sub Flash:
  dec Film
  play sound SndFlashT
  play sound SndFlashN
  backdrop white
  Rearm
  wait 4 frames
  nmi off
  backdrop black
  Rearm
  wait 2 frames
  nmi off
  backdrop white
  Rearm
  wait 3 frames
  nmi off
  backdrop black
  play sound SndScream
  CrC = LairCell[Lvl]
  CrMode = 0
  Stun = 255
  SprDirty = 1
  Score += 50
  DrawHud
  ClearMsg
  print at 2,22, "IT SHRIEKS AND FLEES!"
  MsgT = 150
  return
end sub

sub HiddenTick:
  if HideT > 0 then dec HideT
  if BtnB = 1 then
    if WasB = 0 then play sound SndClick
  end if
  WasB = BtnB
  if BtnA = 1 then
    if WasA = 0 then
      if HideT = 0 then
        play sound SndCreak
        Hidden = 0
        StepT = 15
        Redraw = 1
        SeeCheck
      end if
    end if
  end if
  WasA = BtnA
  return
end sub

' Things on the floor: picked up as you step on them
sub Pickup:
  for G = 0 to 7
    V = ItT[G]
    if V > 0 then
      if ItC[G] = PC then
        ItT[G] = 0
        ClearMsg
        if V = 1 then
          HasKey = 1
          play sound SndKey
          print at 2,22, "YOU FOUND THE KEY!"
        elseif V = 2 then
          Bat += 100
          if Bat < 100 then Bat = 255
          play sound SndBattery
          print at 2,22, "A FRESH BATTERY."
        elseif V = 3 then
          inc Film
          play sound SndClick
          print at 2,22, "A FLASHBULB FOR THE CAMERA."
        else
          play sound SndPaper
          N = V - 16
          ShowNote
          print at 2,22, "A NOTE. YOU READ IT."
        end if
        MsgT = 150
        DrawHud
      end if
    end if
  next
  return
end sub

' The map cell Ci (0 open, 1 wall, 2 locked door, 3 wardrobe), into MapV
sub CellV:
  W16 = MapBase
  W16 += Ci
  MapV = peek(W16)
  return
end sub

' Manhattan distance between cells X and Y, into Md
sub Manh:
  P = X & 15
  R = Y & 15
  if P > R then
    Md = P - R
  else
    Md = R - P
  end if
  P = X >> 4
  R = Y >> 4
  if P > R then
    P -= R
  else
    P = R - P
  end if
  Md += P
  return
end sub

' Can the Tenant see your light? Same row or column, nothing between
sub SeeCheck:
  Seen = 0
  if Lit = 0 then return
  if Hidden = 1 then return
  if Stun > 0 then return
  P = PC & 15
  R = CrC & 15
  X = PC >> 4
  Y = CrC >> 4
  St = 0
  if P = R then
    if X > Y then
      St = 16
    else
      St = 240
    end if
  elseif X = Y then
    if P > R then
      St = 1
    else
      St = 255
    end if
  end if
  if St = 0 then return
  Cl = CrC
  for Si = 1 to 7
    Cl += St
    if Cl = PC then
      Why = 2
      Alert
      return
    end if
    Ci = Cl
    CellV
    if MapV > 0 then return
  next
  return
end sub

' It heard or saw you: it comes for the place you are now
sub Alert:
  Tgt = PC
  call asm Bfs
  if CrMode = 1 then return
  CrMode = 1
  if CrT > 14 then CrT = 14
  ClearMsg
  if Why = 1 then
    print at 2,22, "IT HEARD YOU!"
  else
    print at 2,22, "IT SEES YOUR LIGHT!"
  end if
  MsgT = 120
  if VoiceT = 0 then
    VoiceT = 255
    play voxpcm SayHear
    nmi off
  else
    play sound SndSting
  end if
  return
end sub

' A random room, away from you
sub NewWander:
  for Wi = 1 to 40
    Mix += 73
    R = random(0, 255)
    R += Mix
    Ci = R
    CellV
    if MapV = 0 then
      X = R
      Y = PC
      Manh
      if Md >= 5 then goto nw_ok
    end if
  next
  R = LairCell[Lvl]
nw_ok:
  Tgt = R
  call asm Bfs
  return
end sub

sub CreatureTick:
  if CrC = PC then
    if Hidden = 0 then
      if Stun = 0 then Caught = 1
    end if
  end if
  if Stun > 0 then
    dec Stun
    if Stun = 0 then
      NewWander
      SprDirty = 1
    end if
    return
  end if
  if CrT > 0 then
    dec CrT
    return
  end if
  if CrMode = 1 then
    CrT = HuntSp[Lvl]
  else
    CrT = WanderSp[Lvl]
  end if
  if CrC = Tgt then
    ' Nothing here: back to wandering
    CrMode = 0
    NewWander
    return
  end if
  V = Dist[CrC]
  Best = CrC
  N = CrC + 1
  if Dist[N] < V then Best = N
  N = CrC - 1
  if Dist[N] < V then Best = N
  N = CrC + 16
  if Dist[N] < V then Best = N
  N = CrC - 16
  if Dist[N] < V then Best = N
  if Best = CrC then
    NewWander
    return
  end if
  CrC = Best
  SprDirty = 1
  ' Its footsteps, louder as it comes
  X = PC
  Y = CrC
  Manh
  if Md <= 2 then
    play sound SndCr0
  elseif Md <= 5 then
    play sound SndCr1
  elseif Md <= 8 then
    play sound SndCr2
  elseif Md <= 11 then
    play sound SndCr3
  end if
  SeeCheck
  if CrC = PC then
    if Hidden = 0 then Caught = 1
  end if
  return
end sub

' The battery runs down while the light is on
sub LightTick:
  if Lit = 0 then return
  if Hidden = 1 then return
  inc BatT
  if BatT < 14 then return
  BatT = 0
  dec Bat
  N = Bat & 31
  if N = 0 then DrawHud
  if Bat = 0 then
    Lit = 0
    Redraw = 1
    ClearMsg
    print at 2,22, "YOUR LIGHT DIES."
    MsgT = 150
  end if
  return
end sub

' Your heart, faster as it comes closer
sub HeartTick:
  if Stun > 0 then return
  X = PC
  Y = CrC
  Manh
  if Md > 6 then
    HeartT = 0
    return
  end if
  if HeartT > 0 then
    dec HeartT
    return
  end if
  play sound SndHeart
  Hb = Md * 7
  Hb += 14
  HeartT = Hb
  return
end sub

' Which picture each band shows
sub ComputeView:
  Fw = FwdTab[PD]
  N = PD + 3
  N = N & 3
  Lw = FwdTab[N]
  N = PD + 1
  N = N & 3
  Rw = FwdTab[N]
  FrontJ = 5
  FrontT = 1
  Cl = PC
  for J = 1 to 4
    Cl += Fw
    Ci = Cl
    CellV
    V = MapV
    if V > 0 then
      FrontJ = J
      FrontT = V
      goto cv_found
    end if
  next
cv_found:
  Cl = PC
  for K = 0 to 3
    if K >= FrontJ then
      if Lit = 1 then
        V = FrontJ - 1
        V *= 3
        V += FrontT
        V += 3
      else
        V = 0
        if FrontJ = 1 then
          V = K * 3
          V += 3
          V += FrontT
        end if
      end if
      Ls = V
      Rs = V
    else
      N = Cl + Lw
      SideOf
      Ls = V
      N = Cl + Rw
      SideOf
      Rs = V
      Cl += Fw
    end if
    BandSt[K] = Ls
    N = 8 - K
    BandSt[N] = Rs
  next
  if FrontJ <= 4 then
    if Lit = 1 then
      V = FrontJ - 1
      V *= 3
      V += FrontT
      V += 1
    else
      V = 0
      if FrontJ = 1 then V = 13 + FrontT
    end if
  else
    V = Lit
  end if
  BandSt[4] = V
  return
end sub

' One side of band K for the side cell N: a wall, the end of a side
' passage, or the dark
sub SideOf:
  Ci = N
  CellV
  if MapV > 0 then
    V = 2
  else
    Ci += Fw
    CellV
    V = 1
    if MapV > 0 then V = 3
  end if
  if Lit = 0 then
    if K = 0 then
      if V = 2 then
        V = 4
        return
      end if
      if V = 3 then
        V = 5
        return
      end if
    end if
    V = 0
  end if
  return
end sub

sub DrawView:
  ComputeView
  call asm DvDraw
  SprDirty = 1
  N = DirChar[PD]
  put char N at 29,20
  return
end sub

' The Tenant and the things on the floor, straight ahead
sub DrawSprites:
  CrDep = 0
  ItDep = 0
  if Hidden = 0 then
    Cl = PC
    for Dj = 1 to 4
      if Dj < FrontJ then
        Cl += Fw
        if Stun = 0 then
          if CrDep = 0 then
            if Cl = CrC then CrDep = Dj
          end if
        end if
        if Dj < 4 then
          if ItDep = 0 then
            for G = 0 to 7
              if ItT[G] > 0 then
                if ItC[G] = Cl then
                  ItDep = Dj
                  ItK = ItT[G]
                end if
              end if
            next
          end if
        end if
      end if
    next
  end if
  for Dj = 0 to 7
    set sprite Dj to 192,0,0,0
  next
  P = Tick & 16
  if CrDep > 0 then
    if Lit = 1 then
      if CrDep = 1 then
        V = SpBig1
        if P > 0 then V = SpBig2
        set sprite 0 to 63,112,V,14
        V += 4
        set sprite 1 to 63,128,V,14
        V += 4
        set sprite 2 to 79,112,V,14
        V += 4
        set sprite 3 to 79,128,V,14
        V += 4
        set sprite 4 to 95,112,V,14
        V += 4
        set sprite 5 to 95,128,V,14
        set sprite 6 to 63,120,SpEyeBig,9
      elseif CrDep = 2 then
        V = SpMid1
        if P > 0 then V = SpMid2
        set sprite 0 to 71,120,V,14
        V += 4
        set sprite 1 to 87,120,V,14
        set sprite 6 to 71,120,SpEyeMid,9
      elseif CrDep = 3 then
        V = SpSml1
        if P > 0 then V = SpSml2
        set sprite 0 to 75,120,V,14
        set sprite 6 to 75,120,SpEyeSml,9
      else
        set sprite 6 to 77,120,SpEyeDot,9
      end if
    else
      ' In the dark, only its eyes
      if CrDep = 1 then
        set sprite 6 to 63,120,SpEyeBig,9
      elseif CrDep = 2 then
        set sprite 6 to 71,120,SpEyeMid,9
      elseif CrDep = 3 then
        set sprite 6 to 75,120,SpEyeSml,9
      else
        set sprite 6 to 77,120,SpEyeDot,9
      end if
    end if
  end if
  if Hidden = 1 then
    ' Through the slats, when it stands right outside
    X = PC
    Y = CrC
    Manh
    if Md <= 1 then
      if Stun = 0 then set sprite 6 to 71,120,SpEyeBig,9
    end if
  end if
  if ItDep > 0 then
    if Lit = 1 then
      if ItK = 1 then
        V = SpKeyB
        R = 11
      elseif ItK = 2 then
        V = SpBatB
        R = 3
      elseif ItK = 3 then
        V = SpFilmB
        R = 14
      else
        V = SpNoteB
        R = 15
      end if
      if ItDep = 1 then
        set sprite 7 to 98,120,V,R
      elseif ItDep = 2 then
        V += 4
        set sprite 7 to 88,120,V,R
      else
        V += 8
        set sprite 7 to 79,120,V,R
      end if
    end if
  end if
  update sprites
  return
end sub

' Inside the wardrobe: light through the slats
sub DrawSlats:
  HideSprites
  for Y = 2 to 17
    N = Y & 1
    if Y < 8 then
      V = TSlat0 + N
    elseif Y < 16 then
      V = TSlat2 + N
    else
      V = TSlat4 + N
    end if
    fill V count 28 at 2,Y
  next
  return
end sub

sub DrawHud:
  print at 2,19, "LIGHT"
  N = Bat >> 5
  if Bat > 0 then inc N
  for G = 0 to 7
    X = G + 8
    V = TBarOff
    if G < N then V = TBarOn
    put char V at X,19
  next
  put char TFilm at 18,19
  NumU = Film
  print at 19,19, digits$(NumU, 1)
  V = 32
  if HasKey = 1 then V = TKey
  put char V at 21,19
  for G = 1 to 3
    X = G + 24
    V = THeartOff
    if G <= Nerve then V = THeart
    put char V at X,19
  next
  if Lvl = 0 then print at 2,20, "THE ATTIC     "
  if Lvl = 1 then print at 2,20, "THE BEDROOMS  "
  if Lvl = 2 then print at 2,20, "THE GREAT HALL"
  print at 22,20, "FACING"
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,22
  return
end sub

' A note: a box over the view until you press a button
sub ShowNote:
  HideSprites
  for Y = 2 to 17
    fill 32 count 28 at 2,Y
  next
  inc Notes
  Score += 100
  print at 4,4, "A NOTE"
  NumU = N + 1
  print at 11,4, digits$(NumU, 1)
  print at 12,4, "/9"
  if N = 0 then
    print at 4,6, "IF YOU FIND THIS, YOU ARE"
    print at 4,7, "LOCKED IN TOO. THE TENANT"
    print at 4,8, "HUNTS BY SOUND. HOLD THE"
    print at 4,9, "LEFT BUTTON WHILE YOU"
    print at 4,10, "WALK, AND TIPTOE."
  elseif N = 1 then
    print at 4,6, "IT CANNOT SEE IN THE DARK,"
    print at 4,7, "BUT IT SEES YOUR LIGHT"
    print at 4,8, "DOWN ANY HALLWAY. THE"
    print at 4,9, "RIGHT BUTTON PUTS IT OUT."
  elseif N = 2 then
    print at 4,6, "A WARDROBE IS A GOOD"
    print at 4,7, "PLACE TO WAIT. FACE ONE,"
    print at 4,8, "PRESS THE LEFT BUTTON."
    print at 4,9, "IT WALKED RIGHT PAST ME."
  elseif N = 3 then
    print at 4,6, "FATHER'S OLD CAMERA STILL"
    print at 4,7, "WORKS. ONE FLASH AND IT"
    print at 4,8, "FLEES. FACE IT AND PRESS"
    print at 4,9, "THE LEFT BUTTON."
  elseif N = 4 then
    print at 4,6, "1928. FATHER BOUGHT THE"
    print at 4,7, "HOUSE CHEAP. NOBODY TOLD"
    print at 4,8, "US ABOUT THE TENANT IN"
    print at 4,9, "THE WALLS."
  elseif N = 5 then
    print at 4,6, "WE HEAR IT AT NIGHT,"
    print at 4,7, "COUNTING THE STEPS."
    print at 4,8, "IT KNOWS EVERY ROOM."
    print at 4,9, "IT IS NEVER IN A HURRY."
  elseif N = 6 then
    print at 4,6, "THE FRONT DOOR KEY IS"
    print at 4,7, "HIDDEN IN THIS HALL."
    print at 4,8, "I NEVER GOT THAT FAR."
  elseif N = 7 then
    print at 4,6, "IT IS FASTER DOWN HERE."
    print at 4,7, "IT HEARS FARTHER. NEVER"
    print at 4,8, "RUN INTO A DEAD END."
  else
    print at 4,6, "IF YOU GET OUT, TELL THEM"
    print at 4,7, "WHAT LIVES HERE. DO NOT"
    print at 4,8, "COME BACK FOR US."
    print at 4,10, "        - MARGARET"
  end if
  print at 7,13, "PRESS A BUTTON"
  Rearm
  wait 30 frames
  wait no fire
  pause until press
  wait no fire
  nmi off
  StepT = 12
  Redraw = 1
  return
end sub

sub JumpScare:
  HideSprites
  play sound SndScream
  play sound SndScreamN
  copy FacePat0 count 256 to vram.pattern + 1024
  copy FaceCol0 count 256 to vram.color + 1024
  copy FacePat1 count 480 to vram.pattern + 3072
  copy FaceCol1 count 480 to vram.color + 3072
  copy FacePat2 count 64 to vram.pattern + 5120
  copy FaceCol2 count 64 to vram.color + 5120
  for Y = 2 to 17
    fill 128 count 28 at 2,Y
  next
  W16 = 0
  Dst16 = 102
  for Y = 0 to 13
    copy FaceNT + W16 count 20 to vram.name + Dst16
    W16 += 20
    Dst16 += 32
  next
  backdrop red
  Rearm
  wait 3 frames
  nmi off
  backdrop black
  Rearm
  wait 20 frames
  nmi off
  Rearm
  wait 70 frames
  nmi off
  for Y = 2 to 17
    fill 32 count 28 at 2,Y
  next
  return
end sub

sub LoadView:
  copy ViewPat0 count 808 to vram.pattern + 1024
  copy ViewCol0 count 808 to vram.color + 1024
  copy ViewPat1 count 1024 to vram.pattern + 3072
  copy ViewCol1 count 1024 to vram.color + 3072
  copy ViewPat2 count 248 to vram.pattern + 5120
  copy ViewCol2 count 248 to vram.color + 5120
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' Between floors: the stairs, the next floor's name
sub FloorCard:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  cls
  if Lvl = 0 then
    print at 6,6, "YOU WAKE UP ON THE"
    print at 6,7, "ATTIC FLOOR. THE CANDLE"
    print at 6,8, "IS OUT. SOMEWHERE IN THE"
    print at 6,9, "HOUSE, SOMETHING IS"
    print at 6,10, "WALKING."
    print at 10,14, "THE ATTIC"
  elseif Lvl = 1 then
    print at 6,7, "DOWN THE STAIRS..."
    print at 6,9, "THE STEPS CREAK. BELOW,"
    print at 6,10, "SOMETHING STOPS TO LISTEN."
    print at 10,14, "THE BEDROOMS"
  else
    print at 6,7, "DOWN THE STAIRS..."
    print at 6,9, "THE GREAT HALL. THE FRONT"
    print at 6,10, "DOOR IS LOCKED, OF COURSE."
    print at 10,14, "THE GREAT HALL"
  end if
  print at 7,20, "PRESS A BUTTON"
  Rearm
  wait 40 frames
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EnterName:
  print at 6,11, "YOUR INITIALS:"
  print at 6,14, "UP/DOWN, BUTTON"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,11
  next
  X = I + 21
  fill 32 count 3 at 21,12
  put char 45 at X,12
  Rearm
  wait 8 frames
  nmi off
  ReadPad
  if BtnA = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then return
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  if Dn = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
end sub

sub TitlePage:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  copy TitlePat0 count 464 to vram.pattern + 1024
  copy TitleCol0 count 464 to vram.color + 1024
  copy TitlePat1 count 360 to vram.pattern + 3072
  copy TitleCol1 count 360 to vram.color + 3072
  backdrop black
  cls
  W16 = 0
  Dst16 = 66
  for Y = 0 to 13
    copy TitleNT + W16 count 28 to vram.name + Dst16
    W16 += 28
    Dst16 += 32
  next
  print at 9,17, "THE DARK HOUSE"
  print at 9,19, "PRESS A BUTTON"
  print at 7,21, "HIGH"
  NumU = HighScore
  print at 12,21, digits$(NumU, 5)
  for J = 0 to 2
    X = J + 18
    N = HighName[J]
    put char N at X,21
  next
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
  Tm = 0
title_loop:
  inc Tm
  ' Lightning now and then
  if Tm = 200 then
    backdrop white
    play sound SndThunder
  end if
  if Tm = 203 then backdrop black
  if Tm = 207 then backdrop white
  if Tm = 209 then
    backdrop black
    Tm = random(0, 90)
  end if
  Rearm
  wait
  nmi off
  if joypad(1).fire then goto title_go
  if joypad(2).fire then goto title_go
  goto title_loop
title_go:
  backdrop black
  play sound SndPick
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  return
end sub

sub EditorialPage:
  nmi off
  HideSprites
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 8,1, "THE DARK HOUSE"
  print at 2,3, "IN 1981, 3D MONSTER MAZE"
  print at 2,4, "PUT ZX81 OWNERS IN A MAZE"
  print at 2,5, "WITH A DINOSAUR THEY COULD"
  print at 2,6, "HEAR BEFORE THEY SAW IT."
  print at 2,7, "THE COLECOVISION NEVER GOT"
  print at 2,8, "A GAME LIKE IT. THIS IS"
  print at 2,9, "ONE: A HOUSE AT NIGHT, A"
  print at 2,10, "FLASHLIGHT, AND SOMETHING"
  print at 2,11, "IN THE WALLS."
  print at 2,13, "PLAY IT IN THE DARK, WITH"
  print at 2,14, "THE SOUND UP. LISTEN FOR"
  print at 2,15, "ITS STEPS AND YOUR HEART."
  print at 2,17, "AN ORIGINAL GAME BY"
  print at 2,18, "AMY BIENVENU, 2026."
  print at 4,22, "PRESS A BUTTON"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  nmi off
  cls
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "STICK UP/DOWN: STEP"
  print at 2,4, "STICK LEFT/RIGHT: TURN"
  print at 2,5, "LEFT BUTTON: OPEN, HIDE,"
  print at 2,6, "  PHOTOGRAPH. HOLD IT"
  print at 2,7, "  WHILE WALKING: TIPTOE."
  print at 2,8, "RIGHT BUTTON: FLASHLIGHT."
  print at 2,10, "FIND EACH FLOOR'S KEY AND"
  print at 2,11, "OPEN ITS DOOR. THE GREAT"
  print at 2,12, "HALL'S DOOR IS THE WAY OUT."
  print at 2,14, "IT HEARS YOUR STEPS. IT"
  print at 2,15, "SEES YOUR LIGHT. IT DOES"
  print at 2,16, "NOT SEE IN THE DARK."
  print at 2,18, "MUSIC, ART, VOICE AND CODE:"
  print at 2,19, "ORIGINAL, MADE IN AMY."
  print at 4,22, "PRESS A BUTTON"
  Rearm
  wait 20 frames
  pause until press
  wait no fire
  nmi off
  return
end sub

