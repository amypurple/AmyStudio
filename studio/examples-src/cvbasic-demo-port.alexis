  text screen
  sprites 16x16
  sprites simple
  copy SpriteBitmap to vram.spr_pat
  clear sprites
  set sprite count 32
  print centered at 4, "CVBASIC PORT"
  print centered at 7, "TILE GRAPHICS"
  print centered at 8, "SPRITES AND MESSAGES"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  tile screen
  sprites 16x16
  sprites simple
  copy SpriteBitmap to vram.spr_pat
  clear sprites
  set sprite count 32
  load default ascii bold
  duplicate mode 2 text patterns
  tint_message_font_band
  define chars ImageChar at 128 count 50
  define colors ImageColor at 128 count 50
main_loop:
  cls
  screen on
  DestOffset = 260
  draw_image_block
  small_wait
  restore Message1
  show_message
  small_wait
  DestOffset = 260
  for C = 0 to 7
    wait 2 frames
    clear_image_row
    DestOffset += 32
    draw_image_block
  next
  DestOffset = 516
  for C = 0 to 7
    wait 2 frames
    clear_image_column
    DestOffset += 1
    draw_image_block
  next
  restore Message2
  show_message
  small_wait
  for C = 0 to 144
    wait
    set sprite 0 to 160,C,0,15
    update sprites
  next
  restore Message3
  show_message
  small_wait
  for C = 0 to 31
    XPos[C] = random(176)
    YPos[C] = random(240)
    Cols[C] = C + 2
    if Cols[C] > 15 then Cols[C] -= 14
    set sprite C to YPos[C],XPos[C],0,Cols[C]
  next
  update sprites
  for C = 0 to 240
    wait
    for D = 0 to 15
      set sprite D to YPos[D],XPos[D],0,Cols[D]
      YPos[D] += 1
      if YPos[D] = 192 then YPos[D] = 241
    next
    for D = 16 to 31
      set sprite D to YPos[D],XPos[D],0,Cols[D]
      XPos[D] += 1
      if XPos[D] = 255 then XPos[D] = 0
    next
    update sprites
  next
  for C = 0 to 31
    set sprite C to 209,0,0,0
  next
  update sprites
  restore Message4
  show_message
  small_wait
  goto main_loop

sub tint_message_font_band:
  for ColorOffset = 2304 to 3071
    vpoke vram.color + ColorOffset, $71
  next
  return

sub draw_image_block:
  u16 WorkOffset = 0
  SourceOffset = 0
  WorkOffset = DestOffset
  for Row = 0 to 7
    copy ImagePattern + SourceOffset count 8 to vram.name + WorkOffset
    SourceOffset += 8
    WorkOffset += 32
  next
  return

sub clear_image_row:
  copy Spaces to vram.name + DestOffset
  return

sub clear_image_column:
  u16 WorkOffset = 0
  WorkOffset = DestOffset
  for Row = 0 to 7
    vpoke vram.name + WorkOffset, $20
    WorkOffset += 32
  next
  return

sub small_wait:
  wait 61 frames
  return

sub show_message:
  for Row = 8 to 15
    fill $20 count 18 at 14,Row
  next
  MsgX = 14
  MsgY = 8
  do
    read D
    if D = 0 then exit do
    if D = 13 then
      MsgX = 14
      MsgY += 1
    else
      put char D at MsgX,MsgY
      MsgX += 1
    end if
    wait
  loop
  return