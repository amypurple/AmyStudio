u32 X = 0
u8 Pass = 0

  text screen
  print at 4,0, "U32 DIVIDE LAB"

  print at 1,3, "100000/25"
  X = 100000
  X /= 25
  if X = 4000 then
    Pass += 1
    print at 22,3, "PASS"
  else
    print at 22,3, "FAIL"
  end if

  print at 1,5, "FFFFFFFF/1"
  X = $FFFFFFFF
  X /= 1
  if X = $FFFFFFFF then
    Pass += 1
    print at 22,5, "PASS"
  else
    print at 22,5, "FAIL"
  end if

  print at 1,7, "1/2"
  X = 1
  X /= 2
  if X = 0 then
    Pass += 1
    print at 22,7, "PASS"
  else
    print at 22,7, "FAIL"
  end if

  print at 1,11, "TOTAL"
  print Pass at 7,11 digits 3
  if Pass = 3 then
    print at 12,11, "PASS"
  else
    print at 12,11, "FAIL"
  end if
  screen on