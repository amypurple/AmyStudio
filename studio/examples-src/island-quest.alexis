u8 CM[7]
u8 RowBuf[14]
u8 RowBot[14]
u8 Hr = 0
u8 Fast = 0
u8 Pending = 0
u8 Pr = 9
u8 Pc = 9
u8 StepT = 0
u8 Walk = 0
u8 Booty = 0
u8 NClue = 0
u8 HomeOk = 0
u8 Over = 0
u8 TLim = 60
u8 MsgT = 0
u8 Moves = 0
u8 Digs = 0
u8 HaveBest = 0
u8 GameOn = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Blink = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Cj = 0
u8 Gk = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Q = 0
u8 M = 0

  tile screen
  set sound table IqSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  GameOn = 0
  mute all
  if Over = 1 then
    BestCheck
    ShowMsg(5)
    play sound SndWin
    print at 8,9, "              "
    print at 8,10, "  WELL DONE!  "
    print at 8,11, "  TIME ", digits$(Clk.Mins, 2), ":", digits$(Clk.Secs, 2), " "
    print at 8,12, "              "
  else
    ShowMsg(7)
    play sound SndOver
    print at 8,9, "              "
    print at 8,10, "   TIME UP!   "
    print at 8,11, "  BOOTY ", Booty, " OF 6"
    print at 8,12, "              "
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the grid place whose top left cell is R,C (255 when none)
function GridAt(u8 R, u8 C2) as u8
  u8 Qr
  u8 Qc
  if R < 18 then return 255
  if C2 < 18 then return 255
  R = R - 18
  C2 = C2 - 18
  Qr = R / 10
  if Qr > 9 then return 255
  if Qr * 10 <> R then return 255
  Qc = C2 / 20
  if Qc > 4 then return 255
  if Qc * 20 <> C2 then return 255
  return Qr * 5 + Qc

' the sector map square (row or column 0-9) of a map row or column
function Sector(u8 P) as u8
  return (P - 4) / 12

' one frame of play: the clock, the stick, the button, the message
sub PlayStep:
  select case Pending
    case 2
      DrawRows(2, 4)
      Pending = 1
    case 1
      DrawRows(5, 6)
      Pending = 0
  end select
  inc Clk.Fr
  if Clk.Fr >= 60 then
    Clk.Fr = 0
    inc Clk.Secs
    if Clk.Secs >= 60 then
      Clk.Secs = 0
      inc Clk.Mins
      if Clk.Mins >= TLim then Over = 2
    end if
    ShowTime
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 28 at 2,22
  end if
  K = J1 & 15
  if K = 0 then
    StepT = 0
  else
    if StepT > 0 then
      dec StepT
    else
      StepT = StepRate
      TryMove
    end if
  end if
  if Press = 1 then DoDig
  return
end sub

' the cell under the pirate again (after a dig)
sub DrawCentre:
  Ri = 3
  Cj = 3
  K = CellKind(Pr, Pc) * 4 + 128
  put char K at 8,9
  put char K + 1 at 9,9
  put char K + 2 at 8,10
  put char K + 3 at 9,10
  return
end sub

' a step in the stick's direction(s), kept inside rows and columns 9-118
sub TryMove:
  u8 Moved
  Moved = 0
  V = J1 & 1
  if V > 0 then
    if Pr > 9 then
      dec Pr
      Moved = 1
    end if
  end if
  V = J1 & 2
  if V > 0 then
    if Pr < 118 then
      inc Pr
      Moved = 1
    end if
  end if
  V = J1 & 4
  if V > 0 then
    if Pc > 9 then
      dec Pc
      Moved = 1
    end if
  end if
  V = J1 & 8
  if V > 0 then
    if Pc < 118 then
      inc Pc
      Moved = 1
    end if
  end if
  if Moved = 0 then return
  inc Moves
  Walk = Walk ^ 1
  CheckClue
  DrawView
  return
end sub

' a clue spot under the pirate is found: it tells where the next treasure is
sub CheckClue:
  Gk = GridAt(Pr, Pc)
  if Gk = 255 then return
  V = GS[Gk]
  if V <> 4 then return
  GS[Gk] = 12
  if NClue < 6 then
    ShowClue(NClue)
    inc NClue
  end if
  ShowMsg(3)
  play sound SndClue
  return
end sub

' the button: dig the mound under the pirate
sub DoDig:
  inc Digs
  Gk = GridAt(Pr - 1, Pc - 1)
  if Gk = 255 then
    WinCheck
    if Over = 0 then play sound SndThud
    return
  end if
  V = GS[Gk]
  if V >= 8 then
    WinCheck
    if Over = 0 then play sound SndThud
    return
  end if
  if V = 4 then
    play sound SndThud
    return
  end if
  GS[Gk] = V + 8
  select case V
    case 1
      HomeOk = 1
      ShowMsg(4)
      play sound SndHome
      MapMark(Gk, TMaph)
    case 2
      inc Booty
      AddChest
      ShowMsg(1)
      play sound SndGold
      MapMark(Gk, TMapx)
    case else
      ShowMsg(2)
      play sound SndDirt
      MapMark(Gk, 45)
  end select
  DrawCentre
  WinCheck
  return
end sub

' six treasures and standing on the found home: the game is won
sub WinCheck:
  if Booty < 6 then return
  if HomeOk = 0 then return
  Gk = GridAt(Pr - 1, Pc - 1)
  if Gk = 255 then return
  if GS[Gk] = 9 then Over = 1
  return
end sub

' the sector map square of grid place G gets tile T
sub MapMark(u8 G, u8 T)
  Y = G / 5
  X = G - Y * 5
  Y = Sector(Y * 10 + 19) + 4
  X = Sector(X * 20 + 19) + 19
  put char T at X,Y
  return
end sub

' clue N: "row-column" of treasure N's mound on the sector map
sub ShowClue(u8 N)
  u8 G
  G = TrG[N]
  Y = G / 5
  X = G - Y * 5
  Q = Sector(Y * 10 + 19)
  M = Sector(X * 20 + 19)
  X = N
  Y = 20
  if X >= 3 then
    X = X - 3
    Y = 21
  end if
  X = X * 4 + 9
  put char Q + 48 at X,Y
  put char 45 at X + 1,Y
  put char M + 65 at X + 2,Y
  return
end sub

sub ShowMsg(u8 N)
  select case N
    case 1
      print at 2,22, "    YOU FOUND TREASURE!     "
    case 2
      print at 2,22, "     NOTHING BUT DIRT!      "
    case 3
      print at 2,22, "     YOU FOUND A CLUE!      "
    case 4
      print at 2,22, "    YOU FOUND YOUR HOME!    "
    case 5
      print at 2,22, "   YOU'RE A WINNER, MATE!   "
    case 6
      print at 2,22, "   BUILDING A NEW WORLD..   "
    case 7
      print at 2,22, "    YOU RAN OUT OF TIME!    "
  end select
  MsgT = MsgTime
  return
end sub

' a faster win is the new best time
sub BestCheck:
  u16 Now
  u16 Old
  Now = Clk.Mins * 60 + Clk.Secs
  Old = Best.Mins * 60 + Best.Secs
  if HaveBest = 1 then
    if Now >= Old then return
  end if
  Best.Mins = Clk.Mins
  Best.Secs = Clk.Secs
  HaveBest = 1
  return
end sub

sub ShowTime:
  print at 23,15, digits$(Clk.Mins, 2), ":", digits$(Clk.Secs, 2)
  return
end sub

' the newest chest of the booty row
sub AddChest:
  X = Booty * 2 + 7
  put char TChest00 at X,18
  put char TChest01 at X + 1,18
  return
end sub

sub ShowBooty:
  for Cj = 0 to 5
    X = Cj * 2 + 9
    K = TEmpty00
    if Cj < Booty then K = TChest00
    put char K at X,18
    put char K + 1 at X + 1,18
  next
  return
end sub

' ---------------------------------------------------------------------------
' the 7 x 7 cells around the pirate (rows 3-16, columns 2-15)
sub DrawView:
  u8 R
  u8 Cc
  ' which grid place each drawn row and column falls in
  for Ri = 0 to 6
    R = Pr + Ri - 3
    RQ[Ri] = 255
    if R >= 18 then
      R = R - 18
      Q = R / 10
      M = R - Q * 10
      if Q < 10 then
        if M <= 2 then
          RQ[Ri] = Q
          RM[Ri] = M
        end if
      end if
    end if
    Cc = Pc + Ri - 3
    CQ[Ri] = 255
    if Cc >= 18 then
      Cc = Cc - 18
      Q = Cc / 20
      M = Cc - Q * 20
      if Q < 5 then
        if M <= 2 then
          CQ[Ri] = Q
          CM[Ri] = M
        end if
      end if
    end if
  next
  DrawRows(0, 1)
  Pending = 2
  return
end sub

' view rows A to B (drawn in three parts: rows 0-1 with the
' step, 2-4 and 5-6 on the next two passes, so that no pass runs past a frame)
sub DrawRows(u8 A, u8 B)
  u8 R
  u8 Cc
  for Ri = A to B
    R = Pr + Ri - 3
    ' the fast way for plain grass rows; CellKind for the shores, the sea
    ' and the grid places
    Hr = 0
    if R >= 9 then
      if R <= 118 then
        Hr = Ha[R]
        Fast = 1
        if RQ[Ri] < 255 then Fast = 0
      else
        Fast = 0
      end if
    else
      Fast = 0
    end if
    for Cj = 0 to 6
      Cc = Pc + Cj - 3
      K = 255
      if Fast = 1 then
        if Cc >= 9 then
          if Cc <= 118 then
            V = Hr ^ Hb[Cc]
            K = M3[V]
          end if
        end if
      end if
      if K = 255 then K = CellKind(R, Cc)
      K = K * 4 + 128
      J = Cj * 2
      RowBuf[J] = K
      RowBot[J] = K + 2
      inc J
      RowBuf[J] = K + 1
      RowBot[J] = K + 3
    next
    W16 = Ri * 64 + 98
    copy RowBuf count 14 to vram.name + W16
    W16 = W16 + 32
    copy RowBot count 14 to vram.name + W16
  next
  return
end sub

' the kind of the cell at map row R, column Cc (row Ri, column Cj drawn)
function CellKind(u8 R, u8 Cc) as u8
  u8 G
  u8 S
  if R < 8 then return 9
  if R > 119 then return 9
  if Cc < 9 then return 9
  if Cc > 118 then return 9
  if R = 8 then return M3[Ha[Cc]] + 3
  if R = 119 then return M3[Hb[Cc]] + 6
  if RQ[Ri] < 255 then
    if CQ[Cj] < 255 then
      G = RQ[Ri] * 5 + CQ[Cj]
      S = GS[G]
      V = S & 7
      if V = 4 then
        if S = 4 then
          if RM[Ri] = 0 then
            if CM[Cj] = 0 then return 13
          end if
        end if
      end if
      if V >= 1 then
        if V <= 3 then
          select case RM[Ri]
            case 0
              return SiteTop[CM[Cj]]
            case 2
              return SiteBot[CM[Cj]]
          end select
          if CM[Cj] <> 1 then return 9
          if S < 8 then return 10
          if V = 1 then return 12
          return 11
        end if
      end if
    end if
  end if
  V = Ha[R] ^ Hb[Cc]
  return M3[V]

' ---------------------------------------------------------------------------
' a new island: 19 different grid places drawn at random
sub MakeIsland:
  fill array GS with 0
  for Gk = 0 to 18
    Pick
    if Gk = 0 then
      GS[V] = 1
    else
      if Gk <= 6 then
        GS[V] = 2
        TrG[Gk - 1] = V
      else
        if Gk <= 12 then
          GS[V] = 3
        else
          GS[V] = 4
        end if
      end if
    end if
  next
  return
end sub

' V = a free grid place 0-49
sub Pick:
pk_again:
  Rand
  V = Rs & 63
  if V >= 50 then goto pk_again
  if GS[V] > 0 then goto pk_again
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' sprite 0 the map cursor (first, so the 4-sprites-per-line limit never hides
' it), sprites 1-4 the pirate (detail, shirt, skin, red). Where the cursor
' shares lines with the pirate, only the pirate's small red layer drops out.
sub DrawSprites:
  inc Blink
  if Blink >= 24 then Blink = 0
  if Blink < 16 then
    X = Sector(Pc) * 8 + 152
    Y = Sector(Pr) * 8 + 31
    set sprite 0 to Y,X,SCur,15
  else
    set sprite 0 to 192,0,0,0
  end if
  K = Walk * 16
  set sprite 1 to 71,64,SPd0 + K,1
  set sprite 2 to 71,64,SPw0 + K,15
  set sprite 3 to 71,64,SPp0 + K,9
  set sprite 4 to 71,64,SPr0 + K,6
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  ShowMsg(6)
  ShowScreen
  Seed0 = Rs
  MakeIsland
  Rearm
  wait
  nmi off
  display off
  print at 2,1, "ISLAND QUEST"
  fill TFrH count 14 at 2,2
  fill TFrH count 14 at 2,17
  print at 19,2, "SECTOR MAP"
  for J = 0 to 9
    put char J + 48 at 18,J + 4
    put char J + 65 at J + 19,3
    fill TMapc count 10 at 19,J + 4
  next
  print at 18,15, "TIME"
  print at 2,18, "BOOTY"
  print at 2,20, "CLUES"
  Pr = 9
  Pc = 9
  StepT = 0
  Walk = 0
  Booty = 0
  NClue = 0
  HomeOk = 0
  Over = 0
  Moves = 0
  Digs = 0
  Clk.Mins = 0
  Clk.Secs = 0
  Clk.Fr = 0
  ShowTime
  ShowBooty
  DrawView
  DrawRows(2, 6)
  Pending = 0
  fill 32 count 28 at 2,22
  MsgT = 0
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  GameOn = 1
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: ISLAND QUEST in sand letters on the sea, the pirate, the tune
sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 64
  print at 7,14, "AHOY! NOVEMBER 1988"
  print at 8,16, "BY BOB BLACKMER"
  print at 4,18, "SIX TREASURES. ONE HOME."
  print at 7,20, "PRESS THE BUTTON"
  if HaveBest = 1 then
    print at 9,22, "BEST ", digits$(Best.Mins, 2), ":", digits$(Best.Secs, 2)
  end if
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "ISLAND QUEST"
  print at 2,5, "BASED ON ISLAND QUEST BY"
  print at 2,6, "BOB BLACKMER, AHOY!"
  print at 2,7, "NOVEMBER 1988 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SHELL BEACH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
IqDig:
    db $00,$00,$15,$03,$00,$00,$36,$03,$00,$00,$55,$04,$10
IqThud:
    db $00,$00,$46,$02,$00,$00,$77,$03,$10
IqDirt:
    db $40,$3B,$22,$06,$40,$7F,$22,$06,$40,$F9,$32,$0C,$50
IqGold:
    db $40,$8F,$10,$04,$40,$71,$10,$04,$40,$5F,$10,$04,$40,$47,$10,$04,$40,$5F,$20,$04,$40,$47,$20,$10
    db $50
IqClue:
    db $40,$AA,$20,$05,$40,$7F,$20,$05,$40,$55,$20,$0C,$50
IqHome:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$12,$50
IqWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$10,$08,$40,$6B,$20,$1E
    db $50
IqOver:
    db $40,$1D,$11,$0C,$40,$41,$21,$0C,$40,$53,$21,$0C,$40,$AB,$31,$24,$50

IqSoundTable:
    dw IqTuneMel,$702B
    dw IqTuneBass,$7035
    dw IqDig,$703F
    dw IqThud,$703F
    dw IqDirt,$7049
    dw IqGold,$7049
    dw IqClue,$7049
    dw IqHome,$7049
    dw IqWin,$7049
    dw IqOver,$7049
; Shell Beach (original)
; Tiny Sound, 8 frames per step
IqTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$26,$01,$01,$28,$2A,$01,$28,$26,$01,$23
    db $21,$01,$01,$01,$26,$01,$2A,$01,$01,$2B,$2D,$01,$2B,$2A,$01,$28
    db $26,$01,$01,$01,$23,$01,$26,$01,$01,$28,$2A,$01,$26,$23,$01,$21
    db $1E,$01,$01,$01,$21,$01,$26,$01,$28,$01,$2A,$01,$28,$01,$25,$01
    db $26,$01,$01,$00
    db $FF
IqTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$0E,$01,$09,$01,$0E,$01,$09,$01,$07,$01,$0E,$01
    db $09,$01,$10,$01,$0E,$01,$09,$01,$0E,$01,$09,$01,$07,$01,$0B,$01
    db $09,$01,$01,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$0B,$01,$12,$01
    db $0E,$01,$09,$01,$09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$01,$01
    db $0E,$01,$01,$00
    db $FF
}
