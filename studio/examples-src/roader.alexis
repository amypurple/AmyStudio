cartridge "ROADER/PRESENTS BRIAN FOLEY'S/1984"

' ROADER
' By Brian Foley, COMPUTE! magazine, March 1984, page 74: versions for the
' Commodore 64, VIC-20, Atari, TI-99/4A, Apple, IBM PC and TRS-80 Color
' Computer. This port follows "Program 4: Roader For The TI-99/4A". All
' credit belongs to Brian Foley.
'
' Historical context (summary of the article):
' Drive a car down a winding road and dodge the hazards; the farther you
' go, the narrower the road, and the longer you stay on it, the higher your
' score. Four skill levels: 1 for the beginner, 2 faster with a more
' twisted road, 3 slower but with obstacles, 4 fast, curvy and with
' obstacles. Hit the side of the road or an obstacle and you hear three
' explosions, then your score. The TI version prints each new stretch of
' road at the bottom of the screen with PRINT TAB(8*COS(A)+10), so the
' whole screen scrolls; the road narrows from eight squares to five over
' four turns of the curve, four times over.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the joystick steers; the skill and play-again questions are
' joystick menus (keypad 1-4 also picks the skill).
' The rules follow the TI listing: the road's left edge at 8*COS(A)+10
' (lines 1090-1120), the step 0.1 (skills 1 and 3) or 0.2 (2 and 4), widths
' 8, 7, 6, 5 for each of four laps (lines 1050-1260). The TI listing put
' obstacles on half the rows for skills 3 and 4 (line 1130); this port spaces
' them for its larger 16-pixel car. A crash on the curb, the grass or an
' obstacle (line 1180), the score = rows x 10 x skill (line 1520).
' Adaptation liberties: the road comes from the top and the car drives up
' (the TI road scrolled up past a car going down); the car is a sprite that
' steers smoothly instead of a character; the obstacles appear on the road
' only; the curbs are red and white and seem to rush by; the lap and the
' score are shown while driving; a high score; a checkered finish line
' after the fourth lap; the speed rises a little each lap; Graphics II
' grass and road; an original driving theme (Tiny Sound) on the menus; the screen is scrolled with the VDP interrupt off; an
' editorial page.

const GrassTile = 128
const RoadTile = 129
const CurbA = 130
const CurbB = 131
const RockTile = 132
const FlagTile = 133
const CarY = 151               ' sprite Y: the car sits on row 19
const CarRow = 19

' Sound table slots (rd/s.mjs)
const SndHum = 1
const SndBoom = 2
const SndSiren = 3
const SndEngine = 4
const SndFinish = 5
const SndBeep = 6
const SndTuneA = 7
const SndTuneB = 8

u8 Skill = 1
u8 Lap = 1                     ' D
u8 Width = 8                   ' LEN(B$)
u8 A = 0                       ' position on the curve, 0-62
u8 AStep = 1                   ' I = 0.1 or 0.2
u8 RowFrames = 7
u8 Tick = 0
u8 Phase = 0                   ' curb stripes
u16 CarX16 = 0
u8 CarX = 0
u8 Col = 0
u8 L = 0
u8 T = 0
u8 N = 0
u8 X = 0
u8 Y = 0
u8 I = 0
u8 F = 0
u8 InitRow = 0
u8 ObstacleGap = 3
u8 Choice = 1
u16 Rows = 0                   ' J
bcd digits 6 Score
bcd digits 6 HighScore
bool Crash = false
bool Done = false
u16 Dst16 = 0
u16 NumU = 0

  tile screen
  set sound table RoaderSoundTable areas 4
  sprites 8x8
  sprites double
  copy CarSprites count 24 to vram.spr_pat
  HideCar
  LoadTiles
  screen on
  play sounds SndTuneA, SndTuneB
  EditorialPage

' --- Lines 310-530: title ---
title:
  nmi on
  TitlePage

' --- Lines 580-890: the skill ---
skill_menu:
  HideCar
  cls
  backdrop dark green
  print at 4,3, "ENTER YOUR SKILL LEVEL"
  print at 8,6, "NOVICE"
  print at 8,8, "PRO"
  print at 8,10, "EXPERT"
  print at 8,12, "PERFECT"
  print at 18,6, "SLOW"
  print at 18,8, "FAST, CURVY"
  print at 18,10, "OBSTACLES"
  print at 18,12, "ALL OF IT"
  print at 4,16, "HIGH SCORE"
  print HighScore at 16,16
  wait no fire
  Choice = Skill
  choose menu 1 to 4 into Choice cursor $3E at 6,6 step 2
  Skill = Choice
  play sound SndBeep
  print at 9,19, "HERE WE GO!!!"
  wait 60 frames

' --- Lines 930-1310: the drive ---
drive:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  ' Line 970: I = 0.2 for skills 2 and 4
  AStep = 1
  RowFrames = 12
  if Skill = 2 then
    AStep = 2
    RowFrames = 9
  end if
  if Skill = 4 then
    AStep = 2
    RowFrames = 9
  end if
  StartRoad
  play sound SndEngine

drive_loop:
  FrameUpdate
  if Crash then goto crashed
  if Done then goto made_it
  goto drive_loop

' --- Lines 1390-1520: the crash ---
crashed:
  nmi on
  mute all
  set sprite 0 to CarY,CarX,2,10
  hide sprite 1
  update sprites
  ' Lines 120-190, three times: noise and flashing
  for I = 1 to 3
    play sound SndBoom
    for F = 1 to 30
      N = F & 4
      if N = 0 then
        backdrop light red
        set sprite 0 color to 11
      else
        backdrop dark red
        set sprite 0 color to 9
      end if
      update sprites
      wait
    next
  next
  backdrop dark green
  goto score_screen

' --- Lines 1320-1380: YOU MADE IT ---
made_it:
  nmi on
  mute all
  play sound SndFinish
  ' The car drives off the top
  for Y = CarY to 0 step -3
    set sprite 0 to Y,CarX,0,8
    set sprite 1 to Y,CarX,1,15
    update sprites
    wait
  next
  HideCar
  cls
  backdrop light blue
  print at 7,10, "YOU MADE IT, MARIO !!"
  wait 120 frames

' --- Lines 1520-1700 ---
score_screen:
  HideCar
  cls
  backdrop dark green
  print at 8,6, "YOUR SCORE IS"
  print Score at 13,8
  if Score > HighScore then
    HighScore = Score
    print at 9,10, "NEW HIGH SCORE"
  end if
  print at 9,13, "PLAY AGAIN ?"
  print at 8,16, "SAME LEVEL"
  print at 8,17, "CHANGE LEVEL"
  wait 60 frames
  wait no fire
  Choice = 1
  choose menu 1 to 2 into Choice cursor $3E at 6,16 step 1
  if Choice = 1 then goto drive
  play sounds SndTuneA, SndTuneB
  goto skill_menu

' ---------------------------------------------------------------------------

' One video frame: steer, and every RowFrames frames a new row of road
sub FrameUpdate:
  nmi on
  wait
  nmi off
  ' Line 1240: steer (smoothly, 2 pixels a frame)
  if joypad(1).left then
    if CarX16 >= 320 then CarX16 -= 320
  end if
  if joypad(1).right then
    CarX16 += 320
    if CarX16 > 59392 then CarX16 = 59392
  end if
  Dst16 = CarX16 >> 8
  CarX = Dst16
  set sprite 0 to CarY,CarX,0,8
  set sprite 1 to CarY,CarX,1,15
  update sprites
  CheckCar
  if Crash then return
  inc Tick
  if Tick < RowFrames then return
  Tick = 0
  NextRow
  CheckCar
  return
end sub

' Line 1160-1180: what is under the car (its centre)
sub CheckCar:
  N = CarX + 8
  Col = N >> 3
  T = get char at Col,CarRow
  if T = RoadTile then return
  if T = FlagTile then
    Done = true
    return
  end if
  Crash = true
  return
end sub

' Lines 1100-1150: the screen moves down a row and a new stretch of road
' appears at the top
sub NextRow:
  copy vram.name + 674 count 28 to vram.name + 706
  copy vram.name + 642 count 28 to vram.name + 674
  copy vram.name + 610 count 28 to vram.name + 642
  copy vram.name + 578 count 28 to vram.name + 610
  copy vram.name + 546 count 28 to vram.name + 578
  copy vram.name + 514 count 28 to vram.name + 546
  copy vram.name + 482 count 28 to vram.name + 514
  copy vram.name + 450 count 28 to vram.name + 482
  copy vram.name + 418 count 28 to vram.name + 450
  copy vram.name + 386 count 28 to vram.name + 418
  copy vram.name + 354 count 28 to vram.name + 386
  copy vram.name + 322 count 28 to vram.name + 354
  copy vram.name + 290 count 28 to vram.name + 322
  copy vram.name + 258 count 28 to vram.name + 290
  copy vram.name + 226 count 28 to vram.name + 258
  copy vram.name + 194 count 28 to vram.name + 226
  copy vram.name + 162 count 28 to vram.name + 194
  copy vram.name + 130 count 28 to vram.name + 162
  copy vram.name + 98 count 28 to vram.name + 130
  copy vram.name + 66 count 28 to vram.name + 98
  ' A lap ends with a checkered line; after the fourth, the finish
  if A >= 63 then
    A = 0
    if Width > 5 then
      dec Width
    else
      Width = 8
      ' The finish line is already entering at the top. Keep scrolling until
      ' CheckCar sees it under the car instead of ending the race immediately.
      if Lap < 4 then
        inc Lap
        ' Adaptation: a little faster each lap
        if RowFrames > 6 then dec RowFrames
        play sound SndHum
        ShowStatus
      end if
    end if
  end if
  L = CurveCol[A]
  A += AStep
  ' Line 1120: grass, curb, road, curb, grass
  fill GrassTile count 28 at 2,2
  T = CurbA
  N = Phase & 1
  if N = 1 then T = CurbB
  inc Phase
  put char T at L,2
  X = L + 1
  fill RoadTile count Width at X,2
  X += Width
  put char T at X,2
  if Lap = 4 then
    if Width = 5 then
      if A >= 62 then
        X = L + 1
        fill FlagTile count Width at X,2
      end if
    end if
  end if
  ' Line 1130 used a 50% chance for a character-sized TI car. The Coleco car
  ' is 16 pixels tall, so leave at least three rows and then use a 25% chance.
  if ObstacleGap < 255 then inc ObstacleGap
  if Skill >= 3 then
    if Rows > 24 then
      if ObstacleGap >= 3 then
        N = random(0, 3)
        if N = 0 then
          N = Width - 1
          N = random(0, N)
          X = L + 1
          X += N
          put char RockTile at X,2
          ObstacleGap = 0
        end if
      end if
    end if
  end if
  ' Line 1520: 10 x skill per row
  inc Rows
  for I = 1 to Skill
    Score += 10
  next
  ShowScore
  return
end sub

sub StartRoad:
  nmi off
  HideCar
  cls
  backdrop dark green
  for Y = 2 to 22
    fill GrassTile count 28 at 2,Y
  next
  Lap = 1
  Width = 8
  A = 0
  Rows = 0
  Score = 0
  Crash = false
  Done = false
  ObstacleGap = 3
  Tick = 0
  ' The first screenful of road
  for InitRow = 1 to 21
    NextRow
  next
  Rows = 0
  Score = 0
  ' The car in the middle of the road on its row
  T = get char at 2,CarRow
  for X = 2 to 29
    T = get char at X,CarRow
    if T = RoadTile then
      N = X + 2
      goto car_place
    end if
  next
  N = 14
car_place:
  N <<= 3
  N -= 8
  CarX16 = N
  CarX16 <<= 8
  Dst16 = CarX16 >> 8
  CarX = Dst16
  ShowStatus
  nmi on
  return
end sub

sub ShowStatus:
  fill 32 count 28 at 2,1
  print at 2,1, "SCORE"
  ShowScore
  print at 16,1, "LAP"
  NumU = Lap
  print at 20,1, digits$(NumU, 1)
  print at 22,1, "SKILL"
  NumU = Skill
  print at 28,1, digits$(NumU, 1)
  return
end sub

sub ShowScore:
  print Score at 8,1
  return
end sub

sub HideCar:
  clear sprites
  set sprite count 2
  update sprites
  return
end sub

sub LoadTiles:
  fill mode 2 text color with $F0
  Dst16 = 1024
  for F = 0 to 2
    copy TilePat count 48 to vram.pattern + Dst16
    copy TileCol count 48 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

' Lines 310-530: the title, the instructions and the siren
sub TitlePage:
  HideCar
  cls
  backdrop light green
  print at 9,4, "R O A D E R"
  print at 4,8, "STEER WITH THE JOYSTICK."
  print at 4,10, "STAY ON THE ROAD: IT GETS"
  print at 4,11, "NARROWER AND NARROWER."
  put char RockTile at 4,13
  print at 6,13, "OBSTACLES ON LEVELS 3, 4."
  print at 4,15, "FOUR LAPS TO THE FINISH."
  play sound SndSiren
  print at 5,20, "PRESS FIRE TO START"
  wait no fire
  pause until press
  wait no fire
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 12,1, "ROADER"
  print at 8,3, "BY BRIAN FOLEY"
  print at 5,4, "COMPUTE! MARCH 1984"
  print at 2,6, "FOR THE 64, VIC, ATARI, TI,"
  print at 2,7, "APPLE, IBM PC AND COLOR"
  print at 2,8, "COMPUTER."
  print at 2,10, "THE TI VERSION PRINTED EACH"
  print at 2,11, "NEW ROW OF ROAD AT THE"
  print at 2,12, "BOTTOM OF THE SCREEN AND"
  print at 2,13, "LET PRINT SCROLL IT. THE"
  print at 2,14, "CURVE IS 8 * COS(A) + 10."
  print at 2,16, "THE LONGER YOU STAY ON THE"
  print at 2,17, "ROAD, THE HIGHER YOUR SCORE."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  fill mode 2 text color with $F0
  LoadTiles
  return
end sub

' Lines 1090-1120: TAB(8*COS(A)+10) for A = 0 to 6.2 step 0.1: the
' column of the road's left edge
data CurveCol bytes
  18,18,18,18,17,17,17,16,16,15,14,14,13,12,11,11,10,9,8,7,7
  6,5,5,4,4,3,3,2,2,2,2,2,2,2,3,3,3,4,4,5,5
  6,7,8,8,9,10,11,11,12,13,14,14,15,16,16,17,17,17,18,18,18
end data

' Tiles 128-133: grass, road, curb (two phases), obstacle (TI char 128),
' finish line
data TilePat bytes
  $00,$44,$00,$11,$00,$88,$00,$22
  $00,$00,$08,$00,$00,$00,$40,$00
  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
  $3C,$7E,$FF,$DB,$FF,$FF,$7E,$3C
  $AA,$55,$AA,$55,$AA,$55,$AA,$55
end data

' Their colors, one byte per pixel row
data TileCol bytes
  $3C,$3C,$3C,$3C,$3C,$3C,$3C,$3C
  $E1,$E1,$E1,$E1,$E1,$E1,$E1,$E1
  $F0,$F0,$F0,$F0,$80,$80,$80,$80
  $80,$80,$80,$80,$F0,$F0,$F0,$F0
  $A1,$A1,$91,$91,$91,$61,$61,$61
  $F1,$F1,$F1,$F1,$F1,$F1,$F1,$F1
end data

' Sprites: car body, car windscreen and wheels, explosion
data CarSprites bytes
  $18,$3C,$7E,$3C,$3C,$7E,$7E,$3C
  $00,$00,$81,$18,$00,$81,$81,$00
  $91,$52,$3C,$7E,$7E,$3C,$4A,$89
end data

asm {
HumT1:
    db $40,$F9,$13,$01,$40,$F4,$13,$01,$40,$F0,$13,$01,$40,$EB,$13,$01,$40,$E7,$13,$01,$40,$E2,$13,$01
    db $40,$DE,$13,$01,$40,$DA,$13,$01,$40,$D5,$13,$01,$40,$D1,$13,$01,$40,$CD,$13,$01,$40,$C8,$13,$01
    db $40,$C4,$13,$01,$40,$C0,$13,$01,$40,$BC,$13,$01,$40,$B8,$13,$01,$40,$B4,$13,$01,$40,$B0,$13,$01
    db $40,$AC,$13,$01,$40,$A8,$13,$01,$40,$A4,$13,$01,$40,$A0,$13,$01,$40,$9C,$13,$01,$40,$99,$13,$01
    db $40,$95,$13,$01,$40,$91,$13,$01,$40,$8D,$13,$01,$40,$8A,$13,$01,$40,$86,$13,$01,$40,$82,$13,$01
    db $40,$7F,$13,$01,$50
BoomN:
    db $00,$00,$16,$04,$00,$00,$26,$04,$00,$00,$36,$04,$00,$00,$46,$04,$00,$00,$56,$04,$00,$00,$66,$04
    db $00,$00,$76,$04,$00,$00,$86,$04,$00,$00,$96,$04,$00,$00,$A6,$04,$00,$00,$B6,$04,$00,$00,$C6,$04
    db $00,$00,$D6,$04,$00,$00,$E6,$04,$00,$00,$F6,$04,$10
SirenT1:
    db $40,$F9,$13,$02,$40,$F4,$13,$02,$40,$F0,$13,$02,$40,$EB,$13,$02,$40,$E7,$13,$02,$40,$E2,$13,$02
    db $40,$DE,$13,$02,$40,$DA,$13,$02,$40,$D5,$13,$02,$40,$D1,$13,$02,$40,$CD,$13,$02,$40,$C8,$13,$02
    db $40,$C4,$13,$02,$40,$C0,$13,$02,$40,$BC,$13,$02,$40,$B8,$13,$02,$40,$B4,$13,$02,$40,$B0,$13,$02
    db $40,$AC,$13,$02,$40,$A8,$13,$02,$40,$A4,$13,$02,$40,$A4,$13,$02,$40,$A7,$13,$02,$40,$A9,$13,$02
    db $40,$AB,$13,$02,$40,$AE,$13,$02,$40,$B0,$13,$02,$40,$B2,$13,$02,$40,$B5,$13,$02,$40,$B7,$13,$02
    db $40,$BA,$13,$02,$40,$BC,$13,$02,$40,$BF,$13,$02,$40,$C1,$13,$02,$40,$C3,$13,$02,$40,$C6,$13,$02
    db $40,$C8,$13,$02,$40,$CB,$13,$02,$40,$CE,$13,$02,$40,$D0,$13,$02,$40,$D3,$13,$02,$40,$D5,$13,$02
    db $40,$D8,$13,$02,$40,$DA,$13,$02,$40,$DD,$13,$02,$40,$E0,$13,$02,$40,$E2,$13,$02,$40,$E5,$13,$02
    db $40,$E8,$13,$02,$40,$EA,$13,$02,$40,$ED,$13,$02,$40,$F0,$13,$02,$40,$F2,$13,$02,$40,$F5,$13,$02
    db $40,$F8,$13,$02,$50
EngineN:
    db $00,$00,$62,$FF,$10
FinishT1:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$18,$50
BeepT1:
    db $40,$50,$00,$0C,$50

RoaderSoundTable:
    dw HumT1,$7035
    dw BoomN,$702B
    dw SirenT1,$7035
    dw EngineN,$702B
    dw FinishT1,$7035
    dw BeepT1,$7035
    dw RoaderTuneMel,$703F
    dw RoaderTuneBass,$7049
; Title tune: the driving theme (original for this port)
; in two phrases, with dynamics; Tiny Sound, 9 frames per step
RoaderTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$30,$1A,$21,$1A,$1A,$1E,$21,$00,$1E,$1A,$00,$1C,$1C,$1F,$23
    db $00,$1F,$1C,$00,$1A,$1E,$21,$26,$00,$25,$23,$21,$1F,$1E,$1C,$1A
    db $00,$00,$01,$01,$02,$10,$1A,$21,$23,$00,$21,$00,$1F,$1E,$1C,$00
    db $21,$00,$1F,$00,$1E,$1C,$1A,$00,$02,$30,$1A,$21,$1C,$1E,$1F,$21
    db $23,$00,$21,$1F,$02,$60,$1A,$21,$1E,$1C,$1A,$19,$1A,$00,$00,$01
    db $FF
RoaderTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$50,$18,$32,$0E,$00,$15,$00,$0E,$00,$15,$00,$10,$00,$17,$00
    db $10,$00,$17,$00,$0E,$00,$15,$00,$0E,$00,$15,$00,$13,$00,$15,$00
    db $0E,$00,$00,$00,$02,$30,$18,$32,$13,$00,$0E,$00,$13,$00,$0E,$00
    db $15,$00,$10,$00,$15,$00,$10,$00,$02,$50,$18,$32,$13,$00,$0E,$00
    db $13,$00,$15,$00,$02,$80,$18,$32,$0E,$00,$15,$00,$0E,$00,$00,$01
    db $FF
}
