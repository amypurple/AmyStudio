  69, 67, 75, 73, 78, 71, 68, 69, 84, 65, 73, 78, 73, 78, 71, 69, 78, 67, 76, 79
  83, 73, 78, 71, 73, 77, 80, 79, 85, 78, 68, 73, 78, 71, 72, 65, 78, 68, 67, 85
  70, 70, 73, 78, 71, 77, 85, 90, 90, 76, 73, 78, 71, 71, 65, 71, 71, 73, 78, 71
  83, 85, 80, 80, 82, 69, 83, 83, 73, 78, 71
end data

' the keyboard: 30 keys (1 = DEL, 2 = END)
data KeyCh bytes 65,66,67,68,69,70,71,72,73,74, 75,76,77,78,79,80,81,82,83,84, 85,86,87,88,89,90,39,32,1,2

' Celebrate: three bursts of eight sparks (the directions, the colours)
data CbDx bytes 0,3,4,3,0,253,252,253
data CbDy bytes 252,253,0,3,4,3,0,253
data CbCol bytes 15,11,9,13,7,10,8,14
u8 CbX[8]
u8 CbY[8]
u8 CbK = 0
u8 CbT = 0
u8 CbN = 0
u8 CbC = 0
u8 CbV = 0

' text buffers: what you typed, the working copy, the answer, a string
u8 In[52]
u8 Ab[56]
u8 Ob[128]
u8 Tb[48]
u8 Nm[12]
u8 Il = 0
u8 Al = 0
u8 Ol = 0
u8 Tl = 0
u8 Nl = 0
u8 Si = 0
u8 Fp = 0
u8 Kl = 0
u8 Mx = 50
u8 Kx = 0
u8 Ky = 0
u8 Wr = 0
u8 P = 0
u8 E = 0
u8 Q = 0
u8 Z = 0
u8 Blink = 0

' ELECTRONIC BRAIN
u16 C[10]
u8 Bg[4]
u8 Eb[4]
u8 Guess = 0
u8 Qn = 9
u8 Aid = 0
u8 Nb = 0
u8 Nw = 0
u8 D1 = 0
u8 D2 = 0
u16 Tries = 0
u16 Mw = 0

' PROBOSCIDEAN
u8 Cd[52]
u8 St[52]
' the computer's memory of cards (also ELECTRONIC BRAIN's past guesses)
u8 Dm[64]
u8 R = 1
u8 Hs = 0
u8 Cs = 0
u8 Lvl = 5
u8 Ca = 0
u8 Cb = 0
u8 Cur = 0
u8 Sh = 0
' Mode: 1 while a card is being picked, 2 when a verse is finished (for the tests)
u8 Mode = 0

' scratch
u16 Uw = 0
u16 Ub = 0
u16 NumU = 0
u16 Rs = $3C5A
u16 Rt = 0
u8 Rb = 0
u8 Nr = 0
u8 Res = 0
u8 Ka = 0
u8 Kc = 0

' input and menus
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table TmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then goto brain
  if Menu = 2 then goto cards
  if Menu = 3 then goto poems
  if Menu = 4 then
    RulesPage
    goto title
  end if
  if Menu = 5 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' ELIZA

eliza:
  ElzScreen
  print at 2,5, "WELCOME TO ANOTHER SESSION"
  print at 2,6, "WITH YOUR COMPUTER"
  print at 2,7, "PSYCHIATRIST, ELIZA"
  print at 2,9, "WHAT IS YOUR FIRST NAME?"
  Mx = 10
  TypeLine
  if Res = 1 then goto title
  for K = 0 to 11
    Nm[K] = In[K]
  next
  Nl = Il
  ElzClear
  print at 2,5, "WELL, HI THERE"
  ElzName
  print at 2,7, "IT SURE IS NEAT TO HAVE YOU"
  print at 2,8, "DROP BY"
  print at 2,10, "TYPE WHAT IS ON YOUR MIND."
  Mx = 50
el_turn:
  TypeLine
  if Res = 1 then goto title
  if Il = 0 then goto el_turn
  play sound SndHum
  ' the book: BYE ends the session
  if Il >= 3 then
    if In[0] = 66 then
      if In[1] = 89 then
        if In[2] = 69 then
          ElzClear
          print at 2,5, "BYE BYE FOR NOW."
          print at 2,7, "SEE YOU AGAIN SOME TIME."
          Celebrate
          EndWait
          if Res = 0 then goto eliza
          goto title
        end if
      end if
    end if
  end if
  ElzAnswer
  ElzClear
  Wr = 5
  WrapOut
  goto el_turn

' ---------------------------------------------------------------------------
' ELECTRONIC BRAIN

brain:
  NewScreen
  backdrop dark blue
  print at 2,1, "ELECTRONIC BRAIN"
  BrainPic
  print at 9,3, "THINK OF A CODE OF THREE"
  print at 9,4, "DIFFERENT DIGITS, 1 TO 9."
  print at 9,6, "I WILL TRY TO CRACK IT."
  print at 2,9, "A BLACK: A RIGHT DIGIT IN"
  print at 2,10, "THE RIGHT PLACE."
  print at 2,11, "A WHITE: A RIGHT DIGIT IN"
  print at 2,12, "THE WRONG PLACE."
  print at 2,14, "WRITE IT DOWN, AND DON'T"
  print at 2,15, "TELL ME!"
  ShowScreen
  GoOn
  if Res = 1 then goto title
  NewScreen
  backdrop dark blue
  print at 2,1, "ELECTRONIC BRAIN"
  BrainPic
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  ' the book's start: Q = 9, C(Z) = Z, no aid
  for K = 1 to 9
    C[K] = K
  next
  Qn = 9
  Aid = 0
  Guess = 0
  Nw = 0
br_guess:
  ' the first three guesses are 1 2 3, 4 5 6, 7 8 9
  if Guess < 3 then
    V = Guess * 3
    Bg[1] = V + 1
    Bg[2] = V + 2
    Bg[3] = V + 3
  else
    BrThink
    BrPick
    if Res = 1 then
      HideSprites
      play sound SndLose
      BrSay
      print at 2,18, "NO CODE FITS YOUR ANSWERS."
      print at 2,19, "I THINK YOU MAY HAVE MADE A"
      print at 2,20, "MISTAKE IN THE SCORING!"
      EndWait
      if Res = 0 then goto brain
      goto title
    end if
  end if
  HideSprites
  inc Guess
  ' remember it
  V = Guess - 1
  V = V * 3
  Dm[V] = Bg[1]
  inc V
  Dm[V] = Bg[2]
  inc V
  Dm[V] = Bg[3]
  BrShowGuess
  ' your answers
  BrSay
  print at 2,18, "HOW MANY BLACKS?"
  Nb = 0
  Ka = 3
  NumPick
  if Res = 1 then goto title
  Nb = Kc
  if Nb = 3 then
    play sound SndWin
    BrSay
    print at 2,18, "I GUESSED YOUR CODE OF"
    for K = 1 to 3
      V = K << 1
      V = V + 24
      NumU = Bg[K]
      print at V,18, width$(NumU, 1)
    next
    print at 2,19, "IN JUST"
    NumU = Guess
    print at 10,19, width$(NumU, 2)
    print at 13,19, "GUESSES!"
    Celebrate
    EndWait
    if Res = 0 then goto brain
    goto title
  end if
  Nw = 0
  if Nb < 2 then
    print at 2,19, "AND HOW MANY WHITES?"
    Ka = 3 - Nb
    NumPick
    if Res = 1 then goto title
    Nw = Kc
  end if
  BrHistory
  ' the book's lines 190-260
  V = Nb + Nw
  if V = 3 then
    Qn = 3
    C[1] = Bg[1]
    C[2] = Bg[2]
    C[3] = Bg[3]
  end if
  if V = 0 then
    for K = 1 to 3
      W = Bg[K]
      C[W] = 0
    next
    goto br_guess
  end if
  if Nb > Aid then
    for K = 1 to 3
      Eb[K] = Bg[K]
    next
    Aid = Nb
  end if
  ' the weight: (B + W) x 100 + W x 10, to each C(Z) equal to a digit
  Mw = Nb + Nw
  Mw = Mw * 100
  Uw = Nw
  Uw = Uw * 10
  Mw = Mw + Uw
  for Z = 1 to 9
    for K = 1 to 3
      Uw = Bg[K]
      if C[Z] = Uw then C[Z] = C[Z] + Mw
    next
  next
  goto br_guess

' ---------------------------------------------------------------------------
' PROBOSCIDEAN

cards:
  NewScreen
  backdrop dark green
  print at 2,1, "PROBOSCIDEAN"
  print at 2,4, "PLEASE STAND BY, CARD-SHARP!"
  print at 2,6, "START FLEXING THOSE MEMORY"
  print at 2,7, "MUSCLES..."
  print at 2,10, "WHAT LEVEL OF DIFFICULTY?"
  print at 2,11, "(10 IS EASY, 1 IS ALMOST"
  print at 2,12, "IMPOSSIBLE!)"
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  ' the book: 52 cards, the Moses/Oakford shuffle
  for K = 0 to 51
    Cd[K] = K
    St[K] = 0
  next
  for K = 51 to 1 step -1
    Nr = K + 1
    RndN
    W = Cd[V]
    Cd[V] = Cd[K]
    Cd[K] = W
  next
  print at 2,14, "LEVEL:"
  Kc = Lvl
  Ka = 10
  Wr = 14
  LevelPick
  if Res = 1 then goto title
  Lvl = Kc
  Hs = 0
  Cs = 0
  R = 1
  NewScreen
  backdrop dark green
  print at 2,1, "PROBOSCIDEAN"
  for K = 0 to 51
    Sh = 0
    CardDraw
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  Cur = 0
pb_turn:
  PbScore
  if Hs + Cs >= 26 then goto pb_end
  ' your two cards
  PbSay
  print at 2,18, "PICK YOUR FIRST CARD"
  PickCard
  if Res = 1 then goto title
  Ca = Cur
  K = Ca
  Sh = 1
  CardDraw
  play sound SndFlip
  print at 2,18, "AND YOUR SECOND CARD"
pb_two:
  PickCard
  if Res = 1 then goto title
  if Cur = Ca then
    play sound SndBad
    goto pb_two
  end if
  Cb = Cur
  K = Cb
  Sh = 1
  CardDraw
  play sound SndFlip
  HideSprites
  PbSay
  V = Cd[Ca] % 13
  W = Cd[Cb] % 13
  if V = W then
    play sound SndGood
    print at 2,18, "YES, THEY ARE A PAIR"
    St[Ca] = 1
    St[Cb] = 1
    inc Hs
  else
    print at 2,18, "NO, THEY ARE NOT A PAIR"
    PbForget
  end if
  Pause
  PbScore
  if Hs + Cs >= 26 then goto pb_end
  ' the computer
  PbSay
  print at 2,18, "MY TURN..."
  for J = 1 to 30
    Frame1
  next
  PbChoose
  if Res = 1 then goto pb_end
  ' show its choice
  for I = 0 to 1
    K = Ca
    if I = 1 then K = Cb
    CardXY
    Sx = X << 3
    Sy = Y << 3
    Sy = Sy - 1
    set sprite I to Sy, Sx, SCardring, 11
    update sprites
    Sh = 1
    CardDraw
    play sound SndFlip
    for J = 1 to 25
      Frame1
    next
  next
  PbSay
  print at 2,18, "I'VE SELECTED TWO CARDS"
  V = Cd[Ca] % 13
  W = Cd[Cb] % 13
  if V = W then
    play sound SndHum
    print at 2,19, "AND I'VE PICKED A PAIR!"
    St[Ca] = 1
    St[Cb] = 1
    inc Cs
  else
    print at 2,19, "BUT THEY'RE NOT A PAIR!"
    PbForget
  end if
  Pause
  HideSprites
  goto pb_turn
pb_end:
  HideSprites
  PbScore
  PbSay
  print at 2,18, "THAT BRINGS US TO THE END OF"
  print at 2,19, "A ROUND OF PROBOSCIDEAN!"
  if Hs > Cs then
    print at 2,20, "YOU'RE THE WINNER, HUMAN!"
    play sound SndWin
    Celebrate
  end if
  if Cs > Hs then
    print at 2,20, "I'M THE WINNER, HUMAN!"
    play sound SndLose
  end if
  if Cs = Hs then
    print at 2,20, "IT'S A DRAW, HUMANOID!"
    play sound SndHum
  end if
  EndWait
  if Res = 0 then goto cards
  goto title

' ---------------------------------------------------------------------------
' AMANUENSIS

poems:
  NewScreen
  backdrop light yellow
  fill mode 2 text color with $1B
  print at 2,1, "AMANUENSIS"
  fill TPtop count 32 at 0,2
  fill TPbot count 32 at 0,20
  print at 2,22, "BUTTON: NEXT  2ND: MENU"
  ShowScreen
pm_verse:
  Mode = 0
  for Y = 3 to 19
    fill 32 count 28 at 2,Y
  next
  Wr = 4
  ' the book: THE (1) (2) (3) / IN THE (4) ... / (5) FOR (6), /
  ' TO (7) THE (8) ... / (9), THEN (10) / ... (11), (12).
  Ol = 0
  AddLit3
  PmWord1
  AddSpace
  Si = 1
  PmWordAdd
  AddSpace
  Si = 2
  PmWordAdd
  PmLine
  if Res = 1 then goto title
  Ol = 0
  AddSpace
  AddSpace
  AddIn
  AddSpace
  AddThe
  Si = 3
  PmWordAdd
  AddDots
  PmLine
  if Res = 1 then goto title
  Ol = 0
  Si = 4
  PmWordAdd
  AddFor
  Si = 5
  PmWordAdd
  V = 44
  AddCh
  PmLine
  if Res = 1 then goto title
  Ol = 0
  AddSpace
  AddSpace
  AddTo
  Si = 6
  PmWordAdd
  AddSpace
  AddThe
  Si = 7
  PmWordAdd
  AddDots
  PmLine
  if Res = 1 then goto title
  Ol = 0
  Si = 8
  PmWordAdd
  AddThen
  Si = 9
  PmWordAdd
  PmLine
  if Res = 1 then goto title
  Ol = 0
  AddSpace
  AddSpace
  V = 46
  AddCh
  AddCh
  AddCh
  AddSpace
  Si = 10
  PmWordAdd
  V = 44
  AddCh
  AddSpace
  ' the twelfth word comes from the tenth list again (the book's line 200)
  Si = 9
  PmWordAdd
  V = 46
  AddCh
  PmLine
  if Res = 1 then goto title
  HideSprites
  Mode = 2
  play sound SndHum
  ' a new verse after a while, or at the button
  WasBtn = 1
  WasBtn2 = 1
  for Uw = 1 to 360
    Frame1
    Rnd
    ReadPad
    if Press2 = 1 then goto title
    if Press = 1 then Uw = 360
  next
  goto pm_verse

' ---------------------------------------------------------------------------
' ELIZA helpers

sub ElzScreen:
  NewScreen
  backdrop black
  print at 2,1, "ELIZA"
  V = TMon00
  Blink = 0
  ElzFace
  ' the keyboard
  for K = 0 to 29
    KeyDraw
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  return
end sub

' ElzFace: ELIZA's monitor (4 x 3 tiles) at 24,1, eyes open or shut
sub ElzFace:
  V = TMon00
  if Blink = 1 then V = TMons00
  for Y = 1 to 3
    for X = 24 to 27
      put char V at X,Y
      inc V
    next
  next
  return
end sub

' ElzClear: the answer rows
sub ElzClear:
  for Y = 5 to 10
    fill 32 count 28 at 2,Y
  next
  return
end sub

' ElzName: your name after the text on row 5
sub ElzName:
  X = 17
  for K = 0 to Nl - 1
    V = Nm[K]
    put char V at X,5
    inc X
  next
  return
end sub

' KeyXY: key K at column X, row Y
sub KeyXY:
  V = K
  Y = 15
  if V >= 10 then
    V = V - 10
    Y = 17
  end if
  if V >= 10 then
    V = V - 10
    Y = 19
  end if
  X = V << 1
  X = X + 4
  if K = 28 then X = 21
  if K = 29 then X = 25
  return
end sub

sub KeyDraw:
  KeyXY
  V = KeyCh[K]
  if V = 1 then
    print at X,Y, "DEL"
    return
  end if
  if V = 2 then
    print at X,Y, "END"
    return
  end if
  if V = 32 then
    print at X,Y, "SP"
    return
  end if
  put char V at X,Y
  return
end sub

' TypeLine: In[0..Il) from the keyboard, up to Mx characters, shown on
' rows 12-13; END finishes; Res 1 for the second button
sub TypeLine:
  Il = 0
  for K = 0 to 51
    In[K] = 32
  next
  fill 32 count 28 at 2,12
  fill 32 count 28 at 2,13
  print at 2,12, ">"
  Kx = 0
  Ky = 0
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
tl_loop:
  if Res = 1 then
    K = Ky * 10
    K = K + Kx
    KeyXY
    Sx = X << 3
    Sx = Sx - 4
    V = KeyCh[K]
    if V < 3 then Sx = Sx + 8
    Sy = Y << 3
    Sy = Sy - 1
    set sprite 0 to Sy, Sx, SRing, 11
    ' the cursor after the text
    TlXY
    set sprite 1 to Sy, Sx, SRing, 2
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ' ELIZA blinks now and then
  V = Tick & 127
  if V = 0 then
    Blink = 1
    ElzFace
  end if
  if V = 8 then
    Blink = 0
    ElzFace
  end if
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Kx > 0 then dec Kx
    end if
    if Rt1 = 1 then
      if Kx < 9 then inc Kx
    end if
    if Up1 = 1 then
      if Ky > 0 then dec Ky
    end if
    if Dn1 = 1 then
      if Ky < 2 then inc Ky
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    HideSprites
    Res = 1
    return
  end if
  if Press = 0 then goto tl_loop
  Res = 1
  K = Ky * 10
  K = K + Kx
  V = KeyCh[K]
  if V = 2 then
    if Il > 0 then
      HideSprites
      Res = 0
      return
    end if
    play sound SndBad
    goto tl_loop
  end if
  if V = 1 then
    if Il > 0 then
      dec Il
      In[Il] = 32
      TlChar
      play sound SndKey
    end if
    goto tl_loop
  end if
  if Il >= Mx then
    play sound SndBad
    goto tl_loop
  end if
  In[Il] = V
  TlChar
  inc Il
  play sound SndKey
  goto tl_loop
end sub

' TlXY: the screen place of character Il of the line (Sx, Sy in pixels)
sub TlXY:
  V = Il
  W = 12
  if V >= 26 then
    V = V - 26
    W = 13
  end if
  V = V + 4
  Sx = V << 3
  Sx = Sx - 4
  Sy = W << 3
  Sy = Sy - 1
  return
end sub

' TlChar: character Il of the line drawn
sub TlChar:
  V = Il
  W = 12
  if V >= 26 then
    V = V - 26
    W = 13
  end if
  V = V + 4
  Kc = In[Il]
  put char Kc at V,W
  return
end sub

' LoadStr: ELIZA string Si into Tb[0..Tl)
sub LoadStr:
  Uw = ElzOff[Si]
  Tl = ElzLen[Si]
  copy ElzText + Uw count Tl to Tb
  return
end sub

' FindTb: the first place of Tb in Ab (Fp, 255 if none)
sub FindTb:
  Fp = 255
  if Tl > Al then return
  E = Al - Tl
  for P = 0 to E
    Res = 1
    for J = 0 to Tl - 1
      W = P + J
      if Ab[W] <> Tb[J] then
        Res = 0
        J = Tl
      end if
    next
    if Res = 1 then
      Fp = P
      return
    end if
  next
  return
end sub

' AddTb: Tb added to the answer
sub AddTb:
  for J = 0 to Tl - 1
    Ob[Ol] = Tb[J]
    inc Ol
  next
  return
end sub

sub AddSpace:
  V = 32
sub AddCh:
  Ob[Ol] = V
  inc Ol
  return
end sub

' ElzAnswer: the book's lines 160-470: the answer in Ob[0..Ol)
sub ElzAnswer:
  ' Ab = " " + the sentence + " ", BECAUSE taken off its front
  Ka = 0
  if Il >= 7 then
    if In[0] = 66 then
      if In[1] = 69 then
        if In[2] = 67 then
          if In[3] = 65 then
            if In[4] = 85 then
              if In[5] = 83 then
                if In[6] = 69 then Ka = 7
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  Ab[0] = 32
  Al = 1
  for K = Ka to Il - 1
    Ab[Al] = In[K]
    inc Al
  next
  Ab[Al] = 32
  inc Al
  Ol = 0
  ' one time in five, your name first
  Rnd
  if Rb < 51 then
    for K = 0 to Nl - 1
      V = Nm[K]
      AddCh
    next
    V = 44
    AddCh
    AddSpace
  end if
  for Z = 0 to 34
    Si = Z
    LoadStr
    FindTb
    if Fp < 255 then goto ea_found
  next
  ' no key word: one of the eleven
  Nr = 11
  RndN
  Si = V + 70
  LoadStr
  AddTb
  return
ea_found:
  Kl = Tl
  Si = Z + 35
  LoadStr
  AddTb
  V = Tb[Tl - 1]
  if V < 65 then return
  AddSpace
  ' the rest of the sentence, after the key word and its space
  E = Fp + Kl
  inc E
  if E >= Al then return
  W = 0
  for K = E to Al - 1
    Ab[W] = Ab[K]
    inc W
  next
  Al = W
  ' the first of the book's eight conjugations found is turned round
  for Z = 0 to 7
    Si = Z + 81
    LoadStr
    FindTb
    if Fp < 255 then goto ea_conj
  next
  for K = 0 to Al - 1
    V = Ab[K]
    AddCh
  next
  return
ea_conj:
  Kl = Tl
  if Fp > 0 then
    for K = 0 to Fp - 1
      V = Ab[K]
      AddCh
    next
  end if
  AddSpace
  Si = Z + 89
  LoadStr
  AddTb
  E = Fp + Kl
  dec E
  for K = E to Al - 1
    V = Ab[K]
    AddCh
  next
  return
end sub

' WrapOut: Ob[0..Ol) printed from row Wr, 28 columns, broken at spaces
sub WrapOut:
  ' no spaces at the end
wo_trim:
  if Ol > 0 then
    K = Ol - 1
    if Ob[K] = 32 then
      dec Ol
      goto wo_trim
    end if
  end if
  P = 0
wo_line:
  if P >= Ol then return
  if Ob[P] = 32 then
    inc P
    goto wo_line
  end if
  E = P + 28
  if E < Ol then
    K = E
wo_back:
    if K > P then
      if Ob[K] <> 32 then
        dec K
        goto wo_back
      end if
    end if
    if K > P then E = K
  else
    E = Ol
  end if
  X = 2
  for K = P to E - 1
    V = Ob[K]
    put char V at X,Wr
    inc X
  next
  P = E
  inc Wr
  goto wo_line
end sub

' ---------------------------------------------------------------------------
' ELECTRONIC BRAIN helpers

' BrainPic: the brain, 4 x 4 tiles at 3,3
sub BrainPic:
  V = TBrain00
  for Y = 3 to 6
    for X = 3 to 6
      put char V at X,Y
      inc V
    next
  next
  return
end sub

sub BrSay:
  for Y = 18 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

' BrThink: sparks over the brain for a moment
sub BrThink:
  BrSay
  print at 2,18, "THINKING..."
  play sound SndThink
  for J = 1 to 40
    Rnd
    V = Rb & 15
    Sx = V + 24
    Rnd
    V = Rb & 15
    Sy = V + 22
    V = J & 7
    W = CbCol[V]
    set sprite 0 to Sy, Sx, SSpark, W
    Rnd
    V = Rb & 15
    Sx = V + 32
    Rnd
    V = Rb & 15
    Sy = V + 30
    set sprite 1 to Sy, Sx, SSpark, 15
    update sprites
    Frame1
  next
  return
end sub

' BrPick: the book's lines 280-500, a new guess in Bg; Res 1 if none fits
sub BrPick:
  Tries = 0
bp_again:
  inc Tries
  if Tries > 3000 then
    Res = 1
    return
  end if
  for Z = 1 to 3
    ' two candidates, the heavier wins (equal: the first)
    Ka = 0
bp_d1:
    inc Ka
    if Ka > 60 then
      Res = 1
      return
    end if
    Nr = Qn
    RndN
    K = V + 1
    Uw = C[K]
    if Uw = 0 then goto bp_d1
    Ka = 0
bp_d2:
    inc Ka
    if Ka > 60 then
      Res = 1
      return
    end if
    Nr = Qn
    RndN
    K = V + 1
    Ub = C[K]
    if Ub = 0 then goto bp_d2
    NumU = Uw / 10
    Mw = Ub / 10
    if Mw > NumU then Uw = Ub
    V = Uw % 10
    Bg[Z] = V
  next
  if Bg[1] = Bg[2] then goto bp_again
  if Bg[1] = Bg[3] then goto bp_again
  if Bg[2] = Bg[3] then goto bp_again
  ' as many places as the best answer's blacks kept
  if Aid > 0 then
    V = 0
    for K = 1 to 3
      if Bg[K] = Eb[K] then inc V
    next
    if V < Aid then goto bp_again
  end if
  ' never a guess made before
  if Guess > 0 then
    for K = 0 to Guess - 1
      W = K * 3
      Res = 1
      if Dm[W] <> Bg[1] then Res = 0
      inc W
      if Dm[W] <> Bg[2] then Res = 0
      inc W
      if Dm[W] <> Bg[3] then Res = 0
      if Res = 1 then goto bp_again
    next
  end if
  if Guess >= 21 then
    Res = 1
    return
  end if
  Res = 0
  return
end sub

' BrShowGuess: GUESS NUMBER n and the three digits as blocks
sub BrShowGuess:
  print at 9,3, "GUESS NUMBER"
  NumU = Guess
  print at 22,3, width$(NumU, 2)
  print at 9,5, "MY GUESS IS"
  for K = 1 to 3
    X = K * 3
    X = X + 18
    V = Bg[K] - 1
    V = V << 2
    V = V + TNum100
    put char V at X,5
    inc V
    W = X + 1
    put char V at W,5
    inc V
    put char V at X,6
    inc V
    put char V at W,6
  next
  play sound SndHum
  return
end sub

' BrHistory: the guess and its answer on rows 8-16 (two columns)
sub BrHistory:
  V = Guess - 1
  W = V % 18
  Y = W
  X = 2
  if W >= 9 then
    Y = W - 9
    X = 16
  end if
  Y = Y + 8
  fill 32 count 13 at X,Y
  NumU = Guess
  print at X,Y, width$(NumU, 2)
  K = X + 3
  for J = 1 to 3
    NumU = Bg[J]
    print at K,Y, width$(NumU, 1)
    inc K
  next
  K = K + 1
  print at K,Y, "B"
  inc K
  NumU = Nb
  print at K,Y, width$(NumU, 1)
  K = K + 2
  print at K,Y, "W"
  inc K
  NumU = Nw
  print at K,Y, width$(NumU, 1)
  return
end sub

' NumPick: Kc from 0 to Ka with up and down, shown at 24 of the last
' message row (18 or 19); Res 1 to leave
sub NumPick:
  Kc = 0
  Wr = 18
  if Ka < 3 then Wr = 19
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
np_loop:
  if Res = 1 then
    NumU = Kc
    print at 24,Wr, width$(NumU, 1)
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Kc < Ka then inc Kc
    end if
    if Dn1 = 1 then
      if Kc > 0 then dec Kc
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto np_loop
  Res = 0
  return
end sub

' LevelPick: Kc from 1 to Ka at 9 of row Wr; Res 1 to leave
sub LevelPick:
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
lp_loop:
  if Res = 1 then
    NumU = Kc
    print at 9,Wr, width$(NumU, 2)
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Kc < Ka then inc Kc
    end if
    if Dn1 = 1 then
      if Kc > 1 then dec Kc
    end if
    if Rt1 = 1 then
      if Kc < Ka then inc Kc
    end if
    if Lf1 = 1 then
      if Kc > 1 then dec Kc
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto lp_loop
  Res = 0
  return
end sub

' ---------------------------------------------------------------------------
' PROBOSCIDEAN helpers

' CardXY: card place K (0-51) at column X, row Y (13 across, 4 down)
sub CardXY:
  V = K % 13
  X = V << 1
  X = X + 3
  V = K / 13
  Y = V * 3
  Y = Y + 3
  return
end sub

' CardDraw: card place K, face up if Sh = 1 or St = 1, else its back
sub CardDraw:
  CardXY
  W = Sh | St[K]
  if W = 0 then
    V = TBack00
    put char V at X,Y
    inc V
    W = X + 1
    put char V at W,Y
    inc V
    Kc = Y + 1
    put char V at X,Kc
    inc V
    put char V at W,Kc
    return
  end if
  ' the rank: red for hearts and diamonds
  Ka = Cd[K]
  V = Ka % 13
  W = Ka / 13
  if W < 2 then
    V = V + TRrA
  else
    V = V + TRkA
  end if
  ' the face: rank and suit on the left, white on the right (its edge
  ' black, so the cards stand apart)
  put char V at X,Y
  Kc = X + 1
  put char TWhite at Kc,Y
  Kc = Y + 1
  V = W + TSuh
  put char V at X,Kc
  W = X + 1
  put char TWhite at W,Kc
  return
end sub

sub PbSay:
  for Y = 18 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

sub PbScore:
  print at 2,15, "MY SCORE IS"
  NumU = Cs
  print at 14,15, width$(NumU, 2)
  print at 17,15, "AND YOURS IS"
  NumU = Hs
  print at 2,16, width$(NumU, 2)
  print at 6,16, "LEVEL"
  NumU = Lvl
  print at 12,16, width$(NumU, 2)
  return
end sub

' PickCard: a face-down card with the stick (Cur); Res 1 to leave
sub PickCard:
  Mode = 1
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
pc_loop:
  if Res = 1 then
    K = Cur
    CardXY
    Sx = X << 3
    Sy = Y << 3
    Sy = Sy - 1
    set sprite 0 to Sy, Sx, SCardring, 15
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    V = Cur % 13
    if Lf1 = 1 then
      if V > 0 then dec Cur
    end if
    if Rt1 = 1 then
      if V < 12 then inc Cur
    end if
    if Up1 = 1 then
      if Cur >= 13 then Cur = Cur - 13
    end if
    if Dn1 = 1 then
      if Cur < 39 then Cur = Cur + 13
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    HideSprites
    Res = 1
    return
  end if
  if Press = 0 then goto pc_loop
  if St[Cur] = 1 then
    play sound SndBad
    goto pc_loop
  end if
  Mode = 0
  Res = 0
  return
end sub

' PbForget: the two cards Ca, Cb go back face down; the computer
' remembers where they were (the book's D(R), D(R + 1))
sub PbForget:
  Pause
  Sh = 0
  K = Ca
  CardDraw
  K = Cb
  CardDraw
  if R < 62 then
    Dm[R] = Ca
    inc R
    Dm[R] = Cb
    inc R
  end if
  return
end sub

' PbChoose: the computer's two cards (Ca, Cb): a pair it remembers, unless
' it forgets (one time in ten per level); else any two; Res 1 if it can't
sub PbChoose:
  Res = 0
  if R > 2 then
    Rnd
    V = Lvl * 25
    if Rb >= V then
      for Ka = R - 1 to 2 step -1
        for Kc = 1 to Ka - 1
          K = Dm[Ka]
          W = Dm[Kc]
          if K <> W then
            if St[K] = 0 then
              if St[W] = 0 then
                V = Cd[K] % 13
                X = Cd[W] % 13
                if V = X then
                  Ca = K
                  Cb = W
                  return
                end if
              end if
            end if
          end if
        next
      next
    end if
  end if
  ' the book: up to 200 tries at two random face-down cards
  for Uw = 1 to 200
    Nr = 52
    RndN
    Ca = V
    Nr = 52
    RndN
    Cb = V
    if Ca <> Cb then
      if St[Ca] = 0 then
        if St[Cb] = 0 then return
      end if
    end if
  next
  Res = 1
  return
end sub

' ---------------------------------------------------------------------------
' AMANUENSIS helpers

' PmWord1: a word of list 0 (the book's GOSUB 450: one of the ten); then
' PmWordAdd for list Si
sub PmWord1:
  Si = 0
sub PmWordAdd:
  Nr = 10
  RndN
  W = Si * 10
  W = W + V
  Uw = PmOff[W]
  Tl = PmLen[W]
  copy PmText + Uw count Tl to Tb
  AddTb
  return
end sub

sub AddLit3:
  V = 84
  AddCh
  V = 72
  AddCh
  V = 69
  AddCh
  AddSpace
  return
end sub

sub AddThe:
  AddLit3
  return
end sub

sub AddIn:
  V = 73
  AddCh
  V = 78
  AddCh
  return
end sub

sub AddTo:
  V = 84
  AddCh
  V = 79
  AddCh
  AddSpace
  return
end sub

sub AddFor:
  AddSpace
  V = 70
  AddCh
  V = 79
  AddCh
  V = 82
  AddCh
  AddSpace
  return
end sub

sub AddThen:
  V = 44
  AddCh
  AddSpace
  AddLit3
  dec Ol
  V = 78
  AddCh
  AddSpace
  return
end sub

sub AddDots:
  AddSpace
  V = 46
  AddCh
  AddCh
  AddCh
  return
end sub

' PmLine: Ob typed on the parchment from row Wr, 26 columns from column 3,
' with the quill; Res 1 for the second button
sub PmLine:
  P = 0
pl_line:
  if P >= Ol then
    Res = 0
    return
  end if
  E = P + 26
  if E < Ol then
    K = E
pl_back:
    if K > P then
      if Ob[K] <> 32 then
        dec K
        goto pl_back
      end if
    end if
    if K > P then E = K
  else
    E = Ol
  end if
  X = 3
  for K = P to E - 1
    V = Ob[K]
    put char V at X,Wr
    Sx = X << 3
    Sx = Sx + 6
    Sy = Wr << 3
    Sy = Sy - 13
    set sprite 0 to Sy, Sx, SQuill, 1
    update sprites
    V = K & 1
    if V = 0 then play sound SndType
    Frame1
    Frame1
    ReadPad
    if Press2 = 1 then
      Res = 1
      return
    end if
    inc X
  next
  P = E
  ' a broken line goes on, indented
  if P < Ol then
    if Ob[P] = 32 then inc P
  end if
  inc Wr
  goto pl_line
end sub

' ---------------------------------------------------------------------------
' Celebrate: three bursts of sparks for a win
sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

' ---------------------------------------------------------------------------
' Common

' GoOn: press the button to go on; Res 1 for the second button
sub GoOn:
  print at 2,22, "BUTTON: ON     2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
go_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto go_loop
  fill 32 count 28 at 2,22
  Res = 0
  return
end sub

' EndWait: Res 0 for the button (again), 1 for the second (menu)
sub EndWait:
  print at 2,22, "BUTTON: AGAIN  2ND: MENU"
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    HideSprites
    Res = 1
    return
  end if
  if Press = 0 then goto ew_loop
  HideSprites
  Res = 0
  return
end sub

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Uw = Uw * Nr
  Uw = Uw >> 8
  V = Uw
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  sprites stable 0 to 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop dark blue
  print at 7,1, "THINKING MACHINES"
  BrainPic
  Blink = 0
  V = TMon00
  for Y = 3 to 5
    for X = 22 to 25
      put char V at X,Y
      inc V
    next
  next
  print at 9,9, "ELIZA"
  print at 9,10, "ELECTRONIC BRAIN"
  print at 9,11, "PROBOSCIDEAN"
  print at 9,12, "AMANUENSIS"
  print at 9,14, "HOW TO PLAY"
  print at 9,15, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 468
  TzOn = 1
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 5 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 9 to 15
    print at 7,I, " "
  next
  Y = Menu + 9
  if Menu >= 4 then inc Y
  print at 7,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  TzOn = 0
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "ELIZA: TYPE ON THE KEYBOARD"
  print at 2,4, "(STICK AND BUTTON), END TO"
  print at 2,5, "SEND. SAY BYE TO STOP."
  print at 2,7, "ELECTRONIC BRAIN: THINK OF"
  print at 2,8, "3 DIGITS; GIVE THE BLACKS"
  print at 2,9, "AND WHITES WITH UP, DOWN."
  print at 2,11, "PROBOSCIDEAN: TURN TWO"
  print at 2,12, "CARDS; A PAIR SCORES. THE"
  print at 2,13, "COMPUTER REMEMBERS..."
  print at 2,15, "AMANUENSIS: READ THE POEMS."
  print at 2,16, "BUTTON: THE NEXT ONE."
  print at 2,18, "2ND BUTTON: BACK TO MENU."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 7,1, "THINKING MACHINES"
  print at 2,3, "ELIZA, ELECTRONIC BRAIN,"
  print at 2,4, "PROBOSCIDEAN AND AMANUENSIS"
  print at 2,5, "FROM TIM HARTNELL'S GIANT"
  print at 2,6, "BOOK OF COMPUTER GAMES"
  print at 2,7, "(BALLANTINE BOOKS, 1984;"
  print at 2,8, "INTERFACE PUBLICATIONS,"
  print at 2,9, "1983). ELIZA AFTER JOSEPH"
  print at 2,10, "WEIZENBAUM'S PROGRAM (1966)."
  print at 2,12, "MUSIC: TURING'S WALTZ"
  print at 2,13, "(ORIGINAL)."
  print at 2,15, "COLECOVISION VERSION BY"
  print at 2,16, "AMY BIENVENU, 2026."
  PageWait
  return
end sub

data TilePat bytes
  $00,$00,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$70,$70,$70
  $00,$00,$00,$00,$00,$0E,$0E,$0E
  $00,$00,$03,$03,$03,$03,$03,$03
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $70,$00,$00,$40,$C0,$00,$00,$00
  $0E,$00,$00,$02,$03,$00,$00,$00
  $03,$03,$03,$03,$03,$03,$03,$03
  $C0,$C0,$00,$00,$00,$03,$03,$03
  $00,$00,$F0,$F0,$F0,$00,$00,$00
  $00,$00,$F0,$F0,$F0,$00,$00,$00
  $03,$03,$00,$00,$00,$C0,$C0,$C0
  $00,$00,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$70
  $00,$00,$00,$00,$00,$00,$00,$0E
  $00,$00,$03,$03,$03,$03,$03,$03
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$40,$C0,$00,$00,$00
  $00,$00,$00,$02,$03,$00,$00,$00
  $03,$03,$03,$03,$03,$03,$03,$03
  $C0,$C0,$00,$00,$00,$03,$03,$03
  $00,$00,$F0,$F0,$F0,$00,$00,$00
  $00,$00,$F0,$F0,$F0,$00,$00,$00
  $03,$03,$00,$00,$00,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$03,$07,$F0
  $00,$00,$00,$C0,$1C,$06,$07,$07
  $00,$00,$00,$03,$8E,$83,$83,$83
  $00,$00,$00,$00,$00,$C0,$E0,$F0
  $E0,$C0,$C0,$80,$80,$80,$80,$80
  $0E,$1C,$70,$E0,$C0,$C0,$E0,$70
  $87,$8E,$B8,$F0,$E0,$E0,$F0,$B8
  $07,$03,$03,$01,$01,$01,$01,$01
