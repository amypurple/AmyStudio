' CAVERN OF THE SHADOW THIEVES
' From Tim Hartnell's Giant Book of Computer Games (Ballantine Books, 1984;
' Interface Publications, 1983), for the ColecoVision in Amy by Amy
' Bienvenu.
'
' Twenty caverns, four tunnels from each (some one-way), a new map every
' game. Get from cavern 1 to cavern 20 before the time (50) runs out.
' Treasure lies about; you can carry four things. Inhabitants each want a
' toll: carry it and they take it, drop it and vanish; if not, you must go
' back. Some caverns hold transportation spells. The magic word (the
' book's 0) throws you to a random cavern for 5 more units of time.
'
' Controls (either joystick): left and right choose a tunnel (or the
' magic circle), the button goes. YES or NO with left and right; up and
' down choose the thing to drop. Keypad not used.
'
' Liberties taken:
' - A tunnel is chosen with the stick; the magic circle is the book's 0.
' - An inhabitant who vanished is gone for good (the listing leaves a
'   blank name behind that still asks for the toll).
' - The caverns are drawn: tunnel mouths with their numbers, the treasure
'   on the floor, the inhabitant as a shadow creature; the things you
'   carry have icons.
' - New music (Twenty Caverns Deep) and sounds; fireworks when you get
'   out.
'
' House rules kept: text in columns 2-29 and rows 1-22; at most four
' sprites; every screen is drawn with the NMI off after a wait.

const TRock1 = 128
const TRock2 = 129
const TRock3 = 130
const TMouth00 = 131
const TMouth01 = 132
const TMouth10 = 133
const TMouth11 = 134
const TMouth20 = 135
const TMouth21 = 136
const TFloor = 137
const TMagic00 = 138
const TMagic01 = 139
const TMagic10 = 140
const TMagic11 = 141
const TLoot1 = 142
const TLoot2 = 143
const TLoot3 = 144
const TLoot4 = 145
const TLoot5 = 146
const TLoot6 = 147
const TLoot7 = 148
const TLoot8 = 149
const TLoot9 = 150
const TLoot10 = 151
const TSparkle = 152
const SMan = 0
const SBeast = 4
const SEyes = 8
const SSpark = 12
const NTiles8 = 200
const SprBytes = 128
const SndHush = 1
const SndClick = 2
const SndStep = 3
const SndTake = 4
const SndGrowl = 5
const SndVanish = 6
const SndMagic = 7
const SndBad = 8
const SndWin = 9
const SndLose = 10
const SndTuneA = 11
const SndTuneB = 12
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0
' the inhabitants (1-20) and the loot (1-10), 16 bytes each, padded
data InhabNames bytes
  72, 65, 73, 82, 89, 32, 72, 79, 66, 71, 79, 66, 76, 73, 78, 32
  66, 65, 76, 68, 32, 66, 69, 82, 83, 69, 82, 75, 69, 82, 32, 32
  83, 75, 73, 78, 78, 89, 32, 83, 75, 69, 76, 69, 84, 79, 78, 32
  71, 82, 85, 69, 83, 79, 77, 69, 32, 71, 78, 79, 77, 69, 32, 32
  67, 85, 78, 78, 73, 78, 71, 32, 67, 79, 78, 74, 85, 82, 69, 82
  67, 82, 65, 90, 89, 32, 67, 69, 78, 84, 73, 80, 69, 68, 69, 32
  68, 69, 77, 69, 78, 84, 69, 68, 32, 68, 87, 65, 82, 70, 32, 32
  83, 65, 86, 65, 71, 69, 32, 83, 72, 82, 73, 69, 75, 69, 82, 32
  67, 82, 69, 69, 80, 89, 32, 67, 82, 65, 87, 76, 73, 69, 32, 32
  82, 79, 84, 84, 69, 78, 32, 82, 79, 68, 69, 78, 84, 32, 32, 32
  84, 69, 82, 82, 73, 66, 76, 69, 32, 84, 79, 65, 68, 32, 32, 32
  83, 84, 73, 67, 75, 89, 32, 83, 84, 85, 82, 71, 69, 32, 32, 32
  71, 72, 65, 83, 84, 76, 89, 32, 71, 72, 79, 85, 76, 32, 32, 32
  87, 73, 67, 75, 69, 68, 32, 87, 69, 65, 83, 69, 76, 32, 32, 32
  76, 85, 77, 80, 89, 32, 76, 69, 71, 69, 78, 68, 32, 32, 32, 32
  90, 65, 78, 89, 32, 90, 79, 77, 66, 73, 69, 32, 32, 32, 32, 32
  67, 82, 79, 79, 75, 69, 68, 32, 67, 82, 65, 66, 32, 32, 32, 32
  87, 82, 65, 84, 72, 70, 85, 76, 32, 87, 82, 65, 73, 84, 72, 32
  87, 69, 73, 82, 68, 32, 87, 69, 82, 69, 87, 79, 76, 70, 32, 32
  71, 73, 65, 78, 84, 32, 71, 65, 82, 71, 79, 89, 76, 69, 32, 32
end data
data LootNames bytes
  80, 73, 69, 67, 69, 32, 79, 70, 32, 67, 79, 80, 80, 69, 82, 32
  83, 80, 85, 78, 75, 84, 82, 85, 77, 32, 67, 79, 73, 78, 32, 32
  80, 76, 65, 84, 73, 78, 85, 77, 32, 83, 72, 73, 69, 76, 68, 32
  67, 79, 80, 80, 69, 82, 32, 72, 69, 65, 68, 66, 65, 78, 68, 32
  77, 65, 71, 73, 67, 32, 83, 67, 82, 79, 76, 76, 32, 32, 32, 32
  70, 65, 66, 85, 76, 79, 85, 83, 32, 80, 79, 84, 73, 79, 78, 32
  87, 65, 78, 68, 32, 79, 70, 32, 72, 69, 65, 76, 73, 78, 71, 32
  83, 87, 79, 82, 68, 32, 79, 70, 32, 70, 73, 82, 69, 32, 32, 32
  83, 80, 65, 82, 75, 76, 73, 78, 71, 32, 65, 77, 85, 76, 69, 84
  87, 65, 82, 32, 72, 65, 77, 77, 69, 82, 32, 32, 32, 32, 32, 32
end data

data CbDx bytes 0,3,4,3,0,253,252,253
data CbDy bytes 252,253,0,3,4,3,0,253
data CbCol bytes 15,11,9,13,7,10,8,14
u8 CbX[8]
u8 CbY[8]
u8 CbK = 0
u8 CbT = 0
u8 CbN = 0
u8 CbC = 0
u8 CbV = 0

' the caverns: four tunnels each (A[4 Y + K], K 0-3), the inhabitant
' (D: 0 none, 1-20, 21 a transportation spell), its toll (E: loot 1-10),
' the treasure lying there (F: 0 or 1-10); what you carry (R)
u8 A[88]
u8 D[22]
u8 E[22]
u8 F[22]
u8 R[5]
u8 Cv = 1
u8 From = 0
u8 Tq = 50
u8 Pick = 1
u8 Got = 0
u8 Ka = 0
u8 Kb = 0
u8 Kc = 0
u8 Nm = 0
' what the game waits for (for the bot): 1 a tunnel, 2 YES/NO, 3 a drop
u8 Mode = 0

u16 Uw = 0
u16 Ub = 0
u16 NumU = 0
u16 Rs = $3C55
u16 Rt = 0
u8 Rb = 0
u8 Nr = 0
u8 Res = 0

u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table ShSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' a new cavern system

  NewScreen
  print at 2,6, "PLEASE STAND BY AS I"
  print at 2,7, "CONSTRUCT THE CAVE..."
  ShowScreen
  ' the book's lines 1150-1230: four different tunnels from each cavern,
  ' to caverns at most five back or six on; past cavern 12, one time in
  ' five, one of them leads to cavern 20
  for Y = 1 to 20
st_again:
    for K = 0 to 3
st_tun:
      ' B + INT(RND*7 - RND*6), in 256ths: 7 R1 - 6 R2 + 6 x 256, then
      ' the whole part, less 6
      Rnd
      Uw = Rb
      Uw = Uw * 7
      Uw = Uw + 1536
      Rnd
      Ub = Rb
      Ub = Ub * 6
      Uw = Uw - Ub
      Uw = Uw >> 8
      V = Uw
      V = V + Y
      if V < 7 then goto st_tun
      V = V - 6
      if V = Y then goto st_tun
      if V < 1 then goto st_tun
      if V > 20 then goto st_tun
      Ka = Y << 2
      Ka = Ka + K
      A[Ka] = V
    next
    Ka = Y << 2
    Kb = Ka + 1
    Kc = Ka + 2
    I = Ka + 3
    V = A[Ka]
    if V = A[Kb] then goto st_again
    if V = A[Kc] then goto st_again
    if V = A[I] then goto st_again
    V = A[Kb]
    if V = A[Kc] then goto st_again
    if V = A[I] then goto st_again
    V = A[Kc]
    if V = A[I] then goto st_again
    if Y > 12 then
      Rnd
      if Rb < 49 then
        Nr = 4
        RndN
        Ka = Ka + V
        A[Ka] = 20
      end if
    end if
  next
  print at 2,9, "PLEASE STAND BY AS I HIDE"
  print at 2,10, "THE GOODIES..."
  ' the book's lines 930-1000: sixteen inhabitants (with a toll) and
  ' sixteen treasures, a transportation spell one time in ten
  for K = 0 to 21
    D[K] = 0
    E[K] = 0
    F[K] = 0
  next
  for K = 1 to 16
    Nr = 18
    RndN
    I = V + 2
    Nr = 20
    RndN
    D[I] = V + 1
    Nr = 10
    RndN
    E[I] = V + 1
    Nr = 19
    RndN
    I = V + 2
    Nr = 10
    RndN
    F[I] = V + 1
    Rnd
    if Rb >= 230 then D[I] = 21
  next
  for K = 1 to 4
    R[K] = 0
  next
  Tq = 50
  Cv = 1
  From = 0
  Pick = 1
  for J = 1 to 40
    Frame1
  next

' ---------------------------------------------------------------------------
' the game cycle

st_arrive:
  ' the book's line 140: each look round costs a unit of time
  if Tq <= 1 then goto st_timeup
  dec Tq
  CaveScreen
  ' treasure
  if F[Cv] > 0 then
    print at 2,17, "THE CAVERN CONTAINS A"
    Nm = F[Cv]
    X = 2
    Y = 18
    LootName
    print at 2,19, "DO YOU WANT IT?"
    YesNo
    Say
    if Res = 1 then
      ' a free hand?
      Got = 0
      for K = 1 to 4
        if Got = 0 then
          if R[K] = 0 then Got = K
        end if
      next
      if Got = 0 then
        print at 2,17, "YOU ARE CARRYING TOO MUCH"
        print at 2,18, "WHICH ITEM DO YOU WANT TO"
        print at 2,19, "DROP?"
        DropPick
        Got = Pick
        Pick = 1
      end if
      R[Got] = F[Cv]
      F[Cv] = 0
      play sound SndTake
      Pause
      ' the listing looks round again: another unit of time
      if Tq <= 1 then goto st_timeup
      dec Tq
      CaveScreen
    end if
  end if
  ' an inhabitant, or a transportation spell
  if D[Cv] = 21 then
    print at 2,17, "A TRANSPORTATION SPELL!"
    play sound SndMagic
    Swirl
    From = Cv
    Nr = 9
    RndN
    Cv = V + 8
    goto st_arrive
  end if
  if D[Cv] > 0 then
    play sound SndGrowl
    print at 2,17, "THERE IS A"
    Nm = D[Cv]
    X = 13
    Y = 17
    InhabName
    print at 2,18, "HERE, WHO WANTS A"
    Nm = E[Cv]
    X = 2
    Y = 19
    LootName
    print at 2,20, "TO LET YOU PASS"
    Pause
    Got = 0
    for K = 1 to 4
      if Got = 0 then
        if R[K] = E[Cv] then Got = K
      end if
    next
    if Got = 0 then
      Say
      print at 2,17, "YOU MUST RETURN TO"
      NumU = From
      print at 21,17, width$(NumU, 2)
      Pause
      Pause
      V = From
      From = Cv
      Cv = V
      goto st_arrive
    end if
    print at 2,21, "AND YOU HAVE IT!"
    Pause
    Say
    print at 2,17, "THE"
    Nm = D[Cv]
    X = 6
    Y = 17
    InhabName
    print at 2,18, "VANISHES!"
    play sound SndVanish
    for J = 1 to 30
      V = J & 2
      if V = 0 then
        ShowBeast
      else
        HideSprites
      end if
      Frame1
    next
    D[Cv] = 0
    F[Cv] = R[Got]
    R[Got] = 0
    Pause
    CaveScreen
  end if
  ' where to?
  print at 2,17, "WHERE DO YOU WANT TO GO?"
  print at 2,18, "(THE CIRCLE IS THE MAGIC"
  print at 2,19, "WORD: ANYWHERE, TIME -5)"
  TunnelPick
  if Res = 1 then goto title
  if Pick = 5 then
    play sound SndMagic
    Swirl
    if Tq > 5 then
      Tq = Tq - 5
    else
      Tq = 1
    end if
    Nr = 16
    RndN
    V = V + 1
  else
    Ka = Cv << 2
    Ka = Ka + Pick
    Ka = Ka - 1
    V = A[Ka]
    WalkIn
  end if
  From = Cv
  Cv = V
  if Cv = 20 then goto st_made
  goto st_arrive

st_made:
  NewScreen
  backdrop dark blue
  for X = 2 to 29
    V = X & 3
    Y = V + 1
    print at X,Y, "*"
  next
  play sound SndWin
  print at 2,7, "YOU HAVE MADE IT!!"
  print at 2,9, "YOUR CAVERN-MASTER RATING"
  print at 2,10, "IS"
  ' the book: 100 (100 - Q) + 2 Q
  Uw = 100 - Tq
  Uw = Uw * 100
  Ub = Tq << 1
  NumU = Uw + Ub
  print at 5,10, width$(NumU, 5)
  Got = 0
  for K = 1 to 4
    if R[K] > 0 then Got = 1
  next
  if Got = 1 then
    print at 2,12, "YOU GOT OUT WITH:"
    Y = 13
    for K = 1 to 4
      if R[K] > 0 then
        Nm = R[K]
        X = 4
        LootName
        inc Y
      end if
    next
  end if
  ShowScreen
  Celebrate
  EndWait
  goto title

st_timeup:
  HideSprites
  Say
  play sound SndLose
  print at 2,17, "SORRY, FRIEND, BUT TIME"
  print at 2,18, "IS UP"
  EndWait
  goto title

' ---------------------------------------------------------------------------
' the cavern screen

' CaveScreen: the cavern, its tunnels, its treasure and inhabitant, the
' time, where you came from and what you carry
sub CaveScreen:
  NewScreen
  backdrop black
  for Y = 2 to 7
    for X = 0 to 31
      V = X + Y
      V = V & 3
      W = TRock1
      if V = 1 then W = TRock2
      if V = 3 then W = TRock3
      put char W at X,Y
    next
  next
  fill TFloor count 32 at 0,8
  fill TFloor count 32 at 0,9
  ' the four tunnels, then the magic circle
  Ka = Cv << 2
  for K = 1 to 4
    TunnelX
    W = TMouth00
    for Y = 5 to 7
      put char W at X,Y
      inc W
      V = X + 1
      put char W at V,Y
      inc W
    next
    V = A[Ka]
    NumU = V
    print at X,10, width$(NumU, 2)
    inc Ka
  next
  put char TMagic00 at 27,6
  put char TMagic01 at 28,6
  put char TMagic10 at 27,7
  put char TMagic11 at 28,7
  print at 27,10, "?"
  ' the treasure on the floor
  if F[Cv] > 0 then
    V = F[Cv] - 1
    V = V + TLoot1
    put char V at 14,9
  end if
  print at 2,1, "CAVERN"
  NumU = Cv
  print at 9,1, width$(NumU, 2)
  print at 18,1, "TIME"
  NumU = Tq
  print at 23,1, width$(NumU, 2)
  if From > 0 then
    print at 2,11, "YOU HAVE COME FROM CAVERN"
    NumU = From
    print at 28,11, width$(NumU, 2)
  end if
  CarryList
  ShowScreen
  ShowBeast
  return
end sub

' ShowBeast: the shadow creature over the cavern, if one lives here
sub ShowBeast:
  HideSprites
  if D[Cv] = 0 then return
  if D[Cv] = 21 then return
  V = D[Cv] & 7
  W = CbCol[V]
  set sprite 0 to 47, 104, SEyes, 15
  set sprite 1 to 47, 104, SBeast, W
  update sprites
  return
end sub

' CarryList: what you carry, with icons (rows 13-16)
sub CarryList:
  Got = 0
  for K = 1 to 4
    if R[K] > 0 then Got = 1
  next
  if Got = 0 then return
  print at 2,12, "YOU ARE CARRYING:"
  for K = 1 to 4
    Y = K + 12
    fill 32 count 26 at 4,Y
    if R[K] > 0 then
      V = R[K] - 1
      V = V + TLoot1
      put char V at 4,Y
      Nm = R[K]
      X = 6
      Kc = K
      LootName
      K = Kc
    end if
  next
  return
end sub

' TunnelX: tunnel K (1-4) at column X
sub TunnelX:
  X = K * 6
  X = X - 2
  return
end sub

' InhabName, LootName: name Nm at X, Y (16 characters)
sub InhabName:
  Uw = Nm - 1
  Uw = Uw << 4
  Ub = Y
  Ub = Ub << 5
  Ub = Ub + X
  copy InhabNames + Uw count 16 to vram.name + Ub
  return
end sub

sub LootName:
  Uw = Nm - 1
  Uw = Uw << 4
  Ub = Y
  Ub = Ub << 5
  Ub = Ub + X
  copy LootNames + Uw count 16 to vram.name + Ub
  return
end sub

sub Say:
  for Y = 17 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

' TunnelPick: Pick 1-4 a tunnel, 5 the magic circle; Res 1 to leave
sub TunnelPick:
  print at 2,22, "BUTTON: GO     2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
  Mode = 1
tp_loop:
  if Res = 1 then
    K = Pick
    TunnelX
    if Pick = 5 then X = 27
    Sx = X << 3
    set sprite 2 to 55, Sx, SMan, 15
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Pick > 1 then dec Pick
    end if
    if Rt1 = 1 then
      if Pick < 5 then inc Pick
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Mode = 0
    Res = 1
    return
  end if
  if Press = 0 then goto tp_loop
  Mode = 0
  Res = 0
  return
end sub

' WalkIn: the explorer walks into the tunnel
sub WalkIn:
  Kc = V
  Sy = 55
  for J = 1 to 16
    Sy = Sy - 2
    set sprite 2 to Sy, Sx, SMan, 15
    update sprites
    I = J & 3
    if I = 0 then play sound SndStep
    Frame1
  next
  V = Kc
  return
end sub

' Swirl: sparks spin round the explorer (magic)
sub Swirl:
  Kc = V
  for J = 1 to 40
    I = J & 7
    V = CbDx[I] << 2
    V = V + 120
    W = CbDy[I] << 2
    W = W + 60
    set sprite 3 to W, V, SSpark, CbCol[I]
    update sprites
    Frame1
  next
  set sprite 3 to 192, 0, 0, 0
  update sprites
  V = Kc
  return
end sub

' YesNo: Res 1 for YES, 0 for NO
sub YesNo:
  print at 6,21, "YES"
  print at 18,21, "NO"
  Kc = 0
  WasBtn = 1
  Res = 1
  Mode = 2
yn_loop:
  if Res = 1 then
    print at 4,21, " "
    print at 16,21, " "
    X = 4
    if Kc = 1 then X = 16
    print at X,21, ">"
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then Kc = 0
    if Rt1 = 1 then Kc = 1
    play sound SndClick
    Res = 1
  end if
  if Press = 0 then goto yn_loop
  Mode = 0
  Res = 1 - Kc
  return
end sub

' DropPick: Pick 1-4 among the things carried (rows 13-16)
sub DropPick:
  Pick = 1
  WasBtn = 1
  Res = 1
  Mode = 3
dp_loop:
  if Res = 1 then
    for K = 1 to 4
      Y = K + 12
      print at 2,Y, " "
    next
    Y = Pick + 12
    print at 2,Y, ">"
    Res = 0
  end if
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Pick > 1 then dec Pick
    end if
    if Dn1 = 1 then
      if Pick < 4 then inc Pick
    end if
    play sound SndClick
    Res = 1
  end if
  if Press = 0 then goto dp_loop
  Mode = 0
  return
end sub

' ---------------------------------------------------------------------------
' Common

sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

sub EndWait:
  print at 2,22, "PRESS A BUTTON            "
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then goto ew_done
  if Press = 0 then goto ew_loop
ew_done:
  HideSprites
  return
end sub

sub Pause:
  for J = 1 to 60
    Frame1
  next
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Uw = Uw * Nr
  Uw = Uw >> 8
  V = Uw
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  sprites stable 0 to 3
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop black
  for Y = 2 to 6
    for X = 0 to 31
      V = X + Y
      V = V & 3
      W = TRock1
      if V = 1 then W = TRock2
      if V = 3 then W = TRock3
      put char W at X,Y
    next
  next
  for K = 1 to 4
    TunnelX
    W = TMouth00
    for Y = 4 to 6
      put char W at X,Y
      inc W
      V = X + 1
      put char W at V,Y
      inc W
    next
  next
  fill TFloor count 32 at 0,7
  print at 4,9, "CAVERN OF THE SHADOW"
  print at 10,10, "THIEVES"
  print at 10,13, "ENTER THE CAVERNS"
  print at 10,14, "HOW TO PLAY"
  print at 10,15, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  set sprite 0 to 39, 104, SEyes, 15
  set sprite 1 to 39, 104, SBeast, 13
  update sprites
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 13 to 15
    print at 8,I, " "
  next
  Y = Menu + 13
  print at 8,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  TzOn = 0
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "GET FROM CAVERN 1 TO CAVERN"
  print at 2,4, "20 BEFORE THE TIME RUNS OUT."
  print at 2,5, "EACH CAVERN HAS FOUR"
  print at 2,6, "TUNNELS; SOME ARE ONE-WAY."
  print at 2,8, "TAKE TREASURE (FOUR AT"
  print at 2,9, "MOST): INHABITANTS WANT A"
  print at 2,10, "TOLL TO LET YOU PASS."
  print at 2,11, "WITHOUT IT YOU GO BACK."
  print at 2,13, "THE MAGIC CIRCLE THROWS YOU"
  print at 2,14, "ANYWHERE, FOR 5 TIME."
  print at 2,16, "MAKE A MAP: THE CAVERNS DO"
  print at 2,17, "NOT CHANGE IN A GAME."
  print at 2,19, "STICK: CHOOSE. BUTTON: GO."
  print at 2,20, "2ND BUTTON: BACK TO MENU."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 2,1, "CAVERN OF THE SHADOW THIEVES"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983)."
  print at 2,9, "MUSIC: TWENTY CAVERNS DEEP"
  print at 2,10, "(ORIGINAL)."
  print at 2,12, "COLECOVISION VERSION BY"
  print at 2,13, "AMY BIENVENU, 2026."
  PageWait
  return
end sub

