  21, 16, 24, 12, 26, 15, 20, 11, 22, 25, 28, 4, 9, 6, 7, 13
  15, 18
end data
const NSpr = 4
const Hid = 64
const Held = 100
const TuneLen = 660

data BitT bytes
  0, 16, 32, 64
end data

u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u16 Rounds = 0
' the case
u8 Mv = 0
u8 Mr = 0
u8 Mw = 0
u8 Mx = 0
u8 Age = 0
u8 Gos = 0
' suspects 1-12: place (0 nowhere), alibi, hobby, flags (bank 1-7, 8 new
' will, 16 blackmail list, 32 legatee, 64 clinic file)
u8 SLoc[13]
u8 Al[13]
u8 Hob[13]
u8 Gf[13]
' items 1-16: place (1-16 in sight, 64 + b hidden, 100 + p carried), owner
u8 ILoc[17]
u8 Own[13]
' the map: building in each cell, building's cell, entered yet
u8 GridB[16]
u8 Known[17]
' detectives 1-6: building (0 out, 17 in the street), cell, item
u8 PLoc[7]
u8 PCell[7]
u8 PItem[7]
u8 Np = 1
u8 Act = 1
u8 Pl = 1
u8 Bd = 0
u8 Over = 0
' what was seen on arrival
u8 SeenS = 0
u8 SeenI = 0
u8 SeenPI = 0
u8 LastS = 0
' menus: values of the rows, count, choice
u8 MenuV[14]
u8 MenuN = 0
u8 Ch = 0
u8 HandY = 0
' text cursor
u8 Cx = 2
u8 Cy = 1
u8 Fresh = 1
' the walker on the map
u8 Mc = 5
u8 Sx = 0
u8 Sy = 0
u8 Tx = 0
u8 Ty = 0
u8 Walk = 0
' interrogation
u8 Q1 = 0
u8 Q2 = 0
u8 Q3 = 0
u8 QMode = 0
u8 QLeft = 0
u8 Yn = 0
' what the game waits for (for the bots): 1 menu, 3 a press, 4 map
u8 Ui = 0
u8 Stage = 0
' input
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0
u8 HoldT = 0
u8 Menu = 0
u8 Tick = 0
u8 TitleOn = 0
u8 TzOn = 0
u8 Asking = 0
' loop counters (never shared with the helpers)
u8 Ji = 0
u8 Pi = 0
u8 Ri = 0
' scratch
u8 A = 0
u8 C = 0
u8 J = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MySoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title
  AskPlayers
  NewCase
  Rounds = 1
  Pl = 1
  while Over = 0
    if PLoc[Pl] > 0 then
      PlayTurn
    end if
    if Over = 0 then
      inc Pl
      if Pl > Np then
        Pl = 1
        EndRound
        inc Rounds
      end if
    end if
  end while
  ShowEnding
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift; Rnd(N) is 0..N-1, Fnr(N) 1..N

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function Rnd(u8 N) as u8
  u8 Q = 0
  Rand
  Q = lowbyte Rs
  return Q % N

function Fnr(u8 N) as u8
  return Rnd(N) + 1

' 1 for a man (suspects 7-12), 0 for a woman (FNSX)
function Sex(u8 S) as u8
  if S > 6 then return 1
  return 0

' ---------------------------------------------------------------------------
' a new case (lines 170-290)

sub NewCase:
  u8 Cell = 0
  u8 K = 0
  u8 Bit = 0
  Mx = Fnr(3)
  Mv = Fnr(12)
  Mw = Fnr(12)
  Mr = Mv
  while Mr = Mv
    Mr = Fnr(12)
  end while
  for K = 0 to 15
    GridB[K] = 0
  next
  for K = 1 to 16
    ' a free cell for building K
    Cell = Rnd(16)
    while GridB[Cell] > 0
      Cell = Rnd(16)
    end while
    GridB[Cell] = K
    Known[K] = 0
    ILoc[K] = 16
    if K <= 12 then
      SLoc[K] = K
      Al[K] = Rnd(6)
      Hob[K] = Fnr(12)
      Own[K] = Fnr(15)
      ILoc[K] = Own[K] + Hid
      Bit = Fnr(7)
      if Rnd(2) = 1 then Bit = Bit | 16
      if Rnd(2) = 1 then Bit = Bit | 32
      if Rnd(2) = 1 then Bit = Bit | 64
      Gf[K] = Bit
    end if
  next
  Age = Fnr(40) + 20
  SLoc[Mv] = 0
  ILoc[13] = Mv + Hid
  Al[Mr] = Rnd(3)
  Own[Mw] = Mr
  ' the murder weapon is never hidden at the murderer's own place
  while ILoc[Mw] = Mr + Hid
    ILoc[Mw] = Fnr(15) + Hid
  end while
  Bit = Fnr(7)
  if Mx = 2 then Bit = Bit + 8
  if Mx < 3 then Bit = Bit | 6
  Gf[Mv] = Bit
  Bit = Gf[Mr] | BitT[Mx]
  if Mx < 3 then Bit = Bit & 251
  Gf[Mr] = Bit
  Gos = 0
  Over = 0
  for K = 1 to 6
    PLoc[K] = 0
    PItem[K] = 0
    PCell[K] = 5
  next
  for Pi = 1 to Np
    PLoc[Pi] = 17
  next
  Act = Np
  return
end sub

' after every round the suspects wander (lines 950-970)
sub EndRound:
  u8 K = 0
  u8 B = 0
  for K = 1 to 12
    B = Fnr(16)
    if B = Mv then B = K
    SLoc[K] = B
  next
  for K = 1 to 6
    B = PLoc[K]
    if B >= 1 then
      if B <= 12 then SLoc[B] = B
    end if
  next
  SLoc[Mv] = 0
  return
end sub

' ---------------------------------------------------------------------------
' text: pieces joined with a space, wrapped between pieces

sub NL:
  Cx = 2
  Fresh = 1
  if Cy < 21 then inc Cy
  return
end sub

sub At(u8 Ax, u8 Ay):
  Cx = Ax
  Cy = Ay
  Fresh = 1
  return
end sub

sub PutT(u8 Id):
  u8 Ln = 0
  Ln = TxtLn[Id]
  if Cx + Ln > 30 then NL
  W16 = TxtHi[Id]
  W16 = W16 << 8
  W16 = W16 + TxtLo[Id]
  put Txt + W16 count Ln at Cx,Cy
  Cx = Cx + Ln
  Fresh = 0
  return
end sub

' a piece after a space
sub Wr(u8 Id):
  if Fresh = 0 then
    if Cx + TxtLn[Id] < 30 then
      inc Cx
    else
      NL
    end if
  end if
  PutT(Id)
  return
end sub

' a piece glued to the last one (punctuation)
sub WrNs(u8 Id):
  PutT(Id)
  return
end sub

sub WrNum(u8 N):
  if N >= 10 then
    put char 48 + N / 10 at Cx,Cy
    inc Cx
  end if
  put char 48 + N % 10 at Cx,Cy
  inc Cx
  Fresh = 0
  return
end sub

sub WrLine(u8 Id):
  Wr(Id)
  NL
  return
end sub

' "THE <item>"
sub WrItem(u8 I):
  Wr(XThe)
  if I = 13 then
    Wr(XD1 + Mx - 1)
  else
    Wr(XI1 + I - 1)
  end if
  return
end sub

sub WrPlayer(u8 N):
  Wr(XPlayer)
  WrNum(N)
  return
end sub

sub ClearRows(u8 R0, u8 R1):
  for Ri = R0 to R1
    fill 32 count 28 at 2,Ri
  next
  return
end sub

' ---------------------------------------------------------------------------
' one detective's turn

sub PlayTurn:
  if Act > 1 then HandOff
  MapWalk
  Arrive
  DoOptions
  if Over = 0 then
    print at 5,22, "BUTTON: END YOUR TURN"
    WaitPress
  end if
  return
end sub

sub HandOff:
  NewScreen
  fill TRule count 28 at 2,4
  fill TRule count 28 at 2,17
  At(4,7)
  Wr(XPassTo)
  At(10,9)
  WrPlayer(Pl)
  At(3,12)
  Wr(XLookAway)
  At(2,14)
  Wr(XWhenReady)
  At(10,19)
  Wr(XTurn)
  W16 = Rounds
  print at 15,19, width$(W16, 3)
  ShowScreen
  play sound SndChime
  Stage = 1
  WaitPressQuiet
  return
end sub

' --- the map ---------------------------------------------------------------

function CellCol(u8 Cl) as u8
  return 2 + (Cl & 3) * 7

function CellRow(u8 Cl) as u8
  return 3 + (Cl >> 2) * 5

sub DrawBuilding(u8 Cl):
  u8 Bc = 0
  u8 Br = 0
  u8 Rf = 0
  u8 B = 0
  Bc = CellCol(Cl)
  Br = CellRow(Cl)
  Rf = (Cl + (Cl >> 2)) & 3
  Rf = Rf * 3 + TRoofl_red
  put char Rf at Bc,Br
  fill Rf + 1 count 4 at Bc + 1,Br
  put char Rf + 2 at Bc + 5,Br
  put char TWall at Bc,Br + 1
  put char TWinlit at Bc + 1,Br + 1
  put char TWindark at Bc + 2,Br + 1
  put char TWinlit at Bc + 3,Br + 1
  put char TWindark at Bc + 4,Br + 1
  put char TWall at Bc + 5,Br + 1
  put char TWall at Bc,Br + 2
  put char TWindark at Bc + 1,Br + 2
  put char TDoorl at Bc + 2,Br + 2
  put char TDoorr at Bc + 3,Br + 2
  put char TWinlit at Bc + 4,Br + 2
  put char TWall at Bc + 5,Br + 2
  B = GridB[Cl]
  if Known[B] = 1 then
    W16 = B - 1
    W16 = W16 * 6
    put ShortN + W16 count 6 at Bc,Br + 3
  else
    print at Bc + 2,Br + 3, "??"
  end if
  return
end sub

sub DrawMap:
  u8 Cl = 0
  NewScreen
  for Ri = 2 to 21
    fill TCobble count 28 at 2,Ri
  next
  for Cl = 0 to 15
    DrawBuilding(Cl)
  next
  put char TLamp at 8,7
  put char TLamp at 15,12
  put char TLamp at 22,17
  At(2,1)
  WrPlayer(Pl)
  print at 18,1, "ROUND"
  W16 = Rounds
  print at 24,1, width$(W16, 3)
  ShowScreen
  return
end sub

' the walker's place in front of a door
sub CellXY(u8 Cl):
  Tx = CellCol(Cl) * 8 + 8
  Ty = CellRow(Cl) * 8 + 7
  return
end sub

sub ShowWalker:
  u8 Fr = 0
  Fr = Sy
  if Walk > 0 then
    if Tick & 4 then Fr = Fr - 1
  end if
  set sprite 0 to Fr,Sx,SFace,9
  set sprite 1 to Fr,Sx,SCoat,7
  update sprites
  return
end sub

sub ShowCellName:
  u8 B = 0
  fill 32 count 28 at 2,22
  B = GridB[Mc]
  At(2,22)
  if Known[B] = 1 then
    Wr(XB1 + B - 1)
  else
    Wr(XUnknown)
  end if
  return
end sub

sub MapWalk:
  u8 Nc = 0
  u8 B = 0
  u8 Ok = 0
  DrawMap
  Mc = PCell[Pl]
  CellXY(Mc)
  Sx = Tx
  Sy = Ty
  Walk = 0
  ShowCellName
  ShowWalker
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  Ui = 4
  while Asking = 1
    Frame1
    ReadPad
    if Walk = 0 then
      if Rep = 1 then
        Nc = Mc
        if Stick & 1 then
          if Mc >= 4 then Nc = Mc - 4
        end if
        if Stick & 4 then
          if Mc < 12 then Nc = Mc + 4
        end if
        if Stick & 8 then
          if Mc & 3 then Nc = Mc - 1
        end if
        if Stick & 2 then
          V = Mc & 3
          if V < 3 then Nc = Mc + 1
        end if
        if Nc <> Mc then
          Mc = Nc
          CellXY(Mc)
          Walk = 1
          play sound SndStep
        end if
      end if
      if Press = 1 then
        B = GridB[Mc]
        Ok = 1
        if B = Mv then
          Ok = 0
          if ILoc[14] = Held + Pl then Ok = 1
          if ILoc[14] = Mv then Ok = 1
          if ILoc[14] = Mv + Hid then Ok = 1
        end if
        if Ok = 1 then
          Asking = 0
        else
          play sound SndKnock
          fill 32 count 28 at 2,22
          At(2,22)
          Wr(XLocked)
          Known[B] = 1
        end if
      end if
    end if
    if Walk = 1 then
      MoveWalker
    end if
    ShowWalker
  end while
  Ui = 0
  Bd = GridB[Mc]
  PCell[Pl] = Mc
  PLoc[Pl] = Bd
  Known[Bd] = 1
  HideSprites
  return
end sub

' four pixels a frame toward the next door
sub MoveWalker:
  if Sx < Tx then Sx = Sx + 4
  if Sx > Tx then Sx = Sx - 4
  if Sy < Ty then
    Sy = Sy + 4
    if Sy > Ty then Sy = Ty
  end if
  if Sy > Ty then
    Sy = Sy - 4
    if Sy < Ty then Sy = Ty
  end if
  if Sx = Tx then
    if Sy = Ty then
      Walk = 0
      ShowCellName
    end if
  end if
  return
end sub

' --- arriving (lines 600-695) ---------------------------------------------

sub Arrive:
  u8 K = 0
  u8 It = 0
  NewScreen
  play sound SndDoor
  At(2,1)
  Wr(XYouAre)
  NL
  Wr(XB1 + Bd - 1)
  WrNs(XDot)
  At(2,4)
  Wr(XYouHave)
  It = PItem[Pl]
  if It > 0 then
    WrItem(It)
    WrNs(XDot)
  else
    Wr(XNoItem)
  end if
  At(2,6)
  Wr(XYouSee)
  NL
  SeenS = 0
  SeenI = 0
  SeenPI = 0
  for K = 1 to 12
    if SLoc[K] = Bd then
      Wr(XS1 + K - 1)
      NL
      inc SeenS
      LastS = K
    end if
  next
  for K = 1 to 16
    if ILoc[K] = Bd then
      WrItem(K)
      NL
      inc SeenI
    end if
  next
  for K = 1 to 6
    if K <> Pl then
      if PLoc[K] = Bd then
        WrPlayer(K)
        if PItem[K] > 0 then
          Wr(XWithItem)
          inc SeenPI
        end if
        NL
      end if
    end if
  next
  if SeenS + SeenI = 0 then
    if Cy = 7 then
      if Cx = 2 then Wr(XNothing)
    end if
  end if
  ShowScreen
  print at 5,22, "BUTTON: TURN OPTIONS"
  WaitPress
  return
end sub

' --- the turn options (lines 700-810) --------------------------------------

sub AddOpt(u8 Code, u8 Id):
  MenuV[MenuN] = Code
  At(5,MenuN + 5)
  Wr(Id)
  inc MenuN
  return
end sub

sub DoOptions:
  NewScreen
  At(2,1)
  Wr(XOptions)
  MenuN = 0
  AddOpt(1, XSearch)
  if SeenS > 0 then AddOpt(2, XInterro)
  if SeenI + SeenPI > 0 then AddOpt(3, XTake)
  if Bd = 16 then
    if SeenI > 0 then
      AddOpt(4, XFinger)
    else
      if PItem[Pl] > 0 then AddOpt(4, XFinger)
    end if
    AddOpt(5, XAccuse)
  end if
  if Bd = 14 then AddOpt(6, XCoroner)
  V = 0
  if ILoc[13] = Held + Pl then V = 1
  if ILoc[13] = Bd then V = 1
  if V = 1 then
    AddOpt(7, XRead)
    Wr(XD1 + Mx - 1)
  end if
  if PItem[Pl] > 0 then AddOpt(8, XDrop)
  V = 0
  if Bd <= 2 then V = 1
  if Bd = 7 then V = 1
  if V = 1 then
    AddOpt(9, XExamine)
    Wr(XRecords)
  end if
  At(2,3)
  Wr(XChoose)
  ShowScreen
  DoMenu(MenuN, 5)
  V = MenuV[Ch]
  select case V
    case 1
      DoSearch
    case 2
      DoInterrogate
    case 3
      DoTake(1)
    case 4
      DoPrints
    case 5
      DoAccuse
    case 6
      DoCoroner
    case 7
      DoReadDoc
    case 8
      DoDrop
    case 9
      DoRecords
  end select
  return
end sub

' a screen with a heading
sub Heading(u8 Id):
  NewScreen
  At(2,1)
  Wr(Id)
  return
end sub

' --- search (lines 1000-1050) ----------------------------------------------

sub DoSearch:
  u8 K = 0
  u8 Found = 0
  Heading(XSearch)
  At(2,3)
  Wr(XYouFind)
  NL
  for K = 1 to 16
    if ILoc[K] = Bd + Hid then
      V = 0
      if Rnd(10) < 6 then V = 1
      if PItem[Pl] = 15 then V = 1
      if V = 1 then
        ILoc[K] = Bd
        WrItem(K)
        NL
        Found = 1
      end if
    end if
  next
  if Found = 0 then
    Wr(XNoInt)
    ShowScreen
    return
  end if
  inc Cy
  At(2,Cy)
  Wr(XTakeQ)
  ShowScreen
  if YesNo = 1 then
    DoTake(0)
  end if
  return
end sub

' YES / NO menu under the last line; 1 for yes
function YesNo as u8
  u8 R0 = 0
  R0 = Cy + 2
  print at 5,R0, "YES"
  print at 5,R0 + 1, "NO"
  DoMenu(2, R0)
  if Ch = 0 then return 1
  return 0

' --- take (lines 1400-1470); Others = 1 lists the other detectives' items --

sub DoTake(u8 Others):
  u8 K = 0
  u8 I = 0
  u8 J2 = 0
  Heading(XTake)
  At(2,3)
  Wr(XWhichOne)
  MenuN = 0
  for K = 1 to 16
    if ILoc[K] = Bd then
      MenuV[MenuN] = K
      At(5,MenuN + 5)
      WrItem(K)
      inc MenuN
    end if
  next
  if Others = 1 then
    for K = 1 to 6
      if K <> Pl then
        if PLoc[K] = Bd then
          if PItem[K] > 0 then
            if MenuN < 13 then
              MenuV[MenuN] = Held + K
              At(5,MenuN + 5)
              WrPlayer(K)
              WrNs(XApos)
              Wr(XItemOf)
              inc MenuN
            end if
          end if
        end if
      end if
    next
  end if
  ShowScreen
  if MenuN = 0 then return
  DoMenu(MenuN, 5)
  I = MenuV[Ch]
  if I > Held then
    J2 = I - Held
    I = PItem[J2]
    PItem[J2] = 0
  end if
  NewScreen
  At(2,3)
  K = PItem[Pl]
  if K > 0 then
    Wr(XYouDrop)
    WrItem(K)
    WrNs(XDot)
    ILoc[K] = Bd
    NL
  end if
  Wr(XYouTake)
  WrItem(I)
  WrNs(XDot)
  PItem[Pl] = I
  ILoc[I] = Held + Pl
  ShowScreen
  play sound SndPick
  return
end sub

' --- fingerprints (lines 1100-1170) ----------------------------------------

sub DoPrints:
  u8 K = 0
  u8 I = 0
  Heading(XFinger)
  At(2,3)
  Wr(XWhichOne)
  MenuN = 0
  for K = 1 to 16
    if ILoc[K] = Bd then
      MenuV[MenuN] = K
      At(5,MenuN + 5)
      WrItem(K)
      inc MenuN
    end if
  next
  K = PItem[Pl]
  if K > 0 then
    MenuV[MenuN] = K
    At(5,MenuN + 5)
    WrItem(K)
    inc MenuN
  end if
  ShowScreen
  DoMenu(MenuN, 5)
  I = MenuV[Ch]
  NewScreen
  At(2,1)
  Wr(XLabRep)
  At(2,3)
  WrItem(I)
  NL
  Wr(XBears)
  NL
  ILoc[I] = Bd
  if PItem[Pl] = I then PItem[Pl] = 0
  V = 0
  if I < 13 then
    if Own[I] < 13 then V = Own[I]
  end if
  if I = 13 then V = Mv
  if V > 0 then
    Wr(XS1 + V - 1)
    WrNs(XDot)
  else
    Wr(XNoSusp)
  end if
  ShowScreen
  play sound SndPick
  return
end sub

' --- coroner (lines 1200-1230) ---------------------------------------------

sub DoCoroner:
  u8 Mt = 0
  Heading(XCorRep)
  Mt = Mw & 3
  At(2,4)
  Wr(XSubjIs)
  Wr(XFemale + Sex(Mv))
  WrNs(XComma)
  NL
  Wr(XApprox)
  inc Cx
  WrNum(Age)
  Wr(XYearsOld)
  NL
  NL
  Wr(XSubjWas)
  NL
  Wr(XKv0 + Mt)
  Wr(XByA)
  Wr(XKm0 + Mt)
  WrNs(XDot)
  ShowScreen
  return
end sub

' --- the victim's papers (lines 1500-1540) ---------------------------------

sub DoReadDoc:
  u8 K = 0
  u8 Fl = 0
  u8 Nln = 0
  Heading(XExtract)
  Wr(XD1 + Mx - 1)
  NL
  Wr(XOf)
  Wr(XS1 + Mv - 1)
  WrNs(XColon)
  NL
  NL
  K = DocFirst[Mx]
  Nln = DocCount[Mx]
  for Ri = 1 to Nln
    W16 = K * 28
    put DocTxt + W16 count 28 at 2,Cy
    inc Cy
    inc K
  next
  inc Cy
  Fl = BitT[Mx]
  for K = 1 to 12
    V = Gf[K] & Fl
    if V > 0 then
      At(6,Cy)
      Wr(XS1 + K - 1)
      if Cy < 21 then inc Cy
    end if
  next
  ShowScreen
  return
end sub

' --- drop or hide (lines 1300-1340) ----------------------------------------

sub DoDrop:
  u8 I = 0
  Heading(XDrop)
  I = PItem[Pl]
  At(2,3)
  Wr(XHideQ)
  NL
  Wr(XI1 + I - 1)
  if I = 13 then
    At(2,Cy)
    fill 32 count 28 at 2,Cy
    Wr(XD1 + Mx - 1)
  end if
  WrNs(XQuest)
  ShowScreen
  Yn = YesNo
  PItem[Pl] = 0
  NewScreen
  At(2,3)
  Wr(XYouDrop)
  WrItem(I)
  WrNs(XDot)
  ILoc[I] = Bd
  if Yn = 1 then
    ILoc[I] = Bd + Hid
    NL
    Wr(XHidden)
  end if
  ShowScreen
  return
end sub

' --- records (lines 1600-1720) ---------------------------------------------

sub SuspectMenu(u8 R0):
  u8 K = 0
  for K = 1 to 12
    At(5,R0 + K - 1)
    Wr(XS1 + K - 1)
  next
  return
end sub

sub DoRecords:
  u8 S = 0
  u8 G = 0
  Heading(XExamine)
  Wr(XB1 + Bd - 1)
  At(2,3)
  Wr(XAboutWho)
  SuspectMenu(5)
  ShowScreen
  DoMenu(12, 5)
  S = Ch + 1
  G = Gf[S]
  NewScreen
  At(2,1)
  Wr(XB1 + Bd - 1)
  Wr(XReport)
  NL
  Wr(XOn)
  Wr(XS1 + S - 1)
  WrNs(XColon)
  At(2,5)
  if Bd = 1 then
    V = G & 40
    if V = 0 then
      Wr(XNotRec)
    else
      V = G & 8
      if V > 0 then
        WrLine(XNewWill)
        Wr(XNewWill2)
      else
        WrLine(XInherit1)
        WrLine(XInherit2)
        Wr(XInherit3)
      end if
    end if
  end if
  if Bd = 2 then
    V = G & 64
    if V = 0 then
      Wr(XNotFiles)
    else
      WrLine(XPara1)
      WrLine(XPara2)
      WrLine(XPara3)
      Wr(XPara4)
    end if
  end if
  if Bd = 7 then
    V = G & 7
    if V > 0 then dec V
    Wr(XBk0 + V)
    Wr(XAccount)
  end if
  ShowScreen
  return
end sub

' --- accuse (lines 5000-5210) ----------------------------------------------

sub DoAccuse:
  u8 Ok = 1
  u8 Vi = 0
  u8 Ki = 0
  u8 K = 0
  u8 Sx2 = 0
  Heading(XAccuse2)
  At(2,3)
  Wr(XWhoKilled)
  SuspectMenu(5)
  ShowScreen
  DoMenu(12, 5)
  Vi = Ch + 1
  if Vi <> Mv then Ok = 0
  Heading(XAccuse2)
  At(2,3)
  Wr(XWhoKill)
  Wr(XS1 + Vi - 1)
  WrNs(XQuest)
  SuspectMenu(5)
  ShowScreen
  DoMenu(12, 5)
  Ki = Ch + 1
  if Ki <> Mr then Ok = 0
  Heading(XAccuse2)
  At(2,2)
  Wr(XWhatWeap)
  NL
  Wr(XS1 + Ki - 1)
  Wr(XUse)
  for K = 1 to 12
    At(5,K + 4)
    WrItem(K)
  next
  ShowScreen
  DoMenu(12, 5)
  if Ch + 1 <> Mw then Ok = 0
  Heading(XAccuse2)
  At(2,2)
  Wr(XWhyDid)
  Wr(XS1 + Ki - 1)
  NL
  Wr(XCommit)
  Sx2 = Sex(Ki)
  for K = 0 to 2
    At(5,K + 5)
    Wr(XP0 + Sx2)
    Wr(XF0 + K * 2)
  next
  ShowScreen
  DoMenu(3, 5)
  if Ch + 1 <> Mx then Ok = 0
  ' the arrest
  NewScreen
  At(2,3)
  Wr(XArrest)
  NL
  Wr(XS1 + Ki - 1)
  WrNs(XDots)
  ShowScreen
  play sound SndSiren
  Hold(150)
  At(2,7)
  if Ok = 1 then
    WrLine(XCracked)
    Wr(XCase)
    NL
    WrPlayer(Pl)
    Wr(XWins)
    Over = 1
    play sound SndWin
  else
    WrLine(XFalse1)
    WrLine(XFalse2)
    Wr(XFalse3)
    play sound SndLose
    PLoc[Pl] = 0
    K = PItem[Pl]
    if K > 0 then
      ILoc[K] = Bd
      PItem[Pl] = 0
    end if
    dec Act
    if Act = 0 then Over = 2
  end if
  Hold(60)
  return
end sub

' --- the end: verdict and the solution (lines 5160-5320) ------------------

sub ShowEnding:
  u8 Sx2 = 0
  print at 2,22, "                            "
  At(2,12)
  if Over = 2 then
    WrLine(XAllOut)
    Wr(XAllOut2)
    NL
    Wr(XNobody)
    NL
  else
    if Np = 1 then
      Wr(XSolvedIn)
      W16 = Rounds
      print at Cx + 1,Cy, width$(W16, 3)
      Cx = Cx + 4
      Wr(XTurns)
      NL
      Wr(XRating)
      if Rounds <= 25 then
        Wr(XRateA)
      else
        if Rounds <= 45 then
          Wr(XRateB)
        else
          Wr(XRateC)
        end if
      end if
      NL
    end if
  end if
  inc Cy
  At(2,Cy)
  Wr(XSolution)
  NL
  Wr(XS1 + Mr - 1)
  Wr(XMurdered)
  NL
  Wr(XS1 + Mv - 1)
  Wr(XUsing)
  NL
  Wr(XI1 + Mw - 1)
  WrNs(XComma)
  Wr(XBecause)
  NL
  Sx2 = Sex(Mr)
  Wr(XP0 + Sx2)
  Wr(XF0 + Mx * 2 - 2)
  WrNs(XDot)
  Stage = 9
  return
end sub

' ---------------------------------------------------------------------------
' interrogation (lines 2000-4090)

sub DoInterrogate:
  u8 K = 0
  if SeenS = 1 then
    Q1 = LastS
  else
    Heading(XInterro)
    At(2,3)
    Wr(XWhichOne)
    MenuN = 0
    for K = 1 to 12
      if SLoc[K] = Bd then
        MenuV[MenuN] = K
        At(5,MenuN + 5)
        Wr(XS1 + K - 1)
        inc MenuN
      end if
    next
    ShowScreen
    DoMenu(MenuN, 5)
    Q1 = MenuV[Ch]
  end if
  QMode = 0
  QLeft = 3
  DrawAsk
  while QLeft > 0
    DoMenu(13, 4)
    if Ch = 12 then
      QMode = QMode ^ 1
      DrawAsk
    else
      Q2 = Ch + 1
      dec QLeft
      ClearRows(18, 22)
      At(2,19)
      Yn = 0
      if Rnd(4) < 3 then Yn = 1
      if QMode = 0 then
        AskSuspect
      else
        AskItem
      end if
      ShowLeft
      Hold(20)
    end if
  end while
  return
end sub

sub ShowLeft:
  print at 2,17, "QUESTIONS LEFT:"
  put char 48 + QLeft at 18,17
  return
end sub

sub DrawAsk:
  u8 K = 0
  NewScreen
  At(2,1)
  Wr(XInterr)
  Wr(XS1 + Q1 - 1)
  At(2,2)
  if QMode = 0 then
    Wr(XAboutWho)
    SuspectMenu(4)
    At(5,16)
    Wr(XAnItem)
  else
    Wr(XAboutWhat)
    for K = 1 to 12
      At(5,K + 3)
      WrItem(K)
    next
    At(5,16)
    Wr(XASuspect)
  end if
  ShowLeft
  ShowScreen
  return
end sub

' a weapon Q owns, picked at random among them (line 20900); 0 if none
function OwnedBy(u8 Q) as u8
  u8 Pick = 0
  u8 Seen = 0
  u8 K = 0
  for K = 1 to 12
    if Own[K] = Q then
      inc Seen
      if Rnd(Seen) = 0 then Pick = K
    end if
  next
  return Pick

' a fact line (line 20800): FACTS piece + "."
sub Fact(u8 F):
  Wr(XF0 + F)
  WrNs(XDot)
  return
end sub

sub AskSuspect:
  u8 Sx2 = 0
  u8 R = 0
  u8 I = 0
  Q3 = Fnr(12)
  while Q3 = Mv or Q3 = Q1
    Q3 = Fnr(12)
  end while
  ' "I never gossip" 1 time in 5, unless you hold the badge
  if Rnd(5) = 0 then
    if ILoc[16] <> Held + Pl then
      Gos = Gos ^ 1
      if Gos = 1 then
        Wr(XGossip)
      else
        WrLine(XNoTime)
        Wr(XNoTime2)
      end if
      return
    end if
  end if
  Sx2 = Sex(Q2)
  if Q2 = Q1 then
    AskSelf
    return
  end if
  if Q2 = Mv then
    AskVictim(Sx2)
    return
  end if
  R = Fnr(7)
  select case R
    case 1
      Wr(XS1 + Q2 - 1)
      Wr(XDidIt)
    case 2, 3
      ' a truthful fact about Q2's secrets
      WrLine(XS1 + Q2 - 1)
      I = Fnr(3)
      V = I * 2 - 1
      R = Gf[Q2] & BitT[I]
      if R > 0 then dec V
      Fact(V)
    case 4, 5
      A = OwnedBy(Q2)
      if Rnd(2) = 0 then
        WrLine(XS1 + Q2 - 1)
        Wr(XIs)
        Wr(XH0 + A)
        WrNs(XDot)
      else
        WrLine(XS1 + Q2 - 1)
        Wr(XOwns)
        if Yn = 0 then A = 0
        if A = 0 then
          Wr(XNewCar)
        else
          WrItem(A)
          WrNs(XDot)
        end if
      end if
    case 6
      WrLine(XS1 + Q2 - 1)
      Wr(XIs)
      Wr(XH0 + Hob[Q2])
      WrNs(XDot)
    case 7
      V = 0
      if Al[Q1] >= 3 then
        if Al[Q1] = Al[Q2] then V = 1
      end if
      if V = 1 then
        Wr(XIWasWith)
        Wr(XS1 + Q2 - 1)
        NL
        Wr(XOnNight)
      else
        Wr(XCantConf)
        Wr(XP4 + Sx2)
        Wr(XAlibi)
      end if
  end select
  return
end sub

sub AskVictim(u8 Sx2):
  u8 I = 0
  select case Fnr(3)
    case 1
      I = Rnd(4)
      if Yn = 1 then I = Mw & 3
      Wr(XIHeard)
      Wr(XP0 + Sx2)
      Wr(XWasKilled)
      NL
      Wr(XByA)
      Wr(XKm0 + I)
      WrNs(XDot)
    case 2
      I = Fnr(3)
      if Yn = 1 then I = Mx
      Wr(XIHeard)
      Wr(XP0 + Sx2)
      Wr(XWas)
      NL
      Fact(I + 5)
    case 3
      if Rnd(3) = 0 then
        WrLine(XTragic)
        Wr(XP6 + Sx2)
        Wr(XGone)
      else
        if Rnd(2) = 0 then
          Wr(XSuicide)
        else
          Wr(XIThink)
          Wr(XS1 + Q3 - 1)
          NL
          Wr(XMurdered)
          Wr(XP2 + Sx2)
          WrNs(XDot)
        end if
      end if
  end select
  return
end sub

sub AskSelf:
  select case Fnr(4)
    case 1
      Wr(XIWas)
      Wr(XA0 + Al[Q1])
      NL
      Wr(XOnCrime)
    case 2
      Wr(XIAm)
      Wr(XH0 + Hob[Q1])
      WrNs(XDot)
    case 3
      A = OwnedBy(Q1)
      Wr(XIAm)
      Wr(XH0 + A)
      WrNs(XDot)
    case 4
      A = OwnedBy(Q1)
      Wr(XIOwn)
      if A = 0 then
        Wr(XNewCar)
      else
        WrItem(A)
        WrNs(XDot)
      end if
  end select
  return
end sub

sub DontKnow:
  WrLine(XF9)
  Wr(XF10)
  return
end sub

sub AskItem:
  u8 X2 = 0
  u8 O = 0
  u8 K = 0
  O = Own[Q2]
  select case Fnr(5)
    case 1
      ' who owns it (line 3030)
      V = 0
      if Yn = 0 then V = 1
      if Q2 = Mw then
        if Q1 = Mr then V = 1
      end if
      if O > 12 then V = 1
      if V = 1 then
        WrLine(XNotSure)
        WrItem(Q2)
        WrNs(XDot)
        return
      end if
      if O = Q1 then
        IOwnIt
        return
      end if
      WrLine(XS1 + O - 1)
      Wr(XOwns)
      WrItem(Q2)
      WrNs(XDot)
    case 2
      ' where it is (lines 3060-4020)
      X2 = ILoc[Q2]
      if X2 >= Held then
        X2 = X2 - Held
        if Yn = 0 then X2 = Rnd(Np) + 1
        if X2 = Pl then
          WrLine(XYouHaveT)
          Wr(XI1 + Q2 - 1)
          WrNs(XComma)
          Wr(XDontYou)
        else
          Wr(XIThinkP)
          WrNum(X2)
          Wr(XHas)
          NL
          WrItem(Q2)
          WrNs(XDot)
        end if
        return
      end if
      if X2 >= Hid then X2 = X2 - Hid
      V = 0
      if Yn = 0 then V = 1
      if Q2 = Mw then
        if Q1 = Mr then V = 1
      end if
      if V = 1 then
        DontKnow
        return
      end if
      if X2 = Q1 then
        WrLine(XIveGot)
        Wr(XI1 + Q2 - 1)
        WrNs(XDot)
      else
        WrLine(XISaw)
        Wr(XB1 + X2 - 1)
        WrNs(XDot)
      end if
    case 3
      ' the murder weapon? (line 4030)
      WrItem(Q2)
      Wr(XWas)
      V = 0
      if Q2 = Mw then V = 1
      if V <> Yn then V = 2
      if Q1 = Mr then V = 2
      if V = 2 then Wr(XNot)
      NL
      Wr(XTheWeapon)
    case 4
      ' who collects such things (line 4050)
      X2 = 0
      for K = 1 to 12
        if Hob[K] = Q2 then
          if Rnd(2) = 0 then X2 = K
        end if
      next
      if O > 12 then O = 0
      if Rnd(2) = 0 then X2 = O
      if X2 = 0 then
        DontKnow
        return
      end if
      WrLine(XS1 + X2 - 1)
      Wr(XIs)
      Wr(XH0 + Q2)
      WrNs(XDot)
    case 5
      IOwnIt
  end select
  return
end sub

' "I DO / DO NOT OWN THE ..." (line 3010): the murderer always denies
sub IOwnIt:
  Wr(XI)
  V = 0
  if Own[Q2] <> Q1 then V = 1
  if Q1 = Mr then V = 1
  if V = 1 then Wr(XDoNot)
  Wr(XOwn)
  NL
  WrItem(Q2)
  WrNs(XDot)
  return
end sub

' ---------------------------------------------------------------------------
' menus and waiting

sub DoMenu(u8 N, u8 R0):
  u8 Want = 0
  Ch = 0
  HandY = R0 << 3
  HandY = HandY - 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  Ui = 1
  while Asking = 1
    Frame1
    Rand
    ReadPad
    if Rep = 1 then
      if Stick & 1 then
        if Ch = 0 then
          Ch = N - 1
        else
          dec Ch
        end if
        play sound SndTick
      end if
      if Stick & 4 then
        inc Ch
        if Ch = N then Ch = 0
        play sound SndTick
      end if
    end if
    Want = Ch + R0
    Want = Want << 3
    Want = Want - 1
    if HandY < Want then
      HandY = HandY + 4
      if HandY > Want then HandY = Want
    end if
    if HandY > Want then
      HandY = HandY - 4
      if HandY < Want then HandY = Want
    end if
    set sprite 2 to HandY,20,SHand,11
    update sprites
    if Press = 1 then Asking = 0
  end while
  Ui = 0
  play sound SndPick
  set sprite 2 to 192,0,0,0
  update sprites
  return
end sub

sub WaitPress:
  Ui = 3
  WaitPressQuiet
  fill 32 count 28 at 2,22
  return
end sub

sub WaitPressQuiet:
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Asking = 1
  Ui = 3
  while Asking = 1
    Frame1
    ReadPad
    if Press = 1 then Asking = 0
  end while
  Ui = 0
  Stage = 0
  return
end sub

sub Hold(u8 N):
  for Ji = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Btn = 0
  if joypad(1).fire then Btn = 16
  if joypad(2).fire then Btn = 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  if joypad(1).up then Stick = Stick | 1
  if joypad(1).right then Stick = Stick | 2
  if joypad(1).down then Stick = Stick | 4
  if joypad(1).left then Stick = Stick | 8
  if joypad(2).up then Stick = Stick | 1
  if joypad(2).right then Stick = Stick | 2
  if joypad(2).down then Stick = Stick | 4
  if joypad(2).left then Stick = Stick | 8
  Rep = 0
  if Stick = 0 then
    HoldT = 0
  else
    if WasStick = 0 then
      Rep = 1
      HoldT = 0
    else
      if HoldT < 250 then inc HoldT
      if HoldT >= 18 then
        V = HoldT & 7
        if V = 0 then Rep = 1
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' title, players, credits

sub DrawLane(u8 R0):
  u8 Cl = 0
  u8 Bc = 0
  u8 Rf = 0
  for Cl = 0 to 3
    Bc = Cl * 7 + 2
    Rf = Cl * 3 + TRoofl_red
    put char Rf at Bc,R0
    fill Rf + 1 count 4 at Bc + 1,R0
    put char Rf + 2 at Bc + 5,R0
    put char TWall at Bc,R0 + 1
    put char TWinlit at Bc + 1,R0 + 1
    put char TDoorl at Bc + 2,R0 + 1
    put char TDoorr at Bc + 3,R0 + 1
    put char TWindark at Bc + 4,R0 + 1
    put char TWall at Bc + 5,R0 + 1
  next
  fill TKerb count 28 at 2,R0 + 2
  return
end sub

sub TitlePage:
  Stage = 0
  TitleOn = 1
  NewScreen
  put char TMoon at 25,2
  put char TStar at 5,3
  put char TStar at 14,2
  put char TStar at 20,4
  print at 11,5, "MYSTERY AT"
  print at 8,7, "MYCROFT  MEWS"
  fill TRule count 18 at 7,8
  DrawLane(10)
  print at 4,14, "A WHODUNIT FOR 1-6 PLAYERS"
  print at 6,16, "BY JOHN R. PRAGER"
  print at 7,17, "AHOY! OCTOBER 1985"
  print at 11,20, "START GAME"
  print at 11,21, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  while Asking = 1
    Frame1
    Rand
    ReadPad
    if Rep = 1 then
      if Stick & 1 then Menu = 0
      if Stick & 4 then Menu = 1
      ShowMenu
    end if
    if Press = 1 then Asking = 0
  end while
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,20
  put char 32 at 9,21
  J = Menu + 20
  put char 62 at 9,J
  return
end sub

sub AskPlayers:
  NewScreen
  print at 6,2, "HOW MANY DETECTIVES?"
  print at 5,5, "1  SOLO CASE"
  print at 5,6, "2  DETECTIVES"
  print at 5,7, "3  DETECTIVES"
  print at 5,8, "4  DETECTIVES"
  print at 5,9, "5  DETECTIVES"
  print at 5,10, "6  DETECTIVES"
  print at 2,13, "WITH TWO OR MORE, PASS THE"
  print at 2,14, "CONTROLLER AT EACH TURN: A"
  print at 2,15, "BLANK SCREEN WAITS FOR THE"
  print at 2,16, "NEXT DETECTIVE'S BUTTON."
  ShowScreen
  DoMenu(6, 5)
  Np = Ch + 1
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 5,2, "MYSTERY AT MYCROFT MEWS"
  print at 2,5, "BASED ON THE GAME BY"
  print at 2,6, "JOHN R. PRAGER, AHOY!"
  print at 2,7, "OCTOBER 1985 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: FOG ON THE MEWS"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
MyStep:
    db $00,$00,$45,$02,$00,$00,$75,$02,$10
MyTick:
    db $40,$40,$30,$02,$50
MyPick:
    db $40,$55,$20,$03,$40,$71,$30,$03,$40,$A9,$40,$04,$50
MyDoor:
    db $40,$53,$31,$03,$40,$68,$31,$03,$40,$7C,$41,$03,$40,$AB,$41,$04,$40,$C5,$51,$06,$50
MyKnock:
    db $00,$00,$16,$03,$00,$00,$A6,$06,$00,$00,$16,$03,$00,$00,$A6,$04,$10
MyChime:
    db $40,$8F,$20,$06,$40,$AA,$20,$06,$40,$D6,$30,$0A,$50
MySiren:
    db $40,$A0,$20,$08,$40,$D7,$20,$08,$40,$A0,$20,$08,$40,$D7,$20,$08,$40,$A0,$20,$08,$40,$D7,$20,$08
    db $40,$A0,$30,$08,$40,$D7,$40,$08,$50
MyWin:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$10,$0C,$40,$8F,$20,$06,$40,$6B,$20,$12
    db $50
MyLose:
    db $40,$1D,$21,$0A,$40,$2E,$31,$0A,$40,$41,$31,$0A,$40,$53,$41,$14,$50

MySoundTable:
    dw MyTuneMel,$702B
    dw MyTuneBass,$7035
    dw MyStep,$703F
    dw MyTick,$7049
    dw MyPick,$7049
    dw MyDoor,$7049
    dw MyKnock,$703F
    dw MyChime,$7049
    dw MySiren,$7049
    dw MyWin,$7049
    dw MyLose,$7049
; Fog on the Mews (original)
; Tiny Sound, 10 frames per step
MyTuneMel:
    db $44
    dw sndtiny_1
    db 10
