record Drone
  u8 X
  u8 Y
  u8 S
  u8 MX
  u8 MY
end record

Drone Dr[3]
data TankX bytes 32,112,192
data TankCol bytes 4,14,24
data SpawnX bytes 40,120,200

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 DSpd = 0
bcd digits 8 Score = 0
bcd digits 8 Hi = 0
u8 Oil[3]
u8 PX = 120
u8 ShX = 0
u8 ShY = 0
u8 Frac = 0
u8 Steps = 0
u8 Wave = 0
u8 Left = 0
u8 DrainT = 0
u8 ClrT = 0
u8 Over = 0
u8 Kills = 0
u8 Shots = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Dl = 0
u8 Ds = 0
u8 Tk = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 S = 0
u8 N = 0

  tile screen
  set sound table OdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  print at 8,6, "                "
  print at 8,7, "   GAME  OVER   "
  print at 8,8, "                "
  print at 8,9, " SCORE ", Score, " "
  print at 8,10, " BEST  ", Hi, " "
  print at 8,11, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  if ClrT > 0 then
    dec ClrT
    if ClrT = 0 then NextWave
    return
  end if
  MoveLauncher
  MoveShot
  W16 = Frac
  W16 = W16 + DSpd
  Steps = highbyte(W16)
  Frac = W16 & 255
  while Steps > 0
    for Dl = 0 to 2
      DroneStep
    next
    dec Steps
  end while
  ShotHits
  Bursts
  inc DrainT
  if DrainT >= DrainEvery then
    DrainT = 0
    for Tk = 0 to 2
      if TankTouched(Tk) = 1 then
        if Oil[Tk] > 0 then
          Oil[Tk] = Oil[Tk] - 1
          DrawTank
          play sound SndDrain
        end if
      end if
    next
    N = 0
    for Tk = 0 to 2
      if Oil[Tk] = 0 then inc N
    next
    if N >= 2 then Over = 1
  end if
  return
end sub

sub MoveLauncher:
  select case J1 & 12
    case 4
      if PX > PMin + 1 then
        PX = PX - 2
      else
        PX = PMin
      end if
    case 8
      if PX < PMax - 1 then
        PX = PX + 2
      else
        PX = PMax
      end if
  end select
  return
end sub

' one rocket at a time, 4 pixels a frame; the button held fires again
sub MoveShot:
  if ShY > 0 then
    ShY = ShY - 4
    if ShY < ShotTop then ShY = 0
  end if
  if ShY = 0 then
    if Btn > 0 then
      ShX = PX
      ShY = PY - 12
      inc Shots
      play sound SndFire
    end if
  end if
  return
end sub

' one step of drone Dl: maybe a new heading, then a pixel each way
sub DroneStep:
  if Dr[Dl].S <> 1 then return
  Rand
  V = Rs & 31
  if V < 2 then
    K = highbyte(Rs)
    X = K & 3
    if X = 3 then X = 0
    Dr[Dl].MX = X
    Y = (K >> 4) & 3
    if Y = 3 then Y = 1
    Dr[Dl].MY = Y
  end if
  X = Dr[Dl].X
  Y = Dr[Dl].Y
  select case Dr[Dl].MX
    case 1
      if X >= DMaxX then
        Dr[Dl].MX = 2
      else
        inc X
      end if
    case 2
      if X <= DMinX then
        Dr[Dl].MX = 1
      else
        dec X
      end if
  end select
  select case Dr[Dl].MY
    case 1
      if Y >= DMaxY then
        Dr[Dl].MY = 2
      else
        inc Y
      end if
    case 2
      if Y <= DMinY then
        Dr[Dl].MY = 1
      else
        dec Y
      end if
  end select
  Dr[Dl].X = X
  Dr[Dl].Y = Y
  return
end sub

' Hits: the rocket's box against each drone's drawn box
sub ShotHits:
  if ShY = 0 then return
  for Ds = 0 to 2
    if ShY > 0 then
      if Dr[Ds].S = 1 then
        X = Dr[Ds].X
        Y = Dr[Ds].Y
        if HitDrone(X, Y) = 1 then
          Dr[Ds].S = ExT
          ShY = 0
          Score += 999
          if Score > Hi then Hi = Score
          inc Kills
          if Left > 0 then dec Left
          play sound SndBoom
          ShowStatus
        end if
      end if
    end if
  next
  return
end sub

function HitDrone(u8 Ex, u8 Ey) as u8
  if ShX + 12 < Ex then return 0
  if ShX > Ex + 12 then return 0
  if ShY + 10 < Ey + 3 then return 0
  if ShY + 2 > Ey + 12 then return 0
  return 1

' bursts count down, then the drone comes back from the top while more
' are left than are flying
sub Bursts:
  for Ds = 0 to 2
    S = Dr[Ds].S
    if S > 1 then
      dec S
      if S = 1 then
        N = Flying()
        if Left > N then
          Rand
          X = Rs & 127
          Dr[Ds].X = X + 56
          Dr[Ds].Y = DMinY
          Dr[Ds].MX = highbyte(Rs) & 1
          Dr[Ds].MX = Dr[Ds].MX + 1
          Dr[Ds].MY = 1
        else
          S = 0
        end if
      end if
      Dr[Ds].S = S
    end if
  next
  if Left = 0 then
    N = Dr[0].S | Dr[1].S
    N = N | Dr[2].S
    if N = 0 then
      if ClrT = 0 then
        ClrT = 120
        print at 9,6, " WAVE CLEARED "
        play sound SndWave
      end if
    end if
  end if
  return
end sub

function Flying() as u8
  C = 0
  for J = 0 to 2
    if Dr[J].S = 1 then inc C
  next
  return C

' 1 when a flying drone touches tank T
function TankTouched(u8 T) as u8
  for J = 0 to 2
    if Dr[J].S = 1 then
      X = Dr[J].X
      Y = Dr[J].Y
      W16 = X + 13
      if W16 >= TankX[T] then
        if X + 2 <= TankX[T] + 31 then
          if Y + 12 >= TankTop then return 1
        end if
      end if
    end if
  next
  return 0

' the gauge window of tank Tk shows its oil, 8 units a tile row
sub DrawTank:
  C = TankCol[Tk] + 1
  for J = 0 to 2
    N = (2 - J) * 8
    if Oil[Tk] <= N then
      V = 0
    else
      V = Oil[Tk] - N
      if V > 8 then V = 8
    end if
    put char TOil0 + V at C,J + 14
    put char TOil0 + V at C + 1,J + 14
  next
  return
end sub

sub NextWave:
  inc Wave
  if Wave = 1 then
    Left = 10
  else
    if Left < 245 then Left = 5 * Wave + 5
  end if
  W16 = Wave
  W16 = W16 * 32 + 160
  if W16 > 640 then W16 = 640
  DSpd = W16
  for Ds = 0 to 2
    Dr[Ds].X = SpawnX[Ds]
    Dr[Ds].Y = DMinY
    Dr[Ds].S = 1
    Rand
    Dr[Ds].MX = (Rs & 1) + 1
    Dr[Ds].MY = 1
    if Wave > 1 then
      if Oil[Ds] > Full - Refill then
        Oil[Ds] = Full
      else
        Oil[Ds] = Oil[Ds] + Refill
      end if
      Tk = Ds
      DrawTank
    end if
  next
  ShY = 0
  print at 9,6, "              "
  ShowStatus
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the launcher, 2 the rocket, 3-8 the drones (detail, body)
sub DrawSprites:
  set sprite 0 to PY,PX,SLaA,14
  set sprite 1 to PY,PX,SLaG,3
  if ShY > 0 then
    set sprite 2 to ShY,ShX,SShot,15
  else
    set sprite 2 to 192,0,0,0
  end if
  K = (Tick >> 4) & 1
  K = K * 8
  for Ds = 0 to 2
    J = Ds * 2 + 3
    X = Dr[Ds].X
    Y = Dr[Ds].Y
    S = Dr[Ds].S
    select case S
      case 0
        set sprite J to 192,0,0,0
        set sprite J + 1 to 192,0,0,0
      case 1
        V = SDr0w + K
        set sprite J to Y,X,V,15
        V = SDr0m + K
        set sprite J + 1 to Y,X,V,13
      case else
        V = SEx1i
        if S > 12 then V = SEx0i
        set sprite J to Y,X,V,11
        V = V + 4
        set sprite J + 1 to Y,X,V,8
    end select
  next
  update sprites
  return
end sub

sub ShowStatus:
  print at 2,1, "SCORE ", Score
  NumU = Wave
  print at 17,1, "W", digits$(NumU, 2)
  NumU = Left
  print at 21,1, "LEFT ", digits$(NumU, 3)
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  Score = 0
  Wave = 0
  Left = 0
  PX = 120
  ShY = 0
  Frac = 0
  DrainT = 0
  ClrT = 0
  Over = 0
  Kills = 0
  Shots = 0
  for Tk = 0 to 2
    Oil[Tk] = Full
  next
  NextWave
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: OIL DEFENSE in oil drums, a drone drifting, the tune once
sub TitlePage:
  Menu = 0
  NewScreen
  print at 3,1, "COMPUTE!'S GAZETTE 3/1988"
  copy TitleMap count 384 to vram.name + 64
  print at 5,15, "DEFEND THE OIL TANKS!"
  print at 13,18, "START"
  print at 13,19, "HOW TO PLAY"
  print at 13,20, "CREDITS"
  if Hi > 0 then
    print at 8,21, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 560
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  PX = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  inc PX
  if PX > 224 then PX = 16
  K = (Tick >> 4) & 1
  K = K * 8
  V = SDr0w + K
  set sprite 3 to 104,PX,V,15
  V = SDr0m + K
  set sprite 4 to 104,PX,V,13
  update sprites
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,18
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 18
  put char 62 at 11,J
  return
end sub

' a small oil tank for the HOW TO PLAY pages: top left at Tc,Tr, Tv units
' of 8 in each of its three windows
sub HowTank(u8 Tc, u8 Tr, u8 Tv):
  put char TRimL at Tc,Tr
  put char TRimM at Tc + 1,Tr
  put char TRimM at Tc + 2,Tr
  put char TRimR at Tc + 3,Tr
  for J = 1 to 3
    put char TWallL at Tc,Tr + J
    put char TOil0 + Tv at Tc + 1,Tr + J
    put char TOil0 + Tv at Tc + 2,Tr + J
    put char TWallR at Tc + 3,Tr + J
  next
  put char TBaseL at Tc,Tr + 4
  put char TBaseM at Tc + 1,Tr + 4
  put char TBaseM at Tc + 2,Tr + 4
  put char TBaseR at Tc + 3,Tr + 4
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "SABOTEUR DRONES FLY OVER"
    print at 2,4, "THE TOWN. A DRONE TOUCHING"
    print at 2,5, "AN OIL TANK DRAINS ITS OIL."
    print at 2,7, "LEFT/RIGHT MOVES YOUR"
    print at 2,8, "LAUNCHER. THE BUTTON FIRES"
    print at 2,9, "A ROCKET STRAIGHT UP. HOLD"
    print at 2,10, "IT TO KEEP FIRING."
    print at 2,12, "EACH DRONE YOU HIT: 999."
    HowTank(6, 15, 8)
    HowTank(22, 15, 3)
    fill TGnd0 count 28 at 2,20
    set sprite 0 to 143,120,SLaA,14
    set sprite 1 to 143,120,SLaG,3
    set sprite 2 to 111,120,SShot,15
    set sprite 3 to 103,168,SDr0w,15
    set sprite 4 to 103,168,SDr0m,13
  else
    print at 2,1, "WAVES                  2/2"
    print at 2,3, "DESTROY ALL THE DRONES OF A"
    print at 2,4, "WAVE TO CLEAR IT: 10 IN THE"
    print at 2,5, "FIRST, 5 MORE EACH WAVE."
    print at 2,6, "A CLEARED WAVE PUMPS SOME"
    print at 2,7, "OIL BACK INTO EACH TANK."
    print at 2,9, "WHEN TWO TANKS ARE EMPTY,"
    print at 2,10, "THE GAME IS OVER."
    print at 2,12, "TIP: SHOOT THE LOWEST DRONE"
    print at 2,13, "FIRST, BEFORE IT REACHES"
    print at 2,14, "A TANK."
    HowTank(13, 16, 0)
    set sprite 3 to 119,112,SEx0i,11
    set sprite 4 to 119,112,SEx0o,8
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "OIL DEFENSE"
  print at 2,5, "BASED ON OIL DEFENSE,"
  print at 2,6, "COMPUTE!'S GAZETTE MARCH"
  print at 2,7, "1988 (COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE; NO AUTHOR NAMED"
  print at 2,9, "ON THE DISK)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: NIGHT SHIFT AT THE"
  print at 2,19, "TANK FARM (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

