cartridge "MOUNTAINEER MACK/S. DEVINE/1986"

' MOUNTAINEER MACK
' A ColecoVision game based on "Mountaineer Mack" by Stephen Devine,
' Ahoy! October 1986 (Commodore 64 machine code; disk ahoy1986-10, files
' MOUNTAINEER MACK and MNTEER MACK BOOT; the author from the issue's
' contents page). orig/ has the program, its disassembly and jsc64
' screenshots. Made for Amy Studio by Claude (an AI made by Anthropic),
' 2026, in Amy by Amy Bienvenu.
'
' "As rocks rain on his head ... Mountaineer Mack must scramble to the top
' of six hills" (the issue's preview).
'
' Not a line-by-line port: the rules are the original's (read from its
' code), the game is built for the ColecoVision: Mack climbs a row in 8
' frames and walks a pixel and a half a frame, the mountainside is drawn
' in tiles (pines, stones, snow, scree, tufts) on two name pages written
' while hidden and swapped, the summit has a drawn snowy peak against the
' sky, sound effects and a title tune.
'
' From the original: Mack moves left and right anywhere along the slope
' and climbs up and down within the lower ten rows of the screen; climbing
' above that scrolls the mountain down a row (20 feet, 5 points). The
' slope is endless forest scenery; the dangers are sprites: a campfire,
' two pines side by side (one in the left two thirds, one at the far
' right), a bear or a snake (chosen at random) and a boulder that falls
' all the time, 2 pixels a frame, from a random place at the top. Fire,
' pines and the animal are fixed to the mountain and scroll with it; when
' one passes below Mack's lowest row it comes back above the top of the
' screen at a new random place. Touching any of them: Mack slides down to
' the foot of the screen and the whole mountain scrolls back down to
' elevation 0; then a man is lost (three men, no extra ones). Mountain n
' is n x 1000 feet high (50 n rows). 100 feet below the top the dangers
' stop coming back and the boulder stops; the last five rows are the
' summit, narrowing against the sky. At the top: a bonus of 50 x the
' mountain's number if no man has been lost all game (the original's
' "MEN = 3" test), then FOR NEXT LEVEL and the button. After the sixth
' mountain the count starts at 1 again and the boulder falls a pixel a
' frame faster.
'
' Liberties: Mack climbs a row in 8 frames (the C64 climbed about 25 rows
' a second with the stick held); the sprites are 16 x 16 at 1x (on the
' C64 every sprite was doubled, 48 x 42), so there is more room between
' the dangers; touching is a box test (the C64 tested pixels); the boulder
' falls at most 4 pixels a frame; on reaching the top Mack walks to the
' peak and plants a flag before the bonus (new), the bonus is counted in
' 5 points at a time as on the C64; the whole mountainside is new at each
' mountain (the C64 kept the bottom 8 rows); the score has six digits
' (the C64's four wrapped at 9999); the high score shows on the title; the
' horizontal scale is 0.8 of the C64's (its 320 pixels into 208 here).
'
' Controls: the joystick (either controller): left and right walk, up and
' down climb. Either button continues at the top of a mountain. On the
' title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off; play screens are drawn on the hidden name
' page and swapped. Music first in the sound table, effects after; the
' title tune is played once. `set sprite count` is always given. Nothing
' flashes.

const TPlain = 128
const TPine = 129
const TPines = 130
const TStone = 131
const TPebbles = 132
const TSnow = 133
const TTuft = 134
const TScree = 135
const TCrack = 136
const TSky = 137
const TSlL1 = 138
const TSlL2 = 139
const TSlR1 = 140
const TSlR2 = 141
const TLM00 = 142
const TLM10 = 143
const TLO00 = 144
const TLO10 = 145
const TLU00 = 146
const TLU10 = 147
const TLN00 = 148
const TLN10 = 149
const TLT00 = 150
const TLT10 = 151
const TLA00 = 152
const TLA10 = 153
const TLI00 = 154
const TLI10 = 155
const TLE00 = 156
const TLE10 = 157
const TLR00 = 158
const TLR10 = 159
const TLC00 = 160
const TLC10 = 161
const TLK00 = 162
const TLK10 = 163
const SMackD0 = 0
const SMackB0 = 4
const SMackD1 = 8
const SMackB1 = 12
const SMackD2 = 16
const SMackB2 = 20
const SMackD3 = 24
const SMackB3 = 28
const STree = 32
const SRock0 = 36
const SRock1 = 40
const SFlame0 = 44
const SFlame1 = 48
const SLogs = 52
const SBear0 = 56
const SBear1 = 60
const SSnake0 = 64
const SSnake1 = 68
const SFlag = 72
const NTiles8 = 288
const SprBytes = 608
const SndTuneA = 1
const SndTuneB = 2
const SndHit = 3
const SndWhoosh = 4
const SndStep = 5
const SndSlide = 6
const SndSummit = 7
const SndTick = 8
const SndStart = 9
const SndLost = 10
const SndOver = 11
const NSpr = 9
const NRow = 21
const BandTop = 9
const MackY0 = 144
const StepF = 8
const WalkV = 24
const MinX16 = 256
const MaxX16 = 3584
const StartX16 = 1792
const HideY = -32
const BackY = 150
const RockEnd = 168
const PeakX = 112
const PeakX16 = 1792
' Mack's sprite on the tip of the peak (row 3 after three rows of sky)
const PeakY = 8
const SkyPat = 13
' states of a pass of play
const StPlay = 1
const StHit = 2
const StSlide = 3
const StDesc = 4
const StPeak = 5
const StBonus = 6
const StWait = 7
const StReady = 8

record Haz:
  u8 X
  i16 Y
  u8 Kind
end record

' the dangers' boxes inside their 16 x 16 sprites, by kind: fire, pine,
' bear, snake, boulder
data BoxX0 bytes
  3,4,1,2,2
end data
data BoxX1 bytes
  12,11,14,13,13
end data
data BoxY0 bytes
  5,1,5,4,2
end data
data BoxY1 bytes
  14,15,13,14,13
end data

u16 TzLeft = 0
u8 TzOn = 0
' the dangers: 0 fire, 1 left pine, 2 right pine, 3 the animal (Kind 0
' bear, 1 snake), 4 the boulder
Haz Hz[5]
' the mountainside on screen: a ring of NRow rows, each a pattern and an
' offset into it; Top is the screen's row 0
u8 RowPat[NRow]
u8 RowOff[NRow]
u8 Top = 0
u16 Seed = 4321
' Mack: x in 1/16 pixel, his row in the climbing band (0-9), the climb
' (0 none, 1 up, 2 down) and its frame, his sprite's top
u16 Mx16 = StartX16
u8 Band = 0
u8 Sd = 0
u8 Sk = 0
u8 MackY = MackY0
u8 Moving = 0
u8 Frm = 0
u8 FlagOn = 0
' the climb
u16 Elev = 0
u16 Goal = 1000
u8 Mtn = 1
u8 Cycle = 0
u8 RockV = 2
u8 Men = 3
u8 Summit = 0
' the new top row of a climb under way
u8 PendPat = 0
u8 PendOff = 0
u8 SumN = 0
bcd digits 6 Score = 0
bcd digits 6 HiScore = 0
u8 St = StReady
u8 StT = 0
u8 PkS = 0
u8 Bn = 0
u8 Msg = 0
u8 Over = 0
' input
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Hi = 0
u8 Gi = 0
' scratch
u16 W16 = 0
u16 NumU = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  set screen pages vram.name and vram $1C00
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 1 then goto game_over
  goto play_loop

game_over:
  Phase = 4
  if Score > HiScore then HiScore = Score
  Msg = 4
  Redraw
  DrawSprites
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift, stirred on the title

function Rnd as u8
  u8 Lo = 0
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  Lo = Seed & 255
  return Lo

' Lo + a number 0 .. Span - 1
function RandIn(u8 Lo, u8 Span) as u8
  u8 Rv = 0
  Rv = Rnd()
  Rv = Rv % Span
  return Lo + Rv

' ---------------------------------------------------------------------------
' the mountainside

' a fresh row of slope (one random number: pattern in the low 3 bits,
' offset in the high 5)
sub NewRow(u8 Slot):
  u8 Rn = 0
  Rn = Rnd()
  RowPat[Slot] = Rn & 7
  RowOff[Slot] = Rn >> 3
  return
end sub

sub NewSlope:
  for Ri = 0 to 20
    NewRow(Ri)
  next
  Top = 0
  return
end sub

' the play screen on the hidden page: the rows (MkBlit: the ring's 21 rows
' streamed into the page, each a 32-byte slice of Rows), the score and
' the elevation, the message of the moment
sub Compose:
  call asm MkBlit
  print Score at 8,21
  print Elev at 21,22 digits 4
  select case Msg
  case 1
    print at 8,8, "              "
    print at 8,9, "  MOUNTAIN " + digits$(Mtn, 1) + "  "
    print at 8,10, " GOAL " + digits$(Goal, 4) + " FT "
    print at 8,11, "              "
  case 2
    print at 6,8, "                  "
    print at 6,9, "  FOR NEXT LEVEL  "
    print at 6,10, "                  "
    print at 6,11, " PRESS THE BUTTON "
    print at 6,12, "                  "
  case 3
    print at 6,8, "                  "
    print at 6,9, " BONUS AWARDED !! "
    print at 6,10, "                  "
    NumU = Bn * 5
    print at 6,11, "       " + digits$(NumU, 4) + "       "
    print at 6,12, "                  "
  case 4
    print at 8,8, "              "
    print at 8,9, "  GAME  OVER  "
    print at 8,10, "              "
  end select
  return
end sub

' the status lines' fixed parts (and the numbers that change seldom)
sub FullHud:
  fill 32 count 96 at 0,21
  print at 2,21, "SCORE"
  print at 18,21, "HIGH"
  print HiScore at 23,21
  print at 2,22, "MEN " + digits$(Men, 1)
  print at 9,22, "MTN " + digits$(Mtn, 1)
  print at 16,22, "ELEV"
  print at 25,22, "/" + digits$(Goal, 4)
  return
end sub

' both pages composed in full, one shown
sub Redraw:
  FullHud
  Compose
  ShowPage
  FullHud
  Compose
  return
end sub

' show the page just composed
sub ShowPage:
  swap screens
  return
end sub

' a climb from the top of the band has begun: its new top row is chosen
' now (a summit row near the top) and the page after the scroll is
' written on the hidden page while Mack climbs; the ring itself changes
' only when the climb ends (ClimbScroll)
sub PrepScroll:
  u8 Slot = 0
  u8 KeepPat = 0
  u8 KeepOff = 0
  u8 Rn = 0
  Slot = Top
  if Slot = 0 then Slot = NRow
  dec Slot
  KeepPat = RowPat[Slot]
  KeepOff = RowOff[Slot]
  if Summit = 1 then
    PendPat = 8 + SumN
    PendOff = 0
  else
    Rn = Rnd()
    PendPat = Rn & 7
    PendOff = Rn >> 3
  end if
  RowPat[Slot] = PendPat
  RowOff[Slot] = PendOff
  Top = Slot
  call asm MkBlit
  RowPat[Slot] = KeepPat
  RowOff[Slot] = KeepOff
  inc Top
  if Top = NRow then Top = 0
  return
end sub

' one row climbed: the slope moves down a row (the new row on top), the
' fixed dangers with it (those below Mack's lowest row come back above
' the top), 20 feet and 5 points; the page prepared by PrepScroll shown
sub ClimbScroll:
  if Top = 0 then
    Top = NRow - 1
  else
    dec Top
  end if
  RowPat[Top] = PendPat
  RowOff[Top] = PendOff
  if Summit = 1 then
    if SumN < 4 then inc SumN
  end if
  ' the fire
  if Hz[0].Y >= BackY then
    Hz[0].Y = HideY
    Hz[0].X = RandIn(16, 209)
  elseif Moves(0) = 1 then
    Hz[0].Y = Hz[0].Y + 8
  end if
  ' the pines go together
  if Hz[1].Y >= BackY then
    Hz[1].Y = HideY
    Hz[2].Y = HideY
    PlacePines
  elseif Moves(1) = 1 then
    Hz[1].Y = Hz[1].Y + 8
    Hz[2].Y = Hz[1].Y
  end if
  ' the animal
  if Hz[3].Y >= BackY then
    Hz[3].Y = HideY
    Hz[3].X = RandIn(16, 209)
    Hz[3].Kind = Rnd() & 1
  elseif Moves(3) = 1 then
    Hz[3].Y = Hz[3].Y + 8
  end if
  Elev = Elev + 20
  Score += 5
  print Score at 8,21
  print Elev at 21,22 digits 4
  ShowPage
  return
end sub

' near the summit a danger waiting above the screen stays there (one
' return at the end: bugs/mack-experimental-prologue.alexis)
function Moves(u8 Which) as u8
  u8 Mv = 1
  if Summit = 1 then
    if Hz[Which].Y = HideY then Mv = 0
  end if
  return Mv

sub PlacePines:
  Hz[1].X = RandIn(16, 135)
  Hz[2].X = RandIn(196, 29)
  return
end sub

' a row back down (after a fall): the dangers move up, those above the
' top wrap to the bottom, a new row at the bottom
sub DescScroll:
  u8 Slot = 0
  for Hi = 0 to 3
    if Hz[Hi].Y < -30 then
      Hz[Hi].Y = 152
    else
      Hz[Hi].Y = Hz[Hi].Y - 8
    end if
  next
  Slot = Top
  NewRow(Slot)
  inc Top
  if Top >= NRow then Top = 0
  Elev = Elev - 20
  Compose
  ShowPage
  return
end sub

' ---------------------------------------------------------------------------
' one pass of play

sub PlayStep:
  inc Anim
  select case St
  case StPlay
    MoveRock
    MoveMack
  case StHit
    MoveRock
    inc StT
    if StT >= 30 then
      St = StSlide
      Frm = 2
      play sound SndSlide
    end if
  case StSlide
    MoveRock
    MackY = MackY + 2
    if MackY >= MackY0 then
      MackY = MackY0
      Band = 0
      St = StDesc
      StT = 0
    end if
  case StDesc
    if Elev = 0 then
      LoseMan
    else
      DescScroll
      inc StT
      V = StT & 3
      if V = 1 then play sound SndWhoosh
    end if
  case StPeak
    PeakStep
  case StBonus
    inc StT
    if StT >= 4 then
      StT = 0
      Score += 5
      dec Bn
      play sound SndTick
      if Bn = 0 then
        St = StWait
        Msg = 2
      end if
      Compose
      ShowPage
    end if
  case StWait
    if Press = 1 then NextMountain
  case StReady
    inc StT
    if StT >= 60 then
      Msg = 0
      St = StPlay
      Compose
      ShowPage
    end if
  end select
  return
end sub

' the boulder falls all the time; near the summit it waits above the screen
sub MoveRock:
  if Summit = 1 then
    Hz[4].Y = HideY
    return
  end if
  Hz[4].Y = Hz[4].Y + RockV
  if Hz[4].Y >= RockEnd then
    Hz[4].Y = HideY
    Hz[4].X = RandIn(16, 209)
  end if
  return
end sub

' walk (left and right first, as on the C64), else climb a row
sub MoveMack:
  Moving = 0
  if Sd = 0 then
    V = Pad & 4
    if V > 0 then
      Moving = 1
      if Mx16 >= MinX16 + WalkV then
        Mx16 = Mx16 - WalkV
      else
        Mx16 = MinX16
      end if
    else
      V = Pad & 8
      if V > 0 then
        Moving = 1
        Mx16 = Mx16 + WalkV
        if Mx16 > MaxX16 then Mx16 = MaxX16
      else
        V = Pad & 1
        if V > 0 then
          Sd = 1
        else
          V = Pad & 2
          if V > 0 then
            if Band > 0 then Sd = 2
          end if
        end if
        Sk = 0
      end if
    end if
  end if
  if Sd > 0 then
    Moving = 1
    inc Sk
    if Sk = 1 then
      if Sd = 1 then
        if Band = BandTop then PrepScroll
      end if
    end if
    if Sk >= StepF then
      if Sd = 1 then
        if Band < BandTop then
          inc Band
        else
          ClimbScroll
        end if
      else
        dec Band
      end if
      Sd = 0
      Sk = 0
    end if
  end if
  if Moving = 1 then
    V = Anim & 7
    if V = 0 then
      Frm = Frm ^ 1
      play sound SndStep
    end if
  end if
  MackY = MackY0 - Band * 8
  if Sd = 1 then
    if Band < BandTop then MackY = MackY - Sk
  elseif Sd = 2 then
    MackY = MackY + Sk
  end if
  ' the top reached, or near it
  if Elev = Goal then
    St = StPeak
    PkS = 0
    StT = 0
    Sd = 0
    return
  end if
  W16 = Goal - 100
  if Elev = W16 then Summit = 1
  for Hi = 0 to 4
    if Touch(Hi) = 1 then
      St = StHit
      StT = 0
      play sound SndHit
      return
    end if
  next
  return
end sub

' 1 when danger Which's box meets Mack's (columns 5-10, rows 1-15)
function Touch(u8 Which) as u8
  u8 Kd = 0
  u8 Mx = 0
  i16 Dy = 0
  i16 A = 0
  i16 B = 0
  ' far above or below: no (the boxes are under 16 high)
  Dy = Hz[Which].Y - MackY
  if Dy < -16 then return 0
  if Dy > 16 then return 0
  Kd = Which
  if Which = 2 then Kd = 1
  if Which = 3 then Kd = 2 + Hz[3].Kind
  Mx = Mx16 >> 4
  ' across
  A = Hz[Which].X + BoxX0[Kd]
  B = Mx + 10
  if A > B then return 0
  A = Hz[Which].X + BoxX1[Kd]
  B = Mx + 5
  if A < B then return 0
  ' up and down
  A = Dy + BoxY0[Kd]
  if A > 15 then return 0
  A = Dy + BoxY1[Kd]
  if A < 1 then return 0
  return 1

' at the top: walk to the middle of the peak, the view rises three rows,
' climb to its tip, plant the flag, then the bonus (no man lost in the
' game) or the button
sub PeakStep:
  select case PkS
  case 0
    Frm = (Anim >> 3) & 1
    if Mx16 + 16 <= PeakX16 then
      Mx16 = Mx16 + 16
    elseif Mx16 >= PeakX16 + 16 then
      Mx16 = Mx16 - 16
    elseif Mx16 <> PeakX16 then
      Mx16 = PeakX16
    else
      PkS = 1
    end if
  case 1
    ' the view rises above the peak: three rows of sky, a row every 8
    ' frames, Mack and the dangers on the screen moving down with it
    Frm = (Anim >> 3) & 1
    inc StT
    if StT < 8 then return
    StT = 0
    SkyRow
    inc Bn
    if Bn = 3 then
      Bn = 0
      PkS = 2
    end if
  case 2
    Frm = (Anim >> 3) & 1
    if MackY > PeakY then
      dec MackY
    else
      PkS = 3
      FlagOn = 1
      Frm = 3
      play sound SndSummit
    end if
  case else
    inc StT
    if StT < 90 then return
    StT = 0
    if Men = 3 then
      St = StBonus
      Bn = Mtn * 10
      Msg = 3
    else
      St = StWait
      Msg = 2
    end if
    Compose
    ShowPage
  end select
  return
end sub

sub SkyRow:
  if Top = 0 then Top = NRow
  dec Top
  RowPat[Top] = SkyPat
  RowOff[Top] = 0
  for Hi = 0 to 4
    if Hz[Hi].Y > -16 then Hz[Hi].Y = Hz[Hi].Y + 8
  next
  MackY = MackY + 8
  Compose
  ShowPage
  return
end sub

' back at elevation 0 after a fall: a man less
sub LoseMan:
  dec Men
  play sound SndLost
  if Men = 0 then
    Over = 1
    return
  end if
  ResetLife
  Compose
  ShowPage
  return
end sub

' Mack at the foot of the screen in the middle, the dangers where the C64
' put them (fire and boulder above the top, the pines and the animal on
' the screen) at new random places
sub ResetLife:
  Mx16 = StartX16
  Band = 0
  Sd = 0
  Sk = 0
  MackY = MackY0
  Frm = 0
  FlagOn = 0
  Summit = 0
  SumN = 0
  Hz[0].Y = HideY
  Hz[1].Y = 40
  Hz[2].Y = 40
  Hz[3].Y = 96
  Hz[4].Y = HideY
  Hz[3].Kind = Rnd() & 1
  Hz[0].X = RandIn(16, 209)
  PlacePines
  Hz[3].X = RandIn(16, 209)
  Hz[4].X = RandIn(16, 209)
  St = StPlay
  return
end sub

sub NextMountain:
  inc Mtn
  if Mtn > 6 then
    Mtn = 1
    inc Cycle
    if RockV < 4 then inc RockV
  end if
  StartMountain
  return
end sub

sub StartMountain:
  Goal = Mtn * 1000
  Elev = 0
  NewSlope
  ResetLife
  St = StReady
  StT = 0
  Msg = 1
  Redraw
  play sound SndStart
  return
end sub

sub NewGame:
  Score = 0
  Men = 3
  Mtn = 1
  Cycle = 0
  RockV = 2
  Over = 0
  Phase = 1
  NewScreen
  StartMountain
  DrawSprites
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0-1 Mack (navy detail over the red body), 2 the boulder, 3-4
' the fire (flames, logs), 5-6 the pines, 7 the animal, 8 the flag

sub DrawSprites:
  if Msg >= 2 then
    ' a message box: the dangers are put away
    for Gi = 2 to 7
      set sprite Gi to 192,0,0,0
    next
    DrawMack
    update sprites
    return
  end if
  DrawMack
  V = (Anim >> 2) & 1
  V = SRock0 + V * 4
  PutHaz(2, 4, V, 1)
  V = (Anim >> 4) & 1
  V = SFlame0 + V * 4
  PutHaz(3, 0, V, 9)
  PutHaz(4, 0, SLogs, 6)
  PutHaz(5, 1, STree, 12)
  PutHaz(6, 2, STree, 12)
  V = (Anim >> 4) & 1
  if Hz[3].Kind = 0 then
    V = SBear0 + V * 4
    PutHaz(7, 3, V, 6)
  else
    V = SSnake0 + V * 4
    PutHaz(7, 3, V, 2)
  end if
  update sprites
  return
end sub

' Mack (navy detail over the red body) and his flag
sub DrawMack:
  X = Mx16 >> 4
  K = Frm * 8
  V = SMackD0 + K
  set sprite 0 to MackY,X,V,4
  V = SMackB0 + K
  set sprite 1 to MackY,X,V,8
  if FlagOn = 1 then
    X = X + 11
    set sprite 8 to MackY,X,SFlag,15
  else
    set sprite 8 to 192,0,0,0
  end if
  return
end sub

' a danger's sprite; above the screen (by more than its height) or below
' the slope it is hidden
sub PutHaz(u8 Spr, u8 Which, u8 Pat, u8 Col):
  i16 Hy = 0
  u8 Sy = 0
  Hy = Hz[Which].Y
  if Hy < -15 then
    set sprite Spr to 192,0,0,0
    return
  end if
  if Hy > 168 then
    set sprite Spr to 192,0,0,0
    return
  end if
  Sy = Hy & 255
  set sprite Spr to Sy,Hz[Which].X,Pat,Col
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Pad = 0
  if joypad(1).up then Pad = Pad | 1
  if joypad(1).down then Pad = Pad | 2
  if joypad(1).left then Pad = Pad | 4
  if joypad(1).right then Pad = Pad | 8
  if joypad(1).fire then Pad = Pad | 16
  if joypad(2).up then Pad = Pad | 1
  if joypad(2).down then Pad = Pad | 2
  if joypad(2).left then Pad = Pad | 4
  if joypad(2).right then Pad = Pad | 8
  if joypad(2).fire then Pad = Pad | 16
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen: both name pages blank, the tiles in all three thirds
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  swap screens
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the name over the summit, Mack and his flag on the peak, the
' tune once, START / CREDITS
sub TitlePage:
  Phase = 5
  NewScreen
  DrawTitle
  ShowPage
  DrawTitle
  Mx16 = PeakX16
  MackY = 63
  Frm = 3
  FlagOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 1024
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  V = Rnd()
  X = Mx16 >> 4
  set sprite 0 to MackY,X,SMackD3,4
  set sprite 1 to MackY,X,SMackB3,8
  X = X + 11
  set sprite 8 to MackY,X,SFlag,15
  update sprites
  V = Pad & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
      ShowPage
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the title page (drawn on both name pages, so the menu can change on
' either)
sub DrawTitle:
  put LogoA1 count 11 at 10,2
  put LogoA2 count 11 at 10,3
  put LogoB1 count 4 at 14,4
  put LogoB2 count 4 at 14,5
  print at 7,7, "AHOY! OCTOBER 1986"
  fill TSky count 64 at 0,8
  ' the summit rows, the narrowest on top, then the slope
  for Gi = 0 to 4
    V = 4 - Gi
    W16 = (8 + V) * 64
    Y = Gi + 10
    put Rows + W16 count 32 at 0,Y
  next
  for Gi = 15 to 20
    V = Gi & 7
    W16 = V * 64 + Gi
    put Rows + W16 count 32 at 0,Gi
  next
  print at 12,16, "         "
  print at 12,17, "  START  "
  print at 12,18, "  CREDITS"
  print at 12,19, "         "
  print at 9,21, "HIGH"
  print HiScore at 14,21
  ShowMenu
  return
end sub

' the arrow on the page being written
sub ShowMenu:
  put char 32 at 13,17
  put char 32 at 13,18
  J = Menu + 17
  put char 62 at 13,J
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  print at 7,2, "MOUNTAINEER  MACK"
  print at 2,5, "BASED ON MOUNTAINEER MACK BY"
  print at 2,6, "STEPHEN DEVINE, AHOY!"
  print at 2,7, "OCTOBER 1986 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: SWITCHBACK TRAIL"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowPage
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

