asm {
; MkBlit: rows 0-20 of the name page being written (VDP_NAME_SHADOW) from
; the ring: row r shows slot (Top + r) mod 21, the 32 bytes at Rows +
; RowPat * 64 + RowOff. One VRAM address, then 672 bytes at 32 cycles each
; (slow enough for the VDP with the display on: 29 or more). The NMI is off.
MkBlit:
    ld hl,(VDP_NAME_SHADOW)
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld a,(AMY_UVAR_Top)
    ld c,a
    ld e,21
MkBlitRow:
    ld b,0
    ld hl,AMY_UVAR_RowPat
    add hl,bc
    ld l,(hl)
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld hl,AMY_UVAR_RowOff
    add hl,bc
    ld a,(hl)
    pop hl
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    push bc
    ld bc,AMY_UDATA_Rows
    add hl,bc
    ld bc,$2000 + VDP_DATA_PORT
MkBlitByte:
    outi
    nop
    jr nz,MkBlitByte
    pop bc
    inc c
    ld a,c
    cp 21
    jr c,MkBlitNext
    ld c,0
MkBlitNext:
    dec e
    jr nz,MkBlitRow
    ret
MkHit:
    db $00,$00,$04,$03,$00,$00,$15,$04,$00,$00,$36,$06,$00,$00,$66,$08,$10
MkWhoosh:
    db $00,$00,$76,$02,$00,$00,$A6,$02,$10
MkStep:
    db $40,$7F,$60,$01,$40,$A9,$A0,$01,$50
MkSlide:
    db $40,$50,$20,$03,$40,$59,$30,$03,$40,$66,$30,$03,$40,$72,$40,$03,$40,$81,$40,$03,$40,$91,$50,$03
    db $40,$A5,$50,$03,$40,$BA,$60,$03,$40,$D3,$70,$03,$40,$EE,$80,$03,$50
MkSummit:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$20,$0A,$40,$5F,$30,$05,$40,$47,$20,$10
    db $50
MkTick:
    db $40,$40,$40,$01,$40,$40,$F0,$01,$50
MkStart:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$30,$0C,$50
MkLost:
    db $40,$1D,$21,$08,$40,$53,$31,$08,$40,$AB,$31,$10,$50
MkOver:
    db $40,$D6,$20,$0C,$40,$F0,$20,$0C,$40,$1D,$21,$0C,$40,$53,$21,$24,$50

MkSoundTable:
    dw MkTuneMel,$702B
    dw MkTuneBass,$7035
    dw MkHit,$703F
    dw MkWhoosh,$703F
    dw MkStep,$7049
    dw MkSlide,$7049
    dw MkSummit,$7049
    dw MkTick,$7049
    dw MkStart,$7049
    dw MkLost,$7049
    dw MkOver,$7049
; Switchback Trail (original)
; Tiny Sound, 8 frames per step
MkTuneMel:
    db $44
    dw sndtiny_1
    db 8
