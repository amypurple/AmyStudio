  $91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F,$91,$92,$8F,$8F,$8F,$8F,$8F,$8F
  $91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90,$91,$92,$90,$90,$90,$90,$90,$90
end data

data FloorMap bytes
  $9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B,$9C,$9B,$9B,$9B
  $9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D,$9D
end data

data TitleMap bytes
  $20,$20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$20,$A8,$A8,$A8,$20,$A8,$A8,$A8,$20,$A8,$A8,$A8,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$20,$A8,$20,$A8,$20,$A8,$20,$20,$20,$20,$A8,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$20,$A8,$A8,$A8,$20,$A8,$A8,$A8,$20,$20,$A8,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$20,$A8,$20,$A8,$20,$20,$20,$A8,$20,$20,$A8,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$A8,$A8,$A8,$20,$A8,$20,$A8,$20,$A8,$A8,$A8,$20,$20,$A8,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$A8,$20,$A8,$20,$A8,$20,$20,$A8,$20,$20,$20,$A8,$20,$A8,$A8,$A8,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$A8,$A8,$20,$A8,$20,$A8,$20,$A8,$A8,$20,$A8,$20,$20,$20,$A8,$20,$A8,$20,$A8,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$A8,$20,$A8,$A8,$20,$A8,$20,$A8,$20,$A8,$A8,$20,$20,$20,$A8,$20,$A8,$A8,$A8,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$A8,$20,$A8,$20,$A8,$20,$20,$A8,$20,$A8,$20,$A8,$20,$A8,$20,$A8,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$A8,$20,$20,$A8,$20,$A8,$20,$A8,$20,$20,$A8,$20,$A8,$A8,$A8,$20,$A8,$20,$A8,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
end data

record Dart:
  u8 X
  u8 Y
  u8 Spd
end record

Dart Darts[2]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Col = 0
u16 PitSkip = 65535
u16 PitK = 0
u16 NumU = 0
u8 Fine = 0
u8 NeedDraw = 0
u8 NX = 96
u8 Lift = 0
u8 Crouch = 0
u8 Act = 0
u8 ActT = 0
u8 Pose = 0
u8 WalkC = 10
u8 WalkF = 0
u8 StrT = 0
u8 StrCd = 0
u8 StX = 0
u8 StY = 0
u8 Phase = 0
u8 Lv = 255
u8 StartLv = 255
u8 EX = 0
u8 EHp = 0
u8 ETm = 0
u8 EAn = 0
u8 PX = 0
u8 PSp = 1
u8 Life = 38
u8 HurtT = 0
u8 Over = 0
u8 Beaten = 0
u8 BestRank = 0
u8 Played = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Dl = 0
u8 Gc = 0
u8 Rw = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Ht = 0
u8 Hb = 0
u8 FloorBuf[32]

  tile screen
  set sound table NjSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if NeedDraw > 0 then DrawScene
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the rank reached, then back to the title on a press
  mute all
  BestRank = RankOf(Lv)
  Played = 1
  if Over = 2 then
    BestRank = 9
    print at 4,9, "  ALL TEN FOES BEATEN  "
    play sound SndWin
  else
    print at 4,9, "    YOUR CHI IS GONE   "
    play sound SndOver
  end if
  print at 4,10, "                       "
  print at 4,11, " YOU HAVE ATTAINED THE "
  print at 4,12, "                       "
  print at 4,13, "      RANK OF          "
  print at 4,14, "                       "
  RankName(BestRank, 11, 14)
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play (one pass of the C64's main loop)
sub PlayStep:
  if HurtT > 0 then dec HurtT
  if StrT > 0 then
    dec StrT
    if StrT = 0 then StrCd = 16
  else
    if StrCd > 0 then dec StrCd
  end if
  Hero
  if Phase = 0 then
    MoveDarts
  else
    MoveFoe
  end if
  MoveStar
  Collide
  if Life = 0 then Over = 1
  return
end sub

' the hero's moves: a jump, a leap, a fall, or the stick on the ground
sub Hero:
  select case Act
  case 1
    inc ActT
    select case ActT
    case 20, 40, 60
      Lift = Lift + 10
    case 80
      Land
    end select
  case 2
    Advance
    inc ActT
    select case ActT
    case 20, 45, 70
      Lift = Lift + 10
    case 95
      Land
    end select
    if Lift = 0 then PitTest
  case 4
    inc ActT
    if ActT = 48 then
      Act = 0
      Lift = 0
      PitSkip = PitK
      NeedDraw = 1
      NX = 76
      Drain(10)
    end if
  case else
    Ground
  end select
  return
end sub

sub Land:
  Act = 0
  Lift = 0
  ActT = 0
  PitTest
  return
end sub

sub Ground:
  Crouch = 0
  Pose = 0
  ' the C64 hero waits while his star flies
  if StX > 0 then
    Pose = 2
    return
  end if
  if StrT > 0 then
    Pose = 1
    return
  end if
  K = J1 & 15
  select case K
  case 5
    Act = 1
    ActT = 0
    play sound SndLeap
    return
  case 9
    Act = 2
    ActT = 0
    play sound SndLeap
    return
  case 1
    Pose = 2
    if Press = 1 then
      StX = NX + 12
      StY = HeroY + 2
      play sound SndThrow
    end if
    return
  case 2, 6, 10
    Crouch = 1
    return
  end select
  if Press = 1 then
    if StrCd = 0 then
      StrT = 12
      Pose = 1
      play sound SndSwish
      return
    end if
  end if
  V = K & 12
  if V = 4 then
    if NX > NXMin then dec NX
    WalkStep
  end if
  if V = 8 then
    if NX < NXMax then
      inc NX
    else
      Advance
    end if
    WalkStep
    PitTest
  end if
  return
end sub

sub WalkStep:
  dec WalkC
  if WalkC = 0 then
    WalkC = 10
    WalkF = WalkF ^ 1
    play sound SndStep
  end if
  return
end sub

' one pixel of progress: a column every 8, a foe every 256 columns
sub Advance:
  inc Fine
  if Fine < 8 then return
  Fine = 0
  inc Col
  NeedDraw = 1
  W16 = Col & 255
  if W16 = 0 then LevelUp
  return
end sub

' feet over an open pit (the middle 40 of its 48 pixels): fall
sub PitTest:
  W16 = Col << 3
  W16 = W16 + NX + 8
  PitK = W16 >> 9
  if PitK = PitSkip then return
  W16 = W16 & 511
  if W16 < PitL then return
  if W16 >= PitR then return
  Act = 4
  ActT = 0
  Lift = 0
  Crouch = 0
  StrT = 0
  play sound SndFall
  return
end sub

sub LevelUp:
  inc Lv
  if Lv = 10 then
    Over = 2
    return
  end if
  Phase = 1
  EX = 224
  EHp = Lv
  ETm = EDel[Lv]
  EAn = 0
  PX = EX - 8
  PSp = Lv >> 1
  inc PSp
  ShowRank
  play sound SndFoe
  return
end sub

' the wisp (3 pixels a frame) and the star (2): back at the right edge at a
' random height when they leave
sub MoveDarts:
  for Dl = 0 to 1
    V = Darts[Dl].Spd + 16
    if Darts[Dl].X < V then
      NewDart(Dl)
    else
      Darts[Dl].X -= Darts[Dl].Spd
    end if
  next
  return
end sub

sub NewDart(u8 D)
  Rand
  Darts[D].X = 224
  V = Rs & 127
  Darts[D].Y = V + 24
  if D = 1 then
    if Lv < 10 then Darts[D].Y = Darts[D].Y + Lv
  end if
  return
end sub

sub MoveFoe:
  dec ETm
  if ETm = 0 then
    ETm = EDel[Lv]
    if EX <= NXMin then
      ' it got past: it leaves, as on the C64
      Phase = 0
      ResetDarts
      return
    end if
    dec EX
    if Lv <= 4 then EAn = EAn ^ 1
  end if
  ' the missile; a new one only while the foe is 40 pixels or more away
  V = PSp + 16
  if PX < V then
    PX = 0
    V = NX + 40
    if EX >= V then PX = EX - 8
  else
    PX = PX - PSp
  end if
  return
end sub

sub MoveStar:
  if StX = 0 then return
  StX = StX + 6
  if StX >= 226 then StX = 0
  return
end sub

' 1-D overlap of A0..A1 and B0..B1
function Hits(u8 A0, u8 A1, u8 B0, u8 B1) as u8
  if A1 < B0 then return 0
  if B1 < A0 then return 0
  return 1

function HeroTop as u8
  Ht = HeroY - Lift
  if Crouch = 1 then Ht = Ht + 14
  return Ht

function RankOf(u8 L) as u8
  if L >= 10 then return 0
  return L

sub Collide:
  if Act = 4 then return
  Ht = HeroTop
  Hb = 143 - Lift
  X = NX + 4
  if Phase = 0 then
    for Gc = 0 to 1
      J = Darts[Gc].X
      K = Darts[Gc].Y
      if Hits(X, X + 7, J + 4, J + 11) = 1 then
        if Hits(Ht, Hb, K + 6, K + 9) = 1 then
          NewDart(Gc)
          if StrT = 0 then
            Hurt
          else
            play sound SndClang
          end if
        end if
      end if
      if StX > 0 then
        J = Darts[Gc].X
        K = Darts[Gc].Y
        if Hits(StX + 5, StX + 10, J + 4, J + 11) = 1 then
          if Hits(StY + 5, StY + 10, K + 6, K + 9) = 1 then
            NewDart(Gc)
            play sound SndClang
          end if
        end if
      end if
    next
    return
  end if
  ' a foe: its missile, then the foe itself
  if PX = 0 then goto no_missile
  if Hits(X, X + 7, PX + 4, PX + 11) = 1 then
    if Hits(Ht, Hb, MisY + 5, MisY + 10) = 1 then
      PX = 0
      if StrT = 0 then
        Hurt
      else
        play sound SndClang
      end if
    end if
  end if
  if StX > 0 then
    if Hits(StX + 5, StX + 10, PX + 4, PX + 11) = 1 then
      StX = 0
      PX = 0
      play sound SndClang
    end if
  end if
no_missile:
  if StX > 0 then
    if Hits(StX + 5, StX + 10, EX + 3, EX + 12) = 1 then
      StX = 0
      FoeHit
      if Phase = 0 then return
    end if
  end if
  if Hits(X, X + 7, EX + 3, EX + 12) = 1 then
    if Hits(Ht, Hb, FoeY, FoeY + 29) = 1 then
      if EX < 214 then
        EX = EX + 10
      else
        EX = 224
      end if
      if PX > EX then PX = EX - 8
      if StrT > 0 then
        FoeHit
      else
        Hurt
      end if
    end if
  end if
  return
end sub

sub FoeHit:
  if EHp = 0 then
    ' beaten: chi back by its number
    ' chi back: its number + 5 (a liberty; the C64 gave its number)
    V = MaxLife - Life
    K = Lv + 5
    if K < V then
      Life = Life + K
    else
      Life = MaxLife
    end if
    inc Beaten
    Phase = 0
    ResetDarts
    ShowLife
    ShowRank
    play sound SndBeat
    return
  end if
  dec EHp
  play sound SndHit
  return
end sub

sub Hurt:
  Drain(1)
  HurtT = 10
  play sound SndHurt
  ' knocked back 10 pixels, but not in the air (a liberty)
  if Act <> 0 then return
  if NX >= 26 then
    NX = NX - 10
  else
    NX = NXMin
  end if
  return
end sub

sub Drain(u8 N)
  if Life <= N then
    Life = 0
  else
    Life = Life - N
  end if
  ShowLife
  return
end sub

sub ResetDarts:
  NewDart(0)
  NewDart(1)
  Darts[1].X = 160
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' the gallery, rows 3-17 from SceneMap at the scroll column, the floor rows
' with the open pits (world columns 40-45 of every 64, not the closed one)
sub DrawScene:
  W16 = Col & 31
  if NeedDraw = 1 then
    ' first frame: the sky and the top of the gallery
    for Rw = 0 to 7
      NumU = Rw * 64
      NumU = NumU + W16
      copy SceneMap + NumU count 32 to vram.name + (Rw + 3) * 32
    next
    NeedDraw = 2
    return
  end if
  ' second frame: the rest and the floor
  NeedDraw = 0
  for Rw = 8 to 14
    NumU = Rw * 64
    NumU = NumU + W16
    copy SceneMap + NumU count 32 to vram.name + (Rw + 3) * 32
  next
  FloorRow(0)
  copy FloorBuf count 32 to vram.name + 576
  FloorRow(1)
  copy FloorBuf count 32 to vram.name + 608
  return
end sub

sub FloorRow(u8 R)
  u16 Pk = 0
  i16 S = 0
  u8 T = 0
  NumU = R * 64
  NumU = NumU + (Col & 3)
  copy FloorMap + NumU count 32 to FloorBuf
  ' the pits of this 64-column stretch and the next
  Pk = Col >> 6
  for Gc = 0 to 1
    if Pk <> PitSkip then
      S = Pk * 64
      S = S + 40
      S = S - Col
      for Rw = 0 to 5
        if S >= 0 then
          if S < 32 then
            T = TPitM
            if Rw = 0 then T = TPitL
            if Rw = 5 then T = TPitR
            if R = 1 then T = TPitB
            FloorBuf[S] = T
          end if
        end if
        inc S
      next
    end if
    inc Pk
  next
  return
end sub

' sprites: 0-2 the hero (detail, body top, legs), 3 his star, 4-5 the
' missiles (wisp and star, or the foe's), 6-7 the foe
sub DrawSprites:
  Y = HeroTop
  V = 5
  if HurtT > 0 then V = 8
  if Act = 4 then
    ' sinking into the pit
    K = ActT >> 1
    Y = HeroY + K
    if ActT < 30 then
      set sprite 0 to Y - 1,NX,SHreadyd,15
      set sprite 1 to Y - 1,NX,SHreadyb,V
      set sprite 2 to Y + 15,NX,SLtuck,V
    else
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
      set sprite 2 to 192,0,0,0
    end if
  else
    K = Pose * 8
    set sprite 0 to Y - 1,NX,SHstandd + K,15
    set sprite 1 to Y - 1,NX,SHstandb + K,V
    if Crouch = 1 then
      set sprite 2 to 135,NX,SLcrouch,V
    else
      J = SLstand
      if Lift > 0 then
        J = SLtuck
      else
        V = J1 & 12
        if V > 0 then
          if Pose = 0 then J = SLwalk1 + WalkF * 4
        end if
      end if
      V = 5
      if HurtT > 0 then V = 8
      Y = Y + 16
      set sprite 2 to Y - 1,NX,J,V
    end if
  end if
  if StX > 0 then
    set sprite 3 to StY - 1,StX,SStar,15
  else
    set sprite 3 to 192,0,0,0
  end if
  if Phase = 0 then
    set sprite 4 to Darts[0].Y - 1,Darts[0].X,SWisp,3
    set sprite 5 to Darts[1].Y - 1,Darts[1].X,SStar2,15
    set sprite 6 to 192,0,0,0
    set sprite 7 to 192,0,0,0
  else
    if PX > 0 then
      set sprite 4 to MisY - 1,PX,PPat[Lv],PCol[Lv]
    else
      set sprite 4 to 192,0,0,0
    end if
    set sprite 5 to 192,0,0,0
    FoeSprites
  end if
  update sprites
  return
end sub

sub FoeSprites:
  V = FCol[Lv]
  select case Lv
  case 0
    J = SFt
    K = SFb1 + EAn * 4
  case 5 to 8
    J = SDt
    K = SDb1 + (EX & 4)
  case else
    J = SFts
    K = SFb1 + EAn * 4
  end select
  set sprite 6 to FoeY - 1,EX,J,V
  set sprite 7 to FoeY + 15,EX,K,V
  return
end sub

sub ShowLife:
  for Gc = 0 to 18
    V = Gc * 2
    if Life >= V + 2 then
      put char TG2 at Gc + 6,22
    else
      if Life > V then
        put char TG1 at Gc + 6,22
      else
        put char TG0 at Gc + 6,22
      end if
    end if
  next
  put char TGE at 25,22
  return
end sub

sub ShowRank:
  fill 32 count 10 at 2,1
  RankName(RankOf(Lv), 2, 1)
  for Gc = 0 to 9
    if Gc < Beaten then
      put char TDone at Gc + 19,1
    else
      put char TFoe at Gc + 19,1
    end if
  next
  return
end sub

' the rank's name at Cx,Row
sub RankName(u8 R, u8 Cx, u8 Row)
  select case R
  case 0
    print at Cx,Row, "ADEPT"
  case 1
    print at Cx,Row, "SHUGYO"
  case 2
    print at Cx,Row, "YUDANSHA"
  case 3
    print at Cx,Row, "TIGER"
  case 4
    print at Cx,Row, "DRAGON"
  case 5
    print at Cx,Row, "NINJA"
  case 6
    print at Cx,Row, "SHINOBI"
  case 7
    print at Cx,Row, "SENSEI"
  case 8
    print at Cx,Row, "SHIDOSHI"
  case else
    print at Cx,Row, "JONIN"
  end select
  return
end sub

sub NewGame:
  NewScreen
  Col = 0
  Fine = 0
  PitSkip = 65535
  NX = 96
  Lift = 0
  Crouch = 0
  Act = 0
  ActT = 0
  Pose = 0
  WalkC = 10
  WalkF = 0
  StrT = 0
  StrCd = 0
  StX = 0
  Phase = 0
  Lv = StartLv
  Life = MaxLife
  ' tests only: StartLv (written by bot.mjs) starts just before foe StartLv + 1
  if Lv < 10 then
    W16 = Lv
    Col = W16 << 8
    Col = Col + 200
  end if
  HurtT = 0
  Over = 0
  Beaten = 0
  Darts[0].Spd = 3
  Darts[1].Spd = 2
  ResetDarts
  NeedDraw = 1
  DrawScene
  DrawScene
  print at 2,22, "CHI"
  ShowLife
  ShowRank
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: LAST NINJA in light-blue blocks, (AHOY! 1986), the author,
' START / CREDITS, the last rank reached, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 384 to vram.name + 64
  print at 9,15, "(AHOY! 1986)"
  print at 3,17, "BY CLEVELAND M. BLAKEMORE"
  print at 13,19, "START"
  print at 13,20, "CREDITS"
  if Played = 1 then
    print at 6,22, "LAST RANK:"
    RankName(BestRank, 17, 22)
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 19
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 4,2, "LAST NINJA (AHOY! 1986)"
  print at 2,5, "BASED ON THE LAST NINJA BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! SEPTEMBER 1986"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE). NOT RELATED TO"
  print at 2,10, "SYSTEM 3'S GAME OF THE"
  print at 2,11, "SAME NAME."
  print at 2,13, "COLECOVISION GAME, MUSIC"
  print at 2,14, "AND PICTURES BY CLAUDE"
  print at 2,15, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,16, "IN AMY BY AMY BIENVENU,"
  print at 2,17, "2026."
  print at 2,19, "MUSIC: NIGHT GALLERY"
  print at 2,20, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

