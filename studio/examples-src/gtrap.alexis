' ticks of the original's main loop per video frame (delay 170)
const TPF = 16
' the time bar: units, ticks per unit (POKE 3258: the C64 used 42; 63
' gives a human 18 s a screen instead of 12)
const TimeFull = 280
const TimeRate = 63
' the square: 32 steps a move, one step every 9 ticks
const PSteps = 32
const PStep = 9
' the sphere: 56 steps a hop, first one step every 10 ticks; the limit of
' POKE 4211 (the C64's 2 let it reach 3 ticks a step, a hop in 11 frames,
' faster than the square can move; 7 stops it at 8, a hop in 28 frames)
const BSteps = 56
const BSpeed0 = 10
const BallLimit = 7
' the grid on screen: block (row 1, column 1) stamp corner, in tiles
const GridX = 3
const GridY = 5
const StartP = 28
const StartB = 14

