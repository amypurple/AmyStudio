' thrust per heading in 1/16 C64 pixels a step (C64 $1063, $1073: y up)
data ThX bytes -3,-5,-6,-7,-6,-5,-3,0,3,5,6,7,6,5,3,0
data ThY bytes 5,4,2,0,-2,-4,-5,-6,-5,-4,-2,0,2,4,5,6
' launch point from the ship's centre, pixels (C64 $10C7/$10D7 x 3/4)
data NoseX bytes -3,-6,-7,-7,-7,-6,-2,0,4,7,8,8,8,7,4,0
data NoseY bytes -7,-6,-2,0,2,5,6,7,6,5,2,0,-2,-5,-7,-8
' gravity: from the distance class, the lowest step count that pulls
data GravThr bytes 0,1,2,4,7
' fireball life in steps by range option (256 = 0)
data RangeT bytes 96,160,0
data ShipCol bytes 8,5
data BallCol bytes 9,7

