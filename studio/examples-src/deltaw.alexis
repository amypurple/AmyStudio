end data

record Pilot:
  u8 Dir
  u8 Hit
  u8 Wins
  u8 Pad
end record
Pilot Pl[2]

' objects 0-1 the ships, 2-7 the fireballs (even ones red's, odd blue's)
u16 OX[8]
u16 OY[8]
i8 VX[8]
i8 VY[8]
u8 Alive[8]
u8 Life[8]
' pixel positions, worked out after each move
u8 PX[8]
u8 PY[8]

' options
u8 OptPlayers = 0
u8 OptEdge = 0
u8 OptGrav = 0
u8 OptRange = 0
u8 OptMins = 1
u8 OptHyper = 0
u8 Row = 0
u8 Menu = 0

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 NumU = 0
u8 Mn = 0
u8 Sc = 0
u8 Jiffy = 0
u8 Acc = 0
u8 Ctr = 0
u8 Pass = 0
u8 Boom = 0
u8 Over = 0
u8 StarT = 0
u8 StarF = 0
u8 Kills = 0
' input
u8 J0 = 0
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u8 CpuJ = 0
' loop counters (never shared with the helpers)
u8 Ob = 0
u8 Ob2 = 0
u8 Ds = 0
' scratch
i16 W = 0
u16 Mx = 0
u16 My = 0
i8 Mvx = 0
i8 Mvy = 0
i16 Dx = 0
i16 Dy = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
i8 Sv = 0
u8 Hd = 0
' fireball position for DwHits
u8 HAx = 0
u8 GTimes = 0
u8 HAy = 0

  tile screen
  set sound table DwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the winner, then back to the title on a press
  mute all
  play sound SndOver
  print at 9,10, "            "
  print at 9,11, "  TIME  UP  "
  print at 9,12, "            "
  if Pl[0].Wins > Pl[1].Wins then
    print at 9,13, "  RED WINS  "
  else
    if Pl[1].Wins > Pl[0].Wins then
      print at 9,13, "  BLUE WINS "
    else
      print at 9,13, "  A DRAW    "
    end if
  end if
  print at 9,14, "            "
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayFrame:
  if Boom > 0 then
    dec Boom
    if Boom = 0 then NewRound
    return
  end if
  Acc = Acc + 4
  Pass = 0
  if Acc >= 5 then
    Acc = Acc - 5
    Pass = 1
  end if
  if Pass = 1 then
    if OptPlayers = 0 then CpuPilot
    ShipStep(0, J0)
    if OptPlayers = 0 then
      ShipStep(1, CpuJ)
    else
      ShipStep(1, J1)
    end if
    for Ob = 2 to 7
      BallStep
    next
    Ctr = (Ctr + 1) & 7
  end if
  call asm DwMoveAll
  Collide
  Clock
  return
end sub

' a step of one ship: turn (even steps), thrust, hyperspace, gravity, fire
sub ShipStep(u8 P, u8 Stick)
  u8 D = 0
  u8 Odd = 0
  i8 Nv = 0
  D = Pl[P].Dir
  Odd = Ctr & 1
  if Odd = 0 then
    select case Stick & 12
      case 4
        D = (D + 1) & 15
      case 8
        D = (D - 1) & 15
    end select
    Pl[P].Dir = D
  end if
  if Stick & 1 then
    Nv = VX[P] + ThX[D]
    if Nv < 32 and Nv > -32 then VX[P] = Nv
    Nv = VY[P] + ThY[D]
    if Nv < 32 and Nv > -32 then VY[P] = Nv
    if P = 0 then play sound SndHiss
  end if
  if Stick & 2 then
    if OptHyper = 0 and Ctr = 0 then Hyper(P)
  end if
  if Odd = 1 then
    Ob2 = P
    Gravity(1)
    if Stick & 16 then Launch(P, D)
  end if
  return
end sub

' a fireball's step: its life, then gravity twice (it moves twice a step)
sub BallStep:
  if Alive[Ob] = 0 then return
  inc Life[Ob]
  K = OptRange
  V = RangeT[K]
  if Life[Ob] = V then
    Alive[Ob] = 0
    return
  end if
  V = Ctr & 1
  if V = 1 then
    Ob2 = Ob
    Gravity(2)
  end if
  return
end sub

' the first free slot of the pilot's three (P+2, P+4, P+6)
function FreeSlot(u8 P) as u8
  u8 S = 0
  S = P + 2
  while S < 8
    if Alive[S] = 0 then return S
    S = S + 2
  end while
  return 0

sub Launch(u8 P, u8 D)
  u8 S = 0
  i16 T = 0
  S = FreeSlot(P)
  if S > 0 then
  Alive[S] = 1
  Life[S] = 0
  T = NoseX[D]
  OX[S] = OX[P] + T * 256
  T = NoseY[D]
  OY[S] = OY[P] + T * 256
  SetPix(S)
  VX[S] = ThX[D] * 3
  VY[S] = ThY[D] * 3
  play sound SndZap
  end if
  return
end sub

sub Hyper(u8 P)
  u8 Hb = 0
  Rand
  Hb = highbyte Rs
  OX[P] = XMin + Hb * 212
  Rand
  Hb = highbyte Rs
  OY[P] = YMin + Hb * 148
  SetPix(P)
  play sound SndWarp
  return
end sub

' the heading (0-15) that points along Dx, Dy (pixels, y down)
function DirTo(i16 Ax, i16 Ay) as u8
  u16 Bx = 0
  u16 By = 0
  u8 Kq = 0
  u8 A = 0
  Bx = abs(Ax)
  By = abs(Ay)
  if By * 5 < Bx then
    Kq = 0
  else
    if By * 3 < Bx * 2 then
      Kq = 1
    else
      if By * 2 < Bx * 3 then
        Kq = 2
      else
        if By < Bx * 5 then
          Kq = 3
        else
          Kq = 4
        end if
      end if
    end if
  end if
  ' maths angle in 22.5 degree steps, y up
  if Ax >= 0 then
    if Ay <= 0 then
      A = Kq
    else
      A = 16 - Kq
    end if
  else
    if Ay <= 0 then
      A = 8 - Kq
    else
      A = 8 + Kq
    end if
  end if
  return (A + 11) & 15

' pull object Ob2 toward the centre (odd steps only), Times times (a
' fireball moves, and is pulled, twice a step). The heading toward the
' centre and the distance class (C64: halvings of the distance until under
' 8 x 7 C64 pixels; here 6 x 5 screen pixels) come from GravMap, one byte
' per 4 x 4 pixel cell (art.py)
sub Gravity(u8 Times)
  GTimes = Times
  call asm DwGrav
  return
end sub

' moving every object one frame: DwMoveAll in move.asm (the asm block at
' the end; position += speed x 8 for ships, x 16 for fireballs, 1/256
' pixels, y up; bounce or wrap; PX/PY the high bytes)

' the pixel position of object O
sub SetPix(u8 O)
  PX[O] = highbyte OX[O]
  PY[O] = highbyte OY[O]
  return
end sub

' hits: fireball and ship (5 pixels), two fireballs of different pilots
' (3), anything and the star or black hole (ship 8, fireball 6), the two
' ships (9)
sub Collide:
  u8 A = 0
  u8 B = 0
  u8 Ax = 0
  u8 Ay = 0
  u8 Ex = 0
  u8 Ey = 0
  Pl[0].Hit = 0
  Pl[1].Hit = 0
  ' the fireballs: DwHits in move.asm (Z80, for frame time)
  call asm DwHits
  Ax = PX[0]
  Ay = PY[0]
  Ex = PX[1]
  Ey = PY[1]
  Ex = absdiff(Ax, Ex)
  Ey = absdiff(Ay, Ey)
  if Ex < 9 and Ey < 9 then
    Pl[0].Hit = 1
    Pl[1].Hit = 1
  end if
  if OptGrav > 0 then
    for A = 0 to 1
      Ax = PX[A]
      Ay = PY[A]
      Ax = absdiff(Ax, CenX)
      Ay = absdiff(Ay, CenY)
      if Ax < 8 and Ay < 8 then Pl[A].Hit = 1
    next
  end if
  K = Pl[0].Hit + Pl[1].Hit
  if K > 0 then Blown
  return
end sub

' a ship (or both) blown up: the other pilot scores when only one was hit
sub Blown:
  if K = 1 then
    if Pl[0].Hit = 1 then
      inc Pl[1].Wins
    else
      inc Pl[0].Wins
    end if
  end if
  inc Kills
  Boom = 60
  mute all
  play sound SndBoom
  ShowScore
  return
end sub

' the clock: a second every 60 frames (stopped during an explosion)
sub Clock:
  inc Jiffy
  if Jiffy < 60 then return
  Jiffy = 0
  if Sc = 0 then
    Sc = 59
    dec Mn
  else
    dec Sc
  end if
  if Mn = 0 and Sc < 11 and Sc > 0 then play sound SndTick
  ShowTime
  if Mn = 0 and Sc = 0 then Over = 1
  return
end sub

' the computer pilot (blue): aim at red, fire when lined up, keep away
' from the centre when it pulls, thrust when slow
sub CpuPilot:
  u8 Want = 0
  u8 Diff = 0
  u8 Dang = 0
  u8 Sp = 0
  i16 Ex = 0
  i16 Ey = 0
  CpuJ = 0
  Ex = PX[0] - PX[1]
  Ey = PY[0] - PY[1]
  Want = DirTo(Ex, Ey)
  if OptGrav > 0 then
    Dx = PX[1] - CenX
    Dy = PY[1] - CenY
    if abs(Dx) < 36 and abs(Dy) < 36 then
      Want = DirTo(Dx, Dy)
      Dang = 1
    end if
  end if
  Diff = (Want - Pl[1].Dir) & 15
  if Diff > 0 and Diff < 8 then CpuJ = 4
  if Diff >= 8 then CpuJ = 8
  Sp = abs(VX[1]) + abs(VY[1])
  if Diff < 2 or Diff > 14 then
    if Dang = 1 then
      CpuJ = CpuJ | 1
    else
      if Sp < 10 then CpuJ = CpuJ | 1
      Rand
      V = Rs & 3
      if V > 0 then CpuJ = CpuJ | 16
    end if
  end if
  return
end sub

sub Rand:
  u16 T = 0
  T = Rs << 7
  Rs = Rs ^ T
  T = Rs >> 9
  Rs = Rs ^ T
  T = Rs << 8
  Rs = Rs ^ T
  return
end sub

' ---------------------------------------------------------------------------
sub DrawSprites:
  u8 Pt = 0
  u8 Cl = 0
  for Ds = 0 to 7
    if Alive[Ds] = 1 then
      X = PX[Ds] - 8
      Y = PY[Ds] - 9
      if Ds < 2 then
        Pt = Pl[Ds].Dir * 4
        Cl = ShipCol[Ds]
        if Boom > 0 and Pl[Ds].Hit = 1 then
          Pt = SEx2
          if Boom > 20 then Pt = SEx1
          if Boom > 40 then Pt = SEx0
          Cl = 11
        end if
      else
        Pt = SBall
        K = Ds & 1
        Cl = BallCol[K]
      end if
      set sprite Ds to Y,X,Pt,Cl
    else
      set sprite Ds to 192,0,0,0
    end if
  next
  update sprites
  ' the star breathes three times a second
  if OptGrav = 2 then
    inc StarT
    if StarT >= 20 then
      StarT = 0
      StarF = StarF ^ 1
      DrawCentre
    end if
  end if
  return
end sub

sub DrawCentre:
  select case OptGrav
    case 1
      put char TBh00 at 15,12
      put char TBh01 at 16,12
      put char TBh10 at 15,13
      put char TBh11 at 16,13
    case 2
      K = StarF * 4 + TSt000
      put char K at 15,12
      put char K + 1 at 16,12
      put char K + 2 at 15,13
      put char K + 3 at 16,13
  end select
  return
end sub

sub ShowScore:
  NumU = Pl[0].Wins
  print at 6,1, digits$(NumU, 2)
  NumU = Pl[1].Wins
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub ShowTime:
  NumU = Mn
  print at 17,1, digits$(NumU, 1)
  print at 18,1, ":"
  NumU = Sc
  print at 19,1, digits$(NumU, 2)
  return
end sub

' a new round: ships at their sides, fireballs gone, speeds nil
sub NewRound:
  for Ob = 0 to 7
    Alive[Ob] = 0
    VX[Ob] = 0
    VY[Ob] = 0
    Life[Ob] = 0
  next
  Alive[0] = 1
  Alive[1] = 1
  OX[0] = 220 * 256
  Rand
  V = Rs & 31
  OY[0] = (V + 40) * 256
  OX[1] = 36 * 256
  Rand
  V = Rs & 31
  OY[1] = (V + 120) * 256
  SetPix(0)
  SetPix(1)
  Pl[0].Dir = 3
  Pl[1].Dir = 11
  Pl[0].Hit = 0
  Pl[1].Hit = 0
  Ctr = 0
  Acc = 0
  return
end sub

sub NewGame:
  NewScreen
  copy ArenaMap count 704 to vram.name + 64
  print at 2,1, "RED"
  print at 12,1, "TIME"
  print at 22,1, "BLUE"
  StarF = 0
  StarT = 0
  DrawCentre
  Pl[0].Wins = 0
  Pl[1].Wins = 0
  Kills = 0
  Mn = OptMins
  Sc = 0
  Jiffy = 0
  Boom = 0
  Over = 0
  NewRound
  ShowScore
  ShowTime
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J0 = 0
  if joypad(1).up then J0 = J0 | 1
  if joypad(1).down then J0 = J0 | 2
  if joypad(1).left then J0 = J0 | 4
  if joypad(1).right then J0 = J0 | 8
  if joypad(1).fire then J0 = J0 | 16
  J1 = 0
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  V = J0 | J1
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: DELTA WAR, the options, START / CREDITS, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 32
  print at 3,13, "PLAYERS"
  print at 3,14, "EDGES"
  print at 3,15, "CENTRE"
  print at 3,16, "FIREBALL"
  print at 3,17, "MINUTES"
  print at 3,18, "HYPERSPACE"
  print at 3,19, "START"
  print at 3,20, "CREDITS"
  print at 2,22, "COMPUTE!'S GAZETTE JAN 1988"
  for J = 0 to 5
    ShowOpt(J)
  next
  ShowCursor
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 536
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J0 | J1
  V = V & 15
  if V > 0 and WasStick = 0 then
    select case V
      case 1
        if Row > 0 then dec Row
      case 2
        if Row < 7 then inc Row
      case 4
        ChangeOpt(15)
      case 8
        ChangeOpt(1)
    end select
    ShowCursor
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Row < 6 then
    ChangeOpt(1)
    goto tp_loop
  end if
  Menu = 0
  if Row = 7 then Menu = 1
  StopTune
  W = Tick
  Rs = Rs ^ W
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

' 0..2 stepped forward (D = 1) or back (D = 15), wrapping round
function Step3(u8 Vv, u8 D) as u8
  if D = 1 then
    if Vv = 2 then return 0
    return Vv + 1
  end if
  if Vv = 0 then return 2
  return Vv - 1

' step the option on the cursor's row by D (1 forward, 15 back)
sub ChangeOpt(u8 D)
  select case Row
    case 0
      OptPlayers = OptPlayers ^ 1
    case 1
      OptEdge = OptEdge ^ 1
    case 2
      OptGrav = Step3(OptGrav, D)
    case 3
      OptRange = Step3(OptRange, D)
    case 4
      OptMins = OptMins + D
      OptMins = OptMins & 15
      if OptMins = 10 then OptMins = 1
      if OptMins = 0 then OptMins = 9
    case 5
      OptHyper = OptHyper ^ 1
    case else
      return
  end select
  ShowOpt(Row)
  return
end sub

sub ShowOpt(u8 R)
  Y = R + 13
  print at 15,Y, "              "
  select case R
    case 0
      if OptPlayers = 0 then
        print at 15,Y, "ONE (VS CPU)"
      else
        print at 15,Y, "TWO"
      end if
    case 1
      if OptEdge = 0 then
        print at 15,Y, "BOUNCE"
      else
        print at 15,Y, "PASS THRU"
      end if
    case 2
      select case OptGrav
        case 0
          print at 15,Y, "NO GRAVITY"
        case 1
          print at 15,Y, "BLACK HOLE"
        case 2
          print at 15,Y, "STAR"
      end select
    case 3
      select case OptRange
        case 0
          print at 15,Y, "SHORT"
        case 1
          print at 15,Y, "MEDIUM"
        case 2
          print at 15,Y, "LONG"
      end select
    case 4
      NumU = OptMins
      print at 15,Y, digits$(NumU, 1)
    case 5
      if OptHyper = 0 then
        print at 15,Y, "YES"
      else
        print at 15,Y, "NO"
      end if
  end select
  return
end sub

sub ShowCursor:
  for J = 13 to 20
    put char 32 at 2,J
  next
  J = Row + 13
  put char 62 at 2,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "DELTA WAR"
  print at 2,5, "BASED ON DELTA WAR,"
  print at 2,6, "COMPUTE!'S GAZETTE, JANUARY"
  print at 2,7, "1988 (COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: TWO WINGS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; DwMoveAll: every live object one frame along (main.alexis MoveObj's rules
; in Z80, for frame time): position += speed x 8 (ships) or x 16
; (fireballs) in 1/256 pixels, y up; then bounce (speed reversed, held at
; the limit) or wrap by OptEdge; PX/PY = the high bytes. Uses AF BC DE HL.
DwMoveAll:
    ld b,0
DwMvLoop:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld a,(hl)
    or a
    jp z,DwMvNext
    ; ---- x: OX[b] += VX[b] * scale
    ld hl,AMY_UVAR_VX
    add hl,de
    ld a,(hl)
    call DwScale
    ex de,hl
    ld a,b
    add a,a
    ld l,a
    ld h,0
    push bc
    ld bc,AMY_UVAR_OX
    add hl,bc
    pop bc
    ld a,(hl)
    add a,e
    ld e,a
    inc hl
    ld a,(hl)
    adc a,d
    ld d,a
    dec hl
    push hl
    ld a,(AMY_UVAR_OptEdge)
    or a
    jr nz,DwXWrap
    ld hl,$EA00
    add hl,de
    jr c,DwXB1
    ld de,5632
    ld hl,AMY_UVAR_VX
    call DwNeg
DwXB1:
    ld hl,$15FF
    add hl,de
    jr nc,DwXDone
    ld de,59904
    ld hl,AMY_UVAR_VX
    call DwNeg
    jr DwXDone
DwXWrap:
    ld hl,$EA00
    add hl,de
    jr c,DwXW1
    ld hl,54272
    add hl,de
    ex de,hl
DwXW1:
    ld hl,$15FF
    add hl,de
    jr nc,DwXDone
    ld hl,$2C00
    add hl,de
    ex de,hl
DwXDone:
    pop hl
    ld (hl),e
    inc hl
    ld (hl),d
    ld a,d
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_PX
    add hl,de
    ld (hl),a
    ; ---- y: OY[b] -= VY[b] * scale
    ld hl,AMY_UVAR_VY
    add hl,de
    ld a,(hl)
    call DwScale
    ex de,hl
    ld a,b
    add a,a
    ld l,a
    ld h,0
    push bc
    ld bc,AMY_UVAR_OY
    add hl,bc
    pop bc
    ld a,(hl)
    sub e
    ld e,a
    inc hl
    ld a,(hl)
    sbc a,d
    ld d,a
    dec hl
    push hl
    ld a,(AMY_UVAR_OptEdge)
    or a
    jr nz,DwYWrap
    ld hl,$E200
    add hl,de
    jr c,DwYB1
    ld de,7680
    ld hl,AMY_UVAR_VY
    call DwNeg
DwYB1:
    ld hl,$4DFF
    add hl,de
    jr nc,DwYDone
    ld de,45568
    ld hl,AMY_UVAR_VY
    call DwNeg
    jr DwYDone
DwYWrap:
    ld hl,$E200
    add hl,de
    jr c,DwYW1
    ld hl,37888
    add hl,de
    ex de,hl
DwYW1:
    ld hl,$4DFF
    add hl,de
    jr nc,DwYDone
    ld hl,$6C00
    add hl,de
    ex de,hl
DwYDone:
    pop hl
    ld (hl),e
    inc hl
    ld (hl),d
    ld a,d
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_PY
    add hl,de
    ld (hl),a
DwMvNext:
    inc b
    ld a,b
    cp 8
    jp c,DwMvLoop
    ret
; hl = a (signed) x 8, x 16 for objects 2-7 (b)
DwScale:
    ld l,a
    add a,a
    sbc a,a
    ld h,a
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,b
    cp 2
    ret c
    add hl,hl
    ret
; negate the byte at hl + b (a speed); keeps de
DwNeg:
    push de
    ld e,b
    ld d,0
    add hl,de
    ld a,(hl)
    neg
    ld (hl),a
    pop de
    ret
; DwHits: the fireballs' hits (main.alexis Collide's first part in Z80):
; a fireball within 5 pixels of a ship on both axes marks Pl[ship].Hit and
; is gone; two fireballs of different pilots within 3 pixels are both gone;
; with gravity on, a fireball within 6 pixels of the centre is gone.
; Uses AF BC DE HL and HAx, HAy.
DwHits:
    ld c,2
DwHA:
    ld e,c
    ld d,0
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld a,(hl)
    or a
    jp z,DwHNext
    ld hl,AMY_UVAR_PX
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_HAx),a
    ld hl,AMY_UVAR_PY
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_HAy),a
    ld b,0
DwHS:
    ld e,b
    ld d,0
    ld hl,AMY_UVAR_PX
    add hl,de
    ld a,(AMY_UVAR_HAx)
    sub (hl)
    jr nc,DwHS1
    neg
DwHS1:
    cp 5
    jr nc,DwHSn
    ld hl,AMY_UVAR_PY
    add hl,de
    ld a,(AMY_UVAR_HAy)
    sub (hl)
    jr nc,DwHS2
    neg
DwHS2:
    cp 5
    jr nc,DwHSn
    ld a,b
    add a,a
    add a,a
    ld e,a
    ld hl,AMY_UVAR_Pl+1
    add hl,de
    ld (hl),1
    ld e,c
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld (hl),0
DwHSn:
    inc b
    ld a,b
    cp 2
    jr c,DwHS
    ld b,c
    inc b
DwHM:
    ld a,b
    cp 8
    jr nc,DwHMx
    ld e,c
    ld d,0
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld a,(hl)
    or a
    jr z,DwHMx
    ld e,b
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld a,(hl)
    or a
    jr z,DwHMn
    ld hl,AMY_UVAR_PX
    add hl,de
    ld a,(AMY_UVAR_HAx)
    sub (hl)
    jr nc,DwHM1
    neg
DwHM1:
    cp 3
    jr nc,DwHMn
    ld hl,AMY_UVAR_PY
    add hl,de
    ld a,(AMY_UVAR_HAy)
    sub (hl)
    jr nc,DwHM2
    neg
DwHM2:
    cp 3
    jr nc,DwHMn
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld (hl),0
    ld e,c
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld (hl),0
DwHMn:
    inc b
    inc b
    jr DwHM
DwHMx:
    ld e,c
    ld d,0
    ld hl,AMY_UVAR_Alive
    add hl,de
    ld a,(hl)
    or a
    jr z,DwHNext
    ld a,(AMY_UVAR_OptGrav)
    or a
    jr z,DwHNext
    ld a,(AMY_UVAR_HAx)
    sub 128
    jr nc,DwHC1
    neg
DwHC1:
    cp 6
    jr nc,DwHNext
    ld a,(AMY_UVAR_HAy)
    sub 104
    jr nc,DwHC2
    neg
DwHC2:
    cp 6
    jr nc,DwHNext
    ld (hl),0
DwHNext:
    inc c
    ld a,c
    cp 8
    jp c,DwHA
    ret
; DwGrav: pull object Ob2 toward the centre, GTimes times (main.alexis
; Gravity's rules in Z80): off without gravity; the star pulls only when
; Ctr & 3 = 3; GravMap gives the heading and distance class of Ob2's 4 x 4
; cell; no pull while Ctr < GravThr[class]; each time the heading's thrust
; vector is added to each speed that stays inside -32..32.
; Uses AF BC DE HL.
DwGrav:
    ld a,(AMY_UVAR_OptGrav)
    or a
    ret z
    cp 2
    jr nz,DwG1
    ld a,(AMY_UVAR_Ctr)
    and 3
    cp 3
    ret nz
DwG1:
    ld a,(AMY_UVAR_Ob2)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_PY
    add hl,de
    ld a,(hl)
    and $FC
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld hl,AMY_UVAR_PX
    add hl,de
    ld a,(hl)
    srl a
    srl a
    pop hl
    ld e,a
    add hl,de
    ld de,AMY_UDATA_GravMap
    add hl,de
    ld a,(hl)
    ld c,a
    rrca
    rrca
    rrca
    rrca
    and 15
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_GravThr
    add hl,de
    ld a,(AMY_UVAR_Ctr)
    cp (hl)
    ret c
    ld a,c
    and 15
    ld e,a
    ld hl,AMY_UDATA_ThX
    add hl,de
    ld b,(hl)
    ld hl,AMY_UDATA_ThY
    add hl,de
    ld c,(hl)
    ld a,(AMY_UVAR_Ob2)
    ld e,a
    ld a,(AMY_UVAR_GTimes)
DwG2:
    push af
    ld hl,AMY_UVAR_VX
    add hl,de
    ld a,b
    call DwGAdd
    ld hl,AMY_UVAR_VY
    add hl,de
    ld a,c
    call DwGAdd
    pop af
    dec a
    jr nz,DwG2
    ret
; (hl) += a when the sum stays inside -32..32 (signed bytes)
DwGAdd:
    add a,(hl)
    cp 33
    jr c,DwGA1
    cp -32
    ret c
DwGA1:
    ld (hl),a
    ret
DwZap:
    db $40,$3E,$20,$01,$40,$4E,$30,$01,$40,$61,$30,$01,$40,$79,$40,$01,$40,$98,$40,$01,$40,$BE,$50,$01
    db $40,$ED,$50,$01,$50
DwBoom:
    db $00,$00,$06,$04,$00,$00,$16,$06,$00,$00,$27,$08,$00,$00,$47,$0C,$00,$00,$67,$10,$00,$00,$87,$10
    db $10
DwHiss:
    db $00,$00,$75,$02,$10
DwWarp:
    db $40,$A0,$30,$01,$40,$4B,$30,$01,$40,$88,$40,$01,$40,$4B,$40,$01,$40,$77,$40,$01,$40,$4B,$40,$01
    db $40,$6A,$50,$01,$40,$4B,$50,$01,$40,$5F,$50,$01,$40,$4B,$50,$01,$50
DwTick:
    db $40,$5D,$30,$02,$50
DwStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$0E,$50
DwOver:
    db $40,$8F,$10,$0C,$40,$AA,$20,$0C,$40,$D6,$20,$0C,$40,$1D,$31,$1E,$50

DwSoundTable:
    dw DwTuneMel,$702B
    dw DwTuneBass,$7035
    dw DwZap,$7049
    dw DwBoom,$703F
