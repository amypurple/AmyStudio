 tile screen
 backdrop 1
 fill mode 2 text color with $F1
 define chars SeaTiles at 128 count 25
 define colors SeaColors at 128 count 25
 define chars ReefTiles at 153 count 24
 define colors ReefColors at 153 count 24
 define chars ReefSwayTiles at 177 count 8
 define colors ReefSwayColors at 177 count 8
 define chars LightTiles at 185 count 32
 define colors LightColors at 185 count 32
 define chars PickupBurstTiles at 217 count 8
 define colors PickupBurstColors at 217 count 8
 define chars WaveShift at 225 count 1
 define colors WaveShiftColors at 225 count 1
 sprites 16x16
 copy DiverShape to vram.spr_pat
 copy ChestShape to vram $3820
 copy SharkA to vram $3840
 copy SharkB to vram $3860
 copy SharkC to vram $3880
 copy SharkD to vram $38A0
 copy BubbleShape to vram $38C0
 copy DiverKickA to vram $38E0
 copy DiverKickB to vram $3900
 copy GlassShape to vram $3920
 copy DiverLeftThrust to vram $3960
 copy DiverSurface to vram $3980
 copy TreasureGlint to vram $3940
 copy DiverLeftIdle to vram $39A0
 copy GlassLeft to vram $39C0
 clear sprites
 set sprite count 9
 set sound table DiverSoundTable areas 3
 screen on
 goto title

title:
 nmi on
 cls
 print centered at 2,"TREASURE DIVER"
 print centered at 4,"OCEAN EXPEDITION"
 fill 144 count 28 at 2,5
 fill 129 count 28 at 2,6
 for I = 7 to 13
   fill 136 count 28 at 2,I
 next
 ' Illustrated title panorama: tile art connected across cell boundaries.
 put char 185 at 9,7
 put char 186 at 10,7
 put char 187 at 11,7
 put char 188 at 12,7
 put char 189 at 9,8
 put char 190 at 10,8
 put char 191 at 11,8
 put char 192 at 12,8
 put char 193 at 9,9
 put char 194 at 10,9
 put char 195 at 11,9
