 put char 199 at 11,10
 put char 200 at 12,10
 put char 201 at 20,7
 put char 202 at 21,7
 put char 203 at 22,7
 put char 204 at 23,7
 put char 205 at 20,8
 put char 206 at 21,8
 put char 207 at 22,8
 put char 208 at 23,8
 put char 209 at 20,9
 put char 210 at 21,9
 put char 211 at 22,9
 put char 212 at 23,9
 put char 213 at 20,10
