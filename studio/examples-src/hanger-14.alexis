cartridge "HANGER 14/JUSTIN LUTON/1987"

' HANGER 14
' A ColecoVision game based on "Hanger 14" by Justin Luton, Ahoy! January
' 1987 (Commodore 64 BASIC with sprites; orig/ has the program from the
' Ahoy! disk, its detokenized listing and jsc64 screenshots). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The story (from the article): the Greater Andromeda Tea Biscuit Company
' has tracked its hijacked cargo rocket to a nearly deserted spaceport on
' Metallion, a planet of metals. You are the robot sent to bring it back
' from its hiding place in Hanger 14.
'
' Not a line-by-line port: the rules are the listing's, the game is built
' for the ColecoVision: smooth 16 x 16 sprites moving every frame in 1/16
' pixel steps, a real jump arc, a crusher that slams down and rises
' smoothly (its head a sprite, its rod tiles), a drawn hangar, the rocket
' launch, sound effects and a title tune.
'
' From the original (lines 6-119): run right across the hangar (stick left
' and right); the button jumps, and the direction held when jumping is
' kept for the whole jump, slower than running (2.5 against 4); no falling
' into a pit while in the air; seven levels with the listing's hazards in
' the same order: 1 a missile skimming the floor from the right (one at a
' time, a new one as soon as it is gone), 2 three pits, 3 the crusher
' coming down from the ceiling, 4 two pits and the missile, 5 the missile
' and the crusher, 6 the crusher between two pits, 7 one pit, the missile
' and the crusher, with the rocket at the end; each level 100 points plus
' a time bonus of 1000 less half the jiffies since the level began (the
' C64's TI, counted here in frames, the same 60 a second; deaths do not
' reset it), 2000 more for reaching the rocket; three robots (two in
' reserve); a lost robot starts the level again from the left; the brick
' colour changes each level (red, cyan, purple, green, blue, yellow,
' orange, in the C64's order); after level 7 the levels start again; the
' robot jumps for joy at the end of a level and walks out; the falling
' robot's whistle; GAME OVER slides in letter by letter; a high score.
'
' Liberties: an extra robot every 10,000 points, at most five in reserve
' (the listing gives one only when the score is an exact multiple of 1000,
' which almost never happens); the hazards are faster on each later round
' of the seven levels (the listing repeats them unchanged); a robot hit by
' the missile bursts and falls over, one under the crusher is flattened
' (on the C64 every lost robot drops off the bottom of the screen); the
' missile starts again from the right when a robot is lost; the rocket
' lifts off calmly after its five slow sways (the C64 only sways it); the bonus is shown and counted into
' the score; the robot walks in from the hangar's left edge (as the
' listing's lines 10-11).
'
' Controls: the joystick (either controller) moves, a button jumps. On the
' title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes.
'
' Workarounds for Amy bugs hanger-return-in-frame removed 2026-11-01.

const TBrickL = 128
const TBrickR = 129
const TBeam = 130
const TWall = 131
const TWallTop = 132
const TWallBot = 133
const TN1400 = 134
const TN1401 = 135
const TN1402 = 136
const TN1403 = 137
const TN1410 = 138
const TN1411 = 139
const TN1412 = 140
const TN1413 = 141
const TN1420 = 142
const TN1421 = 143
const TN1422 = 144
const TN1423 = 145
const TPost = 146
const TSky = 147
const TStar1 = 148
const TStar2 = 149
const TMoon00 = 150
const TMoon01 = 151
const TMoon10 = 152
const TMoon11 = 153
const TTrol00 = 154
const TTrol01 = 155
const TTrol02 = 156
const TCable = 157
const TMagnet = 158
const THouse00 = 159
const THouse01 = 160
const THouse02 = 161
const THouse03 = 162
const TRodL = 163
const TRodR = 164
const TPitTL = 165
const TPitTM = 166
const TPitTR = 167
const TPitL = 168
const TPitR = 169
const TBase00 = 170
const TBase01 = 171
const TBase02 = 172
const TBase03 = 173
const TBase04 = 174
const TBase05 = 175
const TBase10 = 176
const TBase11 = 177
const TBase12 = 178
const TBase13 = 179
const TBase14 = 180
const TBase15 = 181
const TBase20 = 182
const TBase21 = 183
const TBase22 = 184
const TBase23 = 185
const TBase24 = 186
const TBase25 = 187
const TRk00 = 188
const TRk01 = 189
const TRk02 = 190
const TRk03 = 191
const TRk10 = 192
const TRk11 = 193
const TRk12 = 194
const TRk13 = 195
const TRk20 = 196
const TRk21 = 197
const TRk22 = 198
const TRk23 = 199
const TRk30 = 200
const TRk31 = 201
const TRk32 = 202
const TRk33 = 203
const TRk40 = 204
const TRk41 = 205
const TRk42 = 206
const TRk43 = 207
const TRk50 = 208
const TRk51 = 209
const TRk52 = 210
const TRk53 = 211
const TPad00 = 212
const TPad01 = 213
const TPad02 = 214
const TPad03 = 215
const TLife = 216
const SR0d0 = 0
const SR0b0 = 4
const SR0d1 = 8
const SR0b1 = 12
const SR0d2 = 16
const SR0b2 = 20
const SR0d3 = 24
const SR0b3 = 28
const SR0d4 = 32
const SR0b4 = 36
const SR0d5 = 40
const SR0b5 = 44
const SR0d6 = 48
const SR0b6 = 52
const SR0d7 = 56
const SR0b7 = 60
const SR1d0 = 64
const SR1b0 = 68
const SR1d1 = 72
const SR1b1 = 76
const SR1d2 = 80
const SR1b2 = 84
const SR1d3 = 88
const SR1b3 = 92
const SR1d4 = 96
const SR1b4 = 100
const SR1d5 = 104
const SR1b5 = 108
const SR1d6 = 112
const SR1b6 = 116
const SR1d7 = 120
const SR1b7 = 124
const SMis0 = 128
const SMis1 = 132
const SCrs = 136
const SCrb = 140
const SBurst1 = 144
const SBurst2 = 148
const SSmoke = 152
const SRr00 = 156
const SRr01 = 160
const SRr10 = 164
const SRr11 = 168
const SRr20 = 172
const SRr21 = 176
const SRw00 = 180
const SRw01 = 184
const SRw10 = 188
const SRw11 = 192
const SRw20 = 196
const SRw21 = 200
const SFla0 = 204
const SFla1 = 208
const SFlb0 = 212
const SFlb1 = 216
const NTiles8 = 712
const SprBytes = 1760
const LeftOff = 64
const SndTuneA = 1
const SndTuneB = 2
const SndMissile = 3
const SndBoom = 4
const SndSquash = 5
const SndSlam = 6
const SndLand = 7
const SndRumble = 8
const SndJump = 9
const SndFall = 10
const SndHop = 11
const SndTick = 12
const SndLife = 13
const SndStart = 14
const SndCount = 15
const SndOver = 16
const RunSp = 12
const Drift = 10
const JumpV = 24
const XMin16 = 128
const WalkX16 = 128
const StartX16 = 320
const ExitX16 = 3776
const MisStart = 4352
const CrPer = 112
const NSpr = 14

data PitData bytes
  0,0,0, 8,14,20, 0,0,0, 10,16,0, 0,0,0, 10,16,0, 8,0,0
end data
data LvFlags bytes
  1,0,2,1,3,2,3
end data
data GoTxt bytes
  71,65,77,69,32,79,86,69,82
end data

state machine Robot:
  WalkIn calls RWalkIn
  Run calls RRun
  Falling calls RFalling
  Shot calls RShot
  Crushed calls RCrushed
  Done calls RDone
end state machine

u16 TzLeft = 0
u8 TzOn = 0
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
' score and best in thousands and units (up to 999,999)
u16 ScK = 0
u16 ScU = 0
u16 HiK = 0
u16 HiU = 0
u16 NextLife = 10
u16 AddPts = 0
u16 TallyLeft = 0
u16 Bon = 0
u8 Lives = 2
u8 Lv = 1
u8 Lap = 1
u8 LevNum = 1
u8 Over = 0
' the level: pits (start columns, 0 none), missile, crusher, speeds
u8 Px[3]
u8 HasMis = 0
u8 HasCr = 0
u8 MisSp = 16
u8 CrSp = 16
' the robot: state, x in 1/16 pixel (its middle), jump height and speed
' in 1/16 pixel, jumping, the stick held at the jump, facing left, moved
u8 St = Robot.WalkIn
u16 Mx = 0
i16 Hz = 0
i16 Vz = 0
u8 Jf = 0
u8 Jd = 0
u8 Face = 0
u8 Mv = 0
u8 Fv = 0
u16 Fd = 0
u8 DieT = 0
u16 LvT = 0
' the missile (x + 16 pixels, in 1/16), the crusher (phase, sub-step)
u16 MisX16 = 0
u8 CrP = 0
u8 CrAcc = 0
u8 RodHave = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
' title robot, launch
u16 TMx = 0
i16 THz = 0
i16 TVz = 0
u16 RTop = 0
u16 RVel = 0
u16 RPos = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Hp = 0
u8 Ht = 0
u8 Gi = 0
u8 Gc = 0
u8 Ci = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 F = 0
u8 H = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cx = 0
u8 Got = 0

  tile screen
  set sound table HgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  V = Anim & 15
  if V = 0 then ShowBonus
  if Over = 1 then goto game_over
  if St = Robot.Done then LevelDone
  goto play_loop

game_over:
  ' the best score, GAME OVER sliding in letter by letter (as the C64's
  ' line 71), then back to the title on a press
  Got = 0
  if ScK > HiK then Got = 1
  if ScK = HiK then
    if ScU > HiU then Got = 1
  end if
  if Got = 1 then
    HiK = ScK
    HiU = ScU
    ShowHi
  end if
  fill 32 count 28 at 2,9
  for Gi = 0 to 8
    V = GoTxt[Gi]
    T = Gi + 10
    if V <> 32 then
      Gc = 29
      while Gc > T
        put char V at Gc,9
        Frame1
        Frame1
        put char 32 at Gc,9
        dec Gc
      end while
      put char V at T,9
    end if
  next
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Anim
  if LvT < 60000 then inc LvT
  MoveHazards
  Mv = 0
  dispatch St using Robot
  return
end sub

' the missile flies left; a new one as soon as it is gone. The crusher
' follows its table, CrSp/16 phases a frame
sub MoveHazards:
  if HasMis = 1 then
    A16 = MisSp
    if MisX16 < A16 then
      MisX16 = MisStart
      play sound SndMissile
    else
      MisX16 = MisX16 - A16
    end if
  end if
  if HasCr = 1 then
    CrAcc = CrAcc + CrSp
    while CrAcc >= 16
      CrAcc = CrAcc - 16
      inc CrP
      if CrP >= CrPer then CrP = 0
      if CrP = 48 then play sound SndSlam
    end while
  end if
  return
end sub

' walking in from the left edge (no control, nothing hits)
sub RWalkIn:
  Mx = Mx + RunSp
  Mv = 1
  Face = 0
  if Mx >= StartX16 then St = Robot.Run
  return
end sub

' the stick runs, the button jumps; in the air the stick held at the jump
' carries the robot on, slower
sub RRun:
  K = Pad
  if Jf = 0 then
    V = K & 4
    if V > 0 then
      Face = 1
      if Mx > XMin16 then
        Mx = Mx - RunSp
        Mv = 1
      end if
    else
      V = K & 8
      if V > 0 then
        Face = 0
        Mx = Mx + RunSp
        Mv = 1
      end if
    end if
    V = K & 16
    if V > 0 then
      Jf = 1
      Vz = JumpV
      Jd = K & 12
      play sound SndJump
    end if
  end if
  if Jf = 1 then
    V = Jd & 4
    if V > 0 then
      if Mx > XMin16 then Mx = Mx - Drift
    end if
    V = Jd & 8
    if V > 0 then Mx = Mx + Drift
    Hz = Hz + Vz
    Vz = Vz - 1
    if Hz <= 0 then
      Hz = 0
      Vz = 0
      Jf = 0
      play sound SndLand
    end if
  end if
  if Mx >= ExitX16 then
    St = Robot.Done
    return
  end if
  CheckHits
  return
end sub

' a pit under the feet (not in the air), the missile at the shins, the
' crusher's head lower than the robot's head
sub CheckHits:
  W16 = Mx >> 4
  Cx = W16
  H = Hz / 16
  if Jf = 0 then
    for Pi = 0 to 2
      C = Px[Pi]
      if C > 0 then
        V = C << 3
        V = V + 3
        if Cx >= V then
          V = V + 18
          if Cx < V then
            if St = Robot.Run then
              St = Robot.Falling
              Fv = 0
              Fd = 0
              DieT = 40
              play sound SndFall
            end if
          end if
        end if
      end if
    next
    if St <> Robot.Run then return
  end if
  if HasMis = 1 then
    W16 = MisX16 >> 4
    A16 = Cx + 20
    if W16 <= A16 then
      A16 = W16 + 3
      if Cx <= A16 then
        if H <= 8 then
          St = Robot.Shot
          DieT = 90
          MisX16 = 0
          play sound SndBoom
          return
        end if
      end if
    end if
  end if
  if HasCr = 1 then
    if Cx >= 107 then
      if Cx < 133 then
        V = CrY[CrP]
        T = 98 - H
        if V > T then
          St = Robot.Crushed
          DieT = 90
          play sound SndSquash
        end if
      end if
    end if
  end if
  return
end sub

' down the pit, faster and faster, then a pause
sub RFalling:
  if Fd < 1024 then
    Fv = Fv + 2
    Fd = Fd + Fv
  else
    dec DieT
    if DieT = 0 then LoseLife
  end if
  return
end sub

sub RShot:
  dec DieT
  if DieT = 0 then LoseLife
  return
end sub

sub RCrushed:
  dec DieT
  if DieT = 0 then LoseLife
  return
end sub

sub RDone:
  return
end sub

sub LoseLife:
  if Lives = 0 then
    Over = 1
    return
  end if
  dec Lives
  Respawn
  ShowLives
  return
end sub

sub Respawn:
  Mx = WalkX16
  St = Robot.WalkIn
  Jf = 0
  Jd = 0
  Hz = 0
  Vz = 0
  Face = 0
  MisX16 = 0
  return
end sub

' ---------------------------------------------------------------------------
' between levels

sub LevelDone:
  W16 = LvT >> 1
  if W16 >= 1000 then
    Bon = 0
  else
    Bon = 1000 - W16
  end if
  ShowBonus
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  set sprite 4 to 192,0,0,0
  set sprite 5 to 192,0,0,0
  update sprites
  if Lv = 7 then
    Launch
    fill 32 count 28 at 2,22
    print at 3,22, "CARGO ROCKET FOUND  +2000"
    TallyLeft = 2000
    while TallyLeft > 0
      AddPts = 50
      TallyLeft = TallyLeft - 50
      AddScore
      V = Tick & 3
      if V = 0 then play sound SndTick
      Frame1
    end while
    Rearm
    wait 40 frames
    nmi off
    fill 32 count 28 at 2,22
    ShowLives
    ShowLevel
  else
    Celebrate
  end if
  ' 100 for the level, then the bonus counted in
  AddPts = 100
  AddScore
  ShowBonus
  while Bon > 0
    if Bon >= 10 then
      AddPts = 10
    else
      AddPts = Bon
    end if
    Bon = Bon - AddPts
    AddScore
    print at 15,22, digits$(Bon, 4)
    V = Tick & 1
    if V = 0 then play sound SndTick
    Frame1
  end while
  Rearm
  wait 30 frames
  nmi off
  inc Lv
  if Lv > 7 then
    Lv = 1
    if Lap < 99 then inc Lap
  end if
  if LevNum < 99 then inc LevNum
  StartLevel
  return
end sub

' the robot jumps for joy three times (the C64 jumped four), then walks out
sub Celebrate:
  for Hp = 0 to 2
    play sound SndHop
    for Ht = 0 to 15
      V = HopT[Ht]
      Y = 95 - V
      RobotAt(Y, 4)
      Frame1
    next
  next
  Mv = 1
  W16 = 248 << 4
  while Mx < W16
    Mx = Mx + RunSp
    inc Anim
    V = Anim >> 3
    V = V & 3
    RobotAt(95, V)
    Frame1
  end while
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

' the robot (frame F) at row Y, at its x
sub RobotAt(u8 Ry, u8 Rf):
  W16 = Mx >> 4
  X = W16 - 8
  K = Rf << 3
  if Face = 1 then K = K + LeftOff
  K = K + SR0d0
  set sprite 0 to Ry,X,K,8
  K = K + 4
  set sprite 1 to Ry,X,K,15
  update sprites
  return
end sub

' level 7: the robot boards the rocket; it sways slowly five times (as the
' C64), lights its engine and lifts off calmly out of the hangar door
sub Launch:
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  for Ri = 8 to 13
    for Ci = 27 to 30
      SkyCell(Ci, Ri)
    next
  next
  RTop = 64 + 64
  RPos = RTop << 4
  RVel = 0
  ' five smooth sways as the C64 (sprite 4 glides 10 px right and back,
  ' about 26 frames a round trip): 8 px here, 13 frames each way, the
  ' sound at each end
  for Hp = 1 to 5
    for Ht = 0 to 25
      if Ht < 13 then
        W16 = Ht
      else
        W16 = 26 - Ht
      end if
      W16 = W16 * 8
      W16 = W16 / 13
      X = 216 + W16
      RocketAt(X, 0)
      Frame1
      if Ht = 12 then play sound SndHop
    next
    play sound SndHop
  next
  ' engine lit, a steady flame, then a slow lift with the flame changing
  ' every 16 frames (under 2 Hz)
  play sound SndRumble
  for Ht = 0 to 59
    RocketAt(216, 1)
    Frame1
  next
  while RTop > 0
    RVel = RVel + 1
    W16 = RVel >> 2
    if RPos > W16 then
      RPos = RPos - W16
    else
      RPos = 0
    end if
    RTop = RPos >> 4
    V = Tick >> 4
    V = V & 1
    RocketAt(216, V + 1)
    Frame1
  end while
  HideSprites
  return
end sub

' the rocket's 12 cells at X and RTop (screen row + 64); Fl 0 no flame,
' 1 or 2 its frames
sub RocketAt(u8 Rx, u8 Fl):
  J = 0
  for R = 0 to 2
    W16 = R << 4
    W16 = W16 + RTop
    for C = 0 to 1
      X = C << 4
      X = X + Rx
      if W16 < 48 then
        set sprite J to 192,0,0,0
        V = J + 6
        set sprite V to 192,0,0,0
      else
        A16 = W16 - 65
        Y = A16
        K = R << 1
        K = K + C
        K = K << 2
        K = K + SRr00
        set sprite J to Y,X,K,8
        V = J + 6
        K = K + 24
        set sprite V to Y,X,K,15
      end if
      inc J
    next
  next
  W16 = RTop + 44
  if Fl = 0 then
    set sprite 12 to 192,0,0,0
    set sprite 13 to 192,0,0,0
  elseif W16 < 48 then
    set sprite 12 to 192,0,0,0
    set sprite 13 to 192,0,0,0
  else
    A16 = W16 - 65
    Y = A16
    K = SFla0
    if Fl = 2 then K = SFlb0
    set sprite 12 to Y,Rx,K,11
    X = Rx + 16
    K = K + 4
    set sprite 13 to Y,X,K,11
  end if
  update sprites
  return
end sub

sub AddScore:
  ScU = ScU + AddPts
  while ScU >= 1000
    ScU = ScU - 1000
    inc ScK
    if ScK >= NextLife then
      NextLife = NextLife + 10
      if Lives < 5 then
        inc Lives
        ShowLives
      end if
      play sound SndLife
    end if
  end while
  ShowScore
  return
end sub

' ---------------------------------------------------------------------------
' levels and drawing

sub NewGame:
  ScK = 0
  ScU = 0
  NextLife = 10
  Lives = 2
  Lv = 1
  Lap = 1
  LevNum = 1
  Over = 0
  StartLevel
  return
end sub

sub StartLevel:
  V = Lv - 1
  F = LvFlags[V]
  HasMis = F & 1
  HasCr = F >> 1
  V = V * 3
  Px[0] = PitData[V]
  inc V
  Px[1] = PitData[V]
  inc V
  Px[2] = PitData[V]
  V = Lap - 1
  if V > 4 then V = 4
  V = V * 3
  MisSp = 16 + V
  CrSp = 16 + V
  Respawn
  CrP = 0
  CrAcc = 0
  LvT = 0
  RodHave = 0
  Anim = 0
  DrawLevel
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

sub DrawLevel:
  NewScreen
  DrawHangar
  for Pi = 0 to 2
    C = Px[Pi]
    if C > 0 then
      X = C + 1
      T = C + 2
      put char TPitTL at C,14
      put char TPitTM at X,14
      put char TPitTR at T,14
      for R = 15 to 20
        put char TPitL at C,R
        put char TPitTM at X,R
        put char TPitR at T,R
      next
    end if
  next
  if HasCr = 1 then
    for C = 0 to 3
      V = THouse00 + C
      X = C + 13
      put char V at X,5
    next
  end if
  if Lv = 7 then
    for R = 0 to 5
      for C = 0 to 3
        V = R << 2
        V = V + C
        V = V + TRk00
        X = C + 27
        Y = R + 8
        put char V at X,Y
      next
    next
    for C = 0 to 3
      V = TPad00 + C
      X = C + 27
      put char V at X,14
    next
  end if
  ShowHud
  return
end sub

' the hangar: brick ceiling and floor in the level's colour, the girder, the
' corrugated wall with its painted number, the crane and its magnet (over the
' door, where the robot jumps for joy), the
' open door to the night, the basement with the red truck
sub DrawHangar:
  V = Lv - 1
  W16 = V * 24
  copy LvCol + W16 count 24 to vram.color + 1024
  for R = 3 to 4
    for C = 0 to 31
      V = C + R
      V = V & 1
      V = V + TBrickL
      put char V at C,R
    next
  next
  fill TBeam count 32 at 0,5
  fill TWallTop count 25 at 0,6
  for R = 7 to 12
    fill TWall count 25 at 0,R
  next
  fill TWallBot count 25 at 0,13
  for R = 6 to 13
    put char TPost at 25,R
    for C = 26 to 31
      SkyCell(C, R)
    next
  next
  put char TMoon00 at 27,6
  put char TMoon01 at 28,6
  put char TMoon10 at 27,7
  put char TMoon11 at 28,7
  for R = 0 to 2
    for C = 0 to 3
      V = R << 2
      V = V + C
      V = V + TN1400
      X = C + 3
      Y = R + 8
      put char V at X,Y
    next
  next
  put char TTrol00 at 28,5
  put char TTrol01 at 29,5
  put char TTrol02 at 30,5
  for R = 6 to 8
    put char TCable at 29,R
  next
  put char TMagnet at 29,9
  for R = 14 to 20
    for C = 0 to 31
      V = C + R
      V = V & 1
      V = V + TBrickL
      put char V at C,R
    next
  next
  for R = 0 to 2
    for C = 0 to 5
      V = R * 6
      V = V + C
      V = V + TBase00
      X = C + 2
      Y = R + 17
      put char V at X,Y
    next
  next
  return
end sub

' a cell of the night sky: empty or a star
sub SkyCell(u8 Sc, u8 Sr):
  V = Sc * 3
  N = Sr * 5
  V = V + N
  V = V & 3
  N = TSky
  if V = 1 then N = TStar1
  if V = 3 then N = TStar2
  put char N at Sc,Sr
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 18,1, "HI"
  ShowScore
  ShowHi
  ShowLives
  ShowLevel
  ShowBonus
  return
end sub

sub ShowScore:
  NumU = ScK
  print at 8,1, digits$(NumU, 3)
  NumU = ScU
  print at 11,1, digits$(NumU, 3)
  return
end sub

sub ShowHi:
  NumU = HiK
  print at 21,1, digits$(NumU, 3)
  NumU = HiU
  print at 24,1, digits$(NumU, 3)
  return
end sub

sub ShowLives:
  fill 32 count 5 at 2,22
  if Lives = 0 then return
  for J = 1 to Lives
    X = J + 1
    put char TLife at X,22
  next
  return
end sub

sub ShowLevel:
  print at 21,22, "LEVEL"
  NumU = LevNum
  print at 27,22, digits$(NumU, 2)
  return
end sub

' the time bonus: 1000 less half the frames since the level began
sub ShowBonus:
  W16 = LvT >> 1
  if W16 >= 1000 then
    NumU = 0
  else
    NumU = 1000 - W16
  end if
  print at 9,22, "BONUS"
  print at 15,22, digits$(NumU, 4)
  return
end sub

' sprites 0-1 the robot (visor over body), 2 the missile, 3-4 the crusher's
' head (stripes over block), 5 a burst; the crusher's rod in tiles
sub DrawSprites:
  W16 = Mx >> 4
  X = W16 - 8
  H = Hz / 16
  Y = 95 - H
  F = 1
  if St <= Robot.Run then
    if Jf = 1 then
      F = 4
    elseif Mv = 1 then
      V = Anim >> 3
      F = V & 3
    end if
  elseif St = Robot.Falling then
    F = 5
    W16 = Fd >> 4
    W16 = W16 + 95
    if W16 > 150 then W16 = 192
    Y = W16
  elseif St = Robot.Shot then
    F = 6
  elseif St = Robot.Crushed then
    F = 7
  end if
  K = F << 3
  if Face = 1 then K = K + LeftOff
  K = K + SR0d0
  set sprite 0 to Y,X,K,8
  K = K + 4
  set sprite 1 to Y,X,K,15
  ' the missile
  Got = 0
  if HasMis = 1 then
    W16 = MisX16 >> 4
    if W16 >= 16 then
      if W16 < 272 then
        Got = 1
        W16 = W16 - 16
        X = W16
        V = Anim & 8
        K = SMis0
        if V > 0 then K = SMis1
        set sprite 2 to 96,X,K,3
      end if
    end if
  end if
  if Got = 0 then set sprite 2 to 192,0,0,0
  ' the crusher
  if HasCr = 1 then
    V = CrY[CrP]
    Y = V - 17
    set sprite 3 to Y,112,SCrs,1
    set sprite 4 to Y,112,SCrb,10
    T = V - 16
    T = T >> 3
    N = 0
    if T >= 6 then N = T - 5
    while RodHave < N
      R = RodHave + 6
      put char TRodL at 14,R
      put char TRodR at 15,R
      inc RodHave
    end while
    while RodHave > N
      dec RodHave
      R = RodHave + 6
      V = TWall
      if R = 6 then V = TWallTop
      put char V at 14,R
      put char V at 15,R
    end while
  else
    set sprite 3 to 192,0,0,0
    set sprite 4 to 192,0,0,0
  end if
  ' the burst where the missile hit
  if St = Robot.Shot then
    if DieT > 40 then
      W16 = Mx >> 4
      X = W16 - 8
      K = SSmoke
      T = 14
      if DieT > 60 then
        K = SBurst2
        T = 9
      end if
      if DieT > 75 then
        K = SBurst1
        T = 11
      end if
      set sprite 5 to 91,X,K,T
    else
      set sprite 5 to 192,0,0,0
    end if
  else
    set sprite 5 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 13
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the hangar, the robot running and jumping along the floor,
' the tune once, START / CREDITS
sub TitlePage:
  Lv = 1
  HasMis = 0
  HasCr = 0
  NewScreen
  DrawHangar
  for R = 7 to 11
    fill 32 count 18 at 7,R
  next
  print at 8,8, "H A N G E R   1 4"
  print at 12,10, "START"
  print at 12,11, "CREDITS"
  print at 18,1, "HI"
  ShowHi
  print at 7,22, "AHOY! JANUARY 1987"
  ShowMenu
  TMx = WalkX16
  THz = 0
  TVz = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 616
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitleAnim
  V = Pad & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the robot runs along the floor
sub TitleAnim:
  inc Anim
  TMx = TMx + RunSp
  if TMx >= 4000 then TMx = WalkX16
  if TVz <> 0 then
    THz = THz + TVz
    TVz = TVz - 1
    if THz <= 0 then
      THz = 0
      TVz = 0
    end if
  end if
  W16 = TMx >> 4
  X = W16 - 8
  H = THz / 16
  Y = 95 - H
  V = Anim >> 3
  F = V & 3
  if THz > 0 then F = 4
  K = F << 3
  K = K + SR0d0
  set sprite 0 to Y,X,K,8
  K = K + 4
  set sprite 1 to Y,X,K,15
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,10
  put char 32 at 10,11
  J = Menu + 10
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "HANGER  14"
  print at 2,5, "BASED ON HANGER 14 BY"
  print at 2,6, "JUSTIN LUTON, AHOY! JANUARY"
  print at 2,7, "1987 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: METALLION PATROL"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

