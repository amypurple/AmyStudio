' CASINO BLACKJACK
' The card game by John Hamilton from COMPUTE! magazine, March 1988
' (Commodore 64; Atari and Apple II versions by William Chin, IBM PC and
' Amiga versions by George Miller), for the ColecoVision in Amy by Amy
' Bienvenu.
'
' Las Vegas blackjack against the computer dealer, starting with a $100
' bankroll. Get closer to 21 than the dealer without going over: aces
' count 1 or 11, kings, queens and jacks 10. A blackjack (21 with two
' cards) pays 3 to 2 unless the dealer has one too. The dealer draws to
' 16 and stands on 17. A tie is a push: no money changes hands.
' Special plays, as in the article: insurance when the dealer shows an
' ace (half the bet; if the dealer has blackjack you keep your bet);
' doubling down on 10 or 11 (one more card, double the bet); surrender
' (lose half the bet, the first decision only); splitting two cards of
' the same rank into two hands.
'
' Controls (either joystick): when betting, the stick changes the bet
' (up/down 10 dollars, right/left 2); the button deals. Then left/right
' picks HIT, STAND, DOUBLE, SPLIT or SURRENDER and the button plays it.
' Keypad not used.
'
' Liberties taken:
' - Bets go by 2 dollars, so 3 to 2 and half bets stay whole dollars.
' - One deck, shuffled again when fewer than 15 cards are left.
' - The bankroll is kept until power off (no disk); when it runs out, a
'   new $100 bankroll on request.
' - The font's dollar sign is drawn by the game. Cards from Monte Carlo
'   (after the Apple II version's hi-res cards). New music (Vegas Strut).
'
' House rules kept: columns 2-29, rows 1-22; no sprites; the frame loop is
' protected from the NMI and every screen is drawn with the NMI off after
' a wait.

const TRk0 = 128
const TRk1 = 129
const TRk2 = 130
const TRk3 = 131
const TRk4 = 132
const TRk5 = 133
const TRk6 = 134
const TRk7 = 135
const TRk8 = 136
const TRk9 = 137
const TRk10 = 138
const TRk11 = 139
const TRk12 = 140
const TRr0 = 141
const TRr1 = 142
const TRr2 = 143
const TRr3 = 144
const TRr4 = 145
const TRr5 = 146
const TRr6 = 147
const TRr7 = 148
const TRr8 = 149
const TRr9 = 150
const TRr10 = 151
const TRr11 = 152
const TRr12 = 153
const TSs0 = 154
const TSs1 = 155
const TSs2 = 156
const TSs3 = 157
const TPipa00 = 158
const TPipa01 = 159
const TPipa10 = 160
const TPipa11 = 161
const TPipb00 = 162
const TPipb01 = 163
const TPipb10 = 164
const TPipb11 = 165
const TPipc00 = 166
const TPipc01 = 167
const TPipc10 = 168
const TPipc11 = 169
const TPipd00 = 170
const TPipd01 = 171
const TPipd10 = 172
const TPipd11 = 173
const TEtl = 174
const TEtr = 175
const TEl = 176
const TEr = 177
const TEbl = 178
const TEbr = 179
const TFelt = 180
const TSlot00 = 181
const TSlot01 = 182
const TSlot02 = 183
const TSlot03 = 184
const TSlot10 = 185
const TSlot11 = 186
const TSlot12 = 187
const TSlot13 = 188
const TSlot20 = 189
const TSlot21 = 190
const TSlot22 = 191
const TSlot23 = 192
const TBack00 = 193
const TBack01 = 194
const TBack02 = 195
const TBack03 = 196
const TBack10 = 197
const TBack11 = 198
const TBack12 = 199
const TBack13 = 200
const TBack20 = 201
const TBack21 = 202
const TBack22 = 203
const TBack23 = 204
const SArrow = 0
const SArrowl = 4
const NTiles8 = 616
const SprBytes = 64
const SndMove = 1
const SndOk = 2
const SndDeal = 3
const SndShuffle = 4
const SndWin = 5
const SndLose = 6
const SndTuneA = 7
const SndTuneB = 8

u8 Cd[52]
u8 Ph[24]
u8 Pn[2]
u16 Pb[2]
u8 Pst[2]
u8 Dh[12]
u8 Dn = 0
u8 Top = 0
u8 Hands = 1
u8 Hd = 0
u8 Hit1 = 0
u16 Money = 100
u16 Bet = 10
u16 Ins = 0
u16 NumU = 0
u16 Amt = 0
u8 Menu = 0
u8 Mode = 0
u8 Live = 0
u8 Opt = 0
u8 Nopt = 0
u8 Opts[5]
u8 Tot = 0
u8 Soft = 0
u8 DTot = 0
u8 PTot = 0
u8 Hole = 1
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Mix = 0
u8 Tick = 0
u8 Dk = 0
u8 Dr = 0
u8 Ds = 0
u8 Dx = 0
u8 Dy = 0
u8 Np = 0
u8 Ja = 0
u8 Ka = 0
u8 Ci = 0
u8 Cn = 0
u8 Hb = 0
u8 Res = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BjSoundTable areas 4
  nmi off
  HideSprites
  screen on
  Money = 100
  Top = 52

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if
  TableScreen

new_hand:
  if Money < 2 then goto broke
  if Bet > Money then Bet = Money
  V = Bet & 1
  if V = 1 then Bet = Bet - 1
  if Bet < 2 then Bet = 2
  ClearTable
  ShowMoney
  GetBet
  if Menu = 9 then goto title
  ' the deal: player, dealer, player, dealer (face down)
  if Top > 37 then Shuffle
  Hands = 1
  Hd = 0
  Pn[0] = 0
  Pn[1] = 0
  Pst[0] = 0
  Pst[1] = 0
  Pb[0] = Bet
  Pb[1] = 0
  Dn = 0
  Hole = 1
  Ins = 0
  Money = Money - Bet
  ShowMoney
  Hd = 0
  DealPlayer
  DealDealer
  DealPlayer
  DealDealer
  ShowPlayerTotal
  ' insurance against a dealer's ace
  Dk = Dh[0]
  CardOf
  if Dr = 0 then
    Amt = Bet >> 1
    if Money >= Amt then
      Message
      print at 2,21, "INSURANCE?"
      Opts[0] = 6
      Opts[1] = 7
      Nopt = 2
      ChooseOpt
      if Opts[Opt] = 6 then
        Ins = Amt
        Money = Money - Ins
        ShowMoney
      end if
    end if
  end if
  ' a dealer's blackjack ends the hand at once
  Dk = Dh[0]
  CardOf
  V = 0
  if Dr = 0 then V = 1
  if Dr >= 9 then V = 1
  if V = 1 then
    DealerTotal
    if DTot = 21 then
      Hole = 0
      DrawDealer
      ShowDealerTotal
      Message
      print at 2,22, "DEALER HAS BLACKJACK"
      if Ins > 0 then
        ' insurance: the bet is kept
        Money = Money + Bet
        Money = Money + Ins
        Res = 4
      else
        Hd = 0
        HandTotal
        if Tot = 21 then
          Money = Money + Bet
          Res = 3
        else
          Res = 2
        end if
      end if
      play sound SndLose
      Hd = 0
      ShowResult
      goto hand_end
    end if
    if Ins > 0 then
      Message
      print at 2,22, "NO BLACKJACK: INSURANCE LOST"
      play sound SndLose
      Pause1
    end if
  end if
  ' a player's blackjack pays 3 to 2
  Hd = 0
  HandTotal
  if Tot = 21 then
    Hole = 0
    DrawDealer
    ShowDealerTotal
    Amt = Bet >> 1
    Amt = Amt + Bet
    Money = Money + Bet
    Money = Money + Amt
    Res = 5
    ShowResult
    play sound SndWin
    goto hand_end
  end if

  ' the player's hands, one after the other
  Hd = 0
play_hand:
  Hit1 = 0
decide:
  Hb = Hd * 12
  HandTotal
  if Tot > 21 then
    Pst[Hd] = 1
    Res = 1
    ShowResult
    play sound SndLose
    goto hand_done
  end if
  if Tot = 21 then goto hand_done
  ' the choices
  Nopt = 0
  Opts[0] = 0
  Opts[1] = 1
  Nopt = 2
  N = Pn[Hd]
  if N = 2 then
    if Hit1 = 0 then
      ' double down on 10 or 11
      if Tot >= 10 then
        if Tot <= 11 then
          if Money >= Pb[Hd] then
            Opts[Nopt] = 2
            inc Nopt
          end if
        end if
      end if
      ' split two cards of the same rank (one split)
      if Hands = 1 then
        Dk = Ph[0]
        CardOf
        V = Dr
        Dk = Ph[1]
        CardOf
        if Dr = V then
          if Money >= Pb[0] then
            Opts[Nopt] = 3
            inc Nopt
          end if
        end if
        ' surrender
        Opts[Nopt] = 4
        inc Nopt
      end if
    end if
  end if
  Message
  if Hands = 2 then
    print at 2,22, "HAND"
    NumU = Hd + 1
    print at 7,22, digits$(NumU, 1)
  end if
  ChooseOpt
  V = Opts[Opt]
  if V = 0 then
    ' hit
    Hit1 = 1
    DealPlayer
    ShowPlayerTotal
    goto decide
  end if
  if V = 1 then goto hand_done
  if V = 2 then
    ' double down: one card, then stand
    Money = Money - Pb[Hd]
    Pb[Hd] = Pb[Hd] + Pb[Hd]
    ShowMoney
    DealPlayer
    ShowPlayerTotal
    HandTotal
    if Tot > 21 then
      Pst[Hd] = 1
      Res = 1
      ShowResult
      play sound SndLose
    end if
    goto hand_done
  end if
  if V = 3 then
    ' split: the second card starts hand 2
    Money = Money - Pb[0]
    Pb[1] = Pb[0]
    Ph[12] = Ph[1]
    Pn[0] = 1
    Pn[1] = 1
    Hands = 2
    ShowMoney
    DrawHands
    Hd = 0
    DealPlayer
    Hd = 1
    DealPlayer
    Hd = 0
    ShowPlayerTotal
    Hd = 1
    ShowPlayerTotal
    Hd = 0
    goto decide
  end if
  ' surrender: half the bet back
  Amt = Pb[0] >> 1
  Money = Money + Amt
  Pst[0] = 2
  Res = 6
  ShowResult
  play sound SndLose
hand_done:
  inc Hd
  if Hd < Hands then goto play_hand

  ' the dealer plays if a hand is still standing
  Live = 0
  Cn = Hands - 1
  for Hd = 0 to Cn
    if Pst[Hd] = 0 then Live = 1
  next
  Hole = 0
  DrawDealer
  ShowDealerTotal
  if Live = 1 then
dealer_draw:
    DealerTotal
    if DTot <= 16 then
      Pause1
      DealDealer
      ShowDealerTotal
      goto dealer_draw
    end if
  end if
  ' settle each hand
  for Hd = 0 to 1
    if Hd < Hands then
      if Pst[Hd] = 0 then Settle
    end if
  next

hand_end:
  ShowMoney
  Message
  print at 2,22, "PRESS A BUTTON"
  Mode = 3
  WaitPress
  Mode = 0
  goto new_hand

broke:
  Message
  print at 2,21, "YOU ARE OUT OF MONEY."
  print at 2,22, "NEW BANKROLL OF $100"
  WaitPress
  Money = 100
  Bet = 10
  goto title

' ---------------------------------------------------------------------------
' Cards

sub Shuffle:
  Message
  print at 2,22, "SHUFFLING..."
  play sound SndShuffle
  for J = 0 to 51
    Cd[J] = J
  next
  J = 51
sh_next:
  V = random(0, 255)
  V += Mix
  V += Tick
  N = J + 1
  while V >= N
    V -= N
  end while
  X = Cd[J]
  Cd[J] = Cd[V]
  Cd[V] = X
  Mix += 37
  dec J
  if J > 0 then goto sh_next
  Top = 0
  Pause1
  Message
  return
end sub

' Dk = a card: Dr = rank (0 ace - 12 king), Ds = suit
sub CardOf:
  Dr = Dk
  Ds = 0
  while Dr >= 13
    Dr -= 13
    inc Ds
  end while
  return
end sub

' DealPlayer: the next card to hand Hd
sub DealPlayer:
  Hb = Hd * 12
  V = Pn[Hd]
  V = V + Hb
  Ph[V] = Cd[Top]
  inc Top
  inc Pn[Hd]
  play sound SndDeal
  DrawHands
  Pause1
  return
end sub

sub DealDealer:
  Dh[Dn] = Cd[Top]
  inc Top
  inc Dn
  play sound SndDeal
  DrawDealer
  Pause1
  return
end sub

' HandTotal: Tot of hand Hd (aces 11 when that does not bust)
sub HandTotal:
  Hb = Hd * 12
  Tot = 0
  Soft = 0
  Cn = Pn[Hd]
  for Ci = 1 to Cn
    V = Hb + Ci
    dec V
    Dk = Ph[V]
    CardOf
    Count
  next
  if Soft = 1 then
    if Tot <= 11 then Tot = Tot + 10
  end if
  return
end sub

sub DealerTotal:
  Tot = 0
  Soft = 0
  for Ci = 1 to Dn
    V = Ci - 1
    Dk = Dh[V]
    CardOf
    Count
  next
  if Soft = 1 then
    if Tot <= 11 then Tot = Tot + 10
  end if
  DTot = Tot
  return
end sub

' Count: add card rank Dr to Tot (an ace counts 1 here, Soft remembers it)
sub Count:
  V = Dr + 1
  if V > 10 then V = 10
  if Dr = 0 then Soft = 1
  Tot = Tot + V
  return
end sub

' Settle: hand Hd against the dealer
sub Settle:
  HandTotal
  PTot = Tot
  DealerTotal
  if DTot > 21 then
    Res = 7
  else
    if PTot > DTot then Res = 7
    if PTot = DTot then Res = 3
    if PTot < DTot then Res = 2
  end if
  if Res = 7 then
    Money = Money + Pb[Hd]
    Money = Money + Pb[Hd]
    play sound SndWin
  end if
  if Res = 3 then Money = Money + Pb[Hd]
  if Res = 2 then play sound SndLose
  ShowResult
  return
end sub

' ---------------------------------------------------------------------------
' Choices

' ChooseOpt: Nopt choices from Opts on row 21; Opt = the one taken
sub ChooseOpt:
  Mode = 2
  Opt = 0
  WasBtn = 1
co_draw:
  fill 32 count 28 at 2,21
  X = 3
  Cn = Nopt - 1
  for I = 0 to Cn
    V = Opts[I]
    if I = Opt then
      W = X - 1
      print at W,21, ">"
    end if
    if V = 0 then print at X,21, "HIT"
    if V = 1 then print at X,21, "STAND"
    if V = 2 then print at X,21, "DOUBLE"
    if V = 3 then print at X,21, "SPLIT"
    if V = 4 then print at X,21, "SURR."
    if V = 6 then print at X,21, "YES"
    if V = 7 then print at X,21, "NO"
    X = X + 6
  next
co_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Rt1 = 1 then
      V = Opt + 1
      if V < Nopt then Opt = V
    end if
    if Lf1 = 1 then
      if Opt > 0 then dec Opt
    end if
    play sound SndMove
    goto co_draw
  end if
  if Press = 0 then goto co_loop
  play sound SndOk
  fill 32 count 28 at 2,21
  Mode = 0
  return
end sub

' GetBet: the stick sets the bet, the button deals (Menu 9: back to title)
sub GetBet:
  Mode = 1
  Menu = 0
  WasBtn = 1
gb_draw:
  Message
  print at 2,21, "YOUR BET? $"
  NumU = Bet
  print at 13,21, digits$(NumU, 4)
  print at 2,22, "STICK: CHANGE  BUTTON: DEAL"
gb_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then Bet = Bet + 10
    if Rt1 = 1 then Bet = Bet + 2
    if Dn1 = 1 then
      if Bet > 10 then
        Bet = Bet - 10
      else
        Bet = 2
      end if
    end if
    if Lf1 = 1 then
      if Bet > 2 then Bet = Bet - 2
    end if
    if Bet > Money then
      Bet = Money
      V = Bet & 1
      if V = 1 then Bet = Bet - 1
    end if
    play sound SndMove
    ShowMoney
    goto gb_draw
  end if
  if Press = 0 then goto gb_loop
  Message
  Mode = 0
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

sub DrawDealer:
  Dy = 3
  for Ci = 0 to 6
    Dx = Ci * 4
    Dx = Dx + 2
    if Ci < Dn then
      Dk = Dh[Ci]
      V = 0
      if Ci = 1 then V = Hole
      if V = 1 then
        DrawBack
      else
        DrawCard
      end if
    else
      ClearCard
    end if
  next
  return
end sub

sub DrawHands:
  for K = 0 to 1
    Dy = K * 6
    Dy = Dy + 10
    Hb = K * 12
    Cn = Pn[K]
    for Ci = 0 to 6
      Dx = Ci * 4
      Dx = Dx + 2
      if Ci < Cn then
        V = Hb + Ci
        Dk = Ph[V]
        DrawCard
      else
        ClearCard
      end if
    next
  next
  if Hands = 2 then
    print at 2,15, "HAND 2"
    print at 2,9, "HAND 1"
  end if
  return
end sub

sub ClearTable:
  Hands = 1
  Pn[0] = 0
  Pn[1] = 0
  Dn = 0
  DrawDealer
  DrawHands
  fill TFelt count 28 at 2,6
  fill TFelt count 28 at 2,9
  fill TFelt count 28 at 2,13
  fill TFelt count 28 at 2,15
  fill TFelt count 28 at 2,19
  print at 2,2, "DEALER"
  print at 2,9, "YOU"
  return
end sub

sub ShowPlayerTotal:
  HandTotal
  Y = Hd * 6
  Y = Y + 13
  fill TFelt count 12 at 2,Y
  NumU = Tot
  print at 2,Y, digits$(NumU, 2)
  return
end sub

sub ShowDealerTotal:
  DealerTotal
  fill TFelt count 12 at 2,6
  NumU = DTot
  print at 2,6, digits$(NumU, 2)
  return
end sub

' ShowResult: Res for hand Hd next to its total
sub ShowResult:
  Y = Hd * 6
  Y = Y + 13
  X = 6
  if Res = 1 then print at X,Y, "BUST"
  if Res = 2 then print at X,Y, "LOSE"
  if Res = 3 then print at X,Y, "PUSH"
  if Res = 4 then print at X,Y, "INSURED: BET KEPT"
  if Res = 5 then print at X,Y, "BLACKJACK! PAYS 3 TO 2"
  if Res = 6 then print at X,Y, "SURRENDERED"
  if Res = 7 then print at X,Y, "WIN"
  return
end sub

sub ShowMoney:
  fill 32 count 28 at 2,1
  print at 2,1, "BANK $"
  NumU = Money
  print at 8,1, digits$(NumU, 5)
  print at 17,1, "BET $"
  NumU = Pb[0]
  NumU = NumU + Pb[1]
  if Pn[0] = 0 then NumU = Bet
  print at 22,1, digits$(NumU, 4)
  return
end sub

sub Message:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

' DrawCard: card Dk face up at Dx,Dy (4 x 3 tiles)
sub DrawCard:
  CardOf
  put char TEtl at Dx,Dy
  X = Dx + 1
  V = TRk0 + Dr
  if Ds < 2 then V = TRr0 + Dr
  put char V at X,Dy
  inc X
  V = TSs0 + Ds
  put char V at X,Dy
  inc X
  put char TEtr at X,Dy
  Np = Ds * 4
  Np += TPipa00
  Y = Dy + 1
  put char TEl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char TEr at X,Y
  inc Np
  inc Y
  put char TEbl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char TEbr at X,Y
  return
end sub

sub DrawBack:
  for Ja = 0 to 2
    Y = Dy + Ja
    V = Ja * 4
    V = V + TBack00
    for Ka = 0 to 3
      X = Dx + Ka
      put char V at X,Y
      inc V
    next
  next
  return
end sub

sub ClearCard:
  for Ja = 0 to 2
    Y = Dy + Ja
    fill TFelt count 4 at Dx,Y
  next
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub Pause1:
  for J = 1 to 18
    Frame1
  next
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 16
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 5
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

' the font has no dollar sign: draw one at code 36 in the three thirds
data Dollar bytes
  $10,$7C,$90,$7C,$12,$7C,$10,$00
end data

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  backdrop dark green
  cls
  for Y = 2 to 20
    fill TFelt count 28 at 2,Y
  next
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TableScreen:
  NewScreen
  ClearTable
  ShowMoney
  ShowScreen
  return
end sub

sub TitlePage:
  NewScreen
  print at 7,2, "CASINO  BLACKJACK"
  ' a blackjack: the ace and the king of spades
  Dx = 10
  Dy = 5
  Dk = 26
  DrawCard
  Dx = 14
  Dk = 38
  DrawCard
  print at 11,10, "PLAY"
  print at 11,12, "HOW TO PLAY"
  print at 11,14, "CREDITS"
  print at 6,17, "YOUR BANKROLL $"
  NumU = Money
  print at 21,17, digits$(NumU, 5)
  print at 6,22, "1988 JOHN HAMILTON"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndMove
  end if
  print at 9,10, " "
  print at 9,12, " "
  print at 9,14, " "
  Y = Menu * 2
  Y = Y + 10
  print at 9,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "GET CLOSER TO 21 THAN THE"
  print at 2,4, "DEALER WITHOUT GOING OVER."
  print at 2,5, "ACES: 1 OR 11. PICTURES: 10."
  print at 2,6, "BLACKJACK PAYS 3 TO 2. THE"
  print at 2,7, "DEALER STANDS ON 17."
  print at 2,9, "INSURANCE: HALF YOUR BET,"
  print at 2,10, "KEEPS IT IF THE DEALER HAS"
  print at 2,11, "BLACKJACK. DOUBLE: ON 10 OR"
  print at 2,12, "11, ONE CARD. SPLIT: A PAIR"
  print at 2,13, "MAKES TWO HANDS. SURRENDER:"
  print at 2,14, "GET HALF YOUR BET BACK."
  print at 2,16, "BET: STICK, BUTTON DEALS."
  print at 2,17, "PLAY: LEFT/RIGHT, BUTTON."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub EditorialPage:
  NewScreen
  print at 7,1, "CASINO  BLACKJACK"
  print at 2,3, "BY JOHN HAMILTON, FROM"
  print at 2,4, "COMPUTE! MAGAZINE, MARCH"
  print at 2,5, "1988, FOR THE COMMODORE 64."
  print at 2,6, "ATARI AND APPLE II BY"
  print at 2,7, "WILLIAM CHIN; IBM PC AND"
  print at 2,8, "AMIGA BY GEORGE MILLER."
  print at 2,10, "NEW MUSIC: VEGAS STRUT."
  print at 2,12, "COLECOVISION VERSION BY"
  print at 2,13, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

