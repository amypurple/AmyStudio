cartridge "ELFRED/D.&J. ARNOLD/1985"

' ELFRED
' A ColecoVision game based on "Elfred" by David R. Arnold and Janet
' Arnold, Ahoy! March 1985 (Commodore 64 BASIC with sprites).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/ELFRED.bas, and played in jsc64), the game is built for the
' ColecoVision: smooth two-colour sprites, a tiled workshop (toy boxes,
' window, stool, moving belt, bag), sound effects and an original tune.
'
' The game: help Elfred the elf pack the bags. For each bag, Elfred shows
' the eight toys one after another; press the button five times to choose
' five toys for the bag (the same toy may be chosen twice); they appear in
' the five boxes on the wall. Then toys ride the belt from the toy machine
' to the bin. Press the button while a wanted toy is over the hatch under
' Elfred: it drops into the bag (HOORAY!) and its box is ticked. A press
' anywhere else, or on a toy that isn't wanted, is a miss (OOPS!) and the
' toy falls to the floor; a wanted toy that rides past into the bin is a
' miss too. After five toys have gone by without a press, the next toy is
' always a wanted one. When the five toys are in the bag, the next bag is
' chosen. The total of misses over all bags is your score: lower is
' better.
'
' From the original (orig/ELFRED.bas): 1-5 bags, speeds 0-9, the eight
' toys and their order (giraffe, rocking horse, drum, plane, boat, duck,
' book, spider), the toy shown in turn while choosing, five toys a bag,
' the drop window (33 pixels, under the elf), the misses (press outside
' the window, unwanted toy, wanted toy let past), the forced wanted toy
' after five passes without a press, a wanted toy counted once per press,
' MISSES totalled over the bags, HOORAY!/OOPS! in the bubble, the elf's
' little dance after a miss, the toy falling from the belt.
'
' Liberties: belt speeds as measured in jsc64 (speed 0 about 26 pixels a
' second, speed 9 about 260: (speed+1) x 7/16 pixel a frame); the belt is
' 180 pixels long instead of 249 (the screen is narrower), so a toy is in
' view a little less long. The joystick replaces the keyboard: no bag
' names (the bags are numbered: the C64 asked for a name per bag), number
' of bags and speed set on the title menu, and while choosing the stick
' also steps through the toys (the original only cycled them, about one a
' second; here one every 50 frames). Elfred reaches out while the toy is
' over the hatch (the C64 elf changed pose late in the window). The
' C64 played a traditional carol at the start; here an original tune.
' Ending: the total, then back to the title (no PLAY AGAIN? prompt).
' Standing still can't win: a wanted toy let past is a miss, and pressing
' at random costs a miss every time, as in the original.
'
' Controls: either controller; button: choose a toy / drop the toy; stick
' left/right while choosing: previous/next toy. Title: up/down choose a
' line, left/right change BAGS and SPEED, a button on START or CREDITS.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes.

const TIc000 = 128
const TIc001 = 129
const TIc010 = 130
const TIc011 = 131
const TIc100 = 132
const TIc101 = 133
const TIc110 = 134
const TIc111 = 135
const TIc200 = 136
const TIc201 = 137
const TIc210 = 138
const TIc211 = 139
const TIc300 = 140
const TIc301 = 141
const TIc310 = 142
const TIc311 = 143
const TIc400 = 144
const TIc401 = 145
const TIc410 = 146
const TIc411 = 147
const TIc500 = 148
const TIc501 = 149
const TIc510 = 150
const TIc511 = 151
const TIc600 = 152
const TIc601 = 153
const TIc610 = 154
const TIc611 = 155
const TIc700 = 156
const TIc701 = 157
const TIc710 = 158
const TIc711 = 159
const TWall = 160
const TWall2 = 161
const TBxtl = 162
const TBxtr = 163
const TBxbl = 164
const TBxbr = 165
const TBxt = 166
const TBxb = 167
const TBxl = 168
const TBxr = 169
const TBxc = 170
const TTick = 171
const TWntl = 172
const TWntr = 173
const TWnt = 174
const TWnl = 175
const TWnr = 176
const TWnc = 177
const TWnm = 178
const TWnbl = 179
const TWnb = 180
const TBbtl = 181
const TBbtr = 182
const TBbt = 183
const TBbl = 184
const TBbr = 185
const TBbbl = 186
const TBbbr = 187
const TBbb = 188
const TBbtail = 189
const TStl = 190
const TStl2 = 191
const TBelt0 = 192
const TBelt1 = 193
const TBelt2 = 194
const TBelt3 = 195
const TBelt = 196
const THatch = 197
const TRoll = 198
const TLeg = 199
const TMach1 = 200
const TMach2 = 201
const TMach3 = 202
const TBin1 = 203
const TBin2 = 204
const TFloor = 205
const TBagtl = 206
const TBagtr = 207
const TBagt = 208
const TBagl = 209
const TBagr = 210
const TBagc = 211
const TBagc2 = 212
const TBagbl = 213
const TBagbr = 214
const TBagb = 215
const SToy0 = 0
const SToy0d = 4
const SToy1 = 8
const SToy1d = 12
const SToy2 = 16
const SToy2d = 20
const SToy3 = 24
const SToy3d = 28
const SToy4 = 32
const SToy4d = 36
const SToy5 = 40
const SToy5d = 44
const SToy6 = 48
const SToy6d = 52
const SToy7 = 56
const SToy7d = 60
const SHat = 64
const SFace = 68
const SSuitstand = 72
const SBootstand = 76
const SSuitreach = 80
const SBootreach = 84
const SSuitcheer = 88
const SBootcheer = 92
const SStar = 96
const NTiles8 = 704
const SprBytes = 800
const SndTuneA = 1
const SndTuneB = 2
const SndPick = 3
const SndTick = 4
const SndDrop = 5
const SndHooray = 6
const SndOops = 7
const SndThud = 8
const SndBag = 9
const SndStart = 10
const SndDone = 11
const NSpr = 6
const ZoneL = 104
const ZoneR = 136
const BeltY = 95
const XStart = 32
const XEnd = 212
const CycN = 50
const ReactN = 45
const PhChoose = 0
const PhBelt = 1
const PhFall = 2
const PhReact = 3
const PhWait = 4

' the toys' colours (main, detail)
data ToyCol bytes
  11, 10, 15, 8, 8, 15, 13, 15, 8, 15, 11, 9, 2, 15, 1, 15
end data
' the boxes' columns on the wall
data BoxC bytes
  4, 9, 14, 19, 24
end data

' the toy on the belt (or in Elfred's hands)
record Mover:
  u8 Kind
  u16 X16
  u8 Y
  u8 Good
end record
Mover Toy

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 3 Miss
u8 Bags = 1
u8 Spd = 4
u8 Bag = 1
u8 Step16 = 7
u8 Ph = 0
u8 G[5]
u8 Zc = 0
u8 CycT = 0
u8 Mc = 0
u8 ReactT = 0
u8 WasIn = 0
u8 Over = 0
u8 ElfX = 120
u8 Pose = 0
u8 Shake = 0
u8 BeltF = 0
u8 BeltAcc = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Stick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Bi = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ElSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the total, then back to the title on a press
  mute all
  SayClear
  print at 19,8, "ALL BAGS"
  print at 19,9, " PACKED!"
  print at 19,10, "MISSES"
  print Miss at 26,10
  Pose = 2
  DrawSprites
  play sound SndDone
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  select case Ph
  case PhChoose
    ChooseStep
  case PhBelt
    BeltStep
  case PhFall
    FallStep
  case PhReact
    ReactStep
  case else
    ' PhWait: a short pause after the choosing, then the first toy
    dec ReactT
    if ReactT = 0 then NextToy
  end select
  return
end sub

' choosing: the toys shown in turn in Elfred's hand
sub ChooseStep:
  inc CycT
  K = 0
  if CycT >= CycN then K = 1
  if Stick <> WasStick then
    if Stick = 8 then K = 1
    if Stick = 4 then K = 2
  end if
  if K > 0 then
    CycT = 0
    if K = 1 then
      V = Toy.Kind + 1
      Toy.Kind = V & 7
    else
      V = Toy.Kind + 7
      Toy.Kind = V & 7
    end if
    play sound SndTick
  end if
  if Press = 0 then return
  G[Zc] = Toy.Kind + 1
  DrawBox(Zc)
  inc Zc
  CycT = 0
  play sound SndPick
  if Zc < 5 then return
  Ph = PhWait
  ReactT = 40
  SayDrop
  return
end sub

' the belt: the toy rides right; a press drops it
sub BeltStep:
  W16 = Step16
  Toy.X16 = Toy.X16 + W16
  BeltAcc = BeltAcc + Step16
  if BeltAcc >= 32 then
    BeltAcc = BeltAcc - 32
    V = BeltF + 3
    BeltF = V & 3
    BeltFrame
  end if
  X = ToyX
  Pose = 0
  if InZone(X) = 1 then Pose = 1
  if Press = 1 then
    Toy.Good = 0
    if InZone(X) = 1 then
      K = WantedSlot(Toy.Kind)
      if K > 0 then
        Toy.Good = K
      end if
    end if
    if Toy.Good = 0 then
      AddMiss
    end if
    Ph = PhFall
    play sound SndDrop
    return
  end if
  if X < XEnd then return
  ' into the bin: a wanted toy let past is a miss
  Toy.Y = 192
  inc Mc
  if WantedSlot(Toy.Kind) > 0 then
    AddMiss
    StartReact
    return
  end if
  NextToy
  return
end sub

' the toy falls: into the bag (good) or to the floor
sub FallStep:
  Toy.Y = Toy.Y + 3
  if Toy.Good > 0 then
    if Toy.Y < 128 then return
    Toy.Y = 192
    K = Toy.Good - 1
    G[K] = 0
    DrawBox(K)
    Pose = 2
    SayHooray
    play sound SndHooray
    Ph = PhReact
    ReactT = ReactN
    return
  end if
  if Toy.Y < 150 then return
  Toy.Y = 192
  play sound SndThud
  StartReact
  return
end sub

sub StartReact:
  Pose = 0
  Shake = 1
  SayOops
  play sound SndOops
  Ph = PhReact
  ReactT = ReactN
  return
end sub

' Elfred's dance, then the next toy or the next bag
sub ReactStep:
  dec ReactT
  if ReactT > 0 then return
  Pose = 0
  Shake = 0
  if WantedLeft = 0 then
    if Bag >= Bags then
      Over = 1
      return
    end if
    inc Bag
    StartBag
    play sound SndBag
    return
  end if
  SayDrop
  NextToy
  return
end sub

' the next toy at the machine: random, or after five toys gone by without a
' press, the first wanted one
sub NextToy:
  Ph = PhBelt
  Rand
  V = Rs & 7
  Toy.Kind = V
  if Mc >= 5 then
    Mc = 0
    for Bi = 0 to 4
      if G[Bi] > 0 then
        if Mc = 0 then
          Toy.Kind = G[Bi] - 1
          Mc = 9
        end if
      end if
    next
    Mc = 0
  end if
  W16 = XStart
  Toy.X16 = W16 << 4
  Toy.Y = BeltY
  Toy.Good = 0
  return
end sub

function ToyX as u8
  W16 = Toy.X16 >> 4
  return W16

function InZone(u8 Px) as u8
  if Px < ZoneL then return 0
  if Px > ZoneR then return 0
  return 1

' the first box still waiting for toy K (1-5), or 0
function WantedSlot(u8 Kind) as u8
  u8 Want = Kind + 1
  u8 Slot = 0
  for Bi = 0 to 4
    if Slot = 0 then
      if G[Bi] = Want then Slot = Bi + 1
    end if
  next
  return Slot

function WantedLeft as u8
  u8 Left = 0
  for Bi = 0 to 4
    if G[Bi] > 0 then inc Left
  next
  return Left

sub AddMiss:
  Miss += 1
  print Miss at 27,1
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the belt ridges: one of four frames over the belt tile (middle third)
sub BeltFrame:
  W16 = TBelt0 - 128 + BeltF
  W16 = W16 << 3
  copy TilePat + W16 count 8 to vram.pattern + 2048 + TBelt * 8
  return
end sub

' box B: the toy's icon, a tick, or empty
sub DrawBox(u8 B):
  C = BoxC[B] + 1
  V = G[B]
  if V = 0 then
    put char TTick at C,4
    put char TBxc at C + 1,4
    put char TBxc at C,5
    put char TBxc at C + 1,5
    return
  end if
  T = V - 1
  T = T << 2
  T = T + TIc000
  put char T at C,4
  put char T + 1 at C + 1,4
  put char T + 2 at C,5
  put char T + 3 at C + 1,5
  return
end sub

sub EmptyBoxes:
  for Bi = 0 to 4
    C = BoxC[Bi]
    put char TBxtl at C,3
    fill TBxt count 2 at C + 1,3
    put char TBxtr at C + 3,3
    put char TBxl at C,4
    put char TBxl at C,5
    fill TBxc count 2 at C + 1,4
    fill TBxc count 2 at C + 1,5
    put char TBxr at C + 3,4
    put char TBxr at C + 3,5
    put char TBxbl at C,6
    fill TBxb count 2 at C + 1,6
    put char TBxbr at C + 3,6
  next
  return
end sub

sub SayClear:
  fill 32 count 9 at 19,8
  fill 32 count 9 at 19,9
  fill 32 count 9 at 19,10
  return
end sub

sub SayChoose:
  SayClear
  print at 19,8, "PRESS THE"
  print at 19,9, "BUTTON TO"
  print at 19,10, " CHOOSE"
  return
end sub

sub SayDrop:
  SayClear
  print at 19,8, "PRESS THE"
  print at 19,9, "BUTTON TO"
  print at 19,10, "DROP TOY"
  return
end sub

sub SayHooray:
  SayClear
  print at 20,9, "HOORAY!"
  return
end sub

sub SayOops:
  SayClear
  print at 21,9, "OOPS!"
  return
end sub

' sprites: 0-1 Elfred's head, 2-3 his body, 4-5 the toy
sub DrawSprites:
  X = ElfX
  if Shake = 1 then
    V = Tick >> 2
    V = V & 1
    if V = 1 then X = X + 2
  end if
  Y = 63
  if Pose = 2 then
    V = Tick >> 3
    V = V & 1
    if V = 1 then Y = 60
  end if
  set sprite 0 to Y,X,SHat,12
  set sprite 1 to Y,X,SFace,9
  Y = Y + 16
  K = Pose << 3
  K = K + SSuitstand
  set sprite 2 to Y,X,K,2
  K = K + 4
  set sprite 3 to Y,X,K,1
  if TitleOn = 1 then
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
    update sprites
    return
  end if
  if Ph = PhChoose then
    X = ElfX + 14
    Y = 79
  else
    X = ToyX
    Y = Toy.Y
  end if
  if Y = 192 then
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
  else
    K = Toy.Kind << 1
    C = ToyCol[K]
    N = K << 2
    set sprite 4 to Y,X,N + 4,ToyCol[K + 1]
    set sprite 5 to Y,X,N,C
  end if
  update sprites
  return
end sub

sub ShowHud:
  fill 32 count 32 at 0,1
  print at 2,1, "SPEED"
  print Spd at 8,1 digits 1
  print at 11,1, "BAG"
  print Bag at 15,1 digits 1
  print at 16,1, "/"
  print Bags at 17,1 digits 1
  print at 20,1, "MISSES"
  print Miss at 27,1
  return
end sub

' the workshop
sub DrawScene:
  for Ri = 2 to 15
    for J = 0 to 31
      V = J + Ri
      V = V & 1
      put char TWall + V at J,Ri
    next
  next
  EmptyBoxes
  ' the window
  put char TWntl at 3,8
  fill TWnt count 4 at 4,8
  put char TWntr at 8,8
  for Ri = 9 to 11
    put char TWnl at 3,Ri
    fill TWnc count 4 at 4,Ri
    put char TWnr at 8,Ri
  next
  put char TWnm at 5,10
  put char TWnbl at 3,12
  fill TWnb count 5 at 4,12
  ' the bubble
  put char TBbtl at 18,7
  fill TBbt count 9 at 19,7
  put char TBbtr at 28,7
  for Ri = 8 to 10
    put char TBbl at 18,Ri
    fill 32 count 9 at 19,Ri
    put char TBbr at 28,Ri
  next
  put char TBbbl at 18,11
  fill TBbb count 9 at 19,11
  put char TBbbr at 28,11
  put char TBbtail at 17,11
  ' the stool, the machine, the belt, the bin
  fill TStl count 2 at 15,12
  fill TStl2 count 2 at 15,13
  put char TMach1 at 2,11
  put char TMach1 at 3,11
  put char TMach2 at 2,12
  put char TMach2 at 3,12
  for Ri = 13 to 15
    fill TMach3 count 2 at 2,Ri
  next
  fill TBelt count 24 at 4,14
  fill THatch count 4 at 14,14
  fill TRoll count 24 at 4,15
  fill TBin1 count 2 at 28,12
  for Ri = 13 to 15
    fill TBin2 count 2 at 28,Ri
  next
  ' the floor and the bag
  for Ri = 16 to 21
    fill TFloor count 32 at 0,Ri
  next
  put char TBagtl at 13,17
  fill TBagt count 4 at 14,17
  put char TBagtr at 18,17
  for Ri = 18 to 20
    put char TBagl at 13,Ri
    fill TBagc count 4 at 14,Ri
    put char TBagr at 18,Ri
  next
  put char TBagc2 at 15,19
  put char TBagbl at 13,21
  fill TBagb count 4 at 14,21
  put char TBagbr at 18,21
  return
end sub

' a new bag: empty boxes, Elfred holds the first toy
sub StartBag:
  for Bi = 0 to 4
    G[Bi] = 0
  next
  EmptyBoxes
  Zc = 0
  CycT = 0
  Mc = 0
  Toy.Kind = 0
  Toy.Y = BeltY
  Toy.Good = 0
  Ph = PhChoose
  Pose = 0
  Shake = 0
  SayChoose
  ShowHud
  print at 11,22, "FOR BAG"
  print Bag at 19,22 digits 1
  return
end sub

sub NewGame:
  Miss = 0
  Bag = 1
  V = Spd + 1
  Step16 = V * 7
  NewScreen
  DrawScene
  TitleOn = 0
  Over = 0
  StartBag
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  WasStick = Stick
  Stick = V & 15
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the workshop, Elfred, the menu, the tune once
sub TitlePage:
  NewScreen
  DrawScene
  fill 32 count 32 at 0,1
  print at 12,1, "ELFRED"
  SayClear
  print at 19,8, " HELP ME"
  print at 19,9, "PACK THE"
  print at 19,10, "  BAGS!"
  for Ri = 16 to 22
    fill 32 count 28 at 2,Ri
  next
  print at 3,16, "BY DAVID R. AND JANET"
  print at 3,17, "ARNOLD, AHOY! MARCH 1985"
  ShowMenu
  TitleOn = 1
  Pose = 0
  Shake = 0
  Ph = PhChoose
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Menu = 2
  ShowMenu
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if Stick <> WasStick then
    if Stick = 1 then
      if Menu > 0 then dec Menu
      play sound SndTick
    end if
    if Stick = 2 then
      if Menu < 3 then inc Menu
      play sound SndTick
    end if
    if Stick = 4 then MenuChange(0)
    if Stick = 8 then MenuChange(1)
    ShowMenu
  end if
  DrawSprites
  if Press = 0 then goto tp_loop
  if Menu < 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub MenuChange(u8 Up):
  if Menu = 0 then
    if Up = 1 then
      if Bags < 5 then inc Bags
    else
      if Bags > 1 then dec Bags
    end if
  end if
  if Menu = 1 then
    if Up = 1 then
      if Spd < 9 then inc Spd
    else
      if Spd > 0 then dec Spd
    end if
  end if
  play sound SndTick
  return
end sub

sub ShowMenu:
  print at 9,19, "BAGS    <   >"
  print Bags at 19,19 digits 1
  print at 9,20, "SPEED   <   >"
  print Spd at 19,20 digits 1
  print at 9,21, "START"
  print at 9,22, "CREDITS"
  for Bi = 19 to 22
    put char 32 at 7,Bi
  next
  J = Menu + 19
  put char 62 at 7,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "ELFRED"
  print at 2,5, "BASED ON ELFRED BY DAVID R."
  print at 2,6, "ARNOLD AND JANET ARNOLD,"
  print at 2,7, "AHOY! MARCH 1985"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: WORKSHOP BELLS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

