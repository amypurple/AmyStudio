cartridge "REVERSI/ROD CARTY/1986"

' REVERSI
' A ColecoVision game based on "Reversi" by Rod Carty, Ahoy! August 1986
' (Commodore 64, BASIC, 41 blocks). Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/reversi.bas), the game is rebuilt for the ColecoVision:
' tile discs that turn over one after another, a smooth cursor sprite,
' sound effects and an original title tune.
'
' The game: two players, GREEN (controller 1) and WHITE (controller 2), on
' the standard 8 x 8 board, four discs in the middle (white on the
' top-left/bottom-right diagonal). White moves first. Place a disc so that
' it brackets one or more of the other player's discs in a straight line
' (across, down or diagonally) between it and one of your own: all the
' bracketed discs turn to your colour. A square that brackets nothing is a
' bad move. A player may pass at any time (the original's way of giving a
' weaker player a start, "a turn or two passed early in the game"). The
' game ends when the board is full or one colour is wiped out ("SHUT-OUT");
' the player with more discs wins.
'
' From the original: the board and the starting discs, white first, the
' colours green and white, each player on his own controller (green port
' 1, white port 2), one cursor shared by both players that moves in eight
' directions and stays on the board, its colour showing whose turn it is,
' the messages POSITION OCCUPIED, SORRY, BAD MOVE, PLAYER PASSES, SHUT-OUT,
' TIE GAME, GREEN/WHITE PLAYER WINS, the running counts (GREEN HAS / WHITE
' HAS), passing at will, the end on a full board or a shut-out. It is
' strictly a two-player game: the original has no computer player, so
' this version has none either.
'
' Liberties:
' - The game also ends when neither player can move (the C64 version
'   needed both players to keep passing for ever), with "NO MOVES LEFT".
' - When the player to move has no legal square, a hint says so; one press
'   of the right button then passes. Otherwise passing takes two presses
'   (the first asks), so a slip of the thumb cannot pass a turn.
' - The cursor keeps a held direction moving (repeat), and a blocked axis
'   of a diagonal is dropped instead of cancelling the move.
' - Discs turn over one after another (edge-on frames) with a tick each,
'   instead of changing colour all at once.
' - The end shows the result and returns to the title; no ANOTHER GAME
'   question (house rule). Keyboard controls are gone: joystick only.
' - The instructions are a HOW TO PLAY page reached from the title menu.
'
' Controls: the player to move uses his own controller. Stick: move the
' cursor (eight directions). Left button: place a disc. Right button:
' pass (press twice; once when there is no move). Title: up and down
' choose, a button selects.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes.

const TCempty00 = 128
const TCempty01 = 129
const TCempty10 = 130
const TCempty11 = 131
const TCwhite00 = 132
const TCwhite01 = 133
const TCwhite10 = 134
const TCwhite11 = 135
const TCgreen00 = 136
const TCgreen01 = 137
const TCgreen10 = 138
const TCgreen11 = 139
const TCwhiteh00 = 140
const TCwhiteh01 = 141
const TCwhiteh10 = 142
const TCwhiteh11 = 143
const TCgreenh00 = 144
const TCgreenh01 = 145
const TCgreenh10 = 146
const TCgreenh11 = 147
const TFl = 148
const TFr = 149
const TFt = 150
const TFb = 151
const TFtl = 152
const TFtr = 153
const TFbl = 154
const TFbr = 155
const TRule = 156
const TLr00 = 157
const TLr01 = 158
const TLr10 = 159
const TLr11 = 160
const TLe00 = 161
const TLe01 = 162
const TLe10 = 163
const TLe11 = 164
const TLv00 = 165
const TLv01 = 166
const TLv10 = 167
const TLv11 = 168
const TLs00 = 169
const TLs01 = 170
const TLs10 = 171
const TLs11 = 172
const TLi00 = 173
const TLi01 = 174
const TLi10 = 175
const TLi11 = 176
const SCursor = 0
const NTiles8 = 392
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndMove = 3
const SndPlace = 4
const SndFlip = 5
const SndBad = 6
const SndPass = 7
const SndStart = 8
const SndWin = 9
const NSpr = 2
const MsgN = 100
const AskN = 150
const CellX = 8
const CellY = 4
const Border = 3

' the eight directions on the 10 x 10 board (one border square all round):
' -11, -10, -9, -1, +1, +9, +10, +11 as bytes (the sums wrap)
data DirT bytes
  245, 246, 247, 255, 1, 9, 10, 11
end data

' the messages, 28 characters each (row 22)
const MsgBlank = 0
const MsgOccupied = 1
const MsgBad = 2
const MsgPassG = 3
const MsgPassW = 4
const MsgAsk = 5
const MsgNoMove = 6
const MsgFull = 7
const MsgShut = 8
const MsgStuck = 9
const MsgAgain = 10
data MsgTxt chars
  "                            "
  "     POSITION  OCCUPIED     "
  "      SORRY, BAD  MOVE      "
  "       GREEN   PASSES       "
  "       WHITE   PASSES       "
  " RIGHT BUTTON AGAIN TO PASS "
  "NO MOVE: RIGHT BUTTON PASSES"
  "     THE BOARD  IS FULL     "
  "        SHUT-OUT !          "
  "       NO MOVES  LEFT       "
  "     PRESS  THE  BUTTON     "
end data

record Side:
  u8 Count
  u8 Pad
  u8 Colour
  u8 PanX
end record

Side Sides[3]

u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
u16 MOff = 0
u8 Bd[100]
' the player to move: 1 white, 2 green
u8 Cp = 1
u8 Cx = 0
u8 Cy = 0
u8 Over = 0
u8 EndWhy = 0
u8 MsgId = 0
u8 MsgT = 0
u8 AskT = 0
u8 Stuck = 0
u8 Moved = 0
u8 RepT = 0
u8 Held = 0
u8 St = 0
u8 Scr = 0
u8 TitleOn = 0
bcd digits 2 MoveNo
' input
u8 J1 = 0
u8 J2 = 0
u8 Pj = 0
u8 WasPj = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' title discs
u8 TdC[8]
u8 TdW = 0
u8 TdT = 0
u8 TdH = 0
' loop counters and scratch (never kept across a sub call)
u8 Qi = 0
u8 Wk = 0
u8 B = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table RvSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  SetupSides
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Over = 0 then goto play_loop

  ' the end: the result, then back to the title on a press
  St = 0
  Scr = 3
  set sprite 0 to 192,0,0,0
  update sprites
  ShowEnd
  Rearm
  wait 60 frames
  ShowMsg(MsgAgain)
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' how many of the other player's discs the square Sq brackets in direction
' Di for player Me (0 when the line does not end on one of Me's discs)
function Scan(u8 Sq, u8 Di, u8 Me) as u8
  u8 P = 0
  u8 Cnt = 0
  u8 Res = 0
  u8 Done = 0
  u8 Op = 0
  u8 Cell = 0
  Op = 3 - Me
  P = Sq
  while Done = 0
    P = P + DirT[Di]
    Cell = Bd[P]
    if Cell = Op then
      inc Cnt
    elseif Cell = Me then
      Res = Cnt
      Done = 1
    else
      Done = 1
    end if
  end while
  return Res

' all the discs a disc of Me on Sq would turn (0: not a legal move)
function Flips(u8 Sq, u8 Me) as u8
  u8 Tot = 0
  u8 Dd = 0
  if Bd[Sq] = 0 then
    for Dd = 0 to 7
      Tot = Tot + Scan(Sq, Dd, Me)
    next
  end if
  return Tot

' 1 when Me has a legal square
function HasMove(u8 Me) as u8
  u8 Found = 0
  u8 Sq = 0
  for Sq = 11 to 88
    if Found = 0 then
      if Flips(Sq, Me) > 0 then Found = 1
    end if
  next
  return Found

sub CountDiscs:
  Sides[1].Count = 0
  Sides[2].Count = 0
  for Qi = 11 to 88
    V = Bd[Qi]
    select case V
    case 1
      inc Sides[1].Count
    case 2
      inc Sides[2].Count
    end select
  next
  return
end sub

' one pass of the play loop
sub PlayStep:
  St = 1
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowHint
  end if
  if AskT > 0 then
    dec AskT
    if AskT = 0 then ShowHint
  end if
  if Cp = 1 then
    Pj = J2
  else
    Pj = J1
  end if
  Edge = Pj ^ WasPj
  Edge = Edge & Pj
  WasPj = Pj
  StickMove
  V = Edge & 16
  if V > 0 then
    TryPlace
    return
  end if
  V = Edge & 32
  if V > 0 then TryPass
  return
end sub

' the stick: eight directions, a held stick repeats
sub StickMove:
  V = Pj & 15
  if V = 0 then
    Held = 0
    RepT = 0
    return
  end if
  if RepT > 0 then
    dec RepT
    return
  end if
  Moved = 0
  K = V & 1
  if K > 0 then
    if Cy > 0 then
      dec Cy
      Moved = 1
    end if
  end if
  K = V & 2
  if K > 0 then
    if Cy < 7 then
      inc Cy
      Moved = 1
    end if
  end if
  K = V & 4
  if K > 0 then
    if Cx > 0 then
      dec Cx
      Moved = 1
    end if
  end if
  K = V & 8
  if K > 0 then
    if Cx < 7 then
      inc Cx
      Moved = 1
    end if
  end if
  if Moved = 1 then play sound SndMove
  if Held = 0 then
    RepT = 16
  else
    RepT = 7
  end if
  Held = 1
  return
end sub

function CurSq as u8
  return Cy * 10 + Cx + 11

sub TryPlace:
  u8 Sq = 0
  u8 Got = 0
  Sq = CurSq
  if Bd[Sq] <> 0 then
    ShowMsg(MsgOccupied)
    MsgT = MsgN
    play sound SndBad
  else
    Got = Flips(Sq, Cp)
    if Got = 0 then
      ShowMsg(MsgBad)
      MsgT = MsgN
      play sound SndBad
    else
      DoMove(Sq)
    end if
  end if
  return
end sub

sub TryPass:
  if AskT = 0 then
    if Stuck = 0 then
      ShowMsg(MsgAsk)
      AskT = AskN
      MsgT = 0
      return
    end if
  end if
  AskT = 0
  if Cp = 1 then
    ShowMsg(MsgPassW)
  else
    ShowMsg(MsgPassG)
  end if
  MsgT = MsgN
  play sound SndPass
  NextTurn
  return
end sub

' place a disc of Cp on Sq and turn the bracketed discs, one after another
sub DoMove(u8 Sq):
  u8 Dm = 0
  u8 Nf = 0
  St = 0
  AskT = 0
  MsgT = 0
  ShowMsg(MsgBlank)
  Bd[Sq] = Cp
  DrawSq(Sq, Cp)
  play sound SndPlace
  Hold(6)
  for Dm = 0 to 7
    Nf = Scan(Sq, Dm, Cp)
    if Nf > 0 then FlipLine(Sq, Dm, Nf)
  next
  inc MoveNo
  NextTurn
  return
end sub

sub FlipLine(u8 Sq, u8 Di, u8 Nf):
  u8 P = 0
  u8 Fi = 0
  u8 Old = 0
  P = Sq
  Old = 3 - Cp
  for Fi = 1 to Nf
    P = P + DirT[Di]
    Bd[P] = Cp
    DrawSq(P, Old + 2)
    Hold(3)
    DrawSq(P, Cp + 2)
    Hold(3)
    DrawSq(P, Cp)
    play sound SndFlip
    Hold(2)
  next
  return
end sub

' the other player's turn; the end of the game when the board is full, a
' colour is gone, or nobody can move
sub NextTurn:
  CountDiscs
  Cp = 3 - Cp
  ShowHud
  V = Sides[1].Count + Sides[2].Count
  if V = 64 then
    Over = 1
    EndWhy = MsgFull
  elseif Sides[1].Count = 0 then
    Over = 1
    EndWhy = MsgShut
  elseif Sides[2].Count = 0 then
    Over = 1
    EndWhy = MsgShut
  else
    Stuck = 1 - HasMove(Cp)
    if Stuck = 1 then
      V = 3 - Cp
      if HasMove(V) = 0 then
        Over = 1
        EndWhy = MsgStuck
      end if
    end if
  end if
  if Over = 0 then
    if MsgT = 0 then ShowHint
  end if
  return
end sub

' the standing hint: none, or "no move" for the player to move
sub ShowHint:
  if Stuck = 1 then
    ShowMsg(MsgNoMove)
  else
    ShowMsg(MsgBlank)
  end if
  return
end sub

sub ShowEnd:
  u8 Wc = 0
  u8 Gc = 0
  Wc = Sides[1].Count
  Gc = Sides[2].Count
  ShowMsg(EndWhy)
  fill 32 count 28 at 2,1
  if Wc = Gc then
    print at 11,1, "TIE GAME"
  elseif Wc > Gc then
    print at 6,1, "WHITE PLAYER WINS!"
  else
    print at 6,1, "GREEN PLAYER WINS!"
  end if
  fill 32 count 5 at 2,17
  fill 32 count 5 at 25,17
  play sound SndWin
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' square Sq (11-88) drawn as kind K: 0 empty, 1 white, 2 green, 3 white
' edge-on, 4 green edge-on
sub DrawSq(u8 Sq, u8 Kd):
  u8 Rr = 0
  u8 Cc = 0
  u8 Tt = 0
  Rr = Sq / 10
  Cc = Sq - Rr * 10
  Rr = Rr - 1
  Cc = Cc - 1
  X = Cc * 2 + CellX
  Y = Rr * 2 + CellY
  Tt = Kd * 4 + TCempty00
  put char Tt at X,Y
  inc Tt
  inc X
  put char Tt at X,Y
  inc Tt
  dec X
  inc Y
  put char Tt at X,Y
  inc Tt
  inc X
  put char Tt at X,Y
  return
end sub

sub DrawBoard:
  put char TFtl at 7,3
  fill TFt count 16 at 8,3
  put char TFtr at 24,3
  put char TFbl at 7,20
  fill TFb count 16 at 8,20
  put char TFbr at 24,20
  for Qi = 4 to 19
    put char TFl at 7,Qi
    put char TFr at 24,Qi
  next
  for Qi = 11 to 88
    V = Bd[Qi]
    if V <> Border then DrawSq(Qi, V)
  next
  return
end sub

sub ShowMsg(u8 Id):
  MsgId = Id
  MOff = Id
  MOff = MOff * 28
  put MsgTxt + MOff count 28 at 2,22
  return
end sub

' the side panels: names, a disc, the counts, the controller, whose turn
sub DrawPanels:
  print at 2,5, "GREEN"
  print at 25,5, "WHITE"
  fill TRule count 5 at 2,6
  fill TRule count 5 at 25,6
  print at 2,11, "HAS"
  print at 25,11, "HAS"
  print at 2,15, "PAD 1"
  print at 25,15, "PAD 2"
  for Qi = 1 to 2
    X = Sides[Qi].PanX + 1
    T = Qi * 4 + TCempty00
    put char T at X,8
    inc T
    inc X
    put char T at X,8
    inc T
    dec X
    put char T at X,9
    inc T
    inc X
    put char T at X,9
  next
  return
end sub

sub ShowHud:
  for Qi = 1 to 2
    X = Sides[Qi].PanX + 1
    NumU = Sides[Qi].Count
    print at X,12, digits$(NumU, 2)
    X = Sides[Qi].PanX
    if Qi = Cp then
      print at X,17, "TURN"
    else
      print at X,17, "    "
    end if
  next
  print at 12,1, "MOVE "
  print MoveNo at 17,1
  return
end sub

' the cursor: corner brackets round the square, in the colour of the
' player to move
sub DrawCursor:
  Y = Cy * 16 + 31
  X = Cx * 16 + 64
  K = Sides[Cp].Colour
  set sprite 0 to Y,X,SCursor,K
  update sprites
  return
end sub

sub Hold(u8 Nw):
  for Wk = 1 to Nw
    Frame1
  next
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub SetupSides:
  Sides[1].Pad = 2
  Sides[1].Colour = 15
  Sides[1].PanX = 25
  Sides[2].Pad = 1
  Sides[2].Colour = 3
  Sides[2].PanX = 2
  return
end sub

sub ClearBoard:
  for Qi = 0 to 99
    Bd[Qi] = Border
  next
  for Qi = 11 to 88
    V = Qi - (Qi / 10) * 10
    if V >= 1 then
      if V <= 8 then Bd[Qi] = 0
    end if
  next
  Bd[44] = 1
  Bd[45] = 2
  Bd[54] = 2
  Bd[55] = 1
  return
end sub

sub NewGame:
  ClearBoard
  Cp = 1
  Cx = 0
  Cy = 0
  Over = 0
  MsgT = 0
  AskT = 0
  Stuck = 0
  RepT = 0
  Held = 0
  MoveNo = 0
  NewScreen
  DrawBoard
  DrawPanels
  CountDiscs
  ShowHud
  ShowMsg(MsgBlank)
  DrawCursor
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasPj = 255
  Scr = 2
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' J1, J2: bit 0 up, 1 down, 2 left, 3 right, 4 left button, 5 right button
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 48
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a big title letter (16 x 16) at column X, row 3
sub BigLetter(u8 Base, u8 Lx):
  u8 Bt = 0
  Bt = Base
  put char Bt at Lx,3
  inc Bt
  X = Lx + 1
  put char Bt at X,3
  inc Bt
  put char Bt at Lx,4
  inc Bt
  put char Bt at X,4
  return
end sub

' a title disc (0-7) in colour Kd at row 9
sub TitleDisc(u8 Ix, u8 Kd):
  u8 Tx = 0
  u8 Tt = 0
  Tx = Ix * 2 + 8
  Tt = Kd * 4 + TCempty00
  put char Tt at Tx,9
  inc Tt
  X = Tx + 1
  put char Tt at X,9
  inc Tt
  put char Tt at Tx,10
  inc Tt
  put char Tt at X,10
  return
end sub

' the title: REVERSI in big letters, a row of discs turning over one by
' one, the tune once, START GAME / HOW TO PLAY / CREDITS
sub TitlePage:
  Scr = 1
  St = 0
  NewScreen
  BigLetter(TLr00, 6)
  BigLetter(TLe00, 9)
  BigLetter(TLv00, 12)
  BigLetter(TLe00, 15)
  BigLetter(TLr00, 18)
  BigLetter(TLs00, 21)
  BigLetter(TLi00, 24)
  print at 10,6, "BY ROD CARTY"
  for Qi = 0 to 7
    V = Qi & 1
    TdC[Qi] = V + 1
    TitleDisc(Qi, TdC[Qi])
  next
  print at 11,13, "START GAME"
  print at 11,14, "HOW TO PLAY"
  print at 11,15, "CREDITS"
  print at 5,18, "GREEN: CONTROLLER 1"
  print at 5,19, "WHITE: CONTROLLER 2"
  print at 7,21, "AHOY! AUGUST 1986"
  Menu = 0
  ShowMenu
  TdW = 0
  TdT = 0
  TdH = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 504
  TzOn = 1
  TitleOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitleWave
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
      play sound SndMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  mute all
  TzOn = 0
  TitleOn = 0
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' every 24 frames the next disc turns over (edge-on for 6 frames)
sub TitleWave:
  inc TdT
  if TdH > 0 then
    dec TdH
    if TdH = 0 then
      TitleDisc(TdW, TdC[TdW])
      V = TdW + 1
      TdW = V & 7
    end if
    return
  end if
  if TdT < 24 then return
  TdT = 0
  V = 3 - TdC[TdW]
  TdC[TdW] = V
  TitleDisc(TdW, V + 2)
  TdH = 6
  return
end sub

sub ShowMenu:
  for Qi = 13 to 15
    put char 32 at 9,Qi
  next
  J = Menu + 13
  put char 62 at 9,J
  return
end sub

sub HowToPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  fill TRule count 11 at 9,2
  print at 2,4, "TWO PLAYERS, GREEN AND"
  print at 2,5, "WHITE, EACH ON HIS OWN"
  print at 2,6, "CONTROLLER. WHITE STARTS."
  print at 2,8, "PLACE A DISC SO THAT IT"
  print at 2,9, "BRACKETS ONE OR MORE OF THE"
  print at 2,10, "OTHER COLOUR IN A LINE"
  print at 2,11, "WITH ONE OF YOUR OWN: THEY"
  print at 2,12, "ALL TURN TO YOUR COLOUR."
  print at 2,14, "STICK: MOVE THE CURSOR"
  print at 2,15, "LEFT BUTTON: PLACE A DISC"
  print at 2,16, "RIGHT BUTTON TWICE: PASS"
  print at 2,18, "PASSING EARLY GIVES A NEW"
  print at 2,19, "PLAYER A START. MOST DISCS"
  print at 2,20, "AT THE END WINS."
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 12,2, "REVERSI"
  print at 2,5, "BASED ON REVERSI BY"
  print at 2,6, "ROD CARTY, AHOY! AUGUST"
  print at 2,7, "1986 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: TURNABOUT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

