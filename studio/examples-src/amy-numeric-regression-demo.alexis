u32 U32Value = 100001
i32 I32Value = -123456
u8 U8Value = 250
i8 I8Value = -5
u16 U16Value = 60000
i16 I16Value = -300
u16 U16Mix = 1000
u16 CastU16 = 0
i16 CastI16 = 0
i32 CastI32 = 0
bcd digits 6 DecScore
fixed FxBase = raw $0180
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0
u8 T5 = 0
u8 T6 = 0
u8 T7 = 0
u8 T8 = 0

' Amy Numeric Consolidation Demo
  text screen
  seed_values
  run_demo
  screen on

sub seed_values:
  clear DecScore
  DecScore += 101345
  return

sub run_demo:
  print at 4,0, "NUMERIC CONSOLIDATION"
  print at 1,2, "DISPLAY"
  print at 1,3, "U8"
  print U8Value at 6,3 digits 3
  print at 1,4, "S8"
  print I8Value at 6,4 digits 4
  print at 1,5, "U16"
  print U16Value at 6,5 digits 5
  print at 1,6, "S16"
  print I16Value at 6,6 digits 6
  print at 1,7, "U32"
  print U32Value at 6,7
  print at 1,8, "S32"
  print I32Value at 6,8 digits 11
  print at 1,9, "BCD"
  print DecScore at 6,9
  print at 1,10, "FX"
  print FxBase at 6,10

  CastI16 = I8Value
  CastU16 = U8Value
  CastI32 = I8Value
  U16Mix += I8Value
  FxBase += raw $0240

  if signed CastI16 = -5 then
    T1 = 1
  end if
  if unsigned CastU16 = 250 then
    T2 = 1
  end if
  if signed CastI32 = -5 then
    T3 = 1
  end if
  if unsigned U16Mix = 995 then
    T4 = 1
  end if
  if unsigned U16Value > I8Value then
    T5 = 1
  end if
  if signed I16Value < U8Value then
    T6 = 1
  end if
  if signed I32Value < 0 then
    T7 = 1
  end if
  if FxBase = raw $03C0 then
    T8 = 1
  end if

  print at 1,12, "CHECKS"
  print at 1,13, "i8->i16"
  print CastI16 at 8,13 digits 6
  print at 1,14, "u8->u16"
  print CastU16 at 8,14 digits 5
  print at 1,15, "i8->i32"
  print CastI32 at 8,15 digits 11
  print at 1,16, "u16+i8"
  print U16Mix at 8,16 digits 5
  print at 1,17, "u16>i8"
  print at 1,18, "i16<u8"
  print at 1,19, "s32<0"
  print at 1,20, "fx add"
  print FxBase at 8,20

  if T1 then
    print at 20,13, "PASS"
  else
    print at 20,13, "FAIL"
  end if
  if T2 then
    print at 20,14, "PASS"
  else
    print at 20,14, "FAIL"
  end if
  if T3 then
    print at 20,15, "PASS"
  else
    print at 20,15, "FAIL"
  end if
  if T4 then
    print at 20,16, "PASS"
  else
    print at 20,16, "FAIL"
  end if
  if T5 then
    print at 20,17, "PASS"
  else
    print at 20,17, "FAIL"
  end if
  if T6 then
    print at 20,18, "PASS"
  else
    print at 20,18, "FAIL"
  end if
  if T7 then
    print at 20,19, "PASS"
  else
    print at 20,19, "FAIL"
  end if
  if T8 then
    print at 20,20, "PASS"
  else
    print at 20,20, "FAIL"
  end if
  return