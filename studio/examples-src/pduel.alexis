cartridge "PLANET DUEL/C.M.BLAKEMORE/1987"

' PLANET DUEL
' A ColecoVision game based on "Planet Duel 128" by Cleveland M. Blakemore,
' Ahoy! April 1987 (Commodore 128, BASIC 7.0 with sprites).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/), the game is built for the ColecoVision: smooth 16 x 16
' sprites, a painted battlefield (starry sky, ringed planet, jagged
' mountains), sound effects and an original title tune.
'
' The game: two starpilots each have $800 to outfit a fighter. Weapons
' (laser torpedoes $100, photon charges $200, plasma tracers $300, nuclear
' missiles $400) set the speed of your shot and its blast; armor (chromium
' plating, deflector web, Kirlian field, Shrell sphere, $100-$400) is taken
' off every blast; the engine (atomics, ion propulsion, tachyon drive,
' Halcyon overthruster, $100-$400, only what you can still pay) sets the
' ship's speed; a ship with no money left for an engine drifts at speed 1.
' Every $100 left over adds 10 ergs to the 100 you start with. Then the
' duel over the planet: ships fly on in the last direction pushed, a
' button fires a shot straight ahead (left or right, the way the ship
' faces). A hit takes a random blast of 1.00 to 2 x (5 + weapon) + 1 ergs,
' less the target's armor, and the target is thrown back to its starting
' point. The first ship out of ergs explodes; the other pilot wins. Two
' ships that touch end the duel in a stalemate.
'
' From the original (orig/planet_duel_128.bas): the budget of $800 in
' $100 units, the twelve items and their costs, the engine menu limited by
' the money left, no engine = speed 1, 10 ergs per $100 left, weapon speed
' 5 + cost, engine speed 1 + cost, the blast RND * 2L + 1 less the armor
' (no damage when the blast is not above the armor), ergs shown with two
' decimals, ships that keep moving in the last direction, the shot always
' horizontal from the nose, facing left only for the three left-hand
' directions, the hit ship sent back to its start, a collision = a
' stalemate, the exploding loser, the three end messages.
'
' Liberties: one player against the computer (the listing is two players
' only); the computer reacts every 18 frames and never sees through walls.
' A shot needs a new press and only one of your shots flies at a time (on
' the C-128, holding the button relaunched the shot every pass, so it
' stayed glued to the nose); a shot ends at the screen edge or when it
' strikes a mountain (the C-128 sprites wrapped round and flew through the
' scenery); ships glide over the mountain tops instead of passing in front
' of them, and fly no lower than line 140 (in a deep valley a ship was out
' of reach of every shot, so a duel could stall for ever). A ship thrown back is safe for one second (it blinks at 3 Hz)
' so it can't be hit or rammed again at once; the listing sent back only
' ship 2 after a hit (its GOTO 380 skipped ship 1). The landscape is the
' same every game (the original drew a random one once per session). The
' stalemate's flashing background is a message and a sound. The speeds
' are scaled for 60 frames a second. The listing's check of BUMP(2) after
' a hit (it ignored hits unless both ships touched the scenery) is left
' out as a slip.
'
' Controls: player 1 on controller 1, player 2 on controller 2. Outfitting:
' up and down choose, a button buys. Duel: the stick steers (eight
' directions), either button fires. On the title, up and down choose, a
' button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes faster than 3 Hz.

const TSky = 128
const TStar0 = 129
const TStar1 = 130
const TStar2 = 131
const TBg1 = 132
const TBg2 = 133
const TBg3 = 134
const TBg4 = 135
const TBg5 = 136
const TBg6 = 137
const TBg7 = 138
const TBg8 = 139
const TBg9 = 140
const TBg10 = 141
const TBg11 = 142
const TBg12 = 143
const TBg13 = 144
const TBg14 = 145
const TBg15 = 146
const TBg16 = 147
const TBg17 = 148
const TBg18 = 149
const TBg19 = 150
const TBg20 = 151
const TBg21 = 152
const TBg22 = 153
const TBg23 = 154
const TBg24 = 155
const TBg25 = 156
const TBg26 = 157
const TBg27 = 158
const TBg28 = 159
const TBg29 = 160
const TBg30 = 161
const TBg31 = 162
const TBg32 = 163
const TBg33 = 164
const TBg34 = 165
const TBg35 = 166
const TBg36 = 167
const TBg37 = 168
const TBg38 = 169
const TBg39 = 170
const TBg40 = 171
const TBg41 = 172
const TBg42 = 173
const TBg43 = 174
const TBg44 = 175
const TBg45 = 176
const TBg46 = 177
const TBg47 = 178
const TBg48 = 179
const TBg49 = 180
const TBg50 = 181
const TBg51 = 182
const TBg52 = 183
const TBg53 = 184
const TBg54 = 185
const TBg55 = 186
const TBg56 = 187
const TBg57 = 188
const TBg58 = 189
const TBg59 = 190
const TBg60 = 191
const TBg61 = 192
const TBg62 = 193
const TBg63 = 194
const TBg64 = 195
const SShipr = 0
const SShipl = 4
const SMissr = 8
const SMissl = 12
const SBoom0 = 16
const SBoom1 = 20
const SDebris = 24
const NTiles8 = 544
const SprBytes = 224
const SndTuneA = 1
const SndTuneB = 2
const SndShot = 3
const SndHit = 4
const SndPick = 5
const SndMove = 6
const SndStart = 7
const SndBoom = 8
const SndWin = 9
const SndDraw = 10
const NSpr = 12
const BoomN = 30
const InvN = 60
const CpuN = 18
const XWrap = 3328
' the flight floor: no ship flies below line 140 (no hiding in a valley)
const FloorG = 153

' ship moves in 1/16 pixel a frame by engine speed (1-5): straight, diagonal
data SpdS bytes
  0, 6, 12, 18, 24, 30
end data
data SpdD bytes
  0, 4, 8, 13, 17, 21
end data
' stick bits (1 up, 2 down, 4 left, 8 right) -> direction 0-7 (0 up,
' clockwise), 255 = no change
data DirT bytes
  255, 0, 4, 255, 6, 7, 5, 255, 2, 1, 3, 255, 255, 255, 255, 255
end data
' direction -> x sign, y sign (0 none, 1 plus, 2 minus)
data DxT bytes
  0, 1, 1, 1, 0, 2, 2, 2
end data
data DyT bytes
  2, 2, 0, 1, 1, 1, 0, 2
end data
' starting points and directions of the two ships
data StX bytes
  40, 184
end data
data StY bytes
  48, 96
end data
data StD bytes
  2, 6
end data
data ShipCol bytes
  3, 9
end data
' the computer's outfits: weapon, armor, engine
data CpuKit bytes
  2, 2, 3,  3, 2, 2,  2, 3, 2,  1, 3, 3
end data

record Ship:
  u16 X16
  u16 Y16
  u16 Hp
  u16 MX16
  u8 Dir
  u8 Face
  u8 Boom
  u8 Inv
  u8 MOn
  u8 MY
  u8 MFace
  u8 WasF
  u8 Wpn
  u8 Arm
  u8 Eng
end record

Ship Sh[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 NumU = 0
u16 W16 = 0
bcd digits 2 Wins1 = 0
bcd digits 2 Wins2 = 0
u8 Np = 1
u8 Over = 0
u8 Stage = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 CpuT = 0
u8 AimT = 0
u8 Last = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Port = 1
' outfitting
u8 Funds = 8
u8 Cur = 0
u8 Pick = 0
u8 Cat = 0
u8 Lo = 0
u8 Hi = 0
' loop counters
u8 Pi = 0
u8 Qi = 0
u8 Ri = 0
u8 Ci = 0
u8 Fi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0

  tile screen
  set sound table PdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  Outfit(0)
  Outfit(1)
  NewDuel

play_loop:
  Frame1
  ReadPad
  if Np = 1 then CpuThink
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the loser explodes, a message, then back to the title
  Stage = 5
  EndBlast
  select case Over
  case 1
    inc Wins1
    print at 6,10, "                    "
    print at 6,11, "STARPILOT ONE WINS!!"
    print at 6,12, "                    "
    play sound SndWin
  case 2
    inc Wins2
    print at 6,10, "                    "
    if Np = 1 then
      print at 6,11, " THE COMPUTER WINS! "
    else
      print at 6,11, "STARPILOT TWO WINS!!"
    end if
    print at 6,12, "                    "
    play sound SndWin
  case else
    print at 5,10, "                      "
    print at 5,11, "  MID-AIR COLLISION   "
    print at 5,12, " ENDS IN STALEMATE!   "
    print at 5,13, "                      "
    play sound SndDraw
  end select
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of the duel: both ships, then both shots, then a collision

sub PlayStep:
  for Pi = 0 to 1
    ShipStep
  next
  for Pi = 0 to 1
    if Over = 0 then ShotStep
  next
  if Over = 0 then Collide
  return
end sub

' the ground under a ship whose sprite starts at X: the highest of three
' points of the profile under its body
function Ground(u8 Gx) as u8
  u8 G = 0
  u8 H = 0
  G = Hgt[Gx + 2]
  H = Hgt[Gx + 8]
  if H < G then G = H
  H = Hgt[Gx + 13]
  if H < G then G = H
  return G

sub ShipStep:
  u16 Px = 0
  u16 Py = 0
  u8 D = 0
  u8 S = 0
  u8 Jp = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Gr = 0
  if Sh[Pi].Boom > 0 then
    Sh[Pi].Boom = Sh[Pi].Boom - 1
    if Sh[Pi].Boom = 0 then Respawn
  else
    if Sh[Pi].Inv > 0 then Sh[Pi].Inv = Sh[Pi].Inv - 1
    Jp = J1
    if Pi = 1 then Jp = J2
    D = DirT[Jp & 15]
    if D < 8 then
      Sh[Pi].Dir = D
      Sh[Pi].Face = 0
      if D >= 5 then Sh[Pi].Face = 1
    end if
    ' a shot on a new press, when none of ours is flying
    S = Jp & 16
    if S > 0 then
      if Sh[Pi].WasF = 0 then
        if Sh[Pi].MOn = 0 then Launch
      end if
    end if
    Sh[Pi].WasF = S
    ' move: straight or diagonal speed of the engine
    D = Sh[Pi].Dir
    S = SpdS[Sh[Pi].Eng]
    if (D & 1) = 1 then S = SpdD[Sh[Pi].Eng]
    Px = Sh[Pi].X16
    Py = Sh[Pi].Y16
    select case DxT[D]
    case 1
      Px = Px + S
    case 2
      Px = Px - S
    end select
    select case DyT[D]
    case 1
      Py = Py + S
    case 2
      Py = Py - S
    end select
    ' round the sides (columns 2-29), stop at the top, glide over the land
    Sx = Px >> 4
    if Sx < 16 then Px = Px + XWrap
    if Sx >= 224 then Px = Px - XWrap
    if Py < 256 then Py = 256
    Sx = Px >> 4
    Sy = Py >> 4
    Gr = Ground(Sx)
    if Gr > FloorG then Gr = FloorG
    if Sy + 12 >= Gr then
      Sy = Gr - 13
      Py = Sy
      Py = Py << 4
    end if
    Sh[Pi].X16 = Px
    Sh[Pi].Y16 = Py
  end if
  return
end sub

sub Respawn:
  W16 = StX[Pi]
  Sh[Pi].X16 = W16 << 4
  W16 = StY[Pi]
  Sh[Pi].Y16 = W16 << 4
  Sh[Pi].Dir = StD[Pi]
  Sh[Pi].Face = Pi
  Sh[Pi].Inv = InvN
  return
end sub

sub Launch:
  W16 = Sh[Pi].X16
  if Sh[Pi].Face = 0 then
    W16 = W16 + 128
  else
    W16 = W16 - 128
  end if
  Sh[Pi].MX16 = W16
  Sh[Pi].MY = Sh[Pi].Y16 >> 4
  Sh[Pi].MFace = Sh[Pi].Face
  Sh[Pi].MOn = 1
  play sound SndShot
  return
end sub

' a shot flies at 6 x (5 + weapon) sixteenths a frame; it ends at the
' screen edge or on a mountain, or hits the other ship
sub ShotStep:
  u16 M = 0
  u8 Mx = 0
  u8 My = 0
  u8 Sp = 0
  u8 Ox = 0
  u8 Oy = 0
  if Sh[Pi].MOn = 1 then
    Qi = 1 - Pi
    Sp = Sh[Pi].Wpn + 5
    Sp = Sp * 6
    M = Sh[Pi].MX16
    if Sh[Pi].MFace = 0 then
      M = M + Sp
    else
      M = M - Sp
    end if
    Sh[Pi].MX16 = M
    Mx = M >> 4
    My = Sh[Pi].MY
    if M >= 3712 then
      Sh[Pi].MOn = 0
    elseif Mx < 8 then
      Sh[Pi].MOn = 0
    elseif My + 9 >= Hgt[Mx + 8] then
      Sh[Pi].MOn = 0
    elseif Sh[Qi].Boom = 0 then
      if Sh[Qi].Inv = 0 then
        Ox = Sh[Qi].X16 >> 4
        Oy = Sh[Qi].Y16 >> 4
        if Mx + 4 <= Ox + 14 then
          if Ox + 1 <= Mx + 11 then
            if My + 7 <= Oy + 12 then
              if Oy + 3 <= My + 9 then Hit
            end if
          end if
        end if
      end if
    end if
  end if
  return
end sub

' the blast: RND * 2L + 1 ergs (in hundredths), less the armor
sub Hit:
  u16 Blast = 0
  u16 Span = 0
  u16 Arm = 0
  u16 Hp = 0
  Sh[Pi].MOn = 0
  Rand
  Span = Sh[Pi].Wpn + 5
  Span = Span * 200
  Blast = Rs % Span
  Blast = Blast + 100
  Arm = Sh[Qi].Arm
  Arm = Arm * 100
  Hp = Sh[Qi].Hp
  if Blast > Arm then
    Blast = Blast - Arm
    if Blast >= Hp then
      Hp = 0
    else
      Hp = Hp - Blast
    end if
  end if
  Sh[Qi].Hp = Hp
  Last = Qi
  if Hp = 0 then
    Over = Pi + 1
  else
    Sh[Qi].Boom = BoomN
  end if
  ShowErgs(Qi)
  play sound SndHit
  return
end sub

' two ships in flight that touch: a stalemate
sub Collide:
  u8 Ax = 0
  u8 Ay = 0
  u8 Bx = 0
  u8 By = 0
  u8 Dx = 0
  u8 Dy = 0
  Got = 1
  if Sh[0].Boom > 0 then Got = 0
  if Sh[1].Boom > 0 then Got = 0
  if Sh[0].Inv > 0 then Got = 0
  if Sh[1].Inv > 0 then Got = 0
  if Got = 1 then
    Ax = Sh[0].X16 >> 4
    Ay = Sh[0].Y16 >> 4
    Bx = Sh[1].X16 >> 4
    By = Sh[1].Y16 >> 4
    Dx = Ax - Bx
    if Bx > Ax then Dx = Bx - Ax
    Dy = Ay - By
    if By > Ay then Dy = By - Ay
    if Dx <= 12 then
      if Dy <= 8 then Over = 3
    end if
  end if
  return
end sub

sub Rand:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  return
end sub

' is the line of a shot at sprite row Row clear of mountains from Ax to Bx?
function Clear(u8 Ax, u8 Bx, u8 Row) as u8
  u8 Lx = 0
  u8 Rx = 0
  u8 Ok = 1
  u8 Gx = 0
  Lx = Ax
  Rx = Bx
  if Bx < Ax then
    Lx = Bx
    Rx = Ax
  end if
  Row = Row + 9
  for Gx = Lx to Rx step 4
    if Hgt[Gx + 8] <= Row then Ok = 0
  next
  return Ok

function AbsDiff(u8 A, u8 B) as u8
  if A > B then return A - B
  return B - A

' ---------------------------------------------------------------------------
' the computer flies ship 2: every 18 frames it looks at the scene (what a
' player sees) and sets its stick; it keeps off the line of ship 1's nose
' and flies round to its tail, lines up from behind at a distance, backs
' off when too close, dodges a shot coming at it, fires when lined up
' for 6 frames and facing ship 1

sub CpuThink:
  u8 Hx = 0
  u8 Hy = 0
  u8 Cx = 0
  u8 Cy = 0
  u8 Ad = 0
  u8 Vd = 0
  u8 Jv = 0
  u8 Jh = 0
  u8 Mx = 0
  u8 Near = 0
  u8 Ty = 0
  J2 = J2 & 15
  if CpuT > 0 then
    dec CpuT
  else
    CpuT = CpuN
    Hx = Sh[0].X16 >> 4
    Hy = Sh[0].Y16 >> 4
    Cx = Sh[1].X16 >> 4
    Cy = Sh[1].Y16 >> 4
    Ad = AbsDiff(Hx, Cx)
    Vd = AbsDiff(Hy, Cy)
    Jv = 0
    Jh = 0
    ' in front of ship 1's nose: stay off its line and fly round to its
    ' tail; behind it: line up
    Ty = Hy
    Got = 0
    if Sh[0].Face = 0 then
      if Cx > Hx then Got = 1
    else
      if Cx < Hx then Got = 1
    end if
    ' (while ship 1's one shot is flying, its nose is harmless)
    if Sh[0].MOn = 1 then Got = 0
    if Got = 1 then
      if Cy < Hy then
        Ty = Hy - 24
        if Hy < 44 then Ty = Hy + 24
      else
        Ty = Hy + 24
        if Hy > 116 then Ty = Hy - 24
      end if
    end if
    if Ty + 4 < Cy then Jv = 1
    if Cy + 4 < Ty then Jv = 2
    ' a mountain in the way: close in
    Near = 56
    if Clear(Hx, Cx, Hy) = 0 then Near = 26
    if Got = 1 then Near = 0
    if Ad < Near then
      if Hx < Cx then
        Jh = 8
      else
        Jh = 4
      end if
    else
      if Hx < Cx then
        Jh = 4
      else
        Jh = 8
      end if
    end if
    Got = 30
    if Sh[0].Inv = 0 then Got = 64
    if Ad < Got then
      if Vd < 30 then
        Jh = 0
        Jv = 2
        if Cy < Hy then Jv = 1
        if Cy < 40 then Jv = 2
        if Cy > 130 then Jv = 1
      end if
    end if
    ' a shot of ship 1 coming along our line
    if Sh[0].MOn = 1 then
      Mx = Sh[0].MX16 >> 4
      if AbsDiff(Sh[0].MY, Cy) < 14 then
        Got = 0
        if Sh[0].MFace = 0 then
          if Mx < Cx then Got = 1
        else
          if Mx > Cx then Got = 1
        end if
        if Got = 1 then
          if AbsDiff(Mx, Cx) < 100 then
            Jh = 0
            if Cy > 70 then
              Jv = 1
            else
              Jv = 2
            end if
          end if
        end if
      end if
    end if
    if Sh[1].Boom > 0 then
      Jv = 0
      Jh = 0
    end if
    J2 = Jv | Jh
  end if
  ' fire (looked at every frame): lined up for 10 frames, facing ship 1, no
  ' shot of ours in flight
  Hx = Sh[0].X16 >> 4
  Hy = Sh[0].Y16 >> 4
  Cx = Sh[1].X16 >> 4
  Cy = Sh[1].Y16 >> 4
  ' too close to ship 1 (it can't be rammed while it blinks): climb or dive
  ' away and turn away at once
  if Sh[0].Inv = 0 then
    if Sh[1].Boom = 0 then
      if AbsDiff(Hx, Cx) < 40 then
        if AbsDiff(Hy, Cy) < 22 then
          J2 = 2
          if Cy < Hy then J2 = 1
          if Cy < 30 then J2 = 2
          if Cy > 132 then J2 = 1
          if Hx < Cx then
            J2 = J2 | 8
          else
            J2 = J2 | 4
          end if
          CpuT = 6
        end if
      end if
    end if
  end if
  Got = 0
  if AbsDiff(Hy, Cy) < 5 then
    if Sh[1].MOn = 0 then
      if Sh[0].Boom = 0 then
        if Sh[1].Face = 0 then
          if Hx > Cx then Got = 1
        else
          if Hx < Cx then Got = 1
        end if
      end if
    end if
  end if
  if Got = 1 then
    inc AimT
    if AimT >= 10 then
      J2 = J2 | 16
      AimT = 0
    end if
  else
    AimT = 0
  end if
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0-1 the ships, 2-3 the shots, 4-11 the debris of the end

sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Pt = 0
  u8 Cl = 0
  for Ci = 0 to 1
    Sx = Sh[Ci].X16 >> 4
    Sy = Sh[Ci].Y16 >> 4
    Sy = Sy - 1
    Cl = ShipCol[Ci]
    if Sh[Ci].Boom > 0 then
      Pt = SBoom0
      if Sh[Ci].Boom < 16 then Pt = SBoom1
      Cl = 11
    elseif Sh[Ci].Face = 0 then
      Pt = SShipr
    else
      Pt = SShipl
    end if
    ' safe after a hit: blink, 10 frames on and 10 off (3 Hz)
    V = Sh[Ci].Inv / 10
    if (V & 1) = 1 then Sy = 192
    set sprite Ci to Sy,Sx,Pt,Cl
    K = Ci + 2
    if Sh[Ci].MOn = 1 then
      Sx = Sh[Ci].MX16 >> 4
      Sy = Sh[Ci].MY - 1
      set sprite K to Sy,Sx,SMissr,15
    else
      set sprite K to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' the loser (both ships after a collision) bursts into eight pieces that
' fly out for a second
sub EndBlast:
  u8 Bx = 0
  u8 By = 0
  u8 Cx = 0
  u8 Cy = 0
  Bx = Sh[Last].X16 >> 4
  By = Sh[Last].Y16 >> 4
  if Over = 3 then
    Cx = Sh[0].X16 >> 4
    Cy = Sh[0].Y16 >> 4
    Bx = Sh[1].X16 >> 4
    By = Sh[1].Y16 >> 4
    Bx = Bx + Cx
    Bx = Bx >> 1
    By = By + Cy
    By = By >> 1
  end if
  play sound SndBoom
  for Fi = 0 to 59
    Frame1
    for Ci = 0 to 7
      K = Ci + 4
      Cx = Bx
      Cy = By
      select case DxT[Ci]
      case 1
        Cx = Bx + Fi
      case 2
        Cx = Bx - Fi
      end select
      select case DyT[Ci]
      case 1
        Cy = By + Fi
      case 2
        Cy = By - Fi
      end select
      if Cx < 12 then Cy = 192
      if Cx > 228 then Cy = 192
      if Cy > 180 then Cy = 192
      if Cy < 8 then Cy = 192
      set sprite K to Cy,Cx,SDebris,11
    next
    Got = 0
    if Over = 3 then Got = 1
    for Ci = 0 to 1
      K = Ci + 2
      set sprite K to 192,0,0,0
      if Ci = Last then
        set sprite Ci to 192,0,0,0
      elseif Got = 1 then
        set sprite Ci to 192,0,0,0
      end if
    next
    update sprites
  next
  return
end sub

' ---------------------------------------------------------------------------
' the duel screen

sub NewDuel:
  NewScreen
  DrawField
  for Pi = 0 to 1
    Respawn
    Sh[Pi].Inv = 0
    Sh[Pi].Boom = 0
    Sh[Pi].MOn = 0
    Sh[Pi].WasF = 16
    ShowErgs(Pi)
  next
  if Np = 1 then
    print at 20,1, "CPU"
  else
    print at 20,1, "TWO"
  end if
  print at 2,1, "ONE"
  Over = 0
  CpuT = 30
  J2 = 0
  Stage = 4
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ergs as ###.## (the listing's PRINT USING), ship 1 at the left
sub ShowErgs(u8 Ws):
  u16 E = 0
  u16 Ip = 0
  u16 Fr = 0
  u8 Col = 6
  E = Sh[Ws].Hp
  Ip = E / 100
  Fr = E % 100
  if Ws = 1 then Col = 24
  print at Col,1, digits$(Ip, 3)
  K = Col + 3
  print at K,1, "."
  K = K + 1
  print at K,1, digits$(Fr, 2)
  return
end sub

sub DrawField:
  u16 Ofs = 0
  for Ri = 0 to 21
    Ofs = Ri
    Ofs = Ofs * 32
    copy BgMap + Ofs count 32 to vram.name + Ofs + 64
  next
  return
end sub

' ---------------------------------------------------------------------------
' outfitting: weapons, armor, engine with $800

sub Outfit(u8 Who):
  u8 Left8 = 0
  Pi = Who
  Port = Who + 1
  NewScreen
  backdrop dark blue
  if Who = 0 then
    print at 9,2, "STARPILOT ONE"
  elseif Np = 1 then
    print at 9,2, "THE COMPUTER"
  else
    print at 9,2, "STARPILOT TWO"
  end if
  print at 2,5, "CHOOSE WEAPONS"
  print at 2,11, "PICK DEFENSIVE ARMOR"
  print at 2,17, "DECIDE ON SPACECRAFT ENGINE"
  Funds = 8
  for Cat = 0 to 2
    for Ci = 0 to 3
      PrintItem
    next
  next
  ShowFunds
  ShowScreen
  Rearm
  wait no fire
  nmi off
  ' weapons: any of the four
  Cat = 0
  Choose4
  Sh[Who].Wpn = Pick + 1
  Funds = Funds - Pick - 1
  ShowFunds
  Cat = 1
  Choose4
  Sh[Who].Arm = Pick + 1
  Funds = Funds - Pick - 1
  ShowFunds
  Cat = 2
  for Ci = 0 to 3
    PrintItem
  next
  if Funds = 0 then
    Sh[Who].Eng = 1
    print at 2,22, "NO MONEY LEFT: DRIFT SPEED 1"
  else
    Choose4
    Sh[Who].Eng = Pick + 2
    Funds = Funds - Pick - 1
    ShowFunds
  end if
  W16 = Funds
  W16 = W16 * 1000
  Sh[Who].Hp = W16 + 10000
  Left8 = Funds
  if Left8 > 0 then
    fill 32 count 28 at 2,22
    print at 2,22, "LEFT OVER: +"
    NumU = Left8 * 10
    print at 14,22, digits$(NumU, 2)
    print at 17,22, "ERGS"
  end if
  for Fi = 0 to 89
    Frame1
  next
  return
end sub

' the money left and the ergs it is worth
sub ShowFunds:
  print at 2,3, "FUNDS $"
  NumU = Funds * 100
  print at 9,3, digits$(NumU, 3)
  print at 16,3, "ERGS"
  NumU = Funds * 10
  NumU = NumU + 100
  print at 21,3, digits$(NumU, 3)
  return
end sub

' item Ci of category Cat, its price (or -- when it costs too much)
sub PrintItem:
  u8 Row = 0
  Row = Cat * 6
  Row = Row + 6 + Ci
  select case (Cat, Ci)
  case (0, 0)
    print at 4,Row, "LASER TORPEDOES "
  case (0, 1)
    print at 4,Row, "PHOTON CHARGES  "
  case (0, 2)
    print at 4,Row, "PLASMA TRACERS  "
  case (0, 3)
    print at 4,Row, "NUCLEAR MISSILES"
  case (1, 0)
    print at 4,Row, "CHROMIUM PLATING"
  case (1, 1)
    print at 4,Row, "DEFLECTOR WEB   "
  case (1, 2)
    print at 4,Row, "KIRLIAN FIELD   "
  case (1, 3)
    print at 4,Row, "SHRELL SPHERE   "
  case (2, 0)
    print at 4,Row, "ATOMICS         "
  case (2, 1)
    print at 4,Row, "ION PROPULSION  "
  case (2, 2)
    print at 4,Row, "TACHYON DRIVE   "
  case else
    print at 4,Row, "HALCYON THRUSTER"
  end select
  if Ci < Funds then
    print at 23,Row, "$"
    NumU = Ci + 1
    NumU = NumU * 100
    print at 24,Row, digits$(NumU, 3)
  else
    print at 23,Row, "  --"
  end if
  return
end sub

' a choice among the affordable items of Cat (the computer picks its kit)
sub Choose4:
  Hi = 3
  if Funds < 4 then Hi = Funds - 1
  Cur = 0
  Got = 0
  if Port = 2 then
    if Np = 1 then
      CpuPick
      Got = 2
    end if
  end if
  if Got = 0 then ChooseStick
  return
end sub

sub ChooseStick:
  u8 Row0 = 0
  Row0 = Cat * 6
  Row0 = Row0 + 6
  ShowCursor
  Rearm
  wait no fire
  nmi off
  Got = 0
  while Got = 0
    Frame1
    inc Rs
    ReadPad
    V = J1
    if Port = 2 then V = J2
    Btn = V & 16
    K = V & 3
    if K > 0 then
      if WasStick = 0 then
        if K = 1 then
          if Cur > 0 then dec Cur
        else
          if Cur < Hi then inc Cur
        end if
        ShowCursor
        play sound SndMove
      end if
    end if
    WasStick = K
    if Btn > 0 then
      if WasBtn = 0 then Got = 1
    end if
    WasBtn = Btn
  end while
  Pick = Cur
  put char 42 at 2,Row0 + Cur
  play sound SndPick
  return
end sub

sub CpuPick:
  u8 Kit = 0
  u8 Row0 = 0
  Kit = Rs & 3
  Kit = Kit * 3
  Kit = Kit + Cat
  Pick = CpuKit[Kit] - 1
  if Pick > Hi then Pick = Hi
  Cur = Pick
  ShowCursor
  for Fi = 0 to 39
    Frame1
  next
  Row0 = Cat * 6
  put char 42 at 2,Row0 + 6 + Pick
  play sound SndPick
  return
end sub

sub ShowCursor:
  u8 R0 = 0
  R0 = Cat * 6
  R0 = R0 + 6
  for Ri = 0 to 3
    put char 32 at 2,R0 + Ri
  next
  put char 62 at 2,R0 + Cur
  fill 32 count 28 at 2,22
  N = Cur + 1
  select case Cat
  case 0
    print at 2,22, "SHOT SPEED   BLAST UP TO"
    NumU = N + 5
    print at 13,22, digits$(NumU, 1)
    NumU = NumU * 2 + 1
    print at 27,22, digits$(NumU, 2)
  case 1
    print at 2,22, "TAKES   ERGS OFF EVERY HIT"
    NumU = N
    print at 8,22, digits$(NumU, 1)
  case else
    print at 2,22, "SHIP SPEED"
    NumU = N + 1
    print at 13,22, digits$(NumU, 1)
  end select
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if Np = 2 then
    J2 = 0
    if joypad(2).up then J2 = J2 | 1
    if joypad(2).down then J2 = J2 | 2
    if joypad(2).left then J2 = J2 | 4
    if joypad(2).right then J2 = J2 | 8
    if joypad(2).fire then J2 = J2 | 16
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the battlefield, the tune once, 1 PLAYER / 2 PLAYERS / CREDITS
sub TitlePage:
  Stage = 2
  NewScreen
  DrawField
  print at 12,3, "PLANET DUEL"
  print at 12,5, "A CONFLICT IN"
  print at 12,6, "SPACE"
  print at 3,9, "BY CLEVELAND M. BLAKEMORE"
  print at 11,11, "1 PLAYER"
  print at 11,12, "2 PLAYERS"
  print at 11,13, "CREDITS"
  print at 7,15, "AHOY! APRIL 1987"
  print at 2,1, "WINS ONE"
  print at 11,1, Wins1
  print at 19,1, "TWO"
  print at 23,1, Wins2
  ShowMenu
  ' two ships cross the sky
  for Pi = 0 to 1
    Respawn
    Sh[Pi].Inv = 0
    Sh[Pi].Boom = 0
    Sh[Pi].MOn = 0
    Sh[Pi].Eng = 2
  next
  Sh[0].Y16 = 1920
  Sh[1].Y16 = 2240
  J1 = 0
  J2 = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  Pi = 0
  ShipStep
  Pi = 1
  ShipStep
  DrawSprites
  ReadPad
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  K = V & 3
  if K > 0 then
    if WasStick = 0 then
      if K = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = K
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  Np = Menu + 1
  if Menu = 2 then CreditsPage
  Stage = 3
  return
end sub

sub ShowMenu:
  for Ri = 11 to 13
    put char 32 at 9,Ri
  next
  J = Menu + 11
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  Stage = 1
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "PLANET DUEL"
  print at 2,5, "BASED ON PLANET DUEL 128 BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! APRIL 1987"
  print at 2,8, "(COMMODORE 128)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: PLANETFALL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

