cartridge "CHICKEN CATCHER/COMPUTE!S GAZETTE/1985"

' CHICKEN CATCHER
' A ColecoVision game based on "Chicken Catcher", COMPUTE!'s Gazette disk
' of November 1985 (Commodore 64 and VIC-20 versions, BASIC; no author
' named in the listings, orig/). Made for Amy Studio by Claude (an AI made
' by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the listing's, the game is built
' for the ColecoVision: smooth 16 x 16 sprites (a farmer and a hen, two
' colours each), a tiled barn, sound effects and an original title tune.
'
' The game: four wooden lofts, each split by an open shaft in the middle
' of the barn. A hen drops from the roost down the shaft, over and over.
' Run at least five steps, then hold the button to leap into the shaft and
' grab her: she must meet your arms (above your middle). Bump her with
' your feet and she squawks: game over. Miss her and you fall down the
' shaft into the pit: game over. Trapdoors in the lofts drop you to the
' loft below (you can't climb back). Each hen caught scores ten points for
' every second left on the 60-second clock; the clock starts again and
' the next hen is faster. When the clock runs out the game is over. The
' best score is kept with three initials.
'
' From the original (orig/chicken catcher.bas, chicken_vic.bas): four
' floors with a gap in the middle, trapdoor holes that drop you a floor,
' the hen falling down the gap and starting again at the top, a 5-step
' run-up before a jump (L>4 / K>4), the jump held with the button (let go
' and you drop), the catch when the hen is at your head (PEEK(A-39)), the
' death when she is at your feet (PEEK(A+1)), the fall to the bottom, the
' score of 10 x the seconds left, the 60-second clock per hen, the hen a
' step faster after each catch (D = D - 1, down to 1), the high score
' with initials.
'
' Liberties: the listing's speeds were measured in BASIC loop passes; here
' the farmer runs 1 pixel a frame and the jump is 40 pixels long (5 cells,
' as in the listing), and the hen's speed follows the listing's 1/D curve
' (D from 19 down to 1), from 2/16 to 41/16 of a pixel a frame. The jump
' is an arc (8 pixels up, level, 8 down) instead of three cell moves. The
' hen waits a second on the roost before each drop. The listing's
' trapdoors were at places the player can never reach; here each loft has
' one on each side, staggered, so the lower lofts can be used, and each
' new hen starts the farmer on the other side of the barn. The listing's
' "P/R" flags (no second jump without stepping back) become: a jump needs
' a fresh run-up. The listing's hen never got back to the top on the C64
' (its reset address can't be reached); here she does. Initials are
' chosen with the stick (up/down, button), not typed.
'
' Controls: either controller; the stick runs left and right, a side
' button (held) jumps after a run-up of five steps. On the title, up and
' down choose (START GAME, HOW TO PLAY, CREDITS), a button picks; HOW TO
' PLAY has two pages (a button turns the page, 30 s idle goes back).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects
' after; the title tune is played once. `set sprite count` is always given.
' Nothing flashes.

const TBack = 128
const TBack2 = 129
const TWall = 130
const TBeam = 131
const TBeaml = 132
const TBeamr = 133
const THole = 134
const TShaft = 135
const THay = 136
const TRoost = 137
const TRafter = 138
const TPit = 139
const TStone = 140
const TEgg = 141
const SFstandr_h = 0
const SFstandr_o = 4
const SFstandl_h = 8
const SFstandl_o = 12
const SFwalkr_h = 16
const SFwalkr_o = 20
const SFwalkl_h = 24
const SFwalkl_o = 28
const SFjumpr_h = 32
const SFjumpr_o = 36
const SFjumpl_h = 40
const SFjumpl_o = 44
const SHenup_w = 48
const SHenup_r = 52
const SHendown_w = 56
const SHendown_r = 60
const SHenheld_w = 64
const SHenheld_r = 68
const SPuff = 72
const NTiles8 = 112
const SprBytes = 608
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndJump = 4
const SndDrop = 5
const SndCluck = 6
const SndCatch = 7
const SndSquawk = 8
const SndFall = 9
const SndOver = 10
const SndTick = 11
const SndLetter = 12
const NSpr = 4
const RunN = 40
const JumpN = 40
const HenX = 120
const HenTop = 16
const HenBottom = 176
const PitY = 176
const CatchN = 90
const DeadN = 90
const RoostN = 60

' the lofts: feet line of each floor, its tile row
data FloorY bytes
  56, 96, 136, 176
end data
data FloorRow bytes
  7, 12, 17, 22
end data
' the hen's speed (1/16 pixel a frame) after K hens: 40.5 / (19 - K)
data HenSpd bytes
  2, 2, 2, 3, 3, 3, 3, 3, 4, 4, 5, 5, 6, 7, 8, 10, 14, 20, 41
end data
' where each new hen starts the farmer: X by side
data StartX bytes
  48, 192
end data

record Body:
  u8 X
  u8 Y
  u8 Dir
  u8 Mode
end record
' Mode: 0 on a loft, 1 jumping, 2 falling, 3 holding a hen, 4 hit, 5 in
' the pit

Body Hero
u8 Fl = 0
u8 Run = 0
u8 Jx = 0
u8 LastDir = 0
u8 Moving = 0
' the hen
u8 Hy = 16
u8 Hf = 0
u8 Hs = 2
u8 HenWait = 0
u8 Caught = 0
u8 Side = 0
' clock and score
u8 Secs = 60
u8 SecF = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
bcd digits 6 Bonus = 0
u8 Ini[3]
u8 EndT = 0
u8 Over = 0
u8 Why = 0
' title tune
u16 TzLeft = 0
u8 TzOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jy = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Ri = 0
u8 Ci = 0
u8 Li = 0
u8 Bi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cell = 0
u8 OldFeet = 0
u8 NewFeet = 0
u8 Pat = 0
u8 Col = 0
u16 NumU = 0

  tile screen
  set sound table CcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  Ini[0] = 67
  Ini[1] = 76
  Ini[2] = 65
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, the initials for a new best, then the title
  mute all
  Rearm
  wait 30 frames
  nmi off
  HideSprites
  print at 9,9, "             "
  print at 9,10, "  GAME OVER  "
  print at 9,11, "             "
  if Why = 1 then print at 9,12, "  TIME'S UP  "
  if Why = 2 then print at 9,12, "  SHE PECKED "
  if Why = 3 then print at 9,12, " INTO THE PIT"
  print at 9,13, "             "
  play sound SndOver
  Rearm
  wait 120 frames
  nmi off
  if Score > Hi then
    Hi = Score
    EnterInitials
  end if
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 1 when the loft floor Fn is solid under cell Cn
function Solid(u8 Fn, u8 Cn) as u8
  if Cn < 3 then return 0
  if Cn > 28 then return 0
  select case (Fn, Cn)
  case (0 to 3, 13 to 18)
    return 0
  case (0, 5), (0, 26), (1, 4), (1, 27), (2, 3), (2, 28)
    return 0
  case else
    return 1
  end select
  return 1

' the cell under the farmer's feet (middle of the sprite)
function FeetCell as u8
  return (Hero.X + 8) >> 3

sub PlayStep:
  if EndT > 0 then
    dec EndT
    if EndT = 0 then
      if Hero.Mode = 3 then
        NextHen
      else
        Over = 1
      end if
    end if
    return
  end if
  Clock
  MoveHen
  select case Hero.Mode
  case 0
    WalkStep
  case 1
    JumpStep
  case 2
    FallStep
  end select
  if Hero.Mode = 1 or Hero.Mode = 2 then Collide
  return
end sub

sub Clock:
  inc SecF
  if SecF < 60 then return
  SecF = 0
  dec Secs
  ShowTime
  if Secs < 6 then play sound SndTick
  if Secs = 0 then
    Why = 1
    EndT = 1
    Hero.Mode = 4
  end if
  return
end sub

sub MoveHen:
  if HenWait > 0 then
    dec HenWait
    if HenWait = 0 then play sound SndCluck
    return
  end if
  V = Hf + Hs
  Hy = Hy + (V >> 4)
  Hf = V & 15
  if Hy > HenBottom then
    Hy = HenTop
    Hf = 0
    HenWait = RoostN
  end if
  return
end sub

' on a loft: run, count the run-up, jump, or drop through a trapdoor
sub WalkStep:
  Moving = 0
  if Jy & 4 then
    Hero.Dir = 1
    if Hero.X > 22 then
      dec Hero.X
      Moving = 1
    end if
  elseif Jy & 8 then
    Hero.Dir = 0
    if Hero.X < 218 then
      inc Hero.X
      Moving = 1
    end if
  end if
  if Moving = 1 then
    if Hero.Dir = LastDir then
      if Run < 200 then inc Run
    else
      Run = 1
    end if
    LastDir = Hero.Dir
    V = Hero.X & 7
    if V = 0 then play sound SndStep
  else
    Run = 0
  end if
  Cell = FeetCell
  if Solid(Fl, Cell) = 0 then
    Hero.Mode = 2
    Run = 0
    play sound SndDrop
    return
  end if
  if Btn > 0 then
    if Moving = 1 then
      if Run >= RunN then
        Hero.Mode = 1
        Jx = 0
        Run = 0
        play sound SndJump
      end if
    end if
  end if
  return
end sub

' in the air: 8 pixels up, level, 8 down over 40 pixels while the button
' is held; let go and the farmer drops
sub JumpStep:
  if Btn = 0 then
    Hero.Mode = 2
    return
  end if
  if Hero.Dir = 0 then
    if Hero.X < 218 then inc Hero.X
  else
    if Hero.X > 22 then dec Hero.X
  end if
  inc Jx
  if Jx <= 8 then
    dec Hero.Y
  elseif Jx > 32 then
    inc Hero.Y
  end if
  if Jx >= JumpN then
    Hero.Mode = 0
    Cell = FeetCell
    if Solid(Fl, Cell) = 0 then Hero.Mode = 2
  end if
  return
end sub

sub FallStep:
  OldFeet = Hero.Y + 16
  Hero.Y += 2
  NewFeet = Hero.Y + 16
  Cell = FeetCell
  for Fi = 0 to 3
    V = FloorY[Fi]
    if OldFeet < V and NewFeet >= V then
      if Solid(Fi, Cell) = 1 then
        Hero.Y = V - 16
        Hero.Mode = 0
        Fl = Fi
        Run = 0
      end if
    end if
  next
  if Hero.Mode = 2 then
    if Hero.Y >= PitY then
      Hero.Mode = 5
      Why = 3
      EndT = DeadN
      play sound SndFall
    end if
  end if
  return
end sub

' the hen against the farmer: above his middle she is caught, else she
' pecks
sub Collide:
  if HenWait > 0 then return
  X = Hero.X
  Y = Hero.Y
  if X + 11 < HenX + 3 then return
  if X + 4 > HenX + 12 then return
  if Y + 15 < Hy + 3 then return
  if Y + 1 > Hy + 14 then return
  if Hy + 8 < Y + 10 then
    Hero.Mode = 3
    EndT = CatchN
    AddBonus
    ShowScore
    print at 10,4, " CAUGHT! "
    play sound SndCatch
  else
    Hero.Mode = 4
    Why = 2
    EndT = DeadN
    play sound SndSquawk
  end if
  return
end sub

' ten points for every second left
sub AddBonus:
  Bonus = 0
  for Bi = 1 to Secs
    Bonus += 10
  next
  Score += Bonus
  return
end sub

sub NextHen:
  if Caught < 250 then inc Caught
  V = Side + 1
  Side = V & 1
  PlaceHen
  print at 10,4, "         "
  ShowTime
  return
end sub

sub PlaceHen:
  Hero.X = StartX[Side]
  Hero.Y = FloorY[0] - 16
  Hero.Dir = Side
  Hero.Mode = 0
  LastDir = Side
  Fl = 0
  Run = 0
  Jx = 0
  Hy = HenTop
  Hf = 0
  HenWait = RoostN
  K = Caught
  if K > 18 then K = 18
  Hs = HenSpd[K]
  Secs = 60
  SecF = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 hat and hands, 1 overalls, 2 hen white, 3 comb and feet
sub DrawSprites:
  Y = Hero.Y - 1
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  elseif Hero.Mode = 5 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  else
    Pat = 0
    if Hero.Mode = 1 then Pat = 32
    if Hero.Mode = 2 then Pat = 32
    if Hero.Mode = 3 then Pat = 32
    if Hero.Mode = 0 then
      V = Hero.X >> 3
      V = V & 1
      if Moving = 1 then Pat = V << 4
    end if
    Pat = Pat + (Hero.Dir << 3)
    set sprite 0 to Y,Hero.X,Pat,11
    Pat = Pat + 4
    set sprite 1 to Y,Hero.X,Pat,5
  end if
  ' the hen (on the title she passes behind the menu box)
  X = HenX
  Y = Hy - 1
  V = 0
  if TitleOn = 1 then
    if Hy > 48 and Hy < 128 then V = 1
  end if
  if V = 1 then
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  elseif Hero.Mode = 4 then
    set sprite 2 to Y,X,SPuff,15
    set sprite 3 to 192,0,0,0
  else
    if Hero.Mode = 3 then
      X = Hero.X
      Y = Hero.Y - 11
      Pat = SHenheld_w
    elseif HenWait > 0 then
      Pat = SHenheld_w
    else
      V = Tick >> 2
      V = V & 1
      Pat = SHenup_w + (V << 3)
    end if
    set sprite 2 to Y,X,Pat,15
    Pat = Pat + 4
    set sprite 3 to Y,X,Pat,8
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SC"
  print Score at 5,1
  print at 12,1, "TIME"
  ShowTime
  print at 21,1, "HI"
  print Hi at 24,1
  return
end sub

sub ShowScore:
  print Score at 5,1
  return
end sub

sub ShowTime:
  NumU = Secs
  print at 17,1, digits$(NumU, 2)
  return
end sub

' the barn: walls, back boards, rafters, the roost, lofts, shaft and pit
sub DrawBarn:
  fill TRafter count 32 at 0,2
  for Ri = 3 to 23
    fill TWall count 3 at 0,Ri
    fill TWall count 3 at 29,Ri
    DrawBack
  next
  put char TRoost at 15,3
  put char TRoost at 16,3
  for Fi = 0 to 3
    DrawLoft
  next
  fill TStone count 10 at 3,23
  fill TStone count 10 at 19,23
  fill TPit count 6 at 13,23
  put char THay at 4,21
  put char THay at 5,21
  put char THay at 27,21
  put char TEgg at 9,6
  put char TEgg at 22,11
  return
end sub

sub DrawBack:
  for Ci = 3 to 28
    if Ci >= 13 and Ci <= 18 then
      C = TShaft
    else
      V = Ci + Ri
      C = TBack + (V & 1)
    end if
    put char C at Ci,Ri
  next
  return
end sub

sub DrawLoft:
  Y = FloorRow[Fi]
  for Ci = 3 to 28
    if Solid(Fi, Ci) = 1 then
      C = TBeam
      if Ci = 12 then C = TBeamr
      if Ci = 19 then C = TBeaml
      put char C at Ci,Y
    elseif Ci < 13 or Ci > 18 then
      put char THole at Ci,Y
    end if
  next
  return
end sub

sub NewGame:
  Score = 0
  Caught = 0
  Side = 0
  Over = 0
  Why = 0
  EndT = 0
  TitleOn = 0
  NewScreen
  DrawBarn
  PlaceHen
  ShowHud
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  return
end sub

' the best score's initials, chosen with the stick
sub EnterInitials:
  print at 6,15, "                  "
  print at 6,16, "  NEW BEST SCORE  "
  print at 6,17, "                  "
  print at 6,18, "  YOUR INITIALS:  "
  print at 6,19, "                  "
  print at 6,20, "                  "
  print at 6,21, "                  "
  for Li = 0 to 2
    Ini[Li] = 65
  next
  Li = 0
  WasStick = 3
  WasBtn = 16
ei_loop:
  Frame1
  ReadPad
  V = Jy & 3
  if V > 0 and WasStick = 0 then
    if V = 1 then
      if Ini[Li] = 90 then
        Ini[Li] = 65
      else
        Ini[Li] = Ini[Li] + 1
      end if
    else
      if Ini[Li] = 65 then
        Ini[Li] = 90
      else
        Ini[Li] = Ini[Li] - 1
      end if
    end if
    play sound SndLetter
  end if
  WasStick = V
  ShowInitials
  if Press = 1 then
    play sound SndStep
    inc Li
    if Li >= 3 then
      ShowInitials
      return
    end if
  end if
  goto ei_loop
end sub

sub ShowInitials:
  for Ci = 0 to 2
    X = 14 + Ci
    put char Ini[Ci] at X,20
    C = 32
    if Ci = Li then C = 94
    put char C at X,21
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Jy = J1 | J2
  Btn = Jy & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the barn, the hen dropping down the shaft, the tune once,
' START GAME / CREDITS
sub TitlePage:
  Menu = 0
  TitleOn = 1
  NewScreen
  DrawBarn
  for Ri = 8 to 16
    fill 32 count 22 at 5,Ri
  next
  print at 8,9, "CHICKEN CATCHER"
  print at 6,11, "COMPUTE!S GAZETTE"
  print at 11,12, "NOV 1985"
  print at 11,14, "START GAME"
  print at 11,15, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 2,1, "HI"
  print Hi at 5,1
  for Ci = 0 to 2
    X = 12 + Ci
    put char Ini[Ci] at X,1
  next
  ShowMenu
  Hy = HenTop
  Hf = 0
  Hs = 6
  HenWait = 0
  Hero.Mode = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  MoveHen
  DrawSprites
  V = Jy & 3
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,14
  put char 32 at 9,15
  put char 32 at 9,16
  J = Menu + 14
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
u8 HPg = 0
u16 HWt = 0
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "A HEN DROPS DOWN THE OPEN"
    print at 2,4, "SHAFT IN THE MIDDLE OF THE"
    print at 2,5, "BARN. LEAP AND CATCH HER!"
    print at 2,7, "STICK: RUN LEFT OR RIGHT."
    print at 2,8, "RUN AT LEAST 5 STEPS, THEN"
    print at 2,9, "HOLD THE BUTTON TO LEAP"
    print at 2,10, "INTO THE SHAFT."
    print at 2,12, "CATCH HER WITH YOUR ARMS."
    print at 2,13, "IF SHE HITS YOUR FEET, OR"
    print at 2,14, "YOU MISS AND FALL, THE GAME"
    print at 2,15, "IS OVER."
    for Ri = 17 to 19
      fill TShaft count 6 at 13,Ri
    next
    fill TBeam count 6 at 7,20
    put char TBeamr at 12,20
    put char TBeaml at 19,20
    fill TBeam count 6 at 20,20
    set sprite 0 to 143,64,SFwalkr_h,11
    set sprite 1 to 143,64,SFwalkr_o,5
    set sprite 2 to 135,120,SHendown_w,15
    set sprite 3 to 135,120,SHendown_r,8
  else
    print at 2,3, "EACH HEN YOU CATCH SCORES"
    print at 2,4, "10 POINTS FOR EVERY SECOND"
    print at 2,5, "LEFT ON THE 60 SECOND CLOCK."
    print at 2,6, "THEN THE CLOCK STARTS AGAIN"
    print at 2,7, "AND THE NEXT HEN IS FASTER."
    print at 2,8, "TIME RUNS OUT: GAME OVER."
    print at 2,10, "A TRAPDOOR (A GAP IN THE"
    print at 2,11, "FLOOR) DROPS YOU A LOFT."
    put char TPit at 2,13
    print at 4,13, "THE PIT: DON'T FALL IN!"
    print at 2,15, "TIP: LEAP WHEN THE HEN IS A"
    print at 2,16, "LITTLE ABOVE YOUR HEAD."
    fill TBeam count 5 at 8,19
    put char THole at 13,19
    put char THole at 14,19
    fill TBeam count 5 at 15,19
    set sprite 0 to 135,80,SFstandr_h,11
    set sprite 1 to 135,80,SFstandr_o,5
    set sprite 2 to 135,152,SHenheld_w,15
    set sprite 3 to 135,152,SHenheld_r,8
  end if
  print at 8,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B6
  backdrop dark red
  print at 8,2, "CHICKEN CATCHER"
  print at 2,5, "BASED ON CHICKEN CATCHER,"
  print at 2,6, "COMPUTE!S GAZETTE DISK,"
  print at 2,7, "NOVEMBER 1985 (COMMODORE"
  print at 2,8, "64 AND VIC-20, BASIC)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: HENHOUSE HOP"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

