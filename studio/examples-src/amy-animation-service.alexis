u8 ActorX = 120
u8 ActorY = 88

data ActorMeta metasprite layers 2
  frame 1,1, 0,11
  frame 3,1, 2,11
end data

animation ActorIdle using ActorMeta every 8 updates

data ActorPatterns bytes
  $3C,$7E,$FF,$FF,$FF,$FF,$7E,$3C
  $00,$24,$24,$00,$18,$00,$00,$00
  $3C,$7E,$FF,$FF,$FF,$7E,$3C,$18
  $00,$24,$24,$00,$18,$00,$00,$00
end data

text screen
backdrop dark blue
sprites 8x8
sprites simple
copy ActorPatterns to vram.spr_pat
clear sprites
set sprite count 2
print centered at 3, "COOPERATIVE ANIMATION"
print centered at 20, "MOVE WITH JOYSTICK"
screen on

MainLoop:
  wait
  if joypad(1).left and ActorX > 1 then ActorX -= 1
  if joypad(1).right and ActorX < 247 then ActorX += 1
  if joypad(1).up and ActorY > 1 then ActorY -= 1
  if joypad(1).down and ActorY < 183 then ActorY += 1
  update animation ActorIdle to ActorY,ActorX using sprite 0
  update sprites
  goto MainLoop
