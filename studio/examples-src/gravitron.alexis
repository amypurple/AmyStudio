u8 ThrCntX = 0        ' $998D
u8 ThrCntY = 0        ' $998E
u8 RotCnt = 0         ' $9983
u8 GravT = 0          ' $93BE
u8 ClimbCnt = 0       ' $996E
' --- fuel: F = 0..96 (24 cells x 4); FuelOn $9966
u8 Fuel = 0
u8 FuelOn = 0
u8 FuelSub = 0        ' $996F
u8 RefCnt = 0         ' $996D
' --- shots
u8 BulOn = 0          ' $9976
u8 BulDir = 0         ' $9975
