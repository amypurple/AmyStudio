u8 FireDir = 0        ' $9977
u8 AimEnd = 0         ' $995A
u8 EnMx = 0           ' $9957
u8 EnMy = 0           ' $9958
' --- level things
u8 OrbSnd = 0         ' $9955
u8 RingCnt = 0        ' $9953
u8 RingBlink = 0      ' $9954
u8 RingCol = 0        ' $9914 bit 0
u8 RingVis = 0        ' port: the ring's shown colour phase (<= 3 Hz)
u8 RingVisT = 0
' --- scroll: fine X/Y ($997F/$997E), pending coarse step ($997D/$997C)
u8 FineX = 0
u8 FineY = 0
u8 Pend = 0
u8 PendDir = 0
' --- game
u8 Level = 0          ' $93BC
u8 Typ = 0            ' $9956
u8 Lives = 0          ' $93BF
u8 Left = 0           ' $92A6 saucers left this level
