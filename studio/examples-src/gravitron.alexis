bcd digits 6 Score = 0
bcd digits 6 Hi = 0
bcd digits 6 TopS[10] = 0
u8 TopN[30]
' --- port: background view, redraw, pages
u16 Q = 0             ' map offset of the view's top-left cell (0..5999)
u8 AccX = 0           ' 0.7 x stepping (C64 coarse columns -> port columns)
u8 Redraw = 0         ' rows still to draw into the hidden page (0 = none)
u8 RdRow = 0
u8 Shown = 0          ' 0: $1800 shown, 1: $1C00 shown
