  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  TopInit
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

level_start:
  SetupLevel
play_loop:
  Frame1
  ReadPad
  ' $8319: the checks use what the last pass saw
  if Crash = 1 then
    dec Lives
    if Lives = 0 then Over = 1
    ShipBoom
    goto level_start
  end if
  if ShipCol = 5 then
    V = Col & 6
    if V = 6 then
      SaucerBoom
      AddKill
      dec Left
      if Left = 0 then
        Left = 3
        NextLevel
      end if
      goto level_start
    end if
  end if
  if Over = 1 then goto game_over
  PassLogic
  Coarse
  ' sprites drawn every other pass, the background on the passes between
  ' (the rules still run every pass: frame budget, see README)
  V = Tick & 1
  if V = 0 then DrawAll
  goto play_loop

game_over:
  GameOverPage
  goto title

' ===========================================================================
' the rules (C64 $8485 and its subroutines), one pass a frame

' 16-bit xorshift (stands in for the SID noise the C64 reads at $D41B)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  ' $8009: three saucers a level, score 0, three lives, timer 50
  Left = 3
  Score = 0
  Lives = 3
  GravT = 50
  Level = 0
  Typ = 0
  Over = 0
  PlayMode
  NextLevel
  return
end sub

' $8F13: a spare ship after a type-0 level, a new map, the next level
sub NextLevel:
  if Typ = 0 then
    if Lives <> 3 then inc Lives
  end if
  State = StLevel
  inc Level
  LevelScreen
  MakeMap
  return
end sub

' $815A: variables back to their start values ($9915 -> $9953), sprites
' placed ($93A8), saucer at random, fuel full, the screen drawn
sub SetupLevel:
  Crash = 0
  Col = 0
  RingCnt = 3
  RingBlink = 5
  OrbSnd = 0
  Typ = Level & 3
  EnMx = 0
  EnMy = 0
  AimEnd = 4
  FuelOn = 1
  RefCnt = 5
  ClimbCnt = 4
  FuelSub = 10
  BulCnt = 0
  BulDir = 0
  BulOn = 0
  FireDir = 8
  EbOn = 0
  EbCnt = 0
  FireT = 25
  Par = 1
  Pend = 0
  PendDir = 0
  FineY = 4
  FineX = 4
  RotCnt = 7
  XvDir = 2
  XvDel = 4
  XvCnt = 4
  YvDir = 2
  YvDel = 4
  AltDir = 0
  AltDel = 9
  YvCnt = 4
  AltCnt = 9
  ThrCntX = 4
  ThrCntY = 4
  Dir = 1
  Fuel = 96
  ShipCol = 1
  ' $93A8: ship 174,115; shot; saucer (random); shadow 174,162; depot
  ' 276,70; orb 0,0; ring 266,200
  SX[0] = 174
  SY[0] = 115
  SX[1] = 174
  SY[1] = 115
  Rand
  W16 = Rs & 255
  SX[2] = W16
  Rand
  W16 = Rs & 255
  SY[2] = W16
  SX[3] = 0
  SY[3] = 0
  SX[4] = 174
  SY[4] = 162
  SX[5] = 276
  SY[5] = 70
  SX[6] = 0
  SY[6] = 0
  SX[7] = 266
  SY[7] = 200
  ' $8165: sprites 0-5 on, then both shots off ($8CCD, $8CE3)
  Ena = $3F
  BulKill
  EbKill
  RingCol = 0
  RingVis = 0
  RingVisT = 0
  Q = 0
  AccX = 0
  DrawPlay
  State = StPlay
  return
end sub

' collisions of what the screen showed (the C64 reads $D01E once a pass)
sub Collide:
  Col = 0
  ' the flags are only read while the ship is low ($848B); high, skip the work
  if SY[0] < $7D then return
  ' the enabled sprites and their masks
  Nen = 0
  for Ra = 0 to 7
    T = Bit[Ra]
    V = Ena & T
    if V > 0 then
      EnL[Nen] = Ra
      inc Nen
    end if
  next
  if Nen < 2 then return
  Gk = Nen - 2
  for Rb = 0 to Gk
    Ra = EnL[Rb]
    Fs = SX[Ra]
    Ca = Rb + 1
    for Cb = Ca to 7
      if Cb >= Nen then exit for
      K = EnL[Cb]
      Fb = SX[K]
      if Fs >= Fb then
        W16 = Fs - Fb
      else
        W16 = Fb - Fs
      end if
      if W16 < 24 then
        Sl = MaskOf(Ra)
        Nacc = MaskOf(K)
        Ok = Overlap(Sl, Ra, Nacc, K)
        if Ok = 1 then
          T = Bit[Ra]
          Col = Col | T
          T = Bit[K]
          Col = Col | T
        end if
      end if
    next
  next
  return
end sub

' the C64 sprite data each sprite shows (ship and shadow: the heading)
function MaskOf(u8 Sp) as u8
  u8 Res = 0
  Res = SprMask[Sp]
  if Res = 255 then Res = Dir - 1
  return Res

data Bit bytes 1,2,4,8,16,32,64,128
data SprMask bytes 255,16,17,16,255,18,19,20

' do the C64 pixels of mask Ma at sprite Sa and mask Mb at sprite Sb meet?
function Overlap(u8 Ma, u8 Sa, u8 Mb, u8 Sb) as u8
  u8 Res = 0
  u8 Ha = 0
  u8 Hb = 0
  u8 Ya = 0
  u8 Yb = 0
  u16 Pa = 0
  u16 Pb = 0
  ' X distance on the screen (no wrap), at most 23 pixels
  A16 = SX[Sa]
  B16 = SX[Sb]
  if A16 >= B16 then
    W16 = A16 - B16
  else
    W16 = B16 - A16
  end if
  if W16 > 23 then return 0
  Dx8 = W16
  Qb = Dx8 >> 3
  Rs8 = Dx8 & 7
  Ls8 = 8 - Rs8
  OvL = 0
  if SX[Sb] < SX[Sa] then OvL = 1
  ' rows: both sprites within 21 lines (mod 256)
  T = SY[Sa] - SY[Sb]
  if T >= 21 then
    if T <= 235 then return 0
  end if
  ' rows: mask a rows Ya.., mask b rows Yb.. (screen rows, mod 256)
  Pa = MaskIdx[Ma]
  W16 = MaskIdx[Ma + NMask]
  W16 = W16 << 8
  Pa = Pa + W16
  Pb = MaskIdx[Mb]
  W16 = MaskIdx[Mb + NMask]
  W16 = W16 << 8
  Pb = Pb + W16
  Ya = SY[Sa] + MaskData[Pa]
  Ha = MaskData[Pa + 1]
  Yb = SY[Sb] + MaskData[Pb]
  Hb = MaskData[Pb + 1]
  Pa += 2
  Pb += 2
  ' walk the rows of a; the matching row of b is Ry = row - Yb
  ' first row of a that can meet b: skip the rows above b
  Ry = Yb - Ya
  Mj = 0
  if Ry < 128 then Mj = Ry
  for Mi = Mj to 20
    if Mi >= Ha then exit for
    Ry = Ya + Mi
    Ry = Ry - Yb
    if Ry >= Hb then
      if Ry < 128 then exit for
    end if
    if Ry < Hb then
      ' the left sprite's row in Lr[], the right one's in Rr[] (bytes)
      W16 = Mi * 3
      W16 += Pa
      Pq = Ry * 3
      Pq += Pb
      if OvL = 0 then
        Lr[0] = MaskData[W16]
        Lr[1] = MaskData[W16 + 1]
        Lr[2] = MaskData[W16 + 2]
        Rr[0] = MaskData[Pq]
        Rr[1] = MaskData[Pq + 1]
        Rr[2] = MaskData[Pq + 2]
      else
        Rr[0] = MaskData[W16]
        Rr[1] = MaskData[W16 + 1]
        Rr[2] = MaskData[W16 + 2]
        Lr[0] = MaskData[Pq]
        Lr[1] = MaskData[Pq + 1]
        Lr[2] = MaskData[Pq + 2]
      end if
      ' the right row moved Dx8 pixels: whole bytes Qb, then Rs8 bits
      for Bk = Qb to 2
        Bj = Bk - Qb
        V = Rr[Bj] >> Rs8
        if Bj > 0 then
          if Rs8 > 0 then
            T = Rr[Bj - 1] << Ls8
            V = V | T
          end if
        end if
        V = V & Lr[Bk]
        if V <> 0 then Res = 1
      next
      if Res = 1 then exit for
    end if
  next
  return Res

sub PassLogic:
  Collide
  ' $848B: low enough (Y >= $7D) to be hit, refuel and shoot
  if SY[0] >= $7D then
    V = Col & $20
    if V = 0 then
      V = Col & $41
      if V = $41 then Crash = 1
    end if
    ShipCol = 5
    V = Col & $20
    if V = 0 then
      V = Col & 9
      if V = 9 then Crash = 1
    end if
    V = Col & $21
    if V = $21 then
      Refuel
      dec RefCnt
      if RefCnt = 0 then
        RefCnt = 5
        if RefTone = 0 then play sound SndRefuel
        if RefTone = 1 then play sound SndFull
      end if
    end if
  else
    ShipCol = 1
  end if
  ' $84EA: the gravity ring (type 3) and the orb (type 0)
  if Typ = 3 then
    Ena = Ena | $80
    GravWell
    dec RingBlink
    if RingBlink = 0 then
      RingCol = RingCol ^ 1
      RingBlink = 7
    end if
  end if
  if Typ = 0 then
    Ena = Ena | $40
    OrbMove
    dec OrbSnd
    if OrbSnd >= 128 then
      OrbSnd = 59
      play sound SndOrb
    end if
  end if
  ' $8532: from level 3 the saucer flies (one pixel each way a pass)
  if Level >= 3 then
    if EnMx = 1 then
      W16 = SX[2] + 1
    else
      W16 = SX[2] - 1
    end if
    SX[2] = W16 & 511
    if EnMy = 1 then
      SY[2] = SY[2] - 1
    else
      SY[2] = SY[2] + 1
    end if
  end if
  ' $8576: engine noise while thrusting or climbing with fuel
  if FuelOn = 1 then
    V = Jk & 3
    if V > 0 then
      if EngT = 0 then
        play sound SndEngine
        EngT = 6
      end if
    end if
  end if
  if EngT > 0 then dec EngT
  ' $859A: gravity every 33 passes (99 - $9959; $9959 = 2 x level is set by
  ' $8F13 but zeroed again by every level setup, $8FFF)
  GravT -= 3
  if GravT >= 128 then
    GravT = 99
    Gravity
  end if
  ' $85B1: stick down climbs (fuel), every 4th pass a push up
  if FuelOn = 1 then
    V = Jk & 2
    if V > 0 then
      Burn
      dec ClimbCnt
      if ClimbCnt = 0 then
        ClimbCnt = 4
        Climb
      end if
    end if
  end if
  AltStep
  ' $85D0: the saucer's fire
  dec FireT
  if FireT = 0 then
    dec FireDir
    if FireDir = AimEnd then FireDir = Aim()
    FireT = Life[FireDir]
    T = FireT >> 1
    EbCnt = T - 3
    EbKill
    SX[3] = SX[2]
    SY[3] = SY[2]
    EbOn = 1
  end if
  dec EbCnt
  if EbCnt = 0 then Ena = Ena | 8
  ' $862D: the saucer's shot, two steps a pass
  K = FireDir
  ShotStep(3, K)
  ShotStep(3, K)
  ' $8660: your shot
  if BulOn = 0 then
    V = Jk & 16
    if V = 0 then goto pl_bounds
    BulKill
    play sound SndShot
    BulDir = Dir
    T = Life[Dir]
    BulCnt = T >> 2
    BulOn = 1
    SX[1] = SX[0]
    SY[1] = SY[0]
  end if
  dec BulCnt
  if BulCnt = 0 then Ena = Ena | 2
  K = BulDir
  ShotStep(1, K)
pl_bounds:
  ' $8700: the shot leaves the playfield
  if SY[1] >= $CD then
    BulKill
  elseif SY[1] < $29 then
    BulKill
  elseif SX[1] >= 256 then
    W16 = SX[1] - 256
    if W16 >= $45 then BulKill
  else
    if SX[1] < $0F then BulKill
  end if
  ' $873C: turn one heading every 7th pass (fuel needed)
  dec RotCnt
  if RotCnt = 0 then
    RotCnt = 7
    if FuelOn = 1 then
      V = Jk & 4
      if V > 0 then
        dec Dir
        if Dir < 1 then Dir = 16
      else
        V = Jk & 8
        if V > 0 then
          inc Dir
          if Dir >= 17 then Dir = 1
        end if
      end if
    end if
  end if
  ' $878A: thrust (fuel)
  if FuelOn = 1 then
    V = Jk & 1
    if V > 0 then
      Burn
      dec ThrCntX
      if ThrCntX = 0 then
        ThrCntX = ThrX[Dir]
        V = PushX[Dir]
        PushXv(V)
      end if
      dec ThrCntY
      if ThrCntY = 0 then
        ThrCntY = ThrY[Dir]
        V = PushY[Dir]
        PushYv(V)
      end if
    end if
  end if
  XStep
  YStep
  return
end sub

' one step of shot S (1 yours, 3 the saucer's) along heading D ($86A9/$862D)
sub ShotStep(u8 S, u8 D):
  V = SgnX[D]
  T = Dx[D]
  if V = 1 then
    W16 = SX[S] + T
    SX[S] = W16 & 511
  elseif V = 2 then
    W16 = SX[S] - T
    SX[S] = W16 & 511
  end if
  V = SgnY[D]
  T = Dy[D]
  if V = 1 then
    SY[S] = SY[S] + T
  elseif V = 2 then
    SY[S] = SY[S] - T
  end if
  return
end sub

' $8CCD / $8CE3: a shot off (its X high bit cleared too)
sub BulKill:
  SX[1] = SX[1] & 255
  Ena = Ena & $FD
  BulOn = 0
  return
end sub

sub EbKill:
  SX[3] = SX[3] & 255
  Ena = Ena & $F7
  EbOn = 0
  return
end sub

' $9C97: aim the next volley at the ship's quarter; the saucer drifts that way
function Aim as u8
  u8 Res = 0
  u8 Lft = 0
  W16 = SX[2]
  if W16 >= 256 then Lft = 1
  if SX[0] < W16 then Lft = 1
  if Lft = 0 then
    ' ship right of the saucer
    if SY[0] >= SY[2] then
      EnMx = 1
      EnMy = 0
      AimEnd = 4
      Res = 9
    else
      EnMx = 1
      EnMy = 1
      AimEnd = 0
      Res = 5
    end if
  else
    if SY[0] >= SY[2] then
      EnMx = 0
      EnMy = 0
      AimEnd = 8
      Res = 13
    else
      EnMx = 0
      EnMy = 1
      AimEnd = 12
      Res = 17
    end if
  end if
  return Res

' $8805 / $9D78 ...: push the sideways speed towards a heading (bit 8 right,
' bit 4 left): speeds up (delay down to 1) or brakes (delay up, 10 = stop)
sub PushXv(u8 B):
  V = B & 8
  if V > 0 then
    if XvDir = 1 then
      inc XvDel
      if XvDel = 10 then
        XvDel = 9
        XvDir = 0
      end if
    else
      dec XvDel
      if XvDel = 0 then XvDel = 1
      XvDir = 2
    end if
    return
  end if
  V = B & 4
  if V > 0 then
    if XvDir = 2 then
      inc XvDel
      if XvDel = 10 then
        XvDel = 9
        XvDir = 0
      end if
    else
      dec XvDel
      if XvDel = 0 then XvDel = 1
      XvDir = 1
    end if
  end if
  return
end sub

' $8898: the same up/down (bit 1 up, bit 2 down)
sub PushYv(u8 B):
  V = B & 1
  if V > 0 then
    if YvDir = 1 then
      inc YvDel
      if YvDel = 10 then
        YvDel = 9
        YvDir = 0
      end if
    else
      dec YvDel
      if YvDel = 0 then YvDel = 1
      YvDir = 2
    end if
    return
  end if
  V = B & 2
  if V > 0 then
    if YvDir = 2 then
      inc YvDel
      if YvDel = 10 then
        YvDel = 9
        YvDir = 0
      end if
    else
      dec YvDel
      if YvDel = 0 then YvDel = 1
      YvDir = 1
    end if
  end if
  return
end sub

' $886E: sideways drift, one pixel every XvDel passes
sub XStep:
  if XvDir = 0 then return
  dec XvCnt
  if XvCnt <> 0 then return
  XvCnt = XvDel
  if XvDir = 2 then
    WorldLeft
  else
    WorldRight
  end if
  return
end sub

' $8901: up/down drift on every other pass
sub YStep:
  Par = Par ^ 1
  if YvDir = 0 then return
  dec YvCnt
  if YvCnt <> 0 then return
  YvCnt = YvDel
  if Par = 0 then return
  if YvDir = 2 then
    WorldDown
  else
    WorldUp
  end if
  return
end sub

' $8A39 / $8AA2 / $8B06 / $8B2F: the world (saucer, depot, orb, ring) moves
' one pixel, the fine scroll follows; a full character asks for a coarse step
sub WorldRight:
  if Pend <> 0 then return
  W16 = SX[7] + 1
  SX[7] = W16 & 511
  W16 = SX[6] + 1
  SX[6] = W16 & 511
  W16 = SX[5] + 1
  SX[5] = W16 & 511
  W16 = SX[2] + 1
  SX[2] = W16 & 511
  inc FineX
  if FineX = 8 then
    FineX = 0
    PendDir = 3
    Pend = 3
  end if
  return
end sub

sub WorldLeft:
  if Pend <> 0 then return
  W16 = SX[7] - 1
  SX[7] = W16 & 511
  W16 = SX[6] - 1
  SX[6] = W16 & 511
  W16 = SX[5] - 1
  SX[5] = W16 & 511
  W16 = SX[2] - 1
  SX[2] = W16 & 511
  dec FineX
  if FineX >= 128 then
    FineX = 7
    PendDir = 1
    Pend = 1
  end if
  return
end sub

sub WorldDown:
  if Pend <> 0 then return
  SY[7] = SY[7] + 1
  SY[6] = SY[6] + 1
  SY[5] = SY[5] + 1
  SY[2] = SY[2] + 1
  inc FineY
  if FineY = 8 then
    FineY = 0
    PendDir = 4
    Pend = 4
  end if
  return
end sub

sub WorldUp:
  if Pend <> 0 then return
  SY[7] = SY[7] - 1
  SY[6] = SY[6] - 1
  SY[5] = SY[5] - 1
  SY[2] = SY[2] - 1
  dec FineY
  if FineY >= 128 then
    FineY = 7
    PendDir = 2
    Pend = 2
  end if
  return
end sub

' $893D: gravity pulls the climb speed down; $8969: the climb pushes it up
sub Gravity:
  if AltDir <> 1 then
    dec AltDel
    if AltDel = 0 then AltDel = 1
    AltDir = 2
  else
    inc AltDel
    if AltDel = 10 then
      AltDel = 9
      AltDir = 0
    end if
  end if
  return
end sub

sub Climb:
  if AltDir <> 2 then
    dec AltDel
    if AltDel = 0 then AltDel = 1
    AltDir = 1
  else
    inc AltDel
    if AltDel = 10 then
      AltDel = 9
      AltDir = 0
    end if
  end if
  return
end sub

' $8995: the ship sinks (shadow rises) or climbs, one pixel every AltDel
' passes; at Y $87 it hits the ground, at $73 gravity takes over at once
sub AltStep:
  if AltDir = 0 then return
  dec AltCnt
  if AltCnt <> 0 then return
  AltCnt = AltDel
  if AltDir = 2 then
    SY[4] = SY[4] - 1
    SY[0] = SY[0] + 1
    if SY[0] >= $87 then
      SY[0] = $87
      SY[4] = $8E
      Crash = 1
    end if
  else
    SY[4] = SY[4] + 1
    SY[0] = SY[0] - 1
    if SY[0] < $73 then
      SY[0] = $73
      SY[4] = $A2
      GravT = 1
    end if
  end if
  return
end sub

' $8D54: every 10th thrusting/climbing pass uses one unit of fuel
sub Burn:
  dec FuelSub
  if FuelSub <> 0 then return
  FuelSub = 10
  if Fuel = 0 then
    FuelOn = 0
    return
  end if
  dec Fuel
  FuelCell
  return
end sub

' $8D7F: on the depot, one unit a pass; the C64 gauge stops at its last
' cell (24 cells of 4: refuelling ends at 93, a new level starts at 96)
sub Refuel:
  FuelOn = 1
  if Fuel >= 93 then
    RefTone = 1
    return
  end if
  RefTone = 0
  inc Fuel
  T = Fuel - 1
  FuelCellAt(T)
  return
end sub

' $9D22: every 3rd pass a ring well inside the screen speeds gravity up and
' pulls the ship towards itself
sub GravWell:
  dec RingCnt
  if RingCnt <> 0 then return
  RingCnt = 3
  if SX[7] >= 256 then return
  if SX[7] >= $E0 then return
  if SX[7] < $7C then return
  if SY[7] >= $AF then return
  if SY[7] < $4B then return
  GravT -= 3
  RingCol = RingCol ^ 1
  if SX[0] < SX[7] then
    PushXv(8)
  else
    PushXv(4)
  end if
  if SY[0] < SY[7] then
    PushYv(2)
  else
    PushYv(1)
  end if
  return
end sub

' $9D00: the orb slides along the saucer's current fire heading
sub OrbMove:
  K = FireDir
  T = Dx[K]
  W16 = SX[6] + T
  SX[6] = W16 & 511
  T = Dy[K]
  SY[6] = SY[6] + T
  return
end sub

' $8367: a saucer is worth the level, (level + 1) times
sub AddKill:
  for Oi = 0 to Level
    Score += Level
  next
  if Score > Hi then Hi = Score
  return
end sub

' ===========================================================================
' coarse scroll ($839C): the view steps one character; the port's view steps
' a column every 10/7 C64 columns (the screen is 0.7 as wide), rows 1:1

sub Coarse:
  if Pend = 0 then return
  K = 0
  if PendDir = 1 then
    AccX += 7
    if AccX >= 10 then
      AccX -= 10
      Q += 1
      if Q >= MapLen then Q -= MapLen
      K = 1
    end if
  elseif PendDir = 3 then
    if AccX >= 7 then
      AccX -= 7
    else
      AccX += 3
      if Q = 0 then Q = MapLen
      Q -= 1
      K = 1
    end if
  elseif PendDir = 2 then
    Q += MapW
    if Q >= MapLen then Q -= MapLen
    K = 1
  else
    if Q < MapW then Q += MapLen
    Q -= MapW
    K = 1
  end if
  Pend = 0
  if K = 1 then
    Redraw = 1
    RdRow = 0
  end if
  return
end sub

' read map cells L .. L + 31 (wrapping at 6000) into Buf
sub ReadMap(u16 L):
  u8 Ci = 0
  if L < 4064 then
    A16 = L + 2048
    copy vram.pattern + A16 count 32 to Buf
    return
  end if
  if L >= 4096 then
    if L < 5968 then
      A16 = L - 2048
      copy vram.color + A16 count 32 to Buf
      return
    end if
  end if
  for Ci = 0 to 31
    if L >= MapLen then L -= MapLen
    if L < 4096 then
      A16 = L + 2048
      vpeek vram.pattern + A16 into V
    else
      A16 = L - 2048
      vpeek vram.color + A16 into V
    end if
    Buf[Ci] = V
    L += 1
  next
  return
end sub

' one map cell (the generator; L may run past 6000 into scratch cells)
function MapGet(u16 L) as u8
  u8 Res = 0
  if L < 4096 then
    A16 = L + 2048
    vpeek vram.pattern + A16 into Res
  else
    A16 = L - 2048
    vpeek vram.color + A16 into Res
  end if
  return Res

sub MapPut(u16 L, u8 Ch):
  if L < 4096 then
    A16 = L + 2048
    vpoke vram.pattern + A16, Ch
  else
    A16 = L - 2048
    vpoke vram.color + A16, Ch
  end if
  return
end sub

' draw up to 7 rows of the hidden page (3 frames); the last half swaps the pages
sub RedrawStep:
  for Li = 0 to 6
    if RdRow > 20 then exit for
    L16 = RdRow
    L16 = L16 * MapW
    L16 += Q
    if L16 >= MapLen then L16 -= MapLen
    ReadMap(L16)
    A16 = RdRow
    A16 = A16 << 5
    A16 += Hid
    copy Buf count 32 to vram.name + A16
    inc RdRow
  next
  if RdRow > 20 then
    Redraw = 0
    ShowHidden
  end if
  return
end sub

' show the page just drawn (VDP register 2)
sub ShowHidden:
  if Shown = 0 then
    Shown = 1
    Hid = 0
    asm {
      ld a,7
      out ($BF),a
      ld a,$82
      out ($BF),a
    }
  else
    Shown = 0
    Hid = 1024
    asm {
      ld a,6
      out ($BF),a
      ld a,$82
      out ($BF),a
    }
  end if
  return
end sub

' ===========================================================================
' the map generator ($901B): 17 bands of cloud shapes, 3 rows apart, each
' band filled left to right with random shapes that fit (no overlap)

sub MakeMap:
  ' the map and its scratch rows: empty ($FF)
  fill $FF count 4096 to vram.pattern + 2048
  fill $FF count 2400 to vram.color + 2048
  ShpPrev = 255
  for Band = 1 to 17
    ' $908D: band start = map + 360 x (band - 1) + 1
    Fb = Band - 1
    Fb = Fb * 360
    Fb += 1
    Wsum = 0
    while Wsum < 120
      ' $9274: a shape other than the last one
      do
        Rand
        W16 = Rs % 9
        Shp = W16
      loop while Shp = ShpPrev
      ShpPrev = Shp
      SAt = ShapeAt[Shp]
      ' $9188: does it fit on empty cells?
      Free = 1
      Fs = Fb
      Gk = 1
      ShapeWalk
      Fb = Fs
      ' $90E4: draw it (if it fits) and move on
      Gk = 0
      ShapeWalk
      T = Shapes[SAt]
      Wsum += T
      T = T >> 1
      Fb += T
      Fb += 1
      T = Shapes[SAt + 1]
      for Mj = 1 to 2
        if Mj > T then exit for
        Fb -= MapW
      next
    end while
  next
  return
end sub

' walk the shape at SAt from Fb: consecutive characters go on along a row; a
' jump starts the next row lined up with the C64 character sheet (32 wide).
' Gk = 1: only test the cells (Free = 0 if one is used); Gk = 0: draw.
sub ShapeWalk:
  Prev = Shapes[SAt + 2]
  Mi = SAt + 3
  do
    Cur = Shapes[Mi]
    if Cur = 255 then exit do
    T = Cur - 1
    if T = Prev then
      if Gk = 1 then
        V = MapGet(Fb)
        if V <> 255 then Free = 0
      else
        if Free = 1 then MapPut(Fb, Cur)
      end if
      Fb += 1
      Prev = Cur
    else
      ' next row: + 120 - (32 - (cur - previous entry))
      T = Shapes[Mi - 1]
      T = Cur - T
      T = 32 - T
      Fb += MapW
      Fb -= T
      Prev = Cur
    end if
    inc Mi
  loop
  return
end sub

' ===========================================================================
' drawing

' the play screen: colours of this level's scheme, map view, HUD
sub DrawPlay:
  NewPlayScreen
  Hid = 0
  Shown = 1
  Q = 0
  for RdRow = 0 to 20
    L16 = RdRow
    L16 = L16 * MapW
    ReadMap(L16)
    A16 = RdRow
    A16 = A16 << 5
    copy Buf count 32 to vram.name + A16
    A16 += 1024
    copy Buf count 32 to vram.name + A16
  next
  Redraw = 0
  DrawHud
  ' show page 0 ($1800); page 1 is the hidden one
  Shown = 1
  ShowHidden
  ShowHidden
  DrawAll
  ShowScreen
  return
end sub

' play-mode VRAM: tiles into the one shared pattern table, colours from
' the level's scheme (pair codes -> ColLut), then the HUD's fixed colours
sub NewPlayScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  decompress zx0 MapPatZ to vram.pattern
  decompress zx0 MapPairZ to vram.color
  T = Typ << 4
  for Li = 0 to 63
    A16 = Li
    A16 = A16 << 5
    copy vram.color + A16 count 32 to Buf
    for Mj = 0 to 31
      K = Buf[Mj]
      K += T
      Buf[Mj] = ColLut[K]
    next
    copy Buf count 32 to vram.color + A16
  next
    copy HudRun0 count 32 to vram.color + 312
  copy HudRun1 count 248 to vram.color + 1792
  return
end sub

' play mode: one 2K pattern table for the whole screen (R4 = 0)
sub PlayMode:
  Rearm
  wait
  nmi off
  display off
  asm {
    ld a,0
    out ($BF),a
    ld a,$84
    out ($BF),a
  }
  return
end sub

' title mode: the standard Amy table layout again (R4 = 3, R2 = $1800)
sub TitleMode:
  asm {
    ld a,3
    out ($BF),a
    ld a,$84
    out ($BF),a
    ld a,6
    out ($BF),a
    ld a,$82
    out ($BF),a
  }
  Shown = 0
  return
end sub

' a HUD tile on both pages
sub HPut(u8 Hx, u8 Hy, u8 Ht):
  A16 = Hy
  A16 = A16 << 5
  A16 += Hx
  vpoke vram.name + A16, Ht
  A16 += 1024
  vpoke vram.name + A16, Ht
  return
end sub

' row 21: SCORE 000000 HI 000000 LV 01; row 22: FUEL, gauge, lives
sub DrawHud:
  for Li = 0 to 31
    HPut(Li, 21, HBlack)
    HPut(Li, 22, HBlack)
    HPut(Li, 23, HBlack)
  next
  HPut(2, 21, HLS)
  HPut(3, 21, HLC)
  HPut(4, 21, HLO)
  HPut(5, 21, HLR)
  HPut(6, 21, HLE)
  HPut(15, 21, HLH)
  HPut(16, 21, HLI)
  HPut(25, 21, HLL)
  HPut(26, 21, HLV)
  for Li = 2 to 29
    HPut(Li, 22, HPanel)
  next
  HPut(2, 22, HFF)
  HPut(3, 22, HFU)
  HPut(4, 22, HFE)
  HPut(5, 22, HFL)
  DrawScore
  DrawFuel
  DrawLives
  ' the level, two digits
  NumU = Level
  format NumU into Buf digits 2
  HPut(28, 21, HD0 + Buf[0] - 48)
  HPut(29, 21, HD0 + Buf[1] - 48)
  return
end sub

sub DrawScore:
  format Score into Buf
  for Li = 0 to 5
    C = Buf[Li] - 48
    HPut(Li + 8, 21, HD0 + C)
  next
  format Hi into Buf
  for Li = 0 to 5
    C = Buf[Li] - 48
    HPut(Li + 18, 21, HD0 + C)
  next
  return
end sub

' one gauge cell: the one holding unit Fuel (after a burn: units Fuel..)
sub FuelCell:
  FuelCellAt(Fuel)
  return
end sub

sub FuelCellAt(u8 U):
  u8 Cc = 0
  u8 Base = 0
  Cc = U >> 3
  if Cc > 11 then return
  Base = Cc << 3
  T = Fuel - Base
  if Fuel < Base then T = 0
  if T > 8 then T = 8
  K = HBar0
  select case T
    case 1
      K = HBar1
    case 2
      K = HBar2
    case 3
      K = HBar3
    case 4
      K = HBar4
    case 5
      K = HBar5
    case 6
      K = HBar6
    case 7
      K = HBar7
    case 8
      K = HBar8
  end select
  HPut(Cc + 7, 22, K)
  return
end sub

' the gauge: 12 cells of 8 pixels at columns 7-18 (one pixel a unit)
sub DrawFuel:
  T = Fuel
  for Li = 7 to 18
    if T >= 8 then
      HPut(Li, 22, HBar8)
      T -= 8
    else
      K = HBar0
      if T > 0 then
        select case T
          case 1
            K = HBar1
          case 2
            K = HBar2
          case 3
            K = HBar3
          case 4
            K = HBar4
          case 5
            K = HBar5
          case 6
            K = HBar6
          case else
            K = HBar7
        end select
      end if
      HPut(Li, 22, K)
      T = 0
    end if
  next
  return
end sub

' lives: ship icons at columns 22, 24, 26
sub DrawLives:
  for Li = 0 to 2
    C = Li << 1
    C += 22
    K = HPanel
    if Li < Lives then K = HLife
    HPut(C, 22, K)
  next
  return
end sub

' the sprites, by priority; a sprite that would make a 5th on any of its
' lines is left out (never the ship, the saucer's shot or the orb)
sub DrawAll:
  Nacc = 0
  Sl = 0
  ' ring blink, at most 3 Hz on screen (C64: every 7 passes)
  inc RingVisT
  if RingVisT >= 20 then
    RingVisT = 0
    RingVis = RingVis ^ 1
  end if
  ' ship (1:1 pixels, columns 4-19 of the C64 sprite)
  K = Dir - 1
  K = K << 2
  if BoomShip = 1 then K = SWork0
  T = 2
  if ShipCol = 1 then T = 15
  Place(0, ShipR0, 8, K, T, 8, 12)
  if BoomShip = 0 then
    K += SLine1
    Place(0, ShipR0, 10, K, 1, 8, 12)
  end if
  V = Ena & 8
  if V > 0 then Place(3, ShipR0, 8, SShot, 15, 8, 12)
  V = Ena & $40
  if V > 0 then Place(6, OrbR0, 13, SOrbA, 8, 0, 0)
  V = Ena & 4
  if V > 0 then
    T = 15
    if Left = 3 then T = 7
    if Left = 2 then T = 8
    K = SSauA
    if BoomSau = 1 then K = SWork1
    Place(2, SauR0, 14, K, T, 0, 0)
  end if
  V = Ena & 2
  if V > 0 then Place(1, ShipR0, 8, SShot, 15, 8, 12)
  V = Ena & $20
  if V > 0 then Place(5, DepR0, 16, SDepA, 15, 0, 0)
  if BoomShip = 0 then
    K = Dir - 1
    K = K << 2
    T = 1
    if Typ = 1 then T = 4
    Place(4, ShipR0, 8, K, T, 8, 12)
  end if
  V = Ena & $80
  if V > 0 then
    T = 1
    if RingVis = 1 then T = 15
    Place(7, RingR0, 14, SRingA, T, 0, 0)
  end if
  V = Ena & $40
  if V > 0 then Place(6, OrbR0, 13, SOrbB, 14, 0, 0)
  V = Ena & 4
  if V > 0 then
    if BoomSau = 0 then Place(2, SauR0, 14, SSauB, 1, 0, 0)
  end if
  V = Ena & $20
  if V > 0 then Place(5, DepR0, 16, SDepB, 4, 0, 0)
  V = Ena & $80
  if V > 0 then Place(7, RingR0, 14, SRingB, 14, 0, 0)
  for Li = Sl to 11
    set sprite Li to HideY,0,0,0
  next
  update sprites
  return
end sub

' sprite S of the C64 drawn with pattern P, colour Cc: R0 = first C64 row
' of the pattern, Hh = rows that hold pixels; Ox/Cx: the C64 column Cx is
' at pattern column Ox (ship, shots: 1:1 pixels), else the sprite is the
' C64 sprite squeezed 24 -> 16 columns
sub Place(u8 S, u8 R0, u8 Hh, u8 P, u8 Cc, u8 Ox, u8 Cx):
  u8 Pi = 0
  u8 Cnt = 0
  ' screen y of the first row: C64 Y - 42 (row 1 = C64 line 50)
  W16 = SY[S] + R0
  if W16 < 50 then return
  W16 -= 42
  if W16 > 152 then return
  SpY = W16
  ' screen x: (C64 X + Cx) x 0.7 - Ox
  W16 = SX[S] + Cx
  W16 = W16 & 511
  if W16 >= 256 then
    W16 -= 256
    V = XHi[W16]
  else
    V = XLo[W16]
  end if
  W16 = V
  T = Ox + 16
  if W16 < T then return
  W16 -= Ox
  if W16 > 224 then return
  SpX = W16
  ' at most 4 sprites a line: count the placed ones this one would meet
  Cnt = 0
  if Nacc < 4 then goto pl_ok
  for Pi = 0 to 11
    if Pi >= Nacc then exit for
    T = AccY[Pi]
    if T > SpY then
      V = T - SpY
    else
      V = SpY - T
    end if
    if V < 16 then inc Cnt
  next
  if Cnt >= 4 then return
pl_ok:
  AccY[Nacc] = SpY
  inc Nacc
  T = SpY - 1
  set sprite Sl to T,SpX,P,Cc
  inc Sl
  return
end sub

' ===========================================================================
' explosions ($8F6C ship, $8F5E saucer): the pixels fade out at random
' (one pass over the pattern every 8 frames); the C64 also flashes the
' border at full speed, left out here (3 Hz rule)

sub ShipBoom:
  State = StDie
  play sound SndBoom
  K = Dir - 1
  K = K << 5
  A16 = K
  copy vram.spr_pat + A16 count 32 to Buf
  Ec = 0
sb_loop:
  for Li = 0 to 31
    Rand
    T = Rs & 255
    Buf[Li] = Buf[Li] & T
  next
  A16 = SWork0
  A16 = A16 << 3
  copy Buf count 32 to vram.spr_pat + A16
  BoomShip = 1
  DrawAll
  for Li = 1 to 8
    Frame1
  next
  T = 0
  for Li = 0 to 31
    T = T | Buf[Li]
  next
  if T <> 0 then goto sb_loop
  for Li = 1 to 8
    Frame1
  next
  BoomShip = 0
  return
end sub

sub SaucerBoom:
  State = StKill
  play sound SndBoom
  A16 = SSauA
  A16 = A16 << 3
  copy vram.spr_pat + A16 count 32 to Buf
sk_loop:
  for Li = 0 to 31
    Rand
    T = Rs & 255
    Buf[Li] = Buf[Li] & T
  next
  A16 = SWork1
  A16 = A16 << 3
  copy Buf count 32 to vram.spr_pat + A16
  ' the saucer shows the fading copy of its top layer
  BoomSau = 1
  DrawAll
  for Li = 1 to 8
    Frame1
  next
  T = 0
  for Li = 0 to 31
    T = T | Buf[Li]
  next
  if T <> 0 then goto sk_loop
  for Li = 1 to 8
    Frame1
  next
  BoomSau = 0
  return
end sub

' the level's number while its map is made (the C64 shows a blank screen)
sub LevelScreen:
  HideSprites
  for Li = 0 to 23
    A16 = Li
    A16 = A16 << 5
    fill HBlack count 32 to vram.name + A16
  next
    copy HudRun0 count 32 to vram.color + 312
  copy HudRun1 count 248 to vram.color + 1792
  decompress zx0 MapPatZ to vram.pattern
  NumU = Level
  format NumU into Buf digits 2
  vpoke vram.name + 365, HLL
  vpoke vram.name + 366, HLV
  vpoke vram.name + 368, HD0 + Buf[0] - 48
  vpoke vram.name + 369, HD0 + Buf[1] - 48
  asm {
    ld a,6
    out ($BF),a
    ld a,$82
    out ($BF),a
  }
  Shown = 0
  screen on
  nmi off
  return
end sub

' ===========================================================================
' game over and the top ten (the C64 keeps it on disk; here until power off)

sub TopInit:
  for Li = 0 to 9
    TopS[Li] = 0
  next
  fill array TopN with 65
  return
end sub

sub GameOverPage:
  HideSprites
  TitleMode
  NewScreen
  State = StOver
  print at 11,4, "GAME OVER"
  print at 9,6, "SCORE"
  print at 15,6, Score
  play sound SndOver
  ShowScreen
  for Li = 1 to 90
    Frame1
  next
  ' a place in the top ten? (C64 $9B43: score >= an entry)
  Rank = 10
  for Li = 0 to 9
    if Rank = 10 then
      if Score >= TopS[Li] then Rank = Li
    end if
  next
  if Rank < 10 then
    J = 9
    while J > Rank
      K = J - 1
      TopS[J] = TopS[K]
      C = J * 3
      T = K * 3
      TopN[C] = TopN[T]
      TopN[C + 1] = TopN[T + 1]
      TopN[C + 2] = TopN[T + 2]
      dec J
    end while
    TopS[Rank] = Score
    C = Rank * 3
    TopN[C] = 65
    TopN[C + 1] = 65
    TopN[C + 2] = 65
    EnterInitials
  end if
  ShowTable
  return
end sub

sub ShowTable:
  NewScreen
  State = StTable
  print at 11,2, "TOP TEN"
  for Li = 0 to 9
    C = Li * 3
    T = Li << 1
    T += 4
    put char TopN[C] at 10,T
    put char TopN[C + 1] at 11,T
    put char TopN[C + 2] at 12,T
    print at 15,T, TopS[Li]
  next
  if Rank = 10 then print at 9,1, "NOT ON TOP TEN"
  print at 8,22, "PRESS THE BUTTON"
  PageWait
  return
end sub

' $9A9E: stick up/down changes the letter, left/right moves, the button ends
sub EnterInitials:
  NewScreen
  State = StEntry
  print at 7,3, "YOU HAVE MADE THE"
  print at 11,5, "TOP TEN!"
  print at 4,9, "INPUT YOUR INITIALS WITH"
  print at 5,11, "THE STICK, THEN PRESS"
  print at 10,13, "THE BUTTON"
  C = Rank * 3
  ShowScreen
  Mj = 0
  WasBtn = 16
  Waited = 0
ei_loop:
  for Li = 0 to 2
    T = C + Li
    put char TopN[T] at 14 + Li,17
    K = 32
    if Li = Mj then K = 94
    put char K at 14 + Li,19
  next
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then goto ei_end
  T = C + Mj
  V = Edge & 1
  if V > 0 then
    inc TopN[T]
    if TopN[T] > 90 then TopN[T] = 65
    play sound SndClick
  end if
  V = Edge & 2
  if V > 0 then
    dec TopN[T]
    if TopN[T] < 65 then TopN[T] = 90
    play sound SndClick
  end if
  V = Edge & 4
  if V > 0 then
    if Mj > 0 then dec Mj
  end if
  V = Edge & 8
  if V > 0 then
    if Mj < 2 then inc Mj
  end if
  if Press = 0 then goto ei_loop
ei_end:
  return
end sub

' ===========================================================================
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  if State = StPlay then
    if Redraw = 1 then
      V = Tick & 1
      if V = 1 then RedrawStep
    end if
  end if
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right)
' plus 16 = button held; Edge = directions newly pressed, Press = button
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V
  K = V & 15
  T = WasJ ^ 15
  Edge = K & T
  WasJ = K
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  sprites flicker off
  for J = 0 to 11
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' title/page screens: standard tables, BIOS font, title tiles from 128
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  TitleMode
  load default ascii
  duplicate mode 2 patterns
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: colour bars as on the C64 ($808B), the logo, the menu and the
' C64's scrolling message; the tune once
sub TitlePage:
  NewScreen
  State = StTitle
  BarK = 0
  DrawBars
  DrawLogo
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  Menu = 0
  ShowMenu
  ScrP = 0
  ScrT = 0
  Scroller
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
  BarT = 0
tp_loop:
  Frame1
  Rand
  ReadPad
  ' the bars change colour every 24 frames (C64: every 10)
  inc BarT
  if BarT >= 24 then
    BarT = 0
    inc BarK
    if BarK >= 12 then BarK = 0
    BarColours
  end if
  ' the message moves one character every 8 frames
  inc ScrT
  if ScrT >= 120 then
    ScrT = 0
    Scroller
  end if
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' four colour bars above and four below the menu, as the C64's raster bars
sub DrawBars:
  for Li = 0 to 3
    T = TBar0 + Li
    C = Li + 1
    fill T count 32 at 0,C
    T = TBar3 - Li
    C = 19 + Li
    fill T count 32 at 0,C
  next
  BarColours
  return
end sub

' bar tile k takes C64 colour BarCols[(BarK + k) mod 12]
sub BarColours:
  for Li = 0 to 3
    K = BarK + Li
    if K >= 12 then K -= 12
    K = BarCols[K]
    C = C64Tms[K]
    C = C << 4
    C = C | 1
    T = Li << 3
    A16 = TBar0
    A16 = A16 << 3
    A16 += T
    fill C count 8 to vram.color + A16
  next
  return
end sub

' the C64 scroller's message, phrase by phrase on row 18 (no word is cut
' at the safe-area edge; the C64 scrolls it one pixel a frame)
sub Scroller:
  W16 = ScrP
  W16 = W16 * 28
  for Li = 0 to 27
    V = Phrases[W16]
    put char V at Li + 2,18
    W16 += 1
  next
  inc ScrP
  if ScrP >= NPhrase then ScrP = 0
  return
end sub

' GRAVITRON in quarter-block letters (rows 6-9)
sub DrawLogo:
  for Li = 0 to 3
    for Mj = 0 to 26
      T = Li * 27
      T += Mj
      V = LogoMap[T]
      put char V at Mj + 2,Li + 6
    next
  next
  ' each pixel row of the logo in the C64 bar colours
  for Li = 0 to 15
    T = TQ0 + Li
    A16 = T
    A16 = A16 << 3
    copy LogoCol count 8 to vram.color + A16
  next
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  State = StCredits
  print at 11,2, "GRAVITRON"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

sub HowTo:
  Page = 1
  NewScreen
  State = StHow
  print at 8,1, "HOW TO PLAY  1/3"
  set sprite 0 to 39,40,SShip3,15
  set sprite 1 to 55,40,SShip3,1
  set sprite 2 to 39,72,SShip3,2
  set sprite 3 to 55,72,SShip3,1
  update sprites
  TxT = TxtHow1
  TxX0 = 2
  TxY = 9
  TxGap = 2
  TextShow
  print at 8,22, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    set sprite 0 to 31,40,SSauA,7
    set sprite 1 to 31,40,SSauB,1
    set sprite 2 to 31,104,SDepA,15
    set sprite 3 to 31,104,SDepB,4
    update sprites
    TxT = TxtHow2
    TxX0 = 2
    TxY = 8
    TxGap = 2
    TextShow
    print at 8,22, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    set sprite 0 to 31,40,SOrbA,8
    set sprite 1 to 31,40,SOrbB,14
    set sprite 2 to 31,104,SRingA,15
    set sprite 3 to 31,104,SRingB,14
    update sprites
    TxT = TxtHow3
    TxX0 = 2
    TxY = 8
    TxGap = 2
    TextShow
    print at 8,22, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

