' --- the C64 sprites: X (9 bits), Y, as the VIC registers
u16 SX[8]
u8 SY[8]
u8 Ena = 0            ' $D015
u8 Col = 0            ' $9968 (collisions read this pass, as $D01E)
u8 ShipCol = 1        ' $D027: 5 low (green), 1 high (white)
u8 Crash = 0          ' $9967
u8 Dir = 1            ' $7BF8 heading 1-16
' --- motion
u8 XvDir = 0          ' $9984
u8 XvDel = 0          ' $9985
u8 XvCnt = 0          ' $9986
