cartridge "BINGO 64/R. WITKOVER, COMPUTE!/1984"

' BINGO 64
' Richard L. Witkover's BINGO 64 (COMPUTE!'s Gazette, April 1984, for the
' Commodore 64), for the ColecoVision in Amy by Amy Bienvenu. Ported by
' Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: the listing on the Gazette disk of April 1984 (orig/bingo.64.bas),
' retyped by a reader in January 1989 (its REM carries the typist's dates).
'
' The game (as the listing has it): four bingo cards (players), each column
' B I N G O holds five different numbers of its fifteen (1-15, 16-30, ...),
' the centre is a free box covered from the start. A ball is called: a
' letter ball is tossed at random height; if it fails to clear the pass
' line it drops back (a plop) and another letter is tossed. When one
' clears, a number of that letter not yet called is shown on the big ball.
' A chime rings for each card that holds it, a gong if no card does. A card
' wins with five covered boxes in a row, column or diagonal; the winning
' line lights up and the bingo fanfare plays; the other cards still get
' that ball. Four modes, as the original's menu:
'   1 auto ball feed,   auto cover      3 manual ball feed, manual cover
'   2 manual ball feed, auto cover      4 auto ball feed,   manual cover
' Manual cover: for each card that holds the number, a cursor appears on
' that card's free box; move it to the number and press the button. A
' press on another box rings the gong and that card misses the number.
'
' The title menu also has HOW TO PLAY (three pages) and CREDITS; its
' cursor is back on mode 1 each time the title appears.
' Controls (either joystick): stick moves the menu and the cursor, either
' button chooses, feeds the next ball (manual feed) and covers. Keypad not
' used.
'
' Liberties taken:
' - Manual cover: a time limit of 8 seconds per card (a yellow bar), then
'   the number is missed as if pressed on a wrong box (the original waited
'   for ever). A PLAYERS choice (1-4) on the title: cards 1..N are played
'   by people (passing the controller), the others cover themselves as in
'   auto cover. The original made all four cards manual.
' - A letter whose fifteen numbers have all been called is never tossed
'   (the original would loop for ever at line 1140). If all 75 balls are
'   called without a bingo (possible when people miss numbers), the game
'   ends with NO BINGO.
' - Line 2520's second test (B1=N1+128) is a typo for N2+128 in the retyped
'   listing; it only mattered for reversed characters and is not needed
'   here (a box is judged by its number).
' - The original's win test reads screen codes of the line through the
'   covered box; here the card is judged from its numbers and covers (all
'   twelve lines), the same result.
' - Card layout on a 28-column screen: two-character boxes in alternating
'   cream and pale yellow, red tokens, the winning line in magenta. The
'   pass line and the toss are in a chute between the cards; the letter
'   balls wait in a rack and glide to the launch pad; the call is shown on
'   a big white ball. Sounds are new (chime, gong, plop, fanfare), the
'   original's end song is replaced by an original fanfare, and the title
'   tune "Lucky Card Polka" is original.
' - After a bingo: the message, then any button (or 30 seconds' sleep and
'   a press) returns to the title instead of RUN again.
' House rules kept: text in columns 2-29, rows 1-22; tiles from 128; the
' title tune plays once; a credits page; screens drawn with the NMI off.

const TAblank = 128
const TA0 = 129
const TA1 = 130
const TA2 = 131
const TA3 = 132
const TA4 = 133
const TA5 = 134
const TA6 = 135
const TA7 = 136
const TA8 = 137
const TA9 = 138
const TBblank = 139
const TB0 = 140
const TB1 = 141
const TB2 = 142
const TB3 = 143
const TB4 = 144
const TB5 = 145
const TB6 = 146
const TB7 = 147
const TB8 = 148
const TB9 = 149
const TCblank = 150
const TC0 = 151
const TC1 = 152
const TC2 = 153
const TC3 = 154
const TC4 = 155
const TC5 = 156
const TC6 = 157
const TC7 = 158
const TC8 = 159
const TC9 = 160
const TDblank = 161
const TD0 = 162
const TD1 = 163
const TD2 = 164
const TD3 = 165
const TD4 = 166
const TD5 = 167
const TD6 = 168
const TD7 = 169
const TD8 = 170
const TD9 = 171
const TCfreel = 172
const TCfreer = 173
const TDfreel = 174
const TDfreer = 175
const THbl = 176
const THbr = 177
const THil = 178
const THir = 179
const THnl = 180
const THnr = 181
const THgl = 182
const THgr = 183
const THol = 184
const THor = 185
const TFelt = 186
const TFrl = 187
const TFrr = 188
const TFrt = 189
const TFrb = 190
const TFrtl = 191
const TFrtr = 192
const TFrbl = 193
const TFrbr = 194
const TPass = 195
const TRb00 = 196
const TRb01 = 197
const TRb10 = 198
const TRb11 = 199
const TRi00 = 200
const TRi01 = 201
const TRi10 = 202
const TRi11 = 203
const TRn00 = 204
const TRn01 = 205
const TRn10 = 206
const TRn11 = 207
const TRg00 = 208
const TRg01 = 209
const TRg10 = 210
const TRg11 = 211
const TRo00 = 212
const TRo01 = 213
const TRo10 = 214
const TRo11 = 215
const TRhole00 = 216
const TRhole01 = 217
const TRhole10 = 218
const TRhole11 = 219
const TBbt0 = 220
const TBbb0 = 221
const TBbt1 = 222
const TBbb1 = 223
const TBbt2 = 224
const TBbb2 = 225
const TBbt3 = 226
const TBbb3 = 227
const TBbt4 = 228
const TBbb4 = 229
const TBbl = 230
const TBbr = 231
const TBlb = 232
const TBli = 233
const TBln = 234
const TBlg = 235
const TBlo = 236
const TBar = 237
const SBallb = 0
const SLetb = 4
const SBalli = 8
const SLeti = 12
const SBalln = 16
const SLetn = 20
const SBallg = 24
const SLetg = 28
const SBallo = 32
const SLeto = 36
const SCursor = 40
const NTiles8 = 880
const SprBytes = 352
const SndTuneA = 1
const SndTuneB = 2
const SndToss = 3
const SndPlop = 4
const SndOver = 5
const SndChime = 6
const SndGong = 7
const SndStep = 8
const SndBingo = 9
const SndNoWin = 10

const TimeLimit = 480
const BarLen = 16

' the toss: the ball's sprite position, its letter, the height YM of the
' listing (5-12), the step J (0 .. 2 YM)
record Toss:
  i16 Y
  i16 X
  u8 Letter
  u8 Ym
  u8 J
end record

Toss Tb

' the cards: Num[card * 25 + column * 5 + row] (0 for the free box),
' Cov 1 when covered, Win 1 when in a winning line
u8 Num[100]
u8 Cov[100]
u8 Win[100]
' Called[letter * 15 + n - 1], numbers left of each letter
u8 Called[75]
u8 Left[5]

data CardCol bytes 3,19,3,19
data CardRow bytes 3,3,12,12
data FrameRow bytes 1,1,10,10

u8 Au = 0
u8 Players = 1
u8 NC = 0
u8 NU = 0
u8 NM = 0
u8 NBall = 0
bcd digits 2 Balls
u8 Bo = 0
u8 Winners = 0
u8 WinCard = 0
u8 Matched = 0
u8 TurnCd = 0
u8 Cc = 0
u8 Cr = 0
u8 Hit = 0
u16 Tm = 0
u8 Ask = 0
u8 Idle = 0
u16 Seed = 0
u8 Fed = 0

u16 Rs = $5A3C
u16 Rw = 0
u16 Rt = 0
u8 Tick = 0
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 1
u8 Press = 0
u8 WasStick = 0
u8 TzOn = 0
u16 TzLeft = 0
u8 J = 0
u8 K = 0
u8 X = 0
u8 Y = 0
u16 NumU = 0
i16 Sx = 0
i16 Sy = 0

  tile screen
  set sound table BgSoundTable areas 4
  sprites 16x16
  set sprite count 3
  sprites stable 0 to 2
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  CreditsPage

title:
  TitlePage
  if Au = 4 then
    HowToPage
    goto title
  end if
  if Au = 5 then
    CreditsPage
    goto title
  end if
  NewGame

ball_loop:
  if Au = 1 then FeedWait
  if Au = 2 then FeedWait
  NextBall
  CheckCards
  if Bo = 1 then goto the_end
  if NBall = 75 then goto the_end
  if Au = 0 then Pause(45)
  if Au = 3 then Pause(45)
  goto ball_loop

' the end: a message, then back to the title on a press
the_end:
  HideSprites
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,22
  if Bo = 1 then
    play sound SndBingo
    if Winners = 1 then
      print at 3,18, "BINGO!"
      CardName(WinCard, 10, 18)
      print at 19,18, "WINS"
    else
      print at 3,18, "BINGO! "
      NumU = Winners
      print at 10,18, digits$(NumU, 1)
      print at 12,18, "CARDS TIE"
    end if
    print at 3,22, "IN"
    print at 6,22, Balls
    print at 9,22, "BALLS"
  else
    play sound SndNoWin
    print at 3,18, "ALL 75 BALLS CALLED:"
    print at 3,22, "NO BINGO THIS TIME"
  end if
  Ask = 9
  Pause(90)
  Rearm
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ask = 0
  goto title

' ---------------------------------------------------------------------------
' a new game: the cards (840-1080), the free boxes, the called numbers

sub NewGame:
  NewScreen
  for K = 0 to 74
    Called[K] = 0
  next
  for K = 0 to 4
    Left[K] = 15
  next
  for K = 0 to 99
    Cov[K] = 0
    Win[K] = 0
  next
  MakeCards
  for K = 0 to 3
    DrawCard(K)
  next
  ' the chute and its pass line (570)
  for K = 14 to 17
    put char TPass at K,9
  next
  for K = 0 to 4
    DrawRack(K, 1)
  next
  NBall = 0
  Balls = 0
  Bo = 0
  Winners = 0
  DrawBig(0)
  print at 22,19, "BALLS"
  print at 25,20, Balls
  print at 22,21, "MODE"
  NumU = Au + 1
  print at 27,21, digits$(NumU, 1)
  ShowScreen
  Ask = 3
  return
end sub

sub MakeCards:
  u8 Cd = 0
  u8 Cl = 0
  u8 Rn = 0
  u8 Z = 0
  u8 Q = 0
  u8 Bad = 0
  u8 B = 0
  for Cd = 0 to 3
    for Cl = 0 to 4
      B = Cd * 25 + Cl * 5
      for Rn = 0 to 4
        ' 910-950: a number of this column not yet on it
        Bad = 1
        while Bad = 1
          Z = Rk(15) + 1 + Cl * 15
          Bad = 0
          for Q = 0 to 4
            if Q < Rn then
              if Num[B + Q] = Z then Bad = 1
            end if
          next
        end while
        Num[B + Rn] = Z
      next
    next
    ' 550: the centre is the free box, covered from the start
    Num[Cd * 25 + 12] = 0
    Cov[Cd * 25 + 12] = 1
  next
  return
end sub

' who plays a card: a person in manual cover for cards 1..Players
function IsHuman(u8 Cd) as u8
  u8 R = 0
  if Au >= 2 then
    if Cd < Players then R = 1
  end if
  return R

sub CardName(u8 Cd, u8 Cx, u8 Cy):
  NumU = Cd + 1
  if IsHuman(Cd) = 1 then
    print at Cx,Cy, "PLAYER "
    print at Cx + 7,Cy, digits$(NumU, 1)
  else
    if Au >= 2 then
      print at Cx,Cy, "COMPUTER"
    else
      print at Cx,Cy, "CARD "
      print at Cx + 5,Cy, digits$(NumU, 1)
    end if
  end if
  return
end sub

' 640-830: the card's frame, header and boxes
sub DrawCard(u8 Cd):
  u8 Fc = 0
  u8 Fr = 0
  u8 C = 0
  u8 R = 0
  Fc = CardCol[Cd] - 1
  Fr = FrameRow[Cd]
  put char TFrtl at Fc,Fr
  fill TFrt count 10 at Fc + 1,Fr
  put char TFrtr at Fc + 11,Fr
  for R = 1 to 6
    put char TFrl at Fc,Fr + R
    put char TFrr at Fc + 11,Fr + R
  next
  put char TFrbl at Fc,Fr + 7
  fill TFrb count 10 at Fc + 1,Fr + 7
  put char TFrbr at Fc + 11,Fr + 7
  for C = 0 to 4
    put char THbl + C * 2 at Fc + 1 + C * 2,Fr + 1
    put char THbr + C * 2 at Fc + 2 + C * 2,Fr + 1
    for R = 0 to 4
      DrawCell(Cd, C, R)
    next
  next
  CardName(Cd, Fc + 2, Fr)
  return
end sub

' one box: its look (cream / pale yellow, red token, winning magenta)
sub DrawCell(u8 Cd, u8 C, u8 R):
  u8 I = 0
  u8 Base = 0
  u8 N = 0
  u8 Tx = 0
  u8 Ty = 0
  I = Cd * 25 + C * 5 + R
  Tx = CardCol[Cd] + C * 2
  Ty = CardRow[Cd] + R
  select case (Win[I], Cov[I])
  case (1, 0 to 1)
    Base = TDblank
  case (0, 1)
    Base = TCblank
  case else
    Base = TAblank
    if (C & 1) = 1 then Base = TBblank
  end select
  N = Num[I]
  if N = 0 then
    if Base = TDblank then
      put char TDfreel at Tx,Ty
      put char TDfreer at Tx + 1,Ty
    else
      put char TCfreel at Tx,Ty
      put char TCfreer at Tx + 1,Ty
    end if
  else
    if N < 10 then
      put char Base at Tx,Ty
    else
      put char Base + 1 + N / 10 at Tx,Ty
    end if
    put char Base + 1 + N % 10 at Tx + 1,Ty
  end if
  return
end sub

' the rack: ball K there (On 1) or its empty slot
sub DrawRack(u8 Kb, u8 Shown):
  u8 T = 0
  u8 Tx = 0
  T = TRhole00
  if Shown = 1 then T = TRb00 + Kb * 4
  Tx = 3 + Kb * 2
  put char T at Tx,20
  put char T + 1 at Tx + 1,20
  put char T + 2 at Tx,21
  put char T + 3 at Tx + 1,21
  return
end sub

' 1170-1210: the big ball (Vis 0: blank)
sub DrawBig(u8 Vis):
  u8 C = 0
  for C = 0 to 4
    put char TBbt0 + C * 2 at 15 + C,19
    put char TBbb0 + C * 2 at 15 + C,21
  next
  put char TBbl at 15,20
  put char TBbr at 19,20
  if Vis = 0 then
    put char TAblank at 16,20
    put char TAblank at 17,20
    put char TAblank at 18,20
  else
    put char TBlb + NC at 16,20
    if NM < 10 then
      put char TAblank at 17,20
    else
      put char TA0 + NM / 10 at 17,20
    end if
    put char TA0 + NM % 10 at 18,20
  end if
  return
end sub

' ---------------------------------------------------------------------------
' 1100-1160, 1730-1810: the next ball

sub NextBall:
  Fed = 0
  while Fed = 0
    ' 1730: the letter (one with numbers left), 1740: the height
    NC = Rk(5)
    while Left[NC] = 0
      NC = Rk(5)
    end while
    Tb.Letter = NC
    Tb.Ym = Rk(13)
    if Tb.Ym < 5 then Tb.Ym = 5
    TossBall
    if Tb.Ym >= 10 then Fed = 1
  end while
  ' 1120-1150: a number of that letter not called yet
  NU = Rk(15)
  K = NC * 15
  while Called[K + NU] = 1
    NU = Rk(15)
  end while
  Called[K + NU] = 1
  dec Left[NC]
  NM = NU + 1 + K
  inc NBall
  inc Balls
  DrawBig(1)
  print at 25,20, Balls
  return
end sub

' the toss: glide from the rack to the pad, up (and over the pass line,
' or back down: the plop), the ball back in the rack
sub TossBall:
  u8 F = 0
  i16 Rx = 0
  i16 D = 0
  Rx = 24 + Tb.Letter * 16
  DrawRack(Tb.Letter, 0)
  for F = 1 to 12
    Tb.X = Rx + ((120 - Rx) * F) / 12
    Tb.Y = 159 - (32 * F) / 12
    BallSprite
    Frame1
  next
  play sound SndToss
  Tb.J = 0
  while Tb.J <= Tb.Ym * 2
    ' 1760: Y = J^2 - 2 YM J + 230, here half the height above the pad
    D = Tb.J
    D = D - Tb.Ym
    Tb.Y = 127 - (Tb.Ym * Tb.Ym - D * D) / 2
    BallSprite
    Frame1
    Frame1
    if Tb.Ym >= 10 then
      if Tb.J = Tb.Ym then Tb.J = 100
    end if
    inc Tb.J
  end while
  if Tb.Ym >= 10 then
    play sound SndOver
    Tb.Y = 192
    BallSprite
  else
    play sound SndPlop
    Pause(10)
    for F = 1 to 8
      Tb.X = 120 + ((Rx - 120) * F) / 8
      Tb.Y = 127 + (32 * F) / 8
      BallSprite
      Frame1
    next
    Tb.Y = 192
    BallSprite
  end if
  DrawRack(Tb.Letter, 1)
  return
end sub

sub BallSprite:
  X = Tb.X
  Y = Tb.Y
  K = Tb.Letter * 8
  if Tb.Y >= 192 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  else
    set sprite 0 to Y,X,K + 4,15
    set sprite 1 to Y,X,K,BallColour(Tb.Letter)
  end if
  update sprites
  return
end sub

function BallColour(u8 L) as u8
  u8 C = 5
  select case L
  case 1
    C = 13
  case 2
    C = 8
  case 3
    C = 2
  case 4
    C = 10
  end select
  return C

' ---------------------------------------------------------------------------
' 1220-1410: the number on the cards (chime), or on none (gong)

sub CheckCards:
  u8 Cd = 0
  u8 R = 0
  u8 I = 0
  Matched = 0
  for Cd = 0 to 3
    for R = 0 to 4
      I = Cd * 25 + NC * 5 + R
      if Num[I] = NM then
        Matched = 1
        TurnCd = Cd
        if IsHuman(Cd) = 1 then
          CoverTurn
        else
          Hit = 1
          Cc = NC
          Cr = R
          play sound SndChime
          Pause(20)
        end if
        if Hit = 1 then CoverBox
      end if
    next
  next
  if Matched = 0 then
    play sound SndGong
    Pause(30)
  end if
  return
end sub

' 1300-1370 and 2000-2260: the token, then the look for a winner
sub CoverBox:
  u8 I = 0
  u8 L = 0
  I = TurnCd * 25 + Cc * 5 + Cr
  Cov[I] = 1
  DrawCell(TurnCd, Cc, Cr)
  L = CheckWin(TurnCd)
  if L > 0 then
    if Bo = 0 then WinCard = TurnCd
    inc Winners
    Bo = 1
    for Cc = 0 to 4
      for Cr = 0 to 4
        DrawCell(TurnCd, Cc, Cr)
      next
    next
    play sound SndBingo
    Pause(60)
  end if
  return
end sub

' the card's complete lines (rows, columns, two diagonals): marks them in
' Win and returns how many; a card counts once
function CheckWin(u8 Cd) as u8
  u8 B = 0
  u8 N = 0
  u8 A = 0
  u8 Q = 0
  u8 Ln = 0
  u8 All = 0
  B = Cd * 25
  ' a card already won counts no more
  for Q = 0 to 24
    if Win[B + Q] = 1 then All = 1
  next
  if All = 0 then
    for Ln = 0 to 11
      All = 1
      for Q = 0 to 4
        A = LineCell(Ln, Q)
        if Cov[B + A] = 0 then All = 0
      next
      if All = 1 then
        inc N
        for Q = 0 to 4
          A = LineCell(Ln, Q)
          Win[B + A] = 1
        next
      end if
    next
  end if
  return N

' box Q of line Ln: 0-4 the rows, 5-9 the columns, 10 and 11 the diagonals
function LineCell(u8 Ln, u8 Q) as u8
  u8 A = 0
  if Ln < 5 then
    A = Q * 5 + Ln
  else
    if Ln < 10 then
      A = (Ln - 5) * 5 + Q
    else
      if Ln = 10 then
        A = Q * 6
      else
        A = Q * 5 + 4 - Q
      end if
    end if
  end if
  return A

' ---------------------------------------------------------------------------
' 2270-2600: a person covers: the cursor on the free box, 8 seconds

sub CoverTurn:
  u8 Mv = 0
  u8 Hold = 0
  u8 Done = 0
  u8 Nx = 0
  u8 Ny = 0
  i16 Tx = 0
  i16 Ty = 0
  Cc = 2
  Cr = 2
  Hit = 0
  Tm = TimeLimit
  fill 32 count 28 at 2,18
  CardName(TurnCd, 3, 18)
  print at 12,18, "COVER"
  put char TBlb + NC at 18,18
  NumU = NM
  print at 19,18, digits$(NumU, 2)
  DrawBar
  Sx = CardCol[TurnCd] * 8
  Sy = CardRow[TurnCd] * 8
  Sx = Sx + Cc * 16
  Sy = Sy + Cr * 8 - 2
  Tx = Sx
  Ty = Sy
  CursorSprite
  Ask = 4
  WasBtn = 1
  while Done = 0
    Frame1
    ReadPad
    ' glide toward the box
    if Sx < Tx then Sx = Sx + 4
    if Sx > Tx then Sx = Sx - 4
    if Sy < Ty then Sy = Sy + 2
    if Sy > Ty then Sy = Sy - 2
    CursorSprite
    if Mv > 0 then dec Mv
    if Hold > 0 then dec Hold
    if (Pad & 15) = 0 then Hold = 0
    if Mv = 0 then
      if Hold = 0 then
        Nx = Cc
        Ny = Cr
        if (Pad & 1) <> 0 then
          if Ny > 0 then dec Ny
        end if
        if (Pad & 2) <> 0 then
          if Ny < 4 then inc Ny
        end if
        if (Pad & 4) <> 0 then
          if Nx > 0 then dec Nx
        end if
        if (Pad & 8) <> 0 then
          if Nx < 4 then inc Nx
        end if
        if Nx <> Cc or Ny <> Cr then
          Cc = Nx
          Cr = Ny
          Tx = CardCol[TurnCd] * 8 + Cc * 16
          Ty = CardRow[TurnCd] * 8 + Cr * 8 - 2
          Mv = 4
          Hold = 10
          play sound SndStep
        end if
      end if
    end if
    if Press = 1 then
      if Mv = 0 then Done = 1
    end if
    dec Tm
    if (Tm % 30) = 0 then DrawBar
    if Tm = 0 then Done = 2
  end while
  Ask = 3
  if Done = 1 then
    if Num[TurnCd * 25 + Cc * 5 + Cr] = NM then
      Hit = 1
      play sound SndChime
    end if
  end if
  if Hit = 0 then play sound SndGong
  Sy = 192
  CursorSprite
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,22
  Pause(20)
  return
end sub

sub CursorSprite:
  if Sy >= 192 then
    set sprite 2 to 192,0,0,0
  else
    X = Sx
    Y = Sy
    set sprite 2 to Y,X,SCursor,1
  end if
  update sprites
  return
end sub

' the time bar: one tile per 30 frames left
sub DrawBar:
  K = (Tm + 29) / 30
  fill 32 count BarLen at 8,22
  if K > 0 then fill TBar count K at 8,22
  return
end sub

' manual ball feed (290 "HIT ANY KEY FOR BALL FEED")
sub FeedWait:
  print at 4,22, "PRESS BUTTON: NEXT BALL"
  Ask = 5
  WasBtn = 1
  Press = 0
  while Press = 0
    Frame1
    ReadPad
  end while
  fill 32 count 28 at 2,22
  Ask = 3
  return
end sub

' ---------------------------------------------------------------------------
' screens, frames, input, random numbers

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub Pause(u8 Nf):
  u8 Q = 0
  for Q = 1 to Nf
    Frame1
  next
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $FC
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' INT(RND(0) * N): 0 .. N-1
function Rk(u8 N) as u8
  u16 V = 0
  Rnd16
  V = Rw >> 8
  V = V * N
  return V >> 8

sub CreditsPage:
  NewScreen
  print at 11,2, "BINGO 64"
  print at 2,5, "BY RICHARD L. WITKOVER,"
  print at 2,6, "COMPUTE!'S GAZETTE,"
  print at 2,7, "APRIL 1984 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: LUCKY CARD POLKA"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Ask = 1
  WasBtn = 1
  Press = 0
  while Press = 0
    Frame1
    ReadPad
  end while
  Ask = 0
  return
end sub

' the title: the original's MODES OF PLAY menu, the players, the tune once
sub TitlePage:
  NewScreen
  for K = 0 to 4
    put char THbl + K * 2 at 9 + K * 2,2
    put char THbr + K * 2 at 10 + K * 2,2
  next
  print at 20,2, "64"
  for K = 0 to 4
    DrawRack(K, 1)
  next
  print at 9,6, "MODES OF PLAY"
  print at 4,8, "1 AUTO BALLS  AUTO COVER"
  print at 4,9, "2 PRESS BALLS AUTO COVER"
  print at 4,10, "3 PRESS BALLS YOU COVER"
  print at 4,11, "4 AUTO BALLS  YOU COVER"
  print at 4,12, "HOW TO PLAY"
  print at 4,13, "CREDITS"
  print at 2,16, "CHIME: A CARD HAS THE NUMBER"
  print at 2,17, "GONG: NO CARD HAS IT"
  print at 2,18, "YOU COVER: MOVE TO IT, PRESS"
  print at 2,19, "THE BUTTON IN 8 SECONDS"
  Au = 0
  print at 2,22, "STICK: CHOOSE  BUTTON: PLAY"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 470
  TzOn = 1
  Ask = 2
  WasBtn = 1
  WasStick = 15
  Press = 0
  while Press = 0
    Frame1
    ReadPad
    inc Rs
    K = Pad & 15
    if K <> 0 then
      if WasStick = 0 then
        if (K & 1) <> 0 then
          if Au > 0 then dec Au
        end if
        if (K & 2) <> 0 then
          if Au < 5 then inc Au
        end if
        if (K & 4) <> 0 then
          if Players > 1 then dec Players
        end if
        if (K & 8) <> 0 then
          if Players < 4 then inc Players
        end if
        play sound SndStep
        ShowMenu
      end if
    end if
    WasStick = K
  end while
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Ask = 0
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $5A3C
  Seed = Rs
  return
end sub

' a box of the HOW TO PLAY pictures: number N (0 the free box) in the
' look Base (TAblank cream, TCblank covered) at Tx,Ty
sub HtBox(u8 N, u8 Base, u8 Tx, u8 Ty):
  if N = 0 then
    put char TCfreel at Tx,Ty
    put char TCfreer at Tx + 1,Ty
  else
    if N < 10 then
      put char Base at Tx,Ty
    else
      put char Base + 1 + N / 10 at Tx,Ty
    end if
    put char Base + 1 + N % 10 at Tx + 1,Ty
  end if
  return
end sub

' the five B I N G O headers at Tx,Ty
sub HtHead(u8 Tx, u8 Ty):
  for K = 0 to 4
    put char THbl + K * 2 at Tx + K * 2,Ty
    put char THbr + K * 2 at Tx + 1 + K * 2,Ty
  next
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "FOUR BINGO CARDS, ONE FOR"
    print at 2,4, "EACH PLAYER. THE COLUMNS"
    print at 2,5, "B I N G O HOLD NUMBERS FROM"
    print at 2,6, "1 TO 75. THE MIDDLE BOX IS"
    print at 2,7, "FREE."
    print at 2,9, "A LETTER BALL IS TOSSED. IF"
    print at 2,10, "IT GOES OVER THE LINE, ITS"
    print at 2,11, "NUMBER IS CALLED. A CHIME:"
    print at 2,12, "A CARD HAS IT. A GONG: NO"
    print at 2,13, "CARD HAS IT."
    HtHead(4, 16)
    HtBox(7, TCblank, 4, 17)
    HtBox(22, TBblank, 6, 17)
    HtBox(0, TAblank, 8, 17)
    HtBox(51, TBblank, 10, 17)
    HtBox(68, TAblank, 12, 17)
    NC = 3
    NM = 51
    DrawBig(1)
    for K = 0 to 4
      DrawRack(K, 1)
    next
  case 2
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "ON THE TITLE, PICK A MODE"
    print at 2,4, "WITH THE JOYSTICK AND PRESS"
    print at 2,5, "A BUTTON. PRESS BALLS: THE"
    print at 2,6, "BUTTON CALLS THE NEXT BALL."
    print at 2,8, "YOU COVER: WHEN YOUR CARD"
    print at 2,9, "HAS THE NUMBER, A HAND SITS"
    print at 2,10, "ON THE FREE BOX. MOVE IT"
    print at 2,11, "ONTO THE NUMBER AND PRESS"
    print at 2,12, "THE BUTTON WITHIN 8 SECONDS."
    print at 2,13, "THE WRONG BOX: YOU MISS IT."
    print at 2,15, "PLAYERS SHARE THE JOYSTICK."
    HtHead(10, 17)
    HtBox(9, TAblank, 10, 18)
    HtBox(17, TBblank, 12, 18)
    HtBox(0, TAblank, 14, 18)
    HtBox(56, TBblank, 16, 18)
    HtBox(70, TAblank, 18, 18)
    set sprite 2 to 141,132,SCursor,1
    update sprites
  case 3
    print at 2,1, "WINNING                3/3"
    print at 2,3, "COVER FIVE BOXES IN A LINE:"
    print at 2,4, "A ROW, A COLUMN OR CORNER"
    print at 2,5, "TO CORNER. BINGO! THAT CARD"
    print at 2,6, "WINS AND THE GAME IS OVER."
    print at 2,8, "IF ALL 75 BALLS ARE CALLED"
    print at 2,9, "WITH NO BINGO, NOBODY WINS."
    print at 2,11, "TIP: WATCH THE BIG BALL AND"
    print at 2,12, "LOOK DOWN THAT LETTER'S"
    print at 2,13, "COLUMN ON YOUR CARD."
    HtHead(10, 16)
    HtBox(4, TDblank, 10, 17)
    HtBox(28, TDblank, 12, 17)
    put char TDfreel at 14,17
    put char TDfreer at 15,17
    HtBox(49, TDblank, 16, 17)
    HtBox(63, TDblank, 18, 17)
    HtBox(11, TAblank, 10, 18)
    HtBox(19, TBblank, 12, 18)
    HtBox(40, TAblank, 14, 18)
    HtBox(55, TBblank, 16, 18)
    HtBox(72, TAblank, 18, 18)
  end select
  print at 9,22, "PRESS A BUTTON"
  ShowScreen
  Ask = 1
  WasBtn = 1
  Press = 0
  Wt = 0
  while Press = 0
    Frame1
    ReadPad
    Wt = Wt + 1
    if Wt >= 1800 then Press = 2
  end while
  Ask = 0
  HideSprites
  if Press = 2 then return
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub ShowMenu:
  for K = 8 to 13
    put char 32 at 2,K
  next
  put char 62 at 2,Au + 8
  if Au >= 2 and Au <= 3 then
    print at 4,14, "PLAYERS: "
    NumU = Players
    print at 13,14, digits$(NumU, 1)
    print at 15,14, "(LEFT/RIGHT)"
  else
    fill 32 count 26 at 4,14
  end if
  return
end sub

