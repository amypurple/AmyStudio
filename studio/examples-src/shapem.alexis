cartridge "SHAPE MATCH/Michael Reich/1984"

' SHAPE MATCH
' From COMPUTE!'s Gazette, June 1984 (one BASIC listing for the Commodore
' 64 and VIC-20; the listing and the disk name no author). ColecoVision
' version in Amy by Claude (an AI made by Anthropic) for Amy Studio, 2026.
' Rules read from the listing (orig/shapematch.bas) and checked by running
' it in jsc64 (orig/c64run-shapem.mjs).
'
' The original: a board of four boxes on the right holds four shapes (a
' red square, a purple plus, a black right triangle, a blue pyramid),
' always in the same places. One of them is drawn on the left, never the
' same one twice in a row. A "?" visits the boxes in turn (about 3.8
' seconds each); the child presses any key when it is beside the shape
' that matches. Right: "YES! THAT'S RIGHT!", press a key, a new round.
' Wrong: "SORRY...TRY AGAIN...", the "?" moves on. No score, no end (Q
' quits).
'
' Controls: the joystick moves the pointer from box to box (either
' controller), a side button picks the box. A button starts from the
' title and goes on after each round.
'
' Liberties taken:
' - The pointer is moved with the joystick instead of visiting the boxes
'   by itself (house rule: joystick, no keyboard). It starts in the top
'   left box, where the C64's "?" started.
' - A score and an end (the original had neither): ten rounds; a match on
'   the first try earns a gold star, a later one a grey star. 8 gold stars
'   or more wins ("SHAPE MASTER!"); any other result is praised and asks
'   for 8 next time. Guessing finds the shape on the first try one time in
'   four, so guessing or trying the boxes in order does not win.
' - Six shapes instead of four (a green circle and a yellow star added);
'   each round puts four of them in the boxes in a new order, so the
'   places cannot be learnt by heart. The target is still never the same
'   shape twice in a row (the listing's K <> KK).
' - From round 6 ("TRICKY" rounds) all four shapes are drawn in one
'   colour, so only the shape can be matched, not the colour.
' - A wrongly picked shape turns grey and can't be picked again (the C64
'   let it be picked again).
' - Shapes are 32 x 32 pixels and appear one at a time with a pop, as the
'   C64 drew them one at a time with a pause; the target comes last.
' - Added: a title page, a credits page, sounds, the title tune "Corners
'   and Curves" (newly composed) and the star row.
'
' House rules kept: joystick only, everything in columns 2-29 and rows
' 1-22, nothing flashes faster than 3 Hz, screens drawn with the NMI off.

const TSquare00 = 128
const TSquare01 = 129
const TSquare02 = 130
const TSquare03 = 131
const TSquare10 = 132
const TSquare11 = 133
const TSquare12 = 134
const TSquare13 = 135
const TSquare20 = 136
const TSquare21 = 137
const TSquare22 = 138
const TSquare23 = 139
const TSquare30 = 140
const TSquare31 = 141
const TSquare32 = 142
const TSquare33 = 143
const TPlus00 = 144
const TPlus01 = 145
const TPlus02 = 146
const TPlus03 = 147
const TPlus10 = 148
const TPlus11 = 149
const TPlus12 = 150
const TPlus13 = 151
const TPlus20 = 152
const TPlus21 = 153
const TPlus22 = 154
const TPlus23 = 155
const TPlus30 = 156
const TPlus31 = 157
const TPlus32 = 158
const TPlus33 = 159
const TRamp00 = 160
const TRamp01 = 161
const TRamp02 = 162
const TRamp03 = 163
const TRamp10 = 164
const TRamp11 = 165
const TRamp12 = 166
const TRamp13 = 167
const TRamp20 = 168
const TRamp21 = 169
const TRamp22 = 170
const TRamp23 = 171
const TRamp30 = 172
const TRamp31 = 173
const TRamp32 = 174
const TRamp33 = 175
const TPyramid00 = 176
const TPyramid01 = 177
const TPyramid02 = 178
const TPyramid03 = 179
const TPyramid10 = 180
const TPyramid11 = 181
const TPyramid12 = 182
const TPyramid13 = 183
const TPyramid20 = 184
const TPyramid21 = 185
const TPyramid22 = 186
const TPyramid23 = 187
const TPyramid30 = 188
const TPyramid31 = 189
const TPyramid32 = 190
const TPyramid33 = 191
const TCircle00 = 192
const TCircle01 = 193
const TCircle02 = 194
const TCircle03 = 195
const TCircle10 = 196
const TCircle11 = 197
const TCircle12 = 198
const TCircle13 = 199
const TCircle20 = 200
const TCircle21 = 201
const TCircle22 = 202
const TCircle23 = 203
const TCircle30 = 204
const TCircle31 = 205
const TCircle32 = 206
const TCircle33 = 207
const TStar00 = 208
const TStar01 = 209
const TStar02 = 210
const TStar03 = 211
const TStar10 = 212
const TStar11 = 213
const TStar12 = 214
const TStar13 = 215
const TStar20 = 216
const TStar21 = 217
const TStar22 = 218
const TStar23 = 219
const TStar30 = 220
const TStar31 = 221
const TStar32 = 222
const TStar33 = 223
const TH = 224
const TV = 225
const TTl = 226
const TTr = 227
const TBl = 228
const TBr = 229
const TTt = 230
const TBt = 231
const TLt = 232
const TRt = 233
const TX = 234
const TGold00 = 235
const TGold01 = 236
const TGold10 = 237
const TGold11 = 238
const TGrey00 = 239
const TGrey01 = 240
const TGrey10 = 241
const TGrey11 = 242
const TDot00 = 243
const TDot01 = 244
const TDot10 = 245
const TDot11 = 246
const TLr = 247
const TLb = 248
const TLg = 249
const TLm = 250
const TLy = 251
const SArrowout = 0
const SArrowin = 4
const NTiles8 = 992
const SprBytes = 64
const LogoX = 6
const LogoW = 19
data ShapeCol bytes
  8,13,1,4,12,10
end data
const SndTuneA = 1
const SndTuneB = 2
const SndPop = 3
const SndMove = 4
const SndYes = 5
const SndNo = 6
const SndNope = 7
const SndWin = 8
const SndDone = 9

const Rounds = 10
const EasyRounds = 5
const WinStars = 8
const NShapes = 6
const GreyCol = 14
const BoardX = 13
const BoardY = 3
const TgtX = 5
const TgtY = 9
const StarX = 9
const StarY = 19

record Card:
  u8 Shape
  u8 Col
  u8 Gone
end record

' the four boxes: 0 top left, 1 top right, 2 bottom left, 3 bottom right
Card Boxes[4]
u8 Bag[6]
' the score row: 0 not played, 1 gold star, 2 grey star
u8 Slot[10]
u8 Buf[128]
u8 Target = 255
u8 Prev = 255
u8 TBox = 0
u8 Round = 0
u8 Gold = 0
bcd digits 2 GoldShown
u8 Tries = 0
u8 Cur = 0
u8 Picked = 0
u8 Result = 0
u8 Tricky = 0
u8 OneCol = 0
' pointer sprite: where it is and where it glides to (pixels)
u8 Ax = 0
u8 Ay = 0
u8 Gx = 0
u8 Gy = 0
' for the test bot: 7 credits, 8 title, 2 dealing, 1 waiting for a pick,
' 3 found (cheering), 4 waiting for the button after a find, 6 game over
u8 Ph = 0
u8 Menu = 0
u8 Pg = 0
u16 Wt = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u16 Ofs = 0
u16 Moves = 0
u16 NumBig = 0
u8 I = 0
u8 J = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

  ' the credits page (once, after the console's logo)
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  ' the press time stirs the BIOS random numbers
  V = Tick & 31
  for I = 0 to V
    J = random(6)
  next

  NewGame
  DrawPlay
  for Round = 1 to Rounds
    PlayRound
  next
  goto game_over

sub CreditsPage:
  Ph = 7
  TextScreen
  DrawLogo(2)
  print at 4,14, "FROM COMPUTE!'S GAZETTE"
  print at 3,15, "JUNE 1984, FOR THE C-64 AND"
  print at 3,16, "VIC-20 (NO AUTHOR NAMED)"
  print at 3,18, "COLECOVISION VERSION BY"
  print at 3,19, "CLAUDE (AN AI MADE BY"
  print at 3,20, "ANTHROPIC) FOR AMY STUDIO"
  print at 3,21, "2026. MUSIC: CORNERS AND"
  print at 3,22, "CURVES (NEW)."
  ShowScreen
  WaitPress
  return
end sub

' the title: the logo, four shapes, the menu (START, HOW TO PLAY,
' CREDITS); the cursor starts on START every time
sub TitlePage:
  Ph = 8
  Menu = 0
  TextScreen
  DrawLogo(1)
  for I = 0 to 3
    SetShapeCol(I, ShapeCol[I])
    X = I * 6
    X = X + 5
    DrawShape(I, X, 12)
  next
  print at 3,17, "FIND THE SHAPE THAT MATCHES"
  print at 11,19, "START"
  print at 11,20, "HOW TO PLAY"
  print at 11,21, "CREDITS"
  ShowMenu
  ShowScreen
  play song SmSong once
  WasBtn = 1
  WasStick = 1
tp_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      end if
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = Stick
  if Press = 0 then goto tp_loop
  mute all
  return
end sub

sub ShowMenu:
  for Y = 19 to 21
    put char 32 at 9,Y
  next
  Y = Menu + 19
  put char 62 at 9,Y
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  TextScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "A SHAPE IS SHOWN ON THE"
    print at 2,4, "LEFT. FIND THE SAME SHAPE"
    print at 2,5, "IN ONE OF THE FOUR BOXES"
    print at 2,6, "ON THE RIGHT."
    print at 2,8, "THERE ARE 10 ROUNDS."
    SetShapeCol(3, 4)
    SetShapeCol(1, 13)
    DrawShape(3, 5, 11)
    DrawShape(1, 14, 11)
    DrawShape(3, 22, 11)
    set sprite 0 to 95,160,SArrowout,1
    set sprite 1 to 95,160,SArrowin,11
    print at 2,17, "THE ARROW POINTS AT A BOX."
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: MOVE THE ARROW FROM"
    print at 2,4, "BOX TO BOX."
    print at 2,5, "BUTTON: PICK THAT BOX."
    print at 2,7, "RIGHT ON THE FIRST TRY:"
    print at 2,8, "A GOLD STAR. RIGHT LATER:"
    print at 2,9, "A GREY STAR. A WRONG SHAPE"
    print at 2,10, "TURNS GREY. TRY AGAIN!"
    print at 2,12, "8 GOLD STARS OR MORE WIN!"
    for I = 0 to 9
      Slot[I] = 0
    next
    Slot[0] = 1
    Slot[1] = 1
    Slot[2] = 2
    Slot[3] = 1
    print at 2,StarY, "STARS"
    for I = 0 to 9
      DrawStar(I)
    next
  case 3
    print at 2,1, "TIPS                    3/3"
    print at 2,3, "FROM ROUND 6 THE ROUNDS ARE"
    print at 2,4, "TRICKY: ALL THE SHAPES HAVE"
    print at 2,5, "ONE COLOUR. LOOK AT THE"
    print at 2,6, "CORNERS AND CURVES!"
    for I = 2 to 5
      SetShapeCol(I, 1)
      X = I - 2
      X = X * 6
      X = X + 5
      DrawShape(I, X, 9)
    next
    print at 2,15, "THE GAME ENDS AFTER ROUND"
    print at 2,16, "10. COUNT YOUR GOLD STARS!"
    print at 2,18, "TIP: GUESSING WILL NOT WIN."
    print at 2,19, "LOOK CAREFULLY FIRST."
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

game_over:
  Ph = 6
  HideSprites
  Rearm
  wait
  nmi off
  for Y = 21 to 22
    fill 32 count 28 at 2,Y
  next
  NumBig = Gold
  if Gold < 10 then
    print at 2,21, "YOU GOT ", digits$(NumBig, 1), " GOLD STARS!"
  else
    print at 2,21, "YOU GOT ", digits$(NumBig, 2), " GOLD STARS!"
  end if
  if Gold >= WinStars then
    print at 2,22, "SHAPE MASTER! YOU WIN!"
    play sound SndWin
  else
    print at 2,22, "WELL DONE! TRY FOR 8 NEXT."
    play sound SndDone
  end if
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' PlayRound: deal, then picks until the shape is found
sub PlayRound:
  Ph = 2
  Deal
  ShowDeal
  Cur = 0
  Tries = 0
  Ph = 1
  Result = 0
  while Result = 0
    Frame1
    ReadPad
    MovePointer
    if Press = 1 then Result = Pick(Cur)
  end while
  return
end sub

' Deal: four different shapes of the six in a new order, the target one
' of them but never the last target (the listing's K <> KK), colours
sub Deal:
  u8 K
  u8 T
  for I = 0 to 5
    Bag[I] = I
  next
  ' shuffle the six, keep the first four
  for I = 5 to 1 step -1
    J = I + 1
    K = random(J)
    T = Bag[I]
    Bag[I] = Bag[K]
    Bag[K] = T
  next
  Tricky = 0
  if Round > EasyRounds then Tricky = 1
  OneCol = PickColour
  for I = 0 to 3
    Boxes[I].Shape = Bag[I]
    Boxes[I].Gone = 0
    if Tricky = 1 then
      Boxes[I].Col = OneCol
    else
      Boxes[I].Col = ShapeCol[Bag[I]]
    end if
  next
  TBox = random(4)
  if Boxes[TBox].Shape = Prev then
    TBox = TBox + 1 + random(3)
    TBox = TBox & 3
  end if
  Target = Boxes[TBox].Shape
  Prev = Target
  return
end sub

' PickColour: the one colour of a tricky round: the own colour of one of
' the first five shapes (the star's dark yellow is too pale on white)
function PickColour as u8
  V = random(5)
  return ShapeCol[V]

' ShowDeal: clear the boxes, colour the shapes, then show them one at a
' time (top left, top right, bottom left, bottom right), the target last
sub ShowDeal:
  u8 B
  Rearm
  wait
  nmi off
  for B = 0 to 3
    EraseBox(B)
  next
  for Y = TgtY to 12
    fill 32 count 4 at TgtX,Y
  next
  fill 32 count 28 at 2,1
  print at 2,1, "ROUND"
  NumBig = Round
  print at 8,1, digits$(NumBig, 2)
  print at 11,1, "OF 10"
  if Tricky = 1 then
    print at 21,1, "TRICKY!"
  else
    print at 23,1, "EASY"
  end if
  for B = 0 to 3
    SetShapeCol(Boxes[B].Shape, Boxes[B].Col)
  next
  SayLine(0)
  Ax = 192
  PlacePointer
  for B = 0 to 3
    Hold(14)
    nmi off
    DrawShape(Boxes[B].Shape, BoxCol(B), BoxRow(B))
    play sound SndPop
  next
  Hold(20)
  nmi off
  DrawShape(Target, TgtX, TgtY)
  play sound SndPop
  SayLine(1)
  Gx = PtrX(0)
  Gy = PtrY(0)
  Ax = Gx
  Ay = Gy
  PlacePointer
  return
end sub

' Pick: the box under the pointer is chosen; 1 when it was the match
function Pick(u8 B) as u8
  if Boxes[B].Gone = 1 then
    play sound SndNope
    return 0
  end if
  if Boxes[B].Shape = Target then
    Found
    return 1
  end if
  ' wrong: the shape turns grey and stays out
  inc Tries
  Boxes[B].Gone = 1
  nmi off
  SetShapeCol(Boxes[B].Shape, GreyCol)
  SayLine(2)
  play sound SndNo
  return 0

' Found: the star, the cheer, the target and its box flash (2.5 Hz)
sub Found:
  u8 Look
  u8 C
  u8 S
  Ph = 3
  S = Target
  C = Boxes[TBox].Col
  nmi off
  I = Round - 1
  if Tries = 0 then
    Slot[I] = 1
    inc Gold
    GoldShown += 1
  else
    Slot[I] = 2
  end if
  DrawStar(I)
  SayLine(3)
  play sound SndYes
  for Look = 1 to 6
    Hold(12)
    nmi off
    if Look & 1 then
      SetShapeCol(S, 15)
    else
      SetShapeCol(S, C)
    end if
  next
  if Round < Rounds then
    SayLine(4)
    Ph = 4
    WaitPress
  else
    Hold(40)
  end if
  return
end sub

' MovePointer: a new push moves the pointer one box; it glides there
sub MovePointer:
  u8 Old
  Old = Cur
  if Stick <> 0 then
    if WasStick = 0 then
      if Lf1 = 1 then Cur = Cur & 2
      if Rt1 = 1 then Cur = Cur | 1
      if Up1 = 1 then Cur = Cur & 1
      if Dn1 = 1 then Cur = Cur | 2
    end if
  end if
  WasStick = Stick
  if Cur <> Old then
    play sound SndMove
    inc Moves
  end if
  Gx = PtrX(Cur)
  Gy = PtrY(Cur)
  Ax = Glide(Ax, Gx)
  Ay = Glide(Ay, Gy)
  PlacePointer
  return
end sub

' Glide: four pixels a frame toward the goal
function Glide(u8 A, u8 G) as u8
  i16 D
  D = G
  D = D - A
  if D > 4 then return A + 4
  if D < -4 then return A - 4
  return G

function PtrX(u8 B) as u8
  V = B & 1
  V = V * 64
  return V + 112

function PtrY(u8 B) as u8
  V = B >> 1
  V = V * 56
  return V + 47

function BoxCol(u8 B) as u8
  V = B & 1
  V = V * 8
  return V + 16

function BoxRow(u8 B) as u8
  V = B >> 1
  V = V * 7
  return V + 5

sub PlacePointer:
  set sprite 0 to Ay,Ax,SArrowout,1
  set sprite 1 to Ay,Ax,SArrowin,11
  update sprites
  return
end sub

sub EraseBox(u8 B):
  u8 R
  X = BoxCol(B)
  Y = BoxRow(B)
  for R = 0 to 3
    fill 32 count 4 at X,Y
    inc Y
  next
  return
end sub

' DrawShape: shape S (16 tiles from 128 + 16 S) at column C, row R
sub DrawShape(u8 S, u8 C, u8 R):
  u8 T
  u8 Dy
  u8 Dx
  T = S * 16
  T = T + 128
  for Dy = 0 to 3
    Y = R + Dy
    for Dx = 0 to 3
      X = C + Dx
      put char T at X,Y
      inc T
    next
  next
  return
end sub

' SetShapeCol: every colour byte of shape S's 16 tiles in the top two
' thirds of the screen (the shapes never reach the bottom third)
sub SetShapeCol(u8 S, u8 C):
  V = C << 4
  fill array Buf with V
  Ofs = S
  Ofs = Ofs * 128
  Ofs = Ofs + 1024
  copy Buf count 128 to vram.color + Ofs
  Ofs = Ofs + 2048
  copy Buf count 128 to vram.color + Ofs
  return
end sub

sub DrawStar(u8 N):
  u8 T
  T = TDot00
  select case Slot[N]
  case 1
    T = TGold00
  case 2
    T = TGrey00
  end select
  X = N * 2
  X = X + StarX
  put char T at X,StarY
  X = X + 1
  T = T + 1
  put char T at X,StarY
  X = X - 1
  T = T + 1
  Y = StarY + 1
  put char T at X,Y
  X = X + 1
  T = T + 1
  put char T at X,Y
  return
end sub

' SayLine: the message line (row 22)
sub SayLine(u8 M):
  fill 32 count 28 at 2,22
  select case M
  case 0
    print at 2,22, "WATCH THE SHAPES..."
  case 1
    print at 2,22, "WHICH ONE MATCHES?"
  case 2
    print at 2,22, "SORRY... TRY AGAIN..."
  case 3
    print at 2,22, "YES! THAT'S RIGHT!"
  case else
    print at 2,22, "PRESS A BUTTON FOR MORE"
  end select
  return
end sub

sub NewGame:
  for I = 0 to 9
    Slot[I] = 0
  next
  Gold = 0
  GoldShown = 0
  Prev = 255
  Moves = 0
  return
end sub

' DrawPlay: the board (the C64's blue frame of four boxes), the target's
' frame, the star row
sub DrawPlay:
  TextScreen
  ' board: lines at columns 13, 21, 29 and rows 3, 10, 17
  for I = 0 to 2
    Y = I * 7
    Y = Y + BoardY
    fill TH count 15 at 14,Y
  next
  for I = 0 to 2
    X = I * 8
    X = X + BoardX
    for Y = 4 to 16
      put char TV at X,Y
    next
  next
  put char TTl at 13,3
  put char TTt at 21,3
  put char TTr at 29,3
  put char TLt at 13,10
  put char TX at 21,10
  put char TRt at 29,10
  put char TBl at 13,17
  put char TBt at 21,17
  put char TBr at 29,17
  ' the target's frame: columns 3-10, rows 7-14
  fill TH count 6 at 4,7
  fill TH count 6 at 4,14
  for Y = 8 to 13
    put char TV at 3,Y
    put char TV at 10,Y
  next
  put char TTl at 3,7
  put char TTr at 10,7
  put char TBl at 3,14
  put char TBr at 10,14
  print at 3,5, "FIND THIS"
  print at 3,16, "SHAPE!"
  print at 2,StarY, "STARS"
  for I = 0 to 9
    DrawStar(I)
  next
  ShowScreen
  return
end sub

' DrawLogo: SHAPE over MATCH in big letters (art.py checks the width)
sub DrawLogo(u8 Row):
  u8 R
  u16 P
  P = 0
  for R = 0 to 10
    Y = Row + R
    if R <> 5 then
      for I = 0 to 18
        V = TitleLogo[P]
        X = LogoX + I
        put char V at X,Y
        inc P
      next
    end if
  next
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $40
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  fill 32 count 768 to vram.name
  backdrop white
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  sprites stable 0 to 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Stick = Up1 | Dn1
  Stick = Stick | Lf1
  Stick = Stick | Rt1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

