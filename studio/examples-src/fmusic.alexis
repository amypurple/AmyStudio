const NSpr = 2
const NWords = 51
const Games = 7
const RepFirst = 14
const RepN = 6
const SqN = 30
const WrongCost = 120
const SingRep = 120
const HoldOk = 14
const HoldMiss = 60
const Perfect = 50
const KeyC0 = 6
const MomY0 = 130

data KeyCh bytes
  67, 68, 69, 70, 71, 65, 66
end data

record Bird:
  u8 Key
  u8 X
  u8 Dive
end record

Bird Mom
u8 Lt[8]
u8 Used[52]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Pt = 0
u16 PatMax = 520
bcd digits 5 Sc = 0
bcd digits 5 Hi = 0
u8 Clef = 0
u8 Gm = 0
u8 WLen = 0
u8 Wd = 0
u8 NUsed = 0
u8 Ni = 0
u8 Mist = 0
u8 SqT = 0
u8 Hold = 0
u8 RepT = 0
u8 Phase = 0
u8 BarN = 255
u8 Pts = 0
u8 Busy = 0
u8 Over = 0
u8 TitleOn = 0
u8 MomOn = 0
u8 Singer = 255
u8 SingX = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasDir = 0
u8 Rep = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Ri = 0
u8 Bj = 0
' scratch
u8 K = 0
u8 N = 0
u8 J = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  NUsed = 0
  fill array Used with 0
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  Clef = Menu
  Sc = 0
  Gm = 0
  Over = 0

game_loop:
  inc Gm
  StartWord

word_loop:
  Frame1
  ReadPad
  WordStep
  DrawSprites
  if Phase = 0 then goto word_loop

  ShowOff
  WordDone
  if Gm < Games then goto game_loop

  ' the end: a message, then back to the title on a press
  Over = 1
  if Sc > Hi then Hi = Sc
  ShowHud
  Singer = 255
  DrawSprites
  fill 32 count 28 at 2,12
  print at 8,12, "SCHOOL IS OUT!"
  MomOn = 0
  DrawSprites
  print at 7,17, "FINAL SCORE"
  print Sc at 19,17
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' small helpers that return values

' the column of note I of the word (short words are centred)
function NoteCol(u8 I) as u8
  u8 C = 0
  C = 7 - WLen
  C = C * 3
  C = C >> 1
  C = C + 8
  return C + I * 3

' the staff step of a note: 0 = the top line, 1 a space lower...; plus 2
' so that the bass B3 (above the top line) is 1
function StepOf(u8 Ky) as u8
  if Clef = 0 then return 12 - Ky
  return 7 - Ky

' is staff row R one with a line?
function HasLine(u8 R) as u8
  if R < 5 then return 0
  if R > 9 then return 0
  return 1

' the sound number of key Ky in this clef on channel base B
function NoteSnd(u8 B, u8 Ky) as u8
  u8 S = 0
  S = B + Ky
  if Clef = 0 then S = S + 7
  return S

' points for a named note: 40 x patience left
function Points as u8
  W16 = Pt * 40
  W16 = W16 / PatMax
  return W16

' ---------------------------------------------------------------------------
' one frame of a word

sub WordStep:
  MoveBird
  if Hold > 0 then
    dec Hold
    if Hold = 0 then NextNote
    return
  end if
  if SqT > 0 then
    dec SqT
    if SqT = 0 then DrawPupil(Ni, 1)
  end if
  dec Pt
  if Pt = 0 then
    TimeUp
    ShowBar
    return
  end if
  dec RepT
  if RepT = 0 then
    RepT = SingRep
    play sound NoteSnd(SndN0, Lt[Ni])
  end if
  if SqT = 0 then
    V = Tick & 15
    if V = 0 then
      V = Tick >> 4
      V = V & 1
      V = V + 1
      DrawPupil(Ni, V)
    end if
  end if
  if Press = 1 then Answer
  ShowBar
  return
end sub

' the stick: one key at a time, repeating while held
sub MoveBird:
  K = J1 | J2
  K = K & 12
  if K = 0 then
    WasDir = 0
    Rep = 0
  else
    if WasDir = 0 then
      StepKey(K)
      Rep = RepFirst
    else
      dec Rep
      if Rep = 0 then
        StepKey(K)
        Rep = RepN
      end if
    end if
    WasDir = 1
  end if
  ' glide over the chosen key, 4 pixels a frame at most
  X = Mom.Key * 24
  X = X + 52
  if Mom.X < X then
    V = X - Mom.X
    if V > 4 then V = 4
    Mom.X += V
  elseif Mom.X > X then
    V = Mom.X - X
    if V > 4 then V = 4
    Mom.X -= V
  end if
  if Mom.Dive > 0 then dec Mom.Dive
  return
end sub

sub StepKey(u8 D):
  select case D
  case 4
    if Mom.Key = 0 then return
    dec Mom.Key
  case 8
    if Mom.Key >= 6 then return
    inc Mom.Key
  case else
    return
  end select
  play sound SndMove
  return
end sub

' a button: the mother bird pecks the key
sub Answer:
  Mom.Dive = 8
  if Mom.Key = Lt[Ni] then
    Pts = Points
    Sc += Pts
    Named(Ni, 1)
    ShowScore
    Hold = HoldOk
    return
  end if
  inc Mist
  SqT = SqN
  DrawPupil(Ni, 3)
  if Pt > WrongCost then
    Pt = Pt - WrongCost
  else
    Pt = 1
  end if
  play sound SndSquawk
  return
end sub

' the bar ran out: the note is named for the player, no points
sub TimeUp:
  inc Mist
  SqT = 0
  Named(Ni, 0)
  print at 10,12, "IT WAS"
  T = KeyCh[Lt[Ni]]
  put char T at 17,12
  play sound SndMiss
  Hold = HoldMiss
  return
end sub

' note I is named: black note, the fidgit takes the note's colour and
' letter, the note sounds (when Snd = 1)
sub Named(u8 I, u8 Snd):
  u8 C = 0
  u8 Ky = 0
  Ky = Lt[I]
  DrawNote(I, TNk0l)
  C = NoteCol(I)
  DrawNamed(C, 13, Ky, 0)
  put char KeyCh[Ky] at C,16
  if Snd = 1 then play sound NoteSnd(SndN0, Ky)
  Singer = 255
  return
end sub

sub NextNote:
  fill 32 count 28 at 2,12
  inc Ni
  if Ni >= WLen then
    Phase = 1
    return
  end if
  LightNote
  return
end sub

' the next note to name: red, its fidgit sings it
sub LightNote:
  DrawNote(Ni, TNr0l)
  DrawPupil(Ni, 1)
  Pt = PatMax
  BarN = 255
  SqT = 0
  RepT = SingRep
  Singer = Ni
  SingX = NoteCol(Ni)
  play sound NoteSnd(SndN0, Lt[Ni])
  return
end sub

' ---------------------------------------------------------------------------
' words

' a word not used yet: 40 words before the list starts again
sub PickWord:
  u16 At = 0
  if NUsed >= 40 then
    fill array Used with 0
    NUsed = 0
  end if
  Rand
  W16 = Rs % NWords
  Wd = W16
  while Used[Wd] = 1
    inc Wd
    if Wd >= NWords then Wd = 0
  end while
  Used[Wd] = 1
  inc NUsed
  At = Wd * 8
  WLen = Words[At]
  for Bj = 1 to 7
    Lt[Bj - 1] = Words[At + Bj]
  next
  return
end sub

sub StartWord:
  PickWord
  W16 = Gm * 40
  PatMax = 560 - W16
  Ni = 0
  Mist = 0
  Hold = 0
  Phase = 0
  Mom.Key = 3
  Mom.X = 3 * 24 + 52
  Mom.Dive = 0
  MomOn = 1
  NewScreen
  DrawField
  DrawWord
  ShowHud
  LightNote
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' the fidgits show off: each sings its note in a chord, in turn
sub ShowOff:
  u8 E = 0
  u8 Ky = 0
  u8 C = 0
  E = WLen - 1
  for Fi = 0 to E
    Ky = Lt[Fi]
    C = NoteCol(Fi)
    DrawNamed(C, 13, Ky, 1)
    Singer = Fi
    SingX = C
    play sound NoteSnd(SndN0, Ky)
    play sound NoteSnd(SndP0, Ky + 2)
    play sound NoteSnd(SndQ0, Ky + 4)
    for Ri = 1 to 24
      Frame1
      DrawSprites
    next
    DrawNamed(C, 13, Ky, 0)
  next
  Singer = 255
  DrawSprites
  return
end sub

' the word, the bonus, then a press for the next word
sub WordDone:
  u8 C = 0
  fill 32 count 28 at 2,12
  C = 13 - WLen
  C = C >> 1
  C = C + 4
  print at C,12, "WORD:"
  C = C + 6
  for Fi = 0 to 6
    if Fi < WLen then
      T = KeyCh[Lt[Fi]]
      put char T at C + Fi,12
    end if
  next
  if Mist = 0 then
    Sc += Perfect
    ShowScore
    print at 9,2, "PERFECT! +50"
    play sound SndPerfect
  end if
  for Ri = 1 to 40
    Frame1
  next
  MomOn = 0
  print at 7,17, "PRESS THE BUTTON"
  WasBtn = 16
wd_loop:
  Frame1
  ReadPad
  DrawSprites
  if Press = 0 then goto wd_loop
  MomOn = 1
  fill 32 count 28 at 2,2
  fill 32 count 28 at 2,17
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' note I in the tiles starting at B (black TNk0l or red TNr0l)
sub DrawNote(u8 I, u8 B):
  u8 Q = 0
  u8 R = 0
  u8 C = 0
  u8 Tt = 0
  Q = StepOf(Lt[I])
  C = NoteCol(I)
  V = Q & 1
  if V = 1 then
    R = Q + 7
    R = R >> 1
    Tt = B + 4
    if HasLine(R) = 1 then Tt = B + 2
    put char Tt at C,R
    put char Tt + 1 at C + 1,R
    inc R
    Tt = B + 8
    if HasLine(R) = 1 then Tt = B + 6
    put char Tt at C,R
    put char Tt + 1 at C + 1,R
  else
    R = Q >> 1
    R = R + 4
    put char B at C,R
    put char B + 1 at C + 1,R
  end if
  return
end sub

' the grey fidgit under note I: 0 quiet, 1 singing, 2 half open, 3 squawk
sub DrawPupil(u8 I, u8 St):
  u8 C = 0
  u8 Tt = 0
  C = NoteCol(I)
  select case St
  case 0
    Tt = TUqtl
  case 1
    Tt = TUsal
  case 2
    Tt = TUsbl
  case else
    Tt = TUsql
  end select
  put char Tt at C,13
  put char Tt + 1 at C + 1,13
  put char TUqbl at C,14
  put char TUqbr at C + 1,14
  return
end sub

' a named fidgit in its note's colour at C,R (Sing 1: beak open)
sub DrawNamed(u8 C, u8 R, u8 Ky, u8 Sing):
  u8 Tt = 0
  Tt = Ky * 6
  Tt = Tt + TC0qtl
  if Sing = 1 then
    put char Tt + 4 at C,R
    put char Tt + 5 at C + 1,R
  else
    put char Tt at C,R
    put char Tt + 1 at C + 1,R
  end if
  put char Tt + 2 at C,R + 1
  put char Tt + 3 at C + 1,R + 1
  return
end sub

' the patience bar: 64 pixels for the whole patience
sub ShowBar:
  N = 0
  if Hold = 0 then
    W16 = Pt << 6
    W16 = W16 / PatMax
    N = W16
  end if
  if N = BarN then return
  BarN = N
  K = N >> 3
  for Bj = 0 to 7
    if Bj < K then
      T = TBar8
    elseif Bj = K then
      V = N & 7
      T = TBar0 + V
    else
      T = TBar0
    end if
    put char T at Bj + 21,1
  next
  return
end sub

sub ShowScore:
  print Sc at 2,1
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  ShowScore
  print at 9,1, "WORD"
  NumU = Gm
  print at 14,1, digits$(NumU, 1), "/7"
  BarN = 255
  ShowBar
  return
end sub

' sprite 0 the mother bird over her key, 1 the note over the singer
sub DrawSprites:
  Y = MomY0
  V = Mom.Dive
  if V > 4 then V = 8 - V
  Y = Y + V
  V = Tick >> 3
  V = V & 1
  K = V << 2
  if MomOn = 0 then
    set sprite 0 to 192,0,0,0
  else
    set sprite 0 to Y,Mom.X,K,11
  end if
  if Singer = 255 then
    set sprite 1 to 192,0,0,0
  else
    X = SingX << 3
    X = X + 6
    V = Tick >> 2
    V = V & 7
    Y = 90 - V
    set sprite 1 to Y,X,SNote,15
  end if
  update sprites
  return
end sub

' paper, staff, clef, branch, keyboard
sub DrawField:
  for Ri = 3 to 11
    if HasLine(Ri) = 1 then
      fill TLine count 28 at 2,Ri
    else
      fill TPaper count 28 at 2,Ri
    end if
  next
  if Clef = 0 then
    for Ri = 0 to 6
      V = Ri << 1
      V = V + TGc00
      put char V at 3,Ri + 4
      put char V + 1 at 4,Ri + 4
    next
  else
    for Ri = 0 to 3
      V = Ri << 1
      V = V + TFc00
      put char V at 3,Ri + 5
      put char V + 1 at 4,Ri + 5
    next
  end if
  fill TBark count 27 at 2,15
  put char TLeafr at 29,15
  ' the keyboard: rows 18-22, keys at columns 6-26
  for Fi = 0 to 6
    X = Fi * 3
    X = X + KeyC0
    for Ri = 18 to 22
      T = TKw
      if Ri < 21 then
        select case Fi
        case 1, 2, 4, 5, 6
          T = TKbl
        end select
      end if
      put char T at X,Ri
      T = TKw0
      if Ri = 22 then T = TKeyC + Fi
      put char T at X + 1,Ri
      T = TKw0
      if Ri < 21 then
        select case Fi
        case 0, 1, 3, 4, 5
          T = TKbr
        end select
      end if
      put char T at X + 2,Ri
    next
  next
  for Ri = 18 to 22
    put char TKend at 27,Ri
  next
  return
end sub

' the notes of the word in black, a grey fidgit under each
sub DrawWord:
  u8 E = 0
  u8 C = 0
  E = WLen - 1
  for Fi = 0 to E
    DrawNote(Fi, TNk0l)
    DrawPupil(Fi, 0)
    C = NoteCol(Fi)
    put char TToel at C,15
    put char TToer at C + 1,15
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: seven fidgits C..B singing in turn, the tune once,
' TREBLE CLEF / BASS CLEF / CREDITS
sub TitlePage:
  NewScreen
  TitleOn = 1
  MomOn = 0
  Singer = 255
  print at 10,2, "F I D G I T S"
  print at 9,3, "MUSIC  SCHOOL"
  fill TBark count 27 at 2,8
  put char TLeafr at 29,8
  for Fi = 0 to 6
    X = Fi * 3
    X = X + 5
    DrawNamed(X, 6, Fi, 0)
    put char TToel at X,8
    put char TToer at X + 1,8
    put char KeyCh[Fi] at X,9
  next
  print at 6,11, "BY WALTER E. MEYERS"
  print at 8,12, "AHOY! JULY 1986"
  print at 10,15, "TREBLE CLEF"
  print at 10,16, "BASS CLEF"
  print at 10,17, "CREDITS"
  print at 10,20, "HI"
  print Hi at 13,20
  if Menu > 1 then Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Ri = 255
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' one title fidgit sings at a time, in turn
  V = Tick >> 4
  V = V % 7
  if V <> Ri then
    if Ri <> 255 then
      X = Ri * 3
      X = X + 5
      DrawNamed(X, 6, Ri, 0)
    end if
    Ri = V
    X = Ri * 3
    X = X + 5
    DrawNamed(X, 6, Ri, 1)
  end if
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowMenu:
  for Bj = 15 to 17
    put char 32 at 8,Bj
  next
  put char 62 at 8,Menu + 15
  return
end sub

sub CreditsPage:
  NewScreen
  print at 6,2, "FIDGITS MUSIC SCHOOL"
  print at 2,5, "BASED ON FIDGITS MUSIC"
  print at 2,6, "SCHOOL BY WALTER E. MEYERS,"
  print at 2,7, "AHOY! JULY 1986 (C-64)."
  print at 2,10, "COLECOVISION GAME AND"
  print at 2,11, "PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: FIDGIT SCALES"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

