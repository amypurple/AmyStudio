cartridge "SUPERTANK/COMPUTE'S GAZETTE/1984"

' SUPERTANK
' A ColecoVision game based on "Supertank", COMPUTE!'s Gazette November
' 1984 (Commodore 64 BASIC; no author named in the listing or on the
' disk). Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in
' Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/supertank.bas, and timed in jsc64), the game is built for
' the ColecoVision: smooth 16 x 16 sprites, tiled mountains, battlefield
' and tank hull, sound effects and an original title tune.
'
' The game: you sit in your tank behind a gunsight. Enemy tanks drive
' across the battlefield from the left, each on a row of its own. Move the
' sight and fire: your shell leaves your gun barrel (bottom centre) and
' flies straight to the sight, shrinking as it goes, and bursts there, so
' lead the target (far and high targets take longer). A tank under the sight when the shell bursts is
' destroyed (10 points). A tank that gets across fires at you: one armor
' point lost. With no armor left the screen cracks and the game is over;
' a survival bonus (a point for each 200 frames of aiming) is added and
' your rank is shown.
'
' From the original: the three tanks (TIGER: strong armor 5, weak speed 1;
' T-34: armor 3, speed 2; SHERMAN: armor 1, speed 3), the sight's window,
' the enemy's band of rows (a random row each time), its constant speed
' (5 C64 pixels a BASIC pass, measured 0.8 pixel a jiffy in jsc64) and its
' fire point; a shell whose flight time grows with the distance to the
' sight and that gets smaller halfway; the sight frozen while it flies, the hit decided when it
' arrives; the enemy's shell dropping on you and the armor point; 10
' points a tank, bonus = passes / 20, shots fired, survival time, high
' score and the ranks TRAITOR to MARSHAL (by the points for tanks, the
' bonus not counted); the cracked screen at the end.
' The firing button may be held (the original fired while it was down).
'
' Liberties: deliberate change from the C64 (Amy's request): the view is
' first-person from your tank, so the shell starts at the gun barrel at
' the bottom centre and flies in a straight line to the sight, instead of
' entering from the left edge along the sight's row (2.2 pixels a jiffy
' on the C64); it covers 1 pixel a frame of the distance (longer side +
' half the shorter), tuned so the lead and the difficulty stay as before.
' The sight moves 3 times faster than on the C64 (its BASIC
' loop crawled at 6, 12 or 18 pixels a second; here 15, 30 and 45); the
' enemy speeds up by 1/16 pixel a frame every 5 tanks destroyed (up to
' 1.8 times; the original never changed); a hit needs the tank's centre
' within 10 pixels across and 8 down of the sight's centre (the C64 used
' sprite collisions with the sight's frame, which also let a sight held
' still score too easily); the rank table closes the original's gaps
' (scores of 51-52, 101, 201, ... had no rank); the tank is chosen with
' the stick instead of typing 1-3; an enemy that reaches its fire point
' while your shell flies fires all the same (on the C64 it vanished and
' came back on a new row unharmed, so holding the button down kept you
' almost safe); and its table shows what the code did
' (the C64 table had a FIRE column with no effect and called the T-34
' the fastest, though the SHERMAN's sight was); the screen's border colour change on a
' hit is an explosion; no play-again question (house rules).
'
' Controls: either controller; the stick moves the sight, either button
' fires. On the title and the tank choice, up and down choose, a button
' starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes faster than 3 Hz.

const TGrass = 128
const TGrass2 = 129
const TSky = 130
const TCrka = 131
const TCrkb = 132
const TBlk = 133
const TMt0 = 134
const TMt1 = 135
const TMt2 = 136
const TMt3 = 137
const TMt4 = 138
const TMt5 = 139
const TMt6 = 140
const TMt7 = 141
const TMt8 = 142
const TMt9 = 143
const TMt10 = 144
const TMt11 = 145
const TMt12 = 146
const TMt13 = 147
const TMt14 = 148
const THu15 = 149
const THu16 = 150
const THu17 = 151
const THu18 = 152
const THu19 = 153
const THu20 = 154
const THu21 = 155
const THu22 = 156
const THu23 = 157
const THu24 = 158
const THu25 = 159
const TTk26 = 160
const TTk27 = 161
const TTk28 = 162
const TTk29 = 163
const TTk30 = 164
const TTk31 = 165
const TTk32 = 166
const TTk33 = 167
const TTk34 = 168
const TTk35 = 169
const TTk36 = 170
const TTk37 = 171
const TTk38 = 172
const TTk39 = 173
const TTk40 = 174
const TTk41 = 175
const TTk42 = 176
const TTk43 = 177
const TTk44 = 178
const TTk45 = 179
const TTk46 = 180
const TTk47 = 181
const TTk48 = 182
const TTk49 = 183
const TTk50 = 184
const TTk51 = 185
const TTk52 = 186
const TTk53 = 187
const TTk54 = 188
const TTk55 = 189
const TTk56 = 190
const TTk57 = 191
const TTk58 = 192
const TTk59 = 193
const TTk60 = 194
const TTk61 = 195
const TTk62 = 196
const TTk63 = 197
const TTk64 = 198
const TTk65 = 199
const TTk66 = 200
const TTk67 = 201
const TTk68 = 202
const TTk69 = 203
const TTk70 = 204
const TTk71 = 205
const TTk72 = 206
const TTk73 = 207
const TTk74 = 208
const TTk75 = 209
const TTk76 = 210
const TTk77 = 211
const TTk78 = 212
const TTk79 = 213
const TTk80 = 214
const TTk81 = 215
const TTk82 = 216
const TTk83 = 217
const TTk84 = 218
const TTk85 = 219
const TTk86 = 220
const TTk87 = 221
const TTk88 = 222
const TTk89 = 223
const TTk90 = 224
const TTk91 = 225
const TTk92 = 226
const TTk93 = 227
const TTk94 = 228
const TTk95 = 229
const TTk96 = 230
const TTk97 = 231
const TTk98 = 232
const TTk99 = 233
const TTk100 = 234
const TTk101 = 235
const TTk102 = 236
const TTk103 = 237
const SSight = 0
const SShellb = 4
const SShells = 8
const SEnemy = 12
const SEnemy2 = 16
const SBoom1 = 20
const SBoom2 = 24
const SEshs = 28
const SEshb = 32
const NTiles8 = 880
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndFire = 3
const SndBoom = 4
const SndWhine = 5
const SndHit = 6
const SndMove = 7
const SndPick = 8
const SndStart = 9
const SndOver = 10
const NSpr = 6
const ExStart = 16
const ExFire = 184
const SxMin = 84
const SxMax = 208
const SyMin = 56
const SyMax = 124
const EyMin = 64
const ShellV = 16
const BarX = 112
const BarY = 152
const BoomN = 48
const EshN = 80
const BonusN = 200
const OverN = 120

' the three tanks: armor and sight speed (1/16 pixel a frame)
data ArmorT bytes
  5, 3, 1
end data
data SpeedT bytes
  4, 8, 12
end data

record Mover:
  u16 X16
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 5 Sc = 0
bcd digits 5 Hi = 0
bcd digits 5 Ten = 10
u16 ScU = 0
u16 KillSc = 0
u16 HiU = 0
u16 Shots = 0
u16 Bonus = 0
u16 Secs = 0
u16 BoF = 0
u8 Fc = 0
' the sight (top-left corner, x in 1/16 pixel), the enemy, the shells
Mover Sg
Mover En
u8 FlT = 0
u8 FlN = 1
i16 FlDx = 0
i16 FlDy = 0
u8 Fy = 0
u8 Ph = 0
u8 Tk = 0
u8 Armor = 5
u8 Spd = 4
u8 Ev = 10
u8 Kills = 0
u8 BoomT = 0
u8 EshT = 0
u8 Over = 0
u8 OverT = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0
u8 ShX = 0
u8 ShY = 0

  tile screen
  set sound table StSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title
  ChooseTank

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the cracked screen, then the results
  EndScreen
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  ' the survival time (all but the final cracked screen)
  if Ph < 4 then
    inc Fc
    if Fc >= 60 then
      Fc = 0
      inc Secs
    end if
  end if
  select case Ph
  case 0
    Aim
    MoveEnemy
  case 1
    MoveEnemy
    if Ph = 1 then Fly
  case 2
    dec BoomT
    if BoomT = 0 then NewEnemy
  case 3
    inc EshT
    if EshT >= EshN then
      dec Armor
      play sound SndHit
      ShowHud
      if Armor = 0 then
        Ph = 4
        OverT = OverN
        DrawCracks
        play sound SndOver
      else
        NewEnemy
      end if
    end if
  case 4
    dec OverT
    if OverT = 0 then Over = 1
  end select
  return
end sub

' the sight: the stick moves it inside its window; the button fires
sub Aim:
  inc BoF
  if BoF >= BonusN then
    BoF = 0
    inc Bonus
  end if
  K = J1 | J2
  W16 = Spd
  V = K & 4
  if V > 0 then
    Sg.X16 -= W16
    if Sg.X16 < SxMin * 16 then Sg.X16 = SxMin * 16
  end if
  V = K & 8
  if V > 0 then
    Sg.X16 += W16
    if Sg.X16 > SxMax * 16 then Sg.X16 = SxMax * 16
  end if
  ' up and down: whole pixels every (16 / speed) frames, as a fraction
  ' kept in Fy between frames
  V = K & 3
  if V > 0 then
    Fy = Fy + Spd
    if Fy >= 16 then
      Fy = Fy - 16
      V = K & 1
      if V > 0 then
        if Sg.Y > SyMin then dec Sg.Y
      else
        if Sg.Y < SyMax then inc Sg.Y
      end if
    end if
  end if
  if Btn > 0 then
    Ph = 1
    StartShell
    inc Shots
    play sound SndFire
  end if
  return
end sub

' the shell flies right along the sight's row until it reaches the sight
' the shell leaves the barrel (bottom centre) for the sight: its flight
' takes (distance x 16 / ShellV) frames, the distance measured as the
' longer side + half the shorter one
sub StartShell:
  i16 Ax
  i16 Ay
  u16 D16
  FlDx = Sg.X16 >> 4
  FlDx = FlDx - BarX
  FlDy = Sg.Y
  FlDy = FlDy - BarY
  Ax = abs(FlDx)
  Ay = abs(FlDy)
  if Ax > Ay then
    D16 = Ax + Ay / 2
  else
    D16 = Ay + Ax / 2
  end if
  D16 = D16 * 16 + ShellV - 1
  D16 = D16 / ShellV
  if D16 < 1 then D16 = 1
  FlN = D16
  FlT = 0
  return
end sub

' the shell flies; it bursts at the sight
sub Fly:
  inc FlT
  if FlT < FlN then return
  if HitNow() = 1 then
    Ph = 2
    BoomT = BoomN
    inc Kills
    Sc += Ten
    ScU += 10
    V = Kills % 5
    if V = 0 then
      if Ev < 18 then inc Ev
    end if
    play sound SndBoom
    ShowHud
  else
    Ph = 0
  end if
  return
end sub

' 1 when the enemy tank's centre is near the sight's centre
function HitNow as u8
  i16 Dx
  i16 Dy
  i16 Ax
  Dx = En.X16 >> 4
  Ax = Sg.X16 >> 4
  Dx = Dx - Ax
  Dy = En.Y + 1
  Dy = Dy - Sg.Y
  if abs(Dx) > 10 then return 0
  if abs(Dy) > 8 then return 0
  return 1

' the enemy drives right; at its fire point it shoots
sub MoveEnemy:
  W16 = Ev
  En.X16 += W16
  if En.X16 >= ExFire * 16 then
    En.X16 = ExFire * 16
    Ph = 3
    EshT = 0
    play sound SndWhine
  end if
  return
end sub

sub NewEnemy:
  Rand
  V = Rs & 63
  ' a row of 0-47 (the C64 used RND * 60 of its 70-pixel window)
  if V >= 48 then V = V - 16
  En.Y = EyMin + V
  En.X16 = ExStart * 16
  Ph = 0
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites: 0 the sight, 1 your shell, 2 the enemy (or its explosion),
' 3 the enemy's shell
sub DrawSprites:
  if TitleOn = 1 then return
  X = Sg.X16 >> 4
  Y = Sg.Y - 1
  set sprite 0 to Y,X,SSight,11
  if Ph = 1 then
    ShellPos
    ' the shell gets smaller as it goes away (big for the first half)
    K = SShellb
    V = FlT + FlT
    if V >= FlN then K = SShells
    set sprite 1 to ShY,ShX,K,15
  else
    set sprite 1 to 192,0,0,0
  end if
  X = En.X16 >> 4
  Y = En.Y - 1
  if Ph = 2 then
    K = SBoom1
    if BoomT < 24 then K = SBoom2
    C = 9
    if BoomT < 24 then C = 10
    set sprite 2 to Y,X,K,C
  elseif Ph = 4 then
    set sprite 2 to 192,0,0,0
  else
    V = X >> 2
    V = V & 1
    K = SEnemy
    if V = 1 then K = SEnemy2
    set sprite 2 to Y,X,K,1
  end if
  if Ph = 3 then
    ' its shell drops towards you: slowly and small, then big and fast
    X = X + 4
    if EshT < 40 then
      V = EshT >> 1
      Y = Y + 4 + V
      set sprite 3 to Y,X,SEshs,8
    else
      V = EshT - 40
      V = V + V
      Y = Y + 24 + V
      if Y > 167 then Y = 167
      set sprite 3 to Y,X,SEshb,8
    end if
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

' the shell's place on the straight line from the barrel to the sight
sub ShellPos:
  i16 P
  P = FlDx * FlT
  P = P / FlN
  P = P + BarX
  ShX = P
  P = FlDy * FlT
  P = P / FlN
  P = P + BarY - 1
  ShY = P
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print Sc at 8,1
  print at 14,1, "HI"
  print Hi at 17,1
  print at 23,1, "ARMOR"
  NumU = Armor
  print at 29,1, digits$(NumU, 1)
  return
end sub

' a picture map at column C, row Ri (rows of tile codes)
sub DrawMtn:
  for J = 0 to PicMtnH - 1
    for K = 0 to PicMtnW - 1
      V = J * PicMtnW + K
      N = PicMtn[V]
      X = K + 2
      Y = J + 3
      put char N at X,Y
    next
  next
  return
end sub

sub DrawHull:
  for J = 0 to PicHullH - 1
    for K = 0 to PicHullW - 1
      V = J * PicHullW + K
      N = PicHull[V]
      X = K + 2
      Y = J + 20
      put char N at X,Y
    next
  next
  return
end sub

sub DrawField:
  fill TSky count 28 at 2,2
  DrawMtn
  for Ri = 7 to 19
    for J = 2 to 29
      V = J + Ri
      V = V & 3
      N = TGrass
      if V = 0 then N = TGrass2
      put char N at J,Ri
    next
  next
  DrawHull
  return
end sub

' the cracked windscreen: lines from the centre (the C64 drew them with
' slash characters)
sub DrawCracks:
  for Ri = 0 to 9
    X = 15 - Ri
    Y = 8 + Ri
    put char TCrka at X,Y
    X = 16 + Ri
    put char TCrkb at X,Y
    if Ri < 6 then
      X = 12 - Ri
      Y = 9 + Ri
      if Ri > 2 then
        put char TCrkb at X,Y
      end if
      X = 20 + Ri
      put char TCrka at X,Y
    end if
  next
  return
end sub

sub NewGame:
  Sc = 0
  ScU = 0
  Shots = 0
  Bonus = 0
  BoF = 0
  Secs = 0
  Fc = 0
  Kills = 0
  Ev = 10
  Armor = ArmorT[Tk]
  Spd = SpeedT[Tk]
  Sg.X16 = 146 * 16
  Sg.Y = 90
  Fy = 0
  NewScreen
  DrawField
  ShowHud
  NewEnemy
  Over = 0
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

sub EndScreen:
  ' the rank goes by the tanks destroyed (the C64 ranked before adding
  ' the bonus)
  KillSc = ScU
  W16 = Bonus
  ScU = ScU + W16
  AddBonus
  if ScU > HiU then
    HiU = ScU
    Hi = Sc
  end if
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,3, "GAME OVER"
  print at 4,6, "BONUS"
  NumU = Bonus
  print at 18,6, digits$(NumU, 5)
  print at 4,8, "SHOTS FIRED"
  NumU = Shots
  print at 18,8, digits$(NumU, 5)
  print at 4,10, "YOUR SCORE"
  print Sc at 18,10
  print at 4,12, "HIGH SCORE"
  print Hi at 18,12
  print at 4,14, "SURVIVED"
  W16 = Secs / 60
  NumU = W16
  print at 18,14, digits$(NumU, 2)
  print at 20,14, ":"
  W16 = Secs % 60
  NumU = W16
  print at 21,14, digits$(NumU, 2)
  print at 4,17, "YOUR RANK IS"
  ShowRank
  ShowScreen
  return
end sub

' the bonus into the BCD score, ten and one at a time
sub AddBonus:
  bcd digits 5 One = 1
  u16 Left
  Left = Bonus
  while Left >= 10
    Sc += Ten
    Left = Left - 10
  end while
  while Left > 0
    Sc += One
    dec Left
  end while
  return
end sub

sub ShowRank:
  select case KillSc
  case 0
    print at 10,19, "TRAITOR"
  case 1 to 50
    print at 10,19, "SOLDIER"
  case 51 to 100
    print at 9,19, "SERGEANT"
  case 101 to 200
    print at 9,19, "LIEUTENANT"
  case 201 to 400
    print at 10,19, "CAPTAIN"
  case 401 to 600
    print at 11,19, "MAJOR"
  case 601 to 800
    print at 10,19, "COLONEL"
  case 801 to 1000
    print at 8,19, "* GENERAL *"
  case else
    print at 8,19, "** MARSHAL **"
  end select
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a two-line menu at rows Ri and Ri + 1: up/down choose, a button picks;
' Menu is 0 or 1 (or 0-2 with three lines)
sub MenuLoop(u8 Lines):
  u8 Was
  Was = 1
mloop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < Lines - 1 then inc Menu
      end if
      play sound SndPick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto mloop
  Was = 0
  return
end sub

sub ShowMenu:
  for J = 0 to 2
    Y = Ri + J
    put char 32 at 7,Y
  next
  Y = Ri + Menu
  put char 62 at 7,Y
  return
end sub

' the title: the big tank, the tune once, START GAME / CREDITS
sub TitlePage:
  NewScreen
  print at 9,2, "W*E*L*C*O*M*E!"
  print at 15,3, "TO"
  print at 11,4, "SUPERTANK!"
  for J = 0 to PicTankH - 1
    for K = 0 to PicTankW - 1
      V = J * PicTankW + K
      N = PicTank[V]
      X = K + 3
      Y = J + 6
      put char N at X,Y
    next
  next
  print at 9,16, "START GAME"
  print at 9,17, "CREDITS"
  print at 2,20, "HI"
  print Hi at 5,20
  print at 2,22, "COMPUTE!'S GAZETTE NOV 1984"
  Menu = 0
  Ri = 16
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 540
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  MenuLoop(2)
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

' the tank specifications (the original's table) and the choice
sub ChooseTank:
  NewScreen
  print at 5,2, "TANK SPECIFICATIONS"
  print at 3,5, "         ARMOR  SIGHT"
  print at 3,7, "TIGER    5      SLOW"
  print at 3,9, "T-34     3      MEDIUM"
  print at 3,11, "SHERMAN  1      FAST"
  print at 3,14, "ARMOR: HITS YOU CAN TAKE"
  print at 3,15, "SIGHT: HOW FAST YOUR SIGHT"
  print at 3,16, "       MOVES"
  print at 3,19, "WHICH TANK DO YOU CHOOSE?"
  Menu = 0
  Ri = 7
  ShowTankMenu
  ShowScreen
  Rearm
  wait no fire
  nmi off
tloop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndPick
      ShowTankMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tloop
  Tk = Menu
  print at 3,19, "       GET READY !       "
  Rearm
  wait 60 frames
  nmi off
  return
end sub

sub ShowTankMenu:
  for J = 0 to 2
    Y = J + J
    Y = Y + 7
    put char 32 at 2,Y
  next
  Y = Menu + Menu
  Y = Y + 7
  put char 62 at 2,Y
  fill 32 count 10 at 9,21
  select case Menu
  case 0
    print at 9,21, "1 TIGER"
  case 1
    print at 9,21, "2 T-34"
  case 2
    print at 9,21, "3 SHERMAN"
  end select
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "SUPERTANK"
  print at 2,5, "BASED ON SUPERTANK,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "NOVEMBER 1984 (COMMODORE 64)"
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: ARMOUR COLUMN"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

