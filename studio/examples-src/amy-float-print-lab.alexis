' FP5 print lab: exact fp5 decimal output requires digits 16.
u16 UZero = 0
u16 UOne = 1
u16 UTen = 10
u16 UHundred = 100
i16 SNegTen = -10
fp5 FZero = 0
fp5 FOne = 0
fp5 FTen = 0
fp5 FHundred = 0
fp5 FNegTen = 0
fp5 FRnd = 0

  text screen
  print at 10,0, "FP5 PRINT LAB"

  FZero = UZero
  FOne = UOne
  FTen = UTen
  FHundred = UHundred
  FNegTen = SNegTen
  FRnd = random()

  print at 1,4,  "0"
  print FZero at 12,4 digits 16
  print at 1,6,  "1"
  print FOne at 12,6 digits 16
  print at 1,8,  "10"
  print FTen at 12,8 digits 16
  print at 1,10, "100"
  print FHundred at 12,10 digits 16
  print at 1,12, "-10"
  print FNegTen at 12,12 digits 16
  print at 1,14, "RND"
  print FRnd at 12,14 digits 16

  print at 1,17, "EXPECT"
  print at 1,18, "0     00000.0000"
  print at 1,19, "1     00001.0000"
  print at 1,20, "10    00010.0000"
  print at 1,21, "100   00100.0000"
  print at 1,22, "-10   -0010.0000"
  print at 1,23, "RND   exact digits 16"
  screen on