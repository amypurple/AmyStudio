project "Amy Compound Expression Test"
memory "colecovision_legacy_sdcc"

u8 ByteValue = 10
u8 ByteStep = 3
u16 WordValue = 100
u16 WordStep = 20
u8 PassCount = 0

  text screen
  print centered at 0, "COMPOUND EXPR TEST"

  ByteValue += 2 + ByteStep
  if ByteValue = 15 then PassCount += 1
  print ByteValue at 1,3 digits 3

  ByteValue -= 1 + ByteStep
  if ByteValue = 11 then PassCount += 1
  print ByteValue at 1,4 digits 3

  WordValue += 7 + WordStep
  if WordValue = 127 then PassCount += 1
  print WordValue at 1,6 digits 5

  WordValue -= 2 + WordStep
  if WordValue = 105 then PassCount += 1
  print WordValue at 1,7 digits 5

  if PassCount = 4 then
    print centered at 12, "PASS"
  else
    print centered at 12, "FAIL"
  end if
  screen on