  6,2,2,2,2,2,2,6,2,2,2,2,2,2
  6,2,2,2,6,2,6,2,2,2,2,2,2,6
  6,2,2,2,2,2,2,2,2,2,2,2,2,2
  2,2,2,6,2,2,2,2,2,2,2,2,2,2
  2,2,2,6,4,4,4,2,2,2,2,2,8,2
  2,2,2,2,2,2,2,2,6,2,2,2,2,2
  2,6,2,2,6,2,2,2,2,2,2,2,2,2
  4,4,4,2,4,4,4,4,4,4,2,4,4,4
  2,2,2,2,2,2,2,2,2,2,8,2,10,6
  2,2,2,2,2,2,2,2,2,6,2,6,6,2
  6,2,2,2,2,2,2,2,8,2,2,2,2,2
  2,2,2,2,2,2,2,2,6,2,2,2,6,2
  2,2,2,2,2,6,2,2,2,2,2,2,2,2
  2,6,2,2,6,2,2,2,6,2,2,2,2,2
  6,2,2,2,2,2,2,2,2,6,2,2,6,2
  2,2,2,2,6,2,2,2,6,2,2,2,2,2
  2,2,2,6,2,6,2,2,2,2,2,2,6,2
  2,2,2,2,2,2,2,2,2,2,2,2,2,2
  2,2,2,2,2,2,2,2,16,2,2,2,2,2
  4,4,4,4,4,4,4,4,4,4,4,4,4,4
end data
data ExitC bytes
  12,1,12,12,6,2,10,8
end data

' --- state read by the bots ---
u8 State = 0
u8 Tick = 0
u8 Ph = 0
u8 Chunk = 0
u8 Lv = 0
u8 Lives = 0
u16 Score = 0
u8 ScD[5]
u16 Pts = 0
u8 Gems = 0
u8 Quota = 0
u8 Beams = 0
u16 Oil = 0
u16 OilMax = 0
u16 OilQ = 0
u16 OilLo = 0
u8 OilSeg = 0
u16 DepthMax = 0
u8 LvMax = 0
u8 Mr = 0
u8 Mc = 0
u8 Px = 0
u16 Py = 0
u8 MvOn = 0
u8 MvT = 0
u8 MvDx = 0
u8 MvDy = 0
u8 DigOn = 0
u8 DigT = 0
u8 DigR = 0
u8 DigC = 0
u8 DigVis = 0
u8 DigGi = 0
u8 PushOn = 0
u8 PushT = 0
u8 PushDx = 0
u8 Face = 1
u8 Dead = 0
u8 Cause = 0
u8 ClearT = 0
u8 Trap = 0
u8 LastBtn = 0
u8 Held = 0
u8 PopT = 0
u8 PopX = 0
u16 PopY = 0
u8 BoomT = 0
u8 BoomX = 0
u16 BoomY = 0
u8 FuR[12]
u8 FuC[12]
u8 FuT[12]
u8 FuN = 0
u8 FallCnt = 0
u8 KillReq = 0
u8 LandN = 0
u8 LandRow = 0
u8 GameOver = 0
u16 Digs = 0
u16 GemsTot = 0
u16 Booms = 0
u16 Deaths = 0
u8 Clears = 0
' events of this tick (sounds)
u8 EvGem = 0
u8 EvDig = 0
u8 EvPush = 0
u8 EvBeam = 0
u8 EvFuse = 0
u8 EvBoom = 0
u8 EvDie = 0
u8 EvClear = 0
u8 EvOpen = 0
u8 EvClimb = 0
u8 LandWait = 0
' --- engine (asm) ---
u16 CamY = 0
u8 PgS = 0
u8 BPg = 0
u8 BTabH = 0
u8 BN = 0
u8 BHalf = 0
u16 BAddr = 0
u16 BWin = 0
u16 PtrB = 0
u16 PtrC = 0
u8 WinOk = 0
u8 BCr = 0
u8 DgKey[8]
u8 DgSame = 0
u8 DgN1 = 0
u8 DgN2 = 0
u16 DgS1 = 0
u16 DgS2 = 0
u8 BPool = 0
u8 BR0 = 0
u16 BTab = 0
u8 BJ = 0
u8 WinR0 = 0
u8 DigJ0 = 0
u8 DigNr = 0
u8 DigO = 0
u8 PhTop = 0
u8 PhR = 0
u8 PhDB = 0
u8 PhDC = 0
u8 PhMC = 0
u8 PhMB = 0
u8 RowB[16]
u8 RowC[16]
u8 Win[154]
u8 SatBuf[33]
u8 HudT[28]
u8 HudB[28]
u8 TBuf[16]
u8 DgUp = 0
u8 DgDn = 0
u8 DgCol = 0
u8 DgY = 0
u8 SpN = 0
u8 SpY[8]
u8 Gr = 0
u8 Gc = 0
u8 Gk = 0
' --- menus, input ---
u8 Menu = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u16 NumU = 0
u16 Waited = 0
u8 Page = 0
' title scene
u8 TsX = 0
u8 TsR = 0
u8 TsF = 0
u8 TsSp = 0
' scratch (never kept across a sub call)
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 R = 0
u8 C = 0
u8 D = 0
u8 S = 0
u16 W = 0
u16 W2 = 0
i16 Si = 0
' loop counters of subs that call subs
u8 Er = 0
u8 Ec = 0
u8 Fi = 0
u8 Fn0 = 0
u8 Hi = 0
u8 Sk = 0
' tick locals
u8 TU = 0
u8 TD = 0
u8 TL = 0
u8 TR = 0
u8 TDx = 0
u8 THere = 0
u8 TUp = 0
u8 TBel = 0
u8 TSide = 0
u8 TActed = 0
u8 TClimb = 0
u8 TPress = 0
u8 TBtn = 0

  tile screen
  set sound table FdSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  fill array RowB with 2
  fill array RowC with 2
  screen on

title:
  State = StTitle
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  if Ph = 0 then
    call asm FmFlipA
    ReadPad
    GameTick
    if GameOver = 1 then goto game_over
    PhysStep
    Camera
    call asm FmWinA
    call asm FmBuildA
  else
    call asm FmBuildB
    call asm FmDigA
    MakeSat
    PhysStep
  end if
  Ph = Ph ^ 1
  Sounds
  goto play_loop

game_over:
  State = StOver
  mute all
  PlayEnd
  OverPage
  Waited = 0
go_wait:
  Frame1
  ReadPad
  inc Waited
  if Waited < 60 then Press = 0
  if Waited >= 1800 then Press = 1
  if Press = 0 then goto go_wait
  goto title

' ===========================================================================
' frame, input

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 1
  sprites flicker off
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  call asm PcSpr
  return
end sub

' ===========================================================================
' the game (rules = model.mjs; the bots check the two agree)

sub NewGame:
  Score = 0
  fill array ScD with 0
  Lives = 3
  Lv = 0
  DepthMax = 0
  Digs = 0
  GemsTot = 0
  Booms = 0
  Deaths = 0
  Clears = 0
  GameOver = 0
  LoadLevel
  return
end sub

' a mine (again after a lost life): its card, then the map and both pages
sub LoadLevel:
  State = StCard
  mute all
  CardPage
  ' the rules' reset (model.load)
  Mr = 1
  Mc = 6
  Px = 96
  Py = 16
  MvOn = 0
  DigOn = 0
  DigVis = 0
  PushOn = 0
  Gems = 0
  V = Lv
  while V >= NLev
    V -= NLev
  end while
  Quota = QuotaT[V]
  ' oil: 150 s, 20 s less each time round the eight mines, 60 s at least
  OilMax = OilFull
  V = Lv
  while V >= NLev
    V -= NLev
    if OilMax > 2400 then OilMax -= 600
  end while
  if OilMax < 1800 then OilMax = 1800
  Oil = OilMax
  OilQ = OilMax / 8
  OilSeg = 8
  OilLo = OilMax - OilQ
  Beams = 3
  FuN = 0
  BoomT = 0
  PopT = 0
  Dead = 0
  Cause = 0
  ClearT = 0
  Trap = 0
  LastBtn = 0
  Held = 0
  Face = 1
  Chunk = 0
  Ph = 0
  LvMax = 1
  FallCnt = 0
  KillReq = 0
  LandWait = 0
  ' the screen
  Rearm
  wait
  nmi off
  display off
  HideSprites
  call asm FmPlayVram
  call asm FmLoadMap
  fill array DgKey with 255
  if defined DBG_TRAP
  ' (test build only: stuck.mjs) the miner sealed in walls at the start
  Gk = KWall
  for Sk = 0 to 8
    Gr = Sk / 3
    Gc = Sk mod 3
    Gc += 5
    if Sk <> 4 then MSet
  next
  end defined
  CamY = 0
  Camera
  CamY = Py
  if CamY > 72 then
    CamY -= 72
  else
    CamY = 0
  end if
  HudAll
  ' both pages: page 1 shown first, page 0 next (the first flip)
  PgS = 0
  call asm FmWinA
  call asm FmBuildA
  call asm FmBuildB
  PgS = 1
  call asm FmBuildA
  call asm FmBuildB
  MakeSat
  call asm FmShowP1
  Rearm
  wait
  nmi off
  screen on
  nmi off
  State = StPlay
  return
end sub


sub DoKill:
  if Dead > 0 then return
  if ClearT > 0 then return
  Dead = TDead
  Cause = K
  inc Deaths
  MvOn = 0
  DigOn = 0
  PushOn = 0
  EvDie = 1
  return
end sub

' the cell (Gr, Gc) -> Gk (outside the mine = wall)
sub MGet:
  asm {
    call FmGet
    ld (Gk),a
  }
  return
end sub

sub MSet:
  asm {
    call FmSet
  }
  return
end sub

' is (Gr, Gc) empty and not the miner? -> V
sub Free:
  MGet
  V = 0
  if Gk = KEmpty then
    V = 1
    if Gr = Mr then
      if Gc = Mc then V = 0
    end if
  end if
  return
end sub

sub AddScore:
  W = Score + Pts
  if W < Score then W = 65535
  Score = W
  asm {
    call FmAddPts
  }
  return
end sub

sub AddFuse:
  if FuN < FuMax then
    FuR[FuN] = Gr
    FuC[FuN] = Gc
    FuT[FuN] = K
    inc FuN
  end if
  return
end sub

' start a move by (TDx, D): D = 0, 1 (down) or 255 (up)
sub StartMove:
  Gr = Mr + D
  Gc = Mc + TDx
  MGet
  if Gk = KGem then
    Gk = KEmpty
    MSet
    inc Gems
    inc GemsTot
    Pts = 50
    AddScore
    EvGem = 1
    PopT = TPop
    PopX = Gc * 16
    PopY = Gr
    PopY = PopY * 16
    W = Oil + GemOil
    if W > OilMax then W = OilMax
    Oil = W
    if Gems = Quota then EvOpen = 1
  end if
  Mr = Gr
  Mc = Gc
  MvOn = 1
  MvT = 0
  MvDx = TDx
  MvDy = D
  if TDx <> 0 then Face = TDx
  return
end sub

sub GameTick:
  if Dead > 0 then
    dec Dead
    if Dead = 0 then
      dec Lives
      if Lives = 0 then
        GameOver = 1
        return
      end if
      LoadLevel
    end if
    return
  end if
  if ClearT > 0 then
    dec ClearT
    if ClearT = 0 then
      inc Lv
      LoadLevel
    end if
    return
  end if
  if PopT > 0 then dec PopT
  if BoomT > 0 then dec BoomT
  dec Oil
  OilHud
  if Oil = 0 then
    K = 3
    DoKill
    return
  end if
  ' fuses, oldest first; a blast lights its gas neighbours (new fuses wait)
  if FuN > 0 then
    Fn0 = FuN
    Fi = 0
    while Fn0 > 0
      dec Fn0
      J = FuT[Fi]
      dec J
      FuT[Fi] = J
      if J = 0 then
        Er = FuR[Fi]
        Ec = FuC[Fi]
        ' remove entry Fi (keep the order)
        J = Fi
        N = FuN - 1
        while J < N
          K = J + 1
          FuR[J] = FuR[K]
          FuC[J] = FuC[K]
          FuT[J] = FuT[K]
          inc J
        end while
        dec FuN
        Explode
        if Dead > 0 then return
      else
        inc Fi
      end if
    end while
  end if
  TBtn = Btn
  TPress = 0
  if TBtn = 1 then
    if LastBtn = 0 then TPress = 1
  end if
  LastBtn = TBtn
  if TBtn = 1 then
    inc Held
  else
    Held = 0
  end if
  if Held >= TGiveUp then
    K = 5
    DoKill
    return
  end if
  TL = Lf1
  TR = Rt1
  TU = Up1
  TD = Dn1
  TDx = 0
  if TL = 1 then
    TDx = 255
  elseif TR = 1 then
    TDx = 1
  end if
  ' a move in progress
  if MvOn = 1 then
    inc MvT
    if MvDx = 1 then Px += 2
    if MvDx = 255 then Px -= 2
    if MvDy = 1 then Py += 2
    if MvDy = 255 then Py -= 2
    if MvT >= TMove then
      MvOn = 0
      Px = Mc * 16
      Py = Mr
      Py = Py * 16
      if Mr > LvMax then
        V = Mr - LvMax
        Pts = V * 5
        AddScore
        LvMax = Mr
      end if
      Gr = Mr
      Gc = Mc
      MGet
      if Gk = KExit then
        if Gems >= Quota then
          W = Oil / 30
          Pts = W * 2
          V = Beams * 20
          Pts += V
          AddScore
          ClearT = TClear
          inc Clears
          EvClear = 1
          DepthUp
          return
        end if
      end if
    end if
    DepthUp
    return
  end if
  if DigOn = 1 then
    inc DigT
    if DigT >= TDig then
      DigOn = 0
      DigVis = 0
      Gr = DigR
      Gc = DigC
      MGet
      if Gk = KGas then
        Gk = KFuse
        MSet
        K = TFuse
        AddFuse
        EvFuse = 1
      elseif Gk = KDirt then
        Gk = KEmpty
        MSet
        Pts = 1
        AddScore
        inc Digs
        EvDig = 1
      end if
    else
      DigLook
    end if
    return
  end if
  if PushOn = 1 then
    inc PushT
    if PushT >= TPush then
      PushOn = 0
      Gr = Mr
      Gc = Mc + PushDx
      MGet
      if Gk = KRock then
        Gc += PushDx
        Free
        if V = 1 then
          Gk = KRock
          MSet
          Gc -= PushDx
          Gk = KEmpty
          MSet
          EvPush = 1
          TDx = PushDx
          D = 0
          StartMove
        end if
      end if
    end if
    return
  end if
  Gr = Mr
  Gc = Mc
  MGet
  THere = Gk
  Gr = Mr - 1
  MGet
  TUp = Gk
  Gr = Mr + 1
  MGet
  TBel = Gk
  ' climbing: a beam is a ladder
  TClimb = 0
  if TU = 1 then
    if TDx = 0 then
      if THere = KBeam then
        V = TUp
        if PassT[V] = 1 then TClimb = 1
      end if
    end if
  end if
  ' gravity (a beam holds the miner)
  if THere <> KBeam then
    if TClimb = 0 then
      V = TBel
      if PassT[V] = 1 then
        TDx = 0
        D = 1
        StartMove
        return
      end if
    end if
  end if
  ' the button: a beam in the miner's cell
  if TPress = 1 then
    if THere = KEmpty then
      if Beams > 0 then
        Gr = Mr
        Gc = Mc
        Gk = KBeam
        MSet
        dec Beams
        EvBeam = 1
        Trap = 0
        HudAll
        return
      end if
    end if
  end if
  TActed = 0
  if TDx <> 0 then
    Face = TDx
    Gr = Mr
    Gc = Mc + TDx
    MGet
    TSide = Gk
    V = TSide
    if TU = 1 then
      if PassT[V] = 0 then
        if TSide <> KDirt then
          if TSide <> KGas then
            V = TUp
            if PassT[V] = 1 then
              Gr = Mr - 1
              MGet
              V = Gk
              if PassT[V] = 1 then
                D = 255
                StartMove
                EvClimb = 1
                TActed = 1
              end if
            end if
          end if
        end if
      end if
    end if
    if TActed = 0 then
      V = TSide
      if PassT[V] = 1 then
        D = 0
        StartMove
        TActed = 1
      elseif TSide = KDirt then
        DigR = Mr
        DigC = Mc + TDx
        StartDig
        TActed = 1
      elseif TSide = KGas then
        DigR = Mr
        DigC = Mc + TDx
        StartDig
        TActed = 1
      elseif TSide = KRock then
        Gr = Mr
        Gc = Mc + TDx
        Gc += TDx
        Free
        if V = 1 then
          PushOn = 1
          PushT = 0
          PushDx = TDx
          TActed = 1
        end if
      end if
    end if
  elseif TU = 1 then
    if TClimb = 1 then
      D = 255
      StartMove
      EvClimb = 1
      TActed = 1
    elseif TUp = KDirt then
      DigR = Mr - 1
      DigC = Mc
      StartDig
      TActed = 1
    elseif TUp = KGas then
      DigR = Mr - 1
      DigC = Mc
      StartDig
      TActed = 1
    end if
  elseif TD = 1 then
    if TBel = KDirt then
      DigR = Mr + 1
      DigC = Mc
      StartDig
      TActed = 1
    elseif TBel = KGas then
      DigR = Mr + 1
      DigC = Mc
      StartDig
      TActed = 1
    elseif THere = KBeam then
      V = TBel
      if PassT[V] = 1 then
        D = 1
        StartMove
        TActed = 1
      end if
    end if
  end if
  if TActed = 1 then
    Trap = 0
    return
  end if
  ' stuck detector: nothing to do and nothing moving that could change it
  CanAct
  if V = 0 then
    if FuN = 0 then
      if FallCnt = 0 then
        inc Trap
        if Trap >= TTrap then
          K = 4
          DoKill
        end if
        return
      end if
    end if
  end if
  Trap = 0
  return
end sub

sub StartDig:
  DigOn = 1
  DigT = 0
  DigLook
  return
end sub

' the dig tiles: which crumbling picture (dirt 7-9, gas 10-12 in CellP)
sub DigLook:
  Gr = DigR
  Gc = DigC
  MGet
  DigVis = 0
  V = DigT / 2
  if Gk = KDirt then
    DigVis = 1
    DigGi = 7 + V
  end if
  if Gk = KGas then
    DigVis = 1
    DigGi = 10 + V
  end if
  return
end sub

sub DepthUp:
  W = Lv * H
  W += Mr
  if W > DepthMax then DepthMax = W
  return
end sub

' can the miner do anything at all? -> V
sub CanAct:
  V = 0
  for Sk = 0 to 1
    if Sk = 0 then
      TDx = 255
    else
      TDx = 1
    end if
    Gr = Mr
    Gc = Mc + TDx
    MGet
    S = Gk
    N = PassT[S]
    if N = 1 then V = 1
    if S = KDirt then V = 1
    if S = KGas then V = 1
    if S = KRock then
      Gc += TDx
      Free
      if V = 1 then Sk = 1
    end if
    if V = 1 then return
    N = PassT[TUp]
    if N = 1 then
      Gr = Mr - 1
      Gc = Mc + TDx
      MGet
      S = Gk
      N = PassT[S]
      if N = 1 then V = 1
    end if
    if V = 1 then return
  next
  if TUp = KDirt then V = 1
  if TUp = KGas then V = 1
  if TBel = KDirt then V = 1
  if TBel = KGas then V = 1
  if THere = KBeam then
    N = PassT[TUp]
    if N = 1 then V = 1
    N = PassT[TBel]
    if N = 1 then V = 1
  end if
  if THere = KEmpty then
    if Beams > 0 then
      N = PassT[TUp]
      if N = 1 then V = 1
    end if
  end if
  return
end sub

' a blast at (Er, Ec): 3 x 3
sub Explode:
  EvBoom = 1
  inc Booms
  BoomT = TBoom
  BoomX = Ec * 16
  BoomY = Er
  BoomY = BoomY * 16
  Hi = 0
  R = Er
  C = Ec
  for Fi = 0 to 8
    ' (Fi is free here: the fuse loop leaves it as the index of a removed entry)
    Gr = R - 1
    J = Fi / 3
    Gr += J
    Gc = C - 1
    J = Fi mod 3
    Gc += J
    if Gr < H then
      if Gc < 14 then
        if Gr = Mr then
          if Gc = Mc then Hi = 1
        end if
        MGet
        if Gk = KGas then
          Gk = KFuse
          MSet
          K = TChain
          AddFuse
        elseif Gk = KRock then
          Gk = KEmpty
          MSet
          Pts = 10
          AddScore
        elseif Gk = KRockF then
          Gk = KEmpty
          MSet
          dec FallCnt
          Pts = 10
          AddScore
        elseif Gk = KDirt then
          Gk = KEmpty
          MSet
        elseif Gk = KBeam then
          Gk = KEmpty
          MSet
        elseif Gk = KFuse then
          if Fi = 4 then
            Gk = KEmpty
            MSet
          end if
        end if
      end if
    end if
  next
  Er = R
  Ec = C
  if Hi = 1 then
    K = 2
    DoKill
  end if
  return
end sub

sub PhysStep:
  if Dead = 0 then
    if ClearT = 0 then
      KillReq = 0
      LandN = 0
      call asm FmPhysA
      if KillReq = 1 then
        K = 1
        DoKill
      end if
      if LandN > 0 then
        if LandWait = 0 then
          ' a thud when a landing is on the screen
          W = LandRow
          W = W * 16
          W2 = CamY + 160
          if W >= CamY then
            if W < W2 then
              play sound SndLand
              LandWait = 6
            end if
          end if
        end if
      end if
    end if
  end if
  inc Chunk
  if Chunk >= 15 then Chunk = 0
  if LandWait > 0 then dec LandWait
  return
end sub

' the camera: the miner 72 px below the top of the view, 2 px a tick at most
sub Camera:
  W = 0
  if Py > 72 then W = Py - 72
  if W > 800 then W = 800
  if W > CamY then
    W2 = W - CamY
    if W2 > 2 then W2 = 2
    CamY += W2
  elseif W < CamY then
    W2 = CamY - W
    if W2 > 2 then W2 = 2
    CamY -= W2
  end if
  ' dig tiles: the screen rows of the cell being dug
  if DigVis = 1 then
    Si = DigR
    Si = Si * 16
    Si -= CamY
    V = lowbyte Si
    DigO = V & 7
    Si = Si >> 3
    DigJ0 = lowbyte Si
    DigNr = 3
    if DigO = 0 then DigNr = 2
  end if
  return
end sub

sub Sounds:
  if EvDie = 1 then
    play sound SndDie
  elseif EvClear = 1 then
    play sound SndClear
  elseif EvBoom = 1 then
    play sound SndBoom
  elseif EvOpen = 1 then
    play sound SndOpen
  elseif EvGem = 1 then
    play sound SndGem
  elseif EvFuse = 1 then
    play sound SndFuse
  elseif EvPush = 1 then
    play sound SndPush
  elseif EvBeam = 1 then
    play sound SndBeam
  elseif EvDig = 1 then
    play sound SndDig
  elseif EvClimb = 1 then
    play sound SndClimb
  end if
  if EvGem = 1 then HudAll
  if EvOpen = 1 then HudAll
  if EvDie = 1 then HudAll
  EvDie = 0
  EvClear = 0
  EvBoom = 0
  EvOpen = 0
  EvGem = 0
  EvFuse = 0
  EvPush = 0
  EvBeam = 0
  EvDig = 0
  EvClimb = 0
  return
end sub

' ===========================================================================
' HUD (icons): row 1 lamp + oil gauge, gem slots (got / still needed), the
' lift icon when open, score; row 22 beams, lives, mine number

sub OilHud:
  ' gauge segments (each 1/8 of the full lamp), changed only at a step
  if Oil <= OilLo then
    if OilSeg > 0 then
      dec OilSeg
      OilLo -= OilQ
      if OilSeg = 0 then OilLo = 0
      OilBar
    end if
  end if
  W = OilLo + OilQ
  W += OilQ
  if OilSeg < 8 then
    if Oil > W then
      inc OilSeg
      OilLo += OilQ
      OilBar
    end if
  end if
  ' the last segment blinks (1 Hz) when the lamp is nearly dry
  if OilSeg <= 1 then OilBar
  return
end sub

sub OilBar:
  call asm FmOilBar
  return
end sub

sub HudAll:
  call asm FmHudAll
  return
end sub

sub HudScore:
  for Hi = 0 to 4
    V = ScD[Hi]
    HudT[Hi + 23] = HD0 + V
  next
  return
end sub

' ===========================================================================
' sprites (frame B): the miner, popup, fuse sparks, blast, lift; a sprite
' joins only if no line of it already has 4 (the miner always has room)

sub AddSpr:
  ' in: Si = screen top (playfield 0..159), K = pattern, N = colour, X
  if SpN >= 8 then return
  if Si < -15 then return
  if Si > 167 then return
  V = 0
  W = Si + 16
  for Sk = 0 to 7
    if Sk < SpN then
      Y = SpY[Sk]
      W2 = Y
      ' overlap of [W-16, W) with [Y, Y+16)
      if W > W2 then
        W2 += 32
        if W < W2 then inc V
      end if
    end if
  next
  if V >= 4 then return
  W = Si + 16
  J = lowbyte W
  SpY[SpN] = J
  V = SpN * 4
  W = Si + 15
  SatBuf[V] = lowbyte W
  SatBuf[V + 1] = X
  SatBuf[V + 2] = K
  SatBuf[V + 3] = N
  inc SpN
  return
end sub

sub MakeSat:
  SpN = 0
  ' the miner: helmet (yellow, on top) + body (light blue)
  K = SHRStand
  if Dead > 0 then
    K = SHRDead
  elseif MvOn = 1 then
    if MvDy = 1 then
      K = SHRFall
    elseif MvDy = 255 then
      K = SHRClimb1
      V = MvT & 4
      if V > 0 then K = SHRClimb2
    else
      K = SHRWalk1
      V = MvT & 4
      if V > 0 then K = SHRWalk2
    end if
  elseif DigOn = 1 then
    K = SHRDig1
    V = DigT & 2
    if V > 0 then K = SHRDig2
  elseif PushOn = 1 then
    K = SHRWalk1
  end if
  if Face = 255 then K += 72
  Si = Py
  Si -= CamY
  X = Px + 16
  N = 11
  if Dead > 0 then N = 9
  AddSpr
  K += 4
  N = 5
  if Dead > 0 then N = 8
  AddSpr
  ' the score popup rises from the gem
  if PopT > 0 then
    Si = PopY
    Si -= CamY
    V = TPop - PopT
    Si -= V
    X = PopX + 16
    K = SPop50
    N = 15
    AddSpr
  end if
  ' fuse sparks (2.5 Hz): the two oldest fuses
  for Fi = 0 to 1
    if Fi < FuN then
      Si = FuR[Fi]
      Si = Si * 16
      Si -= CamY
      V = FuC[Fi]
      X = V * 16
      X += 16
      K = SSpark1
      N = 11
      V = Tick & 24
      if V >= 16 then
        K = SSpark2
        N = 8
      end if
      AddSpr
    end if
  next
  if BoomT > 0 then
    Si = BoomY
    Si -= CamY
    X = BoomX + 16
    K = SBoom1
    N = 15
    if BoomT < 5 then
      K = SBoom2
      N = 11
    end if
    AddSpr
  end if
  ' the lift (red: closed, green: open)
  LiftSpr
  V = SpN * 4
  SatBuf[V] = 208
  return
end sub

sub LiftSpr:
  V = Lv
  while V >= NLev
    V -= NLev
  end while
  Si = 58 * 16
  Si -= CamY
  X = ExitC[V]
  X = X * 16
  X += 16
  K = SLift
  N = 8
  if Gems >= Quota then N = 3
  AddSpr
  return
end sub

' ===========================================================================
' screens

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  call asm FmMenuVdp
  ' (the BIOS screen set-up changes IX: kept for the callers' frames)
  asm {
    push ix
  }
  tile screen
  asm {
    pop ix
  }
  sprites 16x16
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub PlayEnd:
  Rearm
  wait
  nmi off
  display off
  call asm FmMenuVdp
  return
end sub

sub CardPage:
  NewScreen
  V = Lv + 1
  NumU = V
  print at 12,6, "MINE"
  print at 17,6, digits$(NumU, 1)
  if V >= 10 then print at 17,6, digits$(NumU, 2)
  print at 9,10, "FIND"
  NumU = Quota
  V = Lv
  while V >= NLev
    V -= NLev
  end while
  NumU = QuotaT[V]
  print at 14,10, digits$(NumU, 1)
  print at 16,10, "GEMS"
  put char TIcGem at 21,10
  print at 7,13, "THE LIFT IS"
  NumU = Lv * 60
  NumU += 58
  print at 19,13, digits$(NumU, 3)
  print at 23,13, "M"
  print at 9,15, "DOWN"
  put char TIcLift at 14,15
  Hi = 0
  while Hi < Lives
    V = Hi * 2
    V += 13
    put char TIcLife at V,19
    inc Hi
  end while
  ShowScreen
  Waited = 0
  Rearm
  wait no fire
  nmi off
cp_loop:
  Frame1
  ReadPad
  inc Waited
  if Press = 1 then
    if Waited > 20 then goto cp_done
  end if
  if Waited < 120 then goto cp_loop
cp_done:
  return
end sub

sub OverPage:
  NewScreen
  print at 10,5, "GAME OVER"
  print at 8,9, "SCORE"
  NumU = Score
  print at 16,9, digits$(NumU, 5)
  print at 8,11, "DEEPEST"
  NumU = DepthMax
  print at 16,11, digits$(NumU, 4)
  print at 21,11, "M"
  print at 8,13, "MINES"
  NumU = Clears
  print at 16,13, digits$(NumU, 2)
  print at 8,15, "GEMS"
  put char TIcGem at 13,15
  NumU = GemsTot
  print at 16,15, digits$(NumU, 3)
  print at 6,20, "PRESS A BUTTON"
  ShowScreen
  play sound SndOver
  return
end sub

' the title: logo, menu, a little mine scene (miner, rolling boulder,
' sparkling gems), the tune loops (A then B, 30 s)
sub TitlePage:
  NewScreen
  Logo
  ' the scene: a tunnel (rows 19-20) over a strip of dirt with gems (rows 21-22)
  for Hi = 2 to 29
    put char TLgWall0 at Hi,18
    V = Hi & 3
    K = TLgDirt
    if V = 1 then K = TLgGem0
    if Hi = 9 then K = TLgGas0
    if Hi = 21 then K = TLgGas0
    put char K at Hi,21
    K = TLgDirt2
    if V = 1 then K = TLgGem1
    if Hi = 9 then K = TLgGas1
    if Hi = 21 then K = TLgGas1
    put char K at Hi,22
  next
  put char TLgBeam0 at 26,19
  put char TLgBeam1 at 26,20
  Menu = 0
  ShowMenu
  TsX = 0
  TsR = 200
  TsF = 0
  TsSp = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitleScene
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu = 0 then
          Menu = 2
        else
          dec Menu
        end if
      else
        inc Menu
        if Menu = 3 then Menu = 0
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  mute all
  HideSprites
  return
end sub

sub ShowMenu:
  for Hi = 0 to 2
    V = Hi * 2
    V += 13
    put char 32 at 9,V
  next
  print at 11,13, "START"
  print at 11,15, "HOW TO PLAY"
  print at 11,17, "CREDITS"
  V = Menu * 2
  V += 13
  put char 62 at 9,V
  return
end sub

' FIRE / DAMP in 5 x 5 block letters (rows 1-5 and 7-11, columns 4-26)
sub Logo:
  for Hi = 0 to 7
    for Sk = 0 to 4
      V = LogoT[Hi * 5 + Sk]
      for J = 0 to 4
        N = 16 >> J
        N = V & N
        if N > 0 then
          X = Hi & 3
          X = X * 6
          X += 4
          X += J
          Y = 1
          if Hi >= 4 then Y = 7
          Y += Sk
          put char TLgFull at X,Y
        end if
      next
    next
  next
  return
end sub


sub TitleScene:
  inc TsF
  ' the miner walks right along the tunnel, digs a little, walks on
  V = TsF & 1
  if V = 0 then inc TsX
  if TsX > 224 then TsX = 16
  if TsX < 16 then TsX = 16
  ' a boulder rolls the other way, faster
  TsR -= 1
  if TsR < 16 then TsR = 224
  K = SHRWalk1
  V = TsF & 8
  if V > 0 then K = SHRWalk2
  clear sprites
  set sprite count 8
  set sprite 0 to 151,TsX,K,11
  K += 4
  set sprite 1 to 151,TsX,K,5
  ' the boulder turns as it rolls (its highlight moves round)
  K = SRockhi
  V = TsF & 12
  if V = 4 then K = SRockhi2
  if V = 8 then K = SRockhi3
  if V = 12 then K = SRockhi4
  set sprite 2 to 151,TsR,K,15
  set sprite 3 to 151,TsR,SRock,14
  ' a gem sparkles (2 Hz), one after another
  V = TsF / 32
  V = V & 7
  X = V * 32
  X += 4
  V = TsF & 16
  if V > 0 then
    set sprite 4 to 167,X,SSparkle,15
  else
    set sprite 4 to 209,X,SSparkle,15
  end if
  for J = 5 to 7
    set sprite J to 209,0,0,0
  next
  call asm PcSpr
  return
end sub

sub HowTo:
  Page = 0
how_page:
  NewScreen
  NumU = Page + 1
  print at 5,1, "HOW TO PLAY"
  print at 19,1, digits$(NumU, 1)
  print at 20,1, "/3"
  if Page = 0 then
    print at 3,4, "DIG DOWN TO THE LIFT."
    print at 3,6, "IT OPENS WHEN YOU HAVE"
    print at 3,8, "FOUND ENOUGH GEMS:"
    put char TIcGem at 22,8
    put char TIcGem at 24,8
    put char TIcLift at 26,8
    print at 3,11, "YOUR LAMP BURNS OIL."
    put char TIcLamp at 25,11
    put char TIcOil at 26,11
    put char TIcOil at 27,11
    print at 3,13, "EACH GEM ADDS OIL."
    print at 3,16, "DIG DEEPER FOR POINTS,"
    print at 3,18, "GEMS ARE 50 EACH."
  elseif Page = 1 then
    print at 3,4, "STICK: WALK AND DIG."
    print at 3,6, "PUSH A ROCK SIDEWAYS."
    print at 3,8, "UP+SIDE: STEP UP A LEDGE"
    print at 3,11, "BUTTON: SET A BEAM."
    put char TLgBeam0 at 25,11
    put char TLgBeam1 at 25,12
    print at 3,13, "IT HOLDS UP THE ROCKS"
    print at 3,15, "AND IS A LADDER (UP)."
    print at 3,18, "HOLD THE BUTTON 2 S:"
    print at 3,20, "GIVE UP THIS TRY."
  else
    print at 3,4, "ROCKS FALL WHEN YOU DIG"
    print at 3,6, "UNDER THEM, AND ROLL"
    print at 3,8, "OFF OTHER ROCKS."
    put char TLgRock00 at 26,6
    put char TLgRock01 at 27,6
    put char TLgRock10 at 26,7
    put char TLgRock11 at 27,7
    print at 3,11, "GREEN GAS IS FIREDAMP!"
    put char TLgGas0 at 27,11
    put char TLgGas1 at 27,12
    print at 3,13, "DIG IT AND RUN: BOOM"
    print at 3,15, "IN ONE SECOND. BLASTS"
    print at 3,17, "CLEAR ROCK AND DIRT."
  end if
  print at 5,22, "BUTTON: NEXT PAGE"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Waited = 0
hw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then return
  if Press = 0 then goto hw_loop
  inc Page
  if Page < 3 then goto how_page
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,3, "FIREDAMP"
  print at 4,6, "A GAME BY AMY & CLAUDE"
  print at 8,8, "AMY STUDIO 2026"
  print at 6,10, "MADE IN AMY FOR THE"
  print at 9,12, "COLECOVISION"
  print at 3,15, "AN ORIGINAL GAME."
  print at 3,17, "FIREDAMP IS WHAT MINERS"
  print at 3,19, "CALL THE GAS THAT BURNS."
  print at 7,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Waited = 0
cr_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then return
  if Press = 0 then goto cr_loop
  return
end sub

' ===========================================================================
' engine (Z80)

asm {
; FIREDAMP engine (Z80). Called from Amy with `call asm FmXxxA`; the A
; routines keep IX and IY. VRAM data accesses outside the vertical blank
; are 29 cycles apart or more (counted in the comments where it is tight).
; Map bytes: 2 x visual kind (0 empty, 2 dirt, 4 wall, 6 rock, 8 gem,
; 10 gas, 12 beam) + 16 for the variants (22 falling rock, 26 lit gas,
; 16 the lift): byte AND 15 is what the scroll tables want.
FmMap   EQU $0800           ; the mine: row r, column c at FmMap + 16r + c

; ---------------------------------------------------------------- VDP address
FmWa:                       ; write address HL
        ld a,l
        out (VDP_CTRL_PORT),a
        ld a,h
        or $40
        out (VDP_CTRL_PORT),a
        ret
FmRa:                       ; read address HL
        ld a,l
        out (VDP_CTRL_PORT),a
        ld a,h
        and $3F
        out (VDP_CTRL_PORT),a
        ret
FmRowAddr:                  ; A = row -> HL = FmMap + 16 A
        ld l,a
        ld h,0
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        ld a,h
        add a,FmMap/256
        ld h,a
        ret

; ---------------------------------------------------------------- one cell
FmGet:                      ; (Gr, Gc) -> A = map byte; outside the mine: wall
        ld a,(Gc)
        cp 14
        jr nc,FmGetW
        ld e,a
        ld a,(Gr)
        cp 60
        jr nc,FmGetW
        call FmRowAddr
        ld a,l
        add a,e
        ld l,a
        call FmRa
        nop
        nop
        nop
        nop
        in a,(VDP_DATA_PORT)
        ret
FmGetW:
        ld a,4
        ret
FmSet:                      ; (Gr, Gc) := Gk (inside the mine only)
        ld a,(Gc)
        cp 14
        ret nc
        ld e,a
        ld a,(Gr)
        cp 60
        ret nc
        call FmRowAddr
        ld a,l
        add a,e
        ld l,a
        call FmWa
        ld a,(Gk)
        nop
        nop
        out (VDP_DATA_PORT),a
        ; the window copy (rows WinR0 .. WinR0+10)
        ld a,(Gr)
        ld hl,WinR0
        sub (hl)
        cp 11
        ret nc
        ld a,(Gr)
        call FmSlot             ; HL = the row's window slot
        ld a,(Gc)
        add a,l
        ld l,a
        jr nc,FmSet1
        inc h
FmSet1:
        ld a,(Gk)
        and $0F
        ld (hl),a
        ret
FmSlot:                         ; A = map row -> HL = Win + 14 * (row mod 11)
        ld hl,SlotOff
        add a,l
        ld l,a
        jr nc,FmSl1
        inc h
FmSl1:
        ld a,(hl)
        ld hl,Win
        add a,l
        ld l,a
        ret nc
        inc h
        ret

; ---------------------------------------------------------------- map rows
FmRdRow:                    ; A = row -> 14 bytes at DE (walls below the mine)
        cp 60
        jr nc,FmRdW
        call FmRowAddr
        call FmRa
        ld b,14
        nop
        nop
FmRd1:
        in a,(VDP_DATA_PORT)    ; 11 + 7 + 6 + 13 = 37
        ld (de),a
        inc de
        djnz FmRd1
        ret
FmRdW:
        ld b,14
        ld a,4
FmRdW1:
        ld (de),a
        inc de
        djnz FmRdW1
        ret
FmWrRow:                    ; A = row <- 14 bytes at DE (and the window copy)
        push af
        push de
        call FmRowAddr
        call FmWa
        ld b,14
FmWr1:
        ld a,(de)
        out (VDP_DATA_PORT),a   ; 8 + 12 + 7 + 14 = 41
        inc de
        djnz FmWr1
        pop de
        pop af
        ld hl,WinR0
        ld b,a
        sub (hl)
        cp 11
        ret nc
        ld a,b
        call FmSlot
        ld b,14
FmWr2:
        ld a,(de)
        and $0F
        ld (hl),a
        inc de
        inc hl
        djnz FmWr2
        ret

; ---------------------------------------------------------------- physics
; one chunk: rows PhTop+4 .. PhTop, bottom-up; PhTop = 55 - 5 Chunk.
; RowB = the row below (r+1), RowC = row r; each has a wall at [0] and [15].
FmPhysA:
        push ix
        push iy
        call FmPhys
        pop iy
        pop ix
        ret
FmPhys:
        ld a,(Chunk)
        add a,a
        add a,a
        ld b,a
        ld a,56
        sub b
        ld (PhTop),a            ; rows PhTop+3 .. PhTop (4 a frame, 15 frames a sweep)
        add a,3
        ld (PhR),a
        ld hl,RowB
        ld (PtrB),hl
        ld hl,RowC
        ld (PtrC),hl
        inc a
        ld de,RowB+1
        call FmRdRow
        xor a
        ld (PhDB),a
FmPh1:
        ld a,(PhR)
        ld de,(PtrC)
        inc de
        call FmRdRow
        xor a
        ld (PhDC),a
        call FmPhRow
        ld a,(PhDB)
        or a
        jr z,FmPh2
        ld a,(PhR)
        inc a
        cp 60
        jr nc,FmPh2
        ld de,(PtrB)
        inc de
        call FmWrRow
FmPh2:
        ld hl,(PtrB)            ; this row becomes the row below
        ld de,(PtrC)
        ld (PtrB),de
        ld (PtrC),hl
        ld a,(PhDC)
        ld (PhDB),a
        ld a,(PhTop)
        ld b,a
        ld a,(PhR)
        cp b
        jr z,FmPh3
        dec a
        ld (PhR),a
        jr FmPh1
FmPh3:
        ld a,(PhDB)
        or a
        ret z
        ld a,(PhTop)
        ld de,(PtrB)
        inc de
        jp FmWrRow

; the cells of row PhR (RowC) over RowB, left to right (B = 14 - column)
FmPhRow:
        ld a,(PhR)
        ld b,a
        ld c,255
        ld a,(Mr)
        cp b
        jr nz,FmPr0
        ld a,(Mc)
        ld c,a
FmPr0:
        ld a,c
        ld (PhMC),a             ; the miner's column in this row (255: none)
        ld c,255
        ld a,(Mr)
        dec a
        cp b
        jr nz,FmPr1
        ld a,(Mc)
        ld c,a
FmPr1:
        ld a,c
        ld (PhMB),a             ; ... in the row below
        ld hl,(PtrC)
        inc hl
        ld de,(PtrB)
        inc de
        ld b,14
FmPrL:
        ld a,(hl)
        and $0F
        cp 6
        jr z,FmPrR
FmPrN:
        inc hl
        inc de
        djnz FmPrL
        ret
FmPrR:
        ld c,(hl)               ; C = 6 resting, 22 falling
        ld a,(de)
        or a
        jr nz,FmPrB
        ld a,14
        sub b                   ; column
        push hl
        ld hl,PhMB
        cp (hl)
        pop hl
        jr z,FmPrM
        ; the cell below is free: fall
        ld a,22
        ld (de),a
        xor a
        ld (hl),a
        inc a
        ld (PhDB),a
        ld (PhDC),a
        jr FmPrCnt
FmPrM:
        ; the miner is below: a falling rock crushes him (and stops)
        ld a,c
        cp 22
        jr nz,FmPrN
        ld (hl),6
        ld a,1
        ld (KillReq),a
        ld (PhDC),a
        ld a,(FallCnt)
        dec a
        ld (FallCnt),a
        jr FmPrN
FmPrB:
        cp 6                    ; on a resting rock: roll off it
        jr nz,FmPrLand
        dec hl                  ; left: (r, c-1), (r+1, c-1) free (pads are walls)
        dec de
        ld a,(hl)
        or a
        jr nz,FmPrL0
        ld a,(de)
        or a
        jr nz,FmPrL0
        ld a,13
        sub b
        call FmPrMin
        jr z,FmPrL0
        ld (hl),22
        inc hl
        inc de
        ld (hl),0
        ld a,1
        ld (PhDC),a
        jr FmPrCnt
FmPrL0:
        inc hl
        inc de
        inc hl                  ; right: (r, c+1), (r+1, c+1)
        inc de
        ld a,(hl)
        or a
        jr nz,FmPrR0
        ld a,(de)
        or a
        jr nz,FmPrR0
        ld a,15
        sub b
        call FmPrMin
        jr z,FmPrR0
        ld (hl),22
        dec hl
        ld (hl),0
        inc hl                  ; HL, DE at c+1: skipped (B >= 2 here)
        dec b
        ld a,1
        ld (PhDC),a
        jr FmPrCnt
FmPrR0:
        dec hl
        dec de
FmPrLand:
        ld a,c
        cp 22
        jr nz,FmPrN
        ld (hl),6
        ld a,1
        ld (PhDC),a
        ld a,(FallCnt)
        dec a
        ld (FallCnt),a
        ld a,(LandN)
        inc a
        ld (LandN),a
        ld a,(PhR)
        ld (LandRow),a
        jr FmPrN
FmPrCnt:
        ld a,c                  ; a resting rock set off: one more falling
        cp 6
        jr nz,FmPrN
        ld a,(FallCnt)
        inc a
        ld (FallCnt),a
        jr FmPrN
FmPrMin:                        ; Z if column A holds the miner (this row or below)
        push hl
        ld hl,PhMC
        cp (hl)
        jr z,FmPrMi1
        ld hl,PhMB
        cp (hl)
FmPrMi1:
        pop hl
        ret

; ---------------------------------------------------------------- the window
; 11 map rows from CamY / 16, low nibble only (= 2 x visual kind), 14 a row
FmWinA:
        ld hl,(CamY)
        srl h
        rr l
        srl h
        rr l
        srl h
        rr l
        srl h
        rr l
        ld a,(WinOk)
        or a
        jr z,FmWiAll
        ld a,(WinR0)
        cp l
        ret z                   ; same rows: the window is up to date
        ld b,a                  ; B = old first row
        ld a,l
        ld (WinR0),a
        ; read rows r of the new range that were not in the old one
        ld c,a
        ld e,11
FmWi1:
        ld a,c
        sub b
        cp 11
        jr c,FmWi2              ; already there
        push bc
        push de
        ld a,c
        call FmWinRow
        pop de
        pop bc
FmWi2:
        inc c
        dec e
        jr nz,FmWi1
        ret
FmWiAll:
        ld a,l
        ld (WinR0),a
        ld a,1
        ld (WinOk),a
        ld a,l
        ld e,11
FmWi3:
        push af
        push de
        call FmWinRow
        pop de
        pop af
        inc a
        dec e
        jr nz,FmWi3
        ret
FmWinRow:                       ; map row A -> its window slot (walls below the mine)
        push af
        call FmSlot
        ex de,hl
        pop af
        cp 60
        jr nc,FmWrW
        call FmRowAddr
        call FmRa
        ld b,14
        nop
        nop
FmWr3:
        in a,(VDP_DATA_PORT)    ; 12 + 8 + 8 + 7 + 14 = 49
        and $0F
        ld (de),a
        inc de
        djnz FmWr3
        ret
FmWrW:
        ld b,14
        ld a,4
FmWrW1:
        ld (de),a
        inc de
        djnz FmWrW1
        ret

; ---------------------------------------------------------------- names
; FmBuildA: the frame-A half: prepare, screen rows 2-11 (j 0-9), HUD row 1
; FmBuildB: rows 12-21 (j 10-19), HUD row 22. Into the hidden page.
FmBuildA:
        push ix
        push iy
        ld a,(PgS)
        or a
        ld a,$1C
        ld b,PoolB
        jr z,FmBa0
        ld a,$18
        ld b,PoolA
FmBa0:
        ld (BPg),a
        ld a,b
        ld (BPool),a
        ; the table page of this shift
        ld a,(CamY)
        and 6
        rrca
        ld b,a
        ld hl,ScrTab
        ld a,h
        add a,b
        ld (BTabH),a
        ; BR0 = CamY / 8
        ld hl,(CamY)
        srl h
        rr l
        srl h
        rr l
        srl h
        rr l
        ld a,l
        ld (BR0),a
        xor a
        call FmRows
        ld a,(BPg)              ; HUD row 1
        ld h,a
        ld l,32 + 2
        call FmWa
        ld hl,HudT
        ld b,28
        call FmOutSlow
        pop iy
        pop ix
        ret
FmBuildB:
        push ix
        push iy
        ld a,10
        call FmRows
        ld a,(BPg)              ; HUD row 22
        add a,2
        ld h,a
        ld l,$C2
        call FmWa
        ld hl,HudB
        ld b,28
        call FmOutSlow
        pop iy
        pop ix
        ret
FmOutSlow:                      ; B bytes from HL, 29+ cycles apart
        ld a,(hl)
        nop
        nop
        out (VDP_DATA_PORT),a   ; 7 + 8 + 11 + 6 + 13 = 45
        inc hl
        djnz FmOutSlow
        ret

; screen rows j = A .. A+9 of the hidden page
FmRows:
        ld (BJ),a
        ld a,10
        ld (BN),a
        ld a,(BJ)
        add a,2
        ld l,a
        ld h,0
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        inc hl
        inc hl
        ld a,(BPg)
        add a,h
        ld h,a
        ld (BAddr),hl
        ; map char row R = BR0 + j: cell row R/2, half R&1
        ld a,(BJ)
        ld b,a
        ld a,(BR0)
        add a,b
        ld c,a
        and 1
        ld (BHalf),a
        ld a,c
        srl a
        ld (BCr),a
FmRw1:
        ld hl,(BAddr)
        call FmWa
        ld a,(BCr)
        call FmSlot
        ld a,(BTabH)
        ld d,a
        ld a,(BHalf)
        or a
        jp nz,FmRwI
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,112
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        jp FmRwD
FmRwI:
        push hl
        ld a,(BCr)
        inc a
        call FmSlot
        push hl
        exx
        pop hl                  ; HL' = the row below
        exx
        pop hl
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld a,(hl)
        inc hl
        add a,a
        add a,a
        add a,a
        exx
        add a,(hl)
        inc hl
        exx
        ld e,a
        ld a,(de)
        out (VDP_DATA_PORT),a
        inc e
        ld a,(de)
        nop
        out (VDP_DATA_PORT),a
        ld hl,BCr               ; the next cell row
        inc (hl)
FmRwD:
        call FmRoD
        ld a,(BHalf)
        xor 1
        ld (BHalf),a
        ld hl,(BAddr)
        ld bc,32
        add hl,bc
        ld (BAddr),hl
        ld hl,BJ
        inc (hl)
        ld hl,BN
        dec (hl)
        jp nz,FmRw1
        ret
FmRoD:
        ; the cell being dug: its names point at the dig pool
        ld a,(DigVis)
        or a
        ret z
        ld a,(DigJ0)
        ld b,a
        ld a,(BJ)
        sub b                   ; jj = j - j0 (mod 256)
        ld b,a
        ld a,(DigNr)
        ld c,a
        ld a,b
        cp c
        ret nc
        ld a,(DigC)
        add a,a
        ld e,a
        ld d,0
        ld hl,(BAddr)
        add hl,de
        call FmWa
        ld a,b
        add a,a
        ld b,a
        ld a,(BPool)
        add a,b
        nop
        nop
        out (VDP_DATA_PORT),a
        inc a
        nop
        nop
        nop
        nop
        nop
        out (VDP_DATA_PORT),a
        ret

; ---------------------------------------------------------------- dig tiles
; the hidden pool's tiles k = 2 jj + col: pixel row y shows the cell-relative
; row Y = 8 jj + y - DigO of: the cell above (Y < 0), the dig picture DigGi
; (0..15), the cell below (Y > 15). Sources: CellP / CellC rows of 16.
FmDigA:
        ld a,(DigVis)
        or a
        ret z
        push ix
        push iy
        ld a,(DigR)
        dec a
        ld (Gr),a
        ld a,(DigC)
        ld (Gc),a
        call FmGet
        and $0F
        srl a
        ld (DgUp),a
        ld a,(DigR)
        inc a
        ld (Gr),a
        call FmGet
        and $0F
        srl a
        ld (DgDn),a
        ; the key of this pool's picture: unchanged -> nothing to write
        xor a
        ld (DgSame),a
        ld hl,DgKey
        ld a,(BPool)
        cp PoolA
        jr z,FmDk0
        ld hl,DgKey+4
FmDk0:
        ld de,DigGi
        call FmDkCmp
        ld de,DigO
        call FmDkCmp
        ld de,DgUp
        call FmDkCmp
        ld de,DgDn
        call FmDkCmp
        ld a,(DgSame)
        cp 4
        jr z,FmDaX
        ld c,0
FmDa2:
        ; Y0 = 8 jj - DigO; runs: [above rows Y0+16..15] [picture rows] [below rows 0..]
        ld a,c
        and 1
        ld b,a
        ld a,c
        and $FE
        add a,a
        add a,a
        ld e,a
        ld a,(DigO)
        ld d,a
        ld a,e
        sub d
        ld (DgY),a              ; Y0 (-6 .. 16)
        bit 7,a
        jr z,FmDa3
        ; Y0 < 0: -Y0 rows of the cell above from row Y0+16, then 8+Y0 picture rows from 0
        neg
        ld (DgN1),a
        ld a,(DgUp)
        call FmDaBase
        ld a,(DgY)
        add a,16
        call FmAddA
        ld (DgS1),hl
        ld a,(DigGi)
        call FmDaBase
        ld (DgS2),hl
        ld a,(DgY)
        add a,8
        ld (DgN2),a
        jr FmDa5
FmDa3:
        cp 9
        jr nc,FmDa4
        ; 0 <= Y0 <= 8: 8 picture rows from Y0
        ld a,8
        ld (DgN1),a
        xor a
        ld (DgN2),a
        ld a,(DigGi)
        call FmDaBase
        ld a,(DgY)
        call FmAddA
        ld (DgS1),hl
        jr FmDa5
FmDa4:
        ; Y0 > 8: 16-Y0 picture rows from Y0, then the cell below from row 0
        ld a,16
        ld hl,DgY
        sub (hl)
        ld (DgN1),a
        ld e,a
        ld a,8
        sub e
        ld (DgN2),a
        ld a,(DigGi)
        call FmDaBase
        ld a,(DgY)
        call FmAddA
        ld (DgS1),hl
        ld a,(DgDn)
        call FmDaBase
        ld (DgS2),hl
FmDa5:
        push bc
        ld de,TBuf              ; patterns
        ld bc,0
        call FmDaRun
        ld de,TBuf+8            ; colours
        ld bc,CellC-CellP
        call FmDaRun
        pop bc
        ld a,(BPool)            ; pattern at code * 8, colour at $2000 + code * 8
        add a,c
        ld l,a
        ld h,0
        add hl,hl
        add hl,hl
        add hl,hl
        push hl
        call FmWa
        ld hl,TBuf
        ld b,8
        call FmOutSlow
        pop hl
        ld a,h
        add a,$20
        ld h,a
        call FmWa
        ld hl,TBuf+8
        ld b,8
        call FmOutSlow
        inc c
        ld a,(DigNr)
        add a,a
        cp c
        jp nz,FmDa2
FmDaX:
        pop iy
        pop ix
        ret
FmDaRun:                        ; DgN1 bytes from DgS1 + BC, then DgN2 from DgS2 + BC, to DE
        push bc
        ld hl,(DgS1)
        add hl,bc
        ld a,(DgN1)
        ld c,a
        ld b,0
        ldir
        pop bc
        ld a,(DgN2)
        or a
        ret z
        ld hl,(DgS2)
        add hl,bc
        ld c,a
        ld b,0
        ldir
        ret
FmAddA:                         ; HL += A
        add a,l
        ld l,a
        ret nc
        inc h
        ret
FmDkCmp:                        ; compare (DE) with the key byte (HL), store it, count equal
        ld a,(de)
        cp (hl)
        ld (hl),a
        inc hl
        ret nz
        ld a,(DgSame)
        inc a
        ld (DgSame),a
        ret
FmDaBase:                       ; HL = CellP + (A * 2 + B) * 16
        add a,a
        add a,b
        ld l,a
        ld h,0
        add hl,hl
        add hl,hl
        add hl,hl
        add hl,hl
        ld de,CellP
        add hl,de
        ret

; ---------------------------------------------------------------- frame A start
FmFlipA:                        ; vertical blank: show the page built last tick
        ld a,(PgS)
        xor 1
        ld (PgS),a
FmShow:
        add a,6
        out (VDP_CTRL_PORT),a
        ld a,$82
        out (VDP_CTRL_PORT),a
        ld hl,$1B00
        call FmWa
        ld hl,SatBuf
        ld bc,33*256 + VDP_DATA_PORT
        otir
        ret
FmShowP1:
        ld a,(PgS)
        jr FmShow

; ---------------------------------------------------------------- set-up
FmPlayVram:                     ; display off: play tiles, R4 = 0, both pages black
        ld a,$00
        out (VDP_CTRL_PORT),a
        ld a,$84
        out (VDP_CTRL_PORT),a
        ld hl,$0000
        call FmWa
        ld hl,PlayPat
        ld de,NPlay8
        call FmOutFast
        ld hl,$2000
        call FmWa
        ld hl,PlayCol
        ld de,NPlay8
        call FmOutFast
        ld hl,$1800
        call FmWa
        ld de,768
        call FmZero
        ld hl,$1C00
        call FmWa
        ld de,768
        call FmZero
        ret
FmOutFast:                      ; DE bytes from HL (display off)
        ld a,(hl)
        out (VDP_DATA_PORT),a
        inc hl
        dec de
        ld a,d
        or e
        jr nz,FmOutFast
        ret
FmZero:
        xor a
        out (VDP_DATA_PORT),a
        dec de
        ld a,d
        or e
        jr nz,FmZero
        ret
FmLoadMap:                      ; the mine Lv mod 8 from ROM into VRAM
        xor a
        ld (WinOk),a
        ld a,(Lv)
FmLm0:
        cp 8
        jr c,FmLm1
        sub 8
        jr FmLm0
FmLm1:
        ld l,a
        ld h,0
        ld de,840
        call FmMul              ; HL = 840 * mine
        ld de,LevelData
        add hl,de
        ex de,hl                ; DE = source
        xor a
FmLm2:
        push af
        push de
        call FmRowAddr
        call FmWa
        pop hl
        ld b,14
FmLm3:
        ld a,(hl)
        out (VDP_DATA_PORT),a
        inc hl
        nop
        nop
        djnz FmLm3
        ld a,4
        out (VDP_DATA_PORT),a   ; columns 14, 15: wall
        nop
        nop
        out (VDP_DATA_PORT),a
        ex de,hl
        pop af
        inc a
        cp 60
        jr c,FmLm2
        ret
FmMul:                          ; HL = L * DE (L < 16)
        ld a,l
        ld hl,0
FmMu1:
        or a
        ret z
        add hl,de
        dec a
        jr FmMu1
FmMenuVdp:                      ; back to Amy's screen layout (page $1800, R4 = 3)
        ld a,$06
        out (VDP_CTRL_PORT),a
        ld a,$82
        out (VDP_CTRL_PORT),a
        ld a,$03
        out (VDP_CTRL_PORT),a
        ld a,$84
        out (VDP_CTRL_PORT),a
        ret

; ---------------------------------------------------------------- score digits
FmAddPts:                       ; ScD[0..4] (decimal, ScD[4] = units) += Pts
        push ix
        push iy
        call FmAdd0
        pop iy
        pop ix
        ret
FmAdd0:
        ld hl,(Pts)
        ld ix,FmPow
        ld iy,TBuf
        ld b,5
FmAp1:
        ld e,(ix+0)
        ld d,(ix+1)
        xor a
FmAp2:
        or a
        sbc hl,de
        jr c,FmAp3
        inc a
        jr FmAp2
FmAp3:
        add hl,de
        ld (iy+0),a
        inc iy
        inc ix
        inc ix
        djnz FmAp1
        ld hl,ScD+4
        ld de,TBuf+4
        ld b,5
        ld c,0
FmAp4:
        ld a,(de)
        add a,(hl)
        add a,c
        ld c,0
        cp 10
        jr c,FmAp5
        sub 10
        ld c,1
FmAp5:
        ld (hl),a
        dec hl
        dec de
        djnz FmAp4
        ld a,c
        or a
        ret z
        ld hl,ScD                ; past 99999: stay at 99999
        ld b,5
FmAp6:
        ld (hl),9
        inc hl
        djnz FmAp6
        ret
FmPow:
        dw 10000,1000,100,10,1

SlotOff:                        ; 14 * (row mod 11), rows 0..63
        db 0,14,28,42,56,70,84,98,112,126,140,0,14,28,42,56,70,84,98,112,126,140,0,14,28,42,56,70,84,98,112,126,140,0,14,28,42,56,70,84,98,112,126,140,0,14,28,42,56,70,84,98,112,126,140,0,14,28,42,56,70,84,98,112

; ---------------------------------------------------------------- HUD (fast)
FmOilBar:                       ; HudT[1..8]: OilSeg full, the rest empty; last one blinks red
        ld hl,HudT+1
        ld a,(OilSeg)
        ld c,a
        ld b,0
FmOb1:
        ld a,b
        cp c
        ld a,HOilF
        jr c,FmOb2
        ld a,HOilE
FmOb2:
        ld (hl),a
        inc hl
        inc b
        ld a,b
        cp 8
        jr nz,FmOb1
        ld a,c
        cp 2
        ret nc
        ld a,(Tick)
        and 32
        ld a,HOilL
        jr z,FmOb3
        ld a,HOilE
FmOb3:
        ld (HudT+1),a
        ret
FmHudAll:
        ld hl,HudT
        ld b,28
        xor a
FmHa0:
        ld (hl),a
        inc hl
        djnz FmHa0
        ld hl,HudB
        ld b,28
FmHa0b:
        ld (hl),a
        inc hl
        djnz FmHa0b
        ld a,HLamp
        ld (HudT),a
        call FmOilBar
        ld hl,HudT+10           ; gem slots: got, still needed
        ld a,(Gems)
        ld d,a
        ld a,(Quota)
        ld e,a
        ld b,0
FmHa1:
        ld a,b
        cp d
        ld a,HGemY
        jr c,FmHa2
        ld a,b
        cp e
        ld a,HGemN
        jr c,FmHa2
        xor a
FmHa2:
        ld (hl),a
        inc hl
        inc b
        ld a,b
        cp 9
        jr nz,FmHa1
        ld a,d
        cp e
        jr c,FmHa3
        ld a,HLift
        ld (HudT+20),a
FmHa3:
        ld hl,ScD               ; score digits
        ld de,HudT+23
        ld b,5
FmHa4:
        ld a,(hl)
        add a,HD0
        ld (de),a
        inc hl
        inc de
        djnz FmHa4
        ld a,(Beams)            ; beams, lives
        ld hl,HudB
        call FmHaIc
        ld a,(Lives)
        ld hl,HudB+5
        call FmHaIcL
        ld a,HMine
        ld (HudB+22),a
        ld a,(Lv)
        inc a
        ld b,HD0-1
FmHa5:
        inc b
        sub 10
        jr nc,FmHa5
        add a,10+HD0
        ld (HudB+25),a
        ld a,b
        ld (HudB+24),a
        ret
FmHaIc:                         ; A beam icons at HL (3 at most)
        ld c,HBeam
        jr FmHaI0
FmHaIcL:
        ld c,HLife
FmHaI0:
        or a
        ret z
        cp 4
        jr c,FmHaI1
        ld a,3
FmHaI1:
        ld (hl),c
        inc hl
        dec a
        jr nz,FmHaI1
        ret
