const LogoX = 7
const LogoW = 18

' objects: centre in pixels, speed, phase, counters
u8 PX[8]
u8 PY[8]
i8 Vx[8]
i8 Vy[8]
u8 Ph[8]
u8 StC[8]
u8 FaC[8]
u8 FrC[8]
u8 XHalf[8]
