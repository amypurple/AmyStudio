' random numbers
u16 Rs = 12345
u16 Rt = 0
u8 Rb = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Si = 0
u8 Li = 0
u8 Ci = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X8 = 0
u8 Y8 = 0
i8 E8 = 0
