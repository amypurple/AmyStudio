  tile screen
  set sound table SpSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 4 then
    HowToPage
    goto title
  end if
  if Menu = 5 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: who won, then the title
  mute all
  HideSprites
  print at 8,10, "              "
  if Winner = 0 then
    if Players = 1 then
      print at 8,11, "   YOU WIN!   "
    else
      print at 8,11, "  BLUE WINS!  "
    end if
  else
    if Players = 1 then
      print at 8,11, "COMPUTER WINS!"
    else
      print at 8,11, " GREEN WINS!  "
    end if
  end if
  print at 8,12, "              "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rb = lowbyte Rs
  return
end sub

' a random number 0..N-1 (N up to 255)
function RndTo(u8 N) as u8
  u16 W = 0
  Rnd
  W = Rb * N
  return highbyte W

' ---------------------------------------------------------------------------
' one frame: about 43 ticks a second, so a tick on most frames
sub PlayFrame:
  if Players = 1 then
    ' it thinks on a frame without a tick (the frame budget)
    if AiT > 0 then dec AiT
    if AiT = 0 then
      if Acc < 17 then
        AiThink
        AiT = AiGapT[Level]
      end if
    end if
    J2 = AiPad
  end if
  Acc += TickRate
  if Acc >= 60 then
    Acc -= 60
    DoTick
  end if
  return
end sub

' one pass of the C64's main loop
sub DoTick:
  if TelT > 0 then dec TelT
  if TelT = 0 then
    TelT = 12
    TelPh = 1 - TelPh
    DrawTel
  end if
  Stick(0, J1)
  Stick(1, J2)
  for Mi = 0 to 5
    MoveOne
    FaceOne
    Friction
    Follow(6)
    Follow(7)
  next
  for Mi = 6 to 7
    MoveOne
    FaceOne
    Friction
    Burst
  next
  for Ci = 0 to 1
    for Si = 0 to 5
      Contact
    next
  next
  if GapT > 0 then
    dec GapT
    if GapT = 0 then EndRound
  end if
  return
end sub

' the stick, on the craft's 8-tick beat: the button throws, each
' direction adds 1 to the speed that way
sub Stick(u8 P, u8 Pad):
  u8 O = 0
  if Ex[P] > 0 then return
  dec JoyC[P]
  if JoyC[P] > 0 then return
  JoyC[P] = 8
  O = P + 6
  if (Pad & 16) > 0 then Throw(P, Pad)
  if (Pad & 1) > 0 then SpeedUp(O, 0)
  if (Pad & 2) > 0 then SpeedUp(O, 1)
  if (Pad & 4) > 0 then SpeedUp(O, 2)
  if (Pad & 8) > 0 then SpeedUp(O, 3)
  return
end sub

' one more on a speed: D 0 up, 1 down, 2 left, 3 right (never past 9)
sub SpeedUp(u8 O, u8 D):
  select case D
    case 0
      if Vy[O] > -9 then Vy[O] = Vy[O] - 1
    case 1
      if Vy[O] < 9 then Vy[O] = Vy[O] + 1
    case 2
      if Vx[O] > -9 then Vx[O] = Vx[O] - 1
    case 3
      if Vx[O] < 9 then Vx[O] = Vx[O] + 1
  end select
  return
end sub

' throw the held spheroid at speed 9 the way the stick points
sub Throw(u8 P, u8 Pad):
  u8 B = 0
  i8 Tx = 0
  i8 Ty = 0
  B = Hold[P]
  if B = NoBall then return
  if Arm[B] > 0 then return
  if (Pad & 1) > 0 then Ty = -9
  if (Pad & 2) > 0 then Ty = 9
  if (Pad & 4) > 0 then Tx = -9
  if (Pad & 8) > 0 then Tx = 9
  Vx[B] = Tx
  Vy[B] = Ty
  if Tx = 0 then
    if Ty = 0 then return
  end if
  Carry[B] = 0
  Hold[P] = NoBall
  Arm[B] = ArmLen
  ArmC[B] = 9
  Owner[B] = P + 6
  inc Throws
  play sound SndThrow
  return
end sub

' object Mi's step: on its step tick the phase turns, and each axis whose
' speed reaches the spread value for the phase moves a step (walls turn it)
sub MoveOne:
  u8 P = 0
  u8 S = 0
  u8 A = 0
  if Mi < 6 then
    if Carry[Mi] > 0 then return
  else
    if Ex[Mi - 6] > 0 then return
  end if
  dec StC[Mi]
  if StC[Mi] > 0 then return
  StC[Mi] = StepP[Mi]
  P = Ph[Mi]
  if P = 0 then
    P = 8
  else
    dec P
  end if
  Ph[Mi] = P
  if P = 0 then return
  S = Spread[P]
  E8 = Vx[Mi]
  if E8 > 0 then
    A = E8
    if A >= S then GoRight
  else
    if E8 < 0 then
      A = -E8
      if A >= S then GoLeft
    end if
  end if
  E8 = Vy[Mi]
  if E8 > 0 then
    A = E8
    if A >= S then GoDown
  else
    if E8 < 0 then
      A = -E8
      if A >= S then GoUp
    end if
  end if
  return
end sub

' across: 1 and 2 pixels in turn
function XStep() as u8
  XHalf[Mi] = 1 - XHalf[Mi]
  return XHalf[Mi] + 1

sub GoRight:
  u8 X = 0
  X = PX[Mi]
  if X >= HiX then
    Vx[Mi] = -Vx[Mi]
    SpeedUp(Mi, 2)
    SpeedUp(Mi, 2)
    play sound SndBounce
    return
  end if
  X = X + XStep()
  if X > HiX then X = HiX
  PX[Mi] = X
  return
end sub

sub GoLeft:
  u8 X = 0
  X = PX[Mi]
  if X <= LoX then
    Vx[Mi] = -Vx[Mi]
    SpeedUp(Mi, 3)
    SpeedUp(Mi, 3)
    play sound SndBounce
    return
  end if
  X = X - XStep()
  if X < LoX then X = LoX
  PX[Mi] = X
  return
end sub

sub GoDown:
  if PY[Mi] >= HiY then
    Vy[Mi] = -Vy[Mi]
    SpeedUp(Mi, 0)
    SpeedUp(Mi, 0)
    play sound SndBounce
    return
  end if
  inc PY[Mi]
  return
end sub

sub GoUp:
  if PY[Mi] <= LoY then
    Vy[Mi] = -Vy[Mi]
    SpeedUp(Mi, 1)
    SpeedUp(Mi, 1)
    play sound SndBounce
    return
  end if
  dec PY[Mi]
  return
end sub

' the face under object Mi, every 5 ticks (spheroids) or 8 (craft)
sub FaceOne:
  u8 T = 0
  u8 Q = 0
  if Mi < 6 then
    if Carry[Mi] > 0 then return
  else
    if Ex[Mi - 6] > 0 then return
  end if
  dec FaC[Mi]
  if FaC[Mi] > 0 then return
  FaC[Mi] = FaceP[Mi]
  X8 = PX[Mi] >> 3
  Y8 = PY[Mi] >> 3
  T = get char at X8,Y8
  if T >= TTp0 then
    if T <= TTq3 then Teleport
    return
  end if
  if T < TM0 then return
  if T > TD3e then return
  ' tiles: kind * 8 + quarter * 2 + edge; a mound pushes away from its
  ' top (the quarter's own way: NW up-left ...); a depression's NW and SE
  ' quarters push outward too, its NE and SW quarters inward (the C64's
  ' colours 12, 11, 1, 15 do that: a saddle more than a bowl)
  T = T - TM0
  Q = (T >> 1) & 3
  if T >= 8 then
    if Q = 1 then
      Q = 2
    else
      if Q = 2 then Q = 1
    end if
  end if
  if Q < 2 then
    SpeedUp(Mi, 0)
  else
    SpeedUp(Mi, 1)
  end if
  if (Q & 1) = 0 then
    SpeedUp(Mi, 2)
  else
    SpeedUp(Mi, 3)
  end if
  return
end sub

' to a random place in the arena, not on the teleporter itself
sub Teleport:
  u8 N = 0
  u8 X = 0
  u8 Y = 0
  N = 0
  while N < 20
    X = RndTo(208) + LoX
    Y = RndTo(152) + LoY
    N = 20
    if X >= TelX then
      if X < TelX + 16 then
        if Y >= TelY then
          if Y < TelY + 16 then N = 1
        end if
      end if
    end if
  end while
  PX[Mi] = X
  PY[Mi] = Y
  inc Teles
  play sound SndTele
  return
end sub

' friction: every 7 ticks (spheroids) or 12 (craft) each speed 1 nearer
' to 0; armed spheroids roll free
sub Friction:
  if Mi < 6 then
    if Arm[Mi] > 0 then return
  end if
  dec FrC[Mi]
  if FrC[Mi] > 0 then return
  FrC[Mi] = FricP[Mi]
  E8 = Vx[Mi]
  if E8 > 0 then Vx[Mi] = E8 - 1
  if E8 < 0 then Vx[Mi] = E8 + 1
  E8 = Vy[Mi]
  if E8 > 0 then Vy[Mi] = E8 - 1
  if E8 < 0 then Vy[Mi] = E8 + 1
  return
end sub

' the C64 runs this twice a tick per spheroid (once for each craft): an
' armed spheroid's clock runs (9 counts a unit); a plain one held by
' craft O rides on it
sub Follow(u8 O):
  if Arm[Mi] > 0 then
    dec ArmC[Mi]
    if ArmC[Mi] = 0 then
      ArmC[Mi] = 9
      dec Arm[Mi]
      if Arm[Mi] = 0 then Owner[Mi] = 0
    end if
    return
  end if
  if Carry[Mi] = O then
    PX[Mi] = PX[O]
    PY[Mi] = PY[O]
  end if
  return
end sub

' a craft's burst: its clock runs while it shows
sub Burst:
  K = Mi - 6
  if Ex[K] = 0 then return
  if Ex[K] < 255 then inc Ex[K]
  return
end sub

' craft Ci (0 blue, 1 green) against spheroid Si
sub Contact:
  u8 O = 0
  u8 D = 0
  O = Ci + 6
  if Ex[Ci] > 0 then return
  D = PX[O] - PX[Si]
  if D > 128 then D = -D
  if D > 6 then return
  D = PY[O] - PY[Si]
  if D > 128 then D = -D
  if D > 6 then return
  if Arm[Si] > 0 then
    if Owner[Si] = O then return
    Hit
    return
  end if
  ' a plain spheroid: picked up by a craft holding none, if it is free and
  ' no craft is bursting
  if Hold[Ci] <> NoBall then return
  if Carry[Si] > 0 then return
  if Ex[0] > 0 then return
  if Ex[1] > 0 then return
  Carry[Si] = O
  Hold[Ci] = Si
  Vx[Si] = 0
  Vy[Si] = 0
  inc Picks
  play sound SndPick
  return
end sub

' craft Ci is hit: every spheroid turns plain; the craft bursts unless the
' other one already is
sub Hit:
  for Li = 0 to 5
    Arm[Li] = 0
    Owner[Li] = 0
  next
  K = 1 - Ci
  if Ex[K] > 0 then return
  Ex[Ci] = 1
  Loser = Ci
  GapT = RoundGap
  inc Booms
  play sound SndBoom
  return
end sub

' the pause is over: the loser has one craft less
sub EndRound:
  K = Loser
  dec Lives[K]
  ShowLives
  if Lives[K] = 0 then
    Winner = 1 - K
    Over = 1
    return
  end if
  NewRound
  return
end sub

' craft back to their corners, spheroids scattered, every counter at 1
sub NewRound:
  for Li = 0 to 7
    Vx[Li] = 0
    Vy[Li] = 0
    Ph[Li] = 1
    StC[Li] = 1
    FaC[Li] = 1
    FrC[Li] = 1
    XHalf[Li] = 0
  next
  for Li = 0 to 5
    Carry[Li] = 0
    Arm[Li] = 0
    ArmC[Li] = 1
    Owner[Li] = 0
    Mi = Li
    Scatter
  next
  PX[6] = LoX
  PY[6] = HiY
  PX[7] = HiX
  PY[7] = LoY
  Hold[0] = NoBall
  Hold[1] = NoBall
  Ex[0] = 0
  Ex[1] = 0
  JoyC[0] = 1
  JoyC[1] = 1
  GapT = 0
  inc Rounds
  return
end sub

' spheroid Mi to a random place on the floor (not on a face or the
' teleporter, not in a craft's corner)
sub Scatter:
  u8 X = 0
  u8 Y = 0
  u8 T = 0
  u8 N = 0
  while N = 0
    X = RndTo(200) + 28
    Y = RndTo(140) + 30
    X8 = X >> 3
    Y8 = Y >> 3
    T = get char at X8,Y8
    if T = TFloor then N = 1
  end while
  PX[Mi] = X
  PY[Mi] = Y
  return
end sub

' ---------------------------------------------------------------------------
' the computer (green): every few frames it sets its stick. It dodges a
' blue spheroid coming close, else fetches the nearest plain spheroid,
' else lines up with the blue craft (across, down or on a diagonal) and
' throws
function Side(i16 D, u8 Neg, u8 Pos) as u8
  if D > 2 then return Pos
  if D < -2 then return Neg
  return 0

' a stick that drives toward a speed: Want the speed wanted on one axis
function Drive(i8 Want, i8 Have, u8 Neg, u8 Pos) as u8
  if Want > Have then return Pos
  if Want < Have then return Neg
  return 0

function WantV(i16 D) as i8
  i16 W = 0
  W = D / 6
  if W > 9 then W = 9
  if W < -9 then W = -9
  return W

sub AiThink:
  i16 Dx = 0
  i16 Dy = 0
  i16 Ax = 0
  i16 Ay = 0
  i16 Best = 0
  i16 Dd = 0
  u8 B = 0
  u8 Pad = 0
  u8 Rg = 0
  u8 Sl = 0
  Pad = 0
  AiPad = 0
  if Ex[1] > 0 then return
  Rg = AiDodge[Level]
  Sl = AiSlack[Level]
  ' dodge: an armed blue spheroid near and heading this way
  for Li = 0 to 5
    if Owner[Li] = 6 then
      Dx = PX[7] - PX[Li]
      Dy = PY[7] - PY[Li]
      Ax = abs(Dx)
      Ay = abs(Dy)
      if Ax < Rg then
        if Ay < Rg then
          ' move across its path
          E8 = Vx[Li]
          Best = abs(E8)
          E8 = Vy[Li]
          Dd = abs(E8)
          if Best >= Dd then
            Pad = Side(Dy, 1, 2)
            if Pad = 0 then Pad = 1
            if PY[7] < 40 then Pad = 2
            if PY[7] > 160 then Pad = 1
          else
            Pad = Side(Dx, 4, 8)
            if Pad = 0 then Pad = 4
            if PX[7] < 40 then Pad = 8
            if PX[7] > 215 then Pad = 4
          end if
          AiPad = Pad
          return
        end if
      end if
    end if
  next
  if Hold[1] = NoBall then
    ' fetch the nearest free plain spheroid
    B = NoBall
    Best = 999
    for Li = 0 to 5
      if Arm[Li] = 0 then
        if Carry[Li] = 0 then
          Dx = PX[Li] - PX[7]
          Dy = PY[Li] - PY[7]
          Dd = abs(Dx) + abs(Dy)
          if Dd < Best then
            Best = Dd
            B = Li
          end if
        end if
      end if
    next
    if B = NoBall then
      Dx = 128 - PX[7]
      Dy = 100 - PY[7]
    else
      Dx = PX[B] - PX[7]
      Dy = PY[B] - PY[7]
    end if
    Pad = Drive(WantV(Dx), Vx[7], 4, 8)
    Pad = Pad | Drive(WantV(Dy), Vy[7], 1, 2)
    AiPad = Pad
    return
  end if
  ' holding: line up with blue and throw
  Dx = PX[6] - PX[7]
  Dy = PY[6] - PY[7]
  Ax = abs(Dx)
  Ay = abs(Dy)
  if Ax <= Sl then
    AiPad = 16 | Side(Dy, 1, 2)
    return
  end if
  if Ay <= Sl then
    AiPad = 16 | Side(Dx, 4, 8)
    return
  end if
  ' a diagonal throw goes 3 across for 2 down
  Best = Ay * 3
  Best = Best >> 1
  Dd = Ax - Best
  Best = Sl * 2
  Dd = abs(Dd)
  if Dd <= Best then
    Pad = Side(Dx, 4, 8)
    AiPad = 16 | Pad | Side(Dy, 1, 2)
    return
  end if
  ' move to the nearer line (across if blue is mostly above or below),
  ' closing in to about 56 pixels along the other way
  if Ax < Ay then
    Pad = Drive(WantV(Dx), Vx[7], 4, 8)
    Dd = Dy - 56
    if Dy < 0 then Dd = Dy + 56
    Pad = Pad | Drive(WantV(Dd), Vy[7], 1, 2)
  else
    Pad = Drive(WantV(Dy), Vy[7], 1, 2)
    Dd = Dx - 56
    if Dx < 0 then Dd = Dx + 56
    Pad = Pad | Drive(WantV(Dd), Vx[7], 4, 8)
  end if
  AiPad = Pad
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 blue craft, 1 green craft, 2-7 spheroids (a carried one under
' its craft's number, drawn under it)
sub DrawSprites:
  for Si = 0 to 1
    J = Si + 6
    X8 = PX[J] - 7
    Y8 = PY[J] - 8
    if Ex[Si] > 0 then
      if Ex[Si] < BurstLen then
        K = SBur0
        if (Ex[Si] & 16) > 0 then K = SBur1
        set sprite Si to Y8,X8,K,11
      else
        set sprite Si to 192,0,0,0
      end if
    else
      if Si = 0 then
        set sprite 0 to Y8,X8,SCraft,5
      else
        set sprite 1 to Y8,X8,SCraft,3
      end if
    end if
  next
  for Si = 0 to 5
    K = Si + 2
    X8 = PX[Si] - 7
    Y8 = PY[Si] - 8
    C = 9
    if Owner[Si] = 6 then C = 5
    if Owner[Si] = 7 then C = 3
    set sprite K to Y8,X8,SBall,C
  next
  update sprites
  return
end sub

sub ShowLives:
  put char 48 + Lives[0] at 7,1
  put char 48 + Lives[1] at 23,1
  return
end sub

' the teleporter's four tiles (bright or dim)
sub DrawTel:
  X8 = TelX >> 3
  Y8 = TelY >> 3
  C = TTp0
  if TelPh = 1 then C = TTq0
  put char C at X8,Y8
  put char C + 1 at X8 + 1,Y8
  put char C + 2 at X8,Y8 + 1
  put char C + 3 at X8 + 1,Y8 + 1
  return
end sub

' ---------------------------------------------------------------------------
' the arena: frame, floor, then the chosen layout (corner Cx,Cy of the
' 26 x 19 floor grid, columns 3-28 and rows 3-21)
sub BuildArena:
  put char TFTL at 2,2
  fill TFT count 26 at 3,2
  put char TFTR at 29,2
  for Li = 3 to 21
    put char TFL at 2,Li
    fill TFloor count 26 at 3,Li
    put char TFR at 29,Li
  next
  put char TFBL at 2,22
  fill TFB count 26 at 3,22
  put char TFBR at 29,22
  select case Arena
    case 0
      RandomTel
    case 1
      Lattice
      RandomTel
    case 2
      Mound(7, 10, 3)
      Mound(19, 10, 3)
      Mound(13, 4, 3)
      Mound(13, 16, 3)
      PlaceTel(12, 9)
    case 3
      Mound(3, 3, 2)
      Mound(23, 3, 2)
      Mound(3, 16, 2)
      Mound(23, 16, 2)
      Mound(13, 10, 6)
      RandomTel
    case 4
      K = RndTo(3) + 2
      Mound(6, 6, K)
      Mound(20, 13, K)
      K = RndTo(2) + 2
      Mound(20, 5, K)
      Mound(6, 14, K)
      RandomTel
    case 5
      Scattered
      RandomTel
  end select
  return
end sub

' staggered rows of little mounds and depressions
sub Lattice:
  u8 R = 0
  u8 X = 0
  for R = 0 to 5
    X = 3
    if (R & 1) = 1 then X = 5
    while X < 25
      Mound(X, R * 3 + 2, 1)
      X = X + 4
    end while
  next
  return
end sub

' rows of little faces, each there by a chance chosen for the arena
sub Scattered:
  u8 R = 0
  u8 X = 0
  u8 N = 0
  N = RndTo(170)
  for R = 0 to 5
    X = 3
    if (R & 1) = 1 then X = 6
    while X < 25
      if RndTo(255) < N then Mound(X, R * 3 + 3, 1)
      X = X + 5
    end while
  next
  return
end sub

' a mound or a depression (at random) of size S around grid corner Cx,Cy
sub Mound(u8 Cx, u8 Cy, u8 S):
  u8 Kd = 0
  u8 S2 = 0
  u8 Dx = 0
  u8 Dy = 0
  u8 A = 0
  u8 B = 0
  u8 Q = 0
  u8 T = 0
  Kd = 0
  if RndTo(2) = 1 then Kd = 8
  S2 = S * 2
  for Dy = 0 to S2 - 1
    for Dx = 0 to S2 - 1
      ' distance from the corner in half cells
      A = Dx * 2 + 1
      if A > S2 then
        A = A - S2
      else
        A = S2 - A
      end if
      B = Dy * 2 + 1
      if B > S2 then
        B = B - S2
      else
        B = S2 - B
      end if
      A = A + B
      if A <= S2 then
        Q = 0
        if Dx >= S then Q = 1
        if Dy >= S then Q = Q + 2
        T = TM0 + Kd + Q * 2
        if A = S2 then inc T
        X8 = Cx + Dx + 3 - S
        Y8 = Cy + Dy + 3 - S
        put char T at X8,Y8
      end if
    next
  next
  return
end sub

' the teleporter at grid cell Gx,Gy (its top-left)
sub PlaceTel(u8 Gx, u8 Gy):
  TelX = (Gx + 3) * 8
  TelY = (Gy + 3) * 8
  TelPh = 0
  TelT = 12
  DrawTel
  return
end sub

' on four floor cells at random, away from the craft corners
sub RandomTel:
  u8 Gx = 0
  u8 Gy = 0
  u8 N = 0
  while N = 0
    Gx = RndTo(22) + 2
    Gy = RndTo(15) + 2
    N = 1
    X8 = Gx + 3
    Y8 = Gy + 3
    C = get char at X8,Y8
    if C <> TFloor then N = 0
    X8 = X8 + 1
    C = get char at X8,Y8
    if C <> TFloor then N = 0
    Y8 = Y8 + 1
    C = get char at X8,Y8
    if C <> TFloor then N = 0
    X8 = X8 - 1
    C = get char at X8,Y8
    if C <> TFloor then N = 0
  end while
  PlaceTel(Gx, Gy)
  return
end sub

sub NewGame:
  NewScreen
  BuildArena
  print at 2,1, "BLUE"
  print at 25,1, "GREEN"
  ArenaName(12, 1)
  Lives[0] = 9
  Lives[1] = 9
  ShowLives
  Over = 0
  Acc = 0
  AiT = 0
  AiPad = 0
  Teles = 0
  Rounds = 0
  Throws = 0
  Picks = 0
  Booms = 0
  NewRound
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      mute all
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  Rnd
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  JM = J1 | J2
  if Players = 1 then J1 = JM
  Btn = JM & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, what is what, the options menu, the tune once
sub TitlePage:
  NewScreen
  print at 2,1, "COMPUTE!'S GAZETTE JUNE 1990"
  for Li = 0 to 2
    K = Li * LogoW
    copy LogoMap + K count LogoW to vram.name + 103 + Li * 32
  next
  print at 6,8, "CRAFT"
  print at 6,10, "SPHEROID"
  print at 6,12, "ARMED"
  Mound2(16, 7, 0)
  print at 19,8, "MOUND"
  Mound2(16, 9, 8)
  print at 19,10, "DEPRESSION"
  put char TTp0 at 16,11
  put char TTp1 at 17,11
  put char TTp2 at 16,12
  put char TTp3 at 17,12
  print at 19,12, "TELEPORTER"
  print at 6,15, "PLAYERS"
  print at 6,16, "LEVEL"
  print at 6,17, "ARENA"
  print at 6,18, "START"
  print at 6,19, "HOW TO PLAY"
  print at 6,20, "CREDITS"
  print at 3,22, "STICK: CHOOSE  BUTTON: GO"
  if Menu > 5 then Menu = 3
  ShowMenu
  set sprite 0 to 55,25,SCraft,5
  set sprite 1 to 71,25,SBall,9
  set sprite 2 to 87,25,SBall,5
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Menu = 3
  ShowMenu
tp_loop:
  Frame1
  ReadPad
  LogoRoll
  V = JM & 15
  if V > 0 then
    if WasStick = 0 then
      MenuMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  mute all
  TzOn = 0
  HideSprites
  if Menu = 5 then
    CreditsPage
  end if
  return
end sub

' a 2 x 2 mound (Kd 0) or depression (Kd 8) for the title's key
sub Mound2(u8 X, u8 Y, u8 Kd):
  C = TM0e + Kd
  put char C at X,Y
  put char C + 2 at X + 1,Y
  put char C + 4 at X,Y + 1
  put char C + 6 at X + 1,Y + 1
  return
end sub

' the logo's colours roll down a row every 8 frames
sub LogoRoll:
  u16 A = 0
  if (Tick & 7) > 0 then return
  inc LogoPh
  for Li = 0 to 7
    K = Li + LogoPh
    K = K & 7
    LogoBuf[Li] = LogoPal[K]
  next
  for Li = 0 to 15
    A = TQb0 + Li
    A = A * 8
    copy LogoBuf count 8 to vram.color + A
  next
  return
end sub

sub MenuMove:
  select case V
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 5 then inc Menu
    case 4
      Change(255)
    case 8
      Change(1)
  end select
  ShowMenu
  return
end sub

' left or right on an option line
sub Change(u8 D):
  select case Menu
    case 0
      Players = 3 - Players
    case 1
      Level = 1 - Level
    case 2
      Arena = Arena + D
      if Arena = 255 then Arena = 5
      if Arena = 6 then Arena = 0
  end select
  return
end sub

sub ShowMenu:
  for Li = 15 to 20
    put char 32 at 4,Li
  next
  J = Menu + 15
  put char 62 at 4,J
  if Players = 1 then
    print at 15,15, "1 VS CPU"
  else
    print at 15,15, "2       "
  end if
  if Level = 0 then
    print at 15,16, "EASY  "
  else
    print at 15,16, "NORMAL"
  end if
  ArenaName(15, 17)
  return
end sub

sub ArenaName(u8 X, u8 Y):
  select case Arena
    case 0
      print at X,Y, "OPEN    "
    case 1
      print at X,Y, "LATTICE "
    case 2
      print at X,Y, "DIAMONDS"
    case 3
      print at X,Y, "CYCLONE "
    case 4
      print at X,Y, "QUADRATE"
    case 5
      print at X,Y, "RANDOM  "
  end select
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "TWO HOVERCRAFT BATTLE IN AN"
    print at 2,4, "ARENA WITH SIX SPHEROIDS."
    print at 2,5, "PICK UP A SPHEROID AND"
    print at 2,6, "THROW IT AT THE OTHER CRAFT"
    print at 2,7, "TO BLOW IT UP!"
    print at 2,9, "ONE PLAYER: YOU ARE BLUE,"
    print at 2,10, "THE COMPUTER IS GREEN."
    print at 2,11, "TWO PLAYERS: CONTROLLER 1"
    print at 2,12, "IS BLUE, CONTROLLER 2 GREEN."
    set sprite 0 to 135,60,SCraft,5
    set sprite 2 to 135,100,SBall,5
    set sprite 3 to 151,140,SBall,9
    set sprite 1 to 135,190,SCraft,3
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: PUSH YOUR CRAFT. IT"
    print at 2,4, "SLIDES AND SLOWS DOWN BY"
    print at 2,5, "ITSELF."
    print at 2,6, "TOUCH A RED SPHEROID TO"
    print at 2,7, "PICK IT UP."
    print at 2,8, "BUTTON + STICK: THROW IT"
    print at 2,9, "THAT WAY. IT TURNS YOUR"
    print at 2,10, "COLOUR AND IS DANGEROUS!"
    print at 2,12, "MOUNDS AND DIPS PUSH THINGS"
    print at 2,13, "AROUND. THE YELLOW SQUARE"
    print at 2,14, "TELEPORTS."
    Mound2(6, 17, 0)
    Mound2(12, 17, 8)
    put char TTp0 at 18,17
    put char TTp1 at 19,17
    put char TTp2 at 18,18
    put char TTp3 at 19,18
    set sprite 0 to 135,192,SCraft,5
    set sprite 2 to 135,216,SBall,5
  case 3
    print at 2,1, "WINNING                 3/3"
    print at 2,3, "EACH PLAYER HAS 9 CRAFT."
    print at 2,4, "HIT BY THE OTHER PLAYER'S"
    print at 2,5, "SPHEROID: ONE CRAFT LOST."
    print at 2,6, "LOSE ALL 9 AND YOU LOSE!"
    print at 2,8, "ON THE TITLE CHOOSE THE"
    print at 2,9, "PLAYERS, THE LEVEL AND THE"
    print at 2,10, "ARENA."
    print at 2,12, "TIP: THROW WHEN YOU ARE IN"
    print at 2,13, "LINE WITH THE OTHER CRAFT."
    set sprite 0 to 135,90,SBur0,11
    set sprite 2 to 135,150,SBall,3
  end select
  print at 8,21, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "SPHEROIDS"
  print at 2,5, "BASED ON SPHEROIDS BY"
  print at 2,6, "KEVIN DIXON, COMPUTE!'S"
  print at 2,7, "GAZETTE JUNE 1990"
  print at 2,8, "(COMMODORE 64 BASIC AND"
  print at 2,9, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: ROLLING SPHERES"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

