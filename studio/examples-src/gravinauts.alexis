  tile screen
  set sound table GvSoundTable areas 6
  sprites 16x16
  set sprite count 9
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  Score = 0
  Fuel = 50
  FuelT = 0
  WaveN = 1
  Over = 0
  NewWave

play_loop:
  Frame1
  ReadPad
  if Gs = 1 then
    PlayStep
  elseif Gs = 0 then
    IntroStep
  elseif Gs = 2 then
    DeadStep
  else
    ClearStep
  end if
  Sounds
  Ripple
  DrawSprites
  if Over = 0 then goto play_loop

  if Score > Hi then Hi = Score
  print at 9,10, "             "
  print at 9,11, "  GAME OVER  "
  print at 9,12, "             "
  ShowHud
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of flight

sub PlayStep:
  PlayerStep
  if Gs <> 1 then return
  for Ei = 0 to 2
    if EOn[Ei] = 1 then EnemyStep
  next
  Ba = 0
  Bb = 1
  BumpPair
  Bb = 2
  BumpPair
  Ba = 1
  BumpPair
  Fights
  if Gs <> 1 then return
  Tanks
  N = 0
  for Ei = 0 to 2
    if EOn[Ei] = 2 then
      V = EBt[Ei] + 1
      EBt[Ei] = V
      if V >= 36 then EOn[Ei] = 0
    end if
    if EOn[Ei] <> 0 then inc N
  next
  if N = 0 then
    if TanksLeft = 0 then
      Gs = 3
      St = 0
      play sound SndClear
      Banner
      print at 9,1, "WAVE CLEAR!"
    end if
  end if
  return
end sub

' you: the button fires the pack (stick left/right steers), gravity pulls
sub PlayerStep:
  Thr = 0
  if Btn = 1 then
    Thr = 1
    Vy = Vy - 6
    if Lf1 = 1 then
      Vx = Vx - 4
      Face = 1
    end if
    if Rt1 = 1 then
      Vx = Vx + 4
      Face = 0
    end if
    inc FuelT
    if FuelT >= 10 then
      FuelT = 0
      dec Fuel
      ShowFuel
      if Fuel = 0 then
        Die
        return
      end if
    end if
  end if
  Vy = Vy + 2
  Bpx = Px
  Bpy = Py
  Bvx = Vx
  Bvy = Vy
  Lim = 192
  Lmn = -192
  ClampB
  MoveBody
  Px = Bpx
  Py = Bpy
  Vx = Bvx
  Vy = Bvy
  if Bump = 1 then play sound SndBump
  if Acid = 1 then
    Die
    return
  end if
  ' standing on the pad or on a glacier: stop sinking, slide to a halt
  W = Px << 1
  Xp = highbyte W
  W = Py << 1
  Yp = highbyte W
  Gnd = 0
  if Yp = 152 then
    V = Xp + 8
    if V >= 104 then
      if V <= 151 then Gnd = 1
    end if
  end if
  if Gnd = 0 then
    X = Xp
    Y = Yp + 1
    BoxAt
    IceHit
    if Hit <> 255 then Gnd = 1
  end if
  if Gnd = 1 then
    if Vy > 0 then
      Vy = 0
      W = Yp
      Py = W << 7
    end if
    if Thr = 0 then
      ' W = Vx / 8, rounded toward zero, by a shift
      W = Vx
      if W < 0 then W = W + 7
      W = W >> 3
      Vx = Vx - W
      if Vx > -8 then
        if Vx < 8 then Vx = 0
      end if
    end if
  end if
  return
end sub

sub Die:
  Gs = 2
  St = 0
  Thr = 0
  BoomT = 60
  play sound SndBoom
  return
end sub

' a rival steers toward you: up/down every frame, sideways on half the
' frames (the game's own random numbers); no gravity
sub EnemyStep:
  Bpx = EX[Ei]
  Bpy = EY[Ei]
  Bvx = EVX[Ei]
  Bvy = EVY[Ei]
  Rand
  V = Rs & 1
  if V = 1 then
    if Bpx < Px then
      Bvx = Bvx + EAcc
    else
      Bvx = Bvx - EAcc
    end if
  end if
  if Bpy < Py then
    Bvy = Bvy + EAcc
  else
    Bvy = Bvy - EAcc
  end if
  Lim = EMax
  Lmn = EMin
  ClampB
  MoveBody
  ' landed on ice (or the pad), or hit ice from below: off one way or the
  ' other at random, as the C64 game's random bounce did, so a rival never
  ' sits on a glacier or stays caught under one
  if Land > 0 then
    Rand
    V = Rs & 2
    if V = 0 then
      Bvx = EMin
    else
      Bvx = EMax
    end if
  end if
  EX[Ei] = Bpx
  EY[Ei] = Bpy
  EVX[Ei] = Bvx
  EVY[Ei] = Bvy
  EF[Ei] = 0
  if Bpx > Px then EF[Ei] = 1
  if Acid = 1 then
    EOn[Ei] = 2
    EBt[Ei] = 0
    Score = Score + 250
    ShowScore
    play sound SndPop
    BoomT = 30
  end if
  return
end sub

sub ClampB:
  if Bvx > Lim then Bvx = Lim
  if Bvx < Lmn then Bvx = Lmn
  if Bvy > Lim then Bvy = Lim
  if Bvy < Lmn then Bvy = Lmn
  return
end sub

' move the body (Bpx, Bpy by Bvx, Bvy) one axis at a time; ice stops it at
' its edge and bounces it back (half speed; a third, then settling, when
' it lands); the walls and the sky bounce; the sea is acid but for the pad
sub MoveBody:
  Bump = 0
  Acid = 0
  Land = 0
  Nq = Bpx + Bvx
  W = Nq << 1
  X = highbyte W
  W = Bpy << 1
  Y = highbyte W
  BoxAt
  IceHit
  if Hit <> 255 then
    if Bvx > 0 then
      V = RL[Hit]
      X = V - 13
    else
      V = RR[Hit]
      X = V - 2
    end if
    W = X
    Nq = W << 7
    if Bvx > 48 then Bump = 1
    if Bvx < -48 then Bump = 1
    Bvx = 0 - Bvx
    if Bvx < 0 then Bvx = Bvx + 1
    Bvx = Bvx >> 1
  end if
  Bpx = Nq
  if Bpx < 2048 then
    Bpx = 2048
    if Bvx < 0 then
      Bvx = 0 - Bvx
      if Bvx < 0 then Bvx = Bvx + 1
      Bvx = Bvx >> 1
    end if
  end if
  if Bpx > 28672 then
    Bpx = 28672
    if Bvx > 0 then
      Bvx = 0 - Bvx
      if Bvx < 0 then Bvx = Bvx + 1
      Bvx = Bvx >> 1
    end if
  end if
  Nq = Bpy + Bvy
  W = Nq << 1
  Y = highbyte W
  W = Bpx << 1
  X = highbyte W
  BoxAt
  IceHit
  if Hit <> 255 then
    if Bvy > 0 then
      V = RT[Hit]
      Y = V - 16
      Land = 1
      if Bvy > 48 then Bump = 1
      ' about a third (Bvy is positive here): * 85 / 256
      Bvy = Bvy * 85
      Bvy = Bvy >> 8
      Bvy = 0 - Bvy
      if Bvy > -24 then Bvy = 0
      W = Bvx
      if W < 0 then W = W + 3
      W = W >> 2
      Bvx = Bvx - W
    else
      V = RB[Hit]
      Y = V - 1
      Land = 2
      if Bvy < -48 then Bump = 1
      Bvy = 0 - Bvy
      if Bvy < 0 then Bvy = Bvy + 1
      Bvy = Bvy >> 1
    end if
    W = Y
    Nq = W << 7
  end if
  Bpy = Nq
  if Bpy < 2048 then
    Bpy = 2048
    if Bvy < 0 then Bvy = 32
  end if
  W = Bpy << 1
  Y = highbyte W
  if Y >= 153 then
    V = X + 8
    Acid = 1
    if V >= 104 then
      if V <= 151 then Acid = 0
    end if
    if Acid = 0 then
      Bpy = 19456
      if Bvy > 0 then
        if Bvy > 48 then Bump = 1
        Bvy = 0
      end if
      Land = 1
    end if
  end if
  return
end sub

' the box of a gravinaut whose sprite is at X, Y
sub BoxAt:
  Bx0 = X + 3
  Bx1 = X + 12
  By0 = Y + 2
  By1 = Y + 15
  return
end sub

' IceHit: the first ice rectangle the box touches (Hit), or 255 (GvIce,
' in Z80 below: the hottest test of the frame)
sub IceHit:
  call asm GvIce
  return
end sub

' two rivals that meet push apart
sub BumpPair:
  if EOn[Ba] <> 1 then return
  if EOn[Bb] <> 1 then return
  W = EX[Ba] << 1
  Ex8 = highbyte W
  W = EX[Bb] << 1
  Fx8 = highbyte W
  W = EY[Ba] << 1
  Ey8 = highbyte W
  W = EY[Bb] << 1
  Fy8 = highbyte W
  if Ex8 >= Fx8 then
    T = Ex8 - Fx8
  else
    T = Fx8 - Ex8
  end if
  if Ey8 >= Fy8 then
    U = Ey8 - Fy8
  else
    U = Fy8 - Ey8
  end if
  if T >= 12 then return
  if U >= 12 then return
  if Ex8 < Fx8 then
    EVX[Ba] = -48
    EVX[Bb] = 48
  else
    EVX[Ba] = 48
    EVX[Bb] = -48
  end if
  if Ey8 < Fy8 then
    EVY[Ba] = -48
    EVY[Bb] = 48
  else
    EVY[Ba] = 48
    EVY[Bb] = -48
  end if
  return
end sub

' you meet a rival: the higher one wins (a tie is yours)
sub Fights:
  W = Px << 1
  Xp = highbyte W
  W = Py << 1
  Yp = highbyte W
  for Ei = 0 to 2
    if EOn[Ei] = 1 then
      W = EX[Ei] << 1
      Ex8 = highbyte W
      W = EY[Ei] << 1
      Ey8 = highbyte W
      if Xp >= Ex8 then
        T = Xp - Ex8
      else
        T = Ex8 - Xp
      end if
      if Yp >= Ey8 then
        U = Yp - Ey8
      else
        U = Ey8 - Yp
      end if
      if T < 10 then
        if U < 14 then
          if Yp <= Ey8 then
            EOn[Ei] = 2
            EBt[Ei] = 0
            Score = Score + 250
            ShowScore
            Vy = -96
            play sound SndPopT
            play sound SndPop
            BoomT = 30
          else
            Die
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' a fuel tank you touch is yours
sub Tanks:
  X = Xp
  Y = Yp
  BoxAt
  for Ti = 0 to 3
    if TOn[Ti] = 1 then
      V = TCc[Ti]
      V = V << 3
      R = V + 6
      inc V
      if Bx1 >= V then
        if Bx0 <= R then
          V = TRr[Ti]
          V = V << 3
          R = V + 15
          V = V + 2
          if By1 >= V then
            if By0 <= R then
              TOn[Ti] = 0
              dec TanksLeft
              V = TankFuel[Ti]
              W16 = V
              W16 = W16 + Fuel
              if W16 > 255 then W16 = 255
              Fuel = W16
              ShowFuel
              C = TCc[Ti]
              R = TRr[Ti]
              put char TSky at C,R
              inc R
              put char TSky at C,R
              play sound SndFuel
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub IntroStep:
  inc St
  if St < 90 then return
  Gs = 1
  St = 0
  ShowHud
  return
end sub

sub DeadStep:
  inc St
  if St >= 70 then Over = 1
  return
end sub

sub ClearStep:
  inc St
  if St < 100 then return
  if WaveN < 99 then inc WaveN
  NewWave
  return
end sub

sub Rand:
  call asm GvRand
  return
end sub

' ---------------------------------------------------------------------------
' a wave: the field, the rivals, the speed

sub NewWave:
  NewScreen
  Lay = WaveN - 1
  Lay = Lay & 3
  V = WaveN - 1
  V = V & 3
  if V = 0 then
    backdrop dark blue
  elseif V = 1 then
    backdrop black
  elseif V = 2 then
    backdrop dark green
  else
    backdrop dark yellow
  end if
  V = WaveN
  if V > 8 then V = 8
  dec V
  V = SpeedT[V]
  W = V
  EMax = W
  EMin = 0 - W
  V = WaveN
  if V > 8 then V = 8
  dec V
  V = AccT[V]
  W = V
  EAcc = W
  DrawField
  Px = 15360
  Py = 19456
  Vx = 0
  Vy = 0
  Face = 0
  Thr = 0
  for Ei = 0 to 2
    V = SpawnX[Ei]
    W = V
    EX[Ei] = W << 7
    V = Ei & 1
    W = 2048
    if V = 1 then W = 3072
    EY[Ei] = W
    EVX[Ei] = 0
    EVY[Ei] = 0
    EOn[Ei] = 1
    EBt[Ei] = 0
    EF[Ei] = 0
  next
  Gs = 0
  St = 0
  Banner
  print at 7,1, "WAVE"
  NumU = WaveN
  print at 12,1, digits$(NumU, 2)
  print at 15,1, "GET READY"
  DrawSprites
  ShowScreen
  play sound SndWave
  return
end sub

' the sky with stars, the glaciers (and their rectangles), the tanks, the
' acid sea and the pad
sub DrawField:
  for Y = 2 to 20
    fill TSky count 32 at 0,Y
  next
  for Y = 3 to 20
    for X = 2 to 29
      V = X * 7
      R = Y * 11
      V = V + R
      V = V & 31
      if V = 0 then
        put char TStar1 at X,Y
      elseif V = 13 then
        put char TStar2 at X,Y
      elseif V = 22 then
        V = X & 1
        if V = 0 then put char TStar3 at X,Y
      end if
    next
  next
  for Gi = 0 to 3
    V = Lay * 12
    R = Gi * 3
    V = V + R
    Gc = FieldG[V]
    inc V
    Gw = FieldG[V]
    inc V
    Gr = FieldG[V]
    DrawGlacier
  next
  TanksLeft = 4
  for Ti = 0 to 3
    V = Lay << 3
    R = Ti << 1
    V = V + R
    C = FieldT[V]
    inc V
    R = FieldT[V]
    TCc[Ti] = C
    TRr[Ti] = R
    TOn[Ti] = 1
    V = Ti << 1
    T = TTank0t + V
    put char T at C,R
    inc T
    inc R
    put char T at C,R
  next
  fill TAcid count 32 at 0,21
  fill TAcidD count 32 at 0,22
  put char TPadL at 13,21
  fill TPad count 4 at 14,21
  put char TPadR at 18,21
  put char TLeg at 14,22
  put char TLeg at 17,22
  return
end sub

' glacier Gi at column Gc, width Gw, row Gr
sub DrawGlacier:
  R = Gc + Gw
  dec R
  put char TCapL at Gc,Gr
  put char TCapR at R,Gr
  Y = Gr + 1
  put char TBodyL at Gc,Y
  put char TBodyR at R,Y
  Y = Gr + 2
  put char TKeelL at Gc,Y
  put char TKeelR at R,Y
  X = Gc + 1
  while X < R
    V = X & 1
    T = TCap + V
    if V = 1 then T = TCap2
    put char T at X,Gr
    Y = Gr + 1
    T = TBody
    if V = 1 then T = TBody2
    put char T at X,Y
    Y = Gr + 2
    T = TKeel
    if V = 1 then T = TKeel2
    put char T at X,Y
    Y = Gr + 3
    T = TIce1
    if V = 1 then T = TIce2
    put char T at X,Y
    inc X
  end while
  ' slab: rows Gr and Gr+1, full width; keel: row Gr+2, one in each side
  K = Gi << 1
  V = Gc << 3
  RL[K] = V
  V = R << 3
  V = V + 7
  RR[K] = V
  V = Gr << 3
  RT[K] = V
  V = V + 15
  RB[K] = V
  inc K
  V = Gc + 1
  V = V << 3
  RL[K] = V
  V = R << 3
  dec V
  RR[K] = V
  V = Gr + 2
  V = V << 3
  RT[K] = V
  V = V + 7
  RB[K] = V
  return
end sub

' the acid surface ripples: its pattern (bottom screen third) shifts
' every 12 frames
sub Ripple:
  inc AcT
  if AcT < 12 then return
  AcT = 0
  V = AcPh + 1
  AcPh = V & 3
  V = AcPh << 3
  W16 = V
  A16 = TAcid << 3
  A16 = A16 + 4096
  copy AcidAnim + W16 count 8 to vram.pattern + A16
  return
end sub

' the pack's hiss while it fires; a beep when fuel is low
sub Sounds:
  if BoomT > 0 then dec BoomT
  if Thr = 1 then
    if JetT = 0 then
      if BoomT = 0 then play sound SndJet
      JetT = 6
    end if
  end if
  if JetT > 0 then dec JetT
  if Gs <> 1 then return
  if Fuel > 10 then
    LowT = 0
    return
  end if
  inc LowT
  if LowT < 45 then return
  LowT = 0
  play sound SndLow
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-2: you (visor and pack, suit, flame); 3-8: the rivals

sub DrawSprites:
  W = Px << 1
  X = highbyte W
  W = Py << 1
  Y = highbyte W
  Y = Y - 1
  if Gs = 2 then
    set sprite 0 to 192,0,0,0
    set sprite 2 to 192,0,0,0
    if St < 8 then
      set sprite 1 to Y,X,SBoom1,11
    elseif St < 20 then
      set sprite 1 to Y,X,SBoom2,9
    elseif St < 40 then
      set sprite 1 to Y,X,SBoom3,14
    else
      set sprite 1 to 192,0,0,0
    end if
  else
    if Face = 0 then
      set sprite 0 to Y,X,SDetR,5
      set sprite 1 to Y,X,SSuitR,15
    else
      set sprite 0 to Y,X,SDetL,5
      set sprite 1 to Y,X,SSuitL,15
    end if
    inc FlT
    if FlT >= 20 then FlT = 0
    if Thr = 1 then
      T = SFlame1R
      if FlT >= 10 then T = SFlame2R
      if Face = 1 then T = T + 8
      set sprite 2 to Y,X,T,11
    else
      set sprite 2 to 192,0,0,0
    end if
  end if
  for J = 0 to 2
    K = J << 1
    K = K + 3
    N = K + 1
    if EOn[J] = 0 then
      set sprite K to 192,0,0,0
      set sprite N to 192,0,0,0
    else
      W = EX[J] << 1
      X = highbyte W
      W = EY[J] << 1
      Y = highbyte W
      Y = Y - 1
      if EOn[J] = 2 then
        V = EBt[J]
        set sprite K to 192,0,0,0
        if V < 8 then
          set sprite N to Y,X,SBoom1,11
        elseif V < 18 then
          set sprite N to Y,X,SBoom2,9
        else
          set sprite N to Y,X,SBoom3,14
        end if
      else
        T = SDetR
        U = SSuitR
        W = EVY[J]
        if W < -16 then T = SDetFR
        if EF[J] = 1 then
          T = T + 12
          U = SSuitL
        end if
        set sprite K to Y,X,T,11
        set sprite N to Y,X,U,13
      end if
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' row 1: the score, the best, the fuel

sub Banner:
  fill 32 count 28 at 2,1
  return
end sub

sub ShowHud:
  Banner
  print at 2,1, "SCORE"
  ShowScore
  print at 15,1, "HI"
  NumU = Hi
  print at 18,1, digits$(NumU, 5)
  put char TDrop at 25,1
  ShowFuel
  return
end sub

' the figures are printed by subtraction (digits$ divides; cheap enough
' here, but this keeps the frame loop's worst pass short)
sub ShowScore:
  if Gs = 0 then return
  if Gs = 3 then return
  W16 = Score
  X = 8
  A16 = 10000
  PutDigit
  A16 = 1000
  PutDigit
  A16 = 100
  PutDigit
  A16 = 10
  PutDigit
  A16 = 1
  PutDigit
  return
end sub

' PutDigit: the digit of W16 for the power A16 at X,1 (W16 keeps the rest)
sub PutDigit:
  T = 48
  while W16 >= A16
    W16 = W16 - A16
    inc T
  end while
  put char T at X,1
  inc X
  return
end sub

sub ShowFuel:
  if Gs = 0 then return
  if Gs = 3 then return
  W16 = Fuel
  X = 26
  A16 = 100
  PutDigit
  A16 = 10
  PutDigit
  A16 = 1
  PutDigit
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, a gravinaut over the pad, the tune once,
' START / CREDITS
sub TitlePage:
  NewScreen
  backdrop dark blue
  print at 2,1, "HI"
  NumU = Hi
  print at 5,1, digits$(NumU, 5)
  for J = 0 to 9
    V = J << 2
    X = J << 1
    X = X + 6
    T = LogoMap[V]
    put char T at X,3
    inc V
    inc X
    T = LogoMap[V]
    put char T at X,3
    inc V
    dec X
    T = LogoMap[V]
    put char T at X,4
    inc V
    inc X
    T = LogoMap[V]
    put char T at X,4
  next
  Gi = 0
  Gc = 4
  Gw = 6
  Gr = 7
  DrawGlacier
  Gc = 21
  Gw = 7
  Gr = 8
  DrawGlacier
  put char TTank3t at 24,6
  put char TTank3b at 24,7
  put char TStar1 at 14,7
  put char TStar2 at 18,9
  put char TStar3 at 12,10
  put char TStar1 at 27,5
  print at 3,12, "FLY YOUR ROCKET PACK OVER"
  print at 3,13, "THE ACID SEA OF ARKION."
  print at 3,14, "KNOCK RIVALS FROM ABOVE,"
  print at 3,15, "TAKE EVERY FUEL TANK."
  fill TAcid count 32 at 0,21
  fill TAcidD count 32 at 0,22
  put char TPadL at 13,21
  fill TPad count 4 at 14,21
  put char TPadR at 18,21
  put char TLeg at 14,22
  put char TLeg at 17,22
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleSprites
  Ripple
  V = Lf1 | Rt1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

' the title's gravinauts: you hover over the pad, two rivals drift
sub TitleSprites:
  V = Tick >> 2
  V = V & 31
  if V >= 16 then V = 31 - V
  V = V >> 1
  Y = 143 + V
  set sprite 0 to Y,120,SDetR,5
  set sprite 1 to Y,120,SSuitR,15
  T = SFlame1R
  V = Tick & 16
  if V > 0 then T = SFlame2R
  set sprite 2 to Y,120,T,11
  V = Tick >> 3
  V = V & 15
  if V >= 8 then V = 15 - V
  Y = 39 + V
  X = 46
  set sprite 3 to Y,X,SDetR,11
  set sprite 4 to Y,X,SSuitR,13
  Y = 47 - V
  X = 196
  set sprite 5 to Y,X,SDetL,11
  set sprite 6 to Y,X,SSuitL,13
  update sprites
  return
end sub

sub ShowMenu:
  print at 8,17, " START   CREDITS"
  if Menu = 0 then
    put char 62 at 8,17
  else
    put char 62 at 16,17
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 10,2, "GRAVINAUTS"
  print at 2,5, "BASED ON GRAVINAUTS BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! OCTOBER 1985"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: ARKION ASCENT"
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; GvIce: Hit = the first K (0-7) with Bx1 >= RL[K], Bx0 <= RR[K],
; By1 >= RT[K], By0 <= RB[K]; else 255. Same as the Amy loop it replaces.
GvIce:
    push ix
    ld ix,AMY_UVAR_RL
    ld a,(AMY_UVAR_Bx0)
    ld c,a
    ld a,(AMY_UVAR_Bx1)
    ld d,a
    ld a,(AMY_UVAR_By0)
    ld e,a
    ld a,(AMY_UVAR_By1)
    ld h,a
    ld b,0
gvi_loop:
    ld a,d
    cp (ix+0)
    jr c,gvi_next
    ld a,(ix+AMY_UVAR_RR-AMY_UVAR_RL)
    cp c
    jr c,gvi_next
    ld a,h
    cp (ix+AMY_UVAR_RT-AMY_UVAR_RL)
    jr c,gvi_next
    ld a,(ix+AMY_UVAR_RB-AMY_UVAR_RL)
    cp e
    jr c,gvi_next
    ld a,b
    jr gvi_done
gvi_next:
    inc ix
    inc b
    ld a,b
    cp 8
    jr nz,gvi_loop
    ld a,255
gvi_done:
    ld (AMY_UVAR_Hit),a
    pop ix
    ret
; GvRand: the 16-bit xorshift Rs ^= Rs << 7, Rs ^= Rs >> 9, Rs ^= Rs << 8
; (the same numbers as the Amy version it replaces)
GvRand:
    ld hl,(AMY_UVAR_Rs)
    ld a,h
    rra
    ld a,l
    rra
    ld b,a
    ld a,0
    rra
    xor l
    ld l,a
    ld a,b
    xor h
    ld h,a
    ld a,h
    srl a
    xor l
    ld l,a
    ld a,l
    xor h
    ld h,a
    ld (AMY_UVAR_Rs),hl
    ret
GvJet:
    db $00,$00,$36,$03,$00,$00,$56,$03,$10
GvBump:
    db $40,$53,$31,$02,$40,$C5,$61,$03,$50
GvFuel:
    db $40,$8F,$10,$03,$40,$71,$10,$03,$40,$5F,$10,$03,$40,$47,$20,$08,$50
GvPop:
    db $00,$00,$04,$03,$00,$00,$15,$06,$00,$00,$46,$0A,$00,$00,$77,$0A,$10
GvPopT:
    db $40,$55,$10,$03,$40,$71,$20,$03,$40,$AA,$30,$06,$50
GvBoom:
    db $00,$00,$04,$06,$00,$00,$05,$0C,$00,$00,$26,$10,$00,$00,$47,$18,$00,$00,$87,$1E,$10
GvLow:
    db $40,$40,$40,$04,$40,$40,$F0,$06,$40,$40,$40,$04,$50
GvWave:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0E,$50
GvClear:
    db $40,$AA,$10,$05,$40,$8F,$10,$05,$40,$6B,$10,$05,$40,$8F,$10,$05,$40,$6B,$10,$05,$40,$55,$20,$14
    db $50
GvOver:
    db $40,$1D,$11,$0C,$40,$41,$21,$0C,$40,$68,$21,$0C,$40,$AB,$31,$0C,$40,$3B,$32,$28,$50

GvSoundTable:
    dw GvTuneMel,$702B
    dw GvTuneBass,$7035
    dw GvJet,$703F
    dw GvBump,$7049
    dw GvFuel,$7049
    dw GvPop,$703F
    dw GvPopT,$7049
    dw GvBoom,$703F
    dw GvLow,$7049
    dw GvWave,$7049
    dw GvClear,$7049
    dw GvOver,$7049
; Arkion Ascent (original)
; Tiny Sound, 8 frames per step
GvTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$70,$1A,$21,$1C,$01,$1F,$01,$23,$01,$01,$28,$26,$01,$23,$01
    db $21,$01,$23,$01,$1F,$01,$01,$01,$1C,$01,$1E,$01,$1F,$01,$21,$01
    db $23,$01,$01,$01,$24,$01,$23,$01,$21,$01,$1F,$01,$21,$01,$01,$1E
    db $1A,$01,$1E,$01,$1F,$01,$1E,$01,$1C,$01,$1B,$01,$1C,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
GvTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$90,$18,$32,$04,$01,$0B,$01,$10,$01,$0B,$01,$04,$01,$0B,$01
    db $10,$01,$0B,$01,$0C,$01,$07,$01,$0C,$01,$07,$01,$0E,$01,$09,$01
    db $0E,$01,$09,$01,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$09,$01
    db $0E,$01,$09,$01,$0B,$01,$12,$01,$0B,$01,$12,$01,$04,$01,$0B,$01
    db $04,$01,$00,$01
    db $FF
}
