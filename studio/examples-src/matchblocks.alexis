cartridge "MATCHBLOCKS/JAMES A. SHEPHARD, AHOY!/1986"

' MATCHBLOCKS
' Based on "Matchblocks" by James A. Shephard, Ahoy! September 1986
' (page 41), a Commodore 64 BASIC game (orig/ has the detokenized
' listing from the magazine's disk). Made for the ColecoVision in Amy (the
' language by Amy Bienvenu) by Claude (an AI made by Anthropic) for Amy
' Studio, 2026.
'
' Kept from the listing: a framed board of 54 covered blocks, 9 across and
' 6 down; a match is 2 or 3 identical blocks, chosen before the game
' (lines 170-190); the 54 blocks are dealt at random (lines 200-240: 27
' designs twice, or 18 designs three times); the player at play uncovers
' 2 (or 3) blocks one after the other, a covered block not chosen already
' this turn (line 460); all the same: a match, one point, the blocks leave
' the board and the same player goes again (lines 520-630); otherwise NO
' MATCH, they are covered again and the next player plays (line 600); the
' round number goes up each time play comes back to the first player
' (line 280); 1 to 10 players; the game ends when every block is matched.
' The match call is the listing's own six notes (DATA 790).
'
' Liberties: players are letters A to J in their own cursor colours
' instead of typed names (no keyboard); the cursor stays where it was
' after a pick (the listing sent it back to the middle) and glides between
' blocks; blocks turn over and a match flashes; the winner (or a tie) is
' announced at the end, alone the number of rounds; the 27 designs are new
' drawings (9 patterns in 3 colours) instead of PETSCII pairs; a title
' tune; no "play again" question (the house rule: back to the title).
'
' Controls (either joystick, pass it round): the stick moves the cursor,
' a button uncovers a block. On the title, up and down choose a line,
' left and right change it, a button starts.
'
' House rules kept: joystick only; text in columns 2-29 and rows 1-22;
' tiles from code 128; the frame loop is protected from the NMI and every
' screen is drawn with the NMI off after a wait.
'
' Workarounds for Amy bugs mblocks-main-for-frame-os7 removed 2026-11-01.

const TF0000 = 128
const TF0001 = 129
const TF0010 = 130
const TF0011 = 131
const TF0100 = 132
const TF0101 = 133
const TF0110 = 134
const TF0111 = 135
const TF0200 = 136
const TF0201 = 137
const TF0210 = 138
const TF0211 = 139
const TF0300 = 140
const TF0301 = 141
const TF0310 = 142
const TF0311 = 143
const TF0400 = 144
const TF0401 = 145
const TF0410 = 146
const TF0411 = 147
const TF0500 = 148
const TF0501 = 149
const TF0510 = 150
const TF0511 = 151
const TF0600 = 152
const TF0601 = 153
const TF0610 = 154
const TF0611 = 155
const TF0700 = 156
const TF0701 = 157
const TF0710 = 158
const TF0711 = 159
const TF0800 = 160
const TF0801 = 161
const TF0810 = 162
const TF0811 = 163
const TF0900 = 164
const TF0901 = 165
const TF0910 = 166
const TF0911 = 167
const TF1000 = 168
const TF1001 = 169
const TF1010 = 170
const TF1011 = 171
const TF1100 = 172
const TF1101 = 173
const TF1110 = 174
const TF1111 = 175
const TF1200 = 176
const TF1201 = 177
const TF1210 = 178
const TF1211 = 179
const TF1300 = 180
const TF1301 = 181
const TF1310 = 182
const TF1311 = 183
const TF1400 = 184
const TF1401 = 185
const TF1410 = 186
const TF1411 = 187
const TF1500 = 188
const TF1501 = 189
const TF1510 = 190
const TF1511 = 191
const TF1600 = 192
const TF1601 = 193
const TF1610 = 194
const TF1611 = 195
const TF1700 = 196
const TF1701 = 197
const TF1710 = 198
const TF1711 = 199
const TF1800 = 200
const TF1801 = 201
const TF1810 = 202
const TF1811 = 203
const TF1900 = 204
const TF1901 = 205
const TF1910 = 206
const TF1911 = 207
const TF2000 = 208
const TF2001 = 209
const TF2010 = 210
const TF2011 = 211
const TF2100 = 212
const TF2101 = 213
const TF2110 = 214
const TF2111 = 215
const TF2200 = 216
const TF2201 = 217
const TF2210 = 218
const TF2211 = 219
const TF2300 = 220
const TF2301 = 221
const TF2310 = 222
const TF2311 = 223
const TF2400 = 224
const TF2401 = 225
const TF2410 = 226
const TF2411 = 227
const TF2500 = 228
const TF2501 = 229
const TF2510 = 230
const TF2511 = 231
const TF2600 = 232
const TF2601 = 233
const TF2610 = 234
const TF2611 = 235
const TBack00 = 236
const TBack01 = 237
const TBack10 = 238
const TBack11 = 239
const TTurnl = 240
const TTurnr = 241
const TLit = 242
const TJ3 = 243
const TJ12 = 244
const TJ10 = 245
const TJ6 = 246
const TJ9 = 247
const TJ5 = 248
const TJ14 = 249
const TJ13 = 250
const TJ11 = 251
const TJ7 = 252
const TJ15 = 253
const SFrame = 0
const NTiles8 = 1008
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndMove = 3
const SndFlip = 4
const SndMatch = 5
const SndMiss = 6
const SndNope = 7
const SndOver = 8
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the junction tile for each set of arms (up 1, down 2, left 4, right 8),
' as an offset from TJ3 (art.py's order 3, 12, 10, 6, 9, 5, 14, 13, 11, 7, 15)
data JOff bytes 0,0,0,0,0,5,3,9,0,4,2,8,1,7,6,10
' each player's cursor colour (A to J)
data PCol bytes 9,11,3,7,13,15,10,5,12,14

record Plr:
  u8 Score
  u8 Col
end record
Plr Pls[10]

' the board: Blk[] the design of each block (0-26), 255 once matched;
' Np players (1-10), Mk the blocks in a match (2 or 3), Up the player at
' play, Need the matches in a game (54 / Mk), Found so far; Pick[] the
' blocks uncovered this turn, Npk how many; Ph the phase for the tests
' (0 menus, 1 choosing, 2 a match shown, 3 no match shown, 5 game over)
u8 Blk[54]
u8 Np = 2
u8 Mk = 2
u8 Up = 0
u8 Need = 27
u8 Found = 0
bcd digits 3 Round = 1
u8 Pick[3]
u8 Npk = 0
u8 Pk = 0
u8 Ph = 0
u8 Mi = 0
' the cursor: the block's column and row, and the sprite gliding to it
u8 Cx = 4
u8 Cy = 2
i16 Sx = 120
i16 Sy = 63
u8 Dir = 0
u8 Rep = 0
' random numbers (xorshift), stirred while the title waits
u16 Rs = $3C5A
u16 Rt = 0

u16 NumU = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 Fl = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MkSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

new_game:
  Need = 54 / Mk
  Deal
  for K = 0 to 9
    Pls[K].Score = 0
    Pls[K].Col = PCol[K]
  next
  Found = 0
  Up = 0
  Round = 1
  Cx = 4
  Cy = 2
  Sx = 120
  Sy = 63
  DrawBoard
  ShowScores
  ShowScreen

next_turn:
  if Found >= Need then goto game_over
  Npk = 0
  ShowScores
  Say(0)
pick_next:
  WaitPick
  Pick[Npk] = Pk
  inc Npk
  Turn(Pk, 1)
  if Npk < Mk then goto pick_next
  if AllSame() = 1 then goto a_match
  ' no match: a moment to look, then covered again; the next player
  Ph = 3
  Say(2)
  play sound SndMiss
  for Tm = 1 to 75
    Frame1
    DrawCursor
  next
  for K = 0 to Npk - 1
    Turn(Pick[K], 0)
  next
  NextPlayer
  goto next_turn

a_match:
  Ph = 2
  K = Pls[Up].Score + 1
  Pls[Up].Score = K
  inc Found
  ShowScores
  Say(1)
  play sound SndMatch
  ' the blocks flash three times (about 2.5 Hz), then leave the board
  for J = 1 to 3
    DrawPicks(3)
    for Tm = 1 to 12
      Frame1
    next
    DrawPicks(1)
    for Tm = 1 to 12
      Frame1
    next
  next
  for K = 0 to Npk - 1
    V = Pick[K]
    Blk[V] = 255
    PutBlk(V, 4)
  next
  ' a match: the same player goes again
  goto next_turn

game_over:
  Ph = 5
  play sound SndOver
  set sprite 0 to 192,0,0,0
  update sprites
  fill 32 count 28 at 2,20
  if Np = 1 then
    print at 2,20, "ALL CLEAR IN"
    print at 15,20, Round
    print at 19,20, "ROUNDS"
  else
    V = Best()
    W = Winners(V)
    if W = 1 then
      print at 2,20, "PLAYER   WINS WITH"
      K = WinnerFrom(0)
      put char 65 + K at 9,20
      NumU = V
      print at 21,20, digits$(NumU, 2)
    else
      print at 2,20, "A TIE:"
      ShowTie(V)
    end if
  end if
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title


' CoverPicks: the blocks of a missed turn covered again
sub CoverPicks:
  u8 Ic = 0
  for Ic = 0 to Npk - 1
    Turn(Pick[Ic], 0)
  next
  return
end sub

' DrawPicks(K): the blocks of this turn drawn as K (see PutBlk)
sub DrawPicks(u8 Dkind):
  u8 Id = 0
  for Id = 0 to Npk - 1
    PutBlk(Pick[Id], Dkind)
  next
  return
end sub

' RemovePicks: a match leaves the board
sub RemovePicks:
  u8 Ir = 0
  u8 Bv = 0
  for Ir = 0 to Npk - 1
    Bv = Pick[Ir]
    Blk[Bv] = 255
    PutBlk(Bv, 4)
  next
  return
end sub

' ShowTie(S): the letters of every player with score S, from column 9
sub ShowTie(u8 Ts):
  u8 It = 0
  u8 Tx = 9
  for It = 0 to Np - 1
    if Pls[It].Score = Ts then
      put char 65 + It at Tx,20
      Tx = Tx + 2
    end if
  next
  return
end sub

' NextPlayer: play passes on; back at player A, a new round
sub NextPlayer:
  inc Up
  if Up >= Np then
    Up = 0
    inc Round
  end if
  return
end sub

' AllSame: 1 if every block uncovered this turn shows the same design
function AllSame as u8
  u8 First = 0
  u8 Same = 1
  u8 Ix = 0
  First = Blk[Pick[0]]
  for Ix = 1 to Npk - 1
    if Blk[Pick[Ix]] <> First then Same = 0
  next
  return Same

' Best: the highest score
function Best as u8
  u8 Hi = 0
  u8 Ip = 0
  u8 Sv = 0
  for Ip = 0 to Np - 1
    Sv = Pls[Ip].Score
    if Sv > Hi then Hi = Sv
  next
  return Hi

' Winners(S): how many players have score S
function Winners(u8 S) as u8
  u8 Cnt = 0
  u8 Ip = 0
  for Ip = 0 to Np - 1
    if Pls[Ip].Score = S then inc Cnt
  next
  return Cnt

' WinnerFrom(I): the first player from I with the best score
function WinnerFrom(u8 Ip) as u8
  u8 Hi = 0
  Hi = Best()
  while Pls[Ip].Score <> Hi
    inc Ip
  end while
  return Ip

' RandBelow(N): a random number from 0 to N - 1 (N up to 64)
function RandBelow(u8 N) as u8
  u8 R = 0
  Rnd16
  R = Rs & 63
  while R >= N
    Rnd16
    R = Rs & 63
  end while
  return R

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' Deal: Need designs, each Mk times, mixed (Fisher-Yates)
sub Deal:
  u8 Dk = 0
  u8 Dj = 0
  u8 Dt = 0
  Dt = 0
  for Dk = 0 to 53
    Blk[Dk] = Dt
    inc Dt
    if Dt >= Need then Dt = 0
  next
  for Dk = 53 to 1 step -1
    Dj = RandBelow(Dk + 1)
    Dt = Blk[Dk]
    Blk[Dk] = Blk[Dj]
    Blk[Dj] = Dt
  next
  return
end sub

' WaitPick: the player moves the cursor and uncovers a block: Pk, a block
' still on the board and not uncovered this turn
sub WaitPick:
  Ph = 1
wp_loop:
  Frame1
  ReadPad
  MoveCursor
  DrawCursor
  if Press = 0 then goto wp_loop
  Pk = Cy * 9 + Cx
  if CanPick(Pk) = 0 then
    play sound SndNope
    goto wp_loop
  end if
  return
end sub

' CanPick(B): 1 if block B is covered (on the board, not picked this turn)
function CanPick(u8 B) as u8
  u8 Ok = 1
  u8 Iq = 0
  if Blk[B] = 255 then Ok = 0
  if Npk > 0 then
    for Iq = 0 to Npk - 1
      if Pick[Iq] = B then Ok = 0
    next
  end if
  return Ok

' MoveCursor: a push moves one block; held, it repeats
sub MoveCursor:
  V = 0
  if Lf1 = 1 then V = 1
  if Rt1 = 1 then V = 2
  if Up1 = 1 then V = 3
  if Dn1 = 1 then V = 4
  if V = 0 then
    Dir = 0
    return
  end if
  if V <> Dir then
    Dir = V
    Rep = 16
  else
    dec Rep
    if Rep > 0 then return
    Rep = 8
  end if
  select case V
  case 1
    if Cx > 0 then dec Cx
  case 2
    if Cx < 8 then inc Cx
  case 3
    if Cy > 0 then dec Cy
  case else
    if Cy < 5 then inc Cy
  end select
  play sound SndMove
  return
end sub

' DrawCursor: the frame glides 4 pixels a frame to the chosen block, in
' the colour of the player at play
sub DrawCursor:
  i16 Tx = 0
  i16 Ty = 0
  Tx = Cx * 24 + 24
  Ty = Cy * 24 + 15
  if Sx < Tx then Sx = Sx + 4
  if Sx > Tx then Sx = Sx - 4
  if Sy < Ty then Sy = Sy + 4
  if Sy > Ty then Sy = Sy - 4
  X = Sx
  Y = Sy
  set sprite 0 to Y,X,SFrame,Pls[Up].Col
  update sprites
  return
end sub

' Turn(B, U): block B turns face up (U 1) or covered (U 0)
sub Turn(u8 Tb, u8 Tu):
  play sound SndFlip
  PutBlk(Tb, 2)
  Frame1
  Frame1
  Frame1
  Frame1
  if Tu = 1 then
    PutBlk(Tb, 1)
  else
    PutBlk(Tb, 0)
  end if
  return
end sub

' PutBlk(B, K): block B drawn as K: 0 covered, 1 its design, 2 turning,
' 3 lit, 4 gone
sub PutBlk(u8 Pb, u8 Pkind):
  u8 Bx = 0
  u8 By = 0
  u8 T0 = 0
  u8 T1 = 0
  u8 T2 = 0
  u8 T3 = 0
  By = Pb / 9
  Bx = Pb - By * 9
  Bx = Bx * 3 + 3
  By = By * 3 + 2
  select case Pkind
  case 0
    T0 = TBack00
    T1 = TBack01
    T2 = TBack10
    T3 = TBack11
  case 1
    T0 = Blk[Pb] * 4 + TF0000
    T1 = T0 + 1
    T2 = T0 + 2
    T3 = T0 + 3
  case 2
    T0 = TTurnl
    T1 = TTurnr
    T2 = TTurnl
    T3 = TTurnr
  case 3
    T0 = TLit
    T1 = TLit
    T2 = TLit
    T3 = TLit
  case else
    T0 = 32
    T1 = 32
    T2 = 32
    T3 = 32
  end select
  put char T0 at Bx,By
  put char T1 at Bx + 1,By
  put char T2 at Bx,By + 1
  put char T3 at Bx + 1,By + 1
  return
end sub

' DrawBoard: the grid of lines and every block covered
sub DrawBoard:
  u8 Gx = 0
  u8 Gy = 0
  u8 Arms = 0
  NewScreen
  for Gy = 1 to 19
    for Gx = 2 to 29
      if (Gy - 1) % 3 = 0 then
        if (Gx - 2) % 3 = 0 then
          Arms = 0
          if Gy > 1 then Arms = Arms | 1
          if Gy < 19 then Arms = Arms | 2
          if Gx > 2 then Arms = Arms | 4
          if Gx < 29 then Arms = Arms | 8
          put char TJ3 + JOff[Arms] at Gx,Gy
        else
          put char TJ12 at Gx,Gy
        end if
      else
        if (Gx - 2) % 3 = 0 then put char TJ3 at Gx,Gy
      end if
    next
  next
  for K = 0 to 53
    PutBlk(K, 0)
  next
  return
end sub

' ShowScores: rows 21-22, A to J with their matches, an arrow at the
' player at play
sub ShowScores:
  u8 Ip = 0
  u8 Col = 0
  u8 Row = 0
  for Ip = 0 to Np - 1
    Col = (Ip % 5) * 6 + 2
    Row = Ip / 5 + 21
    if Ip = Up then
      put char 62 at Col,Row
    else
      put char 32 at Col,Row
    end if
    put char 65 + Ip at Col + 1,Row
    NumU = Pls[Ip].Score
    print at Col + 3,Row, digits$(NumU, 2)
  next
  return
end sub

' Say(N): row 20: the round and 0 whose turn, 1 a match, 2 no match
sub Say(u8 Sn):
  fill 32 count 28 at 2,20
  print at 2,20, "ROUND"
  print at 8,20, Round
  select case Sn
  case 0
    print at 13,20, "PLAYER  , GO"
    put char 65 + Up at 20,20
  case 1
    print at 13,20, "M A T C H !"
  case else
    print at 13,20, "NO MATCH"
  end select
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' ReadPad: both controllers (players pass one round, or share)
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' ReadMenu: a push of the stick counted once
sub ReadMenu:
  ReadPad
  V = Lf1 | Rt1 | Up1 | Dn1
  if V = 1 then
    if WasStick = 1 then
      Lf1 = 0
      Rt1 = 0
      Up1 = 0
      Dn1 = 0
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a row of blocks, the options
sub TitlePage:
tp_again:
  NewScreen
  print at 10,5, "MATCHBLOCKS"
  for K = 0 to 8
    Blk[K] = K * 3
    PutBlk(K, 1)
  next
  print at 6,9, "PLAYERS"
  print at 6,11, "A MATCH IS"
  print at 6,13, "START"
  print at 6,15, "CREDITS"
  print at 4,19, "UP, DOWN: CHOOSE"
  print at 4,20, "LEFT, RIGHT: CHANGE"
  print at 4,21, "BUTTON: GO"
  Mi = 2
  ShowOptions
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Ph = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadMenu
  Rnd16
  ' the blocks along the top change one by one, twice a second
  V = Tick & 31
  if V = 0 then
    K = Tick >> 5
    K = K % 9
    Blk[K] = RandBelow(27)
    PutBlk(K, 1)
  end if
  if Up1 = 1 then
    if Mi > 0 then
      dec Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  if Dn1 = 1 then
    if Mi < 3 then
      inc Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  V = Lf1 | Rt1
  if V = 1 then
    ChangeOpt
    play sound SndMove
    ShowOptions
  end if
  if Press = 0 then goto tp_loop
  if Mi < 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Mi = 3 then
    CreditsPage
    goto tp_again
  end if
  return
end sub

' ChangeOpt: left or right on the chosen line
sub ChangeOpt:
  if Mi = 0 then
    if Rt1 = 1 then
      inc Np
      if Np > 10 then Np = 1
    else
      dec Np
      if Np = 0 then Np = 10
    end if
  end if
  if Mi = 1 then Mk = 5 - Mk
  return
end sub

sub ShowOptions:
  for J = 9 to 15
    put char 32 at 4,J
  next
  put char 62 at 4,Mi * 2 + 9
  NumU = Np
  print at 18,9, digits$(NumU, 2)
  if Mk = 2 then
    print at 18,11, "2 ALIKE"
  else
    print at 18,11, "3 ALIKE"
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  for X = 2 to 29
    put char TJ12 at X,2
    put char TJ12 at X,21
  next
  print at 10,4, "MATCHBLOCKS"
  print at 3,6, "BASED ON MATCHBLOCKS BY"
  print at 3,7, "JAMES A. SHEPHARD, AHOY!"
  print at 3,8, "SEPTEMBER 1986 (C64)."
  print at 3,10, "MADE FOR THE COLECOVISION"
  print at 3,11, "BY CLAUDE (AN AI MADE BY"
  print at 3,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,13, "2026, IN AMY (THE LANGUAGE"
  print at 3,14, "BY AMY BIENVENU)."
  print at 3,16, "MUSIC: BUILDING BLOCKS."
  print at 3,17, "MATCH CALL: THE LISTING'S."
  print at 8,19, "PRESS A BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Ph = 9
cr_loop:
  Frame1
  ReadMenu
  Rnd16
  if Press = 0 then goto cr_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

