project "Portal Demo"
cartridge "PORTAL DEMO/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' Amy port of old-projects-sdcc-z80/sdcctest/portal.
' Demonstrates converted ZX0 assets, sprite-pattern upload, VBlank equalizer
' sprites reading Coleco BIOS sound areas, and the original BIOS sound table.

asset PortalName from "@project/portal.name.zx0" codec zx0
asset PortalPattern from "@project/portal.pattern.zx0" codec zx0
asset PortalSpritePattern from "@project/portal.sprpat.zx0" codec zx0
asset PortalColorFull from "@project/portal.color.zx0" codec zx0

u16 MusicTimer = 0
u8 MusicActive = 0

on vblank PortalVblank

sub start:
  screen off
  tile screen
  sprites 16x16
  sprites double
  set sound table PortalSoundTable areas 7
  decompress zx0 PortalPattern to vram.pattern
  duplicate mode 2 text patterns
  decompress zx0 PortalName to vram.name
  decompress zx0 PortalColorFull to vram.color
  decompress zx0 PortalSpritePattern to vram.spr_pat
  set sprite pattern table vram.spr_pat
  clear sprites
  set sprite count 4
  update sprites from 0 count 4
  MusicTimer = 0
  MusicActive = 1
  screen on
main_loop:
  wait
  goto main_loop

sub PortalVblank:
  if MusicActive = 0 then return
  PortalUpdateEqualizer
  select case MusicTimer
  case 0
    mute all
    play sound 2
  case 961
    play sound 3
  case 62, 782
    stop sound 7
    play sound 4
  case 541, 1501
    stop sound 4
    play sound 5
  case 660, 1620
    stop sound 5
    play sound 6
  case 1739
    stop sound 6
    play sound 7
  end select
  MusicTimer += 1
  if MusicTimer > 1900 then
    MusicTimer = 0
  end if
  return

sub PortalUpdateEqualizer:
  asm {
Portal_Update_Equalizer:
    ld hl,AMY_SPRITE_TABLE
    ld de,$7035
    ld b,3
    ld c,80
Portal_Equalizer_Loop:
    ld (hl),159
    inc hl
    ld (hl),c
    inc hl
    ld a,(de)
    cp $FF
    ld a,60
    jr z,Portal_Equalizer_Pattern_Ready
    push de
    inc de
    inc de
    inc de
    inc de
    ld a,(de)
    pop de
    srl a
    srl a
Portal_Equalizer_Pattern_Ready:
    ld (hl),a
    inc hl
    ld (hl),6
    inc hl
    ld a,c
    add a,32
    ld c,a
    ld a,e
    add a,10
    ld e,a
    jr nc,Portal_Equalizer_Next
    inc d
Portal_Equalizer_Next:
    djnz Portal_Equalizer_Loop
    ld (hl),$D0
    inc hl
    xor a
    ld (hl),a
    inc hl
    ld (hl),60
    inc hl
    xor a
    ld (hl),a
    ld hl,AMY_SPRITE_TABLE
    ld de,$1B00
    ld a,4
    call AMY_UPDATE_SPRITES_PARTIAL
  }
  return

end sub

