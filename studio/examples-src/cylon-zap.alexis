    dw sndtiny_2
    db 6
    db $02,$70,$F1,$22,$0B,$0B,$12,$0B,$0B,$0B,$12,$0B,$09,$09,$10,$09
    db $0B,$0B,$12,$0B,$0B,$0B,$12,$0B,$0E,$0E,$15,$0E,$09,$09,$10,$09
    db $0B,$0B,$12,$0B,$07,$07,$0E,$07,$07,$07,$0E,$07,$09,$09,$10,$09
    db $09,$09,$10,$09,$0B,$0B,$12,$0B,$07,$07,$0E,$07,$06,$06,$0D,$06
    db $0B,$00,$00,$00
    db $FF

; OrCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
OrCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
OrCellDiv:
    or a
    sbc hl,de
    jr c,OrCellRem
    inc b
    jr OrCellDiv
OrCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; CzBack: the backdrop (VDP register 7) to the colour V
CzBack:
    ld a,(AMY_UVAR_V)
    out ($BF),a
    ld a,$87
    out ($BF),a
    ret

; OrPeek: Pk = the tile at B
OrPeek:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; OrPoke: the tile Tl at B
OrPoke:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret
}
