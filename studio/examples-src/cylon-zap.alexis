    dw sndtiny_1
    db 6
    db $02,$30,$31,$88,$23,$00,$23,$26,$2A,$00,$28,$26,$25,$00,$21,$00
    db $23,$00,$00,$00,$23,$00,$23,$26,$2A,$00,$2D,$2B,$2A,$00,$28,$00
