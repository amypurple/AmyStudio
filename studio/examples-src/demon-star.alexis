' DEMON STAR
' The game by Stan McDaniel from COMPUTE!'s Gazette, September 1983
' (pages 60-63 and 113-114), for the ColecoVision in Amy by Amy Bienvenu.
' Ported by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: Programs 1 and 2, the VIC-20 version (the game and its data
' file of characters), transcribed in orig/demon-star-vic.bas from the
' scans beside it. The characters and colours are the listing's own.
'
' The game: your starship crosses a universe of nebulae (5 energy units),
' spiral galaxies (10), stars (15) and double spiral galaxies (20); shoot
' them with matter conversion torpedoes for their energy, but never fly
' into one. Quasars appear with a deep warning: destroy one within the
' time (about 12 seconds) for 100 units, or lose 500. Now and then a Demon
' Star comes instead, in a blinding flash with a roar: it shortens your
' torpedoes' range, and failing to destroy it in time costs your ship; it
' is worth 500. Every 1000 units, 100 more and a new universe; past 3000
' the universe gets denser. Running out of energy also ends the game.
'
' Controls (either joystick): the stick flies the ship in eight
' directions (it keeps going the way it last went); the button fires, and
' held, fires again and again. Keypad not used.
'
' The VIC-20's screen is kept cell for cell, 22 columns at columns 5-26:
' places are VIC screen offsets. Labels such as l170 follow the listing's
' line numbers (l17 is line 17). The ship and torpedoes wrap around the
' edges, as the article warns.
'
' Liberties taken:
' - The universe is 22 rows, not the VIC's 23: its last row would sit in
'   the overscan of a CRT ColecoVision, where the ship starts. (The
'   listing also let the ship wander into a 24th, invisible row.)
' - The level is chosen with the stick and the button; "ANOTHER GAME" is a
'   YES or NO.
' - A torpedo that hits at once no longer erases the cell of the previous
'   torpedo (the listing's stale T).
' - A title page with credits and new music (Far Signal); the POKEd sounds
'   are Tiny Sound effects.
' - Timing: a move is 4 frames, a torpedo step 2, near the VIC's BASIC;
'   the clock counts frames (TI counted jiffies, 700 of them).
'
' House rules kept: text in columns 2-29 and rows 1-22; no sprites; the
' frame loop is protected from the NMI and every screen is drawn with the
' NMI off after a wait.

const TShip33 = 128
const TShip34 = 129
const TShip35 = 130
const TShip36 = 131
const TShip38 = 132
const TShip39 = 133
const TShip40 = 134
const TShip41 = 135
const TTorp = 136
const TNeb = 137
const TSpi = 138
const TStar = 139
const TDbl = 140
const TQuasar = 141
const TDemon = 142
const TBoom = 143
const SNone = 0
const NTiles8 = 128
const SprBytes = 32
const SndBoom = 1
const SndRoar = 2
const SndHush = 3
const SndTorp = 4
const SndWarn = 5
const SndBonus = 6
const SndTick = 7
const SndTuneA = 8
const SndTuneB = 9
u16 TzLeft = 0
u8 TzOn = 0

' --- the listing's variables ----------------------------------------------
' SX, SY the ship's column and row, MC, MR its direction, SH its cell; PT
' the energy, BB the next bonus, SK the level, FL 0 calm, 1 crashed, 2 a
' Quasar or Demon Star about, RG the torpedo range, RP the visitor's cell,
' Tim the clock (TI); TX, TY, PX, PY the torpedo, T its cell
i8 SX = 3
i8 SY = 21
i8 MC = 0
i8 MR = -1
u16 SH = 0
i16 PT = 0
i16 BB = 1000
u8 SK = 4
u8 FL = 0
u8 RG = 8
u16 RP = 0
u16 Tim = 0
i8 TX = 0
i8 TY = 0
i8 PX = 0
i8 PY = 0
u16 T = 0
u8 L = 0
u16 XP = 0
u8 Ub[484]
u8 Lift = 0
' the cell under Bx (OrPeek) and the tile to put there (OrPoke)
u16 Bx = 0
u8 Pk = 0
u8 Tl = 0
' for the test bot: 1 flying, 2 a torpedo, 3 explosion, 4 bonus, 5 level,
' 6 yes or no, 7 the end, 8 title
u8 Ph = 0
u8 Tc = $F1

u16 NumU = 0
u16 V16 = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Rw = 0
u32 Uq = 0
u32 Uq2 = 0
u8 Sel = 0
u8 Oy = 0
u8 Nopt = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 H = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0

  ' no cartridge screen: the game starts on its title
  tile screen
  set sound table DmSoundTable areas 4
  nmi off
  screen on

title:
  Ph = 8
  Tc = $F1
  TextScreen
  backdrop dark blue
  print at 10,3, "DEMON STAR"
  put char TDemon at 8,3
  put char TDemon at 21,3
  print at 8,5, "BY STAN MCDANIEL"
  print at 2,8, "SHOOT FOR ENERGY:"
  put char TNeb at 4,10
  print at 6,10, "5"
  put char TSpi at 9,10
  print at 11,10, "10"
  put char TStar at 15,10
  print at 17,10, "15"
  put char TDbl at 21,10
  print at 23,10, "20"
  put char TQuasar at 4,12
  print at 6,12, "QUASAR 100"
  put char TDemon at 4,14
  print at 6,14, "DEMON STAR 500"
  print at 2,16, "NEVER FLY INTO ANYTHING."
  print at 2,19, "COMPUTE!'S GAZETTE SEPT 1983"
  print at 2,20, "COLECOVISION: CLAUDE (AN AI"
  print at 2,21, "BY ANTHROPIC), AMY STUDIO"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 384
  TzOn = 1
  Hold(90)
  print at 7,17, "PRESS A BUTTON"
  WaitPress
  Rs = Rs ^ Tick
  if Rs = 0 then Rs = $5A3C

l7:
  ' 7: the level
  PT = 0
  BB = 1000
  Ph = 5
  TextScreen
  print at 9,6, "LEVEL (1-10)"
  print at 2,12, "LEFT AND RIGHT CHOOSE,"
  print at 2,13, "THE BUTTON STARTS."
  print at 2,16, "FIRST FLIGHT: LEVEL 2 OR 3."
  ShowScreen
  WasBtn = 1
lv_draw:
  print at 12,9, "<    >"
  NumU = SK
  if SK < 10 then
    print at 14,9, digits$(NumU, 1)
  else
    print at 14,9, digits$(NumU, 2)
  end if
lv_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if SK > 1 then dec SK
    end if
    if Rt1 = 1 then
      if SK < 10 then inc SK
    end if
    play sound SndTick
    goto lv_draw
  end if
  if Press = 0 then goto lv_loop
  play sound SndTick

l8:
  ' 8-16: a universe
  FL = 0
  RG = 8
  Tc = $F1
  TextScreen
  backdrop dark blue
  ' 13-14: three times the level of each kind, in its colour
  for H = 0 to 3
    V = SK * 3
    for J = 1 to V
      FreeCell
      Bx = RP
      Tl = TNeb + H
      call asm OrPoke
    next
  next
  ' 15: the ship, bottom left, pointing up
  MC = 0
  MR = -1
  SX = 3
  SY = 21
  SH = 465
  Bx = SH
  Tl = TShip36
  call asm OrPoke
  ' 16: the universe slides up into view
  call asm DmGrab
  Lift = 22
  call asm DmShow
  ShowScreen
  for K = 1 to 22
    Frame1
    Lift = 22 - K
    call asm DmShow
  next
  Hold(60)
  Ph = 1

l17:
  ' 17: the energy; now and then a visitor
  ShowPT
  if FL = 0 then
    Rnd16
    V = highbyte Rw
    V = V % 10
    if V = 3 then goto l63
  end if
l18:
  if FL = 2 then
    ' the seconds (RIGHT$(TI$,2))
    V16 = Tim / 60
    NumU = V16
    print at 6,2, digits$(NumU, 2)
    if Tim > 700 then goto l72
  end if
  Hold(4)
  ' 20: the button fires
  ReadPad
  if Btn = 1 then goto l34
  ' 21-25: the stick (no stick: on the way it went)
  X = 0
  if Rt1 = 1 then X = 1
  if Lf1 = 1 then X = 2
  Y = 0
  if Dn1 = 1 then Y = 1
  if Up1 = 1 then Y = 2
  V = X | Y
  if V <> 0 then
    MC = 0
    if X = 1 then MC = 1
    if X = 2 then MC = -1
    MR = 0
    if Y = 1 then MR = 1
    if Y = 2 then MR = -1
  end if
  ' 26-29: a step, round the edges
  SX = SX + MC
  SY = SY + MR
  if SY < 0 then SY = 21
  if SY > 21 then SY = 0
  if SX > 21 then SX = 0
  if SX < 0 then SX = 21
  ' 30: into something?
  CellXY(SX, SY)
  call asm OrPeek
  V = Pk - TNeb
  if V < 6 then
    FL = 1
    XP = Bx
    L = Pk
    goto l45
  end if
  ' 31: the ship moves
  XP = Bx
  Bx = SH
  Tl = 32
  call asm OrPoke
  SH = XP
  Bx = SH
  ShipTile
  call asm OrPoke
  ' 32
  if FL <> 2 then print at 6,2, "  "
  goto l17

l34:
  ' 34-44: a torpedo, RG cells the way the ship points
  Ph = 2
  TX = SX
  TY = SY
  PX = MC
  PY = MR
  for I = 1 to RG
    TX = TX + PX
    TY = TY + PY
    play sound SndTorp
    if I <> 1 then
      Bx = T
      Tl = 32
      call asm OrPoke
    end if
    if TX > 21 then TX = 0
    if TX < 0 then TX = 21
    if TY > 21 then TY = 0
    if TY < 0 then TY = 21
    CellXY(TX, TY)
    call asm OrPeek
    V = Pk - TNeb
    if V < 6 then
      XP = Bx
      L = Pk
      goto l45
    end if
    T = Bx
    Tl = TTorp
    call asm OrPoke
    Hold(2)
  next
  Bx = T
  Tl = 32
  call asm OrPoke
  Ph = 1
  goto l17

l45:
  ' 45-55: something destroyed (or the ship)
  Ph = 3
  if FL = 1 then goto l50
  if L = TDemon then
    PT = PT + 500
    FL = 0
    RG = 8
    play sound SndHush
    goto l50
  end if
  if L < TQuasar then
    V = L - TNeb
    inc V
    V = V * 5
    PT = PT + V
  end if
  if L = TQuasar then
    PT = PT + 100
    FL = 0
  end if
  ' 49: the Demon Star's roar goes on: no blast sound
  Bx = RP
  call asm OrPeek
  if Pk = TDemon then goto l52
l50:
  Bx = XP
  Tl = TBoom
  call asm OrPoke
  play sound SndBoom
  Hold(24)
l52:
  for K = 1 to 3
    Bx = XP
    Tl = TBoom
    call asm OrPoke
    Hold(3)
    Tl = 32
    call asm OrPoke
    Hold(3)
  next
  if FL = 1 then goto l56
  if PT > BB then goto l67
  ' 55 (only a torpedo is erased)
  Bx = T
  call asm OrPeek
  if Pk = TTorp then
    Tl = 32
    call asm OrPoke
  end if
  if FL <> 2 then print at 6,2, "  "
  Ph = 1
  goto l17

l56:
  ' 56-59: the end
  Ph = 7
  play sound SndHush
  FL = 0
  Tc = $F8
  TextScreen
  backdrop medium red
  if PT < 0 then
    print at 2,4, "ENERGY LOSS:"
  else
    print at 2,4, "SHIP DESTROYED."
    print at 2,6, "ENERGY TRANSMITTED:"
  end if
  ShowPTAt(2, 8)
  ShowScreen
  Hold(90)
  print at 2,12, "ANOTHER GAME ?"
  Oy = 14
  YesNo
  if Sel = 1 then goto l7
  goto title

l63:
  ' 63-66: a visitor; a Demon Star only when the first cell drawn is in
  ' the top 26 (the listing's IF RP<7706)
  FreeCell
  if RP < 26 then
    FreeCell
    Bx = RP
    Tl = TDemon
    call asm OrPoke
    play sound SndRoar
    ' 75: the blinding flash
    for K = 1 to 6
      backdrop white
      Hold(2)
      backdrop dark blue
      Hold(2)
    next
    RG = 5
  else
    Bx = RP
    Tl = TQuasar
    call asm OrPoke
    play sound SndWarn
  end if
  Hold(12)
  FL = 2
  Tim = 0
  goto l18

l67:
  ' 67-69: a bonus and a new universe
  Ph = 4
  play sound SndHush
  TextScreen
  backdrop dark blue
  print at 11,11, "BONUS 100"
  ShowScreen
  play sound SndBonus
  Hold(60)
  PT = PT + 100
  BB = BB + 1000
  if PT > 3000 then
    if SK < 8 then inc SK
  end if
  goto l8

l72:
  ' 72-74: out of time
  Bx = RP
  call asm OrPeek
  if Pk = TDemon then
    FL = 1
    goto l56
  end if
  Tl = 32
  call asm OrPoke
  PT = PT - 500
  if PT < 0 then
    FL = 1
    goto l56
  end if
  print at 6,2, "  "
  FL = 0
  goto l17

' FreeCell (70-71): RP = a random empty cell
sub FreeCell:
fc_again:
  Rnd16
  Uq = Rw
  Uq2 = 484
  Uq = Uq * Uq2
  Uq = Uq >> 16
  RP = lowword Uq
  Bx = RP
  call asm OrPeek
  if Pk <> 32 then goto fc_again
  return
end sub

' CellXY(x, y): Bx = the VIC offset of column x, row y
sub CellXY(i8 Cx, i8 Cy):
  V = Cy
  Bx = V
  Bx = Bx * 22
  V = Cx
  V16 = V
  Bx = Bx + V16
  return
end sub

' ShipTile: Tl = MX%(MC+1, MR+1)
sub ShipTile:
  V = MC + 1
  V = V * 3
  K = MR + 1
  V = V + K
  if V > 4 then dec V
  Tl = TShip33 + V
  return
end sub

' ShowPT (17): the energy, top left in white
sub ShowPT:
  ShowPTAt(5, 1)
  return
end sub

sub ShowPTAt(u8 Qx, u8 Qy):
  fill 32 count 6 at Qx,Qy
  if PT < 0 then
    print at Qx,Qy, "-"
    V16 = 0 - PT
  else
    V16 = PT
  end if
  inc Qx
  NumU = V16
  ShowNum(Qx, Qy)
  return
end sub

' ShowNum X, Y: NumU, as many digits as it has
sub ShowNum(u8 Px, u8 Py):
  if NumU < 10 then
    print at Px,Py, digits$(NumU, 1)
  else
    if NumU < 100 then
      print at Px,Py, digits$(NumU, 2)
    else
      if NumU < 1000 then
        print at Px,Py, digits$(NumU, 3)
      else
        print at Px,Py, digits$(NumU, 4)
      end if
    end if
  end if
  return
end sub

' PickOne: one of Nopt lines from row Oy (column 6), the cursor at 4
sub PickOne:
  Sel = 1
  WasBtn = 1
po_draw:
  for I = 1 to Nopt
    Y = Oy + I
    dec Y
    print at 4,Y, " "
  next
  Y = Oy + Sel
  dec Y
  print at 4,Y, ">"
po_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Sel > 1 then dec Sel
    end if
    if Dn1 = 1 then
      if Sel < Nopt then inc Sel
    end if
    goto po_draw
  end if
  if Press = 0 then goto po_loop
  play sound SndTick
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with Tc
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  fill 32 count 768 to vram.name
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  ' TI: the Quasar's or Demon Star's clock
  if FL = 2 then inc Tim
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 16
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 5
      end if
    end if
  end if
  WasStick = V
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub


' YesNo: YES or NO on row Oy (Sel 1 = YES)
sub YesNo:
  Ph = 6
  Sel = 1
  WasBtn = 1
yn_draw:
  print at 10,Oy, " YES   NO "
  X = 10
  if Sel = 2 then X = 16
  print at X,Oy, ">"
yn_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then Sel = 1
    if Rt1 = 1 then Sel = 2
    goto yn_draw
  end if
  if Press = 0 then goto yn_loop
  play sound SndTick
  return
end sub

data TilePat bytes
  $80,$81,$86,$70,$68,$44,$40,$20
  $06,$08,$10,$03,$03,$10,$08,$06
  $20,$40,$44,$68,$70,$86,$81,$80
  $18,$18,$18,$18,$C3,$A5,$99,$81
  $81,$99,$A5,$C3,$18,$18,$18,$18
  $01,$81,$61,$0E,$16,$22,$02,$04
  $60,$10,$08,$C0,$C0,$08,$10,$60
  $04,$02,$22,$16,$0E,$61,$81,$01
  $00,$00,$24,$18,$18,$24,$00,$00
  $80,$52,$A4,$50,$15,$AA,$15,$22
  $18,$C3,$62,$49,$A2,$A6,$32,$04
  $00,$2A,$1C,$C1,$1C,$2A,$00,$00
  $00,$70,$98,$43,$42,$19,$0E,$00
  $C3,$42,$81,$99,$99,$81,$42,$C3
  $38,$10,$54,$01,$54,$10,$38,$00
  $A2,$8B,$83,$38,$C3,$95,$51,$90
end data
data TileCol bytes
  $71,$17,$17,$71,$71,$71,$71,$71
  $71,$71,$71,$17,$17,$71,$71,$71
  $71,$71,$71,$71,$71,$17,$17,$71
  $71,$71,$71,$71,$17,$17,$71,$71
  $71,$71,$17,$17,$71,$71,$71,$71
  $71,$17,$17,$71,$71,$71,$71,$71
  $71,$71,$71,$17,$17,$71,$71,$71
  $71,$71,$71,$71,$71,$17,$17,$71
  $01,$01,$F1,$F1,$F1,$F1,$01,$01
  $D1,$D1,$D1,$D1,$D1,$D1,$D1,$D1
  $21,$12,$21,$21,$12,$12,$21,$21
  $01,$51,$51,$15,$51,$51,$01,$01
  $01,$B1,$B1,$1B,$1B,$B1,$B1,$01
  $18,$81,$81,$81,$81,$81,$81,$18
  $51,$51,$51,$15,$51,$51,$51,$01
  $81,$18,$18,$81,$18,$18,$81,$81
end data
data SpritePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
DmBoom:
    db $00,$00,$06,$03,$00,$00,$16,$03,$00,$00,$26,$03,$00,$00,$36,$03,$00,$00,$46,$03,$00,$00,$56,$03
    db $00,$00,$66,$03,$00,$00,$76,$03,$00,$00,$86,$03,$00,$00,$96,$03,$00,$00,$A6,$03,$00,$00,$B6,$03
    db $00,$00,$C6,$03,$00,$00,$D6,$03,$00,$00,$E6,$03,$00,$00,$F6,$03,$10
DmRoar:
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F
    db $00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$17,$0F,$00,$00,$F7,$01,$10
DmHush:
    db $00,$00,$F7,$01,$10
DmTorp:
    db $40,$34,$10,$01,$40,$FE,$F0,$01,$50
DmWarn:
    db $40,$37,$03,$1E,$40,$FE,$F0,$01,$50
DmBonus:
    db $40,$7E,$10,$08,$40,$5B,$10,$08,$40,$38,$10,$10,$40,$FE,$F0,$01,$50
DmTick:
    db $40,$40,$50,$01,$50

DmSoundTable:
    dw DmBoom,$702B
    dw DmRoar,$702B
    dw DmHush,$702B
    dw DmTorp,$7035
    dw DmWarn,$7035
    dw DmBonus,$7035
    dw DmTick,$7035
    dw DmTuneMel,$703F
    dw DmTuneBass,$7049
; Far Signal, D minor to D major (original for this game)
; Tiny Sound, 6 frames per step
DmTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$1A,$21,$1C,$00,$21,$00,$24,$00,$23,$21,$1F,$00,$00,$00
    db $1C,$00,$00,$00,$1D,$00,$21,$00,$26,$00,$24,$23,$21,$00,$00,$00
    db $23,$00,$00,$00,$24,$00,$28,$00,$2D,$00,$2B,$29,$28,$00,$26,$00
    db $24,$00,$23,$00,$21,$00,$24,$00,$28,$00,$25,$00,$21,$00,$1C,$00
    db $21,$00,$00,$00
    db $FF
DmTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$70,$F1,$22,$09,$10,$09,$10,$09,$10,$09,$10,$0C,$13,$0C,$13
    db $0C,$13,$0C,$13,$0E,$15,$0E,$15,$0E,$15,$0E,$15,$10,$17,$10,$17
    db $10,$17,$10,$14,$09,$10,$09,$10,$05,$0C,$05,$0C,$07,$0E,$07,$0E
    db $04,$0B,$04,$0B,$09,$10,$09,$10,$09,$10,$09,$10,$09,$10,$0D,$10
    db $09,$00,$00,$00
    db $FF

; OrCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
OrCell:
    ld hl,(AMY_UVAR_Bx)
    ld de,22
    ld b,0
OrCellDiv:
    or a
    sbc hl,de
    jr c,OrCellRem
    inc b
    jr OrCellDiv
OrCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; DmGrab: the universe (rows 1-22, columns 5-26 of the name table) into Ub
DmGrab:
    ld hl,(VDP_NAME_SHADOW)
    ld de,37
    add hl,de
    ld de,AMY_UVAR_Ub
    ld b,22
DmGrabRow:
    push bc
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld b,22
DmGrabCell:
    in a,($BE)
    ld (de),a
    inc de
    djnz DmGrabCell
    ld bc,32
    add hl,bc
    pop bc
    djnz DmGrabRow
    ret

; DmShow: the universe lifted by Lift rows (row r shows Ub row r - Lift;
; blank below the bottom), for its slide into view (line 16)
DmShow:
    ld hl,(VDP_NAME_SHADOW)
    ld de,37
    add hl,de
    ld c,0
DmShowRow:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    push hl
    ld a,(AMY_UVAR_Lift)
    ld b,a
    ld a,c
    add a,b
    cp 22
    jr nc,DmShowBlank
    ; Ub + (c + Lift) * 22
    ld l,a
    ld h,0
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,de
    add hl,hl
    add hl,de
    ld de,AMY_UVAR_Ub
    add hl,de
    ld b,22
DmShowCell:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz DmShowCell
    jr DmShowNext
DmShowBlank:
    ld b,22
    ld a,32
DmShowSp:
    out ($BE),a
    nop
    nop
    djnz DmShowSp
DmShowNext:
    pop hl
    ld de,32
    add hl,de
    inc c
    ld a,c
    cp 22
    jr nz,DmShowRow
    ret

; OrPeek: Pk = the tile at B
OrPeek:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; OrPoke: the tile Tl at B
OrPoke:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret
}
