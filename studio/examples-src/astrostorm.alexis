    db $40,$2A,$22,$22,$50
AsAlarmA:
    db $80,$7F,$33,$28,$90
AsAlarmB:
    db $80,$8D,$33,$28,$90
AsQuiet:
    db $80,$7F,$F3,$01,$90

AsSoundTable:
    dw AsCrash,$702B
    dw AsFade,$702B
    dw AsLaunch,$7035
    dw AsAlarmA,$703F
    dw AsAlarmB,$703F
    dw AsQuiet,$703F
    dw AsTuneMel,$703F
    dw AsTuneBass,$7049
; Benard Run, E minor (original for this game)
; Tiny Sound, 8 frames per step
AsTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$23,$01,$01,$1E,$23,$01,$26,$01,$25,$01,$23,$01
    db $21,$01,$1E,$01,$1F,$01,$01,$1A,$1F,$01,$23,$01,$21,$01,$1F,$01
    db $1E,$01,$01,$01,$23,$01,$01,$1E,$23,$01,$26,$01,$28,$01,$26,$01
    db $25,$01,$21,$01,$23,$01,$21,$01,$1E,$01,$1A,$01,$17,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
AsTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$09,$15,$09,$15
    db $09,$15,$09,$15,$07,$13,$07,$13,$07,$13,$07,$13,$06,$12,$06,$12
    db $06,$12,$06,$12,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$09,$15,$09,$15
    db $09,$15,$09,$15,$07,$13,$06,$12,$07,$13,$06,$12,$0B,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
AsSong:
    dw $0001
    db $40+7,8
    dw $0000

; AsCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
AsCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
AsCellDiv:
    or a
    sbc hl,de
    jr c,AsCellRem
    inc b
    jr AsCellDiv
AsCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; AsPeek: Pk = the tile at B
AsPeek:
    call AsCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; AsPoke: the tile Tl at B
AsPoke:
    call AsCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret

; AsScroll: the VIC's screen (rows 1-23, columns 5-26) up a row, a row of
; spaces at the bottom
AsScroll:
    ld hl,(VDP_NAME_SHADOW)
    ld de,32+5
    add hl,de
    ld b,22
AsScRow:
    push bc
    push hl
    ld de,32
    add hl,de
    ; read the row below into Buf
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld de,AMY_UVAR_Buf
    ld b,22
AsScRd:
    in a,($BE)
    ld (de),a
    inc de
    nop
    nop
    djnz AsScRd
    pop hl
    ; write it here
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld de,AMY_UVAR_Buf
    ld b,22
AsScWr:
    ld a,(de)
    out ($BE),a
    inc de
    nop
    nop
    djnz AsScWr
    ld de,32
    add hl,de
    pop bc
    djnz AsScRow
    ; the last row: spaces
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld b,22
    ld a,32
AsScSp:
    out ($BE),a
    nop
    nop
    nop
    djnz AsScSp
    ret

; AsDec: the 32-bit number NumB (little-endian) in decimal: Dg the digits
; (lowest first), Nd how many (at least one)
AsDec:
    xor a
    ld (AMY_UVAR_Nd),a
AsDecNext:
    ld hl,AMY_UVAR_NumB+3
    ld b,4
    xor a
AsDecByte:
    ld e,(hl)
    push bc
    ld b,8
AsDecBit:
    sla e
    rla
    cp 10
    jr c,AsDecLo
    sub 10
    inc e
AsDecLo:
    djnz AsDecBit
    pop bc
    ld (hl),e
    dec hl
    djnz AsDecByte
    ; A the remainder: the next digit
    ld c,a
    ld a,(AMY_UVAR_Nd)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Dg
    add hl,de
    ld (hl),c
    inc a
    ld (AMY_UVAR_Nd),a
    ld hl,(AMY_UVAR_NumB)
    ld a,h
    or l
    ld hl,(AMY_UVAR_NumB+2)
    or h
    or l
    jr nz,AsDecNext
    ret

; FontTiles: each font character of FontTab (third 0 of the pattern
; table) copied into its tile, in the three thirds
FontTiles:
    ld hl,FontTab
FtNext:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld e,a
    ld a,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld l,e
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ex de,hl
    pop hl
    ld b,8
FtByte:
    ld a,e
    out ($BF),a
    ld a,d
    out ($BF),a
    nop
    nop
    nop
    in a,($BE)
    ld c,a
    push hl
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    pop hl
    inc hl
    inc de
    djnz FtByte
    pop hl
    jr FtNext
FtPut:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    nop
    nop
    ld a,c
    out ($BE),a
    ret
FontTab:
    db 44,141,33,142,40,144,41,145,45,146,46,147,48,148,49,149,50,150,51,151,52,152,53,153,54,154,55,155,56,156,57,157,58,158,63,159,65,160,66,161,67,162,68,163,69,164,70,165,71,166,72,167,73,168,74,169,75,170,76,171,77,172,78,173,79,174,80,175,81,176,82,177,83,178,84,179,85,180,86,181,87,182,88,183,89,184,90,185,44,188,33,189,40,191,41,192,45,193,46,194,48,195,49,196,50,197,51,198,52,199,53,200,54,201,55,202,56,203,57,204,58,205,63,206,65,207,66,208,67,209,68,210,69,211,70,212,71,213,72,214,73,215,74,216,75,217,76,218,77,219,78,220,79,221,80,222,81,223,82,224,83,225,84,226,85,227,86,228,87,229,88,230,89,231,90,232,0
}
