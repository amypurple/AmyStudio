    db $40,$2B,$23,$1C,$40,$2B,$F3,$07,$40,$85,$20,$0E,$40,$85,$F0,$01,$40,$2A,$22,$08,$40,$2A,$F2,$01
    db $40,$2B,$23,$22,$40,$2B,$F3,$07,$40,$2A,$22,$0E,$40,$2A,$F2,$01,$40,$2B,$23,$08,$40,$2B,$F3,$01
    db $40,$C4,$23,$22,$40,$C4,$F3,$01,$40,$2B,$23,$1C,$40,$2B,$F3,$01,$40,$2A,$22,$15,$40,$2A,$F2,$01
