  $3C,$7E,$FF,$FF,$FF,$FF,$7E,$3C,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $3C,$7E,$E7,$C3,$C3,$E7,$7E,$3C,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$02,$05,$0B,$17,$0F,$0F,$17,$0B,$05,$02,$00,$00,$00
  $00,$00,$00,$40,$A0,$D0,$E8,$F0,$F0,$E8,$D0,$A0,$40,$00,$00,$00
  $81,$41,$20,$00,$09,$00,$A1,$01,$A1,$00,$09,$00,$20,$41,$81,$00
