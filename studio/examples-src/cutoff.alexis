' the title: 7 rows of 28 columns (columns 2-29)
data TitleMap bytes
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $A5,$A5,$80,$A5,$80,$A5,$80,$A5,$A5,$A5,$80,$80,$80,$80,$80,$A6,$A6,$A6,$80,$A6,$A6,$A6,$80,$A6,$A6,$A6,$80,$A6
  $80,$80,$80,$A5,$80,$A5,$80,$80,$A5,$80,$80,$80,$80,$80,$80,$A6,$80,$A6,$80,$A6,$80,$80,$80,$A6,$80,$80,$80,$A6
  $80,$80,$80,$A5,$80,$A5,$80,$80,$A5,$80,$80,$A5,$A5,$80,$80,$A6,$80,$A6,$80,$A6,$A6,$80,$80,$A6,$A6,$80,$80,$A6
  $80,$80,$80,$A5,$80,$A5,$80,$80,$A5,$80,$80,$80,$80,$80,$80,$A6,$80,$A6,$80,$A6,$80,$80,$80,$A6,$80,$80,$80,$A5
  $A5,$A5,$80,$A5,$A5,$A5,$80,$80,$A5,$80,$80,$80,$80,$80,$80,$A6,$A6,$A6,$80,$A6,$80,$80,$80,$A6,$80,$80,$80,$A6
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
