    dw CoStepR,$7049
    dw CoCrash,$703F
    dw CoGo,$7049
    dw CoOver,$7049
    dw CoPause,$7049
; Grid Runners (original)
; Tiny Sound, 8 frames per step
CoTuneMel:
    db $44
