record Cycle:
  u8 X
  u8 Y
  u8 Ox
  u8 Oy
  u8 Dir
  u8 Want
  u8 In
  u8 Lives
  u16 Score
end record

Cycle Cy[2]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Time = 0
u8 Players = 1
u8 Skill = 5
u8 Spd = 7
u8 Half = 3
u8 El = 0
u8 Mode = 0
u8 Over = 0
u8 Paused = 0
u8 Crasher = 0
u8 HeadOn = 0
u8 CrashX = 0
u8 CrashY = 0
u8 Cf = 0
u8 Rounds = 0
u8 Steps = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Rep = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table CoSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame

round_start:
  NewRound

play_loop:
  Frame1
  ReadPads
  PlayFrame
  DrawSprites
  if Mode = 3 then goto round_start
  if Mode <> 2 or Over = 0 then goto play_loop

  ' game over: the scores and who won
  print at 8,9, "              "
  print at 8,10, "  GAME  OVER  "
  print at 8,11, "              "
  if Cy[0].Score > Cy[1].Score then
    print at 8,12, "  BLUE  WINS  "
  else
    if Cy[1].Score > Cy[0].Score then
      if Players = 1 then
        print at 8,12, "COMPUTER  WINS"
      else
        print at 8,12, "  RED  WINS   "
      end if
    else
      print at 8,12, "    A DRAW    "
    end if
  end if
  print at 8,13, "              "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayFrame:
  select case Mode
    case 0
      if Press = 1 then
        Paused = Paused ^ 1
        play sound SndPause
        if Paused = 1 then
          print at 13,2, "PAUSE"
        else
          print at 13,2, "     "
        end if
      end if
      if Paused = 0 then
        inc El
        if El = Half then DrawStubs
        if El >= Spd then
          El = 0
          OneStep
        end if
      end if
    case 1
      ' the crash burst, then the lives or the end
      inc Cf
      if Cf = 90 then
        if Over = 1 then
          Mode = 2
        else
          RoundOver
        end if
      end if
    case 2
      ' waiting for a button after a round
      if Press = 1 then Mode = 3
  end select
  return
end sub

' a head halfway into its new cell: the trail reaches the cell's middle
sub DrawStubs:
  u8 B = 0
  for Di = 0 to 1
    B = Cy[Di].In
    if B <> NoDir then
      B = (B + 2) & 3
      C = TrailBase[Di] + DBit[B]
      put char C at Cy[Di].X, Cy[Di].Y
    end if
  next
  return
end sub

' one step of the C64's main loop: the counter, blue, then red
sub OneStep:
  inc Time
  inc Steps
  Pi = 0
  while Pi < 2
    if MoveHead(Pi) = 1 then Pi = 2
    inc Pi
  end while
  if Mode = 0 then
    if (Time & 1) = 0 then
      play sound SndStepB
    else
      play sound SndStepR
    end if
  end if
  return
end sub

' moves player P one cell; 1 when it crashed (the round is over)
function MoveHead(u8 P) as u8
  u8 Nx = 0
  u8 Ny = 0
  u8 D = 0
  u8 Ix = 0
  u8 M = 0
  u8 Got = 0
  u8 Res = 0
  if P = 1 and Players = 1 then
    D = AiDir()
  else
    D = Cy[P].Want
  end if
  Cy[P].Dir = D
  Nx = Cy[P].X + DX[D]
  Ny = Cy[P].Y + DY[D]
  Got = get char at Nx, Ny
  if Got <> TFloor then
    Crash(P, Nx, Ny)
    Res = 1
  else
    ' the cell left behind gets its full piece: where it came in, where
    ' it goes out
    M = DBit[D]
    Ix = Cy[P].In
    if Ix <> NoDir then
      Ix = (Ix + 2) & 3
      M = M | DBit[Ix]
    end if
    C = TrailBase[P] + M
    put char C at Cy[P].X, Cy[P].Y
    put char TRes at Nx, Ny
    Cy[P].Ox = Cy[P].X
    Cy[P].Oy = Cy[P].Y
    Cy[P].X = Nx
    Cy[P].Y = Ny
    Cy[P].In = D
  end if
  return Res

' a crash of player P into cell Nx, Ny: the other one scores the step
' count, the crasher loses a life; a head-on costs both
sub Crash(u8 P, u8 Nx, u8 Ny):
  u8 O = 0
  u8 Od = 0
  O = P ^ 1
  Od = Cy[O].Dir
  Od = (Od + 2) & 3
  HeadOn = 0
  if Nx = Cy[O].X and Ny = Cy[O].Y then
    if Cy[P].Dir = Od then HeadOn = 1
  end if
  if HeadOn = 1 then
    Cy[0].Score = Cy[0].Score + Time
    Cy[1].Score = Cy[1].Score + Time
    dec Cy[0].Lives
    dec Cy[1].Lives
  else
    Cy[O].Score = Cy[O].Score + Time
    dec Cy[P].Lives
  end if
  Crasher = P
  CrashX = Nx
  CrashY = Ny
  Cy[P].Ox = Nx
  Cy[P].Oy = Ny
  Cy[P].X = Nx
  Cy[P].Y = Ny
  El = 0
  Cf = 0
  Mode = 1
  inc Rounds
  if Cy[0].Lives = 0 or Cy[1].Lives = 0 then Over = 1
  play sound SndCrash
  ShowScores
  ShowLives
  return
end sub

' the computer (red): straight on while there is room, a turn now and
' then at random, and towards the longer free line when blocked
function AiDir() as u8
  u8 D = 0
  u8 A = 0
  u8 Lt = 0
  u8 Rt = 0
  u8 Lv = 0
  u8 Rv = 0
  u8 S = 0
  u8 Sv = 0
  u8 R = 0
  Rand
  R = lowbyte Rs
  D = Cy[1].Dir
  A = Ray(D)
  Lt = (D + 3) & 3
  Rt = (D + 1) & 3
  Lv = Ray(Lt)
  Rv = Ray(Rt)
  if Lv > Rv then
    S = Lt
    Sv = Lv
  else
    S = Rt
    Sv = Rv
    if Lv = Rv then
      if (R & 16) = 0 then S = Lt
    end if
  end if
  if A >= 3 then
    if (R & 15) = 0 and Sv >= 3 then D = S
  else
    if Sv > A then D = S
  end if
  return D

' free cells in a line from the red head in direction D (at most 9)
function Ray(u8 D) as u8
  u8 N = 0
  u8 Rx = 0
  u8 Ry = 0
  u8 Go = 1
  Rx = Cy[1].X
  Ry = Cy[1].Y
  while Go = 1
    Rx = Rx + DX[D]
    Ry = Ry + DY[D]
    C = get char at Rx, Ry
    if C = TFloor then
      inc N
      if N = 9 then Go = 0
    else
      Go = 0
    end if
  end while
  return N

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the heads, 2 the crash burst
sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Off = 0
  u8 D = 0
  u8 Pat = 0
  u8 Col = 0
  Off = El * 8
  Off = Off / Spd
  for Di = 0 to 1
    Sx = Cy[Di].Ox * 8
    Sy = Cy[Di].Oy * 8
    if Cy[Di].X <> Cy[Di].Ox or Cy[Di].Y <> Cy[Di].Oy then
      D = Cy[Di].Dir
      select case D
        case 0
          Sy = Sy - Off
        case 1
          Sx = Sx + Off
        case 2
          Sy = Sy + Off
        case 3
          Sx = Sx - Off
      end select
    end if
    Sy = Sy - 1
    if Mode = 2 then Sy = 192
    if Di = 0 then
      Pat = SBall
      Col = 7
    else
      Pat = SRing
      Col = 9
    end if
    set sprite Di to Sy,Sx,Pat,Col
  next
  if Mode = 0 then
    set sprite 2 to 192,0,0,0
  else
    if Cf < 60 then
      K = Cf / 10
      K = K & 1
      Pat = K * 4 + SBoom0
      Sx = CrashX * 8 - 4
      Sy = CrashY * 8 - 5
      set sprite 2 to Sy,Sx,Pat,11
    else
      set sprite 2 to 192,0,0,0
    end if
  end if
  update sprites
  return
end sub

sub ShowScores:
  NumU = Cy[0].Score
  print at 3,1, digits$(NumU, 5)
  NumU = Cy[1].Score
  print at 23,1, digits$(NumU, 5)
  return
end sub

sub ShowLives:
  NumU = Cy[0].Lives
  print at 2,2, "LIVES ", digits$(NumU, 2)
  NumU = Cy[1].Lives
  print at 20,2, "LIVES ", digits$(NumU, 2)
  return
end sub

' after a crash: the lives, and a press to go on
sub RoundOver:
  ShowLives
  print at 8,9, "              "
  print at 8,10, " PRESS BUTTON "
  print at 8,11, " TO  CONTINUE "
  print at 8,12, "              "
  Mode = 2
  return
end sub

' a fresh arena: walls, floor, the two heads facing each other
sub NewRound:
  u8 Row = 0
  NewScreen
  fill TWall count 28 at 2,3
  fill TWall count 28 at 2,22
  for Row = FieldT to FieldB
    put char TWall at 2,Row
    fill TFloor count 26 at FieldL,Row
    put char TWall at 29,Row
  next
  put char TBall at 2,1
  put char TRing at 29,1
  print at 12,1, "CUT-OFF!"
  ShowScores
  ShowLives
  Cy[0].X = 8
  Cy[0].Y = StartRow
  Cy[0].Dir = 1
  Cy[0].Want = 1
  Cy[1].X = 23
  Cy[1].Y = StartRow
  Cy[1].Dir = 3
  Cy[1].Want = 3
  for Di = 0 to 1
    Cy[Di].Ox = Cy[Di].X
    Cy[Di].Oy = Cy[Di].Y
    Cy[Di].In = NoDir
    put char TrailBase[Di] at Cy[Di].X, Cy[Di].Y
  next
  Time = 0
  El = 0
  Cf = 0
  Mode = 0
  Paused = 0
  DrawSprites
  ShowScreen
  play sound SndGo
  Rearm
  wait 30 frames
  wait no fire
  nmi off
  WasBtn = 0
  return
end sub

sub NewGame:
  Cy[0].Score = 0
  Cy[1].Score = 0
  Cy[0].Lives = 10
  Cy[1].Lives = 10
  Spd = StepFr[Skill]
  Half = Spd / 2
  Over = 0
  Rounds = 0
  Steps = 0
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' one stick: 1 up, 2 right, 4 down, 8 left, 16 a button
function Stick(u8 N) as u8
  u8 S = 0
  if joypad(N).up then S = S | 1
  if joypad(N).right then S = S | 2
  if joypad(N).down then S = S | 4
  if joypad(N).left then S = S | 8
  if joypad(N).fire then S = S | 16
  return S

' a stick held in exactly one direction sets that player's next turn
sub TakeDir(u8 P, u8 S):
  u8 Dd = NoDir
  S = S & 15
  select case S
    case 1
      Dd = 0
    case 2
      Dd = 1
    case 4
      Dd = 2
    case 8
      Dd = 3
  end select
  if Dd <> NoDir then Cy[P].Want = Dd
  return
end sub

sub ReadPads:
  J1 = Stick(1)
  J2 = Stick(2)
  TakeDir(0, J1)
  if Players = 2 then TakeDir(1, J2)
  Btn = (J1 | J2) & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub ShowMenu:
  if Players = 1 then
    print at 4,13, "PLAYERS  < 1 >  VS CPU "
  else
    print at 4,13, "PLAYERS  < 2 >         "
  end if
  NumU = Skill
  print at 4,15, "SKILL LEVEL   ", digits$(NumU, 1)
  return
end sub

' the title: CUT-OFF! in blue and red blocks, the menu, the tune once
sub TitlePage:
  u8 Last = 0
  NewScreen
  for Di = 0 to 6
    W16 = Di * 28
    copy TitleMap + W16 count 28 to vram.name + (Di + 2) * 32 + 2
  next
  print at 2,10, "COMPUTE!'S GAZETTE MAR 1984"
  ShowMenu
  print at 4,18, "STICK: PLAYERS AND SKILL"
  print at 4,19, "BUTTON: START OR PAUSE"
  print at 4,21, "BLUE: CONTROLLER 1"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Rep = 0
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPads
  J = J1 & 15
  if J <> Last then
    Rep = 0
  else
    inc Rep
    if Rep = 15 then Rep = 0
  end if
  Last = J
  if J > 0 and Rep = 0 then
    select case J
      case 1
        if Skill < 9 then inc Skill
      case 4
        if Skill > 0 then dec Skill
      case 2
        Players = 2
      case 8
        Players = 1
    end select
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "CUT-OFF!"
  print at 2,5, "BASED ON CUT-OFF!,"
  print at 2,6, "COMPUTE!'S GAZETTE MARCH"
  print at 2,7, "1984 (C64 AND VIC-20"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: GRID RUNNERS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

