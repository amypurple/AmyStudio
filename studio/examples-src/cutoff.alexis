    db 8
    db $02,$60,$F1,$22,$23,$01,$1E,$23,$26,$01,$25,$23,$21,$01,$1C,$21
    db $25,$01,$23,$21,$1F,$01,$1A,$1F,$23,$01,$21,$1F,$1E,$01,$21,$01
    db $25,$01,$2A,$01,$23,$26,$2A,$26,$23,$26,$2A,$26,$21,$25,$28,$25
    db $21,$25,$28,$01,$1F,$23,$26,$23,$1E,$22,$25,$28,$26,$01,$25,$01
    db $23,$01,$00,$01
    db $FF
CoTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$0B,$01,$0B,$01,$0B,$01,$12,$01,$09,$01,$09,$01
    db $09,$01,$10,$01,$07,$01,$07,$01,$07,$01,$0E,$01,$12,$01,$12,$01
    db $0A,$01,$12,$01,$0B,$01,$12,$01,$0B,$01,$12,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$07,$01,$0E,$01,$12,$01,$0D,$01,$0B,$01,$12,$01
    db $0B,$01,$00,$01
