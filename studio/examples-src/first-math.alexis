' CALL SOUND translations (period = 111861 / Hz, attenuation = TI volume / 2)
asm {
FanfareLow:    ; SOUND(500..800,262/247,2) voice 1
    db $40,$AB,$11,$1E,$40,$AB,$11,$1E,$40,$AB,$11,$1E,$40,$C5,$11,$1E,$40,$AB,$11,$30,$50
FanfareMid:    ; voice 2
    db $80,$53,$11,$1E,$80,$41,$11,$1E,$80,$53,$11,$1E,$80,$41,$11,$1E,$80,$53,$11,$30,$90
FanfareHigh:   ; voice 3
    db $C0,$1D,$11,$1E,$C0,$FE,$10,$1E,$C0,$1D,$11,$1E,$C0,$1D,$11,$1E,$C0,$1D,$11,$30,$D0
Sweep1:        ; SOUND(2,110,6)
    db $40,$F9,$33,$03,$50
Sweep2:        ; SOUND(2,160,6)
    db $40,$BB,$32,$03,$50
Sweep3:        ; SOUND(2,210,6)
    db $40,$15,$32,$03,$50
Sweep4:        ; SOUND(2,260,6)
    db $40,$AE,$31,$03,$50
Sweep5:        ; SOUND(2,310,6)
    db $40,$69,$31,$03,$50
Sweep6:        ; SOUND(2,360,6)
    db $40,$37,$31,$03,$50
Sweep7:        ; SOUND(2,410,6)
    db $40,$11,$31,$03,$50
Sweep8:        ; SOUND(2,460,6)
    db $40,$F3,$30,$03,$50
Sweep9:        ; SOUND(2,510,6)
    db $40,$DB,$30,$03,$50
Sweep10:       ; SOUND(2,560,6)
    db $40,$C8,$30,$03,$50
Sweep11:       ; SOUND(2,610,6)
    db $40,$B7,$30,$03,$50
Sweep12:       ; SOUND(2,660,6)
    db $40,$A9,$30,$03,$50
Sweep13:       ; SOUND(2,710,6)
    db $40,$9E,$30,$03,$50
Sweep14:       ; SOUND(2,760,6)
    db $40,$93,$30,$03,$50
Sweep15:       ; SOUND(2,810,6)
    db $40,$8A,$30,$03,$50
Sweep16:       ; SOUND(2,860,6)
    db $40,$82,$30,$03,$50

MathSoundTable:
    dw FanfareLow,$702B         ; 1  tone 1 area
    dw FanfareMid,$7035         ; 2  tone 2 area
    dw FanfareHigh,$703F        ; 3  tone 3 area
    dw Sweep1,$702B             ; 4
    dw Sweep2,$702B             ; 5
    dw Sweep3,$702B             ; 6
    dw Sweep4,$702B             ; 7
    dw Sweep5,$702B             ; 8
    dw Sweep6,$702B             ; 9
    dw Sweep7,$702B             ; 10
    dw Sweep8,$702B             ; 11
    dw Sweep9,$702B             ; 12
    dw Sweep10,$702B            ; 13
    dw Sweep11,$702B            ; 14
    dw Sweep12,$702B            ; 15
    dw Sweep13,$702B            ; 16
    dw Sweep14,$702B            ; 17
    dw Sweep15,$702B            ; 18
    dw Sweep16,$702B            ; 19
}
