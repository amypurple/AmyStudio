cartridge "SOUTHERN STATES/PRESENTS C. REGENA'S/1983"

' SOUTHERN STATES by C. Regena
' Originally published in C. Regena's "Programming The TI" column,
' COMPUTE! magazine, Issue 39, August 1983, as "Program 3: Southern States"
' for the TI-99/4A. All design credit belongs to C. Regena.
'
' Historical context (summary of the original column):
' A map of the United States is drawn with redefined characters, then one of
' eleven southern states is outlined at random. The player types the name of
' the state and, if correct, its capital city. Names must be spelled
' correctly; a second mistake shows the right answer. Each state's DATA holds
' its own outline characters, their screen positions, and how to erase them,
' mostly with the plain yellow square so repetitions can be used. Readers
' could also order the program on cassette or diskette from the author.
'
' ColecoVision / Coleco ADAM adaptation in Amy by Amy Bienvenu, 2026.
' One source, two builds:
' - ADAM (OS7+EOS hybrid): answers are typed on the ADAM keyboard, as on the TI.
' - ColecoVision cartridge: answers are chosen on the keypad (1-4) from four
'   names, because the controller has no alphabetic keyboard.
' Adaptation liberties: dark blue ocean backdrop instead of TI cyan, white
' title text, answer text drawn on the yellow answer band, BACKSPACE on ADAM.
' TI rows/columns are 1-based; Amy X,Y are 0-based (X = col - 1, Y = row - 1).

const SeaTile = 32
const LandTile = 96
const OutlineBase = 128
const StateCount = 11

' Sound table slots
const SndPrompt = 1
const SndEnter = 2
const SndUhOh = 3
const SndArpeggio = 4

' Answer band layout (TI rows 21 and 23; columns 11 and 13 for the fields)
if defined AMY_HAS_EOS
const StateY = 20
const CapitalY = 22
else defined
const StateY = 19
const CapitalY = 20
end defined
const StateField = 10
const CapitalField = 12

u8 Found[11]            ' 1 when the state and capital were both identified
u8 Solved = 0
u8 R = 0                ' current state index (TI R)
u8 Tries = 0            ' TI T
bool AnswerOk = false
bool AskCapital = false

' DATA walking (TI READ)
u16 P = 0
u16 EraseP = 0
u16 Bytes16 = 0
u8 N = 0
u8 I = 0
u8 X = 0
u8 Y = 0
u8 G = 0
u8 J = 0

' Text output
u16 TextP = 0
u8 TextLen = 0
u8 TextX = 0
u8 TextY = 0
u8 Ch = 0
u8 K = 0

' Typed answer (ADAM) or chosen answer (ColecoVision)
u8 Typed[16]
u8 TypedLen = 0
u8 KeyStatus = 0
u8 Slot[4]
u8 RightSlot = 0
u8 Pick = 0
u8 S = 0
u8 Choice = 0
u16 AnswerP = 0
u8 FieldX = 0

  text screen
  nmi off
  set sound table SouthSoundTable areas 1
  copy MapPatterns count 224 to vram.pattern + 768
  backdrop dark blue
  screen on

  ' --- Lines 180-210: title ---
  TitleColors
  cls
  print at 4,2, "***********************"
  print at 4,3, "*                     *"
  print at 4,4, "* IDENTIFY THE STATES *"
  print at 4,5, "*                     *"
  print at 4,6, "***********************"
  print at 8,10, "SOUTHERN STATES"
  print centered at 13, "BY C. REGENA"
  print centered at 14, "COMPUTE! ISSUE 39, AUGUST 1983"
  print centered at 17, "ADAPTATION"
  print centered at 18, "AMY BIENVENU, 2026"
  wait 180 frames

new_game:
  ' --- Lines 400-460: instructions ---
  TitleColors
  cls
  print at 2,1, "ONE OF THE UNITED STATES"
  print at 2,3, "WILL BE OUTLINED."
if defined AMY_HAS_EOS
  print at 2,6, "TYPE THE NAME OF THE STATE"
  print at 2,8, "THEN PRESS <RETURN>."
  print at 2,11, "IF THE STATE IS CORRECT,"
  print at 2,13, "TYPE THE CAPITAL CITY"
  print at 2,15, "THEN PRESS <RETURN>."
  print at 2,18, "NAMES MUST BE SPELLED"
  print at 2,20, "CORRECTLY TO BE ACCEPTED."
  print at 14,22, "PRESS <RETURN>"
  WaitReturn
else defined
  print at 2,6, "PICK THE NAME OF THE STATE"
  print at 2,8, "WITH KEYPAD KEYS 1 TO 4."
  print at 2,11, "IF THE STATE IS CORRECT,"
  print at 2,13, "PICK THE CAPITAL CITY."
  print at 2,16, "TWO TRIES PER QUESTION."
  print at 18,22, "PRESS FIRE"
  pause until press
  wait no fire
end defined

  ' --- Lines 470-510: the map ---
  cls
  MapColors
  put MapTiles frame size 28,17 at 2,1
  fill array Found with 0
  Solved = 0

next_state:
  ' --- Lines 530-570: random state not yet identified ---
  Tries = 0
pick_state:
  R = random(0, 10)
  if Found[R] = 1 then goto pick_state

  ' --- Lines 580-680: answer band, outline characters, outline ---
  fill LandTile count 160 at 0,19
  P = StateData[R]
  N = peek(P)
  P += 1
  Bytes16 = N
  Bytes16 <<= 3
  UploadPatterns
  P += Bytes16
  N = peek(P)
  P += 1
  for I = 1 to N
    X = peek(P)
    Y = peek(P + 1)
    G = peek(P + 2)
    put char G at X,Y
    P += 3
  next
  EraseP = P

  ' --- Lines 690-950: the state ---
  AskCapital = false
  AskAnswer
  if not AnswerOk then goto missed

  ' --- Lines 960-1240: the capital ---
  AskCapital = true
  Tries = 0
  AskAnswer
  if not AnswerOk then goto missed
  Found[R] = 1
  inc Solved
  goto erase_state

missed:
  ' Lines 920-940: the right answer stays on screen until the player continues
  ShowPressPrompt

erase_state:
  ' --- Lines 1250-1290 ---
  P = EraseP
  N = peek(P)
  P += 1
  for I = 1 to N
    X = peek(P)
    Y = peek(P + 1)
    G = peek(P + 2)
    J = peek(P + 3)
    fill G count J at X,Y
    P += 4
  next
  if Solved < StateCount then goto next_state

  ' --- Lines 1310-1370: try again ---
  fill LandTile count 96 at 0,20
  TextP = Messages[3]
  TextX = 2
  TextY = 21
  PutText
if defined AMY_HAS_EOS
again_key:
  K = await key status KeyStatus
  if K >= 97 then K -= 32
  if K = 89 then goto new_game
  if K <> 78 then goto again_key
else defined
  choose keypad 1 to 2 into Choice
  if Choice = 1 then goto new_game
end defined
  TitleColors
  cls
  print centered at 11, "SOUTHERN STATES"
  print centered at 13, "THANKS FOR PLAYING"
  loop forever

' Asks for the state (AskCapital false) or its capital (true), two tries.
sub AskAnswer:
  if AskCapital then
    AnswerP = CapNames[R]
    TextY = CapitalY
    FieldX = CapitalField
    TextP = Messages[1]
  else
    AnswerP = StNames[R]
    TextY = StateY
    FieldX = StateField
    TextP = Messages[0]
  end if
  TextX = 2
  PutText
  ClearField
if defined AMY_HAS_EOS
  ' Lines 720-910: typed answer
try_again:
  TypedAnswer
else defined
  ' Keypad adaptation: four names, one is right
  BuildChoices
try_again:
  ChosenAnswer
end defined
  play sound SndEnter
  wait 6 frames
  if AnswerOk then
if not defined AMY_HAS_EOS
    ClearChoices
    ShowRightAnswer
end defined
    play sound SndArpeggio
    wait 30 frames
    return
  end if
  play sound SndUhOh
  wait 12 frames
  inc Tries
  if Tries < 2 then goto try_again
if not defined AMY_HAS_EOS
  ClearChoices
end defined
  ShowRightAnswer
  return
end sub


if defined AMY_HAS_EOS
' --- ADAM keyboard entry (TI lines 720-810 and 1000-1090) ---
sub TypedAnswer:
  ClearField
  play sound SndPrompt
  TypedLen = 0
type_key:
  K = await key status KeyStatus
  if KeyStatus <> 0 then goto type_key
  if K = 13 then goto type_done
  if K = 8 then
    if TypedLen > 0 then
      dec TypedLen
      X = FieldX + TypedLen
      put char LandTile at X,TextY
    end if
    goto type_key
  end if
  if K >= 97 then
    if K <= 122 then K -= 32
  end if
  if K < 32 then goto type_key
  if K > 95 then goto type_key
  if TypedLen = 15 then goto type_key
  Typed[TypedLen] = K
  X = FieldX + TypedLen
  Ch = K
  if Ch = SeaTile then Ch = LandTile
  put char Ch at X,TextY
  inc TypedLen
  goto type_key
type_done:
  ' Lines 830 and 1110: exact spelling
  AnswerOk = false
  TextLen = peek(AnswerP)
  if TextLen <> TypedLen then return
  for I = 1 to TextLen
    Ch = peek(AnswerP + I)
    J = I - 1
    if Typed[J] <> Ch then return
  next
  AnswerOk = true
  return
end sub
else defined
' --- ColecoVision keypad adaptation ---
' Slot[0..3] hold four different state indexes; one of them is R.
sub BuildChoices:
  RightSlot = random(0, 3)
  for S = 0 to 3
    if S = RightSlot then
      Slot[S] = R
    else
pick_other:
      Pick = random(0, 10)
      if Pick = R then goto pick_other
      for J = 0 to 3
        if J <> S then
          if J < S then
            if Slot[J] = Pick then goto pick_other
          end if
        end if
      next
      Slot[S] = Pick
    end if
  next
  ' Each slot is checked against all earlier ones, so no duplicates
  DrawChoices
  return
end sub

sub DrawChoices:
  for S = 0 to 3
    Pick = Slot[S]
    if AskCapital then
      TextP = CapNames[Pick]
    else
      TextP = StNames[Pick]
    end if
    TextX = 1
    if S = 1 then TextX = 17
    if S = 3 then TextX = 17
    TextY = 23
    if S < 2 then TextY = 22
    Ch = S + 49
    put char Ch at TextX,TextY
    inc TextX
    PutText
  next
  return
end sub

sub ClearChoices:
  fill LandTile count 64 at 0,22
  return
end sub

sub ChosenAnswer:
  play sound SndPrompt
  choose keypad 1 to 4 into Choice
  dec Choice
  AnswerOk = false
  if Choice = RightSlot then
    AnswerOk = true
    return
  end if
  ' Grey out the wrong choice so the second try is a real choice
  TextX = 1
  if Choice = 1 then TextX = 17
  if Choice = 3 then TextX = 17
  TextY = 23
  if Choice < 2 then TextY = 22
  fill LandTile count 15 at TextX,TextY
  return
end sub
end defined

' Lines 880-910 and 1160-1190: show the correct spelling
sub ShowRightAnswer:
  ClearField
  TextP = AnswerP
  TextX = FieldX
  PutText
  return
end sub

' Clears the answer field after the prompt (TI HCHAR(...,96,15))
sub ClearField:
  fill LandTile count 15 at FieldX,TextY
  return
end sub

' Lines 1380-1440: PRESS ENTER at the bottom right
sub ShowPressPrompt:
if defined AMY_HAS_EOS
  TextP = Messages[2]
  TextX = 20
  TextY = 23
  PutText
  WaitReturn
else defined
  TextP = Messages[2]
  TextX = 21
  TextY = 23
  PutText
  pause until press
  wait no fire
end defined
  fill LandTile count 11 at 20,23
  return
end sub

if defined AMY_HAS_EOS
sub WaitReturn:
wait_return:
  K = await key status KeyStatus
  if K <> 13 then goto wait_return
  return
end sub
end defined

' Writes a length-prefixed string at TextX,TextY; spaces become land tiles
sub PutText:
  TextLen = peek(TextP)
  for I = 1 to TextLen
    Ch = peek(TextP + I)
    if Ch = SeaTile then Ch = LandTile
    put char Ch at TextX,TextY
    inc TextX
  next
  return
end sub

' WRITE_VRAM: HL = source, DE = VRAM destination, BC = byte count
sub UploadPatterns:
  asm {
    ld hl,(AMY_UVAR_P)
    ld de,VRAM_PATTERN + 1024
    ld bc,(AMY_UVAR_Bytes16)
    call WRITE_VRAM
  }
  return
end sub

' Title and instruction screens: white text on the blue backdrop
sub TitleColors:
  set text colors white count 12
  return
end sub

' Map screen: land and outline colors (TI lines 120-170), answer text
' black on the yellow band
sub MapColors:
  set text colors white at 4 count 1
  set text colors black on light yellow at 5 count 7
  set text colors light yellow at 12 count 4
  set text colors transparent on light yellow at 16 count 2
  return
end sub

data MsgState bytes 7,83,84,65,84,69,32,63
data MsgCapital bytes 9,67,65,80,73,84,65,76,32,63
if defined AMY_HAS_EOS
data MsgPress bytes 12,80,82,69,83,83,32,82,69,84,85,82,78
data MsgAgain bytes 16,84,82,89,32,65,71,65,73,78,63,32,40,89,47,78,41
else defined
data MsgPress bytes 10,80,82,69,83,83,32,70,73,82,69
data MsgAgain bytes 21,84,82,89,32,65,71,65,73,78,63,32,49,61,89,69,83,32,50,61,78,79
end defined

data Messages words
  @MsgState, @MsgCapital, @MsgPress, @MsgAgain
end data

