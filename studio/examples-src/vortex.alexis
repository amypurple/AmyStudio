const NPal = 8

' a guardian: position in 1/256 pixels, velocity, heading, speed (0-7),
' turn clock, alive, and its pixel position for the collision tests
record Foe:
  u16 X
  u16 Y
  i16 Vx
  i16 Vy
  u8 H
  u8 K
  u8 T
  u8 Act
  u8 Px
  u8 Py
end record

Foe Foes[NFoe]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u8 Bonus = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the ship (1/256 pixels; Shx, Shy in pixels)
u16 Sx = 0
u16 Sy = 0
i16 SVx = 0
i16 SVy = 0
u8 Shx = 0
u8 Shy = 0
u8 Hd = 0
u8 TurnT = 0
u8 Moving = 0
u8 Brake = 0
' the shot
u16 Bx = 0
u16 By = 0
i16 BVx = 0
i16 BVy = 0
u8 BOn = 0
' the core: 0 empty, 1 block, 2 the eye
u8 Grid[49]
u8 Blocks = 0
' game state
u8 Lv = 1
u8 Expert = 0
u8 Lives = 3
u8 Dead = 0
u8 Won = 0
u8 Over = 0
u8 EyeT = 0
u8 EyeF = 0
u8 Spin = 0
u8 Kills = 0
u8 Broken = 0
u8 Shots = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Ri = 0
u8 Ci = 0
' scratch
i16 Q = 0
i16 Q2 = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table VxSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  HideSprites
  print at 9,16, "             "
  print at 9,17, "  GAME OVER  "
  print at 9,18, "             "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  inc Spin
  if Dead > 0 then
    DeadStep
    return
  end if
  if Won > 0 then
    WonStep
    return
  end if
  MoveShip
  MoveShot
  MoveFoes
  ShipHits
  FlashEye
  return
end sub

' the ship: the stick turns it (a heading every 2 frames), a press fires,
' a held button brakes; it flies the way it faces and wraps round
sub MoveShip:
  K = J1 & 12
  if K > 0 then
    Moving = 1
    inc TurnT
    if TurnT >= 2 then
      TurnT = 0
      if K = 4 then Hd = (Hd - 1) & 31
      if K = 8 then Hd = (Hd + 1) & 31
      ShipVel
    end if
  else
    TurnT = 1
  end if
  Brake = 0
  if Btn > 0 then
    Moving = 1
    Brake = 1
  end if
  if Press = 1 then
    if BOn = 0 then Shoot
  end if
  if Brake = 0 then
    if Moving = 1 then
      Sx = Sx + SVx
      Sy = Sy + SVy
      if Sx < 6144 then Sx = Sx + 53248
      if Sx >= 59392 then Sx = Sx - 53248
      if Sy < 7168 then Sy = Sy + 38912
      if Sy >= 46080 then Sy = Sy - 38912
    end if
  end if
  Shx = Sx >> 8
  Shy = Sy >> 8
  return
end sub

' a velocity: the sine of heading H (x 64) x Kv, in 1/256 pixels a frame
function Vel(u8 H, i16 Kv) as i16
  Q = SinT[H]
  Q = Q - 128
  return Q * Kv

sub ShipVel:
  SVx = Vel(Hd, 5)
  V = (Hd + 24) & 31
  SVy = Vel(V, 5)
  return
end sub

sub Shoot:
  BOn = 1
  Bx = Sx
  By = Sy
  BVx = Vel(Hd, 20)
  V = (Hd + 24) & 31
  BVy = Vel(V, 20)
  inc Shots
  play sound SndZap
  return
end sub

' the shot flies 5 pixels a frame; it stops at the screen's edge, on a
' block (which breaks: always on NOVICE, one time in four on EXPERT) or on
' a guardian
sub MoveShot:
  if BOn = 0 then return
  Bx = Bx + BVx
  By = By + BVy
  X = Bx >> 8
  Y = By >> 8
  if X < 16 then BOn = 0
  if X > 240 then BOn = 0
  if Y < 16 then BOn = 0
  if Y > 184 then BOn = 0
  if BOn = 0 then return
  C = CellAt(X, Y)
  if C < 49 then
    if Grid[C] > 0 then
      BOn = 0
      HitBlock(C)
      return
    end if
  end if
  for Fi = 0 to NFoe - 1
    with Foes[Fi] as E
      if E.Act = 1 then
        if AbsD(E.Px, X) < 6 then
          if AbsD(E.Py, Y) < 6 then
            BOn = 0
            E.Act = 0
            inc Kills
            AddScore(10)
            play sound SndPop
          end if
        end if
      end if
    end with
  next
  return
end sub

' the core cell (0-48) under pixel X, Y, or 255 outside the core
function CellAt(u8 Px, u8 Py) as u8
  if Px < 96 then return 255
  if Px > 151 then return 255
  if Py < 64 then return 255
  if Py > 119 then return 255
  Px = (Px - 96) >> 3
  Py = (Py - 64) >> 3
  return Py * 7 + Px

' the distance between two pixel positions
function AbsD(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

sub HitBlock(u8 Cell):
  if Expert = 1 then
    Rnd
    V = Rs & 3
    if V > 0 then
      play sound SndClank
      return
    end if
  end if
  V = Grid[Cell]
  Grid[Cell] = 0
  dec Blocks
  inc Broken
  X = Cell mod 7
  Y = Cell / 7
  put char 32 at X + CoreC,Y + CoreR
  AddScore(100)
  if V = 2 then
    Won = 120
    play sound SndCore
  else
    play sound SndCrunch
  end if
  return
end sub

sub AddK:
  if Score > ScoreCap then
    Score = ScoreMax
  else
    Score += 1000
  end if
  if Score > Hi then Hi = Score
  print at 8,1, Score
  return
end sub

sub AddScore(u8 P):
  if Score > ScoreCap then
    Score = ScoreMax
  else
    Score += P
  end if
  if Score > Hi then Hi = Score
  print at 8,1, Score
  return
end sub

' the guardians: born at the core, they turn every 10 frames (back one
' heading three times in four; from level 2 sometimes toward the ship)
' and are born again when they leave the screen
sub MoveFoes:
  for Fi = 0 to NFoe - 1
    with Foes[Fi] as E
      if E.Act = 0 then Spawn(Fi)
      inc E.T
      if E.T >= 10 then
        E.T = 0
        Turn(Fi)
      end if
      E.X = E.X + E.Vx
      E.Y = E.Y + E.Vy
      X = E.X >> 8
      Y = E.Y >> 8
      E.Px = X
      E.Py = Y
      if X < 16 then E.Act = 0
      if X > 240 then E.Act = 0
      if Y < 16 then E.Act = 0
      if Y > 184 then E.Act = 0
    end with
  next
  return
end sub

sub Spawn(u8 F):
  with Foes[F] as G
    G.Act = 1
    G.X = 31744
    G.Y = 23552
    G.T = 9
    Rnd
    G.H = Rs & 31
    G.K = PickSpeed()
    FoeVel(F)
  end with
  return
end sub

' a speed below the level: 0-3 (0-7 from level 7), the C64's retry loop
function PickSpeed() as u8
  C = 3
  if Lv >= 7 then C = 7
pk_again:
  Rnd
  V = (Rs >> 8) & C
  if V >= Lv then goto pk_again
  return V

sub FoeVel(u8 F):
  with Foes[F] as G
    Q2 = G.K + 1
    Q2 = Q2 + Q2
    G.Vx = Vel(G.H, Q2)
    V = (G.H + 24) & 31
    G.Vy = Vel(V, Q2)
  end with
  return
end sub

sub Turn(u8 F):
  Rnd
  V = (Rs >> 8) & 63
  C = Lv * 2
  K = 0
  if Lv >= 2 then
    if V < C then K = 1
  end if
  if K = 1 then
    Home(F)
    FoeVel(F)
  else
    V = Rs & 3
    if V > 0 then
      Foes[F].H = (Foes[F].H - 1) & 31
      FoeVel(F)
    end if
  end if
  return
end sub

' one heading toward the ship: the sign of the cross product of the
' guardian's heading and the line to the ship
sub Home(u8 F):
  with Foes[F] as G
    V = (G.H + 24) & 31
    Q = Shx
    Q = Q - G.Px
    Q2 = SinT[V]
    Q2 = Q2 - 128
    Q = Q * Q2
    Q2 = Shy
    Q2 = Q2 - G.Py
    W16 = SinT[G.H]
    Q2 = Q2 * (W16 - 128)
    if Q2 > Q then
      G.H = (G.H + 1) & 31
    else
      G.H = (G.H - 1) & 31
    end if
  end with
  return
end sub

' the ship is lost on a guardian or on the armour
sub ShipHits:
  X = Shx
  Y = Shy
  V = 0
  C = CellAt(X - 4, Y - 4)
  if C < 49 then V = V | Grid[C]
  C = CellAt(X + 4, Y - 4)
  if C < 49 then V = V | Grid[C]
  C = CellAt(X - 4, Y + 4)
  if C < 49 then V = V | Grid[C]
  C = CellAt(X + 4, Y + 4)
  if C < 49 then V = V | Grid[C]
  for Fi = 0 to NFoe - 1
    with Foes[Fi] as E
      if E.Act = 1 then
        if AbsD(E.Px, Shx) < 9 then
          if AbsD(E.Py, Shy) < 9 then V = 1
        end if
      end if
    end with
  next
  if V > 0 then
    Dead = 90
    BOn = 0
    play sound SndBoom
  end if
  return
end sub

' the blast, then a new ship and a new core, or the end
sub DeadStep:
  dec Dead
  if Dead > 0 then return
  dec Lives
  if Lives = 0 then
    fill 32 count 6 at 23,1
    Over = 1
    return
  end if
  NewLife
  return
end sub

' the eye is hit: the bonus, the next level
sub WonStep:
  dec Won
  if Won = 60 then
    ' 1000 x level (x 2 on EXPERT), added a thousand at a time (BCD +=
    ' takes no u16: bugs/rashgar-bcd-add-u16.alexis)
    Bonus = Lv
    if Expert = 1 then Bonus = Bonus + Bonus
    for Ci = 1 to Bonus
      AddK
    next
    play sound SndLevel
  end if
  if Won > 0 then return
  inc Lv
  if Lv > 18 then Lv = 1
  NewLife
  return
end sub

' the eye glows: its colours swap 16 frames each (under 2 Hz)
sub FlashEye:
  inc EyeT
  if EyeT < 16 then return
  EyeT = 0
  EyeF = EyeF ^ 1
  W16 = EyeF * 8
  copy EyeCols + W16 count 8 to vram.color + 1024 + (TEye - 128) * 8
  return
end sub

' a new life (or level): the core rebuilt in the level's colours, the
' guardians gone, the ship at the start
sub NewLife:
  BuildCore
  for Fi = 0 to NFoe - 1
    Foes[Fi].Act = 0
  next
  Sx = ShipX0 * 256
  Sy = ShipY0 * 256
  Shx = ShipX0
  Shy = ShipY0
  Hd = 8
  ShipVel
  Moving = 0
  BOn = 0
  TurnT = 1
  ShowStatus
  return
end sub

sub BuildCore:
  fill array Grid with 0
  Blocks = 0
  for Ri = 0 to 6
    BuildRow(Ri)
  next
  Grid[24] = 2
  put char TEye at CoreC + 3,CoreR + 3
  K = (Lv - 1) & 7
  W16 = K * 8
  copy BlkCols + W16 count 8 to vram.color + 1024 + (TBlk - 128) * 8
  return
end sub

sub BuildRow(u8 R):
  for Ci = RowA[R] to RowB[R]
    J = R * 7 + Ci
    Grid[J] = 1
    inc Blocks
    put char TBlk at CoreC + Ci,CoreR + R
  next
  return
end sub

sub ShowStatus:
  print at 8,1, Score
  NumU = Lv
  print at 18,1, digits$(NumU, 2)
  fill 32 count 6 at 23,1
  ShowLives(Lives)
  return
end sub

sub ShowLives(u8 N):
  for J = 1 to N
    put char TLife at 22 + J,1
  next
  return
end sub

sub Rnd:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 the ship (or the blast), 1 the shot, 2-7 the guardians
sub DrawSprites:
  X = Shx
  Y = Shy
  if Dead > 0 then
    K = SBl0
    if Dead < 70 then K = SBl1
    if Dead < 40 then
      set sprite 0 to 192,0,0,0
    else
      set sprite 0 to Y - 9,X - 8,K,11
    end if
  else
    K = Hd * 4 + SSh00
    set sprite 0 to Y - 9,X - 8,K,15
  end if
  if BOn = 1 then
    X = Bx >> 8
    Y = By >> 8
    set sprite 1 to Y - 9,X - 8,SShot,11
  else
    set sprite 1 to 192,0,0,0
  end if
  K = (Spin >> 2) & 3
  K = K * 4 + SEn0
  for Fi = 0 to NFoe - 1
    J = Fi + 2
    with Foes[Fi] as E
      if E.Act = 1 then
        C = Fi + 3
        if C = 4 then C = 9
        set sprite J to E.Py - 9,E.Px - 8,K,C
      else
        set sprite J to 192,0,0,0
      end if
    end with
  next
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  Stars
  print at 2,1, "SCORE"
  print at 15,1, "LV"
  Score = 0
  Lv = 1
  Lives = 3
  Dead = 0
  Won = 0
  Over = 0
  Kills = 0
  Broken = 0
  Shots = 0
  NewLife
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 0
  return
end sub

' a sprinkle of stars (never on the core)
sub Stars:
  for Ri = 3 to 22
    Rnd
    X = (Rs & 31)
    if X < 2 then X = X + 4
    if X > 29 then X = X - 6
    V = (Rs >> 8) & 3
    if V < 3 then put char TSt0 + V at X,Ri
  next
  for Ri = 8 to 14
    fill 32 count 7 at CoreC,Ri
  next
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: VORTEX in armour blocks, guardians wheeling round it, NOVICE /
' EXPERT / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  Lv = 1
  K = 0
  W16 = K * 8
  copy BlkCols + W16 count 8 to vram.color + 1024 + (TBlk - 128) * 8
  print at 7,1, "AHOY! JANUARY 1987"
  fill TBar count 28 at 2,3
  for Ci = 0 to 5
    BigLetter(Ci)
  next
  fill TBar count 28 at 2,10
  print at 7,12, "BY SEAN D. WAGLE"
  print at 12,15, "NOVICE"
  print at 12,16, "EXPERT"
  print at 12,17, "CREDITS"
  if Hi > 0 then
    print at 9,20, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  select case Menu
    case 0
      Expert = 0
    case 1
      Expert = 1
    case 2
      CreditsPage
  end select
  return
end sub

' one big letter, 3 x 5 blocks, at column 5 + 4 x N, rows 4-8
sub BigLetter(u8 N):
  for Ri = 0 to 4
    V = Font[N * 5 + Ri]
    for J = 0 to 2
      K = V & Bit3[J]
      if K > 0 then put char TBlk at 5 + N * 4 + J,4 + Ri
    next
  next
  return
end sub

' three guardians wheel across the title
sub TitleAnim:
  inc Spin
  K = (Spin >> 2) & 3
  K = K * 4 + SEn0
  for Fi = 0 to 2
    V = Spin + Fi * 85
    set sprite Fi + 2 to 103,V,K,Fi + 3
  next
  update sprites
  return
end sub

sub ShowMenu:
  for J = 15 to 17
    put char 32 at 10,J
  next
  J = Menu + 15
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "VORTEX"
  print at 2,5, "BASED ON VORTEX BY SEAN D."
  print at 2,6, "WAGLE, AHOY! JANUARY 1987"
  print at 2,7, "(COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SPIRAL ARM"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

