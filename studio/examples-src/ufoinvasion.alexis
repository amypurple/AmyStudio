cartridge "UFO INVASION/COMPUTE! JUNE 1986/1986"

' UFO INVASION
' A ColecoVision game based on "UFO Invasion", COMPUTE! June 1986 (IBM
' PC/PCjr original; Amiga version by Philip I. Nelson). The scans used
' (pages 58-60) do not name the original author; the credits name the
' magazine and Philip I. Nelson. Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a line-by-line port: the rules are the listing's, the game is built
' for the ColecoVision (a cockpit panel, smooth sprites, a sweeping radar,
' colour, music).
'
' The game: you defend an Arctic base. An alarm sounds and two warnings
' scroll by. The observatory window shows the night skyline and your
' aiming crosshair; the round radar shows where the UFO is from the
' crosshair (the blip turns red in the middle when you are on target).
' Move the crosshair with the stick, fire a missile with the button.
' Levels 1, 2, 4, 6 and 8 have clear skies; on levels 3, 5 and 7 clouds
' hide the UFO and only the radar can guide you. Each of the eight
' levels has 29 UFOs. While a UFO lives it locates your base: the LOC
' gauge rises, and at the top it hits you. Your shields stop three hits;
' the fourth ends the game.
'
' Points (the listing's): a bar on the PTS ladder for each UFO, and a
' second bar if it was hit before the LOC gauge was halfway up; a hit on
' your base takes two bars away. A bar is worth 100 x the level. At the
' end of a level, a bonus of 1000 x the level.
'
' Controls (either joystick): the stick moves the crosshair, the button
' fires. On the title: up and down choose START or CREDITS.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table ($702B,
' $7035), effects after, by channel.

const TRad00 = 128
const TRad01 = 129
const TRad02 = 130
const TRad03 = 131
const TRad04 = 132
const TRad05 = 133
const TRad06 = 134
const TRad07 = 135
const TRad10 = 136
const TRad11 = 137
const TRad12 = 138
const TRad13 = 139
const TRad14 = 140
const TRad15 = 141
const TRad16 = 142
const TRad17 = 143
const TRad20 = 144
const TRad21 = 145
const TRad22 = 146
const TRad23 = 147
const TRad24 = 148
const TRad25 = 149
const TRad26 = 150
const TRad27 = 151
const TRad30 = 152
const TRad31 = 153
const TRad32 = 154
const TRad33 = 155
const TRad34 = 156
const TRad35 = 157
const TRad36 = 158
const TRad37 = 159
const TRad40 = 160
const TRad41 = 161
const TRad42 = 162
const TRad43 = 163
const TRad44 = 164
const TRad45 = 165
const TRad46 = 166
const TRad47 = 167
const TRad50 = 168
const TRad51 = 169
const TRad52 = 170
const TRad53 = 171
const TRad54 = 172
const TRad55 = 173
const TRad56 = 174
const TRad57 = 175
const TRad60 = 176
const TRad61 = 177
const TRad62 = 178
const TRad63 = 179
const TRad64 = 180
const TRad65 = 181
const TRad66 = 182
const TRad67 = 183
const TRad70 = 184
const TRad71 = 185
const TRad72 = 186
const TRad73 = 187
const TRad74 = 188
const TRad75 = 189
const TRad76 = 190
const TRad77 = 191
const TGu0 = 192
const TGu1 = 193
const TGu2 = 194
const TGu3 = 195
const TGu4 = 196
const TGp0 = 197
const TGp1 = 198
const TGp2 = 199
const TGp3 = 200
const TGp4 = 201
const TGl0 = 202
const TGl1 = 203
const TGl2 = 204
const TGl3 = 205
const TGl4 = 206
const TShon = 207
const TShof = 208
const TRail = 209
const TW0 = 210
const TW1 = 211
const TW2 = 212
const TW3 = 213
const TW4 = 214
const TW5 = 215
const TW6 = 216
const TW7 = 217
const TW8 = 218
const TW9 = 219
const TW10 = 220
const TW11 = 221
const TW12 = 222
const TW13 = 223
const TW14 = 224
const TW15 = 225
const TW16 = 226
const TW17 = 227
const TW18 = 228
const TW19 = 229
const TW20 = 230
const TW21 = 231
const TW22 = 232
const TW23 = 233
const TCla = 234
const TClb = 235
const SCross = 0
const SUfo = 4
const SUfob = 8
const SUfol1 = 12
const SUfol2 = 16
const SDome = 20
const SMiss = 24
const SBlip = 28
const SBoom1 = 32
const SBoom2 = 36
const NTiles8 = 864
const SprBytes = 320
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndFire = 5
const SndBoom = 6
const SndPuff = 7
const SndShot = 8
const SndSiren = 9
const SndPing = 10
const SndClear = 11
const SndOver = 12
const MsgAlert = 0
const MsgInvasion = 1
const MsgClouds = 2
const MsgShield = 3
const MsgPassed = 4
const MsgOver = 5
const MsgWin = 6
u16 TzLeft = 0
u8 TzOn = 0

' Score and Hi are counted in hundreds (every point value is a multiple
' of 100); Score is what is banked at the end of each level
u16 Score = 0
u16 Hi = 0
u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
' Lv the level (1-8), Left UFOs still to destroy, Pts bars on the PTS
' ladder, Loc the location gauge (0-29), Hits the shield hits (0-4)
u8 Lv = 1
u8 Left = 29
u8 Pts = 0
u8 Loc = 0
u8 LocT = 0
u8 LocRate = 28
u8 Hits = 0
u8 Cloudy = 0
' Phase: 0 warnings, 1 play, 2 level passed, 3 game over, 4 won
u8 Phase = 0
u8 PhT = 0
' the crosshair (sprite place; its centre is +8,+8)
u8 Cx = 112
u8 Cy = 40
' the UFO: place in sixteenths of a pixel, speeds kept as offset values
' (VxO = speed + Vmax), its sprite place Ux, Uy
u16 Ux16 = 0
u16 Uy16 = 0
u8 VxO = 0
u8 VyO = 0
u8 Vmax = 7
u8 Ux = 0
u8 Uy = 0
u8 Boom = 0
' the missile: Ms frames flown (0 none), from Mx0,My0 to Tx,Ty (centres)
u8 Ms = 0
u8 Tx = 0
u8 Ty = 0
u8 Mx = 0
u8 My = 0
u8 Puff = 0
' the radar beam
u8 Ang = 0
u8 OldAng = 0
u8 Aimed = 0
u8 Bx = 0
u8 By = 0
' clouds: the two tiles' rows as they drift
u8 Cl[16]
u16 CloudAd = 0
' the marquee on row 12: message, length, place, the next message
u8 MqOn = 0
u8 MqN = 0
u8 MqLen = 0
u8 MqOff = 0
u8 MqNext = 255
u8 MqRow[28]
' base hit flash
u8 Flash = 0
' random numbers (a 16-bit xorshift)
u16 Rs = 12345
' counters for the test bot
u16 Kills = 0
u16 Shots = 0
u16 Fired = 0
u8 LastBars = 0
u8 Busy = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
' scratch (never kept across a sub call)
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Ad = 0
u8 Sg = 0
u8 Gc = 0
u8 Gv = 0
u8 Gb = 0
u8 Rv = 0
' the gauges' shown values, GFull 1 to draw every cell
u8 GOld[3]
u8 GFull = 0

  tile screen
  set sound table UfSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  Score = 0
  Hits = 0
  Lv = 1

new_level:
  Left = 29
  Pts = 0
  Loc = 0
  LocT = 0
  V = Lv << 1
  LocRate = 30 - V
  Vmax = 6 + Lv
  Cloudy = 0
  if Lv = 3 then Cloudy = 1
  if Lv = 5 then Cloudy = 1
  if Lv = 7 then Cloudy = 1
  Ms = 0
  Boom = 0
  Puff = 0
  Flash = 0
  Cx = 112
  Cy = 40
  DrawPlayfield
  NewUfo
  ShowScreen
  play sound SndRunA
  play sound SndRunB
  play sound SndSiren
  Phase = 0
  Marquee(MsgAlert)
  MqNext = MsgInvasion

play_loop:
  Frame1
  ReadPad
  if Phase = 0 then
    MoveCross
    if MqOn = 0 then
      Phase = 1
      if Cloudy = 1 then Marquee(MsgClouds)
    end if
  elseif Phase = 1 then
    MoveCross
    if Boom = 0 then MoveUfo
    FireMissile
    Missile
    if Boom = 0 then Locate
  else
    inc PhT
  end if
  if Boom > 0 then BoomStep
  if Puff > 0 then dec Puff
  if Flash > 0 then FlashStep
  Beam
  if Cloudy = 1 then
    V = Tick & 3
    if V = 0 then CloudShift
  end if
  ' the marquee on odd frames (the beam and the clouds take the even ones)
  if MqOn = 1 then
    V = Tick & 1
    if V = 1 then MarqueeStep
  end if
  DrawSprites
  if Phase = 2 then
    if PhT > 150 then
      inc Lv
      if Lv = 9 then
        Phase = 4
        PhT = 0
        Marquee(MsgWin)
        play sound SndClear
        goto play_loop
      end if
      goto new_level
    end if
  end if
  if Phase = 3 then
    if PhT > 90 then
      if Press = 1 then goto title
    end if
  end if
  if Phase = 4 then
    if PhT > 120 then
      if Press = 1 then goto title
    end if
  end if
  goto play_loop

' --- the crosshair --------------------------------------------------------
sub MoveCross:
  if Lf1 = 1 then
    if Cx > 9 then Cx = Cx - 2
  end if
  if Rt1 = 1 then
    if Cx < 230 then Cx = Cx + 2
  end if
  if Up1 = 1 then
    if Cy > 9 then Cy = Cy - 2
  end if
  if Dn1 = 1 then
    if Cy < 82 then Cy = Cy + 2
  end if
  return
end sub

' --- the UFO: a random drift (the listing changes course one pass in ten)
sub MoveUfo:
  Rnd8
  V = Rv & 15
  if V = 0 then NewCourse
  Ux16 = Ux16 + VxO
  Ux16 = Ux16 - Vmax
  Uy16 = Uy16 + VyO
  Uy16 = Uy16 - Vmax
  if Ux16 < 256 then
    Ux16 = 256
    V = Vmax << 1
    VxO = V - VxO
  end if
  if Ux16 > 3584 then
    Ux16 = 3584
    V = Vmax << 1
    VxO = V - VxO
  end if
  if Uy16 < 288 then
    Uy16 = 288
    V = Vmax << 1
    VyO = V - VyO
  end if
  if Uy16 > 1024 then
    Uy16 = 1024
    V = Vmax << 1
    VyO = V - VyO
  end if
  W16 = Ux16 >> 4
  Ux = W16
  W16 = Uy16 >> 4
  Uy = W16
  return
end sub

sub NewCourse:
  N = Vmax << 1
  inc N
  Rnd8
  VxO = Rv % N
  Rnd8
  VyO = Rv % N
  return
end sub

' NewUfo: a new UFO somewhere in the sky, the LOC gauge back to 0
sub NewUfo:
  Rnd8
  W16 = Rv
  W16 = W16 * 13
  W16 = W16 + 256
  if W16 > 3584 then W16 = 3584
  Ux16 = W16
  Rnd8
  W16 = Rv
  W16 = W16 * 2
  W16 = W16 + 288
  Uy16 = W16
  W16 = Ux16 >> 4
  Ux = W16
  W16 = Uy16 >> 4
  Uy = W16
  NewCourse
  Loc = 0
  LocT = 0
  DrawGauge(22, 0, TGl0)
  return
end sub

' --- the missile: from the launcher to where the crosshair was, 6 frames
sub FireMissile:
  if Press = 0 then return
  if Ms > 0 then return
  if Boom > 0 then return
  Ms = 1
  Tx = Cx + 8
  Ty = Cy + 8
  inc Fired
  play sound SndFire
  return
end sub

sub Missile:
  if Ms = 0 then return
  ' place: (120,92) * (6 - Ms) / 6 + target * Ms / 6
  K = 6 - Ms
  W16 = K * 128
  A16 = Ms * Tx
  W16 = W16 + A16
  W16 = W16 / 6
  Mx = W16
  W16 = K * 92
  A16 = Ms * Ty
  W16 = W16 + A16
  W16 = W16 / 6
  My = W16
  inc Ms
  if Ms < 7 then return
  Ms = 0
  ' arrived: on target if the UFO's centre is within 7 across, 5 down
  X = Ux + 8
  Y = Uy + 7
  Ad = 0
  if X >= Tx then
    V = X - Tx
  else
    V = Tx - X
  end if
  if V <= 7 then inc Ad
  if Y >= Ty then
    V = Y - Ty
  else
    V = Ty - Y
  end if
  if V <= 5 then inc Ad
  if Ad = 2 then
    UfoHit
  else
    Puff = 8
    play sound SndPuff
  end if
  return
end sub

' UfoHit: a bar, and a second one if the LOC gauge was under halfway
sub UfoHit:
  LastBars = 1
  if Loc < 15 then LastBars = 2
  Pts = Pts + LastBars
  dec Left
  inc Kills
  Boom = 30
  play sound SndBoom
  DrawGauge(3, Left, TGu0)
  V = Pts + 1
  V = V >> 1
  DrawGauge(7, V, TGp0)
  ShowScore
  return
end sub

sub BoomStep:
  dec Boom
  if Boom > 0 then return
  if Phase <> 1 then return
  if Left > 0 then
    NewUfo
    return
  end if
  ' the level is passed: its bars and the bonus are banked
  W16 = Pts * Lv
  Score = Score + W16
  W16 = Lv * 10
  Score = Score + W16
  Pts = 0
  ShowScore
  Phase = 2
  PhT = 0
  Marquee(MsgPassed)
  play sound SndClear
  return
end sub

' --- the location gauge: a step every LocRate frames; at the top, a hit -
sub Locate:
  inc LocT
  if LocT < LocRate then return
  LocT = 0
  inc Loc
  if Loc = 15 then play sound SndPing
  if Loc < 29 then
    DrawGauge(22, Loc, TGl0)
    return
  end if
  ' the UFO has found the base
  inc Hits
  inc Shots
  if Pts >= 2 then
    Pts = Pts - 2
  else
    Pts = 0
  end if
  V = Pts + 1
  V = V >> 1
  DrawGauge(7, V, TGp0)
  Flash = 24
  play sound SndShot
  Loc = 0
  DrawGauge(22, 0, TGl0)
  DrawShields
  ShowScore
  if Hits < 4 then
    Marquee(MsgShield)
    return
  end if
  ' the fourth hit: the invasion has won
  W16 = Pts * Lv
  Score = Score + W16
  Pts = 0
  if Score > Hi then Hi = Score
  ShowScore
  ShowHi
  Phase = 3
  PhT = 0
  Boom = 0
  Ms = 0
  Marquee(MsgOver)
  stop sound SndRunA
  stop sound SndRunB
  play sound SndOver
  return
end sub

sub FlashStep:
  dec Flash
  V = Flash & 4
  if V = 0 then
    backdrop black
  else
    backdrop dark red
  end if
  return
end sub

' --- the radar --------------------------------------------------------------
sub Beam:
  V = Tick & 1
  if V = 1 then return
  OldAng = Ang
  inc Ang
  Ang = Ang & 31
  call asm UfBeamDo
  return
end sub

' the blip: the UFO's place from the crosshair, a pixel for 8 across and
' for 4 down, at most 26 from the middle; red when on target
sub RadarBlip:
  X = Ux + 8
  Y = Uy + 7
  V = Cx + 8
  Aimed = 0
  if X >= V then
    Ad = X - V
    Sg = 0
  else
    Ad = V - X
    Sg = 1
  end if
  if Ad <= 7 then inc Aimed
  Ad = Ad >> 3
  if Ad > 26 then Ad = 26
  if Sg = 0 then
    Bx = 120 + Ad
  else
    Bx = 120 - Ad
  end if
  V = Cy + 8
  if Y >= V then
    Ad = Y - V
    Sg = 0
  else
    Ad = V - Y
    Sg = 1
  end if
  if Ad <= 5 then inc Aimed
  Ad = Ad >> 2
  if Ad > 26 then Ad = 26
  if Sg = 0 then
    By = 135 + Ad
  else
    By = 135 - Ad
  end if
  return
end sub

' --- clouds drift: the two cloud tiles' rows turn left a pixel ------------
sub CloudShift:
  call asm UfCloud
  return
end sub

' --- the marquee on row 12: the message scrolls in from the right -------
sub Marquee(u8 M):
  MqN = M
  MqLen = MsgLen[M]
  MqOff = 0
  MqOn = 1
  MqNext = 255
  return
end sub

sub MarqueeStep:
  inc MqOff
  V = MqLen + 28
  if MqOff > V then
    if MqNext <> 255 then
      Marquee(MqNext)
    else
      MqOn = 0
    end if
    return
  end if
  ' column c shows the message's character (MqOff + c - 28)
  for J = 0 to 27
    N = 32
    V = MqOff + J
    if V >= 28 then
      V = V - 28
      if V < MqLen then
        W16 = MsgAt[MqN]
        W16 = W16 + V
        N = MsgText[W16]
      end if
    end if
    MqRow[J] = N
  next
  copy MqRow count 28 to vram.name + 386
  return
end sub

' --- the gauges: 8 cells high, 4 rungs a cell, two columns wide ---------
sub DrawGauge(u8 Col, u8 Val, u8 Base):
  ' the gauge's slot: 0 UFOS (column 3), 1 PTS (7), 2 LOC (22); only the
  ' cells whose rungs change are drawn (GOld: the values shown)
  Gb = 0
  if Col = 7 then Gb = 1
  if Col = 22 then Gb = 2
  N = GOld[Gb]
  GOld[Gb] = Val
  for J = 0 to 7
    K = J << 2
    Gv = 0
    if Val > K then
      Gv = Val - K
      if Gv > 4 then Gv = 4
    end if
    V = 0
    if N > K then
      V = N - K
      if V > 4 then V = 4
    end if
    if GFull = 1 then V = 255
    if V <> Gv then
      Gc = Gv + Base
      Y = 21 - J
      put char Gc at Col,Y
      X = Col + 1
      put char Gc at X,Y
    end if
  next
  return
end sub

sub DrawShields:
  for J = 0 to 2
    Y = J << 1
    Y = Y + 15
    V = TShof
    if Hits <= J then V = TShon
    put char V at 27,Y
    put char V at 28,Y
  next
  return
end sub

sub ShowScore:
  W16 = Pts * Lv
  NumU = Score + W16
  print at 8,22, digits$(NumU, 5)
  return
end sub

sub ShowHi:
  print at 13,22, "00"
  NumU = Hi
  print at 21,22, digits$(NumU, 5)
  print at 26,22, "00"
  return
end sub

' --- sprites -------------------------------------------------------------
sub DrawSprites:
  set sprite 0 to Cy,Cx,SCross,15
  if Ms > 0 then
    X = Mx - 8
    Y = My - 8
    set sprite 1 to Y,X,SMiss,11
  elseif Puff > 0 then
    X = Tx - 8
    Y = Ty - 8
    set sprite 1 to Y,X,SBoom2,14
  else
    set sprite 1 to 192,0,SMiss,0
  end if
  if Boom > 0 then
    V = Boom & 4
    N = SBoom1
    K = 11
    if V = 0 then
      N = SBoom2
      K = 9
    end if
    set sprite 2 to Uy,Ux,N,K
    set sprite 3 to 192,0,N,0
  elseif Phase = 1 then
    if Cloudy = 1 then
      set sprite 2 to 192,0,SUfo,0
      set sprite 3 to 192,0,SUfo,0
    else
      V = Tick & 8
      N = SUfo
      K = SUfol1
      Gc = 8
      if V > 0 then
        N = SUfob
        K = SUfol2
        Gc = 11
      end if
      set sprite 2 to Uy,Ux,N,7
      set sprite 3 to Uy,Ux,K,Gc
    end if
  else
    set sprite 2 to 192,0,SUfo,0
    set sprite 3 to 192,0,SUfo,0
  end if
  if Phase = 1 then
    RadarBlip
    V = 11
    if Aimed = 2 then V = 8
    if Boom > 0 then V = 0
    set sprite 4 to By,Bx,SBlip,V
  else
    set sprite 4 to 192,0,SBlip,0
  end if
  update sprites
  return
end sub

' --- screens --------------------------------------------------------------
sub DrawPlayfield:
  NewScreen
  W16 = 0
  for Y = 2 to 11
    for X = 2 to 29
      V = WinMap[W16]
      put char V at X,Y
      inc W16
    next
  next
  ' the clouds: the cloud tiles fresh, over rows 2-9
  W16 = TCla - 128
  W16 = W16 * 8
  for J = 0 to 15
    A16 = W16 + J
    Cl[J] = TilePat[A16]
  next
  CloudAd = TCla * 8
  if Cloudy = 1 then
    for Y = 2 to 9
      for X = 2 to 29
        V = X & 1
        V = V + TCla
        put char V at X,Y
      next
    next
  end if
  ' the radar
  N = TRad00
  for Y = 14 to 21
    for X = 12 to 19
      put char N at X,Y
      inc N
    next
  next
  print at 2,1, "LEVEL"
  NumU = Lv
  print at 8,1, digits$(NumU, 1)
  if Cloudy = 1 then
    print at 18,1, "CLOUD COVER"
  else
    print at 18,1, "CLEAR SKIES"
  end if
  print at 2,13, "UFOS"
  print at 7,13, "PTS"
  print at 13,13, "RADAR"
  print at 22,13, "LOC"
  print at 26,13, "SHLD"
  print at 2,22, "SCORE"
  print at 18,22, "HI"
  GFull = 1
  DrawGauge(3, Left, TGu0)
  V = Pts + 1
  V = V >> 1
  DrawGauge(7, V, TGp0)
  DrawGauge(22, Loc, TGl0)
  GFull = 0
  DrawShields
  ShowScore
  ShowHi
  return
end sub

sub Rnd8:
  ' xorshift 7, 9, 8 on 16 bits
  A16 = Rs << 7
  Rs = Rs ^ A16
  A16 = Rs >> 9
  Rs = Rs ^ A16
  A16 = Rs << 8
  Rs = Rs ^ A16
  W16 = Rs >> 8
  Rv = W16
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 5
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Busy = 1
  Rearm
  wait
  nmi off
  display off
  HideSprites
  backdrop black
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  cls
  MqOn = 0
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Busy = 0
  return
end sub

sub TitlePage:
  NewScreen
  W16 = 0
  for Y = 2 to 11
    for X = 2 to 29
      V = WinMap[W16]
      put char V at X,Y
      inc W16
    next
  next
  print at 9,4, "U F O"
  print at 8,6, "INVASION"
  print at 4,14, "DEFEND THE ARCTIC BASE"
  print at 4,15, "STICK AIMS, BUTTON FIRES"
  print at 11,19, "HI"
  NumU = Hi
  print at 14,19, digits$(NumU, 5)
  print at 19,19, "00"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Menu = 0
  Ux16 = 256
  Uy = 60
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadPad
  Rnd8
  ' a saucer crosses the window now and then
  Ux16 = Ux16 + 1
  if Ux16 > 260 then Ux16 = 0
  V = Tick & 8
  N = SUfo
  K = SUfol1
  if V > 0 then
    N = SUfob
    K = SUfol2
  end if
  X = Ux16
  if Ux16 < 240 then
    set sprite 2 to Uy,X,N,7
    set sprite 3 to Uy,X,K,11
  else
    set sprite 2 to 192,0,N,0
    set sprite 3 to 192,0,K,0
  end if
  update sprites
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  ' the time spent on the title seeds the random numbers
  W16 = Tick
  Rs = Rs + W16
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  fill 32 count 3 at 9,17
  fill 32 count 3 at 9,18
  print at 12,17, "START"
  print at 12,18, "CREDITS"
  V = Menu + 17
  put char 62 at 10,V
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 8,2, "U F O  INVASION"
  print at 2,5, "BASED ON UFO INVASION,"
  print at 2,6, "COMPUTE! JUNE 1986 (IBM"
  print at 2,7, "PC AND PCJR). AMIGA"
  print at 2,8, "VERSION BY PHILIP I."
  print at 2,9, "NELSON."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: POLAR WATCH,"
  print at 2,19, "RADAR NIGHT"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

