asm {
; UfBeamDo: the radar beam moves from OldAng to Ang: the old line's bytes
; are put back, the new line's drawn (called with the NMI off)
UfBeamDo:
    ld a,(AMY_UVAR_OldAng)
    call ufb_list
    ld b,(hl)
    inc hl
ufb_old:
    ld a,(hl)
    out ($BF),a
    inc hl
    ld a,(hl)
    or $40
    out ($BF),a
    inc hl
    inc hl
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ufb_old
    ld a,(AMY_UVAR_Ang)
    call ufb_list
    ld b,(hl)
    inc hl
ufb_new:
    ld a,(hl)
    out ($BF),a
    inc hl
    ld a,(hl)
    or $40
    out ($BF),a
    inc hl
    ld a,(hl)
    out ($BE),a
    inc hl
    inc hl
    djnz ufb_new
    ret
; UfCloud: the two cloud tiles (rows Cl[0-7] and Cl[8-15], side by side)
; turn left a pixel, then are written at CloudAd in the first two
; pattern tables (rows 2-9 of the screen)
UfCloud:
    ld ix,AMY_UVAR_Cl
    ld b,8
ufc_row:
    ld a,(ix+0)
    ld c,(ix+8)
    sla c
    rl a
    jr nc,ufc_nc
    inc c
ufc_nc:
    ld (ix+0),a
    ld (ix+8),c
    inc ix
    djnz ufc_row
    ld hl,(AMY_UVAR_CloudAd)
    call ufc_out
    ld de,2048
    ld hl,(AMY_UVAR_CloudAd)
    add hl,de
ufc_out:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_Cl
    ld b,16
ufc_lp:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ufc_lp
    ret
ufb_list:
    ld l,a
    ld h,0
    add hl,hl
    ld de,UfBeamTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ret
; the radar beam (made by art.py): UfBeamTab, a word per angle pointing
