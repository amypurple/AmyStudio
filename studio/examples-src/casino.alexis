  tile screen
  set sound table CaSoundTable areas 4
  sprites 16x16
  nmi off
  HideSprites
  screen on

' ===========================================================================
' THE LOBBY

lobby:
  Tbl = 0
  if Money = 0 then
    NewScreen
    LobbyFrame
    print at 6,8, "THE HOUSE THANKS YOU"
    print at 6,9, "FOR A LOVELY EVENING."
    print at 6,11, "THE NIGHT IS ON US:"
    print at 6,12, "HERE IS A FRESH $100"
    print at 6,13, "FOR YOUR NEXT VISIT."
    print at 6,15, "COME BACK SOON!"
    ShowScreen
    play sound SndPair
    WaitPress
    Money = 100
  end if
  if Money > Best then Best = Money
  NewScreen
  LobbyFrame
  ' the ace and the king of spades
  Dx = 5
  Dy = 4
  Dk = 26
  DrawCard
  Dx = 23
  Dk = 38
  DrawCard
  print at 10,4, "THE CASINO"
  print at 11,8, "BLACKJACK"
  print at 11,9, "ROULETTE"
  print at 11,10, "FRUIT MACHINE"
  print at 11,11, "SEVEN/ELEVEN"
  print at 11,12, "UNDER 'N' OVER"
  print at 11,13, "INNER SPRING"
  print at 11,15, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 6,18, "YOUR WALLET $"
  NumU = Money
  print at 19,18, width$(NumU, 5)
  print at 6,19, "BEST TONIGHT $"
  NumU = Best
  print at 20,19, width$(NumU, 5)
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  WasBtn = 1
  Stage = 6
lb_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 7 then inc Menu
    end if
    play sound SndClick
  end if
  for I = 8 to 16
    print at 9,I, " "
  next
  Y = Menu + 8
  if Menu >= 6 then inc Y
  print at 9,Y, ">"
  if Press = 0 then goto lb_loop
  Stage = 0
  mute all
  TzOn = 0
  play sound SndOk
  if Menu = 0 then goto blackjack
  if Menu = 1 then goto roulette
  if Menu = 2 then goto slots
  if Menu = 3 then goto seven
  if Menu = 4 then goto underover
  if Menu = 5 then goto spring
  if Menu = 6 then
    RulesPage
    goto lobby
  end if
  CreditsPage
  goto lobby

' leaving a table: broke, or by choice
leave:
  HideSprites
  goto lobby

' ===========================================================================
' CASINO BLACKJACK (games/bj)

blackjack:
  Tbl = 0
  BetMax = 1000
  NewScreen
  for Y = 2 to 20
    fill BjTFelt count 28 at 2,Y
  next
  BjClear
  ShowScreen
bj_hand:
  if Money = 0 then goto leave
  BjClear
  BjMoney
  Message
  Bx = 13
  By = 21
  print at 2,21, "YOUR BET? $"
  print at 2,22, "STICK: BET  BUTTON: DEAL"
  BetUI
  if Res = 1 then goto leave
  Message
  ' the deal: player, dealer, player, dealer (face down)
  if Top > 37 then Shuffle
  Hands = 1
  Hd = 0
  Pn[0] = 0
  Pn[1] = 0
  Pst[0] = 0
  Pst[1] = 0
  Pb[0] = Bet
  Pb[1] = 0
  Dn = 0
  Hole = 1
  Ins = 0
  Money = Money - Bet
  BjMoney
  DealPlayer
  DealDealer
  DealPlayer
  DealDealer
  ShowPlayerTotal
  ' insurance against a dealer's ace
  Dk = Dh[0]
  CardOf
  if Dr = 0 then
    Amt = Bet >> 1
    if Amt > 0 then
      if Money >= Amt then
        Message
        print at 2,21, "INSURANCE?"
        Opts[0] = 6
        Opts[1] = 7
        Nopt = 2
        ChooseOpt
        if Opts[Opt] = 6 then
          Ins = Amt
          Money = Money - Ins
          BjMoney
        end if
      end if
    end if
  end if
  ' a dealer's blackjack ends the hand at once
  V = 0
  if Dr = 0 then V = 1
  if Dr >= 9 then V = 1
  if V = 1 then
    DealerTotal
    if DTot = 21 then
      Hole = 0
      DrawDealer
      ShowDealerTotal
      Message
      print at 2,22, "DEALER HAS BLACKJACK"
      if Ins > 0 then
        ' insurance: the bet is kept
        Money = Money + Bet
        Money = Money + Ins
        Res = 4
      else
        Hd = 0
        HandTotal
        if Tot = 21 then
          Money = Money + Bet
          Res = 3
        else
          Res = 2
        end if
      end if
      play sound SndLose
      Hd = 0
      ShowResult
      goto bj_end
    end if
    if Ins > 0 then
      Message
      print at 2,22, "NO BLACKJACK: INSURANCE LOST"
      play sound SndLose
      Pause
    end if
  end if
  ' a player's blackjack pays 3 to 2
  Hd = 0
  HandTotal
  if Tot = 21 then
    Hole = 0
    DrawDealer
    ShowDealerTotal
    Win = Bet >> 1
    Win = Win + Bet
    Win = Win + Bet
    AddWin
    Res = 5
    ShowResult
    play sound SndBigWin
    BjMoney
    Celebrate
    goto bj_end
  end if
  Hd = 0
bj_play:
  Hit1 = 0
bj_decide:
  HandTotal
  if Tot > 21 then
    Pst[Hd] = 1
    Res = 1
    ShowResult
    play sound SndLose
    goto bj_done
  end if
  if Tot = 21 then goto bj_done
  ' the choices
  Opts[0] = 0
  Opts[1] = 1
  Nopt = 2
  N = Pn[Hd]
  if N = 2 then
    if Hit1 = 0 then
      ' double down on 10 or 11
      if Tot >= 10 then
        if Tot <= 11 then
          if Money >= Pb[Hd] then
            Opts[Nopt] = 2
            inc Nopt
          end if
        end if
      end if
      ' split two cards of the same rank (one split); surrender
      if Hands = 1 then
        Dk = Ph[0]
        CardOf
        V = Dr
        Dk = Ph[1]
        CardOf
        if Dr = V then
          if Money >= Pb[0] then
            Opts[Nopt] = 3
            inc Nopt
          end if
        end if
        Opts[Nopt] = 4
        inc Nopt
      end if
    end if
  end if
  Message
  if Hands = 2 then
    print at 2,22, "HAND"
    NumU = Hd + 1
    print at 7,22, width$(NumU, 1)
  end if
  ChooseOpt
  V = Opts[Opt]
  if V = 0 then
    Hit1 = 1
    DealPlayer
    ShowPlayerTotal
    goto bj_decide
  end if
  if V = 1 then goto bj_done
  if V = 2 then
    ' double down: one card, then stand
    Money = Money - Pb[Hd]
    Pb[Hd] = Pb[Hd] + Pb[Hd]
    BjMoney
    DealPlayer
    ShowPlayerTotal
    HandTotal
    if Tot > 21 then
      Pst[Hd] = 1
      Res = 1
      ShowResult
      play sound SndLose
    end if
    goto bj_done
  end if
  if V = 3 then
    ' split: the second card starts hand 2
    Money = Money - Pb[0]
    Pb[1] = Pb[0]
    Ph[12] = Ph[1]
    Pn[0] = 1
    Pn[1] = 1
    Hands = 2
    BjMoney
    DrawHands
    Hd = 0
    DealPlayer
    Hd = 1
    DealPlayer
    Hd = 0
    ShowPlayerTotal
    Hd = 1
    ShowPlayerTotal
    Hd = 0
    goto bj_decide
  end if
  ' surrender: half the bet back
  Amt = Pb[0] >> 1
  Money = Money + Amt
  Pst[0] = 2
  Res = 6
  ShowResult
  play sound SndLose
bj_done:
  inc Hd
  if Hd < Hands then goto bj_play
  ' the dealer plays if a hand is still standing
  Live = 0
  Cn = Hands - 1
  for Hd = 0 to Cn
    if Pst[Hd] = 0 then Live = 1
  next
  Hole = 0
  DrawDealer
  ShowDealerTotal
  if Live = 1 then
bj_draw:
    DealerTotal
    if DTot <= 16 then
      Pause
      DealDealer
      ShowDealerTotal
      goto bj_draw
    end if
  end if
  for Hd = 0 to 1
    if Hd < Hands then
      if Pst[Hd] = 0 then Settle
    end if
  next
bj_end:
  BjMoney
  Message
  print at 2,22, "PRESS A BUTTON"
  WaitPress
  goto bj_hand

' ===========================================================================
' ROULETTE (games/rl)

roulette:
  Tbl = 1
  BetMax = 500
  Cx = 0
  Cy = 0
  RlScreen
rl_place:
  if Money = 0 then goto leave
  Mode = 1
  Panel
  print at 15,6, "MESSIEURS,"
  print at 15,7, "FAITES VOS JEUX"
  WasBtn = 1
  WasBtn2 = 1
  Stage = 4
rl_frame:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    MoveChip
    play sound SndClick
  end if
  ChipAt
  BetName
  if Press2 = 1 then goto leave
  if Press = 0 then goto rl_frame
  Stage = 0
  play sound SndChip
  ' how many chips?
  Mode = 2
  Panel
  print at 15,6, "HOW MANY CHIPS?"
  Bx = 15
  By = 7
  BetUI
  if Res = 1 then goto rl_place
  ' rien ne va plus
  Mode = 3
  Stake = Bet
  Money = Money - Stake
  RlMoney
  Panel
  print at 15,6, "RIEN NE VA"
  print at 15,7, "PLUS."
  SpinBall
  RlSettle
  goto rl_place

' ===========================================================================
' LAS VEGAS HIGH (games/lv)

slots:
  Tbl = 2
  BetMax = 1000
  Cabinet
  Chatter
lv_bet:
  if Money = 0 then goto leave
  Mode = 1
  print at 2,19, "STICK: BET  BUTTON: PULL!"
  print at 2,20, "2ND BUTTON: LOBBY"
  Bx = 22
  By = 18
  BetUI
  if Res = 1 then goto leave
  Mode = 2
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,16
  fill 32 count 28 at 2,17
  Money = Money - Bet
  CashLine
  Handle
  Spin
  Judge
  Pay
  Chatter
  goto lv_bet

' ===========================================================================
' SEVEN/ELEVEN (games/dg), for a bet

seven:
  Game = 1
  Tbl = 3
  BetMax = 1000
  Wins = 0
  Losses = 0
  DiceScreen
se_round:
  if Money = 0 then goto leave
  Point = 0
  Puck
  Tally
  Say
  print at 2,3, "PLACE YOUR BET: $"
  Bx = 19
  By = 3
  BetUI
  if Res = 1 then goto leave
  Money = Money - Bet
  DiceMoney
  Say
  print at 2,3, "PRESS THE BUTTON TO ROLL"
  WaitPress
  Throw
  Say
  print at 2,3, "IN 7/11 YOU'VE ROLLED"
  NumU = Total
  print at 24,3, width$(NumU, 2)
  if Total = 7 then goto se_win
  if Total = 11 then goto se_win
  if Total = 2 then goto se_out
  if Total = 3 then goto se_out
  if Total = 12 then goto se_out
  ' the target number
  Point = Total
  Puck
  play sound SndPoint
  print at 2,4, "THAT'S YOUR TARGET NUMBER"
  Pause
se_again:
  Say
  print at 2,3, "YOUR TARGET NUMBER IS"
  NumU = Point
  print at 24,3, width$(NumU, 2)
  print at 2,4, "PRESS THE BUTTON TO ROLL"
  WaitPress
  Throw
  Say
  print at 2,3, "IN 7/11 YOU'VE ROLLED"
  NumU = Total
  print at 24,3, width$(NumU, 2)
  if Total = Point then goto se_win
  if Total = 7 then goto se_lose
  if Total = 11 then goto se_lose
  Pause
  goto se_again
se_out:
  print at 2,4, "SO THAT'S THE END OF THE ROUND"
  goto se_lost
se_lose:
  print at 2,4, "AND SO YOU LOSE"
se_lost:
  inc Losses
  play sound SndLose
  Tally
  Pause
  Pause
  HideDice
  goto se_round
se_win:
  print at 2,4, "AND YOU'VE WON $"
  NumU = Bet
  print at 20,4, width$(NumU, 4)
  inc Wins
  Win = Bet + Bet
  AddWin
  play sound SndWin
  DiceMoney
  Tally
  Pause
  Pause
  HideDice
  goto se_round

' ===========================================================================
' UNDER 'N' OVER (games/dg)

underover:
  Game = 3
  Tbl = 3
  BetMax = 1000
  Choice = 0
  DiceScreen
uo_bet:
  if Money = 0 then goto leave
  Say
  print at 2,3, "OK, PUNTER, 'TIS TIME TO"
  print at 2,4, "PLACE YOUR BET..."
  ChooseBox
  if Res = 1 then goto leave
  Say
  print at 2,3, "HOW MUCH WOULD YOU LIKE"
  print at 2,4, "TO BET?  $"
  Bx = 12
  By = 4
  BetUI
  if Res = 1 then goto uo_bet
  Throw
  Say
  print at 2,3, "SO THE TOTAL IS"
  NumU = Total
  print at 18,3, width$(NumU, 2)
  ' the book: lose the bet; win it on under or over, four times on 7
  V = 0
  if Choice = 0 then
    if Total < 7 then V = 1
  end if
  if Choice = 1 then
    if Total = 7 then V = 4
  end if
  if Choice = 2 then
    if Total > 7 then V = 1
  end if
  if V = 0 then
    Money = Money - Bet
    print at 2,4, "AND SO YOU LOSE $"
    NumU = Bet
    print at 19,4, width$(NumU, 4)
    play sound SndLose
    DiceMoney
  else
    Win = Bet
    if V = 4 then Win = Bet << 2
    print at 2,4, "YOU'VE JUST WON $"
    NumU = Win
    print at 19,4, width$(NumU, 4)
    AddWin
    DiceMoney
    if V = 4 then
      play sound SndBigWin
      Celebrate
    else
      play sound SndWin
    end if
  end if
  Pause
  Pause
  HideDice
  goto uo_bet

' ===========================================================================
' INNER SPRING (games/cp)

spring:
  Tbl = 0
  BetMax = 1000
  NewScreen
  for Y = 2 to 22
    fill BjTFelt count 32 at 0,Y
  next
  print at 2,1, "INNER SPRING"
  ShowScreen
is_round:
  if Money = 0 then goto leave
  for Y = 4 to 21
    fill BjTFelt count 28 at 2,Y
  next
  IsMoney
  ' the book: two numbers 2 to 6 apart, a third that is neither
  Nr = 13
  RndN
  NA = V + 1
is_b:
  Nr = 13
  RndN
  NB = V + 1
  if NA > NB then
    W = NA - NB
  else
    W = NB - NA
  end if
  if W < 2 then goto is_b
  if W > 6 then goto is_b
is_c:
  Nr = 13
  RndN
  NC = V + 1
  if NC = NA then goto is_c
  if NC = NB then goto is_c
  play sound SndDeal
  Dx = 4
  Dy = 5
  Dr = NA
  RndSuit
  Pause
  play sound SndDeal
  Dx = 24
  Dr = NB
  RndSuit
  Pause
  play sound SndDeal
  Dx = 14
  DrawBack
  IsSay
  print at 2,12, "MY FIRST NUMBER IS"
  NumU = NA
  print at 21,12, width$(NumU, 2)
  print at 2,13, "MY SECOND IS"
  NumU = NB
  print at 15,13, width$(NumU, 2)
  print at 2,15, "HOW MUCH DO YOU BET MY NEXT"
  print at 2,16, "NUMBER LIES BETWEEN"
  NumU = NA
  print at 22,16, width$(NumU, 2)
  print at 25,16, "AND"
  NumU = NB
  print at 2,17, width$(NumU, 2)
  print at 4,17, "?   $"
  Bx = 10
  By = 17
  BetUI
  if Res = 1 then goto leave
  ' the book: D = D - E; then 3 E back on a win
  Money = Money - Bet
  IsMoney
  play sound SndFlip
  Dx = 14
  Dr = NC
  RndSuit
  IsSay
  print at 2,12, "MY NUMBER WAS"
  NumU = NC
  print at 16,12, width$(NumU, 2)
  V = 0
  if NC > NA then
    if NC < NB then V = 1
  end if
  if NC < NA then
    if NC > NB then V = 1
  end if
  if V = 1 then
    Win = Bet << 1
    print at 2,14, "WELL DONE, YOU WIN $"
    NumU = Win
    print at 22,14, width$(NumU, 5)
    Win = Win + Bet
    AddWin
    play sound SndWin
  else
    print at 2,14, "SORRY, YOU LOSE $"
    NumU = Bet
    print at 19,14, width$(NumU, 5)
    play sound SndLose
  end if
  IsMoney
  print at 2,22, "PRESS A BUTTON"
  WaitPress
  fill 32 count 28 at 2,22
  goto is_round

' ===========================================================================
' The wallet and the bet

' AddWin: Win comes back to the wallet (the cashier holds up to $65,000)
sub AddWin:
  Uw = 65000 - Money
  if Win > Uw then
    Money = 65000
  else
    Money = Money + Win
  end if
  if Money > Best then Best = Money
  return
end sub

' BetUI: the bet at Bx, By: up and down by $1, left and right by $10;
' never more than the wallet or the table's limit. The button plays (Res
' 0), the second button leaves (Res 1).
sub BetUI:
  if Bet = 0 then Bet = 1
  BetClamp
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
  Stage = 1
bu_loop:
  if Res = 1 then
    NumU = Bet
    print at Bx,By, width$(NumU, 4)
    Res = 0
  end if
  if Tbl = 2 then
    Pace
    Lights
  else
    Frame1
  end if
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then inc Bet
    if Dn1 = 1 then
      if Bet > 1 then dec Bet
    end if
    if Rt1 = 1 then Bet = Bet + 10
    if Lf1 = 1 then
      if Bet > 10 then
        Bet = Bet - 10
      else
        Bet = 1
      end if
    end if
    BetClamp
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    Stage = 0
    return
  end if
  if Press = 0 then goto bu_loop
  Stage = 0
  play sound SndChip
  Res = 0
  return
end sub

sub BetClamp:
  if Bet > BetMax then Bet = BetMax
  if Bet > Money then Bet = Money
  return
end sub

' Celebrate: three bursts of sparks for a big win
sub Celebrate:
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], 60, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  if Tbl = 2 then
    Lv = 0
    HandleAt
    update sprites
  end if
  return
end sub

' ===========================================================================
' Blackjack's cards (games/bj)

sub Shuffle:
  Message
  print at 2,22, "SHUFFLING..."
  play sound SndShuffle
  for J = 0 to 51
    Cd[J] = J
  next
  J = 51
sh_next:
  Rnd
  V = Rb + Mix
  V = V + Tick
  N = J + 1
  while V >= N
    V -= N
  end while
  X = Cd[J]
  Cd[J] = Cd[V]
  Cd[V] = X
  Mix += 37
  dec J
  if J > 0 then goto sh_next
  Top = 0
  Pause
  Message
  return
end sub

' CardOf: Dk = a card: Dr = rank (0 ace - 12 king), Ds = suit
sub CardOf:
  Dr = Dk
  Ds = 0
  while Dr >= 13
    Dr -= 13
    inc Ds
  end while
  return
end sub

sub DealPlayer:
  Hb = Hd * 12
  V = Pn[Hd]
  V = V + Hb
  Ph[V] = Cd[Top]
  inc Top
  inc Pn[Hd]
  play sound SndDeal
  DrawHands
  Pause
  return
end sub

sub DealDealer:
  Dh[Dn] = Cd[Top]
  inc Top
  inc Dn
  play sound SndDeal
  DrawDealer
  Pause
  return
end sub

' HandTotal: Tot of hand Hd (aces 11 when that does not bust)
sub HandTotal:
  Hb = Hd * 12
  Tot = 0
  Soft = 0
  Cn = Pn[Hd]
  for Ci = 1 to Cn
    V = Hb + Ci
    dec V
    Dk = Ph[V]
    CardOf
    Count
  next
  Aces
  return
end sub

sub DealerTotal:
  Tot = 0
  Soft = 0
  for Ci = 1 to Dn
    V = Ci - 1
    Dk = Dh[V]
    CardOf
    Count
  next
  Aces
  DTot = Tot
  return
end sub

sub Aces:
  if Soft = 1 then
    if Tot <= 11 then Tot = Tot + 10
  end if
  return
end sub

sub Count:
  V = Dr + 1
  if V > 10 then V = 10
  if Dr = 0 then Soft = 1
  Tot = Tot + V
  return
end sub

' Settle: hand Hd against the dealer
sub Settle:
  HandTotal
  PTot = Tot
  DealerTotal
  if DTot > 21 then
    Res = 7
  else
    if PTot > DTot then Res = 7
    if PTot = DTot then Res = 3
    if PTot < DTot then Res = 2
  end if
  if Res = 7 then
    Win = Pb[Hd] + Pb[Hd]
    AddWin
    play sound SndWin
  end if
  if Res = 3 then
    Win = Pb[Hd]
    AddWin
  end if
  if Res = 2 then play sound SndLose
  ShowResult
  return
end sub

' ChooseOpt: Nopt choices from Opts on row 21; Opt = the one taken
sub ChooseOpt:
  Opt = 0
  WasBtn = 1
  Stage = 2
co_draw:
  fill 32 count 28 at 2,21
  X = 3
  Cn = Nopt - 1
  for I = 0 to Cn
    V = Opts[I]
    if I = Opt then
      W = X - 1
      print at W,21, ">"
    end if
    if V = 0 then print at X,21, "HIT"
    if V = 1 then print at X,21, "STAND"
    if V = 2 then print at X,21, "DOUBLE"
    if V = 3 then print at X,21, "SPLIT"
    if V = 4 then print at X,21, "SURR."
    if V = 6 then print at X,21, "YES"
    if V = 7 then print at X,21, "NO"
    X = X + 6
  next
co_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Rt1 = 1 then
      V = Opt + 1
      if V < Nopt then Opt = V
    end if
    if Lf1 = 1 then
      if Opt > 0 then dec Opt
    end if
    play sound SndClick
    goto co_draw
  end if
  if Press = 0 then goto co_loop
  Stage = 0
  play sound SndOk
  fill 32 count 28 at 2,21
  return
end sub

sub DrawDealer:
  Dy = 3
  for Ci = 0 to 6
    Dx = Ci * 4
    Dx = Dx + 2
    if Ci < Dn then
      Dk = Dh[Ci]
      V = 0
      if Ci = 1 then V = Hole
      if V = 1 then
        DrawBack
      else
        DrawCard
      end if
    else
      ClearCard
    end if
  next
  return
end sub

sub DrawHands:
  for K = 0 to 1
    Dy = K * 6
    Dy = Dy + 10
    Hb = K * 12
    Cn = Pn[K]
    for Ci = 0 to 6
      Dx = Ci * 4
      Dx = Dx + 2
      if Ci < Cn then
        V = Hb + Ci
        Dk = Ph[V]
        DrawCard
      else
        ClearCard
      end if
    next
  next
  if Hands = 2 then
    print at 2,15, "HAND 2"
    print at 2,9, "HAND 1"
  end if
  return
end sub

sub BjClear:
  Hands = 1
  Pn[0] = 0
  Pn[1] = 0
  Dn = 0
  DrawDealer
  DrawHands
  fill BjTFelt count 28 at 2,6
  fill BjTFelt count 28 at 2,9
  fill BjTFelt count 28 at 2,13
  fill BjTFelt count 28 at 2,15
  fill BjTFelt count 28 at 2,19
  print at 2,2, "DEALER"
  print at 2,9, "YOU"
  return
end sub

sub ShowPlayerTotal:
  HandTotal
  Y = Hd * 6
  Y = Y + 13
  fill BjTFelt count 12 at 2,Y
  NumU = Tot
  print at 2,Y, width$(NumU, 2)
  return
end sub

sub ShowDealerTotal:
  DealerTotal
  fill BjTFelt count 12 at 2,6
  NumU = DTot
  print at 2,6, width$(NumU, 2)
  return
end sub

' ShowResult: Res for hand Hd next to its total
sub ShowResult:
  Y = Hd * 6
  Y = Y + 13
  X = 6
  if Res = 1 then print at X,Y, "BUST"
  if Res = 2 then print at X,Y, "LOSE"
  if Res = 3 then print at X,Y, "PUSH"
  if Res = 4 then print at X,Y, "INSURED: BET KEPT"
  if Res = 5 then print at X,Y, "BLACKJACK! PAYS 3 TO 2"
  if Res = 6 then print at X,Y, "SURRENDERED"
  if Res = 7 then print at X,Y, "WIN"
  return
end sub

sub BjMoney:
  fill 32 count 28 at 2,1
  print at 2,1, "WALLET $"
  NumU = Money
  print at 10,1, width$(NumU, 5)
  print at 17,1, "BET $"
  NumU = Pb[0]
  NumU = NumU + Pb[1]
  if Pn[0] = 0 then NumU = Bet
  print at 22,1, width$(NumU, 4)
  return
end sub

sub Message:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

' DrawCard: card Dk face up at Dx,Dy (4 x 3 tiles)
sub DrawCard:
  CardOf
  put char BjTEtl at Dx,Dy
  X = Dx + 1
  V = BjTRk0 + Dr
  if Ds < 2 then V = BjTRr0 + Dr
  put char V at X,Dy
  inc X
  V = BjTSs0 + Ds
  put char V at X,Dy
  inc X
  put char BjTEtr at X,Dy
  Np = Ds * 4
  Np += BjTPipa00
  Y = Dy + 1
  put char BjTEl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char BjTEr at X,Y
  inc Np
  inc Y
  put char BjTEbl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char BjTEbr at X,Y
  return
end sub

sub DrawBack:
  for Ja = 0 to 2
    Y = Dy + Ja
    V = Ja * 4
    V = V + BjTBack00
    for Ka = 0 to 3
      X = Dx + Ka
      put char V at X,Y
      inc V
    next
  next
  return
end sub

sub ClearCard:
  for Ja = 0 to 2
    Y = Dy + Ja
    fill BjTFelt count 4 at Dx,Y
  next
  return
end sub

' ===========================================================================
' Inner Spring's helpers (games/cp)

' RndSuit: card Dr (1-13) of a random suit, drawn at Dx, Dy
sub RndSuit:
  Rnd
  V = Rb & 3
  V = V * 13
  Dk = V + Dr
  dec Dk
  DrawCard
  return
end sub

sub IsSay:
  for Y = 12 to 20
    fill BjTFelt count 28 at 2,Y
  next
  return
end sub

sub IsMoney:
  fill BjTFelt count 28 at 2,20
  print at 2,20, "YOUR WALLET $"
  NumU = Money
  print at 15,20, width$(NumU, 5)
  return
end sub

' ===========================================================================
' Roulette's layout and wheel (games/rl)

' MoveChip: the chip in half-cell steps; the zero column, the row arrows
' and the boxes below have their own places
sub MoveChip:
  if Cy >= 6 then
    if Lf1 = 1 then
      if Cy = 6 then
        if Cx >= 8 then Cx = Cx - 8
      else
        if Cx >= 4 then Cx = Cx - 4
      end if
    end if
    if Rt1 = 1 then
      if Cy = 6 then
        if Cx < 16 then Cx = Cx + 8
      else
        if Cx < 20 then Cx = Cx + 4
      end if
    end if
    if Up1 = 1 then
      dec Cy
      if Cy = 5 then Cx = Cx & 254
    end if
    if Dn1 = 1 then
      if Cy = 6 then Cy = 7
    end if
    if Cy = 6 then Cx = Cx & 248
    if Cy = 7 then Cx = Cx & 252
    return
  end if
  if Lf1 = 1 then
    if Cx > -1 then dec Cx
  end if
  if Rt1 = 1 then
    if Cx < 23 then inc Cx
  end if
  if Up1 = 1 then
    if Cy > 0 then dec Cy
  end if
  if Dn1 = 1 then
    inc Cy
    if Cy = 6 then
      if Cx < 0 then Cx = 0
      if Cx > 22 then Cx = 22
      Cx = Cx & 248
    end if
  end if
  ' the zero column: 00 (top) or 0 (bottom)
  if Cx = -1 then
    if Cy = 5 then Cy = 4
    if Cy = 1 then Cy = 0
    if Cy = 3 then Cy = 4
    if Cy = 2 then
      if Up1 = 1 then
        Cy = 0
      else
        Cy = 4
      end if
    end if
  end if
  ' the row arrows: no bottom edge there
  if Cx = 23 then
    if Cy = 5 then Cy = 4
  end if
  return
end sub

' ChipAt: the chip's sprite where the bet is
sub ChipAt:
  if Cy = 6 then
    Xw = Cx
    Xw = Xw << 3
    Xw = Xw + 56
    Yw = 140
    goto ca_put
  end if
  if Cy = 7 then
    Xw = Cx
    Xw = Xw << 3
    Xw = Xw + 40
    Yw = 156
    goto ca_put
  end if
  if Cx = -1 then
    Xw = 16
  else
    Xw = Cx
    Xw = Xw << 3
    Xw = Xw + 32
  end if
  if Cx = 23 then Xw = 220
  Yw = Cy
  Yw = Yw << 2
  Yw = Yw + 108
ca_put:
  Sx = Xw
  Sy = Yw
  set sprite 1 to Sy, Sx, RlSChip, 11
  update sprites
  return
end sub

' Num: N1 = the number in layout column Ki (0-11), row Rr (0 top, 2 bottom)
sub Num:
  N1 = Ki * 3
  N1 = N1 + 3
  N1 = N1 - Rr
  return
end sub

sub SetBit:
  Bits[N1] = 1
  return
end sub

' BetName: the bet under the chip: its kind, odds, numbers, and its name
sub BetName:
  fill array Bits with 0
  Panel2
  if Cy = 6 then
    V = Cx >> 3
    Kind = 6 + V
    Od2 = 4
    N2 = V * 12
    for E = 1 to 12
      N1 = N2 + E
      SetBit
    next
    print at 15,9, "DOUZAINE"
    N1 = N2 + 1
    NumU = N1
    print at 15,10, width$(NumU, 2)
    print at 17,10, " TO"
    N1 = N2 + 12
    NumU = N1
    print at 21,10, width$(NumU, 2)
    goto bn_odds
  end if
  if Cy = 7 then
    V = Cx >> 2
    Kind = OutKind[V]
    Od2 = 2
    for N1 = 1 to 36
      W = 0
      if Kind = 9 then
        if N1 <= 18 then W = 1
      end if
      if Kind = 10 then
        if N1 >= 19 then W = 1
      end if
      if Kind = 13 then W = RlIsRed[N1]
      if Kind = 14 then
        W = RlIsRed[N1]
        W = W ^ 1
      end if
      if Kind = 15 then
        W = N1 & 1
        W = W ^ 1
      end if
      if Kind = 16 then W = N1 & 1
      Bits[N1] = W
    next
    if Kind = 9 then print at 15,9, "MANQUE 1-18"
    if Kind = 10 then print at 15,9, "PASSE 19-36"
    if Kind = 13 then print at 15,9, "ROUGE (RED)"
    if Kind = 14 then print at 15,9, "NOIR (BLACK)"
    if Kind = 15 then print at 15,9, "PAIR (EVEN)"
    if Kind = 16 then print at 15,9, "IMPAIR (ODD)"
    goto bn_odds
  end if
  if Cx = -1 then
    Kind = 1
    Od2 = 70
    print at 15,9, "PLEIN"
    if Cy = 0 then
      N1 = 37
      print at 15,10, "00"
    else
      N1 = 0
      print at 15,10, "0"
    end if
    SetBit
    goto bn_odds
  end if
  if Cx = 23 then
    V = Cy & 1
    if V = 0 then
      Kind = 11
      Od2 = 4
      Rr = Cy >> 1
      for Ki = 0 to 11
        Num
        SetBit
      next
      print at 15,9, "COLONNE"
      Ki = 0
      Num
      print at 15,10, "THE ROW OF"
      NumU = N1
      print at 26,10, width$(NumU, 1)
    else
      Kind = 12
      Od2 = 1
      Rr = Cy >> 1
      for Ki = 0 to 11
        Num
        SetBit
        inc Rr
        Num
        SetBit
        dec Rr
      next
      print at 15,9, "TWO ROWS"
    end if
    goto bn_odds
  end if
  Ki = Cx >> 1
  Rr = Cy >> 1
  V = Cx & 1
  W = Cy & 1
  if Cy = 5 then
    ' the bottom edge: three numbers (C) or six (D)
    N2 = Ki * 3
    if V = 0 then
      Kind = 3
      Od2 = 22
      for E = 1 to 3
        N1 = N2 + E
        SetBit
      next
      print at 15,9, "TRANSVERSALE"
      N1 = N2 + 1
      NumU = N1
      print at 15,10, width$(NumU, 2)
      N1 = N2 + 3
    else
      Kind = 4
      Od2 = 10
      for E = 1 to 6
        N1 = N2 + E
        SetBit
      next
      print at 15,9, "SIXAIN"
      N1 = N2 + 1
      NumU = N1
      print at 15,10, width$(NumU, 2)
      N1 = N2 + 6
    end if
    print at 17,10, " TO"
    NumU = N1
    print at 21,10, width$(NumU, 2)
    goto bn_odds
  end if
  if V = 0 then
    if W = 0 then
      Kind = 1
      Od2 = 70
      Num
      SetBit
      print at 15,9, "PLEIN"
      NumU = N1
      print at 15,10, width$(NumU, 2)
      goto bn_odds
    end if
    Kind = 2
    Od2 = 34
    Num
    SetBit
    N2 = N1
    inc Rr
    Num
    SetBit
    print at 15,9, "CHEVAL"
    goto bn_two
  end if
  if W = 0 then
    Kind = 2
    Od2 = 34
    Num
    SetBit
    N2 = N1
    inc Ki
    Num
    SetBit
    print at 15,9, "CHEVAL"
    goto bn_two
  end if
  ' a corner: four numbers
  Kind = 5
  Od2 = 16
  Num
  SetBit
  N2 = N1
  inc Rr
  Num
  SetBit
  inc Ki
  Num
  SetBit
  dec Rr
  Num
  SetBit
  print at 15,9, "CARRE"
  N1 = N2 + 3
  dec N2
bn_two:
  if N1 < N2 then
    V = N1
    N1 = N2
    N2 = V
  end if
  NumU = N2
  print at 15,10, width$(NumU, 2)
  print at 17,10, "-"
  NumU = N1
  print at 18,10, width$(NumU, 2)
bn_odds:
  if Od2 = 1 then
    print at 15,11, "PAYS 1 TO 2"
    return
  end if
  print at 15,11, "PAYS"
  V = Od2 >> 1
  NumU = V
  print at 20,11, width$(NumU, 2)
  print at 23,11, "TO 1"
  return
end sub

' SpinBall: the ball runs round the rim, slowing and falling toward the
' pockets, then hops along them into its own
sub SpinBall:
  Nr = 38
  RndN
  Result = V
  Target = RlNumAngle[Result]
  Rnd
  A0 = Rb
  HideMark
  play sound SndRoll
  for K = 0 to 127
    Frame1
    Uw = RlSpinA[K]
    V = Uw
    BallA = A0 + V
    BallR = RlSpinR[K]
    BallAt
  next
  V = Target - BallA
  Drw = V
  if Drw < 64 then Drw = Drw + 256
  Hop1 = 0
sb_hop:
  Frame1
  Uw = Drw >> 4
  if Uw = 0 then Uw = 1
  Stp = Uw
  BallA = BallA + Stp
  Drw = Drw - Uw
  inc Hop1
  V = Hop1 & 7
  if V = 0 then
    if Drw > 24 then play sound SndClack
  end if
  BallR = 33
  V = Hop1 & 4
  if V = 0 then BallR = 31
  if Drw < 24 then BallR = 31
  BallAt
  if Drw > 0 then goto sb_hop
  play sound SndDrop
  return
end sub

' BallAt: the ball's sprite at angle BallA, radius BallR round (56, 48)
sub BallAt:
  V = BallA + 64
  W = RlSinT[V]
  Xw = W
  Xw = Xw - 128
  Xw = Xw * BallR
  Xw = Xw / 127
  Xw = Xw + 54
  W = RlSinT[BallA]
  Yw = W
  Yw = Yw - 128
  Yw = Yw * BallR
  Yw = Yw / 127
  Yw = Yw + 45
  Sx = Xw
  Sy = Yw
  set sprite 0 to Sy, Sx, RlSBall, 15
  update sprites
  return
end sub

' RlSettle: the result, the marker on its number, the payout
sub RlSettle:
  Panel
  print at 15,6, "THE BALL"
  print at 15,7, "STOPPED ON"
  if Result = 37 then
    print at 15,8, "DOUBLE ZERO"
  else
    NumU = Result
    print at 15,8, width$(NumU, 2)
    if Result > 0 then
      V = RlIsRed[Result]
      if V = 1 then
        print at 18,8, "ROUGE"
      else
        print at 18,8, "NOIR"
      end if
    end if
  end if
  MarkResult
  V = Bits[Result]
  if V = 1 then
    ' the book: WI = INT(OD * N + .5), and the bet back
    Win = 0
    for E = 1 to Od2
      Win = Win + Stake
    next
    Win = Win + 1
    Win = Win >> 1
    print at 15,9, "YOU HAVE WON"
    NumU = Win
    print at 15,10, width$(NumU, 5)
    print at 15,11, "PLUS YOUR BET"
    Win = Win + Stake
    AddWin
    RlMoney
    if Od2 >= 16 then
      play sound SndBigWin
      Celebrate
      ChipAt
      BallAt
      MarkResult
    else
      play sound SndWin
    end if
  else
    print at 15,9, "SORRY, BUT YOU"
    print at 15,10, "LOST ON THAT"
    print at 15,11, "ROUND..."
    play sound SndLose
  end if
  for J = 1 to 150
    Frame1
    V = J & 8
    if V = 0 then
      set sprite 2 to 192, 0, 0, 0
    else
      set sprite 2 to Sy, Sx, RlSMark, 15
    end if
    update sprites
  next
  HideMark
  return
end sub

' MarkResult: where the winning number is on the layout (Sx, Sy)
sub MarkResult:
  if Result = 37 then
    Sx = 16
    Sy = 111
    return
  end if
  if Result = 0 then
    Sx = 16
    Sy = 127
    return
  end if
  V = Result - 1
  Ki = V / 3
  W = Ki * 3
  W = V - W
  Rr = 2 - W
  V = Ki << 4
  Sx = V + 32
  V = Rr << 3
  Sy = V + 111
  return
end sub

sub HideMark:
  set sprite 2 to 192, 0, 0, 0
  update sprites
  return
end sub

sub RlScreen:
  NewScreen
  ' the wheel: 12 x 12 tiles, codes from 128 in each of the two thirds
  V = 128
  for Y = 0 to 7
    for X = 1 to 12
      put char V at X,Y
      inc V
    next
  next
  V = 128
  for Y = 8 to 11
    for X = 1 to 12
      put char V at X,Y
      inc V
    next
  next
  ' the layout: 0 and 00, the three rows of twelve, the row arrows
  fill RlTLine count 28 at 2,13
  put char RlTDg0 at 2,14
  put char RlTDg0 at 3,14
  put char RlTCellg at 2,15
  put char RlTCellg at 3,15
  put char RlTCellg at 2,16
  put char RlTDg0 at 3,16
  for Ki = 0 to 11
    for Rr = 0 to 2
      Num
      X = Ki << 1
      X = X + 4
      Y = Rr + 14
      V = RlIsRed[N1]
      W = N1 / 10
      Cc = W * 10
      Cc = N1 - Cc
      if V = 1 then
        K = RlTCellr
        if W > 0 then K = RlTDr0 + W
        put char K at X,Y
        inc X
        K = RlTDr0 + Cc
        put char K at X,Y
      else
        K = RlTCellk
        if W > 0 then K = RlTDk0 + W
        put char K at X,Y
        inc X
        K = RlTDk0 + Cc
        put char K at X,Y
      end if
    next
  next
  put char RlTRowbox at 28,14
  put char RlTRowbox at 28,15
  put char RlTRowbox at 28,16
  fill RlTLine count 28 at 2,17
  print at 5,18, "1ST 12"
  print at 13,18, "2ND 12"
  print at 21,18, "3RD 12"
  fill RlTLine count 28 at 2,19
  print at 5,20, "LO"
  print at 8,20, "EVEN"
  put char RlTDred at 12,20
  print at 13,20, "RED"
  put char RlTDblk at 16,20
  print at 17,20, "BLK"
  print at 21,20, "ODD"
  print at 25,20, "HI"
  fill RlTLine count 28 at 2,21
  print at 2,22, "BUTTON: BET. 2ND: LOBBY"
  print at 15,1, "ROULETTE"
  RlMoney
  ShowScreen
  BallA = 0
  BallR = 40
  BallAt
  return
end sub

sub RlMoney:
  print at 15,3, "WALLET $"
  NumU = Money
  print at 23,3, width$(NumU, 5)
  return
end sub

' Panel: the croupier's lines (rows 6-11 of the right-hand side) cleared
sub Panel:
  for Y = 6 to 11
    fill 32 count 15 at 15,Y
  next
  return
end sub

sub Panel2:
  for Y = 9 to 11
    fill 32 count 15 at 15,Y
  next
  return
end sub

' ===========================================================================
' The fruit machine (games/lv)

' Spin: the book's three symbols, then the reels: all turn, and stop one
' after the other, each easing onto its symbol
sub Spin:
  for Rr = 0 to 2
    ' the book: A = INT(43 * RND)
    Nr = 43
    RndN
    W = 6
    if V < 31 then W = 5
    if V < 20 then W = 4
    if V < 12 then W = 3
    if V < 6 then W = 2
    if V < 2 then W = 1
    RSym[Rr] = W
    RSpd[Rr] = 12
    RStop[Rr] = 0
    RLeft[Rr] = 0
    V = Rr * 14
    V = V + 24
    RWhen[Rr] = V
  next
  C1 = RSym[0]
  C2 = RSym[1]
  C3 = RSym[2]
  play sound SndWhirr
  Tk = 0
sp_frame:
  Pace
  Lights
  inc Tk
  Moving = 0
  for Rr = 0 to 2
    V = RStop[Rr]
    if V = 0 then
      Moving = 1
      V = RWhen[Rr]
      if Tk = V then
        W = RSym[Rr]
        W = LvSlotOf[W]
        Uw = W
        Uw = Uw << 5
        Uw = Uw + 376
        V = RPos[Rr]
        U2 = V
        Uw = Uw - U2
        if Uw >= 192 then Uw = Uw - 192
        if Uw >= 192 then Uw = Uw - 192
        if Uw >= 192 then Uw = Uw - 192
        Uw = Uw + 192
        RLeft[Rr] = Uw
      end if
      V = RSpd[Rr]
      Uw = RLeft[Rr]
      if Uw > 0 then
        U2 = Uw >> 3
        if U2 < 2 then U2 = 2
        if U2 > 12 then U2 = 12
        if U2 > Uw then U2 = Uw
        V = U2
        Uw = Uw - U2
        RLeft[Rr] = Uw
        if Uw = 0 then
          RStop[Rr] = 1
          play sound SndClunk
        end if
      end if
      W = RPos[Rr]
      W = W + V
      if W >= 192 then W = W - 192
      RPos[Rr] = W
      DrawReel
    end if
  next
  if Moving = 1 then goto sp_frame
  return
end sub

' DrawReel: reel Rr at its place, column by column
sub DrawReel:
  V = RPos[Rr]
  Off16 = V
  V = Rr * 24
  Uw = V
  Uw = Uw + 184
  Uw = Uw << 3
  Addr = Uw + 2048
  copy LvReelPat0 + Off16 count 48 to vram.pattern + Addr
  copy LvReelCol0 + Off16 count 48 to vram.color + Addr
  Addr = Addr + 48
  copy LvReelPat1 + Off16 count 48 to vram.pattern + Addr
  copy LvReelCol1 + Off16 count 48 to vram.color + Addr
  Addr = Addr + 48
  copy LvReelPat2 + Off16 count 48 to vram.pattern + Addr
  copy LvReelCol2 + Off16 count 48 to vram.color + Addr
  Addr = Addr + 48
  copy LvReelPat3 + Off16 count 48 to vram.pattern + Addr
  copy LvReelCol3 + Off16 count 48 to vram.color + Addr
  return
end sub

' Judge: the book's payouts, in tenths of the bet (Mt)
sub Judge:
  Mt = 0
  fill 32 count 28 at 2,16
  fill 32 count 28 at 2,17
  V = C1 + C2
  V = V + C3
  if V = 3 then
    print at 2,16, "THREE BARS!!! JACKPOT STYLE!"
    Mt = 90
    goto jd_bonus
  end if
  if C1 = C2 then
    if C2 = C3 then
      if C1 = 2 then
        print at 2,16, "THREE BELLS!!!"
        Mt = 39
        goto jd_bonus
      end if
      ' three of a kind, but the listing leaves out the Apples
      if C2 <> 3 then
        print at 2,16, "THREE OF A KIND!"
        Mt = 35
        goto jd_bonus
      end if
    end if
  end if
  V = 0
  if C1 = C2 then V = 1
  if C1 = C3 then V = 1
  if C2 = C3 then V = 1
  if V = 1 then
    print at 2,16, ">> A PAIR <<"
    Mt = 7
  end if
jd_bonus:
  if C3 = 2 then
    print at 2,17, "A BELL AT THE END: A BONUS!"
    Mt = Mt + 6
    PauseShort
  end if
  if C1 = 3 then
    if C3 = 3 then
      print at 2,17, "AN APPLE AT EACH SIDE: GOOD!"
      Mt = Mt + 5
      PauseShort
    end if
  end if
  if C1 = 4 then
    if C2 = 2 then
      if C3 = 4 then
        print at 2,17, "CHERRY BELL CHERRY: MY FAV!"
        Mt = Mt + 4
        PauseShort
      end if
    end if
  end if
  ' WIN = INT(BET * WIN)
  Uw = Bet / 10
  U2 = Uw * 10
  U2 = Bet - U2
  Uw = Uw * Mt
  U2 = U2 * Mt
  U2 = U2 / 10
  Win = Uw + U2
  return
end sub

' Pay: the winnings counted out with coins (and the bet back), or the bet
' lost
sub Pay:
  if Win = 0 then
    if Mt = 0 then print at 2,16, "NO LUCK..."
    print at 2,17, "AND YOU'VE LOST $"
    NumU = Bet
    print at 19,17, width$(NumU, 4)
    play sound SndLose
    PauseShort
    return
  end if
  if Mt >= 35 then
    play sound SndBigWin
    Flashy = 1
  else
    if Mt >= 13 then
      play sound SndWin
    else
      play sound SndPair
    end if
  end if
  print at 2,17, "AND YOU'VE WON $"
  NumU = Win
  print at 18,17, width$(NumU, 4)
  CoinsStart
  Shown = Money
  Win = Win + Bet
  AddWin
  Step1 = Win / 24
  if Step1 = 0 then Step1 = 1
py_frame:
  Pace
  Lights
  Coins
  if Shown < Money then
    Uw = Money - Shown
    if Uw > Step1 then
      Shown = Shown + Step1
    else
      Shown = Money
    end if
    NumU = Shown
    print at 8,18, width$(NumU, 5)
    V = Tick & 3
    if V = 0 then play sound SndCoin
    goto py_frame
  end if
  for J = 1 to 40
    Pace
    Lights
    Coins
  next
  Flashy = 0
  CoinsAway
  CashLine
  if Mt >= 35 then Celebrate
  return
end sub

' Handle: the handle pulled down and let go
sub Handle:
  play sound SndLever
  for J = 0 to 2
    Lv = J
    HandleAt
    update sprites
    Pace
  next
  for J = 1 to 4
    Pace
  next
  Lv = 1
  HandleAt
  update sprites
  Pace
  Lv = 0
  HandleAt
  update sprites
  return
end sub

' HandleAt: the handle's arm and knob, up (0), half way (1) or down (2)
sub HandleAt:
  if Lv = 0 then
    set sprite 0 to 55, 212, LvSArm, 14
    set sprite 1 to 31, 212, LvSKnob, 8
  end if
  if Lv = 1 then
    set sprite 0 to 55, 212, LvSArmh, 14
    set sprite 1 to 47, 212, LvSKnob, 8
  end if
  if Lv = 2 then
    set sprite 0 to 87, 212, LvSArm, 14
    set sprite 1 to 103, 212, LvSKnob, 8
  end if
  return
end sub

sub CoinsStart:
  for Ci = 0 to 3
    V = Ci * 18
    V = V + 92
    CoinX[Ci] = V
    V = Ci * 12
    V = 120 - V
    CoinY[Ci] = V
    CoinV[Ci] = 0
    CoinF[Ci] = Ci
  next
  return
end sub

sub Coins:
  for Ci = 0 to 3
    Y = CoinY[Ci]
    Cv = CoinV[Ci]
    if Cv < 0 then
      V = 0 - Cv
      Y = Y - V
    else
      V = Cv
      Y = Y + V
    end if
    if Y >= 148 then
      Y = 148
      if Cv > 2 then
        Cv = Cv >> 1
        Cv = 0 - Cv
      else
        Cv = 0
      end if
    else
      if Cv < 8 then Cv = Cv + 1
    end if
    CoinV[Ci] = Cv
    CoinY[Ci] = Y
    W = CoinF[Ci]
    inc W
    if W >= 12 then W = 0
    CoinF[Ci] = W
    W = W >> 2
    K = LvSCoin0
    if W = 1 then K = LvSCoin1
    if W = 2 then K = LvSCoin2
    X = CoinX[Ci]
    V = Ci + 2
    set sprite V to Y, X, K, 11
  next
  update sprites
  return
end sub

sub CoinsAway:
  for Ci = 2 to 5
    set sprite Ci to 192, 0, 0, 0
  next
  update sprites
  return
end sub

' Lights: the bulbs chase round (every fourth pass), or all flash on a big win
sub Lights:
  V = Passes & 3
  if V <> 0 then return
  inc Phase
  if Phase >= 3 then Phase = 0
  for Bi = 0 to 2
    V = Phase + Bi
    if V >= 3 then V = V - 3
    if Flashy = 1 then
      V = Passes & 4
      W = 15
      if V = 0 then W = 11
    else
      W = BulbSeq[V]
    end if
    Bc = W << 4
    Bc = Bc | 6
    V = Bi + LvTBulb0
    Uw = V
    Uw = Uw << 3
    Uw = Uw + 1
    fill Bc count 6 to vram.color + Uw
    Uw = Uw + 2048
    fill Bc count 6 to vram.color + Uw
    Uw = Uw + 2048
    fill Bc count 6 to vram.color + Uw
  next
  return
end sub

sub Cabinet:
  NewScreen
  ' the bulbs: the round shape in every third
  for Bi = 0 to 2
    V = Bi + LvTBulb0
    Uw = V
    Uw = Uw << 3
    copy BulbPat count 8 to vram.pattern + Uw
    U2 = Uw + 2048
    copy BulbPat count 8 to vram.pattern + U2
    U2 = U2 + 2048
    copy BulbPat count 8 to vram.pattern + U2
  next
  for X = 0 to 31
    V = X % 3
    W = V + LvTBulb0
    put char W at X,0
    put char W at X,2
    put char W at X,23
  next
  for Y = 3 to 22
    V = Y % 3
    W = V + LvTBulb0
    put char W at 0,Y
    put char W at 31,Y
  next
  print at 9,1, "LAS VEGAS HIGH"
  for Rr = 0 to 2
    V = Rr << 3
    X = V + 4
    put char LvTFtl at X,8
    put char LvTFbl at X,15
    for Y = 9 to 14
      put char LvTFl at X,Y
    next
    Rv = Rr * 24
    Rv = Rv + 184
    for Rc = 0 to 3
      inc X
      put char LvTFt at X,8
      put char LvTFb at X,15
      for Y = 9 to 14
        put char Rv at X,Y
        inc Rv
      next
    next
    inc X
    put char LvTFtr at X,8
    put char LvTFbr at X,15
    for Y = 9 to 14
      put char LvTFr at X,Y
    next
  next
  put char LvTArl at 4,11
  put char LvTArl at 4,12
  put char LvTArr at 25,11
  put char LvTArr at 25,12
  put char LvTLbox at 28,11
  put char LvTLbox at 28,12
  for X = 6 to 25
    put char LvTTray at X,21
  next
  for Rr = 0 to 2
    DrawReel
  next
  CashLine
  ShowScreen
  Lv = 0
  HandleAt
  update sprites
  return
end sub

sub CashLine:
  print at 2,18, "CASH $"
  NumU = Money
  print at 8,18, width$(NumU, 5)
  print at 17,18, "BET $"
  return
end sub

' Chatter: the book's words for how the night is going
sub Chatter:
  fill 32 count 29 at 1,4
  fill 32 count 29 at 1,5
  if Money < 300 then
    print at 2,4, "HI THERE, GAMBLER!"
  else
    if Money < 600 then
      print at 2,4, "YOU'RE DOING WELL TONIGHT!"
    else
      if Money < 900 then
        print at 2,4, "LADY LUCK HAS CERTAINLY"
        print at 2,5, "SMILED ON YOU!"
      else
        if Money < 1200 then
          print at 2,4, "THE FATES ARE BEING"
          print at 2,5, "EXTREMELY KIND"
        else
          print at 2,4, "IT IS SO GOOD TO SEE AN"
          print at 2,5, "EXPERT AT WORK"
        end if
      end if
    end if
  end if
  return
end sub

' Pace: a steady 30 passes a second (see games/ar)
sub Pace:
  call asm CaLate
  if Late = 0 then Frame1
  Frame1
  inc Passes
  return
end sub

sub PauseShort:
  for J = 1 to 15
    Pace
    Lights
  next
  return
end sub

' ===========================================================================
' The dice (games/dg)

' ChooseBox: the chip over under / 7 / over; the button picks (Res 0), the
' second button leaves (Res 1)
sub ChooseBox:
  WasBtn = 1
  WasBtn2 = 1
  Stage = 5
cb_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Choice > 0 then dec Choice
    end if
    if Rt1 = 1 then
      if Choice < 2 then inc Choice
    end if
    play sound SndClick
  end if
  X = Choice * 72
  X = X + 36
  set sprite 3 to 110, X, DgSChip, 11
  update sprites
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto cb_loop
  Stage = 0
  play sound SndChip
  Res = 0
  return
end sub

' Puck: SEVEN/ELEVEN's puck on the target number's box, or off
sub Puck:
  if Point = 0 then
    set sprite 4 to 192, 0, 0, 0
  else
    for K = 0 to 5
      V = PointNum[K]
      if V = Point then
        X = K << 5
        X = X + 36
      end if
    next
    set sprite 4 to 99, X, DgSPuck, 15
  end if
  update sprites
  return
end sub

' Throw: two dice thrown from the right across the felt, bouncing and
' tumbling, stopping side by side; Face[] and Total are the book's dice
sub Throw:
  set sprite 3 to 192, 0, 0, 0
  Total = 0
  for Di = 0 to 1
    Nr = 6
    RndN
    V = V + 1
    Face[Di] = V
    Total = Total + V
    V = Di * 48
    V = V + 88
    DiX[Di] = V
    V = Di << 3
    V = V + 56
    DiY[Di] = V
  next
  play sound SndRattle
  for T = 0 to 40
    Frame1
    E = Ease[T]
    H = Hop[T]
    if H = 0 then
      if T > 0 then
        if T < 30 then play sound SndBounce
      end if
    end if
    for Di = 0 to 1
      W = DiX[Di]
      V = 232 - W
      Uw = V
      Uw = Uw * E
      Uw = Uw >> 8
      V = Uw
      X = 232 - V
      V = DiY[Di]
      Y = V - H
      Pt = DgSTumble1
      V = T & 4
      if V > 0 then Pt = DgSTumble2
      if T >= 28 then
        Rnd
        V = Rb & 7
        if V < 6 then
          V = V << 2
          Pt = DgSDie1 + V
        end if
      end if
      if T = 40 then
        V = Face[Di]
        V = V - 1
        V = V << 2
        Pt = DgSDie1 + V
      end if
      set sprite Di to Y, X, Pt, 15
    next
    update sprites
  next
  return
end sub

sub HideDice:
  set sprite 0 to 192, 0, 0, 0
  set sprite 1 to 192, 0, 0, 0
  update sprites
  return
end sub

sub Tally:
  print at 2,18, "WINS"
  NumU = Wins
  print at 7,18, width$(NumU, 3)
  print at 12,18, "LOSSES"
  NumU = Losses
  print at 19,18, width$(NumU, 3)
  return
end sub

sub DiceMoney:
  print at 18,1, "$"
  NumU = Money
  print at 19,1, width$(NumU, 5)
  return
end sub

' Say: the croupier's two lines cleared
sub Say:
  fill 32 count 28 at 2,3
  fill 32 count 28 at 2,4
  return
end sub

sub DiceScreen:
  NewScreen
  fill DgTRailt count 32 at 0,0
  fill DgTRailb count 32 at 0,23
  fill DgTHline count 28 at 2,12
  fill DgTHline count 28 at 2,17
  if Game = 1 then
    print at 2,1, "SEVEN/ELEVEN"
    for K = 0 to 5
      X = K << 2
      X = X + 4
      for Y = 13 to 16
        put char DgTVline at X,Y
      next
      inc X
      V = PointNum[K]
      NumU = V
      print at X,15, width$(NumU, 2)
    next
    for Y = 13 to 16
      put char DgTVline at 28,Y
    next
    print at 2,19, "7 OR 11 FIRST WINS, 2,3,12"
    print at 2,20, "LOSE. ELSE ROLL THAT TARGET"
    print at 2,21, "AGAIN BEFORE 7 OR 11. 1 TO 1"
  else
    print at 2,1, "UNDER 'N' OVER"
    for K = 0 to 3
      X = K * 9
      X = X + 2
      for Y = 13 to 16
        put char DgTVline at X,Y
      next
    next
    print at 3,14, "UNDER 7"
    print at 15,14, "7"
    print at 22,14, "OVER 7"
    print at 3,15, "PAYS 1:1"
    print at 12,15, "PAYS 4:1"
    print at 21,15, "PAYS 1:1"
  end if
  print at 2,22, "2ND BUTTON: LOBBY"
  DiceMoney
  ShowScreen
  return
end sub

' ===========================================================================
' Screens and helpers

' LobbyFrame: the carpet, the neon rope round the room's middle
sub LobbyFrame:
  backdrop black
  for Y = 0 to 23
    for X = 0 to 31
      V = X + Y
      V = V & 1
      W = BjTCarpet
      if V = 1 then W = BjTCarpet2
      put char W at X,Y
    next
  next
  fill BjTNeon count 28 at 2,2
  fill BjTNeon count 28 at 2,21
  for Y = 3 to 20
    put char BjTNeon at 2,Y
    put char BjTNeon at 29,Y
    fill 32 count 26 at 3,Y
  next
  fill BjTRope count 26 at 3,6
  return
end sub

sub RulesPage:
  NewScreen
  LobbyFrame
  print at 9,4, "HOW TO PLAY"
  print at 4,7, "AT EVERY TABLE: UP, DOWN"
  print at 4,8, "BET $1; LEFT, RIGHT $10."
  print at 4,9, "BUTTON: PLAY. 2ND BUTTON:"
  print at 4,10, "BACK TO THE LOBBY."
  print at 4,12, "BLACKJACK: BEAT THE"
  print at 4,13, "DEALER, NOT OVER 21."
  print at 4,14, "ROULETTE: THE CHIP ON THE"
  print at 4,15, "LAYOUT IS YOUR BET."
  print at 4,16, "FRUIT MACHINE: PULL!"
  print at 4,17, "DICE: 7 OR 11, OR UNDER"
  print at 4,18, "'N' OVER 7. INNER SPRING:"
  print at 4,19, "WILL MY CARD LIE BETWEEN?"
  ShowScreen
  WaitPress
  return
end sub

sub CreditsPage:
  NewScreen
  LobbyFrame
  print at 10,4, "THE CASINO"
  print at 4,7, "BLACKJACK: JOHN HAMILTON,"
  print at 4,8, "COMPUTE! MARCH 1988."
  print at 4,10, "ROULETTE, LAS VEGAS HIGH,"
  print at 4,11, "SEVEN/ELEVEN, UNDER 'N'"
  print at 4,12, "OVER, INNER SPRING: TIM"
  print at 4,13, "HARTNELL'S GIANT BOOK OF"
  print at 4,14, "COMPUTER GAMES (1984)."
  print at 4,16, "MUSIC: LUCKY LIGHTS."
  print at 4,18, "COLECOVISION VERSION BY"
  print at 4,19, "AMY BIENVENU, 2026."
  ShowScreen
  WaitPress
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Uw = Uw * Nr
  Uw = Uw >> 8
  V = Uw
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub Pause:
  for J = 1 to 30
    Frame1
  next
  return
end sub

' WaitPress: the button (the second button does it too)
sub WaitPress:
  WasBtn = 1
  WasBtn2 = 1
  Stage = 3
wp_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then goto wp_out
  if Press = 0 then goto wp_loop
wp_out:
  Stage = 0
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 3
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' NewScreen: the table Tbl's tile set (0 cards and lobby, 1 roulette, 2
' fruit machine, 3 dice) and sprites
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  call asm CaShared
  HideSprites
  sprites simple
  fill mode 2 text color with $F0
  if Tbl = 0 then
    decompress zx0 BjTilePat to vram.pattern + 1024
    decompress zx0 BjTileCol to vram.color + 1024
    decompress zx0 BjTilePat to vram.pattern + 3072
    decompress zx0 BjTileCol to vram.color + 3072
    decompress zx0 BjTilePat to vram.pattern + 5120
    decompress zx0 BjTileCol to vram.color + 5120
    decompress zx0 BjSpritePat to vram.spr_pat
    backdrop dark green
  end if
  if Tbl = 1 then
    ' the wheel: top third codes 128-223, middle third codes 128-175;
    ' the layout's tiles from code 200 in the lower two thirds
    call asm CaThirds
    decompress zx0 RlWheel0Pat to vram.pattern + 1024
    decompress zx0 RlWheel0Col to vram.color + 1024
    decompress zx0 RlWheel1Pat to vram.pattern + 3072
    decompress zx0 RlWheel1Col to vram.color + 3072
    decompress zx0 RlTabPat to vram.pattern + 3648
    decompress zx0 RlTabCol to vram.color + 3648
    decompress zx0 RlTabPat to vram.pattern + 5696
    decompress zx0 RlTabCol to vram.color + 5696
    decompress zx0 RlSpritePat to vram.spr_pat
    backdrop dark green
  end if
  if Tbl = 2 then
    call asm CaThirds
    decompress zx0 LvTilePat to vram.pattern + 1024
    decompress zx0 LvTileCol to vram.color + 1024
    decompress zx0 LvTilePat to vram.pattern + 3072
    decompress zx0 LvTileCol to vram.color + 3072
    decompress zx0 LvTilePat to vram.pattern + 5120
    decompress zx0 LvTileCol to vram.color + 5120
    decompress zx0 LvSpritePat to vram.spr_pat
    sprites double
    backdrop dark red
  end if
  if Tbl = 3 then
    decompress zx0 DgTilePat to vram.pattern + 1024
    decompress zx0 DgTileCol to vram.color + 1024
    decompress zx0 DgTilePat to vram.pattern + 3072
    decompress zx0 DgTileCol to vram.color + 3072
    decompress zx0 DgTilePat to vram.pattern + 5120
    decompress zx0 DgTileCol to vram.color + 5120
    decompress zx0 DgSpritePat to vram.spr_pat
    sprites double
    backdrop dark green
  end if
  copy Spark count 32 to vram.spr_pat + 480
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

