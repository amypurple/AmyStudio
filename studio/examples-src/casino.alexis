data Spark bytes $00,$00,$01,$01,$11,$09,$07,$3F,$07,$09,$11,$01,$01,$00,$00,$00,$00,$00,$00,$00,$10,$20,$C0,$F8,$C0,$20,$10,$00,$00,$00,$00,$00

asm {
; CaLate: Late = 1 when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
CaLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret

; CaThirds: VDP register 3 = $FF, a colour table for each third (the
; wheel and the reels); CaShared: back to Amy's $9F
CaThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER
CaShared:
    ld b,3
    ld c,$9F
    jp WRITE_REGISTER

