' the font has no dollar sign: one is drawn over '$'
data Dollar bytes $10,$7C,$90,$7C,$12,$7C,$10,$00
' Las Vegas High: bulb colours (dim, yellow, white), a round bulb
data BulbSeq bytes 6, 11, 15
data BulbPat bytes $00,$3C,$7E,$7E,$7E,$7E,$3C,$00
' Roulette: the outside boxes' kinds (low, even, red, black, odd, high)
data OutKind bytes 9, 15, 13, 14, 16, 10
' the dice: the throw (40 frames): how far along the felt and how high
data Ease bytes 0,13,25,37,48,59,69,79,88,97,106,114,122,129,136,143,149,155,160,166,171,175,180,184,188,191,195,198,201,204,206,209,211,213,215,217,219,220,221,222,223
