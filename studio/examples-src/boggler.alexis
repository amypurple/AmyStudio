cartridge "BOGGLER/GARY BRAUN, COMPUTE!/1983"

' BOGGLER
' The game by Gary Braun from COMPUTE!, March 1983 (pages 78-89, for the
' VIC-20, with versions for the Atari, the TRS-80 Color Computer, the
' Apple II and the TI-99/4A), for the ColecoVision in Amy by Amy
' Bienvenu. Ported by Claude (an AI made by Anthropic) for Amy Studio,
' 2026.
'
' Source: Program 1, the VIC-20 version, transcribed in
' orig/boggler-vic.bas from the scans beside it. The other versions were
' read for the intent only (the Atari's: each player has a joystick).
'
' The game: two players, black and white, put stones on the crossings of
' a 17 x 17 board. White's first stone is put in the middle for it, so
' black plays first. Capture a pair: put a stone so that two of the
' other player's stones lie between it and another of yours, in a line
' (across, down or diagonally); the pair goes to your side of the board
' (black's on the left, white's on the right). Five pairs, or five of your
' stones in a row, win.
'
' Controls: white is controller 1, black controller 2 (the Atari's
' sticks; the VIC had one joystick, passed between the players). The
' stick moves your cursor (the cyan crossing or stone; off one side of
' the board it comes back on the other), the button puts your stone. A
' new turn starts the cursor where that player last played. On the pages
' between games, either button. Keypad not used.
'
' The VIC-20's screen (22 x 23) is kept cell for cell, at columns 5-26 and
' rows 1-20: a VIC cell at column c, row r is the name table's
' (r + 1) * 32 + c + 5, so the listing's moves of 22, 21 and 23 cells are
' 32, 31 and 33 here (and its wraps of 17, 374, 391 and 357 are 17, 544,
' 561 and 527). The game reads the board from the screen, as the listing
' PEEKs it: each tile stands for a VIC character in a colour (art.py).
' Labels such as l200 are the listing's line numbers.
'
' Kept as the listing has them: the stones black captures sit on the left
' in blue (line 2001 POKEs the stone but never its colour, so it keeps the
' blue of the line it replaced); line 1840 checks the first stone twice;
' a capture needs exactly two stones (a third of the other colour, then
' yours); the five in a row are counted in a window of ten cells across
' the new stone; putting a stone on a stone buzzes and freezes the game a
' moment.
'
' Liberties taken:
' - Each player has a controller (as the Atari's); the stick moves the
'   cursor a cell, then a cell every 6 frames while held; the button must
'   be let go between two stones (the VIC acted on it while held).
' - The win's page waits for the button to be let go first (on the VIC
'   the button still down from the winning stone started a new game at
'   once) and reads "PRESS FIRE TO PLAY AGAIN" on one row, not two (row
'   23 is too near the screen's edge); a short flourish sounds the win.
' - The instructions' stones are drawn: white, black, black, white OR
'   black, white, white, black.
' - A credits page with an original tune (Stone by Stone) played once.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from 128; no
' sprites; the frame loop is protected from the NMI and every screen is
' drawn with the NMI off after a wait.

const TCross = 128
const TCrossc = 129
const TBallk = 130
const TBallw = 131
const TBallc = 132
const TBalln = 133
const TEleft = 134
const TEright = 135
const TEtop = 136
const TEbot = 137
const TCtl = 138
const TCtr = 139
const TCbl = 140
const TCbr = 141
const TLine = 142
const TBoxk = 143
const TBoxw = 144
const TIwhite = 145
const TIblack = 146
const TRsp = 147
const TRbang = 148
const TRE = 149
const TRH = 150
const TRI = 151
const TRN = 152
const TRS = 153
const TRT = 154
const TRW = 155
const TRA = 156
const TRB = 157
const TRC = 158
const TRK = 159
const TRL = 160
const NTiles8 = 264
const SprBytes = 0
const SndHush = 1
const SndBuzz = 2
const SndWin = 3
const SndTuneA = 4
const SndTuneB = 5

' --- the listing's variables ----------------------------------------------
' CL whose turn (0 black, 1 white), OP the other, RS the colour under the
' cursor, CR the cursor, T2 its next place, BL WH each player's last
' stone, BC WC the last place of each side's captured stones, W the
' stick's direction (8 none), FR the button, CN the stones in a row
u8 CL = 0
u8 OP = 1
u8 RS = 1
u16 CR = 0
u16 T2 = 0
u16 BL = 0
u16 WH = 0
u16 BC = 0
u16 WC = 0
u8 W = 8
u8 FR = 0
u8 CN = 0
u16 O1 = 0
u16 O2 = 0
u16 O3 = 0
' for the test bot: Ph 0 credits, 1 instructions, 2 play, 3 won; Won
' the winner + 1 (0 none); Nmv the stones put; Nbz the buzzes
u8 Ph = 0
u8 Won = 0
u16 Nmv = 0
u8 Nbz = 0

u8 Fp = 0
u8 Rep = 0
u8 Who = 0
u8 Code = 0
u8 Colr = 0
u8 Tl = 0
u8 V = 0
u8 J8 = 0
u8 K8 = 0
u8 Tick = 0
u16 P16 = 0
u16 W16 = 0

  tile screen
  set sound table BgSoundTable areas 4
  nmi off
  screen on

credits:
  CreditsPage
  ' 3: GOSUB 7000, the instructions, the first time only
  Instructions

l6:
  ' 6-124: the board on the light green screen (POKE 36879,221)
  Ph = 2
  Won = 0
  Nmv = 0
  NewScreen($43)
  backdrop light green
  ' 10-47: the corners, the edges (rows 1 and 19, columns 1 and 19)
  vpoke vram.name + 70, TCtl
  vpoke vram.name + 88, TCtr
  vpoke vram.name + 646, TCbl
  vpoke vram.name + 664, TCbr
  for J8 = 1 to 17
    W16 = J8
    W16 = W16 + 70
    vpoke vram.name + W16, TEtop
    W16 = W16 + 576
    vpoke vram.name + W16, TEbot
    W16 = J8
    W16 = W16 << 5
    W16 = W16 + 70
    vpoke vram.name + W16, TEleft
    W16 = W16 + 18
    vpoke vram.name + W16, TEright
  next
  ' 50-60: the crossings
  for J8 = 1 to 17
    W16 = J8
    W16 = W16 << 5
    W16 = W16 + 70
    for K8 = 1 to 17
      inc W16
      vpoke vram.name + W16, TCross
    next
  next
  ' 9, 115-124: whose turn, the cursor in the middle on white's stone,
  ' the empty places for the captured stones
  CL = 0
  RS = 1
  CR = 367
  vpoke vram.name + CR, TBallw
  BL = CR
  WH = CR
  BC = 69
  WC = 89
  for J8 = 1 to 10
    W16 = J8
    W16 = W16 << 5
    P16 = W16 + WC
    vpoke vram.name + P16, TLine
    P16 = W16 + BC
    vpoke vram.name + P16, TLine
  next
  Box
  ShowScreen
  Fp = 1
  Rep = 0

l200:
  Frame1
  ' 200: the player's own stick (black controller 2, white 1)
  Who = 2 - CL
  ReadStick
  Box
  ' 205: the button (once let go) puts the stone
  if FR = 0 then Fp = 0
  if FR = 1 then
    if Fp = 0 then
      Fp = 1
      goto l500
    end if
  end if
  ' 210: no direction, nothing to do
  if W = 8 then
    Rep = 0
    goto l200
  end if
  if Rep > 0 then
    dec Rep
    goto l200
  end if
  Rep = 6
  ' 220-290: the next place
  T2 = CR
  if W = 0 then T2 = T2 - 32
  if W = 1 then T2 = T2 - 31
  if W = 2 then T2 = T2 + 1
  if W = 3 then T2 = T2 + 33
  if W = 4 then T2 = T2 + 32
  if W = 5 then T2 = T2 + 31
  if W = 6 then T2 = T2 - 1
  if W = 7 then T2 = T2 - 33
  ' 8000-8060: off the board, back on the other side
  CodeAt(T2)
  if Code = 107 then T2 = T2 + 17
  CodeAt(T2)
  if Code = 115 then T2 = T2 - 17
  CodeAt(T2)
  if Code = 113 then T2 = T2 - 544
  CodeAt(T2)
  if Code = 114 then T2 = T2 + 544
  CodeAt(T2)
  if Code = 85 then T2 = T2 + 561
  CodeAt(T2)
  if Code = 75 then T2 = T2 - 561
  CodeAt(T2)
  if Code = 73 then T2 = T2 + 527
  CodeAt(T2)
  if Code = 74 then T2 = T2 - 527
  ' 306-340: the cursor moves (the old place gets its colour back)
  CodeAt(CR)
  if Code = 91 then RS = 1
  PokeCol(CR, RS)
  CodeAt(T2)
  RS = Colr
l320:
  PokeCol(T2, 3)
  CR = T2
  goto l200

l500:
  ' 500-504: a stone there already: a buzz
  CodeAt(CR)
  if Code <> 91 then
    play sound SndBuzz
    inc Nbz
    Pause(13)
    goto l200
  end if
  if CL = 1 then goto l530
  ' 511-529: black's stone, then white's turn from its last stone
  vpoke vram.name + CR, TBallk
  inc Nmv
  Check
  if Won > 0 then goto l4500
  BL = CR
  T2 = WH
  RS = 1
  CL = 1
  goto l320
l530:
  ' 530-560: white's stone, then black's turn
  vpoke vram.name + CR, TBallw
  inc Nmv
  WH = CR
  RS = 0
  T2 = BL
  Check
  if Won > 0 then goto l4500
  CL = 0
  goto l320

l4500:
  ' 4500-4540: the winner (in reverse), then the button for a new game
  Ph = 3
  play sound SndWin
  if CL = 1 then
    copy RWhite count 13 to vram.name + 679
    vpoke vram.name + 692, TRsp
  else
    copy RBlack count 12 to vram.name + 679
  end if
  print at 4,22, "PRESS FIRE TO PLAY AGAIN"
  Who = 0
  WaitLetGo
l4520:
  Frame1
  ReadStick
  if FR = 0 then goto l4520
  goto l6

' Check (1000-1780): the stone just put at CR: captures in the eight
' directions, then five in a row in the four lines
sub Check:
  OP = 1 - CL
  O1 = 65536 - 32
  Cap
  if Won > 0 then return
  O1 = 65536 - 31
  Cap
  if Won > 0 then return
  O1 = 1
  Cap
  if Won > 0 then return
  O1 = 33
  Cap
  if Won > 0 then return
  O1 = 32
  Cap
  if Won > 0 then return
  O1 = 31
  Cap
  if Won > 0 then return
  O1 = 65536 - 1
  Cap
  if Won > 0 then return
  O1 = 65536 - 33
  Cap
  if Won > 0 then return
  O1 = 65536 - 128
  O2 = 32
  Five
  if Won > 0 then return
  O1 = 65536 - 124
  O2 = 31
  Five
  if Won > 0 then return
  O1 = -4
  O2 = 1
  Five
  if Won > 0 then return
  O1 = 65536 - 132
  O2 = 33
  Five
  return
end sub

' Cap (1800-2200): two of OP's stones at CR+O1, CR+2*O1, then one of CL's
' at CR+3*O1: the pair goes to CL's side
sub Cap:
  O2 = O1 + O1
  O3 = O2 + O1
  P16 = CR + O1
  StoneAt(P16)
  if Colr <> OP then return
  P16 = CR + O2
  StoneAt(P16)
  if Colr <> OP then return
  P16 = CR + O3
  StoneAt(P16)
  if Colr <> CL then return
  if CL = 1 then
    ' 2100-2110: white's side (the stones black, line 2102)
    WC = WC + 32
    vpoke vram.name + WC, TBallk
    P16 = CR + O1
    vpoke vram.name + P16, TCross
    WC = WC + 32
    vpoke vram.name + WC, TBallk
    P16 = CR + O2
    vpoke vram.name + P16, TCross
    if WC > 377 then Won = 2
  else
    ' 2001-2010: black's side (the stone keeps the line's blue)
    BC = BC + 32
    vpoke vram.name + BC, TBalln
    P16 = CR + O1
    vpoke vram.name + P16, TCross
    BC = BC + 32
    vpoke vram.name + BC, TBalln
    P16 = CR + O2
    vpoke vram.name + P16, TCross
    if BC > 357 then Won = 1
  end if
  return
end sub

' Five (3000-4000): ten cells from CR+O1, a step of O2: five of CL's in a
' row win
sub Five:
  CN = 0
  P16 = CR + O1
  for K8 = 1 to 10
    StoneAt(P16)
    if Colr = CL then
      inc CN
    else
      CN = 0
    end if
    if CN = 5 then Won = CL + 1
    P16 = P16 + O2
  next
  return
end sub

' CodeAt: Code the VIC character at name table place N, Colr its colour
sub CodeAt(u16 N):
  Code = 32
  Colr = 1
  if N >= 768 then return
  vpeek vram.name + N into Tl
  if Tl < 128 then
    Code = Tl
    return
  end if
  if Tl > TBoxw then return
  V = Tl - 128
  Code = TCode[V]
  Colr = TColr[V]
  return
end sub

' StoneAt: Colr the colour of the stone at N (255 when no stone there)
sub StoneAt(u16 N):
  CodeAt(N)
  if Code <> 81 then Colr = 255
  return
end sub

' PokeCol: POKE colour memory: the character at N in colour Pc
sub PokeCol(u16 N, u8 Pc):
  CodeAt(N)
  Tl = 0
  if Code = 91 then
    Tl = TCross
    if Pc = 3 then Tl = TCrossc
  end if
  if Code = 81 then
    Tl = TBalln
    if Pc = 0 then Tl = TBallk
    if Pc = 1 then Tl = TBallw
    if Pc = 3 then Tl = TBallc
  end if
  if Tl > 0 then vpoke vram.name + N, Tl
  return
end sub

' Box (202): the turn box, black or white
sub Box:
  if CL = 0 then
    vpoke vram.name + 47, TBoxk
  else
    vpoke vram.name + 47, TBoxw
  end if
  return
end sub

' ReadStick (9000-9040): W the direction (0 up, then clockwise; 8 none),
' FR the button, of controller Who (0: either)
sub ReadStick:
  V = 0
  FR = 0
  if Who <> 2 then
    if joypad(1).up then V = V | 1
    if joypad(1).down then V = V | 2
    if joypad(1).left then V = V | 4
    if joypad(1).right then V = V | 8
    if joypad(1).fire then FR = 1
  end if
  if Who <> 1 then
    if joypad(2).up then V = V | 1
    if joypad(2).down then V = V | 2
    if joypad(2).left then V = V | 4
    if joypad(2).right then V = V | 8
    if joypad(2).fire then FR = 1
  end if
  W = WTab[V]
  return
end sub

' WaitLetGo: until the sticks and the buttons are let go
sub WaitLetGo:
wl_loop:
  Frame1
  ReadStick
  if W <> 8 then goto wl_loop
  if FR = 1 then goto wl_loop
  return
end sub

' Pause: Wn frames (the listing's empty FOR loops)
sub Pause(u8 Wn):
  for J8 = 1 to Wn
    Frame1
  next
  return
end sub

' Instructions (7000-7999), the VIC's blue on white; any push goes on
sub Instructions:
  Ph = 1
  NewScreen($4F)
  backdrop white
  print at 5,1, " * OBJECT OF GAME *"
  print at 5,3, " 1 CAPTURE FIVE PAIRS"
  print at 5,4, "   OF THE OPPONENT'S"
  print at 5,5, "   STONES BY PLACING"
  print at 5,6, "   ONE OF YOURS ON"
  print at 5,7, "   EACH SIDE OF HIS."
  vpoke vram.name + 299, TIwhite
  vpoke vram.name + 300, TIblack
  vpoke vram.name + 301, TIblack
  vpoke vram.name + 302, TIwhite
  print at 15,9, "OR"
  vpoke vram.name + 305, TIblack
  vpoke vram.name + 306, TIwhite
  vpoke vram.name + 307, TIwhite
  vpoke vram.name + 308, TIblack
  print at 5,11, " 2 GET 5 CONSECUTIVE"
  print at 5,12, "   STONES IN A ROW."
  print at 5,14, " STONES CAN BE PLACED"
  print at 5,15, "   VERTICALLY,"
  print at 5,16, "   HORIZONTALLY,"
  print at 5,17, " OR DIAGONALLY."
  print at 5,19, "WHITE: JOYSTICK 1"
  print at 5,20, "BLACK: JOYSTICK 2"
  ShowScreen
  Who = 0
  WaitLetGo
in_wait:
  Frame1
  ReadStick
  if FR = 1 then goto in_go
  if W = 8 then goto in_wait
in_go:
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen($F1)
  backdrop black
  print at 12,2, "BOGGLER"
  print at 2,4, "BY GARY BRAUN, FROM COMPUTE!"
  print at 2,5, "MARCH 1983 (VIC-20; ATARI,"
  print at 2,6, "TRS-80 COLOR COMPUTER, APPLE"
  print at 2,7, "II AND TI-99/4A VERSIONS). A"
  print at 2,8, "GAME OF STRATEGY FOR TWO."
  print at 2,10, "FOR THE COLECOVISION BY"
  print at 2,11, "CLAUDE (AN AI MADE BY"
  print at 2,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "2026, IN AMY, THE LANGUAGE"
  print at 2,14, "BY AMY BIENVENU."
  print at 2,16, "MUSIC: STONE BY STONE"
  print at 2,17, "(ORIGINAL)."
  print at 9,21, "PRESS THE BUTTON"
  ShowScreen
  play song BgSong once
  Who = 0
  WaitLetGo
cp_wait:
  Frame1
  ReadStick
  if FR = 0 then goto cp_wait
  return
end sub

sub NewScreen(u8 Tc):
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with Tc
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' the VIC character and colour each board tile stands for (tiles 128-144)
data TCode bytes 91, 91, 81, 81, 81, 81, 107, 115, 114, 113, 85, 73, 74, 75, 70, 160, 160
data TColr bytes 1, 3, 0, 1, 3, 6, 6, 6, 6, 6, 6, 6, 6, 6, 6, 0, 1
' the stick (bits: 1 up, 2 down, 4 left, 8 right) as the listing's JS
' table: 0 up, 1 up-right, 2 right, 3 down-right, 4 down, 5 down-left, 6
' left, 7 up-left, 8 none (up and down together cancel, as S0 + S1)
data WTab bytes 8, 0, 4, 8, 6, 7, 5, 6, 2, 1, 3, 2, 8, 0, 4, 8

data RWhite bytes 155,150,151,154,149,147,155,151,152,153,147,148,148
data RBlack bytes 157,160,156,158,159,147,155,151,152,153,148,148
data TilePat bytes
  $18,$18,$18,$00,$00,$18,$18,$18
  $18,$18,$18,$00,$00,$18,$18,$18
  $C3,$81,$00,$00,$00,$00,$81,$C3
  $C3,$81,$00,$00,$00,$00,$81,$C3
  $C3,$81,$00,$00,$00,$00,$81,$C3
  $C3,$81,$00,$00,$00,$00,$81,$C3
  $18,$18,$18,$E0,$E0,$18,$18,$18
  $18,$18,$18,$07,$07,$18,$18,$18
  $00,$00,$00,$00,$00,$18,$18,$18
  $18,$18,$18,$00,$00,$00,$00,$00
  $00,$00,$00,$03,$07,$0C,$18,$18
  $00,$00,$00,$C0,$E0,$30,$18,$18
  $18,$18,$0C,$07,$03,$00,$00,$00
  $18,$18,$30,$E0,$C0,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $C3,$42,$81,$81,$81,$81,$42,$C3
  $C3,$81,$00,$00,$00,$00,$81,$C3
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$10,$10,$10,$10,$10,$00,$10
  $00,$83,$40,$40,$87,$40,$40,$83
  $00,$44,$44,$44,$83,$44,$44,$44
  $00,$38,$10,$10,$10,$10,$10,$38
  $00,$44,$64,$54,$4C,$44,$44,$44
  $00,$C3,$40,$40,$38,$04,$04,$87
  $00,$83,$10,$10,$10,$10,$10,$10
  $00,$44,$44,$44,$54,$54,$54,$28
  $00,$38,$44,$44,$83,$44,$44,$44
  $00,$87,$44,$44,$87,$44,$44,$87
  $00,$38,$44,$40,$40,$40,$44,$38
  $00,$44,$48,$50,$60,$50,$48,$44
  $00,$40,$40,$40,$40,$40,$40,$83
end data
data TileCol bytes
  $F3,$F3,$F3,$0F,$0F,$F3,$F3,$F3
  $73,$73,$73,$07,$07,$73,$73,$73
  $31,$31,$01,$01,$01,$01,$31,$31
  $3F,$3F,$0F,$0F,$0F,$0F,$3F,$3F
  $37,$37,$07,$07,$07,$07,$37,$37
  $34,$34,$04,$04,$04,$04,$34,$34
  $43,$43,$43,$34,$34,$43,$43,$43
  $43,$43,$43,$34,$34,$43,$43,$43
  $03,$03,$03,$04,$04,$43,$43,$43
  $43,$43,$43,$04,$04,$03,$03,$03
  $03,$03,$03,$43,$43,$43,$43,$43
  $03,$03,$03,$43,$43,$43,$43,$43
  $43,$43,$43,$43,$43,$03,$03,$03
  $43,$43,$43,$43,$43,$03,$03,$03
  $03,$03,$04,$04,$03,$03,$03,$03
  $01,$01,$01,$01,$01,$01,$01,$01
  $0F,$0F,$0F,$0F,$0F,$0F,$0F,$0F
  $F1,$1F,$1F,$1F,$1F,$1F,$1F,$F1
  $F1,$F1,$01,$01,$01,$01,$F1,$F1
  $04,$04,$04,$04,$04,$04,$04,$04
  $04,$34,$34,$34,$34,$34,$04,$34
  $04,$43,$34,$34,$43,$34,$34,$43
  $04,$34,$34,$34,$43,$34,$34,$34
  $04,$34,$34,$34,$34,$34,$34,$34
  $04,$34,$34,$34,$34,$34,$34,$34
  $04,$43,$34,$34,$34,$34,$34,$43
  $04,$43,$34,$34,$34,$34,$34,$34
  $04,$34,$34,$34,$34,$34,$34,$34
  $04,$34,$34,$34,$43,$34,$34,$34
  $04,$43,$34,$34,$43,$34,$34,$43
  $04,$34,$34,$34,$34,$34,$34,$34
  $04,$34,$34,$34,$34,$34,$34,$34
  $04,$34,$34,$34,$34,$34,$34,$43
end data

asm {
BgHush:
    db $00,$00,$F4,$01,$10
BgBuzz:
    db $40,$82,$01,$0D,$50
BgWin:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$8F,$20,$06,$40,$6B,$10,$10
    db $50

BgSoundTable:
    dw BgHush,$702B
    dw BgBuzz,$7035
    dw BgWin,$7035
    dw BgTuneMel,$703F
    dw BgTuneBass,$7049
; Stone by Stone, G major (original for this game)
; Tiny Sound, 8 frames per step
BgTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1A,$01,$01,$01,$1E,$01,$01,$01,$21,$01,$01,$01
