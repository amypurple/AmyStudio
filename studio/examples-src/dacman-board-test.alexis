end data

sub DacmanInitGraphics:
  screen off
  nmi off
  mode 2 screen
  cls
  copy DacmanNumbers count 80 to vram.pattern + 48 * 8
  copy DacmanFont count 224 to vram.pattern + 65 * 8
  copy DacmanDieze count 8 to vram.pattern + 35 * 8
  copy DacmanEtoile count 8 to vram.pattern + 42 * 8
  copy DacmanMedaille count 96 to vram.pattern + 224 * 8
  copy DacmanGrafx count 672 to vram.pattern + 128 * 8
  duplicate mode 2 patterns
  decompress DacmanGameColorRle to vram.color
  copy DacmanMissSprites count 64 to vram.spr_pat
  backdrop black
  screen on
  nmi on
  return

sub start:
  mode 2 screen
  sprites 16x16
  sprites simple
  DacmanInitGraphics
  restore Dacman_board1
  for Y = 0 to 20
    for X = 0 to 18
      read Tile
      put char Tile at BoardLeft + X,BoardTop + Y
    next
  next
  print at 1,0, "BOARD TEST"
  loop forever
end sub
