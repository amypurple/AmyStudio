  $8A,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$8A
  $8A,$A0,$81,$84,$A0,$82,$A0,$81,$85,$87,$85,$84,$A0,$82,$A0,$81,$84,$A0,$8A
  $8A,$A0,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$A0,$8A
  $89,$85,$85,$86,$A0,$8B,$85,$84,$A0,$88,$A0,$81,$85,$8E,$A0,$83,$85,$85,$8C
  $20,$20,$20,$8A,$A0,$8A,$20,$20,$20,$20,$20,$20,$20,$8A,$A0,$8A,$20,$20,$20
  $85,$85,$85,$8C,$A0,$88,$20,$83,$84,$80,$81,$86,$20,$88,$A0,$89,$85,$85,$85
  $20,$20,$20,$20,$A0,$A0,$20,$8A,$AB,$AC,$AD,$8A,$20,$A0,$A0,$20,$20,$20,$20
  $85,$85,$85,$86,$A0,$82,$20,$89,$85,$85,$85,$8C,$20,$82,$A0,$83,$85,$85,$85
  $20,$20,$20,$8A,$A0,$8A,$20,$20,$20,$BA,$20,$20,$20,$8A,$A0,$8A,$20,$20,$20
  $83,$85,$85,$8C,$A0,$88,$A0,$81,$85,$87,$85,$84,$A0,$88,$A0,$89,$85,$85,$86
  $8A,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$A0,$8A
  $8A,$A0,$81,$86,$A0,$81,$85,$84,$A0,$88,$A0,$81,$85,$84,$A0,$83,$84,$A0,$8A
  $8A,$A1,$A0,$8A,$A0,$A0,$A0,$A0,$A0,$A4,$A0,$A0,$A0,$A0,$A0,$8A,$A0,$A1,$8A
  $8B,$84,$A0,$88,$A0,$82,$A0,$81,$85,$87,$85,$84,$A0,$82,$A0,$88,$A0,$81,$8E
  $8A,$A0,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$8A,$A0,$A0,$A0,$A0,$8A
