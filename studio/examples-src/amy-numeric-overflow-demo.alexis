u32 U32Wrap = 4294967295
u16 U16Wrap = 65535
u16 MixU16 = 0
u8 U8Wrap = 255
i16 I16Wrap = 32767
i8 NegOne = -1
i8 PosOne = 1
fixed FxOver = raw $FF80
fixed FxUnder = 0
bcd digits 6 BcdCarry
bcd digits 6 BcdBorrow
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0
u8 T5 = 0
u8 T6 = 0
u8 T7 = 0

' Amy Numeric Overflow Demo
  text screen
  seed_values
  run_demo
  screen on

sub seed_values:
  clear BcdCarry
  BcdCarry += 999999
  clear BcdBorrow
  return

sub run_demo:
  print at 6,0, "NUMERIC OVERFLOW"
  print at 1,2, "u8 255+1"
  U8Wrap += 1
  print U8Wrap at 11,2 digits 3
  print at 1,3, "u16 max+1"
  U16Wrap += 1
  print U16Wrap at 11,3 digits 5
  print at 1,4, "u32 max+1"
  U32Wrap += 1
  print U32Wrap at 11,4
  print at 1,5, "u16 0+(-1)"
  MixU16 += NegOne
  print MixU16 at 11,5 digits 5
  print at 1,6, "i16 max+1"
  I16Wrap += PosOne
  print I16Wrap at 11,6 digits 6
  print at 1,7, "bcd 999999+1"
  BcdCarry += 1
  print BcdCarry at 13,7
  print at 1,8, "bcd 000000-1"
  BcdBorrow -= 1
  print BcdBorrow at 13,8
  print at 1,9, "fx 255.50+.50"
  FxOver += raw $0080
  print FxOver at 13,9
  print at 1,10, "fx 000.00-.50"
  FxUnder -= raw $0080
  print FxUnder at 13,10

  if U8Wrap = 0 then
    T1 = 1
  end if
  if U16Wrap = 0 then
    T2 = 1
  end if
  if U32Wrap = 0 then
    T3 = 1
  end if
  if MixU16 = 65535 then
    T4 = 1
  end if
  if signed I16Wrap = -32768 then
    T5 = 1
  end if
  if FxOver = 0 then
    T6 = 1
  end if
  if FxUnder = raw $FF80 then
    T7 = 1
  end if

  print at 1,12, "CHECKS"
  print at 1,13, "u8 wrap"
  print at 1,14, "u16 wrap"
  print at 1,15, "u32 wrap"
  print at 1,16, "u16+i8"
  print at 1,17, "i16+1"
  print at 1,18, "fx over"
  print at 1,19, "fx under"

  if T1 then
    print at 22,13, "PASS"
  else
    print at 22,13, "FAIL"
  end if
  if T2 then
    print at 22,14, "PASS"
  else
    print at 22,14, "FAIL"
  end if
  if T3 then
    print at 22,15, "PASS"
  else
    print at 22,15, "FAIL"
  end if
  if T4 then
    print at 22,16, "PASS"
  else
    print at 22,16, "FAIL"
  end if
  if T5 then
    print at 22,17, "PASS"
  else
    print at 22,17, "FAIL"
  end if
  if T6 then
    print at 22,18, "PASS"
  else
    print at 22,18, "FAIL"
  end if
  if T7 then
    print at 22,19, "PASS"
  else
    print at 22,19, "FAIL"
  end if
  return