asm {
; LITTLE TOWN: the town lives in the name table ($1800), one tile a cell
; (columns 2-29, rows 2-20), so the map needs no RAM.

; TnAddr: HL = the name table address of column Tx, row Ty
TnAddr:
    ld a,(AMY_UVAR_Ty)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Tx)
    or l
    ld l,a
    ld de,$1800
    add hl,de
    ret

; TnGet: Tt = the tile at Tx, Ty
TnGet:
    call TnAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Tt),a
    ret

; TnPut: the tile Tt at Tx, Ty
TnPut:
    call TnAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Tt)
    out ($BE),a
    ret

; TnLook: around Tx, Ty: NRoad = 1 if a road is in the 3 x 3 square, NWork
; = the works (built) in the 5 x 5 square, NPark = the parks there
TnLook:
    xor a
    ld (AMY_UVAR_NRoad),a
    ld (AMY_UVAR_NWork),a
    ld (AMY_UVAR_NPark),a
    ld a,(AMY_UVAR_Tx)
    ld (AMY_UVAR_LkX),a
    ld a,(AMY_UVAR_Ty)
    ld (AMY_UVAR_LkY),a
    sub 2
    ld (AMY_UVAR_Ty),a
    ld a,(AMY_UVAR_Tx)
    sub 2
    ld (AMY_UVAR_Tx),a
    ld c,0                  ; c = the row (0-4)
TnLk1:
    call TnAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld b,0                  ; b = the column (0-4)
TnLk2:
    in a,($BE)
    ld e,a
    ; a road (1 to 3 across and down: the inner square)?
    sub AMY_UCONST_TRoad00
    cp 16
    jr nc,TnLk3
    ld a,b
    dec a
    cp 3
    jr nc,TnLk3
    ld a,c
    dec a
    cp 3
    jr nc,TnLk3
    ld a,1
    ld (AMY_UVAR_NRoad),a
TnLk3:
    ld a,e
    sub AMY_UCONST_TWork1
    cp 3
    jr nc,TnLk4
    ld hl,AMY_UVAR_NWork
    inc (hl)
TnLk4:
    ld a,e
    cp AMY_UCONST_TPark
    jr nz,TnLk5
    ld hl,AMY_UVAR_NPark
    inc (hl)
TnLk5:
    inc b
    ld a,b
    cp 5
    jr nz,TnLk2
    ld hl,AMY_UVAR_Ty
    inc (hl)
    inc c
    ld a,c
    cp 5
    jr nz,TnLk1
    ld a,(AMY_UVAR_LkX)
    ld (AMY_UVAR_Tx),a
    ld a,(AMY_UVAR_LkY)
    ld (AMY_UVAR_Ty),a
    ret

; TnCount: the whole town counted: Cnt (12 words) for the homes, shops
; and works at levels 0-3, NRoads, and the power plants' places (PlX,
; PlY, up to 16 of them, NPlant)
TnCount:
    ld hl,AMY_UVAR_Cnt
    ld b,24
TnCn0:
    ld (hl),0
    inc hl
    djnz TnCn0
    ld hl,0
    ld (AMY_UVAR_NRoads),hl
    xor a
    ld (AMY_UVAR_NPlant),a
    ld a,2
    ld (AMY_UVAR_Ty),a
TnCn1:
    ld a,2
    ld (AMY_UVAR_Tx),a
    call TnAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld b,28
TnCn2:
    in a,($BE)
    ld e,a
    sub AMY_UCONST_TRoad00
    cp 16
    jr nc,TnCn3
    ld hl,(AMY_UVAR_NRoads)
    inc hl
    ld (AMY_UVAR_NRoads),hl
    jr TnCn6
TnCn3:
    ld a,e
    sub AMY_UCONST_THome0
    cp 12
    jr nc,TnCn4
    add a,a
    ld l,a
    ld h,0
    push de
    ld de,AMY_UVAR_Cnt
    add hl,de
    pop de
    inc (hl)
    jr nz,TnCn6
    inc hl
    inc (hl)
    jr TnCn6
TnCn4:
    ld a,e
    cp AMY_UCONST_TPlant
    jr nz,TnCn6
    ld a,(AMY_UVAR_NPlant)
    cp 16
    jr nc,TnCn6
    ld l,a
    ld h,0
    push de
    ld de,AMY_UVAR_PlY
    add hl,de
    ld a,(AMY_UVAR_Ty)
    ld (hl),a
    ld de,AMY_UVAR_PlX - AMY_UVAR_PlY
    add hl,de
    ld a,30
    sub b                   ; the column: 2 + (28 - b)
    ld (hl),a
    pop de
    ld hl,AMY_UVAR_NPlant
    inc (hl)
TnCn6:
    djnz TnCn2
    ld hl,AMY_UVAR_Ty
    inc (hl)
    ld a,(hl)
    cp 21
    jr nz,TnCn1
    ret

TnHush:
    db $00,$00,$F4,$01,$10
TnTick:
    db $40,$40,$50,$01,$50
TnBuild:
    db $40,$7F,$20,$02,$40,$55,$30,$03,$50
TnRoad:
    db $00,$00,$36,$02,$00,$00,$66,$02,$10
TnClear:
    db $00,$00,$25,$03,$00,$00,$56,$04,$10
TnNo:
    db $40,$F9,$22,$04,$40,$F9,$33,$06,$50
TnGrow:
    db $80,$47,$60,$02,$80,$35,$70,$03,$90
TnMonth:
    db $80,$6B,$50,$02,$80,$55,$60,$04,$90
TnCheer:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$30,$10,$50

TnSoundTable:
    dw TnHush,$702B
    dw TnTick,$7035
    dw TnBuild,$7035
    dw TnRoad,$702B
    dw TnClear,$702B
    dw TnNo,$7035
    dw TnGrow,$703F
    dw TnMonth,$703F
    dw TnCheer,$7035
    dw TnTuneMel,$703F
    dw TnTuneBass,$7049
; Main Street, F major (original for this game)
; Tiny Sound, 8 frames per step
TnTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$18,$1C,$1F,$00,$1C,$1F,$24,$00,$23,$21,$1F,$00
    db $1D,$21,$24,$00,$21,$1D,$1C,$00,$1A,$1C,$1D,$00,$1F,$21,$23,$00
    db $24,$26,$28,$00,$26,$24,$23,$21,$1F,$1C,$1A,$17,$98,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
TnTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$0C,$00,$13,$00,$0C,$00,$13,$00,$0C,$00,$10,$00
    db $11,$00,$0C,$00,$11,$00,$0C,$00,$13,$00,$17,$00,$10,$00,$13,$00
    db $15,$00,$0C,$00,$11,$00,$0E,$00,$13,$00,$13,$00,$0C,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
; the title song: both voices of Main Street at once
TnSong:
    dw $0001
    db $40+10,11
    dw $0000
}
