u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
Obj Objs[NObj]
' Willie: top row x 256, vertical speed, in the air, ducking, walking,
' walk frame and its timer
u16 WYf = Ground
i16 Vy = 0
u8 Air = 0
u8 Duck = 0
u8 Walk = 0
u8 WFr = 0
u8 WAt = 0
u8 Lives = 3
u8 SpT = 0
u8 Dead = 0
u8 Over = 0
u8 Apples = 0
u8 Spawned = 0
' the scenery: four accumulators (1/256 px) and the offsets on screen
u16 AcT = 0
u16 AcW = 0
u16 AcP = 0
u16 AcF = 0
u8 OfT = 0
u8 OfW = 0
u8 OfP = 0
u8 OfF = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Sl = 0
u8 Ds = 0
u8 Gx = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  Scenery
  if Dead > 0 then LoseLife
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "  BEST  ", Hi, "  "
  print at 8,14, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play (the C64's 60 Hz interrupt): the stick, everything moves,
' Willie's jump, the hits, a new object when the clock runs out
sub PlayStep:
  if Air = 0 then
    K = J1 & 2
    if K > 0 then
      Duck = 1
      Walk = 0
    else
      Duck = 0
      K = J1 & 4
      Walk = K >> 2
      K = J1 & 16
      if K > 0 then
        Air = 1
        Vy = JumpV
        play sound SndJump
      end if
    end if
  end if
  ' the objects drift right (faster when Willie walks)
  for Sl = 0 to NObj - 1
    MoveObj(Sl)
  next
  if Air = 1 then
    WYf = WYf + Vy
    Vy = Vy + Grav
    if WYf > Ground then
      WYf = Ground
      Vy = 0
      Air = 0
      play sound SndLand
    end if
  end if
  for Sl = 0 to NObj - 1
    if Objs[Sl].T > 0 then
      if Touches(Sl) = 1 then Contact
    end if
  next
  if SpT > 0 then dec SpT
  if SpT = 0 then Spawn
  ' the walk cycle runs only while walking
  if Walk = 1 then
    inc WAt
    if WAt >= 6 then
      WAt = 0
      WFr = (WFr + 1) & 3
    end if
    AcT = AcT + 128
    AcW = AcW + 256
    AcP = AcP + 448
    AcF = AcF + WalkSpd
  end if
  return
end sub

' object S moves; past X 224 it is gone
sub MoveObj(u8 S)
  u8 Ty = 0
  u16 Sp = 0
  Ty = Objs[S].T
  if Ty = 0 then return
  Sp = TySpd[Ty]
  if Walk = 1 then Sp = Sp + WalkSpd
  Objs[S].Xf = Objs[S].Xf + Sp
  if Objs[S].Xf >= 57600 then
    Objs[S].T = 0
    return
  end if
  if TyNFr[Ty] > 1 then
    inc Objs[S].FrT
    if Objs[S].FrT >= TyFrT[Ty] then
      Objs[S].FrT = 0
      Objs[S].Fr = Objs[S].Fr ^ 1
    end if
  end if
  return
end sub

' 1 when object S's body box meets Willie's
function Touches(u8 S) as u8
  u8 Ty = 0
  u8 Ox = 0
  u8 Wy = 0
  u8 Top = 0
  u8 Bot = 0
  Ty = Objs[S].T
  Ox = highbyte Objs[S].Xf
  Wy = highbyte WYf
  if Ox + TyR[Ty] < WX + 4 then return 0
  if Ox + TyL[Ty] > WX + 11 then return 0
  Top = Wy
  if Duck = 1 then Top = Wy + 10
  Bot = Wy + 29
  if TyY[Ty] + TyB[Ty] < Top then return 0
  if TyY[Ty] + TyT[Ty] > Bot then return 0
  return 1

' Willie touched object Sl: an apple is picked, a creature ends the life
sub Contact:
  Ds = Objs[Sl].T
  if TyBad[Ds] = 1 then
    Dead = 1
    play sound SndCrash
    play sound SndHit
    return
  end if
  Objs[Sl].T = 0
  Score += 10
  if Score > Hi then Hi = Score
  inc Apples
  play sound SndApple
  ShowScore
  return
end sub

' a new object at the left in the highest free slot, the clock reset to
' 40 + 0..40
sub Spawn:
  SpT = RandTo(40) + 40
  Ds = NObj
  while Ds > 0
    dec Ds
    if Objs[Ds].T = 0 then
      Objs[Ds].T = RandTo(3) + 1
      Objs[Ds].Xf = 4096
      Objs[Ds].Fr = 0
      Objs[Ds].FrT = 0
      inc Spawned
      Ds = 0
    end if
  end while
  return
end sub

' 0..N, as the C64 did it: mask to the next power of two, try again above N
function RandTo(u8 N) as u8
  u8 M = 255
  u8 R = 0
  if N = 0 then return 0
  while M >> 1 >= N
    M = M >> 1
  end while
  Rand
  R = Rs & M
  while R > N
    Rand
    R = Rs & M
  end while
  return R

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a creature got Willie: a pause, a life gone, the round again or the end
sub LoseLife:
  Rearm
  wait 60 frames
  nmi off
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    return
  end if
  for Sl = 0 to NObj - 1
    Objs[Sl].T = 0
  next
  DrawSprites
  Rearm
  wait 60 frames
  nmi off
  NewRound
  return
end sub

sub NewRound:
  WYf = Ground
  Vy = 0
  Air = 0
  Duck = 0
  Walk = 0
  WFr = 0
  WAt = 0
  Dead = 0
  DrawSprites
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-3 Willie (face and hands over clothes; top, bottom), 4-10 the
' objects
sub DrawSprites:
  Y = highbyte WYf
  K = WFr + 1
  if Walk = 0 then K = 0
  if Duck = 1 then K = 5
  if Air = 1 then K = 6
  K = K * 16 + SW00p
  set sprite 0 to Y - 1,WX,K,9
  set sprite 1 to Y - 1,WX,K + 4,5
  set sprite 2 to Y + 15,WX,K + 8,9
  set sprite 3 to Y + 15,WX,K + 12,5
  for Gx = 0 to NObj - 1
    J = Gx + 4
    V = Objs[Gx].T
    if V > 0 then
      X = highbyte Objs[Gx].Xf
      K = Objs[Gx].Fr * 4 + TyPat[V]
      set sprite J to TyY[V] - 1,X,K,TyCol[V]
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' the four bands scroll right by their offsets (only when they change)
sub Scenery:
  V = highbyte AcT
  V = V & 31
  if V <> OfT then
    OfT = V
    W16 = V * BTreesLen
    copy ScTrees + W16 count BTreesLen to vram.pattern + BTreesCode * 8
  end if
  V = highbyte AcW
  V = V & 31
  if V <> OfW then
    OfW = V
    W16 = V * BWallLen
    copy ScWall + W16 count BWallLen to vram.pattern + BWallCode * 8
    copy ScWall + W16 count BWallLen to vram.pattern + 2048 + BWallCode * 8
  end if
  V = highbyte AcP
  V = V & 31
  if V <> OfP then
    OfP = V
    W16 = V * BPickLen
    copy ScPick + W16 count BPickLen to vram.pattern + 2048 + BPickCode * 8
  end if
  V = highbyte AcF
  V = V & 31
  if V <> OfF then
    OfF = V
    W16 = V * BFlowLen
    copy ScFlow + W16 count BFlowLen to vram.pattern + 4096 + BFlowCode * 8
  end if
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

sub ShowLives:
  fill 32 count 3 at 27,1
  if Lives > 0 then fill TLife count Lives at 27,1
  return
end sub

' N rows of a band from screen row R: its 4 codes a row, repeated
sub BandRows(u8 Code, u8 R, u8 N)
  u8 Br = 0
  u8 Bc = 0
  u8 Last = 0
  Last = R + N - 1
  for Br = R to Last
    for Bc = 0 to 31
      put char Code + (Bc & 3) at Bc,Br
    next
    Code = Code + 4
  next
  return
end sub

' the garden: sky, far hedges, the wall, the fence, the path, the flowers
sub DrawGarden:
  fill TSky count 32 at 0,2
  put char TStar at 4,2
  put char TStar2 at 11,2
  put char TStar at 19,2
  put char TStar2 at 24,2
  put char TStar at 29,2
  BandRows(BTreesCode, 3, 3)
  BandRows(BWallCode, 6, 4)
  BandRows(BPickCode, 10, 1)
  for Gx = 11 to 17
    fill TPath count 32 at 0,Gx
  next
  fill TEdge count 32 at 0,18
  BandRows(BFlowCode, 19, 2)
  fill TGrass count 32 at 0,21
  fill TSoil count 32 at 0,22
  fill TSoil count 32 at 0,23
  return
end sub

' every band back to offset 0 (the tile patterns as loaded)
sub ResetScroll:
  AcT = 0
  AcW = 0
  AcP = 0
  AcF = 0
  OfT = 0
  OfW = 0
  OfP = 0
  OfF = 0
  return
end sub

sub NewGame:
  NewScreen
  ResetScroll
  DrawGarden
  print at 2,1, "SCORE"
  print at 21,1, "LIVES"
  for Sl = 0 to NObj - 1
    Objs[Sl].T = 0
  next
  Score = 0
  Lives = 3
  Over = 0
  SpT = 0
  Apples = 0
  Spawned = 0
  NewRound
  ShowScore
  ShowLives
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the big title letters: 3 x 5 blocks
data LtA bytes 7,5,7,5,5
data LtP bytes 7,5,7,4,4
data LtL bytes 4,4,4,4,7
data LtE bytes 7,4,6,4,7
data LtW bytes 5,5,7,7,5
data LtI bytes 7,2,2,2,7

sub BigLetter(u8 Lt, u8 Cx, u8 Cy)
  u8 Ly = 0
  u8 Bits = 0
  for Ly = 0 to 4
    select case Lt
      case 0
        Bits = LtA[Ly]
      case 1
        Bits = LtP[Ly]
      case 2
        Bits = LtL[Ly]
      case 3
        Bits = LtE[Ly]
      case 4
        Bits = LtW[Ly]
      case else
        Bits = LtI[Ly]
    end select
    if Bits & 4 then put char TTbl at Cx,Cy + Ly
    if Bits & 2 then put char TTbl at Cx + 1,Cy + Ly
    if Bits & 1 then put char TTbl at Cx + 2,Cy + Ly
  next
  return
end sub

' the title: APPLE WILLIE in apple-red blocks over the garden, Willie and
' an apple on the path, START / CREDITS, the best score, the tune once
data TitleWord bytes 0,1,1,2,3,4,5,2,2,5,3
sub TitlePage:
  NewScreen
  ResetScroll
  DrawGarden
  for Gx = 3 to 10
    fill TPath count 32 at 0,Gx
  next
  fill TSky count 32 at 0,2
  for Gx = 0 to 4
    BigLetter(TitleWord[Gx], Gx * 4 + 6, 3)
  next
  for Gx = 5 to 10
    BigLetter(TitleWord[Gx], Gx * 4 - 16, 10)
  next
  fill TPath count 32 at 0,9
  print at 7,1, "COMPUTE!'S GAZETTE"
  print at 10,2, "APRIL  1990"
  print at 13,16, "START"
  print at 13,17, "HOW TO PLAY"
  print at 13,18, "CREDITS"
  if Hi > 0 then
    print at 9,19, "BEST ", Hi
  end if
  ShowMenu
  set sprite 0 to 121,WX,SW00p,9
  set sprite 1 to 121,WX,SW00b,5
  set sprite 2 to 137,WX,SW01p,9
  set sprite 3 to 137,WX,SW01b,5
  set sprite 4 to 135,40,SApple,8
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,16
  put char 32 at 11,17
  put char 32 at 11,18
  J = Menu + 16
  put char 62 at 11,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    print at 2,3, "HELP WILLIE PICK UP APPLES"
    print at 2,4, "IN THE GARDEN AT NIGHT."
    print at 2,5, "PUSH THE STICK LEFT TO WALK"
    print at 2,6, "INTO THE APPLES: 10 POINTS"
    print at 2,7, "EACH."
    print at 2,9, "BIRDS AND A WORM COME AT"
    print at 2,10, "YOU. TOUCHING ONE COSTS A"
    print at 2,11, "LIFE. YOU HAVE 3 LIVES. NO"
    print at 2,12, "LIVES LEFT: GAME OVER."
    set sprite 0 to 135,WX,SW10p,9
    set sprite 1 to 135,WX,SW10b,5
    set sprite 2 to 151,WX,SW11p,9
    set sprite 3 to 151,WX,SW11b,5
    set sprite 4 to 151,120,SApple,8
    set sprite 5 to 151,48,SWorm0,9
    fill TPath count 28 at 2,21
  else
    print at 2,3, "STICK DOWN: DUCK UNDER THE"
    print at 2,4, "HIGH BIRDS."
    print at 2,5, "BUTTON: JUMP OVER THE LOW"
    print at 2,6, "BIRDS AND THE WORM."
    set sprite 4 to 59,24,SBird0,11
    print at 6,8, "HIGH BIRD: DUCK"
    set sprite 5 to 75,24,SBird0,10
    print at 6,10, "LOW BIRD: JUMP"
    set sprite 6 to 91,24,SWorm0,9
    print at 6,12, "WORM: JUMP"
    set sprite 7 to 107,24,SApple,8
    print at 6,14, "APPLE: WALK INTO IT"
    print at 2,17, "TIP: STANDING STILL SCORES"
    print at 2,18, "NOTHING. KEEP WALKING AND"
    print at 2,19, "WATCH WHAT COMES NEXT!"
    set sprite 0 to 63,WX,SW50p,9
    set sprite 1 to 63,WX,SW50b,5
    set sprite 2 to 79,WX,SW51p,9
    set sprite 3 to 79,WX,SW51b,5
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_loop:
  Frame1
  inc Rs
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "APPLE WILLIE"
  print at 2,5, "BASED ON APPLE WILLIE,"
  print at 2,6, "COMPUTE!'S GAZETTE DISK,"
  print at 2,7, "APRIL 1990 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: ORCHARD STROLL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

