cartridge "AMY TIMER LAB/AMY STUDIO/2026"

timer BlinkTimer every 30 ticks
timer DoorTimer after 120 ticks stopped

u8 BlinkCount = 0
u8 DoorDone = 0
u8 BlinkTile = 42

  text screen
  print centered at 3, "AMY TIMER LAB"
  print centered at 5, "EVERY 30 TICKS"
  print centered at 6, "AFTER 120 TICKS"
  print at 4,10, "BLINKS:"
  print at 4,12, "DOOR  : WAITING"
  print at 4,15, "BOX:"
  start timer DoorTimer
  screen on

main_loop:
  wait
  if timer BlinkTimer then BlinkTick
  if timer DoorTimer then DoorTick
  print BlinkCount at 12,10 digits 3
  if DoorDone = 0 then goto main_loop
  if BlinkCount < 4 then goto main_loop
  print centered at 18, "PASS - BOTH TIMER TYPES"
done:
  goto done

sub BlinkTick:
  BlinkCount += 1
  if BlinkTile = 42 then
    BlinkTile = 43
  else
    BlinkTile = 42
  end if
  put char BlinkTile at 9,15
  return

sub DoorTick:
  DoorDone = 1
  print at 12,12, "OPEN   "
  put char 47 at 9,15
  stop timer BlinkTimer
  return