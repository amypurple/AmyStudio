project "Earth Globe"
memory "colecovision_legacy_sdcc"

asset EarthPatternZx0 from "@project/earth-globe.pattern.zx0" codec zx0
asset EarthMaskSpritesZx0 from "@project/earth-globe-sprites.pattern.zx0" codec zx0

const EarthX = 12
const EarthY = 8
u8 EarthFrame = 0
u8 EarthTicks = 0

picture screen
backdrop black
nmi off
sprites 16x16

' The title uses the first independent Graphics II character bank.
load default ascii
fill $F0 count 2048 to vram.color

' The globe occupies the independent middle Graphics II character bank.
decompress zx0 EarthPatternZx0 to vram.pattern + $0800
fill $11 count 8 to vram.color + $0800
fill $C4 count 2040 to vram.color + $0808

' Twelve static black sprites cut the square tile field into a round globe.
' Their Y values are SAT coordinates: the VDP displays each sprite at Y + 1.
decompress zx0 EarthMaskSpritesZx0 to vram.spr_pat
set sprite count 12
set sprite 0 to 63,96,0,$01
set sprite 1 to 63,112,4,$01
set sprite 2 to 79,96,8,$01
set sprite 3 to 63,144,12,$01
set sprite 4 to 63,128,16,$01
set sprite 5 to 79,144,20,$01
set sprite 6 to 111,96,24,$01
set sprite 7 to 111,112,28,$01
set sprite 8 to 95,96,32,$01
set sprite 9 to 111,144,36,$01
set sprite 10 to 111,128,40,$01
set sprite 11 to 95,144,44,$01
update sprites

fill $00 count 768 to vram.name
print centered at 3, "EARTH"
DrawEarthFrame
nmi on
screen on

EarthLoop:
  wait
  EarthTicks += 1
  if EarthTicks = 12 then
    EarthTicks = 0
    EarthFrame += 1
    if EarthFrame = 12 then EarthFrame = 0
    nmi off
    DrawEarthFrame
    nmi on
  end if
goto EarthLoop

sub DrawEarthFrame:
  if EarthFrame = 0 then
    call asm EarthDrawFrame with hl = address of FRAME_00H_MAP
  elseif EarthFrame = 1 then
    call asm EarthDrawFrame with hl = address of FRAME_02H_MAP
  elseif EarthFrame = 2 then
    call asm EarthDrawFrame with hl = address of FRAME_04H_MAP
  elseif EarthFrame = 3 then
    call asm EarthDrawFrame with hl = address of FRAME_06H_MAP
  elseif EarthFrame = 4 then
    call asm EarthDrawFrame with hl = address of FRAME_08H_MAP
  elseif EarthFrame = 5 then
    call asm EarthDrawFrame with hl = address of FRAME_10H_MAP
  elseif EarthFrame = 6 then
    call asm EarthDrawFrame with hl = address of FRAME_12H_MAP
  elseif EarthFrame = 7 then
    call asm EarthDrawFrame with hl = address of FRAME_14H_MAP
  elseif EarthFrame = 8 then
    call asm EarthDrawFrame with hl = address of FRAME_16H_MAP
  elseif EarthFrame = 9 then
    call asm EarthDrawFrame with hl = address of FRAME_18H_MAP
  elseif EarthFrame = 10 then
    call asm EarthDrawFrame with hl = address of FRAME_20H_MAP
  else
    call asm EarthDrawFrame with hl = address of FRAME_22H_MAP
  end if
end sub

include "@project/earth-globe-runtime.asm"
