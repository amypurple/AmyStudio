asm {
; BgThirds: VDP register 3 = $FF, a colour table for each third of the
; screen; BgShared: back to Amy's $9F, one table for all three
BgThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER
BgShared:
    ld b,3
    ld c,$9F
    jp WRITE_REGISTER

BgHush:
    db $00,$00,$F4,$01,$10
BgClick:
    db $40,$40,$70,$01,$50
