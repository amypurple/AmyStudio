  tile screen
  set sound table BgSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then goto stars
  if Menu = 2 then goto squares
  if Menu = 3 then goto exe
  if Menu = 4 then goto cubist
  if Menu = 5 then
    RulesPage
    goto title
  end if
  if Menu = 6 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' FASTERMIND

fm_new:
  NewScreen
  backdrop black
  print at 2,1, "FASTERMIND"
  for Y = 2 to 18
    fill TBoard count 18 at 6,Y
  next
  for K = 0 to 7
    Y = K << 1
    Y = Y + 3
    NumU = K + 1
    print at 3,Y, width$(NumU, 1)
    for X = 0 to 3
      V = X << 1
      V = V + 8
      put char THole at V,Y
      V = X + 18
      put char THole at V,Y
    next
  next
  print at 3,20, "?"
  for X = 0 to 3
    V = X << 1
    V = V + 8
    put char THole at V,20
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  ' the code: four digits 1 to 9 (the listing lets them repeat)
  for K = 1 to 4
    Nr = 9
    RndN
    Sec[K] = V + 1
    Gs[K] = 1
  next
  Goes = 0
fm_go:
  inc Goes
  Y = Goes << 1
  Y = Y + 1
  Slot = 1
  Res = 1
  WasBtn = 1
  WasBtn2 = 1
fm_edit:
  if Res = 1 then
    for K = 1 to 4
      V = K << 1
      V = V + 6
      W = Gs[K] + TPeg1
      W = W - 1
      put char W at V,Y
    next
    V = Slot << 1
    V = V + 6
    Sx = V << 3
    Sy = Y + 1
    Sy = Sy << 3
    Sy = Sy - 1
    set sprite 0 to Sy, Sx, SArrow, 15
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Slot > 1 then dec Slot
    end if
    if Rt1 = 1 then
      if Slot < 4 then inc Slot
    end if
    if Up1 = 1 then
      V = Gs[Slot]
      inc V
      if V > 9 then V = 1
      Gs[Slot] = V
    end if
    if Dn1 = 1 then
      V = Gs[Slot]
      dec V
      if V = 0 then V = 9
      Gs[Slot] = V
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto fm_edit
  HideSprites
  play sound SndPeg
  ' the book's scoring: blacks first (both marked), then whites
  for K = 1 to 4
    A[K] = Sec[K]
    Dd[K] = Gs[K]
  next
  Blk = 0
  Wht = 0
  for K = 1 to 4
    if Dd[K] = A[K] then
      A[K] = A[K] + 10
      Dd[K] = Dd[K] + 20
      inc Blk
    end if
  next
  for K = 1 to 4
    V = Dd[K]
    J = 1
fm_w:
    if V = A[J] then
      A[J] = A[J] + 10
      inc Wht
      J = 5
    end if
    inc J
    if J < 5 then goto fm_w
  next
  ' the key pegs
  X = 18
  for K = 1 to Blk
    for J = 1 to 12
      Frame1
    next
    put char TKeyb at X,Y
    play sound SndBlack
    inc X
  next
  for K = 1 to Wht
    for J = 1 to 12
      Frame1
    next
    put char TKeyw at X,Y
    play sound SndWhite
    inc X
  next
  for J = 1 to 20
    Frame1
  next
  if Blk = 4 then
    FmReveal
    play sound SndWin
    print at 2,21, "WELL DONE, MASTER BRAIN!"
    print at 2,22, "               "
    print at 2,22, "SOLVED IN"
    NumU = Goes
    print at 12,22, width$(NumU, 1)
    print at 14,22, "GOES"
    Celebrate
    EndWait
    if Res = 0 then goto fm_new
    goto title
  end if
  if Goes < 8 then goto fm_go
  FmReveal
  play sound SndLose
  print at 2,21, "YOU DIDN'T GET IT..."
  EndWait
  if Res = 0 then goto fm_new
  goto title

' ---------------------------------------------------------------------------
' IDAHO STARS

stars:
  ' the book: five different digits, X from 1 to 3, then ten numbers
is_make:
  for K = 1 to 5
is_pick:
    Nr = 9
    RndN
    V = V + 1
    for J = 1 to K
      if J < K then
        if Dd[J] = V then goto is_pick
      end if
    next
    Dd[K] = V
  next
  Pa = Dd[1]
  Pb = Dd[2]
  Pc = Dd[3]
  Pd = Dd[4]
  Pe = Dd[5]
  Nr = 3
  RndN
  Px3 = V + 1
  A[1] = Px3
  V = Px3 - Pb
  V = V + Pc
  A[2] = V + Pd
  A[3] = Pa + Pe
  A[4] = Pa + Pd
  V = Px3 - Pb
  V = V - Pc
  A[5] = V + Pe
  A[6] = Pa
  A[7] = Pa + Pc
  A[8] = Pa + Pb
  V = Pb << 1
  W = Pd << 1
  V = Px3 - V
  V = V + W
  A[9] = V + Pe
  V = Pb << 1
  W = Pe << 1
  V = Px3 - V
  V = V - Pc
  V = V + Pd
  A[10] = V + W
  ' below 1 (or wrapped round past 0) starts again
  for K = 1 to 10
    V = A[K]
    if V = 0 then goto is_make
    if V > 99 then goto is_make
    B[K] = V
  next
  for K = 1 to 3
    Nr = 10
    RndN
    V = V + 1
    B[V] = 0
  next
  Goes = 0
  Guess = 10
  StarScreen
is_turn:
  StarNumbers
  Hits = 0
  for K = 1 to 10
    if B[K] > 0 then inc Hits
  next
  print at 2,18, "THIS IS GO"
  NumU = Goes + 1
  print at 13,18, width$(NumU, 2)
  print at 17,18, "RIGHT:"
  NumU = Hits
  print at 24,18, width$(NumU, 2)
  if Hits = 10 then
    play sound SndWin
    print at 2,18, "YES, YOU'VE SOLVED IT!    "
    print at 2,19, "AND IT ONLY TOOK"
    NumU = Goes
    print at 19,19, width$(NumU, 2)
    print at 22,19, "GOES"
    print at 2,20, "                          "
    print at 2,21, "                          "
    Celebrate
    EndWait
    if Res = 0 then goto stars
    goto title
  end if
  print at 2,20, "A NUMBER IN THE STAR?"
  NumberPick
  if Res = 1 then goto title
  inc Goes
  ' every place holding it is shown
  Res = 0
  for K = 1 to 10
    if A[K] = Guess then
      if B[K] = 0 then Res = 1
      B[K] = A[K]
    end if
  next
  if Res = 1 then
    play sound SndGood
  else
    play sound SndBad
  end if
  goto is_turn

' ---------------------------------------------------------------------------
' IDAHO SQUARES

squares:
  ' the book: four different digits A, B, C, D; nine numbers from them
iq_make:
  for K = 1 to 4
iq_pick:
    Nr = 9
    RndN
    V = V + 1
    for J = 1 to K
      if J < K then
        if Dd[J] = V then goto iq_pick
      end if
    next
    Dd[K] = V
  next
  Pa = Dd[1]
  Pb = Dd[2]
  Pc = Dd[3]
  ' A(2) = A - (B + C) must be 1 or more
  V = Pb + Pc
  if Pa <= V then goto iq_make
  A[1] = Pa + Pb
  V = Pb + Pc
  A[2] = Pa - V
  A[3] = Pa + Pc
  V = Pa - Pb
  A[4] = V + Pc
  A[5] = Pa
  V = Pa + Pb
  A[6] = V - Pc
  A[7] = Pa - Pc
  V = Pa + Pb
  A[8] = V + Pc
  A[9] = Pa - Pb
  for K = 1 to 9
    B[K] = A[K]
  next
  for K = 1 to 4
    V = Dd[K]
    B[V] = 0
  next
  Goes = 0
  Guess = 10
  SquareScreen
iq_turn:
  SquareNumbers
  Hits = 0
  for K = 1 to 9
    if B[K] > 0 then inc Hits
  next
  print at 2,18, "THIS IS GUESS"
  NumU = Goes + 1
  print at 16,18, width$(NumU, 2)
  print at 19,18, "RIGHT:"
  NumU = Hits
  print at 26,18, width$(NumU, 1)
  if Hits = 9 then
    play sound SndWin
    print at 2,18, "YOU'VE SOLVED IT!         "
    print at 2,19, "IN JUST"
    NumU = Goes
    print at 10,19, width$(NumU, 2)
    print at 13,19, "GUESSES!"
    print at 2,20, "                          "
    print at 2,21, "                          "
    Celebrate
    EndWait
    if Res = 0 then goto squares
    goto title
  end if
  print at 2,20, "ENTER YOUR GUESS"
  NumberPick
  if Res = 1 then goto title
  inc Goes
  Res = 0
  for K = 1 to 9
    if B[K] = 0 then
      if A[K] = Guess then
        B[K] = Guess
        Res = 1
      end if
    end if
  next
  if Res = 1 then
    play sound SndGood
  else
    play sound SndBad
  end if
  goto iq_turn

' ---------------------------------------------------------------------------
' EXECUTIONER

exe:
  NewScreen
  backdrop black
  print at 2,1, "EXECUTIONER"
  for K = 0 to 25
    Used[K] = 0
  next
  Nr = NWords
  RndN
  Ws = WordStart[V]
  Nw = WordLen[V]
  ' the book: Q = INT(N + N/2 + .5)
  V = Nw << 1
  V = V + Nw
  V = V + 1
  Qn = V >> 1
  Chn = Qn
  Goes = 0
  ' the word, dots for letters not found
  V = 16 - Nw
  Wd = V
  for K = 1 to Nw
    print at Wd,14, "."
    Wd = Wd + 2
  next
  Wd = V
  ' the alphabet
  for K = 0 to 25
    ExLetterXY
    V = K + 65
    put char V at X,Y
  next
  print at 18,4, "CHANCES"
  print at 18,5, "LEFT:"
  print at 18,7, "GUESSES:"
  print at 18,9, "CORRECT"
  print at 18,10, "LETTERS:"
  print at 2,16, "YOU HAVE TO GUESS THE"
  print at 2,17, "EXECUTIONER'S WORD!"
  ShowScreen
  Px = 0
  Py = 0
  Hits = 0
  Stg = 0
ex_turn:
  ExStatus
  if Hits = Nw then
    HideSprites
    play sound SndWin
    print at 2,16, "WHEW! YOU'VE STAVED OFF   "
    print at 2,17, "EXECUTION FOR ANOTHER DAY "
    Celebrate
    EndWait
    if Res = 0 then goto exe
    goto title
  end if
  if Chn = 0 then
    HideSprites
    play sound SndLose
    ExDrop
    ExReveal
    print at 2,16, "SO SORRY, BUT YOU GOTTA   "
    print at 2,17, "GO NOW!                   "
    EndWait
    if Res = 0 then goto exe
    goto title
  end if
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
ex_pick:
  if Res = 1 then
    K = Py * 13
    K = K + Px
    ExLetterXY
    Sx = X << 3
    Sx = Sx - 4
    Sy = Y << 3
    Sy = Sy - 1
    set sprite 0 to Sy, Sx, SRing, 11
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Px > 0 then dec Px
    end if
    if Rt1 = 1 then
      if Px < 12 then inc Px
    end if
    if Up1 = 1 then Py = 0
    if Dn1 = 1 then Py = 1
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto ex_pick
  K = Py * 13
  K = K + Px
  if Used[K] = 1 then
    play sound SndBad
    goto ex_pick
  end if
  Used[K] = 1
  ExLetterXY
  print at X,Y, "-"
  inc Goes
  ' the book: J goes on one; each place the letter fills gives one back
  dec Chn
  V = K + 65
  W = Wd
  Res = 0
  for J = 0 to Nw - 1
    Ka = Ws + J
    if WordText[Ka] = V then
      put char V at W,14
      inc Hits
      inc Chn
      Res = 1
    end if
    W = W + 2
  next
  if Res = 1 then
    play sound SndGood
  else
    play sound SndBad
  end if
  goto ex_turn

' ---------------------------------------------------------------------------
' CUBIST

cubist:
  NewScreen
  backdrop dark blue
  print at 2,1, "CUBIST"
  for K = 1 to 16
    B[K] = CubeGoal[K]
  next
  CubeDraw
  print at 2,16, "TWISTING..."
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  for J = 1 to 30
    Frame1
  next
  ' the book: ten random twists, 2 to 12 but not 5 or 9
  for Tw = 1 to 10
cu_rnd:
    Nr = 11
    RndN
    Pa = V + 2
    if Pa = 5 then goto cu_rnd
    if Pa = 9 then goto cu_rnd
    CubeTwist
    print at 2,17, "TWIST NUMBER"
    NumU = Tw
    print at 15,17, width$(NumU, 2)
    for J = 1 to 15
      Frame1
    next
  next
  print at 2,16, "PUT IT BACK!"
  print at 2,17, "                "
  Tw = 0
  Px = 1
  Py = 1
cu_turn:
  print at 2,18, "TWISTS:"
  NumU = Tw
  print at 10,18, width$(NumU, 3)
  ' solved?
  Res = 0
  for K = 1 to 16
    if B[K] <> CubeGoal[K] then Res = 1
  next
  if Res = 0 then
    HideSprites
    play sound SndWin
    print at 2,16, "WELL DONE, CUBIST!"
    print at 2,17, "YOU SOLVED IT IN"
    NumU = Tw
    print at 19,17, width$(NumU, 3)
    print at 23,17, "TWISTS"
    Celebrate
    EndWait
    if Res = 0 then goto cubist
    goto title
  end if
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
cu_pick:
  if Res = 1 then
    ' the twist point: between four squares, 16 pixels each from 12,5
    Sx = Px << 4
    Sx = Sx + 107
    Sy = Py << 4
    Sy = Sy + 50
    set sprite 0 to Sy, Sx, SBox, 15
    update sprites
    Res = 0
  end if
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Px > 0 then dec Px
    end if
    if Rt1 = 1 then
      if Px < 2 then inc Px
    end if
    if Up1 = 1 then
      if Py > 0 then dec Py
    end if
    if Dn1 = 1 then
      if Py < 2 then inc Py
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto cu_pick
  ' the book's choice number: 2-4, 6-8, 10-12
  Pa = Py << 2
  Pa = Pa + Px
  Pa = Pa + 2
  CubeTwist
  inc Tw
  goto cu_turn

' ---------------------------------------------------------------------------
' FASTERMIND helpers

' FmReveal: the code, on the bottom row
sub FmReveal:
  for K = 1 to 4
    V = K << 1
    V = V + 6
    W = Sec[K] + TPeg1
    W = W - 1
    put char W at V,20
  next
  return
end sub

' ---------------------------------------------------------------------------
' STARS and SQUARES helpers

' NumberPick: Guess from 1 to 30; Res 1 if the second button was pressed
sub NumberPick:
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
np_loop:
  if Res = 1 then
    print at 2,21, "YOUR NUMBER:"
    NumU = Guess
    print at 15,21, width$(NumU, 2)
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Guess < 30 then inc Guess
    end if
    if Dn1 = 1 then
      if Guess > 1 then dec Guess
    end if
    if Rt1 = 1 then
      Guess = Guess + 5
      if Guess > 30 then Guess = 30
    end if
    if Lf1 = 1 then
      if Guess > 5 then
        Guess = Guess - 5
      else
        Guess = 1
      end if
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto np_loop
  Res = 0
  return
end sub

' StarScreen: the star picture, its tiles loaded into each third
sub StarScreen:
  NewScreen
  backdrop dark blue
  copy StarPat0 count StarN0 to vram.pattern + 1024
  copy StarCol0 count StarN0 to vram.color + 1024
  copy StarPat1 count StarN1 to vram.pattern + 3072
  copy StarCol1 count StarN1 to vram.color + 3072
  copy StarPat2 count StarN2 to vram.pattern + 5120
  copy StarCol2 count StarN2 to vram.color + 5120
  ' each third its own colour table (the star's colours differ by third)
  call asm BgThirds
  print at 2,1, "IDAHO STARS"
  Ka = 0
  for Y = 3 to 16
    for X = 8 to 23
      V = StarMap[Ka]
      put char V at X,Y
      inc Ka
    next
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  return
end sub

' StarNumbers: the ten places; ?? where a number hides
sub StarNumbers:
  for K = 1 to 10
    J = K - 1
    X = StarCol[J]
    Y = StarRow[J]
    if B[K] = 0 then
      print at X,Y, "??"
    else
      NumU = B[K]
      print at X,Y, width$(NumU, 2)
    end if
  next
  return
end sub

' SquareScreen: the 3 x 3 frame (lines at columns 8, 13, 18, 23 and rows
' 3, 7, 11, 15)
sub SquareScreen:
  NewScreen
  backdrop dark blue
  print at 2,1, "IDAHO SQUARES"
  for Y = 3 to 15
    for X = 8 to 23
      V = 0
      W = X - 8
      W = W % 5
      if W = 0 then V = 1
      W = Y - 3
      W = W & 3
      if W = 0 then V = V + 2
      if V = 1 then put char TSqv at X,Y
      if V = 2 then put char TSqh at X,Y
      if V = 3 then put char TSqx at X,Y
    next
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  return
end sub

sub SquareNumbers:
  for K = 1 to 9
    J = K - 1
    V = J % 3
    X = V * 5
    X = X + 10
    V = J / 3
    Y = V << 2
    Y = Y + 5
    if B[K] = 0 then
      print at X,Y, "??"
    else
      NumU = B[K]
      print at X,Y, width$(NumU, 2)
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' EXECUTIONER helpers

' ExLetterXY: letter K (0-25) of the alphabet rows: X, Y
sub ExLetterXY:
  V = K
  Y = 19
  if V >= 13 then
    V = V - 13
    Y = 21
  end if
  X = V << 1
  X = X + 3
  return
end sub

' ExStatus: the numbers, and the gallows for the chances used
sub ExStatus:
  NumU = Chn
  print at 24,5, width$(NumU, 2)
  NumU = Goes
  print at 26,7, width$(NumU, 2)
  NumU = Hits
  print at 26,10, width$(NumU, 2)
  ' parts = (Q - chances) * 11 / Q, all 11 when none are left
  V = 0
  if Chn < Qn then
    Uw = Qn - Chn
    Uw = Uw * 11
    V = 0
ex_div:
    if Uw >= Qn then
      Uw = Uw - Qn
      inc V
      goto ex_div
    end if
  end if
  if Chn = 0 then V = 11
  if V > Stg then
    Stg = V
    play sound SndDrop
  end if
  ExGallows
  return
end sub

' ExGallows: parts 1 to Stg, each part 2 x 2 tiles at unit Ux, Uy
' (column 4 + 2 Ux, row 2 + 2 Uy); the post is on unit column 1, the rope
' on unit column 5
sub ExGallows:
  if Stg >= 1 then
    Pa = TGbase00
    Uy = 5
    for Ux = 0 to 6
      ExUnit
    next
  end if
  if Stg >= 2 then
    Pa = TGpost00
    Ux = 1
    for Uy = 1 to 4
      ExUnit
    next
    Pa = TGfoot00
    Uy = 5
    ExUnit
  end if
  if Stg >= 3 then
    Pa = TGtop00
    Ux = 1
    Uy = 0
    ExUnit
    Pa = TGbeam00
    for Ux = 2 to 4
      ExUnit
    next
  end if
  if Stg >= 4 then
    Pa = TGbrace00
    Ux = 1
    Uy = 1
    ExUnit
  end if
  if Stg >= 5 then
    Pa = TGrope00
    Ux = 5
    Uy = 0
    ExUnit
  end if
  Uy = 1
  ExFigure
  return
end sub

' ExFigure: the parts of the figure Stg allows, its head on unit row Uy
sub ExFigure:
  if Stg >= 6 then
    Pa = TGhead00
    Ux = 4
    ExHead
  end if
  Ux = 5
  Pb = Uy
  if Stg >= 7 then
    Pa = TGup000
    if Stg >= 8 then Pa = TGup100
    if Stg >= 9 then Pa = TGup200
    inc Uy
    ExUnit
    Pa = TGlow000
    if Stg >= 10 then Pa = TGlow100
    if Stg >= 11 then Pa = TGlow200
    inc Uy
    ExUnit
  end if
  Uy = Pb
  return
end sub

' ExUnit: the 2 x 2 tiles from code Pa at unit Ux, Uy
sub ExUnit:
  X = Ux << 1
  X = X + 4
  Y = Uy << 1
  Y = Y + 2
  V = Pa
  put char V at X,Y
  inc V
  W = X + 1
  put char V at W,Y
  inc V
  Y = Y + 1
  put char V at X,Y
  inc V
  put char V at W,Y
  return
end sub

' ExHead: the 4 x 2 tiles of the head from Pa at unit Ux, Uy
sub ExHead:
  X = Ux << 1
  X = X + 4
  Y = Uy << 1
  Y = Y + 2
  V = Pa
  for I = 0 to 1
    for J = 0 to 3
      W = X + J
      put char V at W,Y
      inc V
    next
    inc Y
  next
  return
end sub

' ExDrop: the figure drops a unit on its rope, the screen flashes
sub ExDrop:
  for J = 1 to 20
    Frame1
  next
  play sound SndDrop
  for Y = 4 to 9
    fill 32 count 4 at 12,Y
  next
  Pa = TGropev00
  Ux = 5
  Uy = 1
  ExUnit
  Uy = 2
  ExFigure
  for K = 1 to 12
    V = K & 1
    if V = 0 then
      backdrop dark red
    else
      backdrop black
    end if
    Frame1
    Frame1
  next
  backdrop black
  return
end sub

' ExReveal: the whole word
sub ExReveal:
  W = Wd
  for J = 0 to Nw - 1
    Ka = Ws + J
    V = WordText[Ka]
    put char V at W,14
    W = W + 2
  next
  return
end sub

' ---------------------------------------------------------------------------
' CUBIST helpers

' CubeTwist: the book's lines 300-370 for choice Pa, then the board
sub CubeTwist:
  Pb = Pa - 1
  Pc = Pa + 3
  Pd = Pa + 4
  Dd[1] = B[Pa]
  Dd[2] = B[Pd]
  Dd[3] = B[Pc]
  Dd[4] = B[Pb]
  B[Pa] = Dd[4]
  B[Pd] = Dd[1]
  B[Pc] = Dd[2]
  B[Pb] = Dd[3]
  play sound SndTwist
  CubeDraw
  return
end sub

' CubeDraw: square K at column 12 + 2 (K-1 mod 4), row 5 + 2 ((K-1) / 4)
sub CubeDraw:
  for K = 1 to 16
    J = K - 1
    V = J & 3
    X = V << 1
    X = X + 12
    V = J >> 2
    Y = V << 1
    Y = Y + 5
    V = B[K] - 1
    V = V << 2
    V = V + TCube100
    put char V at X,Y
    inc V
    W = X + 1
    put char V at W,Y
    inc V
    W = Y + 1
    put char V at X,W
    inc V
    X = X + 1
    put char V at X,W
  next
  return
end sub

' ---------------------------------------------------------------------------
' Celebrate: three bursts of sparks for a solved puzzle
sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

' ----------------------------------------------------------------------------
' Common

' EndWait: Res 0 for the button (again), 1 for the second (menu)
sub EndWait:
  HideSprites
  print at 2,22, "BUTTON: AGAIN  2ND: MENU"
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto ew_loop
  Res = 0
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Ub = 0
  for J = 1 to Nr
    Ub = Ub + Uw
  next
  Ub = Ub >> 8
  V = Ub
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  sprites stable 0 to 0
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  call asm BgShared
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop dark blue
  print at 9,2, "BRAIN GAMES I"
  ' a row of pegs and a cube
  for K = 0 to 8
    V = K + TPeg1
    X = K << 1
    X = X + 4
    put char V at X,5
  next
  put char TCube100 at 24,4
  put char TCube101 at 25,4
  put char TCube110 at 24,5
  put char TCube111 at 25,5
  put char TCube300 at 26,4
  put char TCube301 at 27,4
  put char TCube310 at 26,5
  put char TCube311 at 27,5
  print at 9,8, "FASTERMIND"
  print at 9,9, "IDAHO STARS"
  print at 9,10, "IDAHO SQUARES"
  print at 9,11, "EXECUTIONER"
  print at 9,12, "CUBIST"
  print at 9,14, "HOW TO PLAY"
  print at 9,15, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 6 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 8 to 15
    print at 7,I, " "
  next
  Y = Menu + 8
  if Menu >= 5 then inc Y
  print at 7,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "FASTERMIND: FIND MY CODE OF"
  print at 2,4, "4 DIGITS (1-9) IN 8 GOES."
  print at 2,5, "BLACK: RIGHT DIGIT, RIGHT"
  print at 2,6, "PLACE. WHITE: WRONG PLACE."
  print at 2,8, "IDAHO STARS AND SQUARES:"
  print at 2,9, "EVERY LINE HAS ONE TOTAL."
  print at 2,10, "NAME A HIDDEN NUMBER (??)."
  print at 2,12, "EXECUTIONER: GUESS MY WORD"
  print at 2,13, "BEFORE THE CHANCES RUN OUT."
  print at 2,15, "CUBIST: EACH TWIST TURNS 4"
  print at 2,16, "SQUARES CLOCKWISE. MAKE IT"
  print at 2,17, "AS IT WAS, IN FEW TWISTS."
  print at 2,19, "STICK: CHOOSE. BUTTON: GO."
  print at 2,20, "2ND BUTTON: BACK TO MENU."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 8,1, "BRAIN GAMES I"
  print at 2,3, "FASTERMIND, IDAHO STARS,"
  print at 2,4, "IDAHO SQUARES, EXECUTIONER"
  print at 2,5, "AND CUBIST FROM TIM"
  print at 2,6, "HARTNELL'S GIANT BOOK OF"
  print at 2,7, "COMPUTER GAMES (BALLANTINE"
  print at 2,8, "BOOKS, 1984; INTERFACE"
  print at 2,9, "PUBLICATIONS, 1983)."
  print at 2,11, "MUSIC: THINKING CAP"
  print at 2,12, "(ORIGINAL)."
  print at 2,14, "COLECOVISION VERSION BY"
  print at 2,15, "AMY BIENVENU, 2026."
  PageWait
  return
end sub


