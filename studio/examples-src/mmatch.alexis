data SetLen bytes 2,2,2,4,2,2,2,2,2,2,2
data SetSym bytes TSq,TSw,TSq,TSq, TSgl,TSgr,TSgl,TSgl, TSa,TSs,TSa,TSa, TSo,TSp,TSl,TScn, TSul,TSll,TSul,TSul, TSi,TSu,TSi,TSi, TShc,TSfc,TShc,TShc, TStr,TSz,TStr,TStr, TSup,TSdn,TSup,TSup, TSa,TSe,TSa,TSa, TSv,TSpl,TSv,TSv
u16 TzLeft = 0
u8 TzOn = 0
const NSets = 11
const Penalty = 45

record Player:
  u16 Tm
  u8 Rd
  u8 Gs
  u8 Pc
end record
Player P[2]

' settings: Np players, Lm characters per line, Ln lines, WinBy 0 time
' 1 % correct; Mi the title line picked
u8 Np = 1
u8 Lm = 8
u8 Ln = 4
u8 WinBy = 0
u8 Mi = 4

' a round: Pat the base pattern (12 a line), the odd box OddB, its line
' OddR, column OddC and character OddT; SetI the set; Cp the player;
' Sel the box picked; WrongM wrong boxes (bits); Gs guesses; Secs the
' time; Ox, Oy the pattern's offset in a box; Ph the phase for tests
' (9 credits, 0 title, 1 get set, 2 guessing, 3 found, 4 results)
u8 Pat[72]
u8 OddB = 0
u8 OddR = 0
u8 OddC = 0
u8 OddT = 0
u8 SetI = 0
u8 Cp = 0
u8 Sel = 0
u8 WrongM = 0
u8 Gs = 0
u8 Fr = 0
u16 Secs = 0
u16 Took = 0
u8 Ox = 0
u8 Oy = 0
u8 Ph = 0
u8 Winner = 0
u16 Rs = $5A3C
u16 Rt = 0

u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

new_game:
  for K = 0 to 1
    P[K].Tm = 0
    P[K].Rd = 0
    P[K].Gs = 0
    P[K].Pc = 0
  next
  SetI = 0

round_loop:
  Cp = 0

player_turn:
  Ph = 1
  MakePattern
  DrawRound
  Rearm
  wait 90 frames
  nmi off
  for K = 0 to 3
    FillBox(K)
  next
  play sound SndShow
  fill 32 count 28 at 2,1
  print at 2,1, "PLAYER " + str$(Cp + 1) + ": WHICH BOX DIFFERS?"
  Sel = 0
  WrongM = 0
  Gs = 0
  Fr = 0
  Secs = 0
  FrameBox(0)
  ShowTime
  WasBtn = 1
  WasStick = 1

guess_loop:
  Ph = 2
  Frame1
  ReadMenu
  inc Fr
  if Fr >= 60 then
    Fr = 0
    if Secs < 999 then inc Secs
    ShowTime
  end if
  MoveSel
  if Press = 0 then goto guess_loop
  V = BitOf(Sel)
  if WrongM & V then
    play sound SndNope
    goto guess_loop
  end if
  if Gs < 250 then inc Gs
  if Sel <> OddB then
    WrongM = WrongM | V
    play sound SndWrong
    LabelBox(Sel)
    fill 32 count 28 at 2,22
    print at 2,22, "SORRY, " + str$(Sel + 1) + " IS WRONG. TRY AGAIN"
    goto guess_loop
  end if

  ' found: the time with 45 seconds for each wrong guess
  Ph = 3
  play sound SndRight
  Took = Gs - 1
  Took = Took * Penalty + Secs
  P[Cp].Tm = P[Cp].Tm + Took
  inc P[Cp].Rd
  P[Cp].Gs = P[Cp].Gs + Gs
  fill 32 count 28 at 2,1
  print at 2,1, "CORRECT! LINE " + str$(OddR + 1) + " CHAR " + str$(OddC + 1)
  ShowMarks
  for Tm = 1 to 8
    if Tm & 1 then
      DrawFrame(OddB, 4)
    else
      DrawFrame(OddB, OddB & 1)
    end if
    Rearm
    wait 12 frames
    nmi off
  next
  DrawFrame(OddB, 4)
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  if Gs = 1 then
    print at 2,21, "1 GUESS... EXCELLENT!"
  else
    print at 2,21, str$(Gs) + " GUESSES"
  end if
  print at 2,22, "TIME " + str$(Took) + " SEC"
  if Gs > 1 then print at 18,22, "* +" + str$((Gs - 1) * Penalty)
  print at 2,2, "PRESS A BUTTON"
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
wait_next:
  Frame1
  ReadPad
  if Press = 0 then goto wait_next
  if Np = 2 then
    if Cp = 0 then
      Cp = 1
      goto player_turn
    end if
  end if
  inc SetI
  if SetI < NSets then goto round_loop

  ' the results
  Results
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title


' BitOf(B): the bit of box B in WrongM
function BitOf(u8 Bb) as u8
  select case Bb
  case 0
    return 1
  case 1
    return 2
  case 2
    return 4
  end select
  return 8

function BoxX(u8 Bk) as u8
  if Bk & 1 then return 16
  return 2

function BoxY(u8 Bk) as u8
  if Bk > 1 then return 12
  return 3

' MakePattern: the listing's lines 770-990
sub MakePattern:
  u8 Mr = 0
  u8 Mc = 0
  u8 Ns = 0
  u8 Base = 0
  u8 R1 = 0
  u8 R2 = 0
  u8 Rs3 = 0
  u8 Found = 0
  u8 Pi = 0
  Ns = SetLen[SetI]
  Base = SetI * 4
  for Mr = 0 to 5
    for Mc = 0 to 11
      Pat[Mr * 12 + Mc] = 32
    next
  next
  for Mr = 1 to Ln
    for Mc = 1 to Lm
      Pi = (Mr - 1) * 12 + Mc - 1
      Pat[Pi] = SetSym[Base + RandBelow(Ns)]
    next
  next
  Found = 0
  while Found = 0
    R1 = RandBelow(Ns)
    R2 = RandBelow(Ns)
    while R2 = R1
      R2 = RandBelow(Ns)
    end while
    OddR = RandBelow(Ln)
    Rs3 = RandBelow(Lm)
    for Mc = Rs3 to Lm - 1
      if Found = 0 then
        if Pat[OddR * 12 + Mc] = SetSym[Base + R1] then
          Found = 1
          OddC = Mc
        end if
      end if
    next
  end while
  OddT = SetSym[Base + R2]
  OddB = RandBelow(4)
  Ox = (12 - Lm) / 2
  Oy = (6 - Ln) / 2
  return
end sub

' RandBelow(N): a random number from 0 to N - 1 (N up to 16)
function RandBelow(u8 N) as u8
  u8 R = 0
  Rnd16
  R = Rs & 15
  while R >= N
    Rnd16
    R = Rs & 15
  end while
  return R

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' DrawFrame(B, C): box B's frame in colour C (0 light blue, 1 grey,
' 2 yellow, 3 red, 4 green)
sub DrawFrame(u8 Fb, u8 Fc):
  u8 T0 = 0
  u8 Fx = 0
  u8 Fy = 0
  u8 Fi = 0
  T0 = Fc * 6 + TFbh
  Fx = BoxX(Fb)
  Fy = BoxY(Fb)
  fill T0 count 12 at Fx + 1,Fy
  fill T0 count 12 at Fx + 1,Fy + 7
  for Fi = 1 to 6
    put char T0 + 1 at Fx,Fy + Fi
    put char T0 + 1 at Fx + 13,Fy + Fi
  next
  put char T0 + 2 at Fx,Fy
  put char T0 + 3 at Fx + 13,Fy
  put char T0 + 4 at Fx,Fy + 7
  put char T0 + 5 at Fx + 13,Fy + 7
  return
end sub

' FrameBox(B): the frame as it should look now
sub FrameBox(u8 Gb):
  if Gb = Sel then
    if Ph >= 1 then
      DrawFrame(Gb, 2)
      return
    end if
  end if
  if WrongM & BitOf(Gb) then
    DrawFrame(Gb, 3)
  else
    DrawFrame(Gb, Gb & 1)
  end if
  return
end sub

' LabelBox(B): "(n)" under the box, NO after a wrong guess
sub LabelBox(u8 Lb):
  u8 Lx = 0
  u8 Ly = 0
  Lx = BoxX(Lb) + 5
  Ly = BoxY(Lb) + 8
  print at Lx,Ly, "(" + str$(Lb + 1) + ")"
  if WrongM & BitOf(Lb) then print at Lx + 4,Ly, "NO"
  return
end sub

' FillBox(B): the pattern in box B, the odd character in the odd box
sub FillBox(u8 Ob):
  u8 Br = 0
  u8 Bc = 0
  u8 Bt = 0
  u8 Cx = 0
  u8 Cy = 0
  Cx = BoxX(Ob) + 1 + Ox
  Cy = BoxY(Ob) + 1 + Oy
  for Br = 0 to Ln - 1
    for Bc = 0 to Lm - 1
      Bt = Pat[Br * 12 + Bc]
      if Ob = OddB then
        if Br = OddR then
          if Bc = OddC then Bt = OddT
        end if
      end if
      put char Bt at Cx + Bc,Cy + Br
    next
  next
  return
end sub

' ShowMarks: a square round the odd character's place in every box,
' red in the odd box
sub ShowMarks:
  u8 Sk = 0
  u8 Mx = 0
  u8 My = 0
  u8 Mcol = 0
  for Sk = 0 to 3
    Mx = (BoxX(Sk) + 1 + Ox + OddC) * 8 - 4
    My = (BoxY(Sk) + 1 + Oy + OddR) * 8 - 5
    Mcol = 15
    if Sk = OddB then Mcol = 8
    set sprite Sk to My,Mx,SMark,Mcol
  next
  update sprites
  return
end sub

' MoveSel: the stick moves the yellow frame (2 x 2 boxes)
sub MoveSel:
  u8 Old = 0
  Old = Sel
  if Lf1 = 1 then Sel = Sel & 2
  if Rt1 = 1 then Sel = Sel | 1
  if Up1 = 1 then Sel = Sel & 1
  if Dn1 = 1 then Sel = Sel | 2
  if Sel <> Old then
    play sound SndMove
    V = Sel
    Sel = 9
    FrameBox(Old)
    Sel = V
    FrameBox(Sel)
  end if
  return
end sub

sub ShowTime:
  print at 2,21, "ROUND " + str$(SetI + 1) + "/11"
  print at 19,21, "TIME"
  print Secs at 24,21 digits 3
  return
end sub

' DrawRound: four empty boxes, their numbers, GET SET
sub DrawRound:
  u8 Dk = 0
  NewScreen
  Sel = 9
  WrongM = 0
  for Dk = 0 to 3
    FrameBox(Dk)
    LabelBox(Dk)
  next
  print at 2,1, "PLAYER " + str$(Cp + 1) + ", GET SET..."
  ShowScreen
  return
end sub

' Pct(I): % correct as line 2080 counts it
function Pct(u8 Pk) as u8
  u16 G = 0
  u16 W = 0
  G = P[Pk].Gs
  if G = 0 then return 0
  W = G - P[Pk].Rd
  W = W * 100 / G
  return 100 - W

' Results: the table and the winner
sub Results:
  u8 Rk = 0
  u8 Ry = 0
  Ph = 4
  NewScreen
  play sound SndDone
  print at 4,2, "MATCH MANIA GAME RESULTS"
  print at 2,5, "PLAYER  RNDS GUESS  %  TIME"
  for Rk = 0 to Np - 1
    P[Rk].Pc = Pct(Rk)
  next
  for Rk = 0 to Np - 1
    Ry = Rk * 2 + 7
    print at 2,Ry, "PLAYER " + str$(Rk + 1)
    print P[Rk].Rd at 11,Ry width 3
    print P[Rk].Gs at 16,Ry width 3
    print P[Rk].Pc at 20,Ry width 3
    print P[Rk].Tm at 24,Ry width 5
  next
  print at 3,12, "TIME: +45 SEC A WRONG GUESS"
  Winner = 0
  if Np = 1 then
    if P[0].Pc >= 75 then
      Winner = 1
      print at 6,15, "SHARP EYES! YOU WIN"
    else
      print at 7,15, "TOO MANY GUESSES"
      print at 5,17, "75% CORRECT TO WIN"
    end if
  else
    if WinBy = 0 then
      if P[0].Tm < P[1].Tm then Winner = 1
      if P[1].Tm < P[0].Tm then Winner = 2
      print at 8,17, "WINNER BY TIME"
    else
      if P[0].Pc > P[1].Pc then Winner = 1
      if P[1].Pc > P[0].Pc then Winner = 2
      print at 6,17, "WINNER BY % CORRECT"
    end if
    if Winner = 0 then
      print at 11,15, "A TIE!"
    else
      print at 6,15, "WINNER: PLAYER " + str$(Winner)
    end if
  end if
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' ReadMenu: like ReadPad, the stick counts once per push
sub ReadMenu:
  ReadPad
  V = Lf1 | Rt1 | Up1 | Dn1
  if V = 1 then
    if WasStick = 1 then
      Lf1 = 0
      Rt1 = 0
      Up1 = 0
      Dn1 = 0
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo (one odd cell), the settings
sub TitlePage:
  u8 Lx = 0
  u8 Ly = 0
  u8 Lv = 0
  u16 Li = 0
tp_again:
  Mi = 4
  NewScreen
  Li = 0
  for Ly = 0 to 10
    for Lx = 0 to 27
      Lv = Logo[Li]
      if Lv = 1 then put char TLc at Lx + 2,Ly + 1
      if Lv = 2 then put char TLm at Lx + 2,Ly + 1
      inc Li
    next
  next
  print at 5,13, "PLAYERS"
  print at 5,14, "CHARACTERS"
  print at 5,15, "LINES"
  print at 5,16, "WINNER BY"
  print at 5,17, "START"
  print at 5,18, "HOW TO PLAY"
  print at 5,19, "CREDITS"
  print at 2,21, "UP/DOWN: CHOOSE  LEFT/RIGHT:"
  print at 2,22, "CHANGE  BUTTON: START"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 462
  TzOn = 1
  Ph = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadMenu
  Rnd16
  V = 0
  if Up1 = 1 then
    if Mi > 0 then dec Mi
    V = 1
  end if
  if Dn1 = 1 then
    if Mi < 6 then inc Mi
    V = 1
  end if
  if Lf1 = 1 then
    select case Mi
    case 0
      Np = 1
    case 1
      if Lm > 1 then dec Lm
    case 2
      if Ln > 1 then dec Ln
    case 3
      WinBy = 0
    end select
    V = 1
  end if
  if Rt1 = 1 then
    select case Mi
    case 0
      Np = 2
    case 1
      if Lm < 12 then inc Lm
    case 2
      if Ln < 6 then inc Ln
    case 3
      WinBy = 1
    end select
    V = 1
  end if
  if V = 1 then
    play sound SndMove
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Mi < 4 then
    Mi = 4
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Mi = 5 then
    HowToPage
    goto tp_again
  end if
  if Mi = 6 then
    Mi = 4
    CreditsPage
    goto tp_again
  end if
  return
end sub

' ShowMenu: the arrow and the values
sub ShowMenu:
  for J = 13 to 19
    put char 32 at 3,J
  next
  put char 62 at 3,Mi + 13
  print Np at 17,13 width 2
  print Lm at 17,14 width 2
  print Ln at 17,15 width 2
  fill 32 count 12 at 17,16
  if Np = 1 then
    print at 18,16, "-"
  else
    if WinBy = 0 then
      print at 18,16, "TIME"
    else
      print at 18,16, "% CORRECT"
    end if
  end if
  return
end sub

' HtBox(B): a small box for the HOW TO PLAY page at column X, row Y in
' frame colour V; box B has the odd character
sub HtBox(u8 Hb):
  u8 Hi = 0
  K = V * 6 + TFbh
  fill K count 4 at X + 1,Y
  fill K count 4 at X + 1,Y + 3
  put char K + 1 at X,Y + 1
  put char K + 1 at X,Y + 2
  put char K + 1 at X + 5,Y + 1
  put char K + 1 at X + 5,Y + 2
  put char K + 2 at X,Y
  put char K + 3 at X + 5,Y
  put char K + 4 at X,Y + 3
  put char K + 5 at X + 5,Y + 3
  for Hi = 0 to 3
    put char TSq at X + 1 + Hi,Y + 1
    put char TSw at X + 1 + Hi,Y + 2
  next
  put char TSq at X + 2,Y + 2
  if Hb = 2 then put char TSw at X + 3,Y + 1
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "FOUR BOXES SHOW THE SAME"
    print at 2,4, "PATTERN OF LOOK-ALIKE"
    print at 2,5, "SHAPES. IN ONE BOX, ONE"
    print at 2,6, "SHAPE IS DIFFERENT."
    print at 2,8, "FIND THAT BOX! MOVE THE"
    print at 2,9, "YELLOW FRAME WITH THE"
    print at 2,10, "JOYSTICK, PRESS A BUTTON."
    for J = 0 to 3
      X = J * 7 + 2
      Y = 13
      V = J & 1
      if J = 2 then V = 2
      HtBox(J)
    next
    print at 2,18, "HERE BOX 3 IS THE ODD ONE:"
    print at 2,19, "ITS TOP LINE HAS A W."
  else
    print at 2,1, "SCORING                2/2"
    print at 2,3, "THE CLOCK RUNS WHILE YOU"
    print at 2,4, "LOOK. EACH WRONG GUESS"
    print at 2,5, "ADDS 45 SECONDS AND MARKS"
    print at 2,6, "THAT BOX NO."
    print at 2,8, "THERE ARE 11 ROUNDS. THEN"
    print at 2,9, "THE GAME ENDS. ONE PLAYER"
    print at 2,10, "WINS IF 75% OF HIS OR HER"
    print at 2,11, "GUESSES ARE RIGHT. TWO"
    print at 2,12, "PLAYERS TAKE TURNS: LESS"
    print at 2,13, "TIME (OR MORE %) WINS."
    print at 2,15, "ON THE TITLE YOU CAN SET"
    print at 2,16, "PLAYERS, CHARACTERS, LINES."
    print at 2,18, "TIP: LOOK AT ONE LINE IN"
    print at 2,19, "ALL FOUR BOXES AT ONCE."
  end if
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  HtWt = 0
ht_wait:
  Frame1
  ReadMenu
  inc HtWt
  if HtWt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill TFbh count 28 at 2,2
  fill TFbh count 28 at 2,21
  print at 10,4, "MATCH MANIA"
  print at 3,6, "BASED ON MATCH MANIA,"
  print at 3,7, "COMPUTE!'S GAZETTE,"
  print at 3,8, "JUNE 1989 (C64)."
  print at 3,10, "MADE FOR THE COLECOVISION"
  print at 3,11, "BY CLAUDE (AN AI MADE BY"
  print at 3,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,13, "2026, IN AMY (THE LANGUAGE"
  print at 3,14, "BY AMY BIENVENU)."
  print at 3,16, "MUSIC: ODD ONE OUT."
  print at 8,19, "PRESS A BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 462
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Ph = 9
cr_loop:
  Frame1
  ReadMenu
  Rnd16
  if Press = 0 then goto cr_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

asm {
MmMove:
    db $40,$55,$60,$01,$50
MmNope:
    db $40,$93,$50,$03,$40,$93,$30,$03,$50
MmWrong:
    db $40,$53,$51,$06,$40,$C5,$41,$08,$50
MmRight:
    db $40,$6B,$30,$03,$40,$55,$30,$03,$40,$47,$30,$03,$40,$35,$40,$08,$50
MmShow:
    db $40,$7F,$40,$01,$40,$40,$30,$01,$50
MmDone:
    db $40,$8F,$30,$06,$40,$6B,$30,$06,$40,$55,$30,$06,$40,$47,$30,$0C,$50

MmSoundTable:
    dw MmTuneMel,$702B
    dw MmTuneBass,$7035
    dw MmMove,$7049
    dw MmNope,$7049
    dw MmWrong,$7049
    dw MmRight,$7049
    dw MmShow,$7049
    dw MmDone,$7049
; Odd One Out (original)
; Tiny Sound, 7 frames per step
MmTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$1A,$21,$23,$01,$26,$01,$23,$01,$26,$01,$23,$01,$26,$01
    db $25,$01,$01,$01,$21,$01,$1E,$01,$21,$01,$1E,$01,$21,$01,$1E,$01
    db $1F,$01,$01,$01,$1C,$01,$1F,$01,$23,$01,$28,$01,$26,$01,$23,$01
    db $21,$01,$1F,$01,$1E,$01,$1A,$01,$1E,$01,$21,$01,$26,$01,$01,$01
    db $01,$01,$00,$01,$01,$01
    db $FF
MmTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$13,$01,$0E,$01,$13,$01,$0E,$01,$13,$01,$0E,$01
    db $15,$01,$01,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $17,$01,$01,$01,$10,$01,$17,$01,$10,$01,$17,$01,$13,$01,$0E,$01
    db $13,$01,$0E,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$0E,$01,$01,$01
    db $01,$01,$00,$01,$01,$01
    db $FF
}
