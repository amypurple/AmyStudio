cartridge "BEEHIVE/STEVE MICHEL, COMPUTE!/1986"

' BEEHIVE
' Based on "Beehive" by Steve Michel, COMPUTE! September 1986 (pages
' 31-43): a two-player strategy game for the 512K Amiga, with versions for
' the Commodore 64/128 and Atari (Kevin Mykytyn), Apple II (Tim Victor)
' and IBM PC/PCjr (Patrick Parrish). Made for the ColecoVision in Amy (the
' language by Amy Bienvenu) by Claude (an AI made by Anthropic) for Amy
' Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the listings' rules
' (orig/ has the scans). The game is the connection game also known as
' Hex: 121 hexagons in a sloping 11 x 11 rhombus; red joins its two
' borders (the listings' columns 0 and 10), blue its two (rows 0 and 10);
' players fill any empty cell in turn; the first to join both borders
' wins (there are no draws), and tiny bee faces mark the winning path.
' The first player is chosen at random (as the Amiga and IBM versions).
' Made for this machine: the rhombus turned on its point so it fills the
' screen, each cell a 2 x 1 tile hexagon, the borders coloured by player;
' a bee cursor flying from cell to cell; the winning path lit up cell by
' cell with a buzz; a computer opponent; an optional swap rule (after the
' first stone, the second player may take it over, mirrored, instead of
' moving: it keeps the first player from simply taking the centre);
' music under play, quieter than the effects; an original title tune,
' "Honey Gold".
'
' Controls: the stick moves the bee (up-left, up-right, down-left and
' down-right are the four slanted neighbours; left and right the two
' side neighbours; up and down jump two rows straight); the left button
' fills the cell; the right button swaps (when the swap rule allows it)
' and, after a game, returns to the title. Two players: red is joystick 1,
' blue joystick 2; against the computer you are red (either joystick).
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const THexe00 = 128
const THexe01 = 129
const THexr00 = 130
const THexr01 = 131
const THexb00 = 132
const THexb01 = 133
const TEdger00 = 134
const TEdger01 = 135
const TEdgeb00 = 136
const TEdgeb01 = 137
const THexf00 = 138
const THexf01 = 139
const SStripes = 0
const SBody = 4
const SWingup = 8
const SWingdn = 12
const NTiles8 = 96
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndPlayA = 3
const SndPlayB = 4
const SndStep = 5
const SndPlop = 6
const SndNope = 7
const SndBzz = 8
const SndHum = 9
const SndSwap = 10
const SndWin = 11
const SndPick = 12
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the board: B[R*11+C] 0 empty, 1 red, 2 blue
u8 B[121]
' scratch for the distances, the computer's scores and the winning path
u8 D1[121]
u8 D2[121]
' (the computer's costs for blue are kept in free video memory, at
' vram.spr_pat + 1024: there is no room left in RAM)
u8 Stk[121]
' Pl the player to move (1 red, 2 blue); Mv stones placed; Cur the bee's
' cell; Ph 1 a player moving, 2 the computer, 3 the game won
u8 Pl = 1
u8 Mv = 0
u8 Cur = 60
u8 Ph = 0
' Mode 0 one player (you are red), 1 two players; Swp the swap rule
u8 Mode = 0
u8 Swp = 0
u8 Swapped = 0
u8 WinR = 0
u8 WinB = 0
u8 Winner = 0
u8 PathN = 0
' the last move, for the tests: Last the cell, Ai the computer's cell
u8 Last = 255
u8 Ai = 255
' the bee on screen (pixels) and its target
u8 Bx = 120
u8 By = 80
u8 Gx = 120
u8 Gy = 80
u8 Flap = 0

' the distance search: Dp the player, Lv the level, Sp the stack
u8 Dp = 0
u8 Lv = 0
u8 Sp = 0
u8 Hd = 0
u8 Pend = 0
u8 Cst = 0
u8 Nd = 0
u8 Nn = 0
u8 Ii = 0
u8 Kk = 0
u8 Ee = 0
u16 A16 = 0
u16 T16 = 0
u8 Ma = 0
u8 Mb = 0
u8 Bs = 0
u8 Bi = 0
u8 Ties = 0
u8 Sa = 0
u8 Sb = 0
u8 Sc = 0

u16 NumU = 0
u8 Menu = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
u8 Tm = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 C = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Idle = 0

  tile screen
  set sound table HvSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title
  Mode = Menu
  WinR = 0
  WinB = 0

new_game:
  for I = 0 to 120
    B[I] = 0
  next
  Mv = 0
  Swapped = 0
  Last = 255
  Ai = 255
  Cur = 60
  Pl = random(1, 2)
  DrawBoard
  ShowHud
  CurPix
  Bx = Gx
  By = Gy
  ShowScreen
  play sound SndPlayA
  play sound SndPlayB

turn:
  ShowTurn
  if Mode = 1 then goto human
  if Pl = 1 then goto human
  ' the computer (blue)
  Ph = 2
  print at 2,22, "      BLUE IS THINKING      "
  Frame1
  DrawBee
  AiPick
  ' a swap is the computer's answer to a strong first stone
  if Ai = 255 then
    DoSwap
    goto next_turn
  end if
  ' it flies the bee to its cell, then fills it
  Cur = Ai
  CurPix
  for Tm = 1 to 90
    Frame1
    DrawBee
    if Bx = Gx then
      if By = Gy then Tm = 90
    end if
  next
  for Tm = 1 to 12
    Frame1
    DrawBee
  next
  PlaceAt(Ai)
  goto after_move

human:
  Ph = 1
  WasBtn = 1
  WasBtn2 = 1
  Rep = 0
human_loop:
  Frame1
  ReadPad
  DrawBee
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 0 then
    Rep = 0
  else
    if Rep = 0 then
      Steer
      Rep = 10
    else
      dec Rep
    end if
  end if
  if Press2 = 1 then
    if Mv = 1 then
      if Swp = 1 then
        if Swapped = 0 then
          DoSwap
          goto next_turn
        end if
      end if
    end if
  end if
  if Press = 0 then goto human_loop
  if B[Cur] <> 0 then
    play sound SndNope
    goto human_loop
  end if
  PlaceAt(Cur)

after_move:
  Won(Pl)
  if Winner <> 0 then goto game_won
next_turn:
  Pl = 3 - Pl
  goto turn

game_won:
  Ph = 3
  stop sound SndPlayA
  stop sound SndPlayB
  mute all
  WinPath(Winner)
  ' the path lights up, cell by cell, from one border to the other
  N = PathN
show_path:
  if N = 0 then goto path_done
  dec N
  I = D1[N]
  X = Sx[I]
  Y = Sy[I]
  put char THexf00 at X,Y
  W = X + 1
  put char THexf01 at W,Y
  Cur = I
  CurPix
  play sound SndBzz
  play sound SndHum
  for Tm = 1 to 8
    Frame1
    DrawBee
  next
  goto show_path
path_done:
  play sound SndWin
  if Winner = 1 then
    inc WinR
    print at 2,22, "  RED WINS!  BUTTON: AGAIN  "
  else
    inc WinB
    print at 2,22, "  BLUE WINS! BUTTON: AGAIN  "
  end if
  ShowWins
  WasBtn = 1
  WasBtn2 = 1
won_wait:
  Frame1
  ReadPad
  DrawBee
  if Press2 = 1 then goto title
  if Press = 0 then goto won_wait
  goto new_game

' PlaceAt(Q): the player to move fills cell Q
sub PlaceAt(u8 Q):
  B[Q] = Pl
  Last = Q
  inc Mv
  DrawCell(Q)
  play sound SndPlop
  return
end sub

' DoSwap: the second player takes over the first stone, mirrored across
' the rhombus' long diagonal (row and column exchanged), in their colour
sub DoSwap:
  for I = 0 to 120
    if B[I] <> 0 then J = I
  next
  B[J] = 0
  DrawCell(J)
  R = Rw[J]
  C = Cl[J]
  K = C * 11
  K = K + R
  B[K] = Pl
  Last = K
  Swapped = 1
  inc Mv
  DrawCell(K)
  Cur = K
  CurPix
  play sound SndSwap
  return
end sub

' Steer: move the bee one cell the way the stick points
sub Steer:
  R = Rw[Cur]
  C = Cl[Cur]
  ' each axis 0 (minus one), 1 (stays) or 2 (plus one)
  J = 1
  K = 1
  if Up1 = 1 then
    if Lf1 = 1 then
      K = 0
    elseif Rt1 = 1 then
      J = 0
    else
      J = 0
      K = 0
    end if
  elseif Dn1 = 1 then
    if Lf1 = 1 then
      J = 2
    elseif Rt1 = 1 then
      K = 2
    else
      J = 2
      K = 2
    end if
  elseif Lf1 = 1 then
    J = 2
    K = 0
  elseif Rt1 = 1 then
    J = 0
    K = 2
  end if
  ' stay on the board
  if J = 0 then
    if R = 0 then return
  end if
  if J = 2 then
    if R = 10 then return
  end if
  if K = 0 then
    if C = 0 then return
  end if
  if K = 2 then
    if C = 10 then return
  end if
  R = R + J
  R = R - 1
  C = C + K
  C = C - 1
  V = R * 11
  Cur = V + C
  CurPix
  play sound SndStep
  return
end sub

' CurPix: the bee's target over cell Cur
sub CurPix:
  V = Sx[Cur]
  Gx = V << 3
  V = Sy[Cur]
  V = V << 3
  Gy = V - 6
  return
end sub

' DrawBee: the bee flies toward its target, flapping its wings
sub DrawBee:
  if Bx < Gx then
    V = Gx - Bx
    if V > 3 then V = 3
    Bx = Bx + V
  elseif Bx > Gx then
    V = Bx - Gx
    if V > 3 then V = 3
    Bx = Bx - V
  end if
  if By < Gy then
    V = Gy - By
    if V > 3 then V = 3
    By = By + V
  elseif By > Gy then
    V = By - Gy
    if V > 3 then V = 3
    By = By - V
  end if
  inc Flap
  set sprite 0 to By,Bx,SStripes,1
  set sprite 1 to By,Bx,SBody,11
  V = Flap & 4
  if V = 0 then
    set sprite 2 to By,Bx,SWingup,15
  else
    set sprite 2 to By,Bx,SWingdn,15
  end if
  update sprites
  return
end sub

' DrawCell(Q): cell Q as it is now
sub DrawCell(u8 Q):
  X = Sx[Q]
  Y = Sy[Q]
  V = B[Q]
  if V = 0 then
    W = THexe00
  elseif V = 1 then
    W = THexr00
  else
    W = THexb00
  end if
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub DrawBoard:
  NewScreen
  for I = 0 to 120
    DrawCell(I)
  next
  for I = 0 to 39
    X = BdX[I]
    Y = BdY[I]
    V = BdK[I]
    if V = 0 then
      W = TEdger00
    else
      W = TEdgeb00
    end if
    put char W at X,Y
    inc W
    inc X
    put char W at X,Y
  next
  return
end sub

' the corners: red's name top left (its borders run top left and bottom
' right), blue's top right
sub ShowHud:
  put char THexr00 at 2,1
  put char THexr01 at 3,1
  print at 5,1, "RED"
  put char THexb00 at 22,1
  put char THexb01 at 23,1
  print at 25,1, "BLUE"
  if Mode = 0 then
    print at 2,2, "YOU"
    print at 22,2, "COMPUTER"
  else
    print at 2,2, "JOY 1"
    print at 25,2, "JOY 2"
  end if
  ShowWins
  if Swp = 1 then
    print at 2,20, "SWAP"
    print at 2,21, "RULE"
  end if
  return
end sub

sub ShowWins:
  NumU = WinR
  print at 2,3, digits$(NumU, 2)
  NumU = WinB
  print at 27,3, digits$(NumU, 2)
  return
end sub

sub ShowTurn:
  if Pl = 1 then
    print at 2,22, "        RED TO MOVE         "
  else
    print at 2,22, "        BLUE TO MOVE        "
  end if
  if Mv = 1 then
    if Swp = 1 then
      if Swapped = 0 then
        print at 2,22, "  MOVE, OR RIGHT BTN: SWAP  "
      end if
    end if
  end if
  return
end sub

' Dist(P, Sd, Own): D1 = the cost for player P to reach each cell from its
' border Sd (0 or 1): its own cells cost 0, empty cells 1 (or, with Own 1,
' cannot be used), the other player's cells cannot be used; 255 out of
' reach. Level by level: every cell at level Lv is spread to its
' neighbours; a neighbour of P's colour joins the same level at once.
sub Dist(u8 P, u8 Sd, u8 Own):
  Dp = P
  for Ii = 0 to 120
    D1[Ii] = 255
  next
  Ee = P - 1
  Ee = Ee * 22
  if Sd = 1 then Ee = Ee + 11
  for Kk = 0 to 10
    Nn = Ed[Ee]
    inc Ee
    V = B[Nn]
    if V = P then
      D1[Nn] = 0
    elseif V = 0 then
      if Own = 0 then D1[Nn] = 1
    end if
  next
  Lv = 0
dist_level:
  Sp = 0
  Pend = 0
  for Ii = 0 to 120
    V = D1[Ii]
    if V = Lv then
      Stk[Sp] = Ii
      inc Sp
    elseif V < 255 then
      if V > Lv then Pend = 1
    end if
  next
  if Sp = 0 then
    if Pend = 0 then return
  end if
dist_pop:
  if Sp = 0 then goto dist_next
  dec Sp
  Ii = Stk[Sp]
  A16 = Ii
  A16 = A16 << 1
  T16 = A16
  A16 = A16 << 1
  A16 = A16 + T16
  for Kk = 0 to 5
    Nn = Nbr[A16]
    inc A16
    if Nn < 255 then
      V = B[Nn]
      Cst = 9
      if V = Dp then
        Cst = 0
      elseif V = 0 then
        if Own = 0 then Cst = 1
      end if
      if Cst < 9 then
        Nd = Lv + Cst
        V = D1[Nn]
        if Nd < V then
          D1[Nn] = Nd
          if Cst = 0 then
            Stk[Sp] = Nn
            inc Sp
          end if
        end if
      end if
    end if
  next
  goto dist_pop
dist_next:
  inc Lv
  if Lv > 200 then return
  goto dist_level
end sub

' Won(P): Winner = P if P's cells join both its borders
sub Won(u8 P):
  Winner = 0
  Dist(P, 0, 1)
  Ee = P - 1
  Ee = Ee * 22
  Ee = Ee + 11
  for Kk = 0 to 10
    Nn = Ed[Ee]
    inc Ee
    V = D1[Nn]
    if V = 0 then Winner = P
  next
  return
end sub

' WinPath(P): a shortest chain of P's cells from its first border to its
' second, into D1[0 .. PathN-1] (from the second border back to the
' first): a breadth-first search with each cell's parent in D2
sub WinPath(u8 P):
  for Ii = 0 to 120
    D2[Ii] = 255
  next
  Sp = 0
  Hd = 0
  Ee = P - 1
  Ee = Ee * 22
  for Kk = 0 to 10
    Nn = Ed[Ee]
    inc Ee
    V = B[Nn]
    if V = P then
      D2[Nn] = 254
      Stk[Sp] = Nn
      inc Sp
    end if
  next
wp_pop:
  if Hd = Sp then goto wp_end
  Ii = Stk[Hd]
  inc Hd
  A16 = Ii
  A16 = A16 << 1
  T16 = A16
  A16 = A16 << 1
  A16 = A16 + T16
  for Kk = 0 to 5
    Nn = Nbr[A16]
    inc A16
    if Nn < 255 then
      V = B[Nn]
      if V = P then
        V = D2[Nn]
        if V = 255 then
          D2[Nn] = Ii
          Stk[Sp] = Nn
          inc Sp
        end if
      end if
    end if
  next
  goto wp_pop
wp_end:
  ' the first cell of the second border reached, then back to the first
  Ee = P - 1
  Ee = Ee * 22
  Ee = Ee + 11
  Ii = 255
  for Kk = 0 to 10
    Nn = Ed[Ee]
    inc Ee
    if Ii = 255 then
      V = D2[Nn]
      if V < 255 then Ii = Nn
    end if
  next
  PathN = 0
wp_back:
  if Ii = 255 then return
  D1[PathN] = Ii
  inc PathN
  V = D2[Ii]
  if V = 254 then return
  Ii = V
  goto wp_back
end sub

' AiPick: the computer (blue) chooses Ai (255: swap). For each empty cell,
' how much a chain through it still costs each side (Ta for blue, D2 for
' red, from two distance maps each, one from each border). It wins at once
' if it can, blocks a cell that would win for red, and otherwise takes a
' cell on both players' shortest chains (the smallest sum of the two
' costs above each side's best), nearer the middle on a tie, then at
' random among equals. Its first stone (with the swap rule) is a modest
' one away from the middle; it swaps a first stone near the middle.
sub AiPick:
  if Mv = 0 then
    if Swp = 0 then
      Ai = 60
      return
    end if
    R = random(1, 9)
    V = random(0, 1)
    C = V * 9
    C = C + 1
    V = R * 11
    Ai = V + C
    return
  end if
  if Mv = 1 then
    if Swp = 1 then
      for I = 0 to 120
        if B[I] <> 0 then J = I
      next
      Sa = Far(J)
      if Sa < 5 then
        Ai = 255
        return
      end if
    end if
  end if
  ' blue's costs
  Dist(2, 0, 0)
  for I = 0 to 120
    Stk[I] = D1[I]
  next
  copy Stk count 121 to vram.spr_pat + 1024
  Dist(2, 1, 0)
  for I = 0 to 120
    D2[I] = D1[I]
  next
  ' (D2 now blue's second map; the first is in video memory)
  Ma = 250
  for I = 0 to 120
    V = 250
    A16 = I
    vpeek vram.spr_pat + 1024 + A16 into Sa
    if B[I] = 0 then
      Sb = D2[I]
      if Sa < 200 then
        if Sb < 200 then
          V = Sa + Sb
          V = V - 1
          if V > 60 then V = 60
        end if
      end if
    end if
    Stk[I] = V
    if V < Ma then Ma = V
  next
  copy Stk count 121 to vram.spr_pat + 1024
  ' red's costs
  Dist(1, 0, 0)
  for I = 0 to 120
    D2[I] = D1[I]
  next
  Dist(1, 1, 0)
  Mb = 250
  for I = 0 to 120
    V = 250
    if B[I] = 0 then
      Sa = D2[I]
      Sb = D1[I]
      if Sa < 200 then
        if Sb < 200 then
          V = Sa + Sb
          V = V - 1
          if V > 60 then V = 60
        end if
      end if
    end if
    D2[I] = V
    if V < Mb then Mb = V
  next
  ' a win now
  if Ma = 1 then
    for I = 0 to 120
      A16 = I
      vpeek vram.spr_pat + 1024 + A16 into V
      if V = 1 then Ai = I
    next
    return
  end if
  ' the best cell: the smallest (Ta - Ma) + (D2 - Mb), red's threat
  ' first if red would win next move
  Bs = 255
  Ai = 255
  Ties = 0
  for I = 0 to 120
    if B[I] = 0 then
      A16 = I
      vpeek vram.spr_pat + 1024 + A16 into Sa
      Sb = D2[I]
      Sc = 0
      if Sa < 250 then
        Sc = Sa - Ma
      else
        Sc = 70
      end if
      if Sb < 250 then
        V = Sb - Mb
        Sc = Sc + V
      else
        Sc = Sc + 70
      end if
      if Mb = 1 then
        if Sb <> 1 then Sc = Sc + 100
      end if
      Sc = Sc << 1
      V = Far(I)
      V = V >> 2
      Sc = Sc + V
      if Sc < Bs then
        Bs = Sc
        Ai = I
        Ties = 1
      elseif Sc = Bs then
        inc Ties
        V = random(1, Ties)
        if V = 1 then Ai = I
      end if
    end if
  next
  return
end sub

' Far(Q): how far cell Q is from the middle (|R-5| + |C-5|)
function Far(u8 Q) as u8
  R = Rw[Q]
  C = Cl[Q]
  if R < 5 then
    V = 5 - R
  else
    V = R - 5
  end if
  if C < 5 then
    W = 5 - C
  else
    W = C - 5
  end if
  V = V + W
  return V

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: the stick and the buttons of the player to move (two players:
' red is joystick 1, blue joystick 2; otherwise either joystick)
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  V = 1
  W = 1
  if Mode = 1 then
    if Ph = 1 then
      if Pl = 1 then W = 0
      if Pl = 2 then V = 0
    end if
  end if
  if V = 1 then
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).button1 then Btn = 1
    if joypad(1).button2 then Btn2 = 1
  end if
  if W = 1 then
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).button1 then Btn = 1
    if joypad(2).button2 then Btn2 = 1
  end if
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a strip of honeycomb, the bee flying over it, a menu
sub TitlePage:
  NewScreen
  for X = 3 to 27 step 2
    put char THexe00 at X,4
    W = X + 1
    put char THexe01 at W,4
  next
  for X = 4 to 26 step 2
    put char THexe00 at X,5
    W = X + 1
    put char THexe01 at W,5
  next
  put char THexr00 at 9,4
  put char THexr01 at 10,4
  put char THexb00 at 16,5
  put char THexb01 at 17,5
  put char THexr00 at 21,4
  put char THexr01 at 22,4
  print at 12,2, "BEEHIVE"
  print at 4,7, "JOIN YOUR TWO BORDERS"
  print at 4,8, "BEFORE THE OTHER BEE DOES"
  print at 9,11, "1 PLAYER"
  print at 9,12, "2 PLAYERS"
  print at 9,13, "SWAP RULE"
  print at 9,14, "CREDITS"
  put char TEdger00 at 3,17
  put char TEdger01 at 4,17
  print at 6,17, "RED: TOP LEFT AND"
  print at 6,18, "BOTTOM RIGHT BORDERS"
  put char TEdgeb00 at 3,20
  put char TEdgeb01 at 4,20
  print at 6,20, "BLUE: TOP RIGHT AND"
  print at 6,21, "BOTTOM LEFT BORDERS"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Mode = 0
  Ph = 0
  Bx = 40
  By = 60
  Gx = 200
  Gy = 60
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
tp_loop:
  Frame1
  ReadPad
  ' the bee flies to and fro over the honeycomb
  if Bx = Gx then
    if Gx = 200 then
      Gx = 40
    else
      Gx = 200
    end if
    V = random(0, 3)
    V = V << 3
    Gy = 52 + V
  end if
  DrawBee
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 3 then inc Menu
      end if
      play sound SndPick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 2 then
    Swp = Swp ^ 1
    play sound SndPick
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 11 to 14
    put char 32 at 7,J
  next
  V = Menu + 11
  put char 62 at 7,V
  if Swp = 1 then
    print at 19,13, "ON "
  else
    print at 19,13, "OFF"
  end if
  return
end sub

sub CreditsPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  for X = 3 to 27 step 2
    put char THexe00 at X,2
    W = X + 1
    put char THexe01 at W,2
    put char THexe00 at X,21
    W = X + 1
    put char THexe01 at W,21
  next
  print at 12,4, "BEEHIVE"
  print at 3,6, "BASED ON BEEHIVE BY STEVE"
  print at 3,7, "MICHEL, COMPUTE! SEPTEMBER"
  print at 3,8, "1986 (AMIGA; VERSIONS BY"
  print at 3,9, "KEVIN MYKYTYN, TIM VICTOR"
  print at 3,10, "AND PATRICK PARRISH)."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY BIENVENU."
  print at 3,17, "MUSIC: HONEY GOLD,"
  print at 3,18, "WAGGLE DANCE"
  print at 8,19, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

