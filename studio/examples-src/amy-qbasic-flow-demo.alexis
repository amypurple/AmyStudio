u8 Counter = 0
u8 Sum = 0
u8 WhileCount = 0
u8 Done = 0

' Amy QBASIC Flow Demo
  text screen
  run_demo
  screen on
MainLoop:
  wait
  goto MainLoop

sub run_demo:
  print at 7,0, "AMY QBASIC FLOW"
  print at 1,4, "COUNT"
  print at 1,6, "STATUS"
  print at 1,8, "SUM"
  print at 1,10, "SKIP"
  print at 1,12, "WHILE"
  do
    Counter += 1
    if Counter = 1 then
      continue do
    end if
    if Counter = 3 then
      exit do
    end if
  loop
  for Counter = 1 to 5
    if Counter = 2 then
      continue for
    end if
    Sum += Counter
    if Counter = 3 then
      exit for
    end if
  next
  while WhileCount < 5
    WhileCount += 1
    if WhileCount = 2 then
      continue while
    end if
    if WhileCount = 3 then
      exit while
    end if
  end while
  print Counter at 8,4 digits 3
  if Counter = 3 then
    Done = 1
  else
    Done = 0
  end if
  print Sum at 8,8 digits 3
  print 1 at 8,10 digits 3
  print WhileCount at 8,12 digits 3
  if Done then
    print at 8,6, "PASS"
  else
    print at 8,6, "FAIL"
  end if
  return