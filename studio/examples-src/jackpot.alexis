cartridge "JACKPOT/PRESENTS RICK ROTHSTEIN'S/1984"

' JACKPOT
' By Rick Rothstein, COMPUTE! magazine, August 1984 (versions for the
' TI-99/4A with Extended BASIC, Commodore 64, VIC-20, Atari and IBM PC/PCjr).
' This port follows "Program 1: TI-99/4A Jackpot". All credit belongs to
' Rick Rothstein.
'
' Historical context (summary of the article):
' A trip to Atlantic City, and a losing streak at the one-arm bandits,
' inspired this simulation: all the lights and suspense of a slot machine,
' none of the risk. Three windows show cherries, limes, plums, bells, bars
' or lucky sevens, each picked from a 20-stop wheel. How often a symbol
' appears on each wheel sets the odds: level one pays like a real casino,
' level two leans your way, and level three, in the long run, hands you the
' casino. The TI version redefines all 112 Extended BASIC characters, fills
' the screen with a recolored cursor character for a background that no
' other character can disturb, builds the pictures as strings for fast
' DISPLAY AT statements, and uses three magnified sprites, invisible during
' play, to show the level number in the windows.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: fire plays (TI key P); keypad * changes the level (TI AID);
' keypad # resets the money to even (TI REDO). While choosing a level,
' keypad 1-3 or the joystick picks it (TI space bar) and fire starts
' (TI ENTER). The TI S key, which ended the program, is not needed.
' Adaptation liberties: the 112 TI characters live at codes 144-255 (TI
' code + 112) and the background uses tile 136, so nothing depends on the
' ASCII font; the reels spin and slow down before each clunk instead of
' popping up; a soft click while they turn; the money line moves up one
' row, out of the bottom overscan; the key help line is rewritten for the
' controller; an editorial page at power-on.
' TI rows/columns are 1-based. DISPLAY AT(R,C): Amy X = C + 1, Y = R - 1.
' Sprites: dot-row R, dot-column C become Y = R - 2, X = C - 1.

const BackTile = 136           ' TI char 30, the recolored cursor
const StatusY = 22             ' TI row 24, moved up one row

' Sound table slots (jp/s.mjs)
const SndSpin = 1
const SndClunk = 2
const SndTick = 3
const SndCoinA = 4
const SndCoinB = 5
const SndCoinC = 6
const SndSirenUp = 7
const SndSirenDown = 8
const SndBeep = 9

u8 Level = 1                   ' LEVEL - 48
i16 Total = 0                  ' TOTAL
u8 Coins = 0                   ' COINS
u8 Pick[3]                     ' PICK(1-3)
u8 T[3]                        ' strip row at the top of each window
u8 Left[3]                     ' strip rows still to turn
u8 Slow[3]
u8 K = 0
u8 I = 0
u8 J = 0
u8 R = 0
u8 P = 0
u8 X = 0
u8 Y = 0
u8 N = 0
u8 Line = 0
u8 Off = 0
u8 WB = 0
u8 Tg = 0
u8 Need = 0
u8 Running = 0
u8 TickT = 0
u8 Choice = 0
u8 Len = 0
u8 Half = 0
u16 Mag = 0
u8 Dg[6]

  text screen
  nmi off
  set sound table JackpotSoundTable areas 4
  sprites 8x8
  sprites double
  copy LevelSprites count 24 to vram.spr_pat
  copy TiChars count 896 to vram.pattern + 1152
  fill 0 count 8 to vram.pattern + 1088
  HideLevel
  screen on
  EditorialPage

  ' --- Lines 100-130 ---
  set text colors black count 32
  backdrop light yellow
  fill BackTile count 768 to vram.name
  vpoke vram.color + 17, $BB
  ' Lines 110-120: the colors of TI sets 1-14
  for I = 0 to 13
    vpoke vram.color + 18 + I, SetColors[I]
  next
  ' Black on white for the controller help (ASCII)
  set text colors black on white at 4 count 8
  Level = 1
  Total = 0
  T[0] = 119
  T[1] = 119
  T[2] = 119
  ' --- Lines 640-710 ---
  put BorderRow count 25 at 3,0
  ClearWindows
  put BorderRow count 25 at 3,8
  Off = 0
  for Y = 10 to 20
    put ChartRows + Off count 25 at 3,Y
    Off += 25
  next
  print at 3,21, "FIRE=PLAY *=LEVEL #=RESET"
  ' Line 730: KEY=1 :: GOTO 160, the game starts by asking for a level
  goto choose_level

' --- Lines 140-160 ---
main_wait:
  wait no fire
key_wait:
  wait
  if joypad(1).fire then goto play_round
  Choice = keypad(1)
  if Choice = 10 then goto choose_level   ' * (TI AID)
  if Choice = 11 then                     ' # (TI REDO)
    Total = 0
    ShowMoney
    play sound SndBeep
    wait 15 frames
  end if
  goto key_wait

' --- Lines 170-190 ---
choose_level:
  ClearWindows
  ShowLevel
  fill BackTile count 28 at 2,StatusY
  print at 3,StatusY, "PICK LEVEL 1-3, THEN FIRE"
  play sound SndBeep
  wait no fire
level_wait:
  wait
  if joypad(1).fire then goto level_done
  Choice = keypad(1)
  if Choice >= 1 then
    if Choice <= 3 then
      if Choice <> Level then
        Level = Choice
        LevelChanged
      end if
    end if
  end if
  if joypad(1).right.pressed then
    ' Line 190: LEVEL=LEVEL+1+3*(LEVEL>50)
    inc Level
    if Level > 3 then Level = 1
    LevelChanged
  end if
  if joypad(1).left.pressed then
    dec Level
    if Level = 0 then Level = 3
    LevelChanged
  end if
  goto level_wait
level_done:
  ' --- Lines 780-800: new shapes in the windows, money back to even ---
  HideLevel
  update sprites
  Total = 0
  fill BackTile count 28 at 2,StatusY
  SpinReels
  ShowMoney
  goto main_wait

' --- Lines 200-300 ---
play_round:
  Total -= 1
  ShowMoney
  play sound SndSpin
  SpinReels
  ' Lines 230-260
  Coins = 0
  if Pick[0] = 1 then
    Coins = 2
    if Pick[1] = 1 then Coins = 5
    goto pay
  end if
  if Pick[0] <> Pick[1] then goto main_wait
  ' Line 240: a bar in the third window is wild, except for sevens
  if Pick[2] = 5 then
    if Pick[1] = 6 then goto main_wait
  else
    if Pick[1] <> Pick[2] then goto main_wait
    if Pick[1] = 5 then goto main_wait
  end if
  if Pick[0] < 5 then
    Coins = Pick[0] << 2
    Coins += 2
    goto pay
  end if
  if Pick[0] = 5 then
    ' Line 280: $100, five dollars at a time
    for I = 1 to 20
      Total += 5
      ShowMoney
      play sounds SndCoinA, SndCoinB, SndCoinC
      wait 4 frames
    next
    goto main_wait
  end if
  ' Lines 290-300: $200, forty dollars per siren
  for I = 1 to 5
    play sound SndSirenUp
    wait 42 frames
    Total += 40
    ShowMoney
    play sound SndSirenDown
    wait 32 frames
  next
  goto main_wait
pay:
  ' Line 270: one dollar at a time
  for I = 1 to Coins
    Total += 1
    ShowMoney
    play sounds SndCoinA, SndCoinB, SndCoinC
    wait 4 frames
  next
  goto main_wait

' ---------------------------------------------------------------------------

sub LevelChanged:
  ShowLevel
  play sound SndBeep
  return
end sub

' Line 720: the level number in the three windows (TI sprites #1-#3)
sub ShowLevel:
  N = Level - 1
  set sprite 0 to 27,52,N,1
  set sprite 1 to 27,116,N,1
  set sprite 2 to 27,180,N,1
  update sprites
  return
end sub

sub HideLevel:
  clear sprites
  set sprite count 3
  update sprites
  return
end sub

' Line 770: blank windows
sub ClearWindows:
  for Y = 1 to 7
    put WindowRow count 25 at 3,Y
  next
  return
end sub

' Lines 200-220 and 780-800 (adaptation: the reels spin). Each reel picks a
' random stop, INT(20*RND+1), then turns until that stop fills its window.
sub SpinReels:
  WB = Level - 1
  WB *= 60
  for K = 0 to 2
    P = random(0, 19)
    Off = WB + P
    Pick[K] = Wheels[Off]
    WB += 20
    ' Stop P is shown when the window's top row is strip row 6 * P - 1
    Tg = P * 6
    if Tg = 0 then
      Tg = 119
    else
      dec Tg
    end if
    if T[K] >= Tg then
      Need = T[K] - Tg
    else
      Need = T[K] + 120
      Need -= Tg
    end if
    ' At least 50, 75 and 100 rows for the three reels
    N = K * 25
    N += 50
    if Need < N then Need += 120
    if Need < N then Need += 120
    Left[K] = Need
    Slow[K] = 0
  next
  TickT = 0
spin_loop:
  wait
  Running = 0
  for K = 0 to 2
    if Left[K] > 0 then
      inc Running
      StepReel
    end if
  next
  if Running = 0 then return
  inc TickT
  if TickT >= 6 then
    TickT = 0
    play sound SndTick
  end if
  goto spin_loop
end sub

' One reel moves down one strip row (slower over the last six rows)
sub StepReel:
  if Left[K] <= 6 then
    inc Slow[K]
    if Slow[K] < 3 then return
    Slow[K] = 0
  end if
  if T[K] = 0 then
    T[K] = 119
  else
    dec T[K]
  end if
  dec Left[K]
  DrawReel
  if Left[K] = 0 then play sound SndClunk
  return
end sub

' Draws window K (rows 1-7) from its 120-row reel strip: each of the 20
' stops is a five-row shape followed by one blank row
sub DrawReel:
  X = K << 3
  X += 5
  WB = Level - 1
  WB *= 60
  N = K * 20
  WB += N
  R = T[K]
  for Y = 1 to 7
    Line = Mod6[R]
    if Line = 5 then
      put BlankRow count 5 at X,Y
    else
      P = Div6[R]
      Off = WB + P
      N = Wheels[Off]
      Off = ShapeBase[N]
      N = Line * 5
      Off += N
      put ShapeRows + Off count 5 at X,Y
    end if
    inc R
    if R >= 120 then R = 0
  next
  return
end sub

' --- Lines 810-840 ---
sub ShowMoney:
  fill BackTile count 28 at 2,StatusY
  if Total = 0 then
    put MsgEven count 16 at 7,StatusY
    return
  end if
  if Total > 0 then
    Mag = Total
  else
    Mag = 0 - Total
  end if
  ' TOTAL$ = STR$(ABS(TOTAL)) in the TI digits (chars 48-57 + 112)
  Len = 0
  do
    N = Mag % 10
    Dg[Len] = N + 160
    Mag /= 10
    inc Len
  loop while Mag > 0
  ' COLUMN = 6 + (TOTAL > 0) - INT(.5 + LENGTH / 2), text after CHR$(30)
  Half = Len + 1
  Half >>= 1
  if Total > 0 then
    X = 7 - Half
    put MsgWin count 17 at X,StatusY
    X += 17
  else
    X = 8 - Half
    put MsgLose count 16 at X,StatusY
    X += 16
  end if
  do
    dec Len
    put char Dg[Len] at X,StatusY
    inc X
  loop while Len > 0
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  set text colors black count 32
  backdrop white
  cls
  print at 12,1, "JACKPOT"
  print at 7,3, "BY RICK ROTHSTEIN"
  print at 5,4, "COMPUTE! AUGUST 1984"
  print at 2,6, "A SLOT MACHINE WITHOUT THE"
  print at 2,7, "RISK. EACH WINDOW STOPS ON"
  print at 2,8, "ONE OF 20 PLACES OF ITS"
  print at 2,9, "WHEEL; HOW OFTEN A SYMBOL"
  print at 2,10, "APPEARS SETS THE ODDS."
  print at 2,12, "LEVEL 1: REAL CASINO ODDS"
  print at 2,13, "LEVEL 2: TILTED YOUR WAY"
  print at 2,14, "LEVEL 3: YOU OWN THE CASINO"
  print at 2,16, "FIRE PLAYS ONE DOLLAR."
  print at 2,17, "KEYPAD *  CHANGES THE LEVEL"
  print at 2,18, "KEYPAD #  RESETS THE MONEY"
  print at 4,21, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  cls
  return
end sub

