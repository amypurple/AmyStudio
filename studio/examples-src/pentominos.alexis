' SS(piece): first rotation of pieces 1-12
data FirstRot bytes
  0,1,3,4,8,12,16,20,28,36,44,48,56
end data

' PP$(piece): the letters of the listing (R is the piece often called N)
data PieceName bytes
  32,73,88,86,84,87,85,70,76,89,90,80,82
end data

