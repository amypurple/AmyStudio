project "Easter Bunny"
memory "colecovision_legacy_sdcc"

asset BunnyNameRle from "@project/bunny.name.mdkrle" codec mdkrle
asset BunnyPatternRle from "@project/bunny.pattern.mdkrle" codec mdkrle
asset BunnyColorRle from "@project/bunny.color.mdkrle" codec mdkrle

' Player position and velocity.

ufixed Bunny_PlayerXW = 0
ufixed Bunny_PlayerYW = 0
fixed Bunny_PlayerVXW = 0
fixed Bunny_PlayerVYW = 0

' Player animation and title-state timing.
u8 Bunny_PlayerState = 0


u8 Bunny_SmokeFrame = 0
u8 Bunny_SmokeY = 240
u8 Bunny_Speed = 2
u8 Bunny_TitleColorOffset = 0
u8 Bunny_TitleSrcOffset = 0
u8 Bunny_TitleRepeat = 0
u16 Bunny_TitleVramOffset = 0

' Level/session state.
u8 Bunny_LevelNum = 0
u8 Bunny_EggsLeft = 0
u8 Bunny_BirdKill = 0
u8 Bunny_StartX = 96
u8 Bunny_StartY = 112

' Level decode and collision scratch.
u8 Bunny_Item = 32
u8 Bunny_DL_Count = 0
u16 Bunny_DL_Ptr = 0
u8 Bunny_DL_Y = 0
u8 Bunny_DL_X = 0
u8 Bunny_CF_CY = 0
u8 Bunny_CE_Row = 0
u8 Bunny_CE_Col = 0
u8 Bunny_DL_Code = 0
u8 Bunny_DL_Terrain = 0
u8 Bunny_BirdX = 128
u8 Bunny_BirdY = 0
u8 Bunny_BirdDiff = 0
u8 Bunny_CF_Col = 0
u8 Bunny_CF_FirstCol = 0
u8 Bunny_CF_Tile = 0
i8 Bunny_PlayerVyInt = 0
i8 Bunny_PlayerVxInt = 0
u8 Bunny_PlayerVxFrac = 0
u8 Bunny_PlayerSpriteBase = 0
u8 Bunny_HInput = 0
fixed Bunny_Friction = 0
u8 Bunny_AnimFrame = 0
u8 Bunny_StarIndex = 0
u8 Bunny_SpriteX = 0
u8 Bunny_SpriteY = 0
u8 Bunny_LoopWait = 0
u8 Bunny_Key = $FF

data Bunny_LevelTable words = @level1, @level2, @level7, @level8, @level5, @level6, @level7, @level8
data BunnyFrictionTable words = $0000, $0050, $0140, $00C8, $01F4, $0122, $019A, $012C, $0400

' Easter Bunny playable Amy Studio port based on the v3 native rewrite path.
' The visible listing now uses Amy language for the project setup and keeps
' the remaining original sound/music/level data as project files.
' Next real porting step: replace the helper calls below with Amy routines one subsystem at a time.

sub start:
  tile screen
  sprites 8x8
  sprites simple
  set sound table BunnySoundTable areas 7
  Bunny_InitGraphics
  decompress mdkrle BunnyNameRle to vram.name
  Bunny_ResetSprites
  Bunny_PlayerColor
  Bunny_SelectPlayerSprite
  Bunny_InitTitleState
  screen on
  play sound 6
  play sound 7
  Bunny_TitleLoop
  mute all
  Bunny_GameEntry
  loop forever
end sub

' Initial title/test sprite layout, expressed with Amy sprite commands.
sub Bunny_InitTestSprites:
  set sprite 0 to 120,96,2,14
  set sprite 1 to 120,96,3,15
  set sprite 2 to 112,96,0,14
  set sprite 3 to 112,96,1,13
  set sprite 4 to 208,0,38,15
  set sprite 5 to 40,128,44,15
  return

' Bird starts offscreen-ish and then chases the player during gameplay.
sub Bunny_InitBird:
  Bunny_BirdX = 128
  Bunny_BirdY = 0
  set sprite 5 to Bunny_BirdY,Bunny_BirdX,44,15
  return

' Title state initialization now lives in Amy and calls the sprite setup sub above.
sub Bunny_InitTitleState:
  Bunny_PlayerXW = 96
  Bunny_PlayerYW = 112

  Bunny_PlayerVXW = 0
  Bunny_PlayerVYW = 0
  Bunny_PlayerXW = 96
  Bunny_PlayerYW = 112
  Bunny_PlayerState = 0
  Bunny_SmokeFrame = 0
  Bunny_Speed = 2
  Bunny_TitleColorOffset = 0
  Bunny_InitTestSprites
  set sprite 4 to 208,0,38,15
  set sprite 5 to 208,128,44,15
  update sprites
  return

' Sprite reset is now native Amy code.
sub Bunny_ResetSprites:
  clear sprites
  set sprite count 6
  return

' Keep the byte mirrors synchronized from the 8.8 fixed-position words.
sub Bunny_SyncPlayerCoords:
  return

' First real Bunny rewrite slice: this helper is now Amy code, not bridge ASM.
sub Bunny_InitPlayerFromStart:
  Bunny_PlayerVXW = 0
  Bunny_PlayerVYW = 0
  Bunny_PlayerState = 0

  Bunny_PlayerXW = Bunny_StartX
  Bunny_PlayerYW = Bunny_StartY
  Bunny_SmokeFrame = 4
  return


' Player colors, smoke start, and sprite-state update now live in Amy.
sub Bunny_PlayerColor:
  set sprite 0 color to 14
  set sprite 2 color to 14
  set sprite 1 color to 15
  set sprite 3 color to 13
  return

sub Bunny_StartSmoke:
  Bunny_SmokeFrame = 0
  Bunny_SmokeY = Bunny_PlayerYW + 2
  set sprite 4 x to Bunny_PlayerXW
  set sprite 4 y to Bunny_SmokeY
  set sprite 4 pattern to 38
  set sprite 4 color to 15
  return

sub Bunny_UpdateSpritesFromState:
  set sprites 0,1 y to Bunny_PlayerYW
  set sprites 2,3 y to Bunny_PlayerYW - 8
  set sprites 0,1,2,3 x to Bunny_PlayerXW
  if Bunny_SmokeFrame < 4 then
    Bunny_SmokeY -= 4
    set sprite 4 y to Bunny_SmokeY
    set sprite 4 x to Bunny_PlayerXW
    set sprite 4 pattern to Bunny_SmokeFrame + 38
    Bunny_SmokeFrame += 1
  else
    set sprite 4 y to 240
  end if
  return


' Native Amy sound effect byte streams converted from bunny_sounds.inc.
data egg_snd bytes
  $43,$00,$72,5,$11,$90,$F3,$11,$50
end data

data jump_snd bytes
