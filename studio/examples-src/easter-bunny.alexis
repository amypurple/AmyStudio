' Player position and velocity.
u8 Bunny_PlayerX = 0
u8 Bunny_PlayerY = 0
i8 Bunny_PlayerVy = 0
ufixed Bunny_PlayerXW = 0
ufixed Bunny_PlayerYW = 0
fixed Bunny_PlayerVXW = 0
fixed Bunny_PlayerVYW = 0

' Player animation and title-state timing.
u8 Bunny_PlayerState = 0
u8 Bunny_PlayerSpeed = 128
u8 Bunny_OldJoy = 0
u8 Bunny_SmokeFrame = 0
u8 Bunny_Speed = 2
u8 Bunny_TitleColorOffset = 0

' Level/session state.
u8 Bunny_LevelNum = 0
u8 Bunny_EggsLeft = 0
u8 Bunny_BirdKill = 0
u8 Bunny_StartX = 96
u8 Bunny_StartY = 112

' Level decode and collision scratch.
u8 Bunny_Item = 32
u8 Bunny_DL_Count = 0
u16 Bunny_DL_Ptr = 0
u8 Bunny_DL_Y = 0
u8 Bunny_DL_X = 0
u8 Bunny_CF_CY = 0
u8 Bunny_CE_Row = 0
u8 Bunny_CE_Col = 0

tile screen
sprites 8x8
sprites simple
asm {
  call Bunny_StartNearOriginal
}
screen on

asm {
; -----------------------------------------------------------------------------
; Amy port of Amy Bienvenu / NewColeco's Easter Bunny (Minigame Compo 2007).
; Full game: multi-level, egg collection, tile collision, bird-kill, lava bounce.
; Reference: examples/vendor/old-devkit/bunny/bunny.c + dcode.s + anim.s
; -----------------------------------------------------------------------------

Bunny_StartNearOriginal:
    ld a,7
    ld (AMY_SOUND_AREA_COUNT),a
    ld hl,BunnySoundTable
    call AMY_SET_SOUND_TABLE
    ld a,1
    ld (AMY_SOUND_ENABLED),a
    call Bunny_InitGraphics
    ld hl,NAMERLE
    ld de,VRAM_NAME
    call mdkrle_decompress
    call Bunny_ResetSprites
    call Bunny_PlayerColor
    xor a
    call Bunny_PlayerSprite
    call Bunny_InitTitleState
    call AMY_SCREEN_ON_NMI
    ld b,6
    call AMY_PLAY_SOUND
    ld b,7
    call AMY_PLAY_SOUND
    call Bunny_TitleLoop
    call AMY_MUTE_ALL
    jp Bunny_GameEntry

Bunny_InitGraphics:
    ld hl,PATTERNRLE
    ld de,VRAM_PATTERN
    call mdkrle_decompress
    ld hl,floor_pattern
    ld de,$0060
    ld b,7
Bunny_InitGraphics_FloorLoop:
    push bc
    push hl
    push de
    ld bc,$0008
    call AMY_COPY_BYTES_TO_VRAM
    pop de
    pop hl
    ld a,e
    add a,8
    ld e,a
    jr nc,Bunny_InitGraphics_FloorNext
    inc d
Bunny_InitGraphics_FloorNext:
    pop bc
    djnz Bunny_InitGraphics_FloorLoop
    call AMY_DUPLICATE_PATTERN_THIRDS
    ld hl,COLORRLE
    ld de,VRAM_COLOR
    call mdkrle_decompress
    ld b,6
    ld c,0
    call AMY_VDP_WRITE_REG
    ret

Bunny_ResetSprites:
    call AMY_CLEAR_SPRITES
    ld a,6
    call AMY_SET_SPRITE_COUNT
    ret

Bunny_InitTestSprites:
    ld hl,AMY_SPRITE_TABLE
    ld (hl),120
    inc hl
    ld (hl),96
    inc hl
    ld (hl),2
    inc hl
    ld (hl),14
    inc hl
    ld (hl),120
    inc hl
    ld (hl),96
    inc hl
    ld (hl),3
    inc hl
    ld (hl),15
    inc hl
    ld (hl),112
    inc hl
    ld (hl),96
    inc hl
    ld (hl),0
    inc hl
    ld (hl),14
    inc hl
    ld (hl),112
    inc hl
    ld (hl),96
    inc hl
    ld (hl),1
    inc hl
    ld (hl),13
    inc hl
    ld (hl),$D0
    inc hl
    ld (hl),0
    inc hl
    ld (hl),$26
    inc hl
    ld (hl),$0F
    inc hl
    ld (hl),40
    inc hl
    ld (hl),128
    inc hl
    ld (hl),44
    inc hl
    ld (hl),$0F
    ret

Bunny_InitTitleState:
    ld a,96
    ld (Bunny_PlayerX),a
    ld a,112
    ld (Bunny_PlayerY),a
    xor a
    ld (Bunny_PlayerVy),a
    ld (Bunny_PlayerVXW),a
    ld (Bunny_PlayerVXW+1),a
    ld (Bunny_PlayerVYW),a
    ld (Bunny_PlayerVYW+1),a
    ld a,96
    ld (Bunny_PlayerXW+1),a
    xor a
    ld (Bunny_PlayerXW),a
    ld a,112
    ld (Bunny_PlayerYW+1),a
    xor a
    ld (Bunny_PlayerYW),a
    ld (Bunny_PlayerState),a
    ld (Bunny_OldJoy),a
    ld (Bunny_SmokeFrame),a
    ld a,2
    ld (Bunny_Speed),a
    ld a,128
    ld (Bunny_PlayerSpeed),a
    xor a
    ld (Bunny_TitleColorOffset),a
    call Bunny_InitTestSprites
    ld a,$D0
    ld (AMY_SPRITE_TABLE+16),a
    ld (AMY_SPRITE_TABLE+20),a
    call AMY_UPDATE_SPRITES
    ret

Bunny_TitleLoop:
Bunny_TitleLoop_loop:
    halt
    call Bunny_AnimateTitleColors
    ld a,(KEYPAD_1)
    cp 1
    jr c,Bunny_TitleCheckPad2
    cp 4
    jr nc,Bunny_TitleCheckPad2
    jr Bunny_TitlePick
Bunny_TitleCheckPad2:
    ld a,(KEYPAD_2)
    cp 1
    jr c,Bunny_TitleLoop_loop
    cp 4
    jr nc,Bunny_TitleLoop_loop
Bunny_TitlePick:
    ld b,a
    ld a,5
    sub b
    ld (Bunny_Speed),a
Bunny_TitleRelease:
    halt
    call Bunny_AnimateTitleColors
    ld a,(KEYPAD_1)
    cp $FF
    jr nz,Bunny_TitleRelease
    ld a,(KEYPAD_2)
    cp $FF
    jr nz,Bunny_TitleRelease
    ret

Bunny_AnimateTitleColors:
    ld a,(Bunny_TitleColorOffset)
    inc a
    cp 40
    jr c,Bunny_StoreTitleColorOffset
    xor a
Bunny_StoreTitleColorOffset:
    ld (Bunny_TitleColorOffset),a
    ld e,a
    ld d,0
    ld hl,BunnyTitleColors
    add hl,de
    ld de,$2400
    call Bunny_WriteRepeatedColorBlock
    ld a,(Bunny_TitleColorOffset)
    add a,8
    ld e,a
    ld d,0
    ld hl,BunnyTitleColors
    add hl,de
    ld de,$2460
    call Bunny_WriteRepeatedColorBlock
    ret

Bunny_WriteRepeatedColorBlock:
    ld b,12
Bunny_WriteRepeatedColorBlock_loop:
    push bc
    push hl
    push de
    ld bc,$0008
    call AMY_COPY_BYTES_TO_VRAM
    pop de
    pop hl
    pop bc
    ld a,e
    add a,8
    ld e,a
    jr nc,Bunny_WriteRepeatedColorBlock_next
    inc d
Bunny_WriteRepeatedColorBlock_next:
    djnz Bunny_WriteRepeatedColorBlock_loop
    ret

; =======================================
; GAME ENTRY AND MAIN LOOP
; =======================================

Bunny_GameEntry:
    xor a
    ld (Bunny_LevelNum),a

Bunny_GameEntry_Level:
    xor a
    ld (Bunny_BirdKill),a
    ld (Bunny_SmokeFrame),a
    ld (Bunny_OldJoy),a
    call AMY_ENABLE_NMI
    call AMY_CLEAR_NAME_TABLE
    call Bunny_ResetSprites
    call AMY_UPDATE_SPRITES
    call Bunny_DecodeLevel
    call Bunny_InitPlayerFromStart
    call Bunny_PlayerColor
    ; start sprites at screen center so slide-in is visible
    ld a,96
    ld (AMY_SPRITE_TABLE),a
    ld (AMY_SPRITE_TABLE+4),a
    ld a,88
    ld (AMY_SPRITE_TABLE+8),a
    ld (AMY_SPRITE_TABLE+12),a
    ld a,128
    ld (AMY_SPRITE_TABLE+1),a
    ld (AMY_SPRITE_TABLE+5),a
    ld (AMY_SPRITE_TABLE+9),a
    ld (AMY_SPRITE_TABLE+13),a
    ld a,$D0
    ld (AMY_SPRITE_TABLE+16),a
    ld (AMY_SPRITE_TABLE+20),a
    ld b,4
    call AMY_PLAY_SOUND
    call Bunny_AnimGetReady
    call Bunny_InitBird
    call Bunny_UpdateSpritesFromState
    call AMY_UPDATE_SPRITES
    call Bunny_GameLoop
    ld a,(Bunny_BirdKill)
    or a
    jr nz,Bunny_GameEntry_Level
    ld a,(Bunny_LevelNum)
    inc a
    and 7
    ld (Bunny_LevelNum),a
    jr Bunny_GameEntry_Level

Bunny_GameLoop:
    ld a,(Bunny_Speed)
    ld b,a
Bunny_GameLoop_Wait:
    halt
    djnz Bunny_GameLoop_Wait
    call Bunny_UpdatePlayerNearOriginal
    ld a,(Bunny_EggsLeft)
    or a
    jr nz,Bunny_GL_CheckBird
    xor a
    ld (Bunny_BirdKill),a
    ret
Bunny_GL_CheckBird:
    call Bunny_CheckBird
    ld a,(Bunny_BirdKill)
    or a
    ret nz
    call AMY_UPDATE_SPRITES
    jr Bunny_GameLoop

; =======================================
; LEVEL DECODER
; =======================================

Bunny_DecodeLevel:
    ld a,(Bunny_LevelNum)
    and 7
    add a,a
    ld e,a
    ld d,0
    ld hl,levels
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld (Bunny_DL_Ptr),hl
    xor a
    ld (Bunny_EggsLeft),a
    ld (Bunny_DL_Y),a
    ld a,(hl)
    inc hl
    ld (Bunny_DL_Ptr),hl
    call Bunny_RNC
    ld (Bunny_DL_Count),a
    halt
    call AMY_SCREEN_ON_NMI

Bunny_DL_RowLoop:
    halt
    ld a,(Bunny_DL_Y)
    ld d,a
    ld e,0
    ld a,$24
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_DL_Y)
    ld d,a
    ld e,1
    ld a,$23
    call AMY_PUT_CHAR_AT
    ld a,2
    ld (Bunny_DL_X),a

Bunny_DL_ColLoop:
    ld a,(Bunny_Item)
    cp $22
    jr nz,Bunny_DL_NotEgg
    ld a,(Bunny_DL_Y)
    or a
    jr z,Bunny_DL_EggTop
    dec a
    ld d,a
    ld a,(Bunny_DL_X)
    ld e,a
    ld a,$21
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_EggsLeft)
    inc a
    ld (Bunny_EggsLeft),a
Bunny_DL_EggTop:
    ld a,(Bunny_Item)
    jr Bunny_DL_PutTile
Bunny_DL_NotEgg:
    or a
    jr nz,Bunny_DL_NotStart
    ld a,(Bunny_DL_X)
    rlca
    rlca
    rlca
    ld (Bunny_StartX),a
    ld a,(Bunny_DL_Y)
    rlca
    rlca
    rlca
    dec a
    ld (Bunny_StartY),a
    ld a,$20
    jr Bunny_DL_PutTile
Bunny_DL_NotStart:
    cp $20
    jr nz,Bunny_DL_PutTile
    ld a,(Bunny_DL_Y)
    cp 23
    jr z,Bunny_DL_LastRowSpace
    ld a,(Bunny_Item)
    jr Bunny_DL_PutTile
Bunny_DL_LastRowSpace:
    ld a,$0F

Bunny_DL_PutTile:
    push af
    ld a,(Bunny_DL_Y)
    ld d,a
    ld a,(Bunny_DL_X)
    ld e,a
    pop af
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_DL_Count)
    dec a
    ld (Bunny_DL_Count),a
    jr nz,Bunny_DL_NoNewCode
    ld hl,(Bunny_DL_Ptr)
    ld a,(hl)
    inc hl
    ld (Bunny_DL_Ptr),hl
    call Bunny_RNC
    ld (Bunny_DL_Count),a
Bunny_DL_NoNewCode:
    ld a,(Bunny_DL_X)
    inc a
    ld (Bunny_DL_X),a
    cp 30
    jr c,Bunny_DL_ColLoop
    ld a,(Bunny_DL_Y)
    ld d,a
    ld e,30
    ld a,$25
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_DL_Y)
    ld d,a
    ld e,31
    ld a,$26
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_DL_Y)
    inc a
    ld (Bunny_DL_Y),a
    cp 24
    jp c,Bunny_DL_RowLoop
    ret

Bunny_RNC:
    push de
    ld e,a
    bit 7,a
    jr z,Bunny_RNC_Spaces
    inc a
    jr z,Bunny_RNC_Egg
    dec a
    rrca
    rrca
    rrca
    rrca
    rrca
    and 7
    sub 7
    jr nz,Bunny_RNC_Ground
    inc a
Bunny_RNC_Ground:
    add a,15
    ld (Bunny_Item),a
    ld a,e
    and $1F
    inc a
    pop de
    ret
Bunny_RNC_Egg:
    ld a,$22
    ld (Bunny_Item),a
    ld a,1
    pop de
    ret
Bunny_RNC_Spaces:
    ld a,e
    or a
    jr nz,Bunny_RNC_SpacesN
    xor a
    ld (Bunny_Item),a
    ld a,1
    pop de
    ret
Bunny_RNC_SpacesN:
    ld a,$20
    ld (Bunny_Item),a
    ld a,e
    dec a
    jr z,Bunny_RNC_256
    inc a
    inc a
    pop de
    ret
Bunny_RNC_256:
    xor a
    pop de
    ret

; =======================================
; TILE COLLISION, EGG COLLECTION, BIRD KILL
; =======================================

Bunny_CheckFloor:
    ld a,(Bunny_PlayerY)
    add a,9
    rrca
    rrca
    rrca
    and $1F
    ld (Bunny_CF_CY),a
    ld d,a
    ld a,(Bunny_PlayerX)
    add a,3
    rrca
    rrca
    rrca
    and $1F
    ld e,a
    call AMY_GET_CHAR_AT
    cp $0F
    jr z,Bunny_CF_Lava
    cp $10
    jr c,Bunny_CF_CheckSurface
    cp $20
    jr nc,Bunny_CF_Done
    ld a,(Bunny_PlayerVy)
    or a
    jp p,Bunny_CF_Snap
    ret
Bunny_CF_CheckSurface:
    cp $0C
    ret c
    ld a,(Bunny_PlayerVy)
    or a
    jp p,Bunny_CF_Snap
    ret
Bunny_CF_Lava:
    ld a,$E0
    ld (Bunny_PlayerVy),a
    ld b,3
    call AMY_PLAY_SOUND
    ret
Bunny_CF_Snap:
    ld a,(Bunny_CF_CY)
    rlca
    rlca
    rlca
    sub 9
    ld (Bunny_PlayerY),a
    xor a
    ld (Bunny_PlayerVy),a
Bunny_CF_Done:
    ret

Bunny_CheckEgg:
    ld a,(Bunny_PlayerY)
    sub 6
    ret c
    rrca
    rrca
    rrca
    and $1F
    ld (Bunny_CE_Row),a
    ld d,a
    ld a,(Bunny_PlayerX)
    add a,3
    rrca
    rrca
    rrca
    and $1F
    ld (Bunny_CE_Col),a
    ld e,a
    call AMY_GET_CHAR_AT
    cp $21
    jr nz,Bunny_CE_CheckLower
    ld a,(Bunny_CE_Row)
    ld d,a
    ld a,(Bunny_CE_Col)
    ld e,a
    ld a,$20
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_EggsLeft)
    dec a
    ld (Bunny_EggsLeft),a
    ld b,1
    call AMY_PLAY_SOUND
Bunny_CE_CheckLower:
    ld a,(Bunny_CE_Row)
    inc a
    cp 24
    ret nc
    ld d,a
    ld a,(Bunny_CE_Col)
    ld e,a
    call AMY_GET_CHAR_AT
    cp $21
    ret nz
    ld a,(Bunny_CE_Row)
    inc a
    ld d,a
    ld a,(Bunny_CE_Col)
    ld e,a
    ld a,$20
    call AMY_PUT_CHAR_AT
    ld a,(Bunny_EggsLeft)
    dec a
    ld (Bunny_EggsLeft),a
    ld b,1
    call AMY_PLAY_SOUND
Bunny_CE_Done:
    ret

Bunny_CheckBird:
    ld a,(AMY_SPRITE_TABLE+1)
    ld b,a
    ld a,(AMY_SPRITE_TABLE+21)
    call Bunny_AbsDiff
    cp 3
    ret nc
    ld a,(AMY_SPRITE_TABLE)
    ld b,a
    ld a,(AMY_SPRITE_TABLE+20)
    call Bunny_AbsDiff
    cp 5
    ret nc
    ld a,1
    ld (Bunny_BirdKill),a
    ld b,5
    call AMY_PLAY_SOUND
    ret

Bunny_AbsDiff:
    cp b
    jr c,Bunny_AbsDiff_BMinusA
    sub b
    ret
Bunny_AbsDiff_BMinusA:
    ld c,a
    ld a,b
    sub c
    ret

Bunny_InitBird:
    ld a,128
    ld (AMY_SPRITE_TABLE+21),a
    xor a
    ld (AMY_SPRITE_TABLE+20),a
    ld a,44
    ld (AMY_SPRITE_TABLE+22),a
    ld a,$0F
    ld (AMY_SPRITE_TABLE+23),a
    ret

Bunny_InitPlayerFromStart:
    xor a
    ld (Bunny_PlayerVXW),a
    ld (Bunny_PlayerVXW+1),a
    ld (Bunny_PlayerVYW),a
    ld (Bunny_PlayerVYW+1),a
    ld (Bunny_PlayerState),a
    ld a,128
    ld (Bunny_PlayerSpeed),a
    ld a,(Bunny_StartX)
    ld (Bunny_PlayerX),a
    ld (Bunny_PlayerXW+1),a
    xor a
    ld (Bunny_PlayerXW),a
    ld a,(Bunny_StartY)
    ld (Bunny_PlayerY),a
    ld (Bunny_PlayerYW+1),a
    xor a
    ld (Bunny_PlayerYW),a
    ld (Bunny_PlayerVy),a
    ret

Bunny_UpdatePlayerNearOriginal:
    call Bunny_UpdatePlayerXNearOriginal
    call Bunny_UpdatePlayerYNearOriginal
    call Bunny_SyncPlayerCoords
    call Bunny_UpdateStateNearOriginal
    call Bunny_SyncPlayerCoords
    call Bunny_CheckEgg
    call Bunny_UpdateBird
    call Bunny_SelectPlayerSprite
    call Bunny_UpdateSpritesFromState
    ret

Bunny_SyncPlayerCoords:
    ld a,(Bunny_PlayerXW+1)
    ld (Bunny_PlayerX),a
    ld a,(Bunny_PlayerYW+1)
    ld (Bunny_PlayerY),a
    ld a,(Bunny_PlayerVYW+1)
    ld (Bunny_PlayerVy),a
    ret

Bunny_UpdatePlayerXNearOriginal:
    ld a,(JOYPAD_1)
    and $0A
    jr z,Bunny_UPX_Friction
    bit 3,a
    jr z,Bunny_UPX_CheckRight
    ld hl,(Bunny_PlayerVXW)
    ld de,$FF80
    add hl,de
    ld (Bunny_PlayerVXW),hl
Bunny_UPX_CheckRight:
    ld a,(JOYPAD_1)
    bit 1,a
    jr z,Bunny_UPX_Clamp
    ld hl,(Bunny_PlayerVXW)
    ld de,$0080
    add hl,de
    ld (Bunny_PlayerVXW),hl
    jr Bunny_UPX_Clamp
Bunny_UPX_Friction:
    ld a,(Bunny_PlayerState)
    bit 3,a
    jr nz,Bunny_UPX_Clamp
    add a,a
    ld e,a
    ld d,0
    ld hl,Bunny_FrictionTable
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
Bunny_UPX_DoFriction:
    ld hl,(Bunny_PlayerVXW)
    ld a,h
    or l
    jr z,Bunny_UPX_Clamp
    bit 7,h
    jr z,Bunny_UPX_Positive
    add hl,de
    bit 7,h
    jr z,Bunny_UPX_Zero
    ld (Bunny_PlayerVXW),hl
    jr Bunny_UPX_Clamp
Bunny_UPX_Positive:
    or a
    sbc hl,de
    jr c,Bunny_UPX_Zero
    ld (Bunny_PlayerVXW),hl
    jr Bunny_UPX_Clamp
Bunny_UPX_Zero:
    xor a
    ld (Bunny_PlayerVXW),a
    ld (Bunny_PlayerVXW+1),a
Bunny_UPX_Clamp:
    ld hl,(Bunny_PlayerVXW)
    bit 7,h
    jr z,Bunny_UPX_ClampMax
    ld a,h
    cp $FC
    jr nc,Bunny_UPX_StoreClamped
    ld hl,$FC00
    jr Bunny_UPX_StoreClamped
Bunny_UPX_ClampMax:
    ld a,h
    cp $04
    jr c,Bunny_UPX_StoreClamped
    jr nz,Bunny_UPX_ClampToMax
    ld a,l
    or a
    jr z,Bunny_UPX_StoreClamped
Bunny_UPX_ClampToMax:
    ld hl,$0400
Bunny_UPX_StoreClamped:
    ld (Bunny_PlayerVXW),hl
    ld de,(Bunny_PlayerXW)
    add hl,de
    ld (Bunny_PlayerXW),hl
    ld a,h
    cp $10
    jr c,Bunny_UPX_Bounce
    cp $E9
    ret c
Bunny_UPX_Bounce:
    ld hl,(Bunny_PlayerVXW)
    call Bunny_NegateHL
    ld (Bunny_PlayerVXW),hl
    ld de,(Bunny_PlayerXW)
    add hl,de
    ld (Bunny_PlayerXW),hl
    ret

Bunny_UpdatePlayerYNearOriginal:
    ld a,(Bunny_PlayerState)
    bit 3,a
    jr z,Bunny_UPY_Grounded
    ld hl,(Bunny_PlayerVYW)
    ld de,$0180
    add hl,de
    bit 7,h
    jr nz,Bunny_UPY_StoreVy
    ld a,h
    cp $08
    jr c,Bunny_UPY_StoreVy
    jr nz,Bunny_UPY_ClampMax
    ld a,l
    or a
    jr z,Bunny_UPY_StoreVy
Bunny_UPY_ClampMax:
    ld hl,$0800
Bunny_UPY_StoreVy:
    ld (Bunny_PlayerVYW),hl
    jr Bunny_UPY_Apply
Bunny_UPY_Grounded:
    xor a
    ld (Bunny_PlayerVYW),a
    ld (Bunny_PlayerVYW+1),a
    ld a,(JOYPAD_1)
    bit 7,a
    jr z,Bunny_UPY_Apply
    ld hl,$F800
    ld (Bunny_PlayerVYW),hl
    ld a,8
    ld (Bunny_PlayerState),a
    ld b,2
    call AMY_PLAY_SOUND
Bunny_UPY_Apply:
    ld hl,(Bunny_PlayerVYW)
    ld de,(Bunny_PlayerYW)
    add hl,de
    ld (Bunny_PlayerYW),hl
    ret

Bunny_UpdateStateNearOriginal:
    ld a,8
    ld (Bunny_PlayerState),a
    ld a,(Bunny_PlayerY)
    add a,9
    ld c,a
    and 7
    ld b,a
    ld a,c
    rrca
    rrca
    rrca
    and $1F
    ld (Bunny_CF_CY),a
    ld d,a
    ld a,(Bunny_PlayerX)
    add a,2
    rrca
    rrca
    rrca
    and $1F
    ld c,a
    ld e,a
    call Bunny_CheckGroundTileAtDE
    ld a,(Bunny_PlayerX)
    add a,5
    rrca
    rrca
    rrca
    and $1F
    cp c
    ret z
    ld e,a
    call Bunny_CheckGroundTileAtDE
    ret

Bunny_CheckGroundTileAtDE:
    push de
    call AMY_GET_CHAR_AT
    pop de
    cp $10
    jr c,Bunny_CGT_NotSpecial
    cp $20
    ret nc
    inc a
    push af
    call AMY_PUT_CHAR_AT
    pop af
    ld a,(Bunny_PlayerVYW+1)
    bit 7,a
    ret nz
    call Bunny_SnapPlayerToGround
    ld a,(Bunny_PlayerState)
    and $F7
    or 2
    ld (Bunny_PlayerState),a
    ret
Bunny_CGT_NotSpecial:
    cp $0C
    ret c
    cp $10
    ret nc
    cp $0F
    jr z,Bunny_CGT_Lava
    ld a,(Bunny_PlayerVYW+1)
    bit 7,a
    ret nz
    call Bunny_SnapPlayerToGround
    cp $0C
    jr z,Bunny_CGT_Ice
    cp $0D
    jr z,Bunny_CGT_Grass
    ld a,4
    jr Bunny_CGT_SetState
Bunny_CGT_Ice:
    ld a,1
    jr Bunny_CGT_SetState
Bunny_CGT_Grass:
    ld a,2
Bunny_CGT_SetState:
    ld b,a
    ld a,(Bunny_PlayerState)
    and $F7
    or b
    ld (Bunny_PlayerState),a
    ret
Bunny_CGT_Lava:
    ld hl,$F000
    ld (Bunny_PlayerVYW),hl
    ld a,8
    ld (Bunny_PlayerState),a
    call Bunny_StartSmoke
    ld b,3
    call AMY_PLAY_SOUND
    ret

Bunny_SnapPlayerToGround:
    ld a,(Bunny_CF_CY)
    rlca
    rlca
    rlca
    sub 9
    ld (Bunny_PlayerY),a
    ld (Bunny_PlayerYW+1),a
    xor a
    ld (Bunny_PlayerYW),a
    ld (Bunny_PlayerVYW),a
    ld (Bunny_PlayerVYW+1),a
    ret

Bunny_SelectPlayerSprite:
    ld hl,(Bunny_PlayerVXW)
    ld a,h
    or l
    jr z,Bunny_SPS_Idle
    bit 7,h
    jr nz,Bunny_SPS_Left
    ld a,h
    or a
    jr nz,Bunny_SPS_Right
    ld a,l
    cp $80
    jr nc,Bunny_SPS_Right
Bunny_SPS_Idle:
    xor a
    jp Bunny_PlayerSprite
Bunny_SPS_Left:
    ld a,8
    jp Bunny_PlayerSprite
Bunny_SPS_Right:
    ld a,4
    jp Bunny_PlayerSprite

Bunny_NegateHL:
    ld a,l
    cpl
    ld l,a
    ld a,h
    cpl
    ld h,a
    inc hl
    ret

Bunny_HandleInput:
    ld a,(JOYPAD_1)
    bit 3,a
    jr z,Bunny_CheckRight
    ld a,(Bunny_PlayerX)
    cp 24
    jr c,Bunny_CheckRight
    dec a
    ld (Bunny_PlayerX),a
    ld a,8
    call Bunny_PlayerSprite
Bunny_CheckRight:
    ld a,(JOYPAD_1)
    bit 1,a
    jr z,Bunny_CheckJump
    ld a,(Bunny_PlayerX)
    cp 216
    jr nc,Bunny_CheckJump
    inc a
    ld (Bunny_PlayerX),a
    ld a,4
    call Bunny_PlayerSprite
Bunny_CheckJump:
    ld a,(JOYPAD_1)
    ld b,a
    ld a,(Bunny_OldJoy)
    xor b
    and b
    and $F0
    jr z,Bunny_StoreJoy
    ld a,(Bunny_PlayerVy)
    or a
    jr nz,Bunny_StoreJoy
    ld a,$FA
    ld (Bunny_PlayerVy),a
    ld b,2
    call AMY_PLAY_SOUND
Bunny_StoreJoy:
    ld a,(JOYPAD_1)
    ld (Bunny_OldJoy),a
    ret

Bunny_ApplyPhysics:
    ld a,(Bunny_PlayerVy)
    add a,1
    bit 7,a
    jr nz,Bunny_AP_StoreVy
    cp 20
    jr c,Bunny_AP_StoreVy
    ld a,20
Bunny_AP_StoreVy:
    ld (Bunny_PlayerVy),a
    ld b,a
    ld a,(Bunny_PlayerY)
    add a,b
    jr c,Bunny_AP_StoreY
    cp 176
    jr c,Bunny_AP_StoreY
    ld a,(Bunny_PlayerVy)
    bit 7,a
    jr nz,Bunny_AP_ClampTop
    ld a,175
    jr Bunny_AP_StoreY
Bunny_AP_ClampTop:
    xor a
Bunny_AP_StoreY:
    ld (Bunny_PlayerY),a
    ret

Bunny_UpdateBird:
    ld a,(AMY_SPRITE_TABLE+21)
    ld b,a
    ld a,(Bunny_PlayerX)
    cp b
    jr z,Bunny_UpdateBirdY
    jr c,Bunny_BirdLeft
    ld a,b
    inc a
    ld (AMY_SPRITE_TABLE+21),a
    and 1
    add a,44
    ld (AMY_SPRITE_TABLE+22),a
    jr Bunny_UpdateBirdY
Bunny_BirdLeft:
    ld a,b
    dec a
    ld (AMY_SPRITE_TABLE+21),a
    and 1
    add a,46
    ld (AMY_SPRITE_TABLE+22),a
Bunny_UpdateBirdY:
    ld a,(AMY_SPRITE_TABLE+20)
    ld b,a
    ld a,(Bunny_PlayerY)
    cp b
    ret z
    jr c,Bunny_BirdUp
    ld a,b
    inc a
    ld (AMY_SPRITE_TABLE+20),a
    ret
Bunny_BirdUp:
    ld a,b
    dec a
    ld (AMY_SPRITE_TABLE+20),a
    ret

Bunny_UpdateSpritesFromState:
    ld a,(Bunny_PlayerY)
    ld (AMY_SPRITE_TABLE),a
    ld (AMY_SPRITE_TABLE+4),a
    sub 8
    ld (AMY_SPRITE_TABLE+8),a
    ld (AMY_SPRITE_TABLE+12),a
    ld a,(Bunny_PlayerX)
    ld (AMY_SPRITE_TABLE+1),a
    ld (AMY_SPRITE_TABLE+5),a
    ld (AMY_SPRITE_TABLE+9),a
    ld (AMY_SPRITE_TABLE+13),a
    ld a,(AMY_SPRITE_TABLE+18)
    cp $26
    jr c,Bunny_HideSmoke
    cp $2A
    jr nc,Bunny_HideSmoke
    ld a,(AMY_SPRITE_TABLE+16)
    sub 4
    ld (AMY_SPRITE_TABLE+16),a
    ld a,(Bunny_PlayerX)
    ld (AMY_SPRITE_TABLE+17),a
    ld a,(AMY_SPRITE_TABLE+18)
    inc a
    ld (AMY_SPRITE_TABLE+18),a
    ret
Bunny_HideSmoke:
    ld a,$F0
    ld (AMY_SPRITE_TABLE+16),a
    ret

Bunny_StartSmoke:
    ld a,(Bunny_PlayerX)
    ld (AMY_SPRITE_TABLE+17),a
    ld a,(Bunny_PlayerY)
    add a,2
    ld (AMY_SPRITE_TABLE+16),a
    ld a,$26
    ld (AMY_SPRITE_TABLE+18),a
    ld a,$0F
    ld (AMY_SPRITE_TABLE+19),a
    ret

Bunny_FrictionTable:
    dw $0000,$0050,$0140,$00C8,$01F4,$0122,$019A,$012C,$0400

; Ported from bunny/setsprit.s.
Bunny_PlayerSprite:
    add a,2
    ld (AMY_SPRITE_TABLE+2),a
    inc a
    ld (AMY_SPRITE_TABLE+6),a
    sub 3
    ld (AMY_SPRITE_TABLE+10),a
    inc a
    ld (AMY_SPRITE_TABLE+14),a
    ret

; Ported from bunny/setsprit.s.
Bunny_PlayerColor:
    ld a,14
    ld (AMY_SPRITE_TABLE+3),a
    ld (AMY_SPRITE_TABLE+11),a
    inc a
    ld (AMY_SPRITE_TABLE+7),a
    sub 2
    ld (AMY_SPRITE_TABLE+15),a
    ret

; =======================================
; LEVEL START ANIMATION (anim_getready from bunny/anim.s)
; =======================================

Bunny_AnimGetReady:
    xor a
    call Bunny_PlayerSprite
    ld a,0
    ld (Bunny_DL_X),a
Bunny_AGR_Loop:
    halt
    call Bunny_SlideSprite
    ld a,(Bunny_DL_X)
    call Bunny_Invincible
    call AMY_UPDATE_SPRITES
    ld hl,Bunny_DL_X
    inc (hl)
    ld a,(Bunny_DL_X)
    cp 224
    jr c,Bunny_AGR_Loop
    halt
    ld a,$D0
    ld (AMY_SPRITE_TABLE+16),a
    ld (AMY_SPRITE_TABLE+20),a
    call AMY_UPDATE_SPRITES
    ret

Bunny_SlideSprite:
    ; Move all 4 player sprites one pixel toward (Bunny_PlayerX, Bunny_PlayerY)
    ld a,(AMY_SPRITE_TABLE+1)
    ld b,a
    ld a,(Bunny_PlayerX)
    cp b
    jr z,Bunny_SS_YStep
    jr nc,Bunny_SS_XInc
    dec b
    jr Bunny_SS_XStore
Bunny_SS_XInc:
    inc b
Bunny_SS_XStore:
    ld a,b
    ld (AMY_SPRITE_TABLE+1),a
    ld (AMY_SPRITE_TABLE+5),a
    ld (AMY_SPRITE_TABLE+9),a
    ld (AMY_SPRITE_TABLE+13),a
Bunny_SS_YStep:
    ld a,(AMY_SPRITE_TABLE)
    ld b,a
    ld a,(Bunny_PlayerY)
    cp b
    ret z
    jr nc,Bunny_SS_YInc
    dec b
    jr Bunny_SS_YStore
Bunny_SS_YInc:
    inc b
Bunny_SS_YStore:
    ld a,b
    ld (AMY_SPRITE_TABLE),a
    ld (AMY_SPRITE_TABLE+4),a
    sub 8
    ld (AMY_SPRITE_TABLE+8),a
    ld (AMY_SPRITE_TABLE+12),a
    ret

Bunny_Invincible:
    ; a = frame counter i (0..223); animate smoke in star pattern around player
    and 15
    ld e,a
    ld d,0
    ld hl,Bunny_StarsDX
    add hl,de
    ld b,(hl)
    ld hl,Bunny_StarsDY
    add hl,de
    ld c,(hl)
    ld a,(AMY_SPRITE_TABLE+1)
    add a,b
    ld (AMY_SPRITE_TABLE+17),a
    ld a,(AMY_SPRITE_TABLE)
    add a,c
    ld (AMY_SPRITE_TABLE+16),a
    ld a,$27
    ld (AMY_SPRITE_TABLE+18),a
    ld a,5
    ld (AMY_SPRITE_TABLE+19),a
    ld a,$D0
    ld (AMY_SPRITE_TABLE+20),a
    ret

Bunny_StarsDX:
    db $00,$05,$08,$0B,$0C,$0B,$08,$05
    db $00,$FA,$F7,$F4,$F3,$F4,$F7,$FA
Bunny_StarsDY:
    db $EC,$EE,$F1,$F6,$FB,$02,$07,$0B
    db $0C,$0B,$07,$02,$FB,$F6,$F1,$EE

floor_pattern:
    db $99,$66,$DD,$77,$DD,$77,$99,$66

BunnyTitleColors:
    db $D1,$D1,$D1,$51,$D1,$51,$51,$51
    db $C1,$51,$C1,$C1,$C1,$21,$C1,$21
    db $21,$21,$31,$21,$31,$31,$31,$A1
    db $31,$A1,$A1,$A1,$91,$A1,$91,$91
    db $91,$81,$91,$81,$81,$81,$D1,$81
    db $D1,$D1,$D1,$51,$D1,$51,$51,$51
    db $C1,$51,$C1,$C1,$C1,$21,$C1,$21

BunnySoundTable:
    dw egg_snd,$702B
    dw jump_snd,$7035
    dw fire_snd,$703F
    dw inv_snd,$7049
    dw bird_snd,$7053
    dw music_ch1,$702B
    dw music_ch2,$7035

include "@project/bunny_sounds.inc"
include "@project/bunny_music.inc"
include "@project/bunny_grafx.inc"
include "@project/bunny_levels.inc"
}
