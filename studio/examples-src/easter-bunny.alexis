end data

data inv_snd bytes
  $C3,$56,$E3,$40,$11,$FA,$C0,$44,$C3,$56,$E3,$30
  $11,$F5,$C0,$33,$C3,$56,$E3,$20,$11,$EA,$C0,$22
  $C2,$97,$20,$4C,$1E,$5B,$D0
end data

data bird_snd bytes
  $43,$A2,$E0,$10,$11,$FA,$90,$11,$43,$70,$E0,$08
  $11,$FA,$A0,$12,$50
