{
  "version": 2,
  "projectName": "MegaCart Bank Demo",
  "target": {
    "platform": "colecovision-megacart",
    "romSizeKb": 128,
    "bankSizeKb": 16,
    "fixedWindow": "$8000-$BFFF",
    "switchableWindow": "$C000-$FFBF"
  },
  "outputs": [
    { "name": "FIXED", "type": "fixed-bank", "sources": [{ "path": "src/fixed.asm", "kind": "asm" }] },
    { "name": "BANK1", "type": "switchable-bank", "bank": 1, "sources": [{ "path": "banks/bank1.asm", "kind": "asm" }] },
    { "name": "BANK2", "type": "switchable-bank", "bank": 2, "sources": [{ "path": "banks/bank2.asm", "kind": "asm" }] }
  ]
}

