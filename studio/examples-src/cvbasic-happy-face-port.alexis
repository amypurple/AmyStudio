u8 X = 50
u8 Y = 100

i8 DX = 1
i8 DY = 1

u8 SpriteY = 99

data HappyAlienBugFace sprite16
  "...XX.......XX.."
  "..XX..X....X..X."
  "XX....XXXXX...XX"
  "....XXXXXXXXX..X"
  "...XX..XXX..XX.."
  "...X....X....XX."
  "..XX.XX.X.XX.XX."
  ".XXXXXXXXXXXXXXX"
  ".XXXXXXXXXXXXXXX"
  ".XXXXXXXXXXXXXXX"
  ".XXX.........XXX"
  "..XX.........XX."
  "..XXX.......XXX."
  "...XXXX...XXXX.."
  "....XXXXXXXXX..."
  ".......XXXX....."
end data

  text screen
  sprites 16x16
  sprites simple
  copy HappyAlienBugFace to vram.spr_pat
  clear sprites
  set sprite count 1
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "BOUNCING ALIEN BUG"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  cls
  print at 1,1, "Alien bug face!"
game_loop:
  wait 2 frames
  SpriteY = Y - 1
  set sprite 0 to SpriteY,X,0,10
  update sprites
  bounce X by DX between 0 and 240
  bounce Y by DY between 0 and 176
  goto game_loop