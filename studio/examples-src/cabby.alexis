cartridge "CABBY/COMPUTE!'S GAZETTE/1984"

' CABBY
' A ColecoVision game based on "Cabby", COMPUTE!'s Gazette, October 1984
' (Commodore 64 and VIC-20, BASIC with a small machine-language maze maker;
' no author is named on the disk or in the listing). Made for Amy Studio
' by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the
' C64 listing, orig/cabby_64.bas), the game is built for the ColecoVision:
' a cab and trolley cars that glide from cell to cell as sprites, a tiled
' night city, sound effects and an original title tune.
'
' The game: you drive a cab in a new random city every game (a maze of
' streets between buildings). The dispatcher sends you to a building
' ("CABBY, GO TO THE BANK"): every building of that kind lights up in
' yellow. Drive next to it and push the stick against it: the fare gets in
' and asks for another place ("TAKE ME TO THE ZOO"). Drop the fare there:
' the fare (by the distance driven) and a tip go into your cash. Cash is
' only safe once it is banked at the yellow depot at the top left; bank
' more than $200 and the cab is yours. Five trolley cars run along the two
' long avenues and three long streets with tracks; a trolley sees a cab on
' its tracks and charges at it; a trolley that hits the cab ends the game,
' with only the banked money counted. Traffic lights let the cab in only
' on green. Every move burns gas: push against a red gas pump to fill the
' tank; run dry and the cab stalls for a while, then gets half a tank.
' People wave from the pavements now and then: an empty cab may pick one
' up instead of the dispatcher's fare. EASY lights up every building of
' the wanted kind and any of them will do; HARD lights up one, and only
' that one counts.
'
' From the original (orig/cabby_64.bas): the random maze city with two
' trolley avenues and three trolley streets crossing it, the depot at the
' top left, 5 gas pumps, 12 traffic lights changing green, yellow, red at
' random (only green lets the cab in), the 26 kinds of buildings A-Z with
' the listing's names, several buildings of a kind (the listing's counts,
' halved and rounded up, for a smaller city), the dispatch, pick-up and
' drop-off messages, the fare by the distance from the pick-up and a tip
' of up to a tenth of it (in cents), cash banked at the depot, more than
' $200 banked wins, a trolley charging at a cab on its line (BASIC line
' 5000), trolleys turning back at the ends and at each other, the cab lost
' to a trolley ends the game showing the banked money, gas burnt by each
' move, out of gas then back with half a tank, people hailing a cab (the
' listing's MN fares from line 3300), EASY and HARD.
'
' Liberties: the city is 27 x 19 cells (the C64's was 39 x 19), with 24
' extra openings in the maze (in a perfect maze the only way between two
' blocks often ran a long way along the tracks, where no human could
' outrun a trolley), and the
' fare is $1 plus $1.50 a cell of distance (the C64 used the difference of
' two screen addresses); trolleys patrol at half the cab's speed and
' charge at 3/4 of it (the BASIC moved them about as often as the cab);
' a charging trolley always heads for the cab (the listing sometimes sent
' it to the end of its line, which also passes the cab); the gas gauge is
' always shown instead of on the button; the stall lasts 2.5 seconds; the
' hailing people stand on the pavement for 20 seconds (in the listing they
' piled up for ever but could only be used in the instant between two
' fares) and an empty cab may take one at any time; the stick takes the
' first open direction of those held (up, down, left, right), so a
' diagonal turns at the next corner; no play-again question (house rule).
'
' Controls: either controller; the stick drives (hold it). Push into a
' building, the pump or the depot to use it. On the title, up and down
' choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TSt = 128
const TTrh = 129
const TTrv = 130
const TTrx = 131
const TLg = 132
const TLy = 133
const TLr = 134
const TRoof0 = 135
const TRoof1 = 136
const TRoof2 = 137
const TGas = 138
const TDepot = 139
const THail = 140
const TG0 = 141
const TG1 = 142
const TG2 = 143
const TEdge = 144
const TCabi = 145
const TBa = 146
const TBb = 147
const TBc = 148
const TBd = 149
const TBe = 150
const TBf = 151
const TBg = 152
const TBh = 153
const TBi = 154
const TBj = 155
const TBk = 156
const TBl = 157
const TBm = 158
const TBn = 159
const TBo = 160
const TBp = 161
const TBq = 162
const TBr = 163
const TBs = 164
const TBt = 165
const TBu = 166
const TBv = 167
const TBw = 168
const TBx = 169
const TBy = 170
const TBz = 171
const THa = 172
const THb = 173
const THc = 174
const THd = 175
const THe = 176
const THf = 177
const THg = 178
const THh = 179
const THi = 180
const THj = 181
const THk = 182
const THl = 183
const THm = 184
const THn = 185
const THo = 186
const THp = 187
const THq = 188
const THr = 189
const THs = 190
const THt = 191
const THu = 192
const THv = 193
const THw = 194
const THx = 195
const THy = 196
const THz = 197
const SCabh = 0
const SCabv = 4
const STrolh = 8
const STrolv = 12
const SBoom = 16
const NTiles8 = 560
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndHorn = 3
const SndPick = 4
const SndCash = 5
const SndBank = 6
const SndFuel = 7
const SndDry = 8
const SndBell = 9
const SndCrash = 10
const SndStart = 11
const SndOver = 12
const SndWin = 13
const CabN = 8
const FullGas = 256
const StallN = 150
const MsgN = 120
const NB = 44
const NSpr = 6
const WinCents = 20000

' buildings of each kind (the listing's counts halved, rounded up)
data NumB bytes
  1, 3, 1, 2, 1, 1, 3, 1, 1, 2, 1, 1, 3, 4, 3, 1, 1, 3, 2, 3, 1, 1, 1, 1, 1, 1
end data
' the 12 traffic lights (cells)
data LgX bytes
  3, 11, 17, 23, 3, 11, 17, 23, 3, 11, 17, 23
end data
data LgY bytes
  3, 3, 3, 3, 9, 9, 9, 9, 15, 15, 15, 15
end data
' the five trolley lines: kind (0 across, 1 down), fixed cell, last pixel
data LnK bytes
  0, 0, 1, 1, 1
end data
data LnC bytes
  5, 13, 7, 13, 19
end data
data LnHi bytes
  200, 200, 136, 136, 136
end data
data LnQ bytes
  200, 8, 136, 8, 72
end data
' the place names, 17 characters each
data Names chars
  "AIRPORT          "
  "BANK             "
  "CURLING RINK     "
  "DOCTOR'S OFFICE  "
  "EMPLOYMENT OFFICE"
  "FACTORY          "
  "GROCERY STORE    "
  "HOSPITAL         "
  "INN              "
  "JEWELRY STORE    "
  "KENNEL           "
  "LIBRARY          "
  "MOTEL            "
  "NIGHT CLUB       "
  "OFFICE           "
  "POST OFFICE      "
  "QUARRY           "
  "RESTAURANT       "
  "SCHOOL           "
  "THEATER          "
  "UNIVERSITY       "
  "VET'S            "
  "WEATHER OFFICE   "
  "X-RAY OFFICE     "
  "YMCA             "
  "ZOO              "
end data

record Trolley:
  u8 Q
  u8 D
  u8 F
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Cash = 0
u16 Saved = 0
u16 Gas = FullGas
u16 Fare = 0
u16 Tip = 0
bcd digits 2 Fares = 0
u8 Hard = 0
u8 Over = 0
u8 Mode = 0
' the cab: cell (the one it is in or driving into), pixels, facing (0 up,
' 1 down, 2 left, 3 right), pixels left of the move, stall frames
u8 Cx = 1
u8 Cy = 1
u8 Px = 8
u8 Py = 8
u8 Cd = 3
u8 Cm = 0
u8 Stall = 0
' the job: 0 empty (sent to XF), 1 a fare aboard (going to CF); in HARD
' the one building that counts (Tgt); the pick-up cell
u8 Job = 0
u8 XF = 0
u8 CF = 0
u8 Tgt = 0
u8 Sx = 0
u8 Sy = 0
u8 MsgT = 0
Trolley Tr[5]
u8 Lt[12]
u8 Bx[NB]
u8 By[NB]
u8 Bl[NB]
u8 Hx[3]
u8 Hy[3]
u8 Hl[3]
u8 HailC = 0
u8 LightT = 0
u8 Stk[117]
u8 Opts[4]
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ti = 0
u8 Li = 0
u8 Hi3 = 0
u8 Bi = 0
u8 Fy = 0
u8 Fx = 0
u8 Di = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Qx = 0
u8 Qy = 0
u8 Got = 0
u8 Sp = 0

  tile screen
  set sound table CbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  Mode = 4
  ShowHud
  if Over = 1 then
    Rearm
    wait 60 frames
    nmi off
    mute all
    for Fy = 7 to 15
      fill 32 count 26 at 3,Fy
    next
    print at 4,8, "YOUR CAB LOST TO THE"
    print at 4,9, "TROLLEY"
    print at 4,11, "GAME OVER!"
    print at 4,13, "YOU MADE $"
    PrintMoney(Saved, 14, 13)
    play sound SndOver
  else
    mute all
    for Fy = 7 to 15
      fill 32 count 26 at 3,Fy
    next
    print at 4,8, "YOU HAVE SAVED ENOUGH"
    print at 4,10, "THE CAB IS YOURS"
    print at 4,12, "YOU WIN!"
    print at 4,14, "BANKED $"
    PrintMoney(Saved, 12, 14)
    play sound SndWin
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  ' one light a frame (each every half second), the people at frame 12
  if LightT < 12 then
    StepLight(LightT)
  elseif LightT = 12 then
    StepHails
  end if
  inc LightT
  if LightT >= 30 then LightT = 0
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowJob
  end if
  StepCab
  for Ti = 0 to 4
    StepTrolley
  next
  CheckCrash
  return
end sub

' a light: every half second it may move on (green 3 in 16,
' yellow 8 in 16, red 4 in 16)
sub StepLight(u8 Li):
    Rand
    R = Rs & 15
    V = Lt[Li]
    select case V
    case 0
      if R < 3 then V = 1
    case 1
      if R < 8 then V = 2
    case else
      if R < 4 then V = 0
    end select
    if V <> Lt[Li] then
      Lt[Li] = V
      put char TLg + V at LgX[Li] + 2,LgY[Li] + 2
    end if
  return
end sub

' the people waving: they leave after 20 seconds; every 4 seconds one may
' come out on a free pavement
sub StepHails:
  for Hi3 = 0 to 2
    if Hl[Hi3] > 0 then
      dec Hl[Hi3]
      if Hl[Hi3] = 0 then
        X = Hx[Hi3]
        Y = Hy[Hi3]
        put char RoofT(X, Y) at X + 2,Y + 2
      end if
    end if
  next
  inc HailC
  if HailC < 8 then return
  HailC = 0
  Got = 3
  for Hi3 = 0 to 2
    if Got = 3 then
      if Hl[Hi3] = 0 then Got = Hi3
    end if
  next
  if Got = 3 then return
  Rand
  Qx = Rs % 27
  Rand
  Qy = Rs % 19
  if FreeRoof(Qx, Qy) = 0 then return
  Hx[Got] = Qx
  Hy[Got] = Qy
  Hl[Got] = 40
  put char THail at Qx + 2,Qy + 2
  return
end sub

' the cab: stalled, gliding, or reading the stick
sub StepCab:
  if Stall > 0 then
    dec Stall
    if Stall = 0 then
      Gas = FullGas / 2
      ShowGas
      Say(3)
    end if
    return
  end if
  if Cm > 0 then
    select case Cd
    case 0
      dec Py
    case 1
      inc Py
    case 2
      dec Px
    case else
      inc Px
    end select
    dec Cm
    if Cm = 0 then
      if Gas = 0 then
        Stall = StallN
        Say(2)
        play sound SndDry
      end if
    end if
    return
  end if
  K = J1 | J2
  K = K & 15
  if K = 0 then return
  ' the first open direction held
  for Di = 0 to 3
    if Cm = 0 then
      V = 1 << Di
      V = V & K
      if V > 0 then
        Aim(Di)
        if Passable(Qx, Qy) = 1 then
          Cd = Di
          Cx = Qx
          Cy = Qy
          Cm = CabN
          dec Gas
          ShowGas
        end if
      end if
    end if
  next
  if Cm > 0 then return
  ' no way open: push against the first building held
  Got = 0
  for Di = 0 to 3
    if Got = 0 then
      V = 1 << Di
      V = V & K
      if V > 0 then
        Aim(Di)
        T = TileAt(Qx, Qy)
        if T >= TRoof0 then
          Got = 1
          Cd = Di
          Touch
        end if
      end if
    end if
  next
  return
end sub

' Qx, Qy: the cell next to the cab in direction Dir
sub Aim(u8 Dir):
  Qx = Cx
  Qy = Cy
  select case Dir
  case 0
    dec Qy
  case 1
    inc Qy
  case 2
    dec Qx
  case else
    inc Qx
  end select
  return
end sub

' push against the building at Qx, Qy (tile T)
sub Touch:
  if T = TGas then
    if Gas < FullGas then
      Gas = FullGas
      ShowGas
      Say(4)
      play sound SndFuel
    end if
    return
  end if
  if T = TDepot then
    if Cash > 0 then
      Saved = Saved + Cash
      Cash = 0
      ShowHud
      Say(5)
      play sound SndBank
      if Saved > WinCents then Over = 2
    end if
    return
  end if
  if T = THail then
    if Job = 0 then
      for Hi3 = 0 to 2
        if Hl[Hi3] > 0 then
          if Hx[Hi3] = Qx then
            if Hy[Hi3] = Qy then Hl[Hi3] = 0
          end if
        end if
      next
      put char RoofT(Qx, Qy) at Qx + 2,Qy + 2
      Light(XF, 0)
      PickUp(26)
    end if
    return
  end if
  if T < TBa then return
  V = T - TBa
  if V >= 26 then V = V - 26
  if Job = 0 then
    if V = XF then
      if Counts(Qx, Qy) = 1 then
        Light(XF, 0)
        PickUp(XF)
      end if
    end if
    return
  end if
  if V = CF then
    if Counts(Qx, Qy) = 1 then Deliver
  end if
  return
end sub

' 1 when the building at X0, Y0 is one that counts (any in EASY, the lit
' one in HARD)
function Counts(u8 X0, u8 Y0) as u8
  if Hard = 0 then return 1
  if Bx[Tgt] <> X0 then return 0
  if By[Tgt] <> Y0 then return 0
  return 1

' a fare gets in (From: the building kind, 26 for a hailer) and names a
' different place
sub PickUp(u8 From):
  Sx = Cx
  Sy = Cy
  Rand
  V = Rs % 26
  if V = From then
    inc V
    if V >= 26 then V = 0
  end if
  CF = V
  Job = 1
  ChooseTgt(CF)
  Light(CF, 1)
  ShowJob
  play sound SndPick
  return
end sub

' the fare pays: $1 plus $1.50 a cell, and a tip of up to a tenth
sub Deliver:
  Light(CF, 0)
  D = AbsDiff(Cx, Sx) + AbsDiff(Cy, Sy)
  W16 = D
  Fare = W16 * 150 + 100
  Rand
  W16 = Fare / 10 + 1
  Tip = Rs % W16
  W16 = 60000 - Cash
  NumU = Fare + Tip
  if NumU > W16 then NumU = W16
  Cash = Cash + NumU
  inc Fares
  Job = 0
  NewDispatch
  ShowHud
  ' the fare's message first, the next dispatch after it
  fill 32 count 18 at 2,21
  fill 32 count 18 at 2,22
  print at 2,21, "FARE $"
  PrintMoney(Fare, 8, 21)
  print at 2,22, "TIP  $"
  PrintMoney(Tip, 8, 22)
  MsgT = MsgN
  play sound SndCash
  return
end sub

' the dispatcher names a kind of building (and, in HARD, one of them)
sub NewDispatch:
  Rand
  XF = Rs % 26
  ChooseTgt(XF)
  Light(XF, 1)
  ShowJob
  return
end sub

' HARD: Tgt = one of the buildings of kind L, at random
sub ChooseTgt(u8 L):
  if Hard = 0 then return
  N = NumB[L]
  Rand
  K = Rs % N
  for Bi = 0 to NB - 1
    if Bl[Bi] = L then
      if K = 0 then Tgt = Bi
      dec K
    end if
  next
  return
end sub

' light up (Lit = 1) or put out the buildings of kind L that count
sub Light(u8 L, u8 Lit):
  U = TBa + L
  if Lit = 1 then U = U + 26
  for Bi = 0 to NB - 1
    if Bl[Bi] = L then
      if Counts(Bx[Bi], By[Bi]) = 1 then
        put char U at Bx[Bi] + 2,By[Bi] + 2
      end if
    end if
  next
  return
end sub

' one trolley (Ti): it charges at a cab on its line at 3/4 of the cab's
' speed, else patrols at half speed; it turns back at the ends of the line and at another trolley
sub StepTrolley:
  Trolley Me = 0
  Me.Q = Tr[Ti].Q
  Me.D = Tr[Ti].D
  Me.F = 0
  C = LnC[Ti]
  if LnK[Ti] = 0 then
    U = Cy
    V = Cx << 3
  else
    U = Cx
    V = Cy << 3
  end if
  if U = C then
    Me.F = 1
    if V > Me.Q then Me.D = 0
    if V < Me.Q then Me.D = 1
  end if
  ' patrol on every other frame, charge on three frames in four
  V = Tick & 1
  Got = 0
  if V = 0 then Got = 1
  if Me.F = 1 then
    V = Tick & 3
    Got = 0
    if V <> 0 then Got = 1
  end if
  if Got = 1 then
    if Me.D = 0 then
      N = Me.Q + 1
    else
      N = Me.Q - 1
    end if
    if N < 8 then
      Me.D = 0
    elseif N > LnHi[Ti] then
      Me.D = 1
    elseif Blocked(N) = 1 then
      Me.D = Me.D ^ 1
    else
      Me.Q = N
    end if
  end if
  Tr[Ti].Q = Me.Q
  Tr[Ti].D = Me.D
  Tr[Ti].F = Me.F
  return
end sub

' 1 when trolley Ti at pixel Nq would run into a trolley of a crossing line
function Blocked(u8 Nq) as u8
  u8 Res = 0
  u8 Oj = 0
  u8 Mx = 0
  u8 My = 0
  u8 Ox = 0
  u8 Oy = 0
  if LnK[Ti] = 0 then
    Mx = Nq
    My = LnC[Ti] << 3
  else
    Mx = LnC[Ti] << 3
    My = Nq
  end if
  for Oj = 0 to 4
    if LnK[Oj] <> LnK[Ti] then
      if LnK[Oj] = 0 then
        Ox = Tr[Oj].Q
        Oy = LnC[Oj] << 3
      else
        Ox = LnC[Oj] << 3
        Oy = Tr[Oj].Q
      end if
      if AbsDiff(Mx, Ox) < 8 then
        if AbsDiff(My, Oy) < 8 then Res = 1
      end if
    end if
  next
  return Res

function AbsDiff(u8 A0, u8 B0) as u8
  if A0 > B0 then return A0 - B0
  return B0 - A0

' a trolley within 6 pixels both ways of the cab ends the game
sub CheckCrash:
  for Ti = 0 to 4
    TrolleyXY
    if AbsDiff(X, Px) < 6 then
      if AbsDiff(Y, Py) < 6 then
        Over = 1
        Cm = 0
        play sound SndCrash
      end if
    end if
  next
  return
end sub

' X, Y: the pixels of trolley Ti
sub TrolleyXY:
  if LnK[Ti] = 0 then
    X = Tr[Ti].Q
    Y = LnC[Ti] << 3
  else
    X = LnC[Ti] << 3
    Y = Tr[Ti].Q
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the city map is the screen: cell Fx, Fy is the tile at column Fx + 2, row
' Fy + 2

function TileAt(u8 X0, u8 Y0) as u8
  u8 Tg = 0
  if X0 > 26 then return TEdge
  if Y0 > 18 then return TEdge
  Tg = get char at X0 + 2,Y0 + 2
  return Tg

' 1 when the cab may drive into the cell (a street, track, or green light)
function Passable(u8 X0, u8 Y0) as u8
  u8 Tc = 0
  Tc = TileAt(X0, Y0)
  if Tc = TLg then return 1
  if Tc < TSt then return 0
  if Tc <= TTrx then return 1
  return 0

' the plain roof of a cell (3 x 3 patches of slab, brick and park)
function RoofT(u8 X0, u8 Y0) as u8
  u8 Rv = 0
  Rv = X0 / 3 + Y0 / 3
  Rv = Rv % 3
  return TRoof0 + Rv

' 1 when the cell is a plain roof next to a street (for pumps, buildings
' and people)
function FreeRoof(u8 X0, u8 Y0) as u8
  u8 Tc = 0
  u8 Ok = 0
  Tc = TileAt(X0, Y0)
  if Tc < TRoof0 then return 0
  if Tc > TRoof2 then return 0
  if X0 > 0 then
    if Road(X0 - 1, Y0) = 1 then Ok = 1
  end if
  if Road(X0 + 1, Y0) = 1 then Ok = 1
  if Y0 > 0 then
    if Road(X0, Y0 - 1) = 1 then Ok = 1
  end if
  if Road(X0, Y0 + 1) = 1 then Ok = 1
  return Ok

function Road(u8 X0, u8 Y0) as u8
  u8 Tc = 0
  Tc = TileAt(X0, Y0)
  if Tc < TSt then return 0
  if Tc > TLr then return 0
  return 1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' building the city

sub BuildCity:
  for Fy = 0 to 23
    fill TEdge count 32 at 0,Fy
  next
  fill 32 count 32 at 0,1
  fill 32 count 32 at 0,21
  fill 32 count 32 at 0,22
  for Fy = 0 to 18
    for Fx = 0 to 26
      put char RoofT(Fx, Fy) at Fx + 2,Fy + 2
    next
  next
  CarveMaze
  ExtraLoops
  ' the trolley tracks
  for Fx = 1 to 25
    put char TTrh at Fx + 2,7
    put char TTrh at Fx + 2,15
  next
  for Fy = 1 to 17
    put char TTrv at 9,Fy + 2
    put char TTrv at 15,Fy + 2
    put char TTrv at 21,Fy + 2
  next
  for Fx = 0 to 2
    X = Fx * 6 + 9
    put char TTrx at X,7
    put char TTrx at X,15
  next
  put char TDepot at 2,3
  for Li = 0 to 11
    Lt[Li] = 0
    put char TLg at LgX[Li] + 2,LgY[Li] + 2
  next
  for Bi = 0 to 4
    PlaceOn(TGas)
  next
  Bi = 0
  for Li = 0 to 25
    N = NumB[Li]
    for Fx = 1 to N
      PlaceOn(TBa + Li)
      Bx[Bi] = Qx
      By[Bi] = Qy
      Bl[Bi] = Li
      inc Bi
    next
  next
  return
end sub

' a random plain roof next to a street gets tile Tn (its cell in Qx, Qy)
sub PlaceOn(u8 Tn):
  Got = 0
  while Got = 0
    Rand
    Qx = Rs % 27
    Rand
    Qy = Rs % 19
    Got = FreeRoof(Qx, Qy)
  end while
  put char Tn at Qx + 2,Qy + 2
  return
end sub

' the maze of streets: cells on odd columns and rows (13 x 9), carved from
' the top left cell by a random walk that backs up at dead ends (the
' listing's machine code does the same on the C64 screen)
sub CarveMaze:
  put char TSt at 3,3
  Stk[0] = 0
  Sp = 1
  while Sp > 0
    K = Stk[Sp - 1]
    Fx = K % 13
    Fy = K / 13
    N = 0
    if Fy > 0 then
      if TileAt(Fx * 2 + 1, Fy * 2 - 1) <> TSt then
        Opts[N] = 0
        inc N
      end if
    end if
    if Fy < 8 then
      if TileAt(Fx * 2 + 1, Fy * 2 + 3) <> TSt then
        Opts[N] = 1
        inc N
      end if
    end if
    if Fx > 0 then
      if TileAt(Fx * 2 - 1, Fy * 2 + 1) <> TSt then
        Opts[N] = 2
        inc N
      end if
    end if
    if Fx < 12 then
      if TileAt(Fx * 2 + 3, Fy * 2 + 1) <> TSt then
        Opts[N] = 3
        inc N
      end if
    end if
    if N = 0 then
      dec Sp
    else
      Rand
      V = Rs % N
      D = Opts[V]
      X = Fx * 2 + 3
      Y = Fy * 2 + 3
      select case D
      case 0
        put char TSt at X,Y - 1
        put char TSt at X,Y - 2
        K = K - 13
      case 1
        put char TSt at X,Y + 1
        put char TSt at X,Y + 2
        K = K + 13
      case 2
        put char TSt at X - 1,Y
        put char TSt at X - 2,Y
        dec K
      case else
        put char TSt at X + 1,Y
        put char TSt at X + 2,Y
        inc K
      end select
      Stk[Sp] = K
      inc Sp
    end if
  end while
  return
end sub

' 24 more openings between neighbouring cells (a perfect maze made the cab
' drive long stretches on the tracks)
sub ExtraLoops:
  for Di = 1 to 24
    Rand
    X = Rs % 12
    Rand
    Y = Rs % 8
    Rand
    V = Rs & 1
    if V = 0 then
      put char TSt at X * 2 + 4,Y * 2 + 3
    else
      put char TSt at X * 2 + 3,Y * 2 + 4
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the cab (or the crash), 1-5 the trolleys
sub DrawSprites:
  X = Px + 12
  Y = Py + 11
  if Over = 1 then
    set sprite 0 to Y,X,SBoom,9
  elseif Cd < 2 then
    set sprite 0 to Y,X,SCabv,11
  else
    set sprite 0 to Y,X,SCabh,11
  end if
  for Ti = 0 to 4
    TrolleyXY
    X = X + 12
    Y = Y + 11
    J = Ti + 1
    if LnK[Ti] = 0 then
      set sprite J to Y,X,STrolh,15
    else
      set sprite J to Y,X,STrolv,15
    end if
  next
  update sprites
  return
end sub

' money in cents as ddd.cc at Col, Row
sub PrintMoney(u16 Cents, u8 Col, u8 Row):
  NumU = Cents / 100
  print at Col,Row, digits$(NumU, 3)
  put char 46 at Col + 3,Row
  NumU = Cents % 100
  print at Col + 4,Row, digits$(NumU, 2)
  return
end sub

sub ShowHud:
  print at 2,1, "CASH"
  PrintMoney(Cash, 7, 1)
  print at 14,1, "BANK"
  PrintMoney(Saved, 19, 1)
  put char TCabi at 26,1
  print Fares at 27,1
  return
end sub

' the gas gauge: E, eight cells of two halves, F
sub ShowGas:
  V = Gas >> 4
  if Gas >= FullGas then V = 16
  print at 20,22, "E"
  print at 29,22, "F"
  for Fx = 0 to 7
    U = Fx << 1
    T = TG0
    if V > U then T = TG1
    U = U + 1
    if V > U then T = TG2
    put char T at Fx + 21,22
  next
  return
end sub

' the job on rows 21-22
sub ShowJob:
  fill 32 count 18 at 2,21
  fill 32 count 18 at 2,22
  if Job = 0 then
    print at 2,21, "CABBY, GO TO THE"
    W16 = XF
  else
    print at 2,21, "TAKE ME TO THE"
    W16 = CF
  end if
  W16 = W16 * 17
  put Names + W16 count 17 at 2,22
  return
end sub

' short news on row 21 for a while: 2 out of gas, 3 half a tank, 4 tank
' full, 5 banked
sub Say(u8 What):
  fill 32 count 18 at 2,21
  fill 32 count 18 at 2,22
  select case What
  case 2
    print at 2,21, "OUT OF GAS"
  case 3
    print at 2,21, "BACK WITH 1/2"
    print at 2,22, "TANKFUL"
  case 4
    print at 2,21, "TANK FULL"
  case else
    print at 2,21, "SAFE IN DEPOT"
  end select
  MsgT = MsgN
  if What = 2 then MsgT = StallN
  return
end sub

sub NewGame:
  NewScreen
  BuildCity
  Cash = 0
  Saved = 0
  Fares = 0
  Gas = FullGas
  Cx = 1
  Cy = 1
  Px = 8
  Py = 8
  Cd = 3
  Cm = 0
  Stall = 0
  Job = 0
  MsgT = 0
  LightT = 0
  HailC = 0
  Over = 0
  for Hi3 = 0 to 2
    Hl[Hi3] = 0
  next
  for Ti = 0 to 4
    Tr[Ti].Q = LnQ[Ti]
    Rand
    Tr[Ti].D = Rs & 1
    Tr[Ti].F = 0
  next
  NewDispatch
  ShowHud
  ShowGas
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  Mode = 3
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a city behind a sign, the tune once, EASY / HARD / CREDITS
sub TitlePage:
  Mode = 2
  NewScreen
  BuildCity
  fill 32 count 32 at 0,1
  for Fy = 5 to 17
    fill 32 count 20 at 6,Fy
  next
  print at 13,6, "CABBY"
  put char TCabi at 11,6
  put char TCabi at 19,6
  print at 9,8, "COMPUTE!'S"
  print at 9,9, "GAZETTE OCT 1984"
  print at 11,12, "EASY"
  print at 11,13, "HARD"
  print at 11,14, "CREDITS"
  print at 7,16, "JOYSTICK + BUTTON"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  Hard = Menu
  return
end sub

sub ShowMenu:
  for Fy = 12 to 14
    put char 32 at 9,Fy
  next
  J = Menu + 12
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  Mode = 1
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "CABBY"
  print at 2,5, "BASED ON CABBY,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "OCTOBER 1984 (COMMODORE 64"
  print at 2,8, "AND VIC-20). NO AUTHOR IS"
  print at 2,9, "NAMED ON THE DISK."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: METER RUNNING"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

