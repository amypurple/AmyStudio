cartridge "COPY CAT/MARK AND DAN POWELL, COMPUTE!/1983"

' COPY CAT
' The game by Mark and Dan Powell from COMPUTE!, February 1983 (pages
' 68-74, for the VIC-20, the Atari, the TRS-80 Color Computer, the Apple
' II and the PET/CBM), for the ColecoVision in Amy by Amy Bienvenu. Ported
' by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: Program 1, the VIC-20 version, transcribed in
' orig/copycat-vic.bas from the scan beside it. The other versions were
' read for the intent only (the Atari's joystick: up, left, right, down
' for its four boxes; its difficulty levels are not here).
'
' The game: four boxes, each with its colour and its note. The computer
' plays a pattern, one box more each round; copy it. A wrong box, or no
' box for a little over three seconds (the right one then lights to show
' it), is a MISS and the computer plays the same pattern again; three
' misses end the game. The score is the length of the last pattern copied
' (99 at most: the 100th round ends the game).
'
' Controls (either joystick): the stick plays the boxes, from left to
' right: left, up, down, right (the VIC's keys 1-4; the arrows above the
' boxes show them). The button starts; after a game it plays again (the
' VIC's space), the stick down goes back to the credits page (its CTRL
' stopped the program). Keypad not used.
'
' The VIC-20's screen (22 x 23) is kept cell for cell, at columns 5-26 and
' rows 1-23: a box's middle cells are at the VIC's rows 9-10, columns
' 3+5*S and 4+5*S (line 1000). Labels such as l120 are the listing's line
' numbers; the delays are its empty FOR loops, 15 passes a frame (300 is
' 20 frames), and TI is the frame count (200 jiffies are 200 frames).
'
' Kept as the listing has them: the colours are drawn from red, blue,
' purple and green (line 87), but line 90 never compares the first box's
' with the others (its FOR starts at 1), so the first box may share a
' colour; a timeout lights the right box, then counts as a miss.
'
' Liberties taken:
' - The stick counts when pushed (it must come back to the middle between
'   two boxes) and only while the game waits for you; the VIC kept keys
'   pressed during the computer's turn in its keyboard buffer.
' - The arrows replace the digits 1-4; the texts name the stick and the
'   button instead of the keys.
' - Yellow and blue text are tiles; white and black text is the
'   ColecoVision font.
' - A credits page with an original tune (Follow Me) played once.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from 128; no
' sprites; the frame loop is protected from the NMI and every screen is
' drawn with the NMI off after a wait.

const TWall = 128
const TPad0 = 129
const TPad1 = 130
const TPad2 = 131
const TPad3 = 132
const TAl0 = 133
const TAl1 = 134
const TAu0 = 135
const TAu1 = 136
const TAd0 = 137
const TAd1 = 138
const TAr0 = 139
const TAr1 = 140
const TYI = 141
const TYM = 142
const TYS = 143
const TBA = 144
const TBE = 145
const TBF = 146
const TBI = 147
const TBO = 148
const TBP = 149
const TBR = 150
const TBS = 151
const TBT = 152
const NTiles8 = 200
const SprBytes = 0
const SndHush = 1
const SndLong0 = 2
const SndLong1 = 3
const SndLong2 = 4
const SndLong3 = 5
const SndShort0 = 6
const SndShort1 = 7
const SndShort2 = 8
const SndShort3 = 9
const SndMiss = 10
const SndQuiet = 11
const SndTuneA = 12
const SndTuneB = 13

' --- the listing's variables ----------------------------------------------
' LF the pattern's length, Lq its boxes (L%), LC the boxes' colours (VIC
' colour codes), R the misses, S the box, A the box pushed (255 none: the
' VIC's -1), LG LL the loops, TA the time the wait began
u8 LF = 0
u8 Lq[101]
u8 LC[5]
u8 R = 0
u8 S = 0
u8 A = 255
u8 LG = 0
u8 LL = 0
u8 LA = 0
u8 LB = 0
u16 TA = 0
u16 Ti = 0
' for the test bot: Ph 0 credits, 1 title, 2 computer playing, 3 your
' turn, 4 miss, 5 game over; Lit the box lit (255 none); Rs0 the
' generator when the boxes were coloured
u8 Ph = 0
u8 Lit = 255
u16 Rs0 = 0
u8 Ask = 0

u8 Dir = 0
u8 Prev = 0
u8 Fr = 0
u8 Dn = 0
u8 Any = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 K8 = 0
u8 Tick = 0
u16 W16 = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rs = $5C31
u16 Rt = 0
u16 Rw = 0
u16 Rv = 0

  tile screen
  set sound table CySoundTable areas 4
  nmi off
  screen on

credits:
  CreditsPage

l10:
  ' 10-35: the title, black on white (POKE 36879,27)
  Ph = 1
  NewScreen($1F)
  backdrop white
  print at 12,5, "COPY CAT"
  print at 5,8, " PUSH THE STICK TO COPY"
  print at 5,9, "      THE COMPUTER"
  print at 5,12, " YOU CAN ONLY MISS"
  print at 5,13, " THREE TIMES A GAME"
  copy BPress count 19 to vram.name + 549
  ShowScreen
  ' 35: wait for the button (the VIC's space)
  Ask = 1
  WaitLetGo
l35:
  Frame1
  ReadStick
  if Fr = 0 then goto l35
  Ask = 0

l40:
  ' 40-82 (and RUN 40): a new game, the boxes on a black screen
  LF = 0
  R = 0
  for J8 = 0 to 4
    LC[J8] = 0
  next
  NewScreen($F1)
  backdrop black
  for J8 = 0 to 3
    ' the arrows (the keys 1-4 of line 50)
    V = J8 * 5
    V = V + 8
    W = J8 * 2
    W = W + TAl0
    put char W at V,7
    inc W
    inc V
    put char W at V,7
    ' the frame (rows 8-11, columns 2-5 + 5 per box)
    V = J8 * 5
    V = V + 7
    for K8 = 0 to 3
      W = V + K8
      put char TWall at W,9
      put char TWall at W,12
    next
    put char TWall at V,10
    put char TWall at V,11
    W = V + 3
    put char TWall at W,10
    put char TWall at W,11
  next
  print at 15,16, "000"
  ' 85-95: each box's colour
  Rs0 = Rs
  for LA = 0 to 3
l87:
    RndK(4)
    V = lowbyte Rv
    V = V + 2
    if V = 3 then V = 6
    LC[LA] = V
    for LB = 1 to 4
      if LB <> LA then
        if LC[LB] = V then goto l87
      end if
    next
    ' the box's middle tile takes the colour
    V = VicCol[V]
    V = V << 4
    W = V >> 4
    V = V | W
    W16 = LA
    W16 = W16 << 3
    W16 = W16 + 1032
    for J8 = 0 to 7
      vpoke vram.color + W16, V
      inc W16
    next
  next
  ShowScreen

l99:
  Pause(20)
  ' 100-110: one box more (the 100th round ends the game)
  inc LF
  if LF = 100 then goto l2000
  RndK(4)
  Lq[LF] = lowbyte Rv

l120:
  ' 120-130: the computer plays the pattern
  Ph = 2
  for LL = 1 to LF
    S = Lq[LL]
    Light(1)
    Pause(20)
    Light(0)
    Pause(13)
  next
  ' 135-162: your turn
  Ph = 3
  for LG = 1 to LF
    TA = Ti
l140:
    Frame1
    ReadStick
    A = 255
    if Prev = 0 then
      if Dir <> 0 then A = Dir - 1
    end if
    Prev = Dir
    W16 = Ti - TA
    if W16 > 200 then
      S = Lq[LG]
      goto l160
    end if
    if A = 255 then goto l140
    S = A
l160:
    Light(2)
    Pause(13)
    Light(0)
    ' 162: right, on to the next box; wrong, a miss
    if A <> Lq[LG] then goto l170
    Pause(3)
  next
  ' 165: the whole pattern copied: the score is its length
  ' (TAB(14-LEN(LF$)): the digits end at the VIC's column 12, over 000)
  V = LF / 10
  W = V * 10
  W = LF - W
  W = W + 48
  put char W at 17,16
  if V > 0 then
    V = V + 48
    put char V at 16,16
  end if
  goto l99

l170:
  ' 170-190: MISS (in yellow), a buzz; three misses end the game
  Ph = 4
  copy YMiss count 4 to vram.name + 110
  play sound SndMiss
  inc R
  Pause(27)
  if R = 3 then
    Pause(7)
    goto l2000
  end if
  Pause(40)
  print at 14,3, "        "
  Pause(33)
  goto l120

l2000:
  ' 2000-2030: game over
  Ph = 5
  play sound SndQuiet
  print at 10,17, "*GAME OVER*"
  print at 9,19, "TO PLAY AGAIN"
  print at 8,20, "PRESS THE BUTTON"
  print at 7,22, "STICK DOWN TO STOP"
  Ask = 1
  WaitLetGo
l2010:
  Frame1
  ReadStick
  if Fr = 1 then
    Ask = 0
    goto l40
  end if
  if Dn = 1 then
    Ask = 0
    goto credits
  end if
  goto l2010

' Light: box S lit (Q 160) with its note, Lm 1 the computer's (longer),
' 2 yours; Lm 0 dark (Q 32; the volume off with the note's end)
sub Light(u8 Lm):
  W = S * 5
  W = W + 8
  if Lm = 0 then
    V = 32
    Lit = 255
  else
    V = TPad0 + S
    Lit = S
  end if
  put char V at W,10
  put char V at W,11
  inc W
  put char V at W,10
  put char V at W,11
  if Lm = 1 then
    if S = 0 then play sound SndLong0
    if S = 1 then play sound SndLong1
    if S = 2 then play sound SndLong2
    if S = 3 then play sound SndLong3
  end if
  if Lm = 2 then
    if S = 0 then play sound SndShort0
    if S = 1 then play sound SndShort1
    if S = 2 then play sound SndShort2
    if S = 3 then play sound SndShort3
  end if
  return
end sub

' Pause: Wn frames (an empty FOR loop of the listing, 15 passes a frame);
' the stick is still read, so a push held through it does not count later
sub Pause(u8 Wn):
  for K8 = 1 to Wn
    Frame1
    ReadStick
    Prev = Dir
  next
  return
end sub

' ReadStick: Dir the box the stick points at (1-4: left, up, down,
' right; 0 none or a diagonal), Fr the button, Dn the stick down
sub ReadStick:
  Dir = 0
  Any = 0
  V = joypad(1).left | joypad(2).left
  if V = 1 then
    Dir = 1
    inc Any
  end if
  V = joypad(1).up | joypad(2).up
  if V = 1 then
    Dir = 2
    inc Any
  end if
  V = joypad(1).down | joypad(2).down
  Dn = V
  if V = 1 then
    Dir = 3
    inc Any
  end if
  V = joypad(1).right | joypad(2).right
  if V = 1 then
    Dir = 4
    inc Any
  end if
  if Any > 1 then Dir = 0
  Fr = joypad(1).fire | joypad(2).fire
  return
end sub

' WaitLetGo: until the stick and the button are let go
sub WaitLetGo:
wl_loop:
  Frame1
  ReadStick
  Any = Any | Fr
  if Any > 0 then goto wl_loop
  Prev = 0
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen($F1)
  backdrop black
  print at 12,2, "COPY CAT"
  print at 2,4, "BY MARK AND DAN POWELL, FROM"
  print at 2,5, "COMPUTE!, FEBRUARY 1983"
  print at 2,6, "(VIC-20, ATARI, TRS-80 COLOR"
  print at 2,7, "COMPUTER, APPLE II AND"
  print at 2,8, "PET/CBM). A MATCH-ME GAME OF"
  print at 2,9, "PATTERNS, MEMORY AND"
  print at 2,10, "HAND-EYE COORDINATION."
  print at 2,12, "FOR THE COLECOVISION BY"
  print at 2,13, "CLAUDE (AN AI MADE BY"
  print at 2,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "2026, IN AMY, THE LANGUAGE"
  print at 2,16, "BY AMY BIENVENU."
  print at 2,18, "MUSIC: FOLLOW ME (ORIGINAL)."
  print at 9,21, "PRESS THE BUTTON"
  ShowScreen
  play song CySong once
  Ask = 1
  WaitLetGo
cp_wait:
  Frame1
  ReadStick
  if Fr = 0 then goto cp_wait
  Ask = 0
  ' the time spent here seeds RND
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $5C31
  return
end sub

sub NewScreen(u8 Tc):
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with Tc
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Ti
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' RndK: Rv = INT(RND(1) * Kn)
sub RndK(u8 Kn):
  Rnd16
  Uq = Rw
  Uq2 = Kn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

' the VIC's colours 0-7 as TMS9918 colours (2 red, 4 purple, 5 green, 6
' blue are the boxes')
data VicCol bytes 1, 15, 8, 7, 13, 2, 4, 11

data YMiss bytes 142,141,143,143
data BPress bytes 149,150,145,151,151,32,146,147,150,145,32,152,148,32,151,152,144,150,152
data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $0C,$1C,$C0,$80,$80,$C0,$1C,$0C
  $00,$00,$00,$00,$00,$00,$00,$00
  $01,$03,$07,$F0,$E1,$01,$01,$01
  $80,$C0,$E0,$F0,$87,$80,$80,$80
  $01,$01,$01,$E1,$F0,$07,$03,$01
  $80,$80,$80,$87,$F0,$E0,$C0,$80
  $00,$00,$00,$00,$00,$00,$00,$00
  $30,$38,$03,$01,$01,$03,$38,$30
  $00,$38,$10,$10,$10,$10,$10,$38
  $00,$44,$93,$54,$54,$44,$44,$44
  $00,$C3,$40,$40,$38,$04,$04,$87
  $00,$38,$44,$44,$83,$44,$44,$44
  $00,$83,$40,$40,$87,$40,$40,$83
  $00,$83,$40,$40,$87,$40,$40,$40
  $00,$38,$10,$10,$10,$10,$10,$38
  $00,$38,$44,$44,$44,$44,$44,$38
  $00,$87,$44,$44,$87,$40,$40,$40
  $00,$87,$44,$44,$87,$50,$48,$44
  $00,$C3,$40,$40,$38,$04,$04,$87
  $00,$83,$10,$10,$10,$10,$10,$10
end data
data TileCol bytes
  $0F,$0F,$0F,$0F,$0F,$0F,$0F,$0F
  $08,$08,$08,$08,$08,$08,$08,$08
  $08,$08,$08,$08,$08,$08,$08,$08
  $08,$08,$08,$08,$08,$08,$08,$08
  $08,$08,$08,$08,$08,$08,$08,$08
  $F1,$F1,$1F,$1F,$1F,$1F,$F1,$F1
  $01,$01,$0F,$0F,$0F,$0F,$01,$01
  $F1,$F1,$F1,$1F,$1F,$F1,$F1,$F1
  $F1,$F1,$F1,$F1,$1F,$F1,$F1,$F1
  $F1,$F1,$F1,$1F,$1F,$F1,$F1,$F1
  $F1,$F1,$F1,$1F,$F1,$F1,$F1,$F1
  $01,$01,$0F,$0F,$0F,$0F,$01,$01
  $F1,$F1,$1F,$1F,$1F,$1F,$F1,$F1
  $01,$B1,$B1,$B1,$B1,$B1,$B1,$B1
  $01,$B1,$1B,$B1,$B1,$B1,$B1,$B1
  $01,$1B,$B1,$B1,$B1,$B1,$B1,$1B
  $0F,$4F,$4F,$4F,$F4,$4F,$4F,$4F
  $0F,$F4,$4F,$4F,$F4,$4F,$4F,$F4
  $0F,$F4,$4F,$4F,$F4,$4F,$4F,$4F
  $0F,$4F,$4F,$4F,$4F,$4F,$4F,$4F
  $0F,$4F,$4F,$4F,$4F,$4F,$4F,$4F
  $0F,$F4,$4F,$4F,$F4,$4F,$4F,$4F
  $0F,$F4,$4F,$4F,$F4,$4F,$4F,$4F
  $0F,$F4,$4F,$4F,$4F,$4F,$4F,$F4
  $0F,$F4,$4F,$4F,$4F,$4F,$4F,$4F
end data

asm {
CyHush:
    db $00,$00,$F0,$01,$10
CyLong0:
    db $40,$11,$01,$14,$50
CyLong1:
    db $40,$E0,$00,$14,$50
CyLong2:
    db $40,$AF,$00,$14,$50
CyLong3:
    db $40,$7E,$00,$14,$50
CyShort0:
    db $40,$11,$01,$0D,$50
CyShort1:
    db $40,$E0,$00,$0D,$50
CyShort2:
    db $40,$AF,$00,$0D,$50
CyShort3:
    db $40,$7E,$00,$0D,$50
CyMiss:
    db $40,$7F,$03,$43,$50
CyQuiet:
    db $40,$7F,$F3,$01,$50

CySoundTable:
    dw CyHush,$702B
    dw CyLong0,$7035
    dw CyLong1,$7035
    dw CyLong2,$7035
    dw CyLong3,$7035
    dw CyShort0,$7035
    dw CyShort1,$7035
    dw CyShort2,$7035
    dw CyShort3,$7035
    dw CyMiss,$7035
    dw CyQuiet,$7035
    dw CyTuneMel,$703F
    dw CyTuneBass,$7049
; Follow Me, C# minor to E major (original for this game)
; Tiny Sound, 8 frames per step
CyTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1B,$01,$1E,$01,$22,$01,$01,$01,$1E,$01,$22,$01
    db $28,$01,$01,$01,$28,$01,$22,$01,$1E,$01,$1B,$01,$1E,$01,$01,$01
    db $01,$01,$01,$01,$1B,$01,$1B,$01,$1E,$01,$22,$01,$22,$01,$1E,$01
    db $28,$01,$01,$01,$28,$01,$1B,$01,$1E,$01,$22,$01,$23,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
CyTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$01,$01,$01,$01,$0F,$01,$12,$01,$16,$01,$01,$01
    db $12,$01,$10,$01,$08,$01,$01,$01,$0F,$01,$01,$01,$01,$01,$01,$01
    db $06,$01,$01,$01,$08,$01,$01,$01,$0F,$01,$01,$01,$06,$01,$01,$01
    db $0D,$01,$01,$01,$04,$01,$01,$01,$06,$01,$01,$01,$0B,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
CySong:
    dw $0001
    db $40+12,13
    dw $0000
}
