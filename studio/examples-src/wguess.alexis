  15, 18, 9, 7, 9, 14, 1, 12, 0, 0, 15, 24, 25, 7, 5, 14, 0, 0, 0, 0, 19, 11, 9, 9, 14, 7, 0, 0, 0, 0, 16, 12, 1, 19, 13, 1, 0, 0, 0, 0, 16, 18, 5, 13, 1, 20, 21, 18, 5, 0,
  19, 16, 5, 3, 9, 1, 12, 0, 0, 0, 18, 5, 7, 1, 18, 4, 0, 0, 0, 0, 18, 5, 6, 21, 7, 5, 5, 0, 0, 0, 19, 8, 1, 11, 5, 0, 0, 0, 0, 0, 23, 1, 20, 5, 18, 3, 18, 5, 19, 19,
  19, 1, 12, 15, 15, 14, 0, 0, 0, 0, 23, 1, 19, 8, 1, 2, 12, 5, 0, 0, 23, 8, 1, 20, 5, 22, 5, 18, 0, 0, 25, 15, 12, 11, 0, 0, 0, 0, 0, 0, 23, 9, 14, 4, 15, 23, 0, 0, 0, 0,
  1, 3, 20, 9, 15, 14, 0, 0, 0, 0, 26, 5, 14, 9, 20, 8, 0, 0, 0, 0, 25, 5, 12, 12, 15, 23, 0, 0, 0, 0, 20, 18, 9, 3, 25, 3, 12, 5, 0, 0, 25, 1, 13, 0, 0, 0, 0, 0, 0, 0,
