  12, 1, 16, 19, 5, 0, 0, 0, 0, 0, 14, 9, 20, 18, 15, 7, 5, 14, 0, 0, 7, 12, 1, 19, 19, 0, 0, 0, 0, 0, 9, 4, 9, 15, 20, 0, 0, 0, 0, 0, 13, 5, 13, 15, 18, 25, 0, 0, 0, 0,
  6, 12, 15, 23, 5, 18, 0, 0, 0, 0, 3, 15, 13, 16, 21, 20, 5, 18, 0, 0, 12, 1, 14, 4, 13, 1, 18, 11, 0, 0, 13, 5, 19, 19, 1, 7, 5, 0, 0, 0, 3, 12, 1, 18, 9, 20, 25, 0, 0, 0,
  1, 13, 1, 26, 9, 14, 7, 0, 0, 0, 8, 1, 18, 13, 15, 14, 25, 0, 0, 0, 7, 1, 12, 12, 15, 14, 0, 0, 0, 0, 10, 5, 12, 12, 25, 6, 9, 19, 8, 0, 6, 12, 1, 13, 5, 0, 0, 0, 0, 0,
  5, 14, 22, 9, 15, 21, 19, 0, 0, 0, 4, 15, 15, 18, 2, 5, 12, 12, 0, 0, 4, 5, 19, 20, 9, 14, 25, 0, 0, 0, 4, 1, 9, 19, 25, 0, 0, 0, 0, 0, 3, 15, 18, 19, 1, 7, 5, 0, 0, 0,
