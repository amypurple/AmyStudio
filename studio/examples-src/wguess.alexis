  3, 15, 21, 14, 20, 5, 18, 1, 3, 20, 3, 12, 15, 22, 5, 18, 12, 5, 1, 6, 5, 1, 18, 20, 8, 17, 21, 1, 11, 5, 6, 12, 5, 24, 9, 2, 12, 5, 0, 0, 17, 21, 5, 5, 14, 0, 0, 0, 0, 0,
  16, 18, 5, 3, 5, 4, 5, 14, 20, 0, 15, 18, 1, 14, 7, 5, 0, 0, 0, 0, 3, 15, 14, 19, 20, 18, 21, 3, 20, 0, 21, 14, 9, 3, 15, 18, 14, 0, 0, 0, 9, 13, 16, 15, 18, 20, 1, 14, 20, 0,
  13, 5, 4, 1, 12, 9, 19, 20, 0, 0, 25, 15, 21, 18, 19, 5, 12, 6, 0, 0, 14, 15, 22, 9, 3, 5, 0, 0, 0, 0, 7, 5, 15, 7, 18, 1, 16, 8, 25, 0, 5, 24, 16, 5, 14, 19, 9, 22, 5, 0,
  13, 15, 14, 9, 20, 15, 18, 0, 0, 0, 8, 5, 1, 4, 1, 3, 8, 5, 0, 0, 20, 5, 12, 5, 22, 9, 19, 9, 15, 14, 20, 1, 24, 0, 0, 0, 0, 0, 0, 0, 12, 1, 14, 7, 21, 1, 7, 5, 0, 0
