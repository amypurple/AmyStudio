asm {
; EgClr / EgPoll: clear the NMI flag; wait until an NMI has set it
EgClr:
    xor a
    ld (NMI_FLAG),a
    ret
EgPoll:
    ld a,(NMI_FLAG)
    or a
    jr z,EgPoll
    ret
EgChomp:
    db $00,$00,$05,$02,$00,$00,$26,$02,$00,$00,$15,$03,$00,$00,$56,$04,$10
EgPush:
    db $00,$00,$51,$01,$00,$00,$92,$01,$10
EgClamp:
    db $40,$7F,$10,$02,$40,$5F,$10,$02,$40,$47,$10,$02,$40,$40,$40,$06,$50
EgWin:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$08,$40,$8F,$20,$06,$40,$6B,$30,$18
    db $50
EgMiss:
    db $80,$1D,$21,$03,$80,$53,$31,$03,$80,$AB,$51,$06,$90
EgFree:
    db $80,$A9,$30,$02,$80,$71,$40,$02,$80,$55,$50,$02,$90
EgTick:
    db $C0,$39,$50,$01,$C0,$40,$80,$01,$D0
EgBump:
    db $C0,$FC,$51,$01,$C0,$3B,$82,$02,$D0

EgSoundTable:
    dw EgTuneMel,$702B
    dw EgTuneBass,$7035
    dw EgChomp,$703F
    dw EgPush,$703F
    dw EgClamp,$7049
    dw EgWin,$7049
    dw EgMiss,$7053
    dw EgFree,$7053
    dw EgTick,$705D
    dw EgBump,$705D
; High Wire Swamp (original)
; Tiny Sound, 6 frames per step
EgTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$40,$1A,$21,$1C,$01,$1F,$01,$23,$01,$28,$01,$26,$01,$23,$01
    db $21,$01,$1F,$01,$21,$01,$24,$01,$28,$01,$24,$01,$23,$01,$01,$01
    db $00,$01,$01,$01,$28,$01,$26,$01,$23,$01,$1F,$01,$21,$01,$23,$01
    db $24,$01,$21,$01,$23,$01,$1F,$01,$1E,$01,$1A,$01,$1C,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
EgTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$70,$18,$32,$04,$01,$0B,$01,$04,$01,$0B,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$09,$01,$10,$01,$09,$01,$10,$01,$0B,$01,$12,$01
    db $0B,$01,$06,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$0B,$01,$12,$01,$0B,$01,$0F,$01,$04,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
