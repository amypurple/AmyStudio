u8 Direction[4]
u8 X[4]
u8 Y[4]
u8 HomeX[4]
u8 HomeY[4]
u8 HiddenTile[4]
u8 Vulnerable[4]
u8 MoveTimer[4]
u8 Immune[4]
u8 State[4]
u8 EyeX[4]
u8 EyeY[4]
u8 EyeTimer[4]
u8 I = 0
u8 Sum = 0

for I = 0 to 3
  Direction[I] = I
  X[I] = 10 + I
  Y[I] = 20 + I
  HomeX[I] = X[I]
  HomeY[I] = Y[I]
  HiddenTile[I] = 32
  Vulnerable[I] = 0
  MoveTimer[I] = 1
  Immune[I] = 0
  State[I] = 1
  EyeX[I] = X[I] * 8
  EyeY[I] = Y[I] * 8
  EyeTimer[I] = 2
next

for I = 0 to 3
  X[I] += 1
  Y[I] += 1
  MoveTimer[I] -= 1
  Sum += X[I]
  Sum += Y[I]
  Sum += HiddenTile[I]
  Sum += State[I]
next

record_cost_done:
loop forever

