record Plr:
  u16 X
  u16 Y
  u8 Cd
  u8 An
  u8 Sc
  u8 Latch
  u8 St
end record
Plr Pl[2]

u16 BX = 0
u16 BY = 0
i16 VX = 0
i16 VY = 0
u8 Must = 0
u8 Srv = 1
u8 Phase = 0
u8 Timer = 0
u8 Level = 1
u8 Pts = 0
u8 Boost = 0
u8 Hits = 0
u8 Spd = 10
u8 PSpd = 16
u8 Over = 0
u8 Winner = 0
u8 NextLv = 0
u8 Players = 1
u8 InPlay = 0
u8 HbX[32]
u8 HbY[32]
u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
' what the HUD shows
u8 ShSc0 = 255
u8 ShSc1 = 255
u8 ShLv = 255
' input
u8 J0 = 0
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
' loop counters
u8 Pq = 0
u8 Dr = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table SnSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  StepFrame
  DrawAll
  if Over = 0 then goto play_loop

  InPlay = 0
  EndMessage
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------- rules
sub StepFrame:
  K = Tick & 31
  HbX[K] = BX >> 3
  HbY[K] = BY >> 3
  if Players = 1 then J1 = CpuStick()
  select case Phase
  case 0
    ServeWait
  case 1
    MovePlayer(0, J0)
    MovePlayer(1, J1)
    MoveBall
  case 2
    dec Timer
    if Timer = 0 then AfterPoint
  case 3
    dec Timer
    if Timer = 0 then
      RedrawRow
      NewPoint
    end if
  end select
  return
end sub

' the button, as a press (down now, up before)
function Pressed(u8 P, u8 Jv) as u8
  u8 R = 0
  K = Jv & 16
  if K > 0 then
    if Pl[P].Latch = 0 then R = 1
    Pl[P].Latch = 1
  else
    Pl[P].Latch = 0
  end if
  return R

sub ServeWait:
  u8 A = 0
  u8 B = 0
  A = Pressed(0, J0)
  B = Pressed(1, J1)
  dec Timer
  if Srv = 0 and A = 1 then Timer = 0
  if Srv = 1 and B = 1 then Timer = 0
  if Timer = 0 then
    Phase = 1
    VX = 0 - Spd
    VY = 0 - Spd
    play sound SndServe
  end if
  return
end sub

sub MovePlayer(u8 P, u8 Jv):
  u16 X = 0
  u16 Y = 0
  u8 Mv = 0
  K = Pressed(P, Jv)
  X = Pl[P].X
  Y = Pl[P].Y
  if Pl[P].Cd > 0 then Pl[P].Cd = Pl[P].Cd - 1
  V = Jv & 1
  if V > 0 then
    if Y >= PyMin + PSpd then
      Y = Y - PSpd
    else
      Y = PyMin
    end if
    Mv = 1
  end if
  V = Jv & 2
  if V > 0 then
    Y = Y + PSpd
    if Y > PyMax then Y = PyMax
    Mv = 1
  end if
  V = Jv & 4
  if V > 0 then
    if X >= PxMin + PSpd then
      X = X - PSpd
    else
      X = PxMin
    end if
    Mv = 1
  end if
  V = Jv & 8
  if V > 0 then
    X = X + PSpd
    if X > PxMax then X = PxMax
    Mv = 1
  end if
  Pl[P].X = X
  Pl[P].Y = Y
  if Mv = 1 then
    Pl[P].An = Pl[P].An + 1
    Pl[P].St = 0
  else
    if Pl[P].St < 255 then Pl[P].St = Pl[P].St + 1
  end if
  return
end sub

sub MoveBall:
  BX = BX + VX
  if BX < BxMin then
    BX = 384 - BX
    VX = 0 - VX
    play sound SndWall
  end if
  if BX > BxMax then
    BX = 3584 - BX
    VX = 0 - VX
    play sound SndWall
  end if
  BY = BY + VY
  if BY < ByMin then
    BY = 512 - BY
    VY = 0 - VY
    play sound SndWall
  end if
  if BY >= ByOut then
    BallOut
  else
    for Pq = 0 to 1
      CheckHit(Pq)
    next
  end if
  return
end sub

function AbsI(i16 D) as i16
  i16 R = 0
  R = D
  if R < 0 then R = 0 - R
  return R

sub CheckHit(u8 P):
  i16 Dx = 0
  i16 Dy = 0
  i16 Sp = 0
  i16 Half = 0
  u16 Pc = 0
  u16 Bc = 0
  if Pl[P].Cd > 0 then return
  Bc = BX >> 3
  Pc = Pl[P].X >> 3
  Dx = Bc + 2
  Dx = Dx - Pc
  Dx = Dx - 8
  Bc = BY >> 3
  Pc = Pl[P].Y >> 3
  Dy = Bc + 2
  Dy = Dy - Pc
  Dy = Dy - 8
  if AbsI(Dx) > HitR then return
  if AbsI(Dy) > HitR then return
  Pl[P].Cd = CoolT
  if Pl[P].St >= StillT then
    ' a racket held still for 2 s: the ball drops off it to the back
    Must = P + 1
    VY = Spd
    VX = 0
    play sound SndWall
    return
  end if
  Must = 2 - P
  inc Hits
  K = Hits % 2
  if K = 0 and Boost < 30 then
    inc Boost
    Spd = Spd + 1
  end if
  Sp = Spd
  Half = Sp >> 1
  VY = 0 - Sp
  if Dx <= -5 then
    VX = 0 - Sp - Half
  elseif Dx < 0 then
    VX = 0 - Half
  elseif Dx < 5 then
    VX = Half
  else
    VX = Sp + Half
  end if
  if P = 1 and Players = 1 then CpuAim
  play sound SndHit
  return
end sub

' the computer returns the ball steeply away from BLACK
sub CpuAim:
  u16 Wv = 0
  i16 Sp = 0
  Sp = Spd
  Wv = Spd >> 1
  Sp = Sp + Wv
  Wv = Pl[0].X >> 3
  if Wv < 120 then
    VX = Sp
  else
    VX = 0 - Sp
  end if
  return
end sub

sub BallOut:
  Phase = 2
  Timer = PauseT
  select case Must
  case 0
    Srv = 1
  case 1
    Score(1)
  case 2
    Score(0)
  end select
  return
end sub

' P wins the point: he serves the next ball and must reach it
sub Score(u8 P):
  Pl[P].Sc = Pl[P].Sc + 1
  inc Pts
  Srv = P
  Must = P + 1
  play sound SndPoint
  if Pl[P].Sc = WinPts then
    Over = 1
    Winner = P + 1
  end if
  K = Pts % 5
  if K = 0 and Level < 7 then
    inc Level
    NextLv = 1
  end if
  return
end sub

sub AfterPoint:
  if NextLv = 1 then
    NextLv = 0
    Phase = 3
    Timer = LevelT
    NumU = Level
    print at 10,9, " LEVEL "
    print at 17,9, digits$(NumU, 1)
    print at 18,9, " "
    play sound SndLevel
  else
    NewPoint
  end if
  return
end sub

sub RedrawRow:
  copy CourtMap + 288 count 32 to vram.name + 288
  return
end sub

sub NewPoint:
  u8 St = 0
  St = LvStep[Level]
  Spd = BallSpd[St]
  PSpd = PlaySpd[St]
  Boost = 0
  Hits = 0
  Pl[0].X = 568
  Pl[0].Y = 1200
  Pl[1].X = 1256
  Pl[1].Y = 1200
  for Pq = 0 to 1
    Pl[Pq].Cd = 0
  next
  ' a ball for BLACK starts on the right, any other on the left
  if Must = 1 then
    BX = 1264
  else
    BX = 720
  end if
  BY = 704
  VX = 0
  VY = 0
  Phase = 0
  Timer = ServeT
  return
end sub

' ------------------------------------------------------------ computer
' WHITE's stick: from the ball as seen CpuLag frames ago
function CpuStick() as u8
  u8 R = 0
  u8 Ix = 0
  u8 Ex = 0
  u8 Ey = 0
  u8 Tx = 0
  u8 Ty = 0
  u8 Px = 0
  u8 Py = 0
  u16 Wv = 0
  u8 Iy = 0
  u8 Lg = 0
  u8 Ma = 0
  u8 Mb = 0
  i16 W3 = 0
  i16 Gx = 0
  i16 Gy = 0
  if Phase = 0 then
    if Srv = 1 and Timer < CpuServe then R = 16
    return R
  end if
  if Phase <> 1 then return R
  Lg = CpuLag
  Ma = 4
  Mb = 3
  if Hits = 0 then
    Lg = 6
    Ma = 2
    Mb = 1
  end if
  Ix = Tick - Lg
  Ix = Ix & 31
  Ex = HbX[Ix]
  Ey = HbY[Ix]
  Iy = Ix - 5
  Iy = Iy & 31
  ' where the ball will be now: the seen motion carried on (clamped)
  Gx = Ex
  Gx = Gx * Ma
  W3 = HbX[Iy]
  W3 = W3 * Mb
  Gx = Gx - W3
  ' off a side wall, as it will bounce
  if Gx < 24 then Gx = 48 - Gx
  if Gx > 224 then Gx = 448 - Gx
  if Gx < 24 then Gx = 24
  if Gx > 224 then Gx = 224
  Ex = Gx
  Gy = Ey
  Gy = Gy * Ma
  W3 = HbY[Iy]
  W3 = W3 * Mb
  Gy = Gy - W3
  if Gy < 32 then Gy = 32
  if Gy > 172 then Gy = 172
  Ey = Gy
  if Must = 1 then
    ' BLACK's ball: keep out of its way
    Tx = 112
    if Ex >= 80 and Ex < 120 then Tx = Ex + 40
    if Ex >= 120 and Ex < 160 then Tx = Ex - 40
    Ty = 140
  else
    Tx = 24
    if Ex > 30 then Tx = Ex - 6
    Ty = 64
    if Ey > 68 then Ty = Ey - 4
    if Ty > 156 then Ty = 156
  end if
  Wv = Pl[1].X >> 3
  Px = Wv
  Wv = Pl[1].Y >> 3
  Py = Wv
  if Px + 3 < Tx then R = R | 8
  if Px > Tx + 3 then R = R | 4
  if Py + 3 < Ty then R = R | 2
  if Py > Ty + 3 then R = R | 1
  return R

' ------------------------------------------------------------- game
sub NewGame:
  NewScreen
  backdrop black
  copy CourtMap count 768 to vram.name
  print at 2,1, "BLACK"
  print at 22,1, "WHITE"
  print at 13,1, "LEVEL"
  for Pq = 0 to 1
    Pl[Pq].Sc = 0
    Pl[Pq].Latch = 1
    Pl[Pq].An = 0
    Pl[Pq].St = 0
  next
  Level = 1
  Pts = 0
  Over = 0
  Winner = 0
  NextLv = 0
  Must = 0
  Srv = 1
  ShSc0 = 255
  ShSc1 = 255
  ShLv = 255
  NewPoint
  DrawAll
  ShowScreen
  Rearm
  wait no fire
  nmi off
  InPlay = 1
  return
end sub

' ------------------------------------------------------------- drawing
sub DrawAll:
  u8 Bx8 = 0
  u8 By8 = 0
  u8 Cl = 0
  u16 Wv = 0
  DrawHud
  if Phase = 2 or Phase = 3 then
    set sprite 0 to NoSprite,0,SBall,0
  else
    Wv = BX >> 3
    Bx8 = Wv
    Wv = BY >> 3
    By8 = Wv - 1
    Cl = BallCol[Must]
    set sprite 0 to By8,Bx8,SBall,Cl
  end if
  for Dr = 0 to 1
    DrawPlayer(Dr)
  next
  update sprites
  return
end sub

sub DrawPlayer(u8 P):
  u8 Px = 0
  u8 Py = 0
  u8 Pt = 0
  u8 Cl = 1
  u16 Wv = 0
  Wv = Pl[P].X >> 3
  Px = Wv
  Wv = Pl[P].Y >> 3
  Py = Wv - 1
  Pt = SPl1
  K = Pl[P].An & 8
  if K > 0 then Pt = SPl2
  if P = 1 then Cl = 15
  set sprite P + 1 to Py,Px,Pt,Cl
  return
end sub

sub DrawHud:
  if Pl[0].Sc <> ShSc0 then
    ShSc0 = Pl[0].Sc
    NumU = ShSc0
    print at 8,1, digits$(NumU, 2)
  end if
  if Pl[1].Sc <> ShSc1 then
    ShSc1 = Pl[1].Sc
    NumU = ShSc1
    print at 28,1, digits$(NumU, 2)
  end if
  if Level <> ShLv then
    ShLv = Level
    NumU = Level
    print at 19,1, digits$(NumU, 1)
  end if
  return
end sub

sub EndMessage:
  DrawAll
  if Winner = 1 then
    print at 9,9, " BLACK WINS! "
  else
    print at 9,9, " WHITE WINS! "
  end if
  return
end sub

' --------------------------------------------------------- frame, input
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

function PadBits(u8 N) as u8
  u8 B = 0
  if joypad(N).up then B = B | 1
  if joypad(N).down then B = B | 2
  if joypad(N).left then B = B | 4
  if joypad(N).right then B = B | 8
  if joypad(N).fire then B = B | 16
  return B

sub ReadPad:
  J0 = PadBits(1)
  J1 = 0
  if Players = 2 then J1 = PadBits(2)
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 2
    set sprite J to NoSprite,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ------------------------------------------------------- title, credits
sub TitlePage:
  NewScreen
  backdrop dark blue
  copy TitleMap count 64 to vram.name + 96
  print at 7,7, "COMPUTE!'S GAZETTE"
  print at 10,8, "OCTOBER 1987"
  Menu = 0
  ShowMenu
  set sprite 1 to 143,40,SPl1,1
  set sprite 2 to 143,200,SPl2,15
  set sprite 0 to 103,124,SBall,11
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  J0 = PadBits(1)
  J1 = PadBits(2)
  K = J0 | J1
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = K & 15
  if V > 0 then
    if WasStick = 0 then MenuMove(V)
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub MenuMove(u8 S):
  select case S
  case 1
    if Menu > 0 then dec Menu
  case 2
    if Menu < 3 then inc Menu
  case 4, 8
    if Menu = 0 then Players = 3 - Players
  end select
  ShowMenu
  return
end sub

sub ShowMenu:
  for J = 12 to 18 step 2
    put char 32 at 9,J
  next
  if Players = 1 then
    print at 11,12, "1 PLAYER "
  else
    print at 11,12, "2 PLAYERS"
  end if
  print at 11,14, "START"
  print at 11,16, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  J = Menu * 2 + 12
  put char 62 at 9,J
  print at 4,20, "FIRST TO 21 POINTS WINS"
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  backdrop dark blue
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "BLACK AND WHITE SHARE A"
    print at 2,4, "SQUASH COURT. TOUCH THE"
    print at 2,5, "BALL TO SEND IT BACK UP TO"
    print at 2,6, "THE FRONT WALL."
    print at 2,8, "THE BALL'S COLOUR SHOWS WHO"
    print at 2,9, "MUST HIT IT NEXT. IF IT"
    print at 2,10, "GETS PAST THE BACK LINE,"
    print at 2,11, "THAT PLAYER LOSES A POINT."
    fill TBrick count 20 at 6,13
    fill TTin count 20 at 6,14
    for J = 15 to 19
      fill TFloor count 20 at 6,J
    next
    fill TLineH count 20 at 6,20
    set sprite 0 to 127,112,SBall,15
    set sprite 1 to 143,72,SPl1,1
    set sprite 2 to 135,152,SPl2,15
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "JOYSTICK: RUN ANYWHERE ON"
    print at 2,4, "THE COURT. YOU HIT THE BALL"
    print at 2,5, "JUST BY TOUCHING IT."
    print at 2,7, "BUTTON: SERVE. THE WINNER"
    print at 2,8, "OF A POINT SERVES AND MUST"
    print at 2,9, "RUN TO THE BALL."
    print at 2,11, "ONE PLAYER: YOU ARE BLACK."
    print at 2,12, "TWO PLAYERS: CONTROLLER 2"
    print at 2,13, "IS WHITE."
    for J = 15 to 19
      fill TFloor count 20 at 6,J
    next
    set sprite 0 to 135,100,SBall,1
    set sprite 1 to 143,112,SPl2,1
  case 3
    print at 2,1, "WINNING                 3/3"
    print at 2,3, "FIRST TO 21 POINTS WINS."
    print at 2,5, "EVERY 5 POINTS THE LEVEL"
    print at 2,6, "GOES UP AND THE BALL GETS"
    print at 2,7, "FASTER. A LONG RALLY SPEEDS"
    print at 2,8, "IT UP TOO."
    print at 2,10, "TIP: AFTER YOUR HIT, MOVE"
    print at 2,11, "AWAY. THE OTHER PLAYER MUST"
    print at 2,12, "REACH THE BALL NEXT!"
    fill TBrick count 20 at 6,15
    fill TTin count 20 at 6,16
    for J = 17 to 19
      fill TFloor count 20 at 6,J
    next
    set sprite 0 to 135,180,SBall,11
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  K = PadBits(1) | PadBits(2)
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "SCHNIP"
  print at 2,4, "BASED ON SCHNIP, COMPUTE!'S"
  print at 2,5, "GAZETTE DISK, OCTOBER 1987"
  print at 2,6, "(COMMODORE 64 MACHINE"
  print at 2,7, "LANGUAGE; NO AUTHOR NAMED"
  print at 2,8, "ON THE DISK)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026. MUSIC: OFF THE FRONT"
  print at 2,15, "WALL (ORIGINAL)."
  print at 2,17, "TOUCH THE BALL TO SEND IT"
  print at 2,18, "UP. ITS COLOUR SHOWS WHO"
  print at 2,19, "MUST PLAY IT; IF IT GETS"
  print at 2,20, "PAST, THAT PLAYER LOSES."
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
SnHit:
    db $40,$40,$00,$01,$40,$55,$10,$02,$40,$66,$40,$02,$50
SnWall:
    db $00,$00,$26,$01,$00,$00,$66,$02,$10
SnServe:
    db $40,$7F,$10,$02,$40,$5F,$20,$03,$50
SnPoint:
    db $40,$AA,$10,$06,$40,$D6,$20,$06,$40,$1D,$31,$0E,$50
SnLevel:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$20,$10,$50
SnOver:
    db $40,$8F,$10,$0A,$40,$AA,$10,$0A,$40,$8F,$10,$0A,$40,$6B,$10,$0A,$40,$55,$20,$1E,$50

SnSoundTable:
    dw SnTuneMel,$702B
    dw SnTuneBass,$7035
    dw SnHit,$7049
    dw SnWall,$703F
    dw SnServe,$7049
    dw SnPoint,$7049
    dw SnLevel,$7049
    dw SnOver,$7049
; Off the Front Wall (original)
; Tiny Sound, 8 frames per step
SnTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$25,$28,$01,$25,$23,$01,$21,$01,$1E,$01
    db $1C,$01,$01,$01,$1E,$01,$21,$26,$01,$25,$23,$01,$25,$01,$28,$01
    db $23,$01,$01,$01,$21,$01,$25,$28,$01,$2A,$28,$01,$26,$01,$23,$01
    db $20,$01,$23,$01,$21,$01,$1C,$01,$19,$01,$1A,$1C,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
SnTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$15,$01
    db $09,$01,$10,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$10,$01,$17,$01
    db $10,$01,$14,$01,$09,$01,$10,$01,$12,$01,$19,$01,$0E,$01,$15,$01
    db $10,$01,$17,$01,$15,$01,$10,$01,$12,$01,$10,$01,$09,$01,$10,$01
    db $09,$01,$00,$01
    db $FF
}
