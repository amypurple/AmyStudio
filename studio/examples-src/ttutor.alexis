  tile screen
  set sound table TtSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  Prev.Top = 0
  Prev.Bot = 0
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPlay
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  AskSettings
  PlayGame
  EndShow
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random number from 0 to M - 1
function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

' T = 1 .. F, B = 0 .. F - T; never the problem just answered right
sub NewProblem:
  u8 Room = 0
  u8 Same = 1
  while Same = 1
    Now.Top = RandBelow(MaxSum) + 1
    Room = MaxSum + 1 - Now.Top
    Now.Bot = RandBelow(Room)
    Same = 0
    if Now.Top = Prev.Top then
      if Now.Bot = Prev.Bot then Same = 1
    end if
  end while
  return
end sub

sub PlayGame:
  InBasket = 0
  Tries = 0
  DrawPlay
  while InBasket < 10
    NewProblem
    Seen = 0
    if Fruit = 1 then Seen = 1
    OneProblem
  end while
  return
end sub

' ask until the answer is right
sub OneProblem:
  u8 Right = 0
  u8 Sum = 0
  Sum = Now.Top + Now.Bot
  DrawProblem
  while Right = 0
    if Tries < 999 then inc Tries
    ShowStatus
    Ask = 1
    AskDigit(1, 9)
    Ans = Got
    Ask = 0
    play sound SndKey
    BigDigit(TopC, AnsR, Ans)
    Pause(30)
    if Ans = Sum then
      Right = 1
    else
      WrongAnswer
    end if
  end while
  RightAnswer
  return
end sub

sub WrongAnswer:
  print at 18,MsgR, "TRY AGAIN"
  play sound SndBuzz
  if Seen = 0 then
    Seen = 1
    DrawApples
  end if
  Pause(50)
  fill 32 count 12 at 18,MsgR
  BigQuestion
  return
end sub

sub RightAnswer:
  u8 Slot = 0
  play sound SndHooray
  Prev = Now
  inc InBasket
  print at 18,MsgR, "HOORAY!"
  NumU = InBasket
  print at 27,MsgR, digits$(NumU, 2)
  if Seen = 0 then
    Seen = 1
    DrawApples
  end if
  Slot = Now.Top - 1
  BirdTakes(Slot)
  fill 32 count 12 at 18,MsgR
  ShowStatus
  return
end sub

' ---------------------------------------------------------------------------
' the bird

sub BirdTakes(u8 Sl):
  u8 Tc = 0
  u8 Tr = 0
  u8 Tx = 0
  u8 Ty = 0
  Tc = TreeC[Sl]
  Tr = TreeR[Sl]
  HidePointer
  Bx = 224
  By = 8
  Carry = 0
  play sound SndTweet
  Tx = Tc * 8 - 3
  Ty = Tr * 8 - 12
  FlyTo(Tx, Ty)
  ' pluck
  put char TLeaf at Tc,Tr
  play sound SndPluck
  Carry = 1
  DrawBird
  Pause(12)
  ' over the basket, then let go
  Tc = BaskC[InBasket - 1]
  Tr = BaskR[InBasket - 1]
  Tx = Tc * 8 - 3
  Ty = Tr * 8 - 40
  FlyTo(Tx, Ty)
  Carry = 0
  DrawBird
  Ax = Tx
  Ay = Ty + 8
  play sound SndFall
  Ty = Tr * 8 - 4
  while Ay < Ty
    Ay += 2
    if Ay > Ty then Ay = Ty
    DrawApple
    Frame1
  end while
  HideApple
  if Tr = 17 then
    put char TApgrass at Tc,Tr
  else
    put char TApsky at Tc,Tr
  end if
  play sound SndPlop
  Pause(10)
  FlyTo(16, 8)
  HideBird
  return
end sub

' fly to (Fx, Fy), 2 pixels a frame on each axis
sub FlyTo(u8 Fx, u8 Fy):
  while Bx <> Fx or By <> Fy
    if Bx < Fx then
      Face = 0
      Bx += 2
      if Bx > Fx then Bx = Fx
    end if
    if Bx > Fx then
      Face = 1
      Bx -= 2
      if Bx < Fx then Bx = Fx
    end if
    if By < Fy then
      By += 2
      if By > Fy then By = Fy
    end if
    if By > Fy then
      By -= 2
      if By < Fy then By = Fy
    end if
    DrawBird
    Frame1
  end while
  return
end sub

sub DrawBird:
  u8 Sy = 0
  u8 Pb = 0
  u8 Pk = 0
  Sy = By - 1
  ' a wing beat every 10 frames (3 Hz)
  V = Tick % 20
  Wing = 0
  if V >= 10 then Wing = 1
  if Face = 0 then
    Pb = SBup
    if Wing = 1 then Pb = SBdn
    Pk = SBeak
  else
    Pb = SBupl
    if Wing = 1 then Pb = SBdnl
    Pk = SBeakl
  end if
  set sprite 0 to Sy,Bx,Pk,11
  set sprite 1 to Sy,Bx,Pb,4
  if Carry = 1 then
    Ax = Bx
    Ay = By + 8
    DrawApple
  else
    update sprites
  end if
  return
end sub

sub DrawApple:
  u8 Sy = 0
  Sy = Ay - 1
  set sprite 2 to Sy,Ax,SStem,6
  set sprite 3 to Sy,Ax,SApple,8
  update sprites
  return
end sub

sub HideApple:
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  update sprites
  return
end sub

sub HideBird:
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  HideApple
  return
end sub

' ---------------------------------------------------------------------------
' the end: the message on a board, the bird lands on it

sub EndShow:
  u8 Lc = 0
  Ask = 0
  for Li = 2 to 15
    fill 32 count 12 at 18,Li
  next
  fill TGrass count 28 at 2,KeyR
  fill TGrass count 28 at 2,KeyR + 1
  fill TPlankt count 12 at 18,4
  print at 19,5, "YOU GOT 10"
  print at 19,6, "APPLES IN"
  print at 19,7, str$(Tries) + " TRIES."
  fill TPlankb count 12 at 18,8
  play sound SndDone
  Bx = 224
  By = 8
  Carry = 0
  Lc = 21 * 8
  FlyTo(Lc, 18)
  set sprite 0 to 17,Bx,SBeaks,11
  set sprite 1 to 17,Bx,SBsit,4
  update sprites
  play sound SndTweet
  print at 18,12, "PRESS BUTTON"
  return
end sub

' ---------------------------------------------------------------------------
' input: a digit from KeyLo to KeyHi, by keypad or by stick and button

sub AskDigit(u8 Lo, u8 Hi):
  u8 Done = 0
  KeyLo = Lo
  KeyHi = Hi
  DrawKeys
  if Cur < Lo then Cur = Lo
  if Cur > Hi then Cur = Hi
  Bob = 0
  DrawPointer
  Rearm
  wait no fire
  nmi off
  ' start from the keys held now: only a new press counts
  ReadPad
  WasBtn = 16
  while Done = 0
    Frame1
    inc Rs
    ReadPad
    V = Tick & 15
    if V = 0 then
      Bob = Bob ^ 2
      DrawPointer
    end if
    MoveByStick
    if KeyHit > 0 then
      Got = KeyHit
      Cur = KeyHit
      Done = 1
    else
      if Press = 1 then
        Got = Cur
        Done = 1
      end if
    end if
  end while
  DrawPointer
  return
end sub

sub MoveByStick:
  u8 Mk = 0
  if Edge > 0 then
    Mk = Edge
    RepT = 15
  else
    if Jk > 0 then
      dec RepT
      if RepT = 0 then
        Mk = Jk
        RepT = 6
      end if
    end if
  end if
  select case Mk
  case 4
    if Cur > KeyLo then
      dec Cur
      play sound SndClick
      DrawPointer
    end if
  case 8
    if Cur < KeyHi then
      inc Cur
      play sound SndClick
      DrawPointer
    end if
  end select
  return
end sub

function KeyCol(u8 D) as u8
  return D * 3

sub DrawPointer:
  u8 Px = 0
  u8 Py = 0
  Px = KeyCol(Cur) * 8 - 4
  Py = 141 + Bob
  set sprite SprPtr to Py,Px,SPoint,11
  update sprites
  return
end sub

sub HidePointer:
  set sprite SprPtr to 192,0,0,0
  update sprites
  return
end sub

' keys KeyLo .. KeyHi on rows 20-21, grass under the others
sub DrawKeys:
  u8 D = 0
  u8 Kc = 0
  u8 Kr = 0
  Kr = KeyR + 1
  fill TGrass count 28 at 2,KeyR
  fill TGrass count 28 at 2,Kr
  for D = KeyLo to KeyHi
    Kc = KeyCol(D)
    put char TCapl at Kc - 1,KeyR
    put char 48 + D at Kc,KeyR
    put char TCapr at Kc + 1,KeyR
    put char TCapbl at Kc - 1,Kr
    put char TCapb at Kc,Kr
    put char TCapbr at Kc + 1,Kr
  next
  return
end sub

sub ReadPad:
  u8 J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Jk = J1 & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  ' keypad: a new press of a digit in range; every other key is ignored
  Kp = keypad(1)
  if Kp = 255 then Kp = keypad(2)
  KeyHit = 0
  if WasKp = 255 then
    if Kp >= KeyLo then
      if Kp <= KeyHi then KeyHit = Kp
    end if
  end if
  WasKp = Kp
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub BigDigit(u8 Dc, u8 Dr, u8 Dv):
  u8 Tt = 0
  Tt = Dv << 1
  Tt = Tt + TD000
  put char Tt at Dc,Dr
  put char Tt + 1 at Dc,Dr + 1
  return
end sub

sub BigQuestion:
  put char TDq00 at TopC,AnsR
  put char TDq10 at TopC,AnsR + 1
  return
end sub

sub DrawProblem:
  u8 Pr = 0
  ' leaves and grass back where apples were
  for Pr = 0 to 8
    put char TLeaf at TreeC[Pr],TreeR[Pr]
  next
  for Pr = 0 to 7
    put char TGrass at GrndC[Pr],GrndR[Pr]
  next
  BigDigit(TopC, TopR, Now.Top)
  put char TDplus00 at PlusC,BotR
  put char TDplus10 at PlusC,BotR + 1
  BigDigit(TopC, BotR, Now.Bot)
  fill TBar count 6 at 21,BarR
  BigQuestion
  if Seen = 1 then DrawApples
  return
end sub

' Top apples in the tree, Bot apples on the ground
sub DrawApples:
  u8 Ai = 0
  u8 An = 0
  An = Now.Top
  for Ai = 1 to An
    put char TApleaf at TreeC[Ai - 1],TreeR[Ai - 1]
  next
  An = Now.Bot
  Ai = 0
  while Ai < An
    put char TApgrass at GrndC[Ai],GrndR[Ai]
    inc Ai
  end while
  return
end sub

sub ShowStatus:
  print at 2,1, "TRIES"
  NumU = Tries
  print at 8,1, digits$(NumU, 3)
  print at 19,1, "APPLES"
  NumU = InBasket
  print at 26,1, digits$(NumU, 2)
  return
end sub

sub DrawPlay:
  u8 Sr = 0
  u16 Off = 0
  NewScreen
  for Sr = 17 to 23
    fill TGrass count 32 at 0,Sr
  next
  for Sr = 2 to 21
    put SceneMap + Off count 28 at 2,Sr
    Off += 28
  next
  ShowStatus
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Pn):
  u8 Pi = 0
  for Pi = 1 to Pn
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $15
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop light blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub PutBig(u8 Tb, u8 Bc, u8 Br):
  put char Tb at Bc,Br
  put char Tb + 1 at Bc + 1,Br
  put char Tb + 2 at Bc,Br + 1
  put char Tb + 3 at Bc + 1,Br + 1
  return
end sub

' the title: the name, the two questions (as the original asked them)
sub TitlePage:
  u8 Tn = 0
  u8 Tg = 0
  u8 Tc = 0
  Ask = 0
  TitleOn = 1
  NewScreen
  for Tn = 0 to 9
    Tg = TitleA[Tn]
    Tc = Tn << 1
    Tc = Tc + 6
    if Tg > 0 then PutBig(Tg, Tc, 2)
  next
  for Tn = 0 to 7
    Tg = TitleB[Tn]
    Tc = Tn << 1
    Tc = Tc + 8
    if Tg > 0 then PutBig(Tg, Tc, 5)
  next
  print at 9,8, "BY JANET ARNOLD"
  print at 4,10, "COMPUTE!'S GAZETTE 1984"
  for Tn = 17 to 23
    fill TGrass count 32 at 0,Tn
  next
  put char TApgrass at 4,18
  put char TApgrass at 13,19
  put char TApgrass at 24,18
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  print at 10,12, "START"
  print at 10,13, "HOW TO PLAY"
  print at 10,14, "CREDITS"
  print at 3,16, "STICK UP/DOWN AND BUTTON"
  Menu = 0
  ShowMenu
  Ask = 4
  Rearm
  wait no fire
  nmi off
  ReadPad
  Press = 0
  while Press = 0
    Frame1
    inc Rs
    ReadPad
    K = Edge & 3
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
      play sound SndClick
      ShowMenu
    end if
    if K = 2 then
      inc Menu
      if Menu > 2 then Menu = 0
      play sound SndClick
      ShowMenu
    end if
  end while
  Ask = 0
  if Menu > 0 then
    stop sound SndTuneA
    stop sound SndTuneB
    TzOn = 0
    mute all
    TitleOn = 0
  end if
  return
end sub

sub ShowMenu:
  put char 32 at 8,12
  put char 32 at 8,13
  put char 32 at 8,14
  C = Menu + 12
  put char 62 at 8,C
  return
end sub

' the two questions, on the title screen (as the original asked them)
sub AskSettings:
  for Li = 12 to 16
    fill 32 count 28 at 2,Li
  next
  print at 4,13, "CHOOSE HIGHEST SUM (2-9)"
  Ask = 2
  AskDigit(2, 9)
  MaxSum = Got
  play sound SndKey
  NumU = MaxSum
  print at 4,13, "HIGHEST SUM: " + digits$(NumU, 1) + "          "
  print at 2,15, "WHEN DO YOU WANT TO SEE"
  print at 2,16, "FRUIT?  (1) ALWAYS"
  print at 10,17, "(2) IF WRONG"
  Ask = 3
  AskDigit(1, 2)
  Fruit = Got
  play sound SndKey
  Ask = 0
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Pause(20)
  mute all
  TitleOn = 0
  HideSprites
  return
end sub

' HOW TO PLAY: two pages, the button turns the page; 30 s idle returns
sub HowToPlay:
  u8 Hr = 0
  Gone = 0
  NewScreen
  print at 6,1, "HOW TO PLAY  (1 OF 2)"
  ' a little tree: 3 apples up, 2 on the ground
  for Hr = 3 to 6
    fill TLeaf count 6 at 3,Hr
  next
  put char TApleaf at 4,3
  put char TApleaf at 7,4
  put char TApleaf at 5,6
  for Hr = 7 to 8
    fill TGrass count 8 at 2,Hr
  next
  put char TApgrass at 3,7
  put char TApgrass at 8,8
  BigDigit(16, 3, 3)
  put char TDplus00 at 13,6
  put char TDplus10 at 13,7
  BigDigit(16, 6, 2)
  fill TBar count 5 at 12,8
  BigDigit(16, 9, 5)
  print at 2,12, "COUNT THE APPLES IN THE"
  print at 2,13, "TREE. ADD THE APPLES ON"
  print at 2,14, "THE GROUND. PRESS THAT"
  print at 2,15, "NUMBER ON THE KEYPAD,"
  print at 2,16, "OR MOVE THE ARROW WITH THE"
  print at 2,17, "STICK AND PRESS THE BUTTON."
  KeyLo = 1
  KeyHi = 9
  DrawKeys
  Cur = 5
  Bob = 0
  print at 9,22, "BUTTON: MORE"
  ShowScreen
  DrawPointer
  PageWait
  if Gone = 0 then
    NewScreen
    print at 6,1, "HOW TO PLAY  (2 OF 2)"
    for Hr = 7 to 9
      fill TGrass count 28 at 2,Hr
    next
    put SceneMap + 469 count 5 at 15,8
    put SceneMap + 497 count 5 at 15,9
    for Hr = 15 to 19
      put char TApgrass at Hr,7
      put char TApsky at Hr,6
    next
    print at 2,10, "RIGHT ANSWER? A BIRD PUTS"
    print at 2,11, "AN APPLE IN THE BASKET."
    print at 2,12, "WRONG? TRY AGAIN, THERE IS"
    print at 2,13, "NO PENALTY."
    print at 2,14, "TEN APPLES AND YOU'RE DONE!"
    print at 2,16, "TIP FOR PARENTS: START WITH"
    print at 2,17, "HIGHEST SUM 2 AND FRUIT"
    print at 2,18, "OPTION 1 (ALWAYS)."
    print at 7,22, "BUTTON: BACK"
    ShowScreen
    Bx = 64
    By = 24
    Face = 0
    Carry = 1
    DrawBird
    PageWait
  end if
  HideSprites
  return
end sub

' a button press, or 30 seconds idle (then back to the title); wings beat
sub PageWait:
  u8 Pd = 0
  Rearm
  wait no fire
  nmi off
  ReadPad
  Press = 0
  IdleT = 0
  while Pd = 0
    Frame1
    ReadPad
    inc IdleT
    if Carry = 1 then DrawBird
    if Press = 1 then Pd = 1
    if IdleT >= 1800 then
      Pd = 1
      Gone = 1
    end if
  end while
  Carry = 0
  return
end sub

sub CreditsPage:
  NewScreen
  print at 6,2, "TREE TUTOR FOR TOTS"
  print at 2,5, "AN ADDITION TUTOR FOR SMALL"
  print at 2,6, "CHILDREN, BASED ON TREE"
  print at 2,7, "TUTOR FOR TOTS BY JANET"
  print at 2,8, "ARNOLD, COMPUTE!'S GAZETTE,"
  print at 2,9, "MARCH 1984 (VIC-20 AND"
  print at 2,10, "COMMODORE 64)."
  print at 2,12, "COLECOVISION VERSION, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: APPLE PICKING"
  print at 2,19, "(ORIGINAL)"
  print at 8,21, "PRESS BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

