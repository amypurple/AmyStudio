u8 WhiteCpuLastFrom = 255
u8 WhiteCpuLastTo = 255
u8 BlackCpuLastFrom = 255
u8 BlackCpuLastTo = 255
u8 GameReady = 0
u8 BoardDrawRow = 0
u8 BoardDrawColumn = 0
u8 BoardDrawPiece = 0
u8 BoardDrawKind = 0
u8 BoardDrawTile = 0
u8 CursorSquare = 48
u8 SelectedSquare = 255
u8 CursorColor = 7
u8 WhiteControl = 0
u8 BlackControl = 1
u8 GameCpuMoves = 0
u8 GameEndReason = 0
u8 GameWinner = 255
u8 GameMoveFrom = 0
