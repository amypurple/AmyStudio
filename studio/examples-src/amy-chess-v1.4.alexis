' ---- v1.4 search kernel state (see kernel asm) ----
u16 KNodes = 0
u16 KHard = 300
u16 KSoft = 150
u8 KAbort = 0
u8 KRootF = 255
u8 KRootT = 255
u8 KRootLegal = 0
