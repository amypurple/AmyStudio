' ============================================================================
' Amy Chess v1.4 - official single-file source
' Built from Amy Chess v1.3 (G49 engine) by replacing the search with a
' hand-written Z80 alpha-beta kernel (asm block at the end of this file).
' Validated with the current Amy Studio compiler at every published play level.
' Assets (zx0 pictures, cursor sprite, voxpcm voices) are unchanged from v1.3
' and must sit in assets/ next to this file (--project-dir).
' Build: node tools/amyc.mjs amy-chess-v1.4.alexis --project-dir . --opt aggressive --output amy-chess-v1.4.rom
' UCI test kernel: add --define CHESS_UCI_HARNESS
' ============================================================================
project "Amy Chess v1.4"
memory "colecovision_legacy_sdcc"

const Empty = 0
const WhitePawn = 1
const WhiteKnight = 2
const WhiteBishop = 3
const WhiteRook = 4
const WhiteQueen = 5
const WhiteKing = 6
const BlackPawn = 9
const BlackKnight = 10
const BlackBishop = 11
const BlackRook = 12
const BlackQueen = 13
const BlackKing = 14
const FlagEnPassant = 1
const FlagCastleKing = 2
const FlagCastleQueen = 4
const FlagDoublePawn = 8
const DefaultMinimaxNodeBudget = 2048
const MateTwoNodeBudget = 512
const QuietThreatNodeBudget = 256
const ChessHistoryNameOffset = $0400
const ChessHistoryRam = $7400

picture ChessTitlePicture:
  pattern from "@project/assets/amy-chess-title.pattern.zx0" codec zx0
  color from "@project/assets/amy-chess-title.color.zx0" codec zx0
end picture
asset ChessBoardPatterns from "@project/assets/amy-chess-board.pattern.zx0" codec zx0
asset ChessBoardColors from "@project/assets/amy-chess-board.color.zx0" codec zx0
asset ChessCursorPattern from "@project/assets/amy-chess-cursor.sprpat" codec raw
asset ChessVoiceMeowPart1 from "@project/assets/amy-chess-voice-meow-1.voxpcm"
asset ChessVoiceMeowPart2 from "@project/assets/amy-chess-voice-meow-2.voxpcm"
asset ChessVoiceMeowPart3 from "@project/assets/amy-chess-voice-meow-3.voxpcm"
asset ChessVoiceDrawPart1 from "@project/assets/amy-chess-voice-draw-1.voxpcm"
asset ChessVoiceDrawPart2 from "@project/assets/amy-chess-voice-draw-2.voxpcm"
asset ChessVoiceWhitePart1 from "@project/assets/amy-chess-voice-white-1.voxpcm"
asset ChessVoiceWhitePart2 from "@project/assets/amy-chess-voice-white-2.voxpcm"
asset ChessVoiceWhitePart3 from "@project/assets/amy-chess-voice-white-3.voxpcm"
asset ChessVoiceBlackPart1 from "@project/assets/amy-chess-voice-black-1.voxpcm"
asset ChessVoiceBlackPart2 from "@project/assets/amy-chess-voice-black-2.voxpcm"
asset ChessVoiceBlackPart3 from "@project/assets/amy-chess-voice-black-3.voxpcm"
asset ChessVoiceBlackPart4 from "@project/assets/amy-chess-voice-black-4.voxpcm"
asset ChessVoiceWinsPart1 from "@project/assets/amy-chess-voice-wins-1.voxpcm"
asset ChessVoiceWinsPart2 from "@project/assets/amy-chess-voice-wins-2.voxpcm"
asset ChessVoiceWinsPart3 from "@project/assets/amy-chess-voice-wins-3.voxpcm"
asset ChessVoiceWinsPart4 from "@project/assets/amy-chess-voice-wins-4.voxpcm"

record ChessSearchFrame:
  u8 MoveFrom
  u8 MoveTo
  u8 MovePromotion
  u8 MoveFlags
  u8 UndoPiece
  u8 UndoCaptured
  u8 UndoCapturedSquare
  u8 UndoCastling
  u8 UndoEnPassant
  u8 UndoHalfmove
