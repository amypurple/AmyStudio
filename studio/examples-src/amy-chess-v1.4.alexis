u8 RequestedMoveFrom = 255
u8 RequestedMoveTo = 255
u8 RequestedMovePromotion = 0
u8 RequestedMoveLegal = 0
u8 RequestedMoveFlags = 0
u8 CanClaimFiftyMove = 0
u8 AutomaticSeventyFiveMove = 0
u8 SavedMoveFrom = 0
u8 SavedMoveTo = 0
u8 SavedMovePromotion = 0
u8 SavedMoveFlags = 0
u8 SavedUndoPiece = 0
u8 SavedUndoCaptured = 0
u8 SavedUndoCapturedSquare = 0
u8 SavedUndoCastling = 0
u8 SavedUndoEnPassant = 0
u8 SavedUndoHalfmove = 0
u8 SavedUndoFullmove = 0
u8 StopAfterFirstLegal = 0
u8 EndgamePieceCount = 0
u8 MoveVariation = 0
u8 ChessGameSequence = 0
u8 ChessRandomState = 165
u8 ChessLevel = 1
u8 MinimaxExcludeEnabled = 0
u8 MinimaxExcludeFrom = 255
u8 MinimaxExcludeTo = 255
u8 MinimaxExcludeFlags = 0
