u8 AttackSide = 0
u8 AttackResult = 0
u8 ScanRow = 0
u8 ScanColumn = 0
u8 KingSquare = 255
u8 LegalMoveCount = 0
u8 GenerateFrom = 0
u8 GenerateRow = 0
u8 GenerateColumn = 0
u8 RayDone = 0
u8 WhiteKingSquare = 255
u8 BlackKingSquare = 255
u8 FindMateMode = 0
u8 MaterialMinorCount = 0
