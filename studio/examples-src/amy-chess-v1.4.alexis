  u8 GenerateRow
  u8 GenerateColumn
  u8 ScanRow
  u8 ScanColumn
  u8 RayDone
  u8 WhiteKingSquare
  u8 BlackKingSquare
  u8 LegalMoveCount
end record

u8 Board[64]
u8 Side = 0
u8 Castling = 15
u8 EnPassant = 255
u8 Halfmove = 0
u8 Fullmove = 1
u8 MoveFrom = 0
u8 MoveTo = 0
u8 MovePromotion = 0
u8 MoveFlags = 0
u8 UndoPiece = 0
u8 UndoCaptured = 0
u8 UndoCapturedSquare = 0
u8 UndoCastling = 0
u8 UndoEnPassant = 0
