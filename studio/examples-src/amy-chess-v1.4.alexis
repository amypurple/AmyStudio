#ifdef CHESS_UCI_HARNESS
u8 UciCommand = 0
u8 UciResetHistory = 0
u8 UciLevel = 1
u8 UciBestFrom = 255
u8 UciBestTo = 255
u8 UciBestFlags = 0
u8 UciBestPromotion = 0
u8 UciDepth = 0
u8 UciBudgetReached = 0
u16 UciNodes = 0
i16 UciScore = 0
u8 UciMaxDepth = 0
u8 UciRootLegal = 0
#endif
