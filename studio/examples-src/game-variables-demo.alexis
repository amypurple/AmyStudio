const EmptyTile = $20
const PlayerTile = $41
const StartX = 12
const StartY = 10

' Player state
u8 PlayerX = StartX
u8 PlayerY = StartY
u8 PreviousPlayerX = StartX

' UI / score
u8 FrameCounter = 0
u16 Score = 0

' Top-level setup, then jump into the motion loop.
  screen off
  setup_screen
  screen on
  goto game_loop

sub setup_screen:
  text screen
  print at 6,4, "GAME VARIABLES DEMO"
  print at 8,6, "A = PLAYER TILE"
  fill row 18 from 0 count 32 with $2D
  put char PlayerTile at PlayerX,PlayerY
  return

sub game_loop:
  PreviousPlayerX = PlayerX
  FrameCounter += 1
  PlayerX += 1
  Score += 1
  put char EmptyTile at PreviousPlayerX,PlayerY
  put char PlayerTile at PlayerX,PlayerY
  goto game_loop
end sub