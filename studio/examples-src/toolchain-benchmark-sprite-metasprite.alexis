u8 PlayerX = 120
u8 PlayerY = 88
u8 AnimationTick = 0
u8 AnimationFrame = 0

data PlayerMeta metasprite layers 3
  frame 0,15, 4,11, 8,1
  frame 12,15, 16,11, 20,1
end data

data DetailFrame0 sprite16
  "................"
  "................"
  "................"
  "....XX....XX...."
  "...XXX...XXX...."
  "...XX....XX....."
  "....XX....XX...."
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
end data

data BodyFrame0 sprite16
  "................"
  "......XXXX......"
  "....XXXXXXXX...."
  "...X..XXXX..X..."
  "..X...XXX...XX.."
  "..X...XXX...XX.."
  ".XXX..XXXX..XXX."
  ".XXXXXXXXXXXXXX."
  ".XXXXXXXXXXXXXX."
  "..XXXX....XXXX.."
  "..XXXXXXXXXXXX.."
  "...XXXXXXXXXX..."
  "....XXX..XXX...."
  "....XXX..XXX...."
  "................"
  "................"
end data

data OutlineFrame0 sprite16
  ".......XX......."
  ".....XX..XX....."
  "...XX......XX..."
  "..XX........XX.."
  ".XX..........XX."
  ".X...X.....X..X."
  "XX............XX"
  "XX............XX"
  "XX............XX"
  ".XX...XXXX...XX."
  ".XX..........XX."
  "..XX........XX.."
  "...XX......XX..."
  "...XX......XX..."
  "................"
  "................"
end data

data DetailFrame1 sprite16
  "................"
  "................"
  "................"
  "....XX....XX...."
  "...XXX...XXX...."
  "....XX....XX...."
  "....XX....XX...."
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
  "................"
end data

data BodyFrame1 sprite16
  "................"
  "......XXXX......"
  "....XXXXXXXX...."
  "...X..XXXX..X..."
  "..X...XXX...XX.."
  "..X...XXX...XX.."
  ".XXX..XXXX..XXX."
  ".XXXXXXXXXXXXXX."
  ".XXXXXXXXXXXXXX."
  "..XXX......XXX.."
  "..XXXXXXXXXXXX.."
  "...XXXXXXXXXX..."
  ".....XX..XX....."
  "...XXXX..XXXX..."
  "................"
  "................"
end data

data OutlineFrame1 sprite16
  ".......XX......."
  ".....XX..XX....."
  "...XX......XX..."
  "..XX........XX.."
  ".XX..........XX."
  ".X.X.....X....X."
  "XX............XX"
  "XX............XX"
  "XX............XX"
  ".XX..XXXXXX..XX."
  ".XX..........XX."
  "..XX........XX.."
  "....XX....XX...."
  "..XX........XX.."
  "................"
  "................"
end data

text screen
backdrop dark blue
sprites 16x16
sprites simple
copy DetailFrame0 to vram.spr_pat
copy BodyFrame0 to vram.spr_pat + 32
copy OutlineFrame0 to vram.spr_pat + 64
copy DetailFrame1 to vram.spr_pat + 96
copy BodyFrame1 to vram.spr_pat + 128
copy OutlineFrame1 to vram.spr_pat + 160
clear sprites
set sprite count 3
print centered at 3, "SPRITE METASPRITE"
print centered at 20, "MOVE WITH JOYSTICK"
screen on

MainLoop:
  wait
  if joypad(1).left and PlayerX > 1 then PlayerX -= 1
  if joypad(1).right and PlayerX < 239 then PlayerX += 1
  if joypad(1).up and PlayerY > 1 then PlayerY -= 1
  if joypad(1).down and PlayerY < 175 then PlayerY += 1

  AnimationTick += 1
  if AnimationTick = 8 then
    AnimationTick = 0
    if AnimationFrame = 0 then
      AnimationFrame = 1
    else
      AnimationFrame = 0
    end if
  end if

  set metasprite PlayerMeta frame AnimationFrame to PlayerY,PlayerX using sprite 0
  update sprites
  goto MainLoop
