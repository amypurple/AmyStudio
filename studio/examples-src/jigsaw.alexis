' the best result per picture: pieces, seconds, moves
u8 BestN[4]
u16 BestT[4]
u16 BestM[4]
' the puzzle
u8 Board[140]
u8 Klass[140]
u8 Sig[140]
u8 RowA[14]
u8 RowB[14]
u8 Pic = 0
u8 PW = 7
u8 PL = 5
u8 NC = 4
u8 NR = 4
u8 NP = 16
u8 Cur = 0
u8 Sel = 255
u8 Mode = 0
u16 Moves = 0
u16 Secs = 0
u8 SecF = 0
u8 Blink = 0
u8 Rep = 0
u8 Go = 0
u8 NewBest = 0
u8 Wrong = 0
' random numbers (xorshift)
u16 Rs = 4321
u16 Rt = 0
u8 Rb = 0
' title tune
u16 TzLeft = 0
u8 TzOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jy = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 Press1 = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Qi = 0
u8 Ri = 0
u8 Si = 0
u8 Ti = 0
' drawing
u8 Dp = 0
u8 Dq = 0
u16 Src = 0
u16 Dst = 0
u16 Base = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Ok = 0
u16 NumU = 0

  tile screen
  set sound table VjSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  for Pi = 0 to 3
    BestN[Pi] = 0
    BestT[Pi] = 0
    BestM[Pi] = 0
  next
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title
  SetupPage
  NewPuzzle

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Mode = 2 or Mode = 3 then goto play_loop

  ' solved: the whole picture, a fanfare, the result, then the title
  HideSprites
  mute all
  play sound SndSolved
  DrawPicture
  for Ri = 9 to 13
    fill 32 count 22 at 5,Ri
  next
  print at 11,9, "SOLVED!"
  print at 7,11, "MOVES"
  NumU = Moves
  print at 13,11, digits$(NumU, 4)
  print at 7,12, "TIME"
  NumU = Secs
  ShowClock(13, 12)
  NewBest = 0
  RecordBest
  if NewBest = 1 then print at 9,13, "A NEW BEST!"
  fill 32 count 28 at 2,22
  print at 8,22, "PRESS A BUTTON"
  Rearm
  wait 90 frames
  nmi off
  if NewBest = 1 then play sound SndBest
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the puzzle

' the column of board position (or piece) P in the piece grid
function ColOf(u8 P) as u8
  return P mod NC

function RowOf(u8 P) as u8
  return P / NC

' piece Dp drawn at board position Dq: PL rows of PW tiles copied from the
' picture's map straight into the name table
sub DrawAt:
  X = ColOf(Dp) * PW
  Y = RowOf(Dp) * PL
  Src = Base + Y * 28 + X
  X = ColOf(Dq) * PW + 2
  Y = RowOf(Dq) * PL + 2
  Dst = Y * 32 + X
  for Ti = 1 to PL
    copy PicMap + Src count PW to vram.name + Dst
    Src += 28
    Dst += 32
  next
  return
end sub

sub DrawPicture:
  Src = Base
  Dst = 66
  for Ri = 0 to 19
    copy PicMap + Src count 28 to vram.name + Dst
    Src += 28
    Dst += 32
  next
  return
end sub

sub DrawBoard:
  DrawPicture
  V = NP - 1
  for Qi = 0 to V
    Dp = Board[Qi]
    Dq = Qi
    DrawAt
  next
  return
end sub

' the tiles of piece Si's row Ti into RowA (piece Qi's into RowB)
sub RowsOf:
  Y = RowOf(Si) * PL + Ti
  X = ColOf(Si) * PW
  Src = Base + Y * 28 + X
  copy PicMap + Src count PW to RowA
  Y = RowOf(Qi) * PL + Ti
  X = ColOf(Qi) * PW
  Src = Base + Y * 28 + X
  copy PicMap + Src count PW to RowB
  return
end sub

' 1 when pieces Si and Qi show exactly the same tiles
function SameLook as u8
  Ok = 1
  W = PL - 1
  for Ti = 0 to W
    if Ok = 1 then
      RowsOf
      K = PW - 1
      for J = 0 to K
        if RowA[J] <> RowB[J] then Ok = 0
      next
    end if
  next
  return Ok

' a signature per piece (sum of its tiles), then the look-alike classes:
' Klass[P] is the first piece that looks exactly like P
sub MakeClasses:
  V = NP - 1
  for Si = 0 to V
    Sig[Si] = 0
    Klass[Si] = Si
    Qi = Si
    W = PL - 1
    for Ti = 0 to W
      RowsOf
      K = PW - 1
      for J = 0 to K
        Sig[Si] = Sig[Si] + RowA[J]
      next
    next
  next
  for Si = 1 to V
    C = Si - 1
    for Qi = 0 to C
      if Klass[Si] = Si then
        if Klass[Qi] = Qi and Sig[Qi] = Sig[Si] then
          if SameLook = 1 then Klass[Si] = Qi
        end if
      end if
    next
  next
  return
end sub

' 1 when the piece at board position P is not one that looks right there
function Misplaced(u8 P) as u8
  K = Board[P]
  if Klass[K] = Klass[P] then return 0
  return 1

' how many positions show the wrong piece (0: solved)
function CountWrong as u8
  W = 0
  V = NP - 1
  for Qi = 0 to V
    W = W + Misplaced(Qi)
  next
  return W

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rb = highbyte Rs
  return
end sub

' a random permutation (Fisher-Yates), again if it comes out solved
sub Shuffle:
  V = NP - 1
  for Qi = 0 to V
    Board[Qi] = Qi
  next
sh_again:
  Pi = NP - 1
  while Pi > 0
    Rnd
    K = Pi + 1
    J = Rb mod K
    C = Board[Pi]
    Board[Pi] = Board[J]
    Board[J] = C
    dec Pi
  end while
  Wrong = CountWrong
  if Wrong = 0 then goto sh_again
  return
end sub

sub NewPuzzle:
  NC = 28 / PW
  NR = 20 / PL
  NP = NC * NR
  Cur = 0
  Sel = 255
  Moves = 0
  Secs = 0
  SecF = 0
  Blink = 0
  Rep = 0
  NewScreen
  LoadPic
  DrawPicture
  print at 2,1, "VIDEO JIGSAW"
  print at 2,22, "LOOK CLOSELY..."
  ShowScreen
  MakeClasses
  Rearm
  wait PeekN frames
  nmi off
  play sound SndShuffle
  Shuffle
  DrawBoard
  ShowHud
  Mode = 2
  DrawCursor
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  return
end sub

sub PlayStep:
  Clock
  if Mode = 3 then
    if Press1 = 1 or Press2 = 1 then
      Mode = 2
      Blink = 0
      DrawBoard
      ShowHelp
      play sound SndPeek
    end if
    return
  end if
  StickMove
  if Press2 = 1 then
    Mode = 3
    DrawPicture
    fill 32 count 28 at 2,22
    print at 2,22, "THE PICTURE. PRESS A BUTTON"
    play sound SndPeek
    return
  end if
  if Press1 = 1 then PickOrPlace
  return
end sub

sub Clock:
  inc SecF
  if SecF < 60 then return
  SecF = 0
  if Secs < 5999 then inc Secs
  NumU = Secs
  ShowClock(23, 1)
  return
end sub

' the stick: a step on a new push, then repeats after 18 frames, every 8
sub StickMove:
  V = Jy & 15
  if V = 0 then
    Rep = 0
    return
  end if
  Go = 0
  if Rep = 0 then
    Go = 1
    Rep = 18
  else
    dec Rep
    if Rep = 0 then
      Go = 1
      Rep = 8
    end if
  end if
  if Go = 0 then return
  X = ColOf(Cur)
  K = Cur
  if V & 1 then
    if Cur >= NC then Cur -= NC
  elseif V & 2 then
    W = Cur + NC
    if W < NP then Cur = W
  elseif V & 4 then
    if X > 0 then dec Cur
  elseif V & 8 then
    W = NC - 1
    if X < W then inc Cur
  end if
  if Cur <> K then
    Blink = 0
    play sound SndStep
  end if
  return
end sub

sub PickOrPlace:
  if Sel = 255 then
    Sel = Cur
    play sound SndPick
    return
  end if
  if Sel = Cur then
    Sel = 255
    play sound SndDrop
    return
  end if
  Wrong = Wrong - Misplaced(Sel) - Misplaced(Cur)
  C = Board[Sel]
  Board[Sel] = Board[Cur]
  Board[Cur] = C
  Wrong = Wrong + Misplaced(Sel) + Misplaced(Cur)
  Dp = Board[Sel]
  Dq = Sel
  DrawAt
  Dp = Board[Cur]
  Dq = Cur
  DrawAt
  Sel = 255
  if Moves < 9999 then inc Moves
  NumU = Moves
  print at 8,1, digits$(NumU, 4)
  play sound SndSwap
  if Wrong = 0 then Mode = 4
  return
end sub

' more pieces is better; with as many, less time, then fewer moves
sub RecordBest:
  K = BestN[Pic]
  if NP > K then
    NewBest = 1
  elseif NP = K then
    if Secs < BestT[Pic] then
      NewBest = 1
    elseif Secs = BestT[Pic] and Moves < BestM[Pic] then
      NewBest = 1
    end if
  end if
  if NewBest = 1 then
    BestN[Pic] = NP
    BestT[Pic] = Secs
    BestM[Pic] = Moves
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites 0-1: the arrow at the top-left corner of piece Cur (on 12 frames
' of 24: 2.5 Hz); 2-5: corner marks round the picked piece (steady)
sub DrawCursor:
  inc Blink
  if Blink >= BlinkN then Blink = 0
  if Mode <> 2 then
    for J = 0 to 5
      set sprite J to 192,0,0,0
    next
    update sprites
    return
  end if
  X = ColOf(Cur) * PW
  X = X * 8 + 16
  Y = RowOf(Cur) * PL
  Y = Y * 8 + 15
  if Blink < 12 then
    set sprite 0 to Y,X,SArroww,15
    set sprite 1 to Y,X,SArrowo,1
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  end if
  if Sel = 255 then
    for J = 2 to 5
      set sprite J to 192,0,0,0
    next
  else
    X = ColOf(Sel) * PW
    X = X * 8 + 16
    Y = RowOf(Sel) * PL
    Y = Y * 8 + 15
    W = PW * 8
    W = W - 16
    K = PL * 8
    K = K - 16
    set sprite 2 to Y,X,SCtl,1
    C = X + W
    set sprite 3 to Y,C,SCtr,1
    J = Y + K
    set sprite 4 to J,X,SCbl,1
    set sprite 5 to J,C,SCbr,1
  end if
  update sprites
  return
end sub

' a time in seconds (NumU) as m:ss at column Cx, row Cy
sub ShowClock(u8 Cx, u8 Cy):
  Y = NumU / 60
  K = NumU mod 60
  NumU = Y
  print at Cx,Cy, digits$(NumU, 2)
  X = Cx + 2
  print at X,Cy, ":"
  NumU = K
  inc X
  print at X,Cy, digits$(NumU, 2)
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  print at 2,1, "MOVES"
  NumU = Moves
  print at 8,1, digits$(NumU, 4)
  print at 18,1, "TIME"
  NumU = Secs
  ShowClock(23, 1)
  ShowHelp
  return
end sub

sub ShowHelp:
  fill 32 count 28 at 2,22
  print at 2,22, "RIGHT BUTTON: SEE PICTURE"
  return
end sub

' the picture's 128 tiles into codes 128-255 of each screen third
sub LoadPic:
  Base = Pic
  Base = Base * 1024
  copy PicPat + Base count 1024 to vram.pattern + 1024
  copy PicPat + Base count 1024 to vram.pattern + 3072
  copy PicPat + Base count 1024 to vram.pattern + 5120
  copy PicCol + Base count 1024 to vram.color + 1024
  copy PicCol + Base count 1024 to vram.color + 3072
  copy PicCol + Base count 1024 to vram.color + 5120
  Base = Pic
  Base = Base * PicSize
  return
end sub

sub PrintPicName(u8 Px, u8 Py):
  select case Pic
  case 0
    print at Px,Py, "CASTLE    "
  case 1
    print at Px,Py, "LIGHTHOUSE"
  case 2
    print at Px,Py, "BALLOON   "
  case else
    print at Px,Py, "SAILBOAT  "
  end select
  return
end sub

' ---------------------------------------------------------------------------
' screens

' the setup: the picture above, the choices below; stick up/down chooses a
' line, left/right changes it, a button starts
sub SetupPage:
  Menu = 0
su_draw:
  NewScreen
  LoadPic
  DrawPicture
  for Ri = 14 to 22
    fill 32 count 28 at 2,Ri
  next
  print at 4,14, "PICTURE"
  print at 4,15, "WIDTH"
  print at 4,16, "LENGTH"
  print at 4,17, "PIECES"
  print at 4,21, "START PUZZLE"
  ShowSetup
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  WasStick = 15
su_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 15
  if V > 0 and WasStick = 0 then
    if V & 1 then
      if Menu > 0 then dec Menu
    elseif V & 2 then
      if Menu < 3 then inc Menu
    elseif Menu = 0 then
      if V & 4 then
        Pic = Pic + 3
      else
        inc Pic
      end if
      Pic = Pic & 3
      play sound SndStep
      WasStick = V
      goto su_draw
    elseif Menu = 1 then
      if V & 4 then
        if PW > 2 then dec PW
      else
        if PW < 14 then inc PW
      end if
    elseif Menu = 2 then
      if V & 4 then
        if PL > 2 then dec PL
      else
        if PL < 10 then inc PL
      end if
    end if
    play sound SndStep
    ShowSetup
  end if
  WasStick = V
  if Press1 = 0 and Press2 = 0 then goto su_loop
  if Menu < 3 then
    Menu = 3
    ShowSetup
    goto su_loop
  end if
  play sound SndPick
  return
end sub

sub ShowSetup:
  for Ri = 14 to 21
    put char 32 at 2,Ri
  next
  J = Menu + 14
  if Menu = 3 then J = 21
  put char 62 at 2,J
  print at 12,14, "< "
  PrintPicName(14, 14)
  print at 24,14, " >"
  NumU = PW
  print at 12,15, "< "
  print at 14,15, digits$(NumU, 2)
  print at 16,15, " >"
  NumU = PL
  print at 12,16, "< "
  print at 14,16, digits$(NumU, 2)
  print at 16,16, " >"
  C = 28 / PW
  K = 20 / PL
  V = C * K
  NumU = V
  print at 12,17, digits$(NumU, 3)
  NumU = C
  print at 16,17, "("
  print at 17,17, digits$(NumU, 2)
  print at 19,17, "X"
  NumU = K
  print at 20,17, digits$(NumU, 2)
  print at 22,17, ")"
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,19
  K = BestN[Pic]
  if K = 0 then
    print at 4,19, "BEST: NOT SOLVED YET"
  else
    print at 4,18, "BEST:"
    NumU = K
    print at 10,18, digits$(NumU, 3)
    print at 14,18, "PIECES"
    NumU = BestT[Pic]
    ShowClock(10, 19)
    NumU = BestM[Pic]
    print at 16,19, digits$(NumU, 4)
    print at 21,19, "MOVES"
  end if
  return
end sub

' the title: the castle picture, the name and the menu in a panel below,
' the tune once
sub TitlePage:
  Menu = 0
  TitleOn = 1
  Mode = 0
  Pic = 0
  NewScreen
  LoadPic
  DrawPicture
  for Ri = 13 to 22
    fill 32 count 28 at 2,Ri
  next
  print at 9,13, "VIDEO JIGSAW"
  print at 5,14, "BY FRED KARG, COMPUTE!S"
  print at 6,15, "GAZETTE SEPTEMBER 1986"
  print at 11,18, "START GAME"
  print at 11,19, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
tp_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 3
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press1 = 0 and Press2 = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,18
  put char 32 at 9,19
  put char 32 at 9,20
  J = Menu + 18
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: two pages, each with a corner of the castle as a little
' puzzle; a button turns the page, 30 s idle goes back
u8 HPg = 0
u16 HWt = 0
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  Pic = 0
  LoadPic
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "A PICTURE IS CUT INTO"
    print at 2,4, "PIECES AND MIXED UP. PUT"
    print at 2,5, "EVERY PIECE BACK IN ITS"
    print at 2,6, "PLACE TO WIN."
    print at 2,8, "FIRST CHOOSE A PICTURE AND"
    print at 2,9, "THE PIECE SIZE: WIDTH 2-14"
    print at 2,10, "AND LENGTH 2-10 TILES."
    print at 2,11, "BIG PIECES: EASY (4 PIECES)"
    print at 2,12, "SMALL ONES: HARD (UP TO 140)"
    ' two pieces of the castle's towers, swapped
    Src = 69
    Dst = 15 * 32 + 9
    for Ri = 0 to 5
      Src += 6
      copy PicMap + Src count 6 to vram.name + Dst
      Src = Src - 6
      Dst += 6
      copy PicMap + Src count 6 to vram.name + Dst
      Dst = Dst - 6
      Src += 28
      Dst += 32
    next
    set sprite 0 to 119,72,SArroww,15
    set sprite 1 to 119,72,SArrowo,1
  else
    print at 2,3, "STICK: MOVE THE ARROW."
    print at 2,4, "LEFT BUTTON: PICK A PIECE,"
    print at 2,5, "THEN PICK WHERE IT GOES:"
    print at 2,6, "THE TWO PIECES SWAP."
    print at 2,7, "RIGHT BUTTON: SEE THE WHOLE"
    print at 2,8, "PICTURE. A BUTTON RETURNS."
    print at 2,10, "SOLVED: EVERY PIECE IN ITS"
    print at 2,11, "PLACE. MOVES AND TIME COUNT;"
    print at 2,12, "BEST: MOST PIECES, THEN"
    print at 2,13, "THE FASTEST TIME."
    print at 2,14, "TIP: DO THE BORDER FIRST."
    Src = 100
    Dst = 16 * 32 + 12
    for Ri = 0 to 5
      copy PicMap + Src count 6 to vram.name + Dst
      Src += 28
      Dst += 32
    next
    set sprite 2 to 127,96,SCtl,1
    set sprite 3 to 127,128,SCtr,1
    set sprite 4 to 159,96,SCbl,1
    set sprite 5 to 159,128,SCbr,1
  end if
  print at 8,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then
    HideSprites
    return
  end if
  if Press1 = 0 and Press2 = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B4
  backdrop dark blue
  print at 9,2, "VIDEO JIGSAW"
  print at 2,5, "BASED ON VIDEO JIGSAW BY"
  print at 2,6, "FRED KARG, COMPUTE!S"
  print at 2,7, "GAZETTE, SEPTEMBER 1986"
  print at 2,8, "(COMMODORE 64, BASIC)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: CORNER PIECES"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Jy = J1 | J2
  Press1 = 0
  Press2 = 0
  V = Jy & 16
  if V > 0 and WasB1 = 0 then Press1 = 1
  WasB1 = V
  V = Jy & 32
  if V > 0 and WasB2 = 0 then Press2 = 1
  WasB2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $04,$04,$04,$04,$04,$04,$04,$04
  $05,$04,$04,$04,$04,$04,$04,$05
end data
data SpritePat bytes
  $00,$78,$70,$78,$5C,$0E,$07,$03,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $FC,$84,$88,$84,$A2,$D1,$08,$04,$03,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00
  $FE,$FE,$FE,$E0,$E0,$E0,$E0,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $7F,$7F,$7F,$07,$07,$07,$07,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$E0,$E0,$E0,$E0,$FE,$FE,$FE
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$07,$07,$07,$07,$7F,$7F,$7F
end data

asm {
VjStep:
    db $40,$40,$70,$01,$50
VjPick:
    db $40,$AA,$30,$03,$40,$71,$40,$04,$50
VjSwap:
    db $40,$71,$30,$03,$40,$8F,$30,$03,$40,$55,$40,$05,$50
VjDrop:
    db $40,$8F,$40,$03,$40,$D6,$50,$05,$50
VjPeek:
    db $40,$5F,$50,$02,$40,$47,$50,$02,$50
VjShuffle:
    db $00,$00,$33,$02,$00,$00,$44,$02,$00,$00,$55,$02,$00,$00,$76,$03,$10
VjSolved:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$20,$06,$40,$6B,$20,$18
    db $50
VjBest:
    db $40,$55,$20,$06,$40,$47,$20,$06,$40,$35,$20,$12,$50

VjSoundTable:
    dw VjTuneMel,$702B
    dw VjTuneBass,$7035
    dw VjStep,$7049
    dw VjPick,$7049
    dw VjSwap,$7049
    dw VjDrop,$7049
    dw VjPeek,$7049
    dw VjShuffle,$703F
    dw VjSolved,$7049
    dw VjBest,$7049
; Corner Pieces (original)
; Tiny Sound, 8 frames per step
VjTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$18,$01,$1C,$1F,$01,$1C,$1D,$01,$1A,$01,$17,$1A
