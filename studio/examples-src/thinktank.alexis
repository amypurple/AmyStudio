cartridge "THINK TANK/COMPUTE'S GAZETTE/1990"

' THINK TANK - a ColecoVision port of "Think Tank" by Fred Karg,
' COMPUTE!'s Gazette, April 1990 p. 35 (C64 BASIC, disk file "think
' tank"; rules from the article and the listing, orig/thinktank.bas).
'
' Two tank commanders, three tanks each, on an open field. Each round
' both commanders secretly write ten orders, then the orders run step by
' step, one order of each side a step. Destroy all three enemy tanks.
'
' Controls (joystick only, no keypad):
'   up / down      choose which of your tanks the next order is for (it
'                  blinks)
'   left / right   choose an order: L turn left, R turn right, M move one
'                  cell forward, F fire, and the arrow (take back the last
'                  order)
'   either button  write the order down (it shows as a grey block, hidden
'                  as on the C64); after ten orders the other side writes
'   2 players: before each commander writes, a "pass the controller"
'              screen hides the field's order rows until that player
'              presses a button
'   1 player:  either joystick commands the white tanks, the computer the
'              yellow ones
'   2 players: joystick 1 the white tanks, joystick 2 the yellow ones
'   title: up/down picks 1 PLAYER, 2 PLAYERS or HOW TO PLAY (3 pages)
'
' Rules kept from the listing:
' - white tanks start on the left (cells 0,1 0,9 1,3 facing down, up,
'   right), yellow on the right (facing down, up, left)
' - ten orders a round for each commander, from L R M F; each order is for
'   the tank chosen when it is written (several orders may go to one tank)
' - the orders run in ten steps; in each step the side that wrote first
'   acts first; the side that writes first swaps every round
' - M moves one cell (16 C64 pixels) the way the tank points; the field's
'   edge stops it; driving into any other tank destroys both
' - F sends a shell straight ahead to the edge; the first tank in its way
'   is destroyed, friend or foe
' - an order for a destroyed tank is skipped (wasted)
' - a tank told to move past the edge hits the wall: no damage, it stays
' - a side with no tanks left loses: "CONGRATULATIONS, TANK COMMANDER"
'
' Liberties:
' - a ONE PLAYER game against a computer commander (the C64 was two
'   players): it plans its ten orders on a copy of the field, guessing at
'   each step the order a plain commander would give (shoot ahead, turn
'   to a tank in line, close in), and fires at where enemy tanks stand or
'   are about to roll; it never reads your orders; no typed names: the winner is "PLAYER 1" / "PLAYER 2" /
'   "THE COMPUTER"
' - the field is 14 x 10 cells (the C64's 19 x 10: the 16-pixel cells
'   must fit columns 2-29); the yellow tanks start 4 cells nearer
' - orders are chosen with the joystick from a menu; as in the article,
'   every order written shows only as a grey block until it runs; each
'   order then shows the tank number beside its letter
' - two players: a "pass the controller" pause before each commander
'   writes (the C64 shared one keyboard and relied on the opponent looking
'   away while keys were pressed)
' - the take-back arrow works like the C64's DEL key
' - both sides losing their last tank in the same crash is a draw (the
'   C64 code got muddled there)
' - smooth tank moves (a pixel a frame), turning, a visible shell and
'   blasts, sound effects, block-letter title, credits page, original
'   tune "Orders of the Day"

const TCell00 = 128
const TCell01 = 129
const TCell10 = 130
const TCell11 = 131
const THud = 132
const THide = 133
const TSlot = 134
const TML = 135
const THL = 136
const TMR = 137
const THR = 138
const TMM = 139
const THM = 140
const TMF = 141
const THF = 142
const TMU = 143
const THU = 144
const TP1 = 145
const TP2 = 146
const TBrick = 147
const STkU = 0
const STkR = 4
const STkD = 8
const STkL = 12
const SShell = 16
const SBoom1 = 20
const SBoom2 = 24
const NTiles8 = 160
const SprBytes = 224
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndEnter = 4
const SndUndo = 5
const SndTurn = 6
const SndRumble = 7
const SndBump = 8
const SndShot = 9
const SndBoom = 10
const SndWin = 11
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

const FW = 14
const FH = 10
const NOrders = 10

record Tank:
  u8 C
  u8 R
  u8 D
  u8 Live
end record

Tank Tk[6]
u8 Prog[20]
' the computer's planning copy of the field
u8 SC[6]
u8 SR[6]
u8 SD[6]
u8 SL[6]
' orders F planned for each tank this round (guesses lose worth)
u8 SF[6]
u8 AiT = 0
u8 T0 = 0

data StartC bytes
  0,0,1,13,13,12
end data
data StartR bytes
  1,9,3,0,8,6
end data
data StartD bytes
  2,0,1,2,0,3
end data
data DirC bytes
  0,1,0,255
end data
data DirR bytes
  255,0,1,0
end data
data TankPat bytes
  STkU,STkR,STkD,STkL
end data
data TankCol bytes
  15,15,15,11,11,11
end data
data OrderChar bytes
  32,76,82,77,70
end data

u16 NumU = 0
u16 Rs = 12345
u8 Phase = 0
u8 Players = 1
u8 Menu = 0
u8 Winner = 0
u8 First = 0
u8 Round = 0
u8 ProgP = 0
u8 NOrd = 0
u8 Cur = 0
u8 Sel = 0
u8 Blink = 255
u8 StepN = 0
u8 AiK = 0
u8 Moves = 0
u8 WasFire = 0
u8 WasStick = 0
u8 Tick = 0
u8 J = 0
u8 V = 0
u8 W = 0
' the moving tank (Anim) and its offset in pixels (u8, wraps for minus)
u8 Anim = 255
u8 OffX = 0
u8 OffY = 0
' the shell (sprite 0) and the blast (sprite 1)
u8 ShX = 0
u8 ShY = 0
u8 ShOn = 0
u8 BmX = 0
u8 BmY = 0
u8 BmPat = 0
u8 BmOn = 0

  tile screen
  set sound table TtSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  EditorialPage

title:
  Phase = 0
  TitlePage
  if Menu = 2 then
    HowToPlay
    goto title
  end if
  StartGame

round_loop:
  inc Round
  WriteOrders(First)
  WriteOrders(1 - First)
  RunRound
  if Winner > 0 then goto game_over
  First = 1 - First
  ClearOrderRows
  goto round_loop

game_over:
  Phase = 3
  Rearm
  wait 50 frames
  nmi off
  HideSprites
  fill THud count 28 at 2,8
  fill THud count 28 at 2,9
  fill THud count 28 at 2,10
  fill THud count 28 at 2,11
  fill THud count 28 at 2,12
  fill THud count 28 at 2,13
  if Winner = 3 then
    print at 5,10, "BOTH ARMIES DESTROYED"
    print at 11,11, "A DRAW!"
  else
    print at 7,9, "CONGRATULATIONS,"
    print at 8,10, "TANK COMMANDER"
    if Winner = 1 then
      print at 11,12, "PLAYER 1"
    elseif Players = 1 then
      print at 9,12, "THE COMPUTER"
    else
      print at 11,12, "PLAYER 2"
    end if
    play sound SndWin
  end if
  Phase = 4
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  call asm TtClr
  Rearm
  call asm TtPoll
  nmi off
  inc Tick
  return
end sub

sub Frames(u8 N):
  u8 K = 0
  for K = 1 to N
    Frame1
    DrawSprites
  next
  return
end sub

' 16-bit xorshift; returns its low byte
function Rnd as u8
  Rs ^= Rs << 7
  Rs ^= Rs >> 9
  Rs ^= Rs << 8
  return Rs & 255

function Dist(u8 A, u8 B) as u8
  if A > B then return A - B
  return B - A

' a stick as bits: 1 up, 2 down, 4 left, 8 right, 16 a button
function PadBits(u8 P) as u8
  u8 B = 0
  if joypad(P).up then B |= 1
  if joypad(P).down then B |= 2
  if joypad(P).left then B |= 4
  if joypad(P).right then B |= 8
  if joypad(P).fire then B |= 16
  return B

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' one row of field tiles (screen rows 1-20; two rows a cell)
sub FieldRow(u8 Y):
  u8 X = 0
  u8 A = TCell00
  u8 B = TCell01
  V = (Y - 1) & 1
  if V = 1 then
    A = TCell10
    B = TCell11
  end if
  for X = 2 to 28 step 2
    put char A at X,Y
    W = X + 1
    put char B at W,Y
  next
  return
end sub

sub DrawField:
  u8 Y = 0
  for Y = 1 to 20
    FieldRow(Y)
  next
  ClearOrderRows
  return
end sub

' the order rows: row 21 player 1, row 22 player 2
sub ClearOrderRows:
  u8 P = 0
  u8 Row = 0
  u8 K = 0
  u8 C = 0
  for P = 0 to 1
    Row = 21 + P
    fill THud count 28 at 2,Row
    put char TP1 + P at 2,Row
    for K = 0 to 9
      C = K * 2 + 4
      put char TSlot at C,Row
    next
  next
  return
end sub

' the order menu for player P (columns 25-29), Cur highlighted; Vis = 0 hides it
sub DrawMenu(u8 P, u8 Vis):
  u8 I = 0
  u8 T = 0
  u8 C = 0
  u8 Row = 0
  Row = 21 + P
  for I = 0 to 4
    C = 25 + I
    if Vis = 0 then
      put char THud at C,Row
    else
      T = I * 2 + TML
      if I = Cur then inc T
      put char T at C,Row
    end if
  next
  return
end sub

' order K of player P: the letter and the tank number, or a grey block
sub ShowOrder(u8 P, u8 K, u8 Grey):
  u8 Code = 0
  u8 C = 0
  u8 Row = 0
  u8 Ch = 0
  Row = 21 + P
  C = K * 2 + 4
  Code = Prog[P * 10 + K]
  if Grey = 1 then
    put char THide at C,Row
    inc C
    put char THud at C,Row
  else
    Ch = OrderChar[Code & 7]
    put char Ch at C,Row
    inc C
    Ch = (Code >> 3) + 49
    put char Ch at C,Row
  end if
  return
end sub

sub ClearOrder(u8 P, u8 K):
  u8 C = 0
  u8 Row = 0
  Row = 21 + P
  C = K * 2 + 4
  put char TSlot at C,Row
  inc C
  put char THud at C,Row
  return
end sub

' a message across row 10 of the field for a moment
sub Banner(u8 Which):
  Rearm
  wait
  nmi off
  fill THud count 28 at 2,10
  select case Which
  case 0
    print at 7,10, "PLAYER 1: ORDERS"
  case 1
    print at 7,10, "PLAYER 2: ORDERS"
  case 2
    print at 9,10, "YOUR ORDERS"
  case 3
    print at 6,10, "COMPUTER THINKING"
  case else
    print at 10,10, "ROUND "
    NumU = Round
    print at 16,10, digits$(NumU, 2)
  end select
  Frames(50)
  Rearm
  wait
  nmi off
  FieldRow(10)
  return
end sub

' two players: hand the controller over; the next commander presses
' a button on his own joystick to start writing
sub PassPad(u8 P):
  u8 Pad = 0
  u8 In = 0
  u8 Was = 16
  Pad = P + 1
  Rearm
  wait
  nmi off
  fill THud count 28 at 2,9
  fill THud count 28 at 2,10
  fill THud count 28 at 2,11
  if P = 0 then
    print at 4,9, "PASS THE CONTROLLER TO"
    print at 5,10, "PLAYER 1 (JOYSTICK 1)"
  else
    print at 4,9, "PASS THE CONTROLLER TO"
    print at 5,10, "PLAYER 2 (JOYSTICK 2)"
  end if
  print at 7,11, "PRESS THE BUTTON"
  In = 1
  while In > 0
    Frame1
    DrawSprites
    In = PadBits(Pad) & 16
    if Was > 0 then
      Was = In
      In = 1
    else
      if In = 0 then In = 1 else In = 0
    end if
  end while
  Rearm
  wait
  nmi off
  FieldRow(9)
  FieldRow(10)
  FieldRow(11)
  return
end sub

sub DrawSprites:
  u8 I = 0
  u8 X = 0
  u8 Y = 0
  u8 Col = 0
  u8 Pat = 0
  u8 D = 0
  for I = 0 to 5
    J = I + 2
    if Tk[I].Live = 0 then
      set sprite J to 192,0,0,0
    else
      X = Tk[I].C * 16 + 16
      Y = Tk[I].R * 16 + 7
      if I = Anim then
        X += OffX
        Y += OffY
      end if
      D = Tk[I].D
      Pat = TankPat[D]
      Col = TankCol[I]
      if I = Blink then
        V = Tick & 16
        if V > 0 then Col = 1
      end if
      set sprite J to Y,X,Pat,Col
    end if
  next
  if ShOn = 1 then
    set sprite 0 to ShY,ShX,SShell,15
  else
    set sprite 0 to 192,0,0,0
  end if
  if BmOn = 1 then
    set sprite 1 to BmY,BmX,BmPat,9
  else
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub StartGame:
  u8 I = 0
  NewScreen
  DrawField
  for I = 0 to 5
    Tk[I].C = StartC[I]
    Tk[I].R = StartR[I]
    Tk[I].D = StartD[I]
    Tk[I].Live = 1
  next
  Winner = 0
  First = 0
  Round = 0
  Moves = 0
  Anim = 255
  Blink = 255
  ShOn = 0
  BmOn = 0
  DrawSprites
  ShowScreen
  return
end sub

' the next living tank of player P after (Dir 1) or before (Dir 255) tank T
function NextTank(u8 P, u8 T, u8 Dir) as u8
  u8 K = 0
  u8 N = 0
  u8 Lo = 0
  Lo = P * 3
  N = T - Lo
  for K = 1 to 3
    N += Dir
    if N = 255 then N = 2
    if N = 3 then N = 0
    if Tk[Lo + N].Live = 1 then return Lo + N
  next
  return T

' 1 + the living tank on cell C,R, or 0
function Occ(u8 C, u8 R) as u8
  u8 I = 0
  for I = 0 to 5
    if Tk[I].Live = 1 then
      if Tk[I].C = C then
        if Tk[I].R = R then return I + 1
      end if
    end if
  next
  return 0

' ---------------------------------------------------------------------------
' writing orders

sub WriteOrders(u8 P):
  u8 In = 0
  u8 St = 0
  u8 Pr = 0
  u8 K = 0
  u8 Pad = 0
  u8 Lo = 0
  Phase = 1
  ProgP = P
  NOrd = 0
  Cur = 0
  Lo = P * 3
  Sel = NextTank(P, Lo + 2, 1)
  if P = 0 then
    if Players = 1 then Banner(2) else Banner(0)
  else
    if Players = 1 then
      Banner(3)
      AiPlan(1)
      for K = 0 to 9
        ShowOrder(1, K, 1)
      next
      Frames(20)
      return
    end if
    Banner(1)
  end if
  Pad = P + 1
  if Players = 2 then PassPad(P)
  Rearm
  wait
  nmi off
  DrawMenu(P, 1)
  Blink = Sel
  WasStick = 15
  WasFire = 16
  while NOrd < NOrders
    Frame1
    if Players = 1 then
      In = PadBits(1) | PadBits(2)
    else
      In = PadBits(Pad)
    end if
    St = In & 15
    Pr = 0
    if St > 0 then
      if WasStick = 0 then Pr = St
    end if
    WasStick = St
    if Pr & 1 then
      Sel = NextTank(P, Sel, 1)
      play sound SndClick
    elseif Pr & 2 then
      Sel = NextTank(P, Sel, 255)
      play sound SndClick
    elseif Pr & 4 then
      if Cur = 0 then Cur = 4 else dec Cur
      play sound SndClick
      DrawMenu(P, 1)
    elseif Pr & 8 then
      if Cur = 4 then Cur = 0 else inc Cur
      play sound SndClick
      DrawMenu(P, 1)
    end if
    Blink = Sel
    St = In & 16
    if St > 0 then
      if WasFire = 0 then TakeOrder(P)
    end if
    WasFire = St
    DrawSprites
  end while
  Blink = 255
  Frames(15)
  Rearm
  wait
  nmi off
  DrawMenu(P, 0)
  return
end sub

' the button: write the chosen order (or take the last one back)
sub TakeOrder(u8 P):
  u8 Ix = 0
  u8 Lo = 0
  Lo = P * 3
  if Cur = 4 then
    if NOrd > 0 then
      dec NOrd
      Ix = P * 10 + NOrd
      ' back to the tank of the order taken back
      Sel = (Prog[Ix] >> 3) + Lo
      Prog[Ix] = 0
      ClearOrder(P, NOrd)
      play sound SndUndo
    end if
  else
    Ix = P * 10 + NOrd
    Prog[Ix] = (Sel - Lo) * 8 + Cur + 1
    ShowOrder(P, NOrd, 1)
    inc NOrd
    play sound SndEnter
  end if
  return
end sub

' ---------------------------------------------------------------------------
' running the orders

sub RunRound:
  u8 P = 0
  Phase = 2
  Banner(4)
  StepN = 0
  while StepN < NOrders
    P = First
    DoOrder(P, StepN)
    if Winner = 0 then
      P = 1 - First
      DoOrder(P, StepN)
    end if
    if Winner > 0 then StepN = NOrders else inc StepN
  end while
  Frames(30)
  return
end sub

sub DoOrder(u8 P, u8 K):
  u8 Code = 0
  u8 T = 0
  u8 Cmd = 0
  u8 D = 0
  Code = Prog[P * 10 + K]
  T = (Code >> 3) + P * 3
  Cmd = Code & 7
  Rearm
  wait
  nmi off
  ShowOrder(P, K, 0)
  inc Moves
  if Tk[T].Live = 0 then
    Frames(8)
    return
  end if
  D = Tk[T].D
  select case Cmd
  case 1
    Tk[T].D = (D + 3) & 3
    play sound SndTurn
    Frames(14)
  case 2
    Tk[T].D = (D + 1) & 3
    play sound SndTurn
    Frames(14)
  case 3
    MoveTank(T)
  case 4
    FireTank(T)
  end select
  Frames(6)
  return
end sub

sub MoveTank(u8 T):
  u8 D = 0
  u8 NC = 0
  u8 NR = 0
  u8 O = 0
  u8 K = 0
  u8 Steps = 16
  u8 Dc = 0
  u8 Dr = 0
  D = Tk[T].D
  Dc = DirC[D]
  Dr = DirR[D]
  NC = Tk[T].C + Dc
  NR = Tk[T].R + Dr
  Anim = T
  if NC >= FW or NR >= FH then
    ' the edge: it stays (a thud; no nudge, which would leave the safe area)
    play sound SndBump
    Frames(10)
    Anim = 255
    return
  end if
  O = Occ(NC, NR)
  if O > 0 then Steps = 8
  play sound SndRumble
  for K = 1 to Steps
    OffX = Dc * K
    OffY = Dr * K
    Frame1
    DrawSprites
  next
  OffX = 0
  OffY = 0
  Anim = 255
  if O > 0 then
    ' a crash: both tanks are destroyed
    Boom(O - 1)
    Boom(T)
  else
    Tk[T].C = NC
    Tk[T].R = NR
  end if
  return
end sub

sub FireTank(u8 T):
  u8 D = 0
  u8 C = 0
  u8 R = 0
  u8 O = 0
  u8 K = 0
  u8 Dc = 0
  u8 Dr = 0
  u8 Going = 1
  D = Tk[T].D
  Dc = DirC[D]
  Dr = DirR[D]
  C = Tk[T].C
  R = Tk[T].R
  ShX = C * 16 + 16
  ShY = R * 16 + 7
  ShOn = 1
  play sound SndShot
  while Going = 1
    C += Dc
    R += Dr
    if C >= FW or R >= FH then
      Going = 0
    else
      for K = 1 to 4
        ShX += Dc * 4
        ShY += Dr * 4
        Frame1
        DrawSprites
      next
      O = Occ(C, R)
      if O > 0 then
        Going = 0
        ShOn = 0
        Boom(O - 1)
      end if
    end if
  end while
  ShOn = 0
  DrawSprites
  return
end sub

sub Boom(u8 T):
  u8 A = 0
  u8 B = 0
  u8 I = 0
  Tk[T].Live = 0
  BmX = Tk[T].C * 16 + 16
  BmY = Tk[T].R * 16 + 7
  BmPat = SBoom1
  BmOn = 1
  play sound SndBoom
  Frames(12)
  BmPat = SBoom2
  Frames(20)
  BmOn = 0
  DrawSprites
  for I = 0 to 2
    A += Tk[I].Live
    B += Tk[I + 3].Live
  next
  if A = 0 then
    if B = 0 then Winner = 3 else Winner = 2
  elseif B = 0 then
    Winner = 1
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the computer commander: plans its ten orders on a copy of the field,
' guessing that the enemy tanks stay where they are

' 1 when a tank on C,R pointing D has cell Tc,Tr straight ahead
function Facing(u8 C, u8 R, u8 D, u8 Tc, u8 Tr) as u8
  select case D
  case 0
    if C = Tc and Tr < R then return 1
  case 1
    if R = Tr and Tc > C then return 1
  case 2
    if C = Tc and Tr > R then return 1
  case else
    if R = Tr and Tc < C then return 1
  end select
  return 0

' 1 + the planned tank on C,R, or 0
function SimOcc(u8 C, u8 R) as u8
  u8 I = 0
  for I = 0 to 5
    if SL[I] > 0 then
      if SC[I] = C and SR[I] = R then return I + 1
    end if
  next
  return 0

' 1 + the first planned tank a shell from C,R pointing D would hit, or 0
function SimShot(u8 C, u8 R, u8 D) as u8
  u8 O = 0
  u8 X = 0
  u8 Y = 0
  X = C
  Y = R
  while O = 0
    X += DirC[D]
    Y += DirR[D]
    if X >= FW or Y >= FH then return 0
    O = SimOcc(X, Y)
  end while
  return O

' what a shell from C,R pointing D is worth to side P: a sure hit on an
' enemy where it stands, or a cell an enemy tank is likely to move into
' (one or two cells ahead of it); a friend in the way is a disaster
function ShotVal(u8 P, u8 C, u8 R, u8 D) as i16
  i16 Val = -15
  i16 Guess = 0
  u8 X = 0
  u8 Y = 0
  u8 O = 0
  u8 E = 0
  u8 Lo = 0
  u8 Ec = 0
  u8 Er = 0
  u8 Ed = 0
  u8 Going = 1
  Lo = 3 - P * 3
  Guess = SF[AiT] * 10
  Guess = 45 - Guess
  X = C
  Y = R
  while Going = 1
    X += DirC[D]
    Y += DirR[D]
    if X >= FW or Y >= FH then
      Going = 0
    else
      O = SimOcc(X, Y)
      if O > 0 then
        Going = 0
        dec O
        if O / 3 = P then
          Val = -500
        elseif SL[O] = 2 then
          if Val < 0 then Val = -12
        else
          Val = 100 - AiK * 6
        end if
      else
        for E = Lo to Lo + 2
          if SL[E] = 1 then
            Ed = SD[E]
            Ec = SC[E] + DirC[Ed]
            Er = SR[E] + DirR[Ed]
            if Ec = X and Er = Y then
              if Val < Guess then Val = Guess
            end if
            Ec += DirC[Ed]
            Er += DirR[Ed]
            if Ec = X and Er = Y then
              if Val < Guess - 20 then Val = Guess - 20
            end if
          end if
        next
      end if
    end if
  end while
  return Val

' how good it is for tank T (side P) to stand on C,R pointing D
function PosVal(u8 P, u8 C, u8 R, u8 D) as i16
  i16 S = 0
  u8 E = 0
  u8 Lo = 0
  u8 F = 0
  u8 M = 0
  u8 Dr = 0
  Lo = 3 - P * 3
  for E = Lo to Lo + 2
    if SL[E] > 0 then
      if C = SC[E] or R = SR[E] then
        F = Facing(C, R, D, SC[E], SR[E])
        if F = 1 then S += 40
        F = Facing(SC[E], SR[E], SD[E], C, R)
        if F = 1 then S -= 10
      else
        M = Dist(C, SC[E])
        Dr = Dist(R, SR[E])
        if Dr < M then M = Dr
        S -= M * 4
      end if
    end if
  next
  return S

function Eval(u8 P, u8 T, u8 Cm) as i16
  i16 S = 0
  i16 Base = 0
  u8 C = 0
  u8 R = 0
  u8 D = 0
  u8 NC = 0
  u8 NR = 0
  u8 O = 0
  AiT = T
  C = SC[T]
  R = SR[T]
  D = SD[T]
  Base = PosVal(P, C, R, D)
  select case Cm
  case 1
    NR = (D + 3) & 3
    S = PosVal(P, C, R, NR) - Base
  case 2
    NR = (D + 1) & 3
    S = PosVal(P, C, R, NR) - Base
  case 3
    NC = C + DirC[D]
    NR = R + DirR[D]
    if NC >= FW or NR >= FH then
      S = -25
    else
      O = SimOcc(NC, NR)
      if O = 0 then
        S = PosVal(P, NC, NR, D) - Base + 2
      else
        dec O
        if O / 3 = P then S = -500 else S = 30
      end if
    end if
  case else
    S = ShotVal(P, C, R, D)
  end select
  S += Rnd & 3
  return S

' carry out order Cm of tank T on the planning copy
sub SimApply(u8 P, u8 T, u8 Cm):
  u8 D = 0
  u8 NC = 0
  u8 NR = 0
  u8 O = 0
  D = SD[T]
  select case Cm
  case 1
    SD[T] = (D + 3) & 3
  case 2
    SD[T] = (D + 1) & 3
  case 3
    NC = SC[T] + DirC[D]
    NR = SR[T] + DirR[D]
    if NC < FW and NR < FH then
      O = SimOcc(NC, NR)
      if O = 0 then
        SC[T] = NC
        SR[T] = NR
      else
        SL[O - 1] = 0
        SL[T] = 0
      end if
    end if
  case else
    inc SF[T]
    O = SimShot(SC[T], SR[T], D)
    if O > 0 then
      dec O
      if O / 3 = P then SL[O] = 0 else SL[O] = 2
    end if
  end select
  return
end sub

' the order a plain commander Q would give now: shoot what is straight
' ahead, turn towards a tank in line, else close in on the nearest one
function Predict(u8 Q) as u8
  u8 I = 0
  u8 T = 0
  u8 E = 0
  u8 O = 0
  u8 Lo = 0
  u8 Want = 0
  u8 Best = 99
  u8 Pick = 0
  u8 M = 0
  u8 Dc = 0
  u8 Dr = 0
  u8 D = 0
  Lo = Q * 3
  Pick = Lo * 8 + 4
  for I = 0 to 2
    T = Lo + I
    if SL[T] = 1 and Best > 0 then
      O = SimShot(SC[T], SR[T], SD[T])
      if O > 0 then
        dec O
        if O / 3 <> Q then
          Best = 0
          Pick = T * 8 + 4
        end if
      end if
    end if
  next
  if Best = 0 then return Pick
  for I = 0 to 2
    T = Lo + I
    if SL[T] = 1 then
      D = SD[T]
      for E = 0 to 5
        if SL[E] > 0 and E / 3 <> Q then
          Dc = Dist(SC[T], SC[E])
          Dr = Dist(SR[T], SR[E])
          M = Dc
          if Dr < M then M = Dr
          if M < Best then
            Best = M
            if Dc <= Dr then
              if SC[E] > SC[T] then Want = 1 else Want = 3
              if Dc = 0 then
                if SR[E] > SR[T] then Want = 2 else Want = 0
              end if
            else
              if SR[E] > SR[T] then Want = 2 else Want = 0
            end if
            if Want = D then
              O = SimOcc(SC[T] + DirC[D], SR[T] + DirR[D])
              if O > 0 then Pick = T * 8 + 1 else Pick = T * 8 + 3
            else
              O = (D + 1) & 3
              if O = Want then Pick = T * 8 + 2 else Pick = T * 8 + 1
            end if
          end if
        end if
      next
    end if
  next
  return Pick

' the computer's guess at the other side's order: usually the plain
' commander's, sometimes its own idea of the best (it can't read minds)
function GuessOrder(u8 Q) as u8
  u8 R = 0
  R = Rnd & 3
  if R > 0 then return BestOrder(Q)
  return Predict(Q)

' the order commander Q is likely to give now (the best by Eval)
function BestOrder(u8 Q) as u8
  u8 I = 0
  u8 T = 0
  u8 Cm = 0
  u8 Lo = 0
  u8 Pick = 0
  i16 Best = 0
  i16 S = 0
  Lo = Q * 3
  Best = -30000
  Pick = Lo * 8 + 4
  for I = 0 to 2
    T = Lo + I
    if SL[T] > 0 then
      for Cm = 1 to 4
        S = Eval(Q, T, Cm)
        if S > Best then
          Best = S
          Pick = T * 8 + Cm
        end if
      next
    end if
  next
  return Pick

' plan ten orders for side P; at each step the other side is guessed to
' give its own best order (before ours when it acts first)
sub AiPlan(u8 P):
  u8 I = 0
  u8 K = 0
  u8 Q = 0
  u8 Pick = 0
  u8 T = 0
  Q = 1 - P
  for I = 0 to 5
    SC[I] = Tk[I].C
    SR[I] = Tk[I].R
    SD[I] = Tk[I].D
    SL[I] = Tk[I].Live
    SF[I] = 0
  next
  for K = 0 to 9
    AiK = K
    if First = Q then
      Pick = GuessOrder(Q)
      T = Pick >> 3
      if SL[T] > 0 then SimApply(Q, T, Pick & 7)
    end if
    Pick = BestOrder(P)
    T = Pick >> 3
    if SL[T] > 0 then SimApply(P, T, Pick & 7)
    Prog[P * 10 + K] = (T - P * 3) * 8 + (Pick & 7)
    if First = P then
      Pick = GuessOrder(Q)
      T = Pick >> 3
      if SL[T] > 0 then SimApply(Q, T, Pick & 7)
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' title, menu and credits

sub ShowMenu:
  print at 9,16, "  1 PLAYER   "
  print at 9,17, "  2 PLAYERS  "
  print at 9,18, "  HOW TO PLAY"
  V = 16 + Menu
  print at 9,V, ">"
  return
end sub

' wait for a button (press and release) or 30 seconds
sub PageWait:
  u16 Idle = 0
  u8 In = 0
  u8 Was = 16
  u8 Done = 0
  Rearm
  wait
  nmi off
  screen on
  while Done = 0
    Frame1
    In = PadBits(1) | PadBits(2)
    In = In & 16
    if In = 0 and Was > 0 then
      if Idle > 10 then Done = 1
    end if
    if In > 0 and Was = 0 then Idle = 11
    Was = In
    inc Idle
    if Idle > 1800 then Done = 1
  end while
  return
end sub

' a strip of field cells, columns 2-29, screen rows Y and Y + 1
sub FieldStrip(u8 Y):
  FieldRow(Y)
  W = Y + 1
  FieldRow(W)
  return
end sub

sub HowToPlay:
  u8 K = 0
  u8 C = 0
  ' page 1: the goal
  NewScreen
  print at 9,1, "HOW TO PLAY (1/3)"
  print at 2,3, "YOU COMMAND THREE WHITE"
  print at 2,4, "TANKS. THE ENEMY HAS THREE"
  print at 2,5, "YELLOW ONES (THE COMPUTER"
  print at 2,6, "OR PLAYER 2)."
  print at 2,8, "DESTROY ALL THREE ENEMY"
  print at 2,9, "TANKS TO WIN!"
  FieldStrip(12)
  FieldStrip(14)
  set sprite 2 to 95,48,STkR,15
  set sprite 3 to 111,64,STkU,15
  set sprite 4 to 95,192,STkL,11
  set sprite 5 to 111,176,STkD,11
  update sprites
  print at 2,18, "TANKS MOVE ON THE GREEN"
  print at 2,19, "SQUARES."
  print at 6,22, "BUTTON: NEXT PAGE"
  PageWait
  ' page 2: writing orders
  NewScreen
  print at 9,1, "HOW TO PLAY (2/3)"
  print at 2,3, "EACH ROUND YOU WRITE TEN"
  print at 2,4, "SECRET ORDERS:"
  print at 2,6, "UP/DOWN    PICK A TANK"
  print at 2,7, "           (IT BLINKS)"
  print at 2,8, "LEFT/RIGHT PICK AN ORDER"
  print at 2,9, "BUTTON     WRITE IT DOWN"
  for K = 0 to 4
    C = 5 + K * 5
    T0 = K * 2 + TML
    put char T0 at C,11
  next
  print at 4,12, "TURN TURN MOVE FIRE TAKE"
  print at 4,13, "LEFT RIGHT ONE"
  print at 24,13, "BACK"
  put char TP1 at 2,16
  for K = 0 to 9
    C = K * 2 + 4
    if K < 4 then put char THide at C,16 else put char TSlot at C,16
  next
  print at 2,18, "ORDERS STAY HIDDEN (GREY)"
  print at 2,19, "SO THE ENEMY CAN'T PEEK."
  print at 6,22, "BUTTON: NEXT PAGE"
  PageWait
  ' page 3: the battle
  NewScreen
  print at 9,1, "HOW TO PLAY (3/3)"
  print at 2,3, "THEN THE ORDERS RUN: ONE"
  print at 2,4, "WHITE, ONE YELLOW, IN TURN."
  print at 2,6, "A SHELL DESTROYS THE FIRST"
  print at 2,7, "TANK IN ITS WAY - EVEN ONE"
  print at 2,8, "OF YOURS!"
  print at 2,9, "TWO TANKS THAT CRASH ARE"
  print at 2,10, "BOTH DESTROYED. A WALL"
  print at 2,11, "JUST STOPS A TANK."
  FieldStrip(13)
  set sprite 2 to 103,48,STkR,15
  set sprite 0 to 103,112,SShell,15
  set sprite 1 to 103,176,SBoom2,9
  update sprites
  print at 2,17, "TIP: THINK AHEAD! GUESS"
  print at 2,18, "WHERE THE ENEMY WILL MOVE"
  print at 2,19, "AND AIM THERE."
  print at 6,22, "BUTTON: BACK TO TITLE"
  PageWait
  HideSprites
  return
end sub

sub TitlePage:
  u8 Tr = 0
  u8 Ty = 0
  u8 In = 0
  u8 Go = 0
  NewScreen
  for Tr = 0 to 4
    Ty = Tr + 2
    NumU = Tr * 28
    put Logo + NumU count 28 at 2,Ty
  next
  for Tr = 5 to 9
    Ty = Tr + 3
    NumU = Tr * 28
    put Logo + NumU count 28 at 2,Ty
  next
  print at 10,13, "BY FRED KARG"
  print at 4,14, "COMPUTE!'S GAZETTE 4/1990"
  print at 4,20, "STICK: CHOOSE  FIRE: GO"
  Menu = Players - 1
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 450
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasFire = 16
  WasStick = 15
  while Go = 0
    Frame1
    V = Rnd
    In = PadBits(1) | PadBits(2)
    W = In & 3
    if W > 0 then
      if WasStick = 0 then
        if W & 1 then
          if Menu = 0 then Menu = 2 else dec Menu
        else
          if Menu = 2 then Menu = 0 else inc Menu
        end if
        play sound SndClick
        ShowMenu
      end if
    end if
    WasStick = W
    W = In & 16
    if W > 0 then
      if WasFire = 0 then Go = 1
    end if
    WasFire = W
  end while
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu < 2 then Players = Menu + 1
  Rearm
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 10,2, "THINK TANK"
  print at 2,4, "BY FRED KARG, COMPUTE!'S"
  print at 2,5, "GAZETTE, APRIL 1990 (C64)."
  print at 2,6, "A COLECOVISION PORT."
  print at 2,8, "TWO COMMANDERS, THREE TANKS"
  print at 2,9, "EACH. WRITE TEN SECRET"
  print at 2,10, "ORDERS - TURN LEFT, TURN"
  print at 2,11, "RIGHT, MOVE, FIRE - THEN"
  print at 2,12, "WATCH THEM RUN, ONE ORDER"
  print at 2,13, "OF EACH SIDE A STEP. WIPE"
  print at 2,14, "OUT THE ENEMY TO WIN."
  print at 2,17, "MADE FOR THE COLECOVISION BY"
  print at 2,18, "CLAUDE (AN AI MADE BY"
  print at 2,19, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,20, "2026, IN AMY BY AMY BIENVENU"
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub
