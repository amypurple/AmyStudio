asm {
TtClr:
    xor a
    ld (NMI_FLAG),a
    ret
TtPoll:
    ld a,(NMI_FLAG)
    or a
    jr z,TtPoll
    ret
TtClick:
    db $40,$38,$50,$01,$50
TtEnter:
    db $40,$5D,$40,$02,$40,$46,$50,$02,$50
TtUndo:
    db $40,$8C,$40,$02,$40,$BA,$50,$02,$50
TtTurn:
    db $40,$75,$51,$02,$40,$49,$61,$02,$50
TtRumble:
