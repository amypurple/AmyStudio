' THE CARD PARLOUR
' Two card games from Tim Hartnell's Giant Book of Computer Games
' (Ballantine Books, 1984; Interface Publications, 1983), for the
' ColecoVision in Amy by Amy Bienvenu.
'
' INNER SPRING: you have $20. The house shows two cards (numbers 1 to 13,
' 2 to 6 apart, as the book deals them), then you bet that its next card
' (never the same as either) lies between them. A win pays twice the bet;
' broke, the game is over.
' MADAME ZARA READS THE CARDS: she asks your name and birthday, tells your
' star sign, turns up four cards of the Hartnell Arcana (Anchor, Tower,
' Elvling, Knave, Cleric or Sovereign of Stars, Stones, Shadows, Gems, Dust
' or Echoes) and reads your fortune: one sentence from each of her four
' lists of ten, the book's own forty.
'
' Controls (either joystick): INNER SPRING: up and down change the bet by
' 1, left and right by 5; the button turns the card. ZARA: up and down
' change a letter or a number, left and right move along your name, the
' button goes on. The second button leaves. Keypad not used.
'
' Liberties taken:
' - INNER SPRING: the book's numbers are shown as playing cards (1 is the
'   ace, 11-13 jack, queen, king), with suits for show. A bet of $0 is
'   allowed (you just watch).
' - ZARA: the listing's ARIES starts on 3/32 (332), leaving 3/22-3/31 with
'   no sign; here Aries starts on 3/22, where Pisces ends. Your name has
'   up to 8 letters, picked with the stick.
' - The cards, Zara's crystal ball and her curtain are drawn; new music
'   (The Hartnell Arcana) and sounds.
'
' House rules kept: text in columns 2-29 and rows 1-22; one sprite (the
' pointer); every screen is drawn with the NMI off after a wait.

const TRk0 = 128
const TRk1 = 129
const TRk2 = 130
const TRk3 = 131
const TRk4 = 132
const TRk5 = 133
const TRk6 = 134
const TRk7 = 135
const TRk8 = 136
const TRk9 = 137
const TRk10 = 138
const TRk11 = 139
const TRk12 = 140
const TRr0 = 141
const TRr1 = 142
const TRr2 = 143
const TRr3 = 144
const TRr4 = 145
const TRr5 = 146
const TRr6 = 147
const TRr7 = 148
const TRr8 = 149
const TRr9 = 150
const TRr10 = 151
const TRr11 = 152
const TRr12 = 153
const TSs0 = 154
const TSs1 = 155
const TSs2 = 156
const TSs3 = 157
const TPipa00 = 158
const TPipa01 = 159
const TPipa10 = 160
const TPipa11 = 161
const TPipb00 = 162
const TPipb01 = 163
const TPipb10 = 164
const TPipb11 = 165
const TPipc00 = 166
const TPipc01 = 167
const TPipc10 = 168
const TPipc11 = 169
const TPipd00 = 170
const TPipd01 = 171
const TPipd10 = 172
const TPipd11 = 173
const TEtl = 174
const TEtr = 175
const TEl = 176
const TEr = 177
const TEbl = 178
const TEbr = 179
const TFelt = 180
const TBack00 = 181
const TBack01 = 182
const TBack02 = 183
const TBack03 = 184
const TBack10 = 185
const TBack11 = 186
const TBack12 = 187
const TBack13 = 188
const TBack20 = 189
const TBack21 = 190
const TBack22 = 191
const TBack23 = 192
const TFanchor00 = 193
const TFanchor01 = 194
const TFanchor10 = 195
const TFanchor11 = 196
const TFtower00 = 197
const TFtower01 = 198
const TFtower10 = 199
const TFtower11 = 200
const TFelvling00 = 201
const TFelvling01 = 202
const TFelvling10 = 203
const TFelvling11 = 204
const TFknave00 = 205
const TFknave01 = 206
const TFknave10 = 207
const TFknave11 = 208
const TFcleric00 = 209
const TFcleric01 = 210
const TFcleric10 = 211
const TFcleric11 = 212
const TFsovereign00 = 213
const TFsovereign01 = 214
const TFsovereign10 = 215
const TFsovereign11 = 216
const TSstars = 217
const TSstones = 218
const TSshadows = 219
const TSgems = 220
const TSdust = 221
const TSechoes = 222
const TEt = 223
const TEb = 224
const TBall00 = 225
const TBall01 = 226
const TBall02 = 227
const TBall03 = 228
const TBall04 = 229
const TBall05 = 230
const TBall10 = 231
const TBall11 = 232
const TBall12 = 233
const TBall13 = 234
const TBall14 = 235
const TBall15 = 236
const TBall20 = 237
const TBall21 = 238
const TBall22 = 239
const TBall23 = 240
const TBall24 = 241
const TBall25 = 242
const TBall30 = 243
const TBall31 = 244
const TBall32 = 245
const TBall33 = 246
const TBall34 = 247
const TBall35 = 248
const TBall40 = 249
const TBall41 = 250
const TBall42 = 251
const TBall43 = 252
const TBall44 = 253
const TBall45 = 254
const TFringe = 255
const SArrow = 0
const NTiles8 = 1024
const SprBytes = 32
const SndDeal = 1
const SndFlip = 2
const SndClick = 3
const SndWin = 4
const SndLose = 5
const SndChime = 6
const SndMystic = 7
const SndTuneA = 8
const SndTuneB = 9

' the first day of each sign, by month: the sign before it fills the
' month's start (CAPRICORN 12/23-1/20, AQUARIUS 1/21-2/19...)
' the font has no dollar sign: one is drawn over '$'
data Dollar bytes $10,$7C,$90,$7C,$12,$7C,$10,$00
data SignDay bytes 0, 21, 20, 22, 21, 22, 22, 24, 24, 24, 24, 23, 23

u16 Cash = 20
u16 Bet = 0
u8 NA = 0
u8 NB = 0
u8 NC = 0
u8 Mo = 1
u8 Dy = 1
u8 Sign = 0
u8 Name[8]
u8 Pos = 0
u8 Fig = 0
u8 Suit = 0
' a card to draw: column, row, rank 0-12, suit 0-3
u8 Dx = 0
u8 Dyy = 0
u8 Dr = 0
u8 Ds = 0

' scratch
u16 Uw = 0
u16 Off16 = 0
u16 NumU = 0
u16 Rs = $3D19
u16 Rt = 0
u8 Rb = 0
u8 Ja = 0
u8 Ka = 0
u8 Np = 0
u8 Res = 0

' input and menus
u8 Menu = 0
u8 Mode = 0
u8 Stage = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table CpSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 2 then
    RulesPage
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  if Menu = 1 then goto zara

' ---------------------------------------------------------------------------
' INNER SPRING

  Cash = 20
  Bet = 0
  FeltScreen
is_round:
  Mode = 1
  ' the book: two numbers 2 to 6 apart, a third that is neither
  Rnd13
  NA = V
is_b:
  Rnd13
  NB = V
  if NA > NB then
    W = NA - NB
  else
    W = NB - NA
  end if
  if W < 2 then goto is_b
  if W > 6 then goto is_b
is_c:
  Rnd13
  NC = V
  if NC = NA then goto is_c
  if NC = NB then goto is_c
  ' the cards
  play sound SndDeal
  Dx = 4
  Dyy = 6
  Dr = NA - 1
  RndSuit
  DrawCard
  Pause
  play sound SndDeal
  Dx = 24
  Dr = NB - 1
  RndSuit
  DrawCard
  Pause
  play sound SndDeal
  Dx = 14
  DrawBack
  Say
  print at 2,13, "MY FIRST NUMBER IS"
  NumU = NA
  print at 21,13, width$(NumU, 2)
  print at 2,14, "MY SECOND IS"
  NumU = NB
  print at 15,14, width$(NumU, 2)
  print at 2,16, "YOU HAVE $"
  NumU = Cash
  print at 12,16, width$(NumU, 4)
  print at 2,18, "HOW MUCH DO YOU BET MY NEXT"
  print at 2,19, "NUMBER LIES BETWEEN"
  NumU = NA
  print at 22,19, width$(NumU, 2)
  print at 25,19, "AND"
  NumU = NB
  print at 2,20, width$(NumU, 2)
  print at 4,20, "?   $"
  if Bet > Cash then Bet = Cash
  Stage = 1
  WasBtn = 1
  WasBtn2 = 1
is_bet:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Bet < Cash then inc Bet
    end if
    if Dn1 = 1 then
      if Bet > 0 then dec Bet
    end if
    if Rt1 = 1 then
      Bet = Bet + 5
      if Bet > Cash then Bet = Cash
    end if
    if Lf1 = 1 then
      if Bet > 5 then
        Bet = Bet - 5
      else
        Bet = 0
      end if
    end if
    play sound SndClick
  end if
  NumU = Bet
  print at 10,20, width$(NumU, 4)
  if Press2 = 1 then
    Stage = 0
    goto title
  end if
  if Press = 0 then goto is_bet
  Stage = 0
  ' the book: D = D - E; then 3 E back on a win
  Cash = Cash - Bet
  play sound SndFlip
  Dx = 14
  Dr = NC - 1
  RndSuit
  DrawCard
  Say
  print at 2,13, "MY NUMBER WAS"
  NumU = NC
  print at 16,13, width$(NumU, 2)
  V = 0
  if NC > NA then
    if NC < NB then V = 1
  end if
  if NC < NA then
    if NC > NB then V = 1
  end if
  if V = 1 then
    Uw = Bet << 1
    print at 2,15, "WELL DONE, YOU WIN $"
    NumU = Uw
    print at 22,15, width$(NumU, 4)
    Uw = Uw + Bet
    Cash = Cash + Uw
    if Bet > 0 then play sound SndWin
  else
    print at 2,15, "SORRY, YOU LOSE $"
    NumU = Bet
    print at 19,15, width$(NumU, 4)
    if Bet > 0 then play sound SndLose
  end if
  print at 2,17, "YOU HAVE $"
  NumU = Cash
  print at 12,17, width$(NumU, 4)
  Pause
  Pause
  Pause
  if Cash >= 1 then
    ClearTable
    goto is_round
  end if
  Say
  print at 2,13, "THE GAME IS OVER"
  print at 2,15, "YOU ARE BROKE!"
  print at 2,17, "THANKS FOR THE GAME"
  Mode = 0
  goto the_end

' ---------------------------------------------------------------------------
' MADAME ZARA READS THE CARDS

zara:
  ZaraScreen
  Mode = 1
  ' the flashy start
  play sound SndMystic
  for K = 1 to 6
    Say
    print at 2,13, "MADAME ZARA READS THE STARS"
    V = K & 1
    if V = 0 then print at 8,15, "...FOR YOU..."
    for J = 1 to 20
      Frame1
    next
  next
  Say
  print at 2,13, "WHAT IS YOUR NAME, MY DEAR?"
  NameEntry
  if Res = 1 then goto title
  Say
  print at 2,13, "WELCOME"
  put Name at 10,13
  print at 2,14, "TO ZARA'S HOUSE OF MYSTICISM"
  print at 2,15, "...WHERE THE VEIL OVER THE"
  print at 2,16, "FUTURE IS MOVED BACK..."
  print at 2,17, "...JUST FOR A MOMENT"
  Pause
  Pause
  Say
  print at 2,13, "PLEASE TELL ME WHEN YOU WERE"
  print at 2,14, "BORN... THE MONTH FIRST"
  Mo = 1
  NumberEntry
  if Res = 1 then goto title
  Say
  print at 2,13, "THANK YOU,"
  put Name at 13,13
  print at 2,14, "NOW WHAT DAY OF THE MONTH"
  print at 2,15, "WERE YOU BORN?"
  Mo = Mo + 100
  NumberEntry
  if Res = 1 then goto title
  ' the sign
  FindSign
  Say
  put Name at 2,13
  print at 11,13, ", YOU WERE"
  print at 2,14, "BORN UNDER THE SIGN OF"
  SignName
  play sound SndChime
  Pause
  Pause
  Say
  print at 2,13, "NOW I SHALL GAZE INTO THE"
  print at 2,14, "FUTURE..."
  Gaze
  Say
  print at 2,13, "I AM TURNING UP THE CARDS"
  print at 2,14, "FROM THE HARTNELL ARCANA..."
  Pause
  for K = 0 to 3
    V = K * 7
    Dx = V + 2
    Dyy = 8
    ArcanaBack
  next
  Pause
  for K = 0 to 3
    ' a figure, a suit (the book: two separate draws)
    Rnd
    Uw = Rb
    Uw = Uw * 6
    Uw = Uw >> 8
    Fig = Uw
    Rnd
    Uw = Rb
    Uw = Uw * 6
    Uw = Uw >> 8
    Suit = Uw
    V = K * 7
    Dx = V + 2
    Dyy = 8
    play sound SndFlip
    ArcanaCard
    Say
    print at 2,13, "THIS IS THE"
    CardName
    Pause
  next
  Say
  print at 2,13, "AND THESE CARDS TELL ME..."
  play sound SndMystic
  Pause
  Say
  for K = 0 to 3
    ' list K (A$, B$, C$, D$): one of its ten, sentence 4t + K of the 40
    Rnd
    Uw = Rb
    Uw = Uw * 10
    Uw = Uw >> 8
    V = Uw
    V = V << 2
    V = V + K
    Off16 = V
    Off16 = Off16 * 56
    V = K << 1
    Y = V + 13
    Uw = Y
    Uw = Uw << 5
    Uw = Uw + 2
    copy Fortunes + Off16 count 28 to vram.name + Uw
    Off16 = Off16 + 28
    Uw = Uw + 32
    copy Fortunes + Off16 count 28 to vram.name + Uw
    play sound SndChime
    Pause
  next
  Pause
  Pause
  Say
  print at 2,13, "THANK YOU FOR CONSULTING THE"
  print at 2,14, "WISDOM OF ZARA..."
  print at 2,16, "I WOULD LIKE TO SEE YOU"
  print at 2,17, "AGAIN SOME TIME,"
  put Name at 19,17
  Mode = 0

the_end:
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
te_wait:
  Frame1
  ReadPad
  if Press = 1 then goto title
  if Press2 = 1 then goto title
  goto te_wait

' ---------------------------------------------------------------------------
' Cards

' DrawCard: playing card Dr (0-12) of suit Ds at Dx, Dyy (4 x 3 tiles)
sub DrawCard:
  put char TEtl at Dx,Dyy
  X = Dx + 1
  V = TRk0 + Dr
  if Ds < 2 then V = TRr0 + Dr
  put char V at X,Dyy
  inc X
  V = TSs0 + Ds
  put char V at X,Dyy
  inc X
  put char TEtr at X,Dyy
  Np = Ds * 4
  Np = Np + TPipa00
  Y = Dyy + 1
  put char TEl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char TEr at X,Y
  inc Np
  inc Y
  put char TEbl at Dx,Y
  X = Dx + 1
  put char Np at X,Y
  inc Np
  inc X
  put char Np at X,Y
  inc X
  put char TEbr at X,Y
  return
end sub

' DrawBack: a card's back at Dx, Dyy (4 x 3)
sub DrawBack:
  for Ja = 0 to 2
    Y = Dyy + Ja
    V = Ja * 4
    V = V + TBack00
    for Ka = 0 to 3
      X = Dx + Ka
      put char V at X,Y
      inc V
    next
  next
  return
end sub

sub ClearTable:
  for Y = 6 to 8
    fill TFelt count 28 at 2,Y
  next
  return
end sub

' ArcanaBack: the back of an Arcana card at Dx, Dyy (4 x 4: the playing
' card back and a row of its pattern)
sub ArcanaBack:
  Dyy = Dyy + 1
  DrawBack
  Dyy = Dyy - 1
  V = TBack00
  for Ka = 0 to 3
    X = Dx + Ka
    put char V at X,Dyy
    inc V
  next
  return
end sub

' ArcanaCard: figure Fig of suit Suit at Dx, Dyy (4 x 4 tiles)
sub ArcanaCard:
  V = TSstars + Suit
  put char TEtl at Dx,Dyy
  X = Dx + 1
  put char V at X,Dyy
  inc X
  put char V at X,Dyy
  inc X
  put char TEtr at X,Dyy
  Np = Fig * 4
  Np = Np + TFanchor00
  for Ja = 1 to 2
    Y = Dyy + Ja
    put char TEl at Dx,Y
    X = Dx + 1
    put char Np at X,Y
    inc Np
    inc X
    put char Np at X,Y
    inc Np
    inc X
    put char TEr at X,Y
  next
  Y = Dyy + 3
  put char TEbl at Dx,Y
  X = Dx + 1
  put char TEb at X,Y
  inc X
  put char TEb at X,Y
  inc X
  put char TEbr at X,Y
  return
end sub

sub CardName:
  if Fig = 0 then print at 14,13, "ANCHOR"
  if Fig = 1 then print at 14,13, "TOWER"
  if Fig = 2 then print at 14,13, "ELVLING"
  if Fig = 3 then print at 14,13, "KNAVE"
  if Fig = 4 then print at 14,13, "CLERIC"
  if Fig = 5 then print at 14,13, "SOVEREIGN"
  if Suit = 0 then print at 2,14, "OF STARS"
  if Suit = 1 then print at 2,14, "OF STONES"
  if Suit = 2 then print at 2,14, "OF SHADOWS"
  if Suit = 3 then print at 2,14, "OF GEMS"
  if Suit = 4 then print at 2,14, "OF DUST"
  if Suit = 5 then print at 2,14, "OF ECHOES"
  return
end sub

' Rnd13: V = a number 1 to 13
sub Rnd13:
  Rnd
  Uw = Rb
  Uw = Uw * 13
  Uw = Uw >> 8
  V = Uw
  V = V + 1
  return
end sub

sub RndSuit:
  Rnd
  Ds = Rb & 3
  return
end sub

' ---------------------------------------------------------------------------
' Zara

' NameEntry: up to 8 letters; up/down change the letter, left/right move,
' the button finishes (Res 0), the second button leaves (Res 1)
sub NameEntry:
  for Pos = 0 to 7
    Name[Pos] = 32
  next
  Name[0] = 65
  Pos = 0
  Stage = 1
  WasBtn = 1
  WasBtn2 = 1
ne_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    V = Name[Pos]
    if Up1 = 1 then
      if V = 32 then
        V = 65
      else
        inc V
        if V > 90 then V = 32
      end if
    end if
    if Dn1 = 1 then
      if V = 32 then
        V = 90
      else
        dec V
        if V < 65 then V = 32
      end if
    end if
    Name[Pos] = V
    if Rt1 = 1 then
      if Pos < 7 then
        inc Pos
        V = Name[Pos]
        if V = 32 then Name[Pos] = 65
      end if
    end if
    if Lf1 = 1 then
      if Pos > 0 then dec Pos
    end if
    play sound SndClick
  end if
  put Name at 11,16
  ' the pointer under the letter being changed
  V = Pos << 3
  V = V + 84
  set sprite 0 to 134, V, SArrow, 11
  update sprites
  if Press2 = 1 then
    Res = 1
    Stage = 0
    return
  end if
  if Press = 0 then goto ne_loop
  set sprite 0 to 192, 0, 0, 0
  update sprites
  Res = 0
  Stage = 0
  return
end sub

' NumberEntry: the month (Mo 1-12) or, with Mo + 100 on entry, the day
' (Dy 1-31) with up and down; the button goes on
sub NumberEntry:
  Ka = 0
  if Mo > 100 then
    Mo = Mo - 100
    Ka = 1
  end if
  Stage = 1
  WasBtn = 1
  WasBtn2 = 1
nu_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Ka = 0 then
      if Up1 = 1 then
        if Mo < 12 then inc Mo
      end if
      if Dn1 = 1 then
        if Mo > 1 then dec Mo
      end if
    else
      if Up1 = 1 then
        if Dy < 31 then inc Dy
      end if
      if Dn1 = 1 then
        if Dy > 1 then dec Dy
      end if
    end if
    play sound SndClick
  end if
  if Ka = 0 then
    print at 2,16, "MONTH:"
    NumU = Mo
    print at 9,16, width$(NumU, 2)
    MonthName
  else
    print at 2,17, "DAY:"
    NumU = Dy
    print at 9,17, width$(NumU, 2)
  end if
  if Press2 = 1 then
    Res = 1
    Stage = 0
    return
  end if
  if Press = 0 then goto nu_loop
  Res = 0
  Stage = 0
  return
end sub

sub MonthName:
  print at 12,16, "         "
  if Mo = 1 then print at 12,16, "JANUARY"
  if Mo = 2 then print at 12,16, "FEBRUARY"
  if Mo = 3 then print at 12,16, "MARCH"
  if Mo = 4 then print at 12,16, "APRIL"
  if Mo = 5 then print at 12,16, "MAY"
  if Mo = 6 then print at 12,16, "JUNE"
  if Mo = 7 then print at 12,16, "JULY"
  if Mo = 8 then print at 12,16, "AUGUST"
  if Mo = 9 then print at 12,16, "SEPTEMBER"
  if Mo = 10 then print at 12,16, "OCTOBER"
  if Mo = 11 then print at 12,16, "NOVEMBER"
  if Mo = 12 then print at 12,16, "DECEMBER"
  return
end sub

' FindSign: Sign 0-11 from Capricorn: the month's sign changes on SignDay
sub FindSign:
  ' signs by the month they end in: January ends Capricorn (0)
  Sign = Mo - 1
  V = SignDay[Mo]
  if Dy >= V then
    inc Sign
    if Sign = 12 then Sign = 0
  end if
  return
end sub

sub SignName:
  if Sign = 0 then print at 2,15, "CAPRICORN"
  if Sign = 1 then print at 2,15, "AQUARIUS"
  if Sign = 2 then print at 2,15, "PISCES"
  if Sign = 3 then print at 2,15, "ARIES"
  if Sign = 4 then print at 2,15, "TAURUS"
  if Sign = 5 then print at 2,15, "GEMINI"
  if Sign = 6 then print at 2,15, "CANCER"
  if Sign = 7 then print at 2,15, "LEO"
  if Sign = 8 then print at 2,15, "VIRGO"
  if Sign = 9 then print at 2,15, "LIBRA"
  if Sign = 10 then print at 2,15, "SCORPIO"
  if Sign = 11 then print at 2,15, "SAGITTARIUS"
  return
end sub

' Gaze: the crystal ball's glass shimmers (its blue tiles' colours change)
sub Gaze:
  for J = 1 to 90
    Frame1
    V = J & 7
    if V = 0 then
      V = J & 8
      W = $45
      if V > 0 then W = $5D
      ' the ball's middle row of tiles (codes TBall00 + 6 to + 11)
      Uw = TBall00 + 6
      Uw = Uw << 3
      fill W count 48 to vram.color + Uw
    end if
  next
  ' its colours as drawn
  Uw = TBall00 + 6
  Uw = Uw << 3
  Off16 = TBall00 - 122
  Off16 = Off16 << 3
  copy TileCol + Off16 count 48 to vram.color + Uw
  return
end sub

' ---------------------------------------------------------------------------
' Screens and helpers

' Say: rows 13-21 cleared
sub Say:
  for Y = 13 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

sub FeltScreen:
  NewScreen
  for Y = 1 to 22
    fill TFelt count 32 at 0,Y
  next
  print at 2,2, "INNER SPRING"
  for Y = 13 to 21
    fill 32 count 28 at 2,Y
  next
  ShowScreen
  return
end sub

sub ZaraScreen:
  NewScreen
  backdrop dark blue
  fill TFringe count 32 at 0,0
  print at 2,2, "MADAME ZARA"
  ' the crystal ball, 6 x 5 tiles
  V = TBall00
  for Y = 3 to 7
    for X = 13 to 18
      put char V at X,Y
      inc V
    next
  next
  ShowScreen
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  sprites stable 0 to 0
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop dark blue
  fill TFringe count 32 at 0,0
  print at 8,2, "THE CARD PARLOUR"
  ' two playing cards and an Arcana card
  Dx = 4
  Dyy = 5
  Dr = 0
  Ds = 2
  DrawCard
  Dx = 9
  Dr = 12
  Ds = 0
  DrawCard
  Dx = 20
  Dyy = 4
  Fig = 5
  Suit = 0
  ArcanaCard
  print at 8,12, "INNER SPRING"
  print at 8,13, "MADAME ZARA"
  print at 8,14, "HOW TO PLAY"
  print at 8,15, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 3 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 12 to 15
    print at 6,I, " "
  next
  Y = Menu + 12
  print at 6,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub PageScreen:
  NewScreen
  backdrop black
  return
end sub

sub RulesPage:
  PageScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "INNER SPRING: YOU HAVE $20."
  print at 2,4, "I SHOW TWO CARDS; BET THAT"
  print at 2,5, "MY NEXT ONE LIES BETWEEN"
  print at 2,6, "THEM. A WIN PAYS TWICE THE"
  print at 2,7, "BET. UP, DOWN: BET 1; LEFT,"
  print at 2,8, "RIGHT: BET 5. BUTTON: TURN."
  print at 2,10, "MADAME ZARA READS THE CARDS:"
  print at 2,11, "YOUR NAME (UP, DOWN CHANGE A"
  print at 2,12, "LETTER, LEFT, RIGHT MOVE),"
  print at 2,13, "YOUR BIRTHDAY, YOUR SIGN,"
  print at 2,14, "FOUR CARDS OF THE HARTNELL"
  print at 2,15, "ARCANA, AND YOUR FORTUNE."
  print at 2,17, "2ND BUTTON: LEAVE"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  PageScreen
  print at 7,1, "THE CARD PARLOUR"
  print at 2,3, "INNER SPRING AND MADAME"
  print at 2,4, "ZARA READS THE CARDS FROM"
  print at 2,5, "TIM HARTNELL'S GIANT BOOK"
  print at 2,6, "OF COMPUTER GAMES"
  print at 2,7, "(BALLANTINE BOOKS, 1984;"
  print at 2,8, "INTERFACE PUBLICATIONS,"
  print at 2,9, "1983)."
  print at 2,11, "PLAYING CARDS FROM CASINO"
  print at 2,12, "BLACKJACK. MUSIC: THE"
  print at 2,13, "HARTNELL ARCANA (ORIGINAL)."
  print at 2,15, "COLECOVISION VERSION BY"
  print at 2,16, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

