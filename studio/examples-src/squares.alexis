cartridge "SQUARES/COMPUTE!'S GAZETTE/1985"

' SQUARES
' A ColecoVision game based on "Squares", COMPUTE!'s Gazette, June 1985
' (Commodore 64, BASIC; disk 1985-06). No author is named in the listing
' or on the disk.
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: four snakes crawl over a grid of dots, drawing lines. Whoever
' draws the fourth side of a square fills it and scores it. You don't steer
' a snake move by move: you PROGRAM it. A snake looks at the dot it is on
' and which of its four sides already have lines (16 possible situations);
' the first time it meets a situation it asks you WHICH WAY?, and from then
' on it always goes that way in that situation by itself. Each turn a snake
' makes up to 10 moves on its rules; meeting a new situation (and answering
' it) ends its turn. A rule that leads off the board gives ILLEGAL MOVE
' and is asked again. The game ends when, in one round, every snake comes
' back to the dot it started its turn on with nothing changed around it
' (all snakes are going round in circles). The most squares wins.
'
' From the original (orig/squares.bas, lines in brackets): 15 x 10 dots
' (80); four snakes, each player or computer (560-620), start dots at
' random (60); rules IN(SI,PL) for the 16 situations SI (bit per side with
' a line: 1 up, 2 right, 4 down, 8 left; 150, 380-400), asked on first use
' (290-330); up to 10 moves a turn (250-260), an answer ends the turn
' (Q=10); ILLEGAL MOVE when the target is not a dot (500-510); a square is
' scored when its four sides are lines and it is empty, on both sides of
' the line just drawn (210-220, 410-460); the turn's loop test (240) and
' game over when every snake loops in the same round (270, 640); the
' computer picks a random side without a line, a random side when all four
' have lines or after 4 such picks in a turn (340-370); GAME OVER! and
' PLAYER n .... n SQUARES (650-670).
'
' Liberties:
' - 14 x 10 dots instead of 15 x 10: 15 dots two tiles apart need 29
'   columns and only columns 2-29 are safe on a TV (13 x 9 = 117 squares
'   instead of 126).
' - The game also ends when three rounds in a row draw no new line, or when
'   every square is filled: in the listing a snake going round a loop longer
'   than its 10-move turn never counts as looping, so a game could run for
'   ever.
' - Start dots are four different dots (the listing could put two snakes on
'   one dot).
' - Snake 3's colour is light green and snake 4's dark yellow (the C64's
'   dark grey and brown would be lost against the grey dots).
' - The joystick replaces the I/J/K/M keys; snake types are picked on a
'   joystick menu; no ANOTHER GAME? question (house rule: a press goes back
'   to the title). Snake heads are sprites that slide from dot to dot;
'   sounds, a title tune and a credits page are new.
'
' Controls: either controller; the stick answers WHICH WAY?, the stick and
' a button drive the menus. Keypad not used.
'
' House rules: tiles, text and sprites in columns 2-29, rows 1-22; tiles
' from 128; screens drawn with the NMI off after a wait, display off; music
' first in the sound table, the title tune plays once; nothing flashes
' faster than 2 Hz; `set sprite count` always given.

const TDot = 128
const TH1 = 129
const TH2 = 130
const TH3 = 131
const TH4 = 132
const TV1 = 133
const TV2 = 134
const TV3 = 135
const TV4 = 136
const TB1 = 137
const TB2 = 138
const TB3 = 139
const TB4 = 140
const TRule = 141
const SHead = 0
const NTiles8 = 112
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndBox = 4
const SndBad = 5
const SndAsk = 6
const SndTurn = 7
const SndMove = 8
const SndOver = 9
const LogoN = 76
data LogoXY bytes 2,3,1,3,3,1,4,3,1,2,4,1,2,5,1,3,5,1,4,5,1,4,6,1,2,7,1,3,7,1,4,7,1,6,3,2,7,3,2,8,3,2,6,4,2,8,4,2,6,5,2,8,5,2,6,6,2,7,6,2,8,6,2,8,7,2,10,3,3,12,3,3,10,4,3,12,4,3,10,5,3,12,5,3,10,6,3,12,6,3,10,7,3,11,7,3,12,7,3,14,3,4,15,3,4,16,3,4,14,4,4,16,4,4,14,5,4,15,5,4,16,5,4,14,6,4,16,6,4,14,7,4,16,7,4,18,3,1,19,3,1,18,4,1,20,4,1,18,5,1,19,5,1,18,6,1,20,6,1,18,7,1,20,7,1,22,3,2,23,3,2,24,3,2,22,4,2,22,5,2,23,5,2,22,6,2,22,7,2,23,7,2,24,7,2,26,3,3,27,3,3,28,3,3,26,4,3,26,5,3,27,5,3,28,5,3,28,6,3,26,7,3,27,7,3,28,7,3
const NSpr = 4
const NDot = 140
const VBase = 130
const NBox = 117
const MaxQ = 9
const StepF = 3
const MenuY = 12
data SnCol bytes 7,13,3,10

record Snake:
  u8 Pos
  u8 Kind
  u8 Sc
  u8 Px
  u8 Py
end record

Snake Sn[4]
' every line (130 across, then 126 down): 0 none, else the snake that drew it last
u8 Ed[256]
' every square: 0 empty, else the snake that closed it
u8 Bf[117]
' the rules: Rule[Si * 4 + snake] = 0 not taught yet, else direction + 1
u8 Rule[64]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 12345
u16 W16 = 0
u16 NumU = 0
u16 MoveN = 0
u8 AskN = 0
u8 LastD = 0
u8 Pl = 0
u8 P = 0
u8 P1 = 0
u8 P2 = 0
u8 Si = 0
u8 D = 0
u8 Q = 0
u8 Fl = 0
u8 Lf = 0
u8 Qf = 0
u8 NewEd = 0
u8 Dry = 0
u8 Filled = 0
u8 Rounds = 0
u8 Why = 0
u8 Ph = 0
u8 Over = 0
u8 TitleOn = 0
u8 Menu = 0
u8 Blink = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 Held = 0
u8 Tick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Li = 0
u8 Hi = 0
u8 Si2 = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SqSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  Sn[0].Kind = 0
  Sn[1].Kind = 1
  Sn[2].Kind = 1
  Sn[3].Kind = 1
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 5 then
    HowToPlay
    goto title
  end if
  NewGame

' 100-280: a round, each snake in turn
round:
  Qf = 1
  NewEd = 0
  Pl = 0
next_snake:
  Turn
  if Lf = 0 then Qf = 0
  inc Pl
  if Pl < 4 then goto next_snake
  inc Rounds
  ' 640: game over when every snake looped this round
  Why = 0
  if Qf = 1 then Why = 1
  if NewEd = 0 then
    inc Dry
  else
    Dry = 0
  end if
  if Dry >= 3 then Why = 2
  if Filled >= NBox then Why = 3
  if Why = 0 then goto round

  ' 650-670: the end
  Over = 1
  Ph = 9
  Hold(60)
  EndScreen
  play sound SndOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' a pseudo-random byte (16-bit xorshift)
function Rnd() as u8
  u8 Lo = 0
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  Lo = lowbyte(Rs)
  return Lo

' 380-400: the situation at dot Pd: a bit for each side with a line
function Sit(u8 Pd) as u8
  u8 S = 0
  u8 Ci = 0
  u8 Rj = 0
  Ci = Pd % 14
  Rj = Pd / 14
  if Rj > 0 then
    if Ed[Pd + 116] > 0 then S = S | 1
  end if
  if Ci < 13 then
    if Ed[Rj * 13 + Ci] > 0 then S = S | 2
  end if
  if Rj < 9 then
    if Ed[Pd + VBase] > 0 then S = S | 4
  end if
  if Ci > 0 then
    if Ed[Rj * 13 + Ci - 1] > 0 then S = S | 8
  end if
  return S

' 500: is there a dot in direction Dd (0 up, 1 right, 2 down, 3 left)?
function Legal(u8 Pd, u8 Dd) as u8
  u8 Ok = 0
  u8 Ci = 0
  u8 Rj = 0
  Ci = Pd % 14
  Rj = Pd / 14
  select case Dd
  case 0
    if Rj > 0 then Ok = 1
  case 1
    if Ci < 13 then Ok = 1
  case 2
    if Rj < 9 then Ok = 1
  case else
    if Ci > 0 then Ok = 1
  end select
  return Ok

' the line from dot Pd in direction Dd (index into Ed)
function EdgeOf(u8 Pd, u8 Dd) as u8
  u8 E = 0
  u8 Ci = 0
  u8 Rj = 0
  Ci = Pd % 14
  Rj = Pd / 14
  select case Dd
  case 0
    E = Pd + 116
  case 1
    E = Rj * 13 + Ci
  case 2
    E = Pd + VBase
  case else
    E = Rj * 13 + Ci
    E = E - 1
  end select
  return E

' 430-460: are all four sides of square B lines?
function Closed(u8 B) as u8
  u8 Bi = 0
  u8 Bj = 0
  u16 Vi = 0
  Bi = B % 13
  Bj = B / 13
  if Ed[B] = 0 then return 0
  if Ed[B + 13] = 0 then return 0
  Vi = Bj * 14 + Bi + VBase
  if Ed[Vi] = 0 then return 0
  if Ed[Vi + 1] = 0 then return 0
  return 1

' 340-370: the computer's answer for situation Sx
function CpuPick(u8 Sx) as u8
  u8 Dd = 0
  u8 Bit = 0
  Dd = Rnd() & 3
  if Sx = 15 then return Dd
  if Fl >= 4 then return Dd
cp_again:
  Bit = 1 << Dd
  if (Sx & Bit) <> 0 then
    Dd = Rnd() & 3
    goto cp_again
  end if
  inc Fl
  return Dd

' 290-330: WHICH WAY? for situation Si (the rule is taught, the turn ends)
sub Ask:
  Message(1)
  play sound SndAsk
  if Sn[Pl].Kind = 1 then
    Hold(24)
    D = CpuPick(Si)
  else
    D = HumanPick()
  end if
  Rule[Si * 4 + Pl] = D + 1
  LastD = D
  inc AskN
  Q = 10
  Message(0)
  return
end sub

' the stick: released first, then held in one of the four directions
function HumanPick() as u8
  u8 Dd = 255
  Ph = 1
  Blink = 0
  Held = 1
hp_loop:
  Frame1
  ReadPad
  inc Blink
  if Blink >= 30 then Blink = 0
  DrawHeads
  V = Stick & 15
  if V = 0 then Held = 0
  if Held = 0 then
    select case V
    case 1
      Dd = 0
    case 8
      Dd = 1
    case 2
      Dd = 2
    case 4
      Dd = 3
    end select
  end if
  if Dd = 255 then goto hp_loop
  Ph = 2
  Blink = 0
  DrawHeads
  return Dd

' 100-280: one snake's turn
sub Turn:
  P = Sn[Pl].Pos
  Q = 0
  Fl = 0
  P1 = P
  P2 = Sit(P)
  Lf = 0
  Ph = 2
  ShowScores
  Message(0)
  play sound SndTurn
  Hold(20)
t_loop:
  Si = Sit(P)
  D = Rule[Si * 4 + Pl]
  if D = 0 then
    Ask
  else
    D = D - 1
  end if
  if Legal(P, D) = 0 then
    ' 510: ILLEGAL MOVE, asked again
    Message(2)
    play sound SndBad
    Hold(40)
    Ask
    goto t_loop
  end if
  MoveSnake
  Si2 = Sit(P)
  ' 240: back where the turn began, nothing changed: a loop
  if P = P1 then
    if Si2 = P2 then
      Lf = 1
      Q = MaxQ
    end if
  end if
  if Q >= MaxQ then
    Hold(12)
    return
  end if
  inc Q
  goto t_loop
end sub

' 170-230: draw the line in direction D, slide the head, close squares
sub MoveSnake:
  u8 E = 0
  u8 Ci = 0
  u8 Rj = 0
  u8 Nx = 0
  u8 Ny = 0
  u8 T = 0
  i8 Dx = 0
  i8 Dy = 0
  E = EdgeOf(P, D)
  if Ed[E] = 0 then inc NewEd
  Ed[E] = Pl + 1
  Ci = P % 14
  Rj = P / 14
  select case D
  case 0
    Dy = -1
  case 1
    Dx = 1
  case 2
    Dy = 1
  case else
    Dx = -1
  end select
  ' the head slides 16 pixels, 2 a frame
  for Hi = 1 to 8
    Sn[Pl].Px = Sn[Pl].Px + Dx + Dx
    Sn[Pl].Py = Sn[Pl].Py + Dy + Dy
    Frame1
    DrawHeads
  next
  Nx = Ci * 2 + 2
  Ny = Rj * 2 + 1
  if Dx <> 0 then
    T = TH1 + Pl
    Nx = Nx + Dx
  else
    T = TV1 + Pl
    Ny = Ny + Dy
  end if
  put char T at Nx,Ny
  select case D
  case 0
    P = P - 14
  case 1
    inc P
  case 2
    P = P + 14
  case else
    dec P
  end select
  Sn[Pl].Pos = P
  play sound SndStep
  ' 410-460: the squares on both sides of the line
  if E < VBase then
    if E >= 13 then TryBox(E - 13)
    if E < 117 then TryBox(E)
  else
    E = E - VBase
    Ci = E % 14
    Rj = E / 14
    E = Rj * 13 + Ci
    if Ci > 0 then TryBox(E - 1)
    if Ci < 13 then TryBox(E)
  end if
  inc MoveN
  Hold(StepF)
  return
end sub

sub TryBox(u8 B):
  u8 Bx = 0
  u8 By = 0
  if Bf[B] > 0 then return
  if Closed(B) = 0 then return
  Bf[B] = Pl + 1
  inc Filled
  Sn[Pl].Sc += 1
  Bx = B % 13
  By = B / 13
  Bx = Bx * 2 + 3
  By = By * 2 + 2
  K = TB1 + Pl
  put char K at Bx,By
  ShowScores
  play sound SndBox
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub NewGame:
  u8 Np = 0
  u8 Ok = 0
  fill array Ed with 0
  fill array Bf with 0
  fill array Rule with 0
  Filled = 0
  Dry = 0
  Rounds = 0
  Over = 0
  MoveN = 0
  AskN = 0
  ' 60: four different start dots at random
  for Li = 0 to 3
ng_again:
    Np = Rnd()
    if Np >= NDot then goto ng_again
    Ok = 1
    for Hi = 0 to 3
      if Hi < Li then
        if Sn[Hi].Pos = Np then Ok = 0
      end if
    next
    if Ok = 0 then goto ng_again
    Sn[Li].Pos = Np
    Sn[Li].Sc = 0
    HeadAt(Li)
  next
  NewScreen
  for Ri = 0 to 9
    Y = Ri * 2 + 1
    for Li = 0 to 13
      X = Li * 2 + 2
      put char TDot at X,Y
    next
  next
  fill TRule count 28 at 2,20
  Ph = 2
  ShowScores
  DrawHeads
  ShowScreen
  return
end sub

' the head sprite's pixel place for snake N's dot
sub HeadAt(u8 N):
  u8 Pd = 0
  Pd = Sn[N].Pos
  X = Pd % 14
  Y = Pd / 14
  Sn[N].Px = X * 16 + 12
  Sn[N].Py = Y * 16 + 3
  return
end sub

' the four heads; the snake asking blinks white (2 Hz)
sub DrawHeads:
  u8 Cl = 0
  u8 Hx = 0
  u8 Hy = 0
  for J = 0 to 3
    Cl = SnCol[J]
    if J = Pl then
      if Blink >= 15 then Cl = 15
    end if
    Hx = Sn[J].Px
    Hy = Sn[J].Py
    set sprite J to Hy,Hx,SHead,Cl
  next
  update sprites
  return
end sub


' 520-540: the four scores, the snake to move marked
sub ShowScores:
  for Li = 0 to 3
    X = Li * 7 + 2
    C = 32
    if Li = Pl then
      if Ph <> 9 then C = 62
    end if
    put char C at X,21
    K = TB1 + Li
    X = X + 1
    put char K at X,21
    X = X + 2
    NumU = Sn[Li].Sc
    print at X,21, width$(NumU, 3)
  next
  return
end sub

' row 22: SNAKE n and what it is doing
sub Message(u8 Mn):
  fill 32 count 28 at 2,22
  NumU = Pl + 1
  print at 2,22, "SNAKE ", digits$(NumU, 1)
  select case Mn
  case 1
    if Sn[Pl].Kind = 1 then
      print at 10,22, "IS THINKING"
    else
      print at 10,22, "WHICH WAY?"
    end if
  case 2
    print at 10,22, "ILLEGAL MOVE!"
  case else
    if Sn[Pl].Kind = 1 then
      print at 10,22, "(COMPUTER)"
    else
      print at 10,22, "(PLAYER)"
    end if
  end select
  return
end sub

sub EndScreen:
  u8 Best = 0
  u8 Nb = 0
  u8 Bw = 0
  NewScreen
  for Li = 0 to LogoN - 1
    K = Li * 3
    X = LogoXY[K]
    Y = LogoXY[K + 1]
    C = LogoXY[K + 2] + TB1 - 1
    put char C at X,Y
  next
  print at 10,9, "GAME OVER!"
  for Li = 0 to 3
    Y = Li * 2 + 12
    K = TB1 + Li
    put char K at 4,Y
    NumU = Li + 1
    print at 6,Y, "SNAKE ", digits$(NumU, 1), " ...."
    NumU = Sn[Li].Sc
    print at 18,Y, width$(NumU, 3), " SQUARES"
    if Sn[Li].Sc > Best then
      Best = Sn[Li].Sc
      Bw = Li
      Nb = 1
    else
      if Sn[Li].Sc = Best then inc Nb
    end if
  next
  if Nb = 1 then
    NumU = Bw + 1
    print at 9,21, "SNAKE ", digits$(NumU, 1), " WINS!"
  else
    print at 12,21, "A TIE!"
  end if
  select case Why
  case 1
    print at 3,10, "ALL SNAKES GO IN CIRCLES"
  case 2
    print at 6,10, "NO NEW LINES DRAWN"
  case else
    print at 5,10, "ALL SQUARES CLOSED"
  end select
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

sub Hold(u8 Nf):
  for Hi = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Stick = J1 | J2
  Btn = Stick & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, the tune once, the snake menu (560-620)
sub TitlePage:
  NewScreen
  for Li = 0 to LogoN - 1
    K = Li * 3
    X = LogoXY[K]
    Y = LogoXY[K + 1]
    C = LogoXY[K + 2] + TB1 - 1
    put char C at X,Y
  next
  print at 7,9, "COMPUTE!'S GAZETTE"
  print at 11,10, "JUNE 1985"
  for Li = 0 to 3
    Y = MenuY + Li
    K = TB1 + Li
    put char K at 8,Y
    NumU = Li + 1
    print at 10,Y, "SNAKE ", digits$(NumU, 1)
  next
  print at 10,17, "START"
  print at 10,18, "HOW TO PLAY"
  print at 3,20, "STICK: CHOOSE, LEFT/RIGHT:"
  print at 3,21, "PLAYER OR COMPUTER, BUTTON"
  print at 3,22, "ON START TO PLAY"
  Menu = 4
  ShowMenu
  TitleOn = 1
  Ph = 5
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 500
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Held = 1
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Stick & 15
  if V > 0 then
    if Held = 0 then
      select case V
      case 1
        if Menu > 0 then dec Menu
      case 2
        if Menu < 5 then inc Menu
      case 4, 8
        if Menu < 4 then Sn[Menu].Kind = Sn[Menu].Kind ^ 1
      end select
      ShowMenu
      play sound SndMove
    end if
    Held = 1
  else
    Held = 0
  end if
  if Press = 0 then goto tp_loop
  if Menu < 4 then
    Sn[Menu].Kind = Sn[Menu].Kind ^ 1
    ShowMenu
    play sound SndMove
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  for Ri = 0 to 5
    Y = Ri + MenuY
    if Ri >= 4 then inc Y
    C = 32
    if Ri = Menu then C = 62
    put char C at 6,Y
    if Ri < 4 then
      if Sn[Ri].Kind = 0 then
        print at 18,Y, "PLAYER  "
      else
        print at 18,Y, "COMPUTER"
      end if
    end if
  next
  return
end sub

sub HowToPlay:
  NewScreen
  print at 11,1, "SQUARES"
  print at 2,3, "FOUR SNAKES CRAWL FROM DOT"
  print at 2,4, "TO DOT, DRAWING LINES. CLOSE"
  print at 2,5, "THE 4TH SIDE OF A SQUARE TO"
  print at 2,6, "SCORE IT."
  print at 2,8, "YOU DON'T STEER: YOU TEACH."
  print at 2,9, "WHEN YOUR SNAKE MEETS A NEW"
  print at 2,10, "PATTERN OF LINES AROUND ITS"
  print at 2,11, "DOT, IT ASKS WHICH WAY. PUSH"
  print at 2,12, "THE STICK. AFTER THAT IT"
  print at 2,13, "GOES THAT WAY BY ITSELF."
  print at 2,15, "UP TO 10 MOVES A TURN; A NEW"
  print at 2,16, "QUESTION ENDS THE TURN."
  print at 2,18, "WHEN ALL THE SNAKES RUN IN"
  print at 2,19, "CIRCLES, THE GAME IS OVER."
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "SQUARES"
  print at 2,5, "BASED ON THE TYPE-IN GAME"
  print at 2,6, "SQUARES, COMPUTE!'S GAZETTE,"
  print at 2,7, "JUNE 1985 (COMMODORE 64)."
  print at 2,8, "NO AUTHOR NAMED."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: FOUR CORNERS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  Ph = 7
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

