' the eight directions: up, up-right, right, down-right, down, down-left,
' left, up-left (255 is -1)
data DR bytes 255,255,0,1,1,1,0,255
data DC bytes 0,1,1,1,0,255,255,255
' the C64's order of tries around the wanted direction
data TryO bytes 0,7,1,6,2,5,3,4
' the wanted direction from the signs of the row and column differences,
' (row sign + 1) x 3 + column sign + 1
data DirOf bytes 7,0,1,6,0,2,5,4,3

