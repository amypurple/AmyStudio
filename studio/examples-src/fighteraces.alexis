data TxScore bytes 151,152,153,154,155,163
data TxStand bytes 164,32,152,156,154,154,155,157,158,32,151,158,159,157,160,161,157,162,151,32,164
data TxPlayer bytes 201,202,203,204,205,206
data TxAgain bytes 175,176,177,178,32,177,179,177,180,181,182
data TxHint bytes 183,180,184,185,186,32,178,185,187,32,32,188,189,190,181,186,32,181,189
data TxTitle bytes 219,32,219,32,208,209,210,211,212,213,214,32,215,216,213,217,218,32,219,32,219
data TxPress bytes 220,221,222,223,223,32,224,225,221,222,32,226,227,32,228,222,229,225,230

asm {
FaDroneN:
    db $00,$00,$55,$3C,$00,$00,$55,$3C,$00,$00,$55,$3C,$00,$00,$55,$3C,$10
FaDroneT:
    db $40,$0E,$53,$3C,$40,$0E,$53,$3C,$40,$0E,$53,$3C,$40,$0E,$53,$3C,$50
FaBoomN:
    db $00,$00,$05,$04,$10
FaBoomT:
    db $40,$0E,$03,$04,$50
FaQuietN:
    db $00,$00,$F5,$01,$10
FaQuietT:
    db $40,$0E,$F3,$01,$50

FaSoundTable:
    dw FaDroneN,$702B
    dw FaDroneT,$7035
    dw FaBoomN,$702B
    dw FaBoomT,$7035
    dw FaQuietN,$702B
    dw FaQuietT,$7035
    dw FaTuneMel,$703F
    dw FaTuneBass,$7049
; Twin Props, G major (original for this game)
; Tiny Sound, 7 frames per step
FaTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$1A,$01,$1E,$01,$21,$01,$01,$01,$1E,$01,$21,$01
    db $26,$01,$01,$01,$25,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01
    db $1A,$01,$01,$01,$1C,$01,$1F,$01,$23,$01,$01,$01,$21,$01,$1E,$01
    db $1A,$01,$1E,$01,$1C,$01,$01,$01,$21,$01,$01,$01,$1C,$01,$01,$01
    db $00,$01,$01,$01,$1A,$01,$1E,$01,$21,$01,$01,$01,$1E,$01,$21,$01
    db $26,$01,$01,$01,$28,$01,$26,$01,$25,$01,$23,$01,$21,$01,$01,$01
    db $1E,$01,$01,$01,$1F,$01,$23,$01,$21,$01,$1E,$01,$1C,$01,$1F,$01
    db $1E,$01,$1C,$01,$1A,$01,$01,$01,$15,$01,$01,$01,$1A,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
FaTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0E,$01,$01,$01,$09,$01,$01,$01,$0E,$01,$01,$01
    db $09,$01,$01,$01,$07,$01,$01,$01,$0E,$01,$01,$01,$0E,$01,$01,$01
    db $09,$01,$01,$01,$07,$01,$01,$01,$0B,$01,$01,$01,$0E,$01,$01,$01
    db $12,$01,$01,$01,$09,$01,$01,$01,$0D,$01,$01,$01,$10,$01,$01,$01
    db $0D,$01,$01,$01,$0E,$01,$01,$01,$09,$01,$01,$01,$0E,$01,$01,$01
    db $09,$01,$01,$01,$09,$01,$01,$01,$10,$01,$01,$01,$0E,$01,$01,$01
    db $12,$01,$01,$01,$07,$01,$01,$01,$0E,$01,$01,$01,$09,$01,$01,$01
    db $0D,$01,$01,$01,$0E,$01,$01,$01,$09,$01,$01,$01,$0E,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
FaSong:
    dw $0001
    db $40+7,8
    dw $0000

; FaCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
FaCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
FaCellDiv:
    or a
    sbc hl,de
    jr c,FaCellRem
    inc b
    jr FaCellDiv
FaCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; FaPeek: Pk = the tile at B (PEEK(B))
FaPeek:
    call FaCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; FaPoke: the tile Tl at B (POKE B,Tl)
FaPoke:
    call FaCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret

; FontTiles: each font character of FontTab (third 0 of the pattern
; table) copied into its tile, in the three thirds (the tile's colour is
; TileCol's)
FontTiles:
    ld hl,FontTab
FtNext:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld e,a
    ld a,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld l,e
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ex de,hl
    pop hl
    ; DE = the character's pattern, HL = the tile's
    ld b,8
FtByte:
    ld a,e
    out ($BF),a
    ld a,d
    out ($BF),a
    nop
    nop
    nop
    in a,($BE)
    ld c,a
    push hl
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    pop hl
    inc hl
    inc de
    djnz FtByte
    pop hl
    jr FtNext
FtPut:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    nop
    nop
    ld a,c
    out ($BE),a
    ret
FontTab:
    db 83,151,67,152,79,153,82,154,69,155,85,156,78,157,84,158,65,159,68,160,73,161,71,162,58,163,42,164,48,165,49,166,50,167,51,168,52,169,53,170,54,171,55,172,56,173,57,174,80,175,76,176,65,177,89,178,71,179,73,180,78,181,63,182,70,183,82,184,69,185,58,186,83,187,68,188,79,189,87,190,48,191,49,192,50,193,51,194,52,195,53,196,54,197,55,198,56,199,57,200,80,201,76,202,65,203,89,204,69,205,82,206,45,207,70,208,73,209,71,210,72,211,84,212,69,213,82,214,65,215,67,216,83,217,33,218,42,219,80,220,82,221,69,222,83,223,70,224,73,225,84,226,79,227,66,228,71,229,78,230,0
}
