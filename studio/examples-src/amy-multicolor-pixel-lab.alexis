cartridge "MULTICOLOR PIXELS/AMY/2026"

u8 PixelColor = 0

  multicolor screen
' In multicolor mode, visible color nibbles live in the pattern table.
  cls
  pset multicolor 2,2 color 5
  pset multicolor 3,2 color 12
  pset multicolor 2,3 color 10
  pset multicolor 3,3 color 15
  PixelColor = pget multicolor 2,2
  pset multicolor 6,7 color PixelColor
  screen on
main:
  goto main