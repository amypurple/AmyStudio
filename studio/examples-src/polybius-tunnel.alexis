cartridge "POLYBIUS/PRESENTS SINNESLOSCHEN'S/1982"

' =========================================================================
' POLYBIUS - VERSION A "LE TUNNEL"
' An arcade reconstruction of the 1981 Portland urban legend, published
' by the fictional SINNESLOSCHEN, with a tribute to the forward-thrust
' tunnel and speed gates of Jeff Minter's Polybius (Llamasoft, 2017).
' Original graphics, names and music: nothing is copied from Llamasoft.
'
' Design and direction: Amy.  Programming: Claude, with Amy Studio.
'
' PSEUDO-3D TECHNIQUE
' -------------------
' The tunnel never gets redrawn.  tools/gen_tunnel.py precomputes eight
' name-table pages per tube shape.  Each page is one perspective phase of
' rings spaced uniformly in depth; after eight phases the ring set repeats.
' Graphics II runs with masked tables (R3=$9F, R4=$00): the three screen
' thirds share one 256-tile PATTERN table at $0000 and one COLOR table at
' $2000, which frees 12 KB of VRAM for name pages:
'   page 0..5 : $0800 $0C00 $1000 $1400 $1800 $1C00   (R2 = 2..7)
'   page 6..7 : $2800 $2C00                           (R2 = 10, 11)
'   menu page : $3000                                 (R2 = 12)
'   sprite attributes $1B00 (slack of page 4), sprite patterns $3800.
' Forward motion is ONE register write (R2) per frame, done inside the
' VBlank hook.  Speed only changes how fast the phase accumulator moves.
'
' VRAM BUDGET (writes per frame, see report)
' ------------------------------------------
' Everything below happens right after WAIT, inside vertical blanking:
'   R2 page switch ......................... 2 control bytes (NMI hook)
'   sprite attribute table ................. 4 x active sprites + 1
'   far-object overlay (restore + draw) .... up to 3 accesses per cell
'   one secondary job: HUD element OR spoke colour step
' Hand-written VDP loops below keep at least 29 Z80 cycles between data
' accesses (TMS9918A 8 microsecond rule) so an overrun past VBlank never
' loses a write on real hardware.  Only the Amy sprite upload uses fast
' OUTI and it is always issued first.
' =========================================================================

' ------------------------------------------------------------ constants
const MenuReg = 12
const MenuPageHi = $30
const CoreCol0 = 14
const CoreCol1 = 17
const CoreRow0 = 10
const CoreRow1 = 13
const MaxOv = 20
const MaxEn = 6
const MaxShots = 3
const MaxGates = 2
const SpawnD = 600
const TileD = 280
const HiddenD = 520
const GatesPerLevel = 8
const SprShip = 0
const SprEye = 1
const SprShot0 = 2
const SprEn0 = 5
const SprGate0 = 11
const SprBoom = 13
const SprWave = 14
const SprCount = 15
const ColShip = 15
const ColShipSafe = 14
const ColEye = 13
const ColShot = 15
const ColTri = 9
const ColDia = 3
const ColSpi = 10
const ColGate = 11
const ColBoom = 11
' --- sound constants (written by tools/gen_sound.py) ---
const SndTit1 = 1
const SndTit2 = 2
const SndTit3 = 3
const SndTit4 = 4
const SndG0a = 5
const SndG0b = 6
const SndG0c = 7
const SndG1a = 8
const SndG1b = 9
const SndG1c = 10
const SndG2a = 11
const SndG2b = 12
const SndG2c = 13
const SndShot = 14
const SndBoomN = 15
const SndHitT = 16
const SndHitN = 17
const SndWaveN = 18
const SndWaveT2 = 19
const SndGate1 = 20
const SndGate2 = 21
const SndGateN = 22
const SndMiss = 23
const SndLevel1 = 24
const SndLevel2 = 25
const SndLife = 26
const SndOver1 = 27
const SndOver2 = 28
const SndOverN = 29
const SndData = 30
' --- end sound constants ---

' ------------------------------------------------------------ variables
' Tunnel and level state
u8 Shape = 0
u8 Level = 1
u8 LaneCount = 8
u8 SpokeCount = 8
u8 TileCount = 132
u8 RingCol = 7
u8 ShowPage = 0
u8 ShowReg = 12
u8 LastReg = 12
u8 PhaseAcc = 0
u8 SpeedLvl = 0
u8 SpeedQ = 4
u8 BaseSpeed = 0
u16 PtrH = 0
u16 PtrMX = 0
u16 PtrMY = 0
u16 PtrSG = 0
u16 PtrFR = 0
u16 PtrSpk = 0
u16 PtrSpkIx = 0

' Player
u8 PLane = 0
u8 PFrom = 0
u8 PGlide = 0
u8 PX = 0
u8 PY = 0
u8 PFrame = 0
u8 PDead = 0
u8 PSafe = 0
u8 Lives = 3
u8 WaveOk = 1
u8 RepeatT = 0
u8 FireT = 0
u8 Mult = 1
u8 GatesDone = 0
bcd digits 6 Score = 0
bcd digits 6 HiScore = 0
u8 ScoreBuf[6]

' Objects
u8 EnType[6]
u8 EnLane[6]
u16 EnD[6]
u8 EnTick[6]
u8 EnRim[6]
u8 EnX[6]
u16 RndSeed = $ACE1
u8 RndOut = 0
u8 EnTX[6]
u8 EnTY[6]
u8 EnGrab[6]
u8 EnY[6]
u8 CrawlRate = 30
u8 ShotOn[3]
u8 ShotLane[3]
u16 ShotD[3]
u8 GateOn[2]
u8 GateLane[2]
u16 GateD[2]
u8 SpawnT = 60
u8 GateT = 90
u8 BoomT = 0
u8 BoomX = 0
u8 BoomY = 0
u8 WaveT = 0
u8 EyeT = 0
u8 MsgT = 0
u8 SubT = 0
u8 SubWord = 0
u16 SubWait = 1500

' Overlay lists (far objects and short messages drawn as tiles)
u8 OvN = 0
u8 OvLo[20]
u8 OvHi[20]
u8 OvT[20]
u8 OldN = 0
u8 OldLo[20]
u8 OldHi[20]
u8 OldS[20]

' Spoke colour animation
u8 SpkHi = 0
u8 RotT = 0
u8 RotPeriod = 0
u8 SpkQN = 0
u8 SpkQ[8]
u8 SpkQC[8]
u8 SweepK = 0
u8 HudDirty = 0

' Options, flow, demo
bool FlashFx = false
bool DemoMode = false
u8 Choice = 1
u8 IdleT = 0
u8 IdleS = 0
u16 DemoT = 0
u8 MusicFast = 0
u8 MusicOn = 0
u16 QaLoops = 0
u8 LogoCur = 0
u8 LogoFlashT = 0
u8 LogoWait = 0
u8 LogoDid = 0

' Scratch (never kept across calls to other subs)
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 H = 0
u8 M = 0
u8 X = 0
u8 Y = 0
u8 T = 0
u16 Off = 0
u16 CD = 0
u8 CV = 0
u8 CW = 0
u8 Hx = 0
bool DemoQuit = false
u8 AttractN = 0
u16 P = 0
u16 D = 0
u8 Pad = 0
u8 OldPad = 0
u8 Edge = 0

on vblank VblankTick

' =========================================================================
' BOOT
' =========================================================================
  set sound table SndTable areas 7
  VideoInit
  if defined QA_SFX
    ' sound QA build: every effect alone, then over the in-game pulse
    screen on
    wait 30 frames
    play sound SndShot
    wait 60 frames
    play sound SndBoomN
    wait 60 frames
    play sounds SndHitT, SndHitN
    wait 120 frames
    play sounds SndWaveN, SndWaveT2
    wait 90 frames
    play sounds SndGate1, SndGate2, SndGateN
    wait 60 frames
    play sound SndMiss
    wait 60 frames
    play sounds SndLevel1, SndLevel2
    wait 90 frames
    play sounds SndLife, SndLevel2
    wait 120 frames
    play sounds SndOver1, SndOver2, SndOverN
    wait 180 frames
    play sound SndData
    wait 90 frames
    for K = 0 to 2
      SpeedLvl = K * 3
      StartMusic
      wait 120 frames
      play sound SndShot
      wait 20 frames
      play sound SndShot
      wait 40 frames
      play sound SndBoomN
      wait 60 frames
      play sounds SndGate1, SndGate2, SndGateN
      wait 60 frames
      play sound SndMiss
      wait 60 frames
      play sounds SndWaveN, SndWaveT2
      wait 120 frames
    next
    ' back down to the slow pulse: tone 2 must fall silent
    SpeedLvl = 0
    GameMusic
    wait 240 frames
    StopAllSound
    wait 60 frames
  end defined
  HiScore = 0
  goto TitleScreen

' =========================================================================
' TITLE SCREEN AND ATTRACT LOOP
' Title runs over the octagon tunnel, drifting slowly forward, with the
' SINNESLOSCHEN eye and an orbiting ship.  After 15 seconds of inactivity
' the attract demo plays, then the high-score page, then the title again.
' =========================================================================
TitleScreen:
  DemoMode = false
  Level = 1
  LoadShape(0)
  DrawTitleText
  RotPeriod = 10
  SpeedLvl = 0
  Choice = 1
  DrawCursor(0)
  SpeedQ = 3
  IdleT = 0
  IdleS = 0
  StartTitleMusic
  play sound SndData
  clear sprites
  set sprite count SprCount
  K = 0
  screen on

TitleLoop:
  wait
  nmi off
  call asm PB_SAT_UPLOAD
  call asm PB_OVERLAY_FLUSH
  ' logo colour only when it changes; otherwise the spoke job
  LogoColorJob
  if LogoDid = 0 then SpokeJob
  nmi on
  sleep after 120 seconds
  ' tunnel drift and decoration
  PhaseAcc += SpeedQ
  ShowPage = (PhaseAcc >> 4) & 7
  ShowReg = PageRegs[ShowPage]
  OvN = 0
  inc K
  TitleSprites
  RotateSpokes
  ' menu input (edge-triggered, either controller)
  ReadPad
  if Edge != 0 then AttractN = 0
  if (Edge & 1) != 0 then
    if Choice > 1 then
      DrawCursor(1)
      dec Choice
      DrawCursor(0)
    end if
    IdleT = 0
    IdleS = 0
  end if
  if (Edge & 4) != 0 then
    if Choice < 4 then
      DrawCursor(1)
      inc Choice
      DrawCursor(0)
    end if
    IdleT = 0
    IdleS = 0
  end if
  if (Edge & $C0) != 0 then
    StopAllSound
    if Choice = 1 then goto NewGame
    if Choice = 2 then goto HowToPlay
    if Choice = 3 then goto Options
    goto Credits
  end if
  inc IdleT
  if IdleT >= 60 then
    IdleT = 0
    inc IdleS
    if defined QA_STRESS
      IdleS = 15
    end defined
    if IdleS >= 15 then
      ' after four demo cycles the title stays put and the display sleeps
      if AttractN < 4 then goto AttractDemo
    end if
  end if
  goto TitleLoop

AttractDemo:
  DemoMode = true
  DemoQuit = false
  inc AttractN
  StartGameState
  DemoT = 0
  goto GameStart

' =========================================================================
' NEW GAME
' =========================================================================
NewGame:
  DemoMode = false
  StartGameState
GameStart:
  LoadShape(Shape)
  RestoreWords
  DrawHudAll
  BeginLife
  StartMusic
  screen on

' =========================================================================
' MAIN GAME LOOP - one logic pass per video frame
' =========================================================================
GameLoop:
  wait
  ' ---------- VBlank: all VRAM work, fast sprite upload first ----------
  nmi off
  call asm PB_SAT_UPLOAD
  call asm PB_OVERLAY_FLUSH
  if OvN + OldN <= 24 then SecondaryJob
  nmi on
  ' ---------- logic (CPU only, prepares next frame) ----------
  if defined QA_COUNT
    inc QaLoops
  end defined
  OvN = 0
  if DemoMode then
    DemoInput
    if DemoQuit then
      StopAllSound
      wait no fire
      goto TitleScreen
    end if
    inc DemoT
    if DemoT >= 1800 then goto DemoEnd
  else
    ReadPad
  end if
  if PDead = 0 then
    PlayerControl
  else
    dec PDead
    if PDead = 0 then
      if Lives = 0 then goto GameOver
      BeginLife
    end if
  end if
  AdvanceTunnel
  MoveShots
  MoveEnemies
  MoveGates
  Spawner
  Effects
  BuildPlayerSprite
  if GatesDone >= GatesPerLevel then LevelUp
  goto GameLoop

DemoEnd:
  StopAllSound
  goto HiScorePage

' =========================================================================
' GAME OVER: one press returns to the title; display sleeps when idle
' =========================================================================
GameOver:
  StopAllSound
  if DemoMode then goto HiScorePage
  play sounds SndOver1, SndOver2, SndOverN
  if Score > HiScore then HiScore = Score
  PutTextAll(0, 11, 15)
  for K = 0 to 40
    wait
    nmi off
    call asm PB_SAT_UPLOAD
    call asm PB_OVERLAY_FLUSH
    nmi on
    OvN = 0
    AdvanceTunnel
  next
  pause until press and release sleep after 10 seconds
  goto TitleScreen

HiScorePage:
  MenuPage
  print centered at 4, "SINNESLOSCHEN"
  RuleRow(6)
  print centered at 9, "HIGH SCORE"
  format HiScore into ScoreBuf
  put ScoreBuf count 6 at 13,11
  print centered at 14, "LAST SCORE"
  format Score into ScoreBuf
  put ScoreBuf count 6 at 13,16
  RuleRow(19)
  print centered at 21, "PRESS FIRE"
  screen on
  wait 240 frames or press
  goto TitleScreen

' =========================================================================
' MENUS ON THE STATIC TEXT PAGE
' =========================================================================
HowToPlay:
  MenuPage
  print centered at 2, "HOW TO PLAY"
  RuleRow(3)
  print at 2,5, "JOYSTICK  ROTATE AROUND"
  print at 12,6, "THE TUBE"
  print at 2,8, "LEFT BTN  FIRE TO CENTRE"
  print at 2,10, "RIGHT BTN ONE WAVE A LIFE"
  print at 12,11, "CLEARS THE TUBE"
  print at 2,14, "FLY THROUGH THE GATES:"
  print at 4,16, "SPEED UP AND RAISE"
  print at 4,17, "THE MULTIPLIER"
  print at 2,19, "MISS A GATE OR GET HIT:"
  print at 4,20, "YOU SLOW DOWN"
  print centered at 22, "FIRE: NEXT"
  set sprite count 6
  set sprite 0 to 111,222,SPGATE2,ColGate
  set sprite 1 to 39,222,SPSHIP0,ColShip
  set sprite 2 to 63,222,SPSHOT1,ColShot
  set sprite 3 to 79,222,SPWAVE,7
  set sprite 4 to 207,0,0,0
  set sprite 5 to 207,0,0,0
  update sprites
  screen on
  pause until press and release sleep after 30 seconds
  MenuPage
  print centered at 2, "HOW TO PLAY"
  RuleRow(3)
  print at 6,6, "TRIANGLE     10 PTS"
  print at 6,9, "DIAMOND      20 PTS"
  print at 6,12, "SPIRAL       30 PTS"
  print at 3,15, "POINTS X MULTIPLIER"
  print at 3,17, "8 GATES: NEXT LEVEL"
  print at 3,18, "THE TUBE CHANGES SHAPE"
  print at 3,19, "AND STARTS TO TURN"
  print centered at 22, "FIRE: TITLE"
  set sprite count 6
  set sprite 0 to 39,24,SPTRI2,ColTri
  set sprite 1 to 63,24,SPDIA2,ColDia
  set sprite 2 to 87,24,SPSPA2,ColSpi
  set sprite 3 to 207,0,0,0
  set sprite 4 to 207,0,0,0
  set sprite 5 to 207,0,0,0
  update sprites
  screen on
  pause until press and release sleep after 30 seconds
  goto TitleScreen

' Credits preserve the 1981 Portland legend in-game. The cartridge header says
' 1982 because no ColecoVision cartridge could predate the console itself.
Credits:
  MenuPage
  print centered at 2, "CREDITS"
  RuleRow(3)
  print centered at 5, "POLYBIUS"
  put char TCOPYR at 6,7
  print at 8,7, "1981 SINNESL"
  put char TOUML at 20,7
  print at 21,7, "SCHEN"
  print centered at 10, "PORTLAND  OREGON"
  print centered at 12, "NO CABINET WAS EVER FOUND."
  print centered at 14, "THE MACHINE AND COMPANY"
  print centered at 16, "BELONG TO AN URBAN LEGEND"
  print centered at 18, "FIRST TOLD ONLINE IN 2000."
  print centered at 22, "FIRE: NEXT"
  set sprite count 2
  set sprite 0 to 8,224,SPEYE0,ColEye
  set sprite 1 to 207,0,0,0
  update sprites
  screen on
  CreditsEyeWait
  MenuPage
  print centered at 2, "THE URBAN LEGEND"
  RuleRow(3)
  print centered at 5, "ARCADES NEAR PORTLAND"
  print centered at 7, "RECEIVED A STRANGE GAME"
  print centered at 9, "PLAYERS REPORTED BAD DREAMS"
  print centered at 11, "MEMORY LOSS AND NIGHTMARES"
  print centered at 14, "MEN IN BLACK TOOK NOTES"
  print centered at 16, "THEN THE CABINET VANISHED"
  print centered at 18, "NO MACHINE WAS EVER FOUND"
  print centered at 22, "FIRE: NEXT"
  set sprite count 2
  set sprite 0 to 8,224,SPEYE0,ColEye
  set sprite 1 to 207,0,0,0
  update sprites
  screen on
  CreditsEyeWait
  MenuPage
  print centered at 2, "THIS VERSION"
  RuleRow(3)
  print centered at 5, "VERSION A - THE TUNNEL"
  print centered at 8, "DESIGN   AMY"
  print centered at 10, "CODE   CLAUDE"
  print centered at 12, "MADE WITH AMY STUDIO"
  print centered at 15, "TUNNEL AND SPEED GATES"
  print centered at 17, "INSPIRED BY POLYBIUS"
  print centered at 19, "MINTER / LLAMASOFT 2017"
  print centered at 22, "FIRE: TITLE"
  set sprite count 2
  set sprite 0 to 8,224,SPEYE0,ColEye
  set sprite 1 to 207,0,0,0
  update sprites
  screen on
  CreditsEyeWait
  goto TitleScreen

Options:
  MenuPage
  print centered at 3, "OPTIONS"
  RuleRow(4)
  DrawOptionLine
  print at 10,12, "BACK"
  print centered at 21, "FIRE: SELECT"
  set sprite count 1
  set sprite 0 to 207,0,0,0
  update sprites
  screen on
  Choice = 1
OptionsMenu:
  choose menu 1 to 2 into Choice cursor TCURSOR at 4,9 step 3 sleep after 30 seconds
  if Choice = 2 then goto TitleScreen
  if FlashFx then
    FlashFx = false
    SetWordColors
    DrawOptionLine
    goto OptionsMenu
  end if
  ' Turning flashing effects ON always shows the warning first.
  MenuPage
  print centered at 2, "WARNING"
  RuleRow(3)
  print at 3,5, "PHOTOSENSITIVE EPILEPSY"
  print at 3,7, "FLASHING EFFECTS SHOW"
  print at 3,8, "FLASHES AND RAPID"
  print at 3,9, "CHANGES IN BRIGHTNESS."
  print at 3,12, "STOP PLAYING AT ONCE IF"
  print at 3,13, "YOU FEEL DIZZY, UNWELL"
  print at 3,14, "OR YOUR VISION CHANGES."
  print at 8,17, "CANCEL"
  print at 8,19, "TURN ON"
  screen on
  Choice = 1
  choose menu 1 to 2 into Choice cursor TCURSOR at 6,17 step 2 sleep after 30 seconds
  if Choice = 2 then
    FlashFx = true
    SetWordColors
  end if
  goto Options

' =========================================================================
' GAME STATE
' =========================================================================
sub StartGameState:
  Score = 0
  Lives = 3
  Level = 1
  Shape = 0
  GatesDone = 0
  BaseSpeed = 0
  if defined QA_STRESS
    ' QA build only: start on level 6 (star tube, rotating) at high speed
    Level = 6
    Shape = 2
    BaseSpeed = 6
    Lives = 9
  end defined
  if defined QA_L2
    ' QA build only: start on level 2 (cross tube, rim crawlers)
    Level = 2
    Shape = 1
    BaseSpeed = 1
  end defined
  return
end sub

sub BeginLife:
  PLane = LaneCount / 2
  PFrom = PLane
  PGlide = 0
  PDead = 0
  PSafe = 90
  WaveOk = 1
  SpeedLvl = BaseSpeed
  Mult = 1
  for I = 0 to 5
    EnType[I] = 0
    EnRim[I] = 0
  next
  ' lane steps get faster with the level: 40 frames at level 2, min 20
  V = Level * 3
  CrawlRate = 46 - min(V, 26)
  for I = 0 to 2
    ShotOn[I] = 0
  next
  GateOn[0] = 0
  GateOn[1] = 0
  SpawnT = 60
  GateT = 100
  HudDirty = $0F
  return
end sub

sub LevelUp:
  inc Level
  GatesDone = 0
  if Lives < 5 then
    inc Lives
    play sounds SndLife, SndLevel2
  else
    play sounds SndLevel1, SndLevel2
  end if
  if BaseSpeed < 4 then inc BaseSpeed
  Shape = (Level - 1) % 3
  screen off
  LoadShape(Shape)
  DrawHudAll
  BeginLife
  PSafe = 60
  MsgT = 90
  screen on
  return
end sub

' =========================================================================
' VIDEO SETUP
' =========================================================================
sub VideoInit:
  screen off
  mode 2 screen
  sprites 16x16
  asm {
    ld bc,$039F        ; R3 = $9F : COLOR at $2000, thirds share 2 KB
    call WRITE_REGISTER
    ld bc,$0400        ; R4 = $00 : PATTERN at $0000, thirds share 2 KB
    call WRITE_REGISTER
    ld bc,$0536        ; R5 = $36 : sprite attributes at $1B00
    call WRITE_REGISTER
    ld bc,$0607        ; R6 = $07 : sprite patterns at $3800
    call WRITE_REGISTER
    ld bc,$020C        ; R2 = $0C : name table $3000 (menu page)
    call WRITE_REGISTER
    ld bc,$0701        ; R7 : black backdrop
    call WRITE_REGISTER
    ld hl,$3000        ; OS7 name-table shadow used by PRINT/PUT/CLS
    ld ($73F6),hl
  }
  ShowReg = MenuReg
  fill 0 count 2048 to vram.pattern
  load default ascii
  ' 8x8 adaptation of the Polybius 1981 display font. The generated
  ' patterns replace printable ASCII 32..95 while preserving Amy's
  ' standard character codes and all game-specific tiles below slot 32.
  copy PolybiusFont count 512 to vram.pattern + 256
  fill $F0 count 2048 to vram.color
  ' small HUD / far-object tiles in slots 1..31
  restore SmallTiles
  for I = 1 to SmallTileCount
    read K
    Off = K
    Off <<= 3
    for J = 0 to 7
      read V
      vpoke vram.pattern + Off + J, V
    next
    read V
    fill V count 8 to vram.color + Off
  next
  RestoreWords
  copy SpritePat count 1248 to vram.spr_pat
  backdrop black
  return
end sub

' Static text page.  NMI stays off until the caller's SCREEN ON, so the
' BIOS fills below can never be cut by the VBlank register write.
sub MenuPage:
  screen off
  clear sprites
  set sprite count 1
  update sprites
  SetViewReg(MenuReg)
  poke($73F6, 0)
  poke($73F7, MenuPageHi)
  cls
  return
end sub

sub RuleRow(u8 Row):
  fill TRULE count 26 at 3,Row
  return
end sub

sub DrawOptionLine:
  if FlashFx then
    print at 6,9, "FLASHING EFFECTS: ON "
  else
    print at 6,9, "FLASHING EFFECTS: OFF"
  end if
  return
end sub

' Subliminal word letters (copies of BIOS glyphs) in slots 14..25.  The
' title logo borrows these slots, so a new game rebuilds them.
sub RestoreWords:
  for I = 0 to 11
    Off = WordLetters[I]
    Off <<= 3
    D = I + 14
    D <<= 3
    copy vram.pattern + Off count 8 to vram.pattern + D
  next
  SetWordColors
  return
end sub

sub SetWordColors:
  ' Subliminal words stay dim and slow unless flashing effects are on.
  V = $40
  if FlashFx then V = $F0
  fill V count 96 to vram.color + 112
  return
end sub

' Load one tube shape: patterns, eight name pages, ring/spoke colours and
' lane geometry pointers.  Called with the display off.
sub LoadShape(u8 S):
  screen off
  clear sprites
  set sprite count 1
  update sprites
  Shape = S
  OldN = 0
  OvN = 0
  decompress zx0 PatTabs[S] to vram.pattern + 728
  decompress zx0 PagesA[S] to vram.pattern + $0800
  decompress zx0 PagesB[S] to vram.pattern + $2800
  LaneCount = LaneCounts[S]
  SpokeCount = SpokeCounts[S]
  TileCount = TileCounts[S]
  PtrH = HTabs[S]
  PtrMX = MXTabs[S]
  PtrMY = MYTabs[S]
  PtrSG = SGTabs[S]
  PtrFR = FRTabs[S]
  PtrSpk = SpkTabs[S]
  PtrSpkIx = SpkIxTabs[S]
  V = (Level - 1) % 6
  RingCol = RingColors[V]
  ' Whole tunnel range 91..255 (constant count: a u16 variable count
  ' loses the destination address, see bug report)
  V = RingCol << 4
  fill V count 1320 to vram.color + 728
  for I = 0 to SpokeCount - 1
    SetSpoke(I, 4)
  next
  SpkQN = 0
  SweepK = 0
  SpkHi = 0
  RotT = 0
  RotPeriod = 0
  if Level > 1 then
    V = Level * 3
    RotPeriod = 30 - min(V, 22)
  end if
  ShowPage = 0
  PhaseAcc = 0
  SetViewReg(2)
  clear sprites
  set sprite count SprCount
  return
end sub

' Direct R2 write, only while NMI is off (loading and menu set-up).
sub SetViewReg(u8 R):
  ShowReg = R
  LastReg = R
  asm {
    ld a,(ShowReg)
    ld c,a
    ld b,2
    call WRITE_REGISTER
  }
  return
end sub

' Writes the colour rows of every tile of one spoke: rows holding ring
' pixels keep the ring colour, pure spoke rows take colour C.
sub SetSpoke(u8 Sp, u8 C):
  P = PtrSpkIx + Sp
  K = peek(P)
  V = peek(P + 1)
  V = V - K
  if V = 0 then return
  Off = K
  P = PtrSpk + Off + Off
  call asm PB_SPOKE_COLOR with hl = P, b = V, d = RingCol, e = C
  return
end sub

' =========================================================================
' TITLE DECORATION
' =========================================================================
sub DrawTitleText:
  ' big angular POLYBIUS logo: 3 tile rows x 24 columns (rows 2-4,
  ' columns 4-27, inside the CRT-safe area).  Its tiles use the free slots
  ' listed in LogoSlots (see tools/gen_sprites.py).
  nmi off
  P = address of LogoPat
  Off = address of LogoSlots
  call asm PB_SLOT_PATTERNS with hl = P, de = Off, b = LogoTiles
  for I = 0 to 71
    V = LogoMap[I]
    if V != 0 then
      J = I / 24
      K = I % 24
      Off = J + 2
      Off <<= 5
      W = K + 4
      Off += W
      call asm PB_POKE_ALL with hl = Off, a = V
    end if
  next
  LogoCur = 0
  LogoFlashT = 20
  if FlashFx then LogoFlashT = 32
  LogoWait = 0
  LogoColorJob
  nmi on
  PutTextAll(1, 5, 6)
  PutTextAll(2, 8, 7)
  PutTextAll(3, 11, 15)
  PutTextAll(4, 11, 16)
  PutTextAll(5, 11, 17)
  PutTextAll(6, 11, 18)
  PutTextAll(7, 8, 21)
  return
end sub

' Blue logo.  On each arrival at the title it gives ONE short flash
' (white, then cyan, then blue) and stays blue.  With flashing effects ON
' it also repeats an arcade flash burst (white/blue) every 4 seconds.
' The 26 logo tiles are contiguous, so one call recolours them all.
sub LogoColorJob:
  LogoDid = 0
  V = $50
  if LogoFlashT > 0 then
    dec LogoFlashT
    if FlashFx then
      if (LogoFlashT & 4) != 0 then V = $F0
    else
      if LogoFlashT >= 10 then
        V = $F0
      elseif LogoFlashT >= 5 then
        V = $70
      end if
    end if
  elseif FlashFx then
    inc LogoWait
    if LogoWait >= 240 then
      LogoWait = 0
      LogoFlashT = 32
    end if
  end if
  if V = LogoCur then return
  LogoCur = V
  Off = address of LogoSlots
  call asm PB_SLOT_COLORS with de = Off, b = LogoTiles, c = V
  LogoDid = 1
  return
end sub

sub DrawCursor(u8 Erase):
  Off = Choice + 14
  Off <<= 5
  Off += 9
  V = TCURSOR
  if Erase != 0 then V = 0
  nmi off
  call asm PB_POKE_ALL with hl = Off, a = V
  nmi on
  return
end sub

' Writes a zero-terminated text from the Texts table into all 8 pages.
sub PutTextAll(u8 Id, u8 Col, u8 Row):
  P = Texts[Id]
  Off = Row
  Off <<= 5
  Off += Col
  nmi off
  do
    V = peek(P)
    if V = 0 then exit do
    ' spaces become blank tile 0 so no ring or spoke shows inside words
    if V = 32 then V = 0
    call asm PB_POKE_ALL with hl = Off, a = V
    P += 1
    Off += 1
  loop
  nmi on
  return
end sub

sub TitleSprites:
  ' ship orbiting the rim, eye in the centre, a gate drifting outward
  V = K >> 3
  PLane = V % LaneCount
  CalcPos(PLane, 0)
  PFrame = peek(PtrFR + PLane)
  set sprite SprShip to Y - 9,X - 8,PFrame << 2,ColShip
  ' the ship passes behind the logo instead of covering it
  if Y < 48 then hide sprite SprShip
  EyeSprite
  for I = 2 to SprCount - 1
    set sprite I to 207,0,0,0
  next
  V = K & 127
  D = 127 - V
  D <<= 2
  W = (K >> 7) % LaneCount
  if D < TileD then
    CalcPos(W, D)
    set sprite SprGate0 to Y - 9,X - 8,SPGATE0 + GateSize(D),ColGate
  end if
  return
end sub

sub EyeSprite:
  inc EyeT
  V = SPEYE0
  if EyeT >= 170 then V = SPEYE1
  if EyeT >= 180 then EyeT = 0
  set sprite SprEye to 87,120,V,ColEye
  return
end sub

' Credits use the same slow blink as the tunnel eye while retaining the
' familiar press-and-release navigation and 30-second idle timeout.
sub CreditsEyeWait:
  EyeT = 0
  OldPad = 0
  DemoT = 0
  wait no fire
  do
    wait
    inc EyeT
    V = SPEYE0
    if EyeT >= 170 then V = SPEYE1
    if EyeT >= 180 then EyeT = 0
    set sprite 0 to 8,224,V,ColEye
    update sprites
    ReadPad
    if (Edge & $C0) != 0 then exit do
    DemoT += 1
  loop while DemoT < 1800
  wait no fire
  return
end sub

' =========================================================================
' INPUT
' Pad bits: 1 up, 2 right, 4 down, 8 left, $40 left button, $80 right
' button.  Edge holds the bits that became pressed this frame.
' =========================================================================
sub ReadPad:
  Pad = 0
  if joypad(1).up | joypad(2).up then Pad |= 1
  if joypad(1).right | joypad(2).right then Pad |= 2
  if joypad(1).down | joypad(2).down then Pad |= 4
  if joypad(1).left | joypad(2).left then Pad |= 8
  if joypad(1).button1 | joypad(2).button1 then Pad |= $40
  if joypad(1).button2 | joypad(2).button2 then Pad |= $80
  Edge = Pad & (OldPad ^ $FF)
  OldPad = Pad
  return
end sub

' Attract-mode pilot: chases near gates, fires steadily, presses the
' wave when the tube is crowded.  Any real button ends the demo.
sub DemoInput:
  if joypad(1).fire | joypad(2).fire then
    DemoQuit = true
    return
  end if
  Pad = $40
  if (DemoT & 15) > 8 then Pad = 0
  W = 255
  for I = 0 to 1
    if GateOn[I] != 0 then
      if GateD[I] < 360 then W = GateLane[I]
    end if
  next
  if W != 255 then
    if W != PLane then
      V = W - PLane
      if V >= 128 then V = V + LaneCount
      if V < LaneCount / 2 then
        Pad |= 8
      else
        Pad |= 2
      end if
    end if
  end if
  if WaveOk != 0 then
    V = 0
    for I = 0 to 5
      if EnType[I] != 0 then inc V
    next
    if V >= 5 then Pad |= $80
  end if
  Edge = Pad & (OldPad ^ $FF)
  OldPad = Pad
  return
end sub

' =========================================================================
' PLAYER
' =========================================================================
sub PlayerControl:
  ' rotation: RIGHT turns counter-clockwise (rightward at the bottom),
  ' LEFT turns clockwise.  Hold repeats after 8 frames, then every 5.
  V = Pad & $0A
  if V = 0 then
    RepeatT = 0
  else
    if RepeatT = 0 then
      MoveLane
      RepeatT = 8
    else
      dec RepeatT
      if RepeatT = 0 then
        MoveLane
        RepeatT = 5
      end if
    end if
  end if
  if PGlide > 0 then dec PGlide
  ' left button: shot toward the centre (held = autofire)
  if FireT > 0 then dec FireT
  if (Pad & $40) != 0 then
    if FireT = 0 then FireShot
  end if
  ' right button: one wave per life
  if (Edge & $80) != 0 then
    if WaveOk != 0 then FireWave
  end if
  if PSafe > 0 then dec PSafe
  return
end sub

sub MoveLane:
  PFrom = PLane
  if (Pad & 2) != 0 then
    if PLane = 0 then PLane = LaneCount
    dec PLane
  else
    inc PLane
    if PLane >= LaneCount then PLane = 0
  end if
  PGlide = 4
  return
end sub

sub FireShot:
  for I = 0 to 2
    if ShotOn[I] = 0 then
      ShotOn[I] = 1
      ShotLane[I] = PLane
      ShotD[I] = 8
      FireT = 7
      play sound SndShot
      return
    end if
  next
  return
end sub

sub FireWave:
  WaveOk = 0
  WaveT = 24
  play sounds SndWaveN, SndWaveT2
  for I = 0 to 5
    if EnType[I] != 0 then
      if EnD[I] < HiddenD then
        EnType[I] = 0
        Score += 10
      end if
    end if
  next
  SweepK = SpokeCount * 2
  HudDirty |= 3
  return
end sub

sub BuildPlayerSprite:
  if PDead != 0 then
    hide sprite SprShip
    return
  end if
  CalcPos(PLane, 0)
  if PGlide > 0 then
    ' glide between the previous lane and the new lane
    T = X
    J = Y
    CalcPos(PFrom, 0)
    X = Lerp4(X, T, PGlide)
    Y = Lerp4(Y, J, PGlide)
  end if
  PX = X
  PY = Y
  PFrame = peek(PtrFR + PLane)
  V = ColShip
  if PSafe > 0 then V = ColShipSafe
  set sprite SprShip to PY - 9,PX - 8,PFrame << 2,V
  EyeSprite
  return
end sub

sub KillPlayer:
  if PSafe > 0 then return
  play sounds SndHitT, SndHitN
  BoomX = PX
  BoomY = PY
  BoomT = 18
  PDead = 70
  dec Lives
  SpeedLvl = BaseSpeed
  Mult = 1
  HudDirty |= $0F
  return
end sub

' =========================================================================
' TUNNEL MOTION
' =========================================================================
sub AdvanceTunnel:
  SpeedQ = SpeedTab[SpeedLvl]
  PhaseAcc += SpeedQ
  ShowPage = (PhaseAcc >> 4) & 7
  ShowReg = PageRegs[ShowPage]
  RotateSpokes
  ' the in-game pulse follows the tunnel speed: three tempi
  V = 0
  if SpeedLvl >= 3 then V = 1
  if SpeedLvl >= 5 then V = 2
  if V != MusicFast then
    if PDead = 0 then GameMusic
  end if
  return
end sub

sub RotateSpokes:
  if defined QA_NOROT
    return
  end defined
  if RotPeriod = 0 then return
  inc RotT
  if RotT < RotPeriod then return
  RotT = 0
  if SpkQN > 4 then return
  ' dim the trailing spoke, brighten the new one, mid on the old one
  V = SpkHi
  if (Level & 1) != 0 then
    inc SpkHi
    if SpkHi >= SpokeCount then SpkHi = 0
  else
    if SpkHi = 0 then SpkHi = SpokeCount
    dec SpkHi
  end if
  QueueSpoke(V, 5)
  QueueSpoke(SpkHi, 15)
  ' the spoke two steps behind the highlight returns to dark blue
  if (Level & 1) != 0 then
    W = V + SpokeCount - 1
  else
    W = V + 1
  end if
  W = W % SpokeCount
  QueueSpoke(W, 4)
  return
end sub

sub QueueSpoke(u8 Sp, u8 C):
  if SpkQN >= 8 then return
  SpkQ[SpkQN] = Sp
  SpkQC[SpkQN] = C
  inc SpkQN
  return
end sub

' One secondary VRAM job per frame (budget): HUD first, then spokes.
sub SecondaryJob:
  if HudDirty != 0 then
    HudJob
    return
  end if
  SpokeJob
  return
end sub

sub SpokeJob:
  if SweepK > 0 then
    ' wave effect: a bright sweep around every spoke
    dec SweepK
    V = SweepK % SpokeCount
    if SweepK >= SpokeCount then
      SetSpoke(V, 15)
    else
      SetSpoke(V, 4)
    end if
    return
  end if
  if SpkQN = 0 then return
  SetSpoke(SpkQ[0], SpkQC[0])
  dec SpkQN
  for I = 0 to 6
    SpkQ[I] = SpkQ[I + 1]
    SpkQC[I] = SpkQC[I + 1]
  next
  return
end sub

' Screen position of lane L at depth Dd (0 = rim).  Result in X,Y.
' h = t/2 from the perspective table, lane offsets are small multiples.
sub CalcPos(u8 L, u16 Dd):
  ' private scratch CD/CV/CW so callers may keep V, W and D
  CD = Dd >> 3
  if CD > 127 then CD = 127
  H = peek(PtrH + CD)
  M = peek(PtrMX + L)
  CV = M * H
  CW = peek(PtrSG + L)
  if (CW & 1) != 0 then
    X = 128 - CV
  else
    X = 128 + CV
  end if
  M = peek(PtrMY + L)
  CV = M * H
  if (CW & 2) != 0 then
    Y = 96 - CV
  else
    Y = 96 + CV
  end if
  return
end sub

' Moves from B toward A: result = B + (A - B) * G / 4, G = 0..4
function Lerp4(u8 A, u8 B, u8 G) as u8
  if A >= B then return B + ((A - B) >> 2) * G
  return B - ((B - A) >> 2) * G

function GateSize(u16 Dd) as u8
  if Dd < 90 then return 8
  if Dd < 180 then return 4
  return 0

function EnSize(u16 Dd) as u8
  if Dd < 90 then return 2
  if Dd < 180 then return 1
  return 0

' Adds a far-object tile at the cell under X,Y in the page shown next.
sub AddOverlay(u8 Tl):
  if OvN >= MaxOv then return
  J = X >> 3
  K = Y >> 3
  if J >= CoreCol0 then
    if J <= CoreCol1 then
      if K >= CoreRow0 then
        if K <= CoreRow1 then return
      end if
    end if
  end if
  Off = K
  Off <<= 5
  Off += J
  OvLo[OvN] = lowbyte(Off)
  OvHi[OvN] = highbyte(Off) + PageHi[ShowPage]
  OvT[OvN] = Tl
  inc OvN
  return
end sub

' =========================================================================
' SHOTS, ENEMIES, GATES
' =========================================================================
sub MoveShots:
  for I = 0 to 2
    V = SprShot0 + I
    if ShotOn[I] != 0 then
      ShotD[I] += 22
      if ShotD[I] >= TileD then
        ShotOn[I] = 0
        hide sprite V
      else
        CalcPos(ShotLane[I], ShotD[I])
        W = SPSHOT1
        if ShotD[I] > 140 then W = SPSHOT0
        set sprite V to Y - 9,X - 8,W,ColShot
      end if
    else
      hide sprite V
    end if
  next
  return
end sub

sub MoveEnemies:
  for I = 0 to 5
    V = SprEn0 + I
    T = EnType[I]
    if T = 0 then
      hide sprite V
      continue for
    end if
    ' rim crawler (from level 2): an enemy that reaches the rim crawls
    ' along it toward the ship, gliding smoothly 2 px per frame.  When it
    ' lands in the ship's lane it turns white and grabs after 24 frames:
    ' shoot it (it is in your lane) or move away.
    if EnRim[I] > 0 then
      dec EnRim[I]
      if EnRim[I] = 0 then
        EnType[I] = 0
        hide sprite V
        continue for
      end if
      ' target position is cached (EnTX/EnTY) and only recomputed on a step
      EnX[I] = Approach(EnX[I], EnTX[I])
      EnY[I] = Approach(EnY[I], EnTY[I])
      W = EnCol[T]
      if EnLane[I] = PLane then
        ' grabbing: a shot in this lane close to the rim destroys it
        W = 15
        if EnGrab[I] = 0 then
          EnGrab[I] = 1
          EnTick[I] = 0
        end if
        for J = 0 to 2
          if ShotOn[J] != 0 then
            if ShotLane[J] = PLane then
              if ShotD[J] < 70 then
                ShotOn[J] = 0
                EnD[I] = 0
                KillEnemy
                exit for
              end if
            end if
          end if
        next
        if EnType[I] = 0 then continue for
        inc EnTick[I]
        if EnTick[I] >= 24 then
          if PDead = 0 then KillPlayer
          EnType[I] = 0
          hide sprite V
          continue for
        end if
      else
        if EnGrab[I] != 0 then
          EnGrab[I] = 0
          EnTick[I] = 0
        end if
        inc EnTick[I]
        if EnTick[I] >= CrawlRate then
          EnTick[I] = 0
          StepTowardPlayer
          CalcPos(EnLane[I], 0)
          EnTX[I] = X
          EnTY[I] = Y
        end if
      end if
      set sprite V to EnY[I] - 9,EnX[I] - 8,EnBase[T] + 8,W
      continue for
    end if
    ' approach: tunnel speed plus own speed
    W = SpeedQ + EnSpeed[T]
    if Level < 3 then W = SpeedQ + 1
    if EnD[I] <= W then
      ' reached the rim
      if EnLane[I] = PLane then
        if PDead = 0 then KillPlayer
        EnType[I] = 0
        hide sprite V
        continue for
      end if
      if Level >= 2 then
        if CountCrawlers() < 2 then
          EnD[I] = 0
          EnRim[I] = 150
          EnTick[I] = 0
          EnGrab[I] = 0
          CalcPos(EnLane[I], 0)
          EnX[I] = X
          EnY[I] = Y
          EnTX[I] = X
          EnTY[I] = Y
          continue for
        end if
      end if
      EnType[I] = 0
      hide sprite V
      continue for
    end if
    EnD[I] -= W
    ' lane changes
    inc EnTick[I]
    ' no lane change on the final approach: the last 0.5 s is readable
    M = T
    if EnD[I] < 200 then M = 1
    if M = 2 then
      if (EnTick[I] & 31) = 0 then
        if (EnTick[I] & 32) != 0 then
          inc EnLane[I]
          if EnLane[I] >= LaneCount then EnLane[I] = 0
        else
          if EnLane[I] = 0 then EnLane[I] = LaneCount
          dec EnLane[I]
        end if
      end if
    end if
    if M = 3 then
      if (EnTick[I] & 15) = 0 then
        inc EnLane[I]
        if EnLane[I] >= LaneCount then EnLane[I] = 0
      end if
    end if
    ' shot collisions (same lane, depths overlap)
    for J = 0 to 2
      if ShotOn[J] != 0 then
        if ShotLane[J] = EnLane[I] then
          D = ShotD[J] + 30
          if EnD[I] < D then
            ShotOn[J] = 0
            KillEnemy
            exit for
          end if
        end if
      end if
    next
    if EnType[I] = 0 then continue for
    ' draw: hidden deep in the core, far as a tile, near as a sprite
    D = EnD[I]
    if D >= HiddenD then
      hide sprite V
    elseif D >= TileD then
      hide sprite V
      CalcPos(EnLane[I], D)
      AddOverlay(EnTile[T])
    else
      CalcPos(EnLane[I], D)
      W = EnBase[T] + EnSize(D) * 4
      if T = 3 then
        ' spiral frames are interleaved A0,B0,A1,B1,A2,B2: 8 per size
        W = EnBase[T] + EnSize(D) * 8
        if (EnTick[I] & 4) != 0 then W += 4
      end if
      set sprite V to Y - 9,X - 8,W,EnCol[T]
    end if
  next
  return
end sub

' Moves enemy I one lane along the shortest way toward the ship.
' Moves a coordinate toward its target by at most 2 pixels.
function Approach(u8 Cur, u8 Tgt) as u8
  if Cur + 2 < Tgt then return Cur + 2
  if Tgt + 2 < Cur then return Cur - 2
  return Tgt
' Crawlers currently on the rim (at most two at a time).
function CountCrawlers as u8
  K = 0
  for J = 0 to 5
    if EnRim[J] > 0 then
      if EnType[J] != 0 then inc K
    end if
  next
  return K

' Fast xorshift PRNG (PB_RAND).  The BIOS-based random(a, b) re-draws
' until the value fits the range; with 12 lanes it cost a frame now and then.
function Rand8 as u8
  call asm PB_RAND
  return RndOut
function RandLane as u8
  K = Rand8() & 15
  if K >= LaneCount then K = K - LaneCount
  if K >= LaneCount then K = K & 7
  return K

sub StepTowardPlayer:
  K = PLane + LaneCount - EnLane[I]
  K = K % LaneCount
  if K = 0 then return
  if K <= LaneCount / 2 then
    inc EnLane[I]
    if EnLane[I] >= LaneCount then EnLane[I] = 0
  else
    if EnLane[I] = 0 then EnLane[I] = LaneCount
    dec EnLane[I]
  end if
  return
end sub

sub KillEnemy:
  play sound SndBoomN
  CalcPos(EnLane[I], EnD[I])
  BoomX = X
  BoomY = Y
  BoomT = 9
  T = EnType[I]
  EnType[I] = 0
  hide sprite SprEn0 + I
  for K = 1 to Mult
    if T = 1 then Score += 10
    if T = 2 then Score += 20
    if T = 3 then Score += 30
  next
  HudDirty |= 1
  return
end sub

sub MoveGates:
  for I = 0 to 1
    V = SprGate0 + I
    if GateOn[I] = 0 then
      hide sprite V
      continue for
    end if
    if GateD[I] <= SpeedQ then
      GateOn[I] = 0
      hide sprite V
      if PDead = 0 then
        if GateLane[I] = PLane then
          PassGate
        else
          MissGate
        end if
      end if
      continue for
    end if
    GateD[I] -= SpeedQ
    D = GateD[I]
    if D >= HiddenD then
      hide sprite V
    elseif D >= TileD then
      hide sprite V
      CalcPos(GateLane[I], D)
      AddOverlay(TFARGATE)
    else
      CalcPos(GateLane[I], D)
      set sprite V to Y - 9,X - 8,SPGATE0 + GateSize(D),ColGate
    end if
  next
  return
end sub

sub PassGate:
  play sounds SndGate1, SndGate2, SndGateN
  if SpeedLvl < 7 then inc SpeedLvl
  if Mult < 8 then inc Mult
  inc GatesDone
  for K = 1 to Mult
    Score += 50
  next
  HudDirty |= $0D
  if FlashFx then WaveT = 6
  return
end sub

sub MissGate:
  play sound SndMiss
  if SpeedLvl > BaseSpeed then dec SpeedLvl
  if Mult > 1 then dec Mult
  HudDirty |= $0C
  return
end sub

sub Spawner:
  if PDead != 0 then return
  dec SpawnT
  if SpawnT = 0 then
    V = Level * 5
    SpawnT = 66 - min(V, 44) + (Rand8() & 15)
    for I = 0 to 5
      if EnType[I] = 0 then
        T = 1
        if Level >= 2 then T = 1 + (Rand8() & 1)
        if Level >= 3 then
          T = Rand8() & 3
          if T = 0 then T = 1 + (Rand8() & 1)
        end if
        EnType[I] = T
        EnLane[I] = RandLane()
        EnD[I] = SpawnD
        EnTick[I] = 0
        EnRim[I] = 0
        exit for
      end if
    next
  end if
  dec GateT
  if GateT = 0 then
    GateT = 110 + (Rand8() & 31)
    for I = 0 to 1
      if GateOn[I] = 0 then
        GateOn[I] = 1
        GateLane[I] = RandLane()
        GateD[I] = SpawnD
        exit for
      end if
    next
  end if
  return
end sub

' Explosion sprite, wave ring, level message, subliminal words
sub Effects:
  if BoomT > 0 then
    dec BoomT
    V = SPBOOM0 + ((8 - min(BoomT, 8)) / 3) * 4
    set sprite SprBoom to BoomY - 9,BoomX - 8,V,ColBoom
  else
    hide sprite SprBoom
  end if
  if WaveT > 0 then
    dec WaveT
    set sprite SprWave to 87,120,SPWAVE,7
    nmi off
    if FlashFx then
      if (WaveT & 2) != 0 then
        backdrop white
      else
        backdrop black
      end if
    end if
    if WaveT = 0 then backdrop black
    nmi on
  else
    hide sprite SprWave
  end if
  if MsgT > 0 then
    dec MsgT
    ' "LV n" in the centre of the tube for 1.5 seconds
    X = 108
    Y = 128
    AddOverlay(76)
    X = 116
    AddOverlay(86)
    X = 132
    AddOverlay(48 + (Level % 10))
    if Level >= 10 then
      X = 124
      AddOverlay(48 + Level / 10)
    end if
  end if
  ' discreet subliminal word, every 25 to 50 seconds
  if SubT > 0 then
    dec SubT
    P = WordTab[SubWord]
    X = peek(P)
    Y = 136
    P += 1
    do
      V = peek(P)
      if V = 0 then exit do
      if V != 32 then AddOverlay(V)
      X += 8
      P += 1
    loop
  else
    if DemoMode = false then
      dec SubWait
      if SubWait = 0 then
        ' (u16 = random(0, 1500) crashes the compiler: see bug report)
        V = Rand8()
        SubWait = V
        SubWait <<= 3
        SubWait += 1500
        SubWord = Rand8() & 7
        if SubWord >= 7 then SubWord = 0
        SubT = 6
        if FlashFx then SubT = 2
      end if
    end if
  end if
  return
end sub

' =========================================================================
' HUD (icons and colours; written into all eight pages)
' HudDirty bits: 1 score, 2 lives+wave, 4 speed bar, 8 multiplier pips
' =========================================================================
sub DrawHudAll:
  nmi off
  for I = 0 to 1
    Off = 56 + I
    V = 76
    if I != 0 then V = 86
    call asm PB_POKE_ALL with hl = Off, a = V
  next
  W = 48 + (Level % 10)
  Off = 59
  call asm PB_POKE_ALL with hl = Off, a = W
  W = 0
  if Level >= 10 then W = 48 + Level / 10
  Off = 58
  call asm PB_POKE_ALL with hl = Off, a = W
  nmi on
  HudDirty = $0F
  for I = 0 to 3
    HudJob
  next
  return
end sub

sub HudJob:
  nmi off
  if (HudDirty & 1) != 0 then
    HudDirty &= $FE
    format Score into ScoreBuf
    for Hx = 0 to 5
      Off = 34 + Hx
      V = ScoreBuf[Hx]
      call asm PB_POKE_ALL with hl = Off, a = V
    next
  elseif (HudDirty & 2) != 0 then
    HudDirty &= $FD
    for Hx = 0 to 4
      Off = 706 + Hx
      V = 0
      if Hx < Lives then V = TLIFE
      call asm PB_POKE_ALL with hl = Off, a = V
    next
    Off = 712
    V = TWAVEOFF
    if WaveOk != 0 then V = TWAVEON
    call asm PB_POKE_ALL with hl = Off, a = V
  elseif (HudDirty & 4) != 0 then
    HudDirty &= $FB
    ' speed bar: 4 cells, each empty, half or full (8 steps)
    for Hx = 0 to 3
      Off = 694 + Hx
      V = SpeedLvl + 1
      W = Hx * 2
      if V >= W + 2 then
        T = TBAR2
      elseif V = W + 1 then
        T = TBAR1
      else
        T = TBAR0
      end if
      call asm PB_POKE_ALL with hl = Off, a = T
    next
  else
    HudDirty = 0
    for Hx = 0 to 7
      Off = 726 + Hx
      V = TPIPOFF
      if Hx < Mult then V = TPIPON
      call asm PB_POKE_ALL with hl = Off, a = V
    next
  end if
  nmi on
  return
end sub

' =========================================================================
' MUSIC
' Title: 4-voice theme (32 s loop).  In game: a 3-voice pulse (tone 2,
' noise bass/drums, muted tone-3 pitch) in three tempi that follow the
' tunnel speed; tone 1 stays free for the shots.  Effects use the four
' areas after the music, so a tempo change never cuts an effect.
' =========================================================================
' OS7 has no per-area stop: reinstalling the table frees every area.
sub StopAllSound:
  set sound table SndTable areas 7
  mute all
  return
end sub

' all voices of a tune are started inside one NMI-free batch so that
' they begin on the same frame and stay in step for ever
sub StartTitleMusic:
  StopAllSound
  nmi off
  play sounds SndTit1, SndTit2, SndTit3, SndTit4
  nmi on
  return
end sub

sub StartMusic:
  StopAllSound
  MusicFast = 255
  GameMusic
  return
end sub

' (re)start the in-game pulse for the current speed, effects untouched
sub GameMusic:
  V = 0
  if SpeedLvl >= 3 then V = 1
  if SpeedLvl >= 5 then V = 2
  MusicFast = V
  nmi off
  if V = 0 then play sounds SndG0a, SndG0b, SndG0c
  if V = 1 then play sounds SndG1a, SndG1b, SndG1c
  if V = 2 then play sounds SndG2a, SndG2b, SndG2c
  nmi on
  return
end sub

sub VblankTick:
  ' The only per-frame register write of the tunnel: name-table base R2.
  ' Written only when it changes, so static screens never see a VDP
  ' control write from the interrupt.
  asm {
    ld a,(ShowReg)
    ld hl,LastReg
    cp (hl)
    jr z,PB_VBL_SAME
    ld (hl),a
    ld c,a
    ld b,2
    call WRITE_REGISTER
PB_VBL_SAME:
  }
  return
end sub
