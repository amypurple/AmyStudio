' =========================================================================
' VDP HELPERS (Z80)
' All three run inside an Amy "nmi off" batch, right after WAIT.
' Data-port accesses are spaced by at least 29 cycles (8 us), so a batch
' that runs past VBlank still never drops a write on a real TMS9918A.
' VDP ports: $BE data, $BF control.
' =========================================================================
asm {
; -------------------------------------------------------------------------
; PB_POKE_ALL: write one tile into the same cell of all 8 tunnel pages.
; In : HL = cell offset (0..767), A = tile
; Out: -           Clobbers: AF, BC, DE
; Cost: 8 x (2 control + 1 data) port writes, about 80 cycles per page.
PB_POKE_ALL:
    ld e,a
    ld bc,PageHi
    ld d,8
PB_POKE_ALL_LOOP:
    ld a,l
    out ($BF),a
    ld a,(bc)
    add a,h
    or $40
    out ($BF),a
    ld a,e
    out ($BE),a
    inc bc
    dec d
    jr nz,PB_POKE_ALL_LOOP
    ret

; -------------------------------------------------------------------------
; PB_TILE_COLORS: give B consecutive tiles (from tile A) the same 8 colour
; rows taken from the buffer at HL.  Used for the title logo gradient.
; Clobbers: AF, BC, DE, HL.  30+ cycles between data writes.
PB_TILE_COLORS:
    ld e,a
PB_TC_TILE:
    push bc
    push hl
    ld l,e
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    pop hl
    push hl
    ld b,8
PB_TC_ROW:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    djnz PB_TC_ROW
    pop hl
    pop bc
    inc e
    djnz PB_TC_TILE
    ret

; -------------------------------------------------------------------------
; PB_SLOT_PATTERNS: upload B tiles of 8 pattern bytes (HL) into the
; pattern slots listed at DE.   Clobbers: AF, BC, DE, HL.
PB_SLOT_PATTERNS:
    push bc
    push hl
    ld a,(de)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop hl
    ld b,8
PB_SP_ROW:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    djnz PB_SP_ROW
    pop bc
    inc de
    djnz PB_SLOT_PATTERNS
    ret

; -------------------------------------------------------------------------
; PB_SLOT_COLORS: give the B tiles listed at DE the colour byte C on all
; 8 rows.   Clobbers: AF, B, DE, HL.
PB_SLOT_COLORS:
    push bc
    ld a,(de)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld b,8
PB_SC_ROW:
    ld a,c
    out ($BE),a
    ex (sp),hl
    ex (sp),hl
    djnz PB_SC_ROW
    pop bc
    inc de
    djnz PB_SLOT_COLORS
    ret

; -------------------------------------------------------------------------
; PB_RAND: 16-bit xorshift, result byte in RndOut.  Clobbers AF, HL.
PB_RAND:
    ld hl,(RndSeed)
    ld a,r
    xor l
    ld l,a
    ld a,h
    rra
    ld a,l
    rra
    xor h
    ld h,a
    ld a,l
    rra
    ld a,h
    rra
    xor l
    ld l,a
    xor h
    ld h,a
    ld (RndSeed),hl
    ld (RndOut),a
    ret

; -------------------------------------------------------------------------
; PB_SAT_UPLOAD: slow-safe copy of the Amy sprite shadow table to $1B00.
; Same result as UPDATE SPRITES (colour byte masked with $8F, $D0
; terminator) but with about 40 cycles between data writes, so it stays
; correct even if a late frame starts it after VBlank.  openMSX found one
; lost write in the OUTI uploader during a 120 s stress run.
; Clobbers: AF, BC, HL.
PB_SAT_UPLOAD:
    xor a
    out ($BF),a
    ld a,$5B
    out ($BF),a
    ld a,(AMY_SPRITE_COUNT)
    or a
    jr z,PB_SAT_END
    ld b,a
    ld hl,AMY_SPRITE_TABLE
PB_SAT_LOOP:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    and $8F
    out ($BE),a
    inc hl
    djnz PB_SAT_LOOP
PB_SAT_END:
    nop
    nop
    ld a,$D0
    out ($BE),a
    ret

; -------------------------------------------------------------------------
; PB_OVERLAY_FLUSH: restore the cells drawn last frame (reverse order, so
; stacked cells unwind correctly), then draw this frame's far objects and
; remember the tiles underneath.
; Lists (Amy globals): OldN/OldLo/OldHi/OldS and OvN/OvLo/OvHi/OvT.
; Clobbers: AF, BC, DE, HL.
; Cost: old N x 3 port writes, new N x (3 writes + 1 read + 3 writes).
PB_OVERLAY_FLUSH:
    ld a,(OldN)
    or a
    jr z,PB_OVF_NEW
    ld b,a
PB_OVF_REST:
    ld e,b
    dec e
    ld d,0
    ld hl,OldLo
    add hl,de
    ld a,(hl)
    out ($BF),a
    ld hl,OldHi
    add hl,de
    ld a,(hl)
    or $40
    out ($BF),a
    ld hl,OldS
    add hl,de
    ld a,(hl)
    out ($BE),a
    djnz PB_OVF_REST
PB_OVF_NEW:
    ld a,(OvN)
    ld (OldN),a
    or a
    ret z
    ld b,a
    ld de,0
PB_OVF_DRAW:
    ld hl,OvLo
    add hl,de
    ld a,(hl)
    ld hl,OldLo
    add hl,de
    ld (hl),a
    out ($BF),a
    ld hl,OvHi
    add hl,de
    ld a,(hl)
    ld hl,OldHi
    add hl,de
    ld (hl),a
    and $3F
    out ($BF),a             ; read set-up: the VDP fetches the byte
    ex (sp),hl              ; 38 cycles of patience before reading
    ex (sp),hl
    in a,($BE)
    ld hl,OldS
    add hl,de
    ld (hl),a
    ld hl,OldLo
    add hl,de
    ld a,(hl)
    out ($BF),a
    ld hl,OldHi
    add hl,de
    ld a,(hl)
    or $40
    out ($BF),a
    ld hl,OvT
    add hl,de
    ld a,(hl)
    out ($BE),a
    inc e
    djnz PB_OVF_DRAW
    ret

; -------------------------------------------------------------------------
; PB_SPOKE_COLOR: recolour every tile of one spoke.
; In : HL = list of (tile, ring-row mask) pairs, B = pair count,
;      D = ring colour (low nibble), E = spoke colour (low nibble)
; Rows whose mask bit is set keep the ring colour; other rows take the
; spoke colour.  Background nibble 0 (transparent, black backdrop).
; Clobbers: AF, BC, DE, HL.  About 45 cycles per data write.
PB_SPOKE_COLOR:
    ld a,d
    add a,a
    add a,a
    add a,a
    add a,a
    ld d,a
    ld a,e
    add a,a
    add a,a
    add a,a
    add a,a
    ld e,a
PB_SPK_TILE:
    push bc
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60                  ; $2000 colour table + $40 write flag
    out ($BF),a
    ld b,8
PB_SPK_ROW:
    rrc c
    ld a,e
    jr nc,PB_SPK_PUT
    ld a,d
PB_SPK_PUT:
    out ($BE),a
    djnz PB_SPK_ROW
