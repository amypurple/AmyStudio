' tunnel speed in 1/16 page per frame (16 = one page per frame)
data SpeedTab bytes 4,5,7,9,11,14,17,21

' ring colours by level (cyan, light green, magenta, light blue, white, yellow)
data RingColors bytes 7,3,13,5,15,11

' enemy types 1 triangle, 2 diamond, 3 spiral (index 0 unused)
data EnSpeed bytes 0,2,2,1
data EnTile bytes 0,9,10,11
data EnCol bytes 0,9,3,10
data EnBase bytes 0,64,76,88

