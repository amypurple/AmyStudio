asm {
PdYou:
    db $40,$5F,$20,$03,$40,$47,$30,$03,$40,$47,$50,$06,$40,$47,$F0,$01,$50
PdCpu:
    db $00,$00,$25,$03,$00,$00,$36,$04,$00,$00,$66,$06,$00,$00,$F6,$01,$10
PdTick:
    db $40,$40,$60,$01,$50
PdWin:
    db $40,$8F,$20,$06,$40,$71,$20,$06,$40,$5F,$20,$06,$40,$47,$20,$10,$40,$47,$F0,$01,$50
PdLose:
    db $40,$D6,$20,$08,$40,$F0,$20,$08,$40,$0E,$21,$08,$40,$41,$31,$14,$40,$41,$F1,$01,$50

PdSoundTable:
    dw PdTuneMel,$702B
    dw PdTuneBass,$7035
    dw PdYou,$7049
    dw PdCpu,$703F
    dw PdTick,$7049
    dw PdWin,$7049
    dw PdLose,$7049
; Heads or Tails, A minor (original for this game)
; Tiny Sound, 8 frames per step
PdTuneMel:
    db $44
    dw sndtiny_1
    db 8
