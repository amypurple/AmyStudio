data SpritePat bytes
  $03,$06,$04,$06,$03,$3F,$2A,$3F,$0C,$19,$33,$60,$E0,$00,$00,$00
  $C0,$60,$20,$60,$C0,$FC,$54,$FC,$30,$98,$CC,$06,$07,$00,$00,$00
  $00,$03,$01,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$C0,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$03,$03,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$C0,$C0,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$07,$03,$03,$01,$01,$00,$01,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$E0,$C0,$C0,$80,$80,$00,$80,$00,$00,$00,$00,$00,$00,$00,$00
