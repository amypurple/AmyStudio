asm {
; TcAge: every crystal one stage older (stage bits shift left, a shell
; melts; bits 4-7 stay), as the C64's $C21F. Uses AF BC DE HL.
TcAge:
    ld hl,AMY_UVAR_Bd
    ld b,0
TcAgeL:
    ld a,(hl)
    ld c,a
    and 15
    jr z,TcAgeN
    add a,a
    and 15
    ld d,a
    ld a,c
    and $F0
    or d
    ld (hl),a
TcAgeN:
    inc hl
    djnz TcAgeL
    ret

; TcTiles: the 256 tile codes of the grid into Tl, and Cnt[colour] (u16)
; = the living crystals of each colour. Uses AF BC DE HL IY.
TcTiles:
    ld hl,AMY_UVAR_Cnt
    ld b,16
    xor a
TcTz:
    ld (hl),a
    inc hl
    djnz TcTz
    ld hl,AMY_UVAR_Bd
    ld de,AMY_UVAR_Tl
    ld b,0
TcTL:
    ld a,(hl)
    ld c,a
    rrca
    rrca
    rrca
    rrca
    and 7
    push hl
    ld l,a                  ; L = colour
    ld a,c
    and 15
    jr z,TcTWater
    ; a crystal: TCr + StageOff[stage] + colour; Cnt[colour] += 1
    push de
    ld e,a
    ld d,0
    push hl
    ld hl,TcStageOff
    add hl,de
    ld a,(hl)
    pop hl
    add a,l
    add a,AMY_UCONST_TCr
    ld c,a
    ld a,l
    add a,a
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Cnt
    add hl,de
    inc (hl)
    jr nz,TcTnc
    inc hl
    inc (hl)
TcTnc:
    pop de
    jr TcTPut
TcTWater:
    ld a,(AMY_UVAR_Traces)
    or a
    jr z,TcTPlain
    bit 7,c
    jr z,TcTPlain
    ld a,l
    add a,AMY_UCONST_TTr0
    ld c,a
    jr TcTPut
TcTPlain:
    ld c,AMY_UCONST_TWater
TcTPut:
    ld a,c
    ld (de),a
    inc de
    pop hl
    inc hl
    djnz TcTL
    ret
TcStageOff:
    db 0,0,8,0,16,0,0,0,24
TcMove:
    db $40,$40,$70,$01,$50
TcPlant:
    db $40,$6B,$30,$02,$40,$47,$30,$02,$40,$35,$50,$05,$50
TcBad:
    db $00,$00,$25,$04,$00,$00,$46,$08,$10
TcCh1:
    db $40,$55,$80,$02,$40,$55,$B0,$06,$50
TcCh2:
    db $40,$47,$80,$02,$40,$47,$B0,$06,$50
TcCh3:
    db $40,$40,$80,$02,$40,$40,$B0,$06,$50
TcCh4:
    db $40,$35,$80,$02,$40,$35,$B0,$06,$50
TcCh5:
    db $40,$30,$80,$02,$40,$30,$B0,$06,$50
TcDrop:
    db $40,$2A,$40,$02,$40,$39,$40,$02,$40,$55,$50,$04,$50
TcWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$55,$20,$1E,$50
TcTie:
    db $40,$AA,$20,$0A,$40,$BF,$20,$0A,$40,$D6,$30,$18,$50

TcSoundTable:
    dw TcTuneMel,$702B
    dw TcTuneBass,$7035
    dw TcMove,$7049
    dw TcPlant,$7049
    dw TcBad,$703F
    dw TcCh1,$7049
    dw TcCh2,$7049
    dw TcCh3,$7049
    dw TcCh4,$7049
    dw TcCh5,$7049
    dw TcDrop,$7049
    dw TcWin,$7049
    dw TcTie,$7049
; Ice Bloom (original)
; Tiny Sound, 9 frames per step
TcTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$23,$26,$2A,$01,$28,$26,$23,$01,$21,$25,$28,$01
    db $26,$25,$21,$01,$1F,$23,$26,$01,$2A,$28,$26,$01,$25,$28,$2A,$01
    db $2A,$01,$01,$01,$23,$26,$2A,$01,$2F,$2D,$2A,$01,$2B,$2A,$28,$01
    db $26,$28,$25,$01,$23,$1E,$23,$01,$26,$25,$22,$01,$23,$01,$01,$01
    db $01,$00,$01,$01
    db $FF
TcTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$0B,$01,$12,$01,$0B,$01,$12,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$06,$01,$0D,$01
    db $06,$01,$0A,$01,$0B,$01,$12,$01,$0B,$01,$0E,$01,$04,$01,$0B,$01
    db $09,$01,$10,$01,$06,$01,$0B,$01,$06,$01,$0D,$01,$0B,$01,$06,$01
    db $0B,$00,$01,$01
    db $FF
}
