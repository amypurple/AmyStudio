project "INLINE QUALIFIED MUTATIONS SELFTEST"
memory "colecovision_legacy_sdcc"

record GameState:
  u8 Counter
  u8 Neighbor
  bcd digits 4 Score
end record

overlay SharedRam
  Game as GameState
  Menu as GameState
end overlay

bool Enabled = true
bool PackedFlag = false
u8 Passed = 0

sub start:
  text screen
  backdrop dark blue
  print centered at 5, "INLINE MUTATIONS"

  SharedRam.Game.Counter = 9
  SharedRam.Game.Neighbor = 77
  SharedRam.Game.Score = 99

  if Enabled then inc SharedRam.Game.Counter
  if Enabled then dec SharedRam.Game.Counter
  if Enabled then inc SharedRam.Game.Score
  if Enabled then dec SharedRam.Game.Score
  if Enabled then toggle SharedRam.Game.Counter
  if Enabled then toggle SharedRam.Game.Counter
  if Enabled then toggle PackedFlag
  swap SharedRam.Game.Counter with SharedRam.Game.Neighbor
  swap SharedRam.Game.Counter with SharedRam.Game.Neighbor

  if SharedRam.Game.Counter = 9 then Passed += 1
  if SharedRam.Game.Neighbor = 77 then Passed += 1
  if SharedRam.Game.Score = 99 then Passed += 1
  if PackedFlag then Passed += 1
  if Enabled then Passed += 1
  if SharedRam.Menu.Counter = 9 then Passed += 1

  print at 8,10, "EXPECTED: PASS 6/6"
  if Passed = 6 then
    print at 8,12, "RESULT:   PASS 6/6"
  else
    print at 8,12, "RESULT:   FAIL"
  end if
  screen on
  loop forever
end sub
