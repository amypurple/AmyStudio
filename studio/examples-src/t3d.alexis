cartridge "3-D TIC TAC TOE/COMPUTE'S GAZETTE/1984"

' 3-D TIC TAC TOE
' A ColecoVision game based on "3-D Tic Tac Toe", COMPUTE!'s Gazette,
' June 1984 (Commodore 64 and VIC-20, BASIC; two players). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The game: a 3 x 3 x 3 cube shown as three layers (top, middle, bottom).
' Two players take turns claiming cells, X (player 1) and O (player 2).
' Three in a row along any of the cube's 49 lines wins the round: rows,
' columns and diagonals in a layer, pillars through the three layers, and
' the slanting lines through them. The match lasts the number of rounds
' chosen on the title; the player with more rounds won takes the match.
'
' From the original (orig/): the cube of 27 cells shown as three stacked
' boards, cell 1 at the top left of the top layer; the cursor that steps
' one cell at a time through the 27 cells in order (left and right) and
' stops at both ends; the button claims the cell under it, a taken cell
' gets a low buzz and nothing else; the click of a step, the ping of a
' claim; the win test of the listing: only the lines through the cell
' just claimed, from its table of cell pairs (DATA 1080-1185); the three
' winning cells flash with a falling run of ten notes; the round's
' winner gets a point; the board is cleared and the OTHER player opens
' the next round (the listing swaps turns after a win too); the cursor
' goes back to cell 1; the number of rounds asked at the start (here 1
' to 9 on the title); after the last round the final score of both
' players. There is no computer player in the original: it is a game for
' two, each on his own joystick.
'
' Liberties: the listing's table misses one line through the centre (the
' pillar of the three layer centres, 5-14-23, when the centre is claimed
' last): it is added here (lines.py). Up and down on the stick also move
' the cursor a whole row (three cells), through the layers, as well as
' the listing's left and right; a held stick repeats. Either controller
' plays for the player whose turn it is (one controller passed between
' two players works too). No names typed: PLAYER 1 and PLAYER 2. The
' cursor glides between cells instead of blinking; the winning cells
' flash white at 2.5 Hz instead of random colours. A board filled with no
' line (impossible on a 3 x 3 x 3 cube, but guarded) replays the round.
' The final screen names the match winner. The 3 x 3 x 3 game is a known
' win for the opener, who can take the centre: the title's OPENING item
' can bar the centre from the first move of a round (default FREE, as
' the original).
'
' Looks: unlike games/ttt3 (4 x 4 x 4 slanted planes), the three layers
' are square boards on a staircase from top left to bottom right, each in
' its own colour, claimed cells are coloured slabs carved with X or O.
'
' Controls: the stick moves the cursor (left/right one cell, up/down one
' row), a button claims the cell. On the title, up and down choose, left
' and right change ROUNDS and OPENING, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' screens drawn with the NMI off after a wait, display off; music first in
' the sound table, effects after; the title tune is played once; `set
' sprite count` is always given. Nothing flashes faster than 3 Hz.

const TE000 = 128
const TE001 = 129
const TE010 = 130
const TE011 = 131
const TE100 = 132
const TE101 = 133
const TE110 = 134
const TE111 = 135
const TE200 = 136
const TE201 = 137
const TE210 = 138
const TE211 = 139
const TX00 = 140
const TX01 = 141
const TX10 = 142
const TX11 = 143
const TO00 = 144
const TO01 = 145
const TO10 = 146
const TO11 = 147
const TXl00 = 148
const TXl01 = 149
const TXl10 = 150
const TXl11 = 151
const TOl00 = 152
const TOl01 = 153
const TOl10 = 154
const TOl11 = 155
const TShr = 156
const TShd = 157
const TRule = 158
const TM0 = 159
const TM1 = 160
const TM2 = 161
const TMx = 162
const TMo = 163
const SCur = 0
const SCurk = 4
const NTiles8 = 288
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndBad = 4
const SndClaim = 5
const SndWin = 6
const SndStart = 7
const SndOver = 8
const NSpr = 2
const FlashN = 12
const RepFirst = 15
const RepNext = 6

data LnA bytes
  1,3,4,9,12,10,13,0,4,10,13,1,5,4,11,14,13,10,4,13,12
  0,0,1,2,3,13,14,2,13,3,0,2,7,15,12,16,13,6,1,16,13
  0,2,6,17,14,16,13,10,12,13,0,9,13,1,2,0,13,14,9,2,9
  13,3,0,6,9,10,11,12,1,0,2,3,5,6,7,8,4,11,12,5,2
  8,9,17,11,6,10,15,7,8,6,11,9,15,8,19,21,22,0,8,6,2
  22,1,7,18,18,26,22,11,8,6,0,18,22,3,5,18,19,20,21,4,21
  20,5,3,22,25,18,6,0,8,2,19,24,7,1,18,20,24,8,2,6,0
end data
data LnB bytes
  2,6,8,18,24,20,26,2,7,19,25,0,8,6,20,26,24,18,5,23,21
  6,8,7,6,5,22,23,8,21,4,3,4,8,24,18,26,20,8,4,25,19
  4,5,7,26,20,24,18,11,15,17,18,11,16,19,18,20,15,17,10,20,15
  14,21,24,18,17,16,15,14,25,26,24,23,21,20,19,18,22,17,13,23,26
  20,12,16,13,24,13,17,25,24,26,14,13,16,26,20,24,26,9,13,12,10
  25,10,13,20,19,23,24,2,14,13,10,24,23,12,13,26,25,24,23,13,22
  26,14,13,20,26,21,15,12,16,13,22,26,16,13,22,23,25,17,14,16,13
end data
data LnS bytes
  0,7,11,18,22,27,31,38,42,49,53,58,62,67,80,85,89,94,98,105,109,116,120,125,129,136,140,147
end data

' cell (0-26) -> its tile column and row on the staircase
data CellC bytes
  3,5,7,3,5,7,3,5,7, 12,14,16,12,14,16,12,14,16, 21,23,25,21,23,25,21,23,25
end data
data CellR bytes
  2,2,2,4,4,4,6,6,6, 8,8,8,10,10,10,12,12,12, 14,14,14,16,16,16,18,18,18
end data

record Plr:
  u8 Mark
  u8 Colr
  bcd digits 2 Wins
end record

Plr Pl[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
u8 Board[27]
u8 Cur = 0
u8 Sx = 0
u8 Sy = 0
u8 Turn = 0
u8 Rd = 1
u8 NRounds = 3
u8 NoCentre = 0
u8 Moves = 0
u8 Over = 0
u8 WinA = 0
u8 WinB = 0
u8 WinC = 0
u8 Claimed = 0
u8 Held = 0
u8 RepT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Stick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 InPlay = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Fl = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 R = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewMatch
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Over = 0 then goto play_loop

  ' the end: the final score, then back to the title on a press
  FinalPage
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the match

sub NewMatch:
  Pl[0].Mark = 1
  Pl[0].Colr = 9
  Pl[0].Wins = 0
  Pl[1].Mark = 2
  Pl[1].Colr = 11
  Pl[1].Wins = 0
  Rd = 1
  Turn = 0
  Over = 0
  BoardPage
  play sound SndStart
  return
end sub

' one frame of play: move the cursor, claim on a press
sub PlayStep:
  MoveCursor
  if Press = 1 then TryClaim
  return
end sub

' left/right: one cell (the listing's order), up/down: one row (three
' cells); stops at cells 1 and 27; a held stick repeats
sub MoveCursor:
  if Stick = 0 then
    RepT = 0
    WasStick = 0
    return
  end if
  if WasStick = Stick then
    inc RepT
    if RepT < RepFirst then return
    RepT = RepFirst - RepNext
  else
    RepT = 0
  end if
  WasStick = Stick
  C = Step3(Cur, Stick)
  if C <> Cur then
    Cur = C
    play sound SndStep
  end if
  return
end sub

' the cell one step from cell A in the stick's direction (A when blocked)
function Step3(u8 A, u8 S) as u8
  u8 Q = A
  select case S
  case 8
    if A < 26 then Q = A + 1
  case 4
    if A > 0 then Q = A - 1
  case 2
    if A < 24 then Q = A + 3
  case 1
    if A > 2 then Q = A - 3
  case else
    Q = A
  end select
  return Q

' the button: a free cell is claimed and tested for a win
sub TryClaim:
  Claimed = 0
  if Board[Cur] <> 0 then
    play sound SndBad
    Message(1)
    return
  end if
  if NoCentre = 1 then
    if Moves = 0 then
      if Cur = 13 then
        play sound SndBad
        Message(2)
        return
      end if
    end if
  end if
  K = Pl[Turn].Mark
  Board[Cur] = K
  DrawCell(Cur)
  inc Moves
  Claimed = 1
  play sound SndClaim
  Message(0)
  V = WinFor(Cur, K)
  if V > 0 then
    RoundWon
    return
  end if
  if Moves >= 27 then
    ' (cannot happen on a 3 x 3 x 3 cube: replay the round)
    Message(3)
    Rearm
    wait 90 frames
    nmi off
    ClearBoard
    return
  end if
  Turn = Turn ^ 1
  ShowTurn
  return
end sub

' 1 + the pair index when cell Cl, just claimed by mark Mk, completes a
' line (WinA, WinB, WinC are then its cells), else 0
function WinFor(u8 Cl, u8 Mk) as u8
  u8 First = 0
  u8 Last = 0
  u8 Pi = 0
  u8 Found = 0
  u8 Pa = 0
  u8 Pb = 0
  First = LnS[Cl]
  Last = LnS[Cl + 1] - 1
  for Pi = First to Last
    if Found = 0 then
      Pa = LnA[Pi]
      Pb = LnB[Pi]
      if Board[Pa] = Mk then
        if Board[Pb] = Mk then
          Found = Pi + 1
          WinA = Cl
          WinB = Pa
          WinC = Pb
        end if
      end if
    end if
  next
  return Found

' the three cells flash with a falling run; a point; the loser opens
sub RoundWon:
  InPlay = 0
  HideSprites
  Message(4)
  inc Pl[Turn].Wins
  ShowScores
  play sound SndWin
  for Fl = 1 to 10
    Lit(1)
    FrameN(FlashN)
    Lit(0)
    FrameN(FlashN)
  next
  Turn = Turn ^ 1
  inc Rd
  if Rd > NRounds then
    Over = 1
    return
  end if
  ClearBoard
  return
end sub

sub ClearBoard:
  fill array Board with 0
  Moves = 0
  Cur = 0
  Rearm
  wait
  nmi off
  for Ci = 0 to 26
    DrawCell(Ci)
  next
  ShowRound
  ShowTurn
  Message(0)
  CursorHome
  InPlay = 1
  return
end sub

' the winning cells lit (1) or in their player's colour (0)
sub Lit(u8 Lon):
  Rearm
  wait
  nmi off
  if Lon = 1 then
    LitCell(WinA)
    LitCell(WinB)
    LitCell(WinC)
  else
    DrawCell(WinA)
    DrawCell(WinB)
    DrawCell(WinC)
  end if
  return
end sub

sub LitCell(u8 Cl):
  if Board[Cl] = 1 then
    Pic(Cl, TXl00)
  else
    Pic(Cl, TOl00)
  end if
  return
end sub

' cell Cl drawn as it stands
sub DrawCell(u8 Cl):
  u8 Tl = 0
  select case Board[Cl]
  case 1
    Tl = TX00
  case 2
    Tl = TO00
  case else
    if Cl < 9 then
      Tl = TE000
    else
      if Cl < 18 then
        Tl = TE100
      else
        Tl = TE200
      end if
    end if
  end select
  Pic(Cl, Tl)
  return
end sub

' a 2 x 2 picture whose four tiles are consecutive codes
sub Pic(u8 Cl, u8 Tl):
  X = CellC[Cl]
  Y = CellR[Cl]
  put char Tl at X,Y
  put char Tl + 1 at X + 1,Y
  put char Tl + 2 at X,Y + 1
  put char Tl + 3 at X + 1,Y + 1
  return
end sub

' the cursor glides 4 pixels a frame toward its cell
sub DrawCursor:
  if InPlay = 0 then return
  X = CellC[Cur] << 3
  Y = CellR[Cur] << 3
  Y = Y - 1
  Sx = Glide(Sx, X)
  Sy = Glide(Sy, Y)
  C = Pl[Turn].Colr
  set sprite 0 to Sy,Sx,SCur,C
  set sprite 1 to Sy,Sx,SCurk,1
  update sprites
  return
end sub

function Glide(u8 Now, u8 Goal) as u8
  u8 Nx = Goal
  if Now + 4 < Goal then Nx = Now + 4
  if Now > Goal + 4 then Nx = Now - 4
  return Nx

sub CursorHome:
  Sx = CellC[Cur] << 3
  Sy = CellR[Cur] << 3
  Sy = Sy - 1
  return
end sub

' ---------------------------------------------------------------------------
' the board screen

sub BoardPage:
  NewScreen
  backdrop black
  for Ci = 0 to 2
    DrawStair(Ci)
  next
  print at 3,1, "TOP"
  print at 12,7, "MIDDLE"
  print at 21,13, "BOTTOM"
  print at 19,2, "ROUND"
  fill TRule count 11 at 19,3
  print at 19,4, "PLAYER 1"
  print at 19,5, "PLAYER 2"
  fill TRule count 18 at 2,20
  ShowScores
  ShowScreen
  ClearBoard
  return
end sub

' layer Ly's shadow (the step of the staircase)
sub DrawStair(u8 Ly):
  u8 Bx = 0
  u8 By = 0
  Bx = Ly * 9
  Bx = Bx + 9
  By = Ly * 6
  By = By + 2
  put char TShr at Bx,By
  for J = 1 to 6
    put char TShd at Bx,By + J
  next
  By = By + 6
  Bx = Bx - 5
  fill TShd count 5 at Bx,By
  return
end sub

sub ShowRound:
  NumU = Rd
  print at 25,2, digits$(NumU, 1)
  print at 26,2, "/"
  NumU = NRounds
  print at 27,2, digits$(NumU, 1)
  return
end sub

sub ShowScores:
  print at 28,4, Pl[0].Wins
  print at 28,5, Pl[1].Wins
  return
end sub

' whose turn: the big piece and the player's number
sub ShowTurn:
  if Turn = 0 then
    put char TX00 at 3,16
    put char TX01 at 4,16
    put char TX10 at 3,17
    put char TX11 at 4,17
    print at 6,16, "PLAYER 1"
  else
    put char TO00 at 3,16
    put char TO01 at 4,16
    put char TO10 at 3,17
    put char TO11 at 4,17
    print at 6,16, "PLAYER 2"
  end if
  print at 6,17, "TO MOVE"
  return
end sub

sub Message(u8 M):
  fill 32 count 28 at 2,22
  select case M
  case 1
    print at 2,22, "THAT CELL IS TAKEN"
  case 2
    print at 2,22, "NOT THE CENTRE TO OPEN"
  case 3
    print at 2,22, "BOARD FULL: PLAY AGAIN"
  case 4
    if Turn = 0 then
      print at 2,22, "PLAYER 1 WINS THE ROUND!"
    else
      print at 2,22, "PLAYER 2 WINS THE ROUND!"
    end if
  end select
  return
end sub

sub FinalPage:
  mute all
  HideSprites
  NewScreen
  backdrop dark blue
  fill mode 2 text color with $F4
  print at 10,5, "FINAL SCORE"
  print at 9,8, "PLAYER 1 (X)"
  print at 22,8, Pl[0].Wins
  print at 9,10, "PLAYER 2 (O)"
  print at 22,10, Pl[1].Wins
  if Pl[0].Wins > Pl[1].Wins then
    print at 6,14, "PLAYER 1 TAKES THE"
    print at 6,15, "MATCH!"
  else
    if Pl[1].Wins > Pl[0].Wins then
      print at 6,14, "PLAYER 2 TAKES THE"
      print at 6,15, "MATCH!"
    else
      print at 6,14, "A TIED MATCH!"
    end if
  end if
  print at 7,20, "PRESS THE BUTTON"
  ShowScreen
  play sound SndOver
  Rearm
  wait 60 frames
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub FrameN(u8 Nf):
  u8 Fi = 0
  for Fi = 1 to Nf
    Frame1
  next
  return
end sub

' the sticks (1 up, 2 down, 4 left, 8 right; the first of up, down,
' right, left when diagonal) and a button press
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  K = V & 15
  Stick = 0
  if K & 8 then Stick = 8
  if K & 4 then Stick = 4
  if K & 2 then Stick = 2
  if K & 1 then Stick = 1
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a little staircase of pieces, the tune once, START GAME /
' ROUNDS / OPENING / CREDITS
sub TitlePage:
  NewScreen
  backdrop black
  print at 8,2, "S T A C K"
  print at 14,4, "T H R E E"
  fill TRule count 24 at 4,6
  ' a decorative cube: one cell of each kind on three steps
  fill array Board with 0
  Board[0] = 1
  Board[4] = 2
  Board[8] = 1
  Board[13] = 2
  Board[18] = 1
  Board[22] = 1
  Board[26] = 2
  for Ci = 0 to 26
    TitleCell(Ci)
  next
  print at 4,14, "3-D TIC TAC TOE"
  print at 4,15, "FOR TWO PLAYERS"
  print at 6,17, "START GAME"
  print at 6,18, "ROUNDS"
  print at 6,19, "OPENING"
  print at 6,20, "CREDITS"
  print at 3,22, "COMPUTE'S GAZETTE 6/84"
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 440
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 0
tp_loop:
  Frame1
  ReadPad
  if Stick <> WasStick then
    select case Stick
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 3 then inc Menu
    case 4
      Adjust(255)
    case 8
      Adjust(1)
    end select
    ShowMenu
  end if
  WasStick = Stick
  if Press = 0 then goto tp_loop
  if Menu = 1 then
    Adjust(1)
    ShowMenu
    goto tp_loop
  end if
  if Menu = 2 then
    Adjust(1)
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  if Menu = 3 then CreditsPage
  return
end sub

' a small cube on the title: each layer's 3 x 3 cells as single tiles
sub TitleCell(u8 Cl):
  u8 Ly = 0
  u8 Tl = 0
  Ly = Cl / 9
  X = Cl % 3
  Y = Cl % 9
  Y = Y / 3
  X = X + 6
  X = X + Ly * 8
  Y = Y + 8
  Y = Y + Ly
  select case Board[Cl]
  case 1
    Tl = TMx
  case 2
    Tl = TMo
  case else
    Tl = TM0 + Ly
  end select
  put char Tl at X,Y
  return
end sub

' change ROUNDS (1-9) or OPENING by D (1 or 255 = -1)
sub Adjust(u8 D):
  if Menu = 1 then
    NRounds = NRounds + D
    if NRounds = 0 then NRounds = 9
    if NRounds > 9 then NRounds = 1
  end if
  if Menu = 2 then NoCentre = NoCentre ^ 1
  return
end sub

sub ShowMenu:
  for Ci = 17 to 20
    put char 32 at 4,Ci
  next
  J = Menu + 17
  put char 62 at 4,J
  NumU = NRounds
  print at 17,18, digits$(NumU, 1)
  if NoCentre = 0 then
    print at 17,19, "FREE     "
  else
    print at 17,19, "NO CENTRE"
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "3-D TIC TAC TOE"
  print at 2,5, "BASED ON 3-D TIC TAC TOE,"
  print at 2,6, "COMPUTE'S GAZETTE, JUNE"
  print at 2,7, "1984 (COMMODORE 64 AND"
  print at 2,8, "VIC-20, BASIC)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: THREE BY THREE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$80,$80,$80,$80,$80,$80,$80
  $00,$01,$01,$01,$01,$01,$01,$01
  $80,$80,$80,$80,$80,$80,$2A,$00
  $01,$01,$01,$01,$01,$01,$AA,$00
