  32,32,32,32,32,32,32,32,32,32,32,32,128,32,128,32,128,32,128,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,128,128,32,32,128,128,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,128,32,128,32,128,32,128,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,128,128,32,32,128,128,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,128,128,32,32,32,128,32,32,128,128,32,32,128,128,32,32,32,128,32,32,32,128,128,32,128,128,128,32,32,32
  32,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,32,32,128,32,32,32,32,32
  32,32,128,128,32,32,128,128,128,32,128,128,32,32,128,128,32,32,128,128,128,32,128,32,128,32,128,128,32,32,32,32
  32,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,32,32,32,32
  32,32,128,128,32,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,128,32,32,128,128,32,128,128,128,32,32,32
end data

' the players: score, button last frame, fire countdown
record Player:
  u8 Score
  u8 FireC
  u8 WasF
  u8 Fired
end record

Player Pl[2]
u16 TzLeft = 0
u8 TzOn = 0
' the BBs (see bb.asm for the layout)
u8 BB[288]
u8 GDir[2]
u8 LastB[2]
' the puck: 8.8 pixels, speed in 1/256 pixels a frame, the top-left pixel
u16 PX = 0
u16 PY = 0
i16 PVx = 0
i16 PVy = 0
u8 PuX = 0
u8 PuY = 0
' asm counters and flags
u8 Bi = 0
u8 Fly = 0
u8 Kicks = 0
u8 Pings = 0
u8 Destr = 0
u8 DHit = 0
u8 Red = 0
u8 Rb = 1
u16 Rs = $1D2B
u16 T16 = 0
u16 DT = 0
' drawing
u8 CellC = 0
u8 CellR = 0
u8 CellT = 0
u8 CellK = 0
u8 Gi = 0
u8 Gx0 = 0
u16 Gsx = 0
u16 Gsy = 0
u16 Gpx = 0
u16 Gpy = 0
u8 Glyph[8]
u8 TxRow = 0
u8 TxCol = 0
u8 TxClr = 0
u8 NumBuf[4]
' game
u8 Np = 1
u8 Field = 0
u8 Over = 0
u8 Winner = 0
u8 Paused = 0
u8 Goals = 0
u8 Scorer = 0
u8 GoalSide = 0
' the computer's eyes: where the puck was (16 frames of history)
u8 HX[16]
u8 HY[16]
u8 Hp = 0
u8 AiWait = 0
u8 AiDelay = 8
' the computer: 0 EASY, 1 HARD
u8 Level = 1
' input: stick bits per controller (1 up, 2 down, 16 left button, 32 right)
u8 J1 = 0
u8 J2 = 0
u8 Jmenu = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 P2 = 0
u8 WasP2 = 0
u8 WasStick = 0
u8 Menu = 0
u8 Pg = 0
u16 Wt = 0
u8 Tick = 0
u8 Late = 0
u8 Passes = 0
u8 Idle = 0
' loop counters of their own (never shared with helpers)
u8 Gn = 0
u8 GFirst = 0
u8 GOrd = 0
u8 Gv = 0
u8 Ci = 0
u8 Si = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
i16 T = 0
i16 T2 = 0
u16 W16 = 0
u16 Ix = 0
u16 FontW = 0

  tile screen
  set sound table BbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  KeepFont
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 1 then
    Menu = 0
    goto title
  end if
  Np = Menu + 1

  NewGame

play_loop:
  ' a steady 30 passes a second (the C64 slowed down as the BBs grew in
  ' number; here a pass always takes two frames): ZLate tells whether a
  ' frame began while this pass worked
  call asm ZLate
  if Late = 0 then Frame1
  Frame1
  inc Passes
  ReadPad
  if P2 = 1 then
    TogglePause
  end if
  if Paused = 1 then goto play_loop
  PlayStep
  if Over = 0 then goto play_loop

  ' the end: who won, then back to the title on a press
  ShowWinner
  mute all
  play sound SndWin
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the BBs, the two guns (in a random order, as the C64
' did), the puck, the goal lines, the destruct clock, the sounds
sub PlayStep:
  Kicks = 0
  Pings = 0
  DHit = 0
  call asm BBStep
  Rnd16
  GFirst = Rs & 1
  for Gn = 0 to 1
    GOrd = Gn ^ GFirst
    GunStep(GOrd)
  next
  MovePuck
  if DHit = 1 then
    if Red = 0 then StartRed
  end if
  if Kicks > 0 then
    play sound SndHit
  else
    if Pings > 0 then PingSound
  end if
  CheckGoal
  if Destr = 0 then
    DT += 2
    if DT >= DestructT then Destr = 1
  end if
  return
end sub

sub PingSound:
  select case Rb & 3
  case 0
    play sound SndPing1
  case 1
    play sound SndPing2
  case else
    play sound SndPing3
  end select
  return
end sub

' GunStep(G): the stick turns gun G one step (down turns it down), the
' held button fires every 5th frame
sub GunStep(u8 G):
  V = StickOf(G)
  K = GDir[G]
  W = K
  if G = 0 then
    if V & 2 then
      if K < 126 then K += 2
    end if
    if V & 1 then
      if K > 2 then K -= 2
    end if
  else
    if V & 2 then
      if K > 130 then K -= 2
    end if
    if V & 1 then
      if K < 254 then K += 2
    end if
  end if
  if K <> W then
    GDir[G] = K
    Gi = G
    call asm DrawGun
  end if
  if V & 16 then
    Pl[G].FireC = Pl[G].FireC - 1
    if Pl[G].FireC = 0 then
      Pl[G].FireC = 5
      Shoot(G)
    end if
  end if
  return
end sub

' StickOf(G): the stick bits for gun G: controller 1 is the left gun,
' controller 2 the right one; with one player either controller is the
' left gun and the computer has the right one
function StickOf(u8 G) as u8
  if G = 0 then
    if Np = 1 then return J1 | J2
    return J1
  end if
  if Np = 1 then return AiStick
  return J2

' Shoot(G): the C64's $C58C. A BB for gun G: the one that last went over
' its line if it is still there, else any free one or one of its own;
' with none, take one of the other side's at random for the next shot
sub Shoot(u8 G):
  W = G + 1
  K = LastB[G]
  Ix = K + NB5
  if BB[Ix] = W then
    Launch(G, K)
    return
  end if
  K = NB
  while K > 0
    dec K
    Ix = K + NB5
    V = BB[Ix]
    if V = 3 then
      Launch(G, K)
      return
    end if
    if V = W then
      Launch(G, K)
      return
    end if
  end while
  ' the common pool: a random BB that is not flying becomes this gun's
  V = Rnd8
  if V < NB then
    Ix = V + NB5
    K = BB[Ix]
    if K > 0 then
      if K < 128 then BB[Ix] = W
    end if
  end if
  return
end sub

' Launch(G, B): BB B leaves gun G's pivot in the gun's direction
sub Launch(u8 G, u8 B):
  u16 Bx
  Bx = B
  BB[Bx] = 128
  BB[Bx + NB] = GunX(G)
  BB[Bx + NB2] = 128
  BB[Bx + NB3] = 100
  BB[Bx + NB4] = GDir[G]
  BB[Bx + NB5] = 0
  Pl[G].Fired = Pl[G].Fired + 1
  play sound SndFire
  return
end sub

function GunX(u8 G) as u8
  if G = 0 then return 20
  return 235

' MovePuck: friction on half the frames, the move, the top and bottom
' bounce (the C64 undid the step and turned the speed round)
sub MovePuck:
  Rnd16
  V = Rs & 128
  if V = 0 then
    PVx = Friction(PVx)
    PVy = Friction(PVy)
  end if
  PX = PX + PVx
  T = PY
  PY = PY + PVy
  V = highbyte PY
  if V < 16 then
    PY = T
    PVy = 0 - PVy
  end if
  if V > 175 then
    PY = T
    PVy = 0 - PVy
  end if
  PuX = highbyte PX
  PuY = highbyte PY
  V = PuY - 1
  K = PuX
  set sprite 0 to V,K,SPuck,5
  update sprites
  return
end sub

' Friction(S): the C64's $C261: below 2 C64 units (14 here) the speed is
' 0, else it loses a sixteenth
function Friction(i16 S) as i16
  i16 A
  A = S
  if A < 0 then A = 0 - A
  if A < 14 then return 0
  A = A >> 4
  if S < 0 then return S + A
  return S - A

' CheckGoal: the puck's middle over a goal line scores for the other side
sub CheckGoal:
  if PuX < 9 then
    Goal(1)
    return
  end if
  if PuX >= 233 then Goal(0)
  return
end sub

' Goal(S): side S scores: the jingle of the score, a second's wait, then
' the BBs in flight go back to the pool and the puck to the middle
sub Goal(u8 S):
  Pl[S].Score = Pl[S].Score + 1
  inc Goals
  Scorer = S
  ShowScores
  Gv = Pl[S].Score
  select case Gv
  case 1
    play sound SndGoal1
  case 2
    play sound SndGoal2
  case 3
    play sound SndGoal3
  case 4
    play sound SndGoal4
  case else
    play sound SndGoal5
  end select
  set sprite 0 to 192,0,SPuck,5
  update sprites
  for Si = 1 to 60
    Frame1
  next
  if Gv >= GoalsWin then
    Over = 1
    Winner = S
    return
  end if
  Recall
  if Red = 1 then
    DrawField
    ShowHud
    Red = 0
    backdrop black
  end if
  CentrePuck
  return
end sub

' Recall: every BB in flight is wiped and goes back to the pool
sub Recall:
  for Ci = 0 to NB - 1
    Ix = Ci + NB5
    V = BB[Ix]
    if V = 128 then
      call asm EraseOne with a = Ci
    end if
    if V & 127 = 0 then BB[Ix] = 3
  next
  return
end sub

sub CentrePuck:
  PX = 121 * 256
  PY = 95 * 256
  PVx = 0
  PVy = 0
  DT = 0
  Destr = 0
  MovePuck
  return
end sub

' StartRed: destruct mode has begun: a red border, a crunch, a word
sub StartRed:
  Red = 1
  backdrop dark red
  play sound SndCrunch
  TxRow = 1
  TxCol = 11
  TxClr = $81
  call asm BText with hl = address of TxtDestruct
  return
end sub

sub TogglePause:
  Paused = Paused ^ 1
  play sound SndPause
  TxRow = 1
  TxCol = 11
  if Paused = 1 then
    TxClr = $F1
    call asm BText with hl = address of TxtPaused
  else
    if Red = 1 then
      TxClr = $81
      call asm BText with hl = address of TxtDestruct
    else
      TxClr = $E1
      call asm BText with hl = address of TxtFirst
    end if
  end if
  return
end sub

' AiStick: the computer's right gun. It sees the puck as it was AiDelay
' passes ago (a quarter second) and turns towards
' it 2 steps a pass, as a player's gun does. While the puck is within 12
' pixels of the left gun's line of fire it aims 2 pixels above or below
' the puck's middle, so the kick (it goes out from where a BB strikes)
' sends the puck towards the left goal and off that line. It leads
' the puck (its motion over the 4 passes before times half the BB's
' flight) and fires only within 5 pixels of its mark. It rests 20 passes
' at random: HARD 1 pass in 128, EASY 1 in 32
function AiStick as u8
  u8 R
  u8 V2
  i16 Dx
  i16 Dy
  i16 Cr
  i16 Lim
  i16 Vx
  i16 Vy
  i16 Fl
  R = 0
  V = Hp - AiDelay
  V = V & 15
  Dx = HX[V]
  Dx = Dx + 7
  Dy = HY[V]
  Dy = Dy + 4
  Lim = 160
  if Level < 2 then
    V2 = V - 4
    V2 = V2 & 15
    Vx = HX[V]
    Vx = Vx - HX[V2]
    Vy = HY[V]
    Vy = Vy - HY[V2]
    Fl = 235 - Dx
    Fl = Fl >> 1
    Vx = Vx * Fl
    Vx = Vx >> 3
    Dx = Dx + Vx
    Vy = Vy * Fl
    Vy = Vy >> 3
    Dy = Dy + Vy
    if Dy < 16 then Dy = 16
    if Dy > 184 then Dy = 184
  end if
  ' where the puck is against the left gun's barrel
  K = GDir[0]
  T = BVx[K]
  T2 = BVy[K]
  T = T >> 4
  T2 = T2 >> 4
  Vx = Dy - 100
  Vy = Dx - 20
  Cr = T * Vx
  Cr = Cr - T2 * Vy
  if Cr >= 0 then
    if Cr < 384 then Dy = Dy - 2
  else
    if Cr > -384 then Dy = Dy + 2
  end if
  Dx = Dx - 235
  Dy = Dy - 100
  K = GDir[1]
  T = BVx[K]
  T2 = BVy[K]
  T = T >> 4
  T2 = T2 >> 4
  ' the cross product: > 0 means the puck is clockwise of the barrel
  Cr = T * Dy
  Cr = Cr - T2 * Dx
  if Cr > 100 then R = 1
  if Cr < -100 then R = 2
  if AiWait > 0 then
    dec AiWait
  else
    if Cr > 0 - Lim then
      if Cr < Lim then R = R | 16
    end if
    Rnd16
    W = Rs & 127
    if Level = 0 then W = W & 31
    if W = 0 then AiWait = 20
  end if
  return R

' the puck's place, remembered every frame for the computer
sub Remember:
  inc Hp
  V = Hp & 15
  HX[V] = PuX
  HY[V] = PuY
  return
end sub

' ---------------------------------------------------------------------------
sub NewGame:
  Pl[0].Score = 0
  Pl[1].Score = 0
  Pl[0].FireC = 5
  Pl[1].FireC = 5
  Pl[0].Fired = 0
  Pl[1].Fired = 0
  Goals = 0
  Over = 0
  Paused = 0
  Red = 0
  GDir[0] = 64
  GDir[1] = 192
  LastB[0] = 0
  LastB[1] = 0
  fill array BB with 0
  for Ci = 0 to NB - 1
    Ix = Ci + NB5
    BB[Ix] = 3
  next
  Rearm
  wait
  nmi off
  display off
  bitmap screen color $F1
  backdrop black
  cls
  HideSprites
  DrawField
  ShowHud
  set sprite 1 to 94,16,SGunl,11
  set sprite 2 to 94,224,SGunr,7
  CentrePuck
  for Ci = 0 to 15
    HX[Ci] = PuX
    HY[Ci] = PuY
  next
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' DrawField: the edges dark, the goal lines, the deflectors, the guns
sub DrawField:
  call asm ClearMap
  ' the black margins: rows 0 and 23, columns 0-1 and 30-31
  for Ci = 0 to 23
    W16 = Ci * 256
    fill $11 count 16 to vram.color + W16
    W16 = W16 + 240
    fill $11 count 16 to vram.color + W16
  next
  fill $11 count 256 to vram.color
  fill $11 count 256 to vram.color + 5888
  ' the field's own colour (it may be restored after destruct mode)
  for Ci = 2 to 22
    W16 = Ci * 256
    W16 = W16 + 16
    fill 0 count 224 to vram.pattern + W16
    fill $F1 count 224 to vram.color + W16
  next
  ' goal lines: the rightmost pixel of column 1, the leftmost of column 30
  for Ci = 2 to 22
    CellR = Ci
    CellC = 1
    CellT = 7
    CellK = $B1
    call asm DrawCell
    CellC = 30
    CellT = 8
    CellK = $71
    call asm DrawCell
  next
  ' the deflectors (the map gets types 1-5)
  if Field = 0 then
    W16 = address of Field1
  else
    W16 = address of Field2
  end if
  PlaceAll(W16)
  Gi = 0
  call asm DrawGun
  Gi = 1
  call asm DrawGun
  return
end sub

' PlaceAll(A): the field list at address A: col, row, type ... 255
sub PlaceAll(u16 A):
  u8 C
  C = peek(A)
  while C <> 255
    CellC = C
    CellR = peek(A + 1)
    CellT = peek(A + 2)
    V = CellT - 1
    CellK = DefCol[V]
    call asm DrawCell
    A = A + 3
    C = peek(A)
  end while
  return
end sub

sub ShowHud:
  TxRow = 1
  TxCol = 11
  TxClr = $E1
  call asm BText with hl = address of TxtFirst
  ShowScores
  return
end sub

sub ShowScores:
  TxRow = 1
  TxCol = 2
  TxClr = $B1
  if Np = 1 then
    call asm BText with hl = address of TxtYou
  else
    call asm BText with hl = address of TxtLeft
  end if
  ScoreText(Pl[0].Score)
  TxClr = $B1
  call asm BText with hl = address of NumBuf
  TxCol = 23
  TxClr = $71
  if Np = 1 then
    call asm BText with hl = address of TxtCv
  else
    call asm BText with hl = address of TxtRight
  end if
  ScoreText(Pl[1].Score)
  TxCol = 29
  TxClr = $71
  call asm BText with hl = address of NumBuf
  return
end sub

sub ScoreText(u8 S):
  NumBuf[0] = 48 + S
  NumBuf[1] = 0
  return
end sub

sub ShowWinner:
  TxRow = 11
  TxCol = 8
  TxClr = $F1
  if Np = 1 then
    if Winner = 0 then
      call asm BText with hl = address of TxtYouWin
    else
      call asm BText with hl = address of TxtCvWin
    end if
  else
    if Winner = 0 then
      call asm BText with hl = address of TxtLeftWin
    else
      call asm BText with hl = address of TxtRightWin
    end if
  end if
  TxRow = 13
  TxCol = 8
  call asm BText with hl = address of TxtOver
  return
end sub

' ---------------------------------------------------------------------------
' Rnd16: a 16-bit xorshift (7, 9, 8)
sub Rnd16:
  T16 = Rs << 7
  Rs = Rs ^ T16
  T16 = Rs >> 9
  Rs = Rs ^ T16
  T16 = Rs << 8
  Rs = Rs ^ T16
  return
end sub

function Rnd8 as u8
  Rb = Rb * 5 + 1
  return Rb

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  Remember
  return
end sub

' ReadPad: J1, J2 the two controllers (1 up, 2 down, 16 left button, 32
' right button); Press a new press of a left button, P2 of a right one
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Jmenu = J1 | J2
  Btn = Jmenu & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = Jmenu & 32
  P2 = 0
  if V > 0 then
    if WasP2 = 0 then P2 = 1
  end if
  WasP2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' A copy of the font (codes 32-95) at VRAM $3C00, for text on the bitmap
sub KeepFont:
  FontW = 0
  for K = 0 to 15
    W16 = FontW + 256
    copy vram.pattern + W16 count 32 to vram.spr_pat + 1024 + FontW
    FontW += 32
  next
  copy SpritePat count SprBytes to vram.spr_pat
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  tile screen
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BB BARRAGE in blocks, a row of deflectors, the menu
sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 64
  print at 3,1, "COMPUTE!'S GAZETTE 8/1988"
  print at 8,14, "BY WILLIAM CHIN"
  for Ci = 0 to 4
    J = Ci * 5 + 5
    put char TDef0 + Ci at J,15
  next
  print at 9,17, "ONE PLAYER"
  print at 9,18, "TWO PLAYERS"
  ShowField
  ShowLevel
  print at 9,21, "HOW TO PLAY"
  print at 9,22, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 462
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  Rnd16
  ReadPad
  V = Jmenu & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 5 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 2 then
    Field = Field ^ 1
    ShowField
    goto tp_loop
  end if
  if Menu = 3 then
    Level = Level ^ 1
    ShowLevel
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 4 then HowToPage
  if Menu = 5 then CreditsPage
  return
end sub

sub ShowField:
  if Field = 0 then
    print at 9,19, "FIELD: CLASSIC  "
  else
    print at 9,19, "FIELD: BB SCREEN"
  end if
  return
end sub

sub ShowLevel:
  if Level = 0 then
    print at 9,20, "COMPUTER: EASY"
  else
    print at 9,20, "COMPUTER: HARD"
  end if
  return
end sub

' HOW TO PLAY: 3 pages; a button turns the page; after the last page,
' or 30 seconds untouched, back to the title
' (Pg and Wt are globals: `tile screen` in NewScreen calls OS7 routines
' that change IX, which loses a sub's IX frame of locals here; see
' work/codex-bugs/repros/bbbar-tile-screen-ix-frame.alexis)
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "TWO BB GUNS FACE EACH OTHER"
    print at 2,4, "ACROSS THE FIELD. A PUCK"
    print at 2,5, "SITS IN THE MIDDLE."
    print at 2,7, "SHOOT BBS AT THE PUCK: EACH"
    print at 2,8, "HIT PUSHES IT A LITTLE."
    print at 2,9, "PUSH THE PUCK OVER THE OTHER"
    print at 2,10, "PLAYER'S GOAL LINE TO SCORE."
    print at 2,11, "FIVE GOALS WIN!"
    set sprite 1 to 128,16,SGunl,11
    set sprite 2 to 128,224,SGunr,7
    set sprite 0 to 132,136,SPuck,5
    put char TDot at 6,17
    put char TDot at 9,17
    put char TDot at 12,17
    put char TDot at 15,17
    put char TDef1 at 20,15
    put char TDef3 at 22,19
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "JOYSTICK UP/DOWN AIMS YOUR"
    print at 2,4, "GUN."
    print at 2,5, "LEFT BUTTON FIRES. HOLD IT"
    print at 2,6, "FOR RAPID FIRE."
    print at 2,7, "RIGHT BUTTON PAUSES."
    print at 2,9, "ONE PLAYER: YOU ARE THE LEFT"
    print at 2,10, "GUN (EITHER JOYSTICK)."
    print at 2,11, "TWO PLAYERS: JOYSTICK 1 IS"
    print at 2,12, "LEFT, JOYSTICK 2 IS RIGHT."
    set sprite 1 to 136,16,SGunl,11
    put char TDot at 6,17
    put char TDot at 9,16
    put char TDot at 12,15
    put char TDot at 15,14
    put char TDot at 6,18
    put char TDot at 10,18
    put char TDot at 14,18
  case 3
    print at 2,1, "THE FIELD               3/3"
    print at 2,3, "BBS BOUNCE OFF THE"
    print at 2,4, "DEFLECTORS:"
    print at 2,7, "THE PUCK SLIDES OVER THEM."
    print at 2,9, "AFTER A MINUTE WITHOUT A"
    print at 2,10, "GOAL THE BORDER TURNS RED:"
    print at 2,11, "NOW THE BBS EAT THE"
    print at 2,12, "DEFLECTORS AWAY!"
    print at 2,14, "TIP: HIT THE PUCK ON ITS"
    print at 2,15, "SIDE TO PUSH IT UP OR DOWN,"
    print at 2,16, "AWAY FROM THE OTHER GUN."
    for Ci = 0 to 4
      J = Ci * 4 + 5
      put char TDef0 + Ci at J,5
    next
    set sprite 0 to 148,120,SPuck,5
  end select
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub


sub ShowMenu:
  for J = 17 to 22
    put char 32 at 7,J
  next
  J = Menu + 17
  put char 62 at 7,J
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,2, "BB BARRAGE"
  print at 2,4, "BASED ON BB BARRAGE BY"
  print at 2,5, "WILLIAM CHIN, COMPUTE!'S"
  print at 2,6, "GAZETTE AUGUST 1988"
  print at 2,7, "(COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: RICOCHET (ORIGINAL)"
  print at 2,18, "AIM WITH THE STICK, HOLD"
  print at 2,19, "THE LEFT BUTTON TO FIRE."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TxtFirst chars "FIRST TO 5{0}"
data TxtDestruct chars " DESTRUCT {0}"
data TxtPaused chars "  PAUSED  {0}"
data TxtYou chars "YOU {0}"
data TxtCv chars "CPU {0}"
data TxtLeft chars "LEFT {0}"
data TxtRight chars "RIGHT{0}"
data TxtYouWin chars "   YOU WIN!   {0}"
data TxtCvWin chars "COMPUTER WINS!{0}"
data TxtLeftWin chars "  LEFT WINS!  {0}"
data TxtRightWin chars " RIGHT WINS!  {0}"
data TxtOver chars "  GAME OVER   {0}"

asm {
; BB BARRAGE: the Z80 parts (the BB swarm and the bitmap drawing).
; Bitmap screen: pattern byte of pixel (x, y) at (y >> 3) * 256 + (x & $F8)
; + (y & 7), colour byte at that address + $2000. The field's cell map
; (0 empty, 1-5 deflector type, 6 other) is kept in spare VRAM at $1C00
; (32 bytes a row); the font copy for text is at $3C00 (codes 32-95).
; The BBs live in the Amy array BB: x low 0-47, x high 48-95, y low
; 96-143, y high 144-191, direction 192-239, state 240-287 (0 flying,
; $80 flying and drawn, 1 left gun's, 2 right gun's, 3 free).
NBB EQU 48
MAPV EQU $1C00

; set the VDP read address HL (and wait), A = the byte
VRd:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ret
; write A at VRAM HL
VWr:
    push af
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop af
    ex (sp),hl
    ex (sp),hl
    out ($BE),a
    ret

; PxAdr: E = x, D = y -> HL the pattern address, C the pixel mask
PxAdr:
    ld a,d
    and 7
    ld l,a
    ld a,e
    and $F8
    or l
    ld l,a
    ld a,d
    rrca
    rrca
    rrca
    and $1F
    ld h,a
    ld a,e
    and 7
    push hl
    ld hl,PxMask
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    ld c,(hl)
    pop hl
    ret
PxMask:
    db $80,$40,$20,$10,$08,$04,$02,$01

; ZRnd8: A = the next byte of the BB random numbers (x 5 + 1, then mixed)
ZRnd8:
    ld a,(AMY_UVAR_Rb)
    ld c,a
    add a,a
    add a,a
    add a,c
    inc a
    ld (AMY_UVAR_Rb),a
    rrca
    rrca
    rrca
    ret

; BBStep: every flying BB: erase, move, bounce, leave by a goal line, hit
; the puck, hit a deflector, draw. Counts Kicks and Pings; DHit = 1 when a
; deflector was hit in destruct mode. The VDP is read and written with the
; ports inline (the NMI is off: no other VDP access can come between).
BBStep:
    push ix
    push iy
    ld ix,AMY_UVAR_BB+96
    ld iy,AMY_UVAR_BB+240
    xor a
    ld (AMY_UVAR_Fly),a
    ld b,NBB
bs_loop:
    ld a,(iy+0)
    ld c,a
    and $7F
    jp nz,bs_next
    push bc
    ld hl,AMY_UVAR_Fly
    inc (hl)
    bit 7,c
    jr z,bs_move
    ; erase the old dot (it was drawn on an empty pixel)
    ld e,(ix-48)
    ld d,(ix+48)
    call PxAdr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld a,c
    cpl
    ld c,a
    in a,($BE)
    and c
    ld c,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,c
    out ($BE),a
bs_move:
    ld l,(iy-48)
    ld h,0
    add hl,hl
    add hl,hl
    ld de,AMY_UDATA_BVT
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    ld l,(ix-96)
    ld h,(ix-48)
    add hl,de
    ld (ix-96),l
    ld (ix-48),h
    ld a,h
    cp 16
    jp c,bs_left
    cp 240
    jp nc,bs_right
    ld l,(ix+0)
    ld h,(ix+48)
    add hl,bc
    ld a,h
    cp 16
    jr c,bs_ybounce
    cp 184
    jr nc,bs_ybounce
    ld (ix+0),l
    ld (ix+48),h
    jr bs_puck
bs_ybounce:
    ; the top and bottom edges: mirror (the C64's EOR #$7F), stay put
    ld a,(iy-48)
    xor $7F
    ld (iy-48),a
bs_puck:
    ld a,(ix-48)
    ld hl,AMY_UVAR_PuX
    sub (hl)
    cp 16
    jr nc,bs_draw
    ld e,a
    ld a,(ix+48)
    inc hl
    sub (hl)
    cp 10
    jr nc,bs_draw
    add a,a
    add a,a
    add a,a
    srl e
    add a,e
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_HitT
    add hl,de
    ld a,(hl)
    or a
    jr z,bs_draw
    call Kick
    ld (iy+0),3
    jp bs_done
bs_draw:
    ld e,(ix-48)
    ld d,(ix+48)
    call PxAdr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld (iy+0),$80
    nop
    in a,($BE)
    ld b,a
    and c
    jr nz,bs_hit
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,b
    or c
    out ($BE),a
    jp bs_done
bs_hit:
    ; a lit pixel: what is in this cell?
    ld (iy+0),0
    ld a,(ix+48)
    and $F8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld a,(ix-48)
    rrca
    rrca
    rrca
    and $1F
    or l
    ld l,a
    ld de,MAPV
    add hl,de
    call VRd
    or a
    jp z,bs_done
    cp 6
    jp nc,bs_done
    ld b,a
    ld hl,AMY_UVAR_Pings
    inc (hl)
    ld c,(iy-48)
    ld a,b
    cp 1
    jr nz,bs_d2
    call ZRnd8
    jr bs_dset
bs_d2:
    cp 2
    jr nz,bs_d3
    ld a,c
    xor $7F
    jr bs_dset
bs_d3:
    cp 3
    jr nz,bs_d4
    xor a
    sub c
    jr bs_dset
bs_d4:
    cp 4
    jr nz,bs_d5
    ld a,$C0
    sub c
    jr bs_dset
bs_d5:
    ld a,$40
    sub c
bs_dset:
    ld (iy-48),a
    ld a,(AMY_UVAR_Destr)
    or a
    jr z,bs_done
    ; destruct mode: the BB takes this pixel with it when it moves on
    ld a,1
    ld (AMY_UVAR_DHit),a
    ld (iy+0),$80
    jr bs_done
bs_left:
    ld (iy+0),1
    pop bc
    push bc
    ld a,NBB
    sub b
    ld (AMY_UVAR_LastB),a
    jr bs_done
bs_right:
    ld (iy+0),2
    pop bc
    push bc
    ld a,NBB
    sub b
    ld (AMY_UVAR_LastB+1),a
bs_done:
    pop bc
bs_next:
    inc ix
    inc iy
    dec b
    jp nz,bs_loop
    pop iy
    pop ix
    ret

; Kick: the puck takes a BB from direction A: its speed grows by the kick,
; at most 672 (2 5/8 pixels a frame) either way on each axis
Kick:
    ld e,a
    ld d,0
    push de
    ld hl,AMY_UDATA_KVx
    add hl,de
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld hl,(AMY_UVAR_PVx)
    add hl,de
    call Clamp
    ld (AMY_UVAR_PVx),hl
    pop de
    ld hl,AMY_UDATA_KVy
    add hl,de
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld hl,(AMY_UVAR_PVy)
    add hl,de
    call Clamp
    ld (AMY_UVAR_PVy),hl
    ld a,(AMY_UVAR_Kicks)
    inc a
    ld (AMY_UVAR_Kicks),a
    ret
Clamp:
    bit 7,h
    jr nz,cl_neg
    push hl
    ld de,673
    or a
    sbc hl,de
    pop hl
    ret c
    ld hl,672
    ret
cl_neg:
    push hl
    ld de,672
    add hl,de
    pop hl
    ret c
    ld hl,-672
    ret

; DrawCell: cell CellC, CellR gets shape CellT (1-6) from DefShape in
; colour CellK, and the map gets CellT
DrawCell:
    push ix
    ld a,(AMY_UVAR_CellR)
    ld h,a
    ld a,(AMY_UVAR_CellC)
    add a,a
    add a,a
    add a,a
    ld l,a
    push hl
    ld a,(AMY_UVAR_CellT)
    dec a
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld ix,AMY_UDATA_DefShape
    add ix,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld b,8
dc_p:
    ld a,(ix+0)
    out ($BE),a
    inc ix
    djnz dc_p
    pop hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_CellK)
    ld b,8
dc_c:
    out ($BE),a
    nop
    nop
    djnz dc_c
    ; the map byte: MAPV + row * 32 + col
    ld a,(AMY_UVAR_CellR)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_CellC)
    ld e,a
    ld d,0
    add hl,de
    ld de,MAPV
    add hl,de
    ld a,(AMY_UVAR_CellT)
    call VWr
    pop ix
    ret

; ClearMap: the cell map all 0
ClearMap:
    ld hl,MAPV
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld bc,768
cm_l:
    xor a
    out ($BE),a
    dec bc
    ld a,b
    or c
    jr nz,cm_l
    ret

; DrawGun: gun Gi's barrel: clear its 3 x 5 cells, then 14 dots from the
; pivot (GPx, 100) along its direction, one pixel apart
DrawGun:
    ld a,(AMY_UVAR_Gi)
    or a
    ld a,16
    jr z,dg_c
    ld a,216
dg_c:
    ld (AMY_UVAR_Gx0),a
    ld d,10
dg_row:
    ld a,(AMY_UVAR_Gx0)
    ld l,a
    ld h,d
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld b,24
dg_z:
    xor a
    out ($BE),a
    nop
    djnz dg_z
    inc d
    ld a,d
    cp 15
    jr nz,dg_row
    ; the dots: P = pivot.128, step = V / 2 (one pixel), 14 of them
    ld a,(AMY_UVAR_Gi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_GDir
    add hl,de
    ld e,(hl)
    ld hl,AMY_UDATA_BVx
    add hl,de
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    sra h
    rr l
    ld (AMY_UVAR_Gsx),hl
    ld hl,AMY_UDATA_BVy
    add hl,de
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    sra h
    rr l
    ld (AMY_UVAR_Gsy),hl
    ld a,(AMY_UVAR_Gi)
    or a
    ld h,20
    jr z,dg_p
    ld h,235
dg_p:
    ld l,128
    ld (AMY_UVAR_Gpx),hl
    ld hl,100*256+128
    ld (AMY_UVAR_Gpy),hl
    ld b,14
dg_dot:
    push bc
    ld hl,(AMY_UVAR_Gpx)
    ld de,(AMY_UVAR_Gsx)
    add hl,de
    ld (AMY_UVAR_Gpx),hl
    ld e,h
    ld hl,(AMY_UVAR_Gpy)
    push de
    ld de,(AMY_UVAR_Gsy)
    add hl,de
    pop de
    ld (AMY_UVAR_Gpy),hl
    ld d,h
    call PxAdr
    call VRd
    or c
    call VWr
    pop bc
    djnz dg_dot
    ret

; BText: the zero-ended string at HL at text cell TxCol, TxRow in colour
; TxClr (on black), glyphs from the font copy at $3C00
BText:
    ld a,(hl)
    or a
    ret z
    inc hl
    push hl
    sub 32
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$3C00
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld hl,AMY_UVAR_Glyph
    ld b,8
bt_rd:
    nop
    nop
    in a,($BE)
    ld (hl),a
    inc hl
    djnz bt_rd
    ld a,(AMY_UVAR_TxRow)
    ld h,a
    ld a,(AMY_UVAR_TxCol)
    add a,a
    add a,a
    add a,a
    ld l,a
    push hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_Glyph
    ld b,8
bt_wr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz bt_wr
    pop hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_TxClr)
    ld b,8
bt_cl:
    out ($BE),a
    nop
    nop
    nop
    djnz bt_cl
    ld hl,AMY_UVAR_TxCol
    inc (hl)
    pop hl
    jr BText
ZLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret
EraseOne:
    push ix
    ld e,a
    ld d,0
    ld ix,AMY_UVAR_BB+96
    add ix,de
    ld e,(ix-48)
    ld d,(ix+48)
    call PxAdr
    call VRd
    ld b,a
    ld a,c
    cpl
    and b
    call VWr
    pop ix
    ret
BbFire:
    db $00,$00,$56,$01,$00,$00,$85,$02,$10
BbHit:
    db $00,$00,$27,$02,$00,$00,$56,$03,$10
BbPing1:
    db $40,$40,$60,$01,$40,$40,$90,$02,$50
BbPing2:
    db $40,$55,$60,$01,$40,$55,$90,$02,$50
BbPing3:
    db $40,$35,$60,$01,$40,$35,$90,$02,$50
BbCrunch:
    db $00,$00,$14,$06,$00,$00,$35,$08,$00,$00,$66,$0A,$10
BbGoal1:
    db $C0,$D6,$10,$06,$C0,$AB,$10,$06,$C0,$8F,$20,$14,$C0,$8F,$50,$0A,$D0
BbGoal2:
    db $C0,$BF,$10,$06,$C0,$98,$10,$06,$C0,$7F,$20,$14,$C0,$7F,$50,$0A,$D0
BbGoal3:
    db $C0,$AA,$10,$06,$C0,$88,$10,$06,$C0,$71,$20,$14,$C0,$71,$50,$0A,$D0
BbGoal4:
    db $C0,$A0,$10,$06,$C0,$80,$10,$06,$C0,$6B,$20,$14,$C0,$6B,$50,$0A,$D0
BbGoal5:
    db $C0,$8F,$10,$06,$C0,$72,$10,$06,$C0,$5F,$20,$14,$C0,$5F,$50,$0A,$D0
BbWin:
    db $80,$D6,$10,$08,$80,$AA,$10,$08,$80,$8F,$10,$08,$80,$6B,$10,$08,$80,$8F,$20,$08,$80,$6B,$10,$18
    db $80,$6B,$60,$0A,$90
BbPause:
    db $80,$7F,$30,$04,$80,$A9,$40,$04,$90

BbSoundTable:
    dw BbTuneMel,$702B
    dw BbTuneBass,$7035
    dw BbFire,$703F
    dw BbHit,$703F
    dw BbPing1,$7049
    dw BbPing2,$7049
    dw BbPing3,$7049
    dw BbCrunch,$703F
    dw BbGoal1,$705D
    dw BbGoal2,$705D
    dw BbGoal3,$705D
    dw BbGoal4,$705D
    dw BbGoal5,$705D
    dw BbWin,$7053
    dw BbPause,$7053
; Ricochet (original)
; Tiny Sound, 7 frames per step
BbTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$23,$01,$1E,$01,$23,$01,$26,$01,$25,$01,$21,$01
    db $1E,$01,$01,$01,$23,$01,$26,$01,$2A,$01,$28,$01,$26,$01,$25,$01
    db $21,$01,$01,$01,$23,$01,$1E,$01,$23,$01,$26,$01,$28,$01,$2B,$01
    db $2A,$01,$26,$01,$23,$01,$25,$01,$26,$01,$28,$01,$2A,$01,$01,$01
    db $2F,$01,$01,$01,$00,$01
    db $FF
BbTuneBass:
    db $84
    dw sndtiny_2
    db 7
