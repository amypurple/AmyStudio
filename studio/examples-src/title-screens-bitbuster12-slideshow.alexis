cartridge "TITLE CODEC BITBUSTER 1.2/AMY STUDIO/2026"

' Four ColecoVision homebrew title screens shown with one codec.
' Timing uses frame before/after upload picture ... with nmi.
' Wait one VBlank before timing; second upload is clean with NMI off.

u16 StartFrame = 0
u16 EndFrame = 0
u16 MazeFrames = 0
u16 JeepersFrames = 0
u16 SmurfFrames = 0
u16 StripFrames = 0

on vblank TitleCodecFrame

picture TitleMazeManiacBitbuster12:
  pattern from "@project/maze-maniac.pattern.pck" codec bitbuster
  color from "@project/maze-maniac.color.pck" codec bitbuster
end picture

picture TitleJeepersCreepersBitbuster12:
  pattern from "@project/jeepers-creepers.pattern.pck" codec bitbuster
  color from "@project/jeepers-creepers.color.pck" codec bitbuster
  name from "@project/jeepers-creepers.name.pck" codec bitbuster
end picture

picture TitleSmurfChallengeBitbuster12:
  pattern from "@project/smurf-challenge.pattern.pck" codec bitbuster
  color from "@project/smurf-challenge.color.pck" codec bitbuster
end picture

picture TitleStripPokerBitbuster12:
  pattern from "@project/strip-poker.pattern.pck" codec bitbuster
  color from "@project/strip-poker.color.pck" codec bitbuster
end picture

  bitmap screen
  nmi on
  wait

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleMazeManiacBitbuster12 with nmi
  EndFrame = frame
  MazeFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleMazeManiacBitbuster12
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleJeepersCreepersBitbuster12 with nmi
  EndFrame = frame
  JeepersFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleJeepersCreepersBitbuster12
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleSmurfChallengeBitbuster12 with nmi
  EndFrame = frame
  SmurfFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleSmurfChallengeBitbuster12
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleStripPokerBitbuster12 with nmi
  EndFrame = frame
  StripFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleStripPokerBitbuster12
  nmi on
  screen on
  wait 120 frames

  text screen
  print centered at 2, "TITLE CODEC RESULTS"
  print centered at 4, "BITBUSTER 1.2"
  print at 1,6, "IMG"
  print at 10,6, "FR"
  print at 15,6, "PAT"
  print at 23,6, "COL"
  print at 1,8, "MAZE"
  print MazeFrames at 10,8 digits 3
  print at 15,8, "1613"
  print at 23,8, "1308"
  print at 1,10, "JEEPERS"
  print JeepersFrames at 10,10 digits 3
  print at 15,10, "2394"
  print at 23,10, "631"
  print at 1,12, "SMURF"
  print SmurfFrames at 10,12 digits 3
  print at 15,12, "851"
  print at 23,12, "544"
  print at 1,14, "STRIP"
  print StripFrames at 10,14 digits 3
  print at 15,14, "2996"
  print at 23,14, "577"
  print centered at 17, "PAT/COL COMPRESSED BYTES"
  print centered at 20, "TIMED THEN CLEAN UPLOAD"
  print centered at 22, "DONE"
  screen on
done:
  goto done

sub TitleCodecFrame:
  return