project "Amy Function Test"
memory "colecovision_legacy_sdcc"

u16 WordOut = 0
u8 ByteOut = 0

  text screen
  print at 8,0, "FUNCTION TEST"
  print at 1,4, "ADDTWO:"
  print at 1,7, "TRIPLE:"
  print at 1,10, "NESTED IF:"
  print at 1,13, "LOCAL ARRAY:"
  print at 1,16, "LOCAL FORMAT:"
  print at 1,19, "LOCAL U32:"
  print at 1,20, "BARE FUNC:"
  print at 1,21, "INLINE IF:"
  print at 1,22, "LOCAL BOOL:"
  print at 1,23, "FIX PARTS:"
  screen on

  WordOut = AddTwo(3, 4)
  print WordOut at 10,4 digits 2

  ByteOut = Triple(5)
  print ByteOut at 10,7 digits 2

  if AddTwo(Triple(1), 4) = 7 then
    print at 13,10, "PASS"
  else
    print at 13,10, "FAIL"
  end if

  print SumPatternBytes() at 13,13 digits 2
  show_local_format
  show_local_u32
  show_bare_func
  show_inline_if
  show_local_bool
  show_fix_parts

function AddTwo(u16 A, u16 B) as u16
  u16 Sum = A
  Sum += B
  return Sum

function Triple(u8 N) as u8
  u8 Sum = N
  Sum += N
  Sum += N
  return Sum

function SumPatternBytes() as u8
  u8 Scores[4] = 0
  u8 Sum = 0
  u8 Pattern[2] = 0
  Pattern[0] = 1
  Pattern[1] = 2
  fill array Scores repeating Pattern count 4
  reverse array Scores
  Sum += Scores[0]
  Sum += Scores[1]
  Sum += Scores[2]
  Sum += Scores[3]
  return Sum

sub show_local_format:
  u8 Digits[5] = 0
  format AddTwo(40, 2) into Digits
  put Digits count 5 at 13,16
end sub

sub show_local_u32:
  u32 Steps[2] = 0
  u16 LowerHalf = 0
  Steps[0] = 100000
  Steps[0] += 2345
  Steps[0] += 1
  Steps[1] = Steps[0]
  LowerHalf = lowword Steps[1]
  if Steps[1] = 102346 then
    print Steps[1] at 11,19
    print LowerHalf at 22,19 digits 5
  else
    print at 11,19, "FAIL"
  end if
end sub

sub show_bare_func:
  if ReadyFlag then
    print MeaningOfLife at 11,20 digits 2
  else
    print at 11,20, "FAIL"
  end if
end sub

function ReadyFlag as bool
  return true

function MeaningOfLife as u16
  return 42

sub show_inline_if:
  u8 InlineValue = 0
  if ReadyFlag then InlineValue = 7
  if InlineValue = 7 then print at 11,21, "PASS"
  if InlineValue = 7 then mark_inline_ok
end sub

sub mark_inline_ok:
  put char $2A at 23,21
end sub

sub show_local_bool:
  bool Seen = false
  bool Ready = false
  bool Visible = false
  toggle Ready
  if not Seen then Seen = 1
  if Ready then Visible = 1
  if Visible then print at 11,22, "PASS"
end sub

sub show_fix_parts:
  fixed Pos = 1.5
  u16 Score = $1234
  u8 WholePart = 0
  u8 FracPart = 0
  WholePart = whole Pos
  FracPart = lowbyte Score
  print WholePart at 11,23 digits 2
  print FracPart at 15,23 digits 3
end sub