' FP5 sqrt lab: current bridge path through fixed32.
u16 UZero = 0
u16 UTen = 10
u16 UHundred = 100
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0

  text screen
  print at 10,0, "FP5 SQRT LAB"

  A = UHundred
  A = sqrt(A)
  B = UTen
  B = sqrt(B)
  C = UZero
  C = sqrt(C)
  D = UHundred
  D = sqrt(D)
  D = sqrt(D)
  D *= D
  D *= D
  E = UTen
  E = sqrt(E)

  print at 1,4,  "sqrt 100"
  print A at 12,4 digits 16
  print at 1,6,  "sqrt 10"
  print B at 12,6 digits 16
  print at 1,8,  "sqrt 0"
  print C at 12,8 digits 16
  print at 1,10, "100 sqr"
  print D at 12,10 digits 16

  print at 1,13, "EXPECT"
  print at 1,14, "10    00010.0000"
  print at 1,15, "3.16  00003.1622"
  print at 1,16, "0     00000.0000"
  print at 1,17, "near  00100.0000"
  screen on