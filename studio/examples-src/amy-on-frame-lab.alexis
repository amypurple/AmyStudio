cartridge "AMY VBLANK LAB/AMY STUDIO/2026"
' Studio refresh marker: 2026-06-23 19:59:50 -04:00

u16 Tick = 0

on vblank TickFrame

  text screen
  print centered at 4, "ON VBLANK LAB"
  print centered at 6, "NMI CALLS TICKFRAME"
  print at 8,10, "TICKS:"
  screen on

main_loop:
  wait
  print Tick at 15,10 digits 5
  if Tick < 120 then goto main_loop
  print centered at 14, "PASS - VBLANK HOOK RAN"
stop_loop:
  goto stop_loop

sub TickFrame:
  Tick += 1
  return