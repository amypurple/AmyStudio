cartridge "TITLE CODEC DAN1/AMY STUDIO/2026"

' Four ColecoVision homebrew title screens shown with one codec.
' Timing uses frame before/after upload picture ... with nmi.
' Wait one VBlank before timing; second upload is clean with NMI off.

u16 StartFrame = 0
u16 EndFrame = 0
u16 MazeFrames = 0
u16 JeepersFrames = 0
u16 SmurfFrames = 0
u16 StripFrames = 0

on vblank TitleCodecFrame

picture TitleMazeManiacDan1:
  pattern from "@project/maze-maniac.pattern.dan1" codec dan1
  color from "@project/maze-maniac.color.dan1" codec dan1
end picture

picture TitleJeepersCreepersDan1:
  pattern from "@project/jeepers-creepers.pattern.dan1" codec dan1
  color from "@project/jeepers-creepers.color.dan1" codec dan1
  name from "@project/jeepers-creepers.name.dan1" codec dan1
end picture

picture TitleSmurfChallengeDan1:
  pattern from "@project/smurf-challenge.pattern.dan1" codec dan1
  color from "@project/smurf-challenge.color.dan1" codec dan1
end picture

picture TitleStripPokerDan1:
  pattern from "@project/strip-poker.pattern.dan1" codec dan1
  color from "@project/strip-poker.color.dan1" codec dan1
end picture

  bitmap screen
  nmi on
  wait

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleMazeManiacDan1 with nmi
  EndFrame = frame
  MazeFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleMazeManiacDan1
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleJeepersCreepersDan1 with nmi
  EndFrame = frame
  JeepersFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleJeepersCreepersDan1
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleSmurfChallengeDan1 with nmi
  EndFrame = frame
  SmurfFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleSmurfChallengeDan1
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleStripPokerDan1 with nmi
  EndFrame = frame
  StripFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleStripPokerDan1
  nmi on
  screen on
  wait 120 frames

  text screen
  print centered at 2, "TITLE CODEC RESULTS"
  print centered at 4, "DAN1"
  print at 1,6, "IMG"
  print at 10,6, "FR"
  print at 15,6, "PAT"
  print at 23,6, "COL"
  print at 1,8, "MAZE"
  print MazeFrames at 10,8 digits 3
  print at 15,8, "1591"
  print at 23,8, "1247"
  print at 1,10, "JEEPERS"
  print JeepersFrames at 10,10 digits 3
  print at 15,10, "2326"
  print at 23,10, "586"
  print at 1,12, "SMURF"
  print SmurfFrames at 10,12 digits 3
  print at 15,12, "799"
  print at 23,12, "504"
  print at 1,14, "STRIP"
  print StripFrames at 10,14 digits 3
  print at 15,14, "2882"
  print at 23,14, "540"
  print centered at 17, "PAT/COL COMPRESSED BYTES"
  print centered at 20, "TIMED THEN CLEAN UPLOAD"
  print centered at 22, "DONE"
  screen on
done:
  goto done

sub TitleCodecFrame:
  return