'cartridge "MODE 3 FLAG/AMY STUDIO/2026"

const Red = 6
const White = 15
const Blue = 4

u8 I = 0
u8 J = 0
u8 K = 0
u8 X = 0
u8 Y = 0
u8 StripeY = 0
u8 StripeEnd = 0
u8 StripeColor = Red

data StripeEnds bytes
  3,7,10,14,18,21,25,29,32,36,40,43,47
end data

' Atari BASIC flag idea adapted to ColecoVision multicolor mode.
  multicolor screen
  cls

  ' 13 red and white stripes.
  restore StripeEnds
  StripeY = 0
  StripeColor = Red
  for I = 0 to 12
    read StripeEnd
    box 2,StripeY to 63,StripeEnd color StripeColor
    StripeY = StripeEnd + 1
    if StripeColor = Red then StripeColor = White else StripeColor = Red
  next

  ' Blue canton.
  box 2,0 to 28,25 color Blue

  ' Nine rows of white star crosses.
  K = 0
  for I = 0 to 8
    Y = 3 + I * 2
    for J = 0 to 4
      X = K + 5 + J * 4
      draw_star
    next
    if K = 0 then
      X = 25
      draw_star
      K = 2
    else
      K = 0
    end if
  next

  screen on
  loop forever

sub draw_star:
  box X,Y to X+1,Y+1 color White
  return