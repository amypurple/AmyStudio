  tile screen
  set sound table PbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

level:
  DrawBoard

life:
  ResetLife
  Intro

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Ev = 0 then goto play_loop

  select case Ev
  case 1
    LoseLife
    if Lives = 0 then goto game_end
    goto life
  case 2
    ScreenClear
    goto level
  case else
    ' an N capsule: straight to the next screen
    NextScreen
    goto level
  end select

game_end:
  Phase = 5
  HideSprites
  print at 9,9, "             "
  print at 9,10, "  GAME OVER  "
  print at 9,11, "             "
  mute all
  TzOn = 0
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play, in the C64's order: the stick and button, the balls,
' the capsule, the drones, the shot
sub PlayStep:
  Ev = 0
  if Paused = 1 then
    if Press2 = 1 then
      Paused = 0
      fill 32 count 5 at 13,19
    end if
    return
  end if
  if Press2 = 1 then
    Paused = 1
    print at 13,19, "PAUSE"
    return
  end if
  MovePaddle
  if Btn > 0 then
    ' the button lets go of held balls and fires when F is on
    for Bi = 0 to 2
      Bl[Bi].Hold = 0
    next
    if Pw = 4 then
      if ShotOn = 0 then
        ShotOn = 1
        ShotX = Px + PadW / 2 - 1
        ShotY = PadY - 6
        play sound SndShot
      end if
    end if
  end if
  SpeedTimer
  for Bi = 0 to 2
    MoveBall
  next
  MoveCap
  for Di = 0 to 2
    MoveDrone
  next
  MoveShot
  if NBalls = 0 then Ev = 1
  return
end sub

sub MovePaddle:
  K = J1 & 12
  if K = 4 then
    W16 = 288 + PadSpd
    if Pxf < W16 then
      Pxf = 288
    else
      Pxf = Pxf - PadSpd
    end if
  end if
  if K = 8 then
    W16 = PadMax * 16
    Pxf = Pxf + PadSpd
    if Pxf > W16 then Pxf = W16
  end if
  Px = Pxf >> 4
  return
end sub

' every period (58 frames) the count goes down; at 0 every ball gets a
' random push and the next wait is half as long (49, 25, 13, 7, 4, 2, 1...)
sub SpeedTimer:
  dec SpdCnt
  if SpdCnt > 0 then return
  SpdCnt = SpdPeriod
  dec SpdLeft
  if SpdLeft > 0 then return
  for Ki = 0 to 2
    if Bl[Ki].Live = 1 then
      Wx = Bl[Ki].Vx
      Wy = Bl[Ki].Vy
      Push
      Bl[Ki].Vx = Wx
      Bl[Ki].Vy = Wy
    end if
  next
  SpdPer = SpdPer >> 1
  SpdLeft = SpdPer + 1
  return
end sub

' a random push on Wx / Wy (C64 $C776): one more unit across or down
sub Push:
  V = Rnd
  if V >= 128 then
    Wx = Faster(Wx)
  else
    Wy = Faster(Wy)
  end if
  return
end sub

' one unit faster, at most SpdMax, keeping the direction
function Faster(i8 S) as i8
  i8 Res = S
  if S >= 0 then
    if S < SpdMax then Res = S + 1
  else
    if S > -SpdMax then Res = S - 1
  end if
  return Res

' one unit slower (towards 0), at least Lim
function Slower(i8 S, u8 Lim) as i8
  i8 Res = S
  i8 L8 = Lim
  if S >= 0 then
    if S > L8 then Res = S - 1
  else
    if S < -L8 then Res = S + 1
  end if
  return Res

' the brick type (1-9) under pixel Xq, Yq, or 0
function BrickAt(u8 Xq, u8 Yq) as u8
  u8 Res = 0
  u8 Tc = 0
  if Xq >= 16 then
    if Xq < 240 then
      if Yq >= 8 then
        if Yq < 152 then
          C = (Xq - 16) >> 3
          R = (Yq - 8) >> 3
          Tc = get char at C + 2, R + 1
          if Tc >= TBr1 then
            if Tc <= TBr9 then Res = Tc - TBr1 + 1
          end if
        end if
      end if
    end if
  end if
  return Res

' the background of field cell C, R (frame lines on the edges)
sub EraseBrick:
  X = C + 2
  Y = R + 1
  K = 32
  if C = 0 then K = TEl
  if C = 27 then K = TEr
  if R = 0 then
    select case C
    case 0
      K = TEtl
    case 27
      K = TEtr
    case else
      K = TEtop
    end select
  end if
  put char K at X,Y
  return
end sub

sub AddScore(u8 Pts):
  Sc += Pts
  if Sc > Hi then Hi = Sc
  ShowScore
  return
end sub

' a brick broken (C, R set by BrickAt): one fewer left
sub BreakBrick:
  EraseBrick
  dec BLeft
  inc Bricks
  if BLeft = 0 then Ev = 2
  return
end sub

' a grey or coloured brick hit: a new colour, green one time in two
sub Recolour:
  V = Rnd
  if V >= 128 then
    K = 3
  else
    K = RecolT[V & 7]
  end if
  put char TBr1 + K - 1 at C + 2,R + 1
  AddScore(1)
  play sound SndHit
  return
end sub

' the ball meets a brick of type T at C, R: 1 when it bounces
function HitBrick(u8 Tb) as u8
  u8 Res = 1
  if Pw = 7 then
    ' the powerball goes through everything
    Res = 0
    if Tb = 1 then
      EraseBrick
      AddScore(1)
    else
      BreakBrick
      AddScore(3)
    end if
    play sound SndBrick
    return Res
  end if
  select case Tb
  case 1
    play sound SndSteel
  case 3
    Xp = C * 8 + 14
    Yp = R * 8 + 8
    BreakBrick
    AddScore(4)
    play sound SndBrick
    V = Rnd
    if V < 192 then SpawnCap
  case else
    Recolour
  end select
  return Res

' ball Bi: held on the paddle, or moving one frame
sub MoveBall:
  if Bl[Bi].Live = 0 then return
  if Bl[Bi].Hold > 0 then
    dec Bl[Bi].Hold
    Bl[Bi].X = (Px + Bl[Bi].Ofs) * 16
    Bl[Bi].Y = (PadY - 4) * 16
    return
  end if
  Ox = Bl[Bi].X
  Oy = Bl[Bi].Y
  Wx = Bl[Bi].Vx
  Wy = Bl[Bi].Vy
  ' across
  Nx = Ox + Wx * 2
  if Nx < BallMinX then
    Nx = BallMinX
    Wx = -Wx
    play sound SndWall
  end if
  if Nx > BallMaxX then
    Nx = BallMaxX
    Wx = -Wx
    play sound SndWall
  end if
  Xp = Nx >> 4
  Yp = Oy >> 4
  if Wx > 0 then Xp = Xp + 3
  Bk = BrickAt(Xp, Yp + 2)
  if Bk > 0 then
    Got = HitBrick(Bk)
    if Got = 1 then
      Nx = Ox
      Wx = -Wx
    end if
  end if
  ' down
  Ny = Oy + Wy * 2
  if Ny < BallMinY then
    Ny = BallMinY
    Wy = -Wy
    play sound SndWall
  end if
  Xp = Nx >> 4
  Yp = Ny >> 4
  if Wy > 0 then Yp = Yp + 3
  Bk = BrickAt(Xp + 2, Yp)
  if Bk > 0 then
    Got = HitBrick(Bk)
    if Got = 1 then
      Ny = Oy
      Wy = -Wy
    end if
  end if
  Bl[Bi].X = Nx
  Bl[Bi].Y = Ny
  Bl[Bi].Vx = Wx
  Bl[Bi].Vy = Wy
  if Wy > 0 then PaddleHit
  Yp = Bl[Bi].Y >> 4
  if Yp >= LostY then
    Bl[Bi].Live = 0
    dec NBalls
    if NBalls > 0 then play sound SndWall
  end if
  return
end sub

' a falling ball on the paddle (C64 $C208): up again, left of the middle
' goes left; near the middle steeper, near the ends flatter
sub PaddleHit:
  Yp = Ny >> 4
  if Yp + 3 < PadY then return
  if Yp > PadY + 2 then return
  Cx = (Nx >> 4) + 2
  Half = PadW / 2
  Pc = Px + Half
  Dd = Cx - Pc
  Ad = abs(Dd)
  if Ad > Half + 1 then return
  if Wy > 0 then Wy = -Wy
  if Wx < 0 then Wx = -Wx
  if Cx < Pc then Wx = -Wx
  if Ad < PadW / 8 then
    Wy = Faster(Wy)
    Wx = Slower(Wx, 0)
  else
    if Ad >= Half - 2 then
      Wy = Slower(Wy, 2)
      Wx = Faster(Wx)
    end if
  end if
  Bl[Bi].Vx = Wx
  Bl[Bi].Vy = Wy
  Bl[Bi].Y = (PadY - 4) * 16
  if CatchOn = 1 then
    Bl[Bi].Hold = CatchHold
    Xp = Nx >> 4
    if Xp < Px then Xp = Px
    Bl[Bi].Ofs = Xp - Px
  end if
  inc Pads
  play sound SndPad
  return
end sub

' a capsule at pixel Xp, Yp when none is falling: a random kind, not the
' last one, kept with its odds (C64 $C30E)
sub SpawnCap:
  if CapOn = 1 then return
  Got = 0
  while Got = 0
    V = Rnd
    T = V & 7
    if T <> LastT then
      V = Rnd
      if V < CapThr[T] then Got = 1
    end if
  end while
  CapT = T
  LastT = T
  CapOn = 1
  if Xp < 18 then Xp = 18
  if Xp > 226 then Xp = 226
  CapX = Xp * 16
  CapY = Yp * 16
  return
end sub

sub MoveCap:
  if CapOn = 0 then return
  CapY = CapY + 8
  Yp = CapY >> 4
  if Yp >= LostY then
    CapOn = 0
    return
  end if
  if Yp + 7 < PadY then return
  if Yp > PadY + 3 then return
  Xp = CapX >> 4
  if Xp + 11 < Px then return
  if Xp >= Px + PadW then return
  Catch
  return
end sub

' a capsule caught (C64 $C58C): the last power ends, the new one starts
sub Catch:
  CapOn = 0
  play sound SndCap
  if Pw = 2 then
    PadW = 20
    W16 = Pxf + 96
    Pxf = W16
    SetPadMax
  end if
  CatchOn = 0
  for Ki = 0 to 2
    Bl[Ki].Hold = 0
  next
  select case CapT
  case 0
    for Ki = 0 to 2
      if Bl[Ki].Vx >= 0 then
        Bl[Ki].Vx = 8
      else
        Bl[Ki].Vx = -8
      end if
      if Bl[Ki].Vy >= 0 then
        Bl[Ki].Vy = 8
      else
        Bl[Ki].Vy = -8
      end if
    next
  case 1
    CatchOn = 1
  case 2
    PadW = 32
    if Pxf >= 384 then
      Pxf = Pxf - 96
    else
      Pxf = 288
    end if
    SetPadMax
  case 3
    if NBalls = 1 then Split
  case 5
    if Scr <> 9 then
      CapThr[5] = CapThr[5] >> 1
      Ev = 3
    end if
  case 6
    if Lives < 9 then
      inc Lives
      CapThr[6] = CapThr[6] >> 1
      ShowLives
    end if
  end select
  Pw = CapT
  return
end sub

' the right limit of the paddle for its width, and a paddle kept inside
sub SetPadMax:
  PadMax = 238 - PadW
  W16 = PadMax * 16
  if Pxf > W16 then Pxf = W16
  if Pxf < 288 then Pxf = 288
  Px = Pxf >> 4
  return
end sub

' three balls from the one in play (C64 $C553): the second goes the other
' way up or down, the third the other way across
sub Split:
  K = 0
  if Bl[0].Live = 0 then K = 1
  if Bl[K].Live = 0 then K = 2
  Ox = Bl[K].X
  Oy = Bl[K].Y
  Wx = Bl[K].Vx
  Wy = Bl[K].Vy
  for Ki = 0 to 2
    Bl[Ki].X = Ox
    Bl[Ki].Y = Oy
    Bl[Ki].Live = 1
    Bl[Ki].Hold = 0
    Bl[Ki].Vx = Wx
    Bl[Ki].Vy = Wy
  next
  Bl[1].Vy = -Wy
  Bl[2].Vx = -Wx
  NBalls = 3
  return
end sub

' drone Di: a new one at the top when it is gone, then a move; it dies on
' the paddle, a ball (which turns back) or a shot
sub MoveDrone:
  Bounced = 0
  if Dr[Di].Live = 0 then SpawnDrone
  Ox = Dr[Di].X
  Oy = Dr[Di].Y
  Wx = Dr[Di].Vx
  Wy = Dr[Di].Vy
  Ox = Ox + Wx * 2
  Oy = Oy + Wy * 2
  if Ox < BallMinX then
    Ox = BallMinX
    Wx = -Wx
    Bounced = 1
  end if
  if Ox > DrMaxX then
    Ox = DrMaxX
    Wx = -Wx
    Bounced = 1
  end if
  if Oy < BallMinY then
    Oy = BallMinY
    Wy = -Wy
    Bounced = 1
  end if
  if Oy > DrMaxY then
    Oy = DrMaxY
    Wy = -Wy
    Bounced = 1
  end if
  if Bounced = 1 then Push
  Dr[Di].X = Ox
  Dr[Di].Y = Oy
  Dr[Di].Vx = Wx
  Dr[Di].Vy = Wy
  Xp = Ox >> 4
  Yp = Oy >> 4
  ' the paddle
  if Yp + 7 >= PadY then
    if Yp <= PadY + 3 then
      if Xp + 7 >= Px then
        if Xp < Px + PadW then
          KillDrone
          return
        end if
      end if
    end if
  end if
  ' a ball: it turns back
  for Ki = 0 to 2
    if Bl[Ki].Live = 1 then
      if Bl[Ki].Hold = 0 then
        X = Bl[Ki].X >> 4
        Y = Bl[Ki].Y >> 4
        if Overlap(X, Y, 4) = 1 then
          Bl[Ki].Vy = -Bl[Ki].Vy
          KillDrone
          return
        end if
      end if
    end if
  next
  ' the shot
  if ShotOn = 1 then
    if Overlap(ShotX, ShotY, 2) = 1 then KillDrone
  end if
  return
end sub

' 1 when a box at Xa, Ya (Sz wide, Sz tall) touches the drone at Xp, Yp
function Overlap(u8 Xa, u8 Ya, u8 Sz) as u8
  u8 Res = 1
  if Xa + Sz <= Xp then Res = 0
  if Xa >= Xp + 8 then Res = 0
  if Ya + Sz <= Yp then Res = 0
  if Ya >= Yp + 8 then Res = 0
  return Res

sub KillDrone:
  Dr[Di].Live = 0
  inc Kills
  AddScore(1)
  play sound SndDrone
  return
end sub

' a new drone at the top (C64 $C2D2): anywhere across, down 1 to the
' level, across 0-15 either way; one time in eight it brings a capsule
sub SpawnDrone:
  V = Rnd
  W16 = V * 212
  Xp = highbyte W16
  Xp = Xp + 18
  Dr[Di].X = Xp * 16
  Dr[Di].Y = BallMinY
  Dr[Di].Live = 1
  V = Rnd
  if V >= 224 then
    Yp = 10
    SpawnCap
  end if
  V = Rnd
  K = V & 15
  K = K % SpL
  Dr[Di].Vy = K + 1
  V = Rnd
  K = V & 31
  K = K >> 1
  if (V & 1) = 1 then
    Dr[Di].Vx = -K
  else
    Dr[Di].Vx = K
  end if
  return
end sub

' the shot climbs 8 pixels a frame; any brick stops it
sub MoveShot:
  if ShotOn = 0 then return
  if ShotY < 18 then
    ShotOn = 0
    return
  end if
  ShotY = ShotY - 8
  Bk = BrickAt(ShotX, ShotY)
  if Bk = 0 then return
  ShotOn = 0
  select case Bk
  case 1
    play sound SndSteel
  case 3
    BreakBrick
    AddScore(3)
    play sound SndBrick
  case else
    Recolour
  end select
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function Rnd as u8
  Rand
  return lowbyte Rs

' ---------------------------------------------------------------------------
' sprites 0-1 the paddle, 2-4 the balls, 5 the capsule, 6-8 drones, 9 shot
sub DrawSprites:
  u8 Sy = 0
  u8 Sx = 0
  u8 Sc8 = 0
  set sprite 0 to PadY - 1,Px,SPadl,9
  if PadW = 32 then
    set sprite 1 to PadY - 1,Px + 16,SPad16,9
  else
    set sprite 1 to PadY - 1,Px + 16,SPad4,9
  end if
  Sc8 = 15
  if Pw = 7 then Sc8 = 13
  for Ki = 0 to 2
    if Bl[Ki].Live = 1 then
      Sy = Bl[Ki].Y >> 4
      Sx = Bl[Ki].X >> 4
      set sprite Ki + 2 to Sy - 1,Sx,SBall,Sc8
    else
      set sprite Ki + 2 to 192,0,0,0
    end if
  next
  if CapOn = 1 then
    Sy = CapY >> 4
    Sx = CapX >> 4
    K = CapT * 4 + SCap0
    V = CapCol[CapT]
    set sprite 5 to Sy - 1,Sx,K,V
  else
    set sprite 5 to 192,0,0,0
  end if
  inc DrAnim
  if DrAnim >= 24 then
    DrAnim = 0
    inc DrStep
    if DrStep >= 3 then DrStep = 0
  end if
  J = DrAnim >> 3
  J = J * 4 + SDr0
  for Ki = 0 to 2
    if Dr[Ki].Live = 1 then
      Sy = Dr[Ki].Y >> 4
      Sx = Dr[Ki].X >> 4
      V = DrCol[Ki + DrStep]
      set sprite Ki + 6 to Sy - 1,Sx,J,V
    else
      set sprite Ki + 6 to 192,0,0,0
    end if
  next
  if ShotOn = 1 then
    set sprite 9 to ShotY - 1,ShotX,SShot,15
  else
    set sprite 9 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowScore:
  print at 11,22, Sc
  print at 23,22, Hi
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 3,22, digits$(NumU, 1)
  return
end sub

sub NewGame:
  Sc = 0
  Lives = 4
  Scr = 0
  LastT = 255
  CapThr[0] = 192
  for Ki = 1 to 7
    CapThr[Ki] = 255
  next
  CapThr[5] = 48
  Kills = 0
  Bricks = 0
  Pads = 0
  return
end sub

' a new life (and the start of a screen): one ball held on the paddle,
' drones back to the top, no power (C64 $C9D8)
sub ResetLife:
  SpL = Scr + 1
  Pw = 255
  PadW = 20
  CatchOn = 0
  CapOn = 0
  ShotOn = 0
  Paused = 0
  Pxf = 1888
  SetPadMax
  for Ki = 0 to 2
    Bl[Ki].Live = 0
    Bl[Ki].Hold = 0
    Dr[Ki].Live = 0
  next
  Bl[0].Live = 1
  Bl[0].Hold = ServeHold
  Bl[0].Ofs = 8
  Bl[0].X = (Px + 8) * 16
  Bl[0].Y = (PadY - 4) * 16
  Bl[0].Vx = SpL + 8
  Bl[0].Vy = -Bl[0].Vx
  NBalls = 1
  SpdCnt = SpdPeriod
  SpdPer = 48
  SpdLeft = 49
  return
end sub

' SCREEN n for a second, the ball waiting on the paddle
sub Intro:
  Phase = 2
  NumU = Scr + 1
  print at 11,19, "SCREEN ", digits$(NumU, 2)
  DrawSprites
  for J = 1 to 60
    Frame1
  next
  fill 32 count 9 at 11,19
  Rearm
  wait no fire
  nmi off
  WasBtn = 0
  Phase = 3
  return
end sub

sub LoseLife:
  Phase = 4
  play sound SndLost
  dec Lives
  ShowLives
  for J = 2 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  Rearm
  wait 60 frames
  nmi off
  return
end sub

' a cleared screen: the bonus, 100 x (speed level + 1), then the next one
sub ScreenClear:
  Phase = 6
  HideSprites
  print at 10,19, "SCREEN CLEAR"
  play sound SndClear
  K = SpL + 1
  for Ki = 1 to K
    Sc += 100
  next
  if Sc > Hi then Hi = Sc
  ShowScore
  Rearm
  wait 120 frames
  nmi off
  NextScreen
  return
end sub

sub NextScreen:
  inc Scr
  if Scr >= 10 then Scr = 0
  return
end sub

' the frame, the status line and screen Scr from the C64's data
sub DrawBoard:
  u16 P = 0
  u8 Cell = 0
  u8 Cnt = 0
  u8 Tp = 0
  NewScreen
  CapThr[6] = 128
  put char TEtl at 2,1
  fill TEtop count 26 at 3,1
  put char TEtr at 29,1
  for Row = 2 to 21
    put char TEl at 2,Row
    put char TEr at 29,Row
  next
  put char TPicon at 2,22
  print at 5,22, "SCORE"
  print at 18,22, "HIGH"
  ShowLives
  ShowScore
  BLeft = 0
  P = LevelOfs[Scr]
  Cell = 0
  V = LevelData[P]
  while V > 0
    Tp = V >> 6
    Cnt = V & 63
    for Ki = 1 to Cnt
      if Tp > 0 then
        C = Cell % 28
        R = Cell / 28
        put char TBr1 + Tp - 1 at C + 2,R + 1
        if Tp >= 2 then inc BLeft
      end if
      inc Cell
    next
    inc P
    V = LevelData[P]
  end while
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).button1 then J1 = J1 | 16
  if joypad(2).button2 then J1 = J1 | 32
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  B2 = J1 & 32
  Press2 = 0
  if B2 > 0 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = B2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: POWER / BALL in bricks, the capsules, the high score, the
' tune once
sub TitlePage:
  Phase = 0
  NewScreen
  print at 3,1, "COMPUTE!'S GAZETTE MAY 1987"
  copy TitleMap count 352 to vram.name + 96
  print at 11,14, "POWERBALL"
  print at 11,16, "START"
  print at 11,17, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  if Hi > 0 then
    print at 9,21, "HIGH ", Hi
  end if
  Menu = 0
  TitleArrow
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 528
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  K = J1 & 3
  V = K & WasJ
  V = K ^ V
  WasJ = K
  if V = 1 then
    if Menu > 0 then dec Menu
    TitleArrow
  end if
  if V = 2 then
    if Menu < 2 then inc Menu
    TitleArrow
  end if
  if Press = 0 then goto tp_loop
  StopTune
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub TitleArrow:
  put char 32 at 9,16
  put char 32 at 9,17
  put char 32 at 9,18
  Y = Menu + 16
  put char 62 at 9,Y
  return
end sub

data HtCapY bytes 55,55,71,71,87,87,103,103
data HtCapX bytes 24,128,24,128,24,128,24,128

' HOW TO PLAY: two pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  u8 Hk = 0
  u8 Hy = 0
  u8 Hx = 0
  u8 Hc = 0
  Pg = 1
ht_page:
  Phase = 6
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "BOUNCE THE BALL OFF YOUR"
    print at 2,4, "PADDLE TO KNOCK OUT EVERY"
    print at 2,5, "GREY AND GREEN BRICK."
    print at 2,6, "STEEL NEVER BREAKS."
    print at 2,8, "GREEN BRICKS BREAK AT ONCE."
    print at 2,9, "HIT ANY OTHER BRICK AND IT"
    print at 2,10, "CHANGES COLOUR."
    print at 2,12, "STICK: MOVE THE PADDLE."
    print at 2,13, "BUTTON: SERVE AND FIRE."
    print at 2,14, "RIGHT BUTTON: PAUSE."
    print at 2,16, "MISS EVERY BALL AND YOU LOSE"
    print at 2,17, "A PADDLE. NO PADDLES LEFT:"
    print at 2,18, "GAME OVER."
    for Hk = 0 to 7
      Hx = Hk + Hk
      Hx = Hx + 8
      Hc = TBr1 + Hk
      put char Hc at Hx,19
      inc Hx
      put char Hc at Hx,19
    next
    set sprite 0 to 167,104,SPadl,9
    set sprite 1 to 167,120,SPad16,9
    set sprite 2 to 159,140,SBall,15
  else
    print at 2,1, "CAPSULES               2/2"
    print at 2,3, "A BROKEN GREEN BRICK MAY"
    print at 2,4, "DROP A CAPSULE. CATCH IT"
    print at 2,5, "WITH THE PADDLE:"
    print at 6,7, "SLOW"
    print at 19,7, "CATCH"
    print at 6,9, "LONG"
    print at 19,9, "3 BALLS"
    print at 6,11, "FIRE"
    print at 19,11, "NEXT SCREEN"
    print at 6,13, "+1 PADDLE"
    print at 19,13, "POWERBALL"
    for Hk = 0 to 7
      Hy = HtCapY[Hk]
      Hx = HtCapX[Hk]
      Hc = Hk * 4 + SCap0
      set sprite Hk to Hy,Hx,Hc,CapCol[Hk]
    next
    print at 2,16, "DRONES BOUNCE THE BALL BACK."
    print at 2,18, "TIP: HIT THE BALL WITH THE"
    print at 2,19, "PADDLE'S MIDDLE FOR A STEEP,"
    print at 2,20, "EASY BOUNCE."
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

sub CreditsPage:
  Phase = 1
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "POWERBALL"
  print at 2,5, "FROM COMPUTE!'S GAZETTE,"
  print at 2,6, "MAY 1987 (COMMODORE 64"
  print at 2,7, "MACHINE LANGUAGE; NO AUTHOR"
  print at 2,8, "IS NAMED ON THE DISK)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: POWER SURGE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

