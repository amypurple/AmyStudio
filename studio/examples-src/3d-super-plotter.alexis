cartridge "3-D SUPER PLOTTER/STALEY, PERKINS, BRYSON/1987"

' 3-D SUPER PLOTTER
' Two COMPUTE! programs in one: "3-D Surfaces for Amiga" by Martin
' Staley (Amiga BASIC, COMPUTE!, March 1987) and "Superplotter" by Greg
' Perkins and Derry Bryson (Commodore 64 BASIC, with machine language
' for LINE and PSET, which C64 BASIC lacks). All credit for the programs
' and their equations belongs to the authors.
'
' Historical context (summary of the article):
' Plotting three-dimensional graphs is one of the traditional uses of
' computer graphics, and the shapes can be beautiful as well as
' educational. The program draws a function z = f(x,y) as a mesh
' perspective: a grid of rectangles pushed up or down. The user can
' change the equation (a DEF FN line), the fineness of the mesh (m and
' n, 31 being a good trade-off), the observation angles (theta around
' the z axis, phi above the x-y plane), the height factor, the bounds of
' x and y, and the colours (with the mouse and palette sliders). A
' 512K Amiga needed about ten minutes for a 31 x 31 mesh. The article
' lists eight equations to try, and notes that odd mesh sizes avoid a
' division by zero at the origin.
' Superplotter (summary): it plots 3-D equations with hidden-line
' removal and real perspective. The user gives the vantage point
' (THETA around the z axis, PHI from the z axis, RHO the distance:
' the closer, the stronger the perspective), the x and y domains, the
' number of segments, full-screen or one-to-one scaling, and whether
' to remove hidden lines. Its machine-language line routine keeps a
' moving border of the picture's outer edges and draws front to back,
' so a point inside the border is never plotted. Six sample equations:
' bowl, SIN of distance, thumbtack, spike, modulation, and a cross
' section of SIN of distance.
'
' ColecoVision version in Amy by Amy Bienvenu, 2026.
' Controls (either joystick): on the menu, up and down choose a line,
' left and right change it, a button draws. While a surface is shown,
' left and right turn it 15 degrees, up and down change the tilt, and a
' button goes back to the menu.
' How it works: the eight equations are sampled on the article's mesh
' (32 x 32 points from -3 to 3) and scaled around their average, as the
' program's Estimate routine does (surf.py, ahead of time: SIN and EXP
' over 1,024 points would take the Z80 minutes, as they took the
' Amiga). The view itself is computed here: each point's screen
' position is a sum of table entries for the chosen angle, tilt and
' height, and the mesh is drawn front to back with a floating horizon
' (Superplotter's moving border: the highest and lowest point drawn
' so far in each column), so the
' parts of the surface hidden behind nearer ridges are not drawn. This
' takes the place of the Amiga's filled polygons (AREA / AREAFILL).
' Adaptation liberties: the fourteen equations of the two articles
' (each starting from its article's view, domains and perspective)
' instead of typing a new DEF FN; a 24 x 24 sample grid, drawn as 23,
' 11 or 7 rectangles a side (all odd, as Staley advises); perspective
' as a setting (none, Staley's estimate; far or near eye, Superplotter's
' RHO), applied around the centre of the picture; hidden lines on or
' off (off draws every line); full-screen scaling only; the angle in 15-degree steps, three tilts and
' three heights; six colour schemes graded down the screen instead of
' palette sliders (the TMS9918 colours each 8-pixel row); the estimate
' (parallel) projection only, so no distance setting; the view turns
' with the joystick; an editorial page and an original title tune.
' Everything that matters stays in columns 2-29, inside the TV overscan.

const SndTick = 1
const SndPick = 2
const SndDone = 3
const SndTuneA = 4
const SndTuneB = 5

u8 Up[224]
u8 Lo[224]
u8 PrX[24]
u8 PrY[24]
u16 DBase = 0
u16 PBase = 0
u8 Persp = 0
u8 Hidden = 1
u8 Ma = 0
u8 Mk = 0
u8 Mr = 0
u8 Neg = 0
u8 Kp = 64
u16 UBase = 0
u16 VBase = 0
u16 ZBase = 0
u16 SBase = 0
u16 SRow = 0
u16 W16 = 0
u16 A16 = 0
u16 S16 = 0
u16 Err16 = 0
u16 NumU = 0
u8 Eq = 0
u8 Ang = 2
u8 Tilt = 0
u8 Hgt = 1
u8 Mesh = 0
u8 Scheme = 0
u8 Line = 0
u8 MStep = 1
u8 MLast = 23
u8 Sw = 0
u8 RevO = 0
u8 RevN = 0
u8 Oi = 0
u8 Ni = 0
u8 Ok = 0
u8 Nk = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 SX = 0
u8 SY = 0
u8 PX = 0
u8 PY = 0
u8 X1 = 0
u8 Y1 = 0
u8 X2 = 0
u8 Y2 = 0
u8 DX = 0
u8 DY = 0
u8 Dir = 0
u8 Cy = 0
u8 Pv = 0
u8 Xc = 0
u8 Ya = 0
u8 Yb = 0
u8 Yy = 0
u8 Hx = 0
u8 Col = 0
u8 PalOff = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Moved = 0
u8 Glyph[8]
u8 TxRow = 0
u8 TxCol = 0
u8 TxClr = 15
u8 Title = 0
u16 FontW = 0

  tile screen
  define chars Caret at 94
  set sound table SfSoundTable areas 4
  KeepFont
  Glyph[0] = 0
  screen on
  EditorialPage
  TitlePage

menu:
  MenuPage
  Render
view_loop:
  Rearm
  wait
  nmi off
  ReadPad
  Moved = 0
  if Lf1 = 1 then
    if Ang = 0 then
      Ang = 23
    else
      dec Ang
    end if
    Moved = 1
  end if
  if Rt1 = 1 then
    inc Ang
    if Ang = 24 then Ang = 0
    Moved = 1
  end if
  if Up1 = 1 then
    if Tilt < 2 then
      inc Tilt
      Moved = 1
    end if
  end if
  if Dn1 = 1 then
    if Tilt > 0 then
      dec Tilt
      Moved = 1
    end if
  end if
  if Moved = 1 then
    play sound SndPick
    Render
    goto view_loop
  end if
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    goto menu
  end if
  goto view_loop

' ---------------------------------------------------------------------------

' A copy of the font at VRAM $3800 (unused in bitmap mode, no sprites),
' so text can be drawn on the bitmap screen (BText, Z80)
sub KeepFont:
  FontW = 0
  for K = 0 to 15
    W16 = FontW + 256
    copy vram.pattern + W16 count 32 to vram.spr_pat + FontW
    FontW += 32
  next
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  return
end sub

' Where mesh point I,J lands on the screen: SX, SY
' X = 128 + u, Y = 104 - v - z, every term read from the tables (+128 each)
sub Proj:
  ' u: across the view
  W16 = UBase + I
  V = peek(W16)
  A16 = V
  W16 = UBase + 24
  W16 += J
  V = peek(W16)
  A16 += V
  ' Perspective: a scale for this point's depth (64 = none)
  Kp = 64
  if Persp > 0 then
    W16 = DBase + I
    V = peek(W16)
    S16 = V
    W16 = DBase + 24
    W16 += J
    V = peek(W16)
    S16 += V
    if S16 < 128 then
      V = 0
    elseif S16 > 383 then
      V = 255
    else
      S16 -= 128
      V = S16
    end if
    W16 = PBase + V
    Kp = peek(W16)
  end if
  ' X = 128 + u * Kp / 64
  if A16 >= 256 then
    A16 -= 256
    Ma = A16
    Neg = 0
  else
    A16 = 256 - A16
    Ma = A16
    Neg = 1
  end if
  Scale
  if Neg = 0 then
    A16 = 128 + Mr
    if A16 > 239 then A16 = 239
  else
    if Mr >= 112 then
      A16 = 16
    else
      A16 = 128 - Mr
    end if
  end if
  SX = A16
  ' Y = 104 - (v + z) * Kp / 64
  W16 = SRow + I
  V = peek(W16)
  W16 = ZBase + V
  V = peek(W16)
  S16 = V
  W16 = VBase + I
  V = peek(W16)
  S16 += V
  W16 = VBase + 24
  W16 += J
  V = peek(W16)
  S16 += V
  if S16 >= 384 then
    S16 -= 384
    if S16 > 255 then S16 = 255
    Ma = S16
    Scale
    if Mr > 104 then
      SY = 0
    else
      SY = 104 - Mr
    end if
  else
    S16 = 384 - S16
    if S16 > 255 then S16 = 255
    Ma = S16
    Scale
    A16 = 104 + Mr
    if A16 > 191 then A16 = 191
    SY = A16
  end if
  return
end sub

' Mr = Ma * Kp / 64 (Z80: MulK), without the work when there is no perspective
sub Scale:
  if Kp = 64 then
    Mr = Ma
    return
  end if
  call asm MulK
  return
end sub

' A line from X1,Y1 to X2,Y2, a column at a time, through the horizon
sub Seg:
  if X1 > X2 then
    V = X1
    X1 = X2
    X2 = V
    V = Y1
    Y1 = Y2
    Y2 = V
  end if
  DX = X2 - X1
  if Y2 >= Y1 then
    DY = Y2 - Y1
    Dir = 1
  else
    DY = Y1 - Y2
    Dir = 255
  end if
  if DX = 0 then
    Xc = X1
    Ya = Y1
    Yb = Y2
    Column
    return
  end if
  Err16 = 0
  Cy = Y1
  Xc = X1
seg_loop:
  Pv = Cy
  if Xc = X2 then
    Cy = Y2
  else
    Err16 += DY
seg_step:
    if Err16 >= DX then
      Cy += Dir
      Err16 -= DX
      goto seg_step
    end if
  end if
  Ya = Pv
  Yb = Cy
  Column
  if Xc = X2 then return
  inc Xc
  goto seg_loop
end sub

' One column of a line, from Ya to Yb: only what is above or below
' everything drawn so far in that column shows
sub Column:
  if Ya > Yb then
    V = Ya
    Ya = Yb
    Yb = V
  end if
  Hx = Xc - 16
  N = Up[Hx]
  K = Lo[Hx]
  for Yy = Ya to Yb
    V = 0
    if Yy < N then V = 1
    if Yy > K then V = 1
    if Hidden = 0 then V = 1
    if V = 1 then
      X = Yy >> 3
      X += PalOff
      Col = PalTab[X]
      call asm Pset
    end if
  next
  if Ya < N then Up[Hx] = Ya
  if Yb > K then Lo[Hx] = Yb
  return
end sub

' The whole surface, front to back
sub Render:
  ' Change screens out of sight: wait for the frame, blank, set up, show
  Rearm
  wait
  nmi off
  display off
  bitmap screen color $F0
  backdrop black
  if Scheme = 4 then backdrop white
  if Scheme = 5 then backdrop dark blue
  cls
  for I = 0 to 223
    Up[I] = 255
    Lo[I] = 0
  next
  Rearm
  wait
  nmi off
  screen on
  nmi off
  V = Mesh
  MStep = MeshStep[V]
  MLast = MeshLast[V]
  W16 = Ptr[0]
  A16 = Off64[Ang]
  UBase = W16 + A16
  W16 = Ptr[3]
  DBase = W16 + A16
  W16 = Ptr[4]
  A16 = Off256[Persp]
  PBase = W16 + A16
  V = Ang * 4
  V += Tilt
  W16 = Ptr[1]
  A16 = Off64[V]
  VBase = W16 + A16
  V = Tilt * 3
  V += Hgt
  W16 = Ptr[2]
  A16 = Off128[V]
  ZBase = W16 + A16
  V = Eq + 5
  SBase = Ptr[V]
  V = Scheme * 24
  PalOff = V
  ' Which way is near: the rows run across the view, nearest first
  Sw = SwapTab[Ang]
  RevO = RevOTab[Ang]
  RevN = RevNTab[Ang]
  Ok = 0
  Oi = 0
  if RevO = 1 then Oi = MLast
render_rows:
  Nk = 0
  Ni = 0
  if RevN = 1 then Ni = MLast
render_pts:
  if Sw = 0 then
    J = Oi
    I = Ni
  else
    I = Oi
    J = Ni
  end if
  SRow = SBase + RowOff[J]
  Proj
  if Nk > 0 then
    X1 = PX
    Y1 = PY
    X2 = SX
    Y2 = SY
    Seg
  end if
  if Ok > 0 then
    X1 = PrX[Nk]
    Y1 = PrY[Nk]
    X2 = SX
    Y2 = SY
    Seg
  end if
  PrX[Nk] = SX
  PrY[Nk] = SY
  PX = SX
  PY = SY
  inc Nk
  if RevN = 1 then
    if Ni >= MStep then
      Ni -= MStep
      goto render_pts
    end if
  else
    Ni += MStep
    if Ni <= MLast then goto render_pts
  end if
  inc Ok
  nmi on
  nmi off
  if RevO = 1 then
    if Oi >= MStep then
      Oi -= MStep
      goto render_rows
    end if
  else
    Oi += MStep
    if Oi <= MLast then goto render_rows
  end if
  ' Captions, drawn over the picture
  if Title = 1 then
    TxRow = 1
    TxCol = 7
    TxClr = 11
    call asm BText with hl = address of TxtTitle
    TxRow = 22
    TxCol = 9
    TxClr = 15
    call asm BText with hl = address of TxtPress
  else
    TxRow = 22
    TxCol = 4
    TxClr = 14
    call asm BText with hl = address of TxtHelp
  end if
  play sound SndDone
  Rearm
  wait no fire
  nmi off
  return
end sub

sub MenuPage:
  Rearm
  wait
  nmi off
  display off
  tile screen
  define chars Caret at 94
  fill mode 2 text color with $F4
  backdrop dark blue
  cls
  print at 7,1, "3-D SUPER PLOTTER"
  print at 4,3, "EQUATION"
  print at 4,8, "VIEW ANGLE"
  print at 4,9, "TILT"
  print at 4,10, "HEIGHT"
  print at 4,11, "MESH"
  print at 4,12, "PERSPECTIVE"
  print at 4,13, "HIDDEN LINES"
  print at 4,14, "COLORS"
  print at 4,16, "DRAW THE SURFACE"
  print at 3,19, "UP/DOWN: CHOOSE A LINE"
  print at 3,20, "LEFT/RIGHT: CHANGE IT"
  print at 3,21, "BUTTON: DRAW"
  Line = 8
  ShowMenu
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Rearm
  wait no fire
  nmi off
menu_loop:
  Rearm
  wait 7 frames
  nmi off
  ReadPad
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    return
  end if
  V = 0
  if Up1 = 1 then
    if Line > 0 then dec Line
    V = 1
  end if
  if Dn1 = 1 then
    if Line < 8 then inc Line
    V = 1
  end if
  if Lf1 = 1 then
    Change255
    V = 1
  end if
  if Rt1 = 1 then
    Change1
    V = 1
  end if
  if V = 1 then
    play sound SndTick
    ' redraw right after the frame starts
    Rearm
    wait
    nmi off
    ShowMenu
  end if
  goto menu_loop
end sub

' A new equation starts from its article's view
sub EqDefaults:
  Ang = EqAng[Eq]
  Tilt = EqTilt[Eq]
  Mesh = EqMesh[Eq]
  Persp = EqPersp[Eq]
  return
end sub

sub Change1:
  if Line = 0 then
    inc Eq
    if Eq = NEq then Eq = 0
    EqDefaults
  elseif Line = 1 then
    inc Ang
    if Ang = 24 then Ang = 0
  elseif Line = 2 then
    if Tilt < 3 then inc Tilt
  elseif Line = 3 then
    if Hgt < 2 then inc Hgt
  elseif Line = 4 then
    if Mesh < 2 then inc Mesh
  elseif Line = 5 then
    if Persp < 2 then inc Persp
  elseif Line = 6 then
    Hidden = Hidden ^ 1
  elseif Line = 7 then
    inc Scheme
    if Scheme = 6 then Scheme = 0
  end if
  return
end sub

sub Change255:
  if Line = 0 then
    if Eq = 0 then
      Eq = NEq - 1
    else
      dec Eq
    end if
    EqDefaults
  elseif Line = 1 then
    if Ang = 0 then
      Ang = 23
    else
      dec Ang
    end if
  elseif Line = 2 then
    if Tilt > 0 then dec Tilt
  elseif Line = 3 then
    if Hgt > 0 then dec Hgt
  elseif Line = 4 then
    if Mesh > 0 then dec Mesh
  elseif Line = 5 then
    if Persp > 0 then dec Persp
  elseif Line = 6 then
    Hidden = Hidden ^ 1
  elseif Line = 7 then
    if Scheme = 0 then
      Scheme = 5
    else
      dec Scheme
    end if
  end if
  return
end sub

sub ShowMenu:
  for Y = 3 to 16
    put char 32 at 2,Y
  next
  Y = MenuRow[Line]
  put char 62 at 2,Y
  NumU = Eq + 1
  print at 15,3, digits$(NumU, 2)
  print at 18,3, "OF 14"
  for Y = 4 to 6
    fill 32 count 27 at 2,Y
  next
  if Eq < 8 then
    print at 3,4, "STALEY:"
  else
    print at 3,4, "SUPERPLOTTER:"
  end if
  if Eq = 0 then
    print at 3,5, "SIN(X^2+3Y^2)/(X^2+Y^2)"
    print at 3,6, "+(X^2+5Y^2)EXP(1-X^2-Y^2)/2"
  elseif Eq = 1 then
    print at 3,5, "(X^2+5Y^2)EXP(1-X^2-Y^2)/2"
    print at 3,6, "-SIN(3X^2Y^2)/(X^2+Y^2)"
  elseif Eq = 2 then
    print at 3,5, "-X^3/10-(SIN(1-X^2-Y^2)"
    print at 3,6, "+COS(1-X^2-Y^2))/2"
  elseif Eq = 3 then
    print at 3,5, "SIN(3X)SIN(3Y)/5"
    print at 3,6, "+.7SIN(2X^2+3Y^2)/(X^2+Y^2)"
  elseif Eq = 4 then
    print at 3,5, "COS(3X)+2SIN(X^2+Y^2)"
    print at 3,6, "/(X^2+Y^2)-X/2"
  elseif Eq = 5 then
    print at 3,5, ".3(SIN(X^2+Y)+COS(Y^2+X))"
  elseif Eq = 6 then
    print at 3,5, "(SIN(4X^2+Y^2)+2SIN(XY))"
    print at 3,6, "/(4X^2+Y^2)"
  elseif Eq = 7 then
    print at 3,5, "SIN(3X)+SIN(3Y)"
  elseif Eq = 8 then
    print at 17,4, "BOWL"
    print at 3,5, "X*X+Y*Y"
  elseif Eq = 9 then
    print at 17,4, "SIN DIST"
    print at 3,5, "SIN(SQR(X*X+Y*Y))"
  elseif Eq = 10 then
    print at 17,4, "THUMBTACK"
    print at 3,5, "COS(SQR(X*X+Y*Y))"
    print at 3,6, "/(SQR(X*X+Y*Y)+1)"
  elseif Eq = 11 then
    print at 17,4, "SPIKE"
    print at 3,5, "COS(SQR(X*X+Y*Y))"
    print at 3,6, "/(10*SQR(X*X+Y*Y)+1)"
  elseif Eq = 12 then
    print at 17,4, "MODULATION"
    print at 3,5, "10/SQR(X*X+Y*Y)*SIN(SQR("
    print at 3,6, "X*X+Y*Y))*COS(X/2)"
  else
    print at 17,4, "CROSS SECT."
    print at 3,5, "SIN(SQR(X*X+Y*Y))"
    print at 3,6, "Y FROM -3 TO 0"
  end if
  NumU = Ang * 15
  print at 18,8, digits$(NumU, 3)
  if Tilt = 0 then print at 18,9, "12 (LOW) "
  if Tilt = 1 then print at 18,9, "22       "
  if Tilt = 2 then print at 18,9, "35       "
  if Tilt = 3 then print at 18,9, "50 (HIGH)"
  if Hgt = 0 then print at 18,10, "LOW "
  if Hgt = 1 then print at 18,10, "MID "
  if Hgt = 2 then print at 18,10, "HIGH"
  if Mesh = 0 then print at 18,11, "23 X 23"
  if Mesh = 1 then print at 18,11, "11 X 11"
  if Mesh = 2 then print at 18,11, "7 X 7  "
  if Persp = 0 then print at 18,12, "NONE    "
  if Persp = 1 then print at 18,12, "FAR EYE "
  if Persp = 2 then print at 18,12, "NEAR EYE"
  if Hidden = 1 then print at 18,13, "REMOVED"
  if Hidden = 0 then print at 18,13, "SHOWN  "
  if Scheme = 0 then print at 18,14, "SUNSET  "
  if Scheme = 1 then print at 18,14, "OCEAN   "
  if Scheme = 2 then print at 18,14, "FOREST  "
  if Scheme = 3 then print at 18,14, "NEON    "
  if Scheme = 4 then print at 18,14, "PAPER   "
  if Scheme = 5 then print at 18,14, "AMIGA   "
  return
end sub

sub TitlePage:
  ' A surface draws itself while the tune plays
  play sound SndTuneA
  play sound SndTuneB
  Title = 1
  Eq = 9
  EqDefaults
  Mesh = 0
  Tilt = 3
  Hgt = 0
  Scheme = 5
  Render
  Rearm
  pause until press
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  Title = 0
  Eq = 0
  EqDefaults
  Hgt = 1
  Scheme = 0
  return
end sub

sub EditorialPage:
  nmi off
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 7,1, "3-D SUPER PLOTTER"
  print at 2,3, "TWO COMPUTE! PROGRAMS:"
  print at 2,4, "3-D SURFACES FOR AMIGA BY"
  print at 2,5, "MARTIN STALEY (MARCH 1987)"
  print at 2,6, "AND SUPERPLOTTER FOR THE"
  print at 2,7, "C64 BY GREG PERKINS AND"
  print at 2,8, "DERRY BRYSON."
  print at 2,10, "THEY TOOK MINUTES IN BASIC."
  print at 2,11, "HERE THE 14 EQUATIONS ARE"
  print at 2,12, "SAMPLED AHEAD OF TIME AND"
  print at 2,13, "THE Z80 DRAWS EACH VIEW,"
  print at 2,14, "HIDDEN LINES REMOVED, FROM"
  print at 2,15, "ANY ANGLE, WITH OR WITHOUT"
  print at 2,16, "PERSPECTIVE."
  print at 2,18, "COLECOVISION VERSION BY"
  print at 2,19, "AMY BIENVENU, 2026."
  print at 4,22, "PRESS A BUTTON"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' "3-D SUPER PLOTTER"
data TxtTitle bytes = 51, 45, 68, 32, 83, 85, 80, 69, 82, 32, 80, 76, 79, 84, 84, 69, 82, 0
' "PRESS A BUTTON"
data TxtPress bytes = 80, 82, 69, 83, 83, 32, 65, 32, 66, 85, 84, 84, 79, 78, 0
' "STICK TURNS  BUTTON: MENU"
