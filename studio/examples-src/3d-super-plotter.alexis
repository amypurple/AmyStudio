  $6B,$6A,$69,$68,$68,$67,$66,$65,$65,$64,$63,$62,$62,$61,$60,$60,$5F,$5E,$5E,$5D,$5D,$5C,$5B,$5B,$5A,$5A,$59,$59,$58,$57,$57,$56
  $56,$55,$55,$54,$54,$53,$53,$52,$52,$51,$51,$50,$50,$50,$4F,$4F,$4E,$4E,$4D,$4D,$4D,$4C,$4C,$4B,$4B,$4A,$4A,$4A,$49,$49,$49,$48
