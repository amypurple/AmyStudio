data Ptr words = @UTab, @VTab, @ZTab, @DTab, @PTab, @Surf0, @Surf1, @Surf2, @Surf3, @Surf4, @Surf5, @Surf6, @Surf7, @Surf8, @Surf9, @Surf10, @Surf11, @Surf12, @Surf13

asm {
SfTick:
    db $C0,$40,$40,$01,$C0,$40,$F0,$01,$D0
SfPick:
    db $C0,$55,$30,$02,$C0,$40,$50,$02,$D0
SfDone:
    db $40,$8F,$20,$04,$40,$8F,$F0,$01,$40,$6B,$20,$04,$40,$6B,$F0,$01,$40,$55,$20,$04,$40,$55,$F0,$01
    db $40,$47,$20,$04,$40,$47,$F0,$01,$50

SfSoundTable:
    dw SfTick,$702B
    dw SfPick,$7049
    dw SfDone,$7035
    dw SfTuneMel,$703F
    dw SfTuneBass,$7049
; Title tune: Wireframe Waltz, a bright theme in C major (original for this game)
; Tiny Sound, 8 frames per step
SfTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1F,$01,$23,$01,$26,$01,$2B,$01,$2A,$01,$26,$01
    db $28,$01,$01,$01,$24,$01,$28,$01,$2B,$01,$2F,$01,$2D,$01,$2A,$01
    db $2B,$01,$01,$01,$2F,$01,$2D,$01,$2B,$01,$2A,$01,$28,$01,$26,$01
    db $24,$01,$01,$01,$23,$01,$26,$01,$21,$01,$24,$01,$23,$01,$21,$01
    db $1F,$01,$01,$01,$02,$40,$1A,$21,$26,$01,$28,$01,$2A,$01,$2B,$01
    db $2D,$01,$2F,$01,$30,$01,$01,$01,$2F,$01,$2D,$01,$2B,$01,$2A,$01
    db $28,$01,$26,$01,$23,$01,$01,$01,$02,$30,$1A,$21,$24,$01,$28,$01
    db $26,$01,$2A,$01,$2B,$01,$2F,$01,$2D,$01,$01,$01,$2B,$01,$01,$01
    db $26,$01,$01,$01,$2B,$01,$01,$01,$01,$01,$01,$01
    db $FF
SfTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$10,$01,$17,$01,$0E,$01,$15,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$09,$01,$10,$01
    db $0E,$01,$15,$01,$07,$01,$0E,$01,$0E,$01,$15,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$02,$60,$18,$32,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $07,$01,$0E,$01,$07,$01,$0E,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $10,$01,$17,$01,$10,$01,$17,$01,$0C,$01,$13,$01,$0C,$01,$13,$01
    db $07,$01,$0E,$01,$07,$01,$0E,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $07,$01,$0E,$01,$07,$01,$0E,$01
    db $FF
; MulK: Mr = Ma * Kp / 64, at most 255 (perspective scaling)
MulK:
    ld a,(AMY_UVAR_Ma)
    ld e,a
    ld d,0
    ld a,(AMY_UVAR_Kp)
    ld hl,0
    ld b,8
mk_lp:
    add hl,hl
    add a,a
    jr nc,mk_no
    add hl,de
mk_no:
    djnz mk_lp
    ld a,h
    cp $40
    jr c,mk_ok
    ld a,255
    jr mk_st
mk_ok:
    add hl,hl
    add hl,hl
    ld a,h
mk_st:
    ld (AMY_UVAR_Mr),a
    ret

; Pset: plots pixel Xc,Yy in colour Col on the bitmap screen (pattern
; table at $0000, colour table at $2000, name table in order), with the
; NMI off. The colour byte is Col on a transparent background.
Pset:
    ld a,(AMY_UVAR_Yy)
    ld h,a
    srl h
    srl h
    srl h                       ; h = Yy / 8 (third row of 8 pixels)
    and 7
    ld l,a
    ld a,(AMY_UVAR_Xc)
    and $F8
    or l
    ld l,a                      ; hl = (Yy/8)*256 + (Xc & $F8) + (Yy & 7)
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a                 ; read address
    ld a,(AMY_UVAR_Xc)
    and 7
    ld b,a
    ld a,$80
    jr z,ps_bit
ps_sh:
    srl a
    djnz ps_sh
ps_bit:
    ld c,a
    nop
    nop
    in a,($BE)
    or c
    ld c,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,c
    out ($BE),a                 ; the pattern byte with the new bit
    ld a,l
    out ($BF),a
    ld a,h
    or $60                      ; $2000 + address, write
    out ($BF),a
    ld a,(AMY_UVAR_Col)
    add a,a
    add a,a
    add a,a
    add a,a
    out ($BE),a
    ret

; BText: writes the zero-ended string at HL on the bitmap screen at text
; row TxRow, column TxCol, in colour TxCol8 on a transparent background.
; The glyphs come from the copy of the font kept at VRAM $3800 (FontKeep).
BText:
bt_lp:
    ld a,(hl)
    or a
    ret z
    inc hl
    push hl
    sub 32
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$3800
    add hl,de                   ; glyph address in VRAM
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld hl,AMY_UVAR_Glyph
    ld b,8
bt_rd:
    nop
    nop
    in a,($BE)
    ld (hl),a
    inc hl
    djnz bt_rd
    ld a,(AMY_UVAR_TxRow)
    ld h,a
    ld a,(AMY_UVAR_TxCol)
    add a,a
    add a,a
    add a,a
    ld l,a                      ; pattern address: row*256 + col*8
    push hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_Glyph
    ld b,8
bt_wr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz bt_wr
    pop hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_TxClr)
    add a,a
    add a,a
    add a,a
    add a,a
    ld b,8
bt_cl:
    out ($BE),a
    nop
    nop
    nop
    djnz bt_cl
    ld hl,AMY_UVAR_TxCol
    inc (hl)
    pop hl
    jr bt_lp
}
