  tile screen
  set sound table SkSoundTable areas 6
  sprites 16x16
  set sprite count 4
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel >= 3 then goto title
round_again:
  PlayRound
  if Again = 1 then goto round_again
  goto title

' ---------------------------------------------------------------------------
' a round: NClay throws, then YOU HIT n% and PLAY AGAIN / QUIT

sub PlayRound:
  DrawField
  Hits = 0
  Thrown = 0
  Side = 0
  CX = 128
  CY = 80
  HoldT = 0
  Phase = 0
  IconK = 0
  Recoil = 0
  BangT = 0
  GunS = 255
  Again = 0
  ShowScore
  ShowHint
  DrawIcons
  DrawAll
  ShowScreen
  Rearm
  wait no fire
  nmi off
  OldJ = 63
  InPlay = 1
pr_loop:
  Frame1
  GetInput
  PlayStep
  DrawAll
  if Phase <> 7 then goto pr_loop
  InPlay = 0
  HideSprites
  return
end sub

' one pass: the pointer, then the throw
sub PlayStep:
  if Phase <> 4 then MoveCross
  select case Phase
  case 0
    if (E & 48) <> 0 then ClickReady
  case 1
    dec WaitT
    if WaitT = 0 then Launch
  case 2
    Fly
  case 3
    dec RestT
    if RestT = 0 then NextThrow
  case 4
    OptStep
  case 6
    EndStep
  end select
  if Recoil > 0 then dec Recoil
  if BangT > 0 then dec BangT
  return
end sub

sub MoveCross:
  if (J & 15) <> 0 then
    if HoldT < 30 then inc HoldT
  else
    HoldT = 0
  end if
  V = 2
  if HoldT >= 12 then V = 3
  if (J & 4) <> 0 then
    if CX >= MinCX + V then
      CX = CX - V
    else
      CX = MinCX
    end if
  end if
  if (J & 8) <> 0 then
    if CX + V <= MaxCX then
      CX = CX + V
    else
      CX = MaxCX
    end if
  end if
  if (J & 1) <> 0 then
    if CY >= MinCY + V then
      CY = CY - V
    else
      CY = MinCY
    end if
  end if
  if (J & 2) <> 0 then
    if CY + V <= MaxCY then
      CY = CY + V
    else
      CY = MaxCY
    end if
  end if
  return
end sub

' which balloon the pointer is on: 1 upper left, 2 lower left, 3 upper
' right, 4 lower right, 0 none
function IconAt as u8
  N = 0
  if CX <= 39 then N = 1
  if CX >= 216 then N = 3
  if N = 0 then return 0
  if CY >= 24 and CY <= 39 then return N
  if CY >= 104 and CY <= 119 then
    N = N + 1
    return N
  end if
  return 0

sub ClickReady:
  K = IconAt()
  if K > 0 then
    PullCall(K)
  else
    if CX <= 71 and CY >= 166 then OpenOpts
  end if
  return
end sub

' PULL from balloon Ic: upper ones (1, 3) ask for a great shot early,
' lower ones (2, 4) late
sub PullCall(u8 Ic):
  IconK = Ic
  V = Ic & 1
  if V = 1 then
    CallK = 1
  else
    CallK = 2
  end if
  Side = Side ^ 1
  Rand
  W16 = Rs & 15
  WaitT = W16 + 6
  W16 = Rs >> 5
  W16 = W16 % 3
  VarK = W16
  Phase = 1
  ClearMsg
  DrawIcons
  play sound SndPull
  return
end sub

sub Launch:
  if Side = 1 then
    KX = RightX
  else
    KX = LeftX
  end if
  KY = HouseY
  KStep = 0
  Sz = 0
  SubF = 0
  Shot = 0
  HitF = 0
  Shard = 0
  GreatF = 0
  Phase = 2
  IconK = 0
  DrawIcons
  play sound SndThrow
  return
end sub

' the flight: a step every Spf passes; the button (held, not only
' pressed) fires the one shot
sub Fly:
  inc SubF
  if SubF >= Spf then
    SubF = 0
    ClayStep
  end if
  if HitF = 1 then inc Shard
  if (J & 48) <> 0 then
    if Shot = 0 then TakeShot
  end if
  if KStep >= NStep then EndThrow
  return
end sub

sub ClayStep:
  Sz = SizeT[KStep]
  T = DxT[KStep]
  if Side = 1 then
    KX = KX - T
  else
    KX = KX + T
  end if
  T = Dy8T[KStep]
  KY = KY + T
  KY = KY - 8
  if KStep < 10 then
    KY = KY + 1
    KY = KY - VarK
  end if
  inc KStep
  return
end sub

sub TakeShot:
  Shot = 1
  ShotStep = KStep
  Recoil = 8
  BangT = 12
  play sound SndShot
  if Near(CX, KX, HxT[Sz]) = 0 then return
  if Near(CY, KY, HyT[Sz]) = 0 then return
  HitF = 1
  Shard = 0
  play sound SndBreak
  return
end sub

' 1 when A and B are at most D apart
function Near(u8 A, u8 B, u8 D) as u8
  if A >= B then
    T = A - B
  else
    T = B - A
  end if
  V = 0
  if T <= D then V = 1
  return V

sub EndThrow:
  inc Thrown
  RestT = 40
  ShowScore
  Phase = 3
  if HitF = 1 then
    inc Hits
    ShowScore
    GreatF = IsGreat()
    if GreatF = 1 then
      RestT = 30
      print at 10,MsgRow, "GREAT SHOT!"
      set sprite 1 to 207,0,0,0
      update sprites
      play voxpcm GreatVoice
      play sound SndGreat
    end if
  end if
  return
end sub

function IsGreat as u8
  N = 0
  if CallK = 1 then
    if ShotStep < 5 then N = 1
  else
    if ShotStep >= 25 then N = 1
  end if
  return N

sub NextThrow:
  ClearMsg
  if Thrown >= NClay then
    EndRound
  else
    Phase = 0
    ShowHint
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the options box (between throws)

sub OpenOpts:
  Phase = 4
  OptSel = 0
  ShowOpts
  play sound SndPick
  return
end sub

sub ShowOpts:
  for Ri = 5 to 10
    print at 6,Ri, "                    "
  next
  print at 10,5, "OPTIONS"
  for Ri = 0 to 2
    put char 32 at 8,Ri + 7
  next
  put char 62 at 8,OptSel + 7
  NumU = ClaysT[ClaySel]
  print at 10,7, "PIGEONS: " + digits$(NumU, 3)
  select case SpdSel
  case 0
    print at 10,8, "SPEED: SLOW  "
  case 1
    print at 10,8, "SPEED: MEDIUM"
  case else
    print at 10,8, "SPEED: FAST  "
  end select
  print at 10,9, "OK"
  return
end sub

sub OptStep:
  if (E & 1) <> 0 then
    if OptSel > 0 then dec OptSel
    play sound SndPick
    ShowOpts
  end if
  if (E & 2) <> 0 then
    if OptSel < 2 then inc OptSel
    play sound SndPick
    ShowOpts
  end if
  if (E & 60) = 0 then return
  select case OptSel
  case 0
    if (E & 4) <> 0 then
      StepClay(3)
    else
      StepClay(1)
    end if
    NClay = ClaysT[ClaySel]
  case 1
    if (E & 4) <> 0 then
      if SpdSel = 0 then SpdSel = 2 else dec SpdSel
    else
      if SpdSel = 2 then SpdSel = 0 else inc SpdSel
    end if
    Spf = SpfT[SpdSel]
  case else
    if (E & 48) <> 0 then CloseOpts
    return
  end select
  play sound SndPick
  ShowOpts
  return
end sub

' the next pigeon count up (D = 1) or down (D = 3), never under the throws
' already made
sub StepClay(u8 D):
  ClaySel = (ClaySel + D) & 3
  while ClaysT[ClaySel] < Thrown
    ClaySel = (ClaySel + D) & 3
  end while
  return
end sub

sub CloseOpts:
  DrawSky
  ShowHint
  Phase = 0
  if Thrown >= NClay then EndRound
  play sound SndPick
  return
end sub

' ---------------------------------------------------------------------------
' the end: YOU HIT n%, PLAY AGAIN or QUIT

sub EndRound:
  ClearMsg
  W16 = Hits * 100
  NumU = W16 / NClay
  if NumU < 10 then
    print at 10,9, "YOU HIT " + digits$(NumU, 1) + "%"
  else
    if NumU < 100 then
      print at 10,9, "YOU HIT " + digits$(NumU, 2) + "%"
    else
      print at 10,9, "YOU HIT " + digits$(NumU, 3) + "%"
    end if
  end if
  print at 7,12, "PLAY AGAIN"
  print at 20,12, "QUIT"
  IdleT = 0
  Phase = 6
  mute all
  play sound SndOver
  return
end sub

sub EndStep:
  if J = 0 then
    inc IdleT
  else
    IdleT = 0
  end if
  ' left alone for 30 seconds: back to the title
  if IdleT >= 1800 then
    Again = 0
    Phase = 7
    return
  end if
  if (E & 48) = 0 then return
  if CY < 94 or CY > 105 then return
  if CX >= 54 and CX <= 137 then
    Again = 1
    Phase = 7
    play sound SndPick
  end if
  if CX >= 158 and CX <= 193 then
    Again = 0
    Phase = 7
    play sound SndPick
  end if
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' input

sub GetInput:
  ReadPads
  J = Pads
  E = J & (J ^ OldJ)
  OldJ = J
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).button1 then T = T | 16
  if joypad(P).button2 then T = T | 32
  return T

' ---------------------------------------------------------------------------
' drawing

sub DrawField:
  NewScreen
  DrawSky
  for Ri = 0 to 15
    X = Ri * 2
    put char TTreea at X,12
    put char TTreeb at X + 1,12
  next
  fill TTreec count 64 at 0,13
  for Ri = 15 to 23
    GrassRow(Ri, 0, 32)
  next
  put char THousel00 at 6,15
  put char THousel01 at 7,15
  put char THousel10 at 6,16
  put char THousel11 at 7,16
  put char THouser00 at 24,15
  put char THouser01 at 25,15
  put char THouser10 at 24,16
  put char THouser11 at 25,16
  print at 2,21, "OPTIONS"
  return
end sub

sub GrassRow(u8 R, u8 X0, u8 Nc):
  V = R & 1
  if V = 0 then
    fill TGrass count Nc at X0,R
  else
    fill TGrass2 count Nc at X0,R
  end if
  return
end sub

' the sky rows (also after the options box)
sub DrawSky:
  for Ri = 1 to 11
    fill TSky count 32 at 0,Ri
  next
  fill TSky count 32 at 0,0
  put char TCloudl at 5,6
  put char TCloudm at 6,6
  put char TCloudr at 7,6
  put char TCloudl at 19,8
  put char TCloudm at 20,8
  put char TCloudm at 21,8
  put char TCloudr at 22,8
  ShowScore
  DrawIcons
  return
end sub

sub DrawIcons:
  DrawBalloon(3, 3, 1)
  DrawBalloon(3, 13, 2)
  DrawBalloon(27, 3, 3)
  DrawBalloon(27, 13, 4)
  return
end sub

sub DrawBalloon(u8 Bx, u8 By, u8 Ic):
  C = TBall00
  if Ic = IconK then C = TBalli00
  put char C at Bx,By
  put char C + 1 at Bx + 1,By
  put char C + 2 at Bx,By + 1
  put char C + 3 at Bx + 1,By + 1
  return
end sub

sub ShowScore:
  NumU = Hits
  print at 6,1, "SCORE: " + digits$(NumU, 3)
  NumU = Thrown
  print at 17,1, "OUT OF: " + digits$(NumU, 3)
  return
end sub

sub ShowHint:
  print at 4,MsgRow, "POINT AT A PULL BALLOON"
  return
end sub

sub ClearMsg:
  print at 2,MsgRow, "                            "
  return
end sub

sub DrawAll:
  ' the gun turns toward the pointer
  if CX < 96 then
    Aim = 0
  else
    if CX > 160 then
      Aim = 2
    else
      Aim = 1
    end if
  end if
  N = Aim * 4
  if Recoil > 0 then N = N + 2
  if BangT > 0 then N = N + 1
  if N <> GunS then
    GunS = N
    DrawGun
  end if
  DrawSprites
  return
end sub

' the toy shotgun: muzzle, two barrel rows, two stock rows, one row lower
' while it recoils, the BANG burst over the muzzle
sub DrawGun:
  for Gi = 15 to 22
    GrassRow(Gi, 11, 9)
  next
  Y = 17
  if Recoil > 0 then Y = 18
  K = Aim * 5
  for Gi = 0 to 4
    X = GunColT[K + Gi]
    select case Gi
    case 0
      if BangT > 6 then
        put char TFlash at X,Y
      else
        put char TMuzl at X,Y
      end if
    case 1
      put char TBarl at X,Y
    case 2
      put char TBarl at X,Y
    case else
      put char TStock at X,Y
    end select
    inc Y
  next
  if BangT > 0 then
    X = GunColT[K]
    Y = 15
    if Recoil > 0 then Y = 16
    put char TBang00 at X,Y
    put char TBang01 at X + 1,Y
    put char TBang10 at X,Y + 1
    put char TBang11 at X + 1,Y + 1
  end if
  return
end sub

sub DrawSprites:
  if Phase < 4 and CX >= FieldL and CX <= FieldR and CY <= FieldB then
    X = CX - 7
    Y = CY - 7
    set sprite 0 to Y,X,SCross,1
  else
    Y = CY - 1
    set sprite 0 to Y,CX,SArrow,15
  end if
  if Phase = 2 then
    X = KX - 8
    Y = KY - 8
    if HitF = 0 then
      set sprite 1 to Y,X,ClaySprT[Sz],8
    else
      if Shard < 8 then
        set sprite 1 to Y,X,SShard1,8
      else
        if Shard < 16 then
          set sprite 1 to Y,X,SShard2,6
        else
          set sprite 1 to 207,0,0,0
        end if
      end if
    end if
  else
    set sprite 1 to 207,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' frames and screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for K = 0 to 3
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F5
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop light blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' title and credits

sub TitlePage:
  NewScreen
  for Ri = 0 to 19
    fill TSky count 32 at 0,Ri
  next
  copy TitleMap count 160 to vram.name + 64
  print at 6,8, "CLAY TARGET SHOOTING"
  print at 3,16, "PULL: POINT AT A BALLOON,"
  print at 3,17, "PRESS A BUTTON, LET GO."
  print at 3,18, "AIM THE SIGHT AND SHOOT:"
  print at 3,19, "ONE SHOT A PIGEON."
  fill TGrass count 32 at 0,20
  fill TGrass2 count 32 at 0,21
  fill TGrass count 32 at 0,22
  fill TGrass2 count 32 at 0,23
  put char THousel00 at 3,20
  put char THousel01 at 4,20
  put char THousel10 at 3,21
  put char THousel11 at 4,21
  put char THouser00 at 27,20
  put char THouser01 at 28,20
  put char THouser10 at 27,21
  put char THouser11 at 28,21
  Sel = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 672
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 63
tp_loop:
  Frame1
  inc Rs
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 4 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  select case Sel
  case 1
    if (N & 60) <> 0 then
      if (N & 4) <> 0 then
        ClaySel = (ClaySel + 3) & 3
      else
        ClaySel = (ClaySel + 1) & 3
      end if
      play sound SndPick
      ShowMenu
    end if
  case 2
    if (N & 60) <> 0 then
      if (N & 4) <> 0 then
        if SpdSel = 0 then SpdSel = 2 else dec SpdSel
      else
        if SpdSel = 2 then SpdSel = 0 else inc SpdSel
      end if
      play sound SndPick
      ShowMenu
    end if
  case else
    if (N & 48) <> 0 then goto tp_done
  end select
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  NClay = ClaysT[ClaySel]
  Spf = SpfT[SpdSel]
  if Sel = 3 then HowToPage
  if Sel = 4 then CreditsPage
  return
end sub

sub ShowMenu:
  for Ti = 0 to 4
    put char 32 at 8,Ti + 10
  next
  put char 62 at 8,Sel + 10
  print at 10,10, "START"
  NumU = ClaysT[ClaySel]
  print at 10,11, "CLAYS: " + digits$(NumU, 3)
  select case SpdSel
  case 0
    print at 10,12, "SPEED: SLOW  "
  case 1
    print at 10,12, "SPEED: MEDIUM"
  case else
    print at 10,12, "SPEED: FAST  "
  end select
  print at 10,13, "HOW TO PLAY"
  print at 10,14, "CREDITS"
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "CLAY PIGEONS FLY FROM THE"
    print at 2,4, "TWO TRAP HOUSES. SHOOT AS"
    print at 2,5, "MANY AS YOU CAN!"
    print at 2,7, "YOU HAVE ONE SHOT FOR EACH"
    print at 2,8, "PIGEON. THE GAME ENDS AFTER"
    print at 2,9, "THE LAST PIGEON (10 TO 100)."
    for Ri = 11 to 15
      fill TSky count 28 at 2,Ri
    next
    fill TGrass count 28 at 2,16
    fill TGrass2 count 28 at 2,17
    put char TCloudl at 18,12
    put char TCloudm at 19,12
    put char TCloudr at 20,12
    put char TBall00 at 3,11
    put char TBall01 at 4,11
    put char TBall10 at 3,12
    put char TBall11 at 4,12
    put char THouser00 at 24,15
    put char THouser01 at 25,15
    put char THouser10 at 24,16
    put char THouser11 at 25,16
    set sprite 0 to 98,136,SCross,1
    set sprite 1 to 98,136,SClay1,8
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: MOVE THE ARROW."
    print at 2,5, "TO THROW A PIGEON, POINT AT"
    print at 2,6, "A PULL BALLOON IN A CORNER,"
    print at 2,7, "PRESS A BUTTON AND LET GO."
    print at 2,9, "OVER THE FIELD THE ARROW IS"
    print at 2,10, "A GUN SIGHT. PRESS A BUTTON"
    print at 2,11, "TO SHOOT."
    print at 2,13, "OPTIONS (BOTTOM LEFT) SETS"
    print at 2,14, "THE PIGEONS AND THE SPEED."
    put char TBall00 at 8,17
    put char TBall01 at 9,17
    put char TBall10 at 8,18
    put char TBall11 at 9,18
    set sprite 0 to 135,72,SArrow,15
    set sprite 1 to 135,168,SCross,15
    set sprite 2 to 135,168,SClay0,8
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "SCORE COUNTS YOUR HITS, OUT"
    print at 2,4, "OF THE PIGEONS THROWN. AT"
    print at 2,5, "THE END YOU SEE YOUR HITS"
    print at 2,6, "IN PER CENT."
    print at 2,8, "GREAT SHOT! FROM A TOP"
    print at 2,9, "BALLOON, HIT THE PIGEON"
    print at 2,10, "WHILE IT IS STILL BIG. FROM"
    print at 2,11, "A BOTTOM BALLOON, HIT IT"
    print at 2,12, "WHEN IT IS VERY SMALL."
    set sprite 0 to 111,64,SClay0,8
    set sprite 1 to 111,120,SClay2,8
    set sprite 2 to 111,176,SClay4,8
    print at 7,16, "BIG"
    print at 21,16, "SMALL"
    print at 2,18, "TIP: DON'T HOLD THE BUTTON"
    print at 2,19, "AFTER A PULL - IT WASTES"
    print at 2,20, "YOUR SHOT!"
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 63
  Wt = 0
ht_wait:
  Frame1
  ReadPads
  N = Pads & (Pads ^ OldPads)
  Wt = Wt + 1
  if Wt >= 1800 then return
  if (N & 48) = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "SKEET"
  print at 2,4, "BASED ON SKEET BY ROGER M."
  print at 2,5, "PINGLETON, JR., A GEOS DESK"
  print at 2,6, "ACCESSORY IN COMPUTE!'S"
  print at 2,7, "GAZETTE, MAY 1988 (GEOS"
  print at 2,8, "COLUMN), COMMODORE 64/128,"
  print at 2,9, "(C) 1988 COMPUTE! PUBL."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CLEAR MORNING ON THE"
  print at 2,19, "FIELD (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

