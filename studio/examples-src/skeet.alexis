' a timer for the title tune (kit/tuneonce.py)
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 IdleT = 0
' the pointer
u8 CX = 128
u8 CY = 80
u8 HoldT = 0
' the clay
u8 KX = 0
u8 KY = 0
u8 KStep = 0
u8 Sz = 0
u8 SubF = 0
u8 Spf = 3
u8 VarK = 0
u8 Side = 0
u8 CallK = 0
u8 IconK = 0
u8 WaitT = 0
u8 Shot = 0
u8 HitF = 0
u8 ShotStep = 0
u8 GreatF = 0
u8 RestT = 0
u8 Shard = 0
u8 Phase = 0
' the gun
u8 Aim = 1
u8 Recoil = 0
u8 BangT = 0
u8 GunS = 255
' the round
u8 Hits = 0
u8 Thrown = 0
u8 NClay = 20
u8 ClaySel = 1
u8 SpdSel = 1
u8 Sel = 0
u8 Pg = 0
u16 Wt = 0
u8 OptSel = 0
u8 Again = 0
' input: J (1 up, 2 down, 4 left, 8 right, 16 left button, 32 right
' button), OldJ last pass's, E the new presses
u8 J = 0
u8 OldJ = 0
u8 E = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 InPlay = 0
' loop counters (never shared with the helpers)
u8 Ti = 0
u8 Ri = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
