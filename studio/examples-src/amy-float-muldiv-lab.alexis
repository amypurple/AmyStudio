' FP5 mul/div lab: native fp5 multiply and divide smoke cases.
u16 UTwo = 2
u16 UThree = 3
u16 UFour = 4
u16 UTen = 10
u16 UHundred = 100
i16 SNegTwo = -2
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0
fp5 H = 0
fp5 I = 0
fp5 J = 0

  text screen
  print at 7,0, "FP5 MUL/DIV LAB"

  A = UThree
  A *= UFour
  B = UHundred
  B /= UFour
  C = UTen
  C *= SNegTwo
  D = UTen
  D /= UTwo
  E = UTen
  E /= UThree
  F = UTwo
  F /= UFour
  G = UTwo
  G *= UTwo
  H = UThree
  H *= UThree
  I = UTen
  I *= UTen
  J = UHundred
  J *= UHundred

  print at 1,4,  "3 * 4"
  print A at 12,4 digits 16
  print at 1,6,  "100 / 4"
  print B at 12,6 digits 16
  print at 1,8,  "10 * -2"
  print C at 12,8 digits 16
  print at 1,10, "10 / 2"
  print D at 12,10 digits 16
  print at 1,12, "10 / 3"
  print E at 12,12 digits 16
  print at 1,14, "2 / 4"
  print F at 12,14 digits 16
  print at 1,16, "2 * 2"
  print G at 12,16 digits 16
  print at 1,18, "3 * 3"
  print H at 12,18 digits 16
  print at 1,20, "10 * 10"
  print I at 12,20 digits 16
  print at 1,22, "100 * 100"
  print J at 12,22 digits 16

  screen on