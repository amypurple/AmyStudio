cartridge "3-D SPEEDWAY/CHRIS ULMER, GAZETTE/1988"

' 3-D SPEEDWAY
' A ColecoVision game based on "3-D Speedway" by Chris Ulmer, COMPUTE!'s
' Gazette, April 1988 (Commodore 64, machine language at $C000 with a
' BASIC boot; author from the LaunchBox games database, the program
' itself only says COPYRIGHT 1988 COMPUTE! PUBLICATIONS). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' Not a cell-for-cell port: the rules and numbers are the original's
' (read from its machine code, orig/3-d-speedway.dis, and runs in a C64
' emulator, orig/c64-*.png); the game is built for the ColecoVision.
'
' The game: you drive alone on a ring of posts across a wide valley. Hold
' the button to speed up, steer with the stick. Two other cars come down
' the road as you overtake them, wandering from lane to lane; posts stand
' at both edges. Touch one and you spin, lose your speed and some time.
' A lap is 250 posts. The first lap gives 46 seconds, each lap 3 seconds
' less; when the clock runs out the race is over. Score: the distance.
'
' From the original (C64 addresses in brackets): the C64 had no frame
' sync, so a "step" is one pass of its main loop, and the number of steps
' a ColecoVision frame makes follows the speed as the C64 loop's delay did
' (RateT, 2.0 to 3.3 steps a frame, tab.py). Each step: speed +2 (CC71,
' 8 to 248), -3 without the button, -3 more for each way steered; the car
' moves 1 a step between 81 and 240 (CC6B); the post comes nearer by
' (Pc >> 3) + 1 (CC68/CC69) and is passed at depth 65; 250 posts a lap
' (CC80), a lap counted when the post count wraps (CCFC lock of 8 posts);
' the time limit starts at 50 and loses 3 at every lap (CC7F), the first
' crossing being the start: 47, shown as 46 (TIME = limit - elapsed - 1);
' time in units of 64 frames (the jiffy clock >> 6); the score is the
' number of steps (CC88). The road's bend is a random walk of -1/0/+1 a
' post between 15 and 40 (CC6C) and shifts the far road by the C64's table
' (C944); the mountains slide 2, 1, 0 or -1 pixels every 20 steps by the
' bend (CA1A). The cars: every 20 steps (CC7C) after a wait of 300 steps
' (CC73), car 1 comes nearer by K >> 2 (K counts its ticks), starts again
' at depth 66 in lane 9; car 2 starts when car 1 first passes depth 22,
' and starts again in lane 5; each wanders a lane (-1/0/+1, one tick in
' four) in lanes 2-14 and 1-13 (C470, C657). Sizes by depth from the
' C64's tables (C989, C9D4). A crash (C7B5) stops the race for a moment
' while the clock runs on, sends both cars back to the horizon, restarts
' their wait and drops the speed to the bottom. The car's picture leans
' by where it is on the road (thresholds 120/200, moved 30 by steering).
'
' Liberties: a crash is a touch of the boxes the pictures fill (the C64
' used its sprite hardware: pixel collisions); the crash lasts 40 frames
' (the C64's wait was about 0.6 s); the car shakes instead of flashing.
' The cars and posts glide between their steps (the C64 moved the cars
' every 20 steps). The cars use 15 lanes 1/8 of the depth apart round the
' road's middle and the posts stand 1.3 x depth from it (the C64's
' screen was wider and its sprites bigger). The speed cannot wrap below 0
' (on the C64 a slow car steered both ways could, for one step). The stick
' replaces the joystick in port 2, either button the fire button. Stripes
' in the grass run with the posts (the C64's field was plain); an engine
' tone follows the speed; the TIME is shown every second (the C64 updated
' it at each post). The score is shown during the race (the C64 counted
' it up at the end) and the best score is kept. No PLAY AGAIN question:
' the end goes back to the title.
'
' Controls: the stick steers left and right; hold either button to speed
' up. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TSky = 128
const TBar = 129
const TMt0 = 130
const TMt1 = 131
const TMt2 = 132
const TMt3 = 133
const TMt4 = 134
const TMt5 = 135
const TMt6 = 136
const TMt7 = 137
const TMt8 = 138
const TMt9 = 139
const TMt10 = 140
const TMt11 = 141
const TMt12 = 142
const TMt13 = 143
const TMt14 = 144
const TMt15 = 145
const TMt16 = 146
const TMt17 = 147
const TMt18 = 148
const TMt19 = 149
const TMt20 = 150
const TMt21 = 151
const TMt22 = 152
const TMt23 = 153
const TMt24 = 154
const TMt25 = 155
const TMt26 = 156
const TMt27 = 157
const TMt28 = 158
const TMt29 = 159
const TMt30 = 160
const TMt31 = 161
const TMt32 = 162
const TGr0 = 163
const TGr1 = 164
const TGr2 = 165
const TGr3 = 166
const TGr4 = 167
const TGr5 = 168
const TGr6 = 169
const TGr7 = 170
const TGr8 = 171
const TGr9 = 172
const TGr10 = 173
const TGr11 = 174
const TGr12 = 175
const TGr13 = 176
const SPost0 = 0
const SPost1 = 4
const SPost2 = 8
const SPost3 = 12
const SPost4 = 16
const SCar0 = 20
const SCar1 = 24
const SCar2 = 28
const SCar3 = 32
const SCar4 = 36
const SCar5 = 40
const SCar6 = 44
const SPl0l = 48
const SPl0r = 52
const SPl1l = 56
const SPl1r = 60
const SPl2l = 64
const SPl2r = 68
const NTiles8 = 392
const SprBytes = 576
const NGr8 = 112
const NPh = 14
const TPost = 28
const Hor = 80
const SndTuneA = 1
const SndTuneB = 2
const SndCrash = 3
const SndGo = 4
const SndLap = 5
const SndOver = 6
const SndTick = 7
const NSpr = 6
const PlY = 169
const PxMin = 81
const PxMax = 240
const CrashN = 40

record Car:
  u8 D
  u8 K
  u8 L
end record

Car Cars[2]

data RateT bytes
  127,129,131,132,134,136,138,140,142,144,146,148,151,153,156,158
  161,163,166,169,172,175,178,182,185,189,192,196,200,205,209,214
end data
data EngLo bytes
  192,202,195,205,200,194,204,199,193,204,199,194,205,200,195,206
  201,197,192,204,199,195,207,203,199,195,207,203,199,195,192,204
end data
data EngHi bytes
  38,37,37,36,36,36,35,35,35,34,34,34,33,33,33,32
  32,32,32,31,31,31,30,30,30,30,29,29,29,29,29,28
end data

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = $1988
u16 Rt = 0
u8 Rb = 0
u16 LoopAcc = 0
u16 Clock = 0
bcd digits 6 Score = 0
bcd digits 6 Best = 0
u8 Spd = 2
u8 Px = 160
u8 Pd = 0
u8 Pc = 0
u8 PostN = 0
u8 LapLock = 0
u8 Laps = 255
u8 Limit = 50
u8 Curve = 26
u8 Ct = 0
u8 Wake = 0
u8 Car2On = 0
u8 Look = 1
u8 CrashT = 0
u8 Crashes = 0
u8 Over = 0
u8 Playing = 0
u8 Sk = 0
u8 SkShown = 255
u8 Ph = 0
u8 PhShown = 255
u8 TimeShown = 255
u8 EngLoV = $C0
u8 EngHiV = 0
u8 EngVol = $DF
u8 Joy = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Pcx = 128
u8 Hit = 0
u8 Hf = 0
u8 Hm = 0
u8 Hc = 0
u8 Hd = 0
u8 Tx = 0
u8 Ty = 0
u8 Tw = 0
u8 Th = 0
u16 MidB = 880
u8 Dd[2]
u8 Gl[2]
u8 Ig[2]
u8 Ri = 0
u8 J = 0
u8 V = 0
u16 NumU = 0

  tile screen
  set sound table SwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if

  NewRace
race_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawAll
  if Over = 0 then goto race_loop

  ' the end: the clock ran out
  Playing = 0
  EngVol = $DF
  EngOut
  play sound SndOver
  if Score > Best then Best = Score
  ShowEnd
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title


' ---- the race ---------------------------------------------------------

sub NewRace:
  Spd = 2
  Px = 160
  Pcx = 128
  Pd = 0
  Pc = 0
  PostN = 0
  LapLock = 0
  Laps = 255
  Limit = 50
  Curve = 26
  MidB = 880
  Ct = 0
  Wake = 0
  Car2On = 0
  ResetCars
  Cars[0].L = 8
  Cars[1].L = 4
  Look = 1
  CrashT = 0
  Crashes = 0
  Over = 0
  Clock = 0
  LoopAcc = 0
  Score = 0
  Sk = 0
  NewScreen
  DrawScene
  print at 2,1, "TIME"
  print at 10,1, "LAPS"
  print at 18,1, "SCORE"
  ShowLaps
  TimeShown = 255
  Playing = 1
  DrawAll
  ShowScreen
  play sound SndGo
  return
end sub

sub ResetCars:
  for Ri = 0 to 1
    Cars[Ri].D = 0
    Cars[Ri].K = 0
    Gl[Ri] = 0
    Ig[Ri] = 0
    Dd[Ri] = 0
  next
  return
end sub

' one frame of the race: as many C64 steps as the speed gives, the clock
sub PlayFrame:
  if CrashT > 0 then
    dec CrashT
    if CrashT = 0 then EndCrash
  else
    V = Spd >> 3
    LoopAcc = LoopAcc + RateT[V]
    while LoopAcc >= 64
      LoopAcc = LoopAcc - 64
      OneStep
      if CrashT > 0 then LoopAcc = 0
    end while
  end if
  inc Clock
  if Laps <> 255 then
    if Elapsed >= Limit then Over = 1
  end if
  return
end sub

function Elapsed as u8
  u16 E = 0
  E = Clock >> 6
  if E > 250 then E = 250
  return E

' one pass of the C64's main loop (C142-C46D)
sub OneStep:
  u8 Lt = 120
  u8 Rt2 = 200
  inc Pc
  inc Score
  Pd = Pd + (Pc >> 3) + 1
  Spd = Spd + 2
  if Spd < 8 then Spd = 8
  if Spd > 248 then Spd = 248
  inc Ct
  if Ct = 20 then
    Ct = 0
    SkyTick
    inc Wake
    if Wake = 16 then
      Wake = 15
      CarTick(0)
      if Car2On = 1 then CarTick(1)
    end if
  end if
  if Wake = 15 then
    Gl[0] = Gl[0] + Ig[0]
    Gl[1] = Gl[1] + Ig[1]
  end if
  Dd[0] = Cars[0].D + Div20[Gl[0]]
  Dd[1] = Cars[1].D + Div20[Gl[1]]
  HitAny
  if Hit = 1 then
    StartCrash
  else
    if (Joy & 16) = 0 then SpdDown(3)
    if (Joy & 4) <> 0 then
      dec Px
      SpdDown(3)
      Lt = Lt - 30
      Rt2 = Rt2 - 30
    end if
    if (Joy & 8) <> 0 then
      inc Px
      SpdDown(3)
      Lt = Lt + 30
      Rt2 = Rt2 + 30
    end if
    if Px < PxMin then Px = PxMin
    if Px > PxMax then Px = PxMax
    Pcx = PlayerX
    Look = 2
    if Px >= Lt then Look = 1
    if Px >= Rt2 then Look = 0
    if Pd >= 65 then PostPassed
  end if
  return
end sub

sub SpdDown(u8 By):
  if Spd >= By then
    Spd = Spd - By
  else
    Spd = 0
  end if
  return
end sub

' a post reaches the player (C35D-C46D)
sub PostPassed:
  u8 Dl = 0
  Pd = 0
  Pc = 0
  inc PostN
  if PostN = 250 then PostN = 0
  if PostN < 3 then
    if LapLock = 0 then NewLap
  end if
  if LapLock > 0 then dec LapLock
  Rnd16
  Dl = (Rb & 2) + (Rb & 1)
  if Dl = 3 then Dl = 1
  Curve = Curve + Dl - 1
  if Curve = 14 then Curve = 15
  if Curve = 41 then Curve = 40
  MidB = Curve - 15
  MidB = MidB * 80
  return
end sub

sub NewLap:
  inc Laps
  LapLock = 8
  Limit = Limit - 3
  Clock = 0
  if Laps > 0 then play sound SndLap
  ShowLaps
  return
end sub

' the mountains slide by the bend every 20 steps (C5DA)
sub SkyTick:
  Sk = Sk + SkyStep[Curve] - 2
  return
end sub

' a car's tick (C470 / C657): nearer by K >> 2, a lane to the side now
' and then, back to the horizon after depth 66
sub CarTick(u8 Ci):
  u8 D = 0
  u8 K = 0
  u8 L = 0
  u8 B = 0
  u8 Dl = 0
  D = Cars[Ci].D
  K = Cars[Ci].K
  L = Cars[Ci].L
  if D >= 66 then
    D = 0
    K = 0
    if Ci = 0 then
      L = 9
    else
      L = 5
    end if
  end if
  inc K
  D = D + (K >> 2)
  if Ci = 0 then
    if D >= 22 then Car2On = 1
  end if
  Rnd16
  select case Ci
  case 0
    if (Rb & $82) = $80 then
      B = Rb >> 3
      Dl = (B & 2) + (B & 1)
      if Dl = 3 then Dl = 1
      L = L + Dl - 1
      if L = 1 then L = 2
      if L >= 15 then L = 14
    end if
  case else
    if (Rb & $C0) = $40 then
      B = Rb >> 2
      Dl = (B & 2) + (B & 1)
      if Dl = 3 then Dl = 1
      L = L + Dl - 1
      if L = 0 then L = 1
      if L >= 14 then L = 13
    end if
  end select
  Cars[Ci].D = D
  Cars[Ci].K = K
  Cars[Ci].L = L
  Gl[Ci] = 0
  Ig[Ci] = 0
  if D < 66 then Ig[Ci] = (K + 1) >> 2
  return
end sub

' the depth a car is drawn at (and touched at): between its ticks it
' glides on, Gl = (K + 1) >> 2 x the steps since the tick, Dd = D + Gl / 20
' (in OneStep)

' the road's middle at depth Dp: the bend shifts the far road (C1D4-C209;
' MidT holds 128 + (Cw * Curve >> 4) - 2 * Cw, art.py)
function MidX(u8 Dp) as u8
  u16 Ix = 0
  Ix = MidB + Dp
  return MidT[Ix]

' lanes 1/8 of the depth apart: (L - 8) * Dp / 8, rounded down
function CarX(u8 Ci, u8 Dp) as i16
  i16 X = 0
  u16 Off = 0
  Off = Cars[Ci].L * Dp
  Off = Off >> 3
  X = MidX(Dp)
  X = X + Off
  return X - Dp

' the car's middle on the screen: Px * 4 / 5 (81-240 to 64-192)
function PlayerX as i16
  u16 Pw = 0
  Pw = Px * 205
  Pw = Pw >> 8
  return Pw

' does a thing (centre Tx, bottom line Ty, Tw wide, Th high) touch the
' car? Only near things are asked (depth 55 and more), whose centres are
' always on the screen, so bytes do. Sets Hit.
sub Touch:
  if Ty > 185 + Th then return
  if Tx >= Pcx then
    Tx = Tx - Pcx
  else
    Tx = Pcx - Tx
  end if
  Th = (Tw >> 1) + 15
  if Tx < Th then Hit = 1
  return
end sub

' a touch with a post or a car (checked every step: the C64 read its
' sprite collision register every pass)
sub HitAny:
  Hit = 0
  Ty = YbT[Pd]
  if Ty >= 175 then
    Hf = PostF[Pd]
    Hm = MidT[MidB + Pd]
    Tx = Hm - PoT[Pd]
    Tw = PostW[Hf]
    Th = PostH[Hf]
    Touch
    Ty = YbT[Pd]
    Tx = Hm + PoT[Pd]
    Th = PostH[Hf]
    Touch
  end if
  for Hc = 0 to 1
    Hd = Dd[Hc]
    Ty = YbT[Hd]
    if Ty >= 175 then
      if Cars[Hc].K > 0 then
        Hf = CarF[Hd]
        Hm = MidT[MidB + Hd]
        Tx = Hm + ((Cars[Hc].L * Hd) >> 3) - Hd
        Tw = CarW[Hf]
        Th = CarH[Hf]
        Touch
      end if
    end if
  next
  return
end sub

sub StartCrash:
  CrashT = CrashN
  inc Crashes
  play sound SndCrash
  return
end sub

' after the spin (C7F6-C82A): the cars go back, their wait restarts
sub EndCrash:
  ResetCars
  Wake = 0
  Car2On = 0
  Spd = 2
  return
end sub

' ---- drawing ------------------------------------------------------------

sub DrawAll:
  u8 F = 0
  u8 Dc = 0
  u8 Ci = 0
  u8 Pat = 0
  u8 Col = 0
  i16 X = 0
  i16 Mx = 0
  u8 Yb = 0
  u8 Sy = 0
  u8 Xp = 0
  ' the player's car (sprites 0 and 1), shaking after a crash
  X = Pcx
  X = X - 16
  if CrashT > 0 then
    if (CrashT & 4) = 0 then
      X = X - 2
    else
      X = X + 2
    end if
  end if
  Pat = Look << 3
  Pat = Pat + SPl0l
  Col = 8
  if CrashT > 0 then Col = 6
  Xp = X
  set sprite 0 to PlY,Xp,Pat,Col
  Xp = Xp + 16
  Pat = Pat + 4
  set sprite 1 to PlY,Xp,Pat,Col
  ' the posts (sprites 2 and 3)
  F = PostF[Pd]
  Pat = F << 2
  Pat = Pat + SPost0
  Mx = MidX(Pd)
  Yb = YbT[Pd]
  Sy = Yb - 17
  PutThing(2, Mx - PoT[Pd], Sy, Pat, 11)
  PutThing(3, Mx + PoT[Pd], Sy, Pat, 11)
  ' the cars (sprites 4 and 5)
  for Ci = 0 to 1
    J = Ci + 4
    if Cars[Ci].K = 0 then
      set sprite J to 192,0,0,0
    else
      Dc = Dd[Ci]
      F = CarF[Dc]
      Pat = F << 2
      Pat = Pat + SCar0
      Yb = YbT[Dc]
      Sy = Yb - 17
      Col = 5
      if Ci = 1 then Col = 13
      PutThing(J, CarX(Ci, Dc), Sy, Pat, Col)
    end if
  next
  update sprites
  ' the grass stripes run with the post
  Ph = PhT[Pc]
  if Ph <> PhShown then
    PhShown = Ph
    NumU = Ph * NGr8
    copy GrassCol + NumU count NGr8 to vram.color + TGr0 * 8
  end if
  if (Sk >> 3) <> SkShown then DrawSky
  ShowTime
  if (Tick & 7) = 0 then print at 24,1, Score
  Engine
  return
end sub

' a sprite centred on Cx (hidden when off the screen)
sub PutThing(u8 Sn, i16 Cx, u8 Sy, u8 Pat, u8 Col):
  u8 Xs = 0
  if Cx < 8 then
    set sprite Sn to 192,0,0,0
  elseif Cx > 247 then
    set sprite Sn to 192,0,0,0
  else
    Xs = Cx - 8
    set sprite Sn to Sy,Xs,Pat,Col
  end if
  return
end sub

sub ShowTime:
  u8 T = 0
  u8 E = 0
  if Laps = 255 then return
  E = Elapsed
  T = 0
  if E < Limit then T = Limit - E - 1
  if T <> TimeShown then
    TimeShown = T
    NumU = T
    print at 7,1, digits$(NumU, 2)
    if T < 6 then
      if Over = 0 then play sound SndTick
    end if
  end if
  return
end sub

sub ShowLaps:
  NumU = 0
  if Laps <> 255 then NumU = Laps
  print at 15,1, digits$(NumU, 2)
  return
end sub

sub Engine:
  V = Spd >> 3
  EngLoV = EngLo[V]
  EngHiV = EngHi[V]
  EngVol = $D9
  if CrashT > 0 then EngVol = $DF
  if Playing = 0 then EngVol = $DF
  EngOut
  return
end sub

sub EngOut:
  call asm SwEngOut
  return
end sub

sub DrawSky:
  u16 Src = 0
  u8 Col = 0
  SkShown = Sk >> 3
  Col = 32 - SkShown
  Col = Col & 31
  Src = Col
  copy SkyMap + Src count 32 to vram.name + 256
  Src = Src + 64
  copy SkyMap + Src count 32 to vram.name + 288
  return
end sub

' sky, mountains and grass (with the NMI off)
sub DrawScene:
  u8 Row = 0
  u8 Code = 0
  for Row = 0 to 7
    fill TSky count 32 at 0,Row
  next
  for Row = 10 to 23
    Code = TGr0 + Row - 10
    fill Code count 32 at 0,Row
  next
  SkShown = 255
  DrawSky
  PhShown = 255
  copy GrassCol count NGr8 to vram.color + TGr0 * 8
  return
end sub

sub ShowEnd:
  fill TBar count 28 at 2,2
  fill TSky count 28 at 2,3
  fill TSky count 28 at 2,4
  fill TSky count 28 at 2,5
  fill TBar count 28 at 2,6
  print at 9,3, "TIME IS UP!"
  print at 4,4, "LAPS"
  NumU = 0
  if Laps <> 255 then NumU = Laps
  print at 9,4, digits$(NumU, 2)
  print at 14,4, "SCORE"
  print at 20,4, Score
  print at 9,5, "BEST"
  print at 14,5, Best
  return
end sub

' ---- frames, input, screens --------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Joy = 0
  if joypad(1).up then Joy = Joy | 1
  if joypad(2).up then Joy = Joy | 1
  if joypad(1).down then Joy = Joy | 2
  if joypad(2).down then Joy = Joy | 2
  if joypad(1).left then Joy = Joy | 4
  if joypad(2).left then Joy = Joy | 4
  if joypad(1).right then Joy = Joy | 8
  if joypad(2).right then Joy = Joy | 8
  if joypad(1).fire then Joy = Joy | 16
  if joypad(2).fire then Joy = Joy | 16
  Btn = Joy & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' Rnd16: a 16-bit xorshift (7 9 8), Rb the new low byte
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rb = Rs & 255
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  DrawScene
  Playing = 0
  fill TBar count 28 at 2,1
  print at 9,2, "3-D SPEEDWAY"
  print at 8,3, "BY CHRIS ULMER"
  fill TBar count 28 at 2,4
  print at 11,5, "START"
  print at 11,6, "CREDITS"
  NumU = 0
  print at 6,7, "BEST"
  print at 11,7, Best
  Px = 160
  Pcx = 128
  Look = 1
  CrashT = 0
  Pd = 30
  Pc = 12
  Curve = 26
  MidB = 880
  Cars[0].K = 0
  Cars[1].K = 0
  DrawAll
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
tp_loop:
  Frame1
  Rnd16
  ReadPad
  V = Joy & 3
  if V <> 0 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 9,5
  put char 32 at 9,6
  J = Menu + 5
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  for Ri = 2 to 21
    fill TSky count 32 at 0,Ri
  next
  fill TBar count 28 at 2,2
  print at 9,3, "3-D SPEEDWAY"
  print at 2,5, "BASED ON 3-D SPEEDWAY BY"
  print at 2,6, "CHRIS ULMER, COMPUTE!'S"
  print at 2,7, "GAZETTE, APRIL 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: VALLEY RUN"
  print at 2,17, "(ORIGINAL)"
  fill TBar count 28 at 2,19
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
cr_loop:
  Frame1
  Rnd16
  ReadPad
  if Press = 0 then goto cr_loop
  return
end sub

