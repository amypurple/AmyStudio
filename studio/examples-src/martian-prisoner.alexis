data SceneFam bytes 3,3,3,3,4,4,2,2,5,0,0,0,0,4,6,1,1,7,7
data FamPatTab words = @MpFamPat0, @MpFamPat1, @MpFamPat2, @MpFamPat3, @MpFamPat4, @MpFamPat5, @MpFamPat6, @MpFamPat7
data FamColTab words = @MpFamCol0, @MpFamCol1, @MpFamCol2, @MpFamCol3, @MpFamCol4, @MpFamCol5, @MpFamCol6, @MpFamCol7
data SceneMapTab words = @MpMap0, @MpMap1, @MpMap2, @MpMap3, @MpMap4, @MpMap5, @MpMap6, @MpMap7, @MpMap8, @MpMap9, @MpMap10, @MpMap11, @MpMap12, @MpMap13, @MpMap14, @MpMap15, @MpMap16, @MpMap17, @MpMap18
data FieldTab bytes 139,134,140,141,142,143,144,145,146,146,154,155,156,157,158,159,146,146,154,166,167,168,169,159,146,146,154,172,173,174,175,159,146,146,154,180,181,182,183,159,192,193,194,195,196,197,198,159,204,204,205,206,207,208,209,210,139,134,211,212,213,214,215,145,146,146,159,181,182,183,216,159,146,146,217,196,197,198,218,159,146,146,217,156,157,158,219,159,146,146,217,167,168,169,174,159,192,193,220,173,174,175,221,159,204,204,222,223,224,225,226,210,139,134,227,228,229,143,230,145,146,146,154,168,169,174,181,159,146,146,154,174,175,182,231,159,146,146,159,182,183,197,232,159,146,146,154,197,198,157,233,159,192,193,234,157,158,168,235,159,204,204,205,236,237,238,239,210

' ShowScene: the picture of Scene on rows 1-7 (display off, NMI off). The
' tile set of its family is unpacked only when the family changes.
sub ShowScene:
  Shown = Scene
  Fam = SceneFam[Scene]
  if Fam <> FamShown then
    decompress zx0 FamPatTab[Fam] to vram.pattern + 1024
    decompress zx0 FamColTab[Fam] to vram.color + 1024
    FamShown = Fam
  end if
  decompress zx0 SceneMapTab[Scene] to vram.name + 32
  return
end sub

' ---------------------------------------------------------------------------
' A new game, the game screen, the end

sub NewGame:
  R = 1
  G = 0
  U = 0
  DoorOpen = 0
  Lft = 0
  Ended = 0
  Vb = 1
  Turns = 0
  for J8 = 0 to 8
    Il[J8] = ObjStart[J8]
  next
  for J8 = 0 to 35
    Cx[J8] = RoomExits[J8]
  next
  return
end sub

sub GameScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  Shown = 255
  FamShown = 255
  Ln = 9
  return
end sub

sub EndScreen:
  Ask = 0
  Blank
  NextLine
  if Ended = 2 then
    Rearm
    wait
    nmi off
    display off
    Scene = ScEscape
    ShowScene
    HideSprites
    Rearm
    wait
    nmi off
    screen on
    nmi off
    play sound SndBoom
    print at 11,Ln, "YOU WIN!"
  else
    play sound SndLose
    print at 11,Ln, "YOU LOSE!"
  end if
  ClearMenu
  print at 2,20, "............................"
  print at 8,22, "PRESS A BUTTON"
  Ask = 9
  WaitPress
  Ask = 0
  return
end sub

' ---------------------------------------------------------------------------
' Frames, input, random numbers

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' ReadPad: new presses since the last frame (Up1 ... Fire2)
sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Fire1 = 0
  Fire2 = 0
  V = 0
  W = joypad(1).up | joypad(2).up
  if W = 1 then V = 1
  W = joypad(1).down | joypad(2).down
  if W = 1 then V = 2
  W = joypad(1).left | joypad(2).left
  if W = 1 then V = 3
  W = joypad(1).right | joypad(2).right
  if W = 1 then V = 4
  if V <> WasDir then
    if V = 1 then Up1 = 1
    if V = 2 then Dn1 = 1
    if V = 3 then Lf1 = 1
    if V = 4 then Rt1 = 1
  end if
  WasDir = V
  W = joypad(1).button1 | joypad(2).button1
  if W = 1 then
    if WasF1 = 0 then Fire1 = 1
  end if
  WasF1 = W
  W = joypad(1).button2 | joypad(2).button2
  if W = 1 then
    if WasF2 = 0 then Fire2 = 1
  end if
  WasF2 = W
  return
end sub

' WaitPress: a new press of either button
sub WaitPress:
  WasF1 = 1
  WasF2 = 1
wp_loop:
  Frame1
  ReadPad
  V = Fire1 | Fire2
  if V = 0 then goto wp_loop
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 7
  for J8 = 0 to 6
    set sprite J8 to 192,0,0,0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub TextPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  Shown = 255
  FamShown = 255
  return
end sub

sub ShowPage:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Ask = 1
  WaitPress
  Ask = 0
  return
end sub

sub TitlePage:
  TextPage
  Scene = ScTitle
  ShowScene
  print at 8,10, "MARTIAN PRISONER"
  print at 4,13, "A TEXT ADVENTURE ON MARS"
  print at 5,16, "COMPUTE!'S GAZETTE 1983"
  print at 8,21, "PRESS A BUTTON"
  ' Amy's Tiny Sound "once" form: both voices stop at the tune's end
  play song MpSong once
  ShowPage
  ' the player's timing seeds the guard
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $5A3C
  return
end sub

sub CreditsPage:
  TextPage
  print at 8,1, "MARTIAN PRISONER"
  print at 2,3, "FROM COMPUTE!'S GAZETTE,"
  print at 2,4, "NOVEMBER 1983 (VIC-20 AND"
  print at 2,5, "COMMODORE 64)."
  print at 2,7, "FOR THE COLECOVISION BY"
  print at 2,8, "CLAUDE (AN AI MADE BY"
  print at 2,9, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,10, "2026, IN AMY, THE LANGUAGE"
  print at 2,11, "BY AMY BIENVENU."
  print at 2,13, "MUSIC: RED DUST (ORIGINAL)."
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  return
end sub

sub HelpPage:
  TextPage
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "YOU ARE A PRISONER ON A"
  print at 2,4, "MARTIAN SHIP. ESCAPE."
  print at 2,6, "STICK UP/DOWN: CHOOSE A"
  print at 2,7, "VERB. STICK RIGHT OR LEFT"
  print at 2,8, "BUTTON: CHOOSE WHAT, WITH"
  print at 2,9, "UP/DOWN. LEFT BUTTON: DO IT."
  print at 2,10, "STICK LEFT OR RIGHT BUTTON:"
  print at 2,11, "BACK TO THE VERBS."
  print at 2,13, "WAIT LETS TIME PASS."
  print at 2,15, "WHEN THE STORY FILLS THE"
  print at 2,16, "SCREEN, MORE WAITS FOR A"
  print at 2,17, "BUTTON."
  print at 8,21, "PRESS A BUTTON"
  ShowPage
  return
end sub

