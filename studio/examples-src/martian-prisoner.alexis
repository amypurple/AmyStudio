cartridge "MARTIAN PRISONER/ALAN POOLE, COMPUTE!/1983"

' MARTIAN PRISONER
' The text adventure from COMPUTE!'s Gazette, November 1983 (Program 1:
' VIC/64 Martian Prisoner), for the ColecoVision in Amy by Amy Bienvenu.
' Ported by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: the listing (orig/mars.bas, typed in from the magazine's pages
' 185-186). Labels such as l1100 are its line numbers; Il is its I()
' (where each object is: a room, or 255 carried), Cx its C%() (the exits,
' room * 4 + N/E/S/W).
'
' You are held in a cell aboard a Martian ship. Get out past the force
' field, find the key, the uniform and the Geiger counter, and use what
' the garden grows to blow up the ship from the fuel room (you escape in
' a life-craft).
'
' Screen: a picture of the room on rows 1-7, the story on rows 9-19 (a
' MORE line waits for a button when it fills), the command on rows 20-22.
' Controls (either joystick): up/down choose a verb; right (or the left
' button) moves to the nouns, up/down choose one; the left button does
' it; left or the right button goes back to the verbs. Keypad not used.
'
' Kept as the listing has them: every message, the map (one-way doors
' included), the guard who comes in one turn in four, the guards in the
' north hall who take you back without a uniform, reading the sign,
' wearing the uniform by taking it, the door that opens when you walk
' into it with the key, the plant that kills when eaten, the guard who
' shoots, and the ending in the small room.
' Liberties taken:
' - A verb and noun menu instead of typing (N/E/S/W are GO's nouns; the
'   nouns are what is in the room or carried; KILL and HIT also offer
'   the guard who came into the cell). WAIT is new: a turn that does
'   nothing (typing any known command did that in the listing).
' - The guard's coming is told once (the listing could tell it again on
'   later turns in the cell).
' - Pictures for the eight rooms (the cell with the field on and off, the
'   hall with the door shut and open), the guard as a sprite, the title
'   and the escape; new sounds; the title tune is new.
' - After the end, a button goes back to the title (the listing asked
'   PLAY AGAIN? Y/N).
' House rules kept: text in columns 2-29, rows 1-22; tiles from 128 (the
' pictures); an original title tune that plays once; a credits page; the
' screens are drawn with the NMI off.

const SndHush = 1
const SndTick = 2
const SndOk = 3
const SndStep = 4
const SndZap = 5
const SndClick = 6
const SndBoom = 7
const SndLose = 8
const SndTuneA = 9
const SndTuneB = 10
const ScCell = 0
const ScCell1 = 1
const ScCell2 = 2
const ScCellopen = 3
const ScHall = 4
const ScHallopen = 5
const ScEngine = 6
const ScEngine0 = 7
const ScSign = 8
const ScSupply = 9
const ScSupplyu = 10
const ScSupplyg = 11
const ScSupplyug = 12
const ScNorth = 13
const ScLarge = 14
const ScGarden = 15
const ScGarden0 = 16
const ScTitle = 17
const ScEscape = 18
const SGhead = 0
const SGsuit = 4
const SGfeet = 8
const SOkey = 12
const SOgeiger = 16
const SOunif = 20
const SOplant = 24
const NTiles8 = 0
const SprBytes = 224

' --- the listing's variables ----------------------------------------------
' R the room, G the guard came in, U the uniform worn, Il() and Cx() as
' above, Vb/Nn the command (menu numbers)
u8 R = 1
u8 G = 0
u8 U = 0
u8 Il[9]
u8 Cx[36]
u8 DoorOpen = 0
u8 Lft = 0
u8 Vb = 1
u8 Nn = 0
u8 Ended = 0

' the menu
u8 Nl[12]
u8 Nc = 0
u8 Nk = 0
u8 Side = 0
u8 Ln = 9
u8 Ask = 0
u8 Turns = 0

u8 Scene = 0
u8 Shown = 255
u8 Fam = 255
u8 FamShown = 255
u8 Ph = 0
u8 PhT = 0

u16 Rs = $5A3C
u16 Rw = 0
u16 Rt = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Fire1 = 0
u8 Fire2 = 0
u8 WasDir = 0
u8 WasF1 = 0
u8 WasF2 = 0
u8 Tick = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 K = 0
u8 Tx = 0
u8 Ty = 0
u16 V16 = 0

data RoomExits bytes 0,0,0,0, 0,0,0,0, 6,0,3,0, 2,4,0,0, 0,0,0,3, 0,0,0,2, 7,0,2,0, 0,8,6,0, 0,0,0,7
data ObjStart bytes 0, 1,6,4,5,5,8,2,3

  tile screen
  set sound table MpSoundTable areas 4
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
title:
  TitlePage
  CreditsPage
  HelpPage
  NewGame
  GameScreen

' 100: the room, then a command
l100:
  Describe
  if Ended <> 0 then goto the_end
  if R = 6 then
    if U = 0 then
      R = 1
      G = 0
      Lft = 0
      goto l100
    end if
  end if
  ' 110-130: a command from the menu
l110:
  GetCommand
  ClearText
  Ask = 0
  if Vb = 1 then Go3100
  if Vb = 2 then Get3200
  if Vb = 3 then Drop3300
  if Vb = 4 then Inv3400
  if Vb = 5 then Read3500
  if Vb = 6 then Open3600
  if Vb = 7 then Wear3700
  if Vb = 8 then Eat3800
  if Vb = 9 then Kill3900
  if Vb = 10 then Kill3900
  inc Turns
  if Ended <> 0 then goto the_end
  Blank
  goto l100

the_end:
  EndScreen
  goto title

' ---------------------------------------------------------------------------
' 1000-1030: the room's description and the objects in it
sub Describe:
  RoomPic
  if R = 1 then Room1100
  if R = 2 then
    NextLine
    print at 2,Ln, "YOU ARE IN A N/S HALL."
    inc Ln
  end if
  if R = 3 then
    NextLine
    print at 2,Ln, "YOU ARE IN THE ENGINE ROOM."
    inc Ln
  end if
  if R = 4 then Room1400
  if Ended <> 0 then return
  if R = 5 then
    NextLine
    print at 2,Ln, "YOU ARE IN THE SUPPLY ROOM."
    inc Ln
  end if
  if R = 6 then
    NextLine
    print at 2,Ln, "YOU ARE IN THE NORTH SIDE OF"
    inc Ln
    NextLine
    print at 2,Ln, "THE HALL."
    inc Ln
    if U = 1 then
      NextLine
      print at 2,Ln, "THE GUARDS DON'T NOTICE YOU."
      inc Ln
    else
      NextLine
      print at 2,Ln, "THE GUARDS TAKE YOU BACK TO"
      inc Ln
      NextLine
      print at 2,Ln, "THE CELL."
      inc Ln
      play sound SndZap
    end if
  end if
  if R = 7 then
    NextLine
    print at 2,Ln, "YOU ARE IN A LARGE ROOM."
    inc Ln
  end if
  if R = 8 then
    NextLine
    print at 2,Ln, "YOU ARE IN A STRANGE GARDEN"
    inc Ln
    NextLine
    print at 2,Ln, "WHERE FOOD IS GROWN FOR THE"
    inc Ln
    NextLine
    print at 2,Ln, "CREW."
    inc Ln
    if Il[4] = 255 then Clicking
  end if
  ' 1005
  if Il[4] = 255 then
    if Il[6] = 255 then Clicking
  end if
  ' 1010-1030
  K = 0
  for J8 = 1 to 8
    if Il[J8] = R then K = 1
  next
  if K = 0 then return
  Blank
  NextLine
  print at 2,Ln, "OBJECTS:"
  inc Ln
  for J8 = 1 to 8
    if Il[J8] = R then
      Tx = 6
      ObjLine
    end if
  next
  return
end sub

' 1100-1130: the cell (a guard comes in one turn in four)
sub Room1100:
  NextLine
  print at 2,Ln, "YOU ARE IN A PRISON CELL."
  inc Ln
  if G = 1 then return
  Rnd16
  if Rw >= 16384 then return
  G = 1
  Cx[5] = 2
  NextLine
  print at 2,Ln, "A GUARD HAS TURNED OFF THE"
  inc Ln
  NextLine
  print at 2,Ln, "FORCE FIELD AND ENTERED THE"
  inc Ln
  NextLine
  print at 2,Ln, "CELL."
  inc Ln
  play sound SndZap
  RoomPic
  return
end sub

' 1400-1430: the small room (with the plant: 4500, the end)
sub Room1400:
  NextLine
  print at 2,Ln, "YOU ARE IN A SMALL ROOM. A"
  inc Ln
  NextLine
  print at 2,Ln, "LARGE SIGN IS ON THE WALL."
  inc Ln
  if Il[4] = 255 then Clicking
  if Il[6] = 255 then Win4500
  return
end sub

sub Clicking:
  NextLine
  print at 2,Ln, "GEIGER COUNTER IS CLICKING."
  inc Ln
  play sound SndClick
  return
end sub

' 3000-3180: going N, E, S or W (Nn 11-14)
sub Go3100:
  Nn = Nn - 11
  ' 3110-3127: the force field
  if R = 1 then
    if Nn = 1 then
      if G = 0 then
        NextLine
        print at 2,Ln, "THE FORCE FIELD STOPS YOU."
        inc Ln
        play sound SndZap
        return
      end if
      NextLine
      print at 2,Ln, "AS YOU LEAVE THE CELL THE"
      inc Ln
      NextLine
      print at 2,Ln, "FORCE FIELD IS ACTIVATED,"
      inc Ln
      NextLine
      print at 2,Ln, "TRAPPING THE GUARD."
      inc Ln
      Lft = 1
    end if
  end if
  ' 3130-3145: the locked door
  if R = 2 then
    if Nn = 1 then
      if DoorOpen = 0 then
        if Il[8] <> 255 then
          NextLine
          print at 2,Ln, "THE LOCKED DOOR STOPS YOU."
          inc Ln
          return
        end if
        Unlock3145
      end if
    end if
  end if
  ' 3150-3180
  V = R * 4
  V = V + Nn
  if Cx[V] = 0 then
    NextLine
    print at 2,Ln, "YOU CAN'T"
    inc Ln
    return
  end if
  NextLine
  print at 2,Ln, "OK"
  inc Ln
  R = Cx[V]
  play sound SndStep
  return
end sub

sub Unlock3145:
  NextLine
  print at 2,Ln, "YOU UNLOCK THE DOOR WITH THE"
  inc Ln
  NextLine
  print at 2,Ln, "KEY."
  inc Ln
  Cx[9] = 5
  DoorOpen = 1
  play sound SndOk
  return
end sub

' 3200-3210
sub Get3200:
  if Nn = 1 then goto g_lift
  if Nn = 2 then goto g_lift
  if Nn = 3 then goto g_lift
  if Nn = 7 then goto g_lift
  if Il[Nn] <> R then
    NextLine
    print at 2,Ln, "IT'S NOT HERE."
    inc Ln
    return
  end if
  if Nn = 5 then
    Wear3720
    return
  end if
  NextLine
  print at 2,Ln, "OK"
  inc Ln
  Il[Nn] = 255
  RoomPic
  return
g_lift:
  NextLine
  print at 2,Ln, "YOU CAN'T LIFT IT!"
  inc Ln
  return
end sub

' 3300 (the menu offers only what is carried)
sub Drop3300:
  if Nn = 0 then
    NextLine
    print at 2,Ln, "YOU CAN'T"
    inc Ln
    return
  end if
  NextLine
  print at 2,Ln, "OK"
  inc Ln
  Il[Nn] = R
  RoomPic
  return
end sub

' 3400-3420
sub Inv3400:
  NextLine
  print at 2,Ln, "YOU ARE CARRYING:"
  inc Ln
  for J8 = 1 to 8
    if Il[J8] = 255 then
      Tx = 4
      ObjLine
    end if
  next
  return
end sub

' 3500-3520
sub Read3500:
  if Nn = 3 then
    if R = 4 then
      NextLine
      print at 2,Ln, "ATOMIC FUEL NEARBY. DON'T"
      inc Ln
      NextLine
      print at 2,Ln, "BRING ANY RADIO-ACTIVE"
      inc Ln
      NextLine
      print at 2,Ln, "MATERIALS INTO THIS ROOM."
      inc Ln
      return
    end if
  end if
  NextLine
  print at 2,Ln, "YOU CAN'T"
  inc Ln
  return
end sub

' 3600-3610
sub Open3600:
  if Nn = 7 then
    if R = 2 then
      if Il[8] = 255 then
        Nn = 12
        Unlock3145
        Go3100
        return
      end if
    end if
  end if
  NextLine
  print at 2,Ln, "YOU CAN'T"
  inc Ln
  return
end sub

' 3700-3720
sub Wear3700:
  if Il[5] = R then
    Wear3720
    return
  end if
  NextLine
  print at 2,Ln, "YOU CAN'T"
  inc Ln
  return
end sub

sub Wear3720:
  NextLine
  print at 2,Ln, "YOU ARE NOW WEARING A"
  inc Ln
  NextLine
  print at 2,Ln, "UNIFORM."
  inc Ln
  Il[5] = 255
  U = 1
  RoomPic
  play sound SndOk
  return
end sub

' 3800-3810
sub Eat3800:
  if Nn <> 6 then
    NextLine
    print at 2,Ln, "DON'T BE SILLY!"
    inc Ln
    return
  end if
  NextLine
  print at 2,Ln, "YOU QUICKLY BECOME SICK AND"
  inc Ln
  NextLine
  print at 2,Ln, "DIE."
  inc Ln
  Ended = 1
  return
end sub

' 3900-3910
sub Kill3900:
  if Nn = 2 then
    NextLine
    print at 2,Ln, "THE GUARD SHOOTS YOU."
    inc Ln
    play sound SndZap
    Ended = 1
    return
  end if
  NextLine
  print at 2,Ln, "YOU CAN'T"
  inc Ln
  return
end sub

' 4500-4520
sub Win4500:
  ' a MORE first: the ending gets the whole window
  Ln = 20
  NextLine
  NextLine
  print at 2,Ln, "THE RADIOACTIVE PLANT EMITS"
  inc Ln
  NextLine
  print at 2,Ln, "ENOUGH NEUTRONS TO START A"
  inc Ln
  NextLine
  print at 2,Ln, "CHAIN REACTION. THE SHIP"
  inc Ln
  NextLine
  print at 2,Ln, "EXPLODES."
  inc Ln
  NextLine
  print at 2,Ln, "YOU ESCAPE IN A LIFE-CRAFT."
  inc Ln
  Ended = 2
  return
end sub

' ObjLine: object J8's name at column Tx of the next line
sub ObjLine:
  NextLine
  if J8 = 1 then print at Tx,Ln, "FORCE FIELD"
  if J8 = 2 then print at Tx,Ln, "GUARDS"
  if J8 = 3 then print at Tx,Ln, "SIGN"
  if J8 = 4 then print at Tx,Ln, "GEIGER COUNTER"
  if J8 = 5 then print at Tx,Ln, "UNIFORM"
  if J8 = 6 then print at Tx,Ln, "PLANT"
  if J8 = 7 then
    if DoorOpen = 0 then print at Tx,Ln, "LOCKED DOOR"
    if DoorOpen = 1 then print at Tx,Ln, "OPEN DOOR"
  end if
  if J8 = 8 then print at Tx,Ln, "MAGNETIC KEY"
  inc Ln
  return
end sub

' ---------------------------------------------------------------------------
' The story window (rows 9-19)

sub ClearText:
  for J8 = 9 to 19
    fill 32 count 28 at 2,J8
  next
  Ln = 9
  return
end sub

' NextLine: room for one more line (MORE when the window is full)
sub NextLine:
  if Ln < 20 then return
  print at 11,20, "- MORE -"
  play sound SndTick
  K = Ask
  Ask = 2
  WaitPress
  Ask = K
  fill 32 count 28 at 2,20
  ClearText
  return
end sub

' Blank: an empty line (none at the top of the window)
sub Blank:
  if Ln = 9 then return
  if Ln > 19 then return
  inc Ln
  return
end sub

' ---------------------------------------------------------------------------
' The menu (rows 20-22): verbs on the left, nouns on the right

sub GetCommand:
  Side = 0
  Ask = 1
  BuildNouns
  DrawMenu
gc_loop:
  Frame1
  Field
  ReadPad
  if Side = 0 then
    if Up1 = 1 then
      dec Vb
      if Vb = 0 then Vb = 11
      BuildNouns
      play sound SndTick
      DrawMenu
    end if
    if Dn1 = 1 then
      inc Vb
      if Vb = 12 then Vb = 1
      BuildNouns
      play sound SndTick
      DrawMenu
    end if
    if Rt1 = 1 then
      if Nc > 0 then
        Side = 1
        play sound SndTick
        DrawMenu
      end if
    end if
    if Fire1 = 1 then
      if Nc = 0 then goto gc_done
      Side = 1
      play sound SndTick
      DrawMenu
    end if
    goto gc_loop
  end if
  if Up1 = 1 then
    if Nk = 0 then Nk = Nc
    dec Nk
    play sound SndTick
    DrawMenu
  end if
  if Dn1 = 1 then
    inc Nk
    if Nk = Nc then Nk = 0
    play sound SndTick
    DrawMenu
  end if
  V = Lf1 | Fire2
  if V = 1 then
    Side = 0
    play sound SndTick
    DrawMenu
  end if
  if Fire1 = 1 then goto gc_done
  goto gc_loop
gc_done:
  Nn = 0
  if Nc > 0 then Nn = Nl[Nk]
  play sound SndOk
  ' the command, as the listing would have read it
  ClearMenu
  return
end sub

' Field: the force field's bolts move (three pictures, every 6 frames)
sub Field:
  if R <> 1 then return
  if G = 1 then return
  inc PhT
  if PhT < 6 then return
  PhT = 0
  inc Ph
  if Ph = 3 then Ph = 0
  V16 = Ph * 56
  for Ty = 1 to 7
    for Tx = 22 to 29
      J8 = FieldTab[V16]
      put char J8 at Tx,Ty
      inc V16
    next
  next
  return
end sub

' BuildNouns: what the verb can be used with (Nl, Nc)
sub BuildNouns:
  Nc = 0
  Nk = 0
  if Vb = 1 then
    for J8 = 11 to 14
      Nl[Nc] = J8
      inc Nc
    next
    return
  end if
  if Vb = 4 then return
  if Vb = 11 then return
  for J8 = 1 to 8
    V = 0
    if Il[J8] = R then V = 1
    if Il[J8] = 255 then V = V + 2
    if Vb = 2 then
      if V <> 1 then V = 0
    end if
    if Vb = 3 then
      if V <> 2 then V = 0
    end if
    if V <> 0 then
      Nl[Nc] = J8
      inc Nc
    end if
  next
  ' the guard in the cell
  if Vb >= 9 then
    if R = 1 then
      if G = 1 then
        if Lft = 0 then
          Nl[Nc] = 2
          inc Nc
        end if
      end if
    end if
  end if
  return
end sub

sub ClearMenu:
  for J8 = 20 to 22
    fill 32 count 28 at 2,J8
  next
  return
end sub

sub DrawMenu:
  fill 32 count 28 at 2,21
  if Side = 0 then print at 2,21, ">"
  if Side = 1 then print at 13,21, ">"
  if Vb = 1 then print at 3,21, "GO"
  if Vb = 2 then print at 3,21, "GET"
  if Vb = 3 then print at 3,21, "DROP"
  if Vb = 4 then print at 3,21, "INVENTORY"
  if Vb = 5 then print at 3,21, "READ"
  if Vb = 6 then print at 3,21, "OPEN"
  if Vb = 7 then print at 3,21, "WEAR"
  if Vb = 8 then print at 3,21, "EAT"
  if Vb = 9 then print at 3,21, "KILL"
  if Vb = 10 then print at 3,21, "HIT"
  if Vb = 11 then print at 3,21, "WAIT"
  print at 2,20, "............................"
  fill 32 count 28 at 2,22
  if Nc > 0 then
    J8 = Nl[Nk]
    Tx = 14
    if J8 > 10 then
      if J8 = 11 then print at 14,21, "NORTH"
      if J8 = 12 then print at 14,21, "EAST"
      if J8 = 13 then print at 14,21, "SOUTH"
      if J8 = 14 then print at 14,21, "WEST"
    else
      Ln = 21
      ObjName
    end if
    if Side = 0 then print at 2,22, "STICK: VERB   RIGHT: WHAT"
    if Side = 1 then print at 2,22, "STICK: WHAT   FIRE: DO IT"
  else
    if Vb = 1 then return
    if Vb = 4 then print at 2,22, "FIRE: DO IT"
    if Vb = 11 then print at 2,22, "FIRE: DO IT"
    if Vb = 2 then print at 14,21, "(NOTHING)"
    if Vb = 3 then print at 14,21, "(NOTHING)"
    if Vb >= 5 then
      if Vb <= 10 then print at 14,21, "(NOTHING)"
    end if
  end if
  return
end sub

' ObjName: object J8's name at Tx, Ln (no new line)
sub ObjName:
  W = Ln
  if J8 = 1 then print at Tx,W, "FORCE FIELD"
  if J8 = 2 then print at Tx,W, "GUARDS"
  if J8 = 3 then print at Tx,W, "SIGN"
  if J8 = 4 then print at Tx,W, "GEIGER COUNTER"
  if J8 = 5 then print at Tx,W, "UNIFORM"
  if J8 = 6 then print at Tx,W, "PLANT"
  if J8 = 7 then
    if DoorOpen = 0 then print at Tx,W, "LOCKED DOOR"
    if DoorOpen = 1 then print at Tx,W, "OPEN DOOR"
  end if
  if J8 = 8 then print at Tx,W, "MAGNETIC KEY"
  return
end sub

' ---------------------------------------------------------------------------
' Pictures

' RoomPic: the room's picture (a new one is unpacked with the display off)
sub RoomPic:
  Scene = ScHall
  if R = 1 then
    Scene = ScCell
    if G = 1 then Scene = ScCellopen
  end if
  if R = 2 then
    if DoorOpen = 1 then Scene = ScHallopen
  end if
  ' the pictures show what was taken: the key off its hook, one uniform
  ' fewer on the rack, the Geiger counter off its box, the plant picked
  if R = 3 then
    Scene = ScEngine0
    if Il[8] = 3 then Scene = ScEngine
  end if
  if R = 4 then Scene = ScSign
  if R = 5 then
    Scene = ScSupplyug
    if Il[5] = 5 then Scene = ScSupplyg
    if Il[4] = 5 then
      Scene = ScSupplyu
      if Il[5] = 5 then Scene = ScSupply
    end if
  end if
  if R = 6 then Scene = ScNorth
  if R = 7 then Scene = ScLarge
  if R = 8 then
    Scene = ScGarden0
    if Il[6] = 8 then Scene = ScGarden
  end if
  Ph = 0
  if Scene <> Shown then
    Rearm
    wait
    nmi off
    display off
    ShowScene
    Rearm
    wait
    nmi off
    screen on
    nmi off
  end if
  ' the guard in the cell (and trapped there after you leave)
  V = 0
  if R = 1 then V = G
  if V = 1 then
    set sprite 0 to 24,136,SGhead,12
    set sprite 1 to 24,136,SGsuit,6
    set sprite 2 to 24,136,SGfeet,12
  else
    for J8 = 0 to 2
      set sprite J8 to 192,0,0,0
    next
  end if
  Things
  update sprites
  return
end sub

' Things: the key, the Geiger counter, the uniform and the plant dropped
' away from where they started, on this room's floor (sprites 3-6); in
' their own rooms the pictures show them
sub Things:
  for J8 = 4 to 8
    if J8 <> 7 then
      K = J8 - 1
      if J8 = 8 then K = 6
      V = 0
      if Il[J8] = R then V = 1
      if R = ObjStart[J8] then V = 0
      if V = 1 then
        V = 44
        W = J8 * 24
        W = W + 24
        if J8 = 8 then W = 200
        if J8 = 4 then set sprite K to V,W,SOgeiger,7
        if J8 = 5 then set sprite K to V,W,SOunif,6
        if J8 = 6 then set sprite K to V,W,SOplant,15
        if J8 = 8 then set sprite K to V,W,SOkey,11
      else
        set sprite K to 192,0,0,0
