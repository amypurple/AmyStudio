data TitleMap bytes
  $20,$20,$20,$20,$92,$92,$20,$20,$92,$20,$20,$20,$20,$92,$20,$20,$92,$20,$92,$20,$92,$92,$92,$20,$92,$92,$92,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$92,$20,$92,$20,$20,$20,$92,$20,$92,$20,$92,$92,$92,$20,$92,$20,$20,$20,$20,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$92,$20,$20,$92,$20,$20,$20,$92,$92,$92,$20,$92,$92,$92,$20,$92,$92,$20,$20,$20,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$20,$20,$92,$20,$20,$20,$92,$20,$92,$20,$92,$92,$92,$20,$92,$20,$20,$20,$20,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$20,$20,$92,$92,$92,$20,$92,$20,$92,$20,$92,$20,$92,$20,$92,$92,$92,$20,$20,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$92,$20,$20,$20,$92,$20,$20,$92,$92,$92,$20,$92,$92,$20,$20,$92,$92,$92,$20,$92,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$92,$20,$92,$20,$92,$20,$20,$92,$20,$20,$92,$20,$92,$20,$92,$20,$20,$20,$92,$20,$92,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$92,$20,$20,$92,$92,$92,$20,$20,$92,$20,$20,$92,$20,$92,$20,$92,$92,$20,$20,$92,$92,$20,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$92,$20,$92,$20,$92,$20,$20,$92,$20,$20,$92,$20,$92,$20,$92,$20,$20,$20,$92,$20,$92,$20,$20,$20,$20,$20
  $20,$20,$20,$20,$92,$20,$92,$20,$92,$20,$92,$20,$92,$92,$92,$20,$92,$92,$20,$20,$92,$92,$92,$20,$92,$20,$92,$20,$20,$20,$20,$20
end data

' the cavern of the current level (copied from ROM)
u8 LA[61]
u8 RA[61]
u8 PA[60]
u8 PB[60]
' its objects: row, column, type (1 base, 2 fuel pod), still there
u8 ORw[6]
u8 OCl[6]
u8 OTy[6]
u8 OAl[6]
u8 RowBuf[32]

' the ship: position in 1/64 pixels of the cavern (x 0..223, y 0..479)
u16 PX = 0
u16 PY = 0
i16 VX = 0
i16 VY = 0
u8 Dir = 0
u8 Mx = 0
u16 Wy = 0
u8 Sy = 0
u8 Thr = 0
u8 Shield = 0
u8 RotT = 0
u8 GravT = 0
u8 FuelT = 0

' shots: 0-2 the ship's, 3-5 the bases'; 1/16 pixels
u16 ShPX[6]
u16 ShPY[6]
i8 SVX[6]
i8 SVY[6]
u8 SL[6]

bcd digits 6 Sc = 0
u16 Fuel = 0
u8 TimeU = 0
u8 TimeT = 0
u8 NoBonus = 0
u8 Ships = 0
u8 Lev = 0
u8 Cam = 0
u8 Boom = 0
u8 Done = 0
u8 Over = 0
u8 Mode = 0
u8 EFireT = 0
u8 EFireN = 0
u8 BasesHit = 0
u8 Cool = 0
u8 Crash = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 NumU = 0
' input
u8 J0 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Menu = 0
u8 WasJ = 0
u8 Press = 0
u8 Tick = 0
' loop counters (never shared with the helpers)
u8 Sh = 0
u8 Ob = 0
u8 Rr = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u16 Uw = 0
i8 Sv = 0

  tile screen
  set sound table PrSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Done = 1 then LevelDone
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  Mode = 3
  mute all
  play sound SndOver
  print at 9,10, "            "
  print at 9,11, "  GAME OVER "
  print at 9,12, "            "
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayFrame:
  if Boom > 0 then
    dec Boom
    if Boom = 0 then LoseShip
  else
    Steer
    MoveShip
    Tractor
    Clock
  end if
  MoveShots
  BaseFire
  return
end sub

' turn, thrust, shield, fire
sub Steer:
  Thr = 0
  Shield = 0
  if RotT > 0 then dec RotT
  if RotT = 0 then
    if J0 & 4 then
      Dir = (Dir - 1) & 15
      RotT = 3
    end if
    if J0 & 8 then
      Dir = (Dir + 1) & 15
      RotT = 3
    end if
  end if
  if Fuel > 0 then
    if J0 & 1 then
      Thr = 1
      Sv = ThX[Dir]
      VX = VX + Sv
      Sv = ThY[Dir]
      VY = VY + Sv
    end if
    if J0 & 2 then Shield = 1
    V = Thr + Shield
    if V > 0 then
      FuelT = FuelT + V
      if FuelT >= 2 then
        FuelT = FuelT - 2
        dec Fuel
        if Fuel = 0 then
          Thr = 0
          Shield = 0
        end if
        if Tick & 7 = 0 then ShowFuel
      end if
      if Thr = 1 and Tick & 7 = 0 then play sound SndHiss
      if Shield = 1 and Tick & 15 = 0 then play sound SndHum
    end if
  end if
  if Cool > 0 then dec Cool
  if Press = 1 and Cool = 0 then Launch
  return
end sub

' gravity, speed limits, the move, the cavern and the core
sub MoveShip:
  inc GravT
  if GravT >= 3 then
    GravT = 0
    VY = VY + 1
    ' a little sideways drag
    if VX > 0 then dec VX
    if VX < 0 then inc VX
  end if
  if VX > 64 then VX = 64
  if VX < -64 then VX = -64
  if VY > 56 then VY = 56
  if VY < -64 then VY = -64
  PX = PX + VX
  PY = PY + VY
  if PY < 512 or PY > 40000 then
    PY = 512
    VY = 0
  end if
  ShipPix
  ' the camera follows a row at a time
  if Sy > 136 and Cam < CamMax then
    inc Cam
    DrawView
    ShipPix
  end if
  if Sy < 64 and Cam > 0 then
    dec Cam
    DrawView
    ShipPix
  end if
  Crash = 0
  Probe(Mx, Wy - 4)
  Probe(Mx, Wy + 4)
  Probe(Mx - 4, Wy)
  Probe(Mx + 4, Wy)
  HitBase
  if Crash = 1 then
    Blown
  else
    if Wy >= CoreY then Done = 1
  end if
  return
end sub

sub ShipPix:
  Uw = PX >> 6
  Mx = lowbyte Uw
  Wy = PY >> 6
  Uw = Cam
  Uw = Uw * 8
  Uw = Wy - Uw + 16
  Sy = lowbyte Uw
  return
end sub

sub Probe(u8 Ax, u16 Ay)
  if Solid(Ax, Ay) = 1 then Crash = 1
  return
end sub

' is the cavern solid at pixel (Ax, Ay) of the map?
function Solid(u8 Ax, u16 Ay) as u8
  u8 Ri = 0
  u8 Ci = 0
  u8 Xi = 0
  u8 Yi = 0
  u8 A = 0
  u8 B = 0
  u16 T = 0
  T = Ay >> 3
  Ri = lowbyte T
  if Ri >= MapH then return 1
  Ci = Ax >> 3
  Xi = Ax & 7
  Yi = lowbyte Ay
  Yi = Yi & 7
  A = LA[Ri]
  B = LA[Ri + 1]
  if B = A then
    if Ci < A then return 1
  end if
  if B > A then
    if Ci < A then return 1
    if Ci = A and Xi <= Yi then return 1
  end if
  if B < A then
    if Ci + 1 < A then return 1
    if Ci + 1 = A and Xi + Yi < 8 then return 1
  end if
  A = RA[Ri]
  B = RA[Ri + 1]
  if B = A then
    if Ci >= A then return 1
  end if
  if B > A then
    if Ci > A then return 1
    if Ci = A and Xi > Yi then return 1
  end if
  if B < A then
    if Ci >= A then return 1
    if Ci + 1 = A and Xi + Yi >= 7 then return 1
  end if
  A = PA[Ri]
  if A > 0 then
    B = PB[Ri]
    if Ci >= A and Ci <= B and Yi < 6 then return 1
  end if
  return 0

' touching a gun base is a crash
sub HitBase:
  u8 Bx = 0
  u16 By = 0
  for Ob = 0 to 5
    if OTy[Ob] = 1 and OAl[Ob] = 1 then
      Bx = OCl[Ob] * 8 + 4
      By = ORw[Ob]
      By = By * 8 + 4
      if absdiff(Bx, Mx) < 8 then
        if By + 8 > Wy and Wy + 8 > By then Crash = 1
      end if
    end if
  next
  return
end sub

' the shield pulls in fuel pods close by
sub Tractor:
  u8 Bx = 0
  u16 By = 0
  u16 Dy = 0
  if Shield = 1 then
    for Ob = 0 to 5
      if OTy[Ob] = 2 and OAl[Ob] = 1 then
        Bx = OCl[Ob] * 8 + 4
        By = ORw[Ob]
        By = By * 8 + 4
        if By > Wy then
          Dy = By - Wy
        else
          Dy = Wy - By
        end if
        if absdiff(Bx, Mx) < 13 and Dy < 13 then
          OAl[Ob] = 0
          Fuel = Fuel + 500
          if Fuel > 9999 then Fuel = 9999
          Sc += 100
          play sound SndFuel
          RedrawObj(Ob)
          ShowStatus
        end if
      end if
    next
  end if
  return
end sub

' a shot from the ship (three at most)
sub Launch:
  u8 S = 0
  u8 Found = 0
  for S = 0 to 2
    if Found = 0 and SL[S] = 0 then
      Found = 1
      Uw = Mx
      ShPX[S] = Uw * 16
      ShPY[S] = Wy * 16
      SVX[S] = ShX[Dir]
      SVY[S] = ShY[Dir]
      SL[S] = 40
      Cool = 8
      play sound SndZap
    end if
  next
  return
end sub

' move every shot: rock stops it, a ship's shot breaks a base, a base's
' shot hits the ship unless the shield is up
sub MoveShots:
  u8 Ax = 0
  u16 Ay = 0
  i16 Dv = 0
  for Sh = 0 to 5
    if SL[Sh] > 0 then
      dec SL[Sh]
      Dv = SVX[Sh]
      ShPX[Sh] = ShPX[Sh] + Dv
      Dv = SVY[Sh]
      ShPY[Sh] = ShPY[Sh] + Dv
      Uw = ShPX[Sh] >> 4
      Ax = lowbyte Uw
      Ay = ShPY[Sh] >> 4
      if Ax < 2 or Ax > 221 then
        SL[Sh] = 0
      else
        if Solid(Ax, Ay) = 1 then SL[Sh] = 0
      end if
      if SL[Sh] > 0 then
        if Sh < 3 then
          ShotBase(Ax, Ay)
        else
          if Boom = 0 then
            if absdiff(Ax, Mx) < 5 then
              Uw = absdiff(Ay, Wy)
              if Uw < 5 then
                SL[Sh] = 0
                if Shield = 0 then Blown
              end if
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub ShotBase(u8 Ax, u16 Ay)
  u8 Cx = 0
  u8 Ry = 0
  u16 T = 0
  Cx = Ax >> 3
  T = Ay >> 3
  Ry = lowbyte T
  for Ob = 0 to 5
    if OTy[Ob] = 1 and OAl[Ob] = 1 then
      if OCl[Ob] = Cx and ORw[Ob] = Ry then
        OAl[Ob] = 0
        SL[Sh] = 0
        inc BasesHit
        Sc += 300
        play sound SndBlast
        RedrawObj(Ob)
        ShowStatus
      end if
    end if
  next
  return
end sub

' now and then a base in view fires at the ship
sub BaseFire:
  u8 S = 0
  u8 Bx = 0
  u16 By = 0
  u8 Hd = 0
  u8 Tries = 0
  i16 Ex = 0
  i16 Ey = 0
  if EFireT > 0 then dec EFireT
  if EFireT = 0 and Boom = 0 then
    EFireT = FireGap()
    S = 6
    for K = 3 to 5
      if SL[K] = 0 then S = K
    next
    Tries = 0
    while S < 6 and Tries < 6
      EFireN = EFireN + 1
      if EFireN >= 6 then EFireN = 0
      inc Tries
      Ob = EFireN
      if OTy[Ob] = 1 and OAl[Ob] = 1 then
        Rr = ORw[Ob]
        if Rr >= Cam and Rr < Cam + ViewH then
          Bx = OCl[Ob] * 8 + 4
          By = Rr
          By = By * 8 + 1
          Ex = Mx
          Ex = Ex - Bx
          Ey = Wy
          Ey = Ey - By
          Hd = DirTo(Ex, Ey)
          Rand
          V = Rs & 3
          if V = 1 then Hd = (Hd + 1) & 15
          if V = 2 then Hd = (Hd - 1) & 15
          Uw = Bx
          ShPX[S] = Uw * 16
          ShPY[S] = By * 16
          SVX[S] = EsX[Hd]
          SVY[S] = EsY[Hd]
          SL[S] = 150
          play sound SndEZap
          S = 6
        end if
      end if
    end while
  end if
  return
end sub

' frames between base shots: fewer as the levels go on
function FireGap() as u8
  u8 G = 0
  select case Lev
    case 0
      G = 110
    case 1
      G = 100
    case 2
      G = 90
    case 3
      G = 80
    case 4, 5
      G = 70
    case 6, 7
      G = 60
    case else
      G = 45
  end select
  return G

' the heading (0 up, clockwise, 16 steps) that points along Ax, Ay
function DirTo(i16 Ax, i16 Ay) as u8
  u16 Bx = 0
  u16 By = 0
  u8 Kq = 0
  u8 A = 0
  Bx = abs(Ax)
  By = abs(Ay)
  if By * 5 < Bx then
    Kq = 0
  else
    if By * 3 < Bx * 2 then
      Kq = 1
    else
      if By * 2 < Bx * 3 then
        Kq = 2
      else
        if By < Bx * 5 then
          Kq = 3
        else
          Kq = 4
        end if
      end if
    end if
  end if
  ' maths angle in 22.5 degree steps, y up
  if Ax >= 0 then
    if Ay <= 0 then
      A = Kq
    else
      A = 16 - Kq
    end if
  else
    if Ay <= 0 then
      A = 8 - Kq
    else
      A = 8 + Kq
    end if
  end if
  return (4 - A) & 15

' TIME: one unit every 120 frames
sub Clock:
  inc TimeT
  if TimeT >= 120 then
    TimeT = 0
    if TimeU > 0 then
      dec TimeU
      if TimeU < 10 then play sound SndTick
      if TimeU = 0 then NoBonus = 1
      ShowTime
    end if
  end if
  return
end sub

sub Blown:
  Boom = 60
  mute all
  play sound SndBoom
  return
end sub

' after the burst: one ship fewer; again from the top of this level
sub LoseShip:
  dec Ships
  if Ships = 0 then
    Over = 1
  else
    Fuel = FuelFull
    StartShip
    DrawView
    ShowStatus
  end if
  return
end sub

sub StartShip:
  PX = 112 * 64
  PY = 20 * 64
  VX = 0
  VY = 0
  Dir = 0
  Cam = 0
  Boom = 0
  for Sh = 0 to 5
    SL[Sh] = 0
  next
  EFireT = 120
  ShipPix
  return
end sub

' the level is done: bonus, messages, the next shaft
sub LevelDone:
  u8 Lv = 0
  Done = 0
  mute all
  play sound SndDone
  Lv = Lev + 1
  print at 6,8, "                  "
  print at 6,9, " LEVEL    COMPLETE "
  NumU = Lv
  if Lv < 10 then
    print at 13,9, digits$(NumU, 1)
  else
    print at 13,9, digits$(NumU, 2)
  end if
  print at 6,10, "                  "
  if NoBonus = 1 then
    print at 6,11, "   NO TIME BONUS   "
  else
    print at 6,11, " TIME BONUS=20 X   "
    NumU = TimeU
    print at 22,11, digits$(NumU, 2)
    for K = 1 to 20
      Sc += TimeU
    next
  end if
  print at 6,12, "                  "
  ShowStatus
  Rearm
  wait 150 frames
  nmi off
  ' every eighth level: all 24 bases shot = 2 extra ships
  V = Lv & 7
  if V = 0 then
    if BasesHit >= 24 then
      Ships = Ships + 2
      print at 3,14, "                        "
      print at 3,15, " ALL ENEMY BASES        "
      print at 3,16, " DESTROYED! 2 EXTRA SHIPS"
      print at 3,17, "                        "
    else
      print at 6,14, "                  "
      print at 6,15, " MISSION COMPLETE "
      print at 6,16, "                  "
    end if
    BasesHit = 0
    ShowStatus
    Rearm
    wait 150 frames
    nmi off
  end if
  Lev = Lev + 1
  StartLevel
  return
end sub

sub Rand:
  u16 T = 0
  T = Rs << 7
  Rs = Rs ^ T
  T = Rs >> 9
  Rs = Rs ^ T
  T = Rs << 8
  Rs = Rs ^ T
  return
end sub

sub DrawSprites:
  u8 Pt = 0
  u8 Cl = 0
  u8 Ax = 0
  u8 Ay = 0
  u16 T = 0
  X = Mx + 8
  Y = Sy - 9
  if Boom > 0 then
    Pt = SEx2
    if Boom > 20 then Pt = SEx1
    if Boom > 40 then Pt = SEx0
    set sprite 0 to Y,X,Pt,11
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  else
    Pt = Dir * 4
    set sprite 0 to Y,X,Pt,15
    if Thr = 1 and Tick & 2 then
      Pt = SFl0 + Dir * 4
      set sprite 1 to Y,X,Pt,10
    else
      set sprite 1 to 192,0,0,0
    end if
    if Shield = 1 then
      Cl = 7
      if Tick & 8 then Cl = 5
      set sprite 2 to Y,X,SRing,Cl
    else
      set sprite 2 to 192,0,0,0
    end if
  end if
  for Sh = 0 to 5
    K = Sh + 3
    Ay = 192
    if SL[Sh] > 0 then
      T = ShPX[Sh] >> 4
      Ax = lowbyte T
      T = ShPY[Sh] >> 4
      Uw = Cam
      Uw = Uw * 8
      if T >= Uw then
        T = T - Uw
        if T < 168 then
          Ay = lowbyte T
          Ay = Ay + 7
          Ax = Ax + 8
        end if
      end if
    end if
    if Ay = 192 then
      set sprite K to 192,0,0,0
    else
      if Sh < 3 then
        set sprite K to Ay,Ax,SShot,11
      else
        set sprite K to Ay,Ax,SEshot,9
      end if
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' the cavern on screen: map rows Cam .. Cam + 20 on screen rows 2-22
sub DrawView:
  u16 Off = 0
  Off = Lev & 7
  Off = Off * MapH + Cam
  Off = Off * 32
  copy LvMap + Off count 672 to vram.name + 64
  for Rr = 0 to 5
    if OAl[Rr] = 0 then RedrawObj(Rr)
  next
  return
end sub

function ObjTile(u8 Q) as u8
  u8 T = 0
  T = TSp0
  if OTy[Q] = 1 then
    T = TRb
    if OAl[Q] = 1 then T = TGb
  end if
  if OTy[Q] = 2 and OAl[Q] = 1 then T = TFp
  return T

' an object changed: redraw its cell if it is on screen
sub RedrawObj(u8 Q)
  u8 Rw = 0
  u8 Cw = 0
  u8 T = 0
  Rw = ORw[Q]
  if Rw >= Cam and Rw < Cam + ViewH then
    Rw = Rw - Cam + 2
    Cw = OCl[Q] + 2
    T = ObjTile(Q)
    put char T at Cw,Rw
  end if
  return
end sub

' copy level Lev (eight caverns, then round again) from ROM
sub LoadLevel:
  u8 Ln = 0
  u16 Off = 0
  Ln = Lev & 7
  Off = Ln
  Off = Off * MapH1
  copy LvL + Off count MapH1 to LA
  copy LvR + Off count MapH1 to RA
  Off = Ln
  Off = Off * MapH
  copy LvPA + Off count MapH to PA
  copy LvPB + Off count MapH to PB
  Off = Ln
  Off = Off * 18
  for Ob = 0 to 5
    Uw = Off + Ob * 3
    copy LvObj + Uw count 3 to RowBuf
    ORw[Ob] = RowBuf[0]
    OCl[Ob] = RowBuf[1]
    OTy[Ob] = RowBuf[2]
    OAl[Ob] = 1
  next
  return
end sub

sub StartLevel:
  NewScreen
  LoadLevel
  TimeU = TimeFull
  TimeT = 0
  NoBonus = 0
  StartShip
  DrawView
  print at 2,1, "      "
  put char TIc at 9,1
  print at 12,1, "FUEL"
  print at 22,1, "TIME"
  ShowStatus
  DrawSprites
  ShowScreen
  print at 10,11, " LEVEL    "
  NumU = Lev + 1
  print at 17,11, digits$(NumU, 2)
  Rearm
  wait 90 frames
  nmi off
  DrawView
  Mode = 2
  return
end sub

sub NewGame:
  Sc = 0
  Ships = 5
  Lev = 0
  Fuel = FuelFull
  BasesHit = 0
  Over = 0
  Done = 0
  StartLevel
  return
end sub

sub ShowStatus:
  print Sc at 2,1
  NumU = Ships
  if Ships < 10 then
    print at 10,1, digits$(NumU, 1)
  else
    print at 10,1, "+"
  end if
  ShowFuel
  ShowTime
  return
end sub

sub ShowFuel:
  NumU = Fuel
  print at 17,1, digits$(NumU, 4)
  return
end sub

sub ShowTime:
  NumU = TimeU
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J0 = 0
  if joypad(1).up then J0 = J0 | 1
  if joypad(1).down then J0 = J0 | 2
  if joypad(1).left then J0 = J0 | 4
  if joypad(1).right then J0 = J0 | 8
  if joypad(1).fire then J0 = J0 | 16
  Btn = J0 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  Mode = 1
  NewScreen
  copy TitleMap count 352 to vram.name + 96
  print at 2,15, "COMPUTE!'S GAZETTE MAR 1990"
  print at 11,17, "START"
  print at 11,18, "HOW TO PLAY"
  print at 11,19, "CREDITS"
  Menu = 0
  TitleArrow
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 560
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  K = J0 & 3
  V = K & WasJ
  V = K ^ V
  WasJ = K
  if V = 1 then
    if Menu > 0 then dec Menu
    TitleArrow
  end if
  if V = 2 then
    if Menu < 2 then inc Menu
    TitleArrow
  end if
  if Press = 0 then goto tp_loop
  StopTune
  Uw = Tick
  Rs = Rs ^ Uw
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub TitleArrow:
  put char 32 at 9,17
  put char 32 at 9,18
  put char 32 at 9,19
  Y = Menu + 17
  put char 62 at 9,Y
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "FLY YOUR RAIDER DOWN THE"
    print at 2,4, "SHAFT OF AN ENEMY PLANET."
    print at 2,5, "SHOOT THE GUN BASES ON THE"
    print at 2,6, "GIRDERS AND REACH THE"
    print at 2,7, "GLOWING CORE AT THE BOTTOM"
    print at 2,8, "TO FINISH THE LEVEL."
    print at 2,10, "TOUCH ROCK, A GIRDER OR A"
    print at 2,11, "BASE, OR GET HIT BY A SHOT,"
    print at 2,12, "AND YOU LOSE A SHIP. NO"
    print at 2,13, "SHIPS LEFT: GAME OVER."
    fill TGd count 4 at 18,18
    put char TGb at 19,17
    fill TCo0 count 28 at 2,20
    fill TCo1 count 28 at 2,21
    set sprite 0 to 119,72,SSh2,15
    set sprite 3 to 125,104,SShot,11
  else
    print at 2,1, "CONTROLS               2/2"
    print at 2,3, "STICK LEFT/RIGHT: TURN."
    print at 2,4, "STICK UP: THRUST."
    print at 2,5, "STICK DOWN: SHIELD. IT ALSO"
    print at 2,6, "PULLS IN FUEL PODS."
    print at 2,7, "BUTTON: FIRE."
    print at 2,9, "THRUST AND SHIELD BURN FUEL."
    print at 2,10, "A BASE IS 300, A POD 100."
    print at 2,11, "TIME LEFT AT THE CORE IS A"
    print at 2,12, "BONUS: 20 POINTS A UNIT."
    print at 2,14, "TIP: GRAVITY PULLS YOU DOWN."
    print at 2,15, "USE SHORT PUSHES OF THRUST."
    fill TGd count 4 at 18,19
    put char TFp at 19,18
    set sprite 0 to 127,88,SSh0,15
    set sprite 1 to 127,88,SFl0,10
    set sprite 2 to 127,88,SRing,7
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

sub CreditsPage:
  Mode = 0
  NewScreen
  fill mode 2 text color with $F4
  print at 8,2, "PLANET RAIDER"
  print at 2,4, "FROM COMPUTE!'S GAZETTE,"
  print at 2,5, "MARCH 1990: A COMMODORE 64"
  print at 2,6, "MACHINE-LANGUAGE GAME (NO"
  print at 2,7, "AUTHOR NAMED ON THE DISK)."
  print at 2,9, "REBUILT FOR THE COLECOVISION"
  print at 2,10, "FROM ITS RULES: GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: RED DESCENT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

