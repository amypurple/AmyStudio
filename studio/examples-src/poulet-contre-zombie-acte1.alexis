menu:
  MenuScreen
  if MSel = 3 then
    HelpScreens
    goto menu
  end if
  if MSel = 4 then
    CreditsScreen
    goto menu
  end if

  ' ------------------------------------------------------------ new game
  Level = 1
  Lives = 3
  Score = 0
  Demo = 0

new_level:
  NewLevel

play_loop:
  Frame1
  Phase = 1
  Animate
  ReadPad
  PadInput
  Step1
  Draw
  if HudDirty = 1 then DrawHud
  if GMode = 1 then
    inc GTime
    if GTime >= 90 then goto cleared
  end if
  if GMode = 2 then
    inc GTime
    if GTime >= 50 then goto tripped
  end if
  goto play_loop

' ------------------------------------------------------------ level cleared
cleared:
  Phase = 0
  StopMusic
  play sound SndClear
  Panel
  put TsBravo count TsBravoN at 11,11
  put TsScore count TsScoreN at 9,13
  print Score at 15,13 width 5
  for Cnt = 1 to 160
    Frame1
    Animate
    ReadPad
    if Cnt > 50 then
      if Press = 1 then Cnt = 160
    end if
  next
  if Level = MAXLV then goto act_done
  inc Level
  goto new_level

act_done:
  SpritesOff
  Panel
  put TsActDone1 count TsActDone1N at 7,11
  put TsScore count TsScoreN at 9,13
  print Score at 15,13 width 5
  play sound SndClear
  for Cnt = 1 to 60
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  goto menu

' ------------------------------------------------------------ the stumble
tripped:
  Phase = 0
  dec Lives
  GagBig = 0
  if Lives = 0 then GagBig = 1
  CloseUp
  if Lives = 0 then goto game_over
  Dizzy = 0
  LevelScreen
  ZState = 0
  ZT = 0
  ZVx = 128
  ZVy = 128
  GMode = 0
  GTime = 0
  StartMusic
  goto play_loop

game_over:
  StopMusic
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  goto title

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ sprites
sub SpritesOff:
  clear sprites
  set sprite count 10
  sprites flicker off
  for J = 0 to 9
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' ------------------------------------------------------------ the AMYZ fast decoder
' DecN = stream number (table PkTab), DecTo = VRAM address
u16 DecTo = 0
u8 DecN = 0
sub Unpack:
  asm {
    ld a,(DecN)
    add a,a
    ld e,a
    ld d,0
    ld hl,PkTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,(DecTo)
    call amyzf_decompress
  }
  return
end sub

sub Unpack3(u8 Pn, u16 Off):
  ' the same stream into the three thirds (Off = byte offset in a third)
  DecN = Pn
  DecTo = Off
  Unpack
  DecN = Pn
  DecTo = Off + 2048
  Unpack
  DecN = Pn
  DecTo = Off + 4096
  Unpack
  return
end sub

' the font (codes 32-111) in the three thirds: white on black
sub LoadFont:
  copy FontPat count 640 to vram.pattern + 256
  copy FontPat count 640 to vram.pattern + 2304
  copy FontPat count 640 to vram.pattern + 4352
  fill $F1 count 640 to vram.color + 256
  fill $F1 count 640 to vram.color + 2304
  fill $F1 count 640 to vram.color + 4352
  fill 0 count 256 to vram.pattern
  fill 0 count 256 to vram.pattern + 2048
  fill 0 count 256 to vram.pattern + 4096
  fill $11 count 256 to vram.color
  fill $11 count 256 to vram.color + 2048
  fill $11 count 256 to vram.color + 4096
  return
end sub

sub LoadGameTiles:
  Unpack3(PkiGtpat, 896)
  Unpack3(PkiGtcol, 8192 + 896)
  return
end sub

' ------------------------------------------------------------ the backyard
sub LevelScreen:
  BlankScreen
  SpritesOff
  LoadFont
  LoadGameTiles
  DecN = PkiBgpat0
  DecTo = 1256
  Unpack
  DecN = PkiBgcol0
  DecTo = 8192 + 1256
  Unpack
  DecN = PkiBgpat1
  DecTo = 2048 + 1256
  Unpack
  DecN = PkiBgcol1
  DecTo = 8192 + 2048 + 1256
  Unpack
  DecN = PkiBgpat2
  DecTo = 4096 + 1256
  Unpack
  DecN = PkiBgcol2
  DecTo = 8192 + 4096 + 1256
  Unpack
  copy BgNames count 768 to vram.name
  backdrop black
  DrawObjects
  HudDirty = 1
  DrawHud
  ShowScreen
  return
end sub

' a 2x2 picture of game tiles (codes C, C+1 / C+2, C+3) at cell X,Y
sub Put2(u8 Pc, u8 Px, u8 Py):
  put char Pc at Px,Py
  inc Pc
  inc Px
  put char Pc at Px,Py
  inc Pc
  dec Px
  inc Py
  put char Pc at Px,Py
  inc Pc
  inc Px
  put char Pc at Px,Py
  return
end sub

' the lawn back under a 2x2 object
sub Erase2(u8 Ex, u8 Ey):
  W16 = Ey
  W16 = W16 << 5
  W16 += Ex
  put BgNames + W16 count 2 at Ex,Ey
  W16 += 32
  inc Ey
  put BgNames + W16 count 2 at Ex,Ey
  return
end sub

sub DrawObjects:
  for I = 0 to 3
    if I < NBk then
      if BkFull[I] > 0 then
        Put2(GtBskf00, BkX[I], BkY[I])
      else
        Put2(GtBsk00, BkX[I], BkY[I])
      end if
    end if
  next
  for I = 0 to 4
    if I < NGv then Put2(GtGrv00, GvX[I], GvY[I])
  next
  if SpX <> 0 then Put2(GtSpr000, SpX, SpY)
  return
end sub

' ------------------------------------------------------------ HUD
' row 1: LV n, zombie heads (lives); row 22: pumpkins (baskets left),
' score, the dizziness bar (green, yellow, red)
sub DrawHud:
  HudDirty = 0
  print at 2,1, "LV"
  print Level at 5,1 width 1
  HudIcons(GtZhead, BLANK, Lives, 3, 27, 1)
  HudIcons(GtPump, BLANK, Goals, 6, 2, 22)
  print Score at 11,22 width 5
  put char GtSwirl at 19,22
  for J = 1 to DIZMAX
    K = GtBar0
    if J <= Dizzy then
      K = GtBar1
      if J > 3 then K = GtBar2
      if J > 6 then K = GtBar3
    end if
    X = J + 20
    put char K at X,22
  next
  return
end sub

' a band for messages (rows 10-14, columns 2-29); the lawn comes back with LawnBand
sub Panel:
  for X = 2 to 29
    put char GtPanelt at X,10
    put char GtPanelb at X,14
  next
  for Y = 11 to 13
    fill BLANK count 28 at 2,Y
  next
  return
end sub

sub LawnBand:
  for Y = 10 to 14
    W16 = Y
    W16 = W16 << 5
    put BgNames + W16 count 32 at 0,Y
  next
  DrawObjects
  return
end sub

' ------------------------------------------------------------ a new level
sub NewLevel:
  K = Level - 1
  Goals = LvGoals[K]
  CSpd = LvSpd[K]
  TurnP = LvTurn[K]
  NBk = LvNBk[K]
  Q = K << 3
  for I = 0 to 3
    BkX[I] = LvBk[Q]
    inc Q
    BkY[I] = LvBk[Q]
    inc Q
    BkFull[I] = 0
  next
  NGv = LvNGv[K]
  Q = K * 10
  for I = 0 to 4
    GvX[I] = LvGv[Q]
    inc Q
    GvY[I] = LvGv[Q]
    inc Q
  next
  Q = K << 1
  SpX = LvSp[Q]
  inc Q
  SpY = LvSp[Q]
  Dizzy = 0
  GMode = 0
  GTime = 0
  ResetActors
  LevelScreen
  Panel
  put TsLevel count TsLevelN at 11,11
  print Level at 18,11 width 1
  put TsReady count TsReadyN at 12,13
  play sound SndStart
  for Cnt = 1 to 100
    Frame1
    Animate
    Draw
  next
  LawnBand
  StartMusic
  return
end sub

sub ResetActors:
  ZX = 640
  ZY = 2560
  ZVx = 128
  ZVy = 128
  ZFace = 0
  ZState = 0
  ZT = 0
  ZCharge = 0
  CX = 2560
  CY = 2240
  CH = 0
  CState = 0
  CT = 40
  CDir = 4
  InBk = 0
  return
end sub

' ------------------------------------------------------------ input
sub PadInput:
  IL = Lf1
  IR = Rt1
  IU = Up1
  IDn = Dn1
  IB = Btn
  return
end sub

' the demo player of the title: walks behind the chicken and kicks it
sub AiInput:
  IL = 0
  IR = 0
  IU = 0
  IDn = 0
  ' stand 14 pixels behind the chicken, on its line
  if Cpx > 128 then
    K = Cpx - 14
    ZFace = 0
  else
    K = Cpx + 14
  end if
  if Zpx + 2 < K then IR = 1
  if Zpx > K + 2 then IL = 1
  if Zpy + 2 < Cpy then IDn = 1
  if Zpy > Cpy + 2 then IU = 1
  if AiHold > 0 then
    dec AiHold
    IB = 1
    if AiHold = 0 then IB = 0
    return
  end if
  IB = 0
  if CState = 0 then
    Dx = Cpx - Zpx
    if Zpx > Cpx then Dx = Zpx - Cpx
    Dy = Cpy - Zpy
    if Zpy > Cpy then Dy = Zpy - Cpy
    if Dx < 22 then
      if Dy < 6 then
        Rnd
        AiHold = R2 & 31
        AiHold += 8
      end if
    end if
  end if
  return
end sub

' ------------------------------------------------------------ one frame of the game
sub Step1:
  if GMode = 2 then
    FallStep
    ChickenStep
    return
  end if
  ZombieStep
  ChickenStep
  return
end sub

' biased speed towards a target value by 1
sub ZMove:
  ' X: input accelerates (floaty), no input slows down by 1 every other frame
  if ZState = 4 then return
  if ZState = 2 then return
  if ZState = 3 then return
  if IL = 1 then
    ZFace = 1
    if ZVx > 128 - VMAX then dec ZVx
  else
    if IR = 1 then
      ZFace = 0
      if ZVx < 128 + VMAX then inc ZVx
    else
      K = Tick & 1
      if K = 0 then
        if ZVx > 128 then dec ZVx
        if ZVx < 128 then inc ZVx
      end if
    end if
  end if
  if IU = 1 then
    if ZVy > 128 - 10 then dec ZVy
  else
    if IDn = 1 then
      if ZVy < 128 + 10 then inc ZVy
    else
      K = Tick & 1
      if K = 0 then
        if ZVy > 128 then dec ZVy
        if ZVy < 128 then inc ZVy
      end if
    end if
  end if
  ' charging slows the zombie down
  if ZState = 1 then
    if ZVx > 132 then ZVx -= 2
    if ZVx < 124 then ZVx += 2
  end if
  return
end sub

sub ZombieStep:
  ZMove
  ' the lurching step: now and then a sudden push in the walking direction
  if ZState = 0 then
    if LurchT > 0 then dec LurchT
    if LurchT = 0 then
      Rnd
      LurchT = R2 & 63
      LurchT += 60
      if ZVx > 131 then ZVx += 9
      if ZVx < 125 then ZVx -= 9
      if ZVy > 131 then ZVy += 5
      if ZVy < 125 then ZVy -= 5
      play sound SndStep
    end if
  end if
  ' the sprinkler's wet grass: no grip
  if SpX <> 0 then
    if InSprinkler(Zpx, Zpy) = 1 then
      if IL = 0 then
        if IR = 0 then
          if ZVx > 128 then inc ZVx
          if ZVx < 128 then dec ZVx
          if ZVx > 128 + VMAX then ZVx = 128 + VMAX
          if ZVx < 128 - VMAX then ZVx = 128 - VMAX
        end if
      end if
    end if
  end if
  ' move (speeds are biased by 128)
  ZX += ZVx
  ZX -= 128
  ZY += ZVy
  ZY -= 128
  if ZX < FXMIN * 16 then
    ZX = FXMIN * 16
    ZVx = 128
  end if
  if ZX > FXMAX * 16 then
    ZX = FXMAX * 16
    ZVx = 128
  end if
  if ZY < FYMIN * 16 then
    ZY = FYMIN * 16
    ZVy = 128
  end if
  if ZY > FYMAX * 16 then
    ZY = FYMAX * 16
    ZVy = 128
  end if
  Zpx = ZX >> 4
  Zpy = ZY >> 4
  ' a gravestone in the way: bump, back off, a little dizzier
  if ZState = 0 then
    if OnGrave(Zpx, Zpy) = 1 then
      ZX -= ZVx
      ZX += 128
      ZX -= ZVx
      ZX += 128
      ZY -= ZVy
      ZY += 128
      ZY -= ZVy
      ZY += 128
      ZVx = 128
      ZVy = 128
      ZState = 6
      ZT = 30
      AddDizzy(1)
      play sound SndThud
    end if
  end if
  ' the kick
  if ZState = 0 then
    if IB = 1 then
      if IBWas = 0 then
        ZState = 1
        ZCharge = 0
        ' the chicken turns at the worst moment
        if CState = 0 then
          Rnd
          if R2 < TurnP then
            Rnd
            CDir = R2 & 7
            play sound SndCluck
          end if
        end if
      end if
    end if
  else
    if ZState = 1 then
      inc ZCharge
      if ZCharge > CHMAX then
        ' too long: he loses his balance
        ZState = 4
        ZT = 50
        AddDizzy(2)
        play sound SndWobble
      else
        if IB = 0 then Kick
      end if
    else
      if ZT > 0 then dec ZT
      if ZT = 0 then ZState = 0
      if ZState = 4 then
        ' staggering: drifts and sways
        K = Tick & 7
        if K = 0 then
          Rnd
          ZVx = R2 & 15
          ZVx += 120
          Rnd
          ZVy = R2 & 7
          ZVy += 124
        end if
      end if
    end if
  end if
  IBWas = IB
  ' the dizziness is full: he trips
  if Dizzy >= DIZMAX then
    if GMode = 0 then
      GMode = 2
      GTime = 0
      ZState = 5
      ZVx = 128
      ZVy = 128
      StopMusic
      play sound SndStumble
      play sound SndThud
    end if
  end if
  return
end sub

sub FallStep:
  ' tripping forward: he slides down towards the screen
  if ZY < FYMAX * 16 then ZY += 24
  Zpy = ZY >> 4
  return
end sub

sub AddDizzy(u8 Amt):
  Dizzy += Amt
  if Dizzy > DIZMAX then Dizzy = DIZMAX
  HudDirty = 1
  return
end sub

u8 FRes = 0
function InSprinkler(u8 Px, u8 Py) as u8
  FRes = 0
  K = SpX << 3
  K -= 8
  if Px < K then goto is_out
  K += 32
  if Px > K then goto is_out
  K = SpY << 3
  K -= 4
  if Py < K then goto is_out
  K += 28
  if Py > K then goto is_out
  FRes = 1
is_out:
  return FRes

' is the point (feet) on a gravestone?
function OnGrave(u8 Px, u8 Py) as u8
  FRes = 0
  for T2 = 0 to 4
    if T2 < NGv then
      K = GvX[T2] << 3
      if Px >= K then
        K += 15
        if Px <= K then
          K = GvY[T2] << 3
          K += 4
          if Py >= K then
            K += 12
            if Py <= K then FRes = 1
          end if
        end if
      end if
    end if
  next
  return FRes

' the button is released: a kick (or a kick into thin air)
sub Kick:
  ZState = 2
  ZT = 14
  inc Kicks
  play sound SndKick
  if CState <> 0 then
    if CState <> 2 then goto whiff
  end if
  Dy = Cpy - Zpy
  if Zpy > Cpy then Dy = Zpy - Cpy
  if Dy > 10 then goto whiff
  if ZFace = 0 then
    if Cpx < Zpx + 2 then goto whiff
    Dx = Cpx - Zpx
  else
    if Cpx + 2 > Zpx then goto whiff
    Dx = Zpx - Cpx
  end if
  if Dx > 26 then goto whiff
  ' the chicken flies: speed and height grow with the charge
  inc Hits
  KickX = Cpx
  KickY = Cpy
  K = ZCharge
  if K < 6 then K = 6
  Q = K + 16             ' horizontal speed, 1/16 pixel a frame
  CVz = K >> 1
  CVz += 20
  CUp = 1
  CH = 0
  CState = 1
  Bounced = 0
  if ZFace = 0 then
    CVx = 128 + Q
  else
    CVx = 128 - Q
  end if
  CVy = 128
  T2 = Q >> 1
  if IU = 1 then
    CVy = 128 - T2
  end if
  if IDn = 1 then CVy = 128 + T2
  ' clumsy: a little random slant, more when he is dizzy
  Rnd
  K = R2 & 7
  K += Dizzy
  CVy += K
  K = Dizzy >> 1
  K += 4
  CVy -= K
  if K > 0 then
    if CVy = 0 then CVy = 1
  end if
  if Q > 40 then play sound SndWhoosh
  return
whiff:
  ZState = 3
  ZT = 32
  AddDizzy(1)
  play sound SndWhiff
  return
end sub

' ------------------------------------------------------------ the chicken
sub ChickenStep:
  if CState = 0 then
    Waddle
  end if
  if CState = 1 then
    Fly
  end if
  if CState = 2 then
    if CT > 0 then dec CT
    if CT = 0 then
      CState = 0
      CT = 40
    end if
  end if
  if CState = 3 then
    if CT > 0 then dec CT
    if CT = 0 then PopOut
  end if
  Cpx = CX >> 4
  Cpy = CY >> 4
  W16 = CH >> 4
  Cph = W16
  return
end sub

sub Waddle:
  inc CAnim
  if CT > 0 then dec CT
  if CT = 0 then
    Rnd
    CT = R2 & 63
    CT += 30
    Rnd
    CDir = R2 & 7
    Rnd
    if R2 < 40 then play sound SndCluck
  end if
  K = CSpd
  if SpX <> 0 then
    if InSprinkler(Cpx, Cpy) = 1 then
      K = K << 1
      T2 = Tick & 15
      if T2 = 0 then
        Rnd
        CDir = R2 & 7
      end if
    end if
  end if
  Dx = DirX[CDir]
  Dy = DirY[CDir]
  if Dx = 2 then CX += K
  if Dx = 0 then CX -= K
  if Dy = 2 then CY += K
  if Dy = 0 then CY -= K
  ' a fence, a lawn edge or a gravestone: turn round
  Q = 0
  if CX < FXMIN * 16 then Q = 1
  if CX > FXMAX * 16 then Q = 1
  if CY < FYMIN * 16 then Q = 1
  if CY > FYMAX * 16 then Q = 1
  Cpx = CX >> 4
  Cpy = CY >> 4
  if OnGrave(Cpx, Cpy) = 1 then Q = 1
  if Q = 1 then
    if Dx = 2 then CX -= K
    if Dx = 0 then CX += K
    if Dy = 2 then CY -= K
    if Dy = 0 then CY += K
    CDir += 4
    CDir = CDir & 7
  end if
  return
end sub

sub Fly:
  CX += CVx
  CX -= 128
  CY += CVy
  CY -= 128
  ' the fence and the lawn edges throw it back
  if CX < FXMIN * 16 then
    CX = FXMIN * 16
    CVx = 256 - CVx
  end if
  if CX > FXMAX * 16 then
    CX = FXMAX * 16
    CVx = 256 - CVx
  end if
  if CY < FYMIN * 16 then
    CY = FYMIN * 16
    CVy = 256 - CVy
  end if
  if CY > FYMAX * 16 then
    CY = FYMAX * 16
    CVy = 256 - CVy
  end if
  ' height: up while CVz lasts, then down (gravity 2)
  if CUp = 1 then
    CH += CVz
    if CVz > 2 then
      CVz -= 2
    else
      CUp = 0
      CVz = 0
    end if
    return
  end if
  CVz += 2
  if CH > CVz then
    CH -= CVz
    return
  end if
  CH = 0
  Land
  return
end sub

' the chicken comes down: a basket, a gravestone or the grass
sub Land:
  Cpx = CX >> 4
  Cpy = CY >> 4
  if Bounced = 2 then
    ' the hop out of a basket: lands on its feet, no score, no blame
    CState = 2
    CT = 30
    return
  end if
  for I = 0 to 3
    if I < NBk then
      if BkFull[I] = 0 then
        K = BkX[I] << 3
        K += 8
        Dx = Cpx - K
        if K > Cpx then Dx = K - Cpx
        K = BkY[I] << 3
        K += 10
        Dy = Cpy - K
        if K > Cpy then Dy = K - Cpy
        if Dx < 10 then
          if Dy < 9 then
            InBasket
            return
          end if
        end if
      end if
    end if
  next
  if Bounced = 0 then
    if OnGrave(Cpx, Cpy) = 1 then
      ' bounces off the stone: a short hop back
      Bounced = 1
      CVx = 256 - CVx
      CVy = 256 - CVy
      CVz = 12
      CUp = 1
      play sound SndThud
      return
    end if
  end if
  CState = 2
  CT = 40
  AddDizzy(1)
  play sound SndMiss
  return
end sub

sub InBasket:
  InBk = I
  BkFull[I] = 1
  CState = 3
  CT = 60
  Put2(GtBskf00, BkX[I], BkY[I])
  ' the score: 10, 20 or 30 by the length of the kick
  Dx = Cpx - KickX
  if KickX > Cpx then Dx = KickX - Cpx
  Dy = Cpy - KickY
  if KickY > Cpy then Dy = KickY - Cpy
  K = Dx + Dy
  Q = 10
  if K >= 64 then Q = 20
  if K >= 112 then Q = 30
  Score += Q
  if Goals > 0 then dec Goals
  if Dizzy > 0 then dec Dizzy
  HudDirty = 1
  play sound SndBasket
  if Goals = 0 then
    if Demo = 0 then
      GMode = 1
      GTime = 0
    end if
  end if
  return
end sub

' out of the basket with a hop, the basket is empty again
sub PopOut:
  I = InBk
  BkFull[I] = 0
  Put2(GtBsk00, BkX[I], BkY[I])
  if Demo = 1 then
    BkFull[I] = 0
  end if
  Rnd
  K = R2 & 15
  CVx = 120 + K
  Rnd
  K = R2 & 15
  CVy = 128 + K
  CVz = 14
  CUp = 1
  CH = 0
  CState = 1
  Bounced = 2
  KickX = Cpx
  KickY = Cpy
  play sound SndCluck
  return
end sub

' ------------------------------------------------------------ drawing
' lanterns (1.25 Hz glow) and the sprinkler's spray
sub Animate:
  inc Glow
  if Glow >= 24 then
    Glow = 0
    inc GlowOn
    GlowOn = GlowOn & 1
    if GlowOn = 1 then
      copy LantDim count 32 to vram.color + 2048 + 1120
    else
      copy LantCol count 32 to vram.color + 2048 + 1120
    end if
  end if
  if SpX <> 0 then
    K = Tick & 7
    if K = 0 then
      inc SpF
      SpF = SpF & 3
      K = SpF << 2
      K += GtSpr000
      Put2(K, SpX, SpY)
    end if
  end if
  return
end sub

' the sprites: zombie (4), chicken (white, red, blue eyes), shadow, stars;
' at most 4 on any line: the eyes, shadow and stars give way
sub Draw:
  ' zombie frame
  K = Tick >> 3
  K = K & 7
  Q = Wob[K]
  X = Zpx + Q
  X -= 10
  Yz = Zpy - 32
  Y = Yz + 16
  Q = ZFace
  if ZState = 0 then
    K = ZVx - 128
    if ZVx < 128 then K = 128 - ZVx
    T2 = ZVy - 128
    if ZVy < 128 then T2 = 128 - ZVy
    K += T2
    T2 = 0
    if K > 2 then
      T2 = Tick >> 3
      T2 = T2 & 1
    end if
    ZTop(0)
    ZBot(T2)
  end if
  if ZState = 1 then
    ZTop(0)
    ZBot(3)
  end if
  if ZState = 2 then
    ZTop(0)
    ZBot(2)
  end if
  if ZState = 3 then
    ' the spin: right, front, left, back
    K = ZT >> 2
    K = K & 3
    if K = 0 then
      Q = 0
      ZTop(0)
      ZBot(0)
    end if
    if K = 1 then
      set sprite 3 to Yz,X,SpZtf0,15
      set sprite 4 to Yz,X,SpZtf1,3
      set sprite 5 to Y,X,SpZbf0,10
      set sprite 6 to Y,X,SpZbf1,15
    end if
    if K = 2 then
      Q = 1
      ZTop(0)
      ZBot(0)
    end if
    if K = 3 then
      set sprite 3 to Yz,X,SpZtb0,15
      set sprite 4 to Yz,X,SpZtb1,3
      set sprite 5 to Y,X,SpZbf0,10
      set sprite 6 to 209,X,SpZbf1,15
    end if
  end if
  if ZState = 4 then
    ZTop(1)
    K = Tick >> 2
    K = K & 1
    ZBot(K)
  end if
  if ZState = 5 then
    ' falling forward
    Y = Yz + 12
    set sprite 3 to Y,X,SpZfall0,15
    set sprite 4 to Y,X,SpZfall1,3
    Y += 16
    set sprite 5 to Y,X,SpZfallb0,10
    set sprite 6 to Y,X,SpZfallb1,15
  end if
  if ZState = 6 then
    ZTop(1)
    ZBot(0)
  end if
  ' the zombie's band of lines (top Yz, bottom ZBand)
  ZBand = Zpy
  if ZState = 5 then
    Yz += 12
    ZBand = Yz + 32
  end if
  ' chicken
  Yc = Cpy - 15
  Yc -= Cph
  X = Cpx - 8
  K = Tick >> 3
  K = K & 1
  if CState <> 0 then K = 0
  if CState = 3 then
    Yc = 209
  end if
  Q = CVx
  if CState = 0 then
    Q = DirX[CDir]
    Q += 127
  end if
  T2 = 0
  if Q < 128 then T2 = 1
  ' eyes, shadow, stars: only where the line count allows
  ShowEyes = 1
  if Yc + 16 > Yz then
    if Yc < ZBand then ShowEyes = 0
  end if
  ShowStars = 0
  if ZState = 4 then ShowStars = 1
  if ZState = 6 then ShowStars = 1
  if ShowStars = 1 then
    Y = Yz - 6
    if Yc + 16 > Y then
      if Yc < Yz + 10 then ShowStars = 0
    end if
  end if
  ShowShadow = 0
  if CState = 1 then
    if Cph > 3 then ShowShadow = 1
  end if
  if ShowShadow = 1 then
    Y = Cpy - 13
    if Y + 16 > Yz then
      if Y < ZBand then ShowShadow = 0
    end if
  end if
  if CState = 2 then
    if T2 = 0 then
      set sprite 1 to Yc,X,SpCwrf,15
      set sprite 2 to Yc,X,SpCrrf,8
    else
      set sprite 1 to Yc,X,SpCwlf,15
      set sprite 2 to Yc,X,SpCrlf,8
    end if
  else
    if T2 = 0 then
      if K = 0 then
        set sprite 1 to Yc,X,SpCwr0,15
        set sprite 2 to Yc,X,SpCrr0,8
      else
        set sprite 1 to Yc,X,SpCwr1,15
        set sprite 2 to Yc,X,SpCrr1,8
      end if
    else
      if K = 0 then
        set sprite 1 to Yc,X,SpCwl0,15
        set sprite 2 to Yc,X,SpCrl0,8
      else
        set sprite 1 to Yc,X,SpCwl1,15
        set sprite 2 to Yc,X,SpCrl1,8
      end if
    end if
  end if
  if ShowEyes = 1 then
    if T2 = 0 then
      set sprite 0 to Yc,X,SpCer,5
    else
      set sprite 0 to Yc,X,SpCel,5
    end if
  else
    set sprite 0 to 209,0,0,0
  end if
  if ShowShadow = 1 then
    Y = Cpy - 13
    set sprite 7 to Y,X,SpShadow,1
  else
    set sprite 7 to 209,0,0,0
  end if
  if ShowStars = 1 then
    Y = Yz - 6
    X = Zpx - 8
    set sprite 8 to Y,X,SpStars,11
  else
    set sprite 8 to 209,0,0,0
  end if
  update sprites
  return
end sub

' zombie top half (pose 0 normal, 1 arms up) at X,Yz; Q = facing
sub ZTop(u8 Pose):
  if Q = 0 then
    if Pose = 0 then
      set sprite 3 to Yz,X,SpZtr0,15
      set sprite 4 to Yz,X,SpZtr1,3
    else
      set sprite 3 to Yz,X,SpZur0,15
      set sprite 4 to Yz,X,SpZur1,3
    end if
  else
    if Pose = 0 then
      set sprite 3 to Yz,X,SpZtl0,15
      set sprite 4 to Yz,X,SpZtl1,3
    else
      set sprite 3 to Yz,X,SpZul0,15
      set sprite 4 to Yz,X,SpZul1,3
    end if
  end if
  return
end sub

' zombie bottom half (legs 0-1 walk, 2 kick, 3 charge) at X,Y; Q = facing
sub ZBot(u8 Legs):
  K = Legs << 3
  if Q = 0 then
    K += SpZbr00
  else
    K += SpZbl00
  end if
  set sprite 5 to Y,X,K,10
  K += 4
  set sprite 6 to Y,X,K,15
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

sub TitleMusic:
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ the close-up
' the zombie lurches at the screen: big-tile frames of his face, closer and
' closer, then "OUPS !" and the green goo; bigger when the game is over
sub CloseUp:
  Phase = 4
  BlankScreen
  SpritesOff
  LoadFont
  Unpack3(PkiGagpat, 896)
  Unpack3(PkiGagcol, 8192 + 896)
  fill 112 count 768 to vram.name
  backdrop dark blue
  ShowScreen
  for GagN = 0 to GagFrames - 1
    DecN = PkiGagname0 + GagN
    DecTo = 6144
    Unpack
    play sound SndStep
    K = 20 - GagN * 4
    for Cnt = 1 to K
      Frame1
    next
  next
  if GagBig = 1 then
    DecN = PkiGagname5
    DecTo = 6144
    Unpack
    play sound SndStep
    for Cnt = 1 to 12
      Frame1
    next
    DecN = PkiGagname6
  else
    DecN = PkiGagname4
  end if
  DecTo = 6144
  Unpack
  backdrop black
  play sound SndSplat
  if GagBig = 1 then
    put TsOver1 count TsOver1N at 9,19
    put TsScore count TsScoreN at 11,21
    print Score at 17,21 width 5
    play sound SndOver
  end if
  for Cnt = 1 to 120
    Frame1
    ReadPad
    if Cnt > 40 then
      if Press = 1 then Cnt = 120
    end if
  next
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  SpritesOff
  LoadFont
  LoadGameTiles
  fill BLANK count 768 to vram.name
  backdrop black
  return
end sub

sub WaitPress:
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  Put2(GtLant00, 15, 16)
  ShowScreen
  WaitPress
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  ShowScreen
  WaitPress
  TextScreen
  PageHelp2
  put char GtZhead at 2,3
  put char GtPump at 2,5
  put char GtBar2 at 2,7
  put char GtBar3 at 3,7
  ShowScreen
  WaitPress
  return
end sub

' the act menu: act I playable, acts II and III soon
sub MenuScreen:
  TextScreen
  PageMenu
  put char GtPump at 4,5
  put char GtLock at 4,9
  put char GtLock at 4,12
  for X = 2 to 29
    put char GtPanelt at X,3
    put char GtPanelb at X,19
  next
  ShowScreen
  TitleMusic
  MSel = 0
  Phase = 3
  Rearm
  wait no fire
  nmi off
mn_loop:
  Frame1
  Rnd
  ReadPad
  if StickHit = 1 then
    if Up1 = 1 then
      if MSel = 0 then
        MSel = 4
      else
        dec MSel
      end if
    end if
    if Dn1 = 1 then
      inc MSel
      if MSel > 4 then MSel = 0
    end if
  end if
  K = MenuRow[MSel]
  K = K << 3
  K -= 5
  set sprite 0 to K,26,SpCursor,11
  update sprites
  if Press = 0 then goto mn_loop
  if MSel = 1 then goto mn_soon
  if MSel = 2 then goto mn_soon
  Phase = 0
  StopMusic
  SpritesOff
  return
mn_soon:
  ' acts II and III are not ready yet
  play sound SndCluck
  K = MenuRow[MSel]
  inc K
  put TsSoon count TsSoonN at 8,K
  goto mn_loop
end sub
data MenuRow bytes 5,9,12,15,17

' ------------------------------------------------------------ title
' the logo over the night sky, the backyard below; the demo zombie
' chases the toy chicken and kicks it (the real game engine)
sub TitleScreen:
  BlankScreen
  SpritesOff
  LoadFont
  DecN = PkiTipat0
  DecTo = 896
  Unpack
  DecN = PkiTicol0
  DecTo = 8192 + 896
  Unpack
  DecN = PkiTipat1
  DecTo = 2048 + 896
  Unpack
  DecN = PkiTicol1
  DecTo = 8192 + 2048 + 896
  Unpack
  DecN = PkiTipat2
  DecTo = 4096 + 896
  Unpack
  DecN = PkiTicol2
  DecTo = 8192 + 4096 + 896
  Unpack
  DecN = PkiTiname
  DecTo = 6144
  Unpack
  put TsPress count TsPressN at 6,21
  put TsTitle2 count TsTitle2N at 8,23
  backdrop black
  ' demo field: no baskets, no stones; the chicken just gets kicked about
  Demo = 1
  NBk = 0
  NGv = 0
  SpX = 0
  CSpd = 8
  TurnP = 30
  Dizzy = 0
  ResetActors
  ZY = 2688
  CY = 2688
  ShowScreen
  TitleMusic
  Phase = 2
  Rearm
  wait no fire
  nmi off
ti_loop:
  Frame1
  ReadPad
  AiInput
  ZombieStep
  if Dizzy >= DIZMAX then Dizzy = 0
  GMode = 0
  if ZState = 5 then ZState = 0
  ChickenStep
  if CState = 2 then
    if CT > 30 then CT = 30
  end if
  Draw
  if Press = 0 then goto ti_loop
  Phase = 0
  Demo = 0
  StopMusic
  SpritesOff
  return
end sub

