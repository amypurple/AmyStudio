u8 U8A = 0, U8B = 0, U8R = 0
u16 U16A = 0, U16B = 0, U16R = 0
i8 I8A = 0, I8B = 0, I8R = 0
i16 I16A = 0, I16B = 0, I16R = 0
u8 Pass = 0

  text screen
  print at 6,0, "MODULO LAB"

  U8A = 7
  U8B = 3
  U8R = U8A % U8B
  print at 1,2, "u8 7%3"
  if U8R = 1 then
    Pass += 1
    print at 22,2, "PASS"
  else
    print at 22,2, "FAIL"
  end if

  U8A = 10
  U8B = 4
  U8R = U8A mod U8B
  print at 1,4, "u8 10 mod 4"
  if U8R = 2 then
    Pass += 1
    print at 22,4, "PASS"
  else
    print at 22,4, "FAIL"
  end if

  U16A = 40000
  U16B = 300
  U16R = U16A % U16B
  print at 1,6, "u16 40000%300"
  if U16R = 100 then
    Pass += 1
    print at 22,6, "PASS"
  else
    print at 22,6, "FAIL"
  end if

  U16R = 65535
  U16R %= 256
  print at 1,8, "u16 %= 256"
  if U16R = 255 then
    Pass += 1
    print at 22,8, "PASS"
  else
    print at 22,8, "FAIL"
  end if

  U16A = 1234
  U16B = 0
  U16R = U16A % U16B
  print at 1,10, "u16 div0"
  if U16R = 0 then
    Pass += 1
    print at 22,10, "PASS"
  else
    print at 22,10, "FAIL"
  end if

  I8A = -7
  I8B = 3
  I8R = I8A % I8B
  print at 1,12, "i8 -7%3"
  if I8R = -1 then
    Pass += 1
    print at 22,12, "PASS"
  else
    print at 22,12, "FAIL"
  end if

  I8A = -7
  I8R = I8A % 2
  print at 1,13, "i8 -7%2"
  if I8R = -1 then
    Pass += 1
    print at 22,13, "PASS"
  else
    print at 22,13, "FAIL"
  end if

  I16A = 7
  I16B = -3
  I16R = I16A % I16B
  print at 1,15, "i16 7%-3"
  if I16R = 1 then
    Pass += 1
    print at 22,15, "PASS"
  else
    print at 22,15, "FAIL"
  end if

  I16A = -7
  I16B = -3
  I16R = I16A % I16B
  print at 1,17, "i16 -7%-3"
  if I16R = -1 then
    Pass += 1
    print at 22,17, "PASS"
  else
    print at 22,17, "FAIL"
  end if

  print at 1,20, "TOTAL"
  print Pass at 7,20 digits 3
  if Pass = 9 then
    print at 12,20, "PASS"
  else
    print at 12,20, "FAIL"
  end if
  screen on