const NSpr = 6
const MenuC = 6
const MenuR = 13
const PromptR = 22
const Escape = 52429

' the sea: Room(place) the name id (0-9, 10 high seas), Pz(place) its
' pair of searches (0-7, 255 none), Vis(place) 1 once visited
u8 Room[25]
u8 Pz[25]
u8 Vis[25]
' the inventory: text ids of the finds kept (the listing's I$)
u8 Inv[8]
u8 Q = 0
u8 R = 0
u8 Tm = 0
u8 Rr = 0
u8 F1 = 0
u8 F2 = 0
' menus: Ph 1 a menu, 2 waiting for the button, 3 the end (for the bot)
u8 Ph = 0
u8 K = 0
u8 Sel = 1
u8 MenuN = 0
u8 Menu = 0
u16 Turns = 0
u8 Ask = 0
u8 TitleOn = 0
u8 ShipOn = 0
u8 MonOn = 0
u8 ChestOn = 0
u8 Bob = 0
u8 AnimT = 0
u8 ShipX = 192
u8 Won = 0
' random numbers (xorshift, mirrored by model.mjs)
u16 Rs = $5A3C
u16 Rw = 0
u16 Rt = 0
u16 Rv16 = 0
u16 Seed = 0
u16 TzLeft = 0
u8 TzOn = 0
' printing
u16 Po16 = 0
u16 Pt16 = 0
u8 Pl = 0
' input
u8 J1 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 B1 = 0
u8 WasB1 = 0
u8 P1 = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Lj = 0
u8 Lw = 0
' scratch
u8 C = 0
u8 J = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Pid = 0

  tile screen
  set sound table PcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

' 510: arrive at a place
l510:
  Tm = R
  Vis[R] = 1
  if Room[R] = 0 then goto treasure
  DrawRoom
  if Room[R] = IdSeas then goto seas
  if Room[R] = 1 then goto monster

  ' 610-680: a land place: its two searches, the map, sail, inventory
  ClearLow
  V = Pz[R]
  Pid = IdQa + V
  PrintAt(Pid, MenuC, MenuR)
  Pid = IdQb + V
  PrintAt(Pid, MenuC, 14)
  print at MenuC,15, "READ MAP"
  print at MenuC,16, "SAIL ON"
  print at MenuC,17, "LIST INVENTORY"
  AskMenu(5)
  select case K
  case 1, 2
    Search
    goto l510
  case 3
    DrawMap
    goto l510
  case 4
    goto l690
  case else
    ShowInventory
    goto l510
  end select

' 960-1020: the high seas
seas:
  ClearLow
  print at MenuC,MenuR, "READ MAP"
  print at MenuC,14, "SAIL ON"
  AskMenu(2)
  if K = 2 then goto l690
  DrawMap
  goto l510

' 690-840: sail
l690:
  ClearLow
  print at 2,12, "SAIL:"
  print at MenuC,MenuR, "NORTH"
  print at MenuC,14, "SOUTH"
  print at MenuC,15, "EAST"
  print at MenuC,16, "WEST"
  AskMenu(4)
  C = SailTo(R, K)
  if C < 25 then
    R = C
    goto l510
  end if
  ' 820-840: off the edge of the sea
  StormAhead
  R = Tm
  DrawRoom
  goto l690

' 1270-1450: the sea monster's lair
monster:
  play sound SndRoar
  ClearLow
  print at MenuC,MenuR, "SAIL AWAY"
  print at MenuC,14, "FIGHT"
  AskMenu(2)
  if K = 2 then goto fight
  ' 1330: one chance in five to get away
  Rnd16
  if Rw >= Escape then
    Tm = R
    goto l690
  end if
  ClearLow
  print at 2,14, "NOT FAST ENOUGH"
  print at 2,15, "THE MONSTER DAMAGED YOUR"
  print at 2,16, "SHIP."
  goto backtocove
fight:
  if F2 = 1 then
    play sound SndHit
    ClearLow
    print at 2,14, "YOU DEFEATED THE SEA MONSTER"
    print at 2,15, "YOU MAY CONTINUE ON YOUR"
    print at 2,16, "JOURNEY."
    PressOn
    Tm = R
    goto l690
  end if
  ClearLow
  print at 2,14, "YOU CANNOT FIGHT THE MONSTER"
  print at 2,15, "WITHOUT A CUTLASS."
backtocove:
  play sound SndHit
  print at 2,18, "YOU MUST GO BACK TO PIRATE"
  print at 2,19, "COVE AND START OVER AGAIN."
  PressOn
  R = Rr
  goto l510

' 1040-1250: treasure island
treasure:
  DrawRoom
  play sound SndBell
  ClearLow
  print at 2,13, "YOU HAVE LANDED AT"
  print at 2,14, "TREASURE ISLAND"
  print at 2,16, "AND FOUND THE TREASURE CHEST"
  print at 2,19, "PRESS THE BUTTON TO SEE IF"
  print at 2,20, "IT WILL OPEN."
  PressWait
  if F1 = 0 then
    play sound SndNone
    ClearLow
    print at 2,13, "YOU DON'T HAVE THE KEY."
    print at 2,15, "YOU MUST CONTINUE ON YOUR"
    print at 2,16, "JOURNEY, FIND THE KEY AND"
    print at 2,17, "RETURN TO TREASURE ISLAND."
    PressOn
    goto l690
  end if
  WinPage
  Won = 1
  Ph = 3
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ask = 0
  Ph = 0
  goto title

' ---------------------------------------------------------------------------
' rules

' the place one step from Fr in direction Dk (1 north, 2 south, 3 east,
' 4 west), or 255 off the edge (the listing's table D, lines 2530-2570)
function SailTo(u8 Fr, u8 Dk) as u8
  u8 Col = 0
  u8 Tg = 255
  Col = Fr % 5
  select case Dk
  case 1
    if Fr >= 5 then Tg = Fr - 5
  case 2
    if Fr < 20 then Tg = Fr + 5
  case 3
    if Col < 4 then Tg = Fr + 1
  case else
    if Col > 0 then Tg = Fr - 1
  end select
  return Tg

' 1 if the inventory holds text id Hi
function HasItem(u8 Hi) as u8
  u8 Hk = 0
  for Hk = 0 to 7
    if Inv[Hk] = Hi then return 1
  next
  return 0

' 860-940: search: what the chosen search finds
sub Search:
  V = Pz[R]
  if K = 1 then
    Pid = IdAa + V
  else
    Pid = IdAb + V
  end if
  ClearLow
  print at 2,14, "YOU FIND"
  PrintAt(Pid, 2, 15)
  if Pid = IdKey then F1 = 1
  if Pid = IdCutlass then F2 = 1
  if TxtItem[Pid] = 0 then
    play sound SndNone
  else
    play sound SndFind
    V = HasItem(Pid)
    if V = 0 then
      Inv[Q] = Pid
      inc Q
    end if
  end if
  PressOn
  return
end sub

' 1910-1930
sub ShowInventory:
  ClearLow
  print at 2,12, "INVENTORY:"
  for Lj = 0 to 7
    if Lj < Q then
      Y = Lj + 13
      PrintAt(Inv[Lj], 2, Y)
    end if
  next
  PressOn
  return
end sub

' 820-840: the storm
sub StormAhead:
  for Y = 4 to 6
    fill TCloud count 28 at 2,Y
  next
  play sound SndStorm
  ClearLow
  print at 2,18, "STORM AHEAD-GO ANOTHER WAY"
  PressOn
  return
end sub

sub NewGame:
  Q = 0
  F1 = 0
  F2 = 0
  Won = 0
  for Li = 0 to 7
    Inv[Li] = 255
  next
  for Li = 0 to 24
    Room[Li] = 255
    Vis[Li] = 0
  next
  ' 340-380: each of the 25 names to a free place picked at random
  for Li = 0 to 24
ng_pick:
    Rnd16
    V = highbyte Rw
    Rv16 = V
    Rv16 = Rv16 * 25
    C = highbyte Rv16
    if Room[C] <> 255 then goto ng_pick
    if Li < 10 then
      Room[C] = Li
    else
      Room[C] = IdSeas
    end if
  next
  ' 390-490: the searches in map order; where PIRATE COVE is
  J = 0
  for Li = 0 to 24
    Pz[Li] = 255
    C = Room[Li]
    if C >= 2 then
      if C < 10 then
        Pz[Li] = J
        inc J
      end if
    end if
    if C = 9 then Rr = Li
  next
  R = Rr
  return
end sub

' 1790-1850: a menu of Nm lines from row MenuR; K the choice
sub AskMenu(u8 Nm):
  MenuN = Nm
  Sel = 1
  DrawArrow
  ShowScreen
  Ph = 1
am_loop:
  Frame1
  ReadPad
  Anim
  if Edge = 1 then
    dec Sel
    if Sel = 0 then Sel = MenuN
    play sound SndMove
    DrawArrow
  end if
  if Edge = 2 then
    inc Sel
    if Sel > MenuN then Sel = 1
    play sound SndMove
    DrawArrow
  end if
  if P1 = 0 then goto am_loop
  Ph = 0
  play sound SndPick
  K = Sel
  inc Turns
  return
end sub

sub DrawArrow:
  for Lw = 1 to 5
    Y = Lw + 12
    put char 32 at 4,Y
  next
  Y = Sel + 12
  put char TArrow at 4,Y
  return
end sub

' 1860-1880
sub PressOn:
  print at 3,PromptR, "[PRESS BUTTON TO CONTINUE]"
  PressWait
  return
end sub

sub PressWait:
  ShowScreen
  Ph = 2
pw_loop:
  Frame1
  ReadPad
  Anim
  if P1 = 0 then goto pw_loop
  Ph = 0
  inc Turns
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub ClearLow:
  for Y = 12 to 22
    fill 32 count 28 at 2,Y
  next
  return
end sub

' text id Pid at column Pc, row Pr
sub PrintAt(u8 Tid, u8 Pc, u8 Pr):
  Po16 = Pr
  Po16 = Po16 * 32
  Po16 = Po16 + Pc
  Pt16 = TxtOff[Tid]
  Pl = TxtLen[Tid]
  copy TxtBytes + Pt16 count Pl to vram.name + Po16
  return
end sub

' 520-540: CURRENT LOCATION and the picture
sub DrawRoom:
  NewScreen
  print at 2,1, "CURRENT LOCATION:"
  C = Room[R]
  V = TxtLen[C]
  X = 28 - V
  X = X / 2
  X = X + 2
  PrintAt(C, X, 2)
  for Y = 4 to 6
    fill TSky count 28 at 2,Y
  next
  for Y = 7 to 10
    V = Y & 1
    if V = 1 then
      fill TSea count 28 at 2,Y
    else
      fill TSea2 count 28 at 2,Y
    end if
  next
  ShipOn = 1
  MonOn = 0
  ChestOn = 0
  ShipX = 192
  C = Room[R]
  select case C
  case 1
    MonOn = 1
  case 0, 2 to 9
    put char TLeafl at 14,4
    put char TLeafr at 15,4
    put char TTrunk at 14,5
    put char TIslandl at 11,6
    fill TIsland count 8 at 12,6
    put char TIslandr at 20,6
    put char TShorel at 10,7
    fill TShore count 10 at 11,7
    put char TShorer at 21,7
    if C = 0 then ChestOn = 1
  case else
    ShipX = 112
  end select
  Bob = 0
  DrawSprites
  return
end sub

sub DrawSprites:
  Y = 47 + Bob
  if ShipOn = 1 then
    set sprite 0 to Y,ShipX,SSail,15
    set sprite 1 to Y,ShipX,SHull,10
  end if
  if MonOn = 1 then
    V = 49 - Bob
    set sprite 2 to V,88,SEye,1
    set sprite 3 to V,88,SMonster,3
  end if
  if ChestOn = 1 then
    set sprite 4 to 40,128,SBand,11
    set sprite 5 to 40,128,SChest,6
  end if
  update sprites
  return
end sub

' the ship and the monster bob, a step every 24 frames
sub Anim:
  if ShipOn = 0 then return
  inc AnimT
  if AnimT < 24 then return
  AnimT = 0
  Bob = Bob ^ 1
  DrawSprites
  return
end sub

' 1520-1780: the navigation map
sub DrawMap:
  NewScreen
  ShipOn = 0
  print at 8,1, "NAVIGATION MAP"
  for Y = 3 to 17
    fill TMsea count 15 at 3,Y
  next
  for Li = 0 to 24
    C = Li % 5
    X = C * 3
    X = X + 4
    C = Li / 5
    Y = C * 3
    Y = Y + 4
    V = TMisle
    if Room[Li] = IdSeas then V = TMsea
    if Vis[Li] = 1 then
      if Room[Li] <> IdSeas then V = TMflag
    end if
    if Li = R then V = TMship
    put char V at X,Y
  next
  put char TMisle at 20,4
  print at 22,4, "LAND"
  put char TMsea at 20,6
  print at 22,6, "WATER"
  put char TMship at 20,8
  print at 22,8, "YOU"
  put char TMflag at 20,10
  print at 22,10, "VISITED"
  print at 23,13, "N"
  print at 21,15, "W"
  print at 23,15, "+"
  print at 25,15, "E"
  print at 23,17, "S"
  PressOn
  return
end sub

sub WinPage:
  NewScreen
  play sound SndWin
  print at 2,2, "YOUR KEY OPENS THE CHEST."
  print at 2,3, "YOU WIN"
  ChestOn = 1
  set sprite 4 to 40,120,SBand,11
  set sprite 5 to 40,120,SChest,6
  update sprites
  print at 2,9, "OTHER TREASURES:"
  for Lj = 0 to 7
    if Lj < Q then
      Y = Lj + 11
      PrintAt(Inv[Lj], 4, Y)
    end if
  next
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' stick: Edge bit 1 up, 2 down (pressed this frame); P1 a button pressed
sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  Jk = J1
  V = WasJ ^ 3
  Edge = Jk & V
  WasJ = Jk
  B1 = joypad(1).fire | joypad(2).fire
  P1 = 0
  if B1 > 0 then
    if WasB1 = 0 then P1 = 1
  end if
  WasB1 = B1
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: PIRATE COVE in gold blocks, a ship crossing, the tune once
sub TitlePage:
  u8 Tr = 0
  u8 Tx = 0
  u8 Ty = 0
  u8 Ti = 0
  u16 Tq = 0
  u16 Tv = 0
  Ask = 0
  TitleOn = 1
  NewScreen
  for Tr = 0 to 9
    Ti = Tr * TitleStride
    Tx = TitleMap[Ti]
    Ti = Ti + 1
    Ty = TitleMap[Ti]
    Tq = Ti + 2
    Tv = Ty * 32
    Tv = Tv + Tx
    copy TitleMap + Tq count 23 to vram.name + Tv
  next
  fill TTsea count 28 at 2,15
  fill TTsea count 28 at 2,16
  print at 3,17, "A MINI-ADVENTURE FOR KIDS"
  print at 5,18, "BY BARBARA H. SCHULAK"
  print at 4,19, "COMPUTE!'S GAZETTE 1986"
  print at 11,20, "START"
  print at 11,21, "HOW TO PLAY"
  print at 11,22, "CREDITS"
  Menu = 0
  TitleArrow
  ShipX = 16
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 432
  TzOn = 1
  WasB1 = 1
tp_loop:
  Frame1
  ReadPad
  V = Tick & 1
  if V = 0 then
    inc ShipX
    if ShipX > 208 then ShipX = 16
    set sprite 0 to 111,ShipX,SSail,15
    set sprite 1 to 111,ShipX,SHull,10
    update sprites
  end if
  Rnd16
  if Edge = 1 then
    if Menu > 0 then
      dec Menu
      play sound SndMove
      TitleArrow
    end if
  end if
  if Edge = 2 then
    if Menu < 2 then
      inc Menu
      play sound SndMove
      TitleArrow
    end if
  end if
  if P1 = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  if Rs = 0 then Rs = $5A3C
  ' the game's seed, for the tests
  Seed = Rs
  return
end sub

sub TitleArrow:
  put char 32 at 9,20
  put char 32 at 9,21
  put char 32 at 9,22
  Y = Menu + 20
  put char TArrow at 9,Y
  return
end sub

' a little sea picture for the HOW TO PLAY pages, rows Hr to Hr + 3
sub HtSea(u8 Hr):
  u8 Hy = 0
  Hy = Hr + 1
  fill TSky count 28 at 2,Hr
  fill TSky count 28 at 2,Hy
  inc Hy
  fill TSea count 28 at 2,Hy
  inc Hy
  fill TSea2 count 28 at 2,Hy
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "YOU SAIL A PIRATE SHIP ON A"
    print at 2,4, "SEA OF 25 PLACES: ISLANDS"
    print at 2,5, "AND HIGH SEAS. FIND THE"
    print at 2,6, "CHEST ON TREASURE ISLAND -"
    print at 2,7, "BUT YOU NEED A KEY TO OPEN"
    print at 2,8, "IT! OPEN THE CHEST TO WIN."
    print at 2,10, "SEARCH THE ISLANDS TO FIND"
    print at 2,11, "THE KEY, A CUTLASS AND"
    print at 2,12, "OTHER TREASURES."
    HtSea(16)
    put char TLeafl at 14,16
    put char TLeafr at 15,16
    put char TTrunk at 14,17
    put char TIslandl at 11,18
    fill TIsland count 8 at 12,18
    put char TIslandr at 20,18
    put char TShorel at 10,19
    fill TShore count 10 at 11,19
    put char TShorer at 21,19
    set sprite 0 to 143,192,SSail,15
    set sprite 1 to 143,192,SHull,10
    set sprite 4 to 136,128,SBand,11
    set sprite 5 to 136,128,SChest,6
  else
    print at 2,1, "CONTROLS               2/2"
    print at 2,3, "STICK UP OR DOWN: MOVE THE"
    print at 2,4, "ARROW. BUTTON: CHOOSE."
    print at 2,6, "READ MAP SHOWS LAND, WATER,"
    print at 2,7, "WHERE YOU ARE AND THE"
    print at 2,8, "ISLANDS YOU HAVE VISITED."
    print at 2,10, "WATCH OUT FOR THE SEA"
    print at 2,11, "MONSTER! FIGHT IT WITH A"
    print at 2,12, "CUTLASS OR TRY TO SAIL"
    print at 2,13, "AWAY. IF IT BEATS YOU, YOU"
    print at 2,14, "GO BACK TO PIRATE COVE."
    print at 2,16, "TIP: SEARCH EVERY ISLAND."
    HtSea(18)
    set sprite 0 to 151,64,SSail,15
    set sprite 1 to 151,64,SHull,10
    set sprite 2 to 153,152,SEye,1
    set sprite 3 to 153,152,SMonster,3
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 0
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if P1 = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,2, "PIRATE COVE"
  print at 2,5, "BASED ON PIRATE COVE BY"
  print at 2,6, "BARBARA H. SCHULAK,"
  print at 2,7, "COMPUTE!'S GAZETTE, AUGUST"
  print at 2,8, "1986 (COMMODORE 64)."
  print at 2,11, "COLECOVISION VERSION,"
  print at 2,12, "MUSIC AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: LANTERNS ON THE COVE"
  print at 2,18, "(ORIGINAL)"
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  Ask = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Ask = 0
  return
end sub

