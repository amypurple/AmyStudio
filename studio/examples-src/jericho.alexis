cartridge "JERICHO/Robert Bixby/1988"

' JERICHO
' A ColecoVision game based on "Jericho", COMPUTE!'s Gazette June 1988
' (Commodore 64 machine language, one 1653-byte program started with
' SYS 2099; the author is not named on the disk). Made for Amy Studio by
' Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a line-by-line port: the rules are the original's (read from its
' machine code, orig/jericho.dis, and watched in jsc64), the game is built
' for the ColecoVision: a smooth ball sprite, a brick wall whose colours
' drift, a golden rampart ring on a dark groove, sound effects, a tune.
'
' The game: a ball bounces inside a ring that runs round the edge of the
' screen. Two pieces of the ring are solid ramparts, on opposite sides;
' the rest is open. Turn the ring with the stick so a rampart is always
' where the ball arrives: if the ball gets through an opening it is lost.
' In the middle stands the wall of Jericho: every brick the ball touches
' falls and turns the ball back. Several times a second each fallen brick
' scores a point, so the wider the breach, the faster the score runs.
' Nine balls; the game goes on until the last one is lost.
'
' From the original (orig/): the wall in the middle (C64: 28 x 13 bricks
' with 4-5 free cells round it; here 18 x 11 with 4); the ring of the
' screen's edge with two solid halves-of-a-side opposite each other (C64:
' 40 of its 126 cells; here 2 x 15 of 94); the stick turning the whole
' ring one cell at a time, up one way and down the other; the ball
' moving diagonally, turned back by any brick it touches (the brick
' falls) and by the ramparts (with a rising chirp from a random pitch);
' a lost ball when it leaves through an opening; the ball's random
' stalls in its sideways moves, more often going left (C64: 4 in 256
' cell moves left, 1 in 256 right); every new ball starts in the middle
' row of the wall at a random column going down and right, the ring back
' in its starting place, the fallen bricks staying down; the score adds
' the number of fallen bricks on every pass of the main loop; nine balls.
'
' Liberties: the ball moves 1.5 pixels a frame (the C64 moved a whole
' cell, 8 pixels, every 40 to 65 ms) and the stall is per pixel (1 in 64
' left, 1 in 256 right); the ring turns one cell a frame while the
' stick is held (C64: up to 3 cells per ball step); the score adds the
' fallen bricks every 3 frames (20 times a second, the C64 about 20 to 50
' times, twice per pass), 8 digits; the stick's right also turns the ring
' like up and left like down; the C64 recoloured every brick at random
' about 8 times a second: here the wall's three brick rows drift through
' warm colours, a step every 24 frames (2.5 Hz); a crumble for each brick
' and a fall for a lost ball (the C64 had only the chirp); the ball is
' lost when its middle reaches the ring's line through an opening (C64:
' when it left the screen); no pause key or SHIFT slow-down (joystick
' only); a best score; GAME OVER then the title (the C64 asked PRESS
' RETURN TO PLAY AGAIN).
'
' Controls: controller 1 (or 2): stick up or right turns the ring
' clockwise, down or left anticlockwise; a button serves the next ball.
' On the title, up and down choose, a button chooses.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers.

const TBr0 = 128
const TBr1 = 129
const TBr2 = 130
const TShield = 131
const TTrack = 132
const TLbr = 133
const TLife = 134
const SBall = 0
const NTiles8 = 56
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndBounce0 = 3
const SndBounce1 = 4
const SndBounce2 = 5
const SndBounce3 = 6
const SndBrick = 7
const SndLost = 8
const SndStart = 9
const SndOver = 10
const NSpr = 4
' the ring: 94 cells clockwise from the top-left corner (2,2); two solid
' pieces of RLen cells, the second RHalf cells after the first
const RCells = 94
const RLen = 15
const RHalf = 47
' the wall: columns 7-24, rows 7-17
const WL = 7
const WR = 24
const WT = 7
const WB = 17
' ball speed in 1/256 pixels a frame, frames per ring step, frames per score
const Spd = 384
const RotGap = 1
const ScGap = 3
const ScoreCap = 99990000

data BrickPal bytes 11,10,9,8,6,8,9,10

data TilePat bytes
  $01,$01,$01,$00,$10,$10,$10,$00
  $01,$01,$01,$00,$10,$10,$10,$00
  $01,$01,$01,$00,$10,$10,$10,$00
  $81,$00,$24,$00,$00,$24,$00,$81
  $00,$00,$00,$18,$18,$00,$00,$00
  $80,$80,$80,$00,$10,$10,$10,$00
  $00,$C3,$81,$81,$81,$81,$C3,$00
end data
data TileCol bytes
  $1B,$1B,$1B,$01,$1B,$1B,$1B,$01
  $1B,$1B,$1B,$01,$1B,$1B,$1B,$01
  $1B,$1B,$1B,$01,$1B,$1B,$1B,$01
  $AB,$0B,$AB,$0B,$0B,$AB,$0B,$AB
  $01,$01,$01,$41,$41,$01,$01,$01
  $1B,$1B,$1A,$01,$1B,$19,$18,$01
  $01,$1F,$1F,$1F,$1F,$1F,$1F,$01
end data
data SpritePat bytes
  $78,$FC,$FC,$FC,$FC,$78,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

data LogoMap bytes
  $20,$20,$20,$85,$85,$85,$20,$85,$85,$85,$20,$85,$85,$20,$20,$85,$85,$85,$20,$85,$85,$85,$20,$85,$20,$85,$20,$85,$85,$85,$20,$20
  $20,$20,$20,$20,$20,$85,$20,$85,$20,$20,$20,$85,$20,$85,$20,$20,$85,$20,$20,$85,$20,$20,$20,$85,$20,$85,$20,$85,$20,$85,$20,$20
  $20,$20,$20,$20,$20,$85,$20,$85,$85,$20,$20,$85,$85,$20,$20,$20,$85,$20,$20,$85,$20,$20,$20,$85,$85,$85,$20,$85,$20,$85,$20,$20
  $20,$20,$20,$85,$20,$85,$20,$85,$20,$20,$20,$85,$20,$85,$20,$20,$85,$20,$20,$85,$20,$20,$20,$85,$20,$85,$20,$85,$20,$85,$20,$20
  $20,$20,$20,$85,$85,$85,$20,$85,$85,$85,$20,$85,$20,$85,$20,$85,$85,$85,$20,$85,$85,$85,$20,$85,$20,$85,$20,$85,$85,$85,$20,$20
end data

record Ball:
  u8 X
  u8 Y
  i8 DX
  i8 DY
end record

Ball B
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 8 Score = 0
bcd digits 8 Hi = 0
u8 Rot = 0
u8 RotT = 0
u8 Lives = 9
u8 Holes = 0
u8 Frac = 0
u8 Steps = 0
u8 ScT = 0
u8 ColT = 0
u8 ColPh = 0
u8 Lost = 0
u8 Over = 0
u8 Turn = 0
u8 Bounces = 0
u8 Bricks = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 HPg = 0
u16 HWt = 0
u8 Tick = 0
u8 Idle = 0
u8 Waiting = 0
' title ball
u8 TbX = 40
u8 TbY = 100
i8 TbDx = 1
i8 TbDy = 1
' cell of a ring position (CellOfP)
u8 PC = 0
u8 PR = 0
' loop counters (never shared with the helpers)
u8 Rp = 0
u8 Sl = 0
u8 Ws = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Buf[8]

  tile screen
  set sound table JeSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawBall
  if Lost = 1 then LoseBall
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Score > Hi then Hi = Score
  print at 8,10, "                "
  print at 8,11, "   GAME  OVER   "
  print at 8,12, "                "
  print at 8,13, " SCORE ", Score, " "
  print at 8,14, " BEST  ", Hi, " "
  print at 8,15, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the ring, the ball's pixel steps, the score, colours
sub PlayStep:
  K = J1 & 9
  V = J1 & 6
  Turn = 0
  if K > 0 then
    Turn = 1
  elseif V > 0 then
    Turn = 2
  end if
  if Turn = 0 then
    RotT = 0
  else
    if RotT = 0 then
      TurnRing(Turn)
      RotT = RotGap
    end if
    dec RotT
  end if
  W16 = Frac + Spd
  Steps = highbyte W16
  Frac = lowbyte W16
  while Steps > 0
    StepX
    if Lost = 0 then StepY
    if Lost = 1 then exit while
    dec Steps
  end while
  inc ScT
  if ScT >= ScGap then
    ScT = 0
    if Holes > 0 then
      if Score < ScoreCap then Score += Holes
      ShowScore
    end if
  end if
  inc ColT
  if ColT >= 24 then
    ColT = 0
    ColPh = (ColPh + 1) & 7
    BrickColours
  end if
  return
end sub

' the ring's position P (0-93) as a cell PC,PR
sub CellOfP(u8 P):
  select case P
    case 0 to 27
      PC = P + 2
      PR = 2
    case 28 to 46
      PC = 29
      PR = P - 25
    case 47 to 74
      PC = 76 - P
      PR = 22
    case else
      PC = 2
      PR = 96 - P
  end select
  return
end sub

' the ring position of cell C,R, or 255 off the ring
function PerimOf(u8 Cc, u8 Rr) as u8
  if Rr = 2 then
    if Cc >= 2 and Cc <= 29 then return Cc - 2
    return 255
  end if
  if Rr = 22 then
    if Cc >= 2 and Cc <= 29 then return 76 - Cc
    return 255
  end if
  if Rr < 2 or Rr > 22 then return 255
  if Cc = 29 then return Rr + 25
  if Cc = 2 then return 96 - Rr
  return 255

' 1 when ring position P is a rampart
function IsSolid(u8 P) as u8
  u8 Q
  Q = P + RCells - Rot
  if Q >= RCells then Q = Q - RCells
  if Q < RLen then return 1
  if Q >= RHalf and Q < RHalf + RLen then return 1
  return 0

' what is in cell C,R: 0 nothing, 1 brick, 2 rampart, 3 ring opening,
' 4 outside the ring
function CellKind(u8 Cc, u8 Rr) as u8
  u8 P
  u8 T
  if Cc < 2 or Cc > 29 then return 4
  if Rr < 2 or Rr > 22 then return 4
  P = PerimOf(Cc, Rr)
  if P <> 255 then
    if IsSolid(P) = 1 then return 2
    return 3
  end if
  if Cc < WL or Cc > WR then return 0
  if Rr < WT or Rr > WB then return 0
  T = get char at Cc,Rr
  if T >= TBr0 and T <= TBr2 then return 1
  return 0

sub DrawP(u8 P):
  CellOfP(P)
  if IsSolid(P) = 1 then
    put char TShield at PC,PR
  else
    put char TTrack at PC,PR
  end if
  return
end sub

sub DrawRing:
  for Rp = 0 to RCells - 1
    DrawP(Rp)
  next
  return
end sub

' one cell round: 1 clockwise, 2 anticlockwise; four cells change
sub TurnRing(u8 Way):
  u8 A
  if Way = 1 then
    A = Rot
    Rot = Rot + 1
    if Rot >= RCells then Rot = 0
  else
    if Rot = 0 then
      Rot = RCells - 1
    else
      Rot = Rot - 1
    end if
    A = Rot
  end if
  DrawP(A)
  DrawP(Wrap(A + RLen))
  DrawP(Wrap(A + RHalf))
  DrawP(Wrap(A + RHalf + RLen))
  return
end sub

function Wrap(u8 P) as u8
  if P >= RCells then return P - RCells
  return P

' a sideways pixel: the cell ahead of the ball's edge decides
sub StepX:
  u8 Kd
  u8 Ex
  Rand
  V = lowbyte Rs
  if B.DX > 0 then
    if V = 0 then return
    Ex = B.X + 3
  else
    V = V & 63
    if V = 0 then return
    Ex = B.X - 3
  end if
  Kd = CellKind(Ex >> 3, B.Y >> 3)
  select case Kd
    case 1
      Knock(Ex >> 3, B.Y >> 3)
      B.DX = -B.DX
    case 2
      B.DX = -B.DX
      Chirp
    case else
      B.X = B.X + B.DX
      CheckOut
  end select
  return
end sub

sub StepY:
  u8 Kd
  u8 Ey
  if B.DY > 0 then
    Ey = B.Y + 3
  else
    Ey = B.Y - 3
  end if
  Kd = CellKind(B.X >> 3, Ey >> 3)
  select case Kd
    case 1
      Knock(B.X >> 3, Ey >> 3)
      B.DY = -B.DY
    case 2
      B.DY = -B.DY
      Chirp
    case else
      B.Y = B.Y + B.DY
      CheckOut
  end select
  return
end sub

' the ball is lost when its middle reaches the ring's line
sub CheckOut:
  X = B.X >> 3
  Y = B.Y >> 3
  if X = 2 or X = 29 or Y = 2 or Y = 22 then Lost = 1
  return
end sub

sub Knock(u8 Cc, u8 Rr):
  put char 32 at Cc,Rr
  inc Holes
  inc Bricks
  play sound SndBrick
  return
end sub

sub Chirp:
  inc Bounces
  K = Bounces & 3
  play sound SndBounce0 + K
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new ball: the ring back home, the ball in the wall's middle row
sub NewBall:
  Rot = 0
  RotT = 0
  DrawRing
  Rand
  C = lowbyte Rs
  C = C % 14 + 9
  B.X = C * 8 + 4
  B.Y = 12 * 8 + 4
  B.DX = 1
  B.DY = 1
  Lost = 0
  Frac = 0
  if CellKind(C, 12) = 1 then Knock(C, 12)
  return
end sub

sub LoseBall:
  play sound SndLost
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    return
  end if
  print at 2,1, "PRESS BUTTON  "
  Waiting = 1
  Rearm
  wait 30 frames
  wait no fire
  pause until press
  nmi off
  Waiting = 0
  ShowStatus
  NewBall
  DrawBall
  return
end sub

' the three brick tiles' colours, a step along the palette
sub BrickColours:
  for Ws = 0 to 2
    K = (ColPh + Ws * 3) & 7
    V = BrickPal[K] + 16
    for J = 0 to 7
      Buf[J] = V
    next
    W16 = TBr0 + Ws
    W16 = W16 * 8
    copy Buf count 8 to vram.color + W16
  next
  return
end sub

sub DrawBall:
  if Lost = 1 or Over = 1 then
    set sprite 0 to 192,0,0,0
  else
    set sprite 0 to B.Y - 4,B.X - 3,SBall,15
  end if
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 29,1, digits$(NumU, 1)
  return
end sub

sub ShowStatus:
  print at 2,1, "SCORE                      "
  print at 21,1, "BALLS"
  put char TLife at 27,1
  ShowScore
  ShowLives
  return
end sub

sub NewGame:
  NewScreen
  for Sl = WT to WB
    K = Sl % 3
    fill TBr0 + K count WR - WL + 1 at WL,Sl
  next
  Score = 0
  Lives = 9
  Holes = 0
  Bricks = 0
  Bounces = 0
  ScT = 0
  ColT = 0
  ColPh = 0
  Over = 0
  BrickColours
  ShowStatus
  NewBall
  DrawBall
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: JERICHO in sandstone, a ball bouncing in the ring, START /
' HOW TO PLAY / CREDITS, the best score, the tune once
sub TitlePage:
  Menu = 0
  NewScreen
  print at 2,2, "COMPUTE!'S GAZETTE JUNE 1988"
  copy LogoMap count 160 to vram.name + 160
  print at 6,12, "BREAK DOWN THE WALL"
  print at 13,15, "START"
  print at 13,16, "HOW TO PLAY"
  print at 13,17, "CREDITS"
  if Hi > 0 then
    print at 9,19, "BEST ", Hi
  end if
  print at 5,21, "STICK TURNS THE RING"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' a ball bounces between rows 10 and 13 across the title (pixels 84-108)
sub TitleAnim:
  TbX = TbX + TbDx
  TbY = TbY + TbDy
  if TbX <= 20 or TbX >= 232 then TbDx = -TbDx
  if TbY <= 84 or TbY >= 112 then TbDy = -TbDy
  set sprite 0 to TbY - 4,TbX - 3,SBall,15
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,15
  put char 32 at 11,16
  put char 32 at 11,17
  J = Menu + 15
  put char 62 at 11,J
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, 30 s idle goes back.
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "A BALL BOUNCES INSIDE A"
    print at 2,4, "RING AROUND THE SCREEN."
    print at 2,5, "TWO PIECES OF THE RING ARE"
    print at 2,6, "SOLID RAMPARTS. THE REST"
    print at 2,7, "IS OPEN."
    print at 2,9, "TURN THE RING WITH THE"
    print at 2,10, "STICK (UP OR RIGHT ONE WAY,"
    print at 2,11, "DOWN OR LEFT THE OTHER) SO"
    print at 2,12, "A RAMPART IS WHERE THE BALL"
    print at 2,13, "ARRIVES. IF THE BALL GOES"
    print at 2,14, "OUT THROUGH AN OPENING, IT"
    print at 2,15, "IS LOST."
    print at 2,17, "THE BUTTON SERVES A BALL."
    fill TTrack count 16 at 8,20
    fill TShield count 6 at 13,20
    set sprite 0 to 140,136,SBall,15
  else
    print at 2,3, "IN THE MIDDLE STANDS THE"
    print at 2,4, "WALL OF JERICHO. EVERY"
    print at 2,5, "BRICK THE BALL TOUCHES"
    print at 2,6, "FALLS DOWN."
    fill TBr0 count 8 at 12,8
    put char TBr1 at 12,9
    put char TBr1 at 13,9
    put char TBr1 at 16,9
    put char TBr1 at 17,9
    put char TBr1 at 18,9
    put char TBr1 at 19,9
    fill TBr2 count 8 at 12,10
    print at 2,12, "ALL THE TIME, EACH FALLEN"
    print at 2,13, "BRICK SCORES POINTS: THE"
    print at 2,14, "BIGGER THE HOLE, THE FASTER"
    print at 2,15, "YOUR SCORE GOES UP."
    print at 2,17, "YOU HAVE NINE BALLS. THE"
    print at 2,18, "GAME ENDS WHEN THE LAST"
    print at 2,19, "ONE IS LOST."
    print at 2,21, "TIP: BREAK THE WALL EARLY!"
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then goto ht_done
  if Press = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
ht_done:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "JERICHO"
  print at 2,5, "BASED ON JERICHO,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "JUNE 1988 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: RAMPART HORNS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

