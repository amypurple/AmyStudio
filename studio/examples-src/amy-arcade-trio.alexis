' SHARED TITLE AND GAME SELECTOR
set sound table ArcadeTrioSoundTable areas 1
show picture ArcadeTrioTitle
play sound 1
screen on
pause until press and release
mute all
text screen
backdrop dark blue
print centered at 8, "1 EXPLOSION"
print centered at 11, "2 DIAMOND DASH"
print centered at 14, "3 FLY SWATTER"
screen on
ArcadeChoice = 0
arcade_menu_wait:
  if keypad(1) = 1 then ArcadeChoice = 1
  if keypad(1) = 2 then ArcadeChoice = 2
  if keypad(1) = 3 then ArcadeChoice = 3
if ArcadeChoice = 0 then goto arcade_menu_wait
wait no fire
if ArcadeChoice = 1 then goto EX_GameEntry
if ArcadeChoice = 2 then goto DD_GameEntry
goto FS_GameEntry

' ============================================================================
' EXPLOSION GAME MODULE
' RAM PART: ArcadeRam.Explosion
' ENTRY: EX_GameEntry
' OWNERSHIP RULE: initialize this RAM part before reading previous values.
' ============================================================================
sub EX_GameEntry:
  tile screen
  sprites 16x16
  sprites simple
  define chars EX_ExplosionCasePattern at 128 count 26
  define chars EX_ExplosionEmptyPattern at 154 count 4
  define chars EX_ExplosionCasePattern at 158 count 26
  fill $19 count 208 to vram.color + $0400
  fill $1E count 32 to vram.color + $04D0
  fill $14 count 208 to vram.color + $04F0
  define sprites EX_ExplosionSprites at 0
  set sound table ExplosionSoundTable areas 1
  EX_setup_game
  screen on
  goto EX_player_turn
end sub

sub EX_setup_game:
  cls
  print centered at 1, "EXPLOSION"
  print centered at 22, "D-PAD MOVE  FIRE SELECT"
  for EX_CellIndex = 0 to 63
    ArcadeRam.Explosion.Board[EX_CellIndex] = 0
  next
  ArcadeRam.Explosion.Board[0] = 1
  ArcadeRam.Explosion.Board[7] = 1
  ArcadeRam.Explosion.Board[56] = -1
  ArcadeRam.Explosion.Board[63] = -1
  ArcadeRam.Explosion.CursorX = 0
  ArcadeRam.Explosion.CursorY = 0
  clear sprites
  set sprite count 3
  EX_hide_explosion
  EX_draw_board
  EX_draw_cursor
  return

sub EX_player_turn:
  ArcadeRam.Explosion.CurrentOwner = EX_PlayerOwner
  print centered at 2, "TURN: PLAYER"
  EX_draw_cursor
player_loop:
  ArcadeRam.Explosion.OldX = ArcadeRam.Explosion.CursorX
  ArcadeRam.Explosion.OldY = ArcadeRam.Explosion.CursorY
  if joypad(1).left then
    if ArcadeRam.Explosion.CursorX > 0 then ArcadeRam.Explosion.CursorX -= 1
  end if
  if joypad(1).right then
    if ArcadeRam.Explosion.CursorX < 7 then ArcadeRam.Explosion.CursorX += 1
  end if
  if joypad(1).up then
    if ArcadeRam.Explosion.CursorY > 0 then ArcadeRam.Explosion.CursorY -= 1
  end if
  if joypad(1).down then
    if ArcadeRam.Explosion.CursorY < 7 then ArcadeRam.Explosion.CursorY += 1
  end if
  if ArcadeRam.Explosion.OldX != ArcadeRam.Explosion.CursorX goto player_cursor_changed
  if ArcadeRam.Explosion.OldY != ArcadeRam.Explosion.CursorY goto player_cursor_changed
  goto player_cursor_done
player_cursor_changed:
  EX_draw_cursor
player_cursor_done:
  if joypad(1).button1 then goto player_fire
  wait 4 frames
  goto player_loop
player_fire:
  wait no fire
  EX_Col = ArcadeRam.Explosion.CursorX
  EX_Row = ArcadeRam.Explosion.CursorY
  EX_make_index
  EX_CellValue = ArcadeRam.Explosion.Board[EX_CellIndex]
  if signed EX_CellValue < 0 goto player_loop
  EX_hide_cursor
  EX_add_one_at_index
  EX_resolve_explosions
  EX_draw_board
  if ArcadeRam.Explosion.WinFlag = 1 goto player_wins
  goto EX_cpu_turn
  return
player_wins:
  print centered at 20, "YOU WIN"
  play sound 1
  pause until press
  wait no fire
  EX_setup_game
  goto EX_player_turn
  return

sub EX_cpu_turn:
  ArcadeRam.Explosion.CurrentOwner = EX_CpuOwner
  print centered at 2, "TURN: CPU   "
  EX_hide_cursor
  ArcadeRam.Explosion.BestScore = EX_MaxEval
  ArcadeRam.Explosion.BestIndex = 0
  ArcadeRam.Explosion.CpuTry = 0
cpu_scan_loop:
  EX_CellIndex = ArcadeRam.Explosion.CpuTry
  EX_CellValue = ArcadeRam.Explosion.Board[EX_CellIndex]
  if signed EX_CellValue >= 0 goto cpu_scan_next
  EX_copy_board_to_sim
  EX_CellIndex = ArcadeRam.Explosion.CpuTry
  EX_sim_add_one_at_index
  EX_sim_resolve_explosions
  if ArcadeRam.Explosion.SimET != 0 then
    ArcadeRam.Explosion.BestIndex = ArcadeRam.Explosion.CpuTry
    goto cpu_choice_ready
  end if
  EX_evaluate_sim
  if ArcadeRam.Explosion.EvalScore < ArcadeRam.Explosion.BestScore then
    ArcadeRam.Explosion.BestScore = ArcadeRam.Explosion.EvalScore
    ArcadeRam.Explosion.BestIndex = ArcadeRam.Explosion.CpuTry
  end if
cpu_scan_next:
  ArcadeRam.Explosion.CpuTry += 1
  if ArcadeRam.Explosion.CpuTry < 64 goto cpu_scan_loop
cpu_choice_ready:
  wait 20 frames
  EX_CellIndex = ArcadeRam.Explosion.BestIndex
  EX_index_to_xy
  EX_Col = EX_TmpX
  EX_Row = EX_TmpY
  EX_CellIndex = ArcadeRam.Explosion.BestIndex
  EX_add_one_at_index
  EX_resolve_explosions
  EX_draw_board
  if ArcadeRam.Explosion.WinFlag = 1 goto cpu_wins
  goto EX_player_turn
  return
cpu_wins:
  print centered at 20, "CPU WIN"
  play sound 1
  pause until press
  wait no fire
  EX_setup_game
  goto EX_player_turn
  return

sub EX_draw_board:
  wait
  nmi off
  EX_CellIndex = 0
  for EX_Row = 0 to 7
    for EX_Col = 0 to 7
      EX_draw_cell
      EX_CellIndex += 1
    next
  next
  nmi on
  return

sub EX_draw_cell:
  if EX_Col > 7 then return
  if EX_Row > 7 then return
  EX_CellValue = ArcadeRam.Explosion.Board[EX_CellIndex]
  ArcadeRam.Explosion.FrameValue = EX_CellValue + 8
  if signed ArcadeRam.Explosion.FrameValue < 0 then ArcadeRam.Explosion.FrameValue = 0
  if signed ArcadeRam.Explosion.FrameValue > 16 then ArcadeRam.Explosion.FrameValue = 16
  ArcadeRam.Explosion.FrameIndex = ArcadeRam.Explosion.FrameValue
  ArcadeRam.Explosion.FrameOffset = ArcadeRam.Explosion.FrameIndex << 2
  EX_CellFrame[0] = EX_ExplosionSpaces[ArcadeRam.Explosion.FrameOffset]
  ArcadeRam.Explosion.Tmp = ArcadeRam.Explosion.FrameOffset + 1
  EX_CellFrame[1] = EX_ExplosionSpaces[ArcadeRam.Explosion.Tmp]
  ArcadeRam.Explosion.Tmp = ArcadeRam.Explosion.FrameOffset + 2
  EX_CellFrame[2] = EX_ExplosionSpaces[ArcadeRam.Explosion.Tmp]
  ArcadeRam.Explosion.Tmp = ArcadeRam.Explosion.FrameOffset + 3
  EX_CellFrame[3] = EX_ExplosionSpaces[ArcadeRam.Explosion.Tmp]
  EX_TmpX = EX_BoardTileX + EX_Col * 2
  EX_TmpY = EX_BoardTileY + EX_Row * 2
  put EX_CellFrame frame size 2,2 at EX_TmpX,EX_TmpY
  return

sub EX_draw_cell_safe:
  wait
  nmi off
  EX_draw_cell
  nmi on
  return

sub EX_draw_cursor:
  wait
  ArcadeRam.Explosion.SpriteX = 66 + ArcadeRam.Explosion.CursorX * 16
  ArcadeRam.Explosion.SpriteY = 40 + ArcadeRam.Explosion.CursorY * 16
  set sprite 0 to ArcadeRam.Explosion.SpriteY,ArcadeRam.Explosion.SpriteX,0,1
  set sprite 1 to ArcadeRam.Explosion.SpriteY,ArcadeRam.Explosion.SpriteX,4,15
  update sprites from 0 count 2
  return

sub EX_hide_cursor:
  wait
  set sprite 0 y to 204
  set sprite 1 y to 204
  update sprites from 0 count 2
  return

sub EX_show_explosion:
  wait
  ArcadeRam.Explosion.SpriteX = 64 + EX_Col * 16
  ArcadeRam.Explosion.SpriteY = 31 + EX_Row * 16
  set sprite 2 to ArcadeRam.Explosion.SpriteY,ArcadeRam.Explosion.SpriteX,8,11
  update sprites from 2 count 1
  return

sub EX_hide_explosion:
  wait
  set sprite 2 y to 204
  update sprites from 2 count 1
  return

sub EX_make_index:
  EX_CellIndex = EX_Row * 8
  EX_CellIndex += EX_Col
  return

sub EX_index_to_xy:
  EX_TmpY = EX_CellIndex / 8
  EX_TmpX = EX_CellIndex & 7
  return

sub EX_threshold_for_current:
  ArcadeRam.Explosion.Threshold = 4
  if EX_Col = 0 then ArcadeRam.Explosion.Threshold -= 1
  if EX_Col = 7 then ArcadeRam.Explosion.Threshold -= 1
  if EX_Row = 0 then ArcadeRam.Explosion.Threshold -= 1
  if EX_Row = 7 then ArcadeRam.Explosion.Threshold -= 1
  return

sub EX_load_abs_cell_count:
  EX_CellValue = ArcadeRam.Explosion.Board[EX_CellIndex]
  if signed EX_CellValue < 0 then
    ArcadeRam.Explosion.CellCount = 0 - EX_CellValue
  else
    ArcadeRam.Explosion.CellCount = EX_CellValue
  end if
  return

sub EX_store_count_for_owner:
  if ArcadeRam.Explosion.CellCount = 0 then
    ArcadeRam.Explosion.Board[EX_CellIndex] = 0
    return
  end if
  if ArcadeRam.Explosion.CurrentOwner = EX_PlayerOwner then
    ArcadeRam.Explosion.Board[EX_CellIndex] = ArcadeRam.Explosion.CellCount
  else
    ArcadeRam.Explosion.Board[EX_CellIndex] = 0 - ArcadeRam.Explosion.CellCount
  end if
  return

sub EX_add_one_at_index:
  EX_load_abs_cell_count
  ArcadeRam.Explosion.CellCount += 1
  EX_store_count_for_owner
  return

sub EX_copy_board_to_sim:
  for EX_CellIndex = 0 to 63
    ArcadeRam.Explosion.SimBoard[EX_CellIndex] = ArcadeRam.Explosion.Board[EX_CellIndex]
  next
  return

sub EX_sim_load_abs_cell_count:
  EX_CellValue = ArcadeRam.Explosion.SimBoard[EX_CellIndex]
  if signed EX_CellValue < 0 then
    ArcadeRam.Explosion.CellCount = 0 - EX_CellValue
  else
    ArcadeRam.Explosion.CellCount = EX_CellValue
  end if
  return

sub EX_sim_store_count_for_owner:
  if ArcadeRam.Explosion.CellCount = 0 then
    ArcadeRam.Explosion.SimBoard[EX_CellIndex] = 0
    return
  end if
  if ArcadeRam.Explosion.CurrentOwner = EX_PlayerOwner then
    ArcadeRam.Explosion.SimBoard[EX_CellIndex] = ArcadeRam.Explosion.CellCount
  else
    ArcadeRam.Explosion.SimBoard[EX_CellIndex] = 0 - ArcadeRam.Explosion.CellCount
  end if
  return

sub EX_sim_add_one_at_index:
  EX_sim_load_abs_cell_count
  ArcadeRam.Explosion.CellCount += 1
  EX_sim_store_count_for_owner
  return

sub EX_sim_add_neighbor:
  if EX_Col > 7 then return
  if EX_Row > 7 then return
  EX_make_index
  EX_sim_add_one_at_index
  return

sub EX_sim_resolve_explosions:
sim_resolve_again:
  ArcadeRam.Explosion.Exploded = 0
  ArcadeRam.Explosion.OpponentFound = 0
  for EX_Row = 0 to 7
    for EX_Col = 0 to 7
      EX_make_index
      EX_CellValue = ArcadeRam.Explosion.SimBoard[EX_CellIndex]
      if EX_CellValue = 0 goto sim_scan_next_cell
      if ArcadeRam.Explosion.CurrentOwner = EX_PlayerOwner then
        if signed EX_CellValue < 0 then ArcadeRam.Explosion.OpponentFound = 1
      else
        if signed EX_CellValue > 0 then ArcadeRam.Explosion.OpponentFound = 1
      end if
      EX_sim_load_abs_cell_count
      EX_threshold_for_current
      if ArcadeRam.Explosion.CellCount <= ArcadeRam.Explosion.Threshold goto sim_scan_next_cell
      ArcadeRam.Explosion.Exploded = 1
      ArcadeRam.Explosion.CellCount -= ArcadeRam.Explosion.Threshold
      EX_sim_store_count_for_owner
      EX_TmpX = EX_Col
      EX_TmpY = EX_Row
      if EX_TmpY > 0 then
        EX_Row = EX_TmpY - 1
        EX_Col = EX_TmpX
        EX_sim_add_neighbor
      end if
      if EX_TmpX > 0 then
        EX_Row = EX_TmpY
        EX_Col = EX_TmpX - 1
        EX_sim_add_neighbor
      end if
      if EX_TmpX < 7 then
        EX_Row = EX_TmpY
        EX_Col = EX_TmpX + 1
        EX_sim_add_neighbor
      end if
      if EX_TmpY < 7 then
        EX_Row = EX_TmpY + 1
        EX_Col = EX_TmpX
        EX_sim_add_neighbor
      end if
      EX_Row = EX_TmpY
      EX_Col = EX_TmpX
sim_scan_next_cell:
    next
  next
  if ArcadeRam.Explosion.Exploded != 0 then
    if ArcadeRam.Explosion.OpponentFound != 0 goto sim_resolve_again
  end if
  ArcadeRam.Explosion.SimET = 0
  if ArcadeRam.Explosion.OpponentFound = 0 then ArcadeRam.Explosion.SimET = 1
  return

sub EX_evaluate_sim:
  ArcadeRam.Explosion.EvalScore = 0
  for EX_Row = 0 to 7
    for EX_Col = 0 to 7
      EX_make_index
      EX_CellValue = ArcadeRam.Explosion.SimBoard[EX_CellIndex]
      ArcadeRam.Explosion.EvalScore += EX_CellValue
      EX_sim_load_abs_cell_count
      EX_threshold_for_current
      if signed EX_CellValue < 0 then
        if ArcadeRam.Explosion.CellCount >= ArcadeRam.Explosion.Threshold then
          ArcadeRam.Explosion.EvalScore -= 2
          EX_TmpX = EX_Col
          EX_TmpY = EX_Row
          if EX_TmpY > 0 then
            EX_Row = EX_TmpY - 1
            EX_Col = EX_TmpX
            EX_eval_player_at_threshold
            if ArcadeRam.Explosion.EvalHit != 0 then ArcadeRam.Explosion.EvalScore += 10
          end if
          if EX_TmpX > 0 then
            EX_Row = EX_TmpY
            EX_Col = EX_TmpX - 1
            EX_eval_player_at_threshold
            if ArcadeRam.Explosion.EvalHit != 0 then ArcadeRam.Explosion.EvalScore += 10
          end if
          if EX_TmpX < 7 then
            EX_Row = EX_TmpY
            EX_Col = EX_TmpX + 1
            EX_eval_player_at_threshold
            if ArcadeRam.Explosion.EvalHit != 0 then ArcadeRam.Explosion.EvalScore += 10
          end if
          if EX_TmpY < 7 then
            EX_Row = EX_TmpY + 1
            EX_Col = EX_TmpX
            EX_eval_player_at_threshold
            if ArcadeRam.Explosion.EvalHit != 0 then ArcadeRam.Explosion.EvalScore += 10
          end if
          EX_Row = EX_TmpY
          EX_Col = EX_TmpX
        end if
      end if
    next
  next
  return

sub EX_eval_player_at_threshold:
  ArcadeRam.Explosion.EvalHit = 0
  if EX_Col > 7 then return
  if EX_Row > 7 then return
  EX_make_index
  EX_threshold_for_current
  EX_CellValue = ArcadeRam.Explosion.SimBoard[EX_CellIndex]
  if signed EX_CellValue < 0 then return
  if EX_CellValue = ArcadeRam.Explosion.Threshold then ArcadeRam.Explosion.EvalHit = 1
  return

sub EX_add_neighbor:
  if EX_Col > 7 then return
  if EX_Row > 7 then return
  EX_make_index
  EX_add_one_at_index
  return

sub EX_resolve_explosions:
resolve_again:
  ArcadeRam.Explosion.Exploded = 0
  ArcadeRam.Explosion.OpponentFound = 0
  for EX_Row = 0 to 7
    for EX_Col = 0 to 7
      EX_make_index
      EX_CellValue = ArcadeRam.Explosion.Board[EX_CellIndex]
      if EX_CellValue = 0 goto scan_next_cell
      if ArcadeRam.Explosion.CurrentOwner = EX_PlayerOwner then
        if signed EX_CellValue < 0 then ArcadeRam.Explosion.OpponentFound = 1
      else
        if signed EX_CellValue > 0 then ArcadeRam.Explosion.OpponentFound = 1
      end if
      EX_load_abs_cell_count
      EX_threshold_for_current
      if ArcadeRam.Explosion.CellCount <= ArcadeRam.Explosion.Threshold goto scan_next_cell
      ArcadeRam.Explosion.Exploded = 1
      ArcadeRam.Explosion.CellCount -= ArcadeRam.Explosion.Threshold
      EX_store_count_for_owner
      EX_draw_cell_safe
      EX_show_explosion
      play sound 1
      wait 2 frames
      EX_TmpX = EX_Col
      EX_TmpY = EX_Row
      if EX_TmpY > 0 then
        EX_Row = EX_TmpY - 1
        EX_Col = EX_TmpX
        EX_add_neighbor
      end if
      if EX_TmpX > 0 then
        EX_Row = EX_TmpY
        EX_Col = EX_TmpX - 1
        EX_add_neighbor
      end if
      if EX_TmpX < 7 then
        EX_Row = EX_TmpY
        EX_Col = EX_TmpX + 1
        EX_add_neighbor
      end if
      if EX_TmpY < 7 then
        EX_Row = EX_TmpY + 1
        EX_Col = EX_TmpX
        EX_add_neighbor
      end if
      EX_Row = EX_TmpY
      EX_Col = EX_TmpX
scan_next_cell:
    next
  next
  if ArcadeRam.Explosion.Exploded != 0 then
    if ArcadeRam.Explosion.OpponentFound != 0 goto resolve_again
  end if
  EX_hide_explosion
  ArcadeRam.Explosion.WinFlag = 0
  if ArcadeRam.Explosion.OpponentFound = 0 then ArcadeRam.Explosion.WinFlag = 1
  return

asm {
ExplosionSoundTable:
    dw ExplosionPop,$702B

ExplosionPop:
    db $40,$A0,$11,$01
    db $40,$1C,$61,$01
    db $40,$2C,$B1,$01
    db $40,$2E,$D1,$01
    db $50
}

' ============================================================================
' DIAMOND GAME MODULE
' RAM PART: ArcadeRam.DiamondDash
' ENTRY: DD_GameEntry
' OWNERSHIP RULE: initialize this RAM part before reading previous values.
' ============================================================================
sub DD_GameEntry:
  tile screen
    sprites 8x8
    sprites simple
    set sound table DiamondSoundTable areas 6
    decompress mdkrle DD_DiamondPatternRle to vram.pattern
    duplicate mode 2 text patterns
    decompress mdkrle DD_DiamondColorRle to vram.color
    set sprite pattern table vram.pattern
    clear sprites
    set sprite count 1
    goto DD_return_to_title
end sub

sub DD_start_session:
  DD_Score = 0
  ArcadeRam.DiamondDash.SessionMountains = 5
  DD_start_mountain
  goto DD_game_loop

sub DD_start_mountain:
  ArcadeRam.DiamondDash.SessionMountains -= 1
  DD_Diamond_StartMountain
  DD_show_score
  wait no fire on joypad 1
  return

sub DD_show_score:
  print at 6,23, DD_Score
  print at 14,23, DD_Timer
  print at 23,23, DD_Dynamite
  return

sub DD_game_loop:
  wait
  DD_Diamond_MovePlayer
  if ArcadeRam.DiamondDash.MoveContinue = 0 goto DD_round_end
  if DD_Timer > 0 goto DD_tick_timer
  DD_show_score
  DD_Diamond_UpdateDynamite
  goto DD_game_loop

sub DD_tick_timer:
  DD_Timer -= 1
  DD_show_score
  DD_Diamond_UpdateDynamite
  goto DD_game_loop

sub DD_round_end:
  DD_Diamond_EndRound
  if ArcadeRam.DiamondDash.GameOverFlag = 1 goto DD_game_over_screen
  if ArcadeRam.DiamondDash.SessionMountains = 0 goto DD_replay_last_mountain
  DD_start_mountain
  goto DD_game_loop

sub DD_game_over_screen:
  mute all
  put DD_GameOverText at 13,11
  play sound 3
  pause until press
  wait no fire
  goto DD_return_to_title

sub DD_replay_last_mountain:
  ArcadeRam.DiamondDash.SessionMountains += 1
  DD_start_mountain
  goto DD_game_loop

sub DD_return_to_title:
  mute all
  ArcadeRam.DiamondDash.GameOverFlag = 0
  ArcadeRam.DiamondDash.DynamiteCountdown = 0
  ArcadeRam.DiamondDash.FireWasDown = 0
  DD_Diamond_BuildMountain
  put DD_TitleText at 12,11
  screen on
  pause until press
  wait no fire
  goto DD_start_session

sub DD_Diamond_StartMountain:
  ArcadeRam.DiamondDash.GameOverFlag = 0
  ArcadeRam.DiamondDash.DynamiteCountdown = 0
  ArcadeRam.DiamondDash.FireWasDown = 0
  ArcadeRam.DiamondDash.MoveContinue = 1
  ArcadeRam.DiamondDash.DiamondsNeeded = DD_minimum_diamants[ArcadeRam.DiamondDash.SessionMountains]
  DD_Diamond_BuildMountain
  DD_Dynamite = DD_StartDynamite
  DD_Timer = DD_StartTimer
  set sprite 0 tile ArcadeRam.DiamondDash.PlayerX,ArcadeRam.DiamondDash.PlayerY pattern DD_MinerPattern color DD_MinerColor
  update sprites
  return

sub DD_Diamond_BuildMountain:
  mute all
  screen off
  decompress mdkrle DD_DiamondNameRle to vram.name
  ArcadeRam.DiamondDash.PlayerX = 22
  ArcadeRam.DiamondDash.PlayerY = 2
  ArcadeRam.DiamondDash.PlayerDX = 0
  ArcadeRam.DiamondDash.PlayerDY = 0
  set sprite 0 to 15,176,DD_MinerPattern,DD_MinerColor
  ArcadeRam.DiamondDash.HoleCount = 5
Diamond_BuildMountain_holes:
  if Diamond_AddHoles() = false then goto Diamond_BuildMountain_holes
  if ArcadeRam.DiamondDash.HoleCount != 0 then goto Diamond_BuildMountain_holes
  DD_TmpCount = 51
  ArcadeRam.DiamondDash.DiamondDType = DD_EmeraldTile
Diamond_BuildMountain_green:
  if Diamond_AddDiamond() = false then goto Diamond_BuildMountain_green
  if DD_TmpCount != 0 then goto Diamond_BuildMountain_green
  DD_TmpCount = 23
  ArcadeRam.DiamondDash.DiamondDType = DD_RubyTile
Diamond_BuildMountain_red:
  if Diamond_AddDiamond() = false then goto Diamond_BuildMountain_red
  if DD_TmpCount != 0 then goto Diamond_BuildMountain_red
  DD_TmpCount = 11
  ArcadeRam.DiamondDash.DiamondDType = DD_DiamondTile
Diamond_BuildMountain_white:
  if Diamond_AddDiamond() = false then goto Diamond_BuildMountain_white
  if DD_TmpCount != 0 then goto Diamond_BuildMountain_white
  update sprites
  screen on
  return

sub DD_Diamond_MovePlayer:
  ArcadeRam.DiamondDash.MoveContinue = 1
  ArcadeRam.DiamondDash.PlayerDX = 0
  ArcadeRam.DiamondDash.PlayerDY = 0
  move sprite 0 toward tile ArcadeRam.DiamondDash.PlayerX,ArcadeRam.DiamondDash.PlayerY step 4 wait 3 frames animate pattern xor 1
  put char DD_WalkableTile at ArcadeRam.DiamondDash.PlayerX,ArcadeRam.DiamondDash.PlayerY
  if joypad(1).up then
    ArcadeRam.DiamondDash.PlayerDY = -1
  end if
  if joypad(1).down then
    ArcadeRam.DiamondDash.PlayerDY = 1
  end if
  if joypad(1).left then
    ArcadeRam.DiamondDash.PlayerDX = -1
  end if
  if joypad(1).right then
    ArcadeRam.DiamondDash.PlayerDX = 1
  end if
  if ArcadeRam.DiamondDash.PlayerDX != 0 goto Diamond_MP_SetMoving
  if ArcadeRam.DiamondDash.PlayerDY != 0 goto Diamond_MP_SetMoving
  set sprite 0 pattern bit 1 on
  goto Diamond_MP_AfterIdle
Diamond_MP_SetMoving:
  set sprite 0 pattern bit 1 off
Diamond_MP_AfterIdle:
  if joypad(1).button1 then goto Diamond_MovePlayer_fire_pressed
  ArcadeRam.DiamondDash.FireWasDown = 0
  goto Diamond_MovePlayer_target

Diamond_MovePlayer_fire_pressed:
  if ArcadeRam.DiamondDash.FireWasDown != 0 then goto Diamond_MovePlayer_target
  ArcadeRam.DiamondDash.FireWasDown = 1
  goto Diamond_MovePlayer_fire

Diamond_MovePlayer_fire:
  if ArcadeRam.DiamondDash.DynamiteCountdown = 0 then
    ArcadeRam.DiamondDash.DynamiteCountdown = DD_DynamiteFuse
    ArcadeRam.DiamondDash.OneDynamiteX = ArcadeRam.DiamondDash.PlayerX
    ArcadeRam.DiamondDash.OneDynamiteY = ArcadeRam.DiamondDash.PlayerY
    if DD_Dynamite = 0 then
      ArcadeRam.DiamondDash.GameOverFlag = 1
      ArcadeRam.DiamondDash.MoveContinue = 0
      return
    end if
    DD_Dynamite -= 1
    play sound 4
  end if
  goto Diamond_MovePlayer_target

Diamond_MovePlayer_target:
  DD_TmpX = ArcadeRam.DiamondDash.PlayerX + ArcadeRam.DiamondDash.PlayerDX
  DD_TmpY = ArcadeRam.DiamondDash.PlayerY + ArcadeRam.DiamondDash.PlayerDY
  DD_TmpType = get char at DD_TmpX,DD_TmpY
  select case DD_TmpType
  case DD_DynamitePackTile
    goto Diamond_MovePlayer_pickPack
  case DD_ExitOpenTile
    goto Diamond_MovePlayer_exitTile
  case DD_WalkableTile
    goto Diamond_MovePlayer_walk
  case DD_EmeraldTile
    goto Diamond_MovePlayer_green
  case DD_RubyTile
    goto Diamond_MovePlayer_red
  case DD_DiamondTile
    goto Diamond_MovePlayer_white
  end select
  return

Diamond_MovePlayer_walk:
  ArcadeRam.DiamondDash.PlayerX = DD_TmpX
  ArcadeRam.DiamondDash.PlayerY = DD_TmpY
  return

Diamond_MovePlayer_green:
  DD_Score += 1
  goto Diamond_MovePlayer_takeDiamond

Diamond_MovePlayer_red:
  DD_Score += 3
  goto Diamond_MovePlayer_takeDiamond

Diamond_MovePlayer_white:
  DD_Score += 5

Diamond_MovePlayer_takeDiamond:
  play sound 1
  ArcadeRam.DiamondDash.PlayerX = DD_TmpX
  ArcadeRam.DiamondDash.PlayerY = DD_TmpY
  ArcadeRam.DiamondDash.DiamondsNeeded -= 1
  if ArcadeRam.DiamondDash.DiamondsNeeded != 0 then return
  put char DD_ExitOpenTile at 23,2
  play sound 5
  play sound 6
  return

Diamond_MovePlayer_pickPack:
  DD_Dynamite += 3
  ArcadeRam.DiamondDash.PlayerX = DD_TmpX
  ArcadeRam.DiamondDash.PlayerY = DD_TmpY
  play sound 2
  return

Diamond_MovePlayer_exitTile:
  ArcadeRam.DiamondDash.PlayerX = DD_TmpX
  ArcadeRam.DiamondDash.PlayerY = DD_TmpY
  move sprite 0 toward tile ArcadeRam.DiamondDash.PlayerX,ArcadeRam.DiamondDash.PlayerY step 4 wait 3 frames animate pattern xor 1
  ArcadeRam.DiamondDash.MoveContinue = 0
  return

sub DD_Diamond_EndRound:
  if ArcadeRam.DiamondDash.GameOverFlag != 0 then return
Diamond_EndRound_timerLoop:
  if DD_Timer < 10 then goto Diamond_EndRound_dynamite
  DD_Timer -= 10
  DD_Score += 1
  play sound 1
  DD_show_score
  wait 2 frames
  goto Diamond_EndRound_timerLoop
Diamond_EndRound_dynamite:
  if DD_Dynamite = 0 then goto Diamond_EndRound_music
  DD_Dynamite -= 1
  DD_Score += 5
  play sound 2
  DD_show_score
  wait 12 frames
  goto Diamond_EndRound_dynamite
Diamond_EndRound_music:
  play sound 5
  play sound 6
  wait 75 frames
  return

sub DD_Diamond_UpdateDynamite:
  if ArcadeRam.DiamondDash.DynamiteCountdown = 0 then return
  ArcadeRam.DiamondDash.DynamiteCountdown -= 1
  DD_TmpType = DD_DynamiteLitTile2
  if ArcadeRam.DiamondDash.DynamiteCountdown mod 2 != 0 then
    DD_TmpType = DD_DynamiteLitTile1
  end if
  put char DD_TmpType at ArcadeRam.DiamondDash.OneDynamiteX,ArcadeRam.DiamondDash.OneDynamiteY
  if ArcadeRam.DiamondDash.DynamiteCountdown != 0 then return
  wait
  ' Guard the long VRAM carve burst from NMI status reads.
  nmi off
  DD_TmpCount = 3
  DD_Diamond_CarveSquare
  nmi on
  return

function Diamond_AddDiamond() as bool
  DD_TmpX = random(DD_DiamondMinX, DD_DiamondMaxX)
  DD_TmpY = random(DD_DiamondMinY, DD_DiamondMaxY)
  DD_TmpType = get char at DD_TmpX,DD_TmpY
  if DD_TmpType != DD_RockTile then return false
  if chars in box DD_TmpX - 1,DD_TmpY - 1 size 3,3 contain DD_hole then return false
  put char ArcadeRam.DiamondDash.DiamondDType at DD_TmpX,DD_TmpY
  DD_TmpCount -= 1
  return true

function Diamond_AddHoles() as bool
  DD_TmpX = random(DD_HoleMinX, DD_HoleMaxX)
  DD_TmpY = random(DD_HoleMinY, DD_HoleMaxY)
  DD_TmpType = random(0, 1)
  if DD_TmpType = 0 then
    restore DD_HolesShape1
  else
    restore DD_HolesShape2
  end if
  ArcadeRam.DiamondDash.DiamondDType = 13
Diamond_AddHoles_checkLoop:
  read DD_TmpDX, DD_TmpDY
  DD_TmpCount = get char at DD_TmpX + DD_TmpDX,DD_TmpY + DD_TmpDY
  if DD_TmpCount != DD_RockTile then return false
  ArcadeRam.DiamondDash.DiamondDType -= 1
  if ArcadeRam.DiamondDash.DiamondDType != 0 then goto Diamond_AddHoles_checkLoop
  if DD_TmpType = 0 then
    restore DD_HolesShape1
  else
    restore DD_HolesShape2
  end if
  ArcadeRam.DiamondDash.DiamondDType = 13
Diamond_AddHoles_paintLoop:
  read DD_TmpDX, DD_TmpDY
  put char DD_WalkableTile at DD_TmpX + DD_TmpDX,DD_TmpY + DD_TmpDY
  ArcadeRam.DiamondDash.DiamondDType -= 1
  if ArcadeRam.DiamondDash.DiamondDType != 0 then goto Diamond_AddHoles_paintLoop
  ArcadeRam.DiamondDash.HoleCount -= 1
  select case ArcadeRam.DiamondDash.HoleCount
  case 2
    put char DD_PowderBarrelTile at DD_TmpX,DD_TmpY
  case 1
    put char DD_DynamitePackTile at DD_TmpX,DD_TmpY
  end select
  return true

sub DD_Diamond_CarveSquare:
  play sound 2
  DD_TmpX = 5
Diamond_CS_rocks:
  ArcadeRam.DiamondDash.RockX = random(DD_RockMinX, DD_RockMaxX)
  ArcadeRam.DiamondDash.RockY = random(DD_RockMinY, DD_RockMaxY)
  DD_TmpType = get char at ArcadeRam.DiamondDash.RockX,ArcadeRam.DiamondDash.RockY
  if DD_TmpType != DD_WalkableTile then goto Diamond_CS_rocks
  put char DD_RockTile at ArcadeRam.DiamondDash.RockX,ArcadeRam.DiamondDash.RockY
  DD_TmpX -= 1
  if DD_TmpX != 0 then goto Diamond_CS_rocks
  ArcadeRam.DiamondDash.CS_BarrelX = 0
  ArcadeRam.DiamondDash.CS_BarrelY = 0
  DD_TmpY = DD_TmpCount
  DD_TmpY >>= 1
  DD_CS_StartX = ArcadeRam.DiamondDash.OneDynamiteX
  DD_CS_StartX -= DD_TmpY
  DD_CS_StartY = ArcadeRam.DiamondDash.OneDynamiteY
  DD_CS_StartY -= DD_TmpY
  DD_BlastFrame = get frame size DD_TmpCount,DD_TmpCount at DD_CS_StartX,DD_CS_StartY
  replace DD_blastClears with DD_WalkableTile in DD_BlastFrame frame size DD_TmpCount,DD_TmpCount
  ArcadeRam.DiamondDash.CS_FrameIndex = 0
  ArcadeRam.DiamondDash.HoleCount = DD_CS_StartY
  ArcadeRam.DiamondDash.DiamondDType = DD_TmpCount
Diamond_CS_row:
  ArcadeRam.DiamondDash.CS_CurCol = DD_CS_StartX
  ArcadeRam.DiamondDash.CS_ColCount = DD_TmpCount
Diamond_CS_col:
  DD_TmpType = DD_BlastFrame[ArcadeRam.DiamondDash.CS_FrameIndex]
  select case DD_TmpType
  case DD_PowderBarrelTile
    ArcadeRam.DiamondDash.CS_BarrelX = ArcadeRam.DiamondDash.CS_CurCol
    ArcadeRam.DiamondDash.CS_BarrelY = ArcadeRam.DiamondDash.HoleCount
    DD_BlastFrame[ArcadeRam.DiamondDash.CS_FrameIndex] = DD_WalkableTile
  end select
  ArcadeRam.DiamondDash.CS_FrameIndex += 1
  ArcadeRam.DiamondDash.CS_CurCol += 1
  ArcadeRam.DiamondDash.CS_ColCount -= 1
  if ArcadeRam.DiamondDash.CS_ColCount != 0 then goto Diamond_CS_col
  ArcadeRam.DiamondDash.HoleCount += 1
  ArcadeRam.DiamondDash.DiamondDType -= 1
  if ArcadeRam.DiamondDash.DiamondDType != 0 then goto Diamond_CS_row
  put DD_BlastFrame frame size DD_TmpCount,DD_TmpCount at DD_CS_StartX,DD_CS_StartY
  if ArcadeRam.DiamondDash.CS_BarrelX = 0 then return
  ArcadeRam.DiamondDash.OneDynamiteX = ArcadeRam.DiamondDash.CS_BarrelX
  ArcadeRam.DiamondDash.OneDynamiteY = ArcadeRam.DiamondDash.CS_BarrelY
  DD_TmpCount = 7
  DD_Diamond_CarveSquare
  return

include "@project/diamond_sounds.inc"

' ============================================================================
' FLY GAME MODULE
' RAM PART: ArcadeRam.FlySwatter
' ENTRY: FS_GameEntry
' OWNERSHIP RULE: initialize this RAM part before reading previous values.
' ============================================================================
sub FS_GameEntry:
  tile screen
  backdrop dark blue
  sprites 16x16
  sprites simple
  copy FS_SwatterSprite to vram.spr_pat
  copy FS_FlySprite to vram.spr_pat + 32
  copy FS_FlySpriteB to vram.spr_pat + 64
  copy FS_FlySplatSprite to vram.spr_pat + 96
  copy FS_FlySplatSpriteB to vram.spr_pat + 128
  set sound table FlySoundTable areas 6
  clear sprites
  set sprite count 5
  screen on
  FS_NewGame
  goto FS_GameLoop

sub FS_TitleScreen:
  mute all
  cls
  print centered at 8, "FLY SWATTER"
  print centered at 12, "PRESS FIRE"
  pause until press and release sleep after 10 seconds
  FS_NewGame
  goto FS_GameLoop
sub FS_NewGame:
  cls
  print at 1,0, "TIME"
  print at 12,0, "FLIES"
  print at 22,0, "SCORE"
  print at 1,1, "LEVEL"
  ArcadeRam.FlySwatter.Swatter.X = 120
  ArcadeRam.FlySwatter.Swatter.Y = 152
  ArcadeRam.FlySwatter.BigFly.X = 13
  ArcadeRam.FlySwatter.BigFly.Y = 8
  ArcadeRam.FlySwatter.BigFly.DX = 1
  ArcadeRam.FlySwatter.BigFly.DY = 1
  ArcadeRam.FlySwatter.BossOldX = 13
  ArcadeRam.FlySwatter.BossOldY = 8
  ArcadeRam.FlySwatter.BigFly.State = FS_BossSleeping
  ArcadeRam.FlySwatter.Level = 1
  ArcadeRam.FlySwatter.PendingStage = 0
  ArcadeRam.FlySwatter.EnemiesLeft = 17  ' 2 + 3 + 3 + 4 + 4 flies, then the boss.
  ArcadeRam.FlySwatter.BossHealth = 0
  ArcadeRam.FlySwatter.BossActive = 0
  ArcadeRam.FlySwatter.Score = 0
  ArcadeRam.FlySwatter.FireWasDown = 0
  ArcadeRam.FlySwatter.SwatterLocked = 0
  ArcadeRam.FlySwatter.WingFrame = 0
  clear sprites
  set sprite count 5
  FS_StopGameTimers
  start timer FS_FlyStep
  play sound 1
  FS_StartFlyLevel
  return

sub FS_GameLoop:
  wait
  if timer FS_SwatterLock then ArcadeRam.FlySwatter.SwatterLocked = 0
  FS_ReadSwatter
  if timer FS_FlyStep then FS_GameplayTick
  if timer FS_RoundSecond then FS_SecondTick
  ' Time expiration is terminal; do not process a final boss step or hit.
  if ArcadeRam.FlySwatter.RoundTime = 0 then goto FS_GameOver
  if timer FS_BossStep then FS_BossGameplayTick
  if ArcadeRam.FlySwatter.BossActive = 1 then
    if timer FS_BossPhase then
      if ArcadeRam.FlySwatter.BigFly.State < FS_BossDefeated then
        ArcadeRam.FlySwatter.BigFly.State = FS_BossNextStates[ArcadeRam.FlySwatter.BigFly.State - 1]
        start timer FS_BossPhase
      end if
    end if
  end if
  FS_CheckSwat
  FS_DrawActors
  if ArcadeRam.FlySwatter.BigFly.State = FS_BossDefeated then goto FS_Victory
  goto FS_GameLoop

sub FS_GameplayTick:
  if ArcadeRam.FlySwatter.WingFrame = 0 then
    ArcadeRam.FlySwatter.WingFrame = 1
  else
    ArcadeRam.FlySwatter.WingFrame = 0
  end if
  for FS_ActiveFly = 0 to 3
    on ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State gosub FS_MoveFly, FS_AnimateSplat, FS_DeadFly
  next
  if ArcadeRam.FlySwatter.PendingStage = 1 then
    if ArcadeRam.FlySwatter.Flies[0].State = FS_FlyDefeated and ArcadeRam.FlySwatter.Flies[1].State = FS_FlyDefeated and ArcadeRam.FlySwatter.Flies[2].State = FS_FlyDefeated and ArcadeRam.FlySwatter.Flies[3].State = FS_FlyDefeated then
      ArcadeRam.FlySwatter.PendingStage = 0
      if ArcadeRam.FlySwatter.Level < 5 then
        ArcadeRam.FlySwatter.Level += 1
        FS_StartFlyLevel
      else
        FS_StartBoss
      end if
    end if
  end if
  return

sub FS_BossGameplayTick:
  if ArcadeRam.FlySwatter.BossActive = 0 then return
  if ArcadeRam.FlySwatter.BigFly.State = FS_BossHunting or ArcadeRam.FlySwatter.BigFly.State = FS_BossCharging then FS_MoveBoss
  FS_DrawBoss
  return

sub FS_MoveFly:
  ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X += ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DX
  ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y += ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DY
  if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X < 18 then ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DX = 0 - ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DX
  if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X > 222 then ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DX = 0 - ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DX
  if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y < 30 then ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DY = 0 - ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DY
  if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y > 154 then ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DY = 0 - ArcadeRam.FlySwatter.Flies[FS_ActiveFly].DY
  return

sub FS_AnimateSplat:
  if ArcadeRam.FlySwatter.SplatTicks[FS_ActiveFly] > 0 then ArcadeRam.FlySwatter.SplatTicks[FS_ActiveFly] -= 1
  if ArcadeRam.FlySwatter.SplatTicks[FS_ActiveFly] = 0 then ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State = FS_FlyDefeated
  return

sub FS_DeadFly:
  return

sub FS_MoveBoss:
  ArcadeRam.FlySwatter.BigFly.X += ArcadeRam.FlySwatter.BigFly.DX
  ArcadeRam.FlySwatter.BigFly.Y += ArcadeRam.FlySwatter.BigFly.DY
  if ArcadeRam.FlySwatter.BigFly.X < 3 then
    ArcadeRam.FlySwatter.BigFly.X = 3
    ArcadeRam.FlySwatter.BigFly.DX = 1
  end if
  if ArcadeRam.FlySwatter.BigFly.X > 22 then
    ArcadeRam.FlySwatter.BigFly.X = 22
    ArcadeRam.FlySwatter.BigFly.DX = -1
  end if
  if ArcadeRam.FlySwatter.BigFly.Y < 4 then
    ArcadeRam.FlySwatter.BigFly.Y = 4
    ArcadeRam.FlySwatter.BigFly.DY = 1
  end if
  if ArcadeRam.FlySwatter.BigFly.Y > 17 then
    ArcadeRam.FlySwatter.BigFly.Y = 17
    ArcadeRam.FlySwatter.BigFly.DY = -1
  end if
  return

sub FS_ReadSwatter:
  if ArcadeRam.FlySwatter.SwatterLocked = 1 then return
  if joypad(1).left then
    if ArcadeRam.FlySwatter.Swatter.X > 10 then ArcadeRam.FlySwatter.Swatter.X -= 3
  end if
  if joypad(1).right then
    if ArcadeRam.FlySwatter.Swatter.X < 230 then ArcadeRam.FlySwatter.Swatter.X += 3
  end if
  if joypad(1).up then
    if ArcadeRam.FlySwatter.Swatter.Y > 24 then ArcadeRam.FlySwatter.Swatter.Y -= 3
  end if
  if joypad(1).down then
    if ArcadeRam.FlySwatter.Swatter.Y < 164 then ArcadeRam.FlySwatter.Swatter.Y += 3
  end if
  return

sub FS_CheckSwat:
  if not joypad(1).fire then
    ArcadeRam.FlySwatter.FireWasDown = 0
    return
  end if
  if ArcadeRam.FlySwatter.FireWasDown = 1 then return
  if ArcadeRam.FlySwatter.SwatterLocked = 1 then return
  ' Trigger once per press; the lock supplies the visible swatter recoil.
  ArcadeRam.FlySwatter.FireWasDown = 1
  ArcadeRam.FlySwatter.SwatterLocked = 1
  start timer FS_SwatterLock
  play sound 2
  for FS_ActiveFly = 0 to 3
    if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State = FS_FlyFlying then
      if sprite 0 hitbox FS_SwatterHit collides with sprite FS_ActiveFly + 1 hitbox FS_FlyHit then
        FS_SwatFly
        return
      end if
    end if
  next
  if ArcadeRam.FlySwatter.BossActive = 1 then
    ' The boss is tile-rendered, so convert its tile origin to logical pixels.
    ArcadeRam.FlySwatter.BossPixelX = ArcadeRam.FlySwatter.BigFly.X << 3
    ArcadeRam.FlySwatter.BossPixelY = ArcadeRam.FlySwatter.BigFly.Y << 3
    if box ArcadeRam.FlySwatter.Swatter.X,ArcadeRam.FlySwatter.Swatter.Y size 15,15 collides with box ArcadeRam.FlySwatter.BossPixelX,ArcadeRam.FlySwatter.BossPixelY size 56,24 then
      ArcadeRam.FlySwatter.BossHealth -= 1
      ArcadeRam.FlySwatter.Score += 50
      play sound 3
      if ArcadeRam.FlySwatter.BossHealth = 0 then
        ArcadeRam.FlySwatter.BigFly.State = FS_BossDefeated
        ArcadeRam.FlySwatter.EnemiesLeft -= 1
        stop sound 5
        play sound 4
        FS_DrawBoss
        wait 120 frames
      end if
      FS_DrawStatus
      return
    end if
  end if
  return

sub FS_SwatFly:
  ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State = FS_FlySplat
  ArcadeRam.FlySwatter.SplatTicks[FS_ActiveFly] = 4
  ArcadeRam.FlySwatter.FliesLeft -= 1
  ArcadeRam.FlySwatter.EnemiesLeft -= 1
  ArcadeRam.FlySwatter.Score += 100
  if ArcadeRam.FlySwatter.FliesLeft = 0 then ArcadeRam.FlySwatter.PendingStage = 1
  FS_DrawStatus
  return

sub FS_StartFlyLevel:
u8 FS_LevelIndex = 0
  FS_LevelIndex = ArcadeRam.FlySwatter.Level - 1
  ArcadeRam.FlySwatter.LevelOffset = FS_LevelOffsets[FS_LevelIndex]
  ArcadeRam.FlySwatter.FlyColor = FS_LevelColors[FS_LevelIndex]
  ArcadeRam.FlySwatter.FliesLeft = FS_LevelFlyCounts[FS_LevelIndex]
  ArcadeRam.FlySwatter.RoundTime = 30
  copy FS_LevelFlies + ArcadeRam.FlySwatter.LevelOffset count 20 to ArcadeRam.FlySwatter.Flies
  for FS_ActiveFly = 0 to 3
    ArcadeRam.FlySwatter.SplatTicks[FS_ActiveFly] = 0
  next
  start timer FS_RoundSecond
  ArcadeRam.FlySwatter.LevelOffset = FS_LevelMessageOffsets[FS_LevelIndex]
  put FS_LevelMessages + ArcadeRam.FlySwatter.LevelOffset count 25 at 4,22
  FS_DrawStatus
  FS_DrawActors
  return

sub FS_StartBoss:
  stop sound 1
  ArcadeRam.FlySwatter.BossActive = 1
  ArcadeRam.FlySwatter.BossHealth = 10
  ArcadeRam.FlySwatter.BigFly.State = FS_BossSleeping
  start timer FS_BossPhase
  start timer FS_BossStep
  play sound 5
  FS_ClearBottomMessage
  print centered at 22, "BIG FLY INCOMING!"
  FS_DrawBoss
  return

sub FS_ClearBottomMessage:
  fill row 22 from 1 count 30 with 32
  return

sub FS_SecondTick:
  if ArcadeRam.FlySwatter.RoundTime > 0 then ArcadeRam.FlySwatter.RoundTime -= 1
  FS_DrawStatus
  return

sub FS_DrawStatus:
  print ArcadeRam.FlySwatter.Level at 7,1 digits 1
  print ArcadeRam.FlySwatter.RoundTime at 6,0 digits 2
  print ArcadeRam.FlySwatter.EnemiesLeft at 18,0 digits 2
  print ArcadeRam.FlySwatter.Score at 28,0 digits 4
  return

sub FS_DrawActors:
  if ArcadeRam.FlySwatter.SwatterLocked = 1 then
    set sprite 0 to ArcadeRam.FlySwatter.Swatter.Y,ArcadeRam.FlySwatter.Swatter.X,0,8
  else
    set sprite 0 to ArcadeRam.FlySwatter.Swatter.Y,ArcadeRam.FlySwatter.Swatter.X,0,15
  end if
  for FS_ActiveFly = 0 to 3
    if ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State = FS_FlyDefeated then
      set sprite FS_ActiveFly + 1 y to 207
    elseif ArcadeRam.FlySwatter.Flies[FS_ActiveFly].State = FS_FlySplat then
      if ArcadeRam.FlySwatter.WingFrame = 0 then
        set sprite FS_ActiveFly + 1 to ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y,ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X,12,8
      else
        set sprite FS_ActiveFly + 1 to ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y,ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X,16,8
      end if
    else
      if ArcadeRam.FlySwatter.WingFrame = 0 then
        set sprite FS_ActiveFly + 1 to ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y,ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X,4,ArcadeRam.FlySwatter.FlyColor
      else
        set sprite FS_ActiveFly + 1 to ArcadeRam.FlySwatter.Flies[FS_ActiveFly].Y,ArcadeRam.FlySwatter.Flies[FS_ActiveFly].X,8,ArcadeRam.FlySwatter.FlyColor
      end if
    end if
  next
  update sprites
  return
sub FS_DrawBoss:
  put FS_BossBlankFrame frame size 7,3 at ArcadeRam.FlySwatter.BossOldX,ArcadeRam.FlySwatter.BossOldY
  if ArcadeRam.FlySwatter.BossActive = 1 then
    if ArcadeRam.FlySwatter.BigFly.State = FS_BossDefeated then
      put FS_BossDeadFrame frame size 7,3 at ArcadeRam.FlySwatter.BigFly.X,ArcadeRam.FlySwatter.BigFly.Y
    elseif ArcadeRam.FlySwatter.WingFrame = 0 then
      put FS_BossTileFrame frame size 7,3 at ArcadeRam.FlySwatter.BigFly.X,ArcadeRam.FlySwatter.BigFly.Y
    else
      put FS_BossTileFrameB frame size 7,3 at ArcadeRam.FlySwatter.BigFly.X,ArcadeRam.FlySwatter.BigFly.Y
    end if
  end if
  ArcadeRam.FlySwatter.BossOldX = ArcadeRam.FlySwatter.BigFly.X
  ArcadeRam.FlySwatter.BossOldY = ArcadeRam.FlySwatter.BigFly.Y
  return

sub FS_StopGameTimers:
  stop timer FS_FlyStep
  stop timer FS_RoundSecond
  stop timer FS_BossPhase
  stop timer FS_BossStep
  stop timer FS_SwatterLock
  return

sub FS_GameOver:
  FS_StopGameTimers
  mute all
  FS_ClearBottomMessage
  clear sprites
  update sprites
  print centered at 10, "TIME IS UP"
  play sound 6
  wait 300 frames
  wait no fire
  print centered at 13, "PRESS FIRE TO TRY AGAIN"
  pause until press and release sleep after 10 seconds
  goto FS_TitleScreen

sub FS_Victory:
  FS_ClearBottomMessage
  FS_StopGameTimers
  clear sprites
  update sprites
  ArcadeRam.FlySwatter.BossActive = 0
  FS_DrawBoss
  print centered at 9, "THE BIG FLY IS DOWN!"
  print centered at 12, "TIMER QUEST COMPLETE"
  print centered at 16, "PRESS FIRE"
  pause until press and release sleep after 10 seconds
  goto FS_TitleScreen

asm {
FlyBuzzSound:
    db $80,$19,$93,$01
    db $80,$15,$A3,$03
    db $80,$21,$93,$02
    db $80,$0C,$93,$02
    db $80,$13,$93,$01
    db $80,$0C,$A3,$03
    db $80,$21,$93,$02
    db $80,$15,$93,$02
    db $98
SwatterSound:
    db $40,$25,$62,$01,$40,$74,$51,$01,$40,$86,$00,$02,$50
BossSplatSound:
    db $02,$15,$20,$1B,$32,$10
VictorySound:
    db $40,$1D,$51,$06,$40,$D5,$50,$06,$40,$A9,$50,$06
    db $40,$8E,$50,$06,$40,$6A,$50,$18,$50
BossBuzzSound:
    db $80,$49,$73,$01
    db $80,$45,$63,$03
    db $80,$51,$73,$02
    db $80,$1C,$63,$02
    db $80,$33,$73,$01
    db $80,$1C,$63,$03
    db $80,$41,$73,$02
    db $80,$45,$63,$02
    db $98
LostSound:
    db $81,$F6,$31,$02,$CC,$7C
    db $81,$20,$52,$02,$CC,$7D
    db $81,$3F,$72,$02,$DD,$7E
    db $81,$60,$92,$02,$DD,$7F
    db $81,$60,$C2,$02,$EE,$7F
    db $90
FlySoundTable:
    dw FlyBuzzSound,$702B
    dw SwatterSound,$7035
    dw BossSplatSound,$703F
    dw VictorySound,$7049
    dw BossBuzzSound,$7053
    dw LostSound,$705D
}
