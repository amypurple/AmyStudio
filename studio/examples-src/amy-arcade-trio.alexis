project "Amy Arcade Trio"
' cartridge "AMY ARCADE/TRIO/2026"
memory "colecovision_legacy_sdcc"

' MULTI-GAME MEMORY MAP
' 1. Shared variables remain alive while the cartridge runs.
' 2. ArcadeRam reserves only its largest game-specific record.
' 3. Entering a game must initialize that game's overlay part before reading it.
' 4. Phase A exceptions are listed explicitly as permanent RAM below.
'
' SOURCE ORGANIZATION
' A. Shared types and the complete RAM map come first so memory ownership is visible.
' B. ROM resources follow; they consume no overlay RAM.
' C. The cartridge title and selector are the only shared executable flow.
' D. Each game code section names the one ArcadeRam part that it owns.

' SHARED CARTRIDGE STATE
u8 ArcadeChoice = 0

' SHARED RECORD TYPES USED BY OVERLAY PARTS
record Actor:
  u8 X
  u8 Y
  i8 DX
  i8 DY
  u8 State
end record

' GAME-SPECIFIC RAM LAYOUTS
record ExplosionMemory:
  i8 Board[64]
  i8 SimBoard[64]
  u8 CursorX
  u8 CursorY
  u8 OldX
  u8 OldY
  i8 FrameValue
  u8 FrameIndex
  u8 FrameOffset
  u8 CellCount
  u8 Threshold
  u8 CurrentOwner
  u8 Exploded
  u8 OpponentFound
  u8 CpuTry
  u8 BestIndex
  u8 SimET
  u8 EvalHit
  i16 EvalScore
  i16 BestScore
  u8 Tmp
  u8 SpriteX
  u8 SpriteY
  u8 WinFlag
end record

record DiamondDashMemory:
  u8 DiamondsNeeded
  u8 SessionMountains
  u8 MoveContinue
  u8 GameOverFlag
  u8 PlayerX
  u8 PlayerY
  i8 PlayerDX
  i8 PlayerDY
  u8 OneDynamiteX
  u8 OneDynamiteY
  u8 DynamiteCountdown
  u8 FireWasDown
  u8 DiamondDType
  u8 HoleCount
  u8 RockX
  u8 RockY
  u8 CS_CurCol
  u8 CS_ColCount
  u8 CS_BarrelX
  u8 CS_BarrelY
  u8 CS_FrameIndex
end record

record FlySwatterMemory:
  Actor Swatter
  Actor BigFly
  Actor Flies[4]
  u8 Level
  u8 PendingStage
  u8 FliesLeft
  u8 EnemiesLeft
  u8 BossHealth
  u8 BossActive
  u8 FireWasDown
  u8 SwatterLocked
  u8 RoundTime
  u8 WingFrame
  u8 FlyColor
  u8 LevelOffset
  u8 SplatTicks[4]
  u8 BossOldX
  u8 BossOldY
  u8 BossPixelX
  u8 BossPixelY
  u16 Score
end record

' One physical RAM region, interpreted as exactly one active game at a time.
overlay ArcadeRam
  Explosion as ExplosionMemory
  DiamondDash as DiamondDashMemory
  FlySwatter as FlySwatterMemory
end overlay

' PERMANENT PHASE A EXCEPTIONS
' These operands cannot yet be qualified in BCD, for, put, or get statements.
' They are workspaces, not persistent game state, and remain outside ArcadeRam.
' EXPLOSION WORKSPACE
u8 EX_Row = 0
u8 EX_Col = 0
u8 EX_CellIndex = 0
i8 EX_CellValue = 0
u8 EX_CellFrame[4]
u8 EX_TmpX = 0
u8 EX_TmpY = 0

' DIAMOND WORKSPACE
bcd digits 4 DD_Score, DD_Timer
bcd digits 2 DD_Dynamite
u8 DD_TmpX = 0, DD_TmpY = 0, DD_TmpType = 0, DD_TmpCount = 0
i8 DD_TmpDX = 0, DD_TmpDY = 0
u8 DD_CS_StartX = 0, DD_CS_StartY = 0
u8 DD_BlastFrame[49]

' FLY WORKSPACE
u8 FS_ActiveFly = 0

' SHARED TITLE RESOURCES
picture ArcadeTrioTitle:
  pattern from "@project/amy-arcade-trio-title.pattern.zx0" codec zx0
  color from "@project/amy-arcade-trio-title.color.zx0" codec zx0
end picture

asm {
ArcadeTrioSoundTable:
    dw ArcadeTrioDing,$702B
ArcadeTrioDing:
    db $42,$8F,$30,$0E,$F4,$21
    db $62
    db $42,$8F,$30,$06,$F4,$21
    db $62
    db $42,$8F,$30,$06,$F4,$21
    db $62
    db $40,$6B,$40,$05
    db $41,$69,$50,$03,$11,$02
    db $40,$6B,$40,$01
    db $41,$69,$30,$03,$11,$02
    db $40,$6B,$20,$01
    db $41,$69,$30,$03,$11,$02
    db $40,$6B,$20,$01
    db $41,$69,$10,$03,$11,$02
    db $40,$6B,$00,$01
    db $41,$69,$10,$03,$11,$02
    db $40,$6B,$00,$01
    db $41,$69,$00,$03,$11,$02
    db $40,$6B,$00,$01
    db $41,$69,$00,$02,$11,$02
    db $50
}

' ---------------------------------------------------------------------------
' EXPLOSION ROM RESOURCES
' RAM PART: ArcadeRam.Explosion
' These constants and data tables live in ROM, not in the overlay.
' ---------------------------------------------------------------------------
' Amy port inspired by Amy Bienvenu / NewColeco's 2004 SDCC Explosion sample.
' Original source: old-projects-sdcc-z80/sdcctest/explosion/
' Board cells are signed like the original C char arrays:
'   positive = player, negative = CPU, zero = empty.
' Keep units separate:
'   Col/Row are board-cell coordinates, TileX/TileY are tile coordinates,
'   SpriteX/SpriteY are pixel coordinates.

const EX_BoardTileX = 8
const EX_BoardTileY = 4
const EX_PlayerOwner = 1
const EX_CpuOwner = 2
const EX_MaxEval = 32000

' Original SDCC sprites: two layered arrow sprites plus one explosion sprite.
data EX_ExplosionSprites bytes
  $03,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$02,$03,$00,$00,$00
  $00,$80,$40,$20,$10,$08,$04,$02,$01,$0E,$48,$A4,$24,$12,$12,$0C
  $00,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$00,$00,$00,$00
  $00,$00,$80,$C0,$E0,$F0,$F8,$FC,$FE,$F0,$B0,$18,$18,$0C,$0C,$00
  $80,$20,$58,$36,$2D,$1F,$17,$0F,$0F,$17,$1F,$2D,$36,$58,$20,$80
  $01,$04,$1A,$6C,$B4,$F8,$E8,$F0,$F0,$E8,$F8,$B4,$6C,$1A,$04,$01
end data

' Original board tile graphics, matching change_pattern(128,CASE_PATTERN,26).
data EX_ExplosionCasePattern bytes
  $00,$00,$00,$00,$00,$00,$03,$03,$01,$01,$01,$01,$01,$01,$81,$81
  $03,$00,$00,$00,$00,$00,$00,$FF,$81,$01,$01,$01,$01,$01,$01,$FF
  $00,$00,$38,$38,$38,$00,$00,$00,$01,$01,$01,$01,$01,$01,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$FF,$01,$01,$39,$39,$39,$01,$01,$FF
  $00,$00,$38,$38,$38,$00,$03,$03,$01,$01,$01,$01,$01,$01,$81,$81
  $03,$00,$00,$00,$00,$00,$00,$FF,$81,$01,$39,$39,$39,$01,$01,$FF
  $01,$01,$39,$39,$39,$01,$01,$01,$00,$00,$38,$38,$38,$00,$00,$FF
  $00,$00,$38,$38,$38,$00,$03,$03,$01,$01,$39,$39,$39,$01,$81,$81
  $03,$00,$38,$38,$38,$00,$00,$FF,$81,$01,$39,$39,$39,$01,$01,$FF
  $00,$00,$38,$38,$38,$00,$38,$38,$01,$01,$39,$39,$39,$01,$39,$39
  $38,$00,$38,$38,$38,$00,$00,$FF,$39,$01,$39,$39,$39,$01,$01,$FF
  $00,$00,$38,$38,$3B,$03,$3B,$38,$01,$01,$39,$39,$B9,$81,$B9,$39
  $3B,$03,$3B,$38,$38,$00,$00,$FF,$B9,$81,$B9,$39,$39,$01,$01,$FF
end data

' Original empty tile graphics, matching change_pattern(154,EMPTY_PATTERN,4).
data EX_ExplosionEmptyPattern bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$01,$01,$01,$01,$01,$01,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$FF,$01,$01,$01,$01,$01,$01,$01,$FF
end data

' Original spaces[] frame table: 17 board-value frames, each a 2x2 tile frame.
data EX_ExplosionSpaces bytes
  $96,$97,$98,$99,$96,$97,$94,$95,$92,$93,$94,$95,$8E,$8F,$90,$91
  $84,$8C,$8D,$87,$88,$89,$8A,$8B,$84,$85,$86,$87,$80,$81,$82,$83
  $9A,$9B,$9C,$9D,$9E,$9F,$A0,$A1,$A2,$A3,$A4,$A5,$A6,$A7,$A8,$A9
  $A2,$AA,$AB,$A5,$AC,$AD,$AE,$AF,$B0,$B1,$B2,$B3,$B4,$B5,$B2,$B3
  $B4,$B5,$B6,$B7
end data

' ---------------------------------------------------------------------------
' DIAMOND ROM RESOURCES
' RAM PART: ArcadeRam.DiamondDash
' These constants and data tables live in ROM, not in the overlay.
' ---------------------------------------------------------------------------
' Board-generation constants.
const DD_DiamondMinX = 1
const DD_DiamondMaxX = 30
const DD_DiamondMinY = 4
const DD_DiamondMaxY = 21
const DD_HoleMinX = 3
const DD_HoleMaxX = 28
const DD_HoleMinY = 8
const DD_HoleMaxY = 21
const DD_RockMinX = 0
const DD_RockMaxX = 31
const DD_RockMinY = 2
const DD_RockMaxY = 22
const DD_StartDynamite = 20
const DD_StartTimer = 1000
const DD_DynamiteFuse = 10

' Session state.

' Player and dynamite position state.

' General scratch state for map edits and scans.

' Tile meanings.
enum DD_DiamondTiles:
  DD_RockTile = 1
  DD_WalkableTile = 2
  DD_EmeraldTile = 3
  DD_RubyTile = 4
  DD_DiamondTile = 5
  DD_ExitOpenTile = 6
  DD_PowderBarrelTile = 7
  DD_ExitClosedTile = 8
  DD_DynamiteLitTile1 = 29
  DD_DynamiteLitTile2 = 30
  DD_DynamitePackTile = 31
  DD_SkyTile = 32
end enum

' Sprite pattern indexes.
enum DD_DiamondSprite:
  DD_MinerPattern = 64
end enum
const DD_MinerColor = 15

tile type DD_hole = DD_WalkableTile
tile type DD_blastClears = DD_RockTile,DD_DynamiteLitTile1,DD_DynamiteLitTile2,DD_DynamitePackTile

asset DD_DiamondNameRle from "@project/diamond.name.mdkrle" codec mdkrle
asset DD_DiamondPatternRle from "@project/diamond.pattern.mdkrle" codec mdkrle
asset DD_DiamondColorRle from "@project/diamond.color.mdkrle" codec mdkrle

data DD_HolesShape1 bytes = -1,-2, 0,-2, 1,-2, -2,-1, -1,-1, 0,-1, 1,-1, 2,-1, -2,0, -1,0, 0,0, 1,0, 0,1
data DD_HolesShape2 bytes = -2,-2, -1,-2, 0,-2, -2,-1, -1,-1, 0,-1, 1,-1, -2,0, -1,0, 0,0, 1,0, 0,1, 1,1
data DD_minimum_diamants bytes = 85,75,60,45,35
data DD_GameOverText bytes = 33,34,35,36,37,38
data DD_TitleText bytes = 40,41,42,43,44,45,46,47

' ---------------------------------------------------------------------------
' FLY ROM RESOURCES
' RAM PART: ArcadeRam.FlySwatter
' These constants and data tables live in ROM, not in the overlay.
' ---------------------------------------------------------------------------
' Three timer roles: movement cadence, round clock, and boss phases.
timer FS_FlyStep every 8 ticks stopped
timer FS_RoundSecond every 60 ticks stopped
timer FS_BossPhase after 24 ticks stopped
timer FS_BossStep every 4 ticks stopped
timer FS_SwatterLock after 15 ticks stopped

' VBlank timers keep movement, round time, and attack phases independent.

