' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u8 JSt[MaxJ]            ' state
u8 JIdx[MaxJ]           ' place on the flight path (0..PathEnd)
u8 JAcc[MaxJ]           ' sixteenths of a path step
u8 JStage[MaxJ]         ' next bounce (0-2), 3 = flying to the ambulance
u8 JX[MaxJ]             ' position when falling / on the ground
u8 JY[MaxJ]
u8 JT[MaxJ]             ' timer (balcony wait, squash, dizzy)
u8 JC[MaxJ]             ' colour
u8 JWho[MaxJ]             ' which person of the round (HUD icon)
u8 PState[MaxPeople]    ' 0 waiting, 1 saved, 2 bumped

u8 Level = 1
u8 StartLv = 1          ' test hook: the bots may start at another level
u8 Lives = 3
u16 Saved = 0
u8 People = 3
u8 Spawned = 0
u8 Done = 0
u8 Spd = 8              ' path steps per frame, in sixteenths
u8 Need1 = 12           ' fairness gaps, in path steps
u8 Need2 = 16
u8 LedgeW = 60
u8 GapT = 0
u8 Nf = 0
u8 CrouchF = 30       ' frames of crouching before a jump
u8 Cro = 0            ' the same in path steps
u8 FfCol = 13           ' left column of the firefighters' group
u8 FfTgt = 1            ' stretcher place wanted (0-2)
u8 MoveT = 0
u8 SagT = 0
u8 WalkF = 0
u8 PrevL = 0
u8 PrevR = 0
u8 EndT = 0
u8 StarJ = 255          ' the person who has the dizzy stars
u8 FireF = 0
u8 PersF = 0
u8 LightF = 0
u8 StarF = 0
u8 SmokeT = 0
u8 MsgT = 0
u8 Menu = 0
u8 Cnt = 0
u8 Jn = 0
u8 Sn = 0
u8 S = 0
u8 I = 0
