data JumpCols bytes 11,7,13,15,3,9
' the six windows (col,row); the first ones show the people still inside
data Windows bytes 6,6, 3,6, 6,10, 3,10, 6,14, 3,14

' ================================================================== program
  tile screen
  ' tile screen shares one 2 KB colour table (R3 = $9F); mode 2 screen gives
  ' each third its own colours, so the street row 22 can be white on black
  mode 2 screen
  set sound table InSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $5EAD
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 1 then
    HelpScreen
    goto title
  end if
  if Menu = 2 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Lives = 3
  Saved = 0
  DrawStreet
  play sound SndStart
  StartMusic

new_round:
  NewRound

play_loop:
  Frame1
  Phase = 1
  ReadPad
  Rnd
  MoveGroup
  Spawner
  for Jn = 0 to MaxJ - 1
    UpdateJumper
  next
  Animate
  update sprites
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 16 at 8,3
  end if
  if EndT > 0 then
    dec EndT
    if EndT = 0 then goto game_over
    goto play_loop
  end if
  if Done >= People then goto round_clear
  goto play_loop

' ------------------------------------------------------------ all safe
round_clear:
  Phase = 0
  play sound SndClear
  fill 32 count 16 at 8,3
  print at 11,3, "ALL SAFE!"
  for Cnt = 1 to 160
    Frame1
    ReadPad
    MoveGroup
    Animate
    update sprites
  next
  fill 32 count 16 at 8,3
  if Level < 99 then inc Level
  goto new_round

' ------------------------------------------------------------ game over
game_over:
  Phase = 0
  StopMusic
  GameOver
  goto title

' ==================================================================== subs

' ------------------------------------------------------------ random
' 16-bit xorshift (7, 9, 8); R2 = its high byte. Stepped every frame on the
' title and in play, so each game is different
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ the street
sub LoadStreetTiles:
  BlankScreen
  fill mode 2 text color with $F0
  ' text on the street (rows 16-23): white on black
  fill $F1 count 1024 to vram.color + 4096
  copy FoPat count FoBytes to vram.pattern + 1024
  copy FoCol count FoBytes to vram.color + 1024
  copy FoPat count FoBytes to vram.pattern + 3072
  copy FoCol count FoBytes to vram.color + 3072
  copy FoPat count FoBytes to vram.pattern + 5120
  copy FoCol count FoBytes to vram.color + 5120
  backdrop dark blue
  cls
  return
end sub

sub DrawStreet:
  LoadStreetTiles
  ' stars
  for K = 0 to NFStars - 1
    J = K << 1
    X = FStars[J]
    inc J
    Y = FStars[J]
    V = K & 1
    V += FoStar0
    put char V at X,Y
  next
  ' the skyline (rows 12-16, columns 10-29)
  for Gy = 0 to SkyH - 1
    V = Gy * SkyW
    J = Gy + 12
    put Skyline + V count SkyW at 10,J
  next
  ' the burning house: columns 2-8, flames on the roof (row 4), parapet
  for Gx = 2 to 8
    V = Gx & 1
    V += FoRoof00
    put char V at Gx,4
    put char FoParapet at Gx,5
    for Gy = 6 to 19
      put char FoBrick at Gx,Gy
    next
  next
  for Wi = 0 to 5
    DrawWindow
  next
  for Gy = 0 to 2
    V = Gy * 3
    V += FoDoor00
    J = Gy + 17
    PutRun(V, 3, 4, J)
  next
  put char FoBalconyw at 8,8
  put char FoBalcony at 9,8
  ' the ambulance, its light on the roof
  for Gy = 0 to 2
    V = Gy * 6
    V += FoAmb00
    J = Gy + 17
    PutRun(V, 6, 24, J)
  next
  put char FoLightoff at 28,16
  ' the street
  fill FoPave count 32 at 0,20
  for Gx = 0 to 31
    V = Gx & 2
    if V = 0 then
      put char FoRoadl at Gx,21
    else
      put char FoBlack at Gx,21
    end if
  next
  fill FoBlack count 32 at 0,22
  fill FoBlack count 32 at 0,23
  ' the group
  FfTgt = 1
  FfCol = GL0 + 4
  for Gx = 9 to 23
    put char FoBlack at Gx,17
    put char FoBlack at Gx,18
    put char FoBlack at Gx,19
  next
  DrawGroup
  ShowScreen
  return
end sub

' window Wi: people inside (while some wait) or flames
sub DrawWindow:
  J = Wi << 1
  Gx = Windows[J]
  inc J
  Gy = Windows[J]
  Wv = People - Spawned
  V = FoFirewin00
  if Wi < Wv then V = FoPerswin00
  put char V at Gx,Gy
  inc V
  J = Gx + 1
  put char V at J,Gy
  inc V
  K = Gy + 1
  put char V at Gx,K
  inc V
  put char V at J,K
  return
end sub

' ------------------------------------------------------------ a new round
sub NewRound:
  ' level settings: more people, a faster jump, a shorter wait
  People = Level + 2
  if People > MaxPeople then People = MaxPeople
  Spd = Level + 7
  if Spd > 24 then Spd = 24
  LedgeW = 64
  V = Level << 2
  if V < 44 then
    LedgeW -= V
  else
    LedgeW = 20
  end if
  ' fairness gaps (frames: one place away NF, two places NF + 8), tighter
  ' each level, turned into path steps: frames * Spd / 16
  ' 26 frames at level 1, 1.5 fewer each level, never under 9 (one place
  ' takes 8 frames to slide)
  V = Level - 1
  if V > 12 then V = 12
  V = V * 3
  V = V >> 1
  Nf = 26 - V
  if Nf < 9 then Nf = 9
  T16 = Spd
  T16 *= Nf
  T16 >>= 4
  Need1 = lowbyte T16
  Nf += 8
  T16 = Spd
  T16 *= Nf
  T16 >>= 4
  Need2 = lowbyte T16
  ' the crouch before a jump (the warning), shorter each level, in frames
  ' and in path steps (its bounces come that much later)
  V = Level - 1
  if V > 14 then V = 14
  CrouchF = 30 - V
  T16 = Spd
  T16 *= CrouchF
  T16 >>= 4
  Cro = lowbyte T16
  Spawned = 0
  Done = 0
  GapT = 40
  EndT = 0
  for J = 0 to MaxJ - 1
    JSt[J] = JFree
    V = J + 2
    hide sprite V
  next
  hide sprite 7
  StarJ = 255
  for J = 0 to MaxPeople - 1
    PState[J] = 0
  next
  for Wi = 0 to 5
    DrawWindow
  next
  DrawHud
  fill 32 count 16 at 8,3
  print at 10,3, "LV    SAVE"
  print Level at 13,3 width 2
  print People at 21,3 width 2
  MsgT = 120
  return
end sub

sub DrawHud:
  ' row 1: the people of this round, then the lives (helmets)
  fill 32 count 18 at 11,1
  for J = 0 to People - 1
    V = FoHpers
    if PState[J] = 1 then V = FoHsaved
    if PState[J] = 2 then V = FoHbump
    K = J + 11
    put char V at K,1
  next
  ShowLives
  ' row 22: level and people saved
  print at 2,22, "LV"
  print Level at 5,22 width 2
  put char FoHcross at 23,22
  ShowSaved
  return
end sub

sub ShowLives:
  fill 32 count 5 at 23,1
  if Lives > 0 then HudIcons(FoHlife, 32, Lives, Lives, 23, 1)
  return
end sub

sub ShowSaved:
  print Saved at 25,22 width 5
  return
end sub

' ------------------------------------------------------------ the stretcher
sub MoveGroup:
  ' a new push moves one place; holding keeps sliding place after place
  V = FfTgt << 2
  V += GL0
  Go = 0
  if Lf1 = 1 then
    if PrevL = 0 then Go = 1
    if FfCol = V then Go = 1
    if Go = 1 then
      if FfTgt > 0 then dec FfTgt
    end if
  end if
  Go = 0
  if Rt1 = 1 then
    if PrevR = 0 then Go = 1
    if FfCol = V then Go = 1
    if Go = 1 then
      if FfTgt < 2 then inc FfTgt
    end if
  end if
  PrevL = Lf1
  PrevR = Rt1
  ' slide one column every other frame
  V = FfTgt << 2
  V += GL0
  if FfCol = V then
    MoveT = 0
    return
  end if
  if MoveT > 0 then
    dec MoveT
    return
  end if
  MoveT = 1
  inc WalkF
  if FfCol < V then
    put char FoBlack at FfCol,17
    put char FoBlack at FfCol,18
    put char FoBlack at FfCol,19
    inc FfCol
  else
    K = FfCol + 6
    put char FoBlack at K,17
    put char FoBlack at K,18
    put char FoBlack at K,19
    dec FfCol
  end if
  DrawGroup
  return
end sub

' the two firefighters and the stretcher at columns FfCol..FfCol+6
sub DrawGroup:
  X = FfCol
  PutRun(FoFfl00, 2, X, 17)
  PutRun(FoFfl10, 2, X, 18)
  ' the gap between them (old firefighter tiles after a slide)
  X += 2
  fill FoBlack count 3 at X,17
  fill FoBlack count 3 at X,19
  X += 3
  PutRun(FoFfr00, 2, X, 17)
  PutRun(FoFfr10, 2, X, 18)
  ' legs: a step while sliding
  X = FfCol
  V = WalkF & 2
  if V = 0 then
    PutRun(FoFfl20, 2, X, 19)
    X += 5
    PutRun(FoFfr20, 2, X, 19)
  else
    PutRun(FoFflw0, 2, X, 19)
    X += 5
    PutRun(FoFfrw0, 2, X, 19)
  end if
  DrawStretcher
  return
end sub

sub DrawStretcher:
  X = FfCol + 2
  V = FoSt0
  if SagT > 0 then V = FoSg0
  PutRun(V, 3, X, 18)
  return
end sub

' ------------------------------------------------------------ people
' one person at a time appears on the balcony, after a short gap
sub Spawner:
  if EndT > 0 then return
  if Spawned >= People then return
  for J = 0 to MaxJ - 1
    if JSt[J] = JLedge then return
  next
  if GapT > 0 then
    dec GapT
    return
  end if
  Fj = 255
  for J = 0 to MaxJ - 1
    if JSt[J] = JFree then Fj = J
  next
  if Fj = 255 then return
  JSt[Fj] = JLedge
  JStage[Fj] = 0
  V = R2 & 15
  V += LedgeW
  JT[Fj] = V
  V = Spawned % 6
  JC[Fj] = JumpCols[V]
  JWho[Fj] = Spawned
  inc Spawned
  play sound SndHelp
  ' one window fewer with people in it
  Wi = People - Spawned
  if Wi < 6 then DrawWindow
  return
end sub

' Ok = 1 if a jump now is fair: none of its bounces (path steps CatchI[K]
' from now) is too close in time to another flyer's bounce at another place
sub FairOK:
  Ok = 1
  for Fj = 0 to MaxJ - 1
    if JSt[Fj] = JAir then
      A = JIdx[Fj]
      M = JStage[Fj]
      while M < 3
        Cm = CatchI[M]
        if Cm >= A then
          Tm = Cm - A
          for K = 0 to 2
            if K <> M then
              Cm = CatchI[K] + Cro
              D = absdiff(Cm, Tm)
              Nd = Need1
              V = absdiff(K, M)
              if V = 2 then Nd = Need2
              if D < Nd then Ok = 0
            end if
          next
          Cm = CatchI[M]
        end if
        inc M
      end while
    end if
  next
  return
end sub

' the person in slot Jn, one frame
sub UpdateJumper:
  S = JSt[Jn]
  Sn = Jn + 2
  if S = JFree then return
  if S = JLedge then
    ' waving on the balcony, then a jump when it is fair
    if JT[Jn] > 0 then dec JT[Jn]
    if JStage[Jn] = 9 then
      ' crouching: the jump is decided, it comes in JT frames
      set sprite Sn to LedgeY,LedgeX,SpSquash,JC[Jn]
      if JT[Jn] = 0 then
        JSt[Jn] = JAir
        JIdx[Jn] = 0
        JAcc[Jn] = 0
        JStage[Jn] = 0
        GapT = 24
        play sound SndJump
      end if
      return
    end if
    K = SpWave0
    V = Tick & 16
    if V <> 0 then K = SpWave1
    set sprite Sn to LedgeY,LedgeX,K,JC[Jn]
    if JT[Jn] = 0 then
      if EndT = 0 then
        FairOK
        if Ok = 1 then
          JStage[Jn] = 9
          JT[Jn] = CrouchF
        end if
      end if
    end if
    return
  end if
  if S = JAir then
    A = JAcc[Jn] + Spd
    I = JIdx[Jn]
    while A >= 16
      A -= 16
      inc I
    end while
    JAcc[Jn] = A
    M = JStage[Jn]
    if M < 3 then
      Cm = CatchI[M]
      if I >= Cm then
        I = Cm
        JIdx[Jn] = I
        ' is the stretcher there?
        V = M << 2
        V += GL0
        if FfCol = V then
          Bounce
        else
          JSt[Jn] = JMiss
          JX[Jn] = PathX[I]
          JY[Jn] = CatchY
          play sound SndFall
          return
        end if
      end if
    end if
    if I >= PathEnd then
      SaveOne
      return
    end if
    JIdx[Jn] = I
    X = PathX[I]
    Y = PathY[I]
    if JT[Jn] > 0 then
      dec JT[Jn]
      K = SpSquash
    else
      K = I >> 2
      K = K & 3
      K = K << 2
      K += SpTumble0
    end if
    set sprite Sn to Y,X,K,JC[Jn]
    return
  end if
  if S = JMiss then
    ' falling past the stretcher: still caught if it arrives in time
    Y = JY[Jn] + 3
    M = JStage[Jn]
    V = M << 2
    V += GL0
    if FfCol = V then
      V = CatchY + 9
      if Y < V then
        JSt[Jn] = JAir
        Bounce
        return
      end if
    end if
    if Y >= GroundY then
      Y = GroundY
      JSt[Jn] = JBump
      JT[Jn] = 80
      LoseLife
    end if
    JY[Jn] = Y
    X = JX[Jn]
    K = Tick >> 2
    K = K & 3
    K = K << 2
    K += SpTumble0
    set sprite Sn to Y,X,K,JC[Jn]
    return
  end if
  X = JX[Jn]
  if S = JBump then
    ' sitting on the pavement, dizzy stars around the head
    set sprite Sn to GroundY,X,SpSit,JC[Jn]
    if StarJ = 255 then StarJ = Jn
    if StarJ = Jn then
      K = SpStars0
      V = Tick & 8
      if V <> 0 then K = SpStars1
      Y = GroundY - 6
      set sprite 7 to Y,X,K,11
    end if
    dec JT[Jn]
    if JT[Jn] = 0 then
      JSt[Jn] = JWalk
      if StarJ = Jn then
        StarJ = 255
        hide sprite 7
      end if
    end if
    return
  end if
  ' JWalk: off to the ambulance, rubbing the bump
  V = Tick & 1
  if V = 0 then inc X
  JX[Jn] = X
  K = SpWalk0
  V = Tick & 8
  if V <> 0 then K = SpWalk1
  set sprite Sn to GroundY,X,K,JC[Jn]
  if X >= AmbX then
    JSt[Jn] = JFree
    hide sprite Sn
    inc Done
  end if
  return
end sub

sub Bounce:
  inc JStage[Jn]
  JT[Jn] = 6
  SagT = 8
  DrawStretcher
  play sound SndBoing
  return
end sub

sub SaveOne:
  JSt[Jn] = JFree
  hide sprite Sn
  inc Done
  inc Saved
  V = JWho[Jn]
  PState[V] = 1
  K = V + 11
  put char FoHsaved at K,1
  ShowSaved
  play sound SndDing
  ' one more life every 50 saved
  V = Saved % 50
  if V = 0 then
    if Lives < MaxLives then
      inc Lives
      ShowLives
      play sound SndLife
    end if
  end if
  return
end sub

sub LoseLife:
  play sound SndBonk
  V = JWho[Jn]
  PState[V] = 2
  K = V + 11
  put char FoHbump at K,1
  if Lives > 0 then dec Lives
  ShowLives
  if Lives = 0 then
    if EndT = 0 then EndT = 100
  end if
  return
end sub

' ------------------------------------------------------------ animation
' every frame of play: flames, people at the windows, the ambulance light,
' twinkling stars, smoke from the roof, the stretcher springing back
sub Animate:
  V = Tick & 7
  if V = 0 then
    inc FireF
    if FireF >= 3 then FireF = 0
    K = FireF << 5
    copy AnFireP + K count 32 to vram.pattern + FoFireV0
    copy AnFireC + K count 32 to vram.color + FoFireV0
    copy AnFireP + K count 32 to vram.pattern + FoFireV1
    copy AnFireC + K count 32 to vram.color + FoFireV1
  end if
  if V = 4 then
    K = FireF << 4
    copy AnRoofP + K count 16 to vram.pattern + FoRoofV0
    copy AnRoofC + K count 16 to vram.color + FoRoofV0
  end if
  V = Tick & 15
  if V = 10 then
    PersF = PersF ^ 32
    copy AnPersP + PersF count 32 to vram.pattern + FoPersV0
    copy AnPersC + PersF count 32 to vram.color + FoPersV0
    copy AnPersP + PersF count 32 to vram.pattern + FoPersV1
    copy AnPersC + PersF count 32 to vram.color + FoPersV1
  end if
  ' the ambulance light: 2 Hz
  V = Tick & 15
  if V = 6 then
    LightF = LightF ^ 1
    V = FoLightoff
    if LightF = 1 then V = FoLighton
    put char V at 28,16
  end if
  ' stars twinkle (about once a second)
  V = Tick & 63
  if V = 30 then
    StarF = StarF ^ 8
    copy AnStar + StarF count 8 to vram.pattern + FoStarV0
    copy AnStar + StarF count 8 to vram.pattern + FoStarV1
  end if
  ' two puffs of smoke rising from the roof, half a cycle apart
  inc SmokeT
  if SmokeT >= 96 then SmokeT = 0
  Tv = SmokeT
  Sn = 0
  SmokePuff
  Tv = SmokeT + 48
  if Tv >= 96 then Tv -= 96
  Sn = 1
  SmokePuff
  ' the stretcher springs back
  if SagT > 0 then
    dec SagT
    if SagT = 0 then DrawStretcher
  end if
  return
end sub

' one puff (sprite Sn) at age Tv (0-95): rises, grows, drifts right
sub SmokePuff:
  V = Tv >> 5
  V = V << 2
  V += SpPuff0
  Y = Tv >> 2
  Y = 30 - Y
  X = Tv >> 2
  X += 22
  if Sn = 1 then X += 14
  set sprite Sn to Y,X,V,14
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  ' a brick panel in the sky, cols 9-22, rows 6-12: one blank row above,
  ' between and below the lines
  for Gx = 9 to 22
    put char FoBrick at Gx,6
    put char FoBrick at Gx,12
  next
  for Gy = 7 to 11
    put char FoBrick at 9,Gy
    put char FoBrick at 22,Gy
    fill 32 count 12 at 10,Gy
  next
  print at 11,8, "GAME OVER"
  print at 11,10, "LV"
  print Level at 13,10 width 2
  put char FoHcross at 16,10
  print Saved at 17,10 width 4
  ' people on the ground stay; the flyers above the panel are hidden
  for J = 0 to MaxJ - 1
    if JSt[J] < JMiss then
      V = J + 2
      hide sprite V
    end if
  next
  update sprites
  play sound SndOver
  for Cnt = 1 to 150
    Frame1
    Animate
    update sprites
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

sub CreditsScreen:
  LoadStreetTiles
  fill $F0 count 1024 to vram.color + 4096
  PageCredits
  ' the house, the firefighters, the ambulance under the text
  WaitPage
  return
end sub

sub HelpScreen:
  LoadStreetTiles
  fill $F0 count 1024 to vram.color + 4096
  PageHelp
  ' a little scene: the house, a jumper above the stretcher, the ambulance
  for Gy = 9 to 12
    put char FoBrick at 3,Gy
    put char FoBrick at 4,Gy
  next
  put char FoRoof00 at 3,8
  put char FoRoof01 at 4,8
  PutRun(FoFfl00, 2, 10, 10)
  PutRun(FoFfl10, 2, 10, 11)
  PutRun(FoFfl20, 2, 10, 12)
  PutRun(FoSt0, 3, 12, 11)
  PutRun(FoFfr00, 2, 15, 10)
  PutRun(FoFfr10, 2, 15, 11)
  PutRun(FoFfr20, 2, 15, 12)
  put char FoBlack at 12,10
  put char FoBlack at 13,10
  put char FoBlack at 14,10
  put char FoBlack at 12,12
  put char FoBlack at 13,12
  put char FoBlack at 14,12
  PutRun(FoAmb00, 6, 21, 10)
  PutRun(FoAmb10, 6, 21, 11)
  PutRun(FoAmb20, 6, 21, 12)
  put char FoStick at 3,14
  put char FoHpers at 3,15
  put char FoHsaved at 3,16
  put char FoHbump at 3,17
  put char FoHlife at 3,19
  ShowScreen
  set sprite 2 to 66,100,SpTumble1,11
  set sprite 3 to 72,42,SpWave0,13
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  fill mode 2 text color with $F0
  copy TiPat count TiBytes to vram.pattern + 1024
  copy TiCol count TiBytes to vram.color + 1024
  copy TiPat count TiBytes to vram.pattern + 3072
  copy TiCol count TiBytes to vram.color + 3072
  backdrop dark blue
  cls
  for K = 0 to NTStars - 1
    J = K << 1
    X = TStars[J]
    inc J
    Y = TStars[J]
    V = K & 1
    V += TiStar0
    put char V at X,Y
  next
  for Y = 0 to LogoH - 1
    V = Y * LogoW
    J = Y + 2
    put Logo + V count LogoW at 4,J
  next
  ' the house (cols 2-7, rows 7-13), the group, the ambulance, the street
  for Gx = 2 to 7
    V = Gx & 1
    V += TiRoof00
    put char V at Gx,7
    put char TiParapet at Gx,8
    for Gy = 9 to 13
      put char TiBrick at Gx,Gy
    next
  next
  PutRun(TiFirewin00, 2, 3, 9)
  PutRun(TiFirewin10, 2, 3, 10)
  PutRun(TiFirewin00, 2, 6, 9)
  PutRun(TiFirewin10, 2, 6, 10)
  put char TiBalconyw at 7,11
  put char TiBalcony at 8,11
  PutRun(TiFfl00, 2, 12, 11)
  PutRun(TiFfl10, 2, 12, 12)
  PutRun(TiFfl20, 2, 12, 13)
  PutRun(TiSt0, 3, 14, 12)
  PutRun(TiFfr00, 2, 17, 11)
  PutRun(TiFfr10, 2, 17, 12)
  PutRun(TiFfr20, 2, 17, 13)
  fill TiBlack count 3 at 14,11
  fill TiBlack count 3 at 14,13
  PutRun(TiAmb00, 6, 23, 11)
  PutRun(TiAmb10, 6, 23, 12)
  PutRun(TiAmb20, 6, 23, 13)
  put char TiLightoff at 27,10
  fill TiPave count 32 at 0,14
  fill TiBlack count 32 at 0,15
  fill TiBlack count 10 at 8,13
  fill TiBlack count 4 at 19,13
  fill TiBlack count 3 at 9,11
  fill TiBlack count 3 at 9,12
  fill TiBlack count 3 at 20,11
  fill TiBlack count 3 at 20,12
  fill TiBlack count 2 at 29,11
  fill TiBlack count 2 at 29,12
  fill TiBlack count 2 at 29,13
  fill TiBlack count 2 at 0,13
  ' menu (rows 16-20)
  print at 11,16, "START"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 2 then Menu = 0
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

' title sprites: the flame cursor (0), a jumper tumbling on the stretcher
' (1), a person waving on the balcony (2)
sub TitleAnim:
  inc Cnt
  V = Menu << 4
  V += 122
  K = SpFlame0
  Y = Cnt & 16
  if Y <> 0 then K = SpFlame1
  set sprite 0 to V,68,K,8
  ' the bouncing jumper: 40-frame cycle, squashed on the canvas
  V = Cnt % 40
  Y = TBounce[V]
  K = V >> 2
  K = K & 3
  K = K << 2
  K += SpTumble0
  if V < 3 then K = SpSquash
  if V > 37 then K = SpSquash
  set sprite 1 to Y,116,K,11
  ' the stretcher gives a little under the landing
  if V = 38 then PutRun(TiSg0, 3, 14, 12)
  if V = 3 then PutRun(TiSt0, 3, 14, 12)
  K = SpWave0
  V = Cnt & 16
  if V <> 0 then K = SpWave1
  set sprite 2 to 72,62,K,13
  update sprites
  ' flames, light, stars
  V = Cnt & 7
  if V = 0 then
    inc FireF
    if FireF >= 3 then FireF = 0
    K = FireF << 5
    copy AnFireP + K count 32 to vram.pattern + TiFireV1
    copy AnFireC + K count 32 to vram.color + TiFireV1
  end if
  if V = 4 then
    K = FireF << 4
    copy AnRoofP + K count 16 to vram.pattern + TiRoofV0
    copy AnRoofC + K count 16 to vram.color + TiRoofV0
  end if
  V = Cnt & 15
  if V = 6 then
    LightF = LightF ^ 1
    V = TiLightoff
    if LightF = 1 then V = TiLighton
    put char V at 27,10
  end if
  V = Cnt & 63
  if V = 30 then
    StarF = StarF ^ 8
    copy AnStar + StarF count 8 to vram.pattern + TiStarV0
  end if
  return
end sub

' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 12,2, "INCENDIE"
  print at 8,5, "ORIGINAL GAME BY"
  print at 6,7, "JEAN-FRANCOIS SEHAN"
  print at 7,9, "L'ORIC A L'AFFICHE"
  print at 3,10, "EDITIONS DU P.S.I. (1984)"
  print at 6,13, "COLECOVISION VERSION"
  print at 7,15, "AMY & CLAUDE 2026"
  print at 2,17, "MADE IN AMY WITH AMY STUDIO"
  print at 9,21, "PRESS A BUTTON"
  return
end sub

sub PageHelp:
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "THE HOUSE IS ON FIRE! CATCH"
  print at 2,4, "THE PEOPLE WHO JUMP WITH THE"
  print at 2,5, "STRETCHER: EACH ONE BOUNCES"
  print at 2,6, "THREE TIMES, THEN LANDS IN"
  print at 2,7, "THE AMBULANCE."
  print at 5,14, "LEFT / RIGHT: MOVE"
  print at 5,15, "PEOPLE TO SAVE THIS LEVEL"
  print at 5,16, "SAVED"
  print at 5,17, "MISSED: A BUMP (NO HARM),"
  print at 5,18, "BUT IT COSTS A HELMET"
  print at 5,19, "HELMETS: YOUR LIVES"
  print at 2,20, "50 SAVED: ONE MORE HELMET."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

