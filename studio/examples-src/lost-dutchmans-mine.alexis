; DmSetup: R3 = $FF (each screen third its own colour table) and names
; 0..255 in order on rows 0-7 (the picture)
DmSetup:
    ld bc,$03FF
    call WRITE_REGISTER
    ld hl,$1800
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    xor a
    ld b,0
ShSu1:
    out ($BE),a
    inc a
    nop
    nop
    djnz ShSu1
    ret
