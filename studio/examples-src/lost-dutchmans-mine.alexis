data PicPatTab words = @DmPicP0, @DmPicP1, @DmPicP2, @DmPicP3, @DmPicP4, @DmPicP5, @DmPicP6, @DmPicP7, @DmPicP8, @DmPicP9, @DmPicP10, @DmPicP11, @DmPicP12, @DmPicP13
data PicColTab words = @DmPicC0, @DmPicC1, @DmPicC2, @DmPicC3, @DmPicC4, @DmPicC5, @DmPicC6, @DmPicC7, @DmPicC8, @DmPicC9, @DmPicC10, @DmPicC11, @DmPicC12, @DmPicC13

' ShowPic: picture Pic in the top screen third (display off: the ZX0
' decoder reads VRAM back). Called with the NMI off.
sub ShowPic:
  display off
  decompress zx0 PicPatTab[Pic] to vram.pattern
  decompress zx0 PicColTab[Pic] to vram.color
  Shown = Pic
  return
end sub

