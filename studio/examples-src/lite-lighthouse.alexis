cartridge "LIGHTHOUSE/AMY BIENVENU/2026"

' LIGHTHOUSE - an original night watch for the ColecoVision.
'
' Ships cross the dark sea from either side. Rocks lie in their way, and
' a ship only sees a rock while your beam is on it (and a moment after):
' then it steers round it, up or down a lane. A ship that meets an unseen rock is wrecked.
' Turn the lamp with the joystick and light the way for every ship. Five
' nights, each busier than the last; three wrecks in a night and the
' harbour master sends you home.
'
' House rules: joystick and button only; text in columns 2-29, rows 1-22;
' tiles from code 128 (art.py); an original tune played once (tune.py);
' the frame loop keeps the NMI off outside the wait (Frame1).
'
' Screen: row 1 the counters, rows 2-18 the sea (one tile a cell, kept in
' the name table: lite.asm), rows 17-21 the lighthouse and its rock, row
' 22 news. Sprites are 8 x 8: the ships.

const TSea = 128
const TSeal = 129
const TRockh = 130
const TRockl = 131
const TLand = 132
const TShore = 133
const TTower00 = 134
const TTower01 = 135
const TTower10 = 136
const TTower11 = 137
const TTower20 = 138
const TTower21 = 139
const TLamp = 140
const SShipR = 0
const SShipL = 4
const SWreck = 8
const SBubble = 12
const NTiles8 = 104
const SprBytes = 128
const SndHush = 1
const SndTick = 2
const SndHorn = 3
const SndTurn = 4
const SndSafe = 5
const SndCrash = 6
const SndWin = 7
const SndLose = 8
const SndTuneA = 9
const SndTuneB = 10
data RayC bytes 14,16,14,17,14,18,13,17,13,16,12,17,12,16,11,17,11,16,10,17,10,16,9,17,9,16,8,17,8,16,7,17,7,16,6,17,6,16,5,17,5,15,5,16,4,17,4,15,4,16,3,17,3,15,3,16,2,16,2,15,14,16,14,17,13,17,13,16,12,17,12,16,11,17,11,15,11,16,10,17,10,15,10,16,9,16,9,15,8,15,8,16,7,15,7,16,7,14,6,15,6,16,6,14,5,15,5,14,4,15,4,14,3,15,3,14,2,15,2,14,2,13,15,16,14,17,14,16,13,17,13,16,13,15,12,17,12,16,12,15,11,16,11,15,10,16,10,15,10,14,9,16,9,15,9,14,8,15,8,14,7,14,7,15,7,13,6,14,6,13,5,14,5,13,4,14,4,13,4,12,3,13,3,12,2,13,2,12,2,11,15,16,14,16,14,17,13,17,14,15,13,16,13,15,12,16,12,15,11,16,12,14,11,15,11,14,10,15,10,14,9,15,10,13,9,14,9,13,8,14,8,13,7,14,8,12,7,13,7,12,6,13,6,12,5,13,6,11,5,12,5,11,4,12,4,11,3,12,4,10,3,11,3,10,2,11,2,10,2,9,15,16,14,16,14,17,14,15,13,16,13,15,12,16,13,14,12,15,12,14,11,15,11,14,11,13,10,14,10,13,9,14,10,12,9,13,9,12,8,13,8,12,8,11,7,12,7,11,6,12,7,10,6,11,6,10,5,11,5,10,5,9,4,10,4,9,3,10,3,9,4,8,3,8,2,9,2,8,2,7,15,16,14,17,14,16,15,15,14,15,13,16,13,15,13,14,12,15,12,14,12,13,11,14,11,13,11,12,10,13,10,12,9,13,10,11,9,12,9,11,8,12,8,11,9,10,8,10,7,11,7,10,8,9,7,9,6,10,6,9,6,8,5,9,5,8,5,7,4,8,4,7,3,8,4,6,3,7,3,6,2,7,2,6,3,5,2,5,2,4,15,16,14,17,15,15,14,16,14,15,13,16,13,15,14,14,13,14,12,14,13,13,12,13,11,14,11,13,12,12,11,12,10,12,11,11,10,11,10,10,9,11,9,10,9,9,8,10,8,9,9,8,8,8,7,9,7,8,8,7,7,7,6,8,6,7,7,6,6,6,5,7,5,6,6,5,5,5,4,6,4,5,5,4,4,4,3,5,4,3,3,4,3,3,2,4,2,3,3,2,2,2,15,16,14,16,15,15,14,15,14,14,13,15,13,14,14,13,13,13,12,14,12,13,13,12,12,12,11,12,12,11,11,11,12,10,10,11,11,10,10,10,11,9,10,9,9,10,9,9,10,8,9,8,9,7,8,8,8,7,9,6,8,6,7,7,7,6,8,5,7,5,6,5,7,4,6,4,7,3,6,3,5,4,5,3,6,2,5,2,4,2,15,16,14,16,15,15,14,15,15,14,14,14,13,14,14,13,13,13,14,12,13,12,12,13,12,12,13,11,12,11,13,10,12,10,11,11,11,10,12,9,11,9,12,8,10,9,11,8,10,8,11,7,10,7,9,7,10,6,9,6,10,5,9,5,8,5,9,4,8,4,9,3,8,3,7,3,8,2,7,2,16,16,15,16,14,16,16,15,15,15,14,15,15,14,14,14,15,13,14,13,13,13,14,12,13,12,14,11,13,11,14,10,12,11,13,10,12,10,13,9,12,9,13,8,12,8,11,8,12,7,11,7,12,6,11,6,12,5,10,6,11,5,10,5,11,4,10,4,11,3,10,3,9,3,10,2,9,2,16,16,15,16,16,15,15,15,14,15,15,14,14,14,15,13,14,13,15,12,14,12,15,11,14,11,13,12,13,11,14,10,13,10,14,9,13,9,14,8,13,8,14,7,13,7,12,7,13,6,12,6,13,5,12,5,13,4,12,4,13,3,12,3,11,4,11,3,12,2,11,2,16,16,15,16,16,15,15,15,16,14,15,14,14,14,16,13,15,13,14,13,16,12,15,12,14,12,15,11,14,11,15,10,14,10,15,9,14,9,15,8,14,8,15,7,14,7,15,6,14,6,13,6,15,5,14,5,13,5,15,4,14,4,13,4,14,3,13,3,14,2,13,2,16,16,15,16,16,15,15,15,16,14,15,14,16,13,15,13,16,12,15,12,16,11,15,11,16,10,15,10,16,9,15,9,16,8,15,8,16,7,15,7,16,6,15,6,16,5,15,5,16,4,15,4,16,3,15,3,16,2,15,2,16,16,15,16,15,15,16,15,15,14,16,14,17,14,15,13,17,13,16,13,15,12,17,12,16,12,16,11,17,11,16,10,17,10,16,9,17,9,16,8,17,8,16,7,17,7,17,6,16,6,18,6,18,5,17,5,16,5,18,4,17,4,16,4,18,3,17,3,18,2,17,2,16,16,15,16,15,15,17,15,16,15,16,14,17,14,16,13,17,13,16,12,17,12,18,12,17,11,16,11,18,11,17,10,18,10,17,9,18,9,17,8,18,8,17,7,19,7,18,7,18,6,19,6,18,5,19,5,18,4,19,4,20,4,19,3,18,3,20,3,19,2,20,2,17,16,16,16,15,16,15,15,16,15,17,15,16,14,17,14,16,13,18,13,17,13,17,12,18,12,17,11,18,11,19,11,17,10,18,10,19,10,18,9,19,9,18,8,19,8,20,8,19,7,20,7,19,6,20,6,21,6,19,5,20,5,21,5,20,4,21,4,20,3,21,3,22,3,21,2,22,2,17,16,16,16,16,15,17,15,16,14,17,14,18,14,17,13,18,13,17,12,19,13,18,12,19,12,18,11,19,11,18,10,20,11,19,10,20,10,19,9,20,9,21,9,19,8,20,8,21,8,20,7,21,7,22,7,21,6,22,6,21,5,22,5,23,5,22,4,23,4,22,3,23,3,24,3,23,2,24,2,17,16,16,16,16,15,17,15,18,15,17,14,18,14,17,13,19,14,18,13,19,13,18,12,19,12,20,12,19,11,20,11,21,11,19,10,20,10,21,10,20,9,21,9,22,10,22,9,21,8,22,8,23,8,22,7,23,7,22,6,24,7,23,6,24,6,23,5,24,5,25,5,24,4,25,4,24,3,26,4,25,3,26,3,25,2,26,2,27,2,17,17,16,16,17,16,16,15,17,15,18,16,18,15,17,14,18,14,19,14,18,13,19,13,20,14,20,13,19,12,20,12,21,12,20,11,21,11,22,11,21,10,22,10,23,10,22,9,23,9,22,8,24,9,23,8,24,8,23,7,25,8,24,7,25,7,24,6,26,7,25,6,26,6,25,5,26,5,27,6,27,5,26,4,27,4,28,5,28,4,27,3,28,3,29,4,29,3,28,2,29,2,17,17,16,16,17,16,16,15,17,15,18,16,18,15,18,14,19,15,19,14,20,14,19,13,20,13,21,13,20,12,21,12,22,13,22,12,21,11,22,11,23,12,23,11,22,10,23,10,24,11,24,10,23,9,24,9,25,10,25,9,25,8,26,9,26,8,27,8,26,7,27,7,28,8,28,7,27,6,28,6,29,7,29,6,28,5,29,5,29,4,17,17,17,16,16,16,18,16,17,15,18,15,19,16,19,15,18,14,19,14,20,15,20,14,20,13,21,14,21,13,22,14,22,13,21,12,22,12,23,13,23,12,24,12,23,11,24,11,25,12,25,11,24,10,25,10,26,11,26,10,26,9,27,10,27,9,28,10,28,9,27,8,28,8,29,9,29,8,29,7,17,17,17,16,16,16,18,17,18,16,17,15,18,15,19,16,19,15,20,16,20,15,19,14,20,14,21,15,21,14,22,15,22,14,21,13,22,13,23,14,23,13,24,14,24,13,23,12,24,12,25,13,25,12,26,13,26,12,25,11,26,11,27,12,27,11,28,12,28,11,27,10,28,10,29,11,29,10,29,9,17,17,16,16,17,16,18,17,18,16,19,17,18,15,19,16,19,15,20,16,20,15,21,16,21,15,21,14,22,16,22,15,22,14,23,15,23,14,24,15,24,14,24,13,25,14,25,13,26,14,26,13,27,14,27,13,27,12,28,13,28,12,29,13,29,12,29,11,17,17,17,16,18,17,18,16,19,17,19,16,20,17,20,16,20,15,21,17,21,16,21,15,22,16,22,15,23,16,23,15,24,16,24,15,25,16,25,15,24,14,25,14,26,15,26,14,27,15,27,14,28,15,28,14,29,15,29,14,29,13,17,18,17,17,17,16,18,17,18,16,19,17,19,16,20,17,20,16,21,17,21,16,22,17,22,16,23,17,23,16,24,17,24,16,25,17,25,16,26,17,26,16,26,15,27,17,27,16,27,15,28,17,28,16,28,15,29,16,29,15
data RayAt words 0,60,122,190,270,350,440,542,632,712,790,862,934,994,1066,1138,1216,1296,1386,1488,1578,1658,1738,1806,1868
data RayLen bytes 30,31,34,40,40,45,51,45,40,39,36,36,30,36,36,39,40,45,51,45,40,40,34,31,30
const NDir = 25
data TitleXY bytes 6,2,6,3,6,4,6,5,6,6,7,6,8,6,10,2,11,2,12,2,11,3,11,4,11,5,10,6,11,6,12,6,14,2,15,2,16,2,14,3,14,4,16,4,14,5,16,5,14,6,15,6,16,6,18,2,20,2,18,3,20,3,18,4,19,4,20,4,18,5,20,5,18,6,20,6,22,2,23,2,24,2,23,3,23,4,23,5,23,6,6,8,8,8,6,9,8,9,6,10,7,10,8,10,6,11,8,11,6,12,8,12,10,8,11,8,12,8,10,9,12,9,10,10,12,10,10,11,12,11,10,12,11,12,12,12,14,8,16,8,14,9,16,9,14,10,16,10,14,11,16,11,14,12,15,12,16,12,18,8,19,8,20,8,18,9,18,10,19,10,20,10,20,11,18,12,19,12,20,12,22,8,23,8,24,8,22,9,22,10,23,10,22,11,22,12,23,12,24,12,255

const NShip = 5

' the ships (VS 0 none, 1 sailing, 2 changing lane, 4 a wreck)
u8 VX[5]
u8 VY[5]
u8 VD[5]
u8 VS[5]
u8 VT[5]
u8 VF[5]

u8 Tx = 0
u8 Ty = 0
u8 Tt = 0
u16 RayP = 0
u8 RayN = 0
u8 LMode = 0
u8 Dir = 12
u8 TurnT = 0

u8 Night = 0
u8 NShips = 0
u8 Spd = 0
u8 Gap = 0
u8 Sent = 0
u8 Safe = 0
u8 Wrecks = 0
u8 Afloat = 0
u8 SpT = 0
u8 HudOn = 0
u16 Total = 0
u16 Rnd = 2468
u8 RndB = 0

u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Sel = 0
u8 Tick = 0
u8 Busy = 0

' scratch: never kept across a sub call
u16 W16 = 0
u16 W2 = 0
u8 I = 0
u8 J = 0
u8 C = 0
u8 K = 0
u8 V = 0
u8 V2 = 0
u8 X = 0
u8 Y = 0
u8 Col = 0
u8 Row = 0
u8 Nr = 0
u8 Ok = 0
u8 N = 0
u8 Q = 0
u8 Na = 0
u8 Rot = 0
u8 Ord[5]
' the rocks, and how long each has glowed since it was last checked
u8 RkX[20]
u8 RkY[20]
u8 RkT[20]
u8 NRk = 0

' each night: ships, speed (16ths of a pixel a frame), the gap between
' ships (pairs of frames), rocks
data NightShips bytes 8, 10, 12, 14, 16
data NightSpd bytes 5, 6, 7, 8, 9
data NightGap bytes 200, 170, 150, 130, 110
data NightRocks bytes 8, 11, 14, 17, 20

  tile screen
  set sound table LhSoundTable areas 4
  sprites 8x8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    HowToPage
    goto title
  end if
  if Sel = 2 then
    CreditsPage
    goto title
  end if
  Night = 0
  Total = 0

night_start:
  NightPage
  StartNight

play_loop:
  Frame1
  Busy = 1
  ReadPad
  Lamp
  Fade
  Spawn
  for I = 0 to NShip - 1
    if VS[I] > 0 then Sail
  next
  ShowSprites
  if HudOn = 1 then
    HudOn = 0
    ShowHud
  end if
  Busy = 0
  if Wrecks >= 3 then goto night_lost
  if Sent < NShips then goto play_loop
  if Afloat > 0 then goto play_loop

  ' every ship is through
  HideSprites
  play sound SndWin
  fill 32 count 28 at 2,22
  print at 6,22, "DAWN. A QUIET NIGHT."
  Hold(150)
  inc Night
  if Night < 5 then goto night_start
  EndPage
  goto title

night_lost:
  Hold(40)
  HideSprites
  play sound SndLose
  fill 32 count 28 at 2,22
  print at 5,22, "THREE WRECKS: TRY AGAIN"
  Hold(170)
  goto night_start

' ---------------------------------------------------------------------------
' the sea

sub StartNight:
  NewScreen
  backdrop dark blue
  for Ty = 2 to 18
    for Tx = 2 to 29
      Tt = TSea
      PutT
    next
  next
  for Tx = 2 to 29
    Ty = 19
    Tt = TShore
    PutT
    Ty = 20
    Tt = TLand
    PutT
    Ty = 21
    PutT
  next
  ' the tower, on its rock
  put char TTower00 at 15,17
  put char TTower01 at 16,17
  put char TTower10 at 15,18
  put char TTower11 at 16,18
  put char TTower20 at 15,19
  put char TTower21 at 16,19
  ' the rocks, away from the edges where ships come in
  N = NightRocks[Night]
  K = 0
  for J = 1 to 60
    if K < N then
      NextRnd
      V = RndB & 15
      Tx = V + 8
      NextRnd
      V = RndB & 15
      if V < 14 then
        Ty = V + 3
        GetT
        if Tt = TSea then
          Tt = TRockh
          PutT
          RkX[K] = Tx
          RkY[K] = Ty
          RkT[K] = 0
          inc K
        end if
      end if
    end if
  next
  NRk = K
  NShips = NightShips[Night]
  Spd = NightSpd[Night]
  Gap = NightGap[Night]
  Sent = 0
  Safe = 0
  Wrecks = 0
  Afloat = 0
  SpT = 30
  for I = 0 to NShip - 1
    VS[I] = 0
  next
  Dir = 12
  LightRay
  ShowHud
  fill 32 count 28 at 2,22
  ShowScreen
  WaitStick
  return
end sub

sub GetT:
  asm {
    call LhGet
  }
  return
end sub

sub PutT:
  asm {
    call LhPut
  }
  return
end sub

' LightRay / DarkRay: the beam at Dir lit or put out
sub LightRay:
  LMode = 1
  Ray
  return
end sub

sub DarkRay:
  LMode = 0
  Ray
  return
end sub

sub Ray:
  RayP = RayAt[Dir]
  RayN = RayLen[Dir]
  asm {
    call LhRay
  }
  return
end sub

' Fade: a rock the beam has left glows a second and a half, then goes
' dark (a few rocks a frame are looked at)
sub Fade:
  if NRk = 0 then return
  K = Tick & 3
fd_loop:
  if K < NRk then
    Tx = RkX[K]
    Ty = RkY[K]
    GetT
    if Tt = TRockl then
      V = RkT[K] + 4
      RkT[K] = V
      if V >= 90 then
        RkT[K] = 0
        ' still in the beam?
        Ok = 0
        RayN = RayLen[Dir]
        W16 = RayAt[Dir]
        for J = 1 to RayN
          V = RayC[W16]
          if V = Tx then
            V = RayC[W16 + 1]
            if V = Ty then Ok = 1
          end if
          W16 = W16 + 2
        next
        if Ok = 0 then
          Tt = TRockh
          PutT
        end if
      end if
    end if
    K = K + 4
    goto fd_loop
  end if
  return
end sub

' Lamp: the stick turns the beam, a step every three frames held
sub Lamp:
  V = Lf1 | Rt1
  if V = 0 then
    TurnT = 0
    return
  end if
  if TurnT > 0 then
    dec TurnT
    return
  end if
  TurnT = 3
  if Lf1 = 1 then
    if Dir = 0 then return
    DarkRay
    dec Dir
    LightRay
    return
  end if
  if Dir >= NDir - 1 then return
  DarkRay
  inc Dir
  LightRay
  return
end sub

' Spawn: the next ship, from a side, in a lane
sub Spawn:
  if Sent >= NShips then return
  if SpT > 0 then
    V = Tick & 1
    if V = 0 then dec SpT
    return
  end if
  N = 255
  for J = 0 to NShip - 1
    if N = 255 then
      if VS[J] = 0 then N = J
    end if
  next
  if N = 255 then
    SpT = 20
    return
  end if
  NextRnd
  V = RndB & 15
  if V > 13 then V = V - 8
  Row = V + 3
  NextRnd
  V = RndB & 1
  VD[N] = V
  if V = 0 then
    VX[N] = 8
  else
    VX[N] = 240
  end if
  VY[N] = Row * 8
  VS[N] = 1
  VF[N] = 0
  inc Sent
  SpT = Gap
  HudOn = 1
  play sound SndHorn
  return
end sub

' Sail: ship I on: across by its speed, into a new lane when changing,
' round the rocks it can see, and wrecked on the ones it cannot
sub Sail:
  if VS[I] = 4 then
    V = VT[I] + 1
    VT[I] = V
    if V >= 40 then VS[I] = 0
    return
  end if
  X = VX[I]
  Y = VY[I]
  if VS[I] = 2 then
    V = VT[I]
    if Y < V then
      inc Y
    else
      if Y > V then
        dec Y
      else
        VS[I] = 1
      end if
    end if
    VY[I] = Y
  end if
  V = VF[I] + Spd
  if V < 16 then
    VF[I] = V
    return
  end if
  VF[I] = V - 16
  if VD[I] = 0 then
    inc X
  else
    dec X
  end if
  VX[I] = X
  ' through?
  Ok = 0
  if X >= 244 then Ok = 1
  if X <= 4 then Ok = 1
  if Ok = 1 then
    VS[I] = 0
    inc Safe
    inc Total
    HudOn = 1
    play sound SndSafe
    return
  end if
  ' on a rock?
  V = X + 4
  Tx = V >> 3
  V = Y + 4
  Ty = V >> 3
  GetT
  if Tt = TRockh then
    Wreck
    return
  end if
  if Tt = TRockl then
    Wreck
    return
  end if
  ' a lit rock ahead in the lane (looked for on each whole cell)
  if VS[I] <> 1 then return
  V = X & 7
  if V <> 0 then return
  Col = X >> 3
  Row = Y >> 3
  Ok = 0
  for J = 1 to 4
    if VD[I] = 0 then
      Tx = Col + J
    else
      Tx = Col - J
    end if
    Ty = Row
    GetT
    if Tt = TRockl then Ok = 1
  next
  if Ok = 0 then return
  ' up a lane if it looks clear, else down
  Nr = Row - 1
  if Row <= 3 then Nr = Row + 1
  LaneClear
  if Ok = 0 then
    if Row >= 16 then return
    Nr = Row + 1
    LaneClear
    if Ok = 0 then
      Nr = Row - 1
      if Row <= 3 then return
    end if
  end if
  VT[I] = Nr * 8
  VS[I] = 2
  play sound SndTurn
  return
end sub

' LaneClear: no lit rock in the next three cells of lane Nr? (Ok)
sub LaneClear:
  Ok = 1
  for J = 0 to 3
    if VD[I] = 0 then
      Tx = Col + J
    else
      Tx = Col - J
    end if
    Ty = Nr
    GetT
    if Tt = TRockl then Ok = 0
  next
  return
end sub

sub Wreck:
  VS[I] = 4
  VT[I] = 0
  inc Wrecks
  HudOn = 1
  play sound SndCrash
  return
end sub

' NextRnd: the next random byte (xorshift's high byte)
sub NextRnd:
  W2 = Rnd << 7
  Rnd = Rnd ^ W2
  W2 = Rnd >> 9
  Rnd = Rnd ^ W2
  W2 = Rnd << 8
  Rnd = Rnd ^ W2
  W2 = Rnd >> 8
  RndB = lowbyte W2
  return
end sub

' ---------------------------------------------------------------------------
' the screen

sub ShowSprites:
  Na = 0
  Afloat = 0
  for C = 0 to NShip - 1
    if VS[C] > 0 then
      Ord[Na] = C
      inc Na
      if VS[C] < 4 then inc Afloat
    end if
  next
  inc Rot
  if Rot >= Na then Rot = 0
  for Q = 0 to NShip - 1
    if Q >= Na then
      set sprite Q to 192,0,0,0
    else
      C = Q + Rot
      if C >= Na then C = C - Na
      C = Ord[C]
      V = SShipR
      if VD[C] = 1 then V = SShipL
      V2 = 15
      if VS[C] = 4 then
        V = SWreck
        V2 = 14
        K = VT[C] & 8
        if K > 0 then V = SBubble
      end if
      Y = VY[C] - 1
      X = VX[C]
      set sprite Q to Y,X,V,V2
    end if
  next
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "NIGHT"
  V = Night + 1
  print at 8,1, digits$(V, 1)
  print at 11,1, "SAFE"
  print at 16,1, digits$(Safe, 2)
  put char 47 at 18,1
  print at 19,1, digits$(NShips, 2)
  print at 22,1, "WRECKS"
  print at 29,1, digits$(Wrecks, 1)
  return
end sub

' ---------------------------------------------------------------------------
' the pages

sub TitlePage:
  NewScreen
  backdrop dark blue
  I = 0
tp_xy:
  X = TitleXY[I]
  if X <> 255 then
    Y = TitleXY[I + 1]
    put char TSeal at X,Y
    I = I + 2
    goto tp_xy
  end if
  for X = 2 to 29
    put char TShore at X,16
  next
  put char TTower00 at 25,14
  put char TTower01 at 26,14
  put char TTower10 at 25,15
  put char TTower11 at 26,15
  put char TTower20 at 25,16
  put char TTower21 at 26,16
  print at 10,18, "PLAY"
  print at 10,19, "HOW TO PLAY"
  print at 10,20, "CREDITS"
  print at 5,22, "AN ORIGINAL GAME, 2026"
  Sel = 0
  ShowTitleMenu
  ShowScreen
  play song LhSong once
  WaitStick
  X = 8
tp_loop:
  Frame1
  ReadPad
  NextRnd
  if Rnd = 0 then Rnd = 1
  ' a ship sails by
  V = Tick & 1
  if V = 0 then inc X
  if X > 180 then X = 8
  set sprite 0 to 111,X,SShipR,15
  update sprites
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      play sound SndTick
      ShowTitleMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop song
  mute all
  play sound SndHorn
  return
end sub

sub ShowTitleMenu:
  for Y = 18 to 20
    put char 32 at 8,Y
  next
  Y = Sel + 18
  put char 62 at 8,Y
  return
end sub

sub NightPage:
  TextPage
  V = Night + 1
  print at 12,5, "NIGHT"
  print at 18,5, digits$(V, 1)
  print at 6,9, "SHIPS TO SEE THROUGH"
  print at 27,9, digits$(NightShips[Night], 2)
  print at 6,11, "ROCKS OUT THERE"
  print at 27,11, digits$(NightRocks[Night], 2)
  print at 8,20, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub HowToPage:
  TextPage
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "SHIPS CROSS THE DARK SEA."
  print at 2,4, "ROCKS LIE IN THEIR WAY, AND"
  print at 2,5, "A SHIP ONLY SEES A ROCK"
  print at 2,6, "WHILE THE BEAM IS ON IT:"
  print at 2,7, "THEN IT STEERS ROUND IT."
  print at 2,9, "STICK LEFT AND RIGHT: TURN"
  print at 2,10, "THE LAMP."
  print at 2,12, "A SHIP THAT MEETS A ROCK IN"
  print at 2,13, "THE DARK IS WRECKED. THREE"
  print at 2,14, "WRECKS AND THE NIGHT IS LOST."
  print at 2,16, "SHARP EYES MAY SPOT THE FOAM"
  print at 2,17, "OVER A ROCK IN THE DARK."
  print at 2,19, "FIVE NIGHTS TO DAWN."
  ShowScreen
  WaitPress
  return
end sub

sub CreditsPage:
  TextPage
  print at 10,2, "LIGHTHOUSE"
  print at 2,4, "AN ORIGINAL GAME FOR THE"
  print at 2,5, "COLECOVISION."
  print at 2,7, "DESIGN, PROGRAM, GRAPHICS,"
  print at 2,8, "SOUNDS AND THE TUNE"
  print at 2,9, "THE KEEPER'S LANTERN:"
  print at 2,10, "CLAUDE (AN AI BY ANTHROPIC)"
  print at 2,13, "MADE WITH AMY STUDIO"
  print at 2,14, "BY AMY BIENVENU"
  print at 2,17, "(C) 2026"
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub EndPage:
  TextPage
  print at 5,5, "FIVE NIGHTS, AND THE SEA"
  print at 5,6, "IS CALM AT LAST."
  print at 5,9, "SHIPS SEEN THROUGH"
  print at 24,9, digits$(Total, 3)
  print at 5,12, "THANK YOU, KEEPER."
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  Hold(60)
  WaitPress
  return
end sub

sub TextPage:
  NewScreen
  fill mode 2 text color with $10
  backdrop white
  cls
  return
end sub

' ---------------------------------------------------------------------------
' the machine

sub Rearm:
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Hold(u8 Frames):
  for C = 1 to Frames
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' WaitStick: until the button is let go (so a press is a new one)
sub WaitStick:
  WasBtn = 1
  WasStick = 1
  return
end sub

sub WaitPress:
  WaitStick
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  play sound SndTick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 5
  sprites flicker off
  for C = 0 to 4
    set sprite C to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$18,$00,$00,$00,$60,$00
  $00,$00,$18,$00,$00,$00,$60,$00
  $00,$00,$18,$00,$08,$00,$60,$00
  $00,$18,$C3,$81,$10,$04,$81,$81
  $00,$42,$08,$00,$81,$10,$00,$44
  $00,$22,$00,$00,$42,$08,$00,$81
  $07,$F0,$F0,$E0,$07,$07,$07,$07
  $E0,$F0,$F0,$07,$E0,$E0,$E0,$E0
  $F0,$F0,$F0,$F0,$E0,$E0,$E0,$E0
  $F0,$F0,$F0,$F0,$07,$07,$07,$07
  $00,$20,$02,$00,$40,$04,$00,$20
  $00,$10,$00,$02,$00,$08,$00,$40
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $04,$04,$54,$04,$04,$04,$54,$04
  $07,$07,$F7,$07,$07,$07,$F7,$07
  $04,$04,$54,$04,$F4,$04,$54,$04
  $07,$E7,$7E,$7E,$1E,$1E,$FE,$7F
  $0E,$1E,$1E,$0E,$1E,$1E,$0E,$1E
  $04,$54,$0F,$0E,$1E,$1E,$0E,$1E
  $B4,$4B,$4B,$41,$F4,$F4,$84,$84
  $B4,$B4,$B4,$41,$F4,$F4,$84,$84
  $4F,$4F,$48,$48,$4F,$4F,$48,$48
  $F4,$F4,$84,$84,$4F,$4F,$48,$48
  $0E,$1E,$1E,$0E,$1E,$1E,$0E,$1E
  $0E,$1E,$0E,$1E,$0E,$1E,$0E,$1E
  $04,$04,$04,$04,$04,$04,$04,$04
end data
data SpritePat bytes
  $10,$18,$1C,$1E,$10,$FF,$7E,$3C,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $08,$18,$38,$78,$08,$FF,$7E,$3C,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$82,$44,$10,$38,$FE,$7C,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$24,$50,$0A,$40,$14,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
; LIGHTHOUSE: the sea lives in the name table ($1800), one tile a cell.

; LhAddr: HL = the name table address of column Tx, row Ty
LhAddr:
    ld a,(AMY_UVAR_Ty)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Tx)
    or l
    ld l,a
    ld de,$1800
    add hl,de
    ret

; LhGet: Tt = the tile at Tx, Ty
LhGet:
    call LhAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Tt),a
    ret

; LhPut: the tile Tt at Tx, Ty
LhPut:
    call LhAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Tt)
    out ($BE),a
    ret

; LhRay: the RayN cells at RayC + RayP lit (LMode 1: sea and hidden rock
; become their lit tiles) or put back in the dark (LMode 0: the sea only)
LhRay:
    ld hl,(AMY_UVAR_RayP)
    ld de,AMY_UDATA_RayC
    add hl,de
    ld a,(AMY_UVAR_RayN)
    or a
    ret z
    ld b,a
LhRy1:
    push bc
    ld a,(hl)
    ld (AMY_UVAR_Tx),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_Ty),a
    inc hl
    push hl
    call LhGet
    ld a,(AMY_UVAR_LMode)
    or a
    ld a,(AMY_UVAR_Tt)
    jr z,LhRy3
    ; light: sea (128) and hidden rock (130) to the next tile
    cp AMY_UCONST_TSea
    jr z,LhRy2
    cp AMY_UCONST_TRockh
    jr nz,LhRy4
LhRy2:
    inc a
    jr LhRy5
LhRy3:
    ; dark: only the sea (a lit rock glows on a while: Fade puts it out)
    cp AMY_UCONST_TSeal
    jr nz,LhRy4
    dec a
LhRy5:
    ld (AMY_UVAR_Tt),a
    call LhPut
LhRy4:
    pop hl
    pop bc
    djnz LhRy1
    ret

LhHush:
    db $00,$00,$F4,$01,$10
LhTick:
    db $40,$40,$50,$01,$50
LhHorn:
    db $40,$3B,$32,$0A,$40,$3B,$42,$0A,$50
LhTurn:
    db $80,$AA,$50,$02,$80,$8F,$60,$03,$90
LhSafe:
    db $80,$6B,$30,$03,$80,$55,$30,$03,$80,$47,$40,$06,$90
LhCrash:
    db $C0,$F9,$13,$04,$C0,$FF,$23,$06,$C0,$FF,$53,$0C,$D0
LhWin:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$30,$10,$50
LhLose:
    db $40,$1D,$21,$08,$40,$53,$31,$08,$40,$AB,$41,$08,$40,$3B,$52,$14,$50

LhSoundTable:
    dw LhHush,$702B
    dw LhTick,$7035
    dw LhHorn,$7035
    dw LhTurn,$703F
    dw LhSafe,$703F
    dw LhCrash,$7049
    dw LhWin,$7035
    dw LhLose,$7035
    dw LhTuneMel,$703F
    dw LhTuneBass,$7049
; The Keeper's Lantern, D minor (original for this game)
; Tiny Sound, 10 frames per step
LhTuneMel:
    db $44
    dw sndtiny_1
    db 10
    db $02,$30,$1A,$21,$21,$00,$24,$28,$00,$26,$24,$00,$23,$21,$00,$00
    db $1F,$00,$23,$26,$00,$24,$23,$00,$21,$20,$00,$00,$21,$00,$24,$28
    db $00,$2D,$2B,$00,$29,$28,$00,$26,$24,$00,$23,$21,$00,$20,$A1,$00
    db $00,$00,$00,$00
    db $FF
LhTuneBass:
    db $84
    dw sndtiny_2
    db 10
    db $02,$60,$18,$32,$15,$00,$10,$00,$15,$00,$10,$00,$11,$00,$18,$00
    db $13,$00,$1A,$00,$13,$00,$1A,$00,$10,$00,$17,$00,$15,$00,$10,$00
    db $18,$00,$15,$00,$0E,$00,$15,$00,$10,$00,$17,$00,$10,$00,$15,$00
    db $00,$00,$00,$00
    db $FF
; the title song: both voices of The Keeper's Lantern at once
LhSong:
    dw $0001
    db $40+9,10
    dw $0000
}
