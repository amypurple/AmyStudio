cartridge "ALPHA-SHOOT/NEIL T. CAPALDI/1984"

' ALPHA-SHOOT
' A ColecoVision game based on "Alpha-Shoot", COMPUTE!'s Gazette, January
' 1984 (Commodore 64 and VIC-20, BASIC). The magazine's author is not named
' on the disk; the listing's REM credit (Christopher Thomas Ryan, December
' 1988) dates from the reader's retyping of the early Gazette disks.
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: a letter appears somewhere in the night sky. Slide the cannon
' along the ridge and shoot it. Each letter shot lights up in the alphabet
' at the bottom; shoot all 26 to win. Four games, as in the original:
'   1 RANDOM LETTERS  - the 26 letters in a random order, each once
'   2 A TO Z          - the letters in alphabetical order
'   3 YOUR CHOICE     - you choose each letter before it appears
'   4 CRAWLING LETTERS- random letters that crawl to the right, row after
'                       row, and start again at the top
'
' From the original (orig/alpha-shoot.64.bas and .vic.bas): the cannon on
' a bottom row that moves left and right, one shot at a time going
' straight up, one letter on the screen at a time at a random place in the
' upper part, the explosion, the 26-letter tally under the ground, the
' four games (random without repeats, A to Z, letters you type, crawling
' random letters that wrap from the end of the field back to the top),
' the game ends when all 26 are shot and goes back to the menu.
'
' Liberties: game 3 had the player type the letter on the keyboard; here
' the stick (up/down) chooses among the letters not yet shot and a button
' places it (the original also let you type a letter twice). The original
' had no goal but finishing; this one counts the time (stopped while you
' choose in game 3) and the shots, and keeps the best time of each game.
' Smooth 16 x 16 sprites: a cannon, a shell, big letters on discs, a
' burst; the crawl is one pixel every four frames (the C64 moved a cell
' about every 0.7 s). The title plays an original tune once instead of
' the alphabet song, and the end is a fanfare. No click on every cannon
' step. Letters keep clear of columns 0-1 and 30-31.
'
' Typos of the retyped disk (C64 against VIC-20): the C64 REM says
' "APLHA"; the C64 letter string is "ABCEDF..." (harmless, the letters are
' only drawn from it); the C64's line 239 accepts R = 0 ("@") where the
' VIC's line 238 forces 1. Neither changes the rules kept here.
'
' Controls: either controller. Stick left/right moves the cannon, either
' button fires. In game 3, up/down chooses a letter and a button places
' it. On the title, up/down chooses a game, a button starts (or opens
' HOW TO PLAY, two pages: a button turns the page, 30 s idle goes back;
' or CREDITS).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table; the title tune
' plays once. `set sprite count` always given. Nothing flashes.

const TSky = 128
const TStar1 = 129
const TStar2 = 130
const TStar3 = 131
const TGrass = 132
const TEarth = 133
const TEarthb = 134
const TRule = 135
const TSlot = 136
const SLeta = 0
const SLetb = 4
const SLetc = 8
const SLetd = 12
const SLete = 16
const SLetf = 20
const SLetg = 24
const SLeth = 28
const SLeti = 32
const SLetj = 36
const SLetk = 40
const SLetl = 44
const SLetm = 48
const SLetn = 52
const SLeto = 56
const SLetp = 60
const SLetq = 64
const SLetr = 68
const SLets = 72
const SLett = 76
const SLetu = 80
const SLetv = 84
const SLetw = 88
const SLetx = 92
const SLety = 96
const SLetz = 100
const SDisc = 104
const SGun = 108
const SShot = 112
const SBoom1 = 116
const SBoom2 = 120
const NTiles8 = 72
const SprBytes = 992
const SndTuneA = 1
const SndTuneB = 2
const SndFire = 3
const SndBoom = 4
const SndPick = 5
const SndPlace = 6
const SndStart = 7
const SndWin = 8
const NSpr = 8
const GunY = 128
const ShotY0 = 116
const ShotV = 6
const TopY = 24
const BotY = 104
const MinX = 16
const MaxX = 208
const GunMin = 16
const GunMax = 216
const BoomN = 30
const CrawlN = 4

record Target:
  u8 X
  u8 Y
  u8 L
  u8 Col
end record

' letter colours (the disc is dark blue, the letter bright)
data LetCol bytes
  11, 3, 7, 9, 15, 13, 11, 3, 7, 9, 15, 13, 11
  3, 7, 9, 15, 13, 11, 3, 7, 9, 15, 13, 11, 3
end data

Target Tg
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Secs = 0
u16 Best[4]
bcd digits 3 Time
bcd digits 3 Shots
u8 Got26[26]
u8 Remain = 26
u8 Mode = 1
u8 Ph = 0
u8 Over = 0
u8 Gx = 112
u8 Sx = 0
u8 Sy = 0
u8 SOn = 0
u8 BoomT = 0
u8 CrawlT = 0
u8 SecT = 0
u8 PickL = 0
u8 PickT = 0
u8 NewBest = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 4 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  HideSprites
  set sprite 0 to GunY - 1,Gx,SGun,14
  update sprites
  K = Mode - 1
  NewBest = 0
  if Best[K] = 0 then NewBest = 1
  if Secs < Best[K] then NewBest = 1
  if NewBest = 1 then Best[K] = Secs
  print at 5,7, "                      "
  print at 5,8, "  ALL 26 LETTERS SHOT "
  print at 5,9, "                      "
  print at 5,10, "  TIME     SHOTS      "
  print at 12,10, Time
  print at 23,10, Shots
  print at 5,11, "                      "
  if NewBest = 1 then
    print at 5,12, "    A NEW BEST TIME!  "
    print at 5,13, "                      "
  end if
  play sound SndWin
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  select case Ph
  case 0
    PickStep
  case 1
    Clock
    MoveGun
    MoveShot
    if Mode = 4 then Crawl
    if SOn = 1 then
      if HitTarget(Sx, Sy) = 1 then
        SOn = 0
        Ph = 2
        BoomT = BoomN
        play sound SndBoom
      end if
    end if
  case 2
    Clock
    MoveGun
    dec BoomT
    if BoomT = 0 then Landed
  end select
  return
end sub

' the clock: one second every 60 frames, up to 999
sub Clock:
  inc SecT
  if SecT < 60 then return
  SecT = 0
  if Secs >= 999 then return
  inc Secs
  Time += 1
  print at 7,1, Time
  return
end sub

sub MoveGun:
  K = J1 | J2
  V = K & 4
  if V > 0 then
    if Gx > GunMin then Gx = Gx - 2
  end if
  V = K & 8
  if V > 0 then
    if Gx < GunMax then Gx = Gx + 2
  end if
  if Press = 1 then
    if SOn = 0 then
      SOn = 1
      Sx = Gx
      Sy = ShotY0
      Shots += 1
      print at 18,1, Shots
      play sound SndFire
    end if
  end if
  return
end sub

sub MoveShot:
  if SOn = 0 then return
  if Sy < 14 then
    SOn = 0
    return
  end if
  Sy = Sy - ShotV
  return
end sub

' 1 when the shell (sprite corner Sx, Sy; pixels 6-9 x 6-12) touches the
' letter's disc
function HitTarget(u8 Ax, u8 Ay) as u8
  u8 Cx = Ax + 8
  u8 Top = Ay + 6
  u8 Bot = Ay + 12
  if Cx < Tg.X + 1 then return 0
  if Cx > Tg.X + 15 then return 0
  if Bot < Tg.Y + 1 then return 0
  if Top > Tg.Y + 14 then return 0
  return 1

' game 4: the letter crawls right, row after row, then back to the top
sub Crawl:
  inc CrawlT
  if CrawlT < CrawlN then return
  CrawlT = 0
  Tg.X = Tg.X + 1
  if Tg.X > MaxX then
    Tg.X = MinX
    Tg.Y = Tg.Y + 16
    if Tg.Y > BotY then Tg.Y = TopY
  end if
  return
end sub

' the burst is over: the letter goes into the tally
sub Landed:
  Got26[Tg.L] = 1
  dec Remain
  DrawTally(Tg.L)
  if Remain = 0 then
    Over = 1
    return
  end if
  NewTarget
  return
end sub

' game 3: choose among the letters not yet shot
sub PickStep:
  MoveShot
  K = J1 | J2
  V = K & 3
  if V = 0 then
    PickT = 0
  else
    if PickT = 0 then
      if V = 1 then
        PickL = NextFree(PickL, 25)
      else
        PickL = NextFree(PickL, 1)
      end if
      Tg.L = PickL
      Tg.Col = LetCol[PickL]
      play sound SndPick
      PickT = 10
    else
      dec PickT
    end if
  end if
  if Press = 1 then
    PlaceTarget
    Ph = 1
    Ri = 3
    DrawSkyRow
    play sound SndPlace
  end if
  return
end sub

' the next letter not yet shot after L, stepping by D (1 forward, 25 back)
function NextFree(u8 L, u8 D) as u8
  u8 N = L
  u8 Cnt = 0
  for Cnt = 1 to 26
    N = N + D
    if N >= 26 then N = N - 26
    if Got26[N] = 0 then return N
  next
  return L

' the K-th (0 based) letter not yet shot
function NthFree(u8 Nth) as u8
  u8 I = 0
  u8 Seen = 0
  for I = 0 to 25
    if Got26[I] = 0 then
      if Seen = Nth then return I
      inc Seen
    end if
  next
  return 0

function Rnd(u8 N) as u8
  Rand
  return Rs % N

sub NewTarget:
  select case Mode
  case 1, 4
    Tg.L = NthFree(Rnd(Remain))
  case 2
    Tg.L = NthFree(0)
  case 3
    Ph = 0
    PickT = 0
    PickL = NthFree(0)
    Tg.L = PickL
    Tg.X = 112
    Tg.Y = 56
    Tg.Col = LetCol[PickL]
    print at 4,3, "CHOOSE: STICK, THEN FIRE"
    return
  end select
  PlaceTarget
  Ph = 1
  return
end sub

' a random place in the sky for the letter Tg.L
sub PlaceTarget:
  Tg.Col = LetCol[Tg.L]
  Tg.X = MinX + Rnd(25) * 8
  Tg.Y = TopY + Rnd(11) * 8
  CrawlT = 0
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the cannon, 1 the shell, 2 the letter (or the burst), 3 its disc
sub DrawSprites:
  u8 Pat = 0
  u8 Sy1 = 0
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
  else
    set sprite 0 to GunY - 1,Gx,SGun,14
  end if
  if SOn = 1 then
    Sy1 = Sy - 1
    set sprite 1 to Sy1,Sx,SShot,11
  else
    set sprite 1 to 192,0,0,0
  end if
  Sy1 = Tg.Y - 1
  select case Ph
  case 0, 1
    if TitleOn = 1 then
      set sprite 2 to 192,0,0,0
      set sprite 3 to 192,0,0,0
    else
      Pat = Tg.L << 2
      set sprite 2 to Sy1,Tg.X,Pat,Tg.Col
      set sprite 3 to Sy1,Tg.X,SDisc,4
    end if
  case 2
    Pat = SBoom1
    if BoomT < 20 then Pat = SBoom2
    if BoomT < 10 then Pat = SBoom1
    set sprite 2 to Sy1,Tg.X,Pat,Tg.Col
    set sprite 3 to 192,0,0,0
  end select
  update sprites
  return
end sub

' the tally slot of letter L: a frame, or the letter once shot
sub DrawTally(u8 L):
  u8 Cx = 0
  u8 Cy = 21
  if L >= 13 then Cy = 22
  Cx = L % 13
  Cx = Cx * 2 + 3
  if Got26[L] = 1 then
    put char 65 + L at Cx,Cy
  else
    put char TSlot at Cx,Cy
  end if
  return
end sub

sub DrawField:
  for Ri = 3 to 17
    DrawSkyRow
  next
  fill TRule count 32 at 0,2
  fill TGrass count 32 at 0,18
  fill TEarth count 32 at 0,19
  fill TEarthb count 32 at 0,20
  return
end sub

' one row of sky (Ri) with its stars
sub DrawSkyRow:
    for Li = 0 to 31
      V = Li * 7 + Ri * 13
      V = V & 31
      select case V
      case 3
        C = TStar1
      case 11
        C = TStar2
      case 23
        C = TStar3
      case else
        C = TSky
      end select
      put char C at Li,Ri
    next
  return
end sub

sub ShowHud:
  print at 2,1, "TIME"
  print at 7,1, Time
  print at 12,1, "SHOTS"
  print at 18,1, Shots
  print at 23,1, "GAME"
  NumU = Mode
  print at 28,1, digits$(NumU, 1)
  return
end sub

sub NewGame:
  Mode = Menu + 1
  for Li = 0 to 25
    Got26[Li] = 0
  next
  Remain = 26
  Time = 0
  Shots = 0
  Secs = 0
  SecT = 0
  Gx = 112
  SOn = 0
  Over = 0
  TitleOn = 0
  NewScreen
  DrawField
  ShowHud
  for Li = 0 to 25
    DrawTally(Li)
  next
  NewTarget
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the sky, the four games, HOW TO PLAY and the credits, the tune once
sub TitlePage:
  TitleOn = 1
  Ph = 1
  SOn = 0
  NewScreen
  DrawField
  print at 10,4, "ALPHA-SHOOT"
  print at 4,6, "COMPUTE!'S GAZETTE 1984"
  print at 5,9, "1 RANDOM LETTERS"
  print at 5,10, "2 A TO Z"
  print at 5,11, "3 YOUR CHOICE"
  print at 5,12, "4 CRAWLING LETTERS"
  print at 5,13, "HOW TO PLAY"
  print at 5,14, "CREDITS"
  print at 25,8, "BEST"
  for Li = 0 to 3
    ShowBest(Li)
  next
  print at 3,21, "STICK TO CHOOSE, FIRE"
  print at 3,22, "TO START. SHOOT A TO Z!"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 536
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 3
tp_loop:
  Frame1
  inc Rs
  ReadPad
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 5 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 4 then HowToPage
  if Menu = 5 then CreditsPage
  return
end sub

sub ShowBest(u8 M):
  u8 Row = M + 9
  if Best[M] = 0 then
    print at 26,Row, "---"
  else
    NumU = Best[M]
    print at 26,Row, digits$(NumU, 3)
  end if
  return
end sub

sub ShowMenu:
  for Li = 9 to 14
    put char 32 at 3,Li
  next
  J = Menu + 9
  put char 62 at 3,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    print at 2,3, "A LETTER APPEARS IN THE SKY."
    print at 2,4, "SLIDE YOUR CANNON LEFT AND"
    print at 2,5, "RIGHT WITH THE STICK. PRESS"
    print at 2,6, "A BUTTON TO SHOOT IT."
    fill TSky count 28 at 2,8
    fill TSky count 28 at 2,9
    fill TSky count 28 at 2,10
    fill TSky count 28 at 2,11
    fill TSky count 28 at 2,12
    fill TSky count 28 at 2,13
    put char TStar1 at 5,9
    put char TStar2 at 24,10
    put char TStar3 at 9,12
    fill TGrass count 28 at 2,15
    fill TEarth count 28 at 2,16
    set sprite 0 to 103,120,SGun,14
    set sprite 1 to 87,120,SShot,11
    set sprite 2 to 63,120,SLetg,11
    set sprite 3 to 63,120,SDisc,4
    print at 2,18, "SHOOT ALL 26 LETTERS, A TO"
    print at 2,19, "Z, TO WIN!"
  else
    print at 2,3, "FOUR GAMES ON THE TITLE:"
    print at 2,4, "1 RANDOM: ANY ORDER."
    print at 2,5, "2 A TO Z: IN ORDER."
    print at 2,6, "3 YOUR CHOICE: STICK UP OR"
    print at 2,7, "  DOWN PICKS THE LETTER, A"
    print at 2,8, "  BUTTON PUTS IT IN THE SKY."
    print at 2,9, "4 CRAWLING: LETTERS MOVE!"
    print at 2,11, "EACH LETTER YOU HIT LIGHTS"
    print at 2,12, "UP BELOW. ALL 26 LIT ENDS"
    print at 2,13, "THE GAME. YOUR TIME AND"
    print at 2,14, "SHOTS ARE COUNTED: BEAT"
    print at 2,15, "YOUR BEST TIME!"
    print at 2,17, "TIP: STAND RIGHT UNDER THE"
    print at 2,18, "LETTER BEFORE YOU SHOOT."
    print at 3,20, "A B C"
    for Li = 0 to 9
      J = Li * 2 + 9
      put char TSlot at J,20
    next
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_loop:
  Frame1
  inc Rs
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "ALPHA-SHOOT"
  print at 2,5, "FROM ALPHA-SHOOT,"
  print at 2,6, "COMPUTE!'S GAZETTE,"
  print at 2,7, "JANUARY 1984 (COMMODORE 64"
  print at 2,8, "AND VIC-20). DISK RETYPED"
  print at 2,9, "BY CHRISTOPHER THOMAS RYAN."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: LETTER LIGHTS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$04,$00,$00,$00,$00
  $00,$40,$00,$00,$00,$00,$02,$00
  $00,$00,$00,$10,$38,$10,$00,$00
  $00,$44,$AA,$00,$44,$00,$00,$42
  $00,$20,$06,$80,$00,$10,$01,$40
  $00,$20,$04,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$81,$42,$42,$42,$42,$81,$00
end data
data TileCol bytes
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$E1,$01,$01,$01,$01
  $01,$F1,$01,$01,$01,$01,$E1,$01
  $01,$01,$01,$F1,$F1,$F1,$01,$01
  $01,$C1,$C1,$02,$32,$0C,$0A,$6A
  $0A,$6A,$6A,$6A,$0A,$6A,$6A,$6A
  $0A,$6A,$6A,$06,$01,$01,$01,$01
  $01,$01,$01,$04,$05,$04,$01,$01
  $01,$14,$41,$41,$41,$41,$14,$01
end data
data SpritePat bytes
  $00,$07,$07,$18,$18,$18,$18,$1F,$1F,$18,$18,$18,$18,$18,$18,$00
  $00,$E0,$E0,$18,$18,$18,$18,$F8,$F8,$18,$18,$18,$18,$18,$18,$00
  $00,$1F,$1F,$18,$18,$18,$18,$1F,$1F,$18,$18,$18,$18,$1F,$1F,$00
  $00,$E0,$E0,$18,$18,$18,$18,$E0,$E0,$18,$18,$18,$18,$E0,$E0,$00
  $00,$07,$07,$18,$18,$18,$18,$18,$18,$18,$18,$18,$18,$07,$07,$00
