project "TRAIN TRACK PUZZLE"
memory "colecovision_legacy_sdcc"

' define TRAIN_TRACK_DEBUG_SOLVED

asset AllAboard from "@project/all-aboard.dsound" codec raw
asset TrainTrackPatterns from "@project/train-track.pattern.zx0" codec zx0
asset TrainTrackColors from "@project/train-track.color.zx0" codec zx0


const EmptyPiece = 0
const HorizontalPiece = 1
const VerticalPiece = 2
const NorthEastPiece = 3
const EastSouthPiece = 4
const SouthWestPiece = 5
const WestNorthPiece = 6
const WaterPiece = 7
const BoardX = 9
const BoardY = 8
const TitleTileBase = 120
const TrackTileBase = 180
const HintDigitBase = 232
const WaterFrameTileBase = 212
const PuzzleCount = 9

u8 Board[49]
u8 Solution[49]
u8 FixedClue[49]
u8 CursorX = 0
u8 CursorY = 0
u8 Puzzle = 0
u8 Cell = 0
u8 Piece = 0
u8 Tile = 0
