data PuzzleFixedCells bytes
  5,7,13,16,25,28,0,0
  5,3,8,24,33,43,0,0
  6,8,12,14,24,29,41,0
  6,0,2,14,18,20,30,0
  6,6,8,12,20,24,39,0
  6,0,10,16,19,28,42,0
  7,4,6,12,24,36,46,47
  7,0,2,14,18,30,40,47
  6,18,30,34,42,46,48,0
end data

data PuzzleRowCounts bytes
  0,6,3,4,7,0,0, 1,3,1,5,1,5,1, 0,5,3,5,1,6,0
  3,1,7,2,4,0,0, 1,6,2,4,2,4,0, 4,2,6,1,3,1,1
  4,3,3,1,3,3,3, 4,3,4,3,1,4,1, 0,0,5,2,4,2,6
end data

data PuzzleColumnCounts bytes
  2,2,4,2,4,2,4, 0,5,3,4,2,3,0, 1,5,3,3,3,4,1
  4,3,4,3,1,1,1, 0,1,1,4,3,4,6, 6,3,4,3,1,1,0
  0,2,2,7,4,4,1, 3,1,6,3,5,2,0, 3,2,4,2,2,1,5
end data

data PuzzleRoutes bytes
  20,7,8,9,16,23,24,25,18,11,12,13,20,27,34,33,32,31,30,29,28
  17,3,10,9,8,15,22,23,24,25,26,33,40,39,38,37,36,43,0,0,0
  20,14,15,8,9,10,11,12,19,26,25,24,23,22,29,36,37,38,39,40,41
  17,0,1,2,9,16,15,14,21,28,29,30,31,24,17,18,19,20,0,0,0
  19,6,13,20,27,34,41,40,39,38,31,24,25,26,19,12,11,10,9,8,0
  18,42,35,28,29,30,23,16,15,14,7,0,1,2,3,10,17,18,19,0,0
  20,6,5,4,3,10,11,12,19,18,17,24,31,30,29,36,37,38,45,46,47
  20,0,7,14,15,16,9,2,3,4,11,18,25,24,23,30,37,38,39,40,47
  19,48,41,34,27,20,19,18,17,16,23,30,29,28,35,42,43,44,45,46,0
end data

tile screen
backdrop dark blue
sprites 16x16
sprites simple
' One compressed charset fills $78-$D7 in every Mode 2 third.
decompress TrainTrackPatterns to vram.pattern + 960
decompress TrainTrackPatterns to vram.pattern + 3008
decompress TrainTrackPatterns to vram.pattern + 5056
decompress TrainTrackColors to vram.color + 960
decompress TrainTrackColors to vram.color + 3008
decompress TrainTrackColors to vram.color + 5056
' Reuse the BIOS font already in VRAM: copy digits $30-$37 to $D0-$D7.
copy vram.pattern + 384 count 32 to vram.pattern + 1856
copy vram.pattern + 416 count 32 to vram.pattern + 1888
copy vram.pattern + 2432 count 32 to vram.pattern + 3904
copy vram.pattern + 2464 count 32 to vram.pattern + 3936
copy vram.pattern + 4480 count 32 to vram.pattern + 5952
copy vram.pattern + 4512 count 32 to vram.pattern + 5984
copy CursorSprite to vram.spr_pat
copy TrainUpSprite to vram.spr_pat + 32
copy TrainRightSprite to vram.spr_pat + 64
copy TrainDownSprite to vram.spr_pat + 96
copy TrainLeftSprite to vram.spr_pat + 128
copy SmokeDotsSprite to vram.spr_pat + 160
copy SmokeDotsMediumSprite to vram.spr_pat + 192
copy SmokeDotsSmallSprite to vram.spr_pat + 224
copy SmokeDotsEmptySprite to vram.spr_pat + 256
set sound table TrainTrackSoundTable areas 8
clear sprites
set sprite count 1
update sprites
screen on
goto TitleScreen

sub TitleScreen:
  mute all
  cls
  DrawTitleLogo
  print centered at 6, "BUILD ONE CONTINUOUS RAIL"
  print centered at 8, "MATCH EVERY ROW AND COLUMN"
  print at 4,13, "PAD        MOVE CURSOR"
  print at 4,15, "LEFT FIRE  CYCLE TRACK"
  print at 4,17, "RIGHT FIRE MARK WATER"
  print centered at 22, "PRESS FIRE"
  play sounds 1, 2
  pause until press and release blank after 10 seconds
  Puzzle = 0
  LoadPuzzle
  goto GameLoop

sub LoadPuzzle:
  mute all
  cls
  DrawTitleLogo
  for I = 0 to 48
    Cell = Puzzle << 5
    Tile = Puzzle << 4
    Cell += Tile
    Cell += Puzzle
    Cell += I
    Solution[I] = PuzzleSolutions[Cell]
    FixedClue[I] = 0
    Board[I] = EmptyPiece
  next
  ' Each puzzle stores only its few fixed cell indexes, not a 49-byte flag map.
  Cell = Puzzle << 3
  Tile = PuzzleFixedCells[Cell]
  for I = 1 to Tile
    X = Cell + I
    X = PuzzleFixedCells[X]
    FixedClue[X] = 1
    Board[X] = Solution[X]
  next
  CursorX = 0
  CursorY = 0
  DrawBoard
  DrawCursor
  play sound 3
ifdef TRAIN_TRACK_DEBUG_SOLVED
  copy Solution count 49 to Board
  DrawBoard
  CheckPuzzleComplete
end ifdef
  return

sub DrawBoard:
  print at 12,4, "PUZZLE"
  print Puzzle + 1 at 19,4 digits 1
  DrawHints
  for I = 0 to 48
    DrawCell
  next
  return

sub DrawHints:
  for X = 0 to 6
    Cell = Puzzle << 3
    Cell -= Puzzle
    Cell += X
    HintTarget = PuzzleColumnCounts[Cell]
    HintCount = 0
    for Y = 0 to 6
      Cell = Y << 3
      Cell -= Y
      Cell += X
      Piece = Board[Cell]
      if Piece > EmptyPiece and Piece < WaterPiece then HintCount += 1
    next
    Tile = HintTarget + 48
    if HintCount = HintTarget then Tile = HintTarget + HintDigitBase
    ScreenX = X << 1
    ScreenX += BoardX
    put char Tile at ScreenX,6
  next
  for Y = 0 to 6
    Cell = Puzzle << 3
    Cell -= Puzzle
    Cell += Y
    HintTarget = PuzzleRowCounts[Cell]
    HintCount = 0
    for X = 0 to 6
      Cell = Y << 3
      Cell -= Y
      Cell += X
      Piece = Board[Cell]
      if Piece > EmptyPiece and Piece < WaterPiece then HintCount += 1
    next
    Tile = HintTarget + 48
    if HintCount = HintTarget then Tile = HintTarget + HintDigitBase
    ScreenY = Y << 1
    ScreenY += BoardY
    put char Tile at 8,ScreenY
  next
  return

sub DrawTitleLogo:
  for X = 0 to 19
    Tile = TitleTileBase
    Tile += X
    ScreenX = 6 + X
    put char Tile at ScreenX,1
    Tile = TitleTileBase + 20
    Tile += X
    put char Tile at ScreenX,2
    Tile = TitleTileBase + 40
    Tile += X
    put char Tile at ScreenX,3
  next
  return

sub DrawCell:
  Y = I / 7
  Cell = Y << 3
  Cell -= Y
  X = I - Cell
  Piece = Board[I]
  if Piece = WaterPiece then
    Tile = WaterFrame << 2
    Tile += WaterFrameTileBase
  else
    Tile = Piece << 2
    Tile += TrackTileBase
  end if
  ScreenX = X << 1
  ScreenX += BoardX
  ScreenY = Y << 1
  ScreenY += BoardY
  put char Tile at ScreenX,ScreenY
  put char Tile + 1 at ScreenX + 1,ScreenY
  put char Tile + 2 at ScreenX,ScreenY + 1
  put char Tile + 3 at ScreenX + 1,ScreenY + 1
  return

sub DrawCursor:
  ScreenX = CursorX << 4
  ScreenX += BoardX * 8
  ScreenY = CursorY << 4
  ScreenY += BoardY * 8
  ScreenY -= 1
  set sprite 0 to ScreenY,ScreenX,0,15
  update sprites
  return

sub CyclePiece:
  Cell = CursorY << 3
  Cell -= CursorY
  Cell += CursorX
  if FixedClue[Cell] = 1 then
    play sound 5
    return
  end if
  Board[Cell] += 1
  if Board[Cell] > WestNorthPiece then Board[Cell] = EmptyPiece
  I = Cell
  DrawCell
  DrawHints
  play sound 4
  CheckPuzzleComplete
  return

sub ToggleWater:
  Cell = CursorY << 3
  Cell -= CursorY
  Cell += CursorX
  if FixedClue[Cell] = 1 then
    play sound 5
    return
  end if
  if Board[Cell] = WaterPiece then
    Board[Cell] = EmptyPiece
  else
    Board[Cell] = WaterPiece
  end if
  I = Cell
  DrawCell
  DrawHints
  play sound 4
  CheckPuzzleComplete
  return

sub CheckPuzzleComplete:
  Mistakes = 0
  for I = 0 to 48
    if Solution[I] = EmptyPiece then
      if Board[I] <> EmptyPiece and Board[I] <> WaterPiece then Mistakes += 1
    else
      if Board[I] <> Solution[I] then Mistakes += 1
    end if
  next
  if Mistakes = 0 then Victory
  return

sub Victory:
  print centered at 23, "ALL ABOARD!"
  play dsound AllAboard step 21
  play sounds 6, 7, 8
  fill row 23 from 0 count 32 with $20
  clear sprites
  set sprite count 4
  for SmokeSlot = 0 to 2
    SmokeAge[SmokeSlot] = 24
    SmokeXs[SmokeSlot] = 0
    ' Y=$D0 terminates the hardware sprite list; $CF is safely off-screen.
    SmokeYs[SmokeSlot] = 207
    set sprite SmokeSlot to SmokeYs[SmokeSlot],SmokeXs[SmokeSlot],32,14
  next
  update sprites
  SmokeIndex = 2
  SmokeStep = 0
  SmokeRiseStep = 0
  Cell = Puzzle << 4
  Tile = Puzzle << 2
  Cell += Tile
  Cell += Puzzle
  RouteLength = PuzzleRoutes[Cell]
  Cell += 1
  Cell = PuzzleRoutes[Cell]
  Y = Cell / 7
  Tile = Y << 3
  Tile -= Y
  X = Cell - Tile
  TrainX = X << 4
  TrainX += BoardX * 8
  TrainY = Y << 4
  TrainY += BoardY * 8
  TrainY -= 1
  for I = 2 to RouteLength
    Cell = Puzzle << 4
    Tile = Puzzle << 2
    Cell += Tile
    Cell += Puzzle
    Cell += I
    Cell = PuzzleRoutes[Cell]
    Y = Cell / 7
    Tile = Y << 3
    Tile -= Y
    X = Cell - Tile
    TargetX = X << 4
    TargetX += BoardX * 8
    TargetY = Y << 4
    TargetY += BoardY * 8
    TargetY -= 1
    TrainDX = 0
    TrainDY = 0
    if TargetX > TrainX then
      TrainDX = 2
      TrainPattern = 8
    elseif TargetX < TrainX then
      TrainDX = -2
      TrainPattern = 16
    elseif TargetY > TrainY then
      TrainDY = 2
      TrainPattern = 12
    else
      TrainDY = -2
      TrainPattern = 4
    end if
    for TravelStep = 1 to 8
      TrainX += TrainDX
      TrainY += TrainDY
      for SmokeFrame = 0 to 1
        SmokeRiseStep += 1
        if SmokeRiseStep = 4 then SmokeRiseStep = 0
        for SmokeSlot = 0 to 2
          if SmokeAge[SmokeSlot] < 24 then
            SmokeAge[SmokeSlot] += 1
            if SmokeRiseStep = 0 then SmokeYs[SmokeSlot] -= 1
          end if
          SmokePattern = SmokeAgePatterns[SmokeAge[SmokeSlot]]
          set sprite SmokeSlot to SmokeYs[SmokeSlot],SmokeXs[SmokeSlot],SmokePattern,14
        next
        SmokeStep += 1
        if SmokeStep = 8 then
          SmokeStep = 0
          SmokeIndex += 1
          if SmokeIndex > 2 then SmokeIndex = 0
          SmokeX = TrainX
          SmokeY = TrainY - 8
          SmokeAge[SmokeIndex] = 0
          SmokeXs[SmokeIndex] = SmokeX
          SmokeYs[SmokeIndex] = SmokeY
          set sprite SmokeIndex to SmokeY,SmokeX,20,14
        end if
        ' Lower sprite indexes have priority, so smoke overlays the train.
        set sprite 3 to TrainY,TrainX,TrainPattern,1
        update sprites
        wait 1 frame
        AnimateWater
      next
    next
  next
  wait 60 frames
  clear sprites
  set sprite count 1
  update sprites
  print centered at 23, "CONGRATULATIONS!"
  wait 120 frames
  pause until press and release
  wait 1 frame
  mute all
  Puzzle += 1
  if Puzzle = PuzzleCount then Puzzle = 0
  LoadPuzzle
  return

sub GameLoop:
  if joypad(1).up then
    if LastPad = 0 and CursorY > 0 then CursorY -= 1
    LastPad = 1
  elseif joypad(1).down then
    if LastPad = 0 and CursorY < 6 then CursorY += 1
    LastPad = 1
  elseif joypad(1).left then
    if LastPad = 0 and CursorX > 0 then CursorX -= 1
    LastPad = 1
  elseif joypad(1).right then
    if LastPad = 0 and CursorX < 6 then CursorX += 1
    LastPad = 1
  elseif joypad(1).button1 then
    if LastPad = 0 then CyclePiece
    LastPad = 1
  elseif joypad(1).button2 then
    if LastPad = 0 then ToggleWater
    LastPad = 1
  else
    LastPad = 0
  end if
  DrawCursor
  wait
  AnimateWater
  goto GameLoop

sub AnimateWater:
  if WaterUpdating = 0 then
    WaterTicks += 1
    if WaterTicks < 15 then return
    WaterTicks = 0
    WaterFrame += 1
    if WaterFrame > 4 then WaterFrame = 0
    WaterRow = 0
    WaterUpdating = 1
  end if
  ' Victory also uses I for its route; preserve it across water redraws.
  WaterSavedI = I
  WaterCell = WaterRow << 3
  WaterCell -= WaterRow
  for WaterColumn = 0 to 6
    if Board[WaterCell] = WaterPiece then
      I = WaterCell
      DrawCell
    end if
    WaterCell += 1
  next
  I = WaterSavedI
  WaterRow += 1
  if WaterRow > 6 then WaterUpdating = 0
  return

asm {
TrainTrackTitleMusicVoice1:
    db $40,$1D,$51,$06,$40,$D5,$50,$06,$40,$A9,$50,$06,$40,$D5,$50,$06
    db $40,$A9,$50,$06,$40,$8E,$50,$06,$40,$A9,$50,$06,$40,$8E,$50,$06
    db $40,$6A,$50,$18,$50
TrainTrackTitleMusicVoice2:
    db $80,$3A,$52,$06,$80,$AB,$51,$06,$80,$53,$51,$06,$80,$1D,$51,$06
    db $80,$D5,$50,$06,$80,$A9,$50,$06,$80,$D5,$50,$06,$80,$A9,$50,$06
    db $80,$8E,$50,$18,$90
TrainTrackStartSound:
    db $40,$6B,$10,$02,$50
TrainTrackPlaceSound:
    db $41,$6D,$20,$03,$11,$FC
    db $50
TrainTrackErrorSound:
    db $80,$30,$63,$04,$90
TrainTrackSirenTone1:
    db $42,$B4,$60,$20,$F4,$21
    db $42,$B4,$30,$0C,$24,$22
    db $42,$B4,$60,$48,$F4,$21
    db $42,$B4,$30,$0E,$26,$22
    db $66
    db $50
TrainTrackSirenTone2:
    db $82,$78,$60,$20,$F4,$21
    db $82,$78,$30,$0C,$24,$22
    db $82,$78,$60,$48,$F4,$21
    db $82,$78,$30,$0E,$26,$22
    db $A6
    db $90
TrainTrackSirenNoise:
    db $C0,$00,$F0,$06
    db $C2,$A0,$60,$20,$F4,$21
    db $C2,$A0,$30,$0C,$24,$22
    db $C2,$A0,$60,$48,$F4,$21
    db $C2,$A0,$30,$0C,$26,$22
    db $D0
TrainTrackSoundTable:
    dw TrainTrackTitleMusicVoice1,$702B
    dw TrainTrackTitleMusicVoice2,$7035
    dw TrainTrackStartSound,$703F
    dw TrainTrackPlaceSound,$7049
    dw TrainTrackErrorSound,$7053
    dw TrainTrackSirenTone1,$705D
    dw TrainTrackSirenTone2,$7067
    dw TrainTrackSirenNoise,$7071
}
