u8 SmokeRiseStep = 0
u8 TravelStep = 0
u8 WaterTicks = 0
u8 WaterFrame = 0
u8 WaterCell = 0
u8 WaterColumn = 0
u8 WaterRow = 0
u8 WaterUpdating = 0
u8 WaterSavedI = 0
u8 HintCount = 0
u8 HintTarget = 0
i8 TrainDX = 0
i8 TrainDY = 0

