    db 7
    db $02,$50,$1A,$21,$17,$01,$01,$01,$1A,$01,$01,$01,$1E,$01,$1C,$01
    db $1A,$01,$19,$01,$17,$01,$01,$01,$1A,$01,$01,$01,$1F,$01,$1E,$01
