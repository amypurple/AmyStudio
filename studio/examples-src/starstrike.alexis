asm {
; SsMul: W16 = V * S (8 x 8 bits), Hb its high byte
SsMul:
    ld a,(AMY_UVAR_V)
    ld e,a
    ld d,0
    ld a,(AMY_UVAR_S)
    ld hl,0
    ld b,8
SsMul1:
    add hl,hl
    rla
    jr nc,SsMul2
    add hl,de
SsMul2:
    djnz SsMul1
    ld (AMY_UVAR_W16),hl
    ld a,h
    ld (AMY_UVAR_Hb),a
    ret
SsBoom:
    db $00,$00,$04,$03,$00,$00,$15,$06,$00,$00,$36,$0A,$00,$00,$56,$0E,$00,$00,$77,$12,$10
SsHit:
    db $00,$00,$04,$04,$00,$00,$35,$08,$00,$00,$66,$08,$10
SsShot:
    db $40,$50,$10,$01,$40,$66,$20,$02,$40,$7C,$30,$02,$40,$A0,$50,$03,$50
SsPop:
    db $40,$40,$10,$02,$40,$30,$30,$03,$40,$40,$50,$04,$50
SsPhase:
    db $40,$D6,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$47,$20,$0E,$50
SsWin:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$8F,$20,$06,$40,$6B,$10,$14
    db $50
SsOver:
    db $40,$1D,$11,$0A,$40,$53,$21,$0A,$40,$AB,$31,$0A,$40,$3B,$42,$1A,$50
SsBeam:
    db $40,$FC,$11,$08,$40,$E0,$11,$08,$40,$FC,$21,$08,$40,$E0,$21,$08,$40,$F9,$33,$14,$50

SsSoundTable:
    dw SsTuneMel,$702B
    dw SsTuneBass,$7035
    dw SsRunMel,$702B
    dw SsRunBass,$7035
    dw SsBoom,$703F
    dw SsHit,$703F
    dw SsShot,$7049
    dw SsPop,$7049
    dw SsPhase,$7049
    dw SsWin,$7049
    dw SsOver,$7049
    dw SsBeam,$7049
; Edge of the Galaxy (original)
; Tiny Sound, 6 frames per step
SsTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$1A,$21,$1C,$01,$01,$23,$01,$01,$28,$01,$26,$01,$23,$01
    db $1F,$01,$01,$01,$21,$01,$01,$24,$01,$01,$28,$01,$26,$01,$01,$01
    db $00,$01,$01,$01,$24,$01,$01,$23,$01,$01,$21,$01,$1F,$01,$1E,$01
    db $1B,$01,$01,$01,$1C,$01,$23,$01,$1F,$01,$23,$01,$28,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
SsTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$60,$18,$32,$04,$10,$04,$10,$04,$10,$04,$10,$04,$10,$04,$10
    db $04,$10,$04,$10,$0C,$18,$0C,$18,$0C,$18,$0C,$18,$0C,$18,$0C,$18
    db $0C,$18,$0C,$18,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15
    db $09,$15,$09,$15,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17
    db $FF

; Patrol (original)
; Tiny Sound, 7 frames per step
SsRunMel:
    db $44
