cartridge "STAR STRIKE/BOB EATON, AHOY!/1986"

' STAR STRIKE
' After the game by Bob Eaton, Ahoy! June 1986 (Commodore 64, mostly
' machine language), made for the ColecoVision in Amy by Amy Bienvenu.
' By Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' The game (the article, orig/): at the edge of the galaxy, alien ships
' drop out of warp far ahead and rush in; at fighting range they stop
' and manoeuvre in front of you, firing plasma spheres. The stick moves
' the crosshair (and your ship left and right under it); the button
' fires a missile at the crosshair's point, where it arrives 14 frames
' later: whatever is drawn there is hit. Shoot the spheres for extra
' points, or move out of their way. You have 20 shield units: a hit
' costs one, and with none left the next hit destroys you.
'   Phase I: 15 ships, one at a time. Phase II: 20 more, several at once.
'   Phase III: the mother ship. Shields are useless against its ion beam:
'   hit the small port at its centre before it comes within range.
' Four levels (BEGINNER, SKILLED, ADVANCED, NEUROTIC): faster aliens and
' more points. The score, as the listing's end page (lines 970-1110):
' (ships destroyed + spheres destroyed + shield left) x the level's
' points (50, 100, 150, 200), plus 1000 for the mother ship.
'
' The listing is machine code apart from its BASIC frame (the level
' table and the end pages), so the game is built from the article; the
' speeds, the 3-D projection and the hover-and-target fighting are mine
' (after the user's memory of the original).
'
' Controls (either joystick): the stick, the button fires; on the title
' left and right choose the level, up and down START or CREDITS.
'
' House rules kept: text in columns 2-29, tiles from code 128, the frame
' loop is protected from the NMI and every screen is drawn with the NMI
' off after a wait; nothing flashes faster than 3 times a second.

const TBlk = 128
const TSt1 = 129
const TSt2 = 130
const TSt3 = 131
const TGf = 132
const TGl = 133
const TGe = 134
const TMh = 135
const TMt = 136
const TMb = 137
const TMl = 138
const TMr = 139
const TMw = 140
const TMc = 141
const SCross = 0
const SShipa = 4
const SShipb = 8
const SEn0 = 12
const SEn1 = 16
const SEn2 = 20
const SEn3 = 24
const SPl0 = 28
const SPl1 = 32
const SPl2 = 36
const SPl3 = 40
const SMi0 = 44
const SMi1 = 48
const SMi2 = 52
const SMi3 = 56
const SBl1 = 60
const SBl2 = 64
const SPort = 68
const NTiles8 = 112
const SprBytes = 576
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndBoom = 5
const SndHit = 6
const SndShot = 7
const SndPop = 8
const SndPhase = 9
const SndWin = 10
const SndOver = 11
const SndBeam = 12
u16 TzLeft = 0
u8 TzOn = 0

' the crosshair's corner (Cx also your ship's), the ship's row
u8 Cx = 120
u8 Cy = 80
' the missile: Mon flying, Mz its frame (0-14: it reaches the crosshair's
' point at 14), Mx My its screen centre, Mtx Mty the point aimed at,
' Mxw Myw its place x 256 and Mvx Mvy its steps (two's complement)
u8 Mon = 0
u8 Mz = 0
u8 Mx = 0
u8 My = 0
u8 Mtx = 0
u8 Mty = 0
u16 Mxw = 0
u16 Myw = 0
u16 Mvx = 0
u16 Mvy = 0
' the aliens: Est 0 none, 1 warping in, 2 bursting (Ebt frames), 3
' hovering; Ez the distance x 16; Ex Ey the world place (warping in); Hx
' Hy the sprite's corner on screen (hovering, in the crosshair's range);
' Edx Edy the drift (0 -1, 1 0, 2 +1); Efz frames to its next sphere; Ect
' frames to a new drift
u8 Est[3]
u8 Ebt[3]
u16 Ez[3]
u8 Ex[3]
u8 Ey[3]
u8 Edx[3]
u8 Edy[3]
u8 Efz[3]
u8 Ect[3]
u8 Hx[3]
u8 Hy[3]
' the plasma spheres: Pon flying, Pz distance (24 at the alien, 0 at you),
' Pxw Pyw the screen centre x 256, Pvx Pvy their steps a frame
u8 Pon[3]
u8 Pz[3]
u16 Pxw[3]
u16 Pyw[3]
u16 Pvx[3]
u16 Pvy[3]
' the mother ship: Mst 0 none, 1 coming, 2 destroyed; Mm distance x 16;
' Mg the picture's size (0-3, 255 none); Mc0 Mc1 Mr0 Mr1 its cells
u8 Mst = 0
u16 Mm = 0
u8 Mg = 255
u8 Mc0 = 40
u8 Mc1 = 0
u8 Mr0 = 40
u8 Mr1 = 0
u8 Mft = 0
' Nm: the mother ship's distance this frame
u8 Nm = 0
' the stars: Sd the direction (0-15), Sr the distance, Sa the cell shown
u8 Sd[16]
u8 Sr[16]
u16 Sa[16]
' the mission: Lv 1-4, A the level's points, Spd the aliens' speed
' (1/16 a frame), Ph the phase, E ships destroyed, F spheres destroyed,
' Sh the shield, Took hits taken, Gap frames to the next alien
u8 Lv = 1
u16 A = 50
u8 Spd = 16
u8 Ph = 1
u8 E = 0
u8 F = 0
u8 Sh = 20
u8 Took = 0
u8 Gap = 0
u16 Score = 0
u16 Hi = 0
u16 Bonus = 0
' Over: 0 playing, 1 destroyed, 2 the ion beam, 3 won
u8 Over = 0
u8 Idle = 0
u16 Rs = $3C5A
u8 Menu = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rg1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u16 Tm = 0
u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 S = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Qx = 0
u8 Qy = 0
' Hb: the high byte of SsMul's product; Rot the sprites' turn (0-2)
u8 Hb = 0
u8 Rot = 0

  tile screen
  set sound table SsSoundTable areas 6
  sprites 16x16
  set sprite count 11
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  ' the level table (lines 160-175): points 50-200, the aliens faster
  A = Lv * 50
  Spd = Lv * 6
  Spd = Spd + 10
  Ph = 1
  E = 0
  F = 0
  Sh = 20
  Took = 0
  Over = 0
  Score = 0
  Bonus = 0
  Mon = 0
  Mst = 0
  Mg = 255
  Mc0 = 40
  Mc1 = 0
  Cx = 120
  Cy = 80
  for I = 0 to 2
    Est[I] = 0
    Pon[I] = 0
  next
  DrawField
  ShowHud
  ShowScreen
  PhasePause

fly:
  Frame1
  ReadPad
  MoveShip
  Stars
  if Ph < 3 then
    Spawn
  else
    Mother
  end if
  MoveAliens
  MoveSpheres
  MoveMissile
  DrawAll
  if Over > 0 then goto ending
  ' the phases: 15 ships, then 20 more, then the mother ship
  if Ph = 1 then
    if E >= 15 then
      Ph = 2
      PhasePause
    end if
  end if
  if Ph = 2 then
    if E >= 35 then
      Ph = 3
      PhasePause
      Mst = 1
      Mm = 4080
      Mft = 60
    end if
  end if
  goto fly

ending:
  stop sound SndRunA
  stop sound SndRunB
  mute all
  if Over < 3 then
    play sound SndBoom
    play sound SndOver
  else
    play sound SndWin
  end if
  for Tm = 0 to 50
    Frame1
    if Over < 3 then
      V = Tm >> 3
      V = V & 1
      V = V * 4
      V = V + SBl1
      set sprite 1 to 160,Cx,V,11
      set sprite 2 to 160,Cx,V,8
    end if
    update sprites
  next
  ' the end page (lines 970-1110)
  W16 = Sh
  W16 = W16 + E
  W16 = W16 + F
  Score = W16 * A
  Score = Score + Bonus
  if Score > Hi then Hi = Score
  PlainPage
  if Over = 1 then
    print at 4,3, "YOU HAVE BEEN DESTROYED!"
  end if
  if Over = 2 then
    print at 4,3, "THE ION BEAM GOT THROUGH!"
  end if
  if Over = 3 then
    print at 6,3, "CONGRATULATIONS!"
    print at 3,4, "YOU HAVE COMPLETED YOUR"
    print at 11,5, "MISSION."
  end if
  print at 10,7, "STAR STRIKE"
  print at 12,8, "SCORES"
  print at 3,10, "ALIEN SHIPS DESTROYED"
  NumU = E
  print at 25,10, digits$(NumU, 3)
  print at 3,11, "ALIEN FIRE DESTROYED"
  NumU = F
  print at 25,11, digits$(NumU, 3)
  print at 3,12, "REMAINING SHIELD"
  NumU = Sh
  print at 25,12, digits$(NumU, 3)
  print at 3,13, "LEVEL POINTS"
  NumU = A
  print at 25,13, digits$(NumU, 3)
  print at 3,15, "BONUS FOR THE MOTHER SHIP"
  NumU = Bonus
  print at 24,16, digits$(NumU, 4)
  print at 3,18, "GRAND TOTAL"
  NumU = Score
  print at 23,18, digits$(NumU, 5)
  print at 3,19, "HI SCORE"
  NumU = Hi
  print at 23,19, digits$(NumU, 5)
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  for Tm = 1 to 60
    Frame1
  next
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------

' Rnd: the next random byte (a 16-bit xorshift)
function Rnd() as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  V = Rs & 255
  return V

' Dist(A, B): how far apart two bytes are
function Dist(u8 P1, u8 P2) as u8
  if P1 >= P2 then return P1 - P2
  return P2 - P1

' Scale(Z): the perspective scale for a distance (255 near, 15 far)
function Scale(u8 Z) as u8
  V = Z >> 2
  V = PzT[V]
  return V

' Proj(P, Q, Sc): the screen place of the world place P, Q at scale Sc,
' in Qx, Qy (the world's middle, 128 and 128, is the screen's 128, 96)
sub Proj(u8 P, u8 Q, u8 Sc):
  S = Sc
  if P >= 128 then
    V = P - 128
    call asm SsMul
    Qx = Hb + 128
  else
    V = 128 - P
    call asm SsMul
    Qx = 128 - Hb
  end if
  if Q >= 128 then
    V = Q - 128
    call asm SsMul
    Qy = Hb + 96
  else
    V = 128 - Q
    call asm SsMul
    Qy = 96 - Hb
  end if
  return
end sub

' SizeOf(Sc): the drawing (0 small - 3 full) for a scale
function SizeOf(u8 Sc) as u8
  if Sc >= 170 then return 3
  if Sc >= 100 then return 2
  if Sc >= 50 then return 1
  return 0

' MoveShip: left and right move the ship and the crosshair, up and down
' the crosshair (2 pixels a frame); the button fires a missile
sub MoveShip:
  if Lf1 = 1 then
    if Cx > 18 then Cx = Cx - 2
  end if
  if Rg1 = 1 then
    if Cx < 222 then Cx = Cx + 2
  end if
  if Up1 = 1 then
    if Cy > 22 then Cy = Cy - 2
  end if
  if Dn1 = 1 then
    if Cy < 136 then Cy = Cy + 2
  end if
  if Press = 1 then
    if Mon = 0 then
      ' from the ship (its nose, x Cx+8, y 160) to the crosshair's centre,
      ' 14 frames
      Mon = 1
      Mz = 0
      Mtx = Cx + 8
      Mty = Cy + 8
      Mx = Mtx
      My = 160
      Mxw = 0
      Mvx = 0
      W16 = My
      Myw = W16 << 8
      W16 = Mtx
      Mxw = W16 << 8
      V = 160 - Mty
      W16 = V
      W16 = W16 << 8
      W16 = W16 / 14
      Mvy = 0 - W16
      play sound SndShot
    end if
  end if
  return
end sub

' Spawn: phase I one alien at a time, phase II up to three; never more
' flying than kills left in the phase
sub Spawn:
  if Gap > 0 then
    dec Gap
    return
  end if
  N = 0
  for I = 0 to 2
    if Est[I] > 0 then inc N
  next
  if Ph = 1 then
    if N > 0 then return
    V = 15 - E
  else
    if N >= 3 then return
    V = 35 - E
  end if
  if N >= V then return
  for I = 0 to 2
    if Est[I] = 0 then
      NewAlien(I)
      Gap = 50
      if Ph = 1 then Gap = 20
      return
    end if
  next
  return
end sub

sub NewAlien(u8 L):
  Est[L] = 1
  Ez[L] = 4080
  V = Rnd()
  V = V & 127
  Ex[L] = V + 64
  V = Rnd()
  V = V & 63
  Ey[L] = V + 88
  V = Rnd()
  V = V & 63
  Efz[L] = V + 110
  NewDrift(L)
  return
end sub

sub NewDrift(u8 L):
  V = Rnd()
  W = V & 3
  if W = 3 then W = 1
  Edx[L] = W
  V = V >> 2
  W = V & 3
  if W = 3 then W = 1
  Edy[L] = W
  V = Rnd()
  V = V & 31
  Ect[L] = V + 30
  return
end sub

' MoveAliens: every alien comes nearer and drifts; it fires once on its
' way; one that gets past flies off (and comes back later)
sub MoveAliens:
  for I = 0 to 2
    if Est[I] = 1 then
      ' out of warp: five times the old pace, to the combat distance (24)
      W16 = Spd * 5
      A16 = W16 + 384
      if Ez[I] <= A16 then
        ' it stops and turns to fight: its sprite's corner on screen
        Ez[I] = 384
        S = Scale(24)
        Proj(Ex[I], Ey[I], S)
        V = Qx - 8
        if V < 18 then V = 18
        if V > 222 then V = 222
        Hx[I] = V
        V = Qy - 8
        if V < 22 then V = 22
        if V > 136 then V = 136
        Hy[I] = V
        Est[I] = 3
        NewDrift(I)
        FireWait(I)
      else
        Ez[I] = Ez[I] - W16
      end if
    else
      if Est[I] = 3 then
        ' hovering: it wanders over the crosshair's range, bouncing at the
        ' edges, a pixel a frame (two from ADVANCED)
        K = 1
        if Lv >= 3 then K = 2
        X = Hx[I]
        if Edx[I] = 0 then
          if X < 20 then
            Edx[I] = 2
          else
            X = X - K
          end if
        end if
        if Edx[I] = 2 then
          if X > 220 then
            Edx[I] = 0
          else
            X = X + K
          end if
        end if
        Hx[I] = X
        Y = Hy[I]
        if Edy[I] = 0 then
          if Y < 24 then
            Edy[I] = 2
          else
            Y = Y - K
          end if
        end if
        if Edy[I] = 2 then
          if Y > 134 then
            Edy[I] = 0
          else
            Y = Y + K
          end if
        end if
        Hy[I] = Y
        dec Ect[I]
        if Ect[I] = 0 then NewDrift(I)
        dec Efz[I]
        if Efz[I] = 0 then
          X = Hx[I] + 8
          Y = Hy[I] + 8
          NewSphere(X, Y)
          FireWait(I)
        end if
      else
        if Est[I] = 2 then
          dec Ebt[I]
          if Ebt[I] = 0 then Est[I] = 0
        end if
      end if
    end if
  next
  return
end sub

' FireWait(L): frames to alien L's next sphere, shorter at higher levels
sub FireWait(u8 L):
  V = Rnd()
  V = V & 31
  W = Lv * 15
  W = 110 - W
  Efz[L] = V + W
  return
end sub

' NewSphere(X0, Y0, Z0): a plasma sphere from there, aimed at your ship
' (where it is now: move and it misses)
sub NewSphere(u8 X0, u8 Y0):
  for K = 0 to 2
    if Pon[K] = 0 then
      Pon[K] = 1
      Pz[K] = 24
      W16 = X0
      Pxw[K] = W16 << 8
      W16 = Y0
      Pyw[K] = W16 << 8
      ' 24 frames to your ship, aimed where it is now (move and it misses)
      X = Cx + 8
      W16 = Dist(X, X0)
      W16 = W16 << 8
      W16 = W16 / 24
      if X < X0 then W16 = 0 - W16
      Pvx[K] = W16
      Y = 168
      W16 = Dist(Y, Y0)
      W16 = W16 << 8
      W16 = W16 / 24
      if Y < Y0 then W16 = 0 - W16
      Pvy[K] = W16
      return
    end if
  next
  return
end sub

' MoveSpheres: 3 nearer a frame; at your ship's distance it hits the
' ship if it is within 18 pixels across, else it misses
sub MoveSpheres:
  for I = 0 to 2
    if Pon[I] = 1 then
      Pxw[I] = Pxw[I] + Pvx[I]
      Pyw[I] = Pyw[I] + Pvy[I]
      if Pz[I] <= 1 then
        Pon[I] = 0
        W16 = Pxw[I] >> 8
        X = W16
        V = Cx + 8
        V = Dist(X, V)
        if V < 18 then TakeHit
      else
        dec Pz[I]
      end if
    end if
  next
  return
end sub

sub TakeHit:
  inc Took
  play sound SndHit
  if Sh = 0 then
    Over = 1
    return
  end if
  dec Sh
  ShowShield
  return
end sub

' MoveMissile: 6 farther a frame; it meets an alien or a sphere within
' 8 of its distance and 14 of its place (world units); the mother ship's
' port within 10 and 8
sub MoveMissile:
  if Mon = 0 then return
  inc Mz
  Mxw = Mxw + Mvx
  Myw = Myw + Mvy
  W16 = Mxw >> 8
  Mx = W16
  W16 = Myw >> 8
  My = W16
  if Mz < 14 then return
  ' it reaches the point aimed at: whatever is drawn there is hit
  Mon = 0
  for I = 0 to 2
    if Est[I] = 3 then
      X = Hx[I] + 8
      Y = Hy[I] + 8
      V = Dist(X, Mtx)
      W = Dist(Y, Mty)
      if V <= 9 then
        if W <= 9 then
          Est[I] = 2
          Ebt[I] = 24
          inc E
          AddPoints
          play sound SndBoom
          return
        end if
      end if
    end if
    if Pon[I] = 1 then
      W16 = Pxw[I] >> 8
      X = W16
      W16 = Pyw[I] >> 8
      Y = W16
      V = Dist(X, Mtx)
      W = Dist(Y, Mty)
      if V <= 8 then
        if W <= 8 then
          Pon[I] = 0
          inc F
          AddPoints
          play sound SndPop
          return
        end if
      end if
    end if
  next
  if Mst = 1 then
    ' the port, drawn at 120,88 (its centre 128,96)
    V = Dist(Mtx, 128)
    W = Dist(Mty, 96)
    if V <= 8 then
      if W <= 8 then
        Mst = 2
        Bonus = 1000
        play sound SndBoom
        return
      end if
    end if
  end if
  return
end sub

' AddPoints: the score shown (ships and spheres times the level's points)
sub AddPoints:
  W16 = E
  W16 = W16 + F
  Score = W16 * A
  ShowScore
  return
end sub

' Mother: the mother ship comes slowly; it fires now and then; in range
' (distance 24) its ion beam goes through the shields
sub Mother:
  if Mst = 2 then
    inc Mft
    if Mft >= 60 then Over = 3
    return
  end if
  ' out of warp fast to distance 128, then slowly
  W16 = Spd >> 1
  if Mm > 2048 then W16 = Spd * 4
  Mm = Mm - W16
  W16 = Mm >> 4
  Nm = W16
  S = Scale(Nm)
  V = 0
  if S >= 25 then V = 1
  if S >= 50 then V = 2
  if S >= 85 then V = 3
  if V <> Mg then DrawMother(V)
  dec Mft
  if Mft = 0 then
    NewSphere(128, 96)
    Mft = 70 - Spd
  end if
  if Nm <= 24 then
    play sound SndBeam
    Over = 2
  end if
  return
end sub

' DrawMother(G): the picture at size G (4 x 2 up to 20 x 8 cells), the
' old one cleared
sub DrawMother(u8 G):
  ClearMother
  Mg = G
  W = MotW[G]
  N = MotH[G]
  V = W >> 1
  Mc0 = 16 - V
  Mc1 = Mc0 + W
  dec Mc1
  V = N >> 1
  Mr0 = 12 - V
  Mr1 = Mr0 + N
  dec Mr1
  for Y = Mr0 to Mr1
    for X = Mc0 to Mc1
      K = TMh
      if Y = Mr0 then K = TMt
      if Y = Mr1 then K = TMb
      if X = Mc0 then K = TMl
      if X = Mc1 then K = TMr
      if K = TMh then
        V = X & 3
        if V = 1 then K = TMw
        if G >= 2 then
          if X >= 15 then
            if X <= 16 then
              if Y >= 11 then
                if Y <= 12 then K = TMc
              end if
            end if
          end if
        end if
      end if
      put char K at X,Y
    next
  next
  return
end sub

sub ClearMother:
  if Mc0 > Mc1 then return
  for Y = Mr0 to Mr1
    for X = Mc0 to Mc1
      put char TBlk at X,Y
    next
  next
  Mc0 = 40
  Mc1 = 0
  return
end sub

' Stars: 8 of the 16 stars move each frame, outward and faster as they
' go, from the middle; one leaving the field starts again near it
sub Stars:
  V = Tick & 1
  I = V << 3
  N = I + 7
st_next:
  A16 = Sa[I]
  if A16 > 0 then vpoke vram.name + A16, TBlk
  Sa[I] = 0
  W = Sr[I]
  V = W >> 3
  W = W + V
  inc W
  Sr[I] = W
  K = Sd[I]
  ' the place: the middle plus the direction times the distance
  ' (the cell: the middle, 16 and 12, plus the product / 512)
  S = W
  V = UxT[K]
  if V >= 128 then
    V = V - 128
    call asm SsMul
    X = Hb >> 1
    if X > 14 then goto st_new
    X = X + 16
  else
    V = 128 - V
    call asm SsMul
    X = Hb >> 1
    if X > 15 then goto st_new
    X = 16 - X
  end if
  V = UyT[K]
  if V >= 128 then
    V = V - 128
    call asm SsMul
    Y = Hb >> 1
    if Y > 9 then goto st_new
    Y = Y + 12
  else
    V = 128 - V
    call asm SsMul
    Y = Hb >> 1
    if Y > 9 then goto st_new
    Y = 12 - Y
  end if
  if X < 2 then goto st_new
  if X > 29 then goto st_new
  if Y < 3 then goto st_new
  if Y > 20 then goto st_new
  ' not on the mother ship
  if X >= Mc0 then
    if X <= Mc1 then
      if Y >= Mr0 then
        if Y <= Mr1 then goto st_skip
      end if
    end if
  end if
  A16 = Y * 32
  A16 = A16 + X
  Sa[I] = A16
  K = TSt1
  if W >= 40 then K = TSt2
  if W >= 90 then K = TSt3
  vpoke vram.name + A16, K
  goto st_skip
st_new:
  V = Rnd()
  Sd[I] = V & 15
  V = V >> 4
  Sr[I] = V + 6
st_skip:
  if I = N then return
  inc I
  goto st_next
end sub

' DrawAll: the crosshair, your ship, the missile, the aliens and the
' spheres (their order turning each frame so a crowded line flickers),
' the mother ship's port (pulsing twice a second)
sub DrawAll:
  set sprite 0 to Cy,Cx,SCross,15
  set sprite 1 to 160,Cx,SShipa,5
  set sprite 2 to 160,Cx,SShipb,8
  if Mon = 1 then
    ' it shrinks as it flies off
    V = MiSz[Mz]
    V = V * 4
    V = V + SMi0
    X = Mx - 8
    Y = My - 8
    set sprite 3 to Y,X,V,11
  else
    set sprite 3 to 192,0,0,0
  end if
  for I = 0 to 2
    J = I + Rot
    if J >= 3 then J = J - 3
    J = J + 4
    if Est[I] = 0 then
      set sprite J to 192,0,0,0
    else
      if Est[I] = 1 then
        W16 = Ez[I] >> 4
        V = W16
        S = Scale(V)
        Proj(Ex[I], Ey[I], S)
        X = Qx - 8
        Y = Qy - 8
      else
        X = Hx[I]
        Y = Hy[I]
        S = 102
      end if
      if Est[I] <> 2 then
        V = SizeOf(S)
        V = V * 4
        V = V + SEn0
        W = EnCol[I]
      else
        V = Ebt[I] >> 3
        V = V & 1
        V = V * 4
        V = V + SBl1
        W = 11
        if Ebt[I] < 10 then W = 9
      end if
      set sprite J to Y,X,V,W
    end if
    J = J + 3
    if Pon[I] = 0 then
      set sprite J to 192,0,0,0
    else
      S = Scale(Pz[I])
      W16 = Pxw[I] >> 8
      X = W16 - 8
      W16 = Pyw[I] >> 8
      Y = W16 - 8
      V = SizeOf(S)
      V = V * 4
      V = V + SPl0
      set sprite J to Y,X,V,13
    end if
  next
  if Mst = 1 then
    V = Tick & 16
    W = 9
    if V = 0 then W = 11
    set sprite 10 to 88,120,SPort,W
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

' PhasePause: the phase's name for a moment, the field still
sub PhasePause:
  stop sound SndRunA
  stop sound SndRunB
  for I = 0 to 2
    Est[I] = 0
    Pon[I] = 0
  next
  Mon = 0
  if Ph = 1 then print at 11,10, "PHASE I"
  if Ph = 2 then print at 11,10, "PHASE II"
  if Ph = 3 then print at 11,10, "PHASE III"
  print at 10,12, "GET READY!"
  play sound SndPhase
  for Tm = 1 to 100
    Frame1
    ReadPad
    MoveShip
    Mon = 0
    DrawAll
  next
  for X = 10 to 21
    put char TBlk at X,10
    put char TBlk at X,12
  next
  ShowPhase
  play sound SndRunA
  play sound SndRunB
  Gap = 30
  return
end sub

' the field: black space with stars, the shield on row 1, the score
' and phase on row 22
sub DrawField:
  NewScreen
  for Y = 2 to 21
    for X = 0 to 31
      put char TBlk at X,Y
    next
  next
  for I = 0 to 15
    V = Rnd()
    Sd[I] = V & 15
    V = Rnd()
    V = V & 63
    Sr[I] = V + 6
    Sa[I] = 0
  next
  return
end sub

sub ShowHud:
  print at 2,1, "SHIELD"
  ShowShield
  ShowScore
  ShowPhase
  return
end sub

sub ShowShield:
  for I = 1 to 20
    X = I + 8
    if I <= Sh then
      if Sh <= 5 then
        put char TGl at X,1
      else
        put char TGf at X,1
      end if
    else
      put char TGe at X,1
    end if
  next
  return
end sub

sub ShowScore:
  print at 2,22, "SCORE"
  NumU = Score
  print at 8,22, digits$(NumU, 5)
  return
end sub

sub ShowPhase:
  print at 16,22, "PHASE"
  if Ph = 1 then print at 22,22, "I  "
  if Ph = 2 then print at 22,22, "II "
  if Ph = 3 then print at 22,22, "III"
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  inc Rot
  if Rot >= 3 then Rot = 0
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rg1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rg1 = 1
  if joypad(2).right then Rg1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn = 1
  if joypad(2).button2 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 11
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub PlainPage:
  NewScreen
  return
end sub

' the title: the level (left and right) and START or CREDITS (up, down)
sub TitlePage:
  PlainPage
  for I = 1 to 30
    V = Rnd()
    X = V & 31
    if X < 2 then X = 2
    if X > 29 then X = 29
    V = Rnd()
    Y = V & 15
    Y = Y + 2
    V = Rnd()
    V = V & 1
    V = V + TSt1
    put char V at X,Y
  next
  print at 7,5, "S T A R   S T R I K E"
  print at 4,8, "DEFEND THE EDGE OF THE"
  print at 4,9, "GALAXY. AIM AND FIRE!"
  print at 9,12, "LEVEL"
  print at 12,16, "START"
  print at 12,17, "CREDITS"
  print at 10,20, "HI"
  NumU = Hi
  print at 13,20, digits$(NumU, 5)
  ShowLevel
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 384
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  V = Rnd()
  ReadPad
  V = Up1 | Dn1
  W = Lf1 | Rg1
  N = V | W
  if N = 1 then
    if WasStick = 0 then
      if V = 1 then
        Menu = Menu ^ 1
        ShowMenu
      end if
      if Lf1 = 1 then
        if Lv > 1 then dec Lv
        ShowLevel
      end if
      if Rg1 = 1 then
        if Lv < 4 then inc Lv
        ShowLevel
      end if
    end if
  end if
  WasStick = N
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowLevel:
  print at 15,12, "<          >"
  if Lv = 1 then print at 17,12, "BEGINNER"
  if Lv = 2 then print at 17,12, "SKILLED"
  if Lv = 3 then print at 17,12, "ADVANCED"
  if Lv = 4 then print at 17,12, "NEUROTIC"
  return
end sub

sub ShowMenu:
  print at 10,16, " "
  print at 10,17, " "
  V = Menu + 16
  put char 62 at 10,V
  return
end sub

sub CreditsPage:
  PlainPage
  print at 10,3, "STAR STRIKE"
  print at 3,5, "BASED ON STAR STRIKE BY"
  print at 3,6, "BOB EATON, AHOY! JUNE 1986"
  print at 3,7, "(COMMODORE 64)."
  print at 3,9, "MADE FOR THE COLECOVISION"
  print at 3,10, "BY CLAUDE (AN AI MADE BY"
  print at 3,11, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,12, "2026, IN AMY BY AMY"
  print at 3,13, "BIENVENU."
  print at 3,15, "MUSIC: EDGE OF THE GALAXY,"
  print at 3,16, "PATROL"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
cr_loop:
  Frame1
  ReadPad
  if Press = 0 then goto cr_loop
  return
end sub

