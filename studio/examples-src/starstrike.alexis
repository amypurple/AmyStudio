    db $02,$70,$18,$32,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13,$07,$13
    db $07,$13,$07,$13,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17,$0B,$17
    db $0B,$17,$0B,$17,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12,$06,$12
    db $06,$12,$06,$12
