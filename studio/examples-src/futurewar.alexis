cartridge "FUTUREWAR!/B.W. BEHLING, AHOY!/1985"

' FUTUREWAR!
' A ColecoVision game based on "Futurewar!" by B. W. Behling, Ahoy!
' February 1985 (Commodore 64 BASIC, 46 blocks, disk ahoy1985-02; the
' author and "(C) Copyright 1984" are on the program's title screen).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy
' by Amy Bienvenu.
'
' The game: a war for 36 sectors of space, nine columns of four, laid out
' as a honeycomb (each sector touches up to six others). Each player in
' turn claims an empty sector (one army goes there) until all 36 are
' taken, then places the rest of the starting armies one at a time on
' their own sectors. Then each turn: new armies to station on your own
' sectors, as many attacks as you like, and one troop move.
'
' From the original (orig/futurewar.bas):
' - the 9 x 4 board and its neighbours (lines 366-376 and 524-558: the
'   same column one row up or down, the next columns on the same row and,
'   for odd columns, one row up, for even ones, one row down)
' - starting armies 32 - 5 * (players - 3) each (line 122), a random
'   first player, one army per claimed sector
' - new armies each turn: three quarters of the sectors owned (at least
'   3), plus up to half again at random, plus 8 for every whole column
'   owned (lines 276-288)
' - the attack: from a sector with more than one army into a touching
'   enemy sector, with a strength from 1 to its armies - 1; one die each
'   per point of strength, the defender wins ties, each lost roll kills
'   one army; it stops when the defender has none left (the sector is
'   conquered) or the attacker is down to one (lines 382-410)
' - a conquered sector: move in at least the attack's strength (as cut
'   by line 400), at most all but one army (lines 422-444)
' - one troop move between touching sectors of your own (lines 450-504)
' - a player with no sector is skipped; owning all 36 wins
' - the computer players, rule for rule: claiming by sweeping the board
'   (the second player down from a random column, the others up), random
'   reinforcing, stationing next to a random enemy sector in amounts up to
'   a fifth of what is left, a 1-in-10 chance to stop before each attack,
'   the first enemy sector (from a random column) next to one of its
'   sectors with more than 2 armies and at least half the defender's,
'   strength chosen at random (at least two thirds of the defender's when
'   it has more than the defender), attacking again while it has more than
'   half the defender's, moving in a random number at least the minimum,
'   never moving troops (lines 180-206, 234-244, 510-648)
' - the bomb sound of each battle (lines 38-54), the closing messages
'
' Improvements: the board as coloured hexagons with each player's emblem
' and the armies on a plate; a joystick cursor instead of typing sector
' numbers; battle bursts, sounds and an original title tune; the panel
' shows whose turn it is, what to do and each battle's losses.
'
' Liberties:
' - up to four players (the original allowed six): each one HUMAN on
'   joystick 1, HUMAN on joystick 2, COMPUTER or OFF, chosen on the title
'   page (at least two in play; several humans can share a joystick).
'   The original added computers by itself: two for one human, one for
'   two; the title starts with you against two computers.
' - fixed: in the claiming and placing phases the listing compares the
'   player number with NPT (a misspelt NP, always 0), so player 1 took
'   every turn; here the turn goes round as intended, and placing goes on
'   until everyone's starting armies are down
' - fixed: the troop move's neighbour test (lines 486-494) let some
'   sectors that don't touch pass; here it is the same test as attacks
' - a sector holds at most 99 armies (two digits on the plate); stationing
'   and moving stop there
' - "same attack again?": after a battle you simply choose again (the
'   source stays marked); the computer follows line 580
' - the random half-again bonus is counted in hundredths (0 to 49%)
' - the strength and troop numbers are set with the stick (up/down by
'   one, left/right to the least or most) instead of typed
' - game end: the message, then the title (no restart questions)
'
' Controls: the stick moves the cursor from sector to sector; the left
' button chooses; the right button ends the attacks, skips the troop move
' or backs out of a choice. In number choices: up/down one more or less,
' left the least, right the most, left button to confirm.
'
' House rules: text in columns 2-29 and rows 1-22, the board in columns
' 2-28 and rows 1-18; tiles from code 128; the frame loop is protected
' from the NMI; screens drawn with the NMI off after a wait, display off;
' music first in the sound table; the title tune is played once; nothing
' flashes.
'
' Workarounds for Amy bugs future-function-goto removed 2026-11-01.

const TF0tl = 128
const TF0t = 129
const TF0tr = 130
const TF0l = 131
const TF0m = 132
const TF0r = 133
const TF0bl = 134
const TF0b = 135
const TF0br = 136
const TF1tl = 137
const TF1t = 138
const TF1tr = 139
const TF1l = 140
const TF1m = 141
const TF1r = 142
const TF1bl = 143
const TF1b = 144
const TF1br = 145
const TF2tl = 146
const TF2t = 147
const TF2tr = 148
const TF2l = 149
const TF2m = 150
const TF2r = 151
const TF2bl = 152
const TF2b = 153
const TF2br = 154
const TF3tl = 155
const TF3t = 156
const TF3tr = 157
const TF3l = 158
const TF3m = 159
const TF3r = 160
const TF3bl = 161
const TF3b = 162
const TF3br = 163
const TF4tl = 164
const TF4t = 165
const TF4tr = 166
const TF4l = 167
const TF4m = 168
const TF4r = 169
const TF4bl = 170
const TF4b = 171
const TF4br = 172
const TTen0 = 173
const TTen1 = 174
const TTen2 = 175
const TTen3 = 176
const TTen4 = 177
const TTen5 = 178
const TTen6 = 179
const TTen7 = 180
const TTen8 = 181
const TTen9 = 182
const TTenx = 183
const TUni0 = 184
const TUni1 = 185
const TUni2 = 186
const TUni3 = 187
const TUni4 = 188
const TUni5 = 189
const TUni6 = 190
const TUni7 = 191
const TUni8 = 192
const TUni9 = 193
const TStar1 = 194
const TStar2 = 195
const TRule = 196
const TChip1 = 197
const TChip2 = 198
const TChip3 = 199
const TChip4 = 200
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const SRing = 16
const SBurst = 20
const NTiles8 = 584
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndPick = 4
const SndPlace = 5
const SndBuzz = 6
const SndRoll = 7
const SndWhistle = 8
const SndBoom = 9
const SndConquer = 10
const SndWin = 11
const NSpr = 6
const NSec = 36

' stars in the gaps: rows 1-2 above the even columns, 17-18 below the
' odd ones, column 29
data StarX bytes
  6, 12, 18, 24, 3, 9, 15, 21, 27, 29, 29, 29, 5, 17, 26, 11
end data
data StarY bytes
  1, 2, 1, 2, 17, 18, 17, 18, 17, 3, 8, 14, 2, 2, 18, 1
end data

record Plr:
  u8 Kind
  u8 Lft
  u8 Own
  u8 Pad
end record

' the sectors: owner (0 nobody, 1-4 player + 1) and armies, sector
' S = column * 4 + row (columns 0-8, rows 0-3)
u8 Ow[36]
u8 Ar[36]
Plr Pl[4]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 Rt = 0
u16 W16 = 0
u16 NumU = 0
u16 RsB = 0
' the start of a game, for the tests: random state, first player, sweeps
u16 Rs0 = 0
u8 Pt0 = 0
u8 Pd0 = 0
u8 Pu0 = 0
bcd digits 3 Turn = 0
' players: Pt the one to move, Np in play; Winner 255 none yet
u8 Pt = 0
u8 Np = 0
u8 Winner = 255
' the phase: 0 title, 1 claim, 2 place, 3 station, 4 attack, 5 move, 6 over
u8 Ph = 0
' the cursor sector, the attack source (255 none)
u8 Cs = 13
u8 Src = 255
' the computers' claiming sweeps (down, up)
u8 Pd = 0
u8 Pu = 0
' the last battle: strength, attacker's losses, defender's losses,
' conquered, the least to move in
u8 As = 0
u8 Al = 0
u8 Dl = 0
u8 Cq = 0
u8 Mn = 0
' the action log for the tests: count, kind (1 claim, 2 place, 3 station,
' 4 battle, 5 move in, 6 troop move, 7 income), from, to, number
u16 ActN = 0
u8 ActK = 0
u8 ActS = 0
u8 ActT = 0
u8 ActC = 0
' Quick 1: the computers don't pause (bots)
u8 Quick = 0
' input
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Bt2 = 0
u8 WasBtn = 0
u8 WasB2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Rep = 0
u8 Menu = 0
u8 TitleOn = 0
u8 Pg = 0
u8 Tick = 0
u8 Idle = 0
' InSel: 1 while a human chooses a sector, 2 a number (for the tests)
u8 InSel = 0
' loop counters, each one used by one routine only
u8 Pi = 0
u8 Ki = 0
u8 Ri = 0
u8 Ci = 0
u8 Mi = 0
u8 Si = 0
' scratch
u8 Ca = 0
u8 Cb = 0
u8 Cx = 0
u8 Cy = 0
u8 Ta = 0
u8 Tb = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  ' the players start as: you (stick 1) against two computers
  Pl[0].Kind = 1
  Pl[1].Kind = 3
  Pl[2].Kind = 3
  Pl[3].Kind = 0
  CreditsPage

title:
  TitlePage
  if Menu = 5 then goto title
  NewGame
  ClaimPhase
  PlacePhase
main_loop:
  if Pl[Pt].Own > 0 then
    Turn += 1
    TakeTurn
    if Winner < 255 then goto game_over
  end if
  NextPlayer
  goto main_loop

game_over:
  Ph = 6
  HideCursor
  ClearPanel
  mute all
  play sound SndWin
  PlrName(Winner, 2, 20)
  print at 9,20, "HOLDS ALL 36 SECTORS"
  if Pl[Winner].Kind = 3 then
    print at 2,21, "YOU HUMANS ARE SO EASY"
    print at 2,22, "TO BEAT!"
  else
    print at 2,21, "YOU WON! YOU ARE A TRUE"
    print at 2,22, "CHAMPION!!"
  end if
  ' a press goes back to the title; left alone, the screen sleeps after
  ' 30 seconds to spare the TV, and a press wakes it
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (model.mjs is the same in JavaScript)

' Rnd16: the random numbers (16-bit xorshift)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' Rmod(N): 0 to N - 1 (0 when N is 0)
function Rmod(u8 Rn) as u8
  u8 Rv
  Rnd16
  if Rn = 0 then return 0
  W16 = Rs % Rn
  Rv = W16
  return Rv

' Nbr(S, D): the D-th neighbour of sector S (0-5, the listing's order:
' row up, row down, column left, column right, then the two slanted
' ones), 255 when it is off the board
function Nbr(u8 Ns, u8 Nd) as u8
  u8 Nc
  u8 Nr
  u8 Nq
  Nc = Ns >> 2
  Nr = Ns & 3
  Nq = Nc & 1
  select case Nd
  case 0
    if Nr > 0 then return Ns - 1
  case 1
    if Nr < 3 then return Ns + 1
  case 2
    if Nc > 0 then return Ns - 4
  case 3
    if Nc < 8 then return Ns + 4
  case 4
    if Nq = 1 then
      if Nr < 3 then return Ns - 3
    else
      if Nc > 0 then
        if Nr > 0 then return Ns - 5
      end if
    end if
  case 5
    if Nq = 1 then
      if Nr < 3 then return Ns + 5
    else
      if Nc < 8 then
        if Nr > 0 then return Ns + 3
      end if
    end if
  end select
  return 255

' Adj(S, T): 1 when the two sectors touch
function Adj(u8 As1, u8 As2) as u8
  u8 Ad
  for Ad = 0 to 5
    if Nbr(As1, Ad) = As2 then return 1
  next
  return 0

' NewGame: the players, the starting armies, an empty board
sub NewGame:
  Np = 0
  for Pi = 0 to 3
    Pl[Pi].Own = 0
    Pl[Pi].Lft = 0
    if Pl[Pi].Kind > 0 then inc Np
  next
  ' 32 - 5 * (players - 3), line 122
  V = Np * 5
  V = 47 - V
  for Pi = 0 to 3
    if Pl[Pi].Kind > 0 then Pl[Pi].Lft = V
  next
  for Si = 0 to 35
    Ow[Si] = 0
    Ar[Si] = 0
  next
  Turn = 0
  Winner = 255
  Src = 255
  Cs = 13
  ActN = 0
  ' the first player at random, the computers' sweeps (line 150)
  V = Rmod(Np)
  Pt = 255
  for Pi = 0 to 3
    if Pl[Pi].Kind > 0 then
      if Pt = 255 then
        if V = 0 then Pt = Pi
        if V > 0 then dec V
      end if
    end if
  next
  V = Rmod(9)
  Pd = V << 2
  Pd = Pd + 3
  V = Rmod(9)
  Pu = V << 2
  Rs0 = Rs
  Pt0 = Pt
  Pd0 = Pd
  Pu0 = Pu
  DrawBoard
  return
end sub

' NextPlayer: the next player in play (round the table)
sub NextPlayer:
  for Ri = 1 to 4
    Pt = Pt + 1
    Pt = Pt & 3
    if Pl[Pt].Kind > 0 then return
  next
  return
end sub

' ClaimPhase: in turn, an empty sector each, until all 36 are taken
sub ClaimPhase:
  Ph = 1
  for Mi = 1 to NSec
    Head(1)
    if Pl[Pt].Kind = 3 then
      N = CpuClaim
      Pause(14)
    else
      N = 255
      while N = 255
        N = HumanSector
        if N < 255 then
          if Ow[N] > 0 then
            Refuse(1)
            N = 255
          end if
        end if
      end while
    end if
    Ow[N] = Pt + 1
    Ar[N] = 1
    Pl[Pt].Lft -= 1
    Pl[Pt].Own += 1
    DrawCell(N)
    play sound SndPick
    Logit(1, N, N, 1)
    NextPlayer
  next
  return
end sub

' CpuClaim: the next empty sector on this computer's sweep (lines 180-206)
function CpuClaim as u8
  if Pt = 1 then
    while Ow[Pd] > 0
      if Pd = 0 then
        Pd = 35
      else
        dec Pd
      end if
    end while
    return Pd
  end if
  while Ow[Pu] > 0
    inc Pu
    if Pu = 36 then Pu = 0
  end while
  return Pu

' PlacePhase: in turn, one army each on an own sector, until all are down
sub PlacePhase:
  Ph = 2
pp_next:
  V = 0
  for Pi = 0 to 3
    V = V + Pl[Pi].Lft
  next
  if V = 0 then return
  if Pl[Pt].Lft = 0 then
    NextPlayer
    goto pp_next
  end if
  Head(2)
  if Pl[Pt].Kind = 3 then
    N = CpuPlace
    Pause(10)
  else
    N = 255
    while N = 255
      N = HumanSector
      if N < 255 then
        V = Pt + 1
        if Ow[N] <> V then
          Refuse(2)
          N = 255
        elseif Ar[N] >= 99 then
          Refuse(4)
          N = 255
        end if
      end if
    end while
  end if
  inc Ar[N]
  Pl[Pt].Lft -= 1
  DrawCell(N)
  play sound SndPlace
  Logit(2, N, N, 1)
  NextPlayer
  goto pp_next
end sub

' CpuPlace: a random sector of its own (lines 234-244)
function CpuPlace as u8
  u8 Cp
  V = Pt + 1
cp_again:
  Cp = Rmod(NSec)
  if Ow[Cp] <> V then goto cp_again
  if Ar[Cp] >= 99 then goto cp_again
  return Cp

' Income: this turn's new armies (lines 276-288)
function Income as u8
  u8 Io
  u8 Ib
  u8 Ic
  u16 Iw
  Io = 0
  Ib = 0
  V = Pt + 1
  for Ic = 0 to 8
    W = 0
    for K = 0 to 3
      J = Ic << 2
      J = J + K
      if Ow[J] = V then inc W
    next
    Io = Io + W
    if W = 4 then Ib = Ib + 8
  next
  Iw = Io * 3
  Iw = Iw >> 2
  if Iw < 3 then Iw = 3
  RsB = Rs
  K = Rmod(50)
  W16 = Iw * K
  W16 = W16 / 100
  Iw = Iw + W16
  Iw = Iw + Ib
  if Iw > 250 then Iw = 250
  Io = Iw
  return Io

' TakeTurn: station, attack, move
sub TakeTurn:
  Src = 255
  ShowRing
  Pl[Pt].Lft = Income
  Logit(7, 0, 0, Pl[Pt].Lft)
  Ph = 3
  while Pl[Pt].Lft > 0
    Head(3)
    if Pl[Pt].Kind = 3 then
      CpuStation
    else
      HumanStation
    end if
  end while
  Ph = 4
  if Pl[Pt].Kind = 3 then
    CpuAttack
    Pause(20)
    return
  end if
  HumanAttack
  if Winner < 255 then return
  Ph = 5
  HumanMove
  return
end sub

' HumanStation: one sector and how many go there
sub HumanStation:
  N = HumanSector
  if N = 255 then return
  V = Pt + 1
  if Ow[N] <> V then
    Refuse(2)
    return
  end if
  V = 99 - Ar[N]
  if V = 0 then
    Refuse(4)
    return
  end if
  W = Pl[Pt].Lft
  if W > V then W = V
  K = HumanNum(1, W, W, 1)
  if K = 0 then return
  Station(N, K)
  return
end sub

' Station(S, N): N new armies to sector S
sub Station(u8 Sn, u8 Sk):
  Ar[Sn] = Ar[Sn] + Sk
  Pl[Pt].Lft -= Sk
  DrawCell(Sn)
  play sound SndPlace
  Logit(3, Sn, Sn, Sk)
  return
end sub

' CpuStation: next to a random enemy sector, up to a fifth of what is
' left (lines 590-648)
sub CpuStation:
  u8 Ce
  u8 Cn
  u8 Ck
  V = Pt + 1
cs_again:
  Ce = Rmod(NSec)
  if Ow[Ce] = V then goto cs_again
  Cn = 255
  for Ck = 0 to 5
    if Cn = 255 then
      W = Nbr(Ce, Ck)
      if W < 255 then
        if Ow[W] = V then Cn = W
      end if
    end if
  next
  if Cn = 255 then goto cs_again
  if Ar[Cn] >= 99 then goto cs_again
  W = Pl[Pt].Lft
  K = Rmod(W)
  inc K
  if K >= 10 then
    W = W / 5
    if K > W then K = W
    if K < 1 then K = 1
  end if
  W = 99 - Ar[Cn]
  if K > W then K = W
  Cs = Cn
  ShowCursor
  Pause(16)
  Station(Cn, K)
  Pause(8)
  return
end sub

' HumanAttack: source, target, strength, as often as wanted
sub HumanAttack:
ha_top:
  if Src = 255 then
    Head(4)
    N = HumanSector
    if N = 255 then return
    V = Pt + 1
    if Ow[N] <> V then
      Refuse(2)
      goto ha_top
    end if
    if Ar[N] < 2 then
      Refuse(5)
      goto ha_top
    end if
    Src = N
    ShowRing
    play sound SndPick
  end if
  Head(5)
  N = HumanSector
  if N = 255 then
    Src = 255
    ShowRing
    goto ha_top
  end if
  if N = Src then
    Src = 255
    ShowRing
    goto ha_top
  end if
  V = Pt + 1
  if Ow[N] = V then
    ' another sector of yours: it becomes the source
    if Ar[N] < 2 then
      Refuse(5)
    else
      Src = N
      ShowRing
      play sound SndPick
    end if
    goto ha_top
  end if
  if Adj(Src, N) = 0 then
    Refuse(3)
    goto ha_top
  end if
  W = Ar[Src] - 1
  K = HumanNum(1, W, W, 1)
  if K = 0 then goto ha_top
  Battle(Src, N, K)
  if Cq = 1 then
    MoveIn(Src, N)
    if Winner < 255 then return
    Src = 255
    ShowRing
  elseif Ar[Src] < 2 then
    Src = 255
    ShowRing
  end if
  goto ha_top
end sub

' HumanMove: one troop move between touching sectors of your own
sub HumanMove:
  u8 Hf
hm_top:
  Head(6)
  Hf = HumanSector
  if Hf = 255 then return
  V = Pt + 1
  if Ow[Hf] <> V then
    Refuse(2)
    goto hm_top
  end if
  if Ar[Hf] < 2 then
    Refuse(5)
    goto hm_top
  end if
  Src = Hf
  ShowRing
  Head(7)
  N = HumanSector
  Src = 255
  ShowRing
  if N = 255 then goto hm_top
  V = Pt + 1
  if Ow[N] <> V then
    Refuse(2)
    goto hm_top
  end if
  if Adj(Hf, N) = 0 then
    Refuse(3)
    goto hm_top
  end if
  W = Ar[Hf] - 1
  V = 99 - Ar[N]
  if W > V then W = V
  if W = 0 then
    Refuse(4)
    goto hm_top
  end if
  K = HumanNum(1, W, W, 1)
  if K = 0 then goto hm_top
  Ar[Hf] = Ar[Hf] - K
  Ar[N] = Ar[N] + K
  DrawCell(Hf)
  DrawCell(N)
  play sound SndPlace
  Logit(6, Hf, N, K)
  return
end sub

' Battle(A, D, N): N dice for the attacker (lines 390-410); Al and Dl the
' losses, Cq 1 when the sector falls
sub Battle(u8 Ba, u8 Bd, u8 Bn):
  u8 Bk
  u8 Ra
  u8 Rd
  RsB = Rs
  As = Bn
  Al = 0
  Dl = 0
  Cq = 0
  Bk = 0
  while Bk < Bn
    inc Bk
    Ra = Rmod(6)
    Rd = Rmod(6)
    if Ra > Rd then
      inc Dl
    else
      inc Al
    end if
    V = Ar[Bd] - Dl
    W = Ar[Ba] - Al
    if V = 0 then
      Cq = 1
      ' line 400: the least to move in
      X = W - 1
      if As > X then As = X
      Bk = Bn
    elseif W < 2 then
      Bk = Bn
    end if
  end while
  ' the show: the bomb falls on the target
  Cs = Bd
  ShowCursor
  CellXY(Bd)
  X = Cx << 3
  X = X + 4
  Y = Cy << 3
  Y = Y + 7
  set sprite 5 to Y,X,SBurst,13
  update sprites
  play sound SndWhistle
  Pause(24)
  play sound SndBoom
  Ar[Ba] = Ar[Ba] - Al
  Ar[Bd] = Ar[Bd] - Dl
  DrawCell(Ba)
  DrawCell(Bd)
  ClearLine(21)
  print at 2,21, "LOST"
  NumU = Al
  print at 7,21, width$(NumU, 2)
  print at 11,21, "KILLED"
  NumU = Dl
  print at 18,21, width$(NumU, 2)
  Logit(4, Ba, Bd, Bn)
  Pause(20)
  set sprite 5 to 192,0,0,0
  update sprites
  if Cq = 1 then
    play sound SndConquer
    ClearLine(21)
    print at 2,21, "SECTOR CONQUERED!"
  end if
  return
end sub

' MoveIn(A, D): the conquered sector changes hands and the armies move in
sub MoveIn(u8 Ma, u8 Md):
  u8 Mo
  u8 Mx
  Mo = Ow[Md] - 1
  Pl[Mo].Own -= 1
  Ow[Md] = Pt + 1
  Pl[Pt].Own += 1
  Mx = Ar[Ma] - 1
  if As >= Mx then
    K = Mx
  elseif Pl[Pt].Kind = 3 then
    ' lines 584-586
    K = 0
    while K < As
      K = Rmod(Ar[Ma])
    end while
    Pause(10)
  else
    Head(8)
    K = HumanNum(As, Mx, As, 0)
  end if
  Ar[Md] = K
  Ar[Ma] = Ar[Ma] - K
  DrawCell(Ma)
  DrawCell(Md)
  Logit(5, Ma, Md, K)
  if Pl[Pt].Own = NSec then Winner = Pt
  return
end sub

' CpuAttack: the computer's attacks (lines 320, 510-582)
sub CpuAttack:
  u8 Fa
  u8 Fd
  u8 Fs
  u8 Fc
  u8 Fr
  u8 Fk
ca_top:
  Head(4)
  K = Rmod(100)
  if K >= 89 then return
  ' the first enemy sector, from a random column, next to a sector of
  ' its own with more than 2 armies (the first such neighbour decides)
  Fs = Rmod(9)
  Fd = 255
  V = Pt + 1
  for Fc = 1 to 9
    inc Fs
    if Fs = 9 then Fs = 0
    for Fr = 0 to 3
      if Fd = 255 then
        J = Fs << 2
        J = J + Fr
        if Ow[J] <> V then
          Fa = 255
          for Fk = 0 to 5
            if Fa = 255 then
              W = Nbr(J, Fk)
              if W < 255 then
                if Ow[W] = V then
                  if Ar[W] > 2 then Fa = W
                end if
              end if
            end if
          next
          if Fa < 255 then
            ' line 562: not when it has under half the defender's
            W = Ar[Fa] << 1
            if W >= Ar[J] then Fd = J
          end if
        end if
      end if
    next
  next
  if Fd = 255 then return
ca_again:
  Src = Fa
  ShowRing
  Head(5)
  Cs = Fd
  ShowCursor
  Pause(16)
  W = Ar[Fa] - 1
  if W = 1 then
    K = 1
  else
ca_str:
    K = Rmod(W)
    inc K
    if W > Ar[Fd] then
      X = Ar[Fd] << 1
      X = X / 3
      if K < X then goto ca_str
    end if
  end if
  Battle(Fa, Fd, K)
  Src = 255
  ShowRing
  if Cq = 1 then
    MoveIn(Fa, Fd)
    if Winner < 255 then return
    goto ca_top
  end if
  if Ar[Fa] < 2 then goto ca_top
  ' line 580: again while it has more than half the defender's
  W = Ar[Fa] << 1
  if W > Ar[Fd] then goto ca_again
  goto ca_top
end sub

' Logit: one action for the tests, then a frame so they see it
sub Logit(u8 Lk, u8 Ls, u8 Lt, u8 Lc):
  ActK = Lk
  ActS = Ls
  ActT = Lt
  ActC = Lc
  inc ActN
  Frame1
  Frame1
  return
end sub

' ---------------------------------------------------------------------------
' the human players: the cursor and the number choice

' HumanSector: the cursor until the left button (the sector) or the right
' button (255)
function HumanSector as u8
  InSel = 1
  ShowCursor
  WasBtn = 1
  WasB2 = 1
  Rep = 0
hs_loop:
  Frame1
  ReadPad
  V = 0
  if Up1 = 1 then V = 1
  if Dn1 = 1 then V = 2
  if Lf1 = 1 then V = 3
  if Rt1 = 1 then V = 4
  if V = 0 then
    Rep = 0
  elseif Rep = 0 then
    CurMove(V)
    Rep = 14
  else
    dec Rep
    if Rep = 0 then
      CurMove(V)
      Rep = 8
    end if
  end if
  if Press = 1 then
    InSel = 0
    return Cs
  end if
  if Press2 = 1 then
    InSel = 0
    return 255
  end if
  goto hs_loop
  return 255

' CurMove(D): 1 up, 2 down, 3 left, 4 right (the row is kept)
sub CurMove(u8 Cd):
  Ca = Cs >> 2
  Cb = Cs & 3
  select case Cd
  case 1
    if Cb = 0 then return
    dec Cs
  case 2
    if Cb = 3 then return
    inc Cs
  case 3
    if Ca = 0 then return
    Cs = Cs - 4
  case 4
    if Ca = 8 then return
    Cs = Cs + 4
  end select
  play sound SndStep
  ShowCursor
  return
end sub

' HumanNum(Lo, Hi, Start, CanCancel): a number with the stick; 0 when the
' right button backs out
function HumanNum(u8 Lo, u8 Hi, u8 Hs, u8 Hc) as u8
  u8 Hv
  u8 Hd
  Hv = Hs
  ClearLine(22)
  print at 2,22, "HOW MANY?"
  print at 15,22, "FROM"
  NumU = Lo
  print at 20,22, width$(NumU, 2)
  print at 23,22, "TO"
  NumU = Hi
  print at 26,22, width$(NumU, 2)
  WasBtn = 1
  WasB2 = 1
  Rep = 0
  Hd = 0
  while Hd = 0
  NumU = Hv
  print at 12,22, width$(NumU, 2)
  InSel = 2
  Frame1
  ReadPad
  V = 0
  if Up1 = 1 then V = 1
  if Dn1 = 1 then V = 2
  if Lf1 = 1 then V = 3
  if Rt1 = 1 then V = 4
  if V = 0 then
    Rep = 0
  else
    if Rep > 0 then
      dec Rep
    end if
    if Rep = 0 then
      select case V
      case 1
        if Hv < Hi then inc Hv
      case 2
        if Hv > Lo then dec Hv
      case 3
        Hv = Lo
      case 4
        Hv = Hi
      end select
      play sound SndStep
      Rep = 6
    end if
  end if
  if Press = 1 then Hd = 1
  if Press2 = 1 then
    if Hc = 1 then
      Hd = 1
      Hv = 0
    end if
  end if
  end while
  InSel = 0
  ClearLine(22)
  return Hv

' Refuse(R): the reason a choice is refused
sub Refuse(u8 Rr):
  play sound SndBuzz
  ClearLine(21)
  select case Rr
  case 1
    print at 2,21, "ALREADY PICKED"
  case 2
    print at 2,21, "NOT YOUR SECTOR!"
  case 3
    print at 2,21, "SECTORS DO NOT CONNECT"
  case 4
    print at 2,21, "NO ROOM: 99 IS THE MOST"
  case 5
    print at 2,21, "NOT ENOUGH ARMIES"
  end select
  return
end sub

' ---------------------------------------------------------------------------
' the screen

' CellXY(S): the sector's top-left tile Cx, Cy
sub CellXY(u8 Xs):
  Ca = Xs >> 2
  Cb = Xs & 3
  Cx = Ca * 3
  Cx = Cx + 2
  Cy = Cb << 2
  Cy = Cy + 1
  V = Ca & 1
  if V = 1 then Cy = Cy + 2
  return
end sub

' DrawCell(S): the hexagon in its owner's colour, the armies on the plate
sub DrawCell(u8 Ds):
  CellXY(Ds)
  Ta = Ow[Ds] * 9
  Ta = Ta + TF0tl
  put char Ta at Cx,Cy
  Tb = Ta + 1
  X = Cx + 1
  put char Tb at X,Cy
  Tb = Ta + 2
  X = Cx + 2
  put char Tb at X,Cy
  Y = Cy + 1
  Tb = Ta + 3
  put char Tb at Cx,Y
  Tb = Ta + 4
  X = Cx + 1
  put char Tb at X,Y
  Tb = Ta + 5
  X = Cx + 2
  put char Tb at X,Y
  Y = Cy + 2
  Tb = Ta + 3
  put char Tb at Cx,Y
  if Ar[Ds] = 0 then
    Tb = Ta + 1
    X = Cx + 1
    put char Tb at X,Y
    Tb = Ta + 5
    X = Cx + 2
    put char Tb at X,Y
  else
    V = Ar[Ds] / 10
    W = Ar[Ds] % 10
    if V = 0 then
      Tb = TTenx
    else
      Tb = TTen0 + V
    end if
    X = Cx + 1
    put char Tb at X,Y
    Tb = TUni0 + W
    X = Cx + 2
    put char Tb at X,Y
  end if
  Y = Cy + 3
  Tb = Ta + 6
  put char Tb at Cx,Y
  Tb = Ta + 7
  X = Cx + 1
  put char Tb at X,Y
  Tb = Ta + 8
  X = Cx + 2
  put char Tb at X,Y
  return
end sub

sub DrawBoard:
  NewScreen
  ' stars in the gaps of the honeycomb
  for Ki = 0 to 15
    X = StarX[Ki]
    Y = StarY[Ki]
    V = Ki & 1
    if V = 1 then
      put char TStar1 at X,Y
    else
      put char TStar2 at X,Y
    end if
  next
  for Si = 0 to 35
    DrawCell(Si)
  next
  fill TRule count 28 at 2,19
  ShowScreen
  return
end sub

' Head(H): whose turn and what to do
sub Head(u8 Hh):
  ClearPanel
  V = TChip1 + Pt
  put char V at 2,20
  PlrName(Pt, 4, 20)
  if Hh >= 3 then
    print at 21,20, "TURN"
    print at 26,20, Turn
  end if
  select case Hh
  case 1
    print at 11,20, "CLAIM"
    print at 2,21, "PICK AN EMPTY SECTOR"
  case 2
    print at 11,20, "REINFORCE"
    print at 2,21, "ARMIES LEFT"
    NumU = Pl[Pt].Lft
    print at 14,21, width$(NumU, 2)
  case 3
    print at 11,20, "STATION"
    print at 2,21, "ARMIES TO STATION"
    NumU = Pl[Pt].Lft
    print at 20,21, width$(NumU, 3)
  case 4
    print at 11,20, "ATTACK"
    print at 2,21, "PICK A SECTOR TO ATTACK"
    print at 2,22, "FROM  (RIGHT BUTTON: END)"
  case 5
    print at 11,20, "ATTACK"
    print at 2,21, "PICK THE TARGET"
    print at 2,22, "(RIGHT BUTTON: BACK)"
  case 6
    print at 11,20, "MOVE"
    print at 2,21, "MOVE TROOPS FROM"
    print at 2,22, "(RIGHT BUTTON: END TURN)"
  case 7
    print at 11,20, "MOVE"
    print at 2,21, "MOVE TROOPS TO"
    print at 2,22, "(RIGHT BUTTON: BACK)"
  case 8
    print at 11,20, "CONQUERED"
    print at 2,21, "ARMIES TO MOVE IN"
  end select
  if Pl[Pt].Kind = 3 then
    ClearLine(22)
    print at 2,22, "THE COMPUTER IS THINKING"
  end if
  return
end sub

' PlrName(P, X, Y): the player's colour name
sub PlrName(u8 Pp, u8 Px, u8 Py):
  select case Pp
  case 0
    print at Px,Py, "RED"
  case 1
    print at Px,Py, "BLUE"
  case 2
    print at Px,Py, "YELLOW"
  case else
    print at Px,Py, "GREEN"
  end select
  return
end sub

sub ClearLine(u8 Ly):
  fill 32 count 28 at 2,Ly
  return
end sub

sub ClearPanel:
  for Ci = 20 to 22
    fill 32 count 28 at 2,Ci
  next
  return
end sub

' the cursor: four corner sprites round sector Cs
sub ShowCursor:
  CellXY(Cs)
  X = Cx << 3
  X = X - 2
  Y = Cy << 3
  Y = Y - 3
  set sprite 0 to Y,X,SCtl,15
  W = X + 12
  set sprite 1 to Y,W,SCtr,15
  V = Y + 20
  set sprite 2 to V,X,SCbl,15
  set sprite 3 to V,W,SCbr,15
  update sprites
  return
end sub

sub HideCursor:
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' the ring round the attack (or move) source
sub ShowRing:
  if Src = 255 then
    set sprite 4 to 192,0,0,0
  else
    CellXY(Src)
    X = Cx << 3
    X = X + 4
    Y = Cy << 3
    Y = Y + 7
    set sprite 4 to Y,X,SRing,15
  end if
  update sprites
  return
end sub

' Pause(N): N frames (1 when the bots ask for Quick)
sub Pause(u8 Pn):
  u8 Pf
  if Quick = 1 then Pn = 1
  for Pf = 1 to Pn
    Frame1
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: the controller of the player to move (either one on menus and
' for the computers' turns)
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Bt2 = 0
  V = 3
  if Ph > 0 then
    if Ph < 6 then V = Pl[Pt].Kind
  end if
  if V <> 2 then
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).button1 then Btn = 1
    if joypad(1).button2 then Bt2 = 1
  end if
  if V <> 1 then
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).button1 then Btn = 1
    if joypad(2).button2 then Bt2 = 1
  end if
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Bt2 = 1 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = Bt2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the setup of the four players, START, CREDITS
sub TitlePage:
  Ph = 0
  TitleOn = 0
  NewScreen
  for Ki = 0 to 15
    X = StarX[Ki]
    Y = StarY[Ki]
    put char TStar1 at X,Y
  next
  fill TRule count 28 at 2,3
  print at 10,2, "FUTUREWAR!"
  print at 7,4, "BY B. W. BEHLING"
  print at 7,5, "AHOY! FEBRUARY 1985"
  fill TRule count 28 at 2,6
  print at 3,8, "THE WAR FOR 36 SECTORS"
  for Ki = 0 to 3
    Y = Ki << 1
    Y = Y + 10
    V = TChip1 + Ki
    put char V at 4,Y
    PlrName(Ki, 6, Y)
  next
  print at 6,18, "START THE WAR"
  print at 6,20, "CREDITS"
  print at 3,22, "STICK: CHOOSE AND CHANGE"
  Menu = 4
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  TitleOn = 1
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then MenuMove
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu < 4 then
    Rt1 = 1
    MenuMove
    goto tp_loop
  end if
  if Menu = 4 then
    N = 0
    for Ki = 0 to 3
      if Pl[Ki].Kind > 0 then inc N
    next
    if N < 2 then
      play sound SndBuzz
      print at 3,22, "AT LEAST TWO MUST PLAY!  "
      goto tp_loop
    end if
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 5 then CreditsPage
  return
end sub

' MenuMove: up/down choose a line, left/right (or the button) change it
sub MenuMove:
  if Up1 = 1 then
    if Menu > 0 then dec Menu
  elseif Dn1 = 1 then
    if Menu < 5 then inc Menu
  elseif Menu < 4 then
    V = Pl[Menu].Kind
    if Lf1 = 1 then
      if V = 0 then
        V = 3
      else
        dec V
      end if
    else
      inc V
      if V = 4 then V = 0
    end if
    Pl[Menu].Kind = V
  end if
  play sound SndStep
  ShowMenu
  return
end sub

sub ShowMenu:
  for Ki = 0 to 3
    Y = Ki << 1
    Y = Y + 10
    select case Pl[Ki].Kind
    case 0
      print at 14,Y, "OFF          "
    case 1
      print at 14,Y, "HUMAN STICK 1"
    case 2
      print at 14,Y, "HUMAN STICK 2"
    case 3
      print at 14,Y, "COMPUTER     "
    end select
  next
  for Ki = 0 to 5
    Y = Ki << 1
    Y = Y + 10
    put char 32 at 2,Y
  next
  Y = Menu << 1
  Y = Y + 10
  put char 62 at 2,Y
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "FUTUREWAR!"
  print at 2,5, "BASED ON FUTUREWAR! BY"
  print at 2,6, "B. W. BEHLING, AHOY!"
  print at 2,7, "FEBRUARY 1985 (COMMODORE 64"
  print at 2,8, "BASIC, (C) 1984)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SECTOR THIRTY-SIX"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Pg = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Pg = 0
  return
end sub


