asm {
NnTick:
    db $80,$40,$50,$02,$90
NnRight:
    db $80,$D6,$30,$02,$80,$AA,$30,$02,$80,$8F,$30,$02,$80,$6B,$30,$02,$80,$55,$30,$02,$80,$47,$30,$02
    db $80,$35,$40,$08,$90
NnWrong:
    db $80,$F9,$32,$0A,$80,$F9,$43,$10,$90
NnStart:
    db $80,$1D,$31,$05,$80,$E2,$30,$05,$80,$BF,$40,$0C,$90
NnOver:
    db $80,$BF,$30,$08,$80,$E2,$30,$08,$80,$FE,$30,$08,$80,$1D,$41,$14,$90

NnSoundTable:
    dw NnTuneMel,$702B
    dw NnTuneBass,$7035
    dw NnTick,$7053
    dw NnRight,$7053
    dw NnWrong,$7053
    dw NnStart,$7053
    dw NnOver,$7053
; Chalk on the Board (original)
; Tiny Sound, 9 frames per step
NnTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$1A,$01,$1C,$1E,$01,$21,$23,$01,$21,$1E,$01,$01
    db $1F,$01,$1E,$1C,$01,$1A,$19,$01,$1C,$21,$01,$01,$1A,$01,$1C,$1E
    db $01,$21,$26,$01,$23,$21,$01,$1E,$1F,$01,$1C,$19,$01,$1C,$1A,$01
    db $01,$01,$01,$01,$00,$01,$01,$01,$01,$01
    db $FF
NnTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$0E,$01,$01,$09,$01,$01,$07,$01,$01,$0E,$01,$01
    db $10,$01,$01,$0B,$01,$01,$09,$01,$01,$09,$01,$01,$0E,$01,$01,$12
    db $01,$01,$13,$01,$01,$0E,$01,$01,$10,$01,$01,$09,$01,$01,$0E,$01
    db $01,$01,$01,$01,$00,$01,$01,$01,$01,$01
    db $FF
; PsgNote: start the quiz note: period AMY_UVAR_Pp on tone 1, or on tone 3
; (silent) driving periodic noise when AMY_UVAR_Pn = 1; loudness AMY_UVAR_Va
; (same method as games/ntnote)
PsgNote:
  ld a,$9F
  out ($FF),a
  ld a,$FF
  out ($FF),a
  ld a,(AMY_UVAR_Pn)
  or a
  ld b,$80
  jr z,PsgNoteP
  ld b,$C0
PsgNoteP:
  ld hl,(AMY_UVAR_Pp)
  ld a,l
  and $0F
  or b
  out ($FF),a
  ld a,l
  rrca
  rrca
  rrca
  rrca
  and $0F
  ld c,a
  ld a,h
  add a,a
  add a,a
  add a,a
  add a,a
  or c
  and $3F
  out ($FF),a
  ld a,(AMY_UVAR_Pn)
  or a
  jr z,PsgVol
  ld a,$DF
  out ($FF),a
  ld a,$E3
  out ($FF),a
PsgVol:
  ld a,(AMY_UVAR_Pn)
  or a
  ld b,$90
  jr z,PsgVolP
  ld b,$F0
PsgVolP:
  ld a,(AMY_UVAR_Va)
  and $0F
  or b
  out ($FF),a
  ret
}
