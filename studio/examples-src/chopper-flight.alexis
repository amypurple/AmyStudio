CfMove:
    db $40,$55,$40,$02,$50

CfSoundTable:
    dw CfTuneMel,$702B
    dw CfTuneBass,$7035
    dw CfChop,$703F
    dw CfWarn,$7049
    dw CfLaunch,$703F
    dw CfRescue,$7049
    dw CfBoom,$703F
    dw CfAlarm,$7049
    dw CfLand,$7049
    dw CfCount,$7049
    dw CfStart,$7049
    dw CfMove,$7049
; Rotor Wash (original)
; Tiny Sound, 8 frames per step
CfTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$1A,$21,$21,$01,$01,$1C,$01,$21,$01,$24,$01,$23,$01,$21
    db $01,$1F,$1C,$01,$1D,$01,$01,$1F,$01,$21,$01,$01,$24,$01,$23,$01
    db $1F,$01,$01,$01,$21,$01,$01,$1C,$01,$21,$01,$24,$01,$26,$01,$28
    db $01,$26,$24,$23,$24,$01,$23,$01,$1F,$01,$23,$01,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
CfTuneBass:
