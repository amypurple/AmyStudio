  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $9C,$9D,$9C,$9D,$9C,$9D,$9C,$9E,$9F,$9F,$9F,$9F,$9F,$A0,$A0,$A0,$A0,$A0,$A0,$9F,$9F,$9F,$9F,$9F,$A1,$A2,$A3,$A2,$A3,$A2,$A3,$A2
  db $A4,$A5,$A4,$A5,$A4,$A5,$A4,$A5,$A6,$A7,$A8,$A8,$A6,$A9,$AA,$AA,$AB,$A9,$AA,$A8,$A6,$A7,$A8,$A8,$AC,$AD,$AC,$AD,$AC,$AD,$AC,$AD
  db $AE,$AE,$AE,$AE,$AE,$AE,$AE,$AE,$AF,$B0,$AE,$AE,$AF,$B0,$AE,$AE,$AF,$B0,$AE,$AE,$AF,$B0,$AE,$AE,$AE,$AE,$AE,$AE,$AE,$AE,$AE,$AE
  db $B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1,$B1
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $81,$82,$81,$82,$81,$82,$81,$83,$84,$84,$85,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$86,$84,$84,$87,$88,$89,$88,$89,$88,$89,$88
  db $8A,$8B,$8A,$8B,$8A,$8B,$8A,$8C,$8D,$8D,$8E,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$8F,$8D,$8D,$90,$91,$92,$91,$92,$91,$92,$91
  db $93,$94,$93,$94,$93,$94,$93,$95,$96,$96,$97,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$98,$96,$96,$99,$9A,$9B,$9A,$9B,$9A,$9B,$9A
ChNameB:
  db $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  db $CD,$CD,$CD,$CD,$CD,$CD,$CD,$CE,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$CF,$D0,$D0,$D0,$D0,$D0,$D0,$D0
  db $D1,$D1,$D1,$D1,$D1,$D1,$D1,$D2,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$D3,$D4,$D4,$D4,$D4,$D4,$D4,$D4
  db $D5,$D6,$D5,$D6,$D5,$D6,$D5,$D7,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$D8,$D9,$DA,$D9,$DA,$D9,$DA,$D9
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $CD,$CE,$CD,$CE,$CD,$CE,$CD,$CF,$D0,$D0,$D0,$D0,$D0,$D1,$D1,$D1,$D1,$D1,$D1,$D0,$D0,$D0,$D0,$D0,$D2,$D3,$D4,$D3,$D4,$D3,$D4,$D3
  db $D5,$D6,$D5,$D6,$D5,$D6,$D5,$D6,$D7,$D8,$D9,$D9,$D7,$DA,$DB,$DB,$DC,$DA,$DB,$D9,$D7,$D8,$D9,$D9,$DD,$DE,$DD,$DE,$DD,$DE,$DD,$DE
  db $DF,$DF,$DF,$DF,$DF,$DF,$DF,$DF,$E0,$E1,$DF,$DF,$E0,$E1,$DF,$DF,$E0,$E1,$DF,$DF,$E0,$E1,$DF,$DF,$DF,$DF,$DF,$DF,$DF,$DF,$DF,$DF
  db $E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2,$E2
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  db $B2,$B3,$B2,$B3,$B2,$B3,$B2,$B4,$B5,$B5,$B6,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$B7,$B5,$B5,$B8,$B9,$BA,$B9,$BA,$B9,$BA,$B9
  db $BB,$BC,$BB,$BC,$BB,$BC,$BB,$BD,$BE,$BE,$BF,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$C0,$BE,$BE,$C1,$C2,$C3,$C2,$C3,$C2,$C3,$C2
  db $C4,$C5,$C4,$C5,$C4,$C5,$C4,$C6,$C7,$C7,$C8,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$C9,$C7,$C7,$CA,$CB,$CC,$CB,$CC,$CB,$CC,$CB
ChFRow EQU 18
ChNS EQU 1
ChSlotLen EQU 72
ChCodeBOff EQU 392

; ChPat: for each pair in PList, its run of patterns at offset ChFine
; (ChStream, made by art.py) to its codes in the hidden set, then its run
; of colours. The page is hidden, so the VDP is written at the slow rate
; (30 cycles a byte) while the screen is on.
ChPat:
  push ix
  ld a,(AMY_UVAR_PCount)
  or a
  jr z,ChPatEnd
  ld b,a
  ld ix,AMY_UVAR_PList
ChPatPair:
  push bc
  ld a,(ix+0)
  inc ix
  cp 16
  jr nc,ChPatSlot
  ld e,a
  ld d,0
  ld hl,ChPLen
  add hl,de
  ld a,(hl)
  or a
  jr z,ChPatNext
  ld (AMY_UVAR_ChLen),a
  ; the stream: ChSPtr[8p + s]
  ex de,hl
  add hl,hl
  push hl
  add hl,hl
  add hl,hl
  add hl,hl
  ld a,(AMY_UVAR_ChFine)
  add a,a
  ld e,a
  ld d,0
  add hl,de
  ld de,ChSPtr
  add hl,de
  ld e,(hl)
  inc hl
  ld d,(hl)
  ; the address: ChPAddr[p] (+ the set B offset)
  pop hl
  push de
  ld de,ChPAddr
  add hl,de
  ld e,(hl)
  inc hl
  ld d,(hl)
  ld a,(AMY_UVAR_ChSet)
  or a
  jr z,ChPat1
  ld hl,ChCodeBOff
  add hl,de
  ex de,hl
ChPat1:
  pop hl
ChPatOut:
  ld a,e
  out ($BF),a
  ld a,d
  or $40
  out ($BF),a
  ld a,(AMY_UVAR_ChLen)
  ld b,a
  ld c,$BE
  call ChOutB
  ld a,e
  out ($BF),a
  ld a,d
  add a,$20
  or $40
  out ($BF),a
  ld a,(AMY_UVAR_ChLen)
  ld b,a
  call ChOutB
ChPatNext:
  pop bc
  djnz ChPatPair
  jr ChPatEnd
; a floor slot k = id - 16: it shows floor pair q = (PhTop + k) mod 3
ChPatSlot:
  sub 16
  ld c,a
  ld a,(AMY_UVAR_PhTop)
  add a,c
  cp 3
  jr c,ChPatS1
  sub 3
ChPatS1:
  ; stream ChQPtr[8q + s]
  add a,a
  add a,a
  add a,a
  ld e,a
  ld a,(AMY_UVAR_ChFine)
  add a,e
  add a,a
  ld e,a
  ld d,0
  ld hl,ChQPtr
  add hl,de
  ld e,(hl)
  inc hl
  ld d,(hl)
  push de
  ld a,c
  add a,a
  ld e,a
  ld d,0
  ld hl,ChSlotAddr
  add hl,de
  ld e,(hl)
  inc hl
  ld d,(hl)
  ld a,ChSlotLen
  ld (AMY_UVAR_ChLen),a
  ld a,(AMY_UVAR_ChSet)
  or a
  jr z,ChPatS2
  ld hl,ChCodeBOff
  add hl,de
  ex de,hl
ChPatS2:
  pop hl
  jp ChPatOut
ChPatEnd:
  pop ix
  ret

ChOutB:
  outi
  nop
  jp nz,ChOutB
  ret

; ChStatic: the strips that look the same at every offset, once
ChStatic:
  ld hl,128*8
  ld de,ChStatP
  call ChStat1
  ld hl,$2000+128*8
  ld de,ChStatC
ChStat1:
  ld a,l
  out ($BF),a
  ld a,h
  or $40
  out ($BF),a
  ld c,ChNS
ChStat2:
  ld a,(de)
  inc de
  ld b,8
ChStat3:
  out ($BE),a
  nop
  nop
  nop
  djnz ChStat3
  dec c
  jr nz,ChStat2
  ret

; ChRows: RowP[r] = the pair of world rows Top + r and Top + r + 1 (pre
; rows from PreP, floors by the phase, the street from PostP), then PList,
; the different pairs among them
ChRows:
  push ix
  ld hl,(AMY_UVAR_Top)
  ld c,0
  ld ix,AMY_UVAR_RowP
  ld b,22
ChRw:
  push hl
  ld de,ChFRow
  or a
  sbc hl,de
  jr nc,ChRw2
  pop hl
  push hl
  ld de,AMY_UDATA_PreP
  add hl,de
  ld a,(hl)
  jr ChRwSet
ChRw2:
  pop hl
  push hl
  ld de,(AMY_UVAR_FLast)
  or a
  sbc hl,de
  jr nc,ChRw3
  ld a,c
  add a,16
  jr ChRwSet
ChRw3:
  ld a,h
  or a
  jr nz,ChRw3b
  ld a,l
  cp 4
  jr c,ChRw3c
ChRw3b:
  ld a,3
ChRw3c:
  ld e,a
  ld d,0
  ld hl,AMY_UDATA_PostP
  add hl,de
  ld a,(hl)
ChRwSet:
  ld (ix+0),a
  inc ix
  inc c
  ld a,c
  cp 3
  jr nz,ChRwSet2
  ld c,0
ChRwSet2:
  pop hl
  inc hl
  djnz ChRw
  ; the list
  ld hl,AMY_UVAR_ChSeen
  ld b,24
  xor a
ChRwClr:
  ld (hl),a
  inc hl
  djnz ChRwClr
  ld (AMY_UVAR_PCount),a
  ld ix,AMY_UVAR_RowP
  ld b,22
ChRwL:
  ld c,(ix+0)
  inc ix
  ld e,c
  ld d,0
  ld hl,AMY_UVAR_ChSeen
  add hl,de
  ld a,(hl)
  or a
  jr nz,ChRwL2
  ld (hl),1
  ld a,(AMY_UVAR_PCount)
  ld e,a
  inc a
  ld (AMY_UVAR_PCount),a
  ld hl,AMY_UVAR_PList
  add hl,de
  ld (hl),c
ChRwL2:
  djnz ChRwL
  pop ix
  ret

; ChNames: the field rows (screen rows 2-23) of page ChSet whose content
; id (RowP) differs from what the page shows (PgIdA / PgIdB)
ChNames:
  push ix
  push iy
  ld hl,$1840
  ld de,ChNameA
  ld iy,AMY_UVAR_PgIdA
  ld a,(AMY_UVAR_ChSet)
  or a
  jr z,ChNm1
  ld hl,$1C40
  ld de,ChNameB
  ld iy,AMY_UVAR_PgIdB
ChNm1:
  ld (AMY_UVAR_ChNmBase),de
  ld ix,AMY_UVAR_RowP
  ld b,22
ChNmRow:
  ld a,(ix+0)
  cp (iy+0)
  jr z,ChNmSkip
  ld (iy+0),a
  push bc
  push hl
  ld a,l
  out ($BF),a
  ld a,h
  or $40
  out ($BF),a
  ld a,(ix+0)
  ld l,a
  ld h,0
  add hl,hl
  add hl,hl
  add hl,hl
  add hl,hl
  add hl,hl
  ld de,(AMY_UVAR_ChNmBase)
  add hl,de
  ld bc,$20BE
  call ChOutB
  pop hl
  pop bc
ChNmSkip:
  inc ix
  inc iy
  ld de,32
  add hl,de
  djnz ChNmRow
  pop iy
  pop ix
  ret

; ChFlip: show page Shown (R2 = 6: $1800, 7: $1C00)
ChFlip:
  ld a,(AMY_UVAR_Shown)
  add a,6
  ld c,a
  ld b,2
  call WRITE_REGISTER
  ld bc,$0400
  jp WRITE_REGISTER

; ChHud: copy screen row 1 of page A to page B
ChHud:
  ld a,$20
  out ($BF),a
  ld a,$18
  out ($BF),a
  ld hl,AMY_UVAR_HudB
  ld b,32
ChHud1:
  nop
  nop
  in a,($BE)
  ld (hl),a
  inc hl
  djnz ChHud1
  ld a,$20
  out ($BF),a
  ld a,$5C
  out ($BF),a
  ld hl,AMY_UVAR_HudB
  ld bc,$20BE
  jp ChOutB

CfChop:
    db $00,$00,$66,$01,$00,$00,$A6,$01,$10
CfWarn:
    db $40,$47,$20,$04,$40,$5F,$30,$04,$40,$47,$20,$04,$40,$5F,$30,$04,$50
CfLaunch:
    db $00,$00,$35,$03,$00,$00,$26,$04,$00,$00,$46,$06,$00,$00,$77,$08,$10
CfRescue:
    db $40,$8F,$10,$03,$40,$71,$10,$03,$40,$5F,$10,$03,$40,$47,$20,$08,$50
CfBoom:
    db $00,$00,$04,$04,$00,$00,$05,$06,$00,$00,$16,$08,$00,$00,$36,$0A,$00,$00,$57,$0E,$00,$00,$87,$10
    db $10
CfAlarm:
    db $40,$6B,$20,$06,$40,$7F,$20,$06,$40,$6B,$20,$06,$40,$7F,$30,$06,$50
CfLand:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$06,$40,$8F,$20,$0A,$40,$6B,$20,$18
    db $50
CfCount:
