    db 8
    db $02,$80,$18,$32,$09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$10,$01
    db $07,$01,$0E,$01,$05,$01,$0C,$01,$05,$01,$0C,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$09,$01
    db $0E,$01,$09,$01,$05,$01,$0C,$01,$04,$01,$0B,$01,$09,$01,$01,$01
    db $00,$01,$01,$01
