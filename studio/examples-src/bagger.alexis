' the store: three bag places and three shopper places a belt (index
' belt x 3 + place), a tip a belt, each shopper's look
u8 Bags[12]
u8 Cus[12]
u8 Tips[4]
u8 Kinds[12]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Acc = 0
u16 Score = 0
' the bagger's aisle 1-4, raised arm (1168), throwing pose, throw (02DB)
u8 PRow = 1
u8 Arm = 0
u8 Pose = 0
u8 ThrowRow = 0
u8 Cnt3 = 2
u8 Served = 0
u8 Target = 10
u8 Dly = 5
u8 Lvl = 1
u8 Lives = 4
' what happened in the pass
u8 BagFell = 0
u8 CusOut = 0
u8 TipLost = 0
u8 TipGot = 0
u8 LevelUp = 0
u8 Cause = 0
u8 LostL = 0
u8 LostS = 0
u8 Over = 0
u8 Passes = 0
u8 BeltC = 0
u8 Freeze = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' title animation
u8 TbX = 16
' loop counters (never shared with the helpers)
u8 Lb = 0
u8 Sb = 0
u8 Lt = 0
u8 St = 0
u8 Lc = 0
u8 Sc = 0
u8 Lk = 0
u8 Ck = 0
u8 Bk = 0
u8 Ld = 0
u8 Sd = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Rr = 0
u8 Was = 0
u8 Pp = 0
u8 Fb = 0
u8 Blink = 255

  tile screen
  set sound table BgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawAll
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  print at 9,11, "            "
  print at 9,12, " GAME  OVER "
  print at 9,13, "            "
  mute all
  play sound SndOver
  Rearm
  wait 171 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a random byte as the C64's 1781: an aisle 1-4 (4 chances in 256) or 0
function RndRow as u8
  Rand
  Rr = Rs & 255
  if Rr > 4 then Rr = 0
  return Rr

' the first free place (0-2) on belt L for a bag, 3 when none
function FreeBag(u8 L) as u8
  Fb = L * 3
  for K = 0 to 2
    if Bags[Fb] = 0 then return K
    inc Fb
  next
  return 3

' one frame of play: as many passes as the speed gives, or the pause after
' a lost life
sub PlayFrame:
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then LifeLost
    return
  end if
  W16 = RateT[Dly]
  Acc = Acc + W16
  Passes = 0
  while Acc >= 256
    Acc = Acc - 256
    inc Passes
    OnePass
    if Cause > 0 then
      Acc = 0
      Freeze = 134
      select case Cause
        case 2
          play sound SndWalk
        case else
          play sound SndCrash
      end select
    end if
    if LevelUp = 1 then
      Acc = 0
      NextLevel
    end if
  end while
  return
end sub

' one pass of the C64's main loop ($15E9)
sub OnePass:
  inc BeltC
  dec Cnt3
  if Cnt3 = 0 then
    Cnt3 = 3
    Poll
  end if
  if ThrowRow > 0 then
    K = PRow - 1
    if FreeBag(K) < 3 then play sound SndThrow
  end if
  MoveBags
  ThrowRow = 0
  Rr = RndRow
  MoveTips(Rr)
  if TipGot = 0 then MoveTips(0)
  if TipGot = 1 then
    play sound SndTip
    Score = Score + 20
  end if
  if Served = Target then
    LevelUp = 1
    return
  end if
  Rr = RndRow
  Was = Served
  MoveCus(Rr)
  if Served <> Was then
    Score = Score + 5
    play sound SndServe
  end if
  if BagFell = 1 then
    Cause = 1
  else
    if CusOut = 1 then
      Cause = 2
    else
      if TipLost = 1 then Cause = 3
    end if
  end if
  return
end sub

' the stick, every third pass ($10A3)
sub Poll:
  if Arm = 1 then
    Pose = 0
    Arm = 0
    ThrowRow = PRow
    return
  end if
  V = J1 & 19
  select case V
    case 1
      dec PRow
      if PRow = 0 then PRow = 4
      Pose = 0
    case 2
      inc PRow
      if PRow = 5 then PRow = 1
      Pose = 0
    case 16
      Arm = 1
      Pose = 1
  end select
  return
end sub

' every bag a pixel left; one at X 18 falls off ($09B5); then the throw
sub MoveBags:
  BagFell = 0
  for Sb = 0 to 11
    V = Bags[Sb]
    if V > 0 then
      if V = 18 then
        BagFell = 1
        LostL = LaneOf[Sb]
        LostS = Sb
        return
      end if
      Bags[Sb] = V - 1
    end if
  next
  if ThrowRow > 0 then
    Lb = ThrowRow - 1
    Sb = FreeBag(Lb)
    if Sb < 3 then
      Sb = Lb * 3 + Sb
      Bags[Sb] = 255
    end if
  end if
  return
end sub

' every tip a pixel right; a new one in aisle R; the catch ($0D38)
sub MoveTips(u8 R):
  TipLost = 0
  TipGot = 0
  for Lt = 0 to 3
    V = Tips[Lt]
    if V > 0 then
      if V = 255 then
        TipLost = 1
        LostL = Lt
        return
      end if
      Tips[Lt] = V + 1
    end if
  next
  if R > 0 then
    Lt = R - 1
    if Tips[Lt] = 0 then
      St = Lt * 3
      for K = 0 to 2
        V = Cus[St]
        if V >= 50 then
          Tips[Lt] = V
          exit for
        end if
        inc St
      next
    end if
  end if
  Lt = PRow - 1
  if Tips[Lt] >= 245 then
    Tips[Lt] = 0
    TipGot = 1
  end if
  return
end sub

' every shopper a pixel right; a new one in aisle R ($0C41)
sub MoveCus(u8 R):
  Collide
  CusOut = 0
  for Sc = 0 to 11
    V = Cus[Sc]
    if V > 0 then
      if V = 255 then
        CusOut = 1
        LostL = LaneOf[Sc]
        LostS = Sc
        Collide
        return
      end if
      Cus[Sc] = V + 1
    end if
  next
  if R > 0 then
    Sc = (R - 1) * 3
    for K = 0 to 2
      if Cus[Sc] = 0 then
        Cus[Sc] = 1
        V = Rs >> 8
        Kinds[Sc] = V % 3
        exit for
      end if
      inc Sc
    next
  end if
  Collide
  return
end sub

' a bag and a shopper at the same X: served ($0CD3); shoppers in order,
' each against the three bags of its belt
sub Collide:
  for Ck = 0 to 11
    V = Cus[Ck]
    if V > 0 then
      Bk = LaneOf[Ck] * 3
      for K = 0 to 2
        if Bags[Bk] = V then
          Cus[Ck] = 0
          Bags[Bk] = 0
          inc Served
          exit for
        end if
        inc Bk
      next
    end if
  next
  return
end sub

sub ClearStore:
  fill array Bags with 0
  fill array Cus with 0
  fill array Tips with 0
  return
end sub

' after the pause: a life gone, the store cleared ($16E3)
sub LifeLost:
  ClearStore
  dec Lives
  if Lives = 0 then
    Over = 1
    return
  end if
  NewLife
  return
end sub

' a level served ($1792): 10, 30, 50 shoppers, then 10 a step faster
sub NextLevel:
  LevelUp = 0
  ClearStore
  if Target = 50 then
    Target = 10
    dec Dly
    if Dly < 2 then Dly = 2
  else
    Target = Target + 20
  end if
  if Lvl < 99 then inc Lvl
  play sound SndLevel
  LevelPage
  Served = 0
  if Lvl = 5 then inc Lives
  Score = Score + 100
  NewLife
  return
end sub

' the C64's $15A4: the bagger back in aisle 1, the play screen, a pause,
' the chime, a first read of the stick
sub NewLife:
  PRow = 1
  Pose = 0
  ThrowRow = 0
  Cause = 0
  BagFell = 0
  CusOut = 0
  TipLost = 0
  Acc = 0
  PlayScreen
  DrawAll
  ShowScreen
  Rearm
  wait 41 frames
  nmi off
  play sound SndStart
  Cnt3 = 2
  ReadPad
  Poll
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprites 0-1 the bagger, 2-13 the shoppers, 14-25 the bags,
' 26-29 the tips
sub DrawAll:
  ' the belts' ridges run left, a step a pass
  V = BeltC & 3
  W16 = V * 8
  copy BeltPh + W16 count 8 to vram.pattern + 1056
  copy BeltPh + W16 count 8 to vram.pattern + 3104
  copy BeltPh + W16 count 8 to vram.pattern + 5152
  Y = LaneY[PRow - 1]
  K = Pose * 8
  set sprite 0 to Y,224,SBgt0 + K,15
  set sprite 1 to Y + 16,224,SBgb0 + K,12
  ' a lost shopper or tip blinks: off 10 frames in 20
  Blink = 255
  if Freeze > 0 then
    V = Freeze % 20
    if V >= 10 then Blink = LostS
  end if
  for Sd = 0 to 11
    Y = LaneY[LaneOf[Sd]]
    V = Cus[Sd]
    if V > 0 then
      X = XT[V]
      K = Kinds[Sd]
      Pp = K * 8 + SSha0
      if V & 8 then Pp = Pp + 4
      K = KindCol[K]
      if Cause = 2 then
        if Blink = Sd then K = 0
      end if
      set sprite Sd + 2 to Y,X,Pp,K
    else
      set sprite Sd + 2 to 192,0,0,0
    end if
    V = Bags[Sd]
    if V > 0 then
      X = XT[V]
      set sprite Sd + 14 to Y + 16,X,SBag,10
    else
      set sprite Sd + 14 to 192,0,0,0
    end if
  next
  for Ld = 0 to 3
    Y = LaneY[Ld] + 27
    V = Tips[Ld]
    K = 3
    if Cause = 3 then
      if LostL = Ld then
        if Freeze > 0 then V = 255
        if Blink < 255 then K = 0
      end if
    end if
    if V > 0 then
      X = XT[V]
      set sprite Ld + 26 to Y,X,STip,K
    else
      set sprite Ld + 26 to 192,0,0,0
    end if
  next
  ' the bag that fell tips off the belt's end and drops
  if Freeze > 0 then
    if Cause = 1 then
      Y = LaneY[LostL] + 16
      V = 134 - Freeze
      if V > 24 then V = 24
      Y = Y + V
      set sprite LostS + 14 to Y,22,SBagt,10
    end if
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print Score at 8,1 digits 5
  print at 14,1, "L"
  NumU = Lvl
  print at 15,1, digits$(NumU, 2)
  NumU = Served
  print at 18,1, digits$(NumU, 2)
  print at 20,1, "/"
  NumU = Target
  print at 21,1, digits$(NumU, 2)
  fill TBar count 5 at 25,1
  if Lives > 0 then
    K = Lives
    if K > 5 then K = 5
    fill TLife count K at 25,1
  end if
  return
end sub

sub PlayScreen:
  NewScreen
  copy GameMap count 768 to vram.name
  ShowHud
  return
end sub

' the level card: LEVEL n, how many shoppers to serve
sub LevelPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  NumU = Lvl
  print at 11,9, "LEVEL ", digits$(NumU, 2)
  NumU = Target
  print at 7,12, "SERVE ", digits$(NumU, 2), " SHOPPERS"
  ShowScreen
  Rearm
  wait 101 frames
  nmi off
  fill mode 2 text color with $F0
  return
end sub

sub NewGame:
  Score = 0
  Lives = 4
  Target = 10
  Dly = 5
  Served = 0
  Lvl = 1
  Over = 0
  Arm = 0
  Freeze = 0
  LevelUp = 0
  ClearStore
  LevelPage
  NewLife
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 29
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BAGGER in paper-bag letters, a shopper strolling to the
' bagger, START / CREDITS, the tune once
sub TitlePage:
  NewScreen
  print at 2,1, "COMPUTE!'S GAZETTE JULY 1988"
  copy TitleMap count 160 to vram.name + 96
  fill TBelt count 23 at 4,15
  fill TPan count 23 at 4,16
  put char TBeltL at 3,15
  put char TPanL at 3,16
  put char TBeltR at 27,15
  put char TPanR at 27,16
  put char TStand at 28,15
  put char TStand at 29,15
  print at 13,19, "START"
  print at 13,20, "HOW TO PLAY"
  print at 13,21, "CREDITS"
  print at 5,22, "UP/DOWN AISLE  FIRE BAG"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 504
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' a shopper strolls along the title's belt towards the bagger
sub TitleAnim:
  V = Tick & 1
  if V = 0 then
    inc TbX
    if TbX >= 200 then TbX = 16
  end if
  Pp = SShb0
  if TbX & 8 then Pp = Pp + 4
  set sprite 2 to 100,TbX,Pp,9
  set sprite 0 to 100,224,SBgt0,15
  set sprite 1 to 116,224,SBgb0,12
  update sprites
  return
end sub

' HOW TO PLAY: 3 pages; a button turns the page; after the last page,
' or 30 seconds untouched, back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "YOU BAG GROCERIES AT THE"
    print at 2,4, "END OF FOUR CHECKOUT BELTS."
    print at 2,5, "SHOPPERS WALK IN FROM THE"
    print at 2,6, "LEFT. THROW A BAG DOWN THE"
    print at 2,7, "BELT TO SERVE A SHOPPER."
    print at 2,9, "YOU LOSE A LIFE IF A"
    print at 2,10, "SHOPPER REACHES YOU UNSERVED"
    print at 2,11, "OR A BAG FALLS OFF THE FAR"
    print at 2,12, "END OF THE BELT."
    fill TBelt count 23 at 4,17
    fill TPan count 23 at 4,18
    put char TBeltL at 3,17
    put char TPanL at 3,18
    put char TBeltR at 27,17
    put char TPanR at 27,18
    put char TStand at 28,17
    put char TStand at 29,17
    set sprite 2 to 116,64,SSha0,KindCol[0]
    set sprite 14 to 132,136,SBag,10
    set sprite 0 to 116,224,SBgt0,15
    set sprite 1 to 132,224,SBgb0,12
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "JOYSTICK UP/DOWN: MOVE TO"
    print at 2,4, "ANOTHER BELT."
    print at 2,6, "BUTTON: THROW A BAG."
    print at 2,8, "ONLY THREE BAGS FIT ON A"
    print at 2,9, "BELT AT ONCE. DON'T THROW"
    print at 2,10, "WHEN NOBODY IS COMING!"
    fill TBelt count 23 at 4,17
    fill TPan count 23 at 4,18
    put char TBeltL at 3,17
    put char TPanL at 3,18
    put char TBeltR at 27,17
    put char TPanR at 27,18
    put char TStand at 28,17
    put char TStand at 29,17
    set sprite 14 to 132,120,SBag,10
    set sprite 15 to 132,168,SBag,10
    set sprite 0 to 116,224,SBgt1,15
    set sprite 1 to 132,224,SBgb1,12
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "SERVE A SHOPPER: 5 POINTS."
    print at 2,4, "SHOPPERS MAY DROP A TIP. IT"
    print at 2,5, "ROLLS TO YOUR END: BE IN"
    print at 2,6, "THAT AISLE TO CATCH IT FOR"
    print at 2,7, "20 POINTS, OR LOSE A LIFE."
    print at 2,9, "SERVE ENOUGH SHOPPERS TO"
    print at 2,10, "FINISH A LEVEL (+100). YOU"
    print at 2,11, "HAVE 4 LIVES. LOSE THEM"
    print at 2,12, "ALL: GAME OVER."
    print at 2,14, "TIP: WATCH THE TIPS! THEY"
    print at 2,15, "ROLL TWICE AS FAST."
    fill TBelt count 23 at 4,18
    fill TPan count 23 at 4,19
    put char TBeltL at 3,18
    put char TPanL at 3,19
    put char TBeltR at 27,18
    put char TPanR at 27,19
    put char TStand at 28,18
    put char TStand at 29,18
    set sprite 2 to 124,88,SShc0,KindCol[2]
    set sprite 26 to 151,160,STip,3
    set sprite 0 to 124,224,SBgt0,15
    set sprite 1 to 140,224,SBgb0,12
  end select
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub


sub ShowMenu:
  put char 32 at 11,19
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 19
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "BAGGER"
  print at 2,5, "BASED ON BAGGER FROM"
  print at 2,6, "COMPUTE!'S GAZETTE, JULY"
  print at 2,7, "1988 (COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE; AUTHOR UNNAMED"
  print at 2,9, "ON THE DISK)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: AISLE FIVE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

