  "XXX..........XXX"
  "XXX...XXXX...XXX"
  ".XX..XXXXXX..XX."
  ".XX.X..XX..X.XX."
  ".X.XX..XX..XX.X."
  ".X.XXXXXXXXXX.X."
  "..XXXX.XX.XXXX.."
  "...X..XXXX..X..."
  "...XX..XX..XX..."
  "...XXX....XXX..."
  "...XXXXXXXXXX..."
  ".....XX..XX....."
  ".....XX..XX....."
  ".....XX..XX....."
  "....XXX..XXX...."
