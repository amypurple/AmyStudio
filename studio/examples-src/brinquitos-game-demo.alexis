  "...XX..XX..XX..."
  "..XXXXXXXXXXXX.."
  ".XXXXX.XX.XXXXX."
  "XX.X..XXXX..X.XX"
  "XX.XX......XX.XX"
  "XX.XXXXXXXXXX.XX"
  "XXX..XX..XX..XXX"
  "....XXX..XXX...."
