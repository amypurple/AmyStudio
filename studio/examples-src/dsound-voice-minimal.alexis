' DSOUND workflow smoke test.
' This example ships with a tiny embedded .dsound project file.
' Replace it with your own recording from the WAV -> DSound tool when ready.

asset VoiceStub from "@project/voice-stub.dsound" codec raw

  text screen
  print at 4,5, "DSOUND VOICE TEST"
  print at 2,8, "Embedded .dsound plays once."
  print at 2,10, "Replace it with your own voice."
  screen on
  wait 30 frames
  play dsound VoiceStub
MainLoop:
  wait
  goto MainLoop