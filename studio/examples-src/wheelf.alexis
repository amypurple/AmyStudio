u16 Speed = 0
u8 Power = 0
u8 Stage = 0
u8 Tick = 0
u8 Asking = 0
u8 TMenu = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
' input
u8 J1 = 0
u8 Pj = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Back = 0
u8 WasB2 = 0
u8 WasStick = 0
u8 Held = 0
u8 LastDir = 0
u8 Rep = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Li = 0
u8 Ri = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table WfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if TMenu = 1 then
    RulesPage
    goto title
  end if
  if TMenu = 2 then
    CreditsPage
    goto title
  end if
  SetupPage
  NewGame
  Round = 1

next_round:
  PlayRound
  inc Round
  if Round <= 4 then goto next_round

  FinalPage
  BonusRound
  Stage = 11
  Pause(60)
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandN(u8 N) as u8
  Rand
  return Rs % N

' ---------------------------------------------------------------------------
' phrases and the board

sub NewGame:
  for Ci = 0 to 2
    Pl[Ci].Rnd = 0
    Pl[Ci].Tot = 0
  next
  fill array PhrUsed with 0
  Cur = 0
  return
end sub

' a phrase not used yet this game
function NewPhrase() as u8
  u8 Np = 0
  u8 Cnt = 0
  for Ci = 0 to NPhr - 1
    Cnt = Cnt + PhrUsed[Ci]
  next
  if Cnt >= NPhr then
    fill array PhrUsed with 0
  end if
  do
    Np = RandN(NPhr)
  loop until PhrUsed[Np] = 0
  PhrUsed[Np] = 1
  return Np

function IsLetter(u8 Ch) as u8
  if Ch >= 65 and Ch <= 90 then return 1
  return 0

function IsVowel(u8 Ch) as u8
  select case Ch
  case 65, 69, 73, 79, 85
    return 1
  end select
  return 0

' the phrase into PBuf, its cards placed on up to three centred lines
sub LoadPhrase(u8 N):
  u16 Ofs = 0
  u8 I = 0
  u8 Start = 0
  u8 Ln = 0
  u8 Col = 0
  u8 Row = 0
  u8 Ch = 0
  Ofs = PhrOfs[N]
  copy Phr + Ofs count 32 to PBuf
  PBuf[32] = 0
  PLen = 0
  while PBuf[PLen] <> 0
    inc PLen
  end while
  NLines = 0
  Start = 0
  for I = 0 to PLen
    Ch = PBuf[I]
    if Ch = 47 or Ch = 0 then
      LnLen[NLines] = I - Start
      inc NLines
      Start = I + 1
    end if
  next
  Ln = 0
  Row = BoardY
  if NLines = 1 then Row = BoardY + 1
  Col = (28 - LnLen[0]) / 2 + 2
  for I = 0 to PLen - 1
    Ch = PBuf[I]
    Shown[I] = 1
    Guess[I] = 0
    if Ch = 47 then
      inc Ln
      inc Row
      Col = (28 - LnLen[Ln]) / 2 + 2
      CX[I] = 0
    else
      CX[I] = Col
      CY[I] = Row
      inc Col
      if IsLetter(Ch) then Shown[I] = 0
    end if
  next
  return
end sub

function CardTile(u8 I) as u8
  u8 Ch = 0
  Ch = PBuf[I]
  if IsLetter(Ch) then
    if Shown[I] = 1 then return TBA + Ch - 65
    if Guess[I] <> 0 then return TGA + Guess[I] - 65
    return THide
  end if
  select case Ch
  case 39
    return TBQuote
  case 46
    return TBDot
  case 44
    return TBComma
  case 38
    return TBAmp
  end select
  return 32

sub DrawCard(u8 I):
  if CX[I] > 0 then put char CardTile(I) at CX[I],CY[I]
  return
end sub

sub DrawBoard:
  for Ci = 0 to PLen - 1
    DrawCard(Ci)
  next
  return
end sub

' how many hidden cards are consonants (Kind 0) or vowels (Kind 1)
function HiddenOf(u8 Kind) as u8
  u8 Hn = 0
  u8 Hi = 0
  u8 Ch = 0
  for Hi = 0 to PLen - 1
    Ch = PBuf[Hi]
    if Shown[Hi] = 0 then
      if IsVowel(Ch) = Kind then inc Hn
    end if
  next
  return Hn

' turn the letter's hidden cards, one by one with a ding; how many
function Reveal(u8 Ch) as u8
  u8 Rn = 0
  u8 Rv = 0
  for Rv = 0 to PLen - 1
    if PBuf[Rv] = Ch then
      if Shown[Rv] = 0 then
        Shown[Rv] = 1
        DrawCard(Rv)
        play sound SndDing
        inc Rn
        Pause(24)
      end if
    end if
  next
  return Rn

sub RevealAll:
  for Ri = 0 to PLen - 1
    if Shown[Ri] = 0 then
      Shown[Ri] = 1
      DrawCard(Ri)
      Pause(4)
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the wheel

sub DrawBox(u8 B):
  u8 Bx = 0
  u8 By = 0
  u8 Bv = 0
  u16 Val = 0
  Bx = BoxC[B]
  By = BoxR[B]
  Bv = WheelV[B]
  select case Bv
  case 0
    print at Bx,By, "BANK"
    print at Bx,By + 1, "RUPT"
  case 1
    print at Bx,By, "LOSE"
    print at Bx,By + 1, "TURN"
  case else
    Val = Bv * 50
    if Val < 1000 then
      print Val at Bx,By digits 3
    else
      print Val at Bx,By digits 4
    end if
    fill TStripe0 + BoxS[B] count 4 at Bx,By + 1
  end select
  return
end sub

sub DrawWheel:
  for Ci = 0 to 19
    DrawBox(Ci)
  next
  return
end sub

' the ball on the track: between box centres
sub PlaceBall:
  u8 Sg = 0
  u8 Nx = 0
  u8 Fr = 0
  i16 X0 = 0
  i16 Y0 = 0
  i16 X1 = 0
  i16 Y1 = 0
  u8 Bxp = 0
  u8 Byp = 0
  Sg = BallPos / 64
  Fr = BallPos % 64
  Nx = Sg + 1
  if Nx = 20 then Nx = 0
  X0 = BoxC[Sg] * 8 + 12
  Y0 = BoxR[Sg] * 8 + 4
  X1 = BoxC[Nx] * 8 + 12
  Y1 = BoxR[Nx] * 8 + 4
  X0 = (X1 - X0) * Fr / 64 + X0
  Y0 = (Y1 - Y0) * Fr / 64 + Y0
  Bxp = X0
  Byp = Y0
  set sprite 0 to Byp,Bxp,SShine,15
  set sprite 1 to Byp,Bxp,SBall,11
  update sprites
  return
end sub

sub BoxFrame(u8 Shw):
  u8 Fx = 0
  u8 Fy = 0
  if Shw = 1 then
    Fx = BoxC[Seg] * 8
    Fy = BoxR[Seg] * 8 - 1
    set sprite 4 to Fy,Fx,SBoxl,11
    set sprite 5 to Fy,Fx + 16,SBoxr,11
  else
    set sprite 4 to 192,0,SBoxl,11
    set sprite 5 to 192,0,SBoxr,11
  end if
  update sprites
  return
end sub

' wind up while the button is held, roll on release; Seg = the box
sub Spin:
  u8 LastSg = 0
  u8 Sg = 0
  u8 Fd = 0
  CenterClear
  print at 9,9, "HOLD BUTTON,"
  print at 9,10, "LET GO TO SPIN"
  Power = 0
  Stage = 6
  Phase = 0
  ' wait for the button to go down (it was just released on the menu)
  do
    Frame1
    inc Rs
    ReadPad
  loop until Btn > 0
  Phase = 1
  while Btn > 0
    Frame1
    inc Rs
    ReadPad
    if Power < 63 then inc Power
    fill 32 count 16 at 8,11
    fill 61 count Power / 4 at 8,11
  end while
  Phase = 2
  Speed = Power
  Speed = Speed * 2 + 96
  Speed = Speed + RandN(48)
  CenterClear
  play sound SndWhoosh
  LastSg = BallPos / 64
  while Speed > 0
    BallPos = BallPos + Speed / 8
    if BallPos >= 1280 then BallPos = BallPos - 1280
    Sg = BallPos / 64
    if Sg <> LastSg then
      play sound SndClick
      LastSg = Sg
    end if
    PlaceBall
    Frame1
    inc Fd
    dec Speed
  end while
  ' settle into the middle of the box
  BallPos = BallPos / 64
  Seg = BallPos
  BallPos = BallPos * 64 + 24
  PlaceBall
  BoxFrame(1)
  Phase = 3
  return
end sub

' ---------------------------------------------------------------------------
' players and money

sub ShowMoney:
  u8 Px = 0
  for Ci = 0 to NPl - 1
    Px = Ci * 9 + 2
    if Ci = Cur then
      put char 62 at Px,1
    else
      put char 80 at Px,1
    end if
    put char Ci + 49 at Px + 1,1
    Sh5 = Pl[Ci].Rnd
    print at Px + 3,1, Sh5
    Sh6 = Pl[Ci].Tot
    print at Px + 2,2, Sh6
  next
  return
end sub

sub CenterClear:
  for J = 9 to 11
    fill 32 count 16 at 8,J
  next
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,MsgY
  return
end sub

sub ShowPlayer:
  CenterClear
  print at 11,9, "PLAYER"
  put char Cur + 49 at 18,9
  ShowMoney
  return
end sub

sub NextPlayer:
  inc Cur
  if Cur >= NPl then Cur = 0
  Pause(50)
  ClearMsg
  BoxFrame(0)
  ShowPlayer
  return
end sub

' ---------------------------------------------------------------------------
' the letter picker

sub DrawPicker:
  u8 Px = 0
  u8 Py = 0
  for Li = 0 to 25
    Px = Li % 13 + PickX
    Py = Li / 13 * 2 + PickY
    if Used[Li] = 1 then
      put char TDA + Li at Px,Py
    else
      put char Li + 65 at Px,Py
    end if
  next
  return
end sub

sub PickFrame(u8 Shw):
  u8 Fx = 0
  u8 Fy = 0
  if Shw = 1 then
    Fx = (PkI % 13 + PickX) * 8 - 1
    Fy = (PkI / 13 * 2 + PickY) * 8 - 2
    set sprite 2 to Fy,Fx,SFrame,10
  else
    set sprite 2 to 192,0,SFrame,10
  end if
  update sprites
  return
end sub

' the stick with repeat: Held = direction bits when it acts this frame
sub StickRep:
  V = Pj & 15
  Held = 0
  if V = 0 then
    LastDir = 0
  else
    if V <> LastDir then
      Held = V
      Rep = 16
    else
      dec Rep
      if Rep = 0 then
        Held = V
        Rep = 5
      end if
    end if
    LastDir = V
  end if
  return
end sub

' Mode 1 consonant, 2 vowel, 3 any (solving: the right button gives
' Picked = 0, take back), 4 consonant for the bonus. Picked = the letter.
sub PickLetter(u8 Mode):
  u8 Done = 0
  u8 Ok = 0
  u8 Lt = 0
  Stage = 7
  PickFrame(1)
  ReadPad
  LastDir = 0
  Asking = 3
  while Done = 0
    Frame1
    inc Rs
    ReadPad
    StickRep
    if Held > 0 then
      if Held & 1 then
        if PkI >= 13 then PkI = PkI - 13
      end if
      if Held & 2 then
        if PkI < 13 then PkI = PkI + 13
      end if
      if Held & 4 then
        if PkI % 13 = 0 then
          PkI = PkI + 12
        else
          dec PkI
        end if
      end if
      if Held & 8 then
        if PkI % 13 = 12 then
          PkI = PkI - 12
        else
          inc PkI
        end if
      end if
      PickFrame(1)
      play sound SndTick
    end if
    if Back = 1 and Mode = 3 then
      Picked = 0
      Done = 1
    end if
    if Press = 1 then
      Lt = PkI + 65
      Ok = 1
      ClearMsg
      select case Mode
      case 1, 4
        if IsVowel(Lt) then
          print at 2,MsgY, "PICK A CONSONANT."
          Ok = 0
        end if
      case 2
        if IsVowel(Lt) = 0 then
          print at 2,MsgY, "PICK A VOWEL."
          Ok = 0
        end if
      end select
      if Ok = 1 and Mode <> 3 and Used[PkI] = 1 then
        print at 2,MsgY, "THAT LETTER IS USED."
        Ok = 0
      end if
      if Ok = 1 then
        Picked = Lt
        Done = 1
      else
        play sound SndBad
      end if
    end if
  end while
  Asking = 0
  PickFrame(0)
  return
end sub

' mark the letter used and turn its cards; Revealed = how many
sub UseLetter(u8 Lt):
  Used[Lt - 65] = 1
  DrawPicker
  Revealed = Reveal(Lt)
  return
end sub

' ---------------------------------------------------------------------------
' a turn

sub TurnMenu:
  u8 Done = 0
  for J = 0 to 2
    fill 32 count 26 at 2,MenuY + J
  next
  print at 4,MenuY, "SPIN THE WHEEL"
  print at 4,MenuY + 1, "BUY A VOWEL   $250"
  print at 4,MenuY + 2, "SOLVE THE PUZZLE"
  Stage = 5
  Asking = 1
  ReadPad
  WasStick = Pj & 15
  while Done = 0
    for J = 0 to 2
      put char 32 at 2,MenuY + J
    next
    put char 62 at 2,MenuY + Choice
    Frame1
    inc Rs
    ReadPad
    V = Pj & 15
    if V <> WasStick then
      if V & 1 then
        if Choice > 0 then dec Choice
        play sound SndTick
      end if
      if V & 2 then
        if Choice < 2 then inc Choice
        play sound SndTick
      end if
    end if
    WasStick = V
    if Press = 1 then
      Done = 1
      ClearMsg
      if Choice = 0 and HiddenOf(0) = 0 then
        print at 2,MsgY, "NO CONSONANTS LEFT."
        Done = 0
      end if
      if Choice = 1 and HiddenOf(1) = 0 then
        print at 2,MsgY, "NO VOWELS LEFT."
        Done = 0
      end if
      if Done = 0 then play sound SndBad
    end if
  end while
  Asking = 0
  for J = 0 to 2
    put char 32 at 2,MenuY + J
  next
  return
end sub

sub DoSpin:
  u8 Wv = 0
  u8 Wi = 0
  Spin
  Wv = WheelV[Seg]
  CenterClear
  select case Wv
  case 0
    print at 12,9, "BANKRUPT"
    print at 2,MsgY, "THIS ROUND'S MONEY IS GONE."
    Pl[Cur].Rnd = 0
    ShowMoney
    play sound SndBankrupt
    NextPlayer
  case 1
    print at 10,9, "LOSE A TURN"
    play sound SndLose
    NextPlayer
  case else
    print at 9,9, "PICK A LETTER"
    print at 11,10, "FOR $"
    W16 = Wv * 50
    if W16 < 1000 then
      print W16 at 16,10 digits 3
    else
      print W16 at 16,10 digits 4
    end if
    PickLetter(1)
    UseLetter(Picked)
    if Revealed = 0 then
      print at 2,MsgY, "NO "
      put char Picked at 5,MsgY
      play sound SndBuzz
      NextPlayer
    else
      Gain = 0
      for Wi = 1 to Revealed
        for J = 1 to Wv
          Gain += 50
        next
      next
      Sh5 = Pl[Cur].Rnd
      Sh5 += Gain
      Pl[Cur].Rnd = Sh5
      ShowMoney
      print at 2,MsgY, "YOU WIN $"
      print at 11,MsgY, Gain
      ShowPlayer
    end if
  end select
  return
end sub

sub DoBuy:
  Sh5 = Pl[Cur].Rnd
  if Sh5 < 250 then
    print at 2,MsgY, "YOU CAN'T AFFORD A VOWEL."
    play sound SndBad
    NextPlayer
  else
    Sh5 -= 250
    Pl[Cur].Rnd = Sh5
    ShowMoney
    play sound SndBuy
    CenterClear
    print at 10,9, "PICK A VOWEL"
    PickLetter(2)
    UseLetter(Picked)
    if Revealed = 0 then
      print at 2,MsgY, "NO "
      put char Picked at 5,MsgY
      play sound SndBuzz
      NextPlayer
    else
      ShowPlayer
    end if
  end if
  return
end sub

' the next hidden card after I (PLen if none)
function NextHidden(u8 I) as u8
  u8 Nh = 0
  u8 Found = 0
  Nh = I
  Found = PLen
  while Nh < PLen
    if Shown[Nh] = 0 and Guess[Nh] = 0 then
      Found = Nh
      Nh = PLen
    else
      inc Nh
    end if
  end while
  return Found

' spell the answer into the hidden cards; Right = 1 when it matches
sub SolveEntry:
  u8 Slot = 0
  u8 Ai = 0
  u8 Ax = 0
  u8 Ay = 0
  u8 Prev = 0
  u8 Fin = 0
  Stage = 8
  CenterClear
  print at 9,9, "SPELL IT OUT."
  print at 9,10, "RIGHT BUTTON"
  print at 9,11, "TAKES ONE BACK"
  for Ai = 0 to PLen - 1
    Guess[Ai] = 0
  next
  Slot = NextHidden(0)
  while Fin = 0
    if Slot >= PLen then
      Fin = 1
    else
      Ax = CX[Slot] * 8
      Ay = CY[Slot] * 8 - 1
      set sprite 3 to Ay,Ax,SArrow,10
      update sprites
      PickLetter(3)
      if Picked = 0 then
        ' back to the previous letter typed
        Prev = PLen
        for Ai = 0 to PLen - 1
          if Guess[Ai] <> 0 then Prev = Ai
        next
        if Prev < PLen then
          Guess[Prev] = 0
          DrawCard(Prev)
          Slot = Prev
          play sound SndTick
        end if
      else
        Guess[Slot] = Picked
        DrawCard(Slot)
        play sound SndTick
        Slot = NextHidden(Slot)
      end if
    end if
  end while
  set sprite 3 to 192,0,SArrow,10
  update sprites
  Right = 1
  for Ai = 0 to PLen - 1
    if Shown[Ai] = 0 then
      if Guess[Ai] <> PBuf[Ai] then Right = 0
    end if
  next
  for Ai = 0 to PLen - 1
    Guess[Ai] = 0
  next
  CenterClear
  return
end sub

sub DoSolve:
  SolveEntry
  if Right = 1 then
    Solved = 1
    RevealAll
    play sound SndSolve
  else
    DrawBoard
    print at 2,MsgY, "SORRY, THAT IS NOT IT."
    play sound SndBuzz
    NextPlayer
  end if
  return
end sub

sub GameScreen:
  NewScreen
  fill TRule count 28 at 2,6
  DrawWheel
  DrawBoard
  DrawPicker
  print at 10,16, "ROUND"
  put char Round + 48 at 16,16
  print at 18,16, "OF 4"
  ShowPlayer
  PlaceBall
  ShowScreen
  return
end sub

sub PlayRound:
  u8 Pi = 0
  fill array Used with 0
  for Pi = 0 to 2
    Pl[Pi].Rnd = 0
  next
  PhrNo = NewPhrase()
  LoadPhrase(PhrNo)
  Cur = (Round - 1) % NPl
  Choice = 0
  GameScreen
  Solved = 0
  while Solved = 0
    TurnMenu
    select case Choice
    case 0
      DoSpin
    case 1
      DoBuy
    case else
      DoSolve
    end select
  end while
  ' bank the round: at least the house minimum
  Sh5 = Pl[Cur].Rnd
  if Sh5 < 200 then Sh5 = 200
  Pl[Cur].Rnd = Sh5
  Sh6 = Pl[Cur].Tot
  for J = 0 to 2
    fill 32 count 26 at 2,MenuY + J
  next
  print at 2,MenuY, "PLAYER"
  put char Cur + 49 at 9,MenuY
  print at 11,MenuY, "SOLVED IT!"
  print at 2,MenuY + 1, "YOU WON $"
  print at 11,MenuY + 1, Sh5
  AddRound
  ShowMoney
  Stage = 9
  WaitButton
  return
end sub

' Tot += Rnd, digit by digit through the 5-digit round money (a 5-digit
' BCD can't be added to a 6-digit one directly)
sub AddRound:
  Sh5 = Pl[Cur].Rnd
  Sh6 = Pl[Cur].Tot
  while Sh5 >= 1000
    Sh5 -= 1000
    Sh6 += 1000
  end while
  while Sh5 >= 50
    Sh5 -= 50
    Sh6 += 50
  end while
  Pl[Cur].Tot = Sh6
  return
end sub

sub WaitButton:
  print at 2,MsgY, "PRESS THE BUTTON"
  ReadPad
  Asking = 2
  do
    Frame1
    inc Rs
    ReadPad
  loop until Press = 1
  Asking = 0
  play sound SndTick
  ClearMsg
  return
end sub

' ---------------------------------------------------------------------------
' the end of the four rounds and the bonus round

sub FinalPage:
  u8 Ties = 0
  u8 Pick = 0
  NewScreen
  print at 2,1, "AFTER FOUR ROUNDS"
  fill TRule count 28 at 2,2
  Best = 0
  for Ci = 0 to NPl - 1
    print at 4,Ci * 2 + 5, "PLAYER"
    put char Ci + 49 at 11,Ci * 2 + 5
    Sh6 = Pl[Ci].Tot
    print at 15,Ci * 2 + 5, "$"
    print at 16,Ci * 2 + 5, Sh6
    if Sh6 > Best then Best = Sh6
  next
  ' ties: one of the best, at random (the original's rule)
  for Ci = 0 to NPl - 1
    Sh6 = Pl[Ci].Tot
    if Sh6 = Best then inc Ties
  next
  Pick = RandN(Ties)
  for Ci = 0 to NPl - 1
    Sh6 = Pl[Ci].Tot
    if Sh6 = Best then
      if Pick = 0 then Winner = Ci
      dec Pick
    end if
  next
  print at 2,13, "CONGRATULATIONS PLAYER"
  put char Winner + 49 at 25,13
  if Ties > 1 then print at 2,14, "(A TIE: CHOSEN AT RANDOM)"
  print at 2,16, "YOU PLAY THE BONUS ROUND"
  print at 2,17, "FOR $10,000."
  ShowScreen
  play sound SndSolve
  Stage = 10
  WaitButton
  return
end sub

sub BonusRound:
  u8 Bk = 0
  Cur = Winner
  fill array Used with 0
  PhrNo = NewPhrase()
  LoadPhrase(PhrNo)
  NewScreen
  print at 2,1, "BONUS ROUND: PLAYER"
  put char Cur + 49 at 22,1
  fill TRule count 28 at 2,6
  DrawBoard
  DrawPicker
  Stage = 10
  ShowScreen
  for Bk = 1 to 5
    CenterClear
    print at 8,9, "PICK CONSONANT"
    put char Bk + 48 at 23,9
    PickLetter(4)
    Used[Picked - 65] = 1
    DrawPicker
  next
  CenterClear
  print at 10,9, "PICK A VOWEL"
  PickLetter(2)
  Used[Picked - 65] = 1
  DrawPicker
  ' show them all
  for Bk = 0 to 25
    if Used[Bk] = 1 then V = Reveal(Bk + 65)
  next
  print at 2,18, "FOR $10,000, SOLVE THIS"
  print at 2,19, "PUZZLE."
  SolveEntry
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,19
  RevealAll
  Sh6 = Pl[Cur].Tot
  if Right = 1 then
    Sh6 += 10000
    Pl[Cur].Tot = Sh6
    print at 2,18, "WAY TO GO, PLAYER"
    put char Cur + 49 at 20,18
    print at 2,19, "YOU WON $"
    play sound SndSolve
  else
    print at 2,18, "SORRY, PLAYER"
    put char Cur + 49 at 16,18
    print at 2,19, "YOU STILL WON $"
    play sound SndLose
  end if
  print at 17,19, Sh6
  Stage = 11
  return
end sub

' ---------------------------------------------------------------------------
' title, rules, credits, setup

sub SetupPage:
  u8 Done = 0
  NewScreen
  print at 2,1, "SPIN & SOLVE"
  fill TRule count 28 at 2,2
  print at 2,5, "HOW MANY PLAYERS?"
  print at 6,8, "1 PLAYER"
  print at 6,9, "2 PLAYERS"
  print at 6,10, "3 PLAYERS"
  print at 2,13, "THE PLAYERS TAKE TURNS"
  print at 2,14, "WITH ONE CONTROLLER."
  ShowScreen
  Stage = 4
  NPl = 1
  WasStick = 0
  ReadPad
  WasBtn = 16
  while Done = 0
    for J = 0 to 2
      put char 32 at 4,J + 8
    next
    put char 62 at 4,NPl + 7
    Frame1
    inc Rs
    ReadPad
    V = Pj & 15
    if V <> WasStick then
      if V & 1 then
        if NPl > 1 then dec NPl
        play sound SndTick
      end if
      if V & 2 then
        if NPl < 3 then inc NPl
        play sound SndTick
      end if
    end if
    WasStick = V
    if Press = 1 then Done = 1
  end while
  return
end sub

sub ShowTitleMenu:
  for J = 0 to 2
    put char 32 at 9,J + 15
  next
  put char 62 at 9,TMenu + 15
  return
end sub

' the board cards spell SPIN & SOLVE, turned one by one
data TitleTxt bytes
  83,80,73,78,32,38,32,83,79,76,86,69
end data

sub TitlePage:
  u8 Tf = 0
  u8 Tc = 0
  NewScreen
  fill TRule count 28 at 2,4
  fill TRule count 28 at 2,10
  fill THide count 12 at 10,7
  put char 32 at 14,7
  put char 32 at 16,7
  print at 11,15, "PLAY"
  print at 11,16, "HOW TO PLAY"
  print at 11,17, "CREDITS"
  print at 3,20, "BASED ON 'WHEEL OF FORTUNE'"
  print at 5,21, "BY RICHARD BAIN, AHOY!"
  print at 9,22, "MARCH 1987"
  ShowTitleMenu
  ShowScreen
  Stage = 2
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 580
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 0
  Tf = 0
  do
    Frame1
    inc Rs
    if Tf < 250 then inc Tf
    ' a card turns every 12 frames
    if Tf % 12 = 0 and Tf <= 144 then
      Tc = Tf / 12 - 1
      V = TitleTxt[Tc]
      select case V
      case 32
        put char 32 at Tc + 10,7
      case 38
        put char TBAmp at Tc + 10,7
        play sound SndDing
      case else
        put char TBA + V - 65 at Tc + 10,7
        play sound SndDing
      end select
    end if
    ReadPad
    V = Pj & 15
    if V > 0 then
      if WasStick = 0 then
        if V & 1 then
          if TMenu > 0 then dec TMenu
        end if
        if V & 2 then
          if TMenu < 2 then inc TMenu
        end if
        ShowTitleMenu
        play sound SndTick
      end if
    end if
    WasStick = V
  loop until Press = 1
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub RulesPage:
  NewScreen
  print at 2,1, "HOW TO PLAY"
  fill TRule count 28 at 2,2
  print at 2,3, "1-3 PLAYERS, FOUR ROUNDS."
  print at 2,4, "GUESS THE HIDDEN PHRASE."
  print at 2,6, "SPIN: THE BALL STOPS ON $200"
  print at 2,7, "TO $1000 FOR EACH TIME YOUR"
  print at 2,8, "CONSONANT IS IN THE PHRASE."
  print at 2,9, "BANKRUPT: THIS ROUND'S MONEY"
  print at 2,10, "IS LOST. LOSE A TURN: NEXT!"
  print at 2,11, "A WRONG LETTER ENDS A TURN."
  print at 2,13, "VOWELS COST $250."
  print at 2,14, "SOLVE: RIGHT BANKS THE ROUND"
  print at 2,15, "(AT LEAST $200)."
  print at 2,17, "TOP: THIS ROUND / BANKED."
  print at 2,18, "MOST MONEY PLAYS THE BONUS"
  print at 2,19, "ROUND: 5 CONSONANTS AND A"
  print at 2,20, "VOWEL, THEN SOLVE: $10,000."
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Stage = 3
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,1, "SPIN & SOLVE"
  print at 2,3, "BASED ON 'WHEEL OF FORTUNE'"
  print at 2,4, "BY RICHARD BAIN, AHOY!"
  print at 2,5, "MARCH 1987 (COMAL 0.14,"
  print at 2,6, "COMMODORE 64). PHRASES FROM"
  print at 2,7, "THE ORIGINAL'S DATA FILE."
  print at 2,9, "A PHRASE-GUESSING GAME FOR"
  print at 2,10, "1 TO 3 PLAYERS. NOT RELATED"
  print at 2,11, "TO ANY TV SHOW."
  print at 2,13, "COLECOVISION GAME, MUSIC"
  print at 2,14, "AND PICTURES BY CLAUDE"
  print at 2,15, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,16, "IN AMY BY AMY BIENVENU,"
  print at 2,17, "2026."
  print at 2,19, "MUSIC: ROUND AND ROUND"
  print at 2,20, "(ORIGINAL)"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Stage = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

sub Pause(u8 Nf):
  u8 Pk = 0
  for Pk = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  u8 B2 = 0
  J1 = 0
  if joypad(1).up or joypad(2).up then J1 = J1 | 1
  if joypad(1).down or joypad(2).down then J1 = J1 | 2
  if joypad(1).left or joypad(2).left then J1 = J1 | 4
  if joypad(1).right or joypad(2).right then J1 = J1 | 8
  if joypad(1).button1 or joypad(2).button1 then J1 = J1 | 16
  if joypad(1).button2 or joypad(2).button2 then B2 = 1
  Pj = J1
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Back = 0
  if B2 = 1 then
    if WasB2 = 0 then Back = 1
  end if
  WasB2 = B2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

