const NSpr = 8
const PickX = 9
const PickY = 13
const MenuY = 19
const MsgY = 22
const BoardY = 3

' the wheel, clockwise from the top left box: 0 = BANKRUPT, 1 = LOSE A
' TURN, else the value / 50 (the original's string "knfsdgoaemrlhaqjcpib")
data WheelV bytes
  12,15,7,20,5,8,16,0,6,14,19,13,9,0,18,11,4,17,10,1
end data
' the boxes' top left corners (4 x 2 tiles each) and stripe colours
data BoxC bytes
  4,8,12,16,20,24,24,24,24,24,24,20,16,12,8,4,4,4,4,4
end data
data BoxR bytes
  7,7,7,7,7,7,9,11,13,15,17,17,17,17,17,17,15,13,11,9
end data
data BoxS bytes
  0,1,2,3,4,5,0,9,1,2,3,4,5,9,0,1,2,3,4,8
end data

record Player:
  bcd digits 5 Rnd
  bcd digits 6 Tot
end record

Player Pl[3]
bcd digits 5 Gain = 0
bcd digits 5 Sh5 = 0
bcd digits 6 Sh6 = 0
bcd digits 6 Best = 0
