cartridge "BLOCK OUT/COMPUTE!'S GAZETTE/1988"

' BLOCK OUT
' From "Block Out", COMPUTE!'s Gazette, November 1988 (Commodore 128,
' BASIC 7.0 with a SPRITES data file; disk 1988-11). The program names
' no author (only "COPYRIGHT 1988 COMPUTE! PUBLICATIONS"). For the
' ColecoVision in Amy by Amy Bienvenu; ported by Claude (an AI made by
' Anthropic) for Amy Studio, 2026. Not related to the commercial 3-D
' falling-block game of the same name: only the Gazette program's rules.
'
' Source: orig/blockout.bas (detokenized with games/grimoak/orig/
' detok128.py) and orig/sprites.prg. Line numbers are the listing's.
'
' The game (two players, turn about): each player has a tray of four
' blocks, each one of four shapes (a window at the top, at the bottom,
' both, or one tall window) in one of five colours (130-200). On your
' turn pick a block from your tray with the stick and the button
' (250-320), then move along the 13 columns of the board and drop it
' (430-510); it lands on top of that column's stack (8 high; a full
' column refuses it). It scores, for each neighbour to its right, below
' it and to its left: 15 for the same colour, 25 for the same shape
' (590-640; both can count, at most 120 a drop). A new random block
' fills the empty tray slot (690-770). When all 13 columns are full the
' game is over and the scores are shown (780-890).
'
' Title menu: 1 PLAYER, 2 PLAYERS, HOW TO PLAY (three pages), CREDITS;
' the cursor is on 1 PLAYER each time the title appears.
' Controls: player 1 joystick 1, player 2 joystick 2 (as the original's
' ports). Left/right moves (hold to run), a side button picks or drops.
' One-player games: either joystick, against the ColecoVision. Keypad
' not used.
'
' Improvements: the picked block is carried over the board as a sprite,
' glides between columns and falls into place; tiled blocks with a light
' top edge; points shown where the block landed; sounds and an original
' title tune (played once); the winner is named.
' Liberties taken:
' - A one-player mode against the ColecoVision (the original needs two
'   players). The computer drops the block worth the most points now,
'   ties broken at random, at a visible, human pace.
' - A full column is refused with a low buzz (the original ignored the
'   button silently). The column cursor starts where the last drop was
'   instead of always at the left column (less stick work over 52 turns).
' - The blocks are redrawn (the C-128's multicolour 8 x 16 shapes needed
'   three colours a row; here: two per row). Colour pairs: blue, orange
'   (dark yellow), red, grey, green as the listing's five COLOR pairs.
' - The listing's tray-erasing BL$ and SE$ frame cursor become an empty
'   slot tile and an arrow under the tray.
' - A BLOCKS LEFT count; the final screen says who won (or a tie).
' House rules kept: text in columns 2-29, rows 1-22; tiles from 128; music
' first in the sound table; screens drawn with the NMI off; nothing
' flashes faster than 3 Hz.

const TB00_00 = 128
const TB00_01 = 129
const TB00_10 = 130
const TB00_11 = 131
const TB01_00 = 132
const TB01_01 = 133
const TB01_10 = 134
const TB01_11 = 135
const TB02_00 = 136
const TB02_01 = 137
const TB02_10 = 138
const TB02_11 = 139
const TB03_00 = 140
const TB03_01 = 141
const TB03_10 = 142
const TB03_11 = 143
const TB10_00 = 144
const TB10_01 = 145
const TB10_10 = 146
const TB10_11 = 147
const TB11_00 = 148
const TB11_01 = 149
const TB11_10 = 150
const TB11_11 = 151
const TB12_00 = 152
const TB12_01 = 153
const TB12_10 = 154
const TB12_11 = 155
const TB13_00 = 156
const TB13_01 = 157
const TB13_10 = 158
const TB13_11 = 159
const TB20_00 = 160
const TB20_01 = 161
const TB20_10 = 162
const TB20_11 = 163
const TB21_00 = 164
const TB21_01 = 165
const TB21_10 = 166
const TB21_11 = 167
const TB22_00 = 168
const TB22_01 = 169
const TB22_10 = 170
const TB22_11 = 171
const TB23_00 = 172
const TB23_01 = 173
const TB23_10 = 174
const TB23_11 = 175
const TB30_00 = 176
const TB30_01 = 177
const TB30_10 = 178
const TB30_11 = 179
const TB31_00 = 180
const TB31_01 = 181
const TB31_10 = 182
const TB31_11 = 183
const TB32_00 = 184
const TB32_01 = 185
const TB32_10 = 186
const TB32_11 = 187
const TB33_00 = 188
const TB33_01 = 189
const TB33_10 = 190
const TB33_11 = 191
const TB40_00 = 192
const TB40_01 = 193
const TB40_10 = 194
const TB40_11 = 195
const TB41_00 = 196
const TB41_01 = 197
const TB41_10 = 198
const TB41_11 = 199
const TB42_00 = 200
const TB42_01 = 201
const TB42_10 = 202
const TB42_11 = 203
const TB43_00 = 204
const TB43_01 = 205
const TB43_10 = 206
const TB43_11 = 207
const THole = 208
const TRail = 209
const TPeg = 210
const TWall = 211
const TWallr = 212
const TFloor = 213
const TSlot = 214
const SHi0 = 0
const SBd0 = 4
const SHi1 = 8
const SBd1 = 12
const SHi2 = 16
const SBd2 = 20
const SHi3 = 24
const SBd3 = 28
const SArrow = 32
const NTiles8 = 696
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndPick = 4
const SndThud = 5
const SndMatch = 6
const SndNoRoom = 7
const SndOver = 8
const NCol = 13
const NRow = 8
const Stride = 15
const HoverY = 31
const TuneLen = 576
const CpuStep = 10

record Piece:
  u8 Col
  u8 Shp
end record
Piece Tray[8]

' the board: Cel[Y * 15 + X], X 1-13, Y 1-8 (1 at the top); 0 empty,
' else colour * 4 + shape + 1. Row 0, row 9, columns 0 and 14 stay empty.
u8 Cel[150]
' free cells left in each column (the listing's Y(X)): 8 down to 0
u8 Ht[15]
u16 Score[2]

u16 TzLeft = 0
u8 TzOn = 0

' St: what the cartridge waits for (bots read it): 0 busy, 1 a button on
' the credits or title, 2 picking a tray block, 3 choosing a column,
' 4 the computer's turn, 9 the end of a game
u8 St = 0
u8 Players = 2
u8 Menu = 0
u8 Turn = 0
u8 Slot = 0
u8 Col = 1
u8 LastCol = 1
u8 LandY = 0
u8 Code = 0
u16 Gain = 0
u16 CpuBest = 0
u8 CpuSlot = 0
u8 CpuCol = 0
bcd digits 3 LeftB
u8 Left = 0
u8 Tick = 0
u8 Pn1 = 0
u8 Pn2 = 0
u8 Pw1 = 0
u8 Pw2 = 0
u8 PadNow = 0
u8 PadWas = 0
u8 Hold = 0
u8 Done = 0
u16 Rs = $B10C
u16 Rt = 0
u16 NumU = 0
u8 I = 0
u8 Kc = 0
u8 Tx = 0
u8 Ty = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 SprX = 0
u8 SprY = 0
u8 Vy = 0
u8 Cc = 0

' --- small helpers ----------------------------------------------------------
function ColOf(u8 Cd) as u8
  return (Cd - 1) >> 2

function ShpOf(u8 Cd) as u8
  return (Cd - 1) & 3

' 590-640: the points a block Cd would score at column X, row Y
function PointsAt(u8 X, u8 Y, u8 Cd) as u16
  u16 P = 0
  u8 Nb = 0
  u8 K = 0
  u8 Base = 0
  Base = Y * Stride + X
  for K = 0 to 2
    select case K
    case 0
      Nb = Cel[Base + 1]
    case 1
      Nb = Cel[Base + Stride]
    case else
      Nb = Cel[Base - 1]
    end select
    if Nb <> 0 then
      if ColOf(Nb) = ColOf(Cd) then P += 15
      if ShpOf(Nb) = ShpOf(Cd) then P += 25
    end if
  next
  return P

' the tile column of board column C (1-13)
function ColX(u8 C) as u8
  return C * 2 + 1

' the tile row of board row Y (1-8)
function RowY(u8 Y) as u8
  return Y * 2 + 5

' the tile column of tray slot S (0-7: 0-3 player 1, 4-7 player 2)
function SlotX(u8 S) as u8
  if S < 4 then return S * 3 + 2
  return S * 3 + 6

' a new press of a side button on the turn's controller
function FirePressed as u8
  V = PadWas & 16
  if V <> 0 then return 0
  V = PadNow & 16
  if V <> 0 then return 1
  return 0

  tile screen
  set sound table BoSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowToPage
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  NewGame
  PlayScreen

play_loop:
  if Players = 1 then
    if Turn = 1 then
      CpuTurn
      goto turn_done
    end if
  end if
  PickSlot
  PickColumn
turn_done:
  DropBlock
  if Left = 0 then goto game_end
  Turn = Turn ^ 1
  ShowTurn
  goto play_loop

game_end:
  GameOver
  St = 9
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  St = 0
  goto title

' ---------------------------------------------------------------------------
' 30, 100-230: an empty board, scores 0, two trays of random blocks
sub NewGame:
  fill array Cel with 0
  for I = 1 to NCol
    Ht[I] = NRow
  next
  Ht[0] = 0
  Ht[14] = 0
  Score[0] = 0
  Score[1] = 0
  for I = 0 to 7
    NewPiece(Tray[I])
  next
  Turn = 0
  Left = NCol * NRow
  LeftB = 104
  LastCol = 7
  return
end sub

' 130-190 / 690-760: a random shape and colour
sub NewPiece(ref Piece P):
  Rnd16
  P.Col = Rs % 5
  V = Rs >> 8
  P.Shp = V & 3
  return
end sub

' a block's four tiles at tile column Tc, row Tr
sub DrawPiece(ref Piece P, u8 Tc, u8 Tr):
  V = P.Col * 4 + P.Shp
  V = V * 4 + TB00_00
  put char V at Tc,Tr
  put char V + 1 at Tc + 1,Tr
  put char V + 2 at Tc,Tr + 1
  put char V + 3 at Tc + 1,Tr + 1
  return
end sub

sub DrawSlot(u8 S):
  Tx = SlotX(S)
  DrawPiece(Tray[S], Tx, 2)
  return
end sub

sub EmptySlot(u8 S):
  Tx = SlotX(S)
  fill 32 count 2 at Tx,2
  fill TSlot count 2 at Tx,3
  return
end sub

' 260-320: the arrow under the tray; left/right, a button picks
sub PickSlot:
  Slot = 0
  Hold = 0
  play sound SndPick
  St = 2
  Done = 0
  while Done = 0
    ShowArrow
    Frame1
    V = PadNow & 12
    select case V
    case 4
      if StepOk = 1 then
        if Slot > 0 then
          dec Slot
          play sound SndClick
        end if
      end if
    case 8
      if StepOk = 1 then
        if Slot < 3 then
          inc Slot
          play sound SndClick
        end if
      end if
    case else
      Hold = 0
    end select
    Done = FirePressed
  end while
  St = 0
  play sound SndThud
  ' 420: the block leaves the tray
  W = Turn * 4 + Slot
  EmptySlot(W)
  set sprite 2 to 192,0,0,0
  return
end sub

' a held stick steps at once, then every 6 frames after 16
function StepOk as u8
  inc Hold
  if Hold = 1 then return 1
  if Hold >= 16 then
    Hold = 11
    return 1
  end if
  return 0

sub ShowArrow:
  W = Turn * 4 + Slot
  V = SlotX(W)
  V = V * 8
  set sprite 2 to HoverY,V,SArrow,15
  update sprites
  return
end sub

' 430-510: the carried block glides over the columns; a button drops it
sub PickColumn:
  Col = LastCol
  W = Turn * 4 + Slot
  SprX = ColX(Col) * 8
  SprY = HoverY
  Hold = 0
  St = 3
  Done = 0
  while Done = 0
    Carry
    Frame1
    V = PadNow & 12
    select case V
    case 4
      if StepOk = 1 then
        if Col > 1 then
          dec Col
          play sound SndClick
        end if
      end if
    case 8
      if StepOk = 1 then
        if Col < NCol then
          inc Col
          play sound SndClick
        end if
      end if
    case else
      Hold = 0
    end select
    GlideX
    if FirePressed = 1 then
      ' 500: a full column takes nothing
      if Ht[Col] = 0 then
        play sound SndNoRoom
      else
        Done = 1
      end if
    end if
  end while
  St = 0
  return
end sub

' the carried sprite moves 4 pixels a frame toward its column
sub GlideX:
  V = ColX(Col) * 8
  if SprX < V then SprX += 4
  if SprX > V then SprX -= 4
  return
end sub

' the carried block (tray slot W) at SprX, SprY: highlight over body
sub Carry:
  V = Tray[W].Shp * 8
  Cc = Tray[W].Col
  set sprite 0 to SprY,SprX,V,HiColour(Cc)
  set sprite 1 to SprY,SprX,V + 4,BodyColour(Cc)
  update sprites
  return
end sub

function HiColour(u8 C) as u8
  select case C
  case 0
    return 5
  case 1
    return 11
  case 2
    return 9
  case 3
    return 15
  end select
  return 3

function BodyColour(u8 C) as u8
  select case C
  case 0
    return 4
  case 1
    return 10
  case 2
    return 8
  case 3
    return 14
  end select
  return 2

' 510-770: the block falls onto its column, scores, the tray refills
sub DropBlock:
  W = Turn * 4 + Slot
  LastCol = Col
  SprX = ColX(Col) * 8
  LandY = Ht[Col]
  Code = Tray[W].Col * 4 + Tray[W].Shp + 1
  Fall
  dec Ht[Col]
  V = LandY * Stride + Col
  Cel[V] = Code
  Tx = ColX(Col)
  Ty = RowY(LandY)
  DrawPiece(Tray[W], Tx, Ty)
  HideSprites
  play sound SndThud
  Gain = PointsAt(Col, LandY, Code)
  Score[Turn] += Gain
  dec Left
  LeftB -= 1
  ShowScores
  if Gain > 0 then
    play sound SndMatch
    NumU = Gain
    Tx = ColX(Col)
    if Tx > 26 then Tx = 26
    print at Tx,4, "+"
    if Gain >= 100 then
      print at Tx + 1,4, digits$(NumU, 3)
    else
      print at Tx + 1,4, digits$(NumU, 2)
    end if
  end if
  Pause(30)
  fill 32 count 4 at Tx,4
  NewPiece(Tray[W])
  DrawSlot(W)
  Pause(8)
  return
end sub

' a falling block, faster and faster, to row LandY
sub Fall:
  Ty = RowY(LandY) * 8 - 1
  Vy = 1
  while SprY < Ty
    V = Ty - SprY
    if V > Vy then
      SprY += Vy
    else
      SprY = Ty
    end if
    if Vy < 8 then inc Vy
    Carry
    Frame1
  end while
  return
end sub

' the computer: the block and column worth the most now (ties at random)
sub CpuTurn:
  St = 4
  CpuThink
  ' the arrow walks to its block
  Slot = 0
  ShowArrow
  Pause(24)
  while Slot < CpuSlot
    inc Slot
    play sound SndClick
    ShowArrow
    Pause(CpuStep)
  end while
  Pause(16)
  play sound SndThud
  W = 4 + Slot
  EmptySlot(W)
  set sprite 2 to 192,0,0,0
  ' the block glides to its column
  Col = LastCol
  SprX = ColX(Col) * 8
  SprY = HoverY
  Carry
  Pause(12)
  while Col <> CpuCol
    if Col < CpuCol then
      inc Col
    else
      dec Col
    end if
    play sound SndClick
    for Kc = 1 to 4
      GlideX
      Carry
      Frame1
    next
    Pause(4)
  end while
  Pause(20)
  St = 0
  return
end sub

sub CpuThink:
  u16 Pts = 0
  u8 S = 0
  u8 C = 0
  u8 Ties = 0
  u8 Cd = 0
  CpuBest = 0
  Ties = 0
  for S = 4 to 7
    Cd = Tray[S].Col * 4 + Tray[S].Shp + 1
    for C = 1 to NCol
      if Ht[C] > 0 then
        Pts = PointsAt(C, Ht[C], Cd)
        if Pts > CpuBest then
          CpuBest = Pts
          Ties = 0
        end if
        if Pts = CpuBest then
          ' keep the new one with chance 1 / (ties so far)
          inc Ties
          Rnd16
          V = Rs % Ties
          if V = 0 then
            CpuSlot = S - 4
            CpuCol = C
          end if
        end if
      end if
    next
  next
  return
end sub

' 840-890: the final scores and the winner
sub GameOver:
  HideSprites
  Pause(30)
  fill 32 count 8 at 11,1
  for Ty = 2 to 5
    fill 32 count 28 at 2,Ty
  next
  print at 7,2, "GAME OVER - FINAL"
  print at 8,3, "SCORES ABOVE"
  if Score[0] > Score[1] then
    print at 8,5, "PLAYER 1 WINS!"
  else
    if Score[1] > Score[0] then
      if Players = 1 then
        print at 6,5, "THE COMPUTER WINS!"
      else
        print at 8,5, "PLAYER 2 WINS!"
      end if
    else
      print at 9,5, "IT'S A TIE!"
    end if
  end if
  play sound SndOver
  return
end sub

sub ShowScores:
  NumU = Score[0]
  print at 6,1, digits$(NumU, 4)
  NumU = Score[1]
  print at 25,1, digits$(NumU, 4)
  print at 11,1, "LEFT "
  print at 16,1, LeftB
  return
end sub

sub ShowTurn:
  print at 13,2, "TURN"
  if Turn = 0 then
    print at 13,3, "<P1 "
  else
    if Players = 1 then
      print at 13,3, "CPU>"
    else
      print at 13,3, " P2>"
    end if
  end if
  return
end sub

' 70-90: the trays, the rail with its pegs, the board
sub PlayScreen:
  NewScreen
  print at 2,1, "1UP"
  if Players = 1 then
    print at 21,1, "CPU"
  else
    print at 21,1, "2UP"
  end if
  ShowScores
  for I = 0 to 7
    DrawSlot(I)
  next
  fill TRail count 28 at 2,6
  for I = 1 to NCol
    put char TPeg at ColX(I),6
  next
  for Ty = 7 to 22
    put char TWall at 2,Ty
    put char TWallr at 29,Ty
    fill THole count 26 at 3,Ty
  next
  fill TFloor count 28 at 2,23
  ShowTurn
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
sub Pause(u8 Nf):
  for J8 = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one controller's stick and buttons: bit 0 up, 1 down, 2 left,
' 3 right, 4 a button
function PadBits(u8 N) as u8
  u8 B = 0
  B = joypad(N).up | (joypad(N).down << 1)
  B = B | (joypad(N).left << 2) | (joypad(N).right << 3)
  B = B | (joypad(N).fire << 4)
  return B

' one frame; PadNow is the controller of the player whose turn it is
' (either one on menus and in one-player games)
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  Pw1 = Pn1
  Pw2 = Pn2
  Pn1 = PadBits(1)
  Pn2 = PadBits(2)
  if St = 2 or St = 3 then
    if Players = 2 then
      if Turn = 0 then
        PadNow = Pn1
        PadWas = Pw1
      else
        PadNow = Pn2
        PadWas = Pw2
      end if
      return
    end if
  end if
  PadNow = Pn1 | Pn2
  PadWas = Pw1 | Pw2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J8 = 0 to 2
    set sprite J8 to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' a new press of a button; the random numbers run meanwhile
sub WaitPress:
  Done = 0
  while Done = 0
    Frame1
    Rnd16
    Done = FirePressed
  end while
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,2, "BLOCK OUT"
  print at 2,5, "FROM COMPUTE!'S GAZETTE,"
  print at 2,6, "NOVEMBER 1988 (COMMODORE"
  print at 2,7, "128; THE PROGRAM NAMES NO"
  print at 2,8, "AUTHOR)."
  print at 2,10, "FOR THE COLECOVISION BY"
  print at 2,11, "CLAUDE (AN AI MADE BY"
  print at 2,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "2026, IN AMY, THE LANGUAGE"
  print at 2,14, "BY AMY BIENVENU."
  print at 2,16, "MUSIC: STACK AND MATCH"
  print at 2,17, "(ORIGINAL)."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  St = 1
  WaitPress
  St = 0
  return
end sub

' 900-970: rows of blocks, the name, the players; here also the rules
' and a 1 or 2 player choice
sub TitlePage:
  NewScreen
  for I = 0 to 6
    Tx = I * 4 + 2
    Kc = I % 5
    Tray[0].Col = Kc
    Tray[0].Shp = 0
    DrawPiece(Tray[0], Tx, 1)
    Tray[0].Col = 4 - Kc
    Tray[0].Shp = 2
    DrawPiece(Tray[0], Tx + 2, 1)
  next
  print at 8,4, "BLOCK  -  OUT"
  print at 2,6, "TAKE TURNS: PICK ONE OF YOUR"
  print at 2,7, "FOUR BLOCKS, THEN DROP IT ON"
  print at 2,8, "ONE OF THE 13 COLUMNS. EACH"
  print at 2,9, "BLOCK BESIDE OR UNDER IT"
  print at 2,10, "SCORES 15 FOR THE SAME COLOR"
  print at 2,11, "AND 25 FOR THE SAME SHAPE."
  print at 2,12, "WHEN THE BOARD IS FULL, THE"
  print at 2,13, "HIGHER SCORE WINS."
  print at 9,15, "1 PLAYER"
  print at 9,16, "2 PLAYERS"
  print at 9,17, "HOW TO PLAY"
  print at 9,18, "CREDITS"
  print at 4,21, "PLAYER 1: JOYSTICK 1"
  print at 4,22, "PLAYER 2: JOYSTICK 2"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Menu = 0
  St = 1
  Done = 0
  while Done = 0
    ShowMenu
    Frame1
    Rnd16
    V = PadNow & 3
    W = PadWas & 3
    if V = 1 and W = 0 then
      if Menu > 0 then
        play sound SndClick
        dec Menu
      end if
    end if
    if V = 2 and W = 0 then
      if Menu < 3 then
        play sound SndClick
        inc Menu
      end if
    end if
    Done = FirePressed
  end while
  St = 0
  if Menu < 2 then Players = Menu + 1
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  return
end sub

sub ShowMenu:
  for J8 = 15 to 18
    put char 32 at 7,J8
  next
  J8 = Menu + 15
  put char 62 at 7,J8
  return
end sub

' a block of colour Kc and shape Ks at Tx,Ty (HOW TO PLAY pictures)
sub HtBlock(u8 Kc, u8 Ks):
  Tray[0].Col = Kc
  Tray[0].Shp = Ks
  DrawPiece(Tray[0], Tx, Ty)
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "TWO PLAYERS TAKE TURNS (OR"
    print at 2,4, "PLAY THE COLECOVISION)."
    print at 2,6, "EACH PLAYER HAS FOUR BLOCKS."
    print at 2,7, "PICK ONE, THEN DROP IT ON"
    print at 2,8, "ONE OF THE 13 COLUMNS. IT"
    print at 2,9, "LANDS ON TOP OF THAT STACK."
    print at 2,10, "A NEW BLOCK FILLS YOUR TRAY."
    for I = 0 to 3
      Tx = I * 3 + 9
      Ty = 13
      HtBlock(I, I)
    next
    fill TRail count 26 at 3,16
    for Ty = 17 to 20
      put char TWall at 8,Ty
      put char TWallr at 23,Ty
      fill THole count 14 at 9,Ty
    next
    Tx = 13
    Ty = 19
    HtBlock(2, 1)
    Tx = 15
    HtBlock(4, 3)
    Tx = 15
    Ty = 17
    HtBlock(2, 0)
  case 2
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "PLAYER 1 USES JOYSTICK 1,"
    print at 2,4, "PLAYER 2 USES JOYSTICK 2."
    print at 2,6, "LEFT/RIGHT: CHOOSE A BLOCK"
    print at 2,7, "IN YOUR TRAY. BUTTON: PICK"
    print at 2,8, "IT UP."
    print at 2,10, "LEFT/RIGHT: CARRY IT OVER"
    print at 2,11, "THE COLUMNS. BUTTON: DROP."
    print at 2,13, "A FULL COLUMN BUZZES: PICK"
    print at 2,14, "ANOTHER ONE."
    for I = 0 to 3
      Tx = I * 3 + 9
      Ty = 17
      HtBlock(4 - I, 3 - I)
    next
    set sprite 0 to 151,96,SArrow,15
    update sprites
  case 3
    print at 2,1, "SCORING                3/3"
    print at 2,3, "YOUR BLOCK SCORES FOR EACH"
    print at 2,4, "BLOCK RIGHT, LEFT OR UNDER"
    print at 2,5, "IT:"
    print at 2,6, "SAME COLOR            15"
    print at 2,7, "SAME SHAPE            25"
    print at 2,9, "WHEN ALL 13 COLUMNS ARE"
    print at 2,10, "FULL, THE GAME IS OVER. THE"
    print at 2,11, "HIGHER SCORE WINS."
    print at 2,13, "TIP: DROP A BLOCK NEXT TO"
    print at 2,14, "ONES OF ITS COLOR OR SHAPE."
    print at 2,15, "A MATCH ON BOTH SIDES AND"
    print at 2,16, "BELOW SCORES THE MOST!"
    Ty = 19
    Tx = 11
    HtBlock(0, 1)
    Tx = 13
    HtBlock(1, 0)
    Tx = 15
    HtBlock(2, 3)
    Ty = 17
    Tx = 11
    HtBlock(1, 2)
    Tx = 15
    HtBlock(3, 2)
    Tx = 13
    Ty = 17
    HtBlock(1, 2)
    print at 19,17, "+80"
    print at 19,18, "(40+25+15)"
  end select
  print at 9,22, "PRESS A BUTTON"
  ShowScreen
  St = 1
  Wt = 0
  Done = 0
  while Done = 0
    Frame1
    Rnd16
    Wt = Wt + 1
    if Wt >= 1800 then Done = 2
    if Done = 0 then Done = FirePressed
  end while
  St = 0
  HideSprites
  if Done = 2 then return
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

