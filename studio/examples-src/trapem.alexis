cartridge "TRAP 'EM/JON RHEES/1985"

' TRAP 'EM
' A ColecoVision game based on "Trap 'Em" by Jon Rhees, COMPUTE!'s
' Gazette January 1985 (Commodore 64 and VIC-20, BASIC with a machine-
' language core). Made for Amy Studio by Claude (an AI made by Anthropic),
' 2026, in Amy by Amy Bienvenu.
'
' The game: two builders run fences across a walled yard. A fence grows
' all the time, one cell per step, across or up and down; the stick turns
' it. It may not touch the outer wall, any fence (yours or the other's) or
' the rocks. When the other builder's fence crashes first, you win the
' round and score one point for each second the round lasted. The first to
' 100 points wins. PRACTICE (one player): survive as long as you can; ten
' rounds, each second worth (speed + 1) points.
'
' From the original (orig/trap_em_64.bas, its machine code, run in jsc64):
' the walled yard, the starts (same row, red facing right a third of the
' way in, blue facing left), the fences growing a cell at a time, crashes
' into walls, fences and barriers, the points of the round's seconds, 100
' points to win, the barriers (about 4% of the yard, never on the start
' row), the speed 0-9 (the C64 waits 60 - 6 x speed loops a step; measured
' in jsc64: about 31 frames a step at 0 down to 4 at 9), practice of ten
' rounds with points x (speed + 1) and a high score, a head-on meeting or
' two crashes on the same step won by one of the two at random, the
' crashed fence flashing.
'
' Liberties: ONE PLAYER VS COMPUTER is new (the computer runs the blue
' fence; it looks a few cells ahead and keeps away from dead ends); the
' original only had practice for one player. The yard is 26 x 19 (C64
' 38 x 21) and 19 barriers (C64 30), so it fits the TV-safe area. Pulling
' the stick straight back is ignored (on the C64 it crashed you into your
' own fence at once). The builder heads glide between cells; the fence is
' laid behind them. A short GET READY before each round (the C64 started
' at once). Joystick menu instead of keys; no keyboard controls.
'
' Controls: PRACTICE and VS COMPUTER: either controller. TWO PLAYERS:
' controller 1 red, controller 2 blue. On the title, up/down choose a line,
' left/right change it, a button on START GAME starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off after
' a wait, display off. Music first in the sound table; the title tune is
' played once. Nothing flashes faster than 3 Hz.

const TGd = 128
const TWall = 129
const TRock = 130
const TFr = 131
const TFb = 132
const SHead = 0
const SBang = 4
const NTiles8 = 40
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndTick = 3
const SndTurn = 4
const SndCrash = 5
const SndReady = 6
const SndPoint = 7
const SndWin = 8
const SndOver = 9
const NSpr = 4
const FirstC = 3
const LastC = 28
const FirstR = 3
const LastR = 21
const StartR = 12
const WinPts = 100
const NBarr = 19
const ReadyN = 70
const CrashN = 72

' frames a step for speed 0-9 (C64 measured), and 128 / that (glide)
data StepT bytes
  31, 28, 25, 22, 19, 16, 13, 10, 7, 4
end data
data GlideT bytes
  4, 4, 5, 5, 6, 8, 9, 12, 18, 32
end data
' direction 0 up, 1 right, 2 down, 3 left
data DcT bytes
  0, 1, 0, 255
end data
data DrT bytes
  255, 0, 1, 0
end data
data HeadCol bytes
  9, 7
end data

record Builder
  u8 C
  u8 R
  u8 D
  u8 W
  u8 LC
  u8 LR
  u8 Hit
end record

Builder Pl[2]
u16 Pts[2]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Secs = 0
u16 Sc = 0
u16 Hi = 0
u16 Gain = 0
u8 SubF = 0
u8 Mode = 1
u8 Speed = 4
u8 Barr = 1
u8 Np = 2
u8 RoundN = 0
u8 StepF = 16
u8 StepI = 8
u8 Sct = 0
u16 Steps = 0
u8 Phase = 0
u8 PhaseT = 0
u8 Winner = 0
u8 Over = 0
u8 Line = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 Pi = 0
u8 Ri = 0
u8 Bi = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0
u8 Qc = 0
u8 Qr = 0
u8 Best = 0
u8 BestD = 0

  tile screen
  set sound table TeSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Line >= 4 then goto title

  NewGame
round_loop:
  NewRound
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Phase < 3 then goto play_loop
  ' the round is over: points, then the next round or the end
  if Over = 0 then goto round_loop

  mute all
  ShowHud
  EndMessage
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play. Phase 0 get ready, 1 running, 2 crash shown, 3 done

sub PlayStep:
  if Phase = 0 then
    dec PhaseT
    if PhaseT = 0 then
      Phase = 1
      DrawWallRow
    end if
    return
  end if
  if Phase = 2 then
    dec PhaseT
    if PhaseT = 0 then
      Award
      Phase = 3
    end if
    return
  end if
  ' running: the clock, then a step when the count runs out
  inc SubF
  if SubF >= 60 then
    SubF = 0
    inc Secs
    ShowTime
  end if
  dec Sct
  if Sct = 0 then
    Sct = StepF
    StepAll
  end if
  return
end sub

' every builder lays a fence on its cell and moves on a cell
sub StepAll:
  ' fences first: the cells the heads leave are fence from now on
  for Pi = 0 to Np - 1
    C = Pl[Pi].C
    R = Pl[Pi].R
    T = TFr + Pi
    put char T at C,R
    Pl[Pi].LC = C
    Pl[Pi].LR = R
  next
  if Mode = 1 then CpuThink
  for Pi = 0 to Np - 1
    D = Pl[Pi].W
    Pl[Pi].D = D
    Qc = Pl[Pi].C + DcT[D]
    Qr = Pl[Pi].R + DrT[D]
    T = get char at Qc,Qr
    if T <> TGd then
      Pl[Pi].Hit = 1
    else
      Pl[Pi].C = Qc
      Pl[Pi].R = Qr
    end if
  next
  ' two heads into the same cell: both crash
  if Np = 2 then
    if Pl[0].Hit = 0 then
      if Pl[1].Hit = 0 then
        if Pl[0].C = Pl[1].C then
          if Pl[0].R = Pl[1].R then
            Pl[0].Hit = 1
            Pl[1].Hit = 1
          end if
        end if
      end if
    end if
  end if
  inc Steps
  N = Pl[0].Hit
  if Np = 2 then N = N + Pl[1].Hit
  if N = 0 then
    play sound SndTick
  else
    Crashed
  end if
  return
end sub

sub Crashed:
  ' a crash: on both at once one of the two loses at random (C64 rule)
  if N = 2 then
    Rand
    V = Rs & 1
    Pl[V].Hit = 0
  end if
  Winner = 0
  if Np = 2 then
    if Pl[0].Hit = 1 then Winner = 1
    if Pl[1].Hit = 1 then Winner = 0
  end if
  for Pi = 0 to Np - 1
    Pl[Pi].LC = Pl[Pi].C
    Pl[Pi].LR = Pl[Pi].R
  next
  Phase = 2
  PhaseT = CrashN
  play sound SndCrash
  return
end sub

' the points of a round: its seconds to the winner (practice: x speed + 1)
sub Award:
  if Np = 1 then
    V = Speed + 1
    Gain = Secs * V
    Sc = Sc + Gain
  else
    Gain = Secs
    Pts[Winner] = Pts[Winner] + Gain
  end if
  ShowHud
  play sound SndPoint
  if Np = 1 then
    if RoundN >= 10 then Over = 1
  else
    if Pts[Winner] >= WinPts then Over = 1
  end if
  return
end sub

' the free cells straight ahead of cell C0,R0 in direction D0 (up to Lim)
function Run(u8 C0, u8 R0, u8 D0, u8 Lim) as u8
  u8 Cnt = 0
  u8 Cc = 0
  u8 Rr = 0
  u8 Tl = 0
  u8 Go = 1
  Cc = C0
  Rr = R0
  while Go = 1
    Cc = Cc + DcT[D0]
    Rr = Rr + DrT[D0]
    Tl = get char at Cc,Rr
    if Tl <> TGd then
      Go = 0
    elseif Cnt >= Lim then
      Go = 0
    else
      inc Cnt
    end if
  end while
  return Cnt

function TurnOf(u8 D0, u8 K0) as u8
  u8 Dt = 0
  select case K0
  case 0
    Dt = D0
  case 1
    Dt = D0 + 1
  case else
    Dt = D0 + 3
  end select
  return Dt & 3

' the computer (blue): straight on while the way is long, else the side
' with more room; it sometimes turns early to cut the other fence off
sub CpuThink:
  u8 Ki = 0
  u8 Dk = 0
  u8 L = 0
  u8 Side = 0
  u8 Score = 0
  u8 Nc = 0
  u8 Nr = 0
  Best = 0
  BestD = Pl[1].D
  Rand
  for Ki = 0 to 2
    Dk = TurnOf(Pl[1].D, Ki)
    L = Run(Pl[1].C, Pl[1].R, Dk, 6)
    if L > 0 then
      Nc = Pl[1].C + DcT[Dk]
      Nr = Pl[1].R + DrT[Dk]
      ' the room to both sides of the next cell
      Side = Run(Nc, Nr, (Dk + 1) & 3, 3)
      Side = Side + Run(Nc, Nr, (Dk + 3) & 3, 3)
      Score = L * 2
      Score = Score + Side
      if Ki = 0 then
        if L >= 4 then Score = Score + 8
      end if
      ' never step where the red head is going next
      if Nc = Pl[0].C + DcT[Pl[0].D] then
        if Nr = Pl[0].R + DrT[Pl[0].D] then Score = 1
      end if
      V = highbyte(Rs)
      V = V & 7
      Score = Score + V
      if Score > Best then
        Best = Score
        BestD = Dk
      end if
    end if
  next
  Pl[1].W = BestD
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' input: the stick turns a fence; straight back is ignored

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  if Phase <> 1 then return
  if Mode = 2 then
    Steer(Pl[0], J1)
    Steer(Pl[1], J2)
  else
    V = J1 | J2
    Steer(Pl[0], V)
  end if
  return
end sub

' a turn across the way it goes first, so diagonals turn
sub Steer(ref Builder B, u8 S):
  u8 Want = 255
  u8 Dd = 0
  Dd = B.D & 1
  if Dd = 1 then
    if S & 1 then Want = 0
    if S & 2 then Want = 2
  else
    if S & 4 then Want = 3
    if S & 8 then Want = 1
  end if
  if Want = 255 then
    if S & 1 then Want = 0
    if S & 2 then Want = 2
    if S & 4 then Want = 3
    if S & 8 then Want = 1
  end if
  if Want < 4 then
    Dd = B.D ^ 2
    if Want <> Dd then B.W = Want
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' heads glide from the cell they left to the cell they are in
sub DrawSprites:
  u8 Off = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Pat = 0
  u8 Col = 0
  u8 Dg = 0
  if TitleOn = 1 then
    update sprites
    return
  end if
  K = StepF - Sct
  Off = K * StepI
  Off = Off >> 4
  if Off > 8 then Off = 8
  if Phase <> 1 then Off = 0
  for Pi = 0 to 1
    if Pi >= Np then
      set sprite Pi to 192,0,0,0
    else
      Sx = Pl[Pi].LC << 3
      Sy = Pl[Pi].LR << 3
      Dg = Pl[Pi].D
      if Dg = 0 then Sy = Sy - Off
      if Dg = 1 then Sx = Sx + Off
      if Dg = 2 then Sy = Sy + Off
      if Dg = 3 then Sx = Sx - Off
      Sy = Sy - 1
      Pat = SHead
      Col = HeadCol[Pi]
      if Pl[Pi].Hit = 1 then
        Pat = SBang
        ' the crash flashes: 10 frames white, 10 its colour (3 Hz)
        V = PhaseT / 10
        V = V & 1
        if V = 1 then Col = 15
      end if
      set sprite Pi to Sy,Sx,Pat,Col
    end if
  next
  update sprites
  return
end sub

sub ShowTime:
  NumU = Secs
  print at 13,1, "TIME"
  print at 18,1, digits$(NumU, 3)
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  if Mode = 0 then
    print at 2,1, "SC"
    NumU = Sc
    print at 5,1, digits$(NumU, 4)
    print at 22,1, "ROUND"
    NumU = RoundN
    print at 28,1, digits$(NumU, 2)
  else
    if Mode = 1 then
      print at 2,1, "YOU"
      print at 23,1, "CPU"
    else
      print at 2,1, "RED"
      print at 22,1, "BLUE"
    end if
    NumU = Pts[0]
    print at 6,1, digits$(NumU, 3)
    NumU = Pts[1]
    print at 27,1, digits$(NumU, 3)
  end if
  ShowTime
  return
end sub

sub DrawWallRow:
  fill TWall count 28 at 2,LastR + 1
  return
end sub

' the yard: wall, floor, barriers
sub DrawYard:
  fill TWall count 28 at 2,FirstR - 1
  DrawWallRow
  for Ri = FirstR to LastR
    put char TWall at 2,Ri
    fill TGd count 26 at FirstC,Ri
    put char TWall at 29,Ri
  next
  if Barr = 1 then
    Bi = 0
    while Bi < NBarr
      Rand
      X = Rs & 31
      Rand
      Y = Rs & 31
      Got = 1
      if X < FirstC then Got = 0
      if X > LastC then Got = 0
      if Y < FirstR then Got = 0
      if Y > LastR then Got = 0
      if Y = StartR then Got = 0
      if Got = 1 then
        T = get char at X,Y
        if T = TGd then
          put char TRock at X,Y
          inc Bi
        end if
      end if
    end while
  end if
  return
end sub

sub NewGame:
  Sc = 0
  Pts[0] = 0
  Pts[1] = 0
  RoundN = 0
  Over = 0
  Np = 2
  if Mode = 0 then Np = 1
  StepF = StepT[Speed]
  StepI = GlideT[Speed]
  TitleOn = 0
  return
end sub

sub NewRound:
  inc RoundN
  NewScreen
  DrawYard
  Secs = 0
  SubF = 0
  ShowHud
  Pl[0].C = 9
  Pl[0].R = StartR
  Pl[0].D = 1
  Pl[0].W = 1
  Pl[1].C = 22
  Pl[1].R = StartR
  Pl[1].D = 3
  Pl[1].W = 3
  for Pi = 0 to 1
    Pl[Pi].LC = Pl[Pi].C
    Pl[Pi].LR = Pl[Pi].R
    Pl[Pi].Hit = 0
  next
  Steps = 0
  Sct = StepF
  Phase = 0
  PhaseT = ReadyN
  print at 9,LastR + 1, " ROUND "
  NumU = RoundN
  print at 16,LastR + 1, digits$(NumU, 2)
  print at 18,LastR + 1, " READY "
  DrawSprites
  ShowScreen
  play sound SndReady
  return
end sub

sub EndMessage:
  print at 6,9, "                    "
  print at 6,11, "                    "
  print at 6,13, "                    "
  if Mode = 0 then
    print at 6,10, "  PRACTICE OVER     "
    print at 6,12, "  SCORE      HIGH   "
    if Sc > Hi then Hi = Sc
    NumU = Sc
    print at 14,12, digits$(NumU, 4)
    NumU = Hi
    print at 24,12, digits$(NumU, 4)
    play sound SndOver
  else
    select case Mode * 2 + Winner
    case 2
      print at 6,10, "     YOU WIN!       "
      play sound SndWin
    case 3
      print at 6,10, "  THE COMPUTER WINS "
      play sound SndOver
    case 4
      print at 6,10, "     RED WINS!      "
      play sound SndWin
    case else
      print at 6,10, "     BLUE WINS!     "
      play sound SndWin
    end select
    print at 6,12, "  RED        BLUE   "
    if Mode = 1 then print at 6,12, "  YOU        CPU    "
    NumU = Pts[0]
    print at 12,12, digits$(NumU, 3)
    NumU = Pts[1]
    print at 23,12, digits$(NumU, 3)
  end if
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: name, menu (the cursor on START GAME), the tune once
sub TitlePage:
  NewScreen
  TitleOn = 1
  Phase = 3
  fill TFr count 14 at 9,3
  fill TFb count 14 at 9,7
  print at 11,5, "TRAP 'EM"
  print at 9,8, "BY JON RHEES"
  print at 2,1, "HI"
  NumU = Hi
  print at 5,1, digits$(NumU, 4)
  print at 14,1, "GAZETTE JAN 1985"
  Line = 3
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 15
  if V > 0 then
    if WasStick = 0 then
      MenuStick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Line < 3 then
    V = 8
    MenuStick
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Line = 4 then HowTo
  if Line = 5 then CreditsPage
  return
end sub

' V: the stick bits (1 up, 2 down, 4 left, 8 right)
sub MenuStick:
  K = V & 1
  if K > 0 then
    if Line > 0 then dec Line
    return
  end if
  K = V & 2
  if K > 0 then
    if Line < 5 then inc Line
    return
  end if
  K = V & 12
  if K = 0 then return
  K = V & 8
  select case Line
  case 0
    if K > 0 then
      Mode = Mode + 1
      if Mode > 2 then Mode = 0
    else
      if Mode = 0 then Mode = 3
      Mode = Mode - 1
    end if
  case 1
    Barr = Barr ^ 1
  case 2
    if K > 0 then
      if Speed < 9 then inc Speed
    else
      if Speed > 0 then dec Speed
    end if
  end select
  return
end sub

sub ShowMenu:
  select case Mode
  case 0
    print at 6,11, "PLAYERS  1 PRACTICE "
  case 1
    print at 6,11, "PLAYERS  1 VS CPU   "
  case else
    print at 6,11, "PLAYERS  2          "
  end select
  if Barr = 1 then
    print at 6,13, "BARRIERS YES"
  else
    print at 6,13, "BARRIERS NO "
  end if
  print at 6,15, "SPEED"
  NumU = Speed
  print at 15,15, digits$(NumU, 1)
  print at 6,17, "START GAME"
  print at 6,19, "HOW TO PLAY"
  print at 6,21, "CREDITS"
  for J = 0 to 5
    K = J << 1
    K = K + 11
    put char 32 at 4,K
  next
  K = Line << 1
  K = K + 11
  put char 62 at 4,K
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "TRAP 'EM"
  print at 2,5, "BASED ON TRAP 'EM BY"
  print at 2,6, "JON RHEES, COMPUTE!'S"
  print at 2,7, "GAZETTE, JANUARY 1985"
  print at 2,8, "(COMMODORE 64 / VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: FENCE LINE"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' HOW TO PLAY: two pages with the game's own tiles and sprites; the
' button turns the page, 30 s alone goes back to the title
sub HowTo:
  NewScreen
  print at 9,1, "HOW TO PLAY  1/2"
  print at 2,3, "TWO FENCES GROW ACROSS THE"
  print at 2,4, "YARD, ONE CELL AT A TIME."
  print at 2,5, "STEER YOURS SO IT DOES NOT"
  print at 2,6, "CRASH!"
  fill TWall count 28 at 2,8
  for J = 9 to 11
    put char TWall at 2,J
    fill TGd count 26 at 3,J
    put char TWall at 29,J
  next
  fill TWall count 28 at 2,12
  fill TFr count 8 at 5,10
  fill TFb count 8 at 19,10
  put char TRock at 15,9
  put char TRock at 22,11
  set sprite 0 to 79,104,SHead,9
  set sprite 1 to 79,144,SHead,7
  update sprites
  print at 2,14, "STICK: TURN YOUR FENCE UP,"
  print at 2,15, "DOWN, LEFT OR RIGHT."
  print at 2,17, "A FENCE CRASHES WHEN IT HITS"
  print at 2,18, "THE WALL, ANY FENCE OR A"
  print at 2,19, "BARRIER."
  print at 2,21, "TWO PLAYERS: STICK 1 IS RED,"
  print at 2,22, "STICK 2 IS BLUE."
  HowWait
  NewScreen
  print at 9,1, "HOW TO PLAY  2/2"
  print at 2,3, "WHEN THE OTHER FENCE CRASHES"
  print at 2,4, "FIRST, YOU WIN THE ROUND AND"
  print at 2,5, "ONE POINT FOR EACH SECOND"
  print at 2,6, "IT LASTED. FIRST TO 100"
  print at 2,7, "WINS!"
  fill TFb count 6 at 9,9
  set sprite 0 to 71,120,SBang,7
  update sprites
  print at 2,11, "PRACTICE: TEN ROUNDS ALONE."
  print at 2,12, "LAST AS LONG AS YOU CAN:"
  print at 2,13, "SECONDS X (SPEED + 1)."
  print at 2,15, "ON THE TITLE, BARRIERS ADD"
  print at 2,16, "ROCKS AND SPEED GOES FROM"
  print at 2,17, "0 TO 9."
  print at 2,19, "TIP: DON'T BOX YOURSELF IN."
  print at 2,20, "LEAVE A WAY OUT!"
  HowWait
  HideSprites
  return
end sub

sub HowWait:
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  NumU = 0
hw_loop:
  Frame1
  ReadPad
  inc NumU
  if NumU >= 1800 then return
  if Press = 0 then goto hw_loop
  return
end sub

