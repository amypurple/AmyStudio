cartridge "LAVA PIT/BY SCOTT PETERSON/2026"

' LAVA PIT - ColecoVision port of "Lava Pit" by Scott Peterson, a Commodore
' 64 BASIC + machine language duel from RUN Magazine's ReRUN "Game Pak" disk
' (program LAVA PIT, 9,644 bytes; "BY SCOTT PETERSON" on its title screen).
' The rules follow the original's machine code (orig/lava_ml.dis, SYS 38238,
' one "tick"), checked against the running original with bots (c64/,
' model.mjs: the model gives the C64's state at 99.5% of 7,837 traced ticks;
' the rest are the C64's own raster races).
'
' The game: two Vadraks, the albino (white) and the pigmented (gold), fly
' over a pit of lava. The button flaps the wings (once per press), the stick
' steers: each tick a held direction adds 1 to the speed (up to 16), and the
' speed stays. Gravity pulls every tick; touching a ledge bounces a bird up.
' When the two birds touch, the LOWER one (the albino on a tie) loses a
' point; a bird falling into the lava loses a point too. The loser starts
' again from the top. Each point moves the marker in the bottom row one way:
' the albino wins at the left end, the pigmented at the right end. The game
' gets faster as one bird leads (the C64's delay loop, timed on the C64).
'
' Controls: controller 1 flies the albino, controller 2 the pigmented (or
' the ColecoVision in a 1-player game). Stick left/right steers, either
' side button flaps. Title menu: stick up/down, left/right (or the button)
' changes PLAYERS and LEAD, the button on START starts.
'
' Liberties (ColecoVision adaptation): new pictures (the C64's ledges, lava
' and bubbles redrawn from its own characters in colour, a cave ceiling, a
' title logo; the C64's "PREPARE TO JOUST..." loading strip kept on the
' title); the birds are drawn smoothly between ticks (the C64 moved them
' 2-9 pixels at a time, 14-28 times a second) and are hidden or held at the
' edge where the C64's border hid them, so nothing shows in the TV's
' overscan; 1-PLAYER mode against the ColecoVision (new); LEAD option 5 / 10
' / 20 (the original's 20-point lead takes a long time between equal
' players; 10 is the default: each point moves the marker 2 steps, the
' speed-up follows the marker as on the C64); title menu, HOW TO PLAY,
' CREDITS; title tune (original); the victory message is the original's,
' then one press returns to the title (no PLAY AGAIN? question).
' Original bugs fixed: (1) the visible sprites were never placed before the
' first tick, so both sat at X 0 and the first tick always saw a collision:
' the albino lost a point before anyone moved; (2) Y + VY wraps at 256: a
' bird flapping just after its restart at the top (Y 0-5) wrapped to the
' bottom of the screen and lost another point at once (the C64 bots hit it
' 20 times in 25 restarts while flapping): here a bird stops at Y 0; (3) the
' pigmented bird started with facing 3, so holding the button before any
' left/right showed sprite block 228 (empty: the bird vanished): it starts
' facing 2 (left), the C64's picture when idle.
' Kept as in the original: the lower bird loses on contact (equal Y: the
' albino), a bird touching the ceiling (Y < 49) is pushed down at speed 3,
' moving left is one pixel a tick slower than right (SEC before ADC), the
' birds wrap at X 512 through the hidden border, collisions are tested on
' the C64's own sprite and character pixels (in C64 units), lava bubbles
' rise from the C64's own random sequence (x 5 + 1) and can bounce a bird.
'
' Compiler e0f450b5 features used: records with u16 fields in an array and
' `with B[I] as Q` aliases; u32 shifts by a variable count (the bird-bird
' pixel test); i16 arithmetic shifts and abs(); a typed state machine for
' the screens (`dispatch`); `select case` with `case is` arms; functions with
' parameters; `play song ... once` for the title tune (Tiny Sound + OS7 noise
' bass started by a song schedule); u8 variable shifts; ZX0 decompression.

const TJoust0 = 128
const TJoust1 = 129
const TJoust2 = 130
const TJoust3 = 131
const TJoust4 = 132
const TJoust5 = 133
const TJoust6 = 134
const TJoust7 = 135
const TJoust8 = 136
const TJoust9 = 137
const TJoust10 = 138
const TJoust11 = 139
const TJoust12 = 140
const TJoust13 = 141
const TJoust14 = 142
const TJoust15 = 143
const TJoust16 = 144
const TJoust17 = 145
const TJoust18 = 146
const TJoust19 = 147
const TJoust20 = 148
const TLedgeT0 = 149
const TLedgeT1 = 150
const TLedgeT2 = 151
const TLedgeB0 = 152
const TLedgeB1 = 153
const TLedgeB2 = 154
const TLavaRow = 155
const TRockRow = 156
const TRockTop = 157
const TBub0 = 158
const TBub1 = 159
const TBub2 = 160
const TBub3 = 161
const TBub4 = 162
const TBub5 = 163
const TBub6 = 164
const TBub7 = 165
const TBub8 = 166
const TBub9 = 167
const TBub10 = 168
const UiBytes = 328
const LogoBase = 169
const LogoW = 24
const LogoH = 4
const LogoBytes = 424
const SDRU = 0
const SBRU = 4
const SDRD = 8
const SBRD = 12
const SDLU = 16
const SBLU = 20
const SDLD = 24
const SBLD = 28
const SMark = 32
const SBlank = 36
const SprBytes = 320
const LavaBase = 240
const SndMel = 1
const SndHarm = 2
const SndBassV = 3
const SndBassP = 4
const SndFlap = 5
const SndBump = 6
const SndFallP = 7
const SndFallN = 8
const SndClick = 9
const SndWin = 10
const TuneFrames = 448
const HideY = 192
const NSpr = 5
' bot-visible states
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StOver = 9
const StEnding = 8
' C64 constants (machine code)
const XAlbino = 139
const XPigment = 208
const YCeil = 49
const YLava = 217

state machine Screen:
  Title calls TitlePage
  How calls HowTo
  Credits calls CreditsPage
  Play calls PlayGame
end state machine

' a Vadrak, in the C64's units (sprite X 0-511, Y 0-255, speeds as bytes
' 0-255 = signed -128..127, as in $9500-$9507)
record Bird:
  u16 X
  u8 Y
  u8 VY
  u8 VX
  u8 Fl
  u8 Off
  u8 Ptr
  u16 DX
  u16 PX
  u8 PY
  u8 Joy
  u8 Hit
end record

Bird B[2]
u8 LavaRow[40]
u8 Bc[5]
u8 NextScr = 1
u8 State = 0
u8 Wn = 20
u8 StepPt = 2
u8 Lead = 1
u8 Players = 1
u8 Over = 0
u8 Z = 0
u8 Bi = 0
u8 Ss = 0
u8 Sb = 0
u8 Pl = 0
u8 Pd = 0
u8 Pb = 0
u8 Ri = 0
u8 Ci = 0
u8 Fr = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 Tick = 0
u8 Idle = 0
u8 Elapsed = 1
u8 LastVb = 0
u8 NeedCol = 0
u8 Points = 0
u16 Ticks = 0
u16 TickAcc = 0
u16 TickLenNow = 0
u16 FracMulNow = 0
u16 Rs = 1
u16 W16 = 0
u16 Waited = 0
u16 Frames = 0
u32 RowA = 0
u32 RowB = 0
u32 W32 = 0
i16 Dx = 0
i16 Dy = 0
i16 Xs = 0
i16 Ys = 0
i16 Sy = 0
i16 Col = 0
i16 Ix = 0
i16 Iy = 0
i16 Dd = 0
' input: bits 4 left, 8 right, 16 button (the C64's meaning); Jn = new presses
u8 J1 = 0
u8 J2 = 0
u8 Jn = 0
u8 WasJ = 0
u8 Press = 0
u8 WasBtn = 0
' the computer's bird (1 player)
u8 AiWait = 0
u8 AiJoy = 0
u8 AiHold = 0
u8 AiSlow = 8
' scratch (never kept across a sub call)
u8 A = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 R1 = 0
u8 B0 = 0
u8 B1 = 0
u8 B2 = 0
u8 P0 = 0
u8 P1 = 0
u8 P2 = 0
u8 P3 = 0
u8 Ch = 0
u8 Ln = 0
u8 Crow = 0
u8 Sx = 0
u8 SyB = 0
u8 Mk = 0
u8 Sv = 0
u8 Cc = 0
u16 MaskIx = 0
u16 MaskBase = 0
u16 RowBase = 0
u8 ColOk[4]
u8 ColC[4]
u8 Parts[4]
u8 CellCh[4]

  tile screen
  mode 2 screen
  set sound table LpSoundTable areas 8
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  NextScr = Screen.Title

main_loop:
  dispatch NextScr using Screen
  goto main_loop

' ---------------------------------------------------------------------------
' random numbers (16-bit xorshift, stepped on every title frame): the
' computer's bird and the lava's random sequence seed

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' the game: one C64 tick (SYS 38238)

sub NewGame:
  B[0].X = XAlbino
  B[1].X = XPigment
  for Pd = 0 to 1
    B[Pd].Y = 120
    B[Pd].VY = 0
    B[Pd].VX = 0
    B[Pd].Fl = 0
    B[Pd].Joy = 0
    B[Pd].Hit = 0
    B[Pd].DX = B[Pd].X
    B[Pd].PX = B[Pd].X
    B[Pd].PY = 120
  next
  ' facings: albino right (0), pigmented left (2; the C64 had 3: bug 3)
  B[0].Off = 0
  B[1].Off = 2
  B[0].Ptr = 224
  B[1].Ptr = 226
  Wn = 20
  Over = 0
  Points = 0
  Ticks = 0
  TickAcc = 0
  ' LEAD 5 / 10 / 20: the marker moves 4 / 2 / 1 steps a point
  select case Lead
  case 0
    StepPt = 4
  case 1
    StepPt = 2
  case else
    StepPt = 1
  end select
  ' the lava row (C64 row 23) and its bubbles ($9518-$951D), the random
  ' byte ($8F) from the title's generator
  copy LavaRow0 count 40 to LavaRow
  Bi = 0
  for Pd = 0 to 4
    Bc[Pd] = Pd + 1
  next
  Z = lowbyte Rs
  AiWait = 20
  AiJoy = 0
  AiHold = 0
  return
end sub

sub GameTick:
  inc Ticks
  for Pl = 0 to 1
    PlayerTick
  next
  return
end sub

' $95B3 for bird Pl
sub PlayerTick:
  Bubbles
  with B[Pl] as Q
    J = Q.Joy
    if Q.Y < YCeil then
      Q.VY = 3
      play sound SndBump
    elseif Q.Y >= YLava then
      Point
    end if
    ' stick: the speed changes by 1 a tick, the facing follows
    C = 1
    T = J & 12
    select case T
    case 4
      Q.VX -= 1
      Q.Off = 2
    case 8
      Q.VX += 1
      Q.Off = 0
    case 12
      C = 0
    end select
    ' button: one flap (speed - 6) per press; the frame ($07F9 / $07FB)
    T = J & 16
    if T > 0 then
      if Q.Fl <> 0 then
        C = 0
        if Q.VY >= 6 then C = 1
        Q.VY -= 6
        Q.Fl = 0
        play sound SndFlap
      end if
      Q.Ptr = 224 + Q.Off
      Q.Ptr += C
    else
      if Q.Fl = 0 then Q.Fl = 255
      Q.Ptr = 223 + Q.Off
      Q.Ptr += C
    end if
    if Q.Ptr < 224 then Q.Ptr = 224
    if Q.Ptr > 227 then Q.Ptr = 227
  end with
  ' the albino's turn reads the birds' collision ($D01E)
  if Pl = 0 then
    if Ss > 0 then Point
  end if
  with B[Pl] as Q
    T = 2
    if Pl = 1 then T = 8
    T = T & Sb
    if T > 0 then
      Q.VY = 252
      play sound SndBump
    end if
    ' gravity, then Y + VY (bug 2 fixed: no wrap past the top)
    Q.VY += 1
    if Q.VY >= 128 then
      V = 0 - Q.VY
      if Q.Y < V then
        Q.Y = 0
      else
        Q.Y -= V
      end if
    else
      Q.Y += Q.VY
    end if
    ' VX clamped to -16..16; moving left is one slower (SEC before ADC)
    V = Q.VX
    if V >= 128 then
      if V < 240 then V = 240
      Q.VX = V
      W16 = 256 - V
      W16 -= 1
      Q.X -= W16
    else
      if V > 16 then V = 16
      Q.VX = V
      Q.X += V
    end if
    Q.X = Q.X & 511
    Q.DX = Q.X
  end with
  return
end sub

' $9725: a point. The lower bird loses (the albino on equal Y), starts again
' at the top; the meter moves
sub Point:
  inc Points
  play sound SndFallP
  play sound SndFallN
  if B[0].Y >= B[1].Y then
    Wn += StepPt
    B[0].Y = 0
    B[0].VY = 0
    B[0].VX = 0
    B[0].X = XAlbino
    B[0].Hit = 1
  else
    if Wn > StepPt then
      Wn -= StepPt
    else
      Wn = 0
    end if
    B[1].Y = 0
    B[1].VY = 0
    B[1].VX = 0
    B[1].X = XPigment
    B[1].Hit = 1
  end if
  if Wn >= 40 then
    Wn = 40
    Over = 2
  end if
  if Wn = 0 then Over = 1
  return
end sub

' $95B3's first part: one lava bubble rises a step (row 23); a finished
' bubble moves to a new column picked by the C64's sequence Z = Z x 5 + 1
' (columns 0-11 and 28-39)
sub Bubbles:
  inc Bi
  if Bi >= 5 then Bi = 0
  K = Bc[Bi]
  A = LavaRow[K]
  if A = $DA then
    do
      Z = Z * 5
      Z += 1
      V = 0
      if Z >= 40 then V = 1
      if Z >= 12 then
        if Z < 28 then V = 1
      end if
    loop while V = 1
    K = Z
    Bc[Bi] = Z
    A = $CF
  end if
  inc A
  LavaRow[K] = A
  C = LavaCell[K]
  if C > 0 then put char LavaBase + A - 208 at C,21
  return
end sub

' the C64's collision registers at the start of a tick, from the pixels it
' drew: Ss = the birds touch ($D01E), Sb bit 2 / 8 = a bird touches a ledge,
' the lava or a bubble ($D01F); C64 sprite masks and characters
sub Collide:
  Ss = 0
  Sb = 0
  W16 = B[1].DX
  Dx = W16
  W16 = B[0].DX
  Dx -= W16
  Dy = B[1].Y
  Ys = B[0].Y
  Dy -= Ys
  if abs(Dx) < 24 then
    if abs(Dy) < 21 then BirdsTouch
  end if
  for Pb = 0 to 1
    BirdOnLedge
  next
  return
end sub

' $D01E: bird 1 is Dx, Dy pixels from bird 0. The bird further left is
' read unshifted, the other pre-shifted by (distance & 7) pixels and placed
' (distance / 8) bytes further right; any common pixel is a touch
sub BirdsTouch:
  u8 Ra = 0
  u8 Rb = 20
  u8 Fa = 0
  u8 Fb = 0
  u8 Sh = 0
  u8 Qb = 0
  u8 Ia = 0
  u8 Ib = 0
  u8 Ir = 0
  u16 Ma = 0
  u16 Mb = 0
  if Dx >= 0 then
    Fa = B[0].Ptr - 224
    Fb = B[1].Ptr - 224
    Sh = lowbyte Dx
  else
    Fa = B[1].Ptr - 224
    Fb = B[0].Ptr - 224
    Sh = 0 - lowbyte Dx
  end if
  Qb = Sh >> 3
  Sh = Sh & 7
  ' rows of bird 0 (Ri) and bird 1 (R1 = Ri - Dy) that overlap
  if Dy > 0 then Ra = Dy
  if Dy < 0 then
    Sy = 20 + Dy
    Rb = Sy
  end if
  Fa = Fa << 3
  Fb = Fb << 3
  Fb += Sh
  for Ri = Ra to Rb
    Sy = Ri
    Sy -= Dy
    R1 = Sy
    ' Ia / Ib: the rows of the left / right bird
    if Dx >= 0 then
      Ia = Ri
      Ib = R1
    else
      Ia = R1
      Ib = Ri
    end if
    W16 = Fa * 21
    W16 += Ia
    Ma = W16 << 2
    W16 = Fb * 21
    W16 += Ib
    Mb = W16 << 2
    for Ir = Qb to 2
      T = ShMask[Ma + Ir]
      V = Ir - Qb
      W16 = Mb + V
      V = ShMask[W16]
      T = T & V
      if T > 0 then Ss = 1
    next
    if Ss > 0 then exit for
  next
  return
end sub

' $D01F for bird Pb: its sprite rows against the background character
' pixels under it. Only the (at most 4 x 4) character cells under the bird
' that hold a ledge, the floor or the lava are looked at, pixel line by line.
sub BirdOnLedge:
  u8 Fa = 0
  u8 Kb = 0
  u8 Mb = 2
  u8 Any = 0
  u8 Yb = 0
  u8 CrA = 0
  u8 CrB = 0
  u8 Cr = 0
  u8 Lt = 0
  u8 Ra = 0
  if Pb = 1 then Mb = 8
  Yb = B[Pb].Y
  ' the C64 text screen starts at sprite Y 50 and ends at 249
  if Yb >= 250 then exit sub
  W16 = B[Pb].DX
  Xs = W16
  Xs -= 24
  Kb = lowbyte Xs
  Kb = Kb & 7
  Col = Xs >> 3
  for Ci = 0 to 3
    Dd = Col + Ci
    ColOk[Ci] = 0
    if Dd >= 0 then
      if Dd <= 39 then
        ColOk[Ci] = 1
        ColC[Ci] = lowbyte Dd
        Any = 1
      end if
    end if
  next
  if Any = 0 then exit sub
  ' character rows under sprite rows 0-20
  CrA = 0
  if Yb >= 50 then
    T = Yb - 50
    CrA = T >> 3
  end if
  W16 = Yb + 20
  if W16 < 50 then exit sub
  W16 -= 50
  if W16 > 199 then W16 = 199
  T = lowbyte W16
  CrB = T >> 3
  Fa = B[Pb].Ptr - 224
  Fa = Fa << 3
  Fa += Kb
  W16 = Fa * 21
  MaskBase = W16 << 2
  for Cr = CrA to CrB
    if RowHas[Cr] > 0 then
      ' any non-blank cell under the bird in this row?
      Any = 0
      RowBase = RowOff[Cr]
      for Ci = 0 to 3
        CellCh[Ci] = 28
        if ColOk[Ci] > 0 then
          Cc = ColC[Ci]
          if Cr = 23 then
            Ch = LavaRow[Cc] - 192
          else
            W16 = RowBase + Cc
            Ch = FieldChr[W16]
          end if
          CellCh[Ci] = Ch
          if Ch <> 28 then Any = 1
        end if
      next
      if Any > 0 then
        ' the pixel lines of this character row that the sprite covers
        Lt = Cr << 3
        for Ln = 0 to 7
          W16 = Lt + Ln
          W16 += 50
          if W16 >= Yb then
            W16 -= Yb
            if W16 <= 20 then
              Ra = lowbyte W16
              MaskIx = Ra << 2
              MaskIx += MaskBase
              for Ci = 0 to 3
                Ch = CellCh[Ci]
                if Ch <> 28 then
                  W16 = ChrOff[Ch]
                  W16 += Ln
                  T = ChrPat[W16]
                  if T > 0 then
                    W16 = MaskIx + Ci
                    V = ShMask[W16]
                    T = T & V
                    if T > 0 then Sb = Sb | Mb
                  end if
                end if
              next
              T = Sb & Mb
              if T > 0 then exit sub
            end if
          end if
        next
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the computer's bird (1 player): it sees only the two birds' positions,
' decides every 10-17 frames: climb above the albino and drop on it, keep
' out of the lava, steer the short way round
sub AiThink:
  u8 Me = 0
  u8 Op = 0
  u8 AiFl = 0
  u8 Want = 0
  u8 Vx = 0
  if AiWait > 0 then
    dec AiWait
  else
    Rand
    T = lowbyte Rs
    AiWait = T & 7
    AiWait += AiSlow
    Me = B[1].Y
    Op = B[0].Y
    AiFl = 0
    ' height: about 20 pixels above the albino, never low over the lava
    V = Op
    if V >= 26 then V -= 26
    if Me > V then AiFl = 1
    if Me > 165 then AiFl = 1
    if Me < 60 then AiFl = 0
    ' some flaps missed (a person is not perfect)
    T = highbyte Rs
    T = T & 3
    if T = 0 then AiFl = 0
    ' right over the albino: stop flapping and drop onto it
    W16 = B[0].X
    W16 -= B[1].X
    W16 += 20
    W16 = W16 & 511
    if W16 < 40 then
      if Me < Op then
        if Me <= 165 then AiFl = 0
      end if
    end if
    if AiFl = 1 then AiHold = 1
    ' where to go: onto the albino when clearly above it, away when below
    ' and close (the short way round the 512 wrap)
    W16 = B[0].X
    W16 -= B[1].X
    ' far above: aim beside it (a ledge may be in between), the side by time
    T = Op - Me
    if Me < Op then
      if T > 40 then
        T = highbyte Rs
        if T >= 128 then
          W16 += 72
        else
          W16 -= 72
        end if
      end if
    end if
    W16 = W16 & 511
    Want = 0
    T = Me + 8
    if T < Op then
      if W16 < 256 then
        Want = 8
      else
        Want = 4
      end if
    else
      if W16 < 48 then Want = 4
      if W16 > 464 then Want = 8
    end if
    ' steer: its own speed towards about 4 pixels a tick that way, else brake
    Vx = B[1].VX
    AiJoy = 0
    select case Want
    case 8
      if Vx >= 128 then
        AiJoy = 8
      elseif Vx < 4 then
        AiJoy = 8
      end if
    case 4
      if Vx < 128 then
        AiJoy = 4
      elseif Vx > 252 then
        AiJoy = 4
      end if
    case else
      if Vx >= 128 then
        if Vx < 254 then AiJoy = 8
      elseif Vx > 1 then
        AiJoy = 4
      end if
    end select
  end if
  ' the button: press 4 frames, release 4 (a flap needs a release)
  if AiHold > 0 then
    inc AiHold
    if AiHold < 6 then
      AiJoy = AiJoy | 16
    else
      AiJoy = AiJoy & 12
      if AiHold > 10 then AiHold = 0
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' a game: the field, the loop (ticks at the C64's rate), the end

sub PlayGame:
  NewGame
  DrawField
  State = StPlay
  DrawBirds
  Collide
  ShowScreen
  WasBtn = 16
play_loop:
  Frame1
  ReadPad
  if Players = 1 then
    AiThink
    J2 = AiJoy
  end if
  ' the C64 waited FOR DE=0 TO 2*(19-ABS(WN-20)) between ticks: frames per
  ' tick measured on the C64 = 2.163 + 0.0588 x that count (TickLen, in
  ' 1/32 frames)
  V = Wn
  if V > 20 then
    V -= 20
  else
    V = 20 - V
  end if
  if V > 19 then V = 19
  V = 19 - V
  V = V << 1
  TickLenNow = TickLen[V]
  FracMulNow = FracMul[V]
  ' every vertical blank counts (catch-up when a pass ran long)
  TickAcc += Elapsed << 5
  if NeedCol > 0 then
    ' the collision registers for the next tick, from the positions drawn
    ' (they do not change until that tick)
    Collide
    NeedCol = 0
  elseif TickAcc >= TickLenNow then
    TickAcc -= TickLenNow
    for Pd = 0 to 1
      B[Pd].PX = B[Pd].DX
      B[Pd].PY = B[Pd].Y
      B[Pd].Hit = 0
    next
    B[0].Joy = J1
    B[1].Joy = J2
    GameTick
    DrawMeter
    NeedCol = 1
  end if
  DrawBirds
  if Over = 0 then goto play_loop
  ' the end: the original's message
  State = StEnding
  Victory
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  NextScr = Screen.Title
  return
end sub

' the birds drawn between ticks: position = previous + (current - previous)
' x the part of the tick gone, Fr/256 (not across a restart or the wrap)
sub DrawBirds:
  W16 = TickAcc * FracMulNow
  Fr = highbyte W16
  for Pd = 0 to 1
    with B[Pd] as Q
      W16 = Q.DX
      Ix = W16
      Iy = Q.Y
      if Q.Hit = 0 then
        W16 = Q.PX
        Dd = Ix - W16
        if abs(Dd) < 40 then
          Ix = W16
          if Dd >= 0 then
            W16 = Dd
            W16 *= Fr
            T = highbyte W16
            Ix += T
          else
            W16 = 0 - Dd
            W16 *= Fr
            T = highbyte W16
            Ix -= T
          end if
        end if
        Dd = Q.PY
        Dd = Iy - Dd
        if abs(Dd) < 40 then
          Iy = Q.PY
          if Dd >= 0 then
            W16 = Dd
            W16 *= Fr
            T = highbyte W16
            Iy += T
          else
            W16 = 0 - Dd
            W16 *= Fr
            T = highbyte W16
            Iy -= T
          end if
        end if
      end if
      ' frame: detail and body patterns
      T = Q.Ptr - 224
      T = T << 3
    end with
    C = Pd << 1
    ' hidden where the C64's border hid more than half the bird
    V = 1
    if Ix < 12 then V = 0
    if Ix > 331 then V = 0
    if Iy < 40 then V = 0
    if V = 0 then
      set sprite C to HideY,0,SBlank,0
      inc C
      set sprite C to HideY,0,SBlank,0
    else
      ' x = 16 + (X - 24) x 178/256, y = 8 + (Y - 50) x 225/256 (+1: the
      ' sprite's feet on the ledge line), held inside columns 2-29 / rows 1-22
      Ix -= 24
      if Ix < 0 then Ix = 0
      W16 = Ix
      W16 *= 178
      Sx = highbyte W16
      Sx += 16
      if Sx > 223 then Sx = 223
      Iy -= 50
      if Iy < 0 then Iy = 0
      W16 = Iy
      W16 *= 225
      SyB = highbyte W16
      SyB += 9
      if Pd = 0 then
        set sprite C to SyB,Sx,T,9
        inc C
        T += 4
        set sprite C to SyB,Sx,T,15
      else
        set sprite C to SyB,Sx,T,6
        inc C
        T += 4
        set sprite C to SyB,Sx,T,10
      end if
    end if
  next
  update sprites
  return
end sub

' the meter: a white marker over column Wn of the bottom row (C64 row 24)
sub DrawMeter:
  W16 = Wn * 89
  W16 = W16 >> 4
  W16 += 16
  Mk = lowbyte W16
  if Wn >= 40 then Mk = 233
  set sprite 4 to 175,Mk,SMark,15
  return
end sub

sub DrawField:
  NewScreen
  decompress zx0 FP0 to vram.pattern
  decompress zx0 FC0 to vram.color
  decompress zx0 FP1 to vram.pattern + 2048
  decompress zx0 FC1 to vram.color + 2048
  decompress zx0 FP2 to vram.pattern + 4096
  decompress zx0 FC2 to vram.color + 4096
  decompress zx0 FN0 to vram.name
  decompress zx0 FN1 to vram.name + 256
  decompress zx0 FN2 to vram.name + 512
  ' the lava row as the C64 starts it
  for K = 0 to 39
    C = LavaCell[K]
    A = LavaRow[K]
    if C > 0 then put char LavaBase + A - 208 at C,21
  next
  DrawMeter
  return
end sub

sub Victory:
  HideSprites
  NewScreen
  play sound SndWin
  if Over = 1 then
    print at 7,7, "THE ALBINO VADRAK"
    print at 8,9, "IS THE VICTOR!"
    set sprite 0 to 87,120,SDRU,9
    set sprite 1 to 87,120,SBRU,15
  else
    print at 6,7, "THE PIGMENTED VADRAK"
    print at 8,9, "IS VICTORIOUS!"
    set sprite 0 to 87,120,SDLU,6
    set sprite 1 to 87,120,SBLU,10
  end if
  update sprites
  if Players = 1 then
    if Over = 1 then
      print at 10,15, "YOU WIN!"
    else
      print at 6,15, "THE COLECOVISION WINS"
    end if
  end if
  print at 8,19, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  V = frame
  Elapsed = V - LastVb
  LastVb = V
  if Elapsed = 0 then Elapsed = 1
  if Elapsed > 3 then Elapsed = 3
  Frames += Elapsed
  return
end sub

' controller 1 -> J1, controller 2 -> J2 (4 left, 8 right, 16 a button);
' Jn = directions newly pressed (1 up 2 down 4 left 8 right, either
' controller), Press = a button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).action then J1 = J1 | 16
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).action then J2 = J2 | 16
  V = J1 | J2
  V = V & 12
  if joypad(1).up then V = V | 1
  if joypad(2).up then V = V | 1
  if joypad(1).down then V = V | 2
  if joypad(2).down then V = V | 2
  K = WasJ ^ 15
  Jn = V & K
  WasJ = V
  T = J1 | J2
  T = T & 16
  Press = 0
  if T > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = T
  return
end sub

' clear sprites zeroes every entry (Y=0 is on screen): count again, park
sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to HideY,0,SBlank,0
  next
  update sprites
  return
end sub

' a text screen: the font in every third, white on black, the UI tiles at 128+
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  load default ascii
  duplicate mode 2 patterns
  fill $F1 count 1024 to vram.color
  fill $F1 count 1024 to vram.color + 2048
  fill $F1 count 1024 to vram.color + 4096
  copy UiPat count UiBytes to vram.pattern + 1024
  copy UiCol count UiBytes to vram.color + 1024
  copy UiPat count UiBytes to vram.pattern + 3072
  copy UiCol count UiBytes to vram.color + 3072
  copy UiPat count UiBytes to vram.pattern + 5120
  copy UiCol count UiBytes to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  display on
  return
end sub

' the title: logo, the C64's loading strip, author, menu (cursor on START),
' the tune once
sub TitlePage:
  NewScreen
  State = StTitle
  decompress zx0 LogoP to vram.pattern + 1352
  decompress zx0 LogoC to vram.color + 1352
  put LogoN frame size LogoW,LogoH at 4,2
  print at 7,7, "BY SCOTT PETERSON"
  for K = 0 to 20
    C = K + 5
    put char TJoust0 + K at C,9
  next
  print at 11,12, "START"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  Menu = 0
  ShowOptions
  ShowMenu
  ' the two Vadraks either side of the logo
  set sprite 0 to 19,24,SDRU,9
  set sprite 1 to 19,24,SBRU,15
  set sprite 2 to 19,216,SDLU,6
  set sprite 3 to 19,216,SBLU,10
  update sprites
  ShowScreen
  play song LpTitleSong once
  WasBtn = 16
  Waited = 0
tp_loop:
  Frame1
  Rand
  ReadPad
  ' wings: the birds flap at 1.5 Hz (20 frames a picture)
  inc Waited
  V = lowbyte Waited
  V = V & 31
  if V = 0 then
    set sprite 0 pattern to SDRU
    set sprite 1 pattern to SBRU
    set sprite 2 pattern to SDLU
    set sprite 3 pattern to SBLU
    update sprites
  elseif V = 16 then
    set sprite 0 pattern to SDRD
    set sprite 1 pattern to SBRD
    set sprite 2 pattern to SDLD
    set sprite 3 pattern to SBLD
    update sprites
  end if
  K = Jn & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  ' left/right (or the button) on PLAYERS / LEAD changes the value
  K = Jn & 12
  if Press > 0 then
    if Menu = 1 then K = 8
    if Menu = 2 then K = 8
  end if
  if K > 0 then
    if Menu = 1 then
      Players = 3 - Players
      play sound SndClick
      ShowOptions
    elseif Menu = 2 then
      if K = 4 then
        if Lead = 0 then
          Lead = 2
        else
          dec Lead
        end if
      else
        inc Lead
        if Lead > 2 then Lead = 0
      end if
      play sound SndClick
      ShowOptions
    end if
    Press = 0
  end if
  if Press = 0 then goto tp_loop
  stop song
  mute all
  W16 = Frames
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  select case Menu
  case 0
    NextScr = Screen.Play
  case 3
    NextScr = Screen.How
  case else
    NextScr = Screen.Credits
  end select
  return
end sub

sub ShowOptions:
  if Players = 1 then
    print at 11,14, "PLAYERS: 1"
  else
    print at 11,14, "PLAYERS: 2"
  end if
  select case Lead
  case 0
    print at 11,16, "LEAD:  5 "
  case 1
    print at 11,16, "LEAD: 10 "
  case else
    print at 11,16, "LEAD: 20 "
  end select
  return
end sub

sub ShowMenu:
  for J = 0 to 4
    C = J << 1
    C += 12
    put char 32 at 9,C
  next
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  State = StCredits
  print at 11,2, "LAVA PIT"
  print at 3,4, "A DUEL BY SCOTT PETERSON"
  print at 3,6, "FOR THE COMMODORE 64, FROM"
  print at 3,8, "RUN MAGAZINE'S RERUN"
  print at 3,10, "GAME PAK DISK."
  print at 3,13, "COLECOVISION VERSION BY"
  print at 3,15, "CLAUDE (ANTHROPIC) IN AMY,"
  print at 3,17, "AMY BIENVENU'S LANGUAGE."
  print at 3,19, "MUSIC: MAGMA JOUST (NEW)"
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  NextScr = Screen.Title
  return
end sub

' HOW TO PLAY: two pages with pictures from the game's own tiles and sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 3,3, "TWO VADRAKS DUEL OVER A"
  print at 3,5, "PIT OF LAVA. TOUCH YOUR"
  print at 3,7, "RIVAL FROM ABOVE: THE"
  print at 3,9, "LOWER BIRD LOSES A POINT."
  ' the picture: the albino diving onto the pigmented on a ledge
  put char TLedgeT0 at 12,14
  put char TLedgeT1 at 13,14
  put char TLedgeT2 at 14,14
  put char TLedgeT1 at 15,14
  put char TLedgeT1 at 16,14
  put char TLedgeT2 at 17,14
  put char TLedgeB0 at 13,15
  put char TLedgeB1 at 14,15
  put char TLedgeB2 at 15,15
  put char TLedgeB1 at 16,15
  set sprite 0 to 80,112,SDRD,9
  set sprite 1 to 80,112,SBRD,15
  set sprite 2 to 95,120,SDLU,6
  set sprite 3 to 95,120,SBLU,10
  update sprites
  print at 3,17, "A BIRD IN THE LAVA LOSES"
  print at 3,19, "A POINT TOO."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 3,3, "BUTTON: FLAP THE WINGS"
    print at 3,5, "(PRESS AGAIN FOR EACH"
    print at 3,7, "FLAP). STICK: STEER."
    ' the meter: lava, rock and the marker
    for K = 4 to 27
      T = TLavaRow
      if K >= 13 then
        if K <= 18 then T = TRockRow
      end if
      put char T at K,10
    next
    set sprite 4 to 79,116,SMark,15
    update sprites
    print at 3,12, "EACH POINT MOVES THE"
    print at 3,14, "MARKER: TO THE LEFT END"
    print at 3,16, "THE ALBINO WINS, TO THE"
    print at 3,18, "RIGHT THE PIGMENTED."
    print at 3,20, "TIP: STAY ABOVE YOUR RIVAL"
    print at 8,22, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  NextScr = Screen.Title
  return
end sub

