record Shell:
  u8 Live
  u8 T
  u8 F
  u8 Y
end record

Shell Sh

u16 TzLeft = 0
u16 Rs = 1
u8 CruY = 40
u8 TzOn = 0
u16 W16 = 0
u16 NumU = 0
u16 View = 0
u16 PWX = 0
u16 PYf = 0
u16 PSpd = 21
u16 BmWX = 0
u16 Sx16 = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the raider: screen x, centre y, visible, direction (1 right, 2 left),
' turn frames left, the direction after the turn, turn counter, state
' (0 flying, 1 falling, 2 counting the gauges), falling frames
u8 PSX = 0
u8 PY = 0
u8 PVis = 0
u8 PDir = 1
u8 PTurn = 0
u8 PNext = 1
u8 PE = 0
u8 PState = 0
u8 FallT = 0
' the bomb: on, frames, start y, screen x and y
u8 BmOn = 0
u8 BmT = 0
u8 BmY0 = 0
u8 BSX = 0
u8 BSY = 0
u8 BVis = 0
' the blast where a bomb lands (frames, screen x)
u8 BlastT = 0
u16 BlastWX = 0
' the gun
u8 Aim = 52
u8 Pose = 0
u8 PanC = 0
u8 Temp = 1
u8 Dmg = 1
u8 TimeL = 32
u8 TimeC = 0
u8 CoolC = 0
u8 Kills = 0
u8 Over = 0
u8 Why = 0
u8 Shots = 0
u8 Hits = 0
u8 Bombs = 0
u8 BombsShot = 0
u8 HzDirty = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Gi = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawAll
  if Over = 0 then goto play_loop

  ' the end: why, the score, then back to the title on a press
  print at 7,4, "                  "
  print at 7,5, "     GAME OVER    "
  select case Why
    case 1
      print at 7,6, "  GUN OVERHEATED  "
    case 2
      print at 7,6, " OUTPOST DESTROYED"
    case else
      print at 7,6, "   OUT OF TIME    "
  end select
  print at 7,7, "                  "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  TurnGun
  if PState = 0 then
    Trigger
    Clocks
  end if
  select case PState
    case 0
      FlyRaider
    case 1
      FallRaider
    case 2
      Tally
  end select
  ShellStep
  BombStep
  if BlastT > 0 then dec BlastT
  return
end sub

' left / right turn the horizon a column every 3 frames; up / down move the
' burst height a pixel a frame
sub TurnGun:
  if PanC > 0 then dec PanC
  K = J1 & 12
  if PanC = 0 then
    if K = 4 then
      View = View - 1
      View = View & 255
      PanC = 3
      HzDirty = 1
    end if
    if K = 8 then
      View = View + 1
      View = View & 255
      PanC = 3
      HzDirty = 1
    end if
  end if
  K = J1 & 3
  if K = 1 then
    if Aim > AimMin then dec Aim
  end if
  if K = 2 then
    if Aim < AimMax then inc Aim
  end if
  Pose = (Aim - AimMin) / 14
  if Pose > 5 then Pose = 5
  return
end sub

' the button fires when no shell is in the air (held, it keeps firing)
sub Trigger:
  if Sh.Live = 1 then return
  if Btn = 0 then return
  Sh.Live = 1
  Sh.T = 0
  V = 108 - Aim
  Sh.F = V / 16 + 12
  Sh.Y = 108
  inc Shots
  play sound SndShot
  inc Temp
  if Temp >= GaugeTop then
    Temp = GaugeTop
    Over = 1
    Why = 1
  end if
  return
end sub

' TIME runs down; an idle gun with the button up cools
sub Clocks:
  inc TimeC
  if TimeC >= TimeRate then
    TimeC = 0
    dec TimeL
    if TimeL = 0 then
      Over = 1
      Why = 3
    end if
  end if
  if Sh.Live = 0 then
    if Btn = 0 then
      inc CoolC
      if CoolC >= CoolRate then
        CoolC = 0
        if Temp > 1 then dec Temp
      end if
    end if
  end if
  return
end sub

' the raider's screen x from its place on the horizon (2048 pixels round)
function ScreenX(u16 Wx) as u16
  u16 Vx = View << 3
  return (Wx - Vx) & 2047

function RaiderSpeed(u8 N) as u16
  if N >= 11 then return 30
  u16 Dv = 180 - N * 5
  return 3780 / Dv

sub FlyRaider:
  ' it shies away from the sight when it comes near, else it makes for its
  ' cruising height
  if Near(PY, Aim, 20) = 1 then
    if PY > Aim + Shy then
      PYf = PYf + 6
      if PYf > PyMax then PYf = PyMax
    else
      PYf = PYf - 6
      if PYf < PyMin then PYf = PyMin
    end if
  elseif PY < CruY then
    PYf = PYf + 6
  elseif PY > CruY then
    PYf = PYf - 6
  end if
  PY = PYf >> 4
  if PTurn > 0 then
    dec PTurn
    if PTurn = 0 then PDir = PNext
  else
    if PDir = 1 then
      PWX = PWX + PSpd
    else
      PWX = PWX - PSpd
    end if
    PWX = PWX & 32767
  end if
  W16 = PWX >> 4
  Sx16 = ScreenX(W16)
  if Sx16 < 241 then
    PVis = 1
    PSX = Sx16
    if PTurn = 0 then RaiderTurns
  else
    ' out of view: back towards the middle of the view the short way
    PVis = 0
    PTurn = 0
    W16 = Sx16 - 128
    W16 = W16 & 2047
    if W16 < 1024 then
      PDir = 2
    else
      PDir = 1
    end if
  end if
  return
end sub

' the turn counter: in the middle of the view a turn and a bomb at 110, at
' the sides a turn back at 135
sub RaiderTurns:
  inc PE
  if PE >= 140 then PE = 0
  X = PSX + 8
  if X >= 104 then
    if X <= 152 then
      inc PE
      K = PE - 110
      if K < 2 then
        TurnRound
        DropBomb
      end if
      return
    end if
  end if
  if PE <> 135 then return
  if X < 104 then
    if PDir = 2 then TurnRound
  end if
  if X > 186 then
    if PDir = 1 then TurnRound
  end if
  return
end sub

sub TurnRound:
  PNext = 3 - PDir
  PTurn = 22
  Rand
  CruY = Rs & 63
  CruY = CruY + 16
  return
end sub

' 16-bit xorshift
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub DropBomb:
  if BmOn = 1 then return
  BmOn = 1
  BmT = 0
  BmWX = PWX >> 4
  BmY0 = PY + 4
  inc Bombs
  play sound SndWhistle
  return
end sub

' shot down: it burns and falls
sub FallRaider:
  PYf = PYf + 16
  PY = PYf >> 4
  W16 = PWX >> 4
  Sx16 = ScreenX(W16)
  PVis = 0
  if Sx16 < 241 then
    PVis = 1
    PSX = Sx16
  end if
  dec FallT
  if FallT = 0 then PState = 2
  return
end sub

' the gauges counted into the score, a step a frame
sub Tally:
  if Dmg < GaugeTop then
    inc Dmg
  elseif TimeL > 0 then
    dec TimeL
  elseif Temp < GaugeTop then
    inc Temp
  else
    NextRaider
    return
  end if
  AddScore(1)
  V = Tick & 1
  if V = 0 then play sound SndTick
  return
end sub

sub AddScore(u8 N):
  if Score > 999800 then
    Score = 999999
  else
    Score += N
  end if
  if Score > Hi then Hi = Score
  print at 23,18, Score
  return
end sub

sub NextRaider:
  Temp = 1
  Dmg = 1
  TimeL = GaugeTop
  TimeC = 0
  CoolC = 0
  PState = 0
  PSpd = RaiderSpeed(Kills)
  ' it comes in from the far side of the horizon
  W16 = View << 3
  W16 = W16 + 640
  W16 = W16 & 2047
  PWX = W16 << 4
  PYf = 640
  PY = 40
  CruY = 40
  PE = 0
  PTurn = 0
  PVis = 0
  return
end sub

' the shell climbs and shrinks; it bursts at the aimed height and hits
' there for four frames
sub ShellStep:
  if Sh.Live = 0 then return
  inc Sh.T
  if Sh.T <= Sh.F then
    W16 = 108 - Aim
    W16 = W16 * Sh.T
    W16 = W16 / Sh.F
    V = W16
    Sh.Y = 108 - V
    return
  end if
  Sh.Y = Aim
  if PState = 0 then
    if PVis = 1 then
      if Near(PSX + 8, 128, 9) = 1 then
        if Near(PY, Aim, 6) = 1 then
          Kill
          return
        end if
      end if
    end if
  end if
  if BmOn = 1 then
    if BVis = 1 then
      if Near(BSX + 8, 128, 8) = 1 then
        if Near(BSY, Aim, 8) = 1 then
          BmOn = 0
          inc BombsShot
          play sound SndPop
          AddScore(10)
        end if
      end if
    end if
  end if
  K = Sh.F + 4
  if Sh.T >= K then Sh.Live = 0
  return
end sub

' 1 when A and B are at most D apart
function Near(u8 A, u8 B, u8 D) as u8
  u8 Df = 0
  if A >= B then
    Df = A - B
  else
    Df = B - A
  end if
  if Df <= D then return 1
  return 0

sub Kill:
  Sh.Live = 0
  PState = 1
  FallT = 48
  inc Kills
  inc Hits
  play sound SndDown
  AddScore(100)
  NumU = Kills
  print at 28,22, digits$(NumU, 2)
  return
end sub

' the bomb comes at the outpost, growing; it hits after 96 frames
sub BombStep:
  if BmOn = 0 then return
  inc BmT
  if BmT >= BombTime then
    BmOn = 0
    BlastT = 24
    BlastWX = BmWX
    play sound SndBoom
    Dmg = Dmg + 3
    if Dmg >= GaugeTop then
      Dmg = GaugeTop
      if PState = 0 then
        Over = 1
        Why = 2
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing: the horizon when it turned, the gauges, the radar arrows, the
' sprites. 0-1 gun, 2 barrel, 3 sight, 4 shell, 5-6 raider, 7 bomb,
' 8-9 blast
sub DrawAll:
  if HzDirty = 1 then
    HzDirty = 0
    copy Pano + View count 32 to vram.name + 416
  end if
  for Gi = 0 to 2
    select case Gi
      case 0
        V = Temp
      case 1
        V = Dmg
      case else
        V = TimeL
    end select
    DrawGauge(GCol[Gi], GBase[Gi], V)
  next
  V = TSky3
  K = TSky3
  if PState = 0 then
    if PVis = 0 then
      if PDir = 1 then
        V = TArL
      else
        K = TArR
      end if
    end if
  end if
  put char V at 2,12
  put char K at 29,12
  DrawSprites
  return
end sub

sub DrawGauge(u8 Gx, u8 Base, u8 Val):
  u8 Rw = 0
  u8 Lo = 0
  u8 Lv = 0
  u8 Tc = 0
  for Rw = 0 to 3
    Lo = (3 - Rw) * 8
    if Val <= Lo then
      Lv = 0
    else
      Lv = Val - Lo
      if Lv > 8 then Lv = 8
    end if
    Tc = Lv * 2 + Base
    put char Tc at Gx,Rw + 18
    put char Tc + 1 at Gx + 1,Rw + 18
  next
  return
end sub

sub DrawSprites:
  set sprite 0 to 111,120,SGund,1
  set sprite 1 to 111,120,SGunb,14
  K = Pose * 4 + SBar0
  set sprite 2 to 95,120,K,1
  set sprite 3 to Aim - 9,120,SSight,15
  if Sh.Live = 1 then
    if Sh.T <= Sh.F then
      K = Sh.T * 4
      K = K / Sh.F
      if K > 3 then K = 3
      K = K * 4 + SSh0
      set sprite 4 to Sh.Y - 9,120,K,11
    else
      K = Sh.T - Sh.F
      K = K >> 1
      K = K * 4 + SPf0
      set sprite 4 to Aim - 9,120,K,15
    end if
  else
    set sprite 4 to 192,0,0,0
  end if
  select case PState
    case 0
      if PVis = 1 then
        if PTurn > 0 then
          K = SPfd
        elseif PDir = 1 then
          K = SPrd
        else
          K = SPld
        end if
        set sprite 5 to PY - 9,PSX,K,1
        set sprite 6 to PY - 9,PSX,K + 4,14
      else
        set sprite 5 to 192,0,0,0
        set sprite 6 to 192,0,0,0
      end if
    case 1
      if PVis = 1 then
        K = FallT / 12
        K = K & 1
        K = K * 8 + SEx0i
        set sprite 5 to PY - 9,PSX,K,11
        set sprite 6 to PY - 9,PSX,K + 4,8
      else
        set sprite 5 to 192,0,0,0
        set sprite 6 to 192,0,0,0
      end if
    case else
      set sprite 5 to 192,0,0,0
      set sprite 6 to 192,0,0,0
  end select
  BVis = 0
  if BmOn = 1 then
    Sx16 = ScreenX(BmWX)
    if Sx16 < 241 then
      BVis = 1
      BSX = Sx16
      W16 = 100 - BmY0
      W16 = W16 * BmT
      W16 = W16 / BombTime
      V = W16
      BSY = BmY0 + V
      K = BmT / 24
      K = K * 4 + SBm0
      set sprite 7 to BSY - 9,BSX,K,1
    else
      set sprite 7 to 192,0,0,0
    end if
  else
    set sprite 7 to 192,0,0,0
  end if
  if BlastT > 0 then
    Sx16 = ScreenX(BlastWX)
    if Sx16 < 241 then
      X = Sx16
      K = SEx0i
      if BlastT < 14 then K = SEx1i
      set sprite 8 to 87,X,K,11
      set sprite 9 to 87,X,K + 4,8
    else
      set sprite 8 to 192,0,0,0
      set sprite 9 to 192,0,0,0
    end if
  else
    set sprite 8 to 192,0,0,0
    set sprite 9 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  View = 0
  copy Pano count 32 to vram.name + 416
  print at 3,17, "TEMP"
  print at 10,17, "DAMAGE"
  print at 18,17, "TIME"
  print at 23,17, "SCORE"
  print at 23,20, "BEST"
  print at 23,21, Hi
  print at 23,22, "DOWN 00"
  Score = 0
  print at 23,18, Score
  Kills = 0
  Over = 0
  Why = 0
  Shots = 0
  Hits = 0
  Bombs = 0
  BombsShot = 0
  Aim = 52
  PanC = 0
  Sh.Live = 0
  BmOn = 0
  BlastT = 0
  HzDirty = 0
  NextRaider
  DrawAll
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: DESERT FRONT in sandstone blocks over the sky and the horizon,
' the raider crossing, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 448 to vram.name + 32
  for J = 15 to 16
    fill TSand0 + J - 15 count 32 at 0,J
  next
  print at 7,18, "BY ALAN THOMASON"
  print at 13,20, "START"
  print at 13,21, "CREDITS"
  if Hi > 0 then
    print at 10,22, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  PSX = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Tick & 1
  if V = 0 then inc PSX
  set sprite 5 to 87,PSX,SPrd,1
  set sprite 6 to 87,PSX,SPrb,14
  update sprites
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 20
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "DESERT FRONT"
  print at 2,5, "BASED ON DESERT FRONT BY"
  print at 2,6, "ALAN THOMASON, AHOY!"
  print at 2,7, "NOVEMBER 1987 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: HEAT HAZE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

