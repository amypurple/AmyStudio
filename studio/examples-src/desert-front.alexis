  $80,$80,$80,$80,$CD,$80,$CD,$80,$CD,$CD,$80,$80,$CD,$CD,$CD,$80,$CD,$CD,$80,$80,$CD,$CD,$80,$80,$80,$CD,$80,$80,$80,$80,$80,$80
