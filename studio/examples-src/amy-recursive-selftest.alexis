project "Amy Recursive Test"
memory "colecovision_legacy_sdcc"

u16 Result = 0

  text screen
  print at 8,0, "RECURSIVE TEST"
  print at 1,5, "EXPECT 0015"
  screen on

  Result = SumDown(5)
  print Result at 13,5 digits 4

function SumDown(u8 N) as u16
  if N = 0 then return 0
  u8 Prev = N
  Prev -= 1
  u16 Rest = SumDown(Prev)
  Rest += N
  return Rest