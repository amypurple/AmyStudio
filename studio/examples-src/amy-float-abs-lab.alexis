' FP5 abs lab: inspect sign clearing on 5-byte floats.
i16 SNegOne = -1
i16 SNegTen = -10
i16 SZero = 0
u16 UHundred = 100
fp5 FNegOne = 0
fp5 FNegTen = 0
fp5 FZero = 0
fp5 FHundred = 0
u8 BNegOne[5] = 0
u8 BNegTen[5] = 0
u8 BZero[5] = 0
u8 BHundred[5] = 0

  text screen
  print at 10,0, "FP5 ABS LAB"
  print at 1,1, "RAW BYTES      B4  B3  B2  B1  B0"

  FNegOne = abs(SNegOne)
  FNegTen = abs(SNegTen)
  FZero = abs(SZero)
  FHundred = abs(UHundred)

  copy bytes of FNegOne to BNegOne
  copy bytes of FNegTen to BNegTen
  copy bytes of FZero to BZero
  copy bytes of FHundred to BHundred

  print at 1,4,  "abs -1"
  print BNegOne[4] at 11,4 digits 3
  print BNegOne[3] at 15,4 digits 3
  print BNegOne[2] at 19,4 digits 3
  print BNegOne[1] at 23,4 digits 3
  print BNegOne[0] at 27,4 digits 3

  print at 1,6,  "abs -10"
  print BNegTen[4] at 11,6 digits 3
  print BNegTen[3] at 15,6 digits 3
  print BNegTen[2] at 19,6 digits 3
  print BNegTen[1] at 23,6 digits 3
  print BNegTen[0] at 27,6 digits 3

  print at 1,8,  "abs 0"
  print BZero[4] at 11,8 digits 3
  print BZero[3] at 15,8 digits 3
  print BZero[2] at 19,8 digits 3
  print BZero[1] at 23,8 digits 3
  print BZero[0] at 27,8 digits 3

  print at 1,10, "abs 100"
  print BHundred[4] at 11,10 digits 3
  print BHundred[3] at 15,10 digits 3
  print BHundred[2] at 19,10 digits 3
  print BHundred[1] at 23,10 digits 3
  print BHundred[0] at 27,10 digits 3

  print at 1,13, "EXPECT"
  print at 1,14, "abs -1   = 129 000 000 000 000"
  print at 1,15, "abs -10  = 132 032 000 000 000"
  print at 1,16, "abs 0    = 000 000 000 000 000"
  print at 1,17, "abs 100  = 135 072 000 000 000"
  screen on