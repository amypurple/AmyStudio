record Body:
  u16 X
  u16 Y
  i16 Dx
  i16 Dy
end record
Body Pl[4]

u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Cv = 0
u16 SX = 0
u16 SY = 0
i16 SVx = 0
i16 SVy = 0
i16 Ti = 0
i16 Tj = 0
i16 Tk = 0
u16 Pool[3]
u8 TzOn = 0
' the four worlds
u8 Rp[4]
u8 Hb[4]
u8 Pd[4]
u8 Pn[4]
u8 Dl[4]
u8 Ef[4]
u8 Ht[4]
u8 Alive[33]
u8 LineBuf[32]
u8 Lv = 2
u8 Qf = 33
u8 Qs = 33
u8 FuelC = 0
u8 SupC = 0
u8 RefC = 0
u8 FuelT = 12
u8 SupT = 90
u8 Lock = 0
u8 Near = 0
u8 Match = 0
u8 LeaveC = 0
u8 Thr = 0
u8 Crew = 0
u8 Head = 0
u8 Worlds = 0
u8 NameIx = 0
u8 Sp = 0
u8 MsgT = 0
u8 Scr = 0
' landing
u8 Wp = 0
u8 Dg = 0
u8 Tr = 0
u8 Ft = 0
u8 Ty = 0
u8 Sel = 0
u8 NItems = 0
u8 Act = 0
u8 Leave = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Pc = 0
u8 NameEnd = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Li = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cr = 0

  tile screen
  set sound table GySoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title
  NewGame
  FamilyPage
  InstrPage
  NewSpace

space_loop:
  Frame1
  ReadPad
  SpaceStep
  DrawSpace
  if Press = 1 then
    if Lock > 0 then TryLand
  end if
  if Sp = 0 then goto space_loop

  EndPage
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: 16-bit xorshift; RndN(N) is 0 .. N-1
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RndN(u8 N) as u8
  u16 P = 0
  u8 R = 0
  Rand
  P = Rs & 255
  P = P * N
  R = P >> 8
  return R

' a roll below 3 out of N (the listing's I=N:GOSUB 50:IF I<3); N at least 1
function Risky(u8 N) as u8
  u8 R = 0
  if N < 1 then N = 1
  R = RndN(N)
  if R < 3 then return 1
  return 0

' ---------------------------------------------------------------------------
' a new world for slot I (lines 800-870)
sub Gen(u8 I):
  u8 G = 0
  u8 Q = 0
  i16 D = 0
  Rp[I] = 0
  Pd[I] = 0
  Q = I & 1
  if Q = 1 then
    G = RndN(100)
    if G > 88 then Rp[I] = 1
    if G > 96 then
      Rp[I] = 2
      Pd[I] = 10
    end if
  end if
  G = 0
  while G = 0
    Hb[I] = RndN(3)
    if Rp[I] = 2 then
      if Hb[I] = 0 then Hb[I] = 1
    end if
    D = RndN(6)
    D = D + 3 + Lv - Hb[I]
    if D < 1 then D = 1
    Dl[I] = D
    D = RndN(6)
    D = D + 6 - Lv - Hb[I]
    if D < 1 then D = 1
    Ef[I] = D
    Ht[I] = RndN(3) + 1
    if Rp[I] = 2 then
      G = 1
    else
      Q = Hb[I]
      if Pool[Q] > 0 then
        Pd[I] = PickType(Q)
        G = 1
      else
        if Pool[0] = 0 then
          if Pool[1] = 0 then
            if Pool[2] = 0 then FillPools
          end if
        end if
      end if
    end if
  end while
  Pn[I] = NameIx
  NameIx = NameIx + 7
  if NameIx >= 40 then NameIx = NameIx - 40
  ' the planet drifts in from the left or right edge of its lane
  G = RndN(2)
  Q = RndN(9) + 4
  D = Q
  if G = 0 then
    Pl[I].X = XMin
    Pl[I].Dx = D
  else
    Pl[I].X = XMax
    Pl[I].Dx = 0 - D
  end if
  W16 = LaneY[I]
  Pl[I].Y = W16 * 16
  D = RndN(7)
  Pl[I].Dy = D - 3
  return
end sub

sub FillPools:
  for Pi = 0 to 2
    Pool[Pi] = 1023
  next
  return
end sub

' picks one of the world types still in the pool of kind Q, and takes it out
function PickType(u8 Q) as u8
  u16 M = 0
  u16 B = 0
  u8 N = 0
  u8 T = 0
  u8 R = 0
  M = Pool[Q]
  B = 1
  for T = 0 to 9
    W16 = M & B
    if W16 > 0 then inc N
    B = B << 1
  next
  R = RndN(N)
  B = 1
  N = 255
  for T = 0 to 9
    W16 = M & B
    if W16 > 0 then
      if R = 0 then
        if N = 255 then N = T
      else
        dec R
      end if
    end if
    B = B << 1
  next
  B = 1
  for T = 1 to N
    B = B << 1
  next
  Pool[Q] = M ^ B
  return N

' ---------------------------------------------------------------------------
' one frame in space (the listing's action loop, lines 100-130)
sub SpaceStep:
  MovePlanets
  Thr = 0
  if Lock > 0 then
    Pi = Lock - 1
    ' leaving the orbit takes a push held for 10 frames
    K = J1 & 15
    if K > 0 then
      inc LeaveC
    else
      LeaveC = 0
    end if
    if LeaveC >= 10 then
      Lock = 0
      Match = 0
      LeaveC = 0
      MsgLine(0)
    else
      SX = Pl[Pi].X
      SY = Pl[Pi].Y
      SVx = Pl[Pi].Dx
      SVy = Pl[Pi].Dy
      Refill
    end if
  end if
  if Lock = 0 then
    MoveShip
    CheckOrbit
  end if
  ' fuel burns while thrusting, supplies with time
  if Thr = 1 then
    inc FuelC
    if FuelC >= FuelT then
      FuelC = 0
      if Qf > 0 then dec Qf
      DrawBar(21)
      if Qf = 0 then Sp = 3
    end if
    V = Tick & 7
    if V = 0 then play sound SndThrust
  end if
  inc SupC
  if SupC >= SupT then
    SupC = 0
    if Qs > 0 then dec Qs
    DrawBar(22)
    if Qs = 0 then Sp = 4
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then MsgLine(0)
  end if
  return
end sub

' the ship: thrust 2/16 pixel a frame per axis, drag of 1/16 of the speed
' (rounded up), walls stop it
sub MoveShip:
  if Qf > 0 then
    V = J1 & 1
    if V > 0 then
      SVy = SVy - 2
      Thr = 1
    end if
    V = J1 & 2
    if V > 0 then
      SVy = SVy + 2
      Thr = 1
    end if
    V = J1 & 4
    if V > 0 then
      SVx = SVx - 2
      Thr = 1
    end if
    V = J1 & 8
    if V > 0 then
      SVx = SVx + 2
      Thr = 1
    end if
  end if
  SVx = Drag(SVx)
  SVy = Drag(SVy)
  Ti = SX
  Ti = Ti + SVx
  if Ti < XMin then
    Ti = XMin
    SVx = 0
  end if
  if Ti > XMax then
    Ti = XMax
    SVx = 0
  end if
  SX = Ti
  Ti = SY
  Ti = Ti + SVy
  if Ti < YMin then
    Ti = YMin
    SVy = 0
  end if
  if Ti > YMax then
    Ti = YMax
    SVy = 0
  end if
  SY = Ti
  return
end sub

function Drag(i16 Vv) as i16
  i16 D = 0
  if Vv > 0 then
    D = Vv + 15
    D = D >> 4
    Vv = Vv - D
  end if
  if Vv < 0 then
    D = 15 - Vv
    D = D >> 4
    Vv = Vv + D
  end if
  return Vv

sub MovePlanets:
  for Pi = 0 to 3
    Ti = Pl[Pi].X
    Tj = Pl[Pi].Dx
    Ti = Ti + Tj
    if Ti < XMin then
      Ti = XMin
      Pl[Pi].Dx = 0 - Tj
    end if
    if Ti > XMax then
      Ti = XMax
      Pl[Pi].Dx = 0 - Tj
    end if
    Pl[Pi].X = Ti
    W16 = LaneY[Pi]
    W16 = W16 * 16
    Ti = Pl[Pi].Y
    Tj = Pl[Pi].Dy
    Ti = Ti + Tj
    Pl[Pi].Y = Ti
    ' bob within 8 pixels of the lane
    Tk = W16 - 128
    if Ti < Tk then Pl[Pi].Dy = 0 - Tj
    Tk = W16 + 128
    if Ti > Tk then Pl[Pi].Dy = 0 - Tj
  next
  return
end sub

' an orbit locks after 20 frames within 8 pixels of a planet at no more
' than 3/4 pixel a frame faster or slower on each axis
sub CheckOrbit:
  u8 Hit = 0
  u8 A = 0
  u8 B = 0
  for Pi = 0 to 3
    W16 = SX >> 4
    A = W16
    W16 = Pl[Pi].X >> 4
    B = W16
    if Dist(A, B) < 9 then
      W16 = SY >> 4
      A = W16
      W16 = Pl[Pi].Y >> 4
      B = W16
      if Dist(A, B) < 9 then
        Ti = SVx - Pl[Pi].Dx
        if Ti < 0 then Ti = 0 - Ti
        Tj = SVy - Pl[Pi].Dy
        if Tj < 0 then Tj = 0 - Tj
        if Ti <= 12 then
          if Tj <= 12 then Hit = Pi + 1
        end if
      end if
    end if
  next
  if Hit = 0 then
    Match = 0
  else
    if Hit <> Near then Match = 0
    inc Match
    if Match >= 20 then
      Lock = Hit
      RefC = 0
      LeaveC = 0
      play sound SndLock
      V = Hit & 1
      if V = 1 then
        MsgLine(1)
      else
        MsgLine(2)
      end if
    end if
  end if
  Near = Hit
  return
end sub

function Dist(u8 A, u8 B) as u8
  if A > B then return A - B
  return B - A

' in orbit: gas giants (slots 1, 3) refuel to full, rocky planets top up
' the supplies to half (lines 200-225)
sub Refill:
  inc RefC
  if RefC < 10 then return
  RefC = 0
  V = Lock & 1
  if V = 0 then
    if Qf < 33 then
      Qf = Qf + Lv
      if Qf > 33 then Qf = 33
      DrawBar(21)
      play sound SndFill
    end if
  else
    if Qs < 17 then
      Qs = Qs + Lv
      if Qs > 17 then Qs = 17
      DrawBar(22)
      play sound SndFill
    end if
  end if
  return
end sub

sub TryLand:
  Wp = Lock - 1
  V = Wp & 1
  if V = 1 then
    if Rp[Wp] = 0 then
      play sound SndNoLand
      MsgLine(3)
      return
    end if
  end if
  play sound SndLand
  Landing
  Lock = 0
  Match = 0
  SVx = 0
  SVy = 0
  if Sp = 0 then
    if Worlds >= WinN then Sp = 5
  end if
  if Sp = 0 then
    Gen(Wp)
    NewSpace
  end if
  return
end sub

' row 20 messages
sub MsgLine(u8 M):
  fill 32 count 28 at 2,20
  select case M
    case 1
      print at 2,20, "IN ORBIT: LOADING SUPPLIES"
      MsgT = 0
    case 2
      print at 2,20, "IN ORBIT: TAKING ON FUEL"
      MsgT = 0
    case 3
      print at 2,20, "SORRY--NO SURFACE TO LAND ON"
      MsgT = 120
  end select
  return
end sub

' the fuel (row 21) and supplies (row 22) gauges: 17 tiles of two units
sub DrawBar(u8 Row):
  u8 Q = 0
  u8 T = 0
  u8 Full = 0
  u8 Half = 0
  if Row = 21 then
    Q = Qf
    Full = TFuelf
    Half = TFuelh
  else
    Q = Qs
    Full = TSupf
    Half = TSuph
  end if
  for T = 0 to 16
    if Q >= 2 then
      put char Full at T + 11,Row
      Q = Q - 2
    else
      if Q = 1 then
        put char Half at T + 11,Row
        Q = 0
      else
        put char TFuele at T + 11,Row
      end if
    end if
  next
  return
end sub

sub DrawSpace:
  W16 = SX >> 4
  X = W16
  W16 = SY >> 4
  Y = W16
  C = 5
  if Lock > 0 then C = 3
  set sprite 0 to Y - 1,X,SHull,15
  set sprite 1 to Y - 1,X,SGlow,C
  V = Tick & 4
  if Thr = 1 then
    if V = 0 then
      set sprite 2 to Y - 1,X,SFlame,9
    else
      set sprite 2 to Y - 1,X,SFlame,11
    end if
  else
    set sprite 2 to 192,0,0,0
  end if
  for Pi = 0 to 3
    W16 = Pl[Pi].X >> 4
    X = W16
    W16 = Pl[Pi].Y >> 4
    Y = W16
    V = Pi & 1
    K = SRocky
    if V = 1 then K = SGiant
    set sprite Pi + 3 to Y - 1,X,K,PlCol[Pi]
    if V = 1 then
      J = Pi / 2 + 7
      select case Rp[Pi]
        case 0
          set sprite J to 192,0,0,0
        case 1
          set sprite J to Y - 7,X + 12,SMoon,14
        case 2
          set sprite J to Y - 7,X + 12,SStation,15
      end select
    end if
  next
  update sprites
  return
end sub

sub ShowTop:
  NumU = Worlds
  print at 2,1, "WORLDS ", digits$(NumU, 2), "/25"
  NumU = Crew
  print at 19,1, "CREW ", digits$(NumU, 2)
  return
end sub

' the space screen: stars, the counters and the gauges
sub NewSpace:
  NewScreen
  Scr = 5
  for Pi = 0 to 39
    X = RndN(28) + 2
    Y = RndN(18) + 2
    K = RndN(3)
    put char TStar1 + K at X,Y
  next
  ShowTop
  print at 2,21, "FUEL"
  print at 2,22, "SUPPLIES"
  DrawBar(21)
  DrawBar(22)
  Lock = 0
  Match = 0
  MsgT = 0
  DrawSpace
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

sub NewGame:
  for Pi = 0 to 32
    Alive[Pi] = 1
  next
  Head = RndN(33)
  Alive[Head] = 0
  Crew = 32
  FillPools
  NameIx = RndN(40)
  Cv = 1
  Worlds = 0
  Sp = 0
  Qf = 33
  Qs = 33
  FuelC = 0
  SupC = 0
  FuelT = FuelTT[Lv - 1]
  SupT = SupTT[Lv - 1]
  for Ri = 0 to 3
    Gen(Ri)
  next
  ' spread the planets out across their lanes at the start
  for Ri = 0 to 3
    W16 = RndN(160) + 32
    Pl[Ri].X = W16 * 16
  next
  SX = 120 * 16
  SY = 144 * 16
  SVx = 0
  SVy = 0
  Lock = 0
  Match = 0
  return
end sub

' ---------------------------------------------------------------------------
' text helpers
' prints message Off of Txt from row Row (2 or 3 lines of up to 28)
sub ShowMsg(u16 Off, u8 Row):
  u8 L = 0
  u8 I = 0
  copy Txt + Off count 30 to LineBuf
  L = LineBuf[0]
  while L > 0
    fill 32 count 28 at 2,Row
    for I = 1 to L
      put char LineBuf[I] at I + 1,Row
    next
    Off = Off + L + 1
    inc Row
    copy Txt + Off count 30 to LineBuf
    L = LineBuf[0]
  end while
  return
end sub

' prints crew member Who's name at Col,Row; NameEnd is the column after it
sub PutName(u8 Who, u8 Col, u8 Row):
  u16 Off = 0
  u8 I = 0
  u8 Ch = 0
  Off = Who
  Off = Off * 8
  copy CrewN + Off count 8 to LineBuf
  NameEnd = Col
  for I = 0 to 7
    Ch = LineBuf[I]
    if Ch <> 32 then
      put char Ch at NameEnd,Row
      inc NameEnd
    end if
  next
  return
end sub

sub ClearRows(u8 A, u8 B):
  u8 R = 0
  for R = A to B
    fill 32 count 28 at 2,R
  next
  return
end sub

' short sayings in the message area, rows 19 on
sub Say(u8 M):
  ClearRows(19, 22)
  select case M
    case 0
      print at 2,19, "FOUND NOTHING WORTHWHILE."
    case 1
      print at 2,19, "GOT IT! INTO THE CARGO HOLD."
    case 2
      print at 2,19, "WHAT'S TO TAKE?"
    case 3
      print at 2,19, "'GO AWAY!'"
    case 4
      print at 2,19, "'SORRY--CAN'T HELP YOU.'"
    case 5
      print at 2,19, "'NO SPEAK GALACTIC. SORRY.'"
    case 6
      print at 2,19, "THE LOCALS DON'T LIKE ART."
    case 7
      print at 2,19, "HEAR THE APPLAUSE?"
      print at 2,20, "THEY LOVE US!"
    case 8
      print at 2,19, "THEY'VE GOT NOTHING TO FIX."
    case 9
      print at 2,19, "THEY LIKED OUR WORK, PILOT."
    case 10
      print at 2,19, "'NO DEALS WITH STRANGERS!'"
    case 11
      print at 2,19, "'WE'LL DO WHAT WE CAN--"
      print at 2,20, "KEEP LOOKING.'"
    case 12
      print at 2,19, "'MORE BEGGARS? GO AWAY!'"
    case 13
      print at 2,19, "'NOTHING WE CAN DO. SORRY.'"
    case 14
      print at 2,19, "'WE DON'T LIKE THIEVES!'"
  end select
  return
end sub

' ---------------------------------------------------------------------------
' on a world (lines 400-587)
sub Landing:
  Qs = 33
  Dg = 0
  Tr = 0
  Ft = 0
  Leave = 0
  inc Worlds
  if Pd[Wp] = 10 then
    Ty = 29 + Hb[Wp]
  else
    Ty = Hb[Wp] * 10 + Pd[Wp]
  end if
  NewScreen
  Scr = 6
  print at 2,1, "LANDED ON"
  W16 = Rp[Wp]
  W16 = W16 * 20
  put KindTxt + W16 count 20 at 2,2
  if Rp[Wp] < 2 then
    print at 2,3, "NAMED"
    W16 = Pn[Wp]
    W16 = W16 * 8
    put PlN + W16 count 8 at 8,3
  end if
  W16 = Hb[Wp]
  W16 = W16 * 22
  put PopTxt + W16 count 22 at 2,4
  W16 = DescOff[Ty]
  ShowMsg(W16, 6)
  fill TRule count 28 at 2,8
  NItems = 9
  if Hb[Wp] = 0 then NItems = 4
  DrawMenu
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Sel = 0
  while Leave = 0
    MenuPick
    if Hb[Wp] = 0 then
      Act = UnAct[Sel]
    else
      Act = Sel + 1
    end if
    DoAct
  end while
  ' the report back on the ship (lines 480-484)
  ClearRows(9, 22)
  if Sp = 2 then print at 2,9, "TOO MANY LOST, PILOT!"
  if Sp <> 1 then
    NumU = Crew
    print at 2,12, "SURVIVING CREW  ", digits$(NumU, 2)
    NumU = Cv
    print at 2,14, "CARGO VALUE  ", width$(NumU, 5), "0000"
    print at 2,22, "PRESS THE BUTTON"
    WaitPress
  end if
  return
end sub

sub DrawMenu:
  u8 I = 0
  u8 A = 0
  ClearRows(9, 18)
  print at 2,9, "WHAT WILL YOU DO NOW?"
  for I = 1 to NItems
    if NItems = 4 then
      A = UnAct[I - 1]
    else
      A = I
    end if
    W16 = A - 1
    W16 = W16 * 22
    put MenuTxt + W16 count 22 at 5,I + 9
  next
  return
end sub

' up/down moves the arrow, a button chooses
sub MenuPick:
  u8 Old = 0
  Old = 255
  Press = 0
  while Press = 0
    if Old <> Sel then
      for Ri = 10 to 18
        put char 32 at 3,Ri
      next
      put char 62 at 3,Sel + 10
      Old = Sel
    end if
    Frame1
    ReadPad
    V = J1 & 3
    if V > 0 then
      if WasStick = 0 then
        play sound SndBlip
        if V = 1 then
          if Sel = 0 then
            Sel = NItems - 1
          else
            dec Sel
          end if
        else
          inc Sel
          if Sel >= NItems then Sel = 0
        end if
      end if
    end if
    WasStick = V
  end while
  return
end sub

sub WaitPress:
  Press = 0
  while Press = 0
    Frame1
    ReadPad
  end while
  return
end sub

sub DoAct:
  u8 H = 0
  u8 D = 0
  u8 E = 0
  u8 More = 0
  H = Hb[Wp]
  D = Dl[Wp]
  E = Ef[Wp]
  More = 0
  if Tr < Ht[Wp] then More = 1
  select case Act
    case 1
      ' look around
      if Risky(D) = 1 then
        Accident
      else
        if Risky(E) = 1 then
          if More = 1 then
            FindIt(0)
          else
            Say(0)
          end if
        else
          Say(0)
        end if
      end if
    case 2
      ' ask questions
      if H = 1 then
        if D < 5 then
          Dl[Wp] = 3
          Say(3)
          return
        end if
      end if
      if D > 7 then
        if More = 1 then
          FindIt(0)
          return
        end if
      end if
      if H = 1 then
        Say(4)
      else
        Say(5)
      end if
    case 3
      ' put on a show
      if D < 7 then
        Dl[Wp] = D + 1
        Say(7)
      else
        Say(6)
      end if
    case 4
      ' offer to tinker
      E = 0
      if H = 1 then E = Risky(D)
      if E = 1 then
        Dl[Wp] = D + 1
        if Ef[Wp] > 4 then dec Ef[Wp]
        Say(9)
      else
        Say(8)
      end if
    case 5
      ' dicker with the locals
      if Ft > 0 then
        if D < 4 then
          Say(10)
        else
          StoreFind
        end if
      else
        E = 0
        if D > 6 then
          if Ef[Wp] < 10 then E = More
        end if
        if E = 1 then
          FindIt(1)
        else
          Say(10)
        end if
      end if
    case 6
      ' ask for help
      if H = 2 then
        Dl[Wp] = D + 1
        if E > 6 then dec Ef[Wp]
        Say(11)
      else
        if D > 7 then
          if E > 4 then
            dec Ef[Wp]
            Say(11)
          else
            Say(13)
          end if
        else
          Say(12)
        end if
      end if
    case 7
      TakeIt
    case 8
      Leave = 1
    case 9
      Sp = 1
      Leave = 1
  end select
  return
end sub

' take what we need (lines 435-437 on empty worlds, 580-587 on peopled ones)
sub TakeIt:
  u8 D = 0
  D = Dl[Wp]
  if Hb[Wp] = 0 then
    if Ft > 0 then
      StoreFind
    else
      if Risky(D) = 1 then
        Accident
      else
        Say(2)
      end if
    end if
    return
  end if
  if Ft > 0 then
    StoreFind
    if D < 8 then
      Accident
      return
    end if
    D = D - 3
  else
    if Risky(D) = 1 then
      Accident
      return
    end if
    if D > 2 then
      D = D - 2
    else
      D = 1
    end if
  end if
  Dl[Wp] = D
  if Risky(D) = 1 then
    Accident
  else
    Say(14)
  end if
  return
end sub

sub StoreFind:
  Cv = Cv + Ft
  Ft = 0
  play sound SndFind
  Say(1)
  return
end sub

' a find (lines 450-457): Offer 1 is the locals offering it for sale
sub FindIt(u8 Offer):
  u8 I = 0
  u8 T = 0
  ClearRows(19, 22)
  if Offer = 0 then
    print at 2,19, "PILOT! LOOK WHAT WE FOUND!"
  else
    print at 2,19, "'ALL RIGHT. YOU WANT TO BUY:"
  end if
  T = Ty * 3 + Tr
  W16 = FndOff[T]
  ShowMsg(W16, 20)
  I = RndN(10)
  Ft = I * Lv + 1
  if Dl[Wp] < 12 then
    T = 12 - Dl[Wp]
    I = RndN(T)
    if I >= Ft then
      Ft = 1
    else
      Ft = Ft - I
    end if
  end if
  inc Tr
  play sound SndFind
  return
end sub

' a mishap (lines 440-449): a random crew member is lost
sub Accident:
  u8 N = 0
  u8 Who = 0
  u8 T = 0
  N = RndN(Crew)
  Who = 0
  for T = 0 to 32
    if Alive[T] = 1 then
      if N = 0 then Who = T
      dec N
    end if
  next
  Alive[Who] = 0
  dec Crew
  ClearRows(19, 22)
  print at 2,19, "PILOT! IT'S AWFUL!"
  PutName(Who, 2, 20)
  print at NameEnd,20, " JUST"
  T = Ty * 3 + Dg
  W16 = MisOff[T]
  ShowMsg(W16, 21)
  play sound SndLost
  inc Dg
  if Crew < 5 then Sp = 2
  if Dg >= 3 then Leave = 1
  if Sp = 2 then Leave = 1
  if Leave = 1 then
    ClearRows(9, 18)
    if Sp = 0 then
      PutName(Head, 2, 10)
      print at NameEnd,10, " ORDERS YOU:"
      print at 2,11, "RETURN TO THE SHIP!"
    end if
    print at 2,13, "PRESS THE BUTTON"
    WaitPress
  end if
  return
end sub

' ---------------------------------------------------------------------------
sub EndPage:
  mute all
  NewScreen
  Scr = 7
  if Sp = 5 then
    print at 2,3, "YOU LED US TO 25 WORLDS--"
    print at 2,4, "GOOD WORK!"
    play sound SndWin
  else
    select case Sp
      case 1
        print at 2,2, "YOU RESIGNED AS PILOT."
      case 2
        print at 2,2, "TOO MANY LOST, PILOT!"
      case 3
        print at 2,2, "OUT OF FUEL!"
      case 4
        print at 2,2, "OUT OF SUPPLIES!"
    end select
    PutName(Head, 2, 4)
    print at NameEnd,4, " HAS REMOVED YOU"
    print at 2,5, "AS PILOT. WITH LUCK,"
    Cr = RndN(33)
    while Alive[Cr] = 0
      Cr = RndN(33)
    end while
    PutName(Cr, 2, 7)
    print at NameEnd,7, " CAN PILOT"
    print at 2,8, "THE FAMILY TO FORTUNE--"
    print at 2,9, "AND SURVIVAL!"
    play sound SndOver
  end if
  NumU = Cv
  print at 2,13, "CARGO VALUE    ", width$(NumU, 5), "0000"
  NumU = Crew
  print at 2,15, "SURVIVING CREW  ", digits$(NumU, 2)
  NumU = Worlds
  print at 2,17, "WORLDS VISITED  ", digits$(NumU, 2)
  ShowScreen
  Rearm
  wait 90 frames
  nmi off
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  Scr = 2
  print at 12,1, "STARFOLK"
  fill TRule count 28 at 2,2
  print at 2,4, "YOU ARE CHOSEN TO PILOT THE"
  print at 2,5, "FAMILY STARSHIP IN SEARCH OF"
  print at 2,6, "WORLDS WHERE WE CAN TRADE,"
  print at 2,7, "PUT ON SHOWS, AND PERHAPS"
  print at 2,8, "FIND SPECTACULAR TREASURE."
  print at 2,10, "MOST IMPORTANT: KEEP THE"
  print at 2,11, "FAMILY SAFE. YOU MUST ANSWER"
  print at 2,12, "FOR ANY LIVES THAT ARE LOST."
  print at 2,15, "HOW DANGEROUS A VOYAGE?"
  print at 5,17, "VERY DANGEROUS"
  print at 5,18, "BOLD BUT NOT CRAZY"
  print at 5,19, "PRETTY SAFE"
  print at 5,20, "CREDITS"
  print at 2,22, "AHOY! DECEMBER 1985"
  set sprite 3 to 127,208,SRocky,10
  set sprite 4 to 151,192,SGiant,7
  set sprite 0 to 107,216,SHull,15
  set sprite 1 to 107,216,SGlow,5
  update sprites
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu = 0 then
          Menu = 3
        else
          dec Menu
        end if
      else
        inc Menu
        if Menu > 3 then Menu = 0
      end if
      ShowMenu
      play sound SndBlip
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then
    CreditsPage
  else
    Lv = Menu + 1
  end if
  return
end sub

sub ShowMenu:
  for Ri = 17 to 20
    put char 32 at 3,Ri
  next
  put char 62 at 3,Menu + 17
  return
end sub

sub FamilyPage:
  NewScreen
  Scr = 3
  print at 7,1, "HERE IS THE FAMILY"
  fill TRule count 28 at 2,2
  Y = 3
  X = 5
  for Ri = 0 to 32
    if Alive[Ri] = 1 then
      PutName(Ri, X, Y)
      if X = 5 then
        X = 18
      else
        X = 5
        inc Y
      end if
    end if
  next
  PutName(Head, 2, 20)
  print at NameEnd,20, " IS HEAD OF THE FAMILY."
  print at 2,22, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub InstrPage:
  NewScreen
  Scr = 4
  print at 2,1, "LAST MINUTE INSTRUCTIONS"
  fill TRule count 28 at 2,2
  print at 2,4, "THE SHIP'S COMPUTER FINDS"
  print at 2,5, "STRIPED GAS GIANTS FOR FUEL"
  print at 2,6, "AND ROCKY PLANETS FOR THE"
  print at 2,7, "SUPPLIES THAT KEEP US ALIVE."
  print at 2,9, "FLY ALONGSIDE A PLANET AND"
  print at 2,10, "MATCH ITS SPEED: THE SHIP"
  print at 2,11, "LOCKS INTO STATIONARY ORBIT"
  print at 2,12, "AND LOADS UP. THRUST BURNS"
  print at 2,13, "FUEL; SUPPLIES RUN DOWN."
  print at 2,15, "PRESS THE BUTTON IN ORBIT TO"
  print at 2,16, "LAND. ROCKY PLANETS, MOONS"
  print at 2,17, "AND STATIONS HAVE A SURFACE."
  print at 2,19, "LEAD THE FAMILY TO 25 WORLDS"
  print at 2,22, "PRESS THE BUTTON TO GO"
  ShowScreen
  WaitPress
  return
end sub

sub CreditsPage:
  NewScreen
  Scr = 1
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "STARFOLK"
  print at 2,5, "BASED ON GYPSY (GYPSY PILOT)"
  print at 2,6, "FROM AHOY! DECEMBER 1985"
  print at 2,7, "(COMMODORE 64 BASIC AND"
  print at 2,8, "MACHINE CODE, AUTHOR NOT"
  print at 2,9, "NAMED IN THE LISTING)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CARAVAN OF STARS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

