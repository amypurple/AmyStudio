record Spar:
  u8 C
  u8 R
  u8 K
end record

Spar Sp[5]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Clock = 0
bcd digits 6 Sc[2]
bcd digits 6 Hi = 0
' the movers
u8 MC[20]
u8 MR[20]
u8 MD[20]
u8 MP[20]
u8 MF[20]
u8 MK[20]
u8 MS[20]
u8 MV[20]
u8 MT[20]
u8 MH[20]
u8 MInv[20]
u8 SX[20]
u8 SY[20]
' creatures: move delay now, ram wait
u8 MDl[20]
u8 MW[20]
u8 SpdUp = 0
' the maze's wall bits (55 bytes, as in the original)
u8 MzB[55]
' players: lives, powers (1 red, 2 blue), shot wait, facing, stick, safe time
u8 PL[2]
u8 PW[2]
u8 PC[2]
u8 PF[2]
u8 PJ[2]
u8 PSafe[2]
u8 NPl = 1
u8 Lv = 1
u8 LvIdx = 1
u8 StartLv = 1
u8 MzNow = 0
u8 ToCome = 0
u16 ComeT = 0
u8 Over = 0
u8 Cleared = 0
u8 BoomX = 0
u8 BoomY = 0
u8 BoomT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Pass = 0
u8 Late = 0
u8 LateSeen = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Si = 0
u8 Ti = 0
u8 Ci = 0
u8 Ui = 0
' scratch
u8 C = 0
u8 R = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Nc = 0
u8 Nr = 0
u8 Hit = 0
u8 Who = 0
u8 Best = 0
u8 BestD = 0
u8 Tc = 0
u8 Tr = 0
u8 Col = 0
u8 Pat = 0
u8 LineDir = 0
u8 Pq = 0
u8 Half = 0
u8 Thinks = 0
u8 StatT = 0
u8 ScanEnd = 11
u8 FireOdds = 1
u8 ShotV = 12

  mode 2 screen
  load default ascii
  duplicate mode 2 patterns
  set sound table XrSoundTable areas 6
  sprites 8x8
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame2
  ReadPads
  PlayStep
  DrawSprites
  StatusStep
  if Cleared = 1 then NextMaze
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  HideSprites
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, " 1UP  ", Sc[0], "  "
  if NPl = 2 then
    print at 8,13, " 2UP  ", Sc[1], "  "
  else
    print at 8,13, "                "
  end if
  print at 8,14, " BEST ", Hi, "  "
  print at 8,15, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the maze: a wall at cell C (0-38), R (0-21)? the right half mirrors the left
function Wall(u8 Cc, u8 Rr) as u8
  u16 Bit = 0
  u8 Bi = 0
  u8 Mask = 0
  u8 Sh = 0
  if Cc > 19 then Cc = 38 - Cc
  Bit = RowBit[Rr] + Cc
  Bi = Bit >> 3
  Sh = Bit & 7
  Mask = 128 >> Sh
  return MzB[Bi] & Mask

' the cell next to C, R in direction D (wrapping), into Nc, Nr
sub NextCell:
  Nc = C + DCx[D]
  if Nc > 38 then Nc = Nc - 39
  Nr = R + DRy[D]
  if Nr > 21 then Nr = Nr - 22
  return
end sub

' is the way from C, R in direction D open? (1 = open)
function IsOpen(u8 Dd) as u8
  if Dd = 0 then return 0
  D = Dd
  NextCell
  if Wall(Nc, Nr) > 0 then return 0
  return 1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random number 0..N-1 (N up to 255)
function RandN(u8 N) as u8
  Rand
  W16 = Rs & 255
  W16 = W16 * N
  return W16 >> 8

' a random open cell at least Far cells (rows + columns) from both players
sub FreeCell(u8 Far):
  u8 Tries = 0
  u8 Dd = 0
  u8 Ok = 0
  Tries = 0
  Ok = 0
  while Ok = 0
    Tc = RandN(39)
    Tr = RandN(22)
    Ok = 1
    if Wall(Tc, Tr) > 0 then Ok = 0
    if Ok = 1 then
      inc Tries
      if Tries < 60 then
        for Ui = 0 to 1
          if MK[Ui] = KMan then
            Dd = Dist(Ui, Tc, Tr)
            if Dd < Far then Ok = 0
          end if
        next
      end if
    end if
  end while
  return
end sub

' rows + columns from mover I to cell Cc, Rr (wrapping counted)
function Dist(u8 I, u8 Cc, u8 Rr) as u8
  u8 A = 0
  u8 B = 0
  if MC[I] > Cc then
    A = MC[I] - Cc
  else
    A = Cc - MC[I]
  end if
  if A > 19 then A = 39 - A
  if MR[I] > Rr then
    B = MR[I] - Rr
  else
    B = Rr - MR[I]
  end if
  if B > 11 then B = 22 - B
  return A + B

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  inc Clock
  if Clock >= SpUp then
    Clock = 0
    if SpdUp < 6 then
      inc SpdUp
      for Si = 2 to 10
        if MK[Si] > 0 then SetSpeed(Si)
      next
      play sound SndFaster
    end if
  end if
  ' creatures arriving
  if ComeT > 0 then
    dec ComeT
  else
    if ToCome > 0 then
      Arrive
      dec ToCome
      ' the first crowd comes quickly (a creature every 4 passes)
      ComeT = 4
    else
      ToCome = 1
      ComeT = LvCome[LvIdx]
    end if
  end if
  ' the creatures take turns: half of them each pass, with two passes'
  ' worth of moving (the players and the shots move every pass)
  Half = Pass & 1
  Thinks = 0
  for Mi = 0 to 19
    if MK[Mi] > 0 then
      if Mi >= 2 then
        if Mi < 11 then
          V = Mi & 1
          if V = Half then MoveOne
        else
          MoveOne
        end if
      else
        MoveOne
      end if
    end if
  next
  Contacts
  if BoomT > 0 then dec BoomT
  return
end sub

' mover Mi: its speed's worth of steps this frame
sub MoveOne:
  u16 Acc = 0
  u8 Steps = 0
  if Mi < 2 then
    PlayerFrame
    if PSafe[Mi] > 20 then return
  end if
  ' two frames' worth: the game runs 30 passes a second
  Acc = MF[Mi]
  Acc = Acc + MV[Mi] + MV[Mi]
  if Mi >= 2 then
    if Mi < 11 then Acc = Acc + MV[Mi] + MV[Mi]
  end if
  Steps = Acc >> 5
  MF[Mi] = Acc & 31
  ' a creature in mid-cell only moves on
  if Mi >= 2 then
    if Mi < 11 then
      Pq = MP[Mi]
      if Pq > 0 then
        Pq = Pq + Steps
        if Pq < 8 then
          MP[Mi] = Pq
          Steps = 0
        end if
      end if
    end if
  end if
  while Steps > 0
    StepOne
    dec Steps
    if MK[Mi] = 0 then Steps = 0
  end while
  if MK[Mi] > 0 then PlaceMe
  return
end sub

' one step (an eighth of a cell) of mover Mi
sub StepOne:
  C = MC[Mi]
  R = MR[Mi]
  if MP[Mi] = 0 then
    ' at most one creature thinks in one pass; the others wait a step
    if Mi >= 2 then
      if Mi < 11 then
        if Thinks >= 1 then return
        inc Thinks
      end if
    end if
    if MK[Mi] < KShot1 then Decide
    if MK[Mi] = 0 then return
    if MD[Mi] = 0 then return
    if IsOpen(MD[Mi]) = 0 then
      Blocked
      return
    end if
  end if
  ' shots go a whole cell a step
  if MK[Mi] >= KShot1 then
    MP[Mi] = 8
  else
    inc MP[Mi]
  end if
  if MP[Mi] = 8 then
    MP[Mi] = 0
    D = MD[Mi]
    NextCell
    MC[Mi] = Nc
    MR[Mi] = Nr
    if Mi < 2 then TakeSpar
    if Mi >= 2 then
      if Mi < 11 then CreatureCell
    end if
  end if
  return
end sub

' at a cell's centre: the way to go
sub Decide:
  select case MK[Mi]
    case KMan
      ManTurn
    case KShot1 to KBad
      ' shots run straight on
    case else
      CreatureTurn
  end select
  return
end sub

' the way ahead is shut: a shot ends, a player stops, a creature turns back
sub Blocked:
  select case MK[Mi]
    case KShot1 to KBad
      MK[Mi] = 0
      Unseen(Mi)
    case KMan
      MD[Mi] = 0
    case else
      MD[Mi] = Opp[MD[Mi]]
  end select
  return
end sub

sub Unseen(u8 I):
  SX[I] = 0
  SY[I] = 208
  return
end sub

' screen position of mover Mi
sub PlaceMe:
  u8 Px = 0
  u8 Py = 0
  Px = MC[Mi] * 5 + MazeX
  Py = MR[Mi] * 7 + MazeY
  V = MP[Mi]
  select case MD[Mi]
    case 1
      Py = Py - P7[V]
    case 2
      Py = Py + P7[V]
    case 3
      Px = Px - P5[V]
    case 4
      Px = Px + P5[V]
  end select
  SX[Mi] = Px
  SY[Mi] = Py
  return
end sub

' ---------------------------------------------------------------------------
' the players
sub PlayerFrame:
  if PSafe[Mi] > 0 then dec PSafe[Mi]
  if PC[Mi] > 0 then dec PC[Mi]
  ' reversing in mid-cell
  if MP[Mi] > 0 then
    D = StickDir(PJ[Mi], MD[Mi])
    if D > 0 then
      if D = Opp[MD[Mi]] then
        C = MC[Mi]
        R = MR[Mi]
        Hit = MD[Mi]
        D = Hit
        NextCell
        MC[Mi] = Nc
        MR[Mi] = Nr
        MP[Mi] = 8 - MP[Mi]
        MD[Mi] = Opp[Hit]
        PF[Mi] = MD[Mi]
      end if
    end if
  end if
  K = PJ[Mi] & 16
  if K > 0 then
    if PC[Mi] = 0 then Shoot
  end if
  return
end sub

' the stick's direction (1-4); with two pressed, the one that is not the way
' already taken (so a diagonal turns at the next corner); 0 if none
function StickDir(u8 Js, u8 Cur) as u8
  u8 A = 0
  u8 B = 0
  A = 0
  B = 0
  if Js & 1 then A = 1
  if Js & 2 then A = 2
  if Js & 4 then B = 3
  if Js & 8 then B = 4
  if A = 0 then return B
  if B = 0 then return A
  if Cur = A then return B
  return A

sub ManTurn:
  u8 Want = 0
  Want = StickDir(PJ[Mi], MD[Mi])
  if Want = 0 then
    MD[Mi] = 0
    return
  end if
  if IsOpen(Want) = 1 then
    MD[Mi] = Want
    PF[Mi] = Want
    return
  end if
  ' a diagonal: the other half of it
  if IsOpen(MD[Mi]) = 0 then MD[Mi] = 0
  return
end sub

' a shot from player Mi, in the way it faces
sub Shoot:
  u8 First = 0
  u8 Last = 0
  u8 Slot = 0
  First = Mi * 3 + 11
  Last = 1
  V = PW[Mi] & 1
  if V > 0 then Last = 2
  Slot = 0
  for Si = 0 to 2
    if Si <= Last then
      if Slot = 0 then
        if MK[First + Si] = 0 then Slot = First + Si
      end if
    end if
  next
  if Slot = 0 then return
  MK[Slot] = KShot1 + Mi
  MC[Slot] = MC[Mi]
  MR[Slot] = MR[Mi]
  MP[Slot] = 0
  MF[Slot] = 0
  MD[Slot] = PF[Mi]
  MV[Slot] = SpShot
  MT[Slot] = 0
  SX[Slot] = SX[Mi]
  SY[Slot] = SY[Mi]
  if V > 0 then
    PC[Mi] = 3
  else
    PC[Mi] = 5
  end if
  play sound SndShoot
  return
end sub

' a player on a spar's cell takes it
sub TakeSpar:
  for Si = 0 to 4
    if Sp[Si].K > 0 then
      if Sp[Si].C = MC[Mi] then
        if Sp[Si].R = MR[Mi] then GotSpar
      end if
    end if
  next
  return
end sub

sub GotSpar:
  K = Sp[Si].K
  Sp[Si].K = 0
  inc MH[Mi]
  if MS[Mi] < ShMax then inc MS[Mi]
  if K = 2 then PW[Mi] = PW[Mi] | 1
  if K = 3 then
    PW[Mi] = PW[Mi] | 2
    MV[Mi] = SpMan * 2
  end if
  AddPts(Mi, 5)
  play sound SndSpar
  ShowStatus
  V = MH[0] + MH[1]
  if V >= 5 then Cleared = 1
  return
end sub

' Pts hundreds of points to player P
sub AddPts(u8 P, u8 Pts):
  while Pts > 0
    Sc[P] += 100
    dec Pts
  end while
  if Sc[P] > Hi then Hi = Sc[P]
  return
end sub

' ---------------------------------------------------------------------------
' the creatures
sub Arrive:
  u8 Slot = 0
  u8 Kind = 0
  u8 Alive = 0
  Slot = 0
  Alive = 0
  for Si = 2 to 10
    if MK[Si] > 0 then
      inc Alive
    else
      if Slot = 0 then Slot = Si
    end if
  next
  if Alive >= LvMax[LvIdx] then Slot = 0
  if Slot = 0 then return
  ' as the original ($118A): a type at random, again until its first
  ' level has come
  Kind = 0
  while Kind = 0
    Kind = RandN(16) + 1
    if KMin[Kind] > Lv then Kind = 0
  end while
  FreeCell(6)
  MK[Slot] = Kind
  MC[Slot] = Tc
  MR[Slot] = Tr
  MP[Slot] = 0
  MF[Slot] = 0
  MD[Slot] = 0
  MS[Slot] = KSh[Kind]
  MH[Slot] = 0
  MInv[Slot] = 0
  MT[Slot] = 0
  MW[Slot] = 0
  MDl[Slot] = KDel[Kind]
  ' the dog above level 19 ($11F1): five shields, the player's speed
  if Kind = KDog then
    if Lv > 19 then
      MS[Slot] = 5
      MDl[Slot] = 2
    end if
  end if
  SetSpeed(Slot)
  Mi = Slot
  PlaceMe
  play sound SndAppear
  return
end sub

' a creature's speed: 64 / (its delay less a step for every 30 seconds)
sub SetSpeed(u8 I):
  u8 Dl = 0
  Dl = MDl[I]
  if Dl > SpdUp then
    Dl = Dl - SpdUp
  else
    Dl = 2
  end if
  if Dl < 2 then Dl = 2
  MV[I] = 64 / Dl
  return
end sub

' at a cell's centre: a creature picks its way; the hunters lean towards
' their target, the rest wander
sub CreatureTurn:
  u8 Dd = 0
  u8 Ways = 0
  u8 Pick = 0
  u8 Lean = 0
  u8 Back = 0
  u8 Ok = 0
  ' the open ways, not counting the way back, as bits 1-4
  Back = Opp[MD[Mi]]
  Ok = 0
  Ways = 0
  for Si = 1 to 4
    if Si <> Back then
      if IsOpen(Si) = 1 then
        Ok = Ok | Bit4[Si]
        inc Ways
      end if
    end if
  next
  if Ways = 0 then
    ' a dead end: back
    MD[Mi] = Back
    if Back = 0 then MD[Mi] = RandN(4) + 1
    return
  end if
  if Ways > 1 then
    FindTarget
    Lean = 0
    if BestD > 0 then
      select case KAct[MK[Mi]]
        case ARam, AEat, ADog, AMut
          Lean = 3
        case ACharge, AVac
          Lean = 2
        case else
          Lean = 1
      end select
    end if
    if RandN(4) < Lean then
      Dd = Toward
      if Ok & Bit4[Dd] then
        MD[Mi] = Dd
        return
      end if
    end if
  end if
  Pick = RandN(Ways)
  for Si = 1 to 4
    if Ok & Bit4[Si] then
      if Pick = 0 then Dd = Si
      dec Pick
    end if
  next
  MD[Mi] = Dd
  return
end sub

' the target of creature Mi into Tc, Tr (BestD 0 = none): players for the
' hostile kinds, the nearest creature for the dog, a spar for the eater
sub FindTarget:
  u8 Dd = 0
  BestD = 0
  Best = 255
  if KAct[MK[Mi]] = AEat then
    for Ti = 0 to 4
      if Sp[Ti].K > 0 then
        Dd = Dist(Mi, Sp[Ti].C, Sp[Ti].R)
        if Dd < Best then
          Best = Dd
          Tc = Sp[Ti].C
          Tr = Sp[Ti].R
          BestD = 1
        end if
      end if
    next
    if BestD > 0 then return
  end if
  ' the mutant looks for the light red creature
  if MK[Mi] = KMutant then
    for Ti = 2 to 10
      if MK[Ti] = KLrc then
        Tc = MC[Ti]
        Tr = MR[Ti]
        BestD = 1
      end if
    next
    if BestD > 0 then return
  end if
  if MK[Mi] = KDog then
    for Ti = 2 to 10
      if MK[Ti] > 0 then
        if MK[Ti] <> KDog then
          Dd = Dist(Mi, MC[Ti], MR[Ti])
          if Dd < Best then
            Best = Dd
            Tc = MC[Ti]
            Tr = MR[Ti]
            BestD = 1
          end if
        end if
      end if
    next
    return
  end if
  for Ti = 0 to 1
    if MK[Ti] = KMan then
      if PSafe[Ti] = 0 then
        Dd = Dist(Mi, MC[Ti], MR[Ti])
        if Dd < Best then
          Best = Dd
          Tc = MC[Ti]
          Tr = MR[Ti]
          BestD = 1
        end if
      end if
    end if
  next
  return
end sub

' the direction from creature Mi towards Tc, Tr (the longer way first)
function Toward as u8
  u8 Ax = 0
  u8 Ay = 0
  u8 Hd = 0
  u8 Vd = 0
  Hd = 0
  Vd = 0
  if Tc > MC[Mi] then
    Ax = Tc - MC[Mi]
    Hd = 4
  else
    Ax = MC[Mi] - Tc
    Hd = 3
  end if
  if Ax > 19 then
    Ax = 39 - Ax
    Hd = 7 - Hd
  end if
  if Tr > MR[Mi] then
    Ay = Tr - MR[Mi]
    Vd = 2
  else
    Ay = MR[Mi] - Tr
    Vd = 1
  end if
  if Ay > 11 then
    Ay = 22 - Ay
    Vd = 3 - Vd
  end if
  if Ax = 0 then return Vd
  if Ay = 0 then return Hd
  if Ax > Ay then return Hd
  return Vd

' creature Mi has reached a new cell: spars, shooting, hiding
sub CreatureCell:
  C = MC[Mi]
  R = MR[Mi]
  if MK[Mi] <> KDog then
    for Si = 0 to 4
      if Sp[Si].K > 0 then
        if Sp[Si].C = C then
          if Sp[Si].R = R then
            Sp[Si].K = 0
            inc MH[Mi]
            if MS[Mi] < 9 then inc MS[Mi]
            if KAct[MK[Mi]] = AEat then
              if MDl[Mi] > 2 then dec MDl[Mi]
              SetSpeed(Mi)
            end if
            play sound SndGulp
          end if
        end if
      end if
    next
  end if
  if Thinks < 2 then
    inc Thinks
    select case KAct[MK[Mi]]
      case AShoot, AMut
        GunLook
      case ACharge
        ChargeLook
    end select
    if Lv >= 3 then Lurk
  end if
  return
end sub

' the gunner fires down a straight corridor at a player in it (8 cells)
sub GunLook:
  u8 Slot = 0
  u8 Seen = 0
  u8 Dd = 0
  Slot = 0
  if MK[17] = 0 then Slot = 17
  if MK[18] = 0 then Slot = 18
  if MK[19] = 0 then Slot = 19
  if Slot = 0 then return
  LookLine
  Seen = LineDir
  if Seen = 0 then return
  if RandN(4) >= FireOdds then return
  MK[Slot] = KBad
  MC[Slot] = MC[Mi]
  MR[Slot] = MR[Mi]
  MP[Slot] = 0
  MF[Slot] = 0
  MD[Slot] = Seen
  MV[Slot] = ShotV
  MT[Slot] = MK[Mi]
  SX[Slot] = SX[Mi]
  SY[Slot] = SY[Mi]
  play sound SndZap
  return
end sub

' a rubberhead that sees a player down a corridor charges at twice its speed
sub ChargeLook:
  LookLine
  if LineDir = 0 then
    SetSpeed(Mi)
    return
  end if
  MD[Mi] = LineDir
  SetSpeed(Mi)
  MV[Mi] = MV[Mi] * 2
  return
end sub

' LineDir: the way down which creature Mi sees a player within 10 cells
sub LookLine:
  u8 Dd = 0
  u8 Seen = 0
  u8 Who2 = 0
  Seen = 0
  for Who2 = 0 to 1
    if MK[Who2] = KMan then
      Dd = 0
      ' only a player in the same row or column can be seen
      if MR[Who2] = MR[Mi] then
        Dd = 3
        if MC[Who2] > MC[Mi] then Dd = 4
      end if
      if MC[Who2] = MC[Mi] then
        Dd = 1
        if MR[Who2] > MR[Mi] then Dd = 2
      end if
      if Dd > 0 then
        if Seen = 0 then
          C = MC[Mi]
          R = MR[Mi]
          D = Dd
          for Ti = 1 to 10
            if Seen = 0 then
              NextCell
              if Wall(Nc, Nr) > 0 then
                Ti = 10
              else
                C = Nc
                R = Nr
                if MC[Who2] = C then
                  if MR[Who2] = R then Seen = Dd
                end if
              end if
            end if
          next
        end if
      end if
    end if
  next
  LineDir = Seen
  return
end sub

' alone (no player, shot or other creature within 4 cells) a creature
' fades from sight; anything near brings it back
sub Lurk:
  u8 Near = 0
  u8 Dx = 0
  u8 Dy = 0
  if MK[Mi] = KDog then return
  Near = 0
  for Ti = 0 to 19
    if Near = 0 then
      if Ti <> Mi then
        if MK[Ti] > 0 then
          ' within about 4 cells on the screen
          if SX[Ti] > SX[Mi] then
            Dx = SX[Ti] - SX[Mi]
          else
            Dx = SX[Mi] - SX[Ti]
          end if
          if SY[Ti] > SY[Mi] then
            Dy = SY[Ti] - SY[Mi]
          else
            Dy = SY[Mi] - SY[Ti]
          end if
          if Dx < 21 then
            if Dy < 29 then Near = 1
          end if
        end if
      end if
    end if
  next
  if Near = 1 then
    MInv[Mi] = 0
    MT[Mi] = 0
  else
    if MT[Mi] < 12 then
      inc MT[Mi]
    else
      MInv[Mi] = 1
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' who touches whom
function Meets(u8 A, u8 B) as u8
  u8 Dx = 0
  u8 Dy = 0
  if SX[A] > SX[B] then
    Dx = SX[A] - SX[B]
  else
    Dx = SX[B] - SX[A]
  end if
  if Dx > 3 then return 0
  if SY[A] > SY[B] then
    Dy = SY[A] - SY[B]
  else
    Dy = SY[B] - SY[A]
  end if
  if Dy > 4 then return 0
  return 1

sub Contacts:
  u8 Kd = 0
  ' shots
  for Ci = 11 to 19
    if MK[Ci] > 0 then ShotHits
  next
  ' creatures against players and each other
  for Ci = 2 to 10
    Kd = MK[Ci]
    if Kd > 0 then
      if MW[Ci] > 0 then dec MW[Ci]
      select case KAct[Kd]
        case ADog, AVac, AMut
          ' XrScan from mover 2: the creatures this one touches
          Ti = 2
          while Ti < 11
            call asm XrScan
            if Hit = 1 then
              if Ti <> Ci then CritTouch(Kd)
            end if
            inc Ti
          end while
          if Kd <> KDog then
            if MK[Ci] > 0 then PlayerTouch
          end if
        case else
          PlayerTouch
      end select
    end if
  next
  return
end sub

' creature Ci (kind Kd: the dog, a vacuum or the mutant) touches creature Ti
sub CritTouch(u8 Kd):
  select case KAct[Kd]
    case ADog
      if MK[Ti] <> KDog then DogBite
    case AVac
      if MK[Ti] <> KVac then
        Who = 255
        Kill(Ti)
        play sound SndGulp
      end if
    case else
      if MK[Ti] = KLrc then Merge
  end select
  return
end sub

' creature Ci against the players
sub PlayerTouch:
  Ti = 0
  ScanEnd = 2
  while Ti < 2
    call asm XrScan
    if Hit = 1 then
      if MK[Ti] = KMan then
        if PSafe[Ti] = 0 then Ram
      end if
    end if
    inc Ti
  end while
  ScanEnd = 11
  return
end sub

' the mutant Ci jumps onto the light red creature Ti: one supercreature
sub Merge:
  MK[Ti] = KSuper
  MS[Ti] = MS[Ti] + KSh[KSuper]
  MH[Ti] = MH[Ti] + MH[Ci]
  MDl[Ti] = KDel[KSuper]
  SetSpeed(Ti)
  MK[Ci] = 0
  MH[Ci] = 0
  Unseen(Ci)
  play sound SndGulp
  return
end sub

' shot Ci against the players and creatures
sub ShotHits:
  u8 Kd = 0
  u8 Own = 0
  Kd = MK[Ci]
  Own = MT[Ci]
  Ti = 0
  while Ti < 11
    ' XrScan: the next mover from Ti on (to 10) that the shot touches
    call asm XrScan
    if Hit = 1 then
      if Ti < 2 then
        ' the players' own shots pass them; a safe player is not hit
        if Kd <> KBad then Hit = 0
        if PSafe[Ti] > 0 then Hit = 0
      else
        ' a creature's shot passes its own kind
        if Kd = KBad then
          if MK[Ti] = Own then Hit = 0
        end if
      end if
      if Hit = 1 then
        ShotLands
        Ti = 11
      end if
    end if
    inc Ti
  end while
  return
end sub

' shot Ci reaches Ti: a rubberhead hit in the back sends it back
sub ShotLands:
  u8 Back = 0
  Back = 0
  if KAct[MK[Ti]] = ACharge then Back = 1
  if Back = 1 then
    if MD[Ci] = MD[Ti] then
      MD[Ci] = Opp[MD[Ci]]
      MK[Ci] = KBad
      MT[Ci] = MK[Ti]
      MP[Ci] = 8 - MP[Ci]
      C = MC[Ci]
      R = MR[Ci]
      D = Opp[MD[Ci]]
      NextCell
      MC[Ci] = Nc
      MR[Ci] = Nr
      if MP[Ci] = 8 then MP[Ci] = 0
      play sound SndBounce
      return
    end if
  end if
  Who = 255
  if MK[Ci] = KShot1 then Who = 0
  if MK[Ci] = KShot2 then Who = 1
  MK[Ci] = 0
  Unseen(Ci)
  Damage(Ti)
  return
end sub

' creature Ci runs into player Ti
sub Ram:
  if MK[Ci] = KVac then
    ' sucked up: no shield helps, and they are all lost
    MS[Ti] = 0
    Who = 255
    Kill(Ti)
    play sound SndGulp
    return
  end if
  if MW[Ci] > 0 then return
  Who = 255
  Damage(Ti)
  ' the rammer backs off for a moment (its shields are not used)
  MW[Ci] = 15
  if MP[Ci] = 0 then
    MD[Ci] = Opp[MD[Ci]]
  else
    C = MC[Ci]
    R = MR[Ci]
    D = MD[Ci]
    NextCell
    MC[Ci] = Nc
    MR[Ci] = Nr
    MP[Ci] = 8 - MP[Ci]
    MD[Ci] = Opp[MD[Ci]]
  end if
  return
end sub

' the dog Ci bites creature Ti
sub DogBite:
  if MW[Ci] > 0 then return
  Who = 255
  if MK[Ti] = KVac then
    Kill(Ci)
    return
  end if
  Damage(Ti)
  MW[Ci] = 15
  return
end sub

' a hit on mover I: a shield, or the end
sub Damage(u8 I):
  if MS[I] > 0 then
    dec MS[I]
    play sound SndShield
    if I < 2 then ShowStatus
    return
  end if
  Kill(I)
  return
end sub

' mover I dies; its spars go back into the maze at random; Who (0, 1)
' is the player who scores it
sub Kill(u8 I):
  u8 N = 0
  u8 Kd = 0
  Kd = MK[I]
  BoomX = SX[I]
  BoomY = SY[I]
  BoomT = 8
  N = MH[I]
  MH[I] = 0
  while N > 0
    Strew
    dec N
  end while
  if I < 2 then
    play sound SndDie
    dec PL[I]
    PW[I] = 0
    MV[I] = SpMan
    if PL[I] = 0 then
      MK[I] = 0
      Unseen(I)
      V = MK[0] + MK[1]
      if V = 0 then Over = 1
    else
      Respawn(I)
    end if
    ShowStatus
    return
  end if
  play sound SndHit
  MK[I] = 0
  Unseen(I)
  if Who < 2 then
    if MK[Who] = KMan then AddPts(Who, KSh[Kd])
    ShowStatus
  end if
  return
end sub

' a spar back into the maze, on a free cell away from the players
sub Strew:
  u8 Slot = 0
  Slot = 255
  for Ti = 0 to 4
    if Sp[Ti].K = 0 then Slot = Ti
  next
  if Slot = 255 then return
  FreeCell(3)
  Sp[Slot].C = Tc
  Sp[Slot].R = Tr
  Sp[Slot].K = SparKind
  return
end sub

' white mostly; red and blue now and then
function SparKind as u8
  u8 Rk = 0
  Rk = RandN(6)
  select case Rk
    case 0
      return 2
    case 1
      return 3
  end select
  return 1

' player I starts again at the bottom, unseen and safe for 2 seconds
sub Respawn(u8 I):
  MK[I] = KMan
  if I = 0 then
    MC[I] = 15
  else
    MC[I] = 23
  end if
  MR[I] = 20
  Tc = MC[I]
  while Wall(Tc, 20) > 0
    inc Tc
  end while
  MC[I] = Tc
  MP[I] = 0
  MF[I] = 0
  MD[I] = 0
  PF[I] = 1
  PSafe[I] = 60
  PC[I] = 0
  MV[I] = SpMan
  if PW[I] & 2 then MV[I] = SpMan * 2
  Ti = Mi
  Mi = I
  PlaceMe
  Mi = Ti
  return
end sub

' ---------------------------------------------------------------------------
' sprites: movers 0-19, spars 20-24, a burst 25
sub DrawSprites:
  u8 Fr = 0
  Fr = Tick >> 3
  Fr = Fr & 1
  for Mi = 0 to 19
    SprOne(Fr)
  next
  ' the spars (they only turn) every fourth pass
  V = Pass & 3
  if V > 0 then
    if BoomT = 0 then
      call asm XrLate
      update sprites
      return
    end if
  end if
  for Si = 0 to 4
    J = Si + 20
    if Sp[Si].K > 0 then
      X = Sp[Si].C * 5 + MazeX
      Y = Sp[Si].R * 7 + MazeY
      Col = 15
      if Sp[Si].K = 2 then Col = 8
      if Sp[Si].K = 3 then Col = 5
      Pat = SSpar0 + Fr
      set sprite J to Y - 1,X - 1,Pat,Col
    else
      set sprite J to 192,0,0,0
    end if
  next
  if BoomT > 0 then
    Pat = SBoom0
    if BoomT < 4 then Pat = SBoom1
    set sprite 25 to BoomY - 1,BoomX - 1,Pat,9
  else
    set sprite 25 to 192,0,0,0
  end if
  call asm XrLate
  update sprites
  return
end sub

' mover Mi's sprite
sub SprOne(u8 Fr):
  u8 Kd = 0
  Kd = MK[Mi]
  if Kd = 0 then
    ' hidden once (Unseen leaves SY 208; 209 = done)
    if SY[Mi] <> 209 then
      set sprite Mi to 192,0,0,0
      SY[Mi] = 209
    end if
    return
  end if
  X = SX[Mi] - 1
  Y = SY[Mi] - 1
  select case Kd
    case KMan
      Pat = SMan0 + Fr
      if MD[Mi] = 0 then Pat = SMan0
      Col = 11
      if Mi = 1 then Col = 7
      if PSafe[Mi] > 0 then
        ' unseen while safe; then a slow blink (2 Hz)
        V = PSafe[Mi] >> 3
        V = V & 1
        if PSafe[Mi] > 20 then V = 1
        if V = 1 then Y = 192
      end if
    case KShot1, KShot2
      Pat = SBulH
      if MD[Mi] < 3 then Pat = SBulV
      Col = 11
      if Kd = KShot2 then Col = 7
    case KBad
      Pat = SShot
      Col = 8
    case 10, 14
      select case MD[Mi]
        case 1
          Pat = SRubU
        case 2
          Pat = SRubD
        case 3
          Pat = SRubL
        case else
          Pat = SRubR
      end select
      Col = KCol[Kd]
    case else
      Pat = KPat[Kd] + Fr
      Col = KCol[Kd]
  end select
  if Mi >= 2 then
    if Mi < 11 then
      if MInv[Mi] = 1 then
        ' unseen: a glint for 3 frames in 20
        Pat = SGlint
        Col = 14
        V = Tick + Mi
        V = V % 20
        if V >= 4 then Y = 192
      end if
    end if
  end if
  set sprite Mi to Y,X,Pat,Col
  return
end sub

' ---------------------------------------------------------------------------
' the status lines: row 1 player 1, row 22 player 2 (or the best score)
' the status lines are redrawn a part a pass (StatT 1-4) after a change
sub ShowStatus:
  if StatT = 0 then StatT = 1
  return
end sub

' all four parts at once (new screens)
sub StatusNow:
  for StatT = 1 to 4
    StatusPart
  next
  StatT = 0
  return
end sub

sub StatusStep:
  if StatT = 0 then return
  StatusPart
  inc StatT
  if StatT > 4 then StatT = 0
  return
end sub

sub StatusPart:
  select case StatT
    case 1
      print at 2,1, "1UP"
      print at 6,1, Sc[0]
    case 2
      put char IcShield at 13,1
      NumU = MS[0]
      print at 14,1, digits$(NumU, 1)
      put char IcLife at 16,1
      NumU = PL[0]
      print at 17,1, digits$(NumU, 1)
      print at 20,1, "LV"
      NumU = Lv
      print at 22,1, digits$(NumU, 2)
      put char IcSpar at 26,1
      NumU = MH[0] + MH[1]
      print at 27,1, digits$(NumU, 1), "/5"
    case 3
      if NPl = 2 then
        print at 2,22, "2UP"
        print at 6,22, Sc[1]
        put char IcShield at 13,22
        NumU = MS[1]
        print at 14,22, digits$(NumU, 1)
        put char IcLife at 16,22
        NumU = PL[1]
        print at 17,22, digits$(NumU, 1)
      end if
    case else
      print at 20,22, "HI"
      print at 23,22, Hi
  end select
  return
end sub

' ---------------------------------------------------------------------------
sub NewGame:
  Sc[0] = 0
  Sc[1] = 0
  Lv = StartLv
  for Mi = 0 to 1
    PL[Mi] = 4
    PW[Mi] = 0
    MS[Mi] = 3
    MK[Mi] = 0
  next
  Over = 0
  StartMaze
  play sound SndLevel
  Rearm
  wait no fire
  nmi off
  return
end sub

' the maze of level Lv, the players at the bottom, five spars, five
' creatures to come
sub StartMaze:
  MzNow = Lv - 1
  MzNow = MzNow & 7
  W16 = MzNow
  W16 = W16 * 55
  copy MzBits + W16 count 55 to MzB
  NewScreen
  LoadMazeGfx
  for Mi = 2 to 19
    MK[Mi] = 0
    MInv[Mi] = 0
    Unseen(Mi)
  next
  for Mi = 0 to 1
    MH[Mi] = 0
    if Mi < NPl then
      if PL[Mi] > 0 then
        Respawn(Mi)
        PSafe[Mi] = 20
      end if
    end if
  next
  for Si = 0 to 4
    Sp[Si].K = 0
  next
  for Ui = 0 to 4
    Strew
  next
  ' the level's ramp: more creatures, sooner, quicker and keener to shoot
  LvIdx = Lv
  if LvIdx > 10 then LvIdx = 10
  V = Lv - 1
  SpdUp = V / 2
  if SpdUp > 6 then SpdUp = 6
  FireOdds = V / 2 + 1
  if FireOdds > 4 then FireOdds = 4
  ' the creatures' shots get quicker too (12 to 20)
  ShotV = V + 12
  if ShotV > 20 then ShotV = 20
  Clock = 0
  ' five at a time as the original; more from level 5
  ToCome = 5
  if Lv >= 5 then ToCome = LvMax[LvIdx]
  ComeT = 30
  Cleared = 0
  BoomT = 0
  StatusNow
  Mi = 0
  DrawSprites
  ShowScreen
  return
end sub

' five spars held: the next maze (the players keep score, lives, shields
' and powers)
sub NextMaze:
  play sound SndLevel
  print at 9,10, "              "
  print at 9,11, "  MAZE CLEAR  "
  print at 9,12, "              "
  for Ui = 0 to 89
    Frame1
  next
  inc Lv
  if Lv > 99 then Lv = 99
  StartMaze
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one pass of play every two frames (a steady 30 a second)
' (XrLate: has the screen begun a frame while this pass worked? then one
' wait is enough. Amy's sprite update reads the VDP status too, so the
' pass also looks just before it)
sub Frame2:
  call asm XrLate
  if Late = 0 then FrameW
  FrameW
  LateSeen = Late
  Late = 0
  inc Pass
  return
end sub

' one frame for the play loop: the NMI flag is cleared before the NMI is
' re-armed, so an NMI that comes at once (the frame began during the
' re-arming) still counts (Amy's wait clears it after, and lost a frame)
sub FrameW:
  call asm XrClr
  Rearm
  Idle = 1
  call asm XrPoll
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

function ReadStick(u8 N) as u8
  u8 Js = 0
  Js = 0
  if joypad(N).up then Js = Js | 1
  if joypad(N).down then Js = Js | 2
  if joypad(N).left then Js = Js | 4
  if joypad(N).right then Js = Js | 8
  if joypad(N).fire then Js = Js | 16
  return Js

' the sticks: one player uses either controller, two players one each
sub ReadPads:
  J1 = ReadStick(1)
  J2 = ReadStick(2)
  if NPl = 1 then
    PJ[0] = J1 | J2
    PJ[1] = 0
  else
    PJ[0] = J1
    PJ[1] = J2
  end if
  return
end sub

sub ReadPad:
  J1 = ReadStick(1)
  J2 = ReadStick(2)
  J1 = J1 | J2
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 25
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every screen: Mode 2 with the font in each third (codes 32-95), the
' status icons at 248-250, black
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  for J = 0 to 2
    W16 = J
    W16 = W16 * 2048 + IcShield * 8
    copy TilePat count NTiles8 to vram.pattern + W16
    copy TileCol count NTiles8 to vram.color + W16
  next
  backdrop black
  cls with 32
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the first maze behind a panel, START / PLAYERS / LEVEL /
' CREDITS, the best score, the tune once
sub TitlePage:
  MzNow = 0
  NewScreen
  LoadMazeGfx
  for J = 4 to 18
    fill 32 count 22 at 5,J
  next
  print at 8,5, "CROSSROADS II"
  print at 9,6, "PANDEMONIUM"
  print at 7,8, "BY STEVE HARTER"
  print at 6,9, "COMPUTE!'S GAZETTE"
  print at 10,10, "DEC. 1988"
  print at 10,12, "START"
  print at 10,13, "PLAYERS"
  print at 10,14, "LEVEL"
  print at 10,15, "CREDITS"
  if Hi > 0 then
    print at 9,17, "BEST ", Hi
  end if
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 460
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  TitleStick
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  if Menu = 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub TitleStick:
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      select case V
        case 1
          if Menu > 0 then dec Menu
        case 2
          if Menu < 3 then inc Menu
        case 4
          if Menu = 1 then NPl = 1
          if Menu = 2 then
            if StartLv > 1 then dec StartLv
          end if
        case 8
          if Menu = 1 then NPl = 2
          if Menu = 2 then
            if StartLv < 9 then inc StartLv
          end if
      end select
      ShowMenu
    end if
  end if
  WasStick = V
  return
end sub

sub ShowMenu:
  for J = 12 to 15
    put char 32 at 8,J
  next
  J = Menu + 12
  put char 62 at 8,J
  NumU = NPl
  print at 19,13, "< ", digits$(NumU, 1), " >"
  NumU = StartLv
  print at 19,14, "< ", digits$(NumU, 1), " >"
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 7,2, "CROSSROADS II:"
  print at 9,3, "PANDEMONIUM"
  print at 2,5, "BASED ON THE GAME BY STEVE"
  print at 2,6, "HARTER, COMPUTE!'S GAZETTE"
  print at 2,7, "DECEMBER 1988 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE); ITS EIGHT"
  print at 2,9, "MAZES ARE THE ORIGINAL'S."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: RUSH HOUR AT THE"
  print at 2,18, "CROSSROADS (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub LoadMazeGfx:
  select case MzNow
    case 0
      decompress zx0 Mz0N to vram.name + 64
      decompress zx0 Mz0P0 to vram.pattern + 1024
      decompress zx0 Mz0C0 to vram.color + 1024
      decompress zx0 Mz0P1 to vram.pattern + 3072
      decompress zx0 Mz0C1 to vram.color + 3072
      decompress zx0 Mz0P2 to vram.pattern + 5120
      decompress zx0 Mz0C2 to vram.color + 5120
    case 1
      decompress zx0 Mz1N to vram.name + 64
      decompress zx0 Mz1P0 to vram.pattern + 1024
      decompress zx0 Mz1C0 to vram.color + 1024
      decompress zx0 Mz1P1 to vram.pattern + 3072
      decompress zx0 Mz1C1 to vram.color + 3072
      decompress zx0 Mz1P2 to vram.pattern + 5120
      decompress zx0 Mz1C2 to vram.color + 5120
    case 2
      decompress zx0 Mz2N to vram.name + 64
      decompress zx0 Mz2P0 to vram.pattern + 1024
      decompress zx0 Mz2C0 to vram.color + 1024
      decompress zx0 Mz2P1 to vram.pattern + 3072
      decompress zx0 Mz2C1 to vram.color + 3072
      decompress zx0 Mz2P2 to vram.pattern + 5120
      decompress zx0 Mz2C2 to vram.color + 5120
    case 3
      decompress zx0 Mz3N to vram.name + 64
      decompress zx0 Mz3P0 to vram.pattern + 1024
      decompress zx0 Mz3C0 to vram.color + 1024
      decompress zx0 Mz3P1 to vram.pattern + 3072
      decompress zx0 Mz3C1 to vram.color + 3072
      decompress zx0 Mz3P2 to vram.pattern + 5120
      decompress zx0 Mz3C2 to vram.color + 5120
    case 4
      decompress zx0 Mz4N to vram.name + 64
      decompress zx0 Mz4P0 to vram.pattern + 1024
      decompress zx0 Mz4C0 to vram.color + 1024
      decompress zx0 Mz4P1 to vram.pattern + 3072
      decompress zx0 Mz4C1 to vram.color + 3072
      decompress zx0 Mz4P2 to vram.pattern + 5120
      decompress zx0 Mz4C2 to vram.color + 5120
    case 5
      decompress zx0 Mz5N to vram.name + 64
      decompress zx0 Mz5P0 to vram.pattern + 1024
      decompress zx0 Mz5C0 to vram.color + 1024
      decompress zx0 Mz5P1 to vram.pattern + 3072
      decompress zx0 Mz5C1 to vram.color + 3072
      decompress zx0 Mz5P2 to vram.pattern + 5120
      decompress zx0 Mz5C2 to vram.color + 5120
    case 6
      decompress zx0 Mz6N to vram.name + 64
      decompress zx0 Mz6P0 to vram.pattern + 1024
      decompress zx0 Mz6C0 to vram.color + 1024
      decompress zx0 Mz6P1 to vram.pattern + 3072
      decompress zx0 Mz6C1 to vram.color + 3072
      decompress zx0 Mz6P2 to vram.pattern + 5120
      decompress zx0 Mz6C2 to vram.color + 5120
    case 7
      decompress zx0 Mz7N to vram.name + 64
      decompress zx0 Mz7P0 to vram.pattern + 1024
      decompress zx0 Mz7C0 to vram.color + 1024
      decompress zx0 Mz7P1 to vram.pattern + 3072
      decompress zx0 Mz7C1 to vram.color + 3072
      decompress zx0 Mz7P2 to vram.pattern + 5120
      decompress zx0 Mz7C2 to vram.color + 5120
  end select
  return
end sub

asm {
; XrScan: from mover Ti (below ScanEnd), the first live mover within 3 pixels
; across and 4 down of mover Ci: Ti = it and Hit = 1, else Ti = ScanEnd, Hit = 0
XrScan:
    ld a,(AMY_UVAR_Ci)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_SX
    add hl,de
    ld b,(hl)
    ld hl,AMY_UVAR_SY
    add hl,de
    ld c,(hl)
    ld a,(AMY_UVAR_Ti)
    ld e,a
XrScanL:
    ld a,(AMY_UVAR_ScanEnd)
    ld h,a
    ld a,e
    cp h
    jr nc,XrScanN
    ld hl,AMY_UVAR_MK
    add hl,de
    ld a,(hl)
    or a
    jr z,XrScanX
    ld hl,AMY_UVAR_SX
    add hl,de
    ld a,(hl)
    sub b
    jr nc,XrScan1
    neg
XrScan1:
    cp 4
    jr nc,XrScanX
    ld hl,AMY_UVAR_SY
    add hl,de
    ld a,(hl)
    sub c
    jr nc,XrScan2
    neg
XrScan2:
    cp 5
    jr nc,XrScanX
    ld a,e
    ld (AMY_UVAR_Ti),a
    ld a,1
    ld (AMY_UVAR_Hit),a
    ret
XrScanX:
    inc e
    jr XrScanL
XrScanN:
    ld a,(AMY_UVAR_ScanEnd)
    ld (AMY_UVAR_Ti),a
    xor a
    ld (AMY_UVAR_Hit),a
    ret
; XrClr / XrPoll: clear the NMI flag; wait until an NMI has set it
XrClr:
    xor a
    ld (NMI_FLAG),a
    ret
XrPoll:
    ld a,(NMI_FLAG)
    or a
    jr z,XrPoll
    ret
; XrLate: Late = 1 (it stays so until Frame2 clears it) when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
XrLate:
    in a,($BF)
    rlca
    and 1
    ld hl,AMY_UVAR_Late
    or (hl)
    ld (hl),a
    ret
XrShoot:
    db $40,$3E,$30,$01,$40,$56,$50,$01,$40,$7C,$60,$01,$50
XrZap:
    db $00,$00,$25,$02,$00,$00,$46,$03,$00,$00,$66,$04,$10
XrHit:
    db $00,$00,$14,$03,$00,$00,$35,$04,$00,$00,$56,$06,$00,$00,$77,$08,$10
XrShield:
    db $40,$BA,$20,$02,$40,$F9,$30,$02,$40,$75,$51,$03,$50
XrAppear:
    db $40,$75,$31,$02,$40,$0A,$31,$02,$40,$CF,$40,$02,$40,$A9,$40,$02,$40,$8F,$40,$02,$40,$7C,$40,$02
    db $40,$6E,$50,$02,$40,$62,$50,$02,$50
XrSpar:
    db $40,$71,$20,$02,$40,$55,$20,$02,$40,$47,$20,$02,$40,$39,$30,$04,$50
XrBounce:
    db $40,$FC,$21,$02,$40,$FE,$40,$03,$50
XrGulp:
    db $40,$53,$21,$03,$40,$FC,$21,$03,$40,$F9,$32,$03,$40,$F9,$43,$06,$50
XrDie:
    db $40,$AA,$10,$05,$40,$D6,$20,$05,$40,$FE,$20,$05,$40,$41,$21,$05,$40,$AB,$31,$0C,$50
XrLevel:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05,$40,$55,$20,$0E,$50
XrFaster:
    db $40,$6B,$30,$03,$40,$5F,$30,$03,$40,$55,$30,$03,$50
XrOver:
    db $40,$1D,$11,$0A,$40,$2E,$21,$0A,$40,$41,$21,$0A,$40,$53,$21,$0A,$40,$AB,$31,$1E,$50

XrSoundTable:
    dw XrTuneMel,$702B
    dw XrTuneBass,$7035
    dw XrShoot,$7049
    dw XrZap,$703F
    dw XrHit,$703F
    dw XrShield,$7049
    dw XrAppear,$7049
    dw XrSpar,$7049
    dw XrBounce,$7049
    dw XrGulp,$7049
    dw XrDie,$7049
    dw XrLevel,$7049
    dw XrFaster,$7049
    dw XrOver,$7049
; Rush Hour at the Crossroads (original)
; Tiny Sound, 7 frames per step
XrTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$23,$26,$2A,$26,$28,$25,$21,$01,$23,$26,$2A,$2F
    db $2D,$2A,$28,$01,$26,$23,$26,$2A,$2B,$2A,$28,$25,$26,$01,$23,$01
    db $22,$01,$1E,$01,$23,$26,$2A,$26,$28,$25,$21,$01,$23,$26,$2A,$2F
    db $31,$2F,$2E,$01,$2F,$2A,$26,$23,$25,$22,$1E,$01,$23,$01,$2A,$01
    db $2F,$01,$00,$01
    db $FF
XrTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$0B,$01,$12,$01,$09,$01,$10,$01,$0B,$01,$12,$01
    db $09,$01,$10,$01,$07,$01,$0E,$01,$10,$01,$0B,$01,$12,$01,$0D,$01
    db $12,$01,$0A,$01,$0B,$01,$12,$01,$09,$01,$10,$01,$0B,$01,$12,$01
    db $12,$01,$0A,$01,$07,$01,$0E,$01,$10,$01,$12,$01,$0B,$01,$12,$01
    db $0B,$01,$00,$01
    db $FF
}
