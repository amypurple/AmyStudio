' Native EOS file creation, write/readback, and deletion smoke test.
u8 CreateStatus = 255
u8 WriteStatus = 255
u8 ReadStatus = 255
u8 DeleteStatus = 255
u8 MissingStatus = 255
u8 SaveData[16]
u8 VerifyData[16]

SaveData[0] = $43
SaveData[1] = $52
SaveData[2] = $45
SaveData[3] = $41
SaveData[4] = $54
SaveData[5] = $45
SaveData[6] = $44
SaveData[7] = $20
SaveData[8] = $42
SaveData[9] = $59
SaveData[10] = $20
SaveData[11] = $41
SaveData[12] = $4D
SaveData[13] = $59
SaveData[14] = $21
SaveData[15] = $20

create "NEWSAVE" 1024 status CreateStatus
write "NEWSAVE" from SaveData count 16 status WriteStatus
VerifyData = read "NEWSAVE" count 16 status ReadStatus
delete "NEWSAVE" status DeleteStatus
VerifyData = read "NEWSAVE" count 16 status MissingStatus

loop forever
