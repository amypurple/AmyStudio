const HookMax = 12

' rope buffers used by the asm only, in the RAM Amy keeps for its own
' sprite table ($7090-$710F; this game writes its sprite table itself):
' frees 120 bytes of variable RAM for the stack
const RcKey = $7090
const OldKey = $70B0
const RcCol = $70D0
const OldBg = $70F8
' --- scroll / blit state (read by the asm) ---
u16 CamY = 0
u16 CamR = 0
u8 CamS = 0
u16 DrR = 0
u8 DrS = 255
u8 FullR = 1
u8 InPlay = 0
u8 PoolNow = PoolA
u8 Sat[49]
u8 ChkY = 0
u8 LnP = 0
u8 LnN = 0
u8 LnB[10]
' (phase 6) 1 while the hazards are added: a hazard that fits only without
' the gems, puff, drip and arrow (entries 7-10) is added and those near it
' are hidden (GpPrec)
u8 HzMode = 0
' exact tests left this frame (2; none with a rope line of 7+ cells: budget)
u8 PrecN = 0
u8 SatW = 0
u8 SatE = 0
u8 LastHY = 200
u8 ArrX = 0
u16 ArrY = 0
u16 LastCam = 0
u8 HzOdd = 0
u8 SpY = 0
u8 SpX = 0
u8 SpP = 0
u8 SpC = 0
u16 MapBase = 0
u16 MTp = 0
u16 MRp = 0
u8 RkLo = 0
u8 MapI = 0
u8 MOff = 0
u8 GOff = 0
u8 Boost = 0
' --- animation, effects ---
u8 FireT = 0
u8 LandT = 0
u8 PufT = 0
u8 PufX = 0
u16 PufY = 0
u8 PopT = 0
u8 PopX = 0
u8 PopP = 0
u8 PopC = 0
u16 PopY = 0
' (phase 6) up to 2 popups waiting: the next starts when the shown one has
' had 16 frames (catches come 16+ frames apart; a gem can come with one)
u8 PqN = 0
' (phase 6) the deepest gallery landed in this cave (+200 each new one)
u8 GBest = 0
u8 PqF = 0
u8 PqX = 0
u8 PqP = 0
u8 PqC = 0
u16 PqY = 0
u8 PrX = 0
u8 PrP = 0
u8 PrC = 0
u16 PrY = 0
u8 PkX = 0
u16 PkY = 0
u8 DrT = 0
u8 DrX = 0
u16 DrY = 0
u8 WaveP = 0
u8 WaveF = 0
u8 HitH = 0
u8 DieWhy = 0
u8 PopSnd = 0
' --- hazards (slots of the map: 2 a gallery) ---
' HzR: bat x (+0), bat direction (+12), stalactite state (+24: 0 hanging,
' 1-30 shaking, 31.. falling (drop FallT[state - 31]), then gone until it
' wraps to 0: hanging again)
u8 HzR[36]
u16 WaveO = 0
' --- title tune ---
u8 TzOn = 0
u16 TzLeft = 0
u8 TzSec = 0
' --- title scene (phase 5): swing frame, bat x / direction, sparkle clock ---
u8 TsT = 0
u8 TsBx = 16
u8 TsBd = 1
u8 TsG = 0
u8 TsA = 0
u8 TsB = 0
' --- rope cells (raster -> compose -> blit) ---
u8 R0X = 0
u8 R0Y = 0
u8 R1X = 0
u8 R1Y = 0
u8 RcN = 0
u8 RcBg[16]
u8 RcRaw[144]
u16 PatBase = 0
u16 ColPtr = 0
u8 GkI = 0
u8 GemNew = 0
u8 CRow = 0
u16 KeyP = 0
u16 BgP = 0
u16 PatP = 0
u8 SlowN = 0
u16 RKey = 0
u16 MP = 0
u8 SlowL[5]
u8 HudP = 0
u8 HSy = 0
u8 DidFull = 0
u8 HvyB = 0
u8 PgFH = $18
u16 BldBase = 0
u8 BldRow = 23
u8 HudW = 0
u8 CamF = 0
u8 HudBuf[28]
u8 DgI = 0
u8 DgN = 0
