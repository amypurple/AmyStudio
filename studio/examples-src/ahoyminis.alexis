asm {
; SkiDraw: SkCnt rows of the name table from ring row SkFrom (screen row
; SkFrom + 2) of RowA/RowB:
; tree edges in columns 0-2 and 29-31, snow specks (SnowPat from
; ((Wrow + row) x 11) & 31), a cluster of four trees at RowA (255 = the finish
; line), one tree at RowB. Writes are 30 cycles apart (display on).
SkiDraw:
    push ix
    ld a,(AMY_UVAR_SkFrom)
    ld e,a
    ld d,0
    ld ix,AMY_UVAR_RowA
    add ix,de
    ld l,e
    ld h,d
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1840
    add hl,de
    ex de,hl
    ld a,(AMY_UVAR_Wrow)
    ld hl,AMY_UVAR_SkFrom
    add a,(hl)
    ld c,a
    ld a,(AMY_UVAR_SkCnt)
    ld b,a
SkdRow:
    push bc
    push de
    ld hl,AMY_UVAR_RowBuf
    ld a,TEdge
    ld (hl),a
    inc hl
    ld (hl),a
    inc hl
    ld (hl),a
    inc hl
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,c
    add a,c
    add a,c
    and 31
    add a,3
    push hl
    ld hl,AMY_UDATA_SnowPat
    ld e,a
    ld d,0
    add hl,de
    pop de
    ld bc,26
    ldir
    ex de,hl
    ld a,TEdge
    ld (hl),a
    inc hl
    ld (hl),a
    inc hl
    ld (hl),a
    ld a,(ix+0)
    or a
    jr z,SkdB
    cp 255
    jr nz,SkdClu
    ld hl,AMY_UVAR_RowBuf+3
    ld b,26
SkdFin:
    ld (hl),TFin
    inc hl
    djnz SkdFin
    jr SkdB
SkdClu:
    ld hl,AMY_UVAR_RowBuf
    ld e,a
    ld d,0
    add hl,de
    ld a,TTree
    ld (hl),a
    inc hl
    ld (hl),a
    inc hl
    ld (hl),a
    inc hl
    ld (hl),a
SkdB:
    ld a,(ix+21)
    or a
    jr z,SkdOut
    ld hl,AMY_UVAR_RowBuf
    ld e,a
    ld d,0
    add hl,de
    ld (hl),TTree
SkdOut:
    pop de
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_RowBuf
    ld bc,$20BE
SkdByte:
    outi
    nop
    jp nz,SkdByte
    ld hl,32
    add hl,de
    ex de,hl
    inc ix
    pop bc
    inc c
    dec b
    jp nz,SkdRow
    pop ix
    ret
AmMove:
    db $40,$47,$30,$02,$50
AmOk:
    db $40,$6B,$20,$03,$40,$55,$20,$06,$50
AmBad:
    db $40,$3B,$12,$06,$40,$F9,$22,$0C,$50
AmCrash:
    db $00,$00,$04,$03,$00,$00,$25,$04,$00,$00,$36,$06,$00,$00,$66,$0A,$10
AmHit:
    db $40,$40,$10,$02,$40,$35,$30,$04,$50
AmBump:
    db $40,$1D,$31,$02,$50
AmStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0E,$50
AmOver:
    db $40,$D6,$10,$0C,$40,$F0,$20,$0C,$40,$1D,$21,$0C,$40,$AB,$21,$1E,$50
AmWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$55,$10,$08,$40,$47,$20,$1E
    db $50
AmDig0:
    db $40,$AB,$11,$0E,$40,$AB,$31,$06,$50
AmDig1:
    db $40,$7C,$11,$0E,$40,$7C,$31,$06,$50
AmDig2:
    db $40,$53,$11,$0E,$40,$53,$31,$06,$50
AmDig3:
    db $40,$41,$11,$0E,$40,$41,$31,$06,$50
AmDig4:
    db $40,$1D,$11,$0E,$40,$1D,$31,$06,$50
AmDig5:
    db $40,$FE,$10,$0E,$40,$FE,$30,$06,$50
AmDig6:
    db $40,$E2,$10,$0E,$40,$E2,$30,$06,$50
AmDig7:
    db $40,$D6,$10,$0E,$40,$D6,$30,$06,$50
AmDig8:
    db $40,$BF,$10,$0E,$40,$BF,$30,$06,$50
AmDig9:
    db $40,$AA,$10,$0E,$40,$AA,$30,$06,$50

AmSoundTable:
    dw AmTuneMel,$702B
    dw AmTuneBass,$7035
    dw AmMove,$7049
    dw AmOk,$7049
    dw AmBad,$7049
    dw AmCrash,$703F
    dw AmHit,$7049
    dw AmBump,$7049
    dw AmStart,$7049
    dw AmOver,$7049
    dw AmWin,$7049
    dw AmDig0,$7049
    dw AmDig1,$7049
    dw AmDig2,$7049
    dw AmDig3,$7049
    dw AmDig4,$7049
    dw AmDig5,$7049
    dw AmDig6,$7049
    dw AmDig7,$7049
    dw AmDig8,$7049
    dw AmDig9,$7049
; Four Bells (original)
; Tiny Sound, 8 frames per step
AmTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$25,$28,$01,$25,$26,$01,$23,$20,$01,$23
    db $21,$01,$25,$28,$01,$2D,$2A,$01,$26,$28,$01,$01,$01,$2A,$01,$26
    db $28,$01,$25,$26,$01,$23,$25,$01,$21,$23,$01,$20,$21,$01,$23,$25
    db $01,$23,$21,$01,$01,$01,$00,$01,$01
    db $FF
AmTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$09,$01,$10,$15,$01,$10,$0E,$01,$15,$10,$01,$17
    db $09,$01,$10,$15,$01,$10,$0E,$01,$15,$09,$01,$10,$01,$0E,$01,$15
    db $09,$01,$10,$0B,$01,$12,$10,$01,$17,$12,$01,$19,$10,$01,$17,$10
    db $01,$17,$09,$01,$01,$01,$00,$01,$01
    db $FF
}
