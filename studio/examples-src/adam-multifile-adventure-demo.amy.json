  "sourceText": "project \"ADAM MULTIFILE ADVENTURE LAB\"\ncartridge \"ADAM ADVENTURE LAB/AMY STUDIO/2026\"\n\n' Each embedded Amy file owns one subsystem. Open FILES to edit them independently.\ninclude amy \"@project/src/player.amy\"\ninclude amy \"@project/src/scenes.amy\"\ninclude amy \"@project/src/devices.amy\"\nifdef ROM_TEST_CHECKPOINTS\n  include amy \"@project/src/tests.amy\"\nend ifdef\n\nu8 LabChoice = 0\n\nifdef ROM_TEST_CHECKPOINTS\n  Lab_RunSelfTests()\nend ifdef\n\nmain_menu:\n  text screen\n  cls\n  print centered at 1, \"ADAM MULTIFILE LAB\"\n  print centered at 3, \"ONE PROJECT - FOUR SOURCES\"\n  print at 4,7, \"1  SPACE NAVIGATION\"\n  print at 4,10, \"2  RESCUE ENCOUNTER\"\n  print at 4,13, \"3  DEVICE CONSOLE\"\n  ifdef ROM_TEST_CHECKPOINTS\n    if LabTestsPassed = 4 then\n      print centered at 16, \"SELF TESTS 4/4\"\n    else\n      print centered at 16, \"SELF TEST FAILURE\"\n    end if\n  end ifdef\n  print centered at 18, \"SELECT 1-3\"\n  screen on\n  choose keypad 1 to 3 into LabChoice\n  wait key release\n\n  select case LabChoice\n  case 1\n    Pilot_Run()\n  case 2\n    Scene_Run()\n  case else\n    Devices_Run()\n  end select\n\n  pause until press\n  goto main_menu\n",
