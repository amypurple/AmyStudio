' Fixed32 divide lab: focused cases for /= verification.
fixed32 ByOne = 3.0
fixed32 ByTwo = 3.0
fixed32 ByHalf = 1.5
fixed32 ByNegTwo = 3.0
fixed32 NegByNegTwo = -3.0
fixed32 ByZero = 3.0
fixed32 ZeroDivisor = 0.0

' Amy Fixed32 Divide Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 5,0, "FIXED32 DIVIDE LAB"

  ByOne /= 1
  print at 1,3,  "3.00 / 1.00"
  print ByOne at 20,3

  ByTwo /= 2
  print at 1,5,  "3.00 / 2.00"
  print ByTwo at 20,5

  ByHalf /= 0.5
  print at 1,7,  "1.50 / 0.50"
  print ByHalf at 20,7

  ByNegTwo /= -2
  print at 1,9,  "3.00 / -2.00"
  print ByNegTwo at 20,9

  NegByNegTwo /= -2
  print at 1,11, "-3.00 / -2.00"
  print NegByNegTwo at 20,11

  ByZero /= ZeroDivisor
  print at 1,13, "3.00 / 0.00"
  print ByZero at 20,13

  print at 1,16, "EXPECTED"
  print at 10,16, "3 1.5 3 -1.5 1.5 0"
  return
