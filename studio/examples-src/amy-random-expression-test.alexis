project "Amy Random Expression Test"

u8 Value = 0
u8 Pass = 0
u16 WordDie = 0

text screen
print at 5,0, "RANDOM EXPRESSIONS"

Value = random(1, 8)
check_value(3, 2)
Value = random(1, 8)
check_value(5, 2)
Value = random(1, 8)
check_value(7, 4)
Value = random(1, 8)
check_value(9, 3)
Value = random(1, 8)
check_value(11, 7)
Value = random(1, 8)
check_value(13, 1)
Value = random(1, 8)
check_value(15, 7)
Value = random(1, 8)
check_value(17, 7)
WordDie = random(1, 8)
print at 1,19, "WORD"
print WordDie at 7,19 digits 5
if WordDie = 3 then
  Pass += 1
  print at 15,19, "PASS"
else
  print at 15,19, "FAIL"
end if

print at 1,22, "TOTAL"
print Pass at 7,22 digits 2
if Pass = 9 then print at 12,22, "PASS"

screen on

sub check_value(u8 Y, u8 Expected):
  print Value at 1,Y digits 3
  print Expected at 5,Y digits 3
  if Value = Expected then
    Pass += 1
    print at 10,Y, "PASS"
  else
    print at 10,Y, "FAIL"
  end if
  return