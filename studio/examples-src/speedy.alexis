cartridge "SPEEDY/KEVIN DEWEY/1985"

' SPEEDY
' A ColecoVision game based on "Speedy" by Kevin Dewey, Ahoy! June 1985
' (VIC-20, BASIC with a 54-byte machine-code joystick reader).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/speedy.bas), the game is built for the ColecoVision: a
' smooth two-colour sprite that glides from cell to cell, tiled gems,
' mines and crystal, sound effects and an original title tune.
'
' The game: Speedy stands in the middle of a field of 22 x 20 cells. Push
' the stick (eight directions) and Speedy runs, and keeps running in the
' last direction pushed: he never stops. Collect every green gem (7
' points each) to clear the screen; touch a mine and you lose a clone.
' The white crystal pays the gems collected so far on this screen times
' the skill level, so the later you take it the more it is worth. The
' field wraps around at its edges.
'
' From the original: the 22 x 20 field, the start in its middle standing
' still, eight directions with the run kept in the last one, one crystal,
' Z + 2 x skill mines and Z gems placed at random (in that order, so gems
' cover mines and mines the crystal; a gem dropped on a gem is not
' counted twice), Z = 5 on screen 1 and 5 more each screen, 7 points a
' gem, the crystal's bonus of gems x skill, 7 clones, a clone back for
' every cleared screen, a lost clone redraws the screen with the same
' number of gems and Speedy back in the middle, 50 points a screen reached
' added at the end, skill 1-15 chosen before the game, a high score.
'
' Liberties: the original runs at the speed of its BASIC loop; here a step
' takes 8 frames (7.5 cells a second, checked with a human-paced bot).
' The VIC screen wraps line to line (off the right edge onto the next
' row); here each edge wraps to the opposite one. The start cell is kept
' free (on the VIC a gem placed there was erased by Speedy and the screen
' could never be cleared). Gems per screen stop growing at 100 (the field
' would fill up; on the VIC the counts kept growing). The skill is chosen
' with the stick on the title instead of typed. Effects are short jingles
' instead of the VIC's held tones.
'
' Controls: either controller; the stick steers Speedy. On the title,
' left and right set the skill, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TFloor = 128
const TGem = 129
const TMine = 130
const TStar = 131
const TBlast = 132
const TWall = 133
const TBand = 134
const SFace = 0
const SFeat0 = 4
const SFeat1 = 8
const SFeat2 = 12
const SFeat3 = 16
const SFeat4 = 20
const SFeat5 = 24
const SFeat6 = 28
const SFeat7 = 32
const SFeat8 = 36
const SBoom = 40
const NTiles8 = 56
const SprBytes = 352
const SndTuneA = 1
const SndTuneB = 2
const SndGem = 3
const SndBonus = 4
const SndBoom = 5
const SndClear = 6
const SndStart = 7
const SndOver = 8
const SndTick = 9
const FC = 5
const FR = 2
const FW = 22
const FH = 20
const StartC = 11
const StartR = 10
const StepN = 8
const DeadN = 70
const ClearN = 100
const ZMax = 100
const NSpr = 4

' direction codes: vertical part (1 up, 2 down) + horizontal (3 left,
' 6 right); the moves in pixels (255 is -1)
data DXT bytes
  0, 0, 0, 255, 255, 255, 1, 1, 1
end data
data DYT bytes
  0, 255, 1, 0, 255, 1, 0, 255, 1
end data

record Runner:
  u8 C
  u8 R
  u8 X
  u8 Y
  u8 D
  u8 T
end record

Runner Me
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' Z gems this screen (before the cap), gems left, gems placed, the
' skill, clones, screen number
u8 Z = 5
u8 Left = 0
u8 Total = 0
u8 Ec = 5
u8 Clones = 7
u8 Scr = 1
u8 Mode = 0
u8 ModeT = 0
u8 Over = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 Pi = 0
u8 Bi = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SpSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: 50 points for every screen reached, the message, then back
  ' to the title on a press
  EndBonus
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  print at 9,10, "             "
  print at 9,11, "  GAME OVER  "
  print at 9,12, "             "
  print at 9,13, " BONUS       "
  NumU = Scr
  NumU = NumU * 50
  print at 16,13, digits$(NumU, 5)
  print at 9,14, "             "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if Mode = 1 then
    dec ModeT
    if ModeT = 0 then
      dec Clones
      if Clones = 0 then
        Over = 1
      else
        NewBoard
      end if
    end if
    return
  end if
  if Mode = 2 then
    dec ModeT
    if ModeT = 0 then
      inc Scr
      if Clones < 99 then inc Clones
      if Z < ZMax then Z = Z + 5
      NewBoard
    end if
    return
  end if
  if Me.T = 0 then
    K = StickDir
    if K > 0 then Me.D = K
    if Me.D > 0 then BeginStep
  end if
  if Me.T > 0 then
    D = Me.D
    Me.X = Me.X + DXT[D]
    Me.Y = Me.Y + DYT[D]
    dec Me.T
    if Me.T = 0 then Arrive
  end if
  return
end sub

' the stick as a direction code (0 when centred)
function StickDir as u8
  u8 Sd = 0
  u8 Bits = J1 | J2
  if Bits & 1 then Sd = 1
  if Bits & 2 then Sd = 2
  if Bits & 4 then Sd = Sd + 3
  if Bits & 8 then Sd = Sd + 6
  return Sd

' the next cell in Speedy's direction (wrapping round the field); the
' sprite starts one cell short of it, so it glides in from the edge
sub BeginStep:
  D = Me.D
  C = Me.C + DXT[D]
  R = Me.R + DYT[D]
  if C = 255 then C = FW - 1
  if C = FW then C = 0
  if R = 255 then R = FH - 1
  if R = FH then R = 0
  Me.C = C
  Me.R = R
  X = CellX(C)
  Y = CellY(R)
  V = DXT[D] << 3
  Me.X = X - V
  V = DYT[D] << 3
  Me.Y = Y - V
  Me.T = StepN
  return
end sub

function CellX(u8 Cc) as u8
  u8 Q = Cc + FC
  return Q << 3

function CellY(u8 Rr) as u8
  u8 Q = Rr + FR
  Q = Q << 3
  return Q - 1

' what Speedy finds on arriving in a cell
sub Arrive:
  X = Me.C + FC
  Y = Me.R + FR
  K = get char at X,Y
  select case K
  case TGem
    Score += 7
    put char TFloor at X,Y
    dec Left
    play sound SndGem
    if Left = 0 then
      Mode = 2
      ModeT = ClearN
      print at 9,11, "              "
      print at 9,12, " SCREEN CLEAR "
      print at 9,13, "              "
      play sound SndClear
    end if
    ShowHud
  case TMine
    Mode = 1
    ModeT = DeadN
    put char TBlast at X,Y
    play sound SndBoom
  case TStar
    put char TFloor at X,Y
    N = Total - Left
    AddBonus(N)
    play sound SndBonus
    ShowHud
  end select
  return
end sub

' the crystal: the gems collected on this screen times the skill
sub AddBonus(u8 Got):
  if Got > 0 then
    for Bi = 1 to Got
      Score += Ec
    next
  end if
  return
end sub

' the end: 50 for each screen reached
sub EndBonus:
  for Bi = 1 to Scr
    Score += 50
  next
  return
end sub

' a random number below N (N up to 255)
function Below(u8 Nn) as u8
  Rand
  W16 = Rs & 255
  W16 = W16 * Nn
  u8 Hb = W16 >> 8
  return Hb

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random cell of the field, never the start cell: C, R
sub PickCell:
  do
    C = Below(FW)
    R = Below(FH)
    if C <> StartC then exit do
    if R <> StartR then exit do
  loop
  X = C + FC
  Y = R + FR
  return
end sub

' a new screen: the crystal, Z + 2 x skill mines, Z gems; Speedy in the
' middle, standing
sub NewBoard:
  Rearm
  wait
  nmi off
  display off
  for Ri = FR to 21
    fill TFloor count FW at FC,Ri
  next
  PickCell
  put char TStar at X,Y
  N = Ec << 1
  N = N + Z
  for Pi = 1 to N
    PickCell
    put char TMine at X,Y
  next
  Total = 0
  for Pi = 1 to Z
    PickCell
    K = get char at X,Y
    if K <> TGem then inc Total
    put char TGem at X,Y
  next
  Left = Total
  Me.C = StartC
  Me.R = StartR
  Me.X = CellX(StartC)
  Me.Y = CellY(StartR)
  Me.D = 0
  Me.T = 0
  Mode = 0
  ModeT = 0
  ShowHud
  DrawSprites
  Rearm
  wait
  nmi off
  display on
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the features (looking where Speedy runs), 1 the face; the blast
' when a mine went off
sub DrawSprites:
  if TitleOn = 1 then
    V = Me.D
  else
    V = Me.D
    if Me.T = 0 then
      if Mode = 0 then V = 0
    end if
  end if
  if Mode = 1 then
    set sprite 0 to Me.Y,Me.X,SBoom,11
    set sprite 1 to 192,0,0,0
  else
    K = V << 2
    K = K + SFeat0
    set sprite 0 to Me.Y,Me.X,K,1
    set sprite 1 to Me.Y,Me.X,SFace,11
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print Score at 8,1
  print at 17,1, "HI"
  print Hi at 20,1
  print at 2,22, "CLONES"
  NumU = Clones
  print at 9,22, digits$(NumU, 2)
  print at 12,22, "GEMS"
  NumU = Left
  print at 17,22, digits$(NumU, 3)
  print at 21,22, "SCREEN"
  NumU = Scr
  print at 28,22, digits$(NumU, 2)
  return
end sub

sub DrawFrame:
  for Ri = FR to 21
    put char TWall at 4,Ri
    put char TWall at 27,Ri
  next
  return
end sub

sub NewGame:
  Score = 0
  Scr = 1
  Z = 5
  Clones = 7
  Over = 0
  TitleOn = 0
  NewScreen
  DrawFrame
  NewBoard
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: Speedy running along the band, the skill, START / CREDITS
sub TitlePage:
  NewScreen
  fill TBand count 28 at 2,4
  fill TBand count 28 at 2,9
  print at 13,6, "SPEEDY"
  print at 9,7, "BY KEVIN DEWEY"
  print at 10,12, "SKILL  <    >"
  print at 10,15, "START GAME"
  print at 10,16, "CREDITS"
  print at 8,18, "AHOY! JUNE 1985"
  print at 2,1, "HI"
  print Hi at 5,1
  put char TGem at 7,21
  print at 9,21, "7"
  put char TStar at 12,21
  print at 14,21, "BONUS"
  put char TMine at 21,21
  print at 23,21, "MINE"
  ShowSkill
  ShowMenu
  TitleOn = 1
  Me.X = 24
  Me.Y = 39
  Me.D = 6
  Me.T = 0
  Mode = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleRun
  DrawSprites
  V = J1 | J2
  V = V & 15
  if V > 0 then
    if WasStick = 0 then
      TitleStick
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub TitleStick:
  select case V
  case 1
    Menu = 0
  case 2
    Menu = 1
  case 4
    if Ec > 1 then dec Ec
    play sound SndTick
  case 8
    if Ec < 15 then inc Ec
    play sound SndTick
  end select
  ShowSkill
  ShowMenu
  return
end sub

' Speedy runs right along the top band, down, back left on the lower one
sub TitleRun:
  select case Me.D
  case 6
    inc Me.X
    if Me.X >= 224 then Me.D = 2
  case 2
    inc Me.Y
    if Me.Y >= 79 then Me.D = 3
  case 3
    dec Me.X
    if Me.X <= 24 then Me.D = 1
  case 1
    dec Me.Y
    if Me.Y <= 39 then Me.D = 6
  end select
  return
end sub

sub ShowSkill:
  NumU = Ec
  print at 19,12, digits$(NumU, 2)
  return
end sub

sub ShowMenu:
  put char 32 at 8,15
  put char 32 at 8,16
  J = Menu + 15
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "SPEEDY"
  print at 2,5, "BASED ON SPEEDY BY"
  print at 2,6, "KEVIN DEWEY, AHOY! JUNE"
  print at 2,7, "1985 (VIC-20)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: QUICK FEET"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$80
  $00,$C3,$81,$00,$81,$C3,$18,$80
  $10,$A5,$C3,$18,$81,$C3,$A5,$10
  $10,$38,$83,$01,$81,$C3,$18,$80
  $89,$52,$C3,$18,$C3,$C3,$4A,$91
  $00,$81,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
