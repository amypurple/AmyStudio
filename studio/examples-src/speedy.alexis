asm {
SpGem:
    db $40,$47,$20,$02,$40,$35,$30,$03,$50
SpBonus:
    db $40,$6B,$10,$03,$40,$55,$10,$03,$40,$47,$10,$03,$40,$35,$10,$03,$40,$2A,$20,$08,$50
SpBoom:
    db $00,$00,$04,$04,$00,$00,$15,$06,$00,$00,$36,$0A,$00,$00,$66,$10,$10
SpClear:
    db $40,$8F,$10,$06,$40,$71,$10,$06,$40,$5F,$10,$06,$40,$47,$10,$06,$40,$5F,$20,$06,$40,$47,$20,$18
    db $50
SpStart:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$0C,$50
SpOver:
    db $40,$E2,$10,$0C,$40,$FE,$20,$0C,$40,$1D,$21,$0C,$40,$53,$21,$24,$50
SpTick:
    db $40,$7F,$40,$02,$50

SpSoundTable:
    dw SpTuneMel,$702B
    dw SpTuneBass,$7035
    dw SpGem,$7049
    dw SpBonus,$7049
    dw SpBoom,$703F
    dw SpClear,$7049
    dw SpStart,$7049
    dw SpOver,$7049
    dw SpTick,$7049
; Quick Feet (original)
; Tiny Sound, 7 frames per step
SpTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$1F,$23,$26,$23,$1F,$01,$1A,$01,$1C,$1F,$24,$1F
    db $1C,$01,$01,$01,$1E,$21,$26,$21,$1E,$01,$1A,$01,$1F,$23,$26,$2B
    db $26,$01,$01,$01,$28,$01,$26,$01,$24,$23,$21,$01,$26,$01,$24,$01
    db $23,$21,$1F,$01,$21,$23,$24,$21,$26,$01,$1A,$01,$1F,$01,$23,$01
    db $1F,$01,$00,$01
    db $FF
SpTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$07,$01,$0E,$01
    db $13,$01,$0E,$01,$0C,$01,$13,$01,$0C,$01,$10,$01,$0E,$01,$15,$01
    db $0E,$01,$12,$01,$0E,$01,$12,$01,$0E,$01,$12,$01,$07,$01,$0E,$01
    db $07,$01,$00,$01
    db $FF
}
