project "2D ARRAY SELF-TEST"
memory "colecovision_legacy_sdcc"

u8 Board[4,5]
u16 Words[2,3]
u8 Row = 2
u8 Column = 3
u8 Passed = 0

sub start:
  text screen
  backdrop dark blue
  print centered at 5, "2D ARRAY SELF-TEST"

  Board[0,0] = 11
  Board[Row,Column] = 42
  Board[Row-1,Column+1] = 77
  Words[1,2] = $1234

  if Board[0,0] = 11 then Passed += 1
  if Board[Row,Column] = 42 then Passed += 1
  if Board[Row-1,Column+1] = 77 then Passed += 1
  if Words[1,2] = $1234 then Passed += 1

  if Passed = 4 then
    print centered at 10, "ROW-MAJOR TEST PASS"
  else
    print centered at 10, "ROW-MAJOR TEST FAIL"
  end if
  screen on
  loop forever
end sub
