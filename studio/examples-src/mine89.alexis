    db $40,$50,$30,$01,$40,$66,$40,$01,$40,$7C,$50,$01,$40,$A0,$70,$01,$40,$C8,$80,$01,$50
MsPop:
    db $00,$00,$15,$03,$00,$00,$36,$03,$00,$00,$66,$04,$00,$00,$97,$04,$10
MsRasp:
    db $40,$6D,$22,$02,$40,$EA,$32,$02,$40,$6D,$42,$02,$50
MsBoom:
    db $00,$00,$06,$05,$00,$00,$16,$05,$00,$00,$26,$05,$00,$00,$36,$05,$00,$00,$46,$05,$00,$00,$56,$05
    db $00,$00,$67,$05,$00,$00,$77,$05,$00,$00,$87,$05,$00,$00,$97,$05,$00,$00,$A7,$05,$00,$00,$B7,$05
    db $10
MsTick:
    db $40,$55,$30,$02,$40,$71,$70,$01,$50
MsReady:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$30,$0A,$50
MsClear:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$06,$40,$8F,$30,$10,$50
MsOver:
    db $40,$1D,$11,$0A,$40,$2E,$21,$0A,$40,$53,$21,$0A,$40,$7C,$21,$0A,$40,$3B,$32,$1E,$50

MsSoundTable:
    dw MsTuneMel,$702B
    dw MsTuneBass,$7035
    dw MsZap,$7049
    dw MsPop,$703F
    dw MsRasp,$7049
    dw MsBoom,$703F
    dw MsTick,$7049
    dw MsReady,$7049
    dw MsClear,$7049
    dw MsOver,$7049
; Sector Patrol (original)
; Tiny Sound, 8 frames per step
MsTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1C,$01,$1F,$01,$23,$01,$28,$01,$26,$01,$23,$01
    db $21,$01,$01,$01,$1F,$01,$21,$01,$23,$01,$26,$01,$01,$01,$23,$01
    db $24,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1A,$01,$1E,$01,$21,$01
