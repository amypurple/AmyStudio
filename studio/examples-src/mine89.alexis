' a mine: kind 0 seeker, 1 dart, 2 drifter (one slot each)
record Mine:
  u8 X
  u8 Y
  u8 St
  u8 Dir
  u8 T
  u8 Cool
end record

Mine M[3]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Addr = 0
u16 Clock = 0
bcd digits 4 Score = 0
' the ship
u8 Py = 0
u8 Face = 0
u8 Turn = 0
u8 Off = 0
u8 ScrT = 0
u8 Moved = 0
u8 Lives = 0
u8 Fifty = 0
u8 Dead = 0
u8 Over = 0
u8 Won = 0
u8 Sector = 0
u8 Phase = 0
' the shot
u8 ShOn = 0
u8 ShX = 0
u8 ShY = 0
u8 ShDir = 0
u8 ShOld = 0
' the mine layer and its bolt
u8 BOn = 0
u8 BY = 0
u8 BDir = 0
u8 BHits = 0
u8 BFlash = 0
u8 BoltOn = 0
u8 BoltX = 0
u8 BoltY = 0
u8 Kills = 0
u8 Crash = 0
u8 Busy = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 S = 0
u8 Rr = 0
u8 Li = 0
u8 Lq = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 Res = 0
u8 Spare = 0

  tile screen
  set sound table MsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawFrame
  if Over = 0 then goto play_loop

  mute all
  if Won = 1 then
    Finale
  else
    print at 10,11, "GAME OVER..."
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  Moved = 0
  Crash = 0
  if Dead > 0 then
    DeadStep
    return
  end if
  MoveShip
  ScrollStep
  ShotStep
  if ShOn = 1 then ShotHits
  if BHits >= BossHP then
    LayerDown
    return
  end if
  Spawn
  for S = 0 to 2
    MoveMine(S)
  next
  if BOn = 1 then LayerStep
  if ShipHit() = 1 then
    Die
    return
  end if
  inc Clock
  return
end sub

' the stick: up/down 2 pixels a frame, left/right turn the ship
sub MoveShip:
  K = J1 & 3
  select case K
    case 1
      if Py >= PyMin + 2 then Py = Py - 2
    case 2
      if Py <= PyMax - 2 then Py = Py + 2
  end select
  if Turn > 0 then dec Turn
  K = J1 & 12
  if K = 4 then
    if Face = 1 then
      Face = 0
      Turn = TurnF
    end if
  end if
  if K = 8 then
    if Face = 0 then
      Face = 1
      Turn = TurnF
    end if
  end if
  return
end sub

' the ground moves a column every ScrollF frames, the way the ship faces
sub ScrollStep:
  inc ScrT
  if ScrT < ScrollF then return
  ScrT = 0
  if Face = 1 then
    inc Off
  else
    dec Off
  end if
  Moved = 1
  return
end sub

' fire (held fires again) when no shot is out and the ship is not turning
sub ShotStep:
  if ShOn = 1 then
    ShOld = ShX
    if ShDir = 1 then
      if ShX > 224 - ShotSp then
        ShOn = 0
      else
        ShX = ShX + ShotSp
      end if
    else
      if ShX < 16 + ShotSp then
        ShOn = 0
      else
        ShX = ShX - ShotSp
      end if
    end if
    return
  end if
  if Btn = 0 then return
  if Turn > 0 then return
  ShOn = 1
  ShDir = Face
  ShY = Py
  if Face = 1 then
    ShX = ShipX + 14
  else
    ShX = ShipX - 14
  end if
  ShOld = ShX
  play sound SndZap
  return
end sub

' the shot's box (x+2..x+13 over the step just made, y+7..y+8) against the
' live mines and the layer
sub ShotHits:
  u8 Lo = 0, Hi = 0, Mx = 0, My = 0, Top = 0, Bot = 0
  if ShX < ShOld then
    Lo = ShX + 2
    Hi = ShOld + 13
  else
    Lo = ShOld + 2
    Hi = ShX + 13
  end if
  for S = 0 to 2
    if M[S].St = 1 then
      Mx = M[S].X
      My = M[S].Y
      Top = My + BoxTop(S)
      Bot = My + BoxBot(S)
      if Hi >= Mx + 2 then
        if Lo <= Mx + 13 then
          if ShY + 8 >= Top then
            if ShY + 7 <= Bot then
              M[S].St = 2
              M[S].T = 12
              ShOn = 0
              inc Kills
              play sound SndPop
              AddPoint
              return
            end if
          end if
        end if
      end if
    end if
  next
  if BOn = 0 then return
  if Hi < BossX + 1 then return
  if ShY + 8 < BY + 1 then return
  if ShY + 7 > BY + 14 then return
  ShOn = 0
  inc BHits
  BFlash = 4
  play sound SndRasp
  ShowGauge
  return
end sub

' each mine's box, top and bottom rows (x+2..x+13 for all)
function BoxTop(u8 Kind) as u8
  select case Kind
    case 0
      return 3
    case 1
      return 5
  end select
  return 3

function BoxBot(u8 Kind) as u8
  if Kind = 1 then return 9
  return 11

' new mines (phase 0); the clock ends the mines (phase 1); the layer
' comes out when the field is clear (phase 2)
sub Spawn:
  if Phase = 0 then
    if Clock >= ClockBoss then Phase = 1
  end if
  if Phase = 1 then
    Res = M[0].St | M[1].St
    Res = Res | M[2].St
    if Res = 0 then
      Phase = 2
      BOn = 1
      BY = BossTop
      BDir = 0
      BHits = 0
      BFlash = 0
      BoltOn = 0
      ShowGauge
    end if
    return
  end if
  if Phase = 2 then return
  for S = 0 to 2
    if M[S].St = 0 then
      if M[S].Cool > 0 then
        M[S].Cool = M[S].Cool - 1
      else
        Rand
        V = highbyte Rs
        if InRange(S, V) = 1 then Launch(S)
      end if
    end if
  next
  return
end sub

' the noise ranges of the C64 ($0F3C): seeker < $40, dart $40-$8F,
' drifter $90-$EF
function InRange(u8 Kind, u8 R) as u8
  select case Kind
    case 0
      if R < $40 then return 1
    case 1
      if R >= $40 then
        if R < $90 then return 1
      end if
    case else
      if R >= $90 then
        if R < $F0 then return 1
      end if
  end select
  return 0

sub Launch(u8 Kind)
  u8 D = 0
  D = lowbyte Rs
  D = D & 1
  M[Kind].Dir = D
  M[Kind].St = 1
  if D = 0 then
    M[Kind].X = 16
  else
    M[Kind].X = 224
  end if
  select case Kind
    case 0
      M[Kind].Y = 68
    case 1
      if Py >= PyMin + 2 then
        M[Kind].Y = Py - 2
      else
        M[Kind].Y = Py + 2
      end if
    case else
      M[Kind].Y = Wave[M[Kind].X]
  end select
  return
end sub

' one mine: Dir 0 moves right, 1 left; explosions count down
sub MoveMine(u8 Kind)
  u8 X = 0, Sp = 0, Y = 0
  if M[Kind].St = 0 then return
  if M[Kind].St = 2 then
    M[Kind].T = M[Kind].T - 1
    if M[Kind].T = 0 then FreeMine(Kind)
    return
  end if
  X = M[Kind].X
  Y = M[Kind].Y
  Sp = MineSpeed(Kind)
  if M[Kind].Dir = 0 then
    X = X + Sp
    if X > 224 then
      FreeMine(Kind)
      return
    end if
  else
    if X < 16 + Sp then
      FreeMine(Kind)
      return
    end if
    X = X - Sp
  end if
  M[Kind].X = X
  if Kind = 0 then
    if Y < Py then inc Y
    if Y > Py then dec Y
  end if
  if Kind = 2 then Y = Wave[X]
  M[Kind].Y = Y
  return
end sub

function MineSpeed(u8 Kind) as u8
  select case Kind
    case 0
      return 2
    case 1
      return 4
  end select
  return 1

sub FreeMine(u8 Kind)
  M[Kind].St = 0
  M[Kind].Cool = CoolF
  M[Kind].Y = Hidden
  return
end sub

' the layer rises and falls 2 a frame; its bolt flies left 6 a frame
sub LayerStep:
  if BDir = 0 then
    BY = BY + 2
    if BY >= BossBot then BDir = 1
  else
    BY = BY - 2
    if BY <= BossTop then BDir = 0
  end if
  if BFlash > 0 then dec BFlash
  if BoltOn = 1 then
    if BoltX < 16 + BoltSp then
      BoltOn = 0
    else
      BoltX = BoltX - BoltSp
    end if
  else
    BoltOn = 1
    BoltX = BossX - 16
    BoltY = BY + 1
  end if
  return
end sub

' 1 when the ship (x 121..134, y+5..y+11) meets a live mine, the bolt or
' the ground
function ShipHit as u8
  u8 Top = 0, Bot = 0, Mx = 0, My = 0
  Top = Py + 5
  Bot = Py + 11
  for S = 0 to 2
    if M[S].St = 1 then
      Mx = M[S].X
      My = M[S].Y
      if Mx + 13 >= ShipX + 1 then
        if Mx + 2 <= ShipX + 14 then
          if Bot >= My + BoxTop(S) then
            if Top <= My + BoxBot(S) then
              Crash = S + 1
              return 1
            end if
          end if
        end if
      end if
    end if
  next
  if BoltOn = 1 then
    if BoltX + 14 >= ShipX + 1 then
      if BoltX + 1 <= ShipX + 14 then
        if Bot >= BoltY + 6 then
          if Top <= BoltY + 9 then
            Crash = 4
            return 1
          end if
        end if
      end if
    end if
  end if
  if Bot < 152 then return 0
  if Ground(Top, Bot) = 1 then
    Crash = 5
    return 1
  end if
  return 0

' the ground rows 19-22 under the ship's columns 15 and 16
function Ground(u8 Top, u8 Bot) as u8
  u8 R = 0, Y = 0, I = 0, Hit = 0
  I = Off + 13
  for R = 0 to 3
    Y = R * 8 + 152
    if Bot >= Y then
      if Top <= Y + 7 then
        Hit = Solid(R, I)
        if Hit = 0 then Hit = Solid(R, I + 1)
        if Hit = 1 then return 1
      end if
    end if
  next
  return 0

function Solid(u8 Row, u8 Col) as u8
  select case Row
    case 0
      return SolR0[Col]
    case 1
      return SolR1[Col]
    case 2
      return SolR2[Col]
  end select
  return SolR3[Col]

sub Die:
  Dead = DeadF
  dec Lives
  ShOn = 0
  play sound SndBoom
  return
end sub

' the ship's blast, then GET READY..., then the next ship (the clock keeps
' its 256-frame steps)
sub DeadStep:
  dec Dead
  if Dead = 60 then
    ClearField
    print at 10,11, "GET READY..."
    play sound SndReady
  end if
  if Dead > 0 then return
  if Lives = 0 then
    Over = 1
    return
  end if
  print at 10,11, "            "
  Clock = Clock & $FF00
  StartShip
  ShowLives
  return
end sub

sub ClearField:
  for S = 0 to 2
    M[S].St = 0
    M[S].Cool = CoolF
    M[S].Y = Hidden
  next
  ShOn = 0
  BOn = 0
  BoltOn = 0
  BHits = 0
  if Phase = 2 then HideGauge
  Phase = 0
  return
end sub

sub StartShip:
  Py = PyStart
  Face = 1
  Turn = 0
  ScrT = 0
  return
end sub

' one point; a ship more at every multiple of 50
sub AddPoint:
  Score += 1
  inc Fifty
  if Fifty = 50 then
    Fifty = 0
    inc Lives
    ShowLives
  end if
  ShowScore
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' the layer is destroyed: its blast, 15 points counted up, the message, the
' next sector (or the finale after the fifth)
sub LayerDown:
  Busy = 1
  BoltOn = 0
  ShOn = 0
  play sound SndBoom
  for Lq = 0 to 39
    Frame1
    DrawLayerBlast
  next
  BOn = 0
  HideGauge
  DrawSprites
  for Lq = 1 to 15
    Frame1
    Frame1
    Frame1
    Frame1
    AddPoint
    play sound SndTick
  next
  print at 7,10, "NICE BLASTING -"
  print at 7,11, "SECTOR CLEARED!"
  play sound SndClear
  for Lq = 0 to 119
    Frame1
  next
  print at 7,10, "               "
  print at 7,11, "               "
  inc Sector
  if Sector = 5 then
    Won = 1
    Over = 1
    return
  end if
  NewSector
  return
end sub

sub DrawLayerBlast:
  K = SEx0
  if Lq >= 8 then K = SEx1
  V = Lq & 4
  J = 11
  if V > 0 then J = 9
  set sprite 5 to BY,BossX,K,J
  set sprite 6 to BY,BossX + 16,K,J
  set sprite 7 to Hidden,0,SBolt,0
  update sprites
  return
end sub

' all five sectors: the bonus counted up
sub Finale:
  print at 8,8, "GREAT GOING!!!"
  print at 4,10, "ALL SECTORS CLEARED!!!"
  print at 5,12, "100 POINTS BONUS..."
  for Lq = 1 to 100
    Frame1
    Frame1
    AddPoint
    play sound SndTick
  next
  print at 6,14, "GAME COMPLETED!!!"
  play sound SndClear
  return
end sub

' ---------------------------------------------------------------------------
' drawing
sub DrawFrame:
  if Moved = 1 then DrawGround
  DrawSprites
  return
end sub

sub DrawGround:
  copy MapR0 + Off count 28 to vram.name + 610
  copy MapR1 + Off count 28 to vram.name + 642
  copy MapR2 + Off count 28 to vram.name + 674
  copy MapR3 + Off count 28 to vram.name + 706
  return
end sub

' 0 ship, 1 shot, 2-4 mines, 5-6 layer, 7 bolt
sub DrawSprites:
  if Over = 1 then
    set sprite 0 to Hidden,0,0,0
  else if Dead > 0 then
    if Dead > 60 then
      K = SEx1
      if Dead > 84 then K = SEx0
      set sprite 0 to Py,ShipX,K,11
    else
      set sprite 0 to Hidden,0,0,0
    end if
  else
    K = SShipl
    if Face = 1 then K = SShipr
    if Turn > 0 then K = SShipm
    set sprite 0 to Py,ShipX,K,15
  end if
  if ShOn = 1 then
    set sprite 1 to ShY,ShX,SShot,11
  else
    set sprite 1 to Hidden,0,SShot,0
  end if
  for S = 0 to 2
    DrawMine(S)
  next
  if BOn = 1 then
    J = 13
    if BFlash > 0 then J = 15
    set sprite 5 to BY,BossX,SLayl,J
    set sprite 6 to BY,BossX + 16,SLayr,J
  else
    set sprite 5 to Hidden,0,SLayl,0
    set sprite 6 to Hidden,0,SLayr,0
  end if
  if BoltOn = 1 then
    set sprite 7 to BoltY,BoltX,SBolt,9
  else
    set sprite 7 to Hidden,0,SBolt,0
  end if
  update sprites
  return
end sub

sub DrawMine(u8 Kind)
  u8 P = 0, C = 0, Spr = 0, Mx = 0, My = 0
  Spr = Kind + 2
  ' the fields go through locals: `set sprite` with a record field as Y
  ' loses the pattern and colour (Amy bug, work/codex-bugs/repros/
  ' mine89-set-sprite-record-field-y.alexis)
  Mx = M[Kind].X
  My = M[Kind].Y
  select case M[Kind].St
    case 0
      set sprite Spr to Hidden,0,0,0
      return
    case 2
      P = SEx1
      if M[Kind].T > 6 then P = SEx0
      C = 11
    case else
      select case Kind
        case 0
          P = SMina
          C = 8
        case 1
          P = SMinb
          C = 3
        case else
          P = SMinc
          C = 13
      end select
  end select
  set sprite Spr to My,Mx,P,C
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

' spare ships (up to 7) at the right of the status line
sub ShowLives:
  fill 32 count 7 at 22,1
  if Lives < 2 then return
  Spare = Lives - 1
  if Spare > 7 then Spare = 7
  for Li = 1 to Spare
    put char TLife at 21 + Li,1
  next
  return
end sub

' the layer's gauge: one box a hit left
sub ShowGauge:
  print at 2,2, "LAYER"
  fill TBar count 1 at 7,2
  for Li = 0 to 5
    if Li < BHits then
      put char TNohit at 8 + Li,2
    else
      put char THit at 8 + Li,2
    end if
  next
  return
end sub

sub HideGauge:
  fill TBar count 12 at 2,2
  return
end sub

sub GroundColours:
  select case Sector
    case 0
      copy GroundCol0 count NGround8 to vram.color + 1064
    case 1
      copy GroundCol1 count NGround8 to vram.color + 1064
    case 2
      copy GroundCol2 count NGround8 to vram.color + 1064
    case 3
      copy GroundCol3 count NGround8 to vram.color + 1064
    case else
      copy GroundCol4 count NGround8 to vram.color + 1064
  end select
  return
end sub

' the sector's start: its colours, a clear field, its number shown
sub NewSector:
  Busy = 1
  Rearm
  wait
  nmi off
  GroundColours
  ClearField
  Clock = 0
  StartShip
  print at 13,1, "SECTOR "
  V = Sector + 49
  put char V at 20,1
  print at 11,11, "SECTOR "
  put char V at 18,11
  DrawGround
  DrawSprites
  play sound SndReady
  for Li = 0 to 59
    Frame1
  next
  print at 11,11, "        "
  Busy = 0
  return
end sub

sub NewGame:
  NewScreen
  print at 2,1, "SCORE"
  HideGauge
  fill TBar count 16 at 14,2
  Score = 0
  Fifty = 0
  Lives = 9
  Dead = 0
  Over = 0
  Won = 0
  Sector = 0
  Kills = 0
  Off = 0
  ShowScore
  ShowLives
  ShowScreen
  Rearm
  wait no fire
  nmi off
  NewSector
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker on
  for J = 0 to 7
    set sprite J to Hidden,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy GroundPat count NGround8 to vram.pattern + 1064
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy GroundPat count NGround8 to vram.pattern + 3112
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy GroundPat count NGround8 to vram.pattern + 5160
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: MINE SWEEPER in steel plates, the ground scrolling under the
' ship, START / CREDITS, the tune once
sub TitlePage:
  NewScreen
  Sector = 0
  GroundColours
  print at 2,1, "COMPUTE!'S GAZETTE JULY 1989"
  copy TitleMap count 352 to vram.name + 64
  print at 8,13, "BY BEN CAMPBELL"
  print at 13,15, "START"
  print at 13,16, "CREDITS"
  ShowMenu
  Off = 0
  DrawGround
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the ground drifts under a ship on the title
sub TitleAnim:
  K = Tick & 7
  if K = 0 then
    inc Off
    DrawGround
  end if
  set sprite 0 to 134,ShipX,SShipr,15
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,15
  put char 32 at 11,16
  J = Menu + 15
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "MINESWEEPER"
  print at 2,5, "BASED ON MINESWEEPER BY"
  print at 2,6, "BEN CAMPBELL, COMPUTE!'S"
  print at 2,7, "GAZETTE, JULY 1989"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: SECTOR PATROL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
