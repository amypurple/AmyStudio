MsTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$10,$01,$17,$01,$10,$01,$17,$01,$13,$01,$1A,$01
    db $13,$01,$1A,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$13,$01,$1A,$01
    db $13,$01,$1A,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$0B,$01,$0F,$01,$10,$01,$01,$01
    db $0B,$01,$00,$01
