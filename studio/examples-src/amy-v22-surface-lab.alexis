u8 Tile = $41
u8 Row[8]
u8 FrameBuf[16]

  text screen
  print at 2,2, "AMY v2.2 SURFACE"
  print at 2,4, "T:" + str$(Tile)
  put char Tile at 5,6
  Tile = get char at 5,6
  print at 2,8, "R:" + str$(Tile)
  Row = get count 8 at 0,2
  put Row count 8 at 0,10
  FrameBuf = get frame size 8,2 at 0,2
  put FrameBuf frame size 8,2 at 0,12
  screen on