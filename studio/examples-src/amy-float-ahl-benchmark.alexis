' Creative Computing / Ahl benchmark using AMY fp5.
fp5 A = 0, R = 0, S = 0
fp5 Accuracy = 0, Randomness = 0
fp5 Work = 0, RndStep = 0
u16 N = 0, I = 0

  text screen
  print at 5,1, "AHL FP5 BENCHMARK"

  for N = 1 to 100
    A = N
    for I = 1 to 10
      A = sqrt(A)
      RndStep = random()
      R += RndStep
    next
    for I = 1 to 10
      A *= A
      RndStep = random()
      R += RndStep
    next
    S += A
  next

  Work = S
  Work /= 5
  Accuracy = 1010
  Accuracy -= Work
  Accuracy = abs(Accuracy)

  Randomness = 1000
  Randomness -= R
  Randomness = abs(Randomness)

  print at 1,4,  "ACCURACY"
  print Accuracy at 12,4
  print at 1,7,  "RANDOM"
  print Randomness at 12,7
  print at 1,10, "SUM S"
  print S at 12,10
  print at 1,13, "R TOTAL"
  print R at 12,13
  screen on