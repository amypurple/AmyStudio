' Encounter subsystem: original text inspired by ADAM adventure structures.
sub Scene_Run:
  cls
  print centered at 2, "RESCUE ENCOUNTER"
  print at 2,6, "THE STATION IS DARK."
  print at 2,8, "A SIGNAL FLASHES BELOW."
  print at 2,11, "OBJECTIVE: FIND THE CREW"
  print at 2,13, "THEN RETURN TO THE SHIP."
  print centered at 18, "PRESS FIRE"
  return
end sub
