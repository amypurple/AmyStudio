; The Keeper's Waltz, A minor (original for this game)
; Tiny Sound, 8 frames per step
LhTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$31,$88,$23,$00,$00,$28,$00,$2B,$AA,$00,$00,$00,$00,$00
    db $28,$00,$00,$23,$00,$26,$A4,$00,$00,$00,$00,$00,$21,$00,$00,$24
    db $00,$28,$26,$00,$00,$23,$00,$1F,$A1,$00,$00,$00,$00,$00,$A3,$00
    db $00,$00,$00,$00,$23,$00,$00,$28,$00,$2B,$AF,$00,$00,$00,$00,$00
    db $2D,$00,$00,$2B,$00,$2A,$2B,$00,$00,$28,$00,$00,$2A,$00,$00,$27
    db $00,$23,$A8,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
    db $FF
LhTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$70,$F1,$22,$10,$00,$00,$17,$00,$00,$10,$00,$00,$17,$00,$00
    db $0C,$00,$00,$13,$00,$00,$09,$00,$00,$10,$00,$00,$09,$00,$00,$10
    db $00,$00,$0E,$00,$00,$15,$00,$00,$07,$00,$00,$0E,$00,$00,$0B,$00
    db $00,$12,$00,$00,$10,$00,$00,$17,$00,$00,$07,$00,$00,$0E,$00,$00
    db $09,$00,$00,$10,$00,$00,$0C,$00,$00,$13,$00,$00,$0B,$00,$00,$12
    db $00,$00,$10,$00,$00,$17,$00,$00,$10,$00,$00,$00,$00,$00
    db $FF
LhSong:
    dw $0001
    db $40+8,9
    dw $0000
; LIGHTHOUSE's beam: BeamRay draws ray LhRay (0-96) lit (LhMode 1) or puts
; it back (LhMode 0). Each cell's tile is the scene's (or fog, inside the
; fog bank), swapped for its lit twin when lit.
BeamRay:
    ld a,(AMY_UVAR_LhRay)
    cp 97
    ret nc
    ld l,a
    ld h,0
    ld de,AMY_UDATA_RayN
    add hl,de
    ld a,(hl)
    or a
    ret z
    ld b,a
    ld a,(AMY_UVAR_LhRay)
    ld l,a
    ld h,0
    add hl,hl
    ld de,AMY_UDATA_RayOff
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    add hl,hl
    ld de,LhRayCells
    add hl,de
BrLoop:
    push bc
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ; the scene's tile
    ld hl,AMY_UDATA_Scene
    add hl,de
    ld c,(hl)
    ; in the fog bank? (row - FogR < 4 and (col - FogX) & 31 < 8)
    ld a,(AMY_UVAR_FogOn)
    or a
    jr z,BrNoFog
    ld a,e
    and 31
    ld b,a
    ld a,(AMY_UVAR_FogX)
    neg
    add a,b
    and 31
    cp 8
    jr nc,BrNoFog
    ; the row: DE >> 5
    ld a,e
    rlca
    rlca
    rlca
    and 7
    ld b,a
    ld a,d
    add a,a
    add a,a
    add a,a
    or b
    ld b,a
    ld a,(AMY_UVAR_FogR)
    neg
    add a,b
    cp 4
    jr nc,BrNoFog
    ld c,134
BrNoFog:
    ld a,(AMY_UVAR_LhMode)
    or a
    jr z,BrPut
    ld a,c
    sub 128
    ld l,a
    ld h,0
    push de
    ld de,AMY_UDATA_LitOf
    add hl,de
    pop de
    ld c,(hl)
BrPut:
    ld hl,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,c
    out ($BE),a
    pop hl
    pop bc
    djnz BrLoop
    ret
LhRayCells:
    dw 68,100,69,101,70,71,102,72,133,103,73,74,104,75,76,134
    dw 105,77,106,78,107,79,80,135,108,109,81,82,136,110,111,83
