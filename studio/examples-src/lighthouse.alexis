' --- the lamp ---------------------------------------------------------------
' Ang the beam's angle (192 rays x 256), Spd its speed (wound up by the
' stick), Ray the ray now drawn (255 none), LhRay / LhMode for beam.asm
u16 Ang = 12288
u8 Spd = 40
u8 Ray = 255
u8 LhRay = 0
u8 LhMode = 0
u8 LastDir = 255
u8 Decay = 0
' the fog bank: on, top row, left column, frames to its next step
u8 FogOn = 0
u8 FogR = 11
u8 FogX = 20
u8 FogT = 0
u8 HornCool = 0

' --- the ships ----------------------------------------------------------------
' on (0 none, 1 sailing, 2 wrecked), pixels, frames of guidance left,
' frames to the next step, drift, horn timer
u8 ShOn[6]
u8 ShX[6]
u8 ShY[6]
u8 ShG[6]
u8 ShT[6]
u8 ShD[6]
u8 ShH[6]
u8 ShLit[6]
u8 NShips = 0

' --- the night ----------------------------------------------------------------
u8 Night = 1
u16 Clock = 0
u16 NightLen = 5400
u8 SpawnT = 60
u8 SpawnGap = 200
u8 ShipSpd = 4
u8 Saved = 0
u8 Lost = 0
u8 NightSaved = 0
u8 WaveT = 0
u8 WaveF = 0
' for the test bot: 1 a night, 2 the dawn card, 3 the end, 8 the title
u8 Ph = 0
' 1 while a frame's work is under way (for the test bot)
u8 Busy = 0

u16 Rw = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Cell = 0
u16 Addr = 0
u16 W16 = 0
u8 Cx = 0
u8 Cy = 0
u8 C = 0
u8 I = 0
u8 K = 0
u8 N = 0
u8 J = 0
u8 V = 0
u8 V2 = 0
u8 Mk = 0
u8 X = 0
u8 Y = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0

  tile screen
  set sound table LhSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  ' the title: the lighthouse turning over the empty sea
  Ph = 8
  DrawScene
  print at 9,2, "L I G H T H O U S E"
  print at 7,22, "PRESS THE BUTTON"
  play song LhSong once
  Spd = 40
  WasBtn = 1
attract:
  Frame1
  ReadPad
  TurnBeam
  Waves
  if Press = 0 then goto attract
  Rs = Rs ^ Tick
  if Rs = 0 then Rs = $5A3C
  play sound SndTick
  ' the story
  NewScreen
  print at 6,3, "L I G H T H O U S E"
  print at 3,6, "FIVE NIGHTS OF STORM ON"
  print at 3,7, "GULL POINT. SHIPS COME IN"
  print at 3,8, "FROM THE DARK, MAKING FOR"
  print at 3,9, "THE HARBOUR UNDER YOUR"
  print at 3,10, "CLIFF."
  print at 3,11, "A SHIP KNOWS THE WAY ONLY"
  print at 3,12, "WHILE YOUR BEAM FINDS IT."
  print at 3,14, "STICK: TURN IT ROUND AND"
  print at 3,15, "ROUND TO WIND THE LAMP."
  print at 3,17, "BUTTON: THE HORN, FOR SHIPS"
  print at 3,18, "LOST IN THE FOG."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  play sound SndTick
  ' the credits
  NewScreen
  print at 6,3, "L I G H T H O U S E"
  print at 2,7, "A GAME BY CLAUDE (AN AI MADE"
  print at 2,8, "BY ANTHROPIC) FOR AMY STUDIO"
  print at 2,10, "AND AMY BIENVENU"
  print at 2,13, "MUSIC: THE KEEPER'S WALTZ"
  print at 2,16, "COLECOVISION, AMY, 2026"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  play sound SndTick
  stop sound SndTuneA
  stop sound SndTuneB

  Night = 1
  Saved = 0
  Lost = 0

night_start:
  NightCard
  NightSetup
  Ph = 1

play_loop:
  Frame1
  Busy = 1
  ReadPad
  Crank
  TurnBeam
  Waves
  Fog
  Ships
  Spawn
  ShowShips
  if Press = 1 then Horn
  inc Clock
  V = Clock & 63
  if V = 0 then ShowHud
  Busy = 0
  if Lost >= 3 then goto failed
  if Clock < NightLen then goto play_loop

  ' dawn: the ships at sea are safe in the daylight
  HideSprites
  Ph = 2
  play sound SndBell
  NewScreen
  print at 12,6, "DAWN"
  print at 5,9, "NIGHT"
  print at 11,9, digits$(Night, 1)
  print at 13,9, "IS OVER."
  print at 5,12, "SHIPS IN HARBOUR:"
  print at 23,12, digits$(NightSaved, 2)
  print at 5,13, "WRECKS SO FAR:"
  print at 23,13, digits$(Lost, 1)
  ShowScreen
  Hold(180)
  inc Night
  if Night <= 5 then goto night_start

  ' the end: the storm has passed
  Ph = 3
  NewScreen
  print at 3,5, "THE STORM HAS PASSED."
  print at 3,7, "THE SEA IS CALM, AND THE"
  print at 3,8, "SHIPS YOU BROUGHT IN RIDE"
  print at 3,9, "AT ANCHOR UNDER GULL POINT."
  print at 3,12, "SHIPS SAVED:"
  print at 17,12, digits$(Saved, 3)
  print at 3,13, "WRECKS:"
  print at 17,13, digits$(Lost, 1)
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  play song LhSong once
  WaitPress
  stop sound SndTuneA
  stop sound SndTuneB
  goto title

failed:
  HideSprites
  Ph = 3
  Hold(60)
  NewScreen
  print at 3,6, "THREE SHIPS ON THE REEFS."
  print at 3,8, "THE KEEPER IS RELIEVED OF"
  print at 3,9, "THE LIGHT ON GULL POINT."
  print at 3,12, "SHIPS SAVED:"
  print at 17,12, digits$(Saved, 3)
  print at 3,13, "NIGHTS KEPT:"
  V = Night - 1
  print at 17,13, digits$(V, 1)
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  goto title

' ---------------------------------------------------------------------------

sub NightCard:
  Ph = 2
  HideSprites
  NewScreen
  print at 12,8, "NIGHT"
  print at 18,8, digits$(Night, 1)
  if Night = 1 then print at 7,11, "A ROUGH SEA RISING"
  if Night = 2 then print at 7,11, "MORE SAILS TONIGHT"
  if Night = 3 then print at 7,11, "FOG ON THE WATER"
  if Night = 4 then print at 7,11, "THE GALE COMES IN"
  if Night = 5 then print at 7,11, "THE WORST OF IT"
  ShowScreen
  Hold(150)
  return
end sub

' NightSetup: the night's sea, ships and weather
sub NightSetup:
  DrawScene
  for I = 0 to 5
    ShOn[I] = 0
  next
  Clock = 0
  NightSaved = 0
  SpawnT = 60
  V = Night * 25
  SpawnGap = 230 - V
  ShipSpd = 5
  if Night >= 4 then ShipSpd = 4
  FogOn = 0
  if Night >= 3 then FogOn = 1
  FogX = 22
  FogR = 11
  FogT = 0
  Spd = 40
  Ray = 255
  if FogOn = 1 then DrawFog
  ShowHud
  return
end sub

' DrawScene: the night scene from the table, cell by cell
sub DrawScene:
  NewScreen
  for Cell = 0 to 767
    V = Scene[Cell]
    Addr = Cell
    vpoke vram.name + Addr, V
  next
  ShowScreen
  return
end sub

sub ShowHud:
  print at 2,1, "NIGHT"
  print at 8,1, digits$(Night, 1)
  print at 10,1, "SAVED"
  print at 16,1, digits$(Saved, 2)
  print at 19,1, "LOST"
  print at 24,1, digits$(Lost, 1)
  ' the clockwork: how wound the lamp is
  V = Spd >> 4
  print at 26,1, "    "
  if V > 0 then
    for I = 1 to V
      X = I + 25
      if X <= 29 then print at X,1, "*"
    next
  end if
  return
end sub

' Crank: the stick going round clockwise winds the lamp (a creak each
' quarter); the clockwork runs down slowly, faster on stormy nights
sub Crank:
  V = 255
  if Up1 = 1 then V = 0
  if Rt1 = 1 then V = 1
  if Dn1 = 1 then V = 2
  if Lf1 = 1 then V = 3
  if V <> 255 then
    if V <> LastDir then
      V2 = LastDir + 1
      V2 = V2 & 3
      if V = V2 then
        if Spd < 60 then Spd = Spd + 5
        if Spd > 64 then Spd = 64
        play sound SndCreak
      end if
      LastDir = V
    end if
  end if
  inc Decay
  V = 9 - Night
  if Decay >= V then
    Decay = 0
    if Spd > 0 then dec Spd
  end if
  return
end sub

' TurnBeam: the angle moves on; when it reaches a new ray, the old beam
' (three rays wide) is put back and the new one lit
sub TurnBeam:
  W16 = Spd * 4
  Ang = Ang + W16
  if Ang >= 49152 then Ang = Ang - 49152
  W16 = Ang >> 8
  V = lowbyte W16
  if V = Ray then return
  if Ray <> 255 then
    LhMode = 0
    BeamFive
  end if
  Ray = V
  ' the land side: no beam to draw
  if V > 98 then
    if V < 189 then
      Ray = 255
      return
    end if
  end if
  LhMode = 1
  BeamFive
  return
end sub

' BeamFive: the beam is five rays wide, Ray in the middle
sub BeamFive:
  LhRay = Ray - 2
  BeamCall
  LhRay = Ray - 1
  BeamCall
  LhRay = Ray
  BeamCall
  LhRay = Ray + 1
  BeamCall
  LhRay = Ray + 2
  BeamCall
  return
end sub

sub BeamCall:
  asm {
    call BeamRay
  }
  return
end sub

' Waves: the sea's two patterns take turns (faster as the storm grows)
sub Waves:
  inc WaveT
  V = Night * 5
  V = 40 - V
  if WaveT < V then return
  WaveT = 0
  WaveF = WaveF ^ 1
  if WaveF = 1 then
    Addr = TSea * 8
    copy Wave2 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave2 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave2 count 8 to vram.pattern + Addr
    Addr = TLsea * 8
    copy Wave2 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave2 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave2 count 8 to vram.pattern + Addr
  else
    Addr = TSea * 8
    copy Wave1 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave1 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave1 count 8 to vram.pattern + Addr
    Addr = TLsea * 8
    copy Wave1 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave1 count 8 to vram.pattern + Addr
    Addr = Addr + 2048
    copy Wave1 count 8 to vram.pattern + Addr
  end if
  return
end sub

' Fog: the bank drifts left a column at a time and wraps round
sub Fog:
  if HornCool > 0 then dec HornCool
  if FogOn = 0 then return
  inc FogT
  if FogT < 90 then return
  FogT = 0
  ' a column left: its old right column goes, a new left column comes
  X = FogX + 7
  X = X & 31
  dec FogX
  FogX = FogX & 31
  for Y = 0 to 3
    Cy = FogR + Y
    FogCell
  next
  X = FogX
  for Y = 0 to 3
    Cy = FogR + Y
    FogCell
  next
  return
end sub

' FogCell: cell (X, Cy) drawn as it is now: fog inside the bank, else
' the scene (sea and reefs only; land stays land)
sub FogCell:
  W16 = Cy * 32
  Cell = W16 + X
  V = Scene[Cell]
  if V <> TSea then
    if V <> TReef then return
  end if
  V2 = X - FogX
  V2 = V2 & 31
  if V2 < 8 then V = TFog
  ' under the beam: lit
  if Ray <> 255 then
    V2 = AngMap[Cell]
    if V2 <> 255 then
      Mk = V2 - Ray
      if Ray > V2 then Mk = Ray - V2
      if Mk <= 2 then
        V2 = V - 128
        V = LitOf[V2]
      end if
    end if
  end if
  Addr = Cell
  vpoke vram.name + Addr, V
  return
end sub

sub DrawFog:
  for N = 0 to 7
    X = FogX + N
    X = X & 31
    for Y = 0 to 3
      Cy = FogR + Y
      FogCell
    next
  next
  return
end sub

' InFog: V 1 if pixel (X, Y) is in the fog bank
sub InFog:
  V = 0
  if FogOn = 0 then return
  Cx = X >> 3
  Cy = Y >> 3
  V2 = Cy - FogR
  if V2 >= 4 then return
  V2 = Cx - FogX
  V2 = V2 & 31
  if V2 < 8 then V = 1
  return
end sub

' Horn: the lighthouse's horn guides every ship in the fog
sub Horn:
  if HornCool > 0 then return
  HornCool = 90
  play sound SndHorn
  for I = 0 to 5
    if ShOn[I] = 1 then
      X = ShX[I]
      Y = ShY[I]
      InFog
      if V = 1 then ShG[I] = 90
    end if
  next
  return
end sub

' Spawn: a new ship from the right, now and then
sub Spawn:
  if SpawnT > 0 then
    dec SpawnT
    return
  end if
  W16 = NightLen - 600
  if Clock > W16 then return
  SpawnT = SpawnGap
  for I = 0 to 5
    if ShOn[I] = 0 then
      ShOn[I] = 1
      ShX[I] = 248
      Rnd16
      V = lowbyte Rw
      V = V & 7
      ' rows 10-21 (pixels), never onto a reef
      Y = V + 10
      if Y = 10 then Y = 12
      if Y = 11 then Y = 13
      ShY[I] = Y * 8
      ShY[I] = ShY[I] + 4
      ShG[I] = 0
      ShT[I] = 1
      ShD[I] = 0
      ShH[I] = 0
      ShLit[I] = 0
      return
    end if
  next
  return
end sub

' Ships: each sails a step when its time comes: guided, toward the
' channel (row 18) and in to the harbour; lost, drifting where the sea
' takes it. The beam finds the ships it passes over (not in fog).
sub Ships:
  for I = 0 to 5
    if ShOn[I] = 1 then
      ' lit by the beam?
      X = ShX[I]
      Y = ShY[I]
      Cx = X >> 3
      Cy = Y >> 3
      W16 = Cy * 32
      Cell = W16 + Cx
      if Ray <> 255 then
        V = AngMap[Cell]
        if V <> 255 then
          V2 = V - Ray
          if Ray > V then V2 = Ray - V
          if V2 <= 3 then
            InFog
            if V = 0 then
              ShG[I] = 90
              ShLit[I] = 40
            end if
          end if
        end if
      end if
      if ShLit[I] > 0 then dec ShLit[I]
      ' a horn in the fog now and then
      X = ShX[I]
      Y = ShY[I]
      InFog
      if V = 1 then
        inc ShH[I]
        if ShH[I] >= 150 then
          ShH[I] = 0
          play sound SndShipHorn
        end if
      end if
      dec ShT[I]
      if ShT[I] = 0 then SailStep
    end if
  next
  return
end sub

' SailStep: ship I moves a pixel
sub SailStep:
  ShT[I] = ShipSpd
  if ShG[I] > 0 then
    ' guided: toward the channel, then in
    ShG[I] = ShG[I] - 1
    ' steer for the channel (row 18); a reef ahead: turn first, then go on
    Y = ShY[I]
    if ShY[I] < 148 then inc Y
    if ShY[I] > 148 then dec Y
    X = ShX[I]
    Cx = X >> 3
    Cy = Y >> 3
    W16 = Cy * 32
    Cell = W16 + Cx
    V = Scene[Cell]
    if V <> TReef then ShY[I] = Y
    X = ShX[I] - 9
    Y = ShY[I]
    Cx = X >> 3
    Cy = Y >> 3
    W16 = Cy * 32
    Cell = W16 + Cx
    V = Scene[Cell]
    if V <> TReef then dec ShX[I]
  else
    ' lost: slower, and the sea pushes it about
    ShT[I] = ShipSpd * 2
    dec ShX[I]
    inc ShD[I]
    if ShD[I] >= 6 then
      ShD[I] = 0
      Rnd16
      V = lowbyte Rw
      V = V & 3
      if V = 0 then
        if ShY[I] > 76 then dec ShY[I]
      end if
      if V = 1 then
        if ShY[I] < 180 then inc ShY[I]
      end if
    end if
  end if
  ' where is it now?
  X = ShX[I]
  Y = ShY[I]
  Cx = X >> 3
  Cy = Y >> 3
  W16 = Cy * 32
  Cell = W16 + Cx
  V = Scene[Cell]
  if Cx <= 3 then
    if Cy >= 17 then
      if Cy <= 19 then
        ' in the harbour
        ShOn[I] = 0
        inc Saved
        inc NightSaved
        play sound SndBell
        ShowHud
        return
      end if
    end if
  end if
  if V = TReef then
    Wreck
    return
  end if
  if V = TRock then Wreck
  if V = TPier then Wreck
  return
end sub

sub Wreck:
  ShOn[I] = 2
  ShLit[I] = 120
  inc Lost
  play sound SndWreck
  ShowHud
  return
end sub

' ShowShips: a lit ship shows whole; in the dark, only its lantern;
' in fog, nothing
sub ShowShips:
  for I = 0 to 5
    X = ShX[I] - 8
    Y = ShY[I] - 13
    C = 0
    N = SLantern
    if ShOn[I] = 1 then
      C = 11
      if ShLit[I] > 0 then
        N = SShip
        C = 15
      end if
      V2 = ShX[I]
      X = V2
      Y = ShY[I]
      InFog
      X = ShX[I] - 8
      Y = ShY[I] - 13
      if V = 1 then C = 0
    end if
    if ShOn[I] = 2 then
      N = SWreck
      C = 14
      if ShLit[I] > 0 then
        dec ShLit[I]
      else
        ShOn[I] = 0
      end if
    end if
    set sprite I to Y,X,N,C
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  sprites flicker on
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

