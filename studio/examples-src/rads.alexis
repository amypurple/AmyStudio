record Cell:
  i16 X
  i16 Y
  i8 VX
  i8 VY
  u8 Kind
  u8 Tm
  u8 Hits
end record

Cell Cells[6]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the droid: position in 1/16 pixels, facing (0 right, 1 left), state
' (0 flying, 1 working a spindle, 2 falling), harm-free frames, lives
u16 DX = 0
u16 DY = 0
u8 Face = 0
u8 DSt = 0
u8 Inv = 0
u8 Lives = 0
u8 SpinI = 0
u16 SpinAcc = 0
u16 Rate = 0
u8 HSpd = 0
u8 VSpd = 0
u8 Cool = 0
' the spindles of this level: tile column, row, gauge 0-32, key (1 full)
u8 NSp = 0
u8 SpC[12]
u8 SpR[12]
u8 SpV[12]
u8 Key[12]
' which tiles hold a spindle: 4 bytes (32 columns) a row
u8 SpMask[96]
u8 KeyFull = 0
' the bolts: x, y in pixels, direction (0 right, 1 left), frames left
u8 BoX[2]
u8 BoY[2]
u8 BoD[2]
u8 BoT[2]
u8 Lv = 0
u8 NAct = 0
u8 LvNum = 0
u16 SlowT = 0
u8 Over = 0
u8 Clear1 = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' title animation
u8 TbX = 40
u8 TbD = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Bi = 0
u8 Si = 0
u8 Ds = 0
u8 Lc = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 R8 = 0
i16 T16 = 0
i16 Px = 0
i8 Vx = 0

  tile screen
  set sound table RaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Score > Hi then Hi = Score
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "  BEST  ", Hi, "  "
  print at 8,14, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift; Rnd gives the low byte
function Rnd as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs & 255

' 1-15, as the C64's noise reads ($14C3)
function Rnd15 as u8
  u8 Q = 0
  Q = 0
  while Q = 0
    Q = Rnd() & 15
  end while
  return Q

' a cell's speed: random 2-9 + its kind + the level, at least 1, then in
' 1/16 pixels a frame (x 3/2)
function CellSpeed(u8 Kd) as u8
  u8 Sp = 0
  Sp = Rnd() & 7
  Sp = Sp + 2 + KindAdd[Kd] + Lv
  if Sp > 127 then Sp = 1
  if Sp = 0 then Sp = 1
  Sp = Sp + (Sp >> 1)
  return Sp

' a random sign
function Signed(u8 Sp) as i8
  i8 Sv = 0
  Sv = Sp
  if Rnd() > 127 then Sv = 0 - Sv
  return Sv

'' 1 when tile column Tc, row Tr holds a spindle (a bit in SpMask)
function OnSpindle(u8 Tc, u8 Tr) as u8
  u8 Mi = 0
  if Tr > 23 then return 0
  Mi = Tc >> 3
  Mi = Mi + Tr * 4
  if SpMask[Mi] & BitT[Tc & 7] then return 1
  return 0

' the spindle under tile column Tc, row Tr, or 255
function SpindleAt(u8 Tc, u8 Tr) as u8
  u8 Fi = 0
  u8 Found = 255
  Fi = 0
  while Fi < NSp
    if Tr >= SpR[Fi] then
      if Tr <= SpR[Fi] + 1 then
        if Tc >= SpC[Fi] then
          if Tc <= SpC[Fi] + 2 then
            Found = Fi
            Fi = NSp
          end if
        end if
      end if
    end if
    inc Fi
  end while
  return Found

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  MoveDroid
  MoveBolts
  if SlowT > 0 then
    dec SlowT
    V = Tick & 1
    if V = 1 then return
  end if
  Ci = 0
  while Ci < NAct
    MoveCell
    inc Ci
  end while
  return
end sub

sub MoveDroid:
  if Inv > 0 then dec Inv
  if Cool > 0 then dec Cool
  if DSt = 2 then
    DY = DY + FallSpd
    if DY >= 2816 then LoseDroid
    return
  end if
  K = J1 & 12
  if K = 4 then Face = 1
  if K = 8 then Face = 0
  X = DX >> 4
  Y = DY >> 4
  C = X + 8
  C = C >> 3
  R8 = Y + 8
  R8 = R8 >> 3
  V = 255
  if OnSpindle(C, R8) = 1 then V = SpindleAt(C, R8)
  if DSt = 1 then
    if Btn = 0 then
      DSt = 0
    else
      WorkSpindle
      return
    end if
  end if
  if Btn > 0 then
    if V < 255 then
      DSt = 1
      SpinI = V
      SpinAcc = 0
      return
    end if
    Shoot
  end if
  if K = 4 then
    if DX >= XMin * 16 + HSpd then
      DX = DX - HSpd
    else
      DX = XMin * 16
    end if
  end if
  if K = 8 then
    W16 = DX + HSpd
    if W16 > XMax * 16 then W16 = XMax * 16
    DX = W16
  end if
  K = J1 & 3
  if K = 1 then
    if DY >= YMin * 16 + VSpd then
      DY = DY - VSpd
    else
      DY = YMin * 16
    end if
  end if
  if K = 2 then
    W16 = DY + VSpd
    if W16 > YMax * 16 then W16 = YMax * 16
    DY = W16
  end if
  return
end sub

' the droid holds spindle SpinI: one gauge step each time the count
' passes 256 (twice the rate on the middle tile)
sub WorkSpindle:
  W16 = Rate
  if C = SpC[SpinI] + 1 then W16 = W16 << 1
  SpinAcc = SpinAcc + W16
  if SpinAcc < 256 then return
  SpinAcc = SpinAcc - 256
  V = SpV[SpinI]
  if Face = 0 then
    if V < 32 then
      inc V
    else
      play sound SndBump
      return
    end if
  else
    if V > 0 then
      dec V
    else
      play sound SndBump
      return
    end if
  end if
  SpV[SpinI] = V
  K = V & 3
  if K = 0 then play sound SndTick
  DrawSpindle(SpinI)
  CheckClear
  return
end sub

sub Shoot:
  if Cool > 0 then return
  for Bi = 0 to 1
    if BoT[Bi] = 0 then
      BoT[Bi] = 14
      BoD[Bi] = Face
      X = DX >> 4
      ' kept inside the safe columns (16-239 for the bolt's pixels)
      if Face = 0 then
        X = X + 8
        if X > 218 then X = 218
      else
        if X < 24 then
          X = 16
        else
          X = X - 8
        end if
      end if
      BoX[Bi] = X
      BoY[Bi] = (DY >> 4) + 1
      Cool = 10
      play sound SndBolt
      Bi = 1
    end if
  next
  return
end sub

' the bolts: 6 pixels a frame, stopped by the walls, a spindle or a cell
sub MoveBolts:
  for Bi = 0 to 1
    if BoT[Bi] > 0 then
      dec BoT[Bi]
      if BoD[Bi] = 0 then
        if BoX[Bi] >= 218 then
          BoT[Bi] = 0
        else
          BoX[Bi] = BoX[Bi] + 6
        end if
      else
        if BoX[Bi] < 22 then
          BoT[Bi] = 0
        else
          BoX[Bi] = BoX[Bi] - 6
        end if
      end if
      if BoT[Bi] > 0 then BoltHits
    end if
  next
  return
end sub

sub BoltHits:
  X = BoX[Bi] + 8
  X = X >> 3
  Y = BoY[Bi] + 7
  Y = Y >> 3
  if OnSpindle(X, Y) = 1 then
    BoT[Bi] = 0
    return
  end if
  for Si = 0 to 5
    if Cells[Si].Kind > 0 then
      T16 = Cells[Si].X >> 4
      T16 = T16 - BoX[Bi]
      if T16 > -12 then
        if T16 < 12 then
          T16 = Cells[Si].Y >> 4
          T16 = T16 - BoY[Bi]
          if T16 > -10 then
            if T16 < 8 then
              BoT[Bi] = 0
              CellShot
              Si = 5
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' a bolt hits cell Si
sub CellShot:
  K = Cells[Si].Kind
  select case K
    case KOrb
      Cells[Si].Kind = KNone
      SlowT = SlowLen
      play sound SndOrb
      Score += 50
    case KScram
      Cells[Si].Kind = KHunt
      Cells[Si].Hits = 0
      NewVel(Si)
      play sound SndZap
    case KSpark
      Cells[Si].Kind = KDud
      V = abs(Cells[Si].VY)
      Cells[Si].VY = V >> 1
      if Cells[Si].VY = 0 then Cells[Si].VY = 1
      play sound SndZap
      Score += 10
    case KHunt
      inc Cells[Si].Hits
      play sound SndZap
      if Cells[Si].Hits >= 6 then
        Cells[Si].Kind = KSpark
        NewVel(Si)
        Score += 25
      end if
  end select
  ShowScore
  return
end sub

' a new random speed and direction both ways ($14E1)
sub NewVel(u8 Q):
  V = Cells[Q].Kind
  V = CellSpeed(V)
  Cells[Q].VX = Signed(V)
  V = Cells[Q].Kind
  V = CellSpeed(V)
  Cells[Q].VY = Signed(V)
  Cells[Q].Tm = 40
  return
end sub

' a storm cell: born on the bottom row, gone past the top or the bottom
sub MoveCell:
  K = Cells[Ci].Kind
  if K = KNone then
    SpawnCell
    return
  end if
  ' sparks and hunters aim at the droid now and then
  if K >= KSpark then
    dec Cells[Ci].Tm
    if Cells[Ci].Tm = 0 then AimCell
  end if
  ' the fields once into scratch (each field read recomputes the address)
  Px = Cells[Ci].X
  Vx = Cells[Ci].VX
  Px = Px + Vx
  if Px < XMin * 16 then
    Px = XMin * 16
    Cells[Ci].VX = 0 - Vx
  end if
  if Px > XMax * 16 then
    Px = XMax * 16
    Cells[Ci].VX = 0 - Vx
  end if
  Cells[Ci].X = Px
  T16 = Cells[Ci].Y + Cells[Ci].VY
  Cells[Ci].Y = T16
  if T16 < 192 then
    Cells[Ci].Kind = KNone
    return
  end if
  if T16 > 2704 then
    Cells[Ci].Kind = KNone
    return
  end if
  ' on a spindle: one time in eight it bounces off, or a scrambler spins
  ' that gauge out of line and turns into a hunter
  X = T16 >> 4
  T16 = Px >> 4
  C = T16 + 8
  C = C >> 3
  R8 = X + 8
  R8 = R8 >> 3
  if OnSpindle(C, R8) = 1 then
    J = Rnd() & 7
    if J = 0 then
      if K = KScram then
        V = SpindleAt(C, R8)
        J = Rnd15()
        SpV[V] = J << 1
        DrawSpindle(V)
        Cells[Ci].Kind = KHunt
        Cells[Ci].Hits = 0
        play sound SndScram
      end if
      NewVel(Ci)
    end if
  end if
  ' a spark or a hunter touching the droid knocks it down
  K = Cells[Ci].Kind
  if K >= KSpark then
    if DSt < 2 then
      if Inv = 0 then TouchDroid
    end if
  end if
  return
end sub

sub TouchDroid:
  T16 = Cells[Ci].X >> 4
  W16 = DX >> 4
  T16 = T16 - W16
  if T16 <= -8 then return
  if T16 >= 8 then return
  T16 = Cells[Ci].Y >> 4
  W16 = DY >> 4
  T16 = T16 - W16
  if T16 <= -8 then return
  if T16 >= 8 then return
  DSt = 2
  play sound SndHit
  return
end sub

' re-aim at the droid: new speeds, signs toward it ($1450)
sub AimCell:
  K = Cells[Ci].Kind
  if K = KHunt then
    Cells[Ci].Tm = 7
  else
    Cells[Ci].Tm = 14
  end if
  V = CellSpeed(K)
  W16 = DX >> 4
  T16 = Cells[Ci].X >> 4
  if T16 >= W16 then
    Cells[Ci].VX = 0 - V
  else
    Cells[Ci].VX = V
  end if
  V = CellSpeed(K)
  W16 = DY >> 4
  T16 = Cells[Ci].Y >> 4
  if T16 >= W16 then
    Cells[Ci].VY = 0 - V
  else
    Cells[Ci].VY = V
  end if
  return
end sub

' a new cell on the bottom row ($14F4): an orb or a spark, a scrambler or
' a hunter one step up with chance level/15
sub SpawnCell:
  K = KSpark
  V = 32 - Lv * 2
  if Rnd() < V then K = KOrb
  V = Rnd15()
  if V < Lv then inc K
  Cells[Ci].Kind = K
  Cells[Ci].Hits = 0
  V = Rnd15()
  if V > 14 then V = 14
  W16 = V * 16 + 8
  if W16 > XMax then W16 = XMax
  Cells[Ci].X = W16 << 4
  Cells[Ci].Y = 2688
  V = CellSpeed(K)
  Cells[Ci].VX = Signed(V)
  V = CellSpeed(K)
  Cells[Ci].VY = 0 - V
  Cells[Ci].Tm = 40
  return
end sub

sub LoseDroid:
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    DSt = 3
    return
  end if
  PlaceDroid
  return
end sub

sub PlaceDroid:
  DX = 84 * 16
  DY = 24 * 16
  DSt = 0
  Inv = InvLen
  Face = 0
  return
end sub

' the level is clear when every gauge is full or empty and the full ones
' are as many as the key shows ($0E60)
sub CheckClear:
  K = 0
  for Ds = 0 to NSp - 1
    V = SpV[Ds]
    if V = 32 then inc K
    if V > 0 then
      if V < 32 then return
    end if
  next
  if K <> KeyFull then return
  LevelClear
  return
end sub

sub LevelClear:
  NumU = NSp
  for Ds = 1 to NSp
    Score += 100
  next
  ShowScore
  print at 9,10, "          "
  print at 9,11, " RELAYED! "
  print at 9,12, "          "
  play sound SndClear
  for Lc = 0 to 119
    Frame1
    DrawSprites
  next
  inc Lv
  if Lv = 9 then Lv = 0
  inc LvNum
  if LvNum > 99 then LvNum = 99
  StartLevel
  return
end sub

'' set the six tiles of spindle Q in SpMask
sub MarkSpindle(u8 Q):
  u8 Mc = 0
  u8 Mr = 0
  u8 Mx = 0
  for Mr = SpR[Q] to SpR[Q] + 1
    for Mc = SpC[Q] to SpC[Q] + 2
      Mx = Mr * 4 + (Mc >> 3)
      SpMask[Mx] = SpMask[Mx] | BitT[Mc & 7]
    next
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing
sub DrawSpindle(u8 Q):
  u8 Gv = 0
  u8 Gc = 0
  u8 Gr = 0
  u8 Gt = 0
  u8 Gk = 0
  Gc = SpC[Q]
  Gr = SpR[Q]
  Gv = SpV[Q]
  Gt = TRlr
  if Gv = 0 then Gt = TRlg
  if Gv = 32 then Gt = TRlg
  put char Gt at Gc,Gr
  Gk = Gv >> 1
  Gk = Gk & 1
  put char Gt + 1 + Gk at Gc + 1,Gr
  put char Gt + 3 at Gc + 2,Gr
  ' the gauge: 32 steps over 3 tiles of 8 pixels (24 pixels)
  Gv = Gv * 3
  Gv = Gv >> 2
  for Gk = 0 to 2
    if Gv >= 8 then
      Gt = TGa8
      Gv = Gv - 8
    else
      Gt = TGa0 + Gv
      Gv = 0
    end if
    put char Gt at Gc + Gk,Gr + 1
  next
  return
end sub

' sprites: 0 the droid's visor, 1 its hull, 2 its jet, 3-8 the cells,
' 9-10 the bolts
sub DrawSprites:
  X = DX >> 4
  Y = DY >> 4
  V = Inv >> 4
  V = V & 1
  if DSt = 3 then V = 1
  if V = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  else
    K = SDrr
    if Face = 1 then K = SDrl
    set sprite 0 to Y - 1,X,K,7
    set sprite 1 to Y - 1,X,SDrb,14
    K = Tick >> 2
    K = K & 1
    K = K * 4 + SJet0
    set sprite 2 to Y - 1,X,K,9
  end if
  for Ds = 0 to 5
    J = Ds + 3
    K = Cells[Ds].Kind
    if K > 0 then
      T16 = Cells[Ds].X >> 4
      X = T16
      T16 = Cells[Ds].Y >> 4
      Y = T16
      V = Tick >> 4
      V = V + Ds
      V = V & 1
      C = KindPat[K] + V * 4
      R8 = KindCol[K]
      set sprite J to Y - 1,X,C,R8
    else
      set sprite J to 192,0,0,0
    end if
  next
  for Ds = 0 to 1
    J = Ds + 9
    if BoT[Ds] > 0 then
      set sprite J to BoY[Ds] - 1,BoX[Ds],SBolt,11
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

sub ShowLives:
  for Ds = 0 to 3
    K = 32
    if Ds < Lives then K = TLife
    put char K at 26 + Ds,1
  next
  return
end sub

' a new level: speeds, the spindles at random gauges, the key, the cells
sub StartLevel:
  NewScreen
  for Ds = 2 to 21
    for J = 2 to 29
      V = Rnd() & 15
      K = TSp0
      if V = 1 then K = TSp1
      if V = 2 then K = TSp2
      if V = 3 then K = TSp3
      put char K at J,Ds
    next
  next
  print at 2,1, "SCORE"
  print at 15,1, "LV"
  NumU = LvNum
  print at 18,1, digits$(NumU, 2)
  ShowScore
  ShowLives
  print at 2,22, "KEY"
  NAct = Lv >> 1
  NAct = NAct + 3
  if NAct > NCell then NAct = NCell
  HSpd = 38 + Lv
  VSpd = 29 + Lv
  W16 = 32 - Lv * 2
  Rate = 714 / W16
  K = LvStart[Lv]
  V = LvStart[Lv + 1]
  NSp = V - K
  KeyFull = 0
  fill array SpMask with 0
  for Ds = 0 to NSp - 1
    J = K + Ds
    SpC[Ds] = SpColT[J]
    SpR[Ds] = SpRowT[J]
    MarkSpindle(Ds)
    V = Rnd15()
    SpV[Ds] = V + 8
    DrawSpindle(Ds)
    V = Rnd()
    if V > 127 then
      Key[Ds] = 1
      inc KeyFull
      put char TKfull at 6 + Ds * 2,22
    else
      Key[Ds] = 0
      put char TKempt at 6 + Ds * 2,22
    end if
  next
  for Ds = 0 to 5
    Cells[Ds].Kind = KNone
  next
  for Ds = 0 to 1
    BoT[Ds] = 0
  next
  PlaceDroid
  SpinAcc = 0
  SlowT = 0
  Cool = 0
  DrawSprites
  ShowScreen
  return
end sub

sub NewGame:
  Score = 0
  Lv = 0
  LvNum = 1
  Lives = 4
  Over = 0
  StartLevel
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: RADS in steel blocks, the magazine, START / CREDITS, the best
' score, a droid patrolling, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 224 to vram.name + 32
  print at 7,9, "COMPUTE!'S GAZETTE"
  print at 9,10, "FEBRUARY 1988"
  print at 4,12, "ALIGN EVERY SPINDLE TO"
  print at 4,13, "THE KEY. MIND THE STORM."
  print at 13,17, "START"
  print at 13,18, "HOW TO PLAY"
  print at 13,19, "CREDITS"
  Menu = 0
  if Hi > 0 then
    print at 9,21, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' a droid patrols under the title, a pixel a frame
sub TitleAnim:
  if TbD = 0 then
    inc TbX
    if TbX >= 216 then TbD = 1
  else
    dec TbX
    if TbX <= 24 then TbD = 0
  end if
  K = SDrr
  if TbD = 1 then K = SDrl
  set sprite 0 to 119,TbX,K,7
  set sprite 1 to 119,TbX,SDrb,14
  K = Tick >> 2
  K = K & 1
  K = K * 4 + SJet0
  set sprite 2 to 119,TbX,K,9
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,17
  put char 32 at 11,18
  put char 32 at 11,19
  J = Menu + 17
  put char 62 at 11,J
  return
end sub

' a spindle for the HOW TO PLAY pages at column Hc, row Hr, gauge Hv
' (0-32; green when 0 or 32), as DrawSpindle draws it
sub HtSpindle(u8 Hc, u8 Hr, u8 Hv):
  u8 Ht = 0
  u8 Hk = 0
  Ht = TRlr
  if Hv = 0 then Ht = TRlg
  if Hv = 32 then Ht = TRlg
  put char Ht at Hc,Hr
  put char Ht + 1 at Hc + 1,Hr
  put char Ht + 3 at Hc + 2,Hr
  Hv = Hv * 3
  Hv = Hv >> 2
  for Hk = 0 to 2
    if Hv >= 8 then
      Ht = TGa8
      Hv = Hv - 8
    else
      Ht = TGa0 + Hv
      Hv = 0
    end if
    put char Ht at Hc + Hk,Hr + 1
  next
  return
end sub

' HOW TO PLAY: three pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "YOU ARE A REPAIR DROID. A"
    print at 2,4, "STORM HAS SPUN THE RELAY"
    print at 2,5, "SPINDLES OUT OF LINE."
    print at 2,7, "EVERY SPINDLE'S GAUGE MUST"
    print at 2,8, "END UP FULL OR EMPTY. THE"
    print at 2,9, "KEY AT THE BOTTOM SHOWS HOW"
    print at 2,10, "MANY MUST BE FULL (THE"
    print at 2,11, "ORDER DOES NOT MATTER)."
    print at 2,13, "DO IT AND THE LEVEL IS"
    print at 2,14, "RELAYED!"
    HtSpindle(6, 17, 14)
    HtSpindle(12, 17, 32)
    HtSpindle(18, 17, 0)
    print at 2,20, "KEY"
    put char TKfull at 6,20
    put char TKempt at 7,20
    put char TKfull at 8,20
    set sprite 0 to 119,52,SDrr,7
    set sprite 1 to 119,52,SDrb,14
    set sprite 2 to 119,52,SJet0,9
  elseif Pg = 2 then
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "STICK: FLY THE DROID."
    print at 2,5, "ON A SPINDLE, HOLD THE"
    print at 2,6, "BUTTON AND PUSH RIGHT TO"
    print at 2,7, "FILL ITS GAUGE, LEFT TO"
    print at 2,8, "EMPTY IT. IT GOES FASTER"
    print at 2,9, "FROM THE MIDDLE."
    print at 2,11, "AWAY FROM A SPINDLE THE"
    print at 2,12, "BUTTON SHOOTS A BOLT THE"
    print at 2,13, "WAY THE DROID FACES."
    HtSpindle(14, 17, 20)
    set sprite 0 to 127,116,SDrr,7
    set sprite 1 to 127,116,SDrb,14
    set sprite 2 to 127,116,SJet1,9
    print at 19,18, ">"
  else
    print at 2,1, "THE STORM              3/3"
    print at 2,3, "SPARKS AND HUNTERS CHASE"
    print at 2,4, "YOU. ONE TOUCH AND YOU LOSE"
    print at 2,5, "A DROID. YOU HAVE FOUR."
    print at 2,6, "LOSE THEM ALL: GAME OVER."
    print at 2,8, "SHOOT THEM! AN ORB SLOWS"
    print at 2,9, "THE STORM WHEN YOU HIT IT."
    print at 2,10, "A SCRAMBLER SPINS GAUGES."
    print at 2,12, "100 POINTS A SPINDLE WHEN"
    print at 2,13, "A LEVEL IS DONE, MORE FOR"
    print at 2,14, "SHOOTING THE STORM."
    print at 2,16, "TIP: SHOOT FIRST, THEN FIX."
    set sprite 0 to 139,40,SDrr,7
    set sprite 1 to 139,40,SDrb,14
    set sprite 3 to 143,72,SBolt,11
    set sprite 4 to 139,112,SSpk0,8
    set sprite 5 to 156,152,SHun0,13
    set sprite 6 to 156,192,SOrb0,7
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 14,2, "RADS"
  print at 2,5, "BASED ON RADS,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "FEBRUARY 1988 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SPINDLE WATCH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
RaBolt:
    db $40,$3E,$20,$01,$40,$4B,$30,$01,$40,$5D,$40,$01,$40,$7C,$60,$01,$50
RaTick:
    db $40,$A9,$50,$01,$40,$7F,$60,$01,$50
RaBump:
    db $40,$1F,$33,$03,$40,$A4,$53,$03,$50
RaZap:
    db $00,$00,$25,$02,$00,$00,$46,$03,$00,$00,$66,$04,$10
RaOrb:
    db $40,$6B,$20,$02,$40,$55,$20,$02,$40,$47,$20,$02,$40,$35,$30,$02,$40,$2A,$40,$06,$50
RaScram:
    db $00,$00,$24,$03,$00,$00,$35,$03,$00,$00,$54,$04,$00,$00,$75,$06,$10
RaHit:
    db $40,$50,$20,$02,$40,$5B,$20,$02,$40,$67,$20,$02,$40,$75,$20,$02,$40,$85,$30,$02,$40,$97,$30,$02
    db $40,$AC,$30,$02,$40,$C4,$30,$02,$40,$DE,$40,$02,$40,$FD,$40,$02,$40,$1F,$41,$02,$40,$46,$41,$02
    db $50
RaClear:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$0E
    db $50
RaStart:
    db $40,$1D,$21,$06,$40,$BF,$20,$06,$40,$8F,$20,$0E,$50
RaOver:
    db $40,$1D,$11,$0A,$40,$41,$21,$0A,$40,$68,$21,$0A,$40,$AB,$31,$1E,$50

RaSoundTable:
    dw RaTuneMel,$702B
    dw RaTuneBass,$7035
    dw RaBolt,$7049
    dw RaTick,$7049
    dw RaBump,$7049
    dw RaZap,$703F
    dw RaOrb,$7049
    dw RaScram,$703F
    dw RaHit,$7049
    dw RaClear,$7049
    dw RaStart,$7049
    dw RaOver,$7049
; Spindle Watch (original)
; Tiny Sound, 8 frames per step
RaTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1C,$1F,$23,$28,$01,$26,$23,$01,$1F,$21,$23,$01
    db $26,$01,$23,$01,$18,$1C,$1F,$24,$01,$23,$1F,$01,$1C,$1E,$1F,$01
    db $23,$01,$21,$01,$1C,$1F,$23,$28,$01,$2A,$2B,$01,$2A,$28,$26,$01
    db $23,$01,$26,$01,$24,$23,$21,$1F,$01,$1E,$01,$1A,$1C,$01,$01,$23
    db $01,$28,$01,$00
    db $FF
RaTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$10,$01,$01,$01,$17,$01,$01,$01,$10,$01,$01,$01
