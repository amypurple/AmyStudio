cartridge "CYPHER/COMPUTE'S GAZETTE/1985"

' CYPHER
' A ColecoVision game based on "Cypher", COMPUTE!'s Gazette, February
' 1985 (Commodore 64 and VIC-20 BASIC, disk 1985-02; no author is named
' in the listings or on the disk's contents file). Made for Amy Studio
' by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a line-for-line port: the rules are the original's (read from the
' C64 and VIC-20 listings, orig/); the game is rebuilt for the
' ColecoVision: round pegs with a shine on a grey board, a cursor frame
' that glides, sound effects and a title tune.
'
' The game: the computer hides a code of six pegs, each one of eight
' colours (a colour may come more than once). Guess it in twelve turns.
' After each guess the key pegs say how close you are: a black key for
' each peg of the right colour in the right place, a white key for each
' other peg of a right colour in a wrong place. The keys don't tell
' which pegs they belong to.
'
' From the original: six pegs, eight colours (the C64's black, white,
' red, cyan, purple, green, blue, yellow), repeats allowed, drawn at
' random; the code covered by red diamonds that appear one by one with
' a blip; twelve turns, guesses listed top to bottom; the scoring of
' lines 450-600 (whites = the sum over colours of the smaller count in
' guess and code, minus the blacks), blacks first then whites in the key
' row; each colour sounds its note of the C major scale (C5 to C6, the
' listing's SID values) when it is chosen and when the code is shown;
' giving up shows the code (the listing's key 9); the code is shown at
' the end; "YOU WON" with the number of moves, or "YOU LOSE".
'
' Liberties: joystick instead of the number keys: left and right choose
' a hole, up and down change its colour, the left button enters the
' guess (all six holes must be filled); the right button pressed twice
' gives up. DEL is not needed: any hole can be changed before entering.
' Each new row starts as a copy of the last guess (change only what you
' want). The "+" / "0" / "@" marks are black / white keys and dim holes.
' The best (fewest moves) game and the number of codes broken are kept
' until power off. No play-again prompt: the title comes back.
'
' Controls: either controller; stick left/right picks the hole, up/down
' its colour, left button tries the guess, right button twice gives up.
' On the title, up and down choose (PLAY, HOW TO PLAY, CREDITS), a
' button picks; HOW TO PLAY has two pages (a button turns the page, 30 s
' idle goes back).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off and
' the display off. Music first in the sound table, the title tune played
' once. `set sprite count` always given. Own xorshift random numbers.
' Nothing flashes.

const TBoard = 128
const THole = 129
const TPeg0 = 130
const TPeg1 = 131
const TPeg2 = 132
const TPeg3 = 133
const TPeg4 = 134
const TPeg5 = 135
const TPeg6 = 136
const TPeg7 = 137
const TDiam = 138
const TKey0 = 139
const TKeyb = 140
const TKeyw = 141
const TRimt = 142
const TRimb = 143
const TBar = 144
const SFrame = 0
const NTiles8 = 136
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndNote0 = 3
const SndNote1 = 4
const SndNote2 = 5
const SndNote3 = 6
const SndNote4 = 7
const SndNote5 = 8
const SndNote6 = 9
const SndNote7 = 10
const SndBlip = 11
const SndStep = 12
const SndBad = 13
const SndWin = 14
const SndLose = 15
const NSpr = 1
const TuneLen = 576
const NoPeg = 255
const CodeY = 2
const FirstY = 5
const KeyX = 18

record Cursor:
  u8 Slot
  u8 X
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the code, the guess being made, the guesses so far (12 x 6)
u8 Sec[6]
u8 Gu[6]
u8 Hist[72]
' the listing's counts per colour: RC (code), GC (guess)
u8 Rc[8]
u8 Gc[8]
u8 Bk = 0
u8 Wh = 0
u8 Turn = 0
u8 Best = 0
bcd digits 4 Wins = 0
Cursor Cur
' game state: 0 title, 2 playing, 4 over; Why 1 won, 2 lost, 3 gave up
u8 Gs = 0
u8 Why = 0
u8 GiveT = 0
u8 Rpt = 0
u8 Menu = 0
u8 HPg = 0
u16 HWt = 0
u8 Tick = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press1 = 0
u8 Press2 = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Si = 0
' scratch
u8 J = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table CySoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayInput
  MoveCursor
  if Gs <> 4 then goto play_loop

  ' the end: the code shown, a message, then the title on a press
  HideSprites
  Reveal
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  select case Why
  case 1
    Wins += 1
    if Best = 0 or Turn < Best then Best = Turn
    print at 9,19, "YOU WON!!"
    NumU = Turn
    print at 9,20, "MOVES: ", digits$(NumU, 2)
    play sound SndWin
  case 2
    print at 9,19, "YOU LOSE!!"
    print at 5,20, "TWELVE TURNS ARE UP."
    play sound SndLose
  case else
    print at 9,19, "YOU LOSE!!"
    print at 7,20, "YOU GAVE UP."
    play sound SndLose
  end select
  ShowSide
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the board

' the screen column of hole I (0-5)
function PegCol(u8 I) as u8
  return I * 2 + 5

' the tile of a peg of colour C, or the empty hole
function PegTile(u8 C) as u8
  if C = NoPeg then return THole
  return TPeg0 + C

' hole I of row Ty shows colour C (or nothing)
sub PutPeg(u8 I, u8 Ty, u8 C):
  u8 Px = 0
  Px = PegCol(I)
  put char PegTile(C) at Px,Ty
  return

' the grey board: the code row, a red bar, twelve rows of holes and keys
sub DrawBoard:
  u8 Ry = 0
  fill TRimt count 21 at 4,1
  for Ry = 2 to 16
    fill TBoard count 21 at 4,Ry
  next
  fill TRimb count 21 at 4,17
  fill TBar count 21 at 4,3
  for Si = 0 to 11
    Ry = Si + FirstY
    for Ci = 0 to 5
      PutPeg(Ci, Ry, NoPeg)
    next
    fill TKey0 count 6 at KeyX,Ry
    NumU = Si + 1
    print at 2,Ry, digits$(NumU, 2)
  next
  return

' the key row of turn T: blacks first, then whites, then dim holes
sub DrawKeys(u8 T):
  u8 Ry = 0
  u8 Kx = 0
  Ry = T + FirstY
  Kx = KeyX
  fill TKey0 count 6 at KeyX,Ry
  if Bk > 0 then
    fill TKeyb count Bk at Kx,Ry
    Kx += Bk
  end if
  if Wh > 0 then fill TKeyw count Wh at Kx,Ry
  return

sub DrawGuess:
  u8 Ry = 0
  Ry = Turn + FirstY
  for Si = 0 to 5
    PutPeg(Si, Ry, Gu[Si])
  next
  return

sub ShowSide:
  print at 25,5, "TURN"
  NumU = Turn + 1
  if NumU > 12 then NumU = 12
  print at 26,6, digits$(NumU, 2)
  print at 25,9, "BEST"
  if Best = 0 then
    print at 26,10, "--"
  else
    NumU = Best
    print at 26,10, digits$(NumU, 2)
  end if
  print at 25,13, "WINS"
  print Wins at 25,14
  return

sub ShowHelp:
  fill 32 count 28 at 2,18
  put char TKeyb at 3,19
  print at 5,19, "RIGHT COLOUR, RIGHT HOLE"
  put char TKeyw at 3,20
  print at 5,20, "RIGHT COLOUR, WRONG HOLE"
  print at 2,21, "STICK: HOLE AND COLOUR"
  print at 2,22, "LEFT BUTTON: TRY THIS CODE"
  return

' ---------------------------------------------------------------------------
' the rules

' the listing's scoring (lines 450-600): F blacks, Q colour matches
sub ScoreGuess:
  u8 Q = 0
  u8 I = 0
  fill array Gc with 0
  Bk = 0
  for I = 0 to 5
    V = Gu[I]
    inc Gc[V]
    if V = Sec[I] then inc Bk
  next
  for I = 0 to 7
    Q += min(Gc[I], Rc[I])
  next
  Wh = Q - Bk
  return

' the first empty hole of the guess, or 6 when all are filled
function FirstEmpty as u8
  u8 I = 0
  for I = 0 to 5
    if Gu[I] = NoPeg then return I
  next
  return 6

' the guess is entered
sub TryGuess:
  u16 Hx = 0
  u8 E = 0
  E = FirstEmpty
  if E < 6 then
    play sound SndBad
    Cur.Slot = E
    return
  end if
  ScoreGuess
  DrawKeys(Turn)
  for Si = 0 to 5
    Hx = Turn * 6 + Si
    Hist[Hx] = Gu[Si]
  next
  inc Turn
  if Bk = 6 then
    Why = 1
    Gs = 4
    return
  end if
  if Turn = 12 then
    Why = 2
    Gs = 4
    return
  end if
  play sound SndBlip
  ' liberty: the new row starts as a copy of the last guess
  DrawGuess
  Cur.Slot = 0
  ShowSide
  return

' the code uncovered peg by peg with its notes (lines 800-850)
sub Reveal:
  u8 C = 0
  for Si = 0 to 5
    C = Sec[Si]
    PutPeg(Si, CodeY, C)
    play sound SndNote0 + C
    for Ci = 1 to 14
      Frame1
    next
  next
  return

' ---------------------------------------------------------------------------
' play

sub PlayInput:
  u8 St = 0
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
  elseif Rpt > 0 then
    dec Rpt
  else
    if WasStick = 0 then
      Rpt = 14
    else
      Rpt = 7
    end if
    MoveBy(St)
  end if
  WasStick = St
  if GiveT > 0 then
    dec GiveT
    if GiveT = 0 then ShowHelp
  end if
  if Press1 = 1 then TryGuess
  if Press2 = 1 then
    if GiveT > 0 then
      Why = 3
      Gs = 4
    else
      GiveT = 180
      fill 32 count 28 at 2,21
      fill 32 count 28 at 2,22
      print at 2,21, "PRESS THE RIGHT BUTTON"
      print at 2,22, "AGAIN TO GIVE UP."
    end if
  end if
  return

' the next colour after C going up (D = 1) or down (D = 0)
function NextColour(u8 C, u8 D) as u8
  if C = NoPeg then
    if D = 1 then return 0
    return 7
  end if
  if D = 1 then return (C + 1) & 7
  return (C + 7) & 7

' one step of the stick: left/right a hole, up/down a colour
sub MoveBy(u8 St):
  u8 C = 0
  u8 Ry = 0
  select case St
  case 4, 5, 6
    if Cur.Slot > 0 then
      dec Cur.Slot
      play sound SndStep
    end if
  case 8, 9, 10
    if Cur.Slot < 5 then
      inc Cur.Slot
      play sound SndStep
    end if
  case 1, 2
    C = Gu[Cur.Slot]
    C = NextColour(C, St & 1)
    Gu[Cur.Slot] = C
    Ry = Turn + FirstY
    PutPeg(Cur.Slot, Ry, C)
    play sound SndNote0 + C
  end select
  return

' the cursor frame glides 4 pixels a frame to its hole
sub MoveCursor:
  u8 Tx = 0
  u8 Ty = 0
  Tx = PegCol(Cur.Slot) * 8 - 4
  Ty = Turn + FirstY
  Ty = Ty * 8 - 4
  if Cur.X < Tx then Cur.X += 4
  if Cur.X > Tx then Cur.X -= 4
  if Cur.Y < Ty then Cur.Y += 4
  if Cur.Y > Ty then Cur.Y -= 4
  Y = Cur.Y - 1
  set sprite 0 to Y,Cur.X,SFrame,15
  update sprites
  return

' ---------------------------------------------------------------------------
' games

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

sub NewGame:
  u8 B = 0
  Gs = 2
  Why = 0
  Turn = 0
  GiveT = 0
  NewScreen
  DrawBoard
  ShowSide
  ShowHelp
  fill array Rc with 0
  for Si = 0 to 5
    Gu[Si] = NoPeg
  next
  Cur.Slot = 0
  Cur.X = PegCol(0) * 8 - 4
  Cur.Y = FirstY * 8 - 4
  ShowScreen
  ' six diamonds cover the code, one by one with a blip (lines 260-310)
  for Si = 0 to 5
    W16 = Rand
    B = W16 & 7
    Sec[Si] = B
    inc Rc[B]
    X = PegCol(Si)
    put char TDiam at X,CodeY
    play sound SndBlip
    for Ci = 1 to 10
      Frame1
    next
  next
  MoveCursor
  Rearm
  wait no fire
  nmi off
  WasBtn = 48
  return

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 48
  V = Btn & ~WasBtn
  Press1 = 0
  Press2 = 0
  if (V & 16) > 0 then Press1 = 1
  if (V & 32) > 0 then Press2 = 1
  WasBtn = Btn
  return

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  update sprites
  return

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title in pegs: C Y P H E R, 3 x 5 letters, each row three bits
data TitleFont bytes
  7, 4, 4, 4, 7
  5, 5, 2, 2, 2
  7, 5, 7, 4, 4
  5, 5, 7, 5, 5
  7, 4, 7, 4, 7
  7, 5, 6, 5, 5
end data

data TitleCol bytes
  2, 7, 5, 3, 6, 1
end data

sub DrawTitleWord:
  u8 Bits = 0
  u8 Lr = 0
  u8 Lx = 0
  u8 Px = 0
  u8 Py = 0
  u8 Cl = 0
  u8 Ry = 0
  for Ry = 1 to 7
    fill TBoard count 26 at 3,Ry
  next
  for Ci = 0 to 5
    Cl = TitleCol[Ci]
    for Lr = 0 to 4
      Bits = TitleFont[Ci * 5 + Lr]
      Py = Lr + 2
      for Lx = 0 to 2
        Px = Ci * 4 + Lx + 5
        if (Bits & (4 >> Lx)) > 0 then
          put char TPeg0 + Cl at Px,Py
        end if
      next
    next
  next
  return

' the title: CYPHER in pegs, the tune once, PLAY / CREDITS
sub TitlePage:
  Gs = 0
  Menu = 0
  NewScreen
  DrawTitleWord
  print at 6,9, "COMPUTE!'S GAZETTE 1985"
  print at 3,11, "BREAK THE HIDDEN CODE OF"
  print at 3,12, "SIX PEGS IN EIGHT COLOURS"
  print at 3,13, "IN TWELVE TURNS."
  put char TKeyb at 3,14
  print at 5,14, "RIGHT COLOUR, RIGHT HOLE"
  put char TKeyw at 3,15
  print at 5,15, "RIGHT COLOUR, WRONG HOLE"
  print at 12,17, "PLAY"
  print at 12,18, "HOW TO PLAY"
  print at 12,19, "CREDITS"
  if Best > 0 then
    NumU = Best
    print at 6,21, "BEST GAME: ", digits$(NumU, 2), " MOVES"
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndStep
      ShowMenu
    end if
  end if
  WasStick = V
  V = Press1 | Press2
  if V = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,17
  put char 32 at 10,18
  put char 32 at 10,19
  J = Menu + 17
  put char 62 at 10,J
  return

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "THE COMPUTER HIDES A CODE"
    print at 2,4, "OF SIX PEGS. THERE ARE"
    print at 2,5, "EIGHT COLOURS, AND A COLOUR"
    print at 2,6, "CAN BE USED MORE THAN ONCE."
    print at 2,7, "FIND THE CODE IN TWELVE"
    print at 2,8, "TURNS OR LESS."
    print at 2,10, "STICK LEFT/RIGHT: PICK A"
    print at 2,11, "HOLE. UP/DOWN: ITS COLOUR."
    print at 2,12, "LEFT BUTTON: TRY THE CODE"
    print at 2,13, "(FILL ALL SIX HOLES)."
    print at 2,14, "RIGHT BUTTON TWICE: GIVE UP."
    fill TRimt count 10 at 11,16
    fill TBoard count 10 at 11,17
    fill TRimb count 10 at 11,18
    for J = 0 to 7
      put char TPeg0 + J at 12 + J,17
    next
    print at 6,19, "THE EIGHT COLOURS"
  else
    print at 2,3, "AFTER EACH TRY YOU GET KEYS:"
    put char TKeyb at 2,5
    print at 4,5, "BLACK: RIGHT COLOUR IN THE"
    print at 4,6, "RIGHT HOLE."
    put char TKeyw at 2,8
    print at 4,8, "WHITE: RIGHT COLOUR IN A"
    print at 4,9, "WRONG HOLE."
    print at 2,11, "THE KEYS DON'T SAY WHICH"
    print at 2,12, "PEG THEY ARE FOR."
    print at 2,14, "SIX BLACK KEYS: YOU WIN!"
    print at 2,15, "NO LUCK AFTER 12 TURNS: THE"
    print at 2,16, "CODE IS SHOWN, YOU LOSE."
    print at 2,17, "TIP: CHANGE ONE OR TWO PEGS"
    print at 2,18, "AT A TIME AND WATCH KEYS."
    fill TBoard count 15 at 8,20
    put char TPeg2 at 9,20
    put char TPeg5 at 10,20
    put char TPeg2 at 11,20
    put char TPeg7 at 12,20
    put char TPeg1 at 13,20
    put char TPeg3 at 14,20
    fill TKeyb count 2 at 16,20
    put char TKeyw at 18,20
    fill TKey0 count 3 at 19,20
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 48
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then return
  V = Press1 | Press2
  if V = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "CYPHER"
  print at 2,4, "BASED ON CYPHER, COMPUTE!'S"
  print at 2,5, "GAZETTE, FEBRUARY 1985"
  print at 2,6, "(COMMODORE 64 AND VIC-20)."
  print at 2,7, "NO AUTHOR NAMED."
  print at 2,9, "A CODE-BREAKING GAME IN THE"
  print at 2,10, "TRADITION OF BULLS AND COWS."
  print at 2,13, "COLECOVISION GAME, MUSIC"
  print at 2,14, "AND PICTURES BY CLAUDE"
  print at 2,15, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,16, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,18, "MUSIC: SIX HIDDEN COLOURS"
  print at 2,19, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$18,$18,$00,$00,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $C3,$81,$30,$60,$00,$81,$C3,$00
  $10,$38,$83,$01,$83,$38,$10,$00
  $00,$00,$00,$30,$30,$00,$00,$00
  $00,$00,$30,$87,$87,$30,$00,$00
  $00,$00,$30,$87,$87,$30,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $0E,$0E,$0E,$0E,$0E,$0E,$0E,$0E
  $0E,$0E,$0E,$1E,$1E,$0E,$0E,$0E
  $E1,$E1,$E1,$E1,$01,$E1,$E1,$0E
  $EF,$EF,$EF,$EF,$0F,$EF,$EF,$0E
  $E8,$E8,$F8,$F8,$08,$E8,$E8,$0E
  $E7,$E7,$F7,$F7,$07,$E7,$E7,$0E
  $ED,$ED,$FD,$FD,$0D,$ED,$ED,$0E
  $E3,$E3,$F3,$F3,$03,$E3,$E3,$0E
  $E5,$E5,$F5,$F5,$05,$E5,$E5,$0E
