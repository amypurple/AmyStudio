text screen
print at 6,4, "HAPPY BIRTHDAY DEMO"
print at 6,8, "BUTTON1 = PLAY SONG"
print at 8,10, "BUTTON2 = MUTE"
set sound table HappyBirthdaySoundTable
screen on
wait 5 frames
play sound 1
play sound 2
goto main_loop

main_loop:
  if joypad(1).button1 then
    goto replay_song
  elseif joypad(1).button2 then
    goto stop_song
  end if
  wait
  goto main_loop

replay_song:
  play sound 1
  play sound 2

wait_replay_release:
  if joypad(1).button1 then
    goto wait_replay_release
  end if
  goto main_loop

stop_song:
  mute all

wait_stop_release:
  if joypad(1).button2 then
    goto wait_stop_release
  end if
  goto main_loop

