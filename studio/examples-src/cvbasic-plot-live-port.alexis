u8 X = 0
u8 Y = 0
u8 Shade = 0
u8 ColorIndex = 0

text screen
print centered at 5, "CVBASIC PORT"
print centered at 8, "LIVE BITMAP DRAWING"
print centered at 9, "NMI-SAFE PLOT"
print centered at 14, "PRESS FIRE"
screen on
pause until press
wait no fire

bitmap screen
cls
screen on

' A wait places each short critical section immediately after VBlank. The
' display remains on while only NMI is disabled during direct VDP access.
for X = 20 to 220
  wait
  nmi off
  pset X,20
  nmi on
next

for Y = 20 to 170
  wait
  nmi off
  pset 220,Y
  nmi on
next

for X = 220 to 20 step -1
  wait
  nmi off
  pset X,170
  nmi on
next

for Y = 170 to 20 step -1
  wait
  nmi off
  pset 20,Y
  nmi on
next

' One shaded row is short enough to draw safely between two VBlanks.
for Y = 40 to 150
  wait
  nmi off
  Shade = Y
  and Shade with $0F
  for X = 32 to 55
    pset X,Y color Shade
  next
  nmi on
next

for X = 102 to 202 step 10
  wait
  nmi off
  line X,40 to 202,150
  nmi on
next

for Y = 40 to 150 step 10
  wait
  nmi off
  line 102,Y to 202,150
  nmi on
next

ColorIndex = 1
for X = 8 to 240 step 8
  wait
  nmi off
  line 128,0 to X,16 color ColorIndex
  nmi on
  ColorIndex += 1
  if ColorIndex = 16 then ColorIndex = 0
next

wait
nmi off
circle 80,60 radius 15
nmi on
wait
nmi off
circle 80,100 radius 20
nmi on
wait
nmi off
circle 80,140 radius 25
nmi on

loop forever
