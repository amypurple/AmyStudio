u8 X = 0
u8 Y = 0
u8 Shade = 0
u8 ColorIndex = 0
u8 Batch = 0

text screen
print centered at 5, "CVBASIC PORT"
print centered at 8, "LIVE BITMAP DRAWING"
print centered at 9, "NMI-SAFE PLOT"
print centered at 14, "PRESS FIRE"
screen on
pause until press
wait no fire

bitmap screen
cls
screen on

' Draw moderate batches after VBlank. The display stays on, while NMI is
' disabled only long enough to protect each direct VDP operation.
wait
nmi off
for X = 20 to 220
  pset X,20
next
nmi on

wait
nmi off
for Y = 20 to 170
  pset 220,Y
next
nmi on

wait
nmi off
for X = 220 to 20 step -1
  pset X,170
next
nmi on

wait
nmi off
for Y = 170 to 20 step -1
  pset 20,Y
next
nmi on

' Four shaded rows per frame are visibly progressive without becoming sluggish.
Y = 40
while Y <= 150
  wait
  nmi off
  for Batch = 0 to 3
    if Y <= 150 then
      Shade = Y
      and Shade with $0F
      for X = 32 to 55
        pset X,Y color Shade
      next
      Y += 1
    end if
  next
  nmi on
end while

for X = 102 to 202 step 10
  wait
  nmi off
  line X,40 to 202,150
  nmi on
next

for Y = 40 to 150 step 10
  wait
  nmi off
  line 102,Y to 202,150
  nmi on
next

ColorIndex = 1
for X = 8 to 240 step 8
  wait
  nmi off
  line 128,0 to X,16 color ColorIndex
  nmi on
  ColorIndex += 1
  if ColorIndex = 16 then ColorIndex = 0
next

wait
nmi off
circle 80,60 radius 15
nmi on
wait
nmi off
circle 80,100 radius 20
nmi on
wait
nmi off
circle 80,140 radius 25
nmi on

loop forever
