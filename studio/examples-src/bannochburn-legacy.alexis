' the castle (the book's DATA, line 4840 on): the room north, south,
' east and west of each room (0: no door); room 12 is the Black Lagoon
data RoomN bytes 0, 0,0,0,0,0,5,4,2,0,6,9,0
data RoomS bytes 0, 2,8,0,7,6,10,0,0,11,0,0,0
data RoomE bytes 0, 0,3,0,2,4,7,6,9,0,0,0,0
data RoomW bytes 0, 0,4,2,5,0,0,0,0,8,0,0,0
' the monsters' sprites and colours (1-6)
data MonSpr bytes 0, 0,4,8,12,16,20
data MonCol bytes 0, 13,8,14,10,12,2

data CbDx bytes 0,3,4,3,0,253,252,253
data CbDy bytes 252,253,0,3,4,3,0,253
data CbCol bytes 15,11,9,13,7,10,8,14
u8 CbX[8]
u8 CbY[8]
u8 CbK = 0
u8 CbT = 0
u8 CbN = 0
u8 CbC = 0
u8 CbV = 0

' the rooms: south door of rooms 10 and 11 (the Lagoon), the monster in
' each room (0 none, 1-5)
u8 Sth[13]
u8 Mo[13]
' magic, strength and wisdom of the monsters (1-6) and you (7)
u8 Mm[8]
u8 Ms[8]
u8 Mw[8]
u8 Name[8]
u8 Zr = 1
u8 Q = 0
u8 Dd = 0
u8 Chest = 0
u8 Potion = 0
u8 Scroll = 0
u8 Safe = 0
u8 Att = 0
u8 Hum = 0
u8 Mon = 0
u8 Diff = 0
u8 Neg = 0
u8 Cost = 0
u8 Roll = 0
u8 Vic = 0
u8 Sel = 0
u8 Nopt = 0
u8 OptX[6]
u8 Mode = 0
' melees fought (for the bot)
u8 Fights = 0
u8 Tot = 0
u8 Won = 0
u8 Pos = 0
u8 Ka = 0
u8 Kc = 0
u16 Money = 0
u16 Cash = 0

u16 Uw = 0
u16 Ub = 0
u16 NumU = 0
u16 Rs = $5D3B
u16 Rt = 0
u8 Rb = 0
u8 Nr = 0
u8 Res = 0

u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BnSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' a new game: your name, the castle, the monsters, you

  GameScreen
  print at 2,4, "PLEASE ENTER YOUR FIRST"
  print at 2,5, "NAME"
  NameEntry
  if Res = 1 then goto title
  for K = 0 to 12
    Mo[K] = 0
    Sth[K] = 0
  next
  ' the book: rooms 2-10 hold a monster (1-5) with odds .63
  for K = 2 to 10
    Rnd
    if Rb < 161 then
      Nr = 5
      RndN
      Mo[K] = V + 1
    end if
  next
  ' the Black Lagoon lies south of room 10 or of room 11
  Rnd
  if Rb < 128 then
    Sth[11] = 12
  else
    Sth[10] = 12
  end if
  for K = 1 to 7
    Nr = 6
    RndN
    Ms[K] = V + 1
    RndN
    Mm[K] = V + 1
    RndN
    Mw[K] = V + 1
  next
  Money = 0
  Chest = 0
  Potion = 0
  Scroll = 0
  Safe = 0
  Zr = 1
  GameScreen
  print at 2,4, "HI THERE,"
  put Name at 12,4
  print at 2,6, "PLEASE STAND BY..."
  Pause

' ---------------------------------------------------------------------------
' the game cycle (the book's lines 40-170)

bn_cycle:
  V = Mm[7] + Ms[7]
  V = V + Mw[7]
  if V = 0 then
    GameScreen
    play sound SndLose
    print at 2,4, "THE ADVENTURE HAS ENDED."
    print at 2,5, "YOU HAVE EXHAUSTED ALL YOUR"
    print at 2,6, "POWERS."
    print at 2,8, "YOU FOUGHT BRAVELY AND WELL"
    print at 2,9, "BUT COULD NOT ENDURE."
    print at 2,11, "FAREWELL..."
    EndWait
    goto title
  end if
  if Zr = 12 then goto bn_lagoon
  ' the room
  GameScreen
  RoomText
  Q = 0
  if Zr > 1 then
    Rnd
    if Rb >= 208 then
      ' a monster wanders in (0-5: sometimes none)
      Nr = 6
      RndN
      Q = V
      Mo[Zr] = Q
    else
      Q = Mo[Zr]
    end if
  end if
  if Q > 0 then
    GoOn
    ClrText
    MonsterText
  end if
  GoOn
  ' the room's contents
  if Zr > 1 then
    Rnd
    if Rb >= 128 then Contents
  end if
  ' what now? (the book's line 1910)
bn_act:
  Dd = 4
  if Mo[Zr] = 0 then
    Dd = 1
    if Zr > 1 then
      Rnd
      if Rb >= 205 then
        Contents
        goto bn_act
      end if
    end if
  end if
  Q = Mo[Zr]
  StatLine
  ShowMon
bn_ask:
  print at 2,20, "WHAT DO YOU WANT TO DO NOW?"
  ActMenu
  if Res = 1 then goto title
  print at 2,19, "                            "
  ' with a monster in the room only F (fight) or FL (flee) are taken
  if Dd = 4 then
    if Sel < 4 then
      Dd = 0
      goto bn_fight
    end if
  end if
  if Sel >= 4 then
    if Mo[Zr] = 0 then
      print at 2,19, "THERE IS NOTHING TO FIGHT"
      play sound SndClick
      goto bn_ask
    end if
    if Sel = 5 then
      Rnd
      Dd = Rb & 1
      if Dd = 1 then
        print at 2,19, "WHICH DIRECTION?"
        Dd = 1
        goto bn_ask2
      end if
    end if
    goto bn_fight
  end if
bn_go:
  ' a direction
  V = 0
  if Sel = 0 then V = RoomN[Zr]
  if Sel = 1 then
    V = RoomS[Zr]
    if Sth[Zr] > 0 then V = Sth[Zr]
  end if
  if Sel = 2 then V = RoomE[Zr]
  if Sel = 3 then V = RoomW[Zr]
  if V = 0 then
    if Sel = 0 then print at 2,19, "NO EXIT"
    if Sel = 1 then print at 2,19, "THERE IS NO DOOR THAT WAY"
    if Sel = 2 then print at 2,19, "THAT IS NOT POSSIBLE"
    if Sel = 3 then print at 2,19, "YOU CAN'T WALK THROUGH WALLS"
    play sound SndClick
    goto bn_ask
  end if
  play sound SndStep
  Zr = V
  goto bn_cycle
bn_ask2:
  ' fled: a direction only
  print at 2,20, "WHAT DO YOU WANT TO DO NOW?"
  ActMenu
  if Res = 1 then goto title
  if Sel >= 4 then goto bn_ask2
  print at 2,19, "                            "
  goto bn_go

bn_fight:
  ClrText
  if Dd = 0 then
    print at 2,3, "NO!! YOU MUST STAND AND"
    print at 2,4, "FIGHT"
  end if
  print at 2,6, "WHICH CHARACTERISTIC WILL"
  print at 2,7, "YOU FIGHT WITH?"
  AttMenu
  Att = Sel
  Hum = Mm[7]
  Mon = Mm[Q]
  if Att = 1 then
    Hum = Ms[7]
    Mon = Ms[Q]
  end if
  if Att = 2 then
    Hum = Mw[7]
    Mon = Mw[Q]
  end if
  FoldDiff
  ClrText
  print at 2,3, "THE FIGHT TABLE FOR THIS"
  print at 2,4, "MELEE READS"
  if Neg = 1 then print at 14,4, "-"
  NumU = Diff
  print at 15,4, width$(NumU, 1)
  ' the cost: |DIFF| + 1 to 6
  Nr = 6
  RndN
  Cost = Diff + V
  inc Cost
  print at 2,6, "THE MELEE CARRIES A"
  print at 2,7, "COST/REWARD OF"
  NumU = Cost
  print at 17,7, width$(NumU, 2)
  Rnd
  if Rb < 128 then
    print at 2,9, "THE MONSTER ATTACKS AND THE"
    print at 2,10, "FIGHT IS UNDERWAY"
  else
    print at 2,9, "YOU ATTACK FIRST, AND THE"
    print at 2,10, "BATTLE IS JOINED..."
  end if
  GoOn
  Effects
  RollDie
  ClrText
  if Vic = 1 then
    print at 2,3, "YOU DEFEATED THE"
    MonName
    play sound SndWin
  else
    print at 2,3, "THE"
    MonName
    print at 2,4, "DEFEATED YOU"
    play sound SndLose
  end if
  ' the cost moves from the loser to the winner
  if Att = 0 then
    if Vic = 1 then
      Mm[7] = Mm[7] + Cost
      V = Mm[Q]
      Sub0
      Mm[Q] = V
    else
      Mm[Q] = Mm[Q] + Cost
      V = Mm[7]
      Sub0
      Mm[7] = V
    end if
  end if
  if Att = 1 then
    if Vic = 1 then
      Ms[7] = Ms[7] + Cost
      V = Ms[Q]
      Sub0
      Ms[Q] = V
    else
      Ms[Q] = Ms[Q] + Cost
      V = Ms[7]
      Sub0
      Ms[7] = V
    end if
  end if
  if Att = 2 then
    if Vic = 1 then
      Mw[7] = Mw[7] + Cost
      V = Mw[Q]
      Sub0
      Mw[Q] = V
    else
      Mw[Q] = Mw[Q] + Cost
      V = Mw[7]
      Sub0
      Mw[7] = V
    end if
  end if
  inc Fights
  print at 2,6, "AFTER THAT FIGHT, YOUR"
  print at 2,7, "ATTRIBUTES ARE:"
  K = 7
  Y = 8
  AttList
  print at 2,12, "AND THOSE OF THE"
  MonName2
  print at 2,13, "ARE:"
  K = Q
  Y = 14
  AttList
  Mo[Zr] = 0
  StatLine
  GoOn
  ' the book goes on to the room's contents
  Contents
  goto bn_cycle

' ---------------------------------------------------------------------------
' the Black Lagoon (the book's lines 370-1880)

bn_lagoon:
  GameScreen
  for Y = 15 to 18
    fill TWater count 28 at 2,Y
  next
  print at 2,3, "YOU HAVE STUMBLED ON TO THE"
  print at 2,4, "MARSHY MUD SURROUNDING THE"
  print at 2,5, "BLACK LAGOON UNDERNEATH THE"
  print at 2,6, "CASTLE. TO ESCAPE FROM THE"
  print at 2,7, "CASTLE YOU MUST FIGHT THE"
  print at 2,8, "GUARDIAN OF THE BLACK LAGOON"
  print at 2,10, "THE FIGHT MUST INVOLVE ALL"
  print at 2,11, "ATTRIBUTES... YOU'LL NEED"
  print at 2,12, "A TOTAL OF 10 TO ESCAPE..."
  Q = 6
  ShowMon
  play sound SndRoar
  GoOn
  ClrText
  print at 2,3, "THE GUARDIAN'S ATTRIBUTES:"
  K = 6
  Y = 4
  AttList
  print at 2,8, "YOUR ATTRIBUTES ARE:"
  K = 7
  Y = 9
  AttList
  if Money > 0 then
    print at 2,13, "YOU HAVE $"
    NumU = Money
    print at 12,13, width$(NumU, 4)
    print at 17,13, "WORTH OF GOLD"
  end if
  GoOn
  ' gold buys points: $100 each (the book keeps at least $1)
bn_buy:
  if Money >= 101 then
    ClrText
    print at 2,3, "YOU CAN BUY ATTRIBUTE POINTS"
    print at 2,4, "FOR $100 EACH..."
    print at 2,6, "YOU HAVE $"
    NumU = Money
    print at 12,6, width$(NumU, 4)
    K = 7
    Y = 8
    AttList
    BuyMenu
    if Sel < 3 then
      Money = Money - 100
      if Sel = 0 then Mm[7] = Mm[7] + 1
      if Sel = 1 then Ms[7] = Ms[7] + 1
      if Sel = 2 then Mw[7] = Mw[7] + 1
      play sound SndGold
      StatLine
      goto bn_buy
    end if
  end if
  ClrText
  print at 2,3, "NOW FOR THE ULTIMATE TEST..."
  GoOn
  ' first, magic; then strength; then wisdom
  for Att = 0 to 2
    ClrText
    if Att = 0 then
      print at 2,3, "FIRST, MAGIC..."
      Hum = Mm[7]
      Mon = Mm[6]
    end if
    if Att = 1 then
      print at 2,3, "NOW IT'S TIME FOR A MATCH"
      print at 2,4, "OF STRENGTH..."
      Hum = Ms[7]
      Mon = Ms[6]
    end if
    if Att = 2 then
      print at 2,3, "NOW IT'S TIME FOR A MATCH"
      print at 2,4, "OF WISDOM..."
      Hum = Mw[7]
      Mon = Mw[6]
    end if
    print at 2,6, "YOU:"
    NumU = Hum
    print at 7,6, width$(NumU, 3)
    print at 12,6, "GUARDIAN:"
    NumU = Mon
    print at 22,6, width$(NumU, 3)
    ' the penalty: 1 to the sum of the two ratings
    Uw = Hum
    Uw = Uw + Mon
    Rnd
    Ub = Rb
    Ub = Ub * Uw
    Ub = Ub >> 8
    Cost = Ub
    inc Cost
    print at 2,8, "THIS ROUND CARRIES A PENALTY"
    print at 2,9, "OF"
    NumU = Cost
    print at 5,9, width$(NumU, 3)
    print at 9,9, "ATTRIBUTE POINTS"
    GoOn
    Effects
    FoldDiff
    RollDie
    ClrText
    if Vic = 1 then
      Hum = Hum + Cost
      print at 2,3, "AND YOU'VE WON..."
      play sound SndWin
    else
      V = Hum
      Sub0
      Hum = V
      print at 2,3, "AND YOU LOST..."
      play sound SndLose
    end if
    if Att = 0 then Mm[7] = Hum
    if Att = 1 then Ms[7] = Hum
    if Att = 2 then Mw[7] = Hum
    print at 2,5, "YOU NOW HAVE"
    NumU = Hum
    print at 15,5, width$(NumU, 3)
    print at 19,5, "POINTS"
    StatLine
    GoOn
  next
  ClrText
  print at 2,3, "AND NOW, AT THE END OF THE"
  print at 2,4, "FINAL BATTLE, YOUR POSITION"
  print at 2,5, "IS:"
  K = 7
  Y = 6
  AttList
  Tot = Mm[7] + Ms[7]
  Tot = Tot + Mw[7]
  print at 2,10, "WELL,"
  put Name at 8,10
  print at 2,11, "YOUR ATTRIBUTE TOTAL IS"
  NumU = Tot
  print at 26,11, width$(NumU, 3)
  GoOn
  ClrText
  Won = 0
  if Tot >= 10 then
    Won = 1
    print at 2,3, "YOU NEEDED AT LEAST 10"
    print at 2,4, "POINTS TO WIN THE GAME, AND"
    print at 2,5, "YOU'VE DONE IT!"
    print at 2,7, "YOU'VE SUCCEEDED, O HERO OF"
    print at 2,8, "THESE DARK AND DANGEROUS"
    print at 2,9, "TIMES. I HEREBY DUB THEE"
    print at 2,10, "SIR"
    put Name at 6,10
    print at 2,11, "...ARISE..."
    HideSprites
    play sound SndAngel
    Celebrate
    EndWait
    goto title
  end if
  Effects
  print at 2,3, "UNFORTUNATELY, YOU DID NOT"
  print at 2,4, "END UP WITH THE 10 POINTS"
  print at 2,5, "YOU NEEDED, SO IT IS ALL"
  print at 2,6, "OVER..."
  print at 2,8, "YOU FAIL TO ESCAPE THE"
  print at 2,9, "CLUTCHES OF THE GUARDIAN..."
  print at 2,11, "YOU FOUGHT VALIANTLY, BUT"
  print at 2,12, "WILL NOW BE CONSUMED..."
  play sound SndLose
  EndWait
  goto title

' ---------------------------------------------------------------------------
' the room's contents (the book's lines 2740-3370)

sub Contents:
  ' a monster in the room stays; else another room's is cleared (as the
  ' listing does)
  if Mo[Zr] <> 0 then return
cn_k:
  Nr = 8
  RndN
  K = V + 2
  if K = Zr then goto cn_k
  Mo[K] = 0
  Rnd
  if Rb >= 128 then return
cn_roll:
  Nr = 5
  RndN
  V = V + 1
  if V = 2 then
    if Potion = 1 then goto cn_roll
  end if
  if V = 4 then
    if Safe = 1 then goto cn_roll
  end if
  if V = 3 then
    if Scroll = 1 then return
  end if
  ClrText
  HideSprites
  if V = 1 then goto cn_chest
  if V = 5 then goto cn_chest
  if V = 2 then goto cn_potion
  if V = 3 then goto cn_scroll
  goto cn_safe
cn_chest:
  if Chest >= 4 then return
  inc Chest
  V = TChest00
  Icon2
  print at 2,4, "IN FRONT OF YOU IS A CHEST"
  print at 2,5, "LABELLED WITH A LARGE"
  NumU = Chest
  print at 24,5, width$(NumU, 1)
  print at 2,7, "WILL YOU OPEN IT?"
  YesNo
  if Res = 0 then return
  Nr = 3
  RndN
  Ka = V
  if Ka = 0 then
    Nr = 255
    RndN
    Cash = V
    Cash = Cash + V
    Cash = Cash >> 1
    Cash = Cash + V
    Cash = Cash + 100
    print at 2,9, "IT HOLDS DRAGON'S GOLD WORTH"
    print at 2,10, "$"
    NumU = Cash
    print at 3,10, width$(NumU, 3)
    Money = Money + Cash
    V = TGold00
  Icon2
    play sound SndGold
  end if
  if Ka = 1 then
    print at 2,9, "A GOBLIN LEAPS OUT,"
    print at 2,10, "STABBING YOU!"
    Nr = 200
    RndN
    Cash = V
    if Money > Cash then
      Money = Money - Cash
    else
      Money = 0
    end if
    play sound SndBash
  end if
  if Ka = 2 then
    print at 2,9, "A STRANGE SMOKE COMES OUT"
    print at 2,10, "MAKING YOU SLEEPY AND"
    print at 2,11, "SAPPING YOUR MAGIC POWER"
    Nr = 8
    RndN
    Cost = V + 1
    V = Mm[7]
    Sub0
    Mm[7] = V
    play sound SndEvil
  end if
  StatLine
  GoOn
  return
cn_potion:
  Potion = 1
  V = TPotion00
  Icon2
  print at 2,4, "YOU SEE A SMALL BOTTLE"
  print at 2,5, "ENGRAVED WITH CURIOUS,"
  print at 2,6, "TWISTED LETTERS..."
  print at 2,8, "WILL YOU DRINK THE POTION"
  print at 2,9, "WHICH YOU CAN SEE INSIDE THE"
  print at 2,10, "BOTTLE?"
  YesNo
  if Res = 0 then return
  Nr = 6
  RndN
  Cost = V + 1
  Rnd
  if Rb >= 154 then
    print at 2,12, "IT CONTAINED A POTION TO"
    print at 2,13, "ENHANCE YOUR WISDOM"
    Mw[7] = Mw[7] + Cost
    play sound SndAngel
  else
    print at 2,12, "IT CONTAINED A POTION WHICH"
    print at 2,13, "WEAKENS YOU FURTHER..."
    V = Ms[7]
    Sub0
    Ms[7] = V
    play sound SndEvil
  end if
  StatLine
  GoOn
  return
cn_scroll:
  Scroll = 1
  V = TScroll00
  Icon2
  print at 2,4, "YOU SEE A PAPYRUS SCROLL."
  print at 2,6, "DO YOU WISH TO TRY TO READ"
  print at 2,7, "IT?"
  YesNo
  if Res = 0 then return
  Rnd
  if Rb >= 128 then
    print at 2,9, "YOU CANNOT UNDERSTAND"
    print at 2,10, "THE LANGUAGE..."
    GoOn
    return
  end if
  print at 2,9, "IT CONTAINS A MAGIC SPELL."
  print at 2,10, "DO YOU WISH TO READ IT?"
  YesNo
  if Res = 0 then return
  Rnd
  if Rb >= 128 then
    print at 2,12, "IT WAS A BENEFICENT SPELL"
    Nr = 6
    RndN
    V = V + 1
    Mm[7] = Mm[7] + V
    play sound SndAngel
  else
    print at 2,12, "IT WAS AN EVIL SPELL"
    Mm[7] = 0
    V = Ms[7] >> 1
    Ms[7] = V
    play sound SndEvil
  end if
  StatLine
  GoOn
  return
cn_safe:
  Safe = 1
  V = TSafe00
  Icon2
  print at 2,4, "ON THE WALL IS A SMALL,"
  print at 2,5, "GILDED SAFE, AND IN FRONT"
  print at 2,6, "OF IT IS A KEY..."
  print at 2,8, "DO YOU WANT TO OPEN THE"
  print at 2,9, "SAFE?"
  YesNo
  if Res = 0 then return
  Rnd
  if Rb < 77 then
    print at 2,11, "A SHRIEKING HARPY FLIES OUT"
    print at 2,12, "AND SINKS ITS TEETH INTO"
    print at 2,13, "YOUR THROAT!"
    play sound SndRoar
    Pause
    print at 2,15, "YOU GRAPPLE WITH IT, AND..."
    Pause
    print at 2,16, "...FINALLY WRING ITS NECK"
    Nr = 6
    RndN
    Cost = V + 1
    V = Ms[7]
    Sub0
    Ms[7] = V
  else
    print at 2,11, "A CHOIR OF ANGELIC VOICES IS"
    print at 2,12, "HEARD....."
    play sound SndAngel
    Pause
    print at 2,14, "YOU ARE HEALED AND"
    print at 2,15, "REFRESHED..."
    Mm[7] = Mm[7] + 2
    Ms[7] = Ms[7] + 2
    Mw[7] = Mw[7] + 2
  end if
  StatLine
  GoOn
  return
end sub

' Icon2: a 2 x 2 picture (from code V) at column 26, row 3
sub Icon2:
  put char V at 26,3
  inc V
  put char V at 27,3
  inc V
  put char V at 26,4
  inc V
  put char V at 27,4
  return
end sub

' ---------------------------------------------------------------------------
' fights

' FoldDiff: DIFF = Hum - Mon, folded by sixes into -5..5 (the book's
' lines 2170-2180); Neg 1 when below 0, Diff its size
sub FoldDiff:
  if Hum >= Mon then
    Neg = 0
    Diff = Hum - Mon
  else
    Neg = 1
    Diff = Mon - Hum
  end if
fd_loop:
  if Diff > 5 then
    Diff = Diff - 6
    goto fd_loop
  end if
  if Diff = 0 then Neg = 0
  return
end sub

' RollDie: the book's victory rule: a die of 6; you win if DIFF < 0 and
' the roll is above |DIFF|, if DIFF > 0 and the roll is at most DIFF, or
' if DIFF = 0 and the roll is under 4
sub RollDie:
  Nr = 6
  RndN
  Roll = V + 1
  Vic = 0
  if Diff = 0 then
    if Roll < 4 then Vic = 1
  else
    if Neg = 1 then
      if Roll > Diff then Vic = 1
    else
      if Roll <= Diff then Vic = 1
    end if
  end if
  return
end sub

' Sub0: V less Cost, not under 0
sub Sub0:
  if V > Cost then
    V = V - Cost
  else
    V = 0
  end if
  return
end sub

' Effects: the book's fight effects: a few bashes, screams and rips
sub Effects:
  ClrText
  Nr = 10
  RndN
  Kc = V + 2
  for Ka = 1 to Kc
    Nr = 6
    RndN
    Nr = 10
    Y = Ka % 9
    Y = Y + 4
    X = Rb & 7
    X = X + 2
    if V = 0 then
      print at X,Y, "BASH!!!!"
      play sound SndBash
    end if
    if V = 1 then
      print at X,Y, "AAAAARGHHH!"
      play sound SndRoar
    end if
    if V = 2 then
      print at X,Y, "RIP..."
      play sound SndBash
      for J = 1 to 8
        Frame1
      next
      W = X + 10
      print at W,Y, "TEAR!"
    end if
    if V = 3 then
      print at 2,Y, "!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
      play sound SndBash
    end if
    if V = 5 then
      print at 2,Y, "!&&@!!  !&&@!!  !&&@!!"
      play sound SndRoar
    end if
    for J = 1 to 14
      Frame1
    next
  next
  ClrText
  return
end sub

' ---------------------------------------------------------------------------
' the screen

' GameScreen: the wall along the top, the status line
sub GameScreen:
  NewScreen
  backdrop dark blue
  fill TWall count 32 at 0,0
  fill TWall count 32 at 0,2
  StatLine
  ShowScreen
  return
end sub

' StatLine: your attributes and wealth on row 1
sub StatLine:
  fill 32 count 30 at 1,1
  print at 2,1, "M"
  NumU = Mm[7]
  print at 3,1, width$(NumU, 2)
  print at 7,1, "S"
  NumU = Ms[7]
  print at 8,1, width$(NumU, 2)
  print at 12,1, "W"
  NumU = Mw[7]
  print at 13,1, width$(NumU, 2)
  if Money > 0 then
    print at 18,1, "$"
    NumU = Money
    print at 19,1, width$(NumU, 4)
  end if
  return
end sub

' ClrText: rows 3-21
sub ClrText:
  for Y = 3 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

' RoomText: the book's description of room Zr (rows 3-17)
sub RoomText:
  V = Zr - 1
  Ka = RoomFirst[V]
  Kc = RoomFirst[Zr]
  Y = 3
  if Zr = 1 then
    ' the castle seen from the north
    for J = 0 to 4
      V = J << 3
      V = V + TCastle00
      for I = 0 to 7
        W = I + 12
        Kc = J + 12
        put char V at W,Kc
        inc V
      next
    next
    Kc = RoomFirst[1]
  end if
rt_line:
  if Ka < Kc then
    Uw = Ka
    Uw = Uw * 28
    Ub = Y
    Ub = Ub << 5
    Ub = Ub + 2
    copy RoomTxt + Uw count 28 to vram.name + Ub
    inc Ka
    inc Y
    goto rt_line
  end if
  if Sth[Zr] > 0 then
    Uw = LineSouth
    Uw = Uw * 28
    Ub = Y
    Ub = Ub << 5
    Ub = Ub + 2
    copy RoomTxt + Uw count 28 to vram.name + Ub
  end if
  return
end sub

' MonsterText: the book's words for monster Q (lines 310-355)
sub MonsterText:
  ShowMon
  play sound SndRoar
  if Q = 1 then
    print at 2,3, "THERE IS AN ANGRY WARLOCK IN"
    print at 2,4, "THE ROOM. HE HAS A MAGIC"
    print at 2,5, "RATING OF"
    NumU = Mm[1]
    print at 12,5, width$(NumU, 2)
    print at 2,6, "HIS STRENGTH IS"
    NumU = Ms[1]
    print at 18,6, width$(NumU, 2)
    print at 21,6, "AND"
    print at 2,7, "HIS WISDOM IS"
    NumU = Mw[1]
    print at 16,7, width$(NumU, 2)
  end if
  if Q = 2 then
    print at 2,3, "THE ROOM CONTAINS A FIRE-"
    print at 2,4, "BREATHING FEARBRINGER. HIS"
    print at 2,5, "WISDOM IS"
    NumU = Mw[2]
    print at 12,5, width$(NumU, 2)
    print at 15,5, "WHILE HE"
    print at 2,6, "HAS A STRENGTH RATING OF"
    NumU = Ms[2]
    print at 27,6, width$(NumU, 2)
    print at 2,7, "AND HIS MAGIC SKILL IS"
    NumU = Mm[2]
    print at 25,7, width$(NumU, 2)
  end if
  if Q = 3 then
    print at 2,3, "HORRORS! YOU'VE STUMBLED IN"
    print at 2,4, "ON THE HIDING PLACE OF AN"
    print at 2,5, "AWFUL SOULTHREAT. YOU CAN"
    print at 2,6, "SEE AT A GLANCE HIS STRENGTH"
    print at 2,7, "IS"
    NumU = Ms[3]
    print at 5,7, width$(NumU, 2)
    print at 2,8, "HIS MAGIC ABILITY RATES"
    NumU = Mm[3]
    print at 26,8, width$(NumU, 2)
    print at 2,9, "AND HIS WISDOM IS"
    NumU = Mw[3]
    print at 20,9, width$(NumU, 2)
  end if
  if Q = 4 then
    print at 2,3, "YOU'VE TRIPPED IN THE DARK."
    Pause
    print at 2,4, "SOMETHING AWAKES. OH, YOU'RE"
    print at 2,5, "FACE TO FACE WITH GRAVELPIT,"
    print at 2,6, "THE KNEECRUSHER, WHO HAS"
    print at 2,7, "MAGIC OF"
    NumU = Mm[4]
    print at 11,7, width$(NumU, 2)
    print at 2,8, "STRENGTH OF"
    NumU = Ms[4]
    print at 14,8, width$(NumU, 2)
    print at 17,8, "AND WISDOM"
    print at 2,9, "OF"
    NumU = Mw[4]
    print at 5,9, width$(NumU, 2)
  end if
  if Q = 5 then
    print at 2,3, "THIS ROOM HOLDS THE DREADED"
    print at 2,4, "ENEMY OF ALL WHO ENTER THE"
    print at 2,5, "CASTLE, WOLVLING OF WOLF"
    print at 2,6, "GLASS, WITH STRENGTH OF"
    NumU = Ms[5]
    print at 26,6, width$(NumU, 2)
    print at 2,7, "PLUS WISDOM OF"
    NumU = Mw[5]
    print at 17,7, width$(NumU, 2)
    print at 20,7, "AND"
    print at 2,8, "MAGIC OF"
    NumU = Mm[5]
    print at 11,8, width$(NumU, 2)
  end if
  return
end sub

' MonName: the monster's name after "THE" (row 3) - MonName2 on row 12
sub MonName:
  Y = 3
  X = 6
  if Vic = 1 then X = 19
  goto mn_print
sub MonName2:
  Y = 12
  X = 19
mn_print:
  if Q = 1 then print at X,Y, "WARLOCK"
  if Q = 2 then print at X,Y, "FEARBRINGER"
  if Q = 3 then print at X,Y, "SOULTHREAT"
  if Q = 4 then print at X,Y, "KNEECRUSHER"
  if Q = 5 then print at X,Y, "WOLVLING"
  return
end sub

' AttList: the magic, strength and wisdom of K (1-7) from row Y
sub AttList:
  print at 4,Y, "MAGIC:"
  NumU = Mm[K]
  print at 14,Y, width$(NumU, 3)
  inc Y
  print at 4,Y, "STRENGTH:"
  NumU = Ms[K]
  print at 14,Y, width$(NumU, 3)
  inc Y
  print at 4,Y, "WISDOM:"
  NumU = Mw[K]
  print at 14,Y, width$(NumU, 3)
  return
end sub

' ShowMon: monster Q's sprite at the top right
sub ShowMon:
  HideSprites
  if Q = 0 then return
  V = MonSpr[Q]
  W = MonCol[Q]
  set sprite 0 to 255, 224, V, W
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' choices on row 22

' OptPick: Nopt options at columns OptX[]; Sel 0-based; Res 1 for the
' second button
sub OptPick:
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
  Mode = 1
op_loop:
  if Res = 1 then
    for K = 0 to 5
      if K < Nopt then
        X = OptX[K] - 1
        V = 32
        if K = Sel then V = 62
        put char V at X,22
      end if
    next
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Sel > 0 then dec Sel
    end if
    if Rt1 = 1 then
      V = Sel + 1
      if V < Nopt then inc Sel
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Mode = 0
    Res = 1
    return
  end if
  if Press = 0 then goto op_loop
  Mode = 0
  Res = 0
  return
end sub

' ActMenu: N S E W FIGHT FLEE (Sel 0-5)
sub ActMenu:
  fill 32 count 30 at 1,22
  print at 3,22, "N  S  E  W  FIGHT  FLEE"
  OptX[0] = 3
  OptX[1] = 6
  OptX[2] = 9
  OptX[3] = 12
  OptX[4] = 15
  OptX[5] = 22
  Nopt = 6
  if Sel >= 6 then Sel = 0
  OptPick
  return
end sub

' AttMenu: MAGIC STRENGTH WISDOM (Sel 0-2)
sub AttMenu:
  fill 32 count 30 at 1,22
  print at 3,22, "MAGIC  STRENGTH  WISDOM"
  OptX[0] = 3
  OptX[1] = 10
  OptX[2] = 20
  Nopt = 3
  Sel = 0
bm_go:
  OptPick
  if Res = 1 then goto bm_go
  fill 32 count 30 at 1,22
  return
end sub

' BuyMenu: MAGIC STRENGTH WISDOM DONE (Sel 0-3)
sub BuyMenu:
  fill 32 count 30 at 1,22
  print at 3,22, "MAGIC STRENGTH WISDOM DONE"
  OptX[0] = 3
  OptX[1] = 9
  OptX[2] = 18
  OptX[3] = 25
  Nopt = 4
  Sel = 3
by_go:
  OptPick
  if Res = 1 then goto by_go
  fill 32 count 30 at 1,22
  return
end sub

' YesNo: Res 1 for YES, 0 for NO
sub YesNo:
  fill 32 count 30 at 1,22
  print at 3,22, "YES  NO"
  OptX[0] = 3
  OptX[1] = 8
  Nopt = 2
  Sel = 0
yn_go:
  OptPick
  if Res = 1 then goto yn_go
  fill 32 count 30 at 1,22
  Res = 1 - Sel
  return
end sub

' GoOn: the button goes on (the book's pauses)
sub GoOn:
  fill 32 count 30 at 1,22
  print at 18,22, "BUTTON: ON"
  WasBtn = 1
  Mode = 2
go_loop:
  Frame1
  Rnd
  ReadPad
  if Press = 0 then goto go_loop
  Mode = 0
  fill 32 count 30 at 1,22
  return
end sub

' NameEntry: up to 8 letters; up and down change the letter, left and
' right move, the button ends (Res 0); the second button leaves (Res 1)
sub NameEntry:
  for Pos = 0 to 7
    Name[Pos] = 32
  next
  Name[0] = 65
  Pos = 0
  print at 2,22, "BUTTON: DONE   2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
  Mode = 3
ne_loop:
  if Res = 1 then
    put Name at 10,8
    for K = 0 to 7
      X = K + 10
      V = 32
      if K = Pos then V = 45
      put char V at X,9
    next
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    V = Name[Pos]
    if Up1 = 1 then
      if V = 32 then
        V = 65
      else
        inc V
        if V > 90 then V = 32
      end if
      Name[Pos] = V
    end if
    if Dn1 = 1 then
      if V = 32 then
        V = 90
      else
        dec V
        if V < 65 then V = 32
      end if
      Name[Pos] = V
    end if
    if Rt1 = 1 then
      if Pos < 7 then
        inc Pos
        V = Name[Pos]
        if V = 32 then Name[Pos] = 65
      end if
    end if
    if Lf1 = 1 then
      if Pos > 0 then dec Pos
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Mode = 0
    Res = 1
    return
  end if
  if Press = 0 then goto ne_loop
  Mode = 0
  Res = 0
  return
end sub

' ---------------------------------------------------------------------------
' Common

sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

sub EndWait:
  fill 32 count 30 at 1,22
  print at 8,22, "PRESS A BUTTON"
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
  Mode = 4
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then goto ew_done
  if Press = 0 then goto ew_loop
ew_done:
  Mode = 0
  HideSprites
  return
end sub

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Uw = Uw * Nr
  Uw = Uw >> 8
  V = Uw
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  sprites stable 0 to 0
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop dark blue
  print at 4,1, "THE BANNOCHBURN LEGACY"
  for J = 0 to 4
    V = J << 3
    V = V + TCastle00
    for I = 0 to 7
      W = I + 12
      Kc = J + 3
      put char V at W,Kc
      inc V
    next
  next
  fill TWall count 32 at 0,8
  print at 10,11, "ENTER THE CASTLE"
  print at 10,12, "HOW TO PLAY"
  print at 10,13, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 11 to 13
    print at 8,I, " "
  next
  Y = Menu + 11
  print at 8,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  TzOn = 0
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "FIND THE DOOR TO THE BLACK"
  print at 2,4, "LAGOON AND BEAT ITS GUARDIAN"
  print at 2,5, "IN MAGIC, STRENGTH AND"
  print at 2,6, "WISDOM, ENDING WITH 10"
  print at 2,7, "POINTS OR MORE IN ALL."
  print at 2,9, "MONSTERS ROAM THE CASTLE:"
  print at 2,10, "FIGHT WITH YOUR BEST"
  print at 2,11, "ATTRIBUTE, OR TRY TO FLEE."
  print at 2,13, "GOLD BUYS POINTS ($100) AT"
  print at 2,14, "THE LAGOON. MAKE A MAP!"
  print at 2,16, "STICK: CHOOSE (N S E W..."
  print at 2,17, "ON ROW 22). BUTTON: GO."
  print at 2,18, "2ND BUTTON: QUIT."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 4,1, "THE BANNOCHBURN LEGACY"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983)."
  print at 2,9, "MUSIC: THE LAIRD'S LAMENT"
  print at 2,10, "(ORIGINAL)."
  print at 2,12, "COLECOVISION VERSION BY"
  print at 2,13, "AMY BIENVENU, 2026."
  PageWait
  return
end sub

