' Generated from a 0.35-second WAV containing A4 (440 Hz) and E5 (660 Hz).
' The spectral converter preserved both tones as two concurrent BIOS sounds.

sub start:
  set sound table SpectralChimeTable areas 2
  text screen
  print centered at 7, "SPECTRAL WAV SFX"
  print centered at 10, "TWO TONE CHANNELS"
  print centered at 14, "PRESS FIRE TO REPLAY"
  screen on
  wait 4 frames

replay:
  play sounds 1,2
  wait no fire
  pause until press
  goto replay
end sub

asm {
SpectralChimeTable:
    dw SpectralChimeVoice1,$702B
    dw SpectralChimeVoice2,$7035

SpectralChimeVoice1:
    db $40,$A9,$60,$15
    db $50

SpectralChimeVoice2:
    db $80,$FE,$50,$15
    db $90
}
