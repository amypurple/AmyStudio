Ship Sh[4]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 4 Score = 0
bcd digits 4 Best = 0
u8 Lv = 1
u8 Energy = 0
u8 Chase = 0
u8 LightCol = 0
u8 Phase = 0
u8 Hold = 0
u8 Gauge = 0
u8 Lo = 0
u8 Hi = 0
u8 Docked = 0
u8 Over = 0
u8 Won = 0
u8 Toggles = 0
u8 Pulse = 0
' input
u8 J1 = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Si = 0
u8 Ri = 0
u8 Ti = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table FsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

level_start:
  StartLevel

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawShips
  if Docked = 1 then goto dock_done
  if Over = 0 then goto play_loop

  ' out of energy
  mute all
  play sound SndOut
  EndBox
  print at 9,11, "OUT OF ENERGY"
  goto the_end

dock_done:
  FuelUp
  Score += Energy
  if Lv < 4 then
    inc Lv
    goto level_start
  end if
  Won = 1
  mute all
  play sound SndWin
  EndBox
  print at 6,11, "MISSION ACCOMPLISHED"

the_end:
  if Score > Best then Best = Score
  print at 8,13, "ENERGY SAVED ", Score
  print at 8,14, "BEST         ", Best
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the stick turns saucers round, every saucer moves
' (half speed inside the dock), the docking clock, the energy
sub PlayStep:
  u8 Yv = 0
  u8 Dv = 0
  u8 Inside = 0
  for Si = 0 to 3
    K = PadBit[Si]
    V = Edge & K
    if V > 0 then
      Sh[Si].D = Sh[Si].D ^ 1
      inc Toggles
      play sound TogSnd[Si]
    end if
  next
  Phase = Phase ^ 1
  Inside = 0
  for Si = 0 to 3
    Yv = Sh[Si].Y
    Dv = Sh[Si].D
    if Yv >= 200 then Dv = 1
    if Yv < 60 then Dv = 0
    if InDock(Yv) = 0 or Phase = 0 then
      if Dv = 1 then
        Yv = Yv - Sh[Si].Up
      else
        Yv = Yv + Sh[Si].Dn
      end if
    end if
    Sh[Si].Y = Yv
    Sh[Si].D = Dv
    Sh[Si].In = InDock(Yv)
    Inside = Inside + Sh[Si].In
  next
  if Inside = 4 then
    inc Hold
    if Hold = 1 then play sound SndLock
  else
    Hold = 0
  end if
  ShowGauge
  if Hold >= HoldT[Lv - 1] then Docked = 1
  if Docked = 0 then EnergyTick
  return
end sub

' 1 when a saucer top at C64 row Yv is inside this level's dock
function InDock(u8 Yv) as u8
  if Yv < Lo then return 0
  if Yv >= Hi then return 0
  return 1

' the light runs along the rails once per energy unit
sub EnergyTick:
  inc Chase
  if Chase >= ChaseLen then
    Chase = 0
    dec Energy
    ShowEnergy
    if Energy = 0 then Over = 1
  end if
  V = Chase * 4 / 5
  if V <> LightCol then
    RailCell(LightCol, 0)
    LightCol = V
    RailCell(LightCol, 1)
  end if
  return
end sub

' the rail tile for column Col of the top (Top = 1) or bottom rail
function RailTile(u8 Col, u8 Top, u8 Lit) as u8
  u8 T = 0
  T = TRl0
  select case Col
    case 9, 16, 23
      if Top = 1 then
        T = TRd0
      else
        T = TRu0
      end if
  end select
  return T + Lit * 3

sub RailCell(u8 Col, u8 Lit)
  J = TopRow[Lv - 1]
  K = RailTile(Col, 1, Lit)
  if Lv = 4 then
    ' dock 4's eased edge: the top rail 4 pixels higher, over two rows
    put char TSa0 + Lit * 3 at Col,J - 1
    K = K - TRl0 + TSl0
  end if
  put char K at Col,J
  J = BotRow[Lv - 1]
  K = RailTile(Col, 0, Lit)
  put char K at Col,J
  return
end sub

sub DrawRails:
  for Ri = 0 to 31
    RailCell(Ri, 0)
  next
  return
end sub

' the docking gauge: 8 cells in the status line
sub ShowGauge:
  W16 = Hold
  W16 = W16 * 8
  W16 = W16 / HoldT[Lv - 1]
  V = W16
  if V > 8 then V = 8
  ' only the cells that changed (the gauge grows one cell at a time)
  if V > Gauge then
    for Ri = Gauge to V - 1
      put char TGf at Ri + 14,1
    next
  end if
  if V < Gauge then
    for Ri = V to Gauge - 1
      put char TGe at Ri + 14,1
    next
  end if
  Gauge = V
  return
end sub

sub ShowEnergy:
  NumU = Energy
  print at 9,1, digits$(NumU, 3)
  return
end sub

' a random height 60-199, as the C64's SID noise loop
function RandY() as u8
  u8 R = 0
  R = 0
  while R < 60
    Rand
    R = Rs & 255
    if R >= 200 then R = 0
  end while
  return R

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' sprites 0-3: the saucers, lit inside the dock (Pulse: the fuelling glow)
sub DrawShips:
  u8 Yv = 0
  u8 Cv = 0
  for Si = 0 to 3
    Yv = Sh[Si].Y
    Cv = ColDim[Si]
    if Sh[Si].In = 1 then Cv = ColLit[Si]
    if Pulse = 1 then Cv = 15
    set sprite Si to Yv - 40,ShipX[Si],SSau,Cv
  next
  update sprites
  return
end sub

' FUELING IN PROGRESS: the hum, the saucers glow (3 times a second at
' most), about two and a half seconds
sub FuelUp:
  mute all
  play sound SndFuel
  fill 32 count 28 at 2,22
  print at 6,22, "FUELING IN PROGRESS"
  for Ti = 1 to 150
    Frame1
    V = Ti / 12
    Pulse = V & 1
    DrawShips
  next
  Pulse = 0
  return
end sub

sub EndBox:
  HideSprites
  for Ri = 9 to 15
    fill 32 count 24 at 4,Ri
  next
  return
end sub

sub NewGame:
  copy ShipStart to Sh
  Score = 0
  Lv = 1
  Over = 0
  Won = 0
  Toggles = 0
  return
end sub

sub StartLevel:
  NewScreen
  copy StarMap count 768 to vram.name
  Lo = BandLo[Lv - 1]
  Hi = BandHi[Lv - 1]
  Sh[0].Y = 198
  Sh[1].Y = RandY()
  Sh[2].Y = 198
  Sh[3].Y = RandY()
  for Si = 0 to 3
    Sh[Si].In = InDock(Sh[Si].Y)
  next
  Energy = EnergyStart
  Chase = 0
  LightCol = 0
  Phase = 0
  Hold = 0
  Gauge = 0
  Docked = 0
  Pulse = 0
  DrawRails
  RailCell(0, 1)
  print at 2,1, "ENERGY"
  ShowEnergy
  fill TGe count 8 at 14,1
  NumU = Lv
  print at 23,1, "LEVEL ", digits$(NumU, 1)
  put char TArL at 5,22
  put char TArU at 12,22
  put char TArD at 19,22
  put char TArR at 26,22
  DrawShips
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasJ = 15
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  V = J1 & 15
  Edge = V ^ WasJ
  Edge = Edge & V
  WasJ = V
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites flicker off
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: FUELING STATION in station panels, four saucers bobbing in
' their bays, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  print at 6,1, "AHOY! DECEMBER 1987"
  copy TitleMap count 352 to vram.name + 96
  print at 9,18, "BY JOHN KRUTCH"
  print at 13,20, "START"
  print at 13,21, "CREDITS"
  if Best > 0 then
    print at 11,22, "BEST ", Best
  end if
  copy ShipStart to Sh
  for Si = 0 to 3
    Sh[Si].Y = 154 + Si * 4
  next
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the saucers bob between C64 rows 152 and 171 (screen rows 14-17) at
' their own speeds, every other frame
sub TitleAnim:
  u8 Yv = 0
  V = Tick & 1
  if V = 0 then
    for Si = 0 to 3
      Yv = Sh[Si].Y
      if Yv >= 170 then Sh[Si].D = 1
      if Yv < 152 then Sh[Si].D = 0
      if Sh[Si].D = 1 then
        Sh[Si].Y = Yv - Sh[Si].Up
      else
        Sh[Si].Y = Yv + Sh[Si].Dn
      end if
      Sh[Si].In = 0
    next
  end if
  DrawShips
  return
end sub

sub ShowMenu:
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 20
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "FUELING STATION"
  print at 2,5, "BASED ON FUELING STATION"
  print at 2,6, "BY JOHN KRUTCH, AHOY!"
  print at 2,7, "DECEMBER 1987 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: DOCKING BAY FOUR"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

