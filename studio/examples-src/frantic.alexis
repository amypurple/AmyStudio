  $00,$00,$00,$00,$03,$03,$07,$07
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00
  $07,$07,$07,$F0,$F0,$F0,$F0,$F0
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00
  $E0,$E0,$E0,$E0,$E0,$C0,$C0,$C0
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00
