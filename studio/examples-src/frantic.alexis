cartridge "THE FRANTIC FISHERMAN/COMPUTE'S GAZETTE/1984"

' THE FRANTIC FISHERMAN
' A ColecoVision game based on "The Frantic Fisherman", COMPUTE!'s Gazette
' June 1984 (Commodore 64 BASIC + machine language, and a VIC-20 BASIC
' version on the same disk; no author named in the listings). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the C64
' machine code and the VIC-20 listing in orig/, and watched in jsc64), the
' game is built for the ColecoVision: smooth 16 x 16 sprites, a tiled sea,
' sky and sailboat, sound effects and an original title tune.
'
' The game: a fisherman stands at one end of his sailboat's deck. One
' danger comes at a time, at random: a shark swimming in from the left (it
' attacks the left end of the boat), a shark from the right (the right
' end), or a raindrop falling on the left or the right end. Stand at that
' end and press the button at the right moment: against a shark you swing
' the oar down into the water (75 points), against rain you open the
' umbrella (50 points). A shark that reaches the boat, or a drop that
' reaches the fisherman or the deck, costs a fisherman. Three fishermen;
' one more every 2000 points. The game is over when all are lost.
'
' From the original: the two ends of the deck and the instant change of
' end, the four dangers drawn with equal chance, the oar on the outer side
' of the end you stand at, the umbrella over your head, 75 and 50 points,
' three fishermen, one more every 2000 points (C64 $C31F), a 6-digit score
' and a high score, the four speeds chosen before play (C64 f1/f3/f5/f7,
' delays 25/18/13/9; the speeds here are those delays measured in jsc64:
' a shark crosses its path in about 1.9 s and a drop falls in about 1.8 s
' at the slowest), at most three swings or umbrellas against one danger
' (VIC-20 line 3500).
'
' Liberties: the VIC-20 version also speeds the game up at every extra
' fisherman (DE = DE - 4); here every extra fisherman adds 2/16 pixel a
' frame, up to 8 times (the C64 never speeds up). The fisherman slides to
' the other end in 4 frames instead of jumping. An oar swing or umbrella
' lasts 8 frames and needs a new press after a 20-frame rest (the C64
' let a held space bar repeat); moving cancels it. The oar reaches a shark
' in its last 10 pixels before the hull, the umbrella a drop in its last
' 12 pixels: a human-paced player never lost at the fastest speed with
' wider reaches. A splash shows where a
' danger was beaten; a lost fisherman's coat turns grey for a moment. The
' speed is chosen on the title with the joystick instead of the f-keys.
'
' Controls: either controller. Left / right: go to that end of the boat.
' Either button: swing the oar or open the umbrella. On the title, up and
' down choose, left and right change the speed, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes.

const TSky = 128
const TCla00 = 129
const TCla01 = 130
const TCla02 = 131
const TCla03 = 132
const TCla04 = 133
const TCla05 = 134
const TCla10 = 135
const TCla11 = 136
const TCla12 = 137
const TCla13 = 138
const TCla14 = 139
const TCla15 = 140
const TClb00 = 141
const TClb01 = 142
const TClb02 = 143
const TClb03 = 144
const TClb10 = 145
const TClb11 = 146
const TClb12 = 147
const TClb13 = 148
const TSun00 = 149
const TSun01 = 150
const TSun10 = 151
const TSun11 = 152
const TSail00 = 153
const TSail01 = 154
const TSail02 = 155
const TSail10 = 156
const TSail11 = 157
const TSail12 = 158
const TSail20 = 159
const TSail21 = 160
const TSail22 = 161
const TSail30 = 162
const TSail31 = 163
const TSail32 = 164
const TSail40 = 165
const TSail41 = 166
const TSail42 = 167
const TSail50 = 168
const TSail51 = 169
const TSail52 = 170
const TSail60 = 171
const TSail61 = 172
const TSail62 = 173
const TSail70 = 174
const TSail71 = 175
const TSail72 = 176
const TSail80 = 177
const TSail81 = 178
const TSail82 = 179
const THull00 = 180
const THull01 = 181
const THull02 = 182
const THull03 = 183
const THull04 = 184
const THull05 = 185
const THull06 = 186
const THull07 = 187
const THull08 = 188
const THull09 = 189
const THull10 = 190
const THull11 = 191
const THull12 = 192
const THull13 = 193
const THull14 = 194
const THull15 = 195
const THull16 = 196
const THull17 = 197
const THull18 = 198
const THull19 = 199
const TSurf = 200
const TSea = 201
const TSeab = 202
const TSeac = 203
const TIcon = 204
const SCoatr = 0
const SSkinr = 4
const SBootr = 8
const SCoatl = 12
const SSkinl = 16
const SBootl = 20
const SOarl = 24
const SOarr = 28
const SUmb = 32
const SSharkr = 36
const SSharkl = 40
const SDrop = 44
const SSplash = 48
const NTiles8 = 616
const SprBytes = 416
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndSwing = 4
const SndUmb = 5
const SndWhack = 6
const SndPlip = 7
const SndLost = 8
const SndLife = 9
const SndStart = 10
const SndOver = 11
const NSpr = 6
const LeftX = 96
const RightX = 144
const ManY = 111
const SharkY = 127
const ActN = 8
const CoolN = 20
const GapN = 20
const HitN = 24
const LostN = 80
const MaxUses = 3
' phases of play
const PGap = 0
const PRun = 1
const PHit = 2
const PLost = 3
' danger kinds
const KSharkL = 0
const KSharkR = 1
const KDropL = 2
const KDropR = 3

' speeds in 1/16 pixel a frame for the C64's four delays (25, 18, 13, 9)
data SharkSpd bytes
  9, 13, 17, 25
end data
data DropSpd bytes
  12, 17, 23, 34
end data
data SpeedTxt chars "SLOW  STEADYBRISK FRANTIC"

record Danger:
  u8 Kind
  u8 X
  u8 Y
  u8 F
  u8 Spd
end record

Danger Hz
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
bcd digits 6 NextLife = 2000
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u8 Speed = 1
u8 Boost = 0
u8 Lives = 3
u8 Over = 0
u8 Phase = 0
u8 Tm = 0
u8 Fx = LeftX
u8 Tgt = LeftX
u8 Face = 0
u8 Act = 0
u8 Cool = 0
u8 Uses = 0
u8 Gained = 0
u8 Got = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Rw = 0
u8 Si = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FfSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  print at 9,10, "             "
  print at 9,11, "  GAME OVER  "
  print at 9,12, "             "
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveMan
  ' the oar or umbrella: 12 frames out, then a 14-frame rest
  if Act > 0 then
    dec Act
    if Act = 0 then Cool = CoolN
  elseif Cool > 0 then
    dec Cool
  end if
  if Press = 1 then TryAct
  select case Phase
  case PGap
    dec Tm
    if Tm = 0 then Spawn
  case PRun
    MoveDanger
    if Struck = 1 then
      Beaten
    elseif Reached = 1 then
      LoseMan
    end if
  case PHit
    dec Tm
    if Tm = 0 then
      Phase = PGap
      Tm = GapN
    end if
  case else
    dec Tm
    if Tm = 0 then
      if Lives = 0 then
        Over = 1
      else
        Phase = PGap
        Tm = GapN
      end if
    end if
  end select
  return
end sub

' the stick picks an end; the fisherman slides 12 pixels a frame
sub MoveMan:
  K = J1 | J2
  V = K & 4
  if V > 0 then
    if Tgt <> LeftX then
      Tgt = LeftX
      Face = 0
      play sound SndStep
    end if
  end if
  V = K & 8
  if V > 0 then
    if Tgt <> RightX then
      Tgt = RightX
      Face = 1
      play sound SndStep
    end if
  end if
  if Fx = Tgt then return
  if Act > 0 then
    Act = 0
    Cool = CoolN
  end if
  if Fx < Tgt then
    Fx = Fx + 12
  else
    Fx = Fx - 12
  end if
  return
end sub

' 0 at the left end, 1 at the right end, 2 on the way
function EndOf as u8
  if Fx = LeftX then return 0
  if Fx = RightX then return 1
  return 2

sub TryAct:
  if Phase <> PRun then return
  if Act > 0 then return
  if Cool > 0 then return
  if Uses >= MaxUses then return
  if EndOf >= 2 then return
  Act = ActN
  inc Uses
  if Hz.Kind < KDropL then
    play sound SndSwing
  else
    play sound SndUmb
  end if
  return
end sub

' a new danger: kind at random (equal chances)
sub Spawn:
  Rand
  V = Rs & 3
  Hz.Kind = V
  Hz.F = 0
  Uses = 0
  K = Speed - 1
  select case V
  case KSharkL
    Hz.X = 16
    Hz.Y = SharkY
    C = SharkSpd[K]
  case KSharkR
    Hz.X = 224
    Hz.Y = SharkY
    C = SharkSpd[K]
  case KDropL
    Hz.X = LeftX
    Hz.Y = 16
    C = DropSpd[K]
  case else
    Hz.X = RightX
    Hz.Y = 16
    C = DropSpd[K]
  end select
  Hz.Spd = C + Boost
  Phase = PRun
  return
end sub

' sub-pixel steps: F collects 1/16 pixels
sub MoveDanger:
  V = Hz.F + Hz.Spd
  K = V >> 4
  Hz.F = V & 15
  select case Hz.Kind
  case KSharkL
    Hz.X = Hz.X + K
  case KSharkR
    Hz.X = Hz.X - K
  case else
    Hz.Y = Hz.Y + K
  end select
  return
end sub

' 1 when the oar or umbrella out at the right end meets the danger
function Struck as u8
  if Act = 0 then return 0
  J = EndOf
  X = Hz.X
  Y = Hz.Y
  select case Hz.Kind
  case KSharkL
    if J = 0 then
      if X >= 70 then return 1
    end if
  case KSharkR
    if J = 1 then
      if X <= 170 then return 1
    end if
  case KDropL
    if J = 0 then
      if Y >= 88 then return 1
    end if
  case else
    if J = 1 then
      if Y >= 88 then return 1
    end if
  end select
  return 0

' 1 when the danger got through: a shark at the hull, a drop on the
' fisherman's head (or on the deck when he isn't there)
function Reached as u8
  X = Hz.X
  Y = Hz.Y
  select case Hz.Kind
  case KSharkL
    if X >= 80 then return 1
  case KSharkR
    if X <= 160 then return 1
  case KDropL
    if Fx = LeftX then
      if Y >= 100 then return 1
    end if
    if Y >= 116 then return 1
  case else
    if Fx = RightX then
      if Y >= 100 then return 1
    end if
    if Y >= 116 then return 1
  end select
  return 0

sub Beaten:
  if Hz.Kind < KDropL then
    AddPoints(75)
    play sound SndWhack
  else
    AddPoints(50)
    play sound SndPlip
  end if
  if Gained = 1 then play sound SndLife
  Phase = PHit
  Tm = HitN
  return
end sub

sub AddPoints(u8 P):
  Score += P
  Gained = 0
  if Score >= NextLife then
    NextLife += 2000
    if Lives < 9 then inc Lives
    if Boost < 16 then Boost = Boost + 2
    Gained = 1
  end if
  ShowHud
  return
end sub

sub LoseMan:
  dec Lives
  ShowHud
  Act = 0
  Phase = PLost
  Tm = LostN
  play sound SndLost
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites: 0 face and hands, 1 boots, 2 coat, 3 oar or umbrella, 4 the
' danger, 5 a splash
sub DrawSprites:
  if Face = 0 then
    K = SCoatl
  else
    K = SCoatr
  end if
  V = K + 4
  set sprite 0 to ManY,Fx,V,9
  V = K + 8
  set sprite 1 to ManY,Fx,V,1
  C = 11
  if Phase = PLost then C = 14
  set sprite 2 to ManY,Fx,K,C
  ' the oar or the umbrella
  if Act > 0 then
    if Hz.Kind < KDropL then
      if Fx = LeftX then
        X = Fx - 16
        set sprite 3 to 119,X,SOarl,10
      else
        X = Fx + 16
        set sprite 3 to 119,X,SOarr,10
      end if
    else
      set sprite 3 to 95,Fx,SUmb,8
    end if
  else
    set sprite 3 to 192,0,0,0
  end if
  ' the danger and the splash
  Y = Hz.Y - 1
  set sprite 5 to 192,0,0,0
  if TitleOn = 1 then
    DangerSprite
  elseif Phase = PRun then
    DangerSprite
  elseif Phase = PLost then
    DangerSprite
  elseif Phase = PHit then
    set sprite 4 to 192,0,0,0
    set sprite 5 to Y,Hz.X,SSplash,15
  else
    set sprite 4 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub DangerSprite:
  select case Hz.Kind
  case KSharkL
    set sprite 4 to Y,Hz.X,SSharkr,14
  case KSharkR
    set sprite 4 to Y,Hz.X,SSharkl,14
  case else
    set sprite 4 to Y,Hz.X,SDrop,4
  end select
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 8,1, Score
  print at 15,1, "HI"
  print at 18,1, Hi
  put char TIcon at 26,1
  NumU = Lives
  print at 28,1, digits$(NumU, 1)
  return
end sub

' the scene, rows 2-23, from the map
sub DrawScene:
  for Rw = 2 to 23
    W16 = Rw - 2
    W16 = W16 << 5
    A16 = Rw
    A16 = A16 << 5
    copy SceneMap + W16 count 32 to vram.name + A16
  next
  return
end sub

sub NewGame:
  Score = 0
  NextLife = 2000
  Lives = 3
  Boost = 0
  NewScreen
  DrawScene
  ShowHud
  Fx = LeftX
  Tgt = LeftX
  Face = 0
  Act = 0
  Cool = 0
  Uses = 0
  Phase = PGap
  Tm = 60
  Over = 0
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the boat, a shark circling, the tune once, the menu
sub TitlePage:
  NewScreen
  DrawScene
  for Rw = 2 to 9
    fill 32 count 32 at 0,Rw
  next
  print at 5,3, "THE FRANTIC FISHERMAN"
  print at 2,4, "COMPUTE!'S GAZETTE JUNE 1984"
  print at 10,6, "START GAME"
  print at 10,7, "SPEED"
  print at 10,8, "CREDITS"
  print at 15,1, "HI"
  print at 18,1, Hi
  ShowMenu
  TitleOn = 1
  Fx = LeftX
  Tgt = LeftX
  Face = 0
  Act = 0
  Phase = PGap
  Hz.Kind = KSharkL
  Hz.X = 16
  Hz.Y = SharkY
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 472
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleShark
  DrawSprites
  V = J1 | J2
  V = V & 15
  if V > 0 then
    if WasStick = 0 then MenuStick
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 1 then
    NextSpeed
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub MenuStick:
  K = V & 1
  if K > 0 then
    if Menu > 0 then dec Menu
  end if
  K = V & 2
  if K > 0 then
    if Menu < 2 then inc Menu
  end if
  if Menu = 1 then
    K = V & 8
    if K > 0 then NextSpeed
    K = V & 4
    if K > 0 then
      dec Speed
      if Speed = 0 then Speed = 4
    end if
  end if
  ShowMenu
  return
end sub

sub NextSpeed:
  inc Speed
  if Speed > 4 then Speed = 1
  ShowMenu
  return
end sub

' a shark patrols round the boat on the title (sprite 4 is drawn here)
sub TitleShark:
  inc Si
  if Si > 2 then Si = 0
  if Si = 0 then
    if Hz.Kind = KSharkL then
      inc Hz.X
      if Hz.X >= 224 then Hz.Kind = KSharkR
    else
      dec Hz.X
      if Hz.X <= 16 then Hz.Kind = KSharkL
    end if
  end if
  return
end sub

sub ShowMenu:
  put char 32 at 8,6
  put char 32 at 8,7
  put char 32 at 8,8
  J = Menu + 6
  put char 62 at 8,J
  NumU = Speed
  print at 16,7, digits$(NumU, 1)
  W16 = Speed - 1
  W16 = W16 * 6
  copy SpeedTxt + W16 count 6 to vram.name + 242
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 4,2, "THE FRANTIC FISHERMAN"
  print at 2,5, "BASED ON THE FRANTIC"
  print at 2,6, "FISHERMAN, COMPUTE!'S"
  print at 2,7, "GAZETTE, JUNE 1984"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: ROLLING SWELL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

