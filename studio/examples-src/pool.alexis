const TPkt2 = 141
const TPkb1 = 142
const TPkb2 = 143
const TBall0 = 144
const TBall1 = 145
const TBall2 = 146
const TBall3 = 147
const TBall4 = 148
const TBall5 = 149
const TBall6 = 150
const TPow = 151
const TPow0 = 152
const TCue1 = 153
const TCue2 = 154
const SBall = 0
const SAim = 4
const NTiles8 = 216
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndRail = 3
const SndCue = 4
const SndClack = 5
const SndDrop = 6
const SndFoul = 7
const SndWin = 8
const SndMove = 9

