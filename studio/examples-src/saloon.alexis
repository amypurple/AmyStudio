  32,32,32,32,32,32,32,32,32,32,214,215,218,219,221,222,225,226,225,226,229,230,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,212,213,231,232,223,224,223,224,233,234,223,224,220,237,233,234,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,214,215,218,219,225,226,225,226,235,236,225,226,225,226,235,236,32,32,32,32,32,32,32,32
end data
data CardTop bytes 153,152,151,150,149

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Score = 0
u16 HiSc = 0
u16 MPx = 0
u8 R8 = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
u8 Phase = 0
u8 Why = 0
u8 Cx = 0
u8 Cy = 0
u8 Hc = 0
u8 Ammo = 0
u8 TimeU = 0
u8 TimeF = 0
u8 Bonus = 0
u8 MugX[9]
u8 MugY[9]
u8 MugSt[9]
u8 MugF = 0
u8 SpawnT = 0
u8 MugHits = 0
u8 StepT = 0
u8 WinSt = 0
u8 WinW = 0
u8 WinT = 0
u8 WinBad = 0
u8 CardV[5]
u8 CardF[5]
u8 CardSh[3]
u8 CardO = 0
u8 CardT = 0
u8 Want = 0
u8 MouseOn = 0
u8 MDir = 0
u8 MLev = 0
u8 PnoN = 0
u8 PuffT = 0
u8 PuffX = 0
u8 PuffY = 0
u8 MsgT = 0
u8 RollT = 0
u8 RollP = 0
u8 NewHi = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Pi = 0
u8 Ri = 0
u8 Ci = 0
' scratch
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SsSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    CreditsPage
    goto title
  end if
  NewGame
  DrawSaloon
  ShowHud
  DrawSprites
  ShowScreen

play_loop:
  Frame1
  ReadPads
  PlayStep
  DrawSprites
  Cosmetic
  inc Tick
  if Phase = 0 then goto play_loop

  ' the end: the reason, the score, then back to the title on a press
  mute all
  play sound SndOver
  if Why = 0 then
    print at 2,MsgRow, "         TIME'S UP!         "
  else
    print at 2,MsgRow, "      OUT OF BULLETS!       "
  end if
  NewHi = 0
  if Score > HiSc then
    HiSc = Score
    NewHi = 1
  end if
  ShowScore
  Rearm
  wait 90 frames
  nmi off
  if NewHi = 1 then
    print at 2,MsgRow, "      NEW HIGH SCORE!       "
  else
    print at 2,MsgRow, "      PRESS THE BUTTON      "
  end if
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the game

sub NewGame:
  Score = 0
  Ammo = FullAmmo
  TimeU = 200
  TimeF = 32
  Bonus = 0
  Cx = 128
  Cy = 100
  Hc = 0
  for Mi = 0 to 8
    MugSt[Mi] = 0
    MugX[Mi] = 0
    MugY[Mi] = 0
  next
  MugF = 0
  SpawnT = 32
  MugHits = 0
  StepT = 16
  WinSt = 0
  WinW = 0
  WinBad = 0
  Rand
  WinT = 32 + (R8 & 31)
  CardO = 0
  CardT = 32
  Want = 5
  Shuffle
  MouseOn = 0
  MPx = 0
  MDir = 0
  MLev = 0
  PnoN = 0
  PuffT = 0
  MsgT = 0
  Phase = 0
  Why = 0
  ' a button still held from the title must be let go first
  Pads = 16
  OldPads = 16
  return
end sub

' one pass (one frame) of play
sub PlayStep:
  MoveSight
  if (Pads & 16) <> 0 then
    if (OldPads & 16) = 0 then Shoot
  end if
  MugStep
  dec SpawnT
  if SpawnT = 0 then
    SpawnT = 32
    Spawn
  end if
  dec StepT
  if StepT = 0 then
    StepT = 16
    WinStep
  end if
  WinFrame
  dec CardT
  if CardT = 0 then
    CardT = 32
    Turn
  end if
  if MouseOn = 0 then
    if MugHits = 10 then
      MouseOn = 1
      MPx = MugX0 * 256
      MDir = 0
      MLev = 0
      play sound SndSqueak
    end if
  else
    MouseStep
  end if
  Clock
  return
end sub

sub MoveSight:
  u8 Sp = 2
  if (Pads & 15) = 0 then
    Hc = 0
  else
    if Hc < 20 then inc Hc
  end if
  if Hc >= 12 then Sp = 3
  if (Pads & 4) <> 0 then
    if Cx >= CxMin + Sp then
      Cx = Cx - Sp
    else
      Cx = CxMin
    end if
  end if
  if (Pads & 8) <> 0 then
    if Cx + Sp <= CxMax then
      Cx = Cx + Sp
    else
      Cx = CxMax
    end if
  end if
  if (Pads & 1) <> 0 then
    if Cy >= CyMin + Sp then
      Cy = Cy - Sp
    else
      Cy = CyMin
    end if
  end if
  if (Pads & 2) <> 0 then
    if Cy + Sp <= CyMax then
      Cy = Cy + Sp
    else
      Cy = CyMax
    end if
  end if
  return
end sub

sub Gain(u8 P):
  Score = Score + P
  ShowScore
  return
end sub

sub Lose(u8 P):
  if Score >= P then
    Score = Score - P
  else
    Score = 0
  end if
  ShowScore
  return
end sub

sub Puff(u8 Px, u8 Py):
  PuffX = Px
  PuffY = Py
  PuffT = 8
  return
end sub

' the button: a bullet, then what the sight is on (the first thing found)
sub Shoot:
  dec Ammo
  ShowAmmo
  play sound SndBang
  Puff(Cx, Cy)
  if ShotMug() = 1 then return
  if ShotMouse() = 1 then return
  if ShotWindow() = 1 then return
  if ShotCard() = 1 then return
  if Cy >= 120 and Cy < 128 then
    if Cx >= 152 and Cx < 232 then
      select case PnoN
      case 0
        play sound SndPno1
      case 1
        play sound SndPno2
      case else
        play sound SndPno3
      end select
      inc PnoN
      if PnoN = 3 then PnoN = 0
    end if
  end if
  return
end sub

function ShotMug as u8
  u8 Hx = 0
  u8 Hy = 0
  u8 Found = 0
  for Mi = 0 to 8
    if MugSt[Mi] <> 0 then
      if Found = 0 then
        Hx = MugX[Mi]
        Hy = MugY[Mi]
        if Cx + 2 >= Hx and Cx <= Hx + 13 then
          if Cy + 2 >= Hy and Cy <= Hy + 13 then
            MugSt[Mi] = 0
            Found = 1
          end if
        end if
      end if
    end if
  next
  if Found = 1 then
    play sound SndClink
    if MugHits < 10 then inc MugHits
    Gain(10)
  end if
  return Found

function ShotMouse as u8
  u8 Hx = 0
  V = 0
  if MouseOn = 1 then
    Hx = highbyte(MPx)
    if Cy >= 138 and Cy <= 153 then
      if Cx + 2 >= Hx and Cx <= Hx + 15 then
        V = 1
        Gain(MBon[MLev])
        if MLev < 4 then inc MLev
        MDir = MDir ^ 1
        play sound SndSqueak
      end if
    end if
  end if
  return V

function ShotWindow as u8
  u8 Wx = 0
  V = 0
  if WinSt = 2 then
    if Cy >= 32 and Cy < 56 then
      Wx = WinCol[WinW] * 8
      if Cx >= Wx and Cx < Wx + 24 then
        V = 1
        WinSt = 3
        WinT = WinAfter
        if WinBad = 1 then
          play sound SndHit
          Gain(25)
          DrawWin(5)
          Say(1)
        else
          play sound SndOops
          Lose(100)
          DrawWin(4)
          Say(2)
        end if
      end if
    end if
  end if
  return V

function ShotCard as u8
  u8 Ps = 0
  u8 Sh = 0
  u8 Sl = 0
  u8 Kx = 0
  V = 0
  if Cy >= 64 and Cy < 80 then
    for Pi = 0 to 2
      Kx = CardCol[Pi] * 8
      if Cx >= Kx and Cx < Kx + 16 then
        V = 1
        Ps = Pi
      end if
    next
  end if
  if V = 1 then
    Sh = CardSh[Ps]
    Sl = Mod5[CardO + Ps]
    if Sh = 6 then
      play sound SndCardBad
      Lose(10)
    else
      if Sh <> 0 then
        if Sh = Want then
          if Want = 1 then
            Ammo = FullAmmo
            ShowAmmo
            play sound SndRefill
            Say(4)
            Want = 5
            Shuffle
          else
            dec Want
            CardV[Sl] = 0
            CardSh[Ps] = 0
            DrawCard(Ps)
            play sound SndCardOk
            Gain(10)
          end if
        else
          play sound SndCardBad
          Say(3)
          Want = 5
          Shuffle
        end if
        ShowWant
      end if
    end if
  end if
  return V

' mugs: slide a pixel every other frame; off the shelf's end they fall
' and smash on the floor
sub MugStep:
  u8 Mx = 0
  u8 My = 0
  MugF = MugF ^ 1
  for Mi = 0 to 8
    select case MugSt[Mi]
    case 1
      if MugF = 1 then
        Mx = MugX[Mi] + 1
        MugX[Mi] = Mx
        if Mx >= MugEnd then MugSt[Mi] = 2
      end if
    case 2
      My = MugY[Mi] + 3
      MugY[Mi] = My
      if My >= MugFloor then
        MugSt[Mi] = 0
        play sound SndSmash
        Puff(MugX[Mi] + 6, 146)
        Lose(5)
      end if
    end select
  next
  return
end sub

' every 32 frames: one chance in two of a new mug at the left of a random
' shelf, when that shelf has a free place and room at its start
sub Spawn:
  u8 Sh = 0
  u8 Fr = 9
  u8 Sl = 0
  Rand
  if R8 >= 128 then return
  Sh = (R8 & 63) % 3
  Sl = Sh * 3
  for Mi = 0 to 2
    if MugSt[Sl] = 0 then
      if Fr = 9 then Fr = Sl
    else
      if MugSt[Sl] = 1 then
        if MugX[Sl] < MugX0 + 16 then Fr = 10
      end if
    end if
    inc Sl
  next
  if Fr < 9 then
    MugSt[Fr] = 1
    MugX[Fr] = MugX0
    MugY[Fr] = ShelfY[Sh]
  end if
  return
end sub

' the windows, one step every 16 frames: a wait, then a shadow
sub WinStep:
  select case WinSt
  case 0
    dec WinT
    if WinT = 0 then
      WinSt = 1
      Rand
      WinW = (R8 & 63) % 3
      Rand
      WinT = 7 + (R8 & 7)
      DrawWin(1)
    end if
  case 1
    dec WinT
    if WinT = 0 then
      WinSt = 2
      WinT = WinFig
      Rand
      WinBad = R8 >> 7
      if WinBad = 1 then
        DrawWin(2)
      else
        DrawWin(3)
      end if
    end if
  end select
  return
end sub

' the figure (and what happens after a hit), counted in frames
sub WinFrame:
  if WinSt < 2 then return
  dec WinT
  if WinT = 0 then
    if WinSt = 2 then
      if WinBad = 1 then
        play sound SndPew
        if Ammo > 10 then
          Ammo = Ammo - 10
        else
          Ammo = 0
        end if
        ShowAmmo
        Say(5)
      end if
    end if
    WinSt = 0
    Rand
    WinT = 32 + (R8 & 31)
    DrawWin(0)
  end if
  return
end sub

' the cards turn: three of the five places on show, one place may be
' shown face down next time
sub Turn:
  u8 Sl = 0
  inc CardO
  if CardO = 5 then CardO = 0
  ShowCards
  Rand
  Sl = R8 & 3
  if CardV[Sl] <> 0 then CardF[Sl] = 1
  return
end sub

sub ShowCards:
  u8 Sl = 0
  for Ci = 0 to 2
    Sl = Mod5[CardO + Ci]
    V = CardV[Sl]
    if V <> 0 then
      if CardF[Sl] = 1 then
        CardF[Sl] = 0
        V = 6
      end if
    end if
    CardSh[Ci] = V
    DrawCard(Ci)
  next
  return
end sub

' the values 1-5 (10 J Q K A) into the five places at random
sub Shuffle:
  u8 Sl = 0
  for Ci = 0 to 4
    CardV[Ci] = 0
    CardF[Ci] = 0
  next
  for Ci = 1 to 5
    Sl = 9
    while Sl > 4
      Rand
      Sl = R8 & 7
      if Sl < 5 then
        if CardV[Sl] <> 0 then Sl = 9
      end if
    end while
    CardV[Sl] = Ci
  next
  ShowCards
  return
end sub

' the mouse along the floor; off either end it is gone
sub MouseStep:
  u16 Vel = 0
  u8 Mx = 0
  Vel = MVel[MLev]
  if MDir = 0 then
    MPx = MPx + Vel
    Mx = highbyte(MPx)
    if Mx >= 216 then MouseOn = 0
  else
    if MPx < Vel + 4096 then
      MouseOn = 0
    else
      MPx = MPx - Vel
    end if
  end if
  if MouseOn = 0 then MugHits = 0
  return
end sub

sub Clock:
  if Bonus = 0 then
    if Score >= 500 then
      Bonus = 1
      TimeU = TimeU + 50
      ShowTime
      Say(6)
    end if
  end if
  dec TimeF
  if TimeF = 0 then
    TimeF = 32
    dec TimeU
    ShowTime
    if TimeU <= 25 and TimeU > 0 then play sound SndTick
  end if
  if TimeU = 0 then
    Phase = 1
    Why = 0
  else
    if Ammo = 0 then
      Phase = 1
      Why = 1
    end if
  end if
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  R8 = Rs
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' ---------------------------------------------------------------------------
' drawing

' a window picture: 0 closed, 1 shadow, 2 bandit, 3 old-timer, 4 empty,
' 5 hat flying
sub DrawWin(u8 Pc):
  u8 Wc = 0
  u8 Tb = 0
  Wc = WinCol[WinW]
  Tb = TWclosed00 + Pc * 9
  for Ri = 0 to 2
    put char Tb at Wc,Ri + 4
    put char Tb + 1 at Wc + 1,Ri + 4
    put char Tb + 2 at Wc + 2,Ri + 4
    Tb = Tb + 3
  next
  return
end sub

' one card place: 0 gone (felt), 1-5 a face, 6 the back
sub DrawCard(u8 P):
  u8 Kc = 0
  u8 Sh = 0
  Kc = CardCol[P]
  Sh = CardSh[P]
  if Sh = 0 then
    fill TFelt count 2 at Kc,8
    fill TFelt count 2 at Kc,9
  else
    if Sh = 6 then
      fill TBack count 2 at Kc,8
      fill TBack count 2 at Kc,9
    else
      K = Sh - 1
      put char CardTop[K] at Kc,8
      put char TCardtr at Kc + 1,8
      put char TCardbl at Kc,9
      put char THeart at Kc + 1,9
    end if
  end if
  return
end sub

' messages on the bottom line for a while, then the status again
sub Say(u8 M):
  select case M
  case 1
    print at 2,MsgRow, "     GOT HIM! HAT OFF +25   "
  case 2
    print at 2,MsgRow, "  OOPS! A FRIEND!  -100     "
  case 3
    print at 2,MsgRow, "  WRONG CARD! SHUFFLED      "
  case 4
    print at 2,MsgRow, "  ROYAL FLUSH! RELOADED     "
  case 5
    print at 2,MsgRow, "  PING! BANDIT SHOT -10 AMMO"
  case else
    print at 2,MsgRow, "     BONUS TIME +50         "
  end select
  MsgT = 90
  return
end sub

sub ShowStatus:
  print at 2,MsgRow, "AMMO                        "
  ShowAmmo
  ShowWant
  return
end sub

sub ShowAmmo:
  if MsgT = 0 then
    NumU = Ammo
    print at 7,MsgRow, digits$(NumU, 2)
  end if
  return
end sub

sub ShowWant:
  if MsgT = 0 then
    select case Want
    case 5
      print at 19,MsgRow, "WANT: ACE  "
    case 4
      print at 19,MsgRow, "WANT: KING "
    case 3
      print at 19,MsgRow, "WANT: QUEEN"
    case 2
      print at 19,MsgRow, "WANT: JACK "
    case else
      print at 19,MsgRow, "WANT: TEN  "
    end select
  end if
  return
end sub

sub ShowScore:
  print at 5,1, digits$(Score, 5)
  return
end sub

sub ShowTime:
  NumU = TimeU
  print at 27,1, digits$(NumU, 3)
  return
end sub

sub ShowHud:
  print at 2,1, "SC 00000  HI 00000  TIME 000"
  ShowScore
  print at 15,1, digits$(HiSc, 5)
  ShowTime
  ShowStatus
  return
end sub

' sprites: 0 sight, 1 puff, 2 gun, 3 hand, 4 mouse, 5-13 mugs
sub DrawSprites:
  u8 Gx = 0
  Gx = Cx - 7
  set sprite 0 to Cy - 8,Cx - 7,SCross,15
  if PuffT > 0 then
    dec PuffT
    set sprite 1 to PuffY - 6,PuffX - 7,SPuff,11
  else
    set sprite 1 to 207,0,0,0
  end if
  set sprite 2 to 159,Gx,SGun,14
  set sprite 3 to 159,Gx,SHand,9
  if MouseOn = 1 then
    X = highbyte(MPx)
    if MDir = 0 then
      set sprite 4 to 135,X,SMouser,14
    else
      set sprite 4 to 135,X,SMousel,14
    end if
  else
    set sprite 4 to 207,0,0,0
  end if
  for Mi = 0 to 8
    K = Mi + 5
    if MugSt[Mi] = 0 then
      set sprite K to 207,0,0,0
    else
      X = MugX[Mi]
      Y = MugY[Mi] - 1
      set sprite K to Y,X,SMug,11
    end if
  next
  update sprites
  return
end sub

' the piano roll turns; messages time out
sub Cosmetic:
  inc RollT
  if RollT >= 8 then
    RollT = 0
    inc RollP
    if RollP = 3 then RollP = 0
    for Ri = 0 to 5
      K = Mod5[Ri + RollP]
      if K > 2 then K = K - 3
      put char TRoll0 + K at 21 + Ri,13
    next
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowStatus
  end if
  return
end sub

sub DrawSaloon:
  NewScreen
  ' the back wall (decoration may run to the screen's edges)
  for Ri = 3 to 17
    fill TWall count 32 at 0,Ri
  next
  fill TWalltop count 32 at 0,3
  for Ri = 4 to 6
    for Ci = 0 to 2
      K = WinCol[Ci]
      put char TJambl at K - 1,Ri
      put char TJambr at K + 3,Ri
    next
  next
  fill TRail count 32 at 0,7
  for Ci = 0 to 2
    WinW = Ci
    DrawWin(0)
  next
  WinW = 0
  ' the shelves
  fill TShelf count 14 at 2,10
  fill TShelf count 14 at 2,13
  fill TShelf count 14 at 2,16
  ' the card rack
  fill TFelt count 10 at 19,8
  fill TFelt count 10 at 19,9
  fill TTable count 10 at 19,10
  for Ci = 0 to 2
    DrawCard(Ci)
  next
  ' the player piano
  fill TPtop count 10 at 19,12
  fill TPbody count 10 at 19,13
  fill TRoll0 count 6 at 21,13
  fill TPbody count 10 at 19,14
  fill TKeys count 10 at 19,15
  fill TPbody count 10 at 19,16
  fill TPleg count 10 at 19,17
  ' the floor and the bar
  fill TFloor count 32 at 0,18
  fill TBartop count 32 at 0,19
  fill TBar count 32 at 0,20
  fill TBarfoot count 32 at 0,21
  ' the banner
  put char TSignl at 7,2
  print at 8,2, " SALOON SHOOTOUT "
  put char TSignr at 25,2
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 14
  sprites stable 0 to 3
  sprites flicker on
  for K = 0 to 13
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: SALOON SHOOTOUT, a mug and the sight, the menu, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 160 to vram.name + 96
  fill TWalltop count 28 at 2,9
  fill TShelf count 28 at 2,14
  print at 9,16, "HIGH SCORE"
  print at 20,16, digits$(HiSc, 5)
  Sel = 0
  ShowMenu
  print at 4,21, "COMPUTE!'S GAZETTE 1986"
  set sprite 5 to 97,60,SMug,11
  set sprite 6 to 97,180,SMug,11
  set sprite 0 to 95,183,SCross,15
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 660
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Tick
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    Sel = 0
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    Sel = 1
    play sound SndPick
    ShowMenu
  end if
  if (N & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,18
  put char 32 at 11,19
  put char 62 at 11,Sel + 18
  print at 13,18, "PLAY"
  print at 13,19, "CREDITS"
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $FA
  backdrop dark yellow
  print at 8,2, "SALOON SHOOTOUT"
  print at 2,5, "BASED ON SALOON SHOOTOUT,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "JULY 1986 DISK"
  print at 2,8, "(COMMODORE 64 / PLUS/4)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: SWINGING DOORS"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

