cartridge "MIAMI ICE/JEFF KULCZYCKI, COMPUTE!/1986"

' MIAMI ICE
' Based on "Miami Ice" by Jeff Kulczycki, COMPUTE! June 1986 (pages
' 34-55): a driving game for the Commodore 128, with versions for the
' Commodore 64, Atari and Apple II by Kevin Mykytyn and Tim Victor. Made
' for the ColecoVision in Amy (the language by Amy Bienvenu) by Claude (an
' AI made by Anthropic) for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the article's rules
' (orig/ has the scans). Kept: a freak ice storm has frozen Miami; drive
' your car over the icy streets to the parking garage. The button is the
' gas, the stick turns the car; the car keeps sliding the way it was
' going, gathers speed slowly, and there are no brakes worth the name. A
' wall or a guardrail cracks the car up (three cars a game). Enter the
' garage by its open front without touching its three black walls. A
' timer counts down on each screen: park before it runs out and its
' seconds are your points; after that you still go on, for nothing.
' Seven screens, some with more than one way through; the next game starts
' on the screen where the last one ended, and the stick chooses another on
' the title. The ten best scores are kept with initials (for the session:
' there is no disk).
' Made for this machine: seven new streets in the article's spirit, a
' pastel art deco Miami (pink and cyan buildings, palms, flamingos) under
' white ice; the car a two-colour sprite in 16 headings moving in 1/64
' pixel steps; real sliding: the car's speed is kept as a forward and a
' sideways part, the tyres grip the sideways part only a little each
' frame, and a turn swings both parts round; an engine whose hum rises
' with the speed, a hiss when the car slides, a crash of ice shards; music
' under play, quieter than the effects; an original title tune, "Ocean
' Drive", and "Cold Front" under play.
'
' Controls (either joystick): the left button is the gas, left and right
' turn the car. On the title, up and down choose the screen, the left
' button starts and the right button shows the credits. For initials, up
' and down change the letter, left and right move, the button finishes.
'
' House rules kept: text in columns 2-29 and rows 0-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.
'
' Rules in numbers (bot.mjs checks them against model.mjs): the car's
' place Px, Py in 1/64 pixel (its sprite's top-left), its forward and
' sideways speeds Fv and Lv in 1/64 pixel a frame, its heading Hd (0-15,
' clockwise from up). Each frame: a turn every 6 frames while the stick is
' held (Fv' = (59 Fv +- 24 Lv) / 64, Lv' = (59 Lv -+ 24 Fv) / 64, the
' divisions cut toward zero); the gas adds 3 to Fv up to 120, without it
' Fv slips one step toward 0; the grip takes Lv / 16 (at least 1) off Lv;
' then the car moves by (Fv sin + Lv cos, Lv sin - Fv cos) / 64 with sin
' and cos of the heading times 64. Its 8 x 8 middle must stay on ice or the
' garage floor; its centre on the floor parks it. The timer: one second
' every 60 frames.

const TIce0 = 128
const TIce1 = 129
const TIce2 = 130
const TPark = 131
const TGar = 132
const TBp = 133
const TBpc = 134
const TBc = 135
const TBcc = 136
const TLawn = 137
const TPalm00 = 138
const TPalm01 = 139
const TPalm10 = 140
const TPalm11 = 141
const TFlam00 = 142
const TFlam01 = 143
const TFlam10 = 144
const TFlam11 = 145
const TStrp = 146
const SBody0 = 0
const SBody1 = 4
const SBody2 = 8
const SBody3 = 12
const SBody4 = 16
const SBody5 = 20
const SBody6 = 24
const SBody7 = 28
const SBody8 = 32
const SBody9 = 36
const SBody10 = 40
const SBody11 = 44
const SBody12 = 48
const SBody13 = 52
const SBody14 = 56
const SBody15 = 60
const SDet0 = 64
const SDet1 = 68
const SDet2 = 72
const SDet3 = 76
const SDet4 = 80
const SDet5 = 84
const SDet6 = 88
const SDet7 = 92
const SDet8 = 96
const SDet9 = 100
const SDet10 = 104
const SDet11 = 108
const SDet12 = 112
const SDet13 = 116
const SDet14 = 120
const SDet15 = 124
const SBurst = 128
const NTiles8 = 152
const SprBytes = 1056
const SndTuneA = 1
const SndTuneB = 2
const SndPlayA = 3
const SndPlayB = 4
const SndEng0 = 5
const SndEng1 = 6
const SndEng2 = 7
const SndEng3 = 8
const SndSkid = 9
const SndCrash = 10
const SndCrk = 11
const SndPark = 12
const SndOut = 13
const SndPick = 14
const SndOver = 15
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the car
i16 Px = 0
i16 Py = 0
i16 Fv = 0
i16 Lv = 0
i16 Vx = 0
i16 Vy = 0
i16 Sn = 0
i16 Cs = 0
i16 Ta = 0
i16 Tb = 0
u8 Hd = 0
u8 Rt = 0
u8 Sx = 0
u8 Sy = 0
u8 Cx = 0
u8 Cy = 0
' the game: Scr the screen (0-6), Base its first map byte, Cars left,
' Score, Tmr the seconds left, Tf the frames of this second; Ph 1 driving,
' 2 crashing, 3 parked, 4 game over; Hit 1 crash, 2 parked (this frame)
u8 Scr = 0
u16 Base = 0
u8 Cars = 3
u16 Score = 0
u8 Tmr = 0
u8 Tf = 0
u8 Ph = 0
u8 Hit = 0
u8 Gas = 0
u8 Pc = 0
' for the tests: Parks and Crashes counted
u16 Parks = 0
u16 Crashes = 0
' the ten best: scores and three letters each (A = 1 .. Z = 26)
u16 HiS[10]
u8 HiN[30]
u8 Rank = 0
u8 Ix = 0

u16 NumU = 0
u16 W16 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Bt2 = 0
u8 WasBtn = 0
u8 WasB2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Idle = 0

  tile screen
  set sound table MiSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  HiInit
  CreditsPage

title:
  TitlePage

new_game:
  Score = 0
  Cars = 3
  Parks = 0
  Crashes = 0

new_screen:
  W16 = Scr
  W16 = W16 * 768
  Base = W16
  Tmr = Secs[Scr]
  Tf = 0
  DrawCity
  ShowHud
  CarStart
  DrawCar
  ShowScreen
  play sound SndPlayA
  play sound SndPlayB

drive:
  Ph = 1
drive_loop:
  Frame1
  ReadPad
  Physics
  DrawCar
  Clock
  Noises
  if Hit = 1 then goto crash
  if Hit = 2 then goto parked
  goto drive_loop

crash:
  Ph = 2
  inc Crashes
  play sound SndCrash
  play sound SndCrk
  for Tm = 1 to 50
    Frame1
    Hd = Hd + 1
    Hd = Hd & 15
    V = Tm & 4
    if V = 0 then
      W = 8
    else
      W = 15
    end if
    V = Hd << 2
    N = Sy - 1
    set sprite 0 to N,Sx,V,1
    V = V + SBody0
    set sprite 1 to N,Sx,V,W
    set sprite 2 to N,Sx,SBurst,8
    update sprites
    Clock
  next
  dec Cars
  ShowHud
  if Cars = 0 then goto game_over
  CarStart
  Frame1
  DrawCar
  goto drive

parked:
  Ph = 3
  inc Parks
  play sound SndPark
  Score = Score + Tmr
  ShowHud
  print at 9,11, " PARKED! "
  NumU = Tmr
  print at 10,12, " + "
  print at 13,12, digits$(NumU, 2)
  print at 15,12, " "
  for Tm = 1 to 120
    Frame1
  next
  inc Scr
  if Scr = 7 then Scr = 0
  goto new_screen

game_over:
  Ph = 4
  stop sound SndPlayA
  stop sound SndPlayB
  play sound SndOver
  HideSprites
  print at 10,11, " GAME OVER "
  for Tm = 1 to 150
    Frame1
  next
  HiEnter
  HiTable
  goto title

' --- the car ------------------------------------------------------------
' CarStart: the car at the screen's start, at rest
sub CarStart:
  W16 = StartX[Scr]
  Px = W16
  W16 = StartY[Scr]
  Py = W16
  Hd = StartH[Scr]
  Fv = 0
  Lv = 0
  Rt = 0
  Hit = 0
  return
end sub

' Physics: one frame of turning, gas, grip and sliding, then the walls
sub Physics:
  ' turning: one step at once, then one every 6 frames while held
  V = Lf1 ^ Rt1
  if V = 0 then
    Rt = 0
  else
    if Rt > 0 then
      dec Rt
    else
      Rt = 6
      if Rt1 = 1 then
        Ta = Fv * 59
        Tb = Lv * 24
        Ta = Ta + Tb
        Ta = Ta / 64
        Tb = Lv * 59
        Vx = Fv * 24
        Tb = Tb - Vx
        Tb = Tb / 64
        Hd = Hd + 1
      else
        Ta = Fv * 59
        Tb = Lv * 24
        Ta = Ta - Tb
        Ta = Ta / 64
        Tb = Lv * 59
        Vx = Fv * 24
        Tb = Tb + Vx
        Tb = Tb / 64
        Hd = Hd - 1
      end if
      Hd = Hd & 15
      Fv = Ta
      Lv = Tb
    end if
  end if
  ' the gas, or a slow slip toward rest
  Gas = Btn
  if Gas = 1 then
    Fv = Fv + 3
    if Fv > 120 then Fv = 120
  else
    if Fv > 0 then
      Fv = Fv - 1
    else
      if Fv < 0 then Fv = Fv + 1
    end if
  end if
  ' the grip on the ice: a sixteenth of the sideways speed
  Ta = Lv / 16
  if Ta = 0 then
    if Lv > 0 then Ta = 1
    if Lv < 0 then Ta = -1
  end if
  Lv = Lv - Ta
  ' the move
  V = SinT[Hd]
  Sn = V
  Sn = Sn - 64
  V = CosT[Hd]
  Cs = V
  Cs = Cs - 64
  Ta = Fv * Sn
  Tb = Lv * Cs
  Vx = Ta + Tb
  Vx = Vx / 64
  Ta = Lv * Sn
  Tb = Fv * Cs
  Vy = Ta - Tb
  Vy = Vy / 64
  Px = Px + Vx
  Py = Py + Vy
  ' where it is: the sprite's corner, then its middle
  Ta = Px / 64
  Sx = Ta
  Ta = Py / 64
  Sy = Ta
  Cx = Sx + 8
  Cy = Sy + 8
  ' the walls: the 8 x 8 middle on ice or garage floor only
  Hit = 0
  X = Cx - 4
  Y = Cy - 4
  Probe
  X = Cx + 3
  Probe
  Y = Cy + 3
  Probe
  X = Cx - 4
  Probe
  if Hit = 1 then return
  ' parked: the centre on the garage floor
  X = Cx
  Y = Cy
  CellAt
  if V = TPark then Hit = 2
  return
end sub

' CellAt: V = the map's tile under pixel X, Y of this screen
sub CellAt:
  W16 = Y >> 3
  W16 = W16 << 5
  V = X >> 3
  W16 = W16 + V
  W16 = W16 + Base
  V = Maps[W16]
  return
end sub

' Probe: Hit = 1 if the pixel X, Y is not road
sub Probe:
  CellAt
  if V < TIce0 then Hit = 1
  if V > TPark then Hit = 1
  return
end sub

' DrawCar: the windows and tyres (sprite 0) over the body (sprite 1)
sub DrawCar:
  V = Hd << 2
  N = Sy - 1
  W = V + SDet0
  set sprite 0 to N,Sx,W,1
  W = V + SBody0
  set sprite 1 to N,Sx,W,13
  set sprite 2 to 192,0,0,0
  update sprites
  return
end sub

' Clock: a second off the timer every 60 frames (down to 0)
sub Clock:
  inc Tf
  if Tf < 60 then return
  Tf = 0
  if Tmr = 0 then return
  dec Tmr
  if Tmr = 0 then play sound SndOut
  ShowTime
  return
end sub

' Noises: the engine's hum by speed, the hiss of a slide
sub Noises:
  V = Tick & 7
  if V = 0 then
    Ta = Fv
    if Ta < 0 then Ta = 0 - Ta
    if Ta = 0 then
      if Gas = 0 then return
    end if
    if Ta < 30 then
      play sound SndEng0
    else
      if Ta < 60 then
        play sound SndEng1
      else
        if Ta < 90 then
          play sound SndEng2
        else
          play sound SndEng3
        end if
      end if
    end if
  end if
  if V = 4 then
    Ta = Lv
    if Ta < 0 then Ta = 0 - Ta
    if Ta > 40 then play sound SndSkid
  end if
  return
end sub

' --- screens -------------------------------------------------------------
sub DrawCity:
  NewScreen
  copy Maps + Base count 768 to vram.name
  return
end sub

sub ShowHud:
  print at 2,0, "TIME"
  ShowTime
  print at 10,0, "SCORE"
  NumU = Score
  print at 16,0, digits$(NumU, 5)
  print at 23,0, "CARS"
  NumU = Cars
  print at 28,0, digits$(NumU, 1)
  return
end sub

sub ShowTime:
  NumU = Tmr
  print at 7,0, digits$(NumU, 2)
  return
end sub

' --- the best scores -------------------------------------------------------
sub HiInit:
  for K = 0 to 9
    W16 = 10 - K
    W16 = W16 * 10
    HiS[K] = W16
  next
  for K = 0 to 29
    V = HiDef[K]
    HiN[K] = V
  next
  return
end sub

' HiEnter: a score good enough goes in the table; the player spells initials
sub HiEnter:
  Rank = 10
  for K = 0 to 9
    if Rank = 10 then
      if Score > HiS[K] then Rank = K
    end if
  next
  if Rank = 10 then return
  ' move the lower ones down
  K = 9
hi_shift:
  if K > Rank then
    J = K - 1
    W16 = HiS[J]
    HiS[K] = W16
    N = K * 3
    W = J * 3
    V = HiN[W]
    HiN[N] = V
    inc N
    inc W
    V = HiN[W]
    HiN[N] = V
    inc N
    inc W
    V = HiN[W]
    HiN[N] = V
    dec K
    goto hi_shift
  end if
  HiS[Rank] = Score
  N = Rank * 3
  HiN[N] = 1
  inc N
  HiN[N] = 1
  inc N
  HiN[N] = 1
  NewScreen
  StripeRows
  print at 7,6, "A NEW BEST SCORE!"
  print at 5,9, "SPELL YOUR INITIALS:"
  print at 4,16, "UP/DOWN: LETTER"
  print at 4,17, "LEFT/RIGHT: MOVE"
  print at 4,18, "BUTTON: DONE"
  Ix = 0
  ShowInit
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStick = 1
he_loop:
  Frame1
  ReadPad
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      N = Rank * 3
      N = N + Ix
      W = HiN[N]
      if Up1 = 1 then
        inc W
        if W = 27 then W = 1
      end if
      if Dn1 = 1 then
        dec W
        if W = 0 then W = 26
      end if
      HiN[N] = W
      if Lf1 = 1 then
        if Ix > 0 then dec Ix
      end if
      if Rt1 = 1 then
        if Ix < 2 then inc Ix
      end if
      play sound SndPick
      ShowInit
    end if
  end if
  WasStick = V
  if Press = 0 then goto he_loop
  return
end sub

sub ShowInit:
  N = Rank * 3
  for K = 0 to 2
    V = HiN[N]
    V = V + 64
    X = K * 2
    X = X + 14
    put char V at X,12
    if K = Ix then
      put char 94 at X,13
    else
      put char 32 at X,13
    end if
    inc N
  next
  return
end sub

' HiTable: the ten best until a button
sub HiTable:
  NewScreen
  StripeRows
  print at 9,3, "BEST DRIVERS"
  for K = 0 to 9
    Y = K + 6
    NumU = K + 1
    print at 7,Y, digits$(NumU, 2)
    N = K * 3
    for J = 0 to 2
      V = HiN[N]
      V = V + 64
      X = J + 11
      put char V at X,Y
      inc N
    next
    NumU = HiS[K]
    print at 17,Y, digits$(NumU, 5)
  next
  print at 8,19, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
ht_loop:
  Frame1
  ReadPad
  V = Press | Press2
  if V = 0 then goto ht_loop
  return
end sub

' --- input and frames --------------------------------------------------------
sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Bt2 = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(1).button2 then Bt2 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).button1 then Btn = 1
  if joypad(2).button2 then Bt2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Bt2 = 1 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = Bt2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' StripeRows: the pastel bands at the top and bottom of a page
sub StripeRows:
  for X = 0 to 31
    put char TStrp at X,1
    put char TStrp at X,22
  next
  return
end sub

' a 2 x 2 picture (palm or flamingo) at X, Y
sub Pic(u8 T, u8 Qx, u8 Qy):
  put char T at Qx,Qy
  T = T + 1
  Qx = Qx + 1
  put char T at Qx,Qy
  T = T + 1
  Qx = Qx - 1
  Qy = Qy + 1
  put char T at Qx,Qy
  T = T + 1
  Qx = Qx + 1
  put char T at Qx,Qy
  return
end sub

' --- title and credits ---------------------------------------------------------
sub TitlePage:
tp_start:
  NewScreen
  StripeRows
  print at 9,4, "M I A M I"
  print at 11,6, "I C E"
  Pic(TPalm00, 3, 3)
  Pic(TPalm00, 27, 3)
  Pic(TFlam00, 3, 8)
  Pic(TFlam00, 27, 8)
  print at 4,10, "DRIVE TO THE GARAGE ON"
  print at 4,11, "THE ICY STREETS OF MIAMI"
  print at 9,14, "START: SCREEN"
  ShowScr
  print at 4,17, "UP/DOWN: SCREEN"
  print at 4,18, "LEFT BUTTON: START"
  print at 4,19, "RIGHT BUTTON: CREDITS"
  print at 4,20, "HI"
  NumU = HiS[0]
  print at 7,20, digits$(NumU, 5)
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 384
  TzOn = 1
  Ph = 0
  Px = 3072
  Hd = 4
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasB2 = 1
tp_loop:
  Frame1
  ReadPad
  ' a car slides along under the title, turning at the ends
  if Hd = 4 then
    Px = Px + 96
    if Px > 13000 then Hd = 12
  else
    Px = Px - 96
    if Px < 1500 then Hd = 4
  end if
  Ta = Px / 64
  Sx = Ta
  Sy = 64
  DrawCar
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        inc Scr
        if Scr = 7 then Scr = 0
      else
        if Scr = 0 then Scr = 7
        dec Scr
      end if
      play sound SndPick
      ShowScr
    end if
  end if
  WasStick = V
  if Press2 = 1 then
    StopTune
    CreditsPage
    goto tp_start
  end if
  if Press = 0 then goto tp_loop
  StopTune
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

sub ShowScr:
  NumU = Scr + 1
  print at 23,14, digits$(NumU, 1)
  return
end sub

sub CreditsPage:
  NewScreen
  StripeRows
  print at 11,3, "MIAMI ICE"
  print at 3,5, "BASED ON MIAMI ICE BY JEFF"
  print at 3,6, "KULCZYCKI, COMPUTE! JUNE"
  print at 3,7, "1986 (C128; VERSIONS BY"
  print at 3,8, "KEVIN MYKYTYN AND TIM"
  print at 3,9, "VICTOR)."
  print at 3,11, "MADE FOR THE COLECOVISION"
  print at 3,12, "BY CLAUDE (AN AI MADE BY"
  print at 3,13, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,14, "2026, IN AMY BY AMY BIENVENU."
  print at 3,16, "MUSIC: OCEAN DRIVE,"
  print at 3,17, "COLD FRONT"
  print at 8,20, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasB2 = 1
cp_loop:
  Frame1
  ReadPad
  V = Press | Press2
  if V = 0 then goto cp_loop
  return
end sub

' the default best: ten drivers' initials (letters 1-26)
data HiDef bytes
  10,11,11, 13,9,1, 9,3,5, 16,9,14, 6,12,13, 1,13,25, 3,12,4, 4,5,3, 15,3,14, 19,21,14
end data

data SinT bytes
  64,88,109,123,128,123,109,88,64,40,19,5,0,5,19,40
end data
data CosT bytes
  128,123,109,88,64,40,19,5,0,5,19,40,64,88,109,123
end data
' the seven streets: 768 tile codes each (row 0 the score line)
