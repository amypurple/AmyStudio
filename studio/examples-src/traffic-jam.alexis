cartridge "TRAFFIC JAM/JEFFREY D. PANICI/1989"
' TRAFFIC JAM - ColecoVision port of "Traffic Jam!" by Jeffrey D. Panici
' (C) 1989, RUN magazine, ReRUN disk January/February 1990 (C64 BASIC with a
' machine-language IRQ at $C047-$C1A3; copies in orig/).
'
' The game: walk the little man from the bottom of the screen up through the
' gaps in seven walls to the house at the top. Six cars shuttle along the
' lanes between the walls. Touching a car or a wall ends the game (one man);
' so does the clock: the time allowed is 40 - LV seconds. Reaching the house
' scores 100 x LV, then LV goes up by 2 (1, 3, 5 ... 23): the cars run faster
' and the time is shorter. After LV 23 it starts again at LV 1.
'
' How the C64 runs it (traced in real VICE, c64/trace.py), kept here:
' - every jiffy (= one ColecoVision frame) the IRQ moves cars 1, 3, 5 one
'   pixel right and cars 2, 4, 6 one pixel left ($C100) and the man one pixel
'   per stick direction ($C11E);
' - BASIC's main loop (line 340) calls the car mover LV more times
'   (SYS 49408), then reads the collision registers ($D01E, $D01F) and the
'   clock. A BASIC pass takes about 4.8 jiffies at LV 1 and 17.6 at LV 23
'   (a little less while the clock shows 0 s); the lengths per LV (Pass0,
'   Pass1) and the call spacing were fitted on VICE traces at LV 1-23 (car
'   positions within about a pixel); the rules keep that timing in 1/256
'   jiffy units (Phase, PassLen), so the cars run at the original's speed;
' - collisions are latched like the VIC-II's registers: any overlap of the
'   man's pixels with a car's, the house's or a wall's pixels during a pass
'   is seen at the pass's check. Car/house only (W1 = 129): home. Anything
'   else with the man: crash. Pixel-exact, with the C64 sprite and character
'   pixels, in C64 coordinates (sprite X/Y registers).
'
' Port choices (README): the man stays inside the visible play field (the
' C64 lets him walk into the side border, where nothing can hit him, and
' wrap round the screen); the HUD texts are not obstacles; x is drawn at 0.7.

const TBlank = 128
const TBar0 = 129
const TBar1 = 130
const TBar2 = 131
const TBar3 = 132
const TBar4 = 133
const TBar5 = 134
const TBar6 = 135
const TBar7 = 136
const TBar8 = 137
const TBar9 = 138
const TBar10 = 139
const TBar11 = 140
const TBar12 = 141
const TBar13 = 142
const TClock = 143
const TTbg0 = 144
const TTby0 = 145
const TTbr0 = 146
const TTbg1 = 147
const TTby1 = 148
const TTbr1 = 149
const TTbg2 = 150
const TTby2 = 151
const TTbr2 = 152
const TTbg3 = 153
const TTby3 = 154
const TTbr3 = 155
const TTbg4 = 156
const TTby4 = 157
const TTbr4 = 158
const TTbg5 = 159
const TTby5 = 160
const TTbr5 = 161
const TTbg6 = 162
const TTby6 = 163
const TTbr6 = 164
const TTbg7 = 165
const TTby7 = 166
const TTbr7 = 167
const TTbg8 = 168
const TTby8 = 169
const TTbr8 = 170
const TTbl = 171
const TTbr = 172
const TArrow = 173
const TC0 = 174
const TC1 = 175
const TC2 = 176
const TC3 = 177
const TC4 = 178
const TC5 = 179
const TC6 = 180
const TC7 = 181
const TC8 = 182
const TC9 = 183
const TC10 = 184
const TC11 = 185
const TC12 = 186
const TC13 = 187
const TC14 = 188
const TC15 = 189
const TC16 = 190
const TC17 = 191
const TC18 = 192
const TC19 = 193
const TC20 = 194
const TC21 = 195
const TC22 = 196
const TC23 = 197
const TC24 = 198
const TC25 = 199
const TC26 = 200
const TC27 = 201
const TC28 = 202
const TC29 = 203
const SMan = 0
const SCarR = 4
const SCarL = 8
const SHouse = 12
const NTiles8 = 608
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayM = 5
const SndClick = 6
const SndHome = 7
const SndSweep = 8
const SndCrash = 9
const SndOver = 10
const TuneFrames = 416
const TxtCredits = 0
const NSpr = 8
const HideY = 192
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StHome = 5
const StCrash = 6
const StOver = 9
' the man: start and limits (C64 sprite registers)
const MxStart = 65
const MyStart = 230
const MxMin = 15
const MxMax = 330
const MyMin = 70
const MyMax = 230
' the house (sprite 7)
const HouseX = 70
const HouseY = 63
' pass timing in 1/256 jiffy: the pass length from Pass0/Pass1; the n-th car call
' at SysA + PassB x n; the collision check after the calls, the clock check
' after the PRINT
const PreDelay = 450
const PassB = 155
const SysA = 140
const ChkA = 100
const TimA = 700

data CarY bytes 87,110,136,158,182,207
' pass lengths (1/256 jiffy) for LV 1, 3 .. 25, measured on the C64 in real
' VICE: while the clock shows 0 s (Pass0) and later (Pass1)
data Pass0 words 1083,1366,1667,1965,2215,2475,2850,3138,3384,3680,4042,4216,5120
data Pass1 words 1226,1519,1816,2107,2410,2699,3002,3290,3596,3881,4181,4497,5120
' where BASIC's pokes leave the cars when the clock starts (traced)
data CarStartX bytes 116,205,102,153,58,178
data CarCol bytes 8,7,13,2,5,11
data Bit bytes 1,2,4,8,16,32,64,128

u8 CarX[6]
u16 Mx = 65
u8 My = 230
u8 Lv = 1
u8 Stage = 1
u16 ScLo = 0
u8 ScHi = 0
u16 Phase = 0
u16 Pre = 0
u16 PassLen = 0
u16 NextSys = 0
u16 ChkAt = 0
u16 TimAt = 0
u8 SysN = 0
u8 Chk = 0
u16 Jif = 0
u8 Lat1 = 0
u8 Lat2 = 0
u8 W1 = 0
u8 Outcome = 0
u8 Secs = 0
u8 BarPx = 255
u8 BarCol = 0
u8 Hold = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 B16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
u8 Ci = 0
u8 Ri = 0
' collision scratch
u8 Yy = 0
u8 Yc = 0
u8 Cr = 0
u8 Gy = 0
u8 Bi = 0
u8 Sh = 0
u8 Mb = 0
u8 Hb = 0
u16 Pq = 0
u16 Mo = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2
u8 Wk = 0

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Outcome = 0 then goto play_loop
  if Outcome = 1 then
    HomeRun
    goto play_loop
  end if

  ' a crash or the time is up: the C64 stops everything and plays its crash
  State = StCrash
  stop sound SndPlayM
  play sound SndSweep
  for Oi = 1 to 30
    Frame1
  next
  play sound SndCrash
  for Oi = 1 to 90
    Frame1
  next
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift (only the title's menus use it; the game has no chance)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  ScLo = 0
  ScHi = 0
  Lv = 1
  Stage = 1
  DrawPlay
  StartLevel
  play sound SndPlayM
  return
end sub

' BASIC lines 260-330: the cars and the man back to their places, the clock
' to zero, the collision latches cleared
sub StartLevel:
  for Oi = 0 to 5
    CarX[Oi] = CarStartX[Oi]
  next
  Mx = MxStart
  My = MyStart
  Phase = 0
  Pre = PreDelay
  Jif = 0
  Lat1 = 0
  Lat2 = 0
  Outcome = 0
  PassTimes
  BarPx = 255
  ShowHud
  DrawSprites
  State = StPlay
  return
end sub

' a new BASIC pass: its event times (1/256 jiffy from the pass start)
sub PassTimes:
  SysN = 0
  Chk = 0
  NextSys = SysA
  W16 = Lv
  W16 = W16 * PassB
  T = Lv >> 1
  if Jif < 60 then
    PassLen = Pass0[T]
  else
    PassLen = Pass1[T]
  end if
  ChkAt = W16 + ChkA
  TimAt = W16 + TimA
  return
end sub

' one jiffy of the original
sub PlayStep:
  ' the IRQ ($C054): the car mover once, then the man by the stick
  MoveCars
  V = Jk & 1
  if V > 0 then
    if My > MyMin then dec My
  end if
  V = Jk & 2
  if V > 0 then
    if My < MyMax then inc My
  end if
  ' $C12D: left is tested first; right only when left is not held
  V = Jk & 4
  if V > 0 then
    if Mx > MxMin then Mx -= 1
  else
    V = Jk & 8
    if V > 0 then
      if Mx < MxMax then Mx += 1
    end if
  end if
  inc Jif
  ' BASIC's pass (line 350): LV calls of the car mover, spread over the pass
  if Pre > 0 then
    if Pre >= 256 then
      Pre -= 256
    else
      W16 = 256 - Pre
      Phase += W16
      Pre = 0
    end if
  else
    Phase += 256
  end if
  for Oi = 1 to 25
    if SysN < Lv then
      if Phase >= NextSys then
        MoveCars
        inc SysN
        NextSys += PassB
      end if
    end if
  next
  ' the VIC-II latches what overlapped this frame
  Overlaps
  ' the check after the calls (lines 350-360)
  if Chk = 0 then
    if SysN >= Lv then
      if Phase >= ChkAt then
        Chk = 1
        W1 = Lat1
        Lat1 = 0
        V = W1 & 1
        if V > 0 then
          if W1 = 129 then
            Outcome = 1
          else
            Outcome = 2
          end if
        else
          V = Lat2 & 1
          Lat2 = 0
          if V > 0 then Outcome = 2
        end if
      end if
    end if
  end if
  ' the clock (line 370): seconds of TI$ > 40 - LV ends the game
  if Chk = 1 then
    if Phase >= TimAt then
      Chk = 2
      W16 = Jif / 60
      Secs = W16
      T = 40 - Lv
      if Lv > 40 then T = 0
      if Secs > T then
        if Outcome = 0 then Outcome = 3
      end if
    end if
  end if
  ' the end of the pass (lines 380-390): LV 25 is LV 1 again
  if Chk = 2 then
    if Phase >= PassLen then
      Phase -= PassLen
      if Lv = 25 then Lv = 1
      PassTimes
    end if
  end if
  DrawSprites
  DrawTimeBar
  return
end sub

' $C100: cars 1, 3, 5 one pixel right, cars 2, 4, 6 one pixel left (8-bit X)
sub MoveCars:
  CarX[0] += 1
  CarX[1] -= 1
  CarX[2] += 1
  CarX[3] -= 1
  CarX[4] += 1
  CarX[5] -= 1
  return
end sub

' the man's eight pixel rows (C64 sprite rows 5-12, five pixels from sprite
' column 9) against the walls (characters), the cars and the house (sprites)
sub Overlaps:
  ' walls: rows Yy = My + 5 .. My + 12 (raster lines); the screen starts at 50
  for Ri = 0 to 7
    Yy = My + 5
    Yy += Ri
    Yc = Yy - 50
    Cr = Yc >> 3
    Gy = Yc & 7
    K = BarOfRow[Cr]
    if K < 7 then
      if Gy >= 1 then
        if Gy <= 5 then
          ' C64 screen x of the man's first column: Mx + 9 - 24
          A16 = Mx - 15
          Bi = A16 >> 3
          Sh = A16 & 7
          W16 = K
          W16 = W16 * 41
          W16 += Bi
          if Gy = 1 then
            Mb = RailMask[W16]
            Hb = RailMask[W16 + 1]
          else
            if Gy = 5 then
              Mb = RailMask[W16]
              Hb = RailMask[W16 + 1]
            else
              Mb = CapMask[W16]
              Hb = CapMask[W16 + 1]
            end if
          end if
          V = Mb << Sh
          if Sh > 0 then
            T = 8 - Sh
            T = Hb >> T
            V = V | T
          end if
          T = ManBits[Ri]
          V = V & T
          if V > 0 then Lat2 = Lat2 | 1
        end if
      end if
    end if
  next
  ' cars
  for Ci = 0 to 5
    Yc = CarY[Ci]
    ' rows 6-15 of a car hold pixels: skip unless they meet the man's rows
    T = Yc + 6
    V = My + 12
    if V >= T then
      T = Yc + 15
      V = My + 5
      if V <= T then
        ' column of the man's first pixel in the car's padded mask (-8..31)
        A16 = Mx + 17
        B16 = CarX[Ci]
        if A16 >= B16 then
          A16 = A16 - B16
          if A16 < 32 then
            Hb = A16
            V = Ci & 1
            if V = 0 then
              Mo = 0
            else
              Mo = 1
            end if
            SpriteHit
            if K > 0 then
              T = Ci + 1
              T = Bit[T]
              Lat1 = Lat1 | T
              Lat1 = Lat1 | 1
            end if
          end if
        end if
      end if
    end if
  next
  ' the house (sprite 7 at 70, 63): rows 1-16
  Yc = HouseY
  T = Yc + 1
  V = My + 12
  if V >= T then
    T = Yc + 16
    V = My + 5
    if V <= T then
      A16 = Mx + 17
      if A16 >= HouseX then
        A16 = A16 - HouseX
        if A16 < 32 then
          Hb = A16
          Mo = 2
          SpriteHit
          if K > 0 then
            Lat1 = Lat1 | 129
          end if
        end if
      end if
    end if
  end if
  return
end sub

' do the man's rows meet the sprite mask Mo (0 car right, 1 car left,
' 2 house) at row Yc (sprite Y) with the man's first column Hb - 8 pixels
' right of the sprite's? K = 1 if they do
sub SpriteHit:
  K = 0
  Bi = Hb >> 3
  Sh = Hb & 7
  for Ri = 0 to 7
    if K = 0 then
      Yy = My + 5
      Yy += Ri
      ' the sprite's row: Yy - Yc, 0..20
      if Yy >= Yc then
        Cr = Yy - Yc
        if Cr < 21 then
          W16 = Cr
          W16 = W16 * 5
          W16 += Bi
          if Mo = 0 then
            Mb = CarRMask[W16]
            Gy = CarRMask[W16 + 1]
          else
            if Mo = 1 then
              Mb = CarLMask[W16]
              Gy = CarLMask[W16 + 1]
            else
              Mb = HouseMask[W16]
              Gy = HouseMask[W16 + 1]
            end if
          end if
          V = Mb << Sh
          if Sh > 0 then
            T = 8 - Sh
            T = Gy >> T
            V = V | T
          end if
          T = ManBits[Ri]
          V = V & T
          if V > 0 then K = 1
        end if
      end if
    end if
  next
  return
end sub

' line 520: home. 100 x LV points, the jingle (the C64 stops its IRQ: all
' frozen for 3 s), LV + 2, the next crossing
sub HomeRun:
  State = StHome
  W16 = Lv
  W16 = W16 * 100
  ScLo += W16
  if ScLo >= 10000 then
    ScLo -= 10000
    inc ScHi
  end if
  stop sound SndPlayM
  play sound SndHome
  ShowHud
  for Oi = 1 to 180
    Frame1
  next
  Lv += 2
  if Stage < 99 then inc Stage
  StartLevel
  play sound SndPlayM
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' C64 X -> screen x at 0.7: 16 + (X - 24) x 0.7
sub DrawSprites:
  ' the man (1:1 pixels, centred on his squeezed place)
  A16 = Mx - 15
  A16 = A16 * 179
  A16 = A16 >> 8
  A16 += 15
  V = A16
  T = My - 55
  set sprite 0 to T,V,SMan,15
  for Li = 0 to 5
    C = Li + 1
    K = CarX[Li]
    if K < 24 then
      set sprite C to HideY,0,SMan,0
    else
      A16 = K - 24
      A16 = A16 * 179
      A16 = A16 >> 8
      A16 += 16
      V = A16
      T = CarY[Li]
      T -= 57
      J = CarCol[Li]
      Ri = Li & 1
      if Ri = 0 then
        set sprite C to T,V,SCarR,J
      else
        set sprite C to T,V,SCarL,J
      end if
    end if
  next
  ' the house: 3 lines lower than the C64 (its roof top would be in row 0)
  set sprite 7 to 7,48,SHouse,14
  update sprites
  return
end sub

' the HUD (row 1): LV n, the time bar, the score
sub ShowHud:
  print at 9,1, "LV"
  NumU = Stage
  if Stage < 10 then
    print at 12,1, " "
    print at 13,1, digits$(NumU, 1)
  else
    print at 12,1, digits$(NumU, 2)
  end if
  put char TClock at 15,1
  put char TTbl at 16,1
  put char TTbr at 22,1
  NumU = ScHi
  print at 24,1, digits$(NumU, 2)
  NumU = ScLo
  print at 26,1, digits$(NumU, 4)
  BarPx = 255
  return
end sub

' the time left as a 40-pixel bar: green, yellow under half, red under a
' quarter
sub DrawTimeBar:
  T = 41 - Lv
  if Lv > 40 then T = 1
  W16 = T
  W16 = W16 * 60
  if Jif >= W16 then
    A16 = 0
  else
    A16 = W16 - Jif
  end if
  A16 = A16 * 20
  W16 = T
  W16 = W16 * 30
  A16 = A16 / W16
  V = A16
  if V > 40 then V = 40
  if V = BarPx then return
  BarPx = V
  BarCol = 0
  if V < 20 then BarCol = 1
  if V < 10 then BarCol = 2
  for Li = 0 to 4
    C = Li << 3
    if V >= C then
      T = V - C
    else
      T = 0
    end if
    if T > 8 then T = 8
    ' tiles TTbg0 + 3 x n + colour
    J = T * 3
    J += BarCol
    J += TTbg0
    C = Li + 17
    put char J at C,1
  next
  return
end sub

sub DrawField:
  ' the seven walls (C64 rows 4, 7 .. 22 -> screen rows 3, 6 .. 21)
  for Li = 0 to 6
    Ri = Li * 3
    Ri += 3
    W16 = Li
    W16 = W16 * 28
    for Ci = 0 to 27
      A16 = W16 + Ci
      K = FieldNames[A16]
      C = Ci + 2
      put char K at C,Ri
    next
  next
  return
end sub

sub DrawPlay:
  NewScreen
  DrawField
  ShowHud
  ShowScreen
  return
end sub

sub GameOver:
  HideSprites
  NewScreen
  Wk = 0
  TxX = 11
  TxY = 7
  PutWord
  Wk = 1
  TxX = 10
  TxY = 10
  PutWord
  NumU = ScHi
  print at 13,12, digits$(NumU, 2)
  NumU = ScLo
  print at 15,12, digits$(NumU, 4)
  Wk = 2
  TxX = 4
  TxY = 15
  PutWord
  print at 8,19, "PRESS THE BUTTON"
  ShowScreen
  play sound SndOver
  return
end sub

' a coloured word (art.py: letters from the C64 font in the original's
' colours): Wk = which, at TxX, TxY
sub PutWord:
  for Li = 0 to 30
    K = 0
    if Wk = 0 then K = WGameOver[Li]
    if Wk = 1 then K = WFinal[Li]
    if Wk = 2 then K = WBetter[Li]
    if Wk = 3 then K = WRun[Li]
    if Wk = 4 then K = WCopy[Li]
    if Wk = 5 then K = WPress[Li]
    if K = 0 then exit for
    C = TxX + Li
    put char K at C,TxY
  next
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 7
  for J = 0 to 7
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, the
' play tiles in the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' text colours on a row: ink C on black, columns 0-31 of row R (tile screen:
' one colour table for the three thirds, so colours go by character code;
' the font codes 32-127 are white; coloured text uses the same codes, so the
' title colours whole rows through a second copy is not possible: white text,
' coloured logo and pictures)

' the title: the original's screen (RUN MAGAZINE PRESENTS, the logo, the
' copyright, the joystick line, press fire) with the menu
sub TitlePage:
  NewScreen
  ' the logo's own tiles replace the play tiles (codes 128-206)
  decompress zx0 LogoPatZ to vram.pattern + 1024
  decompress zx0 LogoColZ to vram.color + 1024
  decompress zx0 LogoPatZ to vram.pattern + 3072
  decompress zx0 LogoPatZ to vram.pattern + 5120
  Wk = 3
  TxX = 5
  TxY = 2
  PutWord
  print at 9,2, "MAGAZINE PRESENTS"
  for Li = 0 to 5
    Ri = Li + 4
    W16 = Li
    W16 = W16 * 28
    for Ci = 0 to 27
      A16 = W16 + Ci
      K = LogoNames[A16]
      C = Ci + 2
      put char K at C,Ri
    next
  next
  Wk = 4
  TxX = 3
  TxY = 11
  PutWord
  print at 12,14, "START"
  print at 12,16, "HOW TO PLAY"
  print at 12,18, "CREDITS"
  print at 3,20, "JOYSTICK: EITHER CONTROLLER"
  Wk = 5
  TxX = 2
  TxY = 22
  PutWord
  Menu = 0
  ShowMenu
  ShowScreen
  ' the title is up only now (the bots wait for it)
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  ' the drums' last hit rings a few frames: stop the voices just before
  TzLeft = TuneFrames - 4
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  return
end sub

sub ShowMenu:
  put char 32 at 10,14
  put char 32 at 10,16
  put char 32 at 10,18
  C = Menu << 1
  C += 14
  put char 62 at 10,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 9,2, "C R E D I T S"
  TxT = TxtCredits
  TxX0 = 3
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' a wall piece for the pictures: the 4th wall's first columns
sub PicWall:
  for Ci = 0 to 9
    A16 = 84 + Ci
    K = FieldNames[A16]
    C = Ci + T
    put char K at C,V
  next
  return
end sub

' HOW TO PLAY: three pages with pictures made of the game's own tiles and
' sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  print at 3,3, "WALK THE MAN UP THROUGH"
  print at 3,5, "THE GAPS IN THE WALLS"
  print at 3,7, "TO THE HOUSE AT THE TOP."
  ' the picture: the house above a wall with a gap, the man below
  T = 4
  V = 13
  PicWall
  set sprite 7 to 71,72,SHouse,14
  set sprite 0 to 110,73,SMan,15
  update sprites
  print at 3,17, "THE STICK MOVES HIM UP,"
  print at 3,19, "DOWN, LEFT AND RIGHT."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    print at 3,3, "SIX CARS RACE ALONG THE"
    print at 3,5, "LANES. A CAR OR A WALL"
    print at 3,7, "ENDS THE GAME: YOU HAVE"
    print at 3,9, "ONLY ONE MAN!"
    T = 4
    V = 12
    PicWall
    V = 15
    PicWall
    set sprite 1 to 105,40,SCarR,8
    set sprite 2 to 105,120,SCarL,7
    update sprites
    print at 3,18, "CROSS BEHIND A CAR, NOT"
    print at 3,20, "IN FRONT OF IT."
    print at 8,22, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    print at 3,3, "BEAT THE CLOCK: REACH THE"
    print at 3,5, "HOUSE BEFORE THE BAR IS"
    print at 3,7, "EMPTY."
    put char TClock at 10,9
    put char TTbl at 11,9
    put char TTbg8 at 12,9
    put char TTbg8 at 13,9
    put char TTby8 at 14,9
    put char TTbr4 at 15,9
    put char TTbg0 at 16,9
    put char TTbr at 17,9
    print at 3,11, "EACH HOUSE SCORES 100 X"
    print at 3,13, "THE SPEED (1, 3, 5 .. 23)."
    print at 3,15, "THEN THE CARS GO FASTER"
    print at 3,17, "AND THE TIME IS SHORTER."
    print at 3,19, "LV ON TOP: THE HOUSE NO."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

