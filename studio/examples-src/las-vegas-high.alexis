  $00,$00,$00,$00,$00,$00,$00,$00,$80,$80,$80,$80,$80,$80,$80,$80
  $00,$00,$00,$00,$00,$00,$00,$00,$03,$07,$07,$07,$03,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$C0,$E0,$E0,$E0,$C0,$00,$00,$00
