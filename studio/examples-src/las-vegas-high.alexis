end data

asm {
; LvLate: Late = 1 when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
LvLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret

; LvThirds: VDP register 3 = $FF, a colour table for each third
LvThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER
LvLever:
    db $00,$00,$36,$03,$00,$00,$57,$04,$00,$00,$86,$04,$10
LvWhirr:
    db $00,$00,$95,$C8,$10
LvClunk:
    db $00,$00,$06,$02,$00,$00,$37,$03,$00,$00,$77,$04,$10
LvClick:
    db $40,$40,$70,$01,$50
LvCoin:
    db $40,$2A,$30,$01,$40,$24,$50,$02,$50
LvLose:
    db $40,$1D,$41,$07,$40,$1D,$F1,$01,$40,$2E,$41,$07,$40,$2E,$F1,$01,$40,$41,$41,$07,$40,$41,$F1,$01
    db $40,$53,$41,$13,$40,$53,$F1,$01,$50
LvPair:
    db $40,$6B,$30,$04,$40,$6B,$F0,$01,$40,$55,$30,$09,$40,$55,$F0,$01,$50
LvWin:
    db $40,$8F,$20,$04,$40,$8F,$F0,$01,$40,$71,$20,$04,$40,$71,$F0,$01,$40,$5F,$20,$04,$40,$5F,$F0,$01
    db $40,$47,$20,$0B,$40,$47,$F0,$01,$50
LvJackpot:
    db $40,$6B,$10,$03,$40,$6B,$F0,$01,$40,$55,$10,$03,$40,$55,$F0,$01,$40,$47,$10,$03,$40,$47,$F0,$01
    db $40,$35,$10,$03,$40,$35,$F0,$01,$40,$47,$10,$03,$40,$47,$F0,$01,$40,$35,$10,$03,$40,$35,$F0,$01
    db $40,$2A,$10,$13,$40,$2A,$F0,$01,$50
LvBroke:
    db $40,$D6,$30,$09,$40,$D6,$F0,$01,$40,$E2,$30,$09,$40,$E2,$F0,$01,$40,$F0,$30,$09,$40,$F0,$F0,$01
    db $40,$FE,$30,$1D,$40,$FE,$F0,$01,$50

LvSoundTable:
    dw LvLever,$702B
    dw LvWhirr,$702B
    dw LvClunk,$702B
    dw LvClick,$7035
    dw LvCoin,$7035
    dw LvLose,$7035
    dw LvPair,$7035
    dw LvWin,$7035
    dw LvJackpot,$7035
    dw LvBroke,$7035
    dw LvTuneMel,$703F
    dw LvTuneBass,$7049
; Neon Strip, C major (original for this game)
; Tiny Sound, 6 frames per step
LvTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$31,$88,$23,$00,$26,$00,$28,$00,$00,$26,$28,$00,$2B,$00
    db $00,$00,$00,$00,$2D,$00,$2B,$00,$28,$00,$26,$00,$23,$00,$26,$00
    db $00,$00,$00,$00,$24,$00,$28,$00,$2B,$00,$00,$28,$2B,$00,$2D,$00
    db $00,$00,$2B,$00,$28,$00,$26,$00,$23,$00,$21,$00,$1F,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
LvTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$60,$18,$32,$07,$00,$0B,$00,$0E,$00,$10,$00,$07,$00,$0B,$00
    db $0E,$00,$0B,$00,$0C,$00,$10,$00,$13,$00,$10,$00,$07,$00,$0B,$00
    db $0E,$00,$0B,$00,$0C,$00,$10,$00,$13,$00,$15,$00,$0C,$00,$10,$00
    db $13,$00,$10,$00,$0E,$00,$12,$00,$15,$00,$12,$00,$07,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
}
