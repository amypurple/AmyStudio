data TitleMap bytes
  $20,$20,$20,$20,$20,$20,$20,$20,$9A,$9B,$9E,$9F,$A2,$A3,$A6,$A7,$AA,$AB,$9E,$9F,$AE,$AF,$B2,$B3,$20,$20,$20,$20,$20,$20,$20,$20
