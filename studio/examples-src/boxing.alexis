' sprite patterns of each pose: 6 per pose (top-left, top-right, middle,
' bottom), poses stand jab hook block down; purple's five then green's
data PosePat bytes 0,4,8,12,16,20,24,28,32,36,40,44,48,52,56,60,64,68,72,76,80,84,88,92,96,96,100,96,104,108,112,116,120,124,128,132,136,140,144,148,152,156,160,164,168,172,176,180,184,188,192,196,200,204,96,96,96,208,212,216

record Boxer:
  u8 X
  u8 E
  u8 Act
  u8 T
  u8 Cd
  u16 Sc
  u8 Latch
  u8 Hits
  u8 Shown
end record
Boxer Bx[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W = 0
u16 NumU = 0
u8 HistA[32]
u8 HistX[32]
u8 Players = 1
u8 Skill = 0
u8 Round = 1
u8 Secs = 0
u8 ClkC = 19
u8 RgC = 109
u8 Brk = 0
u8 Over = 0
u8 Winner = 0
u8 Ko = 0
u8 Down = 0
u8 CountN = 0
u8 CountV = 0
u8 CountC = 0
u8 MashC = 0
u8 Cj = 0
u8 Since = 0
u8 Per = 0
u8 Th = 9
u8 InPlay = 0
u8 Hits = 0
u8 Blocks = 0
' what the HUD shows (redrawn when it changes)
u8 ShSecs = 255
u8 ShE0 = 255
u8 ShE1 = 255
u8 ShCnt = 255
u16 ShSc0 = 65535
u16 ShSc1 = 65535
' input
u8 J0 = 0
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Pl = 0
u8 Dr = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BxSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  StepFrame
  DrawAll
  if Over = 0 then goto play_loop

  InPlay = 0
  EndMessage
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------- rules
sub StepFrame:
  if Brk > 0 then
    dec Brk
    if Brk = 0 then StartRound
  else
    PlayFrame
  end if
  return
end sub

sub PlayFrame:
  dec ClkC
  if ClkC = 0 then
    ClkC = ClockFr
    inc Secs
  end if
  dec RgC
  if RgC = 0 then
    RgC = RegenFr
    for Pl = 0 to 1
      if Bx[Pl].E < EMax then Bx[Pl].E = Bx[Pl].E + 1
    next
  end if
  K = Tick & 31
  HistA[K] = Bx[0].Act
  HistX[K] = Bx[0].X
  if Players = 1 then J1 = CpuStick()
  BoxStep(0, J0)
  if Over = 0 then BoxStep(1, J1)
  if Over = 0 then
    if Down > 0 then CountStep
    if Secs >= RoundSecs then
      if Down = 0 then RoundEnd
    end if
  end if
  return
end sub

sub CountStep:
  dec CountC
  if CountC = 0 then
    inc CountV
    play sound SndCount
    if CountV = CountN then
      Pl = Down - 1
      Bx[Pl].Act = 0
      Bx[Pl].Cd = Recover
      Bx[Pl].T = 0
      Down = 0
      CountV = 0
    else
      CountC = CountFr
    end if
  end if
  return
end sub

sub RoundEnd:
  u16 A = 0
  u16 B = 0
  if Round = 3 then
    Over = 1
    Ko = 0
    A = Bx[0].Sc
    B = Bx[1].Sc
    if A > B then
      Winner = 1
    elseif B > A then
      Winner = 2
    else
      Winner = 3
    end if
  else
    inc Round
    for Pl = 0 to 1
      if Bx[Pl].E < 188 then Bx[Pl].E = Bx[Pl].E + 10
    next
    Brk = BreakFr
    Secs = 0
    play sound SndBell
    ShowRound
  end if
  return
end sub

' one boxer's frame: his move, his punch's moment, his step
sub BoxStep(u8 P, u8 Jv):
  u8 Fb = 0
  u8 Pr = 0
  u8 Fwd = 8
  u8 Act = 0
  u8 Tm = 0
  u8 Dir = 0
  u8 Bx0 = 0
  u8 Moved = 0
  Fb = Jv & 16
  if Fb > 0 then
    if Bx[P].Latch = 0 then Pr = 1
    Bx[P].Latch = 1
  else
    Bx[P].Latch = 0
  end if
  if P = 1 then Fwd = 4
  Act = Bx[P].Act
  if Act <> 4 then
    if Act > 0 then
      Tm = Bx[P].T - 1
      Bx[P].T = Tm
      if Act < 3 then
        if Tm = HitAt then Strike(P)
      end if
      if Tm = 0 then
        if Over = 0 then
          Bx[P].Act = 0
          Bx[P].Cd = Recover
        end if
      end if
    else
      if Bx[P].Cd > 0 then Bx[P].Cd = Bx[P].Cd - 1
    end if
    if Over = 0 then
      if Pr = 1 then
        if Bx[P].Act = 0 then
          if Bx[P].Cd = 0 then StartMove(P, Jv, Fwd)
        end if
      end if
      ' steps on alternate frames: purple on even, green on odd
      K = Tick & 1
      if K = P then
        Dir = 0
        V = Jv & 15
        if V > 0 then
          K = Jv & Fwd
          if K > 0 then
            Dir = 1
          else
            Dir = 2
          end if
        end if
        if Down > 0 then Dir = 2
        Bx0 = Bx[P].X
        if Dir = 1 then
          if Gap() > MinGap then
            if P = 0 then
              Bx0 = Bx0 + 1
            else
              Bx0 = Bx0 - 1
            end if
          end if
        end if
        if Dir = 2 then
          if P = 0 then
            if Bx0 > XMin then Bx0 = Bx0 - 1
          else
            if Bx0 < XMax then Bx0 = Bx0 + 1
          end if
        end if
        Bx[P].X = Bx0
      end if
    end if
  end if
  return
end sub

function Gap() as u8
  return Bx[1].X - Bx[0].X

sub StartMove(u8 P, u8 Jv, u8 Fwd):
  u8 Kind = 3
  u8 En = 0
  u8 Ud = 0
  K = Jv & Fwd
  Ud = Jv & 3
  if K > 0 then
    select case Ud
    case 1, 3
      Kind = 1
    case 2
      Kind = 2
    end select
  end if
  En = Bx[P].E
  if Kind < 3 then
    En = En - CostT[Kind]
    Bx[P].T = PunchT
    play sound SndSwing
  else
    Bx[P].T = BlockT
  end if
  if En < EFloor then En = EFloor
  Bx[P].E = En
  Bx[P].Act = Kind
  return
end sub

function IsOpen(u8 O) as u8
  u8 A = 0
  u8 Res = 0
  A = Bx[O].Act
  if A = 0 then Res = 1
  if A < 3 then
    if Bx[O].T < HitAt then Res = 1
  end if
  return Res

' the punch's moment: it lands, hits a guard, or misses
sub Strike(u8 P):
  u8 O = 0
  u8 D = 0
  u8 En = 0
  u8 N = 0
  O = 1 - P
  if Gap() <= Reach then
    if IsOpen(O) = 1 then
      D = DmgT[Bx[P].Act]
      En = Bx[O].E
      if En < D + EFloor then
        En = EFloor
      else
        En = En - D
      end if
      Bx[O].E = En
      Bx[P].Sc = Bx[P].Sc + D
      Bx[P].Hits = Bx[P].Hits + 1
      inc Hits
      play sound SndThump
      if En < EKnock then
        N = En >> 1
        N = 25 - N
        if N >= 10 then
          Over = 1
          Ko = 1
          Winner = P + 1
          CountV = 10
        else
          Bx[O].Act = 4
          Bx[O].T = 0
          Bx[O].Cd = 0
          Down = O + 1
          CountN = N
          CountV = 0
          CountC = CountFr
          play sound SndDown
        end if
      end if
    else
      if Bx[O].Act = 3 then
        En = Bx[P].E
        if En < 3 + EFloor then
          En = EFloor
        else
          En = En - 3
        end if
        Bx[P].E = En
        inc Blocks
        play sound SndBlock
      end if
    end if
  end if
  return
end sub

' ------------------------------------------------------------ computer
sub Rand:
  W = Rs << 7
  Rs = Rs ^ W
  W = Rs >> 9
  Rs = Rs ^ W
  W = Rs << 8
  Rs = Rs ^ W
  return
end sub

' green's stick: from purple as seen LagT frames late
function CpuStick() as u8
  u8 R = 0
  u8 Va = 0
  u8 Vx = 0
  u8 Pv = 0
  u8 Ix = 0
  u8 Lg = 0
  u8 D = 0
  u8 Gv = 0
  u8 Ej = 0
  u8 Me = 0
  u8 You = 0
  u8 Jr = 0
  u16 Ew = 0
  Rand
  R = Rs & 255
  Lg = LagT[Skill]
  Ix = Tick - Lg
  Ix = Ix & 31
  Va = HistA[Ix]
  Vx = HistX[Ix]
  Ix = Ix - 1
  Ix = Ix & 31
  Pv = HistA[Ix]
  if Since < 250 then inc Since
  if Va <> 0 then
    if Va <> 4 then
      if Pv <> Va then
        if Since > Per then
          D = Since - Per
        else
          D = Per - Since
        end if
        if Per > 0 and D <= 2 then
          if MashC < 8 then inc MashC
        else
          MashC = 0
        end if
        if Since < 60 then
          Per = Since
        else
          Per = 0
        end if
        Since = 0
        if Va = 3 then
          Th = BlockT
        else
          Th = HitAt + 1
        end if
      end if
    end if
  end if
  Gv = Bx[1].X - Vx
  Me = Bx[1].E
  You = Bx[0].E
  if Down = 0 then
    if Me < 60 and You > Me + 30 and Gv < 40 then
      Jr = 8
    elseif Gv > 27 then
      Jr = 4
    end if
    K = Cj & 16
    if Bx[1].Act = 0 and Bx[1].Cd = 0 and K = 0 and Gv <= Reach then
      if MashC >= MashT[Skill] and Per > 0 then
        ' a rhythm puncher: counter when his move is spent
        Ew = Since + Lg
        Ew = Ew + HitAt + 1
        Ew = Ew % Per
        Ej = Ew
        if Ej >= Th and R < 160 then
          Jr = 22
        elseif Va <> 3 and R < GuardT[Skill] then
          Jr = 16
        end if
      elseif Va = 0 and R < AggrT[Skill] then
        Jr = 21
        K = R & 1
        if Me > 80 and K = 1 then Jr = 22
      elseif Va = 0 and Me < 70 and R > 250 then
        Jr = 16
      end if
    end if
  end if
  Cj = Jr
  return Jr

' ------------------------------------------------------------- rounds
sub StartRound:
  Bx[0].X = 24
  Bx[1].X = 200
  for Pl = 0 to 1
    Bx[Pl].Act = 0
    Bx[Pl].T = 0
    Bx[Pl].Cd = 0
  next
  ClkC = ClockFr
  Secs = 0
  RgC = RegenFr
  Brk = 0
  Down = 0
  CountN = 0
  CountV = 0
  CountC = 0
  fill array HistA with 0
  fill array HistX with 0
  ShowRound
  return
end sub

sub NewGame:
  NewScreen
  copy RingMap count 768 to vram.name
  print at 2,1, "PURPLE"
  print at 25,1, "GREEN"
  print at 2,2, "ENERGY"
  print at 24,2, "ENERGY"
  print at 2,3, "SCORE"
  print at 25,3, "SCORE"
  print at 2,21, "     RINGSIDE  BOXING     "
  for Pl = 0 to 1
    Bx[Pl].E = 198
    Bx[Pl].Sc = 0
    Bx[Pl].Latch = 1
    Bx[Pl].Hits = 0
    Bx[Pl].Shown = 255
  next
  Round = 1
  Over = 0
  Winner = 0
  Ko = 0
  MashC = 0
  Cj = 0
  Since = 0
  Per = 0
  Th = HitAt + 1
  Hits = 0
  Blocks = 0
  ShSecs = 255
  ShE0 = 255
  ShE1 = 255
  ShSc0 = 65535
  ShSc1 = 65535
  ShCnt = 255
  StartRound
  DrawAll
  ShowScreen
  play sound SndBell
  Rearm
  wait no fire
  nmi off
  InPlay = 1
  return
end sub

' ------------------------------------------------------------- drawing
sub DrawAll:
  DrawHud
  for Dr = 0 to 1
    DrawBoxer(Dr)
  next
  update sprites
  return
end sub

sub DrawBoxer(u8 P):
  u8 Pose = 0
  u8 Base = 0
  u8 Sp = 0
  u8 Bd = 0
  u8 Px = 0
  u8 Py = 0
  u8 Cl = 0
  u8 Pt = 0
  Pose = Bx[P].Act
  if Over > 0 then
    if Winner = P + 1 then Pose = 3
    if Winner <> P + 1 and Winner < 3 then Pose = 4
  end if
  Base = P * 5 + Pose
  Base = Base * 6
  Sp = P * 6
  Py = BoxY
  if Pose = 0 then
    K = Tick >> 4
    K = K & 1
    Py = Py - K
  end if
  for Bd = 0 to 2
    Cl = BandCol[P * 3 + Bd]
    Px = Bx[P].X
    Pt = PosePat[Base]
    set sprite Sp to Py,Px,Pt,Cl
    Px = Px + 16
    Pt = PosePat[Base + 1]
    set sprite Sp + 1 to Py,Px,Pt,Cl
    Base = Base + 2
    Sp = Sp + 2
    Py = Py + 16
  next
  return
end sub

function Pct(u8 E) as u8
  return E >> 1

sub DrawHud:
  u8 M = 0
  u8 S = 0
  if Secs <> ShSecs then
    ShSecs = Secs
    M = Secs / 60
    S = Secs % 60
    NumU = M
    print at 14,1, digits$(NumU, 1)
    print at 15,1, ":"
    NumU = S
    print at 16,1, digits$(NumU, 2)
  end if
  V = Pct(Bx[0].E)
  if V <> ShE0 then
    ShE0 = V
    NumU = V
    print at 9,2, digits$(NumU, 2)
    print at 11,2, "%"
  end if
  V = Pct(Bx[1].E)
  if V <> ShE1 then
    ShE1 = V
    NumU = V
    print at 19,2, digits$(NumU, 2)
    print at 21,2, "%"
  end if
  if Bx[0].Sc <> ShSc0 then
    ShSc0 = Bx[0].Sc
    NumU = ShSc0
    print at 8,3, digits$(NumU, 3)
  end if
  if Bx[1].Sc <> ShSc1 then
    ShSc1 = Bx[1].Sc
    NumU = ShSc1
    print at 21,3, digits$(NumU, 3)
  end if
  if CountV <> ShCnt then
    ShCnt = CountV
    NumU = CountV
    print at 22,4, "COUNT"
    print at 28,4, digits$(NumU, 2)
  end if
  return
end sub

sub ShowRound:
  NumU = Round
  print at 2,4, "ROUND "
  print at 8,4, digits$(NumU, 1)
  return
end sub

sub EndMessage:
  DrawAll
  fill 32 count 28 at 2,4
  if Winner = 3 then
    print at 6,4, "A DRAW ON POINTS"
  else
    if Winner = 1 then
      print at 3,4, "PURPLE"
      X = 10
    else
      print at 3,4, "GREEN"
      X = 9
    end if
    if Ko = 1 then
      print at X,4, "WINS BY KNOCKOUT"
    else
      print at X,4, "WINS ON POINTS"
    end if
  end if
  return
end sub

' --------------------------------------------------------- frame, input
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

function PadBits(u8 N) as u8
  u8 B = 0
  if joypad(N).up then B = B | 1
  if joypad(N).down then B = B | 2
  if joypad(N).left then B = B | 4
  if joypad(N).right then B = B | 8
  if joypad(N).fire then B = B | 16
  return B

sub ReadPad:
  J0 = PadBits(1)
  J1 = 0
  if Players = 2 then J1 = PadBits(2)
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ------------------------------------------------------- title, credits
sub TitlePage:
  NewScreen
  copy TitleMap count 160 to vram.name + 96
  print at 7,9, "COMPUTE!'S GAZETTE"
  print at 11,10, "MARCH 1987"
  Menu = 0
  ShowMenu
  ' the two boxers on guard either side of the menu
  for Dr = 0 to 1
    Bx[Dr].Act = 0
  next
  Bx[0].X = 24
  Bx[1].X = 200
  Over = 0
  for Dr = 0 to 1
    DrawBoxer(Dr)
  next
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  J0 = PadBits(1)
  J1 = PadBits(2)
  K = J0 | J1
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = K & 15
  if V > 0 then
    if WasStick = 0 then MenuMove(V)
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W = Tick
  Rs = Rs ^ W
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub MenuMove(u8 S):
  select case S
  case 1
    if Menu > 0 then dec Menu
  case 2
    if Menu < 3 then inc Menu
  case 4, 8
    if Menu = 0 then Players = 3 - Players
    if Menu = 1 then Skill = 1 - Skill
  end select
  ShowMenu
  return
end sub

sub ShowMenu:
  for J = 13 to 19 step 2
    put char 32 at 9,J
  next
  if Players = 1 then
    print at 11,13, "1 PLAYER "
  else
    print at 11,13, "2 PLAYERS"
  end if
  if Skill = 0 then
    print at 11,15, "CPU EASY"
  else
    print at 11,15, "CPU HARD"
  end if
  print at 11,17, "START"
  print at 11,19, "CREDITS"
  J = Menu * 2 + 13
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "RINGSIDE BOXING"
  print at 2,4, "BASED ON RINGSIDE BOXING,"
  print at 2,5, "COMPUTE!'S GAZETTE DISK,"
  print at 2,6, "MARCH 1987 (COMMODORE 64"
  print at 2,7, "MACHINE LANGUAGE; NO AUTHOR"
  print at 2,8, "NAMED ON THE DISK)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026. MUSIC: GLOVES UP"
  print at 2,15, "(ORIGINAL)."
  print at 2,17, "STICK TOWARD: STEP IN"
  print at 2,18, "BUTTON+UP-TOWARD: JAB"
  print at 2,19, "BUTTON+DOWN-TOWARD: HOOK"
  print at 2,20, "BUTTON ALONE: GUARD"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

