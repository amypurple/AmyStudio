asm {
; CaDrawRow: one row of the window's walls and floor. In: RowB (index of
; the first wall byte), Bx0 (its bit: Bx0 & 7), Cnt cells, VAddr (name
; table offset), FloorT (the floor tile). A wall bit is TBrick.
CaDrawRow:
    ld a,$A5
    ld ($701F),a
    ld hl,(AMY_UVAR_VAddr)
    ld de,($73F6)
    add hl,de
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld hl,(AMY_UVAR_RowB)
    ld de,AMY_UDATA_Walls
    add hl,de
    ld a,(AMY_UVAR_Bx0)
    and 7
    ld c,a
    ld e,(hl)
    ld b,c
    inc b
    jr CaDrSh1
CaDrSh0:
    sla e
CaDrSh1:
    djnz CaDrSh0
    ld a,(AMY_UVAR_Cnt)
    ld b,a
    ld a,(AMY_UVAR_FloorT)
    ld d,a
CaDrLoop:
    sla e
    ld a,AMY_UCONST_TBrick
    jr c,CaDrOut
    ld a,d
CaDrOut:
    out (VDP_DATA_PORT),a
    inc c
    ld a,c
    and 7
    jr nz,CaDrNext
    inc hl
    ld e,(hl)
CaDrNext:
    djnz CaDrLoop
    jp AMY_RELEASE_VDP_GUARD

CaStep:
    db $00,$00,$46,$01,$00,$00,$76,$02,$10
CaBump:
    db $40,$F9,$33,$03,$50
CaGold:
    db $40,$47,$10,$03,$40,$35,$10,$03,$40,$2A,$20,$08,$50
CaKey:
    db $40,$6B,$10,$04,$40,$55,$10,$04,$40,$47,$10,$04,$40,$35,$20,$0C,$50
CaTrap:
    db $40,$F9,$12,$06,$40,$25,$13,$06,$40,$56,$23,$06,$40,$8D,$23,$0C,$50
CaLocked:
    db $40,$FC,$21,$06,$40,$3B,$32,$0A,$50
CaChomp:
    db $00,$00,$05,$04,$00,$00,$16,$04,$00,$00,$26,$08,$00,$00,$47,$10,$10
CaDown:
    db $40,$7C,$20,$02,$40,$86,$20,$02,$40,$90,$20,$02,$40,$9B,$20,$02,$40,$A6,$20,$02,$40,$B3,$20,$02
    db $40,$C0,$20,$02,$40,$CF,$20,$02,$40,$DE,$20,$02,$40,$EF,$20,$02,$40,$01,$21,$02,$40,$14,$21,$02
    db $40,$29,$21,$02,$40,$3F,$21,$02,$40,$57,$21,$02,$40,$71,$21,$02,$40,$8D,$21,$02,$40,$AB,$21,$02
    db $40,$CA,$21,$02,$40,$ED,$21,$02,$40,$12,$22,$02,$40,$3B,$22,$02,$40,$67,$22,$02,$50
CaStart:
    db $40,$AB,$21,$06,$40,$53,$21,$06,$40,$1D,$21,$06,$40,$D6,$20,$0E,$50
CaWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$55,$10,$08,$40,$47,$20,$1E
    db $50

CaSoundTable:
    dw CaTuneMel,$702B
    dw CaTuneBass,$7035
    dw CaStep,$703F
    dw CaBump,$7049
    dw CaGold,$7049
    dw CaKey,$7049
    dw CaTrap,$7049
    dw CaLocked,$7049
    dw CaChomp,$703F
    dw CaDown,$7049
    dw CaStart,$7049
    dw CaWin,$7049
; Down the Old Stair (original)
; Tiny Sound, 9 frames per step
CaTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$21,$01,$01,$1C,$01,$01,$18,$01,$1A,$01,$1C,$01
    db $01,$01,$01,$01,$1D,$01,$1C,$01,$1A,$01,$18,$01,$17,$01,$01,$01
    db $15,$01,$01,$01,$18,$01,$1C,$01,$21,$01,$01,$01,$1F,$01,$1D,$01
    db $1C,$01,$01,$01,$1A,$01,$1D,$01,$1C,$01,$1A,$01,$18,$01,$17,$01
    db $14,$01,$15,$01,$01,$01,$00,$01,$01
    db $FF
CaTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$15,$01,$1C,$01,$15,$01,$1C,$01,$15,$01,$1C,$01
    db $15,$01,$1C,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$10,$01,$17,$01
    db $10,$01,$17,$01,$15,$01,$1C,$01,$15,$01,$1C,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$10,$01,$17,$01
    db $10,$01,$15,$01,$01,$01,$00,$01,$01
    db $FF
}
