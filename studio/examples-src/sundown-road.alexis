' the things seen this frame (the sprite places 3-24 take turns)
u8 SeeN = 0
u8 SeeY[11]
u8 SeeX[11]
u8 SeeP[11]
u8 SeeC[11]
u8 Rot = 0
u8 ObPat = 0
u8 ObR = 0
u8 ObCol = 0

u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Sel = 0
u8 Tick = 0

' scratch: never kept across a sub call
u16 W16 = 0
u16 W2 = 0
i16 S16 = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 V2 = 0
