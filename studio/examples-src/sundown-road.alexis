' the things: their sprite colours (pine, oak, gift, flower, stump, puddle)
data KindCol bytes 1, 10, 13, 9, 6, 5
' how wide each is at the car, in pixels either side (for hitting it)
' the traffic's colours (tractor, cyclist; by TrK)
data KindColT bytes 0, 4, 1
data KindHit bytes 10, 12, 20, 18, 18, 22
' the sky through the afternoon, 6 steps: the colours of its 4 bands (rows
' 2-5, top to bottom; the top one is also the backdrop, behind rows 0-1
' and the letters), and of the hills. Each band dithers into the next.
' Afternoon blue; then the horizon pales, warms to gold and pink under a
' darkening blue; at the end, dusk.
data SkyCols bytes 5, 5, 5, 5, 3,   4, 5, 5, 7, 3,   4, 5, 7, 11, 3,   4, 13, 9, 10, 2,   4, 4, 13, 9, 12,   1, 4, 4, 13, 12
' the land through the same 6 steps: the grass's two stripes, the pines,
' the oaks. In the sun: green and gold stripes, green trees; then the
' gold deepens, and the trees go dark against it: black pines, red oaks
data LandCols bytes 3, 11, 12, 2,   3, 11, 12, 2,   3, 10, 12, 2,   2, 10, 1, 6,   12, 10, 1, 6,   12, 4, 1, 13
' the sun reddens as it goes down
data SunCol bytes 15, 11, 9, 8, 8, 6
' the sun's height (screen line of its top) through the same 6 steps
' the car's hop as it tumbles, by loop
data FlipY bytes 0, 7, 12, 15, 16, 15, 12, 7, 0, 4, 5, 4
data SunH bytes 18, 24, 30, 36, 42, 48

  tile screen
  set sound table SrSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    HowToPage
    goto title
  end if
  if Sel = 2 then
    CreditsPage
    goto title
  end if

  ' --- the drive: four legs before sundown
  Leg = 0
  Gifts = 0
  Flowers = 0
  Score = 0
  SunT = 0
  SunA = 0
  SunPx = 0
  SunPx5 = 0
  SunStep = 0
  Late = 0
  Spd = 0
  Px = 0
  PxS = 0
  Vx = 0
  Ya = 0
  Drift = 0
  RoadScreen
leg_start:
  StartLeg
drive_loop:
  Busy = 1
  ReadPad
  Drive
  Things
  Sky
  asm {
    call SrRoad
    call SrHills
  }
  ' the counters: printed into each of the two pages once after a change
  if HudN > 0 then
    dec HudN
    ShowHud
  end if
  Busy = 0
  Rearm
  wait
  nmi off
  asm {
    call SrFlip
  }
  update sprites
  Tick = Tick + 3
  if Late = 1 then goto too_late
  if Pos < LegEnd then goto drive_loop
  inc Leg
  if Leg < NLegs then goto leg_start
  ' --- there!
  EngV = 15
  SkV = 15
  asm {
    call SrEngine
    call SrSqueal
  }
  Arrive
  goto title

too_late:
  EngV = 15
  SkV = 15
  asm {
    call SrEngine
    call SrSqueal
  }
  HideSprites
  play sound SndLate
  Message
  print at 6,3, "THE SUN HAS SET..."
  ShowBoth
  Hold(150)
  LatePage
  goto title

' ---------------------------------------------------------------------------
' a leg of the drive

sub StartLeg:
  Pos = 0
  TrK[0] = 0
  TrK[1] = 0
  TrNext = 2800
  PosF = 0
  First = LegObj[Leg]
  LegEnd = LegLen[Leg]
  BendI = LegBend[Leg]
  BendN = LegBends[Leg]
  BendEnd = BendLen[BendI]
  CurveTo = BendCurve[BendI]
  ' its name, a while, in the sky
  Message
  W16 = Leg * 12
  for I = 0 to 11
    V = LegNames[W16]
    X = I + 9
    put char V at X,2
    inc W16
  next
  ShowBoth
  MsgT = 50
  HudN = 2
  return
end sub

' Drive: a loop's worth (3 frames) of the car
sub Drive:
  ' the pedal, the brake, the grass
  if Spin > 0 then
    if Spd > 30 then Spd = Spd - 6
  else
    if Btn = 1 then
      if Spd < 192 then
        Spd = Spd + 8
      else
        ' above top speed only after a drift's boost, and that fades
        if Spd > 202 then
          Spd = Spd - 2
        else
          Spd = 200
        end if
      end if
    else
      if Spd > 3 then
        Spd = Spd - 3
      else
        Spd = 0
      end if
    end if
    ' a drift: a touch of the brake while turning, pedal down, fast enough
    V = Lf1 | Rt1
    if Drift = 0 then
      if Dn1 = 1 then
        if V = 1 then
          if Btn = 1 then
            W16 = RdCurve
            if RdCurve < 0 then W16 = 0 - RdCurve
            if Spd >= 120 then
              if W16 >= 300 then
                ' the back steps out: the car turns sharply into the slide
                Drift = 1
                DriftT = 0
                if Lf1 = 1 then Ya = Ya - 12
                if Rt1 = 1 then Ya = Ya + 12
                play sound SndSkid
              end if
            end if
          end if
        end if
      end if
    end if
    V2 = Dn1
    if Drift > 0 then V2 = 0
    if V2 = 1 then
      if Spd > 18 then
        Spd = Spd - 18
      else
        Spd = 0
      end if
    end if
  end if
  ' off the road: slow, and it rumbles
  V = 0
  if Px > 96 then V = 1
  if Px < -96 then V = 1
  if V = 1 then
    if Spd > 90 then Spd = Spd - 12
    if Spd > 10 then play sound SndRumble
  end if
  ' along: Pos += Spd * 3 / 16
  W16 = Spd * 3
  V = lowbyte W16
  V = V & 15
  W16 = W16 >> 4
  PosF = PosF + V
  if PosF >= 16 then
    PosF = PosF - 16
    inc W16
  end if
  Pos = Pos + W16
  ' the bends
  if Pos >= BendEnd then
    if BendN > 1 then
      dec BendN
      inc BendI
      BendEnd = BendEnd + BendLen[BendI]
      CurveTo = BendCurve[BendI]
    else
      CurveTo = 0
      BendEnd = 65000
    end if
  end if
  if RdCurve < CurveTo then
    RdCurve = RdCurve + 40
    if RdCurve > CurveTo then RdCurve = CurveTo
  end if
  if RdCurve > CurveTo then
    RdCurve = RdCurve - 40
    if RdCurve < CurveTo then RdCurve = CurveTo
  end if
  ' --- the car across the road, with momentum. The stick turns the car
  ' (Ya, its heading against the road); the tyres' grip pulls its sideways
  ' speed (Vx) towards where it points (T = Ya * Spd); the bend carries
  ' it outwards (Push). In a drift the grip is low: the car turns further,
  ' slides, and scrubs speed; the stick against the slide straightens it.
  if Spin > 0 then
    dec Spin
    Ya = 0
  else
    if Drift > 0 then
      ' drifting: turning in tightens the slide, turning out eases it
      if Lf1 = 1 then Ya = Ya - 3
      if Rt1 = 1 then Ya = Ya + 3
      if Ya > 44 then Ya = 44
      if Ya < -44 then Ya = -44
      V = Lf1 | Rt1
      if V = 0 then
        if Ya > 0 then dec Ya
        if Ya < 0 then inc Ya
      end if
    else
      if Lf1 = 1 then Ya = Ya - 4
      if Rt1 = 1 then Ya = Ya + 4
      if Ya > 32 then Ya = 32
      if Ya < -32 then Ya = -32
      V = Lf1 | Rt1
      if V = 0 then
        ' the wheel comes back to the middle
        if Ya > 4 then
          Ya = Ya - 4
        else
          if Ya < -4 then
            Ya = Ya + 4
          else
            Ya = 0
          end if
        end if
      end if
    end if
  end if
  ' the drift: it lasts while the pedal is down, the car fast enough and
  ' turned well across; let go after a good long one: a boost
  if Drift > 0 then
    V = 1
    if Btn = 0 then V = 0
    if Spd < 80 then V = 0
    if Spin > 0 then V = 0
    if Ya < 8 then
      if Ya > -8 then V = 0
    end if
    if V = 0 then
      if DriftT >= 45 then
        Spd = Spd + 30
        if Spd > 230 then Spd = 230
        play sound SndBoost
      end if
      Drift = 0
    else
      DriftT = DriftT + 3
      if DriftT > 250 then DriftT = 250
      ' sliding scrubs speed
      S16 = Ya
      if S16 < 0 then S16 = 0 - S16
      S16 = S16 >> 4
      V = lowbyte S16
      if Spd > V then Spd = Spd - V
    end if
  end if
  ' the squeal: a wavering high note while the tyres slide
  SkV = 15
  if Drift > 0 then
    SkV = 9
    V = Tick & 6
    SkP = 46 + V
  end if
  if Spin > 0 then
    SkV = 10
    V = Spin * 5
    SkP = 60 + V
  end if
  asm {
    call SrSqueal
  }
  ' sideways speed towards where the car points: fast with grip, slowly
  ' in a slide (in 16ths of a pixel a loop)
  S16 = Ya * Spd
  S16 = S16 / 16
  S16 = S16 - Vx
  if Drift > 0 then
    S16 = S16 / 8
  else
    S16 = S16 / 2
  end if
  Vx = Vx + S16
  ' and the bend carries the car outwards
  asm {
    call SrBend
  }
  S16 = Push * 16
  PxS = PxS + Vx
  PxS = PxS - S16
  if PxS > 2720 then
    PxS = 2720
    Vx = 0
  end if
  if PxS < -2720 then
    PxS = -2720
    Vx = 0
  end if
  Px = PxS / 16
  ' how the car looks: straight, turning, or across the road and smoking
  Steer = 0
  if Ya <= -6 then Steer = 1
  if Ya >= 6 then Steer = 2
  if Drift > 0 then
    if Ya <= -16 then Steer = 3
    if Ya >= 16 then Steer = 4
  end if
  ' tumbling: right way up and upside down by turns
  if Spin > 0 then
    V = Spin & 2
    Steer = 0
    if V > 0 then Steer = 5
  end if
  RdP = Px
  ' the far hills slide the other way
  BgX = BgX + BgD
  ' stripes
  W16 = Pos >> 1
  RdPosQ = lowbyte W16
  ' the engine: higher with speed
  W16 = Spd
  W16 = 900 - W16
  W16 = W16 - Spd
  EngP = W16 - Spd
  EngV = 15
  if Spd > 0 then EngV = 11
  asm {
    call SrEngine
  }
  ' the sun goes down: a pixel every 70 steps, the sky's colours every 2100
  SunT = SunT + 3
  SunA = SunA + 3
  if SunA >= 70 then
    SunA = SunA - 70
    inc SunPx
    inc SunPx5
    if SunPx5 = 30 then
      SunPx5 = 0
      inc SunStep
    end if
  end if
  if SunT >= 12600 then Late = 1
  return
end sub

' Things: the things passing the car, and those ahead as sprites
sub Things:
  ' those reaching the car: a gift, a flower, a stump...
th_pass:
  ObI = First
  asm {
    call SrObj
  }
  if ObZ = 65535 then goto th_seen
  W16 = Pos + 40
  if ObZ < W16 then
    Hit
    inc First
    goto th_pass
  end if
th_seen:
  ' those ahead, nearest first, 11 sprites at most (things.asm)
  asm {
    call SrThings
  }
th_done:
  ' the slow traffic, after the things (while there is room)
  Traffic
  ' the sprites: places 6 to 16 take turns among the things seen
  inc Rot
  if Rot >= SeeN then Rot = 0
  for I = 0 to 10
    N = I + 6
    if I >= SeeN then
      set sprite N to 192,0,0,0
    else
      J = I + Rot
      if J >= SeeN then J = J - SeeN
      Y = SeeY[J]
      X = SeeX[J]
      Q = SeeP[J]
      V = SeeC[J]
      set sprite N to Y,X,Q,V
    end if
  next
  ' the car: five sprites (places 0-4, always in front)
  Y = 165
  if Splash > 0 then
    dec Splash
    Y = 163
  end if
  if Spin > 0 then
    V = 12 - Spin
    Y = Y - FlipY[V]
  end if
  ShowCar
  ' drifting: smoke from both back tyres, puffing
  Y = 192
  if Steer >= 3 then
    if Steer <= 4 then
      Y = 170
      J = Tick & 4
      if J > 0 then Y = 173
    end if
  end if
  set sprite 18 to Y,104,SPuff,15
  J = Y
  if Y < 192 then J = Y ^ 3
  set sprite 19 to J,136,SPuff,15
  return
end sub

' ShowCar: the car at line Y as Steer has it (0 straight, 1 and 2 turning
' left and right: the top leans a pixel; 3 and 4 drifting; 5 upside
' down). Six sprites (places 0-5), their boxes spread so that no line of
' the car has more than four
sub ShowCar:
  V = 0
  if Steer = 3 then V = 1
  if Steer = 4 then V = 2
  if Steer = 5 then V = 3
  V = V * 24
  V = V + SCarSy
  X = 120
  if Steer = 1 then X = 119
  if Steer = 2 then X = 121
  Q = Y - 6
  set sprite 0 to Q,X,V,11
  V = V + 4
  Q = Y - 8
  set sprite 1 to Q,X,V,1
  V = V + 4
  set sprite 2 to Y,116,V,8
  V = V + 4
  set sprite 3 to Y,124,V,8
  V = V + 4
  Q = Y + 10
  set sprite 4 to Q,116,V,1
  V = V + 4
  set sprite 5 to Q,124,V,1
  return
end sub

' Traffic: tractors and cyclists going the same way, slower: one comes
' along every so often, keeps to its side of the road, and is gone once
' passed. Running into one tumbles the car like a stump.
sub Traffic:
  ' a new one, out of sight ahead, every 2600-4600 units (not near the
  ' leg's end)
  W16 = Pos + 2800
  if W16 >= TrNext then
    W2 = LegEnd - 600
    if W16 < W2 then
      J = 255
      if TrK[1] = 0 then J = 1
      if TrK[0] = 0 then J = 0
      if J < 2 then
        TrZ[J] = W16
        Rnd = Rnd * 5
        Rnd = Rnd + 17
        V = Rnd & 1
        TrK[J] = V + 1
        V = Rnd & 2
        if V > 0 then
          TrL[J] = 7
        else
          TrL[J] = -7
        end if
      end if
    end if
    Rnd = Rnd * 5
    Rnd = Rnd + 17
    W2 = Rnd & 2047
    W2 = W2 + 2600
    TrNext = W16 + W2
  end if
  for I = 0 to 1
    K = TrK[I]
    if K > 0 then
      ' along: a tractor 4 units a frame, a cyclist 6
      V = K * 6
      V = V + 6
      W16 = V
      TrZ[I] = TrZ[I] + W16
      W16 = TrZ[I]
      ObZ = W16
      W2 = Pos + 100
      if W16 < Pos then
        TrK[I] = 0
      else
        ' level with the car: under it?
        if W16 < W2 then
          S16 = TrL[I]
          S16 = S16 * 25
          S16 = S16 / 4
          S16 = S16 - Px
          if S16 < 0 then S16 = 0 - S16
          if S16 < 20 then
            if Spin = 0 then
              Spin = 12
              Spd = Spd >> 2
              Drift = 0
              play sound SndBump
            end if
          end if
        end if
        ' on the screen
        if SeeN < 11 then
          ObL = TrL[I]
          asm {
            call SrProj
          }
          if ObV = 1 then
            V2 = ObS
            if V2 > 3 then V2 = 3
            V = K + 5
            ObK = V
            V = V * 16
            J = V2 * 4
            ObPat = V + J
            ObCol = KindColT[K]
            Y = ObY - 16
            asm {
              ld a,(AMY_UVAR_Y)
              call SrSee
            }
          end if
        end if
      end if
    end if
  next
  return
end sub

' Hit: thing ObI has reached the car: is it under it?
sub Hit:
  ' its place across at the car, in pixels from the road's middle
  S16 = ObL
  S16 = S16 * 25
  S16 = S16 / 4
  S16 = S16 - Px
  if S16 < 0 then S16 = 0 - S16
  K = ObK
  V = KindHit[K]
  if S16 >= V then return
  if K = 2 then
    inc Gifts
    HudN = 2
    play sound SndGift
    return
  end if
  if K = 3 then
    inc Flowers
    HudN = 2
    play sound SndFlower
    return
  end if
  if K = 5 then
    ' a puddle: a splash, and slower
    W16 = Spd * 2
    W16 = W16 / 3
    Spd = lowbyte W16
    Splash = 6
    play sound SndSplash
    return
  end if
  ' a stump, or a tree: the car flips over, and over
  if Spin = 0 then
    Spin = 12
    Spd = Spd >> 2
    Drift = 0
    play sound SndBump
  end if
  return
end sub

' Sky: the sky's colours and the sun, as the afternoon goes
sub Sky:
  V = SunStep
  if V > 5 then V = 5
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then
      Message
      ShowBoth
    end if
  end if
  if V <> SkyNow then
    SkyNow = V
    SetSky
  end if
  ' the sun sinks smoothly between the steps
  V = SunPx >> 2
  Y = V + 14
  ' going behind the hills: its pattern is remade each loop with the
  ' hills' pixels cut out of it (things.asm), as pattern 240
  SunY = Y
  asm {
    call SrSunMask
  }
  Q = 248
  V = SkyNow
  V = SunCol[V]
  set sprite 17 to Y,200,Q,V
  return
end sub

sub SetSky:
  ' the grass's two stripes and the trees, for this time of day
  K = SkyNow * 4
  V = LandCols[K]
  RdGr1 = V << 4
  inc K
  V = LandCols[K]
  RdGr2 = V << 4
  inc K
  TreeC[0] = LandCols[K]
  inc K
  TreeC[1] = LandCols[K]
  K = SkyNow * 5
  ' each band: its own colour behind, the next band's in front (the dither)
  for I = 0 to 3
    V = SkyCols[K]
    V2 = V
    if I < 3 then
      J = K + 1
      V2 = SkyCols[J]
    end if
    V2 = V2 << 4
    V = V | V2
    W16 = I * 8
    W16 = W16 + 1024
    fill V count 8 to vram.color + W16
    inc K
  next
  ' the hills (in front of the lowest band), the tree line over them
  V = SkyCols[K]
  J = K - 1
  V2 = SkyCols[J]
  V = V << 4
  V = V | V2
  W16 = THill00 * 8
  fill V count 512 to vram.color + W16
  V = SkyCols[K] | $C0
  W16 = TPine00 * 8
  fill V count 256 to vram.color + W16
  ' the backdrop: the top band's colour
  J = SkyNow * 5
  BdC = SkyCols[J]
  asm {
    ld a,(AMY_UVAR_BdC)
    out ($BF),a
    ld a,$87
    out ($BF),a
  }
  return
end sub

sub ShowHud:
  print at 2,1, "GIFTS"
  print at 8,1, digits$(Gifts, 2)
  print at 11,1, "FLOWERS"
  print at 19,1, digits$(Flowers, 2)
  print at 22,1, "LEG"
  V = Leg + 1
  if V > 4 then V = 4
  print at 26,1, digits$(V, 1)
  print at 27,1, "/4"
  return
end sub

' ---------------------------------------------------------------------------
' the screens

' RoadScreen: the road's screen: sky tiles in rows 2-5 of both pages
sub RoadScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  copy TilePat count NTiles8 to vram.pattern + 1024
  asm {
    call SrRoadMode
  }
  ' the letters of the top third: white
  fill $F0 count 512 to vram.color + 256
  fill 32 count 768 to vram.name
  W2 = 1024
  fill 32 count 768 to vram.name + W2
  for I = 0 to 3
    W16 = I + 2
    W16 = W16 * 32
    V = TSky0 + I
    fill V count 32 to vram.name + W16
    W2 = W16 + 1024
    fill V count 32 to vram.name + W2
  next
  SkyNow = 255
  V = SunStep
  if V > 5 then V = 5
  SkyNow = V
  SetSky
  screen on
  return
end sub

' Message: rows 2-5 back to plain sky in both pages (then text goes on)
sub Message:
  for I = 2 to 5
    W16 = I * 32
    V = I - 2
    V = V + TSky0
    fill V count 32 to vram.name + W16
    W2 = W16 + 1024
    fill V count 32 to vram.name + W2
  next
  return
end sub

' ShowBoth: what was printed in the hidden page's rows 2-5, into the
' shown page too
sub ShowBoth:
  asm {
    ld hl,(VDP_NAME_SHADOW)
    ld de,64
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld hl,AMY_UVAR_RdCx
    ld b,128
ShowB1:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz ShowB1
    ld hl,(VDP_NAME_SHADOW)
    ld a,h
    xor $04
    ld h,a
    ld de,64
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_RdCx
    ld b,128
ShowB2:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ShowB2
  }
  return
end sub

sub TitlePage:
  SunT = 0
  SunStep = 0
  SunPx = 0
  RoadScreen
  Message
  print at 9,2, "SUNDOWN ROAD"
  print at 12,3, "DRIVE"
  print at 12,4, "HOW TO PLAY"
  print at 12,5, "CREDITS"
  ShowBoth
  Sel = 0
  ShowTitleMenu
  play song SrSong once
  WaitStick
  RdCurve = 0
  Px = 0
  Spd = 120
  First = 0
  Leg = 0
  Pos = 0
tp_loop:
  ' the road rolls on under the menu
  Pos = Pos + 20
  W16 = Pos >> 1
  RdPosQ = lowbyte W16
  V = Tick & 128
  if V > 0 then
    RdCurve = 500
  else
    RdCurve = -500
  end if
  RdP = 0
  asm {
    call SrRoad
    call SrHills
  }
  Spd = 120
  asm {
    call SrBend
  }
  BgX = BgX + BgD
  set sprite 17 to 20,200,SSun,11
  Y = 165
  Steer = 0
  ShowCar
  Rearm
  wait
  nmi off
  asm {
    call SrFlip
  }
  update sprites
  Tick = Tick + 3
  ReadPad
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      play sound SndTick
      ShowTitleMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop song
  mute all
  play sound SndGift
  return
end sub

sub ShowTitleMenu:
  ' in both pages
  for I = 0 to 2
    Y = I + 3
    W16 = Y * 32
    W16 = W16 + 10
    V = 32
    if I = Sel then V = 62
    vpoke vram.name + W16, V
    W2 = W16 + 1024
    vpoke vram.name + W2, V
  next
  return
end sub

sub HowToPage:
  TextPage
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "IT IS PIP'S FRIEND'S"
  print at 2,4, "BIRTHDAY, AND THE PARTY IS"
  print at 2,5, "AT SUNDOWN, FOUR LEGS AWAY."
  print at 2,7, "BUTTON: THE PEDAL."
  print at 2,8, "STICK LEFT AND RIGHT: STEER."
  print at 2,9, "STICK DOWN: BRAKE."
  print at 2,10, "TAP DOWN IN A TURN: DRIFT!"
  print at 2,11, "PICK UP THE GIFTS AND THE"
  print at 2,12, "FLOWERS ON THE ROAD. MISS"
  print at 2,13, "THE STUMPS (THEY SPIN YOU)"
  print at 2,14, "AND THE PUDDLES (THEY SLOW"
  print at 2,15, "YOU DOWN). THE GRASS IS"
  print at 2,16, "SLOW, AND THE BENDS PUSH"
  print at 2,17, "THE CAR OUTWARDS."
  print at 2,19, "WATCH THE SUN: IT IS"
  print at 2,20, "YOUR CLOCK."
  ShowScreen
  WaitPress
  return
end sub

sub CreditsPage:
  TextPage
  print at 9,2, "SUNDOWN ROAD"
  print at 2,4, "AN ORIGINAL GAME FOR THE"
  print at 2,5, "COLECOVISION."
  print at 2,7, "DESIGN, PROGRAM, GRAPHICS,"
  print at 2,8, "SOUNDS AND THE TUNE"
  print at 2,9, "EVENING DRIVE:"
  print at 2,10, "CLAUDE (AN AI BY ANTHROPIC)"
  print at 2,13, "MADE WITH AMY STUDIO"
  print at 2,14, "BY AMY BIENVENU"
  print at 2,17, "(C) 2026"
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub Arrive:
  TextPage
  print at 4,3, "PIP MADE IT IN TIME!"
  print at 5,5, "HAPPY BIRTHDAY, ROSIE!"
  print at 4,9, "GIFTS"
  print at 15,9, digits$(Gifts, 2)
  W16 = Gifts * 100
  Score = W16
  print at 20,9, digits$(W16, 5)
  print at 4,10, "FLOWERS"
  print at 15,10, digits$(Flowers, 2)
  W16 = Flowers * 50
  Score = Score + W16
  print at 20,10, digits$(W16, 5)
  print at 4,11, "DAYLIGHT LEFT"
  W16 = 12600 - SunT
  W16 = W16 / 6
  Score = Score + W16
  print at 20,11, digits$(W16, 5)
  print at 4,13, "SCORE"
  print at 20,13, digits$(Score, 5)
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  ' the birthday song (both voices)
  play sound 13
  play sound 14
  Hold(60)
  WaitPress
  mute all
  return
end sub

sub LatePage:
  TextPage
  print at 4,4, "THE PARTY STARTED"
  print at 4,5, "WITHOUT PIP..."
  print at 4,8, "BUT PIP BROUGHT"
  print at 4,10, digits$(Gifts, 2)
  print at 7,10, "GIFTS AND"
  print at 4,11, digits$(Flowers, 2)
  print at 7,11, "FLOWERS."
  print at 4,14, "NEXT TIME, LEAVE EARLIER!"
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  Hold(60)
  WaitPress
  return
end sub

sub TextPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  asm {
    call SrTextMode
  }
  fill mode 2 text color with $10
  backdrop white
  cls
  return
end sub

' ---------------------------------------------------------------------------
' the machine

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Hold(u8 Frames):
  for J = 1 to Frames
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub WaitStick:
  WasBtn = 1
  WasStick = 1
  return
end sub

sub WaitPress:
  WaitStick
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  play sound SndTick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 20
  sprites flicker off
  for J = 0 to 19
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

