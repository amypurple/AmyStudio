asm {
; SUNDOWN ROAD: the road in perspective.
;
; SrRoad draws screen rows 8-23 (16 bands of 8 scanlines) into the hidden
; name page (VDP_NAME_SHADOW) with the hidden set of tile codes: set 0 =
; codes 128-191, set 1 = 192-255, in the middle and bottom thirds of the
; pattern table. While the VDP shows one page and set, the other is drawn;
; SrFlip then shows it (call it just after the wait, in the vertical blank).
;
; A band has 8 codes: +0 grass (pattern $FF, made once by SrSetup), +1
; road ($00), +2.. the tiles where an edge of the road crosses, made here
; scanline by scanline. All of a band's tiles share its 8 colour bytes, so
; the light and dark grass stripes run line by line.
;
; The road's centre is worked out from the bottom line up. With yy = the
; line - 63 (128 at the bottom, 1 at the horizon):
;   centre = 128 - RdP at the bottom; each line up, centre += slope;
;   slope starts at RdP * 2 / 256 pixel and grows by RdCurve / 65536,
; so the road meets the horizon in the middle when straight and bends by
; about RdCurve / 8 pixels at the horizon. Half widths come from SrHw,
; stripes from SrZs (a line's distance) and RdPosQ (the car's distance).
; RdCx keeps each line's centre (0-255), by yy, for the things beside it.
;
; RdB holds one band: 0-7 the left edges, 8-15 the right edges, 16-23 the
; colours, by row (0 = the band's top line).

SrRoad:
    push ix
    push iy
    ; the two stripes' colour bytes
    ld a,(AMY_UVAR_RdRd)
    ld b,a
    ld a,(AMY_UVAR_RdGr1)
    or b
    ld (AMY_UVAR_RdColA),a
    ld a,(AMY_UVAR_RdGr2)
    or b
    ld (AMY_UVAR_RdColB),a
    ; the curve (1/65536 pixel) as 24 bits in C:H:L: times 8 (RdK8, added
    ; to the slope for 8 lines) and times 28, / 256 (RdK28, the centre's
    ; extra move over 8 lines from the slope growing line by line)
    ld hl,(AMY_UVAR_RdCurve)
    ld a,h
    rla
    sbc a,a
    ld c,a
    add hl,hl
    rl c
    add hl,hl
    rl c                    ; x 4
    push hl
    push bc
    add hl,hl
    rl c                    ; x 8
    ld (AMY_UVAR_RdK8),hl
    ld a,c
    ld (AMY_UVAR_RdK8h),a
    add hl,hl
    rl c
    add hl,hl
    rl c                    ; x 32
    pop de                  ; e = x4 high byte
    ex de,hl                ; de = x32 low, hl = x4 high in l
    ld a,l
    pop hl                  ; hl = x4 low
    ld b,a                  ; b = x4 high
    ex de,hl                ; hl = x32 low, de = x4 low
    or a
    sbc hl,de
    ld a,c
    sbc a,b                 ; a:h:l = x 28
    ld l,h
    ld h,a
    ld (AMY_UVAR_RdK28),hl  ; / 256
    ; the start, one line below the bottom: centre = 128 - P, slope = P / 128
    ld hl,128
    ld de,(AMY_UVAR_RdP)
    or a
    sbc hl,de
    ld (AMY_UVAR_RdC),hl
    xor a
    ld (AMY_UVAR_RdCf),a
    ld (AMY_UVAR_RdSl),a
    ld hl,(AMY_UVAR_RdP)
    add hl,hl
    ld a,l
    ld (AMY_UVAR_RdSm),a
    ld a,h
    ld (AMY_UVAR_RdSh),a
    ld a,129
    call SrPoint
    ld a,l
    ld (AMY_UVAR_RdPL),a
    ld a,h
    ld (AMY_UVAR_RdPR),a
    ld a,e
    ld (AMY_UVAR_RdPC),a
    ld (AMY_UVAR_RdCx + 16),a
    ld a,15
    ld (AMY_UVAR_RdBand),a
SrBand:
    ; --- 8 lines up: centre += 8 x slope + 28 x curve; slope += 8 x curve
    ld a,(AMY_UVAR_RdSl)
    ld e,a
    ld a,(AMY_UVAR_RdSm)
    ld l,a
    ld a,(AMY_UVAR_RdSh)
    ld h,a
    sla e
    rl l
    rl h
    sla e
    rl l
    rl h
    sla e
    rl l
    rl h                    ; h.l = 8 x slope (whole.fraction)
    ld a,h
    rla
    sbc a,a
    ld d,a
    ld e,h
    ld a,(AMY_UVAR_RdCf)
    add a,l
    ld (AMY_UVAR_RdCf),a
    ld hl,(AMY_UVAR_RdC)
    adc hl,de
    ex de,hl                ; de = centre
    ld hl,(AMY_UVAR_RdK28)
    ld a,h
    rla
    sbc a,a
    ld b,a
    ld a,(AMY_UVAR_RdCf)
    add a,l
    ld (AMY_UVAR_RdCf),a
    ld a,e
    adc a,h
    ld e,a
    ld a,d
    adc a,b
    ld d,a
    ld (AMY_UVAR_RdC),de
    ld hl,(AMY_UVAR_RdK8)
    ld a,(AMY_UVAR_RdSl)
    add a,l
    ld (AMY_UVAR_RdSl),a
    ld a,(AMY_UVAR_RdSm)
    adc a,h
    ld (AMY_UVAR_RdSm),a
    ld a,(AMY_UVAR_RdK8h)
    ld b,a
    ld a,(AMY_UVAR_RdSh)
    adc a,b
    ld (AMY_UVAR_RdSh),a
    ; --- the band's top line: yy = band * 8 + 1
    ld a,(AMY_UVAR_RdBand)
    add a,a
    add a,a
    add a,a
    inc a
    ld (AMY_UVAR_RdY),a
    call SrPoint            ; l = left, h = right, e = centre
    push de
    push hl
    ; the 8 lines between this top line and the one below the band
    ld b,l
    ld a,(AMY_UVAR_RdPL)
    ld c,a
    ld a,b
    ld (AMY_UVAR_RdPL),a
    ld hl,AMY_UVAR_RdB
    call SrBis
    pop hl
    ld b,h
    ld a,(AMY_UVAR_RdPR)
    ld c,a
    ld a,b
    ld (AMY_UVAR_RdPR),a
    ld hl,AMY_UVAR_RdB + 8
    call SrBis
    pop de
    ; the centre at the band's top line (RdCx by band; 16 = below the road)
    ld a,(AMY_UVAR_RdBand)
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_RdCx
    add hl,bc
    ld (hl),e
    ; the stripes: line by line in the 4 nearest bands, band by band in
    ; the 4 before them, none in the far half (a band all of one colour
    ; needs no new colours while it stays so: much less to write)
    ld a,(AMY_UVAR_RdY)
    ld l,a
    ld h,SrZs / 256
    ld de,AMY_UVAR_RdB + 16
    ld a,(AMY_UVAR_RdPosQ)
    ld c,a
    ld a,(AMY_UVAR_RdBand)
    cp 12
    jr nc,SrStripeNear
    ld b,a
    ld a,(AMY_UVAR_RdColA)
    bit 3,b
    jr z,SrStFar            ; the far half: no stripes, one colour
    inc l
    inc l
    inc l
    inc l
    ld a,(hl)
    add a,c
    and $20
    ld a,(AMY_UVAR_RdColA)
    jr z,SrStFar
    ld a,(AMY_UVAR_RdColB)
SrStFar:
    ld b,8
SrStFar2:
    ld (de),a
    inc de
    djnz SrStFar2
    jr SrStripeDone
SrStripeNear:
    ld b,8
SrStripe:
    ld a,(hl)
    add a,c
    and $20
    ld a,(AMY_UVAR_RdColA)
    jr z,SrSt
    ld a,(AMY_UVAR_RdColB)
SrSt:
    ld (de),a
    inc de
    inc l
    djnz SrStripe
SrStripeDone:
    call SrOut
    ld hl,AMY_UVAR_RdBand
    ld a,(hl)
    dec (hl)
    or a
    jp nz,SrBand
    pop iy
    pop ix
    ret

; SrPoint: the line yy = A at the present centre: L (left edge), H (right
; edge), E (centre), each clamped to 0..255
SrPoint:
    ld l,a
    ld h,SrHw / 256
    ld c,(hl)
    ld b,0                  ; bc = half width
    ld hl,(AMY_UVAR_RdC)
    call SrClamp
    ld e,a
    push hl
    or a
    sbc hl,bc
    call SrClamp
    ld d,a
    pop hl
    add hl,bc
    call SrClamp
    ld h,a
    ld l,d
    ret

; SrClamp: HL (signed) to A in 0..255 (HL kept)
SrClamp:
    ld a,h
    or a
    ld a,l
    ret z
    bit 7,h
    ld a,0
    ret nz
    ld a,255
    ret

; SrBis: the 8 values from B (row 0) towards C (row 8) at HL, by halving
SrBis:
    ld (hl),b
    ld a,b
    add a,c
    rra
    ld d,a                  ; row 4
    ld a,b
    add a,d
    rra
    ld e,a                  ; row 2
    inc hl
    ld a,b
    add a,e
    rra
    ld (hl),a               ; row 1
    inc hl
    ld (hl),e
    inc hl
    ld a,e
    add a,d
    rra
    ld (hl),a               ; row 3
    inc hl
    ld (hl),d
    ld a,d
    add a,c
    rra
    ld e,a                  ; row 6
    inc hl
    ld a,d
    add a,e
    rra
    ld (hl),a               ; row 5
    inc hl
    ld (hl),e
    inc hl
    ld a,e
    add a,c
    rra
    ld (hl),a               ; row 7
    ret

; SrOut: band RdBand to VRAM
SrOut:
    ; the columns of the left edge (lo1..hi1) and the right edge (lo2..hi2)
    ld hl,AMY_UVAR_RdB
    call SrMinMax
    ld (AMY_UVAR_RdLo1),a
    ld a,e
    ld (AMY_UVAR_RdHi1),a
    ld hl,AMY_UVAR_RdB + 8
    call SrMinMax
    ld (AMY_UVAR_RdLo2),a
    ld a,e
    ld (AMY_UVAR_RdHi2),a
    ; at most 6 edge columns in all (4 in the far half): while there are
    ; more, the side with more gives up its column furthest from the road
    ld a,(AMY_UVAR_RdBand)
    and 8
    rrca
    rrca
    add a,4
    ld (AMY_UVAR_RdCap),a   ; 4 or 6
SrCapLoop:
    ld a,(AMY_UVAR_RdLo1)
    ld b,a
    ld a,(AMY_UVAR_RdHi1)
    sub b
    inc a
    ld d,a                  ; d = left columns
    ld a,(AMY_UVAR_RdLo2)
    ld b,a
    ld a,(AMY_UVAR_RdHi2)
    sub b
    inc a
    ld e,a                  ; e = right columns
    add a,d
    ld hl,AMY_UVAR_RdCap
    cp (hl)
    jr c,SrCap2
    jr z,SrCap2
    ld a,d
    cp e
    jr c,SrCapR
    ld hl,AMY_UVAR_RdLo1
    inc (hl)
    jr SrCapLoop
SrCapR:
    ld hl,AMY_UVAR_RdHi2
    dec (hl)
    jr SrCapLoop
SrCap2:
    ; touching or overlapping: one range lo1..hi2 (6 columns at most)
    xor a
    ld (AMY_UVAR_RdOne),a
    ld a,(AMY_UVAR_RdHi1)
    inc a
    ld b,a
    ld a,(AMY_UVAR_RdLo2)
    cp b
    jr z,SrMerge
    jr nc,SrRanges
SrMerge:
    ld a,(AMY_UVAR_RdLo1)
    ld b,a
    ld a,(AMY_UVAR_RdHi2)
    sub b
    cp 6
    jr c,SrMerge2
    ld a,b
    add a,5
    ld (AMY_UVAR_RdHi2),a
SrMerge2:
    ld a,(AMY_UVAR_RdHi2)
    ld (AMY_UVAR_RdHi1),a
    ld a,1
    ld (AMY_UVAR_RdOne),a
SrRanges:
    ; the band's first code: 128 + set * 64 + (band & 7) * 8
    ld a,(AMY_UVAR_RdBand)
    and 7
    add a,a
    add a,a
    add a,a
    ld b,a
    ld a,(AMY_UVAR_RdSet)
    rrca
    rrca
    and $40
    or $80
    or b
    ld (AMY_UVAR_RdBase),a
    ; its third: $08 (rows 8-15) or $10 (rows 16-23), the high byte
    ld a,(AMY_UVAR_RdBand)
    and 8
    add a,8
    ld (AMY_UVAR_RdThird),a
    ; how many edge tiles
    ld a,(AMY_UVAR_RdLo1)
    ld b,a
    ld a,(AMY_UVAR_RdHi1)
    sub b
    inc a
    ld c,a
    ld a,(AMY_UVAR_RdOne)
    or a
    jr nz,SrCount
    ld a,(AMY_UVAR_RdLo2)
    ld b,a
    ld a,(AMY_UVAR_RdHi2)
    sub b
    inc a
    add a,c
    ld c,a
SrCount:
    ld a,c
    ld (AMY_UVAR_RdN),a
    ; this band and set's slot (0-31) in the memories of what was written
    ld a,(AMY_UVAR_RdSet)
    rrca
    rrca
    rrca
    rrca
    and $10
    ld b,a
    ld a,(AMY_UVAR_RdBand)
    or b
    ld (AMY_UVAR_RdIdx),a
    ; the same columns as last time in this slot: the names are there
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld de,AMY_UVAR_RdLR
    add hl,de
    ld de,AMY_UVAR_RdLo1
    ld b,4
    ld c,0
SrSame:
    ld a,(de)
    cp (hl)
    jr z,SrSame2
    ld (hl),a
    ld c,1
SrSame2:
    inc hl
    inc de
    djnz SrSame
    ld a,c
    or a
    jp z,SrColours
    ; --- the name row (screen row 8 + band) in the hidden page
    ld a,(AMY_UVAR_RdBand)
    add a,8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ; grass up to lo1
    ld a,(AMY_UVAR_RdLo1)
    ld b,a
    ld a,(AMY_UVAR_RdBase)
    ld c,a
    call SrRun
    ; the left (or only) edge tiles
    ld a,(AMY_UVAR_RdLo1)
    ld b,a
    ld a,(AMY_UVAR_RdHi1)
    sub b
    inc a
    ld b,a
    ld a,c
    add a,2
    call SrRunUp            ; a = the next free code after
    ld (AMY_UVAR_RdNext),a
    ld a,(AMY_UVAR_RdOne)
    or a
    jr nz,SrNameEnd
    ; road between the edges
    ld a,(AMY_UVAR_RdHi1)
    ld b,a
    ld a,(AMY_UVAR_RdLo2)
    sub b
    dec a
    ld b,a
    ld a,c
    inc a
    call SrRun
    ; the right edge tiles
    ld a,(AMY_UVAR_RdLo2)
    ld b,a
    ld a,(AMY_UVAR_RdHi2)
    sub b
    inc a
    ld b,a
    ld a,(AMY_UVAR_RdNext)
    call SrRunUp
    ld a,(AMY_UVAR_RdHi2)
    jr SrNameRest
SrNameEnd:
    ld a,(AMY_UVAR_RdHi1)
SrNameRest:
    ; grass to column 31
    ld b,a
    ld a,31
    sub b
    ld b,a
    ld a,c
    call SrRun
SrColours:
    ; --- the colours of grass, road and the edge tiles: 8 bytes each
    ; (all 8 the same, the same as last time in this slot, and no more
    ; edge tiles than then: they are there already)
    ld hl,AMY_UVAR_RdB + 16
    ld a,(hl)
    ld b,7
SrUni:
    inc hl
    cp (hl)
    jr nz,SrMixed
    djnz SrUni
    jr SrUni2
SrMixed:
    xor a                   ; 0 = mixed
SrUni2:
    ld c,a
    ld a,(AMY_UVAR_RdIdx)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_RdLC
    add hl,de
    ld a,c
    or a
    jr z,SrColNew
    cp (hl)
    jr nz,SrColNew
    ld hl,AMY_UVAR_RdLN
    add hl,de
    ld a,(AMY_UVAR_RdN)
    cp (hl)
    jr z,SrPatterns
    jr c,SrPatterns
    ld (hl),a
    jr SrColWrite
SrColNew:
    ld (hl),c
    ld hl,AMY_UVAR_RdLN
    add hl,de
    ld a,(AMY_UVAR_RdN)
    ld (hl),a
SrColWrite:
    ld a,(AMY_UVAR_RdBase)
    call SrAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_RdN)
    add a,2
    ld c,a
SrCol1:
    ld hl,AMY_UVAR_RdB + 16
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    ld a,(hl)
    out ($BE),a
    dec c
    jr nz,SrCol1
SrPatterns:
    ; --- the edge tiles' patterns, in the order of their codes
    ld a,(AMY_UVAR_RdBase)
    add a,2
    call SrAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_RdOne)
    or a
    jr nz,SrPatBoth
    ; left edge tiles: only the left edge matters there
    ld a,(AMY_UVAR_RdLo1)
    ld (AMY_UVAR_RdCol),a
SrPatL:
    ld a,(AMY_UVAR_RdCol)
    add a,a
    add a,a
    add a,a
    ld c,a
    ld hl,AMY_UVAR_RdB
    ld d,SrTL / 256
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    ld hl,AMY_UVAR_RdCol
    ld a,(hl)
    inc (hl)
    ld hl,AMY_UVAR_RdHi1
    cp (hl)
    jr nz,SrPatL
    ; right edge tiles
    ld a,(AMY_UVAR_RdLo2)
    ld (AMY_UVAR_RdCol),a
SrPatR:
    ld a,(AMY_UVAR_RdCol)
    add a,a
    add a,a
    add a,a
    ld c,a
    ld hl,AMY_UVAR_RdB + 8
    ld d,SrTR / 256
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    inc hl
    ld a,(hl)
    sub c
    ld e,a
    ld a,(de)
    out ($BE),a
    ld hl,AMY_UVAR_RdCol
    ld a,(hl)
    inc (hl)
    ld hl,AMY_UVAR_RdHi2
    cp (hl)
    jr nz,SrPatR
    ret
SrPatBoth:
    ; one range with both edges in it (near the horizon)
    ld a,(AMY_UVAR_RdLo1)
    ld (AMY_UVAR_RdCol),a
SrPatB:
    ld a,(AMY_UVAR_RdCol)
    add a,a
    add a,a
    add a,a
    ld c,a
    ld hl,AMY_UVAR_RdB
    ld b,8
SrPatB2:
    ld a,(hl)
    sub c
    ld e,a
    ld d,SrTL / 256
    ld a,(de)
    push hl
    ld de,8
    add hl,de
    ld e,a
    ld a,(hl)
    sub c
    ld l,a
    ld h,SrTR / 256
    ld a,(hl)
    or e
    pop hl
    out ($BE),a
    inc hl
    djnz SrPatB2
    ld hl,AMY_UVAR_RdCol
    ld a,(hl)
    inc (hl)
    ld hl,AMY_UVAR_RdHi1
    cp (hl)
    jr nz,SrPatB
    ret

; SrRun: B names of code A (B may be 0); SrRunUp: B names A, A+1, ...
; (each write at least 29 cycles after the last, for the active display)
SrRun:
    inc b
    dec b
    ret z
SrRun1:
    out ($BE),a
    nop
    nop
    djnz SrRun1
    ret
SrRunUp:
    inc b
    dec b
    ret z
SrRunUp1:
    out ($BE),a
    inc a
    nop
    djnz SrRunUp1
    ret

; SrAddr: HL = the pattern-table offset of code A in third RdThird
SrAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_RdThird)
    add a,h
    ld h,a
    ret

; SrMinMax: the columns (/ 8) of the smallest (a) and largest (e) edge
; of the 8 lines at HL
SrMinMax:
    ; (an edge runs one way across a band: its top and bottom lines are
    ; its two ends)
    ld d,(hl)
    ld bc,7
    add hl,bc
    ld e,(hl)
    ld a,d
    cp e
    jr c,SrMM1
    ld d,e
    ld e,a
SrMM1:
    ld a,e
    rrca
    rrca
    rrca
    and 31
    ld e,a
    ld a,d
    rrca
    rrca
    rrca
    and 31
    ret

; SrFlip: show the page and set just drawn; draw the other next
SrFlip:
    ld hl,(VDP_NAME_SHADOW)
    ld a,h
    rrca
    rrca
    and 15
    out ($BF),a
    ld a,$82
    out ($BF),a
    ld a,h
    xor $04                 ; $18 <-> $1C
    ld h,a
    ld (VDP_NAME_SHADOW),hl
    ld a,(AMY_UVAR_RdSet)
    xor 1
    ld (AMY_UVAR_RdSet),a
    ret

; SrSetup: the grass ($FF) and road ($00) patterns of every band slot in
; both sets, in both thirds (with the display off)
SrSetup:
    ; a colour table for each third (register 3 = $FF): the road's colours
    ; live in the middle and bottom thirds
    ld a,$FF
    out ($BF),a
    ld a,$83
    out ($BF),a
    ld c,$08
    call SrSetup1
    ld c,$10
SrSetup1:
    ld b,16
    ld de,$0400             ; code 128 * 8
SrSetup2:
    ld a,e
    out ($BF),a
    ld a,d
    add a,c
    or $40
    out ($BF),a
    push bc
    ld b,8
    ld a,$FF
SrSetup3:
    out ($BE),a
    nop
    nop
    djnz SrSetup3
    ld b,8
    xor a
SrSetup4:
    out ($BE),a
    nop
    nop
    djnz SrSetup4
    pop bc
    ld hl,64
    add hl,de
    ex de,hl
    djnz SrSetup2
    ret

; the grass pixels of a tile (as pattern bits) by (edge - tile x) & 255:
; left of the left edge (SrTL) and right of the right edge (SrTR)
    align 256
SrTL:
    db $00,$80,$C0,$E0,$F0,$F8,$FC,$FE
    ds 120,$FF
    ds 128,$00
SrTR:
    db $FF,$7F,$3F,$1F,$0F,$07,$03,$01
    ds 120,$00
    ds 128,$FF
; SUNDOWN ROAD: the things along the road, the far hills, the screen modes.

; SrObj: thing number ObI of the course (CourseObj, 4 bytes each) into
; ObZ (its distance from the start of the leg), ObK (kind), ObL (across)
SrObj:
    ld hl,(AMY_UVAR_ObI)
    add hl,hl
    add hl,hl
    ld de,CourseObj
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld (AMY_UVAR_ObZ),de
    ld a,(hl)
    ld (AMY_UVAR_ObK),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_ObL),a
    ret

; SrProj: where the thing ObZ / ObL stands on the screen, for the road
; drawn last (RdCx): ObV = 1 if it is seen, ObY (its ground line, the
; screen line), ObX (its middle), ObS (size 0-3, 4 = tall), ObD (ObZ - Pos)
SrProj:
    xor a
    ld (AMY_UVAR_ObV),a
    ld hl,(AMY_UVAR_ObZ)
    ld de,(AMY_UVAR_Pos)
    or a
    sbc hl,de
    ld (AMY_UVAR_ObD),hl
    ret c                   ; behind
    ld a,h
    cp $10
    ret nc                  ; 4096 or more ahead
    ; yy = SrYt[dz / 16]
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl               ; h = dz / 16
    ld e,h
    ld d,0
    ld hl,SrYt
    add hl,de
    ld a,(hl)
    or a
    ret z                   ; beyond the horizon
    ld (AMY_UVAR_ObYY),a
    ld e,a
    add a,63
    ld (AMY_UVAR_ObY),a
    ld hl,SrSz
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_ObS),a
    ; x = centre(yy) + lat * halfwidth(yy) / 16; the centre between the
    ; tops of this band (k = (yy - 1) / 8) and the next: top + (next -
    ; top) * r / 8, r = (yy - 1) & 7
    push de
    ld a,e
    dec a
    ld b,a
    and 7
    ld (AMY_UVAR_ObR),a
    ld a,b
    rrca
    rrca
    rrca
    and 15
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_RdCx
    add hl,de
    ld b,(hl)               ; b = top
    inc hl
    ld a,(hl)               ; a = next band's top
    sub b                   ; signed difference
    ld e,a
    ld a,(AMY_UVAR_ObR)
    ld c,a
    ld hl,0
    ld a,e
    rlca
    sbc a,a
    ld d,a                  ; de = difference, signed
    inc c
SrProjC:
    dec c
    jr z,SrProjC2
    add hl,de
    jr SrProjC
SrProjC2:
    sra h
    rr l
    sra h
    rr l
    sra h
    rr l
    ld a,l
    add a,b
    ld (AMY_UVAR_ObX),a
    pop de
    ld h,SrHw / 256
    ld l,e
    ld e,(hl)               ; e = half width
    ld a,(AMY_UVAR_ObL)
    ld c,a                  ; c = lat (signed)
    bit 7,a
    jr z,SrProjP
    neg
SrProjP:
    ; hl = |lat| * hw
    ld hl,0
    ld d,0
    ld b,8
SrProjM:
    add hl,hl
    rla
    jr nc,SrProjM2
    add hl,de
SrProjM2:
    djnz SrProjM
    ; / 16
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl               ; h = |lat| * hw / 16 (hl * 16 / 256)
    ld a,h
    ld d,0
    ld e,a
    ld a,(AMY_UVAR_ObX)
    ld l,a
    ld h,0
    bit 7,c
    jr nz,SrProjNeg
    add hl,de
    jr SrProjX
SrProjNeg:
    or a
    sbc hl,de
SrProjX:
    ; keep it on the screen (8..247 for its middle)
    ld a,h
    or a
    ret nz
    ld a,l
    cp 8
    ret c
    cp 248
    ret nc
    ld (AMY_UVAR_ObX),a
    ld a,1
    ld (AMY_UVAR_ObV),a
    ret

; SrHills: rows 6 (far hills) and 7 (the tree line) of the hidden page,
; slid by BgX pixels (the hills by half as much: they are further away)
SrHills:
    ld hl,6 * 32
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ; hills: tile = THill00 + shift * 8 + ((column + coarse) & 7)
    ld a,(AMY_UVAR_BgX)
    srl a
    ld c,a
    and 7
    add a,a
    add a,a
    add a,a
    add a,AMY_UCONST_THill00
    ld d,a                  ; d = this shift's first tile
    ld a,c
    rrca
    rrca
    rrca
    and 7
    ld e,a                  ; e = coarse
    ld b,32
SrHill1:
    ld a,e
    and 7
    add a,d
    out ($BE),a
    inc e
    djnz SrHill1
    ; the tree line: TPine00 + shift * 4 + ((column + coarse) & 3)
    ld a,(AMY_UVAR_BgX)
    ld c,a
    and 7
    add a,a
    add a,a
    add a,AMY_UCONST_TPine00
    ld d,a
    ld a,c
    rrca
    rrca
    rrca
    and 3
    ld e,a
    ld b,32
SrPine1:
    ld a,e
    and 3
    add a,d
    out ($BE),a
    inc e
    djnz SrPine1
    ret

; SrRoadMode: a colour table for each third, the grass and road patterns,
; page $1800 shown and $1C00 drawn (with the display off)
SrRoadMode:
    call SrSetup
    ld a,6
    out ($BF),a
    ld a,$82
    out ($BF),a
    ld hl,$1C00
    ld (VDP_NAME_SHADOW),hl
    xor a
    ld (AMY_UVAR_RdSet),a
    ; forget what the road wrote (the pages were just cleared)
    ld hl,AMY_UVAR_RdLR
    ld b,128
SrForget1:
    ld (hl),$FF
    inc hl
    djnz SrForget1
    ld hl,AMY_UVAR_RdLC
    ld b,32
SrForget2:
    ld (hl),0
    inc hl
    djnz SrForget2
    ret

; SrTextMode: back to Amy's usual screen (one colour table, page $1800)
SrTextMode:
    ld a,$9F
    out ($BF),a
    ld a,$83
    out ($BF),a
    ld a,6
    out ($BF),a
    ld a,$82
    out ($BF),a
    ld hl,$1800
    ld (VDP_NAME_SHADOW),hl
    ret

; SrEngine: the engine's hum on the sound chip's third tone voice: period
; EngP (10 bits), attenuation EngV (0 loud .. 15 silent)
SrEngine:
    ld hl,(AMY_UVAR_EngP)
    ld a,l
    and $0F
    or $C0
    out ($FF),a
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,h
    and $3F
    out ($FF),a
    ld a,(AMY_UVAR_EngV)
    and $0F
    or $D0
    out ($FF),a
    ret

; SrBend: how hard the bend pushes the car outwards this loop, and how
; far the far hills slide: M = RdCurve * Spd (signed, 24 bits);
; Push = M * 3 / 65536 (pixels), BgD = M / 32768
SrBend:
    ld hl,(AMY_UVAR_RdCurve)
    ld a,h
    ld (AMY_UVAR_BnSg),a
    bit 7,h
    jr z,SrBend1
    xor a
    sub l
    ld l,a
    sbc a,a
    sub h
    ld h,a                  ; hl = |curve|
SrBend1:
    ex de,hl                ; de = |curve|
    ld a,(AMY_UVAR_Spd)
    ld hl,0
    ld c,0                  ; c:h:l = the product
    ld b,8
SrBend2:
    add hl,hl
    rl c
    add a,a
    jr nc,SrBend3
    add hl,de
    jr nc,SrBend3
    inc c
SrBend3:
    djnz SrBend2
    ; BgD = product >> 15 = (c:h) >> 7
    ld a,h
    rla
    ld a,c
    rla
    ld (AMY_UVAR_BgD),a
    ; Push = product * 3 >> 16: c:h:l * 3
    push hl
    ld b,c
    add hl,hl
    rl c
    pop de
    add hl,de
    ld a,c
    adc a,b
    ld (AMY_UVAR_Push),a
    ; the signs back (negative curve: negative results)
    ld a,(AMY_UVAR_BnSg)
    bit 7,a
    ret z
    ld a,(AMY_UVAR_BgD)
    neg
    ld (AMY_UVAR_BgD),a
    ld a,(AMY_UVAR_Push)
    neg
    ld (AMY_UVAR_Push),a
    ret

; SrThings: the things ahead of the car, nearest first (from First), as
; up to 9 sprites in SeeY / SeeX / SeeP / SeeC (SeeN of them; 2 more
; places are kept for the traffic); a tall
; tree takes two (its crown above its trunk)
SrThings:
    xor a
    ld (AMY_UVAR_SeeN),a
    ld hl,(AMY_UVAR_First)
    ld (AMY_UVAR_ObI),hl
SrTh1:
    call SrObj
    ld hl,(AMY_UVAR_ObZ)
    ld a,h
    and l
    inc a
    ret z                   ; the end of the leg's things
    call SrProj
    ld hl,(AMY_UVAR_ObD)
    ld de,3200
    or a
    sbc hl,de
    ret nc                  ; too far to matter
    ld a,(AMY_UVAR_ObV)
    or a
    jr z,SrThNext
    ld a,(AMY_UVAR_ObK)
    ld c,a                  ; c = kind
    ld e,a
    ld d,0
    ld hl,SrKindCol
    cp 2
    jr nc,SrThCol
    ld hl,AMY_UVAR_TreeC    ; the trees: their colour for the time of day
SrThCol:
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_ObCol),a
    ld a,(AMY_UVAR_ObS)
    ld b,a                  ; b = size
    cp 4
    jr c,SrThOne
    ld a,c
    cp 2
    jr nc,SrThBig
    ; a tall tree: crown and trunk, if there is room for both
    ld a,(AMY_UVAR_SeeN)
    cp 8
    jr nc,SrThNext
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,AMY_UCONST_SPineT
    ld (AMY_UVAR_ObPat),a
    ld a,(AMY_UVAR_ObY)
    sub 32
    call SrSee
    ld a,(AMY_UVAR_ObPat)
    add a,4
    ld (AMY_UVAR_ObPat),a
    ld a,(AMY_UVAR_ObY)
    sub 16
    call SrSee
    jr SrThNext
SrThBig:
    ld b,3
SrThOne:
    ; pattern = SPine0 + kind * 16 + size * 4
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,a
    ld e,a
    ld a,b
    add a,a
    add a,a
    add a,e
    add a,AMY_UCONST_SPine0
    ld (AMY_UVAR_ObPat),a
    ld a,(AMY_UVAR_ObY)
    sub 16
    call SrSee
SrThNext:
    ld hl,(AMY_UVAR_ObI)
    inc hl
    ld (AMY_UVAR_ObI),hl
    ld a,(AMY_UVAR_SeeN)
    cp 9
    jr c,SrTh1
    ret

; SrSee: one more sprite: line A, column ObX - 8, pattern ObPat, ObCol
SrSee:
    ld b,a
    ld a,(AMY_UVAR_SeeN)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_SeeY
    add hl,de
    ld (hl),b
    ld hl,AMY_UVAR_SeeX
    add hl,de
    ld a,(AMY_UVAR_ObX)
    sub 8
    ld (hl),a
    ld hl,AMY_UVAR_SeeP
    add hl,de
    ld a,(AMY_UVAR_ObPat)
    ld (hl),a
    ld hl,AMY_UVAR_SeeC
    add hl,de
    ld a,(AMY_UVAR_ObCol)
    ld (hl),a
    ld hl,AMY_UVAR_SeeN
    inc (hl)
    ret

; the things sprite colours: pine, oak, gift, flower, stump, puddle,
; tractor, cyclist
SrKindCol:
    db 1,10,13,9,6,5,4,1

; SrSqueal: the tyres' squeal on the sound chip's second tone voice: period
; SkP, attenuation SkV (15 = silent)
SrSqueal:
    ld hl,(AMY_UVAR_SkP)
    ld a,l
    and $0F
    or $A0
    out ($FF),a
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,h
    and $3F
    out ($FF),a
    ld a,(AMY_UVAR_SkV)
    and $0F
    or $B0
    out ($FF),a
    ret

; SrSunMask: the sun's pattern with the hills cut out of it, made each
; loop into sprite pattern 248 (the 63rd 16 x 16 one): where the sun's
; line lies on row 6 (the far
; hills, lines 48-55), the hills' tile pixels there (the tile under each
; half of the sun: columns 25 and 26, slid by BgX as SrHills draws them)
; clear the sun's; from line 56 down (the tree line and the road) none of
; it shows. SunY = the sun sprite's line.
SrSunMask:
    ld hl,$3800 + 248 * 8
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ; the two hill tiles: THill00 + shift * 8 + ((column + coarse) & 7)
    ld a,(AMY_UVAR_BgX)
    srl a
    ld c,a
    and 7
    add a,a
    add a,a
    add a,a
    ld b,a                  ; b = shift * 8
    ld a,c
    rrca
    rrca
    rrca
    and 7
    ld c,a                  ; c = coarse
    ld a,25
    add a,c
    and 7
    add a,b
    ld (AMY_UVAR_SmT1),a    ; the left half's tile (from THill00)
    ld a,26
    add a,c
    and 7
    add a,b
    ld (AMY_UVAR_SmT2),a
    ; the left column (pattern bytes 0-15), then the right (16-31)
    ld a,(AMY_UVAR_SmT1)
    ld de,AMY_UDATA_SpritePat + AMY_UCONST_SSun * 8
    call SrSunCol
    ld a,(AMY_UVAR_SmT2)
    ld de,AMY_UDATA_SpritePat + AMY_UCONST_SSun * 8 + 16
    ; fall through
; SrSunCol: 16 lines of the sun from DE, masked by hill tile A
SrSunCol:
    ; hl = that tile's pattern: TilePat + (THill00 - 128 + A) * 8
    add a,AMY_UCONST_THill00 - 128
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld bc,AMY_UDATA_TilePat
    add hl,bc
    ld a,(AMY_UVAR_SunY)
    inc a                   ; a sprite shows a line below its Y
    ld c,a                  ; c = the screen line of the sun's top
    ld b,16
SrSun1:
    ld a,c
    cp 56
    jr nc,SrSunGone         ; the tree line and below: hidden
    cp 48
    jr c,SrSunSky           ; above the hills: all of it
    ; on the hills' row: line (a - 48) of the tile
    push hl
    sub 48
    add a,l
    ld l,a
    jr nc,SrSun2
    inc h
SrSun2:
    ld a,(hl)
    cpl
    ex de,hl
    and (hl)
    ex de,hl
    pop hl
    jr SrSunOut
SrSunGone:
    xor a
    jr SrSunOut
SrSunSky:
    ld a,(de)
SrSunOut:
    out ($BE),a
    inc de
    inc c
    djnz SrSun1
    ret
    align 256
SrHw:
    db 0,1,2,2,3,4,5,5,6,7,8,9,9,10,11,12
    db 12,13,14,15,16,16,17,18,19,20,20,21,22,23,23,24
