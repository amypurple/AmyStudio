u16 Rnd = 7
u8 SunY = 0
u8 SmT1 = 0
u8 SmT2 = 0
u8 Drift = 0
u16 SkP = 50
u8 SkV = 15
i16 Ya = 0
i16 Vx = 0
i16 PxS = 0
u8 DriftT = 0
i8 Push = 0
u8 BgD = 0
u8 BnSg = 0
u8 SunA = 0
u8 SunPx = 0
u8 SunPx5 = 0
