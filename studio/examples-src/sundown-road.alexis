data BendLen words 3252, 3307, 3496, 3229, 3022, 3564, 1546, 2390, 2194, 3343, 2501, 2963, 2934, 1406, 2905, 2261, 2217, 2780, 1648, 3042, 2460, 2590, 2002, 1690, 1522, 2000, 2474, 2451, 3159, 1880, 1952, 2601, 1219, 1837, 3559, 2592, 3311, 1884, 2692, 3514, 2527, 1686, 2780, 2522, 1096
data BendCurve words 0, 64836, 65036, 65036, 65036, 0, 0, 900, 64836, 0, 700, 0, 700, 64436, 0, 0, 0, 65036, 65036, 64436, 0, 64836, 64836, 64636, 64636, 0, 700, 64436, 900, 1100, 700, 0, 1100, 0, 900, 900, 1100, 0, 900, 0, 0, 0, 0, 0, 500
data LegLen words 26000, 28000, 28000, 30000
