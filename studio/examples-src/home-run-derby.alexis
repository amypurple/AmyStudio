  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 3 then
    HowTo
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers

' 16-bit xorshift: stepped every title frame, so each game is different
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

' ---------------------------------------------------------------------------
' the game

sub NewGame:
  BL = 0
  RE = 0
  Inn = 1
  TU = 0
  PI = 9
  Over = 0
  Lat = 0
  BallOn = 0
  BX = 0
  BY = 200
  BF = 0
  PF = 0
  Result = 0
  DrawPlay
  State = StPlay
  ' BASIC line 95: the HUD, then the fanfare (line 280)
  StartCharge
  return
end sub

sub StartCharge:
  play sound SndCharge1
  play sound SndCharge2
  Ph = PhCharge
  Pt = TCharge
  return
end sub

' who bats and who pitches this half inning
sub Sides:
  HumanBat = 1
  HumanPitch = 0
  if Players = 1 then
    if TU = 1 then HumanBat = 0
    if PitchCtl = 1 then
      if TU = 1 then HumanPitch = 1
    end if
  else
    if PitchCtl = 1 then HumanPitch = 1
  end if
  return
end sub

' the batter's button this frame (BLUE: controller 1, RED: controller 2 in
' 2 PLAYERS; either controller in 1 PLAYER)
sub BatButton:
  BatFire = 0
  if HumanBat = 0 then
    CpuBat
    return
  end if
  if Players = 1 then
    V = J1 | J2
  else
    V = J1
    if TU = 1 then V = J2
  end if
  BatFire = V & 16
  return
end sub

' the pitcher's stick: 1 PLAYER - either controller; 2 PLAYERS - the
' fielding side's controller
sub PitchPad:
  if Players = 1 then
    V = J1 | J2
  else
    V = J2
    if TU = 1 then V = J1
  end if
  return
end sub

' one frame of play
sub PlayStep:
  Busy = 0
  Sides
  if Ph = PhCharge then
    dec Pt
    if Pt = 0 then
      ' after the fanfare: colours by side, PI = 9, the HUD (line 195-215)
      SideColours
      PI = 9
      HudDirty = 1
      Ph = PhHud
      Pt = 19
    end if
    goto ps_draw
  end if
  if Ph = PhHud then
    dec Pt
    if Pt = 0 then NextPitch
    goto ps_draw
  end if
  if Ph = PhWaitP then
    ' line 120: waits for the pitcher's button; the stick picks the pitch
    PitchPad
    T = V & 16
    if T > 0 then
      K = V & 15
      if K > 10 then K = 0
      T = PitS[K]
      if T = 0 then T = 3
      YXf = T
      YXf = YXf << 8
      Spd = T
      T = PitJ[K]
      PitchCurve
      ClearMsg
      Ph = PhW1
      Pt = TW1
    end if
    goto ps_draw
  end if
  if Ph = PhW1 then
    dec Pt
    if Pt = 0 then
      PF = 1
      Ph = PhW2
      Pt = TW2
    end if
    goto ps_draw
  end if
  if Ph = PhW2 then
    dec Pt
    if Pt = 0 then
      PF = 2
      Ph = PhW3
      Pt = TW3
    end if
    goto ps_draw
  end if
  if Ph = PhW3 then
    dec Pt
    if Pt = 0 then
      ' line 140-145: the ball and its shadow at the pitcher, then SYS
      BX = 120
      BY = 200
      BallOn = 1
      Swung = 0
      Acc = 0
      Ph = PhPitch
      CpuPlan
    end if
    goto ps_draw
  end if
  if Ph = PhContWait then
    dec Pt
    if Pt = 0 then
      Ph = PhCont
      Acc = 0
    end if
    goto ps_draw
  end if
  if Ph = PhHitWait then
    dec Pt
    if Pt = 0 then StartFlight
    goto ps_draw
  end if
  if Ph = PhPost then
    dec Pt
    if Pt = 0 then AfterPitch
    goto ps_draw
  end if
  ' the machine-code phases: steps paid from the frame's cycles
  BatButton
  Acc += CycJiffy
  Done = 0
ps_steps:
  if Ph = PhFlight then
    Cost = CycFlight
  else
    if Ph = PhFall then
      Cost = CycFlight
    else
      Cost = PCost[Spd]
    end if
  end if
  if Acc < Cost then goto ps_latch
  Acc -= Cost
  if Ph = PhPitch then
    PitchStep
  else
    if Ph = PhCont then
      ContStep
    else
      if Ph = PhFlight then
        FlightStep
      else
        if Ph = PhFall then FallStep
      end if
    end if
  end if
  if Done = 0 then goto ps_steps
ps_latch:
ps_draw:
  Latch
  DrawFigures
  ' a frame that redraws the HUD or a figure skips the crowd (frame time)
  if HudDirty = 1 then
    ShowHud
    HudDirty = 0
    Busy = 1
  end if
  if Busy = 0 then Crowd
  DrawSprites
  return
end sub

' line 110: the computer's pitch, or the random part of a player's pitch
sub PitchRandom:
  ' XY = 1 + 30 RND, YX = 2 + 3 RND (8.8 fixed, RND = a random byte / 256);
  ' YY = XY when YX < 3
  Rand
  W16 = Rs >> 8
  W16 = W16 * 30
  XYf = W16 + 256
  W16 = Rs & 255
  W16 = W16 * 3
  YXf = W16 + 512
  YYf = 0
  if YXf < 768 then YYf = XYf
  return
end sub

' the curve: J < $40 rises, J >= $C0 sinks, else straight ($C028)
sub PitchCurve:
  CurveThr = 0
  CurveDir = 0
  if T < 64 then
    CurveThr = 8
    CurveDir = 255
  end if
  if T >= 192 then
    CurveThr = 8
    CurveDir = 1
  end if
  return
end sub

' after the HUD: the next pitch (BASIC lines 100-125)
sub NextPitch:
  BF = 0
  PF = 0
  PitchRandom
  if HumanPitch = 1 then
    Ph = PhWaitP
    return
  end if
  W16 = YXf >> 8
  Spd = W16
  Rand
  W16 = Rs & 255
  T = W16
  PitchCurve
  ClearMsg
  Ph = PhW1
  Pt = TW1
  return
end sub

' one step of $C04D: the swing, the curve, x - 1
sub PitchStep:
  if BatFire > 0 then
    BF = 1
    Swung = 1
    if BX >= 28 then
      if BX <= 46 then
        ' contact ($C1D3): the ball stops here; BASIC decides (line 170)
        Done = 1
        play sound SndRoar
        if BY >= 198 then
          if BY <= 202 then
            Ph = PhHitWait
            Pt = THit
            return
          end if
        end if
        Ph = PhContWait
        Pt = 3
        return
      end if
    end if
    ' too early or too late: the ball goes on ($C18B)
    Ph = PhCont
    ContStep
    return
  end if
  if CurveThr > 0 then
    Rand
    W16 = Rs & 255
    if W16 < 8 then BY += CurveDir
  end if
  dec BX
  if BX = 0 then EndPitch
  return
end sub

sub ContStep:
  dec BX
  if BX = 0 then EndPitch
  return
end sub

' the pitch is over without a hit (line 150-160)
sub EndPitch:
  Done = 1
  Result = 0
  if Swung = 0 then
    Result = 2
    if BY < 198 then Result = 1
    if BY > 202 then Result = 1
    if Result = 1 then inc PI
  end if
  ShowMsg
  Ph = PhPost
  Pt = TPost
  return
end sub

' the hit (line 175-180): power from the timing and the pitch speed
sub StartFlight:
  ' X = |37 - x|; power (8.8) = 19 - 2X - YX, at least 1
  if BX >= 37 then
    W16 = BX - 37
  else
    W16 = 37 - BX
  end if
  W16 = W16 << 9
  W16 += YXf
  if W16 >= 4608 then
    Pw = 256
  else
    Pw = 4864 - W16
  end if
  W16 = Pw >> 8
  FE = W16
  W16 = Pw + YYf
  W16 = W16 >> 8
  FB = W16
  ' $C1D3 / $C07A: counters 1, rising, doubling
  FD = 1
  FC = 1
  R50 = 1
  Rol = 1
  Cmp = 16
  Ydn = 0
  Fin = 0
  PF = 0
  Hit = 1
  Acc = 0
  Ph = PhFlight
  return
end sub

' one step of the flight ($C08F .. $C0FC, $C122)
sub FlightStep:
  if Fin = 0 then
    Again = 1
    while Again = 1
      Again = 0
      dec FB
      if FB = 0 then
        dec R50
        if R50 = 0 then
          if Rol = 1 then
            FD = FD << 1
          else
            FD = FD >> 1
          end if
          R50 = FD
          if FD = Cmp then
            if Ydn = 1 then
              Fin = 1
            else
              ' $C106: now falling, halving; back to $C08F in the same step
              R50 = 8
              FD = 8
              FB = 16
              Cmp = 0
              Rol = 0
              Ydn = 1
              Again = 1
            end if
          else
            FC = FD
          end if
        end if
        if Again = 0 then
          if Fin = 0 then FB = FE
        end if
      end if
    end while
    if Fin = 0 then
      dec FC
      if FC = 0 then
        FC = FD
        if Ydn = 1 then
          inc BY
        else
          dec BY
        end if
      end if
    end if
  end if
  if Fin = 1 then
    ' $C122: off the right side or on the ground ends it, else down 1
    if BX >= 496 then
      FlightEnd
      return
    end if
    if BY = 215 then
      FlightEnd
      return
    end if
    inc BY
  end if
  inc BX
  ' $C19F: past x 352 the flight is over
  if BX >= 352 then
    FlightEnd
    return
  end if
  ' $C0D1: the collision register, read (and cleared) once a step
  T = Lat
  Lat = 0
  if T = 4 then
    ' $C0D8: the wall - the ball drops back to the ground
    play sound SndThunk
    Ph = PhFall
    Done = 1
  end if
  return
end sub

' the fall from the wall ($C0DD): down 1, back 1, to the shadow's row
sub FallStep:
  inc BY
  dec BX
  if BY = 215 then FlightEnd
  return
end sub

sub FlightEnd:
  Done = 1
  ' line 200/210: past the wall = a home run
  if BX > 341 then
    if TU = 0 then
      if BL < 99 then inc BL
    else
      if RE < 99 then inc RE
    end if
  end if
  Result = 0
  HudDirty = 1
  Ph = PhPost
  Pt = TFlPost
  return
end sub

' line 215-225: the next pitch, or the other side's half inning
sub AfterPitch:
  if PI > 1 then
    dec PI
    HudDirty = 1
    Ph = PhHud
    Pt = THud
    return
  end if
  PI = 0
  TU = TU ^ 1
  if TU = 0 then
    inc Inn
    if Inn > 9 then
      if BL <> RE then
        HudDirty = 1
        Over = 1
        return
      end if
    end if
  end if
  HudDirty = 1
  BallOn = 0
  BX = 0
  StartCharge
  return
end sub

' the collision latch ($D01E): what the ball touches this frame
sub Latch:
  if BallOn = 0 then return
  ' nothing moved since the last frame: the same overlaps again
  if BX = LBX then
    if BY = LBY then
      if BF = LBF then
        if PF = LPF then
          Lat = Lat | LBits
          return
        end if
      end if
    end if
  end if
  LBX = BX
  LBY = BY
  LBF = BF
  LPF = PF
  LBits = 0
  ' the wall: C64 x 338-343, y 171-212
  for Si = 0 to 2
    R = BY + Si
    if R >= 171 then
      if R <= 212 then
        W16 = BX + BallC1[Si]
        W2 = BX + BallC0[Si]
        if W16 >= 338 then
          if W2 <= 343 then LBits = LBits | 4
        end if
      end if
    end if
  next
  ' the batter (x 25) and the pitcher (x 120), both at y 189-209. Only a
  ' read of "ball + wall alone" matters, so their pixels are only tested
  ' while the latch holds the wall alone (a stale fall from the wall)
  T = Lat | LBits
  if T <> 4 then
    Lat = Lat | LBits
    LBX = 999
    return
  end if
  if BY >= 187 then
    if BY <= 209 then
      if BX >= 22 then
        if BX < 52 then
          Fx = BF
          W2 = 25
          T = FigHit
          if T > 0 then LBits = LBits | 1
        end if
        if BX >= 117 then
          if BX < 144 then
            Fx = PF + 2
            W2 = 120
            T = FigHit
            if T > 0 then LBits = LBits | 2
          end if
        end if
      end if
    end if
  end if
  Lat = Lat | LBits
  return
end sub

' does the ball overlap figure Fx (mask 0-4) drawn at C64 x W2, y 189?
function FigHit as u8
  u8 Gh = 0
  u8 Gr = 0
  u8 Gc = 0
  u8 Gy = 0
  u16 Gp = 0
  u16 Go = 0
  Gh = 0
  for Gr = 0 to 2
    Gy = BY + Gr
    if Gy >= 189 then
      if Gy <= 209 then
        Gy -= 189
        for Gc = 0 to 3
          if Gc >= BallC0[Gr] then
            if Gc <= BallC1[Gr] then
              Gp = BX + Gc
              if Gp >= W2 then
                Gp -= W2
                if Gp < 24 then
                  Go = Fx * 63
                  Go += Gy * 3
                  W16 = Gp >> 3
                  Go += W16
                  W16 = Gp & 7
                  Mb = FigMask[Go] & Bit[W16]
                  if Mb > 0 then Gh = 1
                end if
              end if
            end if
          end if
        next
      end if
    end if
  next
  return Gh

' the computer batter: it judges the pitch like a player would - a
' reaction-time error that grows with the speed, and it lets pitches that
' are clearly off the zone go by
sub CpuPlan:
  CpuTake = 0
  CpuLook = 0
  ' aim: the plate (37) + half a frame of travel, +/- T pixels of error
  ' (about 3 frames wide, like a player's timing)
  T = 7
  if Spd = 2 then T = 14
  if Spd = 3 then T = 10
  K = T << 1
  K += 1
  ' a random 0 .. 2T without a division (this pass also starts the pitch)
  Rand
  W16 = Rs & 31
  C = W16
  if C >= K then C -= K
  CpuAim = 38 + C
  CpuAim -= T
  if Spd = 2 then inc CpuAim
  return
end sub

sub CpuBat:
  if Ph <> PhPitch then return
  if Swung = 1 then return
  if CpuLook = 0 then
    if BX <= 72 then
      CpuLook = 1
      ' a pitch that already left the zone is let go 3 times in 4
      T = 0
      if BY < 198 then T = 1
      if BY > 202 then T = 1
      if T = 1 then
        C = RandBelow(4)
        if C > 0 then CpuTake = 1
      end if
    end if
  end if
  if CpuTake = 1 then return
  W16 = CpuAim
  if BX <= W16 then BatFire = 16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' 33 tries a frame, a cell of the 6 x 28 crowd gets a random colour (the
' C64 IRQ at $C00D: 31 tries on 6 x 40 cells, cells >= 240 retried). The
' random bytes come from a 256-byte table mixed with one xorshift a frame
' (34 xorshifts a frame did not fit in the frame).
sub Crowd:
  Rand
  W16 = Rs >> 8
  Sa = W16
  W16 = Rs & 255
  Sb = W16
  for Cw = 1 to 33
    T = RndTab[Ci] ^ Sa
    inc Ci
    if T < 168 then
      C = CellC[T]
      R = CellR[T]
      V = RndTab[Ci] ^ Sb
      V = V & 15
      K = CrowdT[V]
      put char K at C,R
    end if
    inc Ci
  next
  return
end sub

' C64 sprite coordinates -> screen: x 0.7 (16 + (x - 24) x 179 / 256), y - 59;
' shown for C64 x 24-339 (the C64 shows 24-343)
sub DrawSprites:
  if BallOn = 0 then goto ds_hide
  if BX < 24 then goto ds_hide
  ' past x 339 the 4-pixel ball would reach column 30 (overscan): hidden
  if BX > 339 then goto ds_hide
  W16 = BX - 24
  W16 = W16 * 179
  W16 = W16 >> 8
  W16 += 16
  T = W16
  V = BY - 59
  set sprite 0 to V,T,SBall,15
  set sprite 1 to 156,T,SShadow,1
  update sprites
  return
ds_hide:
  set sprite 0 to HideY,0,SBall,0
  set sprite 1 to HideY,0,SShadow,0
  update sprites
  return
end sub

' the batter (C64 frames 194/195) and the pitcher (196-198) as tiles
sub DrawFigures:
  if BF <> DrawnBF then
    Busy = 1
    DrawnBF = BF
    K = TBat00
    if BF = 1 then K = TSwing00
    C = 2
    PutFig
  end if
  if PF <> DrawnPF then
    Busy = 1
    DrawnPF = PF
    K = PF * 9
    K += TPa00
    C = 10
    PutFig
  end if
  return
end sub

' 3 x 3 tiles from code K at column C, rows 16-18
sub PutFig:
  for Si = 16 to 18
    put char K at C,Si
    inc K
    T = C + 1
    put char K at T,Si
    inc K
    T += 1
    put char K at T,Si
    inc K
  next
  return
end sub

' BLUE bats with the cyan figure, RED with the dark red one (line 235)
sub SideColours:
  if TU = 0 then
    fill $71 count 144 to vram.color + 1168
    fill $61 count 216 to vram.color + 1312
  else
    fill $61 count 144 to vram.color + 1168
    fill $71 count 216 to vram.color + 1312
  end if
  return
end sub

' a panel number: NumU (0-99) in 2 cells from tile code K (digit 0) at C,R
' (a leading zero is the panel's blank, tile K - 1 - its letters)
sub PanelNum:
  T = Tens[NumU]
  V = Ones[NumU]
  if T = 0 then
    put char J at C,R
  else
    T += K
    put char T at C,R
  end if
  C += 1
  V += K
  put char V at C,R
  return
end sub

' the HUD's fixed parts (labels and panel ends), drawn with the screen
sub HudFrame:
  ' BLUE panel, columns 5-13 of row 14
  put char TB_ at 5,14
  put char TBB at 6,14
  put char TBL at 7,14
  put char TBU at 8,14
  put char TBE at 9,14
  put char TB_ at 10,14
  put char TB_ at 13,14
  ' RED panel, columns 19-26
  put char TR_ at 19,14
  put char TRR at 20,14
  put char TRE at 21,14
  put char TRD at 22,14
  put char TR_ at 23,14
  put char TR_ at 26,14
  ' the purple box: INNING n, and one ball per pitch left
  put char TM_ at 15,16
  put char TMI at 16,16
  put char TMN at 17,16
  put char TMN at 18,16
  put char TMI at 19,16
  put char TMN at 20,16
  put char TMG at 21,16
  put char TM_ at 22,16
  put char TM_ at 25,16
  put char TM_ at 26,16
  put char TM_ at 15,17
  put char TM_ at 25,17
  put char TM_ at 26,17
  return
end sub

' the HUD's numbers (line 330): scores, inning, the pitches left as balls
sub ShowHud:
  NumU = BL
  K = TB0
  J = TB_
  C = 11
  R = 14
  PanelNum
  NumU = RE
  K = TR0
  J = TR_
  C = 24
  R = 14
  PanelNum
  NumU = Inn
  K = TM0
  J = TM_
  C = 23
  R = 16
  PanelNum
  for Si = 1 to 9
    T = TM_
    if Si <= PI then T = TMball
    C = Si + 15
    put char T at C,17
  next
  return
end sub

' BALL / STRIKE above the batter (C64 row 17, white)
sub ShowMsg:
  ClearMsg
  if Result = 1 then print at 6,15, "BALL"
  if Result = 2 then print at 5,15, "STRIKE"
  return
end sub

sub ClearMsg:
  print at 5,15, "      "
  return
end sub

' the stadium: lights (rows 1-4), poles (5-6), crowd (7-12), the purple
' line (13), the HUD area (14-18), the wall (column 29) and the field (19-22)
sub DrawStadium:
  for Si = 1 to 4
    fill TDotyellow count 5 at 4,Si
    fill TDotyellow count 5 at 13,Si
    fill TDotyellow count 5 at 22,Si
  next
  for Si = 5 to 6
    put char TPole at 6,Si
    put char TPole at 15,Si
    put char TPole at 24,Si
  next
  for Si = 7 to 12
    fill TDotwhite count 28 at 2,Si
  next
  fill TLine count 28 at 2,13
  for Si = 19 to 22
    fill TField count 28 at 2,Si
  next
  put char TWalltop at 29,14
  for Si = 15 to 18
    put char TWallmid at 29,Si
  next
  put char TWallbot at 29,19
  return
end sub

sub DrawPlay:
  NewScreen
  DrawStadium
  SideColours
  DrawnBF = 255
  DrawnPF = 255
  DrawFigures
  HudFrame
  ShowHud
  ShowScreen
  for Li = 1 to 8
    Crowd
  next
  DrawSprites
  return
end sub

sub GameOver:
  HideSprites
  ' the C64 blanks the lights and prints NICE GAME, BLUE / RED (it names
  ' RED whenever RED scored at all - a typo, BE for BL: fixed here)
  for Si = 1 to 6
    fill 32 count 28 at 2,Si
  next
  Winner = 0
  if RE > BL then Winner = 1
  if Winner = 0 then
    print at 8,2, "NICE GAME, BLUE"
  else
    print at 8,2, "NICE GAME, RED"
  end if
  if Players = 1 then
    if Winner = 0 then
      print at 11,4, "YOU WIN"
    else
      print at 7,4, "THE COMPUTER WINS"
    end if
  end if
  print at 8,6, "PRESS THE BUTTON"
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker off
  for J = 0 to 2
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the stadium's lights, the name on the purple panel, the menu,
' the batter and the pitcher on the field; the tune once
sub TitlePage:
  NewScreen
  State = StTitle
  for Si = 1 to 3
    fill TDotyellow count 5 at 4,Si
    fill TDotyellow count 5 at 13,Si
    fill TDotyellow count 5 at 22,Si
  next
  put char TPole at 6,4
  put char TPole at 15,4
  put char TPole at 24,4
  ' HOME RUN DERBY on the purple panel (columns 7-22 of row 6)
  fill TM_ count 16 at 7,6
  put char TMH at 8,6
  put char TMO at 9,6
  put char TMM at 10,6
  put char TME at 11,6
  put char TMR at 13,6
  put char TMU at 14,6
  put char TMN at 15,6
  put char TMD at 17,6
  put char TME at 18,6
  put char TMR at 19,6
  put char TMB at 20,6
  put char TMY at 21,6
  print at 6,8, "RERUN FALL 1985 (C64)"
  print at 10,10, "1 PLAYER"
  print at 10,12, "2 PLAYERS"
  ShowPitchOpt
  print at 10,16, "HOW TO PLAY"
  print at 10,18, "CREDITS"
  for Si = 21 to 22
    fill TField count 28 at 2,Si
  next
  TU = 0
  SideColours
  K = TBat00
  C = 2
  PutFigAt18
  K = TPc00
  C = 25
  PutFigAt18
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu = 2 then
    PitchCtl = PitchCtl ^ 1
    play sound SndClick
    ShowPitchOpt
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Players = 1
  if Menu = 1 then Players = 2
  return
end sub

sub PutFigAt18:
  for Si = 18 to 20
    put char K at C,Si
    inc K
    T = C + 1
    put char K at T,Si
    inc K
    T += 1
    put char K at T,Si
    inc K
  next
  return
end sub

sub ShowPitchOpt:
  if PitchCtl = 0 then
    print at 10,14, "PITCHES: AUTO  "
  else
    print at 10,14, "PITCHES: PLAYER"
  end if
  return
end sub

sub ShowMenu:
  put char 32 at 8,10
  put char 32 at 8,12
  put char 32 at 8,14
  put char 32 at 8,16
  put char 32 at 8,18
  C = Menu << 1
  C += 10
  put char 62 at 8,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  NewScreen
  State = StCredits
  print at 8,2, "HOME RUN DERBY"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: three pages with the game's own tiles and sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 2
  TxY = 3
  TxGap = 2
  TextShow
  ' the picture: batter, pitcher and the ball on its way
  TU = 0
  SideColours
  K = TBat00
  C = 2
  PutFig
  K = TPc00
  C = 10
  PutFig
  fill TField count 28 at 2,19
  set sprite 0 to 141,52,SBall,15
  set sprite 1 to 156,52,SShadow,1
  update sprites
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    ' the HUD: the two scores, the inning and the pitches left
    BL = 2
    RE = 1
    Inn = 3
    PI = 6
    HudFrame
    ShowHud
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 2
    TxY = 3
    TxGap = 2
    TextShow
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
