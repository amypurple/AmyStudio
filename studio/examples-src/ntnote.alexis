NtSoundTable:
    dw NtTuneMel,$702B
    dw NtTuneBass,$7035
    dw NtMove,$7053
    dw NtRight,$7053
    dw NtWrong,$7053
    dw NtLate,$7053
    dw NtStart,$7053
    dw NtOver,$7053
; Lines and Spaces (original)
; Tiny Sound, 8 frames per step
NtTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$17,$01,$1A,$01,$1F,$01,$1E,$1C,$1A,$01,$17,$01
    db $18,$01,$1C,$01,$21,$01,$1F,$1E,$1C,$01,$01,$01,$1A,$01,$1E,$01
    db $21,$01,$1F,$1E,$1C,$01,$18,$01,$17,$01,$1A,$01,$1F,$01,$23,$01
    db $21,$01,$1F,$01,$01,$01,$00,$01,$01,$01
    db $FF
NtTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$07,$01,$0E,$01
    db $0C,$01,$13,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$0C,$01,$13,$01,$07,$01,$0E,$01,$0E,$01,$15,$01
    db $07,$01,$01,$01,$01,$01,$00,$01,$01,$01
    db $FF
; PsgNote: start the quiz note: period AMY_UVAR_Pp on tone 1, or on tone 3
; (silent) driving periodic noise when AMY_UVAR_Pn = 1; loudness AMY_UVAR_Va
PsgNote:
  ld a,$9F
  out ($FF),a
  ld a,$FF
  out ($FF),a
  ld a,(AMY_UVAR_Pn)
  or a
  ld b,$80
  jr z,PsgNoteP
  ld b,$C0
PsgNoteP:
  ld hl,(AMY_UVAR_Pp)
  ld a,l
  and $0F
  or b
  out ($FF),a
  ld a,l
  rrca
  rrca
  rrca
  rrca
  and $0F
  ld c,a
  ld a,h
  add a,a
  add a,a
  add a,a
  add a,a
  or c
  and $3F
  out ($FF),a
  ld a,(AMY_UVAR_Pn)
  or a
  jr z,PsgVol
  ld a,$DF
  out ($FF),a
  ld a,$E3
  out ($FF),a
; PsgVol: the quiz note's loudness (tone 1 or the noise)
PsgVol:
  ld a,(AMY_UVAR_Pn)
  or a
  ld b,$90
  jr z,PsgVolP
  ld b,$F0
PsgVolP:
  ld a,(AMY_UVAR_Va)
  and $0F
  or b
  out ($FF),a
  ret
}
