' FP5 compare lab: truth-table style compare checks with mixed expected true/false results.
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0
fp5 H = 0
u8 EqAD = 0
u8 LtAB = 0
u8 GtAB = 0
u8 NeAD = 0
u8 LtCZero = 0
u8 GtCZero = 0
u8 EqEZero = 0
u8 LeFZero = 0
u8 LeATwo = 0
u8 LtATwo = 0
u8 LtGH = 0
u8 LtHG = 0

  text screen
  print at 5,0, "FP5 COMPARE TRUTH LAB"

  A = 2
  B = 3
  C = -1
  D = 2
  E = 0
  F = 1
  G = 1
  G /= 2
  H = 3
  H /= 4

  if A = D then EqAD = 1
  if A < B then LtAB = 1
  if A > B then GtAB = 1
  if A <> D then NeAD = 1
  if C < 0 then LtCZero = 1
  if C > 0 then GtCZero = 1
  if E = 0 then EqEZero = 1
  if F <= 0 then LeFZero = 1
  if A <= 2 then LeATwo = 1
  if A < 2 then LtATwo = 1
  if G < H then LtGH = 1
  if H < G then LtHG = 1

  print at 1,3,  "A"
  print A at 4,3 digits 16
  print at 1,4,  "B"
  print B at 4,4 digits 16
  print at 1,5,  "C"
  print C at 4,5 digits 16
  print at 1,6,  "D"
  print D at 4,6 digits 16
  print at 1,7,  "G"
  print G at 4,7 digits 16
  print at 1,8,  "H"
  print H at 4,8 digits 16

  print at 1,10,  "A=D"
  print EqAD at 10,10 digits 3
  print at 1,11,  "A<B"
  print LtAB at 10,11 digits 3
  print at 1,12,  "A>B"
  print GtAB at 10,12 digits 3
  print at 1,13,  "A<>D"
  print NeAD at 10,13 digits 3
  print at 1,14,  "C<0"
  print LtCZero at 10,14 digits 3
  print at 1,15,  "C>0"
  print GtCZero at 10,15 digits 3
  print at 16,10, "E=0"
  print EqEZero at 28,10 digits 3
  print at 16,11, "F<=0"
  print LeFZero at 28,11 digits 3
  print at 16,12, "A<=2"
  print LeATwo at 28,12 digits 3
  print at 16,13, "A<2"
  print LtATwo at 28,13 digits 3
  print at 16,14, "G<H"
  print LtGH at 28,14 digits 3
  print at 16,15, "H<G"
  print LtHG at 28,15 digits 3

  print at 1,19, "EXPECT"
  print at 1,20, "001 001 000 000 001 000"
  print at 1,21, "001 000 001 000 001 000"
  print at 1,22, "LEFT THEN RIGHT COLUMNS"
  screen on