data Jumps bytes 248, 235, 244, 237, 19, 12, 21, 8

sub KbNewGame:
  fill array Kb with 255
  for I = 1 to 7
    for J = 1 to 7
      V = I * 10
      V = V + J
      W = 0
      if I = 1 then W = 2
      if I = 7 then W = 1
      Kb[V] = W
    next
  next
  Co = 0
  Hu = 0
  return
end sub

' Moves: Ms[0..Ns-1] = where the knight on A can go (empty or an enemy),
' in the book's order
sub KbMoves:
  Ns = 0
  Kind = Kb[A]
  for Zi = 0 to 7
    W = Jumps[Zi]
    B = A + W
    if B < 100 then
      V = Kb[B]
      if V <> 255 then
        if V <> Kind then
          KbMs[Ns] = B
          inc Ns
        end if
      end if
    end if
  next
  return
end sub

' Pick: Force = side Side's knight chosen by chance among those that can
' move (Np = how many could)
sub Pick:
  Np = 0
  for K = 11 to 77
    if Kb[K] = Side then
      A = K
      KbMoves
      if Ns > 0 then
        Pl[Np] = K
        inc Np
      end if
    end if
  next
  if Np = 0 then return
  KbRnd
  NumW = Rb
  NumW = NumW * Np
  NumW = NumW >> 8
  V = NumW
  Force = Pl[V]
  ' the cursor runs over the candidates before it settles
  for K = 1 to 16
    KbRnd
    NumW = Rb
    NumW = NumW * Np
    NumW = NumW >> 8
    V = NumW
    Cur = Pl[V]
    KbDrawCursor
    play sound KbSndMove
    for J = 1 to 3
      KbFrame1
    next
  next
  Cur = Force
  KbDrawCursor
  return
end sub

' PickSquare: B = where the computer's knight on Force goes
sub PickSquare:
  A = Force
  KbMoves
  ' a capture, the first in the book's order
  for I = 1 to Ns
    J = I - 1
    W = KbMs[J]
    if Kb[W] = 2 then
      B = W
      return
    end if
  next
  if Level = 1 then
    ' a square none of your knights can reach
    for I = 1 to Ns
      J = I - 1
      W = KbMs[J]
      Attacked
      if Safe = 1 then
        B = W
        return
      end if
    next
  end if
  B = KbMs[0]
  return
end sub

' Attacked: Safe = 1 when no knight of yours could land on square W
sub Attacked:
  Safe = 1
  for Zi = 0 to 7
    V = Jumps[Zi]
    V = W + V
    if V < 100 then
      if Kb[V] = 2 then Safe = 0
    end if
  next
  return
end sub

' Land: the knight from A arrives on B; Kind = what was there
sub Land:
  Kind = Kb[B]
  Kb[B] = Kb[A]
  Kb[A] = 0
  Cell = A
  KbDrawSquare
  Cell = B
  KbDrawSquare
  return
end sub

' Rnd: Rb = a random byte (16-bit xorshift)
sub KbRnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' ShowWhere: the forced knight's square, as the book's two digits
sub ShowWhere:
  V = Force / 10
  W = V * 10
  W = Force - W
  NumU = Force
  print at 2,22, digits$(NumU, 2)
  return
end sub

' Slide: the knight on A leaps to B on screen (a sprite)
sub KbSlide:
  Kind = Kb[A]
  Kb[A] = 0
  Cell = A
  KbDrawSquare
  Kb[A] = Kind
  Cell = A
  KbSquareXY
  Sx = X
  Sy = Y
  Cell = B
  KbSquareXY
  Tx = X
  Ty = Y
  W = SKnight
  K = 15
  if Kind = 1 then
    W = SKnightl
    K = 1
  end if
  ' (if-else: two one-line ifs on the same pair after an addition are
  ' miscompiled by Amy)
kb_sl_step:
  if Sx < Tx then
    Sx = Sx + 2
  else
    if Sx > Tx then Sx = Sx - 2
  end if
  if Sy < Ty then
    Sy = Sy + 2
  else
    if Sy > Ty then Sy = Sy - 2
  end if
  set sprite 1 to Sy, Sx, W, K
  update sprites
  KbFrame1
  if Sx <> Tx then goto kb_sl_step
  if Sy <> Ty then goto kb_sl_step
  set sprite 1 to 192, 0, 0, 0
  update sprites
  play sound KbSndPlace
  return
end sub

' SquareXY: X, Y = the sprite position of square Cell
sub KbSquareXY:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  X = X * 16
  X = X + 16
  V = 7 - Y
  Y = V * 16
  Y = Y + 31
  return
end sub

' DrawSquare: square Cell as it is now
sub KbDrawSquare:
  V = Kb[Cell]
  W = 0
  if V = 2 then W = 1
  if V = 1 then W = 2
  W = W * 4
  KbDrawState
  return
end sub

' DrawState: square Cell with state tile offset W (0 empty, 4 yours,
' 8 the computer's, 12 a dot)
sub KbDrawState:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  V = X + Y
  V = V & 1
  V = V * 16
  W = W + V
  W = W + KbTQ0ea
  X = X * 2
  X = X + 2
  V = 7 - Y
  Y = V * 2
  Y = Y + 4
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub KbShowDots:
  for I = 1 to Ns
    J = I - 1
    Cell = KbMs[J]
    if Kb[Cell] = 0 then
      W = 12
      KbDrawState
    end if
  next
  return
end sub

sub KbClearDots:
  for K = 11 to 77
    if Kb[K] = 0 then
      Cell = K
      KbDrawSquare
    end if
  next
  return
end sub

sub KbDrawBoard:
  put char KbTFtl at 3,3
  fill KbTFt count 14 at 4,3
  put char KbTFtr at 18,3
  for Y = 4 to 17
    put char KbTFl at 3,Y
    put char KbTFr at 18,Y
  next
  put char KbTFbl at 3,18
  fill KbTFb count 14 at 4,18
  put char KbTFbr at 18,18
  for K = 11 to 77
    if Kb[K] <> 255 then
      Cell = K
      KbDrawSquare
    end if
  next
  ' the book's numbers along the sides
  print at 4,19, "1 2 3 4 5 6 7"
  for I = 1 to 7
    V = 7 - I
    V = V * 2
    V = V + 4
    NumU = I
    print at 20,V, digits$(NumU, 1)
  next
  return
end sub

sub KbShowPanel:
  print at 22,5, "ME"
  put char KbTQ0mea at 22,6
  put char KbTQ0meb at 23,6
  put char KbTQ0mec at 22,7
  put char KbTQ0med at 23,7
  print at 25,6, "TOOK"
  NumU = Co
  print at 25,7, digits$(NumU, 1)
  print at 22,11, "YOU"
  put char KbTQ0youa at 22,12
  put char KbTQ0youb at 23,12
  put char KbTQ0youc at 22,13
  put char KbTQ0youd at 23,13
  print at 25,12, "TOOK"
  NumU = Hu
  print at 25,13, digits$(NumU, 1)
  return
end sub

sub KbDrawCursor:
  Cell = Cur
  KbSquareXY
  V = Tick & 8
  W = 11
  if V > 0 then W = 9
  set sprite 0 to Y, X, KbSCursor, W
  update sprites
  return
end sub

sub KbMoveCursor:
  if Stick = 0 then return
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  if Lf1 = 1 then
    if X > 1 then dec X
  end if
  if Rt1 = 1 then
    if X < 7 then inc X
  end if
  if Up1 = 1 then
    if Y < 7 then inc Y
  end if
  if Dn1 = 1 then
    if Y > 1 then dec Y
  end if
  Cur = Y * 10
  Cur = Cur + X
  play sound KbSndMove
  return
end sub

sub KbMessage:
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub KbBoardScreen:
  KbNewScreen
  print at 4,1, "KNIGHTSBRIDGE"
  KbDrawBoard
  KbShowPanel
  KbShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub KbRearm:
  nmi off
  nmi on
  return
end sub

sub KbFrame1:
  KbRearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for Tries = 1 to 40
    KbFrame1
  next
  return
end sub

sub KbReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub KbHideSprites:
  clear sprites
  set sprite count 2
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub KbNewScreen:
  KbRearm
  wait
  nmi off
  display off
  KbHideSprites
  fill mode 2 text color with $F0
  copy KbTilePat count KbNTiles8 to vram.pattern + 1024
  copy KbTileCol count KbNTiles8 to vram.color + 1024
  copy KbTilePat count KbNTiles8 to vram.pattern + 3072
  copy KbTileCol count KbNTiles8 to vram.color + 3072
  copy KbTilePat count KbNTiles8 to vram.pattern + 5120
  copy KbTileCol count KbNTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub KbShowScreen:
  screen on
  nmi off
  return
end sub

sub KbTitlePage:
  KbNewScreen
  print at 9,2, "KNIGHTSBRIDGE"
  ' a white knight facing a black one
  fill array Kb with 255
  Kb[53] = 2
  Kb[54] = 0
  Kb[55] = 1
  for I = 53 to 55
    Cell = I
    KbDrawSquare
  next
  print at 6,13, "PLAY"
  print at 6,14, "LEVEL:"
  print at 6,15, "HOW TO PLAY"
  print at 6,16, "CREDITS"
  print at 6,17, "OTHER GAME"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  KbShowScreen
  Menu = 0
  play sound KbSndTuneA
  play sound KbSndTuneB
  WasBtn = 1
kb_title_loop:
  KbFrame1
  KbRnd
  KbReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 4 then inc Menu
    end if
    play sound KbSndMove
  end if
  for I = 13 to 17
    print at 4,I, " "
  next
  Y = Menu + 13
  print at 4,Y, ">"
  if Level = 0 then print at 13,14, "BOOK  "
  if Level = 1 then print at 13,14, "MASTER"
  if Press = 0 then goto kb_title_loop
  if Menu = 1 then
    Level = 1 - Level
    play sound KbSndPlace
    goto kb_title_loop
  end if
  mute all
  return
end sub

sub KbRulesPage:
  KbNewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "ALL THE PIECES ARE KNIGHTS"
  print at 2,4, "AND MOVE AS IN CHESS. YOURS"
  print at 2,5, "ARE WHITE, MINE BLACK."
  print at 2,7, "EACH TURN, CHANCE PICKS THE"
  print at 2,8, "KNIGHT THAT MUST MOVE."
  print at 2,10, "LAND ON AN ENEMY KNIGHT TO"
  print at 2,11, "TAKE IT. THE FIRST TO TAKE"
  print at 2,12, "FIVE WINS."
  print at 2,15, "STICK: MOVE THE CURSOR."
  print at 2,16, "BUTTON: SEND YOUR KNIGHT TO"
  print at 2,17, "A DOT, OR ONTO AN ENEMY."
  print at 8,22, "PRESS A BUTTON"
  KbShowScreen
  KbRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub KbEditorialPage:
  KbNewScreen
  print at 9,1, "KNIGHTSBRIDGE"
  print at 2,3, "INVENTED BY TIM HARTNELL"
  print at 2,4, "AND PUBLISHED IN HIS GIANT"
  print at 2,5, "BOOK OF COMPUTER GAMES"
  print at 2,6, "(BALLANTINE BOOKS, 1984;"
  print at 2,7, "INTERFACE PUBLICATIONS,"
  print at 2,8, "1983)."
  print at 2,10, "NEW MUSIC: KENSINGTON"
  print at 2,11, "GALLOP."
  print at 2,13, "COLECOVISION VERSION BY"
  print at 2,14, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  KbShowScreen
  KbRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

