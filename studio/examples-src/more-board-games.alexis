data GkDirs bytes 1, 9, 10, 11
data Openings bytes 34, 35, 44, 46, 47, 54, 55, 56, 57, 66

sub GkNewGame:
  fill array Ss with 0
  for I = 1 to 8
    for J = 2 to 9
      V = I * 10
      V = V + J
      Ss[V] = 46
    next
  next
  Cur = 45
  return
end sub

' Free: V = the number of free points
sub Free:
  V = 0
  for I = 12 to 89
    if Ss[I] = 46 then inc V
  next
  return
end sub

' Count: K = K + the stones of side Z in a row from A in steps of N
sub Count:
  E = A
ct_next:
  E = E + N
  if Ss[E] <> Z then return
  inc K
  goto ct_next
end sub

' Longest: L = the most stones of side Z next to A in one line
sub Longest:
  L = 0
  for Xd = 0 to 3
    K = 0
    N = GkDirs[Xd]
    Count
    N = 0 - N
    Count
    if K > L then L = K
  next
  return
end sub

' ChooseMove: G = the computer's point, as the book (0: none)
sub GkChooseMove:
  for T = 1 to 3
    Z = 2
    if T = 2 then Z = 3
    G = 0
    H1 = 0
    L = 0
    for A = 12 to 89
      if Ss[A] = 46 then
        M = 0
        for Xd = 0 to 3
          K = 0
          N = GkDirs[Xd]
          Count
          N = 0 - N
          Count
          if K > L then
            H1 = 0
            L = K
          end if
          if L = K then
            V = 1
            if T = 1 then
              if L < 4 then V = 0
            else
              if L < 2 then V = 0
            end if
            if V = 1 then inc M
          end if
        next
        if M > H1 then
          H1 = M
          G = A
        end if
      end if
    next
    if H1 > 0 then return
  next
  ' at random
  for Tries = 1 to 100
    GkRnd
    NumW = Rb
    NumW = NumW * 77
    NumW = NumW >> 8
    V = NumW
    G = V + 13
    if Ss[G] = 46 then return
  next
  G = 0
  return
end sub

' Place: a stone of side Z on point G
sub Place:
  Ss[G] = Z
  Cell = G
  DrawPoint
  play sound GkSndPlace
  return
end sub

' RedLine: the five (or more) stones through A turn red, flashing
sub RedLine:
  for Xd = 0 to 3
    K = 0
    N = GkDirs[Xd]
    Count
    W = K
    N = 0 - N
    Count
    if K > 3 then goto rl_found
  next
  return
rl_found:
  ' from the far end in direction +N back through A
  N = GkDirs[Xd]
  E = W * N
  E = A + E
  K = K + 1
  for J = 1 to 6
    Cell = E
    for I = 1 to K
      W = TReda
      DrawQuad
      Cell = Cell - N
    next
    Pause10
    Cell = E
    for I = 1 to K
      DrawPoint
      Cell = Cell - N
    next
    Pause10
  next
  Cell = E
  for I = 1 to K
    W = TReda
    DrawQuad
    Cell = Cell - N
  next
  return
end sub

' Rnd: Rb = a random byte (16-bit xorshift)
sub GkRnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' DrawPoint: point Cell as it is now
sub DrawPoint:
  V = Ss[Cell]
  if V = 2 then
    W = TBlacka
  else
    if V = 3 then
      W = TWhitea
    else
      ' an empty point: its lines stop at the board's edges
      Y = Cell / 10
      X = Y * 10
      X = Cell - X
      Pr = 1
      if Y = 1 then Pr = 0
      if Y = 8 then Pr = 2
      Pc = 1
      if X = 2 then Pc = 0
      if X = 9 then Pc = 2
      W = Pr * 3
      W = W + Pc
      W = W * 4
      W = W + TPtla
    end if
  end if
  DrawQuad
  return
end sub

' DrawQuad: the 2 x 2 tiles from W for point Cell
sub DrawQuad:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  X = X * 2
  X = X - 1
  Y = Y * 2
  Y = Y + 2
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub GkDrawBoard:
  put char GkTFtl at 2,3
  fill GkTFt count 16 at 3,3
  put char GkTFtr at 19,3
  for Y = 4 to 19
    put char GkTFl at 2,Y
    put char GkTFr at 19,Y
  next
  put char GkTFbl at 2,20
  fill GkTFb count 16 at 3,20
  put char GkTFbr at 19,20
  for A = 12 to 89
    if Ss[A] <> 0 then
      Cell = A
      DrawPoint
    end if
  next
  print at 22,6, "ME"
  put char TBlacka at 22,7
  put char TBlackb at 23,7
  put char TBlackc at 22,8
  put char TBlackd at 23,8
  print at 22,11, "YOU"
  put char TWhitea at 22,12
  put char TWhiteb at 23,12
  put char TWhitec at 22,13
  put char TWhited at 23,13
  return
end sub

sub GkDrawCursor:
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  X = X * 16
  X = X - 8
  Y = Y * 16
  Y = Y + 15
  V = Tick & 8
  W = 15
  if V > 0 then W = 9
  set sprite 0 to Y, X, GkSCursor, W
  update sprites
  return
end sub

sub GkMoveCursor:
  if Stick = 0 then return
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  if Lf1 = 1 then
    if X > 2 then dec X
  end if
  if Rt1 = 1 then
    if X < 9 then inc X
  end if
  if Up1 = 1 then
    if Y > 1 then dec Y
  end if
  if Dn1 = 1 then
    if Y < 8 then inc Y
  end if
  Cur = Y * 10
  Cur = Cur + X
  play sound GkSndMove
  return
end sub

sub GkMessage:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub GkBoardScreen:
  GkNewScreen
  print at 13,1, "GOMOKU"
  GkDrawBoard
  GkShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub GkRearm:
  nmi off
  nmi on
  return
end sub

sub GkFrame1:
  GkRearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause10:
  for Tries = 1 to 10
    GkFrame1
  next
  return
end sub

sub GkPause20:
  for Tries = 1 to 20
    GkFrame1
  next
  return
end sub

sub GkReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub GkHideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub GkNewScreen:
  GkRearm
  wait
  nmi off
  display off
  GkHideSprites
  fill mode 2 text color with $F0
  copy GkTilePat count GkNTiles8 to vram.pattern + 1024
  copy GkTileCol count GkNTiles8 to vram.color + 1024
  copy GkTilePat count GkNTiles8 to vram.pattern + 3072
  copy GkTileCol count GkNTiles8 to vram.color + 3072
  copy GkTilePat count GkNTiles8 to vram.pattern + 5120
  copy GkTileCol count GkNTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub GkShowScreen:
  screen on
  nmi off
  return
end sub

sub GkTitlePage:
  GkNewScreen
  print at 13,2, "GOMOKU"
  ' five stones in a line on a strip of the board
  fill array Ss with 0
  for J = 2 to 9
    V = 40 + J
    Ss[V] = 46
  next
  for J = 3 to 7
    V = 40 + J
    Ss[V] = 2
  next
  Ss[48] = 3
  for J = 2 to 9
    Cell = 40 + J
    DrawPoint
  next
  print at 6,14, "PLAY: YOU GO FIRST"
  print at 6,15, "PLAY: I GO FIRST"
  print at 6,16, "HOW TO PLAY"
  print at 6,17, "CREDITS"
  print at 6,18, "OTHER GAME"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  GkShowScreen
  Menu = 0
  play sound GkSndTuneA
  play sound GkSndTuneB
  WasBtn = 1
gk_title_loop:
  GkFrame1
  GkRnd
  GkReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 4 then inc Menu
    end if
    play sound GkSndMove
  end if
  for I = 14 to 18
    print at 4,I, " "
  next
  Y = Menu + 14
  print at 4,Y, ">"
  if Press = 0 then goto gk_title_loop
  mute all
  return
end sub

sub GkRulesPage:
  GkNewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "TAKE TURNS PLACING STONES"
  print at 2,4, "ON THE POINTS OF THE BOARD:"
  print at 2,5, "YOURS ARE WHITE, MINE BLACK."
  print at 2,7, "FIVE IN A LINE WINS:"
  print at 2,8, "ACROSS, UP AND DOWN, OR"
  print at 2,9, "DIAGONALLY."
  print at 2,11, "EASY TO LEARN, BUT ALMOST"
  print at 2,12, "IMPOSSIBLE TO WIN!"
  print at 2,15, "STICK: MOVE THE CURSOR."
  print at 2,16, "BUTTON: PLACE A STONE."
  print at 8,22, "PRESS A BUTTON"
  GkShowScreen
  GkRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub GkEditorialPage:
  GkNewScreen
  print at 13,1, "GOMOKU"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983). THE PROGRAM IS BASED"
  print at 2,8, "ON ONE BY GRAHAM CHARLTON."
  print at 2,10, "NEW MUSIC: STONES IN THE"
  print at 2,11, "GARDEN."
  print at 2,13, "COLECOVISION VERSION BY"
  print at 2,14, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  GkShowScreen
  GkRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

