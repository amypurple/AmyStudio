cartridge "MATCH-EM/C. REGENA, COMPUTE!/1983"

' MATCH-EM
' The game by C. Regena from COMPUTE!, April 1983 ("TI-99 Match-Em", for
' the TI-99/4A in TI BASIC), for the ColecoVision in Amy by Amy Bienvenu.
' Ported by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: the listing, transcribed in orig/match-em-ti.bas from the scans
' beside it. The TI-99/4A's video chip is the ColecoVision's (TMS9918A),
' so its screen is kept cell for cell: the TI's row r, column c is the
' screen's row r-1, column c-1 here (Hchar), the shapes are the listing's
' own CALL CHAR hex (art.py reads lines 320-370), their colours are drawn
' at random for each game as line 750 does.
'
' The game: 16 squares, lettered A-P, hide eight pairs of shapes. Turn
' two over; a pair is drawn at the right and its squares can not be used
' again (turning one over shows diagonal lines). The score counts the
' tries: the lower the better. STOP shows every shape.
'
' Controls (either joystick): the stick moves a frame over the squares
' (down from the bottom row reaches STOP), the button turns the square
' over (the TI's letter keys; STOP is the S key). PLAY AGAIN? is a choice:
' left YES, right NO, the button confirms (NO goes back to the credits
' page, the listing's END). Keypad not used.
'
' How the TI ran it, kept here:
' - CALL SOUND with a positive duration waits for the sound before it to
'   end (CallSound): so the second shape shows while its click and the
'   "uh-oh" play, then the squares are covered again.
' - CALL SOUND(-99,...) of the closing tune cuts the note before it.
' - Timing (TI BASIC's pace, estimated): each CALL HCHAR takes a frame, so
'   a shape is drawn cell by cell; a pass of the tune's loop is 3 frames.
' Labels such as l800 are the listing's line numbers.
'
' Liberties taken:
' - The letters are chosen with a frame on the squares; a press of the
'   button makes one choice (a TI key held gave the same letter twice), and
'   a press made while the computer is busy counts, as CALL KEY reads a key
'   held down.
' - The PRINT screens (lines 240, 390-430, 500-590) are drawn at once
'   instead of scrolling up; line 430's PRESS ANY KEY (row 24) is on row
'   23, inside the overscan, and the texts name the button and STOP.
' - "MATCH EM" (line 780, columns 24-31) is one column left, inside the
'   overscan; "S = STOP" reads ">STOP" with the frame's marker.
' - The title's beeps (line 280, 900-1099 Hz) use the PSG's 24 periods in
'   that range.
' - Line 230's copyright sign (character 64) is never printed: left out.
' - A credits page with an original tune (Pairs) played once.
'
' Kept from the listing (they look like bugs): choosing the same square
' twice counts as a match (line 1190 compares A(A1) with A(A2)); the
' score's "=" is overwritten by its first digit (line 830, as the
' article's photo shows "SCORE 18").
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from 128;
' the frame loop is protected from the NMI and every screen is drawn with
' the NMI off after a wait.

const TSh0 = 128
const TSh1 = 129
const TSh2 = 130
const TSh3 = 131
const TSh4 = 132
const TSh5 = 133
const TSh6 = 134
const TSh7 = 135
const TSh8 = 136
const TSh9 = 137
const TSh10 = 138
const TSh11 = 139
const TSh12 = 140
const TSh13 = 141
const TSh14 = 142
const TSh15 = 143
const TSh16 = 144
const TSh17 = 145
const TSh18 = 146
const TSh19 = 147
const TSh20 = 148
const TSh21 = 149
const TSh22 = 150
const TSh23 = 151
const TSh24 = 152
const TSh25 = 153
const TSh26 = 154
const TSh27 = 155
const TSh28 = 156
const TSh29 = 157
const TSh30 = 158
const TSh31 = 159
const TSh32 = 160
const TSh33 = 161
const TSh34 = 162
const TSh35 = 163
const TSh36 = 164
const TSh37 = 165
const TSh38 = 166
const TSh39 = 167
const TSh40 = 168
const TSh41 = 169
const TSh42 = 170
const TSh43 = 171
const TSh44 = 172
const TSh45 = 173
const TSh46 = 174
const TSh47 = 175
const TSh48 = 176
const TSh49 = 177
const TSh50 = 178
const TSh51 = 179
const TSh52 = 180
const TSh53 = 181
const TSh54 = 182
const TSh55 = 183
const TSh56 = 184
const TSh57 = 185
const TSh58 = 186
const TSh59 = 187
const TSh60 = 188
const TSh61 = 189
const TSh62 = 190
const TSh63 = 191
const TBlue = 192
const TRed = 193
const TBslash = 194
const SFrame = 0
const NTiles8 = 536
const SprBytes = 32
const SndClick = 1
const SndBeep = 2
const SndUh1 = 3
const SndUh2 = 4
const SndA262 = 5
const SndA330 = 6
const SndA392 = 7
const SndA523 = 8
const SndN262 = 9
const SndN330 = 10
const SndN392 = 11
const SndN523 = 12
const SndN659 = 13
const SndN784 = 14
const SndN1046 = 15
const SndBp0 = 16
const SndBp1 = 17
const SndBp2 = 18
const SndBp3 = 19
const SndBp4 = 20
const SndBp5 = 21
const SndBp6 = 22
const SndBp7 = 23
const SndBp8 = 24
const SndBp9 = 25
const SndBp10 = 26
const SndBp11 = 27
const SndBp12 = 28
const SndBp13 = 29
const SndBp14 = 30
const SndBp15 = 31
const SndBp16 = 32
const SndBp17 = 33
const SndBp18 = 34
const SndBp19 = 35
const SndBp20 = 36
const SndBp21 = 37
const SndBp22 = 38
const SndTuneA = 39
const SndTuneB = 40
const NBeeps = 23

' --- the listing's variables ----------------------------------------------
' A() the shape in each square (0 once matched), B() the shapes in order
' (to show them all), F() F2() the colours of each shape, SC the score, M
' the matches, A1 A2 the two choices, N the square, X Y its place, CH its
' first character
u8 A[17]
u8 B[17]
u8 F[9]
u8 F2[9]
u16 SC = 0
u8 M = 0
u8 A1 = 0
u8 A2 = 0
u8 N = 0
u8 X = 0
u8 Y = 0
u8 CH = 0
u8 C = 0
u8 RC = 0
u8 Qa = 0
u8 Qb = 0
' the frame: Cur 1-16 a square, 17 STOP; Ccol the column to come back to
u8 Cur = 1
u8 Ccol = 1
u8 Pk = 0
u8 Held = 0
u8 Was = 0
' Used: the button's press already took a choice (until let go)
u8 Used = 0
u8 Fv = 0
' CALL SOUND's wait: frames left of the sound playing
u8 SndBusy = 0
' for the test bot: Ph 0 credits, 1 title, 2 instructions, 3 first
' choice, 4 second choice, 5 a pair being judged, 6 all shapes shown, 7
' PLAY AGAIN; Np counts the choices made
u8 Ph = 0
u8 Np = 0
u8 Yes = 1

u8 Dir = 0
u8 Fr = 0
u8 Any = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 K8 = 0
u8 Tick = 0
u16 W16 = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rs = $5D2B
u16 Rt = 0
u16 Rw = 0
u16 Rv = 0

  tile screen
  sprites 16x16
  sprites double
  set sound table MeSoundTable areas 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  set sprite count 1
  HideFrame
  screen on

credits:
  CreditsPage

l220:
  ' 220-310: the title, a beep for each character defined
  Ph = 1
  NewScreen
  print at 11,13, "MATCH-EM"
  ShowScreen
  for C = 96 to 159
    ' R = INT(RND*200+900): its beep
    RndK(200)
    V = lowbyte Rv
    V = BeepOf[V]
    V = V + SndBp0
    CallSound(V, 3)
  next

l380:
  ' 380-450: the instructions
  Ph = 2
  NewScreen
  print at 2,7, "CHOOSE TWO SQUARES."
  print at 2,9, "TRY TO MATCH THE SHAPES."
  print at 2,11, "THE BETTER YOU ARE, THE"
  print at 2,13, "LOWER YOUR SCORE WILL BE."
  print at 2,16, "CHOOSE STOP TO END THE GAME"
  print at 2,18, "AND SEE"
  print at 2,19, "ALL THE SHAPES."
  print at 2,22, "PRESS THE BUTTON TO START."
  ShowScreen
  WaitLetGo
l440:
  Frame1
  ReadStick
  if Fr = 0 then goto l440

l460:
  ' 460-590: the board (PRINT, drawn at once)
  SC = 0
  M = 0
  Cur = 1
  Ccol = 1
  NewScreen
  for Qa = 0 to 3
    for Qb = 0 to 3
      Block(Qa, Qb)
    next
  next
  for J8 = 1 to 16
    V = J8 + 64
    X = C1[J8]
    Y = C2[J8]
    X = X + 1
    PutC(X, Y, V)
  next
  print at 3,22, "STOP"
  print at 21,22, "SCORE ="
  ShowScreen
  for C = 1 to 8
    B[C] = C
    W = C + 8
    B[W] = C
  next
  ' 600-660: the shapes shuffled (RANDOMIZE each pass)
  for C = 1 to 16
    Reseed
l620:
    RndK(16)
    RC = lowbyte Rv
    inc RC
    if B[RC] = 0 then goto l620
    A[C] = B[RC]
    B[RC] = 0
  next
  for C = 1 to 16
    B[C] = A[C]
  next
  ' 700-760: each shape's colours, foreground and background differ
  M = 0
  for C = 1 to 8
    RndK(15)
    V = lowbyte Rv
    V = V + 2
    F[C] = V
l730:
    RndK(15)
    W = lowbyte Rv
    W = W + 2
    F2[C] = W
    if W = V then goto l730
    SetCol(C)
  next
  ' 770-790: MATCH EM, a letter a CALL HCHAR
  for C = 1 to 8
    V = Title8[C]
    W = C + 22
    Hchar(2, W, V)
  next

l800:
  ' 800-840: a try more
  inc SC
  ShowScore
  ' 850-900: the beep, the "?", the first choice
  CallSound(SndBeep, 9)
  Hchar(4, 26, 63)
  Ph = 3
  PickSq
  if Pk = 17 then goto l1660
  V = Pk + 64
  Hchar(4, 26, V)
  N = Pk
  A1 = N
  X = C1[N]
  Y = C2[N]
  if A[N] <> 0 then
    Shape
  else
    Lines
  end if
  ' 1010-1060: the beep, the "?", the second choice
  CallSound(SndBeep, 9)
  Hchar(4, 29, 63)
  Ph = 4
  PickSq
  if Pk = 17 then goto l1660
  V = Pk + 64
  Hchar(4, 29, V)
  N = Pk
  A2 = N
  X = C1[N]
  Y = C2[N]
  if A[N] <> 0 then
    Shape
  else
    Lines
  end if
  ' 1170-1220: a pair? (both not yet matched and the same shape)
  Ph = 5
  if A[A1] = 0 then goto l1200
  if A[A2] = 0 then goto l1200
  V = A[A1]
  if V = A[A2] then goto l1230
l1200:
  CallSound(SndUh1, 9)
  CallSound(SndUh2, 9)
  goto l1340
l1230:
  ' 1230-1330: a match: an arpeggio, the shape drawn at the right
  inc M
  X = MX[M]
  Y = MY[M]
  CallSound(SndA262, 9)
  CallSound(SndA330, 9)
  CallSound(SndA392, 9)
  CallSound(SndA523, 18)
  Draw9
  A[A1] = 0
  A[A2] = 0
  if M = 8 then goto l1600
l1340:
  ' 1340-1470: both squares covered again, their letters back
  X = C1[A2]
  Y = C2[A2]
  V = D[N]
  Cover(V)
  V = N + 64
  W = X + 1
  Hchar(W, Y, V)
  X = C1[A1]
  Y = C2[A1]
  V = D[A1]
  Cover(V)
  V = A1 + 64
  W = X + 1
  Hchar(W, Y, V)
  Hchar(4, 26, 32)
  PutC(4, 27, 32)
  PutC(4, 28, 32)
  PutC(4, 29, 32)
  goto l800

l1600:
  ' 1600-1650: all eight pairs: the closing tune (each note cuts the last)
  for C = 1 to 17
    V = Tune17[C]
    play sound V
    SndBusy = 6
    Frame1
    Frame1
    Frame1
  next

l1660:
  ' 1660-1710: every shape shown
  Ph = 6
  HideFrame
  Hchar(4, 26, 32)
  PutC(4, 27, 32)
  PutC(4, 28, 32)
  PutC(4, 29, 32)
  for Qa = 1 to 16
    N = Qa
    X = C1[N]
    Y = C2[N]
    Shape
  next
  ' 1720-1750: PLAY AGAIN?
  print at 2,21, "PLAY AGAIN?  YES  NO"
  Yes = 1
  Mark
  Ph = 7
  WaitLetGo
l1730:
  Frame1
  ReadStick
  if Dir = 3 then
    Yes = 1
    Mark
  end if
  if Dir = 4 then
    Yes = 0
    Mark
  end if
  if Fr = 0 then goto l1730
  if Yes = 1 then goto l460
  goto credits

' Shape: lines 1480-1590, the shape of square N at X,Y (CH from B(N))
sub Shape:
  V = B[N]
  dec V
  V = V << 3
  CH = V + TSh0
  CallSound(SndClick, 9)
  Draw9
  return
end sub

' Draw9: lines 1500-1580, the nine cells (CH+7 in the top corners)
sub Draw9:
  W = Y - 1
  V = CH + 7
  Hchar(X, W, V)
  Hchar(X, Y, CH)
  K8 = Y + 1
  Hchar(X, K8, V)
  J8 = X + 1
  V = CH + 1
  Hchar(J8, W, V)
  V = CH + 2
  Hchar(J8, Y, V)
  V = CH + 3
  Hchar(J8, K8, V)
  J8 = X + 2
  V = CH + 4
  Hchar(J8, W, V)
  V = CH + 5
  Hchar(J8, Y, V)
  V = CH + 6
  Hchar(J8, K8, V)
  return
end sub

' Lines: lines 960-980 (1120-1140), a square already matched: diagonal lines
sub Lines:
  Cover(TBslash)
  return
end sub

' Cover: three CALL HCHAR(...,3) of code Cv over the square at X,Y
sub Cover(u8 Cv):
  W = Y - 1
  Hchar3(X, W, Cv)
  J8 = X + 1
  Hchar3(J8, W, Cv)
  J8 = X + 2
  Hchar3(J8, W, Cv)
  return
end sub

' Hchar: CALL HCHAR(row, column, code), a frame
sub Hchar(u8 Hr, u8 Hc, u8 Hv):
  PutC(Hr, Hc, Hv)
  Frame1
  return
end sub

' Hchar3: CALL HCHAR(row, column, code, 3), a frame
sub Hchar3(u8 Hr, u8 Hc, u8 Hv):
  PutC(Hr, Hc, Hv)
  inc Hc
  PutC(Hr, Hc, Hv)
  inc Hc
  PutC(Hr, Hc, Hv)
  Frame1
  return
end sub

' PutC: the TI's row and column on the screen; the board's characters 40
' and 41 are tiles here, the shapes' 96-159 tiles 128-191
sub PutC(u8 Pr, u8 Pc, u8 Pv):
  if Pv = 40 then Pv = TBlue
  if Pv = 41 then Pv = TRed
  dec Pr
  dec Pc
  put char Pv at Pc,Pr
  return
end sub

' Block: a 5 x 5 block of the board (band Bb, column Bk): blue (40) when
' Bb+Bk is even, red (41) otherwise (lines 500-540)
sub Block(u8 Bb, u8 Bk):
  V = Bb + Bk
  V = V & 1
  if V = 0 then
    V = TBlue
  else
    V = TRed
  end if
  W = Bb * 5
  W = W + 1
  Rt = Bk * 5
  K8 = lowbyte Rt
  K8 = K8 + 2
  for C = 0 to 4
    for RC = 0 to 4
      J8 = K8 + RC
      X = W + C
      put char V at J8,X
    next
  next
  return
end sub

' ShowScore: lines 810-840, STR$(SC) a digit a CALL HCHAR from column 28
sub ShowScore:
  W16 = SC
  if W16 > 999 then W16 = 999
  Y = 28
  if W16 > 99 then
    Rt = W16 / 100
    V = lowbyte Rt
    Rt = Rt * 100
    W16 = W16 - Rt
    V = V + 48
    Hchar(23, Y, V)
    inc Y
    Rt = W16 / 10
    V = lowbyte Rt
    V = V + 48
    Hchar(23, Y, V)
    inc Y
  else
    if W16 > 9 then
      Rt = W16 / 10
      V = lowbyte Rt
      V = V + 48
      Hchar(23, Y, V)
      inc Y
    end if
  end if
  Rt = W16 / 10
  Rt = Rt * 10
  W16 = W16 - Rt
  V = lowbyte W16
  V = V + 48
  Hchar(23, Y, V)
  return
end sub

' SetCol: line 750, CALL COLOR(C+8,F(C),F2(C)): the eight tiles of shape
' Sc in the TI's colours (TMS = TI - 1)
sub SetCol(u8 Sc):
  V = F[Sc]
  dec V
  V = V << 4
  W = F2[Sc]
  dec W
  V = V | W
  W16 = Sc
  dec W16
  W16 = W16 << 6
  for J8 = 0 to 63
    vpoke vram.color + 1024 + W16, V
    inc W16
  next
  return
end sub

' PickSq: the frame on the squares until the button: Pk the square (1-16)
' or 17 (STOP)
sub PickSq:
  Was = 0
  Held = 0
  ShowFrame
ps_loop:
  Frame1
  ReadStick
  if Dir = 0 then
    Held = 0
    Was = 0
  else
    if Held > 0 then dec Held
    if Was <> Dir then Held = 0
    if Held = 0 then
      MoveCur
      Held = 12
      Was = Dir
      ShowFrame
    end if
  end if
  if Fr = 0 then goto ps_loop
  if Used = 1 then goto ps_loop
  Used = 1
  Pk = Cur
  inc Np
  return
end sub

' MoveCur: Dir 1 up, 2 down, 3 left, 4 right; down from the bottom row is
' STOP, up from STOP the column left
sub MoveCur:
  if Cur = 17 then
    if Dir = 1 then Cur = Ccol + 12
    return
  end if
  V = Cur - 1
  W = V & 3
  if Dir = 1 then
    if V > 3 then Cur = Cur - 4
  end if
  if Dir = 2 then
    if V < 12 then
      Cur = Cur + 4
    else
      Ccol = W + 1
      Cur = 17
    end if
  end if
  if Dir = 3 then
    if W > 0 then dec Cur
  end if
  if Dir = 4 then
    if W < 3 then inc Cur
  end if
  return
end sub

' ShowFrame: the frame round square Cur (the marker by STOP for 17)
sub ShowFrame:
  if Cur = 17 then
    hide sprite 0
    update sprites
    put char 62 at 2,22
    return
  end if
  put char 32 at 2,22
  V = Cur - 1
  W = V & 3
  V = V >> 2
  ' top left cell: column 3+5k, row 2+5b; the frame 4 dots round it
  Rt = W * 40
  K8 = lowbyte Rt
  K8 = K8 + 20
  Rt = V * 40
  J8 = lowbyte Rt
  J8 = J8 + 11
  set sprite 0 to J8,K8,SFrame,15
  update sprites
  return
end sub

sub HideFrame:
  hide sprite 0
  update sprites
  return
end sub

' Mark: the arrow on YES or NO
sub Mark:
  if Yes = 1 then
    put char 62 at 14,21
    put char 32 at 19,21
  else
    put char 32 at 14,21
    put char 62 at 19,21
  end if
  return
end sub

' CallSound: CALL SOUND with a positive duration: wait for the sound playing
' to end, then start this one for Sd frames
sub CallSound(u8 Sn, u8 Sd):
snd_wait:
  if SndBusy > 0 then
    Frame1
    goto snd_wait
  end if
  play sound Sn
  SndBusy = Sd
  return
end sub

' ReadStick: Dir 1 up, 2 down, 3 left, 4 right, 0 none; Fr the button
sub ReadStick:
  Dir = 0
  Any = 0
  V = joypad(1).up | joypad(2).up
  if V = 1 then Dir = 1
  V = joypad(1).down | joypad(2).down
  if V = 1 then Dir = 2
  V = joypad(1).left | joypad(2).left
  if V = 1 then Dir = 3
  V = joypad(1).right | joypad(2).right
  if V = 1 then Dir = 4
  if Dir > 0 then Any = 1
  Fr = joypad(1).fire | joypad(2).fire
  return
end sub

sub WaitLetGo:
wl_loop:
  Frame1
  ReadStick
  Any = Any | Fr
  if Any > 0 then goto wl_loop
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  if SndBusy > 0 then dec SndBusy
  ' a button press counts for one choice: Used until it is let go
  Fv = joypad(1).fire | joypad(2).fire
  if Fv = 0 then Used = 0
  return
end sub

sub CreditsPage:
  Ph = 0
  HideFrame
  NewScreen
  print at 11,2, "MATCH-EM"
  print at 2,4, "BY C. REGENA, FROM COMPUTE!,"
  print at 2,5, "APRIL 1983 (TI-99/4A, TI"
  print at 2,6, "BASIC). EIGHT PAIRS OF"
  print at 2,7, "SHAPES HIDE BEHIND SIXTEEN"
  print at 2,8, "SQUARES."
  print at 2,11, "FOR THE COLECOVISION BY"
  print at 2,12, "CLAUDE (AN AI MADE BY"
  print at 2,13, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "2026, IN AMY, THE LANGUAGE"
  print at 2,15, "BY AMY BIENVENU."
  print at 2,17, "MUSIC: PAIRS (ORIGINAL)."
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  play song MeSong once
  WaitLetGo
cp_wait:
  Frame1
  ReadStick
  if Fr = 0 then goto cp_wait
  Reseed
  return
end sub

' Reseed: RANDOMIZE, from the frames counted so far
sub Reseed:
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $5D2B
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  backdrop cyan
  fill mode 2 text color with $10
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' RndK: Rv = INT(RND * Kn)
sub RndK(u8 Kn):
  Rnd16
  Uq = Rw
  Uq2 = Kn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

' lines 160-210: the matched shapes' places (MX, MY) and the squares' (C1
' row, C2 column, D the colour: 40 blue, 41 red), from index 1
