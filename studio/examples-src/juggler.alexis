asm {
JgCrash:
    db $00,$00,$05,$07,$00,$00,$15,$07,$00,$00,$25,$07,$00,$00,$35,$07,$00,$00,$45,$07,$00,$00,$55,$07
    db $00,$00,$65,$07,$00,$00,$75,$07,$00,$00,$85,$07,$00,$00,$95,$07,$00,$00,$A5,$07,$00,$00,$B5,$07
    db $00,$00,$C5,$07,$00,$00,$D5,$07,$00,$00,$E5,$07,$00,$00,$F5,$07,$10
JgCatch:
    db $40,$7E,$00,$02,$40,$7E,$F0,$01,$50

JgSoundTable:
    dw JgCrash,$702B
    dw JgCatch,$7035
    dw JgTuneMel,$703F
    dw JgTuneBass,$7049
; Three in the Air, G major (original for this game)
; Tiny Sound, 7 frames per step
JgTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$21,$01,$26,$01,$2A,$01,$28,$01,$00,$00,$26,$01
    db $23,$01,$1F,$01,$23,$01,$21,$01,$00,$00,$00,$00,$1E,$01,$21,$01
    db $26,$01,$25,$01,$00,$00,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01
    db $00,$00,$00,$00,$21,$01,$26,$01,$2A,$01,$2D,$01,$00,$00,$2B,$01
    db $2A,$01,$28,$01,$26,$01,$23,$01,$00,$00,$00,$00,$1F,$01,$23,$01
    db $28,$01,$25,$01,$21,$01,$1C,$01,$1A,$01,$1E,$01,$21,$01,$26,$01
    db $00,$00,$00,$01
    db $FF
JgTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0E,$01,$12,$01,$15,$01,$09,$01,$0D,$01,$10,$01
    db $07,$01,$0B,$01,$0E,$01,$0E,$01,$12,$01,$15,$01,$0E,$01,$12,$01
    db $15,$01,$09,$01,$0D,$01,$10,$01,$0E,$01,$12,$01,$15,$01,$09,$01
    db $0D,$01,$10,$01,$0E,$01,$12,$01,$15,$01,$09,$01,$0D,$01,$10,$01
    db $0E,$01,$12,$01,$15,$01,$07,$01,$0B,$01,$0E,$01,$07,$01,$0B,$01
    db $0E,$01,$09,$01,$0D,$01,$10,$01,$0E,$01,$12,$01,$15,$01,$0E,$01
    db $01,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
JgSong:
    dw $0001
    db $40+3,4
    dw $0000

; JgBack: the backdrop (VDP register 7) to the colour V
JgBack:
    ld a,(AMY_UVAR_V)
    out ($BF),a
    ld a,$87
    out ($BF),a
    ret
}
