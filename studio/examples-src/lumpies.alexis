asm {
; LmRnd: 16-bit xorshift (7, 9, 8) on Rs
LmRnd:
  ld hl,(AMY_UVAR_Rs)
  ld a,h
  rra
  ld a,l
  rra
  xor h
  ld h,a
  ld a,l
  rra
  ld a,h
  rra
  xor l
  ld l,a
  xor h
  ld h,a
  ld (AMY_UVAR_Rs),hl
  ret

; LmBlit: the 16 x 16 view buffer Vb to the name table, columns 2-17 of
; rows 1-16 (called with the NMI off)
LmBlit:
  ld hl,AMY_UVAR_Vb
  ld de,$5822
  ld c,16
LmBlitRow:
  ld a,e
  out ($BF),a
  ld a,d
  out ($BF),a
  ld b,16
LmBlitCol:
  ld a,(hl)
  out ($BE),a
  inc hl
  djnz LmBlitCol
  ld a,e
  add a,32
  ld e,a
  jr nc,LmBlitNc
  inc d
LmBlitNc:
  dec c
  jr nz,LmBlitRow
  ret
LmStep:
    db $00,$00,$23,$01,$00,$00,$53,$02,$10
LmBump:
    db $40,$F9,$13,$03,$40,$FF,$33,$04,$50
LmDoor:
