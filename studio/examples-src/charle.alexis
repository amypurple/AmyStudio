cartridge "CHARLEMAGNE'S SWORD/COMPUTE!'S GAZETTE/1985"

' CHARLEMAGNE'S SWORD (OR WORD SEARCH)
' A ColecoVision game based on "Charlemagne's Sword", COMPUTE!'s Gazette,
' May 1985 (disk 1985-05; Commodore 64 and VIC-20 + 8K BASIC; no author
' named on the listing or the disk). Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The game: 1 to 6 players take turns. Each turn the player picks DICE
' (nine letter dice are rolled) or WORDS (a long word from the computer's
' 30-word vocabulary is dealt) and makes as many words as possible from
' those letters before the time bar runs out. Then the other players may
' challenge any word; the players decide together whether a challenge is
' right, and a word that loses its challenge is struck. Each word scores
' INT(1.41 ^ letters): 1 1 2 3 5 7 11 15 22 31 43 61 for 1 to 12 letters.
' The scores are shown after every turn.
'
' From the original (orig/charlemagne_64.bas): the nine dice and their 54
' faces, the 30 vocabulary words, the Q rule (a Q without a U turns the
' die two places away into a U, line 690-750), letters only from the ones
' shown (line 1160), the time bar, the challenge question and the players'
' YES/NO verdict (lines 340-620, nothing happens for a wrong challenge),
' the score INT(HC ^ length) with HC = 1.41 (the listing's "handicap"
' table, the same for everyone), the score table after every turn, the
' title "CHARLEMAGNE'S SWORD ... OR WORD SEARCH", the instructions text,
' "THAT'S ALL, FOLKS!".
'
' Liberties: letters are picked with the joystick from the dice (no
' keyboard); each die or letter of the dealt word can be used once in a
' word (the listing let a shown letter repeat, so EEEEEEE scored 43 in one
' player's game, where nobody can challenge); the same word twice in one
' turn is refused; up to 16 words a turn; the time bar is 24 steps of 6
' seconds (the C64's 27 steps of about 4.3 seconds, slower here because
' picking with a stick takes longer than typing) and turns red for the
' last 24 seconds (the listing turned the border red); DONE ends the turn
' early; a turn without words skips the challenge question; a game is 1 to
' 5 rounds chosen on the title (the listing played until '_' was typed),
' then the winner is named; one player keeps a best total.
'
' Controls: either controller (pass it round). On the dice: stick left /
' right picks a die, up / down goes to the DEL ENTER DONE line, left
' button takes the letter (or does the command), right button deletes the
' last letter. Menus: stick, then a button. Title: up / down choose, left
' / right change the players or rounds, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes.

const TDa = 128
const TDb = 129
const TDc = 130
const TDd = 131
const TDe = 132
const TDf = 133
const TDg = 134
const TDh = 135
const TDi = 136
const TDj = 137
const TDk = 138
const TDl = 139
const TDm = 140
const TDn = 141
const TDo = 142
const TDp = 143
const TDq = 144
const TDr = 145
const TDs = 146
const TDt = 147
const TDu = 148
const TDv = 149
const TDw = 150
const TDx = 151
const TDy = 152
const TDz = 153
const TUa = 154
const TUb = 155
const TUc = 156
const TUd = 157
const TUe = 158
const TUf = 159
const TUg = 160
const TUh = 161
const TUi = 162
const TUj = 163
const TUk = 164
const TUl = 165
const TUm = 166
const TUn = 167
const TUo = 168
const TUp = 169
const TUq = 170
const TUr = 171
const TUs = 172
const TUt = 173
const TUu = 174
const TUv = 175
const TUw = 176
const TUx = 177
const TUy = 178
const TUz = 179
const TBar = 180
const TBarlo = 181
const TSlot = 182
const TRule = 183
const TPom = 184
const TGrip = 185
const TGdt = 186
const TGdm = 187
const TGdb = 188
const TBlade = 189
const TTip = 190
const SUp = 0
const SRight = 4
const SRing = 8
const NTiles8 = 504
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndLetter = 4
const SndWord = 5
const SndBuzz = 6
const SndStrike = 7
const SndTick = 8
const SndTimeUp = 9
const SndStart = 10
const SndChamp = 11
const NSpr = 4
const MaxW = 16
const WMax = 12
const SegN = 360
const NSeg = 24
const LowT = 1440
const DieRow = 4
const CmdRow = 7
const WordRow = 9
const MsgRow = 11
const ListRow = 13
' modes of a turn
const MdChoose = 0
const MdEnter = 1
const MdAsk = 2
const MdPick = 3
const MdVerdict = 4
const MdDone = 5

data DiceT chars
  "AEIOUELRHQTDWYPSFGHJKZXCVBNMLTRNPESDAEIOUYRTNFALEIPHDS"
end data
data WordT chars
  "ELEPHANT...."
  "CONSTRUCTION"
  "VIABILITY..."
  "TURNCOAT...."
  "VEGETABLE..."
  "LIGHTPOST..."
  "MINERAL....."
  "WALNETTO...."
  "ROOSEVELT..."
  "COMPOSITION."
  "DECLARATION."
  "INDEPENDENCE"
  "SPECIFIC...."
  "UNDETERMINED"
  "LAUGHABLE..."
  "VACILLATE..."
  "STALACTITE.."
  "FACETIOUSLY."
  "CIVILIZATION"
  "BARBARIANS.."
  "CARNIVORE..."
  "STRANGLED..."
  "COLLECTION.."
  "PHILHARMONIC"
  "CONGEALED..."
  "LIQUEFIED..."
  "TRANSLUCENT."
  "UNSCRUPULOUS"
  "TERPSICHORE."
  "PREHISTORIC."
end data
data ScoreT bytes
  0, 1, 1, 2, 3, 5, 7, 11, 15, 22, 31, 43, 61
end data

' where the commands and the two-choice menus sit on row 7
data CmdX bytes
  5, 13, 22
end data
data TwoX bytes
  9, 19
end data

record Seat:
  u16 Total
  u8 Turns
end record

Seat Pl[6]
u16 Best = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TimeT = 0
u16 TurnPts = 0
' game: players, rounds, whose turn, which round
u8 Np = 2
u8 NRnd = 3
u8 P = 0
u8 Rnd = 1
' the letters of this turn: count, letters, used in the word being built
u8 NL = 9
u8 Tray[12]
u8 Used[12]
u8 Fx = 7
' the word being built: letters and the tray slot of each
u8 CwN = 0
u8 Cw[12]
u8 CwI[12]
' the words of the turn
u8 Nw = 0
u8 Wd[192]
u8 WLen[16]
' the cursor: Crow 0 dice, 1 commands; Ci its place; Wi a word
u8 Mode = 0
u8 Crow = 0
u8 Ci = 0
u8 Wi = 0
u8 Mi = 0
u8 Scr = 0
u8 Over = 0
u8 MsgT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Stick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press1 = 0
u8 Press2 = 0
u8 Move = 0
u8 RepT = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Pi = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table CsSoundTable areas 6
  sprites 8x8
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame
turn_loop:
  StartTurn
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Mode <> MdDone then goto play_loop
  ScoreTurn
  ScoresPage
  if Over = 0 then goto turn_loop

  ' the end: the winner, then back to the title on a press
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of a turn

sub PlayStep:
  StickMove
  select case Mode
  case MdChoose
    ChooseStep
  case MdEnter
    EnterStep
  case MdAsk
    AskStep
  case MdPick
    PickStep
  case MdVerdict
    VerdictStep
  end select
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearMsg
  end if
  return
end sub

' the stick as single steps: Move holds the direction bits on the first
' frame, then every 8 frames after 20 while held
sub StickMove:
  Move = 0
  if Stick = 0 then
    RepT = 0
  elseif RepT = 0 then
    Move = Stick
    RepT = 20
  else
    dec RepT
    if RepT = 0 then
      Move = Stick
      RepT = 8
    end if
  end if
  return
end sub

' left/right moves Mi between two choices; the button picks
function TwoStep as u8
  u8 Res = 0
  V = Move & 12
  if V > 0 then
    Mi = 1 - Mi
    play sound SndClick
  end if
  if Press1 = 1 then Res = Mi + 1
  if Press2 = 1 then Res = Mi + 1
  return Res

sub ChooseStep:
  K = TwoStep
  if K = 1 then
    RollDice
  elseif K = 2 then
    DealWord
  end if
  if K > 0 then StartEntry
  return
end sub

sub EnterStep:
  ' the stick
  V = Move & 3
  if V > 0 then
    Crow = 1 - Crow
    if Crow = 1 then
      Ci = 1
    else
      Ci = 0
    end if
    play sound SndClick
  end if
  V = Move & 4
  if V > 0 then
    if Ci = 0 then
      Ci = RowLen - 1
    else
      dec Ci
    end if
    play sound SndClick
  end if
  V = Move & 8
  if V > 0 then
    inc Ci
    if Ci >= RowLen then Ci = 0
    play sound SndClick
  end if
  ' the buttons
  if Press2 = 1 then DelLetter
  if Press1 = 1 then
    if Crow = 0 then
      AddLetter(Ci)
    else
      select case Ci
      case 0
        DelLetter
      case 1
        CommitWord
      case else
        EndEntry(0)
      end select
    end if
  end if
  ' the time
  if Mode = MdEnter then TimeStep
  return
end sub

function RowLen as u8
  u8 Res = 3
  if Crow = 0 then Res = NL
  return Res

sub TimeStep:
  dec TimeT
  W16 = TimeT % SegN
  if W16 = 0 then DrawBar
  if TimeT < LowT then
    W16 = TimeT % 60
    if W16 = 0 then play sound SndTick
  end if
  if TimeT = 0 then EndEntry(1)
  return
end sub

sub AddLetter(u8 Slot):
  if Used[Slot] = 1 then
    Say(1)
  elseif CwN >= WMax then
    Say(2)
  else
    Used[Slot] = 1
    Cw[CwN] = Tray[Slot]
    CwI[CwN] = Slot
    inc CwN
    play sound SndLetter
    DrawDie(Slot)
    DrawWord
  end if
  return
end sub

sub DelLetter:
  if CwN > 0 then
    dec CwN
    T = CwI[CwN]
    Used[T] = 0
    DrawDie(T)
    DrawWord
    play sound SndClick
  end if
  return
end sub

' the word being built joins the list (refused when empty, a repeat or
' the list is full)
sub CommitWord:
  u16 Base = 0
  if CwN = 0 then
    Say(3)
  elseif Nw >= MaxW then
    Say(4)
  elseif FindWord > 0 then
    Say(5)
  else
    Base = Nw * WMax
    for Li = 0 to WMax - 1
      Wd[Base + Li] = Cw[Li]
    next
    WLen[Nw] = CwN
    inc Nw
    play sound SndWord
    ClearWord
    DrawList
    DrawPoints
  end if
  return
end sub

' 1 + the word's index when the word being built is already listed, else 0
function FindWord as u8
  u8 Res = 0
  u8 Wk = 0
  u8 Same = 0
  u8 Ix = 0
  u16 B = 0
  for Wk = 0 to MaxW - 1
    if Wk < Nw then
      if WLen[Wk] = CwN then
        Same = 1
        B = Wk * WMax
        for Ix = 0 to WMax - 1
          if Ix < CwN then
            if Wd[B + Ix] <> Cw[Ix] then Same = 0
          end if
        next
        if Same = 1 then
          if Res = 0 then Res = Wk + 1
        end if
      end if
    end if
  next
  return Res

sub ClearWord:
  for Li = 0 to 11
    Used[Li] = 0
  next
  CwN = 0
  DrawTray
  DrawWord
  return
end sub

' the end of the letters: why (0 DONE, 1 time)
sub EndEntry(u8 Why):
  CwN = 0
  for Li = 0 to 11
    Used[Li] = 0
  next
  DrawTray
  DrawWord
  if Why = 1 then
    play sound SndTimeUp
    TimeT = 0
    DrawBar
  end if
  fill 32 count 28 at 2,CmdRow
  if Nw = 0 then
    Mode = MdDone
  else
    AskChallenges
  end if
  return
end sub

sub AskChallenges:
  Mode = MdAsk
  Mi = 0
  fill 32 count 28 at 2,CmdRow
  print at 9,CmdRow, "NO"
  print at 19,CmdRow, "YES"
  ClearMsg
  print at 6,MsgRow, "ANY CHALLENGES?"
  MsgT = 0
  return
end sub

sub AskStep:
  K = TwoStep
  if K = 1 then
    Mode = MdDone
  elseif K = 2 then
    Mode = MdPick
    Wi = 0
    fill 32 count 28 at 2,CmdRow
    ClearMsg
    print at 4,MsgRow, "WHICH WORD? (RIGHT: NONE)"
  end if
  return
end sub

' the challenged word: the stick walks the list (down the first column,
' then the second), a left button picks it, the right one cancels
sub PickStep:
  V = Move & 2
  if V > 0 then
    if Wi + 1 < Nw then inc Wi
    play sound SndClick
  end if
  V = Move & 1
  if V > 0 then
    if Wi > 0 then dec Wi
    play sound SndClick
  end if
  V = Move & 8
  if V > 0 then
    if Wi < 8 then
      if Wi + 8 < Nw then Wi = Wi + 8
    end if
    play sound SndClick
  end if
  V = Move & 4
  if V > 0 then
    if Wi >= 8 then Wi = Wi - 8
    play sound SndClick
  end if
  if Press2 = 1 then
    AskChallenges
  elseif Press1 = 1 then
    Mode = MdVerdict
    Mi = 0
    print at 9,CmdRow, "NO"
    print at 19,CmdRow, "YES"
    ClearMsg
    print at 3,MsgRow, "IS THE CHALLENGE RIGHT?"
  end if
  return
end sub

sub VerdictStep:
  K = TwoStep
  if K = 2 then
    StrikeWord(Wi)
    play sound SndStrike
    DrawList
    DrawPoints
  end if
  if K > 0 then
    if Nw = 0 then
      Mode = MdDone
    else
      AskChallenges
    end if
  end if
  return
end sub

' remove word Ix, the later ones move up
sub StrikeWord(u8 Ix):
  u16 Dst = 0
  u16 Src = 0
  u8 Wk = 0
  u8 Bk = 0
  for Wk = 0 to MaxW - 2
    if Wk >= Ix then
      Dst = Wk * WMax
      Src = Dst + WMax
      for Bk = 0 to WMax - 1
        Wd[Dst + Bk] = Wd[Src + Bk]
      next
      WLen[Wk] = WLen[Wk + 1]
    end if
  next
  dec Nw
  return
end sub

' the turn's points: INT(1.41 ^ length) for every word
function WordPoints as u16
  u16 Sum = 0
  u8 Wk = 0
  u8 Ln = 0
  for Wk = 0 to MaxW - 1
    if Wk < Nw then
      Ln = WLen[Wk]
      Sum = Sum + ScoreT[Ln]
    end if
  next
  return Sum

sub ScoreTurn:
  TurnPts = WordPoints
  Pl[P].Total = Pl[P].Total + TurnPts
  Pl[P].Turns = Pl[P].Turns + 1
  inc P
  if P >= Np then
    P = 0
    inc Rnd
    if Rnd > NRnd then Over = 1
  end if
  return
end sub

' a short message on row 11 for two seconds
sub Say(u8 What):
  ClearMsg
  select case What
  case 1
    print at 6,MsgRow, "THAT DIE IS IN USE"
  case 2
    print at 7,MsgRow, "THE WORD IS FULL"
  case 3
    print at 5,MsgRow, "PICK SOME LETTERS"
  case 4
    print at 5,MsgRow, "NO ROOM FOR MORE"
  case else
    print at 6,MsgRow, "YOU HAVE THAT ONE"
  end select
  play sound SndBuzz
  MsgT = 120
  return
end sub

' ---------------------------------------------------------------------------
' turns and games

sub NewGame:
  for Pi = 0 to 5
    Pl[Pi].Total = 0
    Pl[Pi].Turns = 0
  next
  P = 0
  Rnd = 1
  Over = 0
  return
end sub

sub StartTurn:
  NewScreen
  Nw = 0
  CwN = 0
  NL = 0
  Mode = MdChoose
  Mi = 0
  Crow = 0
  Ci = 0
  MsgT = 0
  TimeT = SegN * NSeg
  DrawHeader
  fill TRule count 28 at 2,12
  print at 9,CmdRow, "DICE"
  print at 19,CmdRow, "WORDS"
  print at 6,MsgRow, "DICE OR WORDS?"
  print at 2,22, "TIME"
  DrawBar
  DrawPoints
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 48
  return
end sub

' nine dice, one face each (Q rule of lines 690-750)
sub RollDice:
  u8 Dk = 0
  u8 Hu = 0
  u8 Q3 = 0
  for Dk = 0 to 8
    Rand
    W16 = Rs % 6
    K = W16
    K = Dk * 6 + K
    Tray[Dk] = DiceT[K]
  next
  NL = 9
  for Dk = 0 to 8
    if Tray[Dk] = 81 then
      Hu = 0
      for Q3 = 0 to 8
        if Tray[Q3] = 85 then Hu = 1
      next
      if Hu = 0 then
        if Dk < 2 then
          Q3 = Dk + 2
        else
          Q3 = Dk - 2
        end if
        Tray[Q3] = 85
      end if
    end if
  next
  return
end sub

' one of the 30 words, its letters as the tray
sub DealWord:
  Rand
  W16 = Rs % 30
  W16 = W16 * WMax
  NL = 0
  for Li = 0 to 11
    T = WordT[W16 + Li]
    if T <> 46 then
      Tray[Li] = T
      NL = Li + 1
    end if
  next
  return
end sub

sub StartEntry:
  Mode = MdEnter
  Crow = 0
  Ci = 0
  for Li = 0 to 11
    Used[Li] = 0
  next
  V = NL << 1
  Fx = 16 - NL
  fill 32 count 28 at 2,CmdRow
  ClearMsg
  for Li = 0 to 2
    X = CmdX[Li]
    select case Li
    case 0
      print at X,CmdRow, "DEL"
    case 1
      print at X,CmdRow, "ENTER"
    case else
      print at X,CmdRow, "DONE"
    end select
  next
  print at 3,WordRow, "WORD:"
  DrawTray
  DrawWord
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawHeader:
  NumU = P + 1
  print at 2,1, "PLAYER"
  print at 9,1, digits$(NumU, 1)
  print at 21,1, "ROUND"
  NumU = Rnd
  print at 27,1, digits$(NumU, 1)
  put char 47 at 28,1
  NumU = NRnd
  print at 29,1, digits$(NumU, 1)
  fill TRule count 28 at 2,2
  return
end sub

sub DrawDie(u8 Slot):
  T = Tray[Slot] - 65
  if Used[Slot] = 1 then
    T = T + TUa
  else
    T = T + TDa
  end if
  X = Slot << 1
  X = X + Fx
  put char T at X,DieRow
  return
end sub

sub DrawTray:
  for Ri = 0 to 11
    if Ri < NL then DrawDie(Ri)
  next
  return
end sub

sub DrawWord:
  fill 32 count 12 at 9,WordRow
  for Ri = 0 to 11
    if Ri < CwN then put char Cw[Ri] at 9 + Ri,WordRow
  next
  return
end sub

' the list: words 0-7 in column 3, 8-15 in column 17
sub DrawList:
  u16 B = 0
  u8 Wk = 0
  u8 Ix = 0
  u8 Col = 0
  u8 Row = 0
  for Wk = 0 to MaxW - 1
    Col = 3
    Row = ListRow + Wk
    if Wk >= 8 then
      Col = 17
      Row = Row - 8
    end if
    fill 32 count 12 at Col,Row
    if Wk < Nw then
      B = Wk * WMax
      for Ix = 0 to 11
        if Ix < WLen[Wk] then put char Wd[B + Ix] at Col + Ix,Row
      next
    end if
  next
  return
end sub

sub DrawPoints:
  print at 2,21, "WORDS"
  NumU = Nw
  print at 8,21, digits$(NumU, 2)
  print at 13,21, "POINTS"
  NumU = WordPoints
  print at 20,21, digits$(NumU, 4)
  return
end sub

sub DrawBar:
  W16 = TimeT + SegN - 1
  W16 = W16 / SegN
  N = W16
  T = TBar
  if TimeT <= LowT then T = TBarlo
  if N > 0 then fill T count N at 6,22
  V = NSeg - N
  if V > 0 then fill TSlot count V at 6 + N,22
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,MsgRow
  return
end sub

' sprite 0 the arrow, 1 the ring round the chosen die
sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Pat = 0
  u8 Ring = 0
  Pat = SRight
  Sy = 192
  select case Mode
  case MdChoose, MdAsk, MdVerdict
    Sx = TwoX[Mi] - 1
    Sy = CmdRow
  case MdEnter
    if Crow = 0 then
      Sx = Ci << 1
      Sx = Sx + Fx
      Sy = DieRow + 1
      Pat = SUp
      Ring = 1
    else
      Sx = CmdX[Ci] - 1
      Sy = CmdRow
    end if
  case MdPick
    Sx = 2
    Sy = Wi + ListRow
    if Wi >= 8 then
      Sx = 16
      Sy = Sy - 8
    end if
  end select
  if Sy = 192 then
    set sprite 0 to 192,0,0,0
  else
    Sx = Sx << 3
    Sy = Sy << 3
    Sy = Sy - 1
    set sprite 0 to Sy,Sx,Pat,11
  end if
  if Ring = 1 then
    Sy = DieRow << 3
    Sy = Sy - 1
    set sprite 1 to Sy,Sx,SRing,11
  else
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' the score table after a turn, and the winner at the end

sub ScoresPage:
  u16 Top = 0
  u8 Wins = 0
  u8 Ties = 0
  NewScreen
  print at 6,2, "WORD SEARCH SCORES"
  fill TRule count 28 at 2,3
  for Pi = 0 to Np - 1
    Y = Pi << 1
    Y = Y + 5
    print at 7,Y, "PLAYER"
    NumU = Pi + 1
    print at 14,Y, digits$(NumU, 1)
    NumU = Pl[Pi].Total
    print at 18,Y, digits$(NumU, 5)
    if Pl[Pi].Total > Top then Top = Pl[Pi].Total
  next
  if Over = 0 then
    print at 4,18, "LAST TURN:"
    NumU = TurnPts
    print at 15,18, digits$(NumU, 4)
    print at 20,18, "POINTS"
    NumU = P + 1
    print at 7,20, "NEXT: PLAYER"
    print at 20,20, digits$(NumU, 1)
  else
    Ties = 0
    for Pi = 0 to Np - 1
      if Pl[Pi].Total = Top then
        inc Ties
        Wins = Pi
      end if
    next
    if Np = 1 then
      if Top > Best then
        Best = Top
        print at 8,18, "A NEW BEST TOTAL!"
      else
        print at 10,18, "BEST"
        NumU = Best
        print at 15,18, digits$(NumU, 5)
      end if
    elseif Ties > 1 then
      print at 11,18, "A TIE GAME!"
    else
      print at 9,18, "PLAYER"
      NumU = Wins + 1
      print at 16,18, digits$(NumU, 1)
      print at 18,18, "WINS!"
    end if
    print at 7,20, "THAT'S ALL, FOLKS!"
  end if
  ShowScreen
  if Over = 1 then
    play sound SndChamp
  end if
  if Over = 0 then
    print at 7,22, "PRESS THE BUTTON"
    Scr = 1
    WaitPress
    Scr = 0
  else
    Scr = 2
  end if
  return
end sub

' a press of either button, a frame at a time (the bots watch Scr)
sub WaitPress:
  Rearm
  wait no fire
  nmi off
  WasBtn = 48
  Press1 = 0
  Press2 = 0
  while Press1 + Press2 = 0
    Frame1
    ReadPad
  end while
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Stick = V & 15
  Btn = V & 48
  Press1 = 0
  Press2 = 0
  if WasBtn = 0 then
    V = Btn & 16
    if V > 0 then Press1 = 1
    V = Btn & 32
    if V > 0 then Press2 = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the sword, the tune once, PLAYERS / ROUNDS / START /
' HOW TO PLAY / CREDITS
sub TitlePage:
  NewScreen
  print at 6,3, "CHARLEMAGNE'S SWORD"
  put char TPom at 4,6
  fill TGrip count 2 at 5,6
  put char TGdt at 7,5
  put char TGdm at 7,6
  put char TGdb at 7,7
  fill TBlade count 19 at 8,6
  put char TTip at 27,6
  print at 15,9, "OR"
  print at 10,10, "WORD SEARCH"
  print at 9,13, "PLAYERS"
  print at 9,14, "ROUNDS"
  print at 9,15, "START"
  print at 9,16, "HOW TO PLAY"
  print at 9,17, "CREDITS"
  print at 2,21, "COMPUTE!'S GAZETTE MAY 1985"
  if Best > 0 then
    print at 9,19, "BEST"
    NumU = Best
    print at 14,19, digits$(NumU, 5)
  end if
  Menu = 2
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 544
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 48
  Scr = 3
tp_loop:
  Frame1
  inc Rs
  ReadPad
  StickMove
  V = Move & 1
  if V > 0 then
    if Menu > 0 then dec Menu
  end if
  V = Move & 2
  if V > 0 then
    if Menu < 4 then inc Menu
  end if
  V = Move & 4
  if V > 0 then
    if Menu = 0 then
      if Np > 1 then dec Np
    elseif Menu = 1 then
      if NRnd > 1 then dec NRnd
    end if
  end if
  V = Move & 8
  if V > 0 then
    if Menu = 0 then
      if Np < 6 then inc Np
    elseif Menu = 1 then
      if NRnd < 5 then inc NRnd
    end if
  end if
  if Move > 0 then
    play sound SndClick
    ShowMenu
  end if
  V = Press1 | Press2
  if V = 0 then goto tp_loop
  Scr = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then HowPage
  if Menu = 4 then CreditsPage
  return
end sub

sub ShowMenu:
  for Li = 13 to 17
    put char 32 at 7,Li
  next
  J = Menu + 13
  put char 62 at 7,J
  print at 18,13, "< "
  NumU = Np
  print at 20,13, digits$(NumU, 1)
  print at 21,13, " >"
  print at 18,14, "< "
  NumU = NRnd
  print at 20,14, digits$(NumU, 1)
  print at 21,14, " >"
  return
end sub

' the listing's instructions (lines 930-1040), for the stick
sub HowPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 4,1, "WORD SEARCH INSTRUCTIONS"
  print at 2,3, "MAKE AS MANY WORDS AS"
  print at 2,4, "POSSIBLE FROM THE LETTERS"
  print at 2,5, "SHOWN AT THE TOP OF THE"
  print at 2,6, "SCREEN. SELECT DICE (RANDOM"
  print at 2,7, "LETTERS) OR WORDS (FROM THE"
  print at 2,8, "COMPUTER'S VOCABULARY)."
  print at 2,10, "ANY WORD CAN BE CHALLENGED"
  print at 2,11, "BY AN OPPONENT AFTER THE"
  print at 2,12, "PLAYER HAS COMPLETED HIS"
  print at 2,13, "TURN. LONGER WORDS SCORE"
  print at 2,14, "MORE: 3 LETTERS 2, 5 GET 5,"
  print at 2,15, "8 GET 15, 12 GET 61."
  print at 2,17, "STICK: CHOOSE A DIE. LEFT"
  print at 2,18, "BUTTON: TAKE IT. RIGHT"
  print at 2,19, "BUTTON: TAKE BACK A LETTER."
  print at 2,20, "DOWN: DEL, ENTER, DONE."
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 6,2, "CHARLEMAGNE'S SWORD"
  print at 2,5, "BASED ON CHARLEMAGNE'S"
  print at 2,6, "SWORD, COMPUTE!'S GAZETTE,"
  print at 2,7, "MAY 1985 (COMMODORE 64 AND"
  print at 2,8, "VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: PALADIN'S FANFARE"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

