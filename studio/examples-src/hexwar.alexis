u16 TzLeft = 0
u8 TzOn = 0

' the armies, side Sd army N at index Sd * 32 + N (N 1-31): Sa strength,
' Ij injured, Dn disrupted (back next turn), Dt disrupted (back in two
' turns), Po its hex, Fg 0 free to move, else done or in battles (the
' number of battles); Sv a copy of the strengths for a battle round
u8 Sa[64]
u8 Ij[64]
u8 Dn[64]
u8 Po[64]
u8 Fg[64]
' the map, hex T * 9 + B: owner (0 none, 1 side 0, 2 side 1) times 32
' plus the army there
u8 Mh[81]
' Dt (disrupted, back in two turns: VRAM spr_pat + 896 + index) and the
' reinforcement queues (side * 21 + turns to wait: spr_pat + 1024 + slot)
' live in VRAM, read with VGet and written with VSet
' the next army number of each side
u8 Nx[2]
' the battles (side 0's army, side 1's army) and the strengths before a
' battle round live in VRAM (BtGet, BtSet, Sv at spr_pat + 768): the
' ColecoVision has 1K of RAM
u8 Bp = 0
u16 Rs = 1
u16 Rs0 = 1
u16 Rt = 0
' Pn the side to move (1 blue, player one, moves first); Gn the scenario
' 1-5; Mode 0 one player, 1 two players, 2 demo; Winner 0, or side + 1
u8 Pn = 1
u8 Gn = 1
u8 Mode = 0
u8 Winner = 0
u16 Turn = 0
' the army picked: Pk 1, An its number, Ct its hex, Mv points used
u8 Pk = 0
u8 An = 0
u8 Ct = 0
u8 Mv = 0
' the cursor hex, the zigzag
u8 Cur = 40
u8 Zig = 0
' for the tests: each action (ActH the hex, ActR its result) and phase
u16 ActN = 0
u8 ActH = 0
u8 ActR = 0
u16 PhN = 0
u8 PhK = 0
' the computer's scratch
u8 Tg = 0
u8 Bs = 0
u8 Bh = 0
u8 Sc = 0
u8 Cs = 0
u8 Ai = 0

u16 NumU = 0
u16 W16 = 0
u8 Menu = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 Bt2 = 0
u8 WasBtn = 0
u8 WasB2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Rep = 0
