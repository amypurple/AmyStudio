u8 Tm = 0
u8 Idle = 0
u8 H = 0
u8 H2 = 0
u8 Ia = 0
u8 Ib = 0
u8 Sd = 0
u8 Od = 0
u8 J = 0
u8 K = 0
u8 L = 0
