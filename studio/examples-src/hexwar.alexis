u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 T1 = 0
u8 B1 = 0
u8 T2 = 0
u8 B2 = 0
u8 Aa = 0
u8 Ab = 0
u8 Ca = 0
u8 Cb = 0
u8 Dd = 0
u8 Ee = 0
u8 Ff = 0
u8 Qa = 0
u8 Qb = 0
u8 Ln = 0
u8 Nb = 0
u8 Qd = 0
u8 Mg = 0
u8 Dg1 = 0
u8 Dg2 = 0
u16 Acc = 0
u16 Vo = 0
u8 Vv = 0
u8 Sm = 0
' InTurn: 1 while a player's stick moves the cursor (for the tests)
u8 InTurn = 0

  tile screen
  set sound table HxSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title
  Mode = Menu
  ScenarioPage

new_game:
  NewGame
  Phase(8)
  DrawBoard
  ShowScreen
  play sound SndPlayA
  play sound SndPlayB

round:
  inc Turn
  Reveille
  Phase(1)
  DrawAll
  ShowTurn
  TakeTurn
  InTurn = 0
  if Winner = 99 then goto quit_game
  Pk = 0
  HideCursor
  ShowMsg(0)
  Battle
  Phase(2)
  Resolve
  Phase(3)
  Battle
  Phase(4)
  Prisoners
  Phase(5)
  Reinforce
  Phase(6)
  DrawAll
  Outcome
  Phase(7)
  if Winner > 0 then goto won
  Pn = Pn ^ 1
  goto round

won:
  stop sound SndPlayA
  stop sound SndPlayB
  mute all
  play sound SndWin
  print at 2,20, "                            "
  print at 2,21, "                            "
  print at 2,22, "                            "
  if Winner = 2 then
    print at 3,20, "BLUE (PLAYER ONE) WINS!"
  else
    print at 3,20, "RED (PLAYER TWO) WINS!"
  end if
  ShowGoalWon
  print at 3,22, "FIRE: TITLE"
  for Tm = 1 to 60
    Frame1
  next
  WasBtn = 1
won_wait:
  Frame1
  ReadAny
  if Press = 0 then goto won_wait
  goto title

quit_game:
  stop sound SndPlayA
  stop sound SndPlayB
  mute all
  goto title

' ---------------------------------------------------------------------
' the rules (model.mjs is the same in JavaScript)

' Rnd16: the random numbers (xorshift)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' Rmod(N): a random number 0 to N - 1 (0 when N is 0)
function Rmod(u8 Rn) as u8
  Rnd16
  if Rn = 0 then return 0
  W16 = Rs % Rn
  V = W16
  return V

' Split: Aa heads in six tosses, Ab = 6 - Aa (the listing's line 3100)
sub Split:
  Aa = 0
  for Ln = 1 to 6
    Rnd16
    if Rs >= 32768 then inc Aa
  next
  Ab = 6 - Aa
  return
end sub

' NewGame: the armies, the cities, the reinforcement queues
sub NewGame:
  for J = 0 to 63
    Sa[J] = 0
    Ij[J] = 0
    Dn[J] = 0
    Vo = J + 896
    VSet(Vo, 0)
    Po[J] = 0
    Fg[J] = 0
  next
  for J = 0 to 80
    Mh[J] = 0
  next
  Nx[0] = 5
  Nx[1] = 5
  for J = 1 to 4
    H = StartHex[J - 1]
    Sa[J] = 64
    Po[J] = H
    Mh[H] = 32 + J
    K = J + 32
    H = StartHex[J + 3]
    Sa[K] = 64
    Po[K] = H
    Mh[H] = 64 + J
  next
  ' the queues (lines 1600-1640): a = INT(RND*K*3), five times
  ' INT(RND*21-8) more, nothing under 16, else (a + K*8) AND 254
  Rs0 = Rs
  for Sd = 0 to 1
    for K = 0 to 20
      W = K * 3
      V = Rmod(W)
      Acc = V
      for L = 1 to 5
        V = Rmod(21)
        Acc = Acc + V
      next
      ' Acc is a + 40 (each toss counted from 0, not -8)
      if Acc < 56 then
        V = 0
      else
        Acc = Acc - 40
        V = K << 3
        Acc = Acc + V
        Acc = Acc & 254
        V = Acc
      end if
      J = Sd * 21
      J = J + K
      Vo = J + 1024
      VSet(Vo, V)
    next
  next
  Pn = 1
  Turn = 0
  Winner = 0
  Pk = 0
  Cur = 40
  Bp = 0
  return
end sub

' Valid(T, B): 1 if T, B is a hex of the field
function Valid(u8 Vt, u8 Vb) as u8
  if Vt > 8 then return 0
  if Vb > 8 then return 0
  V = Vt + Vb
  if V < 4 then return 0
  if V > 12 then return 0
  return 1

' Nbr(H, D): the hex next to H in direction D (0-5), 255 if none:
' 0 T+1 (NE), 1 T+1 B-1 (E), 2 B-1 (SE), 3 T-1 (SW), 4 T-1 B+1 (W),
' 5 B+1 (NW)
function Nbr(u8 Nh, u8 Nd) as u8
  T2 = HT[Nh] + DirT[Nd]
  B2 = HB[Nh] + DirB[Nd]
  T2 = T2 - 1
  B2 = B2 - 1
  V = Valid(T2, B2)
  if V = 0 then return 255
  V = T2 * 9
  V = V + B2
  return V

' Adjacent(H, H2): 1 if the two hexes are neighbours
function Adjacent(u8 Ah, u8 Ah2) as u8
  for Dd = 0 to 5
    V = Nbr(Ah, Dd)
    if V = Ah2 then return 1
  next
  return 0

' Dist(H, H2): hexes between two hexes
function Dist(u8 Gh, u8 Gh2) as u8
  T1 = HT[Gh]
  B1 = HB[Gh]
  T2 = HT[Gh2]
  B2 = HB[Gh2]
  if T1 > T2 then
    V = T1 - T2
  else
    V = T2 - T1
  end if
  if B1 > B2 then
    W = B1 - B2
  else
    W = B2 - B1
  end if
  V = V + W
  T1 = T1 + B1
  T2 = T2 + B2
  if T1 > T2 then
    W = T1 - T2
  else
    W = T2 - T1
  end if
  V = V + W
  V = V >> 1
  return V

' IsCity(H): 1 a city, 2 a capital (in this scenario), 0 neither
function IsCity(u8 Ch) as u8
  for Ln = 0 to 11
    if CityHex[Ln] = Ch then
      if Ln = 0 then return 2
      if Ln = 1 then
        if Gn = 1 then return 2
      end if
      if Ln = 2 then
        if Gn = 2 then return 2
      end if
      return 1
    end if
  next
  return 0

' ClearFlags: Fg 0 for every army of both sides
sub ClearFlags:
  for J = 0 to 63
    Fg[J] = 0
  next
  return
end sub

' FindBattles (lines 2400-2500): every pair of neighbouring armies of
' the two sides, each pair once
sub FindBattles:
  Bp = 0
  for H = 0 to 80
    W = Mh[H]
    Aa = W & 31
    Ab = W >> 5
    if Aa = 0 then goto fb_next
    if Ab = 0 then goto fb_next
    Ia = Ab - 1
    Ia = Ia << 5
    Ia = Ia + Aa
    if Sa[Ia] = 0 then goto fb_next
    for Dd = 0 to 2
      H2 = Nbr(H, Dd)
      if H2 = 255 then goto fb_dir
      W = Mh[H2]
      Ca = W & 31
      Cb = W >> 5
      if Ca = 0 then goto fb_dir
      if Cb = Ab then goto fb_dir
      if Cb = 0 then goto fb_dir
      Ib = Cb - 1
      Ib = Ib << 5
      Ib = Ib + Ca
      if Sa[Ib] = 0 then goto fb_dir
      if Bp < 48 then
        V = Bp << 1
        if Ab = 1 then
          BtSet(V, Aa)
          inc V
          BtSet(V, Ca)
        else
          BtSet(V, Ca)
          inc V
          BtSet(V, Aa)
        end if
        inc Bp
      end if
fb_dir:
    next
fb_next:
  next
  return
end sub

' VGet(O), VSet(O, V): a byte kept in VRAM at spr_pat + O
function VGet(u16 Go) as u8
  vpeek vram.spr_pat + Go into V
  return V

sub VSet(u16 So, u8 Sv2):
  vpoke vram.spr_pat + So, Sv2
  return
end sub

' BtSet(I, V), BtGet(I): the battle list in VRAM
sub BtSet(u8 Bi, u8 Bv):
  W16 = Bi + 512
  vpoke vram.spr_pat + W16, Bv
  return
end sub

function BtGet(u8 Bi) as u8
  W16 = Bi + 512
  vpeek vram.spr_pat + W16 into V
  return V

' Battle: the battles, each army's Fg the number it is in
sub Battle:
  FindBattles
  ClearFlags
  CountBattles
  return
end sub

sub CountBattles:
  if Bp = 0 then return
  for K = 1 to Bp
    Qd = K - 1
    Qd = Qd << 1
    Ia = BtGet(Qd)
    inc Qd
    Ib = BtGet(Qd) + 32
    W = Fg[Ia]
    if W < 255 then Fg[Ia] = W + 1
    W = Fg[Ib]
    if W < 255 then Fg[Ib] = W + 1
  next
  return
end sub

' Reveille (lines 1900-2050): side Pn's lost armies leave the list, its
' disrupted bots come back, then the battles (an army in one cannot move)
sub Reveille:
rv_again:
  J = 1
rv_scan:
  if J >= Nx[Pn] then goto rv_done
  Ia = Pn << 5
  Ia = Ia + J
  if Sa[Ia] > 0 then
    inc J
    goto rv_scan
  end if
  ' the army is gone: off the map, the later ones move down
  H = Po[Ia]
  W = Mh[H]
  V = W & 31
  N = Pn + 1
  Aa = W >> 5
  if V = J then
    if Aa = N then Mh[H] = W & 224
  end if
  K = J
rv_shift:
  N = Nx[Pn] - 1
  if K >= N then goto rv_last
  Ia = Pn << 5
  Ia = Ia + K
  Ib = Ia + 1
  Sa[Ia] = Sa[Ib]
  Ij[Ia] = Ij[Ib]
  Dn[Ia] = Dn[Ib]
  Vo = Ib + 896
  V = VGet(Vo)
  Vo = Ia + 896
  VSet(Vo, V)
  Po[Ia] = Po[Ib]
  Fg[Ia] = Fg[Ib]
  H = Po[Ia]
  W = Mh[H] & 224
  Mh[H] = W + K
  inc K
  goto rv_shift
rv_last:
  Ia = Pn << 5
  Ia = Ia + K
  Sa[Ia] = 0
  Ij[Ia] = 0
  Dn[Ia] = 0
  Vo = Ia + 896
  VSet(Vo, 0)
  Po[Ia] = 0
  Fg[Ia] = 0
  N = Nx[Pn] - 1
  Nx[Pn] = N
  goto rv_again
rv_done:
  ' the disrupted come back
  N = Nx[Pn] - 1
  if N > 0 then
    for J = 1 to 31
      if J <= N then
        Ia = Pn << 5
        Ia = Ia + J
        W16 = Sa[Ia] + Dn[Ia]
        if W16 > 255 then W16 = 255
        Sa[Ia] = W16
        Vo = Ia + 896
        V = VGet(Vo)
        Dn[Ia] = V
        VSet(Vo, 0)
      end if
    next
  end if
  Battle
  return
end sub

' Take(I, C): army I loses C bots (never more than it has: a change
' from the listing, which let strengths go below zero); Cs the bots taken
sub Take(u8 Ti, u8 Tc):
  Cs = Tc
  if Cs > Sa[Ti] then Cs = Sa[Ti]
  Sa[Ti] = Sa[Ti] - Cs
  return
end sub

' AddCap(V, C): V + C, at most 255
function AddCap(u8 Av, u8 Ac) as u8
  W16 = Av + Ac
  if W16 > 255 then W16 = 255
  V = W16
  return V

' Resolve (lines 2600-2800): every battle at once, from the strengths
' before it: each army's share ct = INT(strength / battles) + 1 hits the
' other with INT(ct/48)+1 vaporized, Aa (or Ab) times INT(ct/48)+1
' injured, Aa (or Ab) times INT(ct/32)+1 disrupted
sub Resolve:
  if Bp = 0 then return
  for J = 0 to 63
    W16 = J + 768
    vpoke vram.spr_pat + W16, Sa[J]
  next
  for N = 1 to Bp
    Qd = N - 1
    Qd = Qd << 1
    Ia = BtGet(Qd)
    inc Qd
    Ib = BtGet(Qd) + 32
    BattleShow
    ' the shares
    Qa = Share(Ia)
    Qb = Share(Ib)
    ' vaporized
    Split
    V = Qb / 48
    V = V + 1
    Take(Ia, V)
    V = Qa / 48
    V = V + 1
    Take(Ib, V)
    ' injured
    Split
    V = Qb / 48
    V = V + 1
    V = V * Aa
    Take(Ia, V)
    Ij[Ia] = AddCap(Ij[Ia], Cs)
    V = Qa / 48
    V = V + 1
    V = V * Ab
    Take(Ib, V)
    Ij[Ib] = AddCap(Ij[Ib], Cs)
    ' disrupted
    Split
    V = Qb >> 5
    V = V + 1
    V = V * Aa
    Take(Ia, V)
    Vo = Ia + 896
    V = VGet(Vo)
    V = AddCap(V, Cs)
    VSet(Vo, V)
    V = Qa >> 5
    V = V + 1
    V = V * Ab
    Take(Ib, V)
    Vo = Ib + 896
    V = VGet(Vo)
    V = AddCap(V, Cs)
    VSet(Vo, V)
    H2 = Po[Ib]
    H = Po[Ia]
    DrawHex(H)
    H = H2
    DrawHex(H)
  next
  HideCursor
  return
end sub

' Share(I): INT(strength before the round / battles) + 1, at most 255
function Share(u8 Si) as u8
  W16 = Si + 768
  vpeek vram.spr_pat + W16 into V
  W16 = V
  V = Fg[Si]
  if V = 0 then V = 1
  W16 = W16 / V
  W16 = W16 + 1
  if W16 > 255 then W16 = 255
  V = W16
  return V

' QAdd(Q, C): C more bots in queue slot Q, the excess over 255 spills
' into the next slot (and stops at 255 there)
sub QAdd(u8 Qq, u8 Qc):
  Vo = Qq + 1024
  V = VGet(Vo)
  W16 = V + Qc
  if W16 > 255 then
    W16 = W16 - 255
    VSet(Vo, 255)
    inc Vo
    V = VGet(Vo)
    W16 = W16 + V
    if W16 > 255 then W16 = 255
  end if
  V = W16
  VSet(Vo, V)
  return
end sub

' Prisoners (lines 2200-2320): a destroyed army's disrupted bots go to
' the enemy's queue in two turns, its injured in six (reprogrammed); an
' army out of battle sends its injured home, back in four
sub Prisoners:
  for Sd = 0 to 1
    Od = Sd ^ 1
    N = Nx[Sd] - 1
    if N = 0 then goto pr_side
    for J = 1 to 31
      if J > N then goto pr_army
      Ia = Sd << 5
      Ia = Ia + J
      if Sa[Ia] > 0 then goto pr_home
      Vo = Ia + 896
      V = VGet(Vo)
      W16 = Dn[Ia] + V
      if W16 > 255 then W16 = 255
      V = W16
      Qa = Od * 21
      Qa = Qa + 2
      QAdd(Qa, V)
      Qa = Qa + 4
      V = Ij[Ia]
      QAdd(Qa, V)
      H = Po[Ia]
      W = Mh[H]
      V = W & 31
      Aa = W >> 5
      Ab = Sd + 1
      if V = J then
        if Aa = Ab then Mh[H] = W & 224
      end if
      Ij[Ia] = 0
      Dn[Ia] = 0
      Vo = Ia + 896
      VSet(Vo, 0)
      Po[Ia] = 0
      Fg[Ia] = 0
pr_home:
      if Fg[Ia] > 0 then goto pr_army
      Qa = Sd * 21
      Qa = Qa + 4
      V = Ij[Ia]
      QAdd(Qa, V)
      Ij[Ia] = 0
pr_army:
    next
pr_side:
  next
  return
end sub

' Reinforce (lines 2900-3060): a bot per hex owned joins side Pn's queue
' next turn; then the other side's queue moves on: its first slot enters
' at its corner as a new army (unless the corner is occupied: then the
' queue waits; or owned by the enemy: then this turn's and next turn's
' bots are lost)
sub Reinforce:
  Nb = 0
  V = Pn + 1
  for H = 0 to 80
    W = Mh[H] >> 5
    if W = V then inc Nb
  next
  Qa = Pn * 21
  Qa = Qa + 1
  QAdd(Qa, Nb)
  Od = Pn ^ 1
  H = Pn << 3
  H = H + 36
  W = Mh[H]
  V = W & 31
  if V > 0 then return
  Qa = Od * 21
  V = W >> 5
  W = Pn + 1
  if V = W then
    Vo = Qa + 1024
    VSet(Vo, 0)
    inc Vo
    VSet(Vo, 0)
    goto rf_shift
  end if
  J = Nx[Od]
  if J > 31 then return
  Vo = Qa + 1024
  V = VGet(Vo)
  if V = 0 then goto rf_shift
  Nx[Od] = J + 1
  W = Od + 1
  W = W << 5
  Mh[H] = W + J
  Ia = Od << 5
  Ia = Ia + J
  Sa[Ia] = V
  Ij[Ia] = 0
  Dn[Ia] = 0
  Vo = Ia + 896
  VSet(Vo, 0)
  Po[Ia] = H
  Fg[Ia] = 0
  play sound SndArrive
rf_shift:
  for K = 0 to 19
    Vo = Qa + K
    Vo = Vo + 1025
    V = VGet(Vo)
    dec Vo
    VSet(Vo, V)
  next
  Vo = Qa + 1044
  VSet(Vo, 0)
  return
end sub

' Outcome (lines 3400-3640): the scenario's goal, side 0 checked first
sub Outcome:
  Winner = 0
  if Gn = 1 then
    H = CityHex[1]
    V = Mh[H] >> 5
    if V = 1 then Winner = 1
  end if
  if Gn = 2 then
    H = CityHex[2]
    V = Mh[H] >> 5
    if V = 1 then Winner = 1
  end if
  if Gn <= 2 then
    if Winner = 0 then
      H = CityHex[0]
      V = Mh[H] >> 5
      if V = 2 then Winner = 2
    end if
    return
  end if
  CountGoal
  if Gn = 3 then L = 8
  if Gn = 4 then L = 6
  if Gn = 5 then L = 40
  if Qa >= L then
    Winner = 1
    return
  end if
  if Qb >= L then Winner = 2
  return
end sub

' CountGoal: Qa, Qb what side 0 and side 1 hold toward the goal (cities
' owned; cities owned with an army there, out of battle; hexes owned)
sub CountGoal:
  Qa = 0
  Qb = 0
  if Gn = 5 then
    for H = 0 to 80
      V = Mh[H] >> 5
      if V = 1 then inc Qa
      if V = 2 then inc Qb
    next
    return
  end if
  for K = 0 to 11
    H = CityHex[K]
    W = Mh[H]
    V = W >> 5
    Aa = W & 31
    if Gn = 4 then
      if V > 0 then
        if Aa = 0 then
          V = 0
        else
          Ia = V - 1
          Ia = Ia << 5
          Ia = Ia + Aa
          if Fg[Ia] > 0 then V = 0
        end if
      end if
    end if
    if V = 1 then inc Qa
    if V = 2 then inc Qb
  next
  return
end sub

' Act(H): the button on hex H, for side Pn (lines 1100-1420); ActR the
' result: 1 picked, 2 put back, 3 stopped, 4 moved, 5 moved and done,
' 6 merged, 9 refused
sub Act(u8 Xh):
  ActH = Xh
  ActR = 9
  W = Mh[Xh]
  Aa = W & 31
  Ab = W >> 5
  N = Pn + 1
  if Pk = 0 then
    if Ab <> N then goto act_end
    if Aa = 0 then goto act_end
    Ia = Pn << 5
    Ia = Ia + Aa
    if Fg[Ia] > 0 then goto act_end
    Pk = 1
    An = Aa
    Ct = Xh
    Mv = 0
    ActR = 1
    goto act_end
  end if
  Ia = Pn << 5
  Ia = Ia + An
  if Xh = Ct then
    if Mv = 0 then
      Pk = 0
      ActR = 2
    else
      Fg[Ia] = 1
      Pk = 0
      ActR = 3
    end if
    goto act_end
  end if
  ' an enemy army there: no
  if Aa > 0 then
    if Ab <> N then goto act_end
  end if
  V = Adjacent(Ct, Xh)
  if V = 0 then goto act_end
  if Aa > 0 then
    ' a merge: one of the two under 32 (and the sum at most 255)
    Mg = Aa
    Ib = Pn << 5
    Ib = Ib + Aa
    if Sa[Ib] > 31 then
      if Sa[Ia] > 31 then goto act_end
    end if
    W16 = Sa[Ib] + Sa[Ia]
    if W16 > 255 then goto act_end
    Sa[Ib] = W16
    Ij[Ib] = AddCap(Ij[Ib], Ij[Ia])
    Dn[Ib] = AddCap(Dn[Ib], Dn[Ia])
    Vo = Ia + 896
    V = VGet(Vo)
    Ff = V
    Vo = Ib + 896
    V = VGet(Vo)
    V = AddCap(V, Ff)
    VSet(Vo, V)
    Sa[Ia] = 0
    Ij[Ia] = 0
    Dn[Ia] = 0
    Vo = Ia + 896
    VSet(Vo, 0)
    Fg[Ib] = 1
    W = Mh[Ct] & 224
    Mh[Ct] = W
    H = Ct
    DrawHex(H)
    Ct = Xh
    An = Mg
    Pk = 0
    ActR = 6
    H = Xh
    DrawHex(H)
    goto act_end
  end if
  ' a step: one point, one more into a hex not ours
  inc Mv
  if Ab <> N then inc Mv
  W = Mh[Ct] & 224
  Mh[Ct] = W
  H = Ct
  DrawHex(H)
  W = N << 5
  Mh[Xh] = W + An
  Po[Ia] = Xh
  Ct = Xh
  ' a zone of control: an enemy army next to it ends the move
  Od = 2 - Pn
  for Dd = 0 to 5
    H2 = Nbr(Xh, Dd)
    if H2 < 255 then
      W = Mh[H2]
      V = W >> 5
      if V = Od then
        V = W & 31
        if V > 0 then Mv = 3
      end if
    end if
  next
  ActR = 4
  if Mv >= 3 then
    Fg[Ia] = 1
    Pk = 0
    ActR = 5
  end if
  H = Xh
  DrawHex(H)
act_end:
  inc ActN
  Frame1
  return
end sub

' CanMove: V 1 if side Pn has an army free to move
sub CanMove:
  V = 0
  N = Nx[Pn] - 1
  if N = 0 then return
  for K = 1 to 31
    if K <= N then
      Ia = Pn << 5
      Ia = Ia + K
      if Sa[Ia] > 0 then
        if Fg[Ia] = 0 then V = 1
      end if
    end if
  next
  return
end sub

' Phase(K): a phase done (for the tests), and a frame
sub Phase(u8 Pk2):
  PhK = Pk2
  inc PhN
  Frame1
  return
end sub

' ---------------------------------------------------------------------
' a turn

sub TakeTurn:
  Pk = 0
  V = 0
  if Mode = 2 then V = 1
  if Mode = 0 then
    if Pn = 0 then V = 1
  end if
  if V = 1 then
    AiTurn
    return
  end if
  ' a human: the cursor on the first army free to move
  Cur = 40
  for K = 31 to 1 step -1
    Ia = Pn << 5
    Ia = Ia + K
    N = Nx[Pn]
    if K < N then
      if Sa[Ia] > 0 then
        if Fg[Ia] = 0 then Cur = Po[Ia]
      end if
    end if
  next
  ShowMsg(1)
  ShowCursor
  ShowInfo
  WasBtn = 1
  WasB2 = 1
  Rep = 0
tt_loop:
  InTurn = 1
  Frame1
  ReadPad
  ' the stick
  V = 0
  if Up1 = 1 then V = 1
  if Dn1 = 1 then V = 2
  W = 0
  if Lf1 = 1 then W = 1
  if Rt1 = 1 then W = 2
  V = V * 3
  V = V + W
  if V = 0 then
    Rep = 0
  else
    if Rep = 0 then
      CurMove(V)
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        CurMove(V)
        Rep = 7
      end if
    end if
  end if
  if Press = 1 then
    H = Cur
    Act(H)
    if ActR = 9 then
      play sound SndBuzz
    elseif ActR = 1 then
      play sound SndPick
    elseif ActR = 6 then
      play sound SndMerge
    elseif ActR = 2 then
      play sound SndDrop
    elseif ActR = 3 then
      play sound SndDrop
    else
      play sound SndStep
    end if
    ShowCursor
    ShowInfo
    CanMove
    if V = 0 then
      if Pk = 0 then return
    end if
  end if
  if Press2 = 1 then return
  goto tt_loop
end sub

' CurMove(D): the stick (D = 3 * vertical + horizontal: 1 left, 2 right,
' 3 up, 4 up-left, 5 up-right, 6 down, 7 down-left, 8 down-right)
sub CurMove(u8 Md):
  Qd = 255
  if Md = 1 then Qd = 4
  if Md = 2 then Qd = 1
  if Md = 4 then Qd = 5
  if Md = 5 then Qd = 0
  if Md = 7 then Qd = 3
  if Md = 8 then Qd = 2
  if Md = 3 then
    if Zig = 0 then
      Qd = 0
    else
      Qd = 5
    end if
    Zig = Zig ^ 1
  end if
  if Md = 6 then
    if Zig = 0 then
      Qd = 3
    else
      Qd = 2
    end if
    Zig = Zig ^ 1
  end if
  if Qd = 255 then return
  W = Nbr(Cur, Qd)
  if W = 255 then
    ' straight up or down at an edge: try the other diagonal
    if Md = 3 then Qd = Qd ^ 5
    if Md = 6 then Qd = Qd ^ 1
    W = Nbr(Cur, Qd)
  end if
  if W = 255 then return
  Cur = W
  ShowCursor
  ShowInfo
  return
end sub

' AiTurn: the computer moves side Pn's armies one after another
sub AiTurn:
  ShowMsg(2)
  for Ai = 1 to 31
    N = Nx[Pn]
    if Ai >= N then goto ai_army
    Ia = Pn << 5
    Ia = Ia + Ai
    if Sa[Ia] = 0 then goto ai_army
    if Fg[Ia] > 0 then goto ai_army
    H = Po[Ia]
    Cur = H
    ShowCursor
    ShowInfo
    Wait8
    Act(H)
    if ActR <> 1 then goto ai_army
    play sound SndPick
    AiTarget
ai_step:
    ' the best next hex, or stay
    Ia = Pn << 5
    Ia = Ia + An
    H = Ct
    Bs = Score(H)
    Bh = Ct
    for Ee = 0 to 5
      H2 = Nbr(Ct, Ee)
      if H2 < 255 then
        V = Legal(H2)
        if V = 1 then
          H = H2
          Sc = Score(H)
          if Sc > Bs then
            Bs = Sc
            Bh = H2
          end if
        end if
      end if
    next
    Cur = Bh
    ShowCursor
    Wait8
    H = Bh
    Act(H)
    if ActR = 9 then
      H = Ct
      Act(H)
    end if
    if ActR = 6 then
      play sound SndMerge
    elseif ActR >= 4 then
      play sound SndStep
    else
      play sound SndDrop
    end if
    ShowInfo
    if Pk = 1 then goto ai_step
ai_army:
    if Mode = 2 then
      ReadAny
      if Press = 1 then
        Winner = 99
        return
      end if
    end if
  next
  return
end sub

' Legal(H): 1 if the army picked may go to H (a step, or a merge it
' would like: both armies small)
function Legal(u8 Lh) as u8
  W = Mh[Lh]
  Aa = W & 31
  Ab = W >> 5
  N = Pn + 1
  if Aa = 0 then return 1
  if Ab <> N then return 0
  Ib = Pn << 5
  Ib = Ib + Aa
  if Sa[Ib] > 23 then
    if Sa[Ia] > 23 then return 0
  end if
  if Sa[Ib] > 31 then
    if Sa[Ia] > 31 then return 0
  end if
  W16 = Sa[Ib] + Sa[Ia]
  if W16 > 255 then return 0
  return 1

' AiTarget: Tg, where the army picked heads
sub AiTarget:
  Ia = Pn << 5
  Ia = Ia + An
  if Gn <= 2 then
    ' the enemy's capital (side 0 wants city 2 or 3, side 1 city 1)
    if Pn = 1 then
      Tg = CityHex[0]
    else
      Tg = CityHex[Gn]
    end if
    ' unless an enemy army is near our own capital: the nearest army
    ' of ours goes home
    if Pn = 1 then
      H2 = CityHex[Gn]
    else
      H2 = CityHex[0]
    end if
    Ff = 0
    for H = 0 to 80
      W = Mh[H]
      V = W >> 5
      Aa = W & 31
      if Aa > 0 then
        if V = 2 - Pn then
          V = Dist(H, H2)
          if V <= 2 then Ff = 1
        end if
      end if
    next
    if Ff = 1 then
      ' are we the nearest?
      Dd = Dist(Ct, H2)
      Ee = 1
      N = Nx[Pn] - 1
      for K = 1 to 31
        if K <= N then
          Ib = Pn << 5
          Ib = Ib + K
          if Sa[Ib] > 0 then
            H = Po[Ib]
            V = Dist(H, H2)
            if V < Dd then Ee = 0
          end if
        end if
      next
      if Ee = 1 then Tg = H2
    end if
    return
  end if
  ' cities (scenarios 3 and 4) or hexes (5): the nearest one not ours
  Bs = 255
  Tg = Ct
  N = Pn + 1
  for H = 0 to 80
    T1 = HT[H]
    B1 = HB[H]
    V = Valid(T1, B1)
    if V = 1 then
      W = Mh[H]
      V = W >> 5
      Ff = 0
      if V <> N then Ff = 1
      if Gn = 4 then
        if V = N then
          V = W & 31
          if V = 0 then Ff = 1
        end if
      end if
      if Gn < 5 then
        V = IsCity(H)
        if V = 0 then Ff = 0
      end if
      if Ff = 1 then
        V = Dist(Ct, H)
        if V < Bs then
          Bs = V
          Tg = H
        end if
      end if
    end if
  next
  return
end sub

' Score(H): how much the army picked (index Ia) likes hex H: near its
' goal, new ground, cities, and away from stronger enemies (toward
' weaker ones)
function Score(u8 Sh) as u8
  V = Dist(Sh, Tg)
  W16 = 180
  if V = 0 then W16 = 210
  V = V * 12
  if V > 170 then V = 170
  W16 = W16 - V
  W = Mh[Sh]
  V = W >> 5
  N = Pn + 1
  if V <> N then W16 = W16 + 4
  Ff = IsCity(Sh)
  if Ff > 0 then
    if V <> N then W16 = W16 + 6
  end if
  Od = 2 - Pn
  for Dd = 0 to 5
    H = Nbr(Sh, Dd)
    if H < 255 then
      W = Mh[H]
      V = W >> 5
      if V = Od then
        V = W & 31
        if V > 0 then
          Ib = 1 - Pn
          Ib = Ib << 5
          Ib = Ib + V
          if Sa[Ib] > Sa[Ia] then
            if W16 > 40 then
              W16 = W16 - 40
            else
              W16 = 0
            end if
          else
            W16 = W16 + 5
          end if
        end if
      end if
    end if
  next
  if W16 > 250 then W16 = 250
  V = W16
  return V

sub Wait8:
  for Tm = 1 to 8
    Frame1
  next
  return
end sub

' ---------------------------------------------------------------------
' the screen

' DrawHex(H): hex H as its owner, icon and army show it
sub DrawHex(u8 Dh):
  T1 = HT[Dh]
  B1 = HB[Dh]
  V = Valid(T1, B1)
  if V = 0 then return
  W = Mh[Dh]
  Aa = W & 31
  Ab = W >> 5
  ' where: column 10 + T - B, row 26 - 2 (T + B)
  X = HT[Dh] + 10
  X = X - HB[Dh]
  Y = HT[Dh] + HB[Dh]
  Y = Y << 1
  Y = 26 - Y
  Ff = IsCity(Dh)
  if Ab = 0 then
    V = 128 + Ff
    put char V at X,Y
    V = V + 3
    inc X
    put char V at X,Y
    inc Y
    put char 135 at X,Y
    dec X
    put char 134 at X,Y
    return
  end if
  ' an owner's hexes: base 136 or 180
  Ca = Ab - 1
  Ca = Ca * 44
  Ca = Ca + 136
  Cb = Ff
  Dg1 = 16
  Dg2 = 16
  if Aa > 0 then
    Ib = Ab - 1
    Ib = Ib << 5
    Ib = Ib + Aa
    Cb = 3
    if Fg[Ib] > 0 then Cb = 4
    V = Sa[Ib]
    Dg1 = V >> 4
    Dg2 = V & 15
  end if
  V = Ca + Cb
  put char V at X,Y
  V = V + 5
  inc X
  put char V at X,Y
  inc Y
  V = Ca + 27
  V = V + Dg2
  put char V at X,Y
  dec X
  V = Ca + 10
  V = V + Dg1
  put char V at X,Y
  return
end sub

sub DrawAll:
  for H2 = 0 to 80
    H = H2
    DrawHex(H)
  next
  ShowQueues
  ShowGoal
  return
end sub

' DrawBoard: the whole game screen
sub DrawBoard:
  NewScreen
  for Y = 1 to 19
    put char TRule at 20,Y
  next
  DrawAll
  return
end sub

' ShowTurn: whose turn, on the panel
sub ShowTurn:
  print at 21,1, "TURN"
  NumU = Turn
  print at 26,1, digits$(NumU, 3)
  if Pn = 1 then
    put char TChipb at 21,2
    print at 22,2, "BLUE   "
  else
    put char TChipr at 21,2
    print at 22,2, "RED    "
  end if
  return
end sub

' ShowInfo: what is under the cursor (an army's numbers in hex and
' decimal), and the moves left of the army picked
sub ShowInfo:
  print at 21,3, "         "
  if Pk = 1 then
    print at 21,3, "MOVES"
    V = 3 - Mv
    if Mv > 3 then V = 0
    V = V + 48
    put char V at 27,3
  end if
  W = Mh[Cur]
  Aa = W & 31
  Ab = W >> 5
  for Y = 5 to 10
    print at 21,Y, "         "
  next
  if Aa = 0 then
    V = IsCity(Cur)
    if V = 1 then print at 21,5, "CITY"
    if V = 2 then print at 21,5, "CAPITAL"
    if V = 0 then print at 21,5, "HEX"
    T1 = HT[Cur] + 48
    B1 = HB[Cur] + 48
    put char T1 at 21,6
    put char 46 at 22,6
    put char B1 at 23,6
    return
  end if
  Ia = Ab - 1
  Ia = Ia << 5
  Ia = Ia + Aa
  print at 21,5, "ARMY"
  NumU = Aa
  print at 26,5, digits$(NumU, 2)
  print at 21,6, "   HX DEC"
  print at 21,7, "ST"
  V = Sa[Ia]
  Numbers(7, V)
  print at 21,8, "IN"
  V = Ij[Ia]
  Numbers(8, V)
  print at 21,9, "D1"
  V = Dn[Ia]
  Numbers(9, V)
  print at 21,10, "D2"
  Vo = Ia + 896
  V = VGet(Vo)
  Numbers(10, V)
  return
end sub

' Numbers(Y, V): V in hex at column 24 and in decimal at 27
sub Numbers(u8 Ny, u8 Nv):
  PutHex(24, Ny, Nv)
  NumU = Nv
  print at 27,Ny, digits$(NumU, 3)
  return
end sub

sub PutHex(u8 Px, u8 Py, u8 Pv):
  V = Pv >> 4
  V = HexCh[V]
  put char V at Px,Py
  V = Pv & 15
  V = HexCh[V]
  inc Px
  put char V at Px,Py
  return
end sub

' ShowQueues: the next six turns of each side's reinforcements, in hex
sub ShowQueues:
  put char TChipb at 21,12
  print at 22,12, "QUEUE"
  put char TChipr at 21,15
  print at 22,15, "QUEUE"
  for K = 0 to 5
    X = K % 3
    X = X * 3
    X = X + 21
    Y = K / 3
    Y = Y + 13
    Vo = K + 1045
    V = VGet(Vo)
    PutHex(X, Y, V)
    Y = Y + 3
    Vo = K + 1024
    V = VGet(Vo)
    PutHex(X, Y, V)
  next
  return
end sub

' ShowGoal: the scenario and how far each side is
sub ShowGoal:
  if Gn = 1 then print at 21,18, "CAP FAR"
  if Gn = 2 then print at 21,18, "CAP NEAR"
  if Gn = 3 then print at 21,18, "8 CITIES"
  if Gn = 4 then print at 21,18, "6 CTRL"
  if Gn = 5 then print at 21,18, "40 HEXES"
  if Gn >= 3 then
    CountGoal
    put char TChipb at 21,19
    NumU = Qb
    print at 22,19, digits$(NumU, 2)
    put char TChipr at 25,19
    NumU = Qa
    print at 26,19, digits$(NumU, 2)
  end if
  return
end sub

sub ShowGoalWon:
  if Gn = 1 then print at 3,21, "THE CAPITAL IS TAKEN"
  if Gn = 2 then print at 3,21, "THE CAPITAL IS TAKEN"
  if Gn = 3 then print at 3,21, "8 OF 12 CITIES OCCUPIED"
  if Gn = 4 then print at 3,21, "6 OF 12 CITIES CONTROLLED"
  if Gn = 5 then print at 3,21, "40 OF 61 HEXES OCCUPIED"
  return
end sub

' ShowMsg(M): the bottom lines (0 the battles, 1 a player, 2 computer)
sub ShowMsg(u8 Mm2):
  print at 2,20, "                            "
  print at 2,21, "                            "
  print at 2,22, "                            "
  if Mm2 = 0 then
    print at 2,21, "BATTLES..."
  end if
  if Mm2 = 1 then
    if Pn = 1 then
      print at 2,20, "BLUE: JOYSTICK 1"
    else
      print at 2,20, "RED: JOYSTICK 2"
    end if
    print at 2,21, "FIRE: PICK UP, MOVE, STOP"
    print at 2,22, "2ND BUTTON: END TURN"
  end if
  if Mm2 = 2 then
    if Pn = 1 then
      print at 2,21, "BLUE IS THINKING..."
    else
      print at 2,21, "RED IS THINKING..."
    end if
    if Mode = 2 then print at 2,22, "DEMO: A BUTTON FOR THE TITLE"
  end if
  return
end sub

' ShowCursor: sprite 0 the cursor, sprite 1 the army picked
sub ShowCursor:
  HexXY(Cur)
  set sprite 0 to Y,X,SCursor,15
  if Pk = 1 then
    HexXY(Ct)
    set sprite 1 to Y,X,SCursor,11
  else
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub HideCursor:
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  set sprite 2 to 192,0,0,0
  update sprites
  return
end sub

' HexXY(H): X, Y the pixel place of hex H for a sprite
sub HexXY(u8 Xh):
  X = HT[Xh] + 10
  X = X - HB[Xh]
  X = X << 3
  Y = HT[Xh] + HB[Xh]
  Y = Y << 1
  Y = 26 - Y
  Y = Y << 3
  dec Y
  return
end sub

' BattleShow: laser bursts flash over the two armies of battle Ia/Ib
sub BattleShow:
  play sound SndZap
  for Tm = 1 to 8
    V = Tm & 1
    if V = 0 then
      H = Po[Ia]
    else
      H = Po[Ib]
    end if
    HexXY(H)
    W = Tm & 3
    V = 11
    if W = 1 then V = 15
    if W = 2 then V = 9
    set sprite 2 to Y,X,SBurst,V
    update sprites
    Frame1
  next
  play sound SndBoom
  set sprite 2 to 192,0,0,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: the stick and buttons of the side to move (two players: blue
' joystick 1, red joystick 2; one player: either)
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Bt2 = 0
  V = 1
  W = 1
  if Mode = 1 then
    if Pn = 1 then W = 0
    if Pn = 0 then V = 0
  end if
  if V = 1 then
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).button1 then Btn = 1
    if joypad(1).button2 then Bt2 = 1
  end if
  if W = 1 then
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).button1 then Btn = 1
    if joypad(2).button2 then Bt2 = 1
  end if
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Bt2 = 1 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = Bt2
  return
end sub

' ReadAny: either joystick (menus, the title)
sub ReadAny:
  Sm = Mode
  Mode = 0
  ReadPad
  Mode = Sm
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a small honeycomb, a joystick menu
sub TitlePage:
  NewScreen
  for J = 0 to 80
    Mh[J] = 0
  next
  Gn = 1
  ' a few hexes of colour round the title
  Mh[60] = 64
  Mh[52] = 32
  Mh[44] = 64
  Mh[68] = 32
  for H2 = 36 to 76
    H = H2
    V = HB[H]
    if V >= 4 then DrawHex(H)
  next
  print at 22,4, "HEX WAR"
  print at 21,6, "ROBOTS"
  print at 21,7, "ON A FAR"
  print at 21,8, "PLANET"
  print at 6,14, "1 PLAYER (YOU ARE BLUE)"
  print at 6,15, "2 PLAYERS"
  print at 6,16, "DEMO (COMPUTER VS ITSELF)"
  print at 6,17, "CREDITS"
  print at 4,20, "BLUE: JOYSTICK 1"
  print at 4,21, "RED: JOYSTICK 2"
  Menu = 0
  ShowMenu(14, 3)
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadAny
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 3 then inc Menu
      end if
      play sound SndStep
      ShowMenu(14, 3)
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  W16 = Tick
  Rs = Rs ^ W16
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = $1D3B
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 3 then CreditsPage
  return
end sub

' ScenarioPage: the five games of the listings
sub ScenarioPage:
  NewScreen
  print at 9,3, "CHOOSE A GAME"
  print at 5,6, "1 CAPTURE CAPITAL (FAR)"
  print at 5,8, "2 CAPTURE CAPITAL (NEAR)"
  print at 5,10, "3 OCCUPY 8 OF 12 CITIES"
  print at 5,12, "4 CONTROL 6 OF 12 CITIES"
  print at 5,14, "5 OCCUPY 40 OF 61 HEXES"
  print at 3,18, "CONTROL: AN ARMY OF YOURS IN"
  print at 3,19, "THE CITY, OUT OF BATTLE"
  Menu = 0
  ShowMenu2
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
sp_loop:
  Frame1
  ReadAny
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 4 then inc Menu
      end if
      play sound SndStep
      ShowMenu2
    end if
  end if
  WasStick = V
  if Press = 0 then goto sp_loop
  Gn = Menu + 1
  return
end sub

sub ShowMenu(u8 My, u8 Mn):
  for J = 0 to 3
    V = My + J
    put char 32 at 4,V
  next
  V = My + Menu
  put char 62 at 4,V
  return
end sub

sub ShowMenu2:
  for J = 0 to 4
    V = J << 1
    V = V + 6
    put char 32 at 3,V
  next
  V = Menu << 1
  V = V + 6
  put char 62 at 3,V
  return
end sub

sub CreditsPage:
  NewScreen
  for X = 3 to 28
    put char TRule at X,2
    put char TRule at X,21
  next
  print at 12,4, "HEX WAR"
  print at 3,6, "BASED ON HEX WAR BY TODD"
  print at 3,7, "HEIMARCK, COMPUTE! JULY 1986"
  print at 3,8, "(C128; VERSIONS BY KEVIN"
  print at 3,9, "MYKYTYN, TIM VICTOR, PATRICK"
  print at 3,10, "PARRISH AND PHILIP NELSON)."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY BIENVENU."
  print at 3,17, "MUSIC: HONEYCOMB MARCH,"
  print at 3,18, "ORE FIELDS"
  print at 8,20, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

' the six directions: T + 1 and B + 1 added (then 1 taken off)
