' FP5 divide truth lab: boundary and sign cases for the current /= path.
u16 UZero = 0
u16 UOne = 1
u16 UTwo = 2
u16 UThree = 3
u16 UFour = 4
u16 UTen = 10
u16 UHundred = 100
u16 U1000 = 1000
i16 SNegOne = -1
i16 SNegTwo = -2
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0
fp5 H = 0
fp5 I = 0
fp5 J = 0

  text screen
  print at 5,0, "FP5 DIVIDE TRUTH LAB"

  A = UHundred
  A /= UFour
  B = UTen
  B /= UOne
  C = UOne
  C /= UTwo
  D = UTwo
  D /= UFour
  E = UTen
  E /= UThree
  F = U1000
  F /= UTen
  G = UTen
  G /= UZero
  H = UTen
  H /= SNegTwo
  I = SNegOne
  I /= SNegOne
  J = UZero
  J /= UThree

  print at 1,4,  "100 / 4"
  print A at 16,4 digits 16
  print at 1,6,  "10 / 1"
  print B at 16,6 digits 16
  print at 1,8,  "1 / 2"
  print C at 16,8 digits 16
  print at 1,10, "2 / 4"
  print D at 16,10 digits 16
  print at 1,12, "10 / 3"
  print E at 16,12 digits 16
  print at 1,14, "1000 / 10"
  print F at 16,14 digits 16
  print at 1,16, "10 / 0"
  print G at 16,16 digits 16
  print at 1,18, "10 / -2"
  print H at 16,18 digits 16
  print at 1,20, "-1 / -1"
  print I at 16,20 digits 16
  print at 1,22, "0 / 3"
  print J at 16,22 digits 16

  print at 1,24, "EXPECT"
  print at 1,25, "25 10 0.5 0.5 3.333 100 0 -5 1 0"
  screen on