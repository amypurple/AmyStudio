i32 Sr[3]
i32 Ty[3]
i32 Ts[3]
i32 Fx = 0
i32 Gt = 0
i32 Pt = 0
i32 Sbf = 0
i32 Lp = 0
i32 Pay = 0
' scratch wide values
i32 Ua = 0
i32 Ub = 0
i32 Uq = 0
i32 Ur = 0
i32 Uf = 0
i32 Uv = 0
i32 Ed = 0
i32 EdMin = 0
i32 EdMax = 0
i32 Pow[10]
u16 Fp[3]
u16 Inn = 0
