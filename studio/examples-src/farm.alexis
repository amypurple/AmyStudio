' yields per acre, fuel gallons per acre, seed bushels*100 per 40 acres
data ByT bytes
  62, 100, 31
end data
data FuT bytes
  50, 85, 60
end data
data SeedT words
  6000, 1336, 6000
end data
' field qualities (x10000) and how they read
data FfT words
  11000, 10300, 10000, 9800, 9000
end data
data FfTxt chars
  "+10%"
  " +3%"
  "  0%"
  " -2%"
  "-10%"
end data
' 2000 * sqrt(units), units 0-99
data SqT words
  0, 2000, 2828, 3464, 4000, 4472, 4899, 5292, 5657, 6000
  6325, 6633, 6928, 7211, 7483, 7746, 8000, 8246, 8485, 8718
  8944, 9165, 9381, 9592, 9798, 10000, 10198, 10392, 10583, 10770
  10954, 11136, 11314, 11489, 11662, 11832, 12000, 12166, 12329, 12490
  12649, 12806, 12961, 13115, 13266, 13416, 13565, 13711, 13856, 14000
  14142, 14283, 14422, 14560, 14697, 14832, 14967, 15100, 15232, 15362
  15492, 15620, 15748, 15875, 16000, 16125, 16248, 16371, 16492, 16613
  16733, 16852, 16971, 17088, 17205, 17321, 17436, 17550, 17664, 17776
  17889, 18000, 18111, 18221, 18330, 18439, 18547, 18655, 18762, 18868
  18974, 19079, 19183, 19287, 19391, 19494, 19596, 19698, 19799, 19900
end data

' --- state (money in cents, prices in 1/10000 dollar)
i32 Ba = 0
i32 Lo = 0
i32 Bs[3]
i32 Ga = 0
i32 Ce = 0
i32 IsC = 0
i32 HsC = 0
i32 Ov = 0
i32 Hv = 0
i32 Bp[3]
