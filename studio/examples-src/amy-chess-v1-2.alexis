  6,6,6,6,6,6,6,6,
  4,4,4,4,4,4,4,4,
  2,2,2,2,2,2,2,2,
  0,0,0,0,0,0,0,0,
  -2,-2,-2,-2,-2,-2,-2,-2
end data
