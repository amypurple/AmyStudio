picture WarriorPicture:
  pattern from "@project/warrior.pattern.zx0" codec zx0
  color from "@project/warrior.color.zx0" codec zx0
end picture

picture BarbarianPicture:
  pattern from "@project/barbarian.pattern.zx0" codec zx0
  color from "@project/barbarian.color.zx0" codec zx0
end picture

' Two-picture compressed bitmap slideshow.
slideshow_loop:
  show picture WarriorPicture
  wait 250 frames
  show picture BarbarianPicture
  wait 250 frames
  goto slideshow_loop