asm {
; The slope engine from Avalanche Run (games/ar), shared here: the ground
; rows' colour bands (ArStripes, colours ColA and ColB), their edges
; (ArEdges), the objects' sprites (ArProject), and helpers.
; ArMul: Mz = Mx * My (the low 16 bits, right for signed and unsigned),
; by shift and add: about 700 cycles whatever the numbers
ArMul:
    ld de,(AMY_UVAR_Mx)
    ld bc,(AMY_UVAR_My)
    ld hl,0
    ld a,16
ArMulLoop:
    add hl,hl
    sla c
    rl b
    jr nc,ArMulSkip
    add hl,de
ArMulSkip:
    dec a
    jr nz,ArMulLoop
    ld (AMY_UVAR_Mz),hl
    ret

; ---------------------------------------------------------------------------
; ArStripes: the colours of ground rows 8-23 for the distance Pos. Each
; pixel line adds its depth to Pos and is grey when its band bits are both
; set (kind 0 never, 1 bits 7 and 6, 2 bits 8 and 7, 3 bits 6 and 5);
; LineTab holds depth
; and kind, three bytes a line. A row's eight colours are kept in Cache:
; only rows whose colours changed go to VRAM, to the colours of the row's
; four tiles, writes spaced at 30 cycles or more (safe with the display on).
ArStripes:
    ; the far rows (8-15) on every other call, unless StAll is set
    ld a,(AMY_UVAR_StAll)
    or a
    jr nz,ArStFrom8
    ld a,(AMY_UVAR_StOdd)
    xor 1
    ld (AMY_UVAR_StOdd),a
    jr nz,ArStFrom8
    ld a,16
    ld hl,AMY_UDATA_LineTab+192
    exx
    ld hl,AMY_UVAR_Cache+64
    exx
    jr ArStGo
ArStFrom8:
    ld a,9
    ld hl,AMY_UDATA_LineTab+24
    exx
    ld hl,AMY_UVAR_Cache+8
    exx
ArStGo:
    ld (AMY_UVAR_Rw),a
    ld bc,(AMY_UVAR_Pos)
ArStRow:
    ld de,AMY_UVAR_Lb
    exx
    ld (AMY_UVAR_StC),hl
    exx
    ld a,8
    ld (AMY_UVAR_StN),a
ArStLine:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,(hl)
    inc hl
    ex de,hl
    add hl,bc
    or a
    jr z,ArStWhite
    dec a
    jr z,ArStK1
    dec a
    jr z,ArStK2
    ld a,l
    and $60
    cp $60
    jr ArStTest
ArStK2:
    add hl,hl
    ld a,h
    and 3
    cp 3
    jr ArStTest
ArStK1:
    ld a,l
    and $C0
    cp $C0
ArStTest:
    ld a,(AMY_UVAR_ColA)
    jr nz,ArStPut
    ld a,(AMY_UVAR_ColB)
    jr ArStPut
ArStWhite:
    ld a,(AMY_UVAR_ColA)
ArStPut:
    ex de,hl
    exx
    cp (hl)
    jr z,ArStSame
    ld (hl),a
    ld a,1
    ld (AMY_UVAR_StD),a
ArStSame:
    inc hl
    exx
    ld a,(AMY_UVAR_StN)
    dec a
    ld (AMY_UVAR_StN),a
    jr nz,ArStLine
    ld a,(AMY_UVAR_StD)
    or a
    jr z,ArStNext
    xor a
    ld (AMY_UVAR_StD),a
    push hl
    push bc
    ; the colour address: $2000 + third * $800 + 208 * 8 + (row & 7) * 32
    ld a,(AMY_UVAR_Rw)
    ld c,a
    and 7
    rrca
    rrca
    rrca
    ld l,a
    ld a,c
    srl a
    srl a
    srl a
    add a,a
    add a,a
    add a,a
    add a,$26
    ld h,a
    ld de,$0080
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld c,4
ArStRep:
    ld hl,(AMY_UVAR_StC)
    ld b,8
ArStOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ArStOut
    dec c
    jr nz,ArStRep
    pop bc
    pop hl
ArStNext:
    ld a,(AMY_UVAR_Rw)
    inc a
    ld (AMY_UVAR_Rw),a
    cp 24
    jp nz,ArStRow
    ret

; ArLate: Late = 1 when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
ArLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret

; ArBackdrop: the backdrop (VDP register 7) to colour V, for a flash
ArBackdrop:
    ld a,(AMY_UVAR_V)
    ld c,a
    ld b,7
    jp WRITE_REGISTER

; ArThirds: VDP register 3 = $FF, three colour tables (Amy's tile screen
; shares one between the thirds)
ArThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER

; ArMul8: HL = DE * A (DE signed, A unsigned; the low 16 bits)
ArMul8:
    ld hl,0
    ld b,8
ArM8Loop:
    add hl,hl
    add a,a
    jr nc,ArM8Skip
    add hl,de
ArM8Skip:
    djnz ArM8Loop
    ret

; ArClamp: A = HL kept within 0-256, in half tiles (0-64)
ArClamp:
    bit 7,h
    jr nz,ArClZero
    ld a,h
    or a
    jr z,ArClOk
    ld a,64
    ret
ArClOk:
    ld a,l
    srl a
    srl a
    ret
ArClZero:
    xor a
    ret

; ArEdges: each ground row's forest edges. The middle of the piste on row
; k is 128 + (Cq * KRow[k]) / 128 - (Px * InvRow[k]) / 64 pixels, its edges
; WdR[k] either side. Rows whose edges moved are drawn again (ArDrawRow).
ArEdges:
    ld a,1
    ld (AMY_UVAR_Rk),a
ArEdRow:
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_KRow
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_Cq)
    call ArMul8
    add hl,hl
    ld l,h
    ld a,h
    rla
    sbc a,a
    ld h,a
    ld (AMY_UVAR_EC1),hl
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_InvRow
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_Px)
    call ArMul8
    ld b,6
ArEdShift:
    sra h
    rr l
    djnz ArEdShift
    ex de,hl
    ld hl,(AMY_UVAR_EC1)
    or a
    sbc hl,de
    ld de,128
    add hl,de
    ld (AMY_UVAR_EBase),hl
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_WdR
    add hl,de
    ld e,(hl)
    ld d,0
    ld hl,(AMY_UVAR_EBase)
    or a
    sbc hl,de
    push de
    call ArClamp
    ld (AMY_UVAR_Hl),a
    pop de
    ld hl,(AMY_UVAR_EBase)
    add hl,de
    call ArClamp
    ld b,a
    ld a,(AMY_UVAR_Hl)
    cp b
    jr c,ArEdOk
    ld b,a
ArEdOk:
    ld a,b
    ld (AMY_UVAR_Hr),a
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_LhOld
    add hl,de
    ld a,(AMY_UVAR_Hl)
    cp (hl)
    jr nz,ArEdNew
    ld hl,AMY_UVAR_RhOld
    add hl,de
    ld a,(AMY_UVAR_Hr)
    cp (hl)
    jr z,ArEdNext
ArEdNew:
    ld hl,AMY_UVAR_LhOld
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_EOl),a
    ld a,(AMY_UVAR_Hl)
    ld (hl),a
    ld hl,AMY_UVAR_RhOld
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_EOr),a
    ld a,(AMY_UVAR_Hr)
    ld (hl),a
    ld a,(AMY_UVAR_EOl)
    cp 255
    jr nz,ArEdSpans
    call ArDrawRow
    jr ArEdNext
ArEdSpans:
    ; only the tiles round each edge's old and new places
    call ArRowSetup
    ld a,(AMY_UVAR_EOl)
    ld b,a
    ld a,(AMY_UVAR_Hl)
    call ArSpan
    ld a,(AMY_UVAR_EOr)
    ld b,a
    ld a,(AMY_UVAR_Hr)
    call ArSpan
ArEdNext:
    ld a,(AMY_UVAR_Rk)
    inc a
    ld (AMY_UVAR_Rk),a
    cp 16
    jp nz,ArEdRow
    ret

; ArRowSetup: for row Rk+8, the edge columns (ELc, ERc), their halves
; (ELh, ERh), the row's first tile code (EGs) and name address (ENam)
ArRowSetup:
    ld a,(AMY_UVAR_Hl)
    ld b,a
    srl a
    ld (AMY_UVAR_ELc),a
    ld a,b
    and 1
    ld (AMY_UVAR_ELh),a
    ld a,(AMY_UVAR_Hr)
    ld b,a
    srl a
    ld (AMY_UVAR_ERc),a
    ld a,b
    and 1
    ld (AMY_UVAR_ERh),a
    ld a,(AMY_UVAR_Rk)
    add a,8
    ld l,a
    and 7
    add a,a
    add a,a
    add a,208
    ld (AMY_UVAR_EGs),a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1800
    add hl,de
    ld (AMY_UVAR_ENam),hl
    ret

; ArSpan: the tiles from column min(A,B)/2 to max(A,B)/2 (A and B in half
; tiles) of the row set up by ArRowSetup
ArSpan:
    cp b
    jr c,ArSpOrd
    ld c,a
    ld a,b
    ld b,c
ArSpOrd:
    ; A = the smaller, B = the larger
    srl a
    srl b
    cp 32
    ret nc
    ld c,a
    ld a,b
    cp 32
    jr c,ArSpEnd
    ld b,31
ArSpEnd:
    ld a,b
    sub c
    inc a
    ld b,a
    ld hl,(AMY_UVAR_ENam)
    ld e,c
    ld d,0
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_EGs)
    ld d,a
ArSpCell:
    ; the tile at column C: forest, left half edge, snow, right half edge
    ld a,(AMY_UVAR_ELc)
    ld e,a
    ld a,c
    cp e
    jr c,ArSpForest
    jr nz,ArSpMid
    ld a,(AMY_UVAR_ELh)
    or a
    jr z,ArSpMid
    ld a,d
    add a,2
    jr ArSpOut
ArSpMid:
    ld a,(AMY_UVAR_ERc)
    ld e,a
    ld a,c
    cp e
    jr c,ArSpSnow
    jr nz,ArSpForest
    ld a,(AMY_UVAR_ERh)
    or a
    jr z,ArSpForest
    ld a,d
    add a,3
    jr ArSpOut
ArSpSnow:
    ld a,d
    jr ArSpOut
ArSpForest:
    ld a,d
    inc a
ArSpOut:
    out ($BE),a
    inc c
    djnz ArSpCell
    ret

; ArDrawRow: ground row Rk+8 from its edges Hl and Hr (half tiles): forest,
; a left half edge, snow, a right half edge, forest
ArDrawRow:
    ld a,(AMY_UVAR_Rk)
    add a,8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1800
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Rk)
    add a,8
    and 7
    add a,a
    add a,a
    add a,208
    ld d,a
    ld e,0
    ld a,(AMY_UVAR_Hl)
    srl a
    jr z,ArDrL0
    ld b,a
    ld e,a
    ld a,d
    inc a
ArDrL:
    out ($BE),a
    nop
    nop
    djnz ArDrL
ArDrL0:
    ld a,(AMY_UVAR_Hl)
    and 1
    jr z,ArDrS
    ld a,e
    cp 32
    jr nc,ArDrS
    ld a,d
    add a,2
    out ($BE),a
    inc e
ArDrS:
    ld a,(AMY_UVAR_Hr)
    srl a
    sub e
    jr c,ArDrR
    jr z,ArDrR
    ld b,a
    add a,e
    ld e,a
    ld a,d
ArDrSl:
    out ($BE),a
    nop
    nop
    djnz ArDrSl
ArDrR:
    ld a,e
    cp 32
    ret nc
    ld a,(AMY_UVAR_Hr)
    and 1
    jr z,ArDrF
    ld a,(AMY_UVAR_Hr)
    srl a
    cp e
    jr nz,ArDrF
    ld a,d
    add a,3
    out ($BE),a
    inc e
ArDrF:
    ld a,32
    sub e
    ret z
    ret c
    ld b,a
    ld a,d
    inc a
ArDrFl:
    out ($BE),a
    nop
    nop
    djnz ArDrFl
    ret

; ArProject: for the four objects, SprY/SprX/SprP/SprC from the depth
; (OZ / 16, the tables YofZ, SizeOfZ, CurveZ, InvZ), the place OX, the
; player's place Px and the curve Cq. Hidden: row 192.
ArProject:
    xor a
    ld (AMY_UVAR_Oi),a
ArPrLoop:
    ld a,(AMY_UVAR_Oi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_OKind
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Ok),a
    or a
    jp z,ArPrHide
    ld hl,AMY_UVAR_OZ
    add hl,de
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,h
    or a
    jr nz,ArPrFar
    ld a,l
    cp 128
    jr c,ArPrZok
ArPrFar:
    ld a,127
ArPrZok:
    ld (AMY_UVAR_Zb),a
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_SizeOfZ
    add hl,de
    ld a,(hl)
    cp 255
    jp z,ArPrHide
    ld (AMY_UVAR_Sv),a
    ld hl,AMY_UDATA_YofZ
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Yv),a
    ld hl,AMY_UDATA_CurveZ
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_Cq)
    call ArMul8
    sra h
    rr l
    sra h
    rr l
    ex de,hl
    ld a,(AMY_UVAR_Oi)
    add a,a
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_OX
    add hl,bc
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    add hl,de
    ld de,(AMY_UVAR_Px)
    or a
    sbc hl,de
    push hl
    ld de,300
    add hl,de
    ld de,601
    or a
    sbc hl,de
    pop hl
    jr nc,ArPrHide
    ex de,hl
    ld a,(AMY_UVAR_Zb)
    ld c,a
    ld b,0
    ld hl,AMY_UDATA_InvZ
    add hl,bc
    ld a,(hl)
    call ArMul8
    ld b,6
ArPrShift:
    sra h
    rr l
    djnz ArPrShift
    ld de,112
    add hl,de
    ld a,h
    or a
    jr nz,ArPrHide
    ld a,(AMY_UVAR_Oi)
    ld e,a
    ld d,0
    ld a,l
    ld hl,AMY_UVAR_SprX
    add hl,de
    ld (hl),a
    ld a,(AMY_UVAR_Yv)
    sub 33
    ld hl,AMY_UVAR_SprY
    add hl,de
    ld (hl),a
    ld hl,AMY_UVAR_OCol
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_SprC
    add hl,de
    ld (hl),a
    push de
    ld a,(AMY_UVAR_Ok)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_KindPat
    add hl,de
    ld b,(hl)
    pop de
    ld a,(AMY_UVAR_Sv)
    add a,a
    add a,a
    add a,b
    ld hl,AMY_UVAR_SprP
    add hl,de
    ld (hl),a
    jr ArPrNext
ArPrHide:
    ld a,(AMY_UVAR_Oi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_SprY
    add hl,de
    ld (hl),192
    ld hl,AMY_UVAR_SprX
    add hl,de
    ld (hl),0
    ld hl,AMY_UVAR_SprP
    add hl,de
    ld (hl),0
    ld hl,AMY_UVAR_SprC
    add hl,de
    ld (hl),0
ArPrNext:
    ld a,(AMY_UVAR_Oi)
    inc a
    ld (AMY_UVAR_Oi),a
    cp 4
    jp nz,ArPrLoop
    ret
CgSwoosh:
    db $00,$00,$95,$02,$00,$00,$54,$02,$00,$00,$34,$02,$00,$00,$65,$03,$00,$00,$A5,$03,$10
CgWind:
    db $00,$00,$C6,$3C,$00,$00,$B6,$3C,$00,$00,$C6,$3C,$10
CgThud:
    db $00,$00,$26,$02,$00,$00,$57,$03,$00,$00,$97,$04,$10
CgSand:
    db $00,$00,$34,$03,$00,$00,$55,$04,$00,$00,$85,$06,$00,$00,$B6,$06,$10
CgClick:
    db $40,$40,$70,$01,$50
CgHit:
    db $40,$47,$00,$01,$40,$5F,$20,$01,$40,$7F,$40,$02,$40,$A9,$70,$03,$50
CgPutt:
    db $40,$6B,$30,$01,$40,$8F,$60,$02,$50
CgGauge:
    db $40,$35,$A0,$01,$50
CgCup:
    db $40,$55,$30,$02,$40,$5F,$40,$02,$40,$55,$40,$02,$40,$5F,$50,$02,$40,$6B,$60,$03,$50
CgCheer:
    db $40,$8F,$20,$05,$40,$8F,$F0,$01,$40,$71,$20,$05,$40,$71,$F0,$01,$40,$5F,$20,$05,$40,$5F,$F0,$01
    db $40,$47,$20,$0F,$40,$47,$F0,$01,$50
CgGroan:
    db $40,$1D,$41,$06,$40,$2E,$51,$06,$40,$53,$71,$0A,$50

CgSoundTable:
    dw CgSwoosh,$702B
    dw CgWind,$702B
    dw CgThud,$702B
    dw CgSand,$702B
    dw CgClick,$7035
    dw CgHit,$7035
    dw CgPutt,$7035
    dw CgGauge,$7035
    dw CgCup,$7035
    dw CgCheer,$7035
    dw CgGroan,$7035
    dw CgTuneMel,$703F
    dw CgTuneBass,$7049
; Morning on the Links, F major waltz (original for this game)
; Tiny Sound, 8 frames per step
CgTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$40,$F1,$22,$1F,$00,$28,$00,$00,$00,$26,$00,$24,$00,$00,$00
    db $23,$00,$26,$00,$2B,$00,$00,$00,$00,$00,$00,$00,$21,$00,$29,$00
    db $00,$00,$28,$00,$26,$00,$00,$00,$24,$00,$28,$00,$24,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
CgTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$70,$F1,$22,$0C,$00,$10,$00,$13,$00,$0C,$00,$10,$00,$13,$00
    db $07,$00,$0E,$00,$13,$00,$07,$00,$0B,$00,$0E,$00,$05,$00,$09,$00
    db $0C,$00,$07,$00,$0B,$00,$0E,$00,$0C,$00,$10,$00,$13,$00,$0C,$00
    db $00,$00,$00,$00
    db $FF
}
