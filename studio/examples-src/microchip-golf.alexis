u8 Y = 0

  tile screen
  ' each third of the screen gets its own colour table (the ground rows
  ' need their own colours)
  call asm ArThirds
  set sound table CgSoundTable areas 4
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

new_round:
  HoleNo = 0
  Total = 0
  TotPar = 0
  for I = 0 to 8
    Strokes[I] = 0
  next

hole_start:
  NewHole
  CourseScreen
  HoleIntro

shot_start:
  ' trees past the rough: a penalty stroke, play again from where you were
  CourseScreen
  if Pen = 1 then
    Pen = 0
    Message
    print at 2,3, "IN THE TREES: PENALTY STROKE"
    print at 2,4, "PLAY AGAIN FROM HERE."
    play sound SndGroan
    Pause
    Message
  end if
  if Shot >= 10 then
    ' picked up
    Message
    print at 3,3, "TEN STROKES: PICK IT UP."
    Pause
    goto hole_done
  end if
  Aiming
  Swing
  if Holed = 1 then goto hole_done
  goto shot_start

hole_done:
  Mode = 0
  HoleResult
  V = HoleNo
  Strokes[V] = Shot
  Total = Total + Shot
  TotPar = TotPar + Par
  ScoreCard
  inc HoleNo
  if HoleNo < 9 then goto hole_start

  ' the end of the round
  RoundEnd
  if Menu = 0 then goto new_round
  goto title

' ---------------------------------------------------------------------------
' The hole

' NewHole: the book's hole: J from 0 to 11 and a difficulty factor of 3 to
' 5; the ball travels 26 - J of the book's steps (15 yards each)
sub NewHole:
  Rnd
  Uw = Rb
  Uw = Uw * 12
  Uw = Uw >> 8
  V = Uw
  V = 26 - V
  Uw = V
  HLen = Uw * 15
  V = HoleNo
  Yards[V] = HLen
  Rnd
  Uw = Rb
  Uw = Uw * 3
  Uw = Uw >> 8
  Q = Uw
  Q = Q + 3
  Par = 3
  if HLen > 250 then Par = 4
  Pars[V] = Par
  ' the wind: up to six miles an hour for each step of difficulty
  Rnd
  Uw = Rb
  V = Q * 6
  W = V + 1
  Uw = Uw * W
  Uw = Uw >> 8
  Wind = Uw
  Rnd
  V = Rb & 1
  if V = 1 then Wind = 0 - Wind
  ' the fairway narrows with difficulty
  Wd = 90
  if Q = 4 then Wd = 75
  if Q = 5 then Wd = 60
  WidthRows
  ' a bunker on the way, another by the green
  Rnd
  Uw = Rb
  Uw = Uw >> 2
  Uw = Uw + 140
  if Uw > HLen then Uw = HLen - 40
  BkAy = Uw
  Rnd
  Tw = Rb & 31
  Tw = Tw + Wd
  Tw = Tw - 30
  V = Rb & 128
  if V > 0 then Tw = 0 - Tw
  BkAx = Tw
  BkBy = HLen - 14
  Rnd
  BkBx = 34
  V = Rb & 1
  if V = 1 then BkBx = -34
  ' the ball on the tee
  By = 0
  Bx = 0
  Dir = 1
  Shot = 0
  Lie = 0
  Holed = 0
  Pen = 0
  Aim = 0
  return
end sub

' Place: the course's things and the picture's state for the ball's place
sub Place:
  if By < HLen then
    Togo = HLen - By
    Dir = 1
  else
    Togo = By - HLen
    Dir = -1
  end if
  ' in flight the view keeps facing the way the ball was hit
  if Flying = 1 then Dir = SDir
  ' the stripes and edges as seen from the ball, facing the hole
  Uw = By << 6
  if Dir = 1 then
    Pos = Uw
  else
    Pos = 0 - Uw
  end if
  Mx = Bx
  My = Dir
  call asm ArMul
  Px = Mz
  ' the flag and the green at the hole, the two bunkers
  Oi = 0
  Uw = HLen
  Tw = 0
  K = KFlag
  PlaceOne
  Oi = 1
  Uw = HLen
  Tw = 0
  K = KGreen
  PlaceOne
  Oi = 2
  Uw = BkAy
  Tw = BkAx
  K = KBunker
  PlaceOne
  Oi = 3
  Uw = BkBy
  Tw = BkBx
  K = KBunker
  PlaceOne
  return
end sub

' PlaceOne: object Oi of kind K at Uw yards along the hole, Tw feet across
sub PlaceOne:
  ' its distance ahead (yards), in the way the ball faces
  Xw = Uw
  U2 = By
  Tw = Tw - Bx
  if Dir = 1 then
    Xw = Xw - By
  else
    Xw = By - Uw
    Tw = 0 - Tw
  end if
  if Xw < 2 then
    OKind[Oi] = 0
    return
  end if
  if Xw > 330 then
    OKind[Oi] = 0
    return
  end if
  OKind[Oi] = K
  ' depth x16, one step of depth is 4 yards; on the green the view comes
  ' closer: 5 steps and 1 a yard
  Uw = Xw
  if Lie = 3 then
    Uw = Uw + 5
    Uw = Uw << 4
  else
    Uw = Uw << 2
  end if
  OZ[Oi] = Uw
  ' the flag stands on the green: draw it from the green's own place
  OX[Oi] = Tw
  V = 8
  if K = KGreen then V = 12
  if K = KBunker then V = 11
  if K = KTree then V = 12
  OCol[Oi] = V
  return
end sub

' WidthRows: the fairway's half width in pixels on each ground row
sub WidthRows:
  for Rk = 0 to 15
    V = InvRow[Rk]
    Mx = Wd
    My = V
    call asm ArMul
    Xw = Mz / 64
    V = Xw
    WdR[Rk] = V
  next
  return
end sub

' Lies: what the ball sits in
sub FindLie:
  Lie = 0
  Tw = Bx
  if Tw < 0 then Tw = 0 - Tw
  if Tw > Wd then Lie = 1
  ' in a bunker?
  Xw = By
  Uw = BkAy
  Tw = Uw
  Xw = Xw - Tw
  if Xw < 0 then Xw = 0 - Xw
  if Xw <= 9 then
    Tw = Bx - BkAx
    if Tw < 0 then Tw = 0 - Tw
    if Tw <= 26 then Lie = 2
  end if
  Xw = By
  Uw = BkBy
  Tw = Uw
  Xw = Xw - Tw
  if Xw < 0 then Xw = 0 - Xw
  if Xw <= 6 then
    Tw = Bx - BkBx
    if Tw < 0 then Tw = 0 - Tw
    if Tw <= 22 then Lie = 2
  end if
  ' on the green: within 12 yards of the hole and 45 feet across
  if Togo <= 12 then
    Tw = Bx
    if Tw < 0 then Tw = 0 - Tw
    if Tw <= 45 then Lie = 3
  end if
  return
end sub

' ---------------------------------------------------------------------------
' A shot

' Aiming: the stick moves the cross; holding a button starts the swing
sub Aiming:
  if Lie = 3 then Aim = 0
  Pw = 0
  WasBtn = 1
  Rearm
  wait no fire
  nmi off
  Club = 0
  Mode = 1
aim_loop:
  Pace
  ReadPad
  if Lie <> 3 then
    if Lf1 = 1 then
      if Aim > -60 then Aim = Aim - 2
    else
      if Rt1 = 1 then
        if Aim < 60 then Aim = Aim + 2
      end if
    end if
  end if
  AimMark
  BallAt
  ClubAt
  update sprites
  if Press = 0 then goto aim_loop
  ' the backswing: the gauge rises while the button is held, falls back
  ' from the top, and the shot goes when it is let go
  Pw = 0
  PwUp = 1
  Club = 1
  Mode = 2
power_loop:
  Pace
  ReadPad
  if PwUp = 1 then
    Pw = Pw + 4
    if Pw >= 100 then
      Pw = 100
      PwUp = 0
    end if
  else
    if Pw >= 4 then
      Pw = Pw - 4
    else
      Pw = 0
      PwUp = 1
    end if
  end if
  V = Pw & 12
  if V = 0 then play sound SndGauge
  PowerBar
  ClubAt
  update sprites
  if Btn = 1 then goto power_loop
  Mode = 3
  return
end sub

' Swing: the shot's carry and drift, then the flight
sub Swing:
  inc Shot
  Club = 2
  ClubAt
  update sprites
  play sound SndSwoosh
  OldBy = By
  OldBx = Bx
  OldLie = Lie
  if Lie = 3 then goto putt
  ' the club for the lie: driver, rough, sand
  PMax = 250
  if Shot > 1 then PMax = 220
  if Lie = 1 then PMax = 170
  if Lie = 2 then PMax = 90
  ' never more than a little past the hole (a softer club near the green)
  Uw = Togo + 40
  if Uw < PMax then PMax = Uw
  Uw = PMax
  V = Pw
  NumU = V
  Mx = Uw
  My = NumU
  call asm ArMul
  Uw = Mz
  Carry = Uw / 100
  ' the difficulty factor: up to 4% short for each step
  Rnd
  V = Q * 4
  W = V + 1
  Uw = Rb
  Uw = Uw * W
  Uw = Uw >> 8
  NumU = Uw
  Mx = Carry
  My = NumU
  call asm ArMul
  Uw = Mz
  Uw = Uw / 100
  Carry = Carry - Uw
  ' the drift: the aim (feet at 80 yards) and the wind (feet per 100 yards
  ' a mile an hour)
  Mx = Aim
  My = Carry
  call asm ArMul
  DLat = Mz / 80
  Mx = Wind
  My = Carry
  call asm ArMul
  Tw = Mz / 100
  DLat = DLat + Tw
  play sound SndHit
  SDir = Dir
  Flying = 1
  Fly
  Flying = 0
  Dir = SDir
  ' where it came down (the flight only moved the view)
  Mx = DLat
  My = Dir
  call asm ArMul
  Bx = OldBx + Mz
  if Dir = 1 then
    By = OldBy + Carry
  else
    if OldBy > Carry then
      By = OldBy - Carry
    else
      By = 0
    end if
  end if
  Place
  ' in the hole from out there? (the book: land on the hole's spot)
  if Togo <= 1 then
    Tw = Bx
    if Tw < 0 then Tw = 0 - Tw
    if Tw <= 12 then
      Holed = 1
      play sound SndCup
      return
    end if
  end if
  ' into the trees: back where it was, a stroke more
  Tw = Bx
  if Tw < 0 then Tw = 0 - Tw
  Xw = Wd + 70
  if Tw > Xw then
    inc Shot
    Pen = 1
    By = OldBy
    Bx = OldBx
    Place
    FindLie
    return
  end if
  FindLie
  if Lie = 2 then
    play sound SndSand
  else
    play sound SndThud
  end if
  return
putt:
  ' the putter: the gauge's top is twice the distance to the hole and a
  ' bit, the difficulty a little either way
  Uw = Togo << 1
  Uw = Uw + 6
  PMax = Uw
  V = Pw
  NumU = V
  Mx = PMax
  My = NumU
  call asm ArMul
  Uw = Mz
  Uw = Uw + 50
  Carry = Uw / 100
  Rnd
  V = Rb & 7
  if V < Q then
    V = Rb & 8
    if V > 0 then
      inc Carry
    else
      if Carry > 0 then dec Carry
    end if
  end if
  play sound SndPutt
  Roll
  ' the ball stops Carry yards on; within a yard of the hole it drops
  Tw = Carry
  Xw = Togo
  Tw = Tw - Xw
  if Tw < 0 then Tw = 0 - Tw
  if Tw <= 1 then
    Holed = 1
    play sound SndCup
    return
  end if
  if Dir = 1 then
    By = By + Carry
  else
    if By > Carry then
      By = By - Carry
    else
      By = 0
    end if
  end if
  Bx = 0
  Place
  FindLie
  if Lie <> 3 then
    ' rolled off the green: it stays at the fringe
    Lie = 3
  end if
  return
end sub

' Fly: the view follows the ball along its carry; the ball rises and falls
sub Fly:
  HideAim
  Uw = Carry >> 2
  V = Uw
  FN = V + 30
  ' fixed point: yards x16
  Fy16 = By << 4
  Uw = Carry << 4
  FStep = Uw / FN
  Mx = DLat
  My = 16
  call asm ArMul
  Fx16 = Bx
  Fx16 = Fx16 << 4
  Tw = FN
  FxStep = Mz / Tw
  FH = Carry >> 3
  if FH > 60 then FH = 60
  for FI = 1 to FN
    Pace
    ' the camera moves on
    if Dir = 1 then
      Fy16 = Fy16 + FStep
    else
      if Fy16 > FStep then
        Fy16 = Fy16 - FStep
      else
        Fy16 = 0
      end if
    end if
    Mx = FxStep
    My = Dir
    call asm ArMul
    Fx16 = Fx16 + Mz
    By = Fy16 >> 4
    Bx = Fx16 / 16
    PlaceView
    ' the ball: a parabola, 4 h t (n - t) / n^2
    V = FN - FI
    Uw = FI
    Uw = Uw * V
    Uw = Uw << 2
    NumU = FH
    Mx = Uw
    My = NumU
    call asm ArMul
    Uw = Mz
    U2 = FN
    U2 = U2 * FN
    Uw = Uw / U2
    V = Uw
    Y = 140 - V
    Pt = SBallair
    if FI > 20 then Pt = SBallfar
    set sprite 6 to Y, 112, Pt, 15
    if FI = 6 then
      Club = 3
      ClubAt
    end if
    update sprites
  next
  return
end sub

' Roll: a putt: the ball runs away from you toward the hole
sub Roll:
  HideAim
  Club = 3
  ClubAt
  FN = 30
  FStep = Carry
  for FI = 1 to FN
    Pace
    ' depth of the ball: 5 steps out, then 1 a yard (the green's close view)
    Uw = FStep
    V = FI
    NumU = V
    Mx = Uw
    My = NumU
    call asm ArMul
    Uw = Mz
    Uw = Uw / FN
    Uw = Uw + 5
    if Uw < 6 then Uw = 6
    if Uw > 127 then Uw = 127
    Zz = Uw
    V = YofZ[Zz]
    Y = V - 31
    Pt = SBallair
    if Zz > 14 then Pt = SBallfar
    set sprite 6 to Y, 112, Pt, 15
    update sprites
  next
  return
end sub

' PlaceView: the picture redrawn for the ball's place (during a flight)
sub PlaceView:
  Place
  call asm ArStripes
  Edges
  ProjectAll
  return
end sub

' ---------------------------------------------------------------------------
' Sprites

' ClubAt: the club, 0 at address, 1 at the top, 2 just hit, 3 follow-through
sub ClubAt:
  if Club = 0 then
    set sprite 0 to 150, 80, SClubal, 14
    set sprite 1 to 150, 112, SClubar, 14
  end if
  if Club = 1 then
    set sprite 0 to 150, 80, SClubtl, 14
    set sprite 1 to 150, 112, SClubtr, 14
  end if
  if Club = 2 then
    set sprite 0 to 150, 80, SClubfl, 14
    set sprite 1 to 150, 112, SClubfr, 14
  end if
  if Club = 3 then
    set sprite 0 to 120, 64, SClubfl, 14
    set sprite 1 to 192, 0, 0, 0
  end if
  return
end sub

' BallAt: the ball at your feet
sub BallAt:
  set sprite 6 to 152, 112, SBallbig, 15
  return
end sub

' AimMark: the cross, 80 yards out (depth 20), Aim feet across
sub AimMark:
  if Lie = 3 then
    set sprite 7 to 192, 0, 0, 0
    return
  end if
  V = InvZ[20]
  Mx = Aim
  My = V
  call asm ArMul
  Tw = Mz / 64
  Tw = Tw + 112
  Xb = Tw
  V = YofZ[20]
  Y = V - 25
  set sprite 7 to Y, Xb, SAim, 9
  return
end sub

sub HideAim:
  set sprite 7 to 192, 0, 0, 0
  return
end sub

' ProjectAll: the course's things (sprites 2-5) from ArProject
sub ProjectAll:
  call asm ArProject
  for Oi = 0 to 3
    Sp = Oi + 2
    Yv = SprY[Oi]
    Xb = SprX[Oi]
    Pt = SprP[Oi]
    Pc = SprC[Oi]
    set sprite Sp to Yv, Xb, Pt, Pc
  next
  return
end sub

' ---------------------------------------------------------------------------
' The picture

sub Edges:
  if Px = EPx then return
  EPx = Px
  call asm ArEdges
  return
end sub

' Pace: a steady 30 passes a second (see Avalanche Run)
sub Pace:
  call asm ArLate
  if Late = 0 then Frame1
  Frame1
  inc Passes
  return
end sub

' CourseScreen: the sky, the hills, the hole as seen from the ball, HUD
sub CourseScreen:
  Place
  FindLie
  ' (the green's close view depends on the lie)
  Place
  NewScreen
  for Y = 5 to 7
    V = Y - 5
    Off = V << 4
    Off = Off + TMtn00
    for X = 0 to 31
      W = X & 15
      W = W + Off
      put char W at X,Y
    next
  next
  fill TBrow count 32 at 0,8
  for Rk = 0 to 15
    LhOld[Rk] = 255
    RhOld[Rk] = 255
  next
  EPx = 9999
  Clouds
  fill array Cache with 0
  StAll = 1
  call asm ArStripes
  StAll = 0
  Edges
  Hud
  ProjectAll
  HideAim
  Club = 0
  ClubAt
  BallAt
  update sprites
  ShowScreen
  return
end sub

sub Clouds:
  put char TCloud00 at 3,4
  put char TCloud01 at 4,4
  put char TCloud02 at 5,4
  put char TCloud00 at 23,3
  put char TCloud01 at 24,3
  put char TCloud02 at 25,3
  return
end sub

' Message: rows 3-4 cleared for a message
sub Message:
  fill 32 count 32 at 0,3
  fill 32 count 32 at 0,4
  return
end sub

sub Hud:
  print at 2,1, "HOLE"
  V = HoleNo + 1
  NumU = V
  print at 7,1, digits$(NumU, 1)
  print at 9,1, "PAR"
  NumU = Par
  print at 13,1, digits$(NumU, 1)
  print at 15,1, "SHOT"
  V = Shot + 1
  NumU = V
  print at 20,1, width$(NumU, 2)
  put char TFlagic at 24,1
  NumU = Togo
  print at 25,1, width$(NumU, 3)
  print at 28,1, "Y"
  ' row 2: the wind, the lie
  print at 2,2, "WIND"
  Tw = Wind
  W = TWindr
  if Tw < 0 then
    Tw = 0 - Tw
    W = TWindl
  end if
  if Tw = 0 then W = 32
  put char W at 7,2
  NumU = Tw
  print at 8,2, width$(NumU, 2)
  if Lie = 0 then
    if Shot = 0 then
      print at 11,2, "TEE    "
    else
      print at 11,2, "FAIRWAY"
    end if
  end if
  if Lie = 1 then print at 11,2, "ROUGH  "
  if Lie = 2 then print at 11,2, "BUNKER "
  if Lie = 3 then print at 11,2, "GREEN  "
  PowerBar
  return
end sub

' PowerBar: nine boxes, columns 21-29
sub PowerBar:
  Uw = Pw
  Uw = Uw * 9
  Uw = Uw + 5
  Uw = Uw / 100
  V = Uw
  for X = 0 to 8
    W = TBarnone
    if X < V then
      W = TBarfull
      if X >= 7 then W = TBarhot
    end if
    Y = X + 21
    put char W at Y,2
  next
  return
end sub

' ---------------------------------------------------------------------------
' Pages between shots

sub HoleIntro:
  Message
  print at 3,3, "HOLE"
  V = HoleNo + 1
  NumU = V
  print at 8,3, digits$(NumU, 1)
  NumU = HLen
  print at 11,3, width$(NumU, 3)
  print at 15,3, "YARDS  PAR"
  NumU = Par
  print at 26,3, digits$(NumU, 1)
  ' the book's words
  print at 3,4, "DIFFICULTY FACTOR IS"
  if Q = 3 then print at 24,4, "THREE"
  if Q = 4 then print at 24,4, "FOUR"
  if Q = 5 then print at 24,4, "FIVE"
  Pause
  Pause
  Message
  Clouds
  return
end sub

sub HoleResult:
  Message
  ' the book: "You did it!!"
  if Holed = 1 then
    print at 3,3, "YOU DID IT!!"
  end if
  Tw = Shot
  Xw = Par
  Tw = Tw - Xw
  if Shot = 1 then
    print at 3,4, "A HOLE IN ONE!"
  else
    if Tw <= -2 then print at 3,4, "AN EAGLE!"
    if Tw = -1 then print at 3,4, "A BIRDIE!"
    if Tw = 0 then print at 3,4, "PAR."
    if Tw = 1 then print at 3,4, "A BOGEY."
    if Tw = 2 then print at 3,4, "A DOUBLE BOGEY."
    if Tw >= 3 then print at 3,4, "OH DEAR."
  end if
  if Tw < 0 then
    play sound SndCheer
  else
    if Tw > 1 then play sound SndGroan
  end if
  print at 20,3, "STROKES"
  NumU = Shot
  print at 28,3, digits$(NumU, 1)
  if Shot >= 10 then print at 27,3, "10"
  Pause
  Pause
  return
end sub

' ScoreCard: the book's "The game so far", with the average per hole
sub ScoreCard:
  PageScreen
  print at 9,1, "THE GAME SO FAR"
  print at 3,3, "HOLE YARDS PAR STROKES"
  for I = 0 to HoleNo
    Y = I + 5
    V = I + 1
    NumU = V
    print at 4,Y, digits$(NumU, 1)
    NumU = Yards[I]
    print at 8,Y, width$(NumU, 3)
    V = Pars[I]
    NumU = V
    print at 14,Y, digits$(NumU, 1)
    V = Strokes[I]
    NumU = V
    print at 20,Y, width$(NumU, 2)
  next
  V = HoleNo + 1
  print at 3,16, "SCORE FOR"
  NumU = V
  print at 13,16, digits$(NumU, 1)
  print at 15,16, "HOLES:"
  NumU = Total
  print at 22,16, width$(NumU, 3)
  ' against par
  Tw = Total
  Xw = TotPar
  Tw = Tw - Xw
  print at 3,17, "AGAINST PAR:"
  if Tw = 0 then
    print at 22,17, "  E"
  else
    if Tw > 0 then
      NumU = Tw
      print at 22,17, "+"
      print at 23,17, width$(NumU, 2)
    else
      Tw = 0 - Tw
      NumU = Tw
      print at 22,17, "-"
      print at 23,17, width$(NumU, 2)
    end if
  end if
  ' the average, rounded as the book does: INT((K + .5) / Z)... to a tenth
  print at 3,18, "AVERAGE PER HOLE:"
  Uw = Total * 10
  V = HoleNo + 1
  U2 = V
  V = V >> 1
  Uw = Uw + V
  NumU = Uw / U2
  Uw = NumU / 10
  U2 = Uw * 10
  NumU = NumU - U2
  print at 21,18, width$(Uw, 2)
  print at 23,18, "."
  print at 24,18, digits$(NumU, 1)
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

' RoundEnd: the book's last words, the best round, another round?
sub RoundEnd:
  PageScreen
  print at 3,2, "END OF THAT ROUND, GOLFER!"
  print at 3,4, "YOU SCORED"
  NumU = Total
  print at 14,4, width$(NumU, 3)
  print at 3,5, "AND YOUR AVERAGE PER HOLE"
  print at 3,6, "WAS"
  Uw = Total + 4
  Uw = Uw / 9
  NumU = Uw
  print at 7,6, width$(NumU, 2)
  if Total < Best then
    Best = Total
    print at 3,8, "YOUR BEST ROUND YET!"
    play sound SndCheer
  end if
  print at 3,9, "BEST ROUND:"
  NumU = Best
  print at 15,9, width$(NumU, 3)
  print at 3,10, "PAR FOR THE COURSE:"
  NumU = TotPar
  print at 23,10, width$(NumU, 2)
  print at 8,14, "ANOTHER ROUND"
  print at 8,15, "TITLE PAGE"
  ShowScreen
  Menu = 0
  WasBtn = 1
re_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      Menu = 0
    else
      if Dn1 = 1 then Menu = 1
    end if
    play sound SndClick
  end if
  print at 6,14, " "
  print at 6,15, " "
  Y = Menu + 14
  print at 6,Y, ">"
  if Press = 0 then goto re_loop
  return
end sub

' ---------------------------------------------------------------------------
' Helpers

' Rnd: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 60
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Gnd1Pat count 256 to vram.pattern + 3712
  copy Gnd2Pat count 256 to vram.pattern + 5760
  backdrop light blue
  cls
  return
end sub

' PageScreen: a page of text, white on dark green
sub PageScreen:
  NewScreen
  backdrop dark green
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  HoleNo = 0
  HLen = 330
  Q = 3
  Wd = 75
  WidthRows
  BkAy = 200
  BkAx = 70
  BkBy = 316
  BkBx = -34
  By = 0
  Bx = 0
  Shot = 0
  Par = 4
  Wind = 0
  Pw = 0
  CourseScreen
  fill 32 count 32 at 0,1
  fill 32 count 32 at 0,2
  Message
  print at 9,1, "MICROCHIP GOLF"
  print at 11,2, "PLAY 9 HOLES"
  print at 11,3, "HOW TO PLAY"
  print at 11,4, "CREDITS"
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 2 to 4
    print at 9,I, " "
  next
  Y = Menu + 2
  print at 9,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  PageScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "NINE HOLES ON THE MICROCHIP"
  print at 2,4, "GOLFCOURSE. FEWEST STROKES"
  print at 2,5, "WINS."
  print at 2,7, "LEFT, RIGHT: AIM THE CROSS."
  print at 2,8, "HOLD A BUTTON: THE GAUGE"
  print at 2,9, "RISES AND FALLS. LET GO TO"
  print at 2,10, "HIT. WATCH THE WIND!"
  print at 2,12, "ROUGH AND BUNKERS SHORTEN"
  print at 2,13, "YOUR SHOT. TREES COST A"
  print at 2,14, "PENALTY STROKE."
  print at 2,16, "ON THE GREEN YOU PUTT AT THE"
  print at 2,17, "HOLE: THE GAUGE'S TOP IS"
  print at 2,18, "TWICE THE DISTANCE."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  PageScreen
  print at 8,1, "MICROCHIP GOLF"
  print at 2,3, "AFTER CADDY IN TIM"
  print at 2,4, "HARTNELL'S GIANT BOOK OF"
  print at 2,5, "COMPUTER GAMES (BALLANTINE"
  print at 2,6, "BOOKS, 1984; INTERFACE"
  print at 2,7, "PUBLICATIONS, 1983)."
  print at 2,9, "MUSIC: MORNING ON THE LINKS"
  print at 2,10, "(ORIGINAL)."
  print at 2,12, "COLECOVISION GAME BY"
  print at 2,13, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

