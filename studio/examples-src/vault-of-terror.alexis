asm {
; VtRnd: 16-bit xorshift (7, 9, 8) on Rs
VtRnd:
  ld hl,(AMY_UVAR_Rs)
  ld a,h
  rra
  ld a,l
  rra
  xor h
  ld h,a
  ld a,l
  rra
  ld a,h
  rra
  xor l
  ld l,a
  xor h
  ld h,a
  ld (AMY_UVAR_Rs),hl
  ret

; VtBlit: the 16 x 16 view buffer Vb to the name table, columns 2-17 of
; rows 1-16 (called with the NMI off)
VtBlit:
  ld hl,AMY_UVAR_Vb
  ld de,$5822
  ld c,16
VtBlitRow:
  ld a,e
  out ($BF),a
  ld a,d
  out ($BF),a
  ld b,16
VtBlitCol:
  ld a,(hl)
  out ($BE),a
  inc hl
  djnz VtBlitCol
  ld a,e
  add a,32
  ld e,a
  jr nc,VtBlitNc
  inc d
VtBlitNc:
  dec c
  jr nz,VtBlitRow
  ret
