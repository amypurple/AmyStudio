cartridge "ALPHA ANXIETY/COMPUTE'S GAZETTE/1985"

' ALPHA ANXIETY
' A ColecoVision game based on "Alpha Anxiety", COMPUTE!'s Gazette,
' March 1985 (Commodore 64 and VIC-20 BASIC; no author is named in the
' listing, on the disk's contents file or in the sources found). Made for
' Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the
' C64 and VIC-20 listings, orig/), the game is built for the ColecoVision:
' bevelled panels and lettered tiles, a cursor frame that glides, the
' letter under the cursor as a sprite, sound effects and a title tune.
'
' The game: the letters A to Y hide under the 25 panels of a 5 x 5 board.
' The cursor shows the letter under it. Press the button on the letters
' in order, A, B, C ... Y, before the clock runs out. A found letter stays
' uncovered. A wrong letter costs ten seconds. Clear the board and a new
' shuffled board comes, with a time limit worked out from how fast you
' were. After six boards the order turns round: Y, X, W ... A.
'
' From the original: the 5 x 5 board of A-Y shuffled each round; the
' letter shown only under the cursor, found letters left uncovered; the
' cursor moved one cell at a time; 10 points a letter; 150 seconds for
' the first board; a wrong letter takes 10 seconds off the round's limit
' (the C64 ends the game when the limit reaches 0); the next limit from
' the time left TL (40 + 2 TL under 150, TL / 2 over 300, else TL), at
' 5000 points the average time a board took (AT / 20), past 5000 five
' seconds less at 6000, 7000, 8000, 9000 and 10000; Y to A once the score
' passes 1250; the NEXT LETTER box only while the score is under 2500
' (from the eleventh board you must remember the order yourself); the
' row of found letters; the score and the high score; the fanfare.
'
' Liberties: joystick cursor glides (hold the stick to repeat) instead of
' the BASIC loop's speed. In the Y-to-A rounds the C64 also charged ten
' seconds for pressing an already found letter; here a found (uncovered)
' letter never costs time in either direction. A press is counted once
' (the original read a held button again every loop pass). The game-over
' high score is kept when the limit runs out by penalties too (the C64
' skipped it). Limits are whole seconds (TL / 2 rounded down). The last
' ten seconds tick. The round number and the direction are shown. No
' play-again prompt: the title comes back.
'
' Controls: either controller; the stick moves the cursor, either button
' picks the letter. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off and
' the display off. Music first in the sound table, the title tune played
' once. `set sprite count` always given. Own xorshift random numbers.
' Nothing flashes.

const TFtl = 128
const TFt = 129
const TFtr = 130
const TFl = 131
const TFr = 132
const TFbl = 133
const TFb = 134
const TFbr = 135
const THtl = 136
const THt = 137
const THtr = 138
const THl = 139
const THr = 140
const THbl = 141
const THb = 142
const THbr = 143
const THface = 144
const TSlot = 145
const TGa00 = 146
const TGa01 = 147
const TGa10 = 148
const TGa11 = 149
const TGb00 = 150
const TGb01 = 151
const TGb10 = 152
const TGb11 = 153
const TGc00 = 154
const TGc01 = 155
const TGc10 = 156
const TGc11 = 157
const TGd00 = 158
const TGd01 = 159
const TGd10 = 160
const TGd11 = 161
const TGe00 = 162
const TGe01 = 163
const TGe10 = 164
const TGe11 = 165
const TGf00 = 166
const TGf01 = 167
const TGf10 = 168
const TGf11 = 169
const TGg00 = 170
const TGg01 = 171
const TGg10 = 172
const TGg11 = 173
const TGh00 = 174
const TGh01 = 175
const TGh10 = 176
const TGh11 = 177
const TGi00 = 178
const TGi01 = 179
const TGi10 = 180
const TGi11 = 181
const TGj00 = 182
const TGj01 = 183
const TGj10 = 184
const TGj11 = 185
const TGk00 = 186
const TGk01 = 187
const TGk10 = 188
const TGk11 = 189
const TGl00 = 190
const TGl01 = 191
const TGl10 = 192
const TGl11 = 193
const TGm00 = 194
const TGm01 = 195
const TGm10 = 196
const TGm11 = 197
const TGn00 = 198
const TGn01 = 199
const TGn10 = 200
const TGn11 = 201
const TGo00 = 202
const TGo01 = 203
const TGo10 = 204
const TGo11 = 205
const TGp00 = 206
const TGp01 = 207
const TGp10 = 208
const TGp11 = 209
const TGq00 = 210
const TGq01 = 211
const TGq10 = 212
const TGq11 = 213
const TGr00 = 214
const TGr01 = 215
const TGr10 = 216
const TGr11 = 217
const TGs00 = 218
const TGs01 = 219
const TGs10 = 220
const TGs11 = 221
const TGt00 = 222
const TGt01 = 223
const TGt10 = 224
const TGt11 = 225
const TGu00 = 226
const TGu01 = 227
const TGu10 = 228
const TGu11 = 229
const TGv00 = 230
const TGv01 = 231
const TGv10 = 232
const TGv11 = 233
const TGw00 = 234
const TGw01 = 235
const TGw10 = 236
const TGw11 = 237
const TGx00 = 238
const TGx01 = 239
const TGx10 = 240
const TGx11 = 241
const TGy00 = 242
const TGy01 = 243
const TGy10 = 244
const TGy11 = 245
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const SLa = 16
const SLb = 20
const SLc = 24
const SLd = 28
const SLe = 32
const SLf = 36
const SLg = 40
const SLh = 44
const SLi = 48
const SLj = 52
const SLk = 56
const SLl = 60
const SLm = 64
const SLn = 68
const SLo = 72
const SLp = 76
const SLq = 80
const SLr = 84
const SLs = 88
const SLt = 92
const SLu = 96
const SLv = 100
const SLw = 104
const SLx = 108
const SLy = 112
const NTiles8 = 944
const SprBytes = 928
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndRight = 4
const SndWrong = 5
const SndClear = 6
const SndTick = 7
const SndOver = 8
const NSpr = 5
const TuneLen = 510
const BoardX = 2
const BoardY = 1

record Cursor:
  u8 Row
  u8 Col
  u8 X
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the rules' numbers (the listing's names)
u16 Sc = 0
u16 Hs = 0
bcd digits 6 ScB = 0
bcd digits 6 HsB = 0
i16 Dl = 150
i16 Tl = 150
u16 El = 0
u16 At = 0
u8 Rf = 0
u8 Lc = 1
u8 Nf = 0
u8 Rd = 1
u8 Hint = 1
u8 SecT = 0
' the board: Rl[cell] the letter 1-25 (A-Y), Fd[cell] 1 when found
u8 Rl[25]
u8 Fd[25]
u8 Buf[8]
Cursor Cur
' game state: 0 title, 2 playing, 3 board cleared, 4 over
u8 Gs = 0
u8 Why = 0
u8 RedT = 0
u8 Rpt = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Si = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AxSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  Clock
  PlayInput
  MoveCursor
  if Gs = 3 then NextBoard
  if Gs <> 4 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  HideSprites
  if Sc > Hs then
    Hs = Sc
    HsB = ScB
  end if
  ShowHud
  print at 3,8, "                  "
  print at 3,9, "    GAME  OVER    "
  print at 3,10, "                  "
  if Why = 1 then
    print at 3,11, "   OUT OF TIME    "
  else
    print at 3,11, " THE LIMIT IS USED "
    print at 3,12, " UP BY WRONG ONES  "
  end if
  print at 3,13, "                  "
  print at 3,14, "  SCORE           "
  print ScB at 11,14
  print at 3,15, "                  "
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the board

' the character at local position Lx, Ly (0-3) of a cell: a hidden panel
' (T = 0) or the tile of letter T (1-25)
function CellChar(u8 T, u8 Lx, u8 Ly) as u8
  u8 Res = 0
  u8 Base = 0
  Base = TFtl
  if T = 0 then Base = THtl
  select case (Lx, Ly)
  case (0, 0)
    Res = Base
  case (1 to 2, 0)
    Res = Base + 1
  case (3, 0)
    Res = Base + 2
  case (0, 1 to 2)
    Res = Base + 3
  case (3, 1 to 2)
    Res = Base + 4
  case (0, 3)
    Res = Base + 5
  case (1 to 2, 3)
    Res = Base + 6
  case (3, 3)
    Res = Base + 7
  case else
    if T = 0 then
      Res = THface
    else
      Res = TGa00 + ((T - 1) << 2) + ((Ly - 1) << 1) + Lx - 1
    end if
  end select
  return Res

' a whole cell (T as in CellChar) with its corner at screen character Px, Py
sub PutCell(u8 T, u8 Px, u8 Py):
  u8 Lx = 0
  u8 Ly = 0
  u16 Va = 0
  for Ly = 0 to 3
    for Lx = 0 to 3
      Buf[Lx] = CellChar(T, Lx, Ly)
    next
    Va = Py + Ly
    Va = Va * 32 + Px
    copy Buf count 4 to vram.name + Va
  next
  return

' what cell Ce shows: its letter when found, else the panel
function Shown(u8 Ce) as u8
  if Fd[Ce] = 1 then return Rl[Ce]
  return 0

sub DrawCellNo(u8 Ce):
  u8 Rw = 0
  u8 Cl = 0
  u8 Px = 0
  u8 Py = 0
  Rw = Ce / 5
  Cl = Ce % 5
  Px = Cl * 4 + BoardX
  Py = Rw * 4 + BoardY
  PutCell(Shown(Ce), Px, Py)
  return

sub DrawBoard:
  for Si = 0 to 24
    DrawCellNo(Si)
  next
  return

' the strip of found letters on row 22: letter L in column L + 1
sub DrawStrip:
  fill TSlot count 25 at 2,22
  for Si = 0 to 24
    if Fd[Si] = 1 then
      V = Rl[Si]
      X = V + 1
      put char V + 64 at X,22
    end if
  next
  return

' shuffle A-Y into the 25 cells (the listing draws each letter by
' rejection; a Fisher-Yates shuffle gives the same odds)
sub Shuffle:
  u8 I = 0
  u8 R = 0
  u8 T = 0
  for I = 0 to 24
    Rl[I] = I + 1
  next
  fill array Fd with 0
  for I = 24 downto 1
    W16 = Rand
    R = W16 % (I + 1)
    T = Rl[I]
    Rl[I] = Rl[R]
    Rl[R] = T
  next
  return

' the next round's limit from the time left (listing lines 940-1040)
function NextLimit as i16
  i16 Nd = 0
  Nd = Dl
  if Sc > 5000 then
    select case Sc
    case 6000, 7000, 8000, 9000, 10000
      Nd = Dl - 5
    end select
    return Nd
  end if
  At = At + Dl - Tl
  if Sc = 5000 then
    Nd = At / 20
  elseif Tl < 150 then
    Nd = 40 + Tl * 2
  elseif Tl > 300 then
    Nd = Tl / 2
  else
    Nd = Tl
  end if
  return Nd

' the next letter after Lc in this round's direction
function Following(u8 L) as u8
  if Rf = 1 then return L - 1
  return L + 1

' ---------------------------------------------------------------------------
' play

' the button on the cursor's cell
sub Judge:
  u8 Ce = 0
  u8 L = 0
  Ce = Cur.Row * 5 + Cur.Col
  if Fd[Ce] = 1 then return
  L = Rl[Ce]
  if L = Lc then
    Sc += 10
    ScB += 10
    Fd[Ce] = 1
    inc Nf
    play sound SndRight
    DrawCellNo(Ce)
    X = L + 1
    put char L + 64 at X,22
    ShowScore
    if Nf = 25 then
      Gs = 3
      return
    end if
    Lc = Following(Lc)
    ShowNext
    return
  end if
  ' a letter not yet due: ten seconds off the limit
  play sound SndWrong
  RedT = 20
  Dl -= 10
  Tl = Dl - El
  ShowTime
  if Dl <= 0 then
    Why = 2
    Gs = 4
  elseif Tl <= 0 then
    Why = 1
    Gs = 4
  end if
  return

sub PlayInput:
  u8 St = 0
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
  elseif Rpt > 0 then
    dec Rpt
  else
    if WasStick = 0 then
      Rpt = 12
    else
      Rpt = 7
    end if
    MoveBy(St)
  end if
  WasStick = St
  if Press = 1 then Judge
  return

' one cell in the stick's direction (the first of up, down, right, left)
sub MoveBy(u8 St):
  if (St & 1) > 0 then
    if Cur.Row > 0 then
      dec Cur.Row
      play sound SndStep
    end if
    return
  end if
  if (St & 2) > 0 then
    if Cur.Row < 4 then
      inc Cur.Row
      play sound SndStep
    end if
    return
  end if
  if (St & 8) > 0 then
    if Cur.Col < 4 then
      inc Cur.Col
      play sound SndStep
    end if
    return
  end if
  if (St & 4) > 0 then
    if Cur.Col > 0 then
      dec Cur.Col
      play sound SndStep
    end if
  end if
  return

' the cursor frame glides 8 pixels a frame toward its cell; once there,
' the letter under it shows (a white sprite over the panel)
sub MoveCursor:
  u8 Tx = 0
  u8 Ty = 0
  u8 Co = 11
  u8 Ce = 0
  u8 Lp = 0
  Tx = Cur.Col * 32 + BoardX * 8
  Ty = Cur.Row * 32 + BoardY * 8
  if Cur.X < Tx then Cur.X += 8
  if Cur.X > Tx then Cur.X -= 8
  if Cur.Y < Ty then Cur.Y += 8
  if Cur.Y > Ty then Cur.Y -= 8
  if RedT > 0 then
    dec RedT
    Co = 8
  end if
  Y = Cur.Y - 1
  set sprite 0 to Y,Cur.X,SCtl,Co
  X = Cur.X + 16
  set sprite 1 to Y,X,SCtr,Co
  Y = Y + 16
  set sprite 2 to Y,Cur.X,SCbl,Co
  set sprite 3 to Y,X,SCbr,Co
  Ce = Cur.Row * 5 + Cur.Col
  Y = 192
  if Cur.X = Tx then
    if Cur.Y = Ty then
      if Fd[Ce] = 0 then Y = Cur.Y + 7
    end if
  end if
  Lp = Rl[Ce] - 1
  Lp = Lp * 4 + SLa
  X = Cur.X + 8
  set sprite 4 to Y,X,Lp,15
  update sprites
  return

sub Clock:
  if Gs <> 2 then return
  inc SecT
  if SecT < 60 then return
  SecT = 0
  inc El
  Tl = Dl - El
  ShowTime
  if Tl <= 0 then
    Why = 1
    Gs = 4
    return
  end if
  if Tl <= 10 then play sound SndTick
  return

sub ShowTime:
  if Tl < 0 then
    NumU = 0
  else
    NumU = Tl
  end if
  print at 25,9, digits$(NumU, 3)
  return

sub ShowScore:
  print ScB at 24,12
  return

' the NEXT LETTER box: the letter due, or a panel once hints are over
sub ShowNext:
  if Hint = 1 then
    PutCell(Lc, 24, 2)
  else
    PutCell(0, 24, 2)
  end if
  return

sub ShowHud:
  print at 24,1, "NEXT"
  ShowNext
  print at 24,8, "TIME"
  ShowTime
  print at 24,11, "SCORE"
  ShowScore
  print at 24,14, "HIGH"
  print HsB at 24,15
  print at 24,17, "BOARD"
  NumU = Rd
  print at 25,18, digits$(NumU, 3)
  if Rf = 1 then
    print at 24,20, "Y TO A"
  else
    print at 24,20, "A TO Y"
  end if
  return

' ---------------------------------------------------------------------------
' rounds

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

' a fresh board on screen (the listing's lines 240-370)
sub StartBoard:
  NewScreen
  Shuffle
  Nf = 0
  Lc = 1
  if Rf = 1 then Lc = 25
  Hint = 0
  if Sc < 2500 then Hint = 1
  El = 0
  SecT = 0
  Tl = Dl
  DrawBoard
  DrawStrip
  ShowHud
  Cur.Row = 0
  Cur.Col = 0
  Cur.X = BoardX * 8
  Cur.Y = BoardY * 8
  RedT = 0
  MoveCursor
  ShowScreen
  Gs = 2
  return

' a cleared board: the fanfare, the next limit, the next board
sub NextBoard:
  HideSprites
  play sound SndClear
  for Ci = 1 to 100
    Frame1
  next
  Dl = NextLimit
  if Sc > 1250 then Rf = 1
  inc Rd
  StartBoard
  return

sub NewGame:
  Sc = 0
  ScB = 0
  Dl = 150
  At = 0
  Rf = 0
  Rd = 1
  Why = 0
  StartBoard
  play sound SndTick
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a big letter (2 x 2 tiles, no frame) at Px, Py
sub BigLetter(u8 L, u8 Px, u8 Py):
  u8 T = 0
  u8 Qx = 0
  u8 Qy = 0
  T = TGa00 + ((L - 1) << 2)
  Qx = Px + 1
  Qy = Py + 1
  put char T at Px,Py
  put char T + 1 at Qx,Py
  put char T + 2 at Px,Qy
  put char T + 3 at Qx,Qy
  return

data TitleW bytes
  1, 12, 16, 8, 1, 1, 14, 24, 9, 5, 20, 25
end data

' the title: ALPHA ANXIETY in letter tiles, the tune once, PLAY / CREDITS
sub TitlePage:
  u8 Ln = 0
  Gs = 0
  NewScreen
  for Ci = 0 to 4
    X = Ci * 3 + 8
    Ln = TitleW[Ci]
    BigLetter(Ln, X, 2)
  next
  for Ci = 5 to 11
    X = (Ci - 5) * 3 + 5
    Ln = TitleW[Ci]
    BigLetter(Ln, X, 5)
  next
  print at 4,9, "COMPUTE!'S GAZETTE 1985"
  print at 3,11, "FIND THE LETTERS A TO Y"
  print at 3,12, "IN ORDER BEFORE THE TIME"
  print at 3,13, "RUNS OUT. 10 SECONDS OFF"
  print at 3,14, "FOR EACH WRONG LETTER."
  print at 12,17, "PLAY"
  print at 12,18, "CREDITS"
  if Hs > 0 then
    print at 8,21, "HIGH SCORE"
    print HsB at 19,21
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,17
  put char 32 at 10,18
  J = Menu + 17
  put char 62 at 10,J
  return

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "ALPHA ANXIETY"
  print at 2,4, "BASED ON ALPHA ANXIETY,"
  print at 2,5, "COMPUTE!'S GAZETTE, MARCH"
  print at 2,6, "1985 (COMMODORE 64 AND"
  print at 2,7, "VIC-20). NO AUTHOR NAMED."
  print at 2,9, "THE CURSOR SHOWS THE LETTER"
  print at 2,10, "UNDER IT. PICK A TO Y IN"
  print at 2,11, "ORDER; LATER Y TO A."
  print at 2,14, "COLECOVISION GAME, MUSIC"
  print at 2,15, "AND PICTURES BY CLAUDE"
  print at 2,16, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,17, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,19, "MUSIC: RACING THE CLOCK"
  print at 2,20, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$C0,$C0,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00
  $01,$03,$03,$03,$03,$03,$03,$03
  $C0,$C0,$C0,$C0,$C0,$C0,$C0,$C0
  $03,$03,$03,$03,$03,$03,$03,$03
