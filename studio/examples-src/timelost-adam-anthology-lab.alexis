project "TIMELOST ADAM ANTHOLOGY LAB"
cartridge "TIMELOST ANTHOLOGY/AMY STUDIO/2026"

' Experimental front-end for the planned multi-file Coleco ADAM anthology.
' The nine standalone chapters are available separately in the example browser.
' Each chapter is loaded from the EOS disk into ADAM expansion RAM and launched
' as a real OS7 game. Persistent unlocks and Hall of Fame records remain future
' work until every chapter completion condition is proven.

u8 Choice = 0
const MenuTuneA = 1
const MenuTuneB = 2

  text screen
  set sound table TimelostSoundTable areas 2
  cls
  print centered at 8, "LOADING TIMELOST"
  screen on
  wait 18 frames
  print centered at 10, "."
  wait 18 frames
  print centered at 10, ". ."
  wait 18 frames
  print centered at 10, ". . ."
  wait 24 frames

main_menu:
  text screen
  cls
  print centered at 1, "TIMELOST"
  print centered at 3, "ADAM ANTHOLOGY LAB"
  print at 5,7, "1  STORY MODE"
  print at 5,10, "2  CHAPTERS"
  print at 5,13, "3  HALL OF FAME"
  print centered at 18, "STICK AND FIRE"
  screen on
  play sound MenuTuneA
  play sound MenuTuneB
  Choice = 1
  choose menu 1 to 3 into Choice cursor $3E at 3,7 step 3
  stop sound MenuTuneA
  stop sound MenuTuneB
  mute all
  cls
  print centered at 9, "LOADING"
  wait 30 frames

  if Choice = 1 goto story_mode
  if Choice = 2 goto chapter_list
  goto hall_of_fame

story_mode:
  cls
  print centered at 1, "STORY MODE"
  print at 2,4, "ERIN AND JACQUE ARE LOST"
  print at 2,6, "ACROSS NINE MOMENTS IN TIME."
  print at 2,9, "NEXT: TIME WARP!"
  print at 2,12, "FIRE BEGINS THE FIRST CHAPTER"
  print centered at 19, "TIME WARP AWAITS"
  pause until press and release
  Choice = 1
  screen off
  call asm TimelostLaunchChapter with a = Choice
  loop forever

asm {
TimelostSoundTable:
    dw TimelostMenuLead,$702B
    dw TimelostMenuBass,$703F

; A restrained two-channel theme for the anthology director.
TimelostMenuLead:
    db $44
    dw sndtiny_1
    db 11
    ; D minor call: two voices, then the lead hangs alone over a bass rest.
    db $02,$30,$1A,$21,$20,$00,$23,$25,$27,$00,$25,$00,$23,$00,$20,$00
    db $1B,$00,$20,$00,$23,$25,$27,$00,$02,$10,$1A,$21,$2A,$00,$28,$27
    db $25,$00,$23,$00,$00,$01,$00,$01,$02,$30,$1A,$21,$20,$23,$25,$00
    ; Second phrase: occasional vibrato ($80+note), rests and a quiet answer.
    db $27,$00,$A8,$00,$27,$25,$A3,$00,$20,$00,$1E,$00,$20,$23,$A5,$00
    db $02,$10,$1A,$21,$AA,$00,$28,$27,$A5,$00,$23,$00,$02,$30,$1A,$21
    db $A0,$00,$9E,$00,$A0,$00,$00,$01,$02,$10,$1A,$21,$A7,$00,$00,$01
    db $00,$00,$00,$00
    db $FF
TimelostMenuBass:
    db $84
    dw sndtiny_2
    db 11
    ; The bass deliberately leaves holes so the melody sometimes stands alone.
    db $02,$50,$18,$32,$08,$00,$08,$00,$03,$00,$08,$00,$08,$00,$03,$00
    db $06,$00,$00,$01,$0A,$00,$05,$00,$05,$00,$0A,$00,$05,$00,$03,$00
    db $00,$01,$08,$00,$03,$00,$08,$00,$02,$50,$18,$32,$08,$00,$08,$00
    db $03,$00,$08,$00,$0A,$00,$00,$01,$05,$00,$0A,$00,$05,$00,$05,$00
    db $02,$30,$18,$32,$08,$00,$00,$01,$08,$00,$00,$01,$03,$00,$08,$00
    db $FF
}

chapter_list:
  cls
  print centered at 0, "CHAPTERS"
  print at 2,2, "1 TIME WARP!"
  print at 2,4, "2 THE LANGUAGE BARRIER"
  print at 2,6, "3 BATTLE AT STONEHENGE"
  print at 2,8, "4 SLIME CREATURES 3-D"
  print at 2,10, "5 PERIL OF THE PITDEMONS"
  print at 2,12, "6 CAVERNS OF CARNAGE"
  print at 2,14, "7 DUNGEON SHADOWS"
  print at 2,16, "8 ESCAPE"
  print at 2,18, "9 ROCKFALL!"
  print at 2,21, "SELECT A CHAPTER"
  Choice = 1
  choose menu 1 to 9 into Choice cursor $3E at 0,2 step 2
  mute all
  screen off
  call asm TimelostLaunchChapter with a = Choice
  loop forever

asm {
TimelostLaunchChapter:
    ld ($20F0),a
    jp $2003
}

hall_of_fame:
  cls
  print centered at 1, "HALL OF FAME"
  print at 3,5, "TIME WARP       AMY  1000"
  print at 3,8, "LANGUAGE        ---     0"
  print at 3,11, "STONEHENGE      ---     0"
  print at 3,14, "SLIME CREATURES ---     0"
  print centered at 18, "DISK SCORES ARE PLANNED"
  print centered at 20, "FIRE TO RETURN"
  pause until press and release
  goto main_menu
