cartridge "LASER STRIKE/PRESENTS COMPUTE!'S/1986"

' LASER STRIKE
' From COMPUTE! magazine, December 1986, pages 44-55: "Laser Strike" by
' Barbara Schulak (Commodore 64), with versions for the Apple II and the
' IBM PC/PCjr by Tim Midkiff, the Amiga by Tim Midkiff, the Atari 400,
' 800, XL and XE by Tim Midkiff and the Atari ST by Kevin Mykytyn,
' Editorial Programmers. All credit belongs to the authors.
'
' Historical context (summary of the article):
' A strategy game for one or two players, after the board games, the most
' famous being Battleship, but in outer space. Each player secretly
' deploys a space force (an Explorer, a Fighter, a Bomber and a
' Mothership) on a ten-by-ten galaxy grid, then the players take turns
' firing laser strikes at the other's grid. A hit is marked in the colour
' of the ship that was hit; a miss in a neutral colour. The first to find
' and destroy all the other's ships wins. Leave a name blank and the
' computer plays that side; leave both blank and it plays the whole game
' by itself. Ships go horizontally (right) or vertically (down), never
' across the border or over another ship. The Amiga version spoke.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the stick moves the cursor; fire deploys a ship (then the
' stick picks right or down) or fires the laser. With two joysticks each
' player uses his own; with one, both share it.
' The rules follow the listings: two grids, ten by ten (C64 lines 230-
' 290); the ships and their lengths, Explorer 2, Fighter 3, Bomber 4,
' Mothership 5, deployed from the largest (lines 300-360, 1770-1780);
' HORIZONTAL [RIGHT] OR VERTICAL [DOWN] and INVALID CHOICE (lines 1090-
' 1250); turns, POSITION AND FIRE LASER (lines 380-440); MISS!, ALREADY
' HIT, DIRECT HIT! and DESTROYED (lines 1410-1620); the hits left for
' each ship shown under the grids (lines 270-290); ... HAS FREED THE
' GALAXY! and PLAY AGAIN (lines 480-590); the computer's own deployment
' and its laser strikes, at random on alternate squares until it hits,
' then along the ship it found (lines 610-880).
' Adaptation liberties: names picked with the joystick (no keypad), and
' a menu instead of a blank name to choose the computer; a square
' already hit is refused and another one picked, instead of losing the
' turn; the laser is a bolt that flies across to its square, and bursts
' or fizzles; the computer finds a ship's direction from the colour of
' its hits, as a player would; against the computer your own fleet
' stays on show; at the end both fleets are shown; "HIT", "MISS" and
' "DESTROYED" are spoken, after the Amiga version (formant-synthesized
' speech, VoxPCM samples on the standard sound chip); the big title; an
' original title tune; an editorial page. Everything that matters stays
' in columns 2-29, inside the TV overscan. At most four sprites share a
' line. The frame loop is protected from the NMI.

const TEmpty = 128
const TMiss = 137
const TStar = 171
const TStar2 = 172
const TBlock = 173
const TGone = 170
const GridY = 6

const SndLaser = 1
const SndBoomN = 2
const SndBoomT = 3
const SndFizzle = 4
const SndSunk = 5
const SndPlace = 6
const SndTick = 7
const SndNope = 8
const SndWinA = 9
const SndWinB = 10
const SndPick = 11
const SndTuneA = 12
const SndTuneB = 13

u8 PType[2]                     ' 0 human, 1 computer
u8 Nm[16]                       ' two names of 8 letters
u8 Sticks = 1
u8 Gr[200]                      ' each square: bits 0-2 the ship on it (2-5),
                                ' bits 3-5 which part of its picture,
                                ' bit 6 missed, bit 7 hit
u8 Left[12]                     ' hits each ship can still take
u8 Tot[2]
u8 PP = 0                       ' the player whose turn it is
u8 Opp = 1
u8 Show0 = 0
u8 Show1 = 0
u8 CX = 0
u8 CY = 0
u8 TX = 0
u8 TY = 0
u8 Shp = 0
u8 HitShip = 0
u8 ShipSunk = 0
u8 Hor = 0
u8 Bad = 0
u8 Stick = 0
u8 Btn = 0
u8 BtnWas = 0
u8 Pad = 1
u8 MoveT = 0
u8 Tick = 0
u8 GC = 0
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 Q = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tm = 0
u8 Cell = 0
u8 Best = 0
u8 Mix = 0
u8 Choice = 1
i16 Sx = 0
i16 Sy = 0
i16 Dx = 0
i16 Dy = 0
i16 Tv = 0
u16 Dst16 = 0
u16 NumU = 0

  tile screen
  set sound table LsSoundTable areas 4
  sprites 16x16
  sprites stable 0 to 0
  sprites flicker on
  copy SpritePat count 160 to vram.spr_pat
  HideSprites
  LoadTiles
  screen on
  EditorialPage

title:
  TitlePage
  Setup

new_game:
  for I = 0 to 199
    Gr[I] = 0
  next
  for P = 0 to 1
    Tot[P] = 14
    for N = 2 to 5
      V = P * 6
      V += N
      Left[V] = N
    next
  next
  ' Against the computer, your own fleet stays on show
  Show0 = 0
  Show1 = 0
  if PType[1] = 1 then Show0 = 1
  if PType[0] = 1 then Show1 = 1
  if PType[0] = 1 then
    if PType[1] = 1 then
      Show0 = 1
      Show1 = 1
    end if
  end if
  DrawScreen
  ' Lines 300-360: each player deploys, in secret
  for PP = 0 to 1
    Deploy
  next
  DrawScreen
  PP = 0

  ' --- Lines 380-440: the battle ---
turn_loop:
  Opp = 1 - PP
  Header
  print at 2,1, "POSITION AND FIRE LASER"
  ShowLabels
  if PType[PP] = 0 then
    AimHuman
  else
    AimComputer
  end if
  FireLaser
  if Tot[Opp] = 0 then goto freed
  Rearm
  wait 40 frames
  nmi off
  PP = Opp
  goto turn_loop

  ' --- Lines 480-590: one side has freed the galaxy ---
freed:
  HideSprites
  play sound SndWinA
  play sound SndWinB
  Show0 = 1
  Show1 = 1
  for P = 0 to 1
    DrawGrid
  next
  fill 32 count 28 at 2,0
  fill 32 count 28 at 2,1
  P = PP
  PrintName
  print at 11,0, "HAS FREED"
  print at 9,1, "THE GALAXY!"
  Rearm
  wait 180 frames
  nmi off
  fill 32 count 28 at 2,23
  print at 6,23, "PLAY AGAIN"
  print at 18,23, "YES  NO"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 17,23 step 5 horizontal
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

' Re-arm the VDP interrupt before waiting: "nmi on" reads the VDP status,
' so a frame interrupt lost to the guard race cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

' The stick of the player whose turn it is (or either, with one joystick)
sub ReadStick:
  Stick = 0
  Btn = 0
  Pad = 0
  if Sticks = 2 then Pad = PP + 1
  if Pad <> 2 then
    if joypad(1).up then Stick = 1
    if joypad(1).down then Stick = 2
    if joypad(1).left then Stick = 3
    if joypad(1).right then Stick = 4
    if joypad(1).fire then Btn = 1
  end if
  if Pad <> 1 then
    if joypad(2).up then Stick = 1
    if joypad(2).down then Stick = 2
    if joypad(2).left then Stick = 3
    if joypad(2).right then Stick = 4
    if joypad(2).fire then Btn = 1
  end if
  return
end sub

' Move the cursor on grid P by the stick, a square every 8 frames
sub MoveCursor:
  if MoveT > 0 then
    dec MoveT
    return
  end if
  if Stick = 0 then return
  if Stick = 1 then
    if CY > 0 then dec CY
  elseif Stick = 2 then
    if CY < 9 then inc CY
  elseif Stick = 3 then
    if CX > 0 then dec CX
  else
    if CX < 9 then inc CX
  end if
  MoveT = 7
  play sound SndTick
  return
end sub

sub DrawCursor:
  GC = P * 14
  GC += 3
  X = GC + CX
  X *= 8
  X -= 1
  Y = CY + GridY
  Y *= 8
  Y -= 2
  K = 15
  N = Tick & 8
  if N > 0 then K = 13
  set sprite 0 to Y,X,0,K
  update sprites
  return
end sub

' --- Deployment ---------------------------------------------------------------

sub Deploy:
  P = PP
  if PType[PP] = 1 then
    ComputerDeploy
    return
  end if
  ' The other player must not watch
  V = 1 - PP
  if PType[V] = 0 then
    HideSprites
    for P = 0 to 1
      DrawGrid
    next
    P = PP
    Header
    print at 2,1, "THE OTHER PLAYER LOOKS"
    print at 2,2, "AWAY. THEN PRESS FIRE."
    Rearm
    wait no fire
    pause until press
    wait no fire
    nmi off
    fill 32 count 28 at 2,2
  end if
  ' Show this fleet while it is placed
  if PP = 0 then
    Q = Show0
    Show0 = 1
  else
    Q = Show1
    Show1 = 1
  end if
  CX = 0
  CY = 0
  for Shp = 5 to 2 step -1
deploy_one:
    Header
    print at 2,1, "DEPLOY YOUR"
    ShipName
    fill 32 count 28 at 2,2
    ' Pick the square
    Rearm
    wait no fire
    nmi off
pick_square:
    inc Tick
    ReadStick
    MoveCursor
    P = PP
    DrawCursor
    Rearm
    wait
    nmi off
    if Btn = 0 then goto pick_square
    ' Lines 1090-1120: which way?
    play sound SndPick
    print at 2,2, "HORIZONTAL [RIGHT] OR"
    print at 2,3, "VERTICAL [DOWN]"
    Rearm
    wait no fire
    nmi off
which_way:
    inc Tick
    ReadStick
    P = PP
    DrawCursor
    Rearm
    wait
    nmi off
    if Stick = 4 then
      Hor = 1
    elseif Stick = 2 then
      Hor = 0
    else
      goto which_way
    end if
    fill 32 count 28 at 2,2
    fill 32 count 28 at 2,3
    TX = CX
    TY = CY
    TryPlace
    if Bad = 1 then
      ' Lines 1220-1250: INVALID CHOICE
      play sound SndNope
      print at 2,2, "INVALID CHOICE"
      Rearm
      wait 50 frames
      nmi off
      fill 32 count 28 at 2,2
      goto deploy_one
    end if
    play sound SndPlace
    P = PP
    DrawGrid
  next
  HideSprites
  Rearm
  wait 30 frames
  nmi off
  ' Hide it again if the other player is a person
  if PP = 0 then
    Show0 = Q
  else
    Show1 = Q
  end if
  P = PP
  DrawGrid
  return
end sub

' Can ship Shp go at TX,TY on grid PP, Hor (1 right, 0 down)? If so, place it
sub TryPlace:
  Bad = 0
  N = Shp - 1
  if Hor = 1 then
    V = TX + N
  else
    V = TY + N
  end if
  if V > 9 then
    Bad = 1
    return
  end if
  X = TX
  Y = TY
  for K = 1 to Shp
    Cell = Y * 10
    Cell += X
    V = PP * 100
    Cell += V
    V = Gr[Cell] & 7
    if V <> 0 then Bad = 1
    if Hor = 1 then
      inc X
    else
      inc Y
    end if
  next
  if Bad = 1 then return
  X = TX
  Y = TY
  for K = 1 to Shp
    Cell = Y * 10
    Cell += X
    V = PP * 100
    Cell += V
    ' its picture: the ends and the middle, across or down
    V = 1
    if K = 1 then V = 0
    if K = Shp then V = 2
    if Hor = 0 then V += 3
    V <<= 3
    V += Shp
    Gr[Cell] = V
    if Hor = 1 then
      inc X
    else
      inc Y
    end if
  next
  return
end sub

' A random square and direction. Successive random() calls repeat in a
' short cycle here, so one call is spread out with a running offset
sub RandCell:
  V = random(0, 199)
  V += Mix
  if V >= 200 then V -= 200
  Mix += 73
  if Mix >= 200 then Mix -= 200
  TX = V % 10
  TY = V / 10
  Hor = 0
  if TY >= 10 then
    TY -= 10
    Hor = 1
  end if
  return
end sub

' Lines 610-700: the computer's fleet, placed at random
sub ComputerDeploy:
  for Shp = 5 to 2 step -1
cd_try:
    RandCell
    TryPlace
    if Bad = 1 then goto cd_try
  next
  P = PP
  DrawGrid
  return
end sub

' --- The battle ---------------------------------------------------------------

' A person picks a square on the other grid
sub AimHuman:
  P = Opp
  Rearm
  wait no fire
  nmi off
aim_loop:
  inc Tick
  ReadStick
  MoveCursor
  P = Opp
  DrawCursor
  Rearm
  wait
  nmi off
  if Btn = 0 then goto aim_loop
  Cell = CY * 10
  Cell += CX
  V = Opp * 100
  Cell += V
  V = Gr[Cell] >> 6
  if V <> 0 then
    ' ALREADY HIT: pick another
    play sound SndNope
    print at 2,23, "ALREADY HIT"
    Rearm
    wait 40 frames
    wait no fire
    nmi off
    fill 32 count 28 at 2,23
    goto aim_loop
  end if
  TX = CX
  TY = CY
  return
end sub

' Lines 610-880: the computer's strike: along a ship it has found, or
' at random on alternate squares
sub AimComputer:
  Best = 255
  ' A ship hit but not destroyed? Its colour tells which one
  for Shp = 2 to 5
    V = Opp * 6
    V += Shp
    N = Left[V]
    if N > 0 then
      if N < Shp then
        if Best = 255 then Hunt
      end if
    end if
  next
  if Best = 255 then
    ' At random, on the squares of one colour of a chequerboard (from a
    ' random start, the first free one; any free square once those are gone)
    RandCell
    G = TY * 10
    G += TX
    for J = 0 to 1
      for I = 0 to 99
        Q = G + I
        if Q >= 100 then Q -= 100
        V = Opp * 100
        V += Q
        N = Gr[V] >> 6
        if N = 0 then
          TX = Q % 10
          TY = Q / 10
          if J = 1 then goto aim_found
          N = TX + TY
          N &= 1
          if N = 0 then goto aim_found
        end if
      next
    next
aim_found:
  end if
  ' The cursor glides there, for the players to follow
  P = Opp
  for Tm = 1 to 40
    inc Tick
    if CX < TX then inc CX
    if CX > TX then dec CX
    if CY < TY then inc CY
    if CY > TY then dec CY
    DrawCursor
    Rearm
    wait 2 frames
    nmi off
  next
  return
end sub

' Ship Shp of player Opp has been hit: shoot next to its hits, along
' their line when there are two or more
sub Hunt:
  ' Where are its hits?
  I = 0
  K = 0
  for Cell = 0 to 99
    V = Opp * 100
    V += Cell
    N = Gr[V] >> 6
    if N = 2 then
      N = Gr[V] & 7
      if N = Shp then
        if I = 0 then
          X = Cell % 10
          Y = Cell / 10
        else
          ' a second hit: the line is known
          N = Cell % 10
          if N = X then
            K = 2
          else
            K = 1
          end if
        end if
        inc I
      end if
    end if
  next
  ' Walk from the first hit both ways along the line (or all four ways)
  for J = 0 to 3
    if K = 1 then
      if J < 2 then goto hunt_next
    end if
    if K = 2 then
      if J >= 2 then goto hunt_next
    end if
    TX = X
    TY = Y
hunt_step:
    if J = 0 then
      if TY = 0 then goto hunt_next
      dec TY
    elseif J = 1 then
      if TY = 9 then goto hunt_next
      inc TY
    elseif J = 2 then
      if TX = 0 then goto hunt_next
      dec TX
    else
      if TX = 9 then goto hunt_next
      inc TX
    end if
    Cell = TY * 10
    Cell += TX
    V = Opp * 100
    Cell += V
    V = Gr[Cell] >> 6
    if V = 0 then
      Best = 1
      return
    end if
    if V = 2 then
      V = Gr[Cell] & 7
      if V = Shp then goto hunt_step
    end if
hunt_next:
  next
  return
end sub

' The laser: a bolt from the shooter's grid to the square, then the result
sub FireLaser:
  play sound SndLaser
  ' from the middle of the shooter's grid
  N = PP * 14
  N += 8
  N *= 8
  Sx = N
  Sy = 76
  N = Opp * 14
  N += 3
  N += TX
  N *= 8
  N -= 4
  Dx = N
  Dx -= Sx
  N = TY + GridY
  N *= 8
  N -= 5
  Dy = N
  Dy -= Sy
  for Tm = 0 to 20
    Tv = Dx * Tm
    Tv /= 20
    Tv += Sx
    X = Tv
    Tv = Dy * Tm
    Tv /= 20
    Tv += Sy
    Y = Tv
    set sprite 1 to Y,X,4,11
    update sprites
    Rearm
    wait
    nmi off
  next
  set sprite 1 to 192,0,0,0
  Cell = TY * 10
  Cell += TX
  V = Opp * 100
  Cell += V
  fill 32 count 28 at 2,23
  Shp = Gr[Cell] & 7
  if Shp = 0 then
    ' MISS!
    Gr[Cell] |= 64
    play sound SndFizzle
    for Tm = 0 to 20
      set sprite 1 to Y,X,16,14
      update sprites
      Rearm
      wait
      nmi off
    next
    set sprite 1 to 192,0,0,0
    update sprites
    P = Opp
    DrawGrid
    print at 2,23, "MISS!"
    play voxpcm SayMiss
    nmi off
    return
  end if
  ' DIRECT HIT!
  Gr[Cell] |= 128
  play sound SndBoomN
  play sound SndBoomT
  for Tm = 0 to 24
    N = Tm & 4
    P = 8
    if N > 0 then P = 12
    K = 11
    if Tm > 12 then K = 8
    set sprite 1 to Y,X,P,K
    update sprites
    Rearm
    wait
    nmi off
  next
  set sprite 1 to 192,0,0,0
  update sprites
  P = Opp
  DrawGrid
  V = Opp * 6
  HitShip = Shp
  V += HitShip
  dec Left[V]
  dec Tot[Opp]
  ShipSunk = 0
  if Left[V] = 0 then ShipSunk = 1
  DrawLegend
  Shp = HitShip
  if ShipSunk = 1 then
    ' A fatal hit is announced once, with the destroyed ship identified.
    play sound SndSunk
    fill 32 count 28 at 2,23
    print at 2,23, "DESTROYED"
    X = 12
    Y = 23
    ShipNameAt
    if Shp = 2 then
      play voxpcm SayDestroyedExplorer
    else if Shp = 3 then
      play voxpcm SayDestroyedFighter
    else if Shp = 4 then
      play voxpcm SayDestroyedBomber
    else
      play voxpcm SayDestroyedMothership
    end if
    nmi off
  else
    print at 2,23, "DIRECT HIT!"
    play voxpcm SayHit
    nmi off
  end if
  return
end sub

' --- Drawing ------------------------------------------------------------------

sub DrawScreen:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  backdrop black
  cls
  ' A field of stars
  for I = 1 to 40
    X = random(2, 29)
    Y = random(0, 23)
    N = I & 1
    N += TStar
    put char N at X,Y
  next
  for P = 0 to 1
    DrawBorder
    DrawGrid
  next
  for P = 0 to 1
    DrawLegend
  next
  ' The legend's names, Mothership first
  print at 10,18, "MOTHERSHIP"
  print at 12,19, "BOMBER"
  print at 12,20, "FIGHTER"
  print at 11,21, "EXPLORER"
  ShowLabels
  return
end sub

sub DrawBorder:
  GC = P * 14
  GC += 3
  X = GC - 1
  K = GC + 10
  put char 133 at X,5
  put char 134 at K,5
  put char 135 at X,16
  put char 136 at K,16
  fill 129 count 10 at GC,5
  fill 132 count 10 at GC,16
  for Y = 6 to 15
    put char 130 at X,Y
    put char 131 at K,Y
  next
  return
end sub

' Grid P: its shots, and its ships when they are on show
sub DrawGrid:
  GC = P * 14
  GC += 3
  Q = Show0
  if P = 1 then Q = Show1
  Cell = P * 100
  for Y = 0 to 9
    for X = 0 to 9
      G = Gr[Cell]
      V = G >> 6
      K = G & 7
      if V = 1 then
        N = TMiss
      elseif V = 2 then
        N = K + 136
      else
        N = TEmpty
        if Q = 1 then
          if K > 0 then
            N = K - 2
            N *= 6
            V = G >> 3
            V &= 7
            N += V
            N += 142
          end if
        end if
      end if
      I = GC + X
      J = Y + GridY
      put char N at I,J
      inc Cell
    next
  next
  return
end sub

' Lines 270-290: player P's fleet, the squares each ship has left
sub DrawLegend:
  for Shp = 2 to 5
    Y = 23 - Shp
    V = P * 6
    V += Shp
    N = Left[V]
    for K = 0 to 4
      X = K + 3
      if P = 1 then X = 28 - K
      J = 32
      if K < Shp then
        J = TGone
        if K < N then J = Shp + 164
      end if
      put char J at X,Y
    next
  next
  return
end sub

' GRID 1, GRID 2: the grid under fire stands out
sub ShowLabels:
  fill 32 count 28 at 2,4
  print at 6,4, "GRID 1"
  print at 20,4, "GRID 2"
  if PP = 0 then
    print at 18,4, ">"
    print at 27,4, "<"
  else
    print at 4,4, ">"
    print at 13,4, "<"
  end if
  return
end sub

' The current player's name on the top line
sub Header:
  fill 32 count 28 at 2,0
  fill 32 count 28 at 2,1
  P = PP
  PrintName
  return
end sub

sub PrintName:
  if PType[P] = 1 then
    print at 2,0, "COMPUTER"
    return
  end if
  for I = 0 to 7
    V = P * 8
    V += I
    N = Nm[V]
    X = I + 2
    put char N at X,0
  next
  return
end sub

' The name of ship Shp, after "DEPLOY YOUR" on line 1
sub ShipName:
  X = 14
  Y = 1
  ShipNameAt
  return
end sub

sub ShipNameAt:
  if Shp = 2 then
    print at X,Y, "EXPLORER"
  elseif Shp = 3 then
    print at X,Y, "FIGHTER"
  elseif Shp = 4 then
    print at X,Y, "BOMBER"
  else
    print at X,Y, "MOTHERSHIP"
  end if
  return
end sub

' --- Setup --------------------------------------------------------------------

' Who plays, how many joysticks, and the names (lines 160-210)
sub Setup:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  cls
  LoadTiles
  print at 9,2, "LASER STRIKE"
  for P = 0 to 1
    Y = P * 5
    Y += 5
    print at 4,Y, "PLAYER"
    NumU = P + 1
    print at 11,Y, digits$(NumU, 1)
    inc Y
    print at 8,Y, "PERSON"
    inc Y
    print at 8,Y, "COMPUTER"
    V = Y - 1
    Choice = 1
    if P = 1 then Choice = 2
    Rearm
    wait no fire
    choose menu 1 to 2 into Choice cursor $3E at 6,V step 1
    wait no fire
    nmi off
    PType[P] = Choice - 1
    play sound SndPick
  next
  Sticks = 1
  if PType[0] = 0 then
    if PType[1] = 0 then
      print at 4,15, "JOYSTICKS"
      print at 8,16, "ONE, TO SHARE"
      print at 8,17, "TWO"
      Choice = 2
      Rearm
      wait no fire
      choose menu 1 to 2 into Choice cursor $3E at 6,16 step 1
      wait no fire
      nmi off
      Sticks = Choice
    end if
  end if
  ' The names, picked with the stick
  for P = 0 to 1
    if PType[P] = 0 then EnterName
  next
  return
end sub

' Up and down change the letter, left and right move, fire is done
sub EnterName:
  cls
  print at 9,6, "PLAYER"
  NumU = P + 1
  print at 16,6, digits$(NumU, 1)
  print at 9,7, "YOUR NAME:"
  print at 3,14, "STICK: LETTERS, FIRE: DONE"
  PP = P
  ' start from "PLAYER 1" or "PLAYER 2"
  V = P * 8
  if Nm[V] = 0 then
    for I = 0 to 7
      V = P * 8
      V += I
      Nm[V] = DefName[I]
    next
    V = P * 8
    V += 7
    Nm[V] = 49 + P
  end if
  I = 0
  Rearm
  wait no fire
  nmi off
name_loop:
  for J = 0 to 7
    X = J + 12
    V = P * 8
    V += J
    N = Nm[V]
    put char N at X,10
  next
  fill 32 count 8 at 12,11
  X = I + 12
  put char 94 at X,11
  Rearm
  wait 7 frames
  nmi off
  ReadStick
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    return
  end if
  V = P * 8
  V += I
  N = Nm[V]
  if Stick = 1 then
    ' A-Z, then a space
    if N = 32 then
      N = 65
    elseif N >= 90 then
      N = 32
    else
      inc N
    end if
    play sound SndTick
  elseif Stick = 2 then
    if N = 32 then
      N = 90
    elseif N <= 65 then
      N = 32
    else
      dec N
    end if
    play sound SndTick
  elseif Stick = 3 then
    if I > 0 then dec I
  elseif Stick = 4 then
    if I < 7 then inc I
  end if
  if N < 32 then N = 32
  if N > 32 then
    if N < 48 then N = 65
  end if
  if N > 57 then
    if N < 65 then N = 65
  end if
  Nm[V] = N
  goto name_loop
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 376 to vram.pattern + Dst16
    copy TileCol count 376 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub TitlePage:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  backdrop black
  cls
  for I = 1 to 50
    X = random(2, 29)
    Y = random(0, 23)
    N = I & 1
    N += TStar
    put char N at X,Y
  next
  ' LASER STRIKE in big blocks
  for I = 0 to TitleCount - 1
    J = I * 2
    X = TitleBlocks[J]
    X += 4
    inc J
    Y = TitleBlocks[J]
    Y += 3
    put char TBlock at X,Y
  next
  fill 174 count 28 at 2,15
  print at 8,17, "COMPUTE! DEC. 1986"
  print at 5,20, "PRESS FIRE TO DEPLOY"
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
  Tm = 0
title_loop:
  ' A bolt crosses the sky now and then
  inc Tm
  X = Tm * 2
  set sprite 1 to 116,X,4,11
  update sprites
  Rearm
  wait
  nmi off
  if joypad(1).fire then goto title_go
  if joypad(2).fire then goto title_go
  goto title_loop
title_go:
  play sound SndPick
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  HideSprites
  return
end sub

sub EditorialPage:
  nmi off
  HideSprites
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 9,1, "LASER STRIKE"
  print at 2,3, "BY BARBARA SCHULAK, FROM"
  print at 2,4, "COMPUTE! MAGAZINE,"
  print at 2,5, "DECEMBER 1986, WITH ITS"
  print at 2,6, "APPLE, PC, AMIGA, ATARI"
  print at 2,7, "AND ST VERSIONS BY TIM"
  print at 2,8, "MIDKIFF AND KEVIN MYKYTYN."
  print at 2,10, "BATTLESHIP, IN OUTER SPACE:"
  print at 2,11, "HIDE YOUR FLEET, THEN FIND"
  print at 2,12, "AND VAPORIZE THE OTHER"
  print at 2,13, "ONE, A LASER STRIKE AT A"
  print at 2,14, "TIME. LIKE THE AMIGA, THIS"
  print at 2,15, "ONE TALKS."
  print at 2,17, "COLECOVISION PORT BY"
  print at 2,18, "AMY BIENVENU, 2026."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

