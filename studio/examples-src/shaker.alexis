cartridge "SHAKER/JOHN FEDOR, AHOY!/1986"

' SHAKER
' Based on "Shaker" by John Fedor, Ahoy! June 1986 (page 45): a shell
' game with pop cans for the Commodore 64. Made for the ColecoVision in
' Amy (the language by Amy Bienvenu) by Claude (an AI made by Anthropic)
' for Amy Studio, 2026.
'
' Not a port: the C64 listing is machine code (Flankspeed), so this is a
' ColecoVision game on the article's rules (orig/ has the scans). Kept:
' seven red pop cans; you choose the level (1-5) at the start, no penalty
' for starting higher, more points; the computer shakes six of the cans,
' you remember the one that was NOT shaken; then it shuffles the cans
' about 15 times, slower at low levels; you move the selector over a can
' and press the button: the right can makes a happy noise and scores,
' a wrong one sprays you with pop. Three misses end the game ("you get
' three attempts per game"); the best score is kept for the session.
' The article says level 11 is "truly for the super eye": each right
' answer raises the level by one, up to 11, and each level shuffles
' faster and scores more (50 points times the level).
'
' Made for this machine: a soda fountain (striped wallpaper, a chrome
' sign, a mirror behind the counter, a marble top); the resting cans are
' tiles (seven cans of two sprites each would put 14 sprites on one line,
' the VDP shows 4), the shaken cans jiggle by swapping their tiles, and
' the two cans being swapped become sprites that cross in arcs (2 cans x
' 2 sprites = 4 on a line, the limit); the selector is an arrow that
' pulses gently (a colour change every half second); a fizzing spray;
' music under play, quieter than the effects; an original title tune,
' "Fizz Pop".
'
' Controls (either joystick): left and right move the selector, the left
' button opens a can. On the title: up and down choose, left and right
' set the level, a button picks.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait; nothing flashes faster than 3 times a
' second.

const TWall = 128
const TChrome = 129
const TChromev = 130
const TMirror = 131
const TTop = 132
const TTrim = 133
const TArl = 134
const TArr = 135
const TArlg = 136
const TArrg = 137
const TFront = 138
const TCana00 = 139
const TCana01 = 140
const TCana10 = 141
const TCana11 = 142
const TCanb00 = 143
const TCanb01 = 144
const TCanb10 = 145
const TCanb11 = 146
const TCanc00 = 147
const TCanc01 = 148
const TCanc10 = 149
const TCanc11 = 150
const SCanhi = 0
const SCanred = 4
const SArrow = 8
const SSpray1 = 12
const SSpray2 = 16
const SStar = 20
const NTiles8 = 184
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndPlayA = 3
const SndPlayB = 4
const SndChk = 5
const SndRattle = 6
const SndHiss = 7
const SndPop = 8
const SndDing = 9
const SndSwish = 10
const SndTick = 11
const SndOver = 12
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the game: Odd the slot (0-6) of the can that was not shaken; Lv the
' level (1-11), StartLv the level chosen (1-5); Tries the misses left;
' Ph 0 title, 1 the shake, 2 the shuffle, 3 choosing, 4 the answer, 5 the
' game over; Sel the slot under the selector; SwA SwB the last swap and
' Nsw the swaps so far this round (for the tests); LastOk 1 if the last
' answer was right
u8 Odd = 0
u8 Lv = 1
u8 StartLv = 1
u8 Tries = 3
u8 Ph = 0
u8 Sel = 3
u8 SwA = 0
u8 SwB = 1
u8 Nsw = 0
u8 LastOk = 0
u8 Pick = 0
u16 Score = 0
u16 Hi = 0
u16 Gain = 0
u16 Rounds = 0
u16 Rs = $5A3C
u16 T16 = 0

' the swap's arc: the two cans' screen places, the length in frames
u8 Xa = 0
u8 Xb = 0
u8 Dx = 0
u8 Dd = 30
u8 Tt = 0
u8 Ya = 0
u8 Yb = 0
u8 Ax = 0
u8 Bx = 0
u16 P16 = 0
u16 D16 = 0
u16 W16 = 0

u16 NumU = 0
u8 Menu = 1
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
u8 Tm = 0
u8 Jg = 0
u8 Cs = 0
u8 Dk = 0
u8 Dv = 0
u8 Dxc = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Idle = 0

  tile screen
  set sound table SkSoundTable areas 6
  sprites 16x16
  set sprite count 6
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

new_game:
  Score = 0
  Tries = 3
  Lv = StartLv
  Rounds = 0
  Ph = 1
  DrawScene
  for K = 0 to 6
    DrawCan(K, 0)
  next
  ShowHud
  ClearMsg
  print at 9,5, "GET READY"
  ShowScreen
  play sound SndPlayA
  play sound SndPlayB
  for Tm = 1 to 60
    Frame1
  next

round:
  ' the shake: six cans jiggle, one stays still
  Nsw = 0
  RandSlot
  Odd = V
  Ph = 1
  ClearMsg
  print at 7,5, "WATCH THE CANS"
  play sound SndRattle
  for Tm = 1 to 96
    Frame1
    V = Tick & 3
    if V = 0 then
      V = Tick >> 2
      V = V & 3
      Jg = Jig[V]
      for K = 0 to 6
        if K <> Odd then DrawCan(K, Jg)
      next
    end if
    V = Tm & 15
    if V = 0 then play sound SndRattle
    ' chk chk chk: a short noise burst every 8 frames while they shake
    V = Tm & 7
    if V = 4 then play sound SndChk
  next
  for K = 0 to 6
    DrawCan(K, 0)
  next
  ClearMsg
  print at 7,5, "WHICH ONE WAS"
  print at 8,6, "NOT SHAKEN?"
  for Tm = 1 to 40
    Frame1
  next
  ' the shuffle: 15 swaps, each faster at a higher level
  Ph = 2
  V = Lv * 3
  Dd = 44 - V
  for N = 1 to 15
    RandSlot
    SwA = V
    W = V
    while W = SwA
      RandSlot
      W = V
    end while
    if W < SwA then
      SwB = SwA
      SwA = W
    else
      SwB = W
    end if
    SwapCans
    for Tm = 1 to 4
      Frame1
    next
  next

  ' choosing: the selector over a can, the button opens it
  Ph = 3
  ClearMsg
  print at 6,5, "PICK THE STILL CAN"
  Sel = 3
  WasStick = 1
  WasBtn = 1
  Rep = 0
choose_loop:
  Frame1
  ReadPad
  V = Lf1 | Rt1
  if V = 0 then
    WasStick = 0
    Rep = 0
  else
    if Rep > 0 then dec Rep
    W = 0
    if WasStick = 0 then W = 1
    if Rep = 0 then W = 1
    if W = 1 then
      if Lf1 = 1 then
        if Sel > 0 then dec Sel
      else
        if Sel < 6 then inc Sel
      end if
      play sound SndTick
      if WasStick = 0 then
        Rep = 14
      else
        Rep = 6
      end if
    end if
    WasStick = 1
  end if
  ' the arrow pulses gently: yellow and white, half a second each
  X = Sel << 5
  X = X + 24
  V = Tick & 32
  if V = 0 then
    set sprite 0 to 100,X,SArrow,11
  else
    set sprite 0 to 100,X,SArrow,15
  end if
  update sprites
  if Press = 0 then goto choose_loop

  ' the answer
  Ph = 4
  Pick = Sel
  set sprite 0 to 192,0,0,0
  update sprites
  play sound SndPop
  ClearMsg
  if Pick = Odd then
    LastOk = 1
    Gain = Lv
    Gain = Gain * 50
    Score = Score + Gain
    play sound SndDing
    print at 9,5, "RIGHT! +"
    NumU = Gain
    print at 17,5, digits$(NumU, 3)
    if Lv < 11 then inc Lv
    ' a sparkle bobs over the can
    X = Pick << 5
    X = X + 24
    for Tm = 1 to 70
      Frame1
      V = Tm & 15
      Y = 98
      if V < 8 then Y = 96
      set sprite 5 to Y,X,SStar,11
      update sprites
    next
  else
    LastOk = 0
    dec Tries
    play sound SndHiss
    print at 7,5, "PSSSHHT! WRONG"
    X = Pick << 5
    X = X + 24
    ' the can sprays: the spray rises and fizzes, the can jumps
    for Tm = 1 to 70
      Frame1
      V = Tm & 4
      Y = Tm >> 3
      Y = 100 - Y
      if V = 0 then
        set sprite 5 to Y,X,SSpray1,5
      else
        set sprite 5 to Y,X,SSpray2,5
      end if
      update sprites
      V = Tm & 3
      if V = 0 then
        V = Tm >> 2
        V = V & 3
        Jg = Jig[V]
        DrawCan(Pick, Jg)
      end if
    next
    DrawCan(Pick, 0)
    set sprite 5 to 192,0,0,0
    update sprites
    ' the still can was this one
    ClearMsg
    print at 7,5, "IT WAS THIS ONE"
    X = Odd << 5
    X = X + 24
    for Tm = 1 to 70
      Frame1
      set sprite 0 to 100,X,SArrow,3
      update sprites
    next
  end if
  set sprite 0 to 192,0,0,0
  set sprite 5 to 192,0,0,0
  update sprites
  inc Rounds
  ShowHud
  if Tries > 0 then goto round

  ' the game over: a press goes back to the title; left alone, Amy's sleep
  ' blanks the screen after 30 seconds and a press wakes it
  Ph = 5
  stop sound SndPlayA
  stop sound SndPlayB
  if Score > Hi then Hi = Score
  ShowHud
  ClearMsg
  print at 10,5, "GAME OVER"
  print at 8,6, "SCORE"
  NumU = Score
  print at 14,6, digits$(NumU, 5)
  play sound SndOver
  for Tm = 1 to 90
    Frame1
  next
  print at 8,7, "PRESS A BUTTON"
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  WasBtn = 1
  goto title

' ---------------------------------------------------------------------------

' SwapCans: the cans in slots SwA and SwB (SwA < SwB) cross in arcs: the
' left one high over the top, the right one low under it; then the still
' can's slot follows them
sub SwapCans:
  DrawCan(SwA, 3)
  DrawCan(SwB, 3)
  Xa = SwA << 5
  Xa = Xa + 24
  Xb = SwB << 5
  Xb = Xb + 24
  Dx = Xb - Xa
  D16 = Dd
  D16 = D16 * Dd
  play sound SndSwish
  for Tt = 0 to Dd
    Frame1
    W16 = Dx
    W16 = W16 * Tt
    W16 = W16 / Dd
    V = W16
    Ax = Xa + V
    Bx = Xb - V
    V = Dd - Tt
    P16 = Tt
    P16 = P16 * V
    W16 = P16 * 112
    W16 = W16 / D16
    V = W16
    Ya = 119 - V
    W16 = P16 * 40
    W16 = W16 / D16
    V = W16
    Yb = 119 - V
    set sprite 1 to Ya,Ax,SCanhi,15
    set sprite 2 to Ya,Ax,SCanred,8
    set sprite 3 to Yb,Bx,SCanhi,15
    set sprite 4 to Yb,Bx,SCanred,8
    update sprites
  next
  for J = 1 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  if Odd = SwA then
    Odd = SwB
  else
    if Odd = SwB then Odd = SwA
  end if
  DrawCan(SwA, 0)
  DrawCan(SwB, 0)
  inc Nsw
  return
end sub

' DrawCan(Ds, Dc): the can in slot Ds in tiles, at rest (0), raised 1 or
' 2 pixels (1, 2, the shake), or gone (3: the mirror shows)
sub DrawCan(u8 Ds, u8 Dc):
  Dxc = Ds << 2
  Dxc = Dxc + 3
  if Dc = 3 then
    Dv = TMirror
    put char Dv at Dxc,15
    put char Dv at Dxc,16
    inc Dxc
    put char Dv at Dxc,15
    put char Dv at Dxc,16
    return
  end if
  Dv = Dc << 2
  Dv = Dv + TCana00
  put char Dv at Dxc,15
  inc Dv
  Dk = Dxc + 1
  put char Dv at Dk,15
  inc Dv
  put char Dv at Dxc,16
  inc Dv
  put char Dv at Dk,16
  return
end sub

' RandSlot: V a random slot, 0-6
sub RandSlot:
rs_again:
  Rand
  V = Rs
  V = V & 7
  if V = 7 then goto rs_again
  return
end sub

' Rand: a 16-bit xorshift
sub Rand:
  T16 = Rs << 7
  Rs = Rs ^ T16
  T16 = Rs >> 9
  Rs = Rs ^ T16
  T16 = Rs << 8
  Rs = Rs ^ T16
  return
end sub

' DrawScene: the soda fountain (rows 2-21), the HUD rows 1 and 22 black
sub DrawScene:
  NewScreen
  for Y = 2 to 11
    for X = 2 to 29
      put char TWall at X,Y
    next
  next
  ' the sign: a black board in a chrome frame
  for X = 4 to 27
    put char TChrome at X,2
    put char TChrome at X,9
  next
  for Y = 3 to 8
    put char TChromev at 4,Y
    put char TChromev at 27,Y
    for X = 5 to 26
      put char 32 at X,Y
    next
  next
  for X = 2 to 29
    put char TChrome at X,12
    for Y = 13 to 16
      put char TMirror at X,Y
    next
    put char TTop at X,17
    put char TTrim at X,18
    for Y = 19 to 21
      put char TFront at X,Y
    next
  next
  print at 12,3, "SHAKER"
  return
end sub

' ClearMsg: the sign's three message rows blank (spaces, never "")
sub ClearMsg:
  print at 5,5, "                      "
  print at 5,6, "                      "
  print at 5,7, "                      "
  return
end sub

' ShowHud: score and best on row 1, level and misses left on row 22
sub ShowHud:
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  print at 18,1, "BEST"
  NumU = Hi
  print at 23,1, digits$(NumU, 5)
  print at 2,22, "LEVEL"
  NumU = Lv
  print at 8,22, digits$(NumU, 2)
  print at 17,22, "TRIES LEFT"
  NumU = Tries
  print at 28,22, digits$(NumU, 1)
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).button1 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  Ph = 0
  DrawScene
  for K = 0 to 6
    DrawCan(K, 0)
  next
  print at 7,4, "THE POP CAN GAME"
  print at 2,22, "BY JOHN FEDOR, AHOY! 1986"
  NumU = Hi
  print at 18,1, "BEST"
  print at 23,1, digits$(NumU, 5)
  Menu = 1
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStick = 1
tp_loop:
  Frame1
  ReadPad
  Rand
  ' one can at a time shakes on the counter
  V = Tick & 3
  if V = 0 then
    Cs = Tick >> 5
    while Cs >= 7
      Cs = Cs - 7
    end while
    V = Tick >> 2
    V = V & 3
    Jg = Jig[V]
    for K = 0 to 6
      if K = Cs then
        DrawCan(K, Jg)
      else
        DrawCan(K, 0)
      end if
    next
  end if
  V = Up1 | Dn1
  W = Lf1 | Rt1
  V = V | W
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      end if
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
      if Menu = 0 then
        if Lf1 = 1 then
          if StartLv > 1 then dec StartLv
        end if
        if Rt1 = 1 then
          if StartLv < 5 then inc StartLv
        end if
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  print at 7,5, " LEVEL"
  ' the level between its arrows; an arrow greys at the end of the range
  V = TArl
  if StartLv = 1 then V = TArlg
  put char V at 14,5
  NumU = StartLv
  print at 15,5, digits$(NumU, 1)
  V = TArr
  if StartLv = 5 then V = TArrg
  put char V at 16,5
  print at 7,6, " START"
  print at 7,7, " CREDITS"
  V = Menu + 5
  print at 7,V, ">"
  return
end sub

sub CreditsPage:
  Ph = 0
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  for X = 3 to 28
    put char TChrome at X,2
    put char TChrome at X,21
  next
  print at 12,4, "SHAKER"
  print at 3,6, "BASED ON SHAKER BY JOHN"
  print at 3,7, "FEDOR, AHOY! JUNE 1986"
  print at 3,8, "(COMMODORE 64)."
  print at 3,10, "MADE FOR THE COLECOVISION"
  print at 3,11, "BY CLAUDE (AN AI MADE BY"
  print at 3,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,13, "2026, IN AMY BY AMY"
  print at 3,14, "BIENVENU."
  print at 3,16, "MUSIC: FIZZ POP AND"
  print at 3,17, "COUNTER STOOL"
  print at 8,19, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

' the shake's jiggle: at rest, up 1, up 2, up 1
data Jig bytes
  0, 1, 2, 1
end data

data TilePat bytes
  $11,$11,$11,$11,$11,$11,$11,$11
  $00,$00,$00,$00,$00,$00,$00,$00
  $20,$20,$20,$20,$20,$20,$20,$20
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$10,$30,$04,$0C,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $08,$18,$38,$87,$38,$18,$08,$00
  $10,$18,$1C,$E1,$1C,$18,$10,$00
  $08,$18,$38,$87,$38,$18,$08,$00
  $10,$18,$1C,$E1,$1C,$18,$10,$00
  $00,$81,$42,$42,$42,$42,$81,$00
  $00,$F0,$C0,$80,$18,$18,$18,$07
  $00,$F0,$03,$01,$00,$00,$00,$F0
  $E1,$19,$18,$18,$18,$18,$80,$C0
  $C3,$E0,$00,$00,$00,$00,$01,$03
  $F0,$C0,$80,$18,$18,$18,$07,$E1
  $F0,$03,$01,$00,$00,$00,$F0,$C3
  $19,$18,$18,$18,$18,$80,$C0,$00
  $E0,$00,$00,$00,$00,$01,$03,$00
  $C0,$80,$18,$18,$18,$07,$E1,$19
  $03,$01,$00,$00,$00,$F0,$C3,$E0
  $18,$18,$18,$18,$80,$C0,$00,$00
  $00,$00,$00,$00,$01,$03,$00,$00
end data
data TileCol bytes
  $AB,$AB,$AB,$AB,$AB,$AB,$AB,$AB
  $0E,$0F,$0E,$0E,$0E,$0E,$0F,$0E
  $FE,$FE,$FE,$FE,$FE,$FE,$FE,$FE
  $04,$04,$04,$04,$04,$04,$04,$04
  $0F,$EF,$EF,$EF,$EF,$0F,$0E,$0E
  $0E,$0F,$0E,$06,$06,$06,$06,$06
  $F1,$F1,$F1,$1F,$F1,$F1,$F1,$01
  $F1,$F1,$F1,$1F,$F1,$F1,$F1,$01
  $E1,$E1,$E1,$1E,$E1,$E1,$E1,$01
  $E1,$E1,$E1,$1E,$E1,$E1,$E1,$01
  $06,$69,$96,$96,$96,$96,$69,$06
  $04,$4F,$4F,$4F,$F8,$F8,$F8,$8F
  $04,$F4,$4F,$4F,$08,$08,$08,$8F
  $8F,$F8,$F8,$F8,$F8,$F8,$4F,$4F
  $8F,$F8,$08,$08,$08,$08,$4F,$4F
  $4F,$4F,$4F,$F8,$F8,$F8,$8F,$8F
  $F4,$4F,$4F,$08,$08,$08,$8F,$8F
  $F8,$F8,$F8,$F8,$F8,$4F,$4F,$04
  $F8,$08,$08,$08,$08,$4F,$4F,$04
  $4F,$4F,$F8,$F8,$F8,$8F,$8F,$F8
  $4F,$4F,$08,$08,$08,$8F,$8F,$F8
  $F8,$F8,$F8,$F8,$4F,$4F,$04,$04
  $08,$08,$08,$08,$4F,$4F,$04,$04
end data
data SpritePat bytes
  $00,$0F,$3F,$7F,$18,$18,$18,$F8,$1E,$19,$18,$18,$18,$18,$7F,$3F
  $00,$F0,$FC,$FE,$00,$00,$00,$0F,$3C,$E0,$00,$00,$00,$00,$FE,$FC
