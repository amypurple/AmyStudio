record CostActor:
  u8 Direction
  u8 X
  u8 Y
  u8 HomeX
  u8 HomeY
  u8 HiddenTile
  u8 Vulnerable
  u8 MoveTimer
  u8 Immune
  u8 State
  u8 EyeX
  u8 EyeY
  u8 EyeTimer
end record

CostActor Actors[4]
u8 I = 0
u8 Sum = 0

for I = 0 to 3
  with Actors[I] as Actor
    Actor.Direction = I
    Actor.X = 10 + I
    Actor.Y = 20 + I
    Actor.HomeX = Actor.X
    Actor.HomeY = Actor.Y
    Actor.HiddenTile = 32
    Actor.Vulnerable = 0
    Actor.MoveTimer = 1
    Actor.Immune = 0
    Actor.State = 1
    Actor.EyeX = Actor.X * 8
    Actor.EyeY = Actor.Y * 8
    Actor.EyeTimer = 2
  end with
next

for I = 0 to 3
  with Actors[I] as Actor
    Actor.X += 1
    Actor.Y += 1
    Actor.MoveTimer -= 1
    Sum += Actor.X
    Sum += Actor.Y
    Sum += Actor.HiddenTile
    Sum += Actor.State
  end with
next

record_cost_done:
loop forever

