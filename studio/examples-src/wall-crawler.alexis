cartridge "WALL CRAWLER/T. BRANTNER/1987"

' WALL CRAWLER
' A ColecoVision game based on "Wall Crawler" by Tony Brantner, Ahoy! May
' 1987 (Commodore 64 machine code, SYS 49152, loaded by a two-line BASIC
' loader; orig/ has both files from the Ahoy! disk, a disassembly, jsc64
' scripts and a screenshot). Made for Amy Studio by Claude (an AI made by
' Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The story (from the magazine's contents page): a cat burglar's climb,
' where falling flower pots and closing windows are much more dangerous
' twenty stories up.
'
' Not a byte-for-byte port: the rules are the machine code's, the game is
' rebuilt for the ColecoVision: smooth sprites, a brick building drawn in
' tiles under a night sky, sound effects and a title tune.
'
' From the original ($C000-$C55B): climb the building from the street to
' the roof, one window at a time (up, down, left, right; a move once begun
' is finished); every window has a blind that goes down and up in eight
' steps, and at every tick of the game one window chosen at random moves
' its blind one step; a climber on a window whose blind is all the way
' down falls (also one that climbs onto it); birds fly about the screen,
' each choosing a new random direction and speed (1 or 2 units) now and
' then; a flower pot is dropped from the roof straight at the climber's
' column, now and then at random, when none is falling; touching a bird
' or the pot is a fall; the timer starts at 99 and counts down (about 0.55
' second a unit there, 32 frames here), and the climber falls when it runs
' out; at the roof the score gets 100 x the level plus the time left, and
' the next level makes the birds and the blinds faster (the C64's tick is
' 26 - level loop passes); each fall costs one of three lives and starts
' the climb again at the street with every blind half down and the timer
' at 99; GAME OVER, the high score is kept.
'
' Liberty needed for the faster climber (else holding the stick up won):
' each climb starts with every blind at a random step instead of half down
' (so about one window in eight is closed), and a blind moves every 4
' frames on level 1, 3 from level 5, 2 from level 9 (one window in 64 each
' time), so blinds go up and down while you climb.
'
' Liberties: 8 rows of 8 windows (the C64 had 11 rows of 8); the climber
' glides a window in 16 frames (the C64 needed over a second a row); the
' pot falls at 1.4 pixels a frame or more instead of 2 pixels a tick, and
' is never dropped on a climber in the top two rows (it came out of the
' roof right on top of him), and it teeters on the parapet for 24 frames
' before it falls, so a human can see it coming; level 1 has three birds, one more every
' second level up to the original six; speeds stop growing at level 9;
' the climber's touch box is a little smaller than his sprite; a closed
' blind has red slats (the C64's was the same colour as the others); the
' birds bounce off the screen edges instead of flying off it; a fall is a
' tumble down to the sidewalk, a broken pot stays there a moment; the
' title has a menu with a credits page.
'
' Controls: the joystick (either controller) climbs. On the title, up and
' down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes.

const TWin0L = 128
const TWin0R = 129
const TWin1L = 130
const TWin1R = 131
const TWin2L = 132
const TWin2R = 133
const TWin3L = 134
const TWin3R = 135
const TWin4L = 136
const TWin4R = 137
const TWin5L = 138
const TWin5R = 139
const TWin6L = 140
const TWin6R = 141
const TWin7L = 142
const TWin7R = 143
const TBrick = 144
const TLedge = 145
const TEdgeL = 146
const TEdgeR = 147
const TLedgeL = 148
const TLedgeR = 149
const TParapet = 150
const TCornice = 151
const TShop = 152
const TDoorL = 153
const TDoorR = 154
const TWalk = 155
const TSky = 156
const TStar1 = 157
const TStar2 = 158
const TMoon00 = 159
const TMoon01 = 160
const TMoon10 = 161
const TMoon11 = 162
const TTtl00 = 163
const TTtl01 = 164
const TTtl02 = 165
const TTtl03 = 166
const TTtl04 = 167
const TTtl05 = 168
const TTtl06 = 169
const TTtl07 = 170
const TTtl08 = 171
const TTtl09 = 172
const TTtl010 = 173
const TTtl011 = 174
const TTtl012 = 175
const TTtl013 = 176
const TTtl014 = 177
const TTtl015 = 178
const TTtl016 = 179
const TTtl017 = 180
const TTtl018 = 181
const TTtl019 = 182
const TTtl020 = 183
const TTtl021 = 184
const TTtl022 = 185
const TTtl023 = 186
const TTtl10 = 187
const TTtl11 = 188
const TTtl12 = 189
const TTtl13 = 190
const TTtl14 = 191
const TTtl15 = 192
const TTtl16 = 193
const TTtl17 = 194
const TTtl18 = 195
const TTtl19 = 196
const TTtl110 = 197
const TTtl111 = 198
const TTtl112 = 199
const TTtl113 = 200
const TTtl114 = 201
const TTtl115 = 202
const TTtl116 = 203
const TTtl117 = 204
const TTtl118 = 205
const TTtl119 = 206
const TTtl120 = 207
const TTtl121 = 208
const TTtl122 = 209
const TTtl123 = 210
const SP0d = 0
const SP0b = 4
const SP1d = 8
const SP1b = 12
const SP2d = 16
const SP2b = 20
const SP3d = 24
const SP3b = 28
const SP4d = 32
const SP4b = 36
const SBirdR0 = 40
const SBirdR1 = 44
const SBirdL0 = 48
const SBirdL1 = 52
const SPot = 56
const SFlower = 60
const SShards = 64
const NTiles8 = 664
const SprBytes = 544
const SndTuneA = 1
const SndTuneB = 2
const SndHit = 3
const SndSmash = 4
const SndStep = 5
const SndShut = 6
const SndFall = 7
const SndTop = 8
const SndTick = 9
const SndWarn = 10
const SndStart = 11
const SndOver = 12
const NSpr = 11
const GlideF = 16
const StartC = 3
const StreetR = 9
const StClimb = 1
const StFall = 2
const StWin = 3
const FloorY16 = 2560
const MaxBirds = 6

' a bird: position in 1/16 pixel and speed in 1/16 pixel a frame
record Bird:
  u16 X16
  u16 Y16
  i8 Vx
  i8 Vy
end record

Bird Birds[MaxBirds]
u16 TzLeft = 0
u8 TzOn = 0
u16 Seed = 12345
u16 NumU = 0
u16 W16 = 0
bcd digits 5 Score
bcd digits 5 HiScore
u8 Lives = 3
u8 Lv = 1
u8 Over = 0
' the climber: state, window column (0-7) and row (0 the roof, 1-8 the
' windows, 9 the street), move (0 none, 1 up, 2 down, 3 left, 4 right),
' glide frame, sprite position
u8 St = StClimb
u8 Pc = StartC
u8 Pr = StreetR
u8 Pd = 0
u8 Pk = 0
u8 Pxp = 0
u8 Pyp = 0
' falling
i16 Fy16 = 0
i16 Fv = 0
u8 DieT = 0
' the timer and the window tick
u8 Tm = 99
u8 TmT = 0
u8 WinT = 1
u8 WinF = 8
' the blinds, 8 rows of 8 (0-7, 4 is closed)
u8 Bl[64]
' the birds in play, their speeds
u8 Nb = 3
u8 S1 = 6
' the pot: 0 none, 1 falling, 2 broken on the sidewalk, 3 teetering
u8 PotOn = 0
u8 PotX = 0
u16 PotY16 = 0
u8 PotV = 22
u8 PotT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Bi = 0
u8 Wi = 0
u8 Mr = 0
u8 Mc = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 F = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table WcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 1 then goto game_over
  if St = StWin then LevelDone
  goto play_loop

game_over:
  Phase = 4
  if Score > HiScore then HiScore = Score
  print at 10,10, " GAME OVER "
  print at 10,11, "           "
  print at 10,12, " SCORE     "
  print at 17,12, Score
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift (the BIOS random repeats in tight loops)

function Rnd() as u8
  u8 Lo = 0
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  Lo = Seed & 255
  return Lo

' ---------------------------------------------------------------------------
' the building

' the two tiles of a window from its blind
sub DrawWin(u8 Ix):
  u8 Wc = 0
  u8 Wr = 0
  u8 Tl = 0
  Wc = Ix & 7
  Wr = Ix >> 3
  Wc = Wc * 3 + 5
  Wr = Wr * 2 + 4
  Tl = Bl[Ix] * 2 + TWin0L
  put char Tl at Wc,Wr
  inc Tl
  inc Wc
  put char Tl at Wc,Wr
  return
end sub

sub DrawAllWindows:
  for Wi = 0 to 63
    DrawWin(Wi)
  next
  return
end sub

' the tile of the night sky at a cell: a star here and there, the moon
function SkyAt(u8 Sc, u8 Sr) as u8
  u8 Hs = 0
  if Sr = 4 then
    if Sc = 2 then return TMoon00
    if Sc = 3 then return TMoon01
  end if
  if Sr = 5 then
    if Sc = 2 then return TMoon10
    if Sc = 3 then return TMoon11
  end if
  Hs = Sc * 5 + Sr * 11
  Hs = Hs & 15
  if Hs = 3 then return TStar1
  if Hs = 9 then return TStar2
  return TSky

' the tile at a cell of the building (columns 4-28, rows 2-20)
function HouseAt(u8 Hc, u8 Hr) as u8
  u8 Inner = 0
  u8 M3 = 0
  select case Hr
  case 2
    return TParapet
  case 3
    return TCornice
  case 20
    if Hc = 4 then return TEdgeL
    if Hc = 28 then return TEdgeR
    if Hc = 15 then return TDoorL
    if Hc = 16 then return TDoorR
    return TShop
  end select
  Inner = Hr & 1
  if Inner = 1 then
    if Hc = 4 then return TLedgeL
    if Hc = 28 then return TLedgeR
    return TLedge
  end if
  if Hc = 4 then return TEdgeL
  if Hc = 28 then return TEdgeR
  M3 = (Hc - 4) % 3
  if M3 = 0 then return TBrick
  ' a window: its blind
  return TWin0L

sub DrawBuilding:
  for Mr = 1 to 20
    for Mc = 0 to 31
      if Mc < 4 then
        V = SkyAt(Mc, Mr)
      elseif Mc > 28 then
        V = SkyAt(Mc, Mr)
      elseif Mr = 1 then
        V = SkyAt(Mc, Mr)
      else
        V = HouseAt(Mc, Mr)
      end if
      put char V at Mc,Mr
    next
  next
  fill TWalk count 32 at 0,21
  DrawAllWindows
  return
end sub

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Anim
  MoveBirds
  MovePot
  if St = StFall then
    FallStep
    return
  end if
  if St <> StClimb then return
  inc TmT
  if TmT >= 32 then
    TmT = 0
    dec Tm
    ShowTime
    if Tm = 0 then
      StartFall(0)
      return
    end if
    if Tm <= 10 then play sound SndWarn
  end if
  dec WinT
  if WinT = 0 then
    WinT = WinF
    WindowTick
  end if
  MovePlayer
  if St = StClimb then CheckBlind
  if St = StClimb then CheckHits
  return
end sub

' one window moves its blind a step; maybe a pot; maybe new bird courses
sub WindowTick:
  u8 Wx = 0
  u8 Rr = 0
  Wx = Rnd() & 63
  Bl[Wx] = (Bl[Wx] + 1) & 7
  DrawWin(Wx)
  if Bl[Wx] = 4 then play sound SndShut
  if PotOn = 0 then
    if Pr >= 3 then
      Rr = Rnd()
      Rr = Rr & 7
      if Rr = 0 then
        PotOn = 3
        PotT = 24
        PotX = Pxp
        PotY16 = 256
        play sound SndTick
      end if
    end if
  end if
  for Bi = 1 to Nb
    Rr = Rnd()
    Rr = Rr & 15
    if Rr = 0 then PickCourse(Bi - 1)
  next
  return
end sub

' a new course for a bird: 1 or 2 units across, half that up or down
sub PickCourse(u8 Ci):
  u8 Rc = 0
  i8 Sp = 0
  Rc = Rnd()
  Sp = S1
  if (Rc & 1) = 1 then Sp = Sp * 2
  if (Rc & 2) = 2 then Sp = 0 - Sp
  Birds[Ci].Vx = Sp
  Sp = S1 / 2
  if (Rc & 4) = 4 then Sp = S1
  if (Rc & 8) = 8 then Sp = 0 - Sp
  Birds[Ci].Vy = Sp
  return
end sub

' the birds fly, bouncing off the edges of the screen
sub MoveBirds:
  u16 Bx = 0
  u16 By = 0
  i8 Dvx = 0
  i8 Dvy = 0
  for Bi = 1 to Nb
    K = Bi - 1
    Bx = Birds[K].X16
    By = Birds[K].Y16
    Dvx = Birds[K].Vx
    Dvy = Birds[K].Vy
    Bx = Bx + Dvx
    By = By + Dvy
    if Bx < 256 then
      Bx = 256
      Dvx = 0 - Dvx
    end if
    if Bx > 3584 then
      Bx = 3584
      Dvx = 0 - Dvx
    end if
    if By < 256 then
      By = 256
      Dvy = 0 - Dvy
    end if
    if By > 2432 then
      By = 2432
      Dvy = 0 - Dvy
    end if
    Birds[K].X16 = Bx
    Birds[K].Y16 = By
    Birds[K].Vx = Dvx
    Birds[K].Vy = Dvy
  next
  return
end sub

sub MovePot:
  if PotOn = 1 then
    PotY16 = PotY16 + PotV
    if PotY16 >= FloorY16 then
      PotY16 = FloorY16
      PotOn = 2
      PotT = 40
      play sound SndSmash
    end if
  elseif PotOn = 2 then
    dec PotT
    if PotT = 0 then PotOn = 0
  elseif PotOn = 3 then
    ' it teeters on the parapet, then falls
    dec PotT
    if PotT = 0 then PotOn = 1
  end if
  return
end sub

' a new move when still (up, down, left, right in that order), the glide,
' and the roof
sub MovePlayer:
  if Pd = 0 then
    if (Pad & 1) > 0 then
      Pd = 1
    elseif (Pad & 2) > 0 then
      if Pr < StreetR then Pd = 2
    elseif (Pad & 4) > 0 then
      if Pc > 0 then Pd = 3
    elseif (Pad & 8) > 0 then
      if Pc < 7 then Pd = 4
    end if
    if Pd = 0 then return
    play sound SndStep
  end if
  inc Pk
  if Pk < GlideF then
    PlacePlayer
    return
  end if
  Pk = 0
  select case Pd
  case 1
    dec Pr
  case 2
    inc Pr
  case 3
    dec Pc
  case else
    inc Pc
  end select
  Pd = 0
  PlacePlayer
  if Pr = 0 then St = StWin
  return
end sub

sub PlacePlayer:
  u8 G = 0
  Pxp = Pc * 24 + 40
  Pyp = Pr * 16 + 12
  select case Pd
  case 1
    Pyp = Pyp - Pk
  case 2
    Pyp = Pyp + Pk
  case 3
    G = (Pk * 3) >> 1
    Pxp = Pxp - G
  case 4
    G = (Pk * 3) >> 1
    Pxp = Pxp + G
  end select
  return
end sub

' a climber still on a window whose blind is down falls
sub CheckBlind:
  u8 Bx = 0
  if Pd <> 0 then return
  if Pr = 0 then return
  if Pr = StreetR then return
  Bx = (Pr - 1) * 8 + Pc
  if Bl[Bx] = 4 then StartFall(0)
  return
end sub

' a bird within 10 pixels across and 8 up or down, or the pot within 10
' and 12, knocks the climber off
sub CheckHits:
  i16 Ddx = 0
  i16 Ddy = 0
  u16 Hy = 0
  for Bi = 1 to Nb
    K = Bi - 1
    Ddx = Birds[K].X16 >> 4
    Ddx = Ddx - Pxp
    Hy = Birds[K].Y16 >> 4
    Ddy = Hy
    Ddy = Ddy - Pyp
    if abs(Ddx) <= 10 then
      if abs(Ddy) <= 8 then Knock
    end if
  next
  if St <> StClimb then return
  if PotOn = 1 then
    Ddx = PotX
    Ddx = Ddx - Pxp
    Hy = PotY16 >> 4
    Ddy = Hy
    Ddy = Ddy - Pyp
    if abs(Ddx) <= 10 then
      if abs(Ddy) <= 12 then Knock
    end if
  end if
  return
end sub

sub Knock:
  if St <> StClimb then return
  play sound SndHit
  StartFall(24)
  return
end sub

' off the wall: a hop when knocked (Kick), then down to the sidewalk
sub StartFall(u8 Kick):
  St = StFall
  Fy16 = Pyp
  Fy16 = Fy16 * 16
  Fv = 0 - Kick
  DieT = 0
  Pd = 0
  Pk = 0
  play sound SndFall
  return
end sub

sub FallStep:
  if Fy16 < FloorY16 then
    Fv = Fv + 3
    Fy16 = Fy16 + Fv
    if Fy16 > FloorY16 then Fy16 = FloorY16
    return
  end if
  inc DieT
  if DieT >= 40 then LoseLife
  return
end sub

sub LoseLife:
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    return
  end if
  ResetRound
  ShowTime
  return
end sub

' the blinds anywhere, the birds anywhere, the climber at the street
sub ResetRound:
  for Wi = 0 to 63
    Bl[Wi] = Rnd() & 7
  next
  DrawAllWindows
  for Bi = 1 to Nb
    K = Bi - 1
    V = Rnd()
    W16 = V
    W16 = W16 * 13 + 256
    Birds[K].X16 = W16
    V = Rnd() & 127
    W16 = V
    W16 = W16 * 16 + 320
    Birds[K].Y16 = W16
    PickCourse(K)
  next
  PotOn = 0
  St = StClimb
  Pc = StartC
  Pr = StreetR
  Pd = 0
  Pk = 0
  PlacePlayer
  Tm = 99
  TmT = 0
  WinT = WinF
  return
end sub

' ---------------------------------------------------------------------------
' between levels

sub LevelDone:
  Phase = 3
  play sound SndTop
  print at 11,10, " ROOFTOP! "
  for Gi = 0 to 89
    inc Anim
    DrawSprites
    Frame1
  next
  print at 11,12, " BONUS    "
  ' 100 a level
  for Gi = 1 to Lv
    Score += 100
    NumU = Gi
    NumU = NumU * 100
    print at 18,12, digits$(NumU, 4)
    ShowScore
    play sound SndTick
    Frame1
    Frame1
    Frame1
  next
  ' then the time left
  while Tm > 0
    dec Tm
    Score += 1
    ShowScore
    ShowTime
    V = Tick & 1
    if V = 0 then play sound SndTick
    Frame1
  end while
  Rearm
  wait 40 frames
  nmi off
  inc Lv
  StartLevel
  return
end sub

' ---------------------------------------------------------------------------
' levels and drawing

sub NewGame:
  Score = 0
  Lives = 3
  Lv = 1
  Over = 0
  StartLevel
  return
end sub

' the level's speeds, the building, a fresh climb
sub StartLevel:
  u8 Lc = 0
  Phase = 2
  Lc = Lv
  if Lc > 9 then Lc = 9
  WinF = 4 - (Lc - 1) / 4
  S1 = 5 + Lc
  Nb = 2 + (Lc + 1) / 2
  if Nb > MaxBirds then Nb = MaxBirds
  PotV = Lc * 2 + 20
  NewScreen
  DrawBuilding
  ResetRound
  ShowHud
  Anim = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait 50 frames
  nmi off
  Phase = 1
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 22,1, "TIME"
  print at 2,22, "LIVES"
  print at 21,22, "LEVEL"
  ShowScore
  ShowTime
  ShowLives
  NumU = Lv
  print at 27,22, digits$(NumU, 2)
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

sub ShowTime:
  NumU = Tm
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 8,22, digits$(NumU, 1)
  return
end sub

' sprites 0-1 the climber (detail over body), 2-7 the birds, 8-9 the pot
' (flower over pot), 10 spare
sub DrawSprites:
  u16 Sy = 0
  X = Pxp
  Y = Pyp
  F = 0
  if St = StClimb then
    if Pd > 0 then
      V = Pk >> 2
      F = V & 1
    else
      F = Pc & 1
    end if
  elseif St = StFall then
    Sy = Fy16 >> 4
    Y = Sy
    V = Anim >> 3
    F = 2 + (V & 1)
  else
    F = 4
  end if
  K = F << 3
  set sprite 0 to Y,X,K,1
  K = K + 4
  set sprite 1 to Y,X,K,15
  for Bi = 0 to 5
    N = Bi + 2
    if Bi < Nb then
      Sy = Birds[Bi].X16 >> 4
      X = Sy
      Sy = Birds[Bi].Y16 >> 4
      Y = Sy
      V = Anim >> 3
      V = (V + Bi) & 1
      K = SBirdR0
      if Birds[Bi].Vx < 0 then K = SBirdL0
      K = K + V * 4
      C = 14
      if Bi >= 3 then C = 10
      set sprite N to Y,X,K,C
    else
      set sprite N to 192,0,0,0
    end if
  next
  if PotOn = 1 then
    Sy = PotY16 >> 4
    Y = Sy
    set sprite 8 to Y,PotX,SFlower,8
    set sprite 9 to Y,PotX,SPot,6
  elseif PotOn = 3 then
    V = (PotT >> 2) & 1
    X = PotX + V
    set sprite 8 to 4,X,SFlower,8
    set sprite 9 to 4,X,SPot,6
  elseif PotOn = 2 then
    set sprite 8 to 160,PotX,SShards,6
    set sprite 9 to 192,0,0,0
  else
    set sprite 8 to 192,0,0,0
    set sprite 9 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the building with a sign across it, the birds about, the tune
' once, START / CREDITS
sub TitlePage:
  Phase = 5
  Lv = 1
  Nb = 3
  S1 = 6
  NewScreen
  DrawBuilding
  ResetRound
  for Mr = 6 to 15
    fill 32 count 23 at 5,Mr
  next
  for Gi = 0 to 23
    V = TTtl00 + Gi
    X = Gi + 4
    put char V at X,7
    V = TTtl10 + Gi
    put char V at X,8
  next
  print at 8,10, "AHOY! MAY 1987"
  print at 10,11, "HIGH "
  print at 15,11, HiScore
  print at 13,13, "START"
  print at 13,14, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  inc Anim
  V = Rnd()
  MoveBirds
  DrawSprites
  V = Pad & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,13
  put char 32 at 11,14
  J = Menu + 13
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "WALL CRAWLER"
  print at 2,5, "BASED ON WALL CRAWLER BY"
  print at 2,6, "TONY BRANTNER, AHOY! MAY"
  print at 2,7, "1987 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: NIGHT SHIFT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

