cartridge "TILE COLLISION MAZE/AMY/2026"

const EmptyTile = $20
const WallTile = $23
const PlayerTile = $40
const CoinTile = $2A
const LavaTile = $5E

tile type solid = WallTile
tile type coin = CoinTile
tile type hazard = LavaTile

data MazeMap chars
  "################################"
  "#                              #"
  "#                              #"
  "#                              #"
  "#                              #"
  "#                              #"
  "#                              #"
  "#     ##############           #"
  "#                              #"
  "#                     {CoinTile}        #"
  "#                              #"
  "#                              #"
  "#           ############       #"
  "#          {CoinTile}                   #"
  "#                              #"
  "#                 {LavaTile}            #"
  "#                              #"
  "#                              #"
  "################################"
end data

u8 PlayerX = 16
u8 PlayerY = 16
u8 OldX = 16
u8 OldY = 16
u8 NextX = 16
u8 NextY = 16
u8 DrawX = 0
u8 DrawY = 0
u8 HitX = 255
u8 HitY = 255
u8 Coins = 0

' Maze-like demo for pixel-to-tile collision primitives.
  text screen
  print centered at 5, "TILE COLLISION MAZE"
  print centered at 8, "MOVE THROUGH A MAZE"
  print centered at 9, "COLLECT COINS"
  print centered at 14, "PRESS FIRE TO START"
  screen on
  pause until press
  wait no fire
  cls
  setup_maze
  draw_player
  print at 1,22, "ARROWS MOVE  COINS"
  screen on
  goto main_loop

sub setup_maze:
  put MazeMap frame size 32,19 at 0,0
  return

sub erase_player:
  DrawX = OldX
  DrawX >>= 3
  DrawY = OldY
  DrawY >>= 3
  put char EmptyTile at DrawX,DrawY
  return

sub draw_player:
  DrawX = PlayerX
  DrawX >>= 3
  DrawY = PlayerY
  DrawY >>= 3
  put char PlayerTile at DrawX,DrawY
  return

sub collect_coin:
  find tile coin under box PlayerX,PlayerY size 8,8 into HitX,HitY
  if HitX != 255 then
    Coins += 1
    put char EmptyTile at HitX,HitY
    print Coins at 22,22 digits 2
  end if
  return

sub check_hazard:
  if tiles under box PlayerX,PlayerY size 8,8 contain hazard then
    PlayerX = 16
    PlayerY = 16
  end if
  return

sub main_loop:
  wait 4 frames
  OldX = PlayerX
  OldY = PlayerY
  if joypad(1).left then
    NextX = PlayerX - 8
    if tile under NextX,PlayerY + 4 is solid goto blocked_move
    PlayerX = NextX
  elseif joypad(1).right then
    NextX = PlayerX + 8
    if tile under NextX + 7,PlayerY + 4 is solid goto blocked_move
    PlayerX = NextX
  elseif joypad(1).up then
    NextY = PlayerY - 8
    if tile under PlayerX + 4,NextY is solid goto blocked_move
    PlayerY = NextY
  elseif joypad(1).down then
    NextY = PlayerY + 8
    if tile under PlayerX + 4,NextY + 7 is solid goto blocked_move
    PlayerY = NextY
  end if
  erase_player
  collect_coin
  check_hazard
  draw_player
blocked_move:
  goto main_loop