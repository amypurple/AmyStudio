' FP5 sign/int lab: exact sign classification plus floor-style integerization.
u16 UZero = 0
u16 UOne = 1
u16 UTwo = 2
u16 UFour = 4
u16 UFive = 5
u16 USeven = 7
i16 SNegOne = -1
i16 SNegFive = -5
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0
fp5 S0 = 0
fp5 S1 = 0
fp5 S2 = 0
fp5 S3 = 0
fp5 S4 = 0
fp5 I0 = 0
fp5 I1 = 0
fp5 I2 = 0
fp5 I3 = 0
fp5 I4 = 0

  text screen
  print at 6,0, "FP5 SGN / INT LAB"

  A = UZero
  B = UOne
  C = SNegOne
  D = UOne
  D /= UTwo
  E = SNegOne
  E /= UTwo
  F = USeven
  F /= UFour
  G = SNegFive
  G /= UFour

  S0 = sgn(A)
  S1 = sgn(B)
  S2 = sgn(C)
  S3 = sgn(D)
  S4 = sgn(E)

  I0 = int(A)
  I1 = int(D)
  I2 = int(E)
  I3 = int(F)
  I4 = int(G)

  print at 1,4,  "sgn 0"
  print S0 at 14,4 digits 16
  print at 1,6,  "sgn 1"
  print S1 at 14,6 digits 16
  print at 1,8,  "sgn -1"
  print S2 at 14,8 digits 16
  print at 1,10, "sgn 0.5"
  print S3 at 14,10 digits 16
  print at 1,12, "sgn -0.5"
  print S4 at 14,12 digits 16

  print at 1,15, "int 0"
  print I0 at 14,15 digits 16
  print at 1,17, "int 0.5"
  print I1 at 14,17 digits 16
  print at 1,19, "int -0.5"
  print I2 at 14,19 digits 16
  print at 1,21, "int 1.75"
  print I3 at 14,21 digits 16
  print at 1,23, "int -1.25"
  print I4 at 14,23 digits 16

  print at 1,25, "EXPECT"
  print at 1,26, "sgn: 0, 1, -1, 1, -1"
  print at 1,27, "int: 0, 0, -1, 1, -2"
  screen on