i16 Sj2 = 0
i16 TtVx = 0
i16 TtVy = 0
u8 TtA = 0
u8 TtB = 0
u8 TtK = 0
u8 TtG = 0
u8 TtN = 0
u8 TtAw = 0
' scratch (never kept across a sub call)
u8 T = 0
u8 U = 0
u8 K = 0
u8 J = 0
u8 H = 0
u8 V = 0
u8 D = 0
u16 W = 0
i16 Si = 0

  tile screen
  call asm FfSetR3
  set sound table FfSoundTable areas 4
  sprites 16x16
  nmi off
  copy SprPat count SprBytes to vram.spr_pat
  HideSpr
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if State = StPlay then goto play_loop
  if State = StCard then
    NightCard
    goto play_loop
  end if

  ' game over: one press (after 1 s) returns to the title
  QT = MsgGameOver
  call asm FfMsg
  Waited = 0
go_wait:
  Frame1
  ReadPad
  Sat[0] = 209
  Sat[4] = 209
  Sat[8] = 209
  Sat[12] = 209
  inc Waited
  if Waited < 60 then Press = 0
  if Waited >= 1800 then Press = 1
  if Press = 0 then goto go_wait
  InPlay = 0
  goto title

' ===========================================================================
' game flow

sub NewGame:
  Score = 0
  Lives = 3
  Night = 1
  Delivered = 0
  Eaten = 0
  Rescued = 0
  Clears = 0
  Fails = 0
  Stucks = 0
  Gusts = 0
  Bats = 0
  Strikes = 0
  Puffs = 0
  Wholes = 0
  Frames = 0
  PlayScreen
  NewNight
  State = StPlay
  return
end sub

' the night's parameters (NightRec: 9 bytes a night, nights 1..10; later
' nights repeat night 10 with a smaller light), map (MapRec: 24 bytes)
sub NewNight:
  T = Night - 1
  if T > 9 then T = 9
  J = T * 9
  FN = NightRec[J]
  NeedN = NightRec[J + 1]
  Light = NightRec[J + 2]
  FrogCD = NightRec[J + 3]
  GustOn = NightRec[J + 4]
  BatOn = NightRec[J + 5]
  BatEvery = NightRec[J + 6]
  BatEvery = BatEvery << 2
  FDim = NightRec[J + 7]
  Secs = NightRec[J + 8]
  ' from night 7 the nights ramp up (no bonus lantern after night 8): per
  ' night past 5, the light -5 (at least 24), dawn 8 s sooner (at least 36 s), frogs
  ' strike 3 frames sooner (at least 22); the jar needs all but one; the spider comes
  ' sooner, gusts come more often and blow harder (GustStep, FlyInputs)
  if Night > 6 then
    T = Night - 5
    if T > 8 then T = 8
    ' (each clamp compares before the subtraction: no u8 wrap-around)
    D = T * 5
    U = Light - 24
    if D > U then D = U
    Light -= D
    D = T << 3
    U = Secs - 36
    if D > U then D = U
    Secs -= D
    D = T * 3
    U = FrogCD - 22
    if D > U then D = U
    FrogCD -= D
    NeedN = FN - 1
  end if
  ' map
  MapI = Night - 1
  MapI = MapI & 7
  call asm FfSetMap
  J = MapI * 24
  PX = MapRec[J]
  PY = MapRec[J + 1]
  PXF = PX << 8
  PYF = PY << 8
  NSpawn = 0
  for K = 0 to 3
    T = K << 1
    T += J
    SpX[K] = MapRec[T + 2]
    SpY[K] = MapRec[T + 3]
    if SpX[K] > 0 then inc NSpawn
  next
  NJar = 0
  for K = 0 to 1
    T = K << 1
    T += J
    JaX[K] = MapRec[T + 10]
    JaY[K] = MapRec[T + 11]
    if JaX[K] > 0 then inc NJar
  next
  NWeb = 0
  for K = 0 to 1
    T = K << 1
    T += J
    WbX[K] = MapRec[T + 14]
    WbY[K] = MapRec[T + 15]
    if WbX[K] > 0 then inc NWeb
    WbN[K] = 0
    WbT[K] = 0
    WbCD[K] = 0
    WbRed[K] = 0
  next
  NFrog = 0
  for K = 0 to 2
    T = K << 1
    T += J
    FgX[K] = MapRec[T + 18]
    FgY[K] = MapRec[T + 19]
    if FgX[K] > 0 then inc NFrog
    FgS[K] = 0
    Rnd
    T = RndV & 63
    FgT[K] = T + 60
    FgPuff[K] = 0
  next
  ' the field, drawn with the display off
  StampField
  ' the swarm, round the spawn points (on meadow)
  SpawnFlies
  ' the rest
  Oil = OilMax
  Lock = 0
  Bright = 0
  WasBright = 0
  Got = 0
  Lost = 0
  Chain = 0
  SinceDel = 255
  W = Secs
  TimeL = W * 60
  TimeCell = W * 15
  W = TimeCell
  TimeCell = W >> 1
  TimeSub = TimeCell
  TimeC = 8
  Grace = Grace0
  TgOn = 0
  GuS = 0
  Rnd
  GuT = RndV
  GuT += 600
  if Night > 6 then GuT -= 300
  BaOn = 0
  BaT = BatEvery
  FThN = 0
  JarLv = 255
  JarPend = 0
  Ph = PhPlay
  HGot = 255
  HTime = 255
  HNight = 255
  HOil = 255
  HChain = 255
  HWind = 255
  HLives = 255
  ' row 22 blank first: no oil bar / wind arrow left from the last night
  ' beside the message (the HUD redraws them when the message clears)
  call asm FfMsgClr
  QT = MsgNight
  call asm FfMsg
  PcR = 22
  PcC = 18
  NumU = Night
  call asm FfNum2
  MsgOn = 1
  MsgT = 100
  return
end sub

' fireflies round the spawn points: up to 12 tries each for a meadow spot
sub SpawnFlies:
  for K = 0 to 21
    FSlot[K] = 0
  next
  V = 0
  for K = 0 to 21
    if K < FN then
      T = SpX[V]
      U = SpY[V]
      for H = 1 to 12
        Rnd
        D = RndV & 15
        D += RndV >> 6
        QX = T + D
        QX -= 10
        Rnd
        D = RndV & 15
        D += RndV >> 6
        QY = U + D
        QY -= 10
        call asm FfCls
        if QC = 0 then H = 12
      next
      if QC <> 0 then
        QX = T
        QY = U
      end if
      QI = K
      call asm FfInit
      inc V
      if V >= NSpawn then V = 0
    else
      QI = K
      call asm FfGone
    end if
  next
  ' each firefly's slot on the ring (64 angles shared out)
  D = 0
  for K = 0 to 21
    if K < FN then
      W = K << 6
      ' W / FN without a loop of subtraction per frame: once a night
      W = W / FN
      FSlot[K] = lowbyte W
    end if
  next
  FEnd = FN * 12
  FSepK = 1
  FSepO = 12
  return
end sub

sub PlayStep:
  inc Frames
  Bud = 0
  if Ph = PhPlay then
    PlayLive
  else
    dec PhT
    if PhT = 0 then
      if Ph = PhClear then
        inc Night
        T = Night & 3
        if Night > 8 then T = 0
        if T = 1 then
          if Lives < 5 then inc Lives
        end if
      end if
      if Lives = 0 then
        State = StOver
      else
        State = StCard
      end if
    end if
    FlyInputs
    call asm FfFlies
  end if
  if MsgOn = 1 then
    if MsgT > 0 then
      dec MsgT
      if MsgT = 0 then
        MsgOn = 0
        QT = MsgNight + 14
        call asm FfMsgClr
        HGot = 255
        HOil = 255
        HChain = 255
        HWind = 255
      end if
    end if
  end if
  BuildSat
  Hud
  return
end sub

' between nights: the display goes off once while the field is redrawn
sub NightCard:
  NewNight
  State = StPlay
  return
end sub

sub PlayLive:
  PlayerStep
  FrogStep
  WebStep
  GustStep
  BatStep
  FlyInputs
  call asm FfFlies
  FlyResults
  if Grace > 0 then dec Grace
  if SinceDel < 255 then inc SinceDel
  dec TimeL
  dec TimeSub
  if TimeSub = 0 then
    TimeSub = TimeCell
    if TimeC > 0 then dec TimeC
  end if
  ' the night ends: everyone home or lost, too few left, or dawn
  T = FFree + FStk
  U = Got + T
  if U < NeedN then
    Why = 2
    NightFail
    return
  end if
  if T = 0 then
    NightEnd
    return
  end if
  if TimeL = 0 then NightEnd
  return
end sub

sub NightEnd:
  if Got >= NeedN then
    Ph = PhClear
    PhT = 150
    inc Clears
    QT = MsgNightClear
    T = FFree + FStk
    if Lost = 0 then
      if T = 0 then
        Score += 200
        inc Wholes
        QT = MsgWholeSwarm
      end if
    end if
    call asm FfMsg
    MsgOn = 1
    MsgT = 0
    play sound SndClear
    EndHaz
  else
    Why = 1
    NightFail
  end if
  return
end sub

sub NightFail:
  Ph = PhFail
  PhT = 150
  inc Fails
  dec Lives
  HLives = 255
  QT = MsgDawnCame
  if Why = 2 then QT = MsgTooManyLost
  call asm FfMsg
  MsgOn = 1
  MsgT = 0
  play sound SndFail
  EndHaz
  return
end sub

sub EndHaz:
  TgOn = 0
  BaOn = 0
  GuS = 0
  FThN = 0
  Bright = 0
  for K = 0 to 2
    if FgPuff[K] = 1 then
      FgPuff[K] = 0
      QK = K
      FrogTiles
    end if
  next
  return
end sub

' ===========================================================================
' the player

sub PlayerStep:
  Moving = 0
  W = PSpd
  T = Jk & 3
  U = Jk & 12
  if T > 0 then
    if U > 0 then W = PSpdD
  end if
  if U > 0 then
    Moving = 1
    if Jk & 4 then
      Face = 1
      PXF -= W
      QX = highbyte PXF
      QX -= 3
      QY = PY
      call asm FfBlkH
      if QB = 1 then PXF += W
    else
      Face = 0
      PXF += W
      QX = highbyte PXF
      QX += 3
      QY = PY
      call asm FfBlkH
      if QB = 1 then PXF -= W
    end if
    PX = highbyte PXF
  end if
  if T > 0 then
    Moving = 1
    if Jk & 1 then
      PYF -= W
      QX = PX
      QY = highbyte PYF
      QY -= 3
      call asm FfBlkV
      if QB = 1 then PYF += W
    else
      PYF += W
      QX = PX
      QY = highbyte PYF
      QY += 3
      call asm FfBlkV
      if QB = 1 then PYF -= W
    end if
    PY = highbyte PYF
  end if
  ' the sprites stay inside the CRT safe area (columns 2-29, rows 2-21)
  if PX < 24 then
    PX = 24
    PXF = 24 << 8
  end if
  if PX > 231 then
    PX = 231
    PXF = 231 << 8
  end if
  if PY < 28 then
    PY = 28
    PYF = 28 << 8
  end if
  if PY > 172 then
    PY = 172
    PYF = 172 << 8
  end if
  if Moving = 1 then inc Walk
  ' the lantern: bright while the button is held (oil), refill otherwise
  Bright = 0
  if Btn > 0 then
    if Lock = 0 then
      if Oil > 0 then
        Bright = 1
        dec Oil
        if Oil = 0 then
          Lock = 1
          play sound SndEmpty
        end if
      end if
    end if
  end if
  if Bright = 0 then
    inc Regen
    if Regen >= 3 then
      Regen = 0
      if Oil < OilMax then inc Oil
    end if
    if Lock = 1 then
      if Oil >= OilLock then Lock = 0
    end if
  else
    if WasBright = 0 then play sound SndShine
  end if
  WasBright = Bright
  ' walking into a web frees its fireflies
  for K = 0 to 1
    if K < NWeb then
      T = WbX[K] - 3
      U = WbX[K] + 19
      if PX >= T then
        if PX < U then
          T = WbY[K] - 3
          U = WbY[K] + 19
          if PY >= T then
            if PY < U then
              if WbN[K] > 0 then
                QK = K
                QX = WbX[K] + 8
                QY = WbY[K] + 8
                call asm FfFreeWeb
                W = QN * 5
                Score += W
                Rescued += QN
                WbN[K] = 0
                WbT[K] = 0
                play sound SndRescue
              end if
              WbCD[K] = 90
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' ===========================================================================
' hazards

' frogs: idle (timer) -> puff, the tell (45 frames, throat swells at 2.4 Hz)
' -> tongue out 4 frames toward the nearest firefly in reach, back 4 frames
sub FrogStep:
  TgOn = 0
  for K = 0 to 2
    if K < NFrog then FrogOne
  next
  return
end sub

sub FrogOne:
  T = FgS[K]
  if T = 0 then
    if FgT[K] > 0 then
      dec FgT[K]
      return
    end if
    if Grace > 0 then return
    ' looks round every 8 frames (each frog on its own frame)
    T = K * 3
    T += Tick
    T = T & 7
    if T <> 0 then return
    if Bud > 0 then return
    inc Bud
    QX = FgX[K]
    QY = FgY[K]
    QR = FrogSee
    call asm FfNear
    if QI = 255 then return
    FgS[K] = 1
    FgT[K] = FrogTell
    inc Puffs
    play sound SndCroak
    return
  end if
  if T = 1 then
    ' the throat: swollen 12 frames, normal 12 (2.5 Hz)
    U = FgT[K] / 12
    U = U & 1
    U = U ^ 1
    if U <> FgPuff[K] then
      FgPuff[K] = U
      QK = K
      FrogTiles
    end if
    if FgT[K] = 1 then
      ' the strike waits a frame when the budget is spent
      if Bud >= 1 then return
    end if
    dec FgT[K]
    if FgT[K] > 0 then return
    Bud += 2
    if FgPuff[K] = 1 then
      FgPuff[K] = 0
      QK = K
      FrogTiles
    end if
    ' aim (8 directions): toward the nearest firefly, else straight down
    QX = FgX[K]
    QY = FgY[K]
    QR = FrogReach
    call asm FfNear
    FgA[K] = 1
    FgB[K] = 2
    if QI < 255 then call asm FfAim
    FgS[K] = 2
    FgT[K] = 0
    inc Strikes
    play sound SndSnap
    return
  end if
  ' the tongue: frames 1-4 out (4, 8, 12, 16 px), 5-7 back
  inc FgT[K]
  T = FgT[K]
  if T >= 8 then
    FgS[K] = 0
    Rnd
    T = RndV & 31
    FgT[K] = FrogCD + T
    return
  end if
  U = T
  if T > 4 then U = 8 - T
  ' U = 1..4: length U * 4 (diagonals 3/4 per axis)
  D = U << 2
  H = FgA[K]
  V = FgB[K]
  if H <> 1 then
    if V <> 1 then D = D - U
  end if
  TgX = FgX[K]
  if H = 0 then TgX -= D
  if H = 2 then TgX += D
  TgY = FgY[K]
  if V = 0 then TgY -= D
  if V = 2 then TgY += D
  ' sprite: direction index from (H, V), length index U - 1
  J = V * 3
  J += H
  J = DirOf[J]
  QK = J
  T = J << 4
  D = U - 1
  D = D << 2
  T += D
  TgP = STg0L4 + T
  J = J << 1
  TgSX = FgX[K] - TongueAnch[J]
  TgSY = FgY[K] - TongueAnch[J + 1]
  TgOn = 1
  if U = 4 then
    inc Bud
    QX = TgX
    QY = TgY
    QR = 6
    call asm FfNear
    if QI < 255 then
      QK = 0
      call asm FfSetSt
      inc Lost
      inc Eaten
      play sound SndGulp
    end if
  end if
  return
end sub

' frog QK's two lower cells: normal or puffed throat
sub FrogTiles:
  K = QK
  ' frog centre (FgX, FgY) is the corner shared by its 4 cells: the lower
  ' cells are screen column (FgX - 8) / 8 and row FgY / 8
  QX = FgX[K] - 8
  QX = QX >> 3
  QY = FgY[K] >> 3
  QT = TFrog2
  if FgPuff[K] = 1 then QT = TFrogp2
  call asm FfTileAt
  inc QX
  QT = TFrog3
  if FgPuff[K] = 1 then QT = TFrogp3
  call asm FfTileAt
  K = QK
  return
end sub

' webs: the spider comes WebT frames after the first catch; red for the
' last 2 s
sub WebStep:
  for K = 0 to 1
    if K < NWeb then
      if WbCD[K] > 0 then dec WbCD[K]
      T = 0
      if WbN[K] > 0 then
        dec WbT[K]
        if WbT[K] < 120 then T = 1
        if WbT[K] = 0 then
          QK = K + 2
          call asm FfEatWeb
          Lost += QN
          Eaten += QN
          WbN[K] = 0
          WbCD[K] = 60
          T = 0
          play sound SndSpider
        end if
      end if
      if T <> WbRed[K] then
        WbRed[K] = T
        QX = WbX[K] >> 3
        QY = WbY[K] >> 3
        QP = 0
        if T = 1 then QP = 1
        call asm FfWebCol
      end if
    end if
  next
  return
end sub

sub GustStep:
  if GustOn = 0 then return
  if GuS = 0 then
    if GuT > 0 then
      dec GuT
      return
    end if
    if Grace > 0 then return
    GuS = 1
    GuT = 90
    Rnd
    GuD = RndV & 3
    play sound SndWarn
    return
  end if
  dec GuT
  if GuT > 0 then return
  if GuS = 1 then
    GuS = 2
    GuT = 120
    inc Gusts
    play sound SndGust
    return
  end if
  GuS = 0
  Rnd
  GuT = RndV
  GuT += 600
  if Night > 6 then GuT -= 300
  return
end sub

sub BatStep:
  if BatOn = 0 then return
  if BaOn = 0 then
    if BaT > 0 then
      dec BaT
      return
    end if
    if Grace > 0 then return
    BaOn = 1
    Rnd
    T = RndV & 1
    if T = 1 then
      BaX = 24 << 8
      BaV = 256
    else
      BaX = 231 << 8
      BaV = -256
    end if
    Rnd
    BaY0 = RndV & 63
    Rnd
    T = RndV & 31
    BaY0 += T
    BaY0 += 40
    BaPh = 0
    BaScared = 0
    BaCD = 0
    inc Bats
    play sound SndBat
    return
  end if
  BaX += BaV
  inc BaPh
  T = BaPh >> 1
  T = T & 63
  BaY = BaY0 + BatSin[T]
  if BaCD > 0 then dec BaCD
  T = highbyte BaX
  ' a bright lantern scares it off (once)
  if Bright = 1 then
    if BaScared = 0 then
      QX = T
      QY = BaY
      call asm FfDistP
      if QR < FR then
        BaScared = 1
        if T < PX then
          BaV = -512
        else
          BaV = 512
        end if
        play sound SndBat
      end if
    end if
  end if
  ' it bites on every 4th frame only (it flies 4 px in that time)
  U = BaPh & 3
  if BaCD = 0 then
    if U <> 0 then BaCD = 1
  end if
  if Bud > 0 then BaCD = 1
  if BaCD = 0 then
    inc Bud
    QX = T
    QY = BaY
    QR = 6
    call asm FfNear
    if QI < 255 then
      QK = 0
      call asm FfSetSt
      inc Lost
      inc Eaten
      BaCD = 12
      play sound SndGulp
    end if
  end if
  if T < 24 then BaOn = 0
  if T > 231 then BaOn = 0
  if BaOn = 0 then
    Rnd
    BaT = RndV & 127
    BaT += BatEvery
  end if
  return
end sub

' the per-frame inputs of FfFlies
sub FlyInputs:
  FPx = PX
  FPy = PY
  FR = Light
  FPull = 16
  if Bright = 1 then
    FR += BrightAdd
    FPull = 28
  end if
  call asm FfSetRing
  T = Tick >> 3
  FRot = T & 63
  inc FTk3
  if FTk3 >= 4 then
    FTk3 = 0
    FTb = FTb ^ 1
  end if
  inc FSepK
  FSepO += 12
  if FSepK >= FN then
    FSepK = 1
    FSepO = 12
  end if
  FWxU = 0
  FWyU = 0
  FWxL = 0
  FWyL = 0
  if GuS = 2 then
    T = 8
    if Night > 6 then T = 11
    U = T >> 2
    if Bright = 1 then U = 0
    if GuD = 0 then
      FWxU = T
      FWxL = U
    end if
    if GuD = 1 then
      FWxU = 0 - T
      FWxL = 0 - U
    end if
    if GuD = 2 then
      FWyU = T
      FWyL = U
    end if
    if GuD = 3 then
      FWyU = 0 - T
      FWyL = 0 - U
    end if
  end if
  FThN = 0
  if BaOn = 1 then
    FThX[0] = highbyte BaX
    FThY[0] = BaY
    FThN = 1
  end if
  if TgOn = 1 then
    T = FThN
    FThX[T] = TgX
    FThY[T] = TgY
    inc FThN
  end if
  return
end sub

' after FfFlies: deliveries (score, chain, the jar), catches in webs
sub FlyResults:
  if FDel > 0 then
    for K = 1 to FDel
      if SinceDel < ChainF then
        if Chain < 5 then inc Chain
      else
        Chain = 1
      end if
      SinceDel = 0
      T = Chain * 10
      Score += T
      inc Got
      inc Delivered
    next
    play sound SndJar
    JarPaint
  end if
  for K = 0 to 1
    T = FHit[K]
    if T > 0 then
      if WbN[K] = 0 then
        WbT[K] = WebT
        if Night > 6 then WbT[K] = 210
      end if
      WbN[K] += T
      Stucks += T
      play sound SndStuck
    end if
  next
  return
end sub

' the jars glow fuller: 0..12 rows lit (Got / NeedN)
sub JarPaint:
  W = Got * 12
  W = W / NeedN
  if W > 12 then W = 12
  T = lowbyte W
  if T = JarLv then return
  JarLv = T
  ' painted by the HUD, one jar a frame (spreads the VRAM work)
  JarPend = NJar
  return
end sub

' 16-bit xorshift (7, 9, 8) -> RndV
sub Rnd:
  call asm FfRnd
  return
end sub

' ===========================================================================
' sprites and HUD

sub BuildSat:
  ' slot 0-1: the lantern-bearer (blinks at 1.9 Hz during the grace period
  ' only on the first frames of a night: never, the HUD message says it)
  T = Walk >> 3
  T = T & 1
  if Moving = 0 then T = 0
  T = T << 2
  U = SLanR
  if Face = 1 then
    T += SBodyL0
    U = SLanL
  end if
  if Bright = 1 then U += 4
  Sat[0] = PY - 12
  Sat[1] = PX - 8
  Sat[2] = T
  Sat[3] = 7
  Sat[4] = PY - 12
  Sat[5] = PX - 8
  Sat[6] = U
  Sat[7] = 11
  if Lock = 1 then Sat[7] = 10
  ' slot 2: the tongue
  Sat[8] = 209
  if TgOn = 1 then
    Sat[8] = TgSY - 1
    Sat[9] = TgSX
    Sat[10] = TgP
    Sat[11] = 9
  end if
  ' slot 3: the bat
  Sat[12] = 209
  if BaOn = 1 then
    T = BaPh & 8
    T = T >> 1
    Sat[12] = BaY - 9
    U = highbyte BaX
    Sat[13] = U - 8
    Sat[14] = SBat0 + T
    Sat[15] = 13
  end if
  Sat[16] = 208
  if Ph <> PhPlay then
    Sat[8] = 209
    Sat[12] = 209
  end if
  return
end sub

' the HUD: one item a frame, only what changed. Row 1: lanterns, LV, score,
' moon + time bar. Row 22: jar + dots (2 a cell), chain, wind, oil bar.
sub Hud:
  ' (not on a frame with a delivery: FfFlies erased dots, FlyResults scored)
  T = JarPend
  if FDel > 0 then T = 0
  if Bud >= 2 then T = 0
  if T > 0 then
    dec JarPend
    K = JarPend
    QX = JaX[K] >> 3
    QY = JaY[K] >> 3
    QT = JarLv
    call asm FfJarCol
    return
  end if
  inc HudN
  if HudN >= 7 then HudN = 0
  PcR = 1
  if HudN = 0 then
    if Lives <> HLives then
      HLives = Lives
      for K = 0 to 4
        PcC = K + 2
        PcT = HBlank
        if K < Lives then PcT = HLantern
        call asm FfPutAt
      next
    end if
    return
  end if
  if HudN = 1 then
    if Night <> HNight then
      HNight = Night
      PcC = 8
      PcT = HLetA + 11
      call asm FfPutAt
      PcC = 9
      PcT = HLetA + 21
      call asm FfPutAt
      PcC = 10
      NumU = Night
      call asm FfNum2
    end if
    return
  end if
  if HudN = 2 then
    if Score <> HScore then
      HScore = Score
      call asm FfScore
    end if
    return
  end if
  if HudN = 3 then
    T = TimeC
    if T <> HTime then
      HTime = T
      PcC = 20
      PcT = HMoon
      call asm FfPutAt
      for K = 0 to 7
        PcC = K + 21
        PcT = HTempty
        if K < T then
          PcT = HTfull
          if T < 3 then PcT = HTlow
        end if
        call asm FfPutAt
      next
    end if
    return
  end if
  if MsgOn = 1 then return
  PcR = 22
  if HudN = 4 then
    if Got <> HGot then
      HGot = Got
      PcC = 2
      PcT = HJaricon
      call asm FfPutAt
      ' dots: NeedN of them, 2 a cell, filled up to Got
      U = 0
      for K = 0 to 10
        PcC = K + 3
        PcT = HBlank
        if U < NeedN then
          T = U + 1
          if T < NeedN then
            ' two dots
            PcT = HPee
            if U < Got then PcT = HPfe
            if T < Got then PcT = HPff
          else
            PcT = HPe
            if U < Got then PcT = HPf
          end if
        end if
        call asm FfPutAt
        U += 2
      next
    end if
    return
  end if
  if HudN = 5 then
    if Chain <> HChain then
      HChain = Chain
      PcC = 15
      PcT = HBlank
      if Chain > 1 then PcT = HLetA + 23
      call asm FfPutAt
      PcC = 16
      if Chain > 1 then PcT = HDig0 + Chain
      call asm FfPutAt
    end if
    ' the wind arrow: blinks (2 Hz) during the warning, steady in the gust
    T = 0
    if GuS = 1 then
      U = GuT & 16
      if U > 0 then T = 1
    end if
    if GuS = 2 then T = 1
    if T = 1 then T = GuD + 1
    if T <> HWind then
      HWind = T
      PcC = 18
      PcT = HBlank
      if T = 1 then PcT = HWr
      if T = 2 then PcT = HWl
      if T = 3 then PcT = HWd
      if T = 4 then PcT = HWu
      call asm FfPutAt
    end if
    return
  end if
  ' oil: 7 cells (Oil / 32), red while locked
  T = Oil >> 5
  if Lock = 1 then T += 8
  if T <> HOil then
    HOil = T
    PcC = 21
    PcT = HDrop
    call asm FfPutAt
    U = T & 7
    for K = 0 to 6
      PcC = K + 22
      PcT = HOempty
      if K < U then
        PcT = HOfull
        if Lock = 1 then PcT = HOlock
      end if
      call asm FfPutAt
    next
  end if
  return
end sub

' ===========================================================================
' screens

sub PlayScreen:
  InPlay = 0
  Rearm
  wait
  nmi off
  display off
  HideSpr
  call asm FfPlayVram
  for K = 0 to 16
    Sat[K] = 209
  next
  Sat[16] = 208
  return
end sub

' the field of the night (display off), then the display back on
sub StampField:
  InPlay = 0
  Rearm
  wait
  nmi off
  display off
  call asm FfStamp
  MsgOn = 0
  InPlay = 1
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      TuneOff
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  if InPlay = 1 then call asm FfSatOut
  return
end sub

sub ReadPad:
  T = 0
  if joypad(1).up then T = T | 1
  if joypad(1).down then T = T | 2
  if joypad(1).left then T = T | 4
  if joypad(1).right then T = T | 8
  if joypad(1).fire then T = T | 16
  if joypad(2).up then T = T | 1
  if joypad(2).down then T = T | 2
  if joypad(2).left then T = T | 4
  if joypad(2).right then T = T | 8
  if joypad(2).fire then T = T | 16
  Jk = T & 15
  U = WasJ ^ 15
  Edge = Jk & U
  WasJ = Jk
  Btn = T & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSpr:
  for K = 0 to 4
    T = K << 2
    Sat[T] = 208
  next
  call asm FfSatOut
  return
end sub

' every menu screen: wait, NMI off, display off, font + icons, blank names
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSpr
  call asm FfMenuVram
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TuneOff:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  TzOn = 0
  return
end sub

sub TitlePage:
  InPlay = 0
  State = 12
  NewScreen
  if TzOn = 1 then TuneOff
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzOn = 1
  TzLeft = TuneFrames
  call asm FfLogo
  print at 5,8, "HERD THEM HOME BY DAWN"
  print at 12,13, "START"
  print at 12,15, "HOW TO PLAY"
  print at 12,17, "CREDITS"
  put char IJar0 at 25,14
  put char IJar1 at 26,14
  put char IJar2 at 25,15
  put char IJar3 at 26,15
  Menu = 0
  ShowMenu
  TtStart
  ShowScreen
  State = StTitle
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleGlow
  TtScene
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    ShowMenu
    if TzOn = 0 then play sound SndClick
  end if
  if Press = 0 then goto tp_loop
  if TzOn = 1 then TuneOff
  State = 12
  HideSpr
  sprites simple
  return
end sub

' 8 fireflies round the logo glow on and off slowly (each 40 frames on,
' 24 off: under 1 Hz), each on its own phase
sub TitleGlow:
  K = Tick & 7
  T = K << 3
  T += Tick
  T = T & 63
  J = K << 1
  U = 32
  if T < 40 then U = IFly
  put char U at GlowX[K],GlowY[K]
  return
end sub

' ===========================================================================
' the title scene, with magnified sprites (sprites double: 16 x 16 patterns
' shown 32 x 32): the lantern-bearer (body + lantern, two colour layers)
' walks along the bottom (rows 19-22) from the left edge (the early-clock
' bit carries him in from x = -32) to the right, 0.5 px a frame. Two fireflies
' (a one-pixel pattern: a 2 x 2 dot) circle the lantern on an ellipse from
' the BatSin wave (x = 21 sin, y = 10 cos); one passing behind the bearer is
' put after him in the sprite table (drawn behind). Each time he comes in,
' the second firefly flies up (a straight line + a BatSin wobble, 128
' frames) and lands on a letter of the logo, glows there 3 s, then homes
' back to its place round the lantern. 4 sprites in all (never more than 4
' on a line, no flicker); the glow changes colour at 1 Hz at most.
' Sat order: front fireflies, lantern, body, fireflies behind.
sub TtStart:
  TtXW = -32
  TtA = 0
  TtB = 0
  TtN = 0
  sprites double
  TtScene
  return
end sub

' one sprite into Sat[TtK]: y V, x Si (-32..255, early clock below 0),
' pattern K, colour U; TtK += 4
sub TtPut:
  T = TtK
  if Si < 0 then
    Si += 32
    U = U | 128
  end if
  if Si > 255 then V = 200
  Sat[T] = V
  inc T
  Sat[T] = Si
  inc T
  Sat[T] = K
  inc T
  Sat[T] = U
  TtK += 4
  return
end sub

sub TtScene:
  ' the bearer: half a pixel a frame; a new walk from the left edge
  T = Tick & 1
  if T = 0 then inc TtXW
  if TtXW > 256 then
    TtXW = -32
  end if
  if TtXW = 0 then
    if TtB = 0 then
      ' the second firefly sets off for a letter (3 in turn)
      TtB = 1
      TtG = 0
      inc TtN
      if TtN > 2 then TtN = 0
    end if
  end if
  inc TtA
  TtK = 0
  ' away from the ring this frame (fixed for all three passes)
  TtAw = TtB
  ' pass 0: fireflies in front (ring angle in the lower half), pass 1: the
  ' bearer, pass 2: fireflies behind
  for J = 0 to 2
    if J = 1 then
      ' the lantern (bright, yellow) and the body (light blue), walking frames
      Si = TtXW
      V = 149
      K = SLanR
      U = 10
      TtPut
      Si = TtXW
      V = 149
      T = Tick & 16
      T = T >> 2
      K = SBodyR0 + T
      U = 7
      TtPut
    else
      TtFly
    end if
  next
  Sat[TtK] = 208
  call asm FfSatOut
  return
end sub

' the two fireflies for pass J (0 front, 2 behind)
sub TtFly:
  for H = 0 to 1
    ' ring point: angle a = TtA / 2 (+ 32 for the second), 64 steps a turn
    T = TtA >> 1
    if H = 1 then T += 32
    T = T & 63
    D = T + 16
    D = D & 63
    ' behind = the upper half of the ring (cos < 0)
    U = 0
    if D >= 32 then U = 2
    ' the second firefly away from the ring: in front
    if H = 1 then
      if TtAw > 0 then U = 0
    end if
    if U = J then
      ' x = 1.5 x 14 sin, y = 0.75 x 14 cos round the lantern
      W = BatSin[T]
      if W > 127 then W = W | $FF00
      Si = W
      Sj2 = Si >> 1
      Si += Sj2
      Si += TtXW
      Si += 24
      W = BatSin[D]
      if W > 127 then W = W | $FF00
      Sj = W
      Sj = Sj >> 1
      Sj2 = Sj >> 1
      Sj += Sj2
      Sj += 168
      if H = 1 then
        if TtAw > 0 then TtStep
      end if
      V = Sj
      K = SDot
      U = 11
      if H = 1 then U = 3
      if TtB = 4 then
        ' landed: glow, light / dark yellow, 1 Hz
        T = TtG & 32
        U = 11
        if T > 0 then U = 10
      end if
      TtPut
    end if
  next
  return
end sub

' the second firefly away from the ring: TtB = leg 1..7 (TtLx/TtLy: the
' leg's end, x 0 = the letter; TtLs: 128 >> s frames), 4 = resting on the
' letter, 8 = homing back to its ring point. The route keeps off the text:
' up the left margin, along row 6 (between the logo and the tagline), up
' onto the letter; back: row 6 to the right margin, down it, then home.
' Positions in 1/128 px: a leg adds (end - start) << s each frame, exact.
' A BatSin wobble (one period a leg, +-3 px) across the way it flies.
' in: Si, Sj = its ring point; out: Si, Sj = where it is
sub TtStep:
  inc TtG
  if TtB = 4 then
    if TtG >= 120 then
      TtB = 5
      TtG = 0
    end if
  elseif TtB = 8 then
    ' home in: an eighth of the way a frame (at least 1 px)
    TtVx = TtBx >> 7
    TtVx = Si - TtVx
    TtVy = TtBy >> 7
    TtVy = Sj - TtVy
    D = 0
    Si = TtVx >> 3
    if Si = 0 then
      if TtVx > 0 then Si = 1
      if TtVx < 0 then Si = -1
    end if
    if TtVx = 0 then inc D
    Si = Si << 7
    TtBx += Si
    Si = TtVy >> 3
    if Si = 0 then
      if TtVy > 0 then Si = 1
      if TtVy < 0 then Si = -1
    end if
    if TtVy = 0 then inc D
    Si = Si << 7
    TtBy += Si
    if D = 2 then TtB = 0
    if TtG = 255 then TtB = 0
  else
    V = TtB - 1
    K = TtLs[V]
    if TtG = 1 then
      ' a new leg: from the ring point (leg 1) or where the last one ended
      if TtB = 1 then
        TtBx = Si << 7
        TtBy = Sj << 7
      end if
      U = TtLx[V]
      if U = 0 then U = TtLandX[TtN]
      TtVx = U
      W = TtBx >> 7
      Si = W
      TtVx -= Si
      TtVx = TtVx << K
      U = TtLy[V]
      TtVy = U
      W = TtBy >> 7
      Si = W
      TtVy -= Si
      TtVy = TtVy << K
    end if
    TtBx += TtVx
    TtBy += TtVy
    T = 128 >> K
    if TtG >= T then
      inc TtB
      TtG = 0
    end if
  end if
  Si = TtBx >> 7
  Sj = TtBy >> 7
  ' the wobble
  if TtG > 0 then
    if TtB <> 4 then
      if TtB <> 8 then
        T = TtG << K
        T = T >> 1
        T = T & 63
        W = BatSin[T]
        if W > 127 then W = W | $FF00
        D = 0
        Sj2 = W
        Sj2 = Sj2 >> 2
        if TtVx = 0 then
          Si += Sj2
        else
          Sj += Sj2
        end if
      end if
    end if
  end if
  return
end sub

data TtLandX bytes
  72, 122, 158
end data
' legs 1-7: end x (0 = the letter), end y, frames = 128 >> s (leg 4 = rest)
data TtLx bytes
  24, 0, 0, 0, 0, 232, 232
end data
data TtLy bytes
  52, 52, 22, 22, 52, 52, 150
end data
data TtLs bytes
  1, 1, 2, 0, 2, 1, 1
end data

sub ShowMenu:
  put char 32 at 10,13
  put char 32 at 10,15
  put char 32 at 10,17
  T = Menu << 1
  T += 13
  put char 62 at 10,T
  return
end sub

sub PageWait:
  ShowScreen
  State = PgState
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  State = 12
  return
end sub

sub CreditsPage:
  State = 12
  NewScreen
  call asm FfLogo
  print at 8,8, "AN ORIGINAL GAME"
  print at 5,11, "A GAME BY AMY & CLAUDE"
  print at 8,13, "AMY STUDIO 2026"
  print at 5,16, "MUSIC: AN ORIGINAL TUNE"
  print at 5,18, "MADE FOR COLECOVISION"
  print at 8,21, "PRESS THE BUTTON"
  PgState = StCredits
  PageWait
  return
end sub

sub HowTo:
  State = StHow
  PgState = StHow
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  put char IJar0 at 3,4
  put char IJar1 at 4,4
  put char IJar2 at 3,5
  put char IJar3 at 4,5
  print at 7,4, "LEAD THE FIREFLIES"
  print at 7,6, "INTO THE GLASS JAR."
  put char IPff at 3,10
  put char IPff at 4,10
  put char IPee at 5,10
  print at 7,10, "FILL THE JAR BEFORE"
  print at 7,12, "DAWN: THE DOTS SHOW"
  print at 7,14, "HOW MANY ARE NEEDED."
  put char IMoon at 3,17
  put char ITfull at 4,17
  print at 7,17, "THE MOON BAR IS THE"
  print at 7,19, "TIME LEFT TONIGHT."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    print at 7,3, "THEY FOLLOW YOUR"
    print at 7,5, "LANTERN. DONT RUN:"
    print at 7,7, "STRAYS GET LEFT."
    put char IFly at 3,8
    put char IDrop at 3,11
    put char IOfull at 4,11
    print at 7,11, "HOLD THE BUTTON TO"
    print at 7,13, "SHINE BRIGHT: STRONG"
    print at 7,15, "PULL, BURNS OIL."
    put char IFly at 3,18
    put char IFly at 4,18
    print at 7,18, "QUICK JARS: X2..X5"
    print at 7,20, "SAVE ALL: +200"
    ' the lantern-bearer, bright
    Sat[0] = 23
    Sat[1] = 24
    Sat[2] = SBodyR0
    Sat[3] = 7
    Sat[4] = 23
    Sat[5] = 24
    Sat[6] = SLanRB
    Sat[7] = 11
    Sat[8] = 208
    call asm FfSatOut
    PageWait
    HideSpr
  end if
  if TimedOut = 0 then
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    put char IFrog0 at 3,3
    put char IFrog1 at 4,3
    put char IFrogp2 at 3,4
    put char IFrogp3 at 4,4
    print at 7,3, "FROGS PUFF, THEN"
    print at 7,5, "SNAP NEAR THE POND."
    put char IWeba0 at 3,8
    put char IWeba1 at 4,8
    put char IWeba2 at 3,9
    put char IWeba3 at 4,9
    print at 7,8, "WEBS TRAP STRAYS:"
    print at 7,10, "WALK INTO THE WEB"
    print at 7,12, "TO FREE THEM."
    put char IWr at 3,15
    print at 7,15, "WIND SCATTERS THEM."
    print at 7,18, "BATS FLEE A BRIGHT"
    print at 7,20, "LANTERN."
    ' a bat
    Sat[0] = 136
    Sat[1] = 24
    Sat[2] = SBat0
    Sat[3] = 13
    Sat[4] = 208
    call asm FfSatOut
    PageWait
    HideSpr
  end if
  HideSpr
  return
end sub

' ===========================================================================
' Z80: the swarm

' FfFlies: every firefly, every frame. Record (12 bytes, IX):
'  +0 x frac, +1 x, +2 y frac, +3 y, +4 vx, +5 vy (signed, 1/32 px),
'  +6 state (bits 0-2: 0 gone, 1 free, 2/3 stuck in web 0/1, 4 home;
'     bit 6: drawn on 2 rows, bit 7: lit), +7 +8 home x y,
'  +9 +10 VRAM address of the drawn dot, +11 its mask (0 = not drawn)
sub FfSwarm:
  asm {
FfFlies:
    push ix
    push iy
    ld ix,Fl
    xor a
    ld (FFree),a
    ld (FStk),a
    ld (FDel),a
    ld (FHit),a
    ld (FHit+1),a
    ; counts over the whole swarm: free (1), stuck in a web (2, 3)
    ld a,(FN)
    or a
    jp z,FfDone
    ld b,a
    ld hl,Fl + 6
    ld de,12
    ld c,0
FfCt1:
    ld a,(hl)
    and 7
    dec a
    jr nz,FfCt2
    inc c
    jr FfCt3
FfCt2:
    dec a
    cp 2
    jr nc,FfCt3
    ld a,(FStk)
    inc a
    ld (FStk),a
FfCt3:
    add hl,de
    djnz FfCt1
    ld a,c
    ld (FFree),a
    ; a quarter of the swarm a frame: the records whose index mod 4 is FTk3
    ld a,(FTk3)
    ld (FI),a
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,de
    ld de,Fl
    add hl,de
    push hl
    pop ix
FfLoop:
    ld a,(FI)
    ld hl,FN
    cp (hl)
    jp nc,FfDone
    ld a,(ix+6)
    and 7
    cp 1
    jp z,FfFree
    or a
    jr z,FfGoneF
    cp 4
    jr z,FfGoneF
    jp FfNext
FfGoneF:
    ld a,(ix+11)
    or a
    jp z,FfNext
    call FfErase
    ld (ix+11),0
    jp FfNext
FfFree:
    ld b,(ix+1)
    ld a,(FPx)
    call FfSDiff
    ld (FDx),a
    ld b,(ix+3)
    ld a,(FPy)
    call FfSDiff
    ld (FDy),a
    ; distance = max + min / 2
    ld a,(FDx)
    bit 7,a
    jr z,FfAb1
    neg
FfAb1:
    ld d,a
    ld a,(FDy)
    bit 7,a
    jr z,FfAb2
    neg
FfAb2:
    cp d
    jr c,FfDm1
    ld e,a
    ld a,d
    srl a
    add a,e
    jr FfDm2
FfDm1:
    srl a
    add a,d
FfDm2:
    ld hl,FR
    cp (hl)
    jp nc,FfUnlit
    ; ---- lit: steer to the ring slot round the lantern ----
    set 7,(ix+6)
    ld a,(FI)
    ld e,a
    ld d,0
    ld hl,FSlot
    add hl,de
    ld a,(FRot)
    add a,(hl)
    and 63
    add a,a
    ld e,a
    ld hl,(FRingP)
    add hl,de
    ld a,(FPull)
    ld c,a
    ld a,(FDx)
    add a,(hl)
    call FfClamp
    ld (FAx),a
    inc hl
    ld a,(FDy)
    add a,(hl)
    call FfClamp
    ld (FAy),a
    ld a,(ix+1)
    ld (ix+7),a
    ld a,(ix+3)
    ld (ix+8),a
    ld a,1
    ld (FDamp),a
    jp FfNb
FfUnlit:
    ; ---- unlit: drift home, jitter; every 8th frame (8-frame steps): a
    ; group's FI parity is FTk3's, FTb flips every 4 frames ----
    res 7,(ix+6)
    ld a,(FI)
    ld hl,FTb
    xor (hl)
    and 1
    jp nz,FfNext
    ld b,(ix+1)
    ld a,(ix+7)
    call FfSDiff
    sra a
    sra a
    ld c,4
    call FfClamp
    ld (FAx),a
    ld b,(ix+3)
    ld a,(ix+8)
    call FfSDiff
    sra a
    sra a
    ld c,4
    call FfClamp
    ld (FAy),a
    call FfRnd
    ld b,a
    and 3
    ld e,a
    ld d,0
    ld hl,JitTab
    add hl,de
    ld a,(FAx)
    add a,(hl)
    ld (FAx),a
    ld a,b
    rrca
    rrca
    and 3
    ld e,a
    ld hl,JitTab
    add hl,de
    ld a,(FAy)
    add a,(hl)
    ld (FAy),a
    ld a,2
    ld (FDamp),a
FfNb:
    ; ---- one neighbour (unlit fireflies only: lit ones keep their ring
    ; slot): FSepK records on (wrapping) ----
    bit 7,(ix+6)
    jp nz,FfThr
    push ix
    pop hl
    ld de,(FSepO)
    add hl,de
    ld de,Fl
    or a
    sbc hl,de
    ld de,(FEnd)
    or a
    sbc hl,de
    jr nc,FfNb1
    add hl,de
FfNb1:
    ld de,Fl
    add hl,de
    push hl
    pop iy
    ld a,(iy+6)
    and 7
    cp 1
    jp nz,FfThr
    ld b,(ix+1)
    ld a,(iy+1)
    call FfSDiff
    ld (FEx),a
    ld b,(ix+3)
    ld a,(iy+3)
    call FfSDiff
    ld (FEy),a
    ld a,(FEx)
    call FfSAbs
    cp 5
    jr nc,FfCoh
    ld a,(FEy)
    call FfSAbs
    cp 5
    jr nc,FfCoh
    ; separation: 8 away on each axis
    ld c,8
    ld a,(FEx)
    ld hl,FAx
    call FfAway
    ld a,(FEy)
    ld hl,FAy
    call FfAway
    jp FfThr
FfCoh:
    ; cohesion (both unlit, within 32): 1 toward
    bit 7,(ix+6)
    jp nz,FfThr
    bit 7,(iy+6)
    jp nz,FfThr
    ld a,(FEx)
    call FfSAbs
    cp 32
    jr nc,FfThr
    ld a,(FEy)
    call FfSAbs
    cp 32
    jr nc,FfThr
    ld a,(FEx)
    ld hl,FAx
    call FfToward
    ld a,(FEx)
    call FfToward
    ld a,(FEy)
    ld hl,FAy
    call FfToward
    ld a,(FEy)
    call FfToward
FfThr:
    ; ---- threats (bat, tongue tip): 10 away within 24 ----
    ld a,(FThN)
    or a
    jr z,FfWind
    ld b,a
    ld de,0
FfTh1:
    push bc
    push de
    ld hl,FThX
    add hl,de
    ld a,(hl)
    push hl
    ld b,(ix+1)
    call FfSDiff
    ld (FEx),a
    pop hl
    ld de,2
    add hl,de
    ld a,(hl)
    ld b,(ix+3)
    call FfSDiff
    ld (FEy),a
    call FfSAbs
    cp 24
    jr nc,FfTh2
    ld a,(FEx)
    call FfSAbs
    cp 24
    jr nc,FfTh2
    ld c,20
    ld a,(FEx)
    ld hl,FAx
    call FfAway
    ld a,(FEy)
    ld hl,FAy
    call FfAway
FfTh2:
    pop de
    inc de
    pop bc
    djnz FfTh1
FfWind:
    ; ---- wind ----
    ld hl,FWxU
    bit 7,(ix+6)
    jr z,FfWi1
    ld hl,FWxL
FfWi1:
    ld a,(FAx)
    add a,(hl)
    ld (FAx),a
    inc hl
    ld a,(FAy)
    add a,(hl)
    ld (FAy),a
    ; ---- velocity: damping, acceleration, at most 52 ----
    ld a,(ix+4)
    call FfDampA
    ld hl,FAx
    add a,(hl)
    call FfVmax
    ld (ix+4),a
    ld a,(ix+5)
    call FfDampA
    ld hl,FAy
    add a,(hl)
    call FfVmax
    ld (ix+5),a
    ; ---- position (8.8) += v * 8, kept in the field ----
    ld a,(ix+4)
    ld l,a
    add a,a
    sbc a,a
    ld h,a
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    bit 7,(ix+6)
    jr nz,FfPx1
    add hl,hl
FfPx1:
    ld e,(ix+0)
    ld d,(ix+1)
    add hl,de
    ld a,h
    cp 17
    jr nc,FfBx1
    ld h,17
    jr FfBx2
FfBx1:
    cp 238
    jr c,FfBx3
    ld h,237
FfBx2:
    ld a,(ix+4)
    neg
    ld (ix+4),a
FfBx3:
    ld (FNx),hl
    ld a,(ix+5)
    ld l,a
    add a,a
    sbc a,a
    ld h,a
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    bit 7,(ix+6)
    jr nz,FfPy1
    add hl,hl
FfPy1:
    ld e,(ix+2)
    ld d,(ix+3)
    add hl,de
    ld a,h
    cp 17
    jr nc,FfBy1
    ld h,17
    jr FfBy2
FfBy1:
    cp 174
    jr c,FfBy3
    ld h,173
FfBy2:
    ld a,(ix+5)
    neg
    ld (ix+5),a
FfBy3:
    ld (FNy),hl
    ; ---- the cell under the new position (looked up only on a new cell) ----
    ld a,(ix+3)
    xor h
    and $F8
    jr nz,FfCk1
    ld a,(FNx+1)
    xor (ix+1)
    and $F8
    jr z,FfCk2
FfCk1:
    ld a,(FNx+1)
    ld (QX),a
    ld a,h
    ld (QY),a
    call FfClsQ
    jr FfCk3
FfCk2:
    xor a
FfCk3:
    cp 3
    jr nz,FfMv1
    ; a frog: bounce back, stay
    ld a,(ix+4)
    neg
    ld (ix+4),a
    ld a,(ix+5)
    neg
    ld (ix+5),a
    jp FfDraw
FfMv1:
    ld hl,(FNx)
    ld (ix+0),l
    ld (ix+1),h
    ld hl,(FNy)
    ld (ix+2),l
    ld (ix+3),h
    cp 4
    jr nz,FfMv2
    ; into a jar: home
    ld a,(ix+6)
    and $C0
    or 4
    ld (ix+6),a
    ld hl,FDel
    inc (hl)
    ld a,(ix+11)
    or a
    jp z,FfNext
    call FfErase
    ld (ix+11),0
    jp FfNext
FfMv2:
    cp 5
    jr c,FfDraw
    ; a web (5 / 6) unless it was just touched (WbCD)
    sub 5
    ld e,a
    ld d,0
    ld hl,WbCD
    add hl,de
    ld a,(hl)
    or a
    jr nz,FfDraw
    ld hl,FHit
    add hl,de
    inc (hl)
    ld a,e
    add a,2
    ld e,a
    ld a,(ix+6)
    and $C0
    or e
    ld (ix+6),a
    ld (ix+4),0
    ld (ix+5),0
FfDraw:
    ; ---- the glyph in a 4 x 4 window inside the firefly's own cell (x, y
    ; rounded to 2 px; a window that would leave the cell is pulled back 2 px,
    ; so no glyph ever touches another cell: frog tiles stay clean) ----
    ld a,(ix+1)
    ld e,a
    and $F8
    ld l,a
    ld a,(ix+3)
    ld d,a
    rrca
    rrca
    rrca
    and 31
    ld h,a
    ld a,d
    and 6
    cp 6
    jr nz,FfDw1
    ld a,4
FfDw1:
    or l
    ld l,a
    ld a,e
    and 6
    cp 6
    jr nz,FfDw2
    ld a,4
FfDw2:
    rrca
    ld c,a
    ; shape: lit = glow 4 x 4 (40 frames in 64) / core 2 x 2 (a 0.94 Hz
    ; pulse, phase Tick + 11 i); in a web: 2 x 2; stray: 2 x 1, dim night 1 x 1
    bit 7,(ix+6)
    jr z,FfDu
    ld a,(FI)
    ld b,a
    add a,a
    add a,a
    add a,a
    add a,b
    add a,b
    add a,b
    ld b,a
    ld a,(Tick)
    add a,b
    and 63
    cp 24
    ld a,0
    jr nc,FfDs
    ld a,3
    jr FfDs
FfDu:
    ld a,(ix+6)
    and 7
    cp 1
    ld a,3
    jr nz,FfDs
    ld a,(FDim)
    or a
    ld a,6
    jr z,FfDs
    ld a,9
FfDs:
    add a,c
    inc a
    ld c,a
    ; same as drawn? (address, glyph)
    ld a,(ix+11)
    cp c
    jr nz,FfDc
    ld a,(ix+9)
    cp l
    jr nz,FfDc
    ld a,(ix+10)
    cp h
    jr z,FfNext
FfDc:
    push bc
    push hl
    ld a,(ix+11)
    or a
    call nz,FfErase
    pop hl
    pop bc
    ld (ix+9),l
    ld (ix+10),h
    ld (ix+11),c
    ld a,c
    call FfGlyph
FfNext:
    ld de,48
    add ix,de
    ld a,(FI)
    add a,4
    ld (FI),a
    jp FfLoop
FfDone:
    pop iy
    pop ix
    ret
; erase the dot drawn for record ix
FfErase:
    ld l,(ix+9)
    ld h,(ix+10)
    ld a,(ix+11)
; XOR glyph a (1..12: shape * 3 + k + 1) at VRAM hl (4 pattern rows of one
; cell; read-modify-write spaced for the active display)
FfGlyph:
    dec a
    add a,a
    add a,a
    ld e,a
    ld d,0
    push hl
    ld hl,GlyTab
    add hl,de
    ex de,hl
    pop hl
    ld b,4
FfGy1:
    ld a,(de)
    or a
    jr z,FfGy2
    ld c,a
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    out (VDP_CTRL_PORT),a
    nop                 ; paced: >= 29 T from the address set-up to the IN
    nop                 ; (mid-screen the read-ahead waits up to 26 T for a
    nop                 ; slot); was ex (sp),hl x2, which the r11 optimizer
    nop                 ; deletes: plain NOPs are kept
    in a,(VDP_DATA_PORT)
    xor c
    ld c,a
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld a,c
    out (VDP_DATA_PORT),a
FfGy2:
    inc de
    inc hl
    djnz FfGy1
    ret
; VRAM byte hl ^= c (read-modify-write, spaced for the active display)
FfXor:
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    out (VDP_CTRL_PORT),a
    nop                 ; paced: >= 29 T from the address set-up to the IN
    nop                 ; (mid-screen the read-ahead waits up to 26 T for a
    nop                 ; slot); was ex (sp),hl x2, which the r11 optimizer
    nop                 ; deletes: plain NOPs are kept
    in a,(VDP_DATA_PORT)
    xor c
    ld d,a
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld a,d
    out (VDP_DATA_PORT),a
    ret
; a = a - b as a signed byte, clamped to -127..127
FfSDiff:
    sub b
    jr c,FfSd1
    cp 128
    ret c
    ld a,127
    ret
FfSd1:
    cp 129
    ret nc
    ld a,$81
    ret
; |a| (signed byte)
FfSAbs:
    bit 7,a
    ret z
    neg
    ret
; a clamped to -c..c (signed)
FfClamp:
    bit 7,a
    jr nz,FfCl1
    cp c
    ret c
    ld a,c
    ret
FfCl1:
    neg
    cp c
    jr c,FfCl2
    ld a,c
FfCl2:
    neg
    ret
; (hl) -= c if a >= 0, else += c (push away from a delta)
FfAway:
    bit 7,a
    ld a,(hl)
    jr nz,FfAw1
    sub c
    ld (hl),a
    ret
FfAw1:
    add a,c
    ld (hl),a
    ret
; (hl) += sgn(a)
FfToward:
    or a
    ret z
    bit 7,a
    jr nz,FfTw1
    inc (hl)
    ret
FfTw1:
    dec (hl)
    ret
; a clamped to -52..52 (fast when inside)
FfVmax:
    cp 53
    ret c
    cp 204
    ret nc
    bit 7,a
    ld a,52
    ret z
    ld a,204
    ret
; a = v - (v >> FDamp) (arithmetic; FDamp 1 lit, 2 unlit)
FfDampA:
    ld b,a
    sra a
    ld c,a
    ld a,(FDamp)
    dec a
    jr z,FfDa1
    sra c
FfDa1:
    ld a,b
    sub c
    ret
  }
end sub

' Z80 helpers for the Amy code
sub FfHelp:
  asm {
; QX, QY -> QC = the class of that pixel's cell (outside the field: 1)
FfCls:
    call FfClsQ
    ld (QC),a
    ret
FfClsQ:
    ld a,(QX)
    sub 16
    jr c,FfCq9
    cp 224
    jr nc,FfCq9
    rrca
    rrca
    rrca
    and 31
    ld c,a
    ld a,(QY)
    sub 16
    jr c,FfCq9
    cp 160
    jr nc,FfCq9
    and $F8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld a,l
    or c
    ld l,a
    ld de,(FMap)
    add hl,de
    ld e,(hl)
    ld d,0
    ld hl,TileCls
    add hl,de
    ld a,(hl)
    ret
FfCq9:
    ld a,1
    ret
; QX, QY = the player -> QB = 1 if the 7 x 7 footprint touches a bush,
; stump, pond, frog or jar (or leaves the field)
FfBlk:
    ld a,(QX)
    ld b,a
    ld a,(QY)
    ld c,a
    ld e,0
    ld d,4
FfBk1:
    push bc
    push de
    ld a,d
    and 1
    ld a,b
    jr z,FfBk2
    add a,6
FfBk2:
    sub 3
    ld (QX),a
    ld a,d
    and 2
    ld a,c
    jr z,FfBk3
    add a,6
FfBk3:
    sub 3
    ld (QY),a
    call FfClsQ
    pop de
    pop bc
    or a
    jr z,FfBk4
    cp 5
    jr nc,FfBk4
    ld e,1
FfBk4:
    dec d
    jr nz,FfBk1
    ld a,b
    ld (QX),a
    ld a,c
    ld (QY),a
    ld a,e
    ld (QB),a
    ret
; the leading edge of the 7 x 7 footprint: QX = edge x, QY = centre y
; (FfBlkH) or QX = centre x, QY = edge y (FfBlkV) -> QB = 1 if either end
; of that edge is on a bush, stump, pond, frog or jar (or off the field)
FfBlkH:
    ld de,$0003
    jr FfBe0
FfBlkV:
    ld de,$0300
FfBe0:
    ld a,(QX)
    ld b,a
    ld a,(QY)
    ld c,a
    xor a
    ld (QB),a
    ld a,b
    sub d
    ld (QX),a
    ld a,c
    sub e
    ld (QY),a
    push bc
    push de
    call FfBe1
    pop de
    pop bc
    ld a,b
    add a,d
    ld (QX),a
    ld a,c
    add a,e
    ld (QY),a
FfBe1:
    call FfClsQ
    or a
    ret z
    cp 5
    ret nc
    ld a,1
    ld (QB),a
    ret
; QX, QY, QR -> QI = the nearest free firefly within QR (each axis), or 255
FfNear:
    ld a,255
    ld (QI),a
    ld a,(QR)
    inc a
    ld e,a
    ld a,(FN)
    ld b,a
    ld c,0
    ld hl,Fl + 6
FfNr1:
    ld a,(hl)
    and 7
    dec a
    jr nz,FfNr3
    dec hl
    dec hl
    dec hl
    ld a,(QY)
    sub (hl)
    jr nc,FfNr4
    neg
FfNr4:
    cp e
    jr nc,FfNr8
    ld d,a
    dec hl
    dec hl
    ld a,(QX)
    sub (hl)
    jr nc,FfNr5
    neg
FfNr5:
    cp d
    jr nc,FfNr6
    ld a,d
FfNr6:
    inc hl
    inc hl
    inc hl
    inc hl
    inc hl
    cp e
    jr nc,FfNr3
    ld e,a
    ld a,c
    ld (QI),a
    jr FfNr3
FfNr8:
    inc hl
    inc hl
    inc hl
FfNr3:
    ld a,l
    add a,12
    ld l,a
    jr nc,FfNr7
    inc h
FfNr7:
    inc c
    djnz FfNr1
    ret
; QX, QY -> QR = the game's distance (max + min / 2, capped 255) to the lantern
FfDistP:
    ld a,(QX)
    ld b,a
    ld a,(PX)
    sub b
    jr nc,FfDp1
    neg
FfDp1:
    ld d,a
    ld a,(QY)
    ld b,a
    ld a,(PY)
    sub b
    jr nc,FfDp2
    neg
FfDp2:
    cp d
    jr c,FfDp3
    ld e,a
    ld a,d
    ld d,e
FfDp3:
    srl a
    add a,d
    jr nc,FfDp4
    ld a,255
FfDp4:
    ld (QR),a
    ret
; firefly QI -> state QK (0 = gone: erased by FfFlies)
FfSetSt:
    call FfRecQ
    ld a,(hl)
    and $C0
    ld b,a
    ld a,(QK)
    or b
    ld (hl),a
    ret
; hl = &record[QI] + 6
FfRecQ:
    ld a,(QI)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,de
    ld de,Fl + 6
    add hl,de
    ret
; firefly QI: free at QX, QY, still, not drawn
FfInit:
    call FfRecQ
    ld (hl),1
    ld de,-6
    add hl,de
    ld (hl),128
    inc hl
    ld a,(QX)
    ld (hl),a
    inc hl
    ld (hl),128
    inc hl
    ld a,(QY)
    ld (hl),a
    inc hl
    ld (hl),0
    inc hl
    ld (hl),0
    inc hl
    inc hl
    ld a,(QX)
    ld (hl),a
    inc hl
    ld a,(QY)
    ld (hl),a
    inc hl
    ld (hl),0
    inc hl
    ld (hl),0
    inc hl
    ld (hl),0
    ret
; firefly QI: gone, not drawn
FfGone:
    call FfRecQ
    ld (hl),0
    ld de,5
    add hl,de
    ld (hl),0
    ret
; free web QK's fireflies (state 2 + QK), pushed out from QX, QY -> QN
FfFreeWeb:
    push ix
    ld ix,Fl
    xor a
    ld (QN),a
    ld a,(QK)
    add a,2
    ld c,a
    ld a,(FN)
    ld b,a
FfFw1:
    ld a,(ix+6)
    and 7
    cp c
    jr nz,FfFw2
    ld a,(ix+6)
    and $C0
    or 1
    ld (ix+6),a
    ld hl,QN
    inc (hl)
    ld a,(QX)
    cp (ix+1)
    ld a,40
    jr c,FfFw3
    ld a,-40
FfFw3:
    ld (ix+4),a
    ld a,(QY)
    cp (ix+3)
    ld a,40
    jr c,FfFw4
    ld a,-40
FfFw4:
    ld (ix+5),a
FfFw2:
    ld de,12
    add ix,de
    djnz FfFw1
    pop ix
    ret
; the spider eats web state QK's fireflies -> QN
FfEatWeb:
    ld hl,Fl + 6
    xor a
    ld (QN),a
    ld a,(QK)
    ld c,a
    ld a,(FN)
    ld b,a
    ld de,12
FfEw1:
    ld a,(hl)
    and 7
    cp c
    jr nz,FfEw2
    ld a,(hl)
    and $C0
    ld (hl),a
    ld a,(QN)
    inc a
    ld (QN),a
FfEw2:
    add hl,de
    djnz FfEw1
    ret
; the tongue's aim from frog K (FgX/FgY) to firefly QI: FgA/FgB = 0, 1, 2
; (left/none/right, up/none/down): an axis counts when it is over half the other
FfAim:
    call FfRecQ
    dec hl
    dec hl
    ld a,(hl)
    ld b,a
    dec hl
    dec hl
    ld c,(hl)
    ld a,(K)
    ld e,a
    ld d,0
    ld hl,FgX
    add hl,de
    ld a,c
    sub (hl)
    ld c,a
    ld hl,FgY
    add hl,de
    ld a,b
    sub (hl)
    ld b,a
    ; c = dx, b = dy (signed); |dx|, |dy|
    ld a,c
    call FfSAbs
    ld h,a
    ld a,b
    call FfSAbs
    ld l,a
    ; x: |dx| * 2 > |dy|
    push de
    ld a,h
    add a,a
    cp l
    ld a,1
    jr c,FfAm2
    jr z,FfAm2
    ld a,c
    rlca
    and 1
    xor 1
    add a,a
FfAm2:
    ld e,a
    ld a,l
    add a,a
    cp h
    ld a,1
    jr c,FfAm3
    jr z,FfAm3
    ld a,b
    rlca
    and 1
    xor 1
    add a,a
FfAm3:
    ld b,a
    ld a,e
    pop de
    ld hl,FgA
    add hl,de
    ld (hl),a
    ld hl,FgB
    add hl,de
    ld (hl),b
    ret
; the ring table for this frame (bright: the tighter ring)
FfSetRing:
    ld hl,RingN
    ld a,(Bright)
    or a
    jr z,FfSr1
    ld hl,RingB
FfSr1:
    ld (FRingP),hl
    ret
; 16-bit xorshift -> RndV (and a)
FfRnd:
    ld hl,(Seed)
    ld a,h
    rra
    ld a,l
    rra
    xor h
    ld h,a
    ld a,l
    rra
    ld a,h
    rra
    xor l
    ld l,a
    xor h
    ld h,a
    ld (Seed),hl
    ld (RndV),a
    ret
  }
end sub

' ===========================================================================
' Z80: VRAM (screens, field stamping, HUD)

sub FfVram:
  asm {
FfSetR3:
    ld bc,$03FF
    jp WRITE_REGISTER
; hl = VRAM address to write
FfWa:
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ret
; the sprite table (17 bytes)
FfSatOut:
    ld hl,$1B00
    call FfWa
    ld hl,Sat
    ld b,17
FfSo1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    nop
    djnz FfSo1
    ret
; bc bytes from hl to VRAM de (spaced: safe with the display on)
FfCopyV:
    push hl
    ex de,hl
    call FfWa
    pop hl
FfCv1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    dec bc
    ld a,b
    or c
    jr nz,FfCv1
    ret
; bc bytes of e at VRAM hl
FfFillV:
    call FfWa
FfFv1:
    ld a,e
    out (VDP_DATA_PORT),a
    dec bc
    ld a,b
    or c
    jr nz,FfFv1
    ret
; menus: the font at codes 32-95 and the icons at 128+ in every third,
; text white on black
FfMenuVram:
    ld de,0
    call FfMv3
    ld de,$0800
    call FfMv3
    ld de,$1000
FfMv3:
    push de
    ld hl,$2000
    add hl,de
    ld e,$F1
    ld bc,$0800
    call FfFillV
    pop de
    push de
    ld hl,32 * 8
    add hl,de
    ex de,hl
    ld hl,FontPat
    ld bc,512
    call FfCopyV
    pop de
    push de
    ld hl,128 * 8
    add hl,de
    ex de,hl
    ld hl,IconPat
    ld bc,IconBytes
    call FfCopyV
    pop de
    ld hl,$2000 + 128 * 8
    add hl,de
    ex de,hl
    ld hl,IconCol
    ld bc,IconBytes
    jp FfCopyV
; the logo (rows 3-5, LogoW cells from column LogoCol)
FfLogo:
    ld hl,$1800 + 3 * 32 + LogoCol
    ld c,LogoT0
    ld d,3
FfLg1:
    call FfWa
    ld b,LogoW
FfLg2:
    ld a,c
    out (VDP_DATA_PORT),a
    inc c
    nop
    nop
    djnz FfLg2
    push de
    ld de,32
    add hl,de
    pop de
    dec d
    jr nz,FfLg1
    ret
; play screen: names (rows 2-21 = one pattern a cell; rows 0-1 and 22-23
; blank HUD tiles), the HUD tiles (third 0 codes 0-63, third 2 codes
; 192-255), patterns/colours of rows 0-1 and 22-23 blank
FfPlayVram:
    ld hl,$1800
    call FfWa
    ld b,64
FfPv1:
    xor a
    out (VDP_DATA_PORT),a
    nop
    djnz FfPv1
    ld c,64
    ld d,192
FfPv2:
    ld b,0
    ld a,c
FfPv3:
    out (VDP_DATA_PORT),a
    inc a
    nop
    dec d
    jr z,FfPv4
    djnz FfPv3
FfPv4:
    ld hl,$1800 + 8 * 32
    call FfWa
    xor a
    ld b,0
FfPv5:
    out (VDP_DATA_PORT),a
    inc a
    nop
    djnz FfPv5
    xor a
    ld b,192
FfPv6:
    out (VDP_DATA_PORT),a
    inc a
    nop
    djnz FfPv6
    ld a,192
    ld b,64
FfPv7:
    ld a,192
    out (VDP_DATA_PORT),a
    nop
    djnz FfPv7
    ; HUD tiles
    ld de,0
    ld hl,HudPat
    ld bc,NHud * 8
    call FfCopyV
    ld de,$2000
    ld hl,HudCol
    ld bc,NHud * 8
    call FfCopyV
    ld de,$1000 + 192 * 8
    ld hl,HudPat
    ld bc,NHud * 8
    call FfCopyV
    ld de,$3000 + 192 * 8
    ld hl,HudCol
    ld bc,NHud * 8
    jp FfCopyV
; the map of night MapI -> FMap (MapData + 640 MapI)
FfSetMap:
    ld a,(MapI)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    add hl,de
    ; hl = 20 MapI; x 32
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,MapData
    add hl,de
    ld (FMap),hl
    ret
; stamp the field: rows 2-21, columns 2-29 from the map (patterns +
; colours), columns 0-1 and 30-31 black (display off)
FfStamp:
    ld hl,(FMap)
    ld (QP),hl
    ld b,20
    ld c,2
FfSt1:
    push bc
    ; columns 0-1 of row c
    ld a,c
    ld h,a
    ld l,0
    push hl
    ld e,0
    push bc
    ld bc,16
    call FfFillV
    pop bc
    pop hl
    push hl
    ld a,h
    add a,$20
    ld h,a
    ld e,$11
    push bc
    ld bc,16
    call FfFillV
    pop bc
    pop hl
    push hl
    ld l,240
    ld e,0
    push bc
    ld bc,16
    call FfFillV
    pop bc
    pop hl
    push hl
    ld l,240
    ld a,h
    add a,$20
    ld h,a
    ld e,$11
    push bc
    ld bc,16
    call FfFillV
    pop bc
    pop hl
    ; columns 2-29: tile patterns, then colours
    ld l,16
    ld b,28
    ld de,(QP)
FfSt2:
    push bc
    push de
    push hl
    ld a,(de)
    call FfTile
    pop hl
    ld de,8
    add hl,de
    pop de
    inc de
    pop bc
    djnz FfSt2
    ld hl,(QP)
    ld de,32
    add hl,de
    ld (QP),hl
    pop bc
    inc c
    djnz FfSt1
    ret
; tile a at the cell whose pattern address is hl (patterns + colours)
FfTile:
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld de,TilePat
    add hl,de
    ex de,hl
    pop hl
    ex (sp),hl
    push hl
    push de
    call FfWa
    pop hl
    ld b,8
FfTl1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    nop
    djnz FfTl1
    pop hl
    ld a,h
    add a,$20
    ld h,a
    call FfWa
    pop hl
    ld de,TileCol
    add hl,de
    ld b,8
FfTl2:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    nop
    djnz FfTl2
    ret
; tile QT at screen cell (QX, QY) (patterns + colours)
FfTileAt:
    ld a,(QY)
    ld h,a
    ld a,(QX)
    add a,a
    add a,a
    add a,a
    ld l,a
    ld a,(QT)
    jp FfTile
; jar fill level QT at screen cell (QX, QY): 16 colour rows on 2 columns
FfJarCol:
    ld a,(QT)
    add a,a
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld hl,JarCol
    add hl,de
    jr FfCol16
; web colours (QP = 0 white, 1 red) at screen cell (QX, QY)
FfWebCol:
    ld hl,WebSafe
    ld a,(QP)
    or a
    jr z,FfCol16
    ld hl,WebDanger
; 16 colour rows from hl into the 2 x 2 cells at (QX, QY)
FfCol16:
    ld a,(QY)
    add a,$20
    ld d,a
    ld a,(QX)
    add a,a
    add a,a
    add a,a
    ld e,a
    ld c,2
FfC161:
    push bc
    push de
    push hl
    ld bc,8
    call FfCopyV
    pop hl
    pop de
    push de
    push hl
    ld a,e
    add a,8
    ld e,a
    ld bc,8
    call FfCopyV
    pop hl
    ld de,8
    add hl,de
    pop de
    inc d
    pop bc
    dec c
    jr nz,FfC161
    ret
; HUD tile PcT at column PcC of row PcR (1: names 0-63, 22: 192-255)
FfPutAt:
    ld a,(PcR)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(PcC)
    or l
    ld l,a
    ld a,h
    add a,$18
    ld h,a
    call FfWa
    ld a,(PcR)
    cp 22
    ld a,(PcT)
    jr nz,FfPa1
    add a,192
FfPa1:
    out (VDP_DATA_PORT),a
    ret
; 2 digits of NumU (< 100) at PcC, PcR (leading blank)
FfNum2:
    ld a,(NumU)
    ld b,0
FfNm1:
    cp 10
    jr c,FfNm2
    sub 10
    inc b
    jr FfNm1
FfNm2:
    add a,HDig0
    ld c,a
    ld a,b
    or a
    ld a,HBlank
    jr z,FfNm3
    ld a,b
    add a,HDig0
FfNm3:
    ld (PcT),a
    push bc
    call FfPutAt
    pop bc
    ld a,c
    ld (PcT),a
    ld hl,PcC
    inc (hl)
    jp FfPutAt
; the score: 5 digits at row 1, columns 14-18
FfScore:
    ld hl,$1800 + 32 + 14
    call FfWa
    ld hl,(Score)
    ld de,Pow10
    ld b,5
FfSc1:
    push bc
    ex de,hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ex de,hl
    ld a,HDig0 - 1
FfSc2:
    inc a
    or a
    sbc hl,bc
    jr nc,FfSc2
    add hl,bc
    out (VDP_DATA_PORT),a
    pop bc
    djnz FfSc1
    ret
; message QT (offset in MsgData) on row 22, columns 9-22
FfMsg:
    ld hl,$1800 + 22 * 32 + 9
    call FfWa
    ld a,(QT)
    ld e,a
    ld d,0
    ld hl,MsgData
    add hl,de
    ld b,14
FfMs1:
    ld a,(hl)
    add a,192
    out (VDP_DATA_PORT),a
    inc hl
    nop
    djnz FfMs1
    ret
; row 22 cleared (columns 2-29) before the HUD redraws it
FfMsgClr:
    ld hl,$1800 + 22 * 32 + 2
    call FfWa
    ld b,28
FfMc1:
    ld a,192
    out (VDP_DATA_PORT),a
    nop
    nop
    djnz FfMc1
    ret
  }
end sub

asm {
FfSnap:
    db $00,$00,$25,$02,$00,$00,$46,$03,$00,$00,$76,$03,$10
FfSpider:
    db $00,$00,$36,$04,$00,$00,$56,$06,$00,$00,$76,$08,$10
FfWarn:
