FfRescue:
    db $80,$55,$30,$02,$80,$40,$30,$02,$80,$35,$30,$02,$80,$2A,$50,$04,$90
FfBat:
    db $80,$2A,$50,$02,$80,$24,$50,$02,$80,$2A,$60,$02,$80,$20,$70,$03,$90
FfShine:
    db $80,$D6,$60,$02,$80,$AA,$60,$02,$80,$8F,$60,$03,$90

FfSoundTable:
    dw FfTuneMel,$702B
    dw FfTuneHarm,$7035
    dw FfTuneBassVol,$703F
    dw FfTuneBassPitch,$7049
    dw FfSnap,$702B
    dw FfSpider,$702B
    dw FfWarn,$702B
    dw FfGust,$702B
    dw FfJar,$7035
    dw FfGulp,$7035
    dw FfCroak,$7035
    dw FfClear,$7035
    dw FfFail,$7035
    dw FfClick,$7035
    dw FfEmpty,$7035
    dw FfStuck,$703F
    dw FfRescue,$703F
    dw FfBat,$703F
    dw FfShine,$703F
; Lantern Lilt (FIREFLIES, original) - Tiny Sound tone 1/2 + OS7 noise bass/drums (kit/music/tinybass.py)
FfTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$1A,$21,$21,$01,$25,$01,$28,$01,$01,$01,$2A,$01,$28,$01
    db $25,$01,$01,$01,$26,$01,$23,$01,$20,$01,$23,$01,$21,$01,$01,$01
    db $01,$01,$01,$01,$1C,$01,$21,$01,$25,$01,$28,$01,$2D,$01,$2C,$01
    db $2A,$01,$28,$01,$26,$01,$25,$01,$23,$01,$20,$01,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
FfTuneHarm:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$1A,$21,$19,$01,$01,$01,$15,$01,$01,$01,$1A,$01,$01,$01
    db $15,$01,$01,$01,$12,$01,$01,$01,$10,$01,$01,$01,$19,$01,$01,$01
    db $10,$01,$01,$01,$15,$01,$01,$01,$19,$01,$01,$01,$1A,$01,$01,$01
    db $17,$01,$01,$01,$12,$01,$01,$01,$10,$01,$01,$01,$19,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
FfTuneBassVol:
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$3E
    db $10
FfTuneBassPitch:
    db $C0,$66,$F0,$3C,$C0,$98,$F0,$1D,$C0,$66,$F0,$1B,$C0,$B5,$F0,$1D,$C0,$88,$F0,$1B,$C0,$66,$F0,$1D
    db $C0,$88,$F0,$1B,$C0,$66,$F0,$1D,$C0,$A1,$F0,$1B,$C0,$98,$F0,$1D,$C0,$B5,$F0,$1B,$C0,$98,$F0,$1D
    db $C0,$88,$F0,$1B,$C0,$66,$F0,$16,$FE
    db $D0
}
data Pow10 words
  10000,1000,100,10,1
end data
data JitTab bytes
  $FD,$00,$00,$03
end data
' firefly glyphs (FfGlyph): 4 rows each; glow, core, stray, dim x 3 offsets
data GlyTab bytes
  $60,$F0,$F0,$60
  $18,$3C,$3C,$18
  $06,$0F,$0F,$06
  $00,$60,$60,$00
  $00,$18,$18,$00
  $00,$06,$06,$00
  $00,$60,$00,$00
  $00,$18,$00,$00
  $00,$06,$00,$00
  $00,$20,$00,$00
  $00,$08,$00,$00
  $00,$02,$00,$00
end data
' (H, V) = (0..2, 0..2) -> tongue direction 0 east .. 7 (counter-clockwise
' in screen terms: 1 = south-east, 2 = south, ...); centre -> south
data DirOf bytes
  5,6,7,4,2,0,3,2,1
end data
data GlowX bytes
  4,27,8,24,3,28,13,19
end data
data GlowY bytes
  2,3,10,10,6,7,11,2
end data
