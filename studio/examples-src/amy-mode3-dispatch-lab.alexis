cartridge "MODE3 DISPATCH LAB/AMY/2026"

' pset/pget mode-dispatch self-check.
' Draw pixels using plain pset (no qualifier), read back with plain pget,
' then switch to text and display PASS/FAIL for each case.

u8 C0 = 0, C1 = 0, C2 = 0, C3 = 0
u8 OffShape = 0

  multicolor screen
  cls
  ' on-shape: four test pixels via mode-dispatch pset
  pset 10,5 color $A
  pset 32,24 color $7
  pset 63,47 color $F
  pset 0,0 color $3
  ' boundary corners
  pset 0,47 color $2
  pset 63,0 color $1
  ' clipped-edge: out-of-bounds psets must be silent no-ops.
  ' pset 64,0 aliases (0,0) if AMY_MODE3_PSET lacks a bounds check,
  ' so C3 = pget 0,0 returning $3 (not $E) proves the check works.
  pset 64,0 color $E
  pset 0,48 color $E
  pset 255,255 color $E
  ' read back via plain pget (mode-dispatch)
  C0 = pget 10,5
  C1 = pget 32,24
  C2 = pget 63,47
  C3 = pget 0,0
  ' off-shape: (11,5) shares the same VRAM byte as (10,5) — different nibble
  ' after cls both should be 0; only (10,5) was pset
  OffShape = pget 11,5
  text screen
  print at 1,0, "M3 DISPATCH LAB"
  if C0 = $A then
    print at 1,2, "(10,5)=$A PASS"
  else
    print at 1,2, "(10,5)=$A FAIL"
  end if
  if C1 = $7 then
    print at 1,3, "(32,24)=$7 PASS"
  else
    print at 1,3, "(32,24)=$7 FAIL"
  end if
  if C2 = $F then
    print at 1,4, "(63,47)=$F PASS"
  else
    print at 1,4, "(63,47)=$F FAIL"
  end if
  if C3 = $3 then
    print at 1,5, "(0,0)=$3 PASS"
  else
    print at 1,5, "(0,0)=$3 FAIL"
  end if
  if OffShape = 0 then
    print at 1,6, "OFF-SHAPE PASS"
  else
    print at 1,6, "OFF-SHAPE FAIL"
  end if
  screen on
main:
  goto main