const NSpr = 4
const StepF = 8
const SeasonDays = 250
const StartCash = 500
const DebtMax = 5000

' kingdoms (20 wide), rulers (15 wide), goods (13 wide)
data TownN chars "CLERIC'S TEMPLE     MONK'S STOREHOUSE   CASTLE GOHOLLA      MERLIN'S KEEP       WARLORD'S HOLD      ZOMBIE TOWER        MOUNTAINS OF FIRE   KINGDOM OF THE ORCS "
data RepN chars "CLERIC         MONK           EMPEROR GOHOLLA MERLIN         WARLORD AKUZA  ZOMBIE MASTER  DWARVE RULER   ORC KING       "
data ItemN chars "ARTIFACTS    WEAPONS      ARMOR        RARE METALS  HORSES       SPICES       FOOD PRODUCTS FABRICS      LAND SHARES  "
' the trading remarks A$(9..17) (24 wide)
data RemN chars "GET THEE HENCE,FOOL!    SO BE IT.               WELL IT IS.             WELL AND GOOD.          FINE,THO...             THOU ART A SHREWD ROGUE.YEA GODS!               A POX ON THEE!          CURSE THOU!             "
' demand A$(35..43) (10 wide)
data DemN chars "NO        NEGLIGIBLESLIGHT    LOW       MEDIOCRE  HIGH      VERY HIGH EXTREME   INCREDIBLE"
' bargaining openers A$(50..53) (25 wide)
data PhrN chars "I LET THEM GO AT         I GIVE THEM AWAY AT      I TAKE OFF YOUR HANDS AT I CONSENT TO GRANT YOU   "
data SeaN chars "SPRINGSUMMERFALL  WINTER"
' prices: average + the season's change (DATA 2110-2190), season x 9 goods
