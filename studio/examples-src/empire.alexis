  tile screen
  set sound table EmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame
  for Ss = 0 to 3
    PlaySeason
  next
  YearEnd
  Over = 1
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift; Rnd(N) is 0..N-1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function Rnd(u8 N) as u8
  u8 Q = 0
  Rand
  Q = lowbyte Rs
  return Q % N

' ---------------------------------------------------------------------------
' a new year: cash, stocks and demands (lines 190, 260-270)

sub NewGame:
  u8 Tt = 0
  u8 Ii = 0
  u8 Sp = 0
  u8 Base = 0
  Cash = StartCash
  Over = 0
  Land = 0
  for Ii = 0 to 8
    Have[Ii] = 0
  next
  for Tt = 0 to 7
    Sp = SpecT[Tt]
    Base = Tt * 9
    for Ii = 0 to 8
      Stock[Base + Ii] = 0
      Dem[Base + Ii] = Rnd(8) + 1
    next
    Dem[Base + Sp] = 0
    Dem[Base + 8] = 0
    Stock[Base + Sp] = SpecQ[Tt]
    Stock[Base + 8] = LandT[Tt]
  next
  Px = 2
  Py = 3
  return
end sub

' ---------------------------------------------------------------------------
' one season on the map: 251 steps (FOR SC = 0 TO 250)

sub PlaySeason:
  Phase = 1
  DrawMap
  play sound SndBell
  Days = SeasonDays
  Sf = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  while Phase = 1
    Frame1
    ReadPad
    MapStep
    inc Sf
    if Sf = StepF then
      Sf = 0
      if Days = 0 then
        Phase = 2
      else
        dec Days
        ShowDays
      end if
    end if
    if Phase = 1 then
      if InTown = 1 then
        InTown = 0
        VisitTown
        DrawMap
        Rearm
        wait no fire
        nmi off
        WasBtn = 16
      end if
    end if
  end while
  ' let a move in progress finish
  Phase = 2
  return
end sub

' a frame on the map: glide, start a step, the gate, the water
sub MapStep:
  u8 Nx = 0
  u8 Ny = 0
  u8 Tc = 0
  if Mv > 0 then
    Sx = Sx + Mdx
    Sy = Sy + Mdy
    dec Mv
    if Mv = 0 then
      Px = Px + Mdx
      Py = Py + Mdy
      ShowHere
    end if
  end if
  if Mv = 0 then
    if Press = 1 then
      if Here > 0 then InTown = 1
    end if
    if InTown = 0 then
      if Stick > 0 then
        Mdx = 0
        Mdy = 0
        if Stick & 1 then Mdy = -1
        if Stick & 4 then Mdy = 1
        if Stick & 8 then Mdx = -1
        if Stick & 2 then Mdx = 1
        Nx = Px + Mdx
        Ny = Py + Mdy
        Tc = 0
        if Nx < 28 then
          if Ny < 20 then
            Tc = get char at Nx + 2,Ny + 2
          end if
        end if
        if Tc >= TGrass then
          if Tc <= TGate8 then
            Mv = 8
            Boat = 0
            if Tc = TWater then Boat = 1
            play sound SndStep
          end if
        end if
      end if
    end if
  end if
  inc Wv
  if Wv = 24 then
    Wv = 0
    WaterLook(1)
  end if
  if Wv = 12 then WaterLook(0)
  ShowTraveller
  return
end sub

' the gate under the traveller (the hint on row 22)
sub ShowHere:
  u8 Tc = 0
  Tc = get char at Px + 2,Py + 2
  fill 32 count 28 at 2,22
  Here = 0
  if Tc >= TGate1 then
    if Tc <= TGate8 then
      Here = Tc - TGate1 + 1
      W16 = Here - 1
      W16 = W16 * 20
      put TownN + W16 count 20 at 2,22
      print at 23,22, "ENTER!"
    end if
  end if
  return
end sub

sub ShowTraveller:
  X = Sx + 16
  Y = Sy + 15
  if Boat = 1 then
    set sprite 0 to Y,X,SFace,9
    set sprite 1 to Y,X,SBoatman,4
    set sprite 2 to Y,X,SBoat,6
  else
    set sprite 0 to Y,X,SFace,9
    set sprite 1 to Y,X,SBody,4
    set sprite 2 to 192,0,0,0
  end if
  set sprite 3 to 192,0,0,0
  update sprites
  return
end sub

sub WaterLook(u8 Wk):
  if Wk = 1 then
    copy WaterB count 8 to vram.pattern + 1048
    copy WaterB count 8 to vram.pattern + 3096
    copy WaterB count 8 to vram.pattern + 5144
  else
    copy TilePat + 24 count 8 to vram.pattern + 1048
    copy TilePat + 24 count 8 to vram.pattern + 3096
    copy TilePat + 24 count 8 to vram.pattern + 5144
  end if
  return
end sub

sub DrawMap:
  u8 Ry = 0
  NewScreen
  W16 = Ss
  W16 = W16 << 3
  copy GrassCol + W16 count 8 to vram.color + 1024
  select case Ss
  case 0
    backdrop dark green
  case 1
    backdrop dark yellow
  case 2
    backdrop dark red
  case else
    backdrop gray
  end select
  W16 = 0
  for Ry = 0 to 19
    put MapT + W16 count 28 at 2,Ry + 2
    W16 = W16 + 28
  next
  W16 = Ss
  W16 = W16 * 6
  put SeaN + W16 count 6 at 2,1
  print at 10,1, "DAYS"
  ShowDays
  ShowCash(19, 1)
  Mv = 0
  Mdx = 0
  Mdy = 0
  Sx = Px << 3
  Sy = Py << 3
  Wv = 0
  V = get char at Px + 2,Py + 2
  Boat = 0
  if V = TWater then Boat = 1
  ShowHere
  ShowTraveller
  ShowScreen
  return
end sub

sub ShowDays:
  print Days at 15,1 width 3
  return
end sub

' cash as up to seven digits and a sign, right-aligned in 9 cells after
' a "$" at Cx
sub ShowCash(u8 Cx, u8 Cy):
  u8 Ci = 8
  u8 Dg = 0
  u8 Neg = 0
  T32 = Cash
  if T32 < 0 then
    Neg = 1
    T32 = 0 - T32
  end if
  for Dg = 0 to 8
    Buf[Dg] = 32
  next
  do
    P32 = T32 % 10
    W16 = lowword P32
    Dg = W16
    Buf[Ci] = 48 + Dg
    T32 = T32 / 10
    dec Ci
  loop until T32 = 0
  if Neg = 1 then Buf[Ci] = 45
  put char 36 at Cx,Cy
  put Buf count 9 at Cx + 1,Cy
  return
end sub

' ---------------------------------------------------------------------------
' a kingdom (lines 490-530)

sub VisitTown:
  Tw = Here - 1
  Phase = 3
  DrawTown
  Deal = 0
  while Deal = 0
    MainMenu
    ClearConv
    select case Ch
    case 0
      if PickItem = 1 then DoBuy
    case 1
      if PickItem = 1 then DoSell
    case 2
      if PickItem = 1 then DoSeasons
    case 3
      if PickItem = 1 then DoInquire
    case 4
      DoInventory
    case else
      Deal = 1
    end select
  end while
  HideSprites
  Phase = 1
  return
end sub

sub DrawTown:
  u8 Ln = 0
  NewScreen
  backdrop black
  W16 = Tw
  W16 = W16 * 20
  copy TownN + W16 count 20 to Buf
  Ln = TrimLen(20)
  X = (28 - Ln) >> 1
  put char TCrown at X,1
  put char TCrown at X + Ln + 3,1
  put TownN + W16 count Ln at X + 2,1
  print at 2,2, "REPRESENTATIVE"
  W16 = Tw
  W16 = W16 * 15
  put RepN + W16 count 15 at 17,2
  fill TRule count 28 at 2,3
  fill TRule count 28 at 2,14
  ShowScreen
  return
end sub

' the length of Buf[0..N-1] without trailing spaces
function TrimLen(u8 N) as u8
  u8 Tl = 0
  Tl = N
  while Tl > 1
    if Buf[Tl - 1] <> 32 then exit while
    dec Tl
  end while
  return Tl

sub ClearArea:
  for Ri = 4 to 13
    fill 32 count 28 at 2,Ri
  next
  return
end sub

sub ClearConv:
  for Ri = 15 to 22
    fill 32 count 28 at 2,Ri
  next
  return
end sub

sub MainMenu:
  ClearArea
  print at 10,4, "MERCHANTRY"
  print at 10,6, "BUY"
  print at 10,7, "SELL"
  print at 10,8, "SEASONAL CHANGES"
  print at 10,9, "INQUIRE"
  print at 10,10, "INVENTORY"
  print at 10,11, "BID FAREWELL"
  DoMenu(6, 6)
  return
end sub

' the goods menu; 1 if one was chosen
function PickItem as u8
  ClearArea
  print at 10,4, "COMMERCE"
  W16 = 0
  for Ri = 0 to 8
    put ItemN + W16 count 13 at 10,Ri + 5
    W16 = W16 + 13
  next
  DoMenu(9, 5)
  It = Ch
  ClearArea
  return 1

' the gliding hand: Ch from 0 to N-1, rows from R0
sub DoMenu(u8 N, u8 R0):
  u8 Want = 0
  Ch = 0
  HandY = R0 << 3
  HandY = HandY - 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  Ui = 1
  while Asking = 1
    Frame1
    ReadPad
    if Rep = 1 then
      if Stick & 1 then
        if Ch = 0 then
          Ch = N - 1
        else
          dec Ch
        end if
        play sound SndTick
      end if
      if Stick & 4 then
        inc Ch
        if Ch = N then Ch = 0
        play sound SndTick
      end if
    end if
    Want = Ch + R0
    Want = Want << 3
    Want = Want - 1
    if HandY < Want then
      HandY = HandY + 2
      if HandY > Want then HandY = Want
    end if
    if HandY > Want then
      HandY = HandY - 2
      if HandY < Want then HandY = Want
    end if
    set sprite 0 to HandY,56,SHand,11
    update sprites
    if Press = 1 then Asking = 0
  end while
  Ui = 0
  play sound SndPick
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

' a number from 0 to Ul into Bg, shown at Nx,22
sub GetNum(u8 Nx):
  u16 Stp = 0
  Bg = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  Ui = 2
  while Asking = 1
    print Bg at Nx,22 width 5
    Frame1
    ReadPad
    if Rep = 1 then
      Stp = 10
      if HandT > 60 then Stp = 100
      if Stick & 1 then
        Bg = Bg + Stp
        if Bg > Ul then Bg = Ul
      end if
      if Stick & 4 then
        if Bg < Stp then
          Bg = 0
        else
          Bg = Bg - Stp
        end if
      end if
      Stp = 1
      if HandT > 60 then Stp = 10
      if Stick & 2 then
        Bg = Bg + Stp
        if Bg > Ul then Bg = Ul
      end if
      if Stick & 8 then
        if Bg < Stp then
          Bg = 0
        else
          Bg = Bg - Stp
        end if
      end if
      play sound SndTick
    end if
    if Press = 1 then Asking = 0
  end while
  Ui = 0
  print Bg at Nx,22 width 5
  play sound SndPick
  return
end sub

' "<RULER> SAYS..." on the first line of the talk
sub Says:
  u8 Ln = 0
  ClearConv
  W16 = Tw
  W16 = W16 * 15
  copy RepN + W16 count 15 to Buf
  Ln = TrimLen(15)
  put RepN + W16 count Ln at 2,15
  print at Ln + 2,15, " SAYS..."
  return
end sub

sub PutItem(u8 Ix, u8 Iy):
  W16 = It
  W16 = W16 * 13
  put ItemN + W16 count 13 at Ix,Iy
  return
end sub

sub PutRemark(u8 Rk, u8 Ry):
  W16 = Rk
  W16 = W16 * 24
  put RemN + W16 count 24 at 4,Ry
  return
end sub

' the price of good It this season, its step
sub SetPrice:
  V = Ss * 9 + It
  Bp = PriceT[V]
  Ic = Bp >> 3
  return
end sub

' ---------------------------------------------------------------------------
' BUY (lines 550-680)

sub DoBuy:
  u8 Ix = 0
  u8 Accepted = 0
  Ix = Tw * 9 + It
  Says
  if It = 8 then
    if Cash < 0 then
      print at 2,16, "YOU CANNOT BUY LAND ON"
      print at 2,17, "DEBT NOTES."
      Wait2
      return
    end if
  end if
  if Dem[Ix] <> 0 then
    print at 2,16, "WE DO NOT DEAL IN"
    PutItem(2, 17)
    Wait2
    return
  end if
  if Stock[Ix] = 0 then
    print at 2,16, "WE HAVE NONE LEFT."
    Wait2
    return
  end if
  print at 2,16, "WE HAVE"
  print Stock[Ix] at 10,16 width 4
  PutItem(15, 16)
  print at 2,17, "TO SELL. HOW MANY?"
  print at 2,22, "SELECT # ITEMS"
  Ul = Stock[Ix]
  GetNum(17)
  if Bg = 0 then
    print at 2,19, "AH, WELL..."
    Wait2
    return
  end if
  Ni = Bg
  SetPrice
  Ask = Bp + Ic * 8
  Floor0 = Bp - Ic * 2
  Accepted = 0
  Wr = 0
  while Wr < 10
    Haggle(0)
    Ul = Bp + Ic * 8
    GetNum(17)
    ' an offer within half a step is taken
    W16 = Bg << 1
    V16 = Ask << 1
    V16 = V16 - Ic
    if W16 >= V16 then
      Accepted = 1
      exit while
    end if
    if Bg + Ic * 4 > Ask then
      Ask = Bg + Ic
      if Ask < Floor0 then Ask = Floor0
    end if
    play sound SndNay
    Sr = BuyGrade
    print at 2,19, "NAY,"
    PutRemark(8 - Sr, 20)
    inc Wr
    Hold(50)
  end while
  if Accepted = 0 then
    Says
    print at 2,16, "NAY! ENOUGH OF THIS"
    print at 2,17, "BARGAINING!"
    play sound SndNay
    Wait2
    return
  end if
  ' the cost
  P32 = Ni
  T32 = Bg
  P32 = P32 * T32
  T32 = Cash - P32
  Says
  if It = 8 then
    if T32 < 0 then
      print at 2,16, "I DO NOT ACCEPT DEBT"
      print at 2,17, "NOTES ON LAND, MY FRIEND."
      play sound SndNay
      Wait2
      return
    end if
  end if
  if T32 < -5000 then
    print at 2,16, "THE MERCHANT GUILD CAN"
    print at 2,17, "ISSUE YOU NO MORE THAN"
    print at 2,18, "5000 DOLLARS WORTH OF"
    print at 2,19, "DEBT NOTES."
    play sound SndNay
    Wait2
    return
  end if
  Sr = BuyGrade
  print at 2,16, "AYE,"
  PutRemark(8 - Sr, 17)
  print at 2,19, "SOLD."
  Stock[Ix] = Stock[Ix] - Ni
  Cash = T32
  Have[It] = Have[It] + Ni
  if It = 8 then Land = Have[8]
  play sound SndAye
  Hold(90)
  DoInventory
  return
end sub

' the remark grade of a buying offer: offer / step, at most 8
function BuyGrade as u8
  u8 G = 8
  W16 = Ic * 8
  if Bg <= W16 then
    W16 = Bg / Ic
    G = W16
  end if
  return G

' the remark grade of a selling offer: (offer - P) / step, 0..8
function SellGrade as u8
  u8 G = 0
  W16 = Bp + Ic * 8
  if Bg > W16 then
    G = 8
  else
    if Bg > Bp then
      W16 = Bg - Bp
      W16 = W16 / Ic
      G = W16
    end if
  end if
  return G

' the ruler's ask: opener, price, round
sub Haggle(u8 Sell):
  Says
  V = Rnd(2) + Sell
  W16 = V
  W16 = W16 * 25
  put PhrN + W16 count 25 at 2,16
  print Ask at 2,17 width 5
  print at 8,17, "EACH."
  print at 16,15, "ROUND"
  V = Wr + 1
  print V at 22,15 width 2
  print at 25,15, "/10"
  print at 2,22, "YOUR OFFER? $"
  return
end sub

' ---------------------------------------------------------------------------
' SELL (lines 710-820)

sub DoSell:
  u8 Ix = 0
  u8 Accepted = 0
  Ix = Tw * 9 + It
  Says
  if Have[It] = 0 then
    print at 2,16, "YOU DO NOT HAVE ANY"
    PutItem(2, 17)
    Wait2
    return
  end if
  ' NI = INT(N * (T * .124))
  Ni = SellQty(Have[It], Dem[Ix])
  if Ni = 0 then
    print at 2,16, "NO THANKS."
    Wait2
    return
  end if
  print at 2,16, "WE WILL BUY"
  print Ni at 14,16 width 4
  PutItem(2, 17)
  print at 16,17, "FROM YOU."
  Hold(90)
  SetPrice
  Ask = Bp - Ic
  Accepted = 0
  Wr = 0
  while Wr < 10
    Haggle(2)
    Ul = Bp + Ic * 8
    Bg = 0
    while Bg = 0
      GetNum(17)
    end while
    W16 = Bg << 1
    V16 = Ask << 1
    V16 = V16 + Ic
    if W16 <= V16 then
      Accepted = 1
      exit while
    end if
    if Bg <= Ask + Ic * 3 then Ask = Ask + Ic
    play sound SndNay
    Sr = SellGrade
    print at 2,19, "NAY,"
    PutRemark(Sr, 20)
    inc Wr
    Hold(50)
  end while
  Says
  if Accepted = 0 then
    print at 2,16, "NAY! ENOUGH OF THIS"
    print at 2,17, "BARGAINING!"
    play sound SndNay
    Wait2
    return
  end if
  Sr = SellGrade
  print at 2,16, "AYE,"
  PutRemark(Sr, 17)
  print at 2,19, "SOLD."
  Stock[Ix] = Stock[Ix] + Ni
  Dem[Ix] = 1
  P32 = Ni
  T32 = Bg
  P32 = P32 * T32
  Cash = Cash + P32
  Have[It] = Have[It] - Ni
  play sound SndCoin
  Hold(90)
  DoInventory
  return
end sub

' how many a ruler with demand Dm takes of Hn goods: INT(Hn * Dm * .124)
function SellQty(u16 Hn, u8 Dm) as u16
  u32 Q32 = 0
  u32 D32 = 0
  Q32 = Hn
  D32 = Dm
  Q32 = Q32 * D32
  Q32 = Q32 * 124
  Q32 = Q32 / 1000
  return lowword Q32

' ---------------------------------------------------------------------------
' SEASONAL CHANGES, INQUIRE, INVENTORY (lines 840-980)

sub DoSeasons:
  u8 Sn = 0
  i16 Chg = 0
  i16 Avg = 0
  ClearArea
  PutItem(10, 4)
  for Sn = 0 to 3
    W16 = Sn
    W16 = W16 * 6
    put SeaN + W16 count 6 at 4,Sn + 6
    V = Sn * 9 + It
    Chg = PriceT[V]
    Avg = AvgT[It]
    Chg = Chg - Avg
    if Chg < 0 then
      W16 = 0 - Chg
      print at 21,Sn + 6, "LOSS!"
    else
      W16 = Chg
      if Chg = 0 then
        print at 21,Sn + 6, "NO CHANGE."
      else
        print at 21,Sn + 6, "GAIN!"
      end if
    end if
    print W16 at 14,Sn + 6 width 4
    if Sn = Ss then put char 62 at 2,Sn + 6
  next
  WaitPress
  return
end sub

sub DoInquire:
  u8 Ix = 0
  Ix = Tw * 9 + It
  Says
  if It < 8 then
    V = Dem[Ix]
    W16 = V
    W16 = W16 * 10
    put DemN + W16 count 10 at 2,16
    print at 13,16, "DEMAND."
  else
    print Stock[Ix] at 2,16 width 3
    print at 6,16, "FURLONGS AT $"
    SetPrice
    print Bp at 19,16 width 3
    print at 2,17, "APIECE."
  end if
  ClearArea
  print at 2,4, "PER ITEM"
  print at 16,4, "REALM VALUE"
  W16 = 0
  for Li = 0 to 8
    put ItemN + W16 count 13 at 3,Li + 5
    W16 = W16 + 13
    V = Ss * 9 + Li
    put char 36 at 19,Li + 5
    print PriceT[V] at 20,Li + 5 width 4
    if Li = It then put char 60 at 25,Li + 5
  next
  WaitPress
  return
end sub

sub DoInventory:
  ClearArea
  print at 2,4, "COMMERCE"
  print at 18,4, "IN STOCK"
  ShowGoods
  ClearConv
  print at 8,16, "CASH ON HAND"
  ShowCash(9, 17)
  if Cash < 0 then
    print at 11,18, "!DEBT!"
  else
    print at 11,18, "CREDIT"
  end if
  WaitPress
  return
end sub

sub ShowGoods:
  W16 = 0
  for Li = 0 to 8
    put ItemN + W16 count 13 at 3,Li + 5
    W16 = W16 + 13
    print Have[Li] at 20,Li + 5 width 5
  next
  return
end sub

' ---------------------------------------------------------------------------
' year's end (lines 370-380)

sub YearEnd:
  u16 Pct = 0
  Phase = 4
  NewScreen
  backdrop dark blue
  fill TRule count 28 at 2,1
  print at 6,2, "YEAR'S END RESULTS"
  fill TRule count 28 at 2,3
  print at 2,4, "COMMERCE"
  print at 18,4, "IN STOCK"
  ShowGoods
  print at 4,15, "CASH"
  ShowCash(9, 15)
  ' tenths of a percent: land x 1000 / 2700
  Pct = Land * 10
  Pct = Pct / 27
  V16 = Pct / 10
  print at 2,17, "YOU HAVE ACQUIRED"
  print V16 at 20,17 width 3
  put char 46 at 23,17
  V16 = Pct % 10
  print V16 at 24,17 digits 1
  put char 37 at 25,17
  print at 2,18, "OF THE EMPIRE!"
  print at 2,20, "THE REALM NAMES YOU"
  if Pct < 50 then
    print at 2,21, "A HUMBLE PEDDLER."
  elseif Pct < 150 then
    print at 2,21, "A TRAVELLING MERCHANT."
  elseif Pct < 300 then
    print at 2,21, "A LANDHOLDER."
  elseif Pct < 500 then
    print at 2,21, "BARON OF THE REALM."
  elseif Pct < 750 then
    print at 2,21, "DUKE OF THE REALM."
  else
    print at 2,21, "EMPEROR!"
  end if
  ShowScreen
  play sound SndFanfare
  return
end sub

' ---------------------------------------------------------------------------

sub Wait2:
  Hold(30)
  WaitPress
  return
end sub

sub WaitPress:
  print at 7,22, "PRESS THE BUTTON"
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Asking = 1
  Ui = 3
  while Asking = 1
    Frame1
    ReadPad
    if Press = 1 then Asking = 0
  end while
  Ui = 0
  fill 32 count 28 at 2,22
  return
end sub

sub Hold(u8 N):
  for Hc = 1 to N
    Frame1
    ReadPad
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' buttons (Press on a new press) and the stick (Rep on a new push, then
' every 4 frames after 16; HandT counts the frames held)
sub ReadPad:
  Btn = 0
  if joypad(1).fire then Btn = 16
  if joypad(2).fire then Btn = 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  if joypad(1).up then Stick = Stick | 1
  if joypad(1).right then Stick = Stick | 2
  if joypad(1).down then Stick = Stick | 4
  if joypad(1).left then Stick = Stick | 8
  if joypad(2).up then Stick = Stick | 1
  if joypad(2).right then Stick = Stick | 2
  if joypad(2).down then Stick = Stick | 4
  if joypad(2).left then Stick = Stick | 8
  Rep = 0
  if Stick = 0 then
    HandT = 0
  else
    if WasStick = 0 then
      Rep = 1
      HandT = 0
    else
      if HandT < 250 then inc HandT
      if HandT >= 16 then
        V = HandT & 3
        if V = 0 then Rep = 1
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: EMPIRE in bricks, the tune once, START GAME / CREDITS
sub TitlePage:
  u8 Ty = 0
  TitleOn = 1
  NewScreen
  backdrop black
  fill TBricks count 28 at 2,2
  fill TBricks count 28 at 2,10
  W16 = 0
  for Ty = 0 to 4
    put TitleBig + W16 count TitleW at 4,Ty + 4
    W16 = W16 + TitleW
  next
  print at 9,12, "A TRADING ADVENTURE"
  print at 3,14, "BY CLEVELAND M. BLAKEMORE"
  print at 6,15, "AHOY! OCTOBER 1987"
  print at 11,18, "START GAME"
  print at 11,19, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 1
  Asking = 1
  while Asking = 1
    Frame1
    Rand
    ReadPad
    if Rep = 1 then
      if Stick & 1 then Menu = 0
      if Stick & 4 then Menu = 1
      ShowMenu
    end if
    if Press = 1 then Asking = 0
  end while
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,18
  put char 32 at 9,19
  J = Menu + 18
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "EMPIRE"
  print at 2,5, "BASED ON EMPIRE BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! OCTOBER 1987"
  print at 2,8, "(COMMODORE 128)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: CARAVAN ROAD"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
