cartridge "REBOUND/AMY STUDIO/2026"

const EmptyTile = $20
const BallTile = $4F
const MaxX = 31
const MaxY = 23

' Ball state
u8 BallX = 10
u8 BallY = 8
u8 BallDX = 1
u8 BallDY = 1

' Tile under the ball
u8 UnderBallTile = $20

' A simple moving tile that bounces inside the text screen.
  screen off
  setup_screen
  screen on
  goto main_loop

sub setup_screen:
  text screen
  print centered at 4, "REBOUND"
  print centered at 7, "BOUNCE KEEPS A TILE"
  print centered at 8, "INSIDE THE SCREEN"
  print centered at 14, "PRESS FIRE TO START"
  screen on
  pause until press
  wait no fire
  cls
  print centered at 2, "REBOUND DEMO"
  print centered at 4, "LETTER O BOUNCES"
  print centered at 6, "5 VBLANKS PER STEP"
  put char BallTile at BallX,BallY
  return

sub main_loop:
  put char UnderBallTile at BallX,BallY
  bounce BallX by BallDX between 0 and MaxX
  bounce BallY by BallDY between 0 and MaxY
  UnderBallTile = get char at BallX,BallY
  put char BallTile at BallX,BallY
  wait 5 frames
  goto main_loop