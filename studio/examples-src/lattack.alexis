cartridge "LETTER ATTACK!/COMPUTE!'S GAZETTE/1984"

' LETTER ATTACK!
' A ColecoVision game based on "Letter Attack", COMPUTE!'s Gazette,
' December 1984 (Commodore 64 and VIC-20, BASIC; disk 1984-12). No author
' is named in the listings or on the disk.
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: one letter at a time drops down a brick chute. Before it falls,
' a counter runs through the alphabet and stops on it. Shoot it before it
' reaches the floor by aiming the dial at the same letter and pressing the
' button. The higher you catch it, the better your time. After the chosen
' number of letters: score, high score, highest possible score, efficiency
' rating and average time (1 good, 22 bad).
'
' From the original (orig/lattack-vic20.bas, orig/lattack-c64.bas): choose
' a difficulty level 1-9 (the fall delay) and how many letters, 10-90; a
' random letter A-Z, shown first by a counter that runs A..Z and then
' A..the letter in the top corner of the chute; it falls 22 rows down a
' walled chute with a falling pitch; the right key explodes it (score + 1,
' time + the rows it fell); a wrong key is ignored and the letter keeps
' falling; a letter that reaches the floor is simply lost; an arrow marks
' the highest catch so far; LETTERS REMAINING, SCORE, HIGH SCORE on the
' side; at the end SCORE, HIGH SCORE, HIGHEST POSSIBLE SCORE (the number of
' letters), EFFICIENCY RATING (score / letters x 100 %) and AVERAGE TIME
' (time / score, 1 = good, 22 = bad).
'
' Liberties: the original is typed on the keyboard; here a dial of the 26
' letters is turned with the stick (left/right one letter, up/down five,
' held repeats) and the button shoots. Because sweeping a dial while
' pressing would catch everything, a wrong shot freezes the dial for half a
' second and the third wrong shot loses the letter (the original ignored
' wrong keys; three tries are shown as TRIES). The fall is smooth: 22 rows
' timed as the original, at 3 + 2 x level sixteenths of a pixel a frame
' (7.3 s at level 1, 1.7 s at level 9; the BASIC took roughly 1 to
' 3 s, the dial needs the extra time). The counter runs once A..the letter
' (two frames a letter) instead of A..Z then A..the letter. Choices on a
' title menu instead of keys 1-9; no "play again" question (the house rule:
' back to the title). Efficiency is a whole percentage. A burst and a splat,
' a title tune, a credits page.
'
' Controls: either controller. Stick turns the dial, either button shoots.
' On the title: up/down chooses, left/right sets the level or the letters,
' a button starts (HOW TO PLAY and CREDITS show their pages; the cursor
' is back on START GAME each time).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table; the title tune
' plays once. `set sprite count` always given. Nothing flashes.

const TSky = 128
const TStar = 129
const TWall = 130
const TShaft = 131
const TFloor = 132
const TMark = 133
const TRule = 134
const TDl = 135
const TDr = 136
const SGa = 0
const SGb = 4
const SGc = 8
const SGd = 12
const SGe = 16
const SGf = 20
const SGg = 24
const SGh = 28
const SGi = 32
const SGj = 36
const SGk = 40
const SGl = 44
const SGm = 48
const SGn = 52
const SGo = 56
const SGp = 60
const SGq = 64
const SGr = 68
const SGs = 72
const SGt = 76
const SGu = 80
const SGv = 84
const SGw = 88
const SGx = 92
const SGy = 96
const SGz = 100
const SCursor = 104
const SBurst1 = 108
const SBurst2 = 112
const SSplat1 = 116
const SSplat2 = 120
const NTiles8 = 72
const SprBytes = 992
const SndTuneA = 1
const SndTuneB = 2
const SndShuf = 3
const SndFall = 4
const SndDial = 5
const SndHit = 6
const SndZap = 7
const SndWrong = 8
const SndThud = 9
const SndStart = 10
const SndOver = 11
const FallMax = 2178
const RowLen = 99
const FallY0 = 16
const ChuteX = 64
const GapN = 30
const BurstN = 40
const SplatN = 36
const LockN = 30
const MaxTries = 3
const DialC = 20
const DialR = 19
const NSpr = 3

record Stats:
  u8 Sc
  u16 Tm
  u8 Best
  u8 MarkR
end record

Stats St
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u8 Lv = 5
u8 Nlt = 2
u8 Nl = 0
u8 Lr = 0
u8 Hs = 0
u8 Le = 0
u16 Fy = 0
u8 Dial = 0
u8 Rep = 0
u8 Held = 0
u8 Lock = 0
u8 Tries = 0
u8 Shuf = 0
u8 Ph = 0
u8 T = 0
u8 Over = 0
u8 TitleOn = 0
u8 LastTr = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table LaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the original's report, then back to the title on a press
  mute all
  Rearm
  wait 45 frames
  nmi off
  Report
  play sound SndOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveDial
  select case Ph
  case 0
    dec T
    if T = 0 then NextLetter
  case 4
    dec T
    if T = 0 then
      if Shuf = Le then
        Ph = 1
        play sound SndFall
      else
        inc Shuf
        T = 2
        V = Shuf & 3
        if V = 0 then play sound SndShuf
      end if
    end if
  case 1
    if Lock > 0 then
      if Lock < 255 then dec Lock
    end if
    if Press = 1 then
      if Lock = 0 then Shoot
    end if
    if Ph = 1 then Fall
  case 2 to 3
    dec T
    if T = 0 then
      Ph = 0
      T = GapN
      dec Lr
      ShowLeft
      if Lr = 0 then Over = 1
    end if
  end select
  return
end sub

' the dial: left/right one letter, up/down five; frozen after a wrong shot
sub MoveDial:
  V = J1 | J2
  V = V & 15
  if V = 0 then
    Rep = 0
    Held = 0
    return
  end if
  if Lock > 0 then
    if Ph = 1 then return
  end if
  if Rep > 0 then
    dec Rep
    return
  end if
  select case V
  case 4
    Dial = Wrap(Dial, 25)
  case 8
    Dial = Wrap(Dial, 1)
  case 1
    Dial = Wrap(Dial, 21)
  case 2
    Dial = Wrap(Dial, 5)
  case else
    return
  end select
  ShowDial
  play sound SndDial
  Rep = 5
  if Held = 0 then Rep = 12
  Held = 1
  return
end sub

' the dial position plus a step, round the 26 letters
function Wrap(u8 P, u8 D) as u8
  u8 Q = 0
  Q = P + D
  if Q >= 26 then Q = Q - 26
  return Q

' a shot: the right letter explodes; a wrong one freezes the dial
sub Shoot:
  if Dial = Le then
    LastTr = TimeRow(Fy)
    St.Sc += 1
    St.Tm = St.Tm + LastTr
    if LastTr < St.Best then
      St.Best = LastTr
      MoveMark
    end if
    ShowScore
    Ph = 2
    T = BurstN
    play sound SndHit
    play sound SndZap
  else
    inc Tries
    if Tries >= MaxTries then
      Lock = 255
    else
      Lock = LockN
    end if
    ShowTries
    play sound SndWrong
  end if
  return
end sub

' the original's time: the row the letter had reached, 1 (top) to 22
function TimeRow(u16 F) as u8
  u16 Q = 0
  u8 R = 0
  Q = F / RowLen
  R = Q + 1
  if R > 22 then R = 22
  return R

' the arrow beside the chute at the highest catch
sub MoveMark:
  if St.MarkR > 0 then put char 32 at 6,St.MarkR
  W16 = Fy >> 4
  Y = W16 + FallY0
  Y = Y + 8
  St.MarkR = Y >> 3
  put char TMark at 6,St.MarkR
  return
end sub

sub Fall:
  V = Lv + Lv
  V = V + 3
  Fy = Fy + V
  if Fy >= FallMax then
    Fy = FallMax
    Ph = 3
    T = SplatN
    play sound SndThud
  end if
  return
end sub

' the next letter: a random one, and the counter starts at A
sub NextLetter:
  Rand
  V = highbyte(Rs)
  Le = V % 26
  Shuf = 0
  Fy = 0
  Lock = 0
  Tries = 0
  ShowTries
  Ph = 4
  T = 2
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the dial cursor, 1 the letter, 2 a burst or a splat
sub DrawSprites:
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
    update sprites
    return
  end if
  C = 15
  if Lock > 0 then C = 8
  if Ph <> 1 then
    if Ph <> 4 then C = 14
  end if
  set sprite 0 to 147,156,SCursor,C
  W16 = Fy >> 4
  Y = W16 + FallY0
  Y = Y - 1
  select case Ph
  case 1, 4
    K = Shuf << 2
    C = 11
    if Ph = 4 then C = 7
    set sprite 1 to Y,ChuteX,K,C
    set sprite 2 to 192,0,0,0
  case 2
    set sprite 1 to 192,0,0,0
    K = SBurst2
    if T > 30 then K = SBurst1
    set sprite 2 to Y,ChuteX,K,11
  case 3
    set sprite 1 to 192,0,0,0
    K = SSplat2
    if T > 24 then K = SSplat1
    set sprite 2 to 151,ChuteX,K,9
  case else
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end select
  update sprites
  return
end sub

' seven letters of the dial, the aimed one in the middle
sub ShowDial:
  u8 Q = 0
  Q = Wrap(Dial, 23)
  for Di = 0 to 6
    X = Di << 1
    X = X + 14
    C = Q + 65
    put char C at X,DialR
    Q = Wrap(Q, 1)
  next
  return
end sub

sub ShowHud:
  print at 13,1, "LETTER ATTACK!"
  print at 13,3, "DIFFICULTY"
  print at 13,4, "LEVEL:"
  NumU = Lv
  print at 25,4, digits$(NumU, 1)
  print at 13,6, "LETTERS"
  print at 13,7, "REMAINING:"
  print at 13,9, "SCORE:"
  print at 13,11, "HIGH SCORE:"
  NumU = Hs
  print at 25,11, digits$(NumU, 2)
  fill TRule count 17 at 12,13
  print at 13,15, "TURN THE DIAL,"
  print at 13,16, "FIRE AT LETTER"
  put char TDl at 12,DialR
  put char TDr at 28,DialR
  ShowLeft
  ShowScore
  ShowDial
  return
end sub

sub ShowScore:
  NumU = St.Sc
  print at 25,9, digits$(NumU, 2)
  return
end sub

sub ShowLeft:
  NumU = Lr
  print at 25,7, digits$(NumU, 2)
  return
end sub

sub ShowTries:
  print at 13,21, "TRIES:"
  K = MaxTries - Tries
  NumU = K
  print at 20,21, digits$(NumU, 1)
  return
end sub

' the chute: brick walls, the shaft, the floor, a few stars
sub DrawField:
  for Ri = 2 to 20
    put char TWall at 7,Ri
    put char TShaft at 8,Ri
    put char TShaft at 9,Ri
    put char TWall at 10,Ri
  next
  fill TFloor count 4 at 7,21
  for Ri = 2 to 21
    V = Ri * 5
    V = V % 7
    if V < 3 then
      X = V + 2
      put char TStar at X,Ri
    end if
  next
  return
end sub

sub NewGame:
  St.Sc = 0
  St.Tm = 0
  St.Best = 99
  St.MarkR = 0
  Nl = Nlt * 10
  Lr = Nl
  NewScreen
  DrawField
  ShowHud
  ShowTries
  Fy = 0
  Lock = 0
  Tries = 0
  Rep = 0
  Ph = 0
  T = 60
  Over = 0
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' the original's closing report
sub Report:
  u16 Ef = 0
  u16 Av = 0
  NewScreen
  if St.Sc > Hs then Hs = St.Sc
  print at 9,3, "LETTER ATTACK!"
  print at 4,6, "SCORE:"
  NumU = St.Sc
  print at 24,6, digits$(NumU, 2)
  print at 4,8, "HIGH SCORE:"
  NumU = Hs
  print at 24,8, digits$(NumU, 2)
  print at 4,10, "HIGHEST POSSIBLE:"
  NumU = Nl
  print at 24,10, digits$(NumU, 2)
  Ef = St.Sc * 100
  Ef = Ef / Nl
  print at 4,12, "EFFICIENCY:"
  print at 23,12, width$(Ef, 3)
  print at 26,12, "%"
  Av = 0
  if St.Sc > 0 then Av = St.Tm / St.Sc
  print at 4,14, "AVERAGE TIME:"
  print at 24,14, width$(Av, 2)
  print at 4,16, "(1 - GOOD   22 - BAD)"
  print at 10,19, "GAME OVER"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the chute, the tune once, START / LEVEL / LETTERS / CREDITS
sub TitlePage:
  NewScreen
  DrawField
  print at 13,3, "LETTER ATTACK!"
  print at 13,5, "COMPUTE!'S"
  print at 13,6, "GAZETTE"
  print at 13,7, "DECEMBER 1984"
  print at 14,10, "START GAME"
  print at 14,11, "LEVEL"
  print at 14,12, "LETTERS"
  print at 14,13, "HOW TO PLAY"
  print at 14,14, "CREDITS"
  print at 13,16, "SHOOT EACH"
  print at 13,17, "FALLING LETTER"
  print at 13,18, "WITH THE DIAL"
  print at 13,21, "HIGH"
  NumU = Hs
  print at 18,21, digits$(NumU, 2)
  Menu = 0
  ShowMenu
  TitleOn = 1
  Ph = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  DrawSprites
  V = J1 | J2
  V = V & 15
  if V > 0 then
    if WasStick = 0 then
      select case V
      case 1
        if Menu > 0 then dec Menu
      case 2
        if Menu < 4 then inc Menu
      case 4
        if Menu = 1 then
          if Lv > 1 then dec Lv
        end if
        if Menu = 2 then
          if Nlt > 1 then dec Nlt
        end if
      case 8
        if Menu = 1 then
          if Lv < 9 then inc Lv
        end if
        if Menu = 2 then
          if Nlt < 9 then inc Nlt
        end if
      end select
      ShowMenu
      play sound SndDial
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then HowToPage
  if Menu = 4 then CreditsPage
  return
end sub

sub ShowMenu:
  for Ri = 10 to 14
    put char 32 at 12,Ri
  next
  J = Menu + 10
  put char 62 at 12,J
  print at 22,11, "< "
  NumU = Lv
  print at 25,11, digits$(NumU, 1)
  print at 26,11, " >"
  print at 22,12, "<"
  NumU = Nlt * 10
  print at 24,12, digits$(NumU, 2)
  print at 27,12, ">"
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    DrawField
    print at 12,1, "HOW TO PLAY   1/2"
    print at 12,3, "A LETTER FALLS"
    print at 12,4, "DOWN THE CHUTE."
    print at 12,5, "FIRST A COUNTER"
    print at 12,6, "RUNS FROM A AND"
    print at 12,7, "STOPS ON IT."
    print at 12,9, "TURN THE DIAL TO"
    print at 12,10, "THE SAME LETTER"
    print at 12,11, "AND PRESS THE"
    print at 12,12, "BUTTON TO SHOOT"
    print at 12,13, "IT BEFORE IT"
    print at 12,14, "HITS THE FLOOR."
    print at 12,16, "THE DIAL:"
    put char TDl at 12,DialR
    put char TDr at 28,DialR
    for Di = 0 to 6
      X = Di << 1
      X = X + 14
      C = Di + 72
      put char C at X,DialR
    next
    set sprite 0 to 147,156,SCursor,15
    set sprite 1 to 87,ChuteX,SGk,11
  else
    print at 2,1, "SCORING                2/2"
    print at 2,3, "JOYSTICK LEFT OR RIGHT TURNS"
    print at 2,4, "THE DIAL 1 LETTER, UP OR"
    print at 2,5, "DOWN 5 LETTERS."
    print at 2,7, "EACH HIT SCORES 1. THE"
    print at 2,8, "HIGHER YOU HIT THE LETTER,"
    print at 2,9, "THE BETTER YOUR TIME."
    print at 2,11, "A WRONG SHOT FREEZES THE"
    print at 2,12, "DIAL. 3 WRONG SHOTS AND"
    print at 2,13, "THE LETTER IS LOST."
    print at 2,15, "AFTER THE LAST LETTER YOU"
    print at 2,16, "SEE YOUR SCORE AND AVERAGE"
    print at 2,17, "TIME (1 GOOD, 22 BAD)."
    print at 2,19, "TIP: TURN THE DIAL WHILE"
    print at 2,20, "THE COUNTER IS RUNNING."
    set sprite 2 to 143,224,SBurst1,11
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  HtWt = HtWt + 1
  if HtWt >= 1800 then goto ht_out
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_out:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "LETTER ATTACK!"
  print at 2,5, "BASED ON THE TYPE-IN GAME"
  print at 2,6, "LETTER ATTACK, COMPUTE!'S"
  print at 2,7, "GAZETTE, DECEMBER 1984"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,9, "NO AUTHOR NAMED."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: ALPHABET RAIN"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$04,$00,$00,$00,$00
  $10,$10,$00,$40,$40,$00,$04,$00
  $81,$81,$81,$81,$81,$81,$81,$81
  $00,$00,$00,$49,$00,$49,$00,$00
  $00,$10,$18,$03,$01,$03,$18,$10
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$06,$E1,$80,$E1,$06,$00,$00
  $00,$60,$87,$80,$87,$60,$00,$00
end data
data TileCol bytes
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$E1,$01,$01,$01,$01
  $68,$68,$06,$68,$68,$06,$68,$06
  $41,$41,$41,$41,$41,$41,$41,$41
  $0E,$0F,$0E,$1E,$0E,$1E,$0E,$01
  $01,$B1,$B1,$1B,$1B,$1B,$B1,$B1
  $01,$01,$01,$05,$04,$01,$01,$01
  $01,$71,$17,$17,$17,$71,$01,$01
  $01,$71,$17,$17,$17,$71,$01,$01
end data
data SpritePat bytes
  $00,$07,$07,$18,$18,$18,$18,$1F,$1F,$18,$18,$18,$18,$18,$18,$00
  $00,$E0,$E0,$18,$18,$18,$18,$F8,$F8,$18,$18,$18,$18,$18,$18,$00
  $00,$1F,$1F,$18,$18,$18,$18,$1F,$1F,$18,$18,$18,$18,$1F,$1F,$00
