  mode 2 screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  if Over = 0 then goto play_loop

  State = StOver
  GameOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ===========================================================================
' the rules: the C128's loop $20FB-$267A (see work/nh/model.mjs)

' $2078: the table at $3870 -> $385E-$386F; $3883-$3982 zeroed (score too)
sub NewRules:
  Vp = $140
  Px = $2D
  Hits = 9
  Dir = 2
  for Bi = 0 to 2
    BX[Bi] = $13F
    Size[Bi] = 0
    Scnt[Bi] = 0
    Sp[Bi] = 0
    Flap[Bi] = 0
  next
  BY[0] = 0
  BY[1] = $1B
  BY[2] = $34
  R6d = 10
  Lvl = 1
  Strg = 5
  Over = 0
  C93 = 0
  Shot = 0
  Sy = 0
  Sx = 0
  Hit = 0
  HitX = 0
  T9f = 0
  Ta0 = 0
  Side = 0
  Drift = 0
  Score = 0
  Rk = 10
  return
end sub

' $20B8: lose Lvl strength (decimal on the C128: below zero wraps to 99..51,
' and 51 or more is game over)
sub Drain:
  if Strg >= Lvl then
    T = Strg - Lvl
  else
    T = Strg + 100
    T -= Lvl
  end if
  if T >= 51 then
    Over = 1
    T = 0
  end if
  Strg = T
  inc EvDrain
  return
end sub

' one pass of the C128's loop with the latched stick JL (4 left, 8 right,
' 16 button)
sub StepRules:
  EvFire = 0
  EvHit = 0
  EvDrain = 0
  EvLvl = 0
  EvEnd = 0
  ' $2135: every 4th loop, the road's edge (column 70 or more, below 6)
  dec C93
  if C93 >= 128 then
    C93 = 3
    if Px >= $46 then
      Drain
    elseif Px < 6 then
      Drain
    end if
  end if
  ' $2151: a bat in the rider's rows ($37-$45) within 2 columns: one drain
  Dn = 0
  for Bi = 2 downto 0
    if Dn = 0 then
      T = BY[Bi]
      if T >= $37 then
        if T < $46 then
          W16 = BX[Bi]
          W16 = W16 >> 3
          A = W16
          D = A - Px
          if D >= 128 then D = 0 - D
          if D < 3 then
            Drain
            Dn = 1
          end if
        end if
      end if
    end if
  next
  ' $21D8: steer, right first, 3 columns a loop
  T = JL & 8
  if T <> 0 then
    Px += 3
    if Px >= $4D then Px = $4C
  else
    T = JL & 4
    if T <> 0 then
      if Px < 3 then
        Px = 0
      else
        Px -= 3
      end if
    end if
  end if
  ' $21F2: fire from the rider's middle when no shot is out
  if Shot = 0 then
    T = JL & 16
    if T <> 0 then
      Shot = 1
      Sy = $32
      W16 = Px
      W16 = W16 << 3
      Sx = W16 + $14
      EvFire = 1
    end if
  end if
  ' $2266: the bend's timer: each turn lasts one loop longer (1-20)
  dec T9f
  if T9f >= 128 then
    inc Ta0
    if Ta0 = $15 then Ta0 = 1
    T9f = Ta0
    Dir = Dir ^ 3
  end if
  if Dir = 1 then
    if Vp < $20 then
      Vp = 0
    else
      Vp -= $20
    end if
  else
    Vp += $20
    if Vp >= $280 then Vp = $27F
  end if
  ' $2300: the bend pushes the rider 0-2 columns and sets the bats' drift
  Side = 0
  if Vp > $13F then
    Side = 1
    W16 = Vp - $13F
  else
    W16 = $13F - Vp
  end if
  W16 = W16 >> 5
  D1 = W16
  R6d = 10 - D1
  Rk = R6d
  Drift = D1 >> 2
  if Drift <> 0 then
    if Side = 1 then
      if Px < Drift then
        Px = 0
      else
        Px -= Drift
      end if
    else
      Px += Drift
      if Px >= $4D then Px = $4C
    end if
  end if
  ' $23F1: bats 2, 1, 0
  for Bi = 2 downto 0
    inc Scnt[Bi]
    if Scnt[Bi] = 2 then
      inc Size[Bi]
      if Size[Bi] = 4 then Size[Bi] = 3
      Scnt[Bi] = 0
    end if
    T = BY[Bi] + 5
    BY[Bi] = T
    if T >= $51 then
      BY[Bi] = 0
      Size[Bi] = 0
      Scnt[Bi] = 0
      BX[Bi] = Vp
      ' ASL $386D twice, in place: a second new bat in one loop gets 16x
      R6d = R6d << 2
      T = $28 - R6d
      Sp[Bi] = T
    end if
    W16 = Sp[Bi]
    if Side = 0 then
      BX[Bi] = BX[Bi] + W16
    else
      BX[Bi] = BX[Bi] - W16
    end if
    T = 1
    if Hit = 1 then
      if Bi = HitX then T = 0
    end if
    if T = 1 then
      if Flap[Bi] = 0 then
        Flap[Bi] = 2
      else
        dec Flap[Bi]
      end if
    end if
  next
  ' $24E0: the shot's test, 4 rows above it and 16 pixels to its left
  T = 0
  if Shot = 1 then
    if Hit = 0 then T = 1
  end if
  if T = 1 then
    W2 = Sx - $10
    B = Sy - 4
    Dn = 0
    for Bi = 2 downto 0
      if Dn = 0 then
        W16 = BX[Bi]
        if W16 >= W2 then
          W16 = W16 - W2
        else
          W16 = W2 - W16
        end if
        if W16 < $10 then
          D = BY[Bi] - B
          if D >= 128 then D = 0 - D
          if D < 5 then
            Dn = 1
            Hit = 1
            HitX = Bi
            EvHit = 1
            if Hits = 0 then
              Hits = 9
              inc Lvl
              if Lvl = 100 then Lvl = 0
              inc Strg
              if Strg = 51 then Strg = 50
              EvLvl = 1
            else
              dec Hits
            end if
            W16 = Lvl
            Score += W16
            if Score >= 10000 then Score -= 10000
          end if
        end if
      end if
    next
  else
    ' $2509 jumps to $25C6, which adds back what it never took off
    Sx += $10
    Sy += 4
  end if
  ' $25E0: a hit bat carries the shot down with it until row $50
  if Hit = 1 then
    W16 = BX[HitX]
    Sx = W16 + $10
    T = BY[HitX] + 4
    Sy = T
    if T >= $50 then
      Shot = 0
      Hit = 0
      EvEnd = 1
    end if
  end if
  ' $2649: a flying shot climbs 6 rows (SBC #5 with the carry clear)
  if Shot = 1 then
    if Hit = 0 then
      if Sy < 6 then
        Shot = 0
        EvEnd = 1
      end if
      Sy -= 6
    end if
  end if
  return
end sub

' where the bend will be next loop (the bats' drift direction for the
' sprites between two steps): the timer and Vp steps of StepRules
sub PredictSide:
  T = Dir
  if T9f = 0 then T = T ^ 3
  W16 = Vp
  if T = 1 then
    if W16 < $20 then
      W16 = 0
    else
      W16 -= $20
    end if
  else
    W16 += $20
  end if
  NSide = 0
  if W16 > $13F then NSide = 1
  return
end sub

' ===========================================================================
' the road: three dashed lines from the vanishing point (Vp, row 0) to VDC
' x 0, $13F and $275 on row 90, each row bowed by the C128's curvature
' table Rk ($3268 + Rk * 91) toward the bend, the dashes from its counter
' ($275B: per row, the counter runs out -> the next dash is 2 rows longer
' and the pen flips; $22B1 before each line: the pen flips, the length
' (counter + 1) & 3). Only the first point of a row is plotted on the C128,
' 1-6 VDC pixels wide (1-2 port pixels, 2 from row 64).

' per step: the lines' start, slope and dash state
sub PrepField:
  W16 = Vp
  XIn = W16
  ScaleX
  X = ScX
  for Li = 0 to 2
    T = LEnd[Li]
    if T >= X then
      D = T - X
      K = 0
    else
      D = X - T
      K = 1
    end if
    W16 = SlopeT[D]
    if K = 1 then W16 = 0 - W16
    LXS[Li] = W16
    W2 = X
    W2 = W2 << 8
    W2 += 128
    LXF[Li] = W2
  next
  CvB = CvOff[Rk]
  DashSim
  return
end sub

' the dash state at the start of each line, and the state carried to the
' next loop. Z80; Amy form:
'   for Li = 0 to 2
'     DOn = DOn ^ 1 : Dsh = Dsh + 1 : Dsh = Dsh & 3
'     LDsh[Li] = Dsh : LCnt[Li] = Dsh : LOn[Li] = DOn : C = Dsh
'     for Si = 0 to 90
'       dec C
'       if C = 255 then Dsh += 2 : C = Dsh : DOn = DOn ^ 1
'     next
'   next
' (the Z80 takes a whole dash at a time: while the counter C is below the
' rows left R, R -= C + 1 and the next dash starts; same result)
sub DashSim:
  asm {
    ld bc,0
LbDs1:
    ld a,(DOn)
    xor 1
    ld (DOn),a
    ld hl,LOn
    add hl,bc
    ld (hl),a
    ld a,(Dsh)
    inc a
    and 3
    ld (Dsh),a
    ld hl,LDsh
    add hl,bc
    ld (hl),a
    ld hl,LCnt
    add hl,bc
    ld (hl),a
    ld e,a
    ld d,91
LbDs2:
    ld a,e
    cp d
    jr nc,LbDs3
    ld a,d
    sub e
    dec a
    ld d,a
    ld a,(Dsh)
    add a,2
    ld (Dsh),a
    ld e,a
    ld a,(DOn)
    xor 1
    ld (DOn),a
    jr LbDs2
LbDs3:
    inc c
    ld a,c
    cp 3
    jr nz,LbDs1
  }
  return
end sub

' VDC x (XIn, 0-639) -> port pixel ScX = x * 90 / 256 (x * 45 / 128);
' 255 when x is 640 or more (off the field, or negative). Z80; Amy form:
'   if XIn >= 640 then ScX = 255 else W16 = XIn * 45 : W16 = W16 >> 7 : ScX = W16
sub ScaleX:
  asm {
    ld hl,(XIn)
    ld de,640
    or a
    sbc hl,de
    jr c,LbSx1
    ld a,255
    ld (ScX),a
    ret
LbSx1:
    ld hl,(XIn)
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    push hl
    add hl,hl
    push hl
    add hl,hl
    add hl,hl
    pop bc
    add hl,bc
    pop bc
    add hl,bc
    add hl,de
    add hl,hl
    ld a,h
    ld (ScX),a
  }
  return
end sub

' FCnt field tile rows from FRow: each built in FB (28 tiles x 8 bytes, in
' VRAM order) and written to its 28 consecutive tile patterns (FAddr), one
' byte every 37 cycles (the VDP's pace with the display on). Z80; Amy form:
'   for FTr = FRow to FRow + FCnt - 1
'     fill array FB with 0
'     for FL = 0 to 7
'       FY = FTr * 8 + FL : if FY > 90 then next FL
'       for FK = 0 to 2
'         dec LCnt[FK]
'         if LCnt[FK] = 255 then LDsh[FK] += 2 : LCnt[FK] = LDsh[FK] : LOn[FK] ^= 1
'         FX = LXF[FK] >> 8 : LXF[FK] += LXS[FK]
'         if LOn[FK] = 1 and FX < 225 then
'           X = FX + Curve[CvB + FY] (Side 0) or FX - Curve[..] (Side 1; skip if < 0)
'           if X < 224 then FB[(X & $F8) + FL] |= BitM[X & 7]
'           if FY >= 64 and X < 223 then the next pixel too
'     copy FB count 224 to vram.pattern + FAddr[FTr]
sub FieldPart:
  FTr = FRow
fp_row:
  asm {
    ld hl,FB
    ld de,FB+1
    ld (hl),0
    ld bc,223
    ldir
    xor a
    ld (FL),a
LbFp1:
    ld a,(FTr)
    add a,a
    add a,a
    add a,a
    ld b,a
    ld a,(FL)
    add a,b
    ld (FY),a
    cp 91
    jp nc,LbFp9
    xor a
    ld (FK),a
LbFp2:
    ld a,(FK)
    ld c,a
    ld b,0
    ld hl,LCnt
    add hl,bc
    dec (hl)
    ld a,(hl)
    cp 255
    jr nz,LbFp3
    ex de,hl
    ld hl,LDsh
    add hl,bc
    ld a,(hl)
    add a,2
    ld (hl),a
    ex de,hl
    ld (hl),a
    ld hl,LOn
    add hl,bc
    ld a,(hl)
    xor 1
    ld (hl),a
LbFp3:
    ld hl,LXF
    add hl,bc
    add hl,bc
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,d
    ld (FX),a
    push hl
    ld hl,LXS
    add hl,bc
    add hl,bc
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    add hl,de
    ex de,hl
    pop hl
    ld (hl),d
    dec hl
    ld (hl),e
    ld hl,LOn
    add hl,bc
    ld a,(hl)
    or a
    jp z,LbFp8
    ld a,(FX)
    cp 225
    jp nc,LbFp8
    ld d,a
    ld hl,(CvB)
    ld a,(FY)
    ld c,a
    ld b,0
    add hl,bc
    ld bc,Curve
    add hl,bc
    ld e,(hl)
    ld a,(Side)
    or a
    ld a,d
    jr nz,LbFp4
    add a,e
    jr c,LbFp8
    jr LbFp5
LbFp4:
    sub e
    jr c,LbFp8
LbFp5:
    cp 224
    jr nc,LbFp8
    ld d,a
    call LbFpP
    ld a,(FY)
    cp 64
    jr c,LbFp8
    ld a,d
    inc a
    cp 224
    jr nc,LbFp8
    call LbFpP
LbFp8:
    ld a,(FK)
    inc a
    ld (FK),a
    cp 3
    jp nz,LbFp2
LbFp9:
    ld a,(FL)
    inc a
    ld (FL),a
    cp 8
    jp nz,LbFp1
    ld a,(FTr)
    add a,a
    ld c,a
    ld b,0
    ld hl,FAddr
    add hl,bc
    ld a,(hl)
    out (VDP_CTRL_PORT),a
    inc hl
    ld a,(hl)
    or $40
    out (VDP_CTRL_PORT),a
    ld hl,FB
    ld b,224
LbFpW:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    djnz LbFpW
    jr LbFpE
' plot port pixel A (0-223) on line FL of FB
LbFpP:
    push de
    ld e,a
    and $F8
    ld c,a
    ld a,(FL)
    add a,c
    ld c,a
    ld b,0
    ld hl,FB
    add hl,bc
    ld a,e
    and 7
    push hl
    ld c,a
    ld hl,BitM
    add hl,bc
    ld a,(hl)
    pop hl
    or (hl)
    ld (hl),a
    pop de
    ret
LbFpE:
  }
  inc FTr
  T = FRow + FCnt
  if FTr < T then goto fp_row
  return
end sub

' the field's tiles in the name table (rows 10-21, columns 2-29) and their
' colours: black on magenta
sub FieldTiles:
  for Li = 0 to 11
    K = RN[Li]
    T = Li + 10
    W16 = T
    W16 = W16 << 5
    W16 += $1802
    for Si = 0 to 27
      vpoke W16, K
      inc K
      inc W16
    next
    W16 = FAddr[Li]
    W16 += $2000
    fill $1D count 224 to vram.pattern + W16
    W16 = FAddr[Li]
    fill 0 count 224 to vram.pattern + W16
  next
  ' columns 0-1 and 30-31 of the field rows: plain magenta (TBlank's
  ' colours in thirds 1 and 2 are set by the screen)
  return
end sub

' ===========================================================================
' a game

sub NewGame:
  NewRules
  HudD = 0
  StrD = 0
  Fc = 0
  JL = 0
  PxD = 0
  Attract = 0
  DrawPlay
  State = StPlay
  return
end sub

' one frame of play: latch the stick, step every 17 frames, rebuild the
' field in the 12 frames after a step (one tile row a frame), move the sprites
sub PlayFrame:
  T = Jk & 12
  JL = JL | T
  T = Btn
  JL = JL | T
  inc Fc
  if Fc >= StepF then
    Fc = 0
    if Attract = 1 then
      JL = 0
      Strg = 5
    end if
    JS = JL & 12
    StepRules
    JL = 0
    PredictSide
    for Bi = 0 to 2
      BAcc[Bi] = 0
      W16 = Sp[Bi]
      W2 = W16 << 4
      W2 -= W16
      BStp[Bi] = W2
    next
    PrepField
    if Attract = 0 then
      Sounds
      ' the HUD is redrawn in frames 13-14 (the field's work is done)
      if EvHit <> 0 then HudD = 1
      if EvDrain <> 0 then StrD = 1
      if EvLvl <> 0 then StrD = 1
    else
      Over = 0
    end if
  elseif Fc <= 12 then
    FRow = Fc - 1
    FCnt = 1
    FieldPart
  elseif Fc = 13 then
    if HudD = 1 then ShowHud
    HudD = 0
  elseif Fc = 14 then
    if StrD = 1 then DrawStrength
    StrD = 0
  end if
  DrawSprites
  return
end sub

sub Sounds:
  play sound SndHum
  if JS <> 0 then play sound SndSteer
  if EvFire <> 0 then play sound SndShot
  if EvDrain <> 0 then
    play sound SndDrain
  elseif EvHit <> 0 then
    if EvLvl <> 0 then
      play sound SndLevel
    else
      play sound SndHit
    end if
  end if
  return
end sub

' sprites: 0-1 the scooter, 2-4 the bats, 5 the shot. Between two steps
' the bats and the shot move toward their next places (Lerp = Fc / 17).
' A line holds at most the scooter, one bat (bats are 25 rows or more
' apart) and the shot.
sub DrawSprites:
  ' the scooter: rows 56-79 of the field, columns Px..Px+3
  W16 = Px
  W16 = W16 << 3
  XIn = W16
  ScaleX
  T = ScX
  ' slide to the new column (half the way a frame)
  if PxD = 0 then PxD = T
  if PxD < T then
    V = T - PxD
    V = V + 1
    V = V >> 1
    PxD += V
  elseif PxD > T then
    V = PxD - T
    V = V + 1
    V = V >> 1
    PxD -= V
  end if
  X = PxD + 16
  if Attract = 1 then
    set sprite 0 to HideY,0,SScoot1,0
    set sprite 1 to HideY,0,SScoot2,0
  else
    set sprite 0 to 135,X,SScoot1,1
    set sprite 1 to 151,X,SScoot2,1
  end if
  for Bi = 0 to 2
    C = Bi + 2
    ' rows: 5 a loop, a new bat starts at 0 (no move toward it)
    T = BY[Bi]
    Y = 0
    V = T + 5
    if V < $51 then Y = Lerp5[Fc]
    Y += T
    Y += 79
    ' x: Sp a loop (Sp x 15 / 256 a frame), the way the bend will push next
    if Fc <> 0 then BAcc[Bi] = BAcc[Bi] + BStp[Bi]
    W16 = BAcc[Bi]
    W16 = W16 >> 8
    W2 = BX[Bi]
    if NSide = 0 then
      W2 = W2 + W16
    else
      W2 = W2 - W16
    end if
    if Hit = 1 then
      if Bi = HitX then W2 = BX[Bi]
    end if
    XIn = W2
    ScaleX
    K = Size[Bi] * 3
    K += Flap[Bi]
    K = K << 2
    K += SBat00
    V = 1
    if Hit = 1 then
      if Bi = HitX then V = 15
    end if
    ' on the title the bats leave before the menu (rows 16-21)
    if Attract = 1 then
      if Y >= 119 then ScX = 255
    end if
    if ScX > 213 then
      set sprite C to HideY,0,K,0
    else
      X = ScX + 16
      set sprite C to Y,X,K,V
    end if
    if Hit = 1 then
      if Bi = HitX then
        ' the shot rides on the hit bat: (bat + 16, bat row + 4)
        T = X + 5
        A = Y + 4
        set sprite 5 to A,T,SShot2,15
      end if
    end if
  next
  if Shot = 0 then
    set sprite 5 to HideY,0,SShot2,0
  elseif Hit = 0 then
    ' (Sy >> 3) + 1 rows, at least 2
    T = Sy >> 3
    if T = 0 then T = 1
    if T > 10 then T = 10
    K = T - 1
    K = K << 2
    K += SShot2
    T = Lerp6[Fc]
    Y = Sy + 79
    if Sy >= 6 then Y -= T
    XIn = Sx
    ScaleX
    if ScX > 223 then
      set sprite 5 to HideY,0,K,0
    else
      X = ScX + 16
      set sprite 5 to Y,X,K,1
    end if
  end if
  update sprites
  return
end sub

' ===========================================================================
' screens

' HUD row 1: SCORE 0000  HI 0000  LV 01 (green labels, white digits)
sub ShowHud:
  NumU = Score
  print at 8,1, digits$(NumU, 4)
  NumU = Hi
  print at 16,1, digits$(NumU, 4)
  NumU = Lvl
  print at 26,1, digits$(NumU, 2)
  return
end sub

' row 22: the fist, then the strength as pips, two to a tile (up to 50 in
' 25 tiles); red when one more bite (Lvl) would end the game
sub DrawStrength:
  A = TP0
  if Strg < Lvl then A = TD0
  T = Strg
  for Li = 0 to 24
    C = Li + 4
    if T >= 2 then
      K = A + 2
      T -= 2
    elseif T = 1 then
      K = A + 1
      T = 0
    else
      K = A
    end if
    put char K at C,22
  next
  return
end sub

sub DrawSky:
  fill TBlank count 768 to vram.name
  for Li = 2 to 9
    T = Li
    fill TSky count 28 at 2,T
  next
  FieldTiles
  return
end sub

sub DrawPlay:
  NewScreen
  ' fonts: third 0 (HUD) green letters, white digits on black; third 1
  ' (GAME OVER in the sky) white on blue; third 2 (row 22) white on black
  fill $31 count 512 to vram.color + 256
  fill $F1 count 80 to vram.color + 384
  fill $F4 count 512 to vram.color + 2304
  DrawSky
  print at 2,1, "SCORE"
  print at 13,1, "HI"
  put char TLvl at 22,1
  print at 23,1, "LV"
  put char TFist at 2,22
  ShowHud
  DrawStrength
  PrepField
  FRow = 0
  FCnt = 12
  FieldPart
  ShowScreen
  DrawSprites
  return
end sub

sub GameOver:
  ' the C128 silences the SID and prints GAME OVER in the sky
  mute all
  W16 = Score
  if W16 > Hi then Hi = W16
  print at 11,8, "GAME OVER"
  ShowHud
  return
end sub

' ---------------------------------------------------------------------------
' frame, input

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  load default ascii
  duplicate mode 2 patterns
  fill full mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TileColZ to vram.color + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  decompress zx0 TileColZ to vram.color + 5120
  backdrop black
  fill TBlank count 768 to vram.name
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the sky with the name and author (the C128's title lines), the
' road running with its bats behind the menu
sub TitlePage:
  State = StBoot
  NewScreen
  ' third 0: white on blue (the C128's title colours are kept for the name:
  ' light green); third 2: the menu, black on the field's magenta
  fill $F4 count 512 to vram.color + 256
  fill $1D count 512 to vram.color + 4352
  DrawSky
  fill TSky count 28 at 2,1
  print at 9,3, "NIGHTHAWK 128"
  print at 7,5, "BY CHARLES ORCUTT"
  print at 4,7, "FOR RUN MAGAZINE, 1989"
  if Hi > 0 then
    print at 12,1, "HI"
    NumU = Hi
    print at 15,1, digits$(NumU, 4)
  end if
  print at 11,17, "START"
  print at 11,19, "HOW TO PLAY"
  print at 11,21, "CREDITS"
  NewRules
  Attract = 1
  Fc = 0
  JL = 0
  PrepField
  FRow = 0
  FCnt = 12
  FieldPart
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  PlayFrame
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  Attract = 0
  return
end sub

sub ShowMenu:
  put char 32 at 9,17
  put char 32 at 9,19
  put char 32 at 9,21
  C = Menu << 1
  C += 17
  put char 62 at 9,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 9,2, "NIGHTHAWK 128"
  TxT = TxtCredits
  TxX0 = 3
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: three pages, with the game's own sprites and tiles
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 3
  TxY = 3
  TxGap = 2
  TextShow
  set sprite 0 to 127,120,SScoot1,15
  set sprite 1 to 143,120,SScoot2,15
  update sprites
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 3
    TxY = 3
    TxGap = 2
    TextShow
    set sprite 0 to 135,120,SScoot1,15
    set sprite 1 to 151,120,SScoot2,15
    set sprite 2 to 113,104,SBat10,15
    set sprite 3 to 119,140,SBat31,15
    set sprite 4 to 125,125,SShot5,15
    update sprites
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 3
    TxY = 3
    TxGap = 2
    TextShow
    put char TFist at 3,19
    for Li = 0 to 3
      C = Li + 5
      put char TP2 at C,19
    next
    put char TP1 at 9,19
    for Li = 0 to 3
      C = Li + 14
      put char TD2 at C,19
    next
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

data TilePatZ bytes
  $90,$00,$22,$60,$E0,$22,$60,$00,$22,$99,$11,$2F,$99,$D0,$12,$4E,$87,$03,$51,$01,$81,$C3,$C2,$99
  $10,$38,$83,$D5,$55,$60
end data
data TileColZ bytes
  $96,$01,$96,$04,$80,$01,$A0,$B1,$A2,$01,$82,$1B,$84,$01,$A0,$81,$A2,$01,$82,$18,$8A,$01,$1F,$1A
  $01,$2B,$F1,$F5,$F4,$55,$58
end data
data SpritePatZ bytes
  $6A,$7F,$1F,$3F,$BF,$A8,$1F,$82,$7F,$FF,$A6,$7F,$C0,$00,$80,$AA,$A0,$00,$88,$C0,$E0,$2A,$C0,$9A
  $3F,$0E,$22,$04,$00,$5A,$80,$69,$00,$1B,$04,$AF,$C7,$0A,$FE,$12,$F5,$15,$C0,$22,$04,$1F,$51,$B8
  $11,$40,$12,$94,$00,$6B,$3F,$C6,$82,$90,$80,$AB,$20,$1F,$7E,$45,$37,$C6,$4F,$82,$5B,$64,$B8,$BF
  $11,$C0,$72,$CC,$F5,$BE,$BF,$7F,$80,$95,$BE,$9E,$24,$3F,$1F,$81,$84,$02,$C8,$84,$1E,$40,$A4,$00
  $4D,$AF,$04,$FF,$00,$0E,$F9,$9E,$E0,$60,$5F,$FE,$42,$F5,$80,$BE,$29,$80,$56,$95,$80,$69,$80,$56
  $95,$80,$69,$80,$56,$95,$80,$69,$80,$56,$95,$80,$75,$55,$58
end data

data TxD_0 bytes
  $03,$54,$48,$45,$01,$41,$03,$4F,$4E,$45,$09,$53,$54,$52,$45,$4E,$47,$54,$48,$2E,$04,$59,$4F,$55
  $52,$03,$31,$32,$38,$03,$41,$4E,$44,$03,$42,$41,$54,$04,$42,$49,$54,$45,$02,$42,$59,$06,$44,$52
  $41,$49,$4E,$53,$02,$49,$4E,$04,$4D,$4F,$52,$45,$03,$59,$4F,$55,$07,$28,$31,$39,$38,$39,$29,$2E
  $0C,$28,$41,$4E,$54,$48,$52,$4F,$50,$49,$43,$29,$2E
end data
