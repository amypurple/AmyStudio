record Saucer:
  u16 X
  u8 Y
  i8 Dx
  i8 Dy
  u8 Live
end record

Saucer Sc[7]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 PX = 184
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 ShotOn = 0
u8 ShotRow = 0
u8 ShotCol = 0
u8 ShotN = 0
u8 Acc = 0
u8 Rate = 54
u8 Level = 0
u8 Lives = 0
u8 Left = 0
u8 Freeze = 0
u8 Mode = 0
u8 Over = 0
u8 Waves = 0
u8 Deaths = 0
u8 Kills = 0
u8 Passes = 0
u8 Still = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Menu = 0
u8 WasStick = 0
u8 Stk = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Si = 0
u8 Ci = 0
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Hit = 0

  tile screen
  set sound table ApSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayFrame:
  if Mode <> 2 then MovePlayer
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then EndFreeze
    return
  end if
  if ShotOn = 0 then
    V = J1 & 16
    if V > 0 then StartShot
  end if
  Acc = Acc + Rate
  while Acc >= 64
    Acc = Acc - 64
    OnePass
    if Freeze > 0 then
      Acc = 0
      exit while
    end if
  end while
  return
end sub

sub MovePlayer:
  W16 = PX
  K = J1 & 12
  select case K
    case 4
      if PX >= PXMin then PX = PX - 2
    case 8
      if PX < PXMax then PX = PX + 2
  end select
  if PX = W16 then
    if Still < 255 then inc Still
  else
    Still = 0
  end if
  return
end sub

' the shot starts in the base's character column, row 20
sub StartShot:
  W16 = PX - 24
  W16 = W16 >> 3
  ShotCol = W16
  ShotRow = 20
  ShotN = 1
  ShotOn = 1
  play sound SndZap
  return
end sub

' one pass of the C64's main loop
sub OnePass:
  inc Passes
  CheckCrash
  if Mode = 2 then return
  if ShotOn = 1 then ShotStep
  if Left > 0 then MoveSaucers
  return
end sub

' the shot moves up a row and hits every saucer it touches
sub ShotStep:
  u8 Hits = 0
  u8 P = 0
  dec ShotRow
  for Si = 0 to 6
    if Sc[Si].Live = 1 then
      if ShotHits(Si) = 1 then
        Sc[Si].Live = 2
        P = 255 - Sc[Si].Y
        P = P >> 3
        if Still < StillMax then Score += P
        inc Hits
        inc Kills
      end if
    end if
  next
  if Hits > 0 then
    ShotOn = 0
    Left = Left - Hits
    Mode = 1
    Freeze = Hits * 10
    play sound SndBoom
    if Left = 0 then
      if Still < StillMax then Score += 100
      if Level < 99 then inc Level
      inc Waves
      Freeze = Freeze + 45
      play sound SndWave
      ShowLevel
    end if
    ShowScore
  else
    inc ShotN
    if ShotN = 21 then ShotOn = 0
  end if
  return
end sub

' 1 when the shot's character cell (row ShotRow, column ShotCol) touches
' saucer I: some line of both, and the shot's two pixels within the
' saucer's width on those lines
function ShotHits(u8 I) as u8
  u8 Top = 0
  u8 A = 0
  u8 B = 0
  u8 Hw = 0
  u8 S = 0
  u8 Sy = 0
  u8 E = 0
  i16 D = 0
  Sy = Sc[I].Y
  Top = ShotRow * 8 + 50
  A = Sy + 4
  if Top > A then A = Top
  B = Top + 7
  E = Sy + 11
  if E < B then B = E
  Hw = 0
  if A <= B then
    for S = A to B
      E = S - Sy
      E = E - 4
      if SHw[E] > Hw then Hw = SHw[E]
    next
  end if
  Hit = 0
  if Hw > 0 then
    D = ShotCol * 8 + 15 - Sc[I].X
    if D < 0 then D = 0 - D
    if D <= Hw then Hit = 1
  end if
  return Hit

' a live saucer low enough to reach the base, and close enough across
sub CheckCrash:
  for Ci = 0 to 6
    if Sc[Ci].Live = 1 then
      Y = Sc[Ci].Y
      if Y >= 203 then
        W16 = Sc[Ci].X
        if W16 > PX then
          W16 = W16 - PX
        else
          W16 = PX - W16
        end if
        K = Y - 203
        if W16 < HitW[K] then Crash
      end if
    end if
  next
  return
end sub

sub Crash:
  if Mode <> 2 then
    Mode = 2
    Freeze = 60
    ShotOn = 0
    inc Deaths
    play sound SndCrash
  end if
  return
end sub

sub MoveSaucers:
  u8 Ny = 0
  u16 Nx = 0
  for Mi = 0 to 6
    Ny = Sc[Mi].Y + Sc[Mi].Dy
    if Ny >= 210 or Ny < 50 then
      NewSpeed(Mi)
    else
      Sc[Mi].Y = Ny
      Nx = Sc[Mi].X + Sc[Mi].Dx
      if Nx <= 31 or Nx >= 320 then
        NewSpeed(Mi)
      else
        Sc[Mi].X = Nx
      end if
    end if
  next
  return
end sub

' a new random dy and dx (1, -1, 3 or -3 each) for saucer I
sub NewSpeed(u8 I):
  Rand
  C = lowbyte Rs
  C = C & 5
  Sc[I].Dy = DT[C]
  Rand
  C = lowbyte Rs
  C = C & 5
  Sc[I].Dx = DT[C]
  return
end sub

' the end of a pause: after hits, after a cleared wave, after a crash
sub EndFreeze:
  select case Mode
    case 1
      for Si = 0 to 6
        if Sc[Si].Live = 2 then Sc[Si].Live = 0
      next
      Mode = 0
      if Left = 0 then NewWave
    case 2
      dec Lives
      ShowLives
      if Lives = 0 then
        Over = 1
      else
        NewWave
      end if
  end select
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' seven saucers in a row at the top, each with its own random speed
sub NewWave:
  for Mi = 0 to 6
    W16 = Mi
    Sc[Mi].X = W16 * 32 + 31
    Sc[Mi].Y = 60
    Sc[Mi].Live = 1
    NewSpeed(Mi)
  next
  PX = PXStart
  Still = 0
  ShotOn = 0
  Left = 7
  Mode = 0
  Acc = 0
  K = Level
  if K > 12 then K = 12
  Rate = LvRate[K]
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the base, 2 the shot, 3-9 the saucers
sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 L = 0
  W16 = PX - 23
  Sx = XMap[W16]
  if Mode = 2 then
    K = Freeze >> 3
    K = K & 1
    K = K * 4 + SBoom0
    set sprite 0 to 192,0,0,0
    set sprite 1 to 151,Sx,K,9
  else
    ' a base that has sat still for 4 s turns grey: it scores nothing
    K = 9
    if Still >= StillMax then K = 14
    set sprite 0 to 151,Sx,SShipd,11
    set sprite 1 to 151,Sx,SShipb,K
  end if
  if ShotOn = 1 then
    W16 = ShotCol
    W16 = W16 * 8 + 3
    Sx = XMap[W16] - 7
    K = ShotRow * 8
    Sy = YMap[K]
    set sprite 2 to Sy,Sx,SShot,15
  else
    set sprite 2 to 192,0,0,0
  end if
  V = Tick >> 4
  V = V & 1
  for Di = 0 to 6
    K = Di + 3
    L = Sc[Di].Live
    if L = 0 then
      set sprite K to 192,0,0,0
    else
      W16 = Sc[Di].X - 23
      Sx = XMap[W16]
      Y = Sc[Di].Y - 50
      Sy = YMap[Y]
      if L = 1 then
        C = SSau0 + V * 4
        set sprite K to Sy,Sx,C,SauCol[Di]
      else
        C = Freeze >> 2
        C = C & 1
        C = C * 4 + SBoom0
        set sprite K to Sy,Sx,C,11
      end if
    end if
  next
  update sprites
  return
end sub

sub ShowScore:
  if Score > Hi then Hi = Score
  print at 8,1, Score
  print at 23,1, Hi
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 8,22, digits$(NumU, 1)
  return
end sub

sub ShowLevel:
  NumU = Level
  print at 27,22, digits$(NumU, 2)
  return
end sub

sub NewGame:
  NewScreen
  for Di = 0 to 18
    Y = Di + 2
    W16 = Di * 28
    copy StarMap + W16 count 28 to vram.name + Y * 32 + 2
  next
  fill TGnd count 32 at 0,21
  print at 2,1, "SCORE"
  print at 20,1, "HI"
  print at 2,22, "LIVES"
  print at 21,22, "LEVEL"
  Score = 0
  Level = 0
  Lives = 3
  Over = 0
  Freeze = 0
  Waves = 0
  Deaths = 0
  Kills = 0
  ShowScore
  ShowLives
  ShowLevel
  NewWave
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: ASTRO-PANIC! in big letters over the stars, the best score,
' the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 416 to vram.name + 32
  print at 2,15, "COMPUTE!'S GAZETTE FEB 1984"
  print at 7,16, "BY CHARLES BRANNON"
  print at 10,17, "START"
  print at 10,18, "HOW TO PLAY"
  print at 10,19, "CREDITS"
  Menu = 0
  ShowMenu
  if Hi > 0 then
    print at 9,21, "BEST ", Hi
  end if
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  Stk = 0
  if joypad(1).up or joypad(2).up then Stk = 1
  if joypad(1).down or joypad(2).down then Stk = 2
  if Stk > 0 then
    if WasStick = 0 then
      if Stk = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = Stk
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 17 to 19
    put char 32 at 8,J
  next
  V = Menu + 17
  put char 62 at 8,V
  return
end sub

' HOW TO PLAY: 3 pages; a button turns the page; after the last page,
' or 30 seconds untouched, back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "SEVEN FLYING SAUCERS SWARM"
    print at 2,4, "OVER YOUR LASER BASE."
    print at 2,5, "SHOOT THEM ALL DOWN TO"
    print at 2,6, "CLEAR THE WAVE. EACH NEW"
    print at 2,7, "WAVE IS FASTER."
    print at 2,9, "IF A SAUCER TOUCHES YOUR"
    print at 2,10, "BASE, YOU LOSE A LIFE AND"
    print at 2,11, "ALL SEVEN COME BACK."
    fill TGnd count 28 at 2,20
    set sprite 3 to 104,48,SSau0,SauCol[0]
    set sprite 4 to 96,120,SSau1,SauCol[1]
    set sprite 5 to 112,192,SSau0,SauCol[2]
    set sprite 2 to 124,116,SShot,15
    set sprite 0 to 143,112,SShipd,11
    set sprite 1 to 143,112,SShipb,9
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "JOYSTICK LEFT/RIGHT MOVES"
    print at 2,4, "YOUR BASE."
    print at 2,6, "A BUTTON FIRES. HOLD IT TO"
    print at 2,7, "KEEP FIRING. ONLY ONE SHOT"
    print at 2,8, "CAN BE IN THE AIR AT ONCE."
    print at 2,10, "EITHER CONTROLLER WORKS."
    fill TGnd count 28 at 2,20
    set sprite 2 to 112,124,SShot,15
    set sprite 0 to 143,120,SShipd,11
    set sprite 1 to 143,120,SShipb,9
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "A SAUCER HIGH UP IS WORTH"
    print at 2,4, "MORE (5 TO 25 POINTS)."
    print at 2,5, "CLEAR A WAVE: 100 POINTS."
    print at 2,7, "YOU HAVE 3 LIVES. THE GAME"
    print at 2,8, "ENDS WHEN THEY ARE GONE."
    print at 2,10, "A BASE THAT SITS STILL FOR"
    print at 2,11, "4 SECONDS TURNS GREY AND"
    print at 2,12, "SCORES NOTHING."
    print at 2,14, "TIP: KEEP MOVING, SHOOT"
    print at 2,15, "THEM HIGH, DODGE LOW ONES."
    set sprite 3 to 136,88,SSau0,SauCol[3]
    set sprite 4 to 136,152,SBoom0,11
  end select
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub


sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "ASTRO-PANIC!"
  print at 2,5, "BASED ON ASTRO-PANIC! BY"
  print at 2,6, "CHARLES BRANNON, COMPUTE!'S"
  print at 2,7, "GAZETTE FEBRUARY 1984 (C64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SAUCER SWARM"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

