const SndZap = 3
const SndBoom = 4
const SndCrash = 5
const SndFall = 6
const SndWave = 7
const SndOver = 8
const NSpr = 10
const PXMin = 25
const PXMax = 320
const PXStart = 184
const StillMax = 240

' passes a frame x 64 by level (the C64's NTSC rate to level 7, eased after)
data LvRate bytes 54,57,61,66,71,78,86,96,104,110,116,122,128
' a random dx or dy from (random AND 5): 1, -1, 3, -3
data DT bytes 1,255,0,0,3,253
' half widths of the saucer's lines 4-11 (C64 pixels)
data SHw bytes 6,8,10,12,12,12,8,6
' a saucer at y 203-209 touches the base when its x is closer than this
data HitW bytes 7,10,13,16,16,18,20
data SauCol bytes 5,13,15,11,9,14,3

