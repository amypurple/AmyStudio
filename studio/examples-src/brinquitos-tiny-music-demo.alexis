text screen
print at 8,5, "BRINQUITOS MUSIC"
print at 5,8, "CVBASIC MUSIC -> TINY"
print at 5,11, "BUTTON1 = GLADIATORS"
print at 6,13, "BUTTON2 = GAME OVER"
print at 6,15, "BUTTON3 = JUMP SFX"
print at 7,17, "HOLD # = STOP ALL"
set sound table brinquitos_snd_table areas 5
screen on
wait 2 frames
play song brinquitos_music_gladiators_song

MainLoop:
  if joypad(1).button1 then
    play song brinquitos_music_gladiators_song
    goto WaitButtonRelease
  elseif joypad(1).button2 then
    play song brinquitos_music_end_song
    goto WaitButtonRelease
  elseif keypad(1) = 3 then
    play sound 6
    goto WaitButtonRelease
  elseif keypad(1) = 15 then
    stop all
    goto WaitButtonRelease
  end if
  wait
  goto MainLoop

WaitButtonRelease:
  wait
  if joypad(1).button1 then goto WaitButtonRelease
  if joypad(1).button2 then goto WaitButtonRelease
  if keypad(1) = 3 then goto WaitButtonRelease
  if keypad(1) = 15 then goto WaitButtonRelease
  goto MainLoop

include "@project/brinquitos-tiny-music.asm"