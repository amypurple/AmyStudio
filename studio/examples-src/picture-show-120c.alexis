u8 Pic = 0
u8 WasB = 1
u8 B = 0

  ShowPic
show_loop:
  wait
  B = 0
  if joypad(1).button1 then B = 1
  if joypad(2).button1 then B = 1
  if joypad(1).button2 then B = 1
  if joypad(2).button2 then B = 1
  if B = 0 then
    WasB = 0
    goto show_loop
  end if
  if WasB = 1 then goto show_loop
  WasB = 1
  Pic = 1 - Pic
  ShowPic
  goto show_loop

' ShowPic: picture Pic, loaded with the screen off
sub ShowPic:
  120 colors off
  screen off
  picture screen
  if Pic = 0 then
    decompress zx0 SunA to vram $0000
    decompress zx0 SunN to vram $1800
    decompress zx0 SunB to vram $2000
  else
    decompress zx0 LampA to vram $0000
    decompress zx0 LampN to vram $1800
    decompress zx0 LampB to vram $2000
  end if
  120 colors on
  screen on
  return
end sub
