cartridge "SCRAMBLER/COMPUTE!'S GAZETTE/1988"

' SCRAMBLER
' A ColecoVision game based on "Scrambler", COMPUTE!'s Gazette July 1988
' (Commodore 64 BASIC, disk 1988-07, file scrambler; the listing names no
' author). Not the Ahoy! SCRAMBLER of 1987 (games/scrambler), a different
' game. Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in
' Amy by Amy Bienvenu.
'
' The game (the original's rules, read from its listing, orig/scrambler.bas,
' and watched in jsc64): 1 to 4 players take turns. Each turn rolls 13
' letter dice (the original's 13 six-sided dice, one letter each, so the
' same letter can come up twice) and the player makes as many words as he
' can from them before the timer (1, 3, 5 or 7 minutes) runs out. A word
' uses each rolled letter at most once; a word already made this turn is
' thrown out with a low buzz. WORDS game: 1 point a word. POINTS game: by
' length, 1, 2 or 3 letters as many points, 4 letters 5, 5 letters 7,
' 6 or more 9. After the last player: the scores and the winner (the first
' player with the highest score), then the high score of that timer and
' game type is kept (8 of them: 1/3/5/7 minutes x points/words). The
' timer's display turns the C64 border red with 20 left.
'
' Liberties: letters are picked with a joystick cursor instead of typed
' (left button picks a letter, or OK sends the word; right button takes
' the last letter back); no typed names (PLAYER 1..4). A built-in word
' list (8,759 words of 2-8 letters, words.txt) replaces the original's
' honour system ("ANY DELETIONS?" after the turn, where players struck
' out their own non-words): a word not in the list is refused at once and
' costs 3 seconds, so random letters or sweeping along the row can't
' score; 2 letters is the shortest word (the C64 took any letters, even
' one). The list leaves out vulgar and offensive words (wl/bad.txt). The
' timer counts real seconds (60 a minute; the C64's ran at about 1.2 a
' second and each typed key took 0.2 off it: not kept). The red
' backdrop replaces the red border. High scores last until the power is
' switched off (no disk). Words are listed in three columns of eight (a
' full list starts over, as the C64 cleared its screen). Ties for the top
' score are named as a tie. At most 160 words a turn. The play-again
' question is replaced by the house ending.
'
' Controls: stick moves the cursor (hold to repeat); left button picks
' the letter or OK; right button takes back the last letter. Either
' controller. On the title: up/down choose a line, left/right change it,
' a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off after
' a wait, display off. Music first in the sound table; the title tune
' played once. `set sprite count` always given. Own xorshift random
' numbers. Nothing flashes.

const TRule = 192
const TSlot = 193
const TOk00 = 194
const TOk01 = 195
const TOk10 = 196
const TOk11 = 197
const TDot = 198
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const SFly = 16
const NTiles8 = 56
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndMove = 3
const SndPick = 4
const SndBack = 5
const SndOk = 6
const SndBad = 7
const SndDup = 8
const SndTick = 9
const SndTimeUp = 10
const SndWin = 11
const NDictBytes = 16200
const NSpr = 5
const MaxLen = 8
const MaxWords = 160
const PenSecs = 3
const OkX = 24
const ListTop = 13
const MsgRow = 11

' the original's 13 dice (lines 1220-1340), six faces each
data Dice chars
  "BOWYOL"
  "TIKRBH"
  "AEAEAE"
  "FPLHBN"
  "FINUTP"
  "OCOMPW"
  "VQYSWS"
  "PQVWAI"
  "SIHRUF"
  "KDGJMC"
  "EAEAEA"
  "ZQXEVJ"
  "SUMRGI"
end data

' SCRAMBLER for the title cells
data TitleWord bytes
  19,3,18,1,13,2,12,5,18
end data

data MinsOf bytes
  1,3,5,7
end data

record Box:
  u8 L
  u8 T
  u8 R
  u8 B
end record

record Mover:
  u8 Live
  u8 X
  u8 Y
  u8 Tx
  u8 Ty
  u8 Ch
  u8 Cx
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Score = 0
u16 Secs = 0
u16 Found = 0
u16 HiScore[8]
u16 PScore[4]
u16 UsedW[160]
Box Cur
Box Goal
Mover Fly
bcd digits 4 WordCount
u8 Let[13]
u8 Picked[13]
u8 Wd[8]
u8 Wl[8]
u8 Bf[8]
u8 WLen = 0
u8 NUsed = 0
u8 NPlay = 1
u8 GType = 1
u8 TSel = 1
u8 Pl = 0
u8 Sub60 = 0
u8 Cx = 0
u8 Cy = 0
u8 Stage = 0
u8 Menu = 0
u8 Ask = 0
u8 Tick = 0
u8 MsgT = 0
u8 Red = 0
u8 NewHi = 0
u8 Result = 0
u8 Lk = 0
' input
u8 J1 = 0
u8 Pj = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Press2 = 0
u8 WasB2 = 0
u8 WasStick = 0
u8 LastDir = 0
u8 Rep = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Li = 0
u8 Pi = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table GsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 4
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  for Ci = 0 to 7
    HiScore[Ci] = 0
  next
  CreditsPage

title:
  TitlePage
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  PlayGame
  goto title

' ---------------------------------------------------------------------------
' the game: every player's turn, then the scores

sub PlayGame:
  for Pi = 0 to 3
    PScore[Pi] = 0
  next
  for Pi = 1 to NPlay
    Pl = Pi
    ReadyPage
    PlayTurn
    PScore[Pi - 1] = Score
  next
  EndPage
  return
end sub

' ---------------------------------------------------------------------------
' random numbers and the dice

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' each die shows one of its six faces (letters 1..26)
sub RollDice:
  u8 Face = 0
  u8 Ix = 0
  for Ci = 0 to 12
    Rand
    Face = Rs % 6
    Ix = Ci * 6 + Face
    Let[Ci] = Dice[Ix] - 64
    Picked[Ci] = 0
  next
  return
end sub

' ---------------------------------------------------------------------------
' the word list (see words.py for the packing)

' Found = 1 + the word's place in Dict when Wl[0..WLen-1] is a word, else 0
sub LookUp:
  u16 P = 0
  u16 E = 0
  u16 St = 0
  u8 B = 0
  u8 Pf = 0
  u8 N = 0
  u8 Tl = 0
  u8 Q = 0
  u8 Cmp = 0
  u16 Ix = 0
  u16 Qa = 0
  Found = 0
  Lk = Wl[0]
  ' the range of words that begin with the word's first two letters
  Ix = Lk - 1
  Ix = Ix * 26 + Wl[1] - 1
  Qa = Ix * 2
  P = Off2[Qa + 1]
  P = P * 256 + Off2[Qa]
  E = Off2[Qa + 3]
  E = E * 256 + Off2[Qa + 2]
  Tl = WLen - 1
  while P < E
    St = P
    B = Dict[P]
    inc P
    Pf = (B >> 5) - 1
    Bf[Pf] = B & 31
    N = Pf + 1
    while Dict[P] < 32
      Bf[N] = Dict[P]
      inc N
      inc P
    end while
    ' compare the word (first letter Lk, then Bf[0..N-1]) with Wl
    Cmp = 0
    Q = 0
    while Cmp = 0
      if Q = N then
        if Q = Tl then
          Cmp = 2
        else
          Cmp = 1
        end if
      elseif Q = Tl then
        Cmp = 3
      elseif Bf[Q] < Wl[Q + 1] then
        Cmp = 1
      elseif Bf[Q] > Wl[Q + 1] then
        Cmp = 3
      else
        inc Q
      end if
    end while
    ' 1: the list word comes before, 2: the same, 3: after (not there)
    if Cmp = 2 then
      Found = St + 1
      exit while
    end if
    if Cmp = 3 then exit while
  end while
  return
end sub

function AlreadyUsed(u16 Wo) as u8
  u8 Ui = 0
  u8 Hit = 0
  while Ui < NUsed
    if UsedW[Ui] = Wo then Hit = 1
    inc Ui
  end while
  return Hit

' the original's points (lines 1420-1450)
function WordPts(u8 Ln) as u8
  if GType = 0 then return 1
  select case Ln
  case 1, 2, 3
    return Ln
  case 4
    return 5
  case 5
    return 7
  end select
  return 9

' ---------------------------------------------------------------------------
' one player's turn

sub PlayTurn:
  u8 Done = 0
  RollDice
  Score = 0
  WordCount = 0
  NUsed = 0
  WLen = 0
  Red = 0
  Secs = MinsOf[TSel] * 60
  Sub60 = 0
  MsgT = 0
  Fly.Live = 0
  NewScreen
  DrawPlay
  Cx = 0
  Cy = 0
  SetGoal
  Cur.L = Goal.L
  Cur.T = Goal.T
  Cur.R = Goal.R
  Cur.B = Goal.B
  ShowScreen
  Stage = 4
  ReadPad
  LastDir = 0
  Rep = 0
  while Done = 0
    Ask = 1
    Frame1
    ReadPad
    StickMove
    Glide
    FlyStep
    if MsgT > 0 then
      dec MsgT
      if MsgT = 0 then ClearMsg
    end if
    if Press2 = 1 then TakeBack
    if Press = 1 then
      if Cy = 1 and Cx = 6 then
        SendWord
      else
        PickLetter
      end if
    end if
    ' the clock: one second every 60 frames
    inc Sub60
    if Sub60 >= 60 then
      Sub60 = 0
      if Secs > 0 then dec Secs
      ShowTime
      if Secs <= 10 and Secs > 0 then play sound SndTick
    end if
    if Secs = 0 then Done = 1
  end while
  Ask = 0
  HideSprites
  Fly.Live = 0
  mute all
  play sound SndTimeUp
  ClearMsg
  print at 2,MsgRow, "TIME'S UP!"
  Stage = 5
  Pause(90)
  print at 14,MsgRow, "PRESS THE BUTTON"
  WaitPress
  return
end sub

' the cell under the cursor: 0..6 top row, 7..12 bottom row
function CellAt(u8 Ax, u8 Ay) as u8
  if Ay = 0 then return Ax
  return Ax + 7

sub PickLetter:
  u8 Pc = 0
  Pc = CellAt(Cx, Cy)
  if Picked[Pc] = 1 then
    play sound SndBad
    return
  end if
  if WLen >= MaxLen then
    play sound SndBad
    return
  end if
  FlyLand
  Picked[Pc] = 1
  ColourCell(Pc, 1)
  Wd[WLen] = Pc
  Wl[WLen] = Let[Pc]
  ' the letter flies from its cell to its place in the word
  Fly.X = CellX(Pc) * 8
  Fly.Y = CellY(Pc) * 8 - 1
  Fly.Tx = WLen * 2 + 9
  Fly.Ty = 75
  Fly.Tx = Fly.Tx * 8 - 4
  Fly.Ch = Let[Pc]
  Fly.Cx = WLen * 2 + 9
  Fly.Live = 1
  LoadFly(Let[Pc])
  inc WLen
  play sound SndPick
  return
end sub

sub TakeBack:
  u8 Tc = 0
  if WLen = 0 then return
  FlyLand
  dec WLen
  Tc = Wd[WLen]
  Picked[Tc] = 0
  ColourCell(Tc, 0)
  V = WLen * 2 + 9
  put char TSlot at V,10
  play sound SndBack
  return
end sub

sub ClearWord:
  u8 Cw = 0
  FlyLand
  while WLen > 0
    dec WLen
    Cw = Wd[WLen]
    Picked[Cw] = 0
    ColourCell(Cw, 0)
  end while
  for Cw = 0 to 7
    put char TSlot at Cw * 2 + 9,10
  next
  return
end sub

sub SendWord:
  u8 Pts = 0
  if WLen = 0 then return
  FlyLand
  if WLen < 2 then
    Refuse(1)
    return
  end if
  LookUp
  if Found = 0 then
    Refuse(2)
    return
  end if
  if AlreadyUsed(Found) = 1 then
    Refuse(3)
    return
  end if
  if NUsed >= MaxWords then
    Refuse(4)
    return
  end if
  UsedW[NUsed] = Found
  ListWord(NUsed)
  inc NUsed
  inc WordCount
  Pts = WordPts(WLen)
  Score = Score + Pts
  ShowScore
  ClearMsg
  print at 2,MsgRow, "GOOD WORD +"
  print Pts at 13,MsgRow
  MsgT = 50
  play sound SndOk
  ClearWord
  return
end sub

sub Refuse(u8 Why):
  ClearMsg
  select case Why
  case 1
    print at 2,MsgRow, "TOO SHORT"
    play sound SndBad
  case 2
    print at 2,MsgRow, "NOT IN MY LIST  -3 SEC"
    play sound SndBad
    if Secs > PenSecs then
      Secs = Secs - PenSecs
    else
      Secs = 1
    end if
    ShowTime
  case 3
    print at 2,MsgRow, "ALREADY USED"
    play sound SndDup
  case else
    print at 2,MsgRow, "LIST FULL"
    play sound SndBad
  end select
  MsgT = 70
  ClearWord
  return
end sub

' word number Wn of this turn into the three columns of eight
sub ListWord(u8 Wn):
  u8 Slot = 0
  u8 Lx = 0
  u8 Ly = 0
  u8 Lw = 0
  Slot = Wn % 24
  if Slot = 0 and Wn > 0 then
    for Lw = ListTop to ListTop + 7
      fill 32 count 28 at 2,Lw
    next
  end if
  Lx = (Slot / 8) * 9 + 2
  Ly = Slot % 8 + ListTop
  for Lw = 0 to WLen - 1
    put char Wl[Lw] + 64 at Lx + Lw,Ly
  next
  return
end sub

' ---------------------------------------------------------------------------
' the cursor

function CellX(u8 Cc) as u8
  if Cc < 7 then return Cc * 3 + 6
  return (Cc - 7) * 3 + 6

function CellY(u8 Cc) as u8
  if Cc < 7 then return 4
  return 7

sub StickMove:
  D = Pj & 15
  if D = 0 then
    LastDir = 0
    return
  end if
  K = 0
  if D <> LastDir then
    K = 1
    Rep = 14
  else
    dec Rep
    if Rep = 0 then
      K = 1
      Rep = 6
    end if
  end if
  LastDir = D
  if K = 0 then return
  if D & 1 then Cy = 0
  if D & 2 then Cy = 1
  if D & 4 then
    if Cx > 0 then dec Cx
  end if
  if D & 8 then
    if Cx < 6 then inc Cx
  end if
  SetGoal
  play sound SndMove
  return
end sub

' the box the cursor heads for: a letter cell or OK (row 1, column 6)
sub SetGoal:
  u8 Gx = 0
  u8 Gy = 0
  Gx = Cx * 3 + 6
  if Cy = 0 then
    Gy = 4
  else
    Gy = 7
  end if
  Goal.L = Gx * 8 - 3
  Goal.T = Gy * 8 - 3
  Goal.R = Goal.L + 21
  Goal.B = Goal.T + 21
  return
end sub

function Toward(u8 Now, u8 Want) as u8
  u8 Dist = 0
  if Now < Want then
    Dist = Want - Now
    if Dist > 4 then Dist = 4
    return Now + Dist
  end if
  Dist = Now - Want
  if Dist > 4 then Dist = 4
  return Now - Dist

sub Glide:
  Cur.L = Toward(Cur.L, Goal.L)
  Cur.T = Toward(Cur.T, Goal.T)
  Cur.R = Toward(Cur.R, Goal.R)
  Cur.B = Toward(Cur.B, Goal.B)
  DrawCursor
  return
end sub

sub DrawCursor:
  u8 Ly = 0
  u8 By = 0
  u8 Rx = 0
  Ly = Cur.T - 1
  By = Cur.B - 16
  Rx = Cur.R - 15
  set sprite 0 to Ly,Cur.L,SCtl,11
  set sprite 1 to Ly,Rx,SCtr,11
  set sprite 2 to By,Cur.L,SCbl,11
  set sprite 3 to By,Rx,SCbr,11
  update sprites
  return
end sub

' the flying letter: sprite pattern SFly gets the letter's big tiles
' (tiles are TL TR BL BR; a 16 x 16 sprite is TL BL TR BR)
sub LoadFly(u8 Fl):
  u16 Fo = 0
  Fo = Fl - 1
  Fo = Fo * 32
  copy BigFont + Fo count 8 to vram.spr_pat + 512
  copy BigFont + Fo + 16 count 8 to vram.spr_pat + 520
  copy BigFont + Fo + 8 count 8 to vram.spr_pat + 528
  copy BigFont + Fo + 24 count 8 to vram.spr_pat + 536
  return
end sub

sub FlyStep:
  if Fly.Live = 0 then return
  Fly.X = Toward(Fly.X, Fly.Tx)
  Fly.Y = Toward(Fly.Y, Fly.Ty)
  if Fly.X = Fly.Tx and Fly.Y = Fly.Ty then
    FlyLand
    return
  end if
  set sprite 4 to Fly.Y,Fly.X,SFly,15
  update sprites
  return
end sub

' the flying letter arrives (at once when something else happens first)
sub FlyLand:
  if Fly.Live = 0 then return
  Fly.Live = 0
  put char Fly.Ch + 64 at Fly.Cx,10
  set sprite 4 to 192,0,SFly,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' cell Lc shows letter Lt (1..26)
sub LoadCell(u8 Lc, u8 Lt):
  u16 Fo = 0
  u16 Vo = 0
  Fo = Lt - 1
  Fo = Fo * 32
  Vo = Lc * 32 + 1024
  copy BigFont + Fo count 32 to vram.pattern + Vo
  Vo = Vo + 2048
  copy BigFont + Fo count 32 to vram.pattern + Vo
  Vo = Vo + 2048
  copy BigFont + Fo count 32 to vram.pattern + Vo
  return
end sub

' cell Lc in colour scheme Sch (0 to pick, 1 picked, 2..8 title colours)
sub ColourCell(u8 Lc, u8 Sch):
  u16 Vo = 0
  u16 So = 0
  Vo = Lc * 32 + 1024
  So = Sch * 32
  copy CellCol + So count 32 to vram.color + Vo
  return
end sub

sub PutCell(u8 Pc, u8 Px, u8 Py):
  u8 Tc = 0
  Tc = Pc * 4 + 128
  put char Tc at Px,Py
  put char Tc + 1 at Px + 1,Py
  put char Tc + 2 at Px,Py + 1
  put char Tc + 3 at Px + 1,Py + 1
  return
end sub

sub DrawPlay:
  print at 2,1, "SCRAMBLER"
  if GType = 0 then
    print at 15,1, "WORDS"
  else
    print at 15,1, "POINTS"
  end if
  V = MinsOf[TSel]
  put char V + 48 at 23,1
  print at 25,1, "MIN"
  fill TRule count 28 at 2,2
  for Ci = 0 to 12
    LoadCell(Ci, Let[Ci])
    ColourCell(Ci, 0)
    PutCell(Ci, CellX(Ci), CellY(Ci))
  next
  put char TOk00 at OkX,7
  put char TOk01 at OkX + 1,7
  put char TOk10 at OkX,8
  put char TOk11 at OkX + 1,8
  print at 2,10, "WORD"
  for Ci = 0 to 7
    put char TSlot at Ci * 2 + 9,10
  next
  print at 2,MsgRow, "RIGHT BUTTON TAKES BACK"
  fill TRule count 28 at 2,12
  fill TRule count 28 at 2,21
  print at 2,22, "PLAYER"
  put char Pl + 48 at 9,22
  print at 11,22, "TIME"
  print at 20,22, "SCORE"
  ShowTime
  ShowScore
  backdrop black
  return
end sub

sub ShowTime:
  W16 = Secs
  print at 16,22, width$(W16, 3)
  if Secs <= 20 and Red = 0 then
    Red = 1
    backdrop dark red
  end if
  return
end sub

sub ShowScore:
  print at 26,22, digits$(Score, 4)
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,MsgRow
  return
end sub

' ---------------------------------------------------------------------------
' screens

' before each turn: whose turn it is and the scores so far (lines 530-600)
sub ReadyPage:
  u8 Ry = 0
  NewScreen
  print at 2,1, "SCRAMBLER"
  fill TRule count 28 at 2,2
  print at 9,5, "PLAYER"
  put char Pl + 48 at 16,5
  print at 18,5, "TO PLAY"
  if Pl > 1 then
    Ry = 8
    for Li = 1 to Pl - 1
      print at 6,Ry, "PLAYER"
      put char Li + 48 at 13,Ry
      print at 15,Ry, "SCORED"
      print at 22,Ry, digits$(PScore[Li - 1], 4)
      inc Ry
    next
  end if
  print at 3,15, "13 LETTERS ARE ROLLED."
  print at 3,16, "MAKE AS MANY WORDS AS YOU"
  print at 3,17, "CAN BEFORE THE TIME IS UP."
  print at 7,20, "PRESS THE BUTTON"
  backdrop dark blue
  ShowScreen
  Stage = 3
  WaitPress
  return
end sub

' the scores, the winner and the high scores (lines 1000-1150)
sub EndPage:
  u8 Ey = 0
  u8 Hx = 0
  u8 Ties = 0
  u16 Best = 0
  u8 Wn = 0
  NewScreen
  print at 2,1, "SCRAMBLER"
  fill TRule count 28 at 2,2
  for Li = 0 to NPlay - 1
    if PScore[Li] > Best then
      Best = PScore[Li]
      Wn = Li + 1
    end if
  next
  if NPlay = 1 then
    print at 6,4, "YOUR SCORE IS"
    print at 20,4, digits$(PScore[0], 4)
  else
    print at 2,4, "THE SCORES:"
    Ey = 5
    for Li = 0 to NPlay - 1
      print at 4,Ey, "PLAYER"
      put char Li + 49 at 11,Ey
      print at 14,Ey, digits$(PScore[Li], 4)
      if PScore[Li] = Best then inc Ties
      inc Ey
    next
    if Best = 0 then
      print at 4,10, "NOBODY SCORED"
    elseif Ties > 1 then
      print at 4,10, "A TIE AT THE TOP!"
    else
      print at 4,10, "THE WINNER IS PLAYER"
      put char Wn + 48 at 25,10
    end if
  end if
  ' the high score of this timer and game type
  Hx = TSel * 2 + GType
  NewHi = 0
  if Best > HiScore[Hx] then
    HiScore[Hx] = Best
    NewHi = 1
    print at 4,12, "A NEW HIGH SCORE!"
  end if
  DrawHighs(14)
  backdrop dark blue
  ShowScreen
  Stage = 6
  if NewHi = 1 then
    play sound SndWin
  else
    play sound SndOk
  end if
  Pause(60)
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds, and a press wakes it
  Ask = 9
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ask = 0
  return
end sub

' the high-score table at row Hy (POINTS and WORDS for 1/3/5/7 minutes)
sub DrawHighs(u8 Hy):
  u8 Hr = 0
  u8 Hk = 0
  print at 4,Hy, "HIGH SCORES  POINTS WORDS"
  for Hr = 0 to 3
    Hk = Hy + Hr + 1
    put char MinsOf[Hr] + 48 at 4,Hk
    print at 6,Hk, "MIN"
    print at 15,Hk, digits$(HiScore[Hr * 2 + 1], 4)
    print at 22,Hk, digits$(HiScore[Hr * 2], 4)
  next
  return
end sub

sub WaitPress:
  Rearm
  wait no fire
  nmi off
  ReadPad
  do
    Frame1
    inc Rs
    ReadPad
  loop until Press = 1
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Nf):
  u8 Pk = 0
  for Pk = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up or joypad(2).up then J1 = J1 | 1
  if joypad(1).down or joypad(2).down then J1 = J1 | 2
  if joypad(1).left or joypad(2).left then J1 = J1 | 4
  if joypad(1).right or joypad(2).right then J1 = J1 | 8
  if joypad(1).button1 or joypad(2).button1 then J1 = J1 | 16
  if joypad(1).button2 or joypad(2).button2 then J1 = J1 | 32
  Pj = J1
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = J1 & 32
  Press2 = 0
  if V > 0 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1536
  copy TileCol count NTiles8 to vram.color + 1536
  copy TilePat count NTiles8 to vram.pattern + 3584
  copy TilePat count NTiles8 to vram.pattern + 5632
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: SCRAMBLER unscrambles itself, the tune once, the menu

sub TitleCells(u8 NFix):
  u8 Tc = 0
  u8 Tl = 0
  for Tc = 0 to 8
    if Tc < NFix then
      Tl = TitleWord[Tc]
    else
      ' a letter of the name from the cells not yet fixed
      Rand
      Tl = Rs % (9 - NFix)
      Tl = TitleWord[Tl + NFix]
    end if
    LoadCell(Tc, Tl)
  next
  return
end sub

sub TitlePage:
  u8 NFix = 0
  u8 Tw = 0
  u8 Ty = 0
  NewScreen
  ' the letters up and down between two lines, as on the C64's title
  fill TRule count 28 at 2,2
  for Ci = 0 to 8
    ColourCell(Ci, Ci % 7 + 2)
    Ty = (Ci & 1) + 3
    PutCell(Ci, Ci * 3 + 2, Ty)
  next
  fill TRule count 28 at 2,6
  TitleCells(0)
  print at 2,7, "COMPUTE!'S GAZETTE JULY 1988"
  print at 6,9, "PLAYERS"
  print at 6,10, "GAME"
  print at 6,11, "TIMER"
  print at 6,12, "START"
  print at 6,13, "CREDITS"
  ShowMenu
  DrawHighs(15)
  print at 3,21, "MAKE WORDS FROM 13 LETTERS"
  print at 3,22, "BEFORE THE TIMER RUNS OUT"
  ShowScreen
  Stage = 2
  Menu = 3
  ShowMenu
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 504
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  NFix = 0
  Tw = 0
tp_loop:
  Ask = 2
  Frame1
  inc Rs
  if NFix < 9 then
    inc Tw
    if Tw >= 20 then
      Tw = 0
      inc NFix
      TitleCells(NFix)
    end if
  end if
  ReadPad
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      end if
      if V & 2 then
        if Menu < 4 then inc Menu
      end if
      if V & 4 then ChangeItem(0)
      if V & 8 then ChangeItem(1)
      ShowMenu
      play sound SndMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu < 3 then
    ' a button on a setting changes it too
    ChangeItem(1)
    ShowMenu
    play sound SndMove
    goto tp_loop
  end if
  Ask = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' left (Up = 0) or right (Up = 1) on a title line
sub ChangeItem(u8 Up):
  select case Menu
  case 0
    if Up = 1 then
      if NPlay < 4 then inc NPlay
    else
      if NPlay > 1 then dec NPlay
    end if
  case 1
    GType = 1 - GType
  case 2
    if Up = 1 then
      if TSel < 3 then inc TSel
    else
      if TSel > 0 then dec TSel
    end if
  end select
  return
end sub

sub ShowMenu:
  for J = 9 to 13
    put char 32 at 4,J
  next
  J = Menu + 9
  put char 62 at 4,J
  put char NPlay + 48 at 15,9
  if GType = 0 then
    print at 15,10, "WORDS "
  else
    print at 15,10, "POINTS"
  end if
  V = MinsOf[TSel]
  put char V + 48 at 15,11
  print at 17,11, "MIN"
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 10,1, "SCRAMBLER"
  print at 2,3, "BASED ON SCRAMBLER FROM"
  print at 2,4, "COMPUTE!'S GAZETTE, JULY"
  print at 2,5, "1988 (COMMODORE 64)."
  print at 2,7, "ROLL 13 LETTERS AND MAKE"
  print at 2,8, "WORDS UNTIL TIME RUNS OUT."
  print at 2,9, "1-4 PLAYERS, WORDS OR"
  print at 2,10, "POINTS, 1-7 MINUTES."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: LETTERS IN A JUMBLE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Stage = 1
  Ask = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Ask = 0
  return
end sub

