asm {
ClHush:
    db $00,$00,$F0,$01,$10
ClItem:
    db $00,$00,$06,$01,$00,$00,$55,$01,$00,$00,$A4,$01,$00,$00,$F4,$01,$10
ClBeamA:
    db $40,$F9,$23,$01,$50
ClBeamB:
    db $40,$D5,$23,$01,$50
ClHit:
    db $00,$00,$06,$04,$00,$00,$46,$04,$00,$00,$86,$04,$00,$00,$C6,$04,$10
ClNoDir:
    db $80,$88,$51,$07,$90
ClNoShove:
    db $80,$07,$50,$07,$90
ClNab:
    db $00,$00,$C6,$10,$00,$00,$85,$10,$00,$00,$44,$10,$00,$00,$04,$10,$10

ClSoundTable:
    dw ClHush,$702B
    dw ClItem,$702B
    dw ClBeamA,$7035
    dw ClBeamB,$7035
    dw ClHit,$702B
    dw ClNoDir,$703F
    dw ClNoShove,$703F
    dw ClNab,$702B
    dw ClTuneMel,$703F
    dw ClTuneBass,$7049
; Bargain Hunt, C major (original for this game)
; Tiny Sound, 7 frames per step
ClTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$1F,$01,$23,$01,$26,$01,$23,$01,$24,$01,$21,$01
    db $1E,$01,$1A,$01,$1F,$01,$23,$01,$26,$01,$2B,$01,$2A,$01,$26,$01
    db $28,$01,$01,$01,$28,$01,$24,$01,$21,$01,$24,$01,$26,$01,$23,$01
    db $1F,$01,$23,$01,$21,$01,$1E,$01,$1A,$01,$1E,$01,$1F,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
ClTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$09,$01,$0E,$01
    db $06,$01,$0E,$01,$07,$01,$0E,$01,$0B,$01,$0E,$01,$0C,$01,$10,$01
    db $0C,$01,$01,$01,$09,$01,$10,$01,$09,$01,$10,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$06,$01,$09,$01,$0E,$01,$06,$01,$07,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
ClSong:
    dw $0001
    db $40+9,10
    dw $0000

; ClBack: the backdrop (VDP register 7) to the colour V
ClBack:
    ld a,(AMY_UVAR_V)
    out ($BF),a
    ld a,$87
    out ($BF),a
    ret

; ClCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
ClCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
ClCellDiv:
    or a
    sbc hl,de
    jr c,ClCellRem
    inc b
    jr ClCellDiv
ClCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; ClPeek: Tp = the tile at B
ClPeek:
    call ClCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Tp),a
    ret

; ClPoke: the tile Tl at B
ClPoke:
    call ClCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret
}
