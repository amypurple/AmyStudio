cartridge "CLOSEOUT/L. L. BEH, COMPUTE!/1983"

' CLOSEOUT
' The game by L. L. Beh from COMPUTE!, March 1983 (pages 70-76; first
' written for the Atari, translated for the VIC-20, VIC notes by Charles
' Brannon), for the ColecoVision in Amy by Amy Bienvenu. Ported by Claude
' (an AI made by Anthropic) for Amy Studio, 2026.
'
' Source: Program 2, the VIC-20 version, transcribed in
' orig/closeout-vic.bas from the scan beside it. The Atari version
' (Program 1, orig/closeout-atari.bas) is a different store (player
' graphics, a time limit, a slingshot); it was read for the article only.
'
' The game: a big sale at the department store. Run over the sale items
' (the coloured dots) to pick them up, one point each; climb up and down
' the stairs (stand right on them; get off only on a floor). Three crazed
' shoppers (the spade, the club and the ball) home in on you: one touch
' and you are NABBED. A shove sends a beam along your floor the way you
' walk and every shopper on it back to the top floor (50 points). You
' start with three shoves and get two more with each new store: every 120
' items, a new round in a new store.
'
' Controls (either joystick): the stick is the VIC's I J K M keys (a push
' is a key press: you then keep walking that way until a wall or another
' push), the button is its space bar (the shove). After NABBED the button
' plays again (the VIC's space and RUN); the stick down goes back to the
' credits page. Keypad not used.
'
' The VIC-20's screen (22 columns, 23 rows) is kept cell for cell, at
' columns 5-26 and rows 1-23: CP, NP and B are the VIC's screen offsets
' (from TX), PX PY and EX EY the listing's places. Each VIC character in
' each colour is a tile, so the name table is the VIC's screen and its
' colour memory at once, and the game reads it back as the listing PEEKs.
' Labels such as l380 are the listing's line numbers.
'
' Kept as the listing has them:
' - Line 560 tests PC=EC%(1) (not PK): you can walk onto the club without
'   being nabbed (it is then hidden under you, and drawn again where you
'   leave).
' - A shopper shoved off is not erased from the top floor: it puts a sale
'   item down where it lands (line 960 gives it 46 to put back).
' - A key keeps acting until the next one (B$ stays set): a shove
'   standing still buzzes again every pass until the stick is pushed.
' - The SHOVES count is printed over the old one without erasing it (the
'   VIC prints a number with a cursor right after it), so 10 down to 9
'   would show 90.
'
' Liberties taken:
' - The stick and the button are read as keys into a buffer of ten, as
'   the VIC's keyboard; a push counts when the stick moves to a new
'   direction (or the button is pressed).
' - Timing: a pass of the main loop (your step and one shopper's) is 6
'   frames, about the VIC's BASIC speed; the shove's beam a cell a frame.
' - The border flashes (yellow, purple, and the colours of line 730) are
'   the backdrop's; line 730's screen colours flash the border only.
' - "PRESS SPACE TO REPLAY" reads "PRESS FIRE TO REPLAY". The store is
'   drawn with the screen off (the VIC drew it in view).
' - The shove's bass notes (below the ColecoVision's range) are higher.
' - A credits page with an original tune (Bargain Hunt) played once.
'
' House rules kept: text in columns 2-29; tiles from 128; no sprites; the
' frame loop is protected from the NMI and every screen is drawn with the
' NMI off after a wait.

const TSp0 = 128
const TSp1 = 129
const TSp2 = 130
const TSp3 = 131
const TSp4 = 132
const TSp5 = 133
const TSp6 = 134
const TSp7 = 135
const TDot0 = 136
const TDot1 = 137
const TDot2 = 138
const TDot3 = 139
const TDot4 = 140
const TDot5 = 141
const TDot6 = 142
const TDot7 = 143
const TLad0 = 144
const TLad1 = 145
const TLad2 = 146
const TLad3 = 147
const TLad4 = 148
const TLad5 = 149
const TLad6 = 150
const TLad7 = 151
const TLb0 = 152
const TLb1 = 153
const TLb2 = 154
const TLb3 = 155
const TLb4 = 156
const TLb5 = 157
const TLb6 = 158
const TLb7 = 159
const TFloor = 160
const TPi = 161
const TBang = 162
const TSpade = 163
const TClub = 164
const TBall = 165
const NTiles8 = 304
const SprBytes = 0
const SndHush = 1
const SndItem = 2
const SndBeamA = 3
const SndBeamB = 4
const SndHit = 5
const SndNoDir = 6
const SndNoShove = 7
const SndNab = 8
const SndTuneA = 9
const SndTuneB = 10
const TGd0 = 166
const TCd0 = 176
const TPd0 = 186

' --- the listing's variables ----------------------------------------------
' R the round, PTS the score, SH the shoves, M the items this round, E the
' shopper moving (0-2), Bk B$ (0 none, 1 I up, 2 M down, 3 J left, 4 K
' right, 5 space), Ka A$ (the key GET read)
u8 R = 0
u16 PTS = 0
u8 SH = 1
u8 M = 0
u8 E = 0
u8 Bk = 0
u8 Ka = 0
' you: PX PY, DX DY (255 is -1), PK and CC the character and colour under
' you, CP NP the cells
u8 PX = 2
u8 PY = 17
u8 DX = 0
u8 DY = 0
u8 PK = 32
u8 CC = 0
u16 CP = 0
u16 NP = 0
' the shoppers (EX% EY% EC% EP% PC% DX% DY%) and the one moving (Ex Ey Ec
' Xx Yy Ep Cq: the listing's EX EY EC XX YY EP C)
u8 EXa[3]
u8 EYa[3]
u8 ECa[3]
u8 EPa[3]
u8 PCa[3]
u8 DXa[3]
u8 DYa[3]
u8 Ex = 0
u8 Ey = 0
u8 Ec = 0
u8 Xx = 0
u8 Yy = 0
u8 Ep = 0
u8 Cq = 0
' the shove: SVa (SV%) what the beam covers, LC its character, Ib the cell
u8 SVa[22]
u8 LC = 64
u8 Ib = 0
u8 Ie = 0
u8 Jh = 0
' the store's stairs (SX SY LN)
u8 SX = 0
u8 SY = 0
u8 LN = 0
u8 Lim = 0
u8 Rw8 = 0

' B a VIC offset, Kc Kl the character and colour there (Look reads them,
' Put writes them), Tl Tp the tiles
u16 B = 0
u8 Kc = 0
u8 Kl = 0
u8 Tl = 0
u8 Tp = 0
' Pcol: the colour the VIC prints in (it clears the screen in it)
u8 Pcol = 6
' the keys: Kq the buffer (ten, the VIC's), Kn how many, Kon 1 while they
' are read, Dk the stick (1-4), Dprev Fprev the last stick and button
u8 Kq[10]
u8 Kn = 0
u8 Kon = 0
u8 Dk = 0
u8 Dprev = 0
u8 Fprev = 0
u8 Any = 0
u8 Kv = 0
' for the test bot: Ph 0 credits, 1 the store drawn, 2 playing, 3 nabbed,
' 4 PRESS FIRE; Stp the main loop's passes; Rs0 the generator at RUN
u8 Ph = 0
u8 Stp = 0
u16 Rs0 = 0

u16 NumW = 0
u16 Na = 0
u8 Db = 0
u8 Sb = 0
u8 Dg[6]
u8 Nd = 0
u16 Fi = 0
u16 Src = 0
u16 Dst = 0
u16 W16 = 0
u16 V16 = 0
u8 Fa = 0
u8 Ft = 0
u8 Fc = 0
u8 Fr = 0
u8 V = 0
u8 W = 0
u8 Ia = 0
u8 J8 = 0
u8 K8 = 0
u8 Tick = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rs = $6B35
u16 Rt = 0
u16 Rw = 0
u16 Rv = 0

  tile screen
  set sound table ClSoundTable areas 4
  nmi off
  display off
  ' (the text colour once: it fills the whole colour table)
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  LoadText
  screen on
  nmi off

credits:
  CreditsPage

l100:
  ' RUN: the variables are cleared (130: R, PTS, SH)
  R = 0
  PTS = 0
  SH = 1
  M = 0
  E = 0
  Bk = 0
  CC = 0
  PK = 0
  DX = 0
  DY = 0
  for Ia = 0 to 2
    DYa[Ia] = 0
  next
  Kn = 0
  Kon = 1
  Rs0 = Rs

l140:
  ' 140: the screen cleared, CLOSEOUT (reversed, purple)
  Ph = 1
  GameScreen
  Pcol = 4
  copy SClose count 12 to vram.name + 37
  ' 150: the round (green)
  inc R
  Pcol = 5
  copy SRound count 5 to vram.name + 49
  NumW = R
  Na = 54
  Db = TGd0
  Sb = TSp5
  PutNum
  ' 160: two more shoves
  SH = SH + 2
  ShowShoves
  ' 170
  M = 0
  ' 200: the top floor (row 2), blue
  Kc = 104
  Kl = 6
  for J8 = 0 to 21
    B = J8 + 44
    PutC
  next
  ' 210-250: the floors (rows 4-18) and the sale items above them (rows
  ' 3-17), each item in a colour of 6*RND(O)+2
  Rw8 = 4
l210:
  for J8 = 0 to 21
    B = Rw8 * 22
    B = B + J8
    Kc = 104
    Kl = 6
    PutC
    B = B - 22
    RndK(6)
    Kc = 46
    Kl = lowbyte Rv
    Kl = Kl + 2
    PutC
  next
  Rw8 = Rw8 + 2
  if Rw8 < 19 then goto l210
  ' 260: the stairs at both ends (rows 3-17), black
  Kc = 64
  Kl = 0
  for J8 = 3 to 17
    B = J8 * 22
    PutC
    B = B + 21
    PutC
  next
  ' 270-320: ten stairs at random: column SX (3, 6 ... 21), from row SY
  ' (5, 7 ... 15), LN rows down (2, 4 or 6) but not past row 18
  for Ia = 1 to 10
    RndK(7)
    SX = lowbyte Rv
    SX = SX * 3
    SX = SX + 3
    RndK(6)
    SY = lowbyte Rv
    SY = SY * 2
    SY = SY + 5
l290:
    RndK(3)
    LN = lowbyte Rv
    LN = LN * 2
    LN = LN + 2
    V = SY + LN
    if V > 18 then goto l290
    Lim = V
    Kc = 64
    Kl = 0
    for J8 = SY to Lim
      B = J8 * 22
      B = B + SX
      PutC
    next
  next
  ' 330-360: the shoppers on row 3 (DY% is not reset: a new store keeps
  ' it), each with a sale item of a random colour to put back
  EXa[0] = 1
  EXa[1] = 2
  EXa[2] = 3
  for Ia = 0 to 2
    EYa[Ia] = 3
  next
  ECa[0] = 65
  ECa[1] = 88
  ECa[2] = 81
  DXa[0] = 1
  DXa[1] = 1
  DXa[2] = 255
  for Ia = 0 to 2
    EPa[Ia] = 46
    RndK(6)
    V = lowbyte Rv
    PCa[Ia] = V + 2
  next
  ' 370: you, bottom left
  PX = 2
  PY = 17
  DX = 0
  DY = 0
  PK = 32
  ShowScreen
  Ph = 2
  inc Stp
  Pace(1)

l380:
  ' 380: GET A$ (a key from the buffer); B$ keeps the last one
  GetKey
  if Ka <> 0 then Bk = Ka
  ' 390: the space bar: a shove
  if Bk = 5 then Shove
  ' 400-430: I M J K
  if Bk = 1 then
    DY = 255
    DX = 0
  end if
  if Bk = 2 then
    DY = 1
    DX = 0
  end if
  if Bk = 3 then
    DX = 255
    DY = 0
  end if
  if Bk = 4 then
    DX = 1
    DY = 0
  end if
  ' 440
  CP = PY * 22
  CP = CP + PX
  ' 450: up and down only on the stairs, never into a floor
  if PK <> 64 then
    DY = 0
  else
    B = CP
    if DY = 1 then B = B + 22
    if DY = 255 then B = B - 22
    LookC
    if Kc = 104 then DY = 0
  end if
  ' 460: not sideways into a floor
  B = CP + DX
  if DX = 255 then B = CP - 1
  LookC
  if Kc = 104 then
    DX = 0
    Bk = 0
  end if
  ' 470: what was under you back
  B = CP
  Kc = PK
  Kl = CC
  PutC
  ' 480-500: the step, inside the walls
  PX = PX + DX
  PY = PY + DY
  if PX = 255 then
    PX = 0
    Bk = 0
    DX = 0
  end if
  if PX > 21 then
    PX = 21
    Bk = 0
    DX = 0
  end if
  ' 510-520: what is there
  NP = PY * 22
  NP = NP + PX
  B = NP
  LookC
  CC = Kl
  PK = Kc
  if PK = 46 then goto l530
  if PK = 42 then goto l530
  goto l560
l530:
  ' 530-550: a sale item (one point), 120 make a new store
  inc PTS
  if PK = 42 then PTS = PTS + 49
  ShowScore
  PK = 32
  play sound SndItem
  inc M
  if M = 120 then goto l140
l560:
  ' 560: onto a shopper: nabbed (PC=EC%(1) as printed: never)
  if PK = 65 then goto l730
  if PK = 81 then goto l730
  ' 570: you (pi), red
  B = NP
  Kc = 94
  Kl = 2
  PutC
  ' 580-590: the next shopper
  if E < 2 then
    inc E
  else
    E = 0
  end if
  Ex = EXa[E]
  Ey = EYa[E]
  Ec = ECa[E]
  Xx = DXa[E]
  Yy = DYa[E]
  Ep = EPa[E]
  Cq = PCa[E]
  ' 600-610: what it stood on back
  CP = Ey * 22
  CP = CP + Ex
  B = CP
  Kc = Ep
  Kl = Cq
  PutC
  ' 620: on the stairs (one above or below) it turns up or down toward
  ' you, nine times in ten (RND is drawn every time)
  Rnd16
  Any = 0
  B = CP - 22
  LookC
  if Kc = 64 then Any = 1
  B = CP + 22
  LookC
  if Kc = 64 then Any = 1
  if Any = 1 then
    if Rw > 6553 then
      Xx = 0
      Yy = 0
      if PY > Ey then Yy = 1
      if PY < Ey then Yy = 255
    end if
  end if
  ' 630: a floor ahead, or on your floor (an odd row): sideways toward you
  Any = 0
  B = CP
  if Yy = 1 then B = B + 22
  if Yy = 255 then B = B - 22
  LookC
  if Kc = 104 then Any = 1
  if Ey = PY then
    V = Ey & 1
    if V = 1 then Any = 1
  end if
  if Any = 1 then
    Yy = 0
    Xx = 0
    if PX > Ex then Xx = 1
    if PX < Ex then Xx = 255
  end if
  ' 640-650: the step; it turns back at the ends
  Ex = Ex + Xx
  Ey = Ey + Yy
  if Ex = 0 then Xx = 0 - Xx
  if Ex = 21 then Xx = 0 - Xx
  ' 660: what is there
  NP = Ey * 22
  NP = NP + Ex
  B = NP
  LookC
  Ep = Kc
  Cq = Kl
  ' 670: you: nabbed (a reversed !)
  if Ep = 94 then
    B = NP
    Kc = 161
    Kl = Cq
    PutC
    goto l730
  end if
  ' 675-690: another shopper: it takes what that one stands on
  for Ia = 0 to 2
    if Ep = ECa[Ia] then
      Ep = EPa[Ia]
      Cq = PCa[Ia]
      goto l700
    end if
  next
l700:
  ' 700-710: the shopper there, in its colour (3+E)
  B = NP
  Kc = Ec
  Kl = E + 3
  PutC
  EXa[E] = Ex
  EYa[E] = Ey
  EPa[E] = Ep
  PCa[E] = Cq
  DXa[E] = Xx
  DYa[E] = Yy
  ' 720
  inc Stp
  Pace(6)
  goto l380

l730:
  ' 730: nabbed: the border flashes (the noise rising)
  Ph = 3
  inc Stp
  play sound SndNab
  for Ia = 0 to 63
    V = Ia * 2
    V = V & 7
    V = VicCol[V]
    call asm ClBack
    Frame1
  next
  V = 7
  call asm ClBack
  ' 740-760: NABBED!, PRESS FIRE TO REPLAY
  Pcol = 4
  copy SNab count 11 to vram.name + 37
  copy SPress count 20 to vram.name + 741
  Pcol = 6
  ' 770: the keys pressed before are forgotten
  Kn = 0
  Ph = 4
l780:
  Frame1
  GetKey
  if Ka = 5 then goto l100
  if Ka = 2 then
    Kon = 0
    goto credits
  end if
  goto l780

' Shove (800-910): the beam along your row the way you walk, to the wall;
' every shopper it meets goes back to the top floor
sub Shove:
  ' 810: standing still (or climbing): a buzz, the border yellow
  if DX = 0 then
    V = 11
    call asm ClBack
    play sound SndNoDir
    Pace(7)
    V = 7
    call asm ClBack
    return
  end if
  ' 820: no shoves left: the border purple
  if SH = 0 then
    V = 13
    call asm ClBack
    play sound SndNoShove
    Pace(7)
    V = 7
    call asm ClBack
    return
  end if
  ' 830-870
  CP = PY * 22
  LC = 64
  Bk = 0
  Ie = 0
  if DX = 1 then Ie = 21
  Ib = PX
sh_beam:
  B = CP + Ib
  LookC
  SVa[Ib] = Kc
  Kc = LC
  PutC
  V = LC
  LC = 131 - LC
  if V = 64 then
    play sound SndBeamA
  else
    play sound SndBeamB
  end if
  Frame1
  V = SVa[Ib]
  if V = 65 then ShoveHit
  if V = 88 then ShoveHit
  if V = 81 then ShoveHit
  if Ib <> Ie then
    Ib = Ib + DX
    goto sh_beam
  end if
  ' 880-890: the row as it was
  Ib = PX
sh_back:
  B = CP + Ib
  LookC
  Kc = SVa[Ib]
  PutC
  if Ib <> Ie then
    Ib = Ib + DX
    goto sh_back
  end if
  dec SH
  ShowShoves
  return
end sub

' ShoveHit (920-980): the shopper at Ib goes to row 3, a random column
' (1-20) and way; 50 points
sub ShoveHit:
  for Jh = 0 to 2
    if SVa[Ib] = ECa[Jh] then goto sh_found
  next
  return
sh_found:
  SVa[Ib] = EPa[Jh]
  B = CP + Ib
  LookC
  Kl = PCa[Jh]
  PutC
  RndK(20)
  V = lowbyte Rv
  EXa[Jh] = V + 1
  EYa[Jh] = 3
  DXa[Jh] = 255
  Rnd16
  if Rw > 32768 then DXa[Jh] = 1
  DYa[Jh] = 0
  EPa[Jh] = 46
  PTS = PTS + 50
  play sound SndHit
  Pace(8)
  ShowScore
  return
end sub

' ShowShoves (900): "SHOVES =" and the count (purple), row 22 column 10
sub ShowShoves:
  Pcol = 4
  copy SShov count 8 to vram.name + 751
  NumW = SH
  Na = 759
  Db = TPd0
  Sb = TSp4
  PutNum
  return
end sub

' ShowScore (980): "      SCORE:" and the score (cyan), row 20
sub ShowScore:
  Pcol = 3
  copy SScore count 12 to vram.name + 677
  NumW = PTS
  Na = 689
  Db = TCd0
  Sb = TSp3
  PutNum
  return
end sub

' PutNum: NumW at the name table address Na as the VIC prints a number: a
' space (Sb), the digits (from tile Db); the cursor right after it leaves
' the next cell as it was
sub PutNum:
  vpoke vram.name + Na, Sb
  Nd = 0
  V16 = NumW
pn_div:
  W16 = V16 / 10
  NumW = W16 * 10
  NumW = V16 - NumW
  Dg[Nd] = lowbyte NumW
  inc Nd
  V16 = W16
  if V16 > 0 then goto pn_div
pn_put:
  dec Nd
  inc Na
  V = Dg[Nd] + Db
  vpoke vram.name + Na, V
  if Nd > 0 then goto pn_put
  return
end sub

' Look: Kc Kl, the VIC character and colour at B (PEEK)
sub LookC:
  call asm ClPeek
  if Tp < 128 then
    Kc = Tp
    Kl = 0
    return
  end if
  V = Tp - 128
  Kc = DecCh[V]
  Kl = DecCo[V]
  return
end sub

' Put: the VIC character Kc in the colour Kl at B (POKE)
sub PutC:
  Tl = TSp1
  if Kc = 32 then Tl = TSp0 + Kl
  if Kc = 46 then Tl = TDot0 + Kl
  if Kc = 64 then Tl = TLad0 + Kl
  if Kc = 67 then Tl = TLb0 + Kl
  if Kc = 104 then Tl = TFloor
  if Kc = 94 then Tl = TPi
  if Kc = 161 then Tl = TBang
  if Kc = 65 then Tl = TSpade
  if Kc = 88 then Tl = TClub
  if Kc = 81 then Tl = TBall
  call asm ClPoke
  return
end sub

' GetKey: Ka, the next key of the buffer (0 none)
sub GetKey:
  Ka = 0
  if Kn = 0 then return
  Ka = Kq[0]
  for K8 = 1 to 9
    V = K8 - 1
    Kq[V] = Kq[K8]
  next
  dec Kn
  return
end sub

' ReadKeys (each frame while Kon): a new push of the stick (1 up, 2 down,
' 3 left, 4 right; a diagonal is none) or of the button (5) goes into the
' buffer, as a key press into the VIC's
sub ReadKeys:
  Dk = 0
  Any = 0
  V = joypad(1).up | joypad(2).up
  if V = 1 then
    Dk = 1
    inc Any
  end if
  V = joypad(1).down | joypad(2).down
  if V = 1 then
    Dk = 2
    inc Any
  end if
  V = joypad(1).left | joypad(2).left
  if V = 1 then
    Dk = 3
    inc Any
  end if
  V = joypad(1).right | joypad(2).right
  if V = 1 then
    Dk = 4
    inc Any
  end if
  if Any > 1 then Dk = 0
  if Dk <> 0 then
    if Dk <> Dprev then
      Kv = Dk
      Enq
    end if
  end if
  Dprev = Dk
  V = joypad(1).fire | joypad(2).fire
  if V = 1 then
    if Fprev = 0 then
      Kv = 5
      Enq
    end if
  end if
  Fprev = V
  return
end sub

sub Enq:
  if Kn > 9 then return
  Kq[Kn] = Kv
  inc Kn
  return
end sub

sub CreditsPage:
  Ph = 0
  Kon = 0
  Rearm
  wait
  nmi off
  display off
  V = 1
  call asm ClBack
  cls
  print at 11,2, "CLOSEOUT"
  put char TPi at 9,4
  put char TSpade at 13,4
  put char TClub at 15,4
  put char TBall at 17,4
  put char TFloor at 21,4
  print at 2,6, "BY L. L. BEH, FROM COMPUTE!"
  print at 2,7, "MARCH 1983 (VIC-20 VERSION;"
  print at 2,8, "VIC NOTES BY CHARLES"
  print at 2,9, "BRANNON)."
  print at 2,11, "STICK: WALK AND CLIMB."
  print at 2,12, "BUTTON: SHOVE."
  print at 2,13, "120 SALE ITEMS: A NEW STORE."
  print at 2,16, "COLECOVISION: CLAUDE (AN AI"
  print at 2,17, "BY ANTHROPIC), AMY STUDIO,"
  print at 2,18, "2026. MUSIC: BARGAIN HUNT."
  print at 8,21, "PRESS THE BUTTON"
  screen on
  nmi off
  play song ClSong once
cp_up:
  Frame1
  V = joypad(1).fire | joypad(2).fire
  if V = 1 then goto cp_up
cp_wait:
  Frame1
  V = joypad(1).fire | joypad(2).fire
  if V = 0 then goto cp_wait
  ' the time spent here seeds RND
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $6B35
  stop song
  ' the button still down is not a shove
  Fprev = 1
  Dprev = 0
  return
end sub

' GameScreen (140): the VIC's screen cleared (spaces in the colour it
' prints in) on its cyan border
sub GameScreen:
  Rearm
  wait
  nmi off
  display off
  V = 7
  call asm ClBack
  fill 32 count 768 to vram.name
  V = TSp0 + Pcol
  for J8 = 1 to 23
    fill V count 22 at 5,J8
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' LoadText: the text tiles from the font (FontTab: the character, the
' tile, its colour, 1 reversed), in the three thirds
sub LoadText:
  Fi = 0
lt_next:
  Fa = FontTab[Fi]
  if Fa = 0 then return
  W16 = Fi + 1
  Ft = FontTab[W16]
  inc W16
  Fc = FontTab[W16]
  inc W16
  Fr = FontTab[W16]
  Src = Fa
  Src = Src << 3
  Dst = Ft
  Dst = Dst << 3
  for J8 = 0 to 7
    vpeek vram.pattern + Src into V
    if Fr = 1 then V = V ^ 255
    vpoke vram.pattern + Dst, V
    W16 = Dst + 2048
    vpoke vram.pattern + W16, V
    W16 = Dst + 4096
    vpoke vram.pattern + W16, V
    vpoke vram.color + Dst, Fc
    inc Src
    inc Dst
  next
  Fi = Fi + 4
  goto lt_next
end sub

' Pace N: N frames
sub Pace(u8 Pn):
  for J8 = 1 to Pn
    Frame1
  next
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  if Kon = 1 then ReadKeys
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' RndK: Rv = INT(RND(1) * Rk)
sub RndK(u8 Rk):
  Rnd16
  Uq = Rw
  Uq2 = Rk
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

