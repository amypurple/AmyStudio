  $20,$20,$20,$20,$20,$20,$20,$A1,$A1,$20,$20,$A1,$A1,$20,$20,$20,$A1,$20,$20,$A1,$20,$20,$20,$A1,$A1,$20,$20,$20,$20,$20,$20,$20
