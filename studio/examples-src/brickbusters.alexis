' the four walls, 13 lines each: the colour of each line (0 a gap); from the
' C64's tables at $C526, $C56E, $C5B8, $C5EB
data LayT bytes
  1,2,3,0,0,4,5,6,0,0,0,0,0
  1,2,3,4,0,0,5,6,7,8,0,0,0
  1,2,3,0,0,4,5,6,0,0,7,8,9
  1,2,3,10,11,4,5,6,12,13,7,8,9
end data
' the serve's sixteen directions (the C64's at $CC0F): sideways + 8, upward
data LaunchDx bytes 9,7,10,6,11,5,8,12,4,9,7,9,7,9,7,7
data LaunchDy bytes 2,2,2,2,2,2,2,2,2,2,2,3,3,4,4,4
' sixteenths of a pixel a step for ball speed 0-4
data SpdBase bytes 5,6,7,8,9

