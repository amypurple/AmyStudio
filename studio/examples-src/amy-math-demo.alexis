' 32-bit chain state.
u32 Counter32 = 0, Seed32 = 100000, Addend32 = 12345
' Display and verification state.
u16 RootA = 0, RootB = 0, UtoaValue = 12345
u8 U32Ok = 0, Show3 = 0, Show2 = 0, Show1 = 0, Show0 = 0
bcd digits 6 DecScore

' Amy Math Demo
  text screen
  run_math_demo
  screen on

sub run_math_demo:
  print at 9,0, "AMY MATH DEMO"
  print at 1,4, "SQRT(00144) ="
  print at 1,6, "SQRT(00625) ="
  print at 1,8, "UTOA(12345) ="
  print at 1,11, "U32 CHAIN:"
  print at 1,13, "FINAL BYTES"
  print at 1,15, "B3"
  print at 7,15, "B2"
  print at 14,15, "B1"
  print at 21,15, "B0"
  print at 1,17, "FINAL U32:"
  print at 1,18, "BCD DECIMAL:"
  print at 1,20, "SEED=100000 ADD=12345"
  print at 1,21, "COPY+ADD+INC-SUB =>"

  RootA = sqrt(144)
  RootB = sqrt(625)
  Counter32 = Seed32
  Counter32 += Addend32
  Counter32 += 1
  Counter32 -= Addend32

  Show3 = Counter32[3]
  Show2 = Counter32[2]
  Show1 = Counter32[1]
  Show0 = Counter32[0]

  if Counter32 = 100001 then
    U32Ok = 1
  end if

  clear DecScore
  DecScore += 100000
  DecScore += 2345
  DecScore -= 1000

  print RootA at 17,4 digits 5
  print RootB at 17,6 digits 5
  print UtoaValue at 17,8 digits 5

  if U32Ok then
    print at 11,11, "PASS"
  else
    print at 11,11, "FAIL"
  end if

  print Show3 at 1,16 digits 3
  print Show2 at 7,16 digits 3
  print Show1 at 14,16 digits 3
  print Show0 at 21,16 digits 3
  print Counter32 at 11,17
  print DecScore at 13,18
  print Counter32 at 20,21
  return