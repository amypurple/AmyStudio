u8 C = 0
u16 Cursor = 0
u16 FrameCount = 0

u8 FrameHi = 0
u8 FrameLo = 0
u16 Stars[24]

  text screen
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "FRAME COUNTER"
  print centered at 9, "AND FALLING STARS"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  cls
  init_stars
main_loop:
  FrameCount = frame
  FrameHi = highbyte FrameCount
  FrameLo = lowbyte FrameCount
  print at 2,0, str$(FrameCount)
  print "." at 12,0
  print at 13,0, digits$(FrameCount, 5)
  print "." at 18,0
  print ":" at 22,0
  print at 23,0, width$(FrameCount, 5)
  print ":" at 28,0
  wait
  for C = 0 to 23
    Cursor = Stars[C]
    vpoke vram.name + Cursor, $20
    Cursor += 32
    if Cursor >= 768 then
      Cursor -= 736
    end if
    Stars[C] = Cursor
    vpoke vram.name + Cursor, $2A
  next
  goto main_loop

sub init_stars:
  Stars[0] = 21
  Stars[1] = 62
  Stars[2] = 70
  Stars[3] = 101
  Stars[4] = 146
  Stars[5] = 171
  Stars[6] = 203
  Stars[7] = 229
  Stars[8] = 266
  Stars[9] = 299
  Stars[10] = 331
  Stars[11] = 357
  Stars[12] = 390
  Stars[13] = 418
  Stars[14] = 457
  Stars[15] = 502
  Stars[16] = 518
  Stars[17] = 558
  Stars[18] = 590
  Stars[19] = 628
  Stars[20] = 654
  Stars[21] = 700
  Stars[22] = 735
  Stars[23] = 760
  for C = 0 to 23
    Cursor = Stars[C]
    vpoke vram.name + Cursor, $2A
  next
  return