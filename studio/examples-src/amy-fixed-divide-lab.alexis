fixed A = 0, B = 0, X = 0
u8 Pass = 0
u8 ABytes[2], BBytes[2], XBytes[2]

  text screen
  print at 4,0, "FIXED DIVIDE LAB"
  print at 1,2, "RAW DEC A B R HI LO"

  A = 7.5
  B = 2.5
  X = A
  X /= B
  copy bytes of A to ABytes
  copy bytes of B to BBytes
  copy bytes of X to XBytes
  print ABytes[1] at 1,3 digits 3
  print ABytes[0] at 4,3 digits 3
  print BBytes[1] at 9,3 digits 3
  print BBytes[0] at 13,3 digits 3
  print XBytes[1] at 18,3 digits 3
  print XBytes[0] at 22,3 digits 3
  if X = raw $0300 then
    Pass += 1
    print at 27,3, "PASS"
  else
    print at 27,3, "FAIL"
  end if

  print at 1,5, "0.5/3 FLOOR"
  X = 0.5
  X /= 3.0
  if X = raw $002A then
    Pass += 1
    print at 22,5, "PASS"
  else
    print at 22,5, "FAIL"
  end if

  print at 1,7, "-7.5/2.5"
  X = -7.5
  X /= 2.5
  if X = raw $FD00 then
    Pass += 1
    print at 22,7, "PASS"
  else
    print at 22,7, "FAIL"
  end if

  print at 1,9, "X/1.0"
  X = -2.5
  X /= 1.0
  if X = raw $FD80 then
    Pass += 1
    print at 22,9, "PASS"
  else
    print at 22,9, "FAIL"
  end if

  print at 1,11, "0.5/2.0"
  X = 0.5
  X /= 2.0
  if X = raw $0040 then
    Pass += 1
    print at 22,11, "PASS"
  else
    print at 22,11, "FAIL"
  end if

  print at 1,15, "TOTAL"
  print Pass at 7,15 digits 3
  if Pass = 5 then
    print at 12,15, "PASS"
  else
    print at 12,15, "FAIL"
  end if
  screen on