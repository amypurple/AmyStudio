cartridge "TIME WARP!/AN ORIGINAL TIMELOST GAME/2026"

' TIME WARP!
' An original game for the Timelost series, imagined from "Timelost: A
' Computer Adventure" by Kris Austen Andrews, Arlan Keith Andrews Sr. and
' Joseph C. Giarratano (Que, 1983), pages 12-14: "In an abrupt flash of
' screaming darkness, the unlikely trio find themselves hurled headlong
' into the timeless void-between-the-seconds!" The story and the
' characters belong to the authors; the book has no game for this scene.
'
' The idea: the book promises a game for each effect of the machine, so
' this one adds what the others lack: a view straight into the screen.
' John tumbles down the spiral of the time warp. Erin and Jacque, swept
' away with him, come spinning out of the depths: catch them. Debris from
' Stonehenge (rocks, the stranger's gun handle) and, from the second
' warp, the Warbird come at him too: dodge them, or blast them with
' Jacque's gun before they arrive. Three hits and John is lost in time.
' When the warp meter fills, the past arrives, and the next warp spins
' faster.
' Between warps, an interlude: the trio tumbles out of the sky into a
' forgotten corner of time (the swamp, the edge of the pit, the caverns,
' the river of death, the cave-in), then the warp takes them again. Each
' warp tunnel takes the colors of where it leads: blue, green, red, then
' gold and purple.
'
' ColecoVision game in Amy by Amy Bienvenu, 2026.
' Controls (either joystick): the stick moves John around the tunnel;
' fire shoots down the tunnel.
' How it works: the tunnel is 8 tiles in a spiral (a checker of two
' neighbouring colors each); turning their colors makes the spiral turn
' and rush toward you. Each thing in the warp travels from the heart of
' the tunnel to its own spot in front of John, growing along a
' perspective curve and changing between three sizes. A shot travels
' the other way, shrinking toward the heart, and hits what it meets at
' the same depth.
' Everything that matters stays in columns 2-29, inside the TV overscan.
' The frame loop is protected from the NMI.

const Heart = 137
const BarOn = 138
const BarOff = 139
const MidX = 120                ' sprite X of the tunnel's heart
const MidY = 88
const Erin = 0
const Jacque = 1
const RockT = 2
const GunT = 3
const BirdT = 4

const SndRoar0 = 1
const SndRoar1 = 2
const SndRoar2 = 3
const SndRoar3 = 4
const SndCatch = 5
const SndZap = 6
const SndBoomN = 7
const SndHurtN = 8
const SndHurtT = 9
const SndScream = 10
const SndLost = 11
const SndArriveA = 12
const SndArriveB = 13
const SndOver = 14
const SndGood = 15
const SndPick = 16
const SndTuneA = 17
const SndTuneB = 18

u16 Score = 0
u16 HighScore = 2000
u8 HighName[3]
u8 Lives = 3
u8 Level = 1
u8 Caught = 0
u16 WarpT = 0
u16 WarpLen = 2400
u8 Bars = 0
u8 PX = 120                     ' John's sprite position
u8 PY = 120
u8 JohnF = 0
u8 Hurt = 0
u8 OT[4]                        ' things in the warp: kind (255: none)
i16 ODX[4]                      ' where they arrive, from the heart
i16 ODY[4]
u8 OStep[4]
u8 OAcc[4]
u8 OS[4]
u8 OX[4]
u8 OY[4]
u8 OBoom[4]
u16 OSpd = 180
u8 SpawnT = 0
u8 BeamOn = 0
u8 BmS = 0
i16 BmDX = 0
i16 BmDY = 0
u8 BmX = 0
u8 BmY = 0
u8 RotT = 0
u8 RotDiv = 4
u8 Rot = 0
u16 PalOff = 0
u8 Place = 0
u8 RoarT = 0
u8 Stick = 0
u8 Btn = 0
u8 BtnWas = 0
u8 Up = 0
u8 Dn = 0
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tm = 0
u8 Choice = 1
i16 Sv = 0
i16 Tv = 0
u16 Dst16 = 0
u16 W16 = 0
u16 NumU = 0
u16 Pts = 0

  tile screen
  set sound table WarpSoundTable areas 4
  sprites 16x16
  sprites stable 0 to 0
  sprites flicker on
  copy SpritePat count 672 to vram.spr_pat
  HideSprites
  LoadTiles
  HighName[0] = 84
  HighName[1] = 76
  HighName[2] = 83
  screen on
  EditorialPage

title:
  TitlePage

new_game:
  Score = 0
  Place = 0
  Lives = 3
  Level = 1
  DrawTunnel

new_warp:
  nmi off
  Caught = 0
  WarpT = 0
  Bars = 0
  PX = 120
  PY = 120
  Hurt = 0
  BeamOn = 0
  for G = 0 to 3
    OT[G] = 255
  next
  SpawnT = 60
  ' Faster every warp
  W16 = Level
  W16 *= 30
  OSpd = W16 + 150
  if OSpd > 255 then OSpd = 255
  ' The tunnel takes the color of where it leads
  N = Level - 1
  N &= 3
  W16 = N
  W16 <<= 9
  PalOff = W16
  RotDiv = 5
  if Level >= 2 then RotDiv = 4
  if Level >= 3 then RotDiv = 3
  if Level >= 5 then RotDiv = 2
  ShowStatus
  print at 11,11, "WARP"
  NumU = Level
  print at 16,11, digits$(NumU, 2)
  Rearm
  wait 60 frames
  wait no fire
  nmi off
  RedrawMiddle

main_loop:
  nmi on
  wait
  nmi off
  Spin
  ReadStick
  MoveJohn
  MoveBeam
  MoveThings
  DrawSprites
  if Lives = 0 then goto lost_in_time
  ' The warp meter
  inc WarpT
  W16 = WarpT
  W16 *= 8
  W16 /= WarpLen
  N = W16
  if N <> Bars then
    Bars = N
    ShowBars
  end if
  if WarpT >= WarpLen then goto arrive
  goto main_loop

  ' --- Out of the warp: the past arrives ---
arrive:
  HideSprites
  play sound SndArriveA
  play sound SndArriveB
  print at 5,9, "THE PAST SWIRLS CLOSER..."
  print at 6,12, "FRIENDS CAUGHT"
  NumU = Caught
  print at 21,12, digits$(NumU, 2)
  print at 6,13, "X 100 BONUS"
  W16 = Caught
  W16 *= 100
  Score += W16
  for Tm = 1 to 120
    Spin
    Rearm
    wait
    nmi off
  next
  Interlude
  if Level < 99 then inc Level
  DrawTunnel
  goto new_warp

  ' --- Three hits: lost in time ---
lost_in_time:
  HideSprites
  play sound SndOver
  print at 9,10, "LOST IN TIME"
  for Tm = 1 to 150
    Spin
    Rearm
    wait
    nmi off
  next
  if Score > HighScore then
    HighScore = Score
    print at 8,12, "NEW HIGH SCORE!"
    play sound SndGood
    Rearm
    wait 60 frames
    nmi off
    EnterName
  end if
  ShowStatus
  print at 10,15, "ANOTHER WARP"
  print at 10,16, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 8,15 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

' Between warps: where the trio lands, after the book's chapters (the
' swamp, the pit, the caverns, the prison river, the cave-in)
sub Interlude:
  nmi off
  HideSprites
  cls
  ' This place's colors for the four scene tiles
  W16 = Place
  W16 <<= 5
  Dst16 = 1120
  for J = 0 to 2
    copy SceneCol + W16 count 32 to vram.color + Dst16
    Dst16 += 2048
  next
  for Y = 2 to 15
    fill 140 count 32 at 0,Y
  next
  for Y = 16 to 21
    fill 141 count 32 at 0,Y
  next
  ' Scenery: posts or trunks with crowns or boulders on top
  for I = 0 to 5
    X = I * 5
    X += 3
    put char 143 at X,12
    put char 142 at X,13
    put char 142 at X,14
    put char 142 at X,15
  next
  if Place = 0 then print at 6,0, "THE SWAMP"
  if Place = 1 then print at 6,0, "THE EDGE OF THE PIT"
  if Place = 2 then print at 6,0, "THE CAVERNS OF CARNAGE"
  if Place = 3 then print at 6,0, "THE RIVER OF DEATH"
  if Place = 4 then print at 6,0, "THE CAVE-IN"
  print at 6,1, "A FORGOTTEN CORNER OF TIME"
  ' The three tumble out of the sky and land
  play sound SndScream
  for Tm = 0 to 70
    ' fall with gravity: y = t x t / 8, then rest on the ground
    W16 = Tm
    W16 *= W16
    W16 >>= 3
    if W16 > 112 then W16 = 112
    Y = W16
    Y += 4
    if Tm = 30 then play sound SndHurtN
    N = Tm & 8
    N >>= 1
    if W16 >= 112 then N = 0
    set sprite 0 to Y,104,N,11
    set sprite 2 to Y,128,16,9
    K = Y - 6
    set sprite 3 to K,80,28,7
    update sprites
    Rearm
    wait
    nmi off
  next
  print at 7,22, "WARP AGAIN!"
  play sound SndArriveA
  Rearm
  wait 100 frames
  nmi off
  HideSprites
  inc Place
  if Place >= 5 then Place = 0
  return
end sub

' Re-arm the VDP interrupt before waiting: "nmi on" reads the VDP status,
' so a frame interrupt lost to the guard race cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadStick:
  Stick = 0
  Btn = 0
  Up = 0
  Dn = 0
  if joypad(1).left then Stick = 1
  if joypad(2).left then Stick = 1
  if joypad(1).right then Stick = 2
  if joypad(2).right then Stick = 2
  if joypad(1).up then Up = 1
  if joypad(2).up then Up = 1
  if joypad(1).down then Dn = 1
  if joypad(2).down then Dn = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  return
end sub

' The tunnel turns: the eight spiral tiles pass their colors along
sub Spin:
  inc RotT
  if RotT < RotDiv then return
  RotT = 0
  Rot += 1
  Rot &= 7
  W16 = Rot
  W16 <<= 6
  W16 += PalOff
  Dst16 = 1024
  for J = 0 to 2
    copy ColRot + W16 count 64 to vram.color + Dst16
    Dst16 += 2048
  next
  ' The roar of the warp
  inc RoarT
  if RoarT >= 6 then
    RoarT = 0
    N = Level
    if N > 4 then N = 4
    if N = 1 then play sound SndRoar0
    if N = 2 then play sound SndRoar1
    if N = 3 then play sound SndRoar2
    if N = 4 then play sound SndRoar3
  end if
  return
end sub

sub MoveJohn:
  if Hurt > 0 then dec Hurt
  if Stick = 1 then
    if PX > 32 then PX -= 2
  end if
  if Stick = 2 then
    if PX < 208 then PX += 2
  end if
  if Up = 1 then
    if PY > 20 then PY -= 2
  end if
  if Dn = 1 then
    if PY < 160 then PY += 2
  end if
  inc JohnF
  N = 0
  if Btn = 1 then
    if BtnWas = 0 then N = 1
  end if
  BtnWas = Btn
  if N = 0 then return
  if BeamOn = 1 then return
  ' Jacque's gun fires down the tunnel, from John toward the heart
  BeamOn = 1
  BmS = 255
  Sv = PX
  Sv -= MidX
  BmDX = Sv
  Sv = PY
  Sv -= MidY
  BmDY = Sv
  BmX = PX
  BmY = PY
  play sound SndZap
  return
end sub

sub MoveBeam:
  if BeamOn = 0 then return
  if BmS < 40 then
    BeamOn = 0
    return
  end if
  BmS -= 12
  Sv = BmDX * BmS
  Sv /= 256
  Sv += MidX
  BmX = Sv
  Sv = BmDY * BmS
  Sv /= 256
  Sv += MidY
  BmY = Sv
  ' Whatever is at the same depth and place
  for G = 0 to 3
    if OT[G] < 5 then
      if OBoom[G] = 0 then
        N = OS[G]
        if N > BmS then
          P = N - BmS
        else
          P = BmS - N
        end if
        if P < 30 then
          X = OX[G]
          if X > BmX then
            P = X - BmX
          else
            P = BmX - X
          end if
          if P < 10 then
            Y = OY[G]
            if Y > BmY then
              P = Y - BmY
            else
              P = BmY - Y
            end if
            if P < 10 then
              Blasted
              return
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub Blasted:
  BeamOn = 0
  OBoom[G] = 16
  V = OT[G]
  if V < 2 then
    ' A friend! Lost in the void, and points taken away
    if Score >= 50 then
      Score -= 50
    else
      Score = 0
    end if
    play sound SndLost
  else
    Pts = 25
    if V = BirdT then Pts = 150
    Score += Pts
    play sound SndBoomN
  end if
  ShowStatus
  return
end sub

' Each thing comes out of the heart of the tunnel to its spot in front of John
sub MoveThings:
  ' A new one now and then
  if SpawnT > 0 then
    dec SpawnT
  else
    for G = 0 to 3
      if OT[G] = 255 then goto spawn
    next
  end if
  goto travel
spawn:
  SpawnT = random(15, 45)
  N = random(0, 99)
  V = RockT
  if N < 15 then V = Erin
  if N >= 15 then
    if N < 30 then V = Jacque
  end if
  if N >= 55 then
    if N < 75 then V = GunT
  end if
  if N >= 75 then
    if Level >= 2 then
      V = BirdT
      play sound SndScream
    end if
  end if
  OT[G] = V
  OStep[G] = 0
  OAcc[G] = 0
  OBoom[G] = 0
  ' Its direction and how far out it arrives
  K = random(0, 31)
  P = random(0, 90)
  N = CosT[K]
  Sv = N
  if N >= 128 then Sv -= 256
  Sv = Sv * P
  Sv /= 100
  ODX[G] = Sv
  N = SinT[K]
  Sv = N
  if N >= 128 then Sv -= 256
  Sv = Sv * P
  Sv /= 100
  ' (the tunnel is a little flatter than it is wide)
  Sv *= 3
  Sv /= 4
  ODY[G] = Sv
travel:
  for G = 0 to 3
    if OT[G] < 5 then
      if OBoom[G] > 0 then
        dec OBoom[G]
        if OBoom[G] = 0 then OT[G] = 255
      else
        W16 = OAcc[G]
        W16 += OSpd
        if W16 >= 256 then
          W16 -= 256
          inc OStep[G]
        end if
        OAcc[G] = W16
        N = OStep[G]
        if N >= 64 then
          Arrived
        else
          P = Grow[N]
          OS[G] = P
          Sv = ODX[G] * P
          Sv /= 256
          Sv += MidX
          OX[G] = Sv
          Sv = ODY[G] * P
          Sv /= 256
          Sv += MidY
          OY[G] = Sv
        end if
      end if
    end if
  next
  return
end sub

' It reaches John's plane: caught, hit, or gone past
sub Arrived:
  V = OT[G]
  OT[G] = 255
  X = OX[G]
  if X > PX then
    P = X - PX
  else
    P = PX - X
  end if
  K = 0
  if P < 13 then
    Y = OY[G]
    if Y > PY then
      P = Y - PY
    else
      P = PY - Y
    end if
    if P < 13 then K = 1
  end if
  if V < 2 then
    if K = 1 then
      ' A friend caught
      inc Caught
      Score += 100
      ShowStatus
      play sound SndCatch
    end if
    return
  end if
  if K = 0 then return
  if Hurt > 0 then return
  ' Hit by debris or the Warbird
  dec Lives
  Hurt = 60
  ShowStatus
  play sound SndHurtN
  play sound SndHurtT
  return
end sub

sub DrawSprites:
  P = JohnF & 16
  P >>= 2
  K = 11
  if Hurt > 0 then
    N = Hurt & 4
    if N = 0 then K = 8
  end if
  set sprite 0 to PY,PX,P,K
  if BeamOn = 1 then
    P = 68
    if BmS < 128 then P = 72
    set sprite 1 to BmY,BmX,P,15
  else
    set sprite 1 to 192,0,0,0
  end if
  for G = 0 to 3
    J = G + 2
    V = OT[G]
    if V < 5 then
      X = OX[G]
      Y = OY[G]
      if OBoom[G] > 0 then
        N = OBoom[G] & 4
        P = 76
        if N = 0 then P = 80
        set sprite J to Y,X,P,11
      else
        ' Three sizes, by how near it has come
        N = OS[G]
        P = V * 12
        P += 8
        if N >= 96 then P += 4
        if N >= 176 then P += 4
        K = 9
        if V = Jacque then K = 7
        if V = RockT then K = 14
        if V = GunT then K = 10
        if V = BirdT then K = 11
        set sprite J to Y,X,P,K
      end if
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' The spiral tunnel, from the map worked out in art.py
sub DrawTunnel:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  backdrop black
  RedrawMiddle
  fill 32 count 32 at 0,0
  fill 32 count 32 at 0,23
  ShowStatus
  return
end sub

' Rows 1-22 of the tunnel (also to wipe messages)
sub RedrawMiddle:
  Dst16 = 32
  for Y = 1 to 22
    copy RingMap + Dst16 count 32 to vram.name + Dst16
    Dst16 += 32
  next
  return
end sub

sub ShowStatus:
  print at 2,0, "SCORE"
  NumU = Score
  print at 8,0, digits$(NumU, 5)
  print at 15,0, "WARP"
  ShowBars
  print at 2,23, "LIVES"
  for J = 0 to 2
    X = J + 8
    N = 32
    if J < Lives then N = Heart
    put char N at X,23
  next
  print at 12,23, "FRIENDS"
  NumU = Caught
  print at 20,23, digits$(NumU, 2)
  print at 23,23, "HI"
  NumU = HighScore
  print at 26,23, digits$(NumU, 5)
  return
end sub

sub ShowBars:
  for J = 0 to 7
    X = J + 20
    N = BarOff
    if J < Bars then N = BarOn
    put char N at X,0
  next
  return
end sub

sub EnterName:
  print at 6,13, "YOUR INITIALS:"
  print at 5,16, "UP/DOWN, FIRE: NEXT"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,13
  next
  X = I + 21
  fill 32 count 3 at 21,14
  put char 45 at X,14
  Rearm
  wait 8 frames
  nmi off
  ReadStick
  if Btn = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then goto name_done
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  if Dn = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
name_done:
  RedrawMiddle
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 128 to vram.pattern + Dst16
    copy TileCol count 128 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub TitlePage:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  backdrop black
  RedrawMiddle
  fill 32 count 32 at 0,0
  fill 32 count 32 at 0,23
  fill 32 count 22 at 5,3
  print at 10,3, "T I M E   W A R P !"
  fill 32 count 26 at 3,15
  fill 32 count 26 at 3,16
  fill 32 count 26 at 3,17
  fill 32 count 26 at 3,18
  fill 32 count 26 at 3,19
  print at 4,15, "STICK: MOVE JOHN"
  print at 4,16, "FIRE: JACQUE'S GUN"
  print at 4,17, "CATCH ERIN AND JACQUE,"
  print at 4,18, "DODGE OR BLAST THE REST."
  print at 4,19, "HIGH"
  NumU = HighScore
  print at 9,19, digits$(NumU, 5)
  for J = 0 to 2
    X = J + 15
    N = HighName[J]
    put char N at X,19
  next
  fill 32 count 20 at 6,21
  print at 7,21, "PRESS FIRE TO WARP"
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
title_spin:
  Spin
  Rearm
  wait
  nmi off
  if joypad(1).fire then goto title_go
  if joypad(2).fire then goto title_go
  goto title_spin
title_go:
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  return
end sub

sub EditorialPage:
  nmi off
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  backdrop white
  cls
  print at 11,1, "TIME WARP!"
  print at 2,3, "AN ORIGINAL GAME FOR THE"
  print at 2,4, "TIMELOST SERIES BY KRIS"
  print at 2,5, "AUSTEN ANDREWS, ARLAN KEITH"
  print at 2,6, "ANDREWS SR. AND JOSEPH C."
  print at 2,7, "GIARRATANO (QUE, 1983)."
  print at 2,9, "PAGE 13: HURLED HEADLONG"
  print at 2,10, "INTO THE TIMELESS VOID-"
  print at 2,11, "BETWEEN-THE-SECONDS."
  print at 2,13, "THE BOOK HAS NO GAME FOR"
  print at 2,14, "THIS SCENE: HERE IS ONE,"
  print at 2,15, "SEEN STRAIGHT INTO THE"
  print at 2,16, "SCREEN. BY AMY BIENVENU,"
  print at 2,17, "2026."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' Tunnel tiles 128-136, heart 137, meter 138-139
data TilePat bytes
  $AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55
  $AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55
  $AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55
  $AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55,$AA,$55
  $00,$00,$00,$00,$00,$00,$00,$00,$6C,$FE,$FE,$7C,$38,$10,$00,$00
  $00,$7E,$7E,$7E,$7E,$7E,$7E,$00,$00,$7E,$42,$42,$42,$42,$7E,$00
  $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$91,$4A,$00,$22,$54,$00,$88,$42
  $18,$3C,$3C,$18,$18,$18,$3C,$7E,$3C,$7E,$FF,$FF,$7E,$24,$00,$00
end data
data TileCol bytes
  $14,$14,$14,$14,$14,$14,$14,$14,$45,$45,$45,$45,$45,$45,$45,$45
