  $E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E
  $6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6
  $E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6,$6E,$6E,$06
  $06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6,$6E,$6E
  $6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6,$6E
  $6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$6E,$6E,$E6,$6E,$E6
  $E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E,$6E,$E6,$6E
  $6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E,$6E,$E6
  $E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E,$6E
  $6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$E6,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$E6,$6E,$E6,$6E,$6E,$6E,$6E,$06,$6E
end data
data TitleMap bytes
  32,32,32,32,32,32,32,32,32,32,32,137,32,137,32,137,137,137,32,137,137,137,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,137,32,137,32,137,32,32,32,137,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,137,32,137,32,137,137,32,32,137,137,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,137,32,137,32,137,32,32,32,137,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,137,32,32,137,137,137,32,137,137,137,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,137,32,137,32,137,32,32,32,137,137,137,32,137,137,32,32,137,137,137,32,137,137,137,32,32,32,32
  32,32,32,32,32,137,32,137,32,137,32,32,32,137,32,137,32,137,32,137,32,137,32,137,32,137,32,32,32,32,32,32
  32,32,32,32,32,137,137,32,32,137,32,32,32,137,32,137,32,137,137,32,32,137,32,137,32,137,137,137,32,32,32,32
  32,32,32,32,32,137,32,137,32,137,32,32,32,137,32,137,32,137,32,137,32,137,32,137,32,32,32,137,32,32,32,32
  32,32,32,32,32,137,32,137,32,137,137,137,32,137,137,137,32,137,32,137,32,137,137,137,32,137,137,137,32,32,32,32
end data

' a flying saucer
record Foe:
  u8 X
  u8 Y
  u8 Rt
  u8 Dn
  u8 Kind
  u8 Boom
end record

' a ground target: Y is its sprite y + 16 (0..199), St 0 standing,
' 1 burning, 2 a crater; Dly frames of scrolling before it comes back
record Gnd:
  u8 X
  u8 Y
  u8 Kind
  u8 St
  u8 Boom
  u8 Dly
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Va = 0
u16 Miles = 0
bcd digits 6 Score
bcd digits 6 Hi
Foe F[2]
Gnd G[2]
u8 Ter = 0
u8 StartTer = 0
u8 Stage = 1
u8 Ships = 3
u8 Flags = 0
u8 Over = 0
u8 Px = 92
u8 Py = 160
u8 SiY = 80
u8 ShotOn = 0
u8 Sx = 0
u8 Sy = 0
u8 EsOn = 0
u8 Ex = 0
u8 Ey = 0
u8 Edx = 1
u8 Edy = 2
u8 ESpd = 1
u8 Bomb = 0
u8 BombG = 0
u8 BombX = 0
u8 BombY = 0
u8 Dead = 0
u8 Safe = 0
u8 Ofs = 0
u8 ScrC = 0
u8 ScrD = 0
u8 MileC = 0
u8 Spin = 0
u8 Hits = 0
u8 Bombed = 0
u8 Lost = 0
' input
u8 J = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Gi = 0
u8 Ti = 0
u8 Hi8 = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table VkSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count 12
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Hi = 0
  CreditsPage

title:
  TitlePage
  NewGame
  PlayGame
  ' the end: GAME OVER over the playfield, then back to the title
  HideSprites
  print at 6,10, "           "
  print at 6,11, " GAME OVER "
  print at 6,12, "           "
  ShowHigh
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the game

sub NewGame:
  Score = 0
  Ships = 3
  Stage = 1
  Ter = StartTer
  Flags = 0
  Over = 0
  Hits = 0
  Bombed = 0
  Lost = 0
  return
end sub

sub PlayGame:
  DrawField
  Ofs = 0
  ScrC = 0
  ScrD = 1
  InitFoes
  InitGround
  ResetShip
  NewTerrain
  ShowShips
  DrawTex
  DrawSprites
  ShowScreen
pg_loop:
  Frame1
  if ScrD = 1 then DrawTex
  DrawSprites
  ReadPads
  PlayStep
  if Over = 0 then goto pg_loop
  return
end sub

sub PlayStep:
  ScrollStep
  if Dead > 0 then
    DeadStep
  else
    MoveShip
    FireCheck
  end if
  MoveShot
  MoveBomb
  MoveFoes
  MoveEShot
  if Dead = 0 then
    if Safe > 0 then
      dec Safe
    else
      HitShip
    end if
  end if
  MilesStep
  inc Spin
  return
end sub

sub InitFoes:
  F[0].X = 40
  F[0].Y = 40
  F[0].Rt = 1
  F[0].Dn = 1
  F[0].Boom = 0
  F[1].X = 140
  F[1].Y = 24
  F[1].Rt = 0
  F[1].Dn = 1
  F[1].Boom = 0
  EsOn = 0
  return
end sub

sub InitGround:
  G[0].X = 120
  G[0].Y = 16
  G[0].Kind = 0
  G[0].St = 0
  G[0].Dly = 0
  G[1].X = 48
  G[1].Y = 120
  G[1].Kind = 1
  G[1].St = 0
  G[1].Dly = 0
  return
end sub

sub ResetShip:
  Px = 92
  Py = 160
  ShotOn = 0
  Bomb = 0
  Dead = 0
  return
end sub

' a new terrain: its name, its flag, the second saucer's kind, the stage's
' enemy shot speed
sub NewTerrain:
  PrintTer(Ter, 24, 4)
  T = 1 << Ter
  Flags = Flags | T
  ShowFlags
  F[0].Kind = 0
  F[1].Kind = FoeBKind[Ter]
  ESpd = Stage - 1
  if ESpd < 1 then ESpd = 1
  if ESpd > 3 then ESpd = 3
  Miles = 0
  MileC = 0
  ShowMiles
  ShowHigh
  return
end sub

' the ground moves down a pixel every second frame, the targets with it
sub ScrollStep:
  inc ScrC
  if (ScrC & 1) = 0 then
    Ofs = (Ofs + 1) & 15
    ScrD = 1
    for Gi = 0 to 1
      MoveGnd(Gi)
    next
  end if
  for Gi = 0 to 1
    if G[Gi].St = 1 then
      dec G[Gi].Boom
      if G[Gi].Boom = 0 then G[Gi].St = 2
    end if
  next
  return
end sub

sub MoveGnd(u8 I):
  if G[I].Dly > 0 then
    dec G[I].Dly
    if G[I].Dly = 0 then
      Rand
      G[I].Y = 0
      G[I].X = XMin + Rs % 150
      G[I].Kind = (Rs >> 8) & 1
      G[I].St = 0
    end if
    return
  end if
  inc G[I].Y
  if G[I].Y >= 200 then
    Rand
    G[I].Dly = (Rs & 63) + 1
    G[I].Y = 200
  end if
  return
end sub

sub MoveShip:
  if (J & 4) <> 0 then
    if Px > XMin then dec Px
  end if
  if (J & 8) <> 0 then
    if Px < XMax then inc Px
  end if
  if (J & 1) <> 0 then
    if Py > YMin then dec Py
  end if
  if (J & 2) <> 0 then
    if Py < YMax then inc Py
  end if
  SiY = SightOf(Py)
  return
end sub

function SightOf(u8 Yy) as u8
  if Yy < YMin + SightUp then return YMin
  return Yy - SightUp

' the button: a bomb when the sight is over a standing target, else a shot
sub FireCheck:
  if (J & 16) = 0 then return
  if ShotOn = 1 then return
  if Bomb > 0 then return
  K = TargetUnder()
  if K < 2 then
    Bomb = BombT
    BombG = K
    BombX = Px
    BombY = Py
    play sound SndDrop
    return
  end if
  ShotOn = 1
  Sx = Px
  Sy = Py - 8
  play sound SndShot
  return
end sub

' the ground target under the sight (2: none)
function TargetUnder as u8
  for Gi = 0 to 1
    if G[Gi].St = 0 and G[Gi].Dly = 0 then
      if G[Gi].Y >= 16 + YMin then
        Y = G[Gi].Y - 16
        if absdiff(G[Gi].X, Px) < 10 and absdiff(Y, SiY) < 10 then return Gi
      end if
    end if
  next
  return 2

sub MoveShot:
  if ShotOn = 0 then return
  if Sy < YMin + ShotSpd then
    ShotOn = 0
    return
  end if
  Sy = Sy - ShotSpd
  for Fi = 0 to 1
    if F[Fi].Boom = 0 then
      if absdiff(F[Fi].X, Sx) < 10 and absdiff(F[Fi].Y, Sy) < 12 then
        ShotOn = 0
        F[Fi].Boom = 32
        inc Hits
        AddPoints(1)
        play sound SndPop
        return
      end if
    end if
  next
  return
end sub

' the bomb falls from where it was dropped to its target in BombT frames
sub MoveBomb:
  if Bomb = 0 then return
  dec Bomb
  if Bomb > 0 then return
  if G[BombG].St = 0 and G[BombG].Dly = 0 then
    G[BombG].St = 1
    G[BombG].Boom = 40
    inc Bombed
    AddPoints(5)
    play sound SndBlast
  end if
  return
end sub

' Ten x the stage points, Tens times: BCD adds of a literal
sub AddPoints(u8 Tens):
  for Ti = 1 to Stage
    for Hi8 = 1 to Tens
      Score += 10
    next
  next
  ShowScore
  return
end sub

' the saucers: a pixel a frame on both axes, bouncing off the sides
sub MoveFoes:
  for Fi = 0 to 1
    if F[Fi].Boom > 0 then
      dec F[Fi].Boom
      if F[Fi].Boom = 0 then
        F[Fi].Y = YMin
        F[Fi].Dn = 1
      end if
    else
      X = F[Fi].X
      Y = F[Fi].Y
      if F[Fi].Rt = 1 then
        inc X
        if X >= XMax then F[Fi].Rt = 0
      else
        dec X
        if X <= XMin then F[Fi].Rt = 1
      end if
      if F[Fi].Dn = 1 then
        inc Y
        if Y >= YMax then F[Fi].Dn = 0
      else
        dec Y
        if Y <= YMin then F[Fi].Dn = 1
      end if
      F[Fi].X = X
      F[Fi].Y = Y
    end if
  next
  return
end sub

' one enemy shot at a time, from a saucer picked at random, aimed in one
' of eight directions; gone at the edge
sub MoveEShot:
  if EsOn = 0 then
    if Dead = 0 then NewEShot
    return
  end if
  if Edx = 0 then
    if Ex < XMin + ESpd then
      EsOn = 0
      return
    end if
    Ex = Ex - ESpd
  end if
  if Edx = 2 then
    if Ex > XMax - ESpd then
      EsOn = 0
      return
    end if
    Ex = Ex + ESpd
  end if
  if Edy = 0 then
    if Ey < YMin + ESpd then
      EsOn = 0
      return
    end if
    Ey = Ey - ESpd
  end if
  if Edy = 2 then
    if Ey > YMax - ESpd then
      EsOn = 0
      return
    end if
    Ey = Ey + ESpd
  end if
  return
end sub

sub NewEShot:
  Rand
  K = Rs & 1
  if F[K].Boom > 0 then K = K ^ 1
  if F[K].Boom > 0 then return
  Ex = F[K].X
  Ey = F[K].Y
  Edx = Sign3(Px, Ex)
  Edy = Sign3(Py, Ey)
  if Edx = 1 and Edy = 1 then Edy = 2
  EsOn = 1
  return
end sub

' 0 when A < B, 1 when equal, 2 when A > B
function Sign3(u8 A, u8 B) as u8
  if A < B then return 0
  if A > B then return 2
  return 1

sub HitShip:
  for Fi = 0 to 1
    if F[Fi].Boom = 0 then
      if absdiff(F[Fi].X, Px) < 11 and absdiff(F[Fi].Y, Py) < 11 then
        ShipLost
        return
      end if
    end if
  next
  if EsOn = 1 then
    if absdiff(Ex, Px) < 7 and absdiff(Ey, Py) < 7 then ShipLost
  end if
  return
end sub

sub ShipLost:
  Dead = DeadT
  EsOn = 0
  ShotOn = 0
  inc Lost
  play sound SndLost
  play sound SndLostb
  return
end sub

sub DeadStep:
  dec Dead
  if Dead > 0 then return
  dec Ships
  ShowShips
  if Ships = 0 then
    Over = 1
    return
  end if
  ResetShip
  SiY = SightOf(Py)
  Safe = SafeT
  return
end sub

sub MilesStep:
  inc MileC
  if MileC < 16 then return
  MileC = 0
  inc Miles
  if Miles >= MilesLev then
    Ter = Ter + 1
    if Ter > 4 then Ter = 0
    if Stage < 99 then inc Stage
    play sound SndLand
    NewTerrain
    return
  end if
  ShowMiles
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' input

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  J = Pads
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' ---------------------------------------------------------------------------
' drawing

' the ground's four tiles for this terrain at this pixel offset
sub DrawTex:
  ScrD = 0
  Va = Ter * 512
  W16 = Ofs * 32
  Va = Va + W16
  copy TexPat + Va count 32 to vram.pattern + 1024
  copy TexPat + Va count 32 to vram.pattern + 3072
  copy TexPat + Va count 32 to vram.pattern + 5120
  copy TexCol + Va count 32 to vram.color + 1024
  return
end sub

' sprites: 0-1 the fighter, 2 the sight, 3 the shot, 4 the enemy shot,
' 5-6 the saucers, 7 the bomb, 8-11 the ground targets
sub DrawSprites:
  if Dead > 0 then
    N = (DeadT - Dead) >> 4
    set sprite 0 to Py,Px,BoomSpr[N],BoomCol[N]
    set sprite 1 to 207,0,0,0
    set sprite 2 to 207,0,0,0
  else
    V = Safe % 24
    if Safe > 0 and V >= 12 then
      set sprite 0 to 207,0,0,0
      set sprite 1 to 207,0,0,0
    else
      set sprite 0 to Py,Px,SCanopy,9
      set sprite 1 to Py,Px,SShip,15
    end if
    set sprite 2 to SiY,Px,SSight,SightCol[Ter]
  end if
  if ShotOn = 1 then
    set sprite 3 to Sy,Sx,SShot,ShotCol[Ter]
  else
    set sprite 3 to 207,0,0,0
  end if
  if EsOn = 1 then
    set sprite 4 to Ey,Ex,SEshot,9
  else
    set sprite 4 to 207,0,0,0
  end if
  DrawFoe(0)
  DrawFoe(1)
  DrawBomb
  DrawGnd(0)
  DrawGnd(1)
  update sprites
  return
end sub

sub DrawFoe(u8 I):
  u8 Sp = 0
  u8 Cl = 0
  u8 Bm = 0
  Bm = F[I].Boom
  if Bm > 0 then
    N = (32 - Bm) >> 3
    set sprite 5 + I to F[I].Y,F[I].X,BoomSpr[N],BoomCol[N]
    return
  end if
  select case F[I].Kind
  case 1
    Sp = SFly0 + ((Spin >> 3) & 1) * 4
  case 2
    Sp = SOrb0 + ((Spin >> 4) & 1) * 4
  case else
    N = (Spin >> 3) % 6
    Sp = DiscSpr[N]
  end select
  Cl = 13
  if I = 1 then Cl = FoeBCol[Ter]
  set sprite 5 + I to F[I].Y,F[I].X,Sp,Cl
  return
end sub

sub DrawBomb:
  i16 By = 0
  i16 Dy = 0
  if Bomb = 0 then
    set sprite 7 to 207,0,0,0
    return
  end if
  ' from the drop point to the target's place now
  Y = G[BombG].Y - 16
  By = BombY
  Dy = Y
  Dy = Dy - By
  Dy = Dy * (BombT - Bomb)
  By = By + Dy / BombT
  Y = By
  set sprite 7 to Y,BombX,SBomb,1
  return
end sub

sub DrawGnd(u8 I):
  u8 Sy2 = 0
  u8 Gx = 0
  Sy2 = 8 + I * 2
  if G[I].Dly > 0 then
    set sprite Sy2 to 207,0,0,0
    set sprite Sy2 + 1 to 207,0,0,0
    return
  end if
  Y = G[I].Y - 16
  Gx = G[I].X
  select case G[I].St
  case 0
    if G[I].Kind = 0 then
      set sprite Sy2 to Y,Gx,SDomel,8
      set sprite Sy2 + 1 to Y,Gx,SDome,DomeCol[Ter]
    else
      set sprite Sy2 to Y,Gx,STurl,15
      set sprite Sy2 + 1 to Y,Gx,STur,TurCol[Ter]
    end if
  case 1
    N = (40 - G[I].Boom) / 10
    set sprite Sy2 to Y,Gx,BoomSpr[N],BoomCol[N]
    set sprite Sy2 + 1 to Y,Gx,SCrater,1
  case else
    set sprite Sy2 to 207,0,0,0
    set sprite Sy2 + 1 to Y,Gx,SCrater,1
  end select
  return
end sub

' the playfield (the ground's four tiles over columns 0-22), the wall,
' the panel
sub DrawField:
  NewScreen
  for Ti = 0 to 23
    T = TGtl
    if (Ti & 1) = 1 then T = TGbl
    for Hi8 = 0 to 22
      put char T + (Hi8 & 1) at Hi8,Ti
    next
    put char TWall at 23,Ti
  next
  print at 24,1, "VEE"
  print at 24,2, "KLOROS"
  fill TRule count 6 at 24,3
  fill TRule count 6 at 24,5
  print at 24,6, "SCORE"
  print at 24,9, "HIGH"
  print at 24,12, "SHIPS"
  print at 24,15, "FLAGS"
  print at 24,19, "MILES"
  fill TRule count 6 at 24,22
  ShowScore
  return
end sub

sub ShowScore:
  print Score at 24,7
  return
end sub

sub ShowHigh:
  if Score > Hi then Hi = Score
  print Hi at 24,10
  return
end sub

sub ShowShips:
  for Ti = 0 to 2
    if Ti < Ships then
      put char TShip at 24 + Ti * 2,13
    else
      put char 32 at 24 + Ti * 2,13
    end if
  next
  return
end sub

' five flags: three on row 16, two on row 17
sub ShowFlags:
  for Ti = 0 to 4
    X = 24 + Ti * 2
    Y = 16
    if Ti > 2 then
      X = X - 5
      Y = 17
    end if
    T = 1 << Ti
    if (Flags & T) <> 0 then
      put char TFlag at X,Y
    else
      put char TFlagoff at X,Y
    end if
  next
  return
end sub

sub ShowMiles:
  print at 24,20, digits$(Miles, 3)
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  for K = 0 to 11
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: VEE KLOROS in blocks over a starfield, the starting terrain
' chosen with the stick, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 64
  for Ti = 0 to 23
    Rand
    X = Rs & 31
    Y = (Rs >> 8) % 24
    if Y < 2 or Y > 12 then put char TStar at X,Y
  next
  print at 4,15, "APPROACHING V-KLS,"
  print at 6,16, "THE MYSTERY PLANET"
  print at 6,19, "START"
  print at 4,22, "BUTTON: FLY THE MISSION"
  ShowStart
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 612
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 4) <> 0 then
    if StartTer = 0 then StartTer = 4 else dec StartTer
    play sound SndPick
    ShowStart
  end if
  if (N & 8) <> 0 then
    if StartTer = 4 then StartTer = 0 else inc StartTer
    play sound SndPick
    ShowStart
  end if
  if (N & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowStart:
  print at 13,19, "<"
  PrintTer(StartTer, 15, 19)
  print at 22,19, ">"
  return
end sub

' a terrain's name, six letters
sub PrintTer(u8 Tn, u8 Col, u8 Row):
  select case Tn
  case 0
    print at Col,Row, "OCEANS"
  case 1
    print at Col,Row, "DESERT"
  case 2
    print at Col,Row, "JUNGLE"
  case 3
    print at Col,Row, "CITY 1"
  case else
    print at Col,Row, "CITY 2"
  end select
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "VEE KLOROS"
  print at 2,5, "BASED ON VEE KLOROS BY"
  print at 2,6, "CLEVE BLAKEMORE, AHOY!"
  print at 2,7, "MARCH 1988 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: MYSTERY PLANET"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

