cartridge "RECORD SAFETY/AMY STUDIO/2026"

record TestActor:
  u8 Direction
  u8 X
  u8 Y
  u8 HomeX
  u8 HomeY
  u8 HiddenTile
  u8 Vulnerable
  u8 MoveTimer
  u8 Immune
  u8 State
  u8 EyeX
  u8 EyeY
  u8 EyeTimer
end record

TestActor Actors[4]
u8 I = 0
u8 Sum = 0
u8 PassCount = 0
u8 FailCount = 0

data InitialActors records TestActor
  1,10,20,11,21,32,0,3,0,1,80,81,2
  2,30,40,31,41,33,1,4,0,2,82,83,3
  4,50,60,51,61,34,0,5,1,3,84,85,4
  8,70,80,71,81,35,1,6,0,0,86,87,5
end data

sub MutateActor(ref TestActor Actor):
  Actor.X += 2
  Actor.Y += 3
  Actor.HiddenTile = 44
  Actor.Vulnerable = 1
  Actor.State = 2
end sub

text screen
print centered at 2, "RECORD ARRAY SELFTEST"
print at 2,5, "COPY / INDEX / REF"
print at 2,6, "FOR EACH / MUTATION"
print at 2,8, "EXPECTED 25 PASS / 00 FAIL"
print at 2,10, "RUNNING..."
screen on

copy InitialActors to Actors

if Actors[0].X = 10 then PassCount += 1 else FailCount += 1
if Actors[1].Direction = 2 then PassCount += 1 else FailCount += 1
if Actors[2].HomeY = 61 then PassCount += 1 else FailCount += 1
if Actors[3].EyeTimer = 5 then PassCount += 1 else FailCount += 1
if Actors[1].Vulnerable = 1 then PassCount += 1 else FailCount += 1
if Actors[2].Immune = 1 then PassCount += 1 else FailCount += 1

MutateActor(Actors[2])
if Actors[2].X = 52 then PassCount += 1 else FailCount += 1
if Actors[2].Y = 63 then PassCount += 1 else FailCount += 1
if Actors[2].HiddenTile = 44 then PassCount += 1 else FailCount += 1
if Actors[2].Vulnerable = 1 then PassCount += 1 else FailCount += 1
if Actors[2].State = 2 then PassCount += 1 else FailCount += 1

Sum = 0
for I = 0 to 3
  Sum += Actors[I].Direction
  Actors[I].MoveTimer += 1
next
if Sum = 15 then PassCount += 1 else FailCount += 1
if Actors[0].MoveTimer = 4 then PassCount += 1 else FailCount += 1
if Actors[1].MoveTimer = 5 then PassCount += 1 else FailCount += 1
if Actors[2].MoveTimer = 6 then PassCount += 1 else FailCount += 1
if Actors[3].MoveTimer = 7 then PassCount += 1 else FailCount += 1

Actors[I - 1].EyeX = 99
if Actors[3].EyeX = 99 then PassCount += 1 else FailCount += 1
if Actors[0].EyeX = 80 then PassCount += 1 else FailCount += 1

I = 1
with Actors[I] as Actor
  I = 3
  Actor.HomeX = 90
  Actor.HomeY = 91
end with
if Actors[1].HomeX = 90 then PassCount += 1 else FailCount += 1
if Actors[1].HomeY = 91 then PassCount += 1 else FailCount += 1
if Actors[3].HomeX = 71 then PassCount += 1 else FailCount += 1

with Actors[0] as Actor
  MutateActor(Actor)
end with
if Actors[0].X = 12 then PassCount += 1 else FailCount += 1
if Actors[0].Y = 23 then PassCount += 1 else FailCount += 1
if Actors[0].HiddenTile = 44 then PassCount += 1 else FailCount += 1

with Actors[0] as Left
  with Actors[3] as Right
    Left.EyeY = Right.EyeY
  end with
end with
if Actors[0].EyeY = 87 then PassCount += 1 else FailCount += 1

print at 2,14, "ACTUAL PASS"
print PassCount at 19,14 digits 2
print at 2,15, "ACTUAL FAIL"
print FailCount at 19,15 digits 2
if PassCount = 25 and FailCount = 0 then
  print centered at 18, "PASS - RECORDS SAFE"
else
  print centered at 18, "FAIL - CHECK RECORDS"
end if

record_array_safety_done:
loop forever

