cartridge "PUDDING MOUNTAIN MINER/GAZETTE/1985"

' PUDDING MOUNTAIN MINER
' A ColecoVision game based on "Pudding Mountain Miner", a 17-line BASIC
' program in the Horizons column of COMPUTE!'s Gazette, April 1985 (one
' listing for the Commodore 64 and VIC-20; no author named in the listing).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: a miner's airship crosses the sky from left to right, over
' and over, at a new height each pass. Below lies Pudding Mountain:
' columns of pudding 4 to 10 cells high on a bedrock floor, with one green
' target in the bedrock. Press the button to drop a bomb from under the
' ship. A bomb falls until it hits the pudding and blows away that one
' cell; dig a shaft down to the target and drop a bomb through it. A bomb
' that reaches the bedrock anywhere else is a miss.
'
' From the original (orig/horizons.bas, the C64 path): the field (columns
' of random height 4-10 on a solid floor row, the target at a random
' column away from the edges), the ship flying left to right and starting
' again from the left at a random height (rows 1-4 below the top), a
' bomb dropped from under the ship's middle, the ship halting while its
' bomb falls, one cell destroyed per bomb, the bomb count (every bomb
' counts, the winning one too), YOU WON! with the bomb count, YOU LOST.
'
' Additions and liberties: the original is one round (one hit wins, one
' miss loses). Here a game is nine levels (a new mountain each) with three
' ships: a miss costs a ship and brings a new mountain at the same level;
' finishing level 9 is YOU WON!, losing the third ship YOU LOST. The ship
' speeds up each level (1 to 2 pixels a frame). Score for each target:
' (30 - bombs used on that mountain, at least 0) x 10 x level. The field is
' 28 columns (the C64's 40, the VIC's 22); the ship flies over columns
' 3-28 and hovers a third of a second at the left before each pass, and
' the target is in columns 8-27, so that a player has time to see the
' ship's new height and aim (the C64's target could be 3 columns from
' the ship's start). Smooth sprites for the ship and the bombs,
' a burst for each blown cell, a cream crust on each column's top cell.
' The target blinks at 3 Hz on a hit (the C64's flashed every frame), and
' a miss shows a banner instead of the C64's colour cycling.
'
' Controls: either controller's button drops a bomb (one at a time). The
' title has a menu (START GAME, HOW TO PLAY: two pages, CREDITS): the
' stick up and down, the button chooses.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off,
' display off. Music first in the sound table, effects after; the title
' tune is played once. Nothing flashes faster than 3 Hz.

const TRock = 128
const TRock2 = 129
const TRtop = 130
const TGround = 131
const TTarget = 132
const TTarget2 = 133
const TStar = 134
const TRule = 135
const SShip0 = 0
const SShip1 = 4
const SWin = 8
const SBomb = 12
const SBoom0 = 16
const SBoom1 = 20
const NTiles8 = 64
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndDrop = 3
const SndBoom = 4
const SndHit = 5
const SndMiss = 6
const SndStart = 7
const SndOver = 8
const SndWin = 9
const MsgN = 100
const BoomN = 12
const NSpr = 4
const FloorR = 22
const LastLv = 9
const HoverN = 20

record Bomb
  u8 Col
  u8 Y
  u8 Live
end record

record Burst
  u8 X
  u8 Y
  u8 T
end record

Bomb Bm
Burst Bu

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Sc = 0
u16 Hi = 0
u16 Bt = 0
u8 Lv = 1
u8 Lives = 3
u8 Bl = 0
u8 Over = 0
' the pudding: top row of each screen column (FloorR = dug to the floor)
u8 Hgt[32]
u8 Tc = 10
' the ship: left x, sub-pixel, row, speed in 1/16 pixel a frame
u8 Sx = 16
u8 Sf = 0
u8 Sr = 3
u8 Spd = 16
' frames the ship hovers at the left before each pass
u8 Wt = 0
' 0 playing, 1 target hit, 2 miss; MsgT counts the pause down
u8 Ev = 0
u8 MsgT = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Ud = 0
u8 WasUd = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' scratch
u8 Ci = 0
u8 Ri = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 P = 0
u8 Q = 0

  tile screen
  set sound table PmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the original's message, then back to the title on a press
  if Sc > Hi then Hi = Sc
  ShowHud
  mute all
  NumU = Bt
  if Over = 2 then
    print at 5,9, "                    "
    print at 5,10, "  YOU WON!          "
    print at 15,10, digits$(NumU, 4)
    print at 5,11, "             BOMBS  "
    print at 5,12, "                    "
    play sound SndWin
  else
    print at 8,9, "                "
    print at 8,10, "    YOU LOST    "
    print at 8,11, "                "
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if MsgT > 0 then
    Pause
    return
  end if
  if Bm.Live = 1 then
    Fall
    return
  end if
  ' the ship flies on (it waits while its bomb falls, as in the original)
  if Wt > 0 then
    dec Wt
  else
    V = Sf + Spd
    K = V >> 4
    Sf = V & 15
    Sx = Sx + K
  end if
  if Sx >= 224 then
    Sx = 16
    Sf = 0
    Wt = HoverN
    Rand
    V = Rs & 3
    Sr = V + 3
  end if
  if Press = 1 then
    Bm.Col = ChuteCol(Sx)
    V = Sr + 1
    Bm.Y = V << 3
    Bm.Live = 1
    play sound SndDrop
  end if
  return
end sub

' the column under the ship's chute
function ChuteCol(u8 Lx) as u8
  u8 Cc
  Cc = Lx + 8
  return Cc >> 3

' the bomb falls 3 pixels a frame onto the column's top cell
sub Fall:
  u8 Top
  u8 Lim
  u16 Pts
  Top = Hgt[Bm.Col]
  Lim = Top * 8 - 8
  Bm.Y = Bm.Y + 3
  if Bm.Y < Lim then return
  Bm.Y = Lim
  Bm.Live = 0
  inc Bl
  Bt = Bt + 1
  if Top < FloorR then
    ' blow away one cell of pudding
    Hgt[Bm.Col] = Top + 1
    put char 32 at Bm.Col,Top
    DrawTop(Bm.Col)
    Bu.X = Bm.Col << 3
    Bu.X = Bu.X - 4
    Bu.Y = Top << 3
    Bu.Y = Bu.Y - 4
    Bu.T = BoomN
    play sound SndBoom
    return
  end if
  if Bm.Col = Tc then
    Ev = 1
    Pts = 0
    if Bl < 30 then
      Pts = 30 - Bl
      Pts = Pts * 10
      Pts = Pts * Lv
    end if
    Sc = Sc + Pts
    ShowHud
    NumU = Pts
    print at 7,8, "  TARGET  HIT!  "
    print at 7,9, "  +             "
    print at 10,9, digits$(NumU, 3)
    print at 14,9, "POINTS  "
    play sound SndHit
  else
    Ev = 2
    dec Lives
    ShowHud
    put char TGround at Bm.Col,FloorR
    print at 7,8, "                "
    print at 7,9, "  MISSED!  BOOM "
    print at 7,10, "                "
    Bu.X = Bm.Col << 3
    Bu.X = Bu.X - 4
    Bu.Y = 172
    Bu.T = BoomN
    play sound SndMiss
  end if
  MsgT = MsgN
  return
end sub

' the pause after a hit or a miss: the target blinks (3 Hz) on a hit
sub Pause:
  dec MsgT
  if Ev = 1 then
    V = MsgT / 10
    V = V & 1
    T = TTarget + V
    put char T at Tc,FloorR
  end if
  if MsgT > 0 then return
  if Ev = 1 then
    inc Lv
    if Lv > LastLv then
      Lv = LastLv
      Over = 2
      return
    end if
  else
    if Lives = 0 then
      Over = 1
      return
    end if
  end if
  NewField
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new mountain: random heights 4-10, the target, the ship back at the left
sub NewField:
  for Ci = 2 to 29
    Rand
    W16 = Rs % 7
    V = W16
    Hgt[Ci] = 18 - V
  next
  Rand
  W16 = Rs % 20
  V = W16
  Tc = V + 8
  Rand
  V = Rs & 3
  Sr = V + 3
  Sx = 16
  Sf = 0
  Wt = HoverN
  Bl = 0
  Ev = 0
  MsgT = 0
  Bm.Live = 0
  Bu.T = 0
  V = Lv << 1
  Spd = V + 14
  DrawField
  ShowHud
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the top cell of column Cn wears the cream crust
sub DrawTop(u8 Cn):
  u8 Tr
  Tr = Hgt[Cn]
  if Tr >= FloorR then return
  put char TRtop at Cn,Tr
  return
end sub

sub DrawColumn(u8 Cn):
  u8 Rr
  u8 Tr
  u8 Tl
  Tr = Hgt[Cn]
  for Rr = 3 to 21
    if Rr < Tr then
      Tl = 32
      Q = Cn * 5 + Rr * 11
      Q = Q ^ Cn
      Q = Q & 15
      if Q = 3 then
        if Rr < 11 then Tl = TStar
      end if
    elseif Rr = Tr then
      Tl = TRtop
    else
      Q = Cn + Rr
      Q = Q & 1
      Tl = TRock + Q
    end if
    put char Tl at Cn,Rr
  next
  Tl = TGround
  if Cn = Tc then Tl = TTarget
  put char Tl at Cn,FloorR
  return
end sub

sub DrawField:
  for Ci = 2 to 29
    DrawColumn(Ci)
  next
  fill TRule count 28 at 2,2
  return
end sub

' sprite 0 the cabin windows, 1 the ship, 2 the bomb, 3 the burst
sub DrawSprites:
  u8 Bx
  u8 By
  Y = Sr << 3
  Y = Y - 1
  if Over > 0 then Y = 192
  V = Tick >> 2
  V = V & 1
  K = SShip0
  if V = 1 then K = SShip1
  set sprite 0 to Y,Sx,SWin,15
  set sprite 1 to Y,Sx,K,14
  if Bm.Live = 1 then
    By = Bm.Y - 1
    Bx = Bm.Col << 3
    Bx = Bx - 4
    set sprite 2 to By,Bx,SBomb,1
  else
    set sprite 2 to 192,0,0,0
  end if
  if Bu.T > 0 then
    dec Bu.T
    V = Bu.T >> 2
    V = V & 1
    K = SBoom0
    if V = 0 then K = SBoom1
    Bx = Bu.X
    By = Bu.Y
    set sprite 3 to By,Bx,K,11
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  NumU = Sc
  print at 8,1, digits$(NumU, 5)
  print at 15,1, "LV"
  print at 17,1, digits$(Lv, 1)
  print at 20,1, "SHIPS"
  print at 26,1, digits$(Lives, 1)
  return
end sub

sub NewGame:
  Sc = 0
  Bt = 0
  Lv = 1
  Lives = 3
  Over = 0
  TitleOn = 0
  NewScreen
  NewField
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 0
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' the button of either controller (the stick only moves the title menu)
sub ReadPad:
  J1 = 0
  if joypad(1).fire then J1 = 16
  if joypad(2).fire then J1 = 16
  Ud = 0
  if joypad(1).up then Ud = 1
  if joypad(2).up then Ud = 1
  if joypad(1).down then Ud = 2
  if joypad(2).down then Ud = 2
  Btn = J1
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for Ci = 0 to 3
    set sprite Ci to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a mountain, the ship flying over it, the tune once
sub TitlePage:
  Lv = 1
  NewScreen
  for Ci = 2 to 29
    V = Ci & 7
    V = V * 3
    V = V & 7
    Hgt[Ci] = 14 + V
    if Hgt[Ci] > 18 then Hgt[Ci] = 18
  next
  Tc = 16
  DrawField
  fill 32 count 28 at 2,2
  print at 4,4, "PUDDING MOUNTAIN MINER"
  print at 4,6, "COMPUTE!'S GAZETTE 1985"
  print at 10,8, "START GAME"
  print at 10,9, "HOW TO PLAY"
  print at 10,10, "CREDITS"
  Menu = 0
  ShowMenu
  print at 2,1, "HI"
  NumU = Hi
  print at 5,1, digits$(NumU, 5)
  TitleOn = 1
  Over = 0
  Bm.Live = 0
  Bu.T = 0
  Sx = 16
  Sf = 0
  Sr = 12
  Spd = 16
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 560
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 0
  WasUd = 1
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if Ud > 0 then
    if WasUd = 0 then
      if Ud = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasUd = Ud
  V = Sf + Spd
  K = V >> 4
  Sf = V & 15
  Sx = Sx + K
  if Sx >= 224 then Sx = 16
  DrawSprites
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowMenu:
  for Ri = 8 to 10
    put char 32 at 8,Ri
  next
  V = Menu + 8
  put char 62 at 8,V
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "YOUR AIRSHIP FLIES OVER"
    print at 2,4, "PUDDING MOUNTAIN, LEFT TO"
    print at 2,5, "RIGHT, AGAIN AND AGAIN."
    print at 2,7, "A GREEN TARGET IS HIDDEN"
    print at 2,8, "IN THE ROCK AT THE BOTTOM."
    print at 2,10, "EACH BOMB BLOWS AWAY ONE"
    print at 2,11, "BLOCK OF PUDDING. DIG A"
    print at 2,12, "HOLE DOWN TO THE TARGET,"
    print at 2,13, "THEN DROP A BOMB ON IT!"
    for Ci = 8 to 23
      V = Ci & 3
      Y = 16 + V
      if Ci = 15 then Y = 20
      if Y < 20 then put char TRtop at Ci,Y
      for Ri = 17 to 19
        if Ri > Y then
          V = Ci + Ri
          V = V & 1
          V = V + TRock
          put char V at Ci,Ri
        end if
      next
      put char TGround at Ci,20
    next
    put char TTarget at 15,20
    set sprite 0 to 111,112,SWin,15
    set sprite 1 to 111,112,SShip0,14
    set sprite 2 to 135,116,SBomb,1
  else
    print at 2,1, "CONTROLS               2/2"
    print at 2,3, "BUTTON: DROP A BOMB. THE"
    print at 2,4, "SHIP STOPS WHILE IT FALLS."
    print at 2,6, "A BOMB THAT HITS THE ROCK"
    print at 2,7, "FLOOR BUT NOT THE TARGET"
    print at 2,8, "IS A MISS: YOU LOSE A SHIP"
    print at 2,9, "AND GET A NEW MOUNTAIN."
    print at 2,11, "HIT THE TARGET TO SCORE."
    print at 2,12, "THE FEWER BOMBS YOU USE,"
    print at 2,13, "THE MORE POINTS YOU GET."
    print at 2,15, "CLEAR 9 LEVELS TO WIN. LOSE"
    print at 2,16, "ALL 3 SHIPS AND IT'S OVER."
    print at 2,18, "TIP: WATCH THE TARGET, AND"
    print at 2,19, "DIG RIGHT ABOVE IT."
    set sprite 0 to 135,216,SWin,15
    set sprite 1 to 135,216,SShip1,14
    set sprite 3 to 159,216,SBoom0,11
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 4,2, "PUDDING MOUNTAIN MINER"
  print at 2,5, "BASED ON THE PROGRAM IN THE"
  print at 2,6, "HORIZONS COLUMN, COMPUTE!'S"
  print at 2,7, "GAZETTE, APRIL 1985"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: DESSERT DIG"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $10,$40,$02,$08,$80,$11,$00,$42
  $01,$10,$80,$04,$20,$00,$08,$81
  $81,$00,$24,$99,$00,$20,$04,$80
  $44,$10,$82,$08,$20,$02,$40,$00
  $00,$81,$42,$A5,$A5,$42,$81,$00
  $00,$81,$42,$A5,$A5,$42,$81,$00
  $00,$00,$10,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $A6,$A6,$A6,$A6,$A6,$A6,$06,$A6
  $A6,$A6,$A6,$A6,$A6,$06,$A6,$A6
  $1F,$0F,$BF,$6F,$06,$A6,$A6,$A6
  $BA,$BA,$BA,$BA,$BA,$BA,$BA,$0A
  $02,$23,$32,$23,$23,$32,$23,$02
  $03,$32,$23,$32,$32,$23,$32,$03
  $00,$00,$F0,$00,$00,$00,$00,$00
  $00,$00,$00,$0E,$00,$00,$00,$00
end data
data SpritePat bytes
  $1F,$20,$5B,$FF,$7F,$1F,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $F8,$04,$66,$FF,$FE,$F8,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $1F,$20,$4D,$FF,$7F,$1F,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $F8,$04,$B5,$FF,$FE,$F8,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$36,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$D8,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $03,$07,$01,$03,$07,$07,$03,$01,$00,$00,$00,$00,$00,$00,$00,$00
  $C0,$E0,$80,$C0,$E0,$E0,$C0,$80,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$08,$05,$27,$0F,$1F,$0F,$27,$05,$08,$00,$00,$00,$00,$00,$00
  $00,$10,$A0,$E4,$F0,$F8,$F0,$E4,$A0,$10,$00,$00,$00,$00,$00,$00
  $21,$88,$09,$42,$10,$84,$22,$50,$12,$84,$20,$00,$00,$00,$00,$00
  $04,$21,$20,$42,$10,$84,$11,$14,$40,$22,$28,$00,$00,$00,$00,$00
end data

asm {
PmDrop:
    db $40,$47,$30,$02,$40,$50,$40,$02,$40,$5A,$40,$02,$40,$65,$50,$02,$50
PmBoom:
    db $00,$00,$05,$03,$00,$00,$26,$04,$00,$00,$46,$08,$10
PmHit:
    db $40,$8F,$10,$06,$40,$6B,$10,$06,$40,$55,$10,$06,$40,$47,$10,$06,$40,$35,$20,$14,$50
PmMiss:
    db $00,$00,$04,$06,$00,$00,$15,$0A,$00,$00,$36,$10,$00,$00,$57,$18,$10
PmStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0E,$50
PmOver:
    db $40,$D6,$10,$0C,$40,$F0,$20,$0C,$40,$1D,$21,$0C,$40,$AB,$21,$1E,$50
PmWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$55,$10,$08,$40,$47,$20,$1E
    db $50

PmSoundTable:
    dw PmTuneMel,$702B
    dw PmTuneBass,$7035
    dw PmDrop,$7049
    dw PmBoom,$703F
    dw PmHit,$7049
    dw PmMiss,$703F
    dw PmStart,$7049
    dw PmOver,$7049
    dw PmWin,$7049
; Dessert Dig (original)
; Tiny Sound, 8 frames per step
PmTuneMel:
    db $44
    dw sndtiny_1
