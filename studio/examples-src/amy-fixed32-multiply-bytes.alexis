' Fixed32 multiply byte lab: inspect raw result bytes alongside decimal output.
fixed32 Baseline = 1.5
fixed32 ByZero = 1.5
fixed32 ByOne = 1.5
fixed32 ByTwo = 1.5
fixed32 NegByNegTwo = -1.5
u8 BaseBytes[4] = 0
u8 ZeroBytes[4] = 0
u8 OneBytes[4] = 0
u8 TwoBytes[4] = 0
u8 NegBytes[4] = 0

  text screen
  print at 5,0, "FIXED32 MULT BYTES"
  print at 1,1, "RAW BYTES      B3  B2  B1  B0"

  copy bytes of Baseline to BaseBytes
  print at 1,3,  "BASE 1.50"
  print BaseBytes[3] at 15,3 digits 3
  print BaseBytes[2] at 19,3 digits 3
  print BaseBytes[1] at 23,3 digits 3
  print BaseBytes[0] at 27,3 digits 3

  ByZero *= 0.0
  copy bytes of ByZero to ZeroBytes
  print at 1,6,  "1.50 * 0.00"
  print ZeroBytes[3] at 15,6 digits 3
  print ZeroBytes[2] at 19,6 digits 3
  print ZeroBytes[1] at 23,6 digits 3
  print ZeroBytes[0] at 27,6 digits 3

  ByOne *= 1.0
  copy bytes of ByOne to OneBytes
  print at 1,9,  "1.50 * 1.00"
  print OneBytes[3] at 15,9 digits 3
  print OneBytes[2] at 19,9 digits 3
  print OneBytes[1] at 23,9 digits 3
  print OneBytes[0] at 27,9 digits 3

  ByTwo *= 2.0
  copy bytes of ByTwo to TwoBytes
  print at 1,12,  "1.50 * 2.00"
  print TwoBytes[3] at 15,12 digits 3
  print TwoBytes[2] at 19,12 digits 3
  print TwoBytes[1] at 23,12 digits 3
  print TwoBytes[0] at 27,12 digits 3

  NegByNegTwo *= -2.0
  copy bytes of NegByNegTwo to NegBytes
  print at 1,15, "-1.50 * -2.00"
  print NegBytes[3] at 15,15 digits 3
  print NegBytes[2] at 19,15 digits 3
  print NegBytes[1] at 23,15 digits 3
  print NegBytes[0] at 27,15 digits 3

  print at 1,18, "EXPECTED RAW"
  print at 1,19, "1.50  = 000 001 128 000"
  print at 1,20, "0.00  = 000 000 000 000"
  print at 1,21, "1.50  = 000 001 128 000"
  print at 1,22, "3.00  = 000 003 000 000"
  print at 1,23, "3.00  = 000 003 000 000"
  screen on