    db $40+6,7
    dw $0000
; MIGRATION's scrolling: the land moves up a row at a time.
; MgShift: screen rows 3-22 move up to rows 2-21 (32 bytes at a time
; through MgBuf). MgRow: map row MgMap (0-639, the four legs one after the
; other) is decoded (count, tile pairs) into screen row MgDst.
MgShift:
    ld hl,(VDP_NAME_SHADOW)
    ld de,64
    add hl,de
    ld b,20
MgSh1:
    push bc
    push hl
    ld de,32
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld hl,AMY_UVAR_MgBuf
    ld b,32
MgSh2:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz MgSh2
    pop hl
    push hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_MgBuf
    ld b,32
MgSh3:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz MgSh3
    pop hl
    ld de,32
    add hl,de
    pop bc
    djnz MgSh1
    ret

MgRow:
    ld hl,(AMY_UVAR_MgMap)
    add hl,hl
    ld de,LegRowOff
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld hl,LegData
    add hl,de
    push hl
    ld a,(AMY_UVAR_MgDst)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop hl
    ld c,32
MgRw1:
    ld b,(hl)
    inc hl
    ld a,(hl)
    inc hl
MgRw2:
    out ($BE),a
    nop
    dec c
    djnz MgRw2
    ld a,c
    or a
    jr nz,MgRw1
    ret

; MgPeek: Pk = the tile on screen at cell MgCell
MgPeek:
    ld hl,(AMY_UVAR_MgCell)
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret
