' MIGRATION
' An original game by Claude (an AI made by Anthropic) for Amy Studio and
' Amy Bienvenu, 2026.
'
' A flock of Canada geese flies south for the winter, in four legs: the
' north bay, the great lakes, the ridges, the marsh. You are the lead
' goose; the others follow in a V, each flying where the one ahead flew a
' moment before. The flock gets hungry as it flies: hold the button over a
' lake to come down and feed (the land stops moving), but every moment on
' the water lets the frost come closer, and a flock caught by the frost
' loses its last goose. Storm clouds scatter geese out of the V; a hawk
' comes for the goose at the back unless the lead flies at it; a goose
' left without food drops out. Lost geese wait on the ground below: fly
' over one and it joins the V again.
'
' How the flock flies: the lead's last 32 places are kept; follower k
' takes the place of the lead (3 x its row) frames ago, set back and to
' its side of the V, so the V bends and flows behind every turn.
'
' House rules kept: joystick only; text in columns 2-29 and rows 1-22;
' tiles at 128 and up; a title tune that plays once (Amy's play song ...
' once); a credits page; the frame loop is protected from the NMI and
' every screen is drawn with the NMI off after a wait.

const TSnow = 128
const TTundra = 129
const TGrass = 130
const TTree = 131
const TSnowtree = 132
const TField = 133
const TLake = 134
const THouse = 135
const TPeak = 136
const TRock = 137
const TCloud = 138
const TReed = 139
const TRoad = 140
const TRoadh = 141
const TRoadne = 142
const TRoadnw = 143
const TRoadse = 144
const TRoadsw = 145
const TBridgev = 146
const TBridgeh = 147
const TMud = 148
const TLakesnownw = 149
const TLakesnowne = 150
const TLakesnowsw = 151
const TLakesnowse = 152
const TLaketundranw = 153
const TLaketundrane = 154
const TLaketundrasw = 155
const TLaketundrase = 156
const TLakegrassnw = 157
const TLakegrassne = 158
const TLakegrasssw = 159
const TLakegrassse = 160
const TLakemudnw = 161
const TLakemudne = 162
const TLakemudsw = 163
const TLakemudse = 164
const TLakerocknw = 165
const TLakerockne = 166
const TLakerocksw = 167
const TLakerockse = 168
const TCloudsnownw = 169
const TCloudsnowne = 170
const TCloudsnowsw = 171
const TCloudsnowse = 172
const TCloudtundranw = 173
const TCloudtundrane = 174
const TCloudtundrasw = 175
const TCloudtundrase = 176
const TCloudgrassnw = 177
const TCloudgrassne = 178
const TCloudgrasssw = 179
const TCloudgrassse = 180
const TCloudmudnw = 181
const TCloudmudne = 182
const TCloudmudsw = 183
const TCloudmudse = 184
const TCloudrocknw = 185
const TCloudrockne = 186
const TCloudrocksw = 187
const TCloudrockse = 188
const TTreesnownw = 189
const TTreesnowne = 190
const TTreesnowsw = 191
const TTreesnowse = 192
const TTreetundranw = 193
const TTreetundrane = 194
const TTreetundrasw = 195
const TTreetundrase = 196
const TTreegrassnw = 197
const TTreegrassne = 198
const TTreegrasssw = 199
const TTreegrassse = 200
const TTreemudnw = 201
const TTreemudne = 202
const TTreemudsw = 203
const TTreemudse = 204
const TTreerocknw = 205
const TTreerockne = 206
const TTreerocksw = 207
const TTreerockse = 208
const SNone = 0
const NTiles8 = 648
const SprBytes = 32
const SGoose1 = 0
const SGoose2 = 1
const SHawk = 2
const SndHush = 1
const SndHonk = 2
const SndJoin = 3
const SndLost = 4
const SndCry = 5
const SndTuneA = 6
const SndTuneB = 7
const LegRows = 160
data LegStray bytes 57, 196, 97, 204, 143, 124, 78, 76, 114, 84, 135, 92, 42, 148, 85, 124, 147, 68, 38, 156, 103, 140, 136, 116
data LegNames bytes 84, 72, 69, 32, 78, 79, 82, 84, 72, 32, 66, 65, 89, 32, 32, 32, 84, 72, 69, 32, 71, 82, 69, 65, 84, 32, 76, 65, 75, 69, 83, 32, 84, 72, 69, 32, 82, 73, 68, 71, 69, 83, 32, 32, 32, 32, 32, 32, 84, 72, 69, 32, 77, 65, 82, 83, 72, 32, 32, 32, 32, 32, 32, 32

' --- the land -----------------------------------------------------------------
' Leg 0-3, Top the map row at the top of the screen (row 2), MgMap and
' MgDst for scroll.asm, StepT frames to the next row
u8 Leg = 0
u16 Top = 0
u16 MgMap = 0
u8 MgDst = 0
u8 MgBuf[32]
u16 MgCell = 0
u8 Pk = 0
u8 StepT = 0
' --- the flock ----------------------------------------------------------------
' the lead (pixels), its last 32 places, the followers (count 0-12)
u8 Lx = 120
u8 Ly = 120
u8 HX[32]
u8 HY[32]
u8 HI = 0
u8 NF = 8
u8 FX[12]
u8 FY[12]
u8 Food = 100
u8 Frost = 0
u8 Resting = 0
u8 FoodT = 0
u8 Wing = 0
' the strays: map row and x for each of the leg's three (0: gone)
u16 StR[3]
u8 StX[3]
u8 StOn[3]
' the hawk: on, pixels, frames to the next, its target follower
u8 HkOn = 0
u8 HkX = 0
u8 HkY = 0
u8 HkT = 200
u8 HkTg = 0
u8 Scared = 0
' totals
u8 Arrived = 0
' for the test bot: 1 flying, 2 a card, 3 the end, 8 the title
u8 Ph = 0
u8 Busy = 0

u16 Rw = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 W16 = 0
u16 Addr = 0
u8 C = 0
u8 I = 0
u8 K = 0
u8 N = 0
u8 J = 0
u8 V = 0
u8 V2 = 0
u8 N2 = 0
u8 X = 0
u8 Y = 0
u8 Dx = 0
u8 Dy = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0

  tile screen
  set sound table MgSoundTable areas 4
  sprites 8x8
  nmi off
  copy Spr8 count 24 to vram.spr_pat
  HideSprites
  screen on

title:
  ' the title: the first leg passing under a small V
  Ph = 8
  Leg = 0
  NewLeg
  print at 2,1, "MIGRATION: PRESS THE BUTTON"
  play song MgSong once
  NF = 6
  Lx = 124
  Ly = 110
  for I = 0 to 31
    HX[I] = Lx
    HY[I] = Ly
  next
  WasBtn = 1
attract:
  Frame1
  ReadPad
  ' the lead drifts gently from side to side
  V = Tick & 63
  if V < 32 then
    V = Tick & 3
    if V = 0 then inc Lx
  else
    V = Tick & 3
    if V = 0 then dec Lx
  end if
  Scroll
  Flock
  ShowBirds
  if Press = 0 then goto attract
  Rs = Rs ^ Tick
  if Rs = 0 then Rs = $5A3C
  play sound SndHonk
  ' the story
  NewScreen
  print at 7,3, "M I G R A T I O N"
  print at 3,6, "THE NIGHTS ARE COLD. IT IS"
  print at 3,7, "TIME TO FLY SOUTH."
  print at 3,9, "YOU LEAD THE V. THE OTHERS"
  print at 3,10, "FOLLOW WHERE YOU FLY."
  print at 3,12, "BUTTON (OVER A LAKE): COME"
  print at 3,13, "DOWN TO FEED. THE FROST"
  print at 3,14, "COMES CLOSER WHILE YOU DO."
  print at 3,16, "FLY AT A HAWK TO SCARE IT."
  print at 3,17, "FLY OVER LOST GEESE TO"
  print at 3,18, "BRING THEM BACK."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  play sound SndHonk
  ' the credits
  NewScreen
  print at 7,3, "M I G R A T I O N"
  print at 2,7, "A GAME BY CLAUDE (AN AI MADE"
  print at 2,8, "BY ANTHROPIC) FOR AMY STUDIO"
  print at 2,10, "AND AMY BIENVENU"
  print at 2,13, "MUSIC: SOUTHWARD"
  print at 2,16, "COLECOVISION, AMY, 2026"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  play sound SndHonk
  stop sound SndTuneA
  stop sound SndTuneB

  Leg = 0
  NF = 8
  Arrived = 0

leg_start:
  LegCard
  NewLeg
  ' the food carries on from leg to leg (full at the start of the flight)
  if Leg = 0 then Food = 100
  Frost = 0
  Lx = 124
  Ly = 120
  for I = 0 to 31
    HX[I] = Lx
    HY[I] = Ly
  next
  HkOn = 0
  HkT = 250
  ShowHud
  Ph = 1

play_loop:
  Frame1
  Busy = 1
  ReadPad
  Steer
  Rest
  if Resting = 0 then Scroll
  Flock
  Storms
  Hawk
  Strays
  Hunger
  ShowBirds
  V = Tick & 31
  if V = 0 then ShowHud
  Busy = 0
  ' the leg ends when its last row reaches the bottom of the screen
  W16 = Leg * 160
  W16 = W16 + LegRows
  W16 = W16 - 21
  if Top < W16 then goto play_loop

  ' the leg is flown
  HideSprites
  play sound SndHonk
  inc Leg
  if Leg < 4 then goto leg_start
  ' the end: the marsh
  Ph = 3
  Arrived = NF + 1
  NewScreen
  print at 3,5, "THE MARSH AT LAST. THE"
  print at 3,6, "WATER IS WARM, THE REEDS"
  print at 3,7, "ARE FULL OF SEED."
  print at 3,10, "GEESE THAT FLEW THE WHOLE"
  print at 3,11, "WAY SOUTH:"
  print at 15,11, digits$(Arrived, 2)
  if Arrived >= 13 then print at 3,14, "NOT ONE WAS LOST. A FINE V."
  if Arrived < 13 then
    if Arrived >= 9 then print at 3,14, "A GOOD FLOCK. A GOOD LEAD."
  end if
  if Arrived < 9 then print at 2,14, "A HARD ROAD, BUT YOU DID IT."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  play song MgSong once
  WaitPress
  stop sound SndTuneA
  stop sound SndTuneB
  goto title

' ---------------------------------------------------------------------------

sub LegCard:
  Ph = 2
  HideSprites
  NewScreen
  print at 13,7, "LEG"
  V = Leg + 1
  print at 17,7, digits$(V, 1)
  W16 = Leg * 16
  for I = 0 to 15
    V = LegNames[W16]
    X = I + 8
    put char V at X,10
    inc W16
  next
  print at 8,14, "GEESE IN THE V:"
  V = NF + 1
  print at 24,14, digits$(V, 2)
  ShowScreen
  Hold(150)
  return
end sub

' NewLeg: the leg's first 21 rows, its strays
sub NewLeg:
  NewScreen
  Top = Leg * 160
  for Y = 2 to 22
    V = Y - 2
    MgMap = Top + V
    MgDst = Y
    asm {
      call MgRow
    }
  next
  for I = 0 to 2
    V = Leg * 6
    K = I * 2
    V = V + K
    V2 = LegStray[V]
    W16 = V2
    W16 = W16 + Top
    StR[I] = W16
    inc V
    StX[I] = LegStray[V]
    StOn[I] = 1
  next
  StepT = 14
  ShowScreen
  return
end sub

sub ShowHud:
  print at 2,1, "GEESE"
  V = NF + 1
  print at 8,1, digits$(V, 2)
  print at 11,1, "FOOD"
  V = Food / 20
  print at 16,1, "     "
  if V > 0 then
    for I = 1 to V
      X = I + 15
      if X <= 20 then print at X,1, "*"
    next
  end if
  print at 22,1, "FROST"
  V = Frost >> 5
  print at 28,1, digits$(V, 1)
  return
end sub

' Scroll: the land moves up a row every StepT frames
sub Scroll:
  dec StepT
  if StepT > 0 then return
  StepT = 14
  asm {
    call MgShift
  }
  inc Top
  MgMap = Top + 20
  MgDst = 22
  asm {
    call MgRow
  }
  return
end sub

' Steer: the lead flies where the stick says, inside the sky
sub Steer:
  if Resting = 1 then return
  if Lf1 = 1 then
    if Lx > 20 then dec Lx
  end if
  if Rt1 = 1 then
    if Lx < 228 then inc Lx
  end if
  if Up1 = 1 then
    if Ly > 40 then dec Ly
  end if
  if Dn1 = 1 then
    if Ly < 168 then inc Ly
  end if
  ' the lead's places, for the V
  inc HI
  HI = HI & 31
  HX[HI] = Lx
  HY[HI] = Ly
  return
end sub

' LeadTile: Pk = the land under the lead
sub LeadTile:
  X = Lx + 4
  Y = Ly + 4
  V = X >> 3
  V2 = Y >> 3
  W16 = V2 * 32
  MgCell = W16 + V
  asm {
    call MgPeek
  }
  return
end sub

' Rest: the button held over a lake brings the flock down to feed
sub Rest:
  Resting = 0
  if Btn = 1 then
    LeadTile
    if Pk = TLake then Resting = 1
  end if
  if Resting = 1 then
    inc FoodT
    V = FoodT & 3
    if V = 0 then
      if Food < 100 then inc Food
    end if
    V = FoodT & 7
    if V = 0 then
      if Frost < 255 then inc Frost
    end if
    if Frost = 255 then
      ' the frost catches the flock: the last goose is lost
      if NF > 0 then
        dec NF
        play sound SndLost
      end if
      Frost = 160
      ShowHud
    end if
  else
    V = Tick & 15
    if V = 0 then
      if Frost > 0 then dec Frost
    end if
  end if
  return
end sub

' Hunger: food runs down as the flock flies (twice as fast over the
' mountains); with none, a goose drops out now and then
sub Hunger:
  if Resting = 1 then return
  inc FoodT
  V = FoodT & 31
  if V = 0 then
    if Food > 0 then dec Food
    LeadTile
    if Pk = TPeak then
      if Food > 0 then dec Food
    end if
  end if
  if Food = 0 then
    V = FoodT & 255
    if V = 128 then
      if NF > 0 then
        K = NF - 1
        DropOut
      end if
    end if
  end if
  return
end sub

' Flock: each follower takes its place in the V from the lead's path
sub Flock:
  if NF = 0 then return
  N2 = NF - 1
  for K = 0 to N2
    ' row in the V and side
    N = K >> 1
    inc N
    V = N * 3
    V = HI - V
    V = V & 31
    X = HX[V]
    Y = HY[V]
    V2 = N * 7
    Y = Y - V2
    V = K & 1
    if V = 0 then
      X = X - V2
    else
      X = X + V2
    end if
    if Resting = 1 then
      ' on the water the V closes up a little
      V = N * 2
      Y = Y + V
    end if
    FX[K] = X
    FY[K] = Y
  next
  return
end sub

' Storms: a goose inside a storm cloud may be thrown out of the V
sub Storms:
  if NF = 0 then return
  Rnd16
  V = lowbyte Rw
  if V >= 12 then return
  ' one follower at random
  Rt = Rw >> 8
  K = lowbyte Rt
  K = K & 15
  if K >= NF then return
  X = FX[K] + 4
  Y = FY[K] + 4
  V = X >> 3
  V2 = Y >> 3
  W16 = V2 * 32
  MgCell = W16 + V
  asm {
    call MgPeek
  }
  if Pk = TCloud then DropOut
  return
end sub

' DropOut: follower K leaves the V and comes down where it is (a stray
' that can be found again), the others close up
sub DropOut:
  play sound SndLost
  ' a free stray place
  for I = 0 to 2
    if StOn[I] = 0 then
      StOn[I] = 1
      V = FY[K] >> 3
      W16 = Top + V
      W16 = W16 - 2
      StR[I] = W16
      StX[I] = FX[K]
      I = 2
    end if
  next
  dec NF
  ShowHud
  return
end sub

' Strays: lost geese below; the lead flying over one brings it back
sub Strays:
  for I = 0 to 2
    if StOn[I] = 1 then
      ' gone off the top of the screen: lost for good
      if StR[I] < Top then StOn[I] = 0
    end if
    if StOn[I] = 1 then
      W16 = StR[I] - Top
      if W16 < 21 then
        V = lowbyte W16
        Y = V * 8
        Y = Y + 16
        X = StX[I]
        V = X - Lx
        if Lx > X then V = Lx - X
        if V < 8 then
          V = Y - Ly
          if Ly > Y then V = Ly - Y
          if V < 8 then
            StOn[I] = 0
            if NF < 12 then
              inc NF
              play sound SndJoin
              ShowHud
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' Hawk: now and then a hawk comes from the side for the goose at the back
' of the V; the lead flying close scares it away
sub Hawk:
  if HkOn = 0 then
    if HkT > 0 then
      dec HkT
      return
    end if
    if NF = 0 then return
    HkOn = 1
    Scared = 0
    HkY = 60
    Rnd16
    V = lowbyte Rw
    HkX = 4
    if V > 127 then HkX = 244
    play sound SndCry
    return
  end if
  ' its target: the last goose of the V
  if NF = 0 then
    Scared = 1
  end if
  K = NF - 1
  if Scared = 1 then
    ' away, up and off the screen
    if HkY > 4 then
      HkY = HkY - 2
    else
      HkOn = 0
      V = 4 - Leg
      HkT = V * 150
    end if
    return
  end if
  X = FX[K]
  Y = FY[K]
  V = Tick & 1
  if V = 0 then
    if HkX < X then inc HkX
    if HkX > X then dec HkX
    if HkY < Y then inc HkY
    if HkY > Y then dec HkY
  end if
  if Leg >= 2 then
    if HkX < X then inc HkX
    if HkX > X then dec HkX
  end if
  ' the lead close: scared off
  V = HkX - Lx
  if Lx > HkX then V = Lx - HkX
  if V < 18 then
    V = HkY - Ly
    if Ly > HkY then V = Ly - HkY
    if V < 18 then
      Scared = 1
      play sound SndHonk
      return
    end if
  end if
  ' caught the goose at the back
  V = HkX - X
  if X > HkX then V = X - HkX
  if V < 4 then
    V = HkY - Y
    if Y > HkY then V = Y - HkY
    if V < 4 then
      dec NF
      play sound SndLost
      ShowHud
      Scared = 1
    end if
  end if
  return
end sub

' ShowBirds: the V (wings beating, still on the water), the strays below,
' the hawk
sub ShowBirds:
  inc Wing
  N = SGoose1
  V = Wing & 8
  if V > 0 then N = SGoose2
  if Resting = 1 then N = SGoose2
  Y = Ly - 1
  set sprite 0 to Y,Lx,N,6
  for K = 0 to 11
    C = 0
    if K < NF then C = 1
    Y = FY[K] - 1
    J = K + 1
    set sprite J to Y,FX[K],N,C
  next
  for I = 0 to 2
    C = 0
    Y = 0
    X = 0
    if StOn[I] = 1 then
      W16 = StR[I] - Top
      if W16 < 21 then
        V = lowbyte W16
        Y = V * 8
        Y = Y + 15
        X = StX[I]
        C = 10
      end if
    end if
    J = I + 13
    set sprite J to Y,X,SGoose2,C
  next
  C = 0
  if HkOn = 1 then C = 6
  Y = HkY - 1
  set sprite 16 to Y,HkX,SHawk,C
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 17
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 16
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

data TilePat bytes
  $00,$20,$02,$00,$10,$00,$42,$00
  $00,$20,$02,$00,$10,$00,$42,$00
  $00,$20,$02,$00,$10,$00,$42,$00
  $10,$38,$83,$38,$83,$01,$10,$00
  $10,$38,$83,$38,$83,$01,$10,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$60,$90,$00,$0C,$12,$00,$00
  $00,$30,$87,$03,$48,$48,$00,$00
  $10,$38,$28,$44,$42,$81,$80,$00
  $00,$20,$02,$00,$10,$00,$42,$00
  $C3,$81,$00,$00,$81,$00,$01,$83
  $92,$92,$49,$49,$92,$92,$00,$00
  $18,$18,$00,$18,$18,$00,$18,$18
  $00,$00,$00,$24,$00,$00,$00,$00
  $10,$10,$00,$16,$00,$00,$00,$00
  $10,$10,$00,$D0,$00,$00,$00,$00
  $00,$00,$00,$16,$00,$10,$10,$10
  $00,$00,$00,$D0,$00,$10,$10,$10
  $81,$99,$99,$81,$99,$99,$81,$81
  $00,$00,$00,$99,$00,$00,$00,$00
  $00,$20,$02,$00,$10,$00,$42,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
