record Ship:
  u8 X
  u8 Y
  u8 St
  u8 Up
  u8 Nx
  u8 Fr
end record

Ship Sh

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Addr = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the field: slot k's mines are at y = 24 + 80 k - Phase; Gap 255 = none
u8 Gap[3]
u8 GPrev = 0
u8 Phase = 0
u8 Frac = 0
u8 Spd = 0
u8 ShSpd = 0
u8 Rows = 0
u8 Moved = 0
u8 Redraw = 0
u8 Ofs = 0
' the saucer
u8 Px = 0
u8 Py = 0
u8 Lives = 0
u8 Dead = 0
u8 Over = 0
u8 Hits = 0
u8 ShipHits = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Sk = 0
u8 Pt = 0
u8 Rr = 0
u8 Li = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 Y64 = 0
u8 Tr = 0
u8 Res = 0
u8 Steps = 0
u8 Spare = 0

  tile screen
  set sound table McSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawFrame
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "  BEST  ", Hi, "  "
  print at 8,14, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  Moved = 0
  if Dead > 0 then
    dec Dead
    if Dead = 0 then
      if Lives = 0 then
        Over = 1
      else
        ResetField
      end if
    end if
    return
  end if
  MoveSaucer
  ' the field rises Spd/16 pixel a frame
  Frac = Frac + Spd
  Steps = Frac >> 4
  Frac = Frac & 15
  while Steps > 0
    inc Phase
    Moved = 1
    if Phase = 80 then
      Phase = 0
      Gap[0] = Gap[1]
      Gap[1] = Gap[2]
      NewRow
    end if
    dec Steps
  end while
  MoveShip
  if HitMines() = 1 then
    inc Hits
    Crash
    return
  end if
  if HitShip = 1 then
    inc ShipHits
    Crash
  end if
  return
end sub

' a new row of mines at the bottom (slot 2), 10 points
sub NewRow:
  Rand
  V = Rs >> 8
  V = V % 3
  V = GPrev + V + 1
  V = V & 3
  GPrev = V
  Gap[2] = V
  if Score > ScoreCap then
    Score = 999999
  else
    Score += 10
  end if
  if Score > Hi then Hi = Score
  inc Rows
  K = Rows & 7
  if K = 0 then
    if Spd < SpdTop then inc Spd
    if ShSpd < ShTop then inc ShSpd
  end if
  Redraw = 1
  play sound SndRow
  return
end sub

sub Crash:
  Dead = 60
  dec Lives
  play sound SndBoom
  play sound SndFall
  return
end sub

' the stick: 3 pixels a frame across, 2 up and down, diagonals too
sub MoveSaucer:
  K = J1 & 12
  select case K
    case 4
      if Px > PxMin + 3 then
        Px = Px - 3
      else
        Px = PxMin
      end if
    case 8
      if Px < PxMax - 3 then
        Px = Px + 3
      else
        Px = PxMax
      end if
  end select
  K = J1 & 3
  if K = 1 then
    if Py > PyMin + 2 then
      Py = Py - 2
    else
      Py = PyMin
    end if
  end if
  if K = 2 then
    if Py < PyMax - 2 then
      Py = Py + 2
    else
      Py = PyMax
    end if
  end if
  return
end sub

' the patrol ship: right, up 24, left, up 24 ... (ShSpd/16 pixel a frame)
sub MoveShip:
  Sh.Fr = Sh.Fr + ShSpd
  Steps = Sh.Fr >> 4
  Sh.Fr = Sh.Fr & 15
  while Steps > 0
    select case Sh.St
      case 0
        if Sh.X < SxMax then
          inc Sh.X
        else
          Sh.St = 2
          Sh.Up = 24
          Sh.Nx = 1
        end if
      case 1
        if Sh.X > SxMin then
          dec Sh.X
        else
          Sh.St = 2
          Sh.Up = 24
          Sh.Nx = 0
        end if
      case else
        dec Sh.Y
        if Sh.Y < 4 then Sh.Y = 184
        dec Sh.Up
        if Sh.Up = 0 then Sh.St = Sh.Nx
    end select
    dec Steps
  end while
  return
end sub

' 1 when the saucer touches a mine: the saucer's box (x+2..x+13, y+3..y+10)
' against each row's body (lines 1-6) outside its gap; worked in y + 64
function HitMines as u8
  u8 Top = 0, Bot = 0, Gl = 0, Lt = 0, Rt = 0
  Res = 0
  Top = Py + 67
  Bot = Py + 74
  Lt = Px + 2
  Rt = Px + 13
  for Sk = 0 to 2
    if Gap[Sk] <> NoRow then
      Y64 = Sk * 80 + 88 - Phase
      if Bot > Y64 then
        if Top < Y64 + 7 then
          Gl = GapStart[Gap[Sk]] * 16 + 16
          if Lt + 2 <= Gl then Res = 1
          if Rt >= Gl + 49 then Res = 1
        end if
      end if
    end if
  next
  return Res

' 1 when the saucer's box meets the ship's (x+4..x+27, y+4..y+15)
function HitShip as u8
  if Px + 13 < Sh.X + 4 then return 0
  if Px + 2 > Sh.X + 27 then return 0
  if Py + 10 < Sh.Y + 4 then return 0
  if Py + 3 > Sh.Y + 15 then return 0
  return 1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: the scrolling tiles' patterns when the field moved, the rows of
' mines when they cross a tile row, then the sprites
sub DrawFrame:
  if Moved = 1 then
    Y64 = 88 - Phase
    Ofs = Y64 & 7
    W16 = Ofs
    W16 = W16 << 6
    copy ScrPat + W16 count 64 to vram.pattern + 1024
    copy ScrPat + W16 count 64 to vram.pattern + 3072
    copy ScrPat + W16 count 64 to vram.pattern + 5120
    copy ScrCol + W16 count 64 to vram.color + 1024
    if Ofs = 7 then Redraw = 1
  end if
  if Redraw = 1 then
    DrawRows
    Redraw = 0
  end if
  DrawSprites
  return
end sub

' each slot's three tile rows: the mines' top halves, bottom halves and the
' floor left behind (rows 2-23 only)
sub DrawRows:
  for Rr = 0 to 2
    Y64 = Rr * 80 + 88 - Phase
    Tr = Y64 >> 3
    for Pt = 0 to 2
      K = Tr + Pt
      if K >= 10 then
        if K <= 31 then
          K = K - 8
          RowAt(K, Pt, Gap[Rr])
        end if
      end if
    next
  next
  return
end sub

' one tile row: R screen row, Part 0 top halves, 1 bottom halves, 2 floor
sub RowAt(u8 R, u8 Part, u8 Gp)
  u16 Src = 0
  Addr = R
  Addr = Addr * 32 + 2
  if Gp = NoRow then
    fill TFloor count 28 at 2,R
    return
  end if
  if Part = 2 then
    fill TFloor count 28 at 2,R
    return
  end if
  Src = Gp * 28
  if Part = 0 then
    copy LineTop + Src count 28 to vram.name + Addr
  else
    copy LineBot + Src count 28 to vram.name + Addr
  end if
  return
end sub

' sprites 0-1 the saucer (dome, body) or its blast, 2-3 the ship
sub DrawSprites:
  if Dead > 0 then
    K = SEx1i
    if Dead > 44 then K = SEx0i
    set sprite 0 to Py - 1,Px,K,11
    set sprite 1 to Py - 1,Px,K + 4,8
  else
    set sprite 0 to Py - 1,Px,SDome,15
    set sprite 1 to Py - 1,Px,SBody,7
  end if
  set sprite 2 to Sh.Y - 1,Sh.X,SShl,11
  set sprite 3 to Sh.Y - 1,Sh.X + 16,SShr,11
  update sprites
  ShowStatus
  return
end sub

sub ShowStatus:
  print at 8,1, Score
  print at 18,1, Hi
  return
end sub

' the spare saucers at the right of the status line
sub ShowLives:
  fill 32 count 3 at 26,1
  Spare = Lives - 1
  if Spare > 0 then
    for Li = 1 to Spare
      put char TLife at 25 + Li,1
    next
  end if
  return
end sub

' a clear canyon: no mines, the saucer and the ship at their starts, then a
' first row comes in at once (as on the C64)
sub ResetField:
  Rearm
  wait
  nmi off
  for Rr = 2 to 23
    fill TFloor count 28 at 2,Rr
  next
  for Sk = 0 to 2
    Gap[Sk] = NoRow
  next
  Phase = 0
  Frac = 0
  Px = 112
  Py = 48
  Sh.X = SxMin
  Sh.Y = 168
  Sh.St = 0
  Sh.Up = 0
  Sh.Nx = 1
  Sh.Fr = 0
  NewRow
  Moved = 1
  ShowLives
  DrawFrame
  return
end sub

sub NewGame:
  NewScreen
  for Rr = 2 to 23
    put char TWl0 at 0,Rr
    put char TWl1 at 1,Rr
    put char TWr0 at 30,Rr
    put char TWr1 at 31,Rr
  next
  print at 2,1, "SCORE"
  print at 15,1, "HI"
  Score = 0
  Rows = 0
  Spd = SpdStart
  ShSpd = ShStart
  Lives = 4
  Dead = 0
  Over = 0
  Hits = 0
  ShipHits = 0
  GPrev = Rs & 3
  ResetField
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: MINE CANYON in rock letters, a band of mines, the patrol ship
' sweeping below, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  print at 6,1, "AHOY! SEPTEMBER 1986"
  copy TitleMap count 352 to vram.name + 64
  for K = 1 to 14
    put char TTm0 at K * 2,14
    put char TTm1 at K * 2 + 1,14
  next
  print at 9,18, "BY JOHN KRUTCH"
  print at 13,20, "START"
  print at 13,21, "CREDITS"
  if Hi > 0 then
    print at 9,22, "BEST ", Hi
  end if
  ShowMenu
  Sh.X = SxMin
  Sh.St = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the ship patrols the title, a pixel a frame back and forth
sub TitleAnim:
  if Sh.St = 0 then
    inc Sh.X
    if Sh.X >= SxMax then Sh.St = 1
  else
    dec Sh.X
    if Sh.X <= SxMin then Sh.St = 0
  end if
  set sprite 2 to 118,Sh.X,SShl,11
  set sprite 3 to 118,Sh.X + 16,SShr,11
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 20
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "MINE CANYON"
  print at 2,5, "BASED ON MINE CANYON BY"
  print at 2,6, "JOHN KRUTCH, AHOY!"
  print at 2,7, "SEPTEMBER 1986 (COMMODORE"
  print at 2,8, "64 MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: CANYON ECHO"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

