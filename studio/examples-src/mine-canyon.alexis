    db $09,$01,$10,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$06,$01,$0D,$01
    db $06,$01,$0D,$01,$0B,$01,$12,$01,$0B,$01,$12,$01,$04,$01,$0B,$01
    db $04,$01,$0B,$01,$09,$01,$10,$01,$06,$01,$0D,$01,$0B,$01,$01,$01
    db $06,$01,$00,$01
