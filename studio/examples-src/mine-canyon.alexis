    db $50
McBoom:
    db $00,$00,$06,$05,$00,$00,$26,$05,$00,$00,$36,$05,$00,$00,$56,$05,$00,$00,$66,$05,$00,$00,$87,$05
    db $00,$00,$97,$05,$00,$00,$B7,$05,$00,$00,$C7,$05,$00,$00,$E7,$05,$10
McStart:
