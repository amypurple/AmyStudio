McSoundTable:
    dw McTuneMel,$702B
    dw McTuneBass,$7035
    dw McRow,$7049
    dw McFall,$7049
    dw McBoom,$703F
    dw McStart,$7049
    dw McOver,$7049
; Canyon Echo (original)
; Tiny Sound, 8 frames per step
McTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$23,$01,$1E,$01,$26,$01,$01,$25,$01,$23,$01,$21
    db $01,$1E,$01,$01,$1C,$01,$1E,$01,$21,$01,$23,$01,$01,$01,$1E,$01
    db $1A,$01,$23,$01,$26,$01,$2A,$01,$01,$28,$01,$26,$01,$25,$01,$21
    db $01,$23,$01,$25,$01,$1E,$01,$01,$01,$23,$01,$17,$01,$01,$01,$01
    db $01,$01,$00,$01
    db $FF
McTuneBass:
