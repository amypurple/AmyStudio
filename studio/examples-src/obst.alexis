record Cycle:
  u8 X
  u8 Y
  u8 Ox
  u8 Oy
  u8 Dir
  u8 Want
  u8 Dead
  u8 Score
end record

Cycle Cy[2]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Time = 0
u8 Players = 1
u8 Speed = 1
u8 Menu = 2
u8 Spd = 8
u8 Gap = 3
u8 El = 0
u8 Mode = 0
u8 Over = 0
u8 Winner = 0
u8 Cf = 0
u8 Rounds = 0
u8 Boths = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Rep = 0
' loop counter (never shared with the helpers)
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0

  tile screen
  set sound table ObSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then
    HowToPage
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  NewGame

round_start:
  NewRound

play_loop:
  Frame1
  ReadPads
  PlayFrame
  DrawSprites
  if Mode = 3 then goto round_start
  if Mode <> 2 then goto play_loop

  ' game over: YOU WON over the winner, as on the C-128, and a box
  print at 7,10, "                "
  if Winner = 0 then
    print at 2,1, "YOU WON"
    print at 7,11, "   BLUE  WINS   "
  else
    print at 23,1, "YOU WON"
    if Players = 1 then
      print at 7,11, " COMPUTER  WINS "
    else
      print at 7,11, "  PURPLE  WINS  "
    end if
  end if
  print at 7,12, "                "
  mute all
  play sound SndWin
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayFrame:
  select case Mode
    case 0
      inc El
      if El >= Spd then
        El = 0
        OneStep
      end if
    case 1
      ' the crash burst, then the next round or the end
      inc Cf
      if Cf = 90 then
        if Over = 1 then
          Mode = 2
        else
          Mode = 3
        end if
      end if
  end select
  return
end sub

' one pass of the listing's loop: blue, then purple; when purple crashed
' blue takes one more step (lines 210-230)
sub OneStep:
  u8 D = 0
  inc Time
  D = Cy[0].Want
  Cy[0].Dead = MoveHead(0, D)
  if Players = 1 then
    D = AiDir()
  else
    D = Cy[1].Want
  end if
  Cy[1].Dead = MoveHead(1, D)
  if Cy[1].Dead = 1 and Cy[0].Dead = 0 then
    D = Cy[0].Dir
    Cy[0].Dead = MoveHead(0, D)
  end if
  if Cy[0].Dead = 1 or Cy[1].Dead = 1 then
    EndRound
  else
    play sound SndStep
  end if
  return
end sub

' moves player P one cell in direction D; 1 when it crashed (it stays)
function MoveHead(u8 P, u8 D) as u8
  u8 Nx = 0
  u8 Ny = 0
  u8 Got = 0
  u8 Res = 0
  u8 B = 0
  Cy[P].Dir = D
  Nx = Cy[P].X + DX[D]
  Ny = Cy[P].Y + DY[D]
  Got = get char at Nx, Ny
  if Got <> TFloor then
    Res = 1
  else
    ' the cell left behind becomes an obstacle block
    B = BlockOf[P]
    put char B at Cy[P].X, Cy[P].Y
    put char TRes at Nx, Ny
    Cy[P].Ox = Cy[P].X
    Cy[P].Oy = Cy[P].Y
    Cy[P].X = Nx
    Cy[P].Y = Ny
  end if
  return Res

' the points: a crash scores for the other player, both crashing for both
sub EndRound:
  u8 S0 = 0
  u8 S1 = 0
  for Di = 0 to 1
    Cy[Di].Ox = Cy[Di].X
    Cy[Di].Oy = Cy[Di].Y
  next
  if Cy[0].Dead = 1 then
    inc Cy[1].Score
    print at 2,1, "CRASHED"
  end if
  if Cy[1].Dead = 1 then
    inc Cy[0].Score
    print at 23,1, "CRASHED"
  end if
  if Cy[0].Dead = 1 and Cy[1].Dead = 1 then
    print at 7,12, "YOU BOTH CRASHED"
    inc Boths
    play sound SndBoth
  else
    play sound SndCrash
  end if
  S0 = Cy[0].Score
  S1 = Cy[1].Score
  if S0 >= WinPts and S0 > S1 then
    Over = 1
    Winner = 0
  end if
  if S1 >= WinPts and S1 > S0 then
    Over = 1
    Winner = 1
  end if
  inc Rounds
  El = 0
  Cf = 0
  Mode = 1
  ShowScores
  return
end sub

' the computer (purple): straight on while there is room, a turn now and
' then at random, and towards the longer free line when blocked
function AiDir() as u8
  u8 D = 0
  u8 A = 0
  u8 Lt = 0
  u8 Rt = 0
  u8 Lv = 0
  u8 Rv = 0
  u8 S = 0
  u8 Sv = 0
  u8 R = 0
  Rand
  R = lowbyte Rs
  D = Cy[1].Dir
  A = Ray(D)
  Lt = (D + 3) & 3
  Rt = (D + 1) & 3
  Lv = Ray(Lt)
  Rv = Ray(Rt)
  if Lv > Rv then
    S = Lt
    Sv = Lv
  else
    S = Rt
    Sv = Rv
  end if
  ' with room on both sides it picks one at random (it cannot judge which
  ' side has more space beyond its short sight)
  if Lv > 0 and Rv > 0 then
    if (R & 16) = 0 then
      S = Lt
      Sv = Lv
    else
      S = Rt
      Sv = Rv
    end if
  end if
  if A >= 3 then
    if (R & 7) = 0 and Sv >= 2 then D = S
  else
    ' a person-like slip: now and then it turns one step too late
    if Sv > A then
      if A = 0 or (R & 1) <> 0 then D = S
    end if
  end if
  ' and one time in eight it misses a wall right in front
  if A = 0 and (R & 96) = 0 then D = Cy[1].Dir
  return D

' free cells in a line from the purple head in direction D (at most 4)
function Ray(u8 D) as u8
  u8 N = 0
  u8 Rx = 0
  u8 Ry = 0
  u8 Go = 1
  Rx = Cy[1].X
  Ry = Cy[1].Y
  while Go = 1
    Rx = Rx + DX[D]
    Ry = Ry + DY[D]
    C = get char at Rx, Ry
    if C = TFloor then
      inc N
      if N = 4 then Go = 0
    else
      Go = 0
    end if
  end while
  return N

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the arrow heads, 2-3 the crash bursts
sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Off = 0
  u8 D = 0
  u8 Pat = 0
  u8 Col = 0
  u8 Hx = 0
  u8 Hy = 0
  Off = El * 8
  Off = Off / Spd
  for Di = 0 to 1
    Hx = Cy[Di].X
    Hy = Cy[Di].Y
    D = Cy[Di].Dir
    Sx = Cy[Di].Ox * 8
    Sy = Cy[Di].Oy * 8
    if Hx <> Cy[Di].Ox or Hy <> Cy[Di].Oy then
      select case D
        case 0
          Sy = Sy - Off
        case 1
          Sx = Sx + Off
        case 2
          Sy = Sy + Off
        case 3
          Sx = Sx - Off
      end select
    end if
    Sy = Sy - 1
    Pat = D * 4
    Col = HeadCol[Di]
    set sprite Di to Sy,Sx,Pat,Col
    ' the burst over a crashed head, kept inside columns 2-29, rows 1-22
    K = Di + 2
    if Mode = 1 and Cy[Di].Dead = 1 and Cf < 60 then
      J = Cf / 10
      J = J & 1
      Pat = J * 4 + SBoom0
      Sx = Hx * 8 - 4
      Sy = Hy * 8 - 5
      if Sx < 16 then Sx = 16
      if Sx > 224 then Sx = 224
      if Sy < 7 then Sy = 7
      if Sy > 167 then Sy = 167
      set sprite K to Sy,Sx,Pat,11
    else
      set sprite K to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowScores:
  NumU = Cy[0].Score
  print at 2,22, "BLUE ", digits$(NumU, 2)
  NumU = Cy[1].Score
  if Players = 1 then
    print at 21,22, "   CPU ", digits$(NumU, 2)
  else
    print at 21,22, "PURPLE ", digits$(NumU, 2)
  end if
  return
end sub

' a fresh field: the border in the players' colours with its two gaps,
' both heads on the middle row moving the same way
sub NewRound:
  u8 Row = 0
  u8 R = 0
  u8 D = 0
  u8 Top = 0
  u8 Bot = 0
  NewScreen
  Rand
  R = lowbyte Rs
  K = R mod 6
  Cy[0].X = 8 + K
  K = R >> 3
  K = K mod 6
  Cy[1].X = 16 + K
  Gap = R >> 6
  Gap = Gap + 3
  Rand
  D = lowbyte Rs
  D = D & 3
  Top = 2 + Gap
  Bot = 21 - Gap
  fill TBlkp count 28 at 2,2
  fill TBlkb count 28 at 2,21
  for Row = 3 to 20
    if Row <= Top then
      put char TFloor at 2,Row
    else
      put char TBlkb at 2,Row
    end if
    fill TFloor count 26 at 3,Row
    if Row >= Bot then
      put char TFloor at 29,Row
    else
      put char TBlkp at 29,Row
    end if
  next
  print at 10,1, "OBSTACLE 128"
  print at 11,22, "5 TO WIN"
  ShowScores
  for Di = 0 to 1
    Cy[Di].Y = MidRow
    Cy[Di].Dir = D
    Cy[Di].Want = D
    Cy[Di].Dead = 0
    Cy[Di].Ox = Cy[Di].X
    Cy[Di].Oy = Cy[Di].Y
    put char TRes at Cy[Di].X, Cy[Di].Y
  next
  Time = 0
  El = 0
  Cf = 0
  Mode = 0
  DrawSprites
  ShowScreen
  play sound SndGo
  Rearm
  wait 45 frames
  nmi off
  WasBtn = 0
  return
end sub

sub NewGame:
  Cy[0].Score = 0
  Cy[1].Score = 0
  Spd = StepFr[Speed]
  Over = 0
  Winner = 0
  Rounds = 0
  Boths = 0
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' one stick: 1 up, 2 right, 4 down, 8 left, 16 a button
function Stick(u8 N) as u8
  u8 S = 0
  if joypad(N).up then S = S | 1
  if joypad(N).right then S = S | 2
  if joypad(N).down then S = S | 4
  if joypad(N).left then S = S | 8
  if joypad(N).fire then S = S | 16
  return S

' a stick held in exactly one direction sets that player's next turn
sub TakeDir(u8 P, u8 S):
  u8 Dd = NoDir
  S = S & 15
  select case S
    case 1
      Dd = 0
    case 2
      Dd = 1
    case 4
      Dd = 2
    case 8
      Dd = 3
  end select
  if Dd <> NoDir then Cy[P].Want = Dd
  return
end sub

sub ReadPads:
  J1 = Stick(1)
  J2 = Stick(2)
  TakeDir(0, J1)
  if Players = 2 then TakeDir(1, J2)
  Btn = (J1 | J2) & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $B0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub ShowMenu:
  if Players = 1 then
    print at 4,14, "PLAYERS  < 1 >  VS CPU "
  else
    print at 4,14, "PLAYERS  < 2 >         "
  end if
  NumU = Speed + 1
  print at 4,15, "SPEED    < ", digits$(NumU, 1), " >"
  for J = 14 to 18
    put char 32 at 2,J
  next
  J = Menu + 14
  put char 62 at 2,J
  return
end sub

' the title: the block logo, the menu, the tune once
sub TitlePage:
  u8 Last = 0
  Menu = 2
  NewScreen
  for Di = 0 to 7
    W16 = Di * 28
    copy TitleMap + W16 count 28 to vram.name + (Di + 2) * 32 + 2
  next
  print at 2,11, "COMPUTE!'S GAZETTE NOV 1986"
  print at 4,16, "START"
  print at 4,17, "HOW TO PLAY"
  print at 4,18, "CREDITS"
  ShowMenu
  print at 4,20, "UP/DOWN: CHOOSE A LINE"
  print at 4,21, "LEFT/RIGHT: CHANGE IT"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Rep = 0
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPads
  J = J1 & 15
  if J <> Last then
    Rep = 0
  else
    inc Rep
    if Rep = 15 then Rep = 0
  end if
  Last = J
  if J > 0 and Rep = 0 then
    select case J
      case 1
        if Menu > 0 then dec Menu
      case 4
        if Menu < 4 then inc Menu
      case 2
        if Menu = 0 then Players = 2
        if Menu = 1 and Speed < 2 then inc Speed
      case 8
        if Menu = 0 then Players = 1
        if Menu = 1 and Speed > 0 then dec Speed
    end select
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "BLUE AND PURPLE EACH DRAW A"
    print at 2,4, "WALL OF BLOCKS THAT NEVER"
    print at 2,5, "STOPS GROWING. DON'T RUN"
    print at 2,6, "INTO ANY WALL, YOURS TOO!"
    print at 2,8, "PUSH THE STICK UP, DOWN,"
    print at 2,9, "LEFT OR RIGHT TO TURN."
    print at 2,10, "CONTROLLER 1 IS BLUE,"
    print at 2,11, "CONTROLLER 2 IS PURPLE (OR"
    print at 2,12, "THE COMPUTER IN A 1 PLAYER"
    print at 2,13, "GAME)."
    fill TBlkb count 8 at 4,17
    for J = 15 to 16
      put char TBlkb at 11,J
    next
    fill TBlkp count 9 at 18,19
    for J = 17 to 18
      put char TBlkp at 18,J
    next
    set sprite 0 to 111,88,SAup,HeadCol[0]
    set sprite 1 to 127,144,SAup,HeadCol[1]
  else
    print at 2,1, "SCORING                2/2"
    print at 2,3, "WHEN ONE PLAYER CRASHES,"
    print at 2,4, "THE OTHER GETS A POINT."
    print at 2,5, "BOTH CRASH: BOTH SCORE."
    print at 2,6, "THEN A NEW ROUND STARTS."
    print at 2,8, "FIRST TO 5 POINTS, AND"
    print at 2,9, "AHEAD, WINS THE GAME."
    print at 2,11, "THE BORDER HAS TWO GAPS,"
    print at 2,12, "BUT GOING OUT IS A CRASH."
    print at 2,14, "TIP: STAY AWAY FROM THE"
    print at 2,15, "EDGES AND TRY TO CUT YOUR"
    print at 2,16, "RIVAL OFF FROM THE OPEN"
    print at 2,17, "SPACE."
    set sprite 2 to 151,120,SBoom0,11
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPads
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "OBSTACLE 128"
  print at 2,5, "BASED ON OBSTACLE 128,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "NOVEMBER 1986 (COMMODORE"
  print at 2,8, "128 BASIC 7.0)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: BLOCKADE LINES"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

