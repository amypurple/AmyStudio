  $80,$80,$86,$87,$80,$87,$87,$80,$87,$87,$80,$80,$85,$80,$85,$80,$85,$86,$87,$80,$87,$87,$85,$87,$87,$85,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$9C,$80,$80,$A0,$98,$80,$A0,$98,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$9F,$80,$96,$80,$9E,$9E,$80,$9E,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$9E,$80,$80,$9C,$95,$9C,$97,$9D,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$80,$80,$A2,$98,$9C,$A1,$A0,$96,$A0,$9A,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
