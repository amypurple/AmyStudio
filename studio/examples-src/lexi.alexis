data Wd46 bytes 6, 15, 8, 17, 0, 19, 4
data Wd47 bytes 8, 19, 17, 4, 0, 18, 20, 17, 4
data Wd48 bytes 6, 8, 18, 11, 0, 13, 3
data Wd49 bytes 6, 9, 20, 13, 6, 11, 4
data Wd50 bytes 5, 19, 8, 6, 4, 17
data Wd51 bytes 5, 25, 4, 1, 17, 0
data Wd52 bytes 7, 6, 8, 17, 0, 5, 5, 4
data Wd53 bytes 7, 15, 4, 13, 6, 20, 8, 13
data Wd54 bytes 7, 3, 14, 11, 15, 7, 8, 13
data Wd55 bytes 6, 19, 20, 17, 19, 11, 4
data Wd56 bytes 6, 17, 0, 1, 1, 8, 19
data Wd57 bytes 6, 18, 15, 8, 3, 4, 17
data Wd58 bytes 6, 22, 8, 13, 19, 4, 17
data Wd59 bytes 6, 18, 20, 12, 12, 4, 17
data Wd60 bytes 7, 19, 7, 20, 13, 3, 4, 17
data Wd61 bytes 7, 17, 0, 8, 13, 1, 14, 22
data Wd62 bytes 7, 21, 14, 11, 2, 0, 13, 14
data Wd63 bytes 6, 7, 14, 2, 10, 4, 24
data WordTab words
  @Wd0, @Wd1, @Wd2, @Wd3, @Wd4, @Wd5, @Wd6, @Wd7
  @Wd8, @Wd9, @Wd10, @Wd11, @Wd12, @Wd13, @Wd14, @Wd15
  @Wd16, @Wd17, @Wd18, @Wd19, @Wd20, @Wd21, @Wd22, @Wd23
  @Wd24, @Wd25, @Wd26, @Wd27, @Wd28, @Wd29, @Wd30, @Wd31
  @Wd32, @Wd33, @Wd34, @Wd35, @Wd36, @Wd37, @Wd38, @Wd39
  @Wd40, @Wd41, @Wd42, @Wd43, @Wd44, @Wd45, @Wd46, @Wd47
  @Wd48, @Wd49, @Wd50, @Wd51, @Wd52, @Wd53, @Wd54, @Wd55
  @Wd56, @Wd57, @Wd58, @Wd59, @Wd60, @Wd61, @Wd62, @Wd63
end data
const NWords = 64
const FieldC = 6
const FieldR = 6
const FW = 20
const FH = 15
const NCells = 300
const NHide = 10
const EnMax = 15
const EnStart = 7
const SlideN = 8
const MsgN = 150
const NSpr = 4
const BarL = 3
const BarR = 28

' the eight directions of the original's DX/DY table (line 1190), as
' bytes that wrap: 255 is -1
data DXT bytes
  0, 1, 0, 255, 255, 1, 1, 255
end data
data DYT bytes
  1, 0, 255, 0, 1, 1, 255, 255
end data
' direction count by level: 2, 4, 8 (the original's 2^LV)
data NDirT bytes
  0, 2, 4, 8
end data
data LogoT bytes
  TGL00, TGE00, TGX00, TGI00, TGT00, TGR00, TGO00, TGN00
end data

record Hidden:
  u8 Num
  u8 Len
  u8 Got
  u8 Col
  u8 Row
  u8 Dir
end record

Hidden Hid[NHide]
u8 Grid[NCells]
u8 Perm[NWords]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Wp = 0
u16 NumU = 0
u16 Gi = 0
u16 Secs = 0
u16 Hi = 0
u8 Fr = 0
u8 Lv = 1
u8 En = 7
u8 GW = 0
u8 Over = 0
u8 MsgT = 0
' the cursor: cell, sprite corner, frames left of the slide, its step
u8 Cc = 0
u8 Cr = 0
u8 Px = 0
u8 Py = 0
u8 Ph = 0
u8 Mdx = 0
u8 Mdy = 0
u8 FireQ = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Wn = 0
u8 Pi = 0
u8 Ri = 0
u8 Li = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 L = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0
u8 Ok = 0

  tile screen
  set sound table LxSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  set sprite 0 to 192,0,0,0
  update sprites
  if Over = 2 then
    if Hi = 0 then Hi = Secs
    if Secs < Hi then Hi = Secs
    print at 2,22, "CONGRATULATIONS! YOU WON!   "
    play sound SndWin
  else
    Reveal
    print at 2,22, "SORRY, YOU DIDN'T MAKE IT.  "
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' small helpers

' 16-bit xorshift (7, 9, 8)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a number 0 .. N-1 from the high byte of the generator
function RndN(u8 Lim) as u8
  u16 Wide = 0
  Rand
  Wide = highbyte Rs
  Wide = Wide * Lim
  return highbyte Wide

' the grid index of a cell
function CellAt(u8 Col, u8 Row) as u16
  u16 Ix = 0
  Ix = Row
  Ix = Ix * FW
  Ix = Ix + Col
  return Ix

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Fr
  if Fr >= 60 then
    Fr = 0
    if Secs < 5999 then Secs += 1
    ShowTime
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearMsg
  end if
  ' the original's chances each loop: a clue, then a drain
  Rand
  W16 = Rs & 1023
  if W16 = 1023 then
    TryClue
  elseif W16 < 3 then
    Drain
  end if
  if Over > 0 then return
  if Press = 1 then FireQ = 1
  if Ph > 0 then
    Px = Px + Mdx
    Py = Py + Mdy
    dec Ph
  else
    TryMove
  end if
  if Ph = 0 then
    if FireQ = 1 then
      FireQ = 0
      Mark
    end if
  end if
  return
end sub

' the stick: one cell in any of the eight directions; at the edge a
' diagonal keeps its free axis
sub TryMove:
  K = J1 | J2
  Mdx = 0
  Mdy = 0
  select case K & 12
  case 4
    if Cc > 0 then Mdx = 255
  case 8
    if Cc < 19 then Mdx = 1
  end select
  select case K & 3
  case 1
    if Cr > 0 then Mdy = 255
  case 2
    if Cr < 14 then Mdy = 1
  end select
  V = Mdx | Mdy
  if V > 0 then
    Cc = Cc + Mdx
    Cr = Cr + Mdy
    Ph = SlideN
    play sound SndTick
  end if
  return
end sub

' the button on the letter under the cursor
sub Mark:
  Gi = CellAt(Cc, Cr)
  V = Grid[Gi]
  if V >= 128 then return
  if V = 0 then
    ShowMsg(1)
    Drain
    return
  end if
  Grid[Gi] = V | 128
  K = V - 1
  X = Cc + FieldC
  Y = Cr + FieldR
  T = get char at X,Y
  T = T - TLA
  T = T + TFA
  put char T at X,Y
  Hid[K].Got += 1
  if En < EnMax then inc En
  DrawBars
  N = Hid[K].Got
  if N = Hid[K].Len then
    inc GW
    play sound SndWord
    ShowWords
    if GW = NHide then
      Over = 2
    else
      ShowMsg(2)
    end if
  else
    if N & 1 then
      play sound SndGood
    else
      play sound SndGood2
    end if
    ShowMsg(0)
  end if
  return
end sub

sub Drain:
  play sound SndDrain
  if En = 0 then
    Over = 1
  else
    dec En
    DrawBars
  end if
  return
end sub

' a clue for a random word, only if none of its letters is found
sub TryClue:
  K = highbyte Rs
  K = K % 10
  if Hid[K].Got = 0 then
    ClearMsg
    print at 2,22, "CLUE:"
    N = Hid[K].Num
    W16 = WordTab[N]
    L = peek(W16)
    X = 8
    for Li = 1 to L
      W16 += 1
      T = peek(W16) + 65
      put char T at X,22
      inc X
    next
    MsgT = MsgN
    play sound SndClue
  end if
  return
end sub

sub ShowMsg(u8 Which):
  ClearMsg
  select case Which
  case 0
    print at 2,22, "GOOD ANSWER"
  case 1
    print at 2,22, "TRY ANOTHER"
  case else
    print at 2,22, "WELL DONE!"
  end select
  MsgT = MsgN
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,22
  return
end sub

' the cursor sprite (sprite 0)
sub DrawCursor:
  Y = Py - 1
  V = Tick >> 4
  V = V & 1
  C = 15
  if V = 1 then C = 11
  set sprite 0 to Y,Px,SRing,C
  update sprites
  return
end sub

sub ShowTime:
  W16 = Secs / 60
  NumU = W16
  print at 25,3, digits$(NumU, 2)
  W16 = W16 * 60
  NumU = Secs - W16
  print at 28,3, digits$(NumU, 2)
  return
end sub

sub ShowWords:
  NumU = GW
  print at 17,3, digits$(NumU, 2)
  return
end sub

' the two energy tubes: En cells lit from the bottom, red when low
sub DrawBars:
  T = TEon
  if En <= 3 then T = TElow
  for Ri = 0 to 14
    U = TEoff
    if Ri < En then U = T
    Y = 20 - Ri
    put char U at BarL,Y
    put char U at BarR,Y
  next
  return
end sub

' the end of a lost game: the missed letters in red
sub Reveal:
  Gi = 0
  for Ri = 0 to 14
    Y = Ri + FieldR
    for Li = 0 to 19
      V = Grid[Gi]
      if V > 0 then
        if V < 128 then
          X = Li + FieldC
          T = get char at X,Y
          T = T - TLA
          T = T + TRA
          put char T at X,Y
        end if
      end if
      Gi += 1
    next
  next
  return
end sub

' ---------------------------------------------------------------------------
' a new field

sub Shuffle:
  for Pi = 0 to NWords - 1
    Perm[Pi] = Pi
  next
  for Pi = 0 to NWords - 1
    J = RndN(NWords)
    swap Perm[Pi] with Perm[J]
  next
  return
end sub

' tries to hide word Perm[Pi] as hidden word Wn; Ok = 1 when it fits
sub TryWord:
  N = Perm[Pi]
  Wp = WordTab[N]
  L = peek(Wp)
  D = NDirT[Lv]
  D = RndN(D)
  C = RndN(FW)
  R = RndN(FH)
  Ok = 1
  X = C
  Y = R
  for Li = 1 to L
    if X >= FW then Ok = 0
    if Y >= FH then Ok = 0
    if Ok = 1 then
      Gi = CellAt(X, Y)
      if Grid[Gi] > 0 then Ok = 0
    end if
    X = X + DXT[D]
    Y = Y + DYT[D]
  next
  if Ok = 1 then
    with Hid[Wn] as Hw
      Hw.Num = N
      Hw.Len = L
      Hw.Got = 0
      Hw.Col = C
      Hw.Row = R
      Hw.Dir = D
    end with
    X = C
    Y = R
    V = Wn + 1
    for Li = 1 to L
      Gi = CellAt(X, Y)
      Grid[Gi] = V
      Wp += 1
      T = peek(Wp) + TLA
      U = X + FieldC
      K = Y + FieldR
      put char T at U,K
      X = X + DXT[D]
      Y = Y + DYT[D]
    next
  end if
  return
end sub

sub PlaceWords:
  fill array Grid with 0
  Shuffle
  Pi = 0
  for Wn = 0 to NHide - 1
    Got = 0
    while Got = 0
      for U = 1 to 60
        if Got = 0 then
          TryWord
          if Ok = 1 then Got = 1
        end if
      next
      if Got = 0 then inc Pi
    end while
    inc Pi
  next
  ' every other cell a random letter
  Gi = 0
  for Ri = 0 to 14
    Y = Ri + FieldR
    for Li = 0 to 19
      if Grid[Gi] = 0 then
        T = RndN(26) + TLA
        X = Li + FieldC
        put char T at X,Y
      end if
      Gi += 1
    next
  next
  return
end sub

sub DrawLogo:
  X = LogoX
  for Li = 0 to 7
    T = LogoT[Li]
    put char T at X,1
    U = T + 1
    put char U at X + 1,1
    U = T + 2
    put char U at X,2
    U = T + 3
    put char U at X + 1,2
    X = X + 2
  next
  return
end sub

sub DrawFrame:
  put char TXtl at 5,5
  put char TXtr at 26,5
  put char TXbl at 5,21
  put char TXbr at 26,21
  fill TXh count 20 at 6,5
  fill TXb count 20 at 6,21
  for Ri = 6 to 20
    put char TXl at 5,Ri
    put char TXr at 26,Ri
  next
  return
end sub

sub NewGame:
  NewScreen
  DrawLogo
  DrawFrame
  print at 2,3, "LEVEL"
  NumU = Lv
  print at 8,3, digits$(NumU, 1)
  print at 11,3, "WORDS"
  print at 19,3, "/10"
  print at 27,3, ":"
  PlaceWords
  En = EnStart
  GW = 0
  Secs = 0
  Fr = 0
  MsgT = 0
  Over = 0
  FireQ = 0
  DrawBars
  ShowWords
  ShowTime
  Cc = 10
  Cr = 7
  Ph = 0
  Px = Cc * 8
  Px = Px + 44
  Py = Cr * 8
  Py = Py + 44
  DrawCursor
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, the rules in brief, the level menu, the tune once
sub TitlePage:
  NewScreen
  DrawLogo
  print at 9,4, "BY RON WILSON"
  print at 4,5, "COMPUTE!'S GAZETTE 1986"
  print at 2,7, "TEN WORDS HIDE AMONG THE"
  print at 2,8, "LETTERS. PRESS THE BUTTON ON"
  print at 2,9, "EACH LETTER OF A WORD. WRONG"
  print at 2,10, "LETTERS AND TIME DRAIN YOUR"
  print at 2,11, "ENERGY. FIND ALL TEN TO WIN."
  print at 5,13, "LEVEL 1  FORWARDS"
  print at 5,14, "LEVEL 2  BACKWARDS TOO"
  print at 5,15, "LEVEL 3  DIAGONALS TOO"
  print at 5,16, "HOW TO PLAY"
  print at 5,17, "CREDITS"
  print at 2,19, "BEST TIME"
  if Hi > 0 then
    W16 = Hi / 60
    NumU = W16
    print at 12,19, digits$(NumU, 2)
    print at 14,19, ":"
    W16 = W16 * 60
    NumU = Hi - W16
    print at 15,19, digits$(NumU, 2)
  else
    print at 12,19, "--:--"
  end if
  for Li = 0 to 25
    T = TLA + Li
    if Li >= 13 then
      Y = 21
      X = Li - 11
    else
      Y = 20
      X = Li + 2
    end if
    X = X + X
    X = X - 1
    put char T at X,Y
  next
  Menu = Lv - 1
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 540
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 4 then inc Menu
      end if
      ShowMenu
      play sound SndTick
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then HowToPage
  if Menu = 4 then CreditsPage
  if Menu < 3 then Lv = Menu + 1
  return
end sub

sub ShowMenu:
  for Li = 13 to 17
    put char 32 at 3,Li
  next
  J = Menu + 13
  put char 62 at 3,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "TEN WORDS ARE HIDDEN IN A"
    print at 2,4, "FIELD OF LETTERS. FIND THEM"
    print at 2,5, "ALL TO WIN!"
    print at 2,7, "MOVE THE RING WITH THE"
    print at 2,8, "JOYSTICK AND PRESS THE"
    print at 2,9, "BUTTON ON EVERY LETTER OF A"
    print at 2,10, "WORD. FOUND LETTERS LIGHT"
    print at 2,11, "UP. LIGHT THEM ALL AND THE"
    print at 2,12, "WORD IS FOUND."
    for Ri = 14 to 19
      for Li = 6 to 25
        T = Ri * 7 + Li * 11
        T = T % 26
        T = T + TLA
        put char T at Li,Ri
      next
    next
    for Li = 0 to 3
      T = WordT[Li]
      put char T at Li + 10,16
    next
    for Ri = 0 to 2
      T = WordT[Ri + 4]
      put char T at 20,Ri + 15
    next
    set sprite 0 to 123,84,SRing,15
  else
    print at 2,1, "ENERGY                 2/2"
    print at 2,3, "THE TUBES SHOW YOUR ENERGY."
    print at 2,4, "A GOOD LETTER ADDS 1. A"
    print at 2,5, "LETTER IN NO WORD TAKES 1,"
    print at 2,6, "AND IT ALSO DRAINS AWAY BY"
    print at 2,7, "ITSELF. AT 0, GAME OVER:"
    print at 2,8, "THE MISSED WORDS SHOW RED."
    print at 2,10, "SOMETIMES A CLUE NAMES A"
    print at 2,11, "WORD YOU HAVE NOT STARTED."
    print at 2,13, "LEVEL 1: WORDS GO ACROSS"
    print at 2,14, "OR DOWN. LEVEL 2: BACKWARDS"
    print at 2,15, "TOO. LEVEL 3: DIAGONALS TOO."
    print at 2,17, "TIP: WHEN YOU FIND ONE"
    print at 2,18, "LETTER, LOOK AROUND IT FOR"
    print at 2,19, "THE NEXT ONE."
    for Ri = 0 to 5
      Y = 21 - Ri
      T = TEon
      if Ri >= 4 then T = TEoff
      put char T at 29,Y
    next
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  HtWt = HtWt + 1
  if HtWt >= 1800 then goto ht_out
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_out:
  HideSprites
  return
end sub

' WORD across and CAT down, lit, for the HOW TO PLAY picture
data WordT bytes TFW, TFO, TFR, TFD, TFC, TFA, TFT

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop dark blue
  DrawLogo
  print at 2,4, "BASED ON LEXITRON BY"
  print at 2,5, "RON WILSON, COMPUTE!'S"
  print at 2,6, "GAZETTE, FEBRUARY 1986"
  print at 2,7, "(COMMODORE 64 AND 128)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: LETTER LIGHTS"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

