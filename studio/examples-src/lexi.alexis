data Wd0 bytes 8, 2, 0, 17, 13, 8, 21, 0, 11
data Wd1 bytes 6, 2, 8, 17, 2, 20, 18
data Wd2 bytes 6, 2, 0, 13, 0, 3, 0
data Wd3 bytes 6, 20, 13, 8, 19, 4, 3
data Wd4 bytes 9, 19, 4, 11, 4, 15, 7, 14, 13, 4
data Wd5 bytes 6, 12, 14, 13, 10, 4, 24
data Wd6 bytes 8, 2, 14, 12, 15, 20, 19, 4, 17
data Wd7 bytes 8, 9, 14, 24, 18, 19, 8, 2, 10
