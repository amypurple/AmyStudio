i16 A = 0, B = 0, X = 0
u8 Pass = 0
u8 ABytes[2], BBytes[2], XBytes[2]

  text screen
  print at 4,0, "I16 DIVIDE LAB"
  print at 1,2, "RAW DEC A B R HI LO"

  A = -21
  B = 3
  X = A
  X /= B
  copy bytes of A to ABytes
  copy bytes of B to BBytes
  copy bytes of X to XBytes
  print ABytes[1] at 1,3 digits 3
  print ABytes[0] at 4,3 digits 3
  print BBytes[1] at 9,3 digits 3
  print BBytes[0] at 13,3 digits 3
  print XBytes[1] at 18,3 digits 3
  print XBytes[0] at 22,3 digits 3
  if X = -7 then
    Pass += 1
    print at 27,3, "PASS"
  else
    print at 27,3, "FAIL"
  end if

  print at 1,5, "21/-3"
  X = 21
  X /= -3
  if X = -7 then
    Pass += 1
    print at 22,5, "PASS"
  else
    print at 22,5, "FAIL"
  end if

  print at 1,7, "-21/-3"
  X = -21
  X /= -3
  if X = 7 then
    Pass += 1
    print at 22,7, "PASS"
  else
    print at 22,7, "FAIL"
  end if

  print at 1,9, "0/5"
  X = 0
  X /= 5
  if X = 0 then
    Pass += 1
    print at 22,9, "PASS"
  else
    print at 22,9, "FAIL"
  end if

  print at 1,11, "-32768/1"
  X = -32768
  X /= 1
  if X = -32768 then
    Pass += 1
    print at 22,11, "PASS"
  else
    print at 22,11, "FAIL"
  end if

  print at 1,13, "-32768/-1 WRAP"
  X = -32768
  X /= -1
  if X = -32768 then
    Pass += 1
    print at 22,13, "PASS"
  else
    print at 22,13, "FAIL"
  end if

  print at 1,15, "7/2"
  X = 7
  X /= 2
  if X = 3 then
    Pass += 1
    print at 22,15, "PASS"
  else
    print at 22,15, "FAIL"
  end if

  print at 1,19, "TOTAL"
  print Pass at 7,19 digits 3
  if Pass = 7 then
    print at 12,19, "PASS"
  else
    print at 12,19, "FAIL"
  end if
  screen on