cartridge "CLIMBER 5/JAMES ROGERS, COMPUTE!/1987"

' CLIMBER 5
' From "Climber 5" by James Rogers, COMPUTE! magazine, August 1987 (the
' original for the Atari 400/800/XL/XE in machine language; COMPUTE!
' added versions for the Commodore 64, Amiga, IBM PC/PCjr and Apple II).
' All credit belongs to the author.
'
' Historical context (summary of the article):
' "Play ball!" You are the ballboy, number 5, and the home team has only
' one baseball left: a home run has lodged it at the top of a building
' still under construction next to the stadium. Climb the building from
' the bottom right corner to the ball at the upper left, floor by floor
' and ladder by ladder, avoiding the moving obstacles. Each level is
' joined to the next by one or more ladders, and you must be lined up
' with a ladder to climb it. You have five players; touching a moving
' object costs one. Reach the ball and the next level is harder. The
' Commodore 64 version has sweepers to avoid at all costs and
' electrodes to jump over, five different buildings, objects coming
' only from the left on the first five levels and from both sides
' after that; the Amiga version adds hooks of various sizes, the short
' ones evaded by ducking.
'
' ColecoVision version in Amy by Amy Bienvenu, 2026.
' Controls (either joystick): left and right walk, up and down climb a
' ladder you stand at; down elsewhere ducks; the left button jumps; the
' right button pauses (the C64 version's SHIFT key). The keypad is not
' used.
' The game: five buildings, five floors each; electrodes (jump them),
' hooks (duck under them) and sweepers (jumping does not clear them:
' wait, or take a ladder) cross each floor one at a time; electrodes
' only on the first level, hooks from the second, sweepers from the
' third; from the left only on levels 1 to 5, from both sides after;
' faster and more often with each level. After the fifth building the
' first comes back, faster.
' From the Amiga listing (BASIC): the ladders of the five buildings
' (its mapdat lines; three ladders a floor in the first building, fewer
' later), long hooks to avoid and short ones to duck (the sweepers and
' hooks here), and its voice: "climber five", "ouch", "I got the ball"
' (synthesized, played as VoxPCM).
' Adaptation liberties: a score (500 per level and 10 per second left)
' and a countdown timer (time is of the essence, the article says),
' with a high score; the obstacles of the C64 and Amiga versions
' together; the right button as the pause key; an editorial page and an
' original ballpark title tune.
' Everything that matters stays in columns 2-29, inside the TV overscan.
' The ballboy is sprites 0 and 1, which never flicker; the obstacles
' and the ball take turns when more than four share a line. The frame
' loop is protected from the NMI.

const TSky = 128
const TBrace = 129
const TBrace2 = 130
const TColumn = 131
const TGirder = 132
const TLadL = 133
const TLadR = 134
const TLadLg = 135
const TLadRg = 136
const TLife = 137
const TLamp = 138
const TBldg = 139
const TBldgw = 140
const TGrass = 141
const TStand = 142
const SRunR1 = 0
const SRunR1c = 4
const SRunR2 = 8
const SRunR2c = 12
const SRunL1 = 16
const SRunL1c = 20
const SRunL2 = 24
const SRunL2c = 28
const SClimb1 = 32
const SClimb1c = 36
const SClimb2 = 40
const SClimb2c = 44
const SDuckR = 48
const SDuckRc = 52
const SDuckL = 56
const SDuckLc = 60
const SElec1 = 64
const SElec2 = 68
const SHook1 = 72
const SHook2 = 76
const SSweep1 = 80
const SSweep2 = 84
const SBall = 88
const SStitch = 92
const NTiles8 = 120
const SprBytes = 768
const SndStep = 1
const SndPick = 2
const SndJump = 3
const SndClimb = 4
const SndTick = 5
const SndHurt = 6
const SndBall = 7
const SndOver = 8
const SndTuneA = 9
const SndTuneB = 10

u8 HzT[5]
u8 HzX[5]
u8 HzF[5]
u8 HzD[5]
u8 HzW[5]
u16 Score = 0
u16 HighScore = 3000
u16 NumU = 0
u16 Dst16 = 0
u8 Lv = 1
u8 Bd = 0
u8 Lives = 5
u8 Tm = 99
u8 TmT = 0
u8 Px = 208
u8 Py = 0
u8 Fl = 0
u8 St = 0
u8 Dir = 1
u8 Anim = 0
u8 AnimT = 0
u8 JumpT = 0
u8 Jy = 0
u8 ClimbC = 0
u8 Spd = 0
u8 Hit = 0
u8 Paused = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 BtA = 0
u8 BtB = 0
u8 WasA = 0
u8 WasB = 0
u8 Mix = 0
u8 Tick = 0
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tg = 0
u8 Ax = 0
u8 Ay = 0
u8 Bx = 0
u8 By = 0
u8 Hy0 = 0
u8 Hy1 = 0
u8 Hx0 = 0
u8 Hx1 = 0
u8 Py0 = 0
u8 Py1 = 0
u8 Px0 = 0
u8 Px1 = 0
u8 Choice = 1

  tile screen
  set sound table C5SoundTable areas 4
  sprites 16x16
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  EditorialPage

title:
  TitlePage

new_game:
  Score = 0
  Lives = 5
  Lv = 1

level_start:
  V = Lv - 1
  Bd = V
  while Bd >= 5
    Bd -= 5
  end while
  DrawBuilding
  LevelCard

life_start:
  Px = 208
  Fl = 0
  Py = FloorTop[0]
  St = 0
  Dir = 0
  JumpT = 0
  Tm = 99
  TmT = 0
  Hit = 0
  for G = 0 to 4
    HzT[G] = 0
    HzW[G] = G * 30
    HzW[G] += 40
  next
  ShowStatus
  Rearm
  wait no fire
  nmi off

main_loop:
  Rearm
  wait
  nmi off
  inc Tick
  ReadPad
  ' right button: pause
  if BtB = 1 then
    if WasB = 0 then
      Paused = Paused ^ 1
      play sound SndPick
      if Paused = 1 then
        print at 12,2, "PAUSE"
      else
        fill 32 count 5 at 12,2
      end if
    end if
  end if
  WasB = BtB
  if Paused = 1 then goto main_loop
  MovePlayer
  MoveHazards
  CheckHits
  DrawSprites
  ' the clock
  inc TmT
  if TmT >= 60 then
    TmT = 0
    if Tm > 0 then dec Tm
    ShowTime
    if Tm < 10 then play sound SndTick
    if Tm = 0 then Hit = 1
  end if
  if Hit = 1 then goto lost_player
  ' the ball, top left
  if Fl = 4 then
    if St <> 1 then
      if Px < 40 then goto got_ball
    end if
  end if
  goto main_loop

lost_player:
  ' the Amiga version says "ouch"
  play voxpcm SayOuch
  nmi off
  play sound SndHurt
  for G = 0 to 40
    N = G & 4
    if N = 0 then
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
    else
      DrawPlayer
    end if
    update sprites
    Rearm
    wait 2 frames
    nmi off
  next
  dec Lives
  if Lives = 0 then goto game_over
  print at 9,11, "PLAYER LOST"
  Rearm
  wait 60 frames
  nmi off
  DrawRow11
  goto life_start

got_ball:
  HideSprites
  play voxpcm SayGotBall
  nmi off
  play sound SndBall
  print at 7,11, "YOU GOT THE BALL!"
  NumU = Tm * 10
  print at 7,12, "TIME BONUS"
  print at 19,12, digits$(NumU, 4)
  Score += NumU
  NumU = 500
  Score += NumU
  ShowStatus
  Rearm
  wait 150 frames
  nmi off
  if Lv < 99 then inc Lv
  goto level_start

game_over:
  HideSprites
  play sound SndOver
  print at 10,11, "GAME OVER"
  Rearm
  wait 150 frames
  nmi off
  if Score > HighScore then
    HighScore = Score
    print at 8,13, "NEW HIGH SCORE!"
    play sound SndBall
    Rearm
    wait 120 frames
    nmi off
  end if
  fill 32 count 28 at 2,11
  fill 32 count 28 at 2,13
  print at 9,11, "PLAY AGAIN"
  print at 9,13, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,11 step 2
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  BtA = 0
  BtB = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then BtA = 1
  if joypad(2).button1 then BtA = 1
  if joypad(1).button2 then BtB = 1
  if joypad(2).button2 then BtB = 1
  return
end sub

' Is there a ladder at the player's position going from floor Tg to Tg+1?
' (Tg = 255: none) The ladder's left pixel goes into ClimbC.
sub LadderAt:
  V = 255
  if Tg > 3 then return
  N = Bd * 12
  J = Tg * 3
  N += J
  for J = 0 to 2
    K = LadCol[N]
    if K < 32 then
      X = K * 8
      ' lined up: within 5 pixels
      if Px >= X then
        Y = Px - X
      else
        Y = X - Px
      end if
      if Y <= 5 then
        V = 1
        ClimbC = X
      end if
    end if
    inc N
  next
  return
end sub

sub MovePlayer:
  inc AnimT
  if St = 1 then
    ' on a ladder: up and down only
    if Up1 = 1 then
      Py -= 1
      inc AnimT
      V = Fl + 1
      if Py <= FloorTop[V] then
        Py = FloorTop[V]
        Fl = V
        St = 0
      end if
    elseif Dn1 = 1 then
      Py += 1
      inc AnimT
      if Py >= FloorTop[Fl] then
        Py = FloorTop[Fl]
        St = 0
      end if
    end if
    if AnimT >= 8 then
      AnimT = 0
      Anim = Anim ^ 1
      if Up1 = 1 then play sound SndClimb
      if Dn1 = 1 then play sound SndClimb
    end if
    return
  end if
  if St = 2 then
    ' a jump: up and down, still moving sideways
    inc JumpT
    ' up fast, a moment at the top, down fast
    V = 14
    if JumpT <= 7 then V = JumpT * 2
    if JumpT > 24 then
      V = 32 - JumpT
      V *= 2
    end if
    Jy = V
    if JumpT >= 32 then
      St = 0
      Jy = 0
    end if
  end if
  if St = 3 then St = 0
  if St = 0 then
    ' start a climb, a jump or a duck
    if Up1 = 1 then
      Tg = Fl
      LadderAt
      if V = 1 then
        St = 1
        Px = ClimbC
        return
      end if
    end if
    if Dn1 = 1 then
      Tg = 255
      if Fl > 0 then Tg = Fl - 1
      LadderAt
      if V = 1 then
        St = 1
        Px = ClimbC
        Fl = Tg
        V = Tg + 1
        Py = FloorTop[V]
        return
      end if
      St = 3
      return
    end if
    if BtA = 1 then
      if WasA = 0 then
        St = 2
        JumpT = 0
        play sound SndJump
      end if
    end if
  end if
  WasA = BtA
  ' walk
  V = 0
  if Lf1 = 1 then
    Dir = 1
    if Px > 16 then
      dec Px
      V = 1
    end if
  end if
  if Rt1 = 1 then
    Dir = 0
    if Px < 224 then
      inc Px
      V = 1
    end if
  end if
  if V = 1 then
    if AnimT >= 6 then
      AnimT = 0
      Anim = Anim ^ 1
      if St = 0 then play sound SndStep
    end if
  end if
  return
end sub

sub MoveHazards:
  ' how fast this level is: 1 pixel a frame, 2 on some frames
  Spd = Lv + 1
  if Spd > 6 then Spd = 6
  for G = 0 to 4
    if HzT[G] = 0 then
      if HzW[G] > 0 then
        dec HzW[G]
      else
        NewHazard
      end if
    else
      ' move: one pixel, plus one more on Spd frames of 8
      N = 1
      V = Tick & 7
      if V < Spd then N = 2
      X = HzX[G]
      if HzD[G] = 0 then
        X += N
        if X >= 230 then HzT[G] = 0
      else
        if X <= 12 then
          HzT[G] = 0
        else
          X -= N
        end if
      end if
      HzX[G] = X
      if HzT[G] = 0 then
        ' wait before the next one
        Mix += 41
        V = random(0, 90)
        V += Mix
        V = V & 127
        N = Lv * 6
        if N > 60 then N = 60
        if V > N then V -= N
        V += 25
        HzW[G] = V
      end if
    end if
  next
  return
end sub

' A new obstacle on floor G: which kinds this level allows, which side
sub NewHazard:
  Mix += 23
  N = random(0, 3)
  N += Mix
  N = N & 3
  ' electrodes; hooks from level 2; sweepers from level 3
  V = 1
  if Lv >= 2 then
    if N = 1 then V = 2
  end if
  if Lv >= 3 then
    if N = 2 then V = 3
  end if
  HzT[G] = V
  HzD[G] = 0
  ' from the left on levels 1 to 5, from either side after
  if Lv > 5 then
    N = Mix & 4
    if N > 0 then HzD[G] = 1
  end if
  HzX[G] = 12
  if HzD[G] = 1 then HzX[G] = 228
  return
end sub

' Touching an obstacle: boxes, in screen pixels
sub CheckHits:
  ' the ballboy's box
  Px0 = Px + 4
  Px1 = Px + 11
  Py0 = Py + 1
  if St = 3 then Py0 = Py + 8
  Py1 = Py + 15
  if St = 2 then
    Py0 -= Jy
    Py1 -= Jy
  end if
  for G = 0 to 4
    V = HzT[G]
    if V > 0 then
      Y = FloorTop[G]
      X = HzX[G]
      if V = 1 then
        Hx0 = X + 3
        Hx1 = X + 12
        Hy0 = Y + 9
        Hy1 = Y + 15
      elseif V = 2 then
        Hx0 = X + 5
        Hx1 = X + 11
        Hy0 = Y + 2
        Hy1 = Y + 6
      else
        Hx0 = X + 3
        Hx1 = X + 13
        Hy0 = Y
        Hy1 = Y + 15
      end if
      N = 1
      if Px1 < Hx0 then N = 0
      if Px0 > Hx1 then N = 0
      if Py1 < Hy0 then N = 0
      if Py0 > Hy1 then N = 0
      if N = 1 then Hit = 1
    end if
  next
  return
end sub

sub DrawPlayer:
  Y = Py - 1
  if St = 2 then Y -= Jy
  if St = 1 then
    V = SClimb1
    if Anim = 1 then V = SClimb2
  elseif St = 3 then
    V = SDuckR
    if Dir = 1 then V = SDuckL
  else
    if Dir = 0 then
      V = SRunR1
      if Anim = 1 then V = SRunR2
    else
      V = SRunL1
      if Anim = 1 then V = SRunL2
    end if
  end if
  set sprite 0 to Y,Px,V,15
  V += 4
  set sprite 1 to Y,Px,V,9
  return
end sub

sub DrawSprites:
  DrawPlayer
  ' the ball, sitting at the top left
  Y = FloorTop[4]
  Y -= 1
  set sprite 2 to Y,24,SBall,15
  set sprite 3 to Y,24,SStitch,8
  ' the obstacles
  N = Tick & 16
  for G = 0 to 4
    J = G + 4
    V = HzT[G]
    if V = 0 then
      set sprite J to 192,0,0,0
    else
      Y = FloorTop[G]
      Y -= 1
      X = HzX[G]
      if V = 1 then
        K = SElec1
        if N > 0 then K = SElec2
        set sprite J to Y,X,K,11
      elseif V = 2 then
        K = SHook1
        if N > 0 then K = SHook2
        Y -= 2
        set sprite J to Y,X,K,14
      else
        K = SSweep1
        if N > 0 then K = SSweep2
        set sprite J to Y,X,K,7
      end if
    end if
  next
  update sprites
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' The building: girders, ladders, columns behind
sub DrawBuilding:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  ' this building's girder colour
  V = GirdCol[Bd]
  fill mode 2 color thirds at TGirder count 1 with V
  N = V & 15
  V = $A0 + N
  fill mode 2 color thirds at TLadLg count 1 with V
  fill mode 2 color thirds at TLadRg count 1 with V
  backdrop black
  cls
  for Y = 3 to 21
    fill TSky count 28 at 2,Y
    put char TColumn at 3,Y
    put char TColumn at 11,Y
    put char TColumn at 19,Y
    put char TColumn at 27,Y
  next
  for G = 0 to 4
    Y = GirderRow[G]
    fill TGirder count 28 at 2,Y
  next
  ' the ladders: from a girder up through the next
  for G = 0 to 3
    N = Bd * 12
    J = G * 3
    N += J
    for I = 0 to 2
      K = LadCol[N]
      if K < 32 then
        V = G + 1
        Y = GirderRow[V]
        X = K + 1
        put char TLadLg at K,Y
        put char TLadRg at X,Y
        inc Y
        Ax = GirderRow[G]
        while Y < Ax
          put char TLadL at K,Y
          put char TLadR at X,Y
          inc Y
        end while
      end if
      inc N
    next
  next
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub LevelCard:
  print at 9,11, "BUILDING"
  NumU = Bd + 1
  print at 18,11, digits$(NumU, 1)
  print at 9,13, "LEVEL"
  NumU = Lv
  print at 18,13, digits$(NumU, 2)
  play sound SndPick
  Rearm
  wait 100 frames
  nmi off
  ' put back what the card covered
  DrawRow11
  return
end sub

' Rows 11 and 13 (inside floors 2 and 3), redrawn after a message
sub DrawRow11:
  for Y = 11 to 13
    fill TSky count 28 at 2,Y
    put char TColumn at 3,Y
    put char TColumn at 11,Y
    put char TColumn at 19,Y
    put char TColumn at 27,Y
  next
  ' ladders crossing those rows
  for G = 0 to 3
    N = Bd * 12
    J = G * 3
    N += J
    for I = 0 to 2
      K = LadCol[N]
      if K < 32 then
        V = G + 1
        Ay = GirderRow[V]
        Ax = GirderRow[G]
        X = K + 1
        for Y = 11 to 13
          if Y > Ay then
            if Y < Ax then
              put char TLadL at K,Y
              put char TLadR at X,Y
            end if
          end if
        next
      end if
      inc N
    next
  next
  return
end sub

sub ShowStatus:
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  print at 15,1, "LV"
  NumU = Lv
  print at 18,1, digits$(NumU, 2)
  ShowTime
  for G = 0 to 4
    X = G + 25
    V = 32
    if G < Lives then V = TLife
    put char V at X,2
  next
  print at 2,2, "HI"
  NumU = HighScore
  print at 5,2, digits$(NumU, 5)
  return
end sub

sub ShowTime:
  print at 22,1, "TIME"
  NumU = Tm
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count NTiles8 to vram.pattern + Dst16
    copy TileCol count NTiles8 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub TitlePage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  backdrop black
  cls
  ' stadium lights, the skyline, the building with one lit window
  put char TLamp at 4,3
  put char TLamp at 27,3
  for Y = 4 to 9
    put char TColumn at 4,Y
    put char TColumn at 27,Y
  next
  for Y = 12 to 17
    for X = 2 to 29
      V = TBldg
      N = X + Y
      N = N & 3
      if N = 0 then V = TBldgw
      if Y < 14 then
        if X < 8 then V = TSky
        if X > 22 then V = TSky
      end if
      if V <> TSky then put char V at X,Y
    next
  next
  for Y = 18 to 19
    fill TStand count 28 at 2,Y
  next
  fill TGrass count 28 at 2,20
  print at 10,5, "CLIMBER 5"
  print at 7,7, "BY JAMES ROGERS"
  print at 9,9, "COMPUTE! 1987"
  print at 8,22, "PRESS A BUTTON"
  print at 7,23, "HIGH"
  NumU = HighScore
  print at 12,23, digits$(NumU, 5)
  Rearm
  wait
  nmi off
  screen on
  nmi off
  ' the ballboy waits at the foot of the building
  Px = 112
  Py = 128
  St = 0
  Dir = 0
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
  Tm = 0
title_loop:
  inc Tm
  N = Tm & 31
  if N = 0 then Anim = Anim ^ 1
  DrawPlayer
  update sprites
  Rearm
  wait
  nmi off
  if joypad(1).fire then goto title_go
  if joypad(2).fire then goto title_go
  goto title_loop
title_go:
  play sound SndPick
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  HideSprites
  play voxpcm SayClimber
  nmi off
  return
end sub

sub EditorialPage:
  nmi off
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 10,1, "CLIMBER 5"
  print at 2,3, "BY JAMES ROGERS, COMPUTE!"
  print at 2,4, "AUGUST 1987. THE ORIGINAL"
  print at 2,5, "WAS FOR THE ATARI, COMPUTE!"
  print at 2,6, "ADDED THE C64, AMIGA, IBM"
  print at 2,7, "PC AND APPLE II."
  print at 2,9, "A HOME RUN LANDED ON TOP"
  print at 2,10, "OF THE BUILDING NEXT DOOR,"
  print at 2,11, "AND IT IS THE TEAM'S LAST"
  print at 2,12, "BALL. CLIMB AND GET IT."
  print at 2,14, "JUMP THE ELECTRODES, DUCK"
  print at 2,15, "THE HOOKS, STAY AWAY FROM"
  print at 2,16, "THE SWEEPERS."
  print at 2,18, "COLECOVISION VERSION BY"
  print at 2,19, "AMY BIENVENU, 2026."
  print at 6,22, "PRESS A BUTTON"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

