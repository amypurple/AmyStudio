data DD_GameOverText bytes = 33,34,35,36,37,38
data DD_TitleText bytes = 40,41,42,43,44,45,46,47

' ---------------------------------------------------------------------------
' REVERSI ROM RESOURCES
' RAM PART: ArcadeRam.Reversi
' These constants and data tables live in ROM, not in the overlay.
' ---------------------------------------------------------------------------
' Amy port of the old NewColeco SDCC Reversi sample.
' Original source: old-projects-sdcc-z80/sdccold/reversi/
' The original readme says the old version had no sounds and was buggy.
' This port keeps the original board graphics and adds NewColeco's historical
' logo cue to the menu.

asset RV_ReversiBoardZx0 from "@project/reversi.name.zx0" codec zx0
asset RV_ReversiPatternZx0 from "@project/reversi.pattern.zx0" codec zx0
