  18,4,11,18,17,16,15,14,21,22,29,36,43,44,45,46,47,40,41,0,0
  18,21,22,23,24,31,30,37,44,45,46,47,40,33,26,27,20,13,6,0,0
  18,14,15,22,29,30,37,38,39,46,47,40,33,26,27,20,13,12,5,0,0
  18,27,26,25,24,23,30,31,38,45,44,43,36,29,22,15,8,7,0,0,0
  18,1,8,15,16,17,18,19,26,27,34,41,40,47,46,45,44,43,42,0,0
