' Record array smoke test: field access and record-size stride.
record Piece:
  u8 X
  u8 Y
  u8 Tile
  u8 Flags
end record

Piece Pieces[4]
u8 I = 0

  text screen
  set Pieces[0].X = 2
  set Pieces[0].Y = 4
  set Pieces[0].Tile = 65
  set Pieces[1].X = 6
  set Pieces[1].Y = 6
  set Pieces[1].Tile = 66
  for I = 0 to 1
    put char Pieces[I].Tile at Pieces[I].X,Pieces[I].Y
  next I
  screen on