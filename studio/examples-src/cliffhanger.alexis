cartridge "CLIFFHANGER/J.C. HILTY/1987"

' CLIFFHANGER
' A ColecoVision game based on "Cliffhanger" by J. C. Hilty, Ahoy!
' December 1987 (Commodore 64 BASIC with sprites and a small machine-code
' sprite mover; orig/ has the three files from the Ahoy! disk, the
' detokenized listing, the sprites as text and jsc64 screenshots). Made for
' Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' The story (from the disk's blurb): a swarm of murderous hooties stands
' between you and the diamond atop Mount Gemstone.
'
' Not a line-by-line port: the rules are the listing's, the game is built
' for the ColecoVision: the climber glides from foothold to foothold,
' everything else moves every frame in 1/96 pixel steps, the mountain is
' drawn in tiles (ledges, faces, slopes, crevices) under a starry sky,
' sound effects and a title tune.
'
' From the original (lines 12-372 and the machine code at $C000): climb
' the stepped mountain from its foot (stick up, down, left and right, one
' foothold at a time, never below the start row) to the diamond on the
' middle peak; a step onto anything but rock (the sky beside the mountain,
' the gaps between the peaks, the two crevices) is a fall; two crocodiles
' walk the two long ledges (the upper one right at 1/2 pixel a frame, the
' lower one left at 1/3, each starting again at the far end); four
' hooties: one flies up the left flank at a pixel a frame and one down the
' right flank at 1/2, round and round through the top and bottom of the
' screen, one bounces round the middle of the mountain (1/3 across, 1/2 up
' and down), one chases the climber, choosing its way again about twice a
' second (1/3 a frame moving right or down and 1/4 left or up on level 1,
' new speeds of 1/2 to 1/4 each later level, from the listing's PL/PH);
' touching a crocodile or a hootie knocks the climber off; the bonus
' starts at 500 and loses 10 about twice a second (every sixth pass of the
' BASIC loop, measured in jsc64: 32 frames), and the climber falls when it
' runs out; the bonus left is added to the score at the diamond, then the
' next level; four climbers; a fall starts the climb again from the foot
' with a full bonus and everything back in place; GAME OVER with the score
' and the high score.
'
' Liberties: the climber glides a foothold in 6 frames (about 10 a second,
' the C64's pace with the stick held), and a tap moves exactly one; with
' the stick held diagonally up and down win (the C64 ignored diagonals);
' the creatures are about an eighth faster each level up to level 5 (the
' listing only changes the chaser's speed); an extra climber every 5,000
' points (nine at most); a knocked-off climber hops and tumbles down the
' screen, the rock colours change each level (sandstone, granite, ice,
' amethyst), the climber cheers at the diamond and the bonus is counted
' into the score; the mountain is 28 columns wide (the C64's was 31), and
' the crevices are 10 wide (9).
'
' Controls: the joystick (either controller) climbs. On the title, up and
' down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes faster than 3 Hz (the diamond's glint: 1 Hz).
'
' Workarounds for Amy bugs bombs-return-u16 removed 2026-11-01.

const TLedge = 128
const TFace = 129
const TSlopeL = 130
const TSlopeR = 131
const TCave = 132
const TCaveE = 133
const TSky = 134
const TStar1 = 135
const TStar2 = 136
const TStar3 = 137
const THoleT = 138
const THole = 139
const THoleG = 140
const TTtl00 = 141
const TTtl01 = 142
const TTtl02 = 143
const TTtl03 = 144
const TTtl04 = 145
const TTtl05 = 146
const TTtl06 = 147
const TTtl07 = 148
const TTtl08 = 149
const TTtl09 = 150
const TTtl010 = 151
const TTtl011 = 152
const TTtl012 = 153
const TTtl013 = 154
const TTtl014 = 155
const TTtl015 = 156
const TTtl016 = 157
const TTtl017 = 158
const TTtl018 = 159
const TTtl019 = 160
const TTtl020 = 161
const TTtl021 = 162
const TTtl10 = 163
const TTtl11 = 164
const TTtl12 = 165
const TTtl13 = 166
const TTtl14 = 167
const TTtl15 = 168
const TTtl16 = 169
const TTtl17 = 170
const TTtl18 = 171
const TTtl19 = 172
const TTtl110 = 173
const TTtl111 = 174
const TTtl112 = 175
const TTtl113 = 176
const TTtl114 = 177
const TTtl115 = 178
const TTtl116 = 179
const TTtl117 = 180
const TTtl118 = 181
const TTtl119 = 182
const TTtl120 = 183
const TTtl121 = 184
const SP0d0 = 0
const SP0b0 = 4
const SP0d1 = 8
const SP0b1 = 12
const SP0d2 = 16
const SP0b2 = 20
const SP0d3 = 24
const SP0b3 = 28
const SP0d4 = 32
const SP0b4 = 36
const SP0d5 = 40
const SP0b5 = 44
const SP0d6 = 48
const SP0b6 = 52
const SP1d0 = 56
const SP1b0 = 60
const SP1d1 = 64
const SP1b1 = 68
const SP1d2 = 72
const SP1b2 = 76
const SP1d3 = 80
const SP1b3 = 84
const SP1d4 = 88
const SP1b4 = 92
const SP1d5 = 96
const SP1b5 = 100
const SP1d6 = 104
const SP1b6 = 108
const SHoot0 = 112
const SHoot1 = 116
const SHoot2 = 120
const SHoot3 = 124
const SCrocR0 = 128
const SCrocL0 = 132
const SCrocR1 = 136
const SCrocL1 = 140
const SDiam = 144
const SGlint = 148
const NTiles8 = 456
const SprBytes = 1216
const LeftOff = 56
const SndTuneA = 1
const SndTuneB = 2
const SndHit = 3
const SndCrumble = 4
const SndStep = 5
const SndFall = 6
const SndGem = 7
const SndTick = 8
const SndLife = 9
const SndStart = 10
const SndWarn = 11
const SndOver = 12
const StepF = 6
const NSpr = 10
const StartC = 15
const StartR = 21
const Unit = 96
const StClimb = 1
const StFall = 2
const StWin = 3
const HideF = 48

data GlideT bytes
  0,1,3,4,5,7
end data
' the creatures: 0 upper crocodile, 1 lower crocodile, 2 left hootie,
' 3 right hootie, 4 the bouncer, 5 the chaser
data EStartX bytes
  72,192,64,176,92,140
end data
data EStartY bytes
  52,100,150,20,70,70
end data
data EBaseVx bytes
  48,32,0,0,32,0
end data
data EBaseVy bytes
  0,0,96,48,48,0
end data
data EStartDx bytes
  0,1,0,0,1,0
end data
data EStartDy bytes
  0,0,1,0,0,0
end data
data ECol bytes
  2,2,7,9,11,3
end data
' 96 / 2, 96 / 3, 96 / 4: the chaser's speeds from the listing's PL/PH
data DivT bytes
  48,32,24
end data

u16 TzLeft = 0
u8 TzOn = 0
u16 W16 = 0
u16 NumU = 0
u16 Score = 0
u16 HiScore = 0
u16 NextLife = 5000
u16 Bn = 500
u8 BnT = 0
u8 Lives = 4
u8 Lv = 1
u8 Rp = 8
u8 Over = 0
' the climber: state, foothold, move (0 none, 1 up, 2 down, 3 left,
' 4 right), glide step, facing left, sprite position
u8 St = StClimb
u8 Pc = 15
u8 Pr = 21
u8 Pd = 0
u8 Pk = 0
u8 Face = 0
u8 Pxp = 0
u8 Pyp = 0
' falling: position and speed in 1/16 pixel, frames since off the screen
i16 Fy16 = 0
i16 Fv = 0
u8 DieT = 0
u8 Why = 0
' the creatures: positions, speeds (1/96 pixel a frame), directions
' (0 plus, 1 minus), accumulators
u8 Ex[6]
u8 Ey[6]
u8 Vx[6]
u8 Vy[6]
u8 Dx[6]
u8 Dy[6]
u8 Ax[6]
u8 Ay[6]
' frames a crocodile has left in its cave
u8 Hd[2]
u8 SpR = 32
u8 SpL = 24
u8 Pl = 3
u8 Ph = 252
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Ei = 0
u8 Mr = 0
u8 Mc = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 F = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0

  tile screen
  set sound table CfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 1 then goto game_over
  if St = StWin then LevelDone
  goto play_loop

game_over:
  Phase = 4
  if Score > HiScore then
    HiScore = Score
    ShowHi
  end if
  print at 11,10, "GAME OVER"
  print at 13,16, "SCORE"
  NumU = Score
  print at 13,17, digits$(NumU, 5)
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the mountain

' what is at a cell: 0 sky, 1 rock, 3 and 4 slopes, 5 a crevice, 6 a cave
function CellAt(u8 Cc, u8 Rr) as u8
  u16 Ix = 0
  if Rr < 3 then return 0
  if Rr > 22 then return 0
  if Cc > 31 then return 0
  Ix = (Rr - 3) * 32 + Cc
  return Mtn[Ix]

' 1 when the climber can stand at the cell
function Solid(u8 Sc, u8 Sr) as u8
  u8 Kd = 0
  Kd = CellAt(Sc, Sr)
  if Kd = 0 then return 0
  if Kd = 5 then return 0
  return 1

' the tile for a cell of the screen
function TileAt(u8 Tc, u8 Tr) as u8
  u8 Kd = 0
  u8 Up = 0
  u8 Hs = 0
  Kd = CellAt(Tc, Tr)
  if Kd = 1 then
    Hs = Tr & 1
    if Hs = 1 then return TLedge
    return TFace
  end if
  if Kd = 6 then return TCave
  if Kd = 3 then return TSlopeL
  if Kd = 4 then return TSlopeR
  if Kd = 5 then
    Up = Tr - 1
    Up = CellAt(Tc, Up)
    if Up <> 5 then return THoleT
    Hs = Tc * 7 + Tr * 3
    Hs = Hs & 15
    if Hs = 5 then return THoleG
    return THole
  end if
  ' the sky: a star here and there
  Hs = Tc * 5 + Tr * 11
  Hs = Hs + Tr / 3
  Hs = Hs & 15
  if Hs = 3 then return TStar1
  if Hs = 9 then return TStar2
  if Hs = 14 then
    if Tr < 12 then return TStar3
  end if
  return TSky

' the whole screen: sky, then the mountain row by row, from its first
' to its last cell
sub DrawMountain:
  u8 Lo = 0
  u8 Hi = 0
  for Mr = 0 to 23
    Lo = 0
    Hi = 31
    for Mc = Lo to Hi
      V = TileAt(Mc, Mr)
      put char V at Mc,Mr
    next
  next
  return
end sub

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Anim
  MoveEnemies
  if St = StFall then
    FallStep
    return
  end if
  if St <> StClimb then return
  inc BnT
  if BnT = 16 then AimChaser
  if BnT >= 32 then
    BnT = 0
    Bn = Bn - 10
    ShowBonus
    if Bn = 0 then
      StartFall(0)
      return
    end if
    if Bn <= 100 then play sound SndWarn
  end if
  MovePlayer
  if St = StClimb then CheckHits
  return
end sub

' every creature moves by its speeds; a crocodile at the end of its ledge
' goes into the cave there and waits HideF frames in the cave at the other
' end (its eyes show) before it comes out; the bouncer turns at the edges
' of its box
sub MoveEnemies:
  for Ei = 0 to 5
    if Ei < 2 then
      if Hd[Ei] > 0 then
        Hd[Ei] = Hd[Ei] - 1
        continue for
      end if
    end if
    Ax[Ei] = Ax[Ei] + Vx[Ei]
    while Ax[Ei] >= Unit
      Ax[Ei] = Ax[Ei] - Unit
      if Dx[Ei] = 0 then
        Ex[Ei] = Ex[Ei] + 1
      else
        Ex[Ei] = Ex[Ei] - 1
      end if
    end while
    Ay[Ei] = Ay[Ei] + Vy[Ei]
    while Ay[Ei] >= Unit
      Ay[Ei] = Ay[Ei] - Unit
      if Dy[Ei] = 0 then
        Ey[Ei] = Ey[Ei] + 1
      else
        Ey[Ei] = Ey[Ei] - 1
      end if
    end while
  next
  if Ex[0] > 168 then
    Ex[0] = 72
    Hd[0] = HideF
  end if
  if Ex[1] < 48 then
    Ex[1] = 192
    Hd[1] = HideF
  end if
  if Ex[4] <= 24 then Dx[4] = 0
  if Ex[4] >= 200 then Dx[4] = 1
  if Ey[4] >= 152 then Dy[4] = 1
  if Ey[4] <= 48 then Dy[4] = 0
  return
end sub

' the chaser heads for the climber (listing lines 100-108)
sub AimChaser:
  if Ex[5] < Pxp then
    Dx[5] = 0
    Vx[5] = SpR
  elseif Ex[5] > Pxp then
    Dx[5] = 1
    Vx[5] = SpL
  end if
  if Ey[5] < Pyp then
    Dy[5] = 0
    Vy[5] = SpR
  elseif Ey[5] > Pyp then
    Dy[5] = 1
    Vy[5] = SpL
  end if
  return
end sub

' a new move when standing (up, down, left, right in that order), the glide,
' and on arriving: the diamond or a fall
sub MovePlayer:
  if Pd = 0 then
    V = Pad & 1
    if V > 0 then
      Pd = 1
    else
      V = Pad & 2
      if V > 0 then
        if Pr < StartR then Pd = 2
      else
        V = Pad & 4
        if V > 0 then
          Face = 1
          if Pc > 2 then Pd = 3
        else
          V = Pad & 8
          if V > 0 then
            Face = 0
            if Pc < 29 then Pd = 4
          end if
        end if
      end if
    end if
    if Pd = 0 then return
    play sound SndStep
  end if
  inc Pk
  if Pk < StepF then
    PlacePlayer
    return
  end if
  Pk = 0
  select case Pd
  case 1
    dec Pr
  case 2
    inc Pr
  case 3
    dec Pc
  case else
    inc Pc
  end select
  Pd = 0
  PlacePlayer
  if Pr = 3 then
    if Pc >= 14 then
      if Pc <= 17 then
        St = StWin
        return
      end if
    end if
  end if
  if Solid(Pc, Pr) = 0 then StartFall(0)
  return
end sub

' the climber's sprite position from its foothold and glide
sub PlacePlayer:
  u8 G = 0
  G = GlideT[Pk]
  Pxp = Pc * 8 - 4
  Pyp = Pr * 8 - 8
  select case Pd
  case 1
    Pyp = Pyp - G
  case 2
    Pyp = Pyp + G
  case 3
    Pxp = Pxp - G
  case 4
    Pxp = Pxp + G
  end select
  return
end sub

' a creature within 10 pixels across and 9 up or down knocks the climber
' off (hooties above the top of the screen count as there)
sub CheckHits:
  i16 Ddx = 0
  i16 Ddy = 0
  i16 Ey16 = 0
  for Ei = 0 to 5
    if Ei < 2 then
      if Hd[Ei] > 0 then continue for
    end if
    Ddx = Ex[Ei]
    Ddx = Ddx - Pxp
    Ey16 = Ey[Ei]
    if Ey16 >= 224 then Ey16 = Ey16 - 256
    Ddy = Ey16 - Pyp
    Ddx = abs(Ddx)
    Ddy = abs(Ddy)
    if Ddx <= 10 then
      if Ddy <= 9 then
        play sound SndHit
        StartFall(24)
        return
      end if
    end if
  next
  return
end sub

' off the mountain: a hop when knocked (Kick), then down and down
sub StartFall(u8 Kick):
  St = StFall
  Why = Kick
  Fy16 = Pyp
  Fy16 = Fy16 * 16
  Fv = 0 - Kick
  DieT = 0
  Pd = 0
  Pk = 0
  if Kick = 0 then play sound SndCrumble
  play sound SndFall
  return
end sub

sub FallStep:
  if Fy16 < 3072 then
    Fv = Fv + 3
    Fy16 = Fy16 + Fv
    return
  end if
  inc DieT
  if DieT >= 30 then LoseLife
  return
end sub

sub LoseLife:
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    return
  end if
  ResetRound
  ShowBonus
  return
end sub

' the climber back at the foot, the creatures where they began, the
' chaser waiting for its first aim, a full bonus
sub ResetRound:
  for Ei = 0 to 5
    Ex[Ei] = EStartX[Ei]
    Ey[Ei] = EStartY[Ei]
    Vx[Ei] = Ramp(EBaseVx[Ei])
    Vy[Ei] = Ramp(EBaseVy[Ei])
    Dx[Ei] = EStartDx[Ei]
    Dy[Ei] = EStartDy[Ei]
    Ax[Ei] = 0
    Ay[Ei] = 0
  next
  Hd[0] = 0
  Hd[1] = 0
  St = StClimb
  Pc = StartC
  Pr = StartR
  Pd = 0
  Pk = 0
  Face = 0
  PlacePlayer
  Bn = 500
  BnT = 0
  return
end sub

' a speed made faster by level (Rp eighths)
function Ramp(u8 Base) as u8
  u16 Wr = 0
  Wr = Base * Rp
  Wr = Wr >> 3
  return Wr

' ---------------------------------------------------------------------------
' between levels

sub LevelDone:
  Phase = 3
  play sound SndGem
  print at 12,10, "SUMMIT!"
  for Gi = 0 to 89
    Anim = Anim + 1
    DrawSprites
    Frame1
  next
  print at 11,12, "BONUS"
  while Bn > 0
    Bn = Bn - 10
    AddScore(10)
    NumU = Bn
    print at 17,12, digits$(NumU, 3)
    ShowBonus
    V = Tick & 1
    if V = 0 then play sound SndTick
    Frame1
  end while
  Rearm
  wait 40 frames
  nmi off
  if Lv < 99 then inc Lv
  StartLevel
  return
end sub

sub AddScore(u16 Pts):
  if Score < 65000 then Score = Score + Pts
  if Score >= NextLife then
    NextLife = NextLife + 5000
    if Lives < 9 then
      inc Lives
      ShowLives
    end if
    play sound SndLife
  end if
  ShowScore
  return
end sub

' ---------------------------------------------------------------------------
' levels and drawing

sub NewGame:
  Score = 0
  NextLife = 5000
  Lives = 4
  Lv = 1
  Over = 0
  StartLevel
  return
end sub

sub StartLevel:
  Phase = 2
  V = Lv - 1
  if V > 4 then V = 4
  Rp = 8 + V
  if Lv = 1 then
    Pl = 3
    Ph = 252
  else
    V = random(0, 2)
    Pl = 2 + V
    V = random(0, 2)
    Ph = 252 + V
  end if
  V = Pl - 2
  SpR = Ramp(DivT[V])
  V = 254 - Ph
  SpL = Ramp(DivT[V])
  NewScreen
  SetPalette
  DrawMountain
  ResetRound
  ShowHud
  Anim = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait 50 frames
  nmi off
  Phase = 1
  return
end sub

' the level's rock colours (four sets, in turn)
sub SetPalette:
  V = Lv - 1
  V = V & 3
  W16 = V * 48
  copy LvCol + W16 count 48 to vram.color + 1024
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 2,4, "HIGH"
  print at 2,7, "LEVEL"
  print at 25,1, "BONUS"
  print at 25,4, "LIVES"
  ShowScore
  ShowHi
  ShowLevel
  ShowBonus
  ShowLives
  return
end sub

sub ShowScore:
  NumU = Score
  print at 2,2, digits$(NumU, 5)
  return
end sub

sub ShowHi:
  NumU = HiScore
  print at 2,5, digits$(NumU, 5)
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 2,8, digits$(NumU, 2)
  return
end sub

sub ShowBonus:
  NumU = Bn
  print at 26,2, digits$(NumU, 3)
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 27,5, digits$(NumU, 1)
  return
end sub

' sprites 0-1 the climber (detail over body), 2 the diamond, 3 its glint,
' 4-5 the crocodiles, 6-9 the hooties
sub DrawSprites:
  X = Pxp
  Y = Pyp
  F = 0
  if St = StClimb then
    if Pd >= 3 then
      F = 2
      if Pk >= 3 then F = 3
    elseif Pd >= 1 then
      if Pk >= 3 then F = 1
    end if
  elseif St = StFall then
    W16 = Fy16 >> 4
    if W16 >= 192 then W16 = 192
    Y = W16
    V = Anim >> 3
    F = 4 + (V & 1)
  else
    F = 6
  end if
  K = F << 3
  if Face = 1 then K = K + LeftOff
  K = K + SP0d0
  set sprite 0 to Y,X,K,8
  K = K + 4
  set sprite 1 to Y,X,K,15
  set sprite 2 to 11,120,SDiam,7
  V = Anim & 63
  if V < 20 then
    set sprite 3 to 9,122,SGlint,15
  else
    set sprite 3 to 192,0,0,0
  end if
  for Ei = 0 to 1
    V = Ex[Ei] >> 2
    V = V & 1
    K = SCrocR0
    if Dx[Ei] = 1 then K = SCrocL0
    K = K + V * 8
    N = Ei + 4
    if Hd[Ei] > 0 then
      set sprite N to 192,0,0,0
    else
      set sprite N to Ey[Ei],Ex[Ei],K,2
    end if
  next
  ' eyes in the cave a crocodile will come out of
  V = TCave
  if Hd[0] > 0 then V = TCaveE
  put char V at 9,8
  V = TCave
  if Hd[1] > 0 then V = TCaveE
  put char V at 25,14
  for Ei = 2 to 5
    V = Anim >> 3
    V = V + Ei
    V = V & 3
    K = SHoot0 + V * 4
    N = Ei + 4
    Y = Ey[Ei]
    C = ECol[Ei]
    if Y >= 192 then
      if Y < 224 then
        set sprite N to 192,0,0,0
      else
        set sprite N to Y,Ex[Ei],K,C
      end if
    else
      set sprite N to Y,Ex[Ei],K,C
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the mountain under its name, the creatures going about their
' business, the tune once, START / CREDITS in the lower crevice
sub TitlePage:
  Phase = 5
  Lv = 1
  Rp = 8
  NewScreen
  DrawMountain
  for Gi = 0 to 21
    V = TTtl00 + Gi
    X = Gi + 5
    put char V at X,1
    V = TTtl10 + Gi
    put char V at X,2
  next
  print at 11,10, "HIGH"
  NumU = HiScore
  print at 16,10, digits$(NumU, 5)
  print at 11,12, "AHOY! 1987"
  print at 13,16, "START"
  print at 13,17, "CREDITS"
  ShowMenu
  ResetRound
  Pc = StartC
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 704
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  inc Anim
  MoveEnemies
  DrawSprites
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  update sprites
  V = Pad & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 12,16
  put char 32 at 12,17
  J = Menu + 16
  put char 62 at 12,J
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "CLIFFHANGER"
  print at 2,5, "BASED ON CLIFFHANGER BY"
  print at 2,6, "J. C. HILTY, AHOY! DECEMBER"
  print at 2,7, "1987 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: MOUNT GEMSTONE"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

