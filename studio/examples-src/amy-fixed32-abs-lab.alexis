' Fixed32 abs lab: statement-style absolute value cases.
fixed32 NegOneHalf = -1.5
fixed32 PosOneHalf = 1.5
fixed32 NegThreeQuarter = -3.25
fixed32 ZeroValue = 0.0
fixed32 OutNeg = 0.0
fixed32 OutPos = 0.0
fixed32 OutThree = 0.0
fixed32 OutZero = 0.0

' Amy Fixed32 Abs Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 7,0, "FIXED32 ABS LAB"

  OutNeg = abs(NegOneHalf)
  print at 1,3,  "abs -1.50"
  print OutNeg at 20,3

  OutPos = abs(PosOneHalf)
  print at 1,5,  "abs 1.50"
  print OutPos at 20,5

  OutThree = abs(NegThreeQuarter)
  print at 1,7,  "abs -3.25"
  print OutThree at 20,7

  OutZero = abs(ZeroValue)
  print at 1,9,  "abs 0.00"
  print OutZero at 20,9

  print at 1,12, "EXPECTED"
  print at 10,12, "1.5 1.5 3.25 0"
  return