  128,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,128
  128,128,128,128,128,128,128,128,128,128,128,130,131,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,130,131,128,128,128,128,128,128,128,128,128,128,128,128
  128,128,128,128,128,128,128,128,128,128,128,130,131,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,130,131,128,128,128,128,128,128,128,128,128,128,128,128
  128,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,128
  128,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,128
  128,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,130,131,32,32,32,32,32,32,32,32,32,32,32,128
  128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128
  128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128
  128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128
