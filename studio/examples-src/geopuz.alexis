asm {
; GpRow: one board row into Buf, GW characters from source column GSx
; (wrapping at 18): Buf[i] = GTab[P18[Bd[GRb + D6[x]]] + M6[x] + GLo]
GpRow:
    ld de,AMY_UVAR_Buf
    ld a,(AMY_UVAR_GW)
    ld b,a
    ld a,(AMY_UVAR_GSx)
    ld c,a
GpRowL:
    push bc
    ld b,0
    ld hl,AMY_UDATA_D6
    add hl,bc
    ld a,(AMY_UVAR_GRb)
    add a,(hl)
    ld hl,AMY_UVAR_Bd
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    ld hl,AMY_UDATA_P18
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    ld hl,AMY_UDATA_M6
    add hl,bc
    add a,(hl)
    ld hl,AMY_UVAR_GLo
    add a,(hl)
    ld hl,(AMY_UVAR_GTab)
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    ld (de),a
    inc de
    pop bc
    inc c
    ld a,c
    cp 18
    jr nz,GpRowN
    ld c,0
GpRowN:
    djnz GpRowL
    ret
GpRoll:
    db $00,$00,$24,$02,$00,$00,$45,$03,$00,$00,$76,$02,$10
GpTick:
    db $40,$5F,$40,$01,$40,$71,$70,$01,$50
GpMix:
    db $00,$00,$46,$01,$00,$00,$77,$02,$10
GpStart:
    db $40,$FE,$20,$06,$40,$CA,$20,$06,$40,$AA,$20,$06,$40,$7F,$20,$0C,$50
GpWin:
    db $40,$BF,$10,$08,$40,$97,$10,$08,$40,$7F,$10,$08,$40,$5F,$10,$08,$40,$71,$10,$08,$40,$5F,$10,$08
    db $40,$4C,$20,$1E,$50
GpQuit:
    db $40,$FE,$20,$0C,$40,$2E,$21,$0C,$40,$7C,$31,$18,$50

GpSoundTable:
    dw GpTuneMel,$702B
    dw GpTuneBass,$7035
    dw GpRoll,$703F
    dw GpTick,$7049
    dw GpMix,$703F
    dw GpStart,$7049
    dw GpWin,$7049
    dw GpQuit,$7049
; Turning Squares (original)
; Tiny Sound, 8 frames per step
GpTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$25,$28,$25,$23,$26,$2A,$26,$25,$28,$2D,$28
    db $2A,$01,$28,$01,$26,$2A,$2F,$2A,$28,$2C,$2F,$2C,$2D,$01,$28,$01
    db $25,$01,$01,$01,$2A,$28,$26,$25,$23,$25,$26,$28,$25,$23,$21,$23
    db $25,$01,$28,$01,$26,$25,$23,$21,$20,$23,$1C,$20,$21,$01,$25,$01
    db $21,$01,$00,$01
    db $FF
GpTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$09,$01,$10,$01,$0B,$01,$12,$01,$0D,$01,$15,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$10,$01,$17,$01,$15,$01,$10,$01
    db $0D,$01,$10,$01,$0E,$01,$15,$01,$10,$01,$17,$01,$09,$01,$10,$01
    db $12,$01,$0D,$01,$0E,$01,$15,$01,$10,$01,$0B,$01,$09,$01,$10,$01
    db $09,$01,$00,$01
    db $FF
}
