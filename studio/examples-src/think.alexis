cartridge "THINKING/BY ANDY VANDUYNE/1983"

' THINKING
' A ColecoVision game based on "Thinking" by Andy VanDuyne, COMPUTE!'s
' Gazette, December 1983 (Commodore 64 and VIC-20, BASIC; disk files
' thinking.64 and thinking.vic; rules from the article and the listings). Made for Amy Studio by
' Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The game: nine black blocks in a 3 x 3 grid. Each number you choose
' (1 to 6) flips three blocks in its own secret way: a black one turns
' purple, a purple one turns back to black. Turn all nine purple in as
' few turns as you can. HARDER: numbers 1 to 9.
'
' From the original (orig/thinking.64.bas, primary; orig/thinking.vic.bas):
' - every number flips exactly three blocks. The listing deals the nine
'   blocks out twice (HARDER: three times) as random orders of 1-9 and cuts
'   them into threes, then hands the threes to the numbers in a random
'   order (lines 12-50, 105-110, 136). So each block belongs to two
'   numbers (HARDER: three), and three of the numbers always cover the
'   board exactly once: every game can be won in three turns.
' - a flip toggles (lines 160-170); PURPLES counts the purple blocks; TURN
'   is the number of the coming guess; the win screen says THAT'S IT!!!!
'   YOU TOOK n TURNS (n = numbers entered); the rising sweep each time the
'   blocks are redrawn and the burst of random tones for a win.
' - the instructions' words (9 BLACK BLOCKS, CHANGE SOME OF THEM TO
'   PURPLE, BUT SOME PURPLE ONES MIGHT TURN BACK TO BLACK, EACH NUMBER
'   YOU ENTER WILL CHANGE THE COLORS IN ITS OWN WAY, AS FEW TRIES AS YOU
'   CAN).
'
' From the article: nine boxes lettered A to I (kept, on the blocks);
' entering the same number again toggles its boxes back and still costs
' a turn; new random patterns every game; there are always two perfect
' solutions (three in HARDER, "Thinking Harder", nine patterns).
'
' Liberties:
' - HARDER is a title menu choice (in the listing it is a REM line 2 the
'   typist had to swap in by hand).
' - Numbers are picked with the stick (left/right, a button), or straight
'   from the keypad digits 1-6 (1-9 in HARDER).
' - Each changed block turns edge-on and back as it flips, so a player
'   can see which blocks a number touched (the original redrew the grid).
' - A fresh deal every game. The listing never cleared P$(), so its
'   second and later games (WANT ANOTHER? Y) reused stale threes.
' - No THINKING..... pause; no colour-cycling screen flash on a win
'   (the blocks pulse at under 3 Hz instead); the end screen waits for a
'   button, then the title (no Y/N); the title keeps the best turns of
'   each mode and the boards solved.
' - The art, the sounds and the title tune ("Ponder") are new.
'
' Controls: either controller; stick, side buttons, keypad digits.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' frame loop protected from the NMI; screens drawn with the NMI off and
' the display off. Music first in the sound table, the title tune once.

const TWood = 128
const TRimt = 129
const TRimb = 130
const TRiml = 131
const TRimr = 132
const TRimtl = 133
const TRimtr = 134
const TRimbl = 135
const TRimbr = 136
const TBlk00 = 137
const TBlk01 = 138
const TBlk02 = 139
const TBlk03 = 140
const TBlk10 = 141
const TBlk11 = 142
const TBlk12 = 143
const TBlk13 = 144
const TBlk20 = 145
const TBlk21 = 146
const TBlk22 = 147
const TBlk23 = 148
const TPur00 = 149
const TPur01 = 150
const TPur02 = 151
const TPur03 = 152
const TPur10 = 153
const TPur11 = 154
const TPur12 = 155
const TPur13 = 156
const TPur20 = 157
const TPur21 = 158
const TPur22 = 159
const TPur23 = 160
const TEdg00 = 161
const TEdg01 = 162
const TEdg02 = 163
const TEdg03 = 164
const TEdg10 = 165
const TEdg11 = 166
const TEdg12 = 167
const TEdg13 = 168
const TEdg20 = 169
const TEdg21 = 170
const TEdg22 = 171
const TEdg23 = 172
const TLkA = 173
const TLkB = 174
const TLkC = 175
const TLkD = 176
const TLkE = 177
const TLkF = 178
const TLkG = 179
const TLkH = 180
const TLkI = 181
const TLpA = 182
const TLpB = 183
const TLpC = 184
const TLpD = 185
const TLpE = 186
const TLpF = 187
const TLpG = 188
const TLpH = 189
const TLpI = 190
const TKey100 = 191
const TKey101 = 192
const TKey110 = 193
const TKey111 = 194
const TKey200 = 195
const TKey201 = 196
const TKey210 = 197
const TKey211 = 198
const TKey300 = 199
const TKey301 = 200
const TKey310 = 201
const TKey311 = 202
const TKey400 = 203
const TKey401 = 204
const TKey410 = 205
const TKey411 = 206
const TKey500 = 207
const TKey501 = 208
const TKey510 = 209
const TKey511 = 210
const TKey600 = 211
const TKey601 = 212
const TKey610 = 213
const TKey611 = 214
const TKey700 = 215
const TKey701 = 216
const TKey710 = 217
const TKey711 = 218
const TKey800 = 219
const TKey801 = 220
const TKey810 = 221
const TKey811 = 222
const TKey900 = 223
const TKey901 = 224
const TKey910 = 225
const TKey911 = 226
const TLT00 = 227
const TLT01 = 228
const TLT10 = 229
const TLT11 = 230
const TLH00 = 231
const TLH01 = 232
const TLH10 = 233
const TLH11 = 234
const TLI00 = 235
const TLI01 = 236
const TLI10 = 237
const TLI11 = 238
const TLN00 = 239
const TLN01 = 240
const TLN10 = 241
const TLN11 = 242
const TLK00 = 243
const TLK01 = 244
const TLK10 = 245
const TLK11 = 246
const TLG00 = 247
const TLG01 = 248
const TLG10 = 249
const TLG11 = 250
const TDot = 251
const TDotk = 252
const SArrow = 0
const SArim = 4
const SSpark = 8
const NTiles8 = 1000
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndBump = 4
const SndPick = 5
const SndFlip = 6
const SndTap = 7
const SndWin = 8
const NSpr = 6
const GridC = 9
const GridR = 4
const KeyRow = 18
const LookBlack = TBlk00
const LookPurple = TPur00
const LookEdge = TEdg00

record ModeInfo:
  u8 Keys
  u8 Deals
  u8 Best
  u8 KeyCol
end record

' the title's letters
data TitleGl bytes
  TLT00, TLH00, TLI00, TLN00, TLK00, TLI00, TLN00, TLG00
end data

ModeInfo Md[2]
u8 Blk[9]
u8 Chg[9]
u8 Trip[27]
u8 Ord[9]
u8 Perm[9]
bcd digits 4 Solved
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Hard = 0
u8 NKeys = 6
u8 Turn = 0
u8 Purp = 0
u8 Cur = 0
u8 Picked = 0
u8 Ask = 0
u8 Over = 0
u8 Menu = 0
u8 TitleOn = 0
u8 RepT = 0
u8 Ax = 0
u8 Ay = 0
u8 Bob = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Kp = 0
u8 WasKp = 255
u8 KeyHit = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Lj = 0
u8 Lk = 0
u8 Lw = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  Md[0].Keys = 6
  Md[0].Deals = 2
  Md[0].Best = 0
  Md[0].KeyCol = 7
  Md[1].Keys = 9
  Md[1].Deals = 3
  Md[1].Best = 0
  Md[1].KeyCol = 3
  Solved = 0
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowTo
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  Hard = Menu
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  Ask = 0
  WinShow
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random number from 0 to M - 1
function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

' Perm[0 .. N - 1] = a random order of 0 .. N - 1 (the listing drew
' numbers until it found an unused one; a shuffle deals the same orders)
sub Shuffle(u8 N):
  u8 Si = 0
  u8 Sj = 0
  u8 Sv = 0
  u8 Top = 0
  Top = N - 1
  for Si = 0 to Top
    Perm[Si] = Si
  next
  Si = Top
  while Si > 0
    Sv = Si + 1
    Sj = RandBelow(Sv)
    Sv = Perm[Si]
    Perm[Si] = Perm[Sj]
    Perm[Sj] = Sv
    dec Si
  end while
  return
end sub

' deal the threes: Deals orders of the nine blocks, cut into threes, then
' the threes handed to the numbers in a random order
sub Deal:
  u8 Dn = 0
  u8 Db = 0
  u8 Dk = 0
  u8 Dl = 0
  Dl = Md[Hard].Deals - 1
  for Dn = 0 to Dl
    Shuffle(9)
    Db = Dn * 9
    for Dk = 0 to 8
      Trip[Db + Dk] = Perm[Dk]
    next
  next
  Shuffle(NKeys)
  Dl = NKeys - 1
  for Dk = 0 to Dl
    Ord[Dk] = Perm[Dk]
  next
  return
end sub

function CountPurple as u8
  u8 Cn = 0
  u8 Ci = 0
  for Ci = 0 to 8
    Cn += Blk[Ci]
  next
  return Cn

' the number Pn (1 .. NKeys): flip its three blocks
sub Flip(u8 Pn):
  u8 Tr = 0
  u8 Fb = 0
  u8 Wv = 0
  u8 Fk = 0
  fill array Chg with 0
  Tr = Ord[Pn - 1]
  Fb = Tr * 3
  for Fk = 0 to 2
    Wv = Trip[Fb + Fk]
    Blk[Wv] = Blk[Wv] ^ 1
    Chg[Wv] = 1
  next
  return
end sub

sub NewGame:
  NKeys = Md[Hard].Keys
  fill array Blk with 0
  Deal
  Turn = 1
  Purp = 0
  Cur = 0
  Over = 0
  DrawPlay
  return
end sub

sub PlayStep:
  Ask = 1
  ' the arrow bobs gently
  V = Tick & 15
  if V = 0 then
    Bob = Bob ^ 1
    DrawArrow
  end if
  ' the stick moves the arrow: a new direction at once, held ones repeat
  K = 0
  if Edge > 0 then
    K = Edge
    RepT = 15
  else
    if Jk > 0 then
      dec RepT
      if RepT = 0 then
        K = Jk
        RepT = 6
      end if
    end if
  end if
  if K > 0 then MoveCursor(K)
  if KeyHit > 0 then
    Cur = KeyHit - 1
    DrawArrow
    Guess(KeyHit)
  else
    if Press = 1 then Guess(Cur + 1)
  end if
  return
end sub

sub MoveCursor(u8 Mk):
  u8 Was = 0
  Was = Cur
  select case Mk
  case 4
    if Cur > 0 then dec Cur
  case 8
    if Cur < NKeys - 1 then inc Cur
  case else
    Was = 255
  end select
  if Was <> 255 then
    if Cur = Was then
      play sound SndBump
    else
      play sound SndClick
      DrawArrow
    end if
  end if
  return
end sub

sub Guess(u8 Gn):
  Ask = 0
  Picked = Gn
  play sound SndPick
  PressKey(Gn)
  Flip(Gn)
  FlipShow
  Purp = CountPurple
  ShowStatus
  if Purp = 9 then
    Over = 1
  else
    inc Turn
    ShowStatus
  end if
  return
end sub

' the changed blocks turn edge-on, then show their new colour
sub FlipShow:
  play sound SndFlip
  for Lw = 0 to 5
    Frame1
  next
  for Li = 0 to 8
    if Chg[Li] = 1 then DrawBlock(Li, LookEdge)
  next
  for Lw = 0 to 5
    Frame1
  next
  for Li = 0 to 8
    if Chg[Li] = 1 then DrawLook(Li)
  next
  for Lw = 0 to 7
    Frame1
  next
  return
end sub

' the key Gn sinks for a moment (drawn as plain text-less wood), then returns
sub PressKey(u8 Gn):
  u8 Kc = 0
  Kc = KeyColOf(Gn)
  fill TWood count 2 at Kc,KeyRow
  for Lw = 0 to 3
    Frame1
  next
  DrawKey(Gn)
  return
end sub

function KeyColOf(u8 Kn) as u8
  u8 Kc = 0
  Kc = Kn - 1
  Kc = Kc * 3
  Kc = Kc + Md[Hard].KeyCol
  return Kc

' ---------------------------------------------------------------------------
' the win: the blocks pulse (under 3 Hz), sparkles drift up

sub WinShow:
  play sound SndWin
  for Lj = 0 to 5
    T = LookEdge
    V = Lj & 1
    if V = 1 then T = LookPurple
    for Li = 0 to 8
      DrawBlock(Li, T)
    next
    for Lw = 0 to 11
      Frame1
      Sparkles(Lj, Lw)
    next
  next
  HideSprites
  for Li = 0 to 8
    DrawLook(Li)
  next
  inc Solved
  K = Md[Hard].Best
  if K = 0 then
    Md[Hard].Best = Turn
  else
    if Turn < K then Md[Hard].Best = Turn
  end if
  fill 32 count 28 at 2,17
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,22
  print at 9,18, "THAT'S IT!!!!"
  print at 7,20, "YOU TOOK"
  print Turn at 16,20 width 2
  if Turn = 1 then
    print at 19,20, "TURN."
  else
    print at 19,20, "TURNS."
  end if
  print at 9,22, "PRESS BUTTON"
  return
end sub

sub Sparkles(u8 Sa, u8 Sb):
  u8 Sy = 0
  u8 Sx = 0
  u8 Sn = 0
  for Sn = 0 to 3
    Sx = Sn * 40
    Sx = Sx + 56
    Sy = Sa * 12
    Sy = Sy + Sb
    Sy = Sy + Sn * 17
    Sy = Sy % 88
    Sy = 120 - Sy
    set sprite Sn + 2 to Sy,Sx,SSpark,15
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' block Bi (0-8) drawn with the 4 x 3 tile look starting at code Look
sub DrawBlock(u8 Bi, u8 Look):
  u8 Bc = 0
  u8 Br = 0
  u8 Bt = 0
  u8 Rw = 0
  Bc = Bi % 3
  Bc = Bc * 5
  Bc = Bc + GridC
  Br = Bi / 3
  Br = Br << 2
  Br = Br + GridR
  Bt = Look
  for Rw = 0 to 2
    put char Bt at Bc,Br
    put char Bt + 1 at Bc + 1,Br
    put char Bt + 2 at Bc + 2,Br
    put char Bt + 3 at Bc + 3,Br
    Bt += 4
    inc Br
  next
  return
end sub

' a block in its colour, with its letter A-I
sub DrawLook(u8 Bi):
  u8 Lc = 0
  u8 Lr = 0
  u8 Lt = 0
  Lc = Bi % 3
  Lc = Lc * 5
  Lc = Lc + GridC + 1
  Lr = Bi / 3
  Lr = Lr << 2
  Lr = Lr + GridR + 1
  if Blk[Bi] = 1 then
    DrawBlock(Bi, LookPurple)
    Lt = TLpA + Bi
  else
    DrawBlock(Bi, LookBlack)
    Lt = TLkA + Bi
  end if
  put char Lt at Lc,Lr
  return
end sub

sub DrawKey(u8 Kn):
  u8 Kc = 0
  u8 Kt = 0
  u8 Kr = 0
  Kc = KeyColOf(Kn)
  Kt = Kn - 1
  Kt = Kt << 2
  Kt = Kt + TKey100
  Kr = KeyRow + 1
  put char Kt at Kc,KeyRow
  put char Kt + 1 at Kc + 1,KeyRow
  put char Kt + 2 at Kc,Kr
  put char Kt + 3 at Kc + 1,Kr
  return
end sub

sub DrawArrow:
  Ax = KeyColOf(Cur + 1)
  Ax = Ax << 3
  Ay = KeyRow + 2
  Ay = Ay << 3
  Ay = Ay - 1
  Ay = Ay + Bob
  set sprite 0 to Ay,Ax,SArrow,11
  set sprite 1 to Ay,Ax,SArim,1
  update sprites
  return
end sub

sub ShowStatus:
  print at 2,1, "TURN"
  print Turn at 7,1 width 2
  print at 18,1, "PURPLES"
  NumU = Purp
  print at 26,1, digits$(NumU, 1)
  return
end sub

sub DrawBoard:
  u8 Rb = 0
  Rb = GridR + 11
  put char TRimtl at 8,3
  fill TRimt count 14 at 9,3
  put char TRimtr at 23,3
  for Lj = 4 to 14
    put char TRiml at 8,Lj
    fill TWood count 14 at 9,Lj
    put char TRimr at 23,Lj
  next
  put char TRimbl at 8,Rb
  fill TRimb count 14 at 9,Rb
  put char TRimbr at 23,Rb
  return
end sub

sub DrawPlay:
  NewScreen
  DrawBoard
  for Li = 0 to 8
    DrawLook(Li)
  next
  ShowStatus
  if Hard = 1 then
    print at 6,17, "YOUR NUMBER (1-9)"
  else
    print at 6,17, "YOUR NUMBER (1-6)"
  end if
  for Li = 1 to NKeys
    DrawKey(Li)
  next
  print at 3,22, "STICK+BUTTON OR KEYPAD"
  ShowScreen
  Bob = 0
  DrawArrow
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  ' keypad digits: a new press of 1 .. NKeys picks that number
  Kp = keypad(1)
  if Kp = 255 then Kp = keypad(2)
  KeyHit = 0
  if WasKp = 255 then
    if Kp >= 1 then
      if Kp <= NKeys then KeyHit = Kp
    end if
  end if
  WasKp = Kp
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub PutBig(u8 Tb, u8 Bc, u8 Br):
  u8 Cb = 0
  u8 Rb = 0
  Cb = Bc + 1
  Rb = Br + 1
  put char Tb at Bc,Br
  inc Tb
  put char Tb at Cb,Br
  inc Tb
  put char Tb at Bc,Rb
  inc Tb
  put char Tb at Cb,Rb
  return
end sub

sub ShowBest(u8 Bm, u8 Brow):
  u8 Bv = 0
  Bv = Md[Bm].Best
  if Bv = 0 then
    print at 24,Brow, "--"
  else
    NumU = Bv
    print at 24,Brow, digits$(NumU, 2)
  end if
  return
end sub

' the title: THINKING in purple, the rules, the menu (the cursor back on
' START each time), the tune once
sub TitlePage:
  Ask = 0
  TitleOn = 1
  NewScreen
  for Li = 0 to 7
    T = TitleGl[Li]
    C = Li << 1
    C = C + 8
    PutBig(T, C, 2)
  next
  print at 8,5, "BY ANDY VANDUYNE"
  print at 2,7, "YOU WILL SEE 9 BLACK BLOCKS."
  print at 2,8, "EACH NUMBER YOU ENTER WILL"
  print at 2,9, "CHANGE SOME OF THEM TO"
  print at 2,10, "PURPLE, BUT SOME PURPLE ONES"
  print at 2,11, "MIGHT TURN BACK TO BLACK!"
  print at 2,12, "TRY TO MAKE ALL 9 PURPLE IN"
  print at 2,13, "AS FEW TRIES AS YOU CAN."
  print at 8,15, "START  (1-6)"
  print at 8,16, "HARDER (1-9)"
  print at 8,17, "HOW TO PLAY"
  print at 8,18, "CREDITS"
  Menu = 0
  print at 15,19, "BEST"
  print at 2,19, "SOLVED"
  print at 9,19, Solved
  print at 20,19, "1-6"
  ShowBest(0, 19)
  print at 20,20, "1-9"
  ShowBest(1, 20)
  print at 4,22, "COMPUTE!'S GAZETTE 1983"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 544
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  TitleOn = 0
  HideSprites
  return
end sub

sub ShowMenu:
  put char 32 at 6,15
  put char 32 at 6,16
  put char 32 at 6,17
  put char 32 at 6,18
  C = Menu + 15
  put char 62 at 6,C
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B4
  print at 11,2, "THINKING"
  print at 2,5, "BASED ON THINKING,"
  print at 2,6, "BY ANDY VANDUYNE,"
  print at 2,7, "COMPUTE!'S GAZETTE,"
  print at 2,8, "DECEMBER 1983 (COMMODORE 64"
  print at 2,9, "AND VIC-20)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: PONDER (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' HOW TO PLAY: two pages with the game's own block and key tiles and the
' arrow; the button turns the page, 30 s alone goes back to the title
sub HowTo:
  NewScreen
  print at 9,1, "HOW TO PLAY  1/2"
  print at 2,3, "NINE BLOCKS, A TO I, START"
  print at 2,4, "BLACK. MAKE ALL NINE PURPLE!"
  HowBlk(LookBlack, 7, 6)
  put char TLkA at 8,7
  HowBlk(LookPurple, 13, 6)
  put char TLpA at 14,7
  HowBlk(TEdg00, 19, 6)
  print at 2,10, "EACH NUMBER (1 TO 6) FLIPS"
  print at 2,11, "THREE BLOCKS IN ITS OWN"
  print at 2,12, "SECRET WAY: BLACK TURNS"
  print at 2,13, "PURPLE, PURPLE TURNS BACK"
  print at 2,14, "TO BLACK."
  print at 2,16, "STICK LEFT/RIGHT: PICK A"
  print at 2,17, "NUMBER. BUTTON: ENTER IT."
  print at 2,18, "OR PRESS A KEYPAD DIGIT."
  HowWait
  NewScreen
  print at 9,1, "HOW TO PLAY  2/2"
  print at 2,3, "TRY TO DO IT IN AS FEW"
  print at 2,4, "TURNS AS YOU CAN. EVERY"
  print at 2,5, "GAME CAN BE WON IN 3 TURNS!"
  for Li = 0 to 5
    T = Li << 2
    T = T + TKey100
    C = Li << 2
    C = C + 5
    put char T at C,7
    put char T + 1 at C + 1,7
    put char T + 2 at C,8
    put char T + 3 at C + 1,8
  next
  set sprite 0 to 79,40,SArrow,11
  set sprite 1 to 79,40,SArim,1
  update sprites
  print at 2,12, "HARDER: NUMBERS 1 TO 9, AND"
  print at 2,13, "EACH BLOCK BELONGS TO THREE"
  print at 2,14, "NUMBERS."
  print at 2,16, "THE SAME NUMBER AGAIN FLIPS"
  print at 2,17, "ITS BLOCKS BACK (AND COSTS"
  print at 2,18, "A TURN)."
  print at 2,20, "TIP: WATCH WHICH BLOCKS TURN"
  print at 2,21, "EDGE-ON: THAT SHOWS WHAT A"
  print at 2,22, "NUMBER DOES."
  HowWait
  HideSprites
  return
end sub

' a 4 x 3 block picture at column Hc, row Hr
sub HowBlk(u8 Ht, u8 Hc, u8 Hr):
  u8 Hy = 0
  for Hy = 0 to 2
    put char Ht at Hc,Hr
    put char Ht + 1 at Hc + 1,Hr
    put char Ht + 2 at Hc + 2,Hr
    put char Ht + 3 at Hc + 3,Hr
    Ht += 4
    inc Hr
  next
  return
end sub

sub HowWait:
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  NumU = 0
hw_loop:
  Frame1
  ReadPad
  inc NumU
  if NumU >= 1800 then return
  if Press = 0 then goto hw_loop
  return
end sub

