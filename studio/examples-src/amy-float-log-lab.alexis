' FP5 log lab: exact power-of-two anchors plus first approximation interior check.
u16 UZero = 0
u16 UOne = 1
u16 UTwo = 2
u16 UThree = 3
u16 UFour = 4
i16 SNegOne = -1
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0

  text screen
  print at 7,0, "FP5 LOG LAB"

  A = UOne
  A = log(A)
  B = UTwo
  B = log(B)
  C = UFour
  C = log(C)
  D = UOne
  D /= UTwo
  D = log(D)
  E = UZero
  E = log(E)
  F = SNegOne
  F = log(F)
  G = UThree
  G = log(G)

  print at 1,4,  "log 1"
  print A at 14,4 digits 16
  print at 1,6,  "log 2"
  print B at 14,6 digits 16
  print at 1,8,  "log 4"
  print C at 14,8 digits 16
  print at 1,10, "log 0.5"
  print D at 14,10 digits 16
  print at 1,12, "log 0"
  print E at 14,12 digits 16
  print at 1,14, "log -1"
  print F at 14,14 digits 16
  print at 1,16, "log 3"
  print G at 14,16 digits 16

  print at 1,19, "EXPECT"
  print at 1,20, "log1 = 0, log2 ~= .693, log4 ~= 1.386"
  print at 1,21, "log.5 ~= -.693, log0 = 0, log-1 = 0"
  print at 1,22, "log3 is first-pass approximate"
  screen on