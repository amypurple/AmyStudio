' the six points of the cab's outline tested against the rock
data HitDx bytes 5,10,0,15,3,12
data HitDy bytes 2,2,8,8,11,11
' the airlock: open tiles by the C128's door picture (int T = 0..6)
data DoorGap bytes 0,0,2,4,6,6,6
' the crash: eight pieces fly out (x, y steps per frame)
data DebDx bytes 2,1,0,255,254,255,0,1
data DebDy bytes 0,1,2,1,0,255,254,255

