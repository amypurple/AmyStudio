data TitleMap bytes
  $80,$80,$82,$80,$80,$80,$80,$80,$81,$80,$82,$82,$82,$81,$80,$81,$80,$80,$80,$81,$80,$80,$80,$80,$80,$82,$81,$82,$80,$81,$80,$80
  $81,$80,$82,$82,$80,$8C,$8C,$8C,$82,$8C,$8C,$8C,$81,$8C,$8C,$81,$80,$81,$80,$8C,$8C,$8C,$82,$8C,$8C,$8C,$81,$80,$81,$82,$82,$80
  $80,$82,$80,$81,$81,$8C,$80,$80,$80,$8C,$80,$8C,$80,$8C,$82,$8C,$80,$80,$80,$8C,$80,$82,$82,$8C,$82,$8C,$82,$82,$80,$82,$81,$81
  $81,$81,$80,$81,$81,$8C,$80,$81,$81,$8C,$8C,$8C,$81,$8C,$8C,$81,$80,$82,$80,$8C,$82,$80,$81,$8C,$82,$8C,$82,$80,$80,$82,$82,$80
  $82,$81,$80,$82,$80,$8C,$81,$80,$82,$8C,$80,$8C,$80,$8C,$80,$8C,$80,$81,$80,$8C,$82,$80,$80,$8C,$81,$8C,$81,$80,$82,$80,$80,$82
  $82,$80,$82,$81,$80,$8C,$8C,$8C,$80,$8C,$81,$8C,$81,$8C,$8C,$80,$82,$80,$80,$8C,$8C,$8C,$80,$8C,$8C,$8C,$80,$8C,$80,$82,$80,$80
