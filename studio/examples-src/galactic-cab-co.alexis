    db $21,$01,$23,$01,$1A,$01,$1C,$1F,$01,$21,$1F,$01,$1C,$01,$1A,$01
    db $1D,$01,$1F,$01,$1F,$01,$23,$26,$01,$28,$26,$01,$2B,$01,$29,$01
    db $28,$01,$26,$01,$23,$01,$26,$01,$21,$01,$23,$01,$1F,$01,$01,$01
    db $26,$01,$2B,$01,$00,$01
    db $FF
GcTuneBass:
