    db $0B,$01,$0E,$01,$0C,$01,$13,$01,$10,$01,$13,$01,$0E,$01,$15,$01
    db $11,$01,$15,$01,$07,$01,$0E,$01,$0B,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$10,$01,$0E,$01,$15,$01,$0E,$01,$12,$01,$07,$01,$01,$01
    db $0E,$01,$07,$01,$00,$01
