data PasX bytes 32,32,40,112,192,200,208
data PasY bytes 40,88,128,56,128,72,24
data PasFare bytes 3,2,1,5,6,8,10
data PasLc bytes 4,4,7,16,21,25,25
data PasLr bytes 8,14,17,8,17,12,6
data PasCol bytes 3,13,7,15,3,13,7

record Craft:
  u16 Px
  u16 Py
  i16 Vx
  i16 Vy
end record

Craft Ship
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Fuel = 0
i16 D16 = 0
bcd digits 6 Cash = 0
bcd digits 6 Hi = 0
u8 PasOn[7]
u8 PasFr[7]
u8 CX = 0
u8 CY = 0
u8 Moving = 0
u8 Grav = 0
u8 GBase = 0
u8 Runs = 0
u8 Fares = 0
u8 FuelT = 0
u8 StepT = 0
u8 Wave = 0
u8 Thr = 0
u8 JetT = 0
u8 DoorPh = 0
u8 DoorSub = 0
u8 Gap = 0
u8 Over = 0
u8 Mode = 0
u8 Got = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Ds = 0
u8 Bn = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table GcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  Mode = 0
  TitlePage
  if Menu = 1 then goto title

  Cash = 0
  Runs = 0
  NewRun

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop
  if Over = 2 then
    RunDone
    NewRun
    goto play_loop
  end if

  ' the crash: the pieces fly, then the cash, then the title on a press
  Mode = 2
  Crash
  Mode = 4
  if Cash > Hi then Hi = Cash
  print at 4,9, "                        "
  print at 4,10, "      GAME  OVER        "
  print at 4,11, "                        "
  print at 4,12, " YOU HAVE MADE $", Cash, "  "
  print at 4,13, "        IN CASH.        "
  print at 4,14, "                        "
  print at 4,15, "     BEST  $", Hi, "     "
  print at 4,16, "                        "
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  Thr = 0
  if Btn > 0 then
    if Fuel > 0 then
      V = J1 & 2
      if V = 0 then
        Thr = 1
        V = J1 & 8
        if V > 0 then Thr = 2
        V = J1 & 4
        if V > 0 then Thr = 3
      end if
    end if
  end if
  if Thr > 0 then
    Ship.Vy -= Thrust
    select case Thr
      case 2
        Ship.Vx += Thrust
      case 3
        Ship.Vx -= Thrust
    end select
    Moving = 1
    inc FuelT
    if FuelT >= 4 then
      FuelT = 0
      dec Fuel
    end if
    if JetT = 0 then play sound SndJet
    inc JetT
    if JetT >= 6 then JetT = 0
  else
    JetT = 0
  end if
  D16 = Ship.Vx / 16
  Ship.Px = Ship.Px + D16
  D16 = Ship.Vy / 16
  Ship.Py = Ship.Py + D16
  if Moving = 1 then Ship.Vy += Grav
  CX = Ship.Px >> 8
  CY = Ship.Py >> 8
  ' out through the top
  if Ship.Py < 1024 then
    Over = 2
    return
  end if
  if Ship.Py > 61440 then
    Over = 2
    return
  end if
  if HitRock() > 0 then
    Over = 1
    return
  end if
  Pickups
  ' every 4 frames: a step of the C128's loop (a passenger waves, the
  ' airlock moves, the status line)
  ' (one part of the status line a frame, to stay inside the frame)
  inc StepT
  select case StepT
    case 1
      ShowFuel
    case 2
      D16 = Ship.Vy / 68
      ShowSpeed(14, D16)
    case 3
      D16 = Ship.Vx / 68
      ShowSpeed(22, D16)
    case else
      StepT = 0
      Rand
      K = Rs % NPas
      Wave = Wave ^ 1
      PasFr[K] = Wave
      if Fares >= 3 then DoorStep
  end select
  return
end sub

' 1 when one of the six outline points is on a solid tile
function HitRock() as u8
  u8 Hx = 0, Hy = 0, Hp = 0, Tc = 0
  for Hp = 0 to 5
    Hx = CX + HitDx[Hp]
    Hy = CY + HitDy[Hp]
    Hx = Hx >> 3
    Hy = Hy >> 3
    Tc = get char at Hx,Hy
    if Tc >= TRk0 then return 1
  next
  return 0

' a fare is picked up when its box meets the cab's
sub Pickups:
  for Pi = 0 to 6
    if PasOn[Pi] = 1 then
      Got = Touch(Pi)
      if Got = 1 then TakeFare
    end if
  next
  return
end sub

function Touch(u8 Ti) as u8
  u8 Ax = 0, Ay = 0
  Ax = PasX[Ti]
  Ay = PasY[Ti]
  if CX + 15 < Ax + 4 then return 0
  if CX > Ax + 11 then return 0
  if CY + 11 < Ay + 1 then return 0
  if CY + 2 > Ay + 15 then return 0
  return 1

sub TakeFare:
  PasOn[Pi] = 0
  inc Fares
  Grav = Grav + 4
  select case Pi
    case 0
      Cash += 300
    case 1
      Cash += 200
    case 2
      Cash += 100
    case 3
      Cash += 500
    case 4
      Cash += 600
    case 5
      Cash += 800
    case else
      Cash += 1000
  end select
  play sound SndFare
  if Fares = 3 then play sound SndOpen
  ShowCash
  return
end sub

' the airlock: T goes 0 to 6 and back in half steps, one half step every
' other step (8 frames)
sub DoorStep:
  u8 Hs = 0, Ng = 0
  DoorSub = DoorSub ^ 1
  if DoorSub = 1 then return
  inc DoorPh
  if DoorPh >= 24 then DoorPh = 0
  Hs = DoorPh
  if Hs > 12 then Hs = 24 - Hs
  Ng = DoorGap[Hs >> 1]
  if Ng = Gap then return
  Gap = Ng
  DrawDoor
  return
end sub

sub DrawDoor:
  u8 Dc = 0, Lo = 0, Hg = 0
  Lo = 6 - Gap
  Lo = Lo >> 1
  Hg = Lo + Gap
  for Dc = 0 to 5
    if Dc >= Lo then
      if Dc < Hg then
        put char TDop at Dc + 13,1
      else
        put char TDoor at Dc + 13,1
      end if
    else
      put char TDoor at Dc + 13,1
    end if
  next
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' the end of a run: $1000 a fare counted up, then the message
sub RunDone:
  Mode = 3
  HideSprites
  mute all
  play sound SndRun
  for Bn = 1 to Fares
    Cash += 1000
    ShowStatus
    play sound SndBonus
    Rearm
    wait 12 frames
    nmi off
  next
  if Cash > Hi then Hi = Cash
  print at 6,9, "                    "
  print at 6,10, " SUCCESSFUL RUN !!! "
  print at 6,11, "                    "
  Rearm
  wait 150 frames
  nmi off
  inc Runs
  return
end sub

' the crash: eight pieces fly out from the cab for 48 frames
sub Crash:
  u8 Cf = 0, Dx = 0, Dy = 0
  mute all
  play sound SndBoom
  for Ds = 0 to 2
    set sprite Ds to 192,0,0,0
  next
  for Cf = 1 to 48
    for Ds = 0 to 7
      Dx = DebDx[Ds] * Cf
      Dx = Dx + CX
      Dy = DebDy[Ds] * Cf
      Dy = Dy + CY
      if Dy > 180 then Dy = 180
      set sprite Ds + 10 to Dy,Dx,SDeb,11
    next
    update sprites
    Frame1
  next
  for Ds = 10 to 17
    set sprite Ds to 192,0,0,0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the cab (canopy, hull), 2 the jet, 3-9 the fares
sub DrawSprites:
  set sprite 0 to CY - 1,CX,SCabd,7
  set sprite 1 to CY - 1,CX,SCabh,11
  if Thr > 0 then
    K = Thr - 1
    K = K * 4 + SFl0
    ' the flame's two reds swap under 2 times a second (no fast flashing)
    V = Tick & 16
    if V > 0 then
      set sprite 2 to CY - 1,CX,K,9
    else
      set sprite 2 to CY - 1,CX,K,8
    end if
  else
    set sprite 2 to 192,0,0,0
  end if
  for Ds = 0 to 6
    if PasOn[Ds] = 1 then
      K = PasFr[Ds] * 4 + SAl0
      set sprite Ds + 3 to PasY[Ds] - 1,PasX[Ds],K,PasCol[Ds]
    else
      set sprite Ds + 3 to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' the status lines: FUEL, V, H on row 21; FARES and CASH on row 22
sub ShowFuel:
  print at 7,21, digits$(Fuel, 3)
  return
end sub

sub ShowStatus:
  ShowFuel
  D16 = Ship.Vy / 68
  ShowSpeed(14, D16)
  D16 = Ship.Vx / 68
  ShowSpeed(22, D16)
  ShowCash
  return
end sub

sub ShowCash:
  NumU = Fares
  print at 8,22, digits$(NumU, 1)
  print at 20,22, Cash
  return
end sub

sub ShowSpeed(u8 Col, i16 Sp):
  if Sp < 0 then
    print at Col,21, "-"
    Sp = 0 - Sp
  else
    print at Col,21, "+"
  end if
  if Sp > 99 then Sp = 99
  NumU = Sp
  print at Col + 1,21, digits$(NumU, 2)
  return
end sub

' a new run: the cavern, the fares on their pads, the cab hovering
sub NewRun:
  Mode = 1
  NewScreen
  copy CaveMap count 768 to vram.name
  for Pi = 0 to 6
    PasOn[Pi] = 1
    PasFr[Pi] = 0
    NumU = PasFare[Pi]
    NumU = NumU * 100
    if NumU < 1000 then
      print at PasLc[Pi],PasLr[Pi], digits$(NumU, 3)
    else
      print at PasLc[Pi],PasLr[Pi], digits$(NumU, 4)
    end if
  next
  print at 2,21, "FUEL"
  print at 12,21, "V"
  print at 20,21, "H"
  print at 2,22, "FARES"
  print at 14,22, "CASH $"
  K = Runs
  if K > 5 then K = 5
  GBase = 15 + K
  Grav = GBase
  W16 = K * 40
  Fuel = 500 - W16
  Ship.Px = StartX * 256
  Ship.Py = StartY * 256
  Ship.Vx = 0
  Ship.Vy = 0
  CX = StartX
  CY = StartY
  Moving = 0
  Fares = 0
  FuelT = 0
  StepT = 0
  JetT = 0
  DoorPh = 0
  DoorSub = 0
  Gap = 0
  Over = 0
  Thr = 0
  ShowStatus
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 17
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: GALACTIC over CAB CO. in yellow blocks, the cab drifting
' across, START / CREDITS, the best cash, the tune once
sub TitlePage:
  u8 Tx = 0
  NewScreen
  print at 7,2, "AHOY! JUNE 1987"
  print at 11,4, "GALACTIC"
  copy TitleMap count 224 to vram.name + 160
  print at 4,13, "BY CLEVELAND M. BLAKEMORE"
  print at 4,15, "HOLD A BUTTON TO FIRE"
  print at 4,16, "THE JETS. FLY OUT AT THE"
  print at 4,17, "TOP WITH 3 FARES OR MORE."
  print at 13,19, "START"
  print at 13,20, "CREDITS"
  if Hi > 0 then
    print at 8,22, "BEST $", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 528
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Tx = 24
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Tick & 1
  if V = 0 then
    inc Tx
    if Tx > 216 then Tx = 24
  end if
  set sprite 0 to 79,Tx,SCabd,7
  set sprite 1 to 79,Tx,SCabh,11
  update sprites
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 19
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  Mode = 5
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "GALACTIC CAB CO."
  print at 2,5, "BASED ON GALACTIC CAB CO."
  print at 2,6, "BY CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! JUNE 1987"
  print at 2,8, "(COMMODORE 128 BASIC 7.0)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: NIGHT SHIFT ON IO"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

