cartridge "TRI WORDS/BOB BLACKMER/1988"

' TRI WORDS
' A ColecoVision game based on "Tri Words" by Bob Blackmer, Ahoy!
' December 1988 (Commodore 128, BASIC 7.0 with a little machine code, and
' the word file WORDLIST written by TRI.DATA; disk ahoy1988-12). Made for
' Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' The game (the original's rules, read from its listing, orig/tri_words.bas,
' its machine code in lines 870-1060 and its word file, orig/):
' sixteen different letters are dealt at random onto a 4 x 4 board. You
' and the computer take turns making three-letter words from them, you
' first. A word must use three different board letters, be in the word
' list (489 words) and not be used yet by either side. A refused word
' costs nothing: you try again. The computer plays the first word of its
' list, in list order, that fits the board and is unused; it never goes
' back in the list (its pointer only moves on). NORMAL BRAIN searches only
' the first 425 words of the list, SUPER BRAIN all 489; your words are
' always checked against all 489. When the computer finds nothing it is
' stumped and you win. You may give up instead of playing (the original's
' @@@): then the computer tries once more, and if it is stumped too the
' game is a tie, else the computer wins.
'
' From the original: the board of 16 different letters in big letters, the
' word list and its order, the two brains, the computer's search, the
' words of each side listed in two columns beside the board with their
' counts, the messages (YOUR TURN, MY TURN, THINKING.., NOT A WORD, WORD
' USED, I'M STUMPED, YOU WIN!, I WIN!, NICE GAME, WE TIED), the two
' little tunes for a word played (redone as effects), the buzzer.
'
' Liberties: letters are picked on the board with a cursor instead of
' typed, so the original's NO DOUBLES and ^^ LOOK ^^ refusals cannot
' happen; the third pick sends the word, picking the last letter again
' takes it back, the right button clears the picks; GIVE UP under the
' board replaces typing @@@. The computer's word is lit on the board too.
' A dealt board with fewer than 10 words of the list on it is dealt again
' (the original could deal a board where the game ends at once). When a
' side's two columns are full (32 words) they are cleared and filled again
' (the original wrote over them in a new colour). Tile letters, a gliding
' sprite cursor, sounds, a title tune; the play-again question is replaced
' by the house ending. There is no time limit, as in the original.
'
' Controls: the stick moves the cursor (hold to repeat), the left button
' picks a letter (or GIVE UP), the right button clears your picks. Either
' controller. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off after a
' wait, display off. Music first in the sound table; the title tune played
' once. `set sprite count` always given. Own xorshift random numbers.
' Nothing flashes.

const TRule = 192
const TVbar = 193
const TSlot = 194
const TDot = 195
const TTri00 = 196
const TTri01 = 197
const TTri10 = 198
const TTri11 = 199
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const NTiles8 = 64
const SprBytes = 128
const NWords = 489
const NNormal = 425
const SndTuneA = 1
const SndTuneB = 2
const SndTick = 3
const SndPick = 4
const SndDrop = 5
const SndBad = 6
const SndMine = 7
const SndYours = 8
const SndThink = 9
const SndWin = 10
const SndLose = 11
const SndTie = 12
const SndHiss = 13
const NSpr = 4
const MinWords = 10
const ListRow = 4
const MsgCol = 10

data BitMask bytes
  1,2,4,8,16,32,64,128
end data

' the title board: T R I W / O R D S across the middle rows; the other
' cells are just letters (the title never checks them)
data TitleLet bytes
  1,2,3,4, 20,18,9,23, 15,18,4,19, 5,6,7,8
end data

record Box:
  u8 L
  u8 T
  u8 R
  u8 B
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 CPtr = 0
u16 Limit = 0
u16 LastW = 0
u16 Found = 0
Box Cur
Box Goal
bcd digits 4 Score1
bcd digits 4 Score2
u8 Bd[16]
u8 OnB[27]
u8 UsedB[62]
u8 Sel[3]
u8 NSel = 0
u8 N1 = 0
u8 N2 = 0
u8 Cx = 0
u8 Cy = 0
u8 Tu = 1
u8 Brain = 0
u8 Over = 0
u8 Quit = 0
u8 Stage = 0
u8 Menu = 0
u8 Tick = 0
u8 Asking = 0
u8 Avail = 0
u8 Deals = 0
' input
u8 J1 = 0
u8 Pj = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Press2 = 0
u8 WasB2 = 0
u8 WasStick = 0
u8 LastDir = 0
u8 Rep = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Li = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Stage = 1
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

turn_loop:
  Tu = 1
  PlayerTurn
  if Quit = 1 then
    ' you gave up: the computer has one more go
    Tu = 2
    ComputerTurn
    if Over = 9 then
      Over = 3
    else
      Over = 2
    end if
    goto game_end
  end if
  Tu = 2
  ComputerTurn
  if Over = 9 then
    Over = 1
    goto game_end
  end if
  goto turn_loop

game_end:
  HideCursor
  ClearMsg
  mute all
  select case Over
  case 1
    print at MsgCol,20, "I'M STUMPED"
    print at MsgCol,21, " YOU WIN!"
    play sound SndWin
  case 2
    print at MsgCol,20, "  I WIN!"
    print at MsgCol,21, "NICE GAME"
    play sound SndLose
  case else
    print at MsgCol,20, "I'M STUMPED"
    print at MsgCol,21, " WE TIED"
    play sound SndTie
  end select
  Stage = 4
  Pause(60)
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the word list

' letter K (0-2) of word Wn
function Letter(u16 Wn, u8 Lk) as u8
  u16 P = 0
  P = Wn * 3 + Lk
  return WordList[P]

function IsUsed(u16 Wn) as u8
  u8 Bt = 0
  u16 By = 0
  By = Wn >> 3
  Bt = UsedB[By] & BitMask[Wn & 7]
  if Bt <> 0 then return 1
  return 0

sub MarkUsed(u16 Wn):
  u16 By = 0
  By = Wn >> 3
  UsedB[By] = UsedB[By] | BitMask[Wn & 7]
  return
end sub

' 1 when word Wn can be made from the board and is not used yet
function Playable(u16 Wn) as u8
  u8 A = 0
  u8 B = 0
  u8 E = 0
  A = Letter(Wn, 0)
  B = Letter(Wn, 1)
  E = Letter(Wn, 2)
  if OnB[A] = 0 then return 0
  if OnB[B] = 0 then return 0
  if OnB[E] = 0 then return 0
  if IsUsed(Wn) = 1 then return 0
  return 1

' the list index of the word A B E, or 65535 when it is not in the list
function FindWord(u8 A, u8 B, u8 E) as u16
  u16 Wf = 0
  u16 P = 0
  for Wf = 0 to NWords - 1
    P = Wf * 3
    if WordList[P] = A then
      if WordList[P + 1] = B then
        if WordList[P + 2] = E then return Wf
      end if
    end if
  next
  return 65535

' how many list words the board allows
function CountPlayable as u8
  u16 Wc = 0
  u8 Nc = 0
  for Wc = 0 to NWords - 1
    if Playable(Wc) = 1 then
      if Nc < 250 then inc Nc
    end if
  next
  return Nc

' the computer's search: from its pointer to the end of its brain's part
' of the list; Found = the word, or 65535 when it is stumped
sub CpuSearch:
  Found = 65535
  do while CPtr < Limit
    if Playable(CPtr) = 1 then
      Found = CPtr
      inc CPtr
      exit do
    end if
    inc CPtr
  loop
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' sixteen different letters
sub Deal:
  u8 Dl = 0
  u8 Dk = 0
  fill array OnB with 0
  for Dk = 0 to 15
    do
      Rand
      Dl = Rs % 26 + 1
    loop until OnB[Dl] = 0
    Bd[Dk] = Dl
    OnB[Dl] = Dk + 1
  next
  return
end sub

' ---------------------------------------------------------------------------
' turns

sub PlayerTurn:
  ClearMsg
  print at MsgCol,20, "YOUR  TURN"
pt_again:
  GetWord
  if Quit = 1 then
    ClearPicks
    ClearMsg
    return
  end if
  W16 = FindWord(Bd[Sel[0]], Bd[Sel[1]], Bd[Sel[2]])
  if W16 = 65535 then
    Refuse(1)
    goto pt_again
  end if
  if IsUsed(W16) = 1 then
    Refuse(2)
    goto pt_again
  end if
  LastW = W16
  MarkUsed(LastW)
  HideCursor
  play sound SndMine
  AddWord(1, LastW)
  Pause(30)
  ClearPicks
  return
end sub

sub Refuse(u8 Why):
  HideCursor
  ClearMsg
  select case Why
  case 1
    print at MsgCol,20, "NOT A WORD"
  case else
    print at MsgCol,20, "WORD  USED"
  end select
  play sound SndBad
  Pause(70)
  ClearPicks
  ClearMsg
  print at MsgCol,20, "YOUR  TURN"
  return
end sub

sub ComputerTurn:
  u8 Ck = 0
  ClearMsg
  print at MsgCol,20, " MY  TURN"
  print at MsgCol,21, "THINKING.."
  play sound SndThink
  Pause(40)
  CpuSearch
  if Found = 65535 then
    Over = 9
    return
  end if
  LastW = Found
  MarkUsed(LastW)
  ' light its letters on the board, then list the word
  for Ck = 0 to 2
    C = Letter(LastW, Ck)
    D = OnB[C] - 1
    Sel[Ck] = D
    LightCell(D, 1)
    ShowSlot(Ck, C)
    Pause(10)
  next
  NSel = 3
  play sound SndYours
  AddWord(2, LastW)
  Pause(40)
  ClearPicks
  ClearMsg
  return
end sub

' the player's three picks (or GIVE UP): sets Sel[] and NSel, or Quit
sub GetWord:
  u8 Gc = 0
  u8 Gi = 0
  u8 Fp = 0
  Quit = 0
  LastDir = 0
  Rep = 0
  ' a button already down counts only after it is let go
  ReadPad
  SetGoal
gw_loop:
  Asking = 1
  Frame1
  ReadPad
  StickMove
  Glide
  if Press2 = 1 then
    if NSel > 0 then
      ClearPicks
      play sound SndDrop
    end if
  end if
  if Press = 0 then goto gw_loop
  if Cy = 4 then
    Quit = 1
    play sound SndHiss
    goto gw_done
  end if
  Gc = Cy * 4 + Cx
  ' already picked? the last pick is taken back; an earlier one takes
  ' back it and the picks after it
  Fp = 255
  for Gi = 0 to 2
    if Gi < NSel then
      if Sel[Gi] = Gc then Fp = Gi
    end if
  next
  if Fp <> 255 then
    Unpick(Fp)
    play sound SndDrop
    goto gw_loop
  end if
  Sel[NSel] = Gc
  LightCell(Gc, 1)
  ShowSlot(NSel, Bd[Gc])
  inc NSel
  play sound SndPick
  if NSel < 3 then goto gw_loop
  Pause(12)
gw_done:
  Asking = 0
  return
end sub

' take back picks from number Ui on
sub Unpick(u8 Ui):
  while NSel > Ui
    dec NSel
    LightCell(Sel[NSel], 0)
    ShowSlot(NSel, 0)
  end while
  return
end sub

sub ClearPicks:
  Unpick(0)
  return
end sub

' the stick: one step at once, then again every 6 frames while held
sub StickMove:
  D = Pj & 15
  if D = 0 then
    LastDir = 0
    return
  end if
  K = 0
  if D <> LastDir then
    K = 1
    Rep = 14
  else
    dec Rep
    if Rep = 0 then
      K = 1
      Rep = 6
    end if
  end if
  LastDir = D
  if K = 0 then return
  if D & 1 then
    if Cy > 0 then dec Cy
  end if
  if D & 2 then
    if Cy < 4 then inc Cy
  end if
  if Cy < 4 then
    if D & 4 then
      if Cx > 0 then dec Cx
    end if
    if D & 8 then
      if Cx < 3 then inc Cx
    end if
  end if
  SetGoal
  play sound SndTick
  return
end sub

' the box the cursor heads for: a cell, or the GIVE UP button
sub SetGoal:
  if Cy = 4 then
    Goal.L = 90
    Goal.T = 139
    Goal.R = 157
    Goal.B = 156
  else
    Goal.L = Cx * 24 + 77
    Goal.T = Cy * 24 + 29
    Goal.R = Goal.L + 21
    Goal.B = Goal.T + 21
  end if
  return
end sub

function Toward(u8 Now, u8 Want) as u8
  u8 Dist = 0
  if Now < Want then
    Dist = Want - Now
    if Dist > 4 then Dist = 4
    return Now + Dist
  end if
  Dist = Now - Want
  if Dist > 4 then Dist = 4
  return Now - Dist

' the cursor's corners move up to 4 pixels a frame toward the goal
sub Glide:
  Cur.L = Toward(Cur.L, Goal.L)
  Cur.T = Toward(Cur.T, Goal.T)
  Cur.R = Toward(Cur.R, Goal.R)
  Cur.B = Toward(Cur.B, Goal.B)
  DrawCursor
  return
end sub

sub DrawCursor:
  u8 Ly = 0
  u8 By = 0
  u8 Rx = 0
  Ly = Cur.T - 1
  By = Cur.B - 16
  Rx = Cur.R - 15
  set sprite 0 to Ly,Cur.L,SCtl,15
  set sprite 1 to Ly,Rx,SCtr,15
  set sprite 2 to By,Cur.L,SCbl,15
  set sprite 3 to By,Rx,SCbr,15
  update sprites
  return
end sub

sub HideCursor:
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' board cell Lc gets its letter's patterns (all three screen thirds)
sub LoadCell(u8 Lc):
  u16 Fo = 0
  u16 Vo = 0
  Fo = Bd[Lc] - 1
  Fo = Fo * 32
  Vo = Lc * 32 + 1024
  copy BigFont + Fo count 32 to vram.pattern + Vo
  Vo = Vo + 2048
  copy BigFont + Fo count 32 to vram.pattern + Vo
  Vo = Vo + 2048
  copy BigFont + Fo count 32 to vram.pattern + Vo
  return
end sub

' board cell Lc lit (On = 1) or plain
sub LightCell(u8 Lc, u8 Lit):
  u16 Vo = 0
  Vo = Lc * 32 + 1024
  if Lit = 1 then
    copy LitCol count 32 to vram.color + Vo
  else
    copy NormCol count 32 to vram.color + Vo
  end if
  return
end sub

sub DrawBoard:
  u8 Bx = 0
  u8 By = 0
  u8 Tc = 0
  for Ci = 0 to 15
    LoadCell(Ci)
    LightCell(Ci, 0)
    Bx = (Ci & 3) * 3 + 10
    By = (Ci >> 2) * 3 + 4
    Tc = Ci * 4 + 128
    put char Tc at Bx,By
    put char Tc + 1 at Bx + 1,By
    put char Tc + 2 at Bx,By + 1
    put char Tc + 3 at Bx + 1,By + 1
  next
  return
end sub

' slot Sk (0-2) of the word in play shows letter Lt (0: empty)
sub ShowSlot(u8 Sk, u8 Lt):
  u8 Sx = 0
  Sx = Sk * 2 + 13
  if Lt = 0 then
    put char TSlot at Sx,16
  else
    put char Lt + 64 at Sx,16
  end if
  return
end sub

' word Wn into side Sd's list (1 you, 2 the computer), and its count
sub AddWord(u8 Sd, u16 Wn):
  u8 Slot = 0
  u8 Ax = 0
  u8 Ay = 0
  u8 Ak = 0
  if Sd = 1 then
    Slot = N1 & 31
    Ax = 2
    inc N1
    inc Score1
  else
    Slot = N2 & 31
    Ax = 23
    inc N2
    inc Score2
  end if
  ' both columns full: clear them and start again at the top
  if Slot = 0 then
    for Ak = ListRow to ListRow + 15
      fill 32 count 7 at Ax,Ak
    next
  end if
  if Slot >= 16 then Ax = Ax + 4
  Ay = (Slot & 15) + ListRow
  for Ak = 0 to 2
    put char Letter(Wn, Ak) + 64 at Ax + Ak,Ay
  next
  ShowScores
  return
end sub

sub ShowScores:
  print at 2,22, "YOU"
  print Score1 at 6,22
  print at 22,22, "CPU"
  print Score2 at 26,22
  return
end sub

sub ClearMsg:
  fill 32 count 12 at MsgCol,20
  fill 32 count 12 at MsgCol,21
  return
end sub

sub DrawTable:
  print at 2,1, "TRI WORDS"
  if Brain = 0 then
    print at 18,1, "NORMAL BRAIN"
  else
    print at 19,1, "SUPER BRAIN"
  end if
  fill TRule count 28 at 2,2
  print at 2,3, "YOUR WORDS"
  print at 22,3, "MY WORDS"
  for Li = 4 to 19
    put char TVbar at 9,Li
    put char TVbar at 21,Li
  next
  for Li = 0 to 2
    ShowSlot(Li, 0)
  next
  print at 12,18, "GIVE UP"
  ShowScores
  return
end sub

sub NewGame:
  ' deal until the board holds enough words
  Deals = 0
  fill array UsedB with 0
  do
    Deal
    inc Deals
    Avail = CountPlayable()
  loop until Avail >= MinWords
  Score1 = 0
  Score2 = 0
  N1 = 0
  N2 = 0
  NSel = 0
  CPtr = 0
  Over = 0
  Quit = 0
  if Brain = 0 then
    Limit = NNormal
  else
    Limit = NWords
  end if
  NewScreen
  DrawTable
  DrawBoard
  Cx = 0
  Cy = 0
  SetGoal
  Cur.L = Goal.L
  Cur.T = Goal.T
  Cur.R = Goal.R
  Cur.B = Goal.B
  ShowScreen
  Stage = 3
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Nf):
  u8 Pk = 0
  for Pk = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up or joypad(2).up then J1 = J1 | 1
  if joypad(1).down or joypad(2).down then J1 = J1 | 2
  if joypad(1).left or joypad(2).left then J1 = J1 | 4
  if joypad(1).right or joypad(2).right then J1 = J1 | 8
  if joypad(1).button1 or joypad(2).button1 then J1 = J1 | 16
  if joypad(1).button2 or joypad(2).button2 then J1 = J1 | 32
  Pj = J1
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = J1 & 32
  Press2 = 0
  if V > 0 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1536
  copy TileCol count NTiles8 to vram.color + 1536
  copy TilePat count NTiles8 to vram.pattern + 3584
  copy TilePat count NTiles8 to vram.pattern + 5632
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a board spelling the name, the tune once, the menu
sub TitlePage:
  NewScreen
  fill array OnB with 0
  for Ci = 0 to 15
    Bd[Ci] = TitleLet[Ci]
  next
  DrawBoard
  put char TTri00 at 2,1
  put char TTri01 at 3,1
  print at 5,1, "TRI WORDS"
  fill TRule count 28 at 2,2
  print at 22,5, "BY BOB"
  print at 22,6, "BLACKMER"
  print at 22,8, "AHOY!"
  print at 22,9, "DEC 1988"
  print at 4,17, "NORMAL BRAIN"
  print at 4,18, "SUPER BRAIN"
  print at 4,19, "CREDITS"
  print at 2,21, "MAKE THREE-LETTER WORDS"
  print at 2,22, "UNTIL THE COMPUTER IS STUCK"
  ShowMenu
  ShowScreen
  Stage = 2
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 594
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
      play sound SndTick
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  select case Menu
  case 0
    Brain = 0
  case 1
    Brain = 1
  case 2
    Stage = 1
    CreditsPage
  end select
  return
end sub

sub ShowMenu:
  for J = 17 to 19
    put char 32 at 2,J
  next
  J = Menu + 17
  put char 62 at 2,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,1, "TRI WORDS"
  print at 2,3, "BASED ON TRI WORDS BY BOB"
  print at 2,4, "BLACKMER, AHOY! DECEMBER"
  print at 2,5, "1988 (COMMODORE 128)."
  print at 2,7, "TAKE TURNS WITH THE"
  print at 2,8, "COMPUTER MAKING WORDS OF"
  print at 2,9, "THREE DIFFERENT LETTERS"
  print at 2,10, "FROM THE BOARD. NO WORD"
  print at 2,11, "TWICE. STUMP IT TO WIN;"
  print at 2,12, "NORMAL BRAIN KNOWS FEWER."
  print at 2,14, "COLECOVISION GAME, MUSIC"
  print at 2,15, "AND PICTURES BY CLAUDE"
  print at 2,16, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,17, "IN AMY BY AMY BIENVENU,"
  print at 2,18, "2026."
  print at 2,20, "MUSIC: THREE LETTER WALTZ"
  print at 2,21, "(ORIGINAL)"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub


