data SceneFam bytes 3,11,2,8,1,6,7,6,8,7,11,2,10,10,0,9,1,0,5,9,5,4,4
data FamPatTab words = @HeFamPat0, @HeFamPat1, @HeFamPat2, @HeFamPat3, @HeFamPat4, @HeFamPat5, @HeFamPat6, @HeFamPat7, @HeFamPat8, @HeFamPat9, @HeFamPat10, @HeFamPat11
data FamColTab words = @HeFamCol0, @HeFamCol1, @HeFamCol2, @HeFamCol3, @HeFamCol4, @HeFamCol5, @HeFamCol6, @HeFamCol7, @HeFamCol8, @HeFamCol9, @HeFamCol10, @HeFamCol11
data SceneMapTab words
  @HeMap0, @HeMap1, @HeMap2, @HeMap3, @HeMap4, @HeMap5, @HeMap6, @HeMap7,
  @HeMap8, @HeMap9, @HeMap10, @HeMap11, @HeMap12, @HeMap13, @HeMap14, @HeMap15,
  @HeMap16, @HeMap17, @HeMap18, @HeMap19, @HeMap20, @HeMap21, @HeMap22
end data

' ShowScene: the picture of Scene on rows 1-7 (255 = darkness). The tile
' set of its family is unpacked only when the family changes.
sub ShowScene:
  Shown = Scene
  if Scene = 255 then
    for Y = 1 to 7
      fill 32 count 28 at 2,Y
    next
    print at 7,4, "IT IS PITCH DARK."
    return
  end if
  Fam = SceneFam[Scene]
  if Fam <> FamShown then
    decompress zx0 FamPatTab[Fam] to vram.pattern + 1024
    decompress zx0 FamColTab[Fam] to vram.color + 1024
    FamShown = Fam
  end if
  decompress zx0 SceneMapTab[Scene] to vram.name + 32
  return
end sub

' ShowCreatures: the bear, the mummy, the leopard, the demon and the raft
' stand in the picture as sprites while they are in the room (object
' numbers from adv.py: 47 bear, 24 mummy, 67 leopard, 56 demon, 63 raft)
sub ShowCreatures:
  Mag = 0
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  if Dark = 0 then
    if OL[47] = Rm then
      Creature(36, 64, SBearDL, 10, 15)
    end if
    if OL[24] = Rm then
      Creature(40, 170, SMummyDL, 15, 14)
    end if
    if OL[67] = Rm then
      Mag = 1
      Creature(30, 80, SLeopardDL, 1, 11)
    end if
    if OL[56] = Rm then
      Mag = 1
      Creature(22, 96, SDemonDL, 8, 11)
    end if
    if OL[63] = Rm then
      if Scene <> RiverScene then
        Creature(27, 160, SRaftDL, 10, 6)
      end if
    end if
  end if
  update sprites
  return
end sub

' Creature: four sprites (details first, so they are drawn on top)
sub Creature(u8 CY, u8 CX, u8 CP, u8 CBody, u8 CDet):
  ' the leopard and the demon are magnified (64 x 32 pixels)
  V = CX + 16
  if Mag = 1 then
    V = CX + 32
    sprites double
  else
    sprites simple
  end if
  J = CP + 4
  set sprite 0 to CY, CX, CP, CDet
  set sprite 1 to CY, V, J, CDet
  J = CP + 8
  set sprite 2 to CY, CX, J, CBody
  J = CP + 12
  set sprite 3 to CY, V, J, CBody
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub EditorialPage:
  nmi off
  display off
  fill mode 2 text color with $F0
  backdrop black
  cls
  print at 10,1, "THE HERMIT"
  print at 2,3, "A TEXT ADVENTURE BY ERIC"
  print at 2,4, "BRYANT, FROM COMPUTE!"
  print at 2,5, "MAGAZINE, NOVEMBER 1987."
  print at 2,7, "THE WHOLE STORY, EVERY ROOM"
  print at 2,8, "AND EVERY PUZZLE, WITH A"
  print at 2,9, "JOYSTICK MENU INSTEAD OF"
  print at 2,10, "TYPING, AND A PICTURE FOR"
  print at 2,11, "EACH PLACE."
  print at 2,13, "NEW MUSIC: THE HERMIT'S"
  print at 2,14, "LANTERN."
  print at 2,16, "COLECOVISION VERSION BY"
  print at 2,17, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub TitlePage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  Scene = TitleScene
  Shown = 255
  FamShown = 255
  ShowScene
  print at 11,10, "THE HERMIT"
  print at 4,12, "AN ADVENTURE UNDERGROUND"
  print at 12,16, "PLAY"
  print at 12,18, "HOW TO PLAY"
  print at 12,20, "CREDITS"
  print at 5,22, "1987 ERIC BRYANT  2026"
  Menu = 0
  screen on
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
  WasBtn2 = 1
title_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTick
  end if
  print at 10,16, " "
  print at 10,18, " "
  print at 10,20, " "
  Y = Menu * 2
  Y = Y + 16
  print at 10,Y, ">"

  if Press = 1 then goto title_done
  goto title_loop
title_done:
  mute all
  play sound SndOk
  return
end sub

sub HelpPages:
  Rearm
  wait
  nmi off
  display off
  cls
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "YOU ARE LOOKING FOR THE"
  print at 2,4, "HERMIT WHO LIVED IN THE"
  print at 2,5, "HILLS. EXPLORE, SOLVE THE"
  print at 2,6, "PUZZLES, FIND TEN TREASURES"
  print at 2,7, "AND BRING THEM ALL TO THE"
  print at 2,8, "SPACESHIP, THEN LAUNCH IT."
  print at 2,10, "STICK UP/DOWN: CHOOSE A"
  print at 2,11, "VERB, THEN STICK RIGHT OR"
  print at 2,12, "LEFT BUTTON: CHOOSE WHAT."
  print at 2,13, "LEFT BUTTON: DO IT."
  print at 2,14, "RIGHT BUTTON: BACK."
  print at 2,16, "WHEN THE STORY FILLS THE"
  print at 2,17, "SCREEN, MORE WAITS FOR A"
  print at 2,18, "BUTTON. SCORE 200 TO WIN."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

