' THE HERMIT
' The text adventure by Eric Bryant from COMPUTE! magazine, November 1987,
' for the ColecoVision in Amy by Amy Bienvenu.
'
' A hermit in the hills has vanished; under his cabin lie mines, an
' underground river, a village, a tomb and a spaceship. Find the ten
' treasures, bring them aboard the ship and launch it: 200 points.
'
' Screen: a picture of the place on rows 1-7, the score and moves on row 8,
' the story on rows 9-18 (it scrolls; MORE waits for a button when a long
' text fills it), a menu on rows 20-22.
'
' Controls (either joystick): up/down choose a verb (left column) or a
' noun (right column); right or the left button moves to the nouns; the
' left button carries out the command; the right button goes back. PUT
' asks where after the noun. Keypad not used.
'
' Inside: the adventure lives in data, not code. advc.py turns adv.py
' (rooms, objects, every rule of the listing as conditions and actions)
' into bytecode and packed text (a 191-entry dictionary: 9.4K of text in
' 5.9K with its tables). engine.asm runs the rules, wraps and scrolls the
' text and builds the menus. The pictures (scenes.py) are painted in
' Python, cut into tiles and grouped in ten ZX0-packed tile sets of at
' most 128 tiles, with 23 packed tile maps; the bear, the mummy, the
' leopard, the demon and the raft are sprites (art.py); the leopard and
' the demon are magnified.
'
' Liberties taken:
' - A verb and noun menu instead of typing; the noun menu lists only what
'   can be seen or is carried (and the six directions for GO), SAY offers
'   five words. INVENTORY, LOOK, SCORE and QUIT are menu verbs; RESTART is
'   QUIT, then a new game from the title. Synonyms (N, I, L, Q) are gone.
' - Pictures for every place, and short exits lines ("EXITS: NORTH SOUTH.").
' - Things in open containers are listed ("THERE IS A FLARE IN THE FLARE
'   GUN."); TAKE takes things out of open containers.
' - Several messages the listing printed without context were given one
'   (the bear and the leopard blocking the way south, the bin at the end
'   of the track, the crossbow fired at nothing, the sphinx's wrong answer).
'   The raft can only be built on the river shore, so the game cannot be
'   lost that way. The dark tunnels can be crossed without light (nothing
'   is seen there).
' - Score: 10 for each treasure in the spaceship, 5 for going down the
'   trapdoor, 10 for reaching the far shore, 40 for the sphinx, 15 for the
'   ankh, 30 for launching with all ten: 200, as in the original.
' - The pictures show what the player changed: the pushed refrigerator
'   and the trapdoor, the coal bin, the broken and mended track, the rope,
'   the door in the mine shaft, the cut vine, the open sarcophagus and
'   drawer, the dragon without smoke, the card in the slot, the rock.
' - No cartridge screen: the game starts on its title; the credits are in
'   the title menu.
' - New music (The Hermit's Lantern) and sound effects.
'
' House rules kept: columns 2-29, rows 1-22; at most four sprites (one
' creature) on screen; the frame loop is protected from the NMI and every
' screen is drawn with the NMI off after a wait.

const SndTick = 1
const SndMore = 2
const SndOk = 3
const SndBack = 4
const SndTreasure = 5
const SndDie = 6
const SndWin = 7
const SndTuneA = 8
const SndTuneB = 9
const FgTw = 0
const FgHc = 1
const FgSb = 2
const FgFl = 3
const FgLt = 4
const FgSmash = 5
const FgIr = 6
const FgBc = 7
const FgMc = 8
const FgLc = 9
const FgDc = 10
const FgPc = 11
const FgAc = 12
const FgS34 = 13
const FgLift = 14
const FgTd = 15
const FgSc = 16
const FgDead = 17
const FgWin = 18
const FgQuit = 19
const VbGo = 0
const VbLook = 1
const VbTake = 2
const VbDrop = 3
const VbExamine = 4
const VbOpen = 5
const VbClose = 6
const VbPut = 7
const VbInventory = 8
const VbRead = 9
const VbEnter = 10
const VbExit = 11
const VbPush = 12
const VbLift = 13
const VbHook = 14
const VbCut = 15
const VbLight = 16
const VbFill = 17
const VbBuild = 18
const VbShoot = 19
const VbHit = 20
const VbAttack = 21
const VbRub = 22
const VbOffer = 23
const VbSay = 24
const VbDrink = 25
const VbDive = 26
const VbScore = 27
const VbQuit = 28
const NVerbs = 29
const TitleScene = 0
const RiverScene = 11
const SBearDL = 0
const SBearDR = 4
const SBearBL = 8
const SBearBR = 12
const SMummyDL = 16
const SMummyDR = 20
const SMummyBL = 24
const SMummyBR = 28
const SLeopardDL = 32
const SLeopardDR = 36
const SLeopardBL = 40
const SLeopardBR = 44
const SDemonDL = 48
const SDemonDR = 52
const SDemonBL = 56
const SDemonBR = 60
const SRaftDL = 64
const SRaftDR = 68
const SRaftBL = 72
const SRaftBR = 76
const NTiles8 = 0
const SprBytes = 640

' world (engine.asm)
u8 OL[68]
u8 Fl[20]
u8 Opn[12]
u8 Pt[6]
u8 NL[70]
u8 WBuf[30]
u8 RowBuf[28]
u8 TxStk[16]
u16 TxPtr = 0
u16 Moves = 0
u8 Rm = 1
u8 Verb = 0
u8 Noun = 0
u8 Noun2 = 0
u8 Score = 0
u8 Scene = 0
u8 Dark = 0
u8 NCount = 0
u8 NeedNoun = 0
u8 PkV = 0
u8 PkN = 0
u8 PkCol = 0
u8 PkMode = 0
u8 InMore = 0
u8 TxDepth = 0
u8 TCol = 0
u8 TPend = 0
u8 TWLen = 0
u8 TAlt = 0
u8 TLines = 0
u8 StopF = 0
u8 ContF = 0
u8 Neg = 0
u8 RootOp = 0
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0
u8 NStart = 0
u8 SaveN = 0
' the cartridge
u16 NumU = 0
u8 Shown = 255
u8 FamShown = 255
u8 Fam = 0
u8 OldScore = 0
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 Dirty = 0
u8 Mag = 0
u8 HistN = 0
u8 Pg = 0
u8 Blink = 0
u8 Ended = 0
u8 J = 0
u8 V = 0
u8 Y = 0

  tile screen
  set sound table HeSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HelpPages
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if

new_game:
  GameScreen
  call asm HeStart
  NewPicture
  ShowCreatures
  call asm HeOverlay
  call asm HeStatus
  PkV = 0
  NewVerb

play_loop:
  Frame1
  ReadPad
  Dirty = 0
  if Stick = 1 then MoveStick
  if Press = 1 then FireLeft
  if Press2 = 1 then FireRight
  if Ended > 0 then goto game_end
  if Dirty = 1 then
    call asm HeDrawPick
  end if
  goto play_loop

game_end:
  mute all
  if Ended = 1 then play sound SndDie
  if Ended = 2 then play sound SndWin
  EndPicker
  Rearm
  pause until press
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------
' The menu

sub NewVerb:
  Verb = PkV
  PkN = 0
  PkCol = 0
  PkMode = 0
  call asm HeNouns
  call asm HeDrawPick
  return
end sub

sub MoveStick:
  if Up1 = 1 then
    if PkCol = 0 then
      if PkMode = 0 then
        if PkV = 0 then
          PkV = NVerbs - 1
        else
          dec PkV
        end if
        NewVerb
        play sound SndTick
      end if
    else
      if PkN > 0 then
        dec PkN
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Dn1 = 1 then
    if PkCol = 0 then
      if PkMode = 0 then
        inc PkV
        if PkV = NVerbs then PkV = 0
        NewVerb
        play sound SndTick
      end if
    else
      V = PkN + 1
      if V < NCount then
        PkN = V
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Rt1 = 1 then
    if PkCol = 0 then
      if NeedNoun > 0 then
        if NCount > 0 then
          PkCol = 1
          Dirty = 1
          play sound SndTick
        end if
      end if
    end if
  end if
  if Lf1 = 1 then
    if PkMode = 0 then
      if PkCol = 1 then
        PkCol = 0
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  return
end sub

sub FireLeft:
  if PkCol = 0 then
    if NeedNoun = 0 then
      Noun = 0
      Noun2 = 0
      RunTurn
      return
    end if
    if NCount > 0 then
      PkCol = 1
      Dirty = 1
      play sound SndTick
    end if
    return
  end if
  if NCount = 0 then return
  if PkMode = 0 then
    Noun = NL[PkN]
    Noun2 = 0
    if Verb = VbPut then
      SaveN = Noun
      PkMode = 1
      PkN = 0
      call asm HeTargets
      Dirty = 1
      play sound SndOk
      return
    end if
    RunTurn
    return
  end if
  Noun2 = NL[PkN]
  Noun = SaveN
  RunTurn
  return
end sub

sub FireRight:
  if PkMode = 1 then
    NewVerb
    PkCol = 1
    Dirty = 1
    play sound SndBack
    return
  end if
  if PkCol = 1 then
    PkCol = 0
    Dirty = 1
    play sound SndBack
  end if
  return
end sub

' RunTurn: the engine plays the command (the NMI is off: Frame1 ended)
sub RunTurn:
  play sound SndOk
  OldScore = Score
  call asm HeTurn
  if Scene <> Shown then NewPicture
  ShowCreatures
  call asm HeOverlay
  call asm HeStatus
  if HistN > 0 then Pager
  if Fl[FgDead] = 1 then
    Ended = 1
    return
  end if
  if Fl[FgWin] = 1 then
    Ended = 2
    return
  end if
  if Fl[FgQuit] = 1 then
    Ended = 3
    return
  end if
  if Score > OldScore then play sound SndTreasure
  NewVerb
  return
end sub

' Pager: when a turn wrote more than the window holds, the engine kept the
' lines that scrolled away (VRAM history). Show them ten at a time from
' the start, MORE between pages, ending on the window as it was.
sub Pager:
  call asm HeHistFinish
  Pg = 0
  V = HistN - 10
  while Pg < V
    call asm HeHistShow
    ' MORE blinks and has its own chime until a button is pressed
    InMore = 1
    play sound SndMore
    Blink = 0
    Press = 0
    Press2 = 0
    while Press = 0 and Press2 = 0
      if Blink = 0 then
        call asm HeMoreMark
      end if
      if Blink = 20 then
        call asm HeDrawDivider
      end if
      Frame1
      ReadPad
      inc Blink
      if Blink = 32 then Blink = 0
    end while
    play sound SndTick
    InMore = 0
    Pg = Pg + 10
    if Pg > V then Pg = V
  end while
  call asm HeHistShow
  call asm HeDrawDivider
  return
end sub

' NewPicture: unpacking with the display on can garble VRAM reads, so the
' screen goes blank for a moment; it comes back with the NMI still off
' (this can run in the middle of a turn)
sub NewPicture:
  display off
  ShowScene
  call asm HeDisplayOn
  return
end sub

' EndPicker: the menu area says how the game ended
sub EndPicker:
  for Y = 20 to 22
    fill 32 count 28 at 2,Y
  next
  if Ended = 1 then print at 9,20, "YOU HAVE DIED."
  if Ended = 2 then print at 7,20, "THE SHIP SOARS AWAY!"
  if Ended = 3 then print at 10,20, "GAME OVER"
  print at 7,22, "PRESS A BUTTON"
  return
end sub

' ---------------------------------------------------------------------------
' Frame and controls

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  ' the stick: one step when pushed, then a repeat while held
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 18
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' GameScreen: fonts, divider, empty picture
sub GameScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  FamShown = 255
  Shown = 255
  Ended = 0
  WasBtn = 1
  WasBtn2 = 1
  screen on
  nmi off
  return
end sub

