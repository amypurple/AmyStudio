cartridge "MATH MAGIC/MICHAEL KAELIN/1989"

' MATH MAGIC
' A ColecoVision game based on "Math Magic", COMPUTE!'s Gazette, July
' 1989 (Commodore 128, BASIC 7.0; no author named on the disk).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: choose addition, subtraction, multiplication or division and a
' level from 1 to 13. A sum appears on the scroll at the bottom; four
' tablets at the top of the sky hold four answers. Walk the wizard under
' the right tablet and cast a spark at it: 10 points. Five right answers
' climb a level and refill the hourglass. The hourglass holds 55 seconds;
' when it runs out the game is over. Finish level 13 and you graduate: the
' title of MATH WIZ. The end shows the score and the percentage of right
' casts.
'
' From the original (orig/math magic.bas): the four operations and levels
' 1-13; the sums (first number 1-12; multiplication and division by the
' level's number, 1-12 at random on level 13; addition and subtraction with
' a second number from 1 to 10 x level, subtraction never negative;
' division shown as product / level); four answer boxes in red, yellow,
' green, blue at the top, a cannon walking left and right under them and
' firing up; 10 points a right answer; five right answers a level, the
' timer starting again; the timer of eleven 5-second marks (55 seconds);
' the game over, the graduation message and MATH WIZ title after level 13;
' the score and percentage correct at the end.
'
' Liberties: the original's cannon and boxes became a wizard on a tower and
' four glowing tablets; the answers are chosen with the stick and the
' button (the original also did this: no keypad digits are typed); the
' operation and level are picked with the stick on the title instead of
' keys. The original's wrong answers were always the right one plus 1 to
' 10, so the smallest number was always right, and two of them could be
' equal: here they are 1 to 10 either side, all different, never negative.
' A wrong cast cost nothing on the C-128, so firing at all four boxes in
' turn always won: here a wrong cast takes 10 seconds from the hourglass
' and blanks that tablet (sweeping the tablets runs out of time), and the
' percentage counts tablet hits only (a spark between tablets fizzles).
' The last ten seconds tick. A level banner and fanfare; the original's
' end tune is shortened; no PLAY AGAIN question (the house rules).
'
' Controls: either controller. Title: up and down choose the operation (or
' HOW TO PLAY,
' CREDITS), left and right the level, a button starts. Play: left and right
' walk, a button casts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off after a
' wait, display off. Music first in the sound table, effects after; the
' title tune played once. Nothing flashes.

const TG0a = 128
const TG0b = 129
const TG1a = 130
const TG1b = 131
const TG2a = 132
const TG2b = 133
const TG3a = 134
const TG3b = 135
const TG4a = 136
const TG4b = 137
const TG5a = 138
const TG5b = 139
const TG6a = 140
const TG6b = 141
const TG7a = 142
const TG7b = 143
const TG8a = 144
const TG8b = 145
const TG9a = 146
const TG9b = 147
const TGpla = 148
const TGplb = 149
const TGmia = 150
const TGmib = 151
const TGtia = 152
const TGtib = 153
const TGdva = 154
const TGdvb = 155
const TGeqa = 156
const TGeqb = 157
const TGqua = 158
const TGqub = 159
const TLM00 = 160
const TLM01 = 161
const TLM10 = 162
const TLM11 = 163
const TLA00 = 164
const TLA01 = 165
const TLA10 = 166
const TLA11 = 167
const TLT00 = 168
const TLT01 = 169
const TLT10 = 170
const TLT11 = 171
const TLH00 = 172
const TLH01 = 173
const TLH10 = 174
const TLH11 = 175
const TLG00 = 176
const TLG01 = 177
const TLG10 = 178
const TLG11 = 179
const TLI00 = 180
const TLI01 = 181
const TLI10 = 182
const TLI11 = 183
const TLC00 = 184
const TLC01 = 185
const TLC10 = 186
const TLC11 = 187
const TB0tl = 188
const TB0t = 189
const TB0tr = 190
const TB0l = 191
const TB0r = 192
const TB0bl = 193
const TB0b = 194
const TB0br = 195
const TB1tl = 196
const TB1t = 197
const TB1tr = 198
const TB1l = 199
const TB1r = 200
const TB1bl = 201
const TB1b = 202
const TB1br = 203
const TB2tl = 204
const TB2t = 205
const TB2tr = 206
const TB2l = 207
const TB2r = 208
const TB2bl = 209
const TB2b = 210
const TB2br = 211
const TB3tl = 212
const TB3t = 213
const TB3tr = 214
const TB3l = 215
const TB3r = 216
const TB3bl = 217
const TB3b = 218
const TB3br = 219
const TSky = 220
const TStar1 = 221
const TStar2 = 222
const TStar3 = 223
const TMoon00 = 224
const TMoon01 = 225
const TMoon10 = 226
const TMoon11 = 227
const TCrenel = 228
const TStone = 229
const TPtl = 230
const TPt = 231
const TPtr = 232
const TPl = 233
const TPr = 234
const TPbl = 235
const TPb = 236
const TPbr = 237
const TTr = 238
const TTy = 239
const TTg = 240
const TTe = 241
const SRobe0 = 0
const SRobe1 = 4
const SFace0 = 8
const SFace1 = 12
const SFacec = 16
const SRobec = 20
const SSpark0 = 24
const SSpark1 = 28
const SBurst = 32
const SPuff = 36
const NTiles8 = 912
const SprBytes = 320
const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndRight = 4
const SndWrong = 5
const SndFizzle = 6
const SndLevel = 7
const SndTick = 8
const SndOver = 9
const SndWin = 10
const SndStart = 11
const NSpr = 6
const FullT = 3300
const CellT = 150
const WrongT = 600
const PxMin = 16
const PxMax = 224
const SparkTop = 44
const WizY = 111

record Problem:
  u8 A1
  u8 A2
  u8 An
  u8 Sa
  u8 Ch[4]
  u8 Gone[4]
end record

' tablet left columns
data BoxC bytes
  2, 9, 16, 23
end data

Problem Pz
bcd digits 5 Score
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 Tm = 0
u16 RR = 0
u16 CC = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Op = 0
u8 Lv = 1
u8 StartLv = 1
u8 C1 = 0
u8 Over = 0
u8 Cells = 0
' the wizard, his steps, the cast pose
u8 Px = 112
u8 Walk = 0
u8 CastT = 0
' the spark: on, x, y; the burst on a tablet: frames left, kind, x
u8 SOn = 0
u8 Sx = 0
u8 Sy = 0
u8 BurstT = 0
u8 BurstK = 0
u8 BurstX = 0
u8 NewQ = 0
u8 MsgT = 0
u8 Secs = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' scratch
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 T = 0
u8 Glen = 0
u8 Gb[10]

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 4 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  wait 40 frames
  EndScreen
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  ' the hourglass
  if Tm > 0 then dec Tm
  ShowTime
  if Tm = 0 then
    Over = 1
    exit sub
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearBanner
  end if
  if CastT > 0 then dec CastT
  ' a burst on a tablet; when it ends, a new sum after a right answer
  if BurstT > 0 then
    dec BurstT
    if BurstT = 0 then
      if NewQ = 1 then
        NewQ = 0
        NextProblem
      end if
    end if
  end if
  ' walking
  V = J1 & 12
  select case V
  case 4
    if Px > PxMin then
      Px -= 2
      inc Walk
    end if
  case 8
    if Px < PxMax then
      Px += 2
      inc Walk
    end if
  end select
  ' casting
  if Press = 1 then
    if SOn = 0 then
      if BurstT = 0 then
        SOn = 1
        Sx = Px
        Sy = WizY - 12
        CastT = 10
        play sound SndZap
      end if
    end if
  end if
  if SOn = 1 then MoveSpark
end sub

sub MoveSpark:
  if Sy > SparkTop then
    Sy -= 4
  else
    SOn = 0
    SparkHits
  end if
end sub

' which tablet is above the spark's centre (255 between tablets)
function BoxAt(u8 Cx) as u8
  u8 Col = 0, Rel = 0, B = 255
  Col = Cx >> 3
  if Col >= 2 then
    Rel = Col - 2
    B = Rel / 7
    Rel = Rel mod 7
    if Rel = 6 then B = 255
    if B > 3 then B = 255
  end if
  return B

sub SparkHits:
  u8 B = 0
  B = BoxAt(Sx + 7)
  BurstX = Sx
  if B = 255 then
    play sound SndFizzle
  elseif Pz.Gone[B] = 1 then
    play sound SndFizzle
  else
    inc CC
    BurstT = 24
    if B = Pz.Sa then
      BurstK = SBurst
      Score += 10
      inc RR
      inc C1
      ShowHud
      NewQ = 1
      if C1 >= 5 then
        if Lv = 13 then
          Over = 2
        else
          inc Lv
          C1 = 0
          Tm = FullT
          Cells = 99
          ShowHud
          Banner
          play sound SndLevel
        end if
      else
        play sound SndRight
      end if
    else
      ' a wrong tablet: it goes dark and the hourglass loses 10 seconds
      BurstK = SPuff
      Pz.Gone[B] = 1
      DrawBox(B)
      if Tm > WrongT then
        Tm -= WrongT
      else
        Tm = 1
      end if
      play sound SndWrong
    end if
  end if
end sub

' ---------------------------------------------------------------------------
' the sums (lines 290-500 of the original)

function Rnd(u8 N) as u8
  u8 R = 0
  Rand
  W16 = Rs & 255
  W16 = W16 * N
  R = highbyte W16
  return R + 1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
end sub

sub MakeProblem:
  u8 A1 = 0, A2 = 0, An = 0, L2 = 0
  A1 = Rnd(12)
  A2 = Lv
  if Lv = 13 then A2 = Rnd(12)
  if Op < 2 then
    L2 = Lv * 10
    A2 = Rnd(L2)
  end if
  select case Op
  case 0
    An = A1 + A2
  case 1
    if A1 < A2 then swap A1 with A2
    An = A1 - A2
  case 2
    An = A1 * A2
  case else
    An = A1
    A1 = A1 * A2
  end select
  Pz.A1 = A1
  Pz.A2 = A2
  Pz.An = An
  MakeChoices
end sub

' four different answers, the right one at a random place
sub MakeChoices:
  u8 P = 0, Q = 0, Ok = 0, D = 0
  for P = 0 to 3
    Pz.Gone[P] = 0
    Pz.Ch[P] = 255
  next
  Pz.Sa = Rnd(4) - 1
  Pz.Ch[Pz.Sa] = Pz.An
  for P = 0 to 3
    if P <> Pz.Sa then
      Ok = 0
      while Ok = 0
        D = Rnd(10)
        Rand
        V = Rs & 1
        if V = 0 then
          Q = Pz.An + D
        elseif Pz.An >= D then
          Q = Pz.An - D
        else
          Q = Pz.An + D
        end if
        Ok = 1
        for J = 0 to 3
          if Pz.Ch[J] = Q then Ok = 0
        next
      end while
      Pz.Ch[P] = Q
    end if
  next
end sub

sub NextProblem:
  MakeProblem
  for K = 0 to 3
    DrawBox(K)
  next
  DrawProblem
end sub

' ---------------------------------------------------------------------------
' drawing

' a number into the glyph buffer (glyph indexes 0-15)
sub PushNum(u8 N):
  u8 H = 0, Tn = 0
  H = N / 100
  Tn = N mod 100
  Tn = Tn / 10
  if N >= 100 then
    Gb[Glen] = H
    inc Glen
  end if
  if N >= 10 then
    Gb[Glen] = Tn
    inc Glen
  end if
  Gb[Glen] = N mod 10
  inc Glen
end sub

' the glyph buffer, tall, from column X on row Y
sub DrawGlyphs:
  u8 G = 0, C = 0
  C = X
  for I = 1 to Glen
    G = Gb[I - 1] << 1
    G += TG0a
    put char G at C,Y
    inc G
    T = Y + 1
    put char G at C,T
    inc C
  next
end sub

sub DrawBox(u8 B):
  u8 L = 0, R = 0, Tb = 0
  L = BoxC[B]
  R = L + 5
  Tb = B << 3
  Tb += TB0tl
  put char Tb at L,3
  fill Tb + 1 count 4 at L + 1,3
  put char Tb + 2 at R,3
  for Y = 4 to 5
    put char Tb + 3 at L,Y
    fill 32 count 4 at L + 1,Y
    put char Tb + 4 at R,Y
  next
  put char Tb + 5 at L,6
  fill Tb + 6 count 4 at L + 1,6
  put char Tb + 7 at R,6
  if Pz.Gone[B] = 0 then
    Glen = 0
    PushNum(Pz.Ch[B])
    X = L + 4 - Glen
    if Glen = 1 then X = L + 2
    Y = 4
    DrawGlyphs
  end if
end sub

sub DrawProblem:
  for Y = 18 to 19
    fill 32 count 18 at 7,Y
  next
  Glen = 0
  PushNum(Pz.A1)
  Gb[Glen] = 10 + Op
  inc Glen
  PushNum(Pz.A2)
  Gb[Glen] = 14
  inc Glen
  Gb[Glen] = 15
  inc Glen
  V = 18 - Glen
  V = V >> 1
  X = 7 + V
  Y = 18
  DrawGlyphs
end sub

sub ShowTime:
  u8 N = 0
  W16 = Tm / CellT
  N = W16
  if Tm > 0 then
    if N < 22 then inc N
  end if
  if N = Cells then exit sub
  Cells = N
  for I = 0 to 21
    T = TTe
    if I < N then
      T = TTg
      if I < 15 then T = TTy
      if I < 7 then T = TTr
    end if
    X = I + 7
    put char T at X,22
  next
  ' the last ten seconds tick
  if N <= 4 then
    if N > 0 then play sound SndTick
  end if
end sub

sub ShowHud:
  print at 2,1, "SCORE "
  print Score at 8,1 digits 5
  print at 21,1, "LEVEL "
  print Lv at 27,1 digits 2
  ' five dots: the right answers of this level
  for I = 0 to 4
    T = 46
    if I < C1 then T = 42
    X = I + 15
    put char T at X,1
  next
end sub

sub Banner:
  print at 9,9, " LEVEL    "
  print Lv at 16,9 digits 2
  MsgT = 90
end sub

sub SkyAll:
  for Y = 0 to 23
    fill TSky count 32 at 0,Y
  next
end sub

sub ClearBanner:
  fill TSky count 10 at 9,9
end sub

' the night sky, the moon, the tower, the scroll, the hourglass
sub DrawField:
  SkyAll
  for I = 0 to 40
    Rand
    V = Rs & 31
    V = V mod 28
    V += 2
    W16 = Rs >> 8
    Y = W16 mod 12
    Y += 2
    T = TStar1
    K = Rs & 3
    if K = 1 then T = TStar2
    if K = 2 then T = TStar3
    put char T at V,Y
  next
  put char TMoon00 at 24,9
  put char TMoon01 at 25,9
  put char TMoon10 at 24,10
  put char TMoon11 at 25,10
  fill 32 count 28 at 2,1
  fill TCrenel count 32 at 0,15
  for Y = 16 to 23
    fill TStone count 32 at 0,Y
  next
  put char TPtl at 6,17
  fill TPt count 18 at 7,17
  put char TPtr at 25,17
  for Y = 18 to 19
    put char TPl at 6,Y
    fill 32 count 18 at 7,Y
    put char TPr at 25,Y
  next
  put char TPbl at 6,20
  fill TPb count 18 at 7,20
  put char TPbr at 25,20
  fill 32 count 28 at 2,22
  print at 2,22, "TIME"
end sub

' sprites 0-1 the wizard, 2 the spark, 3 the burst
sub DrawSprites:
  u8 Fr = 0
  if CastT > 0 then
    set sprite 0 to WizY,Px,SFacec,11
    set sprite 1 to WizY,Px,SRobec,13
  else
    Fr = Walk >> 3
    Fr = Fr & 1
    Fr = Fr << 2
    set sprite 0 to WizY,Px,SFace0 + Fr,11
    set sprite 1 to WizY,Px,SRobe0 + Fr,13
  end if
  if SOn = 1 then
    Fr = Tick >> 2
    Fr = Fr & 1
    Fr = Fr << 2
    set sprite 2 to Sy,Sx,SSpark0 + Fr,15
  else
    set sprite 2 to 192,0,0,0
  end if
  if BurstT > 0 then
    if BurstK = SBurst then
      set sprite 3 to 30,BurstX,SBurst,11
    else
      set sprite 3 to 30,BurstX,SPuff,14
    end if
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
end sub

sub NewGame:
  Score = 0
  Lv = StartLv
  C1 = 0
  RR = 0
  CC = 0
  Tm = FullT
  Cells = 99
  Over = 0
  SOn = 0
  BurstT = 0
  NewQ = 0
  CastT = 0
  MsgT = 0
  Px = 112
  NewScreen
  DrawField
  ShowHud
  MakeProblem
  for K = 0 to 3
    DrawBox(K)
  next
  DrawProblem
  ShowTime
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
end sub

sub EndScreen:
  u16 Pct = 0
  NewScreen
  backdrop dark blue
  fill mode 2 text color with $F4
  if Over = 2 then
    print at 7,3, "CONGRATULATIONS,"
    print at 6,5, "YOU'VE GRADUATED!"
    print at 2,7, "YOU HAVE EARNED THE TITLE OF"
    print at 10,10, "MATH WIZ!"
    play sound SndWin
  else
    print at 10,7, "GAME OVER"
    play sound SndOver
  end if
  if CC = 0 then CC = 1
  Pct = RR * 100
  Pct = Pct / CC
  print at 9,14, "SCORE"
  print Score at 17,14 digits 5
  print at 9,16, "LEVEL"
  print Lv at 20,16 digits 2
  print at 6,18, "% CORRECT"
  print Pct at 19,18 digits 3
  ShowScreen
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
end sub

' the title: the logo, the four operations, the level, credits
sub TitlePage:
  NewScreen
  SkyAll
  for I = 0 to 30
    Rand
    V = Rs & 31
    V = V mod 28
    V += 2
    W16 = Rs >> 8
    Y = W16 mod 22
    T = TStar1
    K = Rs & 1
    if K = 1 then T = TStar2
    put char T at V,Y
  next
  ' MATH MAGIC: ten letter places, two tiles each (columns 5-26)
  X = 5
  for I = 0 to 9
    select case I
    case 0, 5
      T = TLM00
    case 1, 6
      T = TLA00
    case 2
      T = TLT00
    case 3
      T = TLH00
    case 7
      T = TLG00
    case 8
      T = TLI00
    case 9
      T = TLC00
    case else
      T = 0
    end select
    if T > 0 then
      put char T at X,3
      put char T + 1 at X + 1,3
      put char T + 2 at X,4
      put char T + 3 at X + 1,4
    end if
    X += 2
  next
  for Y = 7 to 21
    fill 32 count 24 at 4,Y
  next
  print at 7,8, "COMPUTE!'S GAZETTE"
  print at 11,9, "JULY 1989"
  print at 9,11, "ADDITION"
  print at 9,12, "SUBTRACTION"
  print at 9,13, "MULTIPLICATION"
  print at 9,14, "DIVISION"
  print at 9,16, "HOW TO PLAY"
  print at 9,17, "CREDITS"
  print at 9,18, "LEVEL"
  print at 8,20, "STICK AND BUTTON"
  ShowLevel
  Menu = Op
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 500
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then MenuStick
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 4 then
    HowToPage
  elseif Menu = 5 then
    CreditsPage
  else
    Op = Menu
  end if
end sub

sub MenuStick:
  K = V & 1
  if K > 0 then
    if Menu > 0 then dec Menu
  end if
  K = V & 2
  if K > 0 then
    if Menu < 5 then inc Menu
  end if
  K = V & 4
  if K > 0 then
    if StartLv > 1 then dec StartLv
  end if
  K = V & 8
  if K > 0 then
    if StartLv < 13 then inc StartLv
  end if
  ShowMenu
  ShowLevel
end sub

sub ShowLevel:
  print at 15,18, "<   >"
  print StartLv at 17,18 digits 2
end sub

sub ShowMenu:
  for J = 11 to 17
    put char 32 at 7,J
  next
  J = Menu + 11
  if Menu >= 4 then J = Menu + 12
  put char 62 at 7,J
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    for K = 0 to 3
      Pz.Gone[K] = 0
      Pz.Ch[K] = K + 10
      DrawBox(K)
    next
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,8, "A SUM SHOWS AT THE BOTTOM,"
    print at 2,9, "LIKE 7 + 5. THE FOUR"
    print at 2,10, "TABLETS IN THE SKY HOLD"
    print at 2,11, "FOUR ANSWERS."
    print at 2,13, "WALK THE WIZARD UNDER THE"
    print at 2,14, "RIGHT ANSWER (LEFT/RIGHT)"
    print at 2,15, "AND PRESS THE BUTTON TO"
    print at 2,16, "CAST A SPARK AT IT."
    print at 2,18, "ON THE TITLE, PICK + - X /"
    print at 2,19, "AND A LEVEL FROM 1 TO 13."
    set sprite 0 to 150,224,SFace0,11
    set sprite 1 to 150,224,SRobe0,13
    set sprite 2 to 128,224,SSpark0,15
    update sprites
  else
    print at 2,1, "SCORING                2/2"
    print at 2,3, "A RIGHT ANSWER: 10 POINTS."
    print at 2,4, "FIVE RIGHT ANSWERS: NEXT"
    print at 2,5, "LEVEL AND A FULL HOURGLASS."
    print at 2,7, "A WRONG CAST TAKES 10"
    print at 2,8, "SECONDS AND THAT TABLET"
    print at 2,9, "GOES BLANK."
    print at 2,11, "THE HOURGLASS HOLDS 55"
    print at 2,12, "SECONDS. WHEN IT RUNS OUT,"
    print at 2,13, "THE GAME IS OVER. FINISH"
    print at 2,14, "LEVEL 13 TO BECOME A"
    print at 2,15, "MATH WIZ!"
    print at 2,17, "TIP: WORK THE SUM OUT"
    print at 2,18, "BEFORE YOU WALK."
    set sprite 0 to 150,224,SFacec,11
    set sprite 1 to 150,224,SRobec,13
    update sprites
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "MATH MAGIC"
  print at 2,5, "BASED ON MATH MAGIC,"
  print at 2,6, "COMPUTE!'S GAZETTE, JULY"
  print at 2,7, "1989 (COMMODORE 128)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: THE WIZARD'S SUM"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
end sub

