  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,68,85,75,69,32,79,70,32,69,65,82,76,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
end data

record Plr:
  bcd digits 6 Rs
  bcd digits 6 Tot
  u8 Won
end record

' a timer for the title tune (kit/tuneonce.py style)
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Va = 0
Plr Pl[2]
bcd digits 6 Ta
bcd digits 6 Tb
u8 Board[60]
u8 Got[26]
u8 UsedB[13]
u8 PIdx = 0
u8 Cat = 0
u8 Turn = 0
u8 Mode = 1
u8 SetI = 0
u8 NSet = 3
u8 Played = 0
u8 Phase = 0
u8 Seg = 0
u8 Pos = 0
u8 Cur = 0
u8 Act = 0
u8 Found = 0
u8 Winner = 0
u8 SolveK = 0
u8 Sx = 0
u8 Sy = 0
u8 Want = 0
u8 Picked = 0
u8 Hid = 0
u8 Dist = 0
u8 NLet = 0
u8 CpuT = 0
u8 Sel = 0
u8 Pads = 0
u8 OldPads = 0
u8 Ed = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleK = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Ri = 0
u8 Ci = 0
u8 Hi = 0
u8 Si = 0
u8 Wi = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TwSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 4
  sprites flicker on
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 3 then goto title
  RunSet
  ' the end: the result, then back to the title on a press
  ' (left alone, Amy's sleep blanks the screen after 30 seconds)
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a set of puzzles

sub RunSet:
  Pl[0].Won = 0
  Pl[1].Won = 0
  Pl[0].Tot = 0
  Pl[1].Tot = 0
  fill array UsedB with 0
  Played = 0
  Turn = 0
rs_next:
  RunPuzzle
  inc Played
  ResultPage
  if Played < NSet then goto rs_next
  return
end sub

sub RunPuzzle:
  PickPuzzle
  Pl[0].Rs = 0
  Pl[1].Rs = 0
  fill array Got with 0
  DrawPlay
  Winner = 255
rp_turn:
  ShowScores
  Msg
  PutName(2, MsgRow)
  if IsCpu() = 1 then
    print at 11,MsgRow, "IS THINKING"
  else
    print at 11,MsgRow, "SPIN OR SOLVE?"
  end if
  ChooseAction
  if Act = 1 then
    SolveTurn
  else
    SpinTurn
  end if
  if Winner = 255 then goto rp_turn
  return
end sub

' a random puzzle not yet used in this set: a category, then one of its 20
sub PickPuzzle:
  Rand
  Cat = (Rs >> 4) % 5
  Rand
  N = (Rs >> 3) % 20
  PIdx = Cat * 20 + N
  for Si = 1 to 100
    if IsUsed(PIdx) = 1 then
      inc PIdx
      if PIdx >= 100 then PIdx = 0
    end if
  next
  K = PIdx >> 3
  UsedB[K] = UsedB[K] | BitT[PIdx & 7]
  Cat = PIdx / 20
  W16 = PIdx
  Va = W16 * 60
  copy PuzTxt + Va count 60 to Board
  return
end sub

function IsUsed(u8 P) as u8
  u8 B = 0
  B = UsedB[P >> 3] & BitT[P & 7]
  if B <> 0 then return 1
  return 0

function IsCpu as u8
  if Mode = 1 and Turn = 1 then return 1
  return 0

sub NextTurn:
  Turn = Turn ^ 1
  return
end sub

' ---------------------------------------------------------------------------
' spinning and guessing

sub SpinTurn:
  SpinWheel
  Msg
  select case SegKind[Seg]
  case 1
    print at 2,MsgRow, "TILT! SCORE LOST"
    play sound SndTilt
    Pl[Turn].Rs = 0
    ShowScores
    Pause(70)
    NextTurn
  case 2
    print at 2,MsgRow, "LOSE A TURN"
    for Wi = 1 to 3
      play sound SndBuzz
      Pause(16)
    next
    Pause(20)
    NextTurn
  case else
    N = SegH[Seg]
    W16 = N
    W16 = W16 * 100
    print at 2,MsgRow, digits$(W16, 4) + " A LETTER: PICK"
    if N < 10 then put char 32 at 2,MsgRow
    GuessTurn
  end select
  return
end sub

sub GuessTurn:
  Picked = 0
  Phase = 4
  if IsCpu() = 1 then CpuT = CpuLetter()
  PickLetter(0)
  Got[Cur] = 1
  Picked = Cur
  ' dim the letter on the panel
  put char TUsed at PanelCol + (Cur % 7) * 2,PanelRow + (Cur / 7) * 2
  C = Cur + 65
  Found = Reveal(C)
  Msg
  if Found = 0 then
    print at 2,MsgRow, "NO   IN THE PUZZLE"
    put char C at 5,MsgRow
    play sound SndBuzz
    Pause(60)
    NextTurn
    return
  end if
  print at 2,MsgRow, digits$(Found, 1) + "  ! SPIN AGAIN OR SOLVE"
  put char C at 4,MsgRow
  Pause(40)
  CountHidden
  if Hid = 0 then WinPuzzle
  return
end sub

' shows every cell holding letter Ch, one at a time, scoring each
function Reveal(u8 Ch) as u8
  u8 Nf = 0
  u8 Kc = 0
  for Ri = 0 to 2
    for Ci = 0 to 19
      Kc = Ri * 20 + Ci
      if Board[Kc] = Ch then
        put char Ch at BoardCol + Ci,Ri * 2 + 4
        inc Nf
        play sound SndDing
        AddValue
        ShowScores
        Pause(14)
      end if
    next
  next
  return Nf

' the space's value to the player at the wheel, in BCD
sub AddValue:
  N = SegH[Seg]
  for Hi = 1 to N
    Pl[Turn].Rs += 100
  next
  return
end sub

' Hid: hidden cells; Dist: their distinct letters; NLet: letter cells
sub CountHidden:
  u8 Seen[26]
  fill array Seen with 0
  Hid = 0
  Dist = 0
  NLet = 0
  for Si = 0 to 59
    C = Board[Si]
    if C <> 32 then
      inc NLet
      K = C - 65
      if Got[K] = 0 then
        inc Hid
        if Seen[K] = 0 then
          Seen[K] = 1
          inc Dist
        end if
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' solving: fill the hidden letters one by one

sub SolveTurn:
  u8 Ok = 1
  Phase = 5
  Msg
  print at 2,MsgRow, "FILL IN THE LETTERS"
  for SolveK = 0 to 59
    C = Board[SolveK]
    if Ok = 1 and C <> 32 then
      K = C - 65
      if Got[K] = 0 then
        Sx = BoardCol + (SolveK % 20)
        Sy = (SolveK / 20) * 2 + 4
        Want = K
        set sprite SprMark to Sy * 8 - 5,Sx * 8 - 4,SBox,11
        update sprites
        CpuT = Want
        PickLetter(1)
        put char Cur + 65 at Sx,Sy
        if Cur = Want then
          play sound SndPick
        else
          Ok = 0
        end if
      end if
    end if
  next
  set sprite SprMark to 207,0,0,0
  update sprites
  if Ok = 1 then
    WinPuzzle
    return
  end if
  Msg
  print at 2,MsgRow, "SORRY, THAT IS WRONG"
  play sound SndBuzz
  Pause(24)
  play sound SndBuzz
  Pause(50)
  DrawBoard
  NextTurn
  return
end sub

sub WinPuzzle:
  Winner = Turn
  Pl[Turn].Rs += 100
  ShowScores
  ' show what is left
  for Si = 0 to 59
    C = Board[Si]
    if C <> 32 then put char C at BoardCol + (Si % 20),(Si / 20) * 2 + 4
  next
  Msg
  PutName(2, MsgRow)
  print at 11,MsgRow, "SOLVES IT!"
  play sound SndWin
  Pause(90)
  inc Pl[Turn].Won
  Pl[Turn].Tot += Pl[Turn].Rs
  return
end sub

' ---------------------------------------------------------------------------
' choices: SPIN / SOLVE and the letter panel (the computer moves the same
' cursor at a human pace)

sub ChooseAction:
  u8 Wt = 0
  Phase = 2
  Act = 0
  print at 18,20, "SPIN  SOLVE"
  DrawArrow
  if IsCpu() = 1 then
    Pause(40)
    CountHidden
    if Dist <= 2 or Hid * 4 <= NLet then
      Act = 1
      play sound SndPick
      DrawArrow
    end if
    Pause(30)
  else
    ReadEdges
ca_loop:
    Frame1
    ReadEdges
    if (Ed & 12) <> 0 then
      Act = Act ^ 1
      play sound SndPick
      DrawArrow
    end if
    if (Ed & 16) = 0 then goto ca_loop
  end if
  set sprite SprArrow to 207,0,0,0
  update sprites
  print at 18,20, "           "
  return
end sub

sub DrawArrow:
  if Act = 0 then
    set sprite SprArrow to 159,16 * 8 - 4,SArrow,15
  else
    set sprite SprArrow to 159,22 * 8 - 4,SArrow,15
  end if
  update sprites
  return
end sub

' Any = 1: any letter may be picked (solving); else unused letters only.
' Leaves the pick in Cur.
sub PickLetter(u8 Any):
  u8 Done = 0
  u8 Cnt = 0
  DrawCursor
  ReadEdges
pl_loop:
  Frame1
  if IsCpu() = 1 then
    inc Cnt
    if Cnt >= 9 then
      Cnt = 0
      if Cur = CpuT then
        Done = 1
      else
        CpuStep
        play sound SndPick
      end if
    end if
  else
    ReadEdges
    if (Ed & 15) <> 0 then
      MoveCursor(Ed)
      play sound SndPick
    end if
    if (Ed & 16) <> 0 then
      if Any = 0 and Got[Cur] = 1 then
        play sound SndBloop
      else
        Done = 1
      end if
    end if
  end if
  DrawCursor
  if Done = 0 then goto pl_loop
  set sprite SprBox to 207,0,0,0
  update sprites
  return
end sub

sub MoveCursor(u8 E):
  if (E & 4) <> 0 and Cur > 0 then dec Cur
  if (E & 8) <> 0 and Cur < 25 then inc Cur
  if (E & 1) <> 0 and Cur >= 7 then Cur = Cur - 7
  if (E & 2) <> 0 then
    if Cur + 7 <= 25 then
      Cur = Cur + 7
    else
      ' the short last row: down from its empty columns goes to Z
      if Cur < 21 then Cur = 25
    end if
  end if
  return
end sub

' one step of the computer's cursor towards CpuT: column first, then row
' (every column has a letter in the rows above the short last one)
sub CpuStep:
  u8 Cc = 0
  u8 Ct = 0
  Cc = Cur % 7
  Ct = CpuT % 7
  if Cc < Ct then
    MoveCursor(8)
  else
    if Cc > Ct then
      MoveCursor(4)
    else
      if Cur < CpuT then
        MoveCursor(2)
      else
        MoveCursor(1)
      end if
    end if
  end if
  return
end sub

sub DrawCursor:
  X = PanelCol + (Cur % 7) * 2
  Y = PanelRow + (Cur / 7) * 2
  set sprite SprBox to Y * 8 - 5,X * 8 - 4,SBox,15
  update sprites
  return
end sub

' the computer's letter: the most common one not yet used, now and then
' the second or third
function CpuLetter as u8
  u8 Skip = 0
  u8 Res = 255
  u8 Lt = 0
  Rand
  Skip = Rs & 7
  if Skip > 2 then Skip = 0
  for Si = 0 to 25
    Lt = Freq[Si]
    if Res = 255 and Got[Lt] = 0 then
      if Skip = 0 then
        Res = Lt
      else
        dec Skip
      end if
    end if
  next
  if Res = 255 then
    ' fewer unused letters than skips: the first unused one
    for Si = 0 to 25
      if Res = 255 and Got[Si] = 0 then Res = Si
    next
  end if
  return Res

' ---------------------------------------------------------------------------
' the wheel: the hand and the gem run round, slow down and stop on a space
' picked at random (each one time in eight)

sub SpinWheel:
  u16 Rem2 = 0
  u8 St = 0
  u8 Op = 0
  u8 Tg = 0
  Phase = 3
  Rand
  Tg = (Rs >> 5) & 7
  Rand
  Rem2 = ((Rs >> 6) & 1) + 2
  Rem2 = Rem2 * 256
  T = Tg * 32
  T = T - Pos
  Rem2 = Rem2 + T
  play sound SndSpin
sw_loop:
  W16 = Rem2 / 20
  St = W16 + 1
  if St > 24 then St = 24
  if Rem2 < St then St = Rem2
  Op = (Pos + 16) >> 5
  Pos = Pos + St
  Rem2 = Rem2 - St
  if ((Pos + 16) >> 5) <> Op then play sound SndClick
  DrawWheelHand
  Frame1
  if Rem2 > 0 then goto sw_loop
  Seg = ((Pos + 16) >> 5) & 7
  Pause(20)
  return
end sub

sub DrawWheelHand:
  N = ((Pos + 16) >> 5) & 7
  set sprite SprHand to 119,56,SHand0 + N * 4,1
  K = Pos >> 3
  set sprite SprGem to GemY[K],GemX[K],SGem,8
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawPlay:
  NewScreen
  DrawFrame
  DrawBoard
  print at 9,10, "CATEGORY:"
  select case Cat
  case 0
    print at 19,10, "PERSON"
  case 1
    print at 19,10, "PLACE"
  case 2
    print at 19,10, "THING"
  case 3
    print at 19,10, "PHRASE"
  case else
    print at 19,10, "TITLE"
  end select
  ' the wheel: 12 x 11 cells of disc, then the labels
  for Ri = 0 to 10
    Va = Ri * 12
    W16 = Ri + 11
    W16 = W16 * 32 + 2
    copy WheelMap + Va count 12 to vram.name + W16
  next
  print at 6,11, "100"
  print at 9,12, "1000"
  print at 10,16, "TILT"
  print at 10,19, "400"
  print at 6,20, "200"
  print at 3,19, "500"
  print at 2,16, "LOSE"
  print at 3,12, "300"
  ' the letter panel
  for Li = 0 to 25
    put char Li + 65 at PanelCol + (Li % 7) * 2,PanelRow + (Li / 7) * 2
  next
  T = Turn
  Turn = 0
  PutName(3, 1)
  Turn = 1
  PutName(18, 1)
  Turn = T
  DrawWheelHand
  ShowScores
  ShowScreen
  return
end sub

' the gold frame round the board (rows 3-9, columns 4-27)
sub DrawFrame:
  put char TFtl at 4,3
  fill TFh count 22 at 5,3
  put char TFtr at 27,3
  for Ri = 4 to 8
    put char TFl at 4,Ri
    fill TFelt count 22 at 5,Ri
    put char TFr at 27,Ri
  next
  put char TFbl at 4,9
  fill TFb count 22 at 5,9
  put char TFbr at 27,9
  return
end sub

' the cells: felt, a plate for a hidden letter, or the letter
sub DrawBoard:
  u8 Kb = 0
  for Ri = 0 to 2
    for Ci = 0 to 19
      Kb = Ri * 20 + Ci
      C = Board[Kb]
      if C = 32 then
        put char TFelt at BoardCol + Ci,Ri * 2 + 4
      else
        if Got[C - 65] = 1 then
          put char C at BoardCol + Ci,Ri * 2 + 4
        else
          put char TPlate at BoardCol + Ci,Ri * 2 + 4
        end if
      end if
    next
  next
  return
end sub

' scores (this puzzle) and puzzles won; a coin marks the player at the wheel
sub ShowScores:
  print Pl[0].Rs at 3,2
  print Pl[1].Rs at 17,2
  N = Pl[0].Won
  print at 10,2, "WON " + digits$(N, 2)
  N = Pl[1].Won
  print at 24,2, "WON " + digits$(N, 2)
  if Turn = 0 then
    put char TCoin at 2,1
    put char 32 at 17,1
  else
    put char 32 at 2,1
    put char TCoin at 17,1
  end if
  return
end sub

sub PutName(u8 Col, u8 Row):
  if Turn = 0 then
    print at Col,Row, "PLAYER 1"
    return
  end if
  if Mode = 1 then
    print at Col,Row, "COMPUTER"
  else
    print at Col,Row, "PLAYER 2"
  end if
  return
end sub

sub Msg:
  fill 32 count 28 at 2,MsgRow
  return
end sub

' ---------------------------------------------------------------------------
' after each puzzle: who won it, the set so far; after the last, the set

sub ResultPage:
  u8 Last = 0
  if Played >= NSet then Last = 1
  Pause(30)
  NewScreen
  DrawFrame
  for Ri = 0 to 2
    for Ci = 0 to 19
      C = Board[Ri * 20 + Ci]
      if C = 32 then C = TFelt
      put char C at BoardCol + Ci,Ri * 2 + 4
    next
  next
  print at 9,1, "PUZZLE SOLVED"
  T = Turn
  Turn = Winner
  PutName(8, 11)
  print at 17,11, "WINS!"
  Turn = T
  print at 13,13, "WON   POINTS"
  for Li = 0 to 1
    T = Turn
    Turn = Li
    PutName(2, Li * 2 + 15)
    Turn = T
    N = Pl[Li].Won
    print at 14,Li * 2 + 15, digits$(N, 2)
  next
  print Pl[0].Tot at 19,15
  print Pl[1].Tot at 19,17
  N = Played
  print at 2,20, "PUZZLE " + digits$(N, 2)
  N = NSet
  print at 12,20, "OF " + digits$(N, 2)
  if Last = 1 then SetVerdict
  if Last = 0 then print at 7,MsgRow, "PRESS THE BUTTON"
  ShowScreen
  Phase = 6
  if Last = 1 then
    Phase = 7
    play sound SndWin
    return
  end if
  ReadEdges
rp_wait:
  Frame1
  ReadEdges
  if (Ed & 16) = 0 then goto rp_wait
  ' the loser of a puzzle starts the next one
  Turn = Winner ^ 1
  return
end sub

sub SetVerdict:
  Ta = Pl[0].Tot
  Tb = Pl[1].Tot
  T = Turn
  if Pl[0].Won > Pl[1].Won then goto sv_one
  if Pl[1].Won > Pl[0].Won then goto sv_two
  if Ta > Tb goto sv_one
  if Tb > Ta goto sv_two
  print at 8,MsgRow, "THE SET IS A TIE"
  return
sv_one:
  Turn = 0
  goto sv_name
sv_two:
  Turn = 1
sv_name:
  PutName(4, MsgRow)
  print at 13,MsgRow, "TAKES THE SET!"
  Turn = T
  return
end sub

' ---------------------------------------------------------------------------
' input and timing

sub ReadEdges:
  OldPads = Pads
  if Mode = 2 then
    Pads = PadOf(Turn + 1)
  else
    Pads = PadOf(1) | PadOf(2)
  end if
  Ed = Pads & (Pads ^ OldPads)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

sub Pause(u8 Nf):
  for Wi = 1 to Nf
    Frame1
  next
  return
end sub

sub Rand:
  Xor(Rs)
  return
end sub

' a 16-bit xorshift (7, 9, 8)
sub Xor(ref u16 R):
  W16 = R << 7
  R = R ^ W16
  W16 = R >> 9
  R = R ^ W16
  W16 = R << 8
  R = R ^ W16
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for K = 0 to NSpr - 1
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: the name on the board, plates turning over one by one; START /
' PLAYERS / PUZZLES / CREDITS; the tune once

sub TitlePage:
  Phase = 1
  NewScreen
  DrawFrame
  fill TPlate count 8 at 12,5
  fill TPlate count 5 at 13,7
  Sel = 0
  TitleK = 0
  ShowMenu
  print at 6,20, "AHOY! FEBRUARY 1986"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 432
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  if (Tick & 15) = 0 and TitleK < 13 then
    TitleLetter
    inc TitleK
  end if
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  Ed = Pads & (Pads ^ OldPads)
  if (Ed & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (Ed & 2) <> 0 then
    if Sel < 3 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  select case Sel
  case 1
    if (Ed & 28) <> 0 then
      Mode = 3 - Mode
      play sound SndPick
      ShowMenu
    end if
  case 2
    if (Ed & 28) <> 0 then
      inc SetI
      if SetI > 2 then SetI = 0
      play sound SndPick
      ShowMenu
    end if
  case else
    if (Ed & 16) <> 0 then goto tp_done
  end select
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  NSet = SetSizes[SetI]
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Sel = 3 then CreditsPage
  return
end sub

' turns over the next plate of TREASURE / WHEEL
sub TitleLetter:
  if TitleK < 8 then
    select case TitleK
    case 0
      C = 84
    case 1
      C = 82
    case 2
      C = 69
    case 3
      C = 65
    case 4
      C = 83
    case 5
      C = 85
    case 6
      C = 82
    case else
      C = 69
    end select
    put char C at 12 + TitleK,5
  else
    K = TitleK - 8
    select case K
    case 0
      C = 87
    case 1
      C = 72
    case 2
      C = 69
    case 3
      C = 69
    case else
      C = 76
    end select
    put char C at 13 + K,7
  end if
  play sound SndDing
  return
end sub

sub ShowMenu:
  for Si = 0 to 3
    put char 32 at 6,Si * 2 + 12
  next
  put char 62 at 6,Sel * 2 + 12
  print at 8,12, "START"
  if Mode = 1 then
    print at 8,14, "ONE VS COMPUTER"
  else
    print at 8,14, "TWO PLAYERS    "
  end if
  N = SetSizes[SetI]
  print at 8,16, "PUZZLES IN A SET: " + digits$(N, 2)
  print at 8,18, "CREDITS"
  return
end sub

sub CreditsPage:
  Phase = 8
  NewScreen
  print at 8,2, "TREASURE  WHEEL"
  print at 2,5, "BASED ON TREASURE WHEEL BY"
  print at 2,6, "BOB BLACKMER, AHOY!"
  print at 2,7, "FEBRUARY 1986, COMMODORE 64."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: DOUBLOON WALTZ"
  print at 2,17, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

