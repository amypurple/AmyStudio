record Missile:
  u16 X
  u16 Y
  i16 DX
  i16 DY
  u8 St
  u8 N
  u8 Tg
  u8 Pat
  u8 T
end record

Missile Ms[NSlot]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
i16 Di = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
bcd digits 6 NextSpare = 0
u8 CityDead[6]
u8 CX = 128
u8 CY = 80
u8 Hold = 0
u8 ExX = 0
u8 ExY = 0
u8 Wave = 0
u8 Div = 23
u8 StepAcc = 0
u8 Left = 0
u8 GapN = 0
u8 Pts = 0
u8 BaseOk = 1
u8 Spares = 0
u8 Phase = 0
u8 PT = 0
u8 Over = 0
u8 Pg = 0
u8 Kills = 0
u8 Landed = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Sl = 0
u8 Ds = 0
u8 Ck = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 R = 0

  tile screen
  set sound table RaSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  Pg = $A4
  print at 8,8, "                "
  print at 8,9, "   GAME  OVER   "
  print at 8,10, "                "
  print at 8,11, "  SCORE ", Score, "  "
  print at 8,12, "  BEST  ", Hi, "  "
  print at 8,13, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  MoveSight
  if Phase = 1 then
    WaveEnd
    return
  end if
  Interceptor
  StepAcc = StepAcc + 13
  while StepAcc >= Div
    StepAcc = StepAcc - Div
    EnemyStep
  end while
  Bursts
  ' the wave is over when nothing is left to come or to burst
  if Left > 0 then return
  for Sl = 0 to 6
    if Ms[Sl].St > 0 then return
  next
  Phase = 1
  PT = 0
  return
end sub

' the sight: a pixel a frame, two after holding the stick 10 frames
sub MoveSight:
  K = J1 & 15
  if K = 0 then
    Hold = 0
    return
  end if
  if Hold < 10 then inc Hold
  V = 1
  if Hold >= 10 then V = 2
  if J1 & 4 then
    if CX >= XMin + V then
      CX = CX - V
    else
      CX = XMin
    end if
  end if
  if J1 & 8 then
    CX = CX + V
    if CX > XMax then CX = XMax
  end if
  if J1 & 1 then
    if CY >= YMin + V then
      CY = CY - V
    else
      CY = YMin
    end if
  end if
  if J1 & 2 then
    CY = CY + V
    if CY > YMax then CY = YMax
  end if
  return
end sub

' slot 0: fire (button held is fine), fly 10 frames, burst
sub Interceptor:
  select case Ms[0].St
    case 0
      if BaseOk = 0 then return
      V = J1 & 16
      if V = 0 then return
      Ms[0].X = BaseX * 256
      Ms[0].Y = BaseY * 256
      Di = CX
      Di = Di - BaseX
      Ms[0].DX = Di * 256 / ShotT
      Di = CY
      Di = Di - BaseY
      Ms[0].DY = Di * 256 / ShotT
      Ms[0].N = ShotT
      Ms[0].St = 1
      ExX = CX
      ExY = CY
      play sound SndFire
    case 1
      Ms[0].X = Ms[0].X + Ms[0].DX
      Ms[0].Y = Ms[0].Y + Ms[0].DY
      Ms[0].N = Ms[0].N - 1
      if Ms[0].N = 0 then
        Ms[0].St = 2
        Ms[0].T = 0
        play sound SndBoom
      end if
  end select
  return
end sub

' one step of the C64's warhead loop: launch into a free slot (at most one
' every Gap steps), every flying warhead moves 1/256 of its way
sub EnemyStep:
  if GapN > 0 then dec GapN
  for Sl = 1 to 6
    if Ms[Sl].St = 0 then
      if Left > 0 then
        if GapN = 0 then Launch(Sl)
      end if
    else
      if Ms[Sl].St = 1 then
        Ms[Sl].X = Ms[Sl].X + Ms[Sl].DX
        Ms[Sl].Y = Ms[Sl].Y + Ms[Sl].DY
        Ms[Sl].N = Ms[Sl].N + 1
        if Ms[Sl].N = 0 then Land(Sl)
      end if
    end if
  next
  return
end sub

sub Launch(u8 S):
  Rand
  V = Rs & 255
  if V >= 208 then V = V - 104
  X = V + 24
  W16 = Rs >> 8
  Y = W16 & 15
  Y = Y + 8
  K = W16 >> 4
  K = K & 7
  Ms[S].X = X * 256
  Ms[S].Y = Y * 256
  Ms[S].Tg = K
  Di = TgX[K]
  Di = Di - X
  Ms[S].DX = Di
  Ms[S].Pat = PatFor(Di)
  Di = TgY[K]
  Di = Di - Y
  Ms[S].DY = Di
  Ms[S].N = 0
  Ms[S].St = 1
  dec Left
  GapN = Gap
  return
end sub

' the trail's slant from the run across 256 steps
function PatFor(i16 D) as u8
  if D < -90 then return SML2
  if D < -30 then return SML1
  if D <= 30 then return SM0
  if D <= 90 then return SMR1
  return SMR2

' a warhead reached its target: the town or the base goes
sub Land(u8 S):
  Ms[S].St = 2
  Ms[S].T = 0
  inc Landed
  K = Ms[S].Tg
  play sound SndCrash
  if K >= 6 then
    if BaseOk = 1 then
      BaseOk = 0
      DrawBase
    end if
    return
  end if
  if CityDead[K] = 1 then return
  CityDead[K] = 1
  DrawCity(K)
  return
end sub

' the bursts grow and shrink; the interceptor's burst catches warheads
sub Bursts:
  for Sl = 0 to 6
    if Ms[Sl].St = 2 then
      Ms[Sl].T = Ms[Sl].T + 1
      if Ms[Sl].T >= ExLen then Ms[Sl].St = 0
    end if
  next
  if Ms[0].St <> 2 then return
  K = ExPh[Ms[0].T]
  R = ExRad[K]
  for Sl = 1 to 6
    if Ms[Sl].St = 1 then
      if Caught(Sl) = 1 then
        Ms[Sl].St = 2
        Ms[Sl].T = 0
        inc Kills
        Score += Pts
        if Score > Hi then Hi = Score
        play sound SndBoom
        ShowScore
      end if
    end if
  next
  return
end sub

' 1 when slot S's tip is within R of the burst's middle (both ways)
function Caught(u8 S) as u8
  W16 = Ms[S].X >> 8
  X = W16
  W16 = Ms[S].Y >> 8
  if W16 < 32 then return 0
  W16 = W16 - 32
  Y = W16
  if X >= ExX then
    V = X - ExX
  else
    V = ExX - X
  end if
  if V > R then return 0
  if Y >= ExY then
    V = Y - ExY
  else
    V = ExY - Y
  end if
  if V > R then return 0
  return 1

' after a wave: 40 frames, each town counted (16 frames apart), then the
' spare town, the end or the next wave
sub WaveEnd:
  inc PT
  if PT < 40 then return
  V = PT - 40
  K = V & 15
  if K = 0 then
    K = V >> 4
    if K < 6 then
      if CityDead[K] = 0 then
        Score += 100
        if Score > Hi then Hi = Score
        ShowScore
        play sound SndCount
      end if
      return
    end if
  end if
  if PT < 136 then return
  if Score >= NextSpare then
    inc Spares
    NextSpare += 10000
    play sound SndSpare
  end if
  if CityLeft() = 0 then
    if Spares = 0 then
      Over = 1
      return
    end if
  end if
  NextWave
  return
end sub

function CityLeft as u8
  C = 0
  for J = 0 to 5
    if CityDead[J] = 0 then inc C
  next
  return C

' the next wave: spare towns rebuild lost ones, the base is rebuilt
sub NextWave:
  for Ck = 0 to 5
    if CityDead[Ck] = 1 then
      if Spares > 0 then
        dec Spares
        CityDead[Ck] = 0
        DrawCity(Ck)
      end if
    end if
  next
  if Wave < 20 then inc Wave
  Div = 24 - Wave
  if Div < 10 then Div = 10
  Pts = Wave * 10
  Rand
  V = Rs & 7
  Left = V + 16
  GapN = 0
  StepAcc = 0
  BaseOk = 1
  DrawBase
  Phase = 0
  ShowStatus
  if Wave > 1 then play sound SndWave
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprite 0 the sight, 1 the interceptor or its burst, 2-7 the
' warheads or their bursts
sub DrawSprites:
  set sprite 0 to CY - 8,CX - 7,SCross,15
  for Ds = 0 to 6
    J = Ds + 1
    select case Ms[Ds].St
      case 0
        set sprite J to 192,0,0,0
      case 1
        W16 = Ms[Ds].X >> 8
        X = W16
        W16 = Ms[Ds].Y >> 8
        if Ds = 0 then
          Y = W16
          set sprite J to Y - 8,X - 8,SShot,15
        else
          if W16 < 52 then
            set sprite J to 192,0,0,0
          else
            Y = W16 - 32
            set sprite J to Y - 14,X - 8,Ms[Ds].Pat,9
          end if
        end if
      case 2
        K = ExPh[Ms[Ds].T]
        K = K * 4 + SEx0
        if Ds = 0 then
          set sprite J to ExY - 9,ExX - 8,K,11
        else
          C = Ms[Ds].Tg
          W16 = Ms[Ds].X >> 8
          X = W16
          W16 = Ms[Ds].Y >> 8
          Y = W16 - 32
          set sprite J to Y - 9,X - 8,K,8
        end if
    end select
  next
  update sprites
  return
end sub

sub DrawCity(u8 N):
  X = CityCol[N]
  if CityDead[N] = 1 then
    put char TRuin00 at X,19
    put char TRuin01 at X + 1,19
    put char TRuin10 at X,20
    put char TRuin11 at X + 1,20
  else
    put char TCity00 at X,19
    put char TCity01 at X + 1,19
    put char TCity10 at X,20
    put char TCity11 at X + 1,20
  end if
  return
end sub

sub DrawBase:
  if BaseOk = 1 then
    put char TBase00 at 15,18
    put char TBase01 at 16,18
    put char TBase10 at 15,19
    put char TBase11 at 16,19
  else
    put char TWreck00 at 15,18
    put char TWreck01 at 16,18
    put char TWreck10 at 15,19
    put char TWreck11 at 16,19
  end if
  return
end sub

sub ShowScore:
  print at 2,1, Score
  print at 23,1, Hi
  return
end sub

sub ShowStatus:
  NumU = Wave
  print at 15,1, digits$(NumU, 2)
  ' spare towns as little houses under the score
  for J = 0 to 3
    V = 32
    if J < Spares then V = TSpare
    put char V at J + 9,1
  next
  ShowScore
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 14,1, "W"
  print at 20,1, "HI"
  for Sl = 0 to 6
    Ms[Sl].St = 0
  next
  for Sl = 0 to 5
    CityDead[Sl] = 0
  next
  Score = 0
  NextSpare = 10000
  Spares = 0
  Wave = 0
  CX = 128
  CY = 80
  Hold = 0
  Over = 0
  Kills = 0
  Landed = 0
  NextWave
  DrawSprites
  ShowScreen
  play sound SndWave
  Pg = $A3
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: RED ALERT in alarm blocks over the night, a warhead falling
' and a burst, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  print at 6,1, "AHOY! SEPTEMBER 1987"
  copy TitleMap count 384 to vram.name + 64
  for K = 0 to 31
    put char THill at K,15
    put char TDirt at K,16
  next
  print at 7,18, "BY TONY BRANTNER"
  print at 13,20, "START"
  print at 13,21, "CREDITS"
  if Hi > 0 then
    print at 9,22, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Pg = $A2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' a warhead slides down the right of the title and bursts over the hills
sub TitleAnim:
  V = Tick & 127
  if V < 96 then
    Y = V + 8
    X = 220 - (V >> 2)
    set sprite 2 to Y,X,SML1,9
    set sprite 1 to 192,0,0,0
  else
    K = V - 96
    K = K >> 3
    K = ExPh[K * 2 + 1]
    K = K * 4 + SEx0
    set sprite 2 to 192,0,0,0
    set sprite 1 to 110,190,K,11
  end if
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 20
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "RED ALERT"
  print at 2,5, "BASED ON RED ALERT BY"
  print at 2,6, "TONY BRANTNER, AHOY!"
  print at 2,7, "SEPTEMBER 1987 (COMMODORE"
  print at 2,8, "64 MACHINE LANGUAGE), AFTER"
  print at 2,9, "THE ARCADE MISSILE COMMAND."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: NIGHT WATCH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Pg = $A1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

