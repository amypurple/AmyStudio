  tile screen
  set sound table GpSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowToPage
    goto title
  end if
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame1
  DrawStrip
  DrawSprites
  Animate
  ReadPad
  PlayPass
  ShowHud
  if Over = 0 then goto play_loop

  EndMessage
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one pass of play (one frame)

sub PlayPass:
  if OverT > 0 then
    dec OverT
    if OverT = 0 then Over = 1
    MoveAliens
    return
  end if
  V = J1 | J2
  MoveShip
  Refuel
  FireLaser
  MoveShot
  GameTick
  MoveAliens
  Effects
  return
end sub

' up/down 1 pixel a frame; left/right: turn round first, then fly (the
' ground scrolls 1 pixel a frame) after 8 frames held
sub MoveShip:
  if RefT > 0 then return
  K = V & 1
  if K > 0 then
    if Sy > SyMin then dec Sy
  end if
  K = V & 2
  if K > 0 then
    if Sy < SyMax then inc Sy
  end if
  if FlipT > 0 then dec FlipT
  K = V & 4
  if K > 0 then
    if Face = 1 then
      Face = 0
      FlipT = 8
    elseif FlipT = 0 then
      if StripP = 0 then
        StripP = StripPx - 1
      else
        dec StripP
      end if
    end if
    return
  end if
  K = V & 8
  if K > 0 then
    if Face = 0 then
      Face = 1
      FlipT = 8
    elseif FlipT = 0 then
      inc StripP
      if StripP >= StripPx then StripP = 0
    end if
  end if
  return
end sub

' the pad under the ship (0-2), or 255: its middle within 4 pixels of the
' ship's middle (pixel 128)
function PadUnder as u8
  u8 Pi = 0
  u16 Px = 0
  for Pi = 0 to 2
    Px = PadAt[Pi]
    Px = Px << 3
    Px = Px + StripPx
    Px = Px - StripP
    if Px >= StripPx then Px = Px - StripPx
    ' Px: the pad's left pixel from column 2 (pixel 16); middle + 12
    Px = Px + 28
    if Px >= 124 then
      if Px <= 132 then return Pi
    end if
  next
  return 255

' loading: with no bombs, at the bottom, over a lit pad, stick held down
sub Refuel:
  if RefT > 0 then
    dec RefT
    K = RefT & 3
    if K = 0 then
      if Ammo < Load then
        inc Ammo
        play sound SndLoad
      end if
    end if
    if Ammo >= Load then
      RefT = 0
      FinishLoad
    end if
    return
  end if
  if Ammo > 0 then return
  if Sy < SyMax then return
  K = V & 2
  if K = 0 then return
  N = PadUnder()
  if N = 255 then return
  if N = UsedPad then return
  RefPad = N
  RefT = 200
  return
end sub

' after a load: the next load is smaller, the ticks faster
sub FinishLoad:
  K = Level >> 1
  K = K + 2
  if Load > K + 5 then
    Load = Load - K
  else
    Load = 5
  end if
  if Hf > 0 then dec Hf
  SetTickP
  return
end sub

' a tick lasts (Hf + 4) x 13 / 10 frames (Hf jiffies + about 4 for the
' C64's BASIC loop, measured in jsc64: 19 frames at level 1, 4.3 at 5)
sub SetTickP:
  W16 = Hf + 4
  W16 = W16 * 13
  W16 = W16 / 10
  TickP = W16
  return
end sub

sub FireLaser:
  if Press = 0 then return
  if ShotOn = 1 then return
  if RefT > 0 then return
  if Ammo = 0 then
    play sound SndEmpty
    return
  end if
  dec Ammo
  ShotOn = 1
  ShotDir = Face
  ShotL = Sy + 7
  if Face = 1 then
    ShotX = 128
  else
    ShotX = 112
  end if
  play sound SndLaser
  return
end sub

' the beam: 8 pixels a frame; the first saucer whose body (6 lines) crosses
' its line and whose 16 pixels meet the beam's is hit
sub MoveShot:
  if ShotOn = 0 then return
  if ShotDir = 1 then
    ShotX = ShotX + 8
    if ShotX > 224 then
      ShotOn = 0
      return
    end if
  else
    ShotX = ShotX - 8
    if ShotX < 16 then
      ShotOn = 0
      return
    end if
  end if
  for Ai = 0 to 11
    if Al[Ai].Live = 1 then
      X = Al[Ai].Col
      X = X << 3
      Y = Al[Ai].Y
      if ShotX >= X then
        K = ShotX - X
      else
        K = X - ShotX
      end if
      if K < 16 then
        if ShotL >= Y then
          K = ShotL - Y
          if K < 6 then
            HitAlien
            ShotOn = 0
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' saucer Ai shot: points, the bonus every 500 / 300
sub HitAlien:
  BoomX = X
  BoomY = Y
  BoomT = BoomN
  EraseAli
  Al[Ai].Live = 0
  play sound SndHit
  Score = Score + Si
  Bo = Bo + Si
  inc Kills
  if Bo >= BonusAt then
    Bo = Bo - BonusAt
    BonusAt = 300
    Score = Score + Si
    if Landed > 0 then dec Landed
    TankT = 50
    TankY = 150
    play sound SndBonus
  end if
  return
end sub

' the game tick: one saucer slot at random
sub GameTick:
  inc TickT
  if TickT < TickP then return
  TickT = 0
  Rand
  K = Rs & 15
  if K >= Nl then K = K - Nl
  if Al[K].Live = 0 then
    SpawnAt
    return
  end if
  if Al[K].Mv > 0 then return
  Ai = K
  C = Al[Ai].Col
  Y = Al[Ai].Y
  if Y >= AliLast then
    LandAlien
    return
  end if
  if Blocked() = 1 then return
  Al[Ai].Mv = 8
  return
end sub

' a saucer below in the same column closer than GapY lines
function Blocked as u8
  u8 Bi = 0
  u8 By = 0
  for Bi = 0 to 11
    if Al[Bi].Live = 1 then
      if Al[Bi].Col = C then
        By = Al[Bi].Y
        if By > Y then
          By = By - Y
          if By < GapY then return 1
        end if
      end if
    end if
  next
  return 0

' an empty slot K: a saucer at the top in a random column, if it is free
sub SpawnAt:
  Ai = K
  J = Rs >> 4
  J = J & 15
  if J >= 12 then J = J - 12
  C = SpawnCol[J]
  for Ki = 0 to 11
    if Al[Ki].Live = 1 then
      if Al[Ki].Col = C then
        if Al[Ki].Y < AliTop + GapY then return
      end if
    end if
  next
  Al[Ai].Live = 1
  Al[Ai].Col = C
  Al[Ai].Y = AliTop
  Al[Ai].Mv = 0
  DrawAli
  return
end sub

' saucer Ai reaches the ground
sub LandAlien:
  BoomX = C << 3
  BoomY = Y
  BoomT = BoomN
  EraseAli
  Al[Ai].Live = 0
  inc Landed
  play sound SndLand
  if Landed >= 5 then
    OverT = OverN
    ShotOn = 0
  end if
  return
end sub

' saucers sliding: 2 lines a frame
sub MoveAliens:
  for Ai = 0 to 11
    if Al[Ai].Live = 1 then
      if Al[Ai].Mv > 0 then
        Al[Ai].Y = Al[Ai].Y + 2
        Al[Ai].Mv = Al[Ai].Mv - 2
        DrawAli
        if Al[Ai].Mv = 0 then
          ' arrived: the row above is free again
          C = Al[Ai].Col
          Y = Al[Ai].Y
          Y = Y >> 3
          dec Y
          J = C
          ClearCell
          J = C + 1
          ClearCell
        end if
      end if
    end if
  next
  return
end sub

' the cell J, Y back to the starfield
sub ClearCell:
  K = BgAt(J, Y)
  put char K at J,Y
  return
end sub

function BgAt(u8 Cc, u8 Rr) as u8
  u8 H = 0
  H = Cc * 5
  H = H + Rr * 11
  H = H & 31
  if H = 3 then return TStar1
  if H = 20 then return TStar2
  return 32

' draw saucer Ai at its Y: top tiles in row Y / 8, bottom tiles below it
' when Y is between rows
sub DrawAli:
  C = Al[Ai].Col
  Y = Al[Ai].Y
  N = Y & 7
  Y = Y >> 3
  K = N << 1
  K = K + TAli0tl
  put char K at C,Y
  inc K
  X = C + 1
  put char K at X,Y
  if N > 0 then
    inc K
    inc Y
    put char K at C,Y
    inc K
    put char K at X,Y
  end if
  return
end sub

sub EraseAli:
  C = Al[Ai].Col
  Y = Al[Ai].Y
  N = Y & 7
  Y = Y >> 3
  J = C
  ClearCell
  J = C + 1
  ClearCell
  if N > 0 then
    inc Y
    J = C
    ClearCell
    J = C + 1
    ClearCell
  end if
  return
end sub

' timers of the explosion and the supply ship
sub Effects:
  if BoomT > 0 then dec BoomT
  if TankT > 0 then
    dec TankT
    if TankY > 10 then TankY = TankY - 3
  end if
  return
end sub

' the saucers' lights move every 16 frames (patterns of tiles 128-143)
sub Animate:
  inc AnimT
  if AnimT < 16 then return
  AnimT = 0
  AnimF = AnimF ^ 1
  if AnimF = 1 then
    copy AliAnim + 128 count 128 to vram.pattern + 1024
    copy AliAnim + 128 count 128 to vram.pattern + 3072
    copy AliAnim + 128 count 128 to vram.pattern + 5120
  else
    copy AliAnim count 128 to vram.pattern + 1024
    copy AliAnim count 128 to vram.pattern + 3072
    copy AliAnim count 128 to vram.pattern + 5120
  end if
  return
end sub

' the ground strip, row 19: cells StripP / 8 on, moved left StripP & 7
sub DrawStrip:
  u8 Sh = 0
  u8 Ce = 0
  u8 Ca = 0
  u8 Cb = 0
  u8 Pa = 0
  u8 Ti = 0
  if StripP = OldP then return
  OldP = StripP
  W16 = StripP & 7
  Sh = W16
  W16 = W16 << 6
  copy StripTab + W16 count 64 to vram.pattern + 5264
  W16 = StripP >> 3
  Ce = W16
  for Ti = 0 to 27
    Ca = StripCell[Ce]
    inc Ce
    if Ce >= StripLen then Ce = 0
    Cb = StripCell[Ce]
    Pa = Ca & 3
    if Pa = 0 then
      Pa = Cb & 3
      if Pa = 1 then
        Ca = Cb
        Pa = 0
      else
        Pa = 255
      end if
    end if
    if Pa = 255 then
      StripBuf[Ti] = 32
    else
      K = Pa << 1
      K = K + TStrip00
      Ca = Ca >> 2
      if Ca = UsedPad then inc K
      StripBuf[Ti] = K
    end if
  next
  copy StripBuf count 28 to vram.name + 610
  return
end sub

' xorshift (7, 9, 8)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' sprites: 0 the ship, 1 the beam, 2 an explosion, 3 the supply ship
sub DrawSprites:
  Y = Sy - 1
  K = SShipl
  if Face = 1 then K = SShipr
  C = 15
  if Ammo = 0 then C = 9
  if RefT > 0 then C = 11
  set sprite 0 to Y,ShipX,K,C
  if ShotOn = 1 then
    Y = ShotL - 8
    set sprite 1 to Y,ShotX,SShot,9
  else
    set sprite 1 to 192,0,0,0
  end if
  if BoomT > 0 then
    K = SBoom1
    if BoomT < 7 then K = SBoom2
    Y = BoomY - 6
    set sprite 2 to Y,BoomX,K,11
  else
    set sprite 2 to 192,0,0,0
  end if
  if TankT > 0 then
    Y = TankY - 1
    set sprite 3 to Y,200,STanker,7
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

' score (row 1), ammo and landed saucers (row 21); only what changed
sub ShowHud:
  if Score <> OldScore then
    OldScore = Score
    NumU = Score
    print at 8,1, digits$(NumU, 5)
    if Score > Hi then Hi = Score
    NumU = Hi
    print at 24,1, digits$(NumU, 5)
  end if
  if Ammo <> OldAmmo then
    OldAmmo = Ammo
    N = Ammo
    for Ki = 0 to 9
      K = TAmmo0
      if N >= 2 then
        K = TAmmo2
        N = N - 2
      elseif N = 1 then
        K = TAmmo1
        N = 0
      end if
      X = Ki + 7
      put char K at X,21
    next
  end if
  if Landed <> OldLanded then
    OldLanded = Landed
    for Ki = 0 to 4
      K = TSlot
      if Ki < Landed then K = TLnd
      X = Ki << 1
      X = X + 20
      put char K at X,21
    next
  end if
  return
end sub

sub EndMessage:
  mute all
  play sound SndOver
  for Ri = 8 to 14
    fill 32 count 24 at 4,Ri
  next
  print at 7,9, "FIVE SAUCERS LANDED"
  print at 11,11, "GAME OVER"
  print at 8,13, "YOUR SCORE"
  NumU = Score
  print at 19,13, digits$(NumU, 5)
  return
end sub

' the field: stars, the strip, the ground, the HUD
sub DrawField:
  for Ri = 2 to 18
    for Ki = 2 to 29
      K = BgAt(Ki, Ri)
      put char K at Ki,Ri
    next
  next
  fill TGnd count 32 at 0,20
  OldP = 999
  DrawStrip
  return
end sub

sub NewGame:
  NewScreen
  DrawField
  print at 2,1, "SCORE"
  print at 21,1, "HI"
  print at 2,21, "AMMO"
  print at 2,22, "LEVEL"
  NumU = Level
  print at 8,22, digits$(NumU, 1)
  print at 20,22, "LANDED"
  for Ai = 0 to 11
    Al[Ai].Live = 0
    Al[Ai].Mv = 0
  next
  Hf = 4 * Level
  Hf = 20 - Hf
  Nl = 13 - Level
  Si = SiTab[Level]
  SetTickP
  TickT = 0
  Sy = 74
  Face = 0
  FlipT = 0
  Ammo = 20
  Load = 20
  RefT = 0
  UsedPad = 255
  Landed = 0
  ShotOn = 0
  BoomT = 0
  TankT = 0
  Over = 0
  OverT = 0
  Score = 0
  Bo = 0
  Kills = 0
  BonusAt = 500
  StripP = 0
  OldP = 999
  OldScore = 999
  OldAmmo = 255
  OldLanded = 255
  TitleOn = 0
  DrawStrip
  ShowHud
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  AnimF = 0
  AnimT = 0
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: starfield, the SPACE PATROL logo, the ship; the tune once;
' START GAME / LEVEL / CREDITS
sub TitlePage:
  NewScreen
  for Ri = 1 to 22
    for Ki = 2 to 29
      K = BgAt(Ki, Ri)
      put char K at Ki,Ri
    next
  next
  DrawLogo
  print at 2,14, "COMPUTE!'S GAZETTE JULY 1984"
  print at 10,16, "START GAME"
  print at 10,17, "LEVEL"
  print at 10,18, "HOW TO PLAY"
  print at 10,19, "CREDITS"
  print at 3,22, "BEST"
  NumU = Hi
  print at 8,22, digits$(NumU, 5)
  Menu = 0
  ShowMenu
  TitleOn = 1
  set sprite 0 to 172,200,SShipl,15
  set sprite 1 to 192,0,0,0
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 530
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  Animate
  inc Rs
  ReadPad
  V = J1 | J2
  K = V & 15
  if K > 0 then
    if WasStick = 0 then TitleStick
  end if
  WasStick = K
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub TitleStick:
  C = K & 1
  if C > 0 then
    if Menu > 0 then dec Menu
  end if
  C = K & 2
  if C > 0 then
    if Menu < 3 then inc Menu
  end if
  if Menu = 1 then
    C = K & 4
    if C > 0 then
      if Level > 1 then dec Level
    end if
    C = K & 8
    if C > 0 then
      if Level < 5 then inc Level
    end if
  end if
  play sound SndTick
  ShowMenu
  return
end sub

sub ShowMenu:
  for J = 16 to 19
    put char 32 at 8,J
  next
  J = Menu + 16
  put char 62 at 8,J
  NumU = Level
  print at 17,17, "< ", digits$(NumU, 1), " >"
  return
end sub

' the logo: SPACE (19 blocks wide) at column 6, rows 2-6; PATROL (23 wide)
' at column 4, rows 8-12; LogoTab rows are LogoW (23) wide
sub DrawLogo:
  u8 Off = 0
  N = 0
  for Ri = 0 to 9
    Y = Ri + 2
    Off = 6
    if Ri >= 5 then
      Y = Ri + 3
      Off = 4
    end if
    for J = 0 to 22
      if LogoTab[N] = 1 then
        X = J + Off
        put char TBlk at X,Y
      end if
      inc N
    next
  next
  return
end sub

' a saucer (two tiles) at column X, row Y, for the HOW TO PLAY pages
sub HtSaucer:
  put char TAli0tl at X,Y
  K = X + 1
  put char TAli0tr at K,Y
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "FLYING SAUCERS DRIFT DOWN"
    print at 2,4, "TOWARD THE GROUND. SHOOT"
    print at 2,5, "THEM BEFORE THEY LAND!"
    print at 2,7, "IF 5 SAUCERS LAND, THE"
    print at 2,8, "GAME IS OVER."
    X = 8
    Y = 11
    HtSaucer
    X = 20
    Y = 13
    HtSaucer
    X = 12
    Y = 15
    HtSaucer
    set sprite 0 to 135,120,SShipl,15
    fill TGnd count 28 at 2,19
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK UP/DOWN: MOVE YOUR"
    print at 2,4, "SHIP UP AND DOWN."
    print at 2,5, "LEFT/RIGHT: TURN AND FLY"
    print at 2,6, "ALONG THE GROUND."
    print at 2,7, "BUTTON: FIRE A LASER ALONG"
    print at 2,8, "YOUR ROW."
    print at 2,10, "EACH SHOT USES A BOMB. OUT"
    print at 2,11, "OF BOMBS? LAND ON A PAD AT"
    print at 2,12, "THE BOTTOM: HOLD DOWN."
    set sprite 0 to 127,80,SShipr,15
    set sprite 1 to 127,120,SShot,9
    X = 20
    Y = 16
    HtSaucer
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "A SAUCER IS WORTH 3 POINTS"
    print at 2,4, "AT LEVEL 1, UP TO 23 AT"
    print at 2,5, "LEVEL 5."
    print at 2,6, "AT 500 POINTS, AND EVERY"
    print at 2,7, "300 MORE, ONE LANDED SAUCER"
    print at 2,8, "IS TAKEN AWAY."
    print at 2,10, "CHOOSE LEVEL 1-5 ON THE"
    print at 2,11, "TITLE. HIGHER IS FASTER."
    print at 2,13, "TIP: WATCH THE LOW SAUCERS"
    print at 2,14, "FIRST, AND LOAD BOMBS"
    print at 2,15, "BEFORE YOU RUN OUT."
    set sprite 2 to 151,120,SBoom1,11
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,2, "SPACE PATROL"
  print at 2,4, "BASED ON SPACE PATROL,"
  print at 2,5, "COMPUTE!'S GAZETTE JULY"
  print at 2,6, "1984 (COMMODORE 64 AND"
  print at 2,7, "VIC-20)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "MUSIC: PAD WATCH"
  print at 2,16, "(ORIGINAL)"
  print at 2,18, "STICK MOVES, BUTTON FIRES"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

