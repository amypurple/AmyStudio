cartridge "STARKITE/J.C. HILTY/1985"

' STARKITE
' A ColecoVision game based on "Superhero" by J.C. Hilty, Ahoy! September
' 1985 (Commodore 64, BASIC with a small machine-language joystick reader).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu. The hero, Starkite, is an original character.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/superhero.bas), the game is built for the ColecoVision:
' smooth sprites gliding from square to square, tiled rock and space
' scenery, a sky panel where the shuttle climbs, sound and a title tune.
'
' The game: the space shuttle is climbing and only Starkite can save it,
' but first she must gather the ten power orbs scattered through a maze of
' rock. A zyptonite meteor rolls through the maze, always keeping a wall on
' its left; if it rolls onto her square she is crushed. Each orb is 10
' points; all ten score 100, bring the shuttle 200 miles back down, and a
' new maze is built. When the shuttle reaches 800 miles it is too late.
'
' From the original (orig/superhero.bas): the maze built by the listing's
' own walk (a random direction, two squares at a time, the way back marked
' in the squares, here in the name table as on the C64 screen), ten orbs
' on fixed cells (the listing's ten positions scaled to this maze), the
' hero's start in the top right corner and the meteor's in the top left,
' the hero moving one square in eight directions into open squares, the
' meteor's wall-following rule (one try a step: after a move it turns left,
' after a blocked try it turns right) and the crush when its next square
' is the hero's, 10 points an orb, 100 and 200 miles off for all ten, the
' altitude rising one mile per hero step time to 800, the two endings and
' their messages.
'
' Liberties: the maze is 10 x 10 cells (the C64's was about 19 x 11 around
' a panel strip); the panel with the hero and shuttle is now a sky at the
' right where the shuttle climbs with the altitude. Moves glide over 8
' frames; a mile is 8 frames (one hero step), as on the C64 where both
' counted one BASIC pass. The meteor takes 10 frames a try in maze 1, a
' frame less each maze down to 7 (on the C64 it was as fast as the hero;
' slower at first so a human can react). The hero can't step onto the
' meteor's squares (on the C64 the move was ignored the same way). The
' altitude doesn't go below 0. A high score. The flashing sprites of the
' endings are a grey hero / a shuttle flying off.
'
' Controls: either controller; the stick moves Starkite (diagonals too;
' hold to keep moving). On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given (bug
' 25). Own xorshift random numbers (bug 36). Nothing flashes.

const TWall = 128
const TWallf = 129
const TFlr0 = 130
const TFlr1 = 131
const TOrb = 132
const TBar = 133
const TSp0 = 134
const TSp1 = 135
const TSky0 = 136
const TSky1 = 137
const TSky2 = 138
const THill = 139
const TGrnd = 140
const TPad = 141
const TB0 = 142
const TB1 = 143
const TB2 = 144
const TB3 = 145
const TB4 = 146
const SHero = 0
const SCape0 = 4
const SCape1 = 8
const SMet0 = 12
const SMet1 = 16
const SShut = 20
const SFlm0 = 24
const SFlm1 = 28
const SBigstar = 32
const SBighero = 36
const SBigcape = 40
const NTiles8 = 152
const SprBytes = 352
const SndTuneA = 1
const SndTuneB = 2
const SndOrb = 3
const SndCrush = 4
const SndLate = 5
const SndRound = 6
const SndStart = 7
const SndBump = 8
const HeroN = 8
const AltN = 8
const AltMax = 800
const MetN0 = 10
const MetMin = 7
const NSpr = 5
const BannerN = 150
const DeadN = 60

' directions as in the listing: 0 right, 1 up, 2 left, 3 down
data DxT bytes
  1, 0, 255, 0
end data
data DyT bytes
  0, 255, 0, 1
end data
' the ten orbs (squares; cells are the odd squares 1..19)
data OrbX bytes
  5, 13, 17, 1, 7, 13, 17, 3, 9, 11
end data
data OrbY bytes
  1, 1, 1, 19, 19, 19, 19, 11, 13, 13
end data

record Mover:
  u8 X
  u8 Y
  u8 Px
  u8 Py
  u8 T
  u8 D
  u8 M
end record

Mover Hero
Mover Met

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 5 Score = 0
bcd digits 5 Hi = 0
i16 Alt = 0
u8 AltT = 0
u8 Orbs = 10
u8 Rnd = 1
u8 MetN = MetN0
u8 Over = 0
u8 Won = 0
u8 DeadT = 0
u8 TitleOn = 0
u8 Hdx = 0
u8 Hdy = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' the maze builder: current square, the walk's direction, its first try
u8 Ax = 0
u8 Ay = 0
u8 Gj = 0
u8 Gx0 = 0
u8 Done = 0
u8 Carved = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Oi = 0
' scratch
u8 B = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tx = 0
u8 Ty = 0

  tile screen
  set sound table SkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  EndGame
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if Won = 1 then
    RoundWon
    return
  end if
  MetStep
  if Over > 0 then return
  HeroStep
  AltStep
  return
end sub

' the hero: a new step when the last one is done, then a pixel of glide
sub HeroStep:
  if Hero.T = 0 then TryHero
  if Hero.T > 0 then
    Hero.Px = Hero.Px + Hdx
    Hero.Py = Hero.Py + Hdy
    dec Hero.T
  end if
  return
end sub

' the stick: eight directions, into open squares that the meteor isn't on
sub TryHero:
  K = J1 | J2
  Hdx = 0
  Hdy = 0
  V = K & 1
  if V > 0 then Hdy = 255
  V = K & 2
  if V > 0 then Hdy = 1
  V = K & 4
  if V > 0 then Hdx = 255
  V = K & 8
  if V > 0 then Hdx = 1
  V = Hdx | Hdy
  if V = 0 then return
  Tx = Hero.X + Hdx
  Ty = Hero.Y + Hdy
  T = TileAt(Tx, Ty)
  if IsOpen(T) = 0 then return
  if OnMeteor(Tx, Ty) = 1 then return
  Hero.X = Tx
  Hero.Y = Ty
  Hero.T = HeroN
  if T = TOrb then
    V = Tx + 2
    C = Ty + 2
    put char TFlr0 at V,C
    Score += 10
    ShowScore
    dec Orbs
    play sound SndOrb
    if Orbs = 0 then Won = 1
  end if
  return
end sub

' 1 when the square is the meteor's (or the one it is leaving)
function OnMeteor(u8 Qx, u8 Qy) as u8
  u8 R = 0
  u8 Fx = 0
  u8 Fy = 0
  if Qx = Met.X then
    if Qy = Met.Y then R = 1
  end if
  if Met.T > 0 then
    if Met.M < 4 then
      Fx = Met.X - DxT[Met.M]
      Fy = Met.Y - DyT[Met.M]
      if Qx = Fx then
        if Qy = Fy then R = 1
      end if
    end if
  end if
  return R

' 1 when the square is the hero's (or the one she is leaving)
function OnHero(u8 Qx, u8 Qy) as u8
  u8 R = 0
  u8 Fx = 0
  u8 Fy = 0
  if Qx = Hero.X then
    if Qy = Hero.Y then R = 1
  end if
  if Hero.T > 0 then
    Fx = Hero.X - Hdx
    Fy = Hero.Y - Hdy
    if Qx = Fx then
      if Qy = Fy then R = 1
    end if
  end if
  return R

function TileAt(u8 Gx, u8 Gy) as u8
  u8 Cx = Gx + 2
  u8 Cy = Gy + 2
  u8 R = 0
  R = get char at Cx,Cy
  return R

function IsOpen(u8 Tt) as u8
  u8 R = 1
  select case Tt
  case TWall, TWallf
    R = 0
  case 0 to 31
    R = 0
  end select
  return R

' the meteor: one try every MetN frames; after a move it turns left, after
' a blocked try it turns right (the listing's J+2-1 and J-1)
sub MetStep:
  if Met.T > 0 then dec Met.T
  if Met.T = 0 then MetTry
  MetPixels
  return
end sub

sub MetTry:
  J = Met.D
  Tx = Met.X + DxT[J]
  Ty = Met.Y + DyT[J]
  T = TileAt(Tx, Ty)
  Met.T = MetN
  if IsOpen(T) = 1 then
    if OnHero(Tx, Ty) = 1 then
      Over = 1
      DeadT = DeadN
      play sound SndCrush
      return
    end if
    Met.X = Tx
    Met.Y = Ty
    Met.M = J
    V = J + 1
    Met.D = V & 3
  else
    Met.M = 4
    V = J + 3
    Met.D = V & 3
  end if
  return
end sub

' the meteor's sprite corner: its square, less what is left of the glide
sub MetPixels:
  u8 Off = 0
  u8 Bx = 0
  u8 By = 0
  Bx = Met.X + 2
  Bx = Bx << 3
  By = Met.Y + 2
  By = By << 3
  if Met.M < 4 then
    Off = Met.T << 3
    Off = Off / MetN
  end if
  select case Met.M
  case 0
    Bx = Bx - Off
  case 1
    By = By + Off
  case 2
    Bx = Bx + Off
  case 3
    By = By - Off
  end select
  Met.Px = Bx
  Met.Py = By
  return
end sub

' the altitude: a mile every AltN frames
sub AltStep:
  inc AltT
  if AltT < AltN then return
  AltT = 0
  Alt = Alt + 1
  ShowAlt
  if Alt >= AltMax then
    Over = 2
    DeadT = DeadN
    play sound SndLate
  end if
  return
end sub

' all ten orbs: CONGRATULATIONS, 100 points, the shuttle 200 miles down,
' a new maze and a faster meteor
sub RoundWon:
  Won = 0
  Score += 100
  Alt = Alt - 200
  if Alt < 0 then Alt = 0
  inc Rnd
  if MetN > MetMin then dec MetN
  ShowHud
  HideSprites
  DrawShuttle
  update sprites
  print at 5,10, "                  "
  print at 5,11, " CONGRATULATIONS! "
  print at 5,12, "                  "
  print at 5,13, "     PLAY ON!     "
  print at 5,14, "                  "
  play sound SndRound
  Rearm
  wait BannerN frames
  nmi off
  NewRound
  return
end sub

sub EndGame:
  for Ci = 1 to DeadN
    Frame1
    if Over = 2 then
      ' the shuttle flies off the top
      if Alt < 900 then Alt = Alt + 3
    end if
    DrawSprites
  next
  if Over = 2 then Alt = AltMax
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  if Over = 1 then
    print at 3,9, "                    "
    print at 3,10, " SORRY, A ZYPTONITE "
    print at 3,11, " METEOR CRUSHED YOU."
    print at 3,12, "                    "
  else
    print at 3,9, "                    "
    print at 3,10, " THE SHUTTLE IS 800 "
    print at 3,11, " MILES UP--TOO LATE."
    print at 3,12, "                    "
  end if
  print at 3,13, "    SCORE           "
  print at 13,13, Score
  print at 3,14, "                    "
  return
end sub

' ---------------------------------------------------------------------------
' the maze: the listing's walk, carved into the name table

' fill the maze area with rock, walk from the top left cell
sub MakeMaze:
  for Ri = 2 to 22
    fill TWall count 21 at 2,Ri
  next
  Ax = 1
  Ay = 1
  put char 4 at 3,3
  Done = 0
  while Done = 0
    Rand
    V = Rs & 3
    Gj = V
    Gx0 = V
    Carved = 0
    while Carved = 0
      Carved = TryCarve(Gj)
      if Carved = 0 then
        V = Gj + 1
        Gj = V & 3
        if Gj = Gx0 then Carved = 2
      end if
    end while
    if Carved = 2 then BackUp
  end while
  Dress
  return
end sub

' carve two squares in direction D when they lead to untouched rock:
' the new cell keeps the direction it was reached by (the way back)
function TryCarve(u8 D) as u8
  u8 R = 0
  u8 Bx = 0
  u8 By = 0
  u8 Mx = 0
  u8 My = 0
  u8 Dx2 = 0
  u8 Dy2 = 0
  Dx2 = DxT[D] << 1
  Dy2 = DyT[D] << 1
  Bx = Ax + Dx2
  By = Ay + Dy2
  if Bx <= 19 then
    if By <= 19 then
      if TileAt(Bx, By) = TWall then
        Mx = Ax + DxT[D]
        My = Ay + DyT[D]
        Bx = Bx + 2
        By = By + 2
        put char D at Bx,By
        Mx = Mx + 2
        My = My + 2
        put char TFlr0 at Mx,My
        Ax = Ax + Dx2
        Ay = Ay + Dy2
        R = 1
      end if
    end if
  end if
  return R

' no way on: open this cell and step back the way it was reached
sub BackUp:
  B = TileAt(Ax, Ay)
  X = Ax + 2
  Y = Ay + 2
  put char TFlr0 at X,Y
  if B < 4 then
    V = DxT[B] << 1
    Ax = Ax - V
    V = DyT[B] << 1
    Ay = Ay - V
  else
    Done = 1
  end if
  return
end sub

' the finished maze: walls with a lit face over open squares, a few stars,
' the ten orbs
sub Dress:
  for Ri = 0 to 20
    DressRow(Ri)
  next
  for Oi = 0 to 9
    X = OrbX[Oi] + 2
    Y = OrbY[Oi] + 2
    put char TOrb at X,Y
  next
  return
end sub

sub DressRow(u8 Gy)
  u8 Gx = 0
  u8 Tt = 0
  u8 Below = 0
  u8 Cy = Gy + 2
  u8 Cx = 0
  for Gx = 0 to 20
    Cx = Gx + 2
    Tt = get char at Cx,Cy
    if Tt = TWall then
      if Gy < 20 then
        Below = TileAt(Gx, Gy + 1)
        if Below = TFlr0 then put char TWallf at Cx,Cy
      end if
    else
      Rand
      V = Rs & 15
      if V = 0 then put char TFlr1 at Cx,Cy
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' sprites: 0 suit, 1 cape, 2 meteor, 3 shuttle, 4 flame
sub DrawSprites:
  Y = Hero.Py - 1
  X = Hero.Px
  if Over = 1 then
    set sprite 0 to Y,X,SHero,14
    set sprite 1 to Y,X,SCape0,14
  else
    V = Tick >> 3
    V = V & 1
    K = SCape0
    if V = 1 then K = SCape1
    set sprite 0 to Y,X,SHero,7
    set sprite 1 to Y,X,K,13
  end if
  Y = Met.Py - 1
  V = Tick >> 4
  V = V & 1
  K = SMet0
  if V = 1 then K = SMet1
  set sprite 2 to Y,Met.Px,K,3
  DrawShuttle
  update sprites
  return
end sub

' the shuttle in the sky panel: 0 miles on the pad, 800 at the top
sub DrawShuttle:
  W16 = 0
  if Alt > 0 then W16 = Alt
  W16 = W16 * 17
  W16 = W16 / 100
  Y = 0
  if W16 < 137 then
    V = W16
    Y = 151 - V
  end if
  if Y = 0 then
    set sprite 3 to 192,0,0,0
    set sprite 4 to 192,0,0,0
    return
  end if
  set sprite 3 to Y,208,SShut,15
  if Alt > 0 then
    V = Tick / 10
    V = V & 1
    K = SFlm0
    if V = 1 then K = SFlm1
    set sprite 4 to Y,208,K,10
  else
    set sprite 4 to 192,0,0,0
  end if
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 14,1, "ALT"
  print at 22,1, "HI"
  ShowScore
  print at 25,1, Hi
  ShowAlt
  return
end sub

sub ShowScore:
  print at 8,1, Score
  return
end sub

sub ShowAlt:
  NumU = 0
  if Alt > 0 then NumU = Alt
  print at 18,1, digits$(NumU, 3)
  return
end sub

' the sky panel: space, sky, the launch pad
sub DrawPanel:
  for Ri = 2 to 22
    put char TBar at 23,Ri
    T = TSky2
    if Ri < 14 then T = TSky1
    if Ri < 13 then T = TSky0
    if Ri < 10 then T = TSp0
    if Ri = 20 then T = THill
    if Ri > 20 then T = TGrnd
    fill T count 6 at 24,Ri
    if Ri < 10 then
      V = Ri & 1
      if V = 1 then
        put char TSp1 at 25,Ri
        put char TSp1 at 28,Ri
      else
        put char TSp1 at 26,Ri
      end if
    end if
  next
  fill TPad count 4 at 25,21
  return
end sub

sub NewRound:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  MakeMaze
  Orbs = 10
  Won = 0
  Hero.X = 19
  Hero.Y = 1
  Hero.Px = 168
  Hero.Py = 24
  Hero.T = 0
  Hdx = 0
  Hdy = 0
  Met.X = 1
  Met.Y = 1
  Met.Px = 24
  Met.Py = 24
  Met.T = MetN
  Met.D = 2
  Met.M = 4
  AltT = 0
  DrawSprites
  ShowScreen
  return
end sub

sub NewGame:
  Score = 0
  Alt = 0
  Rnd = 1
  MetN = MetN0
  Over = 0
  DeadT = 0
  TitleOn = 0
  NewScreen
  DrawPanel
  ShowHud
  NewRound
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: big letters, the graphics chart of the original, the tune
' once, START GAME / CREDITS
sub TitlePage:
  NewScreen
  for Ri = 0 to 9
    TitleRow(Ri)
  next
  print at 4,14, "SAVE THE SPACE SHUTTLE!"
  put char TOrb at 8,16
  print at 11,16, "POWER ORB  10"
  print at 11,18, "ZYPTONITE METEOR"
  print at 12,20, "START GAME"
  print at 12,21, "CREDITS"
  print at 2,1, "HI"
  print at 5,1, Hi
  print at 15,1, "AHOY! SEP 1985"
  ShowMenu
  ' the chart's sprites: the hero, the meteor, the shuttle
  set sprite 0 to 135,224,SBigstar,11
  set sprite 1 to 135,224,SBighero,7
  set sprite 2 to 135,224,SBigcape,13
  set sprite 3 to 143,64,SMet0,3
  set sprite 4 to 135,24,SShut,15
  update sprites
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub TitleRow(u8 Tr)
  u8 Tc = 0
  u8 Tt = 0
  u8 Sr = Tr + 2
  u16 Ix = 0
  if Tr >= 5 then Sr = Tr + 3
  for Tc = 0 to 22
    Ix = Tr * 23
    Ix = Ix + Tc
    Tt = TitleMap[Ix]
    if Tt > 0 then put char Tt at Tc + 4,Sr
  next
  return
end sub

sub ShowMenu:
  put char 32 at 10,20
  put char 32 at 10,21
  J = Menu + 20
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "STARKITE"
  print at 2,5, "BASED ON SUPERHERO"
  print at 2,6, "BY J.C. HILTY, AHOY!"
  print at 2,7, "SEPTEMBER 1985 (COMMODORE"
  print at 2,8, "64). STARKITE IS AN"
  print at 2,9, "ORIGINAL HERO."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: STARKITE RISING"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

