const TBack12 = 186
const TBack13 = 187
const TBack20 = 188
const TBack21 = 189
const TBack22 = 190
const TBack23 = 191
const TFelt = 192
const TDot = 193
const THc0 = 194
const THc1 = 195
const THc2 = 196
const THc3 = 197
const THc4 = 198
const THp0 = 199
const THp1 = 200
const THp2 = 201
const THp3 = 202
const THp4 = 203
const TWood = 204
const SArrow = 0
const SPeg = 4
const NTiles8 = 616
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndMove = 3
const SndCard = 4
const SndShuffle = 5
const SndPeg = 6
const SndScore = 7
const SndGo = 8
const SndNo = 9
const SndHint = 10
