const NoCard = 255
const PegRowC = 1
const PegRowP = 3

record Side:
  u8 Hand
  u8 Crib
  u8 Peg
  u8 Score
  u8 Won
  bcd digits 4 Match
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 N16 = 0
u16 NumU = 0
u16 Acc = 0
u16 BestAcc = 0
u16 Prod = 0
Side Sd[2]
' the deal: computer six (Dk 0-5), your six (6-11), the starter (12)
u8 Dk[52]
u8 Pl6[6]
u8 Av[6]
u8 Cn[5]
u8 Pn[5]
u8 Cb[4]
u8 Hc4[4]
u8 Cnr[5]
u8 Pnr[5]
' the play, slots 1-8 as in the listing (0 and 9 kept zero)
u8 Np[10]
u8 Plv[10]
