u8 Ai = 0
u8 Wi = 0
u8 Ad = 0
u8 Gi = 0
u8 Hi = 0
u8 Li = 0
u8 Di = 0
u8 Dj = 0
u8 Qi = 0
u8 Qj = 0
u8 Si = 0
u8 Ti = 0
u8 Ei = 0
' scratch
u8 A8 = 0
u8 B8 = 0
u8 C = 0
u8 J = 0
