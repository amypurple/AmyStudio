' Arithmetic inputs.
u16 U16Value = 60000
i16 I16Value = -100
fixed FxValue = 1.5
' Result flags.
u8 U16Pass = 0, I16Pass = 0, FxAddPass = 0, FxSubPass = 0

' Amy Arithmetic Mix Demo
  text screen
  run_demo
  screen on

sub run_demo:
  print at 7,0, "ARITHMETIC MIX"
  print at 1,4, "u16 60000 - 5"
  U16Value -= 5
  print U16Value at 18,4 digits 5
  if U16Value = 59995 then
    U16Pass = 1
  end if

  print at 1,7, "i16 -100 - 25"
  I16Value -= 25
  print I16Value at 18,7 digits 6
  if I16Value = -125 then
    I16Pass = 1
  end if

  print at 1,10, "fx 1.50 + 2.25"
  FxValue += 2.25
  print FxValue at 18,10
  if FxValue = raw $03C0 then
    FxAddPass = 1
  end if

  print at 1,13, "fx 3.75 - 0.50"
  FxValue -= 0.5
  print FxValue at 18,13
  if FxValue = raw $0340 then
    FxSubPass = 1
  end if

  if U16Pass then
    print at 25,4, "PASS"
  else
    print at 25,4, "FAIL"
  end if
  if I16Pass then
    print at 25,7, "PASS"
  else
    print at 25,7, "FAIL"
  end if
  if FxAddPass then
    print at 25,10, "PASS"
  else
    print at 25,10, "FAIL"
  end if
  if FxSubPass then
    print at 25,13, "PASS"
  else
    print at 25,13, "FAIL"
  end if
  return