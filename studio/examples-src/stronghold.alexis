' STRONGHOLD OF THE DWARVEN LORDS
' From Tim Hartnell's Giant Book of Computer Games (Ballantine Books,
' 1984; Interface Publications, 1983), for the ColecoVision in Amy by
' Amy Bienvenu, as the first-person 3D maze the book suggests.
'
' Deep in a 15 x 15 cavern lies the Dwarven gold, in one of three places
' (the north-east, north-west or south-east corner). You start in the
' south-west. The only clue is the Dwarven Source Beam: after each step
' it reads 100 times the north-south distance to the gold plus 10 times
' the east-west distance. Find the gold in as few steps as you can. The
' map shows the cavern and where you are (never the gold); you see it
' once for free at the start, and every later look costs 15 steps.
'
' The cavern is as in the book: its fixed passages (the DATA lines) plus
' a fifth of the other squares opened at random; the gold's place is
' chosen at random.
'
' Controls (either joystick): up steps forward, down steps back, left
' and right turn. Either button looks at the map (15 steps). Keypad not
' used.
'
' Liberties taken:
' - The book's text display ("NORTH: WALL" and so on) became the 3D view
'   it proposes, with the four directions still listed beside it; you
'   face a direction, so turning is new (and free, as moves in the book
'   were by compass direction).
' - The book's DATA has 69 squares for 68 READs (the last, the north-east
'   gold, was never read); all 69 are opened here so the gold can always
'   be reached.
' - The gold shows up in the view when it is straight ahead; the end
'   map shows where it was. The best (lowest) number of steps is kept.
' - New music (Under the Mountain) and sound effects.
'
' House rules kept: columns 2-29, rows 1-22; two sprites (the gold pile);
' the frame loop is protected from the NMI and every screen is drawn with
' the NMI off after a wait.

const TFace0 = 128
const TFace1 = 129
const TFace2 = 130
const TFace3 = 131
const TFace4 = 132
const TFace5 = 133
const TLt0 = 134
const TLb0 = 135
const TRt0 = 136
const TRb0 = 137
const TLt1 = 138
const TLb1 = 139
const TRt1 = 140
const TRb1 = 141
const TLt2 = 142
const TLb2 = 143
const TRt2 = 144
const TRb2 = 145
const TLt3 = 146
const TLb3 = 147
const TRt3 = 148
const TRb3 = 149
const TLt4 = 150
const TLb4 = 151
const TRt4 = 152
const TRb4 = 153
const TCeil = 154
const TFloor = 155
const TRock = 156
const TOpen = 157
const TYouN = 158
const TYouE = 159
const TYouS = 160
const TYouW = 161
const TGold = 162
const SShine = 0
const SPile = 4
const NTiles8 = 280
const SprBytes = 64
const SndSteps = 1
const SndTurn = 2
const SndBump = 3
const SndMap = 4
const SndWin = 5
const SndTuneA = 6
const SndTuneB = 7

' the cavern: Cave[row * 16 + column], rows 1-15 from south to north,
' columns 1-15 from west to east; 1 rock, 0 open
u8 Cave[256]
u8 Lw[6]
u8 Rw[6]
u8 Buf[18]
u8 CTop[18]
u8 CBot[18]
u8 CT1[18]
u8 CT2[18]
u8 CTm[18]
u16 Dst = 0
u16 Steps = 0
u16 Best = 0
u16 Beam = 0
u16 NumU = 0
u16 Rs = $ACE1
u16 Rt = 0
u8 Rb = 0
u8 Pos = 34
u8 Fac = 1
u8 Gp = 0
u8 Fo = 0
u8 Lo = 0
u8 Ro = 0
u8 Fd = 0
u8 Gd = 0
u8 P = 0
u8 N = 0
u8 D = 0
u8 U = 0
u8 Hh = 0
u8 Sh = 0
u8 Top = 0
u8 Bot = 0
u8 T1 = 0
u8 T2 = 0
u8 Tm = 0
u8 Col = 0
u8 Row = 0
u8 Menu = 0
u8 Mode = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DwSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if
  NewCave
  Steps = 0
  ' the first look at the map is free
  MapPage
  Message
  print at 2,21, "THE FIRST LOOK IS FREE."
  print at 2,22, "PRESS A BUTTON"
  WaitPress
  ViewScreen
  Mode = 1

walk:
  Frame1
  ReadPad
  if Press = 1 then
    Steps = Steps + 15
    Mode = 0
    play sound SndMap
    MapPage
    Message
    print at 2,21, "THAT LOOK COST 15 STEPS."
    print at 2,22, "PRESS A BUTTON"
    WaitPress
    ViewScreen
    Mode = 1
    goto walk
  end if
  if Stick = 0 then goto walk
  if Lf1 = 1 then
    Fac = Fac + 3
    Fac = Fac & 3
    play sound SndTurn
    Render
    goto walk
  end if
  if Rt1 = 1 then
    inc Fac
    Fac = Fac & 3
    play sound SndTurn
    Render
    goto walk
  end if
  Offsets
  N = Pos + Fo
  if Dn1 = 1 then N = Pos - Fo
  if Up1 = 0 then
    if Dn1 = 0 then goto walk
  end if
  if Cave[N] = 1 then
    play sound SndBump
    print at 2,21, "SOLID ROCK."
    goto walk
  end if
  Pos = N
  Message
  inc Steps
  play sound SndSteps
  Render
  if Pos <> Gp then goto walk

  ' found
  Mode = 2
  play sound SndWin
  Pause
  Pause
  MapPage
  ' the gold on the map
  Y = Gp >> 4
  X = Gp & 15
  X = X + 7
  Y = 19 - Y
  put char TGold at X,Y
  Message
  print at 2,20, "YOU FOUND THE DWARVEN RICHES"
  print at 2,21, "IN JUST"
  NumU = Steps
  X = 10
  if Steps < 10 then
    print at 10,21, digits$(NumU, 1)
    X = 12
  end if
  if Steps >= 10 then
    if Steps < 100 then
      print at 10,21, digits$(NumU, 2)
      X = 13
    end if
  end if
  if Steps >= 100 then
    if Steps < 1000 then
      print at 10,21, digits$(NumU, 3)
      X = 14
    end if
  end if
  if Steps >= 1000 then
    print at 10,21, digits$(NumU, 4)
    X = 15
  end if
  print at X,21, "STEPS!"
  V = 0
  if Best = 0 then V = 1
  if Steps < Best then V = 1
  if V = 1 then
    Best = Steps
    print at 2,22, "THE BEST SO FAR!"
  else
    print at 2,22, "BEST SO FAR:"
    NumU = Best
    print at 15,22, digits$(NumU, 4)
  end if
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  Mode = 0
  goto title

' ---------------------------------------------------------------------------
' The cavern

' the book's fixed passages (row, column)
data Passages bytes
  2,2, 2,3, 2,4, 2,5, 2,6, 2,7
  3,7, 4,7, 5,7, 5,6, 5,5, 5,4, 5,3, 6,3
  7,3, 7,4, 7,5, 7,6, 7,7, 7,8, 7,9, 9,8
  9,9, 10,8, 10,7, 10,6, 10,5, 10,4, 8,8
  10,3, 11,3, 12,3, 13,3, 14,3, 14,2, 7,10
  6,10, 5,10, 4,10, 3,10, 2,10, 2,11, 2,12
  2,13, 2,14, 6,11, 6,12, 6,13, 6,14, 7,12
  14,12, 8,12, 8,14, 9,12, 9,13, 9,14, 10,12
  11,9, 11,10, 11,11, 11,12, 12,9, 13,9, 13,10
  13,11, 13,12, 13,13, 13,14, 14,14

' steps for each facing: north, east, south, west
data FwdTab bytes 16, 1, 240, 255
' half sizes of the view at each distance
data Half bytes 9, 6, 4, 3, 2, 1, 0

sub NewCave:
  fill array Cave with 1
  for I = 2 to 14
    for J = 2 to 14
      Rnd
      if Rb < 51 then
        K = I << 4
        K = K + J
        Cave[K] = 0
      end if
    next
  next
  for I = 0 to 68
    J = I + I
    V = Passages[J]
    inc J
    W = Passages[J]
    K = V << 4
    K = K + W
    Cave[K] = 0
  next
  ' the gold, as the book: row 14 column 14, or column 2, or row 2
  Rnd
  NumU = Rb
  NumU = NumU * 3
  NumU = NumU >> 8
  V = NumU + 1
  Gp = 14 * 16
  Gp = Gp + 14
  if V = 2 then Gp = Gp - 12
  if V = 3 then Gp = Gp - 192
  Cave[Gp] = 0
  Pos = 34
  Fac = 1
  return
end sub

' Rnd: Rb = a random byte (16-bit xorshift; Amy's random(A, B) repeats
' in short cycles when called in a tight loop)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Offsets:
  Fo = FwdTab[Fac]
  V = Fac + 3
  V = V & 3
  Lo = FwdTab[V]
  V = Fac + 1
  V = V & 3
  Ro = FwdTab[V]
  return
end sub

' ---------------------------------------------------------------------------
' The 3D view: 18 x 18 tiles, columns 2-19, rows 2-19

sub Render:
  Offsets
  Fd = 5
  Gd = 255
  P = Pos
  D = 0
rd_slice:
  V = P + Lo
  Lw[D] = Cave[V]
  V = P + Ro
  Rw[D] = Cave[V]
  N = P + Fo
  if Cave[N] = 1 then
    Fd = D
    goto rd_cols
  end if
  if N = Gp then Gd = D + 1
  P = N
  inc D
  if D < 5 then goto rd_slice
rd_cols:
  for Col = 0 to 17
    ' distance from the middle, and which side
    if Col < 9 then
      U = 9 - Col
    else
      U = Col - 8
    end if
    D = 0
rd_find:
    V = D + 1
    Hh = Half[V]
    if U > Hh then
      ' beside us at this distance: a side wall, or the far wall of a side way
      V = Lw[D]
      if Col >= 9 then V = Rw[D]
      if V = 1 then
        Top = 9 - U
        Bot = 8 + U
        W = D * 4
        W = W + TLt0
        T1 = W
        T2 = W + 1
        if Col >= 9 then
          T1 = W + 2
          T2 = W + 3
        end if
        Tm = TFace0 + D
        goto rd_draw
      end if
      Sh = D + 1
      goto rd_face
    end if
    if Fd = D then
      Sh = D + 1
      goto rd_face
    end if
    inc D
    if D < 5 then goto rd_find
    ' the dark beyond
    Top = 9
    Bot = 8
    goto rd_draw
rd_face:
    Top = 9 - Hh
    Bot = 8 + Hh
    T1 = TFace0 + Sh
    T2 = T1
    Tm = T1
rd_draw:
    ColumnFill
  next
  ' show it, a row at a time
  Dst = 66
  for Row = 0 to 17
    for Col = 0 to 17
      if Row < CTop[Col] then
        V = TCeil
      else
        if Row > CBot[Col] then
          V = TFloor
        else
          V = CTm[Col]
          if Row = CTop[Col] then V = CT1[Col]
          if Row = CBot[Col] then V = CT2[Col]
        end if
      end if
      Buf[Col] = V
    next
    copy Buf count 18 to vram.name + Dst
    Dst = Dst + 32
  next
  GoldSprite
  ShowPanel
  return
end sub

sub ColumnFill:
  CTop[Col] = Top
  CBot[Col] = Bot
  CT1[Col] = T1
  CT2[Col] = T2
  CTm[Col] = Tm
  return
end sub

' the gold pile, when it lies straight ahead
sub GoldSprite:
  if Gd > 4 then
    HideSprites
    return
  end if
  V = Half[Gd]
  W = Gd + 1
  W = Half[W]
  V = V + W
  V = V * 4
  Y = V + 88
  if Gd = 1 then
    sprites double
    Y = Y - 32
    X = 72
  else
    sprites simple
    Y = Y - 16
    X = 80
  end if
  W = 11
  if Gd >= 3 then W = 10
  set sprite 0 to Y, X, SShine, 15
  set sprite 1 to Y, X, SPile, W
  update sprites
  return
end sub

sub ShowPanel:
  print at 21,2, "STEP"
  NumU = Steps
  print at 21,3, digits$(NumU, 4)
  print at 21,5, "FACING"
  if Fac = 0 then print at 21,6, "NORTH"
  if Fac = 1 then print at 21,6, "EAST "
  if Fac = 2 then print at 21,6, "SOUTH"
  if Fac = 3 then print at 21,6, "WEST "
  print at 21,8, "N"
  V = Pos + 16
  K = 8
  ShowWay
  print at 21,9, "S"
  V = Pos - 16
  K = 9
  ShowWay
  print at 21,10, "E"
  V = Pos + 1
  K = 10
  ShowWay
  print at 21,11, "W"
  V = Pos - 1
  K = 11
  ShowWay
  print at 21,13, "SOURCE"
  print at 21,14, "BEAM"
  ' 100 times the north-south distance plus 10 times the east-west one
  V = Gp >> 4
  W = Pos >> 4
  if V > W then
    V = V - W
  else
    V = W - V
  end if
  Beam = V
  Beam = Beam * 100
  V = Gp & 15
  W = Pos & 15
  if V > W then
    V = V - W
  else
    V = W - V
  end if
  NumU = V
  NumU = NumU * 10
  Beam = Beam + NumU
  NumU = Beam
  print at 21,15, digits$(NumU, 4)
  print at 21,18, "BUTTON:"
  print at 21,19, "MAP +15"
  return
end sub

sub ShowWay:
  if Cave[V] = 1 then
    print at 23,K, "WALL"
  else
    print at 23,K, "OPEN"
  end if
  return
end sub

sub ViewScreen:
  NewScreen
  Message
  ShowScreen
  Render
  return
end sub

' the map from above: north at the top
sub MapPage:
  NewScreen
  print at 13,2, "NORTH"
  print at 13,20, "SOUTH"
  for I = 1 to 15
    Y = 19 - I
    for J = 1 to 15
      X = J + 7
      K = I << 4
      K = K + J
      W = TRock
      if Cave[K] = 0 then W = TOpen
      if K = Pos then W = TYouN + Fac
      put char W at X,Y
    next
  next
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 40
    Frame1
  next
  return
end sub

sub WaitPress:
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 14
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 9
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  sprites stable 0 to 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub Message:
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  ' a cavern to look into behind the title
  NewCave
  Fac = 1
  Steps = 0
  NewScreen
  Render
  HideSprites
  ' the panel is the title's here
  for I = 2 to 19
    fill 32 count 10 at 20,I
  next
  print at 20,3, "STRONGHOLD"
  print at 23,5, "OF THE"
  print at 21,7, "DWARVEN"
  print at 22,8, "LORDS"
  print at 22,12, "PLAY"
  print at 22,13, "RULES"
  print at 22,14, "CREDITS"
  print at 2,21, "FROM TIM HARTNELL'S GIANT"
  print at 2,22, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ' the moment you start decides the cavern
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTurn
  end if
  print at 21,12, " "
  print at 21,13, " "
  print at 21,14, " "
  Y = Menu + 12
  print at 21,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 11,1, "THE RULES"
  print at 2,3, "THE DWARVEN GOLD LIES IN ONE"
  print at 2,4, "OF THREE CORNERS OF THE"
  print at 2,5, "CAVERN. FIND IT IN AS FEW"
  print at 2,6, "STEPS AS YOU CAN."
  print at 2,8, "THE DWARVEN SOURCE BEAM"
  print at 2,9, "READS 100 TIMES THE NORTH-"
  print at 2,10, "SOUTH DISTANCE TO THE GOLD"
  print at 2,11, "PLUS 10 TIMES THE EAST-WEST."
  print at 2,13, "THE MAP NEVER SHOWS THE"
  print at 2,14, "GOLD. THE FIRST LOOK IS FREE"
  print at 2,15, "THEN EACH COSTS 15 STEPS."
  print at 2,17, "STICK UP: FORWARD. DOWN:"
  print at 2,18, "BACK. LEFT, RIGHT: TURN."
  print at 2,19, "BUTTON: THE MAP."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub EditorialPage:
  NewScreen
  print at 2,1, "STRONGHOLD OF THE DWARVEN"
  print at 2,2, "LORDS"
  print at 2,4, "FROM TIM HARTNELL'S GIANT"
  print at 2,5, "BOOK OF COMPUTER GAMES"
  print at 2,6, "(BALLANTINE BOOKS, 1984;"
  print at 2,7, "INTERFACE PUBLICATIONS,"
  print at 2,8, "1983)."
  print at 2,10, "THE BOOK SUGGESTED TURNING"
  print at 2,11, "ITS TEXT INTO A 3D MAZE:"
  print at 2,12, "HERE IT IS."
  print at 2,14, "NEW MUSIC: UNDER THE"
  print at 2,15, "MOUNTAIN."
  print at 2,17, "COLECOVISION VERSION BY"
  print at 2,18, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

data TilePat bytes
  $00,$10,$10,$10,$00,$01,$01,$01
  $00,$10,$10,$10,$00,$01,$01,$01
  $00,$10,$10,$10,$00,$01,$01,$01
  $00,$10,$10,$10,$00,$01,$01,$01
  $00,$10,$10,$10,$00,$01,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$00
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$01,$03,$07,$F0,$E0,$C0,$80
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $00,$80,$C0,$E0,$F0,$07,$03,$01
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$02,$00,$00,$00,$40,$00,$00
  $01,$11,$11,$00,$01,$41,$41,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $18,$C3,$81,$00,$C3,$C3,$C3,$00
  $08,$0C,$81,$80,$80,$81,$0C,$08
  $00,$C3,$C3,$C3,$00,$81,$C3,$18
  $10,$30,$81,$01,$01,$81,$30,$10
  $00,$18,$C3,$81,$81,$00,$00,$00
end data
data TileCol bytes
  $0E,$EF,$EF,$EF,$0E,$EF,$EF,$EF
  $04,$4E,$4E,$4E,$04,$4E,$4E,$4E
  $01,$1E,$1E,$1E,$01,$1E,$1E,$1E
  $01,$14,$14,$14,$01,$14,$14,$14
  $01,$14,$14,$14,$01,$14,$14,$14
  $01,$04,$04,$04,$01,$04,$04,$04
  $F1,$F1,$F1,$F1,$1F,$1F,$1F,$0F
  $0F,$1F,$1F,$1F,$F1,$F1,$F1,$F1
  $F1,$F1,$F1,$1F,$1F,$1F,$1F,$0F
  $0F,$1F,$1F,$1F,$1F,$F1,$F1,$F1
  $E1,$E1,$E1,$E1,$1E,$1E,$1E,$0E
  $0E,$1E,$1E,$1E,$E1,$E1,$E1,$E1
