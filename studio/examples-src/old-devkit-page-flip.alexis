u8 CursorX = 0
u8 CursorY = 0

' Old devkit page-flip stress test
  tile screen
  fill full mode 2 text color with $F0
  load default ascii
  duplicate mode 2 text patterns
  cls
  print at 1,0, "SCREEN #1"
  set screen pages vram.name and vram $1C00
  cls
  print at 1,0, "SCREEN #2"
  screen on
  goto page_loop

page_loop:
  set screen pages vram $1C00 and vram.name
  CursorX = random(1, 30)
  CursorY = random(1, 22)
  print at CursorX,CursorY, "1"
  wait 5 frames
  set screen pages vram.name and vram $1C00
  CursorX = random(1, 30)
  CursorY = random(1, 22)
  print at CursorX,CursorY, "2"
  wait 5 frames
  goto page_loop