  $01,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D
  $01,$1D,$1D,$1D,$1D,$1D,$1D,$01,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$01
  $01,$0D,$1D,$0D,$1D,$1D,$0D,$01,$1D,$0D,$1D,$0D,$1D,$1D,$0D,$01
  $01,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D,$1D
  $01,$0D,$1D,$0D,$1D,$1D,$0D,$1D,$1D,$0D,$1D,$0D,$1D,$1D,$0D,$1D
end data

data TitleMap bytes
  $AE,$AE,$93,$97,$95,$AE,$91,$AE,$AE,$AE,$8F,$9B,$95,$AE,$8F,$9B,$95,$AE,$91,$AE,$91,$AE,$93,$97,$95,$AE,$93,$97,$99,$AE,$AE,$AE
  $AE,$AE,$92,$AE,$AE,$AE,$92,$AE,$AE,$AE,$AE,$92,$AE,$AE,$AE,$92,$AE,$AE,$92,$AE,$92,$AE,$92,$AE,$AE,$AE,$92,$AE,$92,$AE,$AE,$AE
  $AE,$AE,$90,$97,$99,$AE,$92,$AE,$AE,$AE,$AE,$92,$AE,$AE,$AE,$92,$AE,$AE,$94,$97,$9A,$AE,$94,$95,$AE,$AE,$92,$93,$96,$AE,$AE,$AE
  $AE,$AE,$AE,$AE,$92,$AE,$92,$AE,$AE,$AE,$AE,$92,$AE,$AE,$AE,$92,$AE,$AE,$92,$AE,$92,$AE,$92,$AE,$AE,$AE,$92,$90,$99,$AE,$AE,$AE
  $AE,$AE,$8F,$97,$96,$AE,$90,$97,$95,$AE,$8F,$98,$95,$AE,$AE,$8E,$AE,$AE,$8E,$AE,$8E,$AE,$90,$97,$95,$AE,$8E,$AE,$8E,$AE,$AE,$AE
end data

record Snake:
  u8 C
  u8 R
  u8 Dir
  u8 InM
  u8 Nc
  u8 Nr
end record

Snake Hd
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Tal = 0
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u8 RowBuf[76]
u8 NameBuf[24]
' play state: phase (0 moving, 1 crashed, 2 room cleared), moving, frame
' of the move, what the next cell holds, the stick remembered
u8 Ph = 0
u8 Mv = 0
u8 Mt = 0
u8 Pv = 0
u8 Want = 255
u8 Lives = 7
u8 Diff = 1
u8 Room = 1
u8 Left = 0
u8 Kind = 1
u8 Over = 0
u8 Crashes = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Steps = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Rx = 0
u8 Ry = 0
u8 Pz = 0
u8 Ti = 0
u8 Ni = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 M = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 P8 = 0

  tile screen
  set sound table SlSoundTable areas 6
  sprites 16x16
  set sprite count 2
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawHead
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Sc > Hi then Hi = Sc
  print at 9,10, "            "
  print at 9,11, "  GAME OVER "
  print at 9,12, "            "
  print at 9,13, " BEST       "
  print at 15,13, Hi
  print at 9,14, "            "
  ShowHud
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Steps
  select case Ph
    case 0
      SnakeStep
    case 1
      CrashSeq
    case 2
      ClearSeq
  end select
  return
end sub

' remember the stick (one straight direction; diagonals do nothing, as on
' the C64); finish the glide under way; at a cell, choose the next one
sub SnakeStep:
  K = J1 & 15
  select case K
    case 1
      Want = 0
    case 8
      Want = 1
    case 2
      Want = 2
    case 4
      Want = 3
  end select
  if Mv = 1 then
    inc Mt
    if Mt >= StepF then
      Arrive
      Mv = 0
    end if
  end if
  if Mv = 0 then
    if Ph = 0 then Decide
  end if
  return
end sub

' 1 when tile V lets the snake in: the floor or a treasure
function Free(u8 Tv) as u8
  if Tv = TFloor then return 1
  if Tv >= TP1 and Tv <= TP12 then return 1
  return 0

sub Decide:
  D = Hd.Dir
  if Want < 4 then
    V = Hd.Dir ^ 2
    if Want <> V then D = Want
  end if
  X = Hd.C + DCol[D]
  Y = Hd.R + DRow[D]
  Pv = get char at X,Y
  if Free(Pv) = 0 then
    Ph = 1
    play sound SndCrash
    return
  end if
  M = Hd.InM | Bit[D]
  put char TSn0 + M at Hd.C,Hd.R
  Hd.Dir = D
  Hd.Nc = X
  Hd.Nr = Y
  Mv = 1
  Mt = 0
  return
end sub

' the head is in its new cell: an end piece there, and a treasure is eaten
sub Arrive:
  Hd.C = Hd.Nc
  Hd.R = Hd.Nr
  V = Hd.Dir ^ 2
  Hd.InM = Bit[V]
  put char TSn0 + Hd.InM at Hd.C,Hd.R
  if Pv <> TFloor then EatOne
  return
end sub

sub EatOne:
  K = Pv - TP1
  W16 = Worth[K]
  AddPts(W16)
  play sound SndEat0 + K
  dec Left
  ShowHud
  if Left = 0 then Ph = 2
  return
end sub

' add P points to the BCD score (BCD += takes a byte, bug
' rashgar-bcd-add-u16: big amounts go in steps of 200)
sub AddPts(u16 P)
  while P > 200
    Sc += 200
    P = P - 200
  end while
  P8 = P
  Sc += P8
  return
end sub

' a crash: the dead head a moment, the trail wiped row by row, a pause,
' then a life less: the next snake, or the end
sub CrashSeq:
  inc Crashes
  Pause(40)
  for Ry = 3 to 21
    WipeRow
    if Ry & 1 then play sound SndWipe
    Frame1
  next
  Pause(30)
  dec Lives
  ShowHud
  if Lives = 0 then
    Over = 1
  else
    Respawn
  end if
  return
end sub

sub WipeRow:
  for Rx = 3 to 28
    V = get char at Rx,Ry
    if V >= TSn0 and V <= TSn15 then put char TFloor at Rx,Ry
  next
  return
end sub

' every treasure eaten: the room bonus, then the next room
sub ClearSeq:
  Pause(20)
  play sound SndClear
  print at 9,10, "            "
  print at 9,11, "  BONUS     "
  K = Kind
  W16 = Worth[K]
  NumU = W16
  print at 17,11, digits$(NumU, 3)
  print at 9,12, "            "
  AddPts(W16)
  ShowHud
  Pause(90)
  inc Room
  if Room > NRooms then
    BigBonus
    Room = 1
    LevelBanner
  end if
  StartRoom
  return
end sub

' after room 40: the twelve treasures' worth times the difficulty, a
' difficulty more, that many lives
sub BigBonus:
  NewScreen
  backdrop dark blue
  print at 9,4, "LEVEL "
  NumU = Diff
  print at 15,4, digits$(NumU, 1)
  print at 17,4, "BONUS"
  ShowHud
  ShowScreen
  Tal = 0
  for Ti = 0 to 11
    put char TP1 + Ti at Ti * 2 + 4,8
    Pause(10)
    W16 = Worth[Ti]
    for Ni = 1 to Diff
      Tal = Tal + W16
      AddPts(W16)
    next
    play sound SndTally
    NumU = Tal
    print at 14,10, digits$(NumU, 5)
    ShowHud
    Pause(10)
  next
  Pause(60)
  if Diff < 5 then inc Diff
  Lives = Lives + Diff
  if Lives > 9 then Lives = 9
  NumU = Diff
  print at 7,13, digits$(NumU, 1)
  print at 9,13, "BONUS LIVES"
  play sound SndLife
  ShowHud
  Pause(60)
  print at 3,16, "GET READY FOR DIFFICULTY "
  print at 28,16, digits$(NumU, 1)
  Pause(150)
  return
end sub

' the snake starts again at the top left, heading right
sub Respawn:
  Hd.C = StartC
  Hd.R = StartR
  Hd.Dir = 1
  Hd.InM = 0
  Want = 255
  Mv = 0
  Mt = 0
  put char TSn0 at Hd.C,Hd.R
  Ph = 0
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub NewGame:
  Sc = 0
  Lives = 7
  Room = 1
  Over = 0
  Crashes = 0
  LevelBanner
  StartRoom
  return
end sub

sub LevelBanner:
  NewScreen
  print at 10,9, "DIFFICULTY "
  NumU = Diff
  print at 21,9, digits$(NumU, 1)
  print at 6,12, "40 ROOMS THIS LEVEL"
  ShowScreen
  play sound SndStart
  Pause(120)
  return
end sub

' a room: walls, name, treasures, the snake at the start
sub StartRoom:
  NewScreen
  K = Diff - 1
  W16 = K * 128
  copy SnCol + W16 count 128 to vram.color + TSn0 * 8
  K = (Room - 1) & 7
  W16 = K * 128
  copy WallCol + W16 count 128 to vram.color + TW0 * 8
  DrawRoom
  RoomName
  Kind = Room
  if Kind > 12 then Kind = 12
  Kind = Kind - 1
  Left = Diff
  for Pz = 1 to Diff
    PlaceOne
  next
  Respawn
  ShowHud
  DrawHead
  ShowScreen
  Pause(30)
  return
end sub

' 1 when cell (Cx, Cy) is wall: the border, or a wall of the room (RowBuf)
function WallAt(u8 Cx, u8 Cy) as u8
  if Cx < 2 or Cx > 29 or Cy < 2 or Cy > 22 then return 0
  if Cx = 2 or Cx = 29 or Cy = 2 or Cy = 22 then return 1
  N = (Cy - 3) * 4 + (Cx >> 3)
  V = RowBuf[N] & BitT[Cx & 7]
  if V > 0 then return 1
  return 0

sub DrawRoom:
  W16 = Room - 1
  W16 = W16 * RoomBytes
  copy RoomBits + W16 count RoomBytes to RowBuf
  for Ry = 2 to 22
    for Rx = 2 to 29
      if WallAt(Rx, Ry) = 1 then
        M = 0
        if WallAt(Rx, Ry - 1) = 1 then M = M | 1
        if WallAt(Rx + 1, Ry) = 1 then M = M | 2
        if WallAt(Rx, Ry + 1) = 1 then M = M | 4
        if WallAt(Rx - 1, Ry) = 1 then M = M | 8
        put char TW0 + M at Rx,Ry
      else
        put char TFloor at Rx,Ry
      end if
    next
  next
  return
end sub

' "#n THE NAME" in the top wall, in the middle
sub RoomName:
  K = Room - 1
  W16 = RoomOff[K]
  NumU = RoomOff[Room]
  N = NumU - W16
  copy RoomTxt + W16 count 24 to NameBuf
  T = N + 4
  if Room >= 10 then inc T
  X = 16 - (T >> 1)
  print at X,2, " #"
  NumU = Room
  if Room >= 10 then
    print at X + 2,2, digits$(NumU, 2)
    X = X + 4
  else
    print at X + 2,2, digits$(NumU, 1)
    X = X + 3
  end if
  put char 32 at X,2
  for J = 1 to N
    put char NameBuf[J - 1] at X + J,2
  next
  put char 32 at X + N + 1,2
  return
end sub

' a treasure on a random empty cell (columns 4-27, rows 3-20), not the start
sub PlaceOne:
  T = 0
  while T = 0
    X = RandBelow(24) + 4
    Y = RandBelow(18) + 3
    V = get char at X,Y
    if V = TFloor then T = 1
    if X = StartC and Y = StartR then T = 0
  end while
  put char TP1 + Kind at X,Y
  return
end sub

function RandBelow(u8 Lim) as u8
  Rand
  W16 = Rs >> 4
  return W16 % Lim

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub ShowHud:
  print at 2,1, Sc
  put char TLife at 13,1
  NumU = Lives
  print at 14,1, digits$(NumU, 1)
  print at 19,1, "HI"
  print at 22,1, Hi
  return
end sub

' the head: sprite 0, gliding from its cell toward the next
sub DrawHead:
  X = Hd.C * 8 - 4
  Y = Hd.R * 8 - 4
  if Mv = 1 then
    V = Glide[Mt]
    select case Hd.Dir
      case 0
        Y = Y - V
      case 1
        X = X + V
      case 2
        Y = Y + V
      case 3
        X = X - V
    end select
  end if
  if Ph = 1 then
    K = SHx
  else
    K = Hd.Dir << 3
    K = K + SHd00
    V = Tick & 16
    if V > 0 then K = K + 4
  end if
  C = SnakeC[Diff - 1]
  set sprite 0 to Y - 1,X,K,C
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Nf)
  for Pz = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SLITHER in snake pieces, the difficulty, START / CREDITS
sub TitlePage:
  NewScreen
  copy SnCol count 128 to vram.color + TSn0 * 8
  copy TitleMap count 160 to vram.name + 96
  print at 7,1, "AHOY! NOVEMBER 1985"
  print at 3,10, "STEER THE SNAKE THROUGH"
  print at 3,11, "40 CASTLE ROOMS. EAT THE"
  print at 3,12, "TREASURES, MISS THE WALLS"
  print at 3,13, "AND YOUR OWN TRAIL."
  for Ti = 0 to 11
    put char TP1 + Ti at Ti * 2 + 4,15
  next
  print at 5,17, "DIFFICULTY"
  print at 16,17, "1 2 3 4 5"
  print at 12,19, "START"
  print at 12,20, "CREDITS"
  if Hi > 0 then
    print at 9,22, "BEST "
    print at 14,22, Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 580
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      select case V
        case 1
          Menu = 0
        case 2
          Menu = 1
        case 4
          if Diff > 1 then dec Diff
        case 8
          if Diff < 5 then inc Diff
      end select
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub TitleAnim:
  K = Tick & 16
  T = SHd30
  if K > 0 then T = SHd31
  C = SnakeC[Diff - 1]
  set sprite 0 to 59,222,T,C
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,19
  put char 32 at 10,20
  J = Menu + 19
  put char 62 at 10,J
  for Ti = 0 to 4
    X = Ti * 2 + 15
    put char 32 at X,17
    put char 32 at X + 2,17
  next
  X = Diff * 2 + 13
  put char 91 at X,17
  put char 93 at X + 2,17
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "SLITHER"
  print at 2,5, "BASED ON SLITHER,"
  print at 2,6, "AHOY! NOVEMBER 1985"
  print at 2,7, "(COMMODORE 64 TYPE-IN;"
  print at 2,8, "THE LISTING NAMES NO"
  print at 2,9, "AUTHOR)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: CASTLE CRAWL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

