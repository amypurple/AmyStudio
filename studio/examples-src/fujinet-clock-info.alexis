' FujiNet clock and adapter information.
' Build for a ColecoVision cartridge with target.hardware ["fujinet"].
u8 S = 0
u8 Got = 0
u8 Field[20]
FujiNetTime Clock

text screen
backdrop dark blue
screen on
print at 0,0, "FUJINET STATUS"

fujinet time into Clock status S
if S = 0 then
  print at 0,2, "TIME"
  print Clock.Hour at 10,2 digits 2
  print at 12,2, ":"
  print Clock.Minute at 13,2 digits 2
  print at 0,3, "DATE"
  print Clock.Month at 10,3 digits 2
  print at 12,3, "/"
  print Clock.Day at 13,3 digits 2
end if

Got = fujinet version into Field status S
print at 0,5, "FIRMWARE"
put Field count Got at 10,5
Got = fujinet hostname into Field status S
print at 0,6, "HOSTNAME"
put Field count Got at 10,6
Got = fujinet ip into Field status S
print at 0,7, "ADDRESS"
put Field count Got at 10,7
loop forever
