cartridge "KNIGHT'S TOUR/RAMELLA, AHOY!/1985"

' KNIGHT'S TOUR
' Based on "Knight's Tour" by Ramella, Ahoy! November 1985 (Commodore 64
' BASIC, disk ahoy1985-11; the author's name from the listing's first REM;
' orig/ has the extracted program and its listing). Made for the
' ColecoVision in Amy (the language by Amy Bienvenu) by Claude (an AI made
' by Anthropic) for Amy Studio, 2026.
'
' The listing's rules (kept):
' - An 8 x 8 board and a knight. First the knight walks freely, a square
'   at a time, to the square you choose (keys A Z , . then K).
' - Then every knight's move is traced in three single steps: two in one
'   direction and one at a right angle, or one and then two (the 16 step
'   strings of lines 350-370). Any other three steps are refused and the
'   knight goes back to where the move began (line 385).
' - A step off the edge of the board cancels the move (lines 255-290).
' - The square a move lands on gets a ball (lines 400-410) and the score
'   goes up by one (lines 411-412). A move onto a square that already has a
'   ball is refused (line 375).
' - The starting square gets no ball when the knight leaves it, so the
'   knight may come back to it: 63 is a full tour, 64 a closed tour that
'   ends where it began.
'
' Liberties (noted):
' - The listing never ended: you stopped when you were stuck. Here the
'   game ends by itself when the knight has no move left (no unvisited
'   square a knight's move away), with a verdict: a full tour (63), a
'   closed tour (64) or the squares visited; the best score of the session
'   is kept.
' - Joystick: the stick replaces A Z , . (the knight glides one square per
'   push), the left button replaces K, and the right button takes back the
'   steps of a move half traced (the listing had no way back but a wrong
'   third step).
' - The steps of the move being traced are marked with white dots; the
'   starting square carries a red ring until the knight comes back to it.
' - New art (wood board, blue balls, a knight with an outline), sounds, an
'   original title tune ("The Knight's Gallop", once), credits and rules.
'   The listing's own sprite (a 24 x 21 horse head) is redrawn at 16 x 16.
'
' Controls (either joystick): stick: move the knight one square; left
' button: start the tour from the knight's square; right button: take back
' the steps of the move being traced.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; every screen drawn with the NMI off after a wait; at the end a press
' goes back to the title, and the screen sleeps after 30 seconds.

const TLt00 = 128
const TLt01 = 129
const TLt10 = 130
const TLt11 = 131
const TDk00 = 132
const TDk01 = 133
const TDk10 = 134
const TDk11 = 135
const TLtv00 = 136
const TLtv01 = 137
const TLtv10 = 138
const TLtv11 = 139
const TDkv00 = 140
const TDkv01 = 141
const TDkv10 = 142
const TDkv11 = 143
const TLth00 = 144
const TLth01 = 145
const TLth10 = 146
const TLth11 = 147
const TDkh00 = 148
const TDkh01 = 149
const TDkh10 = 150
const TDkh11 = 151
const TLts00 = 152
const TLts01 = 153
const TLts10 = 154
const TLts11 = 155
const TDks00 = 156
const TDks01 = 157
const TDks10 = 158
const TDks11 = 159
const TFh = 160
const TFv = 161
const TFc = 162
const SCursor = 0
const SKnightl = 4
const SKnight = 8
const NTiles8 = 280
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndLand = 4
const SndTick = 5
const SndPick = 6
const SndBuzz = 7
const SndWin = 8
const SndEnd = 9
const TuneFrames = 448

' a step of the move being traced: the square and the direction that led
' there (1 up, 2 down, 3 left, 4 right)
record Trace:
  u8 R
  u8 C
  u8 D
end record

' the tune now playing once: frames left (counted in Rearm)
u16 TzLeft = 0
u8 TzOn = 0

' the board: Rc(row * 9 + column), rows and columns 1-8: 0 free, 1 a ball
u8 Rc[81]
Trace Tr[4]
' R1, C1 where the knight stands; Sr, Sc where the tour began; Ns the
' steps traced in this move (0-3)
u8 R1 = 0
u8 C1 = 0
u8 Sr = 0
u8 Sc = 0
u8 Ns = 0
bcd digits 2 Sq = 0
bcd digits 2 Best = 0
u8 Vis = 0
' Er the last refusal (0 none, 1 not a knight's move, 2 a ball there,
' 3 off the board); Over 1 when no move is left
u8 Er = 0
u8 Over = 0
u8 Exits = 0
' Ph: 1 choosing the start, 2 tracing a move, 3 the knight gliding,
' 5 the end, 0 elsewhere (for the bot); Idle 1 inside the frame wait
u8 Ph = 0
u8 Idle = 0
u8 Menu = 0
' work
u8 Qr = 0
u8 Qc = 0
u8 R2 = 0
u8 C2 = 0
u8 Gx = 0
u8 Gy = 0
u8 Fr = 0
u8 Dir = 0
u8 Ok = 0
u16 NumU = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 Kd = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

' the knight's eight moves (row, column offsets; 254 = -2, 255 = -1)
data KDr bytes
  254, 254, 255, 255, 1, 1, 2, 2
end data
data KDc bytes
  255, 1, 254, 2, 254, 2, 255, 1
end data

  tile screen
  set sound table KnSoundTable areas 6
  sprites 16x16
  set sprite count 2
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title
  if Menu = 1 then
    RulesPage
    goto title
  end if

new_tour:
  NewScreen
  ResetBoard
  DrawBoard
  DrawPanel
  ShowScreen
  Over = 0
  Er = 0
  Ns = 0
  R1 = 4
  C1 = 4
  PieceAt
  ShowFrom
  print at 2,22, "WALK TO A SQUARE, THEN FIRE"
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  WasStk = 1

' first the knight walks freely to the starting square (lines 150-240)
place_loop:
  Ph = 1
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    Dir = StickToDir
    if Dir <> 0 then
      R2 = R1
      C2 = C1
      StepFrom
      if Ok = 1 then
        play sound SndTick
        Ph = 3
        GlideOne
        ShowFrom
      end if
    end if
  end if
  if Press = 0 then goto place_loop
  Sr = R1
  Sc = C1
  Qr = R1
  Qc = C1
  DrawSq
  play sound SndPick
  print at 2,22, "TRACE A KNIGHT'S MOVE      "
  Exits = CountExits(R1, C1)
  if Exits = 0 then goto tour_end

' every move: three steps, checked after the third (lines 245-420)
move_loop:
  Ph = 2
  Frame1
  ReadPad
  if Press2 = 1 then
    if Ns > 0 then
      Er = 0
      TakeBack
      play sound SndTick
      print at 2,22, "STEPS TAKEN BACK           "
    end if
    goto move_loop
  end if
  StickDir
  if Rep = 0 then goto move_loop
  Dir = StickToDir
  if Dir = 0 then goto move_loop
  R2 = R1
  C2 = C1
  StepFrom
  if Ok = 0 then
    Er = 3
    TakeBack
    print at 2,22, "OFF THE BOARD              "
    play sound SndBuzz
    goto move_loop
  end if
  if Ns = 0 then
    Tr[0].R = R1
    Tr[0].C = C1
    Tr[0].D = 0
    Er = 0
    print at 2,22, "                           "
  end if
  inc Ns
  Tr[Ns].R = R2
  Tr[Ns].C = C2
  Tr[Ns].D = Dir
  Ph = 3
  play sound SndStep
  GlideOne
  if Ns < 3 then
    MarkStep
    goto move_loop
  end if
  ' three steps: a knight's move onto a free square?
  Er = 0
  if Rc[Idx(R1, C1)] = 1 then Er = 2
  if IsKnightMove = 0 then Er = 1
  if Er <> 0 then
    TakeBack
    if Er = 1 then print at 2,22, "NOT A KNIGHT'S MOVE        "
    if Er = 2 then print at 2,22, "THAT SQUARE HAS A BALL     "
    play sound SndBuzz
    goto move_loop
  end if
  Landed
  if Over = 1 then goto tour_end
  goto move_loop

' no move left: the verdict, then back to the title
tour_end:
  Ph = 5
  for Fr = 1 to 40
    Frame1
  next
  print at 2,21, "                           "
  print at 2,22, "                           "
  if Vis = 64 then
    print at 2,21, "A CLOSED TOUR! ALL 64"
    print at 2,22, "AND BACK WHERE YOU BEGAN"
    play sound SndWin
  else
    if Vis = 63 then
      print at 2,21, "A FULL TOUR! EVERY SQUARE"
      print at 2,22, "VISITED"
      play sound SndWin
    else
      print at 2,21, "NO MOVES LEFT:"
      NumU = Vis
      print at 17,21, digits$(NumU, 2)
      print at 20,21, "SQUARES"
      play sound SndEnd
    end if
  end if
  if Sq > Best then
    Best = Sq
    print at 2,22, "                           "
    print at 2,22, "A NEW BEST SCORE"
  end if
  ShowBest
  for Fr = 1 to 60
    Frame1
  next
  print at 22,19, "PRESS A"
  print at 22,20, "BUTTON"
  Rearm
  pause until press and release sleep after 30 seconds
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  goto title

' ---------------------------------------------------------------------
' the rules


function Idx(u8 Rr, u8 Cc) as u8
  return Rr * 9 + Cc

' CountExits: the free squares a knight's move away from Rr, Cc
function CountExits(u8 Rr, u8 Cc) as u8
  u8 N = 0
  u8 M = 0
  u8 Tr2 = 0
  u8 Tc2 = 0
  for M = 0 to 7
    Tr2 = Rr + KDr[M]
    Tc2 = Cc + KDc[M]
    if Tr2 >= 1 then
      if Tr2 <= 8 then
        if Tc2 >= 1 then
          if Tc2 <= 8 then
            if Rc[Tr2 * 9 + Tc2] = 0 then inc N
          end if
        end if
      end if
    end if
  next
  return N

' IsKnightMove: 1 when the three steps are two one way and one at a right
' angle, in either order (the 16 strings of lines 350-370)
function IsKnightMove as u8
  u8 A = 0
  u8 B = 0
  u8 Cd = 0
  A = Tr[1].D
  B = Tr[2].D
  Cd = Tr[3].D
  if A = B then
    if Across(B, Cd) = 1 then return 1
    return 0
  end if
  if B = Cd then
    if Across(A, B) = 1 then return 1
  end if
  return 0

' Across: 1 when two directions are at a right angle
function Across(u8 P, u8 Q) as u8
  select case (P, Q)
  case (1 to 2, 3 to 4)
    return 1
  case (3 to 4, 1 to 2)
    return 1
  end select
  return 0

' StickToDir: 1 up, 2 down, 3 left, 4 right (a diagonal push counts as
' up or down)
function StickToDir as u8
  if Up1 = 1 then return 1
  if Dn1 = 1 then return 2
  if Lf1 = 1 then return 3
  if Rt1 = 1 then return 4
  return 0

' StepFrom: R2, C2 one square from where they are in direction Dir; Ok 0
' off the board
sub StepFrom:
  Ok = 1
  select case Dir
  case 1
    if R2 = 1 then
      Ok = 0
    else
      dec R2
    end if
  case 2
    if R2 = 8 then
      Ok = 0
    else
      inc R2
    end if
  case 3
    if C2 = 1 then
      Ok = 0
    else
      dec C2
    end if
  case 4
    if C2 = 8 then
      Ok = 0
    else
      inc C2
    end if
  end select
  return
end sub

sub ResetBoard:
  for I = 0 to 80
    Rc[I] = 0
  next
  Sq = 0
  Vis = 0
  Sr = 0
  Sc = 0
  return
end sub

' Landed: the ball on the knight's square, the score, any move left?
sub Landed:
  W = Idx(R1, C1)
  Rc[W] = 1
  ClearDots
  Ns = 0
  Sq += 1
  inc Vis
  Qr = R1
  Qc = C1
  DrawSq
  ShowScore
  play sound SndLand
  Exits = CountExits(R1, C1)
  Over = 0
  if Exits = 0 then Over = 1
  return
end sub

' TakeBack: the dots of this move cleared, the knight back where it began
sub TakeBack:
  ' (no early return here: a sub whose FOR has a variable end must not
  ' return before it, bugs/jake-return-before-for.alexis)
  if Ns > 0 then
    ClearDots
    R1 = Tr[0].R
    C1 = Tr[0].C
    Ns = 0
  end if
  PieceAt
  ShowFrom
  return
end sub

' ClearDots: the squares of this move's steps redrawn (no dots)
sub ClearDots:
  for Kd = 1 to Ns
    Qr = Tr[Kd].R
    Qc = Tr[Kd].C
    DrawSq
  next
  return
end sub

' ---------------------------------------------------------------------
' the controls

' StickDir: Rep 1 on a new push, then again every 8 frames after 16
sub StickDir:
  Stk = Up1 | Dn1
  Stk = Stk | Lf1
  Stk = Stk | Rt1
  Rep = 0
  if Stk = 0 then
    WasStk = 0
    return
  end if
  if WasStk = 0 then
    Rep = 1
    WasStk = 16
    return
  end if
  dec WasStk
  if WasStk = 0 then
    Rep = 1
    WasStk = 8
  end if
  return
end sub

' ---------------------------------------------------------------------
' drawing

' DrawSq: the square Qr, Qc: wood, a ball, the start's ring
sub DrawSq:
  W = Idx(Qr, Qc)
  K = Qr + Qc
  K = K & 1
  V = TLt00
  if K = 1 then V = TDk00
  if Rc[W] = 1 then
    V = V + 8
  else
    if Qr = Sr then
      if Qc = Sc then V = V + 16
    end if
  end if
  Put2x2
  return
end sub

' MarkStep: a white dot on the knight's square (a step of this move)
sub MarkStep:
  Qr = R1
  Qc = C1
  K = Qr + Qc
  K = K & 1
  V = TLts00
  if K = 1 then V = TDks00
  Put2x2
  return
end sub

' Put2x2: tiles V..V+3 on square Qr, Qc
sub Put2x2:
  X = Qc - 1
  X = X << 1
  X = X + 4
  Y = Qr - 1
  Y = Y << 1
  Y = Y + 4
  put char V at X,Y
  inc V
  inc X
  put char V at X,Y
  inc V
  dec X
  inc Y
  put char V at X,Y
  inc V
  inc X
  put char V at X,Y
  return
end sub

sub DrawBoard:
  put char TFc at 3,3
  put char TFc at 20,3
  put char TFc at 3,20
  put char TFc at 20,20
  for I = 4 to 19
    put char TFh at I,3
    put char TFh at I,20
    put char TFv at 3,I
    put char TFv at 20,I
  next
  for I = 1 to 8
    V = I - 1
    V = V << 1
    V = V + 4
    W = I + 64
    put char W at V,2
    W = I + 48
    put char W at 2,V
  next
  for Qr = 1 to 8
    for Qc = 1 to 8
      DrawSq
    next
  next
  return
end sub

sub DrawPanel:
  print at 22,3, "KNIGHT'S"
  print at 22,4, "TOUR"
  print at 22,6, "SCORE"
  ShowScore
  print at 22,9, "BEST"
  ShowBest
  print at 22,12, "AT"
  print at 22,15, "RIGHT:"
  print at 22,16, " TAKE"
  print at 22,17, " BACK"
  print at 6,1, "KNIGHT'S TOUR"
  return
end sub

sub ShowScore:
  print at 22,7, Sq
  return
end sub

sub ShowBest:
  print at 22,10, Best
  return
end sub

sub ShowFrom:
  V = R1 + 48
  put char V at 25,12
  V = C1 + 64
  put char V at 26,12
  return
end sub

' PieceAt: the knight on R1, C1
sub PieceAt:
  Gx = C1 - 1
  Gx = Gx << 4
  Gx = Gx + 32
  Gy = R1 - 1
  Gy = Gy << 4
  Gy = Gy + 31
  PieceXY
  return
end sub

sub PieceXY:
  set sprite 0 to Gy,Gx,SKnightl,1
  set sprite 1 to Gy,Gx,SKnight,15
  update sprites
  return
end sub

' GlideOne: the knight slides from R1, C1 to the next square R2, C2
sub GlideOne:
  R1 = R2
  C1 = C2
  for Fr = 1 to 8
    Frame1
    ReadPad
    ' (a push let go while gliding is seen, so the next push counts)
    StickDir
    V = C1 - 1
    V = V << 4
    V = V + 32
    if V > Gx then Gx = Gx + 2
    if V < Gx then Gx = Gx - 2
    V = R1 - 1
    V = V << 4
    V = V + 31
    if V > Gy then Gy = Gy + 2
    if V < Gy then Gy = Gy - 2
    PieceXY
  next
  ShowFrom
  return
end sub

' ---------------------------------------------------------------------
' screens and the frame

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a little board along a row (the title and credits): 8 squares at row Y
sub BoardRow:
  for I = 0 to 7
    V = I & 1
    V = V << 2
    V = V + TLt00
    Qc = I + 1
    Qr = 1
    X = I << 1
    X = X + 8
    put char V at X,Y
    inc V
    inc X
    put char V at X,Y
    inc V
    dec X
    W = Y + 1
    put char V at X,W
    inc V
    inc X
    put char V at X,W
  next
  return
end sub

sub TitlePage:
  Ph = 0
  NewScreen
  print at 9,2, "KNIGHT'S TOUR"
  Y = 4
  BoardRow
  print at 3,7, "LEAD THE KNIGHT ONTO EVERY"
  print at 3,8, "SQUARE OF THE BOARD, NEVER"
  print at 3,9, "LANDING TWICE ON THE SAME."
  print at 10,13, "PLAY"
  print at 10,14, "HOW TO PLAY"
  print at 10,15, "CREDITS"
  if Best > 0 then
    print at 10,18, "BEST:"
    print at 16,18, Best
  end if
  Menu = 0
  ShowTitleMenu
  set sprite 0 to 95,200,SKnightl,1
  set sprite 1 to 95,200,SKnight,15
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneFrames
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStk = 1
tp_loop:
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    ShowTitleMenu
    play sound SndTick
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowTitleMenu:
  for K = 13 to 15
    put char 32 at 8,K
  next
  V = Menu + 13
  put char 62 at 8,V
  return
end sub

sub RulesPage:
  Ph = 0
  NewScreen
  print at 8,1, "KNIGHT'S TOUR"
  print at 2,3, "WALK THE KNIGHT TO A SQUARE"
  print at 2,4, "AND PRESS FIRE TO BEGIN."
  print at 2,6, "TRACE EACH KNIGHT'S MOVE IN"
  print at 2,7, "THREE STEPS: TWO ONE WAY AND"
  print at 2,8, "ONE TO THE SIDE, OR ONE AND"
  print at 2,9, "THEN TWO. THE SQUARE YOU"
  print at 2,10, "LAND ON GETS A BALL, 1 POINT"
  print at 2,12, "NEVER LAND ON A BALL. YOUR"
  print at 2,13, "FIRST SQUARE HAS NO BALL:"
  print at 2,14, "63 IS A FULL TOUR, 64 A"
  print at 2,15, "CLOSED TOUR BACK HOME."
  print at 2,17, "RIGHT BUTTON: TAKE BACK THE"
  print at 2,18, "STEPS OF A MOVE. THE GAME"
  print at 2,19, "ENDS WHEN NO MOVE IS LEFT."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen
  Y = 1
  BoardRow
  print at 3,4, "BASED ON KNIGHT'S TOUR BY"
  print at 3,5, "RAMELLA, AHOY! NOVEMBER"
  print at 3,6, "1985 (COMMODORE 64)."
  print at 3,8, "MADE FOR THE COLECOVISION"
  print at 3,9, "BY CLAUDE (AN AI MADE BY"
  print at 3,10, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,11, "2026, IN AMY BY AMY"
  print at 3,12, "BIENVENU."
  print at 3,14, "MUSIC: THE KNIGHT'S GALLOP"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  return
end sub
data TilePat bytes
  $00,$00,$00,$C0,$00,$00,$00,$00
  $00,$00,$00,$C0,$00,$00,$00,$03
