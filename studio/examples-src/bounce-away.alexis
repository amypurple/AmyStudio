  $17,$15,$15,$15,$05,$05,$05,$05,$71,$01,$01,$01,$01,$01,$01,$01
  $07,$05,$05,$15,$15,$15,$15,$15,$71,$01,$01,$01,$01,$01,$01,$01
  $15,$1D,$1D,$1D,$D1,$01,$01,$01,$15,$1D,$1D,$1D,$D1,$01,$01,$01
  $05,$0D,$1D,$1D,$D1,$01,$01,$01,$51,$01,$01,$01,$01,$01,$01,$01
  $05,$0D,$1D,$1D,$D1,$01,$01,$01,$15,$1D,$1D,$1D,$D1,$01,$01,$01
end data
data FontCol bytes
  $F1,$F1,$F1,$F1,$F1,$F1,$F1,$F1
  $F1,$F1,$F1,$F1,$F1,$F1,$F1,$F1
  $F1,$F1,$F1,$F1,$F1,$F1,$F1,$F1
end data
data FontHud bytes
  $F4,$F4,$F4,$F4,$F4,$F4,$F4,$F4
end data

' sprites Sp: 5 patterns of 16x16 (generated by art.py)
const SpBall0 = 0
const SpBall1 = 4
const SpSpark0 = 8
const SpSpark1 = 12
const SpBoom = 16
const SpBallC0 = 15
const SpBallC1 = 5
const SpBytes = 160
data SpPat bytes
  $78,$F8,$F0,$E0,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$04,$0C,$1C,$7C,$78,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$08,$05,$10,$08,$10,$05,$08,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$00,$40,$80,$40,$00,$80,$00,$00,$00,$00,$00
  $00,$00,$20,$00,$00,$02,$08,$00,$08,$02,$00,$00,$20,$00,$00,$00
  $00,$00,$20,$00,$00,$00,$80,$00,$80,$00,$00,$00,$20,$00,$00,$00
  $00,$08,$04,$25,$13,$07,$3F,$07,$13,$25,$04,$08,$00,$00,$00,$00
  $00,$20,$40,$48,$90,$C0,$F8,$C0,$90,$48,$40,$20,$00,$00,$00,$00
end data

const Logo1W = 18
const Logo1H = 3
data Logo1 bytes 193,194,195,196,197,198,199,32,200,201,202,200,196,203,204,193,205,206,207,208,209,210,32,211,210,32,211,212,213,214,210,32,215,207,216,217,218,219,220,221,222,223,221,222,223,224,225,226,221,227,228,218,229,230

const Logo2W = 12
const Logo2H = 3
data Logo2 bytes 231,232,233,234,32,235,231,232,233,236,237,238,239,240,241,242,243,244,239,240,241,245,246,247,248,32,249,250,251,252,248,32,249,32,253,32
const SndMtLead = 1
const SndMtTwo = 2
const SndMtNoise = 3
const SndMtPitch = 4
const SndMgLead = 5
const SndMgTwo = 6
const SndMgNoise = 7
const SndMgPitch = 8
const SndWall = 9
const SndBat = 10
const SndBrick = 11
const SndOrb = 12
const SndBoom = 13
const SndFall = 14
const SndClear = 15
const SndOver = 16
const SndStart = 17
const MtAreas = 7
const MtLoopFrames = 896
const MgLoopFrames = 512

' ---------------------------------------------------------------- constants
const BXMIN = 24        ' ball box (6 x 6): left edge range
const BXMAX = 226
const BATY = 162        ' top of the bat (row 20, pixel row 2)
const MAPW = 26         ' the map: columns 3-28, rows 3-15
const MAXCH = 10

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u8 Map[338]             ' 0 empty, 1-6 brick colour, 16 + hits left = orb
u16 Idx = 0
u8 BallX = 0            ' ball box, top left, in pixels
u8 BallY = 0
u8 DirX = 0             ' 0 right, 1 left
u8 DirY = 1             ' 0 down, 1 up
u8 Slope = 128          ' x steps per 256 y steps
u8 XAcc = 0
u8 SpdAcc = 0
u8 Spd = 88             ' 1/64 px a frame
u16 XT = 0
u8 BatX = 100
u8 BatW = 24            ' 24 px, 16 px from level 5 (v2)
u8 BatMax = 208         ' 232 - BatW
u8 BatMid = 12
u8 Steel = 0
u8 OldBat = 0
u8 BatV = 0
u8 HeldT = 0
u8 Serving = 1
u8 ServeT = 0
u8 Qx = 0
u8 Qy = 0
u8 Hit = 0
u8 HitAny = 0
u8 Col = 0
u8 Row = 0
u8 Gone = 0
u8 Done = 0
u8 Rows = 3
u8 OrbHp = 2
u8 Chances = 10
u8 Level = 1
u8 StartLv = 1
u16 Score = 0
u8 Bricks = 0           ' bricks broken this level (for the bot)
u8 Bounces = 0
u8 SparkT = 0
u8 SparkX = 0
u8 SparkY = 0
u8 SparkK = 0
u8 Snd = 0
u8 K = 0
u8 NStep = 0           ' ball pixels this frame (never K: Probe uses K)
u8 Q = 0
u8 Cx = 0
u8 Cy = 0
u8 Cnt = 0
u8 Menu = 0
u8 Th = 0
u8 TA = 0
u8 TB = 0
u16 Src = 0
u16 Dst = 0
u8 TiX = 0
u8 TiDir = 0
u8 TiT = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title

' per level (1-8, then the last value)
data SpdT bytes 88,96,100,104,124,140,156,170
' the title ball's hop: height above the bat, 32 frames
data HopT bytes 0,5,9,13,16,19,21,22,23,24,24,24,23,22,21,19,17,15,13,11,9,7,5,3,1,0,0,0,0,0,0,0

' ================================================================== program
  tile screen
  set sound table BaSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $B0A7
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Chances = 11 - StartLv
  Score = 0

new_level:
  NewLevel
  StartMusic

new_serve:
  NewServe

play_loop:
  Frame1
  Phase = 1
  ReadPad
  MoveBat
  if Serving = 1 then
    inc ServeT
    if Press = 1 then ServeT = 150
    if ServeT >= 150 then Launch
  else
    SpdAcc += Spd
    NStep = SpdAcc >> 6
    SpdAcc = SpdAcc & 63
    while NStep > 0
      StepBall
      dec NStep
      if Gone = 1 then NStep = 0
      if Done = 1 then NStep = 0
    end while
  end if
  DrawBall
  DrawBat
  Effects
  if Gone = 1 then goto missed
  if Done = 1 then goto finished
  goto play_loop

' ------------------------------------------------------------ the book's MISS
missed:
  Phase = 0
  play sound SndBoom
  play sound SndFall
  SparkK = SpBoom
  SparkX = BallX - 5
  SparkY = 170
  hide sprite 0
  hide sprite 1
  for Cnt = 1 to 40
    Frame1
    K = Cnt & 16
    V = SpBoom
    set sprite 2 to SparkY,SparkX,V,9
    if K = 0 then set sprite 2 to SparkY,SparkX,V,11
    update sprites
  next
  hide sprite 2
  update sprites
  SparkT = 0
  dec Chances
  DrawHud
  if Chances = 0 then
    GameOver
    goto title
  end if
  for Cnt = 1 to 30
    Frame1
    DrawBall
  next
  goto new_serve

' ------------------------------------------------------------ the book's FINISH
finished:
  Phase = 0
  StopMusic
  play sound SndClear
  Score += 100
  Panel
  print at 10,17, "WELL DONE!"
  print at 11,18, "LEVEL"
  print Level at 17,18 width 2
  DrawHud
  for Cnt = 1 to 200
    Frame1
    ' fireworks along the goal line
    K = Cnt & 15
    if K = 0 then
      Rnd
      SparkX = R2 % 190
      SparkX += 28
      SparkY = 10
      SparkT = 12
      SparkK = SpSpark0
    end if
    Effects
    DrawBall
    ReadPad
    if Cnt > 90 then
      if Press = 1 then Cnt = 200
    end if
  next
  HideSprites
  if Level < 99 then inc Level
  if Chances < MAXCH then inc Chances
  goto new_level

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ screens
' mode 2: every third has its own patterns and colours (art.py); the BIOS
' font from `tile screen` stays in the pattern tables, its colours are set
' per third (white / light yellow / cyan on that third's sky)
sub SetupScreen:
  BlankScreen
  tile screen
  mode 2 screen
  nmi off
  display off
  sprites 16x16
  sprites flicker off
  HideSprites
  sprites flicker off
  copy Ba0Pat count BaBytes to vram.pattern + 1024
  copy Ba0Col count BaBytes to vram.color + 1024
  copy Ba1Pat count BaBytes to vram.pattern + 3072
  copy Ba1Col count BaBytes to vram.color + 3072
  copy Ba2Pat count BaBytes to vram.pattern + 5120
  copy Ba2Col count BaBytes to vram.color + 5120
  for J = 0 to 127
    Dst = J * 8
    copy FontCol count 8 to vram.color + Dst
    Dst += 2048
    copy FontCol + 8 count 8 to vram.color + Dst
    Dst += 2048
    copy FontCol + 16 count 8 to vram.color + Dst
  next
  backdrop black
  cls
  return
end sub

' a new level: the frame, the book's rows of bricks, the orbs
sub NewLevel:
  SetupScreen
  K = Level
  if K > 8 then K = 8
  dec K
  Spd = SpdT[K]
  Rows = Level + 2
  if Rows > 6 then Rows = 6
  OrbHp = 2
  if Level >= 3 then OrbHp = 3
  if Level >= 5 then OrbHp = 4
  ' v2: the narrow bat from level 5
  BatW = 24
  if Level >= 5 then BatW = 16
  ' v2.2: the bat's tiles must never reach the wall column 29
  ' (4 tiles from X >> 3: X <= 207; narrow, 3 tiles: X <= 214)
  BatMax = 207
  if BatW = 16 then BatMax = 214
  BatMid = BatW >> 1
  for Idx = 0 to 337
    Map[Idx] = 0
  next
  ' v2.2: one look. The HUD band (rows 0-1): third 0's font white on dark
  ' blue; the rest of third 0 is filled with the black 'void' tile
  for J = 0 to 127
    Dst = J * 8
    copy FontHud count 8 to vram.color + Dst
  next
  for Cy = 2 to 7
    fill BaVoid count 32 at 0,Cy
  next
  ' walls (columns 2 and 29), the goal line (row 2), the pit (row 22)
  for Cy = 2 to 21
    put char BaWall at 2,Cy
    put char BaWall at 29,Cy
  next
  for Cx = 3 to 28
    put char BaGoal0 at Cx,2
  next
  for Cx = 2 to 29
    put char BaPit0 at Cx,22
  next
  ' bricks: rows 3 .. Rows + 2
  for Cy = 3 to Rows + 2
    K = Cy - 2
    Idx = Cy - 3
    Idx = Idx * MAPW
    V = BaBrick1 + Cy
    V -= 3
    for Cx = 3 to 28
      Map[Idx] = K
      put char V at Cx,Cy
      inc Idx
    next
  next
  ' 16 orbs in rows Rows + 4 .. Rows + 9 (the book: 2*SKILL+3+FNR(6))
  for Cnt = 1 to 16
neworb:
    Rnd
    Cx = R2 % 26
    Rnd
    Cy = R2 % 6
    Cy += Rows
    Cy += 1
    Idx = Cy * MAPW
    Idx += Cx
    V = Map[Idx]
    if V <> 0 then goto neworb
    V = 16 + OrbHp
    Map[Idx] = V
    Cx += 3
    Cy += 3
    OrbTile
  next
  ' v2: unbreakable steel bricks from level 3 (2 a level, 8 at most),
  ' never in the bottom brick row, never two above each other
  Steel = 0
  if Level >= 3 then
    Steel = Level - 2
    Steel = Steel << 1
    if Steel > 8 then Steel = 8
  end if
  while Steel > 0
    Rnd
    Cx = R2 % 26
    Rnd
    Cy = Rows - 1
    Cy = R2 % Cy
    Idx = Cy * MAPW
    Idx += Cx
    V = Map[Idx]
    if V < 7 then
      Q = 1
      if Cy > 0 then
        Idx -= MAPW
        V = Map[Idx]
        if V = 7 then Q = 0
        Idx += MAPW
      end if
      Idx += MAPW
      V = Map[Idx]
      if V = 7 then Q = 0
      Idx -= MAPW
      if Q = 1 then
        Map[Idx] = 7
        Cx += 3
        Cy += 3
        put char BaSteel at Cx,Cy
        dec Steel
      end if
    end if
  end while
  Bricks = 0
  Bounces = 0
  SparkT = 0
  BatX = 104
  OldBat = 0
  fill 32 count 26 at 3,20
  DrawBat
  DrawHud
  print at 12,17, "LEVEL"
  print Level at 18,17 width 2
  print at 12,18, "READY!"
  ShowScreen
  play sound SndStart
  for Cnt = 1 to 90
    Frame1
    Effects
  next
  fill 32 count 26 at 3,17
  fill 32 count 26 at 3,18
  return
end sub

' the orb at Cx,Cy (map value V) on screen
sub OrbTile:
  Q = V - 16
  K = BaOrb1
  if Q = 2 then K = BaOrb2
  if Q >= 3 then K = BaOrb3
  put char K at Cx,Cy
  return
end sub

sub DrawHud:
  print at 2,1, "LV"
  print Level at 4,1 width 2
  HudIcons(BaHball, BaHempty, Chances, MAXCH, 7, 1)
  print Score at 24,1 width 6
  return
end sub

' ------------------------------------------------------------ a serve
sub NewServe:
  Serving = 1
  ServeT = 0
  Gone = 0
  Done = 0
  DirY = 1
  XAcc = 0
  SpdAcc = 0
  Slope = 128
  BallX = BatX + BatMid
  BallX -= 3
  BallY = BATY - 6
  play sound SndStart
  DrawBall
  return
end sub

sub Launch:
  Serving = 0
  Rnd
  DirX = R2 & 1
  ' a moving bat sends the ball its way
  if Lf1 = 1 then DirX = 1
  if Rt1 = 1 then DirX = 0
  Slope = 110
  play sound SndBat
  return
end sub

' ------------------------------------------------------------ the bat
' 3 px a frame, 4 after 6 frames held, 5 after 14
sub MoveBat:
  if Lf1 = 0 then
    if Rt1 = 0 then
      HeldT = 0
      return
    end if
  end if
  if HeldT < 255 then inc HeldT
  BatV = 3
  if HeldT > 6 then BatV = 4
  if HeldT > 14 then BatV = 5
  if Lf1 = 1 then
    if BatX < BatV + 24 then
      BatX = 24
    else
      BatX -= BatV
    end if
  end if
  if Rt1 = 1 then
    BatX += BatV
    if BatX > BatMax then BatX = BatMax
  end if
  if BatW = 16 then BatX = BatX & 254
  if Serving = 1 then
    BallX = BatX + BatMid
    BallX -= 3
  end if
  return
end sub

' the bat is 4 tiles on row 20, pre-shifted by art.py (shift = X & 7)
sub DrawBat:
  if BatX = OldBat then return
  OldBat = BatX
  Cx = BatX >> 3
  Q = Cx - 1
  if Q >= 3 then put char 32 at Q,20
  if BatW = 16 then
    ' the narrow bat: 3 tiles, even shifts only (art.py)
    K = BatX & 6
    K = K >> 1
    K = K * 3
    V = BaNb00 + K
    PutRun(V, 3, Cx, 20)
    Q = Cx + 3
  else
    K = BatX & 7
    K = K << 2
    V = BaBat00 + K
    PutRun(V, 4, Cx, 20)
    Q = Cx + 4
  end if
  if Q <= 28 then put char 32 at Q,20
  return
end sub

' ------------------------------------------------------------ the ball
sub DrawBall:
  V = BallY - 1
  set sprite 0 to V,BallX,SpBall0,SpBallC0
  set sprite 1 to V,BallX,SpBall1,SpBallC1
  update sprites
  return
end sub

' one pixel of the ball's path: up/down by one, then maybe left/right by one
sub StepBall:
  ' ---- vertical
  if DirY = 1 then
    dec BallY
    Qy = BallY
  else
    inc BallY
    Qy = BallY + 5
  end if
  Qx = BallX
  Probe
  if Hit = 0 then
    Qx = BallX + 5
    Probe
  end if
  if Hit = 1 then
    if DirY = 1 then
      inc BallY
    else
      dec BallY
    end if
    DirY = DirY ^ 1
  end if
  ' the top: the book's FINISH
  if BallY < 17 then
    Done = 1
    return
  end if
  ' the bat
  if DirY = 0 then
    Q = BallY + 5
    if Q = BATY then BatHit
  end if
  ' the pit: the book's MISS
  if BallY >= 182 then
    Gone = 1
    return
  end if
  ' ---- horizontal
  XT = XAcc + Slope
  if XT < 256 then
    XAcc = XT
    return
  end if
  XT -= 256
  XAcc = XT
  if DirX = 0 then
    inc BallX
    if BallX > BXMAX then
      BallX = BXMAX
      DirX = 1
      play sound SndWall
      return
    end if
    Qx = BallX + 5
  else
    dec BallX
    if BallX < BXMIN then
      BallX = BXMIN
      DirX = 0
      play sound SndWall
      return
    end if
    Qx = BallX
  end if
  Qy = BallY
  Probe
  if Hit = 0 then
    Qy = BallY + 5
    Probe
  end if
  if Hit = 1 then
    if DirX = 0 then
      dec BallX
    else
      inc BallX
    end if
    DirX = DirX ^ 1
  end if
  return
end sub

' the ball's bottom reaches the bat's top: bounce if they overlap; the
' angle comes from where it hits (centre steep, edges wide)
sub BatHit:
  Q = BallX + 5
  if Q < BatX then return
  Q = BatX + BatW
  dec Q
  if BallX > Q then return
  DirY = 1
  inc Bounces
  Cx = BallX + 3
  Cy = BatX + BatMid
  if Cx < Cy then
    Q = Cy - Cx
    if Q >= 3 then DirX = 1
  else
    Q = Cx - Cy
    if Q >= 3 then DirX = 0
  end if
  ' Q = 0..15 from the centre
  if Q > 15 then Q = 15
  V = Q * 10
  Slope = 96 + V
  play sound SndBat
  return
end sub

' is the pixel Qx,Qy in a brick or an orb? Hit = 1, and the cell reacts
sub Probe:
  Hit = 0
  Row = Qy >> 3
  if Row < 3 then return
  if Row > 15 then return
  Col = Qx >> 3
  Idx = Row - 3
  Idx = Idx * MAPW
  Idx += Col
  Idx -= 3
  V = Map[Idx]
  if V = 0 then return
  Hit = 1
  Cx = Col
  Cy = Row
  if V = 7 then
    ' steel (v2): only a clink
    play sound SndWall
    return
  end if
  if V < 16 then
    ' a brick: gone (the book: PLOT X,V,32)
    Map[Idx] = 0
    put char BaVoid at Cx,Cy
    Score += 10
    inc Bricks
    play sound SndBrick
  else
    dec V
    Map[Idx] = V
    if V = 16 then
      Map[Idx] = 0
      put char BaVoid at Cx,Cy
      Score += 20
    else
      OrbTile
      Score += 5
    end if
    play sound SndOrb
  end if
  SparkX = Cx << 3
  SparkX -= 4
  SparkY = Cy << 3
  SparkY -= 5
  SparkT = 10
  SparkK = SpSpark0
  DrawHudScore
  return
end sub

sub DrawHudScore:
  print Score at 24,1 width 6
  return
end sub

' sparks fade; the goal chevrons climb, the pit glows, the orbs glint
sub Effects:
  if SparkT > 0 then
    dec SparkT
    V = SparkK
    if SparkT < 5 then
      if SparkK = SpSpark0 then V = SpSpark1
    end if
    set sprite 2 to SparkY,SparkX,V,11
    if SparkT = 0 then hide sprite 2
    update sprites
  end if
  K = Tick & 15
  if K = 0 then
    ' goal frame (third 0): pattern and colour of goal0 or goal1
    TA = BaGoal0
    TB = BaGoal0
    V = Tick & 16
    if V = 0 then TB = BaGoal1
    Th = 0
    SwapTile
  end if
  if K = 8 then
    TA = BaPit0
    TB = BaPit0
    V = Tick & 16
    if V = 0 then TB = BaPit1
    Th = 2
    SwapTile
  end if
  if K = 4 then
    V = Tick & 48
    if V = 0 then
      TB = BaOrb3b
    else
      TB = BaOrb3
    end if
    if V < 32 then
      TA = BaOrb3
      Th = 0
      SwapTile
      Th = 1
      SwapTile
    end if
  end if
  return
end sub

' copy tile TB's pattern and colour (third Th) into tile code TA
sub SwapTile:
  Src = TB - 128
  Src = Src << 3
  Dst = Th * 2048
  Dst += TA * 8
  if Th = 0 then
    copy Ba0Pat + Src count 8 to vram.pattern + Dst
    copy Ba0Col + Src count 8 to vram.color + Dst
  end if
  if Th = 1 then
    copy Ba1Pat + Src count 8 to vram.pattern + Dst
    copy Ba1Col + Src count 8 to vram.color + Dst
  end if
  if Th = 2 then
    copy Ba2Pat + Src count 8 to vram.pattern + Dst
    copy Ba2Col + Src count 8 to vram.color + Dst
  end if
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ messages
' a band between the orbs and the bat (rows 16-19, columns 3-28)
sub Panel:
  for Cy = 16 to 19
    fill 32 count 26 at 3,Cy
  next
  for Cx = 3 to 28
    put char BaBrick5 at Cx,16
    put char BaBrick5 at Cx,19
  next
  return
end sub

sub GameOver:
  StopMusic
  play sound SndOver
  Panel
  print at 10,17, "GAME OVER"
  print at 6,18, "LV"
  print Level at 8,18 width 2
  print Score at 15,18 width 6
  for Cnt = 1 to 90
    Frame1
    Effects
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  HideSprites
  return
end sub

' ------------------------------------------------------------ text screens
' a strip of bricks on row Cy (for the pages)
sub BrickStrip:
  for Cx = 2 to 29
    K = Cx % 6
    V = BaBrick1 + K
    put char V at Cx,Cy
  next
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub CreditsScreen:
  SetupScreen
  PageCredits
  Cy = 18
  BrickStrip
  put char BaOrb3 at 8,20
  put char BaOrb2 at 23,20
  PutRun(BaBat30, 4, 14, 21)
  ShowScreen
  set sprite 0 to 158,131,SpBall0,SpBallC0
  set sprite 1 to 158,131,SpBall1,SpBallC1
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub HelpScreens:
  SetupScreen
  PageHelp1
  Cy = 16
  BrickStrip
  put char 32 at 15,16
  put char 32 at 16,16
  for Cx = 5 to 26 step 5
    put char BaOrb3 at Cx,18
  next
  put char BaOrb1 at 20,18
  PutRun(BaBat00, 4, 13, 20)
  ShowScreen
  set sprite 0 to 148,124,SpBall0,SpBallC0
  set sprite 1 to 148,124,SpBall1,SpBallC1
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  SetupScreen
  PageHelp2
  PutRun(BaBat01, 2, 2, 3)
  put char BaBrick1 at 3,7
  put char BaBrick4 at 4,7
  put char BaOrb3 at 3,9
  put char BaOrb2 at 4,9
  put char BaHball at 2,11
  put char BaHball at 3,11
  put char BaHempty at 4,11
  put char BaGoal0 at 3,13
  put char BaGoal0 at 4,13
  ShowScreen
  set sprite 0 to 35,26,SpBall0,SpBallC0
  set sprite 1 to 35,26,SpBall1,SpBallC1
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  SetupScreen
  for Y = 0 to Logo1H - 1
    V = Y * Logo1W
    J = Y + 1
    put Logo1 + V count Logo1W at 7,J
  next
  for Y = 0 to Logo2H - 1
    V = Y * Logo2W
    J = Y + 4
    put Logo2 + V count Logo2W at 10,J
  next
  ' stars around the logo
  put char BaStar at 4,2
  put char BaStar2 at 7,5
  put char BaStar at 27,1
  put char BaStar2 at 26,5
  put char BaStar2 at 3,6
  put char BaStar at 23,7
  put char BaStar at 6,7
  Cy = 8
  BrickStrip
  ' menu (rows 14-20)
  print at 11,14, "START"
  print at 11,16, "LEVEL"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowLevelChoice
  TiX = 40
  TiDir = 0
  TiT = 0
  BatX = 31
  OldBat = 0
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLv > 1 then dec StartLv
      end if
      if Rt1 = 1 then
        if StartLv < 4 then inc StartLv
      end if
      ShowLevelChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLevelChoice:
  print at 18,16, "< >"
  put char StartLv + 48 at 19,16
  return
end sub

' the ball hops along over the bat (row 13), which follows it; the cursor
' (a ball) points at the menu line; the goal chevrons climb
sub TitleAnim:
  V = Menu << 4
  V += 107
  set sprite 2 to V,72,SpBall0,15
  ' across, 1 px a frame, turning at the walls
  if TiDir = 0 then
    inc TiX
    if TiX >= 220 then TiDir = 1
  else
    dec TiX
    if TiX <= 20 then TiDir = 0
  end if
  inc TiT
  TiT = TiT & 31
  V = HopT[TiT]
  Q = 100 - V
  dec Q
  set sprite 0 to Q,TiX,SpBall0,SpBallC0
  set sprite 1 to Q,TiX,SpBall1,SpBallC1
  update sprites
  if TiT = 0 then play sound SndBat
  ' the bat (tiles, row 13) catches up with the ball
  Cx = TiX - 9
  if Cx < 8 then Cx = 8
  if Cx > 216 then Cx = 216
  if BatX < Cx then inc BatX
  if BatX > Cx then dec BatX
  if BatX = OldBat then return
  OldBat = BatX
  Cx = BatX >> 3
  K = BatX & 7
  K = K << 2
  V = BaBat00 + K
  Q = Cx - 1
  put char 32 at Q,13
  PutRun(V, 4, Cx, 13)
  Q = Cx + 4
  put char 32 at Q,13
  return
end sub

' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 10,2, "BOUNCE AWAY"
  print at 8,5, "ORIGINAL GAME BY"
  print at 8,6, "CZES KOSNIOWSKI"
  print at 2,8, "GAMES TO PLAY ON YOUR ORIC-1"
  print at 9,9, "(SHIVA, 1983)"
  print at 6,12, "COLECOVISION VERSION"
  print at 7,14, "AMY & CLAUDE 2026"
  print at 2,16, "MADE IN AMY WITH AMY STUDIO"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp1:
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "BOUNCE THE BALL WITH YOUR"
  print at 2,4, "BAT UNTIL IT REACHES THE"
  print at 2,5, "TOP OF THE SCREEN."
  print at 2,7, "EACH COLOURED BRICK IT HITS"
  print at 2,8, "DISAPPEARS. THE ORBS CRACK"
  print at 2,9, "AND VANISH AFTER A FEW HITS."
  print at 2,11, "THE BALL BOUNCES OFF THE"
  print at 2,12, "SIDES, THE BRICKS, THE ORBS"
  print at 2,13, "AND YOUR BAT. DON'T LET IT"
  print at 2,14, "FALL INTO THE PIT!"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp2:
  print at 8,1, "HOW TO PLAY  2/2"
  print at 6,3, "JOYSTICK: MOVE THE BAT"
  print at 6,5, "BUTTON: SERVE THE BALL"
  print at 6,7, "BRICKS: BREAK THROUGH"
  print at 6,9, "ORBS: HIT THEM TO CRACK"
  print at 6,11, "BALLS LEFT"
  print at 6,13, "THE GOAL: REACH IT!"
  print at 2,16, "HIT THE BALL WITH THE EDGE"
  print at 2,17, "OF THE BAT TO SEND IT OFF"
  print at 2,18, "AT A WIDER ANGLE."
  print at 2,20, "LEVELS: MORE BRICKS, FASTER."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

