  print at 6,15, "21-100 CRASH LANDING"
  print at 6,17, "OVER 100: EXPLODED!"
  print at 2,19, "EACH LEVEL: MORE GRAVITY,"
  print at 2,20, "LESS FUEL, STRONGER WIND."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

asm {
; generated by kit/os7music.py from title.txt, game.txt - do not edit by hand
; use: set sound table MoSoundTable areas 7
; songs share the music areas: stop one song before starting another
; merged 2 scores: table 2322 bytes (18 entries, 7 areas)
;   Quiet Sea: loop 1152 frames
;   Tranquility: loop 224 frames (plays once)
;   SndMtLead        MtLead           $702B music    395 bytes   1152 frames
;   SndMtTwo         MtTwo            $7035 music    769 bytes   1152 frames
;   SndMtNoise       MtNoise          $703F music    474 bytes   1152 frames
;   SndMtPitch       MtPitch          $7049 music     53 bytes   1152 frames
;   SndMgLead        MgLead           $702B music    121 bytes    224 frames
;   SndMgTwo         MgTwo            $7035 music    175 bytes    224 frames
;   SndMgNoise       MgNoise          $703F music    129 bytes    224 frames
;   SndMgPitch       MgPitch          $7049 music     17 bytes    224 frames
;   SndPing          SfxPing          $705D effect     7 bytes     40 frames
;   SndLow           SfxLow           $7067 effect    10 bytes     15 frames
;   SndDry           SfxDry           $7067 effect     7 bytes     20 frames
;   SndThud          SfxThud          $7053 effect     6 bytes      4 frames
;   SndOk            SfxOk            $705D effect    13 bytes     42 frames
