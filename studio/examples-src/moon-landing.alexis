;   SndFall          SfxFall          $705D effect     9 bytes     30 frames
;   SndBoom          SfxBoom          $7053 effect    10 bytes     76 frames
;   SndMiss          SfxMiss          $7067 effect    12 bytes     33 frames
;   SndOver          SfxOver          $705D effect    31 bytes    180 frames
MoSoundTable:
    dw MtLead,$702B
    dw MtTwo,$7035
    dw MtNoise,$703F
    dw MtPitch,$7049
    dw MgLead,$702B
    dw MgTwo,$7035
    dw MgNoise,$703F
