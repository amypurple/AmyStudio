const SndMtLead = 1
const SndMtTwo = 2
const SndMtNoise = 3
const SndMtPitch = 4
const SndMgLead = 5
const SndMgTwo = 6
const SndMgNoise = 7
const SndMgPitch = 8
const SndPing = 9
const SndLow = 10
const SndDry = 11
const SndThud = 12
const SndOk = 13
const SndCrunch = 14
const SndFall = 15
const SndBoom = 16
const SndMiss = 17
const SndOver = 18
const MtAreas = 7
const MtLoopFrames = 1152
const MgLoopFrames = 224

' ---------------------------------------------------------------- constants
const GroundY = 135     ' the module's sprite y when its feet touch row 19
const XMin = 48         ' the module's left x range (playfield cols 6-21)
const XMax = 160
const H0 = 40780        ' height 1990 shown (40960 = 2000)
const V0 = 4096         ' speed 10 (16 bar pixels)
const Fu0 = 40960       ' a full tank (160 bar pixels)
const ColV = 3          ' gauge columns (two each)
const ColH = 23
const ColF = 27

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u16 Vel = 0             ' speed: bar pixels in the high byte (160 = speed 100)
u16 Hgt = 0             ' height: 40960 = 2000 shown
u16 Fu = 0              ' fuel: 40960 = full
u16 Xf = 0              ' the module's left x, 8.8
u16 D16 = 0
u16 Score = 0
u16 Shown = 0
u16 Grav = 0
u16 Thr = 0
u16 Burn = 0
u16 SBurn = 0
u16 Wind = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 HF = 0               ' height fraction
u8 Lv = 0               ' speed in bar pixels
u8 Lh = 0
u8 Lf = 0
u8 OV = 0               ' the gauges as drawn
u8 OH = 0
u8 OF = 0
u8 Lx = 0               ' the module's left x (pixels)
u8 Ys = 0               ' its sprite y
u8 WDir = 0             ' 0 = wind to the right
u8 PadC = 0             ' the pad's first column
u8 PadX = 0
u8 Level = 1
u8 StartLv = 1
u8 Lives = 3
u8 Done = 0             ' 1 well done, 2 not bad, 3 crash, 4 explode, 5 missed
u8 Thrust = 0
u8 Side = 0             ' 0 none, 1 jet on the left (moving right), 2 on the right
u8 FlF = 0
u8 LowW = 0             ' low-fuel warnings given
u8 EngOn = 0
u8 EnLo = 0
u8 EnHi = 0
u8 EnA = 0
u8 Bk = 0               ' bar drawing
u8 Bc = 0
u8 Bn = 0
u8 Bx = 0
u8 Bf = 0
u8 B0 = 0
u8 B1 = 0
u8 Bt = 0
u8 K = 0
u8 Cnt = 0
u8 Menu = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title
u8 Tx = 0
u8 Ty = 0
u8 Tf = 0
u8 Tw = 0
u8 Gx2 = 0
u8 Gy2 = 0
u8 Res = 0

' per level (1-8, then the last): gravity, thrust, burn (min, spread),
' wind (1/256 px a frame), start offset from the pad (px)
data GravT bytes 80,84,86,90,94,98,102,106
data ThrT bytes 200,200,198,194,192,190,190,190
data BurnT bytes 28,32,34,38,42,46,48,50
data BSprT bytes 0,6,6,8,10,10,12,14
data WindT bytes 0,0,6,10,14,18,22,26
data OffT bytes 0,24,32,40,40,48,48,56
' sky stars (playfield): col,row pairs
data Stars bytes 7,3, 10,6, 13,2, 16,9, 20,5, 8,12, 12,14, 19,13, 15,4, 21,11, 6,8, 11,10, 17,15, 9,16
' title stars
data TStars bytes 1,1, 5,9, 17,1, 22,6, 30,9, 27,7, 13,8, 2,11, 20,10, 29,5, 18,6, 8,10

' ================================================================== program
  tile screen
  set sound table MoSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $5EA1
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Lives = 3
  Score = 0

new_round:
  NewRound
  play sound SndPing

play_loop:
  Frame1
  Phase = 1
  Engine
  ReadPad
  Physics
  DrawLander
  Gauges
  Beacons
  if Done > 0 then goto touchdown
  goto play_loop

' ------------------------------------------------------------ the end of a descent
touchdown:
  Phase = 0
  EngineOff
  Thrust = 0
  Side = 0
  Gauges
  ShowAll
  if Done <= 2 then goto landed
  ' crash, explosion or off the pad: the book's EXPLODE and paper flashes
  play sound SndCrunch
  if Done = 4 then play sound SndBoom
  if Done = 3 then play sound SndFall
  if Done = 5 then play sound SndMiss
  hide sprite 2
  hide sprite 3
  fill 32 count 16 at 6,9
  if Done = 3 then print at 7,9, "CRASH LANDING!"
  if Done = 4 then print at 7,9, "TOO FAST: BOOM!"
  if Done = 5 then print at 6,9, "MISSED THE PAD!"
  ' flashes: the book's INT(V/10)+1, at most 3, one colour every 20 frames (1.5 Hz)
  Tf = Lv >> 4
  inc Tf
  if Tf > 3 then Tf = 3
  Tw = 0
  for Cnt = 1 to 150
    Frame1
    Boom
    Beacons
    V = Cnt % 20
    if V = 1 then
      if Tw < Tf then
        V = Cnt / 20
        V = V & 1
        if V = 0 then
          backdrop dark red
        else
          backdrop black
          inc Tw
        end if
      end if
    end if
  next
  backdrop black
  HideSprites
  dec Lives
  DrawHud
  if Lives > 0 then goto new_round
  GameOver
  goto title

landed:
  play sound SndThud
  hide sprite 2
  hide sprite 3
  DrawLanderAt
  ' bonus: 100 (well done) or 50, plus the fuel left, times the level
  D16 = 50
  if Done = 1 then D16 = 100
  Shown = Fu >> 9
  D16 += Shown
  K = Level
  if K > 9 then K = 9
  D16 = D16 * K
  Score += D16
  ShowScore
  fill 32 count 16 at 6,9
  if Done = 1 then
    print at 9,9, "WELL DONE!"
    PlayFanfare
  else
    print at 10,9, "NOT BAD"
    play sound SndOk
  end if
  print at 8,11, "BONUS"
  print D16 at 14,11 width 5
  for Cnt = 1 to 200
    Frame1
    Beacons
  next
  StopMusic
  HideSprites
  if Level < 99 then inc Level
  goto new_round

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ tiles
sub LoadMo:
  fill mode 2 text color with $F0
  copy MoPat count MoBytes to vram.pattern + 1024
  copy MoCol count MoBytes to vram.color + 1024
  copy MoPat count MoBytes to vram.pattern + 3072
  copy MoCol count MoBytes to vram.color + 3072
  copy MoPat count MoBytes to vram.pattern + 5120
  copy MoCol count MoBytes to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub LoadTi:
  fill mode 2 text color with $F0
  copy TiPat count TiBytes to vram.pattern + 1024
  copy TiCol count TiBytes to vram.color + 1024
  copy TiPat count TiBytes to vram.pattern + 3072
  copy TiCol count TiBytes to vram.color + 3072
  copy TiPat count TiBytes to vram.pattern + 5120
  copy TiCol count TiBytes to vram.color + 5120
  backdrop black
  cls
  return
end sub

' ------------------------------------------------------------ the gauges
' one cell of bar Bk (0 velocity, 1 height, 2 fuel) at column Bx: cell Bc
' (0 = bottom, row 21) lit up to Bn pixels
sub BarCell:
  Bf = Bc << 3
  if Bn <= Bf then
    Bf = 0
  else
    Bf = Bn - Bf
    if Bf > 8 then Bf = 8
  end if
  if Bk = 0 then Bt = VCell[Bc]
  if Bk = 1 then Bt = HCell[Bc]
  if Bk = 2 then Bt = FCell[Bc]
  Bt += Bf
  Y = 21 - Bc
  put char Bt at Bx,Y
  X = Bx + 1
  put char Bt at X,Y
  return
end sub

' redraw the cells between the old value B0 and the new one Bn
sub BarMove:
  B1 = B0
  if Bn < B1 then
    B1 = Bn
    B0 = B0 >> 3
  else
    B0 = Bn >> 3
  end if
  B1 = B1 >> 3
  if B0 > 19 then B0 = 19
  for Bc = B1 to B0
    BarCell
  next
  return
end sub

sub BarAll:
  for Bc = 0 to 19
    BarCell
  next
  return
end sub

sub Gauges:
  Lh = highbyte Hgt
  Lf = highbyte Fu
  Bn = Lv
  if Bn > 160 then Bn = 160
  if Bn <> OV then
    Bk = 0
    B0 = OV
    Bx = ColV
    OV = Bn
    BarMove
  end if
  if Lh <> OH then
    Bk = 1
    Bn = Lh
    B0 = OH
    Bx = ColH
    BarMove
    OH = Lh
  end if
  if Lf <> OF then
    Bk = 2
    Bn = Lf
    B0 = OF
    Bx = ColF
    BarMove
    OF = Lf
  end if
  ' one readout a frame, in turn
  K = Tick & 3
  if K = 0 then ShowSpeed
  if K = 1 then ShowHeight
  if K = 2 then ShowFuel
  return
end sub

' the readouts under the gauges (the book's row 26)
sub ShowSpeed:
  ' shown speed = ceil(pixels * 5 / 8)
  Shown = Lv
  Shown = Shown * 5
  Shown += 7
  Shown = Shown >> 3
  print Shown at 2,22 width 3
  return
end sub

sub ShowHeight:
  Shown = Hgt >> 4
  Shown = Shown * 25
  Shown = Shown >> 5
  print Shown at 22,22 width 4
  return
end sub

sub ShowFuel:
  Shown = Lf
  Shown = Shown * 5
  Shown += 7
  Shown = Shown >> 3
  print Shown at 27,22 width 3
  return
end sub

sub ShowAll:
  ShowSpeed
  ShowHeight
  ShowFuel
  return
end sub

sub ShowScore:
  print Score at 25,1 width 5
  return
end sub

' ------------------------------------------------------------ a new descent
sub NewRound:
  BlankScreen
  sprites flicker off
  LoadMo
  K = Level
  if K > 8 then K = 8
  dec K
  Grav = GravT[K]
  Thr = ThrT[K]
  Burn = BurnT[K]
  V = BSprT[K]
  if V > 0 then
    Rnd
    inc V
    V = R2 % V
    Burn += V
  end if
  SBurn = Burn >> 3
  Wind = WindT[K]
  Rnd
  WDir = R2 & 1
  ' the pad: columns 7-18 (three cells)
  Rnd
  V = R2 % 12
  PadC = V + 7
  PadX = PadC << 3
  ' the module starts over the pad, or OffT pixels to one side
  V = OffT[K]
  Lx = PadX + 4
  if V > 0 then
    Rnd
    J = R2 & 1
    if J = 0 then
      Lx += V
      if Lx > XMax then Lx = XMax
    else
      if Lx < V then
        Lx = XMin
      else
        Lx -= V
      end if
      if Lx < XMin then Lx = XMin
    end if
  end if
  Xf = Lx * 256
  Vel = V0
  Hgt = H0
  Fu = Fu0
  HF = 0
  Lv = highbyte Vel
  Done = 0
  Thrust = 0
  Side = 0
  LowW = 0
  DrawField
  ' gauges as they start
  Bk = 0
  Bn = Lv
  Bx = ColV
  BarAll
  OV = Lv
  Bk = 1
  Bn = highbyte Hgt
  Bx = ColH
  BarAll
  OH = Bn
  Bk = 2
  Bn = highbyte Fu
  Bx = ColF
  BarAll
  OF = Bn
  Lh = OH
  Lf = OF
  ShowAll
  DrawHud
  ShowScreen
  DrawLander
  ' the level, a moment over the moonscape
  print at 10,8, "LEVEL"
  print Level at 16,8 width 2
  for Cnt = 1 to 90
    Frame1
    Beacons
    DrawLander
  next
  fill 32 count 8 at 10,8
  ' put back the stars the text covered
  Stars1
  return
end sub

sub Stars1:
  for K = 0 to 13
    J = K << 1
    X = Stars[J]
    inc J
    Y = Stars[J]
    V = K % 3
    V += MoStar0
    put char V at X,Y
  next
  return
end sub

sub DrawField:
  Stars1
  PutRun(MoEarth00, 2, 18, 3)
  PutRun(MoEarth10, 2, 18, 4)
  for X = 6 to 21
    V = X - 6
    V = V & 3
    K = V + MoMnt00
    put char K at X,17
    K = V + MoMnt10
    put char K at X,18
    V = X & 1
    K = V + MoGround0
    put char K at X,19
    K = V + MoRego0
    put char K at X,20
    V = V ^ 1
    K = V + MoRego0
    put char K at X,21
  next
  ' craters away from the pad
  Rnd
  V = R2 % 14
  V += 6
  put char MoCrat0 at V,21
  inc V
  put char MoCrat1 at V,21
  PutRun(MoPad0, 3, PadC, 19)
  put char MoBeacon1 at PadC,18
  V = PadC + 2
  put char MoBeacon1 at V,18
  ' labels (the book's vertical words), scales
  for K = 0 to 7
    V = LblV[K]
    Y = K << 1
    Y += 4
    put char V at 2,Y
  next
  for K = 0 to 5
    V = LblH[K]
    Y = K << 1
    Y += 6
    put char V at 22,Y
  next
  for K = 0 to 3
    V = LblF[K]
    Y = K << 1
    Y += 8
    put char V at 26,Y
  next
  put char MoV10 at 5,20
  put char MoV20 at 5,18
  put char MoV50 at 5,12
  put char MoV75 at 5,7
  put char MoVtop at 5,2
  put char MoH5 at 25,17
  put char MoH10 at 25,12
  put char MoH15 at 25,7
  put char MoH20 at 25,2
  put char MoFF at 29,2
  put char MoFH at 29,12
  put char MoFq at 29,17
  put char MoFE at 29,20
  return
end sub

sub DrawHud:
  print at 2,1, "LV"
  print Level at 4,1 width 2
  HudIcons(MoHlife, MoHlost, Lives, 3, 7, 1)
  ' the wind: one arrow per strength step
  K = 0
  if Wind > 0 then K = 1
  if Wind > 10 then K = 2
  if Wind > 18 then K = 3
  V = MoHright
  if WDir = 1 then V = MoHleft
  HudIcons(V, 32, K, 3, 14, 1)
  ShowScore
  return
end sub

' the pad's beacons: on 16 frames, off 16 (under 2 Hz)
sub Beacons:
  V = Tick & 15
  if V <> 0 then return
  V = Tick & 16
  K = MoBeacon1
  if V = 0 then K = MoBeacon0
  put char K at PadC,18
  V = PadC + 2
  put char K at V,18
  return
end sub

' ------------------------------------------------------------ the flight
sub Physics:
  ' gravity, then the retro rocket (the book: VELOCITY+ACCEL, then BRAKES)
  Vel += Grav
  Thrust = 0
  if Btn = 1 then
    if Fu > 0 then
      Thrust = 1
      if Vel > Thr then
        Vel -= Thr
      else
        Vel = 0
      end if
      if Fu > Burn then
        Fu -= Burn
      else
        Fu = 0
        play sound SndDry
      end if
    end if
  end if
  ' side jets and wind
  Side = 0
  if Fu > 0 then
    if Lf1 = 1 then
      Side = 2
      Xf -= 128
    end if
    if Rt1 = 1 then
      Side = 1
      Xf += 128
    end if
    if Side > 0 then
      if Fu > SBurn then
        Fu -= SBurn
      else
        Fu = 0
        play sound SndDry
      end if
    end if
  end if
  if WDir = 0 then
    Xf += Wind
  else
    Xf -= Wind
  end if
  Lx = highbyte Xf
  if Lx < XMin then
    Lx = XMin
    Xf = XMin * 256
  end if
  if Lx > XMax then
    Lx = XMax
    Xf = XMax * 256
  end if
  ' low fuel: a warning at 1/4 and at 1/10
  if LowW = 0 then
    if Fu < 10240 then
      LowW = 1
      play sound SndLow
    end if
  end if
  if LowW = 1 then
    if Fu < 4096 then
      LowW = 2
      play sound SndLow
    end if
  end if
  ' the height drops by the speed (the book: HEIGHT-VELOCITY/100)
  D16 = Vel >> 4
  D16 = D16 * 5
  D16 += HF
  HF = lowbyte D16
  D16 = D16 >> 8
  Lv = highbyte Vel
  if Lv > 160 then
    Done = 4
    return
  end if
  if D16 >= Hgt then
    Hgt = 0
    ' the speed decides (the book's lines 310-340), then the pad
    Done = 3
    if Lv <= 32 then Done = 2
    if Lv <= 16 then Done = 1
    V = Lx + 8
    K = PadX + 2
    if V < K then Done = 5
    K = PadX + 22
    if V > K then Done = 5
    return
  end if
  Hgt -= D16
  return
end sub

' the module's y from the height: 120 pixels of sky for 2000
sub DrawLander:
  Lh = highbyte Hgt
  V = Lh >> 2
  V = Lh - V
  Ys = GroundY - V
  inc FlF
  if FlF >= 9 then FlF = 0
  DrawLanderAt
  return
end sub

sub DrawLanderAt:
  K = SpLmg
  if Side = 1 then K = SpLmgl
  if Side = 2 then K = SpLmgr
  set sprite 0 to Ys,Lx,K,14
  set sprite 1 to Ys,Lx,SpLmy,11
  if Thrust = 1 then
    V = FlF / 3
    V = V << 3
    J = Ys + 8
    K = V + SpFly0
    set sprite 2 to J,Lx,K,11
    K = V + SpFlr0
    set sprite 3 to J,Lx,K,8
  else
    hide sprite 2
    hide sprite 3
  end if
  update sprites
  return
end sub

' the explosion: core and ring grow, then the wreck
sub Boom:
  if Cnt < 8 then
    K = SpBoom0
  else
    if Cnt < 16 then
      K = SpBoom1
    else
      K = SpBoom2
    end if
  end if
  if Cnt < 40 then
    set sprite 0 to Ys,Lx,K,11
    set sprite 1 to Ys,Lx,SpBoom0,9
  else
    ' the wreck falls to the ground, its debris glinting
    if Ys < GroundY then
      Ys += 3
      if Ys > GroundY then Ys = GroundY
    end if
    V = Cnt & 16
    K = 10
    if V = 0 then K = 14
    set sprite 0 to Ys,Lx,SpBits,K
    set sprite 1 to Ys,Lx,SpLmy,6
  end if
  update sprites
  return
end sub

' ------------------------------------------------------------ the engine
' tone 3 muted clocks the white noise: pitch follows the speed (the book:
' SOUND 4,125-VELOCITY/4), louder while the rocket burns. Written right
' after the frame's NMI, so the OS7 sound driver never sees it.
sub Engine:
  V = Lv
  if V > 160 then V = 160
  Shown = 260 - V
  EnLo = lowbyte Shown
  EnLo = EnLo & 15
  EnLo = EnLo | $C0
  Shown = Shown >> 4
  EnHi = lowbyte Shown
  EnA = $F9
  if Thrust = 1 then EnA = $F3
  if Side > 0 then
    if Thrust = 0 then EnA = $F6
  end if
  if EngOn = 0 then
    EngOn = 1
    asm {
      ld a,$DF
      out ($FF),a
      ld a,$E7
      out ($FF),a
    }
  end if
  asm {
    ld a,(EnLo)
    out ($FF),a
    ld a,(EnHi)
    out ($FF),a
    ld a,(EnA)
    out ($FF),a
  }
  return
end sub

sub EngineOff:
  EngOn = 0
  asm {
    ld a,$FF
    out ($FF),a
    ld a,$DF
    out ($FF),a
  }
  return
end sub

' ------------------------------------------------------------ music
sub PlayFanfare:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  ' a panel framed by the pad's plates, cols 7-20, rows 7-13 (the
  ' message row cleared first)
  fill 32 count 16 at 6,9
  for Gx2 = 7 to 20
    put char MoPad1 at Gx2,7
    put char MoPad1 at Gx2,13
  next
  for Gy2 = 8 to 12
    put char MoPad1 at 7,Gy2
    put char MoPad1 at 20,Gy2
    fill 32 count 12 at 8,Gy2
  next
  print at 9,9, "GAME OVER"
  print at 9,11, "LV"
  print Level at 11,11 width 2
  print Score at 14,11 width 5
  play sound SndOver
  for Cnt = 1 to 150
    Frame1
    Beacons
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  LoadMo
  return
end sub

' a strip of moonscape with the pad on row Ty (pad at column Tx)
sub MoonStrip:
  for X = 2 to 29
    V = X & 3
    K = V + MoMnt00
    J = Ty - 2
    put char K at X,J
    K = V + MoMnt10
    inc J
    put char K at X,J
    V = X & 1
    K = V + MoGround0
    put char K at X,Ty
  next
  PutRun(MoPad0, 3, Tx, Ty)
  J = Ty - 1
  put char MoBeacon1 at Tx,J
  V = Tx + 2
  put char MoBeacon1 at V,J
  return
end sub

sub ShowLm(u8 Sy, u8 Sx):
  set sprite 0 to Sy,Sx,SpLmg,14
  set sprite 1 to Sy,Sx,SpLmy,11
  update sprites
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  Ty = 20
  Tx = 21
  MoonStrip
  ShowScreen
  ShowLm(143, 172)
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  put char MoHbtn at 3,7
  put char MoHleft at 2,9
  put char MoHright at 4,9
  put char MoPad0 at 26,12
  put char MoPad1 at 27,12
  put char MoPad2 at 28,12
  ShowScreen
  ' the module with its flame, by the text
  set sprite 0 to 140,200,SpLmg,14
  set sprite 1 to 140,200,SpLmy,11
  set sprite 2 to 148,200,SpFly1,11
  set sprite 3 to 148,200,SpFlr1,8
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  TextScreen
  PageHelp2
  put char MoLVp at 3,5
  put char MoBarsafe8 at 4,5
  put char MoLHc at 3,6
  put char MoBarheight8 at 4,6
  put char MoLFg at 3,7
  put char MoBarsafe6 at 4,7
  put char MoBarsafe8 at 3,11
  put char MoBarsafe8 at 4,11
  put char MoBarok8 at 3,13
  put char MoBarok8 at 4,13
  put char MoBarcrash8 at 3,15
  put char MoBarcrash8 at 4,15
  put char MoBarmax8 at 3,17
  put char MoBarmax8 at 4,17
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  sprites flicker off
  LoadTi
  for K = 0 to 11
    J = K << 1
    X = TStars[J]
    inc J
    Y = TStars[J]
    V = K % 3
    V += TiStar0
    put char V at X,Y
  next
  PutRun(TiEarth00, 2, 27, 2)
  PutRun(TiEarth10, 2, 27, 3)
  for Y = 0 to Logo1H - 1
    V = Y * Logo1W
    J = Y + 1
    put Logo1 + V count Logo1W at 3,J
  next
  for Y = 0 to Logo2H - 1
    V = Y * Logo2W
    J = Y + 5
    put Logo2 + V count Logo2W at 3,J
  next
  ' the moonscape (rows 10-12) and a pad at columns 22-24
  for X = 0 to 31
    V = X & 3
    K = V + TiMnt00
    put char K at X,10
    K = V + TiMnt10
    put char K at X,11
    V = X & 1
    K = V + TiGround0
    put char K at X,12
  next
  PutRun(TiPad0, 3, 22, 12)
  put char TiBeacon1 at 22,11
  put char TiBeacon1 at 24,11
  ' menu (rows 14-20)
  print at 11,14, "START"
  print at 11,16, "LEVEL"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowLevelChoice
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Tf = 0
  Ty = 0
  Tw = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLv > 1 then dec StartLv
      end if
      if Rt1 = 1 then
        if StartLv < 5 then inc StartLv
      end if
      ShowLevelChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLevelChoice:
  print at 18,16, "< >"
  put char StartLv + 48 at 19,16
  return
end sub

' title sprites: the cursor (4) and the module landing on the pad again and
' again (0-3): it falls, brakes with its flame, sits, lifts off
sub TitleAnim:
  inc Cnt
  V = Menu << 4
  V += 107
  set sprite 4 to V,72,SpCursor,11
  ' Tf: 0 falling, 1 braking, 2 on the pad, 3 lifting off; Ty = y
  Thrust = 0
  if Tf = 0 then
    V = Cnt & 1
    if V = 0 then inc Ty
    if Ty >= 44 then Tf = 1
  else
    if Tf = 1 then
      Thrust = 1
      V = Cnt & 3
      if V = 0 then inc Ty
      if Ty >= 79 then
        Tf = 2
        Tw = 0
      end if
    else
      if Tf = 2 then
        inc Tw
        if Tw >= 120 then Tf = 3
      else
        Thrust = 1
        V = Cnt & 1
        if V = 0 then dec Ty
        if Ty <= 2 then
          Tf = 0
          Ty = 2
        end if
      end if
    end if
  end if
  inc FlF
  if FlF >= 9 then FlF = 0
  Ys = Ty
  Lx = 180
  Side = 0
  DrawLanderAt
  if Tf = 2 then
    V = Tick & 15
    if V = 0 then
      V = Tick & 16
      K = TiBeacon1
      if V = 0 then K = TiBeacon0
      put char K at 22,11
      put char K at 24,11
    end if
  end if
  return
end sub

