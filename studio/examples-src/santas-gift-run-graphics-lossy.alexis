project "Santa's Gift Run"
' INCOMPLETE PORT: gameplay still needs closer matching for gift drop and houses.
' Original source: old-projects-sdcc-z80/sdcctest/giftrun/main.c
' Original graphics/sound data: old-projects-sdcc-z80/sdcctest/giftrun/
cartridge "SANTA GIFT RUN/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

const GiftTile = 1
const SnowTile = 3
const EmptySkyTile = $17
const GiftDropSfx = 5
const RoofSfx = 6
const ChimneySfx = 7

record Blob:
  u8 X
  u8 Y
end record

u8 Pad = 0
u8 OldFire = 0
u8 SleighX = 8
u8 SleighY = 8
u8 SleighFrame = 0
u8 FrameTick = 0
u8 HouseCount = 3
Blob Houses[3]
u8 GiftActive = 0
u8 GiftX = 0
u8 GiftY = 0
u8 GiftOnRoof = 0
u8 Score = 0
u8 HousesLeft = 15
u8 SnowX = 0
u8 SnowY = 0
u8 DrawX = 0
u8 DrawY = 0
u8 HouseW = 9
u8 SleighW = 13
u8 ObjectH = 4
u8 HouseFrameBuf[36]
u8 SleighFrameABuf[52]
u8 SleighFrameBBuf[52]

picture GiftRunTitle:
  pattern from "@project/giftrun-title.pattern.zx0" codec zx0
  color from "@project/giftrun-title.color.zx0" codec zx0
end picture

asset GiftRunGamePattern from "@project/giftrun-game.pattern.zx0" codec zx0
asset GiftRunGameColor from "@project/giftrun-game.color.zx0" codec zx0

sub start:
  copy HouseFrame to HouseFrameBuf count 36
  copy SleighFrameA to SleighFrameABuf count 52
  copy SleighFrameB to SleighFrameBBuf count 52
  set sound table GiftRunSoundTable areas 7
  show picture GiftRunTitle
  play sound 1
  screen on
  pause until press
  wait no fire
  goto title_intro

sub title_intro:
  text screen
  cls
  print centered at 2, "SANTA'S GIFT RUN"
  print centered at 5, "LEGACY DEVKIT PORT"
  print at 1,8, "DROP GIFTS INTO CHIMNEYS."
  print at 1,10, "LEFT/RIGHT MOVE SANTA."
  print at 1,12, "FIRE DROPS ONE GIFT."
  print centered at 18, "DELIVER 5 OF 15"
  print centered at 22, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  goto setup_game

sub setup_game:
  screen off
  tile screen
  decompress zx0 GiftRunGamePattern to vram.pattern
  duplicate mode 2 text patterns
  decompress zx0 GiftRunGameColor to vram.color
  set screen pages vram.name and vram $1C00
  SleighX = 8
  SleighY = 8
  Houses[0].X = 2
  Houses[0].Y = 20
  Houses[1].X = 13
  Houses[1].Y = 20
  Houses[2].X = 23
  Houses[2].Y = 20
  GiftActive = 0
  GiftOnRoof = 0
  Score = 0
  HousesLeft = 15
  draw_game
  screen on
  goto game_loop

game_loop:
  wait
  Pad = joypad(1)

  if joypad(1).left then
    if SleighX > 2 then SleighX -= 2
  end if
  if joypad(1).right then
    if SleighX < 17 then SleighX += 2
  end if

  if joypad(1).button1 then
    if OldFire = 0 then
      if GiftActive = 0 then
        GiftActive = 1
        GiftOnRoof = 0
        GiftX = SleighX + 7
        GiftY = SleighY + 2
        play sound GiftDropSfx
      end if
    end if
    OldFire = 1
  else
    OldFire = 0
  end if

  update_gift
  update_world
  draw_game

  if Score >= 5 goto level_clear
  if HousesLeft = 0 goto game_over
  goto game_loop

sub update_world:
  FrameTick += 1
  if FrameTick < 5 then return
  FrameTick = 0
  Houses[0].X += 1
  Houses[1].X += 1
  Houses[2].X += 1
  if Houses[0].X > 25 then
    Houses[0].X = 1
    HousesLeft -= 1
  end if
  if Houses[1].X > 25 then Houses[1].X = 1
  if Houses[2].X > 25 then Houses[2].X = 1
  SleighFrame += 1
  if SleighFrame > 1 then SleighFrame = 0
  return

sub update_gift:
  if GiftActive = 0 then return
  if GiftOnRoof = 1 then
    GiftY += 1
    if GiftY > 23 then GiftActive = 0
    return
  end if
  GiftY += 1
  if GiftY >= 20 then check_chimneys
  if GiftY > 23 then GiftActive = 0
  return

sub check_chimneys:
  if GiftX >= Houses[0].X + 2 then
    if GiftX <= Houses[0].X + 4 then goto gift_delivered
  end if
  if GiftX >= Houses[1].X + 2 then
    if GiftX <= Houses[1].X + 4 then goto gift_delivered
  end if
  if GiftX >= Houses[2].X + 2 then
    if GiftX <= Houses[2].X + 4 then goto gift_delivered
  end if
  if GiftY = 20 then
    GiftOnRoof = 1
    play sound RoofSfx
  end if
  return

sub gift_delivered:
  GiftActive = 0
  Score += 1
  play sound ChimneySfx
  return

sub draw_status:
  print at 1,0, "DELIVERED:"
  print Score at 12,0 digits 2
  print at 16,0, "LEFT:"
  print HousesLeft at 22,0 digits 2
  return

sub clear_playfield:
  fill row 0 from 0 count 32 with EmptySkyTile
  fill row 1 from 0 count 32 with EmptySkyTile
  fill row 2 from 0 count 32 with EmptySkyTile
  fill row 3 from 0 count 32 with EmptySkyTile
  fill row 4 from 0 count 32 with EmptySkyTile
  fill row 5 from 0 count 32 with EmptySkyTile
  fill row 6 from 0 count 32 with EmptySkyTile
  fill row 7 from 0 count 32 with EmptySkyTile
  fill row 8 from 0 count 32 with EmptySkyTile
  fill row 9 from 0 count 32 with EmptySkyTile
  fill row 10 from 0 count 32 with EmptySkyTile
  fill row 11 from 0 count 32 with EmptySkyTile
  fill row 12 from 0 count 32 with EmptySkyTile
  fill row 13 from 0 count 32 with EmptySkyTile
  fill row 14 from 0 count 32 with EmptySkyTile
  fill row 15 from 0 count 32 with EmptySkyTile
  fill row 16 from 0 count 32 with EmptySkyTile
  fill row 17 from 0 count 32 with EmptySkyTile
  fill row 18 from 0 count 32 with EmptySkyTile
  fill row 19 from 0 count 32 with EmptySkyTile
  fill row 20 from 0 count 32 with EmptySkyTile
  fill row 21 from 0 count 32 with EmptySkyTile
  fill row 22 from 0 count 32 with EmptySkyTile
  fill row 23 from 0 count 32 with EmptySkyTile
  return

sub draw_game:
  clear_playfield
  draw_status
  DrawX = Houses[0].X
  DrawY = Houses[0].Y
  put HouseFrameBuf frame size HouseW,ObjectH at DrawX,DrawY
  DrawX = Houses[1].X
  DrawY = Houses[1].Y
  put HouseFrameBuf frame size HouseW,ObjectH at DrawX,DrawY
  DrawX = Houses[2].X
  DrawY = Houses[2].Y
  put HouseFrameBuf frame size HouseW,ObjectH at DrawX,DrawY
  DrawX = SleighX
  DrawY = SleighY
  if SleighFrame = 0 then
    put SleighFrameABuf frame size SleighW,ObjectH at DrawX,DrawY
  else
    put SleighFrameBBuf frame size SleighW,ObjectH at DrawX,DrawY
  end if
  if GiftActive = 1 then
    put char GiftTile at GiftX,GiftY
  end if
  SnowX = random(1,30)
  SnowY = random(8,22)
  put char SnowTile at SnowX,SnowY
  swap screens
  return

sub level_clear:
  text screen
  cls
  play sound ChimneySfx
  print centered at 7, "LEVEL CLEAR"
  print centered at 10, "THE GIFTS ARRIVED!"
  print centered at 16, "PRESS FIRE"
  pause until press
  wait no fire
  goto setup_game

sub game_over:
  text screen
  cls
  print centered at 7, "CHRISTMAS NEEDS"
  print centered at 9, "MORE PRACTICE"
  print centered at 16, "PRESS FIRE"
  pause until press
  wait no fire
  goto setup_game

data HouseFrame bytes
  $80,$81,$82,$83,$84,$85,$86,$87,$88
  $A0,$A1,$A2,$A3,$A4,$A5,$A6,$A7,$A8
  $C0,$C1,$C2,$C3,$C4,$C5,$C6,$C7,$C8
  $E0,$E1,$E2,$E3,$E4,$E5,$E6,$E7,$E8
end data

data SleighFrameA bytes
  $8D,$8E,$8F,$90,$91,$92,$99,$9A,$9B,$9C,$9D,$9E,$9F
  $AD,$AE,$AF,$B0,$B1,$B2,$B9,$BA,$BB,$BC,$BD,$BE,$BF
  $CD,$CE,$CF,$D0,$D1,$D2,$D9,$DA,$DB,$DC,$DD,$DE,$DF
  $ED,$EE,$EF,$F0,$F1,$F2,$F9,$FA,$FB,$FC,$FD,$FE,$FF
end data

data SleighFrameB bytes
  $93,$94,$95,$96,$97,$98,$99,$9A,$9B,$9C,$9D,$9E,$9F
  $B3,$B4,$B5,$B6,$B7,$B8,$B9,$BA,$BB,$BC,$BD,$BE,$BF
  $D3,$D4,$D5,$D6,$D7,$D8,$D9,$DA,$DB,$DC,$DD,$DE,$DF
  $F3,$F4,$F5,$F6,$F7,$F8,$F9,$FA,$FB,$FC,$FD,$FE,$FF
end data

asm {
GiftRunSoundTable:
    dw giftrun_theme1,$702B
    dw giftrun_reserved2,$7035
    dw giftrun_reserved3,$703F
    dw giftrun_reserved4,$7049
    dw giftrun_drop_gift,$7053
    dw giftrun_on_roof,$705D
    dw giftrun_in_chimney,$7067

giftrun_reserved2:
    db $FF
giftrun_reserved3:
    db $FF
giftrun_reserved4:
    db $FF

giftrun_theme1:
    db $82,$1D,$91,$0A,$16,$32
    db $82,$AA,$90,$0A,$16,$32
    db $82,$BE,$90,$0A,$16,$32
    db $82,$D6,$90,$0A,$16,$32
    db $82,$1D,$91,$1E,$16,$32
    db $82,$1D,$91,$05,$16,$32
    db $82,$1D,$91,$05,$16,$32
    db $82,$1D,$91,$0A,$16,$32
    db $82,$AA,$90,$0A,$16,$32
    db $82,$BE,$90,$0A,$16,$32
    db $82,$D6,$90,$0A,$16,$32
    db $82,$FE,$90,$28,$16,$32
    db $82,$FE,$90,$0A,$16,$32
    db $82,$A0,$90,$0A,$16,$32
    db $82,$AA,$90,$0A,$16,$32
    db $82,$BE,$90,$0A,$16,$32
    db $82,$E2,$90,$28,$16,$32
    db $82,$8F,$90,$0A,$16,$32
    db $82,$8F,$90,$0A,$16,$32
    db $82,$A0,$90,$0A,$16,$32
    db $82,$BE,$90,$0A,$16,$32
    db $82,$AA,$90,$1E,$16,$32
    db $90

giftrun_in_chimney:
    db $82,$8F,$90,$0A,$16,$32
    db $82,$8F,$90,$0A,$16,$32
    db $82,$A0,$90,$0A,$16,$32
    db $82,$BE,$90,$0A,$16,$32
    db $82,$AA,$90,$1E,$16,$32
    db $90

giftrun_on_roof:
    db $E5,$90,$02,$94,$02,$98,$02,$10

giftrun_drop_gift:
    db $81,$8F,$90,$1E,$16,$01
    db $90
}
