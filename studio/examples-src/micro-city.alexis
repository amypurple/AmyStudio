' (sprites: 0 the spark, 1-2 you, 3-4 the thug)
' a fighter: state, frames in it, health, knock-back left, walk frames,
' punch decided, walked this frame, pose drawn when down
record Fighter:
  u8 St
  u8 T
  u8 Hp
  u8 Kb
  u8 An
  u8 Done
  u8 Mv
  u8 Pose
end record

Fighter Fs[2]
u16 Fx[2]
u8 Pred[4]
u16 Seed = 12345
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 TNow = 0
u16 LastF = 0
u8 TzOn = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the round: rests used, round, the thug's skill and step, his speed,
' wind-up, reaction, wait base, wait after a stun
u8 QD = 0
u8 SC = 1
u8 SK = 1
u8 MS = 8
u8 ThSp = 3
u8 Tw = 12
u8 React = 17
u8 Base = 24
u8 StunW = 20
' the thug's mind: reaction count-down and its result, stance hold, backing
' off, wait, counter, the punch you just started, your last punch, the beat
u8 SeeT = 0
u8 Seen = 0
u8 ThHold = 0
u8 ThBack = 0
u8 ThWait = 30
u8 Ctr = 0
u8 NewAtk = 0
u8 LastA = 0
u8 Intv = 0
u8 Beat = 0
u8 HitStop = 0
u8 Res = 0
u8 Frames = 0
u8 Ev = 0
u8 SparkT = 0
u8 SparkX = 0
u8 SparkY = 0
u8 ShownP1 = 255
u8 ShownP2 = 255
u8 ShownSc = 0
u8 StartI = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Fi = 0
u8 Wt = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table McSoundTable areas 6
  sprites 16x16
  sprites double
  set sprite count NSpr
  sprites stable 0 to 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame

round_start:
  StartRound

play_loop:
  Frame1
  ReadPad
  GameFrame
  DrawFighters
  ShowHud
  if Res = 0 then goto play_loop

  ' a fighter is down: he falls, then lies
  Phase = 3
  play sound SndKo
  ClearSky
  if Res = 1 then
    print at 10,6, "KNOCKOUT!"
  else
    print at 9,6, "YOU ARE DOWN"
  end if
  for Wt = 1 to 100
    K = 12
    if Wt < 14 then K = 11
    if Res = 1 then
      Fs[1].Pose = K
    else
      Fs[0].Pose = K
    end if
    Frame1
    DrawFighters
  next
  if Res = 2 then goto game_over
  if SC = 8 then goto game_won
  inc SC
  goto round_start

game_won:
  Phase = 4
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  play sound SndWin
  ClearSky
  print at 4,5, "YOU SAVED MICRO CITY!"
  print at 4,7, "THE STREETS ARE SAFE AND"
  print at 4,8, "THE LIGHTS STAY ON."
  print at 4,10, "SCORE ", Score
  goto the_end

game_over:
  Phase = 4
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  play sound SndKo
  ClearSky
  print at 10,5, "GAME OVER"
  print at 4,7, "THE THUGS STILL RULE"
  print at 4,8, "MICRO CITY."
  print at 4,10, "SCORE ", Score

the_end:
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules, one frame at a time (model.mjs is the same in JavaScript)

' a 16-bit xorshift; a number below N
function Rnd(u8 N) as u8
  u8 Lo = 0
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  Lo = Seed & 255
  return Lo % N

' the distance between the fighters in pixels
function GapPx as u8
  u16 D = 0
  D = Fx[1] - Fx[0]
  D = D >> 2
  return D

' a punch's wind-up (A 0 you, 1 the thug)
function Wind(u8 A, u8 S) as u8
  if A = 0 then
    if S = SHigh then return PwH
    return PwL
  end if
  if S = SHigh then return Tw
  return Tw + 6

' a punch's frames from start to end
function Total(u8 A, u8 S) as u8
  u8 N = 0
  N = Wind(A, S) + ActF
  if S = SHigh then return N + RecH
  return N + RecL

' frames left in your punch
function PLeft as u8
  u8 S = 0
  S = Fs[0].St
  if S = SHigh then return Total(0, S) - Fs[0].T
  if S = SLow then return Total(0, S) - Fs[0].T
  return 0

' 1 when you can be hit without a trade: not winding up or punching
function POpen as u8
  u8 S = 0
  S = Fs[0].St
  if S <> SHigh then
    if S <> SLow then return 1
  end if
  if Fs[0].T > Wind(0, S) + ActF then return 1
  return 0

' 1 when a steady beat's next punch is due in 1-4 frames
function BeatDue as u8
  u16 E = 0
  u16 F = 0
  E = TNow - LastF
  if E >= Intv then return 0
  F = E + 4
  if F >= Intv then return 1
  return 0

' a punch of fighter A on its first active frame: miss, dodge, block or hit
sub Attack(u8 A)
  u8 D = 0
  u8 S = 0
  u8 Dm = 0
  u8 G = 0
  u8 Ds = 0
  u8 Reach = ReachL
  S = Fs[A].St
  if Fs[A].T <> Wind(A, S) + 1 then return
  Fs[A].Done = 1
  D = 1 - A
  Ds = Fs[D].St
  if S = SHigh then Reach = ReachH
  G = GapPx()
  if G > Reach then
    play sound SndMiss
    return
  end if
  if Ds = SRest then
    play sound SndMiss
    if A = 0 then Ctr = SLow
    return
  end if
  if S = SHigh then
    if Ds = SDuck then
      play sound SndMiss
      if A = 0 then Ctr = SLow
      return
    end if
  end if
  if S = SLow then
    if Ds = SIdle then
      if Fs[D].Mv = 0 then
        Fs[D].Kb = KbB
        play sound SndBlock
        if A = 0 then Ctr = SHigh
        return
      end if
    end if
  end if
  ' a hit
  Dm = 2
  if S = SLow then Dm = 3
  if Fs[D].Hp > Dm then
    Fs[D].Hp = Fs[D].Hp - Dm
    Fs[D].St = SStun
    Fs[D].T = StunH
    Fs[D].Kb = KbH
    if S = SLow then
      Fs[D].T = StunL
      Fs[D].Kb = KbL
    end if
  else
    Fs[D].Hp = 0
    Fs[D].St = SDown
    Fs[D].T = 0
    Fs[D].Kb = KbH
    if S = SLow then Fs[D].Kb = KbL
  end if
  HitStop = StopF
  ' the spark at the fist
  SparkT = 10
  W16 = Fx[D] >> 2
  SparkX = W16
  SparkX = SparkX - 8
  SparkY = FeetY - 8
  if S = SLow then SparkY = FeetY + 4
  if A = 0 then
    play sound SndHit
    if S = SHigh then
      Score += PtsHi
    else
      Score += PtsLo
    end if
  else
    play sound SndOuch
    SparkX = SparkX + 20
  end if
  return
end sub

sub WalkP(u8 Dir)
  u16 Nx = 0
  Fs[0].Mv = 1
  Fs[0].An = Fs[0].An + 1
  if Dir = 1 then
    Nx = Fx[0] + PSp
    W16 = Nx + Gap4
    if W16 > Fx[1] then Nx = Fx[1] - Gap4
    Fx[0] = Nx
  else
    W16 = XMin4 + PSp
    if Fx[0] < W16 then
      Fx[0] = XMin4
    else
      Fx[0] = Fx[0] - PSp
    end if
  end if
  return
end sub

sub WalkT(u8 Dir)
  u16 Nx = 0
  u16 Lim = 0
  Fs[1].Mv = 1
  Fs[1].An = Fs[1].An + 1
  if Dir = 1 then
    Nx = Fx[1] + ThSp
    if Nx > XMax4 then Nx = XMax4
    Fx[1] = Nx
  else
    Nx = Fx[1] - ThSp
    Lim = Fx[0] + Gap4
    if Nx < Lim then Nx = Lim
    Fx[1] = Nx
  end if
  return
end sub

sub PlayerStep:
  u8 S = 0
  Fs[0].Mv = 0
  S = Fs[0].St
  select case S
  case SHigh, SLow
    Fs[0].T = Fs[0].T + 1
    if Fs[0].T > Total(0, S) then
      Fs[0].St = SIdle
      Fs[0].T = 0
    else
      Attack(0)
    end if
  case SStun
    dec Fs[0].T
    if Fs[0].T = 0 then Fs[0].St = SIdle
  case SRest
    dec Fs[0].T
    if Fs[0].T = 0 then
      Fs[0].St = SIdle
      if Fs[0].Hp < HpMax then inc Fs[0].Hp
      play sound SndRest
    end if
  end select
  S = Fs[0].St
  if S <> SIdle then
    if S <> SDuck then return
  end if
  K = Pad & 16
  if K > 0 then
    K = Pad & 2
    if K > 0 then
      if QD < RestN then
        Fs[0].St = SRest
        Fs[0].T = RestF
        inc QD
        return
      end if
    end if
    Fs[0].St = SDuck
    return
  end if
  K = Pad & 1
  if K > 0 then
    StartPunch(0, SHigh)
    NewAtk = 1
    return
  end if
  K = Pad & 2
  if K > 0 then
    StartPunch(0, SLow)
    NewAtk = 2
    return
  end if
  Fs[0].St = SIdle
  K = Pad & 8
  if K > 0 then
    WalkP(1)
    return
  end if
  K = Pad & 4
  if K > 0 then WalkP(0)
  return
end sub

sub StartPunch(u8 W, u8 S)
  Fs[W].St = S
  Fs[W].T = 0
  Fs[W].Done = 0
  return
end sub

' the thug learns from the punch you just started
sub Learn:
  u8 T = 0
  u8 I = 0
  u8 C = 0
  u8 Lim = 0
  u16 Iv = 0
  u16 Hi4 = 0
  T = NewAtk - 1
  I = LastA * 2 + T
  C = Pred[I]
  Lim = SK >> 1
  Lim = 4 - Lim
  if C >= Lim then
    SeeT = 2
  else
    SeeT = React + Rnd(6)
  end if
  if C < 6 then Pred[I] = C + 1
  I = LastA * 2 + 1 - T
  if Pred[I] > 0 then dec Pred[I]
  LastA = T
  NewAtk = 0
  ' the beat: the time since your last punch against the time before
  Iv = TNow - LastF
  if Iv > 255 then Iv = 255
  Hi4 = Iv + 4
  W16 = Intv + 4
  if Hi4 >= Intv and Iv <= W16 then
    if Beat < 4 then inc Beat
  else
    Beat = 0
  end if
  Intv = Iv
  LastF = TNow
  if Beat >= 2 then ThWait = 0
  return
end sub

sub ThugStep:
  u8 S = 0
  u8 G = 0
  u8 Go = 0
  u8 R = 0
  u8 Ps = 0
  u8 Hi2 = 0
  u8 Lo2 = 0
  Fs[1].Mv = 0
  if NewAtk > 0 then Learn
  if SeeT > 0 then
    dec SeeT
    if SeeT = 0 then Seen = 1
  end if
  S = Fs[1].St
  select case S
  case SHigh, SLow
    Fs[1].T = Fs[1].T + 1
    if Fs[1].T > Total(1, S) then
      Fs[1].St = SIdle
      Fs[1].T = 0
      ThWait = Base + Rnd(Base)
      if Rnd(8) < 2 then ThBack = 20 + Rnd(20)
    else
      Attack(1)
    end if
  case SStun
    dec Fs[1].T
    if Fs[1].T = 0 then
      Fs[1].St = SIdle
      if ThWait < StunW then ThWait = StunW
      if Rnd(4) = 0 then ThBack = 16 + Rnd(16)
    end if
  case SDuck
    dec Fs[1].T
    if Fs[1].T = 0 then Fs[1].St = SIdle
  case SDown
    return
  end select
  if ThWait > 0 then dec ThWait
  S = Fs[1].St
  if S <> SIdle then
    if S <> SDuck then return
  end if
  G = GapPx()
  if Ctr > 0 then
    if G > FarG then Ctr = 0
  end if
  Ps = Fs[0].St
  if Seen = 1 and G <= FarG then
    Seen = 0
    if Ps = SHigh then
      if Fs[0].T <= PwH then
        Fs[1].St = SDuck
        Fs[1].T = DuckF
        return
      end if
    end if
    if Ps = SLow then
      if S = SDuck then
        Fs[1].St = SIdle
        Fs[1].T = 0
        ThHold = HoldF
        return
      end if
    end if
  end if
  if Ctr > 0 then
    Go = SHigh
    if PLeft() > Tw + 6 then Go = SLow
    Ctr = 0
  elseif ThWait = 0 then
    if G <= ReachL then
      if Ps <> SRest then
        if POpen() = 1 then
          R = Rnd(8)
          Go = SLow
          if R < 5 then Go = SHigh
          if SK > 1 then
            if Ps = SDuck then Go = SLow
          end if
        end if
      end if
    end if
  end if
  if Go > 0 then
    StartPunch(1, Go)
    ThBack = 0
    ThHold = 0
    return
  end if
  Hi2 = Pred[LastA * 2]
  Lo2 = Pred[LastA * 2 + 1]
  ' a steady beat: ready just before the next punch is due
  if Beat >= 2 and G <= FarG then
    if S = SIdle then
      if BeatDue() = 1 then
        if Hi2 >= Lo2 then
          Fs[1].St = SDuck
          Fs[1].T = 12
        else
          Fs[1].T = 0
          ThHold = 10
        end if
        return
      end if
    end if
  end if
  if S = SDuck then return
  if ThHold > 0 then
    dec ThHold
    return
  end if
  if ThBack > 0 then
    dec ThBack
    WalkT(1)
    return
  end if
  if G > NearG then
    WalkT(0)
    return
  end if
  ' in reach: a stance for a while, ducking more against high punches
  R = Rnd(8)
  if R + Lo2 < 2 + Hi2 then
    Fs[1].St = SDuck
    Fs[1].T = 12 + Rnd(20)
  else
    ThHold = 12 + Rnd(20)
  end if
  return
end sub

sub GameFrame:
  inc Frames
  if Res > 0 then return
  if HitStop > 0 then
    dec HitStop
    return
  end if
  inc TNow
  PlayerStep
  ThugStep
  if Fs[0].Kb > 0 then
    dec Fs[0].Kb
    W16 = XMin4 + 4
    if Fx[0] < W16 then
      Fx[0] = XMin4
    else
      Fx[0] = Fx[0] - 4
    end if
  end if
  if Fs[1].Kb > 0 then
    dec Fs[1].Kb
    W16 = Fx[1] + 4
    if W16 > XMax4 then W16 = XMax4
    Fx[1] = W16
  end if
  if Fs[1].St = SDown then
    Res = 1
    AddRound
  elseif Fs[0].St = SDown then
    Res = 2
  end if
  return
end sub

' a round won: 100 x the round + 10 x your health
sub AddRound:
  u8 N = 0
  u8 H = 0
  H = Fs[0].Hp
  for N = 1 to SC
    Score += 100
  next
  for N = 1 to 10
    Score += H
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the pose of fighter W from its state (0-3 stand and walk, 4/5 high
' wind-up and blow, 6/7 low, 8 duck, 9 rest, 10 hit, 11 falling, 12 down)
function PoseOf(u8 W) as u8
  u8 S = 0
  u8 P = 0
  u8 Tt = 0
  u8 Wd = 0
  S = Fs[W].St
  Tt = Fs[W].T
  select case S
  case SIdle
    if Fs[W].Mv = 0 then return 0
    P = Fs[W].An >> 2
    P = P & 3
    return P
  case SHigh, SLow
    Wd = Wind(W, S)
    P = 4
    if S = SLow then P = 6
    if Tt > Wd then
      Wd = Wd + 6
      if Tt <= Wd then inc P
    end if
    return P
  case SDuck
    return 8
  case SRest
    return 9
  case SStun
    return 10
  end select
  return Fs[W].Pose

sub DrawFighters:
  u8 Px = 0
  u8 Pat = 0
  u8 Y = 0
  u16 Q = 0
  Y = FeetY
  if HitStop > 0 then
    K = HitStop & 2
    if K > 0 then Y = Y - 1
  end if
  for Fi = 0 to 1
    Q = Fx[Fi] >> 2
    Px = Q
    Pat = PoseOf(Fi) * 8
    if Fi = 0 then
      set sprite 1 to Y,Px,Pat,PSkin
      Pat = Pat + 4
      set sprite 2 to Y,Px,Pat,PHero
    else
      Pat = Pat + SEstands
      set sprite 3 to Y,Px,Pat,PSkin
      Pat = Pat + 4
      set sprite 4 to Y,Px,Pat,PThug
    end if
  next
  if SparkT > 0 then
    dec SparkT
    set sprite 0 to SparkY,SparkX,SSpark,11
  else
    set sprite 0 to 192,0,SSpark,0
  end if
  update sprites
  return
end sub

' a health bar: Len tiles from column C (the thug's fills from the right)
sub DrawBar(u8 C, u8 Len, u8 Hp, u8 TB, u8 Rev)
  u8 N = 0
  u8 Left = 0
  u8 Col = 0
  Left = Hp
  for N = 1 to Len
    V = 4
    if Left < 4 then V = Left
    Left = Left - V
    if Rev = 1 then
      Col = C + Len - N
    else
      Col = C + N - 1
    end if
    put char TB + V at Col, 1
  next
  return
end sub

' the health bars and the score, redrawn when they change
sub ShowHud:
  u8 H = 0
  H = Fs[0].Hp
  if H <> ShownP1 then
    DrawBar(6, 7, H, THb0, 0)
    ShownP1 = H
  end if
  H = Fs[1].Hp
  if H <> ShownP2 then
    DrawBar(16, 9, H, TTb0, 1)
    ShownP2 = H
  end if
  if Frames <> ShownSc then
    ShownSc = Frames
    print at 2,2, "SCORE ", Score
  end if
  return
end sub

sub FullHud:
  ShownP1 = 255
  ShownP2 = 255
  ShownSc = Frames + 1
  print at 2,1, "YOU"
  print at 26,1, "THUG"
  print at 21,2, "ROUND "
  NumU = SC
  print at 27,2, digits$(NumU, 1)
  ShowHud
  return
end sub

' the scene's rows A to B (3-23) from SceneT
sub SceneRows(u8 A, u8 B)
  u16 Src = 0
  u16 Dst = 0
  for Ri = A to B
    Src = Ri - 3
    Src = Src * 32
    Dst = Ri * 32
    copy SceneT + Src count 32 to vram.name + Dst
  next
  return
end sub

' the sky above the rooftops cleared for a message (rows 4-11, columns
' 2-27: the moon stays)
sub ClearSky:
  for Ri = 4 to 11
    fill 32 count 26 at 2,Ri
  next
  return
end sub

' a new round: health, places, the thug's ways, the banner, the bell
sub StartRound:
  u8 I = 0
  Phase = 2
  I = SC - 1
  SK = SkT[I]
  MS = MsT[I]
  ThSp = MS >> 2
  inc ThSp
  Tw = SK * 2
  Tw = 14 - Tw
  React = SK * 5
  React = 22 - React
  Base = BaseT[SK - 1]
  StunW = SK * 4
  StunW = 24 - StunW
  for Fi = 0 to 1
    Fs[Fi].St = SIdle
    Fs[Fi].T = 0
    Fs[Fi].Kb = 0
    Fs[Fi].An = 0
    Fs[Fi].Done = 0
    Fs[Fi].Mv = 0
    Fs[Fi].Pose = 0
  next
  Fs[0].Hp = P1Start
  Fs[1].Hp = P2T[I]
  Fx[0] = PStart4
  Fx[1] = TStart4
  for Fi = 0 to 3
    Pred[Fi] = 0
  next
  QD = 0
  Res = 0
  HitStop = 0
  SeeT = 0
  Seen = 0
  ThHold = 0
  ThBack = 0
  ThWait = 30
  Ctr = 0
  NewAtk = 0
  LastA = 0
  TNow = 0
  LastF = 0
  Intv = 0
  Beat = 0
  SparkT = 0
  Rearm
  wait
  nmi off
  SceneRows(3, 13)
  FullHud
  ClearSky
  print at 11,6, "ROUND "
  NumU = SC
  print at 17,6, digits$(NumU, 1)
  SkillLine(SK)
  DrawFighters
  play sound SndBell
  for Fi = 1 to 75
    Frame1
  next
  print at 12,10, "FIGHT!"
  for Fi = 1 to 30
    Frame1
  next
  SceneRows(3, 13)
  Phase = 1
  return
end sub

' the thug's ways, by skill (a sub with early returns)
sub SkillLine(u8 S)
  if S = 1 then
    print at 5,8, "A STREET PUNK SWINGS"
    return
  end if
  if S = 2 then
    print at 5,8, "A BRAWLER STEPS IN"
    return
  end if
  print at 5,8, "A BOXER WAITS FOR YOU"
  return
end sub

sub NewGame:
  Score = 0
  SC = StartT[StartI]
  NewScreen
  SceneRows(3, 23)
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: MICRO CITY in big letters over the street, the starting
' round, the tune once; the two fighters squaring up
sub TitlePage:
  u8 Lx = 0
  Phase = 5
  NewScreen
  SceneRows(3, 23)
  ClearSky
  fill 32 count 26 at 2,12
  fill 32 count 26 at 2,13
  ' M I C R O   C I T Y
  Lx = 5
  for Ci = 0 to 9
    select case Ci
    case 0
      K = TLM00
    case 1
      K = TLI00
    case 2, 6
      K = TLC00
    case 3
      K = TLR00
    case 4
      K = TLO00
    case 7
      K = TLI00
    case 8
      K = TLT00
    case 9
      K = TLY00
    case else
      K = 0
    end select
    if K > 0 then
      put char K at Lx, 4
      put char K + 1 at Lx + 1, 4
      put char K + 2 at Lx, 5
      put char K + 3 at Lx + 1, 5
    end if
    Lx = Lx + 2
  next
  print at 6,7, "AHOY! DECEMBER 1986"
  print at 3,8, "AFTER DARRYL DION HAWKINS"
  print at 5,10, "START AT ROUND"
  print at 7,12, "HIGH ", Hi
  print at 7,13, "PRESS THE BUTTON"
  ShowStart
  Fx[0] = 480
  Fx[1] = 592
  for Fi = 0 to 1
    Fs[Fi].St = SIdle
    Fs[Fi].Mv = 0
    Fs[Fi].Pose = 0
  next
  SparkT = 0
  HitStop = 0
  Res = 0
  DrawFighters
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  V = Rnd(2)
  V = Pad & 12
  if V > 0 then
    if WasStick = 0 then
      if V = 4 then
        if StartI > 0 then dec StartI
      else
        if StartI < 2 then inc StartI
      end if
      ShowStart
      play sound SndTick
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Seed = Seed ^ W16
  if Seed = 0 then Seed = 1
  HideSprites
  return
end sub

sub ShowStart:
  NumU = StartT[StartI]
  print at 20,10, "< ", digits$(NumU, 1), " >"
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  backdrop dark blue
  print at 10,1, "MICRO CITY"
  print at 2,3, "BASED ON MICRO CITY BY"
  print at 2,4, "DARRYL DION HAWKINS, AHOY!"
  print at 2,5, "DECEMBER 1986, COMMODORE 64."
  print at 2,7, "COLECOVISION GAME, MUSIC"
  print at 2,8, "AND PICTURES BY CLAUDE"
  print at 2,9, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,10, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,11, "MUSIC: NIGHT PATROL (NEW)"
  print at 2,13, "LEFT/RIGHT  WALK"
  print at 2,14, "UP          HIGH PUNCH"
  print at 2,15, "DOWN        LOW PUNCH"
  print at 2,16, "BUTTON      DUCK"
  print at 2,17, "BUTTON+DOWN REST, 8 A ROUND"
  print at 2,19, "A STANDING FIGHTER BLOCKS"
  print at 2,20, "LOW PUNCHES. MIX YOUR MOVES!"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

