define ROM_TEST_CHECKPOINTS

picture WarriorDan2Picture:
  pattern from "@project/warrior.pattern.dan2" codec dan2
  color from "@project/warrior.color.dan2" codec dan2
end picture

sub start:
  text screen
  backdrop dark blue
  print centered at 3, "WARRIOR DAN2 TEST"
  print centered at 7, "THIS ROM WAITS FOR FIRE"
  print centered at 9, "THEN DECOMPRESSES"
  print centered at 11, "PATTERN AND COLOR TABLES"
  print centered at 13, "USING THE DAN2 CODEC"
  print centered at 19, "PRESS FIRE TO CONTINUE"
  screen on
  wait
  ifdef ROM_TEST_CHECKPOINTS
    test checkpoint "warrior_prompt"
  end ifdef
  wait no fire
  pause until press
  wait no fire
  show picture WarriorDan2Picture
  wait
  ifdef ROM_TEST_CHECKPOINTS
    test checkpoint "warrior_image"
  end ifdef
  loop forever
end sub
