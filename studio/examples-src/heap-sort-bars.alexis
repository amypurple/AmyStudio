const LeftX = 6
const BlockTile = $23
const EmptyTile = $20

' Sorting data.
u8 Values[20], RowBuffer[20], LowStack[20], HighStack[20]
' Loop and compare state.
u8 IndexA = 0, J = 0, K = 0, Col = 0, Threshold = 0
u8 Temp = 0, CompareA = 0, CompareB = 0
' Swap and write-back state.
u8 SwapA = 0, SwapB = 0, WriteIndex = 0, WriteValue = 0
' Algorithm-specific scratch state.
u8 InnerLimit = 0, HeapEnd = 0, Root = 0, Child = 0, StoreIndex = 0
u8 ArgStart = 0, ArgEnd = 0, StackTop = 0, Low = 0, High = 0, Pivot = 0, PivotPos = 0

' Heap Sort Bars
  screen off
  setup_screen
  randomize_values
  screen on
  goto ready_loop

ready_loop:
  print at 1,22, "PRESS FIRE TO SORT"
  print at 1,23, "PRESS AGAIN TO RESHUFFLE"
wait_sort_press:
  wait
  if joypad(1).button1 then goto wait_sort_release
  goto wait_sort_press
wait_sort_release:
  wait
  if joypad(1).button1 then goto wait_sort_release
  fill row 22 from 0 count 32 with EmptyTile
  run_sort
  print at 1,22, "DONE - FIRE RANDOMIZE"
wait_randomize_press:
  wait
  if joypad(1).button1 then goto wait_randomize_release
  goto wait_randomize_press
wait_randomize_release:
  wait
  if joypad(1).button1 then goto wait_randomize_release
  randomize_values
  goto ready_loop

sub setup_screen:
  text screen
  print at 1,0, "HEAP SORT"
  print at 1,21, "ROWS 1..20 = THRESHOLDS"
  return

sub randomize_values:
  for IndexA = 0 to 19
    Values[IndexA] = IndexA
    Values[IndexA] += 1
  next
  for IndexA = 0 to 39
    SwapA = random(1, 20)
    SwapA -= 1
    SwapB = random(1, 20)
    SwapB -= 1
    swap Values[SwapA] with Values[SwapB]
  next
  render_bars
  return

sub render_bars:
  nmi off
  for Threshold = 1 to 20
    fill array RowBuffer with EmptyTile
    Col = 0
    do while Col <= 19
      if Values[Col] >= Threshold then
        RowBuffer[Col] = BlockTile
      end if
      Col += 1
    loop
    put RowBuffer count 20 at LeftX,Threshold
  next
  nmi on
  return

sub step_delay:
  wait 5 frames
  return

sub set_item:
  Values[WriteIndex] = WriteValue
  render_bars
  step_delay
  return

sub swap_items:
  swap Values[SwapA] with Values[SwapB]
  render_bars
  step_delay
  return

sub run_sort:
  for IndexA = 0 to 9
    ArgStart = 9
    ArgStart -= IndexA
    ArgEnd = 19
    sift_down
  next
  for IndexA = 0 to 18
    HeapEnd = 19
    HeapEnd -= IndexA
    SwapA = 0
    SwapB = HeapEnd
    swap_items
    HeapEnd -= 1
    ArgStart = 0
    ArgEnd = HeapEnd
    sift_down
  next
  return

sub sift_down:
  Root = ArgStart
sift_loop:
  Child = Root
  Child += Root
  Child += 1
  if Child > ArgEnd then
    goto sift_done
  end if
  K = Child
  K += 1
  if K <= ArgEnd then
    CompareA = Values[Child]
    CompareB = Values[K]
    if CompareA < CompareB then
      Child = K
    end if
  end if
sift_compare_root:
  CompareA = Values[Root]
  CompareB = Values[Child]
  if CompareA >= CompareB then
    goto sift_done
  end if
  SwapA = Root
  SwapB = Child
  swap_items
  Root = Child
  goto sift_loop
sift_done:
  return
