' FujiNet: let the FujiNet parse a JSON reply and pull out single values,
' so the console's 1 KB of RAM never holds the whole document.
' Build for a ColecoVision cartridge with target.hardware ["fujinet"].
u8 S = 0
u8 Got = 0
u8 Title[32]
u8 Author[32]

text screen
backdrop dark green
screen on
print at 0,0, "FUJINET JSON QUERY"

network open 1 "N:HTTPS://httpbin.org/json" read status S
if S = 0 then
  network json 1 status S
end if
if S = 0 then
  ' Each query reads its whole value; Got counts what fit in the buffer.
  Got = network query 1 "/slideshow/title" into Title status S
  print at 0,2, "TITLE"
  put Title count Got at 0,3
  Got = network query 1 "/slideshow/author" into Author status S
  print at 0,5, "AUTHOR"
  put Author count Got at 0,6
else
  print at 0,2, "REQUEST FAILED"
end if
network close 1
loop forever
