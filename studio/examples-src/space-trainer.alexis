end data

sub start:
  tile screen
  sprites 16x16
  sprites simple
  define sprites SpaceTrainerSpritePatterns at 0
  set sound table SpaceTrainerSoundTable areas 3
  setup_title
  setup_game
  play sound 2
  play sound 3
  goto game_loop
end sub

sub setup_title:
  cls
  print centered at 3, "SPACE TRAINER"
  print centered at 5, "OLD SDCC DEVKIT PORT"
  print at 3,8, "LEFT/RIGHT ROTATE SHIPS."
  print at 3,10, "FIRE OR KEYPAD THRUSTS."
  print at 3,12, "COLLECT THE MOVING BUBBLE."
  print at 3,15, "FIRST TO 10000 WINS."
  print centered at 20, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  screen off
  cls
  return
end sub

sub setup_game:
  clear sprites
  set sprite count 4
  Ships[0].Score = 0
  Ships[1].Score = 0
  Ships[0].X = 16
  Ships[0].Y = 16
  Ships[1].X = 224
  Ships[1].Y = 160
  Ships[0].VX = 0
  Ships[0].VY = 0
  Ships[1].VX = 0
  Ships[1].VY = 0
  Ships[0].Orient = random(0,23)
  Ships[1].Orient = random(0,23)
  init_stars
  init_bubble
  show_score
  update_ships
  update sprites
  screen on
  return
end sub

sub init_stars:
  for I = 0 to 59
    Tmp = random(2,29)
    put char 46 at Tmp,random(2,21)
  next
  return
end sub

sub init_bubble:
  BubbleDir = random(0,1)
  if BubbleDir = 0 then
    BubbleDir = -4
  else
    BubbleDir = 4
  end if
  BubbleX = random(16,224)
  BubbleY = random(16,160)
  BubbleFrame = BubbleBasePattern
  BubbleTimer = 600
  set sprite 2 to BubbleY,BubbleX,BubbleFrame,7
  return
end sub

sub game_loop:
SpaceTrainer_GameLoop:
  wait 2 frames
  update_ships
  update_bubble
  check_bubble
  update sprites
  update_player1
  update_player2
  if Ships[0].Score >= WinScore goto game_over
  if Ships[1].Score >= WinScore goto game_over
  goto SpaceTrainer_GameLoop
  return
end sub

sub update_player1:
  Pad1 = joypad(1)
  if joypad(1).right then
    Ships[0].Orient += 1
    if Ships[0].Orient > 23 then Ships[0].Orient = 0
  end if
  if joypad(1).left then
    if Ships[0].Orient = 0 then Ships[0].Orient = 23 else Ships[0].Orient -= 1
  end if
  if Pad1 & $F0 then thrust_p1
  return
end sub

sub update_player2:
  Pad2 = joypad(2)
  if joypad(2).right then
    Ships[1].Orient += 1
    if Ships[1].Orient > 23 then Ships[1].Orient = 0
  end if
  if joypad(2).left then
    if Ships[1].Orient = 0 then Ships[1].Orient = 23 else Ships[1].Orient -= 1
  end if
  if Pad2 & $F0 then thrust_p2
  return
end sub

sub thrust_p1:
  StepY = SpaceTrainerSinY[Ships[0].Orient]
  StepX = SpaceTrainerSinX[Ships[0].Orient]
  TempFixed = Ships[0].VY + StepY
  if TempFixed > -8 then
    if TempFixed < 8 then
      Ships[0].VY = TempFixed
      TempFixed = Ships[0].VX + StepX
      if TempFixed > -8 then
        if TempFixed < 8 then Ships[0].VX = TempFixed
      end if
    end if
  end if
  return
end sub

sub thrust_p2:
  StepY = SpaceTrainerSinY[Ships[1].Orient]
  StepX = SpaceTrainerSinX[Ships[1].Orient]
  TempFixed = Ships[1].VY + StepY
  if TempFixed > -8 then
    if TempFixed < 8 then
      Ships[1].VY = TempFixed
      TempFixed = Ships[1].VX + StepX
      if TempFixed > -8 then
        if TempFixed < 8 then Ships[1].VX = TempFixed
      end if
    end if
  end if
  return
end sub

sub update_ships:
  Ships[0].Y += Ships[0].VY
  if Ships[0].Y < MinY then Ships[0].Y = MaxY
  if Ships[0].Y > MaxY then Ships[0].Y = MinY
  Ships[0].X += Ships[0].VX
  if Ships[0].X < MinX then Ships[0].X = MaxX
  if Ships[0].X > MaxX then Ships[0].X = MinX
  SpritePattern = Ships[0].Orient << 2
  set sprite 0 to Ships[0].Y,Ships[0].X,SpritePattern,5
  reduce_speed_p1

  Ships[1].Y += Ships[1].VY
  if Ships[1].Y < MinY then Ships[1].Y = MaxY
  if Ships[1].Y > MaxY then Ships[1].Y = MinY
  Ships[1].X += Ships[1].VX
  if Ships[1].X < MinX then Ships[1].X = MaxX
  if Ships[1].X > MaxX then Ships[1].X = MinX
  SpritePattern = Ships[1].Orient << 2
  set sprite 1 to Ships[1].Y,Ships[1].X,SpritePattern,9
  reduce_speed_p2
  return
end sub

sub reduce_speed_p1:
  if Ships[0].VY < 0 then
    Ships[0].VY += ReduceSpeed
    if Ships[0].VY > 0 then Ships[0].VY = 0
  end if
  if Ships[0].VY > 0 then
    Ships[0].VY -= ReduceSpeed
    if Ships[0].VY < 0 then Ships[0].VY = 0
  end if
  if Ships[0].VX < 0 then
    Ships[0].VX += ReduceSpeed
    if Ships[0].VX > 0 then Ships[0].VX = 0
  end if
  if Ships[0].VX > 0 then
    Ships[0].VX -= ReduceSpeed
    if Ships[0].VX < 0 then Ships[0].VX = 0
  end if
  return
end sub

sub reduce_speed_p2:
  if Ships[1].VY < 0 then
    Ships[1].VY += ReduceSpeed
    if Ships[1].VY > 0 then Ships[1].VY = 0
  end if
  if Ships[1].VY > 0 then
    Ships[1].VY -= ReduceSpeed
    if Ships[1].VY < 0 then Ships[1].VY = 0
  end if
  if Ships[1].VX < 0 then
    Ships[1].VX += ReduceSpeed
    if Ships[1].VX > 0 then Ships[1].VX = 0
  end if
  if Ships[1].VX > 0 then
    Ships[1].VX -= ReduceSpeed
    if Ships[1].VX < 0 then Ships[1].VX = 0
  end if
  return
end sub

sub update_bubble:
  BubbleFrame += BubbleDir
  if BubbleFrame < BubbleBasePattern then BubbleFrame = BubbleAltPattern
  if BubbleFrame > BubbleAltPattern then BubbleFrame = BubbleBasePattern
  set sprite 2 pattern to BubbleFrame
  BubbleTimer -= 10
  if BubbleTimer <= 0 then init_bubble
  return
end sub

sub check_bubble:
  if Ships[0].X > BubbleX then
    DeltaX = Ships[0].X - BubbleX
  else
    DeltaX = BubbleX - Ships[0].X
  end if
  if DeltaX < 15 then
    if Ships[0].Y > BubbleY then
      DeltaY = Ships[0].Y - BubbleY
    else
      DeltaY = BubbleY - Ships[0].Y
    end if
    if DeltaY < 15 then
      Ships[0].Score += BubbleTimer
      play sound 1
      init_bubble
      show_score
    end if
  end if

  if Ships[1].X > BubbleX then
    DeltaX = Ships[1].X - BubbleX
  else
    DeltaX = BubbleX - Ships[1].X
  end if
  if DeltaX < 15 then
    if Ships[1].Y > BubbleY then
      DeltaY = Ships[1].Y - BubbleY
    else
      DeltaY = BubbleY - Ships[1].Y
    end if
    if DeltaY < 15 then
      Ships[1].Score += BubbleTimer
      play sound 1
      init_bubble
      show_score
    end if
  end if
  return
end sub

sub show_score:
  print at 3,1, "     "
  print Ships[0].Score at 3,1 digits 5
  print at 24,1, "     "
  print Ships[1].Score at 24,1 digits 5
  return
end sub

sub game_over:
  mute all
  cls
  clear sprites
  update sprites
  if Ships[0].Score >= WinScore then
    print centered at 8, "PLAYER 1 WINS"
  else
    print centered at 8, "PLAYER 2 WINS"
  end if
  print centered at 12, "PRESS FIRE"
  pause until press
  wait no fire
  setup_title
  setup_game
  play sound 2
  play sound 3
  goto game_loop
  return
end sub

asm {
SpaceTrainerSoundTable:
    dw SpaceTrainerBeep,$702B
    dw SpaceTrainerMusicA,$7035
    dw SpaceTrainerMusicB,$703F

SpaceTrainerBeep:
    db $43,$00,$72,$05,$11,$90,$F3,$11
    db $50

SpaceTrainerMusicA:
