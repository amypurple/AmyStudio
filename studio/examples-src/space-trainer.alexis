project "Space Trainer"
cartridge "SPACE TRAINER/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' Amy port of Amy Bienvenu / NewColeco's old SDCC Space Trainer sample.
' Original source: old-projects-sdcc-z80/sdcctest/spacetr/
' Two-player inertia, bonus bubble, score race, original BIOS sound tables,
' 24-orientation ship sprites, and keypad/fire thrust behavior.

const MinX = 16
const MinY = 16
const MaxX = 224
const MaxY = 160
const ReduceSpeed = 0.03125
const BubbleBasePattern = 96
const BubbleAltPattern = 112
const WinScore = 10000

record Ship:
  ufixed X
  ufixed Y
  fixed VX
  fixed VY
  u8 Orient
  u16 Score
end record

u8 I = 0
u8 Pad1 = 0
u8 Pad2 = 0
Ship Ships[2]

u8 BubbleX = 0
u8 BubbleY = 0
u8 BubbleFrame = 0
i8 BubbleDir = 4
i16 BubbleTimer = 0
fixed StepX = 0
fixed StepY = 0
fixed TempFixed = 0
u8 Tmp = 0
u8 SpritePattern = 0
u8 DeltaX = 0
u8 DeltaY = 0

data SpaceTrainerSinX words
  $0000,$0042,$007F,$00B5,$00DD,$00F7,$0100,$00F7
  $00DD,$00B5,$007F,$0042,$0000,$FFBD,$FF80,$FF4A
  $FF22,$FF08,$FF00,$FF08,$FF22,$FF4A,$FF80,$FFBD
end data

data SpaceTrainerSinY words
  $FF00,$FF08,$FF22,$FF4A,$FF80,$FFBD,$0000,$0042
  $007F,$00B5,$00DD,$00F7,$0100,$00F7,$00DD,$00B5
  $007F,$0042,$0000,$FFBD,$FF80,$FF4A,$FF22,$FF08
end data

