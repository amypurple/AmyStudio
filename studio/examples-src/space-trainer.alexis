    db $83,$38,$42,$0C,$11,$40,$1A,$12
    db $80,$1A,$92,$18
    db $83,$38,$42,$0C,$11,$40,$1A,$12
    db $98

SpaceTrainerMusicB:
    db $FE,$FE,$FE,$FE,$FE,$FE,$EC
    db $C1,$38,$C0,$02,$CC,$FA
    db $C1,$38,$B0,$02,$CC,$FA
    db $C1,$38,$A0,$02,$CC,$FA
