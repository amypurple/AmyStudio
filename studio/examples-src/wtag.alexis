' a timer for the title tune (kit/tuneonce.py)
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
' the game
Ghoul Gh[3]
u8 Level = 1
u8 Best = 1
u8 PX = 16
u8 PY = 143
u8 PF = 5
u8 Cacc = 0
u8 Stride = 0
u8 StrideC = 0
u8 Pose = 0
u8 Steps = 1
u8 Keys = 0
u8 KF[3]
u8 KC[3]
u8 KOn[3]
u8 WOn = 0
u8 WF = 0
u8 WX = 0
u8 Anim = 0
u8 State = 0
u8 Paused = 0
u8 Caught = 0
' input: J the stick (1 up, 2 down, 4 left, 8 right, 16 a button)
u8 J = 0
u8 OldJ = 0
u8 Press = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
' loop counters (never shared with the helpers)
u8 Gi = 0
u8 Si = 0
u8 Ki = 0
u8 Ti = 0
u8 Fi = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table WtSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    CreditsPage
    goto title
  end if
  NewGame
  RunGame
  ' the end: GAME OVER, the level reached, then the title on a press
  HideSprites
  print at 2,MsgRow, "   GAME OVER  LEVEL " + digits$(Level, 2) + "    "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a game: levels until a creature catches the hero

sub NewGame:
  Level = 1
  copy GhStart to Gh
  PX = MinX
  PF = 5
  PY = FloorY[5]
  Cacc = 0
  Stride = 0
  StrideC = 0
  Pose = 0
  Paused = 0
  Caught = 0
  State = 0
  return
end sub

sub RunGame:
  DrawCastle
  StartLevel
  ShowScreen
  play sound SndMagic
  print at 2,MsgRow, "  FIND THE KEYS, TAG HIM!  "
  for Ti = 1 to 90
    Frame1
    DrawSprites
  next
  ClearMsg
  State = 1
  OldJ = 31
rg_loop:
  Frame1
  GetInput
  PlayStep
  DrawSprites
  if State = 1 then goto rg_loop
  if State = 4 then
    TagAnim
    if Level < 99 then inc Level
    if Level > Best then Best = Level
    StartLevel
    State = 1
    goto rg_loop
  end if
  CaughtAnim
  return
end sub

' a new level: keys scattered, the wizard hidden, the creatures' tries
sub StartLevel:
  Keys = 0
  WOn = 0
  Steps = StepsFor(Level)
  for Ki = 0 to 2
    PlaceKey(Ki)
  next
  ShowStatus
  return
end sub

function StepsFor(u8 L) as u8
  if L > 8 then return 8
  return L

' key I: the first on the top floor, the others on floors 2-6, in a free
' column away from the ladders, the other keys and the hero
sub PlaceKey(u8 I):
  u8 Ok = 0
  while Ok = 0
    Rand
    if I = 0 then
      KF[I] = 0
    else
      KF[I] = (Rs >> 4) % 5 + 1
    end if
    KC[I] = KeyCols[(Rs >> 9) & 7]
    Ok = 1
    if I > 0 then
      for Si = 0 to I - 1
        if KF[Si] = KF[I] and KC[Si] = KC[I] then Ok = 0
      next
    end if
    if KF[I] = PF then
      if KeyNearHero(KC[I]) = 1 then Ok = 0
    end if
  end while
  KOn[I] = 1
  DrawKey(I)
  return
end sub

function KeyNearHero(u8 Col) as u8
  u8 Kx = 0
  Kx = Col * 8
  if Kx + 24 < PX then return 0
  if Kx > PX + 24 then return 0
  return 1

' one frame of play: pause, the hero, the keys, the wizard, the creatures
sub PlayStep:
  if Press = 1 then
    Paused = Paused ^ 1
    play sound SndPick
    if Paused = 1 then
      print at 12,MsgRow, "PAUSED"
    else
      ClearMsg
    end if
  end if
  if Paused = 1 then return
  inc Anim
  MoveHero
  CheckKeys
  if WOn = 1 then CheckWizard
  MoveGhouls
  CheckCaught
  return
end sub

' the hero walks only on a floor and climbs only at a ladder
sub MoveHero:
  if PY = FloorY[PF] then
    ' standing on floor PF
    if (J & 2) <> 0 and PF < 5 then
      X = LadderAt(PF)
      if X > 0 then
        PX = X
        Climb(1)
        return
      end if
    end if
    if (J & 1) <> 0 and PF > 0 then
      X = LadderAt(PF - 1)
      if X > 0 then
        PX = X
        Climb(0)
        return
      end if
    end if
    Pose = 0
    if (J & 4) <> 0 and PX > MinX then
      dec PX
      Walk
    end if
    if (J & 8) <> 0 and PX < MaxX then
      inc PX
      Walk
    end if
  else
    ' on a ladder: up or down only
    if (J & 2) <> 0 then
      Climb(1)
    else
      if (J & 1) <> 0 then Climb(0)
    end if
  end if
  return
end sub

' the x of a ladder within reach in gap G (between floor G and G + 1), or 0
function LadderAt(u8 G) as u8
  u8 Lx = 0
  Lx = LadA[G]
  if PX + 6 >= Lx and PX <= Lx + 6 then return Lx
  Lx = LadB[G]
  if Lx = 0 then return 0
  if PX + 6 >= Lx and PX <= Lx + 6 then return Lx
  return 0

' a step on the ladder (Down 1 or 0), about 0.6 pixel a frame
sub Climb(u8 Down):
  Pose = 2
  Cacc = Cacc + ClimbAdd
  if Cacc >= ClimbAdd then return
  if Down = 1 then
    inc PY
  else
    dec PY
  end if
  ' a rung's tick every 8 pixels
  if (PY & 7) = 0 then play sound SndRung
  ' which floor the hero is on (or between): the floor above his feet
  PF = (PY - 23) / 24
  if PY < FloorY[PF] then PF = PF - 1
  return
end sub

sub Walk:
  inc StrideC
  if StrideC >= 6 then
    StrideC = 0
    Stride = Stride ^ 1
  end if
  Pose = Stride
  return
end sub

sub CheckKeys:
  if PY <> FloorY[PF] then return
  for Ki = 0 to 2
    if KOn[Ki] = 1 and KF[Ki] = PF then
      X = KC[Ki] * 8
      T = PX + 8
      if T >= X and T <= X + 16 then
        KOn[Ki] = 0
        inc Keys
        EraseKey(Ki)
        play sound SndKey
        if Keys = 3 then ShowWizard
        ShowStatus
      end if
    end if
  next
  return
end sub

' the wizard appears on a floor with no creature (2, 4 or 6), not the
' hero's, at least 64 pixels from him
sub ShowWizard:
  Rand
  WF = ((Rs >> 3) % 3) * 2 + 1
  if WF = PF then
    WF = WF + 2
    if WF > 5 then WF = 1
  end if
  Rand
  WX = (Rs >> 5) % 177 + 24
  if PY = FloorY[WF] then
    if WX + 64 > PX and WX < PX + 64 then WX = WX + 100
  end if
  if WX > MaxX - 8 then WX = WX - 180
  WOn = 1
  play sound SndMagic
  return
end sub

sub CheckWizard:
  if PY <> FloorY[WF] then return
  if PX + 12 > WX and PX < WX + 12 then State = 4
  return
end sub

' every creature gets Steps tries a frame; a try moves it a pixel when a
' random byte is under its threshold; it turns at the ends
sub MoveGhouls:
  u8 Gx = 0
  u8 Gd = 0
  u8 Gp = 0
  for Gi = 0 to 2
    Gx = Gh[Gi].X
    Gd = Gh[Gi].D
    Gp = Gh[Gi].P
    for Si = 1 to Steps
      Rand
      if (Rs & 255) < Gp then
        if Gd = 1 then
          inc Gx
          if Gx >= GMaxX then Gd = 0
        else
          dec Gx
          if Gx <= GMinX then Gd = 1
        end if
      end if
    next
    Gh[Gi].X = Gx
    Gh[Gi].D = Gd
  next
  return
end sub

sub CheckCaught:
  for Gi = 0 to 2
    if Touches(Gi) = 1 then
      State = 2
      Caught = Gi + 1
      return
    end if
  next
  return
end sub

' the hero's box (x + 4 .. x + 11) against a creature's (x + 2 .. x + 29),
' both 13 pixels tall
function Touches(u8 I) as u8
  i16 Dy = 0
  Y = FloorY[Gh[I].F]
  Dy = PY
  Dy = Dy - Y
  if Dy >= 13 or Dy <= -13 then return 0
  X = Gh[I].X
  if PX + 12 <= X + 2 then return 0
  if PX + 4 >= X + 30 then return 0
  return 1

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub GetInput:
  ReadPads
  J = Pads
  Press = 0
  if (J & 16) <> 0 then
    if (OldJ & 16) = 0 then Press = 1
  end if
  OldJ = J
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' ---------------------------------------------------------------------------
' the end of a level, the end of the game

sub TagAnim:
  play sound SndTag
  ' (Level + 1 inside digits$ after a string is refused: bugs/wtag-digits-expr-concat)
  T = Level + 1
  print at 2,MsgRow, "    TAGGED! ON TO LEVEL " + digits$(T, 2) + " "
  for Ti = 1 to 100
    Frame1
    inc Anim
    DrawSprites
  next
  WOn = 0
  ClearMsg
  return
end sub

' the caught hero blinks (3 times a second) while the creature stands over
' him
sub CaughtAnim:
  play sound SndCaught
  for Ti = 0 to 119
    Frame1
    V = Ti % 20
    DrawSprites
    if V >= 10 then
      set sprite 0 to 207,0,0,0
      set sprite 1 to 207,0,0,0
      update sprites
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawCastle:
  NewScreen
  fill TCeil count 28 at 2,2
  for Fi = 0 to 5
    Y = Fi * 3 + 3
    fill TBg count 28 at 2,Y
    fill TBg count 28 at 2,Y + 1
    fill TFloor count 28 at 2,Y + 2
    ' torches between the ladders
    put char TTorch at 11,Y
    put char TTorch at 20,Y
  next
  for Fi = 0 to 4
    DrawLadder(LadA[Fi], Fi)
    if LadB[Fi] > 0 then DrawLadder(LadB[Fi], Fi)
  next
  return
end sub

' a ladder at pixel x Lx in gap G: through the floor and down the corridor
' below
sub DrawLadder(u8 Lx, u8 G):
  C = Lx >> 3
  Y = G * 3 + 5
  put char TRimL at C - 1,Y
  put char THolel at C,Y
  put char THoler at C + 1,Y
  put char TRimR at C + 2,Y
  for Si = 1 to 2
    put char TLadl at C,Y + Si
    put char TLadr at C + 1,Y + Si
  next
  return
end sub

sub DrawKey(u8 I):
  Y = KF[I] * 3 + 4
  put char TKeyl at KC[I],Y
  put char TKeyr at KC[I] + 1,Y
  return
end sub

sub EraseKey(u8 I):
  Y = KF[I] * 3 + 4
  fill TBg count 2 at KC[I],Y
  return
end sub

' row 1: the level, the keys held
sub ShowStatus:
  print at 2,1, "LEVEL " + digits$(Level, 2)
  print at 18,1, "KEYS"
  for Ki = 0 to 2
    if Ki < Keys then
      put char THudkey at 23 + Ki * 2,1
    else
      put char THudno at 23 + Ki * 2,1
    end if
  next
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,MsgRow
  return
end sub

sub DrawSprites:
  V = HeroB[Pose]
  K = HeroD[Pose]
  set sprite 0 to PY,PX,K,9
  set sprite 1 to PY,PX,V,5
  N = (Anim >> 3) & 1
  for Gi = 0 to 2
    Y = FloorY[Gh[Gi].F]
    X = Gh[Gi].X
    T = Gi * 2 + 2
    select case Gi
    case 0
      C = 3
    case 1
      C = 13
    case else
      C = 7
    end select
    set sprite T to Y,X,SGl0 + N * 8,C
    set sprite T + 1 to Y,X + 16,SGr0 + N * 8,C
  next
  if WOn = 1 then
    Y = FloorY[WF]
    set sprite 8 to Y,WX,SWd0 + N * 8,15
    set sprite 9 to Y,WX,SWr0 + N * 8,13
  else
    set sprite 8 to 207,0,0,0
    set sprite 9 to 207,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for K = 0 to NSpr - 1
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: WIZARD TAG in castle bricks, the hero chasing the wizard
' along a floor, START / CREDITS, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 512 to vram.name + 32
  fill TFloor count 28 at 2,19
  print at 9,21, "BEST LEVEL " + digits$(Best, 2)
  Sel = 0
  ShowMenu
  PX = 40
  WX = 120
  Anim = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 432
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  ReadPads
  TitleDemo
  N = Pads & (Pads ^ OldPads)
  if (N & 3) <> 0 then
    Sel = Sel ^ 1
    play sound SndPick
    ShowMenu
  end if
  if (N & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,16
  put char 32 at 10,17
  put char 62 at 10,Sel + 16
  print at 12,16, "START"
  print at 12,17, "CREDITS"
  return
end sub

' the hero chases the wizard round the floor at row 18
sub TitleDemo:
  inc Anim
  inc PX
  if (Anim & 1) = 0 then inc WX
  if PX > 239 then PX = 0
  if WX > 239 then WX = 0
  N = (Anim >> 3) & 1
  V = HeroB[N]
  K = HeroD[N]
  set sprite 0 to 135,PX,K,9
  set sprite 1 to 135,PX,V,5
  set sprite 2 to 135,WX,SWd0 + N * 8,15
  set sprite 3 to 135,WX,SWr0 + N * 8,13
  update sprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "WIZARD  TAG"
  print at 2,5, "BASED ON WIZARD TAG BY"
  print at 2,6, "BOB BLACKMER, AHOY! MARCH"
  print at 2,7, "1987 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: UP THE TOWER STAIRS"
  print at 2,17, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

