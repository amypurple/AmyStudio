TpBad:
    db $40,$3B,$12,$0A,$40,$F9,$22,$14,$50
TpEnd:
    db $40,$D6,$20,$0A,$40,$1D,$21,$0A,$40,$53,$21,$0A,$40,$AB,$21,$18,$50

TpSoundTable:
    dw TpTuneMel,$702B
    dw TpTuneBass,$7035
    dw TpBeep,$7049
    dw TpHum,$7049
    dw TpHumHi,$7049
    dw TpFry,$703F
    dw TpAlarm,$7049
    dw TpGood,$7049
    dw TpBad,$7049
    dw TpEnd,$7049
; Transporter Room (original)
; Tiny Sound, 8 frames per step
TpTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$1C,$01,$21,$01,$24,$01,$23,$01,$01,$21
    db $1F,$01,$1C,$01,$1D,$01,$21,$01,$26,$01,$24,$01,$23,$01,$1F,$01
    db $21,$01,$01,$01,$28,$01,$01,$26,$24,$01,$23,$01,$21,$01,$24,$01
    db $28,$01,$01,$01,$26,$01,$23,$01,$20,$01,$23,$01,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
TpTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$15,$01,$1C,$01,$15,$01,$1C,$01,$13,$01,$1A,$01
    db $13,$01,$1A,$01,$11,$01,$18,$01,$11,$01,$18,$01,$10,$01,$17,$01
    db $10,$01,$17,$01,$15,$01,$1C,$01,$15,$01,$1C,$01,$11,$01,$18,$01
    db $0E,$01,$15,$01,$10,$01,$17,$01,$10,$01,$14,$01,$15,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
