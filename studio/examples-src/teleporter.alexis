    db $40,$47,$20,$03,$40,$47,$40,$03,$50
TpHum:
    db $40,$FC,$31,$02,$40,$E0,$51,$02,$40,$C5,$61,$02,$50
TpHumHi:
    db $40,$53,$31,$02,$40,$41,$51,$02,$40,$2E,$61,$02,$50
TpFry:
    db $00,$00,$04,$04,$00,$00,$15,$06,$00,$00,$36,$08,$00,$00,$56,$0A,$00,$00,$77,$0E,$10
TpAlarm:
