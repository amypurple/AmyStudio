end data
data TileCol bytes
  $8F,$8F,$8F,$8F,$8F,$8F,$8F,$8F
  $8F,$8F,$8F,$8F,$8F,$81,$01,$01
  $04,$04,$04,$54,$04,$04,$04,$04
  $04,$54,$04,$04,$04,$04,$04,$04
  $04,$04,$04,$04,$E4,$4E,$4E,$0E
  $07,$07,$57,$57,$05,$05,$05,$05
  $68,$68,$68,$68,$68,$68,$68,$68
  $68,$68,$68,$68,$68,$68,$68,$68
  $1A,$1A,$1A,$1A,$1A,$1A,$1A,$1A
  $0B,$0B,$0A,$0A,$01,$06,$06,$06
  $06,$B6,$06,$06,$06,$B6,$06,$01
  $06,$06,$06,$B6,$06,$06,$06,$01
  $01,$1E,$1E,$E1,$E1,$1E,$1E,$01
