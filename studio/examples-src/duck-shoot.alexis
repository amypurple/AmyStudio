cartridge "DUCK SHOOT/BOB BLACKMER/1985"

' DUCK SHOOT
' A ColecoVision game based on "Duck Shoot" by Bob Blackmer, Ahoy! June
' 1985 (Commodore 64, BASIC; author from the issue's contents page).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/duckshoot.bas), the game is built for the ColecoVision:
' smooth 16 x 16 sprites, a tiled fairground booth, sound effects and an
' original title tune.
'
' The game: tin ducks cross the gallery window from left to right, one at
' a time, each at a random height. Aim the sight with the stick and shoot
' with a button: a duck is worth 25. Every duck is a little faster than
' the one before. Every 10 ducks shot (10, 20 ... 80) comes a target round:
' ten bullseyes pop up one after another at random places, each for a short
' time (shorter from 40 ducks on), worth 50 each. Let four ducks in a row
' get away and the game is over.
'
' From the original: one duck at a time from the left edge to the right
' edge at a random height; the sight moved by the stick inside the window;
' 25 a duck, 50 a target; every duck faster than the last (+0.4 pixel a
' pass); target rounds after 10, 20 ... 80 ducks with ten targets each,
' each up for 30 passes (25 from 40 ducks on); four ducks missed in a row
' end the game; final score = ducks x 25 + targets x 50; a high score.
'
' Liberties: the speeds are in pixels a frame, taken from an estimated
' 20 passes a second of the BASIC loop (not measured): the first duck
' 0.75 pixel a frame, +1/8 pixel each duck, held at 3 pixels a frame (the
' listing climbs to 33 pixels a pass, which no one can hit); a target stays
' 90 frames (75). The original shot whenever the button was down (hold it
' and only steer up and down): here each press is one shot with a short
' reload, and it hits what is under the centre of the sight. From 10 ducks
' on the ducks bob up and down, so parking the sight on one height does not
' work (the duck heights were random already). A hit duck tumbles down
' instead of vanishing. The score, the ducks and the misses in a row (four
' lamps) are shown during play. The sight moves 2 pixels a frame.
'
' Controls: either controller; the stick aims, either side button shoots.
' On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes faster than 3 Hz.
'
' Workarounds for Amy bugs actnaut-return-narrow removed 2026-11-01.

const TAwr = 128
const TAwe = 129
const TWall = 130
const TWall2 = 131
const TWave = 132
const TWavef = 133
const TCurl = 134
const TCurr = 135
const TPost = 136
const TCtop = 137
const TCfr = 138
const TCfr2 = 139
const TLamp0 = 140
const TLamp1 = 141
const TIcon = 142
const SCross = 0
const SBeak0 = 4
const SDuck0 = 8
const SDuck1 = 12
const SHitd = 16
const SHitb = 20
const STgred = 24
const STgwht = 28
const SShot = 32
const NTiles8 = 120
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndShot = 3
const SndHit = 4
const SndDing = 5
const SndGone = 6
const SndRound = 7
const SndStart = 8
const SndOver = 9
const NSpr = 6
const XMin = 28
const XMax = 204
const YMin = 28
const YMax = 108
const DxStart = 24
const DxEnd = 216
const SpFirst = 12
const SpAdd = 2
const SpMax = 48
const Reload = 12
const FallEnd = 120
const TGap = 15
const MissMax = 4

' the bob of the ducks from 10 ducks on (0..12, 6 is the middle)
data WobT bytes
  6, 8, 10, 11, 12, 11, 10, 8, 6, 4, 2, 1, 0, 1, 2, 4
end data

state machine Phase:
  Flying calls DoFly
  Falling calls DoFall
  Targets calls DoTargets
end state machine

record Duck:
  u16 X16
  u8 Base
  u8 Y
  u8 Sp
  u8 Fr
end record

Duck Dk
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 Ph = 0
u8 Nd = 0
u8 Miss = 0
u8 Over = 0
u8 Scr = 0
' the sight
u8 Cx = 108
u8 Cy = 64
u8 ShotT = 0
u8 BurstT = 0
u8 Bx = 0
u8 By = 0
' the target round: targets left, time left, gap, place, shown
u8 Tn = 0
u8 Tt = 0
u8 Tg = 0
u8 Tx = 0
u8 Ty = 0
u8 Ton = 0
u8 TLife = 90
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters
u8 Li = 0
u8 Ri = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  MoveSight
  dispatch Ph using Phase
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  Scr = 4
  HideSprites
  if Score > Hi then Hi = Score
  ShowHud
  mute all
  for Ri = 7 to 12
    fill 32 count 18 at 7,Ri
  next
  print at 11,8, "GAME OVER"
  print at 9,10, "SCORE ", Score
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' play

' the sight: 2 pixels a frame inside the window; a press shoots
sub MoveSight:
  K = J1 | J2
  V = K & 1
  if V > 0 then
    if Cy > YMin + 1 then Cy -= 2
  end if
  V = K & 2
  if V > 0 then
    if Cy < YMax - 1 then Cy += 2
  end if
  V = K & 4
  if V > 0 then
    if Cx > XMin + 1 then Cx -= 2
  end if
  V = K & 8
  if V > 0 then
    if Cx < XMax - 1 then Cx += 2
  end if
  if ShotT > 0 then dec ShotT
  if BurstT > 0 then dec BurstT
  if Press = 1 then
    if ShotT = 0 then
      ShotT = Reload
      BurstT = 6
      Bx = Cx
      By = Cy
      play sound SndShot
    end if
  end if
  return
end sub

' 1 when the shot fired this frame lands inside the box at L, T (W x H)
function ShotIn(u8 L, u8 T, u8 W, u8 H) as u8
  u8 Px = 0, Py = 0
  if BurstT <> 6 then return 0
  Px = Bx + 8
  Py = By + 8
  if Px < L then return 0
  if Py < T then return 0
  if Px >= L + W then return 0
  if Py >= T + H then return 0
  return 1

function DuckX as u8
  return Dk.X16 >> 4

sub DoFly:
  Dk.X16 += Dk.Sp
  if Nd >= 10 then
    V = (Tick >> 2) & 15
    Dk.Y = Dk.Base + WobT[V] - 6
  else
    Dk.Y = Dk.Base
  end if
  X = DuckX
  if X > DxEnd then
    ' got away
    inc Miss
    ShowLamps
    if Miss >= MissMax then
      Over = 1
      return
    end if
    play sound SndGone
    NextDuck
    return
  end if
  if ShotIn(X + 1, Dk.Y + 1, 14, 14) = 1 then
    if Nd < 250 then inc Nd
    Score += 25
    Miss = 0
    ShowHud
    ShowLamps
    play sound SndHit
    Ph = Phase.Falling
  end if
  return
end sub

sub DoFall:
  Dk.Y += 3
  if Dk.Y < FallEnd then return
  select case Nd
  case 10, 20, 30, 40, 50, 60, 70, 80
    StartTargets
  case else
    NextDuck
  end select
  return
end sub

sub StartTargets:
  Ph = Phase.Targets
  Tn = 10
  Tg = 30
  Ton = 0
  TLife = 90
  if Nd >= 40 then TLife = 75
  fill 32 count 28 at 2,4
  print at 9,4, "TARGET ROUND"
  play sound SndRound
  return
end sub

sub DoTargets:
  if Ton = 0 then
    dec Tg
    if Tg > 0 then return
    if Tn = 0 then
      ShowSign
      NextDuck
      return
    end if
    dec Tn
    Tx = RandIn(44, 156)
    Ty = RandIn(40, 64)
    Tt = TLife
    Ton = 1
    return
  end if
  if ShotIn(Tx + 2, Ty + 2, 12, 12) = 1 then
    Score += 50
    ShowHud
    play sound SndDing
    Ton = 0
    Tg = TGap
    return
  end if
  dec Tt
  if Tt = 0 then
    Ton = 0
    Tg = TGap
  end if
  return
end sub

' a new duck from the left edge at a random height, a little faster
sub NextDuck:
  Ph = Phase.Flying
  Dk.X16 = DxStart * 16
  Dk.Base = RandIn(40, 52)
  Dk.Y = Dk.Base
  if Dk.Sp < SpMax then Dk.Sp += SpAdd
  return
end sub

' a number from Lo to Lo + Span - 1
function RandIn(u8 Lo, u8 Span) as u8
  u8 Q = 0
  Rand
  W16 = Rs % Span
  Q = W16
  return Lo + Q

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' 0 the sight, 1 the shot, 2-3 the duck (beak, body), 4-5 the target
sub DrawSprites:
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
  else
    Y = Cy - 1
    set sprite 0 to Y,Cx,SCross,15
  end if
  if BurstT > 0 then
    Y = By - 1
    set sprite 1 to Y,Bx,SShot,11
  else
    set sprite 1 to 192,0,0,0
  end if
  X = DuckX
  Y = Dk.Y - 1
  select case Ph
  case Phase.Flying
    V = (Tick >> 3) & 1
    K = SDuck0 + V * 4
    set sprite 2 to Y,X,SBeak0,8
    set sprite 3 to Y,X,K,11
  case Phase.Falling
    set sprite 2 to Y,X,SHitb,8
    set sprite 3 to Y,X,SHitd,11
  case else
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  end select
  if Ton = 1 then
    Y = Ty - 1
    set sprite 4 to Y,Tx,STgred,8
    set sprite 5 to Y,Tx,STgwht,15
  else
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE ", Score
  print at 18,1, "HI ", Hi
  NumU = Nd
  print at 2,22, "DUCKS ", digits$(NumU, 3)
  return
end sub

' the misses in a row: lit lamps, then unlit ones
sub ShowLamps:
  print at 15,22, "MISSES"
  fill TLamp0 count MissMax at 22,22
  if Miss > 0 then
    for Li = 1 to Miss
      J = 21 + Li
      put char TLamp1 at J,22
    next
  end if
  return
end sub

sub ShowSign:
  fill 32 count 28 at 2,4
  print at 8,4, "SHOOTING GALLERY"
  return
end sub

' the booth: awning, window, curtains, posts, waves, counter
sub DrawBooth:
  fill TAwr count 32 at 0,2
  fill TAwe count 32 at 0,3
  for Ri = 5 to 14
    fill TCurl count 4 at 0,Ri
    put char TPost at 4,Ri
    for J = 5 to 26
      V = (J + Ri * 3) & 7
      if V = 0 then
        put char TWall2 at J,Ri
      else
        put char TWall at J,Ri
      end if
    next
    put char TPost at 27,Ri
    fill TCurr count 4 at 28,Ri
  next
  fill TCurl count 4 at 0,15
  fill TCurl count 4 at 0,16
  fill TCurr count 4 at 28,15
  fill TCurr count 4 at 28,16
  put char TPost at 4,15
  put char TPost at 4,16
  put char TPost at 27,15
  put char TPost at 27,16
  fill TWave count 22 at 5,15
  fill TWavef count 22 at 5,16
  fill TCtop count 32 at 0,17
  for Ri = 18 to 20
    for J = 0 to 31 step 2
      put char TCfr at J,Ri
      K = J + 1
      put char TCfr2 at K,Ri
    next
  next
  ShowSign
  return
end sub

sub NewGame:
  Score = 0
  Nd = 0
  Miss = 0
  Over = 0
  TitleOn = 0
  Ton = 0
  ShotT = 0
  BurstT = 0
  Cx = 108
  Cy = 64
  Dk.Sp = SpFirst - SpAdd
  NewScreen
  DrawBooth
  ShowHud
  ShowLamps
  NextDuck
  DrawSprites
  ShowScreen
  Scr = 3
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the booth, a duck crossing the window, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawBooth
  print at 11,6, "DUCK SHOOT"
  put char TIcon at 9,6
  put char TIcon at 22,6
  print at 8,8, "BY BOB BLACKMER"
  print at 11,10, "START GAME"
  print at 11,11, "CREDITS"
  print at 2,1, "HI ", Hi
  print at 15,1, "AHOY! JUN 1985"
  print at 6,22, "JOYSTICK AND BUTTON"
  ShowMenu
  TitleOn = 1
  Ton = 0
  BurstT = 0
  Nd = 0
  Dk.Sp = 16
  NextDuck
  Dk.Base = 100
  ShowScreen
  Scr = 2
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  Dk.X16 += Dk.Sp
  Dk.Y = Dk.Base
  X = DuckX
  if X > DxEnd then Dk.X16 = DxStart * 16
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,10
  put char 32 at 9,11
  J = Menu + 10
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  print at 11,2, "DUCK SHOOT"
  print at 2,5, "BASED ON DUCK SHOOT BY"
  print at 2,6, "BOB BLACKMER, AHOY! JUNE"
  print at 2,7, "1985 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: STEP RIGHT UP"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Scr = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $F0,$F0,$F0,$F0,$F0,$F0,$F0,$F0
  $F0,$F0,$F0,$F0,$F0,$60,$00,$00
  $00,$00,$00,$04,$00,$00,$00,$00
  $00,$40,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$30,$87,$01,$00
  $00,$00,$81,$C3,$00,$00,$00,$00
  $22,$22,$44,$44,$44,$22,$22,$22
  $44,$44,$22,$22,$22,$44,$44,$44
  $81,$81,$81,$81,$81,$81,$81,$81
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$10,$00,$00,$00,$01,$00,$00
  $00,$00,$00,$40,$00,$00,$00,$00
  $00,$C3,$99,$42,$42,$99,$C3,$00
  $00,$C3,$81,$18,$18,$81,$C3,$00
