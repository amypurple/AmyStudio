data SpritePat bytes
  $03,$0D,$11,$21,$40,$40,$80,$F1,$F1,$80,$40,$40,$21,$11,$0D,$03
  $C0,$B0,$88,$84,$02,$02,$01,$8F,$8F,$01,$02,$02,$84,$88,$B0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$08,$03,$03,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$80,$C7,$EF,$F8,$78,$3E,$1F,$07,$00
  $00,$3C,$7E,$76,$7C,$3C,$18,$38,$FC,$FC,$FE,$7E,$FE,$FC,$F0,$00
  $00,$00,$00,$00,$00,$0E,$0F,$87,$C3,$E3,$FD,$7F,$3F,$1F,$07,$00
  $00,$3C,$7E,$76,$7C,$3C,$98,$E8,$FC,$FC,$FC,$FC,$FC,$FC,$F0,$00
  $00,$07,$1F,$3E,$78,$F8,$EF,$C7,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$F0,$FC,$FE,$7E,$FE,$FC,$FC,$38,$18,$3C,$7E,$7E,$7E,$3C,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$03,$08,$00,$00,$00
  $00,$07,$1F,$38,$70,$63,$C7,$C7,$C7,$C7,$63,$70,$38,$1F,$07,$00
  $00,$E0,$F8,$1C,$0E,$C6,$E3,$E3,$E3,$E3,$C6,$0E,$1C,$F8,$E0,$00
  $00,$00,$00,$07,$0F,$1C,$38,$38,$38,$38,$1C,$0F,$07,$00,$00,$00
  $00,$00,$00,$E0,$F0,$38,$1C,$1C,$1C,$1C,$38,$F0,$E0,$00,$00,$00
  $00,$00,$00,$00,$00,$04,$02,$0F,$02,$04,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$90,$A0,$F8,$A0,$90,$80,$00,$00,$00,$00,$00
end data

asm {
DkShot:
    db $00,$00,$04,$02,$00,$00,$15,$03,$00,$00,$36,$05,$10
DkHit:
    db $40,$47,$10,$03,$40,$5F,$10,$03,$40,$7F,$10,$03,$40,$BF,$20,$08,$50
DkDing:
    db $40,$35,$10,$03,$40,$2A,$10,$03,$40,$24,$20,$0E,$50
DkGone:
    db $40,$53,$21,$06,$40,$C5,$31,$0A,$50
DkRound:
    db $40,$8F,$10,$05,$40,$71,$10,$05,$40,$5F,$10,$05,$40,$47,$20,$10,$50
DkStart:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$06,$40,$6B,$20,$0E,$50
DkOver:
    db $40,$1D,$11,$0C,$40,$41,$21,$0C,$40,$53,$21,$0C,$40,$AB,$21,$1E,$50

DkSoundTable:
    dw DkTuneMel,$702B
    dw DkTuneBass,$7035
    dw DkShot,$703F
    dw DkHit,$7049
    dw DkDing,$7049
    dw DkGone,$7049
    dw DkRound,$7049
    dw DkStart,$7049
    dw DkOver,$7049
; Step Right Up (original)
; Tiny Sound, 8 frames per step
DkTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1A,$01,$1F,$23,$01,$26,$24,$01,$23,$21,$01,$01
    db $18,$01,$1E,$21,$01,$24,$23,$01,$21,$1F,$01,$01,$1A,$01,$1F,$23
    db $01,$26,$28,$01,$26,$24,$01,$23,$21,$01,$23,$24,$01,$21,$1F,$01
