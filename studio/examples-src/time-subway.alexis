cartridge "TIME SUBWAY/C. M. BLAKEMORE/1988"

' TIME SUBWAY
' A ColecoVision game based on "Time Subway" by Cleveland M. Blakemore,
' based on a concept by Lynwood Brooks, Ahoy! April 1988 (Commodore 64,
' BASIC with machine-language sprite and scroll routines; disk image
' ahoy1988-04, listing in orig/). Made for Amy Studio by Claude (an AI made
' by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The game: a crazed doctor is hiding somewhere in time, at one of 44
' great events between 0 and 1984 A.D. You start on the platform of the
' 1988 station of the Space-Time Continuum Subway. The INFO terminal on
' the platform names the event at this station (if any), the event the
' doctor's presence is registered near, and lets you set the subway's
' motion: into the past or the future. Board the train at its door and
' the years roll by; press the button to stop at a station. Walk into the
' doctor on his station's platform to stop him. On the other platforms a
' crowd of alien nasties wanders about: touching one throws you to a
' random year. Every moment on a platform and every year travelled adds
' to the time distortion: at 100% you are lost in time.
'
' From the original (orig/tsubway.bas): the 45 time crossroads (the
' doctor is hidden at one of the first 44, as RND(1)*44+1 chose), the
' start in 1988, the INFO terminal's two reports (this station's event,
' the doctor's era and year) and its past/future choice (past at first),
' the train door to board, years rolling one by one in the chosen
' direction until the button stops them, wrapping between 0 and 1988 at
' both ends, the time distortion growing by 0.025% per platform pass and
' per year rolled (lost at 100%), three alien nasties of three random
' kinds and colours starting along the bottom of the platform and turning
' in random directions, the doctor's platform with no aliens, a touched
' alien throwing the player to a random year (the journey screen goes on
' from there), and the two endings.
'
' Liberties: smooth 16 x 16 sprites, tiled platform, train and tunnel,
' sound effects and an original title tune instead of the PETSCII screens
' and SID beeps. The distortion grows by 0.025% every 6 frames on the
' platform (the BASIC main loop ran about 10 passes a second). The years
' roll at 15 a second; holding the stick in the train's direction
' rolls 3 a frame (express), against it about 4 a second (to stop at an
' exact year): the BASIC loop only had one speed, and a human could not
' have stopped on a year at an express speed; the button is read before
' the pass's years roll. The aliens walk a pixel a frame (the player's
' speed), the doctor every other frame. A touched alien warps you
' with a message instead of an explosion and a colour flash. The doctor
' wanders his platform (on the C64 he stood still while the crowd's
' fourth sprite moved). The player is fenced off the INFO terminal and
' the train, and the aliens wander only the platform (on the C64 they
' could cross the train). Event spellings are corrected (Ericsson,
' Conqueror, Bayeux, Titanic...) and some names shortened to fit 28
' columns; the years are the listing's. The C64 asked PLAY AGAIN (Y/N);
' here the end message waits for a press and goes back to the title.
' A count of the stations visited is shown at the end.
'
' Controls: either controller; the stick walks; a button at the train
' door boards the train, a button at the INFO terminal reads it. On the
' INFO screen, left/right choose past or future, a button returns. On the
' journey, a button stops the train. On the title, up/down choose, a
' button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given (bug
' 25). Own xorshift random numbers. Nothing flashes.

const TCeil = 128
const TLamp = 129
const TRoof = 130
const TBody = 131
const TWinl = 132
const TWinr = 133
const TStripe = 134
const TSkirt = 135
const TGap = 136
const TDoorl = 137
const TDoorr = 138
const TDoorlb = 139
const TDoorrb = 140
const TOpen = 141
const TSeat = 142
const TEdge = 143
const TFl0 = 144
const TFl1 = 145
const TBase = 146
const TKt0 = 147
const TKt1 = 148
const TKm0 = 149
const TKm1 = 150
const TKb0 = 151
const TKb1 = 152
const TTun = 153
const TTun0 = 154
const TTun1 = 155
const TRail = 156
const TFtl = 157
const TFtr = 158
const TFbl = 159
const TFbr = 160
const TFh = 161
const TFhb = 162
const TFvl = 163
const TFvr = 164
const TArl = 165
const TArr = 166
const TArld = 167
const TArrd = 168
const SSuit0 = 0
const SSuit1 = 4
const SHead = 8
const SDcoat0 = 12
const SDcoat1 = 16
const SDhair = 20
const SBug0 = 24
const SBug1 = 28
const SBlob0 = 32
const SBlob1 = 36
const SEye0 = 40
const SEye1 = 44
const NTiles8 = 328
const SprBytes = 384
const SndTuneA = 1
const SndTuneB = 2
const SndDoor = 3
const SndBeep = 4
const SndClick = 5
const SndTick = 6
const SndWarp = 7
const SndArrive = 8
const SndWin = 9
const SndLose = 10
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0
const NSpr = 6
const WMax = 4000
const WTickN = 6
const PxMin = 16
const PxMax = 224
const PyMin = 72
const PyMax = 160
const AxMax = 200
const DoorX0 = 112
const DoorX1 = 128
const DoorY = 76
const KioskX = 192
const KioskY = 128
const KioskZ = 124
const WarpN = 90
const YMax = 1988

' the eight directions: 0 up, 1 up-right ... 7 up-left; 0 is -1, 1 stays,
' 2 is +1
data DXT bytes
  1, 2, 2, 2, 1, 0, 0, 0
end data
data DYT bytes
  0, 0, 1, 2, 2, 2, 1, 0
end data
data StartX bytes
  40, 104, 168
end data
data MobCols bytes
  3, 7, 8, 13, 10, 12, 9, 5
end data

record Mob:
  u8 X
  u8 Y
  u8 D
  u8 Kd
  u8 Cl
end record

Mob Mobs[3]

u16 Rs = 1
u16 Yr = 1988
u16 Ty = 0
u16 W = 0
u16 W16 = 0
u16 NumU = 0
u8 Ti = 0
u8 Ev = 0
u8 Dd = 0
u8 Wf = 0
u8 Ta = 0
u8 Pct = 0
u8 OldPct = 255
u8 Doc = 0
u8 Na = 3
u8 Px = 120
u8 Py = 76
u8 Pm = 0
u8 Pf = 0
u8 Go = 0
u8 Hit = 0
u8 Over = 0
u8 St = 9
u8 WarpT = 0
u8 TunT = 0
u8 TunF = 0
bcd digits 4 Visits
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Ri = 0
u8 Ci = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

platform:
  EnterPlatform
plat_loop:
  Frame1
  ReadPad
  PlatStep
  DrawSprites
  if Over > 0 then goto the_end
  if Hit = 1 then goto warped
  if Go = 1 then goto journey
  if Go = 2 then
    InfoPage
    goto platform
  end if
  goto plat_loop

warped:
  ' an alien nasty: thrown to a random year, the journey goes on from there
  Rand
  Yr = Rs mod 1989
  WarpT = WarpN
  St = 5
  play sound SndWarp
  print at 10,4, "          "
  print at 10,5, " TIME WARP "
  print at 10,6, "          "
warp_loop:
  Frame1
  dec WarpT
  if WarpT > 0 then goto warp_loop
  goto journey_go

journey:
  play sound SndDoor
  DoorOpen
  Rearm
  wait 20 frames
  nmi off
journey_go:
  EnterJourney
jour_loop:
  Frame1
  ReadPad
  JourneyStep
  AnimTunnel
  if Over > 0 then goto the_end
  if Go = 1 then
    play sound SndArrive
    Visits += 1
    Px = 120
    Py = DoorY
    goto platform
  end if
  goto jour_loop

the_end:
  ' the end: a message, then back to the title on a press
  St = 4
  mute all
  TzOn = 0
  HideSprites
  EndMessage
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

function AbsDiff(u8 A, u8 B) as u8
  if A >= B then
    return A - B
  end if
  return B - A

' the index + 1 of the event of year Yv, 0 when there is none
function FindEvent(u16 Yv) as u8
  for Ci = 0 to 44
    W16 = EvY[Ci]
    if W16 = Yv then
      return Ci + 1
    end if
  next
  return 0

sub AddW:
  inc W
  if W >= WMax then Over = 1
  return
end sub

' one platform pass
sub PlatStep:
  Go = 0
  inc Wf
  if Wf >= WTickN then
    Wf = 0
    AddW
    ShowPct
    if Over > 0 then return
  end if
  MovePlayer
  MoveMobs
  Collide
  if Hit = 1 then return
  if Over > 0 then return
  if Press = 0 then return
  if Py <= DoorY then
    if Px >= DoorX0 then
      if Px <= DoorX1 then
        Go = 1
        return
      end if
    end if
  end if
  if Px >= KioskX then
    if Py >= KioskZ then Go = 2
  end if
  return
end sub

sub MovePlayer:
  K = J1 | J2
  Pm = 0
  V = K & 1
  if V > 0 then
    if Py > PyMin then
      dec Py
      Pm = 1
    end if
  end if
  V = K & 2
  if V > 0 then
    if Py < PyMax then
      ' the INFO terminal: no walking down into it
      T = 1
      if Py = KioskY then
        if Px > AxMax then T = 0
      end if
      if T = 1 then
        inc Py
        Pm = 1
      end if
    end if
  end if
  V = K & 4
  if V > 0 then
    if Px > PxMin then
      dec Px
      Pm = 1
    end if
  end if
  V = K & 8
  if V > 0 then
    T = 1
    if Px >= PxMax then T = 0
    if Py > KioskY then
      if Px >= AxMax then T = 0
    end if
    if T = 1 then
      inc Px
      Pm = 1
    end if
  end if
  if Pm = 1 then inc Pf
  return
end sub

' the crowd (or the doctor): a turn now and then
sub MoveMobs:
  u8 Mx = 0
  u8 My = 0
  u8 Md = 0
  for Mi = 0 to 2
    if Mi < Na then
      Mx = Mobs[Mi].X
      My = Mobs[Mi].Y
      Md = Mobs[Mi].D
      Rand
      V = Rs & 31
      if V = 0 then
        W16 = Rs >> 8
        Md = W16 & 7
      end if
      ' the doctor walks a pixel every other frame, the aliens every frame
      V = Tick & Doc
      if V = 0 then
        X = Mx + DXT[Md] - 1
        Y = My + DYT[Md] - 1
        T = 1
        if X < PxMin then T = 0
        if X > AxMax then T = 0
        if Y < PyMin then T = 0
        if Y > PyMax then T = 0
        if T = 1 then
          Mx = X
          My = Y
        else
          Md = Md + 4
          Md = Md & 7
        end if
      end if
      Mobs[Mi].X = Mx
      Mobs[Mi].Y = My
      Mobs[Mi].D = Md
    end if
  next
  return
end sub

sub Collide:
  for Mi = 0 to 2
    if Mi < Na then
      X = Mobs[Mi].X
      Y = Mobs[Mi].Y
      if AbsDiff(Px, X) < 11 then
        if AbsDiff(Py, Y) < 12 then
          if Doc = 1 then
            Over = 2
          else
            Hit = 1
          end if
        end if
      end if
    end if
  next
  return
end sub

' one journey pass: the years roll in the chosen direction
sub JourneyStep:
  Go = 0
  ' the button stops the train before this pass's years roll
  if Press = 1 then
    Go = 1
    return
  end if
  K = J1 | J2
  ' 16ths of a year a frame: 4 normal, 48 with the stick toward the
  ' motion, 1 against it
  N = 4
  V = K & 12
  if V = 8 then
    if Dd = 1 then
      N = 48
    else
      N = 1
    end if
  end if
  if V = 4 then
    if Dd = 0 then
      N = 48
    else
      N = 1
    end if
  end if
  Ta = Ta + N
  N = Ta >> 4
  Ta = Ta & 15
  while N > 0
    RollYear
    if Over > 0 then return
    dec N
  end while
  return
end sub

sub RollYear:
  if Dd = 1 then
    if Yr = YMax then
      Yr = 0
    else
      inc Yr
    end if
  else
    if Yr = 0 then
      Yr = YMax
    else
      dec Yr
    end if
  end if
  AddW
  ShowYearBig
  ShowPctJ
  if K = 0 then play sound SndTick
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  Yr = YMax
  Dd = 0
  W = 0
  Wf = 0
  Ta = 0
  Over = 0
  Visits = 0
  inc Visits
  Rand
  Ti = Rs mod NTgt
  Ty = EvY[Ti]
  Px = 120
  Py = DoorY
  return
end sub

' a new platform: the station's year, the crowd at the bottom (none at
' the doctor's station, where he wanders alone)
sub EnterPlatform:
  Go = 0
  Hit = 0
  Wf = 0
  Doc = 0
  Na = 3
  if Yr = Ty then
    Doc = 1
    Na = 1
  end if
  for Mi = 0 to 2
    Mobs[Mi].X = StartX[Mi]
    Mobs[Mi].Y = PyMax
    Rand
    W16 = Rs >> 4
    V = W16 & 7
    Mobs[Mi].D = V
    W16 = Rs >> 8
    V = W16 mod 3
    Mobs[Mi].Kd = V
    V = Rs & 7
    Mobs[Mi].Cl = MobCols[V]
  next
  if Doc = 1 then
    Mobs[0].X = 40
    Mobs[0].Y = 150
  end if
  NewScreen
  DrawStation
  OldPct = 255
  ShowHud
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  St = 1
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  Y = Py - 1
  V = Pf >> 3
  V = V & 1
  K = SSuit0
  if V = 1 then K = SSuit1
  set sprite 0 to Y,Px,SHead,9
  set sprite 1 to Y,Px,K,5
  for Mi = 0 to 2
    J = Mi + 2
    if Mi < Na then
      X = Mobs[Mi].X
      Y = Mobs[Mi].Y - 1
      V = Tick >> 3
      V = V & 1
      if Doc = 1 then
        K = SDcoat0
        if V = 1 then K = SDcoat1
        set sprite 2 to Y,X,SDhair,14
        set sprite 3 to Y,X,K,15
      else
        T = Mobs[Mi].Kd
        select case T
        case 0
          K = SBug0
        case 1
          K = SBlob0
        case else
          K = SEye0
        end select
        if V = 1 then K = K + 4
        C = Mobs[Mi].Cl
        set sprite J to Y,X,K,C
      end if
    else
      if Doc = 0 then set sprite J to 192,0,0,0
      if Mi = 2 then set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowHud:
  NumU = Yr
  print at 2,1, width$(NumU, 4) + " A.D."
  print at 15,1, "DISTORTION"
  ShowPct
  return
end sub

sub ShowPct:
  Pct = W / 40
  if Pct = OldPct then return
  OldPct = Pct
  NumU = Pct
  print at 26,1, digits$(NumU, 3) + "%"
  return
end sub

sub ShowPctJ:
  Pct = W / 40
  if Pct = OldPct then return
  OldPct = Pct
  NumU = Pct
  print at 22,22, digits$(NumU, 3) + "%"
  return
end sub

sub ShowYearBig:
  NumU = Yr
  print at 13,18, width$(NumU, 4)
  return
end sub

' one row of the train (Ri screen row, C the train row 0-5)
sub TrainRow:
  for J = 0 to 31
    T = TBody
    select case C
    case 0
      T = TRoof
    case 1
      V = J & 3
      if V = 1 then T = TWinl
      if V = 2 then T = TWinr
    case 3
      T = TStripe
    case 5
      T = TSkirt
    end select
    if J = 9 then T = TGap
    if J = 22 then T = TGap
    put char T at J,Ri
  next
  return
end sub

' the door at rows R..R+3 (Ri the top row): closed
sub DoorClosed:
  put char TDoorl at 15,Ri
  put char TDoorr at 16,Ri
  for J = 1 to 3
    V = Ri + J
    put char TDoorlb at 15,V
    put char TDoorrb at 16,V
  next
  return
end sub

' the platform door opening (a frame between the steps)
sub DoorOpen:
  for J = 0 to 3
    V = J + 4
    put char TOpen at 15,V
    put char TOpen at 16,V
  next
  put char TSeat at 15,6
  put char TSeat at 16,6
  return
end sub

sub DrawStation:
  ' the ceiling with lamps
  for J = 0 to 31
    T = TCeil
    V = J mod 6
    if V = 3 then T = TLamp
    put char T at J,2
  next
  for C = 0 to 5
    Ri = C + 3
    TrainRow
  next
  Ri = 4
  DoorClosed
  fill TEdge count 32 at 0,9
  for Ri = 10 to 21
    for J = 0 to 31
      T = TFl0
      V = J & 3
      if V = 0 then T = TFl1
      put char T at J,Ri
    next
  next
  fill TBase count 32 at 0,22
  fill TBase count 32 at 0,23
  ' the INFO terminal
  put char TKt0 at 27,18
  put char TKt1 at 28,18
  put char TKm0 at 27,19
  put char TKm1 at 28,19
  put char TKb0 at 27,20
  put char TKb1 at 28,20
  return
end sub

' the tunnel lights stream past (every 4 frames)
sub AnimTunnel:
  inc TunT
  if TunT < 4 then return
  TunT = 0
  V = TunF + 1
  TunF = V & 1
  W16 = TTun0 - 128 + TunF
  W16 = W16 << 3
  NumU = TTun << 3
  copy TilePat + W16 count 8 to vram.pattern + NumU
  copy TilePat + W16 count 8 to vram.pattern + 2048 + NumU
  copy TilePat + W16 count 8 to vram.pattern + 4096 + NumU
  return
end sub

sub EnterJourney:
  Go = 0
  Ta = 0
  NewScreen
  for Ri = 3 to 5
    fill TTun count 32 at 0,Ri
  next
  for C = 0 to 5
    Ri = C + 6
    TrainRow
  next
  Ri = 7
  DoorClosed
  fill TRail count 32 at 0,12
  for Ri = 13 to 14
    fill TTun count 32 at 0,Ri
  next
  print at 7,16, "S U B W A Y   I N"
  print at 9,17, "M O T I O N"
  print at 8,18, "YEAR"
  ShowYearBig
  print at 18,18, "A.D."
  if Dd = 1 then
    print at 9,20, "FUTURE  >>"
  else
    print at 9,20, "<<  PAST"
  end if
  print at 7,21, "BUTTON: STOP"
  print at 8,22, "DISTORTION"
  OldPct = 255
  ShowPctJ
  ShowScreen
  Rearm
  wait no fire
  nmi off
  St = 2
  return
end sub

' the INFO terminal: this station's event, the doctor's era, the motion
sub InfoPage:
  NewScreen
  put char TFtl at 1,2
  put char TFtr at 30,2
  put char TFbl at 1,21
  put char TFbr at 30,21
  fill TFh count 28 at 2,2
  fill TFhb count 28 at 2,21
  for Ri = 3 to 20
    put char TFvl at 1,Ri
    put char TFvr at 30,Ri
  next
  print at 4,3, "SPACE-TIME SUBWAY SYSTEM"
  NumU = Yr
  print at 6,5, "STATION: " + width$(NumU, 4) + " A.D."
  Ev = FindEvent(Yr)
  if Ev > 0 then
    print at 2,7, "SIGNIFICANT EVENT THIS ERA:"
    W16 = Ev - 1
    W16 = W16 * 28
    put EvTxt + W16 count 28 at 2,8
  else
    print at 3,7, "NO SIGNIFICANT EVENT HERE"
  end if
  print at 3,10, "A HUMAN PRESENCE REGISTERS"
  print at 4,11, "NEAR THE ERA MARKED BY:"
  W16 = Ti
  W16 = W16 * 28
  put EvTxt + W16 count 28 at 2,13
  NumU = Ty
  print at 12,14, width$(NumU, 4) + " A.D."
  print at 7,17, "PAST"
  print at 19,17, "FUTURE"
  print at 10,18, "S U B W A Y"
  print at 10,19, "M O T I O N"
  print at 4,20, "STICK: SET  BUTTON: BACK"
  ShowArrows
  ShowScreen
  play sound SndBeep
  Rearm
  wait no fire
  nmi off
  St = 3
info_loop:
  Frame1
  ReadPad
  V = J1 | J2
  V = V & 12
  if V > 0 then
    if V <> WasStick then
      if V = 4 then Dd = 0
      if V = 8 then Dd = 1
      ShowArrows
      play sound SndClick
    end if
  end if
  WasStick = V
  if Press = 0 then goto info_loop
  play sound SndBeep
  ' back in front of the terminal
  Px = KioskX
  Py = KioskY
  return
end sub

sub ShowArrows:
  if Dd = 0 then
    put char TArl at 5,17
    put char TArrd at 26,17
  else
    put char TArld at 5,17
    put char TArr at 26,17
  end if
  return
end sub

sub EndMessage:
  for Ri = 15 to 22
    fill 32 count 32 at 0,Ri
  next
  if Over = 2 then
    print at 7,16, "YOU HAVE STOPPED"
    print at 6,17, "THE CRAZED DOCTOR!!"
    play sound SndWin
  else
    print at 4,16, "TIME DISTORTION 100% !!"
    print at 5,17, "YOU ARE LOST IN TIME"
    play sound SndLose
  end if
  NumU = W / 40
  print at 5,19, "DISTORTION " + digits$(NumU, 3) + "%"
  print at 5,20, "STATIONS VISITED " + str$(Visits)
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  J1 = J1 & 15
  J2 = J2 & 15
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the station, the professor by the train, the tune once,
' START GAME / CREDITS
sub TitlePage:
  St = 0
  NewScreen
  DrawStation
  for Ri = 11 to 20
    fill 32 count 24 at 3,Ri
  next
  print at 6,11, "EVERY SECOND COUNTS"
  print at 9,12, "ABOARD THE..."
  print at 7,14, "T I M E   S U B W A Y"
  print at 4,16, "BY CLEVELAND M. BLAKEMORE"
  print at 10,18, "START GAME"
  print at 10,19, "CREDITS"
  print at 2,1, "AHOY! APRIL 1988"
  ShowMenu
  Px = 120
  Py = DoorY
  Na = 0
  Doc = 0
  Pf = 0
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  Rand
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 8,18
  put char 32 at 8,19
  J = Menu + 18
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "TIME SUBWAY"
  print at 2,4, "BASED ON TIME SUBWAY BY"
  print at 2,5, "CLEVELAND M. BLAKEMORE,"
  print at 2,6, "FROM A CONCEPT BY LYNWOOD"
  print at 2,7, "BROOKS. AHOY! APRIL 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: PLATFORM NINE"
  print at 2,18, "O'CLOCK (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

