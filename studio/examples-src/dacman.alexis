data DacmanBoards words = @Dacman_board1,@Dacman_board2,@Dacman_board3,@Dacman_board4,@Dacman_board_vide,@Dacman_again

sub start:
  mode 2 screen
  sprites 16x16
  sprites simple
  set sound table DacmanSoundTable areas 4
  DacmanInitGraphics
DacmanMainMenu:
ifdef DACMAN_DEBUG_DACPONG_DIRECT
  DacmanBonusGame
  goto DacmanMainMenu
else ifdef
  ifdef DACMAN_DEBUG_SKIP_TITLE
    DacmanGame
    goto DacmanMainMenu
  else ifdef
    DacmanShowTitle
    DacmanSelectGame
    if BonusGame != 0 then
      DacmanBonusGame
    else
      DacmanGame
    end if
    goto DacmanMainMenu
  end ifdef
end ifdef
end sub

sub DacmanInitGraphics:
  screen off
  nmi off
  mode 2 screen
  cls
  copy DacmanNumbers count 80 to vram.pattern + 48 * 8
  copy DacmanFont count 224 to vram.pattern + 65 * 8
  copy DacmanDieze count 8 to vram.pattern + 35 * 8
  copy DacmanEtoile count 8 to vram.pattern + 42 * 8
  copy DacmanMedaille count 96 to vram.pattern + 224 * 8
  copy DacmanGrafx count 672 to vram.pattern + 128 * 8
  duplicate mode 2 patterns
  decompress DacmanGameColorRle to vram.color
  copy DacmanMissSprites count 64 to vram.spr_pat
  backdrop black
  screen on
  nmi on
  return

sub DacmanShowTitle:
DacmanTitleCycle:
  show picture DacmanDanielPicture
  screen on
  nmi on
  wait 20 frames
  play sound 10
  nmi on
  wait 300 frames

  show picture DacmanTitlePicture
  screen on
  nmi on
  WaitCount = 700
DacmanTitleWait:
  if joypad(1).button1 then goto DacmanTitleDone
  if WaitCount = 0 then goto DacmanShowInfo
  wait
  WaitCount -= 1
  goto DacmanTitleWait

DacmanShowInfo:
  show picture DacmanInfoPicture
  screen on
  nmi on
  wait no fire
  WaitCount = 800
DacmanInfoWait:
  if joypad(1).button1 then goto DacmanTitleDone
  if WaitCount = 0 then goto DacmanTitleCycle
  wait
  WaitCount -= 1
  goto DacmanInfoWait
DacmanTitleDone:
  screen off
  DacmanInitGraphics
  return

sub DacmanSelectGame:
  BonusGame = 0
  MenuLastPad = 0
  cls
  print centered at 3, "SELECT GAME"
  print at 11,9, "DACMAN"
  print at 11,12, "DACPONG"
  print centered at 20, "UP/DOWN AND FIRE"
  DacmanDrawGameSelection
DacmanSelectGameLoop:
  wait
  MenuPad = joypad(1)
  if joypad(1).up then
    if MenuLastPad = 0 then
      BonusGame = 0
      MenuLastPad = 1
      DacmanDrawGameSelection
    end if
  elseif joypad(1).down then
    if MenuLastPad = 0 then
      BonusGame = 1
      MenuLastPad = 1
      DacmanDrawGameSelection
    end if
  elseif joypad(1).fire then
    wait no fire
    return
  end if
  if MenuPad = 0 then MenuLastPad = 0 else MenuLastPad = 1
  goto DacmanSelectGameLoop

sub DacmanDrawGameSelection:
  if BonusGame = 0 then
    put char $2A at 9,9
    put char $20 at 9,12
  else
    put char $20 at 9,9
    put char $2A at 9,12
  end if
  return

sub DacmanGame:
DacmanRestartGame:
  cls
  Score = 0
  PacMedal = 0
ifdef DACMAN_DEBUG_START_MEDAL_1
  PacMedal = 1
end ifdef
  Level = NoLevel
ifdef DACMAN_DEBUG_START_LEVEL_5
  Level = 5
end ifdef
  if EasyMode != 0 then
    PacLifes = 29
  else
    PacLifes = NbpacLifes
  end if
  NextLife = 1000
  print centered at 0, "HIGH SCORE"
  print at 1,22, "SCORE"
  DacmanPutHiscore
  DacmanAddScore0
  DacmanPutLives
ifdef DACMAN_DEBUG_TRIGGER_END_SCENE
  DacmanTheEnd
  return
end ifdef
DacmanNewBoard:
  DacmanPutBoard
  DacmanInitLevel
  DacmanHideBonus
  DacmanShowBonus
DacmanContinueLevel:
  DacmanCountDots
  play sound 1
  play sound 2
  WaitCount = 318
  DacmanWaitGameplayFrames
  DacmanPacmanPlay
  stop sound 3
  stop sound 4
  if Ok = 15 then goto DacmanLevelClear
  DacmanPacmanDead
ifdef DACMAN_DEBUG_NO_LIFE_LOSS
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
else ifdef
  if PacLifes = 0 then goto DacmanGameOver
  PacLifes -= 1
  DacmanPutLives
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
end ifdef
DacmanLevelClear:
  DacmanFlashBoardClear
  Level += 1
  if Level = 10 then
    if NoLevel = 0 then
      if NbpacLifes = 2 then
        DacmanAwardMedal
        if PacMedal = 3 then
          DacmanTheEnd
          return
        end if
        Level = 0
        DacmanClearBonusTrail
      end if
    end if
  end if
  if Level = 5 then
    if PacMedal = 1 then
      DacmanAwardMedal
    end if
  end if
  goto DacmanNewBoard
DacmanGameOver:
  mute all
  print at 11,11, "GAME OVER"
  Score = 0
  WaitCount = 0
DacmanGameOverWait:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  if WaitCount = 450 then goto DacmanGameOverAgainBoard
  wait
  WaitCount += 1
  goto DacmanGameOverWait
DacmanGameOverAgainBoard:
  DacmanDrawBoardAgain
  WaitCount = 0
DacmanAgainLoop:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  WaitCount += 1
  if WaitCount = 12 then
    put char PacClosedTile at 9,16
  end if
  if WaitCount = 24 then
    put char PacRightTile at 9,16
    WaitCount = 0
  end if
  wait 2 frames
  goto DacmanAgainLoop
end sub

sub DacmanPutHiscore:
  print Hiscore at 13,1 digits 5
  put char 48 at 18,1
  return

sub DacmanAddScore0:
  DacmanAddScore
  return

sub DacmanAddScore:
  Score += Tmp
  print Score at 1,23 digits 5
  put char 48 at 6,23
  if Hiscore < Score then
    Hiscore = Score
    DacmanPutHiscore
  end if
  if NextLife > 0 then
    if Score >= NextLife then
      PacLifes += 1
      play sound 9
      DacmanPutLives
      if NextLife > 8000 then NextLife = 0 else NextLife = NextLife * 2
    end if
  end if
  Tmp = 0
  return

sub DacmanPutLives:
  Tmp = PacLifes
  if Tmp > 6 then Tmp = 6
  for LifeIndex = 0 to 6
    put char 32 at 7 + LifeIndex,23
  next
  if Tmp = 0 then return
  for LifeIndex = 0 to Tmp - 1
    put char PacLeftTile at 7 + LifeIndex,23
  next
  return

sub DacmanPutBoard:
  if Level < 5 then
    Tmp = 0
  else
    if Level < 9 then
      Tmp = 1
    else
      if Level = 10 then
        Tmp = 3
      else
        Tmp = 2
      end if
    end if
  end if
  DacmanDrawBoard
  if Level < 3 then
    Speed1 = 2
    Speed2 = 2
  else
    if Level < 5 then
      Speed1 = 2
      Speed2 = 1
    else
      if Level < 8 then
        Speed1 = 1
        Speed2 = 3
      else
        Speed1 = 1
        Speed2 = 2
      end if
    end if
  end if
  return

sub DacmanDrawBoard:
  put DacmanBoards[Tmp] frame size BoardWidth,BoardHeight at BoardLeft,BoardTop
  return

sub DacmanDrawBoardVide:
  Tmp = 4
  DacmanDrawBoard
  return

sub DacmanDrawBoardAgain:
  Tmp = 5
  DacmanDrawBoard
  return
sub DacmanInitLevel:
  Playing = 0
  clear sprites
  set sprite count 1
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = Ghost0Tile then
        Gd[0] = 0
        Gx[0] = X
        Gy[0] = Y
        Ogx[0] = X
        Ogy[0] = Y
        Gc[0] = 32
        Gt[0] = 0
      end if
      if C = Ghost1Tile then
        Gd[1] = 0
        Gx[1] = X
        Gy[1] = Y
        Ogx[1] = X
        Ogy[1] = Y
        Gc[1] = 32
        Gt[1] = 0
      end if
      if C = Ghost2Tile then
        Gd[2] = 0
        Gx[2] = X
        Gy[2] = Y
        Ogx[2] = X
        Ogy[2] = Y
        Gc[2] = 32
        Gt[2] = 0
      end if
      if C >= PacRightTile then
        if C <= PacClosedTile then
          PacX = X
          PacY = Y
        end if
      end if
      if C & $F0 then
        if (C & $F0) = $B0 then
          BonusX = X
          BonusY = Y
        end if
      end if
    next
  next
  Playing = 1
  return

sub DacmanShowBonus:
  C = Level
  if C > 10 then C = 10
  put char $B0 + C at BonusX,BonusY
  if C = 0 then return
  for G = 0 to C - 1
    put char $B0 + G at 23 - G,23
  next
  return

sub DacmanHideBonus:
  put char 32 at BonusX,BonusY
  return

sub DacmanCountDots:
  Playing = 0
  nmi off
  Dots = 0
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = DotTile then Dots += 1
      if C = PowerDotTile then Dots += 1
    next
  next
  nmi on
  Playing = 1
  return


sub DacmanWaitGameplayFrames:
DacmanWaitGameplayLoop:
  if WaitCount = 0 then return
  wait
  DacmanVblank
  WaitCount -= 1
  goto DacmanWaitGameplayLoop
end sub
sub DacmanRestartActorsAfterDeath:
  WaitCount = 16
  DacmanWaitGameplayFrames
  for G = 0 to 2
    C = Gc[G]
    if C = DotTile then
      put char C at Gx[G],Gy[G]
    else
      if C = PowerDotTile then
        put char C at Gx[G],Gy[G]
      else
        if (C & $F0) = $B0 then
          put char C at Gx[G],Gy[G]
        else
          if C = WallMask then
            put char C at Gx[G],Gy[G]
          else
            put char 32 at Gx[G],Gy[G]
          end if
        end if
      end if
    end if
    Gx[G] = Ogx[G]
    Gy[G] = Ogy[G]
    Gc[G] = 32
    Gt[G] = 0
  next
  for G = 0 to 2
    put char Ghost0Tile + G at Gx[G],Gy[G]
  next
  put char PacLeftTile at PacX,PacY
  return

sub DacmanPacmanPlay:
  Px = PacX
  Py = PacY
  Cpac = PacLeftTile
  Dpx = 2
  Dpy = 0
  play sound 3
  Ok = 4
  if Dots = 0 then Ok = 15
DacmanPlayLoop:
  if Ok != 4 then return
  DacmanMoveGhosts
  if Dots = 0 then Ok = 15
  if Ok != 4 then return
  if keypad(1) = 10 then
    goto DacmanPauseLoop
  end if
  if keypad(1) = 5 then
    goto DacmanBuyLife
  end if
  WaitCount = Speed2
  DacmanWaitGameplayFrames
  put char Cpac at Px,Py
  C = joypad(1) & $0F
  Ndpx = 0
  Ndpy = 0
  if C & $01 then Ndpy = 2
  if C & $04 then Ndpy = 1
  if C & $02 then Ndpx = 1
  if C & $08 then Ndpx = 2
  DacmanChoosePacDirection
  DacmanMovePac
  if Dots = 0 then Ok = 15
  goto DacmanPlayLoop
DacmanPauseLoop:
  wait no fire
DacmanPauseWait:
  if keypad(1) = 10 then goto DacmanPlayLoop
  wait
  goto DacmanPauseWait
DacmanBuyLife:
  if Score >= 2000 then
    Score -= 2000
    Tmp = 0
    DacmanAddScore
    PacLifes += 1
    play sound 9
    DacmanPutLives
  end if
  goto DacmanPlayLoop
end sub

sub DacmanChoosePacDirection:
  if Ndpx = 0 then
    if Ndpy = 0 then return
  end if
  Opx = Px
  Opy = Py
  if Ndpx = 1 then Opx += 1
  if Ndpx = 2 then Opx -= 1
  if Ndpx != 0 then
    DacmanWrapOpx
    C = get char at Opx,Opy
    if (C & $F0) = WallMask then Ndpx = 0
  end if
  Opx = Px
  Opy = Py
  if Ndpy = 1 then Opy += 1
  if Ndpy = 2 then Opy -= 1
  if Ndpy != 0 then
    DacmanWrapOpy
    C = get char at Opx,Opy
    if (C & $F0) = WallMask then Ndpy = 0
  end if
  if Ndpx = 0 then
    if Ndpy != 0 then
      Dpx = 0
      Dpy = Ndpy
      return
    end if
  end if
  if Ndpy = 0 then
    if Ndpx != 0 then
      Dpx = Ndpx
      Dpy = 0
      return
    end if
  end if
  if Ndpx = Dpx then
    Dpx = 0
    Dpy = Ndpy
    return
  end if
  if Ndpy = Dpy then
    Dpx = Ndpx
    Dpy = 0
    return
  end if
  if Dpx = 0 then
    if Dpy = 0 then
      Number = random(0,1)
      if Number = 0 then
        Dpx = Ndpx
        Dpy = 0
      else
        Dpy = Ndpy
        Dpx = 0
      end if
      return
    end if
  end if
  if Dpx != 0 then Dpx = 3 - Dpx
  if Dpy != 0 then Dpy = 3 - Dpy
  return

sub DacmanMovePac:
  Ncpac = PacClosedTile
  Opx = Px
  if Dpx = 1 then
    Opx += 1
    Ncpac = PacRightTile
  end if
  if Dpx = 2 then
    Opx -= 1
    Ncpac = PacLeftTile
  end if
  DacmanWrapOpx
  Opy = Py
  if Dpy = 1 then
    Opy += 1
    Ncpac = PacDownTile
  end if
  if Dpy = 2 then
    Opy -= 1
    Ncpac = PacUpTile
  end if
  DacmanWrapOpy
  C = get char at Opx,Opy
  if (C & $F0) = WallMask then
    Dpx = 0
    Dpy = 0
    return
  end if
  if Dpx = 0 then
    if Dpy = 0 then return
  end if
  put char 32 at Px,Py
  Px = Opx
  Py = Opy
  if Cpac = Ncpac then Cpac = PacClosedTile else Cpac = Ncpac
  put char Cpac at Px,Py
  Tmp2 = 0
  if C > Ghost0Tile - 1 then
    if C < BlueGhostTile then
      Ok = C - Ghost0Tile
      Tmp2 = Ok + 1
      C = Gc[Ok]
    end if
  end if
  if C = BlueGhostTile then
    DacmanWhichGhost
    Tmp2 = G + 1
    Number = Gc[G]
    DacmanGhostHome
    C = Number
  end if
  if C = DotTile then
    Tmp = 1
    DacmanGobDot
    DacmanClearConsumedGhostUnderTile
  end if
  if C = PowerDotTile then
    Tmp = 5
    DacmanGobDot
    DacmanClearConsumedGhostUnderTile
    play sound 4
    Tmp = 64 - Level * 5
    Gt[0] = Tmp
    Gt[1] = Tmp
    Gt[2] = Tmp
    Bonus = 20
  end if
  if (C & $F0) = $B0 then
    Tmp = Level + 1
    Tmp *= 10
    DacmanAddScore
    DacmanClearConsumedGhostUnderTile
    play sound 7
  end if
  return

sub DacmanClearConsumedGhostUnderTile:
  if Tmp2 = 0 then return
  I = Tmp2 - 1
  Gc[I] = 32
  return

sub DacmanMoveGhosts:
  for G = 0 to 2
    WaitCount = Speed1
    DacmanWaitGameplayFrames
    Wall = $0F
    X = Gx[G] + 1
    Y = Gy[G]
    if X > 24 then X = 6
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 1
    if (C & $F8) = $A8 then Wall -= 1
    X = Gx[G]
    Y = Gy[G] + 1
    if Y > 22 then Y = 2
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 2
    if (C & $F8) = $A8 then Wall -= 2
    X = Gx[G] - 1
    Y = Gy[G]
    if X < 6 then X = 24
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 4
    if (C & $F8) = $A8 then Wall -= 4
    X = Gx[G]
    Y = Gy[G] - 1
    if Y < 2 then Y = 22
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 8
    if (C & $F8) = $A8 then Wall -= 8
    if C = $80 then Wall += 8
    DacmanChooseGhostDirection
    put char Gc[G] at Gx[G],Gy[G]
    Tmp = DacmanDx[Nd]
    if Tmp = 255 then Gx[G] -= 1 else Gx[G] += Tmp
    if Gx[G] < 6 then Gx[G] = 24
    if Gx[G] > 24 then Gx[G] = 6
    Tmp = DacmanDy[Nd]
    if Tmp = 255 then Gy[G] -= 1 else Gy[G] += Tmp
    if Gy[G] < 2 then Gy[G] = 22
    if Gy[G] > 22 then Gy[G] = 2
    C = get char at Gx[G],Gy[G]
    if C > PacRightTile - 1 then
      if C < PacClosedTile + 1 then
        if Gt[G] > 0 then
          C = 32
          DacmanGhostHome
        else
          Gc[G] = 32
          Ok = G
        end if
      end if
    end if
    Gc[G] = C
    Gd[G] = Nd
    if Gt[G] > 0 then
      put char BlueGhostTile at Gx[G],Gy[G]
      Gt[G] -= 1
      if Gt[G] = 0 then
        play sound 3
      end if
    else
      put char Ghost0Tile + G at Gx[G],Gy[G]
    end if
  next
  return

sub DacmanChooseGhostDirection:
  if Gd[G] = 0 then Nd = DacmanG0[Wall]
  if Gd[G] = 1 then Nd = DacmanG1[Wall]
  if Gd[G] = 2 then Nd = DacmanG2[Wall]
  if Gd[G] = 4 then Nd = DacmanG4[Wall]
  if Gd[G] = 8 then Nd = DacmanG8[Wall]
DacmanGhostChoiceLoop:
  if Nd <= 8 then return
  Wall = 0 - Nd
  Number = random(0,3)
  if Number = 0 then Tmp = Wall & 1
  if Number = 1 then Tmp = Wall & 2
  if Number = 2 then Tmp = Wall & 4
  if Number = 3 then Tmp = Wall & 8
  if Tmp != 0 then Nd = Tmp
  goto DacmanGhostChoiceLoop
end sub

sub DacmanWhichGhost:
  G = 0
DacmanWhichGhostLoop:
  if Gx[G] = Opx then
    if Gy[G] = Opy then return
  end if
  if G = 2 then return
  G += 1
  goto DacmanWhichGhostLoop
end sub

sub DacmanGhostHome:
  Tmp = Bonus
  DacmanAddScore
  play sound 8
  Bonus = Bonus * 2
  put char GhostHomeTile at Gx[G],Gy[G]
  I = G
DacmanGhostHomeLoop:
  C = get char at Ogx[I],Ogy[I]
  if C = 32 then goto DacmanGhostHomeFound
  I += 1
  if I > 2 then I = 0
  goto DacmanGhostHomeLoop
DacmanGhostHomeFound:
  Gx[G] = Ogx[I]
  Gy[G] = Ogy[I]
  Gt[G] = 0
  Gc[G] = 32
  if Gt[0] = 0 then
    if Gt[1] = 0 then
      if Gt[2] = 0 then
        play sound 3
      end if
    end if
  end if
  return

sub DacmanGobDot:
  DacmanAddScore
  stop sound 6
  play sound 6
  Dots = Dots - 1
  return

sub DacmanWrapOpx:
  if Opx < 6 then Opx = 24
  if Opx > 24 then Opx = 6
  return

sub DacmanWrapOpy:
  if Opy < 2 then Opy = 22
  if Opy > 22 then Opy = 2
  return

sub DacmanPacmanDead:
  mute all
  play sound 5
  for C = $C0 to $D0
    put char C at Gx[Ok],Gy[Ok]
    wait 2 frames
  next
  for Tmp = 0 to 1
    for C = $D1 to $D3
      put char C at Gx[Ok],Gy[Ok]
      wait 3 frames
    next
  next
  wait 20 frames
  put char Ghost0Tile + Ok at Gx[Ok],Gy[Ok]
  return

sub DacmanFlashBoardClear:
  copy DacmanGrafx + 128 count 128 to vram.pattern + 128 * 8
  copy DacmanGrafx + 128 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanGrafx + 128 count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanGrafx count 128 to vram.pattern + 128 * 8
  copy DacmanGrafx count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanGrafx count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanGrafx + 128 count 128 to vram.pattern + 128 * 8
  copy DacmanGrafx + 128 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanGrafx + 128 count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanGrafx count 128 to vram.pattern + 128 * 8
  copy DacmanGrafx count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanGrafx count 128 to vram.pattern + (512 + 128) * 8
  return

sub DacmanClearBonusTrail:
  for LifeIndex = 0 to 9
    put char 32 at 23 - LifeIndex,23
  next
  return

sub DacmanAwardMedal:
  PacMedal += 1
  play sound 11
  play sound 12
  play sound 13
  C = $E0
  Y = PacMedal * 8 - 6
  for Tmp = 0 to 3
    X = 28
    for G = 0 to 2
      put char C at X,Y + Tmp
      C += 1
      X += 1
    next
  next
  wait 230 frames
  return

sub DacmanTheEnd:
  mute all
  DacmanDrawBoardVide
  DacmanInitLevel
  play sound 3
  for I = 0 to 11
    Tmp = I & 1
    DacmanPutMiss
    put char 32 at PacX,PacY
    PacX += 1
    put char PacClosedTile - Tmp * 4 at PacX,PacY
    wait 12 frames
  next

  Tmp = 0
  DacmanPutMiss
  put char PacClosedTile at PacX,PacY
  put char $A7 at PacX,PacY - 1
  put char $A8 at PacX + 1,PacY - 1

  play sound 14
  play sound 15
  play sound 16

  for I = 6 to 9
    put char 32 at I - 1,PacY
    put char Ghost2Tile at I,PacY
    wait 5 frames
  next

  for I = 6 to 8
    put char 32 at I - 1,PacY
    put char Ghost1Tile at I,PacY
    wait 5 frames
  next

  for I = 6 to 7
    put char 32 at I - 1,PacY
    put char Ghost0Tile at I,PacY
    wait 5 frames
  next

  put char 32 at PacX,PacY - 1
  put char 32 at PacX + 1,PacY - 1

  Tmp = 1
  DacmanPutMiss
  put char $A9 at PacX + 1,PacY - 1

  for I = 10 to 16
    put char 32 at I - 3,PacY
    put char Ghost0Tile at I - 2,PacY
    put char Ghost1Tile at I - 1,PacY
    put char Ghost2Tile at I,PacY
    if I = 11 then
      put char PacLeftTile at PacX,PacY
    end if
    wait 20 frames
  next

  put char 32 at PacX + 1,PacY - 1
  print at 7,PacY, "     THE END?    "
  set sprite 0 y to 207
  update sprites
  put char $8A at 6,PacY - 1
  put char $8A at 6,PacY
  put char $8A at 6,PacY + 1
  wait 32 frames
  mute all
  return

sub DacmanPutMiss:
  set sprite 0 to BonusY * 8 - 1,BonusX * 8,Tmp * 4,8
  put char PacClosedTile - 2 * Tmp at BonusX,BonusY
  update sprites
  return

sub DacmanVblank:
  if Playing = 0 then return
  Flashing += 1
  if Flashing = 12 then
    fill $F1 count 8 to vram.color + (128 + 33) * 8
    fill $F1 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $F1 count 8 to vram.color + (512 + 128 + 33) * 8
  end if
  if Flashing = 24 then
    fill $11 count 8 to vram.color + (128 + 33) * 8
    fill $11 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $11 count 8 to vram.color + (512 + 128 + 33) * 8
    Flashing = 0
  end if
  MaxGt = 0
  if Gt[0] > MaxGt then MaxGt = Gt[0]
  if Gt[1] > MaxGt then MaxGt = Gt[1]
  if Gt[2] > MaxGt then MaxGt = Gt[2]
  if MaxGt = 0 then goto DacmanGhostNormalColor
  if MaxGt = 6 then goto DacmanGhostNormalColor
  if MaxGt > 9 then goto DacmanGhostNormalColor
  if MaxGt = 3 then goto DacmanGhostFlashColor
  if MaxGt = 9 then goto DacmanGhostFlashColor
  return
DacmanGhostNormalColor:
  fill $41 count 8 to vram.color + (128 + 34 + 9 + 3) * 8
  fill $41 count 8 to vram.color + (256 + 128 + 34 + 9 + 3) * 8
  fill $41 count 8 to vram.color + (512 + 128 + 34 + 9 + 3) * 8
  return
DacmanGhostFlashColor:
  fill $F1 count 8 to vram.color + (128 + 34 + 9 + 3) * 8
  fill $F1 count 8 to vram.color + (256 + 128 + 34 + 9 + 3) * 8
  fill $F1 count 8 to vram.color + (512 + 128 + 34 + 9 + 3) * 8
  return

sub DacmanBonusGame:
DacpongStart:
  cls
  print centered at 1, "DACPONG!"
  print centered at 3, "NEWCOLECO BONUS GAME"
  print centered at 12, "TWO PLAYERS ONLY"
  print centered at 22, "PRESS FIRE TO START"
  screen on
  pause until press
  wait no fire
  cls
  Paddle1X = 1
  Paddle1Y = 1
  Paddle2X = 30
  Paddle2Y = 20
  PongWinner = 0
  Number = random(0,1)
  if Number = 0 then
    BallX = Paddle1X + 1
    BallY = Paddle1Y + 1
    BallDx = 1
    BallDy = 1
    BallEgo = 1
  else
    BallX = Paddle2X - 1
    BallY = Paddle2Y + 1
    BallDx = 2
    BallDy = 1
    BallEgo = 2
  end if
  put char $A0 + 2 * BallDx at BallX,BallY
  DacpongDrawPaddles
DacpongLoop:
  if PongWinner != 0 then goto DacpongDone
  DacpongMovePaddle1
  DacpongMovePaddle2
  wait
  if BallEgo = 0 then
    DacpongMoveBall
  end if
  wait
  goto DacpongLoop
DacpongDone:
  play sound 5
  if PongWinner = 1 then
    print centered at 10, "PLAYER ONE WIN"
  else
    print centered at 10, "PLAYER TWO WIN"
  end if
  wait 30 frames
  print centered at 19, "PLAY AGAIN?"
  print centered at 21, "* YES  # NO"
DacpongAgainLoop:
  if keypad(1) = 10 then goto DacpongStart
  if keypad(1) = 11 then return
  wait
  goto DacpongAgainLoop
end sub

sub DacpongDrawPaddles:
  put char $82 at Paddle1X,Paddle1Y
  put char $8A at Paddle1X,Paddle1Y + 1
  put char $88 at Paddle1X,Paddle1Y + 2
  put char $82 at Paddle2X,Paddle2Y
  put char $8A at Paddle2X,Paddle2Y + 1
  put char $88 at Paddle2X,Paddle2Y + 2
  return

sub DacpongMovePaddle1:
  PaddleDy = 0
  if joypad(1).up then
    if Paddle1Y > 0 then PaddleDy = 2
  end if
  if joypad(1).down then
    if Paddle1Y < 21 then PaddleDy = 1
  end if
  if PaddleDy != 0 then
    put char 32 at Paddle1X,Paddle1Y
    put char 32 at Paddle1X,Paddle1Y + 1
    put char 32 at Paddle1X,Paddle1Y + 2
    if PaddleDy = 1 then Paddle1Y += 1
    if PaddleDy = 2 then Paddle1Y -= 1
    if BallEgo = 1 then
      put char 32 at BallX,BallY
      if PaddleDy = 1 then BallY += 1
      if PaddleDy = 2 then BallY -= 1
      put char $A0 + 2 * BallDx at BallX,BallY
    end if
    DacpongDrawPaddles
  end if
  if joypad(1).button1 then
    if BallEgo = 1 then BallEgo = 0
  end if
  return

sub DacpongMovePaddle2:
  PaddleDy = 0
  if joypad(2).up then
    if Paddle2Y > 0 then PaddleDy = 2
  end if
  if joypad(2).down then
    if Paddle2Y < 21 then PaddleDy = 1
  end if
  if PaddleDy != 0 then
    put char 32 at Paddle2X,Paddle2Y
    put char 32 at Paddle2X,Paddle2Y + 1
    put char 32 at Paddle2X,Paddle2Y + 2
    if PaddleDy = 1 then Paddle2Y += 1
    if PaddleDy = 2 then Paddle2Y -= 1
    if BallEgo = 2 then
      put char 32 at BallX,BallY
      if PaddleDy = 1 then BallY += 1
      if PaddleDy = 2 then BallY -= 1
      put char $A0 + 2 * BallDx at BallX,BallY
    end if
    DacpongDrawPaddles
  end if
  if joypad(2).button1 then
    if BallEgo = 2 then BallEgo = 0
  end if
  return

sub DacpongMoveBall:
  C = get char at BallX,BallY
  if C = $A4 then
    put char 32 at BallX,BallY
  end if
  if C = $A2 then
    put char 32 at BallX,BallY
  end if
  if (C & $F0) = $80 then
    play sound 6
    if BallX < 16 then BallDx = 1 else BallDx = 2
  end if
  if BallY = 1 then BallDy = 1
  if BallY = 23 then BallDy = 2
  if BallDy = 1 then BallY += 1
  if BallDy = 2 then BallY -= 1
  if BallDx = 1 then BallX += 1
  if BallDx = 2 then BallX -= 1
  C = get char at BallX,BallY
  if (C & $F0) = $80 then
    play sound 6
    if BallX < 16 then
      BallDx = 1
      BallX += 1
    else
      BallDx = 2
      BallX -= 1
    end if
  end if
  if BallX = 0 then PongWinner = 2
  if BallX = 31 then PongWinner = 1
  put char $A0 + 2 * BallDx at BallX,BallY
  return

