' the four stops of the wagon (lines 9090-9850)
record WStop:
  u8 MinPts
  u8 Wx
end record

WStop Stops[4]

u8 Scr[12]
u8 Taken[12]
u8 Pick[12]
u8 Word[12]
u8 Used[33]
u16 Seed = 4321
u16 NumU = 0
bcd digits 2 ScoreB
u8 Score = 0
u8 Round = 0
u8 Wd = 0
u8 Lw = 0
u8 X0 = 0
u8 Try = 0
u8 Got = 0
u8 Pts = 0
u8 Cur = 0
u8 NPick = 0
u8 T = 30
u8 Sub60 = 0
u8 Late = 0
u8 Menu = 0
u8 GState = 0
u8 Tick = 0
u8 Idle = 0
u8 WagX = 196
u8 WagF = 0
u8 Mix8 = 0
' input
u8 J1 = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 AnyPress = 0
u8 WasAny = 0
u8 WasStick = 0
u8 Rep = 0
' loop counters
u8 Ci = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  fill array Used with 0
  Stops[0].MinPts = 0
  Stops[0].Wx = 196
  Stops[1].MinPts = 20
  Stops[1].Wx = 156
  Stops[2].MinPts = 30
  Stops[2].Wx = 84
  Stops[3].MinPts = 40
  Stops[3].Wx = 20
  set sound table GaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 0 then
    RulesPage
    PlayGame
    nmi on
    pause until press and release sleep after 30 seconds
    nmi off
  else
    CreditsPage
  end if
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift, stirred on the title every frame

sub MixSeed:
  Seed ^= Seed << 7
  Seed ^= Seed >> 9
  Seed ^= Seed << 8
  return
end sub

function RndBelow(u8 Lim) as u8
  u8 Lo = 0
  MixSeed
  Lo = highbyte(Seed)
  return Lo % Lim

' a word not asked yet in this game
function PickWord as u8
  u8 Left = 0
  u8 Pk = 0
  u8 Fi = 0
  u8 Got1 = 0
  for Fi = 0 to 32
    if Used[Fi] = 0 then inc Left
  next
  Pk = RndBelow(Left)
  for Fi = 0 to 32
    if Used[Fi] = 0 then
      if Pk = 0 then Got1 = Fi
      dec Pk
    end if
  next
  Used[Got1] = 1
  return Got1

' points for a right answer after Tr clues (lines 1630-1660)
function PtsFor(u8 Tr) as u8
  u8 P = 0
  select case Tr
  case 0
    P = 10
  case 1
    P = 7
  case 2
    P = 5
  case 3
    P = 2
  case else
    P = 0
  end select
  return P

' the farthest stop the score reaches
function StopFor(u8 Sc) as u8
  u8 S = 0
  u8 Si = 0
  for Si = 0 to 3
    if Sc >= Stops[Si].MinPts then S = Si
  next
  return S

' 1 when the laid letters spell the word
function IsRight as u8
  u8 Ok = 1
  u8 Ri = 0
  u8 Ix = 0
  for Ri = 0 to 11
    if Ri < Lw then
      Ix = Pick[Ri]
      if Scr[Ix] <> Word[Ri] then Ok = 0
    end if
  next
  return Ok

' ---------------------------------------------------------------------------
' the game

sub PlayGame:
  fill array Used with 0
  Score = 0
  ScoreB = 0
  Round = 0
  WagX = Stops[0].Wx
pg_next:
  inc Round
  AskWord
  MapPage
  if Round < Rounds then goto pg_next
  GameEnd
  return
end sub

' the word's letters into Word, then the listing's shuffle into Scr
sub Scramble:
  u8 E[12]
  u8 M = 0
  u8 R = 0
  u8 H = 0
  u8 Fl = 0
  u8 Top = 0
  u8 Same = 0
  u16 Wo = 0
  Wo = Wd
  Wo = Wo * 12
  copy WordTxt + Wo count 12 to Word
  Fl = 0
sc_again:
  copy Word to E
  for M = 0 to 11
    if M < Lw then
      Top = Lw - M - 1
      R = RndBelow(Top + 1)
      Scr[M] = E[R]
      H = E[R]
      E[R] = E[Top]
      E[Top] = H
    end if
  next
  Same = 1
  for M = 0 to 11
    if M < Lw then
      if Scr[M] <> Word[M] then Same = 0
    end if
  next
  if Same = 1 then
    inc Fl
    if Fl < 5 then goto sc_again
  end if
  return
end sub

' one word: up to four tries (no clue, then clues 1 to 3)
sub AskWord:
  Wd = PickWord
  Lw = WordLen[Wd]
  X0 = 16 - Lw
  Scramble
  QuizPage
  Try = 0
  Pts = 0
aw_try:
  OneTry
  if Got = 1 then
    Pts = PtsFor(Try)
    Score = Score + Pts
    ScoreB += Pts
    play sound SndRight
    NumU = Pts
    print at 2,MsgRow, "CORRECT!  +", digits$(NumU, 2), " PTS"
    ShowScore
    FrameN(90)
    return
  end if
  play sound SndWrong
  if Late = 1 then
    print at 2,MsgRow, "TIME UP!"
  else
    print at 2,MsgRow, "NOT QUITE!"
  end if
  FrameN(60)
  fill 32 count 28 at 2,MsgRow
  inc Try
  if Try < 4 then
    ShowClue(Try)
    goto aw_try
  end if
  ' no more clues: the word is shown (line 6250)
  GState = 3
  HideSprites
  for Ci = 0 to 11
    if Ci < Lw then
      J = X0 + Ci * 2
      PutBlock(Word[Ci], J, AnsRow)
    end if
  next
  print at 2,MsgRow, "THE WORD WAS ...  0 PTS"
  FrameN(150)
  return
end sub

' one try: lay the letters, judged when all are laid or time runs out
sub OneTry:
  fill array Taken with 0
  NPick = 0
  Cur = 0
  Late = 0
  Got = 0
  for Ci = 0 to 11
    if Ci < Lw then
      J = X0 + Ci * 2
      PutBlock(Scr[Ci], J, ScrRow)
      put char TSlt at J,AnsRow
      put char TSlb at J,AnsRow + 1
    end if
  next
  NumU = PtsFor(Try)
  print at 2,2, "FOR ", digits$(NumU, 2), " PTS"
  T = TryTime
  Sub60 = 0
  ShowTime
  DrawCursor
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  GState = 2
ot_loop:
  Frame1
  ReadPads
  MoveCursor
  if B1 > 0 then
    if WasB1 = 0 then TakeLetter
  end if
  if B2 > 0 then
    if WasB2 = 0 then GiveBack
  end if
  WasB1 = B1
  WasB2 = B2
  DrawCursor
  if NPick >= Lw then goto ot_judge
  inc Sub60
  if Sub60 >= SecFrames then
    Sub60 = 0
    dec T
    ShowTime
    if T = 0 then goto ot_late
    if T <= 5 then play sound SndTick
  end if
  goto ot_loop
ot_late:
  Late = 1
  Got = 0
  GState = 3
  HideSprites
  return
ot_judge:
  Got = IsRight
  GState = 3
  HideSprites
  return
end sub

' left/right with auto-repeat, skipping letters already laid
sub MoveCursor:
  u8 S = 0
  u8 Moved = 0
  u8 N = 0
  S = J1 & 12
  if S = 0 then
    Rep = 0
    WasStick = 0
    return
  end if
  if S = WasStick then
    inc Rep
    if Rep >= RepFirst then
      Rep = RepFirst - RepNext
      Moved = 1
    end if
  else
    Rep = 0
    Moved = 1
  end if
  WasStick = S
  if Moved = 0 then return
  if NPick >= Lw then return
  N = Cur
  if S = 8 then
    N = NextFree(Cur, 1)
  else
    N = NextFree(Cur, Lw - 1)
  end if
  if N <> Cur then play sound SndStep
  Cur = N
  return
end sub

' the next letter not yet laid from C, stepping by D (1 right, Lw-1 left)
function NextFree(u8 C, u8 D) as u8
  u8 N = 0
  u8 Ki = 0
  N = C
  for Ki = 1 to 12
    N = N + D
    if N >= Lw then N = N - Lw
    if Taken[N] = 0 then goto nf_done
  next
  N = C
nf_done:
  return N

sub TakeLetter:
  u8 Sl = 0
  if Taken[Cur] = 1 then return
  Taken[Cur] = 1
  Pick[NPick] = Cur
  Sl = X0 + NPick * 2
  PutBlock(Scr[Cur], Sl, AnsRow)
  Sl = X0 + Cur * 2
  put char TUst at Sl,ScrRow
  put char TUsb at Sl,ScrRow + 1
  NPick += 1
  play sound SndTake
  if NPick < Lw then Cur = NextFree(Cur, 1)
  return
end sub

sub GiveBack:
  u8 Sl = 0
  u8 Ix = 0
  if NPick = 0 then return
  NPick -= 1
  Ix = Pick[NPick]
  Taken[Ix] = 0
  Sl = X0 + NPick * 2
  put char TSlt at Sl,AnsRow
  put char TSlb at Sl,AnsRow + 1
  Sl = X0 + Ix * 2
  PutBlock(Scr[Ix], Sl, ScrRow)
  Cur = Ix
  play sound SndBack
  return
end sub

sub DrawCursor:
  u8 Ax = 0
  Ax = X0 + Cur * 2
  Ax = Ax * 8 - 4
  set sprite 0 to ScrRow * 8 + 15, Ax, SArrow, 15
  update sprites
  return
end sub

' a letter block (ASCII L) at C,R and C,R+1
sub PutBlock(u8 L, u8 C, u8 R):
  u8 Tc = 0
  Tc = L - 65
  Tc = TLtA + Tc * 2
  put char Tc at C,R
  put char Tc + 1 at C,R + 1
  return
end sub

' clue N (1-3) of the word, two lines
sub ShowClue(u8 N):
  u16 Co = 0
  u16 Va = 0
  u8 Rw = 0
  u8 Li = 0
  Co = Wd * 3 + N - 1
  Co = Co * 52
  Rw = ClueRow + (N - 1) * 3
  NumU = N
  print at 2,Rw, digits$(NumU, 1), "."
  for Li = 0 to 1
    Va = Rw + Li
    Va = Va * 32 + 4
    copy ClueTxt + Co count ClueW to vram.name + Va
    Co = Co + ClueW
  next
  return
end sub

sub ShowTime:
  NumU = T
  print at 22,2, "TIME ", digits$(NumU, 2)
  return
end sub

sub ShowScore:
  print at 21,1, "SCORE ", ScoreB
  return
end sub

sub QuizPage:
  NewScreen
  NumU = Round
  print at 2,1, "WORD ", digits$(NumU, 1), " OF 5"
  ShowScore
  fill TRule count 28 at 2,3
  fill TRule count 28 at 2,12
  print at 2,13, "CLUES"
  print at 2,22, "L.BUTTON LAY  R.BUTTON BACK"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' the map and the wagon

sub DrawMap:
  u16 Mo = 0
  u16 Va = 0
  u8 Mr = 0
  Mo = 0
  for Mr = 0 to 15
    Va = Mr + 1
    Va = Va * 32 + 2
    copy MapNames + Mo count 28 to vram.name + Va
    Mo = Mo + 28
  next
  print at 3,17, "40"
  print at 11,17, "30"
  print at 19,17, "20"
  print at 24,17, "START"
  return
end sub

sub DrawWagon:
  u8 Wp = 0
  u8 Op = 0
  Wp = SWag1
  Op = SOx1
  if WagF >= 8 then
    Wp = SWag2
    Op = SOx2
  end if
  set sprite 0 to WagY, WagX, SCanvas, 15
  set sprite 1 to WagY, WagX, Wp, 6
  set sprite 2 to WagY, WagX, Op, 10
  update sprites
  return
end sub

' roll the wagon west to X (wheels turn, the ox walks)
sub RollTo(u8 Gx):
rt_loop:
  DrawWagon
  Frame1
  if WagX <= Gx then return
  WagX -= 1
  inc WagF
  if WagF >= 16 then WagF = 0
  goto rt_loop
end sub

sub MapPage:
  GState = 8
  NewScreen
  DrawMap
  DrawWagon
  if Got = 1 then
    NumU = Pts
    print at 2,19, "CORRECT! ", digits$(NumU, 2), " PTS"
  else
    print at 2,19, "NO POINTS THIS TIME"
  end if
  NumU = Round
  print at 2,20, "SCORE ", ScoreB, " AFTER ", digits$(NumU, 1), " OF 5"
  ShowScreen
  V = StopFor(Score)
  RollTo(Stops[V].Wx)
  if Round >= Rounds then return
  print at 8,22, "PRESS THE BUTTON"
  Rearm
  wait no fire
  nmi off
mp_wait:
  Frame1
  ReadPads
  if AnyPress = 0 then goto mp_wait
  return
end sub

' the end: where the wagon got to (lines 9090-9850)
sub GameEnd:
  GState = 4
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,20
  play sound SndEnd
  print at 2,19, "FINAL SCORE ", ScoreB, " PTS"
  V = StopFor(Score)
  select case V
  case 0
    print at 2,21, "STUCK ON EAST COAST."
  case 1
    print at 2,21, "ALMOST TO THE MISSISSIPPI."
  case 2
    print at 2,21, "MADE IT TO THE ROCKIES!"
  case else
    print at 2,21, "HOORAY!!!! CALIFORNIA"
    print at 2,22, "AND GOLD!"
  end select
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub FrameN(u8 Nf):
  u8 Fi = 0
  for Fi = 1 to Nf
    Frame1
  next
  return
end sub

' J1: 1 up, 2 down, 4 left, 8 right (both controllers); B1/B2 the left and
' right buttons (16 when down); AnyPress: a new press of either
sub ReadPads:
  J1 = 0
  B1 = 0
  B2 = 0
  if joypad(1).up or joypad(2).up then J1 = J1 | 1
  if joypad(1).down or joypad(2).down then J1 = J1 | 2
  if joypad(1).left or joypad(2).left then J1 = J1 | 4
  if joypad(1).right or joypad(2).right then J1 = J1 | 8
  if joypad(1).button1 or joypad(2).button1 then B1 = 16
  if joypad(1).button2 or joypad(2).button2 then B2 = 16
  V = B1 | B2
  AnyPress = 0
  if V > 0 then
    if WasAny = 0 then AnyPress = 1
  end if
  WasAny = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  backdrop black
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the map with the wagon, the menu, the tune once
sub TitlePage:
  GState = 1
  NewScreen
  DrawMap
  fill 32 count 28 at 2,17
  WagX = 196
  DrawWagon
  print at 8,18, "GUESS AMERICA!"
  print at 12,20, "PLAY"
  print at 12,21, "CREDITS"
  print at 3,22, "COMPUTE'S GAZETTE  3/84"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 0
tp_loop:
  Frame1
  MixSeed
  ReadPads
  K = J1 & 3
  if K <> WasStick then
    if K = 1 then Menu = 0
    if K = 2 then Menu = 1
    ShowMenu
  end if
  WasStick = K
  if AnyPress = 0 then goto tp_loop
  mute all
  TzOn = 0
  return
end sub

sub ShowMenu:
  put char 32 at 10,20
  put char 32 at 10,21
  J = Menu + 20
  put char 62 at 10,J
  return
end sub

' the directions (lines 1500-1725)
sub RulesPage:
  GState = 7
  NewScreen
  print at 8,2, "GUESS AMERICA!"
  print at 2,4, "UNSCRAMBLE FIVE WORDS FROM"
  print at 2,5, "AMERICAN HISTORY, LIKE THE"
  print at 2,6, "WORD GAME 'JUMBLE'. YOU HAVE"
  print at 2,7, "30 SECONDS A TRY. WRONG?"
  print at 2,8, "A CLUE, AND FEWER POINTS:"
  print at 6,10, "0 CLUES - 10 PTS."
  print at 6,11, "1 CLUE  -  7 PTS."
  print at 6,12, "2 CLUES -  5 PTS."
  print at 6,13, "3 CLUES -  2 PTS."
  print at 2,15, "YOUR SCORE TAKES YOUR WAGON"
  print at 2,16, "WEST. WILL YOU MAKE IT TO"
  print at 2,17, "CALIFORNIA'S GOLD?"
  print at 2,19, "STICK: CHOOSE A LETTER"
  print at 2,20, "L.BUTTON LAY  R.BUTTON BACK"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
rp_wait:
  Frame1
  MixSeed
  ReadPads
  if AnyPress = 0 then goto rp_wait
  return
end sub

sub CreditsPage:
  GState = 6
  NewScreen
  print at 8,2, "GUESS AMERICA!"
  print at 2,5, "BASED ON GUESS AMERICA!,"
  print at 2,6, "COMPUTE'S GAZETTE DISK,"
  print at 2,7, "MARCH 1984 (COMMODORE 64,"
  print at 2,8, "BASIC)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "WORDS AND CLUES AS IN 1984."
  print at 2,18, "MUSIC: WESTWARD WHEELS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

