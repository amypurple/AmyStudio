  mode 2 screen
  sprites 16x16
  screen off
  backdrop black
  set sound table NxSoundTable areas 8
  call asm NxInit
  decompress zx0 NxZPat to vram.pattern
  decompress zx0 NxZCol to vram.color
  call asm NxMapInit
  GoTitle
  Logic
  screen on
  nmi off

frame_loop:
  Frame1
  call asm NxFrame
  inc Tick
  Logic
  goto frame_loop

' ---------------------------------------------------------------------------
' one frame of logic: input, music, the screen state, the chase
sub Logic:
  call asm NxPad
  MusicTick
  if State = StPlay then
    PlayStep
  else
    MenuStep
  end if
  Chase
  return
end sub

' title, HOW TO PLAY, credits, game over (the demo chase runs underneath)
sub MenuStep:
  inc Waited
  if State = StStart then
    if TxDirty = 0 then StartGame
    return
  end if
  if State = StTitle then
    S0 = PadE & 3
    if S0 > 0 then
      S1 = Menu
      if (PadE & 1) > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      if S1 <> Menu then
        play sound SndClick
        DrawCursor
      end if
    end if
    if (PadE & 192) > 0 then
      play sound SndClick
      if Menu = 0 then
        StartGame
      else
        if Menu = 1 then
          State = StHow
          Page = 1
          Waited = 0
          call asm TxPage with a = 1
        else
          State = StCredits
          Waited = 0
          call asm TxPage with a = 6
        end if
      end if
    end if
  else
    S0 = 0
    if (PadE & 192) > 0 then S0 = 1
    if Waited > 1800 then S0 = 2
    if State = StOver then
      if Waited < 30 then S0 = 0
    end if
    if State = StEnd then
      EndStep
      if Waited < 120 then S0 = 0
    end if
    if S0 > 0 then
      play sound SndClick
      if State = StHow then
        if S0 = 1 then
          if Page < 5 then
            inc Page
            Waited = 0
            call asm TxPage with a = Page
            S0 = 0
          end if
        end if
      end if
      if S0 > 0 then GoTitle
    end if
  end if
  return
end sub

sub GoTitle:
  if State = StEnd then
    call asm NxDawn with a = 0
  end if
  State = StTitle
  Menu = 0
  Waited = 0
  call asm TxPage with a = 0
  CurSv[0] = TxBuf[59]
  CurSv[1] = TxBuf[115]
  CurSv[2] = TxBuf[171]
  DrawCursor
  MusicTitle
  if Demo = 0 then
    Demo = 1
    NewDemo
  end if
  return
end sub

' the ending: the thief is held, dawn comes up, the final score (a life
' bonus), then THE END and the credits; a press returns to the title
sub GoEnd:
  State = StEnd
  Waited = 0
  W = Lives
  W = W * EndLife
  Score = Score + W
  call asm TxPage with a = 8
  call asm NumOut with hl = Score
  Ci = 0
  while Ci < 5
    TxBuf[68 + Ci] = TxBuf[Ci]
    TxBuf[Ci] = 0
    inc Ci
  end while
  MusicTitle
  return
end sub

sub EndStep:
  if Waited = 2 then
    call asm NxDawn with a = 1
  end if
  if Waited = 90 then
    call asm NxDawn with a = 2
  end if
  if Waited = 180 then
    call asm NxDawn with a = 3
  end if
  if Waited = 360 then
    call asm TxPage with a = 9
  end if
  return
end sub

sub DrawCursor:
  TxBuf[59] = CurSv[0]
  TxBuf[115] = CurSv[1]
  TxBuf[171] = CurSv[2]
  S0 = Menu * 56 + 59
  TxBuf[S0] = ChCursor
  TxDirty = TxDirty | 84
  return
end sub

sub NewDemo:
  Level = 1
  Lives = 3
  NewRun
  return
end sub

' START: the HUD page is written (one row a frame) before play begins
' (StStart), so no title text is left on screen in play
sub StartGame:
  if State = StTitle then
    State = StStart
    call asm TxPage with a = 7
    return
  end if
  State = StPlay
  Demo = 0
  Score = 0
  Level = 1
  Lives = 3
  MusicOff
  NewRun
  return
end sub

' play: the run's phases, the timer
sub PlayStep:
  if Ph = PhChase then
    if HalfT > 0 then
      dec HalfT
    else
      HalfT = HalfLen
      if HalfLeft > 0 then
        dec HalfLeft
        BarCell
        if HalfLeft < 6 then play sound SndTick
      end if
      if HalfLeft = 0 then
        Ph = PhAway
        PhT = 0
        TSt = TsEscape
        call asm TxMsg with a = MsgAway
        Sting(SndLoseA)
      end if
    end if
  end if
  ' (a run's end message stays: no time-out after the chase)
  if Ph <> PhChase then MsgT = 0
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then
      call asm TxMsg with a = 255
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the chase (also the demo): phases, then the guard, the thief, obstacles,
' coal, the camera, the layers, the sprites
sub Chase:
  inc PhT
  if Ph = PhReady then
    ' the HUD a frame after the new run (the camera's jump back to the last
    ' coach rewrites every band that frame)
    if PhT = 1 then
      if State = StPlay then
        HudAll
        ' "n CARS  GET READY"
        call asm TxMsg with a = MsgReady
        TxBuf[117] = ChDigit + Cars
      end if
    end if
    if PhT = 90 then
      Ph = PhChase
      if State = StPlay then
        call asm TxMsg with a = MsgGo
        MsgT = 40
        MusicRun
      end if
    end if
  end if
  if Ph = PhWin then
    S0 = 0
    if PhT = 150 then S0 = 1
    if State = StEnd then S0 = 0
    if S0 = 1 then
      if State = StPlay then
        if Level >= FinalLv then S0 = 2
      end if
    end if
    if S0 = 2 then GoEnd
    if S0 = 1 then
      inc Level
      S0 = Level & 1
      if S0 = 1 then
        if Lives < 5 then inc Lives
      end if
      NewRun
    end if
  end if
  if Ph >= PhFell then
    if PhT = 120 then LoseLife
  end if
  MoveGuard
  MoveThief
  Obstacles
  Coal
  MoveCamera
  call asm NxMapTick
  call asm NxLayers
  call asm NxSat
  return
end sub

sub LoseLife:
  dec Lives
  if Lives = 0 then
    if State = StPlay then
      State = StOver
      Waited = 0
      call asm TxMsg with a = MsgOver
      HudLives
    else
      NewDemo
    end if
  else
    if Ph = PhAway then
      NewRun
    else
      Respawn
    end if
    if State = StPlay then HudLives
  end if
  return
end sub

' a new run of the current level: positions, level parameters
sub NewRun:
  Ph = PhReady
  PhT = 0
  S0 = Level
  if S0 > 8 then S0 = 8
  ' the train of this level: its last coaches (TrainCars) of the 8 in the
  ' strip; the engine end stays where it is, the rear moves back (the
  ' coaches with their gap are 96 and 104 px long, in turn from the rear)
  Cars = TrainCars[S0 - 1]
  TrainL = (8 - Cars) * 100 + PadL
  if (Cars & 1) = 1 then TrainL = TrainL - 4
  CamMin = TrainL - PadL
  CamC = CamMin >> 3
  GxMin = (TrainL + 2) * 16
  BackMin = TrainL + 12
  CoalMin = TrainL + 8
  NxSt[12] = 255
  NxSt[15] = 255
  NxSt[18] = 255
  Gx = (TrainL + 8) * 16
  GSafe = Gx
  Tx = (TrainL + 104) * 16
  Ty = 136 * 16
  TAir = 0
  TSt = TsRun
  TCool = 60
  CamX = CamMin
  ' his pace (1/16 px a frame): never over the guard's (16) unless he
  ' sprints (the guard close behind): 11-15, sprint 17-25
  TV = 11 + (S0 >> 1)
  TFast = TV + 6 + (S0 >> 1)
  ' off balance after a landing: 25 frames at LV 1, 1 less a level (18)
  TStm = 26 - S0
  TOff = 0
  ' the clock: 38 s at LV 1, 2 s less a level to 24 s at LV 8, then 1 s
  ' less a level (the rest stops rising at LV 8); 3 s more for each coach
  ' over 4 (the longer trains): 38 36 34 32 | 33 31 29 | 30 29 28 s
  S1 = 40 - S0 * 2
  if Level > 8 then
    Sx = Level - 8
    if Sx > 6 then Sx = 6
    S1 = S1 - Sx
  end if
  S1 = S1 + (Cars - 4) * 3
  ' a half cell of the time bar lasts S1 * 60 / 36 frames
  HalfLen = S1 * 5 / 3
  HalfLeft = 36
  HalfT = HalfLen
  ObGap = 330 - S0 * 25
  CoalGap = 130 - S0 * 10
  ClearThings
  ObNext = ObGap
  GuardReset
  if State = StPlay then
    play sound SndWhistle
    MusicOff
  end if
  return
end sub

sub GuardReset:
  Gy = 136 * 16
  Gvy = 0
  GAir = 0
  GDir = 0
  GSp = 0
  GStun = 0
  GGrab = 0
  GDuck = 0
  return
end sub

' back on the roof where he last stood, a little behind
sub Respawn:
  W = GSafe >> 4
  S0 = 0
  while S0 < 6
    Fx = (W - 4) >> 2
    if Surf[Fx] < 150 then W = W - 4
    inc S0
  end while
  Gx = W * 16
  GuardReset
  ClearThings
  ObNext = 120
  Ph = PhChase
  PhT = 0
  if TSt <> TsEscape then TSt = TsTaunt
  TT = 50
  return
end sub

sub ClearThings:
  if ObT > 0 then
    ObT = 0
    ObClr = 1
  end if
  if LmOn > 0 then
    LmOn = 0
    LmClr = 1
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the guard
sub MoveGuard:
  if Demo = 1 then DemoPad
  if Ph <> PhChase then
    Pad = 0
    PadE = 0
  end if
  if Ph = PhChase then
    if State = StOver then Pad = 0
  end if
  if GStun > 0 then
    dec GStun
    ' a jump pressed while getting up (last 12 frames) is kept for the first
    ' frame back on the feet: a trunk right ahead can be cleared at once
    if GStun < 12 then
      if (PadE & 65) > 0 then GJb = 1
    end if
    Pad = 0
    GSp = 0
    if GStun = 0 then
      if GJb = 1 then PadE = PadE | 1
    end if
  end if
  if GStun = 0 then GJb = 0
  ' what the stick asks: 0 nothing, 1 right, 2 left
  GWant = 0
  if (Pad & 8) > 0 then GWant = 1
  if (Pad & 4) > 0 then GWant = 2
  GDuck = 0
  if (Pad & 2) > 0 then
    if GAir = 0 then GDuck = 1
  end if
  S1 = RunMax
  if GDuck = 1 then S1 = 4
  ' the lunge (8 frames: on, reaching), then the recovery (no run on the
  ' roof; in the air the jump goes on)
  if GGrab > 0 then
    dec GGrab
    if GGrab > GrabRec then
      GWant = 0
      Gx = Gx + 20
      GSp = 8
      TryGrab
    else
      if GAir = 0 then GWant = 0
    end if
  end if
  if GWant > 0 then
    S0 = GWant - 1
    if S0 = GDir then
      if GSp < S1 then GSp = GSp + 2
      if GSp > S1 then GSp = GSp - 3
    else
      ' turning: slow down first, turn when stopped
      if GSp > 3 then
        GSp = GSp - 3
      else
        GSp = 0
        GDir = S0
      end if
    end if
  else
    if GSp > 3 then
      GSp = GSp - 3
    else
      GSp = 0
    end if
  end if
  if GSp > 0 then
    if GDir = 0 then
      if Gx < (LocoEnd - 18) * 16 then Gx = Gx + GSp
    else
      if Gx > GxMin then Gx = Gx - GSp
    end if
  end if
  ' jump: UP or the right button, on the roof
  ' (3 frames of grace after stepping off an edge)
  S0 = 0
  if GAir < 4 then
    if Gvy >= 0 then S0 = 1
  end if
  if S0 = 1 then
    if (PadE & 65) > 0 then
      if GDuck = 0 then
        if GStun = 0 then
          Gvy = 0 - JumpV
          GAir = 1
          play sound SndJump
        end if
      end if
    end if
  end if
  ' grab: the left button
  if (PadE & 128) > 0 then
    if GGrab = 0 then
      if GStun = 0 then
        GGrab = GrabLen
        GDir = 0
        play sound SndGrab
      end if
    end if
  end if
  ' the roof under the feet (centre of the sprite)
  W = Gx >> 4
  S0 = Surf[(W + 8) >> 2]
  Q = S0 * 16
  if Ph = PhFell then Q = DeadY + 400
  call asm NxBody with hl = address of Gy, de = Q
  if GAir = 0 then
    if S0 < 150 then GSafe = Gx
  end if
  ' fallen between the cars
  if Ph = PhChase then
    if Gy >= 148 * 16 then
      Ph = PhFell
      PhT = 0
      play sound SndFall
      if State = StPlay then
        call asm TxMsg with a = MsgFell
        Sting(SndLoseA)
      end if
      if TSt < TsDodge then
        TSt = TsTaunt
        TT = 60
      end if
    end if
  end if
  ' luggage: a trip when the feet are low
  if GStun = 0 then
    if Gy > 129 * 16 then
      S0 = Surf[(W + 6) >> 2]
      S1 = Surf[(W + 10) >> 2]
      if S1 = LugY then S0 = LugY
      if S0 = LugY then
        if GAir = 0 then
          Knock(30)
          ' back from the trunk (up to 16 px more, never over a gap): the
          ' guard gets up with room to take a run-up and jump
          S0 = 0
          while S0 < 4
            W = Gx >> 4
            Fx = (W + 4) >> 2
            if W > BackMin then
              if Surf[Fx] < 150 then Gx = Gx - 64
            end if
            inc S0
          end while
        end if
      end if
    end if
  end if
  ' cornered: on the engine
  if Ph = PhChase then
    if W >= LocoX + 8 then
      if GAir = 0 then Won(0)
    end if
  end if
  GuardPose
  return
end sub

' pose: 0 stand, 1-4 run (distance-driven), 5 air, 6 duck, 7 grab, 8 down.
' Stopping finishes the stride on a legs-together pose, never a snap.
sub GuardPose:
  if GStun > 0 then
    GPose = 8
  else
    if GGrab > GrabRec then
      GPose = 7
    else
      if GAir > 3 then
        GPose = 5
      else
        if GDuck = 1 then
          GPose = 6
        else
          if GSp > 0 then
            GDist = GDist + GSp
            GPose = 1 + ((GDist >> 7) & 3)
          else
            S0 = (GDist >> 7) & 3
            if S0 = 1 then
              GPose = 0
            else
              if S0 = 2 then
                GPose = 0
              else
                GDist = GDist + 16
                GPose = 1 + S0
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  return
end sub

sub Knock(u8 n):
  GStun = n
  GSp = 0
  GGrab = 0
  W = Gx >> 4
  if W > BackMin then
    if Surf[(W + 2) >> 2] < 150 then Gx = Gx - 96
  end if
  play sound SndThud
  if TSt < TsThrow then
    TSt = TsTaunt
    TT = 40
  end if
  return
end sub

' each frame of the lunge: reached him, on the roof and off balance (yellow,
' as drawn: TCol): caught (the old dodge rule never fired in play: removed
' 2026-11-12; TsDodge stays only as a state-number boundary)
sub TryGrab:
  if Ph = PhChase then
    W = Tx >> 4
    Fx = (Gx >> 4) + 4
    if W > Fx then
      W = W - Fx
      if W < GrabR then
        if TAir = 0 then
          if TCol = ColOff then Won(1)
        end if
      end if
    end if
  end if
  return
end sub

' the run is won: 1 grabbed, 0 cornered at the engine
sub Won(u8 how):
  Ph = PhWin
  PhT = 0
  TSt = TsCaught
  GSp = 0
  GGrab = 0
  TOff = 0
  if State = StPlay then
    W = HalfLeft * 10
    Score = Score + W
    if how = 1 then
      Score = Score + 500
      call asm TxMsg with a = MsgCaught
    else
      Score = Score + 200
      call asm TxMsg with a = MsgCornered
    end if
    HudScore
    Sting(SndWinA)
  end if
  return
end sub

' the demo player (title, HOW TO PLAY): runs on, jumps gaps, luggage and
' coal, ducks under what comes over, grabs when close
sub DemoPad:
  Pad = 8
  PadE = 0
  W = Gx >> 4
  if GAir = 0 then
    S0 = Surf[(W + 8) >> 2]
    S1 = Surf[(W + 18) >> 2]
    Sx = S1 - S0
    if Sx > 2 then
      if Sx < 128 then PadE = 1
    end if
    Sx = S0 - S1
    if Sx > 3 then
      if Sx < 128 then PadE = 1
    end if
    S0 = Surf[(W + 20) >> 2]
    if S0 = LugY then PadE = 1
    if LmOn > 0 then
      Fx = LmX - W
      if Fx < 26 then
        if Fx > 12 then PadE = 1
      end if
    end if
  end if
  if ObT > 0 then
    Q = W + 40 - CamX
    if ObX < Q then
      Q = Q - ObW
      Q = Q - 24
      if ObX > Q then
        Pad = 2
        PadE = 0
      end if
    end if
  end if
  if TCol = ColOff then
    W = Tx >> 4
    Fx = (Gx >> 4) + 4
    if W > Fx then
      W = W - Fx
      if W < 32 then PadE = PadE | 128
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the thief: an opponent, not a runner on rails. He keeps ahead, stops to
' taunt when far ahead or when the guard falls or is knocked down, ducks
' under what comes over, throws coal back from the tender, and makes for the front of the engine when time is up.
sub MoveThief:
  W = Tx >> 4
  Fx = Gx >> 4
  S1 = 0
  if W > Fx then S1 = 1
  TSp = 0
  if TCool > 0 then dec TCool
  if TT > 0 then dec TT
  if TOff > 0 then dec TOff
  if Ph = PhReady then TSt = TsWait
  if TSt = TsWait then
    if Ph = PhChase then TSt = TsRun
  end if
  if TSt = TsRun then
    TSp = TV
    if S1 = 1 then
      Fx = W - Fx
      if Fx < 44 then TSp = TFast
      if Fx > 110 then
        TSp = 0
        if TCool = 0 then
          TSt = TsTaunt
          TT = 48
        end if
      end if
    else
      TSp = TFast
    end if
    ' off balance: an eighth of his pace
    if TOff > 0 then TSp = TV >> 3
    ' cornered at the front of the engine: waits there
    if W >= LocoEnd - 34 then TSp = 0
    ' coal: from the tender, when the guard is behind
    if W >= TendX then
      if W < TendEnd - 12 then
        if LmOn = 0 then
          if LmCool = 0 then
            if TAir = 0 then
              TSt = TsThrow
              TT = 20
            end if
          end if
        end if
      end if
    end if
    ThiefDuckCheck
  else
    if TSt = TsTaunt then
      if TT = 0 then
        TSt = TsRun
        TCool = 200
      end if
      if S1 = 1 then
        Fx = W - Fx
        if Fx < 50 then TSt = TsRun
      end if
      ThiefDuckCheck
    else
      if TSt = TsDuck then
        ' stays down until it has passed
        TSp = 0
        S0 = 0
        if ObT > 0 then
          Q = W + 12 - CamX
          Q = Q - ObW
          if ObX > Q then S0 = 1
        end if
        if S0 = 0 then TSt = TsRun
      else
        if TSt = TsThrow then
          if TT = 8 then
            LmOn = 1
            LmX = TendX - 4
            LmAir = 14
            LmCool = CoalGap
            play sound SndThrow
          end if
          if TT = 0 then
            TSt = TsRun
            S0 = TStm + 12
            call asm NxOffBal with a = S0
          end if
        else
          if TSt = TsEscape then
            TSp = TFast + 8
            if W > LocoEnd - 30 then
              if TAir = 0 then
                Tvy = 0 - 56
                TAir = 1
              end if
            end if
            if W > TrainW - 24 then TSt = TsGone
          end if
        end if
      end if
    end if
  end if
  if TSt = TsTaunt then
    if TT = 47 then play sound SndTaunt
    if TT = 29 then play sound SndTaunt
  end if
  if TAir > 0 then
    if TSp < 20 then TSp = 20
  end if
  Tx = Tx + TSp
  W = Tx >> 4
  S0 = Surf[(W + 8) >> 2]
  if TSt = TsEscape then S0 = 140
  if TSt = TsGone then S0 = 140
  if TAir = 0 then
    if TSp > 0 then
      S1 = Surf[(W + 20) >> 2]
      Sx = 0
      Ci = S1 - S0
      if Ci > 2 then
        if Ci < 128 then Sx = 1
      end if
      Ci = S0 - S1
      if Ci > 3 then
        if Ci < 128 then Sx = 1
      end if
      S1 = Surf[(W + 22) >> 2]
      if S1 = LugY then Sx = 1
      if Sx = 1 then
        if TOff > 0 then
          Tx = Tx - TSp
        else
          Tvy = 0 - JumpV
          TAir = 1
        end if
      end if
    end if
  end if
  Q = S0 * 16
  Sx = TAir
  call asm NxBody with hl = address of Ty, de = Q
  ' landed from a jump: off balance
  if Sx > 3 then
    if TAir = 0 then
      if TSt = TsRun then
        if S0 < 150 then
          call asm NxOffBal with a = TStm
        end if
      end if
    end if
  end if
  ThiefPose
  return
end sub



' a bridge or gantry close ahead (or over him): duck
sub ThiefDuckCheck:
  if ObT > 0 then
    if TAir = 0 then
      Q = W + 38 - CamX
      if ObX < Q then
        Q = Q - ObW
        Q = Q - 26
        if ObX > Q then
          TSt = TsDuck
          TSp = 0
        end if
      end if
    end if
  end if
  return
end sub

' 0 stand, 1-4 run, 5 air, 6 duck (facing right); 7 throw, 8-9 taunt,
' 10 caught (facing back, to the left)
sub ThiefPose:
  if TAir > 3 then
    TPose = 5
  else
    if TSp > 0 then
      TDist = TDist + TSp
      TPose = 1 + ((TDist >> 7) & 3)
    else
      TPose = 0
    end if
  end if
  if TSt = TsDuck then TPose = 6
  if TOff > 0 then
    if TAir = 0 then TPose = 6
  end if
  if TSt = TsThrow then TPose = 7
  if TSt = TsTaunt then
    TPose = 8
    S0 = Tick & 16
    if S0 > 0 then TPose = 9
  end if
  if TSt = TsCaught then TPose = 10
  return
end sub

' ---------------------------------------------------------------------------
' bridges and gantries: ground-locked (they come at the ground speed plus
' the camera's), drawn by NxObs; spawned on the right, gone on the left
sub Obstacles:
  if ObT > 0 then
    ObX = ObG - P
    W = ObW
    Q = ObX + W
    if Q < 12 then
      ObT = 0
      ObClr = 1
      if ObHit = 0 then
        if State = StPlay then
          if Ph = PhChase then
            Score = Score + 25
            HudScore
          end if
        end if
      end if
    else
      ' the guard under it, not ducking (or in the air): knocked down
      if ObHit = 0 then
        Q = (Gx >> 4) + 28 - CamX
        if ObX < Q then
          Q = Q - 8
          Q = Q - W
          if ObX > Q then
            S0 = 1
            if GDuck = 1 then S0 = 0
            if GStun > 0 then S0 = 0
            if Ph <> PhChase then S0 = 0
            if S0 = 1 then
              ObHit = 1
              Knock(50)
            end if
          end if
        end if
      end if
    end if
  else
    if ObNext > 0 then
      dec ObNext
    else
      ' none near the engine: there the coal is the danger (and the
      ' animated smoke, cab and wheels already fill the frame's VRAM time)
      ' (it lives up to ~140 frames; the camera moves at most 1 px a frame,
      ' so one spawned at CamX < ObCut is gone before CamX 656, where the
      ' engine's animated bands and the overlay together overrun the frame)
      S0 = Ph
      if CamX >= ObCut then S0 = 0
      if S0 = PhChase then
        ' the screen x + P must be 7 mod 8: its cells step with the near band
        ObG = (P + 248) | 7
        ObX = ObG - P
        ObT = 1
        ObW = ObW1
        if Level > 1 then
          S0 = random(3)
          if S0 = 0 then
            ObT = 2
            ObW = ObW2
          end if
        end if
        ObHit = 0
        ObNext = ObGap + random(90)
      end if
    end if
  end if
  return
end sub

' the coal lump: flies over the gap behind the tender, then rolls back
' along the roof; a gap swallows it
sub Coal:
  if LmCool > 0 then
    if LmOn = 0 then dec LmCool
  end if
  if LmOn > 0 then
    LmX = LmX - 2
    if LmAir > 0 then
      dec LmAir
    else
      S0 = Surf[(LmX + 3) >> 2]
      if S0 > 149 then
        LmOn = 0
        LmClr = 1
      end if
    end if
    if LmX < CoalMin then
      LmOn = 0
      LmClr = 1
    end if
    if LmOn > 0 then
      ' the guard's feet low on it: knocked down
      if GStun = 0 then
        if Gy > 130 * 16 then
          W = Gx >> 4
          Fx = LmX + 2
          if Fx > W then
            Fx = Fx - W
            if Fx < 10 then
              LmOn = 0
              LmClr = 1
              Knock(30)
            end if
          end if
        end if
      end if
    end if
    Q = LmX + 16 - CamX
    LmSX = Q
    if Q < 4 then
      LmOn = 0
      LmClr = 1
    end if
  end if
  return
end sub

' the camera follows the guard, at most 1 pixel a frame (asm: NxCam)
' - the train's tiles step when the camera crosses a cell: not in a frame
'   where the near band steps too (it waits a frame; the heaviest VRAM frames
'   never pile up)
' - by the engine (CamX >= CamEng: the animated smoke, cab and wheels), while
'   the coal lump is out and while a bridge or gantry is on screen (its overlay is redrawn
'   every frame), the camera moves every other frame only, on the frames
'   where the far band does not step (Tick odd); it catches up afterwards
' - it holds on an obstacle's or the coal's clean-up and once the run is won
sub MoveCamera:
  call asm NxCam
  return
end sub

' ---------------------------------------------------------------------------
' HUD (play): row 1 score, LV n, lives; row 3 the clock and the time bar
sub HudAll:
  call asm TxPage with a = 7
  HudScore
  if Level < 10 then
    TxBuf[10] = ChDigit + Level
  else
    TxBuf[10] = ChDigit + Level / 10
    TxBuf[11] = ChDigit + Level % 10
  end if
  HudLives
  Ci = 0
  while Ci < 18
    S1 = Ci * 2
    BarDraw
    inc Ci
  end while
  call asm NxMapDraw
  return
end sub

sub HudScore:
  call asm NumOut with hl = Score
  TxDirty = TxDirty | 1
  return
end sub

sub HudLives:
  Ci = 0
  while Ci < 5
    S0 = 0
    if Ci < Lives then S0 = ChLife
    TxBuf[13 + Ci] = S0
    inc Ci
  end while
  TxDirty = TxDirty | 1
  return
end sub

' the bar cell that just changed (or all of them when the colour changes)
sub BarCell:
  if HalfLeft = 18 then call asm NxBarRecol
  if HalfLeft = 9 then call asm NxBarRecol
  Ci = HalfLeft >> 1
  BarDraw
  return
end sub

' cell Ci: full, half or empty, in the bar's colour
sub BarDraw:
  S0 = ChBarG
  if HalfLeft <= 18 then S0 = ChBarY
  if HalfLeft <= 9 then S0 = ChBarR
  S1 = Ci * 2
  if HalfLeft <= S1 then
    S0 = ChBarE
  else
    S1 = S1 + 1
    if HalfLeft = S1 then S0 = S0 + 1
  end if
  TxBuf[58 + Ci] = S0
  TxDirty = TxDirty | 4
  return
end sub

' ---------------------------------------------------------------------------
' music: the title tune once; in play the run loop with the wheels' rhythm
' (the drum bar is replayed on each 96-frame bar line); stings in between
sub MusicTick:
  if StingN > 0 then
    play sound StingN
    S0 = StingN + 1
    play sound S0
    StingN = 0
  end if
  if MuT > 0 then
    dec MuT
    if MuT = 0 then
      if MuMode = 1 then
        MusicOff
      else
        if MuNext = 2 then
          MusicRun
        else
          MuMode = 0
        end if
      end if
    end if
  end if
  if MuMode = 2 then
    inc MuF
    if MuF >= 96 then
      MuF = 0
      play sound SndRunDrum
    end if
  end if
  return
end sub

sub MusicTitle:
  MusicOff
  play sound SndTitleC
  play sound SndTitleD
  play sound SndTitleA
  play sound SndTitleB
  MuMode = 1
  MuT = TitleFrames
  return
end sub

sub MusicRun:
  play sound SndRunA
  play sound SndRunB
  play sound SndRunDrum
  MuF = 0
  MuT = 0
  MuMode = 2
  return
end sub

' a sting: the music stops now, the sting starts next frame (MusicTick):
' stopping and starting the sounds in one frame overran a heavy frame
sub Sting(u8 n):
  MusicOff
  StingN = n
  MuMode = 3
  MuT = WinFrames + 1
  MuNext = 0
  if n = SndWinA then MuNext = 2
  return
end sub

' only the group that can be playing is stopped (title tune or run loop)
sub MusicOff:
  if MuMode <> 2 then
    stop sound SndTitleA
    stop sound SndTitleB
    stop sound SndTitleC
    stop sound SndTitleD
  end if
  if MuMode <> 1 then
    stop sound SndRunA
    stop sound SndRunB
    stop sound SndRunDrum
  end if
  MuMode = 0
  MuT = 0
  return
end sub

' one frame: the NMI runs only during the wait
sub Frame1:
  call asm NxClrF
  call asm NxPoll
  nmi off
  return
end sub

asm {
; the NMI only flags the frame (NO_NMI = 1: the runtime's handler reads the
; status and returns): the frame's VRAM work starts at once in the blank; the
; handler's own work (controllers, sound) runs after it (NxLate)
; If the frame flag is already up, the last frame's logic ran into this
; frame's blank (rare: a heavy frame): no wait, the frame is late, not lost,
; and it gets no fast-write budget (NxLt, NX_LATEBUD 0): all its writes are
; paced, safe while the screen is drawn.
; v4: no status read here any more (nor the one 'nmi on' does after setting
; IE): a status read in the very cycle the frame flag rises clears it with
; no NMI, and the frame wait then lost a whole frame (seen in the bots,
; human 2 / 7). IE is set alone: a flag already up fires the NMI at once,
; its handler reads the status and sets NMI_FLAG: that frame is late.
NxClrF:
    xor a
    ld (NMI_FLAG),a
    ld (AMY_UVAR_NxLt),a
    inc a
    ld (NO_NMI),a
    ld a,($73C4)
    or $20
    ld ($73C4),a
    ld c,a
    ld b,1
    call WRITE_REGISTER
    ld a,(NMI_FLAG)
    ld (AMY_UVAR_NxLt),a
    ret
NxLate:
    xor a
    ld (NO_NMI),a
    push ix
    push iy
    call UPDATE_CONTROLLERS
    ld a,($73EE)
    and $4F
    ld (JOYPAD_1),a
    ld a,($73F0)
    and $4F
    ld (JOYPAD_1+1),a
    ld ix,JOYPAD_1
    call AMY_DECODE_CONTROLLER
    ld hl,AMY_FRAME_COUNTER
    inc (hl)
    jr nz,NxLt1
    inc hl
    inc (hl)
NxLt1:
    ld a,(AMY_SOUND_ENABLED)
    or a
    jr z,NxLt2
    call PLAY_SOUNDS
    call UPDATE_SOUND_ADDR
NxLt2:
    pop iy
    pop ix
    ret
NxPoll:
    ld a,(NMI_FLAG)
    or a
    jr z,NxPoll
    ret

; the pad: Pad = held (1 up, 2 down, 4 left, 8 right, 64 right button,
; 128 left button), PadE = newly pressed this frame
NxPad:
    ld a,(JOYPAD_1)
    ld b,a
    and $C1
    bit 1,b
    jr z,NxPd1
    or 8
NxPd1:
    bit 2,b
    jr z,NxPd2
    or 2
NxPd2:
    bit 3,b
    jr z,NxPd3
    or 4
NxPd3:
    ld b,a
    ld a,(AMY_UVAR_PadW)
    cpl
    and b
    ld (AMY_UVAR_PadE),a
    ld a,b
    ld (AMY_UVAR_PadW),a
    ld (AMY_UVAR_Pad),a
    ret

; VDP: NxSetW sets the write address DE.
; NxOutF: BC bytes from HL, unrolled OUTI (16 cycles a byte): only in the
; vertical blank or with the display off.
; NxOutS: BC bytes from HL, 30 cycles a byte: safe while the screen is drawn
; (the TMS9918A needs about 8 us between accesses in graphics mode 2).
; NxOut: fast while the frame's blank budget lasts, else slow. NxBud counts
; CYCLES left in the vertical blank (from NxFrame's start): a fast copy costs
; 16 a byte + NX_FASTOH (the band code around it), the slow writers charge
; theirs too (NxOutA, OvFast), so no fast write lands after the blank.
NxSetW:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ret
NxOut:
    push hl
    push de
    ld h,b
    ld l,c
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,NX_FASTOH
    add hl,de
    ex de,hl
    ld hl,(AMY_UVAR_NxBud)
    or a
    sbc hl,de
    jr c,NxOut1
    ld (AMY_UVAR_NxBud),hl
    pop de
    pop hl
    jr NxOutF
NxOut1:
    ld hl,0
    ld (AMY_UVAR_NxBud),hl
    pop de
    pop hl
    jr NxOutS
; NxChg: the blank budget (cycles) less DE (not below 0); keeps BC, HL
NxChg:
    push hl
    ld hl,(AMY_UVAR_NxBud)
    or a
    sbc hl,de
    jr nc,NxCh1
    ld hl,0
NxCh1:
    ld (AMY_UVAR_NxBud),hl
    pop hl
    ret
NxOutF:
    call NxSetW
    ld a,c
    sla a
    rl b
    srl a
    ld d,b
    ld c,$BE
    or a
    jr z,NxOF2
    push iy
    neg
    add a,128
    ld e,a
    ld a,d
    ld d,0
    ld iy,NxChain
    add iy,de
    add iy,de
    ld d,a
    call NxJpIY
    pop iy
NxOF2:
    ld a,d
    or a
    ret z
    dec d
    call NxChain
    jr NxOF2
NxJpIY:
    jp (iy)
NxOutS:
    call NxSetW
    ld a,c
    ld d,b
    ld c,$BE
    ld b,a
    or a
    jr z,NxOutS2
NxOutS1:
    outi
    nop
    jp nz,NxOutS1
NxOutS2:
    ld a,d
    or a
    ret z
    dec d
    jr NxOutS1

; NxOutA: B names from HL plus C (a resident band's shift), at DE; ~41
; cycles a byte, safe while the screen is drawn
NxOutA:
    push hl
    push de
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    add hl,hl
    add hl,hl
    pop de
    add hl,de
    ld de,NX_FASTOH
    add hl,de
    ex de,hl
    call NxChg
    pop de
    pop hl
    call NxSetW
NxOA1:
    ld a,(hl)
    add a,c
    out ($BE),a
    inc hl
    djnz NxOA1
    ret

; the frame's VRAM work, first thing after the frame wait
NxFrame:
    ld hl,NX_BUDGET
    ld a,(AMY_UVAR_NxLt)
    or a
    jr z,NxFr1
    ld hl,NX_LATEBUD
NxFr1:
    ld (AMY_UVAR_NxBud),hl
    ld hl,AMY_UVAR_Sat
    ld de,$1B00
    ld bc,17
    ; a late frame (NxLt, flags of the or above) may already be in the
    ; display: its sprite table goes out paced (seen 2026-11-17 by the VDP
    ; checker on the ending's return to the title: 7 drops in the SAT)
    jr nz,NxFr2
    call NxOutF
    jr NxFr3
NxFr2:
    call NxOutS
NxFr3:
    call NxBands
    call NxTwinkle
    call NxText
    jp NxLate

; one dirty text row (rows 1-7, from TxBuf), after the beam has passed it
NxText:
    ld a,(AMY_UVAR_TxDirty)
    or a
    ret z
    ld c,a
    ld b,1
    ld hl,AMY_UVAR_TxBuf
    ld de,$1822
NxTx1:
    ld a,c
    and b
    jr nz,NxTx2
    push bc
    ld bc,28
    add hl,bc
    ex de,hl
    ld c,32
    add hl,bc
    ex de,hl
    pop bc
    sla b
    jr NxTx1
NxTx2:
    ld a,b
    cpl
    and c
    ld (AMY_UVAR_TxDirty),a
    ld bc,28
    jp NxOutS

; TxPage: A = page (0 title, 1-5 how to play, 6 credits, 7 HUD, 8-9 the end): rows 1-7
; from the sky, then the page's text records; all six rows dirty
TxPage:
    push af
    ld hl,NxSkyName+34
    ld de,AMY_UVAR_TxBuf
    ld b,7
TxP1:
    push bc
    ld bc,28
    ldir
    ld c,4
    add hl,bc
    pop bc
    djnz TxP1
    pop af
    add a,a
    ld l,a
    ld h,0
    ld de,NxPages
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
TxP2:
    ld a,(hl)
    cp $FF
    jr z,TxP3
    call TxRec
    jr TxP2
TxP3:
    ld a,$7F
    ld (AMY_UVAR_TxDirty),a
    ret

; one text record at HL (row, column - 2, length, codes): into TxBuf
TxRec:
    ld a,(hl)
    inc hl
    dec a
    ld b,a
    add a,a
    add a,a
    ld c,a
    add a,a
    add a,a
    add a,a
    sub c
    ld e,a
    ld d,0
    ld a,(hl)
    inc hl
    add a,e
    ld e,a
    push hl
    ld hl,AMY_UVAR_TxBuf
    add hl,de
    ex de,hl
    pop hl
    ld c,(hl)
    inc hl
    ld b,0
    ldir
    ret

; TxMsg: A = message (255: none): row 5 back to the sky, then the message
TxMsg:
    push af
    ld hl,NxSkyName+5*32+2
    ld de,AMY_UVAR_TxBuf+4*28
    ld bc,28
    ldir
    ld a,(AMY_UVAR_TxDirty)
    or 16
    ld (AMY_UVAR_TxDirty),a
    pop af
    cp 255
    ret z
    ld hl,NxMsgs
    or a
    jr z,TxM2
    ld b,a
TxM1:
    inc hl
    inc hl
    ld a,(hl)
    inc hl
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    djnz TxM1
TxM2:
    jp TxRec

; NxBody: gravity, landing and walking off a roof for a body: HL = its feet
; y (i16, then vy i16, then air u8), DE = the roof under it (1/16 px)
NxBody:
    ld (AMY_UVAR_BP),hl
    ld (AMY_UVAR_BQ),de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_BA),a
    or a
    jr nz,NxB2
    ld hl,(AMY_UVAR_BQ)
    or a
    sbc hl,de
    jr c,NxB5
    jr z,NxB9
    ld bc,0
NxB2:
    ld a,(AMY_UVAR_BA)
    cp 200
    jr nc,NxB3
    inc a
    ld (AMY_UVAR_BA),a
NxB3:
    ld hl,AMY_UCONST_Grav
    add hl,bc
    ld b,h
    ld c,l
    bit 7,h
    jr nz,NxB4
    ld hl,AMY_UCONST_MaxFall
    or a
    sbc hl,bc
    jr nc,NxB4
    ld bc,AMY_UCONST_MaxFall
NxB4:
    ex de,hl
    add hl,bc
    ex de,hl
    bit 7,b
    jr nz,NxB9
    ld hl,(AMY_UVAR_BQ)
    or a
    sbc hl,de
    jr z,NxB5
    jr nc,NxB9
NxB5:
    ld de,(AMY_UVAR_BQ)
    ld bc,0
    xor a
    ld (AMY_UVAR_BA),a
NxB9:
    ld hl,(AMY_UVAR_BP)
    ld (hl),e
    inc hl
    ld (hl),d
    inc hl
    ld (hl),c
    inc hl
    ld (hl),b
    inc hl
    ld a,(AMY_UVAR_BA)
    ld (hl),a
    ret

; NxLayers: the ground moves 1 pixel a frame; P = ground + camera; every
; band's offset; the wheels turn with the ground, the smoke has 3 frames
NxLayers:
    ld hl,(AMY_UVAR_Ground)
    inc hl
    ld (AMY_UVAR_Ground),hl
    ld a,l
    rra
    rra
    rra
    and 3
    ld (AMY_UVAR_AnimWheel),a
    ld de,(AMY_UVAR_CamX)
    ; a frame where the camera crosses a cell (the train's names are all
    ; rewritten): the mid band waits a frame (B = 1), so the two never pile up
    ld a,(AMY_UVAR_OffTrain)
    xor e
    and $F8
    ld b,a
    ld a,(AMY_UVAR_OffTrain+1)
    xor d
    or b
    ld b,a
    ld (AMY_UVAR_OffTrain),de
    add hl,de
    ld (AMY_UVAR_P),hl
    ld a,l
    ld (AMY_UVAR_OffNear),a
    and 31
    ld (AMY_UVAR_OffRail),a
    xor a
    ld (AMY_UVAR_OffNear+1),a
    ld (AMY_UVAR_OffRail+1),a
    ld (AMY_UVAR_OffMid+1),a
    srl h
    rr l
    ld a,b
    or a
    jr nz,NxLy0
    ld a,l
    add a,3
    ld (AMY_UVAR_OffMid),a
NxLy0:
    ld a,(AMY_UVAR_Tick)
    rra
    jr c,NxLy1
    srl h
    rr l
    ld a,l
    add a,5
    ld (AMY_UVAR_OffFar),a
    xor a
    ld (AMY_UVAR_OffFar+1),a
NxLy1:
    ld hl,AMY_UVAR_SmT
    inc (hl)
    ld a,(hl)
    cp 18
    jr c,NxLy2
    xor a
    ld (hl),a
NxLy2:
    ld b,0
NxLy3:
    sub 6
    jr c,NxLy4
    inc b
    jr NxLy3
NxLy4:
    ld a,b
    ld (AMY_UVAR_AnimSmoke),a
    ; the train's cell (CamX / 8): TrPre = cell - CamC (the rear end shows
    ; while it is under 4; 255 with the whole strip, CamC 0: the strip's own
    ; rear), TrRow = (cell - ExtraC - RSkip, not below 0) * 8
    ld hl,(AMY_UVAR_OffTrain)
    ld a,l
    srl h
    rra
    srl h
    rra
    srl h
    rra
    ld b,a
    ; the 4 train bands' cell (D) and shift (E), once here: TrDE (v4, the
    ; frame time back for the rear-end checks)
    ld a,(AMY_UVAR_OffTrain)
    and 7
    ld (AMY_UVAR_TrDE),a
    ld a,b
    ld (AMY_UVAR_TrDE+1),a
    ld hl,AMY_UVAR_CamC
    sub (hl)
    inc (hl)
    dec (hl)
    jr nz,NxLy6
    ld a,255
NxLy6:
    ld (AMY_UVAR_TrPre),a
    ; while the rear end shows (TrPre < 4): the cab row (16) as on screen in
    ; CabRow, for the overlays (OvCab), when its cell or TrPre moved (here,
    ; in the frame's logic: no blank time; the band itself uses NxOutT)
    cp 4
    jr nc,NxCb2
    ld c,a
    ld hl,(AMY_UVAR_CabK)
    ld a,b
    cp l
    jr nz,NxCb0
    ld a,c
    cp h
    jr z,NxCb2
NxCb0:
    push bc
    ld l,b
    ld h,c
    ld (AMY_UVAR_CabK),hl
    ld a,b
    ld hl,Nx_cab_N0
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ; into CabRow (29: the overlay reads the cell right of column 29), the
    ; rear end (TrPre < 4) from the strip's own cells TrPre..3 as NxOutT:
    ; the strip behind a shorter train is the removed coaches' (luggage)
    push hl
    ld de,AMY_UVAR_CabRow
    ld bc,29
    ldir
    pop hl
    ld a,(AMY_UVAR_TrPre)
    ld b,a
    ld a,4
    sub b
    push af
    ld a,(AMY_UVAR_CamC)
    cpl
    ld c,a
    ld b,$FF
    inc bc
    add hl,bc
    pop af
    ld c,a
    ld b,0
    ld de,AMY_UVAR_CabRow
    ldir
    pop bc
NxCb2:
    ld a,b
    sub AMY_UCONST_ExtraC+AMY_UCONST_RSkip
    jr nc,NxLy5
    xor a
NxLy5:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld (AMY_UVAR_TrRow),hl
    ret

; NxSat: the sprite table: guard face (light red), coat (cyan), thief
; stripes (TCol: white, yellow off balance), body (black), end. Hidden at Y 192 (never 208).
NxSat:
    ld hl,(AMY_UVAR_Gx)
    ld de,(AMY_UVAR_Gy)
    call NxSx
    ld a,(AMY_UVAR_GDir)
    or a
    ld a,0
    jr z,NxSa1
    ld a,AMY_UCONST_SpGL
NxSa1:
    ld b,a
    ld a,(AMY_UVAR_GPose)
    add a,a
    add a,a
    add a,a
    add a,b
    ld hl,AMY_UVAR_Sat
    ld b,9
    call NxSp2
    ld hl,(AMY_UVAR_Tx)
    ld de,(AMY_UVAR_Ty)
    call NxSx
    ld a,(AMY_UVAR_TSt)
    cp AMY_UCONST_TsGone
    jr nz,NxSa2
    ld c,192
NxSa2:
    ; the thief's stripes: yellow while off balance, ducking or throwing
    ld b,AMY_UCONST_ColT
    ld a,(AMY_UVAR_TOff)
    or a
    jr nz,NxSa4
    ld a,(AMY_UVAR_TSt)
    sub AMY_UCONST_TsDuck
    cp 2
    jr nc,NxSa3
NxSa4:
    ld b,AMY_UCONST_ColOff
NxSa3:
    ld a,b
    ld (AMY_UVAR_TCol),a
    ld a,(AMY_UVAR_TPose)
    add a,a
    add a,a
    add a,a
    add a,AMY_UCONST_SpTR
    ld hl,AMY_UVAR_Sat+8
    call NxSp2
    ld (hl),208
    ret
; HL = x (1/16 px along the train), DE = feet y (1/16 px): D = screen x,
; C = sprite y (192: hidden, out of the view or fallen below the roofs)
NxSx:
    call NxD16
    ld bc,16
    add hl,bc
    ld bc,(AMY_UVAR_CamX)
    or a
    sbc hl,bc
    push hl
    ex de,hl
    call NxD16
    ld a,l
    sub 17
    ld c,a
    cp 158-17
    jr c,NxSx1
    ld c,192
NxSx1:
    pop hl
    ld d,l
    ld a,h
    or a
    jr nz,NxSx2
    ld a,l
    cp 16
    jr c,NxSx2
    cp 225
    ret c
NxSx2:
    ld c,192
    ret
NxD16:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ret
; two entries at HL: y C, x D, pattern A (and A + 4), colours B then the next table colour
NxSp2:
    ld (hl),c
    inc hl
    ld (hl),d
    inc hl
    ld (hl),a
    inc hl
    ld (hl),b
    inc hl
    ld (hl),c
    inc hl
    ld (hl),d
    inc hl
    add a,4
    ld (hl),a
    inc hl
    ld a,b
    cp 9
    ld a,7
    jr z,NxSp3
    ld a,1
NxSp3:
    ld (hl),a
    inc hl
    ret

; NumOut: HL = value: 5 digits into TxBuf[0..4]
NumOut:
    ld de,AMY_UVAR_TxBuf
    ld bc,10000
    call NumD
    ld bc,1000
    call NumD
    ld bc,100
    call NumD
    ld bc,10
    call NumD
    ld a,l
    jr NumD2
NumD:
    xor a
NumD1:
    or a
    sbc hl,bc
    jr c,NumD3
    inc a
    jr NumD1
NumD3:
    add hl,bc
NumD2:
    add a,AMY_UCONST_ChDigit
    ld (de),a
    inc de
    ret

; ---- the obstacle overlay, inside the band sequence. NxObs (after the near
; band): rows 13-16; NxObs2 (after the rails band): row 21. A bridge or
; gantry (ObT at screen x ObX, locked to the ground: ObX + P = 7 mod 8) is
; drawn EVERY frame it is on screen: its pre-shifted patterns (NxObT: per
; screen x & 7 one block, third 1 then third 2) and, per row, the names of
; the cells it covers (L, M..., R) plus the cell just right of it, which gets
; the band's own name back (it moves at most 2 px a frame). Row 16 is behind
; the train: a cell where the cab band shows anything but sky keeps the
; band's name, and the coal lump stays in front. ObClr: the last one is
; gone, its cells get the band's names back. Row 16 also carries the coal
; lump (LmSX; codes NX_COAL, +1, pre-shifted over two cells). Columns are
; kept + 16 (OvCol) so the left edge can go below 0.
NxObs:
    ; where they are drawn: from this frame's P and camera (the bands' own), so
    ; a bridge stays locked to the ground and the coal to the roof (ObX and
    ; LmSX, the logic's, are a frame older)
    ld hl,(AMY_UVAR_ObG)
    ld de,(AMY_UVAR_P)
    or a
    sbc hl,de
    ld (AMY_UVAR_OvOX),hl
    ld hl,(AMY_UVAR_LmX)
    ld de,16
    add hl,de
    ld de,(AMY_UVAR_CamX)
    or a
    sbc hl,de
    ld (AMY_UVAR_OvLX),hl
    ld hl,(AMY_UVAR_OvDX)
    ld (AMY_UVAR_OvUX),hl
    ld hl,(AMY_UVAR_OvLD)
    ld (AMY_UVAR_OvCX),hl
    xor a
    ld (AMY_UVAR_OvPh),a
    ld (AMY_UVAR_OvLmC),a
    ld a,(AMY_UVAR_LmOn)
    ld b,a
    ld a,(AMY_UVAR_LmClr)
    or b
    ld (AMY_UVAR_OvCoA),a
    ld a,(AMY_UVAR_ObClr)
    or a
    call nz,OvClr
    ld a,(AMY_UVAR_LmClr)
    or a
    jr z,NxOs1
    xor a
    ld (AMY_UVAR_LmClr),a
    inc a
    ld (AMY_UVAR_OvMd),a
    call LmRow
NxOs1:
    xor a
    ld (AMY_UVAR_OvMd),a
    ld hl,(AMY_UVAR_OvLX)
    ld (AMY_UVAR_OvCX),hl
    ld a,(AMY_UVAR_LmOn)
    or a
    jr z,NxOs2
    ld (AMY_UVAR_OvLD),hl
    call LmRow
NxOs2:
    ld a,(AMY_UVAR_ObT)
    or a
    ret z
    ld hl,(AMY_UVAR_OvOX)
    ld (AMY_UVAR_OvUX),hl
    call OvPats
    jr OvDraw
NxObs2:
    ld a,1
    ld (AMY_UVAR_OvPh),a
    ld a,(AMY_UVAR_ObClr)
    or a
    jr z,NxO21
    call OvClr
    xor a
    ld (AMY_UVAR_ObClr),a
NxO21:
    ld a,(AMY_UVAR_ObT)
    ld (AMY_UVAR_ObPT),a
    or a
    ret z
OvDraw:
    ld hl,(AMY_UVAR_OvOX)
    ld (AMY_UVAR_OvUX),hl
    ld (AMY_UVAR_OvDX),hl
    xor a
    ld (AMY_UVAR_OvMd),a
    call OvXs
    ld a,(AMY_UVAR_ObT)
    jr OvRows
OvClr:
    ld a,1
    ld (AMY_UVAR_OvMd),a
    call OvXs
    ld a,(AMY_UVAR_ObPT)
    or a
    ret z
; the obstacle's own cell (+16) and shift, from OvUX
OvXs:
    ld a,(AMY_UVAR_OvUX)
    and 7
    ld (AMY_UVAR_OvXf),a
    ld hl,(AMY_UVAR_OvUX)
    ld de,64
    add hl,de
    call OvCol
    ld (AMY_UVAR_OvXc),a
    ret
; A = type: the rows of this phase (OvPh 0: rows 13-16, 1: row 21 and below)
OvRows:
    ld c,a
    ld a,(AMY_UVAR_ObPT)
    or a
    ld a,0
    jr nz,OvRs0
    inc a
OvRs0:
    ld (AMY_UVAR_OvFo),a
    ld a,(AMY_UVAR_OvPh)
    or a
    jr z,OvRsA
    ; phase 1 (row 21): on from where phase 0 stopped (the rows are in order)
    ld hl,(AMY_UVAR_OvRP)
    ld a,(AMY_UVAR_OvRI)
    ld (AMY_UVAR_OvIx),a
    ld a,(AMY_UVAR_OvRN)
    ld b,a
    or a
    ret z
    jr OvRs1
OvRsA:
    xor a
    ld (AMY_UVAR_OvRN),a
    ld a,c
    call OvTyp
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    ld a,255
    ld (AMY_UVAR_OvIx),a
    ld b,(hl)
    inc hl
OvRs1:
    ld a,(hl)
    cp 20
    jr c,OvRs2
    ld a,(AMY_UVAR_OvPh)
    or a
    jr nz,OvRs2
    ; phase 0 has reached the row-21 entries: their place is kept for phase 1
    ld (AMY_UVAR_OvRP),hl
    ld a,b
    ld (AMY_UVAR_OvRN),a
    ld a,(AMY_UVAR_OvIx)
    ld (AMY_UVAR_OvRI),a
    ret
OvRs2:
    push bc
    ld a,(AMY_UVAR_OvIx)
    inc a
    ld (AMY_UVAR_OvIx),a
    ld (AMY_UVAR_OvP),hl
    call OvFast
    ld hl,(AMY_UVAR_OvP)
    push hl
    ld de,7
    add hl,de
    ld e,(hl)
    pop hl
    add hl,de
    pop bc
    djnz OvRs1
    ret
OvTyp:
    dec a
    add a,a
    add a,a
    add a,a
    ld l,a
    ld h,0
    ld de,NxObT
    add hl,de
    ret

; the patterns of type ObT at shift ObX & 7: N1 bytes at code C1 (third 1),
; the rest of the block at code C2 (third 2)
OvPats:
    ld a,(AMY_UVAR_ObT)
    call OvTyp
    inc hl
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_ObN2),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_ObN1),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_OvC1),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_OvC2),a
    ld a,(AMY_UVAR_OvUX)
    and 7
    ld b,a
    ex de,hl
    ld a,(AMY_UVAR_ObN2)
    ld e,a
    ld d,0
    inc b
    jr OvPt2
OvPt1:
    add hl,de
OvPt2:
    djnz OvPt1
    ld (AMY_UVAR_OvXp),hl
    ld a,(AMY_UVAR_OvC1)
    ld de,$0800
    call OvPtA
    ld a,(AMY_UVAR_ObN1)
    ld c,a
    ld b,0
    ld hl,(AMY_UVAR_OvXp)
    call NxOut
    ld hl,(AMY_UVAR_OvXp)
    ld a,(AMY_UVAR_ObN1)
    ld e,a
    ld d,0
    add hl,de
    ld (AMY_UVAR_OvXp),hl
    ld a,(AMY_UVAR_OvC2)
    ld de,$1000
    call OvPtA
    ld a,(AMY_UVAR_ObN1)
    ld b,a
    ld a,(AMY_UVAR_ObN2)
    sub b
    ld c,a
    ld b,0
    ld hl,(AMY_UVAR_OvXp)
    jp NxOut
; DE = DE + A * 8
OvPtA:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de
    ex de,hl
    ret

; the coal lump (OvMd 1: its cells get the band's names back). Its own
; work (OvBand, OvWrite's buffer, row 16's pass) is charged NX_OVOH like
; OvFast: uncharged, a lump and a busy rails frame ran the fast chain into
; line 261 (kit VDP checker, v4)
LmRow:
    ld de,NX_OVOH
    call NxChg
    ld a,1
    ld (AMY_UVAR_OvCo),a
    ld hl,(AMY_UVAR_OvCX)
    ld de,64
    add hl,de
    ld a,l
    and 7
    ld (AMY_UVAR_OvSL),a
    call OvCol
    ld (AMY_UVAR_OvCL),a
    inc a
    ld (AMY_UVAR_OvCR),a
    ld a,NX_COAL
    ld (AMY_UVAR_OvCd),a
    ld a,16
    ld (AMY_UVAR_OvRw),a
    ld a,(AMY_UVAR_OvMd)
    or a
    jr nz,LmR1
    ld a,(AMY_UVAR_OvCL)
    ld (AMY_UVAR_OvLmC),a
    ld a,(AMY_UVAR_OvSL)
    add a,a
    add a,a
    add a,a
    add a,a
    ld l,a
    ld h,0
    ld de,NxLump
    add hl,de
    ld de,$1000+NX_COAL*8
    ld bc,16
    call NxOut
LmR1:
    call OvBand
    call OvWrite
    xor a
    ld (AMY_UVAR_OvCo),a
    ret

OvCol:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,l
    add a,8
    ret

; the fast writer (drawing, every row but 16): the row's template for the
; shift OvXf (first cell from the obstacle's own cell OvXc, count, codes),
; streamed straight to VRAM, then the band's name in the cell right of it.
; Skipped when its cells and its band's step are as last frame.
OvFast:
    ld de,NX_OVOH
    call NxChg
    ld a,(hl)
    ld (AMY_UVAR_OvRw),a
    ld de,5
    add hl,de
    ld e,(hl)
    push hl
    ld hl,AMY_UVAR_NxSt
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_OvSt),a
    pop hl
    inc hl
    ld c,(hl)
    inc hl
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ex de,hl
    ld a,(AMY_UVAR_OvSt)
    ld e,a
    ld d,0
    add hl,de
    ld de,-18
    add hl,de
    ld (AMY_UVAR_OvRT),hl
    pop hl
    ld a,(AMY_UVAR_OvXf)
    or a
    jr z,OvF2
    ld b,a
    ld e,c
    ld d,0
OvF1:
    add hl,de
    djnz OvF1
OvF2:
    ld a,(AMY_UVAR_OvXc)
    add a,(hl)
    ld (AMY_UVAR_OvCL),a
    inc hl
    ld b,(hl)
    inc hl
    ld (AMY_UVAR_OvXp),hl
    add a,b
    ld (AMY_UVAR_OvCR),a
    ld a,(AMY_UVAR_OvMd)
    or a
    jr nz,OvF5b
    ld a,(AMY_UVAR_OvIx)
    ld e,a
    add a,a
    add a,e
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_OvSv
    add hl,de
    ld a,(AMY_UVAR_OvFo)
    ld b,a
    ld a,(AMY_UVAR_OvCL)
    cp (hl)
    jr z,OvF3
    ld (hl),a
    ld b,1
OvF3:
    inc hl
    ld a,(AMY_UVAR_OvCR)
    cp (hl)
    jr z,OvF4
    ld (hl),a
    ld b,1
OvF4:
    inc hl
    ld a,(AMY_UVAR_OvSt)
    cp (hl)
    jr z,OvF5
    ld (hl),a
    ld b,1
OvF5:
    ld a,(AMY_UVAR_OvRw)
    cp 16
    jr nz,OvF5a
    ld a,(AMY_UVAR_OvCoA)
    or b
    ld b,a
    call OvCab16
OvF5a:
    ld a,b
    or a
    ret z
OvF5b:
    ; window: CS = max(s, 18) in C, CE = min(e, 45) in B
    ld a,(AMY_UVAR_OvCL)
    cp 18
    jr nc,OvF6
    ld a,18
OvF6:
    ld c,a
    ld a,(AMY_UVAR_OvCR)
    cp 46
    jr c,OvF7
    ld a,45
OvF7:
    ld b,a
    cp c
    ret c
    ld a,(AMY_UVAR_OvMd)
    or a
    jr z,OvF7a
    ; clearing: the band's own names from CS to CE
    ld a,(AMY_UVAR_OvRw)
    cp 16
    call z,OvCab16
    ld a,c
    ld (AMY_UVAR_OvCS),a
    ld hl,(AMY_UVAR_OvRT)
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    push hl
    ld a,b
    sub c
    inc a
    ld (AMY_UVAR_OvX1),a
    pop de
    push de
    call OvOut0
    pop hl
    ld a,(AMY_UVAR_OvX1)
    ld c,a
    ld b,0
    jp NxOut
OvF7a:
    push bc
    ld a,(AMY_UVAR_OvRw)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,c
    sub 16
    add a,l
    ld l,a
    ld de,$1800
    add hl,de
    ex de,hl
    call NxSetW
    pop bc
    ld a,(AMY_UVAR_OvCL)
    ld e,a
    ld a,c
    sub e
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_OvXp)
    add hl,de
    ld a,(AMY_UVAR_OvCR)
    cp b
    ld a,b
    jr nz,OvF8
    sub c
    ld b,a
    ld d,1
    jr OvF9
OvF8:
    sub c
    inc a
    ld b,a
    ld d,0
OvF9:
    ld a,b
    or a
    jr z,OvFb
    ld c,$BE
OvFa:
    outi
    nop
    jp nz,OvFa
OvFb:
    ld a,d
    or a
    jr z,OvFc
    ld hl,(AMY_UVAR_OvRT)
    ld a,(AMY_UVAR_OvCR)
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    out ($BE),a
OvFc:
    ld a,(AMY_UVAR_OvRw)
    cp 16
    ret nz
    ; row 16 is behind the train: where the cab band shows anything but sky
    ; (luggage), its name goes back; the coal lump stays in front
    ld a,(AMY_UVAR_OvCL)
    ld c,a
    ld a,(AMY_UVAR_OvCR)
    sub c
    ret z
    ld b,a
OvFd:
    ld hl,(AMY_UVAR_OvRT)
    ld a,c
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    cp NX_CABSKY
    call nz,OvPoke
    inc c
    djnz OvFd
    ld a,(AMY_UVAR_OvLmC)
    or a
    ret z
    ld c,a
    ld a,NX_COAL
    call OvPoke
    inc c
    ld a,NX_COAL+1
; A = name at column C (+16) of row 16, when visible
OvPoke:
    push af
    ld a,c
    cp 18
    jr c,OvPk1
    cp 46
    jr nc,OvPk1
    push bc
    ld l,a
    ld h,0
    ld de,$1800+16*32-16
    add hl,de
    ex de,hl
    call NxSetW
    pop bc
    pop af
    out ($BE),a
    ret
OvPk1:
    pop af
    ret

; the names of row OvRw from column max(cL, 2) to min(cR + 1, 29): the band's
; names (OvRT), then (drawing) L, M..., R over them, then (row 16, the obstacle)
; the coal lump in front; out in one copy
OvWrite:
    ld a,(AMY_UVAR_OvCL)
    cp 18
    jr nc,OvNa
    ld a,18
OvNa:
    ld c,a
    ld (AMY_UVAR_OvCS),a
    ld a,(AMY_UVAR_OvCR)
    inc a
    cp 46
    jr c,OvNb
    ld a,45
OvNb:
    ld (AMY_UVAR_OvCE),a
    sub c
    ret c
    inc a
    ld b,a
    ld (AMY_UVAR_OvX1),a
    ld a,1
    ld (AMY_UVAR_OvWr),a
    ld hl,(AMY_UVAR_OvRT)
    ld e,c
    ld d,0
    add hl,de
    ld de,AMY_UVAR_OvBuf
    push bc
    ld c,b
    ld b,0
    ldir
    pop bc
    ; row 16, the obstacle's pass (behind the train): OvF16
    ld e,0
    ld a,(AMY_UVAR_OvRw)
    cp 16
    jr nz,OvW0
    ld a,(AMY_UVAR_OvCo)
    xor 1
    ld e,a
OvW0:
    ld a,e
    ld (AMY_UVAR_OvF16),a
    ld a,(AMY_UVAR_OvMd)
    or a
    jr nz,OvW8
    ; drawing: L at cL, M between, R at cR (c = column, b = count)
    ld a,(AMY_UVAR_OvCL)
    ld d,a
    ld a,(AMY_UVAR_OvCR)
    ld e,a
    ld hl,AMY_UVAR_OvBuf
OvW1:
    ld a,c
    cp d
    jr c,OvW5
    jr z,OvW2
    cp e
    jr z,OvW3
    jr nc,OvW5
    ld a,(AMY_UVAR_OvCm)
    jr OvW4
OvW2:
    ld a,(AMY_UVAR_OvCd)
    jr OvW4
OvW3:
    ld a,(AMY_UVAR_OvCd)
    inc a
OvW4:
    push af
    ld a,(AMY_UVAR_OvF16)
    or a
    jr z,OvW6
    ld a,(hl)
    cp NX_CABSKY
    jr z,OvW6
    pop af
    jr OvW5
OvW6:
    pop af
    ld (hl),a
OvW5:
    inc hl
    inc c
    djnz OvW1
OvW8:
    ld a,(AMY_UVAR_OvF16)
    or a
    jr z,OvOut
    ld a,(AMY_UVAR_OvLmC)
    or a
    jr z,OvOut
    ld c,NX_COAL
    call OvPut
    ld a,(AMY_UVAR_OvLmC)
    inc a
    ld c,NX_COAL+1
    call OvPut
OvOut:
    call OvOut0
    ld a,(AMY_UVAR_OvX1)
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_OvBuf
    jp NxOut
; DE = the name table address of row OvRw, column OvCS (+16)
OvOut0:
    ld a,(AMY_UVAR_OvRw)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_OvCS)
    sub 16
    add a,l
    ld l,a
    ld de,$1800
    add hl,de
    ex de,hl
    ret
; A = column + 16, C = code: into the buffer when the column is in it
OvPut:
    ld b,a
    ld a,(AMY_UVAR_OvCE)
    cp b
    ret c
    ld a,(AMY_UVAR_OvCS)
    ld e,a
    ld a,b
    sub e
    ret c
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_OvBuf
    add hl,de
    ld (hl),c
    ret
; the band under row OvRw: OvRT = its name strip + step - 18, OvSt = its step
OvBand:
    ld a,(AMY_UVAR_OvRw)
    sub 13
    ld e,a
    add a,a
    add a,e
    ld e,a
    ld d,0
    ld hl,OvBandT
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld a,(hl)
    push de
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_NxSt
    add hl,de
    ld e,(hl)
    ld a,e
    ld (AMY_UVAR_OvSt),a
    pop hl
    add hl,de
    ld de,-18
    add hl,de
; OvRT = HL, but row 16 while the rear end shows (TrPre < 4) reads the cab
; row as on screen (CabRow): the strip's cells behind a shorter train hold
; the removed coaches' luggage
; (OvFast: only on its row 16 paths, OvCab16, so the other rows pay nothing)
OvCab:
    ld (AMY_UVAR_OvRT),hl
    ld a,(AMY_UVAR_OvRw)
    cp 16
    ret nz
OvCab16:
    ld a,(AMY_UVAR_TrPre)
    cp 4
    ret nc
    ld hl,AMY_UVAR_CabRow-18
    ld (AMY_UVAR_OvRT),hl
    ret
; rows 13-22 -> the band's name strip, its NxSt index
OvBandT:
    dw Nx_near_N0
    db 6
    dw Nx_near_N1
    db 6
    dw Nx_smoke_N0
    db 9
    dw Nx_cab_N0
    db 12
    dw Nx_cab_N0
    db 12
    dw Nx_cab_N0
    db 12
    dw Nx_cab_N0
    db 12
    dw Nx_cab_N0
    db 12
    dw Nx_rails_N0
    db 21
    dw Nx_rails_N1
    db 21

; NxCam: MoveCamera (see there)
NxCam:
    ld hl,(AMY_UVAR_Gx)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld de,AMY_UCONST_GuardSX-16
    or a
    sbc hl,de
    ld de,(AMY_UVAR_CamMin)
    jr c,NxCm0
    or a
    sbc hl,de
    add hl,de
    jr nc,NxCm1
NxCm0:
    ex de,hl
NxCm1:
    ld de,AMY_UCONST_CamMax+1
    or a
    sbc hl,de
    add hl,de
    jr c,NxCm2
    ld hl,AMY_UCONST_CamMax
NxCm2:
    ; HL = W (the camera the guard wants)
    ld a,(AMY_UVAR_Ph)
    or a
    jr nz,NxCm3
    ld (AMY_UVAR_CamX),hl
NxCm3:
    ex de,hl
    ld hl,(AMY_UVAR_CamX)
    ; DE = W, HL = CamX; held: W = CamX
    ld a,(AMY_UVAR_Tick)
    rra
    jr c,NxCm4
    ld a,(AMY_UVAR_LmOn)
    ld b,a
    ld a,(AMY_UVAR_ObT)
    or b
    ret nz
    push hl
    ld bc,AMY_UCONST_CamEng
    or a
    sbc hl,bc
    pop hl
    ret nc
NxCm4:
    ld a,(AMY_UVAR_ObClr)
    ld b,a
    ld a,(AMY_UVAR_LmClr)
    or b
    ret nz
    ld a,(AMY_UVAR_Ph)
    cp AMY_UCONST_PhWin
    ret z
    ; W > CamX: one step on, unless it crosses a cell as the near band steps
    ex de,hl
    or a
    sbc hl,de
    ret z
    ex de,hl
    jr c,NxCmB
    ld a,l
    and 7
    cp 7
    jr nz,NxCmF
    ld bc,(AMY_UVAR_Ground)
    ld a,c
    add a,l
    add a,2
    ld c,a
    and 7
    cp 2
    ret c
    ld a,c
    and 6
    ret z
NxCmF:
    inc hl
    ld (AMY_UVAR_CamX),hl
    ret
NxCmB:
    ; W < CamX: one step back
    ld a,l
    and 7
    jr nz,NxCmG
    ld bc,(AMY_UVAR_Ground)
    ld a,c
    add a,l
    and 6
    ret z
NxCmG:
    dec hl
    ld (AMY_UVAR_CamX),hl
NxCmH:
    ret

; twinkle: every 6 frames one of the stars (in turn) takes the next of 3
; colours (grey, white, dark blue): 36 frames a state, under 2 Hz
; NxDawn: A = stage 0-3: the dark blue of the sky's dithered rows 4-7
; becomes the stage's colour (rows 4-5, rows 6-7); ~60 cycles a byte, safe
; while the screen is drawn. Stage 0 is the night. Stars stop twinkling
; while it is not night (NxNoTw).
NxDawn:
    ld (AMY_UVAR_NxNoTw),a
    add a,a
    ld e,a
    ld d,0
    ld hl,NxDawnT
    add hl,de
    ld b,(hl)
    inc hl
    ld c,(hl)
    push bc
    ld de,$2000+38*8
    call NxSetW
    pop bc
    ld hl,NxDawnC
    ld e,120
    call NxDw1
    ld b,c
    ld e,16
NxDw1:
    ld a,(hl)
    and $F0
    cp $40
    ld a,(hl)
    jr nz,NxDw2
    and $0F
    ld d,a
    ld a,b
    rlca
    rlca
    rlca
    rlca
    or d
NxDw2:
    ld d,a
    and $0F
    cp 4
    ld a,d
    jr nz,NxDw3
    and $F0
    or b
NxDw3:
    out ($BE),a
    inc hl
    dec e
    jr nz,NxDw1
    ret
NxDawnT:
    db 4,4, 4,13, 13,9, 13,11
NxTwinkle:
    ld a,(AMY_UVAR_NxNoTw)
    or a
    ret nz
    ld hl,AMY_UVAR_TwT
    inc (hl)
    ld a,(hl)
    cp 6
    ret c
    ld (hl),0
    ld hl,AMY_UVAR_TwK
    inc (hl)
    ld a,(hl)
    cp 18
    jr c,NxTw1
    xor a
    ld (hl),a
NxTw1:
    ld b,0
NxTw2:
    cp 6
    jr c,NxTw3
    sub 6
    inc b
    jr NxTw2
NxTw3:
    add a,a
    ld e,a
    ld d,0
    ld hl,NxTwk
    add hl,de
    ld e,(hl)
    inc hl
    ld a,(hl)
    ex de,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,a
    ld d,$20
    add hl,de
    ex de,hl
    call NxSetW
    ld a,b
    ld hl,NxTwC
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    out ($BE),a
    ret
NxTwC:
    db $E1,$F1,$41

; set up the screen (display off): clear VRAM, the sky, every static tile
; and colour, the sprite patterns, the overlay tiles; the first frame
; writes the bands
; NxMapInit: (display off) the HUD map's 7 tiles: bank 0, 128-134
NxMapInit:
    ld hl,NxMapP
    ld de,$0400
    ld bc,56
    call NxOutF
    ld hl,NxMapK
    ld de,$2400
    ld bc,56
    jp NxOutF
; NxMapDraw: the map of this run's train (its cells from (8 - Cars) * 2 to
; the engine's), then the markers
NxMapDraw:
    ld a,(AMY_UVAR_Cars)
    neg
    add a,8
    add a,a
    ld e,a
    ld d,0
    ld a,19
    sub e
    ld c,a
    ld b,d
    ld hl,AMY_UVAR_TxBuf+AMY_UCONST_MapC
    add hl,de
    push hl
    ld hl,NxMapT
    add hl,de
    pop de
    ldir
    ld hl,$FFFF
    ld (AMY_UVAR_MapG),hl
; NxMapTick: in play, every 4th frame: NxMapMark; every 16th while a bridge,
; a gantry or the coal is out (their frames are the heaviest)
NxMapTick:
    ld a,(AMY_UVAR_State)
    cp AMY_UCONST_StPlay
    ret nz
    ld a,(AMY_UVAR_ObT)
    ld b,a
    ld a,(AMY_UVAR_LmOn)
    or b
    ld a,(AMY_UVAR_Tick)
    jr z,NxMt1
    and 12
    ret nz
NxMt1:
    and 3
    ret nz
; NxMapMark: the guard's and the thief's cells, (x - 24) * 41 / 2048 (one
; cell for 50 px: a coach is 2 cells); only a move rewrites row 2
NxMapMark:
    ld hl,(AMY_UVAR_Gx)
    call NxMapC
    push af
    ld hl,(AMY_UVAR_Tx)
    call NxMapC
    cp 19
    jr c,NxMk1
    ld a,18
NxMk1:
    pop bc
    ld c,a
    ld hl,(AMY_UVAR_MapG)
    ld a,l
    cp b
    jr nz,NxMk2
    ld a,h
    cp c
    ret z
NxMk2:
    ld a,b
    ld (AMY_UVAR_MapG),a
    ld a,c
    ld (AMY_UVAR_MapH),a
    push bc
    ld a,l
    call NxMapR
    ld a,h
    call NxMapR
    pop bc
    ld a,b
    ld d,AMY_UCONST_TlGuard
    call NxMapS
    ld a,c
    ld d,AMY_UCONST_TlThief
    call NxMapS
    ld hl,AMY_UVAR_TxDirty
    set 1,(hl)
    ret
; the map's own tile back in cell A (if A < 19); keeps H
NxMapR:
    cp 19
    ret nc
    push hl
    ld e,a
    ld d,0
    ld hl,NxMapT
    add hl,de
    ld d,(hl)
    pop hl
; D into the map's cell A; keeps H, BC
NxMapS:
    push hl
    ld hl,AMY_UVAR_TxBuf+AMY_UCONST_MapC
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld (hl),d
    pop hl
    ret
; HL = x (1/16 px): A = its map cell
NxMapC:
    call NxD16
    ld de,-24
    add hl,de
    ld b,h
    ld c,l
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,de
    add hl,bc
    ld a,h
    rrca
    rrca
    rrca
    and 31
    ret
NxMapT:
    db 128,129,128,129,128,129,128,129,128,129,128,129,128,129,128,129,130,131,132
; NxBarRecol: the time bar's cells (row 3) to the next colour: green to
; yellow, yellow to red (+2: ChBarG, ChBarY, ChBarR; each with its half
; cell); the empty cells (ChBarE) stay
NxBarRecol:
    ld hl,AMY_UVAR_TxBuf+58
    ld b,18
NxBR1:
    ld a,(hl)
    cp AMY_UCONST_ChBarE
    jr nc,NxBR2
    add a,2
    ld (hl),a
NxBR2:
    inc hl
    djnz NxBR1
    ld hl,AMY_UVAR_TxDirty
    set 2,(hl)
    ret
; NxOffBal: A = frames: the thief off balance; in play, GRAB! while it
; lasts if the guard is near (behind him, within 80 px)
NxOffBal:
    ld (AMY_UVAR_TOff),a
    ld c,a
    ld a,(AMY_UVAR_State)
    cp AMY_UCONST_StPlay
    ret nz
    ld a,(AMY_UVAR_Ph)
    cp AMY_UCONST_PhChase
    ret nz
    ld hl,(AMY_UVAR_Tx)
    ld de,(AMY_UVAR_Gx)
    or a
    sbc hl,de
    ret c
    ld de,80*16
    sbc hl,de
    ret nc
    ld a,c
    ld (AMY_UVAR_MsgT),a
    ld a,AMY_UCONST_MsgGrab
    jp TxMsg
NxMapP:
    db $00,$00,$7F,$5B,$7F,$36,$00,$00,$00,$00,$FE,$DA,$FE,$6C,$00,$00
    db $00,$7C,$7E,$7E,$7E,$24,$00,$00,$78,$48,$7F,$7F,$7F,$36,$00,$00
    db $18,$18,$FE,$FF,$FF,$DA,$00,$00,$3C,$3C,$FF,$B6,$FF,$66,$00,$00
    db $7E,$3C,$FF,$B6,$FF,$66,$00,$00
NxMapK:
    db $11,$11,$E1,$B1,$E1,$E1,$11,$11,$11,$11,$E1,$B1,$E1,$E1,$11,$11
    db $11,$E1,$61,$61,$E1,$E1,$11,$11,$E1,$E1,$81,$81,$E1,$E1,$11,$11
    db $E1,$E1,$81,$81,$E1,$E1,$11,$11,$71,$71,$E1,$B1,$E1,$E1,$11,$11
    db $F1,$F1,$E1,$B1,$E1,$E1,$11,$11
NxInit:
    ld de,0
    call NxSetW
    ld bc,$4000
NxIn1:
    xor a
    out ($BE),a
    dec bc
    ld a,b
    or c
    jr nz,NxIn1
    ld hl,NxSkyName
    ld de,$1800
    ld bc,256
    call NxOutF
    ld hl,NxSprPat
    ld de,$3800
    ld bc,NX_SPRG
    call NxOutF
    ld hl,NxSprPat
    ld de,$3800+NX_SPRG
    ld b,NX_SPRG/32
    call NxMirror
    ld hl,NxSprPat+NX_SPRG
    ld de,$3800+NX_SPRG*2
    ld bc,NX_SPRB-NX_SPRG
    call NxOutF
NxIn4:
    ld hl,AMY_UVAR_NxSt
    ld b,24
NxIn2:
    ld (hl),$FF
    inc hl
    djnz NxIn2
    ld a,208
    ld (AMY_UVAR_Sat),a
    ret
NX_BUDGET EQU 12000
; (vdp-safe pass, 2026-11-15) a late frame starts at an unknown point of the
; blank (its logic ran into it): no fast (18 T) writes at all, every write is
; paced (NxOutS). With 9500 the fast chain could still run into the display.
NX_LATEBUD EQU 0
NX_FASTOH EQU 1100
NX_OVOH EQU 2100
; NxRep: (display off) B blocks of 8 bytes from HL, each written C times, at DE
; NxMirror: B 16 x 16 sprite patterns from HL, mirrored left-right, at DE
NxMirror:
    call NxSetW
NxM1:
    push bc
    push hl
    ld bc,16
    add hl,bc
    call NxM16
    pop hl
    call NxM16
    ld bc,16
    add hl,bc
    pop bc
    djnz NxM1
    ret
NxM16:
    ld b,16
NxM2:
    ld a,(hl)
    inc hl
    push bc
    ld b,8
NxM3:
    rra
    rl c
    djnz NxM3
    ld a,c
    pop bc
    out ($BE),a
    djnz NxM2
    ret
