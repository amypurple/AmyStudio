; ---- band engine (generated). State per band (NxSt): cell step, shift, animation frame.
; Per band: shift or step changed -> both pattern blocks; animation only -> the
; animated block; step changed -> the name rows. FAST bands use OTIR (vertical blank).
; order: the train first (the biggest writes get the fast blank), then the
; landscape top to bottom (each band still ahead of the beam), rails last
; NxOutT: NxOut (28 train names from HL at DE) but, while the rear end is
; on screen (TrPre < 4), its first k = 4 - TrPre cells come from the strip's
; own cells TrPre..3 (sky, then the last coach's end), at HL - CamC: written
; paced (NxOutS, safe anywhere, charged NX_PREOH to the blank budget), then
; the 28 - k others by NxOut
NX_PREOH EQU 400
NxOutT:
    ld a,(AMY_UVAR_TrPre)
    cp 4
    jp nc,NxOut
    ld b,a
    ld a,4
    sub b
    ld (AMY_UVAR_NxTk),a
    push hl
    push de
    ld de,NX_PREOH
    call NxChg
    ld a,(AMY_UVAR_CamC)
    cpl
    ld c,a
    ld b,$FF
    inc bc
    add hl,bc
    pop de
    push de
    ld a,(AMY_UVAR_NxTk)
    ld c,a
    ld b,0
    call NxOutS
    pop hl
    ld a,(AMY_UVAR_NxTk)
    ld c,a
    ld b,0
    add hl,bc
    ex de,hl
    pop hl
    add hl,bc
    ld a,28
    sub c
    ld c,a
    jp NxOut
