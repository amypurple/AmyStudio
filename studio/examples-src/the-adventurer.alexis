  132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,134,134,134,134,132,132,132,132,132
  132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132,132
end data
data KeyC bytes
  8,3,5,22,8,11,14,22,3,3,19,19
end data
data KeyR bytes
  5,8,16,5,3,10,8,10,13,16,8,10
end data
data MonC bytes
  9,3,6,23,9,12,15,23,3,3,20,20
end data
data MonR bytes
  6,9,17,6,3,11,9,11,14,17,9,11
end data
data NmT bytes
  1,9,11,4,5,7,8,6,3,10,12,2
end data
const StartC = 5
const StartR = 6
const NSpr = 4
const MonT = 12
const DeadN = 60
const WaitN = 45
const BoltN = 5

' a figure on the grid: target cell, sprite position, facing (0 up,
' 1 down, 2 left, 3 right), alive
record Fig:
  u8 C
  u8 R
  u8 X
  u8 Y
  u8 D
  u8 A
end record

Fig Figs[2]
' the keys still in the rooms (the key number, 0 when taken)
u8 NmR[12]
u16 TzLeft = 0
u8 TzOn = 0
u16 Off = 0
' rooms whose monster has been shot since the last key (no points again)
u16 KilM = 0
u16 Bit = 0
u16 Vo = 0
bcd digits 6 Score = 0
bcd digits 6 HiSc = 0
u8 Rm = 0
u8 Kn = 1
' lives, and where the adventurer came into the room
u8 Lives = 3
u8 EnC = 0
u8 EnR = 0
u8 EnD = 0
u8 Over = 0
u8 St = 0
u8 DeadT = 0
u8 Mq = 0
' frames the monster waits on entering a room
u8 Mw = 0
u8 Ma = 0
u8 Pf = 0
u8 Blk = 0
' the bolt: on, position, way, cells left, frames left in the cell, cell
u8 Ba = 0
u8 Bx = 0
u8 By = 0
u8 Bd = 0
u8 Bn = 0
u8 Bh = 0
u8 Bc = 0
u8 Br = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Li = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 T = 0
u8 Qc = 0
u8 Qr = 0
' title menu: 0 PLAY, 1 STORY; the story page shown
u8 Sel = 0
u8 Pg = 0
u8 WasK = 0

  tile screen
  set sound table AvSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    StoryPages
    goto title
  end if

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  St = 4
  if Score > HiSc then HiSc = Score
  mute all
  if Over = 2 then
    Ending
  else
    ShowHud
    print at 8,9, "                "
    print at 8,10, "   GAME  OVER   "
    print at 8,11, "                "
    print at 8,12, "   HI           "
    print at 14,12, HiSc
    print at 8,13, "                "
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (model.mjs is the same in JavaScript)

' the sprite position of a cell
function CellX(u8 Cc) as u8
  return Cc * 8 + 12

function CellY(u8 Rr) as u8
  return Rr * 8 + 4

' what stands on a cell: 0 floor, 1 wall (or off the room), 2 the key
function What(u8 Cc, u8 Rr) as u8
  u8 Tc = 0
  if Cc >= 28 then return 1
  if Rr >= 21 then return 1
  Tc = get char at Cc + 2, Rr + 1
  if Tc = TKey then return 2
  if Tc >= TRock then return 1
  return 0

' the cell one step from Qc, Qr the way Dd (into Qc, Qr; 255 off the top
' or left)
sub StepQ(u8 Dd):
  select case Dd
  case 0
    dec Qr
  case 1
    inc Qr
  case 2
    dec Qc
  case else
    inc Qc
  end select
  return
end sub

sub PlayStep:
  if DeadT > 0 then
    dec DeadT
    if DeadT = 0 then
      dec Lives
      if Lives = 0 then
        Over = 1
      else
        Figs[0].C = EnC
        Figs[0].R = EnR
        Figs[0].D = EnD
        Figs[0].X = CellX(EnC)
        Figs[0].Y = CellY(EnR)
        ShowHud
        DrawRoom
      end if
    end if
    return
  end if
  MoveMan
  if Over > 0 then return
  if Ma = 1 then MoveMon
  MoveBolt
  Touch
  return
end sub

' the adventurer: one pixel a frame; on a cell, the stick picks the next
sub MoveMan:
  u8 Mx = 0
  u8 My = 0
  u8 Md = 0
  u8 Wt = 0
  u8 Want = 255
  Mx = Figs[0].X
  My = Figs[0].Y
  K = J1 | J2
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  if Mx = CellX(Figs[0].C) then
    if My = CellY(Figs[0].R) then
      if K & 1 then Want = 0
      if K & 2 then Want = 1
      if K & 4 then Want = 2
      if K & 8 then Want = 3
      ' a press shoots: the way the stick points if it is held (turning
      ' on the spot), else the way he faces; no step on that frame
      if Press = 1 then
        if Want < 4 then Figs[0].D = Want
        Shoot
        Want = 254
      end if
      if Want = 254 then
        Blk = 0
      elseif Want = 255 then
        Blk = 0
      else
        Figs[0].D = Want
        Qc = Figs[0].C
        Qr = Figs[0].R
        StepQ(Want)
        Wt = 0
        if Qc >= 28 then Wt = 1
        if Qr >= 21 then Wt = 1
        if Wt = 1 then
          NextRoom(Want)
          Mx = Figs[0].X
          My = Figs[0].Y
        else
          Wt = What(Qc, Qr)
          if Wt = 2 then
            TakeKey
          elseif Wt = 0 then
            Figs[0].C = Qc
            Figs[0].R = Qr
            Blk = 0
            inc Pf
            play sound SndStep
          end if
        end if
      end if
    end if
  end if
  Md = CellX(Figs[0].C)
  if Mx < Md then inc Mx
  if Mx > Md then dec Mx
  Md = CellY(Figs[0].R)
  if My < Md then inc My
  if My > Md then dec My
  Figs[0].X = Mx
  Figs[0].Y = My
  return
end sub

' a key: the next number is taken, another one blocks
sub TakeKey:
  if NmR[Rm] = Kn then
    NmR[Rm] = 0
    inc Kn
    KilM = 0
    Score += 100
    put char TFloor at Qc + 2, Qr + 1
    play sound SndKey
    ShowHud
  elseif Blk = 0 then
    Blk = 1
    play sound SndWrong
  end if
  return
end sub

' out through an opening: the next room, in at the opposite side
sub NextRoom(u8 Dd):
  select case Dd
  case 0
    Rm = Rm - 4
    Figs[0].R = 20
  case 1
    Rm = Rm + 4
    Figs[0].R = 0
  case 2
    dec Rm
    Figs[0].C = 27
  case else
    inc Rm
    Figs[0].C = 0
  end select
  Figs[0].X = CellX(Figs[0].C)
  Figs[0].Y = CellY(Figs[0].R)
  ' (no early return here: a sub with arguments has an IX frame)
  Li = 0
  if Rm = 0 then
    if Kn = 13 then Li = 1
  end if
  if Li = 1 then
    Over = 2
  else
    DrawRoom
  end if
  return
end sub

' the monster: a pixel on two frames of three; on a cell it steps
' towards the adventurer, across first (as on the C64), else up or down
sub MoveMon:
  if Mw > 0 then
    dec Mw
    return
  end if
  inc Mq
  if Mq = 3 then
    Mq = 0
  else
    MonGo
  end if
  return
end sub

sub MonGo:
  u8 Ox = 0
  u8 Oy = 0
  u8 Gc = 0
  u8 Gr = 0
  u8 Pc = 0
  u8 Pr = 0
  Ox = Figs[1].X
  Oy = Figs[1].Y
  Gc = Figs[1].C
  Gr = Figs[1].R
  if Ox = CellX(Gc) then
    if Oy = CellY(Gr) then
      Pc = Figs[0].C
      Pr = Figs[0].R
      Li = 0
      if Pc < Gc then
        Li = MonTry(2)
      elseif Pc > Gc then
        Li = MonTry(3)
      end if
      if Li = 0 then
        if Pr < Gr then
          Li = MonTry(0)
        elseif Pr > Gr then
          Li = MonTry(1)
        end if
      end if
      Gc = Figs[1].C
      Gr = Figs[1].R
    end if
  end if
  V = CellX(Gc)
  if Ox < V then inc Ox
  if Ox > V then dec Ox
  V = CellY(Gr)
  if Oy < V then inc Oy
  if Oy > V then dec Oy
  Figs[1].X = Ox
  Figs[1].Y = Oy
  return
end sub

' the monster tries a step the way Dd: 1 when it went
function MonTry(u8 Dd) as u8
  Qc = Figs[1].C
  Qr = Figs[1].R
  StepQ(Dd)
  if What(Qc, Qr) <> 0 then return 0
  Figs[1].C = Qc
  Figs[1].R = Qr
  Figs[1].D = Dd
  return 1

' a bolt from the adventurer's cell, the way he faces
sub Shoot:
  if Ba = 1 then return
  play sound SndShot
  Bd = Figs[0].D
  Qc = Figs[0].C
  Qr = Figs[0].R
  Bx = CellX(Qc)
  By = CellY(Qr)
  StepQ(Bd)
  if What(Qc, Qr) <> 0 then return
  Bc = Qc
  Br = Qr
  Bn = BoltN
  Bh = 2
  Ba = 1
  return
end sub

' the bolt: four pixels a frame, two frames a cell, five cells at most
sub MoveBolt:
  if Ba = 0 then return
  select case Bd
  case 0
    By = By - 4
  case 1
    By = By + 4
  case 2
    Bx = Bx - 4
  case else
    Bx = Bx + 4
  end select
  dec Bh
  if Bh > 0 then return
  dec Bn
  if Bn = 0 then
    Ba = 0
    return
  end if
  Qc = Bc
  Qr = Br
  StepQ(Bd)
  if What(Qc, Qr) <> 0 then
    Ba = 0
    return
  end if
  Bc = Qc
  Br = Qr
  Bh = 2
  return
end sub

' touches: the bolt and the monster, the monster and the adventurer
function Near(u8 Ax, u8 Ay, u8 Cx, u8 Cy) as u8
  u8 Dx = 0
  u8 Dy = 0
  if Ax > Cx then
    Dx = Ax - Cx
  else
    Dx = Cx - Ax
  end if
  if Dx >= 7 then return 0
  if Ay > Cy then
    Dy = Ay - Cy
  else
    Dy = Cy - Ay
  end if
  if Dy >= 7 then return 0
  return 1

' the stiletto hits the gargoyle by the sprites' positions (+10), a box
' fitted to the drawings: across its flight up to 7 pixels off (a wing or
' a horn pierced; a gargoyle centred in the next row or column, 8 off, is
' missed), along it from where 5 or more pixels of the blade lie on the
' gargoyle. Sideways X 0-18, Y 3-16; up/down X 3-17, Y 2-19. (The old
' test, 6 pixels off every way, missed visible wing and horn hits.)
function BoltHit as u8
  u8 Dx = 0
  u8 Dy = 0
  Dx = Bx + 10
  Dx = Dx - Figs[1].X
  Dy = By + 10
  Dy = Dy - Figs[1].Y
  if Bd >= 2 then
    if Dx > 18 then return 0
    if Dy < 3 then return 0
    if Dy > 16 then return 0
    return 1
  end if
  if Dx < 3 then return 0
  if Dx > 17 then return 0
  if Dy < 2 then return 0
  if Dy > 19 then return 0
  return 1

sub Touch:
  if Ma = 0 then return
  if Ba = 1 then
    if BoltHit() = 1 then
      Ba = 0
      Ma = 0
      Bit = 1 << Rm
      if (KilM & Bit) = 0 then
        Score += 50
        KilM = KilM | Bit
      end if
      play sound SndKill
      ShowHud
      return
    end if
  end if
  if Near(Figs[0].X, Figs[0].Y, Figs[1].X, Figs[1].Y) = 1 then
    DeadT = DeadN
    Ba = 0
    play sound SndDead
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the adventurer, 1-2 the gargoyle (detail over body), 3 the
' stiletto
sub DrawSprites:
  u8 Sy = 0
  u8 Pt = 0
  Sy = Figs[0].Y - 1
  if DeadT > 0 then
    set sprite 0 to Sy,Figs[0].X,SDead,15
  else
    Pt = Figs[0].D
    select case Pt
    case 0
      Pt = SUp0
    case 1
      Pt = SDown0
    case 2
      Pt = SLeft0
    case else
      Pt = SRight0
    end select
    V = Figs[0].X + Figs[0].Y
    V = V >> 2
    V = V & 1
    Pt = Pt + V * 4
    set sprite 0 to Sy,Figs[0].X,Pt,15
  end if
  if Ma = 1 then
    Sy = Figs[1].Y - 1
    ' two frames, a change every 16 frames (under 2 a second)
    V = Tick >> 4
    V = V & 1
    Pt = SEye0 + V * 8
    set sprite 1 to Sy,Figs[1].X,Pt,6
    Pt = SMon0 + V * 8
    set sprite 2 to Sy,Figs[1].X,Pt,14
  else
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end if
  if Ba = 1 then
    Sy = By - 1
    select case Bd
    case 0
      Pt = SBoltv
    case 1
      Pt = SBoltd
    case 2
      Pt = SBolth
    case else
      Pt = SBoltr
    end select
    set sprite 3 to Sy,Bx,Pt,15
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,22, "SC"
  print at 5,22, Score
  if Kn < 13 then
    print at 13,22, "COFFER"
    Vo = Kn
    print at 20,22, digits$(Vo, 2)
  else
    print at 13,22, "GET OUT  "
  end if
  print at 26,22, "L"
  Vo = Lives
  print at 28,22, digits$(Vo, 1)
  return
end sub

' the room Rm on rows 1-21, its key and monster
sub DrawRoom:
  Rearm
  wait
  nmi off
  display off
  for Ri = 0 to 20
    Off = Rm * 588
    Off = Off + Ri * 28
    Vo = Ri * 32 + 34
    copy RoomT + Off count 28 to vram.name + Vo
  next
  if NmR[Rm] > 0 then
    Qc = KeyC[Rm] + 2
    Qr = KeyR[Rm] + 1
    put char TKey at Qc, Qr
  end if
  EnC = Figs[0].C
  EnR = Figs[0].R
  EnD = Figs[0].D
  Ma = 0
  Ba = 0
  Mq = 0
  Mw = WaitN
  Blk = 0
  if NmR[Rm] > 0 then Ma = 1
  if Kn = 13 then Ma = 1
  if Ma = 1 then
    Figs[1].C = MonC[Rm]
    Figs[1].R = MonR[Rm]
    Figs[1].X = CellX(Figs[1].C)
    Figs[1].Y = CellY(Figs[1].R)
    Figs[1].D = 1
  end if
  DrawSprites
  screen on
  nmi off
  return
end sub

sub NewGame:
  Score = 0
  Lives = 3
  KilM = 0
  Kn = 1
  Rm = 0
  for Li = 0 to 11
    NmR[Li] = NmT[Li]
  next
  NewScreen
  fill TRule count 28 at 2,0
  fill TRule count 28 at 2,23
  Figs[0].C = StartC
  Figs[0].R = StartR
  Figs[0].X = CellX(StartC)
  Figs[0].Y = CellY(StartR)
  Figs[0].D = 3
  Figs[0].A = 1
  DeadT = 0
  Over = 0
  Pf = 0
  ShowHud
  DrawRoom
  St = 3
  play sound SndStep
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' the door at the end: it opens from the middle, then the last words
sub Ending:
  NewScreen
  backdrop black
  print at 3,3, "YOU ARE OPENING THE DOOR..."
  for Ri = 6 to 18
    put char TFrame at 10,Ri
    put char TFrame at 21,Ri
    fill TPlank count 10 at 11,Ri
  next
  fill TFrame count 12 at 10,5
  ShowScreen
  play sound SndKey
  Rearm
  wait 60 frames
  nmi off
  for Li = 0 to 4
    J = 15 - Li
    K = 16 + Li
    Rearm
    wait 20 frames
    nmi off
    for Ri = 6 to 18
      put char TLight at J,Ri
      put char TLightb at K,Ri
    next
  next
  play sound SndDoor
  print at 8,20, "YOU'RE ESCAPING"
  Rearm
  wait 60 frames
  nmi off
  print at 13,11, "THE"
  print at 13,12, "END"
  Rearm
  wait 60 frames
  nmi off
  print at 11,21, "MAYBE..."
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the first room behind a panel, the tune once
sub TitlePage:
  St = 0
  NewScreen
  Rm = 0
  for Li = 0 to 11
    NmR[Li] = NmT[Li]
  next
  Kn = 1
  fill TRule count 28 at 2,0
  fill TRule count 28 at 2,23
  DrawRoom
  Ma = 0
  Rearm
  wait
  nmi off
  for Ri = 7 to 15
    fill 32 count 24 at 4,Ri
  next
  fill TRule count 24 at 4,7
  fill TRule count 24 at 4,15
  print at 9,9, "THE ADVENTURER"
  print at 6,10, "BY JEAN-FRANCOIS HEON"
  print at 14,12, "PLAY"
  print at 14,13, "STORY"
  Sel = 0
  MenuMark
  print at 2,22, "AHOY! FEB 1987"
  print at 19,22, "HI"
  print at 22,22, HiSc
  HideSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  St = 2
  WasK = 255
tp_loop:
  Frame1
  ReadPad
  K = J1 | J2
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  ' up and down move the mark (on the push)
  V = K & 3
  if V <> WasK then
    if V = 1 then Sel = 0
    if V = 2 then Sel = 1
    if V > 0 then MenuMark
  end if
  WasK = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

' the menu mark beside PLAY or STORY
sub MenuMark:
  if Sel = 0 then
    print at 12,12, ">"
    print at 12,13, " "
  else
    print at 12,12, " "
    print at 12,13, ">"
  end if
  return
end sub

' the story and how to play, three pages: a button or a push of the
' stick turns the page; after the last, back to the title
sub StoryPages:
  St = 5
  for Pg = 1 to 3
    NewScreen
    put char TGarg00 at 26,1
    put char TGarg01 at 27,1
    put char TGarg02 at 28,1
    put char TGarg10 at 26,2
    put char TGarg11 at 27,2
    put char TGarg12 at 28,2
    fill TRule count 23 at 2,3
    select case Pg
    case 1
      Story1
    case 2
      Story2
    case else
      Story3
    end select
    print at 2,22, "BUTTON OR STICK: NEXT"
    Vo = Pg
    print at 26,22, digits$(Vo, 1)
    print at 27,22, "/3"
    ShowScreen
    WasK = 255
sp_wait:
    Frame1
    ReadPad
    K = J1 | J2
    ' a new push only: everything let go first
    if K = 0 then
      WasK = 0
      goto sp_wait
    end if
    if WasK <> 0 then goto sp_wait
    WasK = K
    play sound SndStep
  next
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

sub Story1:
  print at 2,2, "THE THIEF"
  print at 2,5, "THE GUILD-MASTER WARNED YOU:"
  print at 2,6, "KEEP AWAY FROM THAT TOWN,"
  print at 2,7, "ITS WALLS CROWDED WITH STONE"
  print at 2,8, "GARGOYLES, ITS PEOPLE GOING"
  print at 2,9, "MISSING ONE BY ONE."
  print at 2,11, "GREED WON. YOU ROBBED ITS"
  print at 2,12, "CHURCH, AND THE CLERICS"
  print at 2,13, "CAUGHT YOU."
  print at 2,15, "YOUR SENTENCE: GO UNDER THE"
  print at 2,16, "GROUND WITH A KEY AND ONE"
  print at 2,17, "WEAPON, AND COME BACK ALIVE."
  print at 2,18, "YOU TOOK A STILETTO: THROWN,"
  print at 2,19, "IT FLIES BACK TO YOUR HAND."
  return
end sub

sub Story2:
  print at 2,2, "THE SENTENCE"
  print at 2,5, "THE KEY IS OLD. ITS NUMBER"
  print at 2,6, "STARTS WITH 1; THE OTHER"
  print at 2,7, "DIGIT IS WORN AWAY. IT CAME"
  print at 2,8, "FROM A SET OF TEN TO 19."
  print at 2,10, "FIND AND OPEN EVERY COFFER"
  print at 2,11, "BELOW, SAY THE CLERICS: THEY"
  print at 2,12, "OPEN ONLY IN THE ORDER OF"
  print at 2,13, "THEIR NUMBERS. THE GUARDIANS"
  print at 2,14, "LEAVE A ROOM WITH AN OPEN"
  print at 2,15, "COFFER ALONE."
  print at 2,17, "THEY PUSH YOU INTO A PIT."
  print at 2,18, "TWENTY FEET DOWN, NO WAY UP."
  print at 2,19, "A GARGOYLE LEAPS; YOUR BLADE"
  print at 2,20, "ENDS IT. A BIG COFFER WAITS."
  return
end sub

sub Story3:
  print at 2,2, "HOW TO PLAY"
  print at 2,5, "OPEN THE COFFERS IN ORDER."
  print at 2,6, "THE BOTTOM LINE SHOWS THE"
  print at 2,7, "NUMBER YOU NEED NEXT. A"
  print at 2,8, "COFFER THAT WILL NOT OPEN IS"
  print at 2,9, "NOT YOURS YET."
  print at 2,11, "A GARGOYLE GUARDS EACH ROOM"
  print at 2,12, "WITH A SHUT COFFER. ITS"
  print at 2,13, "TOUCH COSTS A LIFE (3)."
  print at 2,15, "STICK: WALK. BUTTON: THROW"
  print at 2,16, "THE STILETTO; IT COMES BACK."
  print at 2,17, "STICK + BUTTON: THROW THAT"
  print at 2,18, "WAY WITHOUT A STEP."
  print at 2,19, "ALL OPEN? GO BACK TO WHERE"
  print at 2,20, "YOU FELL: THE WAY OUT."
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "THE ADVENTURER"
  print at 2,5, "BASED ON THE ADVENTURER BY"
  print at 2,6, "JEAN-FRANCOIS HEON, AHOY!"
  print at 2,7, "FEBRUARY 1987 (C-64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: TWELVE KEYS"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  St = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

