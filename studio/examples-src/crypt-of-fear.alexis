cartridge "CRYPT OF FEAR/CLEVELAND M. BLAKEMORE/1988"

' CRYPT OF FEAR
' A ColecoVision game based on "Crypt of Fear" by Cleveland M. Blakemore,
' Ahoy! February 1988 (Commodore 64, BASIC). Made for Amy Studio by Claude
' (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu. The listing is
' in orig/, the crypt's map in map.py.
'
' Not a line-by-line port: the crypt, the monsters, the items and the
' rules come from the listing; the game is built for the ColecoVision.
' You are a knight in a crypt of 16 x 16 cells, seen in 3-D by the light
' of your lantern. Sixteen monsters roam it; the princess waits in the
' deepest row. Win the shield, the wand, the ring and the map from the
' monsters, find the amulet, slay the Demigorgon for its crown, then lead
' the princess back to the gate where you came in, before the oil runs out.
'
' Controls (either joystick): up walks forward, down steps back, left and
' right turn; the left button uses the item under the cursor (lantern:
' light / put out, sword or wand: strike, elixir: drink, map: look); the
' right button opens the item panel: left and right move the cursor, up
' takes what lies here, down drops the item, either button closes it.
'
' From the listing: the map (DATA 5000-5030), the start in the north-west
' corner facing south, 16 monsters (2 spiders, 2 cobras, 2 imps, a blob,
' 3 knights, 4 wraiths, the princess, the Demigorgon) with type x 8 + 1
' hit points, the amulet in cell 238, a slain monster leaves the item of
' its number, its number in life and 100 gold a number; its blow lands
' when RND + type/100 > .92 and costs type/(shield ? 2 : 1) + 1-3; your
' blow misses 50% minus your life %, deals RND + 2 + life/6 (+2 with the
' ring); the wand never misses the Demigorgon; the elixir gives 20 life;
' life grows .02 a turn; the lantern dims six times, then the oil is gone
' and so are you; monsters step toward you now and then.
'
' New here: you start with the sword as well as the lantern (in the
' listing nothing can be fought before one is found, and only a monster
' drops one); the lantern can be put out to save oil (the crypt is then
' black); the item panel takes everything lying in the cell at once; the
' princess follows you once found.
'
' House rules: text in columns 2-30, rows 1-22; tiles from code 128;
' screens drawn with the NMI off; music first in the sound table ($702B,
' $7035), effects after, by channel; nothing flashes faster than 3 Hz.

const TCeil = 128
const TFloor = 132
const TFar = 136
const TSide = 137
const TFront = 173
const TSconce = 179
const TWeb = 183
const TMoss = 185
const TObjF = 192
const TObjP = 201
const TLifeF = 210
const TOilF = 213
const TMapW = 216
const TMapO = 217
const TFrame = 218
const NTiles8 = 728
const SprBytes = 1952
const SCursor = 128
const SYou = 132
const SSlash = 136
const SSpark = 148
const SDigT = 156
const SDigU = 196
const SHero = 236
const SHeart = 240
const SndTuneA = 1
const SndTuneB = 2
const SndCryA = 3
const SndCryB = 4
const SndStep = 5
const SndBump = 6
const SndSlash = 7
const SndHit = 8
const SndMiss = 9
const SndOuch = 10
const SndHiss = 11
const SndGrowl = 12
const SndOoze = 13
const SndWail = 14
const SndRoar = 15
const SndDie = 16
const SndTake = 17
const SndDrop = 18
const SndDrink = 19
const SndLight = 20
const SndPrincess = 21
const SndWin = 22
const SndLose = 23
const SndDrip = 24
const SndTick = 25
const TuneLen = 576
const MoveEvery = 900
const OilStep = 6000
const RoundEvery = 40
u16 TzLeft = 0
u8 TzOn = 0

' the knight: Pc cell (row x 16 + column), Dir 0 north 1 east 2 south 3 west
u8 Pc = 17
u8 Dir = 2
' life in hundredths, gold, oil: Dd dim steps used (0-6), Fu frames left
' in this step, Lit 1 when burning, Lv the light shown (0 bright, 6 black)
u16 Lf = 1000
u16 Gold = 0
u8 Dd = 0
u16 Fu = 0
u8 Lit = 0
u8 Lv = 6
u8 LvShown = 255
' items: InvL bits 0-7 (lantern, sword, shield, wand, ring, elixir, map,
' amulet), Crown the crown, Cur the cursor (0-8); the crown on the floor
u8 InvL = 3
u8 Crown = 0
u8 Cur = 0
u8 CrownC = 255
u8 Saved = 0
u8 Slain = 0
' the monsters: cell (255 gone), type 1-8, hit points
u8 Mc[16]
u8 Mt[16]
u8 Mh[16]
' Mi the monster in your cell (255 none), Ms the one shown one cell ahead
u8 Mi = 255
u8 Ms = 255
u8 MiWas = 255
u16 MoveT = 0
u8 RoundT = 0
u8 Won = 0
u8 Lost = 0
u8 Why = 0
u16 Hi = 0
u16 Rs = 1
u16 Seed = 1
' for the test bot
u8 Idle = 0
u8 InMenu = 0
u8 Busy = 0
u16 Moves = 0
u8 LastHit = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 P1 = 0
u8 P2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
u8 Menu = 0
u8 DripN = 0
u8 Bob = 0
' Weap the weapon in hand (1 sword, 3 wand); Act the left button's action
' (1 attack, 2 take, 3 open, 4 use the item chosen); Lim the depths lit
u8 Weap = 1
u8 Act = 0
u8 Lim = 3
' effects: FlY the flinch, FlC its flash, Jolt your shake, Blink the eyes,
' Fx the effect running (for the tests: 1 slash, 2 wound, 3 hurt, 4 death,
' 5 sparkle), Dmg the wound shown, Flm the flame picture
u8 FlY = 0
u8 FlC = 0
u8 Jolt = 0
u8 Blink = 0
u8 Fx = 0
u8 Dmg = 0
u8 DripS = 0
u8 Flm = 0
u8 Sx = 0
u8 Dt = 0
u8 Du = 0
u8 MapOn = 0
' the 3-D view (16 x 16 tiles) before it goes to the screen
u8 Vb[256]
' scratch
u16 A16 = 0
u16 W16 = 0
u16 NumU = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Tc = 0
u8 Ct = 0
u8 R = 0
u8 Rb = 0
u8 V1 = 0
u8 V2 = 0
u8 Ri = 0
u8 Rj = 0
u8 Ca = 0
u8 Mr = 0
u8 Mcl = 0
u8 Pr = 0
u8 Pcl = 0

  tile screen
  set sound table CrSoundTable areas 6
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  Pc = 17
  Dir = 2
  Lf = 1000
  Gold = 0
  Dd = 0
  Fu = OilStep
  Lit = 0
  InvL = 3
  Weap = 1
  Crown = 0
  Cur = 0
  CrownC = 255
  Saved = 0
  Slain = 0
  Won = 0
  Lost = 0
  Why = 0
  Moves = 0
  MoveT = MoveEvery
  RoundT = RoundEvery
  InMenu = 0
  LvShown = 255
  Rs = Seed
  GameScreen
  play sound SndCryA
  play sound SndCryB
  ShowAll
  print at 2,18, "THE CRYPT IS BLACK. THE LEFT"
  print at 2,19, "BUTTON LIGHTS YOUR LANTERN;"
  print at 2,20, "THE RIGHT ONE OPENS THE PACK"

play_loop:
  Idle = 1
  Frame1
  Animate
  ' the pad first, so a press is not lost while a blow lands
  ReadPad
  Timers
  if Lost = 1 then goto game_lost
  if P1 = 1 then
    Idle = 0
    DoAct
    goto after_act
  end if
  if P2 = 1 then
    Idle = 0
    ItemPanel
    goto after_act
  end if
  if Stk = 0 then goto play_loop
  ' one move a push; walking repeats while held
  if WasStk = 1 then
    V = Up1 | Dn1
    if V = 0 then goto play_loop
    inc Rep
    if Rep < 14 then goto play_loop
  end if
  Rep = 0
  WasStk = 1
  Idle = 0
  if Up1 = 1 then
    Walk(Dir)
  elseif Dn1 = 1 then
    V = Dir + 2
    V = V & 3
    Walk(V)
  elseif Lf1 = 1 then
    Dir = Dir + 3
    Dir = Dir & 3
    ShowAll
  elseif Rt1 = 1 then
    Dir = Dir + 1
    Dir = Dir & 3
    ShowAll
  end if
after_act:
  if Lost = 1 then goto game_lost
  if Won = 1 then goto game_won
  goto play_loop

game_lost:
  Idle = 0
  mute all
  play sound SndLose
  EndPage
  goto title

game_won:
  Idle = 0
  mute all
  play sound SndWin
  EndPage
  goto title

' ---------------------------------------------------------------------------
' time: the monsters' blows (a round every 40 frames), life growing, the
' oil burning, the monsters stepping toward you

sub Timers:
  if Lit = 1 then
    dec Fu
    if Fu = 0 then
      Fu = OilStep
      inc Dd
      if Dd >= 6 then
        Why = 2
        Lost = 1
        return
      end if
      SetLight
      ShowHud
      ClearMsg
      print at 2,18, "YOUR LANTERN GROWS DIMMER."
    end if
  end if
  dec RoundT
  if RoundT = 0 then
    RoundT = RoundEvery
    MonRound
    if Lost = 1 then return
  end if
  dec MoveT
  if MoveT = 0 then
    MoveT = MoveEvery
    MoveMons
  end if
  return
end sub

' MonRound: life grows .02; the monster here may strike
sub MonRound:
  if Lf < 9900 then Lf = Lf + 2
  LastHit = 0
  if Mi = 255 then return
  V = Mt[Mi]
  R = CrRnd(100)
  W = R + V
  if W <= 92 then return
  ' the blow: type / (shield ? 2 : 1) + 1-3
  W = V
  V1 = InvL & 4
  if V1 > 0 then W = W >> 1
  R = CrRnd(3)
  W = W + R
  W = W + 1
  LastHit = W
  W16 = W
  W16 = W16 * 100
  play sound SndOuch
  HurtFx
  ClearMsg
  V = Mt[Mi]
  PrintMon(2, 18, V)
  print at 14,18, "STRIKES YOU!"
  if W16 >= Lf then
    Lf = 0
    Why = 1
    Lost = 1
    ShowHud
    return
  end if
  Lf = Lf - W16
  ShowHud
  return
end sub

'' Riposte: the monster's answer to a blow, after a short pause
sub Riposte:
  for J = 0 to 11
    Frame1
  next
  MonRound
  return
end sub

' MoveMons: each monster (but the princess) steps one cell toward you,
' along the row first, into an open cell with no monster
sub MoveMons:
  Pr = Pc >> 4
  Pcl = Pc & 15
  for K = 0 to 15
    C = Mc[K]
    if C = 255 then goto mm_next
    if Mt[K] = 7 then goto mm_next
    if C = Pc then goto mm_next
    Mr = C >> 4
    Mcl = C & 15
    X = 255
    if Mcl < Pcl then X = C + 1
    if Mcl > Pcl then X = C - 1
    if X <> 255 then
      if MapData[X] = 1 then
        V = MonAt(X)
        if V = 255 then
          Mc[K] = X
          goto mm_next
        end if
      end if
    end if
    X = 255
    if Mr < Pr then X = C + 16
    if Mr > Pr then X = C - 16
    if X <> 255 then
      if MapData[X] = 1 then
        V = MonAt(X)
        if V = 255 then Mc[K] = X
      end if
    end if
mm_next:
  next
  Here
  ShowAll
  return
end sub

' MonAt(cell): the monster in a cell (255 none)
function MonAt(u8 Mx) as u8
  for Rj = 0 to 15
    if Mc[Rj] = Mx then return Rj
  next
  return 255

' Here: the monster in your cell; a new one is announced
sub Here:
  Mi = MonAt(Pc)
  if Mi = MiWas then return
  MiWas = Mi
  if Mi = 255 then return
  V = Mt[Mi]
  if V = 7 then
    ' the princess: she follows you from now on
    Mc[Mi] = 255
    Mi = 255
    MiWas = 255
    Saved = 1
    play sound SndPrincess
    ClearMsg
    print at 2,18, "THE PRINCESS! MY KNIGHT,"
    print at 2,19, "TAKE ME OUT OF THIS PLACE!"
    print at 2,20, "SHE FOLLOWS YOU NOW."
    ShowHud
    return
  end if
  N = MSnd[V]
  play sound N
  ClearMsg
  print at 2,18, "HERE IS A"
  PrintMon(12, 18, V)
  return
end sub

' ---------------------------------------------------------------------------
' moving

' Walk(way): one cell that way (forward or back) if it is open; at the
' gate with everything, the princess and the crown, you are out
sub Walk(u8 Wd):
  X = Pc + DcT[Wd]
  Ct = MapData[X]
  if Ct <> 1 then
    play sound SndBump
    if Pc = 17 then
      AtGate
      return
    end if
    ClearMsg
    print at 2,18, "COLD STONE."
    return
  end if
  Pc = X
  inc Moves
  play sound SndStep
  ClearMsg
  MiWas = 255
  Here
  ShowAll
  RoomNote
  return
end sub

sub AtGate:
  ClearMsg
  V = InvL & $DF
  if V = $DF then
    if Crown = 1 then
      if Saved = 1 then
        Won = 1
        return
      end if
    end if
  end if
  print at 2,18, "THE GATE OF THE CRYPT. BRING"
  print at 2,19, "THE PRINCESS, THE CROWN AND"
  print at 2,20, "ALL SEVEN TREASURES HERE."
  return
end sub

' RoomNote: what lies on the floor (when no monster is announced)
sub RoomNote:
  if Mi <> 255 then return
  if Lv = 6 then return
  V = RoomBits(Pc)
  if V = 0 then
    if CrownC <> Pc then return
  end if
  print at 2,18, "SOMETHING LIES HERE."
  print at 2,19, "THE LEFT BUTTON TAKES IT."
  return
end sub

' ---------------------------------------------------------------------------
' items

' UseItem: the item under the cursor
sub UseItem:
  ClearMsg
  V = HasIt(Cur)
  if V = 0 then
    print at 2,18, "YOU DO NOT CARRY THE"
    PrintItem(23, 18, Cur)
    return
  end if
  if Cur = 0 then
    Lit = Lit ^ 1
    play sound SndLight
    if Lit = 1 then
      print at 2,18, "THE LANTERN IS LIT."
    else
      print at 2,18, "YOU PUT THE LANTERN OUT."
    end if
    SetLight
    ShowAll
    return
  end if
  if Cur = 1 then
    EquipIt
    return
  end if
  if Cur = 3 then
    EquipIt
    return
  end if
  if Cur = 5 then
    ' the elixir: 20 life, then it is gone
    Lf = Lf + 2000
    InvL = InvL & $DF
    play sound SndDrink
    print at 2,18, "YOU DRINK THE ELIXIR."
    print at 2,19, "NEW LIFE FLOWS INTO YOU."
    ShowHud
    return
  end if
  if Cur = 6 then
    MapLook
    return
  end if
  PrintItem(2, 18, Cur)
  if Cur = 2 then print at 2,19, "TURNS HALF OF EACH BLOW."
  if Cur = 4 then print at 2,19, "ADDS 2 TO YOUR BLOWS."
  if Cur = 7 then print at 2,19, "IS ONE OF THE TREASURES."
  if Cur = 8 then print at 2,19, "OF THE DEMIGORGON IS YOURS."
  return
end sub

' Strike(wand): a blow at the monster here
sub Strike(u8 Sw):
  if Mi = 255 then
    play sound SndMiss
    print at 2,18, "YOU STRIKE AT THE DARK."
    return
  end if
  V = Mt[Mi]
  play sound SndSlash
  SlashFx
  ' a miss: 50% minus your life (in whole points) %; the wand never misses
  ' the Demigorgon
  W = 1
  if Sw = 1 then
    if V = 8 then W = 0
  end if
  if W = 1 then
    W16 = Lf / 100
    R = CrRnd(100)
    if W16 < 50 then
      V1 = W16
      V2 = 50 - V1
      if R < V2 then
        PrintMon(2, 18, V)
        print at 14,18, "DODGES!"
        Riposte
        return
      end if
    end if
  end if
  ' the blow: RND + 2 + life / 6, +2 with the ring
  W16 = Lf / 600
  V1 = 2
  if W16 < 200 then V1 = W16 + 2
  R = CrRnd(2)
  V1 = V1 + R
  V2 = InvL & 16
  if V2 > 0 then V1 = V1 + 2
  play sound SndHit
  Dmg = V1
  HitFx
  V = Mt[Mi]
  N = Mh[Mi]
  if V1 >= N then
    Kill
    return
  end if
  N = N - V1
  Mh[Mi] = N
  print at 2,18, "YOU WOUND THE"
  PrintMon(16, 18, V)
  ShowFoe
  ' as in the listing, each of your turns gives the monster its chance
  Riposte
  return
end sub

' DoAct: the left button does what the moment asks: strike the monster
' here, take what lies here, open the gate ahead, else use the item framed
sub DoAct:
  GetAct
  if Act = 1 then
    Attack
  elseif Act = 2 then
    ClearMsg
    TakeAll
  elseif Act = 3 then
    play sound SndBump
    AtGate
  else
    UseItem
  end if
  ShowPrompt
  return
end sub

sub GetAct:
  Act = 4
  if Mi <> 255 then
    Act = 1
    return
  end if
  if Lv < 6 then
    V = RoomBits(Pc)
    if CrownC = Pc then V = 1
    if V <> 0 then
      Act = 2
      return
    end if
  end if
  X = Pc + DcT[Dir]
  V = MapData[X]
  if V = 2 then Act = 3
  return
end sub

' Attack: a blow with the weapon in hand (the other one when it is gone)
sub Attack:
  ClearMsg
  W = HasIt(Weap)
  if W = 0 then
    Weap = Weap ^ 2
    W = HasIt(Weap)
  end if
  if W = 0 then
    Weap = 1
    print at 2,18, "YOU HAVE NO WEAPON!"
    return
  end if
  ShowHud
  if Weap = 3 then
    Strike(1)
  else
    Strike(0)
  end if
  return
end sub

sub EquipIt:
  Weap = Cur
  play sound SndTick
  print at 2,18, "YOU TAKE THE"
  PrintItem(15, 18, Cur)
  print at 2,19, "IN HAND."
  ShowHud
  return
end sub

' ShowPrompt: the bottom line, what each button does now
sub ShowPrompt:
  if InMenu = 1 then
    Act = 4
  else
    GetAct
  end if
  fill 32 count 28 at 2,23
  print at 2,23, "LEFT:"
  if Act = 1 then print at 8,23, "ATTACK"
  if Act = 2 then print at 8,23, "TAKE"
  if Act = 3 then print at 8,23, "OPEN"
  if Act = 4 then
    V = HasIt(Cur)
    if V = 0 then
      print at 8,23, "-"
    elseif Cur = 0 then
      if Lit = 1 then
        print at 8,23, "DOUSE"
      else
        print at 8,23, "LIGHT"
      end if
    elseif Cur = 5 then
      print at 8,23, "DRINK"
    elseif Cur = 6 then
      print at 8,23, "READ"
    else
      V = Cur & 1
      if Cur = 7 then V = 0
      if V = 1 then
        print at 8,23, "EQUIP"
      else
        print at 8,23, "LOOK"
      end if
    end if
  end if
  print at 18,23, "RIGHT:"
  if InMenu = 1 then
    print at 25,23, "BACK"
  else
    print at 25,23, "ITEMS"
  end if
  return
end sub

' SlashFx: the blade's arc across the monster (8 frames)
sub SlashFx:
  Fx = 1
  for J = 0 to 7
    N = SSlash
    if J >= 3 then N = SSlash + 4
    if J >= 6 then N = SSlash + 8
    Y = 77 + Bob
    set sprite 3 to Y,64,N,15
    update sprites
    Frame1
  next
  set sprite 3 to 192,0,0,0
  update sprites
  Fx = 0
  return
end sub

' HitFx: the monster flinches (one soft flash) and the wound rises above it
sub HitFx:
  Fx = 2
  ' Dt tens, Du units (DrawSprites uses V and W)
  Dt = Dmg / 10
  Du = Dt * 10
  Du = Dmg - Du
  Sx = 56
  if Dt > 0 then Sx = 64
  for J = 0 to 19
    FlY = 0
    FlC = 0
    if J < 6 then FlY = 4
    if J < 3 then FlC = 1
    DrawSprites
    Y = J >> 1
    Y = 60 - Y
    if Dt > 0 then
      N = Dt << 2
      N = N + SDigT
      set sprite 4 to Y,Sx,N,11
    end if
    N = Du << 2
    N = N + SDigU
    set sprite 5 to Y,Sx,N,11
    update sprites
    Frame1
  next
  set sprite 4 to 192,0,0,0
  set sprite 5 to 192,0,0,0
  FlY = 0
  FlC = 0
  DrawSprites
  Fx = 0
  return
end sub

' HurtFx: a blow on you: the view shakes, the backdrop flushes red
sub HurtFx:
  Fx = 3
  backdrop dark red
  for J = 0 to 5
    Jolt = 2
    V = J & 1
    if V = 1 then Jolt = 0
    if MapOn = 0 then DrawSprites
    Frame1
  next
  Jolt = 0
  backdrop black
  if MapOn = 0 then DrawSprites
  Fx = 0
  return
end sub

' KillFx: the monster sinks and fades into the dark
sub KillFx:
  Fx = 4
  V = Mt[Mi]
  N = V - 1
  N = N << 4
  for J = 0 to 15
    Y = 79 + J
    W = MColD[V]
    V2 = MColB[V]
    if J >= 5 then
      W = 14
      V2 = 14
    end if
    if J >= 11 then
      W = 4
      V2 = 4
    end if
    set sprite 0 to Y,64,N,W
    V1 = N + 4
    set sprite 1 to Y,64,V1,V2
    update sprites
    Frame1
  next
  Fx = 0
  return
end sub

' Sparkle(item): the dropped item glints on the floor
sub Sparkle(u8 Sp):
  Fx = 5
  X = Sp << 3
  X = X + 28
  for J = 0 to 35
    N = SSpark
    W = 11
    Y = J / 12
    V1 = Y & 1
    if V1 = 1 then
      N = SSpark + 4
      W = 15
    end if
    set sprite 3 to 115,X,N,W
    update sprites
    Frame1
  next
  set sprite 3 to 192,0,0,0
  update sprites
  Fx = 0
  return
end sub

' Kill: the monster here dies and leaves the item of its number
sub Kill:
  KillFx
  V = Mt[Mi]
  Mc[Mi] = 255
  inc Slain
  W16 = V
  W16 = W16 * 100
  Gold = Gold + W16
  Lf = Lf + W16
  if V = 8 then
    CrownC = Pc
  else
    W = RoomBits(Pc)
    W = W | BitT[V]
    SetRoom(Pc, W)
  end if
  Mi = 255
  MiWas = 255
  play sound SndDie
  ClearMsg
  print at 2,18, "YOU SLAY THE"
  PrintMon(15, 18, V)
  print at 2,19, "IT LEAVES THE"
  PrintItem(16, 19, V)
  ShowAll
  if Lv < 6 then Sparkle(V)
  return
end sub

' ItemPanel: the right button; left/right move the frame, the left button
' uses (or takes in hand) the item framed, down drops it, the right
' button closes the pack
sub ItemPanel:
  InMenu = 1
  play sound SndTick
  ClearMsg
  print at 2,18, "PACK: LEFT/RIGHT TO CHOOSE,"
  print at 2,19, "DOWN: DROP IT."
  PanelItem
  ShowCursor
  ShowPrompt
  WasStk = 1
ip_loop:
  Idle = 1
  Frame1
  Animate
  ReadPad
  Timers
  if Lost = 1 then goto ip_end
  if P1 = 1 then
    InMenu = 0
    Idle = 0
    ShowCursor
    UseItem
    ShowPrompt
    return
  end if
  if P2 = 1 then goto ip_end
  if Stk = 0 then goto ip_loop
  if WasStk = 1 then goto ip_loop
  WasStk = 1
  Idle = 0
  if Lf1 = 1 then
    if Cur = 0 then
      Cur = 8
    else
      dec Cur
    end if
    play sound SndTick
  elseif Rt1 = 1 then
    inc Cur
    if Cur = 9 then Cur = 0
    play sound SndTick
  elseif Dn1 = 1 then
    DropIt
  end if
  PanelItem
  ShowCursor
  ShowPrompt
  goto ip_loop
ip_end:
  InMenu = 0
  Idle = 0
  ClearMsg
  ShowCursor
  ShowPrompt
  return
end sub

sub PanelItem:
  fill 32 count 28 at 2,21
  PrintItem(2, 21, Cur)
  V = HasIt(Cur)
  if V = 0 then print at 13,21, "(NOT CARRIED)"
  return
end sub

sub TakeAll:
  if Lv = 6 then
    print at 2,18, "IT IS TOO DARK TO SEE."
    return
  end if
  V = RoomBits(Pc)
  W = 0
  if CrownC = Pc then W = 1
  if V = 0 then
    if W = 0 then
      print at 2,18, "NOTHING LIES HERE."
      return
    end if
  end if
  InvL = InvL | V
  SetRoom(Pc, 0)
  if W = 1 then
    Crown = 1
    CrownC = 255
  end if
  play sound SndTake
  print at 2,18, "YOU TAKE WHAT LIES HERE."
  ShowAll
  return
end sub

sub DropIt:
  fill 32 count 28 at 2,20
  V = HasIt(Cur)
  if V = 0 then
    print at 2,20, "YOU DO NOT CARRY IT."
    return
  end if
  if Cur = 8 then
    if CrownC <> 255 then return
    Crown = 0
    CrownC = Pc
  else
    W = BitT[Cur]
    V = W ^ 255
    InvL = InvL & V
    V = RoomBits(Pc)
    V = V | W
    SetRoom(Pc, V)
  end if
  if Cur = 0 then Lit = 0
  play sound SndDrop
  print at 2,20, "DROPPED."
  SetLight
  ShowAll
  return
end sub

' HasIt(item): 1 when carried
function HasIt(u8 Hi8) as u8
  if Hi8 = 8 then return Crown
  Rb = InvL & BitT[Hi8]
  if Rb > 0 then return 1
  return 0

' the items lying in each cell: a byte a cell in VRAM at $3000
function RoomBits(u8 Rc) as u8
  A16 = Rc
  A16 = A16 + 12288
  vpeek vram.pattern + A16 into Rb
  return Rb

sub SetRoom(u8 Sc, u8 Sv):
  A16 = Sc
  A16 = A16 + 12288
  vpoke vram.pattern + A16, Sv
  return
end sub

' MapLook: the map item shows the whole crypt in the view, a mark for you
sub MapLook:
  play sound SndTick
  for J = 0 to 255
    V = MapData[J]
    if V = 1 then
      Vb[J] = TMapO
    else
      Vb[J] = TMapW
    end if
  next
  call asm CrBlit
  MapOn = 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  X = Pc & 15
  X = X << 3
  X = X + 16
  Y = Pc >> 4
  Y = Y << 3
  Y = Y + 7
  set sprite 3 to Y,X,SYou,11
  update sprites
  print at 2,18, "THE MAP OF THE CRYPT. THE"
  print at 2,19, "YELLOW MARK IS YOU."
  print at 2,20, "PRESS A BUTTON."
  WasStk = 1
ml_loop:
  Idle = 1
  Frame1
  Timers
  if Lost = 1 then goto ml_end
  ReadPad
  V = P1 | P2
  if V = 0 then goto ml_loop
ml_end:
  MapOn = 0
  Idle = 0
  set sprite 3 to 192,0,0,0
  LvShown = 255
  ClearMsg
  ShowAll
  return
end sub

' ---------------------------------------------------------------------------
' the monsters at the start: 16 on random open cells (never the gate's
' corridor), the princess in the deepest row; the amulet in cell 238

sub Placement:
  for K = 0 to 15
    Mc[K] = 255
  next
  for K = 0 to 15
    Mt[K] = MTypes[K]
    V = Mt[K]
    V = V << 3
    V = V + 1
    Mh[K] = V
pl_again:
    R = CrRnd(255)
    if K = 14 then
      R = R | 224
    end if
    if MapData[R] <> 1 then goto pl_again
    if R < 51 then goto pl_again
    V = MonAt(R)
    if V <> 255 then goto pl_again
    Mc[K] = R
  next
  for J = 0 to 255
    SetRoom(J, 0)
  next
  SetRoom(238, 128)
  Mi = 255
  MiWas = 255
  return
end sub

' CrRnd(n): 0 to n-1 from the high byte of (random byte) x n
function CrRnd(u8 Rn) as u8
  call asm CrXor
  Rb = Rs
  W16 = Rb * Rn
  W16 = W16 >> 8
  Rb = W16
  return Rb

' ---------------------------------------------------------------------------
' the 3-D view: 16 x 16 tiles at columns 2-17, rows 1-16, built in Vb.
' Depth k (0-2) is the cell k ahead: its side walls fill columns 2k-2k+1
' (left) and 14-2k-15-2k (right), rows 2k-15-2k; a wall in the cell k+1
' ahead fills the middle; three open cells end in darkness.

sub DrawView:
  ' the ceiling and the floor in bands, darker toward the middle
  for J = 0 to 255
    V = J >> 4
    if V < 8 then
      V = V >> 1
      W = V + TCeil
    else
      V = 15 - V
      V = V >> 1
      W = V + TFloor
    end if
    Vb[J] = W
  next
  ' the lantern lights three depths, two when low, one when nearly out
  Lim = 3
  if Lv >= 3 then Lim = 2
  if Lv >= 5 then Lim = 1
  C = Pc
  Ms = 255
  for K = 0 to 2
    if K >= Lim then goto view_far
    V = Dir + 3
    V = V & 3
    X = C + DcT[V]
    V = MapData[X]
    SideL(V)
    V = Dir + 1
    V = V & 3
    X = C + DcT[V]
    V = MapData[X]
    SideR(V)
    C = C + DcT[Dir]
    V = MapData[C]
    if V = 0 then
      Front(K, 0)
      goto view_done
    end if
    if V = 2 then
      Front(K, 1)
      goto view_done
    end if
    if K = 0 then Ms = MonAt(C)
  next
view_far:
  N = Lim << 1
  V1 = 15 - N
  Rect(N, N, V1, V1, TFar)
view_done:
  ' what lies on the floor here
  if Lv < 6 then
    V = RoomBits(Pc)
    for J = 0 to 7
      W = V & BitT[J]
      if W > 0 then
        N = 243 + J
        Vb[N] = TObjF + J
      end if
    next
    if CrownC = Pc then Vb[251] = TObjF + 8
  end if
  call asm CrBlit
  return
end sub

sub Rect(u8 C0, u8 R0, u8 C1, u8 R1, u8 Rt):
  for Rj = R0 to R1
    Rb = Rj << 4
    Rb = Rb + C0
    for Ri = C0 to C1
      Vb[Rb] = Rt
      inc Rb
    next
  next
  return
end sub

' SideL(kind): the left side of depth K: a wall (or the gate), or an
' opening (the far wall of the side passage)
sub SideL(u8 Sk):
  N = K << 1
  if Sk = 0 then
    W = 0
  elseif Sk = 2 then
    W = 1
  else
    W = K << 1
    W = W + TFront
    V1 = N + 2
    V2 = 13 - N
    V = N + 1
    Rect(N, V1, V, V2, W)
    return
  end if
  W = W + N
  W = W * 6
  W = W + TSide
  V = N << 4
  V = V + N
  V1 = W + 1
  Vb[V] = V1
  V = V + 16
  Vb[V] = W
  inc V
  Vb[V] = V1
  V1 = N + 2
  V2 = 13 - N
  V = N + 1
  Rect(N, V1, V, V2, W)
  V = 14 - N
  V = V << 4
  V = V + N
  Vb[V] = W
  V2 = W + 2
  inc V
  Vb[V] = V2
  V = V + 15
  Vb[V] = V2
  ' a torch or a cobweb on some stone walls (by the cell)
  if Sk = 0 then
    if K < 2 then
      V = X & 7
      if V = 3 then
        V = 97 + N
        V1 = K << 1
        V1 = V1 + TSconce
        Vb[V] = V1
      end if
      if K = 0 then
        if V = 6 then Vb[0] = TWeb
      end if
    end if
  end if
  return
end sub

sub SideR(u8 Sk):
  N = K << 1
  Ca = 15 - N
  if Sk = 0 then
    W = 0
  elseif Sk = 2 then
    W = 1
  else
    W = K << 1
    W = W + TFront
    V1 = N + 2
    V2 = 13 - N
    V = Ca - 1
    Rect(V, V1, Ca, V2, W)
    return
  end if
  W = W + N
  W = W * 6
  W = W + TSide
  W = W + 3
  V = N << 4
  V = V + Ca
  V1 = W + 1
  Vb[V] = V1
  V = V + 16
  Vb[V] = W
  dec V
  Vb[V] = V1
  V1 = N + 2
  V2 = 13 - N
  V = Ca - 1
  Rect(V, V1, Ca, V2, W)
  V = 14 - N
  V = V << 4
  V = V + Ca
  Vb[V] = W
  V2 = W + 2
  dec V
  Vb[V] = V2
  V = V + 17
  Vb[V] = V2
  if Sk = 0 then
    if K < 2 then
      V = X & 7
      if V = 3 then
        V = 95 + Ca
        V1 = K << 1
        V1 = V1 + TSconce
        inc V1
        Vb[V] = V1
      end if
      if K = 0 then
        if V = 6 then Vb[15] = TWeb + 1
      end if
    end if
  end if
  return
end sub

' Front(depth, gate): the wall closing the corridor after depth k
sub Front(u8 Fk, u8 Fd):
  N = Fk << 1
  W = N + TFront
  W = W + Fd
  V1 = N + 2
  V2 = 13 - N
  Rect(V1, V1, V2, V2, W)
  ' moss at the foot of some stone walls
  if Fd = 0 then
    V = C & 3
    if V = 1 then
      V = 13 - N
      V = V << 4
      V = V + 7
      W = Fk + TMoss
      Vb[V] = W
      inc V
      Vb[V] = W
    end if
  end if
  return
end sub

' SetLight: the view's colours for the light (lantern out: black)
sub SetLight:
  Lv = 6
  if Lit = 1 then Lv = Dd
  if Lv = LvShown then return
  LvShown = Lv
  A16 = Lv
  A16 = A16 * 512
  copy ViewCol + A16 count 512 to vram.color + 1024
  return
end sub

' ShowAll: the light, the view, the monsters and the panel
sub ShowAll:
  SetLight
  DrawView
  DrawSprites
  ShowHud
  return
end sub

' DrawSprites: the monster here (big, two colours) or one cell ahead
' (small); none in the dark
sub DrawSprites:
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  if Lv = 6 then goto ds_cur
  if Mi <> 255 then
    V = Mt[Mi]
    N = V - 1
    N = N << 4
    ' knocked back (up and away) by a wound, shaken when it strikes you
    Y = 79 + Bob
    Y = Y + Jolt
    Y = Y - FlY
    X = 64 + FlY
    W = MColD[V]
    V2 = MColB[V]
    if Blink = 1 then W = V2
    if FlC = 1 then
      W = 9
      V2 = 9
    end if
    set sprite 0 to Y,X,N,W
    N = N + 4
    set sprite 1 to Y,X,N,V2
  elseif Ms <> 255 then
    V = Mt[Ms]
    N = V - 1
    N = N << 4
    N = N + 8
    Y = 47 + Bob
    set sprite 0 to Y,64,N,MColD[V]
    N = N + 4
    set sprite 1 to Y,64,N,MColB[V]
  end if
ds_cur:
  ShowCursor
  return
end sub

' ShowCursor: the frame round the item chosen (white in the panel)
sub ShowCursor:
  Y = Cur / 3
  W = Y * 3
  V = Cur - W
  Y = Y << 4
  X = V * 24
  X = X + 156
  Y = Y + 99
  V = 10
  if InMenu = 1 then V = 15
  set sprite 2 to Y,X,SCursor,V
  update sprites
  return
end sub

' ShowFoe: the monster here and its hit points
sub ShowFoe:
  fill 32 count 28 at 2,22
  if Mi = 255 then return
  V = Mt[Mi]
  PrintMon(2, 22, V)
  print at 14,22, "WOUNDS LEFT"
  NumU = Mh[Mi]
  print at 26,22, digits$(NumU, 2)
  return
end sub

sub ShowHud:
  ' life: a bar of 10 (5 points a block) and the number
  W16 = Lf / 100
  NumU = W16
  print at 25,3, digits$(NumU, 3)
  for J = 0 to 9
    V = J * 5
    V = V + 5
    W = TLifeF + 2
    if W16 >= V then
      W = TLifeF
    else
      V = V - 3
      if W16 >= V then W = TLifeF + 1
    end if
    X = J + 19
    put char W at X,4
  next
  ' oil: 6 blocks
  for J = 0 to 5
    W = TOilF + 2
    V = 6 - Dd
    if J < V then W = TOilF
    X = J + 19
    put char W at X,7
  next
  if Lit = 1 then
    print at 26,7, "LIT  "
  else
    print at 26,7, "DARK "
  end if
  NumU = Gold
  print at 25,9, digits$(NumU, 5)
  V = DirCh[Dir]
  put char V at 24,11
  ' the weapon in hand
  W = HasIt(Weap)
  if W = 1 then
    W = TObjP + Weap
  else
    W = TFrame
  end if
  put char W at 30,11
  if Saved = 1 then
    print at 19,19, "PRINCESS"
  end if
  ' the items carried
  for J = 0 to 8
    Y = J / 3
    W = Y * 3
    V = J - W
    Y = Y << 1
    Y = Y + 13
    X = V * 3
    X = X + 20
    W = HasIt(J)
    if W = 1 then
      W = TObjP + J
    else
      W = TFrame
    end if
    put char W at X,Y
  next
  ShowFoe
  ShowPrompt
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  return
end sub

sub PrintItem(u8 Ix, u8 Iy, u8 It):
  if It = 0 then print at Ix,Iy, "LANTERN"
  if It = 1 then print at Ix,Iy, "SWORD"
  if It = 2 then print at Ix,Iy, "SHIELD"
  if It = 3 then print at Ix,Iy, "WAND"
  if It = 4 then print at Ix,Iy, "RING"
  if It = 5 then print at Ix,Iy, "ELIXIR"
  if It = 6 then print at Ix,Iy, "MAP"
  if It = 7 then print at Ix,Iy, "AMULET"
  if It = 8 then print at Ix,Iy, "CROWN"
  return
end sub

sub PrintMon(u8 Qx, u8 Qy, u8 Qt):
  if Qt = 1 then print at Qx,Qy, "SPIDER"
  if Qt = 2 then print at Qx,Qy, "COBRA"
  if Qt = 3 then print at Qx,Qy, "IMP"
  if Qt = 4 then print at Qx,Qy, "BLOB"
  if Qt = 5 then print at Qx,Qy, "KNIGHT"
  if Qt = 6 then print at Qx,Qy, "WRAITH"
  if Qt = 7 then print at Qx,Qy, "PRINCESS"
  if Qt = 8 then print at Qx,Qy, "DEMIGORGON"
  return
end sub

' Animate: a drop of water down the ceiling (one picture each 20 frames),
' the monster breathing (up and down each 16 frames)
sub Animate:
  V = Tick & 15
  if V = 0 then
    Bob = Bob ^ 1
    ' now and then the monster blinks
    Blink = 0
    V = Tick & 127
    if V = 64 then Blink = 1
    if Lv < 6 then
      V = Mi & Ms
      if V <> 255 then DrawSprites
    end if
  end if
  V = Tick & 31
  if V = 8 then
    inc DripN
    if DripN = 3 then DripN = 0
    A16 = DripN
    A16 = A16 << 3
    copy DripPat + A16 count 8 to vram.pattern + 1024
    copy DripPat + A16 count 8 to vram.pattern + 3072
    copy DripPat + A16 count 8 to vram.pattern + 5120
    if DripN = 2 then
      inc DripS
      V = DripS & 3
      if V = 1 then play sound SndDrip
    end if
  end if
  ' the torches flicker (a new flame each 32 frames)
  V = Tick & 31
  if V = 24 then
    Flm = Flm ^ 1
    A16 = Flm
    A16 = A16 << 5
    copy FlamePat + A16 count 32 to vram.pattern + 1432
    copy FlamePat + A16 count 32 to vram.pattern + 3480
    copy FlamePat + A16 count 32 to vram.pattern + 5528
  end if
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub GameScreen:
  NewScreen
  backdrop black
  print at 19,1, "CRYPT OF FEAR"
  print at 19,3, "LIFE"
  print at 19,6, "OIL"
  print at 19,9, "GOLD"
  print at 19,11, "FACE"
  print at 26,11, "ARM"
  Placement
  ShowScreen
  return
end sub

sub EndPage:
  if Gold > Hi then Hi = Gold
  NewScreen
  backdrop black
  if Won = 1 then
    print at 5,3, "THE GATE SWINGS OPEN!"
    print at 2,5, "BRAVE KNIGHT, YOU HAVE"
    print at 2,6, "CONQUERED THE CRYPT. MY HERO!"
  elseif Why = 2 then
    print at 4,3, "YOUR LANTERN FUEL HAS"
    print at 4,4, "EXPIRED!"
    print at 2,6, "THE DARK OF THE CRYPT TAKES"
    print at 2,7, "YOU FOREVER."
  else
    print at 11,3, "SLAIN!!"
    print at 2,5, "THE MONSTERS OF THE CRYPT"
    print at 2,6, "HAVE WON THIS NIGHT."
  end if
  print at 4,14, "MONSTERS SLAIN"
  NumU = Slain
  print at 21,14, digits$(NumU, 2)
  print at 4,15, "GOLD"
  NumU = Gold
  print at 18,15, digits$(NumU, 5)
  print at 4,16, "BEST"
  NumU = Hi
  print at 18,16, digits$(NumU, 5)
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  update sprites
  if Won = 1 then WinWalk
  nmi on
  wait no fire
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' WinWalk: the knight and the princess walk to each other in the
' moonlight; a heart rises over them
sub WinWalk:
  for J = 0 to 47
    X = J + 40
    set sprite 2 to 72,X,SHero,15
    X = 168 - J
    set sprite 0 to 72,X,96,MColD[7]
    set sprite 1 to 72,X,100,MColB[7]
    update sprites
    Frame1
    Frame1
  next
  for J = 0 to 23
    Y = J >> 1
    Y = 52 - Y
    set sprite 3 to Y,104,SHeart,8
    update sprites
    Frame1
    Frame1
  next
  return
end sub

' title: the tune once, START / CREDITS; the time spent here seeds the
' random numbers
sub TitlePage:
  NewScreen
  backdrop black
  print at 9,2, "CRYPT OF FEAR"
  print at 3,4, "BY CLEVELAND M. BLAKEMORE"
  set sprite 0 to 44,64,112,MColD[8]
  set sprite 1 to 44,64,116,MColB[8]
  set sprite 2 to 44,160,96,MColD[7]
  set sprite 3 to 44,160,100,MColB[7]
  print at 2,10, "SAVE THE PRINCESS FROM THE"
  print at 2,11, "MONSTERS BELOW THE CHAPEL."
  print at 12,15, "START"
  print at 12,16, "CREDITS"
  print at 10,20, "BEST"
  NumU = Hi
  print at 15,20, digits$(NumU, 5)
  ShowMenu
  ShowScreen
  update sprites
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
  WasStk = 1
  W16 = 0
tp_loop:
  Frame1
  inc W16
  ReadPad
  if Stk = 0 then WasStk = 0
  if Stk = 1 then
    if WasStk = 0 then
      WasStk = 1
      Menu = Menu ^ 1
      play sound SndTick
      ShowMenu
    end if
  end if
  if P1 = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Seed = W16 * 251
  Seed = Seed ^ $5A3C
  if Seed = 0 then Seed = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,15
  put char 32 at 10,16
  V = Menu + 15
  put char 62 at 10,V
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop black
  print at 9,2, "CRYPT OF FEAR"
  print at 2,5, "BASED ON CRYPT OF FEAR BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! FEBRUARY 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: BELOW THE CHAPEL,"
  print at 2,18, "COLD STONES"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  nmi on
  wait no fire
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  B1 = 0
  B2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  V = joypad(1).button1 | joypad(2).button1
  if V = 1 then B1 = 1
  V = joypad(1).button2 | joypad(2).button2
  if V = 1 then B2 = 1
  P1 = 0
  if B1 = 1 then
    if WasB1 = 0 then P1 = 1
  end if
  WasB1 = B1
  P2 = 0
  if B2 = 1 then
    if WasB2 = 0 then P2 = 1
  end if
  WasB2 = B2
  Stk = Up1 | Dn1
  Stk = Stk | Lf1
  Stk = Stk | Rt1
  if Stk = 0 then
    WasStk = 0
    Rep = 0
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Busy = 1
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  LvShown = 255
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Busy = 0
  return
end sub

