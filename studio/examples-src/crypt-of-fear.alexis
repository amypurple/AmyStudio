asm {
; CrXor: 16-bit xorshift (7, 9, 8) on Rs
CrXor:
  ld hl,(AMY_UVAR_Rs)
  ld a,h
  rra
  ld a,l
  rra
  xor h
  ld h,a
  ld a,l
  rra
  ld a,h
  rra
  xor l
  ld l,a
  xor h
  ld h,a
  ld (AMY_UVAR_Rs),hl
  ret

; CrBlit: the 16 x 16 view buffer Vb to the name table, columns 2-17 of
; rows 1-16 (called with the NMI off)
CrBlit:
  ld hl,AMY_UVAR_Vb
  ld de,$5822
  ld c,16
CrBlitRow:
  ld a,e
  out ($BF),a
  ld a,d
  out ($BF),a
  ld b,16
CrBlitCol:
  ld a,(hl)
  out ($BE),a
  inc hl
  djnz CrBlitCol
  ld a,e
  add a,32
  ld e,a
  jr nc,CrBlitNc
  inc d
CrBlitNc:
  dec c
  jr nz,CrBlitRow
  ret
