' FP5 random lab: inspect raw 5-byte random values in 0.0 .. <1.0.
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
u8 BA[5] = 0
u8 BB[5] = 0
u8 BC[5] = 0
u8 BD[5] = 0

  text screen
  print at 8,0, "FP5 RANDOM LAB"
  print at 1,1, "RAW BYTES      B4  B3  B2  B1  B0"

  A = random()
  B = random()
  C = random()
  D = random()

  copy bytes of A to BA
  copy bytes of B to BB
  copy bytes of C to BC
  copy bytes of D to BD

  print at 1,4,  "RND A"
  print BA[4] at 11,4 digits 3
  print BA[3] at 15,4 digits 3
  print BA[2] at 19,4 digits 3
  print BA[1] at 23,4 digits 3
  print BA[0] at 27,4 digits 3

  print at 1,6,  "RND B"
  print BB[4] at 11,6 digits 3
  print BB[3] at 15,6 digits 3
  print BB[2] at 19,6 digits 3
  print BB[1] at 23,6 digits 3
  print BB[0] at 27,6 digits 3

  print at 1,8,  "RND C"
  print BC[4] at 11,8 digits 3
  print BC[3] at 15,8 digits 3
  print BC[2] at 19,8 digits 3
  print BC[1] at 23,8 digits 3
  print BC[0] at 27,8 digits 3

  print at 1,10, "RND D"
  print BD[4] at 11,10 digits 3
  print BD[3] at 15,10 digits 3
  print BD[2] at 19,10 digits 3
  print BD[1] at 23,10 digits 3
  print BD[0] at 27,10 digits 3

  print at 1,13, "EXPECT"
  print at 1,14, "B4 near 112..127, not all same"
  print at 1,15, "SIGN BYTE B3 under 128"
  print at 1,16, "VALUE RANGE 0.0 .. <1.0"
  screen on