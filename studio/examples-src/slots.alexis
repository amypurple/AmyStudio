' the computer's tables (orig/ml.dis $3072-$3088)
' line steps along the board (row * 9 + slot): -1 +1, +8 -8, +10 -10, -9
data DirT bytes 255,1,8,248,10,246,247
' scores for the 1st, 2nd, 3rd enemy neighbour (block) and own neighbour
data TabA bytes 0,2,8,36
data TabB bytes 0,1,2,16
' the piece played at look-ahead depth 0-3 and the other side's
data PV bytes 255,1,255,1
data OP bytes 1,255,1,255

