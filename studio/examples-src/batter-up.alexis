  tile screen
  set sound table BuSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 5
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title
  Players = Menu + 1

  NewGame
  LineupPage
  StartPlay
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the scoreboard, then back to the title on a press
  InPlay = 0
  Rearm
  wait 60 frames
  nmi off
  mute all
  TzOn = 0
  play sound SndOver
  GameOverPage
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' one pass of play (a frame). Ph: 0 batter up, 1 wind-up, 2 the pitch,
' 3 the result shown, 4 the computer's half inning
sub PlayStep:
  select case Ph
  case 0
    dec PhT
    if PhT = 0 then StartPitch
  case 1
    dec PhT
    if PhT = Wind2 then PPose = 1
    if PhT = 0 then
      PPose = 2
      Ph = 2
      PT = 0
      BallOn = 1
      MoveBall
    end if
  case 2
    PitchStep
  case 3
    if Hit > 0 then FlyStep
    dec PhT
    if PhT = 0 then AfterPlay
  case else
    dec PhT
    if PhT = 70 then
      ShowCpu
    end if
    if PhT = 0 then
      HalfDone
    end if
  end select
  return
end sub

' a new pitch: which (Z) and how fast (Spd), from the shared random numbers
sub StartPitch:
  inc PNo
  Rand
  Z = (Rs & 7) + 1
  Rand
  V = Rs & 255
  Spd = V % 3
  Fl = FlT[Spd]
  Ph = 1
  PhT = Wind1 + Wind2
  PPose = 0
  SwT = 255
  Pose = 0
  Hit = 0
  BallOn = 0
  return
end sub

' the ball on its way: a swing is taken once; the result is decided when
' the ball reaches the plate or at a late swing, else the ball reaches the
' catcher's mitt
sub PitchStep:
  u8 Df = 0
  if Swing = 1 then
    if SwT = 255 then
      SwT = PT
      Pose = 1
      PhT = 0
    end if
  end if
  ' the swing's poses: contact for 5 frames, then the follow-through
  if Pose = 1 then
    inc PhT
    if PhT >= 5 then Pose = 2
  end if
  if SwT <> 255 then
    if PT >= Fl then
      if PT >= SwT then
        Df = Dist(SwT, Fl)
        if IsStrike() = 1 then
          if Df <= 8 then
            Contact(Df)
            exit sub
          end if
        end if
      end if
    end if
  end if
  inc PT
  if PT > Fl + LateN then
    ' in the mitt
    if SwT <> 255 then
      Res = 9
      play sound SndSwish
    elseif IsStrike() = 1 then
      Res = 8
      play sound SndMitt
    else
      Res = 10
      play sound SndMitt
    end if
    Settle
    exit sub
  end if
  MoveBall
  return
end sub

function IsStrike() as u8
  return Z & 1

function Dist(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

' the bat meets a strike: Df frames from the perfect moment
sub Contact(u8 Df):
  u16 Pen = 0
  if Df > 5 then
    Res = 5
  else
    Rand
    V = Rs & 255
    Ix = Bat - 1
    Ix = Ix * 9
    if Bat = 1 then Ix = Ix + T1.Up else Ix = Ix + T2.Up
    Av = Avg[Ix]
    E = V * 100 / 256 + Av / 10
    ' each frame off the perfect moment costs .080 on the hit roll
    Pen = Df * 8
    if E > Pen then E = E - Pen else E = 0
    Res = HitKind(E)
  end if
  play sound SndCrack
  ' the hit ball's flight
  Hit = Res
  if Res > 7 then Hit = 0
  Hx = Bx
  Hy = By
  HitN = HnT[Res]
  K = Tick & 3
  select case Res
  case 5
    if K < 2 then Hvx = -4 else Hvx = 4
  case 1
    Hvx = 0
  case else
    Hvx = K
    Hvx = Hvx - 1
    if Bx > 140 then Hvx = 2
  end select
  Settle
  return
end sub

' the listing's table: E against 1.1, .9, .8, .6, .5, .3 (in hundredths)
function HitKind(u16 Ev) as u8
  if Ev > 110 then return 1
  if Ev > 90 then return 2
  if Ev > 80 then return 3
  if Ev > 60 then return 4
  if Ev > 50 then return 5
  if Ev > 30 then return 6
  return 7

' the result of the pitch: counts, runners, runs, outs; Res: 1 home run,
' 2 triple, 3 double, 4 single, 5 foul, 6 ground out, 7 fly out, 8 called
' strike, 9 swinging strike, 10 ball (11 walk, 12 strike out: shown only)
sub Settle:
  Runs = 0
  LastSw = SwT
  select case Res
  case 1 to 4
    Runs = Advance(5 - Res)
    NextBatter
  case 5
    if St < 2 then inc St
  case 6, 7
    inc Ot
    NextBatter
  case 8, 9
    inc St
    if St = 3 then
      Res = 12
      inc Ot
      NextBatter
    end if
  case else
    inc Bl
    if Bl = 4 then
      Res = 11
      Runs = Walk()
      NextBatter
    end if
  end select
  AddRuns(Runs)
  Ph = 3
  PhT = AfterN
  if Hit = 0 then BallOn = 0
  ShowResult
  ShowStatus
  return
end sub

' every runner and the batter move up N bases (4: a home run); the runs in
function Advance(u8 N) as u8
  u8 Nw = 0
  u8 Sc = 0
  u8 Bi = 0
  Nw = Rn << N
  Bi = 1 << (N - 1)
  Sc = 0
  Nw = Nw | Bi
  for Bi = 3 to 6
    if Nw & (1 << Bi) then inc Sc
  next
  Rn = Nw & 7
  return Sc

' four balls: runners move up only when forced
function Walk() as u8
  select case Rn
  case 0, 2, 4, 6
    Rn = Rn | 1
  case 1, 5
    Rn = Rn | 3
  case 3
    Rn = 7
  case else
    return 1
  end select
  return 0

sub AddRuns(u8 N):
  u8 Ai = 0
  if N = 0 then return
  if Bat = 1 then Shown = T1.Runs else Shown = T2.Runs
  for Ai = 1 to N
    inc Shown
  next
  if Bat = 1 then T1.Runs = Shown else T2.Runs = Shown
  return
end sub

sub NextBatter:
  Bl = 0
  St = 0
  if Bat = 1 then
    inc T1.Up
    if T1.Up = 9 then T1.Up = 0
  else
    inc T2.Up
    if T2.Up = 9 then T2.Up = 0
  end if
  return
end sub

' after the result: the next batter, or the half inning is over
sub AfterPlay:
  Hit = 0
  BallOn = 0
  Pose = 0
  PPose = 0
  ClearMsg
  if Ot < 3 then
    BatterUp
    exit sub
  end if
  ' three out
  Ot = 0
  Bl = 0
  St = 0
  Rn = 0
  if Players = 1 then
    ' the computer's half inning
    Ph = 4
    PhT = CpuN
    Bat = 2
    Half = 1
    ShowStatus
    fill 32 count 28 at 2,3
    print at 2,3, "BLUES BATTING (COMPUTER)"
    print at 2,22, "THE BLUES ARE AT BAT..."
    exit sub
  end if
  HalfDone
  return
end sub

' the computer's runs (the listing's INT(4*RND))
sub ShowCpu:
  Rand
  CpuRuns = Rs & 3
  AddRuns(CpuRuns)
  ClearMsg
  print at 2,22, "THE BLUES SCORE"
  print CpuRuns at 18,22 digits 1
  if CpuRuns = 1 then print at 20,22, "RUN" else print at 20,22, "RUNS"
  if CpuRuns > 0 then play sound SndCpu else play sound SndOut
  ShowStatus
  return
end sub

' one half inning is over: the other team bats, or the next inning, or
' the end of the game
sub HalfDone:
  ClearMsg
  Rn = 0
  if Half = 0 then
    Half = 1
    Bat = 2
    ' the home team needs no bottom of the ninth when ahead
    if Inn = 9 then
      if T2.Runs > T1.Runs then
        Over = 1
        exit sub
      end if
    end if
  else
    Half = 0
    Bat = 1
    inc Inn
    if Inn = 10 then
      Over = 1
      exit sub
    end if
  end if
  ShowStatus
  BatterUp
  return
end sub

' the next batter steps up
sub BatterUp:
  Ph = 0
  PhT = ReadyN
  Pose = 0
  PPose = 0
  ShowBatter
  play sound SndChime
  return
end sub

' the ball between the hand and the plate: straight line, growing
sub MoveBall:
  Ix = Z
  Dx = TgX[Ix]
  Dx = Dx - RelX
  Bxi = Dx * PT / Fl
  Bxi = Bxi + RelX
  Dx = TgY[Ix]
  Dx = Dx - RelY
  Byi = Dx * PT / Fl
  Byi = Byi + RelY
  Bx = Bxi
  By = Byi
  BSize = PT * 3 / Fl
  if BSize > 2 then BSize = 2
  return
end sub

' the hit ball flies off (out of the park for a home run)
sub FlyStep:
  if HitN = 0 then
    BallOn = 0
    exit sub
  end if
  dec HitN
  Hx = Hx + Hvx
  W16 = HvY[Hit]
  Hy = Hy - W16
  if Hy < 34 then
    BallOn = 0
    HitN = 0
    exit sub
  end if
  if Hx < 4 then
    BallOn = 0
    HitN = 0
    exit sub
  end if
  if Hx > 240 then
    BallOn = 0
    HitN = 0
    exit sub
  end if
  Bx = Hx
  By = Hy
  BSize = 1
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub ClearMsg:
  fill 32 count 28 at 2,22
  return
end sub

sub ShowResult:
  ClearMsg
  select case Res
  case 1
    if Runs = 4 then
      print at 2,22, "GRAND SLAM!"
    else
      print at 2,22, "HOME RUN!"
    end if
    play sound SndCheer
  case 2
    print at 2,22, "TRIPLE!"
  case 3
    print at 2,22, "DOUBLE!"
  case 4
    print at 2,22, "SINGLE!"
  case 5
    print at 2,22, "FOUL BALL"
  case 6
    print at 2,22, "GROUND OUT"
    play sound SndOut
  case 7
    print at 2,22, "FLY OUT"
    play sound SndOut
  case 8
    print at 2,22, "STRIKE!"
  case 9
    print at 2,22, "STRIKE! SWING AND A MISS"
  case 10
    print at 2,22, "BALL"
  case 11
    print at 2,22, "BALL FOUR: A WALK"
  case 12
    print at 2,22, "STRIKE THREE: YOU'RE OUT"
    play sound SndOut
  end select
  if Runs > 0 then
    print at 22,22, "+"
    print Runs at 23,22 digits 1
    print at 25,22, "RUN"
    if Res <> 1 then play sound SndScore
  end if
  return
end sub

' the scoreboard: the two teams, the count, the inning
sub ShowStatus:
  print at 2,1, "GREENS"
  print T1.Runs at 9,1
  print at 2,2, "BLUES"
  print T2.Runs at 9,2
  print at 13,1, "B"
  print Bl at 15,1 digits 1
  print at 17,1, "S"
  print St at 19,1 digits 1
  print at 21,1, "OUT"
  print Ot at 25,1 digits 1
  print at 13,2, "INNING"
  print Inn at 20,2 digits 1
  if Half = 0 then print at 22,2, "TOP" else print at 22,2, "BOT"
  return
end sub

sub ShowBatter:
  fill 32 count 28 at 2,3
  if Bat = 1 then
    print at 2,3, "GREENS"
    Li = T1.Up
    Ix = T1.Up
  else
    print at 2,3, "BLUES"
    Li = T2.Up + 9
    Ix = Li
  end if
  print at 9,3, "BATTING:"
  Off = Li * 6
  put Names + Off count 6 at 18,3
  Av = Avg[Ix]
  print at 25,3, "."
  print Av at 26,3 digits 3
  return
end sub

' the ball park, rows 4 to 21 from the name map
sub DrawField:
  Off = 0
  for Ri = 4 to 21
    put FieldMap + Off count 32 at 0,Ri
    Off = Off + 32
  next
  fill TPanel count 32 at 0,0
  fill TPanel count 32 at 0,1
  fill TPanel count 32 at 0,2
  fill TRule count 32 at 0,3
  return
end sub

' sprites: 0 the ball, 1-3 the batter's top (uniform, black, skin), 4-5 his
' legs, 6 the catcher, 7 the pitcher, 8-10 runners on 1st, 2nd, 3rd
sub DrawSprites:
  u8 Uc = 0
  u8 Oc = 0
  if Bat = 1 then
    Uc = GreenC
    Oc = BlueC
  else
    Uc = BlueC
    Oc = GreenC
  end if
  if BallOn = 1 then
    set sprite 0 to By - 8,Bx - 7,SBall0 + (BSize << 2),15
  else
    set sprite 0 to 192,0,0,0
  end if
  if Ph = 4 then
    for Ci = 1 to 10
      set sprite Ci to 192,0,0,0
    next
    update sprites
    exit sub
  end if
  K = Pose * 12
  set sprite 1 to 139,106,SBatw0 + K,Uc
  set sprite 2 to 139,106,SBatk0 + K,1
  set sprite 3 to 139,106,SBatp0 + K,9
  set sprite 4 to 155,106,SLegw,Uc
  set sprite 5 to 155,106,SLegk,1
  set sprite 6 to 153,120,SCatch,14
  set sprite 7 to 107,120,SPitch0 + (PPose << 2),Oc
  if Rn & 1 then
    set sprite 8 to 109,193,SRunner,Uc
  else
    set sprite 8 to 192,0,0,0
  end if
  if Rn & 2 then
    set sprite 9 to 73,121,SRunner,Uc
  else
    set sprite 9 to 192,0,0,0
  end if
  if Rn & 4 then
    set sprite 10 to 109,49,SRunner,Uc
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NewGame:
  T1.Runs = 0
  T2.Runs = 0
  T1.Up = 0
  T2.Up = 0
  T1.Col = GreenC
  T2.Col = BlueC
  Inn = 1
  Half = 0
  Bat = 1
  Bl = 0
  St = 0
  Ot = 0
  Rn = 0
  Over = 0
  PNo = 0
  Hit = 0
  BallOn = 0
  ' the averages, 100 to 399 (the listing's INT(300*RND+100))
  for Li = 0 to 17
    Rand
    W16 = Rs % 300
    Avg[Li] = W16 + 100
  next
  return
end sub

sub StartPlay:
  NewScreen
  DrawField
  ShowStatus
  BatterUp
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  InPlay = 1
  Page = 3
  return
end sub

' the lineups and batting averages (the listing printed them)
sub LineupPage:
  NewScreen
  print at 4,2, "LINEUPS AND AVERAGES"
  print at 4,5, "GREENS"
  print at 17,5, "BLUES"
  for Li = 0 to 8
    Off = Li * 6
    put Names + Off count 6 at 3,Li + 7
    Av = Avg[Li]
    print at 9,Li + 7, "."
    print Av at 10,Li + 7 digits 3
    Off = Off + 54
    put Names + Off count 6 at 16,Li + 7
    Ix = Li + 9
    Av = Avg[Ix]
    print at 22,Li + 7, "."
    print Av at 23,Li + 7 digits 3
  next
  if Players = 1 then
    print at 3,18, "YOU BAT FOR THE GREENS;"
    print at 3,19, "THE COMPUTER PITCHES."
  else
    print at 3,18, "CONTROLLER 1: GREENS"
    print at 3,19, "CONTROLLER 2: BLUES"
  end if
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Page = 5
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub GameOverPage:
  NewScreen
  print at 10,4, "SCOREBOARD"
  print at 9,8, "GREENS"
  print T1.Runs at 19,8
  print at 9,10, "BLUES"
  print T2.Runs at 19,10
  if T1.Runs > T2.Runs then
    print at 8,14, "THE GREENS WIN!"
  elseif T2.Runs > T1.Runs then
    print at 8,14, "THE BLUES WIN!"
  else
    print at 10,14, "A TIE GAME"
  end if
  print at 7,20, "PRESS THE BUTTON"
  ShowScreen
  Page = 4
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  ' the batting controller's button (either in a one-player game)
  if Players = 1 then
    V = Btn
  elseif Bat = 1 then
    V = J1 & 16
  else
    V = J2 & 16
  end if
  Swing = 0
  if V > 0 then
    if WasSw = 0 then Swing = 1
  end if
  WasSw = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the big ball, the listing's banner, the tune once;
' 1 PLAYER / 2 PLAYERS / CREDITS
sub TitlePage:
  NewScreen
  print at 11,3, "BATTER UP!"
  print at 9,5, "BY J.C. HILTY"
  for Ri = 0 to 3
    for Ci = 0 to 3
      V = Ri * 4 + Ci
      put char TBall00 + V at Ci + 14,Ri + 7
    next
  next
  print at 2,13, "PLEASE WAIT WHILE WE BUY"
  print at 2,14, "SOME PEANUTS.."
  print at 10,16, "1 PLAYER"
  print at 10,17, "2 PLAYERS"
  print at 10,18, "CREDITS"
  print at 8,21, "AHOY! AUG 1987"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 434
  TzOn = 1
  Page = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
      play sound SndMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 0 to 2
    put char 32 at 8,J + 16
  next
  put char 62 at 8,Menu + 16
  return
end sub

sub CreditsPage:
  NewScreen
  print at 11,2, "BATTER UP!"
  print at 2,5, "BASED ON BATTER UP! BY"
  print at 2,6, "J.C. HILTY, AHOY! AUGUST"
  print at 2,7, "1987, COMMODORE 64."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: PEANUTS AND PROGRAMS"
  print at 2,17, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Page = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

