KbBoom:
    db $00,$00,$04,$03,$00,$00,$15,$04,$00,$00,$26,$06,$00,$00,$46,$0A,$00,$00,$66,$10,$10
KbFuse:
    db $00,$00,$70,$02,$00,$00,$91,$02,$10
