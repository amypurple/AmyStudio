KbOver:
    db $40,$1D,$11,$0C,$40,$2E,$21,$0C,$40,$53,$21,$0C,$40,$3B,$22,$1E,$50
KbTick:
    db $40,$55,$40,$02,$50

KbSoundTable:
    dw KbTuneMel,$702B
    dw KbTuneBass,$7035
    dw KbCatch,$7049
    dw KbBoom,$703F
    dw KbFuse,$703F
    dw KbFaster,$7049
    dw KbStart,$7049
    dw KbOver,$7049
    dw KbTick,$7049
; Rooftop Prank (original)
; Tiny Sound, 8 frames per step
KbTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1F,$01,$23,$26,$01,$23,$1F,$01,$21,$01,$24,$28
    db $01,$24,$21,$01,$23,$01,$26,$2B,$01,$2A,$28,$01,$26,$01,$01,$23
    db $01,$21,$1F,$01,$1F,$01,$23,$26,$01,$23,$1F,$01,$21,$01,$24,$28
    db $01,$2A,$2B,$01,$26,$01,$23,$01,$21,$01,$1E,$01,$1F,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
KbTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$0B,$01,$12,$01,$10,$01,$0B,$01,$0C,$01,$13,$01
    db $0E,$01,$15,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$09,$01,$10,$01
    db $0E,$01,$15,$01,$07,$01,$0E,$01,$0E,$01,$15,$01,$07,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
