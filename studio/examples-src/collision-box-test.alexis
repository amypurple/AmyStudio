' COLLIDES WITH TEST
' Sprite 1 (white): stationary at center (X=120, Y=95)
' Sprite 2 (red):   same X as sprite 1, bounces on Y axis
' Sprite 3 (cyan):  same Y as sprite 1, bounces on X axis
' Uses: named hitboxes for sprite-to-sprite collision

u8 BounceY = 8
u8 BounceX = 0
u8 DY = 2
u8 DX = 3

hitbox DotHitbox = 0,0 size 8,8

data DotSprite bytes
  $18,$3C,$7E,$FF,$FF,$7E,$3C,$18
end data

  text screen
  sprites 8x8
  sprites simple
  copy DotSprite to vram.spr_pat
  clear sprites
  set sprite count 3
  print at 6,0, "COLLIDES WITH TEST"
  print at 1,2, "SPR2 (Y BOUNCE):"
  print at 1,3, "SPR3 (X BOUNCE):"
  screen on

CollisionLoop:
  wait
  bounce BounceY by DY between 8 and 175
  bounce BounceX by DX between 0 and 240
  set sprite 0 to 95,120,0,15
  set sprite 1 to BounceY,120,0,9
  set sprite 2 to 95,BounceX,0,7
  update sprites
  if sprite 1 hitbox DotHitbox collides with sprite 0 hitbox DotHitbox then
    print at 17,2, "HIT"
  else
    print at 17,2, "---"
  end if
  if sprite 2 hitbox DotHitbox collides with sprite 0 hitbox DotHitbox then
    print at 17,3, "HIT"
  else
    print at 17,3, "---"
  end if
  goto CollisionLoop
