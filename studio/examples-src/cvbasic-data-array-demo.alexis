' DATA reader state
u8 I = 0
u8 X = 0
u8 Letters[8]

' Fill an array from DATA, then draw it with a WHILE loop.
  text screen
  print at 4,2, "CVBASIC DATA/ARRAY TEST"
  print at 1,4, "READ INTO ARRAY, DRAW WITH WHILE"
  restore MessageChars
  for I = 0 to 7
    read Letters[I]
  next
  X = 0
  while X < 8
    put char Letters[X] at X,10
    X += 1
  end while
  screen on

data MessageChars bytes $41,$4D,$59,$20,$52,$55,$4E,$21