' ---------------------------------------------------------------- constants
const XMIN = 3          ' play field columns (rails at 2 and 29)
const XMAX = 28
const SHIPY0 = 151       ' ship sprite Y (rows 19-20)
const SXMIN = 22
const SXMAX = 210
const Goal = 10         ' energy sources a level
const FuelMax = 96      ' 12 gauge tiles x 8 pixels
const EMPTY = 0         ' the transparent empty cell of the play field

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
' the scrolling objects: a queue in spawn order (oldest = lowest on screen);
' ObjR = row of the TOP cell, ObjC = column, ObjT = type (0 = gone)
u8 ObjR[64]
u8 ObjC[64]
u8 ObjT[64]
u8 LastW[32]            ' wrap number of the last spawn in each column
u8 QH = 0
u8 QT = 0
u8 WmI = 0              ' WrapMove scratch
u8 WmR = 0
u8 WmK = 0
u8 WmC = 0
u8 Ph = 0               ' pixel phase 0-7 of every object
u8 Acc = 0
u8 Spd = 4              ' quarter pixels a frame
u8 WrapF = 0
u8 SpawnDue = 0         ' the new row is spawned the frame after a wrap
u8 Busy = 0             ' this frame moved or spawned objects: no HUD drawing
u8 HudDirty = 0
u8 GaugeDirty = 0
u8 WrapN = 10
u8 Anim = 0
u8 ClipT = 2            ' visible rows of the scrolling window
u8 ClipB = 21
u8 InTitle = 0
u8 SpT = 0
u8 SpC = 0
u8 Ok = 0
u8 I2 = 0
u8 Ot = 0
u8 Ox = 0
u8 Oy = 0
u8 Sx = 116             ' the ship
u8 ShipY = 151
u8 ShipOff = 0
u8 Inv = 0
u8 FlashT = 0
u8 BdNew = 0            ' backdrop to set at the start of the next frame (0 = none)
u8 EffT = 0
u8 EffK = 0
u8 EffX = 0
u8 EffY = 0
u8 Fuel = 96
u8 FuelC = 0
u8 DrainR = 14
u8 Band = 0
u8 AlarmT = 0
u8 Ships = 5
u8 MaxShips = 5
u8 Got = 0
u8 Level = 1
u8 StartLv = 1
u16 Score = 0           ' in tens (the HUD adds the last 0)
u8 GMode = 0            ' 0 play, 1 level cleared (warp), 2 last crash
u8 GTime = 0
u8 Cause = 0            ' 0 debris, 1 out of fuel
u8 DebP = 140
u8 Deb2 = 0
u8 FarAcc = 0
u8 FarF = 0
u8 FarDue = 0
u8 SpawnF = 0
u8 SndOn = 0
u8 GT = 0
u8 SndDue = 0
u8 StopDue = 0
u8 KQ = 0
u8 EnRows = 12
u8 EnCnt = 6
u8 Bonus = 0
u8 K = 0
u8 Q = 0
u8 Cx = 0
u8 Cy = 0
u8 Cnt = 0
u8 Menu = 0
u8 TSx = 116
u8 TTgt = 116
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title

' per level (1-16, then the last value)
data SpdT bytes 4,5,5,6,6,7,7,8,8,9,9,10,10,11,11,11
data DebPT bytes 110,125,140,150,160,170,180,190,195,200,205,210,215,220,225,230
data Deb2T bytes 0,0,0,15,30,45,60,75,85,95,105,115,125,135,145,155
data EnRowT bytes 12,12,13,13,14,14,15,16,16,17,17,18,18,19,19,20
data DrainT bytes 14,13,12,11,10,10,9,9,8,8,8,7,7,7,6,6
' title sky: column,row pairs of the still stars around the logo
data TSky bytes 3,1,6,2,4,4,2,6,25,1,28,2,24,4,27,5,7,6,29,3

' ================================================================== program
  tile screen
  mode 2 screen
  set sound table ScSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $9E37
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 3 then
    HelpScreens
    goto title
  end if
  if Menu = 4 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Ships = MaxShips
  Score = 0

new_level:
  NewLevel

play_loop:
  SoundHold
  Frame1
  Phase = 1
  Backdrop
  ScrollStep
  ReadPad
  MoveShip
  DrawShip
  if GMode = 0 then
    ' the frames that move or spawn objects have no time left for the test;
    ' the objects move at most 3 pixels a frame and the hit window is 21
    ' pixels tall, so the test two frames later still catches every hit
    if WrapF = 0 then
      if SpawnF = 0 then Collide
    end if
    FuelStep
  end if
  Effects
  ' the sounds of a hit, then the HUD, are done in frames that did not
  ' move, spawn or redraw objects (one of them a frame)
  if Busy = 0 then
    if SndDue <> 0 then
      Sounds
    else
      HudFrame
    end if
  end if
  if GMode = 1 then
    inc GTime
    ' warp: the stars streak faster and faster, then the field empties
    V = GTime & 7
    if V = 0 then
      if Spd < 16 then inc Spd
    end if
    if GTime > 90 then
      if QH = QT then goto cleared
    end if
  end if
  if GMode = 2 then
    inc GTime
    if GTime >= 120 then goto game_over
  end if
  goto play_loop

' ------------------------------------------------------------ level cleared
cleared:
  Phase = 0
  print at 9,10, "LEVEL"
  print Level at 15,10 width 2
  print at 18,10, "CLEAR"
  print at 9,12, "FUEL BONUS"
  K = Fuel
  Score += K
  print K at 20,12 width 2
  print at 22,12, "0"
  DrawScore
  for Cnt = 1 to 150
    Frame1
    DrawShip
    ReadPad
    if Cnt > 40 then
      if Press = 1 then Cnt = 150
    end if
  next
  if Level < 99 then inc Level
  goto new_level

' ------------------------------------------------------------ game over
game_over:
  Phase = 0
  HideSprites
  Panel
  print at 11,9, "GAME OVER"
  if Cause = 0 then print at 7,11, "HIT BY COSMIC DEBRIS"
  if Cause = 1 then print at 10,11, "OUT OF FUEL"
  print at 5,13, "YOUR SCORE"
  print Score at 16,13 width 5
  print at 21,13, "0"
  print at 24,13, "LV"
  print Level at 26,13 width 2
  play sound SndOver
  for Cnt = 1 to 90
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  goto title

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ tiles, colours
' the same tile set in the three thirds; the font is white / cyan / yellow
' on black from top to bottom (mode 2: one colour table per third), the
' side rails cyan / magenta / light red
sub LoadTiles:
  copy ScPat count ScBytes to vram.pattern + 1024
  copy ScCol count ScBytes to vram.color + 1024
  copy ScPat count ScBytes to vram.pattern + 3072
  copy ScCol count ScBytes to vram.color + 3072
  copy ScPat count ScBytes to vram.pattern + 5120
  copy ScCol count ScBytes to vram.color + 5120
  fill $F1 count 768 to vram.color + 256
  fill $71 count 768 to vram.color + 2304
  fill $B1 count 768 to vram.color + 4352
  ' code 0: the empty, transparent cell of the play field
  fill 0 count 8 to vram.pattern
  fill 0 count 8 to vram.pattern + 2048
  fill 0 count 8 to vram.pattern + 4096
  fill 0 count 8 to vram.color
  fill 0 count 8 to vram.color + 2048
  fill 0 count 8 to vram.color + 4096
  fill $70 count 16 to vram.color + ScRaill * 8
  fill $D0 count 16 to vram.color + 2048 + ScRaill * 8
  fill $90 count 16 to vram.color + 4096 + ScRaill * 8
  backdrop black
  cls
  return
end sub

' the play field: rails, empty transparent cells
sub Field:
  for Cy = 2 to 21
    put char ScRaill at 2,Cy
    put char ScRailr at 29,Cy
    FieldRow
  next
  return
end sub

' one row of empty play field (Cy): the far star tiles of each column
sub FieldRow:
  for Cx = XMIN to XMAX
    BgCell
  next
  return
end sub

' the empty cell Cx,Cy: far star tile of its column class, or code 0
sub BgCell:
  K = ColBase[Cx]
  if K <> 0 then
    V = Cy & 3
    K += V
  end if
  put char K at Cx,Cy
  return
end sub

' ------------------------------------------------------------ the scroll
' every frame: the phase moves Spd/4 pixels; the object patterns of that
' phase are written; every 8 pixels the objects move down one row (wrap)
sub ScrollStep:
  Acc += Spd
  K = Acc >> 2
  Acc = Acc & 3
  Ph += K
  WrapF = 0
  if Ph >= 8 then
    Ph -= 8
    WrapF = 1
  end if
  ' the far stars: a sixth of the objects' speed
  FarAcc += Spd
  if FarAcc >= 24 then
    FarAcc -= 24
    inc FarF
    FarF = FarF & 31
    FarDue = 1
  end if
  V = Tick >> 4
  Anim = V & 1
  ' v2.1: every tile write is done at the top of the frame, before the
  ' beam reaches the play field (the music waits until after them, see
  ' SoundHold); one heavy job a frame: the wrap, else the new row, else
  ' the far stars (written first: they are the shorter job)
  Busy = 0
  SpawnF = 0
  if WrapF = 0 then
    if SpawnDue = 0 then
      if FarDue = 1 then
        FarDue = 0
        FarGfx
        Busy = 1
      end if
    end if
  end if
  if WrapF = 1 then
    ' top third first, then the names (newest objects, at the top, first),
    ' then the lower thirds: the beam meets every cell already consistent
    GT = 0
    GfxThird
    inc WrapN
    WrapMove
    GT = 1
    GfxThird
    GT = 2
    GfxThird
    SpawnDue = 1
    Busy = 1
    SoundService
    return
  end if
  GfxPhase
  if SpawnDue = 1 then
    SpawnDue = 0
    SpawnRow
    Busy = 1
    SpawnF = 1
  end if
  SoundService
  return
end sub

' FarPh[FarF] (96 bytes) -> the 12 far star tiles (codes 146-157), three thirds
sub FarGfx:
  asm {
    ld a,(FarF)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,de
    ld de,FarPh
    add hl,de
    push hl
    ld a,$90
    out ($BF),a
    ld a,$44
    out ($BF),a
    ld bc,$60BE
FG_o1:
    outi
    nop
    jp nz,FG_o1
    pop hl
    push hl
    ld a,$90
    out ($BF),a
    ld a,$4C
    out ($BF),a
    ld b,$60
FG_o2:
    outi
    nop
    jp nz,FG_o2
    pop hl
    ld a,$90
    out ($BF),a
    ld a,$54
    out ($BF),a
    ld b,$60
FG_o3:
    outi
    nop
    jp nz,FG_o3
  }
  return
end sub

' ObjPh[Anim][Ph] (144 bytes) -> the patterns of codes 128-145, three thirds
' (OUTI / NOP / JP NZ = 30 T between VRAM writes)
' v2.1: during play the OS7 sound update leaves the NMI (it took up to
' 20 000 T there, so the tile writes started after the beam had reached the
' play field: torn objects at the top of the screen). SoundHold, just before
' the frame wait, turns it off; SoundService runs it after the tile writes.
sub SoundHold:
  asm {
    ld a,(AMY_SOUND_ENABLED)
    ld (SndOn),a
    xor a
    ld (AMY_SOUND_ENABLED),a
  }
  return
end sub

sub SoundService:
  asm {
    ld a,(SndOn)
    or a
    jr z,SS_skip
    ld (AMY_SOUND_ENABLED),a
    push ix
    push iy
    call PLAY_SOUNDS
    call UPDATE_SOUND_ADDR
    pop iy
    pop ix
SS_skip:
  }
  return
end sub

sub GfxPhase:
  GT = 0
  GfxThird
  GT = 1
  GfxThird
  GT = 2
  GfxThird
  return
end sub

' one third (GT) of the object patterns
sub GfxThird:
  asm {
    ld a,(Anim)
    add a,a
    add a,a
    add a,a
    ld hl,Ph
    add a,(hl)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de
    ld de,ObjPh
    add hl,de
    xor a
    out ($BF),a
    ld a,(GT)
    add a,a
    add a,a
    add a,a
    add a,$44
    out ($BF),a
    ld bc,$90BE
GT_o1:
    outi
    nop
    jp nz,GT_o1
  }
  return
end sub

' every object (2x3 cells) moves down one row: its old top row gets the far
' star tiles back, its three rows are written one row lower (only inside
' rows ClipT-ClipB). Objects that share a column are at least 4 rows
' apart, so no two of them ever share a cell.
' Then the oldest objects that left the window leave the queue.
sub WrapMove:
  asm {
    ld a,(QT)
    ld (WmI),a
WM_loop:
    ld a,(WmI)
    ld hl,QH
    cp (hl)
    jp z,WM_done
    dec a
    and 63
    ld (WmI),a
    ld e,a
    ld d,0
    ld hl,ObjR
    add hl,de
    ld a,(hl)
    inc (hl)
    ld (WmR),a
    ld hl,ObjT
    add hl,de
    ld a,(hl)
    or a
    jp z,WM_loop
    ld b,a
    add a,a
    add a,b
    add a,a
    add a,122
    ld (WmK),a
    ld hl,ObjC
    add hl,de
    ld a,(hl)
    ld (WmC),a
    ; fast path: all four rows inside the window
    ld a,(ClipT)
    ld b,a
    ld a,(WmR)
    cp b
    jr c,WM_slow
    cp 128
    jr nc,WM_slow
    add a,3
    ld b,a
    ld a,(ClipB)
    cp b
    jr c,WM_slow
    ld a,(WmR)
    call WM_erase
    ld de,32
    add hl,de
    ld a,(WmK)
    call WM_pair
    add hl,de
    ld a,(WmK)
    add a,2
    call WM_pair
    add hl,de
    ld a,(WmK)
    add a,4
    call WM_pair
    jp WM_loop
WM_pair:
    ld c,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,c
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    out ($BE),a
    ret
WM_slow:
    ld a,(WmR)
    call WM_erase
    ld a,(WmK)
    ld b,a
    ld a,(WmR)
    inc a
    call WM_row
    ld a,(WmK)
    add a,2
    ld b,a
    ld a,(WmR)
    add a,2
    call WM_row
    ld a,(WmK)
    add a,4
    ld b,a
    ld a,(WmR)
    add a,3
    call WM_row
    jp WM_loop
WM_row:
    call WM_addr
    ret c
    ld a,b
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    out ($BE),a
    ret
WM_addr:
    ld c,a
    ld hl,ClipT
    cp (hl)
    ret c
    ld a,(ClipB)
    cp c
    ret c
    ld a,c
    rrca
    rrca
    rrca
    ld h,a
    and $E0
    ld l,a
    ld a,(WmC)
    or l
    ld l,a
    out ($BF),a
    ld a,h
    and $1F
    or $18
    ld h,a
    or $40
    out ($BF),a
    or a
    ret
WM_erase:
    ld d,a
    call WM_addr
    ret c
    ld a,d
    and 3
    ld c,a
    push hl
    ld hl,ColBase
    ld a,(WmC)
    add a,l
    ld l,a
    adc a,h
    sub l
    ld h,a
    ld a,(hl)
    or a
    jr z,WE_1
    add a,c
WE_1:
    out ($BE),a
    inc hl
    ld a,(hl)
    or a
    jr z,WE_2
    add a,c
WE_2:
    out ($BE),a
    pop hl
    ret
WM_done:
    ld a,(QH)
    ld hl,QT
    cp (hl)
    jr z,WM_end
    ld e,a
    ld d,0
    ld hl,ObjR
    add hl,de
    ld b,(hl)
    bit 7,b
    jr nz,WM_end
    ld a,(ClipB)
    cp b
    jr nc,WM_end
    ld a,(QH)
    inc a
    and 63
    ld (QH),a
    jr WM_done
WM_end:
  }
  return
end sub

sub ClearQueue:
  QH = 0
  QT = 0
  Ph = 0
  Acc = 0
  WrapN = 10
  for J = 0 to 31
    LastW[J] = 0
  next
  return
end sub

' a random column of the play field
sub RndCol:
  Rnd
  V = R2 % 25
  SpC = V + XMIN
  return
end sub

' a new object SpT at column SpC, its TOP cell hidden above the window
' (Ok = 0 when the column was used less than 3 rows ago or the queue is full)
sub TrySpawn:
  Ok = 0
  K = LastW[SpC]
  V = WrapN - K
  if V < 4 then return
  Cx = SpC + 1
  K = LastW[Cx]
  V = WrapN - K
  if V < 4 then return
  ' at most 11 objects (live or gone) in the queue: the frame budget (the
  ' NMI's music can take 20 000 T of a frame, a wrap frame 15 000 + 1 450 an object)
  V = QT - QH
  V = V & 63
  if V >= 11 then return
  V = QT + 1
  V = V & 63
  K = ClipT - 3
  ObjR[QT] = K
  ObjC[QT] = SpC
  ObjT[QT] = SpT
  QT = V
  LastW[SpC] = WrapN
  LastW[Cx] = WrapN
  ' v2.1: nothing is drawn here (it came a frame late, under the beam):
  ' the object starts one row higher, fully hidden, and the next wrap draws
  ' its bottom row at the top of the window in the blank time
  Ok = 1
  return
end sub

' one new row at the top: stars, debris, now and then an energy source
sub SpawnRow:
  if InTitle = 1 then
    TitleSpawn
    return
  end if
  if GMode <> 0 then return
  Rnd
  if R2 < DebP then
    Rnd
    SpT = 1
    if R2 < 100 then SpT = 2
    RndCol
    TrySpawn
  end if
  Rnd
  if R2 < Deb2 then
    Rnd
    SpT = 1
    if R2 < 100 then SpT = 2
    RndCol
    TrySpawn
  end if
  dec EnCnt
  if Bonus = 1 then EnCnt = 0
  if EnCnt = 0 then
    SpT = 3
    RndCol
    TrySpawn
    if Ok = 1 then
      EnCnt = EnRows
      Bonus = 0
    else
      EnCnt = 1
    end if
  end if
  return
end sub

sub TitleSpawn:
  Rnd
  if R2 < 70 then
    Rnd
    SpT = 1
    if R2 < 100 then SpT = 2
    RndCol
    TrySpawn
  end if
  dec EnCnt
  if EnCnt = 0 then
    SpT = 3
    RndCol
    TrySpawn
    EnCnt = 7
  end if
  return
end sub

' an object is gone (taken, or crashed into): its cells are emptied
sub KillObj:
  ObjT[I2] = 0
  WmR = ObjR[I2]
  WmC = ObjC[I2]
  asm {
    ld a,(WmR)
    call WM_erase
    ld a,(WmR)
    inc a
    call WM_erase
    ld a,(WmR)
    add a,2
    call WM_erase
  }
  return
end sub

' ------------------------------------------------------------ the ship
sub MoveShip:
  if GMode = 2 then return
  if Lf1 = 1 then
    if Sx > SXMIN then Sx -= 2
  end if
  if Rt1 = 1 then
    if Sx < SXMAX then Sx += 2
  end if
  if Inv > 0 then dec Inv
  return
end sub

sub DrawShip:
  V = ShipY
  if Inv > 0 then
    K = Inv & 16
    if K <> 0 then V = 209
  end if
  if GMode = 2 then V = 209
  if EffK = 1 then
    if EffT > 0 then V = 209
  end if
  set sprite 0 to V,Sx,SpHull,15
  K = SpPods
  if Lf1 = 1 then K = SpPodsl
  if Rt1 = 1 then K = SpPodsr
  set sprite 1 to V,Sx,K,8
  ' the flame changes shape every 4 frames, never colour (no flashing)
  K = SpFlame0
  Q = 11
  ShipOff = Tick & 4
  if ShipOff <> 0 then K = SpFlame1
  if GMode = 1 then
    K = SpFlame1
    Q = 15
  end if
  set sprite 2 to V,Sx,K,Q
  update sprites
  return
end sub

' the energy sources and debris that reach the ship (oldest objects first:
' they are the lowest; stop at the first one above the ship)
sub Collide:
  I2 = QH
coll_loop:
  if I2 = QT then return
  Ot = ObjT[I2]
  if Ot = 0 then goto coll_next
  Oy = ObjR[I2]
  Oy = Oy << 3
  Oy += Ph
  ' object pixels Oy+2..Oy+13, ship SHIPY0+2..SHIPY0+12 (sprite Y + 1 on screen)
  if Oy > 161 then goto coll_next
  if Oy < 141 then return
  Ox = ObjC[I2]
  Ox = Ox << 3
  if Ot = 3 then
    ' energy: a wide grab (the pods take it too)
    K = Ox + 14
    if K < Sx then goto coll_next
    K = Sx + 14
    if Ox > K then goto coll_next
    TakeEnergy
    goto coll_next
  end if
  if Inv > 0 then goto coll_next
  K = Ox + 9
  if K < Sx then goto coll_next
  K = Sx + 9
  if Ox > K then goto coll_next
  KillObj
  Cause = 0
  Crash
coll_next:
  inc I2
  I2 = I2 & 63
  goto coll_loop
end sub

sub TakeEnergy:
  KillObj
  Score += 25
  inc Got
  K = Fuel + 32
  if K > FuelMax then K = FuelMax
  Fuel = K
  SndDue = 2
  EffK = 2
  EffT = 20
  FlashT = 24
  BdNew = 3
  Rnd
  if R2 < 128 then Bonus = 1
  HudDirty = 1
  GaugeDirty = 1
  if Got >= Goal then
    GMode = 1
    GTime = 0
    Inv = 0
    StopDue = 1
    SndDue = 3
  end if
  return
end sub

sub Crash:
  dec Ships
  EffK = 1
  EffT = 40
  EffX = Sx - 8
  EffY = ShipY - 8
  FlashT = 24
  BdNew = 2
  Inv = 120
  Rnd
  if R2 < 128 then Bonus = 1
  HudDirty = 1
  if Ships = 0 then
    GMode = 2
    GTime = 0
    StopDue = 1
  end if
  SndDue = 1
  return
end sub

sub FuelStep:
  inc FuelC
  if FuelC < DrainR then return
  FuelC = 0
  if Fuel > 0 then dec Fuel
  GaugeDirty = 1
  if Fuel < 24 then
    inc AlarmT
    if AlarmT >= 6 then
      AlarmT = 0
      play sound SndAlarm
    end if
  end if
  if Fuel = 0 then
    Cause = 1
    Crash
    Fuel = FuelMax
    GaugeDirty = 1
  end if
  return
end sub

sub HudFrame:
  if HudDirty = 1 then
    HudDirty = 0
    DrawHud
    return
  end if
  if GaugeDirty = 1 then
    GaugeDirty = 0
    DrawGauge
  end if
  return
end sub

sub Sounds:
  if StopDue = 1 then StopMusic
  StopDue = 0
  if SndDue = 1 then
    play sound SndBoom
    play sound SndZap
  end if
  if SndDue = 2 then play sound SndPing
  if SndDue = 3 then play sound SndWarp
  SndDue = 0
  return
end sub

' the book's paper flashes, set in the blank time at the top of a frame
' (1 black, 2 dark red, 3 dark green, 4 dark yellow)
sub Backdrop:
  if BdNew = 0 then return
  if BdNew = 1 then backdrop black
  if BdNew = 2 then backdrop dark red
  if BdNew = 3 then backdrop dark green
  if BdNew = 4 then backdrop dark yellow
  BdNew = 0
  return
end sub

' the explosion / sparkle sprite, the backdrop flashes
sub Effects:
  if FlashT > 0 then
    dec FlashT
    if FlashT = 12 then BdNew = 4
    if FlashT = 0 then BdNew = 1
  end if
  if EffT = 0 then return
  dec EffT
  if EffT = 0 then
    hide sprite 3
    hide sprite 4
    hide sprite 5
    hide sprite 6
    return
  end if
  if EffK = 1 then
    ' the big explosion: 32x32 (4 sprites), 4 stages of 10 frames;
    ' the ship is hidden meanwhile, so a line never has more than 4 sprites
    Q = 40 - EffT
    Q = Q / 10
    K = Q << 4
    K += SpBs0q0
    V = 15
    if Q = 1 then V = 11
    if Q = 2 then V = 9
    if Q = 3 then V = 6
    set sprite 3 to EffY,EffX,K,V
    K += 4
    Cx = EffX + 16
    set sprite 4 to EffY,Cx,K,V
    K += 4
    Cy = EffY + 16
    set sprite 5 to Cy,EffX,K,V
    K += 4
    set sprite 6 to Cy,Cx,K,V
    return
  end if
  K = SpSpark0
  V = EffT & 4
  if V = 0 then K = SpSpark1
  set sprite 3 to ShipY,Sx,K,11
  return
end sub

' ------------------------------------------------------------ HUD
sub DrawHud:
  print at 2,1, "LV"
  print Level at 4,1 width 2
  HudIcons(ScHenergy, ScHnoenergy, Got, Goal, 7, 1)
  K = 29 - MaxShips
  HudIcons(ScHship, ScHnoship, Ships, MaxShips, K, 1)
  DrawScore
  return
end sub

sub DrawScore:
  print Score at 23,22 width 5
  if Score = 0 then print at 27,22, " "
  print at 28,22, "0"
  return
end sub

' 12 tiles, 1/8 tile steps; green, yellow under half, red under a quarter
sub DrawGauge:
  put char ScHfuel at 2,22
  V = Fuel
  for J = 3 to 14
    if V >= 8 then
      K = 8
      V -= 8
    else
      K = V
      V = 0
    end if
    K += ScGauge0
    put char K at J,22
  next
  K = 0
  if Fuel < 48 then K = 1
  if Fuel < 24 then K = 2
  if K <> Band then
    Band = K
    if K = 0 then copy GaugeColG count 72 to vram.color + 4096 + ScGauge0 * 8
    if K = 1 then copy GaugeColY count 72 to vram.color + 4096 + ScGauge0 * 8
    if K = 2 then copy GaugeColR count 72 to vram.color + 4096 + ScGauge0 * 8
  end if
  return
end sub

' ------------------------------------------------------------ a new level
sub NewLevel:
  BlankScreen
  sprites flicker off
  LoadTiles
  Field
  K = Level
  if K > 16 then K = 16
  dec K
  Spd = SpdT[K]
  DebP = DebPT[K]
  Deb2 = Deb2T[K]
  EnRows = EnRowT[K]
  DrainR = DrainT[K]
  InTitle = 0
  ClipT = 2
  ClipB = 21
  ClearQueue
  SpawnDue = 0
  HudDirty = 0
  GaugeDirty = 0
  EnCnt = 6
  Bonus = 0
  Got = 0
  Fuel = FuelMax
  FuelC = 0
  AlarmT = 0
  Inv = 0
  FlashT = 0
  BdNew = 0
  SndDue = 0
  StopDue = 0
  EffT = 0
  GMode = 0
  GTime = 0
  Sx = 116
  Band = 9
  DrawHud
  DrawGauge
  print at 11,10, "LEVEL"
  print Level at 17,10 width 2
  print at 11,12, "GET READY"
  ShowScreen
  play sound SndStart
  ' the ship flies in from below the screen
  ShipY = 200
  for Cnt = 1 to 100
    Frame1
    if ShipY > SHIPY0 then dec ShipY
    DrawShip
  next
  ShipY = SHIPY0
  Cy = 10
  FieldRow
  Cy = 12
  FieldRow
  StartMusic
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ panels
' a band between two bars (rows 8-15, columns 2-29)
sub Panel:
  for Cx = 2 to 29
    put char ScHbar at Cx,8
    put char ScHbarb at Cx,15
  next
  for Cy = 9 to 14
    fill 32 count 28 at 2,Cy
  next
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  LoadTiles
  return
end sub

' still stars along row Cy (for the pages)
sub StarRow:
  for Cx = 2 to 29
    K = Cx * 7
    K += Cy
    K = K % 5
    if K = 0 then put char ScSky at Cx,Cy
    if K = 2 then put char ScSkyd at Cx,Cy
  next
  return
end sub

' a 16x16 object still (phase 0: its top four tiles)
sub Put2x2(u8 Pc2, u8 Px2, u8 Py2):
  put char Pc2 at Px2,Py2
  inc Pc2
  inc Px2
  put char Pc2 at Px2,Py2
  inc Pc2
  dec Px2
  inc Py2
  put char Pc2 at Px2,Py2
  inc Pc2
  inc Px2
  put char Pc2 at Px2,Py2
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  Cy = 18
  StarRow
  Cy = 20
  StarRow
  Put2x2(ScEnergy0, 22, 18)
  ShowScreen
  set sprite 0 to 143,100,SpHull,15
  set sprite 1 to 143,100,SpPodsr,8
  set sprite 2 to 143,100,SpFlame0,11
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  Cy = 20
  StarRow
  Put2x2(ScEnergy0, 20, 19)
  Put2x2(ScRock0, 8, 19)
  ShowScreen
  set sprite 0 to 151,120,SpHull,15
  set sprite 1 to 151,120,SpPods,8
  set sprite 2 to 151,120,SpFlame1,9
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  TextScreen
  PageHelp2
  Put2x2(ScEnergy0, 3, 3)
  Put2x2(ScRock0, 2, 5)
  Put2x2(ScShard0, 4, 5)
  put char ScHenergy at 2,7
  put char ScHenergy at 3,7
  put char ScHnoenergy at 4,7
  put char ScHship at 3,10
  put char ScHship at 4,10
  put char ScHfuel at 2,12
  put char ScGauge8 at 3,12
  put char ScGauge3 at 4,12
  copy GaugeColG count 72 to vram.color + 2048 + ScGauge0 * 8
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  sprites flicker off
  LoadTiles
  fill $F1 count 768 to vram.color + 2304
  fill $F1 count 768 to vram.color + 4352
  for Y = 0 to Logo1H - 1
    V = Y * Logo1W
    J = Y + 1
    put Logo1 + V count Logo1W at 8,J
  next
  for Y = 0 to Logo2H - 1
    V = Y * Logo2W
    J = Y + 4
    put Logo2 + V count Logo2W at 9,J
  next
  for J = 0 to 9
    V = J << 1
    Cx = TSky[V]
    inc V
    Cy = TSky[V]
    K = J & 1
    if K = 0 then
      put char ScSky at Cx,Cy
    else
      put char ScSkyd at Cx,Cy
    end if
  next
  ' the space window (rows 8-11) between two bars, with the far stars
  for Cx = 2 to 29
    put char ScHbar at Cx,7
    put char ScHbarb at Cx,12
  next
  for Cy = 8 to 11
    fill EMPTY count 28 at 2,Cy
    FieldRow
  next
  ' menu (rows 13-21, a blank row between lines)
  print at 11,13, "START"
  print at 11,15, "LEVEL"
  print at 11,17, "SHIPS"
  print at 11,19, "HOW TO PLAY"
  print at 11,21, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowChoices
  InTitle = 1
  ClipT = 8
  ClipB = 11
  ClearQueue
  SpawnDue = 0
  Spd = 6
  EnCnt = 3
  TSx = 116
  TTgt = 116
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ScrollStep
  ReadPad
  Rnd
  TitleShip
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLv > 1 then dec StartLv
      end if
      if Rt1 = 1 then
        if StartLv < 5 then inc StartLv
      end if
    end if
    if Menu = 2 then
      if Lf1 = 1 then
        if MaxShips > 1 then dec MaxShips
      end if
      if Rt1 = 1 then
        if MaxShips < 9 then inc MaxShips
      end if
    end if
    ShowChoices
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  if Menu = 2 then Menu = 0
  Phase = 0
  InTitle = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowChoices:
  print at 18,15, "< >"
  put char StartLv + 48 at 19,15
  print at 18,17, "< >"
  put char MaxShips + 48 at 19,17
  return
end sub

' the title ship flies in the space window: it goes for the lowest energy
' source it can see, steps aside from a rock just above it, and takes the
' energy (a sparkle); the cursor (a small energy star) points at the menu
sub TitleShip:
  V = Menu << 4
  V += 103
  set sprite 3 to V,68,SpCursor,11
  ' target: the oldest live energy source in the window; a rock coming
  ' down on the ship (rows 10-13, within 12 pixels) sends it sideways
  I2 = QH
  TTgt = 116
  K = Tick & 128
  if K <> 0 then TTgt = 60
  Q = 0
tt_loop:
  if I2 = QT then goto tt_dodge
  Ot = ObjT[I2]
  Oy = ObjR[I2]
  Ox = ObjC[I2]
  Ox = Ox << 3
  if Ot = 1 then Ot = 2
  if Ot = 2 then
    ' a rock or shard coming down on the ship (rows 7-11)
    if Oy >= 7 then
      K = Ox + 20
      if K >= TSx then
        K = TSx + 20
        if Ox <= K then
          Q = 1
          Cx = Ox
        end if
      end if
    end if
  end if
  if Ot = 3 then
    if Q = 0 then
      TTgt = Ox
      ' near the ship: taken
      if Oy >= 9 then
        K = Ox + 14
        if K >= TSx then
          K = TSx + 14
          if Ox <= K then
            KillObj
            EffT = 16
          end if
        end if
      end if
      Q = 2
    end if
  end if
  inc I2
  I2 = I2 & 63
  goto tt_loop
tt_dodge:
  if Q = 1 then
    K = TSx + 4
    if Cx < 60 then K = 255
    if Cx > K then
      TTgt = Cx - 36
    else
      TTgt = Cx + 36
    end if
  end if
tt_move:
  if TSx < TTgt then inc TSx
  if TSx > TTgt then dec TSx
  if TSx < SXMIN then TSx = SXMIN
  if TSx > SXMAX then TSx = SXMAX
  K = SpPods
  if TSx < TTgt then K = SpPodsr
  if TSx > TTgt then K = SpPodsl
  set sprite 0 to 79,TSx,SpHull,15
  set sprite 1 to 79,TSx,K,8
  K = SpFlame0
  V = Tick & 4
  if V <> 0 then K = SpFlame1
  set sprite 2 to 79,TSx,K,11
  if EffT > 0 then
    dec EffT
    K = SpSpark0
    V = EffT & 4
    if V = 0 then K = SpSpark1
    set sprite 4 to 79,TSx,K,11
    if EffT = 0 then hide sprite 4
  end if
  update sprites
  return
end sub

' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 10,2, "SPACE CHASE"
  print at 8,5, "ORIGINAL GAME BY"
  print at 8,6, "CZES KOSNIOWSKI"
  print at 2,8, "GAMES TO PLAY ON YOUR ORIC-1"
  print at 9,9, "(SHIVA, 1983)"
  print at 6,12, "COLECOVISION VERSION"
  print at 7,14, "AMY & CLAUDE 2026"
  print at 2,16, "MADE IN AMY WITH AMY STUDIO"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp1:
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "DEEP IN OUTER SPACE, YOUR"
  print at 2,4, "SHIP IS SHORT OF FUEL."
  print at 2,6, "STEER TOWARDS THE ENERGY"
  print at 2,7, "SOURCES: THEY REFILL THE"
  print at 2,8, "TANK. AVOID THE COSMIC"
  print at 2,9, "DEBRIS OF THE EXPLOSION!"
  print at 2,11, "THE ENGINE IS ON FULL"
  print at 2,12, "THRUST: PUSH THE JOYSTICK"
  print at 2,13, "LEFT OR RIGHT TO STEER."
  print at 2,15, "TAKE TEN ENERGY SOURCES TO"
  print at 2,16, "CLEAR A LEVEL. EACH CRASH,"
  print at 2,17, "OR AN EMPTY TANK, COSTS"
  print at 2,18, "ONE SHIP."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp2:
  print at 8,1, "HOW TO PLAY  2/2"
  print at 6,3, "ENERGY: +250, FUEL"
  print at 6,5, "DEBRIS: CRASH!"
  print at 6,7, "ENERGY TAKEN"
  print at 6,8, "IN THIS LEVEL"
  print at 6,10, "SHIPS LEFT"
  print at 6,12, "FUEL: GREEN, YELLOW,"
  print at 6,13, "THEN RED - HURRY!"
  print at 2,16, "ON THE TITLE, CHOOSE THE"
  print at 2,17, "LEVEL AND HOW MANY SHIPS"
  print at 2,18, "YOU HAVE (1 TO 9)."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

