asm {
RxStep:
    db $40,$F9,$32,$02,$50
RxGrab:
    db $40,$6B,$10,$03,$40,$55,$10,$03,$40,$40,$20,$06,$50
RxMine:
    db $40,$7F,$20,$03,$50
RxCrash:
    db $00,$00,$04,$04,$00,$00,$15,$06,$00,$00,$36,$08,$00,$00,$56,$0E,$10
RxClear:
    db $40,$D6,$10,$04,$40,$AA,$10,$04,$40,$8F,$10,$04,$40,$6B,$10,$04,$40,$55,$10,$04,$40,$47,$20,$10
    db $50
RxStart:
    db $40,$1D,$21,$05,$40,$E2,$20,$05,$40,$BF,$20,$0C,$50
RxOver:
    db $40,$1D,$11,$0C,$40,$2E,$21,$0C,$40,$53,$21,$0C,$40,$3B,$22,$1E,$50

RxSoundTable:
    dw RxTuneMel,$702B
    dw RxTuneBass,$7035
    dw RxStep,$7049
    dw RxGrab,$7049
    dw RxMine,$7049
    dw RxCrash,$703F
    dw RxClear,$7049
    dw RxStart,$7049
    dw RxOver,$7049
; Snap Decision (original)
; Tiny Sound, 8 frames per step
RxTuneMel:
    db $44
    dw sndtiny_1
