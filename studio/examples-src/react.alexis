  $01,$01,$01,$00,$10,$10,$10,$00
  $00,$81,$81,$99,$99,$81,$81,$00
  $C3,$42,$A5,$81,$A5,$9A,$42,$C3
  $00,$81,$A5,$81,$42,$A5,$42,$00
  $00,$00,$18,$18,$C3,$A5,$C3,$42
  $00,$06,$08,$C3,$81,$81,$81,$C3
  $18,$C3,$81,$00,$00,$00,$C3,$C3
