' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 4
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  tile screen
  sprites 16x16
  sprites double
  fill mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  decompress zx0 KartSpr to vram.spr_pat
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: banner, name, menu (cursor back on START), the tune once
sub TitlePage:
  State = StTitle
  NewScreen
  BigText
  print at 11,14, "START"
  print at 11,16, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  print at 4,21, "BY CHARLES ORCUTT  1989"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' the title in ball letters (4 x 5 each): GO on rows 2-6, CARTS on 8-12
sub BigText:
  for Li = 0 to 10
    for Ri = 0 to 27
      W16 = Li * 28
      W16 += Ri
      T = BigMap[W16]
      if T > 0 then
        K = TBall
        if T = 2 then K = TRball
        put char K at Ri + 2, Li + 2
      end if
    next
  next
  return
end sub

sub ShowMenu:
  put char 32 at 9,14
  put char 32 at 9,16
  put char 32 at 9,18
  C = Menu << 1
  C += 14
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 12,2, "GO CARTS"
  ' packed text (text.mjs -> kit/textpack.mjs), airy: lines 2 rows apart,
  ' inside the text area [2,4,29,20] of areas.json
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages, each with a picture made of the game's own
' sprites and tiles
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "RACE YOUR GO-CART AND PASS"
  print at 2,5, "THE OTHER KARTS."
  RoadPic
  print at 2,15, "STICK UP: FASTER"
  print at 2,17, "STICK DOWN: SLOWER"
  print at 2,19, "LEFT AND RIGHT: STEER"
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "EACH ROUND LASTS 60 SECONDS."
    print at 2,5, "30 PASSES OR MORE: YOU KEEP"
    print at 2,7, "YOUR GO-CART. FEWER COST ONE"
    print at 2,9, "OF YOUR FIVE, AND SO DOES A"
    print at 2,11, "CRASH INTO ANOTHER KART."
    print at 2,13, "THE FASTER YOU GO, THE MORE"
    print at 2,15, "POINTS. AT TIME OUT EVERY"
    print at 2,17, "PASS IS WORTH 5 MORE."
    print at 2,19, "THE GRASS SLOWS YOU DOWN."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' a little road (rows 7-12) with the player's kart and one ahead
sub RoadPic:
  for Li = 7 to 12
    fill TGrass count 28 at 2,Li
    T = 19 - Li
    V = Li + 10
    C = V - T
    fill TRoad count C at T,Li
    put char TBordl at T - 1,Li
    put char TBordr at V,Li
    put char TCentre at 15,Li
  next
  set sprite 0 to 79,104,36,7
  set sprite 1 to 52,124,16,13
  update sprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

