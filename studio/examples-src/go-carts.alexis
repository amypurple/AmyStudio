cartridge "GO CARTS/CHARLES ORCUTT/1989"
' GO CARTS - ColecoVision port of the C-64 game by Charles Orcutt
' (program) and Dan Diamante (graphics), RUN magazine 1989 (ReRUN Summer
' 1990). Pseudo-3-D kart racing: hold the stick up to speed up, down to
' slow down, left/right to steer. Pass the other karts: 30 passes or more
' before the 60-second clock runs out keeps your kart; fewer costs one of
' your five. Hitting a kart costs one too. Score grows with speed, plus a
' 5-point passing bonus per pass at time out.
'
' Faithful to the original's rules, read from its 6502 code (orig/m.dis):
' every frame (the original's main loop waits for raster line 253 once a
' pass) the same counters run with the same periods: speed delay Spd
' (59 = stopped .. 2 = 58 MPH), score +1 every Spd+1 frames, karts move
' one depth unit every 30-|29-Spd| frames, curve steps every Spd+1 frames,
' the road's colour bands step every (Spd+1)/3 frames, centrifugal drift.
' The 15 road pictures are the original's TABLE file, converted to VDP
' tiles (gen/gen.py) and ZX0-packed; one is unpacked in 6 parts while the
' previous is shown (two pattern banks, two name stores in VRAM).

const TBall = 128
const TRball = 129
const TGrass = 130
const TRoad = 131
const TBordl = 132
const TBordr = 133
const TCentre = 134
const TSky = 135
const NTiles8 = 64
const SprBytes = 0
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndRaceA = 5
const SndRaceB = 6
const SndClick = 7
const SndPass = 8
const SndBonus = 9
const SndCrash = 10
const SndSkid = 11
const SndOver = 12
const SndEng0 = 13
const SndEng1 = 14
const SndEng2 = 15
const SndEng3 = 16
const SndEng4 = 17
const SndEng5 = 18
const SndEng6 = 19
const SndEng7 = 20
const TuneFrames = 384
const RaceFrames = 1024
const TxtCredits = 0
const MtnTiles = 109
const LaneE1 = 35
const LaneE2 = 80
const LaneE3 = 125
const BankO1 = 70
const BankO2 = 124
const MtnT0 = 144
const NParts = 293
const NSpr = 4
const HideY = 192
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StCrash = 5
const StTimeout = 6
const StOver = 9
' VRAM name stores of the two curve banks (phase A rows, then phase B rows)
const Store0 = $0400
const Store1 = $0180

u8 Ey[3]
u8 Ecol[3]
u8 Eshape[3]
u16 Ex[3]
u8 RowPh[13]
u8 Bl[4]
u8 CrashBuf[32]
u16 Score = 0
u16 ScoreHi = 0
u16 Hi = 0
u16 HiHi = 0
u16 Px = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 Vx = 0
u16 Ad = 0
u16 StoreB = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' the original's variables (C-64 address in brackets)
u8 Lives = 0
u8 Passes = 0
u8 Time = 0
u8 TimeSub = 0
u8 Spd = 0
u8 Mph = 0
u8 Running = 0
u8 Cv = 0
u8 CScore = 0
u8 CSteer = 0
u8 CSpeed = 0
u8 CCurve = 0
u8 CurveWait = 0
u8 RunLen = 0
u8 RunMax = 0
u8 DirB = 0
u8 EnTimer = 0
u8 EnDir = 0
u8 Dir7 = 0
u8 Rate = 0
u8 CDrift = 0
u8 CPush = 0
u8 FrameCnt = 0
u8 Recol = 0
u8 BandAcc = 0
u8 Flip = 0
u8 MPos = 0
u8 MShown = 0
' display state
u8 DispC = 0
u8 LoadC = 0
u16 Zi = 0
u16 RaceLeft = 0
u16 ZEnd = 0
u8 Zk = 0
u8 LastFr = 0
u8 Lag = 0
u8 Decoded = 0
u8 Busy = 0
u8 Loading = 0
u8 RowsDirty = 0
u8 HudDirty = 0
u8 Engine = 0
u8 EngT = 0
u8 Hit = 0
u8 Keep = 0
u8 CrashT = 0
u8 Pshape = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
u8 Oi = 0
u8 Li = 0
u8 Ri = 0
u8 Rn = 0
u8 RowMax = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 D = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  update sprites
  ' a frame missed (a road part took longer): one extra pass keeps the
  ' original's 60 passes a second
  T = frame
  V = T - LastFr
  LastFr = T
  Lag = V
  Decoded = 0
  VramWork
  ReadPad
  PlayStep
  ' a road part (ZX0, ~200 bytes) makes this pass span two frames: one
  ' more pass keeps the original's one pass per frame
  if Decoded = 1 then
    if State = StPlay then PlayStep
  end if
  Sounds
  if State = StCrash then
    CrashSeq
    if Lives > 0 then NewRound
  end if
  if State = StTimeout then
    TimeoutSeq
    if Lives > 0 then NewRound
  end if
  if Lives > 0 then goto play_loop

  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules (C-64 routine addresses in brackets)

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  Score = 0
  ScoreHi = 0
  Lives = 5
  PlayScreen
  NewRound
  return
end sub

' a new 60-second round [$12A0 + the $CF00 defaults]
sub NewRound:
  Passes = 0
  Time = 60
  TimeSub = 59
  Mph = 0
  Spd = 59
  Running = 0
  Cv = 7
  CScore = 0
  CSteer = 0
  CSpeed = 0
  CCurve = 0
  CurveWait = 40
  RunLen = 0
  RunMax = 10
  DirB = 2
  EnTimer = 59
  EnDir = 0
  CDrift = 0
  CPush = 0
  FrameCnt = 0
  Recol = 8
  BandAcc = 0
  Flip = 0
  BandReset
  Px = 192
  Ey[0] = 155
  Ey[1] = 183
  Ey[2] = 216
  Ecol[0] = 13
  Ecol[1] = 2
  Ecol[2] = 11
  Pshape = 9
  fill array RowPh with 255
  ' road straight ahead, unpacked whole with the display off
  if DispC <> 7 then
    Rearm
    wait
    nmi off
    display off
    Zi = ZFirst[7]
    ZEnd = ZFirst[8]
    while Zi < ZEnd
      ZStream
      inc Zi
    end while
    DispC = 7
    StoreB = Store1
    screen on
  end if
  Loading = 0
  ShowHudAll
  print at 2,7, "                            "
  print at 2,6, "                            "
  for Oi = 0 to 2
    EnemyPos
  next
  State = StPlay
  return
end sub

' one road part: tables split at 180 (word tables over 256 entries are refused)
sub ZStream:
  if Zi < 180 then
    Zk = Zi
    Ad = ZDstA[Zk]
    decompress zx0 ZTabA[Zk] to vram.pattern + Ad
  else
    W16 = Zi - 180
    Zk = W16
    Ad = ZDstB[Zk]
    decompress zx0 ZTabB[Zk] to vram.pattern + Ad
  end if
  return
end sub

' the in-game tune (looped, quiet) and the engine: tone 3 follows the speed
sub Sounds:
  if RaceLeft = 0 then
    play sound SndRaceA
    play sound SndRaceB
    RaceLeft = RaceFrames
  else
    dec RaceLeft
  end if
  if EngT > 0 then
    dec EngT
  else
    EngT = 7
    if Running = 1 then
      T = 59 - Spd
      T = T >> 3
      if T > 7 then T = 7
      play sound SndEng0 + T
    end if
  end if
  T = Jk & 12
  if T > 0 then
    if Running = 1 then
      V = FrameCnt & 15
      if V = 0 then play sound SndSkid
    end if
  end if
  return
end sub

sub StopRace:
  stop sound SndRaceA
  stop sound SndRaceB
  RaceLeft = 0
  return
end sub

sub BandReset:
  Bl[0] = 151
  Bl[1] = 161
  Bl[2] = 181
  Bl[3] = 211
  return
end sub

' one frame of the original's main loop [$1347 .. $15F8]
sub PlayStep:
  inc FrameCnt
  ' the clock [$134A]
  if Time = 0 then
    State = StTimeout
    return
  end if
  if TimeSub = 0 then
    TimeSub = 59
    dec Time
    HudDirty = HudDirty | 4
  else
    dec TimeSub
  end if
  ' score: +1 every Spd+1 frames while moving [$136A]
  if Running = 1 then
    if CScore = 0 then
      CScore = Spd
      AddScore
    else
      dec CScore
    end if
  end if
  ' steering every 2nd frame [$13D1]
  if Running = 1 then
    if CSteer = 0 then
      CSteer = 1
      V = Jk & 8
      if V > 0 then MoveRight
      V = Jk & 4
      if V > 0 then MoveLeft
    else
      dec CSteer
    end if
  end if
  ' centrifugal direction and rate from the curve [$140A]
  Dir7 = 0
  Rate = 8
  if Cv < 7 then
    Dir7 = 1
    Rate = Cv + 1
  end if
  if Cv > 7 then
    Dir7 = 2
    Rate = 15 - Cv
  end if
  ' speed every 3rd frame [$1782]
  if CSpeed = 0 then
    CSpeed = 2
    V = Jk & 1
    if V > 0 then
      Accel
    else
      V = Jk & 2
      if V > 0 then Slow
    end if
  else
    dec CSpeed
  end if
  ' the road curves [$143A]
  if CCurve = 0 then
    CCurve = Spd
    if Running = 1 then CurveStep
  else
    dec CCurve
  end if
  Collide
  if State <> StPlay then return
  ' the other karts [$1588]
  if EnTimer = 0 then
    if Spd < 29 then
      EnDir = 0
      T = 29 - Spd
    else
      EnDir = 1
      T = Spd - 29
    end if
    if T > 0 then
      ' at a standstill $1D - 30 = $FF: the next DEC is negative too (every frame)
      EnTimer = 0
      if T < 29 then EnTimer = 29 - T
      EnemyStep
    end if
  else
    dec EnTimer
  end if
  ' drift and the mountains [$1A32]
  if Running = 1 then
    T = Spd >> 3
    D = 8 - T
    for Li = 1 to D
      Drift1
    next
  end if
  ' the road's colour bands: 3 IRQ ticks a frame [$192B]
  if Running = 1 then
    BandAcc += 3
    T = Spd + 1
    while BandAcc >= T
      BandAcc -= T
      BandStep
    end while
  end if
  DrawSprites
  return
end sub

sub AddScore:
  inc Score
  if Score >= 10000 then
    Score = 0
    inc ScoreHi
  end if
  if ScoreHi > HiHi then
    HiHi = ScoreHi
    Hi = Score
  else
    if ScoreHi = HiHi then
      if Score > Hi then Hi = Score
    end if
  end if
  HudDirty = HudDirty | 1
  return
end sub

' [$1B8D]
sub Accel:
  inc Mph
  dec Spd
  Running = 1
  if Spd = 1 then
    Spd = 2
    Mph = 58
  end if
  HudDirty = HudDirty | 4
  return
end sub

' [$1B4F]
sub Slow:
  if Mph > 0 then dec Mph
  inc Spd
  if Spd = 60 then
    Spd = 59
    Running = 0
    Mph = 0
  end if
  HudDirty = HudDirty | 4
  return
end sub

' [$1A9B] 2 pixels right; the grass slows the kart
sub MoveRight:
  Px += 2
  if Px >= 266 then
    Slow
    Px = 266
  end if
  return
end sub

' [$1ACF]
sub MoveLeft:
  Px -= 2
  if Px < 80 then
    Slow
    Px = 80
  end if
  return
end sub

' [$1A53] one drift tick: the mountains move one pixel, every 7th tick the
' kart is pushed 2 pixels out of the bend
sub Drift1:
  if Dir7 = 0 then return
  if CDrift > 0 then
    dec CDrift
    return
  end if
  CDrift = Rate
  if CPush = 0 then
    CPush = 6
    if Dir7 = 1 then
      MoveRight
    else
      MoveLeft
    end if
  else
    dec CPush
  end if
  if Dir7 = 1 then
    dec MPos
  else
    inc MPos
  end if
  return
end sub

' [$1442] the curve generator: the frame counter picks the straight length
sub CurveStep:
  if CurveWait > 0 then
    dec CurveWait
    return
  end if
  CurveWait = FrameCnt & 15
  if RunLen = 0 then
    inc RunMax
    if RunMax = 22 then RunMax = 5
    RunLen = RunMax
    DirB = DirB ^ 3
  else
    dec RunLen
  end if
  T = Cv
  V = DirB & 2
  if V > 0 then
    if Cv > 0 then dec Cv
  else
    if Cv < 14 then inc Cv
  end if
  if Cv = 7 then CurveWait = 40
  ' a new road picture also moves the karts one step [$1704]
  if Cv <> T then EnemyStep
  return
end sub

' [$15FB] every kart one depth unit nearer (or farther when slower than 29)
sub EnemyStep:
  Oi = 3
  while Oi > 0
    dec Oi
    T = Ey[Oi]
    if EnDir = 0 then
      inc T
      if T = 250 then
        T = 150
        if Passes < 99 then inc Passes
        HudDirty = HudDirty | 2
        Recolour
        play sound SndPass
      end if
    else
      dec T
      if T = 149 then
        Recolour
        T = 249
      end if
    end if
    Ey[Oi] = T
    EnemyPos
  end while
  return
end sub

' [$1658] the next colour of the 8-colour cycle
sub Recolour:
  dec Recol
  if Recol = 0 then Recol = 8
  Ecol[Oi] = PalTab[Recol]
  return
end sub

' [$09F0] kart Oi: lane x from depth and curve, shape from depth
sub EnemyPos:
  D = Ey[Oi] - 150
  ' lane: from the vanishing point (24 + 8 * curve) to the lane's end
  T = Cv << 3
  T += 24
  K = LaneEnd[Oi]
  if K >= T then
    W16 = K - T
    W16 = W16 * Ramp[D]
    W16 = W16 >> 8
    Vx = T + W16
  else
    W16 = T - K
    W16 = W16 * Ramp[D]
    W16 = W16 >> 8
    Vx = T - W16
  end if
  Vx = Vx << 1
  Vx += 12
  ' the bend's sine offset [$0CC0]
  if Cv <> 7 then
    if Cv < 7 then
      K = 7 - Cv
    else
      K = Cv - 7
    end if
    dec K
    Ad = K * 100
    Ad += D
    V = OffTab[Ad]
    W16 = V << 1
    if Cv < 7 then
      Vx += W16
    else
      Vx -= W16
    end if
  end if
  Ex[Oi] = Vx
  ' size [$0A87]
  T = Ey[Oi] - 100
  T = T >> 2
  if T >= 10 then
    T -= 10
    T = T >> 1
  else
    T = 0
  end if
  if T > 9 then T = 9
  Eshape[Oi] = T
  return
end sub

' box overlap with the player's kart (shape 9); the original uses the
' VIC's sprite-sprite collision
sub Collide:
  for Oi = 0 to 2
    K = Eshape[Oi]
    Vx = Ey[Oi]
    T = BoxY1[K]
    Vx += T
    if Vx >= 205 then
      Vx = Ey[Oi]
      T = BoxY0[K]
      Vx += T
      if Vx <= 225 then
        Vx = Ex[Oi]
        T = BoxX1[K]
        Vx += T
        W16 = Px + 2
        if Vx >= W16 then
          Vx = Ex[Oi]
          T = BoxX0[K]
          Vx += T
          W16 = Px + 21
          if Vx <= W16 then
            Hit = Oi
            State = StCrash
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' one step of the colour bands [$1A16]
sub BandStep:
  inc Bl[0]
  Bl[1] += 2
  Bl[2] += 3
  Bl[3] += 4
  if Bl[3] >= 251 then
    BandReset
    Flip = Flip ^ 1
  end if
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' after the frame wait: sprites, then VRAM work (bands, mountains, road)
sub DrawSprites:
  W16 = Px - 56
  V = W16
  K = Pshape << 2
  set sprite 0 to 146,V,K,7
  for Li = 0 to 2
    C = Li + 1
    T = Ey[Li] - 59
    Vx = Ex[Li]
    if Vx < 56 then T = HideY
    if Vx > 300 then T = HideY
    W16 = Vx - 56
    V = W16
    if T > 190 then T = HideY
    K = Eshape[Li] << 2
    set sprite C to T,V,K,Ecol[Li]
  next
  return
end sub

sub VramWork:
  ' road rows whose band phase changed (copy 32 names from the store)
  Rn = 0
  RowMax = 4
  if Loading = 1 then RowMax = 1
  for Ri = 0 to 12
    if Rn >= RowMax then goto vw_rows_done
    ' phase at raster line 150 + 8 * row
    T = Ri << 3
    T += 150
    V = 0
    if T >= Bl[0] then V = 1
    if T >= Bl[1] then V = 0
    if T >= Bl[2] then V = 1
    if T >= Bl[3] then V = 0
    V = V ^ Flip
    if V <> RowPh[Ri] then
      RowPh[Ri] = V
      Ad = StoreB
      if V = 1 then Ad += 416
      W16 = Ri << 5
      Ad += W16
      W16 += 352
      if StoreB = Store0 then
        copy vram.name + Ad count 32 to vram.name + W16
      else
        copy vram.spr_pat + Ad count 32 to vram.name + W16
      end if
      inc Rn
    end if
  next
vw_rows_done:
  ' the mountains (2 rows, 4-pixel steps)
  T = MPos & 252
  if T <> MShown then
    MShown = T
    V = MPos >> 3
    K = MPos & 4
    Ad = V
    if K > 0 then Ad += 128
    copy MtnNames + Ad count 32 to vram.name + 288
    Ad += 64
    copy MtnNames + Ad count 32 to vram.name + 320
  end if
  ' the road picture: one ZX0 part a frame; the target is the logic curve
  ' (or its neighbour, so the bank alternates)
  ' a new load only once every row shows the current bank (the other bank
  ' is about to be overwritten)
  if Loading = 0 then
    if Busy > 0 then
      dec Busy
      goto vw_noload
    end if
    if DispC <> Cv then
      LoadC = Cv
      T = Cv ^ DispC
      T = T & 1
      if T = 0 then
        if Cv > DispC then
          LoadC = Cv - 1
        else
          LoadC = Cv + 1
        end if
      end if
      Zi = ZFirst[LoadC]
      ZEnd = ZFirst[LoadC + 1]
      Loading = 1
    end if
  end if
vw_noload:
  if Loading = 1 then
    ZStream
    Decoded = 1
    inc Zi
    if Zi = ZEnd then
      Loading = 0
      DispC = LoadC
      V = DispC & 1
      StoreB = Store0
      if V = 1 then StoreB = Store1
      fill array RowPh with 255
      Busy = 4
    end if
  end if
  if Loading = 0 then
    if HudDirty > 0 then HudPart
  end if
  return
end sub

' the play screen: Mode 2 with its own tiles in each third
sub PlayScreen:
  State = StBoot
  Rearm
  wait
  nmi off
  display off
  HideSprites
  mode 2 screen
  sprites 16x16
  sprites double
  load default ascii
  fill $F4 count 2048 to vram.color
  ' tiles 0 sky, 1 grass, 2 road in thirds 1 and 2
  fill 0 count 24 to vram.pattern + $0800
  fill 0 count 24 to vram.pattern + $1000
  fill $44 count 8 to vram.color + $0800
  fill $33 count 8 to vram.color + $0808
  fill $11 count 8 to vram.color + $0810
  fill $33 count 8 to vram.color + $1008
  fill $11 count 8 to vram.color + $1010
  decompress zx0 MtnPat to vram.pattern + $0C80
  decompress zx0 MtnCol to vram.color + $0C80
  decompress zx0 KartSpr to vram.spr_pat
  fill 32 count 256 to vram.name
  fill 0 count 32 to vram.name + 256
  backdrop black
  MShown = 255
  MPos = 0
  DispC = 255
  set sprite count NSpr
  return
end sub

sub ShowHudAll:
  print at 2,1, "SCORE:"
  print at 16,1, "HISCORE:"
  print at 2,3, "PASSES:"
  print at 16,3, "GOCARTS:"
  print at 2,5, "TIME:"
  print at 16,5, "MPH:"
  ShowHud
  return
end sub

sub ShowHud:
  HudDirty = 7
  HudPart
  HudPart
  HudPart
  return
end sub

' one group of HUD numbers a frame (bit 1 score, 2 passes/karts, 4 time/MPH)
sub HudPart:
  T = HudDirty & 1
  if T > 0 then
    HudDirty = HudDirty & 6
    NumU = ScoreHi
    print at 8,1, digits$(NumU, 2)
    NumU = Score
    print at 10,1, digits$(NumU, 4)
    NumU = HiHi
    print at 24,1, digits$(NumU, 2)
    NumU = Hi
    print at 26,1, digits$(NumU, 4)
    return
  end if
  T = HudDirty & 2
  if T > 0 then
    HudDirty = HudDirty & 5
    NumU = Passes
    print at 9,3, digits$(NumU, 2)
    NumU = Lives
    print at 24,3, digits$(NumU, 2)
    return
  end if
  T = HudDirty & 4
  if T > 0 then
    HudDirty = HudDirty & 3
    NumU = Time
    print at 7,5, digits$(NumU, 2)
    NumU = Mph
    print at 20,5, digits$(NumU, 2)
  end if
  return
end sub

' a crash [$14F5]: the kart breaks up, one gocart lost, the round restarts
sub CrashSeq:
  play sound SndCrash
  dec Lives
  Running = 0
  ShowHud
  Pshape = 10
  K = Hit + 1
  set sprite K pattern to 40
  copy vram.spr_pat + 320 count 32 to CrashBuf
  for CrashT = 0 to 140
    Frame1
    VramWork
    set sprite 0 pattern to 44
    set sprite K pattern to 44
    update sprites
    T = CrashT & 7
    if T = 0 then
      for Li = 0 to 31
        Rand
        V = Rs
        T = CrashBuf[Li]
        CrashBuf[Li] = T & V
      next
      copy CrashBuf count 32 to vram.spr_pat + 352
    end if
  next
  return
end sub

' time out [$1C6B]: 5 points per pass; 30 passes or more keep the kart
sub TimeoutSeq:
  Running = 0
  Keep = 0
  if Passes >= 30 then Keep = 1
  print at 4,6, "TIMEOUT  PASSING BONUS"
  if Keep = 1 then print at 2,7, "OVER 29 PASSES KEEP YOUR CAR"
  for Li = 0 to 30
    Frame1
  next
  while Passes > 0
    for Li = 0 to 4
      AddScore
    next
    dec Passes
    ShowHud
    play sound SndBonus
    for Li = 0 to 18
      Frame1
    next
  end while
  if Keep = 0 then
    dec Lives
    ShowHud
    play sound SndOver
  end if
  for Li = 0 to 60
    Frame1
  next
  return
end sub

sub GameOver:
  StopRace
  print at 11,7, "GAME OVER"
  play sound SndOver
  return
end sub

