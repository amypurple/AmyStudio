cartridge "THE LANGUAGE BARRIER/AN ORIGINAL TIMELOST GAME/2026"

' THE LANGUAGE BARRIER
' An original game for the Timelost series, imagined from "Timelost: A
' Computer Adventure" by Kris Austen Andrews, Arlan Keith Andrews Sr. and
' Joseph C. Giarratano (Que, 1983), pages 16-18: "while the time barrier
' seems to have been broken, the travellers are yet separated by a deeper
' division: the language barrier." The stranger's speech balloons are
' full of strange letters until his telepathic voice translator starts
' to work. The story and the characters belong to the authors; the book
' has no game for this scene.
'
' The idea: the book promises a game for each effect of the machine, so
' this one is a puzzle you solve as much by ear as by eye. Jacque speaks
' a phrase of glyphs; every glyph has its own note, and his phrase is
' played as a little tune. Build your guess one glyph at a time (each
' sounds its note as you pick it) and send it: under each glyph, green
' means right glyph, right place; yellow, the glyph is in the phrase
' elsewhere; grey, not in it. Crack the phrase and the translator prints
' what he said. Seven tries per phrase, three replays of his voice; fail
' three phrases and he gives up on you. Phrases grow longer and the
' alphabet larger as the translator learns, from three glyphs out of four
' to five glyphs out of eight, with repeats from the sixth phrase.
'
' ColecoVision game in Amy by Amy Bienvenu, 2026.
' Controls (either joystick): left and right pick a place in the guess;
' up and down change its glyph; left button sends the guess; right
' button replays Jacque's voice.
' Scoring: each phrase understood is worth (tries left x 100 + replays
' left x 50) x the phrase number.
' Everything that matters stays in columns 2-29, inside the TV overscan.
' The frame loop is protected from the NMI.

const PegGood = 160
const PegNear = 161
const PegNone = 162
const BalTL = 163
const BalT = 164
const BalTR = 165
const BalL = 166
const BalBL = 167
const BalBR = 168
const BalB = 169
const BalR = 170
const Tail = 171
const Note = 172
const Hidden = 173
const Dot = 174
const Tries = 7

const SndGlyph0 = 1
const SndGlyph1 = 2
const SndGlyph2 = 3
const SndGlyph3 = 4
const SndGlyph4 = 5
const SndGlyph5 = 6
const SndGlyph6 = 7
const SndGlyph7 = 8
const SndClick = 9
const SndSend = 10
const SndBuzz = 11
const SndGot = 12
const SndGiveUp = 13
const SndOver = 14
const SndGood = 15
const SndPick = 16
const SndTuneA = 17
const SndTuneB = 18

u16 Score = 0
u16 HighScore = 1000
u8 HighName[3]
u8 Phrase = 0                   ' phrases understood so far
u8 Mistakes = 0
u8 Len = 3
u8 LenM = 2
u8 Alpha = 4
u8 Secret[5]
u8 Guess[5]
u8 Mark[5]
u8 Used[5]
u8 Try = 0
u8 Slot = 0
u8 Replays = 3
u8 MoveT = 0
u8 Solved = 0
u8 Say = 0                      ' which of the translations
u8 Stick = 0
u8 Btn1 = 0
u8 Btn2 = 0
u8 Up = 0
u8 Dn = 0
u8 B1Was = 0
u8 B2Was = 0
u8 UdWas = 0
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tm = 0
u8 Choice = 1
u16 Dst16 = 0
u16 W16 = 0
u16 NumU = 0
u16 ZPtr = 0

  tile screen
  set sound table TalkSoundTable areas 4
  sprites 16x16
  copy SpritePat count 160 to vram.spr_pat
  HideSprites
  LoadTiles
  HighName[0] = 84
  HighName[1] = 76
  HighName[2] = 83
  screen on
  EditorialPage

title:
  TitlePage

new_game:
  Score = 0
  Phrase = 0
  Mistakes = 0
  Say = 0

new_phrase:
  nmi off
  ' The translator learns: longer phrases, more glyphs
  Len = Phrase / 3
  Len += 3
  if Len > 5 then Len = 5
  LenM = Len - 1
  Alpha = Phrase / 2
  Alpha += 4
  if Alpha > 8 then Alpha = 8
  ' Jacque's phrase (repeats allowed from the sixth phrase)
  for I = 0 to 4
    Secret[I] = 255
  next
  for I = 0 to LenM
pick:
    N = Alpha - 1
    V = random(0, N)
    if Phrase < 5 then
      for J = 0 to 4
        if Secret[J] = V then goto pick
      next
    end if
    Secret[I] = V
  next
  for I = 0 to 4
    Guess[I] = 0
  next
  Try = 0
  Slot = 0
  Replays = 3
  Solved = 0
  DrawBoard
  Rearm
  wait 30 frames
  nmi off
  SpeakSecret
  DrawGuess

main_loop:
  nmi on
  wait
  nmi off
  ReadStick
  ' Left and right: the place in the guess
  if MoveT > 0 then dec MoveT
  if MoveT = 0 then
    if Stick = 1 then
      if Slot > 0 then
        dec Slot
        MoveT = 10
      end if
    end if
    if Stick = 2 then
      N = Len - 1
      if Slot < N then
        inc Slot
        MoveT = 10
      end if
    end if
  end if
  ' Up and down: its glyph, sounding its note
  N = Up + Dn
  if N > 0 then
    if UdWas = 0 then
      V = Guess[Slot]
      if Up = 1 then
        inc V
        if V >= Alpha then V = 0
      else
        if V = 0 then
          V = Alpha - 1
        else
          dec V
        end if
      end if
      Guess[Slot] = V
      DrawGuess
      V = Guess[Slot]
      PlayGlyph
    end if
  end if
  UdWas = N
  ' Right button: hear Jacque again
  if Btn2 = 1 then
    if B2Was = 0 then
      if Replays > 0 then
        dec Replays
        ShowFoot
        SpeakSecret
      end if
    end if
  end if
  B2Was = Btn2
  ' Left button: send the guess
  if Btn1 = 1 then
    if B1Was = 0 then Transmit
  end if
  B1Was = Btn1
  DrawCursor
  if Solved = 1 then goto understood
  if Try >= Tries then goto not_understood
  goto main_loop

  ' --- The translator understands ---
understood:
  HideSprites
  play sound SndGot
  Translate
  W16 = Tries - Try
  W16 *= 100
  NumU = Replays
  NumU *= 50
  W16 += NumU
  NumU = Phrase + 1
  W16 *= NumU
  Score += W16
  inc Phrase
  inc Say
  if Say >= 12 then Say = 0
  ShowHead
  Rearm
  wait 90 frames
  wait no fire
  pause until press
  wait no fire
  nmi off
  goto new_phrase

  ' --- Seven tries and no luck ---
not_understood:
  HideSprites
  play sound SndBuzz
  ' Show what he said
  Y = 2
  for I = 0 to LenM
    X = I * 3
    X += 7
    V = Secret[I]
    DrawGlyph
  next
  inc Mistakes
  ShowFoot
  inc Say
  if Say >= 12 then Say = 0
  if Mistakes >= 3 then goto gave_up
  Rearm
  wait 90 frames
  wait no fire
  pause until press
  wait no fire
  nmi off
  goto new_phrase

gave_up:
  play sound SndGiveUp
  print at 7,21, "JACQUE GIVES UP..."
  Rearm
  wait 60 frames
  nmi off
  play sound SndOver
  Rearm
  wait 90 frames
  nmi off
  if Score > HighScore then
    HighScore = Score
    fill 32 count 20 at 7,21
    print at 7,21, "NEW HIGH SCORE!"
    play sound SndGood
    Rearm
    wait 60 frames
    nmi off
    EnterName
  end if
  ShowHead
  cls
  ShowHead
  print at 9,10, "ANOTHER TALK"
  print at 9,11, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,10 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------

' Re-arm the VDP interrupt before waiting: "nmi on" reads the VDP status,
' so a frame interrupt lost to the guard race cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub ReadStick:
  Stick = 0
  Btn1 = 0
  Btn2 = 0
  Up = 0
  Dn = 0
  if joypad(1).left then Stick = 1
  if joypad(2).left then Stick = 1
  if joypad(1).right then Stick = 2
  if joypad(2).right then Stick = 2
  if joypad(1).up then Up = 1
  if joypad(2).up then Up = 1
  if joypad(1).down then Dn = 1
  if joypad(2).down then Dn = 1
  if joypad(1).button1 then Btn1 = 1
  if joypad(2).button1 then Btn1 = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  return
end sub

' Jacque speaks: his phrase as a little tune, his face lit while he talks
sub SpeakSecret:
  for I = 0 to LenM
    V = Secret[I]
    PlayGlyph
    set sprite 3 to 16,16,16,11
    update sprites from 0 count 5
    Rearm
    wait 9 frames
    nmi off
    set sprite 3 to 192,0,0,0
    update sprites from 0 count 5
    Rearm
    wait 6 frames
    nmi off
  next
  return
end sub

sub PlayGlyph:
  if V = 0 then play sound SndGlyph0
  if V = 1 then play sound SndGlyph1
  if V = 2 then play sound SndGlyph2
  if V = 3 then play sound SndGlyph3
  if V = 4 then play sound SndGlyph4
  if V = 5 then play sound SndGlyph5
  if V = 6 then play sound SndGlyph6
  if V = 7 then play sound SndGlyph7
  return
end sub

' Wordle-style marks: right place first, then elsewhere, counting repeats
sub Transmit:
  play sound SndSend
  for I = 0 to 4
    Mark[I] = 0
    Used[I] = 0
  next
  K = 0
  for I = 0 to LenM
    if Guess[I] = Secret[I] then
      Mark[I] = 2
      Used[I] = 1
      inc K
    end if
  next
  for I = 0 to LenM
    if Mark[I] = 0 then
      for J = 0 to LenM
        if Used[J] = 0 then
          if Guess[I] = Secret[J] then
            Mark[I] = 1
            Used[J] = 1
            goto marked
          end if
        end if
      next
marked:
    end if
  next
  ' Play the guess back, then show the marks one by one
  Y = Try * 2
  Y += 7
  for I = 0 to LenM
    V = Guess[I]
    PlayGlyph
    X = I + 24
    N = PegNone
    if Mark[I] = 1 then N = PegNear
    if Mark[I] = 2 then N = PegGood
    put char N at X,Y
    Rearm
    wait 12 frames
    nmi off
  next
  if K = Len then
    Solved = 1
    return
  end if
  play sound SndBuzz
  inc Try
  if Try < Tries then DrawGuess
  return
end sub

' The guess being built, on the board row of this try
sub DrawGuess:
  Y = Try * 2
  Y += 7
  for I = 0 to LenM
    X = I * 3
    X += 7
    V = Guess[I]
    DrawGlyph
  next
  return
end sub

' Glyph V at X,Y (two by two tiles)
sub DrawGlyph:
  N = V * 4
  N += 128
  put char N at X,Y
  inc N
  K = X + 1
  put char N at K,Y
  inc N
  P = Y + 1
  put char N at X,P
  inc N
  put char N at K,P
  return
end sub

sub DrawCursor:
  X = Slot * 24
  X += 56
  Y = Try * 16
  Y += 55
  set sprite 0 to Y,X,0,15
  update sprites from 0 count 5
  return
end sub

' The balloon, the board and the foot line
sub DrawBoard:
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  cls
  backdrop black
  ShowHead
  ' Jacque, three layers
  set sprite 1 to 16,16,4,14
  set sprite 2 to 16,16,8,6
  set sprite 4 to 16,16,12,11
  update sprites from 0 count 5
  ' His speech balloon, his phrase hidden
  put char BalTL at 5,1
  fill BalT count 23 at 6,1
  put char BalTR at 29,1
  for Y = 2 to 4
    put char BalL at 5,Y
    put char BalR at 29,Y
  next
  put char Tail at 4,3
  put char BalBL at 5,5
  fill BalB count 23 at 6,5
  put char BalBR at 29,5
  for I = 0 to LenM
    X = I * 3
    X += 7
    put char Hidden at X,2
    K = X + 1
    put char Hidden at K,2
    put char Hidden at X,3
    put char Hidden at K,3
  next
  ' The tries
  for I = 0 to 6
    Y = I * 2
    Y += 7
    N = I + 49
    put char N at 3,Y
    for J = 0 to LenM
      X = J * 3
      X += 7
      put char Dot at X,Y
      X = J + 24
      put char Dot at X,Y
    next
  next
  ShowFoot
  return
end sub

sub ShowHead:
  print at 2,0, "PHRASE"
  NumU = Phrase + 1
  print at 9,0, digits$(NumU, 2)
  print at 14,0, "SCORE"
  NumU = Score
  print at 20,0, digits$(NumU, 5)
  return
end sub

sub ShowFoot:
  put char Note at 2,22
  print at 3,22, "RIGHT BUTTON: HEAR"
  for J = 0 to 2
    X = J + 22
    N = 32
    if J < Replays then N = Note
    put char N at X,22
  next
  print at 2,23, "LEFT BUTTON: SEND"
  print at 20,23, "MISSES"
  N = 3 - Mistakes
  NumU = Mistakes
  print at 27,23, digits$(NumU, 1)
  return
end sub

' The translator prints what Jacque said, letter by letter
sub Translate:
  for Y = 2 to 4
    fill 32 count 23 at 6,Y
  next
  N = Say * 2
  ZPtr = Lines[N]
  Y = 2
  PrintSlow
  inc N
  ZPtr = Lines[N]
  Y = 3
  PrintSlow
  return
end sub

sub PrintSlow:
  X = 7
next_char:
  V = peek(ZPtr)
  if V = 0 then return
  put char V at X,Y
  inc X
  inc ZPtr
  if V <> 32 then play sound SndClick
  Rearm
  wait 3 frames
  nmi off
  goto next_char
end sub

sub EnterName:
  print at 6,13, "YOUR INITIALS:"
  print at 5,16, "UP/DOWN, FIRE: NEXT"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,13
  next
  X = I + 21
  fill 32 count 3 at 21,14
  put char 45 at X,14
  Rearm
  wait 8 frames
  nmi off
  ReadStick
  N = Btn1 + Btn2
  if N > 0 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then goto name_done
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  if Dn = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
name_done:
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 376 to vram.pattern + Dst16
    copy TileCol count 376 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 5
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites from 0 count 5
  return
end sub

sub TitlePage:
  nmi off
  HideSprites
  fill mode 2 text color with $F1
  LoadTiles
  cls
  backdrop black
  print at 6,1, "THE LANGUAGE BARRIER"
  for I = 0 to 7
    X = I * 3
    X += 4
    Y = 3
    V = I
    DrawGlyph
  next
  print at 2,6, "JACQUE SPEAKS THE TONGUE OF"
  print at 2,7, "THE 28TH CENTURY. EVERY"
  print at 2,8, "GLYPH HAS ITS OWN NOTE:"
  print at 2,9, "LISTEN, GUESS, AND LET THE"
  print at 2,10, "TRANSLATOR LEARN."
  put char PegGood at 2,12
  print at 4,12, "RIGHT GLYPH, RIGHT PLACE"
  put char PegNear at 2,13
  print at 4,13, "IN THE PHRASE, ELSEWHERE"
  put char PegNone at 2,14
  print at 4,14, "NOT IN THE PHRASE"
  print at 2,16, "STICK: PLACE AND GLYPH"
  print at 2,17, "LEFT BUTTON: SEND"
  print at 2,18, "RIGHT BUTTON: HEAR AGAIN"
  print at 4,20, "HIGH"
  NumU = HighScore
  print at 9,20, digits$(NumU, 5)
  for J = 0 to 2
    X = J + 15
    N = HighName[J]
    put char N at X,20
  next
  print at 6,22, "PRESS FIRE TO BEGIN"
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  return
end sub

sub EditorialPage:
  nmi off
  HideSprites
  fill mode 2 text color with $10
  LoadTiles
  backdrop white
  cls
  print at 6,1, "THE LANGUAGE BARRIER"
  print at 2,3, "AN ORIGINAL GAME FOR THE"
  print at 2,4, "TIMELOST SERIES BY KRIS"
  print at 2,5, "AUSTEN ANDREWS, ARLAN KEITH"
  print at 2,6, "ANDREWS SR. AND JOSEPH C."
  print at 2,7, "GIARRATANO (QUE, 1983)."
  print at 2,9, "PAGE 16: THE TRAVELLERS ARE"
  print at 2,10, "SEPARATED BY A DEEPER"
  print at 2,11, "DIVISION: THE LANGUAGE"
  print at 2,12, "BARRIER."
  print at 2,14, "THE BOOK HAS NO GAME FOR"
  print at 2,15, "THIS SCENE: HERE IS ONE, A"
  print at 2,16, "PUZZLE FOR EARS AND EYES."
  print at 2,17, "BY AMY BIENVENU, 2026."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' What the translator makes of Jacque's phrases (two lines each, written
' for this game)
data Lines words = @Say0a, @Say0b, @Say1a, @Say1b, @Say2a, @Say2b, @Say3a, @Say3b, @Say4a, @Say4b, @Say5a, @Say5b, @Say6a, @Say6b, @Say7a, @Say7b, @Say8a, @Say8b, @Say9a, @Say9b, @Say10a, @Say10b, @Say11a, @Say11b
data Say0a bytes = 73, 32, 77, 69, 65, 78, 32, 89, 79, 85, 32, 78, 79, 32, 72, 65, 82, 77, 46, 0
data Say0b bytes = 68, 79, 78, 39, 84, 32, 66, 69, 32, 83, 67, 65, 82, 69, 68, 46, 0
data Say1a bytes = 67, 65, 76, 76, 32, 77, 69, 32, 74, 65, 67, 81, 85, 69, 46, 0
data Say1b bytes = 73, 32, 65, 77, 32, 65, 32, 84, 82, 65, 86, 69, 76, 76, 69, 82, 46, 0
data Say2a bytes = 87, 69, 32, 65, 82, 69, 32, 67, 65, 85, 71, 72, 84, 32, 73, 78, 0
data Say2b bytes = 65, 32, 75, 73, 78, 68, 32, 79, 70, 32, 84, 73, 77, 69, 32, 87, 65, 82, 80, 46, 0
data Say3a bytes = 73, 32, 67, 79, 77, 69, 32, 70, 82, 79, 77, 32, 84, 72, 69, 0
data Say3b bytes = 84, 87, 69, 78, 84, 89, 45, 69, 73, 71, 72, 84, 72, 32, 67, 69, 78, 84, 85, 82, 89, 46, 0
data Say4a bytes = 87, 69, 32, 87, 65, 73, 84, 32, 72, 69, 82, 69, 32, 85, 78, 84, 73, 76, 0
data Say4b bytes = 65, 78, 79, 84, 72, 69, 82, 32, 87, 65, 82, 80, 32, 67, 79, 77, 69, 83, 46, 0
data Say5a bytes = 83, 84, 65, 89, 32, 67, 76, 79, 83, 69, 32, 84, 79, 32, 77, 69, 44, 0
data Say5b bytes = 66, 79, 84, 72, 32, 79, 70, 32, 89, 79, 85, 46, 0
data Say6a bytes = 77, 89, 32, 72, 69, 76, 77, 69, 84, 32, 72, 69, 65, 82, 83, 0
data Say6b bytes = 83, 84, 82, 65, 78, 71, 69, 32, 69, 78, 69, 82, 71, 89, 46, 0
data Say7a bytes = 83, 79, 77, 69, 84, 72, 73, 78, 71, 32, 77, 79, 86, 69, 83, 0
