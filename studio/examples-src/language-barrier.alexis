data Say8a bytes = 68, 85, 67, 75, 32, 73, 78, 84, 79, 32, 84, 72, 69, 32, 87, 69, 69, 68, 83, 0
data Say8b bytes = 65, 78, 68, 32, 75, 69, 69, 80, 32, 87, 65, 84, 67, 72, 46, 0
