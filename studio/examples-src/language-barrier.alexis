  $00,$08,$08,$0F,$00,$00,$0F,$08,$00,$10,$10,$F0,$10,$10,$F0,$00
  $08,$0F,$00,$00,$1F,$00,$00,$00,$00,$F0,$10,$10,$F0,$00,$00,$00
  $00,$03,$04,$09,$0A,$04,$03,$00,$00,$C0,$20,$90,$50,$20,$C0,$80
  $00,$0F,$00,$02,$04,$00,$00,$00,$80,$E0,$80,$A0,$90,$00,$00,$00
  $00,$30,$18,$0C,$06,$03,$03,$06,$00,$0C,$18,$30,$60,$C0,$C0,$60
