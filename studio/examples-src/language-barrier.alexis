data Say9b bytes = 76, 73, 75, 69, 32, 83, 84, 82, 65, 78, 71, 69, 82, 83, 46, 0
data Say10a bytes = 72, 85, 82, 82, 89, 33, 32, 71, 82, 65, 66, 32, 84, 72, 69, 32, 71, 73, 82, 76, 0
data Say10b bytes = 65, 78, 68, 32, 82, 85, 78, 33, 0
