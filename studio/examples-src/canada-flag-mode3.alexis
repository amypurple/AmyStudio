'cartridge "CANADA FLAG/AMY STUDIO/2026"

const Red = 6
const White = 15

u8 Row = 0
u8 LeftX = 0
u8 RightX = 0
u8 Y = 0, X = 0
u8 HalfWidth = 0

' Stylized Canadian flag for ColecoVision Mode 3.
' The leaf is simplified to survive the 64x48 multicolor pixel grid.
  multicolor screen
  cls

  ' CRT-safe two-pixel left padding.
  box 2,5 to 16,41 color Red
  box 17,5 to 48,41 color White
  box 49,5 to 63,41 color Red

  ' Maple leaf silhouette, drawn as horizontal red spans.
  restore LeafRows
  for Y = 11 to 32
NextXHalfWidth:
    read X
    read HalfWidth
    LeftX = 33 - X
    RightX = 32 - X + HalfWidth
    box LeftX,Y to RightX,Y color Red
    LeftX = 33 + X - HalfWidth
    RightX = 32 + X
    box LeftX,Y to RightX,Y color Red
    if X >= HalfWidth goto NextXHalfWidth
  next

  ' Stem.
  box 32,33 to 33,37 color Red

  screen on
  loop forever

data LeafRows bytes
  0,1
  0,1
  1,2
  4,1,2,3
  4,2,2,3
  4,5
  3,4
  6,1,3,4
  11,2,7,2,3,4
  10,6,2,3
  10,11
  10,11
  9,10
  11,12
  10,11
  9,10
  8,9
  7,8
  6,7
  5,6
  4,5
  5,3,0,1
  6,2,0,1
end data