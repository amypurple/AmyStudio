data TileCol bytes
  $41,$01,$01,$01,$01,$01,$01,$01
  $EF,$FE,$FE,$FE,$FE,$FE,$FE,$0E
  $01,$81,$81,$1E,$0E,$0E,$1E,$01
  $01,$E1,$1E,$1E,$0E,$1E,$1E,$01
