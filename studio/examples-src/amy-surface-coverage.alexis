' §1 Declarations
cartridge "AMY SURFACE COVERAGE/AMY/2026"

const TileBase = $00
const MaxItems = 8
const SafeUnsignedLimit = 10
const SafeSignedLimit = 10

enum Dir:
  Up = 0
  Down = 1
  Left = 2
  Right = 3
end enum

record Pos:
  u8 X
  u8 Y
end record

u8 A = 0, B = 0
u8 X1 = 10, X2 = 250
i8 SX1 = -128, SX2 = 127
u8 Gap = 0
i8 Delta = -1
u16 Score16 = 0
u16 Distance = 0
u16 SignedGap = 0
i16 Vel = 0
bool Flag = false
u8 HexText[14] = 0
bcd digits 6 Score
fixed Fx = 0.0
ufixed Ufx = 0.0
ufixed OneFromHex = $0001
ufixed OneLsb = raw $0001
u32 Counter32
Pos Cursor
u8 Row[9] = 0

data TestData bytes 1,2,3,4,5

' §2 Screen / graphics
  text screen
  screen on
  goto main

main:
' §3 Text output
  print "COVERAGE" at 1,0
  print centered at 3, "CENTERED"
  print A at 1,1 digits 3
  print Score16 at 6,1 digits 5
  print hex Fx at 1,4
  format hex Fx into HexText
  print hex OneFromHex at 1,5
  print hex OneLsb at 1,6
  print at 1,2, Score
  put char $41 at 0,8
  A = get char at 0,8
  fill $20 count 10 at 5,8
  Row = get frame size 3,3 at 0,8
  replace $41 with $20 in Row frame size 3,3 into A
  put Row frame size 3,3 at 0,8

' §4 Sprites
  sprites 8x8
  set sprite count 2
  set sprite 0 to 100,80,0,15
  set sprite 0 pattern bit 1 on
  toggle sprite 0 pattern bit 0
  set sprite 1 tile 10,12 pattern 0 color 15 offset -4,-8
  hide sprite 1
  clear sprites from 1 count 1
  update sprites from 0 count 2
  clear sprites
  update sprites

' §5 Input
  A = joypad(1)
  if button 1 on A goto SkipFire
SkipFire:
  if joypad(1).button1 then
    inc A
  end if
  wait

' §6 Control flow
  if A > 0 then
    A = 1
  elseif A == 0 then
    A = 0
  else
    A = 2
  end if

  select case A
  case 0
    A = 1
  case 1 to 3
    A = 2
  case else
    A = 0
  end select

  for B = 0 to 7
    put char B at B,3
  next

  while A > 0
    dec A
  end while

  do
    inc A
  loop while A < 5

' §7 Arithmetic
  A += 1
  A -= 1
  A *= 2
  A /= 2
  inc A
  dec A
  clear A
  Score16 += 100
  Score16 -= 50
  A <<= 1
  A >>= 1
  toggle Flag
  bounce A by Delta between 0 and 31
  A = min(A, 255)
  A = max(A, 0)
  Gap = absdiff(X1, X2)
  Gap = absdiff(X1, SafeUnsignedLimit)
  Distance = abs(X1 - X2)
  SignedGap = absdiff(SX1, SX2)
  SignedGap = absdiff(SX1, SafeSignedLimit)
  clamp A between 0 and 31
  Score += 10
  Score -= 5
  clear Counter32
  inc Counter32
  Counter32 += 1

' §8 Sound
  mute all
  sound runtime on
  sound runtime off

  goto main

' §9 Screen toggles (dead sub — all forms reachable by compiler)
sub ScreenForms:
  text screen
  bitmap screen
  cls
  bitmap screen color $F1
  picture screen
  cls
  multicolor screen
  cls
  screen off
  display off
  display on
  nmi off
  nmi on
  wipe screen up
  wipe screen down
  wipe bitmap up
  wipe bitmap down
  screen on
end sub

' §10 Subs and functions
sub PrintHelp:
  print "HELP" at 1,0
end sub

function GetZero as u8
  return 0
