u8 Y = 0

  tile screen
  ' each third of the screen gets its own colour table (the ground rows
  ' need their own colours)
  call asm ArThirds
  set sound table ArSoundTable areas 4
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

  ' a new game
  Stage = 0
  Score = 0
  Gates = 0

stage_start:
  NewStage
  SlopeScreen
  StageIntro
  Mode = 1

run:
  ' a steady 30 passes a second: never sooner than two frames
  ' (ArLate: has the screen started a new frame while this pass worked?)
  call asm ArLate
  if Late = 0 then Frame1
  Frame1
  inc Passes
  update sprites
  Stripes
  Edges
  Mountains
  ' the HUD, one line a pass, every few passes
  inc HudT
  if HudT = 3 then HudTop
  if HudT >= 6 then
    HudT = 0
    HudLow
  end if
  ReadPad
  Ride
  Objects
  Avalanche
  Skis
  if Done = 1 then goto stage_clear
  if Done = 2 then goto buried
  goto run

stage_clear:
  Mode = 0
  mute all
  Rumble = 0
  play sound SndVillage
  ' the bonus: what is left of the avalanche's gap
  Uw = Gap
  Uw = Uw >> 4
  Score = Score + Uw
  Hud
  ClearSky
  ' a firework for every gate skied on this stage (five more at the end)
  Fn = Gates - GatesAt
  if Stage = 2 then Fn = Fn + 5
  if Fn > 20 then Fn = 20
  Fireworks
  inc Stage
  if Stage = 3 then goto won
  print at 3,3, "VILLAGE WARNED!  BONUS"
  NumU = Uw
  print at 25,3, width$(NumU, 4)
  print at 3,4, "ON TO THE NEXT ONE..."
  Pause
  Pause
  goto stage_start

won:
  print at 3,3, "THE LAST VILLAGE IS SAFE:"
  print at 3,4, "ALL ARE SHELTERED IN TIME!"
  Pause
  Pause
  goto final

buried:
  Mode = 0
  mute all
  Rumble = 0
  play sound SndBuried
  Whiteout
  fill $1F count 1024 to vram.color + 2048
  print at 7,10, "BURIED BY THE"
  print at 7,11, "AVALANCHE!"
  Pause
  Pause

final:
  if Score > Best then Best = Score
  ' the results: in the sky, or on the snow that buried you
  if Done = 2 then
    Y = 13
  else
    ClearSky
    Y = 3
  end if
  print at 4,Y, "SCORE"
  NumU = Score
  print at 10,Y, width$(NumU, 5)
  print at 17,Y, "BEST"
  NumU = Best
  print at 22,Y, width$(NumU, 5)
  inc Y
  print at 4,Y, "PRESS A BUTTON"
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
end_wait:
  Frame1
  ReadPad
  if Press = 0 then goto end_wait
  goto title

' ---------------------------------------------------------------------------
' The run

sub NewStage:
  GatesAt = Gates
  AvS = StageAv[Stage]
  V = StageW[Stage]
  Wd = V
  WidthRows
  Px = 0
  Cq = 0
  CqTo = 0
  Hs = 0
  Spd = 6
  Gap = 2400
  Dist = 0
  DSub = 0
  SpawnAcc = 0
  CurveAcc = 0
  ChaletOut = 0
  Done = 0
  Cr = 0
  Pose = 0
  Forest = 0
  Rumble = 0
  StLen = 2400
  if Stage = 1 then StLen = 2800
  if Stage = 2 then StLen = 3200
  for Oi = 0 to 3
    OKind[Oi] = 0
  next
  return
end sub

' Ride: the player's speed, steering, the curve's pull and the distance
sub Ride:
  Pose = 0
  if Cr > 0 then
    ' fallen: up again after a while
    dec Cr
    Spd = 0
    Pose = 3
    if Cr = 0 then Spd = 4
    goto ride_move
  end if
  Tgt = 18
  if Up1 = 1 then Tgt = 26
  if Dn1 = 1 then Tgt = 6
  ' in the forest: deep snow, and the trees are close
  Forest = 0
  Tw = Px
  if Tw < 0 then Tw = 0 - Tw
  if Tw > Wd then
    Forest = 1
    if Tgt > 8 then Tgt = 8
    Rnd
    if Rb < 4 then
      if Spd > 4 then
        Why = 2
        Fall
        return
      end if
    end if
  end if
  if Spd < Tgt then
    V = Passes & 1
    if V = 0 then inc Spd
  else
    if Spd > Tgt then
      dec Spd
    end if
  end if
  ' steering, quicker at speed
  Uw = Spd >> 3
  Tw = Uw
  Tw = Tw + 1
  if Lf1 = 1 then
    Px = Px - Tw
    Pose = 1
  end if
  if Rt1 = 1 then
    Px = Px + Tw
    Pose = 2
  end if
  ' the skis bite as a turn begins
  if Pose > 0 then
    if Pose <> OldPose then
      ' a whoosh of snow (on the noise channel: the rumble waits)
      play sound SndSwish
      Whoosh = 12
      Rumble = 0
    end if
  end if
  OldPose = Pose
  ' the curve pulls you to its outside
  Drift = Spd
  Mx = Drift
  My = Cq
  call asm ArMul
  Drift = Mz
  Drift = Drift / 512
  Px = Px - Drift
  Tw = Wd + 60
  if Px > Tw then
    Px = Tw
  else
    Tw = 0 - Tw
    if Px < Tw then Px = Tw
  end if
ride_move:
  Pos = Pos + Spd
  DSub = DSub + Spd
  Uw = DSub >> 4
  DSub = DSub & 15
  Dist = Dist + Uw
  SpawnAcc = SpawnAcc + Uw
  CurveAcc = CurveAcc + Uw
  ' the horizon turns with the curve
  Tw = Spd
  Mx = Tw
  My = Cq
  call asm ArMul
  Tw = Mz
  Tw = Tw / 32
  Hs = Hs + Tw
  ' a new bend every 200 metres; the piste eases into it
  if CurveAcc >= 200 then
    CurveAcc = 0
    Rnd
    V = StageCurve[Stage]
    Uw = Rb
    W = V << 1
    Mx = Uw
    My = W
    call asm ArMul
    Uw = Mz
    Uw = Uw >> 8
    CqTo = Uw
    Tw = V
    CqTo = CqTo - Tw
    Rnd
    if Rb < 70 then CqTo = 0
  end if
  V = Passes & 1
  if V = 0 then
    if Cq < CqTo then
      inc Cq
    else
      if Cq > CqTo then dec Cq
    end if
  end if
  return
end sub

sub Fall:
  play sound SndCrash
  Rumble = 0
  Cr = 60
  Spd = 0
  return
end sub

' Avalanche: it runs at its own steady speed; the gap is what you keep
sub Avalanche:
  Tw = Spd
  Gap = Gap + Tw
  Tw = AvS
  Gap = Gap - Tw
  if Gap > 3200 then Gap = 3200
  if Gap <= 0 then
    Gap = 0
    Done = 2
    return
  end if
  if Whoosh > 0 then
    dec Whoosh
    return
  end if
  ' one long rumble, louder as it comes
  W = 1
  if Gap < 2000 then W = 2
  if Gap < 900 then W = 3
  if W <> Rumble then
    Rumble = W
    RumbleT = 0
    if W = 1 then play sound SndRumbleFar
    if W = 2 then play sound SndRumbleNear
    if W = 3 then play sound SndRumbleHere
    return
  end if
  inc RumbleT
  if RumbleT >= 110 then
    RumbleT = 0
    if W = 1 then play sound SndRumbleFar
    if W = 2 then play sound SndRumbleNear
    if W = 3 then play sound SndRumbleHere
  end if
  return
end sub

' Objects: move them toward the player, test what is passed, place the
' sprites, and bring new ones over the brow
sub Objects:
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok > 0 then
      Oz0 = OZ[Oi]
      if Oz0 > Spd then
        Oz1 = Oz0 - Spd
      else
        Oz1 = 0
      end if
      OZ[Oi] = Oz1
      ' passing the ski tips (depth 7)
      if Oz0 >= 112 then
        if Oz1 < 112 then Pass
      end if
      if Oz1 < 80 then
        OKind[Oi] = 0
        Ok = 0
      end if
    end if
  next
  ProjectAll
  ' a new object every so often
  V = StageGap[Stage]
  Uw = V
  if SpawnAcc >= Uw then
    SpawnAcc = 0
    Spawn
  end if
  return
end sub

' Pass: object Oi reaches the skis
sub Pass:
  Tw = OX[Oi]
  Tw = Tw - Px
  if Ok = KFlagL then
    ' the gate: between this flag and its pair, 40 to the right
    if Tw < 0 then
      Tw = 0 - Tw
      if Tw < 40 then
        play sound SndGate
        inc Gates
        Score = Score + 100
        Spd = Spd + 4
        return
      end if
    end if
    play sound SndMiss
    inc Missed
    return
  end if
  if Ok = KFlagR then return
  ' the village: the end of the stage
  if Ok = KChalet then
    Done = 1
    return
  end if
  if Cr > 0 then return
  if Tw < 0 then Tw = 0 - Tw
  if Tw < 10 then
    Why = 1
    Fall
  end if
  return
end sub

' ProjectAll: the four objects' sprites (2-5), placed by ArProject from
' their depth and place, the player's place and the curve
sub ProjectAll:
  call asm ArProject
  for Oi = 0 to 3
    Sp = Oi + 2
    Yv = SprY[Oi]
    Xb = SprX[Oi]
    Pt = SprP[Oi]
    Pc = SprC[Oi]
    set sprite Sp to Yv, Xb, Pt, Pc
  next
  return
end sub

' Spawn: something new at depth 80, as far as the eye can see
sub Spawn:
  ' how many free places
  Free = 0
  Oslot = 255
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok = 0 then
      inc Free
      Oslot = Oi
    end if
  next
  if Free = 0 then return
  Oi = Oslot
  ' near the end, only the village's chalet comes
  Uw = StLen - 60
  if Dist >= Uw then
    ' the village
    if ChaletOut = 0 then
      ChaletOut = 1
      OKind[Oi] = KChalet
      OCol[Oi] = 6
      OZ[Oi] = 1280
      OX[Oi] = 0
    end if
    return
  end if
  ChaletOut = 0
  Rnd
  Ty = Rb & 15
  if Ty >= 10 then
    if Free >= 2 then goto sp_gate
    Ty = 0
  end if
  if Ty <= 3 then
    ' a pine just off the piste
    Rnd
    Tw = Rb & 31
    Tw = Tw + Wd
    Tw = Tw + 6
    V = Rb & 128
    if V > 0 then Tw = 0 - Tw
    OKind[Oi] = KTree
    OCol[Oi] = 12
    OZ[Oi] = 1280
    OX[Oi] = Tw
    return
  end if
  ' a pine or a rock on the piste
  Ok = KTree
  if Ty >= 7 then Ok = KRock
  Lateral
  OKind[Oi] = Ok
  V = KindCol[Ok]
  OCol[Oi] = V
  OZ[Oi] = 1280
  OX[Oi] = Tw
  return
sp_gate:
  ' a gate: two flags 40 apart, the pair inside the piste
  Lateral
  if Tw > 0 then Tw = Tw - 30
  Tw = Tw / 2
  Gcol = Gcol ^ 1
  Pc = 8
  if Gcol = 1 then Pc = 4
  OKind[Oi] = KFlagL
  OCol[Oi] = Pc
  OZ[Oi] = 1280
  OX[Oi] = Tw
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok = 0 then
      OKind[Oi] = KFlagR
      OCol[Oi] = Pc
      OZ[Oi] = 1280
      Tw = Tw + 40
      OX[Oi] = Tw
      return
    end if
  next
  return
end sub

' Lateral: Tw = a random place on the piste, 10 in from either edge
sub Lateral:
  Rnd
  Tw = Wd << 1
  Tw = Tw - 20
  Uw = Tw
  NumU = Rb
  Mx = Uw
  My = NumU
  call asm ArMul
  Uw = Mz
  Uw = Uw >> 8
  Tw = Uw
  Tw = Tw - Wd
  Tw = Tw + 10
  return
end sub

' Fireworks: Fn rockets over the village, up to four in the air at once;
' each rises with a whistle and bursts in its own colour with a crackle,
' lighting up the sky
sub Fireworks:
  for Oi = 0 to 3
    FwT[Oi] = 0
    Sp = Oi + 2
    set sprite Sp to 192, 0, 0, 0
  next
  FwWait = 0
fw_frame:
  Frame1
  ' a new rocket every 14 frames
  if FwWait > 0 then dec FwWait
  if Fn > 0 then
    if FwWait = 0 then
      for Oi = 0 to 3
        V = FwT[Oi]
        if V = 0 then
          if FwWait = 0 then
            FwT[Oi] = 1
            Rnd
            V = Rb >> 1
            V = V + 48
            FwX[Oi] = V
            FwY[Oi] = 150
            Rnd
            V = Rb & 15
            V = V + 36
            FwTop[Oi] = V
            V = Rb & 7
            W = FwCols[V]
            FwC[Oi] = W
            play sound SndLaunch
            FwWait = 14
            dec Fn
          end if
        end if
      next
    end if
  end if
  FwBusy = 0
  for Oi = 0 to 3
    Sp = Oi + 2
    V = FwT[Oi]
    if V > 0 then
      FwBusy = 1
      if V < 100 then
        ' rising
        Y = FwY[Oi]
        Y = Y - 5
        FwY[Oi] = Y
        W = FwTop[Oi]
        if Y <= W then
          FwT[Oi] = 100
          play sound SndPop
          ' the sky lights up
          Flash = 3
          V = FwC[Oi]
          call asm ArBackdrop
        end if
        X = FwX[Oi]
        set sprite Sp to Y, X, SRocket, 11
      else
        ' bursting: four sizes, five frames each, then gone
        inc V
        FwT[Oi] = V
        W = V - 100
        W = W / 5
        if W >= 4 then
          FwT[Oi] = 0
          set sprite Sp to 192, 0, 0, 0
        else
          Pt = W << 2
          Pt = Pt + SBurst0
          Y = FwY[Oi]
          Y = Y - 16
          X = FwX[Oi]
          X = X - 16
          Pc = FwC[Oi]
          ' the last sparks twinkle
          if W = 3 then
            K = V & 2
            if K = 0 then Pc = 15
          end if
          set sprite Sp to Y, X, Pt, Pc
        end if
      end if
    end if
  next
  if Flash > 0 then
    dec Flash
    if Flash = 0 then backdrop light blue
  end if
  update sprites
  if Fn > 0 then goto fw_frame
  if FwBusy = 1 then goto fw_frame
  return
end sub

' Skis: the two ski tips at the bottom of the screen
sub Skis:
  Sk = SSkia
  if Pose = 1 then Sk = SSkila
  if Pose = 2 then Sk = SSkira
  if Pose = 3 then Sk = SSkixa
  V = Sk + 4
  if Pose = 3 then
    set sprite 0 to 167, 112, Sk, 8
    set sprite 1 to 167, 112, V, 8
  else
    set sprite 0 to 167, 96, Sk, 8
    set sprite 1 to 167, 128, V, 8
  end if
  return
end sub

' ---------------------------------------------------------------------------
' The picture

' Stripes, Edges: the ground, drawn by the Z80 routines at the end (see
' the header); Amy's version of them took several frames
sub Stripes:
  call asm ArStripes
  return
end sub

' StripesAll: every row again (a new screen)
sub StripesAll:
  fill array Cache with 0
  StAll = 1
  call asm ArStripes
  StAll = 0
  return
end sub

sub Edges:
  ' nothing moved, nothing to draw
  if Px = EPx then
    if Cq = ECq then return
  end if
  EPx = Px
  ECq = Cq
  call asm ArEdges
  return
end sub

' WidthRows: the piste's half width in pixels on each ground row
sub WidthRows:
  for Rk = 0 to 15
    V = InvRow[Rk]
    Mx = Wd
    My = V
    call asm ArMul
    Xw = Mz / 64
    V = Xw
    WdR[Rk] = V
  next
  return
end sub

' Mountains: the range on the horizon, turned with the curves
sub Mountains:
  Tw = Hs >> 9
  Tw = Tw & 15
  V = Tw
  if V = Mo then return
  Mo = V
  copy MtnRow0 + Mo count 32 to vram.name + 160
  copy MtnRow1 + Mo count 32 to vram.name + 192
  copy MtnRow2 + Mo count 32 to vram.name + 224
  return
end sub

sub Hud:
  HudTop
  HudLow
  return
end sub

sub HudTop:
  print at 2,1, "STAGE"
  V = Stage + 1
  NumU = V
  print at 8,1, digits$(NumU, 1)
  print at 11,1, "GATES"
  NumU = Gates
  print at 17,1, width$(NumU, 3)
  put char THouse at 21,1
  Uw = 0
  if StLen > Dist then Uw = StLen - Dist
  NumU = Uw
  print at 22,1, width$(NumU, 4)
  print at 26,1, "M"
  return
end sub

sub HudLow:
  print at 2,2, "SPEED"
  Uw = Spd << 2
  NumU = Uw
  print at 8,2, width$(NumU, 3)
  print at 13,2, "AVALANCHE"
  ' eight boxes: how far behind it is
  Tw = Gap / 400
  V = Tw
  for X = 0 to 7
    W = TBarnone
    if X < V then
      W = TBarfull
      if V <= 2 then W = TBarhot
    end if
    Y = X + 22
    put char W at Y,2
  next
  return
end sub

' Whiteout: the snow comes down over everything
sub Whiteout:
  HideSprites
  for Y = 1 to 22
    fill TWhite count 32 at 0,Y
    Frame1
    Frame1
  next
  return
end sub

sub ClearSky:
  for Y = 3 to 4
    fill 32 count 32 at 0,Y
  next
  return
end sub

sub Clouds:
  put char TCloud00 at 3,4
  put char TCloud01 at 4,4
  put char TCloud02 at 5,4
  put char TCloud00 at 23,3
  put char TCloud01 at 24,3
  put char TCloud02 at 25,3
  return
end sub

' SlopeScreen: the sky, the range, the piste, the HUD
sub SlopeScreen:
  NewScreen
  ClearSky
  Clouds
  Mo = 255
  ' row 8: the brow of the slope
  fill TBrow count 32 at 0,8
  for Rk = 0 to 15
    LhOld[Rk] = 255
    RhOld[Rk] = 255
  next
  EPx = 9999
  Mountains
  StripesAll
  Edges
  Hud
  Skis
  ProjectAll
  update sprites
  ShowScreen
  return
end sub

sub StageIntro:
  ClearSky
  print at 3,3, "STAGE"
  V = Stage + 1
  NumU = V
  print at 9,3, digits$(NumU, 1)
  if Stage = 0 then print at 11,3, "PINE RIDGE"
  if Stage = 1 then print at 11,3, "DEVIL'S GULLY"
  if Stage = 2 then print at 11,3, "THE GLACIER"
  print at 3,4, "THE SNOW BREAKS ABOVE YOU!"
  play sound SndRumbleNear
  Pause
  print at 3,4, "         GO!              "
  Pause
  ClearSky
  Clouds
  Rumble = 0
  return
end sub

' ---------------------------------------------------------------------------
' Helpers

' Rnd: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 60
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Gnd1Pat count 256 to vram.pattern + 3712
  copy Gnd2Pat count 256 to vram.pattern + 5760
  backdrop light blue
  cls
  return
end sub

' PageScreen: a page of text, white on dark blue
sub PageScreen:
  NewScreen
  backdrop dark blue
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewStage
  Px = 0
  Cq = 0
  SlopeScreen
  fill 32 count 32 at 0,1
  fill 32 count 32 at 0,2
  ClearSky
  print at 9,1, "AVALANCHE RUN"
  print at 11,2, "START"
  print at 11,3, "HOW TO PLAY"
  print at 11,4, "CREDITS"
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ' the snow slides by, and the piste sways
  Pos = Pos + 10
  Stripes
  V = Tick & 127
  Tw = V
  if Tw > 63 then Tw = 127 - Tw
  Tw = Tw - 32
  Cq = Tw
  Edges
  ' the ski tips lean into the sway
  Pose = 0
  if Cq < -12 then
    Pose = 1
  else
    if Cq > 12 then Pose = 2
  end if
  Skis
  update sprites
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 2 to 4
    print at 9,I, " "
  next
  Y = Menu + 2
  print at 9,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  PageScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "THE AVALANCHE HAS BROKEN"
  print at 2,4, "LOOSE ABOVE YOU. SKI DOWN"
  print at 2,5, "AHEAD OF IT AND WARN THE"
  print at 2,6, "VILLAGE BELOW. THREE STAGES."
  print at 2,8, "LEFT, RIGHT: STEER"
  print at 2,9, "UP: TUCK, FOR SPEED"
  print at 2,10, "DOWN: SNOWPLOUGH, TO SLOW"
  print at 2,12, "TREES AND ROCKS THROW YOU."
  print at 2,13, "THE FOREST IS DEEP AND SLOW."
  print at 2,14, "SKI BETWEEN TWO FLAGS FOR"
  print at 2,15, "100 POINTS AND A BOOST."
  print at 2,17, "THE GAUGE SHOWS HOW FAR"
  print at 2,18, "BACK THE AVALANCHE IS:"
  print at 2,19, "LISTEN TO IT, TOO."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  PageScreen
  print at 9,1, "AVALANCHE RUN"
  print at 2,3, "A NEW GAME INSPIRED BY"
  print at 2,4, "AVALANCHE IN TIM HARTNELL'S"
  print at 2,5, "GIANT BOOK OF COMPUTER GAMES"
  print at 2,6, "(BALLANTINE BOOKS, 1984;"
  print at 2,7, "INTERFACE PUBLICATIONS,"
  print at 2,8, "1983), WHERE THE MAYOR OF A"
  print at 2,9, "MOUNTAIN VILLAGE BRACES FOR"
  print at 2,10, "THE SNOW."
  print at 2,12, "MUSIC: FIRST LIGHT ON THE"
  print at 2,13, "COL (ORIGINAL)."
  print at 2,15, "COLECOVISION GAME BY"
  print at 2,16, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$01,$F0,$C0,$80,$00,$00
  $00,$87,$01,$00,$00,$00,$00,$00
  $00,$00,$00,$80,$F0,$03,$00,$00
  $00,$00,$01,$03,$07,$E0,$C0,$80
  $00,$80,$C0,$E0,$70,$03,$E0,$F0
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$01,$03,$07,$F0
  $08,$1C,$C1,$80,$0C,$0E,$F0,$F0
  $00,$00,$00,$00,$C0,$E0,$F0,$07
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$02,$07,$F0,$E0
  $00,$00,$00,$00,$00,$00,$80,$C0
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $03,$01,$00,$00,$00,$00,$00,$00
  $80,$E0,$F0,$07,$E0,$F0,$07,$03
  $00,$00,$01,$03,$07,$F0,$60,$00
  $40,$E0,$F0,$07,$03,$70,$87,$83
  $00,$00,$00,$01,$07,$F0,$E0,$40
