' Navigation subsystem: a future ADAM build can replace this with keyboard controls.
sub Pilot_Run:
  cls
  print centered at 2, "SPACE NAVIGATION"
  print at 3,6, "SECTOR 04"
  print at 3,8, "FUEL   92"
  print at 3,10, "CARGO  RESCUE POD"
  print at 3,14, "COURSE LOCKED"
  print centered at 18, "PRESS FIRE"
  return
end sub
