cartridge "FAST SHUFFLE/ROBERT BIXBY/1987"

' FAST SHUFFLE
' A ColecoVision game based on "Fast Shuffle", the demonstration program
' for "128 Scroller" by Robert Bixby, Ahoy! July 1987 (Commodore 128
' BASIC 7.0 with a machine-language screen scroller). Made for Amy Studio
' by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the mechanics are the original's (read from
' its listing, orig/fastshuffle.bas), built for the ColecoVision: rounded
' coloured tiles with their numbers, rows and columns that roll in
' character steps with the tile wrapping round to the other side, a
' cursor frame that glides, sound effects and an original title tune.
'
' The game: 32 numbered tiles, 8 across and 4 down. Hold the left button
' and push the stick: the cursor's whole row rolls one tile left or right,
' or its whole column one tile up or down; the tile pushed off one end
' comes back in at the other. Put 1-32 back in reading order.
'
' From the original: the 8 x 4 board of 32 numbered tiles, each tile
' coloured; a move rolls a whole row (left/right) or a whole column
' (up/down) by one tile, with wrap-around; the cursor moves one tile at a
' time and wraps round the edges; HARD (columns roll round 4 rows) and
' EASY (an empty fifth row under the board, so columns roll round 5 places
' and tiles can pass through the gaps; that row rolls sideways too); the
' board is mixed by rolling lines at random before play.
'
' Liberties: the original has no goal, no end and no count (it is a demo
' of the scroller). Added here: the goal, numbers 1-32 in reading order
' (EASY: the fifth row empty), with each number's colour tied to the
' number (its home column's colour; the original coloured screen columns,
' so colours and numbers drifted apart); the mix is made of legal rolls
' only, so every board is solvable (the original shuffled the numbers
' freely, then rolled 3 x 3 windows); a move counter, a clock, solve
' detection with a message, and the best move count for each mode. The
' original's pointing hand turned by "*" with SPACE to roll is replaced by
' the left button held with a stick push (the direction is the roll);
' holding the stick repeats. Holding the right button for two seconds
' gives up. Joystick only (the original used the keyboard).
'
' Controls: either controller. Stick: move the cursor (hold to repeat).
' Left button held + stick: roll the row or column. Right button held:
' give up. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects
' after; the title tune is played once. `set sprite count` is always
' given. Own xorshift random numbers. Nothing flashes.

const TE00 = 128
const TE01 = 129
const TE02 = 130
const TE03 = 131
const TE04 = 132
const TE05 = 133
const TE06 = 134
const TE07 = 135
const TE10 = 136
const TE11 = 137
const TE12 = 138
const TE13 = 139
const TE14 = 140
const TE15 = 141
const TE16 = 142
const TE17 = 143
const TE20 = 144
const TE21 = 145
const TE22 = 146
const TE23 = 147
const TE24 = 148
const TE25 = 149
const TE26 = 150
const TE27 = 151
const TE30 = 152
const TE31 = 153
const TE32 = 154
const TE33 = 155
const TE34 = 156
const TE35 = 157
const TE36 = 158
const TE37 = 159
const TE40 = 160
const TE41 = 161
const TE42 = 162
const TE43 = 163
const TE44 = 164
const TE45 = 165
const TE46 = 166
const TE47 = 167
const TE50 = 168
const TE51 = 169
const TE52 = 170
const TE53 = 171
const TE54 = 172
const TE55 = 173
const TE56 = 174
const TE57 = 175
const TE60 = 176
const TE61 = 177
const TE62 = 178
const TE63 = 179
const TE64 = 180
const TE65 = 181
const TE66 = 182
const TE67 = 183
const TE70 = 184
const TE71 = 185
const TE72 = 186
const TE73 = 187
const TE74 = 188
const TE75 = 189
const TE76 = 190
const TE77 = 191
const TN1 = 192
const TN2 = 193
const TN3 = 194
const TN4 = 195
const TN5 = 196
const TN6 = 197
const TN7 = 198
const TN8 = 199
const TN9 = 200
const TN10 = 201
const TN11 = 202
const TN12 = 203
const TN13 = 204
const TN14 = 205
const TN15 = 206
const TN16 = 207
const TN17 = 208
const TN18 = 209
const TN19 = 210
const TN20 = 211
const TN21 = 212
const TN22 = 213
const TN23 = 214
const TN24 = 215
const TN25 = 216
const TN26 = 217
const TN27 = 218
const TN28 = 219
const TN29 = 220
const TN30 = 221
const TN31 = 222
const TN32 = 223
const TEmpty = 224
const TDot = 225
const TRule = 226
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const NTiles8 = 792
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndRoll = 3
const SndClick = 4
const SndTick = 5
const SndMix = 6
const SndStart = 7
const SndWin = 8
const SndQuit = 9
const NSpr = 4
const TuneLen = 512
const QuitN = 120
const BoardX = 4
const BoardY = 3

record Cursor:
  u8 Row
  u8 Col
  u8 X
  u8 Y
end record

data D3 bytes
  0,0,0,1,1,1,2,2,2,3,3,3,4,4,4,5,5,5,6,6,6,7,7,7
end data
data M3 bytes
  0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2
end data

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Mv = 0
u16 BestH = 0
u16 BestE = 0
bcd digits 4 Secs = 0
u8 SecT = 0
' the board: Bd[row * 8 + col], 1-32 the tiles, 0 an empty place (EASY's
' fifth row); NR rows (4 HARD, 5 EASY), NH = NR * 3 characters high
u8 Bd[40]
u8 Buf[24]
u8 NR = 4
u8 NH = 12
u8 Easy = 0
Cursor Cur
' game state: 0 title, 1 mixing, 2 playing, 3 rolling, 4 over
u8 Gs = 0
u8 Won = 0
' the roll: direction (0 left, 1 right, 2 up, 3 down, 255 none), the
' line (row or column) and the step (0-2 characters)
u8 AD = 255
u8 Line = 0
u8 As = 0
u8 Fast = 0
u8 QuitT = 0
u8 Rpt = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Btn2 = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Si = 0
u8 MixI = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  Clock
  PlayInput
  MoveCursor
  if Gs <> 4 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  HideSprites
  if Won = 1 then
    if Easy = 1 then
      if BestE = 0 then BestE = Mv
      if Mv < BestE then BestE = Mv
    else
      if BestH = 0 then BestH = Mv
      if Mv < BestH then BestH = Mv
    end if
    ShowHud
    print at 6,7, "                    "
    print at 6,8, "      SOLVED IN     "
    print at 6,9, "                    "
    NumU = Mv
    print at 8,9, digits$(NumU, 5)
    print at 14,9, "MOVES"
    print at 6,10, "                    "
    print at 6,11, "    TIME      SEC   "
    print Secs at 15,11
    print at 6,12, "                    "
    play sound SndWin
  else
    print at 6,8, "                    "
    print at 6,9, "      GIVEN UP      "
    print at 6,10, "                    "
    play sound SndQuit
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the board

' the character of tile T (0 empty, 1-32) at its local position Lx, Ly
' (0-2): shared corner and edge pieces in the tile's colour, its number
' in the centre
function TileChar(u8 T, u8 Lx, u8 Ly) as u8
  u8 Res = 0
  u8 Base = 0
  if T = 0 then
    Res = TEmpty
    if Lx = 1 then
      if Ly = 1 then Res = TDot
    end if
    return Res
  end if
  Base = ((T - 1) & 7) << 3
  Base = Base + TE00
  select case (Lx, Ly)
  case (1, 1)
    Res = TN1 + T - 1
  case (0 to 2, 0)
    Res = Base + Lx
  case (0, 1)
    Res = Base + 3
  case (2, 1)
    Res = Base + 4
  case else
    Res = Base + 5 + Lx
  end select
  return Res

' what board character Qx (0-23), Qy (0 to NH-1) shows now, with the
' rolling line As characters along its way
function CharAt(u8 Qx, u8 Qy) as u8
  u8 Sx = 0
  u8 Sy = 0
  u8 Ce = 0
  Sx = Qx
  Sy = Qy
  if AD < 2 then
    if D3[Qy] = Line then
      if AD = 0 then
        Sx = Qx + As
        if Sx >= 24 then Sx = Sx - 24
      else
        if Qx >= As then
          Sx = Qx - As
        else
          Sx = Qx + 24 - As
        end if
      end if
    end if
  elseif AD < 4 then
    if D3[Qx] = Line then
      if AD = 2 then
        Sy = Qy + As
        if Sy >= NH then Sy = Sy - NH
      else
        if Qy >= As then
          Sy = Qy - As
        else
          Sy = Qy + NH - As
        end if
      end if
    end if
  end if
  Ce = (D3[Sy] << 3) + D3[Sx]
  return TileChar(Bd[Ce], M3[Sx], M3[Sy])

' draw board characters X0.. (W wide), rows Y0.. (H high) through Buf
sub DrawStrip(u8 X0, u8 Y0, u8 W, u8 H):
  u8 Yy = 0
  u8 Xx = 0
  u8 Ye = 0
  u8 Xe = 0
  u16 Va = 0
  Ye = Y0 + H - 1
  Xe = W - 1
  for Yy = Y0 to Ye
    for Xx = 0 to Xe
      Buf[Xx] = CharAt(X0 + Xx, Yy)
    next
    Va = Yy + BoardY
    Va = Va * 32 + X0 + BoardX
    copy Buf count W to vram.name + Va
  next
  return

sub DrawBoard:
  AD = 255
  DrawStrip(0, 0, 24, NH)
  return

' 1 when 1-32 are in reading order (EASY's fifth row is then empty)
function Solved as u8
  for Si = 0 to 31
    if Bd[Si] <> Si + 1 then return 0
  next
  return 1

' tiles away from their home place
function Misplaced as u8
  u8 Cnt = 0
  for Si = 0 to 31
    if Bd[Si] <> Si + 1 then inc Cnt
  next
  return Cnt

' roll the cursor's row (Dir 0 left, 1 right) or column (2 up, 3 down)
' one tile, animated; the cursor follows the tile it pushed
sub DoShift(u8 Dir):
  u8 Base = 0
  u8 T = 0
  u8 I = 0
  u8 Last = 0
  u8 Cc = 0
  AD = Dir
  if Dir < 2 then
    Line = Cur.Row
  else
    Line = Cur.Col
  end if
  Animate
  Base = Cur.Row << 3
  Cc = Cur.Col
  Last = NR - 1
  select case Dir
  case 0
    T = Bd[Base]
    for I = 0 to 6
      Bd[Base + I] = Bd[Base + I + 1]
    next
    Bd[Base + 7] = T
    Cur.Col = (Cur.Col + 7) & 7
  case 1
    T = Bd[Base + 7]
    for I = 7 downto 1
      Bd[Base + I] = Bd[Base + I - 1]
    next
    Bd[Base] = T
    Cur.Col = (Cur.Col + 1) & 7
  case 2
    T = Bd[Cc]
    for I = 1 to Last
      Bd[(I - 1) * 8 + Cc] = Bd[I * 8 + Cc]
    next
    Bd[Last * 8 + Cc] = T
    if Cur.Row = 0 then
      Cur.Row = Last
    else
      dec Cur.Row
    end if
  case 3
    T = Bd[Last * 8 + Cc]
    for I = Last downto 1
      Bd[I * 8 + Cc] = Bd[(I - 1) * 8 + Cc]
    next
    Bd[Cc] = T
    if Cur.Row = Last then
      Cur.Row = 0
    else
      inc Cur.Row
    end if
  end select
  AD = 255
  As = 0
  Redraw(Dir)
  return

' the rolling line's strip of characters
sub Redraw(u8 Dir):
  if Dir < 2 then
    DrawStrip(0, Line * 3, 24, 3)
  else
    DrawStrip(Line * 3, 0, 3, NH)
  end if
  return

' two in-between steps (one and two characters along); the values move
' after, and the line is drawn in place
sub Animate:
  for As = 1 to 2
    if Fast = 0 then
      Frame1
      ReadPad
      Clock
      MoveCursor
    end if
    Frame1
    if Fast = 0 then Clock
    Redraw(AD)
  next
  Frame1
  if Fast = 0 then Clock
  return

' ---------------------------------------------------------------------------
' play

sub PlayInput:
  u8 St = 0
  u8 Dir = 255
  if Btn2 > 0 then
    inc QuitT
    if QuitT >= QuitN then
      Won = 0
      Gs = 4
      return
    end if
  else
    QuitT = 0
  end if
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
    WasStick = 0
    return
  end if
  if Rpt > 0 then
    dec Rpt
    WasStick = St
    return
  end if
  if WasStick = 0 then
    Rpt = 14
  else
    Rpt = 7
  end if
  WasStick = St
  if Btn = 0 then
    MoveBy(St)
    return
  end if
  Dir = StickDir(St)
  Gs = 3
  play sound SndRoll
  DoShift(Dir)
  inc Mv
  ShowMoves
  Gs = 2
  if Solved = 1 then
    Won = 1
    Gs = 4
  end if
  return

' the roll for a stick push: up, down, left, right in that order
function StickDir(u8 St) as u8
  if (St & 1) > 0 then return 2
  if (St & 2) > 0 then return 3
  if (St & 4) > 0 then return 0
  return 1

' one tile in the stick's direction, wrapping round as the original did
sub MoveBy(u8 St):
  select case StickDir(St)
  case 2
    if Cur.Row = 0 then
      Cur.Row = NR - 1
    else
      dec Cur.Row
    end if
  case 3
    inc Cur.Row
    if Cur.Row >= NR then Cur.Row = 0
  case 0
    Cur.Col = (Cur.Col + 7) & 7
  case else
    Cur.Col = (Cur.Col + 1) & 7
  end select
  play sound SndTick
  return

' the cursor frame glides 4 pixels a frame toward its tile (jumps when
' it wraps round)
sub MoveCursor:
  u8 Tx = 0
  u8 Ty = 0
  u8 Co = 15
  Tx = Cur.Col * 24 + BoardX * 8
  Ty = Cur.Row * 24 + BoardY * 8
  if Cur.X + 24 < Tx then Cur.X = Tx
  if Tx + 24 < Cur.X then Cur.X = Tx
  if Cur.Y + 24 < Ty then Cur.Y = Ty
  if Ty + 24 < Cur.Y then Cur.Y = Ty
  if Cur.X < Tx then Cur.X += 4
  if Cur.X > Tx then Cur.X -= 4
  if Cur.Y < Ty then Cur.Y += 4
  if Cur.Y > Ty then Cur.Y -= 4
  if Btn > 0 then Co = 11
  Y = Cur.Y - 3
  X = Cur.X - 2
  set sprite 0 to Y,X,SCtl,Co
  X = Cur.X + 10
  set sprite 1 to Y,X,SCtr,Co
  Y = Cur.Y + 9
  set sprite 3 to Y,X,SCbr,Co
  X = Cur.X - 2
  set sprite 2 to Y,X,SCbl,Co
  update sprites
  return

sub Clock:
  if Gs = 4 then return
  inc SecT
  if SecT < 60 then return
  SecT = 0
  if Secs < 9999 then inc Secs
  print Secs at 24,1
  return

sub ShowMoves:
  NumU = Mv
  print at 8,1, digits$(NumU, 5)
  return

sub ShowHud:
  print at 2,1, "MOVES"
  ShowMoves
  print at 19,1, "TIME"
  print Secs at 24,1
  print at 2,20, "BEST"
  NumU = BestH
  if Easy = 1 then NumU = BestE
  if NumU = 0 then
    print at 7,20, "-----"
  else
    print at 7,20, digits$(NumU, 5)
  end if
  if Easy = 1 then
    print at 24,20, "EASY"
  else
    print at 24,20, "HARD"
  end if
  print at 2,21, "BUTTON + STICK = ROLL"
  print at 2,22, "HOLD RIGHT BUTTON = QUIT"
  return

' ---------------------------------------------------------------------------
' the mix: legal rolls only, so the board can always be put back

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

sub MixBoard(u8 Rounds):
  u8 Dir = 0
  u8 Rr = 0
  for MixI = 1 to Rounds
    W16 = Rand
    Dir = W16 & 3
    W16 = W16 >> 3
    Rr = W16 & 7
    if Rr >= NR then Rr = Rr - NR
    Cur.Row = Rr
    W16 = W16 >> 5
    Cur.Col = W16 & 7
    play sound SndMix
    DoShift(Dir)
  next
  return

sub NewGame:
  NR = 4
  if Easy = 1 then NR = 5
  NH = NR * 3
  NewScreen
  fill array Bd with 0
  for Si = 0 to 31
    Bd[Si] = Si + 1
  next
  DrawBoard
  Mv = 0
  Secs = 0
  SecT = 0
  QuitT = 0
  Won = 0
  ShowHud
  Cur.Row = 0
  Cur.Col = 0
  Cur.X = BoardX * 8
  Cur.Y = BoardY * 8
  ShowScreen
  Gs = 1
  Fast = 1
  if Easy = 1 then
    MixBoard(60)
  else
    MixBoard(80)
  end if
  while Misplaced < 26
    MixBoard(4)
  end while
  Fast = 0
  Mv = 0
  ShowMoves
  Secs = 0
  print Secs at 24,1
  Cur.Row = 0
  Cur.Col = 0
  Cur.X = BoardX * 8
  Cur.Y = BoardY * 8
  MoveCursor
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 15
  Rpt = 14
  Gs = 2
  return

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 16
  Btn2 = V & 32
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a whole tile T with its corner at screen character X, Y
sub PutTile(u8 T, u8 Px, u8 Py):
  u8 Lx = 0
  u8 Ly = 0
  u8 Ch = 0
  u8 Sx = 0
  u8 Sy = 0
  for Ly = 0 to 2
    for Lx = 0 to 2
      Ch = TileChar(T, Lx, Ly)
      Sx = Px + Lx
      Sy = Py + Ly
      put char Ch at Sx,Sy
    next
  next
  return

data TitleT bytes
  3, 8, 1, 6, 5, 2, 7, 4
end data

' the title: FAST SHUFFLE over a row of tiles, the tune once, HARD /
' EASY / CREDITS
sub TitlePage:
  Gs = 0
  NewScreen
  print at 10,2, "FAST SHUFFLE"
  fill TRule count 24 at 4,3
  for Ci = 0 to 7
    X = Ci * 3 + BoardX
    PutTile(TitleT[Ci], X, 5)
  next
  fill TRule count 24 at 4,9
  print at 4,10, "DEMO FOR 128 SCROLLER BY"
  print at 4,11, "ROBERT BIXBY, AHOY! JULY"
  print at 4,12, "1987 (COMMODORE 128)"
  print at 12,14, "HARD"
  print at 12,15, "EASY"
  print at 12,16, "CREDITS"
  print at 3,18, "ROLL THE ROWS AND COLUMNS"
  print at 3,19, "TO PUT 1-32 BACK IN ORDER"
  print at 2,21, "BEST HARD"
  print at 18,21, "EASY"
  if BestH = 0 then
    print at 12,21, "-----"
  else
    NumU = BestH
    print at 12,21, digits$(NumU, 5)
  end if
  if BestE = 0 then
    print at 23,21, "-----"
  else
    NumU = BestE
    print at 23,21, digits$(NumU, 5)
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Easy = 0
  if Menu = 1 then Easy = 1
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for Ri = 14 to 16
    put char 32 at 10,Ri
  next
  J = Menu + 14
  put char 62 at 10,J
  return

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "FAST SHUFFLE"
  print at 2,4, "BASED ON FAST SHUFFLE, THE"
  print at 2,5, "DEMO FOR 128 SCROLLER BY"
  print at 2,6, "ROBERT BIXBY, AHOY! JULY"
  print at 2,7, "1987 (COMMODORE 128)."
  print at 2,9, "ROLL WHOLE ROWS AND COLUMNS"
  print at 2,10, "ROUND TO PUT THE 32 TILES"
  print at 2,11, "BACK IN ORDER. EASY ADDS AN"
  print at 2,12, "EMPTY ROW TO ROLL THROUGH."
  print at 2,14, "COLECOVISION GAME, MUSIC"
  print at 2,15, "AND PICTURES BY CLAUDE"
  print at 2,16, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,17, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,19, "MUSIC: ROUND AND ROUND"
  print at 2,20, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

