  tile screen
  set sound table AlSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Played = 0
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPlay
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

  NewGame
play_loop:
  Turn
  if Over = 0 then goto play_loop

  ' the end: the message is on screen; a press goes back to the title
  GState = 4
  if Over = 1 then
    if G > Hi then Hi = G
  end if
  ShowHud
  Act[6].Y = 192
  DrawSprites
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift; Roll(N) is 1..N like INT(RND(1)*N+1)

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function Roll(u8 Nr) as u8
  Rand
  return (Rs % Nr) + 1

' ---------------------------------------------------------------------------
' one turn: roll the event; events the listing skipped silently roll again

sub Turn:
  if Raining = 1 then Sunny
  Act1 = 0
  do
    if Tl = 0 then Tc = Roll(10)
    Ev = Roll(10)
    if Tl > 0 then AddTime(1)
    select case Ev
    case 1
      EvFound
    case 2
      EvPartly
    case 3
      EvEarly
    case 4, 10
      EvCounter
    case 5, 6
      EvWasted
    case 7, 8
      EvMonster
    case else
      EvAnimal
    end select
    if Over = 0 then Clock
  loop until Act1 + Over > 0
  return
end sub

sub EvFound:
  if Wx = 1 then return
  Act1 = 1
  Say(TxFound)
  if Tl > 0 then AddTime(1)
  AddGold(10)
  AskClean
  if Over > 0 then return
  do
    V = Roll(15)
    if V = 15 then
      LoseTo(TxEarly)
      exit do
    end if
    if V >= 12 then
      Say(TxWeather1)
      Rainy
      AskClean
      exit do
    end if
    AddGold(10)
    NumU = G
    Say(TxAnother)
    AskClean
  loop until Over > 0
  return
end sub

sub EvPartly:
  Act1 = 1
  G1 = Roll(6)
  NumU = G1
  Say(TxPartly)
  AddGold(G1)
  AskClean
  if Over > 0 then return
  AddTime(1)
  do
    Ask(255, TxOSame, TxODiff)
    if Menu = 1 then exit do
    V = Roll(15)
    if V = 15 then
      ' the listing's early-return check
      if Tl >= 20 then LoseTo(TxEarly)
      exit do
    end if
    if V >= 13 then
      Say(TxWeather2)
      Wx = 1
      Rainy
      AskClean
      exit do
    end if
    NumU = G1
    Say(TxMore)
    AddGold(G1)
    AddTime(1)
    AskClean
  loop until Over > 0
  return
end sub

sub EvEarly:
  if Tl < 20 then return
  Act1 = 1
  LoseTo(TxEarly)
  return
end sub

sub EvCounter:
  if Cs = 1 then return
  Act1 = 1
  Say(TxCounter)
  Cs = 1
  play sound SndLearn
  AskClean
  return
end sub

sub EvWasted:
  K = Roll(9)
  if K = 1 then
    if Sb = 1 then return
    Act1 = 1
    Sb = 1
    Say(TxBook)
    if Tl > 40 then
      Pause(TxOPress)
      LoseTo(TxBack)
      return
    end if
  else
    Act1 = 1
    Say(WtMsg[K])
  end if
  play sound SndBad
  AddTime(WtMin[K])
  AskClean
  return
end sub

sub EvMonster:
  Act1 = 1
  Mon = Roll(9)
  Act[2].Y = 47
  Act[2].X = 100
  Act[2].P = MonPat[Mon]
  Act[2].C = MonCol[Mon]
  PuffAt(100, 47)
  play sound SndRoar
  Say(TxCreated)
  K = TxMon1 + Mon - 1
  Say(K)
  Say(TxHungry)
  Pause(TxOTry)
  if Cs = 1 then
    Say(TxUseCs)
    MonsterGone
    AskClean
    return
  end if
  do
    K = Roll(9)
    select case K
    case 1, 9
      Say(TxAgain1)
      play sound SndRoar
      Pause(TxOTry)
      AddTime(1)
    case 2, 4, 6, 8
      Say(TxCareful)
      MonsterGone
      AskClean
      exit do
    case 3, 7
      Say(TxDesperate)
      play sound SndBad
      Pause(TxOTry)
      Say(TxChicken)
      BecomeAnimal(3)
      Act[3].C = 15
      play sound SndPoof
      Pause(TxOTry)
      BeYourself
      AddTime(1)
    case else
      NumU = G
      Say(TxEaten)
      Act[0].Y = 192
      Act[1].Y = 192
      play sound SndWhack
      G = 0
      Over = 3
      exit do
    end select
  loop
  return
end sub

sub EvAnimal:
  Act1 = 1
  Ani = Roll(13)
  ShowAnimal
  if Ani = 13 then
    Pause(TxOTry)
    Say(TxFish)
    Pause(TxOTry)
    if Roll(2) = 1 then
      Say(TxNoWork)
      Pause(TxOTry)
      AddTime(1)
    end if
    Say(TxLittle)
    Pause(TxOTry)
  end if
  if Ani > 7 then
    Say(TxCold)
    Pause(TxOTry)
    while Roll(2) = 1
      Say(TxNoWork)
      Pause(TxOTry)
      AddTime(1)
    end while
    Say(TxBetter)
    Pause(TxOTry)
    Ani = 7
    ShowAnimal
  end if
  Say(TxWarm)
  Pause(TxOTry)
  while Roll(2) = 2
    Say(TxNoWork)
    Pause(TxOTry)
    AddTime(1)
  end while
  Say(TxDidIt)
  BeYourself
  play sound SndPoof
  AskClean
  return
end sub

sub ShowAnimal:
  BecomeAnimal(Ani)
  play sound SndPoof
  Say(TxChanged)
  K = TxAni1 + Ani - 1
  Say(K)
  return
end sub

' the clock: on one start in ten the alchemist calls; he is back at 60
sub Clock:
  if Tc <> 1 then return
  if Tl = 0 then Tl = 1
  if Tl >= 60 then
    LoseTo(TxBack)
    return
  end if
  K = 0
  if Tl >= 45 then
    if Warn < 3 then K = TxCall15
    Warn = 3
  elseif Tl >= 30 then
    if Warn < 2 then K = TxCall30
    Warn = 2
  elseif Tl >= 15 then
    if Warn < 1 then K = TxCall45
    Warn = 1
  end if
  if K > 0 then
    RingT = 90
    play sound SndRing
    Say(K)
    Pause(TxOPress)
    Act1 = 1
  end if
  return
end sub

sub LoseTo(u8 Why):
  Say(Why)
  if G > 0 then Say(TxLoseGold)
  Say(TxBeating)
  Act[4].Y = 71
  Act[4].X = 200
  Act[5].Y = 71
  Act[5].X = 200
  play sound SndWhack
  G = 0
  DrawGold
  Over = 2
  return
end sub

sub AskClean:
  if Over > 0 then return
  Ask(TxQClean, TxOKeep, TxOClean)
  if Menu = 1 then
    NumU = G
    Say(TxWon)
    play sound SndWin
    Over = 1
  end if
  return
end sub

' ---------------------------------------------------------------------------
' gold, minutes, the pile on the table

sub AddGold(u8 Ng):
  G += Ng
  if G > 999 then G = 999
  SparkT = 40
  play sound SndGold
  DrawGold
  ShowHud
  return
end sub

sub AddTime(u8 Nm):
  Tl += Nm
  ShowHud
  return
end sub

' one cell of the pile (0-7): empty, a few coins, a heap, a full heap
function GoldLevel(u8 Cell) as u8
  u16 Steps = 0
  u8 Lvl = 0
  Steps = G / 10
  W16 = Cell * 3
  if Steps > W16 then
    Steps = Steps - W16
    Lvl = 3
    if Steps < 3 then Lvl = Steps
  end if
  return Lvl

sub DrawGold:
  for Ki = 0 to 7
    V = GoldLevel(Ki)
    V = V + TGold0
    X = Ki & 3
    X = X + 17
    Y = Ki >> 2
    Y = 9 - Y
    put char V at X,Y
  next
  return
end sub

sub ShowHud:
  print at 2,1, "GOLD"
  print G at 7,1 width 3
  print at 18,1, "MINUTES"
  print Tl at 26,1 width 3
  return
end sub

' ---------------------------------------------------------------------------
' messages and questions (rows 13-18 text, 19 question, 20-21 choices)

sub Say(u8 Id):
  W16 = MsgFirst[Id]
  N = MsgN[Id]
  Sr = MsgRow
  for Li = 1 to N
    Off = W16 * 28
    put MsgTxt + Off count SayW at SayCol,MsgRow
    inc MsgRow
    inc W16
  next
  Nc = MsgNc[Id]
  if Nc > 0 then
    R = Sr + MsgNr[Id]
    Nc = Nc + SayCol - 2
    if MsgNw[Id] = 1 then
      print at Nc,R, digits$(NumU, 1)
    else
      print NumU at Nc,R width 3
    end if
  end if
  return
end sub

sub ClearMsg:
  for Ri = 13 to 21
    fill 32 count 28 at 2,Ri
  next
  MsgRow = 13
  return
end sub

sub ShowChoices:
  for Ri = 0 to 1
    Y = Ri + 20
    put char 32 at 2,Y
  next
  Y = Menu + 20
  put char 62 at 2,Y
  return
end sub

' a question: Q (255 none) on row 19, choices A and B; Menu = 0 or 1
sub Ask(u8 Q, u8 OA, u8 OB):
  if Q < 255 then
    MsgRow = 19
    Say(Q)
  end if
  ' the choices sit two columns in
  SayCol = 4
  SayW = 26
  MsgRow = 20
  NOpt = 2
  Say(OA)
  MsgRow = 21
  Say(OB)
  SayCol = 2
  SayW = 28
  Menu = 0
  Qid = Q
  if Q = 255 then Qid = OA
  ShowChoices
  GState = 2
  WaitAnswer
  GState = 0
  ClearMsg
  return
end sub

' a pause: one choice (PRESS A BUTTON / TRY SOMETHING ELSE)
sub Pause(u8 Oc):
  SayCol = 4
  SayW = 26
  MsgRow = 20
  NOpt = 1
  Say(Oc)
  SayCol = 2
  SayW = 28
  Menu = 0
  Qid = Oc
  ShowChoices
  GState = 3
  WaitAnswer
  GState = 0
  ClearMsg
  return
end sub

sub WaitAnswer:
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  do
    Frame1
    ReadPad
    Animate
    V = J1 | J2
    V = V & 3
    if V > 0 then
      if WasStick = 0 then
        if NOpt = 2 then
          K = V & 1
          if K > 0 then
            Menu = 0
          else
            Menu = 1
          end if
          ShowChoices
          play sound SndTick
        end if
      end if
    end if
    WasStick = V
  loop until Press = 1
  return
end sub

' ---------------------------------------------------------------------------
' the workshop and its sprites

sub DrawScene:
  Off = 0
  for Ri = 2 to 11
    put SceneMap + Off count 28 at 2,Ri
    Off += 28
  next
  fill TRule count 32 at 0,12
  return
end sub

sub Sunny:
  Raining = 0
  put char TSun00 at 3,4
  put char TSun01 at 4,4
  put char TSun10 at 3,5
  put char TSun11 at 4,5
  return
end sub

sub Rainy:
  Raining = 1
  put char TRain00 at 3,4
  put char TRain01 at 4,4
  put char TRain10 at 3,5
  put char TRain11 at 4,5
  play sound SndBad
  return
end sub

sub ResetActors:
  for Si = 0 to 7
    Act[Si].Y = 192
    Act[Si].X = 0
    Act[Si].P = 0
    Act[Si].C = 0
  next
  BeYourself
  Act[4].P = SAbeard
  Act[4].C = 15
  Act[5].P = SArobe
  Act[5].C = 13
  Act[6].P = SSpark
  Act[6].C = 11
  Act[7].P = SPuff
  Act[7].C = 15
  return
end sub

sub BeYourself:
  Act[0].Y = 71
  Act[0].X = 70
  Act[0].P = SFace0
  Act[0].C = 11
  Act[1].Y = 71
  Act[1].X = 70
  Act[1].P = SRobe
  Act[1].C = 5
  Act[3].Y = 192
  PuffAt(70, 71)
  return
end sub

sub BecomeAnimal(u8 Which):
  Act[0].Y = 192
  Act[1].Y = 192
  Act[3].Y = 71
  Act[3].X = 70
  Act[3].P = AniPat[Which]
  Act[3].C = AniCol[Which]
  PuffAt(70, 71)
  return
end sub

sub MonsterGone:
  PuffAt(100, 47)
  Act[2].Y = 192
  play sound SndPoof
  return
end sub

sub PuffAt(u8 Px, u8 Py):
  Act[7].X = Px
  Act[7].Y = Py
  PuffT = 20
  return
end sub

' every frame: the bubbling cauldron, the stirring, the phone, timers
sub Animate:
  V = Tick & 15
  if V = 0 then
    V = Tick & 16
    if V = 0 then
      put char TCaul00 at 11,8
      put char TCaul01 at 12,8
      put char TCaul02 at 13,8
      put char TCaul03 at 14,8
      Act[0].P = SFace0
    else
      put char TCaulb00 at 11,8
      put char TCaulb01 at 12,8
      put char TCaulb02 at 13,8
      put char TCaulb03 at 14,8
      Act[0].P = SFace1
    end if
  end if
  if RingT > 0 then
    dec RingT
    V = RingT & 8
    if V = 0 then
      put char TPhone at 19,5
    else
      put char TPhoner at 19,5
    end if
  end if
  if PuffT > 0 then
    dec PuffT
    if PuffT = 0 then Act[7].Y = 192
  end if
  Act[6].Y = 192
  if SparkT > 0 then
    dec SparkT
    V = SparkT & 8
    if V > 0 then
      Act[6].Y = 54
      Act[6].X = 146
    end if
  end if
  DrawSprites
  return
end sub

sub DrawSprites:
  for Si = 0 to Last
    with Act[Si] as Ac
      Y = Ac.Y
      X = Ac.X
      K = Ac.P
      V = Ac.C
    end with
    set sprite Si to Y,X,K,V
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' a new game

sub NewGame:
  G = 0
  Tl = 0
  Tc = 0
  Cs = 0
  Sb = 0
  Wx = 0
  Warn = 0
  Over = 0
  RingT = 0
  inc Played
  NewScreen
  DrawScene
  DrawGold
  ShowHud
  ResetActors
  DrawSprites
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for Si = 0 to 7
    set sprite Si to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  MsgRow = 13
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the workshop, the apprentice stirring, the tune once
sub TitlePage:
  NewScreen
  DrawScene
  G = 0
  DrawGold
  ResetActors
  print at 5,14, "ALCHEMIST'S APPRENTICE"
  print at 5,15, "BY CHERYL COX PETERSON"
  print at 10,17, "START GAME"
  print at 10,18, "HOW TO PLAY"
  print at 10,19, "CREDITS"
  print at 2,21, "BEST"
  print Hi at 7,21 width 3
  print at 12,21, "GAMES"
  print Played at 18,21
  print at 2,1, "AHOY! MAY 1986"
  Menu = 0
  ShowTitleMenu
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  GState = 1
  do
    Frame1
    inc Rs
    ReadPad
    Animate
    V = J1 | J2
    V = V & 3
    if V > 0 then
      if WasStick = 0 then
        K = V & 1
        if K > 0 then
          if Menu > 0 then dec Menu
        else
          if Menu < 2 then inc Menu
        end if
        ShowTitleMenu
        play sound SndTick
      end if
    end if
    WasStick = V
  loop until Press = 1
  GState = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowTitleMenu:
  for Ri = 17 to 19
    put char 32 at 8,Ri
  next
  Y = Menu + 17
  put char 62 at 8,Y
  return
end sub

sub HowToPlay:
  NewScreen
  fill mode 2 text color with $B1
  print at 7,1, "HOW TO PLAY  (1/2)"
  MsgRow = 3
  Say(TxHow1)
  MsgRow = 15
  Say(TxHow4)
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  GState = 6
  Rearm
  wait no fire
  pause until press
  nmi off
  NewScreen
  fill mode 2 text color with $B1
  print at 7,1, "HOW TO PLAY  (2/2)"
  MsgRow = 3
  Say(TxHow2)
  MsgRow = 12
  Say(TxHow3)
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  GState = 0
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 5,2, "ALCHEMIST'S APPRENTICE"
  print at 2,5, "BASED ON THE GAME BY"
  print at 2,6, "CHERYL COX PETERSON, AHOY!"
  print at 2,7, "MAY 1986 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: THE APPRENTICE'S"
  print at 2,18, "BREW (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  GState = 5
  Rearm
  pause until press
  wait no fire
  nmi off
  GState = 0
  return
end sub

