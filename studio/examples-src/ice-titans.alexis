    dw ItStart,$7049
    dw ItOver,$7049
; Glacier March (original)
; Tiny Sound, 8 frames per step
ItTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1C,$01,$01,$23,$01,$01,$28,$01,$26,$01,$23,$01
    db $21,$01,$23,$01,$1F,$01,$01,$21,$01,$01,$23,$01,$01,$01,$1E,$01
    db $1A,$01,$1E,$01,$1C,$01,$01,$23,$01,$01,$28,$01,$2A,$01,$2B,$01
    db $2A,$01,$28,$01,$26,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01
