record Titan:
  u8 X
  u8 Y
  i8 DX
  i8 DY
  u8 St
  u8 T
  u8 Ch
  u8 TX
  u8 TY
end record
' St: 0 none, 1 coming out, 2 roaming, 3 bursting (T frames left);
' Ch = 1 while charging at the spot TX, TY (where a cannon was)
Titan Ti[4]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 C0X = 120
u8 C1Y = 96
u8 Lives0 = 3
u8 Lives1 = 3
u8 S0On = 0
u8 S0X = 0
u8 S0Y = 0
u8 S1On = 0
u8 S1X = 0
u8 S1Y = 0
u8 Wave = 1
u8 Quota = 0
u8 Spd = 0
u8 Acc = 0
u8 Steps = 0
u8 Kind = 0
u8 TCol = 0
u8 Entering = 0
u8 SpawnT = 0
u8 ChargeT = 0
u8 ChargeGap = 0
u8 ChIx = 0
u8 Over = 0
u8 AnimT = 0
u8 Anim = 0
u8 Kills = 0
u8 Pts = 0
u8 Hits = 0
u8 Cleared = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ai = 0
u8 Bi = 0
u8 Ds = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ItSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  ' the last titan of a wave can be the one that took the last cannon
  if Cleared = 1 and Over = 0 then WaveBreak
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Score > Hi then Hi = Score
  HideSprites
  print at 8,10, "                "
  print at 8,11, "   GAME  OVER   "
  print at 8,12, "                "
  print at 8,13, "  SCORE ", Score, "  "
  print at 8,14, "  BEST  ", Hi, "  "
  print at 8,15, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  MoveCannons
  MoveBeams
  MoveTitans
  Bumps
  Charge
  Collide
  Spawn
  if Quota = 0 then Cleared = 1
  if Lives0 = 0 then
    if Lives1 = 0 then Over = 1
  end if
  return
end sub

sub MoveCannons:
  if Lives0 > 0 then
    K = J1 & 12
    select case K
      case 4
        if C0X > C0Min then C0X = C0X - 2
      case 8
        if C0X < C0Max then C0X = C0X + 2
    end select
  end if
  if Lives1 > 0 then
    K = J1 & 3
    select case K
      case 1
        if C1Y > C1Min then C1Y = C1Y - 2
      case 2
        if C1Y < C1Max then C1Y = C1Y + 2
    end select
  end if
  ' the held button fires every cannon whose beam is free
  if Btn = 0 then return
  V = 0
  if S0On = 0 then
    if Lives0 > 0 then
      S0On = 1
      S0X = C0X
      S0Y = C0Y - 12
      V = 1
    end if
  end if
  if S1On = 0 then
    if Lives1 > 0 then
      S1On = 1
      S1X = C1X - 12
      S1Y = C1Y
      V = 1
    end if
  end if
  if V = 1 then play sound SndZap
  return
end sub

sub MoveBeams:
  if S0On = 1 then
    if S0Y < 41 then
      S0On = 0
    else
      S0Y -= 5
    end if
  end if
  if S1On = 1 then
    if S1X < 29 then
      S1On = 0
    else
      S1X -= 5
    end if
  end if
  return
end sub

' the shared step clock: Spd sixteenths of a pixel a frame for every titan
sub MoveTitans:
  W16 = Acc + Spd
  Steps = W16 >> 4
  Acc = W16 & 15
  for Ai = 0 to 3
    select case Ti[Ai].St
      case 1
        Ti[Ai].X = Ti[Ai].X + Steps
        if Ti[Ai].X >= AXMin then
          Ti[Ai].St = 2
          Entering = 0
          NewDiag(Ai)
        end if
      case 2
        Walk(Ai, Steps)
      case 3
        Ti[Ai].T -= 1
        if Ti[Ai].T = 0 then Ti[Ai].St = 0
    end select
  next
  return
end sub

' N pixels along the titan's diagonal, bouncing off the cave's sides
sub Walk(u8 I, u8 N):
  while N > 0
    if Ti[I].Ch = 1 then
      ' a charge steers at its spot every pixel; there it ends
      Ti[I].DX = Way(Ti[I].X, Ti[I].TX)
      Ti[I].DY = Way(Ti[I].Y, Ti[I].TY)
      if Ti[I].DX = 0 and Ti[I].DY = 0 then
        Ti[I].Ch = 0
        NewDiag(I)
      end if
    end if
    if Ti[I].DX < 0 then
      if Ti[I].X <= AXMin then Ti[I].DX = 1
    else
      if Ti[I].X >= AXMax then Ti[I].DX = -1
    end if
    if Ti[I].DY < 0 then
      if Ti[I].Y <= AYMin then Ti[I].DY = 1
    else
      if Ti[I].Y >= AYMax then Ti[I].DY = -1
    end if
    Ti[I].X = Ti[I].X + Ti[I].DX
    Ti[I].Y = Ti[I].Y + Ti[I].DY
    N -= 1
  end while
  return
end sub

' a random diagonal (the C64's directions 2, 4, 6, 8)
sub NewDiag(u8 I):
  Rand
  V = Rs & 3
  if V & 1 then
    Ti[I].DX = 1
  else
    Ti[I].DX = -1
  end if
  if V & 2 then
    Ti[I].DY = 1
  else
    Ti[I].DY = -1
  end if
  return
end sub

function Dist(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

' -1 or +1: which way from A to B (B = A counts as +1)
function Toward(u8 A, u8 B) as i8
  if B < A then return -1
  return 1

' -1, 0 or +1: which way from A to B
function Way(u8 A, u8 B) as i8
  if B < A then return -1
  if B > A then return 1
  return 0

' two roaming titans that touch turn away from each other
sub Bumps:
  for Ai = 0 to 2
    if Ti[Ai].St = 2 then
      for Bi = Ai + 1 to 3
        if Ti[Bi].St = 2 then
          if Dist(Ti[Ai].X, Ti[Bi].X) < 14 then
            if Dist(Ti[Ai].Y, Ti[Bi].Y) < 14 then
              Ti[Ai].Ch = 0
              Ti[Bi].Ch = 0
              Ti[Bi].DX = Toward(Ti[Ai].X, Ti[Bi].X)
              Ti[Ai].DX = 0 - Ti[Bi].DX
              Ti[Bi].DY = Toward(Ti[Ai].Y, Ti[Bi].Y)
              Ti[Ai].DY = 0 - Ti[Bi].DY
            end if
          end if
        end if
      next
    end if
  next
  return
end sub

' every ChargeGap frames the next roaming titan charges at the spot beside a
' cannon (a cannon that moves away makes it miss)
sub Charge:
  dec ChargeT
  if ChargeT > 0 then return
  ChargeT = ChargeGap
  for Ds = 1 to 4
    ChIx = (ChIx + 1) & 3
    if Ti[ChIx].St = 2 then
      Aim(ChIx)
      return
    end if
  next
  return
end sub

sub Aim(u8 I):
  Rand
  V = Rs & 1
  if Lives0 = 0 then V = 1
  if Lives1 = 0 then V = 0
  ' the spot is beside the cannon on the titan's side, so that the charge
  ' never walks down the cannon's own line of fire
  if V = 0 then
    X = C0X + 11
    if Ti[I].X < C0X then X = C0X - 11
    Y = AYMax
  else
    Y = C1Y + 11
    if Ti[I].Y < C1Y then Y = C1Y - 11
    X = AXMax
  end if
  if X < AXMin then X = AXMin
  if X > AXMax then X = AXMax
  if Y < AYMin then Y = AYMin
  if Y > AYMax then Y = AYMax
  Ti[I].TX = X
  Ti[I].TY = Y
  Ti[I].Ch = 1
  return
end sub

' beams against titans, titans against cannons
sub Collide:
  i16 Dx = 0
  i16 Dy = 0
  for Ai = 0 to 3
    if Ti[Ai].St = 1 or Ti[Ai].St = 2 then
      if S0On = 1 then
        Dx = S0X - Ti[Ai].X
        Dy = S0Y - Ti[Ai].Y
        if Dx >= -6 and Dx <= 6 and Dy >= -11 and Dy <= 11 then
          S0On = 0
          Destroy(Ai)
          inc Kills
        end if
      end if
    end if
    if Ti[Ai].St = 1 or Ti[Ai].St = 2 then
      if S1On = 1 then
        Dx = S1X - Ti[Ai].X
        Dy = S1Y - Ti[Ai].Y
        if Dx >= -10 and Dx <= 10 and Dy >= -7 and Dy <= 7 then
          S1On = 0
          Destroy(Ai)
          inc Kills
        end if
      end if
    end if
    if Ti[Ai].St = 2 then
      if Lives0 > 0 then
        if Dist(Ti[Ai].X, C0X) < 12 and Dist(Ti[Ai].Y, C0Y) < 12 then
          Destroy(Ai)
          dec Lives0
          inc Hits
          play sound SndStruck
          if Lives0 = 0 then S0On = 0
        end if
      end if
    end if
    if Ti[Ai].St = 2 then
      if Lives1 > 0 then
        if Dist(Ti[Ai].X, C1X) < 12 and Dist(Ti[Ai].Y, C1Y) < 12 then
          Destroy(Ai)
          dec Lives1
          inc Hits
          play sound SndStruck
          if Lives1 = 0 then S1On = 0
        end if
      end if
    end if
  next
  ShowLives
  return
end sub

' a titan bursts: it counts for the wave and scores (wave x 10 points)
sub Destroy(u8 I):
  if Ti[I].St = 1 then Entering = 0
  Ti[I].St = 3
  Ti[I].T = BurstT
  if Quota > 0 then dec Quota
  if Score <= ScoreCap then
    Pts = Wave * 10
    Score += Pts
  end if
  ShowScore
  play sound SndCrunch
  return
end sub

' the next titan out of its cave: one at a time, as many as the wave
' still needs, highest free slot first (as the C64)
sub Spawn:
  if SpawnT > 0 then
    dec SpawnT
    return
  end if
  if Entering = 1 then return
  V = 0
  for Ai = 0 to 3
    if Ti[Ai].St = 1 or Ti[Ai].St = 2 then inc V
  next
  if V >= Quota then return
  Ai = 4
  while Ai > 0
    dec Ai
    if Ti[Ai].St = 0 then
      Ti[Ai].X = SpawnX
      Ti[Ai].Y = CaveY[Ai]
      Ti[Ai].DX = 1
      Ti[Ai].DY = 0
      Ti[Ai].Ch = 0
      Ti[Ai].St = 1
      Entering = 1
      SpawnT = SpawnGap
      play sound SndEmerge
      return
    end if
  end while
  return
end sub

' a cleared wave: 1000 points, the jingle, a pause, the next wave
sub WaveBreak:
  if Score <= ScoreCap then Score += 1000
  ShowScore
  play sound SndWave
  for Ai = 0 to 3
    Ti[Ai].St = 0
  next
  S0On = 0
  S1On = 0
  DrawSprites
  print at 10,11, "WAVE CLEARED"
  for Ds = 1 to 90
    Frame1
  next
  print at 10,11, "            "
  if Wave < 9 then inc Wave
  SetWave
  return
end sub

sub SetWave:
  K = Wave - 1
  Spd = WSpd[K]
  Kind = WKind[K]
  TCol = WCol[K]
  Quota = Wave * 4 + 8
  W16 = Wave * 12
  ChargeGap = 200 - W16
  ChargeT = ChargeGap
  Cleared = 0
  Entering = 0
  SpawnT = SpawnGap
  Acc = 0
  NumU = Wave
  print at 16,1, digits$(NumU, 1)
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the cannons, 2-3 the beams, 4-7 the titans
sub DrawSprites:
  if Lives0 > 0 then
    set sprite 0 to C0Y - 1,C0X,SCanb,LifeCol[Lives0]
  else
    set sprite 0 to 192,0,0,0
  end if
  if Lives1 > 0 then
    set sprite 1 to C1Y - 1,C1X,SCanr,LifeCol[Lives1]
  else
    set sprite 1 to 192,0,0,0
  end if
  if S0On = 1 then
    set sprite 2 to S0Y - 1,S0X,SBeamv,11
  else
    set sprite 2 to 192,0,0,0
  end if
  if S1On = 1 then
    set sprite 3 to S1Y - 1,S1X,SBeamh,11
  else
    set sprite 3 to 192,0,0,0
  end if
  inc AnimT
  if AnimT >= 20 then
    AnimT = 0
    Anim = Anim ^ 4
  end if
  for Ds = 0 to 3
    J = Ds + 4
    select case Ti[Ds].St
      case 0
        set sprite J to 192,0,0,0
      case 3
        K = SBurst0
        if Ti[Ds].T < 8 then K = SBurst1
        set sprite J to Ti[Ds].Y - 1,Ti[Ds].X,K,15
      case else
        K = Kind * 8 + STi0a + Anim
        set sprite J to Ti[Ds].Y - 1,Ti[Ds].X,K,TCol
    end select
  next
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, Score
  print at 22,1, Hi
  return
end sub

' each cannon's lives on the floor line: markers, dots for lives lost
sub ShowLives:
  for Ds = 0 to 2
    K = TLifex
    if Ds < Lives0 then K = TLifeb
    put char K at Ds + 2,22
    K = TLifex
    if Ds < Lives1 then K = TLifer
    put char K at 29 - Ds,22
  next
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 2,1, "SCORE"
  print at 15,1, "W"
  print at 19,1, "HI"
  for Ai = 0 to 3
    Ti[Ai].St = 0
    Ti[Ai].T = 0
  next
  Score = 0
  Wave = 1
  SetWave
  C0X = 120
  C1Y = 96
  Lives0 = 3
  Lives1 = 3
  S0On = 0
  S1On = 0
  ChIx = 0
  Over = 0
  Kills = 0
  Hits = 0
  ShowScore
  ShowLives
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: ICE TITANS in blocks of ice under the crags, a titan pacing
' below, the best score, the tune once
sub TitlePage:
  NewScreen
  copy GameMap count 160 to vram.name
  fill TSky0 count 32 at 0,1
  print at 7,1, "AHOY! JANUARY 1988"
  copy TitleMap count 352 to vram.name + 192
  print at 4,18, "BY CLEVELAND M. BLAKEMORE"
  print at 7,20, "PRESS THE BUTTON"
  if Hi > 0 then
    print at 9,22, "BEST ", Hi
  end if
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 544
  TzOn = 1
  X = 16
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' a titan walks across under the letters
  V = Tick & 1
  if V = 0 then
    inc X
    if X > 224 then X = 16
  end if
  K = Tick & 16
  K = K >> 2
  set sprite 4 to 126,X,STi1a + K,7
  update sprites
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "ICE TITANS"
  print at 2,5, "BASED ON ICE TITANS BY"
  print at 2,6, "CLEVELAND M. BLAKEMORE,"
  print at 2,7, "AHOY! JANUARY 1988"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: GLACIER MARCH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
ItZap:
    db $40,$25,$20,$01,$40,$2F,$30,$01,$40,$3A,$30,$01,$40,$49,$40,$01,$40,$5B,$40,$01,$40,$72,$50,$01
    db $50
ItCrunch:
    db $00,$00,$14,$02,$00,$00,$25,$03,$00,$00,$35,$04,$00,$00,$56,$06,$10
ItStruck:
    db $00,$00,$06,$04,$00,$00,$16,$06,$00,$00,$27,$08,$00,$00,$37,$0A,$00,$00,$57,$0E,$10
ItEmerge:
