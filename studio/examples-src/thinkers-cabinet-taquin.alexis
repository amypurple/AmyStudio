' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 5,2, "THE THINKER'S CABINET"
  print at 4,4, "THINKING GAMES FROM TWO"
  print at 4,5, "ORIC BOOKS OF 1983-1984"
