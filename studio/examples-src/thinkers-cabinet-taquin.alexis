    db $C0,$5A,$F0,$48,$C0,$72,$F0,$24,$C0,$66,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$98,$F0,$24,$C0,$88,$F0,$48,$C0,$98,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$88,$F0,$24,$C0,$66,$F0,$24,$C0,$72,$F0,$24,$C0,$66,$F0,$24
    db $C0,$5A,$F0,$48,$D8
SfxClick:
    db $00,$00,$15,$01,$02,$36,$02,$23,$11,$10
SfxTock:
    db $82,$55,$20,$02,$23,$11,$90
SfxLift:
    db $41,$2C,$31,$06,$11,$E2,$50
SfxMove:
    db $80,$39,$40,$02,$90
SfxRefuse:
    db $42,$57,$23,$05,$24,$11,$50
SfxAgain:
    db $42,$AA,$00,$08,$14,$22,$42,$8F,$00,$08,$14,$22,$42,$71,$00,$08
    db $14,$22,$42,$55,$00,$10,$14,$32,$50
SfxStart:
    db $42,$AA,$00,$0A,$14,$22,$42,$8F,$00,$0A,$14,$22,$42,$71,$00,$0A
    db $14,$22,$42,$55,$00,$1E,$14,$32,$50
SfxWin:
    db $42,$AA,$00,$0C,$14,$22,$42,$8F,$00,$0C,$14,$22,$42,$71,$00,$0C
    db $14,$22,$42,$55,$00,$0C,$14,$22,$66,$42,$71,$00,$0C,$14,$22,$42
    db $55,$00,$30,$14,$32,$50
SfxLose:
    db $42,$71,$00,$18,$14,$32,$42,$8F,$00,$18,$14,$32,$42,$AA,$00,$18
    db $14,$32,$42,$E2,$00,$18,$14,$32,$42,$53,$01,$40,$14,$32,$50
SfxDraw:
    db $42,$AA,$00,$12,$14,$32,$42,$E2,$00,$12,$14,$32,$42,$AA,$00,$12
    db $14,$32,$42,$71,$00,$30,$14,$32,$50
SfxSlide:
    db $02,$36,$03,$14,$21,$10
SfxSolved:
    db $42,$7F,$00,$0A,$14,$22,$42,$6B,$00,$0A,$14,$22,$42,$55,$00,$0A
    db $14,$22,$42,$40,$00,$0A,$14,$22,$65,$42,$55,$00,$0A,$14,$22,$42
    db $40,$00,$28,$14,$32,$50
SfxFlip:
    db $00,$00,$25,$01,$02,$44,$02,$23,$11,$10
  }
end sub

' ShellForce (called only when Keep[15] = 77, which never happens): uses what the games use from Amy's runtime
' (number printing, 8 and 16-bit division, the sprite flicker switch), so
' the runtime part of the fixed bank is the same in every compile
sub ShellForce:
  print Wt at 2,2 width 3
  print Wf at 2,2 width 5
  Wt = Tx / 6
  Wt = Tx % 6
  Wf = Wf / Rs
  sprites flicker off
  return
end sub

' the end of the fixed bank (its ret is at $BFFF): the games start at $C000
sub ShellEnd:
  return
  asm {
    ds $BFFF-$,$FF
  }
end sub

' ---- the gate: the first bytes of the bank ($C000), the shell calls it
sub GameGate:
  asm {
    jp AMY_UPROC_TaquinMain
  }
end sub

' ---------------------------------------------------------------------------
' games/taquin.alexis - TAQUIN, the 15 puzzle (module of THE THINKER'S
' CABINET). ColecoVision version of the Oric game by Jean-Francois Sehan
' ("L'Oric a l'affiche", Editions du P.S.I., 1984), Amy & Claude 2026.
' Entry: TaquinMain (its card: START / < NUMBERS | PICTURE > / HOW TO PLAY /
' BACK), returns to the cabinet's menu.
'
' THE GAME (as in the book): a 4 x 4 tray, tiles 1-15 and a hole. The book
' mixes it with 128 random moves of the hole from the solved tray (lines
' 200-300), so every start can be solved. A tile next to the hole slides
' into it; ESSAIS counts the moves; solved = 1..15 in order, the hole last.
'
' LIBERTIES (listed for Amy):
' - Joystick instead of typing the tile's number: push, and the tile on
'   that side of the hole slides into it (held: it keeps sliding). Holding
'   the button 2 s gives up (back to the card).
' - The mix: the book's 128 random moves of the hole, but never straight
'   back (a better mix); mixed again if it ends solved.
' - Two looks: NUMBERS (ivory-like tiles, the ink colour tells the tile's
'   home row) and PICTURE (v2.1: a sunset over the sea with a sailboat, big
'   shapes; once solved, the 16th piece fills the hole).
' - Best score (fewest moves) kept per look while the cartridge runs.
' - Smooth slides: 4 pixels a frame (6 frames a move). The tray's 144 cells
'   each have their own tile code (128 + their index in their screen third),
'   so the moving tile is redrawn shifted, pixel by pixel; every tile row
'   has one ink on the wood, so the shifted rows keep two colours.
' ---------------------------------------------------------------------------

const TqX0 = 10          ' the tray: cols 10-21, rows 6-17
const TqY0 = 6

u8 QBoard[16]                ' slot (0-15, row by row) -> tile (0 = the hole)
u8 Qy0 = 0
u8 Qa0 = 0
u8 Qa1 = 0
u8 Qa2 = 0
u8 Qm2 = 0
data QZero bytes 0,0,0,0,0,0,0,0
data QWood bytes $AA,$AA,$AA,$AA,$AA,$AA,$AA,$AA
u8 QHole = 0
u8 QMode = 0             ' 0 numbers, 1 picture
u8 QMenu = 0
u8 QLast = 0
u8 Qcx = 0
u8 Qcy = 0
u8 Qi = 0
u8 Qj = 0
u8 Qm = 0
u8 Qr = 0
u8 Qs = 0
u8 Qt = 0
u8 Qb = 0
u8 Gx = 0
u8 Gy = 0
u8 Qk = 0
u8 Qbp = 0
u8 Qsh = 0
u8 Qcx0 = 0
u8 Qcy0 = 0
u8 QFrom = 0
u8 QTo = 0
u8 QDir = 0
u8 QHold = 0
u8 QDone = 0
u8 QGive = 0
u8 QRedraw = 0          ' test hook
u8 Qa = 0
u8 Qc = 0
u16 Wq = 0
u16 Wo = 0
u16 Wp = 0
u16 QMoves = 0
u16 QBestN = 0
u16 QBestP = 0

sub TaquinMain:
  ' kept in the shell's Keep[5..9]: the look and the two bests
  QMode = Keep[5]
  QBestN = Keep[7]
  QBestN = QBestN << 8
  QBestN += Keep[6]
  QBestP = Keep[9]
  QBestP = QBestP << 8
  QBestP += Keep[8]
tq_card:
  TaquinCard
  if QMenu = 3 then
    Keep[5] = QMode
    Keep[6] = lowbyte QBestN
    Keep[7] = highbyte QBestN
    Keep[8] = lowbyte QBestP
    Keep[9] = highbyte QBestP
    return
  end if
  if QMenu = 2 then
    TqHelpScreen
    goto tq_card
  end if
  TqPlay
  goto tq_card
end sub

' ------------------------------------------------------------ tiles
sub TqTilesLoad:
  fill mode 2 text color with $F0
  copy TqPat count TqBytes to vram.pattern + 1792
  copy TqPat count TqBytes to vram.pattern + 3840
  copy TqPat count TqBytes to vram.pattern + 5888
  copy TqCol count TqBytes to vram.color + 1792
  copy TqCol count TqBytes to vram.color + 3840
  copy TqCol count TqBytes to vram.color + 5888
  copy TlPat count TlBytes to vram.pattern + 1216
  copy TlCol count TlBytes to vram.color + 1216
  backdrop 12
  cls
  return
end sub

' cell Qcx,Qcy of the tray -> Wq (its pattern / colour offset)
sub QCellAddr:
  Qa = TqY0 + Qcy
  Qc = Qa >> 3
  Qa = Qa & 7
  if Qc = 0 then Qa -= 6
  Qa = Qa * 12
  Qa += Qcx
  Qa += 128
  Wq = Qa
  Wq = Wq << 3
  if Qc = 1 then Wq += 2048
  if Qc = 2 then Wq += 4096
  return
end sub

' the tray's cells get their own codes (rows Qcy 0..Qk-1)
sub QNames:
  for Qcy = 0 to Qk
    for Qcx = 0 to 11
      QCellAddr
      Wp = Wq >> 3
      Qt = lowbyte Wp
      Gx = TqX0 + Qcx
      Gy = TqY0 + Qcy
      put char Qt at Gx,Gy
    next
  next
  return
end sub

' Wo = the data of tile Qt in the current look
sub QTileData:
  Wo = Qt
  Wo = Wo * 96
  if QMode = 1 then Wo += 1536
  return
end sub

' draw slot Qs as it is
sub QDrawSlot:
  Qt = QBoard[Qs]
  QTileData
  Gx = Qs & 3
  Gx = Gx * 3
  Gy = Qs >> 2
  Gy = Gy * 3
  for Qj = 0 to 2
    for Qi = 0 to 2
      Qcx = Gx + Qi
      Qcy = Gy + Qj
      QCellAddr
      Qm = Qj * 3
      Qm += Qi
      Qm = Qm << 3
      Wp = Wo + Qm
      copy TqTiles + Wp count 8 to vram.pattern + Wq
      Qm = Qj << 3
      Qm += 72
      Wp = Wo + Qm
      copy TqTiles + Wp count 8 to vram.color + Wq
    next
  next
  return
end sub

sub QDrawAll:
  for Qs = 0 to 15
    QDrawSlot
  next
  return
end sub

' ------------------------------------------------------------ sliding
' The moving tile is unpacked once per slide into the shared Scr[]:
'   Scr[0..119]   its pattern, column by column, each column padded with 8
'                 empty rows above and below (3 x 40 bytes): any 8 rows
'                 of a cell moved by a multiple of 4 pixels down are 8
'                 consecutive bytes
'   Scr[120..159] its 24 row colours, padded the same way with plain wood
'   Scr[160..255] (sideways moves) the tile shifted 4 pixels right, as
'                 3 bands x 4 cells x 8 bytes
' so every frame of a slide is only copies to the VDP (4 pixels a frame).
sub QUnpack:
  Frame1
  Phase = 1
  for Qr = 0 to 119
    Scr[Qr] = 0
  next
  Frame1
  Phase = 1
  for Qr = 120 to 159
    Scr[Qr] = $AA
  next
  Frame1
  Phase = 1
  for Qi = 0 to 2
    for Qj = 0 to 2
      Qm = Qj * 3
      Qm += Qi
      Qm = Qm << 3
      Wp = Wo + Qm
      Qb = Qi * 40
      Qb += 8
      Qc = Qj << 3
      Qb += Qc
      for Qr = 0 to 7
        Scr[Qb] = TqTiles[Wp]
        inc Wp
        inc Qb
      next
    next
  next
  Wp = Wo + 72
  Qb = 128
  for Qr = 0 to 23
    Scr[Qb] = TqTiles[Wp]
    inc Wp
    inc Qb
  next
  return
end sub

' the 4-pixel shifted copy for sideways moves (Scr[160..255])
sub QShift4:
  for Qj = 0 to 2
    for Qr = 0 to 7
      Qy0 = Qj << 3
      Qy0 += Qr
      Qy0 += 8
      Qa0 = Scr[Qy0]
      Qy0 += 40
      Qa1 = Scr[Qy0]
      Qy0 += 40
      Qa2 = Scr[Qy0]
      Qb = Qj << 5
      Qb += 160
      Qb += Qr
      Scr[Qb] = Qa0 >> 4
      Qb += 8
      Qc = Qa0 << 4
      Qm = Qa1 >> 4
      Scr[Qb] = Qc | Qm
      Qb += 8
      Qc = Qa1 << 4
      Qm = Qa2 >> 4
      Scr[Qb] = Qc | Qm
      Qb += 8
      Scr[Qb] = Qa2 << 4
    next
  next
  return
end sub

' slide the tile of slot QFrom into the hole QTo, 4 pixels a frame
sub QSlide:
  Qt = QBoard[QFrom]
  QTileData
  QUnpack
  play sound SndSlide
  Gx = QFrom & 3
  Gy = QTo & 3
  if Gx <> Gy then
    Frame1
    Phase = 1
    QShift4
    ' sideways: the 6 x 3 cells of both slots; the colours once
    Qcy0 = QFrom >> 2
    Qcy0 = Qcy0 * 3
    Qcx0 = Gx
    if Gy < Gx then Qcx0 = Gy
    Qcx0 = Qcx0 * 3
    for Qj = 0 to 2
      Qcx = Qcx0
      Qcy = Qcy0 + Qj
      QCellAddr
      Qm = Qj << 3
      Qm += 128
      for Qi = 0 to 5
        copy Scr + Qm count 8 to vram.color + Wq
        Wq += 8
      next
    next
    for Qk = 1 to 6
      Frame1
      Phase = 1
      Gx = Qk << 2
      if QFrom > QTo then Gx = 24 - Gx
      QRenderH
    next
  else
    ' up or down: the 3 x 6 cells of both slots
    Qcx0 = Gx * 3
    Qcy0 = QFrom
    if QTo < QFrom then Qcy0 = QTo
    Qcy0 = Qcy0 >> 2
    Qcy0 = Qcy0 * 3
    for Qk = 1 to 6
      Frame1
      Phase = 1
      Gy = Qk << 2
      if QFrom > QTo then Gy = 24 - Gy
      QRenderV
    next
  end if
  QBoard[QTo] = QBoard[QFrom]
  QBoard[QFrom] = 0
  Frame1
  Phase = 1
  Qs = QTo
  QDrawSlot
  Frame1
  Phase = 1
  Qs = QFrom
  QDrawSlot
  QHole = QFrom
  return
end sub

' the tile Gx pixels (a multiple of 4) into the band of 6 x 3 cells
sub QRenderH:
  Qbp = Gx >> 3
  Qsh = Gx & 7
  for Qj = 0 to 2
    Qcx = Qcx0
    Qcy = Qcy0 + Qj
    QCellAddr
    for Qc = 0 to 5
      Qy0 = 99
      if Qc >= Qbp then
        Qm = Qc - Qbp
        if Qsh = 0 then
          if Qm < 3 then
            Qy0 = Qm * 40
            Qy0 += 8
            Qa0 = Qj << 3
            Qy0 += Qa0
          end if
        else
          if Qm < 4 then
            Qy0 = Qj << 5
            Qy0 += 160
            Qa0 = Qm << 3
            Qy0 += Qa0
          end if
        end if
      end if
      if Qy0 = 99 then
        copy QZero count 8 to vram.pattern + Wq
      else
        copy Scr + Qy0 count 8 to vram.pattern + Wq
      end if
      Wq += 8
    next
  next
  return
end sub

' the tile Gy pixels (a multiple of 4) down the band of 3 x 6 cells
sub QRenderV:
  for Qj = 0 to 5
    Qcx = Qcx0
    Qcy = Qcy0 + Qj
    QCellAddr
    ' the cell row shows tile rows Qy0-8 .. Qy0-1 (8 = the padding)
    Qy0 = Qj << 3
    Qy0 += 8
    Qy0 -= Gy
    Qm2 = 99
    if Qy0 < 32 then Qm2 = Qy0
    Qa0 = Qy0 + 120
    for Qi = 0 to 2
      if Qm2 = 99 then
        copy QZero count 8 to vram.pattern + Wq
        copy QWood count 8 to vram.color + Wq
      else
        copy Scr + Qm2 count 8 to vram.pattern + Wq
        copy Scr + Qa0 count 8 to vram.color + Wq
        Qm2 += 40
      end if
      Wq += 8
    next
  next
  return
end sub

' ------------------------------------------------------------ the rules
' the book's mix: 128 random moves of the hole (never straight back)
sub QShuffle:
qs_again:
  for Qs = 0 to 14
    QBoard[Qs] = Qs + 1
  next
  QBoard[15] = 0
  QHole = 15
  QLast = 99
  for Qk = 1 to 128
qs_pick:
    Rnd
    QDir = R2 & 3
    Qs = QHole & 3
    Qt = QHole
    if QDir = 0 then
      if QHole < 4 then goto qs_pick
      Qt -= 4
    end if
    if QDir = 1 then
      if QHole >= 12 then goto qs_pick
      Qt += 4
    end if
    if QDir = 2 then
      if Qs = 0 then goto qs_pick
      dec Qt
    end if
    if QDir = 3 then
      if Qs = 3 then goto qs_pick
      inc Qt
    end if
    if Qt = QLast then goto qs_pick
    QBoard[QHole] = QBoard[Qt]
    QBoard[Qt] = 0
    QLast = QHole
    QHole = Qt
  next
  QSolvedTest
  if QDone = 1 then goto qs_again
  return
end sub

sub QSolvedTest:
  QDone = 1
  for Qs = 0 to 14
    Qt = Qs + 1
    if QBoard[Qs] <> Qt then QDone = 0
  next
  return
end sub

' ------------------------------------------------------------ the game
sub QFrame:
  fill TqFh count 12 at 10,5
  fill TqFb count 12 at 10,18
  for Gy = 6 to 17
    put char TqFl at 9,Gy
    put char TqFr at 22,Gy
  next
  put char TqFtl at 9,5
  put char TqFtr at 22,5
  put char TqFbl at 9,18
  put char TqFbr at 22,18
  return
end sub

sub QLogo:
  for Y = 0 to Logo4H - 1
    V = Y * Logo4W
    J = Y + 1
    put Logo4 + V count Logo4W at 10,J
  next
  return
end sub

sub QHud:
  put char TqHmov at 3,20
  print QMoves at 5,20 width 4
  put char TqHtro at 21,20
  Wp = QBestN
  if QMode = 1 then Wp = QBestP
  if Wp = 0 then
    print at 23,20, "----"
  else
    print Wp at 23,20 width 4
  end if
  if QMode = 0 then
    put char TqHnum at 3,22
    print at 5,22, "NUMBERS"
  else
    put char TqHpic at 3,22
    print at 5,22, "PICTURE"
  end if
  return
end sub

sub TqPlay:
  BlankScreen
  TqTilesLoad
  QLogo
  QFrame
  Qk = 11
  QNames
  QShuffle
  QDrawAll
  QMoves = 0
  QHud
  ShowScreen
  nmi off
  play sound SndMqLead
  play sound SndMqTwo
  play sound SndMqNoise
  play sound SndMqPitch
  nmi on
  nmi off
  QHold = 0
  QGive = 0
  WaitIn = 1
tq_loop:
  Frame1
  Phase = 1
  ReadPad
  ' hold the button 2 s: give up
  if Btn = 1 then
    inc QHold
    if QHold >= 120 then
      QGive = 1
      goto tq_end
    end if
  else
    QHold = 0
  end if
  ' test hook (bots): QRedraw = 1 redraws the tray from RAM
  if QRedraw = 1 then
    Phase = 5
    QRedraw = 0
    QDrawAll
    goto tq_loop
  end if
  if StickHit = 0 then goto tq_loop
  QTo = QHole
  QFrom = 99
  Qs = QHole & 3
  if Lf1 = 1 then
    if Qs < 3 then QFrom = QHole + 1
  end if
  if Rt1 = 1 then
    if Qs > 0 then QFrom = QHole - 1
  end if
  if Up1 = 1 then
    if QHole < 12 then QFrom = QHole + 4
  end if
  if Dn1 = 1 then
    if QHole >= 4 then QFrom = QHole - 4
  end if
  if QFrom = 99 then
    play sound SndRefuse
    goto tq_loop
  end if
  WaitIn = 0
  QSlide
  inc QMoves
  print QMoves at 5,20 width 4
  WaitIn = 1
  QSolvedTest
  if QDone = 0 then goto tq_loop
tq_end:
  WaitIn = 0
  Phase = 0
  StopMusic
  fill 32 count 26 at 3,20
  if QGive = 1 then
    play sound SndRefuse
    print at 9,20, "MAYBE NEXT TIME"
  else
    play sound SndSolved
    ' the picture: its 16th piece fills the hole, one whole image
    if QMode = 1 then
      QBoard[15] = 16
      Qs = 15
      QDrawSlot
    end if
    print at 5,20, "SOLVED IN"
    print QMoves at 15,20 width 4
    print at 20,20, "MOVES!"
    if QMode = 0 then
      if QBestN = 0 then QBestN = QMoves
      if QMoves < QBestN then QBestN = QMoves
    else
      if QBestP = 0 then QBestP = QMoves
      if QMoves < QBestP then QBestP = QMoves
    end if
  end if
  for Wt = 1 to 90
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' ------------------------------------------------------------ TAQUIN's card
sub TaquinCard:
  BlankScreen
  TqTilesLoad
  QLogo
  ' a preview: the tray's top row, tiles 1-4 in the chosen look
  Qk = 2
  QNames
  QCardRow
  print at 7,10, "ORIGINAL GAME BY"
  print at 6,11, "JEAN-FRANCOIS SEHAN"
  print at 11,13, "START"
  print at 11,15, "LOOK"
  print at 11,17, "HOW TO PLAY"
  print at 11,19, "BACK"
  print at 8,21, "AMY & CLAUDE 2026"
  QShowMode
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  QMenu = 0
  Phase = 4
  Rearm
  wait no fire
  WasBtn = 0
  nmi off
qc_loop:
  Frame1
  ReadPad
  Rnd
  V = QMenu << 4
  V += 100
  set sprite 0 to V,70,SpCu0,SpCuC0
  set sprite 1 to V,70,SpCu1,SpCuC1
  update sprites
  if StickHit = 1 then
    if Up1 = 1 then
      if QMenu = 0 then
        QMenu = 3
      else
        dec QMenu
      end if
      play sound SndMove
    end if
    if Dn1 = 1 then
      inc QMenu
      if QMenu > 3 then QMenu = 0
      play sound SndMove
    end if
    if QMenu = 1 then
      if Lf1 = 1 then QMode = QMode ^ 1
      if Rt1 = 1 then QMode = QMode ^ 1
      if Lf1 = 1 then QCardRow
      if Rt1 = 1 then QCardRow
      QShowMode
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto qc_loop
  if QMenu = 1 then goto qc_loop
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub QCardRow:
  for Qs = 0 to 3
    QBoard[Qs] = Qs + 1
    QDrawSlot
  next
  return
end sub

sub QShowMode:
  if QMode = 0 then
    print at 17,15, "< NUMBERS >"
  else
    print at 17,15, "< PICTURE >"
  end if
  return
end sub

sub TqHelpScreen:
  BlankScreen
  TqTilesLoad
  PageTqHelp
  put char TqHstick at 3,9
  put char TqHbtn at 3,13
  put char TqHmov at 2,15
  put char TqHtro at 3,15
  put char TqHnum at 3,17
  put char TqHpic at 3,19
  WaitPage
  return
end sub

' the end of this game's code in its bank (build.py: the literal pool after it
' starts at the same address in every bank, the shell's strings first)
sub TqEnd:
  return
  asm {
    ds $DC00-$,$FF
  }
end sub

u8 RamPadTaquin[96]   ' build.py: same RAM end in every bank

' text pages (generated by _common/tools/textpages.py)
sub PageTqHelp:
  print at 6,1, "TAQUIN  HOW TO PLAY"
  print at 2,3, "THE 15 PUZZLE: FIFTEEN"
  print at 2,4, "TILES AND ONE HOLE IN A"
  print at 2,5, "4 X 4 TRAY. SLIDE THEM BACK"
  print at 2,6, "INTO ORDER, 1 TO 15, THE"
  print at 2,7, "HOLE IN THE LAST CORNER."
  print at 5,9, "JOYSTICK: THE TILE NEXT"
  print at 5,10, "TO THE HOLE SLIDES IN,"
  print at 5,11, "THE WAY YOU PUSH."
  print at 5,13, "HOLD THE BUTTON: GIVE UP."
  print at 5,15, "MOVES, AND YOUR BEST."
  print at 5,17, "NUMBERS: THE COLOUR TELLS"
  print at 5,18, "THE ROW OF A TILE."
  print at 5,19, "PICTURE: A SUNSET AT SEA."
  print at 2,21, "EVERY MIX CAN BE SOLVED."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

data TqPat bytes
