' One value per numeric family.
u8 U8Value = 250
i8 S8Value = -5
u16 U16Value = 60000
i16 S16Value = -300
u32 U32Value = 100001
i32 S32Value = -123456
fixed FxValue = 1.5
bcd digits 6 DecScore

' Amy Compare Fixed Demo
  text screen
  clear DecScore
  DecScore += 101345
  screen on
  print at 7,0, "NUMERIC TO ASCII"
  print at 1,4, "U8"
  print U8Value at 6,4 digits 3
  print at 1,6, "S8"
  print S8Value at 6,6 digits 4
  print at 1,8, "U16"
  print U16Value at 6,8 digits 5
  print at 1,10, "S16"
  print S16Value at 6,10 digits 6
  print at 1,12, "U32"
  print U32Value at 6,12
  print at 1,14, "S32"
  print S32Value at 6,14 digits 11
  print at 1,16, "BCD"
  print DecScore at 6,16
  print at 1,18, "FX"
  print FxValue at 6,18
  screen on