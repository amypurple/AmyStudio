record Cursor:
  u8 I
  u8 L
  u8 X
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the listing's board: B(0) my bar, B(1..24) points (+ mine, - yours),
' B(25) mine borne off; PB your bar (0 or less), PO yours borne off
i8 B[26]
i8 Pb = 0
u8 Po = 0
u8 R[4]
' the computer's choice (H weight, HP point, HR die) and OB (may bear off)
u8 H = 0
u8 Hp = 0
u8 Hr = 0
u8 Ob = 0
' the computer's moves this turn, for the bot: point and die
u8 CLogN = 0
u8 CLogF[8]
u8 CLogD[8]
' the moves the player may choose from: location, column, top half, die
u8 NCand = 0
u8 Cand[16]
u8 CCol[16]
u8 CTop[16]
u8 CDie[16]
Cursor Cur
u8 Sel = 0
u8 Src = 0
' pips and games won
u16 PipY = 0
u16 PipC = 0
bcd digits 4 Wins
bcd digits 4 Losses
' game state: 0 title, 1 computer's turn, 2 your choice, 3 busy, 4 over;
' Res 1 you won, 2 the computer won; MeFirst from the title menu
u8 Gs = 0
u8 Res = 0
u8 MeFirst = 1
u8 Menu = 0
u8 Tick = 0
u8 Rpt = 0
' glide
u8 Gx = 0
u8 Gy = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Back = 0
u8 WasBack = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Ci = 0
' scratch
u8 J = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title
  MeFirst = 1
  if Menu = 1 then MeFirst = 0

  NewGame
  if MeFirst = 1 then
    CompTurn
  end if

play_loop:
  if Gs = 4 then goto game_end
  PlayerTurn
  if Gs = 4 then goto game_end
  CompTurn
  goto play_loop

game_end:
  HideSprites
  if Res = 1 then
    inc Wins
    print at 2,22, " YOU WIN. ALL FIFTEEN OFF! "
    play sound SndWon
  else
    inc Losses
    print at 2,22, "   I WIN. TRY AGAIN SOON.   "
    play sound SndLost
  end if
  ShowPips
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the board

' screen column (left of the two) of a location
function LocCol(u8 L) as u8
  select case L
  case 13 to 18
    return (L - 13) * 2 + 2
  case 19 to 24
    return (L - 19) * 2 + 16
  case 7 to 12
    return (12 - L) * 2 + 2
  case 1 to 6
    return (6 - L) * 2 + 16
  case LBarP, LBarC
    return 14
  end select
  return 28

' 1 for the top half of the board
function LocTop(u8 L) as u8
  if L >= 13 then
    if L <= 25 then return 1
  end if
  if L = LOffC then return 1
  return 0

' how many checkers stand there
function LocCount(u8 L) as u8
  i8 Bv = 0
  if L = LBarP then return 0 - Pb
  if L = LOffP then return Po
  if L = LBarC then return B[0]
  if L = LOffC then return B[25]
  Bv = B[L]
  if Bv < 0 then return 0 - Bv
  return Bv

' four tiles T, T+1 (top row), T+2, T+3 (bottom row) at Px, Py
sub Quad(u8 T, u8 Px, u8 Py):
  put char T at Px,Py
  put char T + 1 at Px + 1,Py
  put char T + 2 at Px,Py + 1
  put char T + 3 at Px + 1,Py + 1
  return
end sub

' a checker of Side, with the count N on it when N is 5 or more
sub Checker(u8 Side, u8 N, u8 Px, u8 Py):
  u8 T = 0
  u8 Td = 0
  T = Side * 4 + TChk
  if N < 5 then
    Quad(T, Px, Py)
    return
  end if
  Td = N % 10
  Td = (Side * 10 + Td) * 2 + TDig
  if N >= 10 then
    put char Side * 2 + TOne at Px,Py
    put char Side * 2 + TOne + 1 at Px,Py + 1
  else
    put char T at Px,Py
    put char T + 2 at Px,Py + 1
  end if
  put char Td at Px + 1,Py
  put char Td + 1 at Px + 1,Py + 1
  return
end sub

' the tile row of slot S (0 at the edge of the board)
function SlotRow(u8 Top, u8 S) as u8
  if Top = 1 then return S * 2 + 2
  return 20 - S * 2

sub DrawLoc(u8 L):
  u8 Col = 0
  u8 Top = 0
  u8 N = 0
  u8 Side = 0
  u8 Tn = 0
  u8 S = 0
  u8 Row = 0
  u8 T = 0
  u8 K = 0
  Col = LocCol(L)
  Top = LocTop(L)
  N = LocCount(L)
  if L = LOffP or L = LOffC then
    ' the tray: two slabs to a tile row, from the edge inward
    Side = 0
    if L = LOffC then Side = 1
    for S = 0 to 7
      Row = 21 - S
      if Top = 1 then Row = S + 2
      T = TTray
      if N >= 2 then
        T = Side * 3 + TSlab
        N = N - 2
      elseif N = 1 then
        T = Side * 3 + TSlab + 2
        if Top = 1 then T = T - 1
        N = 0
      end if
      put char T at Col,Row
      put char T at Col + 1,Row
    next
    return
  end if
  Side = 0
  if L = LBarC then Side = 1
  if L <= 24 then
    if B[L] > 0 then Side = 1
  end if
  Tn = (Col / 2 + Top) & 1
  for S = 0 to 3
    Row = SlotRow(Top, S)
    if Top = 1 then
      K = 0
    else
      K = 1
    end if
    if S < N then
      K = N
      if S < 3 then K = 1
      Checker(Side, K, Col, Row)
    elseif L = LBarP or L = LBarC then
      put char TBarl at Col,Row
      put char TBarr at Col + 1,Row
      put char TBarl at Col,Row + 1
      put char TBarr at Col + 1,Row + 1
    else
      T = ((Tn * 2 + K) * 4 + S) * 4 + TTri
      Quad(T, Col, Row)
    end if
  next
  return
end sub

sub DrawBoard:
  u8 L = 0
  for L = 1 to LOffC
    DrawLoc(L)
  next
  ' the bar between the halves' middle rows
  for L = 10 to 13
    put char TBarl at 14,L
    put char TBarr at 15,L
    put char TTray at 28,L
    put char TTray at 29,L
  next
  return
end sub

' pixel place (Gx, Gy) of the checker number S (0 = at the edge) of L
sub SlotPos(u8 L, u8 S):
  u8 Top = 0
  u8 Q = 0
  Top = LocTop(L)
  Gx = LocCol(L) * 8
  if L = LOffP or L = LOffC then
    Q = S / 2
    if Top = 1 then
      Gy = Q * 8 + 12
    else
      Gy = 164 - Q * 8
    end if
    return
  end if
  if S > 3 then S = 3
  Gy = SlotRow(Top, S) * 8
  return
end sub

' ---------------------------------------------------------------------------
' the computer (the listing's lines 400-820)

' the weight of moving from Px with die D (index Dy) to Tg, 0 if not legal
function Weigh1(u8 Px, u8 D, u8 Dy, u8 Tg) as u8
  u8 E = 0
  u8 Zi = 0
  u8 Bk = 0
  u8 Rz = 0
  i8 Bs = 0
  i8 Bt = 0
  Bs = B[Px]
  Bt = B[Tg]
  if Px = 0 then E = E + 128
  if Tg = 25 then E = E + 64
  if Bs = 1 and Bt = 1 then E = E + 32
  if Bs <> 2 and Bt > 0 then E = E + 16
  if Bt = -1 then E = E + 8
  if Px < 19 then E = E + 4
  if Bt < -1 then return 0
  if Ob = 0 and Tg = 25 then return 0
  E = E + 1
  if Dy = 3 or Tg = 25 or Bt > 0 then return E
  ' another die could bring a checker onto the landing later
  for Zi = Dy + 1 to 3
    Rz = R[Zi]
    if Rz > 0 and Tg >= Rz then
      Bk = Tg - Rz
      if B[Bk] > 0 then return E + 2
    end if
  next
  return E

sub Weigh:
  u8 Dy = 0
  u8 Px = 0
  u8 D = 0
  u8 E = 0
  u8 Tg = 0
  Ob = 1
  for Px = 0 to 18
    if B[Px] > 0 then Ob = 0
  next
  H = 0
  Hp = 0
  Hr = 0
  for Dy = 0 to 3
    D = R[Dy]
    if D > 0 then
      for Px = 0 to 24
        Tg = Px + D
        if B[Px] >= 1 and Tg <= 25 then
          E = Weigh1(Px, D, Dy, Tg)
          if E > H then
            H = E
            Hr = D
            Hp = Px
          end if
        end if
      next
    end if
  next
  return
end sub

' 1 if one of my checkers stands on 0 .. Lim (the listing's line 640)
function MineUpTo(u8 Lim) as u8
  u8 Px = 0
  for Px = 0 to Lim
    if B[Px] > 0 then return 1
  next
  return 0

' after Weigh: 0 a move is chosen (Hp, Hr), 1 no move, 2 a die was
' changed for an exact bear-off (weigh again; lines 590-670)
function CompPick as u8
  u8 Lr = 7
  u8 Ln = 0
  u8 Dy = 0
  u8 Px = 0
  if H < 128 and B[0] > 0 then return 1
  if H > 0 then return 0
  for Dy = 0 to 3
    if R[Dy] < Lr and R[Dy] > 1 then
      Lr = R[Dy]
      Ln = Dy
    end if
  next
  if Lr = 7 then return 1
  if MineUpTo(25 - Lr) = 1 then return 1
  for Px = 26 - Lr to 24
    if B[Px] > 0 then
      R[Ln] = 25 - Px
      return 2
    end if
  next
  return 1

function DiceLeft as u8
  u8 Dy = 0
  u8 N = 0
  for Dy = 0 to 3
    if R[Dy] > 0 then inc N
  next
  return N

' one computer move from Hp with die Hr (lines 700-800)
sub CompMove:
  u8 Dy = 0
  u8 Tg = 0
  u8 Fl = 0
  u8 Tl = 0
  u8 N = 0
  for Dy = 0 to 3
    if R[Dy] = Hr then exit for
  next
  R[Dy] = 0
  ShowDice(1)
  CLogF[CLogN] = Hp
  CLogD[CLogN] = Hr
  if CLogN < 7 then inc CLogN
  Tg = Hp + Hr
  Fl = Hp
  if Hp = 0 then Fl = LBarC
  Tl = Tg
  if Tg = 25 then Tl = LOffC
  ' lift it
  N = LocCount(Fl)
  SlotPos(Fl, N - 1)
  B[Hp] = B[Hp] - 1
  DrawLoc(Fl)
  ' glide to the landing
  N = LocCount(Tl)
  if Tg < 25 then
    if B[Tg] < 0 then N = 0
  end if
  Glide(Fl, N, Tl, 1)
  if Tg < 25 then
    if B[Tg] = -1 then
      ' your blot goes to the bar
      B[Tg] = 0
      Pb = Pb - 1
      DrawLoc(Tg)
      play sound SndHit
      SlotPos(Tg, 0)
      N = 0 - Pb
      GlideFrom(LBarP, N - 1, 0)
      DrawLoc(LBarP)
    end if
  end if
  B[Tg] = B[Tg] + 1
  DrawLoc(Tl)
  HideMover
  if Tg = 25 then
    play sound SndOff
  else
    play sound SndDrop
  end if
  ShowPips
  Pause(16)
  return
end sub

sub CompTurn:
  u8 Going = 1
  u8 St = 0
  RollDice(1)
  CLogN = 0
  print at 2,22, "        MY ROLL...          "
  Gs = 1
  Pause(40)
  while Going = 1
    if DiceLeft = 0 then
      Going = 0
    else
      Weigh
      St = CompPick
      if St = 0 then
        CompMove
        if B[25] = 15 then
          Res = 2
          Going = 0
        end if
      elseif St = 1 then
        print at 2,22, "     I CAN NOT MOVE.        "
        play sound SndNoMove
        Pause(70)
        Going = 0
      end if
    end if
  end while
  fill array R with 0
  ShowDice(1)
  Gs = 3
  if Res = 2 then Gs = 4
  return
end sub

' ---------------------------------------------------------------------------
' you (the listing's lines 830-1130, with the moves listed for the cursor)

' 1 if one of your checkers stands on Lo .. 24
function YoursFrom(u8 Lo) as u8
  u8 Px = 0
  for Px = Lo to 24
    if B[Px] < 0 then return 1
  next
  return 0

' the die index that bears off from point Hx, or 255 (lines 940-980)
function OffDie(u8 Hx) as u8
  u8 Dy = 0
  for Dy = 0 to 3
    if R[Dy] = Hx then
      if YoursFrom(7) = 1 then return 255
      return Dy
    end if
  next
  for Dy = 0 to 3
    if R[Dy] > Hx then
      if YoursFrom(Hx + 1) = 1 then return 255
      return Dy
    end if
  next
  return 255

sub AddCand(u8 L, u8 Dy):
  u8 I = 0
  I = 0
  while I < NCand
    if Cand[I] = L then return
    inc I
  end while
  Cand[NCand] = L
  CCol[NCand] = LocCol(L)
  CTop[NCand] = LocTop(L)
  CDie[NCand] = Dy
  inc NCand
  return
end sub

' where a checker of yours on Hx may go (lines 930-990)
sub Targets(u8 Hx):
  u8 Dy = 0
  u8 D = 0
  u8 Tg = 0
  u8 Od = 0
  NCand = 0
  for Dy = 0 to 3
    D = R[Dy]
    if D > 0 then
      if Hx > D then
        Tg = Hx - D
        if B[Tg] <= 1 then AddCand(Tg, Dy)
      else
        Od = OffDie(Hx)
        if Od < 255 then AddCand(LOffP, Od)
      end if
    end if
  next
  return
end sub

' the checkers of yours that can move (the bar first)
sub Sources:
  u8 Px = 0
  u8 N = 0
  u8 Ok[16]
  N = 0
  if Pb < 0 then
    Targets(25)
    if NCand > 0 then
      Ok[0] = LBarP
      N = 1
    end if
  else
    for Px = 24 to 1 step -1
      if B[Px] < 0 then
        Targets(Px)
        if NCand > 0 and N < 16 then
          Ok[N] = Px
          inc N
        end if
      end if
    next
  end if
  NCand = 0
  while NCand < N
    Px = Ok[NCand]
    Cand[NCand] = Px
    CCol[NCand] = LocCol(Px)
    CTop[NCand] = LocTop(Px)
    CDie[NCand] = 0
    inc NCand
  end while
  return
end sub

' put the cursor frame on candidate I
sub CurTo(u8 I):
  u8 L = 0
  u8 N = 0
  Cur.I = I
  L = Cand[I]
  Cur.L = L
  N = LocCount(L)
  if Sel = 1 then
    ' where the checker would land
    if L = LOffP then
      N = Po
    elseif B[L] >= 0 then
      N = 0
    end if
  else
    if N > 0 then N = N - 1
  end if
  SlotPos(L, N)
  Cur.X = Gx
  Cur.Y = Gy
  return
end sub

' the stick: the nearest candidate that way
sub CurMove(u8 St):
  u8 I = 0
  u8 Best = 255
  u8 Bd = 255
  u8 Dd = 0
  u8 Cc = 0
  u8 Ct = 0
  u8 Ic = 0
  u8 It = 0
  Cc = CCol[Cur.I]
  Ct = CTop[Cur.I]
  I = 0
  while I < NCand
    Ic = CCol[I]
    It = CTop[I]
    if (St & 3) > 0 then
      ' up to the top half, down to the bottom half
      V = 0
      if (St & 1) > 0 then V = 1
      if It = V and Ct <> V then
        if Ic > Cc then
          Dd = Ic - Cc
        else
          Dd = Cc - Ic
        end if
        if Dd < Bd then
          Bd = Dd
          Best = I
        end if
      end if
    elseif It = Ct then
      if (St & 8) > 0 and Ic > Cc then
        Dd = Ic - Cc
        if Dd < Bd then
          Bd = Dd
          Best = I
        end if
      end if
      if (St & 4) > 0 and Ic < Cc then
        Dd = Cc - Ic
        if Dd < Bd then
          Bd = Dd
          Best = I
        end if
      end if
    end if
    inc I
  end while
  if Best = 255 then
    play sound SndBump
  else
    play sound SndStep
    CurTo(Best)
  end if
  return
end sub

' your move from Src with die index Dy to location Tl (lines 990-1110)
sub YourMove(u8 Dy, u8 Tl):
  u8 Tg = 0
  u8 N = 0
  u8 Fl = 0
  Fl = Src
  Tg = 0
  if Tl <> LOffP then Tg = Tl
  R[Dy] = 0
  ShowDice(0)
  N = LocCount(Fl)
  SlotPos(Fl, N - 1)
  if Src = 25 then
    Pb = Pb + 1
  else
    B[Src] = B[Src] + 1
  end if
  DrawLoc(Fl)
  N = Po
  if Tg > 0 then
    N = 0
    if B[Tg] < 0 then N = 0 - B[Tg]
  end if
  Glide(Fl, N, Tl, 0)
  if Tg > 0 then
    if B[Tg] > 0 then
      ' my blot goes to the bar
      B[Tg] = 0
      B[0] = B[0] + 1
      DrawLoc(Tg)
      play sound SndHit
      SlotPos(Tg, 0)
      N = B[0]
      GlideFrom(LBarC, N - 1, 1)
      DrawLoc(LBarC)
    end if
    B[Tg] = B[Tg] - 1
    play sound SndDrop
  else
    inc Po
    play sound SndOff
    if Po = 15 then Res = 1
  end if
  DrawLoc(Tl)
  HideMover
  ShowPips
  return
end sub

sub PlayerTurn:
  u8 Going = 1
  Gs = 3
  RollDice(0)
  while Going = 1
    if DiceLeft = 0 then
      Going = 0
    else
      Sel = 0
      Sources
      if NCand = 0 then
        print at 2,22, "    YOU CAN NOT MOVE.       "
        play sound SndNoMove
        Pause(80)
        Going = 0
      else
        print at 2,22, " PICK A CHECKER TO MOVE.    "
        CurTo(0)
        Choose1
        if Res = 1 then Going = 0
      end if
    end if
  end while
  fill array R with 0
  ShowDice(0)
  HideCursor
  Gs = 3
  if Res = 1 then Gs = 4
  return
end sub

' the cursor loop for one move: pick, then place (or put back)
sub Choose1:
  u8 Done = 0
  Gs = 2
  Rpt = 0
  WasStick = 0
  while Done = 0
    Frame1
    ReadPad
    MoveInput
    DrawCursor
    if Press = 1 then
      if Sel = 0 then
        Src = Cur.L
        play sound SndPick
        set sprite SpPick to Cur.Y - 1,Cur.X,SPick,13
        Targets(Src)
        Sel = 1
        print at 2,22, "WHERE TO? RIGHT BUTTON: BACK"
        CurTo(0)
      else
        Gs = 3
        HideCursor
        YourMove(CDie[Cur.I], Cur.L)
        Done = 1
      end if
    elseif Back = 1 and Sel = 1 then
      play sound SndBump
      Sel = 0
      set sprite SpPick to 192,0,0,0
      Sources
      print at 2,22, " PICK A CHECKER TO MOVE.    "
      CurTo(0)
    end if
  end while
  return
end sub

sub MoveInput:
  u8 St = 0
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
  elseif Rpt > 0 then
    dec Rpt
  else
    if WasStick = 0 then
      Rpt = 14
    else
      Rpt = 8
    end if
    CurMove(St)
  end if
  WasStick = St
  return
end sub

' ---------------------------------------------------------------------------
' dice, pips, messages, gliding checkers

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

function Die as u8
  W16 = Rand
  return W16 % 6 + 1

' Me 1: the computer's roll (left half), 0: yours (right half)
sub RollDice(u8 Me):
  u8 K = 0
  play sound SndRoll
  for K = 0 to 11
    R[0] = Die
    R[1] = Die
    R[2] = 0
    R[3] = 0
    ShowDice(Me)
    Frame1
    Frame1
  next
  R[0] = Die
  R[1] = Die
  R[2] = 0
  R[3] = 0
  if R[0] = R[1] then
    R[2] = R[0]
    R[3] = R[0]
  end if
  ShowDice(Me)
  Frame1
  return
end sub

sub ShowDice(u8 Me):
  u8 K = 0
  u8 Dx = 0
  u8 C = 15
  u8 P = 0
  Dx = 138
  if Me = 1 then
    Dx = 26
    C = 14
  end if
  for K = 0 to 3
    P = R[K]
    if P > 0 then
      P = (P - 1) * 4 + SDie1
      set sprite K + SpDie to 88,Dx,P,C
    else
      set sprite K + SpDie to 192,0,0,0
    end if
    Dx = Dx + 20
  next
  update sprites
  return
end sub

' the pip counts (how far each side still has to go)
sub ShowPips:
  u8 P = 0
  u8 W = 0
  i8 Bv = 0
  PipY = 0
  PipC = 0
  for P = 1 to 24
    Bv = B[P]
    if Bv < 0 then
      W = 0 - Bv
      PipY = PipY + W * P
    elseif Bv > 0 then
      PipC = PipC + Bv * (25 - P)
    end if
  next
  W = 0 - Pb
  PipY = PipY + W * 25
  W = B[0]
  PipC = PipC + W * 25
  print at 2,1, "YOU ", digits$(PipY, 3), " PIPS"
  print at 18,1, "ME ", digits$(PipC, 3), " PIPS"
  return
end sub

' the moving checker glides from (Gx, Gy) to slot S of L; Side 1 me
sub Glide(u8 Fl, u8 S, u8 Tl, u8 Side):
  u8 Sx = 0
  u8 Sy = 0
  Sx = Gx
  Sy = Gy
  SlotPos(Tl, S)
  GlideXY(Sx, Sy, Gx, Gy, SpMove, Side)
  return
end sub

' a hit blot glides from (Gx, Gy) to slot S of bar L
sub GlideFrom(u8 L, u8 S, u8 Side):
  u8 Sx = 0
  u8 Sy = 0
  Sx = Gx
  Sy = Gy
  SlotPos(L, S)
  GlideXY(Sx, Sy, Gx, Gy, SpBlot, Side)
  set sprite SpBlot to 192,0,0,0
  update sprites
  return
end sub

sub GlideXY(u8 X0, u8 Y0, u8 X1, u8 Y1, u8 Sp, u8 Side):
  u8 K = 0
  u8 N = 0
  u8 C = 15
  i16 Dx = 0
  i16 Dy = 0
  i16 Px = 0
  i16 Py = 0
  u8 Ax = 0
  u8 Ay = 0
  if Side = 1 then C = 1
  Dx = X1 - X0
  Dy = Y1 - Y0
  N = 8
  if abs(Dx) > 96 or abs(Dy) > 96 then N = 14
  for K = 1 to N
    Px = Dx * K / N + X0
    Py = Dy * K / N + Y0
    Ax = Px
    Ay = Py - 1
    set sprite Sp to Ay,Ax,SDisc,C
    update sprites
    Frame1
  next
  return
end sub

sub HideMover:
  set sprite SpMove to 192,0,0,0
  update sprites
  return
end sub

sub HideCursor:
  set sprite SpCur to 192,0,0,0
  set sprite SpPick to 192,0,0,0
  update sprites
  return
end sub

sub DrawCursor:
  set sprite SpCur to Cur.Y - 1,Cur.X,SCur,7
  update sprites
  return
end sub

sub Pause(u8 N):
  u8 K = 0
  for K = 1 to N
    Frame1
  next
  return
end sub

' ---------------------------------------------------------------------------
' games

data StartPos bytes
  0, 2, 0, 0, 0, 0, $FB, 0, $FD, 0, 0, 0, 5, $FB, 0, 0, 0, 3, 0, 5, 0, 0, 0, 0, $FE, 0
end data

sub NewGame:
  u8 P = 0
  u8 V8 = 0
  for P = 0 to 25
    V8 = StartPos[P]
    B[P] = V8
  next
  Pb = 0
  Po = 0
  Res = 0
  fill array R with 0
  CLogN = 0
  Gs = 3
  NewScreen
  DrawBoard
  ShowPips
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = V & 32
  Back = 0
  if V > 0 then
    if WasBack = 0 then Back = 1
  end if
  WasBack = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $FC
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a strip of board, BACKGAMMON, the tune once, the menu
sub TitlePage:
  Gs = 0
  NewScreen
  for Ci = 0 to 5
    X = Ci * 2 + 2
    Quad(TTri + (Ci & 1) * 32, X, 2)
    Quad(TTri + (Ci & 1) * 32 + 4, X, 4)
    X = Ci * 2 + 16
    Quad(TTri + (Ci & 1) * 32, X, 2)
    Quad(TTri + (Ci & 1) * 32 + 4, X, 4)
  next
  for Ci = 2 to 5
    put char TBarl at 14,Ci
    put char TBarr at 15,Ci
  next
  Checker(0, 1, 2, 2)
  Checker(0, 1, 2, 4)
  Checker(1, 1, 26, 2)
  Checker(1, 1, 26, 4)
  Checker(1, 1, 12, 2)
  Checker(0, 1, 18, 2)
  print at 11,8, "BACKGAMMON"
  print at 4,10, "COMPUTE!'S GAZETTE 1985"
  print at 3,12, "WHITE AGAINST THE MACHINE."
  print at 3,13, "RACE ALL FIFTEEN HOME AND"
  print at 3,14, "BEAR THEM OFF FIRST."
  print at 11,16, "I GO FIRST"
  print at 11,17, "YOU GO FIRST"
  print at 11,18, "CREDITS"
  print at 5,21, "GAMES: YOU ", Wins, " ME ", Losses
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndStep
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,16
  put char 32 at 9,17
  put char 32 at 9,18
  J = Menu + 16
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "BACKGAMMON"
  print at 2,4, "BASED ON BACKGAMMON,"
  print at 2,5, "COMPUTE!'S GAZETTE, NOVEMBER"
  print at 2,6, "1985 (COMMODORE 64 AND"
  print at 2,7, "VIC-20). NO AUTHOR NAMED."
  print at 2,9, "THE LISTING'S RULES AND ITS"
  print at 2,10, "COMPUTER PLAYER, WHICH"
  print at 2,11, "WEIGHS EVERY MOVE OF EVERY"
  print at 2,12, "DIE AND TAKES THE BEST."
  print at 2,15, "COLECOVISION GAME, MUSIC"
  print at 2,16, "AND PICTURES BY CLAUDE"
  print at 2,17, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,18, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,20, "MUSIC: DOUBLING CUBE"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

