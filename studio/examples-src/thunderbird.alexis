  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$01
end data
data TileCol bytes
  $04,$4B,$B4,$4B,$4B,$4B,$4B,$04
  $04,$4F,$F4,$4F,$4F,$4F,$4F,$04
  $04,$47,$74,$47,$47,$47,$47,$04
  $04,$4D,$D4,$4D,$4D,$4D,$4D,$04
  $04,$49,$94,$49,$49,$49,$49,$04
  $04,$4F,$4F,$F4,$F4,$4F,$4F,$04
  $04,$42,$42,$24,$24,$42,$42,$04
  $04,$47,$47,$74,$74,$47,$47,$04
  $04,$4D,$4D,$D4,$D4,$4D,$4D,$04
  $04,$4B,$4B,$B4,$B4,$4B,$4B,$04
