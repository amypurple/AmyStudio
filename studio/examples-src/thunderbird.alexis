TbSong:
    dw $0001
    db $40+11,12
    dw $0000

; OrCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
OrCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
OrCellDiv:
    or a
    sbc hl,de
    jr c,OrCellRem
    inc b
    jr OrCellDiv
OrCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; OrPeek: Pk = the tile at B (PEEK(B))
OrPeek:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; OrPoke: the tile Tl at B (POKE B,Tl)
OrPoke:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret

; RevFont: the reversed letters and digits: each font character of RevTab
; (third 0 of the pattern table) copied inverted into its tile, in the
; three thirds
RevFont:
    ld hl,RevTab
RfNext:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld e,a
    ld a,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld l,e
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ex de,hl
    pop hl
    ; DE = the character's pattern, HL = the tile's
    ld b,8
RfByte:
    ld a,e
    out ($BF),a
    ld a,d
    out ($BF),a
    nop
    nop
    nop
    in a,($BE)
    cpl
    ld c,a
    push hl
    call RfPut
    ld a,h
    add a,8
    ld h,a
    call RfPut
    ld a,h
    add a,8
    ld h,a
    call RfPut
    pop hl
    inc hl
    inc de
    djnz RfByte
    pop hl
    jr RfNext
RfPut:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    nop
    nop
    ld a,c
    out ($BE),a
    ret
RevTab:
    db 48,149,49,150,50,151,51,152,52,153,53,154,54,155,55,156,56,157,57,158,83,159,67,160,79,161,82,162,69,163,72,164,73,165,84,166,85,167,78,168,68,169,66,170,70,171,65,172,76,173,61,174,45,175,0
}
