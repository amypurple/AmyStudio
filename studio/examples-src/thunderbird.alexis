    dw sndtiny_1
    db 7
    db $02,$30,$31,$88,$17,$01,$1A,$01,$1E,$01,$01,$01,$23,$01,$01,$01
    db $21,$01,$1E,$01,$1F,$01,$01,$01,$1E,$01,$1C,$01,$1A,$01,$01,$01
