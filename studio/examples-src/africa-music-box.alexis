text screen
print at 7,4, "AFRICA MUSIC BOX"
print at 6,8, "BUTTON1 = PLAY SONG"
print at 6,10, "BUTTON2 = STOP SONG"
set sound table _snd_table
screen on
goto main_loop

main_loop:
  if joypad(1).button1 then
    goto start_song
  elseif joypad(1).button2 then
    goto stop_song
  end if
  wait
  goto main_loop

start_song:
  play song africa_music

wait_start_release:
  if joypad(1).button1 then
    goto wait_start_release
  end if
  goto main_loop

stop_song:
  stop song
  mute all

wait_stop_release:
  if joypad(1).button2 then
    goto wait_stop_release
  end if
  goto main_loop

include "@project/africa-music-data.asm"