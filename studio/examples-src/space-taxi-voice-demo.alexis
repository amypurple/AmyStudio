text screen
backdrop dark blue
cls
print centered at 7, "HEY TAXI!"
print centered at 10, "PAD 1 PLEASE"
print centered at 13, "THANKS"
screen on
wait 20 frames
play voxpcm VoiceAnnouncement1
wait 10 frames

