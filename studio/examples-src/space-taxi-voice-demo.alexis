asset VoxSlightPause1 from "@project/voxslightpause.voxpcm"
asset VoxPhrasePause1 from "@project/voxphrasepause.voxpcm"
asset VoxAnnouncementPause1 from "@project/voxannouncementpause.voxpcm"

u8 Destination = 1

text screen
backdrop dark blue
for Destination = 1 to 10
  cls
  print centered at 7, "HEY TAXI!"
  if Destination < 10 then
    print at 11,10, "PAD"
    put char Destination + $30 at 15,10
    print at 17,10, "PLEASE"
  else
    print centered at 10, "UP PLEASE"
  end if
  print centered at 13, "THANKS"
  screen on
  wait 20 frames
  play voxpcm VoiceAnnouncementTable[Destination - 1]
  wait 10 frames
next
cls
print centered at 8, "THANKS FOR LISTENING"
print centered at 11, "TO THIS VOICE DEMO"
screen on
loop forever

asm {
VoiceAnnouncementTable:
  dw VoiceAnnouncement1,VoiceAnnouncement2,VoiceAnnouncement3,VoiceAnnouncement4,VoiceAnnouncement5,VoiceAnnouncement6,VoiceAnnouncement7,VoiceAnnouncement8,VoiceAnnouncement9,VoiceAnnouncement10

