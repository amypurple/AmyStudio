' REVERSI
' The board game from Tim Hartnell's Giant Book of Computer Games
' (Ballantine Books, 1984; Interface Publications, 1983), program based on
' one by Graham Charlton, for the ColecoVision in Amy by Amy Bienvenu.
'
' You (white) against the computer (black) on an eight by eight board
' that starts with two pieces each in the centre. Put a piece so that one
' or more lines of computer pieces lie between it and another of yours:
' they all turn over. The game ends when the board is full or neither
' side can move; the most pieces wins.
'
' The computer plays as the book's program does: for each free square it
' counts the pieces it would turn, doubles that on the edges, halves it
' on the squares next to the edges and halves it again beside the
' corners, and plays the best square (choosing at random between equal
' ones, three times out of ten).
'
' Controls (either joystick): the stick moves the cursor; a side button
' plays the square. Keypad not used.
'
' Liberties taken:
' - A second level, MASTER: the computer also looks at your best answer
'   to each of its moves (the same counting) and avoids giving it.
'   CLASSIC is the book's program.
' - Small dots show the squares where you can play, and a turn you cannot
'   play is passed for you (the book asked you to type 0).
' - The pieces turn over in steps. New music (Queen's Gambit Rag).
'
' House rules kept: columns 2-29, rows 1-22; one sprite (the cursor); the
' frame loop is protected from the NMI and every screen is drawn with the
' NMI off after a wait.

const TQ0ea = 128
const TQ0eb = 129
const TQ0ec = 130
const TQ0ed = 131
const TQ0ba = 132
const TQ0bb = 133
const TQ0bc = 134
const TQ0bd = 135
const TQ0wa = 136
const TQ0wb = 137
const TQ0wc = 138
const TQ0wd = 139
const TQ0b1a = 140
const TQ0b1b = 141
const TQ0b1c = 142
const TQ0b1d = 143
const TQ0w1a = 144
const TQ0w1b = 145
const TQ0w1c = 146
const TQ0w1d = 147
const TQ0xa = 148
const TQ0xb = 149
const TQ0xc = 150
const TQ0xd = 151
const TQ0ha = 152
const TQ0hb = 153
const TQ0hc = 154
const TQ0hd = 155
const TQ1ea = 156
const TQ1eb = 157
const TQ1ec = 158
const TQ1ed = 159
const TQ1ba = 160
const TQ1bb = 161
const TQ1bc = 162
const TQ1bd = 163
const TQ1wa = 164
const TQ1wb = 165
const TQ1wc = 166
const TQ1wd = 167
const TQ1b1a = 168
const TQ1b1b = 169
const TQ1b1c = 170
const TQ1b1d = 171
const TQ1w1a = 172
const TQ1w1b = 173
const TQ1w1c = 174
const TQ1w1d = 175
const TQ1xa = 176
const TQ1xb = 177
const TQ1xc = 178
const TQ1xd = 179
const TQ1ha = 180
const TQ1hb = 181
const TQ1hc = 182
const TQ1hd = 183
const TFtl = 184
const TFtr = 185
const TFbl = 186
const TFbr = 187
const TFt = 188
const TFl = 189
const TFr = 190
const SCursor = 0
const NTiles8 = 504
const SprBytes = 32
const SndMove = 1
const SndPlace = 2
const SndFlip = 3
const SndBad = 4
const SndPass = 5
const SndWin = 6
const SndLose = 7
const SndTuneA = 8
const SndTuneB = 9

u8 B[100]
u8 Fl[20]
u8 Nf = 0
u8 Me = 1
u8 You = 2
u8 Side = 0
u8 Opp = 0
u8 Mine = 0
u8 Yours = 0
u8 Cur = 44
u8 Level = 0
u8 First = 0
u8 Passes = 0
u8 Best = 0
u8 BestQ = 0
u8 Q = 0
u8 K = 0
u8 Sq = 0
u8 Dir = 0
u8 Stp = 0
u8 Cnt = 0
u8 Cell = 0
u8 St = 0
u8 Bg = 0
u8 Moves = 0
u8 Menu = 0
u8 Mode = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 Mix = 0
u8 Sv[100]
u8 Rq = 0
u8 Mq = 0
u16 Score = 0
u16 BestS = 0
u16 NumU = 0
u8 Ai = 0
u8 I = 0
u8 J = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table RvSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Level = 0

title:
  TitlePage
  if Menu = 3 then
    RulesPage
    goto title
  end if
  if Menu = 4 then
    EditorialPage
    goto title
  end if
  if Menu = 2 then goto title
  First = Menu
  Mode = 0
  NewGame
  BoardScreen
  Passes = 0
  if First = 1 then goto computer_turn

player_turn:
  ' can the player move at all?
  Side = You
  Opp = Me
  CountMoves
  if Moves = 0 then
    inc Passes
    if Passes >= 2 then goto game_end
    Message
    print at 2,22, "YOU CANNOT MOVE: YOU PASS"
    play sound SndPass
    Pause
    goto computer_turn
  end if
  Passes = 0
  ShowHints
  Message
  print at 2,22, "YOUR MOVE"
  Mode = 1
player_loop:
  Frame1
  ReadPad
  MoveCursor
  DrawCursor
  if Press = 0 then goto player_loop
  Sq = Cur
  Side = You
  Opp = Me
  CountFlips
  if Q = 0 then
    play sound SndBad
    goto player_loop
  end if
  HideSprites
  ClearHints
  PlayMove
  V = Mine + Yours
  if V = 64 then goto game_end

computer_turn:
  Side = Me
  Opp = You
  Message
  print at 2,22, "MY MOVE..."
  ChooseMove
  if Best = 0 then
    inc Passes
    if Passes >= 2 then goto game_end
    Message
    print at 2,22, "I CANNOT MOVE: I PASS"
    play sound SndPass
    Pause
    goto player_turn
  end if
  Passes = 0
  Pause
  Sq = Best
  Side = Me
  Opp = You
  CountFlips
  PlayMove
  V = Mine + Yours
  if V = 64 then goto game_end
  goto player_turn

game_end:
  HideSprites
  ClearHints
  Message
  if Mine > Yours then
    print at 2,22, "I'M THE CHAMPION!"
    play sound SndLose
  end if
  if Yours > Mine then
    print at 2,22, "YOU'RE THE CHAMPION!"
    play sound SndWin
  end if
  if Yours = Mine then print at 2,22, "IT'S A DRAW!"
  Mode = 2
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------
' The board: B[r * 10 + c], rows and columns 1-8 inside a border (3);
' 0 empty, 1 the computer (black), 2 you (white)

sub NewGame:
  for I = 0 to 99
    B[I] = 3
  next
  for I = 1 to 8
    for J = 1 to 8
      V = I * 10
      V = V + J
      B[V] = 0
    next
  next
  B[44] = 1
  B[55] = 1
  B[45] = 2
  B[54] = 2
  Cur = 34
  return
end sub

' the eight directions as steps in B
data Dirs bytes 1, 9, 10, 11, 255, 247, 246, 245

' CountFlips: Q = pieces Side would turn by playing Sq (Fl, Nf list them)
sub CountFlips:
  Q = 0
  Nf = 0
  if B[Sq] <> 0 then return
  for Dir = 0 to 7
    Stp = Dirs[Dir]
    Cnt = 0
    Cell = Sq + Stp
    while B[Cell] = Opp
      inc Cnt
      Cell = Cell + Stp
    end while
    if B[Cell] = Side then
      if Cnt > 0 then
        Q = Q + Cnt
        ' remember them
        Cell = Sq + Stp
        for K = 1 to Cnt
          if Nf < 20 then
            Fl[Nf] = Cell
            inc Nf
          end if
          Cell = Cell + Stp
        next
      end if
    end if
  next
  return
end sub

' CountMoves: Moves = squares where Side can play
sub CountMoves:
  Moves = 0
  for Sq = 11 to 88
    if B[Sq] = 0 then
      QuickQ
      if Q > 0 then inc Moves
    end if
  next
  return
end sub

' QuickQ: Q = pieces Side would turn at Sq (no list)
sub QuickQ:
  Q = 0
  for Dir = 0 to 7
    Stp = Dirs[Dir]
    Cnt = 0
    Cell = Sq + Stp
    while B[Cell] = Opp
      inc Cnt
      Cell = Cell + Stp
    end while
    if B[Cell] = Side then Q = Q + Cnt
  next
  return
end sub

' Weigh: the book's value of Q at Sq, times four: edges x2, the ring
' inside x1/2, beside a corner on the edge x1/2 again
sub Weigh:
  Rq = Sq / 10
  Mq = Rq * 10
  Mq = Sq - Mq
  Score = Q * 4
  V = 0
  if Rq = 1 then V = 1
  if Rq = 8 then V = 1
  if Mq = 1 then V = 1
  if Mq = 8 then V = 1
  if V = 1 then Score = Score + Score
  V = 0
  if Rq = 2 then V = 1
  if Rq = 7 then V = 1
  if Mq = 2 then V = 1
  if Mq = 7 then V = 1
  if V = 1 then Score = Score >> 1
  V = 0
  W = 0
  if Rq = 1 then W = 1
  if Rq = 8 then W = 1
  if Mq = 2 then V = 1
  if Mq = 7 then V = 1
  if W = 1 then
    if V = 1 then Score = Score >> 1
  end if
  V = 0
  W = 0
  if Rq = 2 then W = 1
  if Rq = 7 then W = 1
  if Mq = 1 then V = 1
  if Mq = 8 then V = 1
  if W = 1 then
    if V = 1 then Score = Score >> 1
  end if
  return
end sub

' ChooseMove: Best = the computer's square (0: it must pass)
sub ChooseMove:
  Best = 0
  BestS = 0
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Sq = Ai
      Side = Me
      Opp = You
      QuickQ
      if Q > 0 then
        Weigh
        if Level = 1 then
          ' MASTER: take away the best answer the player would have
          Sq = Ai
          CountFlips
          ReplyCost
          Sq = Ai
          QuickQ
          Weigh
          Score = Score + 64
          if Score > NumU then
            Score = Score - NumU
          else
            Score = 1
          end if
        end if
        V = 0
        if Score > BestS then V = 1
        if Score = BestS then
          W = random(0, 9)
          if W < 3 then V = 1
        end if
        if V = 1 then
          BestS = Score
          Best = Ai
        end if
      end if
    end if
  next
  Side = Me
  Opp = You
  return
end sub

' ReplyCost: NumU = the player's best weighed answer after the computer
' plays Ai (Fl lists what it would turn); the board is put back after
sub ReplyCost:
  ' play it on the board for a moment
  B[Ai] = Me
  for K = 1 to Nf
    V = K - 1
    V = Fl[V]
    B[V] = Me
  next
  NumU = 0
  Side = You
  Opp = Me
  for Sq = 11 to 88
    if B[Sq] = 0 then
      QuickQ
      if Q > 0 then
        Weigh
        if Score > NumU then NumU = Score
      end if
    end if
  next
  ' put it back
  B[Ai] = 0
  for K = 1 to Nf
    V = K - 1
    V = Fl[V]
    B[V] = You
  next
  Side = Me
  Opp = You
  return
end sub

' PlayMove: Side plays Sq; the pieces in Fl turn over, one after another
sub PlayMove:
  B[Sq] = Side
  Cell = Sq
  St = Side
  DrawSquare
  play sound SndPlace
  Pause6
  for K = 1 to Nf
    V = K - 1
    Cell = Fl[V]
    B[Cell] = Side
    ' the turn: half, edge, half, done
    St = 3
    if Side = 1 then St = 4
    DrawSquare
    Frame3
    St = 5
    DrawSquare
    Frame3
    St = 4
    if Side = 1 then St = 3
    DrawSquare
    Frame3
    St = Side
    DrawSquare
    play sound SndFlip
  next
  CountPieces
  ShowPanel
  return
end sub

sub CountPieces:
  Mine = 0
  Yours = 0
  for I = 11 to 88
    if B[I] = 1 then inc Mine
    if B[I] = 2 then inc Yours
  next
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' DrawSquare: square Cell in state St (0 empty, 1 black, 2 white, 3 black
' half, 4 white half, 5 edge, 6 hint)
sub DrawSquare:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  Bg = X + Y
  Bg = Bg & 1
  W = Bg * 7
  W = W + St
  W = W * 4
  W = W + TQ0ea
  X = X * 2
  X = X + 1
  Y = Y * 2
  Y = Y + 2
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub DrawBoard:
  ' the frame: columns 2 and 19, rows 3 and 20
  put char TFtl at 2,3
  fill TFt count 16 at 3,3
  put char TFtr at 19,3
  for Y = 4 to 19
    put char TFl at 2,Y
    put char TFr at 19,Y
  next
  put char TFbl at 2,20
  fill TFt count 16 at 3,20
  put char TFbr at 19,20
  for I = 1 to 8
    for J = 1 to 8
      Cell = I * 10
      Cell = Cell + J
      St = B[Cell]
      DrawSquare
    next
  next
  return
end sub

sub ShowHints:
  Side = You
  Opp = Me
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Sq = Ai
      QuickQ
      if Q > 0 then
        Cell = Ai
        St = 6
        DrawSquare
      end if
    end if
  next
  return
end sub

sub ClearHints:
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Cell = Ai
      St = 0
      DrawSquare
    end if
  next
  return
end sub

sub ShowPanel:
  print at 21,4, "ME"
  put char TQ0ba at 21,5
  put char TQ0bb at 22,5
  put char TQ0bc at 21,6
  put char TQ0bd at 22,6
  NumU = Mine
  print at 24,6, digits$(NumU, 2)
  print at 21,9, "YOU"
  put char TQ0wa at 21,10
  put char TQ0wb at 22,10
  put char TQ0wc at 21,11
  put char TQ0wd at 22,11
  NumU = Yours
  print at 24,11, digits$(NumU, 2)
  print at 21,15, "LEVEL"
  if Level = 0 then print at 21,16, "CLASSIC"
  if Level = 1 then print at 21,16, "MASTER "
  return
end sub

sub DrawCursor:
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  X = X * 16
  X = X + 8
  Y = Y * 16
  Y = Y + 15
  V = Tick & 8
  W = 11
  if V > 0 then W = 10
  set sprite 0 to Y, X, SCursor, W
  update sprites
  return
end sub

sub MoveCursor:
  if Stick = 0 then return
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  if Lf1 = 1 then
    if X > 1 then dec Cur
  end if
  if Rt1 = 1 then
    if X < 8 then inc Cur
  end if
  if Up1 = 1 then
    if Y > 1 then Cur = Cur - 10
  end if
  if Dn1 = 1 then
    if Y < 8 then Cur = Cur + 10
  end if
  play sound SndMove
  return
end sub

sub Message:
  fill 32 count 28 at 2,22
  return
end sub

sub BoardScreen:
  NewScreen
  print at 2,1, "REVERSI"
  CountPieces
  DrawBoard
  ShowPanel
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub Frame3:
  for J = 1 to 3
    Frame1
  next
  return
end sub

sub Pause6:
  for J = 1 to 6
    Frame1
  next
  return
end sub

sub Pause:
  for J = 1 to 40
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

' the title: a row of pieces turning over
sub TitlePage:
  NewScreen
  print at 11,2, "REVERSI"
  print at 6,13, "PLAY: YOU GO FIRST"
  print at 6,14, "PLAY: I GO FIRST"
  print at 6,15, "LEVEL:"
  print at 6,16, "HOW TO PLAY"
  print at 6,17, "CREDITS"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ReadPad
  ' eight pieces in a row, turning one after another
  V = Tick >> 3
  for I = 0 to 7
    Cell = 21 + I
    W = V + I
    W = W & 7
    St = 1
    if W = 1 then St = 3
    if W = 2 then St = 5
    if W = 3 then St = 4
    if W >= 4 then St = 2
    if W = 5 then St = 4
    if W = 6 then St = 5
    if W = 7 then St = 3
    DrawSquare
  next
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 4 then inc Menu
    end if
    play sound SndMove
  end if
  for I = 13 to 17
    print at 4,I, " "
  next
  Y = Menu + 13
  print at 4,Y, ">"
  if Level = 0 then print at 13,15, "CLASSIC"
  if Level = 1 then print at 13,15, "MASTER "
  if Press = 0 then goto title_loop
  if Menu = 2 then
    Level = 1 - Level
    play sound SndPlace
    goto title_loop
  end if
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "YOU ARE WHITE, I AM BLACK."
  print at 2,5, "PLAY A PIECE SO THAT A LINE"
  print at 2,6, "OF MY PIECES LIES BETWEEN IT"
  print at 2,7, "AND ANOTHER OF YOURS: THEY"
  print at 2,8, "ALL TURN WHITE. LINES MAY"
  print at 2,9, "RUN ACROSS, DOWN OR ON THE"
  print at 2,10, "DIAGONALS."
  print at 2,12, "THE DOTS SHOW WHERE YOU CAN"
  print at 2,13, "PLAY. NO MOVE: YOU PASS."
  print at 2,15, "THE MOST PIECES WHEN THE"
  print at 2,16, "BOARD IS FULL, OR NEITHER"
  print at 2,17, "CAN MOVE, WINS."
  print at 2,19, "STICK: CURSOR. BUTTON: PLAY."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  NewScreen
  print at 11,1, "REVERSI"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983). THE PROGRAM IS BASED"
  print at 2,8, "ON ONE BY GRAHAM CHARLTON."
  print at 2,10, "REVERSI WAS INVENTED IN"
  print at 2,11, "LONDON IN THE 1880S."
  print at 2,13, "NEW MUSIC: QUEEN'S GAMBIT"
  print at 2,14, "RAG."
  print at 2,16, "COLECOVISION VERSION BY"
  print at 2,17, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$07,$E0,$E0,$C0,$C0,$C0
  $00,$00,$E0,$07,$07,$03,$03,$03
  $C0,$C0,$C0,$E0,$E0,$07,$00,$00
  $03,$03,$03,$07,$07,$E0,$00,$00
  $00,$00,$07,$E0,$E0,$C0,$C0,$C0
  $00,$00,$E0,$07,$07,$03,$03,$03
  $C0,$C0,$C0,$E0,$E0,$07,$00,$00
  $03,$03,$03,$07,$07,$E0,$00,$00
  $00,$00,$00,$00,$00,$F0,$C0,$C0
  $00,$00,$00,$00,$00,$F0,$03,$03
  $C0,$C0,$F0,$00,$00,$00,$00,$00
  $03,$03,$F0,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$F0,$C0,$C0
  $00,$00,$00,$00,$00,$F0,$03,$03
  $C0,$C0,$F0,$00,$00,$00,$00,$00
  $03,$03,$F0,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$C0
  $00,$00,$00,$00,$00,$00,$00,$03
  $C0,$00,$00,$00,$00,$00,$00,$00
  $03,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$01
  $00,$00,$00,$00,$00,$00,$00,$80
  $01,$00,$00,$00,$00,$00,$00,$00
  $80,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
