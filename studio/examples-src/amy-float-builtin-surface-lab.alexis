' FP5 builtin surface lab: smoke statement helpers and contrast exact print with friendly str$.
u16 UTwo = 2
u16 UThree = 3
u16 UNine = 9
i16 SNegThree = -3
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
i16 SignA = 0
i16 SignD = 0
u16 WholeC = 0
u8 BufA[16]
u8 BufB[16]
u8 BufC[16]
u8 BufD[16]

  text screen
  print at 4,0, "FP5 BUILTIN SURFACE"

  A = random()
  B = UTwo
  C = UNine
  D = SNegThree

  C = sqr(C)
  SignA = sgn(A)
  SignD = sgn(D)
  WholeC = int(C)

  A += B
  A -= B
  A *= B
  A /= B
  A ^= 2

  BufA = str$(A)
  BufB = str$(B)
  BufC = str$(C)
  BufD = str$(D)

  print at 1,4,  "A exact"
  print A at 14,4 digits 16
  print at 1,5,  "A str$"
  put BufA count 16 at 14,5
  print at 1,7,  "B exact"
  print B at 14,7 digits 16
  print at 1,8,  "B str$"
  put BufB count 16 at 14,8
  print at 1,10, "C str$"
  put BufC count 16 at 14,10
  print at 1,12, "D exact"
  print D at 14,12 digits 16
  print at 1,13, "D str$"
  put BufD count 16 at 14,13
  print at 1,15, "sgn A"
  print SignA at 14,15 digits 2
  print at 1,16, "sgn -3"
  print SignD at 14,16 digits 2
  print at 1,18, "int sqrt9"
  print WholeC at 14,18 digits 5

  print at 1,20, "EXPECT"
  print at 1,21, "A exact uses digits 16; A str$ is friendly"
  print at 1,22, "B exact 00002.0000, B str$ 2"
  print at 1,23, "D exact is negative; D str$ should be -3"
  screen on