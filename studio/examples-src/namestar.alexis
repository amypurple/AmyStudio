  tile screen
  set sound table NsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NameEntry
  NewGame
  StageScreen
  HostIntro

next_star:
  PlayRound
  inc Rnd
  if Rnd < NStars then goto next_star

  ' the closing dialogue (lines 750-830), then back to the title
  Phase = 3
  ClearBalloon
  print at 9,7, "WELL, "
  NameAt(15, 7, 44)
  print at 9,8, "IT'S TIME FOR US TO"
  print at 9,9, "BE LEAVING YOU, BUT"
  print at 9,10, "BEFORE WE GO..."
  WaitPress
  if Score > Best then Best = Score
  ClearBalloon
  ClearChoices
  print at 9,7, "MAY I SAY THAT YOU"
  print at 9,8, "HAVE BEEN A WONDER-"
  print at 9,9, "FUL GUEST AND A"
  print at 9,10, "GOOD SPORT."
  print at 9,11, "SO LONG!"
  print at 6,15, "STARS NAMED"
  NumU = Ok
  print at 18,15, digits$(NumU, 2), " OF 40"
  print at 6,17, "POINTS"
  print at 18,17, Score, " OF 120"
  fill 32 count 28 at 2,21
  Phase = 4
  play sound SndEnd
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a game

sub NewGame:
  Score = 0
  Ok = 0
  Rnd = 0
  RsStart = Rs
  Shuffle
  return
end sub

' Fisher-Yates over the 40 names
sub Shuffle:
  for Ci = 0 to 39
    Ord[Ci] = Ci
  next
  for Ci = 0 to 38
    K = 39 - Ci
    J = RandN(K + 1)
    swap Ord[K] with Ord[J]
  next
  return
end sub

function RandN(u8 Lim) as u8
  u8 Lo = 0
  Rand
  W16 = Rs >> 3
  Lo = W16 & 255
  return Lo % Lim

' is star S already one of the choices?
function Used(u8 S) as u8
  u8 Hit = 0
  u8 Ui = 0
  for Ui = 0 to 5
    if Ch[Ui] = S then Hit = 1
  next
  return Hit

' six choices: the star at a random slot, five others not repeated
sub BuildChoices:
  for Ci = 0 to 5
    Ch[Ci] = 255
    Wr[Ci] = 0
  next
  Rd.Slot = RandN(NCh)
  Ch[Rd.Slot] = Rd.Star
  for Ci = 0 to 5
    if Ch[Ci] = 255 then
      Got = 1
      while Got = 1
        N = RandN(NStars)
        Got = Used(N)
      end while
      Ch[Ci] = N
    end if
  next
  return
end sub

sub PlayRound:
  Rd.Star = Ord[Rnd]
  Rd.Guess = 1
  Rd.Cur = 0
  Res = 0
  BuildChoices
  ShowHud
  ' "our first / next mystery name is...."
  Phase = 1
  ClearChoices
  ShowJumble
  ClearBalloon
  if Rnd = 0 then
    print at 9,8, "OUR FIRST MYSTERY"
  else
    print at 9,8, "OUR NEXT MYSTERY"
  end if
  print at 9,9, "NAME IS...."
  fill 32 count 28 at 2,21
  Pause(60)
  ShowClue
  DrawChoices
  Phase = 2
  GuessLine
  while Res = 0
    Wt = 3
    Frame1
    ReadPad
    Animate
    MoveCursor
    PlacePtr
    if Press = 1 then
      Wt = 0
      Pick
    end if
  end while
  Wt = 0
  HidePtr
  WaitPress
  return
end sub

' the stick moves the pointer (repeat while held), a button picks
sub MoveCursor:
  if Mv = 1 then
    if Rd.Cur > 0 then
      dec Rd.Cur
    else
      Rd.Cur = NCh - 1
    end if
    play sound SndMove
  end if
  if Mv = 2 then
    inc Rd.Cur
    if Rd.Cur >= NCh then Rd.Cur = 0
    play sound SndMove
  end if
  return
end sub

sub Pick:
  K = Rd.Cur
  if Wr[K] = 1 then return
  if K = Rd.Slot then
    ' right (lines 535-550): 3, 2 or 1 points
    N = 4 - Rd.Guess
    Score += N
    inc Ok
    Res = 1
    put char TTick at ChCol - 2,ChRow + K
    ShowName
    ShowHud
    play sound SndRight
    SpX = 40
    Y = ChRow + K
    SpY = Y * 8 - 5
    SparkT = 40
    ClearBalloon
    print at 9,7, "CORRECT, "
    NameAt(18, 7, 33)
    print at 9,8, "YOU NOW HAVE"
    NumU = Ok
    print at 22,8, digits$(NumU, 2)
    print at 9,9, "CORRECT."
    NumU = N
    print at 9,11, "+", digits$(NumU, 1), " POINTS"
    return
  end if
  ' wrong (lines 590-720)
  Wr[K] = 1
  put char TCross at ChCol - 2,ChRow + K
  inc Rd.Guess
  NextFree
  if Rd.Guess > 3 then
    Res = 2
    put char TTick at ChCol - 2,ChRow + Rd.Slot
    ShowName
    play sound SndLose
    ClearBalloon
    print at 9,7, "I'M SORRY, "
    NameAt(20, 7, 44)
    print at 9,8, "BUT THIS FAMOUS"
    print at 9,9, "PERSON IS..."
    Off = Rd.Star * 16
    put QName + Off count 16 at 9,11
    return
  end if
  play sound SndWrong
  WrongTalk
  Pause(100)
  ShowClue
  GuessLine
  return
end sub

sub WrongTalk:
  ClearBalloon
  select case Rd.Guess
  case 2
    print at 9,7, "WRONG, "
    NameAt(16, 7, 46)
    print at 9,8, "YOU HAVE 2 GUESSES"
    print at 9,9, "LEFT."
  case else
    print at 9,7, "WRONG AGAIN, "
    NameAt(22, 7, 46)
    print at 9,8, "YOU HAVE 1 GUESS"
    print at 9,9, "LEFT."
  end select
  print at 9,10, "LET'S TRY AGAIN.."
  return
end sub

' the pointer moves on to the next choice not crossed out
sub NextFree:
  for Ki = 1 to 5
    K = Rd.Cur + 1
    if K >= NCh then K = 0
    Rd.Cur = K
    if Wr[K] = 0 then exit for
  next
  return
end sub

sub GuessLine:
  fill 32 count 28 at 2,21
  NumU = Rd.Guess
  print at 9,21, "GUESS ", digits$(NumU, 1), " OF 3"
  return
end sub

' ---------------------------------------------------------------------------
' the host's opening dialogue (lines 100-440)

sub HostIntro:
  Phase = 1
  ClearBalloon
  print at 9,7, "HELLO LADIES AND"
  print at 9,8, "GENTLEMEN. WELCOME"
  print at 9,9, "TO NAME THAT STAR."
  WaitPress
  ClearBalloon
  print at 9,7, "LET'S WELCOME OUR"
  print at 9,8, "PLAYER, "
  NameAt(17, 8, 33)
  WaitPress
  ClearBalloon
  print at 9,7, "DO YOU WANT ME TO"
  print at 9,8, "EXPLAIN THE GAME,"
  NameAt(9, 9, 63)
  Ans = AskYesNo
  if Ans = 0 then
    ClearBalloon
    print at 9,7, "I WILL DISPLAY A"
    print at 9,8, "FAMOUS NAME WHERE"
    print at 9,9, "IT SAYS  NAME ."
    put char 34 at 17,9
    put char 34 at 22,9
    WaitPress
    ClearBalloon
    print at 9,7, "THE NAME WILL BE"
    print at 9,8, "JUMBLED SO YOU CAN"
    print at 9,9, "NOT READ IT..."
    WaitPress
    ClearBalloon
    print at 9,7, "I WILL GIVE YOU A"
    print at 9,8, "CLUE AND SIX NAMES."
    print at 9,9, "PICK THE STAR WITH"
    print at 9,10, "THE STICK AND A"
    print at 9,11, "BUTTON."
    WaitPress
    ClearBalloon
    print at 9,7, "YOU'LL ONLY GET 3"
    print at 9,8, "TRIES AT EACH NAME:"
    print at 9,9, "3 POINTS FOR THE"
    print at 9,10, "FIRST, 2 FOR THE"
    print at 9,11, "SECOND, 1 THE THIRD"
    WaitPress
  end if
  ClearBalloon
  print at 9,7, "IF YOU'RE READY"
  print at 9,8, "TO GO..."
  print at 9,10, "  LET'S PLAY"
  print at 9,11, "  NAME THAT STAR!"
  play sound SndPick
  WaitPress
  return
end sub

' YES / NO in the choice area; returns 0 for YES
function AskYesNo as u8
  ClearChoices
  print at ChCol,ChRow, "YES"
  print at ChCol,ChRow + 1, "NO"
  Rd.Cur = 0
  fill 32 count 28 at 2,21
  Press = 0
  Wt = 2
  while Press = 0
    Frame1
    ReadPad
    Animate
    if Mv > 0 then
      Rd.Cur = Rd.Cur ^ 1
      play sound SndMove
    end if
    PlacePtr
  end while
  Wt = 0
  play sound SndPick
  HidePtr
  ClearChoices
  return Rd.Cur

' ---------------------------------------------------------------------------
' the contestant's application (lines 60-90): a letter board

sub NameEntry:
  NewScreen
  DrawStage
  print at 4,3, "CONTESTANT'S APPLICATION"
  print at 5,7, "FIRST NAME:"
  print at 3,20, "STICK: LETTER  BUTTON: OK"
  for Li = 0 to 27
    BoardPos(Li)
    if Li < 26 then
      put char BoardCh[Li] at X,Y
    end if
  next
  print at 21,17, "DEL"
  print at 25,17, "END"
  ShowEntered
  ShowScreen
  Rd.Cur = 0
  Got = 0
  while Got = 0
    Wt = 4
    Frame1
    inc Rs
    ReadPad
    BoardMove
    BoardPos(Rd.Cur)
    X = X * 8 - 18
    Y = Y * 8 - 5
    set sprite 0 to Y,X,SPtr,11
    update sprites
    if Press = 1 then BoardPick
  end while
  Wt = 0
  HidePtr
  ' lines 85-90
  print at 5,11, "                         "
  for Li = 13 to 20
    fill 32 count 28 at 2,Li
  next
  print at 5,11, "CONGRATULATIONS..."
  NameAt(5, 12, 44)
  print at 5,13, "YOU HAVE BEEN ACCEPTED."
  play sound SndPick
  WaitPressPlain
  return
end sub

sub BoardPos(u8 Bi):
  K = Bi % 7
  X = K * 3 + 6
  K = Bi / 7
  Y = K * 2 + 11
  if Bi = 27 then X = 25
  return
end sub

sub BoardMove:
  K = Rd.Cur % 7
  N = Rd.Cur / 7
  if Mv = 1 then
    if N > 0 then dec N else N = 3
  end if
  if Mv = 2 then
    inc N
    if N > 3 then N = 0
  end if
  if Mv = 3 then
    if K > 0 then dec K else K = 6
  end if
  if Mv = 4 then
    inc K
    if K > 6 then K = 0
  end if
  if Mv > 0 then play sound SndMove
  Rd.Cur = N * 7 + K
  return
end sub

sub BoardPick:
  select case Rd.Cur
  case 26
    if PLen > 0 then dec PLen
  case 27
    if PLen = 0 then
      ' no name: the host calls you PLAYER
      PName[0] = 80
      PName[1] = 76
      PName[2] = 65
      PName[3] = 89
      PName[4] = 69
      PName[5] = 82
      PLen = 6
    end if
    Got = 1
  case else
    if PLen < MaxName then
      PName[PLen] = BoardCh[Rd.Cur]
      inc PLen
    end if
  end select
  play sound SndPick
  ShowEntered
  return
end sub

sub ShowEntered:
  for Li = 0 to 7
    if Li < PLen then
      put char PName[Li] at 17 + Li,7
    else
      put char TUnder at 17 + Li,7
    end if
  next
  return
end sub

' the name, then one character (, ! ? .) right after it
sub NameAt(u8 Nx, u8 Ny, u8 Tail):
  put PName count PLen at Nx,Ny
  put char Tail at Nx + PLen,Ny
  return
end sub

' ---------------------------------------------------------------------------
' the stage

sub StageScreen:
  NewScreen
  DrawStage
  DrawMarquee
  print at 5,2, "     NAME THAT STAR   "
  DrawBalloon
  ShowHud
  ShowScreen
  return
end sub

sub DrawStage:
  fill TVal count 32 at 0,0
  for Li = 1 to 23
    put char TCurt at 0,Li
    put char TCurt at 1,Li
    put char TCurt at 30,Li
    put char TCurt at 31,Li
  next
  fill TFloor count 28 at 2,23
  return
end sub

sub DrawMarquee:
  put char TMtl at 4,1
  fill TMt count 22 at 5,1
  put char TMtr at 27,1
  put char TMl at 4,2
  put char TMr at 27,2
  put char TMbl at 4,3
  fill TMb count 22 at 5,3
  put char TMbr at 27,3
  return
end sub

sub DrawBalloon:
  put char TBtl at 7,6
  fill TBt count 21 at 8,6
  put char TBtr at 29,6
  for Li = 7 to 11
    put char TBl at 7,Li
    put char TBr at 29,Li
  next
  put char TBtail at 7,9
  put char TBbl at 7,12
  fill TBb count 21 at 8,12
  put char TBbr at 29,12
  for Li = 0 to 4
    K = THost00 + Li * 4
    Y = 7 + Li
    put char K at 2,Y
    put char K + 1 at 3,Y
    put char K + 2 at 4,Y
    put char K + 3 at 5,Y
  next
  return
end sub

sub ClearBalloon:
  for Li = 7 to 11
    fill 32 count 20 at 9,Li
  next
  return
end sub

sub ClearChoices:
  for Li = 14 to 19
    fill 32 count 20 at 6,Li
  next
  return
end sub

sub ShowHud:
  print at 2,4, "STAR"
  NumU = Rnd + 1
  if NumU > 40 then NumU = 40
  print at 7,4, digits$(NumU, 2), " OF 40"
  print at 19,4, "SCORE ", Score
  return
end sub

sub ShowJumble:
  print at 5,2, " NAME: "
  Off = Rd.Star * 16
  put QJumb + Off count 16 at 12,2
  return
end sub

sub ShowName:
  print at 5,2, " STAR: "
  Off = Rd.Star * 16
  put QName + Off count 16 at 12,2
  return
end sub

sub ShowClue:
  ClearBalloon
  Off = Rd.Star * 100
  for Li = 0 to 4
    put QClue + Off count 20 at 9,7 + Li
    Off = Off + 20
  next
  return
end sub

sub DrawChoices:
  ClearChoices
  for Li = 0 to 5
    Off = Ch[Li] * 16
    put QName + Off count 16 at ChCol,ChRow + Li
  next
  return
end sub

sub PlacePtr:
  Y = ChRow + Rd.Cur
  Y = Y * 8 - 5
  set sprite 0 to Y,32,SPtr,11
  update sprites
  return
end sub

sub HidePtr:
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' waiting: the bulbs keep blinking, the sparkle flies

sub Pause(u8 Nf):
  for Ki = 1 to Nf
    Frame1
    ReadPad
    Animate
  next
  return
end sub

sub WaitPress:
  fill 32 count 28 at 2,21
  print at 8,21, "PRESS THE BUTTON"
  WaitPressPlain
  fill 32 count 28 at 2,21
  return
end sub

sub WaitPressPlain:
  Press = 0
  Pause(20)
  Press = 0
  Wt = 1
  while Press = 0
    Frame1
    ReadPad
    Animate
  end while
  Wt = 0
  play sound SndTalk
  return
end sub

sub Animate:
  inc BulbT
  if BulbT >= 30 then
    BulbT = 0
    BulbP = BulbP ^ 1
    if BulbP = 1 then
      copy TileCol + 64 count 64 to vram.color + 1024
    else
      copy TileCol count 64 to vram.color + 1024
    end if
  end if
  if SparkT > 0 then
    dec SparkT
    K = 40 - SparkT
    K = K >> 1
    if SparkT = 0 then
      for Li = 1 to 4
        set sprite Li to 192,0,0,0
      next
    else
      ' four sparkles fly out from the pointer
      X = SpX + K
      Y = SpY - K
      set sprite 1 to Y,X,SSpark,11
      X = SpX - K
      if K > SpX then X = 0
      set sprite 2 to Y,X,SSpark,15
      Y = SpY + K
      set sprite 3 to Y,X,SSpark,11
      X = SpX + K
      set sprite 4 to Y,X,SSpark,15
    end if
    update sprites
  end if
  return
end sub

' ---------------------------------------------------------------------------

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' Mv: 1 up, 2 down, 3 left, 4 right (on a new push, and repeated while
' held: after 16 frames, then every 8)
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stk = V & 15
  Mv = 0
  if Stk = 0 then
    RepT = 0
  else
    if Stk <> WasStk then
      RepT = 16
      Mv = StickDir(Stk)
    else
      dec RepT
      if RepT = 0 then
        RepT = 8
        Mv = StickDir(Stk)
      end if
    end if
  end if
  WasStk = Stk
  return
end sub

function StickDir(u8 Sv) as u8
  if Sv & 1 then return 1
  if Sv & 2 then return 2
  if Sv & 4 then return 3
  return 4

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  SparkT = 0
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  BulbP = 0
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the stage, the marquee, the host, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawStage
  DrawMarquee
  print at 9,2, "NAME THAT STAR"
  DrawBalloon
  print at 9,7, "A GAME SHOW OF"
  print at 9,8, "FAMOUS NAMES"
  print at 9,10, "BY BOB LLORET"
  print at 9,11, "AHOY! APRIL 1984"
  print at 11,15, "START GAME"
  print at 11,16, "CREDITS"
  print at 8,20, "BEST SCORE ", Best
  put char TStar at 6,20
  put char TStar at 25,20
  ShowMenu
  TitleOn = 1
  Phase = 0
  PLen = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Press = 0
  while Press = 0
    Frame1
    inc Rs
    ReadPad
    Animate
    if Mv = 1 then
      Menu = 0
      ShowMenu
    end if
    if Mv = 2 then
      Menu = 1
      ShowMenu
    end if
  end while
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,15
  put char 32 at 9,16
  J = Menu + 15
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "NAME THAT STAR"
  print at 2,5, "BASED ON NAME THAT STAR"
  print at 2,6, "V2.0 BY BOB LLORET, AHOY!"
  print at 2,7, "APRIL 1984 (COMMODORE 64)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "A FEW 1984 CLUES WERE"
  print at 2,16, "CORRECTED FOR ACCURACY."
  print at 2,18, "MUSIC: STUDIO LIGHTS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

