cartridge "AMY C-STYLE CONDITIONAL LAB/AMY STUDIO/2026"

#define USE_FAST_PATH

u8 Result = 0
u8 Expected = 7

#ifdef NEVER_DEFINED
#define SHOULD_NOT_LEAK
#endif

  text screen
  screen on
  ChoosePath
  print centered at 6, "C-STYLE CONDITIONAL"
  print at 8,9, "RESULT:"
  print Result at 16,9 digits 3
  if Result = Expected then
    print centered at 12, "PASS C-STYLE"
  else
    print centered at 12, "FAIL C-STYLE"
  end if
  loop forever

#ifdef USE_FAST_PATH
sub ChoosePath:
  Result = 7
  return
#else
sub ChoosePath:
  Result = 88
  print centered at 18, "INACTIVE ELSE CODE"
  return
#endif

if not defined SHOULD_NOT_LEAK
sub LeakCheck:
  return
end ifdef

ifdef SHOULD_NOT_LEAK
sub LeakCheck:
  print centered at 20, "INACTIVE LEAK SYMBOL"
  return
end ifdef