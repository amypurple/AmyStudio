' Fixed32 square lab: fixed32 ^= 2 convenience surface.
fixed32 OneHalf = 1.5
fixed32 NegOneHalf = -1.5
fixed32 Three = 3.0
fixed32 ZeroValue = 0.0

' Amy Fixed32 Square Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 5,0, "FIXED32 SQUARE LAB"

  OneHalf ^= 2
  print at 1,3,  "1.50 ^ 2"
  print OneHalf at 20,3

  NegOneHalf ^= 2
  print at 1,5,  "-1.50 ^ 2"
  print NegOneHalf at 20,5

  Three ^= 2
  print at 1,7,  "3.00 ^ 2"
  print Three at 20,7

  ZeroValue ^= 2
  print at 1,9,  "0.00 ^ 2"
  print ZeroValue at 20,9

  print at 1,12, "EXPECTED"
  print at 10,12, "2.25 2.25 9 0"
  return