cartridge "BIOS PATTERN LAB/AMY/2026"

' The asymmetrical F makes every transformation easy to recognize.
data SourcePattern bytes
  $FE,$80,$80,$F8,$80,$80,$80,$00
end data

data SourceColor bytes
  $F1,$E1,$D1,$C1,$B1,$A1,$91,$81
end data

  tile screen
  define chars SourcePattern at 128 count 1
  define colors SourceColor at 128 count 1

  reflect pattern 128 to 129 count 1 horizontal
  reflect pattern 128 to 130 count 1 vertical
  rotate pattern 128 to 131 count 1 90
  enlarge pattern 128 to 144 count 1
  enlarge pattern 129 to 148 count 1
  enlarge pattern 130 to 152 count 1
  enlarge pattern 131 to 156 count 1

  ' Graphics II has independent PATTERN/COLOR tables for each screen third.
  reflect pattern 384 to 385 count 1 horizontal
  reflect pattern 384 to 386 count 1 vertical
  rotate pattern 384 to 387 count 1 90
  enlarge pattern 384 to 400 count 1
  enlarge pattern 385 to 404 count 1
  enlarge pattern 386 to 408 count 1
  enlarge pattern 387 to 412 count 1

  reflect pattern 640 to 641 count 1 horizontal
  reflect pattern 640 to 642 count 1 vertical
  rotate pattern 640 to 643 count 1 90
  enlarge pattern 640 to 656 count 1
  enlarge pattern 641 to 660 count 1
  enlarge pattern 642 to 664 count 1
  enlarge pattern 643 to 668 count 1

  print at 8,1,"OS7 PATTERN LAB"
  print at 4,3,"ORIGINAL"
  print at 16,3,"FLIP LEFT-RIGHT"

  ' BIOS stores each enlarged result as TL, BL, TR, BR.
  put char 144 at 7,5
  put char 146 at 8,5
  put char 145 at 7,6
  put char 147 at 8,6
  put char 148 at 22,5
  put char 150 at 23,5
  put char 149 at 22,6
  put char 151 at 23,6

  print at 2,9,"FLIP TOP-BOTTOM"
  print at 19,9,"ROTATE 90 CW"
  put char 152 at 8,11
  put char 154 at 9,11
  put char 153 at 8,12
  put char 155 at 9,12
  put char 156 at 23,11
  put char 158 at 24,11
  put char 157 at 23,12
  put char 159 at 24,12

  print at 3,15,"SOURCE 8X8"
  print at 18,15,"ENLARGE 2X"
  put char 128 at 7,17
  put char 144 at 22,16
  put char 146 at 23,16
  put char 145 at 22,17
  put char 147 at 23,17

  print at 3,20,"COLOR ROWS ARE DOUBLED"
  print at 5,22,"OS7 PATTERN + COLOR"
  screen on

main:
  goto main
