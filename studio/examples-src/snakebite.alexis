  $0C,$28,$41,$4E,$54,$48,$52,$4F,$50,$49,$43,$29,$2E,$0E,$28,$54,$52,$41,$44,$49,$54,$49,$4F,$4E
  $41,$4C,$29,$2E,$02,$31,$30,$04,$31,$30,$30,$30,$04,$31,$32,$38,$2C,$05,$31,$39,$39,$30,$2E,$05
