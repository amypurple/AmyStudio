  $A2,$D9,$00,$08,$0E,$3F,$37,$30,$FE,$F3,$CE,$E2,$E0,$C6,$3A,$D8,$18,$EA,$9E,$F8,$80,$10,$99,$06
  $0F,$3F,$48,$93,$E0,$F8,$82,$FF,$78,$FF,$49,$00,$43,$F9,$96,$FE,$75,$55,$58
