' loop counters
u8 Si = 0
u8 Mi = 0
u8 Li = 0
u8 Ki = 0
u8 Pi = 0
' scratch
u8 A = 0
u8 B = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Hd = 0
u8 Bs = 0
u8 Rg = 0
u8 P1 = 0
u8 Col = 0
u8 Cy = 0
u8 Cx = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  mode 2 screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  InitSnakes
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if State = StPlay then goto play_loop

  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ===========================================================================
' the C128 machine code ($13A8: one pass per jiffy)

' $1686: SEC, ROL R26/R27/R28, then RA + R26 + R27 + R28 with the carries
' -> RA (and R26). Z80 (the 6502's ROL and ADC are the Z80's RLA and ADC).
sub Rnd:
  asm {
    ld hl,R26
    ld a,(hl)
    scf
    rla
    ld (hl),a
    ld hl,R27
    ld a,(hl)
    rla
    ld (hl),a
    ld hl,R28
    ld a,(hl)
    rla
    ld (hl),a
    ld a,(RA)
    ld hl,R26
    adc a,(hl)
    ld hl,R27
    adc a,(hl)
    ld hl,R28
    adc a,(hl)
    ld (R26),a
    ld (RA),a
    ret
  }
end sub

' the snakes at power-on: every point at the C128 RAM pattern's value
sub InitSnakes:
  for Si = 0 to 63
    SX[Si] = 80
    SY[Si] = 80
    SD[Si] = 0
  next
  fill array SAct with 0
  fill array RHd with 0
  return
end sub

' $13A8: the jiffy
sub MlStep:
  ' $D01F, bit 1: the shadow touches snake pixels (only read on the floor)
  ' $13AE: the C128 also drew six random sprite colours a jiffy (the mice
  ' twinkled): the port's mice stay white (no 60 Hz flashing), so those six
  ' random numbers are not drawn
  if Stat <> 0 then return
  if H = 0 then
    Col = 0
    ShadowHit
    if Col <> 0 then
      Stat = 255
      return
    end if
    MouseCatch
    if Stat <> 0 then return
  end if
  PlayerStep
  MiceStep
  ' $13E1: snakes, GV/256 steps a jiffy, two snakes a step
  W16 = GV
  if GV = 255 then W16 = 256
  SAcc += W16
  if SAcc < 256 then return
  SAcc = SAcc & 255
  for Pi = 0 to 1
    if SAct[SCur] <> 0 then SnakeStep
    inc SCur
    if SCur >= GN then SCur = 0
  next
  return
end sub

' $190E: a mouse within 5 columns and 10 rows of the shadow is caught
' (the C128 tests sprites 7 down to 2)
sub MouseCatch:
  for Mi = 5 downto 0
    if MOn[Mi] = 1 then
      A = Px - MX[Mi]
      if Px < MX[Mi] then A = MX[Mi] - Px
      if A < 6 then
        B = Py - MY[Mi]
        if Py < MY[Mi] then B = MY[Mi] - Py
        if B < 11 then
          Stat = 254
          CatchI = Mi
          return
        end if
      end if
    end if
  next
  return
end sub

' the shadow's pixels (rows Py..Py+3: .XX. / XXXX / XXXX / .XX.) against the
' snake pixels on screen -> Col = 2. The C128's sprite-background collision
' register saw its own bitmap; here the field's port pixels of each shadow
' pixel are tested (y 36-190, x 8-151; port rule, README). Z80.
sub ShadowHit:
  asm {
    ld a,(Py)
    ld (NY),a
    ld a,(Px)
    inc a
    ld b,a
    inc a
    call LbSh1
    ld a,(NY)
    inc a
    ld (NY),a
    ld a,(Px)
    ld b,a
    add a,3
    call LbSh1
    ld a,(NY)
    inc a
    ld (NY),a
    ld a,(Px)
    ld b,a
    add a,3
    call LbSh1
    ld a,(NY)
    inc a
    ld (NY),a
    ld a,(Px)
    inc a
    ld b,a
    inc a
LbSh1:
    ld c,a
    ld a,(NY)
    cp 36
    ret c
    cp 191
    ret nc
    ld e,a
    ld d,0
    ld hl,YT
    add hl,de
    ld a,(hl)
    sub 24
    ret c
    cp 152
    ret nc
    ld l,a
    ld h,0
    add hl,hl
    ld de,RowA
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,c
    inc a
    ld c,a
    ld a,b
    ld hl,XT
    push de
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    cp 24
    jr nc,LbSh2
    ld a,24
LbSh2:
    ld b,a
    ld hl,XT
    ld e,c
    add hl,de
    ld a,(hl)
    dec a
    cp 232
    jr c,LbSh3
    ld a,231
LbSh3:
    ld c,a
    pop de
    ld a,c
    cp b
    ret c
    ld a,b
    and 7
    ld l,a
    ld h,0
    push de
    ld de,LMsk
    add hl,de
    ld a,(hl)
    ld (NX),a
    ld a,c
    and 7
    ld l,a
    ld h,0
    ld de,RMsk
    add hl,de
    ld a,(hl)
    ld (NR),a
    pop de
    ld a,b
    and $F8
    sub 24
    ld l,a
    ld h,0
    add hl,de
    ex de,hl
    ld a,c
    and $F8
    ld h,a
    ld a,b
    and $F8
    cp h
    jr nz,LbSh4
    ld a,(NX)
    ld h,a
    ld a,(NR)
    and h
    jr LbSh5
LbSh4:
    ld a,(NX)
    call LbSh5
    ld hl,8
    add hl,de
    ex de,hl
    ld a,(NR)
LbSh5:
    ld h,a
    ld a,e
    out (VDP_CTRL_PORT),a
    ld a,d
    and $3F
    out (VDP_CTRL_PORT),a
    nop                 ; paced: >= 29 T from the address set-up to the IN
    nop                 ; (mid-screen the read-ahead waits up to 26 T for a
    nop                 ; slot); was ex (sp),hl x2, which the r11 optimizer
    nop                 ; deletes: plain NOPs are kept
    in a,(VDP_DATA_PORT)
    and h
    ret z
    ld a,2
    ld (Col),a
    ret
  }
end sub

' $16DD: the kid. The stick is latched while in the air and taken on the
' floor; every second jiffy the hop height moves 3 and the kid one step
sub PlayerStep:
  if Jk <> 0 then Lat25 = Jk
  if H = 0 then
    Lat24 = Lat25
    Lat25 = 0
  end if
  T = Jif & 1
  if T = 1 then
    ' $170E: height += speed; 20 or more (or below 0) turns it round
    T = H + Vel
    while T >= 20
      Vel = 0 - Vel
      T = H + Vel
    end while
    H = T
    if Lat24 <> 0 then
      K = Lat24 & 15
      K = JDir[K]
      A = StX[K]
      A += Px
      B = StY[K]
      B += Py
      if A >= 8 then
        if A < 148 then
          if B >= 36 then
            if B < 188 then
              Px = A
              Py = B
            end if
          end if
        end if
      end if
    end if
  end if
  if OnTitle = 1 then return
  if H = 0 then
    if Jif & 1 = 0 then return
    ' $1764: the landing "boing", its pitch from (R26 and R27) / 2 (the
    ' C128 restarts it on both floor jiffies: the port plays it once)
    T = R26 & R27
    T = T >> 6
    if T = 0 then play sound SndBoing0
    if T = 1 then play sound SndBoing1
    if T = 2 then play sound SndBoing2
    if T = 3 then play sound SndBoing3
  end if
  return
end sub

' $179B: mice, GF/256 steps a jiffy; each turns one way, the other or not
' at all (random), then makes two moves (a move out of the field is skipped)
sub MiceStep:
  W16 = GF
  if GF = 255 then W16 = 256
  MAcc += W16
  if MAcc < 256 then return
  MAcc = MAcc & 255
  MMoved = 1
  MiceLoop
  return
end sub

' Mice 5 down to 0 ($179B-$17DB): a random number ($1686: SEC, ROL R26 R27
' R28, A + R26 + R27 + R28 with the carries); if its bit 0 is set the mouse
' turns, +1 if bit 1 else -1 (of 8); then two moves (MvOne). Z80 for speed;
' the Amy form of MvOne:
'   A = MX + StX[MD] : B = MY + StY[MD] : outside x 8-147 / y 36-187: no move
'   C = YT[B + 1] (its port row; the mouse covers lines C..C+2) : port rule
'   (sprite budget): a move that changes the mouse's row is skipped if one
'   of its new lines already holds two other mice (Lc[] = mice per line), so
'   a scan line never shows more than the kid's 2 sprites + 2 mice. Caught
'   mice (parked) are skipped.
sub MiceLoop:
  asm {
    ld a,5
LbMl1:
    ld (Mi),a
    ld e,a
    ld d,0
    ld hl,MOn
    add hl,de
    ld a,(hl)
    or a
    jr z,LbMl4
    ld a,(RA)
    call LbRnd
    ld (RA),a
    ld c,a
    ld a,(Mi)
    ld e,a
    ld d,0
    ld hl,MD
    add hl,de
    bit 0,c
    jr z,LbMl3
    ld a,(hl)
    bit 1,c
    jr z,LbMl2
    inc a
    ld (hl),a
    jr LbMl3
LbMl2:
    dec a
    ld (hl),a
LbMl3:
    ld a,(hl)
    and 7
    ld (hl),a
    call LbMv1
    call LbMv1
LbMl4:
    ld a,(Mi)
    dec a
    jp p,LbMl1
    ret
LbRnd:
    ld e,a
    ld hl,R26
    ld a,(hl)
    scf
    rla
    ld (hl),a
    ld hl,R27
    ld a,(hl)
    rla
    ld (hl),a
    ld hl,R28
    ld a,(hl)
    rla
    ld (hl),a
    ld a,e
    ld hl,R26
    adc a,(hl)
    ld hl,R27
    adc a,(hl)
    ld hl,R28
    adc a,(hl)
    ld (R26),a
    ret
LbMv1:
    ld a,(Mi)
    ld e,a
    ld d,0
    ld hl,MD
    add hl,de
    ld c,(hl)
    ld b,0
    ld hl,StX
    add hl,bc
    ld a,(hl)
    ld hl,MX
    add hl,de
    add a,(hl)
    ld (NX),a
    cp 8
    ret c
    cp 148
    ret nc
    ld hl,StY
    add hl,bc
    ld a,(hl)
    ld hl,MY
    add hl,de
    add a,(hl)
    ld (NY),a
    cp 36
    ret c
    cp 188
    ret nc
    inc a
    ld c,a
    ld b,0
    ld hl,YT
    add hl,bc
    ld a,(hl)
    ld (NR),a
    ld hl,MR
    add hl,de
    ld c,(hl)
    cp c
    jr z,LbMv4
    ld b,3
    ld d,a
LbMv2:
    ld l,d
    ld h,0
    push bc
    ld bc,Lc
    add hl,bc
    pop bc
    ld a,(hl)
    ld h,a
    ld a,d
    sub c
    cp 3
    ld a,h
    jr nc,LbMv3
    dec a
LbMv3:
    cp 2
    ret nc
    inc d
    djnz LbMv2
    ld l,c
    ld h,0
    ld bc,Lc
    add hl,bc
    dec (hl)
    inc hl
    dec (hl)
    inc hl
    dec (hl)
    ld a,(NR)
    ld l,a
    ld h,0
    add hl,bc
    inc (hl)
    inc hl
    inc (hl)
    inc hl
    inc (hl)
LbMv4:
    ld d,0
    ld a,(NX)
    ld hl,MX
    add hl,de
    ld (hl),a
    ld a,(NY)
    ld hl,MY
    add hl,de
    ld (hl),a
    ld a,(NR)
    ld hl,MR
    add hl,de
    ld (hl),a
    ret
  }
end sub

' a mouse at port row C covers lines C..C+2
sub LcAdd:
  T = C
  Lc[T] += 1
  inc T
  Lc[T] += 1
  inc T
  Lc[T] += 1
  return
end sub

sub LcSub:
  T = C
  Lc[T] -= 1
  inc T
  Lc[T] -= 1
  inc T
  Lc[T] -= 1
  return
end sub

' one snake step for snake SCur ($13F6-$148A). The C128 moves every point
' one place down the body; here each snake's 8 points are a ring (RHd = the
' head's slot), the same points in the same order. Z80; in Amy:
'   K = slot of point 6, J = slot of point 7 : Pen = 0 : Seg  (erase the tail)
'   RHd = RHd - 1 (the old tail slot is the new head, a copy of point 1)
'   Rnd from the head's x : V = +6 if bit 0 else -6 (of 64)
'   turn: SD[head] += V : 4 DDA steps from the head (HeadDda + DdaStep; their
'   result depends only on the direction: tables OffX/OffY from gen.py);
'   outside x 7-152 or y 30-192: V = -6, turn again from there ($143A)
'   head = (DX0, DY0) : Pen = 1 : Seg from point 0 to point 1
sub SnakeStep:
  asm {
    ld a,(SCur)
    add a,a
    add a,a
    add a,a
    ld (Bs),a
    ld c,a
    ld a,(SCur)
    ld e,a
    ld d,0
    ld hl,RHd
    add hl,de
    ld a,(hl)
    ld (Rg),a
    ld b,a
    add a,6
    and 7
    add a,c
    ld (K),a
    ld a,b
    add a,7
    and 7
    add a,c
    ld (J),a
    xor a
    ld (Pen),a
    call AMY_UPROC_Seg
    ld a,(Rg)
    dec a
    and 7
    ld (Rg),a
    ld b,a
    ld a,(SCur)
    ld e,a
    ld d,0
    ld hl,RHd
    add hl,de
    ld (hl),b
    ld a,(Bs)
    ld c,a
    ld a,b
    add a,c
    ld (Hd),a
    ld a,b
    inc a
    and 7
    add a,c
    ld (P1),a
    ld e,a
    ld d,0
    ld a,(Hd)
    ld c,a
    ld b,0
    ld hl,SX
    add hl,de
    ld a,(hl)
    ld hl,SX
    add hl,bc
    ld (hl),a
    ld (RA),a
    ld (DX0),a
    ld hl,SY
    add hl,de
    ld a,(hl)
    ld hl,SY
    add hl,bc
    ld (hl),a
    ld (DY0),a
    ld hl,SD
    add hl,de
    ld a,(hl)
    ld hl,SD
    add hl,bc
    ld (hl),a
    call AMY_UPROC_Rnd
    ld a,(RA)
    and 1
    ld a,250
    jr z,LbSs1
    ld a,6
LbSs1:
    ld (V),a
LbSs2:
    ld a,(Hd)
    ld c,a
    ld b,0
    ld hl,SD
    add hl,bc
    ld a,(V)
    add a,(hl)
    and 63
    ld (hl),a
    ld c,a
    ld hl,OffX
    add hl,bc
    ld a,(DX0)
    add a,(hl)
    ld (DX0),a
    ld hl,OffY
    add hl,bc
    ld a,(DY0)
    add a,(hl)
    ld (DY0),a
    ld a,250
    ld (V),a
    ld a,(DX0)
    cp 7
    jr c,LbSs2
    cp 153
    jr nc,LbSs2
    ld a,(DY0)
    cp 30
    jr c,LbSs2
    cp 193
    jr nc,LbSs2
    ld a,(Hd)
    ld c,a
    ld b,0
    ld hl,SX
    add hl,bc
    ld a,(DX0)
    ld (hl),a
    ld hl,SY
    add hl,bc
    ld a,(DY0)
    ld (hl),a
    ld a,1
    ld (Pen),a
    ld a,(Hd)
    ld (K),a
    ld a,(P1)
    ld (J),a
    jp AMY_UPROC_Seg
  }
end sub

' $1533/$1582: the head's step for direction SD[head]: quadrant q = dir/16
' (signs SgX/SgY), k = dir and 15 (16 - k in quadrants 1 and 3), the sine
' table TDX/TDY; then DdaInit. Z80.
sub HeadDda:
  asm {
    ld a,(Hd)
    ld c,a
    ld b,0
    ld hl,SD
    add hl,bc
    ld a,(hl)
    ld e,a
    and 15
    ld c,a
    ld a,e
    rrca
    rrca
    rrca
    rrca
    and 3
    ld b,a
    bit 0,b
    jr z,LbHd1
    ld a,16
    sub c
    ld c,a
LbHd1:
    push bc
    ld e,b
    ld d,0
    ld hl,SgX
    add hl,de
    ld a,(hl)
    ld (DSx),a
    ld hl,SgY
    add hl,de
    ld a,(hl)
    ld (DSy),a
    pop bc
    ld b,0
    ld hl,TDX
    add hl,bc
    ld a,(hl)
    ld (DDx),a
    ld hl,TDY
    add hl,bc
    ld a,(hl)
    ld (DDy),a
    jp AMY_UPROC_DdaInit
  }
end sub

' The line drawer, in Z80 (the busiest code: up to 2 snake steps a frame =
' 4 segments, 16 pixels, 24 steps). The Amy original of each is in comments.
' $15F3: the larger difference is the count; the other's sum starts at half
'   DEx = 0 : DEy = 0 : if DDy >= DDx then DMaj = DDy : DEx = DMaj >> 1
'   else DMaj = DDx : DEy = DMaj >> 1
sub DdaInit:
  asm {
    xor a
    ld (DEx),a
    ld (DEy),a
    ld a,(DDx)
    ld b,a
    ld a,(DDy)
    cp b
    jr c,LbDi1
    ld (DMaj),a
    srl a
    ld (DEx),a
    ret
LbDi1:
    ld a,b
    ld (DMaj),a
    srl a
    ld (DEy),a
    ret
  }
end sub

' $14F1: one step
'   T = DEx + DDx : if T >= DMaj then T -= DMaj : DX0 += DSx
'   DEx = T ; the same for y ; dec DCnt
sub DdaStep:
  asm {
    ld a,(DMaj)
    ld b,a
    ld a,(DDx)
    ld c,a
    ld a,(DEx)
    add a,c
    cp b
    jr c,LbDs1
    sub b
    ld c,a
    ld a,(DSx)
    ld hl,DX0
    add a,(hl)
    ld (hl),a
    ld a,c
LbDs1:
    ld (DEx),a
    ld a,(DDy)
    ld c,a
    ld a,(DEy)
    add a,c
    cp b
    jr c,LbDs2
    sub b
    ld c,a
    ld a,(DSy)
    ld hl,DY0
    add a,(hl)
    ld (hl),a
    ld a,c
LbDs2:
    ld (DEy),a
    ld hl,DCnt
    dec (hl)
    ret
  }
end sub

' $14B0/$15AA: segment from point K to point J, 4 pixels from point K, Pen
'   DX0 = SX[K] : DY0 = SY[K] : DDx = |SX[J] - DX0|, DSx = 1 or 255 (the same
'   for y) : DdaInit : 4 times: if DX0 < 153 and DY0 < 193 then Plot : DdaStep
sub Seg:
  asm {
    ld a,(K)
    ld c,a
    ld b,0
    ld hl,SX
    add hl,bc
    ld a,(hl)
    ld (DX0),a
    ld hl,SY
    add hl,bc
    ld a,(hl)
    ld (DY0),a
    ld a,(J)
    ld c,a
    ld hl,SX
    add hl,bc
    ld a,(hl)
    ld e,1
    ld hl,DX0
    sub (hl)
    jr nc,LbSg1
    neg
    ld e,255
LbSg1:
    ld (DDx),a
    ld a,e
    ld (DSx),a
    ld hl,SY
    add hl,bc
    ld a,(hl)
    ld e,1
    ld hl,DY0
    sub (hl)
    jr nc,LbSg2
    neg
    ld e,255
LbSg2:
    ld (DDy),a
    ld a,e
    ld (DSy),a
    call AMY_UPROC_DdaInit
    ld a,4
    ld (DCnt),a
LbSg3:
    ld a,(DX0)
    cp 153
    jr nc,LbSg4
    ld a,(DY0)
    cp 193
    jr nc,LbSg4
    call AMY_UPROC_Plot
LbSg4:
    call AMY_UPROC_DdaStep
    ld a,(DCnt)
    or a
    jr nz,LbSg3
    ret
  }
end sub

' one C128 pixel (DX0,DY0) with Pen (1 draw, 0 erase): its 1-2 port pixels
' (tables XB/XM/XM2 from gen.py). The busiest routine of the game (up to 16 pixels a
' frame), so it is Z80: the same steps as the Amy version kept in the README.
' Runs with the NMI off (the play pass), like every VRAM access of the pass.
sub Plot:
  asm {
LbPl1:
    ld a,(DY0)
    ld c,a
    ld b,0
    ld hl,YT
    add hl,bc
    ld a,(hl)
    sub 24
    ret c
    cp 152
    ret nc
    ld l,a
    ld h,0
    add hl,hl
    ld de,RowA
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,(DX0)
    ld c,a
    ld b,0
    ld hl,XM
    add hl,bc
    ld a,(hl)
    or a
    ret z
    ld hl,XB
    add hl,bc
    push af
    ld a,(hl)
    add a,e
    ld e,a
    ld a,d
    adc a,0
    ld d,a
    pop af
    push bc
    ld b,a
    call LbPl2
    pop bc
    ld hl,XM2
    add hl,bc
    ld a,(hl)
    or a
    ret z
    ld b,a
    ld hl,8
    add hl,de
    ex de,hl
LbPl2:
    ld a,e
    out (VDP_CTRL_PORT),a
    ld a,d
    and $3F
    out (VDP_CTRL_PORT),a
    nop                 ; paced: >= 29 T from the address set-up to the IN
    nop                 ; (mid-screen the read-ahead waits up to 26 T for a
    nop                 ; slot); was ex (sp),hl x2, which the r11 optimizer
    nop                 ; deletes: plain NOPs are kept
    in a,(VDP_DATA_PORT)
    ld c,a
    ld a,(Pen)
    or a
    jr z,LbPl3
    ld a,c
    or b
    jr LbPl4
LbPl3:
    ld a,b
    cpl
    and c
LbPl4:
    ld c,a
    ld a,e
    out (VDP_CTRL_PORT),a
    ld a,d
    and $3F
    or $40
    out (VDP_CTRL_PORT),a
    ld a,c
    out (VDP_DATA_PORT),a
    ret
  }
end sub

' ===========================================================================
' the BASIC part

' 16-bit xorshift for what the C128's BASIC took from RND (mice places, the
' kid's colour, messages); stepped every title frame
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandBelow(u8 M) as u8
  u8 Rv = 0
  Rand
  W16 = Rs % M
  Rv = W16
  return Rv

sub NewGame:
  Score = 0
  GL = 1
  ' port difficulty (README): 4 lives; the C128 gave 3
  GR = 4
  OnTitle = 0
  stop sound SndTuneA
  play sound SndStart
  LevelStart
  State = StPlay
  return
end sub

' BASIC 740-880: a classroom (again). Screen cleared, the mice placed, the
' snakes put in the middle, the kid at (73,150) in a random colour
sub LevelStart:
  T = GL - 1
  GN = LvN[T]
  GV = LvV[T]
  GF = LvF[T]
  GT = LvT[T]
  GTMax = GT
  ' the timer: BASIC takes 1000 off every 17 passes of its loop; the passes
  ' slow down as the machine code takes more of each jiffy (VICE: about 145
  ' jiffies a 1000 in classroom 1, 170-190 in classroom 4)
  W16 = GV >> 2
  TPer = 136 + W16
  TCnt = 0
  NMice = GL
  if NMice > 6 then NMice = 6
  NC = NMice
  Caught = 0
  Stat = 1
  HissT = 200
  DrawPlay
  ' snakes: GN of them from (80,80); a level starts with every point there and
  ' snake n heading n*8+4 (of 64); the machine code's hop, latches and step
  ' accumulators start at 0 (the C128 kept whatever they held: see README)
  for Si = 0 to 7
    SAct[Si] = 0
    if Si < GN then SAct[Si] = 1
  next
  fill array RHd with 0
  for Si = 0 to 63
    SX[Si] = 80
    SY[Si] = 80
  next
  for Si = 0 to 63
    T = Si & $38
    T = T + 4
    SD[Si] = T
  next
  SCur = 0
  SAcc = 0
  MAcc = 0
  H = 0
  Vel = 253
  Lat24 = 0
  Lat25 = 0
  ' mice (BASIC 1520-1610), the C128 parks the others at (0,0) = out of play
  for Mi = 0 to 5
    MOn[Mi] = 0
    MX[Mi] = 244
    MY[Mi] = 206
    MD[Mi] = 0
  next
  fill array Lc with 0
  for Mi = 0 to NMice - 1
ls_m:
    T = RandBelow(138)
    MX[Mi] = T + 9
    T = RandBelow(155)
    MY[Mi] = T + 32
    ' the port's line budget (see MiceLoop): re-place a mouse that would make
    ' a line hold three mice
    C = MY[Mi] + 1
    C = YT[C]
    if Lc[C] >= 2 then goto ls_m
    T = C + 1
    if Lc[T] >= 2 then goto ls_m
    T = C + 2
    if Lc[T] >= 2 then goto ls_m
    MR[Mi] = C
    LcAdd
    MOn[Mi] = 1
  next
  Px = 73
  Py = 150
  T = RandBelow(9)
  KidC = KidCol[T]
  ShowHud
  DrawSprites
  ' "CLASSROOM n" and the scale run (BASIC 850-880)
  print at 10,MsgRow, "CLASSROOM"
  NumU = GL
  print at 20,MsgRow, digits$(NumU, 2)
  play sound SndScale
  Ph = PhStart
  PhT = 75
  return
end sub

' one frame of play
sub PlayStep:
  inc Jif
  if Ph = PhStart then
    MlStep
    DrawSprites
    dec PhT
    if PhT = 0 then
      RestoreRow
      Stat = 0
      Ph = PhRun
      Jif = 0
    end if
    return
  end if
  if Ph = PhRun then
    MMoved = 0
    MlStep
    ' the kid changes on odd jiffies, the mice when they step
    T = Jif & 1
    T = T | MMoved
    if T <> 0 then DrawSprites
    if Stat = 254 then
      Caught1
      return
    end if
    if Stat = 255 then
      Bitten
      return
    end if
    ' BASIC 920-990: the timer
    inc TCnt
    if TCnt >= TPer then
      TCnt = 0
      dec GT
      DrawTime
      if GT < 6 then play sound SndTick
      if GT = 0 then
        Stat = 255
        TimeUp
        return
      end if
    end if
    ' BASIC 930-940: now and then a snake hisses or a mouse squeaks (2% of
    ' BASIC passes each on the C128: about every 6 s)
    dec HissT
    if HissT = 0 then
      ' (random bits straight from the xorshift: no division in the pass)
      Rand
      T = Rs & 1
      if T = 0 then
        play sound SndHiss
      else
        play sound SndSqueak
      end if
      W16 = Rs >> 8
      T = W16
      if T < 100 then T += 100
      HissT = T
    end if
    return
  end if
  ' a pause (status <> 0): the machine code still runs its jiffy (the mice
  ' colours), everything else waits for BASIC
  MlStep
  dec PhT
  if Ph = PhBite then
    ' the kid blinks (2 Hz) while the C128 cycles its colours
    T = PhT & 15
    if T = 0 then
      inc Blinks
      DrawSprites
    end if
  end if
  if PhT <> 0 then return
  if Ph = PhCatch then
    CatchDone
    return
  end if
  if Ph = PhClear then
    inc GL
    if GL < 11 then
      LevelStart
    else
      GameOver
    end if
    return
  end if
  ' a bite or the teacher: one life less
  dec GR
  if GR > 0 then
    LevelStart
  else
    GameOver
  end if
  return
end sub

' BASIC 1080-1180: a mouse caught: to the tray, GL thousand points
sub Caught1:
  C = MR[CatchI]
  LcSub
  MOn[CatchI] = 0
  MX[CatchI] = 244
  MY[CatchI] = 206
  inc Caught
  Score += GL
  play sound SndCatch
  NumU = GL
  if GL < 10 then
    print at 14,MsgRow, digits$(NumU, 1)
    print at 15,MsgRow, "000"
  else
    print at 14,MsgRow, digits$(NumU, 2)
    print at 16,MsgRow, "000"
  end if
  ShowHud
  DrawSprites
  Ph = PhCatch
  PhT = TCatch
  return
end sub

' the C128 erased the "1000" with 8 blanks (columns 18-25 of row 19):
' that also erased the snake pixels under it
sub CatchDone:
  RestoreRow
  ' the port pixels of the same rectangle: x 116-162 (tile columns 14-20 of
  ' the field bitmap), rows YT[152]-YT[159]
  C = YT[160]
  for Y = YT[152] to C - 1
    T = Y - 24
    W2 = RowA[T]
    W16 = W2 + 88
    asm {
        ld hl,(AMY_UVAR_W16)
        ld a,$A5            ; Amy's VDP guard (as AMY_VPEEK)
        ld ($701F),a
        ld a,l
        out ($BF),a
        ld a,h
        and $3F
        out ($BF),a
        nop                 ; paced: >= 29 T from the address set-up to the IN
        nop                 ; (mid-screen the read-ahead waits up to 26 T for
        nop                 ; an access slot). Amy's vpeek (AMY_VPEEK) has an
        nop                 ; ex (sp),hl pair there, but the r11 optimizer deletes it
        in a,($BE)
        ld (AMY_UVAR_V),a
        call AMY_RELEASE_VDP_GUARD
    }
    V = V & $F0
    vpoke W16, V
    for Li = 0 to 4
      W16 += 8
      vpoke W16, 0
    next
    W16 += 8
    asm {
        ld hl,(AMY_UVAR_W16)
        ld a,$A5            ; Amy's VDP guard (as AMY_VPEEK)
        ld ($701F),a
        ld a,l
        out ($BF),a
        ld a,h
        and $3F
        out ($BF),a
        nop                 ; paced: >= 29 T from the address set-up to the IN
        nop                 ; (mid-screen the read-ahead waits up to 26 T for
        nop                 ; an access slot). Amy's vpeek (AMY_VPEEK) has an
        nop                 ; ex (sp),hl pair there, but the r11 optimizer deletes it
        in a,($BE)
        ld (AMY_UVAR_V),a
        call AMY_RELEASE_VDP_GUARD
    }
    V = V & $1F
    vpoke W16, V
  next
  dec NC
  if NC > 0 then
    Stat = 0
    Ph = PhRun
    return
  end if
  ' classroom cleared (BASIC 1200-1270): the time left is a bonus
  W16 = GT
  Score += W16
  GT = 0
  DrawTime
  ShowHud
  T = RandBelow(2)
  if T = 0 then
    print at 7,MsgRow, "ANTS IN THE PANTS!"
    play sound SndAnts
  else
    print at 6,MsgRow, "WHAT A JUMPING BEAN!"
    play sound SndBean
  end if
  Ph = PhClear
  PhT = 120
  if GL = 10 then
    print at 6,20, "ALL MICE ARE CAUGHT!"
    PhT = 180
  end if
  return
end sub

sub Bitten:
  print at 7,MsgRow, "YOU BIT THE DUST!"
  play sound SndBite
  Ph = PhBite
  PhT = 150
  Blinks = 0
  return
end sub

sub TimeUp:
  print at 8,MsgRow, "TEACHER'S BACK!"
  play sound SndTimeUp
  Ph = PhBite
  PhT = 150
  Blinks = 0
  return
end sub

sub GameOver:
  if Score > Hi then Hi = Score
  HideSprites
  RestoreRow
  print at 11,16, "GAME OVER"
  play sound SndOver
  State = StOver
  return
end sub

' the message row (port row 18) back to the field's tiles
sub RestoreRow:
  T = MsgRow - 3
  K = RN[T]
  W16 = $1800 + MsgRow * 32
  W16 += 3
  for Li = 0 to 25
    vpoke W16, K
    inc K
    inc W16
  next
  return
end sub

' ===========================================================================
' drawing

sub DrawSprites:
  ' the kid: frame A (pogo compressed) below height 8, B above; art row 0 is
  ' C128 sprite row 2 (A) or 0 (B); the C128 draws it at (Px-3, Py-18-H)
  T = Py - 18
  T -= H
  if H < 8 then
    T += 2
    A = SKidaw
    B = SKidab
  else
    A = SKidbw
    B = SKidbb
  end if
  Y = YT[T]
  if Y >= 200 then Y = 8
  if Y < 8 then Y = 8
  Y -= 1
  T = Px - 3
  X = XT[T]
  if OnTitle = 1 then
    set sprite 0 to HideY,0,A,0
    set sprite 1 to HideY,0,B,0
    goto ds_mice
  end if
  ' bitten: the body layer blinks (2 Hz; the C128 cycled its colour fast)
  K = Y
  if Ph = PhBite then
    T = Blinks & 1
    if T = 1 then K = HideY
  end if
  set sprite 0 to Y,X,A,15
  set sprite 1 to K,X,B,KidC
ds_mice:
  ' the kid (sprite table entries 0-1, $1B00) then the mice (entries 2-7,
  ' $1B08) written straight to VRAM, paced: >= 29 T between VRAM writes
  ' (TMS9928A mid-screen access slots). (vdp-safe pass: this replaces
  ' "update sprites from 0 count 2", whose runtime loop writes 27 T apart;
  ' its $D0 at entry 2 was overwritten by the mice at once anyway)
  ' (Z80: the busiest rooms move them every frame)
  MPat = SMouse
  asm {
    xor a
    out (VDP_CTRL_PORT),a
    ld a,$5B
    out (VDP_CTRL_PORT),a
    ld hl,AMY_SPRITE_TABLE
    ld b,2
LbDk1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    nop
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    nop
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    ld a,(hl)
    and $8F
    out (VDP_DATA_PORT),a
    inc hl
    djnz LbDk1
    ld bc,0
LbDm1:
    ld hl,MOn
    add hl,bc
    ld a,(hl)
    or a
    jr z,LbDm2
    ld hl,MY
    add hl,bc
    ld a,(hl)
    inc a
    ld e,a
    ld d,0
    ld hl,YT
    add hl,de
    ld a,(hl)
    dec a
    out (VDP_DATA_PORT),a
    ld hl,MX
    add hl,bc
    ld e,(hl)
    ld hl,XT
    add hl,de
    ld a,(hl)
    out (VDP_DATA_PORT),a
    nop                 ; paced: >= 29 T between the VRAM writes
    ld a,(MPat)
    out (VDP_DATA_PORT),a
    nop
    nop
    ld a,15
    out (VDP_DATA_PORT),a
    jr LbDm3
LbDm2:
    ld a,192
    out (VDP_DATA_PORT),a
    nop                 ; paced: >= 29 T between the VRAM writes
    nop
    nop
    xor a
    out (VDP_DATA_PORT),a
    nop
    ld a,(MPat)
    out (VDP_DATA_PORT),a
    nop
    nop
    nop
    xor a
    out (VDP_DATA_PORT),a
LbDm3:
    inc c
    ld a,c
    cp 6
    jr nz,LbDm1
  }
  return
end sub

' HUD row 1: lives (kids), the time bar, LV n, the mice (caught white,
' still loose grey), the score (thousands + "000")
sub ShowHud:
  for Li = 0 to 3
    C = Li + 2
    T = TBlank
    if Li < GR then T = TLife
    put char T at C,1
  next
  put char TClock at 6,1
  DrawTime
  print at 13,1, "LV"
  NumU = GL
  print at 15,1, digits$(NumU, 2)
  for Li = 0 to 5
    C = Li + 17
    T = TBlank
    if Li < NMice then
      T = TSlot
      if Li < Caught then T = TMouse
    end if
    put char T at C,1
  next
  NumU = Score
  print at 24,1, digits$(NumU, 3)
  print at 27,1, "000"
  return
end sub

' the time bar: 5 cells, 10 half steps, GT of GTMax
sub DrawTime:
  ' K = GT * 10 / GTMax (by subtraction: no division in the play pass)
  K = 0
  V = GT * 10
  while V >= GTMax
    V -= GTMax
    inc K
  end while
  if GT > 0 then
    if K = 0 then K = 1
  end if
  for Li = 0 to 4
    C = Li + 7
    T = Li << 1
    V = TBare
    if K > T then
      V = TBarh
      J = T + 1
      if K > J then V = TBarf
    end if
    put char V at C,1
  next
  return
end sub

' the playfield screen: hearts, an empty bitmap field, HUD
sub DrawPlay:
  NewScreen
  FieldColors
  DrawField
  ShowScreen
  return
end sub

' colours of the field's tiles in each third: light green on black
sub FieldColors:
  for Li = 0 to 18
    T = Li + 3
    K = T >> 3
    W16 = K
    W16 = W16 << 11
    W16 += $2000
    T = RN[Li]
    W2 = T
    W2 = W2 << 3
    W16 += W2
    fill $31 count 208 to vram.pattern + W16
  next
  return
end sub

' border, field tiles (all clear)
sub DrawField:
  fill THeart count 28 at 2,2
  fill THeart count 28 at 2,22
  for Li = 3 to 21
    put char THeart at 2,Li
    put char THeart at 29,Li
    T = Li - 3
    K = RN[T]
    W16 = Li
    W16 = W16 << 5
    W16 += $1803
    for Ki = 0 to 25
      vpoke W16, K
      inc K
      inc W16
    next
    ' clear the tile patterns of the row
    T = Li - 3
    K = RN[T]
    J = Li >> 3
    W16 = J
    W16 = W16 << 11
    W2 = K
    W2 = W2 << 3
    W16 += W2
    fill 0 count 208 to vram.pattern + W16
  next
  return
end sub

' ===========================================================================
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  for J = 0 to 7
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen: display off, Graphics II with independent thirds, the font in
' every third (white on black), the art tiles (128+), name table blank
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  load default ascii
  duplicate mode 2 patterns
  fill full mode 2 text color with $F1
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TileColZ to vram.color + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  decompress zx0 TileColZ to vram.color + 5120
  backdrop black
  fill TBlank count 768 to vram.name
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the classroom with a snake and six mice running about (the
' C128's attract screen), the name, the menu, the tune once
sub TitlePage:
  State = StBoot
  ' drawn with the display off (DrawPlay without its ShowScreen)
  NewScreen
  FieldColors
  DrawField
  print at 2,1, "BY KEN HUEBNER"
  if Hi > 0 then
    print at 18,1, "HI"
    NumU = Hi
    print at 21,1, digits$(NumU, 3)
    print at 24,1, "000"
  end if
  ' the attract machine: 1 snake at (80,100), 6 mice, speeds 30 / 44
  GN = 2
  GV = 30
  GF = 44
  for Si = 0 to 7
    SAct[Si] = 0
  next
  SAct[0] = 1
  T = RHd[0]
  SX[T] = 80
  SY[T] = 100
  fill array Lc with 0
  for Mi = 0 to 5
tp_m:
    T = RandBelow(138)
    MX[Mi] = T + 9
    T = RandBelow(155)
    MY[Mi] = T + 32
    C = MY[Mi] + 1
    C = YT[C]
    if Lc[C] >= 2 then goto tp_m
    T = C + 1
    if Lc[T] >= 2 then goto tp_m
    T = C + 2
    if Lc[T] >= 2 then goto tp_m
    MR[Mi] = C
    LcAdd
    MOn[Mi] = 1
  next
  ' the kid sits out of play in the corner, as on the C128 (shadow at 2,32)
  Px = 2
  Py = 32
  KidC = 13
  Stat = 0
  OnTitle = 1
  Ph = PhRun
  NMice = 6
  ' the C128's colours: the name in yellow (screen third 0), the menu in
  ' pink like its PUSH BUTTON TO PLAY (third 2)
  fill $B1 count 512 to vram.color + 256
  fill $91 count 512 to vram.color + 4352
  TitleText
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  inc Jif
  ' the attract jiffy (the stick does not move the kid: he is outside)
  Jk = 0
  MlStep
  Stat = 0
  DrawSprites
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' title words over the field: rows 4-6 (third 0) and 16-20 (third 2) use
' the font; the field tiles there are put back by RestoreText
sub TitleText:
  print at 8,4, "JUMP'N SNAKES,"
  print at 9,6, "CATCH'N MICE"
  print at 11,16, "START"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  return
end sub

sub ShowMenu:
  put char 32 at 9,16
  put char 32 at 9,18
  put char 32 at 9,20
  C = Menu << 1
  C += 16
  put char 62 at 9,C
  return
end sub

sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 11,2, "SNAKE BITE"
  TxT = TxtCredits
  TxX0 = 3
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: three pages, pictures from the game's own sprites and tiles
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  TxT = TxtHow1
  TxX0 = 3
  TxY = 3
  TxGap = 2
  TextShow
  ' the kid and a mouse
  set sprite 0 to 135,96,SKidaw,15
  set sprite 1 to 135,96,SKidab,13
  set sprite 2 to 148,136,SMouse,15
  update sprites
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/3"
    TxT = TxtHow2
    TxX0 = 3
    TxY = 3
    TxGap = 2
    TextShow
    put char TSn1 at 12,18
    put char TSn2 at 13,18
    put char TSn3 at 14,18
    put char TSn4 at 14,19
    set sprite 0 to 120,128,SKidbw,15
    set sprite 1 to 120,128,SKidbb,13
    update sprites
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  if TimedOut = 0 then
    Page = 3
    NewScreen
    print at 8,1, "HOW TO PLAY  3/3"
    TxT = TxtHow3
    TxX0 = 3
    TxY = 3
    TxGap = 2
    TextShow
    put char TLife at 6,17
    put char TLife at 7,17
    put char TLife at 8,17
    put char TClock at 11,17
    put char TBarf at 12,17
    put char TBarf at 13,17
    put char TBarh at 14,17
    put char TBare at 15,17
    put char TMouse at 18,17
    put char TSlot at 19,17
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
  if TxC >= 240 then
    TxW = TxC - 240
    TxW = TxW << 8
    TxC = peek(TxP)
    TxW += TxC
    TxP += 1
  end if
  if TxF = 0 then
    put char 32 at TxX,TxY
    inc TxX
  end if
  TxF = 0
  TxL = TxW & 15
  TxW = TxW >> 4
  TxQ = TxDictGrp[TxW]
ts_skip:
  if TxL > 0 then
    TxC = peek(TxQ)
    TxQ += TxC
    TxQ += 1
    dec TxL
    goto ts_skip
  end if
  TxL = peek(TxQ)
  TxQ += 1
ts_ch:
  if TxL = 0 then goto ts_word
  TxC = peek(TxQ)
  put char TxC at TxX,TxY
  inc TxX
  TxQ += 1
  dec TxL
  goto ts_ch
ts_end:
  return
end sub

data TilePatZ bytes
  $96,$00,$22,$93,$01,$07,$83,$38,$10,$00,$18,$C3,$18,$81,$18,$B8,$F7,$10,$D1,$23,$38,$83,$02,$D8
  $A2,$F0,$44,$C5,$65,$B8,$C3,$4A,$89,$8D,$81,$42,$C3,$FE,$28,$F0,$68,$00,$1A,$01,$1E,$C6,$24,$A6
  $03,$0E,$38,$E0,$00,$00,$1C,$06,$03,$02,$02,$80,$C0,$E0,$30,$18,$08,$0C,$07,$35,$55,$58
end data
