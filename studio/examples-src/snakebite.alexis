' --- the C128 machine code's state ($1300-$1A4F) -------------------------
' snakes: 8 x 8 points (head = S*8, tail = S*8+7), direction per point
u8 SX[64]
u8 SY[64]
u8 SD[64]
u8 SAct[8]
u8 RHd[8]
u8 GN = 0
u8 GV = 0
u8 GF = 0
u8 Stat = 0
u8 SCur = 0
u16 SAcc = 0
u16 MAcc = 0
' player: shadow position (Px,Py), hop height H and speed Vel (3 / 253)
u8 Px = 0
u8 Py = 0
u8 H = 0
u8 Vel = 253
u8 Lat24 = 0
u8 Lat25 = 0
u8 Jif = 0
' 24-bit random generator ($1686) and its accumulator chain
u8 R26 = 167
u8 R27 = 71
u8 R28 = 33
u8 RA = 0
' mice (C128 sprites 2-7 -> 0-5)
u8 MX[6]
u8 MY[6]
u8 MD[6]
u8 MOn[6]
u8 MR[6]
u8 Lc[192]
u8 MMoved = 0
u8 NX = 0
u8 MPat = 0
u8 NY = 0
u8 NR = 0
u8 CatchI = 0
' --- the BASIC part --------------------------------------------------------
u8 GL = 1
u8 GR = 4
u8 GT = 0
u8 GTMax = 0
u8 NC = 0
u8 NMice = 0
u8 KidC = 0
u8 Ph = 0
u8 PhT = 0
