u8 DSy = 0
u8 DDx = 0
u8 DDy = 0
u8 DEx = 0
u8 DEy = 0
u8 DMaj = 0
u8 DCnt = 0
u8 Pen = 0
' --- frame, menus ---
u16 Rs = 1
u16 W16 = 0
u16 W2 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
