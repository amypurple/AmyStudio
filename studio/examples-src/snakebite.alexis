  $96,$01,$82,$16,$A0,$61,$E2,$01,$D1,$1D,$F1,$FD,$B1,$1B,$E3,$DD,$F1,$1F,$A6,$FF,$01,$88,$E1,$A2
  $1E,$01,$1F,$F1,$0E,$DE,$B8,$03,$FE,$A8,$01,$9B,$3E,$31,$3E,$A7,$87,$0E,$EE,$F6,$E3,$FE,$38,$68
  $FF,$CC,$F4,$7F,$FF,$DC,$79,$E0,$D5,$55,$60
