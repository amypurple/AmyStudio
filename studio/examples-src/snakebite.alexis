  $03,$54,$48,$45,$01,$41,$03,$41,$4E,$44,$02,$49,$4E,$04,$42,$49,$54,$45,$02,$42,$59,$05,$43,$41
  $54,$43,$48,$02,$49,$53,$04,$4C,$41,$4E,$44,$04,$4D,$49,$43,$45,$05,$4D,$4F,$55,$53,$45,$02,$4F
