cartridge "ANIMAL MATCH/COMPUTE!'S GAZETTE/1987"

' ANIMAL MATCH
' Ported from "Animal Match", COMPUTE!'s Gazette, December 1987
' (Commodore 64, machine language; the disk's program "ANIMAL MATCH"
' at $C000, disassembled in orig/amatch.dis). Made for the ColecoVision
' in Amy (the language by Amy Bienvenu) by Claude (an AI made by
' Anthropic) for Amy Studio, 2026.
'
' The original's rules, kept: a keyboard of 36 keys (1-0, Q-P, A-L, Z-M)
' hides 18 animals, each twice, dealt at random. Pick a key: its animal
' and name show in the first box; pick another: the second box. A pair
' is taken off the board when both keys hide the same animal; otherwise
' the keys come back. Two games:
'   KEYS ONLY: any matching pair counts.
'   KEYS AND SHAPES: the pair must also be the animal shown in the FIND
'     box. The FIND animal changes on a timer, through the 18 in the
'     original's fixed order (snail, butterfly, ... ladybug), also the
'     animals already found; every round of 18 adds one to CYCLE.
' Every pair found shortens the FIND time (the original: 100 ticks,
' about 3.5 s, minus 5 ticks a pair). The game ends when all 18 pairs
' are found (the original's ten-note fanfare); CYCLE is the score
' (fewer is better). Same key twice and found keys are ignored.
' Animals: the original's 18 sprite shapes, reduced to 16 x 16 and
' shown doubled, in the original's names and order.
'
' Made for this machine / liberties:
' - Joystick instead of the C64 keyboard: a yellow frame moves over the
'   keys (wraps left and right, repeats when held) and the left button
'   picks. No quit key (the C64's F1): a game is short.
' - FIND time 216 frames (3.6 s, as the original) minus 6 frames a pair
'   (the original 5 ticks = 10.7 frames), never below 120 frames (2 s):
'   moving a cursor is slower than pressing a key (the original's last
'   FIND animals stayed only half a second).
' - The pair is checked against FIND when the second key is picked
'   (the original checked about a quarter second later).
' - Both picks stay in view 1.2 s on a miss, 0.7 s on a match (the
'   original about a quarter second), and the joystick waits meanwhile.
' - A timer bar under FIND; a TRIES count and PAIRS LEFT beside CYCLE;
'   found keys turn into dark blank caps (the C64 left them blank).
' - New keycaps, frame, sounds and an original title tune ("Two by Two");
'   the fanfare's notes are the original's, shorter.
'
' Controls: either joystick moves, left button picks; on the title the
' stick chooses and a button starts (or opens HOW TO PLAY, two pages: a
' button turns the page, 30 s idle goes back; or CREDITS).
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TK0l = 128
const TK0r = 129
const TK1l = 130
const TK1r = 131
const TK2l = 132
const TK2r = 133
const TK3l = 134
const TK3r = 135
const TK4l = 136
const TK4r = 137
const TK5l = 138
const TK5r = 139
const TK6l = 140
const TK6r = 141
const TK7l = 142
const TK7r = 143
const TK8l = 144
const TK8r = 145
const TK9l = 146
const TK9r = 147
const TKAl = 148
const TKAr = 149
const TKBl = 150
const TKBr = 151
const TKCl = 152
const TKCr = 153
const TKDl = 154
const TKDr = 155
const TKEl = 156
const TKEr = 157
const TKFl = 158
const TKFr = 159
const TKGl = 160
const TKGr = 161
const TKHl = 162
const TKHr = 163
const TKIl = 164
const TKIr = 165
const TKJl = 166
const TKJr = 167
const TKKl = 168
const TKKr = 169
const TKLl = 170
const TKLr = 171
const TKMl = 172
const TKMr = 173
const TKNl = 174
const TKNr = 175
const TKOl = 176
const TKOr = 177
const TKPl = 178
const TKPr = 179
const TKQl = 180
const TKQr = 181
const TKRl = 182
const TKRr = 183
const TKSl = 184
const TKSr = 185
const TKTl = 186
const TKTr = 187
const TKUl = 188
const TKUr = 189
const TKVl = 190
const TKVr = 191
const TKWl = 192
const TKWr = 193
const TKXl = 194
const TKXr = 195
const TKYl = 196
const TKYr = 197
const TKZl = 198
const TKZr = 199
const TCapbl = 200
const TCapbr = 201
const TPick00 = 202
const TPick01 = 203
const TPick10 = 204
const TPick11 = 205
const TDone00 = 206
const TDone01 = 207
const TDone10 = 208
const TDone11 = 209
const THline = 210
const TVline = 211
const TCross = 212
const TTdown = 213
const TTup = 214
const TBar0 = 215
const TBar1 = 216
const TBar2 = 217
const TBar3 = 218
const TBar4 = 219
const TBar5 = 220
const TBar6 = 221
const TBar7 = 222
const TBar8 = 223
const SCursor = 0
const SA1 = 4
const SA2 = 8
const SA3 = 12
const SA4 = 16
const SA5 = 20
const SA6 = 24
const SA7 = 28
const SA8 = 32
const SA9 = 36
const SA10 = 40
const SA11 = 44
const SA12 = 48
const SA13 = 52
const SA14 = 56
const SA15 = 60
const SA16 = 64
const SA17 = 68
const SA18 = 72
const NTiles8 = 768
const SprBytes = 608
const SndTuneA = 1
const SndTuneB = 2
const SndMiss = 3
const SndPick = 4
const SndMatch = 5
const SndWin = 6
const SndNext = 7
const SndMove = 8

const NKeys = 36
const NPairs = 18
const PerStart = 216
const PerStep = 6
const HoldMiss = 72
const HoldMatch = 42
const RepFirst = 14
const RepNext = 6
const BoxY = 27

' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' one pick: the key's code (0-35, "0".."9" then "A".."Z") and its animal
record PickRec:
  u8 Key
  u8 Animal
end record

' Board[k]: the animal under key code k (1-18), 0 once found
u8 Board[36]
PickRec Picks[2]
' Mode 1 KEYS ONLY, 2 KEYS AND SHAPES; Ph 0 first pick, 1 second pick,
' 2 showing the pair; Good 1 when the pair shown is a match
u8 Mode = 1
u8 Ph = 0
u8 Good = 0
u8 Hold = 0
u8 Target = 1
u8 TLeft = PerStart
u8 Per = PerStart
u8 Cycle = 0
u8 Left = NPairs
bcd digits 4 Tries = 0
' the cursor: key row Cr (0-3) and place Cc in the row; Rep the repeat
' countdown while the stick is held, LastDir the held direction
u8 Cr = 0
u8 Cc = 0
u8 Rep = 0
u8 LastDir = 0
u8 GameOn = 0
u16 Rs = $6C1D
u16 T16 = 0
u16 NumU = 0
u16 NOff = 0
u8 Menu = 0
u8 Tick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Lj = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' the keyboard: rows of 10, 10, 9 and 7 keys, each row one column to the
' right of the one above (as the C64 drew it); KeyOrd gives the key code
' of each place, left to right, top to bottom
data RowFirst bytes 0,10,20,29,36
data RowCol bytes 5,6,7,8
data RowY bytes 12,15,18,21
data KeyOrd bytes 1,2,3,4,5,6,7,8,9,0,26,32,14,27,29,34,30,18,24,25,10,28,13,15,16,17,19,20,21,35,33,12,31,11,23,22
' the animals' colours (TMS9918), 1-18
data AnCol bytes 0,14,13,7,10,15,3,14,10,11,8,15,11,5,9,14,14,2,8
' each animal's name in two lines of 9, centred
data AnName chars
  "  SNAIL  "
  "         "
  "BUTTERFLY"
  "         "
  "  FISH   "
  "         "
  "  DEER   "
  "         "
  "  ZEBRA  "
  "         "
  "  LIZARD "
  "         "
  "ELEPHANT "
  "         "
  "SQUIRREL "
  "         "
  "GOLDFINCH"
  "         "
  "  CRAB   "
  "         "
  "  POLAR  "
  "  BEAR   "
  " GIRAFFE "
  "         "
  "  BLUE   "
  "   JAY   "
  "STARFISH "
  "         "
  " SPIDER  "
  "         "
  "   BAT   "
  "         "
  "  FROG   "
  "         "
  " LADYBUG "
  "         "
end data
data BoxX bytes 36,108,180
data BoxCol bytes 2,11,20

  tile screen
  set sound table AmSoundTable areas 6
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title
  Mode = Menu + 1

new_game:
  Deal
  Ph = 0
  Target = 1
  Per = PerStart
  TLeft = PerStart
  Cycle = 0
  Left = NPairs
  Tries = 0
  Cr = 0
  Cc = 0
  Rep = 0
  LastDir = 0
  DrawBoard
  ShowHud
  ShowTarget
  ShowScreen
  GameOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1

play_loop:
  Frame1
  ReadPad
  RunTimer
  select case Ph
  case 2
    dec Hold
    if Hold = 0 then
      EndPair
      if Left = 0 then goto game_won
    end if
  case else
    MoveCursor
    if Press = 1 then PickKey
  end select
  DrawCursor
  goto play_loop

game_won:
  GameOn = 0
  Frame1
  HideSprites
  for Lj = 1 to 10
    fill 32 count 28 at 2,Lj
  next
  print at 6,1, "ALL 18 PAIRS FOUND!"
  print at 3,4, "CYCLES"
  NumU = Cycle
  print at 10,4, digits$(NumU, 3)
  print at 16,4, "TRIES"
  print Tries at 22,4
  if Mode = 1 then
    print at 6,6, "KEYS ONLY GAME"
  else
    print at 4,6, "KEYS AND SHAPES GAME"
  end if
  play sound SndWin
  Rearm
  wait 120 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' Deal: 18 animals twice under the 36 keys, shuffled (Fisher-Yates on
' the 16-bit xorshift)
sub Deal:
  for J = 0 to 35
    Board[J] = (J >> 1) + 1
  next
  for J = 35 downto 1
    K = RndBelow(J + 1)
    swap Board[J] with Board[K]
  next
  return
end sub

' RndBelow(N): a number 0 .. N-1
function RndBelow(u8 Lim) as u8
  Rnd16
  T16 = Rs & 255
  T16 = T16 * Lim
  return T16 >> 8

sub Rnd16:
  T16 = Rs << 7
  Rs = Rs ^ T16
  T16 = Rs >> 9
  Rs = Rs ^ T16
  T16 = Rs << 8
  Rs = Rs ^ T16
  return
end sub

' KeyAt: the key code under the cursor
function KeyAt as u8
  V = RowFirst[Cr] + Cc
  return KeyOrd[V]

' RowLen(R): keys in row R
function RowLen(u8 R) as u8
  return RowFirst[R + 1] - RowFirst[R]

' RunTimer: the FIND animal changes when its time is up; after the
' ladybug the snail comes round again and CYCLE goes up
sub RunTimer:
  dec TLeft
  if TLeft = 0 then
    TLeft = Per
    if Target = NPairs then
      Target = 1
      inc Cycle
      ShowHud
    else
      inc Target
    end if
    if Mode = 2 then play sound SndNext
    ShowTarget
  end if
  DrawBar
  return
end sub

' MoveCursor: the stick moves at once, then repeats while held
sub MoveCursor:
  if Stick = 0 then
    LastDir = 0
    return
  end if
  if Stick = LastDir then
    dec Rep
    if Rep > 0 then return
    Rep = RepNext
  else
    Rep = RepFirst
    LastDir = Stick
  end if
  N = RowLen(Cr)
  select case Stick
  case 1
    if Cr > 0 then
      dec Cr
      Clip
    end if
  case 2
    if Cr < 3 then
      inc Cr
      Clip
    end if
  case 3
    if Cc = 0 then
      Cc = N - 1
    else
      dec Cc
    end if
  case 4
    inc Cc
    if Cc >= N then Cc = 0
  end select
  play sound SndMove
  return
end sub

' Clip: keep the cursor inside a shorter row
sub Clip:
  V = RowLen(Cr) - 1
  if Cc > V then Cc = V
  return
end sub

' PickKey: show the key's animal; with two picks, judge the pair
sub PickKey:
  K = KeyAt
  V = Board[K]
  if V = 0 then
    play sound SndMiss
    return
  end if
  if Ph = 1 then
    if Picks[0].Key = K then
      play sound SndMiss
      return
    end if
  end if
  Picks[Ph].Key = K
  Picks[Ph].Animal = V
  ShowPick(Ph)
  if Ph = 0 then
    Ph = 1
    play sound SndPick
    return
  end if
  Tries += 1
  ShowHud
  Good = IsMatch()
  if Good = 1 then
    Hold = HoldMatch
    play sound SndMatch
  else
    Hold = HoldMiss
    play sound SndMiss
  end if
  Ph = 2
  return
end sub

' IsMatch: 1 when the two picks hide the same animal (and, in KEYS AND
' SHAPES, it is the FIND animal)
function IsMatch as u8
  if Picks[0].Animal <> Picks[1].Animal then return 0
  if Mode = 1 then return 1
  if Picks[0].Animal = Target then return 1
  return 0

' EndPair: take a found pair off, or put the keys back
sub EndPair:
  for Lj = 0 to 1
    K = Picks[Lj].Key
    if Good = 1 then
      Board[K] = 0
    end if
    DrawKey(K)
    hide sprite Lj + 1
    print at BoxCol[Lj],8, "         "
    print at BoxCol[Lj],9, "         "
  next
  if Good = 1 then
    dec Left
    if Per > 120 then Per = Per - PerStep
    ShowHud
  end if
  update sprites
  Ph = 0
  return
end sub

' ShowPick(P): pick P's animal in its box, its key turned yellow
sub ShowPick(u8 P):
  X = BoxX[P]
  V = Picks[P].Animal
  K = Picks[P].Key
  set sprite P + 1 to BoxY, X, V * 4, AnCol[V]
  update sprites
  PrintName(V, BoxCol[P])
  KeyPlace(K)
  put char TPick00 at X,Y
  put char TPick01 at X + 1,Y
  put char TPick10 at X,Y + 1
  put char TPick11 at X + 1,Y + 1
  return
end sub

' PrintName(A, C): animal A's name in two lines from column C
sub PrintName(u8 A, u8 C):
  NOff = A - 1
  NOff = NOff * 18
  put AnName + NOff count 9 at C,8
  NOff = NOff + 9
  put AnName + NOff count 9 at C,9
  return
end sub

' KeyPlace(K): the screen column X and row Y of key code K
sub KeyPlace(u8 Kc):
  for N = 0 to 35
    if KeyOrd[N] = Kc then exit for
  next
  Y = 0
  while N >= RowFirst[Y + 1]
    inc Y
  end while
  X = RowCol[Y] + (N - RowFirst[Y]) * 2
  Y = RowY[Y]
  return
end sub

' DrawKey(K): a key as it is now: its legend, or dark once found
sub DrawKey(u8 Kc):
  KeyPlace(Kc)
  if Board[Kc] = 0 then
    put char TDone00 at X,Y
    put char TDone01 at X + 1,Y
    put char TDone10 at X,Y + 1
    put char TDone11 at X + 1,Y + 1
  else
    V = Kc * 2 + TK0l
    put char V at X,Y
    put char V + 1 at X + 1,Y
    put char TCapbl at X,Y + 1
    put char TCapbr at X + 1,Y + 1
  end if
  return
end sub

' DrawCursor: the frame round the key under the cursor
sub DrawCursor:
  X = RowCol[Cr] + Cc * 2
  X = X * 8 - 2
  Y = RowY[Cr] * 8 - 3
  set sprite 0 to Y, X, SCursor, 11
  update sprites
  return
end sub

' ShowTarget: the FIND animal and its name
sub ShowTarget:
  set sprite 3 to BoxY, BoxX[2], Target * 4, AnCol[Target]
  update sprites
  PrintName(Target, 20)
  return
end sub

' DrawBar: the FIND time left, 64 pixels long
sub DrawBar:
  T16 = TLeft
  T16 = T16 * 64
  T16 = T16 / Per
  N = T16
  for J = 0 to 7
    if N >= 8 then
      V = 8
      N = N - 8
    else
      V = N
      N = 0
    end if
    put char TBar0 + V at 21 + J,10
  next
  return
end sub

sub ShowHud:
  print at 2,1, "CYCLE"
  NumU = Cycle
  print at 8,1, digits$(NumU, 2)
  print at 11,1, "TRIES"
  print Tries at 17,1
  print at 22,1, "LEFT"
  NumU = Left
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub DrawBoard:
  NewScreen
  print at 3,3, "1ST PICK"
  print at 12,3, "2ND PICK"
  if Mode = 2 then print at 23,3, "FIND"
  fill THline count 28 at 2,11
  for Lj = 0 to 35
    DrawKey(Lj)
  next
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' ReadPad: either joystick; Stick 1 up, 2 down, 3 left, 4 right
sub ReadPad:
  Btn = 0
  Stick = 0
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn = 1
  if joypad(2).button2 then Btn = 1
  if joypad(1).up or joypad(2).up then Stick = 1
  if joypad(1).down or joypad(2).down then Stick = 2
  if joypad(1).left or joypad(2).left then Stick = 3
  if joypad(1).right or joypad(2).right then Stick = 4
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  sprites flicker off
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: three animals, a joystick menu
sub TitlePage:
  NewScreen
  print at 9,2, "ANIMAL  MATCH"
  fill THline count 28 at 2,3
  print at 3,10, "FIND THE PAIRS OF ANIMALS"
  print at 3,11, "HIDDEN UNDER THE KEYS."
  print at 8,13, "KEYS ONLY"
  print at 8,15, "KEYS AND SHAPES"
  print at 8,17, "HOW TO PLAY"
  print at 8,19, "CREDITS"
  print at 3,21, "STICK MOVES, BUTTON PICKS"
  Menu = 0
  ShowMenu
  set sprite 1 to 39, 40, SA1, 14
  set sprite 2 to 39, 112, SA16, 14
  set sprite 3 to 39, 184, SA12, 11
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  Rnd16
  ReadPad
  if Stick = 1 then
    if WasStick = 0 then
      if Menu > 0 then dec Menu
      ShowMenu
    end if
  end if
  if Stick = 2 then
    if WasStick = 0 then
      if Menu < 3 then inc Menu
      ShowMenu
    end if
  end if
  WasStick = Stick
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 0 to 3
    V = J * 2 + 13
    put char 32 at 6,V
  next
  V = Menu * 2 + 13
  put char 62 at 6,V
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  fill THline count 28 at 2,2
  if Pg = 0 then
    print at 2,3, "36 KEYS HIDE 18 PAIRS OF"
    print at 2,4, "ANIMALS. MOVE THE YELLOW"
    print at 2,5, "FRAME WITH THE STICK, PRESS"
    print at 2,6, "THE LEFT BUTTON TO PICK A"
    print at 2,7, "KEY: ITS ANIMAL SHOWS. THEN"
    print at 2,8, "PICK A SECOND KEY."
    print at 2,10, "SAME ANIMAL? THE PAIR IS"
    print at 2,11, "TAKEN OFF. NOT THE SAME? THE"
    print at 2,12, "KEYS GO BACK. REMEMBER WHERE"
    print at 2,13, "EACH ANIMAL WAS!"
    ' two picked keys, the same animal: a pair
    put char TPick00 at 9,19
    put char TPick01 at 10,19
    put char TPick10 at 9,20
    put char TPick11 at 10,20
    put char TPick00 at 19,19
    put char TPick01 at 20,19
    put char TPick10 at 19,20
    put char TPick11 at 20,20
    set sprite 1 to 119, 72, SA1, 14
    set sprite 2 to 119, 152, SA1, 14
    print at 14,17, "PAIR!"
  else
    print at 2,3, "TWO GAMES:"
    print at 2,4, "KEYS ONLY: ANY PAIR COUNTS."
    print at 2,6, "KEYS AND SHAPES: THE PAIR"
    print at 2,7, "MUST BE THE ANIMAL IN THE"
    print at 2,8, "FIND BOX. IT CHANGES BY"
    print at 2,9, "ITSELF, FASTER AND FASTER."
    print at 2,11, "THE GAME ENDS WHEN ALL 18"
    print at 2,12, "PAIRS ARE FOUND. FEWER"
    print at 2,13, "CYCLES AND TRIES IS BETTER."
    print at 2,15, "TIP: PICK A KEY YOU HAVE"
    print at 2,16, "NOT SEEN YET FIRST, THEN"
    print at 2,17, "LOOK FOR ITS PARTNER."
    set sprite 1 to 142, 56, SA16, 14
    set sprite 2 to 142, 120, SA12, 11
    set sprite 3 to 142, 184, SA1, 14
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_loop:
  Frame1
  Rnd16
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,2, "ANIMAL  MATCH"
  print at 3,4, "FROM ANIMAL MATCH IN"
  print at 3,5, "COMPUTE!'S GAZETTE,"
  print at 3,6, "DECEMBER 1987 (COMMODORE"
  print at 3,7, "64, MACHINE LANGUAGE)."
  print at 3,9, "ANIMAL SHAPES, NAMES, RULES"
  print at 3,10, "AND FANFARE FROM THE C64."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY"
  print at 3,16, "BIENVENU."
  print at 3,18, "NEW TITLE MUSIC: TWO BY TWO"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

