cartridge "TURBO SKI/B. BLACKMER/1988"

' TURBO SKI
' A ColecoVision game based on "Turbo Ski" by Bob Blackmer, Ahoy! September
' 1988 (Commodore 64, machine code, entered with Flankspeed). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' machine code, orig/ts.dis, and the article), the game is built for the
' ColecoVision: a dusk sky over a lit city, a ground of stripes rushing
' toward you, gates and a jet as smooth sprites at 60 frames a second, a
' gate board in the status band, sound effects and a title tune.
'
' The game ("a future Olympic event in the manner of the biathlon"): fly
' your jet low through the gates and shoot down a UFO crossing over the
' distant city. Sixteen gates make a level; the last one is gold. Pass all
' sixteen AND shoot at least one UFO, and you earn a spare jet and the next
' level, faster; miss a gate or every UFO and a spare jet is lost and the
' level is flown again. Lose with no spare jet left and the game is over.
'
' From the original (orig/, its machine code): the jet moves 4 pixels a
' step left or right; one rocket at a time, as long as the button is held,
' flying straight up from where it left 2 lines a step, smaller as it
' goes; the UFO crosses left to right at the level's speed (1 pixel a step,
' one more each level), wraps round, and starts again at the left after it
' is hit (5 steps of explosion); a gate appears at the horizon at a random
' place, comes down one line a step, one more every 8 steps, its posts
' spreading as fast and growing in 7 sizes; it is checked when its posts
' reach the jet (the jet must not touch a post), and the next comes 17
' steps after it is gone, one step sooner each level; the 16th gate is
' yellow and stops the game after it ("PUSH UP"; holding up goes straight
' on); a level needs 16 gates and a UFO; then a spare jet (9 at most) and,
' up to level 12, a faster step (the delay loop one count shorter), 10
' more points a gate or UFO (100 at most), the UFO one pixel faster and
' the gates one step closer; a failed level costs a spare jet; none left
' ends the game; the game starts with no spare jet (SHIPS 00).
'
' Liberties: one step of the original is 0.8 pixel here (the field is 256
' pixels wide instead of 320) and the steps are spread over 60 frames a
' second by sub-pixel counters (the jet and the UFO move every frame, the
' gate and the rocket are drawn between their steps); the rates come from
' the delay loop's cycles (18 steps a second at level 1, 53 from level 12).
' The gate check is the clear intent of the C64's: between the posts
' without touching one (its own test let a jet far to the left of both
' posts through, and one far to the right). The rocket hits when it
' reaches the UFO's line within 8 pixels of its middle, anywhere on its
' body (the C64 compared one line of sprite pixels, about 10 wide); a
' rocket that hits is spent at once. The
' gate board shows each gate passed or missed and a lamp for the UFO; a
' message says why a level was lost. Score kept in tens (six digits; the
' C64 had five and turned the border colour past 99,990). Best score.
'
' Controls: either controller. The stick steers left and right, a button
' fires (hold it for a rocket each time the last one is gone); after the
' gold gate push up to go on. On the title, up and down choose, a button
' starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers (the test bot replays them). Nothing flashes.
'
' Workarounds for Amy bugs bombs-return-u16 removed 2026-11-01.

const TSk0 = 128
const TSk1 = 129
const TSk2 = 130
const TSk3 = 131
const TSk4 = 132
const TSk5 = 133
const TSk6 = 134
const TSk7 = 135
const TSk8 = 136
const TSk9 = 137
const TSk10 = 138
const TSk11 = 139
const TSk12 = 140
const TSk13 = 141
const TSk14 = 142
const TSk15 = 143
const TSk16 = 144
const TSk17 = 145
const TSk18 = 146
const TSk19 = 147
const TSk20 = 148
const TSk21 = 149
const TSk22 = 150
const TSk23 = 151
const TSk24 = 152
const TSk25 = 153
const TSk26 = 154
const TSk27 = 155
const TSk28 = 156
const TSk29 = 157
const TSk30 = 158
const TSk31 = 159
const TSk32 = 160
const TSk33 = 161
const TSk34 = 162
const TSk35 = 163
const TSk36 = 164
const TSk37 = 165
const TSk38 = 166
const TSk39 = 167
const TSk40 = 168
const TSk41 = 169
const TSk42 = 170
const TSk43 = 171
const TSk44 = 172
const TSk45 = 173
const TSk46 = 174
const TSk47 = 175
const TSk48 = 176
const TG0 = 177
const TG1 = 178
const TG2 = 179
const TG3 = 180
const TG4 = 181
const TG5 = 182
const TG6 = 183
const TG7 = 184
const TG8 = 185
const TG9 = 186
const TG10 = 187
const TG11 = 188
const TG12 = 189
const TG13 = 190
const TG14 = 191
const TPip = 192
const TPipok = 193
const TPipgold = 194
const TPipgoldok = 195
const TPipmiss = 196
const TUfoi0 = 197
const TUfoi1 = 198
const TUfoh0 = 199
const TUfoh1 = 200
const TJeti = 201
const TLt00 = 202
const TLt01 = 203
const TLt10 = 204
const TLt11 = 205
const TLu00 = 206
const TLu01 = 207
const TLu10 = 208
const TLu11 = 209
const TLr00 = 210
const TLr01 = 211
const TLr10 = 212
const TLr11 = 213
const TLb00 = 214
const TLb01 = 215
const TLb10 = 216
const TLb11 = 217
const TLo00 = 218
const TLo01 = 219
const TLo10 = 220
const TLo11 = 221
const TLs00 = 222
const TLs01 = 223
const TLs10 = 224
const TLs11 = 225
const TLk00 = 226
const TLk01 = 227
const TLk10 = 228
const TLk11 = 229
const TLi00 = 230
const TLi01 = 231
const TLi10 = 232
const TLi11 = 233
const SJeta = 0
const SJetb = 4
const SJetla = 8
const SJetlb = 12
const SJetra = 16
const SJetrb = 20
const SShada = 24
const SShadb = 28
const SPost0 = 32
const SPost1 = 36
const SPost2 = 40
const SPost3 = 44
const SPost4 = 48
const SPost5 = 52
const SPost6 = 56
const SRk0 = 60
const SRk1 = 64
const SRk2 = 68
const SRk3 = 72
const SRk4 = 76
const SUfo = 80
const SLampa = 84
const SLampb = 88
const SBoomi0 = 92
const SBoomo0 = 96
const SBoomi1 = 100
const SBoomo1 = 104
const SBoomi2 = 108
const SBoomo2 = 112
const NTiles8 = 848
const SprBytes = 928
const GCOff = 1416
const NSky = 49
const KC = 30
const KEnd = 37
const RkEnd = 42
const NGround = 15
const SndTuneA = 1
const SndTuneB = 2
const SndBoom = 3
const SndLaunch = 4
const SndGate = 5
const SndMiss = 6
const SndClear = 7
const SndLost = 8
const SndOver = 9
const SndStart = 10
const SndBlip = 11
const JX16Min = 512
const JX16Max = 3584
const JetY = 139
const ShY = 155
const UfoY = 39
const TW = 19
const HitW = 8
const RkHit = 41
const UStart = 1408
const UWrap = 19072

' the gate on its way: progress in 1/256 steps, whole steps, middle, gold
record Gate:
  u16 T
  u8 K
  u8 Cx
  u8 Live
  u8 Gold
end record
' the rocket: progress in 1/256 steps, its column, flying, hit tested
record Rocket:
  u16 T
  u8 X
  u8 Live
  u8 Tried
end record
' the UFO: middle + 32 in 1/64 pixel, the explosion's progress, exploding
record Saucer:
  u16 X64
  u16 ET
  u8 Blast
end record

Gate Gt
Rocket Rk
Saucer Uf
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 ScoreT = 0
u16 BestT = 0
u16 Spd = 0
u16 GapT = 0
u16 PhT = 0
u16 JX16 = 2048
u16 UV = 0
u8 JV = 0
u8 JX = 128
u8 Tilt = 0
' the game
u8 Level = 1
u8 Ships = 0
u8 Passed = 0
u8 Missed = 0
u8 Hits = 0
u8 GateN = 0
u8 Gap = 17
u8 Us = 1
u8 Pts = 1
u8 Phase = 0
u8 LastPh = 255
u8 EndLv = 0
u8 Over = 0
u8 Menu = 0
' where the program is, for the tests: 0 title, 1 playing, 2 a level's
' end (PUSH UP), 3 the game over, 4 credits
u8 Mode = 4
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u8 LampT = 0
' loop counters (never shared with the helpers)
u8 Gi = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 S = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TkSoundTable areas 6
  sprites 16x16
  set sprite count 10
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  DrawGround
  DrawSprites
  ReadPad
  PlayFrame
  if EndLv = 1 then
    LevelOver
    if Over = 1 then goto game_over
  end if
  goto play_loop

game_over:
  ' no spare jet left: the message, the score, back to the title on a press
  Mode = 3
  mute all
  play sound SndOver
  if ScoreT > BestT then BestT = ScoreT
  print at 7,4, "                  "
  print at 7,5, "    GAME  OVER    "
  print at 7,6, "                  "
  print at 7,7, "  SCORE           "
  ShowNum6(ScoreT, 15, 7)
  print at 7,8, "  BEST            "
  ShowNum6(BestT, 15, 8)
  print at 7,9, "                  "
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the jet, the rocket, the UFO, the gate, the ground

sub PlayFrame:
  Steer
  MoveRocket
  MoveUfo
  MoveGate
  PhT = PhT + Spd
  W16 = PhT >> 8
  Phase = W16 & 7
  inc LampT
  return
end sub

' the stick moves the jet (right first, as the C64 checked); the button
' fires a rocket when none is flying
sub Steer:
  V = J1 & 8
  if V > 0 then
    Tilt = 2
    JX16 = JX16 + JV
    if JX16 > JX16Max then JX16 = JX16Max
  else
    V = J1 & 4
    if V > 0 then
      Tilt = 1
      W16 = JX16Min + JV
      if JX16 < W16 then
        JX16 = JX16Min
      else
        JX16 = JX16 - JV
      end if
    else
      Tilt = 0
    end if
  end if
  JX = JX16 >> 4
  V = J1 & 16
  if V = 0 then return
  if Rk.Live = 1 then return
  Rk.Live = 1
  Rk.T = 0
  Rk.X = JX
  Rk.Tried = 0
  play sound SndLaunch
  return
end sub

' the rocket climbs; at the UFO's line it hits or misses, then it is gone
sub MoveRocket:
  if Rk.Live = 0 then return
  Rk.T = Rk.T + Spd
  R = Rk.T >> 8
  if R >= RkHit then
    if Rk.Tried = 0 then
      Rk.Tried = 1
      if Uf.Blast = 0 then
        V = UfoNear(Rk.X)
        if V = 1 then
          HitUfo
          return
        end if
      end if
    end if
  end if
  if R >= RkEnd then Rk.Live = 0
  return
end sub

' 1 when the UFO's middle is within HitW pixels of column Rx
function UfoNear(u8 Rx) as u8
  u16 Mid = 0
  u16 D = 0
  Mid = Uf.X64 >> 6
  D = Rx + 32
  if D > Mid then
    D = D - Mid
  else
    D = Mid - D
  end if
  if D <= HitW then return 1
  return 0

sub HitUfo:
  Uf.Blast = 1
  Uf.ET = 0
  inc Hits
  ScoreT = ScoreT + Pts
  Rk.Live = 0
  play sound SndBoom
  ShowScore
  ShowLamp
  return
end sub

' the UFO crosses and wraps round; after an explosion it starts again at
' the left
sub MoveUfo:
  if Uf.Blast = 1 then
    Uf.ET = Uf.ET + Spd
    V = Uf.ET >> 8
    if V >= 5 then
      Uf.Blast = 0
      Uf.X64 = UStart
    end if
    return
  end if
  Uf.X64 = Uf.X64 + UV
  if Uf.X64 >= UWrap then Uf.X64 = UStart
  return
end sub

' the gate comes down a step at a time; checked when it reaches the jet;
' the gold one ends the level a step later
sub MoveGate:
  if Gt.Live = 0 then
    GapT = GapT + Spd
    V = GapT >> 8
    if V < Gap then return
    SpawnGate
    return
  end if
  Gt.T = Gt.T + Spd
  V = Gt.T >> 8
  if V = Gt.K then return
  Gt.K = V
  if V = KC then
    CheckGate
    return
  end if
  if V = KC + 1 then
    if Gt.Gold = 1 then EndLv = 1
    return
  end if
  if V >= KEnd then
    Gt.Live = 0
    GapT = 0
  end if
  return
end sub

sub SpawnGate:
  Rand
  V = Rs & 255
  V = V % 118
  Gt.Cx = V + 77
  Gt.T = 0
  Gt.K = 0
  Gt.Live = 1
  inc GateN
  Gt.Gold = 0
  if GateN = 16 then Gt.Gold = 1
  return
end sub

' between the posts without touching one
sub CheckGate:
  u16 Lft = 0
  u16 Rgt = 0
  u16 P = 0
  Lft = Gt.Cx - GateS[KC]
  Lft = Lft + TW
  Rgt = Gt.Cx + GateS[KC]
  Rgt = Rgt - TW
  P = JX
  K = GateN + 1
  if P > Lft and P < Rgt then
    inc Passed
    ScoreT = ScoreT + Pts
    put char PipTile(GateN, 1) at K,2
    play sound SndGate
    ShowScore
  else
    inc Missed
    put char TPipmiss at K,2
    play sound SndMiss
  end if
  return
end sub

' the gate board's tile for gate number G (1-16): 0 waiting, 1 passed
function PipTile(u8 G, u8 Ok) as u8
  if G = 16 then return TPipgold + Ok
  if Ok = 1 then return TPipok
  return TPip

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' a level's end: the result, PUSH UP, the next level (or the game over)

sub LevelOver:
  Mode = 2
  EndLv = 0
  Rk.Live = 0
  Gt.Live = 0
  DrawSprites
  print at 6,4, "                    "
  print at 6,5, "                    "
  print at 6,6, "                    "
  print at 6,7, "                    "
  print at 6,8, "                    "
  if Passed = 16 and Hits > 0 then
    print at 8,5, "LEVEL    CLEAR!"
    NumU = Level
    print at 14,5, digits$(NumU, 2)
    play sound SndClear
    if Ships < 9 then
      inc Ships
      print at 10,7, "+1 SPARE JET"
    else
      print at 10,7, "FULL HANGAR"
    end if
    inc Level
  else
    if Passed < 16 then
      V = 16 - Passed
      print at 8,5, "MISSED    GATE"
      NumU = V
      print at 15,5, digits$(NumU, 2)
      if V > 1 then put char 83 at 22,5
    else
      print at 9,5, "NO UFO SHOT DOWN"
    end if
    if Ships = 0 then
      play sound SndLost
      print at 10,7, "NO SPARE JET"
      Rearm
      wait 100 frames
      nmi off
      Over = 1
      return
    end if
    dec Ships
    play sound SndLost
    print at 11,7, "JET LOST"
  end if
  ShowShips
  Rearm
  wait 50 frames
  nmi off
  print at 6,9, "                    "
  print at 6,10, "   PUSH UP TO FLY   "
  print at 6,11, "                    "
  ' as on the C64: holding up already goes straight on
  do
    Frame1
    DrawSprites
    ReadPad
    V = J1 & 1
  loop until V > 0
  copy SkyMap count 192 to vram.name + 96
  for Ri = 0 to 2
    R = Ri + 9
    fill TG0 + Ri count 32 at 0,R
  next
  SetupLevel
  LevelBanner
  Mode = 1
  return
end sub

' the level's numbers (speed, gaps, points, UFO) and an empty gate board
sub SetupLevel:
  T = min(Level, 12)
  Spd = SpdT[T]
  Gap = 18 - T
  Us = T
  Pts = min(Level, 10)
  JV = Spd / 5
  W16 = Us * Spd
  UV = W16 / 5
  Passed = 0
  Missed = 0
  Hits = 0
  GateN = 0
  Gt.Live = 0
  Gt.K = 0
  GapT = 0
  Rk.Live = 0
  EndLv = 0
  DrawBoard
  ShowHud
  return
end sub

' "LEVEL nn" over the sky for a second and a half, the scene still
sub LevelBanner:
  print at 9,5, "            "
  print at 9,6, "  LEVEL     "
  NumU = Level
  print at 17,6, digits$(NumU, 2)
  print at 9,7, "            "
  play sound SndStart
  for Ri = 1 to 90
    Frame1
    DrawGround
    DrawSprites
  next
  copy SkyMap count 192 to vram.name + 96
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the stripes: the colours of the 15 ground codes for this phase
sub DrawGround:
  if Phase = LastPh then return
  LastPh = Phase
  W16 = Phase * 120
  copy GroundCol + W16 count 120 to vram.color + GCOff
  return
end sub

' a value from table A at step K, B at step K + 1, F/256 of the way
function Lerp(u8 A, u8 B, u8 F) as u8
  u16 D = 0
  if B < A then
    D = A - B
    D = D * F
    D = D >> 8
    return A - D
  end if
  D = B - A
  D = D * F
  D = D >> 8
  return A + D

' sprites 0-1 the jet, 2-3 its shadow, 4-5 the gate's posts, 6 the
' rocket, 7-8 the UFO (lamps over body) or its explosion
sub DrawSprites:
  i16 Px = 0
  u8 Gy = 0
  u8 Gs = 0
  u8 F = 0
  X = JX - 16
  K = Tilt * 8
  set sprite 0 to JetY,X,K,15
  K = K + 4
  T = X + 16
  set sprite 1 to JetY,T,K,15
  set sprite 2 to ShY,X,SShada,1
  set sprite 3 to ShY,T,SShadb,1
  if Gt.Live = 1 then
    K = Gt.K
    F = Gt.T & 255
    Gy = Lerp(GateY[K], GateY[K + 1], F)
    Gs = Lerp(GateS[K], GateS[K + 1], F)
    T = GateF[K]
    T = T << 2
    T = T + SPost0
    C = 9
    if Gt.Gold = 1 then C = 11
    Y = Gy - 17
    Px = Gt.Cx - Gs
    Px = Px - 8
    if Px >= 0 then
      X = Px
      set sprite 4 to Y,X,T,C
    else
      set sprite 4 to 192,0,0,0
    end if
    Px = Gt.Cx + Gs
    Px = Px - 8
    if Px <= 255 then
      X = Px
      set sprite 5 to Y,X,T,C
    else
      set sprite 5 to 192,0,0,0
    end if
  else
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
  end if
  if Rk.Live = 1 then
    R = Rk.T >> 8
    F = Rk.T & 255
    Y = Lerp(RkY[R], RkY[R + 1], F)
    Y = Y - 1
    T = RkF[R]
    T = T << 2
    T = T + SRk0
    X = Rk.X - 8
    set sprite 6 to Y,X,T,15
  else
    set sprite 6 to 192,0,0,0
  end if
  DrawUfo
  update sprites
  return
end sub

' the UFO (or its explosion): left of the screen through the early clock
sub DrawUfo:
  u16 L = 0
  u8 E = 0
  u8 Fr = 0
  L = Uf.X64 >> 6
  L = L - 8
  if L > 287 then
    set sprite 7 to 192,0,0,0
    set sprite 8 to 192,0,0,0
    return
  end if
  if L < 32 then
    E = 128
  else
    L = L - 32
  end if
  X = L
  if Uf.Blast = 1 then
    W16 = Uf.ET >> 8
    Fr = W16
    Fr = Fr >> 1
    if Fr > 2 then Fr = 2
    Fr = Fr << 3
    T = SBoomi0 + Fr
    K = SBoomo0 + Fr
    C = 11 + E
    set sprite 7 to UfoY,X,T,C
    C = 8 + E
    set sprite 8 to UfoY,X,K,C
    return
  end if
  T = SLampa
  V = LampT & 16
  if V > 0 then T = SLampb
  C = 11 + E
  set sprite 7 to UfoY,X,T,C
  C = 14 + E
  set sprite 8 to UfoY,X,SUfo,C
  return
end sub

' a score in tens at column Col, row Row: five digits and a nought
sub ShowNum6(u16 Tens, u8 Col, u8 Row):
  print at Col,Row, digits$(Tens, 5)
  Col = Col + 5
  put char 48 at Col,Row
  return
end sub

sub ShowScore:
  ShowNum6(ScoreT, 8, 1)
  return
end sub

' the UFO lamp in the status band: lit once one is shot down this level
sub ShowLamp:
  if Hits > 0 then
    put char TUfoh0 at 20,2
    put char TUfoh1 at 21,2
    return
  end if
  put char TUfoi0 at 20,2
  put char TUfoi1 at 21,2
  return
end sub

sub ShowShips:
  put char TJeti at 25,2
  NumU = Ships
  print at 27,2, digits$(NumU, 1)
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 21,1, "LEVEL"
  NumU = Level
  print at 27,1, digits$(NumU, 2)
  ShowLamp
  ShowShips
  return
end sub

' the gate board: gates already flown this level, then waiting ones
sub DrawBoard:
  u8 G = 0
  u8 Col = 0
  for G = 1 to 16
    Col = G + 1
    put char PipTile(G, 0) at Col,2
  next
  return
end sub

' the sky and city (rows 3-8) and the ground's rows (9-23)
sub DrawScene:
  u8 Last = 0
  copy SkyMap count 192 to vram.name + 96
  Last = NGround - 1
  for Gi = 0 to Last
    R = Gi + 9
    fill TG0 + Gi count 32 at 0,R
  next
  LastPh = 255
  return
end sub

sub NewGame:
  NewScreen
  DrawScene
  ScoreT = 0
  Level = 1
  Ships = 0
  Over = 0
  JX16 = 2048
  JX = 128
  Tilt = 0
  Uf.X64 = UStart
  Uf.Blast = 0
  Phase = 0
  PhT = 0
  SetupLevel
  DrawGround
  DrawSprites
  ShowScreen
  LevelBanner
  Rearm
  wait no fire
  nmi off
  Mode = 1
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  ' left and right at once (two controllers): neither
  V = J1 & 12
  if V = 12 then J1 = J1 & 243
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 10
  for J = 0 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the scene, the big letters, the jet weaving over the stripes,
' a UFO crossing, the tune once; START / CREDITS
sub TitlePage:
  u8 Col = 0
  Mode = 0
  NewScreen
  DrawScene
  print at 7,4, "                  "
  print at 7,7, "                  "
  for Gi = 0 to 8
    T = TitleLetter(Gi)
    if T > 0 then
      Col = Gi << 1
      Col = Col + 7
      put char T at Col,5
      T = T + 1
      put char T at Col + 1,5
      T = T + 1
      put char T at Col,6
      T = T + 1
      put char T at Col + 1,6
    else
      Col = Gi << 1
      Col = Col + 7
      fill 32 count 2 at Col,5
      fill 32 count 2 at Col,6
    end if
  next
  print at 11,11, "          "
  print at 11,12, "   START  "
  print at 11,13, "  CREDITS "
  print at 11,14, "          "
  print at 2,22, "AHOY! SEPT. 1988"
  print at 19,22, "BEST"
  ShowNum6(BestT, 24, 22)
  ShowMenu
  Level = 1
  T = 1
  Spd = SpdT[T]
  JV = Spd / 5
  UV = Spd / 5
  Gt.Live = 0
  Rk.Live = 0
  Uf.Blast = 0
  Uf.X64 = UStart
  JX16 = 2048
  Tilt = 0
  DrawGround
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 784
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  DrawGround
  DrawSprites
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      play sound SndBlip
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

' the tile of the title's letter at position I of "TURBO SKI" (0: a space)
function TitleLetter(u8 I) as u8
  select case I
  case 0
    return TLt00
  case 1
    return TLu00
  case 2
    return TLr00
  case 3
    return TLb00
  case 4
    return TLo00
  case 6
    return TLs00
  case 7
    return TLk00
  case 8
    return TLi00
  end select
  return 0

' the jet weaves to and fro, the UFO crosses, the stripes run
sub TitleAnim:
  V = Tick & 127
  J1 = 0
  if V < 40 then J1 = 8
  if V >= 64 then
    if V < 104 then J1 = 4
  end if
  Steer
  Rk.Live = 0
  MoveUfo
  PhT = PhT + Spd
  W16 = PhT >> 8
  Phase = W16 & 7
  inc LampT
  return
end sub

sub ShowMenu:
  put char 32 at 12,12
  put char 32 at 12,13
  J = Menu + 12
  put char 62 at 12,J
  return
end sub

sub CreditsPage:
  Mode = 4
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "TURBO  SKI"
  print at 2,5, "BASED ON TURBO SKI BY BOB"
  print at 2,6, "BLACKMER, AHOY! SEPTEMBER"
  print at 2,7, "1988 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: GATE RUN"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

