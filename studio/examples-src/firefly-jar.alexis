asm {
FjHush:
    db $00,$00,$F4,$01,$10
FjCatch:
    db $40,$47,$30,$02,$40,$35,$30,$02,$40,$2A,$40,$03,$40,$2A,$A0,$06,$50
FjMiss:
    db $40,$D6,$90,$02,$40,$E2,$C0,$03,$50
FjFree:
    db $40,$6B,$40,$04,$40,$55,$40,$04,$40,$47,$40,$04,$40,$35,$40,$04,$40,$35,$90,$0C,$50
FjHush2:
    db $00,$00,$F4,$01,$10

FjSoundTable:
    dw FjHush,$702B
    dw FjCatch,$7035
    dw FjMiss,$7035
    dw FjFree,$7035
    dw FjHush2,$702B
    dw FjTuneMel,$703F
    dw FjTuneBass,$7049
; Meadow Lullaby (original for this game)
; Tiny Sound, 7 frames per step
FjTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$F1,$22,$21,$00,$26,$00,$2A,$00,$28,$00,$00,$00,$26,$00
    db $23,$00,$00,$00,$21,$00,$00,$00,$00,$00,$00,$00,$1F,$00,$23,$00
    db $26,$00,$25,$00,$00,$00,$21,$00,$28,$00,$00,$00,$26,$00,$00,$00
    db $00,$00,$00,$00,$1E,$00,$21,$00,$26,$00,$2A,$00,$00,$00,$2D,$00
    db $2B,$00,$2A,$00,$28,$00,$00,$00,$00,$00,$00,$00,$26,$00,$25,$00
    db $23,$00,$21,$00,$00,$00,$25,$00,$26,$00,$00,$00,$00,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
FjTuneBass:
    db $84
