    db 7
    db $02,$70,$F1,$22,$0E,$00,$15,$00,$1A,$00,$0E,$00,$15,$00,$1A,$00
    db $0B,$00,$12,$00,$17,$00,$09,$00,$10,$00,$15,$00,$07,$00,$0E,$00
    db $13,$00,$07,$00,$0E,$00,$13,$00,$09,$00,$10,$00,$15,$00,$0E,$00
    db $15,$00,$1A,$00,$0E,$00,$15,$00,$1A,$00,$0E,$00,$15,$00,$1A,$00
