  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$15,$0A,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$40,$A0,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$15,$0A,$15,$0A,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$40,$A0,$40,$A0,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$1F,$1F,$1F,$1F,$1F,$1F,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$E0,$E0,$E0,$E0,$E0,$E0,$00,$00,$00
