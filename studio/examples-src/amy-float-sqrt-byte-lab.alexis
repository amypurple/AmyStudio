' FP5 sqrt byte lab: isolate sqrt(65535) bytes and the first self-square.
fp5 A = 65535
fp5 B
fp5 C
u8 ABytes[5] = 0
u8 BBytes[5] = 0
u8 CBytes[5] = 0
u8 LineBuf[16]

  B = sqrt(A)
  C = B
  C *= C
  copy bytes of A to ABytes
  copy bytes of B to BBytes
  copy bytes of C to CBytes

  text screen
  print at 5,0, "FP5 SQRT BYTE LAB"
  print at 1,1, "RAW BYTES      B4  B3  B2  B1  B0"
  print at 1,3, "A 65535"
  print ABytes[4] at 11,3 digits 3
  print ABytes[3] at 15,3 digits 3
  print ABytes[2] at 19,3 digits 3
  print ABytes[1] at 23,3 digits 3
  print ABytes[0] at 27,3 digits 3
  print at 1,5, "B SQRT"
  print BBytes[4] at 11,5 digits 3
  print BBytes[3] at 15,5 digits 3
  print BBytes[2] at 19,5 digits 3
  print BBytes[1] at 23,5 digits 3
  print BBytes[0] at 27,5 digits 3
  print at 1,7, "C B*B"
  print CBytes[4] at 11,7 digits 3
  print CBytes[3] at 15,7 digits 3
  print CBytes[2] at 19,7 digits 3
  print CBytes[1] at 23,7 digits 3
  print CBytes[0] at 27,7 digits 3
  print at 1,10, "DECIMAL"
  print_at(A,12)
  print_at(B,14)
  print_at(C,16)
  print at 1,20, "EXPECT B ~ 255.998, C ~ 65535"
  screen on no nmi

sub print_at(fp5 value, u8 Y)
  LineBuf = str$(value)
  put LineBuf count 16 at 5,Y
end sub