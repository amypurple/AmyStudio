asset HistoricalTriPcmImage from "@project/tripcm-2009-compat.tripcm2009"

text screen
backdrop black
print centered at 8, "TRIPCM 2009"
print centered at 11, "PRESS FIRE"
screen on

pause until press and release sleep after 5 seconds

screen off
nmi off

Replay:
call asm AmyPlayHistoricalTriPcm with hl = address of HistoricalTriPcmImage
goto Replay

include asm "@project/tripcm-2009-compat.asm"
