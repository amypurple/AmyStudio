' Generated from an offline "Hello world" WAV using Amy Studio's speech mode.
' Tone 1/2 approximate formants; muted Tone 3 clocks variable white noise.

sub start:
  set sound table HelloWorldTable areas 4
  text screen
  print centered at 7, "HELLO WORLD"
  print centered at 10, "SPECTRAL VOICE"
  print centered at 14, "PRESS FIRE TO REPLAY"
  screen on
  wait 4 frames

replay:
  play sounds 1,2,3,4
  wait no fire
  pause until press
  goto replay
end sub

