record Groc:
  u8 Kind
  u8 X
end record

' a timer for the title tune (kit/tuneonce.py)
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Va = 0
' players
bcd digits 7 Score[2]
bcd digits 7 Bonus[2]
bcd digits 7 Sum
u8 Lev[2]
u8 Bags[2]
u8 NPl = 1
u8 Cpu = 0
u8 Cur = 0
u8 Over = 0
' the turn
Groc Gr[28]
u8 RowB[32]
u16 BagP = 0
u8 BagX = 24
u8 Lane = 0
u8 Stride = 0
u8 StrideC = 0
u16 Acc = 0
u16 Spd = 0
u16 Left = 0
u8 SpL = 3
u8 Phase = 0
u8 Dirty = 0
u8 BeltF = 0
u8 BeltD = 0
u8 Paused = 0
u8 Stp = 0
' a caught grocery flying into the sack, a lost one falling
u8 Fly = 0
u8 FlyK = 0
u8 FlyX = 0
u8 FlyL = 0
u8 MissK = 0
u8 MissX = 0
u8 MissL = 0
' the computer's player
u8 AiT = 0
u8 AiL = 0
u8 AiX = 24
u8 AiHold = 0
u8 AiWait = 0
' input: J the stick of the player at play (1 up, 2 down, 4 left, 8
' right, 16 a button), OldJ last pass's, the edges
u8 J = 0
u8 OldJ = 0
u8 Press = 0
u8 UpE = 0
u8 DnE = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
u16 Caught = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Si = 0
u8 Mi = 0
u8 Li = 0
u8 Ai = 0
u8 Ti = 0
u8 Bi = 0
u8 Pi = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Free = 0
u8 Far = 0
u8 Base = 0
u8 Kd = 0

  tile screen
  set sound table SrSoundTable areas 6
  sprites 16x16
  sprites stable 1 to 5
  sprites flicker on
  set sprite count 6
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 2 then goto title
  LevelPages
  NewGame

turn_loop:
  RunTurn
  if Phase = 3 then
    LevelUp
  else
    LoseBag
  end if
  if Over = 0 then goto turn_loop

  ' the end: GAME OVER over the counters, then back to the title on a press
  HideSprites
  print at 6,8, "                    "
  print at 6,MsgRow, "     GAME  OVER     "
  print at 6,18, "                    "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one turn: the counters drawn, PLAYER n, then play until a grocery is lost
' (Phase 2) or the level is finished (Phase 3)

sub RunTurn:
  DrawField
  SetLevel
  ShowStatus
  N = Cur + 1
  print at 8,MsgRow, "PLAYER " + digits$(N, 1)
  print at 17,MsgRow, "LEVEL " + digits$(Lev[Cur], 2)
  DrawSprites
  ShowScreen
  play sound SndTurn
  for Ti = 1 to 100
    Frame1
  next
  print at 8,MsgRow, "                    "
  Phase = 1
  OldJ = 31
rt_loop:
  Frame1
  GetInput
  PlayStep
  DrawAll
  if Phase = 1 then goto rt_loop
  if Phase = 2 then
    MissAnim
  else
    ClearAnim
  end if
  return
end sub

sub SetLevel:
  for Si = 0 to NSlot - 1
    Gr[Si].Kind = 0
    Gr[Si].X = 0
  next
  ' 14 x level groceries; a step every 25 - min(L, 44) / 2 C64 passes
  W16 = Lev[Cur]
  Left = W16 * 14
  V = Lev[Cur]
  if V > 44 then V = 44
  V = 25 - (V >> 1)
  Spd = 806 / V
  Acc = 0
  BagP = MinP
  BagX = MinX
  Lane = 0
  SpL = 3
  Stride = 0
  StrideC = 0
  Paused = 0
  Fly = 0
  Dirty = 15
  BeltF = 0
  BeltD = 1
  AiT = 0
  AiHold = 0
  AiWait = 0
  Phase = 0
  return
end sub

' one pass of play: pause, the bagger, bagging, the belt, new groceries
sub PlayStep:
  if Press = 1 then
    Paused = Paused ^ 1
    play sound SndPause
    if Paused = 1 then
      print at 12,MsgRow, "PAUSED"
    else
      print at 12,MsgRow, "      "
    end if
  end if
  if Paused = 1 then return
  MoveBagger
  CatchCheck
  MoveGroc
  if Phase <> 1 then return
  V = Tick & 1
  if V = 0 then SpawnTry
  if Left = 0 then
    if CountGroc() = 0 then Phase = 3
  end if
  return
end sub

sub MoveBagger:
  if (J & 4) <> 0 then
    if BagP >= MinP + PSpd then
      BagP = BagP - PSpd
    else
      BagP = MinP
    end if
  end if
  if (J & 8) <> 0 then
    if BagP + PSpd <= MaxP then
      BagP = BagP + PSpd
    else
      BagP = MaxP
    end if
  end if
  X = BagP >> 8
  if X <> BagX then
    inc StrideC
    if StrideC >= 6 then
      StrideC = 0
      Stride = Stride ^ 1
      if Stride = 1 then play sound SndStep
    end if
    BagX = X
  end if
  ' up and down hop a counter, round from the top to the bottom
  if UpE = 1 then
    Lane = (Lane + 3) & 3
    play sound SndHop
  end if
  if DnE = 1 then
    Lane = (Lane + 1) & 3
    play sound SndHop
  end if
  return
end sub

' every grocery on the bagger's counter left of his sack is bagged
sub CatchCheck:
  Base = Lane * 7
  N = BagX + Reach
  for Ci = 0 to 6
    K = Base + Ci
    if Gr[K].Kind > 0 then
      if Gr[K].X <= N then BagIt(K)
    end if
  next
  return
end sub

sub BagIt(u8 Slot):
  FlyK = Gr[Slot].Kind
  FlyX = Gr[Slot].X
  FlyL = Lane
  Fly = 10
  Gr[Slot].Kind = 0
  Dirty = Dirty | LaneBit[Lane]
  inc Score[Cur]
  inc Caught
  ' the computer stops to fold the bag
  AiWait = 8
  play sound SndBag
  play sound SndRustle
  return
end sub

' the belt: Spd / 256 pixel a pass for every grocery; one past the end
' of its counter ends the turn
sub MoveGroc:
  Acc = Acc + Spd
  Stp = Acc >> 8
  Acc = Acc & 255
  if Stp = 0 then return
  BeltF = (BeltF + Stp) & 3
  BeltD = 1
  Dirty = 15
  for Mi = 0 to NSlot - 1
    if Gr[Mi].Kind > 0 then
      Gr[Mi].X -= Stp
      if Gr[Mi].X < FallX then
        if Phase = 1 then
          Phase = 2
          MissK = Gr[Mi].Kind
          MissX = Gr[Mi].X
          MissL = LaneOf(Mi)
          Gr[Mi].Kind = 0
        end if
      end if
    end if
  next
  return
end sub

function LaneOf(u8 Slot) as u8
  return Slot / 7

function CountGroc as u8
  N = 0
  for Ci = 0 to NSlot - 1
    if Gr[Ci].Kind > 0 then inc N
  next
  return N

' a try for a new grocery every second pass: a coin toss, the next counter
' in turn, a free place there with room at the entry, then 3 kinds in 8
' are nothing (as on the C64)
sub SpawnTry:
  Rand
  if (Rs & 1) = 0 then return
  SpL = (SpL + 1) & 3
  Base = SpL * 7
  Free = 255
  Far = 0
  for Si = 0 to 6
    K = Base + Si
    if Gr[K].Kind = 0 then
      if Free = 255 then Free = K
    else
      if Gr[K].X > Far then Far = Gr[K].X
    end if
  next
  if Free = 255 then return
  if Far > RoomX then return
  Kd = (Rs >> 1) & 7
  if Kd >= 5 then return
  if Left = 0 then return
  dec Left
  Gr[Free].Kind = Kd + 1
  Gr[Free].X = EntryX
  Dirty = Dirty | LaneBit[SpL]
  play sound SndBeep
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' input: the player at play's controller, or the computer

sub GetInput:
  ReadPads
  if Cur = 1 then
    if Cpu = 1 then
      J = AiPad() | (Pads & 16)
    else
      J = PadOf(2)
    end if
  else
    if NPl = 1 then
      J = Pads
    else
      J = PadOf(1)
    end if
  end if
  Press = 0
  UpE = 0
  DnE = 0
  if (J & 16) <> 0 then
    if (OldJ & 16) = 0 then Press = 1
  end if
  if (J & 1) <> 0 then
    if (OldJ & 1) = 0 then UpE = 1
  end if
  if (J & 2) <> 0 then
    if (OldJ & 2) = 0 then DnE = 1
  end if
  OldJ = J
  return
end sub

' Pads: both controllers together (menus, one player)
sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' the computer: every few passes it looks for the grocery nearest the end
' of its counter, hops there and walks to meet it; it pauses a moment after
' every bag
function AiPad as u8
  V = 0
  if AiWait > 0 then
    dec AiWait
    return 0
  end if
  if AiT = 0 then
    AiT = 12
    Far = 255
    AiL = Lane
    for Ai = 0 to NSlot - 1
      if Gr[Ai].Kind > 0 then
        if Gr[Ai].X < Far then
          Far = Gr[Ai].X
          AiL = LaneOf(Ai)
        end if
      end if
    next
    if Far = 255 then
      AiX = 40
    else
      if Far > MaxX + 40 then
        AiX = MaxX
      else
        if Far > MinX + 40 then
          AiX = Far - 40
        else
          AiX = MinX
        end if
      end if
    end if
  end if
  dec AiT
  if AiL <> Lane then
    if AiHold = 0 then
      N = (AiL - Lane) & 3
      if N = 3 then
        V = 1
      else
        V = 2
      end if
      AiHold = 1
    else
      AiHold = 0
    end if
  else
    AiHold = 0
  end if
  if BagX + 2 < AiX then V = V | 8
  if BagX > AiX + 2 then V = V | 4
  return V

' ---------------------------------------------------------------------------
' the end of a turn

' the lost grocery tumbles off the end of its counter and lies blinking
sub MissAnim:
  play sound SndCrash
  play sound SndFall
  X = MissX
  Y = LaneY[MissL] + 16
  for Ti = 0 to 159
    if Ti < 24 then
      if X > 8 then X = X - 1
      Y = Y + (Ti >> 3)
    end if
    V = Ti % 24
    if V < 12 then
      set sprite 0 to Y,X,GrocSpr[MissK - 1],GrocCol[MissK - 1]
    else
      set sprite 0 to 207,0,0,0
    end if
    update sprites
    Frame1
  next
  return
end sub

sub ClearAnim:
  play sound SndClear
  print at 7,MsgRow, "LEVEL " + digits$(Lev[Cur], 2) + " FINISHED"
  for Ti = 1 to 120
    Frame1
    DrawSprites
  next
  return
end sub

' a finished level: the next one, and the starting bonus the first time
sub LevelUp:
  if Lev[Cur] < 99 then inc Lev[Cur]
  Score[Cur] += Bonus[Cur]
  Bonus[Cur] = 0
  return
end sub

' a lost bag: the other player's turn if he has bags left
sub LoseBag:
  Pi = Cur
  dec Bags[Pi]
  if NPl = 2 then
    N = 1 - Pi
    if Bags[N] > 0 then
      Cur = N
      return
    end if
  end if
  if Bags[Pi] = 0 then Over = 1
  return
end sub

sub NewGame:
  Score[0] = 0
  Score[1] = 0
  Bags[0] = 3
  Bags[1] = 0
  if NPl = 2 then Bags[1] = 3
  Cur = 0
  Over = 0
  Caught = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawField:
  NewScreen
  for Li = 0 to 3
    Y = Li * 5 + 4
    put char TScanl at 27,Y
    put char TScanr at 28,Y
    Y = Y + 2
    put char TBeltl at 4,Y
    fill TBelt count 27 at 5,Y
    Y = Y + 1
    put char TFrontl at 4,Y
    fill TFront count 27 at 5,Y
  next
  return
end sub

' rebuild the grocery row of counter L in RowB and copy it to the screen
sub DrawRow(u8 L):
  BuildRow(L)
  Va = L * 160 + 160
  copy RowB count 32 to vram.name + Va
  return
end sub

sub BuildRow(u8 L):
  fill array RowB with 32
  Base = L * 7
  for Bi = 0 to 6
    K = Base + Bi
    Kd = Gr[K].Kind
    if Kd > 0 then
      X = Gr[K].X
      C = X >> 3
      T = TGroc + (Kd - 1) * 24 + (X & 7) * 3
      RowB[C] = T
      if C < 31 then RowB[C + 1] = T + 1
      if C < 30 then RowB[C + 2] = T + 2
    end if
  next
  return
end sub

sub DrawAll:
  if BeltD = 1 then
    BeltD = 0
    Va = BeltF * 8
    copy BeltAnim + Va count 8 to vram.pattern + TBelt * 8
    copy BeltAnim + Va count 8 to vram.pattern + 2048 + TBelt * 8
    copy BeltAnim + Va count 8 to vram.pattern + 4096 + TBelt * 8
  end if
  for Li = 0 to 3
    if (Dirty & LaneBit[Li]) <> 0 then DrawRow(Li)
  next
  Dirty = 0
  DrawSprites
  return
end sub

sub DrawSprites:
  Y = LaneY[Lane]
  set metasprite TopMeta frame Cur to Y,BagX using sprite 1
  set metasprite BotMeta frame Stride to Y + 16,BagX using sprite 4
  if Fly > 0 then
    ' up out of the belt and into the sack
    dec Fly
    FlyArc
  else
    set sprite 0 to 207,0,0,0
  end if
  update sprites
  return
end sub

sub FlyArc:
  i16 Fx = 0
  i16 Dx = 0
  Fx = FlyX
  Dx = BagX + 4
  Dx = Dx - Fx
  Dx = Dx * (10 - Fly)
  Fx = Fx + Dx / 10
  T = Fly
  if T > 5 then T = 10 - T
  Y = LaneY[FlyL] + 8 - T * 3
  X = Fx
  set sprite 0 to Y,X,GrocSpr[FlyK - 1],GrocCol[FlyK - 1]
  return
end sub

' rows 1 and 2: > at play, score, level, bags
sub ShowStatus:
  for Pi = 0 to 1
    Y = Pi + 1
    if Pi < NPl then
      put char 32 at 2,Y
      if Pi = Cur then put char 62 at 2,Y
      if Pi = 1 and Cpu = 1 then
        print at 3,Y, "CP"
      else
        N = Pi + 1
        print at 3,Y, "P" + digits$(N, 1)
      end if
      print Score[Pi] at 6,Y
      print at 14,Y, "LEVEL " + digits$(Lev[Pi], 2)
      print at 23,Y, "BAGS"
      for Bi = 0 to 2
        if Bi < Bags[Pi] then
          put char TBag at 27 + Bi,Y
        else
          put char 32 at 27 + Bi,Y
        end if
      next
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for K = 0 to 5
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: SACK RACE in paper bags, a counter with groceries sliding to
' a bagger, START / PLAYERS / CREDITS, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 512 to vram.name + 32
  put char TScanl at 27,16
  put char TScanr at 28,16
  put char TBeltl at 4,18
  fill TBelt count 27 at 5,18
  put char TFrontl at 4,19
  fill TFront count 27 at 5,19
  for Si = 0 to 6
    Gr[Si].Kind = 0
  next
  Cur = 0
  Lane = 0
  BagX = MinX
  Stride = 0
  Fly = 0
  AiT = 40
  Sel = 0
  ShowMenu
  DrawTitleSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  ReadPads
  TitleDemo
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 2 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  if Sel = 1 then
    if (N & 28) <> 0 then
      Cycle(NPl, 3)
      play sound SndPick
      ShowMenu
    end if
  else
    if (N & 16) <> 0 then goto tp_done
  end if
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  ' NPl 3 is player 2 played by the computer
  Cpu = 0
  if NPl = 3 then Cpu = 1
  if Sel = 2 then
    CreditsPage
  end if
  return
end sub

' V goes round 1 .. Top
sub Cycle(ref u8 Vr, u8 Top):
  inc Vr
  if Vr > Top then Vr = 1
  return
end sub

sub ShowMenu:
  for Si = 0 to 2
    put char 32 at 9,Si + 20
  next
  put char 62 at 9,Sel + 20
  print at 11,20, "START"
  select case NPl
  case 1
    print at 11,21, "ONE PLAYER     "
  case 2
    print at 11,21, "TWO PLAYERS    "
  case else
    print at 11,21, "ONE VS COMPUTER"
  end select
  print at 11,22, "CREDITS"
  return
end sub

' groceries slide along the title's counter (row 17) to the bagger, a
' pixel a frame, a new one every 48 frames
sub TitleDemo:
  for Si = 0 to 6
    if Gr[Si].Kind > 0 then
      Gr[Si].X -= 1
      if Gr[Si].X <= MinX + Reach then
        FlyK = Gr[Si].Kind
        FlyX = Gr[Si].X
        FlyL = 0
        Fly = 10
        Gr[Si].Kind = 0
        play sound SndBag
      end if
    end if
  next
  inc AiT
  if AiT >= 48 then
    AiT = 0
    for Si = 0 to 6
      if Gr[Si].Kind = 0 then
        Rand
        Gr[Si].Kind = (Rs >> 3) % 5 + 1
        Gr[Si].X = EntryX
        exit for
      end if
    next
  end if
  BuildRow(0)
  copy RowB count 32 to vram.name + 544
  DrawTitleSprites
  return
end sub

sub DrawTitleSprites:
  set metasprite TopMeta frame 0 to 127,BagX using sprite 1
  set metasprite BotMeta frame 0 to 143,BagX using sprite 4
  if Fly > 0 then
    dec Fly
    T = Fly
    if T > 5 then T = 10 - T
    Y = 135 - T * 3
    set sprite 0 to Y,FlyX,GrocSpr[FlyK - 1],GrocCol[FlyK - 1]
  else
    set sprite 0 to 207,0,0,0
  end if
  update sprites
  return
end sub

' the starting level of every player (the computer takes player 1's)
sub LevelPages:
  Lev[0] = 1
  Lev[1] = 1
  LevelPage(0)
  if NPl = 2 then LevelPage(1)
  if NPl = 3 then
    Lev[1] = Lev[0]
    Bonus[1] = Bonus[0]
    NPl = 2
  end if
  return
end sub

sub LevelPage(u8 P):
  NewScreen
  N = P + 1
  print at 12,4, "PLAYER " + digits$(N, 1)
  print at 4,7, "CHOOSE THE STARTING LEVEL"
  print at 10,10, "LEVEL"
  print at 10,12, "BONUS"
  print at 4,17, "UP OR DOWN: THE LEVEL"
  print at 4,18, "BUTTON: READY"
  put char TBag at 8,10
  put char TBag at 23,10
  ShowBonus(P)
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 31
  Ti = 0
lp_loop:
  Frame1
  inc Rs
  ReadPads
  N = Pads & 3
  if N = 0 then
    Ti = 0
  else
    ' a step on the push, then every 8 frames while held
    inc Ti
    if Ti >= 24 then Ti = 16
    if Ti = 1 or Ti = 16 then
      if N = 1 then
        if Lev[P] >= 25 then Lev[P] = 1 else inc Lev[P]
      else
        if Lev[P] <= 1 then Lev[P] = 25 else dec Lev[P]
      end if
      play sound SndPick
      ShowBonus(P)
    end if
  end if
  N = Pads & (Pads ^ OldPads)
  if (N & 16) = 0 then goto lp_loop
  play sound SndTurn
  return
end sub

' the bonus for starting at level L: 7 x L x (L - 1), added up in BCD
sub ShowBonus(u8 P):
  ' worked out in a u16, then turned into BCD a decimal digit at a time
  ' (`Sum += V` with a u8 V adds 1 V times: slow for 25 x 168)
  Sum = 0
  V = Lev[P] - 1
  W16 = Lev[P] * 7
  W16 = W16 * V
  while W16 >= 1000
    Sum += 1000
    W16 = W16 - 1000
  end while
  while W16 >= 100
    Sum += 100
    W16 = W16 - 100
  end while
  while W16 >= 10
    Sum += 10
    W16 = W16 - 10
  end while
  V = W16
  Sum += V
  Bonus[P] = Sum
  print at 16,10, digits$(Lev[P], 2)
  print Sum at 16,12
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "SACK  RACE"
  print at 2,5, "BASED ON SACK RACE,"
  print at 2,6, "PROGRAMMED BY JOHN FEDOR,"
  print at 2,7, "CONCEPT: TOM GAUTHIER AND"
  print at 2,8, "JOHN FEDOR. AHOY! NOVEMBER"
  print at 2,9, "1988 (COMMODORE 64)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CHECKOUT SHUFFLE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

