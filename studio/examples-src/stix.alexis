  tile screen
  set sound table SxSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Mode = 0
  CreditsPage

title:
  Mode = 0
  TitlePage
  if MSel = 4 then
    CreditsPage
    goto title
  end if
  Puz = MSel + 1
  ObjectPage
again:
  PlayPuzzle
  if Quit = 1 then goto title
  if Quit = 2 then goto again
  ' the end: a message, then the title on a press
  Mode = 3
  if Res = 1 then
    WinPage
  else
    LosePage
  end if
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one puzzle, from the deal to a win, a lost game or the right button

sub PlayPuzzle:
  Quit = 0
  Res = 0
  SetupPuzzle
  DrawBoard
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 63
  Hold = 0
  Mode = 1
pp_loop:
  Frame1
  ReadPads
  GlideArrow
  ' the right button: a tap starts over, held 90 frames goes to the title
  if (Pads & 32) <> 0 then
    inc Hold
    if Hold >= 90 then
      Quit = 1
      play sound SndTick
      goto pp_done
    end if
  else
    if Hold > 0 then
      Hold = 0
      Quit = 2
      play sound SndStrike
      goto pp_done
    end if
  end if
  select case Puz
  case 1
    Step1
  case 2
    Step2
  case 3
    Step3
  case else
    Step4
  end select
  if Res = 0 then goto pp_loop
pp_done:
  Mode = 2
  HideSprites
  return
end sub

sub SetupPuzzle:
  Moves = 0
  Sel = 255
  Turn = 0
  Ln4 = 0
  Cur = 0
  ArrOn = 0
  fill array Occ with 0
  LoadHoles
  select case Puz
  case 1
    for Hi = 0 to 3
      Occ[Hi] = 1
      Occ[Hi + 5] = 4
    next
    Cur = 4
    ArrOn = 1
  case 2
    ' a winnable deal: two empty holes, the others filled in order
    Rand
    Deal = Rs % NDeal
    K = Deal * 2
    C = 1
    for Hi = 0 to 9
      if Hi <> Deals[K] and Hi <> Deals[K + 1] then
        Occ[Hi] = C
        inc C
      end if
    next
    Cur = 5
    ArrOn = 1
  case 3
    Occ[0] = 1
    Occ[1] = 1
    Occ[7] = 4
    Occ[8] = 4
    Occ[9] = 3
    Occ[10] = 3
    Occ[15] = 2
    Occ[16] = 2
    Sel = 0
    PickFirst
  case else
    Scramble
  end select
  if ArrOn = 1 then
    ArrowTarget
    Ax = Tx
    Ay = Ty
  end if
  return
end sub

' the holes of this board into Cells (one record a hole)
sub LoadHoles:
  select case Puz
  case 1
    NH = 9
  case 2
    NH = 10
  case 3
    NH = 17
  case else
    NH = 8
  end select
  CopyHoles(NH)
  return
end sub

sub CopyHoles(u8 Cnt):
  for Hi = 0 to Cnt - 1
    select case Puz
    case 1
      Cells[Hi].Cx = HoleX1[Hi]
      Cells[Hi].Cy = HoleY1[Hi]
    case 2
      Cells[Hi].Cx = HoleX2[Hi]
      Cells[Hi].Cy = HoleY2[Hi]
    case 3
      Cells[Hi].Cx = HoleX3[Hi]
      Cells[Hi].Cy = HoleY3[Hi]
    case else
      Cells[Hi].Cx = HoleX4[Hi]
      Cells[Hi].Cy = HoleY4[Hi]
    end select
  next
  return
end sub

' TRANSTIXION: all red, then 20 random lines turned (again if that left
' them all red)
sub Scramble:
  fill array Col4 with 0
sc_again:
  for Mi = 1 to 20
    Rand
    Ln4 = Rs % 7
    TurnLine
  next
  if AllRed() = 1 then goto sc_again
  Ln4 = 0
  return
end sub

sub TurnLine:
  K = Ln4 * 3
  for Ki = 0 to 2
    N = Lines4[K + Ki]
    if N < 8 then
      Col4[N] = (Col4[N] + 1) & 3
      Occ[N] = Col4[N] + 1
    end if
  next
  return
end sub

function AllRed as u8
  for Ki = 0 to 7
    if Col4[Ki] <> 0 then return 0
  next
  return 1

' ---------------------------------------------------------------------------
' LINEARSTIX

sub Step1:
  if (Edge & 4) <> 0 then
    if Cur > 0 then
      dec Cur
      play sound SndTick
    end if
  end if
  if (Edge & 8) <> 0 then
    if Cur < 8 then
      inc Cur
      play sound SndTick
    end if
  end if
  ArrowTarget
  if (Edge & 16) = 0 then return
  C = Occ[Cur]
  if C = 0 then
    play sound SndBuzz
    return
  end if
  ' red (1) goes towards 9, blue towards 1
  V = 0
  if C = 1 then V = 1
  N = LineDest(0, Cur + 1, V)
  if N = 0 then
    play sound SndBuzz
    return
  end if
  Jover = 255
  HopMatch(Cur, N - 1)
  Moves += 1
  ShowMoves
  if Won1() = 1 then
    Res = 1
  else
    if Any1() = 0 then Res = 2
  end if
  return
end sub

function Won1 as u8
  for Ki = 0 to 3
    if Occ[Ki] <> 4 then return 0
    if Occ[Ki + 5] <> 1 then return 0
  next
  return 1

function Any1 as u8
  for Ki = 0 to 8
    C = Occ[Ki]
    if C > 0 then
      V = 0
      if C = 1 then V = 1
      if LineDest(0, Ki + 1, V) > 0 then return 1
    end if
  next
  return 0

' the hole of place P (1-9) on line Ln (0 across, 1 down; down 5 is
' across 5)
function LineHole(u8 Ln, u8 P) as u8
  if Ln = 0 then return P - 1
  if P = 5 then return 4
  if P < 5 then return P + 8
  return P + 7

' the place a match at P can reach going forward (towards 9 when Fw is
' true): the next place if empty, else the one after if empty (a jump);
' 0 when neither
function LineDest(u8 Ln, u8 P, u8 Fw) as u8
  if Fw <> 0 then
    if P >= 9 then return 0
    if Occ[LineHole(Ln, P + 1)] = 0 then return P + 1
    if P >= 8 then return 0
    if Occ[LineHole(Ln, P + 2)] = 0 then return P + 2
    return 0
  end if
  if P <= 1 then return 0
  if Occ[LineHole(Ln, P - 1)] = 0 then return P - 1
  if P <= 2 then return 0
  if Occ[LineHole(Ln, P - 2)] = 0 then return P - 2
  return 0

' ---------------------------------------------------------------------------
' TRISTIXULAR

sub Step2:
  MovePointer2
  ArrowTarget
  if (Edge & 16) = 0 then return
  if Occ[Cur] > 0 then
    ' pick a match (again: put it down)
    V = Sel
    if Sel = Cur then
      Sel = 255
    else
      Sel = Cur
    end if
    if V < 10 then DrawHole(V)
    DrawHole(Cur)
    play sound SndPick
    return
  end if
  if Sel = 255 then
    play sound SndBuzz
    return
  end if
  Jover = FindJump(Sel, Cur)
  if Jover = 255 then
    play sound SndBuzz
    return
  end if
  V = Sel
  Sel = 255
  HopMatch(V, Cur)
  Moves += 1
  ShowMoves
  if CountMatches() = 1 then
    Res = 1
  else
    if Any2() = 0 then Res = 2
  end if
  return
end sub

' the hole jumped over going from F to D, if that jump exists and has a
' match to jump (255 when not)
function FindJump(u8 F, u8 D) as u8
  for Ki = 0 to NJmp - 1
    K = Ki * 3
    if Jmp[K] = F and Jmp[K + 2] = D then
      if Occ[Jmp[K + 1]] > 0 then return Jmp[K + 1]
    end if
  next
  return 255

function Any2 as u8
  for Ki = 0 to NJmp - 1
    K = Ki * 3
    if Occ[Jmp[K]] > 0 and Occ[Jmp[K + 1]] > 0 and Occ[Jmp[K + 2]] = 0 then return 1
  next
  return 0

function CountMatches as u8
  N = 0
  for Ki = 0 to NH - 1
    if Occ[Ki] > 0 then inc N
  next
  return N

' the hole at row R, column Xc of the triangle (255 if none)
function Find2(u8 R, u8 Xc) as u8
  for Ki = 0 to 9
    if Tri2R[Ki] = R and Tri2X[Ki] = Xc then return Ki
  next
  return 255

' up and down go to the next row (the diagonal held, or the nearer side),
' left and right two columns along the row
sub MovePointer2:
  i8 Dr = 0
  i8 Dc = 0
  u8 R = 0
  u8 Xc = 0
  u8 Nw = 255
  if (Edge & 15) = 0 then return
  R = Tri2R[Cur]
  Xc = Tri2X[Cur]
  if (Pads & 1) <> 0 then Dr = -1
  if (Pads & 2) <> 0 then Dr = 1
  if (Pads & 4) <> 0 then Dc = -1
  if (Pads & 8) <> 0 then Dc = 1
  if Dr = 0 then
    Nw = Find2(R, Xc + Dc * 2)
  else
    if Dc = 0 then
      Nw = Find2(R + Dr, Xc + 1)
      if Nw = 255 then Nw = Find2(R + Dr, Xc - 1)
    else
      Nw = Find2(R + Dr, Xc + Dc)
    end if
  end if
  if Nw < 10 then
    Cur = Nw
    play sound SndTick
  end if
  return
end sub

' ---------------------------------------------------------------------------
' INTERSTIXTION

sub Step3:
  u8 G = 0
  u8 P = 0
  u8 Old = 0
  G = Turn & 3
  if (Edge & 15) <> 0 then
    ' the other match of this colour
    Old = Sel
    Sel = OtherOf(Sel)
    DrawHole(Old)
    DrawHole(Sel)
    play sound SndTick
  end if
  if (Edge & 16) = 0 then return
  P = LinePos(Sel, GLn[G])
  N = LineDest(GLn[G], P, GFwd[G])
  if N = 0 then
    play sound SndBuzz
    return
  end if
  Jover = 255
  Old = Sel
  Sel = 255
  HopMatch(Old, LineHole(GLn[G], N))
  Moves += 1
  ShowMoves
  inc Turn
  if Won3() = 1 then
    Res = 1
    return
  end if
  PickFirst
  if Sel = 255 then
    ' this colour cannot move: the game is lost
    Res = 2
    return
  end if
  ShowTurn
  return
end sub

' the first match of the colour whose turn it is that can move (Sel 255
' when none can)
sub PickFirst:
  u8 G = 0
  u8 Hh = 0
  G = Turn & 3
  Sel = 255
  for Si = 1 to 9
    Hh = LineHole(GLn[G], Si)
    if Occ[Hh] = GCol[G] then
      if LineDest(GLn[G], Si, GFwd[G]) > 0 then
        if Sel = 255 then Sel = Hh
      end if
    end if
  next
  if Sel < 17 then DrawHole(Sel)
  return
end sub

' the other match of the same colour on its line
function OtherOf(u8 Hh) as u8
  u8 G = 0
  u8 Q = 0
  G = Turn & 3
  for Si = 1 to 9
    Q = LineHole(GLn[G], Si)
    if Q <> Hh and Occ[Q] = GCol[G] then return Q
  next
  return Hh

' the place (1-9) of hole Hh on line Ln
function LinePos(u8 Hh, u8 Ln) as u8
  if Ln = 0 then return Hh + 1
  if Hh = 4 then return 5
  if Hh < 13 then return Hh - 8
  return Hh - 7

function Won3 as u8
  if Occ[7] <> 1 or Occ[8] <> 1 then return 0
  if Occ[0] <> 4 or Occ[1] <> 4 then return 0
  if Occ[15] <> 3 or Occ[16] <> 3 then return 0
  if Occ[9] <> 2 or Occ[10] <> 2 then return 0
  return 1

sub ShowTurn:
  T = Turn & 3
  select case T
  case 0
    print at 4,MsgRow, "  RED MOVES RIGHT  "
  case 1
    print at 4,MsgRow, "  GREEN MOVES DOWN "
  case 2
    print at 4,MsgRow, "  BLUE MOVES LEFT  "
  case else
    print at 4,MsgRow, "  YELLOW MOVES UP  "
  end select
  return
end sub

' ---------------------------------------------------------------------------
' TRANSTIXION

sub Step4:
  u8 OldL = 0
  OldL = Ln4
  if (Edge & 5) <> 0 then Ln4 = (Ln4 + 6) % 7
  if (Edge & 10) <> 0 then Ln4 = (Ln4 + 1) % 7
  if Ln4 <> OldL then
    DrawLine(OldL)
    DrawLine(Ln4)
    play sound SndTick
  end if
  if (Edge & 16) = 0 then return
  TurnLine
  DrawLine(Ln4)
  play sound SndTurn
  Moves += 1
  ShowMoves
  if AllRed() = 1 then Res = 1
  return
end sub

sub DrawLine(u8 L):
  K = L * 3
  for Di = 0 to 2
    N = Lines4[K + Di]
    if N < 8 then DrawHole(N)
  next
  return
end sub

function InLine(u8 Hh) as u8
  K = Ln4 * 3
  if Lines4[K] = Hh or Lines4[K + 1] = Hh or Lines4[K + 2] = Hh then return 1
  return 0

' ---------------------------------------------------------------------------
' a match hops from hole F to hole D in an arc: off the board as a sprite,
' over the jumped match (Jover, which goes at the top of the arc in
' TRISTIXULAR) and back in as tiles

sub HopMatch(u8 F, u8 D):
  u8 Mc = 0
  u8 Fr = 0
  i16 X0 = 0
  i16 Y0 = 0
  i16 Dx = 0
  i16 Dy = 0
  i16 Px = 0
  i16 Py = 0
  i16 Lift = 0
  u8 Hc = 0
  Mode = 2
  Mc = Occ[F]
  Hc = HeadCol[Mc - 1]
  Occ[F] = 0
  DrawHole(F)
  X0 = Cells[F].Cx * 8
  Y0 = Cells[F].Cy * 8 - 1
  Dx = Cells[D].Cx * 8
  Dx = Dx - X0
  Dy = Cells[D].Cy * 8 - 1
  Dy = Dy - Y0
  ' 16 frames for a step, 24 for a jump or a long way
  Fr = 16
  if abs(Dx) > 24 or abs(Dy) > 24 then Fr = 24
  play sound SndHop
  for Ti = 1 to Fr
    Px = X0 + Dx * Ti / Fr
    Py = Y0 + Dy * Ti / Fr
    Lift = Ti * (Fr - Ti)
    Lift = Lift / 6
    Py = Py - Lift
    if Ti = Fr / 2 then
      if Jover < 17 then
        Occ[Jover] = 0
        DrawHole(Jover)
        play sound SndVanish
      end if
    end if
    if Jover < 17 and Ti >= Fr / 2 then
      K = Cells[Jover].Cx * 8
      N = Cells[Jover].Cy * 8 - 1
      set sprite 2 to N,K,SPuff,15
    end if
    X = Px
    Y = Py
    set sprite 0 to Y,X,SHead,Hc
    set sprite 1 to Y,X,SShaft,10
    if ArrOn = 0 then set sprite 3 to 207,0,0,0
    update sprites
    Frame1
  next
  Occ[D] = Mc
  DrawHole(D)
  set sprite 0 to 207,0,0,0
  set sprite 1 to 207,0,0,0
  set sprite 2 to 207,0,0,0
  update sprites
  Jover = 255
  play sound SndLand
  ' the stick and buttons as they are now: a press held from before the
  ' hop is no new press, one made after it is
  Pads = PadOf(1) | PadOf(2)
  Mode = 1
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' one hole: the match's head (its colour) over the shaft and the hole,
' lit when it is the chosen match or in the chosen line
sub DrawHole(u8 Hh):
  u8 Hx = 0
  u8 Hy = 0
  u8 Lt = 0
  u8 Bt = 0
  Hx = Cells[Hh].Cx
  Hy = Cells[Hh].Cy
  C = Occ[Hh]
  if Puz = 4 then
    Lt = InLine(Hh)
  else
    if Hh = Sel then Lt = 1
  end if
  if C = 0 then
    put char TBlank at Hx,Hy
    put char TBlank at Hx + 1,Hy
    Bt = TBot00l + Lt * 2
  else
    T = TTop1l + (C - 1) * 2
    put char T at Hx,Hy
    put char T + 1 at Hx + 1,Hy
    Bt = TBot10l + Lt * 2
  end if
  put char Bt at Hx,Hy + 1
  put char Bt + 1 at Hx + 1,Hy + 1
  return
end sub

sub DrawBoard:
  NewScreen
  DrawFrame
  DrawDots
  for Hi = 0 to NH - 1
    DrawHole(Hi)
  next
  PrintName(2, 1)
  print at 19,1, "MOVES"
  ShowMoves
  print at 2,22, "R BUTTON: AGAIN (HOLD: MENU)"
  select case Puz
  case 1
    print at 3,MsgRow, "RED GOES RIGHT, BLUE LEFT"
  case 2
    print at 4,MsgRow, "JUMP TILL ONE IS LEFT"
  case 3
    ShowTurn
  case else
    print at 6,MsgRow, "MAKE ALL MATCHES RED"
    ' the colour order under the board
    for Di = 0 to 3
      X = Di * 4 + 9
      put char TTop1l + Di * 2 at X,17
      put char TTop1l + Di * 2 + 1 at X + 1,17
      put char TBot10l at X,18
      put char TBot10r at X + 1,18
      if Di < 3 then put char 62 at X + 2,18
    next
  end select
  return
end sub

sub PrintName(u8 Px, u8 Py):
  select case Puz
  case 1
    print at Px,Py, "LINEARSTIX"
  case 2
    print at Px,Py, "TRISTIXULAR"
  case 3
    print at Px,Py, "INTERSTIXTION"
  case else
    print at Px,Py, "TRANSTIXION"
  end select
  return
end sub

sub DrawFrame:
  fill TFh count 30 at 1,0
  fill TFh count 30 at 1,23
  for Di = 1 to 22
    put char TFv at 1,Di
    put char TFv at 30,Di
  next
  put char TFc at 1,0
  put char TFc at 30,0
  put char TFc at 1,23
  put char TFc at 30,23
  return
end sub

sub DrawDots:
  select case Puz
  case 1
    DotsFrom(0, NDot1)
  case 2
    DotsFrom(1, NDot2)
  case 3
    DotsFrom(2, NDot3)
  case else
    DotsFrom(3, NDot4)
  end select
  return
end sub

sub DotsFrom(u8 Which, u8 Cnt):
  u16 Ix = 0
  for Di = 0 to Cnt - 1
    Ix = Di * 2
    select case Which
    case 0
      X = Dot1[Ix]
      Y = Dot1[Ix + 1]
    case 1
      X = Dot2[Ix]
      Y = Dot2[Ix + 1]
    case 2
      X = Dot3[Ix]
      Y = Dot3[Ix + 1]
    case else
      X = Dot4[Ix]
      Y = Dot4[Ix + 1]
    end select
    put char TDot at X,Y
  next
  return
end sub

sub ShowMoves:
  print Moves at 25,1
  return
end sub

' the pointer under the hole at Cur
sub ArrowTarget:
  Tx = Cells[Cur].Cx * 8
  Ty = Cells[Cur].Cy * 8 + 15
  return
end sub

sub GlideArrow:
  if ArrOn = 0 then return
  if Ax < Tx then Ax = Ax + Min8(Tx - Ax, 4)
  if Ax > Tx then Ax = Ax - Min8(Ax - Tx, 4)
  if Ay < Ty then Ay = Ay + Min8(Ty - Ay, 4)
  if Ay > Ty then Ay = Ay - Min8(Ay - Ty, 4)
  set sprite 3 to Ay,Ax,SArrow,15
  update sprites
  return
end sub

function Min8(u8 A, u8 B) as u8
  if A < B then return A
  return B

' ---------------------------------------------------------------------------
' input: both controllers together; Edge holds the new presses, and a
' direction held repeats every 8 frames after 20

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  Edge = Pads & (Pads ^ OldPads)
  if (Pads & 15) = 0 then
    Rep = 0
  else
    inc Rep
    if Rep >= 28 then
      Rep = 20
      Edge = Edge | (Pads & 15)
    end if
  end if
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).button1 then T = T | 16
  if joypad(P).button2 then T = T | 32
  return T

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for K = 0 to NSpr - 1
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: STIX! in matches, the four puzzles and CREDITS, the best
' number of moves of this session, the tune once

sub TitlePage:
  NewScreen
  copy TitleMap count 224 to vram.name + 64
  DrawFrame
  print at 4,10, "FOUR PUZZLES, EIGHT STICKS"
  MSel = Puz - 1
  ShowMenu
  print at 4,20, "STICK: CHOOSE"
  print at 4,21, "BUTTON: PLAY"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 470
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 63
tp_loop:
  Frame1
  inc Rs
  ReadPads
  if (Edge & 1) <> 0 then
    if MSel > 0 then
      dec MSel
      play sound SndTick
      ShowMenu
    end if
  end if
  if (Edge & 2) <> 0 then
    if MSel < 4 then
      inc MSel
      play sound SndTick
      ShowMenu
    end if
  end if
  if (Edge & 48) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  play sound SndStrike
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  for Si = 0 to 4
    Y = Si + 13
    put char 32 at 6,Y
    if Si = MSel then put char 62 at 6,Y
  next
  print at 8,13, "1 LINEARSTIX"
  print at 8,14, "2 TRISTIXULAR"
  print at 8,15, "3 INTERSTIXTION"
  print at 8,16, "4 TRANSTIXION"
  print at 8,17, "CREDITS"
  for Si = 0 to 3
    Y = Si + 13
    if Best[Si] = 0 then
      print at 24,Y, "    "
    else
      print Best[Si] at 24,Y
    end if
  next
  print at 23,12, "BEST"
  return
end sub

' the objective, as the C-128's title scrolled it
sub ObjectPage:
  NewScreen
  DrawFrame
  PrintName(2, 2)
  select case Puz
  case 1
    print at 3,5, "MOVE ALL RED STIX TO THE"
    print at 3,6, "RIGHT SIDE AND THE BLUE"
    print at 3,7, "ONES TO THE LEFT."
    print at 3,9, "ALL STIX MOVE FORWARD ONLY,"
    print at 3,10, "BUT THEY CAN JUMP OVER ONE."
    print at 3,13, "LEFT, RIGHT: CHOOSE A STICK"
    print at 3,14, "BUTTON: MOVE OR JUMP IT"
  case 2
    print at 3,5, "LEAVE ONLY ONE STICK ON"
    print at 3,6, "THE BOARD BY JUMPING OVER"
    print at 3,7, "THE OTHERS. A JUMPED STICK"
    print at 3,8, "VANISHES."
    print at 3,11, "STICK: MOVE THE POINTER"
    print at 3,12, "BUTTON ON A STICK: PICK IT"
    print at 3,13, "BUTTON ON AN EMPTY HOLE:"
    print at 3,14, "JUMP THE PICKED STICK THERE"
  case 3
    print at 3,5, "MOVE THE STIX TO THE"
    print at 3,6, "OPPOSITE SIDE OF THE CROSS."
    print at 3,7, "ALL STIX MOVE FORWARD ONLY"
    print at 3,8, "BUT THEY CAN JUMP. THE FOUR"
    print at 3,9, "COLOURS TAKE TURNS: RED,"
    print at 3,10, "GREEN, BLUE, YELLOW. A"
    print at 3,11, "COLOUR THAT CANNOT MOVE"
    print at 3,12, "LOSES THE GAME."
    print at 3,14, "STICK: THE OTHER STICK"
    print at 3,15, "BUTTON: MOVE OR JUMP IT"
  case else
    print at 3,5, "CHANGE ALL STIX TO RED."
    print at 3,7, "STICK: CHOOSE A LINE"
    print at 3,8, "BUTTON: CHANGE ITS COLOURS"
    print at 3,10, "THE ORDER OF CHANGE IS"
    print at 3,11, "RED, YELLOW, GREEN, BLUE,"
    print at 3,12, "THEN BACK TO RED."
  end select
  print at 3,18, "RIGHT BUTTON IN PLAY:"
  print at 3,19, "START OVER (HOLD: MENU)"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

' the C-128's win screen, with the number of moves and the best
sub WinPage:
  u8 Bi = 0
  Bi = Puz - 1
  if Best[Bi] = 0 or Moves < Best[Bi] then
    Best[Bi] = Moves
  end if
  Rearm
  wait 30 frames
  nmi off
  NewScreen
  DrawFrame
  fill TDot count 26 at 3,5
  fill TDot count 26 at 3,15
  print at 7,7, "CONGRATULATIONS!"
  print at 7,9, "WE HAVE A WINNER"
  print at 9,10, "IN"
  PrintName(12, 10)
  print at 4,12, "AND THE CROWD GOES WILD"
  print at 8,17, "MOVES"
  print Moves at 16,17
  print at 8,18, "BEST"
  print Best[Bi] at 16,18
  ShowScreen
  mute all
  play sound SndWin
  Rearm
  wait 60 frames
  nmi off
  return
end sub

' a game that can no longer be won: the board stays, with the reason
sub LosePage:
  if Puz = 3 then
    T = Turn & 3
    select case T
    case 0
      print at 4,MsgRow, " RED CANNOT MOVE:  "
    case 1
      print at 4,MsgRow, " GREEN CANNOT MOVE:"
    case 2
      print at 4,MsgRow, " BLUE CANNOT MOVE: "
    case else
      print at 4,MsgRow, "YELLOW CANNOT MOVE:"
    end select
    print at 2,21, "     THE GAME IS LOST     "
  else
    print at 2,MsgRow, "       NO MOVES LEFT        "
    print at 2,21, "                            "
  end if
  print at 2,22, "   PRESS A BUTTON: TITLE    "
  mute all
  play sound SndLose
  Rearm
  wait 60 frames
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "STIX!"
  print at 2,5, "BASED ON STIX! FOR THE"
  print at 2,6, "COMMODORE 128, AHOY!"
  print at 2,7, "FEBRUARY 1989 (NO AUTHOR"
  print at 2,8, "NAMED ON THE DISK)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: MATCHBOX MARCH"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
SxTick:
    db $40,$47,$50,$02,$40,$47,$F0,$01,$50
SxPick:
    db $40,$71,$30,$02,$40,$55,$30,$03,$50
SxHop:
    db $40,$55,$30,$02,$40,$5F,$30,$02,$40,$6B,$40,$02,$40,$78,$40,$02,$40,$87,$50,$02,$40,$97,$50,$02
    db $50
SxLand:
    db $00,$00,$35,$02,$00,$00,$66,$03,$10
SxVanish:
    db $00,$00,$24,$03,$00,$00,$45,$04,$00,$00,$76,$06,$10
SxBuzz:
    db $40,$F9,$23,$08,$40,$FF,$33,$08,$50
SxTurn:
    db $40,$8F,$30,$03,$40,$71,$30,$03,$40,$5F,$40,$04,$50
SxWin:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$8F,$20,$06,$40,$6B,$10,$14
    db $50
SxLose:
    db $40,$1D,$21,$0A,$40,$2E,$21,$0A,$40,$41,$21,$0A,$40,$AB,$31,$1E,$50
SxStrike:
    db $00,$00,$14,$02,$00,$00,$35,$03,$00,$00,$56,$05,$00,$00,$87,$06,$10

SxSoundTable:
    dw SxTuneMel,$702B
    dw SxTuneBass,$7035
    dw SxTick,$7049
    dw SxPick,$7049
    dw SxHop,$7049
    dw SxLand,$703F
    dw SxVanish,$703F
    dw SxBuzz,$7049
    dw SxTurn,$7049
    dw SxWin,$7049
    dw SxLose,$7049
    dw SxStrike,$703F
; Matchbox March (original)
; Tiny Sound, 7 frames per step
SxTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$1A,$01,$1E,$21,$26,$01,$21,$01,$23,$01,$1F,$01
