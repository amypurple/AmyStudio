u8 Ani = 0
u8 AniC = 0
u8 PadC = 0
' the game
u8 Lives = 3
u8 Lv = 0
u8 Homes = 0
u8 Time = 39
u8 TCnt = 25
u8 Phase = 0
u8 Cause = 0
u8 Over = 0
u8 J = 0
u8 OldJ = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Wt = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Si = 0
u8 Fi = 0
u8 Hi8 = 0
u8 Ti = 0
u8 Bi = 0
u8 Ci = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Q = 0
u8 Stp = 0
u8 RrL = 0

  tile screen
  set sound table PgSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count 9
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Wt = 1
  CreditsPage

title:
  TitlePage
  NewGame
  DrawField
  ShowScreen

life_loop:
  RunLife
  if Over = 0 then goto life_loop

  ' the end: GAME OVER on the ice shelf, then back to the title on a press
  Wt = 4
  HideSprites
  ShowStatus
  print at 10,MsgRow, " GAME  OVER "
  if Score > Hi then
    Hi = Score
    print at 9,MsgRow + 1, " NEW HIGH SCORE "
  end if
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one life: READY, then play until the penguin is lost or reaches a burrow

sub RunLife:
  ResetPenguin
  ShowStatus
  DrawBar
  Phase = 0
  Wt = 2
  print at 13,MsgRow, "READY"
  DrawSprites
  play sound SndStart
  for Ti = 1 to 50
    Frame1
  next
  fill TShelft count 5 at 13,MsgRow
  Phase = 1
  Wt = 3
rl_loop:
  Frame1
  GetInput
  PlayStep
  DrawAll
  if Phase = 1 then goto rl_loop
  if Phase = 2 then
    DeathAnim
  else
    HomeAnim
  end if
  return
end sub

sub ResetPenguin:
  Px = StartX
  Py = StartY
  Dir = 2
  Time = FullTime
  TCnt = TimeStep
  Ani = 0
  AniC = 0
  Wet = 0
  OnFloe = 0
  return
end sub

' one frame of play, the C64's main loop: stick, move, river, current,
' collisions, the top, the clock
sub PlayStep:
  MovePenguin
  MoveRiver
  Wet = InWater(Py)
  OnFloe = 0
  if Wet = 1 then
    OnFloe = FloeUnder()
    if OnFloe = 0 then dec Py
  end if
  if HitAny() = 1 then
    Phase = 2
    return
  end if
  if Py <= TopY then
    ReachTop
    return
  end if
  dec TCnt
  if TCnt = 0 then
    TCnt = TimeStep
    if Time > 0 then
      dec Time
      DrawBar
    end if
  end if
  return
end sub

sub MovePenguin:
  ' the stick latches: one direction sets it, a button stops, nothing (or
  ' a diagonal) keeps it
  if (J & 16) <> 0 then
    Dir = 0
  else
    select case J
    case 1
      Dir = 1
    case 2
      Dir = 2
    case 4
      Dir = 3
    case 8
      Dir = 4
    end select
  end if
  select case Dir
  case 1
    dec Py
  case 2
    if Py < StartY then inc Py
  case 3
    if Px > MinX then dec Px
  case 4
    if Px < MaxX then inc Px
  end select
  if Dir <> 0 then
    inc AniC
    if AniC >= 8 then
      AniC = 0
      Ani = Ani ^ 1
    end if
  end if
  return
end sub

' the river: every lane's position in 8.8 fixed point
sub MoveRiver:
  for Li = 0 to 4
    W16 = Ln[Li].Frac + Ln[Li].Spd
    Stp = W16 >> 8
    Ln[Li].Frac = W16 & 255
    if LaneDir[Li] = 1 then
      Ln[Li].Pos = Ln[Li].Pos + Stp
    else
      Ln[Li].Pos = Ln[Li].Pos - Stp
    end if
  next
  return
end sub

' 1 when the penguin's whole box is in open water
function InWater(u8 Yp) as u8
  if Yp >= 56 and Yp <= 88 then return 1
  if Yp >= 120 and Yp <= 152 then return 1
  return 0

' 1 when the penguin touches a floe (where it is drawn, on 2 pixels)
function FloeUnder as u8
  for Fi = 0 to NFloe - 1
    K = FloeLane[Fi]
    Y = LaneY[K]
    if Py + 15 >= Y + 3 then
      if Py <= Y + 10 then
        X = Ln[K].Pos + FloeBase[Fi]
        X = X & 254
        T = Px - X
        if T <= 13 or T >= 243 then return 1
      end if
    end if
  next
  return 0

' a shark or the seal: 1 when it is shown (columns 2-28) and its body
' overlaps the penguin's
function HitAny as u8
  for Si = 0 to NShark - 1
    K = SharkLane[Si]
    X = Ln[K].Pos + SharkBase[Si]
    if Shown(X) = 1 then
      Y = LaneY[K]
      if Near(X, Y) = 1 then
        Cause = 1
        return 1
      end if
    end if
  next
  X = Ln[4].Pos
  if Shown(X) = 1 then
    if Near(X, SealY) = 1 then
      Cause = 2
      return 1
    end if
  end if
  return 0

function Shown(u8 Xs) as u8
  if Xs < MinX then return 0
  if Xs > MaxX then return 0
  return 1

' bodies: 24 pixels across together, rows 7-12 of the sprite
function Near(u8 Xs, u8 Ys) as u8
  N = Px - Xs
  if N > 11 and N < 245 then return 0
  if Py + 13 < Ys + 7 then return 0
  if Py + 2 > Ys + 12 then return 0
  return 1

' the top: into an empty burrow, or the wall (or a full burrow)
sub ReachTop:
  Q = HomeAt(Px)
  if Q = 0 then
    Cause = 3
    Phase = 2
    return
  end if
  dec Q
  if HomeF[Q] = 1 then
    Cause = 3
    Phase = 2
    return
  end if
  HomeF[Q] = 1
  Phase = 3
  return
end sub

' 1-3: the burrow in front of the penguin's middle, 0 for the wall
function HomeAt(u8 Xp) as u8
  for Hi8 = 0 to 2
    V = HomeCol[Hi8] * 8
    if Xp + 3 >= V and Xp <= V + 19 then return Hi8 + 1
  next
  return 0

sub SetSpeed:
  V = Homes
  if V > MaxLv then V = MaxLv
  Lv = V
  T = 15 - Lv
  for Li = 0 to 4
    Ln[Li].Spd = LaneNum[Li] / T
  next
  return
end sub

' ---------------------------------------------------------------------------
' a lost penguin, a burrow reached

sub DeathAnim:
  if Cause = 3 then
    play sound SndBump
  else
    if Wet = 1 then
      play sound SndSplash
    else
      play sound SndBite
    end if
  end if
  Wt = 5
  for Ti = 1 to 45
    Frame1
    MoveRiver
    DrawRiver
    DrawSplash
  next
  dec Lives
  if Lives = 0 then Over = 1
  return
end sub

sub DrawSplash:
  T = 15
  if Wet = 0 then T = 6
  V = Py - 1
  if (Ti & 8) <> 0 then
    set sprite 0 to V,Px,SSplash,T
  else
    set sprite 0 to 207,0,0,0
  end if
  set sprite 1 to 207,0,0,0
  DrawRiverSprites
  update sprites
  return
end sub

sub HomeAnim:
  play sound SndHome
  ' 100 points for every unit of time left
  if Time > 0 then
    for Bi = 1 to Time
      Score += 100
    next
  end if
  DrawHome(Q)
  set sprite 0 to 207,0,0,0
  set sprite 1 to 207,0,0,0
  update sprites
  inc Homes
  SetSpeed
  ShowStatus
  Wt = 6
  for Ti = 1 to 40
    Frame1
    MoveRiver
    DrawRiver
    DrawRiverSprites
    update sprites
  next
  if CountHomes() = 3 then
    play sound SndClear
    Score += 1000
    ShowStatus
    for Ti = 1 to 60
      Frame1
    next
    for Ci = 0 to 2
      HomeF[Ci] = 0
      DrawHome(Ci)
    next
  end if
  return
end sub

function CountHomes as u8
  N = 0
  for Ci = 0 to 2
    N = N + HomeF[Ci]
  next
  return N

' ---------------------------------------------------------------------------
' input: both controllers together

sub GetInput:
  ReadPads
  OldJ = J
  J = Pads
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

sub NewGame:
  Score = 0
  Lives = 3
  Homes = 0
  Over = 0
  for Ci = 0 to 2
    HomeF[Ci] = 0
  next
  for Li = 0 to 4
    Ln[Li].Pos = 0
    Ln[Li].Frac = 0
    Ln[Li].Drawn = 1
  next
  SetSpeed
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawField:
  NewScreen
  ' cliff: snow cap and rock, three burrows
  fill TCap count 32 at 0,3
  for Y = 4 to 5
    for X = 0 to 31
      T = TRock
      if ((X + Y) & 2) <> 0 then T = TRock2
      put char T at X,Y
    next
  next
  for Ci = 0 to 2
    DrawHome(Ci)
  next
  fill TLip count 32 at 0,6
  for Y = 7 to 12
    DrawWater(Y, 0)
  next
  fill TShelft count 32 at 0,13
  fill TShelfb count 32 at 0,14
  for Y = 15 to 20
    DrawWater(Y, 1)
  next
  fill TBankt count 32 at 0,21
  fill TSnow count 32 at 0,22
  print at 2,2, "TIME"
  for Li = 0 to 3
    Ln[Li].Drawn = 1
    DrawLane(Li)
  next
  return
end sub

sub DrawWater(u8 Row, u8 Sh):
  for X = 0 to 31
    T = TDeep
    if ((X * 5 + Row * 3) & 7) = 2 then T = TDeepr
    if Sh = 1 then T = T + 2
    put char T at X,Row
  next
  return
end sub

' a burrow: the arch, then the hole or a penguin at home
sub DrawHome(u8 H):
  C = HomeCol[H]
  put char TArchl at C,3
  put char TArchm at C + 1,3
  put char TArchm at C + 2,3
  put char TArchr at C + 3,3
  fill THole count 4 at C,4
  fill THole count 4 at C,5
  if HomeF[H] = 1 then
    put char THome00 at C + 1,4
    put char THome01 at C + 2,4
    put char THome10 at C + 1,5
    put char THome11 at C + 2,5
  end if
  return
end sub

' a lane's two rows of water with its floes, built in RowB
sub DrawLane(u8 L):
  K = 0
  if L >= 2 then K = 1
  Y = LaneRow[L]
  Va = L * 64
  copy LaneBg + Va count 64 to RowB
  for Fi = 0 to NFloe - 1
    if FloeLane[Fi] = L then
      X = Ln[L].Pos + FloeBase[Fi]
      X = X & 254
      C = X >> 3
      T = TFloeBase + K * 24 + ((X & 7) >> 1) * 6
      for Bi = 0 to 2
        N = (C + Bi) & 31
        if N >= 2 and N <= 29 then
          RowB[N] = T + Bi
          RowB[N + 32] = T + 3 + Bi
        end if
      next
    end if
  next
  Va = Y * 32
  copy RowB count 64 to vram.name + Va
  return
end sub

' redraw the lanes whose floes moved to a new 2-pixel place
sub DrawRiver:
  ' one lane a frame at most, in turn (two copies of 64 bytes overran)
  for Li = 0 to 3
    RrL = (RrL + 1) & 3
    V = Ln[RrL].Pos & 254
    if V <> Ln[RrL].Drawn then
      Ln[RrL].Drawn = V
      DrawLane(RrL)
      return
    end if
  next
  return
end sub

sub DrawAll:
  DrawRiver
  DrawSprites
  return
end sub

sub DrawSprites:
  ' the penguin: walking on land, swimming in water (white over black)
  V = Py - 1
  if Wet = 1 then
    T = SSwim1w
  else
    T = SWalk1w
  end if
  if Ani = 1 then T = T + 8
  set sprite 0 to V,Px,T,15
  set sprite 1 to V,Px,T + 4,1
  DrawRiverSprites
  update sprites
  ' a soft paddle every 16 frames while swimming
  if Wet = 1 and Dir <> 0 then
    inc PadC
    if (PadC & 15) = 1 then play sound SndPaddle
  end if
  return
end sub

sub DrawRiverSprites:
  for Si = 0 to NShark - 1
    K = SharkLane[Si]
    X = Ln[K].Pos + SharkBase[Si]
    N = Si + 2
    if Shown(X) = 1 then
      Y = LaneY[K] - 1
      T = SSharkl1
      if LaneDir[K] = 1 then T = SSharkr1
      if (Tick & 16) <> 0 then T = T + 8
      set sprite N to Y,X,T,SharkCol[Si]
    else
      set sprite N to 207,0,0,0
    end if
  next
  X = Ln[4].Pos
  if Shown(X) = 1 then
    T = SSeal1
    if (Tick & 32) <> 0 then T = SSeal2
    set sprite 8 to SealY - 1,X,T,6
  else
    set sprite 8 to 207,0,0,0
  end if
  return
end sub

' row 1: score, high score, penguins left
sub ShowStatus:
  print at 2,1, "SCORE"
  print Score at 8,1
  print at 15,1, "HI"
  print Hi at 18,1
  for Ci = 0 to 2
    T = 32
    if Ci < Lives then T = TLife
    put char T at 27 + Ci,1
  next
  return
end sub

' row 2: the time bar, two units a cell
sub DrawBar:
  N = Time >> 1
  for Ci = 0 to 19
    T = 32
    if Ci < N then T = TBar
    BarB[Ci] = T
  next
  if (Time & 1) <> 0 then BarB[N] = TBarh
  copy BarB count 20 to vram.name + 71
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  for K = 0 to 8
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: PENGUINS in icy letters, a penguin on the bank watching a
' shark, the tune once

sub TitlePage:
  Wt = 1
  NewScreen
  for Y = 0 to 23
    fill TDeep count 32 at 0,Y
  next
  for Y = 0 to 3
    Va = Y * 32 + 132
    copy TitleMap + Y * TitleW count TitleW to vram.name + Va
  next
  print at 4,9, "GUIDE THE PENGUINS HOME"
  print at 7,11, "HI"
  print Hi at 10,11
  fill TShelft count 32 at 0,13
  fill TShelfb count 32 at 0,14
  DrawWater(15, 1)
  DrawWater(16, 1)
  put char TFloe1000 at 20,15
  put char TFloe1001 at 21,15
  put char TFloe1002 at 22,15
  put char TFloe1010 at 20,16
  put char TFloe1011 at 21,16
  put char TFloe1012 at 22,16
  fill TBankt count 32 at 0,17
  fill TSnow count 32 at 0,18
  print at 3,20, "STICK MOVES, BUTTON STOPS"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 432
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
  X = 16
tp_loop:
  Frame1
  ReadPads
  ' a shark crossing the pool, a penguin waddling on the bank
  inc X
  if X > MaxX then X = MinX
  T = SSharkr1
  if (Tick & 16) <> 0 then T = SSharkr2
  set sprite 2 to 119,X,T,1
  T = SWalk1w
  if (Tick & 16) <> 0 then T = SWalk2w
  set sprite 0 to 135,56,T,15
  set sprite 1 to 135,56,T + 4,1
  update sprites
  N = Pads & (Pads ^ OldPads)
  if (N & 16) <> 0 then goto tp_done
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "PENGUINS"
  print at 2,5, "BASED ON PENGUINS, AHOY!"
  print at 2,6, "OCTOBER 1986 (COMMODORE 64,"
  print at 2,7, "MACHINE CODE). THE AUTHOR"
  print at 2,8, "IS NOT NAMED ON THE DISK."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: WADDLE WALTZ"
  print at 2,19, "(ORIGINAL)"
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
PgPaddle:
    db $00,$00,$A5,$01,$00,$00,$D6,$02,$10
PgSplash:
    db $00,$00,$14,$03,$00,$00,$25,$04,$00,$00,$46,$06,$00,$00,$67,$0A,$10
PgBite:
    db $40,$FC,$11,$03,$40,$5D,$22,$03,$40,$F9,$22,$03,$40,$F9,$33,$04,$40,$FF,$53,$08,$50
PgBump:
    db $00,$00,$13,$02,$00,$00,$44,$04,$10
PgHome:
    db $40,$8F,$20,$04,$40,$71,$20,$04,$40,$5F,$20,$04,$40,$47,$30,$0A,$50
PgClear:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05
    db $40,$55,$20,$12,$50
PgStart:
    db $40,$AA,$30,$06,$40,$8F,$30,$06,$40,$71,$30,$0C,$50
PgOver:
    db $40,$1D,$21,$0C,$40,$41,$21,$0C,$40,$68,$21,$0C,$40,$AB,$31,$1E,$50
PgPick:
    db $40,$55,$40,$02,$50
PgTick:
    db $40,$35,$80,$01,$50

PgSoundTable:
    dw PgTuneMel,$702B
    dw PgTuneBass,$7035
    dw PgPaddle,$703F
    dw PgSplash,$703F
    dw PgBite,$7049
    dw PgBump,$703F
    dw PgHome,$7049
    dw PgClear,$7049
    dw PgStart,$7049
    dw PgOver,$7049
    dw PgPick,$7049
    dw PgTick,$7049
; Waddle Waltz (original)
; Tiny Sound, 9 frames per step
PgTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$24,$01,$28,$2B,$01,$28,$26,$01,$01,$23,$24,$26
    db $28,$01,$24,$21,$01,$01,$1F,$01,$21,$23,$01,$26,$29,$01,$28,$26
    db $01,$01,$24,$01,$28,$2B,$01,$2D,$2B,$01,$29,$28,$01,$26,$24,$01
    db $01,$00,$01,$01
    db $FF
PgTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$0C,$01,$13,$10,$01,$13,$07,$01,$0E,$07,$01,$0E
    db $0C,$01,$13,$05,$01,$0C,$07,$01,$0E,$07,$01,$0E,$07,$01,$0B,$07
    db $01,$0E,$0C,$01,$10,$0C,$01,$13,$05,$01,$09,$07,$01,$0B,$0C,$01
    db $01,$00,$01,$01
    db $FF
}
