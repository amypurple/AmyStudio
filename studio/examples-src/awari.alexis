  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$01,$01,$01,$03,$07,$F0,$80
  $01,$F0,$E0,$C0,$80,$80,$80,$06
  $00,$00,$00,$00,$00,$00,$00,$00
  $80,$F0,$07,$03,$01,$01,$01,$00
  $F0,$F0,$06,$00,$00,$00,$00,$00
