cartridge "JUMP/F.CICCARELLI-M.FERREIRA/1984"

' JUMP
' A ColecoVision game based on "Jump" by Fernando Ciccarelli and Marcel
' Ferreira, COMPUTE!'s Gazette, November 1984 (Commodore 64 and VIC-20,
' BASIC). Made for Amy Studio by Claude (an AI made by Anthropic), 2026,
' in Amy by Amy Bienvenu.
'
' The game: a Ryiad invader patrols the sky over your planet and drops
' bombs. Your laser base moves along the surface; shoot the Ryiad for 50
' points and 45 units of energy. Each bomb that lands damages the ground
' under it: first it cracks (still safe), then it leaves a crater, then a
' pit (another bomb into a pit costs 25 points). Walking or jumping onto
' a crater or pit, or being hit by a bomb, costs a base; three bases. Every
' step costs 5 energy, every shot 20; at zero energy the game is over.
' Jump over craters (two steps at once).
'
' From the original (orig/jump_64.bas, with the VIC-20 version): the field
' of two ground rows that bombs damage in stages (C64 characters 102, 230,
' then a hole, then the lower row), the base two cells wide moving two
' cells a step or jumping four, losing a base when either cell under it is
' a hole, the invader's random walk (a move of -30 to +24 pixels, drawn
' again when it would leave the screen) and its bomb when the draw is a
' big move left (chance grows with the level), the vertical laser, 50
' points and 45 energy a hit and a new place for the invader, energy 1000,
' 5 a step, 20 a shot, three bases, "OUT OF ENERGY !!", the base coming
' back at the first safe place from the left, the four levels and RANDOM.
'
' Liberties: smooth sprites (steps in 8 frames, jumps in 16 on an arc,
' laser and bombs that travel) instead of BASIC-speed moves; a jump costs
' 10 energy (free on the C64, 9 on the VIC-20) so it is not simply better
' than a step; a bomb into a pit costs 25 points as the magazine's text
' says (the C64 listing ended the game there, the VIC-20 one took 25); the
' invader bombs a little more often after every 8 hits (the original
' never got harder, so a patient player could farm it forever); if no
' safe place is left for a new base, the ground is rebuilt; a high score.
' The invader moves 1 pixel a frame (2 at PRO and EXPERT) and holds still
' while the laser flies (in BASIC it stood still while the beam was drawn);
' bombs fall 2 pixels a frame (3 at EXPERT), slow enough for a human to
' dodge after seeing them.
' "Battle again? (Y/N)" is replaced by the house end: message, then a
' press goes back to the title.
'
' Controls: either controller. Stick left/right: step. Right button (or
' stick up) with left/right: jump. Left button: fire. On the title, up and
' down choose, left and right change the level, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table; the title
' tune is played once. `set sprite count` always given. Nothing flashes.

const TSky = 128
const TStar1 = 129
const TStar2 = 130
const TStar3 = 131
const TG0 = 132
const TG1 = 133
const TG2 = 134
const TG3 = 135
const TH0 = 136
const TH3 = 137
const TRock = 138
const TBlk = 139
const SBase = 0
const SRyiad0 = 4
const SRyiad1 = 8
const SLaser = 12
const SBomb = 16
const SBoom0 = 20
const SBoom1 = 24
const NTiles8 = 96
const SprBytes = 224
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndJump = 4
const SndLaser = 5
const SndHit = 6
const SndBomb = 7
const SndCrack = 8
const SndDie = 9
const SndStart = 10
const SndOver = 11
const NSpr = 5
const GroundR = 19
const LowR = 20
const RockR = 21
const BaseY = 136
const EnY = 31
const LeftX = 16
const RightX = 208
const StepN = 8
const JumpN = 16
const DeadN = 70
const EnStart = 1000
const EnMax = 9999

record Shot:
  u8 X
  u8 Y
  u8 Live
end record

' the jump's height by frame
data JumpT bytes
  0, 4, 7, 10, 12, 14, 15, 16, 16, 15, 14, 12, 10, 7, 4, 0
end data

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 En = 1000
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u8 Lives = 3
u8 Lvl = 1
u8 P1 = 1
u8 Heat = 0
u8 Hits = 0
u8 Over = 0
u8 GState = 0
' the base: cell (left of its two), pixel X, frames left of a move,
' direction (pixels a frame), jump frame (0: walking)
u8 Pa = 2
u8 Px = 16
u8 Pm = 0
i8 Pdx = 0
u8 Pj = 0
u8 Py = BaseY
u8 DeadT = 0
' the invader: X, target X, frames before it comes back, animation
u8 Ex = 120
u8 Et = 120
u8 EdT = 0
Shot Ls
Shot Eb
u8 BombSp = 2
u8 Esp = 1
' the ground: 0 intact, 1 cracked, 2 crater, 3 pit (columns 2-29)
u8 Gs[28]
' input
u8 J1 = 0
u8 J2 = 0
u8 Jb = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Fire1 = 0
u8 WasF1 = 0
u8 FireP = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 Ci = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table GjSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  GState = 3
  if Sc > Hi then Hi = Sc
  ShowHud
  mute all
  if Over = 2 then
    print at 7,9, "                  "
    print at 7,10, " OUT OF ENERGY !! "
  end if
  print at 7,11, "                  "
  print at 7,12, "    GAME  OVER    "
  print at 7,13, "                  "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveEnemy
  MoveLaser
  MoveBomb
  if DeadT > 0 then
    dec DeadT
    if DeadT = 0 then
      dec Lives
      ShowHud
      if Lives = 0 then
        Over = 1
        return
      end if
      Respawn
    end if
    return
  end if
  if Pm > 0 then
    MoveBase
    return
  end if
  Controls
  return
end sub

' the stick and buttons while the base stands still
sub Controls:
  if FireP = 1 then
    if Ls.Live = 0 then
      Ls.Live = 1
      Ls.X = Px
      Ls.Y = BaseY - 8
      Spend(20)
      play sound SndLaser
      if Over > 0 then return
    end if
  end if
  K = Jb & 12
  if K = 0 then return
  ' a jump: right button or stick up with a direction
  T = Jb & 33
  if T > 0 then
    if K = 8 then
      if Pa <= 24 then StartMove(4, 2)
    elseif K = 4 then
      if Pa >= 6 then StartMove(4, -2)
    end if
    return
  end if
  if K = 8 then
    if Pa <= 26 then StartMove(2, 2)
  elseif K = 4 then
    if Pa >= 4 then StartMove(2, -2)
  end if
  return
end sub

' Cells: 2 (step) or 4 (jump); D: pixels a frame
sub StartMove(u8 Cells, i8 D)
  Pdx = D
  if D > 0 then
    Pa = Pa + Cells
  else
    Pa = Pa - Cells
  end if
  if Cells = 4 then
    Pm = JumpN
    Pj = 1
    Spend(10)
    play sound SndJump
  else
    Pm = StepN
    Pj = 0
    Spend(5)
    play sound SndStep
  end if
end sub

sub Spend(u8 Amount)
  W16 = Amount
  if En > W16 then
    En = En - W16
  else
    En = 0
    Over = 2
  end if
  ShowEnergy
end sub

sub MoveBase:
  Px = Px + Pdx
  dec Pm
  if Pj = 1 then
    V = JumpN - 1 - Pm
    Py = BaseY - JumpT[V]
  end if
  if Pm > 0 then return
  Py = BaseY
  Pj = 0
  if Footing(Pa) = 0 then Fall
  return
end sub

' 1 when the two cells from column A hold the base (intact or cracked)
function Footing(u8 A) as u8
  u8 I = A - 2
  if Gs[I] >= 2 then return 0
  if Gs[I + 1] >= 2 then return 0
  return 1

sub Fall:
  DeadT = DeadN
  Pm = 0
  play sound SndDie
  return
end sub

' the first safe place from the left (0: none)
function FindSafe as u8
  u8 A = 2
  while A <= 28
    if Footing(A) = 1 then return A
    A = A + 2
  end while
  return 0

sub Respawn:
  Pa = FindSafe
  if Pa = 0 then
    for Ci = 0 to 27
      Gs[Ci] = 0
    next
    DrawGround
    Pa = 2
  end if
  Px = Pa << 3
  Py = BaseY
  Pm = 0
  return
end sub

sub MoveLaser:
  if Ls.Live = 0 then return
  if Ls.Y < 32 then
    Ls.Live = 0
    return
  end if
  Ls.Y = Ls.Y - 16
  if EdT > 0 then return
  ' laser pixels: X+7..X+8, Y+1..Y+16; the Ryiad: X..X+15, rows 2..11
  X = Ls.X + 8
  if X <= Ex then return
  V = Ex + 16
  if X >= V then return
  V = EnY + 13
  if Ls.Y >= V then return
  V = Ls.Y + 17
  T = EnY + 3
  if V <= T then return
  ' a hit
  Ls.Live = 0
  EdT = 40
  Sc += 50
  inc Hits
  V = Hits >> 3
  if V > 6 then V = 6
  Heat = V
  W16 = En + 45
  if W16 > EnMax then W16 = EnMax
  En = W16
  ShowHud
  play sound SndHit
  return
end sub

sub MoveEnemy:
  if EdT > 0 then
    dec EdT
    if EdT = 0 then
      ' a new place, 40-238 on the C64
      V = Rnd % 96
      Ex = V << 1
      Ex = Ex + LeftX
      Et = Ex
    end if
    return
  end if
  ' (in BASIC the invader stood still while the laser was drawn)
  if Ls.Live = 1 then return
  if Ex = Et then
    EnemyThink
    return
  end if
  if Ex < Et then
    Ex = Ex + Esp
  else
    Ex = Ex - Esp
  end if
  return
end sub

' the C64's random walk: a move of -30 to +24; a big move left is a bomb
sub EnemyThink:
  i16 Nx = 0
  u8 R = 0
  u8 Chance = 0
  R = Rnd % 55
  Chance = P1 + 1 + Heat
  if R < Chance then
    if DeadT = 0 then
      if Eb.Live = 0 then
        Eb.Live = 1
        Eb.X = Ex
        Eb.Y = EnY + 10
        play sound SndBomb
      end if
    end if
  end if
  if R < Chance then return
  R = R & 254
  Nx = Ex + R - 30
  if Nx < LeftX then return
  if Nx > RightX then return
  Et = Nx
end sub

sub MoveBomb:
  if Eb.Live = 0 then return
  Eb.Y = Eb.Y + BombSp
  ' bomb pixels X+5..X+10, Y+2..Y+8; the base X+0..X+15, rows 4..14
  if DeadT = 0 then
    V = Eb.Y + 8
    T = Py + 5
    if V >= T then
      V = Eb.Y + 2
      T = Py + 15
      if V <= T then
        V = Eb.X + 10
        T = Eb.X + 5
        X = Px + 15
        if V >= Px then
          if T <= X then
            Eb.Live = 0
            Fall
            return
          end if
        end if
      end if
    end if
  end if
  if Eb.Y < 144 then return
  Eb.Live = 0
  ' the ground under the bomb's middle
  C = Eb.X + 8
  C = C >> 3
  if C < 2 then C = 2
  if C > 29 then C = 29
  select case Gs[C - 2]
  case 0 to 2
    inc Gs[C - 2]
  case else
    Sc -= 25
    ShowHud
  end select
  DrawCell(C)
  play sound SndCrack
  return
end sub

function Rnd as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs & 255

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  if GState = 2 then
    if DeadT > 0 then
      V = DeadT >> 3
      V = V & 1
      K = SBoom0
      if V = 1 then K = SBoom1
      Y = Py - 1
      set sprite 0 to Y,Px,K,10
    else
      Y = Py - 1
      set sprite 0 to Y,Px,SBase,11
    end if
  else
    set sprite 0 to 192,0,0,0
  end if
  if Ls.Live = 1 then
    set sprite 1 to Ls.Y,Ls.X,SLaser,15
  else
    set sprite 1 to 192,0,0,0
  end if
  if Eb.Live = 1 then
    set sprite 2 to Eb.Y,Eb.X,SBomb,9
  else
    set sprite 2 to 192,0,0,0
  end if
  if GState = 1 then
    ' (the title: the invader would cover the big word)
    set sprite 3 to 192,0,0,0
  elseif EdT > 0 then
    if EdT > 24 then
      V = EdT >> 2
      V = V & 1
      K = SBoom0
      if V = 1 then K = SBoom1
      set sprite 3 to EnY,Ex,K,10
    else
      set sprite 3 to 192,0,0,0
    end if
  else
    V = Tick >> 4
    V = V & 1
    K = SRyiad0
    if V = 1 then K = SRyiad1
    set sprite 3 to EnY,Ex,K,13
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SC"
  print at 5,1, Sc
  print at 12,1, "LIVES"
  NumU = Lives
  print at 18,1, digits$(NumU, 1)
  ShowEnergy
  return
end sub

sub ShowEnergy:
  print at 21,1, "EN"
  NumU = En
  print at 24,1, digits$(NumU, 4)
  return
end sub

sub DrawCell(u8 Col)
  u8 S = Gs[Col - 2]
  select case S
  case 0
    put char TG0 at Col,GroundR
    put char TH0 at Col,LowR
  case 1
    put char TG1 at Col,GroundR
    put char TH0 at Col,LowR
  case 2
    put char TG2 at Col,GroundR
    put char TH0 at Col,LowR
  case else
    put char TG3 at Col,GroundR
    put char TH3 at Col,LowR
  end select
end sub

sub DrawGround:
  for Ci = 2 to 29
    DrawCell(Ci)
  next
  fill TRock count 28 at 2,RockR
  return
end sub

sub DrawSky:
  for Ri = 2 to 18
    for Ci = 2 to 29
      V = Ci * 7
      T = Ri * 13
      V = V + T
      V = V & 31
      if V < 3 then
        T = TStar1 + V
        put char T at Ci,Ri
      end if
    next
  next
  return
end sub

sub NewGame:
  Sc = 0
  Lives = 3
  En = EnStart
  Hits = 0
  Heat = 0
  P1 = Lvl
  if Lvl = 5 then P1 = Rnd % 4 + 1
  BombSp = P1 >> 2
  BombSp = BombSp + 2
  Esp = 1
  if P1 > 2 then Esp = 2
  for Ci = 0 to 27
    Gs[Ci] = 0
  next
  NewScreen
  DrawSky
  DrawGround
  ShowHud
  Pa = 2
  Px = 16
  Py = BaseY
  Pm = 0
  DeadT = 0
  Ex = 120
  Et = 120
  EdT = 0
  Ls.Live = 0
  Eb.Live = 0
  Over = 0
  GState = 2
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Jb = J1 | J2
  Btn = Jb & 48
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Fire1 = Jb & 16
  FireP = 0
  if Fire1 > 0 then
    if WasF1 = 0 then FireP = 1
  end if
  WasF1 = Fire1
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the big word, the authors, START GAME / LEVEL / CREDITS
sub TitlePage:
  GState = 1
  NewScreen
  DrawSky
  for Ci = 0 to 27
    Gs[Ci] = 0
  next
  DrawGround
  for Ri = 0 to 4
    for Ci = 0 to LogoW - 1
      J = Ri * LogoW
      J = J + Ci
      if LogoT[J] = 1 then
        X = LogoC + Ci
        Y = LogoR + Ri
        put char TBlk at X,Y
      end if
    next
  next
  print at 5,9, "BY FERNANDO CICCARELLI"
  print at 6,10, "AND MARCEL FERREIRA"
  print at 9,12, "START GAME"
  print at 9,13, "LEVEL"
  print at 9,14, "CREDITS"
  print at 2,16, "COMPUTE!'S GAZETTE NOV 1984"
  print at 2,1, "HI"
  print at 5,1, Hi
  Menu = 0
  ShowMenu
  ShowLevel
  Ex = 120
  Et = 120
  EdT = 0
  Esp = 1
  Ls.Live = 0
  Eb.Live = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  MoveEnemy
  DrawSprites
  V = Jb & 15
  if V > 0 then
    if WasStick = 0 then MenuKey
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub MenuKey:
  select case V
  case 1
    if Menu > 0 then dec Menu
  case 2
    if Menu < 2 then inc Menu
  case 4
    if Menu = 1 then
      dec Lvl
      if Lvl = 0 then Lvl = 5
    end if
  case 8
    if Menu = 1 then
      inc Lvl
      if Lvl > 5 then Lvl = 1
    end if
  end select
  ShowMenu
  ShowLevel
end sub

sub ShowMenu:
  for J = 12 to 14
    put char 32 at 7,J
  next
  J = Menu + 12
  put char 62 at 7,J
  return
end sub

sub ShowLevel:
  select case Lvl
  case 1
    print at 15,13, "BEGINNER"
  case 2
    print at 15,13, "ROOKIE  "
  case 3
    print at 15,13, "PRO     "
  case 4
    print at 15,13, "EXPERT  "
  case else
    print at 15,13, "RANDOM  "
  end select
  return
end sub

sub CreditsPage:
  GState = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "JUMP"
  print at 2,5, "BASED ON JUMP BY FERNANDO"
  print at 2,6, "CICCARELLI AND MARCEL"
  print at 2,7, "FERREIRA, COMPUTE!'S GAZETTE"
  print at 2,8, "NOVEMBER 1984 (C64, VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: RYIAD PATROL"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$04,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$40,$00,$00
  $00,$00,$00,$00,$02,$00,$00,$00
  $00,$A5,$AA,$00,$20,$02,$40,$00
  $10,$18,$08,$08,$14,$22,$40,$40
  $00,$00,$00,$81,$C3,$18,$00,$40
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$08,$40,$01,$10,$00,$82,$00
  $00,$00,$81,$C3,$18,$00,$42,$00
  $00,$08,$40,$02,$10,$80,$04,$00
  $01,$40,$01,$01,$01,$01,$01,$00
end data
data TileCol bytes
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$F1,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$51,$01,$01
  $01,$01,$01,$01,$E1,$01,$01,$01
  $02,$32,$C2,$0A,$EA,$EA,$EA,$0A
  $12,$12,$1C,$1A,$1A,$1A,$EA,$1A
  $01,$01,$01,$A1,$A1,$1A,$0A,$EA
  $01,$01,$01,$01,$01,$01,$01,$01
  $0A,$EA,$EA,$EA,$EA,$0A,$EA,$0A
  $01,$01,$A1,$A1,$1A,$0A,$EA,$0A
  $0E,$4E,$4E,$4E,$4E,$4E,$4E,$0E
  $AB,$FB,$AB,$AB,$AB,$AB,$AB,$0A
end data
data SpritePat bytes
  $00,$00,$00,$00,$01,$01,$01,$03,$07,$1F,$3F,$7F,$FF,$6D,$24,$00
  $00,$00,$00,$00,$80,$80,$80,$C0,$E0,$F8,$FC,$FE,$FF,$B6,$92,$00
