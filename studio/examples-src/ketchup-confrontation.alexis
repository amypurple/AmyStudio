cartridge "KETCHUP CONFRONTATION/C. ADAMS & B. KAPILIK/1989"
' INTER-STELLAR KETCHUP CONFRONTATION
' Original: Colin Adams & Brett Kapilik, Ahoy! (July 1989), C64 machine
' language, ReRUN disk 1989-07-08. ColecoVision port in Amy.
'
' The rules, from the original's 6502 code (orig/k.dis):
' - one main-loop pass of the original = one unit; this port runs Passes
'   of them per frame (measured: 211 C64 cycles a pass, ~14400 free
'   cycles a frame -> 68 passes a frame)
' - the stick is read every 20 passes: 1 px left/right (X 25..235);
'   fire (held = auto fire) launches the one ketchup drop at the bottle,
'   which climbs 1 px every 10 passes until it leaves the top
' - three Killer Fries fall 1 px every FDel passes (30, then -3 a level),
'   two Psycho Burgers every BDel (25, -3 a level); one that wraps past
'   the bottom (Y back to 0) comes back at a new random X (25..234)
' - drop hits a fry: 20 points; a burger: 30 points and TO GO - 1
' - TO GO 0: next level, +1 life, TO GO = 10 x level
' - a fry or burger touching the bottle: -1 life (4 at the start)
' Positions are kept in the original's C64 sprite units and only scaled
' for drawing (X - 12, Y about 4/5): same play-field, same speeds.

const TStar1 = 128
const TStar2 = 129
const TStar3 = 130
const TLife = 131
const TDrip = 132
const SLabel = 0
const SBottle = 4
const SDrop = 8
const SSplat = 12
const SFry = 16
const SBurger = 20
const NTiles8 = 40
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndTuneD = 4
const SndPlayA = 5
const SndPlayB = 6
const SndPlayC = 7
const SndPlayD = 8
const SndClick = 9
const SndShot = 10
const SndSplat = 11
const SndDie = 12
const SndLevel = 13
const SndOver = 14
const TuneFrames = 448
const PlayFrames = 1024
const TxtCredits = 0
const NSpr = 9
const HideY = 192
const Passes = 68
const PlayerY = 208
' game states, read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StWait = 5
const StOver = 9

u8 FX[3]
u8 FY[3]
u8 BX[2]
u8 BY[2]
u16 Score = 0
u16 Rs = 1
u16 W16 = 0
u16 W2 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u16 PlayLeft = 0
' original pass counters (u16: they start at 256 like the 6502's 0)
u16 JcC = 0
u16 ScC = 0
u16 FcC = 0
u16 BcC = 0
u16 TcC = 0
u16 TcD = 0
u16 TcN = 0
u16 Ax = 0
u16 Ay = 0
u16 Bx2 = 0
u16 By2 = 0
u16 Ex0 = 0
u16 Ex1 = 0
u16 Ey0 = 0
u16 Ey1 = 0
u8 TzOn = 0
u8 PlayOn = 0
u8 State = 0
u8 Lives = 0
u8 Level = 0
u8 ToGo = 0
u8 ToGoNext = 0
u8 FDel = 0
u8 BDel = 0
u8 PX = 0
u8 SX = 0
u8 SY = 0
u8 ShotOn = 0
u8 Want = 0
u8 ExX = 0
u8 ExY = 0
u8 ExT = 0
u8 Hit = 0
u8 HitK = 0
u8 Dead = 0
u8 Done = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never used by helper subs)
u8 Oi = 0
u8 Li = 0
u8 Ni = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Dx = 0
u8 Dc = 0
u8 JN = 0
u8 SN = 0
u8 Dy = 0
' packed text decoder (kit/textpack.mjs)
u16 TxP = 0
u16 TxQ = 0
u16 TxW = 0
u8 TxC = 0
u8 TxL = 0
u8 TxX = 0
u8 TxY = 0
u8 TxX0 = 0
u8 TxF = 0
u8 TxT = 0
u8 TxGap = 2

  tile screen
  set sound table ScSoundTable areas 8
  sprites 16x16
  nmi off
  decompress zx0 SpritePatZ to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Dead = 1 then
    LoseLife
    if Lives = 0 then
      ' the last splat stays one second before GAME OVER
      for Oi = 1 to 60
        Frame1
      next
      goto game_over
    end if
    WaitPress
    StartRound
  end if
  if Done = 1 then
    LevelDone
    WaitPress
    StartRound
  end if
  goto play_loop

game_over:
  GameOver
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift: stepped every title frame, so each game is different
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new X for a fry or burger: 25..234 (the original rejects SID noise
' bytes outside that range)
function RandX() as u8
  u8 Rv = 0
  Rand
  W16 = Rs % 210
  Rv = W16
  Rv += 25
  return Rv

sub NewGame:
  Score = 0
  Lives = 4
  Level = 1
  ToGo = 10
  ToGoNext = 10
  FDel = 30
  BDel = 25
  JcC = 256
  ScC = 256
  FcC = 256
  BcC = 256
  PlayMusic
  StartRound
  return
end sub

' the original's restart (C00C): every fry and burger back at Y 0, the
' bottle in the middle, no drop
sub StartRound:
  fill array FX with 0
  fill array FY with 0
  fill array BX with 0
  fill array BY with 0
  PX = 125
  ShotOn = 0
  Want = 0
  ExT = 0
  Dead = 0
  Done = 0
  DrawPlay
  State = StPlay
  return
end sub

' how many times a pass counter (TcC, reload TcD) reaches 0 in Passes
' passes: TcN; TcC is left as the 6502's counter would be
sub Ticks:
  if TcC > Passes then
    TcC -= Passes
    TcN = 0
    return
  end if
  ' (subtraction, not u16 '/' and '%': ~1600 cycles each, profiled)
  W16 = Passes - TcC
  TcN = 1
tk_sub:
  if W16 >= TcD then
    W16 -= TcD
    inc TcN
    goto tk_sub
  end if
  TcC = TcD - W16
  return
end sub

' one frame = Passes passes of the original's main loop
sub PlayStep:
  ' the stick, read every 20 passes (C136)
  TcC = JcC
  TcD = 20
  Ticks
  JcC = TcC
  JN = TcN
  if TcN > 0 then
    Want = 0
    V = Btn
    if V > 0 then Want = 1
    V = Jk & 4
    if V > 0 then
      for Ni = 1 to 6
        if Ni <= TcN then
          if PX >= 25 then dec PX
        end if
      next
    end if
    V = Jk & 8
    if V > 0 then
      for Ni = 1 to 6
        if Ni <= TcN then
          if PX < 235 then inc PX
        end if
      next
    end if
  end if
  ' the drop (C307): launched at the bottle, 1 px up every 10 passes
  if ShotOn = 0 then
    if Want = 1 then
      ShotOn = 1
      SX = PX
      SY = PlayerY
      play sound SndShot
    end if
  else
    TcC = ScC
    TcD = 10
    Ticks
    ScC = TcC
    SN = TcN
    if TcN >= SY then
      ShotOn = 0
    else
      T = TcN
      SY -= T
    end if
  end if
  ' the fries (C357)
  TcC = FcC
  TcD = FDel
  Ticks
  FcC = TcC
  for Ni = 1 to 12
    if Ni <= TcN then FryTick
  next
  ' the burgers (C3C6)
  TcC = BcC
  TcD = BDel
  Ticks
  BcC = TcC
  for Ni = 1 to 12
    if Ni <= TcN then BurgerTick
  next
  ' the splat stays 256 passes (C033)
  if ExT > 0 then dec ExT
  ' the original checks the bottle first (C18F) and leaves the loop on a
  ' hit, so the drop's check (C40C) does not run then
  BottleHits
  if Dead = 0 then ShotHits
  DrawSprites
  return
end sub

sub FryTick:
  if FY[0] = 0 then
    FX[0] = RandX()
    FY[0] = 10
    return
  end if
  if FY[1] = 0 then
    FX[1] = RandX()
    FY[1] = 5
    return
  end if
  if FY[2] = 0 then
    FX[2] = RandX()
    FY[2] = 1
    return
  end if
  for J = 0 to 2
    FY[J] = FY[J] + 1
  next
  return
end sub

sub BurgerTick:
  if BY[0] = 0 then
    BX[0] = RandX()
    BY[0] = 7
    return
  end if
  if BY[1] = 0 then
    BX[1] = RandX()
    BY[1] = 3
    return
  end if
  BY[0] = BY[0] + 1
  BY[1] = BY[1] + 1
  return
end sub

' box overlap of A (Ax..Bx2, Ay..By2) and E (Ex0..Ex1, Ey0..Ey1), both
' clipped to the C64's visible rows 50..249 -> Hit
sub Overlap:
  Hit = 0
  if Ex0 > Bx2 then return
  if Ax > Ex1 then return
  if Ey0 > By2 then return
  if Ay > Ey1 then return
  ' the overlap's rows must be on the visible screen
  W16 = Ay
  if Ey0 > W16 then W16 = Ey0
  W2 = By2
  if Ey1 < W2 then W2 = Ey1
  if W2 < 50 then return
  if W16 > 249 then return
  Hit = 1
  return
end sub

' the drop against fries (20) and burgers (30); first hit only
sub ShotHits:
  if ShotOn = 0 then return
  Ax = SX
  Ax += 9
  Bx2 = SX
  Bx2 += 15
  Ay = SY
  Ay += 2
  By2 = SY
  By2 += 23
  for Oi = 0 to 2
    Ex0 = FX[Oi]
    Ex1 = Ex0
    Ex1 += 19
    Ey0 = FY[Oi]
    Ey0 += 4
    Ey1 = FY[Oi]
    Ey1 += 35
    Overlap
    if Hit = 1 then
      ExX = FX[Oi]
      ExY = FY[Oi]
      FY[Oi] = 0
      Score += 20
      Killed
      return
    end if
  next
  for Oi = 0 to 1
    Ex0 = BX[Oi]
    Ex1 = Ex0
    Ex1 += 23
    Ey0 = BY[Oi]
    Ey0 += 10
    Ey1 = BY[Oi]
    Ey1 += 25
    Overlap
    if Hit = 1 then
      ExX = BX[Oi]
      ExY = BY[Oi]
      BY[Oi] = 0
      Score += 30
      dec ToGo
      Killed
      if ToGo = 0 then Done = 1
      return
    end if
  next
  return
end sub

sub Killed:
  ShotOn = 0
  ExT = 4
  play sound SndSplat
  ShowHud
  return
end sub

' a fry or burger touching the bottle
sub BottleHits:
  Ax = PX
  Ax += 6
  Bx2 = PX
  Bx2 += 17
  Ay = 210
  By2 = 249
  for Oi = 0 to 2
    Ex0 = FX[Oi]
    Ex1 = Ex0
    Ex1 += 19
    Ey0 = FY[Oi]
    Ey0 += 4
    Ey1 = FY[Oi]
    Ey1 += 35
    Overlap
    if Hit = 1 then Dead = 1
  next
  for Oi = 0 to 1
    Ex0 = BX[Oi]
    Ex1 = Ex0
    Ex1 += 23
    Ey0 = BY[Oi]
    Ey0 += 10
    Ey1 = BY[Oi]
    Ey1 += 25
    Overlap
    if Hit = 1 then Dead = 1
  next
  return
end sub

sub LoseLife:
  dec Lives
  ExX = PX
  ExY = PlayerY
  ExT = 255
  ShotOn = 0
  DrawSprites
  play sound SndDie
  ShowHud
  return
end sub

' TO GO 0 (C520): next level, faster fries and burgers, +1 life
sub LevelDone:
  inc Level
  if FDel > 5 then FDel -= 3
  if BDel > 5 then BDel -= 3
  inc Lives
  ToGoNext += 10
  ToGo = ToGoNext
  ShotOn = 0
  DrawSprites
  ShowHud
  print at 8,11, "LEVEL COMPLETED"
  play sound SndLevel
  return
end sub

' after a lost life or a level: the original waits for the button
sub WaitPress:
  State = StWait
  print at 9,13, "PRESS BUTTON"
  WasBtn = 16
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' C64 sprite X -> screen X (16..223). C64 Y (top of a 42-line, Y-expanded
' sprite) + Dc (the middle of its picture) -> the middle of our 16-line
' sprite at 4/5 scale, kept between the HUD rows (sprite rows 16..174).
' Shown for C64 Y 11..245 (11: past the respawn values 1..10; 245: the
' last Y that can still touch the bottle)
sub ScreenXY:
  if Dx < 28 then
    Dx = 16
  else
    Dx -= 12
  end if
  if Dx > 223 then Dx = 223
  if Dy < 11 then
    Dy = HideY
    return
  end if
  if Dy > 245 then
    Dy = HideY
    return
  end if
  W16 = Dy
  W16 += Dc
  W16 = W16 * 51
  W16 = W16 >> 6
  if W16 < 48 then
    Dy = 15
    return
  end if
  W16 -= 32
  Dy = W16
  if Dy > 158 then Dy = 158
  return
end sub

sub DrawSprites:
  Dx = PX
  Dy = PlayerY
  Dc = 22
  ScreenXY
  if Lives = 0 then Dy = HideY
  set sprite 0 to Dy,Dx,SLabel,15
  set sprite 1 to Dy,Dx,SBottle,8
  Dy = HideY
  if ShotOn = 1 then
    Dx = SX
    Dy = SY
    Dc = 12
    ScreenXY
  end if
  set sprite 2 to Dy,Dx,SDrop,8
  Dy = HideY
  if ExT > 0 then
    Dx = ExX
    Dy = ExY
    Dc = 20
    ScreenXY
  end if
  set sprite 3 to Dy,Dx,SSplat,9
  for Li = 0 to 2
    Dx = FX[Li]
    Dy = FY[Li]
    Dc = 20
    ScreenXY
    C = Li + 4
    set sprite C to Dy,Dx,SFry,11
  next
  for Li = 0 to 1
    Dx = BX[Li]
    Dy = BY[Li]
    Dc = 18
    ScreenXY
    C = Li + 7
    set sprite C to Dy,Dx,SBurger,10
  next
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  print at 21,1, "LEVEL"
  NumU = Level
  print at 27,1, digits$(NumU, 2)
  print at 2,22, "LIVES"
  NumU = Lives
  print at 8,22, digits$(NumU, 2)
  print at 20,22, "TO GO"
  NumU = ToGo
  print at 26,22, digits$(NumU, 3)
  return
end sub

' the original's star field: a regular grid of green dots, every other
' row of dots shifted by half a step
sub DrawStars:
  for Li = 0 to 4
    T = Li << 2
    T += 3
    for Ni = 0 to 6
      C = Ni << 2
      C += 3
      put char TStar1 at C,T
      V = T + 2
      if V < 22 then
        C += 2
        put char TStar1 at C,V
      end if
    next
  next
  return
end sub

sub DrawPlay:
  NewScreen
  DrawStars
  ShowHud
  ShowScreen
  DrawSprites
  return
end sub

sub GameOver:
  stop sound SndPlayA
  stop sound SndPlayB
  stop sound SndPlayC
  stop sound SndPlayD
  PlayOn = 0
  HideSprites
  print at 11,10, "GAME OVER"
  print at 9,12, "SCORE"
  NumU = Score
  print at 15,12, digits$(NumU, 5)
  print at 9,14, "PRESS BUTTON"
  play sound SndOver
  return
end sub

' the quiet in-game tune (tune.py, ScPlay*), restarted when it ends
sub PlayMusic:
  play sound SndPlayA
  play sound SndPlayB
  play sound SndPlayC
  play sound SndPlayD
  PlayLeft = PlayFrames
  PlayOn = 1
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

' before every wait: the tune's countdown, then the NMI armed
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndTuneC
      stop sound SndTuneD
      TzOn = 0
    end if
  end if
  if PlayOn = 1 then
    dec PlayLeft
    if PlayLeft = 0 then PlayMusic
  end if
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs only during the wait (Idle = 1 tells the bots
' the pass is over)
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' both controllers; Jk = directions held (1 up, 2 down, 4 left, 8 right),
' Edge = directions newly pressed, Press = button newly pressed
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' clear sprites zeroes every entry (Y=0 is ON screen): set the count again
' and park every sprite at HideY with colour 0
sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: wait for the frame, NMI off, display off, load
' the tiles into the three screen thirds, clear
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  ' art packed with ZX0 (pack.mjs); unpacked with the display off
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: banner, name, menu (cursor back on START), the tune once
sub TitlePage:
  State = StTitle
  NewScreen
  DrawStars
  fill TDrip count 28 at 2,1
  print at 4,4, "INTER-STELLAR KETCHUP"
  print at 9,6, "CONFRONTATION"
  print at 6,8, "C. ADAMS & B. KAPILIK"
  set sprite 1 to 119,40,SBottle,8
  set sprite 0 to 119,40,SLabel,15
  set sprite 4 to 79,40,SFry,11
  set sprite 7 to 99,40,SBurger,10
  update sprites
  print at 11,12, "START"
  print at 11,14, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 7,20, "AHOY! 1989   C64"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzLeft = TuneFrames
  TzOn = 1
  WasBtn = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  put char 32 at 9,16
  C = Menu << 1
  C += 12
  put char 62 at 9,C
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  print at 9,2, "CREDITS"
  TxT = TxtCredits
  TxX0 = 2
  TxY = 4
  TxGap = 2
  TextShow
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

' HOW TO PLAY: two pages, pictures made of the game's own sprites
sub HowTo:
  State = StHow
  Page = 1
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "THE GOOD GUY: OUR HERO"
  set sprite 1 to 39,120,SBottle,8
  set sprite 0 to 39,120,SLabel,15
  set sprite 2 to 31,136,SDrop,8
  print at 2,9, "THE BAD GUYS:"
  set sprite 4 to 87,40,SFry,11
  print at 9,11, "KILLER FRY"
  print at 9,13, "20 POINTS"
  set sprite 7 to 119,40,SBurger,10
  print at 9,15, "PSYCHO BURGER"
  print at 9,17, "30 POINTS"
  print at 8,21, "PRESS THE BUTTON"
  update sprites
  PageWait
  if TimedOut = 0 then
    Page = 2
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "STICK LEFT/RIGHT MOVES"
    print at 2,5, "THE BOTTLE. THE BUTTON"
    print at 2,7, "SQUIRTS KETCHUP UP."
    print at 2,9, "DON'T LET THEM TOUCH YOU."
    print at 2,11, "SHOOT TO GO BURGERS TO"
    print at 2,13, "CLEAR A LEVEL: +1 LIFE,"
    print at 2,15, "AND THEY FALL FASTER."
    print at 2,17, "FOUR LIVES TO START."
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSprites
  return
end sub

' --- packed text: TxT = message, TxX0/TxY = first cell, TxGap = row step
sub TextShow:
  TxP = TxMsg[TxT]
  TxX = TxX0
  TxF = 1
ts_word:
  TxC = peek(TxP)
  TxP += 1
  if TxC = 255 then goto ts_end
  if TxC = 254 then
    TxY += TxGap
    TxX = TxX0
    TxF = 1
    goto ts_word
  end if
  TxW = TxC
