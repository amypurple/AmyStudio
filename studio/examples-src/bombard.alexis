cartridge "BOMBARDMENT/COMPUTE GAZETTE/1989"

' BOMBARDMENT
' A ColecoVision game based on "Bombardment", COMPUTE!'s Gazette January
' 1989 (Commodore 64 machine language at $C000, loaded and started with
' SYS 49152 by the disk's BOMBARDMENT.BOOT; no author is named in the
' program, on the disk or in the issue's contents we could reach). Made for
' Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu.
'
' The game: two players, BLACK and WHITE, in a walled arena. Each throws
' bombs the way he faces; bombs never stop: they bounce off the walls,
' knock each other into new directions and fill the arena. A bomb that
' reaches a player, or a player who walks into a bomb, costs a life and
' starts a new round in a clean arena. Five lives each; the last one
' standing wins.
'
' From the original (orig/bombard.dis, watched in jsc64):
' - the arena: an outer wall and four inner walls (the middle of the top
'   and bottom walls, two long walls left and right), players start facing
'   each other on the middle row;
' - eight directions; pushing the stick toward a new direction first turns
'   the player, pushing it again walks; a wall or the other player blocks;
' - each player acts every 4 passes of the C64's loop (here every 6 frames,
'   the speed measured in jsc64), and every 10 passes after a throw (15);
' - the button throws a bomb into the next cell in the direction pushed (or
'   faced), only if that cell is empty;
' - a bomb thrown while the player walked flies at the player's speed, one
'   thrown standing at half speed;
' - bombs in walls: the side walls and the inner walls (C64 char $62) send
'   a bomb back left/right (straight up or down: back), the top and bottom
'   walls ($63) up/down (straight left or right: back); the bomb stays put
'   for that move;
' - two bombs meeting both turn to a new direction from the C64's counter
'   (C872 = (C872 + 2) AND 7 + 1, once for each);
' - a bomb moving into a player, or a player walking into a bomb: that
'   player loses a life, the round ends (both can lose in one pass); five
'   lives; "BLACK PLAYER WON!" / "WHITE PLAYER WON!".
'
' Liberties: the arena is 26 x 19 cells instead of 38 x 22 (the inner
' walls placed and sized in proportion, point-symmetric as on the C64);
' the players are sprites that glide from cell to cell (the logical cell
' changes at once, as on the C64); fast bombs have a red rim, slow ones a
' grey rim (the C64 drew both alike); the bombs' fuses spark (3 Hz, the C64
' blinked a dot row about 5 times a second); at most 40 bombs (a throw with
' 40 out does nothing); bombs move in list order, spread over six frames
' (the C64 scanned its screen); a computer WHITE for one player (the
' original needed two), at two levels chosen on the title: EASY (the
' default: reacts to danger one turn late and sometimes not at all,
' throws less and hesitates more) and HARD; when its step toward lining up
' is blocked it takes a random step (never stuck behind a wall); the player's colours outlined so BLACK shows on the
' blue floor; a blast and a pause at a hit; after the winner, back to the
' title (the C64 asked PLAY AGAIN (Y/N)?). On a real C64 the original kept
' its bomb flags in the upper bits of colour RAM, which only stores four
' bits (in jsc64 the bombs never move); this port does what the code means.
'
' Controls: controller 1 is BLACK, controller 2 WHITE (or the computer).
' The stick turns and walks, either button throws. On the title, up and
' down choose, a button chooses (on LEVEL it switches EASY / HARD).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off after a
' wait, display off; music first in the sound table; the title tune played
' once; `set sprite count` always given.

const TWallv = 128
const TWallh = 129
const TSlow0 = 130
const TSlow1 = 131
const TFast0 = 132
const TFast1 = 133
const TLife = 134
const TTblk = 135
const SFig1 = 0
const SOut1 = 4
const SFig2 = 8
const SOut2 = 12
const SFig3 = 16
const SOut3 = 20
const SFig4 = 24
const SOut4 = 28
const SFig5 = 32
const SOut5 = 36
const SFig6 = 40
const SOut6 = 44
const SFig7 = 48
const SOut7 = 52
const SFig8 = 56
const SOut8 = 60
const SBlast0 = 64
const SBlast1 = 68
const NTiles8 = 64
const SprBytes = 576
const SndTuneA = 1
const SndTuneB = 2
const SndThrow = 3
const SndBounce = 4
const SndClash = 5
const SndBoom = 6
const SndStart = 7
const SndWin = 8
const NSpr = 8
const MaxB = 40
const StepT = 6
const ThrowT = 15
const Lives0 = 5

' directions 1-8 (up-left, up, up-right, right, down-right, down,
' down-left, left: the C64's order); X and Y moves plus one
data DXp bytes 1,0,1,2,2,2,1,0,0
data DYp bytes 1,0,0,0,1,2,2,2,1
' the stick (1 up, 2 down, 4 left, 8 right) to a direction
data JDir bytes 0,2,6,0,8,1,7,0,4,3,5,0,0,0,0,0
' bounce tables: side walls (C64 char $62) and top/bottom walls ($63)
data RefV bytes 0,3,6,1,8,7,2,5,4
data RefH bytes 0,7,6,5,8,3,2,1,4
' glide: pixels from the old cell, frames 0-5 of a step
data Bit9 words 1,2,4,8,16,32,64,128,256
data GlideT bytes 1,3,4,5,7,8
' the arena's inner walls: column, first row, rows
data WallC bytes 15,16,7,24
data WallR bytes 2,17,7,7
data WallN bytes 4,4,9,9

data TilePat bytes
  $00,$43,$25,$19,$19,$25,$43,$00
  $00,$43,$25,$19,$19,$25,$43,$00
  $04,$08,$18,$C3,$81,$81,$C3,$00
  $02,$0C,$18,$C3,$81,$81,$C3,$00
  $04,$08,$18,$C3,$81,$81,$C3,$00
  $02,$0C,$18,$C3,$81,$81,$C3,$00
  $00,$10,$38,$83,$83,$38,$00,$00
  $00,$43,$25,$19,$19,$25,$43,$00
end data
data TileCol bytes
  $09,$69,$69,$69,$69,$69,$69,$06
  $09,$69,$69,$69,$69,$69,$69,$06
  $B4,$B4,$14,$41,$41,$41,$4E,$04
  $B4,$B4,$14,$41,$41,$41,$4E,$04
  $B4,$B4,$14,$41,$41,$41,$48,$04
  $B4,$B4,$14,$41,$41,$41,$48,$04
  $04,$B4,$14,$41,$41,$14,$04,$04
  $09,$69,$69,$69,$69,$69,$69,$06
end data
data SpritePat bytes
  $00,$40,$4C,$2C,$1E,$0D,$14,$22,$11,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $E0,$BE,$B2,$D3,$61,$32,$6B,$5D,$6E,$3B,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$00,$00,$00,$00
  $00,$21,$2D,$2D,$1E,$0C,$0C,$12,$12,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $73,$5E,$52,$52,$61,$33,$33,$2D,$2D,$3F,$00,$00,$00,$00,$00,$00
  $80,$80,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0D,$1E,$2C,$0A,$11,$22,$00,$00,$00,$00,$00,$00,$00
  $00,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $01,$1F,$13,$32,$61,$53,$75,$6E,$5D,$77,$00,$00,$00,$00,$00,$00
  $C0,$40,$40,$C0,$80,$00,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0C,$1F,$2C,$0C,$12,$24,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$1E,$12,$33,$60,$53,$73,$6D,$5B,$7E,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$C0,$40,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0C,$1E,$2D,$0C,$12,$24,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$1E,$12,$33,$61,$52,$73,$6D,$5B,$7E,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$C0,$40,$C0,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0C,$1E,$2D,$1E,$0C,$1E,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$1E,$12,$33,$61,$52,$61,$33,$21,$3F,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0C,$1E,$2D,$4C,$12,$09,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$1E,$12,$33,$61,$D2,$B3,$ED,$36,$1F,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$0C,$0C,$7E,$0D,$14,$12,$09,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$1E,$12,$F3,$81,$F2,$2B,$2D,$36,$1F,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$08,$05,$1A,$05,$08,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$00,$C0,$00,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$88,$49,$2A,$1C,$FE,$1C,$2A,$49,$88,$00,$00,$00,$00,$00
  $00,$00,$80,$00,$00,$00,$80,$00,$00,$00,$80,$00,$00,$00,$00,$00
end data

record Bomb:
  u8 X
  u8 Y
  u8 D
  u8 F
end record

record Player:
  u8 X
  u8 Y
  u8 PX
  u8 PY
  u8 Face
  u8 Tm
  u8 Mv
  u8 Lives
end record

Bomb Bm[MaxB]
Player Pl[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 DMask = 0
u8 NB = 0
u8 BPh = 0
u8 Sweep = 0
u8 Rot = 0
u8 Dead = 0
u8 Over = 0
u8 Winner = 0
u8 OnePl = 0
' the computer's level: 0 EASY (the default), 1 HARD; Late is 1 while
' an EASY computer has seen danger and not yet reacted
u8 Hard = 0
u8 Late = 0
u8 Spark = 0
u8 SparkT = 0
u8 Hits = 0
u8 Throws = 0
u8 Bounces = 0
u8 Clashes = 0
' input: J1, J2 the sticks used this frame (J2 from the computer in a
' one-player game); bit 16 a button
u8 J1 = 0
u8 J2 = 0
u8 Jm = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Rnd = 0
u8 Sfx = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Bi = 0
u8 Li = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tx = 0
u8 Ty = 0
u8 D = 0

  tile screen
  set sound table BdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title
  OnePl = 1
  if Menu = 1 then OnePl = 0

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Dead > 0 then
    RoundEnd
  end if
  if Over = 0 then goto play_loop

  ' the end: the winner, then back to the title on a press
  print at 6,9, "                    "
  if Winner = 1 then
    print at 6,10, "  BLACK PLAYER WON! "
  else
    print at 6,10, "  WHITE PLAYER WON! "
  end if
  print at 6,11, "                    "
  play sound SndWin
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame: both players' clocks, then a sixth of the bombs (each bomb
' once every six frames, slow ones every other time)
sub PlayStep:
  for Pi = 0 to 1
    if Pi = 1 then
      if OnePl = 1 then
        if Pl[1].Tm = 1 then CpuThink
      end if
    end if
    Pl[Pi].Tm -= 1
    if Pl[Pi].Tm = 0 then
      Pl[Pi].Tm = StepT
      PlayerTick
    end if
    if Pl[Pi].Mv < 5 then Pl[Pi].Mv += 1
  next
  if Dead > 0 then return
  Sfx = 0
  MoveBombs
  if Sfx > 0 then play sound Sfx
  inc BPh
  if BPh = StepT then
    BPh = 0
    inc Sweep
  end if
  return
end sub

sub MoveBombs:
  Bi = BPh
  while Bi < NB
    MoveBomb(Bi)
    if Dead > 0 then Bi = MaxB
    Bi = Bi + StepT
  end while
  return
end sub

' player Pi's turn: walk or turn, then maybe throw
sub PlayerTick:
  if Pi = 0 then
    Jm = J1
  else
    Jm = J2
  end if
  u8 Moved = 0
  u8 Pd = 0
  K = Jm & 15
  Pd = JDir[K]
  X = Pl[Pi].X
  Y = Pl[Pi].Y
  if Pd > 0 then
    Tx = X + DXp[Pd] - 1
    Ty = Y + DYp[Pd] - 1
    select case CellAt(Tx, Ty)
      case 0
        if Pl[Pi].Face = Pd then
          Pl[Pi].PX = X
          Pl[Pi].PY = Y
          Pl[Pi].X = Tx
          Pl[Pi].Y = Ty
          Pl[Pi].Mv = 0
          X = Tx
          Y = Ty
          Moved = 1
        else
          Pl[Pi].Face = Pd
        end if
      case 3
        ' walked into a bomb
        HitPlayer(Pi)
        Pd = 0
    end select
  else
    Pd = Pl[Pi].Face
  end if
  if Pd > 0 then
    V = Jm & 16
    if V > 0 then Throw(Pd, Moved)
  end if
  return
end sub

' what is in cell (Cx, Cy): 0 empty, 1 side/inner wall, 2 top/bottom
' wall, 3 a bomb, 4 player 0 (BLACK), 5 player 1 (WHITE)
function CellAt(u8 Cx, u8 Cy) as u8
  if Cx = Pl[0].X then
    if Cy = Pl[0].Y then return 4
  end if
  if Cx = Pl[1].X then
    if Cy = Pl[1].Y then return 5
  end if
  C = get char at Cx,Cy
  if C = 32 then return 0
  if C = TWallv then return 1
  if C = TWallh then return 2
  return 3

' a bomb into the next cell from player Pi (X, Y) in direction Td
sub Throw(u8 Td, u8 Fast)
  if NB < MaxB then
    Tx = X + DXp[Td] - 1
    Ty = Y + DYp[Td] - 1
    if CellAt(Tx, Ty) = 0 then Drop(Td, Fast)
  end if
  return
end sub

sub Drop(u8 Td, u8 Fast)
  Bm[NB].X = Tx
  Bm[NB].Y = Ty
  Bm[NB].D = Td
  Bm[NB].F = Fast
  inc NB
  if Fast = 1 then
    put char TFast0 at Tx,Ty
  else
    put char TSlow0 at Tx,Ty
  end if
  Pl[Pi].Tm = ThrowT
  inc Throws
  play sound SndThrow
  return
end sub

' bomb Bn's move (slow bombs only on odd sweeps)
sub MoveBomb(u8 Bn)
  u8 Bx = 0
  u8 By = 0
  u8 Bd = 0
  Bx = Bm[Bn].X
  By = Bm[Bn].Y
  Bd = Bm[Bn].D
  V = Sweep & 1
  V = V | Bm[Bn].F
  if V > 0 then BombGo(Bn, Bx, By, Bd)
  return
end sub

sub BombGo(u8 Gn, u8 Bx, u8 By, u8 Bd)
  Tx = Bx + DXp[Bd] - 1
  Ty = By + DYp[Bd] - 1
  select case CellAt(Tx, Ty)
    case 0
      put char 32 at Bx,By
      if Bm[Gn].F = 1 then
        put char TFast0 at Tx,Ty
      else
        put char TSlow0 at Tx,Ty
      end if
      Bm[Gn].X = Tx
      Bm[Gn].Y = Ty
    case 1
      Bm[Gn].D = RefV[Bd]
      inc Bounces
      Sfx = SndBounce
    case 2
      Bm[Gn].D = RefH[Bd]
      inc Bounces
      Sfx = SndBounce
    case 3
      Bm[Gn].D = NextRot
      K = FindBomb(Tx, Ty)
      Bm[K].D = NextRot
      inc Clashes
      Sfx = SndClash
    case 4
      HitPlayer(0)
    case 5
      HitPlayer(1)
  end select
  return
end sub

' the C64's "random" turn: a counter stepped by two
function NextRot as u8
  Rot = Rot + 2
  Rot = Rot & 7
  Rot = Rot + 1
  return Rot

function FindBomb(u8 Fx, u8 Fy) as u8
  u8 Fi = 0
  while Fi < NB
    if Bm[Fi].X = Fx then
      if Bm[Fi].Y = Fy then return Fi
    end if
    inc Fi
  end while
  return 0

sub HitPlayer(u8 Hp)
  if Hp = 0 then
    Dead = Dead | 1
  else
    Dead = Dead | 2
  end if
  if Pl[Hp].Lives > 0 then Pl[Hp].Lives -= 1
  inc Hits
  return
end sub

' a round ends: the blast on the hit player(s), then a new round or the end
sub RoundEnd:
  play sound SndBoom
  for Li = 0 to 59
    Frame1
    SparkFuse
    K = SBlast0
    if Li > 8 then K = SBlast1
    if Li > 40 then K = SBlast0
    V = Dead & 1
    if V > 0 then
      X = Pl[0].X * 8 - 4
      Y = Pl[0].Y * 8 - 6
      set sprite 6 to Y,X,K,11
    end if
    V = Dead & 2
    if V > 0 then
      X = Pl[1].X * 8 - 4
      Y = Pl[1].Y * 8 - 6
      set sprite 7 to Y,X,K,11
    end if
    update sprites
  next
  ShowLives
  if Pl[1].Lives = 0 then
    Winner = 1
    Over = 1
  else
    if Pl[0].Lives = 0 then
      Winner = 2
      Over = 1
    end if
  end if
  if Over = 0 then NewRound
  return
end sub

' ---------------------------------------------------------------------------
' the computer's WHITE: get out of a bomb's way, throw when lined up with
' BLACK, else walk to line up; looks one cell ahead of each bomb and is
' sometimes careless (a human-paced opponent)
sub CpuThink:
  J2 = 0
  Rand
  Rnd = Rs & 255
  X = Pl[1].X
  Y = Pl[1].Y
  DangerMap
  if Danger(X, Y) = 1 then
    if Hard = 0 then
      ' EASY: reacts one turn late, and about one time in six not at all
      if Late = 0 then
        Late = 1
        return
      end if
      if Rnd < 40 then return
    end if
    CpuDodge
    return
  end if
  Late = 0
  ' out of danger, about one decision in two it hesitates (EASY: more)
  if Rnd >= 140 then return
  if Hard = 0 then
    if Rnd >= 120 then return
  end if
  ' lined up with BLACK?
  D = Toward(X, Y, Pl[0].X, Pl[0].Y)
  if D > 0 then
    K = 40
    if Hard = 0 then K = 24
    if Rnd < K then
      if Pl[1].Face = D then
        J2 = 16
      else
        J2 = StickOf(D)
      end if
      return
    end if
  end if
  ' walk to line up: across the longer gap, sometimes at random
  if Rnd < 160 then
    D = Closer(X, Y)
  else
    D = Rs >> 8
    D = D & 7
    D = D + 1
  end if
  TryDodge(D)
  ' blocked (a wall, a bomb, BLACK): a random step instead, so it never
  ' stands stuck behind a wall
  if J2 = 0 then
    D = Rs >> 11
    D = D & 7
    D = D + 1
    TryDodge(D)
  end if
  return
end sub

sub CpuDodge:
  u8 Dd = 0
  u8 Tries = 0
  Dd = Pl[1].Face
  TryDodge(Dd)
  Dd = Rnd & 7
  for Tries = 0 to 7
    inc Dd
    if Dd > 8 then Dd = 1
    TryDodge(Dd)
  next
  return
end sub

sub TryDodge(u8 Td)
  if J2 = 0 then
    Tx = X + DXp[Td] - 1
    Ty = Y + DYp[Td] - 1
    if CellAt(Tx, Ty) = 0 then
      if Danger(Tx, Ty) = 0 then J2 = StickOf(Td)
    end if
  end if
  return
end sub

' the nine cells round WHITE (X, Y): bit (dy + 1) * 3 + dx + 1 of DMask
' is set when a bomb will enter that cell on its next move (one pass over
' the bombs per decision)
sub DangerMap:
  DMask = 0
  if NB > 0 then DangerAll
  return
end sub

sub DangerAll:
  u8 Qi = 0
  u8 Nx = 0
  u8 Ny = 0
  u8 Qd = 0
  u8 Qs = 0
  for Qi = 0 to NB - 1
    Qd = Bm[Qi].D
    Nx = Bm[Qi].X
    Ny = Bm[Qi].Y
    ' the next two cells straight on
    for Qs = 1 to 2
      Nx = Nx + DXp[Qd] - 1
      Ny = Ny + DYp[Qd] - 1
      Mark(Nx, Ny)
    next
  next
  return
end sub

sub Mark(u8 Mx, u8 My)
  Mx = Mx + 1 - X
  My = My + 1 - Y
  if Mx < 3 then
    if My < 3 then
      Mx = My * 3 + Mx
      DMask = DMask | Bit9[Mx]
    end if
  end if
  return
end sub

' 1 when cell (Qx, Qy), next to or at WHITE (X, Y), is in DMask
function Danger(u8 Qx, u8 Qy) as u8
  u8 Qk = 0
  Qk = Qy + 1 - Y
  Qk = Qk * 3 + Qx + 1 - X
  if DMask & Bit9[Qk] then return 1
  return 0

' the direction from (Ax, Ay) to (Bx2, By2) when they share a row, column
' or diagonal, else 0
function Toward(u8 Ax, u8 Ay, u8 Bx2, u8 By2) as u8
  i16 Dx = 0
  i16 Dy = 0
  i16 Ax2 = 0
  i16 Ay2 = 0
  Dx = Bx2 - Ax
  Dy = By2 - Ay
  Ax2 = Dx
  Ay2 = Dy
  if Ax2 < 0 then Ax2 = 0 - Ax2
  if Ay2 < 0 then Ay2 = 0 - Ay2
  if Dx <> 0 then
    if Dy <> 0 then
      if Ax2 <> Ay2 then return 0
    end if
  end if
  return DirOf(Dx, Dy)

function DirOf(i16 Sx, i16 Sy) as u8
  u8 Jb = 0
  if Sy < 0 then Jb = 1
  if Sy > 0 then Jb = 2
  if Sx < 0 then Jb = Jb | 4
  if Sx > 0 then Jb = Jb | 8
  return JDir[Jb]

' a step that closes the smaller gap to BLACK's row or column
function Closer(u8 Ax, u8 Ay) as u8
  i16 Dx = 0
  i16 Dy = 0
  i16 Ex = 0
  i16 Ey = 0
  Dx = Pl[0].X - Ax
  Dy = Pl[0].Y - Ay
  Ex = Dx
  Ey = Dy
  if Ex < 0 then Ex = 0 - Ex
  if Ey < 0 then Ey = 0 - Ey
  if Ex < Ey then
    if Dx <> 0 then return DirOf(Dx, 0)
    return DirOf(0, Dy)
  end if
  if Dy <> 0 then return DirOf(0, Dy)
  return DirOf(Dx, 0)

function StickOf(u8 Sd) as u8
  select case Sd
    case 1
      return 5
    case 2
      return 1
    case 3
      return 9
    case 4
      return 8
    case 5
      return 10
    case 6
      return 2
    case 7
      return 6
  end select
  return 4

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 BLACK (body, outline), 2-3 WHITE, 6-7 the blasts
sub DrawSprites:
  for Pi = 0 to 1
    PlayerXY
    J = Pi * 2
    K = Pl[Pi].Face - 1
    K = K * 8
    if Pi = 0 then
      set sprite J to Y,X,SFig1 + K,1
      set sprite J + 1 to Y,X,SOut1 + K,14
    else
      set sprite J to Y,X,SFig1 + K,15
      set sprite J + 1 to Y,X,SOut1 + K,1
    end if
  next
  update sprites
  SparkFuse
  return
end sub

' player Pi's sprite place (X, Y), gliding from the old cell
sub PlayerXY:
  u8 Off = 0
  Off = GlideT[Pl[Pi].Mv]
  X = Pl[Pi].PX * 8
  if Pl[Pi].X > Pl[Pi].PX then X = X + Off
  if Pl[Pi].X < Pl[Pi].PX then X = X - Off
  Y = Pl[Pi].PY * 8
  if Pl[Pi].Y > Pl[Pi].PY then Y = Y + Off
  if Pl[Pi].Y < Pl[Pi].PY then Y = Y - Off
  X = X - 1
  Y = Y - 2
  return
end sub

' the fuses spark: the bomb tiles' shapes swap every 10 frames
sub SparkFuse:
  inc SparkT
  if SparkT < 10 then return
  SparkT = 0
  Spark = Spark ^ 1
  if Spark = 0 then
    copy TilePat + 16 count 8 to vram.pattern + 1040
    copy TilePat + 32 count 8 to vram.pattern + 1056
    copy TilePat + 16 count 8 to vram.pattern + 3088
    copy TilePat + 32 count 8 to vram.pattern + 3104
    copy TilePat + 16 count 8 to vram.pattern + 5136
    copy TilePat + 32 count 8 to vram.pattern + 5152
  else
    copy TilePat + 24 count 8 to vram.pattern + 1040
    copy TilePat + 40 count 8 to vram.pattern + 1056
    copy TilePat + 24 count 8 to vram.pattern + 3088
    copy TilePat + 40 count 8 to vram.pattern + 3104
    copy TilePat + 24 count 8 to vram.pattern + 5136
    copy TilePat + 40 count 8 to vram.pattern + 5152
  end if
  return
end sub

sub ShowLives:
  fill 32 count 28 at 2,22
  print at 2,22, "BLACK"
  if Pl[0].Lives > 0 then fill TLife count Pl[0].Lives at 8,22
  if OnePl = 1 then
    print at 14,22, "CPU"
  end if
  print at 18,22, "WHITE"
  if Pl[1].Lives > 0 then
    K = 29 - Pl[1].Lives
    fill TLife count Pl[1].Lives at K,22
  end if
  return
end sub

' a new round: a clean arena, both players back on the middle row
sub NewRound:
  NewScreen
  DrawArena
  NB = 0
  BPh = 0
  Sweep = 0
  Dead = 0
  Pl[0].X = 9
  Pl[0].Y = 11
  Pl[0].PX = 9
  Pl[0].PY = 11
  Pl[0].Face = 4
  Pl[0].Tm = 4
  Pl[0].Mv = 5
  Pl[1].X = 22
  Pl[1].Y = 11
  Pl[1].PX = 22
  Pl[1].PY = 11
  Pl[1].Face = 8
  Pl[1].Tm = 4
  Pl[1].Mv = 5
  J2 = 0
  Late = 0
  ShowLives
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait 30 frames
  nmi off
  return
end sub

sub DrawArena:
  fill TWallh count 28 at 2,1
  fill TWallh count 28 at 2,21
  for Li = 2 to 20
    put char TWallv at 2,Li
    put char TWallv at 29,Li
  next
  for Li = 0 to 3
    WallLine(WallC[Li], WallR[Li], WallN[Li])
  next
  return
end sub

sub WallLine(u8 Wc, u8 Wr, u8 Wn)
  u8 Wy = 0
  for Wy = Wr to Wr + Wn - 1
    put char TWallv at Wc,Wy
  next
  return
end sub

sub NewGame:
  Pl[0].Lives = Lives0
  Pl[1].Lives = Lives0
  Over = 0
  Winner = 0
  Hits = 0
  Throws = 0
  Bounces = 0
  Clashes = 0
  Rot = 0
  NewRound
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if OnePl = 0 then
    J2 = 0
    if joypad(2).up then J2 = J2 | 1
    if joypad(2).down then J2 = J2 | 2
    if joypad(2).left then J2 = J2 | 4
    if joypad(2).right then J2 = J2 | 8
    if joypad(2).fire then J2 = J2 | 16
  end if
  return
end sub

' the menus: either controller
sub ReadMenu:
  ReadPad
  Jm = J1
  if joypad(2).up then Jm = Jm | 1
  if joypad(2).down then Jm = Jm | 2
  if joypad(2).fire then Jm = Jm | 16
  Btn = Jm & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  Spark = 0
  SparkT = 0
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BOMBARDMENT in a walled frame, the two players facing each
' other with bombs between them, 1 PLAYER / 2 PLAYERS / LEVEL / CREDITS
sub TitlePage:
  NewScreen
  fill TWallh count 26 at 3,2
  fill TWallh count 26 at 3,6
  for Li = 3 to 5
    put char TWallv at 3,Li
    put char TWallv at 28,Li
  next
  print at 5,4, "B O M B A R D M E N T"
  put char TSlow0 at 13,10
  put char TFast0 at 16,9
  put char TFast0 at 18,11
  print at 10,14, "1 PLAYER"
  print at 10,15, "2 PLAYERS"
  print at 10,17, "CREDITS"
  ShowLevel
  print at 7,19, "COMPUTE!'S GAZETTE"
  print at 10,20, "JANUARY 1989"
  set sprite 0 to 78,71,SFig4,1
  set sprite 1 to 78,71,SOut4,14
  set sprite 2 to 78,175,SFig8,15
  set sprite 3 to 78,175,SOut8,1
  update sprites
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 456
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadMenu
  SparkFuse
  V = Jm & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 3 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 2 then
    Hard = Hard ^ 1
    ShowLevel
    play sound SndThrow
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  for Li = 14 to 17
    put char 32 at 8,Li
  next
  J = Menu + 14
  put char 62 at 8,J
  return
end sub

sub ShowLevel:
  if Hard = 1 then
    print at 10,16, "LEVEL: HARD"
  else
    print at 10,16, "LEVEL: EASY"
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  print at 10,2, "BOMBARDMENT"
  print at 2,5, "BASED ON BOMBARDMENT,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "JANUARY 1989 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE; NO AUTHOR"
  print at 2,9, "NAMED IN THE PROGRAM)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CROSSFIRE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

