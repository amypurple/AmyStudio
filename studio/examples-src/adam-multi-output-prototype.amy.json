{
  "version": 2,
  "projectName": "ADAM Multi-Output Prototype",
  "target": {
    "platform": "adam-disk",
    "volume": "AMY PROJECT",
    "blockCount": 160
  },
  "outputs": [
    {
      "name": "BOOT",
      "type": "boot",
      "memoryProfile": "adam-eos-boot-block",
      "sources": [
        { "path": "src/boot.asm", "kind": "asm" }
      ]
    },
    {
      "name": "GAME",
      "type": "program",
      "memoryProfile": "adam-eos-application",
      "sources": [
        { "path": "src/main.amy", "kind": "amy" },
        { "path": "src/player.amy", "kind": "amy" },
        { "path": "src/scenes.amy", "kind": "amy" },
        { "path": "src/eos-files.amy", "kind": "amy" }
      ]
    },
    {
      "name": "LEVELS",
      "type": "data",
      "sources": [
        { "path": "assets/levels.zx0", "kind": "asset" },
        { "path": "assets/locations.pattern.zx0", "kind": "asset" }
      ]
    },
    {
      "name": "MUSIC",
      "type": "data",
      "sources": [
        { "path": "assets/theme.tiny", "kind": "asset" },
        { "path": "assets/effects.asm", "kind": "asm" }
      ]
    }
  ],
  "projectFiles": []
}

