cartridge "SCRAMBLER/TONY BRANTNER/1987"

' SCRAMBLER
' A ColecoVision game based on "Scrambler" by Tony Brantner, Ahoy! April
' 1987 (Commodore 64: a two-line BASIC loader and 2.6 KB of machine code at
' $C000; orig/ has the files from the Ahoy! disk, the disassembly and jsc64
' screenshots). Made for Amy Studio by Claude (an AI made by Anthropic),
' 2026, in Amy by Amy Bienvenu.
'
' The disk's blurb: "Scrambler requires split-second timing to run, jump
' and climb, elude robot sentries, and collect bags of gold."
'
' From the original (its machine code): a scaffold of five girders over the
' ground, joined by ladders (two, one, two, one, two from the bottom, and
' one in the middle of the top girder that leads out); one robot sentry
' patrols each of the six walkways, choosing a new random speed (1, 2 or 3
' steps either way) at the ends of its patrol and now and then (1 in 256)
' in mid-walk; when the scrambler stands on a walkway, its robot now and
' then (1 in 256) fires a laser bolt along it toward him, 4 steps a tick;
' touching a robot or a bolt costs a life; the scrambler walks, climbs a
' ladder only from its foot (up) or its top (down), at half speed, and can
' reverse or stop on it but not leave it between girders; the button (held
' or pressed) jumps, 32 frames, up to 13 pixels, keeping the direction the
' stick had when it began; a gold sack lies near one end of every girder
' (random end and place, new ones after a lost life), worth 50 points times
' the level (12 at most), counted up 10 at a time; out the top is the next
' level, faster (the C64 loop's delay drops from 17 to 6), with an extra
' life (9 at most); three lives; the robots' colours and starting places
' are random (right half); GAME OVER keeps the high score.
'
' Liberties: one speed table for every machine: the scrambler walks a
' pixel a frame and climbs half a pixel; robots go 5, 10 or 15 sixteenths
' of a pixel a frame on level 1 (the C64's 1-3 steps a tick at about 43
' ticks a second, scaled to the narrower screen, then slowed to a little
' over half so a person reacting a fifth of a second late can get through:
' settled with a human-paced test player), bolts 36, all of them an eighth faster each level
' up to level 7 (the C64 got up to 2.3 times faster by level 12); the
' 1-in-256 chances are taken each frame; a robot always turns round at
' the ends of its patrol (the C64's could pick the same way again and
' linger there), and its mid-walk change keeps its direction (the C64's
' could turn round under a jumping scrambler); a robot never fires when
' it is within 80 pixels of the scrambler (the C64's could fire
' point-blank; at 80 a bolt gives about a second to jump); the scrambler lines up with a ladder
' when within 3 pixels of its middle (the C64 needed his test point inside
' the ladder's character); gold is picked up only near the ground of a
' jump, not at its top; collisions use boxes a little smaller than the
' sprites (the C64 used their pixels), and only the robot of his own
' walkway can touch him, or on a ladder the one above too (a jump's top
' cannot reach up into the next walkway); he starts standing at the left
' end after READY (the C64 walked him in); the scaffold is 28 columns wide
' (36) with girders three rows apart (four); a new girder look, robots on
' treads, a sparkling end, a title tune and sounds; the shift-key pause is
' gone (no keyboard).
' Standing still is no refuge: the robots keep walking (as on the C64).
'
' Controls: the joystick (either controller) walks and climbs, a button
' jumps. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Nothing flashes.

const TGirder = 128
const TLadder = 129
const TLadderG = 130
const THatch = 131
const TBrick = 132
const TBag = 133
const TWin1 = 134
const TWin2 = 135
const TTtl00 = 136
const TTtl01 = 137
const TTtl02 = 138
const TTtl03 = 139
const TTtl04 = 140
const TTtl05 = 141
const TTtl06 = 142
const TTtl07 = 143
const TTtl08 = 144
const TTtl09 = 145
const TTtl010 = 146
const TTtl011 = 147
const TTtl012 = 148
const TTtl013 = 149
const TTtl014 = 150
const TTtl015 = 151
const TTtl016 = 152
const TTtl017 = 153
const TTtl10 = 154
const TTtl11 = 155
const TTtl12 = 156
const TTtl13 = 157
const TTtl14 = 158
const TTtl15 = 159
const TTtl16 = 160
const TTtl17 = 161
const TTtl18 = 162
const TTtl19 = 163
const TTtl110 = 164
const TTtl111 = 165
const TTtl112 = 166
const TTtl113 = 167
const TTtl114 = 168
const TTtl115 = 169
const TTtl116 = 170
const TTtl117 = 171
const SP0d0 = 0
const SP0b0 = 4
const SP0d1 = 8
const SP0b1 = 12
const SP0d2 = 16
const SP0b2 = 20
const SP0d3 = 24
const SP0b3 = 28
const SP0d4 = 32
const SP0b4 = 36
const SP1d0 = 40
const SP1b0 = 44
const SP1d1 = 48
const SP1b1 = 52
const SP1d2 = 56
const SP1b2 = 60
const SP1d3 = 64
const SP1b3 = 68
const SP1d4 = 72
const SP1b4 = 76
const SSpark0 = 80
const SSpark1 = 84
const SSpark2 = 88
const SSpark3 = 92
const SRob0 = 96
const SRob1 = 100
const SBolt = 104
const NTiles8 = 352
const SprBytes = 864
const LeftOff = 40
const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndJump = 4
const SndRung = 5
const SndLaser = 6
const SndCoin = 7
const SndDie = 8
const SndClear = 9
const SndStart = 10
const SndOver = 11
const NSpr = 9
const NW = 6
const StPlay = 1
const StDie = 2
const StClear = 3
const XMin = 12
const XMax = 228
' robots' x in sixteenths of a pixel: 16 to 224
const RMin = 256
const RMax = 3584
const ExitY = 10

' the jump: height above the walkway on each of its 32 frames (the C64's
' table of steps, added up)
data Lift bytes
  0,2,4,6,8,9,10,10,11,11,12,12,12,13,13,13,13,13,13,13,12,12,12,11,11,10,10,9,8,6,4,2,0
end data
' the ladders above each walkway (0 the ground): first column, second
' column (0: none)
data LadA bytes
  7,16,7,16,7,16
end data
data LadB bytes
  24,0,24,0,24,0
end data
' a robot's new speed: steps (1-3) and direction (1 left), the C64's table
data SpdMag bytes
  1,1,2,2,3,3,1,1
end data
data SpdNeg bytes
  0,1,0,1,0,1,0,1
end data
' the top row of a sprite standing on each walkway
data SyT bytes
  144,120,96,72,48,24
end data
data RobPal bytes
  3,13,14,7,9,15,10,2
end data

record Robot:
  u16 X
  i16 V
  u8 C
end record

Robot Rob[NW]
u16 Seed = 12345
i16 RLo = RMin
i16 RHi = RMax
u16 TzLeft = 0
u8 TzOn = 0
u16 W16 = 0
u16 NumU = 0
u16 Score = 0
u16 HiScore = 0
u8 Lives = 3
u8 Lv = 1
u8 Fct = 8
u8 Over = 0
' the scrambler: state, place, walkway, climbing, jump frame and direction
u8 St = StPlay
u8 Px = XMin
u8 Py = 144
u8 Pw = 0
u8 Climb = 0
u8 Jf = 0
u8 Jd = 0
u8 Face = 0
u8 DieT = 0
u8 Pend = 0
u8 BagC[NW]
' the bolt: on, x in sixteenths, speed, walkway
u8 LOn = 0
u16 Lx = 0
i16 Lv16 = 0
u8 Lw = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Gw = 0
u8 Gc = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 F = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ScSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 1 then goto game_over
  if St = StClear then LevelDone
  goto play_loop

game_over:
  Phase = 4
  if Score > HiScore then
    HiScore = Score
    ShowHi
  end if
  fill 32 count 11 at 10,12
  print at 11,12, "GAME OVER"
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' helpers

' 16-bit xorshift; returns its low byte
function Rnd as u8
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  return Seed & 255

' the top row (sprite y) of a scrambler standing on walkway Ww
function StandY(u8 Ww) as u8
  return 144 - Ww * 24

' the girder row of walkway Ww
function FloorRow(u8 Ww) as u8
  return 20 - Ww * 3

' the column of a ladder going up from walkway Lg that the scrambler is
' lined up with (within 3 pixels of its middle), else 0
function LadderNear(u8 Lg) as u8
  u8 Cx = 0
  u8 Lc = 0
  i16 Dd = 0
  if Lg >= NW then return 0
  Cx = Px + 8
  Lc = LadA[Lg]
  Dd = Lc * 8 + 4
  Dd = Dd - Cx
  if abs(Dd) <= 3 then return Lc
  Lc = LadB[Lg]
  if Lc = 0 then return 0
  Dd = Lc * 8 + 4
  Dd = Dd - Cx
  if abs(Dd) <= 3 then return Lc
  return 0

' 1 when the boxes A (Ax1-Ax2, Ay1-Ay2) and the scrambler's overlap
function HitBox(u8 Ax1, u8 Ax2, u8 Ay1, u8 Ay2) as u8
  u8 Bx1 = 0
  u8 By1 = 0
  u8 By2 = 0
  Bx1 = Px + 6
  By1 = Py + 3
  By2 = Py + 15
  if Jf > 0 then By2 = Py + 12
  if Ax2 < Bx1 then return 0
  if Ax1 > Bx1 + 3 then return 0
  if Ay2 < By1 then return 0
  if Ay1 > By2 then return 0
  return 1

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveRobots
  MoveBolt
  if St = StDie then
    DieStep
    return
  end if
  if St <> StPlay then return
  MovePlayer
  if St <> StPlay then return
  MaybeFire
  CheckBag
  CountGold
  CheckHits
  return
end sub

' each robot walks at its speed; at the ends of its patrol it stays put
' this frame and turns round at a new random pace; 1 time in 256 it
' changes its pace in mid-walk, keeping its direction
sub MoveRobots:
  i16 Nx = 0
  i16 Vl = 0
  for Ri = 0 to 5
    Nx = Rob[Ri].X
    Vl = Rob[Ri].V
    Nx = Nx + Vl
    if Nx < RLo then
      NewSpeed(Ri, 2)
    elseif Nx > RHi then
      NewSpeed(Ri, 3)
    elseif Rnd() = 0 then
      NewSpeed(Ri, 1)
    else
      Rob[Ri].X = Nx
    end if
  next
  return
end sub

' a new speed from the table; Keep 1 keeps the robot's direction, 2 sends
' it right and 3 left (turning round at the ends of its patrol)
sub NewSpeed(u8 Ni, u8 Keep):
  u8 Sk = 0
  u8 Ng = 0
  u16 Sp = 0
  i16 Sv = 0
  Sk = Rnd() & 7
  Sp = SpdMag[Sk] * 5
  Sp = Sp * Fct
  Sp = Sp >> 3
  Sv = Sp
  Ng = SpdNeg[Sk]
  select case Keep
  case 1
    Ng = 0
    if Rob[Ni].V < 0 then Ng = 1
  case 2
    Ng = 0
  case 3
    Ng = 1
  end select
  if Ng = 1 then Sv = 0 - Sv
  Rob[Ni].V = Sv
  return
end sub

' the bolt flies until it leaves the robots' patrol
sub MoveBolt:
  i16 Bx = 0
  if LOn = 0 then return
  Bx = Lx
  Bx = Bx + Lv16
  if Bx < RLo then
    LOn = 0
  elseif Bx > RHi then
    LOn = 0
  else
    Lx = Bx
  end if
  return
end sub

' a robot fires along the scrambler's walkway (1 in 256 a frame while he
' stands or walks on it, never within 80 pixels)
sub MaybeFire:
  u16 Rp = 0
  u16 Pp = 0
  u16 Sp = 0
  if LOn = 1 then return
  if Climb = 1 then return
  if Jf > 0 then return
  if Rnd() <> 0 then return
  Rp = Rob[Pw].X >> 4
  Pp = Px
  if Rp >= Pp then
    if Rp - Pp < 80 then return
  else
    if Pp - Rp < 80 then return
  end if
  Sp = 36 * Fct
  Sp = Sp >> 3
  Lv16 = Sp
  if Rp >= Pp then Lv16 = 0 - Lv16
  Lx = Rob[Pw].X
  Lw = Pw
  LOn = 1
  play sound SndLaser
  return
end sub

' the jump, the ladder, or a step (in that order, as the C64 did)
sub MovePlayer:
  u8 Lc = 0
  u8 Sy = 0
  u8 Hd = 0
  Sy = SyT[Pw]
  if Jf > 0 then
    inc Jf
    if Jd = 1 then StepX(1)
    if Jd = 2 then StepX(2)
    Py = Sy - Lift[Jf]
    if Jf >= 32 then
      Jf = 0
      Py = Sy
    end if
    return
  end if
  if Climb = 1 then
    ClimbStep
    return
  end if
  if Btn > 0 then
    Jf = 1
    Jd = 0
    V = Pad & 8
    if V > 0 then Jd = 1
    V = Pad & 4
    if V > 0 then Jd = 2
    Py = Sy - Lift[1]
    play sound SndJump
    return
  end if
  Hd = Pad & 3
  if Hd = 1 then
    Lc = LadderNear(Pw)
    if Lc > 0 then
      Climb = 1
      Px = Lc * 8 - 4
      return
    end if
  end if
  if Hd = 2 then
    if Pw > 0 then
      Lc = LadderNear(Pw - 1)
      if Lc > 0 then
        Climb = 1
        Px = Lc * 8 - 4
        return
      end if
    end if
  end if
  Hd = Pad & 12
  if Hd = 8 then StepX(1)
  if Hd = 4 then StepX(2)
  return
end sub

sub StepX(u8 Dir):
  if Dir = 1 then
    Face = 0
    if Px < XMax then inc Px
  else
    Face = 1
    if Px > XMin then dec Px
  end if
  return
end sub

' up or down half a pixel a frame; at a walkway the climb ends; out of the
' hatch at the top, the level is done
sub ClimbStep:
  u8 Hd = 0
  u8 Up = 0
  Hd = Pad & 3
  Up = Tick & 1
  if Up = 1 then return
  if Hd = 1 then
    dec Py
    if Py <= ExitY then
      St = StClear
      return
    end if
  elseif Hd = 2 then
    inc Py
  else
    return
  end if
  if Py > 144 then return
  W16 = 144 - Py
  if W16 mod 24 = 0 then
    Pw = W16 / 24
    Climb = 0
  elseif Hd = 2 then
    play sound SndRung
  end if
  return
end sub

' gold under the scrambler's middle on his walkway (not at a jump's top)
sub CheckBag:
  u8 Bc = 0
  u8 Cc = 0
  if Climb = 1 then return
  if Lift[Jf] > 6 then return
  Bc = BagC[Pw]
  if Bc = 0 then return
  Cc = Px + 8
  Cc = Cc >> 3
  if Cc <> Bc then return
  BagC[Pw] = 0
  Y = FloorRow(Pw) - 1
  put char 32 at Bc,Y
  V = Lv
  if V > 12 then V = 12
  Pend = Pend + V * 5
  return
end sub

' the gold is counted into the score, 10 points every other frame
sub CountGold:
  if Pend = 0 then return
  V = Tick & 1
  if V = 1 then return
  dec Pend
  if Score < 65000 then inc Score
  ShowScore
  V = Pend & 3
  if V = 0 then play sound SndCoin
  return
end sub

' robots and the bolt against the scrambler's box (his own walkway's
' robot and, on a ladder, the one above: a jump's top does not reach it)
sub CheckHits:
  u8 Rx8 = 0
  u8 Ry = 0
  u8 Ht = 0
  u8 Top = 0
  u16 Rxw = 0
  Top = Pw
  if Climb = 1 then
    if Pw < 5 then Top = Pw + 1
  end if
  for Ri = Pw to Top
    Rxw = Rob[Ri].X
    Rx8 = Rxw >> 4
    Ry = SyT[Ri]
    Ht = HitBox(Rx8 + 3, Rx8 + 12, Ry + 8, Ry + 15)
    if Ht = 1 then exit for
  next
  if Ht = 0 then
    if LOn = 1 then
      Rx8 = Lx >> 4
      Ry = SyT[Lw]
      Ht = HitBox(Rx8 + 3, Rx8 + 12, Ry + 10, Ry + 12)
    end if
  end if
  if Ht = 1 then
    St = StDie
    DieT = 0
    play sound SndZap
    play sound SndDie
  end if
  return
end sub

' the scrambler breaks into sparks; the gold still owed is counted, then
' the next life (or the end)
sub DieStep:
  inc DieT
  if DieT < 72 then return
  if Pend > 0 then
    CountGold
    DieT = 71
    return
  end if
  dec Lives
  ShowLives
  if Lives = 0 then
    Over = 1
    return
  end if
  StartRound
  return
end sub

' ---------------------------------------------------------------------------
' levels and drawing

sub NewGame:
  Score = 0
  Lives = 3
  Lv = 1
  Over = 0
  StartRound
  return
end sub

sub LevelDone:
  Phase = 3
  play sound SndClear
  for Gi = 0 to 30
    Frame1
    if Py > 2 then dec Py
    DrawSprites
  next
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  fill 32 count 12 at 10,12
  print at 10,12, "LEVEL CLEAR"
  while Pend > 0
    Frame1
    CountGold
  end while
  if Lives < 9 then
    inc Lives
    ShowLives
  end if
  Rearm
  wait 70 frames
  nmi off
  if Lv < 99 then inc Lv
  StartRound
  return
end sub

' a new screen for the level: the scaffold, new gold, the robots on the
' right, the scrambler at the left end of the ground
sub StartRound:
  Phase = 2
  V = Lv - 1
  if V > 6 then V = 6
  Fct = 8 + V
  NewScreen
  DrawScaffold
  PlaceGold
  for Ri = 0 to 5
    V = Rnd() % 96
    W16 = V
    W16 = W16 + 128
    Rob[Ri].X = W16 << 4
    V = Rnd() & 7
    Rob[Ri].C = RobPal[V]
    NewSpeed(Ri, 0)
  next
  St = StPlay
  Px = XMin
  Pw = 0
  Py = StandY(0)
  Climb = 0
  Jf = 0
  Face = 0
  DieT = 0
  Pend = 0
  LOn = 0
  ShowHud
  DrawSprites
  print at 13,12, "READY"
  ShowScreen
  play sound SndStart
  Rearm
  wait 60 frames
  nmi off
  fill 32 count 5 at 13,12
  Phase = 1
  return
end sub

' the night sky with far windows, five girders and the ground, the
' ladders, the hatch, the brick footing
sub DrawScaffold:
  u8 Fr = 0
  u8 Lc = 0
  for Gw = 1 to 21
    for Gc = 0 to 31
      V = Gc * 7 + Gw * 13
      V = V & 31
      if V = 5 then
        put char TWin1 at Gc,Gw
      elseif V = 17 then
        put char TWin2 at Gc,Gw
      end if
    next
  next
  for Gw = 0 to 5
    Fr = FloorRow(Gw)
    fill TGirder count 28 at 2,Fr
  next
  fill TBrick count 32 at 0,21
  fill TBrick count 32 at 0,22
  for Gw = 0 to 5
    Fr = FloorRow(Gw)
    Lc = LadA[Gw]
    DrawLadder(Lc, Fr)
    Lc = LadB[Gw]
    if Lc > 0 then DrawLadder(Lc, Fr)
  next
  put char THatch at 16,1
  return
end sub

' a ladder from just above girder row Lr up through the next girder
sub DrawLadder(u8 Lcol, u8 Lr):
  u8 Ly = 0
  Ly = Lr - 1
  put char TLadder at Lcol,Ly
  dec Ly
  put char TLadder at Lcol,Ly
  dec Ly
  if Ly = 2 then
    put char TLadder at Lcol,Ly
  else
    put char TLadderG at Lcol,Ly
  end if
  return
end sub

' one sack on every girder, near a random end
sub PlaceGold:
  u8 Bv = 0
  u8 By = 0
  BagC[0] = 0
  for Gw = 1 to 5
    Bv = Rnd() & 7
    if Bv < 4 then
      Bv = Bv + 2
    else
      Bv = Bv + 22
    end if
    BagC[Gw] = Bv
    By = FloorRow(Gw) - 1
    put char TBag at Bv,By
  next
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  print at 2,1, "LEVEL"
  NumU = Lv
  print at 8,1, digits$(NumU, 2)
  put char THatch at 16,1
  print at 18,1, "HIGH"
  fill 32 count 28 at 2,22
  print at 2,22, "SCORE"
  print at 22,22, "LIVES"
  ShowScore
  ShowHi
  ShowLives
  return
end sub

sub ShowScore:
  NumU = Score
  print at 8,22, digits$(NumU, 5)
  put char 48 at 13,22
  return
end sub

sub ShowHi:
  NumU = HiScore
  print at 23,1, digits$(NumU, 5)
  put char 48 at 28,1
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 28,22, digits$(NumU, 1)
  return
end sub

' sprites 0-1 the scrambler (detail over body), 2-7 the robots, 8 the bolt
sub DrawSprites:
  u8 Rx8 = 0
  u8 Ry = 0
  u16 Rxw = 0
  X = Px
  Y = Py - 1
  if St = StDie then
    V = DieT >> 3
    if V > 3 then V = 3
    K = SSpark0 + V * 4
    if DieT >= 56 then
      set sprite 0 to 192,0,0,0
    else
      set sprite 0 to Y,X,K,11
    end if
    set sprite 1 to 192,0,0,0
  else
    if Jf > 0 then
      F = 4
    elseif Climb = 1 then
      F = 2 + ((Py >> 2) & 1)
    else
      F = (Px >> 2) & 1
    end if
    K = F << 3
    if Face = 1 then K = K + LeftOff
    K = K + SP0d0
    set sprite 0 to Y,X,K,15
    K = K + 4
    set sprite 1 to Y,X,K,5
  end if
  for Ri = 0 to 5
    Rxw = Rob[Ri].X
    Rx8 = Rxw >> 4
    Ry = SyT[Ri] - 1
    K = SRob0
    if Rx8 & 4 then K = SRob1
    N = Ri + 2
    C = Rob[Ri].C
    set sprite N to Ry,Rx8,K,C
  next
  if LOn = 1 then
    Rx8 = Lx >> 4
    Ry = SyT[Lw] - 1
    set sprite 8 to Ry,Rx8,SBolt,7
  else
    set sprite 8 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the lower scaffold with its three robots at work, the name,
' the high score, START / CREDITS
sub TitlePage:
  Phase = 5
  Lv = 1
  Fct = 8
  NewScreen
  DrawScaffold
  for Gw = 1 to 10
    fill 32 count 32 at 0,Gw
  next
  for Gi = 0 to 17
    V = TTtl00 + Gi
    X = Gi + 7
    put char V at X,3
    V = TTtl10 + Gi
    put char V at X,4
  next
  print at 7,6, "AHOY! APRIL 1987"
  print at 10,7, "HIGH"
  NumU = HiScore
  print at 15,7, digits$(NumU, 5)
  put char 48 at 20,7
  print at 12,9, "START"
  print at 12,10, "CREDITS"
  ShowMenu
  for Ri = 0 to 5
    V = Rnd() & 127
    W16 = V
    W16 = W16 + 64
    Rob[Ri].X = W16 << 4
    Rob[Ri].C = RobPal[Ri]
    NewSpeed(Ri, 0)
  next
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 784
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  V = Rnd()
  MoveRobots
  TitleSprites
  V = Pad & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the title's robots: the three lower walkways only
sub TitleSprites:
  u8 Rx8 = 0
  u8 Ry = 0
  for Ri = 0 to 2
    Rx8 = Rob[Ri].X >> 4
    Ry = StandY(Ri) - 1
    V = (Rx8 >> 2) & 1
    K = SRob0 + V * 4
    N = Ri + 2
    set sprite N to Ry,Rx8,K,Rob[Ri].C
  next
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,9
  put char 32 at 10,10
  J = Menu + 9
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "SCRAMBLER"
  print at 2,5, "BASED ON SCRAMBLER BY TONY"
  print at 2,6, "BRANTNER, AHOY! APRIL 1987"
  print at 2,7, "(COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: UP THE SCAFFOLD"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

