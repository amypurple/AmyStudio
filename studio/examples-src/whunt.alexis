' directions 1-8 as on the C64 (0 unused); 255 is one step back (u8 wraps)
data DirX bytes = 0,1,1,1,0,255,255,255,0
data DirY bytes = 0,255,0,1,1,1,0,255,255
' where each direction's digit is in the compass (0 = the middle)
data CompX bytes = 27,28,28,28,27,26,26,26,27
data CompY bytes = 9,8,9,10,10,10,9,8,8

