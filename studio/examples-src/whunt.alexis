  tile screen
  set sound table WhSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title
  SetupPage
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Mode = 2 then goto play_loop

  HideSprites
  EndScreen
  Rearm
  wait 60 frames
  nmi off
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  mute all
  goto title

' ---------------------------------------------------------------------------
' the words

' word Hw's length and letters (0-25) into WBuf
sub LoadWord(u8 Hw):
  u16 P = 0
  P = Theme * 24 + WList[Hw].Num
  P = P * 9
  copy WordData + P count 9 to WBuf
  return
end sub

' the grid letter at cell Gx, Gy (255 while empty)
function GridAt(u8 Gx, u8 Gy) as u8
  return Grid[Gy * 10 + Gx]

' the screen column and row of a cell
function ScrX(u8 Gx) as u8
  return Gx * 2 + GridX0

function ScrY(u8 Gy) as u8
  return Gy * 2 + GridY0

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rb = highbyte Rs
  return
end sub

' ten different random words of the theme, then longest first (ties keep
' their order, as the C64's insertion)
sub ChooseWords:
  fill array Used with 0
  for Wi = 0 to NWords - 1
    Ok = 0
    while Ok = 0
      Rnd
      K = Rb mod 24
      if Used[K] = 0 then Ok = 1
    end while
    Used[K] = 1
    WList[Wi].Num = K
    LoadWord(Wi)
    WList[Wi].Len = WBuf[0]
  next
  Bad = 1
  while Bad = 1
    Bad = 0
    for Wi = 0 to NWords - 2
      Qi = Wi + 1
      if WList[Wi].Len < WList[Qi].Len then
        SwapW = WList[Wi]
        WList[Wi] = WList[Qi]
        WList[Qi] = SwapW
        Bad = 1
      end if
    next
  end while
  return
end sub

' try to put word Wi somewhere: Ok = 1 when it went in
sub PlaceOne:
  Ok = 0
  Tries = 0
  LoadWord(Wi)
  L = WBuf[0]
  W = L - 1
  while Ok = 0 and Tries < 250
    inc Tries
    Rnd
    X = Rb mod 10
    Rnd
    Y = Rb mod 10
    Rnd
    K = Rb & 7
    inc K
    ' the far end must be inside the grid (off the left/top wraps high)
    Cx = X + W * DirX[K]
    Cy = Y + W * DirY[K]
    if Cx < 10 and Cy < 10 then
      Ok = 1
      Cx = X
      Cy = Y
      for Ti = 0 to W
        C = GridAt(Cx, Cy)
        if C <> 255 and C <> WBuf[Ti + 1] then Ok = 0
        Cx += DirX[K]
        Cy += DirY[K]
      next
    end if
  end while
  if Ok = 1 then
    WList[Wi].X = X
    WList[Wi].Y = Y
    WList[Wi].D = K
    Cx = X
    Cy = Y
    for Ti = 0 to W
      J = Cy * 10 + Cx
      Grid[J] = WBuf[Ti + 1]
      Cx += DirX[K]
      Cy += DirY[K]
    next
  end if
  return
end sub

sub MakeGrid:
mg_again:
  fill array Grid with 255
  Bad = 0
  for Wi = 0 to NWords - 1
    if Bad = 0 then
      PlaceOne
      if Ok = 0 then Bad = 1
    end if
  next
  if Bad = 1 then goto mg_again
  for Ri = 0 to 99
    if Grid[Ri] = 255 then
      Rnd
      Grid[Ri] = Rb mod 26
    end if
  next
  return
end sub

sub DrawGrid:
  for Ri = 4 to 22
    fill TBoard count 21 at 4,Ri
  next
  for Ri = 0 to 9
    C = 48 + Ri
    put char C at ScrX(Ri), 3
    put char C at 3, ScrY(Ri)
    for Si = 0 to 9
      C = LNorm + GridAt(Si, Ri)
      put char C at ScrX(Si), ScrY(Ri)
    next
  next
  return
end sub

sub DrawPanel:
  print at 25,4, "SCORE"
  print ScoreB at 25,5
  print at 26,8, "781"
  print at 26,9, "6"
  put char TBall at 27,9
  print at 28,9, "2"
  print at 26,10, "543"
  print at 25,12, "TIME"
  print at 25,15, "WORTH"
  return
end sub

' the word asked for (row 2, centred) and the count (row 1)
sub ShowWord:
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  print at 2,1, "WORD"
  NumU = WP + 1
  print at 7,1, digits$(NumU, 2)
  print at 10,1, "OF 10"
  print at 22,1, "SKILL"
  NumU = Skill
  print at 28,1, digits$(NumU, 1)
  LoadWord(WP)
  L = WBuf[0]
  X = 15 - L / 2
  for Ti = 1 to L
    C = WBuf[Ti] + 65
    put char C at X, 2
    inc X
  next
  return
end sub

sub NewGame:
  NewScreen
  print at 6,11, "MAKING THE PUZZLE..."
  ShowScreen
  ChooseWords
  MakeGrid
  Rearm
  wait
  nmi off
  display off
  cls
  DrawGrid
  CurX = 4
  CurY = 4
  Sel = 0
  SpanN = 0
  DirN = 0
  WP = 0
  Waiting = 0
  NRight = 0
  Score = 0
  ScoreB = 0
  Rep = 0
  DrawPanel
  StartWord
  Mode = 2
  DrawCursor
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  return
end sub

sub StartWord:
  WT = 0
  SecF = 0
  ShowWord
  ShowClock
  return
end sub

' ---------------------------------------------------------------------------
' play

sub PlayStep:
  if Waiting = 1 then
    if Press1 = 1 or Press2 = 1 then
      Waiting = 0
      DirN = 0
      ClearResult
      NextWord
    end if
    return
  end if
  if WT < 65000 then inc WT
  inc SecF
  if SecF >= 60 then
    SecF = 0
    ShowClock
  end if
  StickMove
  if Press2 = 1 and Sel = 1 then
    RestoreSpan
    Sel = 0
    play sound SndDrop
  elseif Press1 = 1 then
    MarkEnd
  end if
  return
end sub

sub NextWord:
  inc WP
  if WP >= NWords then
    Mode = 4
  else
    StartWord
    play sound SndNewWord
  end if
  return
end sub

' the stick: a step on a new push (diagonals too), then repeats after 16
' frames, every 6
sub StickMove:
  V = Jy & 15
  if V = 0 then
    Rep = 0
    return
  end if
  Go = 0
  if Rep = 0 then
    Go = 1
    Rep = 16
  else
    dec Rep
    if Rep = 0 then
      Go = 1
      Rep = 6
    end if
  end if
  if Go = 0 then return
  X = CurX
  Y = CurY
  if V & 1 then
    if CurY > 0 then dec CurY
  elseif V & 2 then
    if CurY < 9 then inc CurY
  end if
  if V & 4 then
    if CurX > 0 then dec CurX
  elseif V & 8 then
    if CurX < 9 then inc CurX
  end if
  if CurX <> X or CurY <> Y then
    play sound SndStep
    if Sel = 1 then ShowSpan
  end if
  return
end sub

sub MarkEnd:
  if Sel = 0 then
    Sel = 1
    SelX = CurX
    SelY = CurY
    SpanN = 0
    ShowSpan
    play sound SndMark
  elseif CurX = SelX and CurY = SelY then
    RestoreSpan
    Sel = 0
    play sound SndDrop
  else
    TryWord
  end if
  return
end sub

sub RestoreSpan:
  if SpanN > 0 then
    Cx = SelX
    Cy = SelY
    for Si = 1 to SpanN
      put char SpanSave[Si - 1] at ScrX(Cx), ScrY(Cy)
      Cx += StX
      Cy += StY
    next
  end if
  SpanN = 0
  DirN = 0
  return
end sub

' the direction number (1-8, C64 order) of a step Sx, Sy
function DirOf(u8 Sx, u8 Sy) as u8
  u8 R = 0
  select case Sy
  case 255
    if Sx = 1 then
      R = 1
    elseif Sx = 0 then
      R = 8
    else
      R = 7
    end if
  case 0
    if Sx = 1 then
      R = 2
    elseif Sx = 255 then
      R = 6
    end if
  case else
    if Sx = 1 then
      R = 3
    elseif Sx = 0 then
      R = 4
    else
      R = 5
    end if
  end select
  return R

' the marked line from the first letter to the box, in yellow; only the
' first letter when the box is not on one of its eight lines
sub ShowSpan:
  i8 Dx = 0
  i8 Dy = 0
  u8 Ax = 0
  u8 Ay = 0
  RestoreSpan
  Dx = CurX - SelX
  Dy = CurY - SelY
  StX = 0
  StY = 0
  if Dx > 0 then
    StX = 1
    Ax = Dx
  elseif Dx < 0 then
    StX = 255
    Ax = 0 - Dx
  end if
  if Dy > 0 then
    StY = 1
    Ay = Dy
  elseif Dy < 0 then
    StY = 255
    Ay = 0 - Dy
  end if
  if Ax = 0 or Ay = 0 or Ax = Ay then
    SpanN = Ax
    if Ay > SpanN then SpanN = Ay
    inc SpanN
  else
    SpanN = 1
    StX = 0
    StY = 0
  end if
  DirN = DirOf(StX, StY)
  Cx = SelX
  Cy = SelY
  for Si = 0 to SpanN - 1
    J = GridAt(Cx, Cy)
    X = ScrX(Cx)
    Y = ScrY(Cy)
    SpanSave[Si] = get char at X, Y
    SpanLet[Si] = J
    put char LSel + J at X, Y
    Cx += StX
    Cy += StY
  next
  return
end sub

' 1 when the marked line, read from the first letter, spells word WP
function SpellsWord as u8
  u8 R = 1
  LoadWord(WP)
  for Si = 1 to SpanN
    if SpanLet[Si - 1] <> WBuf[Si] then R = 0
  next
  return R

' the points for an answer after WT frames (C64 lines 1360-1380)
function Points as u8
  u16 Lim = 0
  u16 Over = 0
  u8 P = 5
  Lim = SL
  Lim = Lim * 60
  if WT < Lim then
    P = 100
  else
    Lim = Lim * 20
    if WT < Lim then
      P = 10
    else
      Over = WT - Lim
      Over = Over + 59
      Over = Over / 60
      if Over >= 5 then
        P = 0
      else
        P = 5 - lowbyte Over
      end if
    end if
  end if
  return P

sub TryWord:
  L = WList[WP].Len
  if SpanN <> L or DirN = 0 then
    ' not a line, or the wrong length: ask again
    play sound SndBuzz
  elseif SpellsWord = 1 then
    Pts = Points
    Score += Pts
    ScoreB += Pts
    inc NRight
    Cx = SelX
    Cy = SelY
    for Si = 0 to SpanN - 1
      put char LFound + SpanLet[Si] at ScrX(Cx), ScrY(Cy)
      Cx += StX
      Cy += StY
    next
    SpanN = 0
    DirN = 0
    Sel = 0
    ClearResult
    print at 25,18, "YES"
    print at 25,19, "+"
    NumU = Pts
    print at 26,19, digits$(NumU, 3)
    print ScoreB at 25,5
    play sound SndYes
    NextWord
  else
    RestoreSpan
    Sel = 0
    ShowMissed
    play sound SndNo
    Waiting = 1
  end if
  return
end sub

' NO: the word's place in red, its ROW,COL and DIR in the panel
sub ShowMissed:
  Cx = WList[WP].X
  Cy = WList[WP].Y
  K = WList[WP].D
  LoadWord(WP)
  L = WBuf[0]
  for Ti = 1 to L
    put char LMiss + WBuf[Ti] at ScrX(Cx), ScrY(Cy)
    Cx += DirX[K]
    Cy += DirY[K]
  next
  DirN = K
  ClearResult
  print at 25,18, "NO"
  NumU = WList[WP].Y
  print at 25,19, digits$(NumU, 1)
  print at 26,19, ","
  NumU = WList[WP].X
  print at 27,19, digits$(NumU, 1)
  print at 25,20, "DIR"
  NumU = K
  print at 29,20, digits$(NumU, 1)
  print at 25,22, "PRESS"
  return
end sub

sub ClearResult:
  for Ri = 18 to 22
    fill 32 count 5 at 25,Ri
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0: the box on cell CurX, CurY; sprite 1: the box on the compass
' digit of the marked (or missed) direction
sub DrawCursor:
  if Mode <> 2 or Waiting = 1 then
    set sprite 0 to 192,0,0,0
  else
    X = ScrX(CurX) * 8 - 2
    Y = ScrY(CurY) * 8 - 3
    set sprite 0 to Y,X,SCur,15
  end if
  if DirN = 0 or Mode <> 2 then
    set sprite 1 to 192,0,0,0
  else
    X = CompX[DirN] * 8 - 2
    Y = CompY[DirN] * 8 - 3
    C = 11
    if Waiting = 1 then C = 9
    set sprite 1 to Y,X,SCur,C
  end if
  update sprites
  return
end sub

' the seconds for this word and what an answer is worth now
sub ShowClock:
  NumU = WT / 60
  if NumU > 999 then NumU = 999
  print at 25,13, digits$(NumU, 3)
  NumU = Points
  print at 25,16, digits$(NumU, 3)
  return
end sub

sub EndScreen:
  play sound SndDone
  for Ri = 1 to 2
    fill 32 count 28 at 2,Ri
  next
  print at 2,1, "ALL TEN WORDS! RIGHT"
  NumU = NRight
  print at 23,1, digits$(NumU, 2)
  print at 2,2, "FINAL SCORE"
  print ScoreB at 14,2
  print at 25,21, "PRESS"
  print at 25,22, "FIRE"
  return
end sub

' ---------------------------------------------------------------------------
' screens

' a little spaced grid (6 x 4) from HowGrid1/2 at Gx, Gy
sub DrawMini(u8 Gx, u8 Gy, u8 Which):
  K = 0
  for Ri = 0 to 3
    for Si = 0 to 5
      if Which = 1 then
        C = HowGrid1[K]
      else
        C = HowGrid2[K]
      end if
      C = C + LNorm
      X = Si * 2 + Gx
      Y = Ri * 2 + Gy
      put char C at X, Y
      inc K
    next
  next
  return
end sub

sub SetupPage:
  Menu = 0
  NewScreen
  print at 11,2, "WORD HUNT"
  print at 4,5, "SKILL"
  print at 4,7, "LIST"
  print at 4,10, "START"
  print at 3,14, "SKILL 1 (EASY) TO 5 (HARD)"
  print at 3,15, "SETS HOW FAST YOU MUST BE:"
  print at 3,19, "TEN WORDS, ONE AT A TIME,"
  print at 3,20, "IN A 10 X 10 GRID."
  ShowSetup
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  WasStick = 15
  Rep = 0
su_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 15
  Go = 0
  if V = 0 then
    Rep = 0
  elseif WasStick <> V then
    Go = 1
    Rep = 20
  else
    dec Rep
    if Rep = 0 then
      Go = 1
      Rep = 5
    end if
  end if
  WasStick = V
  if Go = 1 then
    if V & 1 then
      if Menu > 0 then dec Menu
    elseif V & 2 then
      if Menu < 2 then inc Menu
    elseif Menu = 0 then
      if V & 4 then
        if Skill > 1 then dec Skill
      else
        if Skill < 5 then inc Skill
      end if
    elseif Menu = 1 then
      if V & 4 then
        Theme = Theme + NThemes - 1
      else
        inc Theme
      end if
      Theme = Theme mod NThemes
    end if
    play sound SndStep
    ShowSetup
  end if
  if Press1 = 0 and Press2 = 0 then goto su_loop
  if Menu < 2 then
    Menu = 2
    ShowSetup
    goto su_loop
  end if
  SL = 9 - Skill
  play sound SndMark
  return
end sub

sub ShowSetup:
  put char 32 at 2,5
  put char 32 at 2,7
  put char 32 at 2,10
  select case Menu
  case 0
    put char 62 at 2,5
  case 1
    put char 62 at 2,7
  case else
    put char 62 at 2,10
  end select
  print at 15,5, "<"
  NumU = Skill
  print at 17,5, digits$(NumU, 1)
  print at 19,5, ">"
  print at 15,7, "<"
  PrintTheme(17, 7)
  print at 26,7, ">"
  ' 100 points within 9 - SKILL seconds, 10 within 20 times that
  fill 32 count 26 at 3,16
  fill 32 count 26 at 3,17
  print at 3,16, "100 POINTS IN"
  NumU = 9 - Skill
  print at 17,16, digits$(NumU, 1)
  print at 19,16, "SECONDS,"
  print at 3,17, "10 POINTS IN"
  NumU = NumU * 20
  print at 16,17, digits$(NumU, 3)
  print at 20,17, "SECONDS."
  return
end sub

sub PrintTheme(u8 Px, u8 Py):
  select case Theme
  case 0
    print at Px,Py, "ANIMALS "
  case 1
    print at Px,Py, "FOOD    "
  case 2
    print at Px,Py, "SPORTS  "
  case 3
    print at Px,Py, "SPACE   "
  case 4
    print at Px,Py, "OCEAN   "
  case else
    print at Px,Py, "COMPUTER"
  end select
  return
end sub

' the title: the C64's box of balls around WORD HUNT, the menu, the tune
sub TitlePage:
  Menu = 0
  TitleOn = 1
  Mode = 0
  NewScreen
  fill TBall count 22 at 5,3
  fill TBall count 22 at 5,9
  for Ri = 4 to 8
    put char TBall at 5,Ri
    put char TBall at 26,Ri
  next
  for Ri = 5 to 7
    fill TBoard count 19 at 7,Ri
  next
  K = 0
  for Si = 0 to 8
    select case Si
    case 0
      C = 22
    case 1
      C = 14
    case 2
      C = 17
    case 3
      C = 3
    case 4
      C = 255
    case 5
      C = 7
    case 6
      C = 20
    case 7
      C = 13
    case else
      C = 19
    end select
    if C <> 255 then
      put char LFound + C at Si * 2 + 8, 6
    end if
  next
  print at 7,12, "COMPUTE!S GAZETTE"
  print at 11,13, "JULY 1983"
  print at 11,16, "START GAME"
  print at 11,17, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 540
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
tp_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 3
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press1 = 0 and Press2 = 0 then goto tp_loop
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,16
  put char 32 at 9,17
  put char 32 at 9,18
  J = Menu + 16
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: two pages with a little grid; a button turns the page, 30 s
' idle goes back
u8 HPg = 0
u16 HWt = 0
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "TEN WORDS ARE HIDDEN IN THE"
    print at 2,4, "GRID: ACROSS, DOWN OR"
    print at 2,5, "DIAGONAL, FORWARD OR BACK."
    print at 2,6, "THEY ARE ASKED ONE AT A"
    print at 2,7, "TIME, LONGEST FIRST, ONE TRY"
    print at 2,8, "EACH. BE QUICK: 100 POINTS"
    print at 2,9, "IN 9-SKILL SECONDS, 10 IN 20"
    print at 2,10, "TIMES THAT, THEN 5 OR LESS."
    print at 2,11, "AFTER TEN WORDS: THE SCORE."
    DrawMini(6, 14, 1)
    print at 19,14, "TIGER"
    print at 19,16, "+100"
  else
    print at 2,3, "STICK: MOVE THE BOX. BUTTON"
    print at 2,4, "ON THE WORD'S FIRST LETTER,"
    print at 2,5, "THEN ON ITS LAST LETTER."
    print at 2,6, "RIGHT BUTTON: LET GO."
    print at 2,7, "WRONG: NO, AND THE WORD IS"
    print at 2,8, "SHOWN IN RED (ROW,COL,DIR)."
    print at 2,10, "TIP: LOOK FOR ITS RAREST"
    print at 2,11, "LETTER FIRST."
    DrawMini(6, 14, 2)
    print at 19,16, "OWL"
    ' the box on the L of OWL (cell 5, 1: column 16, row 16)
    set sprite 0 to 125,126,SCur,15
  end if
  print at 8,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then
    HideSprites
    return
  end if
  if Press1 = 0 and Press2 = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B4
  backdrop dark blue
  print at 10,2, "WORD HUNT"
  print at 2,5, "BASED ON WORD HUNT,"
  print at 2,6, "COMPUTE!S GAZETTE,"
  print at 2,7, "JULY 1983"
  print at 2,8, "(COMMODORE 64 AND VIC-20,"
  print at 2,9, "BASIC)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND WORD LISTS BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: TEN HIDDEN WORDS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      mute all
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Jy = J1 | J2
  Press1 = 0
  Press2 = 0
  V = Jy & 16
  if V > 0 and WasB1 = 0 then Press1 = 1
  WasB1 = V
  V = Jy & 32
  if V > 0 and WasB2 = 0 then Press2 = 1
  WasB2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  copy TileCol count NTiles8 to vram.color + 3072
  copy TileCol count NTiles8 to vram.color + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

