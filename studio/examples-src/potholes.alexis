  $0F,$0F,$AF,$AF,$AF,$0F,$0F,$0F
  $8F,$F8,$8F,$8F,$8F,$F8,$F8,$F8
  $F8,$F8,$F8,$8F,$8F,$8F,$F8,$8F
  $8F,$8F,$F8,$F8,$F8,$F8,$8F,$8F
  $8F,$F8,$F8,$F8,$F8,$F8,$F8,$8F
  $4F,$F4,$4F,$4F,$4F,$F4,$F4,$F4
  $F4,$F4,$F4,$4F,$4F,$4F,$F4,$4F
  $4F,$4F,$F4,$F4,$F4,$F4,$4F,$4F
  $4F,$F4,$F4,$F4,$F4,$F4,$F4,$4F
  $0F,$DF,$DF,$FD,$DF,$DF,$0F,$0F
  $0F,$0F,$0F,$0F,$0F,$0F,$0F,$0F
end data
data SpritePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
PhCrash:
    db $00,$00,$05,$02,$00,$00,$06,$02,$00,$00,$15,$02,$00,$00,$16,$02,$00,$00,$25,$02,$00,$00,$26,$02
    db $00,$00,$35,$02,$00,$00,$36,$02,$00,$00,$45,$02,$00,$00,$46,$02,$00,$00,$55,$02,$00,$00,$56,$02
    db $00,$00,$65,$02,$00,$00,$66,$02,$00,$00,$75,$02,$00,$00,$76,$02,$00,$00,$85,$02,$00,$00,$86,$02
    db $00,$00,$95,$02,$00,$00,$96,$02,$00,$00,$A5,$02,$00,$00,$A6,$02,$00,$00,$B5,$02,$00,$00,$B6,$02
    db $00,$00,$C5,$02,$00,$00,$C6,$02,$00,$00,$D5,$02,$00,$00,$D6,$02,$00,$00,$E5,$02,$00,$00,$E6,$02
    db $00,$00,$F5,$02,$00,$00,$F6,$02,$10
PhBlop:
    db $40,$46,$10,$02,$40,$06,$12,$03,$40,$FE,$F0,$01,$50
PhBonus:
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02,$40,$C4,$10,$03,$40,$9A,$10,$02
    db $40,$FE,$F0,$01,$50
PhOver:
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01,$40,$47,$12,$01,$40,$EB,$11,$01
    db $40,$47,$12,$01,$40,$EB,$11,$01,$40,$FE,$F0,$01,$50
PhTick:
    db $40,$40,$50,$01,$50

PhSoundTable:
    dw PhCrash,$702B
    dw PhBlop,$7035
    dw PhBonus,$7035
    dw PhOver,$7035
    dw PhTick,$7035
    dw PhTuneMel,$703F
    dw PhTuneBass,$7049
; Road Crew Rag, C (original for this game)
; Tiny Sound, 6 frames per step
PhTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$1A,$21,$23,$00,$26,$23,$1F,$00,$21,$23,$00,$00,$22,$23
    db $26,$00,$00,$00,$28,$00,$26,$23,$1F,$00,$21,$00,$23,$00,$1F,$00
    db $1C,$00,$00,$00,$24,$00,$28,$24,$21,$00,$23,$24,$26,$00,$25,$26
    db $2A,$00,$28,$26,$23,$00,$21,$00,$1F,$00,$1A,$00,$1F,$00,$23,$00
    db $2B,$00,$00,$00
    db $FF
PhTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$70,$F1,$22,$07,$0E,$0B,$0E,$07,$0E,$0B,$0E,$0E,$15,$12,$15
    db $07,$0E,$0B,$0E,$0C,$13,$10,$13,$07,$0E,$0B,$0E,$09,$10,$0C,$10
    db $0E,$15,$12,$15,$0C,$13,$10,$13,$0C,$13,$10,$13,$0B,$12,$0E,$12
    db $0B,$12,$0E,$12,$09,$10,$0C,$10,$0E,$15,$12,$15,$07,$0E,$0B,$0E
    db $07,$00,$00,$00
    db $FF

; OrCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
OrCell:
    ld hl,(AMY_UVAR_Bx)
    ld de,22
    ld b,0
OrCellDiv:
    or a
    sbc hl,de
    jr c,OrCellRem
    inc b
    jr OrCellDiv
OrCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; OrPeek: Pk = the tile at B
OrPeek:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Pk),a
    ret

; OrPoke: the tile Tl at B
OrPoke:
    call OrCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret
}
