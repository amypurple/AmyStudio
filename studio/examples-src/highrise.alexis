asm {
; HrScroll: the building's 20 tiles show the window at row Cs of each
; column strip: 32 pattern bytes a strip into each third, then the colours
; (shared by the thirds in tile screen); 32 cycles a byte (outi, nop),
; with the NMI off
HrScroll:
    ld de,VRAM_PATTERN+1024
    call HrPat
    ld de,VRAM_PATTERN+3072
    call HrPat
    ld de,VRAM_PATTERN+5120
    call HrPat
    ld de,VRAM_COLOR+1024
    ld hl,AMY_UDATA_StripC
    jr HrSet
HrPat:
    ld hl,AMY_UDATA_Strip
HrSet:
    ld a,(AMY_UVAR_Cs)
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    ld a,5
HrT:
    push af
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    push hl
    ld b,32
    ld c,$BE
HrL:
    outi
    nop
    jr nz,HrL
    pop hl
    ld bc,64
    add hl,bc
    ex de,hl
    ld bc,32
    add hl,bc
    ex de,hl
    pop af
    dec a
    jr nz,HrT
    ret
HrBoard:
    db $40,$6B,$20,$03,$40,$55,$30,$06,$50
HrLeave:
    db $40,$55,$20,$03,$40,$6B,$30,$06,$50
HrFloor:
    db $40,$47,$20,$03,$40,$35,$20,$03,$40,$2A,$30,$08,$50
HrPush:
    db $40,$40,$10,$04,$40,$50,$20,$04,$40,$5F,$20,$04,$40,$71,$20,$04,$40,$8F,$30,$06,$40,$BF,$30,$08
    db $40,$1D,$41,$0E,$50
HrShock:
    db $00,$00,$04,$02,$00,$00,$15,$02,$00,$00,$04,$02,$00,$00,$15,$02,$00,$00,$14,$02,$00,$00,$15,$02
    db $00,$00,$26,$04,$00,$00,$47,$0A,$10
HrCarry:
    db $40,$2A,$10,$02,$40,$30,$20,$02,$40,$2A,$10,$02,$40,$35,$20,$02,$40,$2A,$20,$02,$40,$30,$20,$03
    db $40,$40,$30,$08,$50
HrZap:
    db $00,$00,$04,$02,$00,$00,$25,$04,$00,$00,$46,$0A,$10
HrThud:
    db $00,$00,$06,$03,$00,$00,$27,$06,$00,$00,$57,$0C,$10
HrSafe:
    db $40,$D6,$10,$05,$40,$AA,$10,$05,$40,$8F,$10,$05,$40,$6B,$20,$0A,$40,$8F,$20,$05,$40,$6B,$20,$12
    db $50
HrOver:
    db $40,$1D,$11,$0A,$40,$53,$21,$0A,$40,$AB,$31,$0A,$40,$3B,$42,$1A,$50
HrTick:
    db $40,$47,$20,$02,$50

HrSoundTable:
    dw HrTuneMel,$702B
    dw HrTuneBass,$7035
    dw HrRunMel,$702B
    dw HrRunBass,$7035
    dw HrBoard,$7049
    dw HrLeave,$7049
    dw HrFloor,$7049
    dw HrPush,$7049
    dw HrShock,$703F
    dw HrCarry,$7049
    dw HrZap,$703F
    dw HrThud,$703F
    dw HrSafe,$7049
    dw HrOver,$7049
    dw HrTick,$7049
; Girders at Dusk (original)
; Tiny Sound, 7 frames per step
HrTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$15,$01,$01,$01,$18,$01,$1C,$01,$21,$01,$01,$01
    db $1F,$01,$1C,$01,$1D,$01,$01,$01,$1C,$01,$1A,$01,$1C,$01,$01,$01
    db $00,$01,$01,$01,$21,$01,$01,$01,$23,$01,$24,$01,$26,$01,$24,$01
    db $23,$01,$20,$01,$21,$01,$01,$01,$1C,$01,$18,$01,$15,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
