    db 7
    db $02,$60,$18,$32,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15
    db $09,$15,$09,$15,$05,$11,$05,$11,$05,$11,$05,$11,$05,$11,$05,$11
    db $05,$11,$05,$11,$0E,$1A,$0E,$1A,$0E,$1A,$0E,$1A,$0E,$1A,$0E,$1A
    db $0E,$1A,$0E,$1A,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15,$09,$15
    db $09,$15,$09,$15
    db $FF

