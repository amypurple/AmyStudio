    db $16,$01,$01,$01,$17,$01,$01,$01,$1A,$01,$01,$01,$19,$01,$01,$01
    db $01,$01,$01,$01,$1E,$01,$01,$01,$1F,$01,$01,$01,$1E,$01,$01,$01
    db $1D,$01,$01,$01,$1E,$01,$01,$01,$1A,$01,$01,$01,$17,$01,$01,$01
