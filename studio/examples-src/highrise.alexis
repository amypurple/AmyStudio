cartridge "HIGH RISE/CHARLES MCGUYER, COMPUTE!/1986"

' HIGH RISE
' Based on "High Rise" by Charles McGuyer, COMPUTE! February 1986 (pages
' 49-56; Commodore 64 machine language, with Atari and Apple II versions by
' Kevin Mykytyn and Tim Victor). Made for the ColecoVision in Amy (the
' language by Amy Bienvenu) by Claude (an AI made by Anthropic) for Amy
' Studio, 2026.
'
' Not a port (the listings are machine code; orig/ has the scans): a
' ColecoVision game on the article's rules. You are a construction worker
' trapped after dark on a high floor of a building going up. The temporary
' elevators run by themselves, up and down, stopping at some floors and
' skipping others: walk into a car at your floor (it picks you up), ride,
' and walk out at a lower floor. Each new floor down is 100 points. At the
' lowest floor shown the building scrolls up a floor; at the ground you
' sprint off to safety, and the next round starts higher. The patrol robot
' sweeps the building floor by floor, going up and down through closed
' shafts at the two ends: if it reaches you on your floor it pushes you off
' the building, and if it runs into the car you are riding it electrifies
' it. Birds of prey swoop from floor to floor and carry you off, even from
' inside a car; a bird that meets the robot is zapped and falls, and a
' falling bird knocks you down. Five workers; the high score is kept.
'
' Modes (title menu): C64 (start at floor 10; the robot shocks the car),
' ATARI (start at floor 15; no shock, and birds are not zapped by the
' robot), EASY (the Apple version: no birds).
'
' Controls (either joystick): left and right walk, and step out of a car
' when it is level with a floor (let the stick go after boarding first).
' Up and down and the button work the menus. Keypad not used.
'
' Made for this machine: the building repeats every floor, so it scrolls
' smoothly (2 pixels a frame) by copying a window of five 32-pixel column
' strips into 20 tiles (HrScroll, 32 cycles a byte); the name table never
' changes. Elevator cars, the worker, the robot and the birds are sprites
' (two overlapped sprites each for the last three, for two colours). Twelve
' sprites can put more than four on a line, so after the worker (always
' drawn first, in front of the car he rides) the groups (bird, bird, robot,
' cars) take turns at the front every frame: a crowded line flickers
' instead of losing a sprite for good. Music "Night Shift" plays under the
' game, quieter than the effects (music first in the sound table); an
' original title tune, "Girders at Dusk".
'
' House rules kept: text in columns 2-29; tiles from code 128; the frame
' loop is protected from the NMI and every screen is drawn with the NMI off
' after a wait.

const TO0 = 128
const TO1 = 129
const TO2 = 130
const TO3 = 131
const TG0 = 132
const TG1 = 133
const TG2 = 134
const TG3 = 135
const TSl0 = 136
const TSl1 = 137
const TSl2 = 138
const TSl3 = 139
const TSr0 = 140
const TSr1 = 141
const TSr2 = 142
const TSr3 = 143
const TR0 = 144
const TR1 = 145
const TR2 = 146
const TR3 = 147
const TSky = 148
const TStar = 149
const TWall = 150
const TWall2 = 151
const TRoof = 152
const TSpire = 153
const TCrane = 154
const TMast = 155
const TMoon00 = 156
const TMoon01 = 157
const TMoon10 = 158
const TMoon11 = 159
const TRule = 160
const SWk0b = 0
const SWk0y = 4
const SWk0bl = 8
const SWk0yl = 12
const SWk1b = 16
const SWk1y = 20
const SWk1bl = 24
const SWk1yl = 28
const SWk2b = 32
const SWk2y = 36
const SWk2bl = 40
const SWk2yl = 44
const SWk3b = 48
const SWk3y = 52
const SWk3bl = 56
const SWk3yl = 60
const SRb0g = 64
const SRb0r = 68
const SRb1g = 72
const SRb1r = 76
const SBur = 80
const SBuy = 84
const SBurl = 88
const SBuyl = 92
const SBdr = 96
const SBdy = 100
const SBdrl = 104
const SBdyl = 108
const SBfr = 112
const SBfy = 116
const SCar = 120
const SSpark = 124
const NTiles8 = 264
const SprBytes = 1024
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndBoard = 5
const SndLeave = 6
const SndFloor = 7
const SndPush = 8
const SndShock = 9
const SndCarry = 10
const SndZap = 11
const SndThud = 12
const SndSafe = 13
const SndOver = 14
const SndTick = 15
u16 TzLeft = 0
u8 TzOn = 0

' Ph: 1 playing, 0 paused (ready, round end), 3 game over
u8 Ph = 0
u8 Mode = 0
u8 Round = 1
u8 Men = 5
' Score and Hi in hundreds (shown with "00")
u16 Score = 0
u16 Hi = 0
' Hf the top floor; Vt the top floor shown (floors Vt-4 .. Vt are shown)
u8 Hf = 11
u8 Vt = 11
' Cam: the world pixel row at the top of the building's view (row 2);
' world y grows downward, floor F's band starts at (Hf - F) * 32
u16 Cam = 0
u8 Cs = 0
' Sdir: 0 still, 1 scrolling down a floor, 2 up; Srem frames left
u8 Sdir = 0
u8 Srem = 0
' the worker: Pst 0 on a floor, 1 in car Pc, 2 lost (Dk the way, Dt its
' frames), 3 sprinting off at the ground; Pf the floor, Px x, Py world y,
' Pdir 0 right 1 left, Rel 1 once the stick was let go in the car, Low the
' lowest floor stepped onto, Mv 1 if he walked this frame
u8 Pst = 0
u8 Pf = 0
u8 Px = 120
u16 Py = 0
u8 Pc = 0
u8 Pdir = 0
u8 Rel = 0
u8 Low = 0
u8 Pan = 0
u8 Mv = 0
u8 Dk = 0
u8 Dt = 0
u8 Cb = 0
' the cars: Ey world y (the top of the cage), Eg the goal, Ew frames to wait
' (0: moving)
u16 Ey[4]
u16 Eg[4]
u8 Ew[4]
' the robot: Rf floor, Rx x, Rst 0 walking 1 in an end shaft (to floor Rn,
' world y RyW toward Rg), Rdir 1 right 0 left, Rv 1 going down the
' building 0 up, Racc/Rspd its pace in 16ths of a pixel
u8 Rf = 0
u8 Rx = 32
u8 Rst = 0
u8 Rn = 0
u16 RyW = 0
u16 Rg = 0
u8 Rdir = 1
u8 Rv = 1
u8 Racc = 0
u8 Rspd = 8
' the birds: Bs 0 flying, 1 swooping to Bg, 2 falling (Bv its speed),
' 3 carrying you, 4 away (Bt frames), 5 none; Bx, By, Bd 1 right 0 left
u8 Bn = 0
u8 Bx[2]
u16 By[2]
u16 Bg[2]
u8 Bs[2]
u8 Bd[2]
u8 Bt[2]
u8 Bv[2]
u8 Fs = 255
u8 Idle = 0

u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
u16 B16 = 0
u16 C16 = 0
u8 Menu = 0
u8 KL = 0
u8 KR = 0
u8 KU = 0
u8 KD = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 Bi = 0
u8 Gi = 0
u8 Gr = 0
u8 Ss = 0
u8 Blk = 0
u8 D = 0
u8 F = 0
u8 G = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table HrSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    CreditsPage
    goto title
  end if

new_game:
  Score = 0
  Men = 5
  Round = 1

new_round:
  SetupRound
  BuildPlay
  ShowScreen
  play sound SndRunA
  play sound SndRunB
  Ready

play_loop:
  Frame1
  ReadPad
  MoveCars
  Mv = 0
  if Pst < 2 then MovePlayer
  if Pst = 3 then
    ' the sprint off at the ground
    Pdir = 1
    Mv = 1
    if Px < 4 then goto round_won
    Px = Px - 3
  end if
  MoveRobot
  MoveBirds
  if Pst < 2 then Hits
  if Pst = 2 then
    DeathStep
    if Dt = 0 then goto life_lost
  end if
  if Pst <> 2 then Follow
  CamStep
  DrawAll
  UpdFloor
  goto play_loop

round_won:
  Ph = 0
  stop sound SndRunA
  stop sound SndRunB
  play sound SndSafe
  print at 18,22, "SAFE!"
  for Tm = 1 to 120
    Frame1
    DrawAll
  next
  if Round < 99 then inc Round
  goto new_round

life_lost:
  Ph = 0
  dec Men
  ShowHud
  if Men = 0 then goto game_over
  Respawn
  Ready
  goto play_loop

game_over:
  Ph = 3
  stop sound SndRunA
  stop sound SndRunB
  play sound SndOver
  if Score > Hi then Hi = Score
  ShowHud
  print at 18,22, "GAME OVER"
  for Tm = 1 to 90
    Frame1
    DrawAll
  next
  print at 18,22, "FIRE/DOWN "
  WasBtn = 1
over_wait:
  Frame1
  ReadPad
  DrawAll
  if KD = 1 then goto title
  if Press = 0 then goto over_wait
  goto new_game

' ---------------------------------------------------------------------------

' StandY(F): W16 = the world y of a figure standing on floor F
sub StandY(u8 Sf):
  W16 = Hf
  W16 = W16 - Sf
  W16 = W16 << 5
  W16 = W16 + 8
  return
end sub

' Dist(A, B): D = how far apart two x positions are
sub Dist(u8 Da, u8 Db):
  if Da > Db then
    D = Da - Db
  else
    D = Db - Da
  end if
  return
end sub

' YDist: D = how far apart world rows A16 and B16 are (at most 200)
sub YDist:
  if A16 > B16 then
    C16 = A16 - B16
  else
    C16 = B16 - A16
  end if
  if C16 > 200 then
    D = 200
  else
    D = C16
  end if
  return
end sub

' SetupRound: the start floor for the mode and round, everyone placed
sub SetupRound:
  F = 10
  if Mode = 1 then F = 15
  V = Round - 1
  V = V * 3
  F = F + V
  if F > 28 then F = 28
  Hf = F + 1
  Vt = Hf
  Cam = 0
  Cs = 0
  Sdir = 0
  Pf = F
  Low = F
  Px = 120
  Pdir = 1
  Pst = 0
  Rel = 0
  ' the robot starts at the top, walking right, sweeping downward
  Rf = Hf
  Rx = 32
  Rdir = 1
  Rv = 1
  Rst = 0
  Racc = 0
  V = Round * 2
  Rspd = 6 + V
  if Rspd > 16 then Rspd = 16
  StandY(Rf)
  RyW = W16
  ' the cars: anywhere from four floors below the start to the top
  for K = 0 to 3
    G = random(0, 5)
    if G > F then
      G = 0
    else
      G = F - G
    end if
    StandY(G)
    Ey[K] = W16
    Eg[K] = W16
    V = random(20, 120)
    Ew[K] = V
  next
  ' the birds: none in EASY, one for two rounds, then two
  Bn = 2
  if Round < 3 then Bn = 1
  if Mode = 2 then Bn = 0
  for Bi = 0 to 1
    Bs[Bi] = 5
    if Bi < Bn then
      Bs[Bi] = 4
      V = random(120, 220)
      Bt[Bi] = V
    end if
  next
  Fs = 255
  return
end sub

' Respawn: the next worker on the lowest floor reached, away from the robot
sub Respawn:
  Pst = 0
  Pf = Low
  Px = 120
  Pdir = 1
  if Rst = 0 then
    if Rf = Pf then
      if Rx < 120 then
        Px = 207
      else
        Px = 33
      end if
    end if
  end if
  for Bi = 0 to 1
    if Bs[Bi] <> 5 then
      Bs[Bi] = 4
      V = random(120, 200)
      Bt[Bi] = V
    end if
  next
  return
end sub

' Ready: a moment before play (the camera settles on the worker)
sub Ready:
  Ph = 0
  print at 18,22, "READY     "
  for Tm = 1 to 70
    Frame1
    Follow
    CamStep
    DrawAll
  next
  print at 18,22, "          "
  Fs = 255
  UpdFloor
  Ph = 1
  return
end sub

' MoveCars: a waiting car counts down, then heads 1-4 floors up or down;
' a moving car goes a pixel a frame and waits when it gets there
sub MoveCars:
  for K = 0 to 3
    V = Ew[K]
    if V > 0 then
      dec V
      Ew[K] = V
      if V = 0 then
        CarGo(K)
      end if
    else
      A16 = Ey[K]
      B16 = Eg[K]
      if A16 < B16 then
        A16 = A16 + 1
      else
        A16 = A16 - 1
      end if
      Ey[K] = A16
      if A16 = B16 then
        V = random(40, 140)
        Ew[K] = V
      end if
    end if
  next
  return
end sub

' CarGo(C): car C's next goal (it skips floors: 1 to 4 at a time)
sub CarGo(u8 Cc):
  A16 = Ey[Cc]
  A16 = A16 - 8
  A16 = A16 >> 5
  V = A16
  G = Hf - V
  T = random(0, 1)
  if G = 0 then T = 0
  if G >= Hf then T = 1
  N = random(1, 4)
  if T = 0 then
    G = G + N
    if G > Hf then G = Hf
  else
    if N > G then
      G = 0
    else
      G = G - N
    end if
  end if
  StandY(G)
  Eg[Cc] = W16
  if Ey[Cc] = W16 then Ew[Cc] = 30
  return
end sub

' MovePlayer: walking (the shafts' gates stop him unless the car is there,
' then he is in it), or riding (out at a floor, stick left or right)
sub MovePlayer:
  if Pst = 0 then
    StandY(Pf)
    Py = W16
    N = Px
    if KL = 1 then
      Pdir = 1
      if Px > 32 then N = Px - 1
    end if
    if KR = 1 then
      Pdir = 0
      if Px < 208 then N = Px + 1
    end if
    if N <> Px then TryStep
  else
    K = Pc
    Py = Ey[K]
    V = KL | KR
    if V = 0 then Rel = 1
    if Rel = 1 then
      if V = 1 then TryLeave
    end if
  end if
  return
end sub

sub TryStep:
  Blk = 0
  for J = 0 to 3
    X = ShX[J]
    Dist(N, X)
    if D < 14 then
      StandY(Pf)
      if Ey[J] = W16 then
        Pst = 1
        Pc = J
        Px = X
        Rel = 0
        Blk = 2
        play sound SndBoard
      else
        Blk = 1
      end if
    end if
  next
  if Blk = 0 then
    Px = N
    Mv = 1
    inc Pan
  end if
  return
end sub

sub TryLeave:
  K = Pc
  A16 = Ey[K]
  A16 = A16 - 8
  B16 = A16 & 31
  if B16 <> 0 then return
  A16 = A16 >> 5
  V = A16
  F = Hf - V
  Pst = 0
  Pf = F
  X = ShX[K]
  if KL = 1 then
    Px = X - 14
    Pdir = 1
  else
    Px = X + 14
    Pdir = 0
  end if
  if F < Low then
    V = Low - F
    Score = Score + V
    if Score > 9999 then Score = 9999
    Low = F
    play sound SndFloor
    ShowScore
  else
    play sound SndLeave
  end if
  if F = 0 then Pst = 3
  return
end sub

' MoveRobot: across its floor, down (or up) a floor in the end shaft, back
sub MoveRobot:
  Racc = Racc + Rspd
  if Racc < 16 then return
  Racc = Racc - 16
  if Rst = 0 then
    if Rdir = 1 then
      inc Rx
      if Rx >= 224 then RobotShaft
    else
      dec Rx
      if Rx <= 16 then RobotShaft
    end if
  else
    if RyW < Rg then
      RyW = RyW + 1
    else
      RyW = RyW - 1
    end if
    if RyW = Rg then
      Rst = 0
      Rf = Rn
      Rdir = Rdir ^ 1
    end if
  end if
  return
end sub

sub RobotShaft:
  Rst = 1
  if Rv = 1 then
    if Rf = 0 then Rv = 0
  else
    if Rf >= Hf then Rv = 1
  end if
  if Rv = 1 then
    Rn = Rf - 1
  else
    Rn = Rf + 1
  end if
  StandY(Rn)
  Rg = W16
  return
end sub

' MoveBirds: fly across (wrapping round), now and then swoop to your floor
' (or any floor shown); a zapped bird falls off the bottom; away birds
' come back from a side
sub MoveBirds:
  for Bi = 0 to 1
    V = Bs[Bi]
    if V = 4 then
      W = Bt[Bi]
      dec W
      Bt[Bi] = W
      if W = 0 then BirdSpawn
    end if
    if V < 2 then BirdFly
    if V = 2 then BirdFall
  next
  return
end sub

sub BirdFly:
  X = Bx[Bi]
  W = 1
  if Round > 3 then
    W = Tick & 1
    W = W + 1
  end if
  if Bd[Bi] = 1 then
    X = X + W
  else
    X = X - W
  end if
  Bx[Bi] = X
  if Bs[Bi] = 0 then
    W = random(0, 99)
    if W < 2 then BirdAim
    if W = 2 then BirdAny
    if Bs[Bi] = 0 then
      ' out of sight above or below: back to a floor shown
      A16 = By[Bi]
      StandY(Vt)
      if A16 < W16 then BirdAim
      V = Vt - 4
      StandY(V)
      if A16 > W16 then BirdAim
    end if
  else
    A16 = By[Bi]
    B16 = Bg[Bi]
    if A16 < B16 then
      A16 = A16 + 1
    else
      A16 = A16 - 1
    end if
    By[Bi] = A16
    if A16 = B16 then Bs[Bi] = 0
  end if
  return
end sub

' BirdAim: swoop toward your floor (the nearest floor to your car)
sub BirdAim:
  T = Pf
  if Pst = 1 then
    K = Pc
    A16 = Ey[K]
    A16 = A16 + 8
    A16 = A16 >> 5
    V = A16
    T = Hf - V
  end if
  V = Vt - 4
  if T < V then T = V
  if T > Vt then T = Vt
  BirdTo
  return
end sub

' BirdAny: swoop to any floor shown
sub BirdAny:
  V = random(0, 4)
  T = Vt - V
  BirdTo
  return
end sub

sub BirdTo:
  StandY(T)
  if By[Bi] <> W16 then
    Bg[Bi] = W16
    Bs[Bi] = 1
  end if
  return
end sub

sub BirdFall:
  W = Bv[Bi]
  if W < 12 then inc W
  Bv[Bi] = W
  W = W >> 2
  W = W + 1
  A16 = By[Bi]
  A16 = A16 + W
  By[Bi] = A16
  A16 = A16 + 16
  if A16 > Cam then
    A16 = A16 - Cam
    if A16 > 176 then
      Bs[Bi] = 4
      V = random(90, 200)
      Bt[Bi] = V
    end if
  end if
  return
end sub

sub BirdSpawn:
  V = random(0, 4)
  T = Vt - V
  StandY(T)
  By[Bi] = W16
  V = random(0, 1)
  if V = 0 then
    Bx[Bi] = 0
    Bd[Bi] = 1
  else
    Bx[Bi] = 240
    Bd[Bi] = 0
  end if
  Bs[Bi] = 0
  return
end sub

' Hits: the robot's push, its shock, a bird's grab, a falling bird; then
' birds meeting the robot are zapped (not in ATARI mode)
sub Hits:
  if Pst = 0 then
    if Rst = 0 then
      if Rf = Pf then
        Dist(Rx, Px)
        if D < 12 then
          Die(1)
          return
        end if
      end if
    end if
  end if
  if Pst = 1 then
    if Mode <> 1 then
      if Rst = 0 then
        StandY(Rf)
        K = Pc
        if Ey[K] = W16 then
          X = ShX[K]
          Dist(Rx, X)
          if D < 12 then
            Die(2)
            return
          end if
        end if
      end if
    end if
  end if
  for Bi = 0 to 1
    if Pst < 2 then
      V = Bs[Bi]
      if V < 3 then
        A16 = By[Bi]
        B16 = Py
        YDist
        if D < 12 then
          X = Bx[Bi]
          Dist(X, Px)
          if D < 12 then
            if V = 2 then
              Die(4)
            else
              Bs[Bi] = 3
              Cb = Bi
              Die(3)
            end if
          end if
        end if
      end if
    end if
  next
  if Mode = 1 then return
  for Bi = 0 to 1
    if Bs[Bi] < 2 then
      A16 = By[Bi]
      B16 = RyW
      YDist
      if D < 12 then
        X = Bx[Bi]
        Dist(X, Rx)
        if D < 12 then
          Bs[Bi] = 2
          Bv[Bi] = 0
          play sound SndZap
        end if
      end if
    end if
  next
  return
end sub

' Die(K): the worker is lost (1 pushed off, 2 shocked, 3 carried off,
' 4 knocked down)
sub Die(u8 Kd):
  Pst = 2
  Dk = Kd
  Dt = 1
  if Kd = 1 then
    play sound SndPush
  end if
  if Kd = 2 then
    play sound SndShock
  end if
  if Kd = 3 then
    play sound SndCarry
  end if
  if Kd = 4 then
    play sound SndThud
  end if
  return
end sub

' DeathStep: the loss plays out; Dt back to 0 when it is over
sub DeathStep:
  inc Dt
  if Dk = 1 then
    if Dt < 16 then
      if Rdir = 1 then
        if Px < 238 then Px = Px + 2
      else
        if Px > 2 then Px = Px - 2
      end if
    else
      Py = Py + 3
    end if
    if Dt >= 60 then Dt = 0
    return
  end if
  if Dk = 2 then
    K = Pc
    Py = Ey[K]
    if Dt >= 60 then Dt = 0
    return
  end if
  if Dk = 3 then
    A16 = By[Cb]
    A16 = A16 - 2
    By[Cb] = A16
    Py = A16 + 4
    V = Bx[Cb]
    Px = V
    if Dt >= 70 then Dt = 0
    return
  end if
  Py = Py + 2
  if Dt >= 50 then Dt = 0
  return
end sub

' Follow: keep the worker in view (a floor's scroll at a time)
sub Follow:
  if Sdir <> 0 then return
  if Pst = 0 then
    StandY(Pf)
    Py = W16
  end if
  if Pst = 3 then
    StandY(Pf)
    Py = W16
  end if
  if Vt > 4 then
    V = Vt - 4
    StandY(V)
    if Py >= W16 then
      Sdir = 1
      Srem = 16
      return
    end if
  end if
  if Vt < Hf then
    StandY(Vt)
    if Py < W16 then
      Sdir = 2
      Srem = 16
    end if
  end if
  return
end sub

' CamStep: scroll 2 pixels (the tiles' window moves, HrScroll)
sub CamStep:
  if Sdir = 0 then return
  if Sdir = 1 then
    Cam = Cam + 2
  else
    Cam = Cam - 2
  end if
  W16 = Cam & 31
  Cs = W16
  call asm HrScroll
  dec Srem
  if Srem = 0 then
    if Sdir = 1 then
      dec Vt
    else
      inc Vt
    end if
    Sdir = 0
  end if
  return
end sub

' PutSpr(N, P, C): sprite N, pattern P, colour C at world y A16, x X
' (hidden outside the building's view)
sub PutSpr(u8 Sn, u8 Sp, u8 Sc):
  C16 = A16 + 16
  if C16 < Cam then
    set sprite Sn to 192,0,0,0
    return
  end if
  C16 = C16 - Cam
  if C16 < 8 then
    set sprite Sn to 192,0,0,0
    return
  end if
  if C16 > 168 then
    set sprite Sn to 192,0,0,0
    return
  end if
  Y = C16
  set sprite Sn to Y,X,Sp,Sc
  return
end sub

' DrawAll: the worker in front, then the groups (bird, bird, robot, cars)
' taking turns at the front
sub DrawAll:
  DrawWorker
  Ss = 2
  Gr = Tick & 3
  for Gi = 0 to 3
    G = Gr + Gi
    G = G & 3
    if G < 2 then
      DrawBird(G)
    end if
    if G = 2 then DrawRobot
    if G = 3 then DrawCars
  next
  update sprites
  return
end sub

sub DrawWorker:
  ' the pose: standing, a stride, arms up (falling, carried)
  V = 0
  if Mv = 1 then
    V = Pan >> 2
    if Pst = 3 then V = Tick >> 2
    V = V & 1
    V = V + 1
  end if
  if Pst = 2 then
    if Dk <> 2 then V = 3
  end if
  V = V << 4
  if Pdir = 1 then V = V + 8
  W = V + 4
  A16 = Py
  X = Px
  if Pst = 2 then
    if Dk = 2 then
      T = Tick & 4
      if T = 0 then
        PutSpr(0, SSpark, 15)
        PutSpr(1, V, 5)
        return
      end if
    end if
  end if
  PutSpr(0, W, 11)
  PutSpr(1, V, 5)
  return
end sub

sub DrawBird(u8 Db):
  N = Ss
  inc Ss
  J = Ss
  inc Ss
  V = Bs[Db]
  if V >= 4 then
    set sprite N to 192,0,0,0
    set sprite J to 192,0,0,0
    return
  end if
  A16 = By[Db]
  X = Bx[Db]
  if V = 2 then
    PutSpr(N, SBfy, 11)
    PutSpr(J, SBfr, 6)
    return
  end if
  T = Tick >> 3
  T = T & 1
  T = T << 4
  T = T + SBur
  if Bd[Db] = 0 then T = T + 8
  W = T + 4
  PutSpr(N, W, 11)
  PutSpr(J, T, 6)
  return
end sub

sub DrawRobot:
  N = Ss
  inc Ss
  J = Ss
  inc Ss
  if Rst = 0 then
    StandY(Rf)
    RyW = W16
    T = Rx >> 2
  else
    W16 = RyW >> 2
    T = W16
  end if
  T = T & 1
  T = T << 3
  T = T + SRb0g
  W = T + 4
  A16 = RyW
  X = Rx
  PutSpr(N, W, 8)
  PutSpr(J, T, 14)
  return
end sub

sub DrawCars:
  for I = 0 to 3
    A16 = Ey[I]
    X = ShX[I]
    PutSpr(Ss, SCar, 7)
    inc Ss
  next
  return
end sub

' --- screens ---------------------------------------------------------------

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop dark blue
  cls
  return
end sub

' BuildPlay: the building (rows 2-21, four tile rows a floor) and the HUD
sub BuildPlay:
  NewScreen
  for Y = 2 to 21
    W = Y - 2
    W = W & 3
    for X = 0 to 31
      V = ColT[X]
      if V < 9 then
        V = V << 2
        V = V + W
        V = V + TO0
        put char V at X,Y
      end if
    next
  next
  ShowHud
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 16,1, "HI"
  NumU = Hi
  print at 19,1, digits$(NumU, 4)
  print at 23,1, "00"
  print at 26,1, "RD"
  NumU = Round
  print at 28,1, digits$(NumU, 2)
  print at 2,22, "FLOOR"
  print at 11,22, "MEN"
  NumU = Men
  print at 15,22, digits$(NumU, 1)
  Fs = 255
  UpdFloor
  return
end sub

sub ShowScore:
  NumU = Score
  print at 8,1, digits$(NumU, 4)
  print at 12,1, "00"
  return
end sub

' UpdFloor: the worker's floor (the nearest one while riding)
sub UpdFloor:
  F = Pf
  if Pst = 1 then
    K = Pc
    A16 = Ey[K]
    A16 = A16 + 8
    A16 = A16 >> 5
    V = A16
    F = Hf - V
  end if
  if F = Fs then return
  Fs = F
  NumU = F
  print at 8,22, digits$(NumU, 2)
  return
end sub

' the title: the night skyline, the moon, the building's name, a menu
sub TitlePage:
  NewScreen
  for Y = 2 to 21
    for X = 2 to 29
      put char TSky at X,Y
    next
  next
  for I = 0 to 17
    J = I << 1
    X = Stars[J]
    inc J
    Y = Stars[J]
    put char TStar at X,Y
  next
  put char TMoon00 at 24,3
  put char TMoon01 at 25,3
  put char TMoon10 at 24,4
  put char TMoon11 at 25,4
  ' the city: towers of set heights, the tall one with a crane
  for X = 2 to 29
    V = X - 2
    T = Towers[V]
    put char TRoof at X,T
    inc T
    for Y = T to 21
      V = TWall
      W = X & 1
      if W = 1 then V = TWall2
      put char V at X,Y
    next
  next
  put char TMast at 13,11
  put char TMast at 13,12
  for X = 10 to 17
    put char TCrane at X,10
  next
  put char TSpire at 22,16
  print at 7,2, "H I G H    R I S E"
  print at 9,4, "START"
  print at 9,5, "MODE"
  print at 9,6, "CREDITS"
  print at 10,22, "HI"
  NumU = Hi
  print at 13,22, digits$(NumU, 4)
  print at 17,22, "00"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Menu = 0
  ShowMenu
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStick = 1
tp_loop:
  Frame1
  ReadPad
  V = KU | KD
  W = KL | KR
  V = V | W
  if V = 0 then WasStick = 0
  if WasStick = 0 then
    if KU = 1 then
      if Menu > 0 then dec Menu
      WasStick = 1
      play sound SndTick
    end if
    if KD = 1 then
      if Menu < 2 then inc Menu
      WasStick = 1
      play sound SndTick
    end if
    if Menu = 1 then
      if KR = 1 then
        inc Mode
        if Mode > 2 then Mode = 0
        WasStick = 1
        play sound SndTick
      end if
      if KL = 1 then
        if Mode = 0 then
          Mode = 2
        else
          dec Mode
        end if
        WasStick = 1
        play sound SndTick
      end if
    end if
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu = 1 then
    inc Mode
    if Mode > 2 then Mode = 0
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  return
end sub

sub ShowMenu:
  for Y = 4 to 6
    V = Y - 4
    if V = Menu then
      print at 7,Y, ">"
    else
      print at 7,Y, " "
    end if
  next
  if Mode = 0 then
    print at 14,5, "C64  "
    print at 3,8, " FLOOR 10, ROBOT SHOCKS  "
  end if
  if Mode = 1 then
    print at 14,5, "ATARI"
    print at 3,8, " FLOOR 15, NO SHOCKS     "
  end if
  if Mode = 2 then
    print at 14,5, "EASY "
    print at 3,8, " FLOOR 10, NO BIRDS      "
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  for X = 2 to 29
    put char TRule at X,2
    put char TRule at X,20
  next
  print at 11,4, "HIGH RISE"
  print at 3,6, "BASED ON HIGH RISE BY"
  print at 3,7, "CHARLES MCGUYER, COMPUTE!"
  print at 3,8, "FEBRUARY 1986 (COMMODORE"
  print at 3,9, "64; ATARI AND APPLE BY"
  print at 3,10, "KEVIN MYKYTYN, TIM VICTOR)."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY"
  print at 3,16, "BIENVENU."
  print at 3,18, "MUSIC: GIRDERS AT DUSK,"
  print at 3,19, "NIGHT SHIFT"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
cr_loop:
  Frame1
  ReadPad
  if Press = 0 then goto cr_loop
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  KL = 0
  KR = 0
  KU = 0
  KD = 0
  Btn = 0
  if joypad(1).left then KL = 1
  if joypad(2).left then KL = 1
  if joypad(1).right then KR = 1
  if joypad(2).right then KR = 1
  if joypad(1).up then KU = 1
  if joypad(2).up then KU = 1
  if joypad(1).down then KD = 1
  if joypad(2).down then KD = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn = 1
  if joypad(2).button2 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' the building's columns: 0 open, 1 girder, 2 shaft left, 3 shaft right,
' 4 the robot's shaft, 9 outside (blank)
data ColT bytes
  9,9,4,4,1,0,2,3,0,0,1,0,2,3,0,0,1,0,2,3,0,0,1,0,2,3,0,1,4,4,9,9
end data
' the elevator shafts' x (columns 6, 12, 18, 24)
data ShX bytes
  48,96,144,192
end data

' the title's stars (column, row) and towers (the roof's row, columns 2-29)
data Stars bytes
  3,3, 9,2, 17,3, 28,2, 5,6, 20,5, 27,7, 2,9, 11,8, 22,9, 6,12, 18,12, 26,11, 4,14, 9,13, 15,14, 21,13, 29,13
end data
data Towers bytes
  17,17,16,18,18,15,15,17,19,18,16,13,13,17,18,16,15,15,17,19,17,14,16,16,18,15,17,18
end data

