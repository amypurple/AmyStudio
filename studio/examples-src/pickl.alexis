cartridge "PICK-A-LETTER/Michael Blackmon/1987"

' PICK-A-LETTER
' A ColecoVision game based on "Pick-A-Letter", COMPUTE!'s Gazette,
' February 1987 (Commodore 64 and 128, BASIC; the listing names no
' author). Made for Amy Studio by Claude (an AI made by Anthropic), 2026,
' in Amy by Amy Bienvenu.
'
' The game: a word puzzle for 1 to 3 players taking turns. Spin the score
' pointer along the strip of value cards, then pick a letter: every copy
' of it in the hidden puzzle turns over and scores the card's value times
' your bonus factor. A right letter raises your bonus factor and keeps your
' turn; once you have one right you may solve instead. Solving banks your
' round score. First to the goal wins.
'
' From the original (orig/pick-a-letter.bas, the C64 listing; the C-128
' one is the same game): the strip X 5 3 2 S 4 1 4 A 2 3 5 1 X 3 5 2 4 Z
' (S = 10, Z = 15 points; X loses the turn; A loses the round score; both
' reset the bonus factor to 1); the pointer moves 20-39 cards and slows
' down; points per letter = card x bonus factor; each copy of the letter
' scores; a right letter adds 1 to the bonus factor and the player goes
' again, a letter not in the puzzle resets it to 1 and passes the turn;
' solving is allowed only with a bonus factor above 1 (a right letter
' first); a wrong answer costs 10 points of the round score (not below 0)
' and passes the turn (the bonus factor stays); the last letter turning
' over counts as solving; the solver adds the round score to the total,
' every round score and bonus factor restarts, the next player starts the
' next puzzle; the winning score is chosen (1000 = a medium game); the
' listing's 90 puzzles in five categories (PHRASE, PLACE, PERSON, NAME,
' OBJECT), shuffled.
'
' Liberties: the joystick spins, picks letters on an on-screen alphabet
' and solves by picking the hidden letters in order (a wrong one ends the
' attempt) instead of typing; used letters are greyed and cannot be
' picked again (the original passed the turn for a repeated letter);
' the goal is 250/500/750/1000 from a menu (500 at first: with the
' joystick and the reveal pauses a 1000 game runs about an hour), and
' 150/250/350/500 solo; X and A are drawn as X and ! with a legend;
' puzzles wrap over two lines. One player (the original let
' a single player spin for ever with nothing at stake): a solo game is 8
' puzzles with 5 misses each (X, !, a wrong letter or a wrong answer); the
' fifth miss shows the answer and loses that puzzle; reach the goal within
' 8 puzzles to win. Puzzles replaced: HOWARD COSELL (dated) -> ALBERT
' EINSTEIN, VIDEO CASSETTE RECORDER (dated) -> VIDEO GAME CONSOLE, CANDLE
' OPERA (a misprint) -> CANDLESTICK. The end shows the totals and goes
' back to the title (no play-again question). The art, sounds and the
' title tune are new.
'
' Controls: either controller (players share one, or pass it); stick and
' side buttons only. Title: up/down choose a line, left/right change it,
' a button starts. Play: left/right choose SPIN or SOLVE, a button
' confirms; the stick moves the box on the alphabet, a button picks.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' frame loop protected from the NMI; screens drawn with the NMI off,
' display off. Music first in the sound table, the title tune once.

const TBA = 128
const TBB = 129
const TBC = 130
const TBD = 131
const TBE = 132
const TBF = 133
const TBG = 134
const TBH = 135
const TBI = 136
const TBJ = 137
const TBK = 138
const TBL = 139
const TBM = 140
const TBN = 141
const TBO = 142
const TBP = 143
const TBQ = 144
const TBR = 145
const TBS = 146
const TBT = 147
const TBU = 148
const TBV = 149
const TBW = 150
const TBX = 151
const TBY = 152
const TBZ = 153
const TBdash = 154
const TBapos = 155
const THid = 156
const TUA = 157
const TUB = 158
const TUC = 159
const TUD = 160
const TUE = 161
const TUF = 162
const TUG = 163
const TUH = 164
const TUI = 165
const TUJ = 166
const TUK = 167
const TUL = 168
const TUM = 169
const TUN = 170
const TUO = 171
const TUP = 172
const TUQ = 173
const TUR = 174
const TUS = 175
const TUT = 176
const TUU = 177
const TUV = 178
const TUW = 179
const TUX = 180
const TUY = 181
const TUZ = 182
const TV1 = 183
const TV2 = 184
const TV3 = 185
const TV4 = 186
const TV5 = 187
const TVx = 188
const TVa = 189
const TV10 = 190
const TV15 = 191
const TRail = 192
const TDot = 193
const TTP00 = 194
const TTP01 = 195
const TTP10 = 196
const TTP11 = 197
const TTI00 = 198
const TTI01 = 199
const TTI10 = 200
const TTI11 = 201
const TTC00 = 202
const TTC01 = 203
const TTC10 = 204
const TTC11 = 205
const TTK00 = 206
const TTK01 = 207
const TTK10 = 208
const TTK11 = 209
const TTdash00 = 210
const TTdash01 = 211
const TTdash10 = 212
const TTdash11 = 213
const TTA00 = 214
const TTA01 = 215
const TTA10 = 216
const TTA11 = 217
const TTL00 = 218
const TTL01 = 219
const TTL10 = 220
const TTL11 = 221
const TTE00 = 222
const TTE01 = 223
const TTE10 = 224
const TTE11 = 225
const TTT00 = 226
const TTT01 = 227
const TTT10 = 228
const TTT11 = 229
const TTR00 = 230
const TTR01 = 231
const TTR10 = 232
const TTR11 = 233
const SPtr = 0
const SBox = 4
const SBar = 8
const NTiles8 = 848
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndMove = 3
const SndClick = 4
const SndDing = 5
const SndBuzz = 6
const SndLose = 7
const SndWrong = 8
const SndSolve = 9
const SndWin = 10
const NSpr = 4
const MsgRow = 19
const StatRow = 18
const StripRow = 15
const StripCol = 6
const NSlots = 19
const NPuz = 90
const SoloPuz = 8
const SoloMiss = 5
const SlotX = 0
const SlotA = 200

' the original strip (line 530): 0 = X (lose the turn), 200 = A (lose all)
data SlotV bytes
  0, 5, 3, 2, 10, 4, 1, 4, 200, 2, 3, 5, 1, 0, 3, 5, 2, 4, 15
end data
data GoalT words
  250, 500, 750, 1000
end data
' solo goals (8 puzzles)
data GoalS words
  150, 250, 350, 500
end data

record Player:
  u16 Rnd
  u16 Tot
  u8 Bon
end record

Player Pl[3]
' the puzzle
u8 Txt[32]
u8 Shown[32]
u8 CellC[32]
u8 CellR[32]
u8 Used[26]
u8 Order[90]
u8 Len = 0
u8 Cat = 0
u8 NHid = 0
u8 QQ = 0
u8 PzNo = 0
u16 PAdr = 0
' game state
u8 NP = 1
u8 GoalI = 1
u16 Goal = 1000
u8 CP = 0
u8 St = 0
u8 Mc = 0
u8 Pk = 0
u8 Ptr = 0
u8 Slot = 0
u8 SpinN = 0
u8 SpinDone = 0
u8 SpinT = 0
u16 PerL = 0
u8 Hits = 0
u8 Guess = 0
u8 SolI = 0
u8 Misses = 0
u8 PuzCount = 0
u8 MsgT = 0
u8 After = 0
u8 Over = 0
u8 Winner = 255
u16 Gain = 0
' random numbers, title
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Menu = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Ki = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table PkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then
    HowToPage
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  EndPage
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a number from 0 to N-1
function Roll(u8 Nr) as u8
  u16 Wm = 0
  u8 Res = 0
  Rand
  Wm = Nr
  Wm = Rs % Wm
  Res = Wm
  return Res

' the puzzle order (lines 980-1030), a fair shuffle here
sub Shuffle:
  u8 Sa = 0
  u8 Sb = 0
  u8 Sv = 0
  for Sa = 0 to 89
    Order[Sa] = Sa
  next
  for Sa = 89 to 1 step -1
    Sb = Sa + 1
    Sb = Roll(Sb)
    Sv = Order[Sa]
    Order[Sa] = Order[Sb]
    Order[Sb] = Sv
  next
  return
end sub

' ---------------------------------------------------------------------------
' the puzzle

' the next puzzle's text, category and cell places (two lines at most)
sub LoadPuzzle:
  u8 Ip = 0
  u8 Ch = 0
  u8 Ls = 0
  u8 Le = 0
  u8 Ln = 0
  u8 Wend = 0
  u8 Lw = 0
  u8 Col0 = 0
  u8 Rw = 0
  PzNo = Order[QQ]
  inc QQ
  if QQ >= NPuz then QQ = 0
  PAdr = PuzAdr[PzNo]
  Cat = peek(PAdr)
  Len = 0
  inc PAdr
  Ch = peek(PAdr)
  while Ch <> 0
    Txt[Len] = Ch
    inc Len
    inc PAdr
    Ch = peek(PAdr)
  end while
  NHid = 0
  for Ip = 0 to 31
    Shown[Ip] = 1
    CellR[Ip] = 0
  next
  for Ip = 0 to 25
    Used[Ip] = 0
  next
  ' greedy word wrap: lines of up to 24 cells
  Ls = 0
  Ln = 0
  Ip = 0
  while Ip < Len
    Wend = Ip
    while Wend < Len and Txt[Wend] <> 32
      inc Wend
    end while
    Lw = Wend - Ls
    if Lw > 24 then
      PlaceLine(Ls, Ip - 1, Ln)
      inc Ln
      Ls = Ip
    end if
    Ip = Wend + 1
  end while
  PlaceLine(Ls, Len, Ln)
  ' one line: in the middle row
  if Ln = 0 then
    for Ip = 0 to 31
      CellR[Ip] = 11
    next
  end if
  for Ip = 0 to 31
    if Ip < Len then
      Ch = Txt[Ip]
      if Ch >= 65 then
        Shown[Ip] = 0
        inc NHid
      end if
    end if
  next
  return
end sub

' cells Fa .. Fb-1 on line Fl, centred in columns 3-28
sub PlaceLine(u8 Fa, u8 Fb, u8 Fl):
  u8 Fw = 0
  u8 Fc = 0
  u8 Fr = 0
  u8 Fi = 0
  Fw = Fb - Fa
  Fc = 26 - Fw
  Fc = Fc / 2
  Fc = Fc + 3
  Fr = Fl * 2
  Fr = Fr + 10
  Fi = Fa
  while Fi < Fb
    CellC[Fi] = Fc
    CellR[Fi] = Fr
    inc Fc
    inc Fi
  end while
  return
end sub

function CellTile(u8 Ct) as u8
  u8 Cc = 0
  Cc = Txt[Ct]
  if Cc = 32 then return 32
  if Cc = 45 then return TBdash
  if Cc = 39 then return TBapos
  if Shown[Ct] = 0 then return THid
  return Cc - 65 + TBA

sub DrawCell(u8 Dc):
  put char CellTile(Dc) at CellC[Dc],CellR[Dc]
  return
end sub

' the category name (line 360)
sub ShowCat:
  print at 3,8, "CATEGORY:"
  select case Cat
  case 1
    print at 13,8, "PHRASE"
  case 2
    print at 13,8, "PLACE "
  case 3
    print at 13,8, "PERSON"
  case 4
    print at 13,8, "NAME  "
  case else
    print at 13,8, "OBJECT"
  end select
  return
end sub

sub DrawPuzzle:
  for Ki = 10 to 12
    fill 32 count 28 at 2,Ki
  next
  for Ki = 0 to 31
    if Ki < Len then DrawCell(Ki)
  next
  ShowCat
  return
end sub

' ---------------------------------------------------------------------------
' rules

function SlotTile(u8 Sv) as u8
  select case Sv
  case 0
    return TVx
  case 10
    return TV10
  case 15
    return TV15
  case 200
    return TVa
  case else
    return TV1 + Sv - 1
  end select
  return TVx

sub NewPuzzle:
  LoadPuzzle
  for Ki = 0 to 2
    Pl[Ki].Rnd = 0
    Pl[Ki].Bon = 1
  next
  Misses = 0
  inc PuzCount
  Rearm
  wait
  nmi off
  DrawPuzzle
  DrawPicker
  ShowScores
  ShowSolo
  return
end sub

' a turn starts: SPIN or (with a bonus factor above 1) SOLVE
sub StartTurn:
  Mc = 0
  St = 0
  ShowStatus
  ShowMenu
  return
end sub

sub NextPlayer:
  inc CP
  if CP >= NP then CP = 0
  ShowScores
  return
end sub

' a message for MsgT frames, then After: 1 next player's turn, 2 same
' player's turn, 3 next puzzle, 4 the end
sub Hold(u8 Ht, u8 Ha):
  MsgT = Ht
  After = Ha
  St = 4
  return
end sub

sub PlayStep:
  select case St
  case 0
    MenuStep
  case 1
    SpinStep
  case 2
    PickStep
  case 3
    SolveStep
  case else
    dec MsgT
    if MsgT = 0 then AfterMsg
  end select
  return
end sub

sub MenuStep:
  if Pl[CP].Bon > 1 then
    if Edge & 4 then
      Mc = 0
      play sound SndMove
      ShowMenu
    end if
    if Edge & 8 then
      Mc = 1
      play sound SndMove
      ShowMenu
    end if
  end if
  if Press = 0 then return
  if Mc = 0 then
    SpinN = Roll(20) + 20
    SpinDone = 0
    SpinT = 1
    St = 1
    Say(1)
  else
    SolI = 0
    NextHidden
    St = 3
    Say(2)
  end if
  return
end sub

' the pointer moves SpinN cards, slower and slower (lines 1040-1090)
sub SpinStep:
  dec SpinT
  if SpinT > 0 then return
  inc Ptr
  if Ptr >= NSlots then Ptr = 0
  play sound SndClick
  inc SpinDone
  SpinT = SpinDone / 5
  SpinT = SpinT + 1
  if SpinDone < SpinN then return
  Land
  return
end sub

' where the pointer stops (lines 1100-1160)
sub Land:
  Slot = SlotV[Ptr]
  if Slot = SlotX then
    play sound SndLose
    Pl[CP].Bon = 1
    Say(3)
    MissAndPass
    return
  end if
  if Slot = SlotA then
    play sound SndLose
    Pl[CP].Rnd = 0
    Pl[CP].Bon = 1
    ShowScores
    Say(4)
    MissAndPass
    return
  end if
  PerL = Slot * Pl[CP].Bon
  St = 2
  ShowStatus
  Say(5)
  return
end sub

' a miss: the turn passes; solo, it counts (5 lose the puzzle)
sub MissAndPass:
  if NP > 1 then
    Hold(100, 1)
    return
  end if
  inc Misses
  ShowSolo
  if Misses < SoloMiss then
    Hold(100, 2)
    return
  end if
  Hold(70, 5)
  return
end sub

' the stick on the alphabet: 13 letters a row, two rows
sub MoveBox:
  if Edge & 4 then
    if Pk <> 0 and Pk <> 13 then
      dec Pk
      play sound SndMove
    end if
  end if
  if Edge & 8 then
    if Pk <> 12 and Pk <> 25 then
      inc Pk
      play sound SndMove
    end if
  end if
  if Edge & 1 then
    if Pk >= 13 then
      Pk = Pk - 13
      play sound SndMove
    end if
  end if
  if Edge & 2 then
    if Pk < 13 then
      Pk = Pk + 13
      play sound SndMove
    end if
  end if
  return
end sub

sub PickStep:
  MoveBox
  if Press = 0 then return
  if Used[Pk] = 1 then
    play sound SndBuzz
    Say(6)
    return
  end if
  Guess = Pk + 65
  Used[Pk] = 1
  DrawPickLetter(Pk)
  RevealLetter
  return
end sub

' every copy of the letter turns over, one by one (lines 1180-1240)
sub RevealLetter:
  u8 Ri = 0
  Hits = 0
  for Ri = 0 to 31
    if Ri < Len then
      if Txt[Ri] = Guess then
        if Shown[Ri] = 0 then
          Shown[Ri] = 1
          dec NHid
          inc Hits
          DrawSprites
          play sound SndDing
          DrawCell(Ri)
          WaitFrames(14)
        end if
      end if
    end if
  next
  if Hits = 0 then
    play sound SndWrong
    Pl[CP].Bon = 1
    Say(7)
    MissAndPass
    return
  end if
  Gain = PerL * Hits
  Pl[CP].Rnd = Pl[CP].Rnd + Gain
  inc Pl[CP].Bon
  ShowScores
  if NHid = 0 then
    Solved
    return
  end if
  Say(8)
  Hold(60, 2)
  return
end sub

' the first hidden cell from SolI on
sub NextHidden:
  while SolI < Len and Shown[SolI] <> 0
    inc SolI
  end while
  return
end sub

' solving: pick the hidden letters in order (a wrong one ends it)
sub SolveStep:
  MoveBox
  if Press = 0 then return
  Guess = Pk + 65
  if Txt[SolI] <> Guess then
    WrongAnswer
    return
  end if
  play sound SndDing
  Shown[SolI] = 2
  DrawCell(SolI)
  NextHidden
  if SolI >= Len then Solved
  return
end sub

' lines 1310-1330: the cells typed in are hidden again
sub WrongAnswer:
  u8 Wi = 0
  play sound SndWrong
  for Wi = 0 to 31
    if Shown[Wi] = 2 then
      Shown[Wi] = 0
      DrawCell(Wi)
    end if
  next
  if Pl[CP].Rnd >= 10 then
    Pl[CP].Rnd = Pl[CP].Rnd - 10
  else
    Pl[CP].Rnd = 0
  end if
  ShowScores
  Say(9)
  MissAndPass
  return
end sub

' lines 1340-1470: the round score is banked
sub Solved:
  u8 Si = 0
  for Si = 0 to 31
    if Si < Len then
      Shown[Si] = 1
      DrawCell(Si)
    end if
  next
  NHid = 0
  play sound SndSolve
  Gain = Pl[CP].Rnd
  Pl[CP].Tot = Pl[CP].Tot + Gain
  Pl[CP].Rnd = 0
  ShowScores
  Say(10)
  if Pl[CP].Tot >= Goal then
    Winner = CP
    Hold(150, 4)
    return
  end if
  Hold(150, 3)
  return
end sub

sub AfterMsg:
  select case After
  case 1
    NextPlayer
    StartTurn
  case 2
    StartTurn
  case 3
    NextOrEnd
  case 4
    Over = 1
  case 5
    ' solo: the fifth miss shows the answer
    for Ki = 0 to 31
      if Ki < Len then
        Shown[Ki] = 1
        DrawCell(Ki)
      end if
    next
    Pl[0].Rnd = 0
    ShowScores
    Say(11)
    Hold(150, 3)
  end select
  return
end sub

sub NextOrEnd:
  if NP = 1 then
    if PuzCount >= SoloPuz then
      Over = 1
      return
    end if
  end if
  NewPuzzle
  if NP > 1 then NextPlayer
  StartTurn
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawPickLetter(u8 Dl):
  u8 Pc = 0
  u8 Pr = 0
  u8 Pt = 0
  Pc = Dl
  Pr = 20
  if Dl >= 13 then
    Pc = Dl - 13
    Pr = 22
  end if
  Pc = Pc * 2
  Pc = Pc + 3
  Pt = Dl + 65
  if Used[Dl] = 1 then Pt = Dl + TUA
  put char Pt at Pc,Pr
  return
end sub

sub DrawPicker:
  for Li = 0 to 25
    DrawPickLetter(Li)
  next
  return
end sub

sub ShowScores:
  u8 Sr = 0
  for Li = 0 to 2
    if Li < NP then
      Sr = Li + 4
      put char 32 at 2,Sr
      if Li = CP then put char 62 at 2,Sr
      print at 3,Sr, "PLAYER"
      put char 49 + Li at 10,Sr
      W16 = Pl[Li].Rnd
      print W16 at 13,Sr width 5
      W16 = Pl[Li].Tot
      print W16 at 21,Sr width 5
    end if
  next
  return
end sub

sub ShowSolo:
  if NP > 1 then return
  print at 3,6, "PUZZLE   OF    MISSES  /"
  put char 48 + PuzCount at 10,6
  put char 48 + SoloPuz at 15,6
  put char 48 + Misses at 25,6
  put char 48 + SoloMiss at 27,6
  return
end sub

sub ShowStatus:
  print at 2,StatRow, " BONUS X       LETTER =     "
  V = Pl[CP].Bon
  W16 = V
  print W16 at 10,StatRow width 2
  if St = 2 then
    print PerL at 25,StatRow width 4
  else
    print at 25,StatRow, " -  "
  end if
  return
end sub

sub ShowMenu:
  print at 2,MsgRow, "  PLAYER    SPIN            "
  put char 49 + CP at 9,MsgRow
  if Pl[CP].Bon > 1 then print at 20,MsgRow, "SOLVE"
  if Mc = 0 then
    put char 62 at 13,MsgRow
  else
    put char 62 at 19,MsgRow
  end if
  return
end sub

' the message line
sub Say(u8 Mw):
  select case Mw
  case 1
    print at 2,MsgRow, "        SPINNING...         "
  case 2
    print at 2,MsgRow, " SOLVE: PICK EACH LETTER    "
  case 3
    print at 2,MsgRow, "  X: YOU LOSE YOUR TURN.    "
  case 4
    print at 2,MsgRow, " !: YOU LOSE THE ROUND SCORE"
  case 5
    print at 2,MsgRow, "  PICK A LETTER.            "
  case 6
    print at 2,MsgRow, "  THAT LETTER IS USED.      "
  case 7
    print at 2,MsgRow, "  NO   IN THE PUZZLE.       "
    put char Guess at 6,MsgRow
  case 8
    print at 2,MsgRow, "    X   = +                 "
    W16 = Hits
    print W16 at 4,MsgRow width 1
    put char Guess at 8,MsgRow
    print Gain at 13,MsgRow width 5
  case 9
    print at 2,MsgRow, "  WRONG ANSWER! -10         "
  case 10
    print at 2,MsgRow, "  SOLVED!  +                "
    print Gain at 14,MsgRow width 5
  case 11
    print at 2,MsgRow, " OUT OF CHANCES. THE ANSWER."
  case else
    print at 2,MsgRow, "                            "
  end select
  return
end sub

' sprites: 0 picker box, 1 solve bar, 2 score pointer
sub DrawSprites:
  X = StripCol + Ptr
  X = X << 3
  if TitleOn = 0 then
    set sprite 2 to 127,X,SPtr,11
  end if
  Y = 192
  if St = 2 or St = 3 then
    X = Pk
    Y = 159
    if Pk >= 13 then
      X = Pk - 13
      Y = 175
    end if
    X = X * 2
    X = X + 3
    X = X << 3
    X = X - 1
  end if
  set sprite 0 to Y,X,SBox,15
  Y = 192
  X = 0
  if St = 3 then
    if SolI < Len then
      X = CellC[SolI] << 3
      Y = CellR[SolI] << 3
      Y = Y - 1
    end if
  end if
  set sprite 1 to Y,X,SBar,11
  update sprites
  return
end sub

sub DrawStrip(u8 Sr):
  u8 Sc = 0
  for Li = 0 to 18
    Sc = StripCol + Li
    put char SlotTile(SlotV[Li]) at Sc,Sr
  next
  return
end sub

sub NewGame:
  TitleOn = 0
  Over = 0
  Winner = 255
  PuzCount = 0
  CP = 0
  Ptr = 0
  Pk = 0
  Goal = GoalT[GoalI]
  if NP = 1 then Goal = GoalS[GoalI]
  for Ki = 0 to 2
    Pl[Ki].Tot = 0
    Pl[Ki].Rnd = 0
    Pl[Ki].Bon = 1
  next
  Shuffle
  QQ = 0
  NewScreen
  print at 2,1, "PICK-A-LETTER"
  print at 18,1, "GOAL"
  print Goal at 23,1 width 5
  print at 12,3, "ROUND   TOTAL"
  fill TRail count 28 at 2,9
  fill TRail count 28 at 2,13
  DrawStrip(StripRow)
  put char TVx at 3,17
  print at 5,17, "LOSE TURN"
  put char TVa at 16,17
  print at 18,17, "LOSE ROUND"
  NewPuzzle
  StartTurn
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  return
end sub

sub EndPage:
  u8 Er = 0
  Rearm
  wait
  nmi off
  HideSprites
  for Ki = 2 to 22
    fill 32 count 28 at 2,Ki
  next
  if NP = 1 then
    if Winner = 0 then
      print at 6,4, "YOU REACHED THE GOAL"
      print at 6,5, "IN    PUZZLES!"
      put char 48 + PuzCount at 9,5
      play sound SndWin
    else
      print at 6,4, "OUT OF PUZZLES."
      print at 6,5, "THE GOAL WAS"
      print Goal at 19,5 width 5
      play sound SndLose
    end if
  else
    print at 6,4, "THE WINNER IS PLAYER"
    put char 49 + Winner at 27,4
    play sound SndWin
  end if
  for Li = 0 to 2
    if Li < NP then
      Er = Li * 2
      Er = Er + 8
      print at 6,Er, "PLAYER"
      put char 49 + Li at 13,Er
      W16 = Pl[Li].Tot
      print W16 at 16,Er width 5
      print at 22,Er, "POINTS"
    end if
  next
  print at 7,17, "PRESS THE BUTTON"
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub WaitFrames(u8 Wn):
  u8 Wf = 0
  for Wf = 1 to Wn
    Frame1
  next
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' PICK-A-LETTER in big letters, columns 3-28
data LogoT bytes
  TTP00, TTI00, TTC00, TTK00, TTdash00, TTA00, TTdash00, TTL00, TTE00, TTT00, TTT00, TTE00, TTR00
end data

sub TitlePage:
  u8 Lc = 0
  u8 Lt = 0
  u8 Lr = 0
  TitleOn = 1
  Menu = 2
  NewScreen
  for Li = 0 to 12
    Lt = LogoT[Li]
    Lc = Li * 2
    Lc = Lc + 3
    put char Lt at Lc,3
    inc Lt
    put char Lt at Lc + 1,3
    inc Lt
    put char Lt at Lc,4
    inc Lt
    put char Lt at Lc + 1,4
  next
  print at 4,6, "COMPUTE!'S GAZETTE 1987"
  fill TRail count 28 at 2,8
  DrawStrip(9)
  fill TRail count 28 at 2,11
  print at 5,13, "PLAYERS"
  print at 5,15, "GOAL"
  print at 5,17, "START"
  print at 5,19, "HOW TO PLAY"
  print at 5,21, "CREDITS"
  ShowOpts
  ShowTMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 470
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the pointer wanders along the strip
  V = Tick & 15
  if V = 0 then
    inc Ptr
    if Ptr >= NSlots then Ptr = 0
  end if
  X = StripCol + Ptr
  X = X << 3
  set sprite 2 to 79,X,SPtr,11
  update sprites
  if Edge & 1 then
    if Menu > 0 then dec Menu
    play sound SndMove
    ShowTMenu
  end if
  if Edge & 2 then
    if Menu < 4 then inc Menu
    play sound SndMove
    ShowTMenu
  end if
  K = Edge & 12
  if K > 0 then ChangeOpt
  if Press = 0 then goto tp_loop
  if Menu < 2 then
    Menu = 2
    ShowTMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ChangeOpt:
  if Menu = 0 then
    if Edge & 8 then
      if NP < 3 then inc NP
    else
      if NP > 1 then dec NP
    end if
  end if
  if Menu = 1 then
    if Edge & 8 then
      if GoalI < 3 then inc GoalI
    else
      if GoalI > 0 then dec GoalI
    end if
  end if
  play sound SndMove
  ShowOpts
  return
end sub

sub ShowOpts:
  put char 49 + NP - 1 at 16,13
  if NP = 1 then
    print at 18,13, "(SOLO)"
  else
    print at 18,13, "      "
  end if
  W16 = GoalT[GoalI]
  if NP = 1 then W16 = GoalS[GoalI]
  print W16 at 13,15 width 5
  return
end sub

sub ShowTMenu:
  for Ki = 0 to 4
    C = Ki << 1
    C = C + 13
    put char 32 at 3,C
  next
  C = Menu << 1
  C = C + 13
  put char 62 at 3,C
  return
end sub

' a word drawn for the HOW TO PLAY pages: Hn tiles from data HtW at Hp
sub HtWord(u8 Hp, u8 Hn, u8 Hc, u8 Hr):
  u8 Hi = 0
  u8 Ht = 0
  for Hi = 1 to Hn
    Ht = HtW[Hp]
    put char Ht at Hc,Hr
    inc Hp
    inc Hc
  next
  return
end sub

data HtW bytes
  TBP, THid, TBC, TBK, 32, THid, 32, TBL, TBE, TBT, TBT, TBE, THid
end data

' HOW TO PLAY: three pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "GUESS THE HIDDEN WORDS!"
    print at 2,5, "SPIN THE POINTER ALONG THE"
    print at 2,6, "STRIP OF CARDS, THEN PICK A"
    print at 2,7, "LETTER. EACH TIME IT IS IN"
    print at 2,8, "THE PUZZLE IT TURNS OVER AND"
    print at 2,9, "SCORES THE CARD'S POINTS"
    print at 2,10, "TIMES YOUR BONUS FACTOR."
    HtWord(0, 13, 9, 12)
    DrawStrip(14)
    set sprite 2 to 119,64,SPtr,11
    print at 2,17, "S IS 10 POINTS, Z IS 15."
    print at 2,18, "X: YOU LOSE YOUR TURN."
    print at 2,19, "!: YOU LOSE YOUR TURN AND"
    print at 2,20, "YOUR SCORE FOR THIS ROUND."
  end if
  if Pg = 2 then
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "STICK LEFT OR RIGHT: CHOOSE"
    print at 2,4, "SPIN OR SOLVE. BUTTON: GO."
    print at 2,6, "TO PICK A LETTER, MOVE THE"
    print at 2,7, "BOX WITH THE STICK AND PRESS"
    print at 2,8, "THE BUTTON. GREY LETTERS"
    print at 2,9, "ARE USED UP."
    print at 2,11, "A RIGHT LETTER: YOUR BONUS"
    print at 2,12, "FACTOR GOES UP 1 AND YOU"
    print at 2,13, "GO AGAIN. A WRONG ONE: THE"
    print at 2,14, "FACTOR GOES BACK TO 1 AND"
    print at 2,15, "THE NEXT PLAYER GOES."
    for Li = 0 to 12
      X = Li * 2
      X = X + 3
      T = Li + 65
      if Li < 5 then T = Li + TUA
      put char T at X,19
    next
    set sprite 0 to 151,103,SBox,15
  end if
  if Pg = 3 then
    print at 2,1, "SOLVING                3/3"
    print at 2,3, "AFTER A RIGHT LETTER YOU MAY"
    print at 2,4, "SOLVE: PICK THE HIDDEN"
    print at 2,5, "LETTERS IN ORDER. A MISTAKE"
    print at 2,6, "COSTS 10 AND ENDS YOUR TURN."
    print at 2,8, "SOLVING ADDS YOUR ROUND"
    print at 2,9, "SCORE TO YOUR TOTAL. FIRST"
    print at 2,10, "TO THE GOAL SCORE WINS."
    print at 2,12, "ONE PLAYER: 8 PUZZLES, 5"
    print at 2,13, "MISSES EACH. REACH THE GOAL"
    print at 2,14, "TO WIN."
    HtWord(7, 6, 12, 17)
    set sprite 1 to 135,136,SBar,11
    print at 2,20, "TIP: TRY E, T, A, S FIRST."
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B1
  print at 8,2, "PICK-A-LETTER"
  print at 2,5, "BASED ON PICK-A-LETTER,"
  print at 2,6, "COMPUTE!'S GAZETTE,"
  print at 2,7, "FEBRUARY 1987 (COMMODORE 64"
  print at 2,8, "AND 128). NO AUTHOR IS"
  print at 2,9, "NAMED IN THE LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: LIGHTS UP, LETTERS"
  print at 2,19, "DOWN (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

