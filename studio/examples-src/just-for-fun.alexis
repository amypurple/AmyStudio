' JUST FOR FUN
' Four games from the "Just for Fun" chapter of Tim Hartnell's Giant Book
' of Computer Games (Ballantine Books, 1984; Interface Publications, 1983),
' for the ColecoVision in Amy by Amy Bienvenu.
'
' NIMGRAB: 17 to 23 gems; you and the computer take turns to grab 1 to 3
' (or 1 to 4, it changes each game). Whoever grabs the last gem loses.
' FOLLOW THE LEADER: watch the digits, then copy them, one more each time,
' up to seven. Five rounds, each one showing the digits for less time.
' NOUGHTS AND CROSSES: you are X, the computer O; it decides who starts.
' CAVALCADE OF PUZZLES: four in a row. The computer reads your mind (a
' number from 1 to 63), you find its number (1 to 40 in six guesses, or
' an easier one), it tells your age and your change, and you swap two
' teams of frogs.
'
' Controls (either joystick): NIMGRAB: up and down choose how many, the
' button grabs. FOLLOW THE LEADER: the stick picks a digit, the button
' enters it. NOUGHTS AND CROSSES: the stick picks a square, the button
' plays. CAVALCADE: left and right choose YES or NO; up and down change a
' number (left and right by 5, or move between digits); the button goes
' on; in the frog game the stick picks a frog, the button moves it. The
' second button leaves. Keypad not used.
'
' Liberties taken:
' - FOLLOW THE LEADER: the book's waits (T = 1000 down to 500) become
'   1.5 seconds down to 0.75. The first digit is always 2, as in the
'   listing.
' - NOUGHTS AND CROSSES: the score of the session is kept.
' - CAVALCADE: the mind reader shows its six cards (the text says five);
'   the frogs must slide into the next space or jump one frog (the
'   listing moves any piece to the gap); a number is entered digit by
'   digit with the stick.
' - New pictures (gems, number blocks, the board, the frogs), new music
'   (Rainy Afternoon) and sounds.
'
' House rules kept: text in columns 2-29 and rows 1-22; at most two
' sprites; every screen is drawn with the NMI off after a wait.

const TGem00 = 128
const TGem01 = 129
const TGem10 = 130
const TGem11 = 131
const TGemlit00 = 132
const TGemlit01 = 133
const TGemlit10 = 134
const TGemlit11 = 135
const TNum000 = 136
const TNum001 = 137
const TNum010 = 138
const TNum011 = 139
const TNum100 = 140
const TNum101 = 141
const TNum110 = 142
const TNum111 = 143
const TNum200 = 144
const TNum201 = 145
const TNum210 = 146
const TNum211 = 147
const TNum300 = 148
const TNum301 = 149
const TNum310 = 150
const TNum311 = 151
const TNum400 = 152
const TNum401 = 153
const TNum410 = 154
const TNum411 = 155
const TNum500 = 156
const TNum501 = 157
const TNum510 = 158
const TNum511 = 159
const TNum600 = 160
const TNum601 = 161
const TNum610 = 162
const TNum611 = 163
const TNum700 = 164
const TNum701 = 165
const TNum710 = 166
const TNum711 = 167
const TNum800 = 168
const TNum801 = 169
const TNum810 = 170
const TNum811 = 171
const TNum900 = 172
const TNum901 = 173
const TNum910 = 174
const TNum911 = 175
const TXx00 = 176
const TXx01 = 177
const TXx02 = 178
const TXx10 = 179
const TXx11 = 180
const TXx12 = 181
const TXx20 = 182
const TXx21 = 183
const TXx22 = 184
const TOo00 = 185
const TOo01 = 186
const TOo02 = 187
const TOo10 = 188
const TOo11 = 189
const TOo12 = 190
const TOo20 = 191
const TOo21 = 192
const TOo22 = 193
const TCell = 194
const TGridh = 195
const TGridv = 196
const TGridx = 197
const TFrogg00 = 198
const TFrogg01 = 199
const TFrogg10 = 200
const TFrogg11 = 201
const TFrogy00 = 202
const TFrogy01 = 203
const TFrogy10 = 204
const TFrogy11 = 205
const TPad00 = 206
const TPad01 = 207
const TPad10 = 208
const TPad11 = 209
const TWater = 210
const TFrame = 211
const SRing = 0
const SArrow = 4
const SSpark = 8
const SRingbig = 12
const NTiles8 = 672
const SprBytes = 128
const SndHush = 1
const SndClick = 2
const SndGrab = 3
const SndShow = 4
const SndPlace = 5
const SndCroak = 6
const SndGood = 7
const SndBad = 8
const SndWin = 9
const SndLose = 10
const SndMagic = 11
const SndTuneA = 12
const SndTuneB = 13

' Celebrate: three bursts of eight sparks (the directions, the colours)
data CbDx bytes 0,3,4,3,0,253,252,253
data CbDy bytes 252,253,0,3,4,3,0,253
data CbCol bytes 15,11,9,13,7,10,8,14
u8 CbX[8]
u8 CbY[8]
u8 CbK = 0
u8 CbT = 0
u8 CbN = 0
u8 CbC = 0
u8 CbV = 0

u8 Gm[25]
u8 Sq[9]
u8 En[9]
u8 Bd[10]
u8 Fr[10]
u8 D4[5]
u8 Z = 0
u8 Hmax = 0
u8 Eg = 0
u8 Qc = 0
u8 Tf = 90
u8 Tr = 10
u8 Ql = 1
u8 Ne = 0
u8 Turn = 0
u8 Pos = 5
u8 Who = 0
u8 WinsU = 0
u8 WinsC = 0
u8 Draws = 0
u8 Mind = 0
u8 Bit = 1
u8 Wmax = 40
u8 Secret = 0
u8 Gv = 1
u8 Lo = 1
u8 Hi = 40
u8 Moves = 0
u8 Hole = 5
u8 Cnt = 0
u8 Ln = 0
u8 La = 0
u8 Lb = 0
u8 Lc = 0
u8 Dd = 0

' scratch
u16 Uw = 0
u16 Ub = 0
u16 NumU = 0
u16 Rs = $4E21
u16 Rt = 0
u8 Rb = 0
u8 Nr = 0
u8 Res = 0
u8 Ka = 0
u8 Kc = 0

' input and menus
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table JfSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then goto follow
  if Menu = 2 then goto noughts
  if Menu = 3 then goto cavalcade
  if Menu = 4 then
    RulesPage
    goto title
  end if
  if Menu = 5 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' NIMGRAB

nim:
  NewScreen
  backdrop black
  print at 2,1, "NIMGRAB"
  ' the book: Z from 16 to 23, made odd; the most to grab, 3 or 4
  Nr = 8
  RndN
  Z = V + 16
  V = Z & 1
  if V = 0 then inc Z
  Nr = 2
  RndN
  Hmax = V + 3
  for K = 1 to 24
    Gm[K] = 0
  next
  for K = 1 to Z
    Gm[K] = 1
    NimDraw
  next
  print at 2,15, "THE MAXIMUM YOU CAN GRAB"
  print at 2,16, "IS"
  NumU = Hmax
  print at 5,16, width$(NumU, 1)
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  Eg = 1
ni_turn:
  NimSay
  print at 2,18, "HOW MANY WILL YOU GRAB?"
  if Eg > Z then Eg = Z
  NimLight
  WasBtn = 1
  WasBtn2 = 1
ni_pick:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Eg < Hmax then
        if Eg < Z then inc Eg
      end if
    end if
    if Dn1 = 1 then
      if Eg > 1 then dec Eg
    end if
    play sound SndClick
    NimLight
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto ni_pick
  ' your grab
  NimSay
  print at 2,18, "SO YOU WANT TO GRAB"
  NumU = Eg
  print at 22,18, width$(NumU, 1)
  Kc = Eg
  Ne = Eg
  NimTake
  if Z = 0 then
    play sound SndLose
    print at 2,20, "YOU GRABBED THE LAST ONE,"
    print at 2,21, "SO I WIN!!"
    EndWait
    if Res = 0 then goto nim
    goto title
  end if
  for J = 1 to 30
    Frame1
  next
  ' the book's line 250: leave a multiple of H + 1, plus one, give or take
ni_q:
  Uw = Z - 1
  W = Hmax + 1
ni_mod:
  if Uw >= W then
    Uw = Uw - W
    goto ni_mod
  end if
  V = Uw
  Rnd
  Ka = Rb & 1
  V = V - Ka
  Rnd
  Ka = Rb & 1
  V = V + Ka
  if V < 1 then goto ni_q
  if V > Hmax then goto ni_q
  Qc = V
  Eg = Qc
  if Eg > Z then Eg = Z
  NimLight
  for J = 1 to 40
    Frame1
  next
  Kc = Qc
  if Kc > Z then Kc = Z
  NimTake
  NimSay
  print at 2,18, "YOU TOOK"
  NumU = Ne
  print at 11,18, width$(NumU, 1)
  print at 12,18, ", AND I TOOK"
  NumU = Qc
  print at 25,18, width$(NumU, 1)
  if Z = 0 then
    play sound SndWin
    print at 2,20, "I GRABBED THE LAST ONE,"
    print at 2,21, "SO YOU WIN!!"
    Celebrate
    EndWait
    if Res = 0 then goto nim
    goto title
  end if
  for J = 1 to 60
    Frame1
  next
  Eg = 1
  goto ni_turn

' ---------------------------------------------------------------------------
' FOLLOW THE LEADER

follow:
  Tf = 90
  Tr = 10
fo_new:
  NewScreen
  backdrop dark green
  print at 2,1, "FOLLOW THE LEADER"
  ' the digit pad: 0-4 and 5-9
  for K = 0 to 9
    FoPadXY
    Dd = K
    BlockAt
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  ' the book: a 2, then seven random digits
  Sq[1] = 2
  for K = 2 to 8
    Nr = 10
    RndN
    Sq[K] = V
  next
  Ql = 1
  Pos = 2
fo_show:
  Turn = 0
  FoClear
  print at 2,9, "WATCH..."
  for J = 1 to 30
    Frame1
  next
  for K = 1 to Ql
    X = K * 3
    X = X + 1
    Y = 4
    Dd = Sq[K]
    BlockAt
    ' each digit arrives with its beep
    play sound SndShow
    for J = 1 to 10
      Frame1
    next
  next
  for J = 1 to Tf
    Frame1
  next
  FoClear
  print at 2,9, "NOW YOU..."
  Ne = 0
  Turn = 1
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
fo_pick:
  if Res = 1 then
    K = Pos
    FoPadXY
    Sx = X << 3
    Sy = Y << 3
    Sy = Sy - 1
    set sprite 0 to Sy, Sx, SRing, 15
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      V = Pos % 5
      if V > 0 then dec Pos
    end if
    if Rt1 = 1 then
      V = Pos % 5
      if V < 4 then inc Pos
    end if
    if Up1 = 1 then
      if Pos >= 5 then Pos = Pos - 5
    end if
    if Dn1 = 1 then
      if Pos < 5 then Pos = Pos + 5
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto fo_pick
  inc Ne
  En[Ne] = Pos
  X = Ne * 3
  X = X + 1
  Y = 4
  Dd = Pos
  BlockAt
  play sound SndShow
  if Ne < Ql then goto fo_pick
  ' the book compares the whole answer
  Res = 0
  for K = 1 to Ql
    if En[K] <> Sq[K] then Res = 1
  next
  for J = 1 to 20
    Frame1
  next
  if Res = 1 then
    HideSprites
    play sound SndLose
    print at 2,9, "YOU BLEW IT, TURKEY!"
    print at 2,10, "YOUR SCORE WAS"
    ' 37 x (1100 - T + 10 Q), with T = Tr x 100
    Uw = Ql * 10
    Uw = Uw + 1100
    Ub = Tr
  Ub = Ub * 100
    Uw = Uw - Ub
    NumU = 0
    for J = 1 to 37
      NumU = NumU + Uw
    next
    print at 17,10, width$(NumU, 5)
    EndWait
    if Res = 0 then goto follow
    goto title
  end if
  play sound SndGood
  ' a green flash for a right answer
  for J = 1 to 6
    V = J & 1
    if V = 0 then
      backdrop light green
    else
      backdrop dark green
    end if
    Frame1
    Frame1
    Frame1
  next
  backdrop dark green
  if Ql < 7 then
    inc Ql
    goto fo_show
  end if
  HideSprites
  play sound SndWin
  print at 2,9, "YOU DID IT, CHAMP!!"
  if Tr = 5 then
    print at 2,10, "YOU ARE THE ULTIMATE CHAMP!!!"
    Celebrate
    EndWait
    if Res = 0 then goto follow
    goto title
  end if
  print at 2,10, "STAND BY FOR A MORE"
  print at 2,11, "DIFFICULT ONE..."
  Pause
  Pause
  dec Tr
  Tf = Tf - 9
  goto fo_new

' ---------------------------------------------------------------------------
' NOUGHTS AND CROSSES

noughts:
  NewScreen
  backdrop dark blue
  print at 2,1, "NOUGHTS AND CROSSES"
  for Y = 4 to 14
    for X = 9 to 19
      V = 0
      if X = 12 then V = 1
      if X = 16 then V = 1
      W = 0
      if Y = 7 then W = 2
      if Y = 11 then W = 2
      V = V + W
      if V = 1 then put char TGridv at X,Y
      if V = 2 then put char TGridh at X,Y
      if V = 3 then put char TGridx at X,Y
    next
  next
  for K = 1 to 9
    Bd[K] = 0
  next
  NcScore
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  Pos = 5
  ' the book: the computer starts one game in two
  Rnd
  if Rb >= 128 then
    NcSay
    print at 2,17, "I'LL HAVE THE FIRST MOVE"
    Pause
    goto nc_cpu
  end if
nc_you:
  NcSay
  print at 2,17, "ENTER YOUR MOVE..."
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
nc_pick:
  if Res = 1 then
    K = Pos
    NcXY
    Sx = X << 3
    Sx = Sx + 4
    Sy = Y << 3
    Sy = Sy + 3
    set sprite 0 to Sy, Sx, SRing, 11
    update sprites
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    V = Pos - 1
    W = V % 3
    if Lf1 = 1 then
      if W > 0 then dec Pos
    end if
    if Rt1 = 1 then
      if W < 2 then inc Pos
    end if
    if Up1 = 1 then
      if Pos > 3 then Pos = Pos - 3
    end if
    if Dn1 = 1 then
      if Pos < 7 then Pos = Pos + 3
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto nc_pick
  if Bd[Pos] <> 0 then
    play sound SndBad
    goto nc_pick
  end if
  Bd[Pos] = 2
  K = Pos
  NcDraw
  play sound SndPlace
  NcCheck
  if Who > 0 then goto nc_over
  for J = 1 to 20
    Frame1
  next
nc_cpu:
  HideSprites
  NcMove
  if Res = 0 then
    Who = 3
    goto nc_over
  end if
  NcDraw
  play sound SndPlace
  NcCheck
  if Who > 0 then goto nc_over
  ' a full board is a draw
  Res = 0
  for K = 1 to 9
    if Bd[K] = 0 then Res = 1
  next
  if Res = 0 then
    Who = 3
    goto nc_over
  end if
  goto nc_you
nc_over:
  HideSprites
  NcSay
  if Who = 1 then
    print at 2,17, "I'M THE WINNER!"
    inc WinsC
    play sound SndLose
  end if
  if Who = 2 then
    print at 2,17, "YOU'RE THE WINNER!"
    inc WinsU
    play sound SndWin
  end if
  if Who = 3 then
    print at 2,17, "IT'S A DRAW!"
    inc Draws
    play sound SndShow
  end if
  NcScore
  if Who = 2 then Celebrate
  EndWait
  if Res = 0 then goto noughts
  goto title

' ---------------------------------------------------------------------------
' CAVALCADE OF PUZZLES

cavalcade:
  ' 1: the mind reader
  CvScreen
  print at 2,4, "THINK OF A NUMBER BETWEEN"
  print at 2,5, "ONE AND SIXTY-THREE"
  print at 2,7, "I WILL SHOW YOU SIX"
  print at 2,8, "SCREENFULS OF NUMBERS."
  print at 2,10, "IF YOUR NUMBER IS ON THE"
  print at 2,11, "SCREEN, CHOOSE YES; IF IT"
  print at 2,12, "IS NOT, CHOOSE NO."
  print at 2,14, "I'LL TELL YOU THE NUMBER"
  print at 2,15, "YOU THOUGHT OF AT THE END"
  print at 2,16, "OF THE GAME"
  ShowScreen
  GoOn
  if Res = 1 then goto title
  Mind = 0
  Bit = 1
  for Ka = 1 to 6
    CvScreen
    ' every number from 1 to 63 that has this bit
    X = 3
    Y = 4
    for K = 1 to 63
      V = K & Bit
      if V > 0 then
        NumU = K
        print at X,Y, width$(NumU, 2)
        X = X + 3
        if X > 26 then
          X = 3
          Y = Y + 2
        end if
      end if
    next
    print at 2,16, "IS YOUR NUMBER HERE?"
    YesNo
    if Res = 2 then goto title
    if Res = 1 then Mind = Mind + Bit
    Bit = Bit << 1
  next
  CvScreen
  print at 2,6, "YOUR NUMBER WAS..."
  play sound SndMagic
  Pause
  NumU = Mind
  print at 12,9, width$(NumU, 2)
  print at 14,9, "!"
  GoOn
  if Res = 1 then goto title
  ' 2: find the computer's number
  CvScreen
  print at 2,4, "NOW IT'S TIME FOR SOMETHING"
  print at 2,5, "ALMOST COMPLETELY DIFFERENT!"
  print at 2,7, "I'M GOING TO THINK OF A"
  print at 2,8, "NUMBER BETWEEN ONE AND 40,"
  print at 2,9, "AND YOU HAVE JUST SIX"
  print at 2,10, "GUESSES TO GET IT RIGHT..."
  print at 2,11, "IF YOU DO, YOU GET TO PLAY"
  print at 2,12, "THE NEXT GAME."
  print at 2,14, "IF YOU DON'T, YOU'LL BE"
  print at 2,15, "GIVEN AN EASIER PUZZLE..."
  GoOn
  if Res = 1 then goto title
  Wmax = 40
cv_think:
  CvScreen
  print at 2,4, "OK, I'M THINKING OF MY"
  print at 2,5, "NUMBER BETWEEN ONE AND"
  NumU = Wmax
  print at 25,5, width$(NumU, 2)
  Nr = Wmax
  RndN
  Secret = V + 1
  Gv = Wmax >> 1
  Lo = 1
  Hi = Wmax
  for Ka = 1 to 6
    print at 2,7, "ENTER GUESS"
    NumU = Ka
    print at 14,7, width$(NumU, 1)
    NumberPick
    if Res = 1 then goto title
    Y = Ka + 8
    NumU = Gv
    print at 2,Y, width$(NumU, 2)
    if Gv = Secret then goto cv_got
    if Gv < Secret then
      print at 5,Y, "TOO LOW!"
    else
      print at 5,Y, "TOO HIGH!"
    end if
    play sound SndBad
  next
  print at 2,16, "PRETTY HOPELESS..."
  print at 2,17, "I WAS THINKING OF"
  NumU = Secret
  print at 20,17, width$(NumU, 2)
  if Wmax = 5 then
    print at 2,19, "YOU'RE HOPELESS... LET'S"
    print at 2,20, "TRY SOMETHING ELSE"
    GoOn
    if Res = 1 then goto title
    goto cv_age
  end if
  print at 2,19, "WELL, I GUESS I'LL HAVE TO"
  print at 2,20, "GIVE YOU ANOTHER GO..."
  GoOn
  if Res = 1 then goto title
  Wmax = Wmax >> 1
  goto cv_think
cv_got:
  play sound SndWin
  print at 2,16, "WOWEE!!! ZAP!!!"
  print at 2,17, "YOU DID IT, BABY..."
  GoOn
  if Res = 1 then goto title
  ' 3: your age and your change
cv_age:
  CvScreen
  print at 2,4, "NOW, IT'S TIME TO BE"
  print at 2,5, "AMAZED..."
  print at 2,7, "FOLLOW THESE INSTRUCTIONS,"
  print at 2,8, "AND PRESS THE BUTTON AFTER"
  print at 2,9, "YOU'VE CARRIED THEM OUT..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "START BY MULTIPLYING YOUR"
  print at 2,7, "AGE BY TWO..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "NOW ADD FIVE TO THAT..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "NOW MULTIPLY THAT BY 50..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "NOW SUBTRACT 365 FROM"
  print at 2,7, "THAT..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "NOW ADD THE AMOUNT OF LOOSE"
  print at 2,7, "CHANGE IN YOUR POCKET"
  print at 2,8, "(LESS THAN 100 CENTS)..."
  GoOn
  if Res = 1 then goto title
  CvStep
  print at 2,6, "NOW GIVE ME THE NUMBER"
  print at 2,7, "YOU'VE ENDED UP WITH..."
  FourDigits
  if Res = 1 then goto title
  ' the book: A + 115; hundreds are the age, the rest the change
  Uw = D4[1]
  Uw = Uw * 1000
  Ub = D4[2]
  Ub = Ub * 100
  Uw = Uw + Ub
  Ub = D4[3]
  Ub = Ub * 10
  Uw = Uw + Ub
  Ub = D4[4]
  Uw = Uw + Ub
  Uw = Uw + 115
  Ub = Uw / 100
  NumU = Ub
  NumU = NumU * 100
  Uw = Uw - NumU
  play sound SndMagic
  print at 2,13, "YOU HAVE"
  NumU = Uw
  print at 11,13, width$(NumU, 2)
  print at 14,13, "CENTS CHANGE..."
  Pause
  print at 2,15, "AND ARE"
  NumU = Ub
  print at 10,15, width$(NumU, 3)
  print at 14,15, "YEARS OLD..."
  GoOn
  if Res = 1 then goto title
  ' 4: the frogs
  CvScreen
  print at 2,4, "NOW TO GET YOUR MIND BACK"
  print at 2,5, "INTO GEAR..."
  print at 2,7, "TWO TEAMS OF FOUR FROGS,"
  print at 2,8, "A SPACE BETWEEN THEM. SWAP"
  print at 2,9, "THEM IN THE FEWEST MOVES."
  print at 2,11, "A FROG CAN SLIDE INTO THE"
  print at 2,12, "SPACE, OR JUMP OVER ONE"
  print at 2,13, "FROG INTO IT."
  GoOn
  if Res = 1 then goto title
cv_frogs:
  NewScreen
  backdrop light blue
  print at 2,1, "THE FROGS"
  for Y = 7 to 12
    fill TWater count 32 at 0,Y
  next
  for K = 1 to 9
    Fr[K] = 0
    if K < 5 then Fr[K] = 1
    if K > 5 then Fr[K] = 2
    FrogDraw
    X = K * 3
    NumU = K
    print at X,13, width$(NumU, 1)
  next
  print at 2,22, "2ND BUTTON: MENU"
  ShowScreen
  Hole = 5
  Moves = 0
  Pos = 4
cv_fturn:
  ' the book counts each frog in its new place
  Cnt = 0
  for K = 1 to 4
    if Fr[K] = 2 then inc Cnt
  next
  for K = 6 to 9
    if Fr[K] = 1 then inc Cnt
  next
  print at 2,16, "MOVES:"
  NumU = Moves
  print at 9,16, width$(NumU, 3)
  print at 2,17, "YOU HAVE"
  NumU = Cnt
  print at 11,17, width$(NumU, 1)
  print at 13,17, "CORRECT"
  if Cnt = 8 then
    HideSprites
    play sound SndWin
    print at 2,19, "WELL DONE... YOU SOLVED IT"
    print at 2,20, "IN JUST"
    NumU = Moves
    print at 10,20, width$(NumU, 3)
    print at 14,20, "MOVES!"
    GoOn
    CvScreen
    print at 2,6, "THAT BRINGS US TO THE END"
    print at 2,7, "OF OUR CAVALCADE OF PUZZLES"
    play sound SndMagic
    Celebrate
    EndWait
    if Res = 0 then goto cavalcade
    goto title
  end if
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
cv_fpick:
  if Res = 1 then
    X = Pos * 3
    Sx = X << 3
    Sy = 71
    set sprite 0 to Sy, Sx, SRing, 15
    update sprites
    Res = 0
  end if
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Pos > 1 then dec Pos
    end if
    if Rt1 = 1 then
      if Pos < 9 then inc Pos
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then goto title
  if Press = 0 then goto cv_fpick
  ' a slide or a jump into the space
  Res = 1
  if Fr[Pos] = 0 then
    play sound SndBad
    goto cv_fpick
  end if
  V = 0
  if Pos + 1 = Hole then V = 1
  if Pos + 2 = Hole then V = 1
  if Hole + 1 = Pos then V = 1
  if Hole + 2 = Pos then V = 1
  if V = 0 then
    play sound SndBad
    goto cv_fpick
  end if
  Fr[Hole] = Fr[Pos]
  Fr[Pos] = 0
  K = Hole
  FrogDraw
  K = Pos
  FrogDraw
  Hole = Pos
  play sound SndCroak
  inc Moves
  goto cv_fturn

' ---------------------------------------------------------------------------
' NIMGRAB helpers

' NimDraw: gem K (rows of 12 from column 3, rows 5 and 9)
sub NimDraw:
  NimXY
  V = 32
  if Gm[K] = 1 then V = TGem00
  if Gm[K] = 2 then V = TGemlit00
  if V = 32 then
    fill 32 count 2 at X,Y
    W = Y + 1
    fill 32 count 2 at X,W
    return
  end if
  put char V at X,Y
  inc V
  W = X + 1
  put char V at W,Y
  inc V
  Y = Y + 1
  put char V at X,Y
  inc V
  put char V at W,Y
  return
end sub

sub NimXY:
  V = K - 1
  Y = 5
  if V >= 12 then
    V = V - 12
    Y = 9
  end if
  X = V << 1
  X = X + 3
  return
end sub

' NimLight: the last Eg gems lit (the ones to go)
sub NimLight:
  for K = 1 to Z
    V = Z - Eg
    W = 1
    if K > V then W = 2
    if Gm[K] <> W then
      Gm[K] = W
      NimDraw
    end if
  next
  return
end sub

' NimTake: Kc gems go from the end, with a sparkle
sub NimTake:
  play sound SndGrab
  for I = 1 to Kc
    K = Z
    NimXY
    Sx = X << 3
    Sy = Y << 3
    Sy = Sy - 1
    for J = 1 to 8
      V = J & 2
      if V = 0 then
        set sprite 1 to Sy, Sx, SSpark, 15
      else
        set sprite 1 to 192, 0, 0, 0
      end if
      update sprites
      Frame1
    next
    set sprite 1 to 192, 0, 0, 0
    update sprites
    K = Z
    Gm[K] = 0
    NimDraw
    dec Z
  next
  return
end sub

sub NimSay:
  for Y = 18 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

' ---------------------------------------------------------------------------
' FOLLOW THE LEADER helpers

' FoPadXY: digit K of the pad: 0-4 on row 13, 5-9 on row 17
sub FoPadXY:
  V = K
  Y = 13
  if V >= 5 then
    V = V - 5
    Y = 17
  end if
  X = V * 4
  X = X + 7
  return
end sub

' FoClear: the digits row and the message row
sub FoClear:
  fill 32 count 28 at 2,4
  fill 32 count 28 at 2,5
  fill 32 count 28 at 2,9
  fill 32 count 28 at 2,10
  fill 32 count 28 at 2,11
  return
end sub

' BlockAt: number block Dd at X, Y
sub BlockAt:
  V = Dd << 2
  V = V + TNum000
  put char V at X,Y
  inc V
  W = X + 1
  put char V at W,Y
  inc V
  Kc = Y + 1
  put char V at X,Kc
  inc V
  put char V at W,Kc
  return
end sub

' ---------------------------------------------------------------------------
' NOUGHTS AND CROSSES helpers

' NcXY: square K at column X, row Y (3 x 3 tiles)
sub NcXY:
  V = K - 1
  W = V % 3
  X = W << 2
  X = X + 9
  W = V / 3
  Y = W << 2
  Y = Y + 4
  return
end sub

sub NcDraw:
  NcXY
  V = TXx00
  if Bd[K] = 1 then V = TOo00
  for I = 0 to 2
    W = Y + I
    put char V at X,W
    inc V
    Kc = X + 1
    put char V at Kc,W
    inc V
    Kc = X + 2
    put char V at Kc,W
    inc V
  next
  return
end sub

sub NcSay:
  for Y = 17 to 20
    fill 32 count 28 at 2,Y
  next
  return
end sub

sub NcScore:
  print at 21,4, "YOU"
  NumU = WinsU
  print at 26,4, width$(NumU, 2)
  print at 21,6, "ME"
  NumU = WinsC
  print at 26,6, width$(NumU, 2)
  print at 21,8, "DRAWN"
  NumU = Draws
  print at 26,8, width$(NumU, 2)
  return
end sub

' NcLine: line Ln (0-7): its squares La, Lb, Lc (the book's rows,
' columns, then the two diagonals)
sub NcLine:
  if Ln < 3 then
    La = Ln * 3
    La = La + 1
    Lb = La + 1
    Lc = La + 2
    return
  end if
  if Ln < 6 then
    La = Ln - 2
    Lb = La + 3
    Lc = La + 6
    return
  end if
  Lb = 5
  if Ln = 6 then
    La = 1
    Lc = 9
  else
    La = 3
    Lc = 7
  end if
  return
end sub

' NcCheck: Who = 1 (the computer), 2 (you) if a line is full
sub NcCheck:
  Who = 0
  for Ln = 0 to 7
    NcLine
    V = Bd[La]
    if V > 0 then
      if Bd[Lb] = V then
        if Bd[Lc] = V then Who = V
      end if
    end if
  next
  return
end sub

' NcMove: the book: the centre if free; then complete its own line, then
' block yours; else a random free square (20 tries), else the first free.
' K is the square; Res 0 if the board is full
sub NcMove:
  Res = 1
  if Bd[5] = 0 then
    K = 5
    Bd[5] = 1
    return
  end if
  for Dd = 1 to 2
    for Ln = 0 to 7
      NcLine
      K = 0
      if Bd[La] = Dd then
        if Bd[Lb] = Dd then
          if Bd[Lc] = 0 then K = Lc
        end if
      end if
      if Bd[La] = Dd then
        if Bd[Lb] = 0 then
          if Bd[Lc] = Dd then K = Lb
        end if
      end if
      if Bd[La] = 0 then
        if Bd[Lb] = Dd then
          if Bd[Lc] = Dd then K = La
        end if
      end if
      if K > 0 then
        Bd[K] = 1
        return
      end if
    next
  next
  for J = 1 to 20
    Nr = 9
    RndN
    K = V + 1
    if Bd[K] = 0 then
      Bd[K] = 1
      return
    end if
  next
  for K = 1 to 9
    if Bd[K] = 0 then
      Bd[K] = 1
      return
    end if
  next
  Res = 0
  return
end sub

' ---------------------------------------------------------------------------
' CAVALCADE helpers

sub CvScreen:
  NewScreen
  backdrop dark red
  print at 2,1, "CAVALCADE OF PUZZLES"
  ShowScreen
  return
end sub

' CvStep: the instruction rows cleared
sub CvStep:
  for Y = 4 to 20
    fill 32 count 28 at 2,Y
  next
  return
end sub

' GoOn: press the button to go on; Res 1 for the second button
sub GoOn:
  print at 2,22, "BUTTON: ON     2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
go_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto go_loop
  fill 32 count 28 at 2,22
  Res = 0
  return
end sub

' YesNo: Res 1 for YES, 0 for NO, 2 to leave
sub YesNo:
  print at 6,18, "YES"
  print at 18,18, "NO"
  print at 2,22, "2ND BUTTON: MENU"
  Pos = 0
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
yn_loop:
  if Res = 1 then
    print at 4,18, " "
    print at 16,18, " "
    X = 4
    if Pos = 1 then X = 16
    print at X,18, ">"
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then Pos = 0
    if Rt1 = 1 then Pos = 1
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 2
    return
  end if
  if Press = 0 then goto yn_loop
  play sound SndShow
  Res = 1 - Pos
  return
end sub

' NumberPick: Gv from Lo to Hi, shown at 17,7; Res 1 to leave
sub NumberPick:
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
nm_loop:
  if Res = 1 then
    NumU = Gv
    print at 17,7, width$(NumU, 2)
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Gv < Hi then inc Gv
    end if
    if Dn1 = 1 then
      if Gv > Lo then dec Gv
    end if
    if Rt1 = 1 then
      Gv = Gv + 5
      if Gv > Hi then Gv = Hi
    end if
    if Lf1 = 1 then
      if Gv > 5 then
        Gv = Gv - 5
      else
        Gv = Lo
      end if
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto nm_loop
  Res = 0
  return
end sub

' FourDigits: D4[1..4] with the stick (up and down change, left and
' right move); the button ends; Res 1 to leave
sub FourDigits:
  for K = 1 to 4
    D4[K] = 0
  next
  Pos = 1
  print at 2,22, "BUTTON: DONE   2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
fd_loop:
  if Res = 1 then
    for K = 1 to 4
      X = K << 1
      X = X + 10
      NumU = D4[K]
      print at X,10, width$(NumU, 1)
      V = 32
      if K = Pos then V = 45
      put char V at X,11
    next
    Res = 0
  end if
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Pos > 1 then dec Pos
    end if
    if Rt1 = 1 then
      if Pos < 4 then inc Pos
    end if
    if Up1 = 1 then
      V = D4[Pos] + 1
      if V > 9 then V = 0
      D4[Pos] = V
    end if
    if Dn1 = 1 then
      V = D4[Pos]
      if V = 0 then
        V = 9
      else
        dec V
      end if
      D4[Pos] = V
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Res = 1
    return
  end if
  if Press = 0 then goto fd_loop
  fill 32 count 28 at 2,22
  Res = 0
  return
end sub

' FrogDraw: place K (1-9) at column 3K - 1, rows 9-10: a frog or a pad
sub FrogDraw:
  X = K * 3
  X = X - 1
  Y = 9
  V = TPad00
  if Fr[K] = 1 then V = TFrogg00
  if Fr[K] = 2 then V = TFrogy00
  put char V at X,Y
  inc V
  W = X + 1
  put char V at W,Y
  inc V
  Y = Y + 1
  put char V at X,Y
  inc V
  put char V at W,Y
  return
end sub

' ---------------------------------------------------------------------------
' Celebrate: three bursts of sparks for a solved puzzle
sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

' ----------------------------------------------------------------------------
' Common

' EndWait: Res 0 for the button (again), 1 for the second (menu)
sub EndWait:
  print at 2,22, "BUTTON: AGAIN  2ND: MENU"
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    HideSprites
    Res = 1
    return
  end if
  if Press = 0 then goto ew_loop
  HideSprites
  Res = 0
  return
end sub

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Ub = 0
  for J = 1 to Nr
    Ub = Ub + Uw
  next
  Ub = Ub >> 8
  V = Ub
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 2
  sprites stable 0 to 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  backdrop dark blue
  print at 9,2, "JUST FOR FUN"
  ' a gem, an X, an O and a frog
  Gm[1] = 1
  K = 1
  NimDraw
  K = 1
  Bd[1] = 2
  NcDraw
  K = 3
  Bd[3] = 1
  NcDraw
  print at 9,8, "NIMGRAB"
  print at 9,9, "FOLLOW THE LEADER"
  print at 9,10, "NOUGHTS AND CROSSES"
  print at 9,11, "CAVALCADE OF PUZZLES"
  print at 9,13, "HOW TO PLAY"
  print at 9,14, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 5 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 8 to 14
    print at 7,I, " "
  next
  Y = Menu + 8
  if Menu >= 4 then inc Y
  print at 7,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "NIMGRAB: TAKE TURNS TO GRAB"
  print at 2,4, "GEMS (UP, DOWN: HOW MANY)."
  print at 2,5, "WHOEVER TAKES THE LAST ONE"
  print at 2,6, "LOSES."
  print at 2,8, "FOLLOW THE LEADER: COPY MY"
  print at 2,9, "DIGITS WITH THE PAD, ONE"
  print at 2,10, "MORE EACH TIME, UP TO 7."
  print at 2,12, "NOUGHTS AND CROSSES: YOU"
  print at 2,13, "ARE X. THREE IN A LINE."
  print at 2,15, "CAVALCADE: FOUR PUZZLES IN"
  print at 2,16, "A ROW, ENDING WITH FROGS:"
  print at 2,17, "SWAP THE TWO TEAMS."
  print at 2,19, "STICK: CHOOSE. BUTTON: GO."
  print at 2,20, "2ND BUTTON: BACK TO MENU."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,1, "JUST FOR FUN"
  print at 2,3, "NIMGRAB, FOLLOW THE LEADER,"
  print at 2,4, "NOUGHTS AND CROSSES AND"
  print at 2,5, "CAVALCADE OF PUZZLES FROM"
  print at 2,6, "TIM HARTNELL'S GIANT BOOK"
  print at 2,7, "OF COMPUTER GAMES"
  print at 2,8, "(BALLANTINE BOOKS, 1984;"
  print at 2,9, "INTERFACE PUBLICATIONS,"
  print at 2,10, "1983)."
  print at 2,12, "MUSIC: RAINY AFTERNOON"
  print at 2,13, "(ORIGINAL)."
  print at 2,15, "COLECOVISION VERSION BY"
  print at 2,16, "AMY BIENVENU, 2026."
  PageWait
  return
end sub

