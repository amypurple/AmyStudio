Foe Foes[6]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Spd = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
' the baton: place, heading (1 up, 2 down, 4 left, 8 right)
u8 PX = 16
u8 PY = 92
u8 PD = 8
' the shot: place and heading (0 = none)
u8 MX = 0
u8 MY = 0
u8 MD = 0
u8 Frac = 0
u8 Steps = 0
u8 Sp = 0
u8 Lv = 1
u8 Lives = 3
u8 Shape = 0
u8 Hold = 0
u8 HoldK = 0
u8 Over = 0
u8 Won = 0
u8 Kills = 0
u8 Deaths = 0
u8 Spin = 0
u8 SpinT = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Df = 0
u8 Li = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ArSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER (or the original's surrender), then the title
  mute all
  if Won = 1 then
    print at 6,10, "                    "
    print at 6,11, " I GIVE UP!!!       "
    print at 6,12, "       YOU WIN!!!   "
    print at 6,13, "                    "
    play sound SndLevel
  else
    print at 9,10, "             "
    print at 9,11, "  GAME OVER  "
    print at 9,12, "             "
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: a death's or a cleared wave's pause, else the stick
' and as many passes of the C64's loop as the speed gives
sub PlayStep:
  if Hold > 0 then
    dec Hold
    if Hold = 0 then EndHold
    return
  end if
  Steer
  W16 = Frac
  W16 = W16 + Spd
  Steps = W16 >> 8
  Frac = W16 & 255
  while Steps > 0
    DoPass
    dec Steps
    if Hold > 0 then Steps = 0
  end while
  inc SpinT
  if SpinT >= 3 then
    SpinT = 0
    Spin = (Spin + 1) & 3
  end if
  return
end sub

' the stick: a plain direction turns the baton; the button throws a shot
' (the stick's way if pushed, else the baton's heading)
sub Steer:
  K = J1 & 15
  V = 0
  select case K
    case 1, 2, 4, 8
      V = K
  end select
  if Btn = 0 then
    if V > 0 then PD = V
    return
  end if
  if MD > 0 then return
  if V = 0 then V = PD
  MD = V
  MX = PX
  MY = PY
  play sound SndShot
  return
end sub

' one pass of the original's loop
sub DoPass:
  MoveShot
  ShotHits
  MoveShot
  ShotHits
  MoveFoes
  MoveBaton
  Touch
  return
end sub

sub MoveShot:
  select case MD
    case 0
      return
    case 1
      if MY <= 18 then
        MD = 0
      else
        dec MY
      end if
    case 2
      if MY >= 166 then
        MD = 0
      else
        inc MY
      end if
    case 4
      if MX <= 10 then
        MD = 0
      else
        dec MX
      end if
    case 8
      if MX >= 230 then
        MD = 0
      else
        inc MX
      end if
  end select
  return
end sub

' |A - B|
function Dist(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

' a random direction for one axis: none, minus or plus by thirds
function RandDir as i8
  Rand
  u8 R = Rs & 255
  if R < 85 then return 0
  if R < 170 then return -1
  return 1

sub ShotHits:
  if MD = 0 then return
  for Fi = 0 to 5
    if Foes[Fi].St = 1 then
      if Dist(MX, Foes[Fi].X) < 8 then
        if Dist(MY, Foes[Fi].Y) < 7 then
          Foes[Fi].St = 2
          Foes[Fi].Tm = BurstLen
          MD = 0
          Score += Lv
          if Score > Hi then Hi = Score
          inc Kills
          play sound SndBoom
          ShowScore
          if Score >= 10000 then
            Won = 1
            Over = 1
          end if
          return
        end if
      end if
    end if
  next
  return
end sub

' every foe a pixel; a wall turns it back on that axis and picks the other
' axis at random; bursts drift on and fade after 25 passes
sub MoveFoes:
  u8 Left = 0
  for Fi = 0 to 5
    if Foes[Fi].St > 0 then
      inc Left
      if Foes[Fi].St = 2 then
        dec Foes[Fi].Tm
        if Foes[Fi].Tm = 0 then Foes[Fi].St = 0
      end if
      select case Foes[Fi].Vx
        case -1
          if Foes[Fi].X <= XMin then
            Foes[Fi].Vx = 1
            Foes[Fi].Vy = RandDir()
          else
            dec Foes[Fi].X
          end if
        case 1
          if Foes[Fi].X >= XMax then
            Foes[Fi].Vx = -1
            Foes[Fi].Vy = RandDir()
          else
            inc Foes[Fi].X
          end if
      end select
      select case Foes[Fi].Vy
        case -1
          if Foes[Fi].Y <= YMin then
            Foes[Fi].Vy = 1
            Foes[Fi].Vx = RandDir()
          else
            dec Foes[Fi].Y
          end if
        case 1
          if Foes[Fi].Y >= YMax then
            Foes[Fi].Vy = -1
            Foes[Fi].Vx = RandDir()
          else
            inc Foes[Fi].Y
          end if
      end select
    end if
  next
  if Left = 0 then
    if Hold = 0 then
      Hold = HoldLen
      HoldK = 2
      play sound SndLevel
    end if
  end if
  return
end sub

sub MoveBaton:
  select case PD
    case 1
      if PY <= YMin then
        PD = 2
      else
        dec PY
      end if
    case 2
      if PY >= YMax then
        PD = 1
      else
        inc PY
      end if
    case 4
      if PX <= XMin then
        PD = 8
      else
        dec PX
      end if
    case 8
      if PX >= XMax then
        PD = 4
      else
        inc PX
      end if
  end select
  return
end sub

' a live foe touching the baton (middle 10 x 10 boxes)
sub Touch:
  if Hold > 0 then return
  for Fi = 0 to 5
    if Foes[Fi].St = 1 then
      if Dist(PX, Foes[Fi].X) < 10 then
        if Dist(PY, Foes[Fi].Y) < 10 then
          Hold = HoldLen
          HoldK = 1
          inc Deaths
          play sound SndDie
          return
        end if
      end if
    end if
  next
  return
end sub

' the end of a pause: after a death a life goes and the wave restarts in
' full; after a cleared wave, the next level
sub EndHold:
  if HoldK = 1 then
    dec Lives
    ShowLives
    if Lives = 0 then
      Over = 1
      return
    end if
  else
    inc Lv
    ShowLevel
  end if
  StartWave
  return
end sub

sub StartWave:
  copy FoeStart to Foes
  for Fi = 0 to 5
    Foes[Fi].Vy = RandDir()
  next
  K = Lv - 1
  if K > 10 then K = 10
  J = Sp * 11 + K
  Spd = SpdT[J]
  Shape = Lv - 1
  while Shape >= 10
    Shape -= 10
  end while
  PX = XMin
  PY = 92
  PD = 8
  MD = 0
  Frac = 0
  Hold = 0
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the baton (knobs, staff), 2 the shot, 3-8 the foes
sub DrawSprites:
  K = Spin * 4
  if HoldK = 1 then
    if Hold > 0 then
      ' the fallen baton blinks its knobs (twice a second)
      V = Hold & 16
      if V > 0 then K = 255
    end if
  end if
  if K = 255 then
    set sprite 0 to 192,0,0,0
  else
    set sprite 0 to PY - 1,PX,SKnob0 + K,BatEnd[Spin]
  end if
  K = Spin * 4
  set sprite 1 to PY - 1,PX,SBat0 + K,15
  if MD > 0 then
    set sprite 2 to MY - 1,MX,SShot,9
  else
    set sprite 2 to 192,0,0,0
  end if
  for Df = 0 to 5
    J = Df + 3
    select case Foes[Df].St
      case 0
        set sprite J to 192,0,0,0
      case 1
        K = Shape * 4 + SFoe0
        set sprite J to Foes[Df].Y - 1,Foes[Df].X,K,FoeCol[Df]
      case 2
        if Foes[Df].Tm > 12 then
          set sprite J to Foes[Df].Y - 1,Foes[Df].X,SBur0,11
        else
          set sprite J to Foes[Df].Y - 1,Foes[Df].X,SBur1,9
        end if
    end select
  next
  update sprites
  return
end sub

sub ShowScore:
  print at 4,1, Score
  print at 18,1, Hi
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 13,1, digits$(NumU, 2)
  return
end sub

sub ShowLives:
  fill 32 count 3 at 26,1
  if Lives = 0 then return
  C = 25 + Lives
  for Li = 26 to C
    put char TLife at Li,1
  next
  return
end sub

sub NewGame:
  NewScreen
  copy ArenaMap count 768 to vram.name
  print at 2,1, "SC"
  print at 11,1, "LV"
  print at 16,1, "HI"
  Score = 0
  Lv = 1
  Lives = 3
  Over = 0
  Won = 0
  Kills = 0
  Deaths = 0
  Spin = 0
  SpinT = 0
  HoldK = 0
  StartWave
  ShowScore
  ShowLevel
  ShowLives
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: ARENA in carved stones, a spinning baton, the speed menu, the
' best score, the tune once
sub TitlePage:
  NewScreen
  print at 6,1, "AHOY! FEBRUARY 1986"
  copy TitleMap count 160 to vram.name + 96
  print at 4,10, "SHOOT THE SIX, MIND THE"
  print at 4,11, "WALLS. THE BATON SPINS!"
  print at 13,14, "SLOW"
  print at 13,15, "MEDIUM"
  print at 13,16, "FAST"
  print at 13,17, "CREDITS"
  if Hi > 0 then
    print at 9,20, "BEST ", Hi
  end if
  if Menu > 2 then Menu = Sp
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 3 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then
    CreditsPage
  else
    Sp = Menu
  end if
  return
end sub

' the baton spins beside the menu
sub TitleAnim:
  inc SpinT
  if SpinT >= 3 then
    SpinT = 0
    Spin = (Spin + 1) & 3
  end if
  K = Spin * 4
  J = Menu * 8 + 107
  set sprite 0 to J,64,SKnob0 + K,11
  set sprite 1 to J,64,SBat0 + K,15
  update sprites
  return
end sub

sub ShowMenu:
  for Li = 14 to 17
    put char 32 at 11,Li
  next
  J = Menu + 14
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "ARENA"
  print at 2,5, "BASED ON ARENA, AHOY!"
  print at 2,6, "FEBRUARY 1986 (COMMODORE 64"
  print at 2,7, "MACHINE LANGUAGE; THE"
  print at 2,8, "AUTHOR IS NOT NAMED)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: INTO THE PIT"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

