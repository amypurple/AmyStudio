const TLife = 135
const TTst = 136
const SBat0 = 0
const SBat1 = 4
const SBat2 = 8
const SBat3 = 12
const SKnob0 = 16
const SKnob1 = 20
const SKnob2 = 24
const SKnob3 = 28
const SShot = 32
const SBur0 = 36
const SBur1 = 40
const SFoe0 = 44
const SFoe1 = 48
const SFoe2 = 52
const SFoe3 = 56
const SFoe4 = 60
const SFoe5 = 64
const SFoe6 = 68
const SFoe7 = 72
const SFoe8 = 76
const SFoe9 = 80
const NTiles8 = 72
const SprBytes = 672
const SndTuneA = 1
const SndTuneB = 2
