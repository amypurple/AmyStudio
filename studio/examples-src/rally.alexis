u8 SteerV = 3
u8 GearV = 2
u8 TmN = 3
u8 QuitV = 60
u8 CountV0 = 20
u8 Idle = 0
u8 Scene = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Ri = 0
u8 Ti = 0
u8 Ki = 0
' scratch
u16 NumU = 0
u16 W16 = 0
i16 S16 = 0
u8 Va = 0
u8 Vb = 0
u8 Vc = 0
u8 Vk = 0
u8 Vx = 0
u8 Vy = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  call asm RrR3
  set sound table RrSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  select case Menu
  case 0
    GMode = 1
  case 1
    GMode = 2
  case 2
    EditTrack
    goto title
  case else
    CreditsPage
    goto title
  end select

  Race
  goto title

' ---------------------------------------------------------------------------
' the race

sub Race:
  RaceSetup
race_loop:
  Frame2
  ReadPad
  RaceStep
  CamStep
  DrawCars
  if Over = 0 then goto race_loop
  RaceEnd
  return
end sub

sub RaceSetup:
  if GMode = 1 then
    NCar = 1
    PassF = 2
    SteerV = SteerN
    GearV = GearN
    TmN = 6
    QuitV = QuitN
    CountV0 = CountN
    WinW = 12
    HalfW = 6
    WinCol[0] = 10
  else
    NCar = 2
    PassF = 4
    SteerV = 2
    GearV = 1
    TmN = 6
    QuitV = 30
    CountV0 = 10
    WinW = 13
    HalfW = 6
    WinCol[0] = 2
    WinCol[1] = 17
  end if
  SetTrackAdr
  NewScreen
  LoadTiles
  ' panels and the bar between the windows
  for Ri = 1 to 22
    if GMode = 1 then
      fill TPanel count 8 at 2,Ri
      fill TPanel count 8 at 22,Ri
    else
      put char TBar at 15,Ri
      put char TBar at 16,Ri
    end if
  next
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  fill TPanel count 28 at 2,3
  fill TPanel count 28 at 2,22
  if GMode = 1 then
    fill 32 count 22 at 5,1
    fill 32 count 12 at 10,2
  end if
  for Ci = 0 to NCar - 1
    StartCar(Ci)
  next
  Tm = 0
  TmF = 0
  Over = 0
  Winner = 0
  CountV = 3
  CountT = CountV0
  ShowHud
  for Ci = 0 to NCar - 1
    DrawWindow(Ci)
    ShowGear(Ci)
  next
  ShowCount
  DrawCars
  ShowScreen
  play sound SndBeep
  Rearm
  wait no fire
  nmi off
  return
end sub

' a car on the start line, facing left (as on the C64)
sub StartCar(u8 P):
  Cars[P].X = LineX + 12
  Cars[P].Y = 48
  Cars[P].FX = 0
  Cars[P].FY = 0
  Cars[P].Hd = 6
  Cars[P].Gear = 0
  Cars[P].StT = 0
  Cars[P].GrT = 0
  Cars[P].Half = 0
  Cars[P].Done = 0
  Cars[P].Hold = 0
  CurP = P
  LoadCar
  CamTarget
  Cars[P].CamX = TgX
  Cars[P].CamY = TgY
  return
end sub

sub RaceStep:
  if CountV > 0 then
    CountDown
  else
    RaceRun
  end if
  return
end sub

sub CountDown:
  dec CountT
  if CountT = 0 then
    dec CountV
    CountT = CountV0
    ShowCount
    if CountV = 0 then
      play sound SndGo
    else
      play sound SndBeep
    end if
  end if
  return
end sub

sub RaceRun:
  if CountT > 0 then
    dec CountT
    if CountT = 0 then ShowCount
  end if
  ' the clock: a tenth every 6 frames (TmF counts frames)
  TmF = TmF + PassF
  if TmF >= TmN then
    TmF = TmF - TmN
    inc Tm
    ShowTime
  end if
  for Ci = 0 to NCar - 1
    CurP = Ci
    LoadCar
    DriveCar
    SaveCar
    if CDone = 1 then
      if Over = 0 then
        Over = 1
        Winner = Ci
      end if
    end if
    ' a button held two seconds gives up the race
    Va = Pad[Ci] & 16
    if Va > 0 then
      Vb = Cars[Ci].Hold + 1
      Cars[Ci].Hold = Vb
      if Vb >= QuitV then Over = 3
    else
      Cars[Ci].Hold = 0
    end if
  next
  if Over = 0 then
    if Tm >= TLim then Over = 2
  end if
  return
end sub

sub LoadCar:
  CX = Cars[CurP].X
  CY = Cars[CurP].Y
  CFx = Cars[CurP].FX
  CFy = Cars[CurP].FY
  CHd = Cars[CurP].Hd
  CGear = Cars[CurP].Gear
  CStT = Cars[CurP].StT
  CGrT = Cars[CurP].GrT
  CHalf = Cars[CurP].Half
  CDone = Cars[CurP].Done
  return
end sub

sub SaveCar:
  Cars[CurP].X = CX
  Cars[CurP].Y = CY
  Cars[CurP].FX = CFx
  Cars[CurP].FY = CFy
  Cars[CurP].Hd = CHd
  Cars[CurP].Gear = CGear
  Cars[CurP].StT = CStT
  Cars[CurP].GrT = CGrT
  Cars[CurP].Half = CHalf
  Cars[CurP].Done = CDone
  return
end sub

' one frame of one car: steering, gears, the move, walls, the lines
' (globals Stk, Lr, Ud: the stack is short)
sub DriveCar:
  Stk = Pad[CurP]
  Lr = Stk & 12
  if Lr = 0 or Lr = 12 then
    CStT = 0
  elseif CStT = 0 then
    if Lr = 4 then
      CHd = CHd + 7
    else
      CHd = CHd + 1
    end if
    CHd = CHd & 7
    CStT = SteerV
  else
    dec CStT
  end if
  Ud = Stk & 3
  if Ud = 0 or Ud = 3 then
    CGrT = 0
  elseif CGrT = 0 then
    if Ud = 1 then
      if CGear < 6 then
        inc CGear
        ShiftSound
      end if
    else
      if CGear > 0 then dec CGear
    end if
    CGrT = GearV
    ShowGear(CurP)
  else
    dec CGrT
  end if
  if CDone = 1 then CGear = 0
  if PassF = 2 then
    Spd = SpdT[CGear]
  else
    Spd = SpdT4[CGear]
  end if
  OldX = CX
  OldY = CY
  Va = DXc[CHd]
  if Va > 0 then
    Acc = Spd + CFx
    CFx = lowbyte Acc
    Mv = highbyte Acc
    if Va = 1 then
      CX = CX + Mv
    else
      CX = CX - Mv
    end if
  end if
  Va = DYc[CHd]
  if Va > 0 then
    Acc = Spd + CFy
    CFy = lowbyte Acc
    Mv = highbyte Acc
    if Va = 1 then
      CY = CY + Mv
    else
      CY = CY - Mv
    end if
  end if
  Hit = CarHits(CX, CY)
  if Hit > 0 then
    CX = OldX
    CY = OldY
    CFx = 0
    CFy = 0
    if CGear > 0 then
      CGear = 0
      ShowGear(CurP)
      play sound SndCrash
    end if
  else
    CrossLines
  end if
  return
end sub

' the C64 sound of a gear change, by car
sub ShiftSound:
  if CurP = 0 then
    play sound SndShift
  else
    play sound SndShift2
  end if
  return
end sub

' 1 when the car's box (11 x 11 pixels round X, Y) touches a wall
function CarHits(u16 Hx, u16 Hy) as u8
  u8 Got = 0
  QX = Hx - 5
  QY = Hy - 5
  call asm RrWall
  Got = QW
  QX = Hx + 5
  call asm RrWall
  Got = Got | QW
  QY = Hy + 5
  call asm RrWall
  Got = Got | QW
  QX = Hx - 5
  call asm RrWall
  Got = Got | QW
  return Got

' the start/finish and half-lap lines (x = LineX): half-lap first
sub CrossLines:
  WasL = 0
  NowL = 0
  if OldX < LineX then WasL = 1
  if CX < LineX then NowL = 1
  if WasL = NowL then return
  if CY >= 576 then
    if CY < 608 then
      if CHalf = 0 then
        CHalf = 1
        play sound SndHalf
        ShowGear(CurP)
      end if
    end if
  end if
  if CY >= 32 then
    if CY < 64 then
      if CHalf = 1 then CDone = 1
    end if
  end if
  return
end sub

' where the window wants to be: centred on the car, looking ahead
sub CamTarget:
  S16 = CX >> 3
  S16 = S16 - HalfW
  TgX = S16
  S16 = CY >> 3
  S16 = S16 - 9
  TgY = S16
  return
end sub

' the windows are locked to the cars: a window moves exactly one cell when
' its car crosses a cell. The cells already on screen are moved (RrScroll,
' VRAM to VRAM) and only the freed column and row are drawn
sub CamStep:
  for Ki = 0 to NCar - 1
    CurP = Ki
    LoadCar
    CamTarget
    SDx = TgX - Cars[Ki].CamX
    SDy = TgY - Cars[Ki].CamY
    if SDx <> 0 or SDy <> 0 then
      Cars[Ki].CamX = TgX
      Cars[Ki].CamY = TgY
      if SDx > 1 or SDx < -1 or SDy > 1 or SDy < -1 then
        DrawWindow(Ki)
      else
        PWn = Ki
        ScrollWindow
      end if
    end if
  next
  return
end sub

' (globals, not parameters: the stack is short)
sub ScrollWindow:
  ShDx = 0
  ShDy = 0
  if SDx = 1 then ShDx = 1
  if SDx = -1 then ShDx = 2
  if SDy = 1 then ShDy = 1
  if SDy = -1 then ShDy = 2
  RW = WinW
  RDst = NameBase + 128
  RDst = RDst + WinCol[PWn]
  call asm RrScroll
  if ShDx = 1 then
    PC0 = WinW - 1
    PNc = 1
    PR0 = 0
    PNr = 18
    DrawPart
  end if
  if ShDx = 2 then
    PC0 = 0
    PNc = 1
    PR0 = 0
    PNr = 18
    DrawPart
  end if
  if ShDy = 1 then
    PC0 = 0
    PNc = WinW
    PR0 = 17
    PNr = 1
    DrawPart
  end if
  if ShDy = 2 then
    PC0 = 0
    PNc = WinW
    PR0 = 0
    PNr = 1
    DrawPart
  end if
  return
end sub

sub DrawWindow(u8 Wn):
  PWn = Wn
  PC0 = 0
  PNc = WinW
  PR0 = 0
  PNr = 18
  DrawPart
  return
end sub

' columns C0 .. C0 + Nc - 1 and rows R0 .. R0 + Nr - 1 of window Wn
sub DrawPart:
  RTrk = TrkAdr
  RCx = Cars[PWn].CamX + PC0
  RCy = Cars[PWn].CamY
  RR0 = PR0
  RREnd = PR0 + PNr
  RW = PNc
  ' the columns: trees left of the map, map cells, trees right of it
  ' (the usual case, all on the map, is worked out in bytes)
  Ce = RCx + PNc
  if RCx >= 0 and Ce <= 240 then
    RLead = 0
    RTrail = 0
    RNv = PNc
    Va = lowbyte RCx
    RPx0 = Div3[Va]
    RSx0 = Mod3[Va]
    Vb = Va + PNc
    Vb = Vb - 1
    Vb = Div3[Vb]
    RNpx = Vb - RPx0
    inc RNpx
  else
    RLead = 0
    RNv = 0
    RNpx = 0
    Cs = RCx
    Ce = RCx + PNc
    Ce = Ce - 1
    if Cs < 0 then
      Cs = 0
      S16 = 0 - RCx
      if S16 > PNc then S16 = PNc
      RLead = lowbyte S16
    end if
    if Ce > 239 then Ce = 239
    if Cs <= Ce and Cs < 240 and Ce >= 0 then
      S16 = Ce - Cs
      RNv = lowbyte S16
      inc RNv
      Va = lowbyte Cs
      RPx0 = Div3[Va]
      RSx0 = Mod3[Va]
      Vb = lowbyte Ce
      Vb = Div3[Vb]
      RNpx = Vb - RPx0
      inc RNpx
    else
      RLead = PNc
    end if
    RTrail = PNc - RLead
    RTrail = RTrail - RNv
  end if
  RDst = NameBase + 128
  RDst = RDst + WinCol[PWn]
  RDst = RDst + PC0
  call asm RrDraw
  return
end sub

' the car sprites, inside their windows
sub DrawCars:
  i16 Rel = 0
  i16 Lim = 0
  for Ci = 0 to 1
    if Ci < NCar then
      Rel = Cars[Ci].X >> 3
      Rel = Rel - Cars[Ci].CamX
      Rel = Rel << 3
      Va = lowbyte Cars[Ci].X
      Va = Va & 7
      Rel = Rel + Va
      Lim = WinW << 3
      Lim = Lim - 8
      if Rel < 8 then Rel = 8
      if Rel > Lim then Rel = Lim
      Rel = Rel - 8
      Sx = lowbyte Rel
      Sx = Sx + WinCol[Ci] * 8
      Rel = Cars[Ci].Y >> 3
      Rel = Rel - Cars[Ci].CamY
      Rel = Rel << 3
      Va = lowbyte Cars[Ci].Y
      Va = Va & 7
      Rel = Rel + Va
      if Rel < 8 then Rel = 8
      if Rel > 136 then Rel = 136
      Sy = lowbyte Rel
      Sy = Sy + 23
      Vk = Cars[Ci].Hd << 2
      Vk = Vk + SCar0
      Vc = CarCol[Ci]
      set sprite Ci to Sy,Sx,Vk,Vc
    else
      set sprite Ci to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' the panel

sub ShowHud:
  if GMode = 1 then
    print at 6,1, "TIME"
    print at 18,1, "BEST"
  else
    print at 2,1, "TIME"
    print at 18,1, "BEST"
  end if
  ShowTime
  NumU = Best[TrkSel]
  ShowClock(23, 1)
  return
end sub

sub ShowTime:
  NumU = Tm
  if GMode = 1 then
    ShowClock(11, 1)
  else
    ShowClock(7, 1)
  end if
  return
end sub

' NumU tenths as M:SS.T at Col, Row (0 = none yet)
sub ShowClock(u8 Col, u8 Row):
  u16 Mins = 0
  u16 Secs = 0
  u16 Tenth = 0
  if NumU = 0 then
    print at Col,Row, "-:--.-"
  else
    Mins = NumU / 600
    Secs = NumU / 10
    Secs = Secs % 60
    Tenth = NumU % 10
    print at Col,Row, digits$(Mins, 1)
    print at Col + 1,Row, ":"
    print at Col + 2,Row, digits$(Secs, 2)
    print at Col + 4,Row, "."
    print at Col + 5,Row, digits$(Tenth, 1)
  end if
  return
end sub

sub ShowGear(u8 P):
  Vx = WinCol[P]
  print at Vx,2, "GEAR"
  NumU = Cars[P].Gear
  if P = CurP then NumU = CGear
  print at Vx + 5,2, digits$(NumU, 1)
  Va = Cars[P].Half
  if P = CurP then Va = CHalf
  if Va = 1 then
    print at Vx + 8,2, "HALF"
  else
    print at Vx + 8,2, "    "
  end if
  return
end sub

' the 3-2-1-GO in the middle of each window
sub ShowCount:
  for Ti = 0 to NCar - 1
    Vx = WinW >> 1
    Vx = Vx + WinCol[Ti]
    Vx = Vx - 1
    if CountV > 0 then
      print at Vx,8, " "
      NumU = CountV
      print at Vx + 1,8, digits$(NumU, 1)
      print at Vx + 2,8, " "
    elseif CountT > 0 then
      print at Vx,8, "GO!"
    else
      DrawWindow(Ti)
    end if
  next
  return
end sub

sub RaceEnd:
  u8 Rec = 0
  mute all
  if Over = 1 then
    if Best[TrkSel] = 0 or Tm < Best[TrkSel] then
      Best[TrkSel] = Tm
      Rec = 1
    end if
    NumU = Best[TrkSel]
    ShowClock(23, 1)
  end if
  Vx = WinCol[0] + 1
  if GMode = 2 then Vx = 9
  select case Over
  case 1
    if GMode = 1 then
      print at 8,9, "                "
      print at 8,10, "    FINISHED    "
      print at 8,12, "                "
      NumU = Tm
      ShowClock(13, 11)
      print at 19,11, "     "
    else
      Vx = WinCol[Winner] + 2
      print at Vx,10, "        "
      print at Vx,11, " WINNER "
      print at Vx,12, "        "
    end if
    if Rec = 1 then
      print at 9,14, "            "
      print at 9,15, " NEW RECORD "
      print at 9,16, "            "
    end if
    play sound SndWin
  case 2
    print at 9,10, "            "
    print at 9,11, "  TIME  UP  "
    print at 9,12, "            "
    play sound SndOver
  case else
    print at 9,10, "            "
    print at 9,11, "  GAVE  UP  "
    print at 9,12, "            "
    play sound SndOver
  end select
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' tracks

sub SetTrackAdr:
  if TrkSel >= NTracks then
    TrkAdr = 0
    RVr = 1
  else
    RVr = 0
    TrkAdr = address of TrkData
    W16 = TrkSel
    W16 = W16 * 400
    TrkAdr = TrkAdr + W16
  end if
  return
end sub

' the editor's fixed pixels: start and half-lap corridors (rallycode $C81D)
sub ForceTrack:
  vpoke vram.name + 1039, 255
  vpoke vram.name + 1049, 0
  vpoke vram.name + 1059, 0
  vpoke vram.name + 1069, 255
  vpoke vram.name + 1379, 255
  vpoke vram.name + 1389, 0
  vpoke vram.name + 1399, 0
  vpoke vram.name + 1409, 255
  return
end sub

' the title's map of the chosen track: 160 x 40 pixels (each track pixel
' two wide) in codes 128-227 of the middle screen third, at 6-25, 9-13
sub DrawMap:
  u16 Src = 0
  u16 Dst = 0
  u8 Ty = 0
  u8 Tx = 0
  u8 Rn = 0
  u8 Byt = 0
  SetTrackAdr
  Dst = 3072
  for Ty = 0 to 4
    for Tx = 0 to 19
      Src = Ty * 80
      Src = Src + TrkAdr
      Vb = Tx >> 1
      Src = Src + Vb
      for Rn = 0 to 7
        if RVr = 1 then
          vpeek vram.name + 1024 + Src into Byt
        else
          Byt = peek(Src)
        end if
        Vb = Tx & 1
        if Vb = 0 then
          Byt = Byt >> 4
        else
          Byt = Byt & 15
        end if
        ClsBuf[Rn] = Dbl[Byt]
        Src = Src + 10
      next
      copy ClsBuf count 8 to vram.pattern + Dst
      Dst = Dst + 8
    next
  next
  fill $31 count 800 to vram.color + 3072
  Vk = 128
  for Ty = 0 to 4
    Vy = Ty + 9
    for Tx = 0 to 19
      Vx = Tx + 6
      put char Vk at Vx,Vy
      inc Vk
    next
  next
  return
end sub

sub ShowTrackName:
  print at 9,7, "            "
  select case TrkSel
  case 0
    print at 9,7, "CLASSIC"
  case 1
    print at 9,7, "OVAL"
  case 2
    print at 9,7, "SWITCHBACK"
  case 3
    print at 9,7, "HAIRPINS"
  case else
    print at 9,7, "CUSTOM"
  end select
  print at 2,15, "BEST"
  NumU = Best[TrkSel]
  ShowClock(7, 15)
  return
end sub

' ---------------------------------------------------------------------------
' the editor

sub EditTrack:
  if TrkSel < NTracks then
    SetTrackAdr
    for W16 = 0 to 399
      Vb = peek(TrkAdr + W16)
      vpoke vram.name + 1024 + W16, Vb
    next
    TrkSel = NTracks
    Best[TrkSel] = 0
  end if
  HasCust = 1
  ForceTrack
  NewScreen
  LoadTiles
  print at 2,1, "EDIT TRACK"
  print at 2,22, "LEFT:ROAD/WALL RIGHT:DONE"
  EdX = 44
  EdY = 10
  ViewX = 16
  EdRep = 0
  EdT = 0
  EdDraw
  EdCursor
  ShowScreen
  Rearm
  wait no fire
  nmi off
ed_loop:
  Frame1
  ReadPad
  EdMove
  if Btn1 > 0 and WasB1 = 0 then
    EdToggle
  end if
  EdCursor
  if Btn2 = 0 or WasB2 > 0 then goto ed_loop
  HideSprites
  Rearm
  wait no fire
  nmi off
  return
end sub

' the stick moves the cursor: a step at once, then every 5 frames
sub EdMove:
  u8 St = 0
  St = Pad[0] | Pad[1]
  St = St & 15
  if St = 0 then
    EdRep = 0
    return
  end if
  if EdRep > 0 then
    dec EdRep
    return
  end if
  EdRep = 5
  if WasStick = 0 then EdRep = 12
  Va = St & 1
  if Va > 0 and EdY > 0 then dec EdY
  Va = St & 2
  if Va > 0 and EdY < 39 then inc EdY
  Va = St & 4
  if Va > 0 and EdX > 0 then dec EdX
  Va = St & 8
  if Va > 0 and EdX < 79 then inc EdX
  play sound SndTick
  Va = ViewX + 4
  if EdX < Va and ViewX > 0 then
    ViewX = ViewX - 2
    EdDraw
  end if
  Va = ViewX + 51
  if EdX > Va and ViewX < 24 then
    ViewX = ViewX + 2
    EdDraw
  end if
  return
end sub

function EdPix(u8 Px, u8 Py) as u8
  u16 Ix = 0
  u8 Sh = 0
  u8 Byt = 0
  Ix = Py * 10
  Ix = Ix + (Px >> 3)
  vpeek vram.name + 1024 + Ix into Byt
  Sh = Px & 7
  Sh = 7 - Sh
  Byt = Byt >> Sh
  return Byt & 1

' one editor tile (2 x 2 pixels) at screen Vx, Vy
sub EdTile:
  u16 Ix = 0
  u8 Sh = 0
  u8 Q = 0
  u8 Px = 0
  u8 Py = 0
  Px = Vx - 2
  Px = Px << 1
  Px = Px + ViewX
  Py = Vy - 2
  Py = Py << 1
  Ix = Py * 10
  Vb = Px >> 3
  Ix = Ix + Vb
  Sh = Px & 7
  Sh = 6 - Sh
  vpeek vram.name + 1024 + Ix into Q
  Q = Q >> Sh
  Q = Q & 3
  Vc = PairL[Q]
  Ix = Ix + 10
  vpeek vram.name + 1024 + Ix into Q
  Q = Q >> Sh
  Q = Q & 3
  Q = PairL[Q] << 2
  Vc = Vc | Q
  Vc = Vc + TQ0
  put char Vc at Vx,Vy
  return
end sub

sub EdDraw:
  for Vy = 2 to 21
    for Vx = 2 to 29
      EdTile
    next
  next
  return
end sub

sub EdToggle:
  u16 Ix = 0
  u8 Mask = 0
  Ix = EdY * 10
  Va = EdX >> 3
  Ix = Ix + Va
  Va = EdX & 7
  Mask = 128 >> Va
  vpeek vram.name + 1024 + Ix into Vb
  Vb = Vb ^ Mask
  vpoke vram.name + 1024 + Ix, Vb
  ForceTrack
  play sound SndToggle
  Vx = EdX - ViewX
  Vx = Vx >> 1
  Vx = Vx + 2
  Vy = EdY >> 1
  Vy = Vy + 2
  EdTile
  return
end sub

' the cursor: a 6 x 6 square round the pixel, white and yellow by turns
' (a change every 12 frames: under 3 Hz)
sub EdCursor:
  inc EdT
  if EdT >= 24 then EdT = 0
  Vc = 15
  if EdT >= 12 then Vc = 11
  Va = EdX - ViewX
  Sx = Va << 2
  Sx = Sx + 15
  Sy = EdY << 2
  Sy = Sy + 14
  set sprite 0 to Sy,Sx,SCursor,Vc
  Vb = EdPix(EdX, EdY)
  if Vb = 1 then
    print at 15,1, "WALL"
  else
    print at 15,1, "ROAD"
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub LoadTiles:
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  return
end sub

sub TitlePage:
  NewScreen
  LoadTiles
  ' the lettering: R A L L Y  R A C E R, 2 x 2 tiles a letter
  Vx = 5
  for Ti = 0 to 10
    Vk = TitleL[Ti]
    if Vk > 0 then
      put char Vk at Vx,2
      put char Vk + 1 at Vx + 1,2
      put char Vk + 2 at Vx,3
      put char Vk + 3 at Vx + 1,3
    end if
    Vx = Vx + 2
  next
  print at 7,5, "BY SCOTT ELDER"
  print at 2,7, "<"
  print at 29,7, ">"
  DrawMap
  ShowTrackName
  print at 9,17, "1 PLAYER"
  print at 9,18, "2 PLAYERS"
  print at 9,19, "EDIT TRACK"
  print at 9,20, "CREDITS"
  print at 3,22, "COMPUTE!'S GAZETTE 1988"
  ShowMenu
  ' the flag on the map's start line
  set sprite 2 to 64,134,SFlag,15
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TUNELEN
  TzOn = 1
  Scene = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitSt = Pad[0] | Pad[1]
  TitSt = TitSt & 15
  if TitSt > 0 and WasStick = 0 then
    Vb = TitSt & 3
    select case Vb
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 3 then inc Menu
    end select
    ShowMenu
    Vb = TitSt & 12
    Vc = NTracks - 1
    if HasCust = 1 then Vc = NTracks
    if Vb = 4 then
      if TrkSel = 0 then
        TrkSel = Vc
      else
        dec TrkSel
      end if
      NewMap
    end if
    if Vb = 8 then
      if TrkSel >= Vc then
        TrkSel = 0
      else
        inc TrkSel
      end if
      NewMap
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Scene = 0
  HideSprites
  return
end sub

sub NewMap:
  play sound SndTick
  DrawMap
  ShowTrackName
  return
end sub

data TitleL bytes
  TLr00, TLa00, TLl00, TLl00, TLy00, 0, TLr00, TLa00, TLc00, TLe00, TLr00
end data

sub ShowMenu:
  for Ti = 17 to 20
    put char 32 at 7,Ti
  next
  Va = Menu + 17
  put char 62 at 7,Va
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "RALLY RACER"
  print at 2,5, "BASED ON RALLY RACER BY"
  print at 2,6, "SCOTT ELDER, COMPUTE!'S"
  print at 2,7, "GAZETTE, NOVEMBER 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: GRAVEL ROAD"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' the race: a steady pass every PassF frames (one player 2: 30 a second;
' two players 4: 15 a second, two windows may both scroll in one pass). The NMI is off
' during a pass, so frames that begin are counted from the VDP's frame
' flag (RrStat here, and RrDraw at each row); then the waits make up the
' rest
sub Frame2:
  u8 Need = 0
  call asm RrStat
  Need = 1
  if FrmC < PassF then Need = PassF - FrmC
  Rearm
  Idle = 1
  wait
  while Need > 1
    nmi off
    nmi on
    wait
    dec Need
  end while
  Idle = 0
  nmi off
  call asm RrStat
  FrmC = 0
  inc Tick
  return
end sub

sub ReadPad:
  WasStick = Pad[0] | Pad[1]
  WasStick = WasStick & 15
  WasB1 = Btn1
  WasB2 = Btn2
  Va = 0
  if joypad(1).up then Va = Va | 1
  if joypad(1).down then Va = Va | 2
  if joypad(1).left then Va = Va | 4
  if joypad(1).right then Va = Va | 8
  if joypad(1).fire then Va = Va | 16
  Pad[0] = Va
  Va = 0
  if joypad(2).up then Va = Va | 1
  if joypad(2).down then Va = Va | 2
  if joypad(2).left then Va = Va | 4
  if joypad(2).right then Va = Va | 8
  if joypad(2).fire then Va = Va | 16
  Pad[1] = Va
  Btn1 = 0
  Btn2 = 0
  if joypad(1).button1 then Btn1 = 1
  if joypad(2).button1 then Btn1 = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Va = Pad[0] | Pad[1]
  Btn = Va & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for Ti = 0 to NSpr - 1
    set sprite Ti to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

