asm {
; RrDraw: draws one race window straight into the VDP name table (called
; with the NMI off). In (set by DrawWindow): RTrk (track address, 10 bytes
; a row, bit 7 the leftmost pixel), RCy (top map cell row, signed), RW
; (width), RDst (name-table address of the top-left), and for the columns:
; RLead trees, RNv map cells starting at sub-column RSx0 of pixel RPx0
; (RNpx pixels in all), RTrail trees. 20 rows. A track pixel is 3 x 2
; cells; tile = TileLut[34 * (sy * 4 + sx) + class], class = pixel wall,
; above, below, left, right wall (outside the track is wall), 32 / 33 the
; start/finish and half-lap pixels (x 44, rows 2-3 / 36-37). Classes are
; worked out once per pixel row (ClsBuf). Uses all registers but IX, IY.
RrDraw:
    ld a,(AMY_UVAR_RR0)
    ld (AMY_UVAR_RRow),a
    ld a,255
    ld (AMY_UVAR_RPyC),a
RrRowLp:
    ; count a frame that began (the pass is timed by FrmC)
    in a,($BF)
    rlca
    jr nc,RrNoFrm
    ld hl,AMY_UVAR_FrmC
    inc (hl)
RrNoFrm:
    ld a,(AMY_UVAR_RRow)
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_RCy)
    add hl,de
    bit 7,h
    jp nz,RrTrees
    ld a,h
    or a
    jp nz,RrTrees
    ld a,l
    cp 80
    jp nc,RrTrees
    ld c,a
    and 1
    ld (AMY_UVAR_RSy),a
    ld a,c
    srl a
    ld hl,AMY_UVAR_RPyC
    cp (hl)
    jr z,RrHaveCls
    ld (hl),a
    ld (AMY_UVAR_RPy),a
    call RrClsRow
RrHaveCls:
    call RrAddr
    ld a,(AMY_UVAR_RLead)
    call RrTreeN
    ld a,(AMY_UVAR_RNv)
    or a
    jr z,RrNoMap
    ld b,a
    ; DE = TileLut + 136 * sy + 34 * sx0
    ld a,(AMY_UVAR_RSx0)
    ld c,a
    ld l,a
    ld h,0
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de                  ; 34 * sx0
    ld de,TileLut
    add hl,de
    ld a,(AMY_UVAR_RSy)
    or a
    jr z,RrSy0
    ld de,136
    add hl,de
RrSy0:
    ex de,hl
    ld hl,AMY_UVAR_ClsBuf
RrCell:
    ld a,(hl)
    push hl
    add a,e
    ld l,a
    ld a,d
    adc a,0
    ld h,a
    ld a,(hl)
    out ($BE),a
    pop hl
    inc c
    ld a,c
    cp 3
    jr z,RrWrap
    ld a,e
    add a,34
    ld e,a
    jr nc,RrCNext
    inc d
    jr RrCNext
RrWrap:
    ld c,0
    inc hl
    ld a,e
    sub 68
    ld e,a
    jr nc,RrCNext
    dec d
RrCNext:
    djnz RrCell
RrNoMap:
    ld a,(AMY_UVAR_RTrail)
    call RrTreeN
    jr RrRowEnd
RrTrees:
    call RrAddr
    ld a,(AMY_UVAR_RW)
    call RrTreeN
RrRowEnd:
    ld hl,AMY_UVAR_RRow
    inc (hl)
    ld a,(AMY_UVAR_RREnd)
    cp (hl)
    jp nz,RrRowLp
    ret

; the VDP write address of row RRow of the window
RrAddr:
    ld a,(AMY_UVAR_RRow)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(AMY_UVAR_RDst)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ret

; RrRows: RowBuf = track rows RPy - 1, RPy, RPy + 1 (10 bytes each, wall
; outside the track), from ROM (RTrk) or, for the edited track (RVr = 1),
; from VRAM at CustV
RrRows:
    ld de,AMY_UVAR_RowBuf
    ld a,(AMY_UVAR_RPy)
    dec a
    call RrRow1
    ld a,(AMY_UVAR_RPy)
    call RrRow1
    ld a,(AMY_UVAR_RPy)
    inc a
; RrRow1: row A (255 or 40: wall) to DE, DE += 10
RrRow1:
    cp 40
    jr c,RrRowIn
    ld b,10
    ld a,255
RrRowFF:
    ld (de),a
    inc de
    djnz RrRowFF
    ret
RrRowIn:
    ld l,a
    ld h,0
    add hl,hl
    ld c,l
    ld b,h
    add hl,hl
    add hl,hl
    add hl,bc                  ; y * 10
    ld a,(AMY_UVAR_RVr)
    or a
    jr nz,RrRowV
    ld bc,(AMY_UVAR_RTrk)
    add hl,bc
    ld bc,10
    ldir
    ret
RrRowV:
    ld bc,CustV
    add hl,bc
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ld b,10
RrRowVi:
    nop
    nop
    in a,($BE)
    ld (de),a
    inc de
    djnz RrRowVi
    ret

; A trees
RrTreeN:
    or a
    ret z
    ld b,a
RrTrLp:
    ld a,TTree
    out ($BE),a
    nop
    nop
    nop
    nop
    djnz RrTrLp
    ret

; RrClsRow: classes of pixels RPx0 .. RPx0 + RNpx - 1 on pixel row RPy
RrClsRow:
    ld a,(AMY_UVAR_RNpx)
    or a
    ret z
    call RrRows
    ld hl,AMY_UVAR_RowBuf
    ld (AMY_UVAR_RRowU),hl
    ld hl,AMY_UVAR_RowBuf + 10
    ld (AMY_UVAR_RRowM),hl
    ld hl,AMY_UVAR_RowBuf + 20
    ld (AMY_UVAR_RRowD),hl
    ; the line class for this row
    ld a,(AMY_UVAR_RPy)
    ld b,32
    cp 2
    jr z,RrLine
    cp 3
    jr z,RrLine
    ld b,33
    cp 36
    jr z,RrLine
    cp 37
    jr z,RrLine
    ld b,0
RrLine:
    ld a,b
    ld (AMY_UVAR_RLine),a
    ld hl,AMY_UVAR_ClsBuf
    ld (AMY_UVAR_RCp),hl
    ; mask and byte of the first pixel
    ld a,(AMY_UVAR_RPx0)
    ld (AMY_UVAR_RPxI),a
    ld c,a
    and 7
    ld e,a
    ld d,0
    ld hl,MaskT
    add hl,de
    ld b,(hl)
    ld a,c
    srl a
    srl a
    srl a
    ld e,a
    ; meC
    ld hl,(AMY_UVAR_RRowM)
    add hl,de
    ld a,(hl)
    and b
    call RrOne
    ld (AMY_UVAR_RMeC),a
    ; meL: the pixel before (none: wall)
    ld a,1
    ld (AMY_UVAR_RMeL),a
    ld a,c
    or a
    jr z,RrClsLp
    push de
    ld a,b
    rlca
    ld c,a
    jr nc,RrMeL1
    dec e
RrMeL1:
    ld hl,(AMY_UVAR_RRowM)
    add hl,de
    ld a,(hl)
    and c
    call RrOne
    ld (AMY_UVAR_RMeL),a
    pop de
RrClsLp:
    ; meR (pixel 79: the edge is wall)
    ld a,(AMY_UVAR_RPxI)
    cp 79
    ld a,1
    jr z,RrMeR
    push de
    ld a,b
    rrca
    ld c,a
    jr nc,RrMeR1
    inc e
RrMeR1:
    ld hl,(AMY_UVAR_RRowM)
    add hl,de
    ld a,(hl)
    and c
    call RrOne
    pop de
RrMeR:
    ld (AMY_UVAR_RMeR),a
    ; class = meC N S meL meR
    ld a,(AMY_UVAR_RMeC)
    add a,a
    ld c,a
    ld hl,(AMY_UVAR_RRowU)
    add hl,de
    ld a,(hl)
    and b
    call RrOne
    or c
    add a,a
    ld c,a
    ld hl,(AMY_UVAR_RRowD)
    add hl,de
    ld a,(hl)
    and b
    call RrOne
    or c
    add a,a
    ld c,a
    ld a,(AMY_UVAR_RMeL)
    or c
    add a,a
    ld c,a
    ld a,(AMY_UVAR_RMeR)
    or c
    ld c,a
    ; the line pixel (x 44, road)
    ld a,(AMY_UVAR_RPxI)
    cp 44
    jr nz,RrStore
    ld a,(AMY_UVAR_RLine)
    or a
    jr z,RrStore
    ld a,(AMY_UVAR_RMeC)
    or a
    jr nz,RrStore
    ld a,(AMY_UVAR_RLine)
    ld c,a
RrStore:
    ld hl,(AMY_UVAR_RCp)
    ld (hl),c
    inc hl
    ld (AMY_UVAR_RCp),hl
    ld a,(AMY_UVAR_RMeC)
    ld (AMY_UVAR_RMeL),a
    ld a,(AMY_UVAR_RMeR)
    ld (AMY_UVAR_RMeC),a
    ld hl,AMY_UVAR_RPxI
    inc (hl)
    rrc b
    jr nc,RrNoByte
    inc e
RrNoByte:
    ; done when RCp reaches ClsBuf + RNpx
    ld hl,AMY_UVAR_ClsBuf
    ld a,(AMY_UVAR_RNpx)
    add a,l
    ld l,a
    ld a,h
    adc a,0
    ld h,a
    ld a,(AMY_UVAR_RCp)
    cp l
    jp nz,RrClsLp
    ret

; A (flags from AND) -> 0 / 1
RrOne:
    ret z
    ld a,1
    ret

; RrBit: HL = row, A = x (-1..80). A = 1 wall, 0 road.
RrBit:
    cp 80
    jr nc,RrBitW
    ld c,a
    srl a
    srl a
    srl a
    ld e,a
    ld d,0
    add hl,de
    ld a,c
    and 7
    inc a
    ld b,a
    ld a,(hl)
RrBitSh:
    rla
    djnz RrBitSh
    ld a,0
    rla
    ret
RrBitW:
    ld a,1
    ret

; RrWall: is map pixel (QX, QY) out of bounds? QW = 1 wall, 0 road.
; QX, QY are signed pixel coordinates (8 per cell).
RrWall:
    ld hl,(AMY_UVAR_QY)
    bit 7,h
    jr nz,RrWallY
    ; cy = QY / 8 must be < 80; py = cy / 2 = QY / 16
    ld a,l
    srl h
    rra
    srl h
    rra
    srl h
    rra
    srl h
    rra
    ld c,a
    ld a,h
    or a
    jr nz,RrWallY
    ld a,c
    cp 40
    jr nc,RrWallY
    ; the row into RowBuf
    ld (AMY_UVAR_RTmp),a
    ld de,AMY_UVAR_RowBuf
    call RrRow1
    ld hl,AMY_UVAR_RowBuf
    push hl
    ld hl,(AMY_UVAR_QX)
    bit 7,h
    jr nz,RrWallX
    ld a,l
    srl h
    rra
    srl h
    rra
    srl h
    rra
    ld e,a
    ld a,h
    or a
    jr nz,RrWallX
    ld a,e
    cp 240
    jr nc,RrWallX
    ld d,0
    ld hl,Div3
    add hl,de
    ld a,(hl)
    pop hl
    call RrBit
    ld (AMY_UVAR_QW),a
    ret
RrWallX:
    pop hl
RrWallY:
    ld a,1
    ld (AMY_UVAR_QW),a
    ret

; RrR3: VDP register 3 = $FF, so each screen third has its own colours
; (tile screen shares one table; the title map needs its own)
RrR3:
    ld bc,$03FF
    jp WRITE_REGISTER

; RrStat: VStat = the VDP status port (reading it clears the frame flag)
RrStat:
    in a,($BF)
    rlca
    ret nc
    ld hl,AMY_UVAR_FrmC
    inc (hl)
    ret

; RrScroll: moves a window's 18 x RW cells by one cell inside the name
; table (VRAM to VRAM through ClsBuf), in one sweep. ShDx 1: the view moved
; right (cells go left), 2: left; ShDy 1: the view moved down (rows go
; up), 2: up. The freed column / row is drawn afterwards by RrDraw.
RrScroll:
    ; bytes a row: RW, one less when moving sideways
    ld a,(AMY_UVAR_RW)
    ld c,a
    ld a,(AMY_UVAR_ShDx)
    or a
    jr z,RrScN
    dec c
RrScN:
    ld a,c
    ld (AMY_UVAR_ShN),a
    ; source and destination of the first row copied; step between rows
    ld hl,(AMY_UVAR_RDst)          ; source
    ld d,h
    ld e,l                         ; destination
    ld a,(AMY_UVAR_ShDx)
    cp 1
    jr nz,RrScX2
    inc hl                         ; read col 1, write col 0
    jr RrScX0
RrScX2:
    cp 2
    jr nz,RrScX0
    inc de                         ; read col 0, write col 1
RrScX0:
    ld b,18
    ld a,(AMY_UVAR_ShDy)
    or a
    jr z,RrScDown                  ; same rows, top to bottom
    ld b,17
    cp 1
    jr nz,RrScUp
    ld a,32
    add a,l                        ; source one row lower
    ld l,a
    jr nc,RrScDown
    inc h
RrScDown:
    push bc
    push hl
    push de
    call RrRowCopy
    pop de
    pop hl
    ld bc,32
    add hl,bc
    ex de,hl
    add hl,bc
    ex de,hl
    pop bc
    djnz RrScDown
    ret
RrScUp:
    ; rows go down: from the bottom, destination row r = source row r - 1
    push bc
    ld bc,17 * 32
    ex de,hl
    add hl,bc
    ex de,hl                       ; destination row 17
    ld bc,16 * 32
    add hl,bc                      ; source row 16
    pop bc
RrScUpLp:
    push bc
    push hl
    push de
    call RrRowCopy
    pop de
    pop hl
    ld bc,-32
    add hl,bc
    ex de,hl
    add hl,bc
    ex de,hl
    pop bc
    djnz RrScUpLp
    ret

; RrRowCopy: ShN bytes of VRAM from HL to DE (through RBuf)
RrRowCopy:
    in a,($BF)                 ; count a frame that began
    rlca
    jr nc,RrRcNo
    push hl
    ld hl,AMY_UVAR_FrmC
    inc (hl)
    pop hl
RrRcNo:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    ld a,(AMY_UVAR_ShN)
    ld b,a
    ld hl,AMY_UVAR_ClsBuf
RrRcIn:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz RrRcIn
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_ShN)
    ld b,a
    ld hl,AMY_UVAR_ClsBuf
RrRcOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz RrRcOut
    ret
RrShift:
    db $40,$FC,$21,$02,$40,$53,$31,$03,$50
RrShift2:
    db $40,$C5,$21,$02,$40,$2E,$31,$03,$50
RrCrash:
    db $00,$00,$04,$03,$00,$00,$15,$04,$00,$00,$36,$06,$00,$00,$56,$0A,$10
RrHalf:
    db $40,$7F,$10,$05,$40,$5F,$10,$05,$40,$40,$20,$0A,$50
RrBeep:
    db $40,$FE,$10,$0A,$40,$FE,$50,$04,$50
RrGo:
    db $40,$7F,$10,$18,$40,$7F,$40,$08,$50
RrWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$20,$06,$40,$6B,$10,$1E
    db $50
RrOver:
    db $40,$1D,$11,$0C,$40,$53,$21,$0C,$40,$AB,$21,$1E,$50
RrTick:
    db $40,$47,$40,$02,$50
RrToggle:
    db $40,$AA,$20,$03,$40,$71,$30,$03,$50

RrSoundTable:
    dw RrTuneMel,$702B
    dw RrTuneBass,$7035
    dw RrShift,$7049
    dw RrShift2,$7049
    dw RrCrash,$703F
    dw RrHalf,$7049
    dw RrBeep,$7049
    dw RrGo,$7049
    dw RrWin,$7049
    dw RrOver,$7049
    dw RrTick,$7049
    dw RrToggle,$7049
; Gravel Road (original)
; Tiny Sound, 7 frames per step
RrTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$21,$01,$25,$28,$01,$25,$23,$21,$1E,$01,$21,$01
    db $23,$01,$01,$01,$25,$01,$28,$2A,$01,$28,$25,$23,$21,$01,$23,$25
    db $23,$01,$01,$01,$26,$01,$25,$23,$01,$21,$1E,$01,$1C,$01,$1E,$21
    db $23,$01,$25,$01,$28,$01,$26,$25,$23,$01,$21,$23,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
RrTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$09,$01,$10,$01,$09,$01,$10,$01,$04,$01,$0B,$01
    db $04,$01,$08,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$0B,$01,$12,$01,$04,$01,$08,$01,$09,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
