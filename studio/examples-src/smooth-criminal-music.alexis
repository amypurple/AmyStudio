project "Smooth Criminal Music"
cartridge "SMOOTH CRIMINAL/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' Amy port of old-projects-sdcc-z80/sdcctest/smoothc.
' Music/equalizer demo using the original Smooth Criminal BIOS sound table.
' Graphics are separate ZX0 project files so the Files preview can show them.

asset SmoothCName from "@project/smoothc.name.zx0" codec zx0
asset SmoothCPattern from "@project/smoothc.pattern.zx0" codec zx0
asset SmoothCSpritePattern from "@project/smoothc.sprpat.zx0" codec zx0
asset SmoothCColorFull from "@project/smoothc.color.zx0" codec zx0

u16 MusicTimer = 0
u8 MusicActive = 0

on vblank SmoothCVblank

sub start:
  screen off
  tile screen
  sprites 16x16
  sprites simple
  set sound table SmoothCriminalSoundTable areas 4
  decompress SmoothCPattern to vram.pattern
  duplicate mode 2 text patterns
  decompress SmoothCName to vram.name
  decompress SmoothCColorFull to vram.color
  decompress SmoothCSpritePattern to vram.spr_pat
  set sprite pattern table vram.spr_pat
  clear sprites
  set sprite count 4
  update sprites from 0 count 4
  MusicTimer = 0
  MusicActive = 1
  screen on
main_loop:
  wait
  goto main_loop

sub SmoothCVblank:
  if MusicActive = 0 then return
  SmoothCUpdateEqualizer
  if MusicTimer = 4800 then MusicTimer = 0
  select case MusicTimer
  case 0
    mute all
    play sound 1
    play sound 2
    play sound 4
  case 960
    play sound 3
  case 1920, 3840
    play sound 5
    play sound 8
    play sound 11
    play sound 15
  case 2160, 4080
    play sound 12
  case 2640
    play sound 6
    play sound 9
    play sound 13
    play sound 16
  case 2880
    mute all
    play sound 20
    play sound 2
    play sound 18
    play sound 19
  case 4560
    mute all
    play sound 7
    play sound 10
    play sound 14
    play sound 17
  end select
  MusicTimer += 1
  return

sub SmoothCUpdateEqualizer:
  asm {
SmoothC_Update_Equalizer:
    ld hl,AMY_SPRITE_TABLE
    ld de,$7035
    ld b,3
    ld c,80
SmoothC_Equalizer_Loop:
    ld (hl),159
    inc hl
    ld (hl),c
    inc hl
    ld a,(de)
    cp $FF
    ld a,60
    jr z,SmoothC_Equalizer_Pattern_Ready
    push de
    inc de
    inc de
    inc de
    inc de
    ld a,(de)
    pop de
    srl a
    srl a
SmoothC_Equalizer_Pattern_Ready:
    ld (hl),a
    inc hl
    ld (hl),6
    inc hl
    ld a,c
    add a,32
    ld c,a
    ld a,e
    add a,10
    ld e,a
    jr nc,SmoothC_Equalizer_Next
    inc d
SmoothC_Equalizer_Next:
    djnz SmoothC_Equalizer_Loop
    ld (hl),$D0
    inc hl
    xor a
    ld (hl),a
    inc hl
    ld (hl),60
    inc hl
    xor a
    ld (hl),a
    ld hl,AMY_SPRITE_TABLE
    ld de,$1B00
    ld a,4
    call AMY_UPDATE_SPRITES_PARTIAL
  }
  return


