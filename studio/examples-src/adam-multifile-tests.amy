' Small executable assertions kept inside the example project.
u8 LabTestsPassed = 0
u8 LabTestValue = 0

sub Lab_RunSelfTests:
  LabTestsPassed = 0

  LabTestValue = 3
  LabTestValue += 4
  if LabTestValue = 7 then LabTestsPassed += 1

  LabTestValue -= 2
  if LabTestValue = 5 then LabTestsPassed += 1

  LabTestValue = LabTestValue << 1
  if LabTestValue = 10 then LabTestsPassed += 1

  LabTestValue = LabTestValue & 3
  if LabTestValue = 2 then LabTestsPassed += 1
  return
end sub
