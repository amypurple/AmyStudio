asset SubscribersNetsoftwarePatternA from "@project/netsoftware.pattern-a.lzf" codec lzf
asset SubscribersNetsoftwarePatternB from "@project/netsoftware.pattern-b.lzf" codec lzf
asset SubscribersNickpj9695Color from "@project/nickpj9695.color.lzf" codec lzf
asset SubscribersNickpj9695PatternA from "@project/nickpj9695.pattern-a.lzf" codec lzf
asset SubscribersNickpj9695PatternB from "@project/nickpj9695.pattern-b.lzf" codec lzf
const IconPatternOffset = 1024
const IconColorOffset = 1024
const IconColorBytes = 384
const IconFirstThirdBytes = 64
const IconRemainingBytes = 320
const IconSecondThirdOffset = 3136
const IconX = 12
const IconY = 7

u16 MusicTimer = 0
u8 MusicActive = 0
u8 IconLoadBusy = 0
u8 SubscriberIndex = 0
u8 IconTile = 0
u8 IconRow = 0
u8 IconCol = 0
u8 DrawX = 0
u8 DrawY = 0

on vblank SubscribersVblank

data IconTilesRow0 bytes = 128,129,130,131,132,133,134,135
data IconTilesRow1 bytes = 136,137,138,139,140,141,142,143
data IconTilesRow2 bytes = 144,145,146,147,148,149,150,151
data IconTilesRow3 bytes = 152,153,154,155,156,157,158,159
data IconTilesRow4 bytes = 160,161,162,163,164,165,166,167
data IconTilesRow5 bytes = 168,169,170,171,172,173,174,175
sub start:
  screen off
  tile screen
  sprites 8x8
  sprites simple
  set sound table SubscribersSoundTable areas 4
  decompress lzf SubscribersPattern to vram.pattern
  duplicate mode 2 text patterns
  decompress lzf SubscribersName to vram.name
  decompress lzf SubscribersColorFull to vram.color
  decompress lzf SubscribersSpritePattern to vram.spr_pat
  set sprite pattern table vram.spr_pat
  clear sprites
  set sprite count 4
  update sprites from 0 count 4
  MusicTimer = 0
  MusicActive = 1
  screen on
main_loop:
  SubscribersShowCurrent
  wait 120 frames
  SubscribersClearCurrent
  SubscriberIndex += 1
  if SubscriberIndex = 101 then SubscriberIndex = 0
  goto main_loop

sub SubscribersShowCurrent:
  wait
  asm {
    call Subscribers_Show_Current_Compact
  }
  return
sub SubscribersClearCurrent:
  fill $20 count 26 at 3,16
  wait
  fill $20 count 8 to vram.name + $00EC
  wait
  fill $20 count 8 to vram.name + $010C
  wait
  fill $20 count 8 to vram.name + $012C
  wait
  fill $20 count 8 to vram.name + $014C
  wait
  fill $20 count 8 to vram.name + $016C
  wait
  fill $20 count 8 to vram.name + $018C
  return

sub SubscribersVblank:
  if MusicActive = 0 then return
  if MusicTimer = 2560 then MusicTimer = 0
  select case MusicTimer
  case 0
    mute all
    play sound 1
    play sound 2
  case 512
    play sound 3
    play sound 4
  end select
  MusicTimer += 1
  if IconLoadBusy = 0 then SubscribersUpdateEqualizer
  return

sub SubscribersUpdateEqualizer:
  asm {
Subscribers_Update_Equalizer:
    ld hl,AMY_SPRITE_TABLE
    ld de,$7035
    ld b,3
    ld c,20
Subscribers_Equalizer_Loop:
    ld (hl),175
    inc hl
    ld (hl),c
    inc hl
    ld a,(de)
    cp $FF
    ld a,60
    jr z,Subscribers_Equalizer_Pattern_Ready
    push de
    inc de
    inc de
    inc de
    inc de
    ld a,(de)
    pop de
    srl a
    srl a
Subscribers_Equalizer_Pattern_Ready:
    ld (hl),a
    inc hl
    ld (hl),6
    inc hl
    ld a,c
    add a,16
    ld c,a
    ld a,e
    add a,10
    ld e,a
    jr nc,Subscribers_Equalizer_Next
    inc d
Subscribers_Equalizer_Next:
    djnz Subscribers_Equalizer_Loop
    ld (hl),$D0
    inc hl
    xor a
    ld (hl),a
    inc hl
    ld (hl),60
    inc hl
    xor a
    ld (hl),a
    ld hl,AMY_SPRITE_TABLE
    ld de,$1B00
    ld a,4
    call AMY_UPDATE_SPRITES_PARTIAL
  }
  return

end sub

asm {
; HL = color LZF asset, DE = first-third pattern LZF asset,
; BC = second-third pattern LZF asset.
; The icon pattern spans the Mode 2 boundary, so it is stored as two faster LZF chunks.
; IconLoadBusy blocks only the equalizer VDP writes while the music scheduler keeps ticking.
; Compact subscriber table renderer. Keeps the 101 original entries out of structured Amy code.
Subscribers_Show_Current_Compact:
    ld a,(AMY_UVAR_SubscriberIndex)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,a
    ld d,0
    add hl,de
    ld de,Subscribers_Entry_Table
    add hl,de

    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                 ; color asset
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                 ; pattern first third asset
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                 ; pattern second third asset
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de                 ; text pointer
    ld a,(hl)
    ld (AMY_UVAR_DrawX),a   ; total text length

    pop ix                  ; IX = text pointer, kept for reveal animation
    pop bc                  ; BC = pattern second-third asset
    pop de                  ; DE = pattern first-third asset
    pop hl                  ; HL = color asset
    push ix
    call Subscribers_Load_Icon_Data
    ld hl,1
    call AMY_WAIT_FRAMES_SAFE
    pop ix
    jp Subscribers_Reveal_Icon_And_Text

Subscribers_Reveal_Icon_And_Text:
    xor a
    ld (AMY_UVAR_DrawY),a   ; visible text length
    ld (AMY_UVAR_IconRow),a ; next icon row
Subscribers_Reveal_Loop:
    ld a,(AMY_UVAR_DrawY)
    ld b,a
    ld a,(AMY_UVAR_DrawX)
    cp b
    jr z,Subscribers_Reveal_Text_Ready
    ld a,b
    inc a
    ld b,a
    ld a,(AMY_UVAR_DrawX)
    cp b
    jr z,Subscribers_Reveal_Store_Text
    inc b
Subscribers_Reveal_Store_Text:
    ld a,b
    ld (AMY_UVAR_DrawY),a
Subscribers_Reveal_Text_Ready:
    ld hl,1
    call AMY_WAIT_FRAMES_SAFE

    ld a,(AMY_UVAR_IconRow)
    cp 6
    jr nc,Subscribers_Reveal_No_Icon_Row
    push af
    call Subscribers_Draw_Icon_Row_ASM
    pop af
    inc a
    ld (AMY_UVAR_IconRow),a
Subscribers_Reveal_No_Icon_Row:
    ld hl,1
    call AMY_WAIT_FRAMES_SAFE

    ld a,(AMY_UVAR_DrawY)
    or a
    jr z,Subscribers_Reveal_Check_Done
    ld c,a
    ld b,0
    inc a
    srl a                   ; ceil(visible / 2)
    ld e,a
    ld d,0
    ld hl,VRAM_NAME+$0210
    or a
    sbc hl,de
    ex de,hl
    push ix
    pop hl
    call WRITE_VRAM

Subscribers_Reveal_Check_Done:
    ld a,(AMY_UVAR_IconRow)
    cp 6
    jr c,Subscribers_Reveal_Loop
    ld a,(AMY_UVAR_DrawY)
    ld b,a
    ld a,(AMY_UVAR_DrawX)
    cp b
    jr nz,Subscribers_Reveal_Loop
    ret

Subscribers_Draw_Icon_Row_ASM:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld de,Subscribers_Icon_Row_Table
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push de
    ld e,(hl)
    inc hl
    ld d,(hl)
    pop hl
    ld bc,8
    jp WRITE_VRAM

Subscribers_Icon_Row_Table:
    dw AMY_UDATA_IconTilesRow0,VRAM_NAME+$00EC
    dw AMY_UDATA_IconTilesRow1,VRAM_NAME+$010C
    dw AMY_UDATA_IconTilesRow2,VRAM_NAME+$012C
    dw AMY_UDATA_IconTilesRow3,VRAM_NAME+$014C
    dw AMY_UDATA_IconTilesRow4,VRAM_NAME+$016C
    dw AMY_UDATA_IconTilesRow5,VRAM_NAME+$018C
