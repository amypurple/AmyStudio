Subscribers_Load_Icon_Data:
    ld a,1
    ld (AMY_UVAR_IconLoadBusy),a
    ld a,$A5
    ld ($701F),a
    push bc
    push de
    ld de,VRAM_COLOR + AMY_UCONST_IconColorOffset
    call lzf_decompress
    pop hl
    ld de,VRAM_PATTERN + AMY_UCONST_IconPatternOffset
    call lzf_decompress
    pop hl
    ld de,VRAM_PATTERN + AMY_UCONST_IconSecondThirdOffset
    call lzf_decompress
    xor a
    ld ($701F),a
    ld (AMY_UVAR_IconLoadBusy),a
    ret
}

