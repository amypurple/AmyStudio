project "Amy Min Max Expression Test"

u8 SmallByte = 3
u8 BigByte = 9
u8 ByteResult = 0
u16 SmallWord = 100
u16 BigWord = 300
u16 WordResult = 0

text screen
print at 5,0, "MIN MAX EXPRESSIONS"

ByteResult = min(SmallByte, BigByte)
print at 1,3, "u8 min"
print ByteResult at 12,3 digits 3

ByteResult = max(SmallByte, BigByte)
print at 1,5, "u8 max"
print ByteResult at 12,5 digits 3

WordResult = min(SmallWord, BigWord)
print at 1,8, "u16 min"
print WordResult at 12,8 digits 5

WordResult = max(SmallWord, BigWord)
print at 1,10, "u16 max"
print WordResult at 12,10 digits 5

screen on