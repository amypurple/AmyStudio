    jr z,WfDB5
    ld a,(hl)
    push hl
    ld c,a
    srl a
    or c
    ld l,a                      ; l = the mask
    ld a,e
    rrca
    sbc a,a
    and l
    xor c
    ld c,a                      ; c = this row's value
