' the first sprite pattern of each thing (by kind 1-6), then + size * 4
data KindPat bytes 0, 0, 0, 0, 16, 32, 48
' the things' colours
data KindCol bytes 0, 10, 10, 10, 11, 9, 13

  bitmap screen
  set sound table MmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  asm {
    call GmClear
  }
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    HowToPage
    goto title
  end if
  if Sel = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  Busy = 1
  ReadPad
  if Lf1 = 1 then Ang = Ang - 7
  if Rt1 = 1 then Ang = Ang + 7
  MvSp = 0
  if Up1 = 1 then
    MvDir = 0
    MvSp = 60
  end if
  if Dn1 = 1 then
    MvDir = 1
    MvSp = 40
  end if
  if MvSp > 0 then
    asm {
      call WfMove
    }
    if MvHit = 6 then
      ChangeFloor
      goto play_loop
    end if
  end if
  asm {
    call GmTrig
  }
  if Press = 1 then UseButton
  Lantern
  ' the view again only when something in it changed
  if PX <> LastX then Dirty = 1
  if PY <> LastY then Dirty = 1
  if Ang <> LastA then Dirty = 1
  if DarkH <> LastD then Dirty = 1
  if Dirty = 1 then
    Dirty = 0
    LastX = PX
    LastY = PY
    LastA = Ang
    LastD = DarkH
    asm {
      call WfCast
      call WfRender
    }
  end if
  Things
  GhostMove
  ShowThings
  if NewsT > 0 then
    dec NewsT
    if NewsT = 0 then
      WtRow = 21
      asm {
        call GmClearRow
      }
    end if
  end if
  if HudOn = 1 then
    HudOn = 0
    Hud
  end if
  Busy = 0
  if Placed >= 3 then goto game_won
  if Lost > 0 then goto game_lost
  goto play_loop

game_won:
  HideSprites
  News(TWon, LWon)
  play song MmSong once
  Hold(250)
  EndPage
  goto title

game_lost:
  HideSprites
  play sound SndLose
  if Lost = 1 then News(TOut, LOut)
  if Lost = 2 then News(TScared, LScared)
  Hold(180)
  EndPage
  goto title

' ---------------------------------------------------------------------------
' the house

sub NewGame:
  Flr = 0
  Opened = 0
  Taken = 0
  HasKey = 0
  Carry = 0
  Placed = 0
  Oil = 100
  OilF = 0
  Frights = 0
  FlareT = 0
  GX = GhostX
  GY = GhostY
  GF = GhostF
  GRun = 0
  GWait = 0
  Lost = 0
  NewsT = 0
  HideSprites
  asm {
    call GmClear
  }
  LoadFloor
  W16 = StartX * 256
  PX = W16 + 128
  W16 = StartY * 256
  PY = W16 + 128
  Ang = 0
  Hud
  WaitStick
  return
end sub

' LoadFloor: the floor's map, with the doors already opened left open
sub LoadFloor:
  Dirty = 1
  W16 = Flr * 256
  for I = 0 to 255
    Map[I] = Floors[W16]
    inc W16
  next
  W2 = 1
  for I = 0 to NDoor - 1
    if DoorF[I] = Flr then
      W16 = Opened & W2
      if W16 <> 0 then
        V = DoorC[I]
        Map[V] = 0
      end if
    end if
    W2 = W2 << 1
  next
  return
end sub

' ChangeFloor: up or down the stairs; you arrive below them, facing away
sub ChangeFloor:
  Flr = Flr ^ 1
  play sound SndStairs
  HideSprites
  LoadFloor
  W16 = StairC + 16
  V = lowbyte W16
  V2 = V & 15
  W16 = V2 * 256
  PX = W16 + 128
  V2 = V >> 4
  W16 = V2 * 256
  PY = W16 + 128
  Ang = 64
  if Flr = 1 then
    News(TUp, LUp)
  else
    News(TDown, LDown)
  end if
  ' the ghost is slow to follow
  GWait = 60
  return
end sub

' UseButton: a door in front opens; anything else: the lantern flashes
sub UseButton:
  ' the cell a cell ahead
  S16 = CosA * 16
  S16 = S16 / 64
  W16 = PX >> 4
  Dx = W16
  Dx = Dx + S16
  S16 = SinA * 16
  S16 = S16 / 64
  W16 = PY >> 4
  Dy = W16
  Dy = Dy + S16
  W16 = Dx
  X = lowbyte W16
  X = X >> 4
  W16 = Dy
  Y = lowbyte W16
  Y = Y >> 4
  V = Y * 16
  V = V + X
  K = Map[V]
  if K = 4 then
    OpenDoor
    return
  end if
  if K = 5 then
    if HasKey = 1 then
      OpenDoor
    else
      play sound SndClunk
      News(TLocked, LLocked)
    end if
    return
  end if
  ' the flash
  if Oil < 8 then return
  Oil = Oil - 6
  FlareT = 3
  HudOn = 1
  play sound SndFlare
  ' a ghost near enough flees
  if GF = Flr then
    GhostDist
    if N < 64 then
      GRun = 50
      play sound SndWail
    end if
  end if
  return
end sub

' OpenDoor: the door at cell V opens, and stays open
sub OpenDoor:
  Map[V] = 0
  Dirty = 1
  play sound SndCreak
  W2 = 1
  for I = 0 to NDoor - 1
    if DoorF[I] = Flr then
      if DoorC[I] = V then Opened = Opened | W2
    end if
    W2 = W2 << 1
  next
  return
end sub

' Lantern: the oil burns down; the light reaches less far as it does
sub Lantern:
  inc OilF
  if OilF >= 20 then
    OilF = 0
    if Oil > 0 then dec Oil
    HudOn = 1
    if Oil = 0 then Lost = 1
  end if
  DarkH = 10
  if Oil < 60 then DarkH = 14
  if Oil < 35 then DarkH = 20
  if Oil < 15 then DarkH = 30
  if FlareT > 0 then
    dec FlareT
    DarkH = 4
  end if
  DimH = DarkH + 16
  return
end sub

' Things: pick up what you walk into
sub Things:
  W2 = 1
  for I = 0 to NObj - 1
    W16 = Taken & W2
    if W16 = 0 then
      if ObF[I] = Flr then
        ObjDist
        if N < 10 then Touch
      end if
    end if
    W2 = W2 << 1
  next
  return
end sub

' ObjDist: how far thing I is (the larger of across and down, sixteenths
' of a cell): N (255 when far)
sub ObjDist:
  W16 = PX >> 4
  Dx = W16
  V = ObX[I]
  S16 = V
  Dx = S16 - Dx
  W16 = PY >> 4
  Dy = W16
  V = ObY[I]
  S16 = V
  Dy = S16 - Dy
  Measure
  return
end sub

' Measure: N = the larger of |Dx| and |Dy| (at most 255)
sub Measure:
  if Dx < 0 then Dx = 0 - Dx
  if Dy < 0 then Dy = 0 - Dy
  if Dy > Dx then Dx = Dy
  N = 255
  if Dx < 255 then
    W16 = Dx
    N = lowbyte W16
  end if
  return
end sub

sub Touch:
  K = ObK[I]
  if K <= 3 then
    if Carry > 0 then
      if NewsT = 0 then News(TFull, LFull)
      return
    end if
    Carry = K
    Taken = Taken | W2
    play sound SndPick
    News(TGotPiece, LGotPiece)
    HudOn = 1
    return
  end if
  if K = 4 then
    HasKey = 1
    Taken = Taken | W2
    play sound SndPick
    News(TGotKey, LGotKey)
    HudOn = 1
    return
  end if
  if K = 5 then
    Oil = Oil + 40
    if Oil > 100 then Oil = 100
    Taken = Taken | W2
    play sound SndPick
    News(TGotOil, LGotOil)
    HudOn = 1
    return
  end if
  ' the music box's stand
  if Carry > 0 then
    Carry = 0
    inc Placed
    play sound SndFit
    News(TPlaced, LPlaced)
    HudOn = 1
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the ghost

' GhostDist: N = how far the ghost is (sixteenths of a cell)
sub GhostDist:
  W16 = PX >> 4
  Dx = W16
  W16 = GX
  S16 = W16
  Dx = S16 - Dx
  W16 = PY >> 4
  Dy = W16
  W16 = GY
  S16 = W16
  Dy = S16 - Dy
  Measure
  return
end sub

sub GhostMove:
  if GF <> Flr then
    ' it follows you to this floor after a while, at the far end
    if GWait > 0 then
      dec GWait
      return
    end if
    GF = Flr
    GX = 248 - GX
    GY = 40
    return
  end if
  if GWait > 0 then
    dec GWait
    return
  end if
  ' towards you (away while frightened), through walls: a little faster
  ' with each piece put back
  V = Placed + 1
  if GRun > 0 then
    dec GRun
    V = 5
  end if
  W16 = PX >> 4
  if GRun = 0 then
    if GX < W16 then GX = GX + V
    if GX > W16 then GX = GX - V
  else
    if GX < W16 then
      if GX > 20 then GX = GX - V
    else
      if GX < 236 then GX = GX + V
    end if
  end if
  W16 = PY >> 4
  if GRun = 0 then
    if GY < W16 then GY = GY + V
    if GY > W16 then GY = GY - V
  else
    if GY < W16 then
      if GY > 20 then GY = GY - V
    else
      if GY < 236 then GY = GY + V
    end if
  end if
  if GRun > 0 then return
  GhostDist
  if N >= 7 then return
  ' it touches you
  inc Frights
  play sound SndWail
  News(TBoo, LBoo)
  if Carry > 0 then
    ' the piece goes back where it was found
    W2 = 1
    for I = 0 to NObj - 1
      if ObK[I] = Carry then W16 = $FFFF - W2
      Taken = Taken & W16
      W2 = W2 << 1
    next
    Carry = 0
    News(TDropped, LDropped)
  end if
  GRun = 60
  HudOn = 1
  if Frights >= 3 then Lost = 2
  return
end sub

' ---------------------------------------------------------------------------
' the things as sprites: each at its distance, hidden by nearer walls

sub ShowThings:
  Spr = 0
  W2 = 1
  for I = 0 to NObj - 1
    W16 = Taken & W2
    if W16 = 0 then
      if ObF[I] = Flr then
        PjX = ObX[I]
        PjY = ObY[I]
        K = ObK[I]
        Project
        if Dep > 0 then ThingSprite
      end if
    end if
    W2 = W2 << 1
  next
  ' the ghost
  if GF = Flr then
    PjX = lowbyte GX
    PjY = lowbyte GY
    Project
    if Dep > 0 then GhostSprite
  end if
  while Spr < 12
    set sprite Spr to 192,0,0,0
    inc Spr
  end while
  update sprites
  return
end sub

' Project: PjX, PjY seen from you (game.asm): Dep (0: not seen), X, Hh
sub Project:
  asm {
    call GmProject
  }
  X = PjSX
  return
end sub

' ThingSprite: thing K at X, standing on the floor, sized by Hh (hidden in
' the dark beyond the lantern)
sub ThingSprite:
  if Hh < DarkH then return
  if Spr >= 8 then return
  Pat = KindPat[K]
  V = 0
  if Hh < 64 then V = 1
  if Hh < 40 then V = 2
  if Hh < 20 then V = 3
  V = V * 4
  Pat = Pat + V
  Col = KindCol[K]
  ' its foot on the floor line: view row 48 + Hh / 2
  V = Hh >> 1
  Y = V + 47
  if Y > 95 then Y = 95
  Y = Y + 16
  Y = Y - 16
  X = X - 8
  set sprite Spr to Y,X,Pat,Col
  inc Spr
  return
end sub

' GhostSprite: the ghost floats at eye height; near, it is four sprites
sub GhostSprite:
  ' it shimmers (white, grey, pale cyan), sways between two frames and
  ' bobs a little
  Col = 15
  V = Tick & 12
  if V = 4 then Col = 14
  if V = 12 then Col = 7
  V = Tick >> 3
  V = V & 1
  Big = Tick >> 4
  Big = Big & 1
  if Hh >= 60 then
    if Spr > 8 then return
    Pat = V * 16
    Pat = Pat + SGq0f0
    Y = 46 + Big
    X = X - 16
    set sprite Spr to Y,X,Pat,Col
    inc Spr
    X = X + 16
    Pat = Pat + 4
    set sprite Spr to Y,X,Pat,Col
    inc Spr
    Y = Y + 16
    X = X - 16
    Pat = Pat + 4
    set sprite Spr to Y,X,Pat,Col
    inc Spr
    X = X + 16
    Pat = Pat + 4
    set sprite Spr to Y,X,Pat,Col
    inc Spr
    return
  end if
  if Spr > 11 then return
  Pat = V * 12
  Pat = Pat + SGh0f0
  if Hh < 32 then Pat = Pat + 4
  if Hh < 16 then Pat = Pat + 4
  Y = 55 + Big
  X = X - 8
  set sprite Spr to Y,X,Pat,Col
  inc Spr
  return
end sub

' ---------------------------------------------------------------------------
' words in the bitmap (font.py's letters, text.asm)

sub Say(u16 At, u8 Len, u8 Cl, u8 Rw):
  WtRow = Rw
  WtCol = Cl
  for J = 1 to Len
    WtC = Txt[At]
    asm {
      call WtChar
    }
    inc At
    inc WtCol
  next
  return
end sub

sub Num(u8 Val, u8 Cl, u8 Rw):
  WtRow = Rw
  WtCol = Cl
  V = Val / 100
  WtC = V + 48
  if V = 0 then WtC = 32
  asm {
    call WtChar
  }
  V2 = V * 100
  V = Val - V2
  Y = V / 10
  WtC = Y + 48
  if Val < 10 then WtC = 32
  inc WtCol
  asm {
    call WtChar
  }
  V2 = Y * 10
  V = V - V2
  WtC = V + 48
  inc WtCol
  asm {
    call WtChar
  }
  return
end sub

' News: a line on row 21 for a while
sub News(u16 At, u8 Len):
  WtRow = 21
  asm {
    call GmClearRow
  }
  V = 28 - Len
  V = V >> 1
  V = V + 2
  Say(At, Len, V, 21)
  NewsT = 20
  return
end sub

' Hud: oil, the music box's pieces, the key, frights (rows 16-18)
sub Hud:
  Say(TOil, LOil, 4, 16)
  ' a bar of ten blocks
  WtRow = 16
  for J = 0 to 9
    WtCol = J + 8
    V = J * 10
    WtC = 46
    if V < Oil then WtC = 35
    asm {
      call WtChar
    }
  next
  Say(TKey, LKey, 22, 16)
  WtRow = 16
  WtCol = 26
  WtC = 45
  if HasKey = 1 then WtC = 35
  asm {
    call WtChar
  }
  Say(TPieces, LPieces, 4, 18)
  Num(Placed, 10, 18)
  WtCol = 13
  WtC = 47
  asm {
    call WtChar
  }
  WtCol = 14
  WtC = 51
  asm {
    call WtChar
  }
  Say(TFright, LFright, 18, 18)
  Num(Frights, 25, 18)
  ' what you carry
  WtRow = 19
  asm {
    call GmClearRow
  }
  if Carry > 0 then Say(TCarry, LCarry, 8, 19)
  return
end sub

' ---------------------------------------------------------------------------
' the pages (in the bitmap)

sub TitlePage:
  HideSprites
  asm {
    call GmClear
  }
  ' the front hall behind the title, the ghost in it
  Flr = 0
  LoadFloor
  W16 = StartX * 256
  PX = W16 + 128
  W16 = StartY * 256
  PY = W16 + 128
  Ang = 0
  DarkH = 12
  DimH = 30
  asm {
    call WfCast
    call WfRender
  }
  Say(TTitle, LTitle, 9, 16)
  Say(TPlay, LPlay, 12, 18)
  Say(THow, LHow, 12, 19)
  Say(TCred, LCred, 12, 20)
  Say(TOrig, LOrig, 5, 22)
  Sel = 0
  ShowSel
  play song MmSong once
  WaitStick
tp_loop:
  Frame1
  ReadPad
  ' the view turns slowly; the ghost floats by
  V = Tick & 7
  if V = 0 then
    inc Ang
    asm {
      call GmTrig
      call WfCast
      call WfRender
    }
  end if
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      play sound SndTick
      ShowSel
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop song
  mute all
  play sound SndCreak
  return
end sub

sub ShowSel:
  WtCol = 10
  for I = 0 to 2
    WtRow = I + 18
    WtC = 32
    if I = Sel then WtC = 62
    asm {
      call WtChar
    }
  next
  return
end sub

sub TextPage:
  HideSprites
  asm {
    call GmClear
  }
  return
end sub

sub HowToPage:
  TextPage
  ShowPage(PgHowTo, NPgHowTo)
  WaitPress
  return
end sub

sub CreditsPage:
  TextPage
  ShowPage(PgCredits, NPgCredits)
  WaitPress
  return
end sub

sub EndPage:
  TextPage
  if Placed >= 3 then
    ShowPage(PgWon, NPgWon)
  else
    ShowPage(PgLost, NPgLost)
    Num(Placed, 15, 9)
  end if
  Hold(60)
  WaitPress
  return
end sub

' ShowPage: lines Pg .. Pg + N - 1 of the page table (row, text, length)
sub ShowPage(u8 Pg, u8 Cnt):
  for K = 1 to Cnt
    V = PgAtH[Pg]
    W16 = V * 256
    V = PgAtL[Pg]
    W16 = W16 + V
    Say(W16, PgLen[Pg], 2, PgRow[Pg])
    inc Pg
  next
  return
end sub

' ---------------------------------------------------------------------------
' the machine

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Hold(u8 Frames):
  for C = 1 to Frames
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub WaitStick:
  WasBtn = 1
  WasStick = 1
  return
end sub

sub WaitPress:
  WaitStick
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  play sound SndTick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  sprites flicker off
  for C = 0 to 11
    set sprite C to 192,0,0,0
  next
  update sprites
  return
end sub

