    inc b
    dec b
    jr z,WfDB6
    ld a,(hl)
    push hl
    ld c,a
    srl a
    or c
    ld l,a                      ; l = the mask
    ld a,e
    rrca
    sbc a,a
    and l
    xor c
    ld c,a                      ; c = this row's value
WfGB6:
    ld a,(de)
    or c
    ld (de),a
    inc de
    ld a,c
    xor l
    ld c,a
    djnz WfGB6
    pop hl
