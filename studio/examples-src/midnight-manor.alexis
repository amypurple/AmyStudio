asm {
; WOLF engine: the bitmap ray caster (from DEEP HALLS' DDA)
; WfMul: HL = (A * DE) >> 8 (unrolled shift and add on A:HL)
WfMul:
    ld hl,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    add hl,hl
    rla
    jr nc,$+5
    add hl,de
    adc a,0
    ld l,h
    ld h,a
    ret

WfCast:
    xor a
    ld (AMY_UVAR_RcC),a
WfCa0:
    ; the ray's angle
    ld a,(AMY_UVAR_RcC)
    ld e,a
    ld d,0
    ld hl,WfOff
    add hl,de
    ld a,(AMY_UVAR_Ang)
    add a,(hl)
    ld (AMY_UVAR_RcA),a
    ; the angle's record: WfAng + a * 8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,WfAng
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_RcStX),a       ; bit 7: going west
    add a,a
    ld (AMY_UVAR_RcStY),a       ; bit 7: going north
    inc hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld (AMY_UVAR_RcDX),de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld (AMY_UVAR_RcDY),de
    ld a,(hl)
    ld (AMY_UVAR_RcAbX),a
    inc hl
    ld a,(hl)
    ld (AMY_UVAR_RcAbY),a
    ; --- across: the first x line
    ld de,(AMY_UVAR_RcDX)
    ld a,(AMY_UVAR_PX+1)
    ld (AMY_UVAR_RcMX),a
    ld a,(AMY_UVAR_RcStX)
    rla
    ld a,(AMY_UVAR_PX)
    jr c,WfCa1
    ; east: (1 - frac)
    or a
    jr nz,WfCa1a
    ld (AMY_UVAR_RcSX),de
    jr WfCa2
WfCa1a:
    neg
WfCa1:
    call WfMul
    ld (AMY_UVAR_RcSX),hl
WfCa2:
    ; --- down: the first y line
    ld de,(AMY_UVAR_RcDY)
    ld a,(AMY_UVAR_PY+1)
    ld (AMY_UVAR_RcMY),a
    ld a,(AMY_UVAR_RcStY)
    rla
    ld a,(AMY_UVAR_PY)
    jr c,WfCa3
    or a
    jr nz,WfCa3a
    ld (AMY_UVAR_RcSY),de
    jr WfCa4
WfCa3a:
    neg
WfCa3:
    call WfMul
    ld (AMY_UVAR_RcSY),hl
WfCa4:
    ; the map pointer
    ld a,(AMY_UVAR_RcMY)
    add a,a
    add a,a
    add a,a
    add a,a
    ld hl,AMY_UVAR_RcMX
    or (hl)
    ld e,a
    ld d,0
    ld iy,AMY_UVAR_Map
    add iy,de
    ld hl,(AMY_UVAR_RcSX)
    ld de,(AMY_UVAR_RcSY)
    ld bc,(AMY_UVAR_RcDX)
    ld a,(AMY_UVAR_RcStX)
    rla
    jr c,WfCa5
    ld a,(AMY_UVAR_RcStY)
    rla
    jp nc,WfLES
    jp WfLEN
WfCa5:
    ld a,(AMY_UVAR_RcStY)
    rla
    jp nc,WfLWS
    jp WfLWN
WfLES:
    or a
    sbc hl,de
    add hl,de
    jr nc,WfLESy
    add hl,bc
    inc iy
    ld a,(iy+0)
    or a
    jr z,WfLES
    jp WfHitX
WfLESy:
    ex de,hl
    ld bc,(AMY_UVAR_RcDY)
    add hl,bc
    ex de,hl
    ld bc,16
    add iy,bc
    ld bc,(AMY_UVAR_RcDX)
    ld a,(iy+0)
    or a
    jr z,WfLES
    jp WfHitY
WfLEN:
    or a
    sbc hl,de
    add hl,de
    jr nc,WfLENy
    add hl,bc
    inc iy
    ld a,(iy+0)
    or a
    jr z,WfLEN
    jp WfHitX
WfLENy:
    ex de,hl
    ld bc,(AMY_UVAR_RcDY)
    add hl,bc
    ex de,hl
    ld bc,-16
    add iy,bc
    ld bc,(AMY_UVAR_RcDX)
    ld a,(iy+0)
    or a
    jr z,WfLEN
    jp WfHitY
WfLWS:
    or a
    sbc hl,de
    add hl,de
    jr nc,WfLWSy
    add hl,bc
    dec iy
    ld a,(iy+0)
    or a
    jr z,WfLWS
    jp WfHitX
WfLWSy:
    ex de,hl
    ld bc,(AMY_UVAR_RcDY)
    add hl,bc
    ex de,hl
    ld bc,16
    add iy,bc
    ld bc,(AMY_UVAR_RcDX)
    ld a,(iy+0)
    or a
    jr z,WfLWS
    jp WfHitY
WfLWN:
    or a
    sbc hl,de
    add hl,de
    jr nc,WfLWNy
    add hl,bc
    dec iy
    ld a,(iy+0)
    or a
    jr z,WfLWN
    jp WfHitX
WfLWNy:
    ex de,hl
    ld bc,(AMY_UVAR_RcDY)
    add hl,bc
    ex de,hl
    ld bc,-16
    add iy,bc
    ld bc,(AMY_UVAR_RcDX)
    ld a,(iy+0)
    or a
    jr z,WfLWN
    jp WfHitY
WfHitX:
    ld (AMY_UVAR_RcSX),hl
    ld (AMY_UVAR_RcSY),de
    ld (AMY_UVAR_RcKind),a
    xor a
    ld (AMY_UVAR_RcSide),a
    jr WfHit0
WfHitY:
    ld (AMY_UVAR_RcSX),hl
    ld (AMY_UVAR_RcSY),de
    ld (AMY_UVAR_RcKind),a
    ld a,1
    ld (AMY_UVAR_RcSide),a
WfHit0:
    ; the distance: back one step on the side that was crossed
    ld a,(AMY_UVAR_RcSide)
    or a
    jr nz,WfHi1
    ld hl,(AMY_UVAR_RcSX)
    ld de,(AMY_UVAR_RcDX)
    jr WfHi2
WfHi1:
    ld hl,(AMY_UVAR_RcSY)
    ld de,(AMY_UVAR_RcDY)
WfHi2:
    or a
    sbc hl,de
    ld (AMY_UVAR_RcDist),hl
    ; --- where on the wall: the texture column u (sixteenths of the cell)
    ld a,(AMY_UVAR_RcSide)
    or a
    jr nz,WfU1
    ; an x line was crossed: the wall runs along y: y = PY +- dist * |sin|
    ld a,(AMY_UVAR_RcAbY)
    ld de,(AMY_UVAR_RcDist)
    call WfMul
    ex de,hl
    ld hl,(AMY_UVAR_PY)
    ld a,(AMY_UVAR_RcStY)
    jr WfU2
WfU1:
    ld a,(AMY_UVAR_RcAbX)
    ld de,(AMY_UVAR_RcDist)
    call WfMul
    ex de,hl
    ld hl,(AMY_UVAR_PX)
    ld a,(AMY_UVAR_RcStX)
WfU2:
    bit 7,a
    jr nz,WfU3
    add hl,de
    jr WfU4
WfU3:
    or a
    sbc hl,de
WfU4:
    ld a,l
    and $F0
    ld (AMY_UVAR_RcU),a         ; u * 16
    ; --- corrected distance: times the cosine of the ray's angle
    ld a,(AMY_UVAR_RcC)
    ld e,a
    ld d,0
    ld hl,WfCosOff
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_RcDist)
    call WfMul
    ld a,h
    cp 16
    jr c,WfZ1
    ld a,255
    jr WfZ2
WfZ1:
    ld a,l
    srl h
    rra
    srl h
    rra
    srl h
    rra
    srl h
    rra
    or a
    jr nz,WfZ2
    inc a
WfZ2:
    ld (AMY_UVAR_RcZ),a
    ; the column's records: RZ, RH, RU, RS
    ld a,(AMY_UVAR_RcC)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_RZ
    add hl,de
    ld a,(AMY_UVAR_RcZ)
    ld (hl),a
    ld e,a
    ld hl,WfH
    add hl,de
    ld b,(hl)                   ; b = height
    ; (RH, RU, RS hold the strip's two rays only: index RcC and 1)
    ld a,(AMY_UVAR_RcC)
    and 1
    ld e,a
    ld hl,AMY_UVAR_RH
    add hl,de
    ld (hl),b
    ld hl,AMY_UVAR_RU
    add hl,de
    ld a,(AMY_UVAR_RcU)
    ld (hl),a
    ; the set: (kind - 1) * 2, plus 1 on the dark side or dim; 12 (black)
    ; beyond the lantern's light
    ld a,b
    ld hl,AMY_UVAR_DarkH
    cp (hl)
    ld c,12
    jr c,WfK3
    ld a,(AMY_UVAR_RcKind)
    dec a
    cp 6
    jr c,WfK1
    xor a
WfK1:
    add a,a
    ld c,a
    ld a,(AMY_UVAR_RcSide)
    or a
    jr nz,WfK2
    ld a,b
    ld hl,AMY_UVAR_DimH
    cp (hl)
    jr nc,WfK3
WfK2:
    inc c
WfK3:
    ld hl,AMY_UVAR_RS
    add hl,de
    ld (hl),c
    ; after each second ray, its strip is drawn
    ld a,(AMY_UVAR_RcC)
    bit 0,a
    jr z,WfK4
    srl a
    ld (AMY_UVAR_WfS),a
    call WfStrip
WfK4:
    ld a,(AMY_UVAR_RcC)
    inc a
    ld (AMY_UVAR_RcC),a
    cp 32
    jp nz,WfCa0
    ret

; WfMulLo: HL = (A * DE) and 65535
WfMulLo:
    ld hl,0
    ld b,8
WfML1:
    add hl,hl
    add a,a
    jr nc,WfML2
    add hl,de
WfML2:
    djnz WfML1
    ret

; The view is drawn in rows of 2 pixels: 48 a column.
; WfSetup: ray A's column: WfTop (rows of ceiling), WfCnt (rows of wall),
; WfAcc (the texel accumulator at the first wall row, 8.8), WfSt2 (the
; step a row), WfPg (texture page: WfTex's page + the set), WfU (u * 16)
WfSetup:
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_RH
    add hl,de
    ld a,(hl)
    or a
    jr nz,WfS0
    inc a
WfS0:
    ld (AMY_UVAR_WfHt),a
    ld hl,AMY_UVAR_RU
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_WfU),a
    ld hl,AMY_UVAR_RS
    add hl,de
    ld a,(hl)
    ld b,a
    and 1
    ld (AMY_UVAR_WfDark),a
    ld a,b
    ld hl,AMY_UVAR_WfTex+1
    add a,(hl)
    ld (AMY_UVAR_WfPg),a
    ld a,(AMY_UVAR_WfHt)
    ld l,a
    ld h,0
    add hl,hl
    ld de,WfStep
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    add hl,hl
    ld (AMY_UVAR_WfSt2),hl
    ; half the height in rows of 2: height / 4
    ld a,(AMY_UVAR_WfHt)
    srl a
    srl a
    ld b,a
    ld a,24
    sub b
    jr c,WfS1
    ld (AMY_UVAR_WfTop),a
    ld a,b
    add a,a
    ld (AMY_UVAR_WfCnt),a
    ld hl,0
    ld (AMY_UVAR_WfAcc),hl
    ret
WfS1:
    ; taller than the view: start part way down the texture
    neg
    ld de,(AMY_UVAR_WfSt2)
    call WfMulLo
    ld (AMY_UVAR_WfAcc),hl
    xor a
    ld (AMY_UVAR_WfTop),a
    ld a,48
    ld (AMY_UVAR_WfCnt),a
    ret

; WfBuildA: the left ray (set up) into Buf (48 rows): ceiling, wall, floor
WfBuildA:
    ld de,AMY_UVAR_Buf
    ld a,(AMY_UVAR_WfTop)
    or a
    jr z,WfA2
    ld b,a
    xor a
WfA1:
    ld (de),a
    inc de
    djnz WfA1
WfA2:
    ; the runs of this height: WfRuns + height * 16
    ld a,(AMY_UVAR_WfHt)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld bc,WfRuns
    add hl,bc
    push hl
    pop ix
    ld a,(AMY_UVAR_WfU)
    ld l,a
    ld a,(AMY_UVAR_WfPg)
    ld h,a
    ld a,(AMY_UVAR_WfDark)
    or a
    jp nz,WfADark
    ld b,(ix+0)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA0
WfFA0:
    ld (de),a
    inc de
    djnz WfFA0
WfRA0:
    ld b,(ix+1)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA1
WfFA1:
    ld (de),a
    inc de
    djnz WfFA1
WfRA1:
    ld b,(ix+2)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA2
WfFA2:
    ld (de),a
    inc de
    djnz WfFA2
WfRA2:
    ld b,(ix+3)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA3
WfFA3:
    ld (de),a
    inc de
    djnz WfFA3
WfRA3:
    ld b,(ix+4)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA4
WfFA4:
    ld (de),a
    inc de
    djnz WfFA4
WfRA4:
    ld b,(ix+5)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA5
WfFA5:
    ld (de),a
    inc de
    djnz WfFA5
WfRA5:
    ld b,(ix+6)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA6
WfFA6:
    ld (de),a
    inc de
    djnz WfFA6
WfRA6:
    ld b,(ix+7)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA7
WfFA7:
    ld (de),a
    inc de
    djnz WfFA7
WfRA7:
    ld b,(ix+8)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA8
WfFA8:
    ld (de),a
    inc de
    djnz WfFA8
WfRA8:
    ld b,(ix+9)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA9
WfFA9:
    ld (de),a
    inc de
    djnz WfFA9
WfRA9:
    ld b,(ix+10)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA10
WfFA10:
    ld (de),a
    inc de
    djnz WfFA10
WfRA10:
    ld b,(ix+11)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA11
WfFA11:
    ld (de),a
    inc de
    djnz WfFA11
WfRA11:
    ld b,(ix+12)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA12
WfFA12:
    ld (de),a
    inc de
    djnz WfFA12
WfRA12:
    ld b,(ix+13)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA13
WfFA13:
    ld (de),a
    inc de
    djnz WfFA13
WfRA13:
    ld b,(ix+14)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA14
WfFA14:
    ld (de),a
    inc de
    djnz WfFA14
WfRA14:
    ld b,(ix+15)
    ld a,(hl)
    inc l
    inc b
    dec b
    jr z,WfRA15
WfFA15:
    ld (de),a
    inc de
    djnz WfFA15
WfRA15:
    jp WfA4
WfADark:
    ld b,(ix+0)
    inc b
    dec b
    jr z,WfDA0
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA0:
    ld (de),a
    inc de
    xor c
    djnz WfGA0
WfDA0:
    inc l
    ld b,(ix+1)
    inc b
    dec b
    jr z,WfDA1
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA1:
    ld (de),a
    inc de
    xor c
    djnz WfGA1
WfDA1:
    inc l
    ld b,(ix+2)
    inc b
    dec b
    jr z,WfDA2
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA2:
    ld (de),a
    inc de
    xor c
    djnz WfGA2
WfDA2:
    inc l
    ld b,(ix+3)
    inc b
    dec b
    jr z,WfDA3
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA3:
    ld (de),a
    inc de
    xor c
    djnz WfGA3
WfDA3:
    inc l
    ld b,(ix+4)
    inc b
    dec b
    jr z,WfDA4
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA4:
    ld (de),a
    inc de
    xor c
    djnz WfGA4
WfDA4:
    inc l
    ld b,(ix+5)
    inc b
    dec b
    jr z,WfDA5
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA5:
    ld (de),a
    inc de
    xor c
    djnz WfGA5
WfDA5:
    inc l
    ld b,(ix+6)
    inc b
    dec b
    jr z,WfDA6
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA6:
    ld (de),a
    inc de
    xor c
    djnz WfGA6
WfDA6:
    inc l
    ld b,(ix+7)
    inc b
    dec b
    jr z,WfDA7
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA7:
    ld (de),a
    inc de
    xor c
    djnz WfGA7
WfDA7:
    inc l
    ld b,(ix+8)
    inc b
    dec b
    jr z,WfDA8
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA8:
    ld (de),a
    inc de
    xor c
    djnz WfGA8
WfDA8:
    inc l
    ld b,(ix+9)
    inc b
    dec b
    jr z,WfDA9
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA9:
    ld (de),a
    inc de
    xor c
    djnz WfGA9
WfDA9:
    inc l
    ld b,(ix+10)
    inc b
    dec b
    jr z,WfDA10
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA10:
    ld (de),a
    inc de
    xor c
    djnz WfGA10
WfDA10:
    inc l
    ld b,(ix+11)
    inc b
    dec b
    jr z,WfDA11
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA11:
    ld (de),a
    inc de
    xor c
    djnz WfGA11
WfDA11:
    inc l
    ld b,(ix+12)
    inc b
    dec b
    jr z,WfDA12
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA12:
    ld (de),a
    inc de
    xor c
    djnz WfGA12
WfDA12:
    inc l
    ld b,(ix+13)
    inc b
    dec b
    jr z,WfDA13
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA13:
    ld (de),a
    inc de
    xor c
    djnz WfGA13
WfDA13:
    inc l
    ld b,(ix+14)
    inc b
    dec b
    jr z,WfDA14
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA14:
    ld (de),a
    inc de
    xor c
    djnz WfGA14
WfDA14:
    inc l
    ld b,(ix+15)
    inc b
    dec b
    jr z,WfDA15
    ld a,(hl)
    ld c,a
    srl c
    or c
    ld c,a
    ld a,e
    rrca
    sbc a,a
    and c
    xor (hl)
WfGA15:
    ld (de),a
    inc de
    xor c
    djnz WfGA15
WfDA15:
    inc l
WfA4:
    ld a,(AMY_UVAR_WfTop)
    ld hl,AMY_UVAR_WfCnt
    add a,(hl)
    cp 48
    ret nc
    ld c,a
    ld b,0
    ld hl,WfFlHi
    add hl,bc
    ld a,48
    sub c
    ld c,a
    ldir
    ret

; WfBuildB: the right ray (set up) ORed into Buf
WfBuildB:
    ld de,AMY_UVAR_Buf
    ld a,(AMY_UVAR_WfTop)
    ld l,a
    ld h,0
    add hl,de
    ex de,hl                    ; (the ceiling adds nothing)
    ; the runs of this height: WfRuns + height * 16
    ld a,(AMY_UVAR_WfHt)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld bc,WfRuns
    add hl,bc
    push hl
    pop ix
    ld a,(AMY_UVAR_WfU)
    ld l,a
    ld a,(AMY_UVAR_WfPg)
    ld h,a
    ld a,(AMY_UVAR_WfDark)
    or a
