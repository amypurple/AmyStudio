' FP5 str$ buffer lab: verify friendly fp5 strings land in 16-byte buffers.
u16 UZero = 0
u16 UOne = 1
u16 UTen = 10
i16 SNegTen = -10
fp5 FZero = 0
fp5 FOne = 0
fp5 FTen = 0
fp5 FNegTen = 0
fp5 FRnd = 0
u8 BZero[16]
u8 BOne[16]
u8 BTen[16]
u8 BNegTen[16]
u8 BRnd[16]

  text screen
  print at 6,0, "FP5 STR$ BUFFER LAB"

  FZero = UZero
  FOne = UOne
  FTen = UTen
  FNegTen = SNegTen
  FRnd = random()

  BZero = str$(FZero)
  BOne = str$(FOne)
  BTen = str$(FTen)
  BNegTen = str$(FNegTen)
  BRnd = str$(FRnd)

  print at 1,4,  "0"
  put BZero count 16 at 10,4
  print at 1,6,  "1"
  put BOne count 16 at 10,6
  print at 1,8,  "10"
  put BTen count 16 at 10,8
  print at 1,10, "-10"
  put BNegTen count 16 at 10,10
  print at 1,12, "rnd"
  put BRnd count 16 at 10,12

  print at 1,15, "EXPECT"
  print at 1,16, "0"
  print at 1,17, "1"
  print at 1,18, "10"
  print at 1,19, "-10"
  print at 1,20, "rnd friendly in 0.0 .. <1.0"
  screen on