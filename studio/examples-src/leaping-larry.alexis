const TBelt3l4 = 180
const TBelt3l5 = 181
const TBelt3l6 = 182
const TBelt3l7 = 183
const TBelt3f = 184
const TBelt3r1 = 185
const TBelt3r2 = 186
const TBelt3r3 = 187
const TBelt3r4 = 188
const TBelt3r5 = 189
const TBelt3r6 = 190
const TBelt3r7 = 191
const TBelt4e = 192
const TBelt4l1 = 193
