asm {
LlTick:
    db $40,$47,$60,$01,$50
LlLeap:
    db $40,$D6,$30,$02,$40,$AA,$30,$02,$40,$8F,$30,$02,$40,$6B,$40,$02,$40,$55,$60,$02,$50
LlLand:
    db $00,$00,$35,$02,$00,$00,$66,$02,$10
LlPlans:
    db $40,$8F,$20,$03,$40,$8F,$F0,$01,$40,$71,$20,$03,$40,$71,$F0,$01,$40,$5F,$20,$07,$40,$5F,$F0,$01
    db $50
LlBonus:
    db $40,$55,$20,$02,$40,$55,$F0,$01,$40,$47,$20,$02,$40,$47,$F0,$01,$40,$35,$20,$05,$40,$35,$F0,$01
    db $50
LlDie:
    db $40,$D6,$20,$07,$40,$D6,$F0,$01,$40,$E2,$20,$07,$40,$E2,$F0,$01,$40,$F0,$20,$07,$40,$F0,$F0,$01
    db $40,$FE,$20,$07,$40,$FE,$F0,$01,$40,$0E,$21,$13,$40,$0E,$F1,$01,$50
LlLevel:
    db $40,$D6,$20,$04,$40,$D6,$F0,$01,$40,$AA,$20,$04,$40,$AA,$F0,$01,$40,$8F,$20,$04,$40,$8F,$F0,$01
    db $40,$6B,$20,$04,$40,$6B,$F0,$01,$40,$8F,$20,$04,$40,$8F,$F0,$01,$40,$6B,$20,$04,$40,$6B,$F0,$01
    db $40,$55,$20,$17,$40,$55,$F0,$01,$50
LlStart:
    db $40,$1D,$21,$04,$40,$1D,$F1,$01,$40,$D6,$20,$04,$40,$D6,$F0,$01,$40,$AA,$20,$09,$40,$AA,$F0,$01
    db $50

LlSoundTable:
    dw LlTick,$702B
    dw LlLeap,$7035
    dw LlLand,$702B
    dw LlPlans,$7035
    dw LlBonus,$7035
    dw LlDie,$7035
    dw LlLevel,$7035
    dw LlStart,$7035
    dw LlTuneMel,$703F
    dw LlTuneBass,$7049
; Factory Shuffle, C major (original for this game)
; Tiny Sound, 8 frames per step
LlTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1F,$23,$26,$23,$28,$26,$23,$1F,$21,$24,$28,$24
    db $26,$01,$01,$01,$23,$26,$2B,$26,$28,$24,$21,$24,$26,$23,$1F,$21
    db $1F,$01,$01,$01
    db $FF
LlTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$07,$01,$0E,$01,$04,$01,$0B,$01,$09,$01,$10,$01
    db $0E,$01,$09,$01,$07,$01,$0E,$01,$0C,$01,$07,$01,$0E,$01,$09,$01
    db $07,$01,$0E,$01
    db $FF
; belts.asm: the six conveyor belts of Leaping Larry.
; A belt row is a pattern 64 pixels long that repeats across the screen:
; pixel x holds belt when ((x - offset) & 63) < BLen. LlMoveBelts slides
; each offset by its speed (8.8 fixed point) in its direction; LlDrawBelts
; rewrites the six rows of the name table with the tiles that cut a belt
; on the right pixel (art.py: per row, empty, 1-7 pixels from the left,
; full, 1-7 pixels from the right). Call both with the NMI off.

LlBeltRow:
    db 19, 17, 14, 12, 9, 7

; LlMoveBelts: offset += or -= speed for each belt
LlMoveBelts:
    ld c,0
MbLp:
    ld b,0
    ld hl,AMY_UVAR_BSpL
    add hl,bc
    ld e,(hl)
    ld hl,AMY_UVAR_BSpH
    add hl,bc
    ld d,(hl)
    ld hl,AMY_UVAR_BDir
    add hl,bc
    ld a,(hl)
    push af
    ld hl,AMY_UVAR_BOfL
    add hl,bc
    ld a,(hl)
    ld hl,AMY_UVAR_BOfH
    add hl,bc
    ld h,(hl)
    ld l,a
    pop af
    or a
    jr nz,MbLeft
    add hl,de
    jr MbStore
MbLeft:
    or a
    sbc hl,de
MbStore:
    ex de,hl
    ld hl,AMY_UVAR_BOfL
    add hl,bc
    ld (hl),e
    ld hl,AMY_UVAR_BOfH
    add hl,bc
    ld (hl),d
    inc c
    ld a,c
    cp 6
    jr c,MbLp
    ret

; LlDrawBelts: the six belt rows, columns 2-29
LlDrawBelts:
    ld c,0
DbRow:
    push bc
    ld b,0
    ld hl,LlBeltRow
    add hl,bc
    ld l,(hl)
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1802
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    or $40
    out ($BF),a
    ; tile base of this row: 128 + 16 * row
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,a
    add a,128
    ld e,a
    ld hl,AMY_UVAR_BVis
    add hl,bc
    ld a,(hl)
    or a
    jr z,DbHidden
    ld hl,AMY_UVAR_BOfH
    add hl,bc
    ld a,16
    sub (hl)
    and 63
    ld c,a              ; c = position in the pattern
    ld a,(AMY_UVAR_BLen)
    ld d,a
    ld b,28
DbCol:
    ld a,c
    cp d
    jr nc,DbOut1
    add a,8
    cp d
    jr z,DbFull
    jr c,DbFull
    ld a,d              ; the belt ends in this tile: L - s pixels
    sub c
    add a,e
    jr DbPut
DbFull:
    ld a,e
    add a,8
    jr DbPut
DbOut1:
    cp 57
    jr c,DbEmpty
    sub 48              ; the next belt starts here: s - 56 pixels, + 8
    add a,e
    jr DbPut
DbEmpty:
    ld a,e
DbPut:
    out ($BE),a
    ld a,c
    add a,8
    and 63
    ld c,a
    djnz DbCol
    jr DbNext
DbHidden:
    ld b,28
    ld a,e
DbHl:
    out ($BE),a
    nop
    nop
    djnz DbHl
DbNext:
    pop bc
    inc c
    ld a,c
    cp 6
    jp c,DbRow
    ret
}
