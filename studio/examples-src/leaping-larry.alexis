const TBelt5l7 = 215
const TBelt5f = 216
const TBelt5r1 = 217
const TBelt5r2 = 218
const TBelt5r3 = 219
const TBelt5r4 = 220
const TBelt5r5 = 221
const TBelt5r6 = 222
const TBelt5r7 = 223
const TGround = 224
const TTop = 225
const TTopoff = 226
const TPlansg00 = 227
const TPlansg01 = 228
const TPlanst00 = 229
const TPlanst01 = 230
const TPlanst10 = 231
const TPlanst11 = 232
const SLarwalk1D = 0
const SLarwalk1B = 4
const SLalwalk1D = 8
const SLalwalk1B = 12
const SLarwalk2D = 16
const SLarwalk2B = 20
const SLalwalk2D = 24
const SLalwalk2B = 28
const SLarleapD = 32
const SLarleapB = 36
const SLalleapD = 40
const SLalleapB = 44
const SRobot1D = 48
const SRobot1B = 52
const SRobot2D = 56
const SRobot2B = 60
const SPlan = 64
const NTiles8 = 840
const SprBytes = 544
const SndTick = 1
const SndLeap = 2
const SndLand = 3
const SndPlans = 4
const SndBonus = 5
const SndDie = 6
const SndLevel = 7
const SndStart = 8
const SndTuneA = 9
const SndTuneB = 10

u8 BOfL[6]
u8 BOfH[6]
u8 BSpL[6]
u8 BSpH[6]
u8 BDir[6]
u8 BVis[6]
u8 BLen = 48
u8 TopVis = 1
u16 Score = 0
u16 Best = 0
u16 NumU = 0
u16 Spd = 0
u8 Lives = 3
u8 Level = 1
u8 Lx = 24
u8 Ly = 176
u8 Lst = 0
u8 Ls = 0
u8 Face = 0
u8 Ldx = 0
u8 Jf = 0
u8 Vf = 0
u8 Fc = 0
u8 Walk = 0
u8 Moving = 0
u8 Fx = 0
u8 Gx = 200
u8 Gd = 1
u8 Gacc = 0
u8 Tx = 40
u8 Td = 0
u8 Tacc = 0
u8 RSpd = 3
u8 PB = 1
u8 PBc = 20
u8 PTc = 14
u8 Pf = 0
u8 Pfx = 0
u8 Pfy = 0
u8 PfT = 0
u8 Hurt = 0
u8 Won = 0
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 Mix = 0
u8 K = 0
u8 J = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0
u8 Sp = 0
u8 Hit = 0

  tile screen
  set sound table LlSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Best = 0

title:
  TitlePage
  if Menu = 1 then
    HelpPage
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if
  Score = 0
  Lives = 3
  Level = 1

new_level:
  SetupLevel
  DrawLevel
  StartLarry
  play sound SndStart

play_loop:
  Frame1
  call asm LlDrawBelts
  call asm LlMoveBelts
  ReadPad
  MoveLarry
  MoveRobots
  FallingPlans
  CheckRobots
  DrawSprites
  if Hurt = 1 then goto lost_life
  if Won = 1 then goto level_done
  goto play_loop

lost_life:
  play sound SndDie
  for J = 1 to 60
    Frame1
    call asm LlDrawBelts
    call asm LlMoveBelts
    V = J & 4
    if V = 0 then
      DrawSprites
    else
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
      update sprites
    end if
  next
  dec Lives
  if Lives = 0 then goto game_over
  ShowHud
  StartLarry
  goto play_loop

level_done:
  play sound SndLevel
  for J = 1 to 90
    Frame1
    call asm LlDrawBelts
    call asm LlMoveBelts
  next
  inc Level
  goto new_level

game_over:
  HideSprites
  if Score > Best then Best = Score
  print at 10,11, "          "
  print at 11,11, "GAME OVER"
  ShowHud
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------
' Levels

sub SetupLevel:
  ' belts shorten until level 6
  V = Level
  if V > 6 then V = 6
  if V = 1 then BLen = 48
  if V = 2 then BLen = 40
  if V = 3 then BLen = 34
  if V = 4 then BLen = 28
  if V = 5 then BLen = 24
  if V = 6 then BLen = 20
  ' from level 7 the floors vanish from the top down
  TopVis = 1
  if Level >= 7 then TopVis = 0
  for K = 0 to 5
    BVis[K] = 1
    V = 13 - K
    if Level >= V then BVis[K] = 0
    BDir[K] = K & 1
    BOfH[K] = random(0, 63)
    BOfL[K] = 0
    ' speed in 1/256 pixels a frame: about 1.2 to 1.6 (Larry walks 1)
    Spd = K * 16
    Spd = Spd + 300
    V = Level
    if V > 8 then V = 8
    W = V * 8
    Spd = Spd + W
    BSpL[K] = Spd & 255
    BSpH[K] = Spd >> 8
  next
  ' robots get a little faster every two levels
  RSpd = Level >> 1
  RSpd = RSpd + 3
  if RSpd > 6 then RSpd = 6
  PB = 1
  PBc = random(14, 25)
  PTc = random(4, 25)
  Pf = 0
  PfT = 200
  return
end sub

sub StartLarry:
  Lx = 24
  Ly = 176
  Lst = 0
  Ls = 0
  Face = 0
  Hurt = 0
  Won = 0
  Gx = 200
  Gd = 1
  Tx = 30
  if PTc < 15 then Tx = 200
  Td = 0
  WasBtn = 1
  return
end sub

' ---------------------------------------------------------------------------
' Larry

' Support: is there floor under X on surface V (0 ground, 1-6 belts, 7 top)?
' Answer in Sp.
sub Support:
  Sp = 1
  if V = 0 then return
  if V = 7 then return
  K = V - 1
  Sx = X - BOfH[K]
  Sx = Sx & 63
  if Sx >= BLen then Sp = 0
  return
end sub

sub MoveLarry:
  Moving = 0
  if Lst = 0 then
    if Lf1 = 1 then
      if Lx > 16 then dec Lx
      Face = 1
      Moving = 1
    end if
    if Rt1 = 1 then
      if Lx < 224 then inc Lx
      Face = 0
      Moving = 1
    end if
    if Moving = 1 then inc Walk
    if Press = 1 then
      if Moving = 1 then
        Lst = 1
        Jf = 0
        Ldx = Face
        play sound SndLeap
        return
      end if
    end if
    ' the belt slides away under a slow Larry
    X = Lx + 8
    V = Ls
    Support
    if Sp = 0 then
      Lst = 2
      Vf = 1
      Fc = 0
    end if
    PlansHere
    return
  end if
  ' in the air: keep going the way he leapt
  if Ldx = 0 then
    if Lx < 224 then inc Lx
  else
    if Lx > 16 then dec Lx
  end if
  if Lst = 1 then
    V = Rise[Jf]
    Ly = Ly - V
    inc Jf
    if Jf = 12 then
      Lst = 2
      Vf = 0
      Fc = 0
    end if
    return
  end if
  ' falling: one pixel at a time, landing on a surface with floor
  inc Fc
  if Fc = 3 then
    Fc = 0
    if Vf < 4 then inc Vf
  end if
  if Vf = 0 then return
  for J = 1 to Vf
    inc Ly
    ' surfaces are at y = 176 - 20 * n
    V = 176 - Ly
    Sy = V / 20
    X = Sy * 20
    ' surfaces 0-7 only: above the top floor (a leap from it) is the air
    if Sy > 7 then X = 255
    if X = V then
      X = Lx + 8
      V = Sy
      Support
      if Sp = 1 then
        Lst = 0
        Ls = Sy
        play sound SndLand
        return
      end if
    end if
    if Ly >= 176 then
      Ly = 176
      Lst = 0
      Ls = 0
      return
    end if
  next
  return
end sub

data Rise bytes 3,3,3,2,2,2,2,2,1,1,1,1

sub PlansHere:
  if Ls = 0 then
    if PB = 1 then
      X = PBc * 8
      V = Lx + 4
      W = X - 4
      if V >= W then
        W = X + 12
        if V <= W then
          PB = 0
          Score = Score + 100
          play sound SndPlans
          fill 32 count 2 at PBc,21
          ShowHud
        end if
      end if
    end if
  end if
  if Ls = 7 then
    X = PTc * 8
    V = Lx + 4
    W = X - 4
    if V >= W then
      W = X + 12
      if V <= W then
        Score = Score + 600
        ShowHud
        Won = 1
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' Robots and falling plans

sub MoveRobots:
  Gacc = Gacc + RSpd
  while Gacc >= 4
    Gacc = Gacc - 4
    if Gd = 0 then
      inc Gx
      if Gx >= 224 then Gd = 1
    else
      dec Gx
      if Gx <= 16 then Gd = 0
    end if
  end while
  Tacc = Tacc + RSpd
  while Tacc >= 4
    Tacc = Tacc - 4
    if Td = 0 then
      inc Tx
      if Tx >= 224 then Td = 1
    else
      dec Tx
      if Tx <= 16 then Td = 0
    end if
  end while
  return
end sub

sub CheckRobots:
  ' ground robot: Larry near the ground floor
  ' robots are 12 pixels tall: Larry clears them in a leap
  if Ly >= 165 then
    V = Lx - Gx
    if Lx < Gx then V = Gx - Lx
    if V < 11 then Hurt = 1
  end if
  if Ly <= 47 then
   if Ly >= 25 then
    V = Lx - Tx
    if Lx < Tx then V = Tx - Lx
    if V < 11 then Hurt = 1
   end if
  end if
  return
end sub

sub FallingPlans:
  if Pf = 0 then
    dec PfT
    if PfT = 0 then
      Pf = 1
      Pfx = random(24, 216)
      Pfy = 24
    end if
    return
  end if
  V = Tick & 1
  if V = 0 then inc Pfy
  V = Tick & 31
  if V < 16 then
    if Pfx < 224 then inc Pfx
  else
    if Pfx > 16 then dec Pfx
  end if
  ' caught?
  V = Lx - Pfx
  if Lx < Pfx then V = Pfx - Lx
  if V < 12 then
    W = Ly - 16
    X = Pfy + 4
    V = X - W
    if X < W then V = W - X
    if V < 12 then
      Pf = 0
      PfT = random(180, 255)
      Score = Score + 50
      play sound SndBonus
      ShowHud
      return
    end if
  end if
  if Pfy >= 172 then
    Pf = 0
    PfT = random(180, 255)
  end if
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

sub DrawSprites:
  ' Larry: pattern by direction and pose
  Sp = SLarwalk1D
  if Face = 1 then Sp = SLalwalk1D
  ' patterns: walk 1, walk 2 (+16), leap (+32); the body is the detail + 4
  if Lst > 0 then
    Sp = Sp + 32
  else
    V = Walk & 8
    if V > 0 then Sp = Sp + 16
  end if
  Sy = Ly - 17
  set sprite 0 to Sy, Lx, Sp, 9
  V = Sp + 4
  set sprite 1 to Sy, Lx, V, 15
  ' robots: legs move with their steps
  Sp = SRobot1D
  V = Gx & 4
  if V > 0 then Sp = SRobot2D
  set sprite 2 to 159, Gx, Sp, 8
  V = Sp + 4
  set sprite 3 to 159, Gx, V, 14
  Sp = SRobot1D
  V = Tx & 4
  if V > 0 then Sp = SRobot2D
  set sprite 4 to 19, Tx, Sp, 8
  V = Sp + 4
  set sprite 5 to 19, Tx, V, 14
  if Pf = 1 then
    set sprite 6 to Pfy, Pfx, SPlan, 7
  else
    set sprite 6 to 192, 0, 0, 0
  end if
  update sprites
  return
end sub

sub DrawLevel:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  cls
  ' ground and top floor
  fill TGround count 28 at 2,22
  if TopVis = 1 then
    fill TTop count 28 at 2,4
  end if
  ' plans on the floors
  put char TPlansg00 at PBc,21
  V = PBc + 1
  put char TPlansg01 at V,21
  put char TPlanst00 at PTc,3
  V = PTc + 1
  put char TPlanst01 at V,3
  put char TPlanst10 at PTc,4
  put char TPlanst11 at V,4
  call asm LlDrawBelts
  ShowHud
  screen on
  nmi off
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  print at 15,1, "MEN"
  NumU = Lives
  print at 19,1, digits$(NumU, 1)
  print at 22,1, "LEVEL"
  NumU = Level
  print at 28,1, digits$(NumU, 2)
  return
end sub

' ---------------------------------------------------------------------------
' Frame and controls

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then Stick = 1
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 7
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 6
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub ScreenSetup:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub TitlePage:
  ScreenSetup
  ' a little factory scene: three belts and the plans
  for K = 0 to 5
    BVis[K] = 0
  next
  BVis[0] = 1
  BVis[2] = 1
  BLen = 40
  BOfH[0] = 5
  BOfH[2] = 30
  BOfH[4] = 50
  call asm LlDrawBelts
  fill TGround count 28 at 2,22
  put char TPlansg00 at 22,21
  put char TPlansg01 at 23,21
  print at 9,2, "LEAPING  LARRY"
  print at 11,4, "PLAY"
  print at 11,5, "HOW TO PLAY"
  print at 11,6, "CREDITS"
  print at 10,8, "BEST"
  NumU = Best
  print at 15,8, digits$(NumU, 5)
  print at 5,11, "1987 MICHAEL STREETER"
  Menu = 0
  set sprite 0 to 158, 40, SLarwalk1D, 9
  set sprite 1 to 158, 40, SLarwalk1B, 15
  update sprites
  screen on
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTick
  end if
  print at 9,4, " "
  print at 9,5, " "
  print at 9,6, " "
  Y = Menu + 4
  print at 9,Y, ">"
  if Press = 1 then goto title_done
  goto title_loop
title_done:
  mute all
  return
end sub

sub HelpPage:
  ScreenSetup
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "LARRY LEFT HIS PLANS ON THE"
  print at 2,4, "TOP FLOOR OF THE FACTORY."
  print at 2,5, "THE ELEVATORS ARE OFF: LEAP"
  print at 2,6, "FROM BELT TO BELT TO REACH"
  print at 2,7, "THEM, AND KEEP AWAY FROM"
  print at 2,8, "THE ROBOTS."
  print at 2,10, "STICK: WALK."
  print at 2,11, "BUTTON: LEAP (WHILE WALKING)."
  print at 2,13, "THE BELTS ARE FASTER THAN"
  print at 2,14, "LARRY: STAND STILL AND HE"
  print at 2,15, "FALLS. TOP PLANS 600, BOTTOM"
  print at 2,16, "PLANS 100, FALLING PLANS 50."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  ScreenSetup
  print at 8,1, "LEAPING LARRY"
  print at 2,3, "BY MICHAEL STREETER, FROM"
  print at 2,4, "COMPUTE! MAGAZINE, DECEMBER"
  print at 2,5, "1987, FOR THE COMMODORE 64."
  print at 2,6, "APPLE II VERSION BY BILL"
  print at 2,7, "CHIN, ATARI VERSION BY"
  print at 2,8, "RHETT ANDERSON."
  print at 2,10, "NEW MUSIC: FACTORY SHUFFLE."
  print at 2,12, "COLECOVISION VERSION BY"
  print at 2,13, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

