u8 Si = 0
u8 Ri = 0
u8 Li = 0
u8 Ti = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
i16 Pt = 0
i16 Vt = 0
i16 Lim = 0
u8 X8 = 0
i8 E8 = 0
u8 Y8 = 0

  tile screen
  set sound table SaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 4 then
    HowToPage
    goto title
  end if
  if Menu = 5 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: who won, then the title
  mute all
  HideSprites
  print at 8,10, "              "
  if Score[0] > Score[1] then
    if Players = 1 then
      print at 8,11, "   YOU WIN!   "
    else
      print at 8,11, "  BLUE WINS!  "
    end if
  else
    if Score[1] > Score[0] then
      if Players = 1 then
        print at 8,11, "COMPUTER WINS!"
      else
        print at 8,11, " GREEN WINS!  "
      end if
    else
      print at 8,11, "  A DRAW!     "
    end if
  end if
  print at 8,12, "  TIME IS UP  "
  print at 8,13, "              "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame: the clock, then as many ticks of the C64's loop as the speed
' gives (48, 60 or 80 a second)
sub PlayFrame:
  if SecF > 0 then
    dec SecF
  else
    SecF = 59
    if SecLeft = 0 then
      Over = 1
      return
    end if
    dec SecLeft
    ShowClock
  end if
  Acc += TickAdd[Sp - 1]
  if Players = 1 then
    ' the computer thinks every 12 ticks at speed 1 (15 frames), 8 at 2-3 (8, 6), on
    ' a frame of one tick only
    if AiT > 0 then dec AiT
    if AiT = 0 then
      if Acc < 120 then
        AiThink
        AiT = AiGap[Sp - 1]
      end if
    end if
    J2 = AiPad
  end if
  while Acc >= 60
    Acc -= 60
    DoTick
  end while
  if Boom >= BoomQuiet then
    BarShow
  else
    if Boom > 0 then
      inc Blink
      if Blink >= 24 then Blink = 0
      BarShow
    end if
  end if
  return
end sub

' one tick: hits, moves, steering every 7 ticks, the shots
sub DoTick:
  if Boom > 0 then
    MoveAll
    dec Boom
    if Boom = 0 then ResetField
    return
  end if
  Hits4
  if Boom > 0 then return
  MoveAll
  dec RotT
  if RotT = 0 then
    RotT = 7
    Steer(1, J2)
    Steer(0, J1)
  end if
  ShotClock(0, J1)
  ShotClock(1, J2)
  return
end sub

' the C64's order: green's shot on the blue ship (or a rock), blue's shot
' on the green ship (or a rock), then the green ship, then the blue ship,
' against the rocks
sub Hits4:
  if ShotOn[1] = 1 then
    if Touch(7, 0) = 1 then
      Kick(7, 0)
      ShotOn[1] = 0
      AddScore(1, 1)
      inc Hits
      play sound SndHit
    else
      ShotRock(7)
    end if
  end if
  if ShotOn[0] = 1 then
    if Touch(6, 1) = 1 then
      Kick(6, 1)
      ShotOn[0] = 0
      AddScore(0, 1)
      inc Hits
      play sound SndHit
    else
      ShotRock(6)
    end if
  end if
  C = RockOf(1)
  if C < 8 then
    Push(1, C)
    Crash(1)
    return
  end if
  C = RockOf(0)
  if C < 8 then
    Push(0, C)
    Crash(0)
  end if
  return
end sub

sub ShotRock(u8 S):
  u8 R = 0
  if S = 6 then
    if ShotOn[0] = 0 then return
  else
    if ShotOn[1] = 0 then return
  end if
  R = RockOf(S)
  if R = 8 then return
  Push(S, R)
  if S = 6 then
    ShotOn[0] = 0
  else
    ShotOn[1] = 0
  end if
  play sound SndHit
  return
end sub

' the first rock (5 down to 2, as the C64 checks) touching object A, or 8
function RockOf(u8 A) as u8
  u8 R = 5
  u8 P = 0
  u8 Q = 0
  u8 W = 0
  u8 D = 0
  P = PX[A]
  W = HalfW[A] + 7
  while R >= 2
    ' a quick look across first (rocks are 7 pixels each side)
    Q = PX[R]
    if P >= Q then
      D = P - Q
    else
      D = Q - P
    end if
    if D < W then
      if Touch(A, R) = 1 then return R
    end if
    dec R
  end while
  return 8

' boxes of A and B overlap (centres in whole pixels)
function Touch(u8 A, u8 B) as u8
  u8 D = 0
  u8 W = 0
  u8 P = 0
  u8 Q = 0
  P = PX[A]
  Q = PX[B]
  if P >= Q then
    D = P - Q
  else
    D = Q - P
  end if
  W = HalfW[A] + HalfW[B]
  if D >= W then return 0
  P = PY[A]
  Q = PY[B]
  if P >= Q then
    D = P - Q
  else
    D = Q - P
  end if
  W = HalfH[A] + HalfH[B]
  if D >= W then return 0
  return 1

' clamp a speed the C64's way: above 64 is 64, below -64 is -64
function Cap(i16 S) as i8
  if S > 64 then return 64
  if S < -64 then return -64
  return S

' a shot kicks a ship: half the shot's speed is added
sub Kick(u8 S, u8 T):
  i16 A = 0
  A = O[S].Vx
  A = A >> 1
  A = A + O[T].Vx
  O[T].Vx = Cap(A)
  A = O[S].Vy
  A = A >> 1
  A = A + O[T].Vy
  O[T].Vy = Cap(A)
  return
end sub

' A pushes rock R: 1/16 of A's speed is added to the rock's
sub Push(u8 A, u8 R):
  i16 P = 0
  P = O[A].Vx
  P = P >> 4
  P = P + O[R].Vx
  O[R].Vx = Cap(P)
  P = O[A].Vy
  P = P >> 4
  P = P + O[R].Vy
  O[R].Vy = Cap(P)
  return
end sub

' ship P hit a rock: it bursts and the other player scores 20
sub Crash(u8 P):
  Crashed = P
  Boom = BoomLen
  Blink = 0
  inc Crashes
  if P = 0 then
    AddScore(1, 20)
  else
    AddScore(0, 20)
  end if
  ShotOn[0] = 0
  ShotOn[1] = 0
  play sound SndBoom
  return
end sub

sub AddScore(u8 P, u16 N):
  u16 S = 0
  S = Score[P]
  if S < 63000 then S = S + N
  Score[P] = S
  ShowScores
  return
end sub

' every live object a step; a speed of 3 or more moves, and a wall turns
' it back
sub MoveAll:
  for Mi = 0 to 7
    MoveOne
  next
  return
end sub

sub MoveOne:
  if Mi >= 6 then
    if Mi = 6 then
      if ShotOn[0] = 0 then return
    else
      if ShotOn[1] = 0 then return
    end if
  end if
  Vt = O[Mi].Vx
  if Vt >= 3 then
    Pt = O[Mi].X + Vt
    O[Mi].X = Pt
    Lim = HiX[Mi]
    if Pt >= Lim then O[Mi].Vx = -O[Mi].Vx
    W16 = Pt << 2
    PX[Mi] = highbyte W16
  else
    if Vt <= -3 then
      Pt = O[Mi].X + Vt
      O[Mi].X = Pt
      Lim = LoX[Mi]
      if Pt < Lim then O[Mi].Vx = -O[Mi].Vx
      W16 = Pt << 2
      PX[Mi] = highbyte W16
    end if
  end if
  Vt = O[Mi].Vy
  if Vt >= 3 then
    Pt = O[Mi].Y + Vt
    O[Mi].Y = Pt
    Lim = HiY[Mi]
    if Pt >= Lim then O[Mi].Vy = -O[Mi].Vy
    W16 = Pt << 2
    PY[Mi] = highbyte W16
  else
    if Vt <= -3 then
      Pt = O[Mi].Y + Vt
      O[Mi].Y = Pt
      Lim = LoY[Mi]
      if Pt < Lim then O[Mi].Vy = -O[Mi].Vy
      W16 = Pt << 2
      PY[Mi] = highbyte W16
    end if
  end if
  return
end sub

' the stick, every 7 ticks: left (first) or right turns, up thrusts; a
' thrust that would pass 64 is not taken
sub Steer(u8 P, u8 Pad):
  u8 D = 0
  i16 N = 0
  D = Dir[P]
  if (Pad & 4) > 0 then
    D = (D - 1) & 15
  else
    if (Pad & 8) > 0 then D = (D + 1) & 15
  end if
  Dir[P] = D
  if (Pad & 1) = 0 then return
  E8 = DirY[D + 4]
  N = E8 + O[P].Vx
  if N >= -64 then
    if N <= 64 then O[P].Vx = N
  end if
  E8 = DirY[D]
  N = E8 + O[P].Vy
  if N >= -64 then
    if N <= 64 then O[P].Vy = N
  end if
  if ThrustT = 0 then
    play sound SndThrust
    ThrustT = 1
  end if
  return
end sub

' a player's shot clock: when it has run out the shot is gone and the
' button fires a new one from the ship's middle at 16 x the heading
sub ShotClock(u8 P, u8 Pad):
  u8 S = 0
  i16 N = 0
  S = P + 6
  if ShotT[P] = 0 then
    ShotOn[P] = 0
    if (Pad & 16) = 0 then return
    if Boom > 0 then return
    O[S].X = O[P].X
    O[S].Y = O[P].Y
    PX[S] = PX[P]
    PY[S] = PY[P]
    E8 = DirY[Dir[P] + 4]
    N = E8
    O[S].Vx = N << 4
    E8 = DirY[Dir[P]]
    N = E8
    O[S].Vy = N << 4
    ShotOn[P] = 1
    ShotT[P] = ShotLen
    play sound SndShot
  end if
  dec ShotT[P]
  return
end sub

' everything back to the start (after a burst, and for a new game)
sub ResetField:
  for Ri = 0 to 7
    PX[Ri] = StartX[Ri]
    Pt = StartX[Ri]
    O[Ri].X = Pt << 6
    PY[Ri] = StartY[Ri]
    Pt = StartY[Ri]
    O[Ri].Y = Pt << 6
    O[Ri].Vx = 0
    O[Ri].Vy = 0
  next
  Dir[0] = 4
  Dir[1] = 12
  ShotT[0] = 0
  ShotT[1] = 0
  ShotOn[0] = 0
  ShotOn[1] = 0
  Boom = 0
  RotT = 1
  BarShow
  return
end sub

' ---------------------------------------------------------------------------
' the computer (green): every 5 frames it looks at the field and sets its
' stick; it brakes when its drift heads for a rock or gets fast, else it
' turns toward the blue ship, fires when lined up and closes in slowly
function DirTo(i16 Dx, i16 Dy) as u8
  i16 Ax = 0
  i16 Ay = 0
  u8 A = 0
  Ax = Dx
  if Ax < 0 then Ax = -Ax
  Ay = Dy
  if Ay < 0 then Ay = -Ay
  if Ax * 5 > Ay then A = 1
  if Ax * 3 > Ay * 2 then A = 2
  if Ax * 2 > Ay * 3 then A = 3
  if Ax > Ay * 5 then A = 4
  if Dx >= 0 then
    if Dy < 0 then return A
    return 8 - A
  end if
  if Dy >= 0 then return 8 + A
  return (16 - A) & 15

sub AiThink:
  i16 Mx = 0
  i16 My = 0
  i16 Fx = 0
  i16 Fy = 0
  i16 Ux = 0
  i16 Uy = 0
  i16 Dd = 0
  i16 Spd = 0
  u8 Want = 0
  u8 Diff = 0
  u8 Danger = 0
  u8 Pad = 0
  u8 Lane = 0
  u8 Near = 0
  u8 Kd = 0
  u8 Home = 0
  i16 Nx = 0
  i16 Ny = 0
  i16 Rx = 0
  i16 Ry = 0
  i16 Hx = 0
  i16 Hy = 0
  Mx = PX[1]
  My = PY[1]
  Ux = O[1].Vx
  Uy = O[1].Vy
  ' where the drift takes it in 96 ticks (time to turn about and brake)
  Kd = AiLook[Sp - 1]
  Fx = Ux * Kd
  Fx = Fx >> 6
  Fx = Fx + Mx
  Fy = Uy * Kd
  Fy = Fy >> 6
  Fy = Fy + My
  Nx = AiNearX[Sp - 1]
  Ny = AiNearY[Sp - 1]
  Spd = abs(Ux) + abs(Uy)
  Hx = (Fx + Mx) >> 1
  Hy = (Fy + My) >> 1
  for Ti = 2 to 5
    Rx = PX[Ti]
    Ry = PY[Ti]
    Dd = abs(Rx - Fx)
    if Dd < 26 then
      Dd = abs(Ry - Fy)
      if Dd < 24 then Danger = 1
    end if
    ' already close: remember the nearest such rock to flee from
    Dd = abs(Rx - Mx)
    if Dd < Nx then
      Dd = abs(Ry - My)
      if Dd < Ny then Near = Ti
    end if
    ' and halfway there
    Dd = abs(Rx - Hx)
    if Dd < 24 then
      Dd = abs(Ry - Hy)
      if Dd < 22 then Danger = 1
    end if
  next
  Kd = AiFast[Sp - 1]
  if Spd > Kd then Danger = 1
  if Near > 0 then
    ' beside a rock: head straight away from it
    Danger = 1
    Fx = Mx - PX[Near]
    Fx = Fx - (Ux >> 1)
    Fy = My - PY[Near]
    Fy = Fy - (Uy >> 1)
    Want = DirTo(Fx, Fy)
  else
    if Danger = 1 then Want = DirTo(-Ux, -Uy)
  end if
  if Danger = 0 then
    Fx = PX[0] - Mx
    Fy = PY[0] - My
    ' lead the blue ship: where its drift takes it while the shot flies
    ' (a shot covers about 1.5 pixels a tick: the drift x distance / 128)
    Dd = abs(Fx) + abs(Fy)
    Kd = Dd >> 5
    Ux = O[0].Vx
    Ux = Ux * Kd
    Ux = Ux >> 2
    Uy = O[0].Vy
    Uy = Uy * Kd
    Uy = Uy >> 2
    Want = DirTo(Fx + Ux, Fy + Uy)
    ' it keeps to its own side, right of the rocks: back home when
    ' pushed over
    if Mx < 168 then
      Home = 1
      Want = DirTo(200 - Mx, 100 - My)
    end if
    ' a fast blue ship on its own row: step out of its lane first
    Dd = abs(O[0].Vx) + abs(O[0].Vy)
    if Dd > 40 then
      if abs(Fy) < 14 then
       if Home = 0 then
        Lane = 1
        if My < 100 then
          Want = 0
        else
          Want = 8
        end if
       end if
      end if
    end if
  end if
  Diff = (Want - Dir[1]) & 15
  if Danger = 1 then
    if Diff <= 1 then Pad = 1
    if Diff >= 15 then Pad = 1
  end if
  if Diff = 0 then
    if Danger = 1 then
      Pad = 1
    else
      Dd = abs(Fx) + abs(Fy)
      if Lane = 1 then
        Uy = O[1].Vy
        if abs(Uy) < 24 then Pad = 1
      else
        if Home = 1 then
          if Spd < 16 then Pad = 1
        else
          if Dd > 100 then
            if Mx > 190 then
              if Spd < 16 then Pad = 1
            end if
          end if
        end if
      end if
    end if
  else
    if Diff < 8 then
      Pad = Pad | 8
    else
      Pad = Pad | 4
    end if
  end if
  ' it fires only when lined up exactly and within 180 pixels
  if Danger = 0 then
    if Lane + Home = 0 then
      if Diff = 0 then
        Dd = abs(Fx) + abs(Fy)
        Kd = AiRange[Sp - 1]
        if Dd < Kd then Pad = Pad | 16
      end if
    end if
  end if
  AiPad = Pad
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 blue ship, 1 green ship, 2 blue shot, 3 green shot, 4-7 rocks
sub DrawSprites:
  for Si = 0 to 1
    DrawShip
  next
  for Si = 0 to 1
    J = Si + 6
    K = Si + 2
    if ShotOn[Si] = 1 then
      ObjXY
      if Si = 0 then
        set sprite K to Y8,X8,SShot,5
      else
        set sprite K to Y8,X8,SShot,3
      end if
    else
      set sprite K to 192,0,0,0
    end if
  next
  for Si = 2 to 5
    J = Si
    K = Si + 2
    ObjXY
    set sprite K to Y8,X8,SRock,14
  next
  update sprites
  return
end sub

' the top-left corner of object J's sprite (Y one less, as the VDP wants)
sub ObjXY:
  X8 = PX[J] - 8
  Y8 = PY[J] - 9
  return
end sub

sub DrawShip:
  J = Si
  ObjXY
  if Boom > 0 then
    if Crashed = Si then
      if Boom > 70 then
        set sprite Si to Y8,X8,SBur0,11
      else
        if Boom > 40 then
          set sprite Si to Y8,X8,SBur1,9
        else
          set sprite Si to 192,0,0,0
        end if
      end if
      return
    end if
  end if
  K = Dir[Si] * 4
  if Si = 0 then
    set sprite 0 to Y8,X8,K,5
  else
    set sprite 1 to Y8,X8,K,3
  end if
  return
end sub

' ---------------------------------------------------------------------------
sub ShowScores:
  NumU = Score[0]
  print at 2,1, digits$(NumU, 5)
  NumU = Score[1]
  print at 25,1, digits$(NumU, 5)
  return
end sub

sub ShowClock:
  u16 M = 0
  u16 S = 0
  M = SecLeft / 60
  S = SecLeft - M * 60
  print at 14,1, digits$(M, 1), ":", digits$(S, 2)
  return
end sub

' the two bars; the crashed player's bar blinks during the burst's last part
sub BarShow:
  C = TBarb
  K = TBarg
  if Boom > 0 then
    if Boom < BoomQuiet then
      if Blink >= 12 then
        if Crashed = 0 then
          C = 32
        else
          K = 32
        end if
      end if
    end if
  end if
  fill C count 5 at 8,1
  fill K count 5 at 19,1
  return
end sub

sub NewGame:
  NewScreen
  copy ArenaMap count 768 to vram.name
  Score[0] = 0
  Score[1] = 0
  Over = 0
  Hits = 0
  Crashes = 0
  Acc = 0
  AiT = 0
  AiPad = 0
  SecLeft = Mins * 60
  SecF = 0
  ResetField
  ShowScores
  NumU = SecLeft
  ShowClock
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  if ThrustT > 0 then
    inc ThrustT
    if ThrustT > 6 then ThrustT = 0
  end if
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  JM = J1 | J2
  if Players = 1 then J1 = JM
  Btn = JM & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SPACE ARENA in blocks, the options menu, the tune once
sub TitlePage:
  NewScreen
  print at 2,1, "COMPUTE!'S GAZETTE JAN 1986"
  copy TitleMap count 352 to vram.name + 96
  print at 8,15, "PLAYERS"
  print at 8,16, "SPEED"
  print at 8,17, "TIME"
  print at 8,18, "START"
  print at 8,19, "HOW TO PLAY"
  print at 8,20, "CREDITS"
  print at 3,22, "STICK: CHOOSE  BUTTON: GO"
  if Menu > 5 then Menu = 3
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Menu = 3
  ShowMenu
tp_loop:
  Frame1
  ReadPad
  TitleAnim
  V = JM & 15
  if V > 0 then
    if WasStick = 0 then
      MenuMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 5 then
    CreditsPage
  end if
  return
end sub

sub MenuMove:
  select case V
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 5 then inc Menu
    case 4
      Change(255)
    case 8
      Change(1)
  end select
  ShowMenu
  return
end sub

' left or right on an option line
sub Change(u8 D):
  select case Menu
    case 0
      Players = 3 - Players
    case 1
      Sp = Sp + D
      if Sp = 0 then Sp = 3
      if Sp = 4 then Sp = 1
    case 2
      Mins = Mins + D
      if Mins = 0 then Mins = 5
      if Mins = 6 then Mins = 1
  end select
  return
end sub

sub ShowMenu:
  for Li = 15 to 20
    put char 32 at 6,Li
  next
  J = Menu + 15
  put char 62 at 6,J
  NumU = Players
  print at 17,15, digits$(NumU, 1)
  NumU = Sp
  print at 17,16, digits$(NumU, 1)
  NumU = Mins
  print at 17,17, digits$(NumU, 1), ":00"
  if Players = 1 then
    print at 19,15, "VS CPU"
  else
    print at 19,15, "      "
  end if
  return
end sub

' the two ships slowly turn beside the title
sub TitleAnim:
  K = Tick >> 3
  K = K & 15
  K = K * 4
  set sprite 0 to 47,32,K,5
  K = 15 - (Tick >> 3)
  K = K & 15
  K = K * 4
  set sprite 1 to 95,208,K,3
  update sprites
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "TWO SPACESHIPS FIGHT IN A"
    print at 2,4, "BOX WITH FOUR ROCKS IN THE"
    print at 2,5, "MIDDLE. HIT THE OTHER SHIP"
    print at 2,6, "WITH YOUR SHOTS TO SCORE."
    print at 2,8, "ONE PLAYER: YOU FLY THE"
    print at 2,9, "BLUE SHIP, THE COMPUTER"
    print at 2,10, "FLIES THE GREEN ONE."
    print at 2,11, "TWO PLAYERS: CONTROLLER 1"
    print at 2,12, "IS BLUE, CONTROLLER 2 GREEN."
    set sprite 0 to 135,40,16,5
    set sprite 2 to 135,76,SShot,5
    set sprite 4 to 135,120,SRock,14
    set sprite 1 to 135,190,48,3
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK LEFT/RIGHT: TURN."
    print at 2,4, "STICK UP: ROCKET FORWARD."
    print at 2,5, "BUTTON: FIRE A SHOT."
    print at 2,7, "THERE IS NO BRAKE! YOUR SHIP"
    print at 2,8, "KEEPS DRIFTING. TURN AROUND"
    print at 2,9, "AND PUSH TO SLOW DOWN."
    print at 2,11, "YOU HAVE ONE SHOT AT A TIME."
    print at 2,12, "IT BOUNCES OFF THE WALLS."
    for K = 0 to 3
      J = K * 16
      X8 = K * 40
      X8 = X8 + 48
      set sprite K to 135,X8,J,5
    next
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "YOUR SHOT HITS THE OTHER"
    print at 2,4, "SHIP: 1 POINT."
    print at 2,5, "THE OTHER SHIP CRASHES INTO"
    print at 2,6, "A ROCK: 20 POINTS FOR YOU!"
    print at 2,8, "WHEN THE TIME IS UP, THE"
    print at 2,9, "HIGHER SCORE WINS. CHOOSE"
    print at 2,10, "SPEED AND TIME ON THE TITLE."
    print at 2,12, "TIP: STAY AWAY FROM THE"
    print at 2,13, "ROCKS AND GO SLOWLY."
    set sprite 0 to 135,80,SBur0,11
    set sprite 4 to 135,120,SRock,14
    set sprite 1 to 135,170,0,3
  end select
  print at 8,21, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "SPACE ARENA"
  print at 2,5, "BASED ON SPACE ARENA BY"
  print at 2,6, "BRYAN FILES, COMPUTE!'S"
  print at 2,7, "GAZETTE JANUARY 1986"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: DUEL IN THE VOID"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
