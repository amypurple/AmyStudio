u8 Players = 1
u8 Sp = 1
u8 Mins = 2
u8 Acc = 0
u8 RotT = 7
' a crash: the burst's tick count, which ship, the bar's blink
u8 Boom = 0
u8 Crashed = 0
u8 Blink = 0
u8 Over = 0
u8 Hits = 0
u8 Crashes = 0
u8 ThrustT = 0
' the computer's controls and its thinking clock
u8 AiPad = 0
u8 AiT = 0
' input: 1 up, 2 down, 4 left, 8 right, 16 button
u8 J1 = 0
u8 J2 = 0
u8 JM = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Pg = 0
