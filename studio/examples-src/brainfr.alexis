cartridge "BRAINFRAME/NORM VOGEL/1985"

' BRAINFRAME
' A ColecoVision game based on "Brainframe" by Norm Vogel, Ahoy! July 1985
' (Commodore 64 BASIC, disk ahoy1985-07; author from the listing's title
' screen). Made for Amy Studio by Claude (an AI made by Anthropic), 2026,
' in Amy by Amy Bienvenu.
'
' The game: the computer picks a secret number of 3, 4 or 5 digits (you
' choose), each digit 0-9, digits may repeat. You have 15 tries. After
' each try it tells you how many digits are right and in the right place
' (HIT) and how many are right but in the wrong place (NEAR). Break the
' number to win. Give up at any time to see the answer.
'
' From the original (orig/brainframe.bas): the rules above; the scoring
' (lines 580-630: places first, then each remaining digit of the try
' matched once against the remaining secret digits); the read-out of a
' try, one tone a digit rising with the digit; the remarks during play
' (lines 660-710, in the same order: try 10 of a 3-digit game "YOU HAVEN'T
' GOT IT YET?!", the fourth try with all but one digit placed "GOING FOR
' BROKE, EH?" (once), the first try holding every digit "YOU'VE GOT 'EM
' ALL NOW!", try 14 "THIS IS YOUR LAST CHANCE!", try 15 missed "GOOD
' GUESS, BUT THE ANSWER WAS"); the verdicts on a win by tries (no more
' tries than digits: give-ups wiped to 0 and no longer counted until the
' size changes; up to 2 more: "I'LL HAVE TO GIVE YOU A HARDER ONE"; up to
' 5 more: "NOT BAD"; else "A LOT MORE PRACTICE"); the statistics: wins by
' number of tries (1-15), total games and give-ups, kept until the number
' of digits is changed; the title's frame opening out and the name
' appearing letter by letter with rising tones.
'
' Liberties: joystick entry instead of typing: a cursor glides over the
' cells, up/down turn the digit, left/right move, the left button sends
' the try (a new try starts as a copy of the last one, so 'R' to redo the
' line is not needed: any cell can be changed before sending). Giving up
' ('E') is the right button, confirmed by a second press. The secret and
' the statistics are shown on a result page, then back to the title (no
' Y/N/I question: the size is chosen on the title, as 'I' did). The C64
' flashed the border at each digit; here each cell lights in turn as it
' is read. Remarks stay on the message line until the next try. The
' digit cells, title letters and console frame are original drawings.
'
' Controls: either controller. Title: up/down choose, left/right change
' the number of digits, a button starts. Play: stick up/down turns the
' digit under the cursor, left/right moves the cursor; left button sends
' the try; right button gives up (press it again to confirm, left button
' to go on).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' screens drawn with the NMI off after a wait, display off; music first in
' the sound table, the title tune played once; `set sprite count` always
' given; own xorshift random numbers; nothing flashes.

const TD0 = 128
const TD1 = 129
const TD2 = 130
const TD3 = 131
const TD4 = 132
const TD5 = 133
const TD6 = 134
const TD7 = 135
const TD8 = 136
const TD9 = 137
const TA0 = 138
const TA1 = 139
const TA2 = 140
const TA3 = 141
const TA4 = 142
const TA5 = 143
const TA6 = 144
const TA7 = 145
const TA8 = 146
const TA9 = 147
const TL0 = 148
const TL1 = 149
const TL2 = 150
const TL3 = 151
const TL4 = 152
const TL5 = 153
const TL6 = 154
const TL7 = 155
const TL8 = 156
const TL9 = 157
const TSlot = 158
const TH0 = 159
const TH1 = 160
const TH2 = 161
const TH3 = 162
const TH4 = 163
const TH5 = 164
const TM0 = 165
const TM1 = 166
const TM2 = 167
const TM3 = 168
const TM4 = 169
const TM5 = 170
const TIhit = 171
const TInear = 172
const TFtl = 173
const TFtr = 174
const TFbl = 175
const TFbr = 176
const TFt = 177
const TFb = 178
const TFl = 179
const TFr = 180
const TTrace = 181
const TNode = 182
const TLb00 = 183
const TLb01 = 184
const TLb10 = 185
const TLb11 = 186
const TLr00 = 187
const TLr01 = 188
const TLr10 = 189
const TLr11 = 190
const TLa00 = 191
const TLa01 = 192
const TLa10 = 193
const TLa11 = 194
const TLi00 = 195
const TLi01 = 196
const TLi10 = 197
const TLi11 = 198
const TLn00 = 199
const TLn01 = 200
const TLn10 = 201
const TLn11 = 202
const TLf00 = 203
const TLf01 = 204
const TLf10 = 205
const TLf11 = 206
const TLm00 = 207
const TLm01 = 208
const TLm10 = 209
const TLm11 = 210
const TLe00 = 211
const TLe01 = 212
const TLe10 = 213
const TLe11 = 214
const SCur = 0
const NTiles8 = 696
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndMove = 4
const SndD0 = 5
const SndD1 = 6
const SndD2 = 7
const SndD3 = 8
const SndD4 = 9
const SndD5 = 10
const SndD6 = 11
const SndD7 = 12
const SndD8 = 13
const SndD9 = 14
const SndLetter = 15
const SndRazz = 16
const SndBell = 17
const SndWarn = 18
const SndWin = 19
const SndLose = 20
const SndStart = 21
const NSpr = 4
const DigC = 8
const HitC = 21
const NearC = 25
const Row0 = 4
const ReadN = 12
const MaxTry = 15

' one try on the board
record TryRec:
  u8 D[5]
  u8 Hit
  u8 Near
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 NumU = 0
u16 SprX = 0
u16 SprY = 0
u16 TgX = 0
u16 TgY = 0
i16 Dlt = 0
TryRec Hist[15]
u8 Sec[5]
u8 Gs[5]
u8 Sw[5]
u8 Gw[5]
u8 Wins[16]
bcd digits 3 TotG = 0
bcd digits 3 GiveUps = 0
u8 Gf = 0
u8 OldNd = 0
u8 Nd = 4
u8 NdM1 = 3
u8 Tn = 1
u8 Cur = 0
u8 Hit = 0
u8 Near = 0
u8 Yg = 0
u8 Tw = 0
' result: 1 broken, 2 out of tries, 3 gave up
u8 Res = 0
' 0 boot, 1 title, 2 waiting for a try, 3 busy, 4 result page
u8 GState = 0
u8 Menu = 0
u8 Rep = 0
u8 LastDir = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press1 = 0
u8 Press2 = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Ri = 0
u8 Mi = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame
  PlayGame
  ResultPage
  ' a press goes back to the title; left alone, the screen sleeps after
  ' 30 seconds to spare the TV, and a press wakes it
  GState = 4
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: 16-bit xorshift (7, 9, 8)

sub Rand:
  NumU = Rs << 7
  Rs = Rs ^ NumU
  NumU = Rs >> 9
  Rs = Rs ^ NumU
  NumU = Rs << 8
  Rs = Rs ^ NumU
  return
end sub

' a digit 0-9, evenly: draw 4 bits until one is below 10
function Rnd10 as u8
  u8 R4 = 15
  while R4 >= 10
    Rand
    R4 = Rs & 15
  end while
  return R4

' ---------------------------------------------------------------------------
' scoring, as the listing's lines 580-630

function CountHits as u8
  u8 Hc = 0
  u8 Ix = 0
  for Ix = 0 to NdM1
    Sw[Ix] = Sec[Ix]
    Gw[Ix] = Gs[Ix]
    if Gw[Ix] = Sw[Ix] then
      inc Hc
      Gw[Ix] = 98
      Sw[Ix] = 99
    end if
  next
  return Hc

function CountNear as u8
  u8 Nc = 0
  u8 Ia = 0
  u8 Ib = 0
  for Ia = 0 to NdM1
    for Ib = 0 to NdM1
      if Gw[Ia] = Sw[Ib] then
        inc Nc
        Gw[Ia] = 98
        Sw[Ib] = 99
      end if
    next
  next
  return Nc

' ---------------------------------------------------------------------------
' a new game: the secret, the statistics (cleared when the size changed)

sub NewGame:
  if Nd <> OldNd then
    Gf = 0
    TotG = 0
    GiveUps = 0
    fill array Wins with 0
    OldNd = Nd
  end if
  inc TotG
  NdM1 = Nd - 1
  PickSecret
  Tn = 1
  Cur = 0
  Yg = 0
  Tw = 0
  Res = 0
  fill array Gs with 0
  DrawBoard
  return
end sub

sub PickSecret:
  for Li = 0 to NdM1
    Sec[Li] = Rnd10
  next
  return
end sub

' ---------------------------------------------------------------------------
' play: set a try with the cursor, send it, read it out, score it

sub PlayGame:
  play sound SndStart
  while Res = 0
    DrawTryRow
    GetTry
    if Res = 0 then
      ReadOut
      Judge
    end if
  end while
  HideSprites
  return
end sub

' the try being set, in the yellow look
sub DrawTryRow:
  Y = Row0 + Tn
  NumU = Tn
  print at 3,Y, digits$(NumU, 2)
  for Li = 0 to NdM1
    X = DigC + Li * 2
    put char TA0 + Gs[Li] at X,Y
  next
  TgY = Y * 8
  TgY = TgY - 5
  return
end sub

' the stick and buttons until a try is sent (or the game is given up)
sub GetTry:
  GState = 2
  Rep = 0
  LastDir = 0
  SyncPad
gt_loop:
  Frame1
  ReadPad
  Glide
  if Press2 = 1 then
    AskGiveUp
    if Res = 3 then goto gt_done
  end if
  if Press1 = 1 then goto gt_done
  K = StickDir
  select case K
  case 1
    V = Gs[Cur] + 1
    if V > 9 then V = 0
    Gs[Cur] = V
    PutCur
    play sound SndClick
  case 2
    V = Gs[Cur]
    if V = 0 then
      V = 9
    else
      dec V
    end if
    Gs[Cur] = V
    PutCur
    play sound SndClick
  case 3
    if Cur > 0 then
      dec Cur
      play sound SndMove
    end if
  case 4
    if Cur < NdM1 then
      inc Cur
      play sound SndMove
    end if
  end select
  goto gt_loop
gt_done:
  GState = 3
  return
end sub

sub PutCur:
  Y = Row0 + Tn
  X = DigC + Cur * 2
  put char TA0 + Gs[Cur] at X,Y
  return
end sub

' stick direction with auto-repeat: 1 up, 2 down, 3 left, 4 right; a held
' stick repeats after 14 frames, then every 6
function StickDir as u8
  u8 Sd = 0
  u8 Out = 0
  V = J1 | J2
  if V & 1 then
    Sd = 1
  elseif V & 2 then
    Sd = 2
  elseif V & 4 then
    Sd = 3
  elseif V & 8 then
    Sd = 4
  end if
  if Sd = 0 then
    Rep = 0
  elseif Sd <> LastDir then
    Out = Sd
    Rep = 14
  else
    dec Rep
    if Rep = 0 then
      Out = Sd
      Rep = 6
    end if
  end if
  LastDir = Sd
  return Out

' the cursor glides to its cell (4 pixels a frame)
sub Glide:
  TgX = DigC * 8 - 4
  NumU = Cur * 16
  TgX = TgX + NumU
  Dlt = TgX - SprX
  if Dlt > 4 then
    Dlt = 4
  elseif Dlt < -4 then
    Dlt = -4
  end if
  SprX = SprX + Dlt
  Dlt = TgY - SprY
  if Dlt > 4 then
    Dlt = 4
  elseif Dlt < -4 then
    Dlt = -4
  end if
  SprY = SprY + Dlt
  X = SprX
  Y = SprY
  set sprite 0 to Y,X,SCur,15
  update sprites
  return
end sub

sub AskGiveUp:
  ClearMsg
  print at 2,21, "GIVE UP? RIGHT BUTTON: YES"
  print at 2,22, "LEFT BUTTON: KEEP TRYING"
  play sound SndWarn
ag_loop:
  Frame1
  ReadPad
  if Press1 = 1 then goto ag_no
  if Press2 = 1 then goto ag_yes
  goto ag_loop
ag_yes:
  Res = 3
  return
ag_no:
  ClearMsg
  ShowHelp
  SyncPad
  return
end sub

' each cell lights in turn with its tone, then takes the old-try look
sub ReadOut:
  hide sprite 0
  update sprites
  ClearMsg
  Y = Row0 + Tn
  for Ri = 0 to NdM1
    X = DigC + Ri * 2
    D = Gs[Ri]
    put char TL0 + D at X,Y
    play sound SndD0 + D
    for Mi = 1 to ReadN
      Frame1
    next
    put char TD0 + D at X,Y
  next
  return
end sub

sub Judge:
  Hit = CountHits
  Near = CountNear
  Mi = Tn - 1
  StoreTry
  Hist[Mi].Hit = Hit
  Hist[Mi].Near = Near
  if Hit = NdM1 then inc Tw
  DrawFeedback(Mi)
  if Hit = Nd then
    Res = 1
    play sound SndWin
    Pause(60)
    return
  end if
  ' the remarks, in the listing's order
  if Nd = 3 then
    if Tn = 10 then
      Remark(4)
    end if
  end if
  if Tw = 4 then
    Remark(2)
    Tw = 99
  end if
  if Yg = 0 then
    V = Hit + Near
    if V = Nd then
      Remark(1)
      Yg = 1
    end if
  end if
  if Tn = 14 then
    Remark(3)
  end if
  if Tn = MaxTry then
    Res = 2
    Remark(5)
    play sound SndLose
    Pause(120)
  else
    inc Tn
    ShowHelp
  end if
  return
end sub

' (its own sub: a variable-end FOR and an early return must not share one)
sub StoreTry:
  for Li = 0 to NdM1
    Hist[Mi].D[Li] = Gs[Li]
  next
  return
end sub

' a try's figures from the record (the row is already drawn)
sub DrawFeedback(u8 Ix):
  u8 Fy = 0
  u8 Fh = 0
  u8 Fn = 0
  Fy = Row0 + 1 + Ix
  Fh = Hist[Ix].Hit
  Fn = Hist[Ix].Near
  put char TH0 + Fh at HitC,Fy
  put char TM0 + Fn at NearC,Fy
  return
end sub

sub Remark(u8 Which):
  ClearMsg
  select case Which
  case 1
    print at 4,21, "YOU'VE GOT 'EM ALL NOW!"
    play sound SndBell
  case 2
    print at 6,21, "GOING FOR BROKE, EH?"
    play sound SndRazz
  case 3
    print at 3,21, "THIS IS YOUR LAST CHANCE!"
    play sound SndWarn
  case 4
    print at 4,21, "YOU HAVEN'T GOT IT YET?!"
    play sound SndRazz
  case else
    print at 3,21, "GOOD GUESS, BUT THE ANSWER"
    print at 3,22, "WAS..."
  end select
  Pause(45)
  return
end sub

sub Pause(u8 Nf):
  for Mi = 1 to Nf
    Frame1
  next
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub ShowHelp:
  print at 2,22, "L BUTTON TRY, R GIVE UP"
  return
end sub

' ---------------------------------------------------------------------------
' the board: the console frame, headings, empty slots

sub DrawBoard:
  NewScreen
  print at 2,1, "BRAINFRAME"
  NumU = Nd
  print at 20,1, digits$(NumU, 1)
  print at 22,1, "DIGITS"
  DrawFrame(2, 2, 29, 20)
  print at 3,3, "TRY"
  print at 9,3, "GUESS"
  put char TIhit at HitC,3
  print at 19,3, "HIT"
  put char TInear at NearC,3
  print at 24,3, "NEAR"
  for Ri = 1 to MaxTry
    DrawSlots
  next
  ShowHelp
  SprX = DigC * 8 - 4
  SprY = (Row0 + 1) * 8 - 5
  TgY = SprY
  ShowScreen
  return
end sub

sub DrawSlots:
  Y = Row0 + Ri
  for Li = 0 to NdM1
    X = DigC + Li * 2
    put char TSlot at X,Y
  next
  return
end sub

' a frame of tiles from (L, T) to (R, B)
sub DrawFrame(u8 Fl, u8 Ft, u8 Fr, u8 Fb):
  u8 Fw = 0
  u8 Fi = 0
  Fw = Fr - Fl
  dec Fw
  put char TFtl at Fl,Ft
  put char TFtr at Fr,Ft
  put char TFbl at Fl,Fb
  put char TFbr at Fr,Fb
  fill TFt count Fw at Fl + 1,Ft
  fill TFb count Fw at Fl + 1,Fb
  for Fi = Ft + 1 to Fb - 1
    put char TFl at Fl,Fi
    put char TFr at Fr,Fi
  next
  return
end sub

' ---------------------------------------------------------------------------
' the result page: the secret, the verdict, the statistics

sub ResultPage:
  if Res = 1 then
    V = Tn
    if Wins[V] < 99 then inc Wins[V]
  end if
  if Res = 3 then
    if Gf = 1 then
      GiveUps = 0
    else
      inc GiveUps
    end if
  end if
  NewScreen
  DrawFrame(2, 1, 29, 22)
  select case Res
  case 1
    print at 9,3, "YOU WIN !!!"
    NumU = Tn
    print at 10,4, digits$(NumU, 2)
    if Tn = 1 then
      print at 13,4, "TRY"
    else
      print at 13,4, "TRIES"
    end if
  case 2
    print at 4,3, "OUT OF TRIES, I'M AFRAID"
  case else
    print at 5,3, "TRY AGAIN! YOU MIGHT"
    print at 5,4, "GET IT NEXT TIME!"
  end select
  print at 8,6, "THE ANSWER WAS:"
  ShowSecret
  if Res = 1 then Verdict
  print at 4,13, "TRIES 123456789012345"
  print at 4,15, "WON"
  ShowWins
  print at 4,18, "TOTAL GAMES:"
  print TotG at 17,18
  print at 4,19, "GIVE-UPS:"
  print GiveUps at 17,19
  print at 6,21, "PRESS A BUTTON"
  ShowScreen
  return
end sub

sub ShowSecret:
  for Li = 0 to NdM1
    X = 10 + Li * 2
    if Nd = 3 then X = X + 2
    put char TL0 + Sec[Li] at X,8
  next
  return
end sub

' the listing's verdicts (lines 790-840) by tries beyond the size
sub Verdict:
  u8 Ex = 0
  if Tn > Nd then Ex = Tn - Nd
  select case Ex
  case 0
    print at 4,10, "UNBELIEVABLE! GIVE-UPS"
    print at 4,11, "REDUCED TO 0!"
    GiveUps = 0
    Gf = 1
  case 1 to 2
    print at 3,10, "NEXT TIME, I'LL HAVE TO"
    print at 3,11, "GIVE YOU A HARDER ONE!"
  case 3 to 5
    print at 3,10, "NOT BAD, BUT YOU NEED"
    print at 3,11, "MORE PRACTICE!"
  case else
    print at 3,10, "YOU NEED A LOT MORE"
    print at 3,11, "PRACTICE! TRY AGAIN!"
  end select
  return
end sub

' wins by tries: tens on one row, units on the next (as the listing)
sub ShowWins:
  for Li = 1 to MaxTry
    V = Wins[Li]
    X = 9 + Li
    C = V / 10
    D = V - C * 10
    if C > 0 then put char 48 + C at X,14
    put char 48 + D at X,15
  next
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 48
  Press1 = 0
  Press2 = 0
  if Btn > 0 then
    if WasBtn = 0 then
      if Btn & 16 then
        Press1 = 1
      else
        Press2 = 1
      end if
    end if
  end if
  WasBtn = Btn
  return
end sub

' the buttons as they are now count as held: only a fresh press acts
' (a button still held from an earlier screen or read-out never counts
' twice, and the next press always counts)
sub SyncPad:
  ReadPad
  Press1 = 0
  Press2 = 0
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: the frame opens out, the name appears letter by letter with
' rising tones (as the C64's), then the menu and the tune once

data TitleL bytes
  TLb00, TLr00, TLa00, TLi00, TLn00, TLf00, TLr00, TLa00, TLm00, TLe00
end data

sub TitlePage:
tp_start:
  GState = 1
  NewScreen
  print at 9,21, "AHOY! JULY 1985"
  ShowScreen
  ' the frame opens out from the middle
  for Ri = 0 to 10
    Frame1
    Frame1
    X = 15 - Ri
    Y = 16 + Ri
    put char TFt at X,4
    put char TFt at Y,4
    put char TFb at X,8
    put char TFb at Y,8
  next
  put char TFtl at 4,4
  put char TFtr at 27,4
  put char TFbl at 4,8
  put char TFbr at 27,8
  for Ri = 5 to 7
    put char TFl at 4,Ri
    put char TFr at 27,Ri
  next
  ' the name, one letter every 10 frames
  for Li = 0 to 9
    C = TitleL[Li]
    X = 6 + Li * 2
    put char C at X,5
    put char C + 1 at X + 1,5
    put char C + 2 at X,6
    put char C + 3 at X + 1,6
    play sound SndLetter
    Pause(10)
  next
  print at 6,10, "AN EXERCISE IN LOGIC"
  print at 9,12, "BY NORM VOGEL"
  print at 9,15, "START GAME"
  print at 9,16, "DIGITS:"
  print at 9,17, "HOW TO PLAY"
  print at 9,18, "CREDITS"
  ShowMenu
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  SyncPad
  Rep = 0
  LastDir = 0
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  K = StickDir
  select case K
  case 1
    if Menu > 0 then dec Menu
    ShowMenu
    play sound SndMove
  case 2
    if Menu < 3 then inc Menu
    ShowMenu
    play sound SndMove
  case 3
    if Menu = 1 then
      if Nd > 3 then dec Nd
      ShowMenu
      play sound SndClick
    end if
  case 4
    if Menu = 1 then
      if Nd < 5 then inc Nd
      ShowMenu
      play sound SndClick
    end if
  end select
  V = Press1 | Press2
  if V = 0 then goto tp_loop
  if Menu = 2 then
    HowToPage
    goto tp_again
  end if
  if Menu = 3 then
    CreditsPage
    goto tp_again
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  NumU = Tick
  Rs = Rs ^ NumU
  if Rs = 0 then Rs = 1
  return
tp_again:
  goto tp_start
end sub

sub ShowMenu:
  for Ri = 15 to 18
    put char 32 at 7,Ri
  next
  Y = Menu + 15
  put char 62 at 7,Y
  print at 17,16, "< >"
  NumU = Nd
  print at 18,16, digits$(NumU, 1)
  return
end sub

sub HowToPage:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "I PICK A NUMBER OF 3, 4 OR 5"
  print at 2,4, "DIGITS (YOU CHOOSE), EACH"
  print at 2,5, "0-9. A DIGIT MAY BE USED"
  print at 2,6, "MORE THAN ONCE. BREAK IT IN"
  print at 2,7, "15 TRIES OR LESS."
  print at 2,9, "AFTER EACH TRY I SHOW:"
  put char TIhit at 2,11
  print at 4,11, "HIT: RIGHT DIGIT IN THE"
  print at 4,12, "RIGHT PLACE"
  put char TInear at 2,14
  print at 4,14, "NEAR: RIGHT DIGIT IN THE"
  print at 4,15, "WRONG PLACE"
  print at 2,17, "STICK UP/DOWN: TURN DIGIT"
  print at 2,18, "LEFT/RIGHT: MOVE  LEFT"
  print at 2,19, "BUTTON: TRY  RIGHT: GIVE UP"
  print at 8,22, "GOOD LUCK!"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "BRAINFRAME"
  print at 2,5, "BASED ON BRAINFRAME BY"
  print at 2,6, "NORM VOGEL, AHOY! JULY 1985"
  print at 2,7, "(COMMODORE 64), AFTER THE"
  print at 2,8, "OLD PENCIL GAME OF BULLS"
  print at 2,9, "AND COWS."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: THINKING CAP"
  print at 2,19, "(ORIGINAL)"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

