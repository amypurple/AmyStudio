asm {
; INTERNATIONAL BOUNTY HUNTER: the map window (Z80, called with the NMI off).
; The window is 28 tiles wide (columns 2-29) and DrawRows tiles high from
; row 1. Every window tile has its own code (Graphics II, R3 = $FF), its
; pattern is $F0 on all 8 rows and its colour bytes pick two map cells a
; row: rows 0-3 the map byte of the upper cell row, rows 4-7 the lower one
; (a byte holds the left and right cell colours). So one tile = 2 x 2
; cells of 4 x 4 pixels. VDP writes are 32 cycles apart (display on).
; Uses AF BC DE HL.

IbSetR3:
    ld bc,$03FF
    jp WRITE_REGISTER

; the window's patterns: $F0 everywhere
IbPatInit:
    ld a,(AMY_UVAR_DrawRows)
    ld b,a
    ld d,1
IbPiRow:
    ld a,16
    out (VDP_CTRL_PORT),a
    ld a,d
    or $40
    out (VDP_CTRL_PORT),a
    ld e,224
    ld a,$F0
IbPiLoop:
    out (VDP_DATA_PORT),a
    push af
    pop af
    dec e
    jr nz,IbPiLoop
    inc d
    djnz IbPiRow
    ret

; the window's colours from the map at tile ViewX, ViewY
IbDraw:
    ld a,(AMY_UVAR_ViewY)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    push hl
    add hl,hl
    add hl,hl
    pop bc
    add hl,bc
    add hl,de
    ld de,IbMap
    add hl,de
    ld a,(AMY_UVAR_ViewX)
    ld e,a
    ld d,0
    add hl,de
    ld a,(AMY_UVAR_DrawRows)
    ld b,a
    ld a,$21
IbDrRow:
    push bc
    push af
    ld c,a
    ld a,16
    out (VDP_CTRL_PORT),a
    ld a,c
    or $40
    out (VDP_CTRL_PORT),a
    push hl
    ld de,88
    ex de,hl
    add hl,de
    ex de,hl
    ld b,28
IbDrTile:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    ld a,(de)
    push af
    pop af
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    push af
    pop af
    out (VDP_DATA_PORT),a
    inc hl
    inc de
    djnz IbDrTile
    pop hl
    ld de,176
    add hl,de
    pop af
    inc a
    pop bc
    djnz IbDrRow
    ret

; the window's names: row r (1..DrawRows), column c (2..29) -> code
; (r mod 8) * 32 + c, so every window tile has its own pattern and colour
IbNames:
    ld a,(AMY_UVAR_DrawRows)
    ld b,a
    ld d,1
IbNmRow:
    ld a,d
    rrca
    rrca
    rrca
    ld l,a
    and $1F
    ld h,a
    ld a,l
    and $E0
    or 2
    ld l,a
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $58
    out (VDP_CTRL_PORT),a
    ld a,d
    and 7
    rrca
    rrca
    rrca
    or 2
    ld e,28
IbNmLoop:
    out (VDP_DATA_PORT),a
    push af
    pop af
    inc a
    dec e
    jr nz,IbNmLoop
    inc d
    djnz IbNmRow
    ret
; the world map: 94 rows x 88 bytes, a byte = two cells (TMS colours
; left << 4 | right), from the disk's IBH MAP DATA (art.py)
IbMap:
    db $11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$44,$BB,$44,$44,$44,$44,$44,$44,$44,$22,$22,$44,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$44,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11
    db $11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$BB,$BB,$BB,$BB,$BB,$22,$22,$22,$22,$22,$22,$22,$22,$24,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$46,$46,$46,$44,$44,$44,$44,$44,$46,$44,$44,$44,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$44,$44,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11
    db $11,$11,$11,$11,$11,$11,$11,$11,$11,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$4B,$B4
    db $4B,$44,$4B,$BB,$BB,$B4,$22,$22,$22,$22,$22,$22,$22,$22,$22,$24,$44,$44,$44,$44,$44,$44
    db $44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$64,$64,$44,$44,$44,$44,$44,$44,$44
