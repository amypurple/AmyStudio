    db $11,$11,$11,$11,$11,$11,$11,$11,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$BB,$B4,$B4
    db $BB,$4B,$4B,$BB,$B4,$44,$42,$22,$22,$22,$22,$22,$22,$22,$22,$24,$44,$44,$44,$4D,$DD,$DD
    db $44,$44,$44,$44,$44,$44,$44,$46,$66,$44,$44,$44,$44,$46,$46,$66,$66,$64,$44,$44,$44,$44
    db $66,$44,$64,$44,$44,$44,$44,$44,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11,$11
    db $11,$11,$11,$11,$11,$11,$11,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$44,$B4,$44,$44,$44
