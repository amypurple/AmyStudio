cartridge "INTERNATIONAL BOUNTY HUNTER/COMPUTE!'S GAZETTE/1990"

' INTERNATIONAL BOUNTY HUNTER
' A ColecoVision game based on "International Bounty Hunter", COMPUTE!'s
' Gazette disk, March 1990 (Commodore 128, BASIC 7.0 with machine code and
' a map file). The listing names no author (only the COMPUTE! Publications
' copyright).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: a political map of the world in 1990, 149 countries. A
' criminal hides in one of them; you start in another. Travel from country
' to neighbouring country (by land, or the listing's sea links) to reach
' the criminal's country. An arrow at the edge of the map points toward
' the criminal, and you see him when he is on your part of the map. Each
' turn he may slip away to one of his neighbours, and each of his moves
' takes $100 off the $10,000 bounty. Catch him and take him back to the
' country you started from before the time runs out (6 minutes at level 1
' down to 1 minute at level 6), or he escapes to a random country and the
' chase starts again.
'
' From the original (orig/ibh128.bas, orig/ibh map data.prg): the 149
' countries with their capitals, map positions and neighbour lists (DATA
' 1320-2800); the world map (the disk's 176 x 93 cell colour map); games
' with COUNTRIES or CAPITALS names (the player goes by the chosen kind of
' name; the current place shows both); levels 1-6: the criminal moves
' before each turn's capture check with chance 1 in 13 - 2 x level (line
' 230; at level 6 always), to a random neighbour, $100 off the bounty; the
' capture when you are in his country after his move (line 240); the time
' to take him home 6:00 - (level - 1) minutes (line 180); escape to a
' random country when it runs out (line 250); the edge arrow in eight
' directions toward him (lines 520-540) and his sprite when he is near
' (550); LOOK (free map scrolling with the stick, line 490); any command
' is a turn; the end texts (560-590).
'
' Liberties: no typing (the ColecoVision has no keyboard): the stick
' points at a neighbour, the right button steps through the neighbours,
' STAY (pass a turn, as a mistyped name did) and LOOK, the left button
' acts. The names of the neighbours are therefore shown (the listing's
' HELP gave one at random; it is dropped). The window is 56 x 32 cells
' (the C-128's 40 x 22) in 4 x 4 pixel cells; the trip slides the hunter
' toward the new capital before the map recentres. After the catch the
' arrow points home and home is marked (the listing showed nothing). The
' clock is checked every second (the listing noticed it at the next
' command), and the escaped criminal never lands in your own country.
' When the bounty reaches $0 the criminal gets away and the game ends
' (the listing went below zero for ever), so waiting in one place cannot
' win. Sierre Leone is spelt Sierra Leone, and the one-way Angola to
' Botswana link (no border) is dropped. Capitals and countries are the
' listing's of 1990 (README lists what changed since).
'
' Controls: either controller. Stick: point at a neighbour. Right
' button: next choice. Left button: go. LOOK: the stick scrolls, a button
' returns. On the title, up/down choose a line, left/right change it, a
' button starts.
'
' House rules: text in columns 2-29; tiles from code 128; music first in
' the sound table, the title tune once; screens drawn with the NMI off;
' `set sprite count` always given; own xorshift random numbers; nothing
' flashes.

const TRule = 128
const TDot = 129
const TUl = 130
const SHunter = 0
const SHunterl = 4
const SCrook = 8
const SCrookl = 12
const SCursor = 16
const SHouse = 20
const SArr0 = 24
const SArr1 = 28
const SArr2 = 32
const SArr3 = 36
const SArr4 = 40
const SArr5 = 44
const SArr6 = 48
const SArr7 = 52
const NTiles8 = 24
const SprBytes = 448
const NC = 149
const NNb = 578
const SndTuneA = 1
const SndTuneB = 2
const SndFly = 3
const SndStep = 4
const SndClick = 5
const SndFlee = 6
const SndGot = 7
const SndLost = 8
const SndWin = 9
const SndTick = 10
const NSpr = 7
const MapRows = 16
const MsgN = 180

u16 Rs = 1
u16 W16 = 0
u16 Bounty = 10000
u16 TimeLeft = 0
u16 Off16 = 0
' settings: names (0 countries, 1 capitals), level 1-6
u8 NameK = 0
u8 Level = 1
u8 Line = 0
' play
u8 Here = 1
u8 Home = 1
u8 Crook = 2
u8 Carry = 0
u8 Over = 0
u8 Turn = 0
u8 MR = 11
u8 Pick = 0
u8 NbCnt = 0
u8 NbBuf[16]
u8 ViewX = 0
u8 ViewY = 0
u8 DrawRows = 16
u8 HunX = 0
u8 HunY = 0
u8 TgX = 0
u8 TgY = 0
u8 Moving = 0
u8 Looking = 0
u8 LookT = 0
u8 SecT = 0
u8 MsgT = 0
u8 InPlay = 0
u8 TitleOn = 0
u8 Dest = 0
u8 Moves = 0
' input
u8 J1 = 0
u8 Btn1 = 0
u8 Btn2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 Press1 = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u16 TzLeft = 0
u8 TzOn = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Si = 0

  tile screen
  set sound table IbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the message, then back to the title on a press
  mute all
  ClearHud
  select case Over
  case 1
    print at 2,18, "YOU HAVE EARNED A BOUNTY OF"
    print at 2,19, "$"
    print Bounty at 3,19 width 5
    print at 2,20, "FOR BRINGING THIS CRIMINAL"
    print at 2,21, "TO JUSTICE. SINCERE THANKS"
    print at 2,22, "FROM"
    PutName(Home, 7, 22)
    play sound SndWin
  case else
    print at 2,19, "THE BOUNTY IS GONE."
    print at 2,20, "THE CRIMINAL GOT AWAY."
    print at 2,22, "HE WAS IN"
    PutName(Crook, 12, 22)
    play sound SndLost
  end select
  InPlay = 0
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then fill 32 count 28 at 2,22
  end if
  if Carry = 1 then Clock
  if Over > 0 then return
  if Looking = 1 then
    LookStep
    return
  end if
  if Moving = 1 then
    Glide
    if HunX = TgX then
      if HunY = TgY then Arrive
    end if
    return
  end if
  TakeInput
end sub

' the time to take him home, a second at a time
sub Clock:
  inc SecT
  if SecT < 60 then return
  SecT = 0
  if TimeLeft > 0 then dec TimeLeft
  ShowTime
  if TimeLeft < 11 then play sound SndTick
  if TimeLeft = 0 then Escape
end sub

' time is up: the criminal escapes to a random country (never yours)
sub Escape:
  u8 C = 0
  C = Here
  while C = Here
    C = RandN(NC) + 1
  end while
  Crook = C
  Carry = 0
  play sound SndFlee
  ShowHud
  Say(3)
end sub

sub TakeInput:
  u8 Old = 0
  Old = Pick
  V = J1 & 15
  if V > 0 then
    if V <> WasStick then PointAt(V)
  end if
  WasStick = V
  if Press2 = 1 then
    inc Pick
    if Pick > NbCnt + 1 then Pick = 0
  end if
  if Pick <> Old then
    ShowPick
    play sound SndClick
  end if
  if Press1 = 0 then return
  if Pick < NbCnt then
    Dest = NbBuf[Pick]
    TgX = PixX(Dest)
    TgY = PixY(Dest)
    Moving = 1
    play sound SndFly
  elseif Pick = NbCnt then
    play sound SndStep
    EndTurn
  else
    Looking = 1
    LookT = 0
    print at 2,22, "LOOK: STICK. BUTTON: BACK   "
    MsgT = 0
  end if
end sub

' the neighbour most in the stick's direction
sub PointAt(u8 Stk):
  i16 Sx = 0
  i16 Sy = 0
  i16 Dx = 0
  i16 Dy = 0
  i16 Sc = 0
  i16 Best = 0
  u8 I = 0
  u8 M = 0
  u16 Ln = 0
  if Stk & 4 then Sx = -1
  if Stk & 8 then Sx = 1
  if Stk & 1 then Sy = -1
  if Stk & 2 then Sy = 1
  for I = 1 to NbCnt
    M = NbBuf[I - 1]
    Dx = CX[M]
    Dx = Dx - CX[Here]
    Dy = CY[M]
    Dy = Dy - CY[Here]
    Ln = abs(Dx) + abs(Dy)
    if Ln = 0 then Ln = 1
    Sc = Dx * Sx + Dy * Sy
    Sc = Sc * 16
    Sc = Sc / Ln
    if Sc > Best then
      Best = Sc
      Pick = I - 1
    end if
  next
end sub

' LOOK: the stick scrolls the map a tile every 4 frames
sub LookStep:
  u8 Mv = 0
  if Press1 | Press2 then
    Looking = 0
    fill 32 count 28 at 2,22
    CentreOn(Here)
    IbRedraw
    EndTurn
    return
  end if
  inc LookT
  if LookT < 4 then return
  LookT = 0
  if J1 & 1 then
    if ViewY > 0 then
      dec ViewY
      Mv = 1
    end if
  end if
  if J1 & 2 then
    if ViewY < 31 then
      inc ViewY
      Mv = 1
    end if
  end if
  if J1 & 4 then
    if ViewX > 0 then
      dec ViewX
      Mv = 1
    end if
  end if
  if J1 & 8 then
    if ViewX < 60 then
      inc ViewX
      Mv = 1
    end if
  end if
  if Mv = 1 then IbRedraw
end sub

' the hunter glides 2 pixels a frame toward the next capital
sub Glide:
  if HunX < TgX then
    HunX = HunX + 2
    if HunX > TgX then HunX = TgX
  elseif HunX > TgX then
    HunX = HunX - 2
    if HunX < TgX then HunX = TgX
  end if
  if HunY < TgY then
    HunY = HunY + 2
    if HunY > TgY then HunY = TgY
  elseif HunY > TgY then
    HunY = HunY - 2
    if HunY < TgY then HunY = TgY
  end if
end sub

' the hunter reaches the next country
sub Arrive:
  Moving = 0
  Here = Dest
  inc Moves
  CentreOn(Here)
  IbRedraw
  EndTurn
end sub

' the end of a turn (the listing's lines 230-260)
sub EndTurn:
  u8 R = 0
  inc Turn
  if Carry = 0 then
    R = RandN(MR)
    if R = 0 then CrookMove
  end if
  if Over > 0 then return
  if Carry = 0 then
    if Here = Crook then
      Carry = 1
      W16 = 7 - Level
      TimeLeft = W16 * 60
      SecT = 0
      play sound SndGot
      Say(2)
    end if
  end if
  if Carry = 1 then
    if Here = Home then Over = 1
  end if
  LoadNb
  Pick = 0
  HunX = PixX(Here)
  HunY = PixY(Here)
  ShowHud
end sub

sub CrookMove:
  u8 N = 0
  u8 R = 0
  N = NbN[Crook]
  R = RandN(N)
  Crook = NbOf(Crook, R)
  if Bounty >= 100 then Bounty = Bounty - 100
  play sound SndFlee
  if Bounty = 0 then Over = 2
end sub

' the neighbour number Idx of country C
function NbOf(u8 C, u8 Idx) as u8
  u8 Res = 0
  u8 Tmp[1]
  Off16 = NbHi[C]
  Off16 = Off16 * 256 + NbLo[C] + Idx
  copy NbList + Off16 count 1 to Tmp
  Res = Tmp[0]
  return Res

' the neighbours of the hunter's country into NbBuf
sub LoadNb:
  NbCnt = NbN[Here]
  Off16 = NbHi[Here]
  Off16 = Off16 * 256 + NbLo[Here]
  copy NbList + Off16 count NbCnt to NbBuf
end sub

' xorshift random 0..N-1
function RandN(u8 N) as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  W16 = Rs % N
  return W16

' ---------------------------------------------------------------------------
' the map window

' the window's corner so that the country's capital is near the middle
sub CentreOn(u8 C):
  i16 T = 0
  T = CX[C] / 2
  T = T - 14
  if T < 0 then T = 0
  if T > 60 then T = 60
  ViewX = T
  T = CY[C] / 2
  T = T - 8
  if T < 0 then T = 0
  if T > 31 then T = 31
  ViewY = T
end sub

sub IbRedraw:
  call asm IbDraw
end sub

' a capital's sprite corner on screen, kept inside the window
function PixX(u8 C) as u8
  i16 P = 0
  i16 Vx = 0
  Vx = ViewX
  P = CX[C]
  P = P - Vx * 2
  P = P * 4 + 10
  if P < 16 then P = 16
  if P > 224 then P = 224
  return P

function PixY(u8 C) as u8
  i16 P = 0
  i16 Vy = 0
  Vy = ViewY
  P = CY[C]
  P = P - Vy * 2
  P = P * 4 + 2
  if P < 8 then P = 8
  if P > 120 then P = 120
  return P

' is the capital inside the window? (1 = yes)
function InView(u8 C) as u8
  u8 Res = 0
  u8 Tx = 0
  u8 Ty = 0
  Tx = CX[C] >> 1
  Ty = CY[C] >> 1
  if Tx >= ViewX then
    if Tx < ViewX + 28 then
      if Ty >= ViewY then
        if Ty < ViewY + 16 then Res = 1
      end if
    end if
  end if
  return Res

' the edge arrow toward country C (the listing's eight edge spots)
sub Arrow(u8 C):
  u8 Ax = 120
  u8 Ay = 64
  u8 D = 0
  u8 Hx = 0
  u8 Hy = 0
  u8 Tx = 0
  u8 Ty = 0
  Hx = CX[Here]
  Hy = CY[Here]
  Tx = CX[C]
  Ty = CY[C]
  if C = Here then
    set sprite 5 to 208,0,0,0
    return
  end if
  ' D: 0 up, 1 up-right, 2 right ... 7 up-left
  if Tx > Hx then
    Ax = 224
    if Ty < Hy then
      D = 1
      Ay = 8
    elseif Ty > Hy then
      D = 3
      Ay = 120
    else
      D = 2
    end if
  elseif Tx < Hx then
    Ax = 16
    if Ty < Hy then
      D = 7
      Ay = 8
    elseif Ty > Hy then
      D = 5
      Ay = 120
    else
      D = 6
    end if
  else
    if Ty < Hy then
      D = 0
      Ay = 8
    else
      D = 4
      Ay = 120
    end if
  end if
  Ay = Ay - 1
  D = D * 4 + SArr0
  set sprite 5 to Ay,Ax,D,15
end sub

' sprites: 0/1 the hunter, 2 the choice, 3/4 the criminal, 5 the arrow,
' 6 home after the catch
sub DrawSprites:
  u8 Px = 0
  u8 Py = 0
  u8 T = 0
  if InPlay = 0 then return
  Py = HunY - 1
  set sprite 0 to Py,HunX,SHunter,15
  set sprite 1 to Py,HunX,SHunterl,1
  if Moving + Looking = 0 then
    if Pick < NbCnt then
      T = NbBuf[Pick]
      Px = PixX(T)
      Py = PixY(T) - 1
      set sprite 2 to Py,Px,SCursor,7
    else
      set sprite 2 to 208,0,0,0
    end if
  else
    set sprite 2 to 208,0,0,0
  end if
  if Carry = 0 then
    if InView(Crook) = 1 then
      Px = PixX(Crook)
      Py = PixY(Crook) - 1
      set sprite 3 to Py,Px,SCrook,14
      set sprite 4 to Py,Px,SCrookl,1
    else
      set sprite 3 to 208,0,0,0
      set sprite 4 to 208,0,0,0
    end if
    set sprite 6 to 208,0,0,0
    if Looking = 0 then
      Arrow(Crook)
    else
      set sprite 5 to 208,0,0,0
    end if
  else
    set sprite 3 to 208,0,0,0
    set sprite 4 to 208,0,0,0
    if InView(Home) = 1 then
      Px = PixX(Home)
      Py = PixY(Home) - 1
      set sprite 6 to Py,Px,SHouse,11
    else
      set sprite 6 to 208,0,0,0
    end if
    if Looking = 0 then
      Arrow(Home)
    else
      set sprite 5 to 208,0,0,0
    end if
  end if
  if Looking = 1 then
    ' the hunter stays on his capital while the map scrolls
    if InView(Here) = 1 then
      Px = PixX(Here)
      Py = PixY(Here) - 1
      set sprite 0 to Py,Px,SHunter,15
      set sprite 1 to Py,Px,SHunterl,1
    else
      set sprite 0 to 208,0,0,0
      set sprite 1 to 208,0,0,0
    end if
  end if
  update sprites
end sub

' ---------------------------------------------------------------------------
' the text under the map

' a country's name (Kind 0) or capital (Kind 1) at Px,Py, the rest of the
' line cleared up to column 29
sub PutText(u8 C, u8 Kind, u8 Px, u8 Py):
  u8 Ln = 0
  u8 Rest = 0
  u8 Ex = 0
  if Kind = 0 then
    Off16 = NHi[C]
    Off16 = Off16 * 256 + NLo[C]
    Ln = NLen[C]
  else
    Off16 = KHi[C]
    Off16 = Off16 * 256 + KLo[C]
    Ln = KLen[C]
  end if
  put TxText + Off16 count Ln at Px,Py
  Ex = Px + Ln
  Rest = 30 - Ex
  if Rest > 0 then fill 32 count Rest at Ex,Py
end sub

sub PutName(u8 C, u8 Px, u8 Py):
  PutText(C, 0, Px, Py)
end sub

sub ShowPick:
  print at 2,20, "TO "
  if Pick < NbCnt then
    PutText(NbBuf[Pick], NameK, 5, 20)
  elseif Pick = NbCnt then
    print at 5,20, "(STAY A TURN)           "
  else
    print at 5,20, "(LOOK AT THE MAP)       "
  end if
end sub

sub ShowTime:
  u8 Mn = 0
  u8 Sc = 0
  if Carry = 0 then
    print at 21,21, "         "
    return
  end if
  W16 = TimeLeft
  Mn = W16 / 60
  Sc = W16 % 60
  print at 21,21, "TIME "
  print Mn at 26,21 width 1
  print at 27,21, ":"
  print Sc at 28,21 width 2
end sub

sub ShowHud:
  print at 2,18, "IN "
  PutText(Here, 0, 5, 18)
  PutText(Here, 1, 5, 19)
  fill 32 count 3 at 2,19
  ShowPick
  print at 2,21, "BOUNTY $"
  print Bounty at 10,21 width 5
  ShowTime
end sub

sub ClearHud:
  for Si = 18 to 22
    fill 32 count 28 at 2,Si
  next
end sub

' the message line: 1 the start, 2 the catch, 3 the escape
sub Say(u8 Which):
  fill 32 count 28 at 2,22
  select case Which
  case 1
    print at 2,22, "FIND THE CRIMINAL!"
  case 2
    print at 2,22, "CAUGHT! TAKE HIM HOME!"
  case 3
    print at 2,22, "TIME IS UP: HE ESCAPED!"
  end select
  MsgT = MsgN
end sub

' ---------------------------------------------------------------------------
' a new game

sub NewGame:
  NewScreen
  backdrop black
  DrawRows = MapRows
  call asm IbPatInit
  call asm IbNames
  fill TRule count 28 at 2,17
  Over = 0
  Carry = 0
  Moving = 0
  Looking = 0
  Turn = 0
  Moves = 0
  MsgT = 0
  SecT = 0
  Bounty = 10000
  MR = 13 - Level * 2
  ' the listing's start: two different random countries (line 210)
  Crook = RandN(NC) + 1
  Here = Crook
  while Here = Crook
    Here = RandN(NC) + 1
  end while
  Home = Here
  CentreOn(Here)
  call asm IbDraw
  LoadNb
  Pick = 0
  HunX = PixX(Here)
  HunY = PixY(Here)
  ShowHud
  Say(1)
  InPlay = 1
  DrawSprites
  ShowScreen
  play sound SndStep
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
end sub

sub ReadPad:
  J1 = 0
  Btn1 = 0
  Btn2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then Btn1 = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).button1 then Btn1 = 1
  if joypad(2).button2 then Btn2 = 1
  Press1 = 0
  Press2 = 0
  if Btn1 = 1 then
    if WasB1 = 0 then Press1 = 1
  end if
  if Btn2 = 1 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB1 = Btn1
  WasB2 = Btn2
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 6
    set sprite J to 208,0,0,0
  next
  update sprites
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  InPlay = 0
  HideSprites
  load default ascii
  duplicate mode 2 patterns
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  fill full mode 2 text color with $F1
  copy TileCol count NTiles8 to vram.color + 1024
  copy TileCol count NTiles8 to vram.color + 3072
  copy TileCol count NTiles8 to vram.color + 5120
  call asm IbSetR3
  backdrop black
  cls
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
end sub

' the title: a strip of the map, the name, the settings, the tune once
sub TitlePage:
  NewScreen
  DrawRows = 7
  ViewX = 30
  ViewY = 12
  call asm IbPatInit
  call asm IbNames
  call asm IbDraw
  fill TRule count 28 at 2,9
  print at 2,10, "INTERNATIONAL BOUNTY HUNTER"
  fill TRule count 28 at 2,11
  print at 7,12, "COMPUTE!'S GAZETTE"
  print at 11,13, "MARCH 1990"
  ShowMenu
  print at 3,20, "UP/DOWN: CHOOSE A LINE"
  print at 3,21, "LEFT/RIGHT: CHANGE IT"
  print at 3,22, "BUTTON: START"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 470
  TzOn = 1
  TitleOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 1
  WasB2 = 1
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 15
  if V <> WasStick then
    if V > 0 then MenuKey(V)
  end if
  WasStick = V
  K = Press1 | Press2
  if K = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Line = 3 then
    CreditsPage
    goto title
  end if
end sub

sub MenuKey(u8 Stk):
  if Stk & 1 then
    if Line > 0 then dec Line
  end if
  if Stk & 2 then
    if Line < 3 then inc Line
  end if
  if Stk & 12 then
    select case Line
    case 0
      NameK = NameK ^ 1
    case 1
      if Stk & 8 then
        if Level < 6 then inc Level
      else
        if Level > 1 then dec Level
      end if
    end select
  end if
  ShowMenu
  play sound SndClick
end sub

sub ShowMenu:
  u8 Row = 0
  for Si = 15 to 18
    put char 32 at 4,Si
  next
  Row = Line + 15
  put char 62 at 4,Row
  if NameK = 0 then
    print at 6,15, "GO BY  COUNTRIES"
  else
    print at 6,15, "GO BY  CAPITALS "
  end if
  print at 6,16, "LEVEL  "
  print Level at 13,16 width 1
  select case Level
  case 1
    print at 14,16, " EASY     "
  case 6
    print at 14,16, " DIFFICULT"
  case else
    print at 14,16, "          "
  end select
  print at 6,17, "START"
  print at 6,18, "CREDITS"
end sub

sub CreditsPage:
  NewScreen
  print at 2,2, "INTERNATIONAL BOUNTY HUNTER"
  print at 2,4, "BASED ON INTERNATIONAL"
  print at 2,5, "BOUNTY HUNTER, COMPUTE!'S"
  print at 2,6, "GAZETTE DISK, MARCH 1990"
  print at 2,7, "(COMMODORE 128). COPYRIGHT"
  print at 2,8, "1990 COMPUTE! PUBLICATIONS,"
  print at 2,9, "INC. MAP FROM THE DISK."
  print at 2,11, "COUNTRIES AND CAPITALS AS"
  print at 2,12, "THEY WERE IN 1990."
  print at 2,14, "COLECOVISION GAME AND MUSIC"
  print at 2,15, "BY CLAUDE (ANTHROPIC) FOR"
  print at 2,16, "AMY STUDIO, IN AMY BY AMY"
  print at 2,17, "BIENVENU, 2026."
  print at 2,19, "MUSIC: PASSPORT STAMP"
  print at 2,20, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
end sub

