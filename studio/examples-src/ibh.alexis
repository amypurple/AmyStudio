    db $66,$66,$66,$66,$66,$66,$66,$66,$66,$66,$66,$66,$61,$11,$11,$11,$11,$11,$11,$11,$11,$11
    db $11,$11,$11,$16,$66,$64,$DD,$DD,$DD,$DD,$DD,$DB,$BB,$BB,$BB,$B4,$4B,$BB,$BB,$BB,$BB,$BB
