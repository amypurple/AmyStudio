' the item icon (2 x 2 tiles) of each item
data IconT bytes
  TLamp00, TGkey00, TBkey00, TRkey00, TGdoor00, TBdoor00, TRdoor00, TMap00, TGold00
end data
' the message when standing on each item
data ItMsg bytes
  MDark, MGKey, MBKey, MRKey, MGDoor, MBDoor, MRDoor, MMapHere, MBeat
end data

record Thing:
  u8 C
  u8 St
end record

' items: cell (NoCell: not in the dungeon), state (1 lying here or a
' closed door, 2 taken or an open door)
Thing It[9]
' the dungeon: 0 wall, 1 hallway, 2 room, 3 monster room
u8 Fl[100]
' what the player has seen: 1 the cell, 2 been inside, 4 shown on the map
u8 Sn[100]

