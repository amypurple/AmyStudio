cartridge "DRAGON CASTLE/AMY STUDIO/2026"

' English translation by zyzzle: https://forums.atariage.com/profile/64028-zyzzle/
' Thanks to zyzzle for testing the clean repo, finding the include-file issue, and making this version possible.
picture ChateauTitle:
  pattern from "@project/chateau-title.pattern.zx0" codec zx0
  color from "@project/chateau-title.color.zx0" codec zx0
end picture

u8 Choice = 0
u8 HeroHp = 0
u8 HeroDie = 0
u8 HeroBonus = 0
u8 HeroDef = 0
u8 HeroRegen = 0
u8 HeroClass = 0

u8 MonsterId = 0
u8 MonsterHp = 0
u8 MonsterDie = 0
u8 MonsterBonus = 0
u8 MonsterDef = 0
u8 MonsterRegen = 0

u8 Encounters = 0
u8 FirstReward = 0
u8 Roll = 0
u8 Hit = 0
u8 Turn = 0

data ChateauContourSprites bytes
  $00,$00,$00,$01,$02,$02,$02,$02,$04,$04,$04,$05,$05,$0A,$3A,$46
  $39,$46,$BA,$41,$40,$80,$80,$87,$88,$96,$AA,$2D,$22,$4C,$48,$2E
  $80,$40,$80,$00,$00,$00,$00,$00,$83,$84,$8B,$0A,$0A,$12,$12,$13
  $00,$00,$02,$1D,$21,$19,$09,$E9,$19,$AA,$49,$0A,$12,$12,$93,$55
  $00,$00,$00,$00,$00,$01,$02,$E1,$13,$94,$9B,$AA,$AA,$B2,$33,$32
  $00,$00,$20,$50,$90,$48,$B0,$E0,$18,$90,$90,$98,$A8,$A8,$28,$B8
  $81,$7C,$03,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $E1,$3E,$0C,$C3,$30,$0F,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $08,$07,$00,$C0,$20,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $A5,$18,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $01,$FE,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $88,$70,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

set sound table ChateauSoundTable areas 9
show picture ChateauTitle
sprites 16x16
sprites simple
copy ChateauContourSprites to vram.spr_pat
clear sprites
set sprite count 6
set sprite 0 to 25,59,0,1
set sprite 1 to 25,75,4,1
set sprite 2 to 25,91,8,1
set sprite 3 to 41,59,12,1
set sprite 4 to 41,75,16,1
set sprite 5 to 41,91,20,1
update sprites
pause until press

intro:
  clear sprites
  update sprites
  text screen
  cls
  print centered at 1, "DRAGON CASTLE"
  print at 1,4, "For centuries, the"
  print at 1,5, "castle treasure has"
  print at 1,6, "attracted the brave."
  print at 1,9, "Legend says that the"
  print at 1,10, "screams will cease when"
  print at 1,11, "the treasure is taken."
  print centered at 18, "PRESS FIRE"
  screen on
  pause until press
  goto choose_hero

choose_hero:
  cls
  print centered at 1, "CHOOSE YOUR HERO"
  print at 3,5, "1 WARRIOR    HP36 AT7"
  print at 3,7, "2 BLACKSMITH HP42 AT6"
  print at 3,9, "3 THIEF      HP50 AT5"
  print at 3,11, "4 PEASANT    HP99 AT4"
  print centered at 18, "KEYPAD 1-4"
  choose keypad 1 to 4 into Choice
  wait key release
  HeroClass = Choice
  select case Choice
  case 1
    HeroHp = 36
    HeroDie = 7
    HeroBonus = 0
    HeroDef = 6
    HeroRegen = 0
    Encounters = 6
  case 2
    HeroHp = 42
    HeroDie = 6
    HeroBonus = 0
    HeroDef = 5
    HeroRegen = 0
    Encounters = 6
  case 3
    HeroHp = 50
    HeroDie = 5
    HeroBonus = 0
    HeroDef = 4
    HeroRegen = 0
    Encounters = 5
  case else
    HeroHp = 99
    HeroDie = 4
    HeroBonus = 0
    HeroDef = 3
    HeroRegen = 0
    Encounters = 5
  end select
  FirstReward = 1
  cls
  print centered at 3, "GOOD LUCK"
  print centered at 6, "YOU WILL NEED IT"
  print centered at 18, "PRESS FIRE"
  pause until press
  goto road_loop

road_loop:
  if HeroHp = 0 then goto game_over
  if Encounters = 0 then goto fountain_scene
  battle
  if HeroHp = 0 then goto game_over
  reward_before_castle
  Encounters -= 1
  goto road_loop

fountain_scene:
  cls
  print centered at 2, "THE CASTLE"
  print at 1,5, "You arrive in front of"
  print at 1,6, "a cold fountain."
  print at 1,9, "Drink from its water?"
  print at 4,12, "1 YES"
  print at 4,14, "2 NO"
  choose keypad 1 to 2 into Choice
  wait key release
  if Choice = 1 then
    Roll = random(0,3)
    if Roll > 0 then
      print centered at 17, "THE WATER DOES YOU GOOD"
      play sound 8
      Hit = random(10,17)
      HeroHp += Hit
    else
      print centered at 17, "THE WATER WAS BAD"
      Hit = random(1,3)
      if HeroHp > Hit then
        HeroHp -= Hit
      else
        HeroHp = 1
      end if
    end if
    pause until press
  end if
  Encounters = 4
  goto castle_loop

castle_loop:
  if HeroHp = 0 then goto game_over
  if Encounters = 0 then goto victory
  battle
  if HeroHp = 0 then goto game_over
  reward_inside_castle
  Encounters -= 1
  goto castle_loop

sub reward_before_castle:
  cls
  if FirstReward = 1 then
    FirstReward = 0
    print centered at 4, "AMULET OF STRENGTH"
    play sound 8
    HeroBonus += 2
  else
    Roll = random(0,3)
    if Roll = 3 then
      print centered at 4, "MAGIC POTION"
      play sound 8
      Hit = random(4,7)
      HeroHp += Hit
    else
      Roll = random(0,3)
      if Roll = 3 then
        if HeroBonus < 3 then
          print centered at 4, "AMULET OF STRENGTH"
          play sound 8
          HeroBonus += 2
        else
          print centered at 4, "NOTHING FOUND"
        end if
      else
        print centered at 4, "NOTHING FOUND"
      end if
    end if
  end if
  print at 7,10, "LIFE:"
  print HeroHp at 12,10 digits 3
  print centered at 18, "PRESS FIRE"
  pause until press
  return

sub reward_inside_castle:
  cls
  Roll = random(0,3)
  if Roll = 3 then
    print centered at 4, "MAGIC POTION"
    play sound 8
    Hit = random(5,8)
    HeroHp += Hit
  else
    Roll = random(0,3)
    if Roll = 3 then
      if HeroDef < 6 then
        print centered at 4, "AMULET OF DEFENSE"
        play sound 8
        HeroDef += 2
      else
        print centered at 4, "NOTHING FOUND"
      end if
    else
      print centered at 4, "NOTHING FOUND"
    end if
  end if
  print at 7,10, "LIFE:"
  print HeroHp at 12,10 digits 3
  print centered at 18, "PRESS FIRE"
  pause until press
  return

sub battle:
  MonsterId = random(0,19)
  load_monster
  draw_combat_hud
  print centered at 8, "** COMBAT **"
  print centered at 18, "PRESS FIRE"
  pause until press
  Turn = random(0,1)
  if Turn = 0 then goto hero_turn
  goto monster_turn

hero_turn:
  draw_combat_hud
  print centered at 8, "YOUR TURN"
  Roll = random(1,10)
  if Roll < MonsterDef then
    play sound 2
    print centered at 11, "MISSED"
  else
    play sound 1
    play sound 7
    Hit = random(1, HeroDie)
    Hit += HeroBonus
    print at 5,11, "ATTACK:"
    print Hit at 14,11 digits 2
    if MonsterHp > Hit then
      MonsterHp -= Hit
    else
      MonsterHp = 0
    end if
    print at 5,13, "MONSTER:"
    print MonsterHp at 14,13 digits 3
  end if
  wait 35 frames
  if MonsterHp = 0 then goto battle_won
  goto monster_turn

monster_turn:
  draw_combat_hud
  print centered at 8, "MONSTER'S TURN"
  Roll = random(1,10)
  if Roll < HeroDef then
    play sound 2
    print centered at 11, "MISSED"
  else
    if MonsterId = 6 then
      play sound 3
      play sound 4
    else
      play sound 1
    end if
    play sound 7
    Hit = random(1, MonsterDie)
    Hit += MonsterBonus
    print at 5,11, "ATTACK:"
    print Hit at 14,11 digits 2
    if HeroHp > Hit then
      HeroHp -= Hit
    else
      HeroHp = 0
    end if
    print at 5,13, "HERO:"
    print HeroHp at 14,13 digits 3
  end if
  if MonsterRegen > 0 then
    MonsterHp += MonsterRegen
    print centered at 15, "THE MONSTER REGENERATES"
  end if
  wait 35 frames
  if HeroHp = 0 then goto battle_lost
  goto hero_turn

battle_won:
  cls
  print centered at 5, "MONSTER DEFEATED"
  print centered at 18, "PRESS FIRE"
  pause until press
  return

battle_lost:
  cls
  print centered at 5, "YOU ARE DEAD"
  print centered at 18, "PRESS FIRE"
  pause until press
  return

sub draw_combat_hud:
  cls
  print at 1,0, "HERO"
  print at 7,0, "HP:"
  print HeroHp at 10,0 digits 3
  print at 15,0, "AT:"
  print HeroDie at 18,0 digits 2
  print at 22,0, "DF:"
  print HeroDef at 25,0 digits 2
  print_monster_name
  print at 7,4, "HP:"
  print MonsterHp at 10,4 digits 3
  print at 15,4, "AT:"
  print MonsterDie at 18,4 digits 2
  print at 22,4, "DF:"
  print MonsterDef at 25,4 digits 2
  print at 1,6, "------------------------------"
  return

sub print_monster_name:
  select case MonsterId
  case 0
    print centered at 3, "SKELETON"
  case 1
    print centered at 3, "ZOMBIE"
  case 2
    print centered at 3, "GHOUL"
  case 3
    print centered at 3, "GHOST"
  case 4
    print centered at 3, "VAMPIRE"
  case 5
    print centered at 3, "TROLL"
  case 6
    print centered at 3, "DRAGON"
  case 7
    print centered at 3, "WEREWOLF"
  case 8
    print centered at 3, "GOBLIN"
  case 9
    print centered at 3, "ORC"
  case 10
    print centered at 3, "MUMMY"
  case 11
    print centered at 3, "BALROG"
  case 12
    print centered at 3, "GIANT"
  case 13
    print centered at 3, "DEMON"
  case 14
    print centered at 3, "MINOTAUR"
  case 15
    print centered at 3, "CHIMERA"
  case 16
    print centered at 3, "SPHINX"
  case 17
    print centered at 3, "CENTAUR"
  case 18
    print centered at 3, "MEDUSA"
  case else
    print centered at 3, "WIZARD"
  end select
  return

sub load_monster:
  select case MonsterId
  case 0
    MonsterHp = 4
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 4
    MonsterRegen = 0
  case 1
    MonsterHp = 5
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 5
    MonsterRegen = 0
  case 2
    MonsterHp = 5
    MonsterDie = 3
    MonsterBonus = 1
    MonsterDef = 6
    MonsterRegen = 0
  case 3
    MonsterHp = 4
    MonsterDie = 3
    MonsterBonus = 1
    MonsterDef = 8
    MonsterRegen = 0
  case 4
    MonsterHp = 5
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 8
    MonsterRegen = 2
  case 5
    MonsterHp = 12
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 6
    MonsterRegen = 0
  case 6
    MonsterHp = 15
    MonsterDie = 6
    MonsterBonus = 1
    MonsterDef = 7
    MonsterRegen = 0
  case 7
    MonsterHp = 5
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 5
    MonsterRegen = 0
  case 8
    MonsterHp = 2
    MonsterDie = 3
    MonsterBonus = 1
    MonsterDef = 4
    MonsterRegen = 0
  case 9
    MonsterHp = 3
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 5
    MonsterRegen = 0
  case 10
    MonsterHp = 6
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 8
    MonsterRegen = 0
  case 11
    MonsterHp = 10
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 9
    MonsterRegen = 0
  case 12
    MonsterHp = 12
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 6
    MonsterRegen = 0
  case 13
    MonsterHp = 9
    MonsterDie = 6
    MonsterBonus = 1
    MonsterDef = 7
    MonsterRegen = 1
  case 14
    MonsterHp = 6
    MonsterDie = 5
    MonsterBonus = 2
    MonsterDef = 7
    MonsterRegen = 0
  case 15
    MonsterHp = 6
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 4
    MonsterRegen = 0
  case 16
    MonsterHp = 6
    MonsterDie = 6
    MonsterBonus = 0
    MonsterDef = 4
    MonsterRegen = 0
  case 17
    MonsterHp = 6
    MonsterDie = 9
    MonsterBonus = 0
    MonsterDef = 4
    MonsterRegen = 0
  case 18
    MonsterHp = 6
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 6
    MonsterRegen = 0
  case else
    MonsterHp = 4
    MonsterDie = 3
    MonsterBonus = 0
    MonsterDef = 5
    MonsterRegen = 0
  end select
  return

game_over:
  mute all
  play sound 5
  play sound 6
  cls
  print centered at 5, "FAILURE"
  print centered at 8, "THE CASTLE REMAINS HAUNTED"
  print centered at 18, "PRESS FIRE"
  pause until press
  goto intro

victory:
  mute all
  play sound 9
  cls
  print centered at 3, "VICTORY"
  print at 1,6, "You finally find the"
  print at 1,7, "treasure of the Castle."
  print at 1,10, "The screams cease."
  print at 1,13, "The village will sleep."
  print centered at 18, "PRESS FIRE"
  pause until press
  goto intro

include "@project/chateau_sounds.inc"