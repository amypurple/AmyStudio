cartridge "FIDGITS/WALTER E. MEYERS/1985"

' FIDGITS
' A ColecoVision game based on "Fidgits" by Walter E. Meyers, Ahoy! August
' 1985 (Commodore 64, BASIC with custom characters and a 33-byte
' machine-code font copier; disk ahoy1985-08, 34 blocks). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/fidgits.bas), the game is built for the ColecoVision:
' tiled square birds on three branches under a night sky, a mother bird
' sprite that flies from nest to nest, a note rising over the singer,
' sound effects and the listing's own title tune.
'
' The game: 26 fidgits, A to Z, sit on three branches (8, 9 and 9, as in
' the original). One at a time a fidgit gets hungry and sings its own note
' with its beak open. Fly the mother bird to it with the stick and press a
' button to feed it a worm. Feeding the wrong fidgit makes it squawk. Ten
' suppers end a round.
'
' From the original (orig/fidgits.bas): the 26 lettered fidgits on three
' rows of 8, 9 and 9 (lines 20-40), a random singer (GOSUB 90) that shows
' an open beak (HO$) and sings its own note, fidgit A..Z on the chromatic
' notes from C upward (NO(1)..NO(26)); feeding the singer quiets it, a
' wrong fidgit shows a ruffled face (HS$) until the next press; ten
' suppers to a round (SC < 10, line 690); the nest picture between rounds
' is replaced by a banner; the title tune of lines 2000-2140 ("Twinkle,
' Twinkle, Little Star", traditional) plays on the title.
'
' Liberties: the C64 game was a typing game (press the singer's letter on
' the keyboard). The ColecoVision has no keyboard here (joystick only), so
' a mother bird is flown to the singer instead, and to keep a challenge
' there is a patience bar: feed the singer before it runs out (a slow
' feed is a missed supper, three missed suppers end the game), a quicker
' supper scores more (round x (1 + patience / 36)), a wrong feed costs 45
' frames of patience (so pressing at every fidgit in turn does not pay).
' The original had no score and no end but Q; here eight rounds, each
' with less patience (6 s down to 2.5 s) and shorter rests between
' singers, then the win. The next singer is never the last one, the
' fidgit under the mother bird or the one squawking (no free suppers by
' standing still). Notes an octave higher (C5..C#7, more like chicks).
' The wrong fidgit squawks for half a second instead of until the next key.
'
' Controls: either controller; the stick flies the mother bird from
' fidgit to fidgit (left/right along the branch, up/down to the nearest
' fidgit on the next branch; hold to repeat), either button feeds. On the
' title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TF0qtl = 128
const TF0qtr = 129
const TF0qbl = 130
const TF0qbr = 131
const TF0sal = 132
const TF0sar = 133
const TF0sbl = 134
const TF0sbr = 135
const TF0sql = 136
const TF0sqr = 137
const TF1qtl = 138
const TF1qtr = 139
const TF1qbl = 140
const TF1qbr = 141
const TF1sal = 142
const TF1sar = 143
const TF1sbl = 144
const TF1sbr = 145
const TF1sql = 146
const TF1sqr = 147
const TF2qtl = 148
const TF2qtr = 149
const TF2qbl = 150
const TF2qbr = 151
const TF2sal = 152
const TF2sar = 153
const TF2sbl = 154
const TF2sbr = 155
const TF2sql = 156
const TF2sqr = 157
const TF3qtl = 158
const TF3qtr = 159
const TF3qbl = 160
const TF3qbr = 161
const TF3sal = 162
const TF3sar = 163
const TF3sbl = 164
const TF3sbr = 165
const TF3sql = 166
const TF3sqr = 167
const TF4qtl = 168
const TF4qtr = 169
const TF4qbl = 170
const TF4qbr = 171
const TF4sal = 172
const TF4sar = 173
const TF4sbl = 174
const TF4sbr = 175
const TF4sql = 176
const TF4sqr = 177
const TF5qtl = 178
const TF5qtr = 179
const TF5qbl = 180
const TF5qbr = 181
const TF5sal = 182
const TF5sar = 183
const TF5sbl = 184
const TF5sbr = 185
const TF5sql = 186
const TF5sqr = 187
const TBark = 188
const TToel = 189
const TToer = 190
const TLeafl = 191
const TLeafr = 192
const TTrunk = 193
const TStar = 194
const TMoon0 = 195
const TMoon1 = 196
const TBar0 = 197
const TBar1 = 198
const TBar2 = 199
const TBar3 = 200
const TBar4 = 201
const TBar5 = 202
const TBar6 = 203
const TBar7 = 204
const TBar8 = 205
const TNest = 206
const TNestx = 207
const SMom0 = 0
const SMom1 = 4
const SWorm = 8
const SNote = 12
const SNone = 16
const NTiles8 = 640
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndYum = 3
const SndSquawk = 4
const SndMiss = 5
const SndRound = 6
const SndStart = 7
const SndOver = 8
const SndWin = 9
const SndMove = 10
const SndSingA = 11
const SndSingB = 12
const SndSingC = 13
const SndSingD = 14
const SndSingE = 15
const SndSingF = 16
const SndSingG = 17
const SndSingH = 18
const SndSingI = 19
const SndSingJ = 20
const SndSingK = 21
const SndSingL = 22
const SndSingM = 23
const SndSingN = 24
const SndSingO = 25
const SndSingP = 26
const SndSingQ = 27
const SndSingR = 28
const SndSingS = 29
const SndSingT = 30
const SndSingU = 31
const SndSingV = 32
const SndSingW = 33
const SndSingX = 34
const SndSingY = 35
const SndSingZ = 36
const NFid = 26
const NSpr = 3
const FamSz = 10
const MsgN = 120
const SqN = 30
const DiveN = 12
const WormN = 24
const RepFirst = 14
const RepN = 6
const SingN = 40
const WrongCost = 45
const RoundBonus = 50
const LastRound = 8

' the fidgits: column of the left half; rows of 8, 9 and 9
data FidC bytes
  4, 7, 10, 13, 16, 19, 22, 25
  2, 5, 8, 11, 14, 17, 20, 23, 26
  2, 5, 8, 11, 14, 17, 20, 23, 26
end data
data RowS bytes
  0, 8, 17
end data
data RowN bytes
  8, 9, 9
end data
data RowY bytes
  4, 11, 18
end data
data StarC bytes
  3, 9, 15, 21, 6, 18, 12, 24, 27, 4, 29
end data
data StarR bytes
  2, 3, 2, 3, 9, 9, 16, 16, 9, 16, 23
end data
' the title: F I D G I T S
data TitleL bytes
  5, 8, 3, 6, 8, 19, 18
end data

record Mother:
  u8 Sel
  u8 X
  u8 Y
  u8 Dive
end record

Mother Mom
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Pt = 0
u16 PatMax = 360
bcd digits 5 Sc = 0
bcd digits 5 Hi = 0
u8 Sing = 255
u8 SingT = 0
u8 GapT = 0
u8 GapN = 40
u8 SqI = 255
u8 SqT = 0
u8 Rd = 1
u8 Fed = 0
u8 Miss = 0
u8 Over = 0
u8 MsgT = 0
u8 Rep = 0
u8 WasDir = 0
u8 Last = 255
u8 Phase = 0
u8 BarN = 255
u8 WormT = 0
u8 Pts = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Ri = 0
u8 Bj = 0
' scratch
u8 K = 0
u8 N = 0
u8 J = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table FdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Sc > Hi then Hi = Sc
  ShowHud
  mute all
  for Ri = 9 to 13
    fill 32 count 20 at 6,Ri
  next
  if Over = 2 then
    print at 9,10, "EVERY FIDGIT"
    print at 9,11, "IS WELL FED!"
    print at 8,12, "  GOOD SHOW!  "
    play sound SndWin
  else
    print at 11,11, "GAME OVER"
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' small helpers that return values

' which branch a fidgit sits on
function RowOf(u8 I) as u8
  if I < 8 then return 0
  if I < 17 then return 1
  return 2

' the fidgit of branch Rw nearest to column C (a loop with a variable end)
function Nearest(u8 Rw, u8 C) as u8
  u8 Best = 0
  u8 BestD = 255
  u8 E = 0
  u8 D = 0
  u8 Q = 0
  E = RowS[Rw] + RowN[Rw]
  E = E - 1
  for Q = RowS[Rw] to E
    if FidC[Q] > C then
      D = FidC[Q] - C
    else
      D = C - FidC[Q]
    end if
    if D < BestD then
      BestD = D
      Best = Q
    end if
  next
  return Best

' the points of a supper: round x (1 + patience left / 36)
function Points as u8
  u8 Q = 0
  W16 = Pt / 36
  Q = W16
  Q = Q + 1
  return Q * Rd

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveHand
  if WormT > 0 then dec WormT
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowHud
    return
  end if
  if SqT > 0 then
    dec SqT
    if SqT = 0 then
      if SqI <> Sing then DrawBird(SqI, 0)
      SqI = 255
    end if
  end if
  if Sing = 255 then
    dec GapT
    if GapT = 0 then NewSinger
  else
    dec Pt
    if Pt = 0 then
      Starve
      ShowBar
      return
    end if
    dec SingT
    if SingT = 0 then
      SingT = SingN
      V = SndSingA + Sing
      play sound V
    end if
    V = Tick & 15
    if V = 0 then
      Phase = Phase ^ 1
      V = Phase + 1
      DrawBird(Sing, V)
    end if
  end if
  if Press = 1 then Feed
  if Over = 0 then
    if MsgT = 0 then ShowBar
  end if
  return
end sub

' the stick: one fidgit at a time, repeating while held
sub MoveHand:
  K = J1 | J2
  K = K & 15
  if K = 0 then
    WasDir = 0
    Rep = 0
  else
    if WasDir = 0 then
      StepHand(K)
      Rep = RepFirst
    else
      dec Rep
      if Rep = 0 then
        StepHand(K)
        Rep = RepN
      end if
    end if
    WasDir = 1
  end if
  ' glide toward the chosen fidgit, 4 pixels a frame at most
  X = FidC[Mom.Sel]
  X = X << 3
  Y = RowY[RowOf(Mom.Sel)]
  Y = Y << 3
  Y = Y - 17
  if Mom.X < X then
    V = X - Mom.X
    if V > 4 then V = 4
    Mom.X += V
  elseif Mom.X > X then
    V = Mom.X - X
    if V > 4 then V = 4
    Mom.X -= V
  end if
  if Mom.Y < Y then
    V = Y - Mom.Y
    if V > 4 then V = 4
    Mom.Y += V
  elseif Mom.Y > Y then
    V = Mom.Y - Y
    if V > 4 then V = 4
    Mom.Y -= V
  end if
  if Mom.Dive > 0 then dec Mom.Dive
  return
end sub

sub StepHand(u8 D):
  u8 Rw = 0
  u8 E = 0
  u8 Was = 0
  Was = Mom.Sel
  Rw = RowOf(Mom.Sel)
  select case D
  case 4 to 7
    if Mom.Sel > RowS[Rw] then dec Mom.Sel
  case 8 to 11
    E = RowS[Rw] + RowN[Rw]
    E = E - 1
    if Mom.Sel < E then inc Mom.Sel
  case 1
    if Rw > 0 then Mom.Sel = Nearest(Rw - 1, FidC[Mom.Sel])
  case 2
    if Rw < 2 then Mom.Sel = Nearest(Rw + 1, FidC[Mom.Sel])
  case else
    return
  end select
  if Mom.Sel <> Was then play sound SndMove
  return
end sub

' a button: the mother bird dips; the singer is fed, any other fidgit
' squawks and the singer loses patience
sub Feed:
  Mom.Dive = DiveN
  if Sing = 255 then return
  if Mom.Sel = Sing then
    Pts = Points
    Sc += Pts
    inc Fed
    WormT = WormN
    DrawBird(Sing, 0)
    Sing = 255
    GapT = GapN
    play sound SndYum
    ShowScore
    if Fed >= 10 then RoundDone
    return
  end if
  if SqI <> 255 then DrawBird(SqI, 0)
  SqI = Mom.Sel
  SqT = SqN
  DrawBird(SqI, 3)
  if Pt > WrongCost then
    Pt = Pt - WrongCost
  else
    Pt = 1
  end if
  play sound SndSquawk
  return
end sub

' the singer ran out of patience: a missed supper
sub Starve:
  inc Miss
  DrawBird(Sing, 0)
  Sing = 255
  GapT = 60
  play sound SndMiss
  DrawLives
  if Miss >= 3 then Over = 1
  return
end sub

sub RoundDone:
  Fed = 0
  Sc += RoundBonus
  if Rd >= LastRound then
    Over = 2
    return
  end if
  inc Rd
  SetRound
  MsgT = MsgN
  fill 32 count 28 at 2,1
  print at 6,1, "ROUND"
  NumU = Rd
  print at 12,1, digits$(NumU, 1)
  print at 15,1, "BIRDS FED!"
  play sound SndRound
  return
end sub

sub SetRound:
  W16 = Rd * 30
  PatMax = 390 - W16
  V = Rd * 3
  GapN = 44 - V
  return
end sub

' a new hungry fidgit: never the last singer, the one under the mother
' bird or the one squawking
sub NewSinger:
  Rand
  W16 = Rs % NFid
  N = W16
  for Bj = 1 to 3
    if N = Last then N = N + 7
    if N = Mom.Sel then N = N + 7
    if N = SqI then N = N + 7
    if N >= NFid then N = N - NFid
  next
  Sing = N
  Last = N
  Pt = PatMax
  SingT = 1
  Phase = 0
  DrawBird(Sing, 1)
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' fidgit I in state St (0 quiet, 1 singing, 2 singing half open, 3 squawk)
sub DrawBird(u8 I, u8 St):
  u8 C = 0
  u8 R = 0
  C = FidC[I]
  R = RowY[RowOf(I)]
  DrawBirdAt(C, R, I % 6, St)
  return
end sub

sub DrawBirdAt(u8 C, u8 R, u8 F, u8 St):
  u8 Tt = 0
  u8 Tb = 0
  Tt = F * FamSz
  Tt = Tt + TF0qtl
  Tb = Tt + 2
  select case St
  case 1
    Tt = Tt + 4
  case 2
    Tt = Tt + 6
  case 3
    Tt = Tt + 8
  end select
  put char Tt at C,R
  inc Tt
  inc C
  put char Tt at C,R
  inc R
  put char Tb at C - 1,R
  inc Tb
  put char Tb at C,R
  return
end sub

' the patience bar: 64 pixels for the whole patience
sub ShowBar:
  N = 0
  if Sing <> 255 then
    W16 = Pt << 6
    W16 = W16 / PatMax
    N = W16
  end if
  if N = BarN then return
  BarN = N
  K = N >> 3
  for Bj = 0 to 7
    if Bj < K then
      T = TBar8
    elseif Bj = K then
      V = N & 7
      T = TBar0 + V
    else
      T = TBar0
    end if
    V = Bj + 9
    put char T at V,1
  next
  return
end sub

sub ShowScore:
  print Sc at 2,1
  return
end sub

sub DrawLives:
  for Bj = 0 to 2
    T = TNest
    if Bj < Miss then T = TNestx
    V = Bj << 1
    V = V + 24
    put char T at V,1
  next
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,1
  ShowScore
  BarN = 255
  ShowBar
  print at 18,1, "RD"
  NumU = Rd
  print at 20,1, digits$(NumU, 1)
  DrawLives
  return
end sub

' sprite 0 the worm, 1 the mother bird, 2 the note over the singer
sub DrawSprites:
  Y = Mom.Y
  V = Mom.Dive
  if V > 6 then V = DiveN - V
  V = V << 1
  Y = Y + V
  V = Tick >> 3
  V = V & 1
  K = V << 2
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  else
    if WormT > 0 then
      set sprite 0 to 192,0,0,0
    else
      set sprite 0 to Y,Mom.X,SWorm,9
    end if
    set sprite 1 to Y,Mom.X,K,14
  end if
  if Sing = 255 then
    set sprite 2 to 192,0,0,0
  else
    X = FidC[Sing]
    X = X << 3
    X = X + 6
    Y = RowY[RowOf(Sing)]
    Y = Y << 3
    V = Tick >> 2
    V = V & 7
    Y = Y - 14
    Y = Y - V
    set sprite 2 to Y,X,SNote,15
  end if
  update sprites
  return
end sub

sub DrawField:
  fill TTrunk count 2 at 0,0
  fill TTrunk count 2 at 30,0
  for Ri = 1 to 23
    put char TTrunk at 0,Ri
    put char TTrunk at 1,Ri
    put char TTrunk at 30,Ri
    put char TTrunk at 31,Ri
  next
  for Fi = 0 to 10
    X = StarC[Fi]
    Y = StarR[Fi]
    put char TStar at X,Y
  next
  put char TMoon0 at 28,2
  put char TMoon1 at 28,3
  for Ri = 0 to 2
    Y = RowY[Ri] + 2
    fill TBark count 28 at 2,Y
    put char TLeafr at 29,Y
  next
  for Fi = 0 to 25
    DrawBird(Fi, 0)
    X = FidC[Fi]
    Y = RowY[RowOf(Fi)] + 2
    put char TToel at X,Y
    inc X
    put char TToer at X,Y
    dec X
    inc Y
    V = Fi + 65
    put char V at X,Y
  next
  return
end sub

sub NewGame:
  Sc = 0
  Rd = 1
  SetRound
  Fed = 0
  Miss = 0
  Over = 0
  MsgT = 0
  Sing = 255
  SqI = 255
  SqT = 0
  Last = 255
  GapT = 60
  WormT = 0
  Mom.Sel = 12
  Mom.X = FidC[12] << 3
  Mom.Y = RowY[1] << 3
  Mom.Y = Mom.Y - 17
  Mom.Dive = 0
  TitleOn = 0
  NewScreen
  DrawField
  ShowHud
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: FIDGITS spelt by seven fidgits singing in turn, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  TitleOn = 1
  Sing = 255
  fill TBark count 28 at 2,7
  put char TLeafr at 29,7
  for Fi = 0 to 6
    X = Fi * 3
    X = X + 5
    N = TitleL[Fi]
    DrawBirdAt(X, 5, N % 6, 0)
    put char TToel at X,7
    inc X
    put char TToer at X,7
    dec X
    V = N + 65
    put char V at X,8
  next
  for Fi = 0 to 10
    X = StarC[Fi]
    Y = StarR[Fi]
    if Y > 3 then Y = Y + 3
    if Y < 20 then put char TStar at X,Y
  next
  print at 8,11, "BY WALTER E. MEYERS"
  print at 9,12, "AHOY! AUGUST 1985"
  print at 11,15, "START GAME"
  print at 11,16, "CREDITS"
  print at 9,20, "HI"
  print Hi at 12,20
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 1176
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Ri = 255
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' one title fidgit sings at a time, in turn
  V = Tick >> 4
  V = V % 7
  if V <> Ri then
    if Ri <> 255 then
      X = Ri * 3
      X = X + 5
      DrawBirdAt(X, 5, TitleL[Ri] % 6, 0)
    end if
    Ri = V
    X = Ri * 3
    X = X + 5
    DrawBirdAt(X, 5, TitleL[Ri] % 6, 1)
  end if
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,15
  put char 32 at 9,16
  J = Menu + 15
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "FIDGITS"
  print at 2,5, "BASED ON FIDGITS BY"
  print at 2,6, "WALTER E. MEYERS, AHOY!"
  print at 2,7, "AUGUST 1985 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME AND"
  print at 2,11, "PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: TWINKLE, TWINKLE,"
  print at 2,18, "LITTLE STAR (TRADITIONAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

