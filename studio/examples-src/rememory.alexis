cartridge "REMEMORY/CHARLES HARBERT, COMPUTE!/1987"

' REMEMORY
' Based on "Rememory" by Charles Harbert, COMPUTE! May 1987 (pages 38-44):
' a memory game for the Commodore 64, with versions for the Amiga, IBM
' PC/PCjr, Apple II and Atari 400/800 by the magazine's programmers. Made
' for the ColecoVision in Amy (the language by Amy Bienvenu) by Claude (an
' AI made by Anthropic) for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the C64 listing's rules
' (orig/ has the scans and a partial transcription). Kept: 54 boxes in 9
' columns and 6 rows (the listing's MAT(53,..), its board loops R=0 TO 20
' STEP 4 and C=0 TO 32 STEP 4), 27 shapes each hidden twice, scrambled for
' every game; a turn is two boxes, both shown; the same shape stays shown
' and scores a match, and the player goes again; otherwise both hide.
' Every turn counts one turn for the player (S(UP) in the listing),
' every match one match (C(UP)); one or two players; the game ends when
' the matches chosen at the start (1-27) are found: alone, fewest turns;
' two players, most matches. From the article: an optional time limit for
' each move (20 or 30 seconds), here a draining bar; when it runs out the
' turn is lost.
' Made for this machine: cards that flip (narrowing to an edge and
' widening again), 27 shapes redrawn in colour (the listing built them
' from 3 x 3 PETSCII characters), a matched pair glowing, a cursor frame
' in the player's colour (player 1 light red on controller 1, player 2
' light green on controller 2), music under play quieter than the
' effects; an original title tune, "Recall".
'
' Controls: the stick moves the frame, the left button turns a box over.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TS0000 = 128
const TS0001 = 129
const TS0010 = 130
const TS0011 = 131
const TS0100 = 132
const TS0101 = 133
const TS0110 = 134
const TS0111 = 135
const TS0200 = 136
const TS0201 = 137
const TS0210 = 138
const TS0211 = 139
const TS0300 = 140
const TS0301 = 141
const TS0310 = 142
const TS0311 = 143
const TS0400 = 144
const TS0401 = 145
const TS0410 = 146
const TS0411 = 147
const TS0500 = 148
const TS0501 = 149
const TS0510 = 150
const TS0511 = 151
const TS0600 = 152
const TS0601 = 153
const TS0610 = 154
const TS0611 = 155
const TS0700 = 156
const TS0701 = 157
const TS0710 = 158
const TS0711 = 159
const TS0800 = 160
const TS0801 = 161
const TS0810 = 162
const TS0811 = 163
const TS0900 = 164
const TS0901 = 165
const TS0910 = 166
const TS0911 = 167
const TS1000 = 168
const TS1001 = 169
const TS1010 = 170
const TS1011 = 171
const TS1100 = 172
const TS1101 = 173
const TS1110 = 174
const TS1111 = 175
const TS1200 = 176
const TS1201 = 177
const TS1210 = 178
const TS1211 = 179
const TS1300 = 180
const TS1301 = 181
const TS1310 = 182
const TS1311 = 183
const TS1400 = 184
const TS1401 = 185
const TS1410 = 186
const TS1411 = 187
const TS1500 = 188
const TS1501 = 189
const TS1510 = 190
const TS1511 = 191
const TS1600 = 192
const TS1601 = 193
const TS1610 = 194
const TS1611 = 195
const TS1700 = 196
const TS1701 = 197
const TS1710 = 198
const TS1711 = 199
const TS1800 = 200
const TS1801 = 201
const TS1810 = 202
const TS1811 = 203
const TS1900 = 204
const TS1901 = 205
const TS1910 = 206
const TS1911 = 207
const TS2000 = 208
const TS2001 = 209
const TS2010 = 210
const TS2011 = 211
const TS2100 = 212
const TS2101 = 213
const TS2110 = 214
const TS2111 = 215
const TS2200 = 216
const TS2201 = 217
const TS2210 = 218
const TS2211 = 219
const TS2300 = 220
const TS2301 = 221
const TS2310 = 222
const TS2311 = 223
const TS2400 = 224
const TS2401 = 225
const TS2410 = 226
const TS2411 = 227
const TS2500 = 228
const TS2501 = 229
const TS2510 = 230
const TS2511 = 231
const TS2600 = 232
const TS2601 = 233
const TS2610 = 234
const TS2611 = 235
const TBack00 = 236
const TBack01 = 237
const TBack10 = 238
const TBack11 = 239
const THalfl = 240
const THalfr = 241
const TEdgel = 242
const TEdger = 243
const TGlow = 244
const TBar0 = 245
const TBar2 = 246
const TBar4 = 247
const TBar6 = 248
const TBar8 = 249
const TP1 = 250
const TP2 = 251
const SFrame = 0
const SFrame2 = 4
const NTiles8 = 992
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndPlayA = 3
const SndPlayB = 4
const SndFlip = 5
const SndMove = 6
const SndMatch = 7
const SndMiss = 8
const SndBuzz = 9
const SndTick = 10
const SndOver = 11
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the game: Deck[0..53] the shape in each box (0-26), Got[] 1 once
' matched; Pl players (1 or 2), Up the player to move (0 or 1); Nm the
' matches to find, Ma found; Tr0 Tr1 turns, Mt0 Mt1 matches (S and C in
' the listing); B1 the first box of the turn (255 none); Ph 1 while a
' player chooses (for the tests)
u8 Deck[54]
u8 Got[54]
u8 Pl = 1
u8 Up = 0
u8 Nm = 27
u8 Ma = 0
u16 Tr0 = 0
u16 Tr1 = 0
u8 Mt0 = 0
u8 Mt1 = 0
u8 B1 = 255
u8 B2 = 255
u8 Pk = 0
u8 Ph = 0
u8 Ended = 0
' the time limit: Tl 0 none, 1 20 seconds, 2 30; Bp the bar (0-200
' pixels), Fr frames a pixel, Bf frames to the next
u8 Tl = 0
u8 Bp = 200
u8 Fr = 6
u8 Bf = 6
u8 TimeUp = 0
' the cursor: column and row of the box
u8 Cx = 4
u8 Cy = 2
u8 Dir = 0
u8 Rep = 0
' the random numbers (xorshift), stirred while the title waits
u16 Rs = $5A3C
u16 Rt = 0

u16 NumU = 0
u8 Mi = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Tm = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 X1 = 0
u8 Y1 = 0
u8 Qx = 0
u8 Qy = 0
u8 Ta = 0
u8 Tb = 0
u8 Tc = 0
u8 Td = 0
u8 Idle = 0
u8 Psv = 0

  tile screen
  set sound table RmSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Mi = 4 then goto title

new_game:
  Shuffle
  for K = 0 to 53
    Got[K] = 0
  next
  Ma = 0
  Tr0 = 0
  Tr1 = 0
  Mt0 = 0
  Mt1 = 0
  Up = 0
  Cx = 4
  Cy = 2
  Ended = 0
  DrawBoard
  ShowHud
  ShowScreen
  play sound SndPlayA
  play sound SndPlayB

turn:
  if Ma >= Nm then goto game_over
  B1 = 255
  B2 = 255
  TimeUp = 0
  StartBar
  ShowHud
  Msg(0)
  WaitPick
  if TimeUp = 1 then goto time_up
  B1 = Pk
  Flip(B1, 1)
  WaitPick
  if TimeUp = 1 then goto time_up
  B2 = Pk
  Flip(B2, 1)
  V = Deck[B1]
  W = Deck[B2]
  if V = W then goto a_match
  ' no match: both stay a moment, then hide; the other player's turn
  AddTurn
  ShowHud
  Msg(2)
  play sound SndMiss
  for Tm = 1 to 70
    Frame1
    DrawCursor
  next
  Flip(B1, 0)
  Flip(B2, 0)
  if Pl = 2 then Up = Up ^ 1
  goto turn

a_match:
  Got[B1] = 1
  Got[B2] = 1
  inc Ma
  if Up = 0 then
    inc Mt0
  else
    inc Mt1
  end if
  AddTurn
  ShowHud
  Msg(1)
  play sound SndMatch
  ' the pair glows: three flashes
  for J = 1 to 3
    PutCard(B1, 4)
    PutCard(B2, 4)
    for Tm = 1 to 6
      Frame1
    next
    PutCard(B1, 1)
    PutCard(B2, 1)
    for Tm = 1 to 6
      Frame1
    next
  next
  ' a match: the same player goes again
  goto turn

time_up:
  if B1 <> 255 then
    Flip(B1, 0)
  end if
  AddTurn
  ShowHud
  Msg(3)
  play sound SndBuzz
  for Tm = 1 to 40
    Frame1
  next
  if Pl = 2 then Up = Up ^ 1
  goto turn

game_over:
  Ended = 1
  Ph = 0
  stop sound SndPlayA
  stop sound SndPlayB
  play sound SndOver
  set sprite 0 to 192,0,0,0
  update sprites
  for X = 2 to 29
    put char 32 at X,21
    put char 32 at X,22
  next
  if Pl = 1 then
    print at 2,21, "ALL"
    NumU = Nm
    print at 6,21, digits$(NumU, 2)
    print at 9,21, "MATCHES IN"
    NumU = Tr0
    print at 20,21, digits$(NumU, 3)
    print at 24,21, "TURNS"
  else
    if Mt0 > Mt1 then
      print at 2,21, "PLAYER 1 WINS"
    elseif Mt1 > Mt0 then
      print at 2,21, "PLAYER 2 WINS"
    else
      print at 2,21, "A TIE"
    end if
    NumU = Mt0
    print at 18,21, digits$(NumU, 2)
    print at 21,21, "TO"
    NumU = Mt1
    print at 24,21, digits$(NumU, 2)
  end if
  print at 2,22, "PLAY AGAIN?"
  Mi = 0
  ShowYes
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
go_loop:
  Frame1
  ReadAll
  if Lf1 = 1 then
    if Mi = 1 then
      Mi = 0
      ShowYes
      play sound SndMove
    end if
  end if
  if Rt1 = 1 then
    if Mi = 0 then
      Mi = 1
      ShowYes
      play sound SndMove
    end if
  end if
  if Press = 0 then goto go_loop
  if Mi = 0 then goto new_game
  goto title

' ShowYes: the choice after a game (Mi 0 YES, 1 NO)
sub ShowYes:
  print at 15,22, " YES   NO "
  if Mi = 0 then
    put char 62 at 15,22
  else
    put char 62 at 21,22
  end if
  return
end sub

' AddTurn: one turn for the player to move
sub AddTurn:
  if Up = 0 then
    inc Tr0
  else
    inc Tr1
  end if
  return
end sub

' Shuffle: the 27 shapes twice, mixed (Fisher-Yates)
sub Shuffle:
  for K = 0 to 53
    V = K >> 1
    Deck[K] = V
  next
  K = 53
sh_next:
  ' a random J from 0 to K
sh_try:
  Rnd16
  V = Rs & 63
  if V > K then goto sh_try
  J = V
  W = Deck[K]
  V = Deck[J]
  Deck[K] = V
  Deck[J] = W
  dec K
  if K > 0 then goto sh_next
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' WaitPick: the player moves the frame and turns a box over: Pk the box
' (a hidden box, not the first of the turn); TimeUp 1 if the bar ran out
sub WaitPick:
  Ph = 1
  Rearm
  wait
  nmi off
wp_loop:
  Frame1
  ReadPad
  MoveCursor
  DrawCursor
  if Tl > 0 then
    dec Bf
    if Bf = 0 then
      Bf = Fr
      if Bp > 0 then
        dec Bp
        BarCell
      end if
      if Bp = 0 then
        TimeUp = 1
        Ph = 0
        return
      end if
    end if
  end if
  if Press = 0 then goto wp_loop
  Pk = Cy * 9
  Pk = Pk + Cx
  V = Got[Pk]
  if V = 1 then
    play sound SndBuzz
    goto wp_loop
  end if
  if Pk = B1 then
    play sound SndBuzz
    goto wp_loop
  end if
  Ph = 0
  return
end sub

' MoveCursor: a push moves one box; held, it repeats
sub MoveCursor:
  V = 0
  if Lf1 = 1 then V = 1
  if Rt1 = 1 then V = 2
  if Up1 = 1 then V = 3
  if Dn1 = 1 then V = 4
  if V = 0 then
    Dir = 0
    return
  end if
  if V <> Dir then
    Dir = V
    Rep = 14
  else
    dec Rep
    if Rep > 0 then return
    Rep = 6
  end if
  if V = 1 then
    if Cx > 0 then dec Cx
  end if
  if V = 2 then
    if Cx < 8 then inc Cx
  end if
  if V = 3 then
    if Cy > 0 then dec Cy
  end if
  if V = 4 then
    if Cy < 5 then inc Cy
  end if
  play sound SndMove
  return
end sub

' DrawCursor: the frame over the box under the cursor, in the colour of
' the player to move
sub DrawCursor:
  X = Cx * 24
  X = X + 16
  Y = Cy * 24
  Y = Y + 23
  if Up = 0 then
    set sprite 0 to Y,X,SFrame2,9
  else
    set sprite 0 to Y,X,SFrame2,3
  end if
  update sprites
  return
end sub

' Flip(B, F): box B turns face up (F 1) or face down (F 0)
sub Flip(u8 Fb, u8 Fu):
  play sound SndFlip
  if Fu = 1 then
    PutCard(Fb, 2)
  else
    PutCard(Fb, 3)
  end if
  Frame1
  Frame1
  Frame1
  if Fu = 1 then
    PutCard(Fb, 3)
  else
    PutCard(Fb, 2)
  end if
  Frame1
  Frame1
  Frame1
  if Fu = 1 then
    PutCard(Fb, 1)
  else
    PutCard(Fb, 0)
  end if
  return
end sub

' PutCard(B, K): box B drawn as K: 0 the back, 1 its shape, 2 the back
' half as wide, 3 the edge, 4 glowing
sub PutCard(u8 Cb, u8 Ck):
  Qx = Cb
  Qy = 0
pc_div:
  if Qx >= 9 then
    Qx = Qx - 9
    inc Qy
    goto pc_div
  end if
  X = Qx * 3
  X = X + 2
  Y = Qy * 3
  Y = Y + 3
  if Ck = 0 then
    Ta = TBack00
    Tb = TBack01
    Tc = TBack10
    Td = TBack11
  end if
  if Ck = 1 then
    V = Deck[Cb]
    V = V << 2
    Ta = V + TS0000
    Tb = Ta + 1
    Tc = Ta + 2
    Td = Ta + 3
  end if
  if Ck = 2 then
    Ta = THalfl
    Tb = THalfr
    Tc = THalfl
    Td = THalfr
  end if
  if Ck = 3 then
    Ta = TEdgel
    Tb = TEdger
    Tc = TEdgel
    Td = TEdger
  end if
  if Ck = 4 then
    Ta = TGlow
    Tb = TGlow
    Tc = TGlow
    Td = TGlow
  end if
  X1 = X + 1
  Y1 = Y + 1
  put char Ta at X,Y
  put char Tb at X1,Y
  put char Tc at X,Y1
  put char Td at X1,Y1
  return
end sub

' DrawBoard: every box face down
sub DrawBoard:
  NewScreen
  for K = 0 to 53
    PutCard(K, 0)
  next
  return
end sub

' StartBar: the time bar full (row 21), or nothing without a limit
sub StartBar:
  if Tl = 0 then return
  Bp = 200
  if Tl = 1 then
    Fr = 6
  else
    Fr = 9
  end if
  Bf = Fr
  for X = 3 to 27
    put char TBar8 at X,21
  next
  return
end sub

' BarCell: after the bar lost a pixel, its last cell (and the one after)
sub BarCell:
  V = Bp >> 3
  W = Bp & 7
  W = W >> 1
  W = W + TBar0
  X = V + 3
  put char W at X,21
  if V < 24 then
    inc X
    put char TBar0 at X,21
  end if
  return
end sub

' ShowHud: row 1: matches and turns (two players: each, the block marks
' whose turn it is)
sub ShowHud:
  if Pl = 1 then
    print at 2,1, "MATCHES"
    NumU = Mt0
    print at 10,1, digits$(NumU, 2)
    print at 12,1, "/"
    NumU = Nm
    print at 13,1, digits$(NumU, 2)
    print at 18,1, "TURNS"
    NumU = Tr0
    print at 24,1, digits$(NumU, 3)
    return
  end if
  if Up = 0 then
    put char TP1 at 2,1
    put char 32 at 29,1
  else
    put char 32 at 2,1
    put char TP2 at 29,1
  end if
  print at 3,1, "P1"
  NumU = Mt0
  print at 6,1, digits$(NumU, 2)
  NumU = Tr0
  print at 9,1, digits$(NumU, 3)
  print at 14,1, "/"
  NumU = Nm
  print at 15,1, digits$(NumU, 2)
  NumU = Tr1
  print at 19,1, digits$(NumU, 3)
  NumU = Mt1
  print at 23,1, digits$(NumU, 2)
  print at 26,1, "P2"
  return
end sub

' Msg(N): the message row 22: 0 whose turn, 1 a match, 2 no match, 3 time
sub Msg(u8 Mn):
  print at 2,22, "                            "
  if Mn = 0 then
    if Pl = 2 then
      if Up = 0 then
        print at 2,22, "PLAYER 1: YOUR TURN"
      else
        print at 2,22, "PLAYER 2: YOUR TURN"
      end if
    else
      print at 2,22, "FIND THE PAIRS"
    end if
  end if
  if Mn = 1 then
    print at 2,22, "A MATCH! GO AGAIN"
  end if
  if Mn = 2 then
    print at 2,22, "NO MATCH"
  end if
  if Mn = 3 then
    print at 2,22, "TIME IS UP!"
  end if
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: the stick and left button of the player to move (two players:
' player 1 controller 1, player 2 controller 2; one player: either)
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  V = 1
  W = 1
  if Pl = 2 then
    if Up = 0 then W = 0
    if Up = 1 then V = 0
  end if
  if V = 1 then
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).button1 then Btn = 1
  end if
  if W = 1 then
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).button1 then Btn = 1
  end if
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' ReadAll: both controllers, a push counted once (menus)
sub ReadAll:
  Psv = Pl
  Pl = 1
  ReadPad
  Pl = Psv
  V = Lf1 | Rt1
  V = V | Up1
  V = V | Dn1
  if V = 1 then
    if WasStick = 1 then
      Lf1 = 0
      Rt1 = 0
      Up1 = 0
      Dn1 = 0
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a row of cards turning, the options
sub TitlePage:
  Ended = 0
  NewScreen
  print at 11,1, "REMEMORY"
  print at 4,6, "HOW GOOD IS YOUR MEMORY?"
  for K = 0 to 8
    Deck[K] = K
    PutCard(K, 1)
  next
  print at 7,10, "PLAYERS"
  print at 7,12, "MATCHES"
  print at 7,14, "TIME"
  print at 7,16, "START"
  print at 7,18, "CREDITS"
  print at 3,21, "LEFT, RIGHT: CHANGE"
  Mi = 3
  ShowOptions
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Ph = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadAll
  ' the random numbers: stirred every frame the title waits
  Rnd16
  ' the shapes along the top turn over one after another
  V = Tick & 15
  if V = 0 then
    K = Tick >> 4
    K = K & 7
    Rnd16
    V = Rs & 31
    if V < 27 then
      Deck[K] = V
    end if
    PutCard(K, 1)
  end if
  if Up1 = 1 then
    if Mi > 0 then
      dec Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  if Dn1 = 1 then
    if Mi < 4 then
      inc Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  V = Lf1 | Rt1
  if V = 1 then
    ChangeOpt
    play sound SndMove
    ShowOptions
  end if
  if Press = 0 then goto tp_loop
  if Mi < 3 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Mi = 4 then CreditsPage
  return
end sub

' ChangeOpt: left or right on the line chosen
sub ChangeOpt:
  if Mi = 0 then Pl = 3 - Pl
  if Mi = 1 then
    if Lf1 = 1 then
      dec Nm
      if Nm = 0 then Nm = 27
    else
      inc Nm
      if Nm > 27 then Nm = 1
    end if
  end if
  if Mi = 2 then
    if Rt1 = 1 then
      inc Tl
      if Tl > 2 then Tl = 0
    else
      if Tl = 0 then
        Tl = 2
      else
        dec Tl
      end if
    end if
  end if
  return
end sub

sub ShowOptions:
  for J = 10 to 18
    put char 32 at 5,J
  next
  V = Mi << 1
  V = V + 10
  put char 62 at 5,V
  NumU = Pl
  print at 16,10, digits$(NumU, 1)
  NumU = Nm
  print at 16,12, digits$(NumU, 2)
  if Tl = 0 then
    print at 16,14, "NONE   "
  end if
  if Tl = 1 then
    print at 16,14, "20 SECS"
  end if
  if Tl = 2 then
    print at 16,14, "30 SECS"
  end if
  return
end sub

sub CreditsPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  for X = 2 to 29
    put char TP1 at X,2
    put char TP2 at X,21
  next
  print at 11,4, "REMEMORY"
  print at 3,6, "BASED ON REMEMORY BY"
  print at 3,7, "CHARLES HARBERT, COMPUTE!"
  print at 3,8, "MAY 1987 (C64; VERSIONS BY"
  print at 3,9, "THE MAGAZINE'S PROGRAMMERS)."
  print at 3,11, "MADE FOR THE COLECOVISION"
  print at 3,12, "BY CLAUDE (AN AI MADE BY"
  print at 3,13, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,14, "2026, IN AMY BY AMY BIENVENU."
  print at 3,16, "MUSIC: RECALL, DEEP THINK"
  print at 8,19, "PRESS A BUTTON"
  screen on
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
cr_loop:
  Frame1
  ReadAll
  if Press = 0 then goto cr_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

