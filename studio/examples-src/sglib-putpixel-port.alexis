' Amy equivalent of the SGlib putPixel demo by sverx (2025).

const PixelCount = 6
const ScreenHeight = 192

data PixelColors bytes 3,4,7,8,10,15
data InitialX bytes 3,37,240,45,87,100
data InitialY bytes 123,99,3,15,200,22
data InitialDirection bytes 0,1,3,2,0,1

u8 X[PixelCount]
u8 Y[PixelCount]
u8 Direction[PixelCount]
u8 Pixel = 0

copy InitialX to X
copy InitialY to Y
copy InitialDirection to Direction

bitmap screen color $30
cls
screen on

MainLoop:
  wait
  if joypad(1).button1.pressed or joypad(1).button2.pressed or joypad(2).button1.pressed or joypad(2).button2.pressed then
    for Pixel = 0 to PixelCount - 1
      Direction[Pixel] += 1
      if Direction[Pixel] = 4 then Direction[Pixel] = 0
    next
  else
    nmi off
    for Pixel = 0 to PixelCount - 1
      select case Direction[Pixel]
      case 0
        X[Pixel] += 1
        Y[Pixel] += 1
        if Y[Pixel] >= ScreenHeight then Y[Pixel] -= ScreenHeight
      case 1
        X[Pixel] += 1
        Y[Pixel] -= 1
        if Y[Pixel] >= ScreenHeight then Y[Pixel] += ScreenHeight
      case 2
        X[Pixel] -= 1
        Y[Pixel] -= 1
        if Y[Pixel] >= ScreenHeight then Y[Pixel] += ScreenHeight
      case else
        X[Pixel] -= 1
        Y[Pixel] += 1
        if Y[Pixel] >= ScreenHeight then Y[Pixel] -= ScreenHeight
      end select
      pset X[Pixel],Y[Pixel] color PixelColors[Pixel]
    next
    nmi on
  end if
goto MainLoop
