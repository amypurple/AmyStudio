cartridge "LOTTO GENERATOR/RON MITCHELL'S/2026"

const CanadaMin = 1
const CanadaMax = 49
const UsaMin = 1
const UsaMax = 69
const BonusMin = 1
const BonusMax = 26

' Animation / UI
u8 SpinCounter = 0

' Canada 6/49
u8 CA1 = 0
u8 CA2 = 0
u8 CA3 = 0
u8 CA4 = 0
u8 CA5 = 0
u8 CA6 = 0

' USA 5/69 + bonus
u8 US1 = 0
u8 US2 = 0
u8 US3 = 0
u8 US4 = 0
u8 US5 = 0
u8 USBonus = 0

' Button 1 spins Canada 6/49, button 2 spins USA 5/69 + bonus.
  text screen
  print at 6,1, "LOTTERY TICKET DEMO"
  print at 4,4, "BUTTON1 = CANADA 6/49"
  print at 4,5, "BUTTON2 = USA 5/69+26"
  print at 2,9, "CANADA:"
  print at 2,13, "USA:"
  print CA1 at 11,9 digits 2
  print CA2 at 14,9 digits 2
  print CA3 at 17,9 digits 2
  print CA4 at 20,9 digits 2
  print CA5 at 23,9 digits 2
  print CA6 at 26,9 digits 2
  print US1 at 8,13 digits 2
  print US2 at 11,13 digits 2
  print US3 at 14,13 digits 2
  print US4 at 17,13 digits 2
  print US5 at 20,13 digits 2
  print USBonus at 26,13 digits 2
  screen on
MainLoop:
  if joypad(1).button1 then
    goto GenerateCanada
  elseif joypad(1).button2 then
    goto GenerateUsa
  end if
  wait
  goto MainLoop
GenerateCanada:
  SpinCounter = 12
CanadaSpinLoop:
  CA1 = random(CanadaMin, CanadaMax)
CanadaPick2:
  CA2 = random(CanadaMin, CanadaMax)
  if CA2 = CA1 goto CanadaPick2
CanadaPick3:
  CA3 = random(CanadaMin, CanadaMax)
  if CA3 = CA1 goto CanadaPick3
  if CA3 = CA2 goto CanadaPick3
CanadaPick4:
  CA4 = random(CanadaMin, CanadaMax)
  if CA4 = CA1 goto CanadaPick4
  if CA4 = CA2 goto CanadaPick4
  if CA4 = CA3 goto CanadaPick4
CanadaPick5:
  CA5 = random(CanadaMin, CanadaMax)
  if CA5 = CA1 goto CanadaPick5
  if CA5 = CA2 goto CanadaPick5
  if CA5 = CA3 goto CanadaPick5
  if CA5 = CA4 goto CanadaPick5
CanadaPick6:
  CA6 = random(CanadaMin, CanadaMax)
  if CA6 = CA1 goto CanadaPick6
  if CA6 = CA2 goto CanadaPick6
  if CA6 = CA3 goto CanadaPick6
  if CA6 = CA4 goto CanadaPick6
  if CA6 = CA5 goto CanadaPick6
  print CA1 at 11,9 digits 2
  print CA2 at 14,9 digits 2
  print CA3 at 17,9 digits 2
  print CA4 at 20,9 digits 2
  print CA5 at 23,9 digits 2
  print CA6 at 26,9 digits 2
  wait 2 frames
  SpinCounter -= 1
  if SpinCounter > 0 then
    goto CanadaSpinLoop
  end if
CanadaRelease:
  if joypad(1).button1 then
    goto CanadaRelease
  end if
  goto MainLoop
GenerateUsa:
  SpinCounter = 12
UsaSpinLoop:
  US1 = random(UsaMin, UsaMax)
UsaPick2:
  US2 = random(UsaMin, UsaMax)
  if US2 = US1 goto UsaPick2
UsaPick3:
  US3 = random(UsaMin, UsaMax)
  if US3 = US1 goto UsaPick3
  if US3 = US2 goto UsaPick3
UsaPick4:
  US4 = random(UsaMin, UsaMax)
  if US4 = US1 goto UsaPick4
  if US4 = US2 goto UsaPick4
  if US4 = US3 goto UsaPick4
UsaPick5:
  US5 = random(UsaMin, UsaMax)
  if US5 = US1 goto UsaPick5
  if US5 = US2 goto UsaPick5
  if US5 = US3 goto UsaPick5
  if US5 = US4 goto UsaPick5
  USBonus = random(BonusMin, BonusMax)
  print US1 at 8,13 digits 2
  print US2 at 11,13 digits 2
  print US3 at 14,13 digits 2
  print US4 at 17,13 digits 2
  print US5 at 20,13 digits 2
  print USBonus at 26,13 digits 2
  wait 2 frames
  SpinCounter -= 1
  if SpinCounter > 0 then
    goto UsaSpinLoop
  end if
UsaRelease:
  if joypad(1).button2 then
    goto UsaRelease
  end if
  goto MainLoop
end sub