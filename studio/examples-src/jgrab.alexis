  tile screen
  set sound table JgSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  if Over = 0 then goto play_loop

  ' the end: GAME OVER or YOU WIN, then back to the title on a press
  if Score > Hi then Hi = Score
  mute all
  print at 8,10, "              "
  if Won = 1 then
    print at 8,11, "   YOU WIN!   "
    play sound SndWin
  else
    print at 8,11, "  GAME  OVER  "
    play sound SndOver
  end if
  print at 8,12, "              "
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one video frame of play: a pass of the game every PassN frames, the
' sprites gliding from the pass's start to its end in between
sub PlayFrame:
  inc Twk
  if Twk >= 20 then
    Twk = 0
    TwinkleGems
  end if
  select case Phase
    case 0
      inc Fc
      if Fc >= PassN then
        Fc = 0
        PassStep
      end if
      DrawSprites
    case 1
      DyingFrame
    case 2
      ClearFrame
  end select
  return
end sub

' the C64's main loop, one pass
sub PassStep:
  u8 Skip
  u8 Done
  inc Passes
  SaveOld
  Skip = 0
  Done = 0
  if Jmp = 0 then
    if FallC = 0 then
      Joy = J1
      V = Joy & 16
      if V = 0 then
        FireL = 0
      else
        if FireL = 1 then
          Skip = 1
        else
          Jmp = 4
          FireL = 1
          play sound SndJump
        end if
      end if
    end if
  end if
  if Skip = 0 then
    Done = Actions()
    if Done = 0 then GemCheck
  end if
  if JewLeft = 0 then
    ScreenDone
  else
    MoveMiner
    MoveBombs
    Touches
    if FrzT > 0 then dec FrzT
    if Safe > 0 then dec Safe
  end if
  return
end sub

' the sprites' positions at the start of the pass (they glide from there)
sub SaveOld:
  OPx = Px
  OPy = Py
  for Mi = 0 to NMons - 1
    Mons[Mi].OX = Mons[Mi].X
    Mons[Mi].OY = Mons[Mi].Y
  next
  return
end sub

' what kind of cell: 0 empty, 1 block, 2 ladder, 3 gem, 4 solid
function CellK(u8 Cc, u8 Rr) as u8
  u8 Ch
  u8 R
  R = 4
  if Cc < 2 then return R
  if Cc > 29 then return R
  if Rr < 2 then return R
  Ch = get char at Cc, Rr
  select case Ch
    case 32, TBg0, TBg1, TBg2, TBg3
      R = 0
    case TBlock
      R = 1
    case TLadder
      R = 2
    case TJewel
      R = 3
  end select
  return R

' the background tile of an empty cell
function BgAt(u8 Cc, u8 Rr) as u8
  u8 B
  B = Cc * 7 + Rr * 13
  B = B & 15
  if B < 3 then
    B = B + TBg1
  else
    B = TBg0
  end if
  return B

' take or put a block (down + button) or a ladder (up + button alone);
' 1 when one was taken or put (or a block try failed), which also ends a jump
function Actions() as u8
  u8 Dc
  u8 Dr
  u8 Kd
  u8 R
  R = 0
  V = Joy & 18
  if V = 18 then
    Dr = Pr + 2
    if Face = 0 then
      Dc = Pc + 1
    else
      Dc = Pc - 1
    end if
    Kd = CellK(Dc, Dr)
    if Kd = 0 then
      if InvB > 0 then
        dec InvB
        put char TBlock at Dc, Dr
        play sound SndPut
      end if
      R = 1
    end if
    if Kd = 1 then
      if InvB < 4 then
        inc InvB
        put char BgAt(Dc, Dr) at Dc, Dr
        play sound SndTake
      end if
      R = 1
    end if
    if R = 1 then
      Joy = 0
      Jmp = 0
      ShowInv
      return R
    end if
  end if
  if Joy = 17 then
    Dr = Pr + 1
    Kd = CellK(Pc, Dr)
    if Kd = 0 then
      if InvL > 0 then
        dec InvL
        put char TLadder at Pc, Dr
        play sound SndPut
        R = 1
      end if
    end if
    if Kd = 2 then
      if InvL < 4 then
        inc InvL
        put char BgAt(Pc, Dr) at Pc, Dr
        play sound SndTake
        R = 1
      end if
    end if
    if R = 1 then
      Joy = 0
      Jmp = 0
      ShowInv
    end if
  end if
  return R

' a gem at the miner's body, else at his legs: 100
sub GemCheck:
  u8 Gr
  Gr = Pr
  K = CellK(Pc, Gr)
  if K <> 3 then
    Gr = Pr + 1
    K = CellK(Pc, Gr)
  end if
  if K <> 3 then return
  put char BgAt(Pc, Gr) at Pc, Gr
  Score += 100
  inc Gems
  ShowScore
  play sound SndGem
  dec JewLeft
  return
end sub

' jump, fall, walk, climb: every test on the cells where the pass began
sub MoveMiner:
  i8 Dr
  u8 Kb
  u8 Kl
  u8 Kf
  u8 Kh
  u8 Nc
  Dr = 0
  Nc = Pc
  Kb = CellK(Pc, Pr)
  Kl = CellK(Pc, Pr + 1)
  Kf = CellK(Pc, Pr + 2)
  if Jmp > 0 then
    dec Jmp
    if Jmp = 0 then FallC = 1
    Kh = CellK(Pc, Pr - 1)
    if Kh = 0 then Dr = -1
    if Kh = 3 then Dr = -1
  else
    if Kf = 0 or Kf = 3 then
      if Kb = 2 or Kl = 2 then
        FallC = 0
      else
        Dr = 1
        inc FallC
      end if
    else
      FallC = 0
    end if
  end if
  V = Joy & 8
  if V > 0 then
    K = CellK(Pc + 1, Pr + 1)
    if K <> 1 and K <> 4 then
      Nc = Pc + 1
      Face = 0
      Pose = 0
      WalkI = (WalkI + 1) & 3
    end if
  end if
  V = Joy & 4
  if V > 0 then
    K = CellK(Pc - 1, Pr + 1)
    if K <> 1 and K <> 4 then
      Nc = Pc - 1
      Face = 1
      Pose = 0
      WalkI = (WalkI + 1) & 3
    end if
  end if
  V = Joy & 1
  if V > 0 then
    if Kb = 2 or Kb = 3 or Kl = 2 then
      Dr = Dr - 1
      Pose = 1
      ClimbI = ClimbI xor 1
    end if
  end if
  V = Joy & 2
  if V > 0 then
    K = 0
    if Kf = 2 or Kf = 3 then K = 1
    if Kf = 0 and Kl = 2 then K = 1
    if K = 1 then
      Dr = Dr + 1
      Pose = 1
      ClimbI = ClimbI xor 1
    end if
  end if
  Pc = Nc
  Pr = Pr + Dr
  if Pr < 2 then Pr = 2
  Px = Pc * 8 - 4
  Py = Pr * 8
  return
end sub

' the bombs (C64 $0BD0-$0CBA)
sub MoveBombs:
  if MonDelay > 0 then
    dec MonDelay
  else
    if FrzT = 0 then BombsGo
  end if
  return
end sub

sub BombsGo:
  u8 Bx
  u8 By
  u8 S
  for Mi = 0 to NMons - 1
    if Mons[Mi].Wt > 0 then
      dec Mons[Mi].Wt
      V = Mons[Mi].Wt
      Mons[Mi].Pat = WaitPat[V]
      Mons[Mi].RT = LRet
    else
      if Mons[Mi].Pat = SBf0 then
        Mons[Mi].Pat = SBf1
      else
        Mons[Mi].Pat = SBf0
      end if
      Bx = Mons[Mi].X
      By = Mons[Mi].Y
      S = MSpd
      if Mons[Mi].DX = 1 then
        if Bx > 226 - S then
          Bx = 226
        else
          Bx = Bx + S
        end if
      else
        if Bx < 14 + S then
          Bx = 14
        else
          Bx = Bx - S
        end if
      end if
      if Mons[Mi].DY = 1 then
        if By < 16 + S then
          By = 16
        else
          By = By - S
        end if
      else
        if By > 166 - S then
          By = 166
        else
          By = By + S
        end if
      end if
      Mons[Mi].X = Bx
      Mons[Mi].Y = By
      dec Mons[Mi].StepC
      if Mons[Mi].StepC = 0 then
        dec Mons[Mi].RT
        if Mons[Mi].RT = 0 then
          Mons[Mi].Wt = 9
          Mons[Mi].TX = Px
          Mons[Mi].TY = Py
          play sound SndFuse
        end if
        Mons[Mi].StepC = LStep
        if Bx >= Mons[Mi].TX then
          Mons[Mi].DX = 0
        else
          Mons[Mi].DX = 1
        end if
        if By >= Mons[Mi].TY then
          Mons[Mi].DY = 1
        else
          Mons[Mi].DY = 0
        end if
      end if
    end if
  next
  return
end sub

' 1 when box A (x a0..a1) overlaps box B (b0..b1) on one axis
function Over1(u8 A0, u8 A1, u8 B0, u8 B1) as u8
  u8 R
  R = 1
  if A1 < B0 then R = 0
  if B1 < A0 then R = 0
  return R

' the goblet first (as the C64), else any bomb: a life lost
sub Touches:
  u8 Hx
  u8 Hy
  u8 Hit
  Hx = Px + 5
  Hy = Py + 1
  Hit = 0
  if BonOn = 1 then
    K = Over1(Hx, Hx + 5, BonX + 2, BonX + 13)
    if K = 1 then
      K = Over1(Hy, Hy + 14, BonY + 2, BonY + 13)
      if K = 1 then
        BonOn = 0
        FrzT = FrzLen
        Score += 200
        ShowScore
        play sound SndBonus
        Hit = 2
      end if
    end if
  end if
  if Hit = 0 then
    if Safe = 0 then BombHit
  end if
  return
end sub

sub BombHit:
  u8 Hx
  u8 Hy
  u8 Hit
  Hx = Px + 5
  Hy = Py + 1
  Hit = 0
  for Mi = 0 to NMons - 1
    K = Over1(Hx, Hx + 5, Mons[Mi].X + 2, Mons[Mi].X + 13)
    if K = 1 then
      K = Over1(Hy, Hy + 14, Mons[Mi].Y + 3, Mons[Mi].Y + 15)
      if K = 1 then Hit = 1
    end if
  next
  if Hit = 1 then
    Phase = 1
    Timer = 72
    inc Deaths
    play sound SndBoom
    play sound SndDie
  end if
  return
end sub

' the miner blinks (3 a second), then a life goes and the screen restarts
sub DyingFrame:
  dec Timer
  Fc = PassN - 1
  DrawSprites
  if Timer > 0 then return
  if Lives = 0 then
    Over = 1
    return
  end if
  dec Lives
  StartScreen
  Safe = SafeLen
  return
end sub

' a screen cleared: one more life (10 at most), the next screen or round
sub ScreenDone:
  Phase = 2
  Timer = 60
  mute all
  play sound SndClear
  return
end sub

sub ClearFrame:
  dec Timer
  Fc = PassN - 1
  DrawSprites
  if Timer > 0 then return
  if Lives < MaxLives then inc Lives
  inc Scr
  if Scr = 6 then
    Scr = 0
    inc Rd
    if Rd = 5 then
      Won = 1
      Over = 1
      return
    end if
  end if
  StartScreen
  return
end sub

' gems twinkle: the gem tile's pattern changes every 20 frames
sub TwinkleGems:
  Mix = Mix xor 1
  if Mix = 1 then
    copy TilePat + 56 count 8 to vram.pattern + 1072
    copy TilePat + 56 count 8 to vram.pattern + 3120
    copy TilePat + 56 count 8 to vram.pattern + 5168
  else
    copy TilePat + 48 count 8 to vram.pattern + 1072
    copy TilePat + 48 count 8 to vram.pattern + 3120
    copy TilePat + 48 count 8 to vram.pattern + 5168
  end if
  return
end sub

' ---------------------------------------------------------------------------
' a sprite coordinate on its way from O (pass start) to N (pass end)
function Tw(u8 O, u8 N) as u8
  i16 D
  u8 F
  u8 R
  F = Fc + 1
  D = N
  D = D - O
  D = D * F
  D = D / PassN
  R = O + D
  return R

' sprites 0-1 the miner (detail, body), 2-5 the bombs, 6 the goblet
sub DrawSprites:
  u8 Sx
  u8 Sy
  u8 P
  u8 Cl
  Sx = Tw(OPx, Px)
  Sy = Tw(OPy, Py) - 1
  if Pose = 1 then
    P = ClimbI * 8 + SC0d
  else
    P = WalkI
    if P = 3 then P = 1
    P = P * 16 + Face * 8
  end if
  V = 0
  if Phase = 1 then
    V = Timer / 12
    V = V & 1
  end if
  if Safe > 0 then
    V = Tick / 12
    V = V & 1
  end if
  if V = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  else
    set sprite 0 to Sy,Sx,P,9
    set sprite 1 to Sy,Sx,P + 4,3
  end if
  Cl = 8
  if FrzT > 0 then Cl = 14
  for Ds = 0 to NMon - 1
    if Ds < NMons then
      Sx = Tw(Mons[Ds].OX, Mons[Ds].X)
      Sy = Tw(Mons[Ds].OY, Mons[Ds].Y) - 1
      set sprite Ds + 2 to Sy,Sx,Mons[Ds].Pat,Cl
    else
      set sprite Ds + 2 to 192,0,0,0
    end if
  next
  if BonOn = 1 then
    set sprite 6 to BonY - 1,BonX,SGoblet,11
  else
    set sprite 6 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
sub ShowScore:
  print at 23,1, Score
  return
end sub

' the ladders and blocks in hand, four slots each
sub ShowInv:
  for J = 0 to 3
    if J < InvL then
      put char TLadder at 13 + J, 1
    else
      put char TSlot at 13 + J, 1
    end if
    if J < InvB then
      put char TBlock at 18 + J, 1
    else
      put char TSlot at 18 + J, 1
    end if
  next
  return
end sub

sub ShowLives:
  fill 32 count 10 at 2,1
  if Lives > 0 then fill TLife count Lives at 2,1
  return
end sub

' a screen from the table: the cavern, the floor, blocks, ladders, gems
sub DrawLevel:
  u8 Nb
  u8 Cc
  u8 Rr
  u8 Ln
  u8 R
  for R = 2 to 21
    for Cc = 2 to 29
      put char BgAt(Cc, R) at Cc, R
    next
  next
  fill TFloor count 28 at 2,22
  Lp = LvOfs[Scr]
  Nb = LvData[Lp]
  inc Lp
  for Li = 1 to Nb
    Cc = LvData[Lp]
    Rr = LvData[Lp + 1]
    Ln = LvData[Lp + 2]
    Lp = Lp + 3
    fill TBlock count Ln at Cc, Rr
  next
  Nb = LvData[Lp]
  inc Lp
  for Li = 1 to Nb
    Cc = LvData[Lp]
    Rr = LvData[Lp + 1]
    Ln = LvData[Lp + 2]
    Lp = Lp + 3
    for R = 0 to Ln - 1
      put char TLadder at Cc, Rr + R
    next
  next
  Nb = LvData[Lp]
  inc Lp
  JewLeft = Nb
  for Li = 1 to Nb
    Cc = LvData[Lp]
    Rr = LvData[Lp + 1]
    Lp = Lp + 2
    put char TJewel at Cc, Rr
  next
  ' the C64's speed less round / 2, times 3/4 for the smaller cavern
  K = Rd / 2
  MSpd = LvData[Lp] - K
  MSpd = (MSpd * 3 + 2) / 4
  LStep = LvData[Lp + 1]
  LRet = LvData[Lp + 2]
  BonX = LvData[Lp + 3]
  BonY = LvData[Lp + 4]
  return
end sub

' the bombs at their corners, turn counters from the clock (1, 3, 5, 7)
sub SetBombs:
  u8 Rv
  for Mi = 0 to NMon - 1
    Rv = random(0, 255) + Tick
    Rv = Rv + Mi * 3
    Mons[Mi].X = MonX[Mi]
    Mons[Mi].Y = MonY[Mi]
    Mons[Mi].OX = MonX[Mi]
    Mons[Mi].OY = MonY[Mi]
    Mons[Mi].DX = Rv & 1
    Mons[Mi].DY = Rv & 1
    K = (Rv | 1) & 7
    Mons[Mi].StepC = K
    Mons[Mi].RT = K
    Mons[Mi].Wt = 0
    Mons[Mi].TX = StartC * 8 - 4
    Mons[Mi].TY = StartR * 8
    Mons[Mi].Pat = SBf0
  next
  return
end sub

' the ROUND / SCREEN card, then the screen as new
sub StartScreen:
  NewScreen
  NumU = Rd
  print at 11,9, "ROUND ", digits$(NumU, 1)
  NumU = Scr + 1
  print at 10,11, "SCREEN ", digits$(NumU, 1)
  ShowScreen
  play sound SndStart
  Rearm
  wait 60 frames
  nmi off
  NewScreen
  DrawLevel
  ShowLives
  InvL = 0
  InvB = 0
  ShowInv
  ShowScore
  Pc = StartC
  Pr = StartR
  Px = Pc * 8 - 4
  Py = Pr * 8
  OPx = Px
  OPy = Py
  Jmp = 0
  FallC = 0
  Joy = 0
  Face = 0
  Pose = 0
  WalkI = 0
  NMons = Rd
  if Spd = 1 then
    if Rd > 1 then NMons = Rd - 1
  end if
  Safe = 0
  SetBombs
  MonDelay = StartWait
  FrzT = 0
  BonOn = 1
  Phase = 0
  Fc = 0
  DrawSprites
  ShowScreen
  return
end sub

sub NewGame:
  Score = 0
  Lives = 4
  Scr = 0
  Rd = 1
  Over = 0
  Won = 0
  Deaths = 0
  Gems = 0
  FireL = 1
  PassN = PassLen[Spd - 1]
  StartScreen
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo in gem and stone bricks, a bomb drifting, START /
' SPEED / CREDITS, the best score, the tune once
sub TitlePage:
  u8 Tr
  NewScreen
  for Tr = 0 to 10
    for J = 0 to 27
      Lp = Tr
      Lp = Lp * 28 + J
      V = TitleMap[Lp]
      if V > 0 then put char V at J + 2, Tr + 3
    next
  next
  print at 7,15, "COMPUTE!'S GAZETTE"
  print at 10,16, "JANUARY 1989"
  print at 12,18, "START"
  print at 12,19, "SPEED"
  print at 12,20, "CREDITS"
  if Hi > 0 then
    print at 2,22, "BEST"
    print at 7,22, Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 456
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitleAnim
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      end if
      K = V & 2
      if K > 0 then
        if Menu < 2 then inc Menu
      end if
      K = V & 12
      if K > 0 then
        if Menu = 1 then
          if K = 4 then
            if Spd > 1 then dec Spd
          else
            if Spd < 4 then inc Spd
          end if
        end if
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 1 then
    inc Spd
    if Spd > 4 then Spd = 1
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

' a bomb drifts to and fro under the logo
sub TitleAnim:
  V = Tick & 127
  if V < 64 then
    X = V * 2 + 60
  else
    X = 188 - (V - 64) * 2
  end if
  K = Tick / 16
  K = K & 1
  set sprite 2 to 7,X,SBf0 + K * 4,8
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,18
  put char 32 at 10,19
  put char 32 at 10,20
  J = Menu + 18
  put char 62 at 10,J
  NumU = Spd
  print at 18,19, digits$(NumU, 1)
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "JEWEL GRAB"
  print at 2,4, "BASED ON JEWEL GRAB,"
  print at 2,5, "COMPUTE!'S GAZETTE DISK,"
  print at 2,6, "JANUARY 1989 (COMMODORE 64"
  print at 2,7, "MACHINE LANGUAGE)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "MUSIC: GLITTER IN THE DEEP"
  print at 2,16, "(ORIGINAL)"
  print at 2,18, "DOWN+BUTTON: BLOCKS"
  print at 2,19, "UP+BUTTON: LADDERS"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

