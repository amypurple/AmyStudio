u8 SpriteX = 148
u8 SpriteY = 116

u8 SpriteColor = 10
u16 State = 0
u8 Delay = 1

u8 DrawY = 115

data SpriteBitmap sprite16
  "......XXXX......"
  "......XXXX......"
  "......XXXX......"
  "......XXXX......"
  ".......XX......."
  "..X....XX......."
  ".XXXXXXXXXXX...."
  ".XXXXXXXXXXXX..."
  ".......XX...XX.."
  ".......XX....XX."
  "......XXXX....XX"
  ".....XX..XX....."
  ".....XX..XX....."
  ".....XX..XX....."
  ".....XX..XX....."
  "....XXX..XXX...."
end data

  text screen
  sprites 16x16
  sprites simple
  copy SpriteBitmap to vram.spr_pat
  clear sprites
  set sprite count 1
  screen on
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "SELECT CASE MOVEMENT"
  print centered at 14, "PRESS FIRE"
  pause until press
  wait no fire
  cls
game_loop:
  DrawY = SpriteY - 1
  set sprite 0 to DrawY,SpriteX,0,SpriteColor
  update sprites
  wait 2 frames
  Delay -= 1
  if Delay = 0 then
    Delay = 40
    State += 1
    if State = 10 then State = 1
  end if
  select case State
  case 1
    SpriteColor = 10
    SpriteX -= 1
    SpriteX -= 1
  case 2
    SpriteY -= 1
    SpriteY -= 1
  case 3
    SpriteX += 1
    SpriteX += 1
  case 4
    SpriteY += 1
    SpriteY += 1
  case 5 to 6
    SpriteX -= 1
    SpriteY -= 1
  case 7 to 8
    SpriteX += 1
    SpriteY += 1
  case else
    SpriteColor = random(2, 15)
  end select
  goto game_loop