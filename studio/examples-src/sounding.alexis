asm {
SgHush:
    db $00,$00,$F4,$01,$10
SgClick:
    db $40,$2F,$10,$01,$40,$25,$20,$01,$40,$1F,$40,$01,$40,$FE,$F0,$01,$50
SgEcho0:
    db $40,$33,$30,$01,$40,$33,$60,$01,$40,$FE,$F0,$01,$50
SgEcho1:
    db $40,$3E,$50,$01,$40,$3E,$80,$01,$40,$FE,$F0,$01,$50
SgEcho2:
    db $40,$50,$70,$01,$40,$50,$A0,$01,$40,$FE,$F0,$01,$50
SgEcho3:
    db $40,$66,$90,$01,$40,$66,$C0,$01,$40,$FE,$F0,$01,$50
SgDrip:
    db $40,$23,$50,$01,$40,$2B,$60,$01,$40,$35,$80,$01,$40,$42,$B0,$02,$40,$FE,$F0,$01,$50
SgThud:
    db $00,$00,$36,$02,$00,$00,$76,$02,$00,$00,$F6,$01,$10
SgMoth:
    db $40,$47,$20,$03,$40,$35,$20,$03,$40,$2A,$20,$03,$40,$24,$40,$04,$40,$FE,$F0,$01,$50
SgSlither0:
    db $00,$00,$51,$02,$00,$00,$81,$02,$00,$00,$F1,$01,$10
SgSlither1:
    db $00,$00,$81,$02,$00,$00,$B1,$02,$00,$00,$F1,$01,$10
SgSlither2:
    db $00,$00,$B1,$02,$00,$00,$D1,$02,$00,$00,$F1,$01,$10
SgBreeze:
    db $00,$00,$B5,$03,$00,$00,$95,$04,$00,$00,$A5,$04,$00,$00,$C5,$04,$00,$00,$E5,$03,$00,$00,$F5,$01
    db $10
SgCrack:
    db $00,$00,$45,$02,$00,$00,$F5,$03,$00,$00,$55,$02,$00,$00,$F5,$03,$00,$00,$65,$02,$00,$00,$F5,$01
    db $10
SgCrash:
    db $00,$00,$06,$03,$00,$00,$26,$04,$00,$00,$56,$06,$00,$00,$96,$08,$00,$00,$F6,$01,$10
SgWeb:
    db $40,$53,$41,$03,$40,$68,$41,$03,$40,$53,$51,$03,$40,$68,$61,$03,$40,$7C,$81,$03,$40,$FE,$F0,$01
    db $50
SgHoot:
    db $40,$1D,$31,$0A,$40,$1D,$F1,$04,$40,$41,$41,$10,$40,$FE,$F0,$01,$50
SgRiver:
    db $00,$00,$C7,$04,$00,$00,$B7,$04,$00,$00,$D7,$04,$00,$00,$C7,$04,$00,$00,$F7,$01,$10
SgHurt:
    db $40,$A0,$10,$04,$40,$D7,$20,$04,$40,$1F,$31,$06,$40,$82,$51,$08,$40,$FE,$F0,$01,$50
SgOut:
    db $40,$8F,$20,$04,$40,$71,$20,$04,$40,$5F,$20,$04,$40,$47,$20,$04,$40,$39,$30,$0A,$40,$FE,$F0,$01
    db $50
SgTick:
    db $40,$40,$50,$01,$50

SgSoundTable:
    dw SgHush,$702B
    dw SgClick,$7035
    dw SgEcho0,$7035
    dw SgEcho1,$7035
    dw SgEcho2,$7035
    dw SgEcho3,$7035
    dw SgDrip,$7035
    dw SgThud,$702B
    dw SgMoth,$7035
    dw SgSlither0,$702B
    dw SgSlither1,$702B
    dw SgSlither2,$702B
    dw SgBreeze,$702B
    dw SgCrack,$702B
    dw SgCrash,$702B
    dw SgWeb,$7035
    dw SgHoot,$7035
    dw SgRiver,$702B
    dw SgHurt,$7035
    dw SgOut,$7035
    dw SgTick,$7035
    dw SgTuneMel,$703F
    dw SgTuneBass,$7049
; Under the Hills, D dorian (original for this game)
; Tiny Sound, 9 frames per step
SgTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$30,$31,$88,$21,$00,$24,$00,$A8,$00,$00,$00,$26,$00,$24,$00
    db $A3,$00,$00,$00,$21,$00,$1C,$00,$1F,$00,$A1,$00,$00,$00,$00,$00
    db $00,$00,$00,$00,$24,$00,$28,$00,$AB,$00,$00,$00,$2A,$00,$28,$00
    db $A6,$00,$00,$00,$28,$00,$26,$00,$24,$00,$23,$00,$A1,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
SgTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$70,$F1,$22,$09,$00,$00,$00,$10,$00,$00,$00,$09,$00,$00,$00
    db $10,$00,$00,$00,$07,$00,$00,$00,$0E,$00,$00,$00,$09,$00,$00,$00
    db $10,$00,$00,$00,$0C,$00,$00,$00,$13,$00,$00,$00,$0E,$00,$00,$00
    db $15,$00,$00,$00,$10,$00,$00,$00,$0B,$00,$00,$00,$09,$00,$00,$00
    db $09,$00,$00,$00
    db $FF
; the title song: both voices of Under the Hills
SgSong:
    dw $0001
    db $40+22,23
    dw $0000
; SOUNDING's sound wave, one layer a frame. The wave is a flood through
; open air: SgCur holds the cells it reached last frame; each of their
; four neighbours is either rock (its edge is lit with this wave's tile
; set: SgBase + its open-side bits) or air not yet reached by this wave
; (marked with SgBase + 16, or SgBase + 0 for the way out, and kept for
; the next layer in SgNxt). The screen's name table is the "reached"
; record, so the wave needs no RAM map. Rock lit counts in SgLit.
SgLayer:
    xor a
    ld (AMY_UVAR_SgNxtN),a
    ld (AMY_UVAR_SgLit),a
    ld a,(AMY_UVAR_SgCurN)
    or a
    jr z,SgLyCopy
    ld hl,AMY_UVAR_SgCur
    ld (AMY_UVAR_SgPtr),hl
SgLy1:
    push af
    ld hl,(AMY_UVAR_SgPtr)
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld (AMY_UVAR_SgPtr),hl
    ld (AMY_UVAR_SgTmp),de
    ld de,-32
    call SgNb
    ld de,1
    call SgNb
    ld de,32
    call SgNb
    ld de,-1
    call SgNb
    pop af
    dec a
    jr nz,SgLy1
SgLyCopy:
    ; the next layer becomes the current one
    ld a,(AMY_UVAR_SgNxtN)
    ld (AMY_UVAR_SgCurN),a
    or a
    ret z
    add a,a
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_SgNxt
    ld de,AMY_UVAR_SgCur
    ldir
    ret

; SgNb: the neighbour of SgTmp at offset DE
SgNb:
    ld hl,(AMY_UVAR_SgTmp)
    add hl,de
    ld (AMY_UVAR_SgN),hl
    ex de,hl
    ld hl,(AMY_UVAR_SgMask)
    add hl,de
    ld c,(hl)
    ld hl,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld b,a
    ld a,c
    cp 252
    jr nc,SgNbAir
    ; rock: its edge in this wave's set
    ld a,(AMY_UVAR_SgBase)
    add a,c
    cp b
    ret z
    ld c,a
    call SgPut
    ld hl,AMY_UVAR_SgLit
    inc (hl)
    ret
SgNbAir:
    ; 252 water (+18), 253 a web (+17), 254 the way out (+0), 255 air (+16)
    ld a,(AMY_UVAR_SgBase)
    bit 0,c
    jr nz,SgNbOdd
    bit 1,c
    jr nz,SgNbOut
    add a,18
    jr SgNbOut
SgNbOdd:
    add a,16
    bit 1,c
    jr nz,SgNbOut
    inc a
SgNbOut:
    cp b
    ret z
    ld c,a
    call SgPut
    ld a,(AMY_UVAR_SgNxtN)
    cp 64
    ret nc
    inc a
    ld (AMY_UVAR_SgNxtN),a
    dec a
    add a,a
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_SgNxt
    add hl,de
    ld de,(AMY_UVAR_SgN)
    ld (hl),e
    inc hl
    ld (hl),d
    ret

; SgPut: the tile C at VRAM address HL
SgPut:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,c
    out ($BE),a
    ret

; SgSweep: the cells of tile set SgBase back to darkness (32), 32 cells
; at a time through SgBuf: SgRows rows from row SgRow0 (a set is swept a
; little each frame once it has faded, so a new wave finds it clean)
SgSweep:
    ld a,(AMY_UVAR_SgRow0)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld (AMY_UVAR_SgTmp),hl
    ld a,(AMY_UVAR_SgRows)
SgSw1:
    push af
    ld hl,(AMY_UVAR_SgTmp)
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld hl,AMY_UVAR_SgBuf
    ld b,32
SgSw2:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz SgSw2
    ld hl,AMY_UVAR_SgBuf
    ld b,32
    ld a,(AMY_UVAR_SgBase)
    ld c,a
SgSw3:
    ld a,(hl)
    and $E0
    cp c
    jr nz,SgSw4
    ld (hl),32
SgSw4:
    inc hl
    djnz SgSw3
    ld hl,(AMY_UVAR_SgTmp)
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_SgBuf
    ld b,32
SgSw5:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz SgSw5
    ld hl,(AMY_UVAR_SgTmp)
    ld de,32
    add hl,de
    ld (AMY_UVAR_SgTmp),hl
    pop af
    dec a
    jr nz,SgSw1
    ret
}
