cartridge "DEEP CHAMBERS/AMY BIENVENU/2026"

' DEEP CHAMBERS
' A ColecoVision dungeon crawler in Amy by Amy Bienvenu, 2026, in the
' spirit of Dark Chambers (Atari, 1988) and its ancestor Dandy (John
' Howard Palevich, 1983). Nothing is copied from them: the dungeons,
' graphics, sounds and music are new.
'
' Twenty-six levels, A to Z, each a maze of four rooms. Monster pits keep
' sending ghouls, wraiths and demons; arrows knock a monster down one rank
' (demon, wraith, ghoul, gone) and three arrows close a pit. Keys open the
' doors, food restores health, treasure scores, and a potion destroys
' every monster in the room. Find the stairs down; escape from level Z.
'
' Liberties taken (this is not a port):
' - Flip-screen rooms instead of a scrolling maze, one player only.
' - Monsters rank down when hit, as in Dark Chambers, but the pits close
'   after three arrows and stay closed for the rest of the level.
' - Levels are built ahead of time by levels.py from fixed seeds, so every
'   game has the same dungeon; doors always guard the way to the stairs.
'
' Controls (either joystick): the stick moves; the left button shoots an
' arrow; the right button drinks a potion. The keypad is not used.
' Everything that matters stays in columns 2-29, inside the TV overscan.
' The hero is sprites 0 and 1, which never flicker; monsters take turns
' when more than four share a line. The frame loop is protected from the
' NMI, and drawing only happens with the NMI off after a wait.

const TFloor = 128
const TStairs00 = 129
const TStairs01 = 130
const TStairs10 = 131
const TStairs11 = 132
const TChest00 = 133
const TChest01 = 134
const TChest10 = 135
const TChest11 = 136
const TFood00 = 137
const TFood01 = 138
const TFood10 = 139
const TFood11 = 140
const TKey00 = 141
const TKey01 = 142
const TKey10 = 143
const TKey11 = 144
const TPotion00 = 145
const TPotion01 = 146
const TPotion10 = 147
const TPotion11 = 148
const TWall = 149
const TDoor00 = 150
const TDoor01 = 151
const TDoor10 = 152
const TDoor11 = 153
const TGena00 = 154
const TGena01 = 155
const TGena10 = 156
const TGena11 = 157
const TGenb00 = 158
const TGenb01 = 159
const TGenb10 = 160
const TGenb11 = 161
const TGenc00 = 162
const TGenc01 = 163
const TGenc10 = 164
const TGenc11 = 165
const TTorch = 166
const SHero1 = 0
const SHero2 = 4
const SSkin1 = 8
const SSkin2 = 12
const SHerol1 = 16
const SHerol2 = 20
const SSkinl1 = 24
const SSkinl2 = 28
const SGhoul1 = 32
const SGhoul2 = 36
const SWraith1 = 40
const SWraith2 = 44
const SDemon1 = 48
const SDemon2 = 52
const SArrowh = 56
const SArrowhl = 60
const SArrowv = 64
const SArrowvd = 68
const SBurst = 72
const NTiles8 = 312
const SprBytes = 608
const SndShoot = 1
const SndHit = 2
const SndKill = 3
const SndGold = 4
const SndEat = 5
const SndKey = 6
const SndDoor = 7
const SndHurt = 8
const SndBomb = 9
const SndStairs = 10
const SndGenHit = 11
const SndBlock = 12
const SndLevel = 13
const SndOver = 14
const SndVictory = 15
const SndTuneA = 16
const SndTuneB = 17

u8 LvlBuf[128]
u8 ObjSt[40]
u8 MoX[6]
u8 MoY[6]
u8 MoD[6]
u8 MoL[6]
u16 Score = 0
u16 NumU = 0
u16 Dst16 = 0
u16 VDst = 0
u16 VCnt = 0
u8 GcX = 0
u8 GcY = 0
u8 Level = 0
u8 Health = 0
u8 Keys = 0
u8 Pots = 0
u8 Rx = 0
u8 Ry = 0
u8 Px = 0
u8 Py = 0
u8 Pd = 1
u8 Want = 0
u8 Anim = 0
u8 AnimT = 0
u8 HurtT = 0
u8 AOn = 0
u8 Ax = 0
u8 Ay = 0
u8 Ad = 0
u8 BuT = 0
u8 BuX = 0
u8 BuY = 0
u8 GenT = 0
u8 GenI = 0
u8 Gx = 0
u8 Gy = 0
u8 Cx = 0
u8 Cy = 0
u8 Tx = 0
u8 Ty = 0
u8 Mx = 0
u8 My = 0
u8 Md = 0
u8 Ok = 0
u8 Ob = 0
u8 Obt = 0
u8 Won = 0
u8 Menu = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Mix = 0
u8 Tick = 0
u8 WallT = 0
u8 G = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 C = 0
u8 R = 0
u8 Q = 0
u8 Got = 0
u8 Dh = 0
u8 Dv = 0

  tile screen
  set sound table DcSoundTable areas 4
  sprites 16x16
  nmi off
  VDst = $3800
  VCnt = SprBytes
  call asm VCopy with hl = address of SpritePat
  HideSprites
  screen on
  EditorialPage

title:
  TitlePage
  if Menu = 1 then
    HowToPlay
    goto title
  end if

new_game:
  Level = 0
  Health = 99
  Score = 0
  Keys = 0
  Pots = 0
  StartLevel

game_loop:
  Frame1
  ReadPad
  MoveHero
  if Won = 9 then goto room_change
  ' standing on a square: anything to pick up?
  V = Px & 7
  N = Py & 7
  V = V | N
  if V = 0 then Pickup
  if Won = 8 then goto next_level
  Arrow
  Monsters
  Spawn
  if Press2 = 1 then Potion
  if HurtT > 0 then dec HurtT
  if BuT > 0 then dec BuT
  DrawSprites
  if Health = 0 then goto game_over
  goto game_loop

room_change:
  Won = 0
  DrawRoom
  goto game_loop

next_level:
  Won = 0
  inc Level
  if Level >= 26 then goto won_game
  play sound SndStairs
  Rearm
  wait 60 frames
  nmi off
  V = Health + 15
  if V > 99 then V = 99
  Health = V
  StartLevel
  goto game_loop

game_over:
  HideSprites
  ClearMsg
  print at 4,22, "THE DEEP CLAIMS YOU..."
  play sound SndOver
  Rearm
  wait 180 frames
  wait no fire
  nmi off
  goto title

won_game:
  VictoryPage
  goto title

' ---------------------------------------------------------------------------
' The frame and the controls

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  LoadTiles
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    VDst = Dst16
    VCnt = NTiles8
    call asm VCopy with hl = address of TilePat
    VDst = Dst16 + $2000
    call asm VCopy with hl = address of TileCol
    Dst16 += 2048
  next
  return
end sub

sub ClearMsg:
  fill 32 count 28 at 2,22
  return
end sub

' ---------------------------------------------------------------------------
' Levels and rooms

sub StartLevel:
  NewScreen
  call asm LoadLevel
  WallT = TWall
  call asm WallColor
  for J = 0 to 39
    ObjSt[J] = 0
  next
  ' every object starts present; the pits take three arrows
  J = 0
  N = 46
sl_obj:
  V = LvlBuf[N]
  if V <> 255 then
    inc N
    V = LvlBuf[N]
    ObjSt[J] = 1
    if V >= 7 then ObjSt[J] = 3
    inc N
    inc J
    if J < 40 then goto sl_obj
  end if
  ' where the hero starts
  V = LvlBuf[0]
  CellOf
  Rx = 0
  if Gx >= 9 then Rx = 1
  Ry = 0
  if Gy >= 5 then Ry = 1
  Cx = Gx
  if Rx = 1 then Cx -= 9
  Cy = Gy
  if Ry = 1 then Cy -= 5
  Px = Cx * 24
  Px += 24
  Py = Cy * 24
  Py += 32
  Pd = 2
  DrawRoom
  ClearMsg
  print at 2,22, "LEVEL"
  V = Level + 65
  put char V at 8,22
  if Level = 0 then print at 10,22, "FIND THE STAIRS"
  play sound SndLevel
  return
end sub

' V = cell number (0-179) -> Gx, Gy
sub CellOf:
  Gy = 0
  while V >= 18
    V -= 18
    inc Gy
  end while
  Gx = V
  return
end sub

' Ok = the wall bits of cell Gx, Gy (1 east, 2 south)
sub CellBits:
  V = Gy * 18
  V += Gx
  N = V & 3
  V = V >> 2
  inc V
  Ok = LvlBuf[V]
  while N > 0
    Ok = Ok >> 2
    dec N
  end while
  Ok = Ok & 3
  return
end sub

sub DrawRoom:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  AOn = 0
  BuT = 0
  for J = 0 to 5
    MoL[J] = 0
  next
  GenT = 60
  cls
  for Cy = 0 to 4
    for Cx = 0 to 8
      Tx = Cx * 3
      Tx += 2
      Ty = Cy * 3
      Ty += 3
      Gx = Rx * 9
      Gx += Cx
      Gy = Ry * 5
      Gy += Cy
      put char TWall at Tx,Ty
      ' the wall above: the south side of the cell above
      V = 1
      if Gy > 0 then
        dec Gy
        CellBits
        inc Gy
        V = Ok & 2
      end if
      X = Tx + 1
      if V > 0 then
        put char TWall at X,Ty
        inc X
        put char TWall at X,Ty
      else
        put char TFloor at X,Ty
        inc X
        put char TFloor at X,Ty
      end if
      ' the wall on the left: the east side of the cell on the left
      V = 1
      if Gx > 0 then
        dec Gx
        CellBits
        inc Gx
        V = Ok & 1
      end if
      Y = Ty + 1
      if V > 0 then
        put char TWall at Tx,Y
        inc Y
        put char TWall at Tx,Y
      else
        put char TFloor at Tx,Y
        inc Y
        put char TFloor at Tx,Y
      end if
      X = Tx + 1
      Y = Ty + 1
      put char TFloor at X,Y
      inc X
      put char TFloor at X,Y
      inc Y
      put char TFloor at X,Y
      dec X
      put char TFloor at X,Y
      ' the right edge of the room
      if Cx = 8 then
        put char TWall at 29,Ty
        V = 1
        if Gx < 17 then
          CellBits
          V = Ok & 1
        end if
        K = TWall
        if V = 0 then K = TFloor
        Y = Ty + 1
        put char K at 29,Y
        inc Y
        put char K at 29,Y
      end if
      ' the bottom edge of the room
      if Cy = 4 then
        put char TWall at Tx,18
        V = 2
        if Gy < 9 then
          CellBits
          V = Ok & 2
        end if
        K = TWall
        if V = 0 then K = TFloor
        X = Tx + 1
        put char K at X,18
        inc X
        put char K at X,18
      end if
    next
  next
  put char TWall at 29,18
  ' the objects in this room
  J = 0
  N = 46
dr_obj:
  V = LvlBuf[N]
  if V <> 255 then
    if ObjSt[J] > 0 then
      CellOf
      InRoom
      if Ok = 1 then
        Q = N + 1
        Obt = LvlBuf[Q]
        DrawObj
      end if
    end if
    N += 2
    inc J
    if J < 40 then goto dr_obj
  end if
  ShowHud
  ShowScreen
  return
end sub

' Ok = 1 when cell Gx, Gy is in the room on screen; Tx, Ty its top-left
' floor tile
sub InRoom:
  Ok = 0
  X = Rx * 9
  Y = Ry * 5
  if Gx >= X then
    if Gy >= Y then
      Cx = Gx - X
      Cy = Gy - Y
      if Cx < 9 then
        if Cy < 5 then
          Ok = 1
          Tx = Cx * 3
          Tx += 3
          Ty = Cy * 3
          Ty += 4
        end if
      end if
    end if
  end if
  return
end sub

' draw object type Obt (0 = bare floor) at Tx, Ty
sub DrawObj:
  K = TFloor
  if Obt = 1 then K = TChest00
  if Obt = 2 then K = TFood00
  if Obt = 3 then K = TKey00
  if Obt = 4 then K = TPotion00
  if Obt = 5 then K = TDoor00
  if Obt = 6 then K = TStairs00
  if Obt = 7 then K = TGena00
  if Obt = 8 then K = TGenb00
  if Obt = 9 then K = TGenc00
  if Obt = 0 then
    put char K at Tx,Ty
    X = Tx + 1
    put char K at X,Ty
    Y = Ty + 1
    put char K at Tx,Y
    put char K at X,Y
  else
    put char K at Tx,Ty
    inc K
    X = Tx + 1
    put char K at X,Ty
    inc K
    Y = Ty + 1
    put char K at Tx,Y
    inc K
    put char K at X,Y
  end if
  return
end sub

' Ob = the object at cell Gx, Gy that is still there (255 = none)
sub FindObj:
  Ob = 255
  V = Gy * 18
  V += Gx
  Q = V
  J = 0
  N = 46
fo_next:
  V = LvlBuf[N]
  if V = 255 then return
  if V = Q then
    if ObjSt[J] > 0 then
      Ob = J
      inc N
      Obt = LvlBuf[N]
      return
    end if
  end if
  N += 2
  inc J
  if J < 40 then goto fo_next
  return
end sub

' the cell (Gx, Gy) whose floor holds tile Tx, Ty of the screen
sub TileCell:
  V = Tx - 3
  Cx = 0
  while V >= 3
    V -= 3
    inc Cx
  end while
  V = Ty - 4
  Cy = 0
  while V >= 3
    V -= 3
    inc Cy
  end while
  Gx = Rx * 9
  Gx += Cx
  Gy = Ry * 5
  Gy += Cy
  return
end sub

sub ShowHud:
  print at 2,1, "DEEP CHAMBERS"
  print at 21,1, "LEVEL"
  V = Level + 65
  put char V at 27,1
  print at 2,20, "HEALTH"
  NumU = Health
  print at 9,20, digits$(NumU, 2)
  print at 16,20, "SCORE"
  NumU = Score
  print at 22,20, digits$(NumU, 5)
  print at 2,21, "KEYS"
  NumU = Keys
  print at 7,21, digits$(NumU, 1)
  print at 16,21, "POTIONS"
  NumU = Pots
  print at 24,21, digits$(NumU, 1)
  return
end sub

' ---------------------------------------------------------------------------
' Moving: everything walks on the 8-pixel grid. Ok = 1 when a mover at
' Mx, My (aligned) can step in direction Md (0 up 1 right 2 down 3 left).

sub CanGo:
  X = Mx >> 3
  Y = My >> 3
  if Md = 0 then
    dec Y
    C = X + 1
    R = Y
  elseif Md = 1 then
    X += 2
    C = X
    R = Y + 1
  elseif Md = 2 then
    Y += 2
    C = X + 1
    R = Y
  else
    dec X
    C = X
    R = Y + 1
  end if
  Tx = X
  Ty = Y
  Ok = 1
  GcX = X
  GcY = Y
  call asm GetCh
  if V >= TWall then
    if V < TTorch then Ok = 0
  end if
  GcX = C
  GcY = R
  call asm GetCh
  if V >= TWall then
    if V < TTorch then Ok = 0
  end if
  return
end sub

sub MoveHero:
  ' the wanted direction; a new turn wins over the one held
  Want = 255
  if Up1 = 1 then Want = 0
  if Dn1 = 1 then Want = 2
  if Lf1 = 1 then Want = 3
  if Rt1 = 1 then Want = 1
  if Want = 255 then return
  V = Px & 7
  N = Py & 7
  V = V | N
  if V = 0 then
    ' on the grid: turn if the way is open
    Mx = Px
    My = Py
    Md = Want
    CanGo
    if Ok = 0 then
      Pd = Want
      if Keys > 0 then TryDoor
      return
    end if
    Pd = Want
  else
    ' between squares: only turning back is allowed
    V = Pd ^ 2
    if Want = V then Pd = Want
  end if
  if Pd = 0 then Py -= 2
  if Pd = 1 then Px += 2
  if Pd = 2 then Py += 2
  if Pd = 3 then Px -= 2
  inc AnimT
  if AnimT >= 8 then
    AnimT = 0
    Anim = Anim ^ 1
  end if
  ' out through a doorway into the next room
  if Px <= 8 then
    dec Rx
    Px = 216
    Won = 9
    return
  end if
  if Px >= 232 then
    inc Rx
    Px = 24
    Won = 9
    return
  end if
  if Py <= 16 then
    dec Ry
    Py = 128
    Won = 9
    return
  end if
  if Py >= 152 then
    inc Ry
    Py = 32
    Won = 9
    return
  end if
  return
end sub

' the hero walked into a closed door with a key in hand
sub TryDoor:
  GcX = Tx
  GcY = Ty
  call asm GetCh
  if V < TDoor00 then return
  if V > TDoor11 then return
  TileCell
  FindObj
  if Ob = 255 then return
  ObjSt[Ob] = 0
  dec Keys
  InRoom
  Obt = 0
  DrawObj
  play sound SndDoor
  ShowHud
  return
end sub

sub Pickup:
  Tx = Px >> 3
  Ty = Py >> 3
  GcX = Tx
  GcY = Ty
  call asm GetCh
  if V = TFloor then return
  if V >= TWall then return
  TileCell
  FindObj
  if Ob = 255 then return
  if Obt = 6 then
    Won = 8
    return
  end if
  ObjSt[Ob] = 0
  InRoom
  Got = Obt
  Obt = 0
  DrawObj
  K = Got
  if K = 1 then
    NumU = 100
    Score += NumU
    play sound SndGold
  elseif K = 2 then
    V = Health + 20
    if V > 99 then V = 99
    Health = V
    play sound SndEat
  elseif K = 3 then
    inc Keys
    play sound SndKey
  elseif K = 4 then
    if Pots < 9 then inc Pots
    play sound SndKey
  end if
  ShowHud
  return
end sub

' ---------------------------------------------------------------------------
' The arrow

sub Arrow:
  if AOn = 0 then
    if Press = 1 then
      AOn = 1
      Ad = Pd
      Ax = Px
      Ay = Py
      play sound SndShoot
    end if
    return
  end if
  if Ad = 0 then Ay -= 4
  if Ad = 1 then Ax += 4
  if Ad = 2 then Ay += 4
  if Ad = 3 then Ax -= 4
  if Ax < 16 then AOn = 0
  if Ax > 224 then AOn = 0
  if Ay < 24 then AOn = 0
  if Ay > 136 then AOn = 0
  if AOn = 0 then return
  ' the tile under the arrow's point
  X = Ax + 8
  Y = Ay + 8
  if Ad = 0 then Y -= 6
  if Ad = 1 then X += 6
  if Ad = 2 then Y += 6
  if Ad = 3 then X -= 6
  Tx = X >> 3
  Ty = Y >> 3
  GcX = Tx
  GcY = Ty
  call asm GetCh
  if V >= TWall then
    if V < TTorch then
      AOn = 0
      if V >= TGena00 then HitPit
      return
    end if
  end if
  ' a monster?
  for G = 0 to 5
    if MoL[G] > 0 then
      Mx = MoX[G]
      My = MoY[G]
      Near
      if Ok = 1 then
        AOn = 0
        BuX = Mx
        BuY = My
        BuT = 8
        dec MoL[G]
        if MoL[G] = 0 then
          play sound SndKill
        else
          play sound SndHit
        end if
        NumU = 10
        Score += NumU
        ShowHud
        return
      end if
    end if
  next
  return
end sub

' Ok = 1 when Ax, Ay is within 10 pixels of Mx, My
sub Near:
  Ok = 0
  if Ax + 10 >= Mx then
    if Ax <= Mx + 10 then
      if Ay + 10 >= My then
        if Ay <= My + 10 then Ok = 1
      end if
    end if
  end if
  return
end sub

sub HitPit:
  TileCell
  FindObj
  if Ob = 255 then return
  play sound SndGenHit
  dec ObjSt[Ob]
  if ObjSt[Ob] > 0 then return
  InRoom
  BuX = Tx << 3
  BuY = Ty << 3
  BuT = 12
  Obt = 0
  DrawObj
  NumU = 50
  Score += NumU
  ShowHud
  play sound SndKill
  return
end sub

' ---------------------------------------------------------------------------
' Monsters

sub Monsters:
  for G = 0 to 5
    if MoL[G] > 0 then
      ' ghouls are slow: every other frame
      V = 1
      if MoL[G] = 1 then
        V = Tick + G
        V = V & 1
      end if
      if V > 0 then MoveMon
      ' touching the hero
      Mx = MoX[G]
      My = MoY[G]
      Ok = 0
      if Px + 11 >= Mx then
        if Px <= Mx + 11 then
          if Py + 11 >= My then
            if Py <= My + 11 then Ok = 1
          end if
        end if
      end if
      if Ok = 1 then
        if HurtT = 0 then
          HurtT = 24
          V = MoL[G] * 2
          if Health > V then
            Health -= V
          else
            Health = 0
          end if
          play sound SndHurt
          ShowHud
        end if
      end if
    end if
  next
  return
end sub

sub MoveMon:
  Mx = MoX[G]
  My = MoY[G]
  Md = MoD[G]
  V = Mx & 7
  N = My & 7
  V = V | N
  if V = 0 then
    ' on the grid: head for the hero, mostly
    K = Md
    Mix += 23
    V = Mix & 7
    if V < 6 then
      ' the longer way to go first
      if Px > Mx then
        X = Px - Mx
        Dh = 1
      else
        X = Mx - Px
        Dh = 3
      end if
      if Py > My then
        Y = Py - My
        Dv = 2
      else
        Y = My - Py
        Dv = 0
      end if
      if X >= Y then
        Md = Dh
        MonTry
        if Ok = 0 then
          Md = Dv
          MonTry
        end if
      else
        Md = Dv
        MonTry
        if Ok = 0 then
          Md = Dh
          MonTry
        end if
      end if
    else
      Ok = 0
    end if
    if Ok = 0 then
      Md = K
      MonTry
    end if
    if Ok = 0 then
      ' anywhere open
      Md = Mix & 3
      for J = 0 to 3
        if Ok = 0 then
          MonTry
          if Ok = 0 then
            inc Md
            Md = Md & 3
          end if
        end if
      next
    end if
    if Ok = 0 then return
    MoD[G] = Md
  end if
  if Md = 0 then dec My
  if Md = 1 then inc Mx
  if Md = 2 then inc My
  if Md = 3 then dec Mx
  MoX[G] = Mx
  MoY[G] = My
  return
end sub

' a monster may step Md from Mx, My: open, and inside the room
sub MonTry:
  Ok = 0
  if Md = 0 then
    if My < 40 then return
  end if
  if Md = 1 then
    if Mx > 208 then return
  end if
  if Md = 2 then
    if My > 120 then return
  end if
  if Md = 3 then
    if Mx < 32 then return
  end if
  CanGo
  return
end sub

' the pits in this room send out monsters
sub Spawn:
  if GenT > 0 then
    dec GenT
    return
  end if
  V = 150 - Level
  V -= Level
  V -= Level
  GenT = V
  ' a free slot?
  K = 255
  for J = 0 to 5
    if MoL[J] = 0 then K = J
  next
  if K = 255 then return
  ' the next pit in this room, round robin
  for Q = 0 to 39
    inc GenI
    if GenI >= 40 then GenI = 0
    J = GenI
    N = J * 2
    N += 46
    V = LvlBuf[N]
    if V <> 255 then
      if ObjSt[J] > 0 then
        inc N
        Obt = LvlBuf[N]
        if Obt >= 7 then
          CellOf
          InRoom
          if Ok = 1 then
            MoX[K] = Tx << 3
            MoY[K] = Ty << 3
            MoL[K] = Obt - 6
            Mix += 17
            MoD[K] = Mix & 3
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' the potion: every monster in the room is gone
sub Potion:
  if Pots = 0 then
    play sound SndBlock
    return
  end if
  dec Pots
  play sound SndBomb
  for J = 0 to 5
    if MoL[J] > 0 then
      NumU = 20
      Score += NumU
    end if
    MoL[J] = 0
  next
  backdrop white
  Rearm
  wait 4 frames
  nmi off
  backdrop black
  ShowHud
  return
end sub

' ---------------------------------------------------------------------------
' Sprites: hero 0 (tunic) and 1 (skin), arrow 2, burst 3, monsters 4-9

sub DrawSprites:
  Y = Py - 1
  K = SHero1
  if Anim = 1 then K = SHero2
  N = SSkin1
  if Pd = 3 then
    K = SHerol1
    if Anim = 1 then K = SHerol2
    N = SSkinl1
  end if
  C = 7
  V = HurtT & 4
  if V > 0 then C = 15
  set sprite 0 to Y,Px,N,9
  set sprite 1 to Y,Px,K,C
  if AOn = 1 then
    K = SArrowh
    if Ad = 3 then K = SArrowhl
    if Ad = 0 then K = SArrowv
    if Ad = 2 then K = SArrowvd
    Y = Ay - 1
    set sprite 2 to Y,Ax,K,11
  else
    set sprite 2 to 192,0,0,0
  end if
  if BuT > 0 then
    Y = BuY - 1
    set sprite 3 to Y,BuX,SBurst,15
  else
    set sprite 3 to 192,0,0,0
  end if
  for G = 0 to 5
    J = G + 4
    V = MoL[G]
    if V > 0 then
      N = Tick & 16
      if V = 1 then
        K = SGhoul1
        C = 3
      elseif V = 2 then
        K = SWraith1
        C = 13
      else
        K = SDemon1
        C = 8
      end if
      if N > 0 then K += 4
      Y = MoY[G] - 1
      X = MoX[G]
      set sprite J to Y,X,K,C
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub TitlePage:
  NewScreen
  ' a doorway into the dark
  for Y = 3 to 18
    fill TWall count 28 at 2,Y
  next
  for Y = 9 to 18
    fill TFloor count 10 at 11,Y
  next
  for Y = 4 to 8
    fill 32 count 26 at 3,Y
  next
  put char TTorch at 8,10
  put char TTorch at 23,10
  put char TStairs00 at 15,14
  put char TStairs01 at 16,14
  put char TStairs10 at 15,15
  put char TStairs11 at 16,15
  print at 9,5, "DEEP CHAMBERS"
  print at 5,7, "DESCEND TO LEVEL Z"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  Menu = 0
  Px = 120
  Py = 128
  Pd = 2
  Anim = 0
  AnimT = 0
  HurtT = 0
  AOn = 0
  BuT = 0
  for J = 0 to 5
    MoL[J] = 0
  next
  MoL[0] = 3
  MoX[0] = 96
  MoY[0] = 96
  MoL[1] = 2
  MoX[1] = 144
  MoY[1] = 96
  MoL[2] = 1
  MoX[2] = 120
  MoY[2] = 72
  ShowMenu
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
      play sound SndShoot
    end if
  end if
  WasStick = V
  DrawSprites
  V = Btn | Btn2
  if V = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  Rearm
  wait no fire
  nmi off
  return
end sub

sub ShowMenu:
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  print at 10,20, "START"
  print at 10,21, "HOW TO PLAY"
  V = Menu + 20
  put char 62 at 8,V
  return
end sub

sub HowToPlay:
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop dark blue
  cls
  print at 8,1, "HOW TO PLAY"
  print at 2,3, "STICK   WALK THE CHAMBERS"
  print at 2,4, "LEFT    SHOOT AN ARROW"
  print at 2,5, "RIGHT   DRINK A POTION:"
  print at 10,6, "NO MONSTER SURVIVES"
  print at 2,8, "MONSTER PITS SEND OUT"
  print at 2,9, "DEMONS, WRAITHS AND GHOULS."
  print at 2,10, "EACH ARROW KNOCKS ONE DOWN"
  print at 2,11, "A RANK. THREE ARROWS CLOSE"
  print at 2,12, "A PIT FOR GOOD."
  print at 2,14, "KEYS OPEN DOORS. FOOD HEALS."
  print at 2,15, "CHESTS ARE TREASURE."
  print at 2,17, "TAKE THE STAIRS DOWN, FROM"
  print at 2,18, "LEVEL A TO LEVEL Z, AND"
  print at 2,19, "ESCAPE THE DEEP."
  print at 7,22, "PRESS A BUTTON"
  screen on
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub VictoryPage:
  NewScreen
  backdrop dark blue
  print at 6,6, "YOU HAVE ESCAPED"
  print at 8,8, "THE DEEP CHAMBERS!"
  print at 9,12, "FINAL SCORE"
  NumU = Score
  print at 12,14, digits$(NumU, 5)
  ShowScreen
  play sound SndVictory
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  nmi off
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 8,1, "DEEP CHAMBERS"
  print at 2,3, "A DUNGEON CRAWL IN THE"
  print at 2,4, "SPIRIT OF DARK CHAMBERS"
  print at 2,5, "(ATARI, 1988) AND ITS"
  print at 2,6, "ANCESTOR DANDY (JOHN HOWARD"
  print at 2,7, "PALEVICH, 1983)."
  print at 2,9, "NEW DUNGEONS, GRAPHICS,"
  print at 2,10, "SOUNDS AND MUSIC; ROOM BY"
  print at 2,11, "ROOM INSTEAD OF SCROLLING."
  print at 2,13, "26 LEVELS, A TO Z."
  print at 2,15, "MUSIC: INTO THE DEEP."
  print at 2,17, "BY AMY BIENVENU, 2026."
  print at 7,22, "PRESS A BUTTON"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

