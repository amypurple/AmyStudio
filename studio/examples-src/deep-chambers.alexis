    db $03,$04,$13,$03,$26,$01,$2B,$06,$2D,$09,$33,$05,$35,$01,$43,$02
    db $50,$03,$51,$09,$52,$09,$66,$09,$69,$09,$6C,$01,$6D,$09,$6E,$09
    db $70,$01,$76,$09,$77,$02,$86,$09,$9E,$01,$AE,$05,$B2,$01,$FF,$FF
    db $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF
    db $FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF,$FF

; LoadLevel: copy level A (0-25) into LvlBuf
LoadLevel:
    ld a,(AMY_UVAR_Level)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,DcLevels
    add hl,de
    ld de,AMY_UVAR_LvlBuf
    ld bc,128
    ldir
    ret
; GetCh: V = name-table code at (GcX,GcY). Reads the VDP directly so it
; does not depend on the BIOS READ_VRAM count convention. Call with NMI off.
GetCh:
    ld a,(AMY_UVAR_GcY)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_GcX)
    add a,l
    ld l,a
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    nop
    nop
    in a,($BE)
    ld (AMY_UVAR_V),a
    ret

; VCopy: copy VCnt bytes from HL (ROM/RAM) to VRAM VDst, direct to the VDP.
; Independent of the BIOS WRITE_VRAM count convention. Call with NMI off.
VCopy:
    push hl
    ld de,(AMY_UVAR_VDst)
    ld a,e
    out ($BF),a
    ld a,d
    and $3F
    or $40
    out ($BF),a
    pop hl
    ld bc,(AMY_UVAR_VCnt)
VCopyLoop:
    ld a,(hl)
    out ($BE),a
    inc hl
    dec bc
    ld a,b
    or c
    jr nz,VCopyLoop
    ret

; WallColor: the stone changes colour every five levels. Rewrites the
; colour rows of tile WallT in the three pattern banks.
WallColor:
    ld a,(AMY_UVAR_Level)
    ld b,0
WcDiv:
    cp 5
    jr c,WcGot
    sub 5
    inc b
    jr WcDiv
WcGot:
    ld a,b
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld hl,DcWallCols
    add hl,de
    push hl
    ld a,(AMY_UVAR_WallT)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$2000
    add hl,de
    ex de,hl
    pop hl
    ld c,3
WcBank:
    push hl
    ld a,e
    out ($BF),a
    ld a,d
    and $3F
    or $40
    out ($BF),a
    ld b,8
WcByte:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz WcByte
    pop hl
    ld a,d
    add a,8
    ld d,a
    dec c
    jr nz,WcBank
    ret

; brick rows (mortar black on stone), mortar rows, for six depths
DcWallCols:
    db $1E,$1E,$1E,$11,$1E,$1E,$1E,$11
    db $1A,$1A,$1A,$11,$1A,$1A,$1A,$11
    db $16,$16,$16,$11,$16,$16,$16,$11
    db $1C,$1C,$1C,$11,$1C,$1C,$1C,$11
    db $14,$14,$14,$11,$14,$14,$14,$11
    db $1D,$1D,$1D,$11,$1D,$1D,$1D,$11
}
