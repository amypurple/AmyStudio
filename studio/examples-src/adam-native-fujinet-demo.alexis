' FujiNet on the Coleco ADAM: the same statements as the cartridge, over
' AdamNet. Build as an ADAM native EOS program with target.hardware ["fujinet"].
u8 Present = 0
u8 S = 0
u8 Got = 0
u8 Title[32]
FujiNetTime Clock

text screen
print at 0,0, "AMY FUJINET ON THE ADAM"
screen on no nmi

Present = fujinet present
if Present = 0 then
  print at 0,2, "NO FUJINET ON ADAMNET"
else
  fujinet time into Clock status S
  if S = 0 then
    print at 0,2, "TIME"
    print Clock.Hour at 10,2 digits 2
    print at 12,2, ":"
    print Clock.Minute at 13,2 digits 2
  end if
  network open 1 "N:HTTPS://httpbin.org/json" read status S
  if S = 0 then
    network json 1 status S
  end if
  if S = 0 then
    Got = network query 1 "/slideshow/title" into Title status S
    print at 0,4, "TITLE"
    put Title count Got at 0,5
  else
    print at 0,4, "REQUEST FAILED"
  end if
  network close 1
end if
loop forever
