' FujiNet: fetch a web page over HTTP and show it, 32 bytes per row.
' Build for a ColecoVision cartridge with target.hardware ["fujinet"].
' Without a FujiNet the status line says so and the program carries on.
u8 Present = 0
u8 S = 0
u8 Got = 0
u8 Row = 2
u8 Chunk[32]

text screen
backdrop dark blue
screen on

Present = fujinet present
if Present = 0 then
  print at 0,0, "NO FUJINET CARTRIDGE"
else
  print at 0,0, "FETCHING..."
  network open 1 "N:HTTP://example.com/" read translate lf status S
  if S = 0 then
    do
      Got = network read 1 into Chunk status S
      if Got <> 0 then
        put Chunk count Got at 0,Row
        inc Row
      end if
      if S <> 0 then
        exit do
      end if
    loop until Row = 24
    network close 1
    print at 0,0, "DONE       "
  else
    print at 0,0, "OPEN FAILED"
  end if
end if
loop forever
