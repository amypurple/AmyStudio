; Firefly Lantern, D major (original for this game)
; Tiny Sound, 12 frames per step
EmTuneMel:
    db $44
    dw sndtiny_1
    db 12
    db $02,$70,$F1,$22,$25,$00,$28,$00,$2D,$00,$28,$25,$26,$00,$23,$00
    db $20,$00,$23,$00,$25,$00,$21,$00,$1C,$00,$21,$23,$25,$00,$26,$00
    db $28,$00,$00,$00,$2A,$00,$28,$00,$26,$00,$25,$23,$21,$00,$23,$00
    db $25,$00,$1C,$00,$1E,$00,$20,$00,$23,$00,$21,$20,$21,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
EmTuneBass:
    db $84
    dw sndtiny_2
    db 12
    db $02,$80,$18,$32,$09,$01,$10,$01,$15,$01,$10,$01,$04,$01,$0B,$01
    db $10,$01,$0B,$01,$06,$01,$0D,$01,$12,$01,$0D,$01,$0E,$01,$09,$01
    db $04,$01,$0B,$01,$0E,$01,$09,$01,$0E,$01,$09,$01,$09,$01,$10,$01
    db $0D,$01,$10,$01,$0E,$01,$04,$01,$04,$01,$08,$01,$09,$01,$10,$01
    db $09,$01,$01,$01
    db $FF
; em.asm (THE EMERALD ELEPHANT): screen set-up and the text printer.
; All routines run with the NMI off (Amy's Frame1 ends with nmi off).
; VDP writes are at least 29 cycles apart (the display may be on).

; EmSetup: R3 = $FF (each screen third its own colour table), names 0-255
; in order on rows 0-7 (the picture), and the gold letters: the font's
; codes 32-95 copied to 192-255 in the two lower thirds, light yellow on
; the top six pixel rows and dark yellow below.
EmSetup:
    ld bc,$03FF
    call WRITE_REGISTER
    ; names 0..255 at $1800
    ld hl,$1800
    call EmWAddr
    xor a
    ld b,0
EmSu1:
    out ($BE),a
    inc a
    nop
    nop
    djnz EmSu1
    ld a,$08
    call EmGold
    ld a,$10
    call EmGold
    ret

; EmGold: A = high byte of a lower third's pattern table ($08 or $10)
EmGold:
    ld (AMY_UVAR_GHi),a
    ld c,32
EmGo1:
    ; read the glyph of code C
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_GHi)
    add a,h
    ld h,a
    push hl
    call EmRAddr
    ld hl,AMY_UVAR_GBuf
    ld b,8
EmGo2:
    in a,($BE)
    ld (hl),a
    inc hl
    nop
    nop
    djnz EmGo2
    ; write it at code C + 160 (pattern +1280)
    pop hl
    push hl
    ld de,1280
    add hl,de
    call EmWAddr
    ld hl,AMY_UVAR_GBuf
    ld b,8
EmGo3:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    djnz EmGo3
    ; its colours (colour table = pattern table + $2000)
    pop hl
    ld de,$2000+1280
    add hl,de
    call EmWAddr
    ld b,6
EmGo4:
    ld a,$B1
    out ($BE),a
    nop
    nop
    nop
    djnz EmGo4
    ld b,2
EmGo5:
    ld a,$A1
    out ($BE),a
    nop
    nop
    nop
    djnz EmGo5
    inc c
    ld a,c
    cp 96
    jr nz,EmGo1
    ret

EmWAddr:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    or $40
    out ($BF),a
    ret

EmRAddr:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    ret

; EmSay: TxPtr = the start of message MsgNo
EmSay:
    ld a,(AMY_UVAR_MsgNo)
    ld l,a
    ld h,0
    add hl,hl
    ld de,EmMsgTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_TxPtr),de
    ret

; EmLine: one line of the message at TxPtr, at row TxRow, column TxCol.
; TxEnd = 1 at the end of the message; TxFull = 1 (nothing printed) when
; TxRow is past TxLast. A page break ($FE) moves TxRow past TxLast unless
; the window is still empty (TxRow = TxTop).
EmLine:
    xor a
    ld (AMY_UVAR_TxEnd),a
    ld (AMY_UVAR_TxFull),a
    ld hl,(AMY_UVAR_TxPtr)
    ld a,(hl)
    cp $FF
    jr nz,EmLn1
    ld a,1
    ld (AMY_UVAR_TxEnd),a
    ret
EmLn1:
    cp $FE
    jr nz,EmLn2
    inc hl
    ld (AMY_UVAR_TxPtr),hl
    ld a,(AMY_UVAR_TxTop)
    ld b,a
    ld a,(AMY_UVAR_TxRow)
    cp b
    ret z
    ld a,(AMY_UVAR_TxLast)
    inc a
    ld (AMY_UVAR_TxRow),a
    ret
EmLn2:
    ld a,(AMY_UVAR_TxLast)
    ld b,a
    ld a,(AMY_UVAR_TxRow)
    cp b
    jr z,EmLn3
    jr c,EmLn3
    ld a,1
    ld (AMY_UVAR_TxFull),a
    ret
EmLn3:
    ld c,(hl)
    inc hl
    ex de,hl
    ld a,c
    or a
    jr z,EmLn5
    ; VRAM address $1800 + row * 32 + column
    ld a,(AMY_UVAR_TxRow)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_TxCol)
    add a,l
    ld l,a
    ld a,h
    adc a,$18
    ld h,a
    call EmWAddr
EmLn4:
    ld a,(de)
    out ($BE),a
    inc de
    dec c
    jr nz,EmLn4
EmLn5:
    ld (AMY_UVAR_TxPtr),de
    ld a,(AMY_UVAR_TxRow)
    inc a
    ld (AMY_UVAR_TxRow),a
    ret
; generated by text.py - do not edit
EmMsgTab:
    dw EmM_Intro, EmM_Room1, EmM_Room2, EmM_Room3, EmM_Room4, EmM_Room5, EmM_Room6, EmM_Room7
    dw EmM_Room8, EmM_Room9, EmM_Room10, EmM_Room11, EmM_Room12, EmM_Room13, EmM_Room14, EmM_Peer1
    dw EmM_Peer2, EmM_Peer3, EmM_Peer4, EmM_Peer5, EmM_Peer6, EmM_Peer7, EmM_Peer8, EmM_Peer9
    dw EmM_Peer10, EmM_Peer11, EmM_Peer12, EmM_Peer13, EmM_Peer14, EmM_Block0, EmM_Block1, EmM_Block2
    dw EmM_Block3, EmM_Block4, EmM_Block5, EmM_Block6, EmM_Block7, EmM_Thing0, EmM_Thing1, EmM_Thing2
    dw EmM_Thing3, EmM_Thing4, EmM_Thing5, EmM_Thing6, EmM_Thing7, EmM_Thing8, EmM_Thing9, EmM_Short0
    dw EmM_Short1, EmM_Short2, EmM_Short3, EmM_Short4, EmM_Short5, EmM_Short6, EmM_Short7, EmM_Short8
    dw EmM_Short9, EmM_Reach, EmM_GotIt, EmM_NothingHere, EmM_DontHave, EmM_GotNothing, EmM_YouveGot, EmM_LeftBehind
