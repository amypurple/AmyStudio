data PicPatTab words = @EmPicP0, @EmPicP1, @EmPicP2, @EmPicP3, @EmPicP4, @EmPicP5, @EmPicP6, @EmPicP7, @EmPicP8, @EmPicP9, @EmPicP10, @EmPicP11, @EmPicP12, @EmPicP13, @EmPicP14, @EmPicP15
data PicColTab words = @EmPicC0, @EmPicC1, @EmPicC2, @EmPicC3, @EmPicC4, @EmPicC5, @EmPicC6, @EmPicC7, @EmPicC8, @EmPicC9, @EmPicC10, @EmPicC11, @EmPicC12, @EmPicC13, @EmPicC14, @EmPicC15

' ShowPic: picture Pic in the top screen third (display off: the ZX0
' decoder reads VRAM back). Called with the NMI off.
sub ShowPic:
  display off
  decompress zx0 PicPatTab[Pic] to vram.pattern
  decompress zx0 PicColTab[Pic] to vram.color
  Shown = Pic
  return
end sub

