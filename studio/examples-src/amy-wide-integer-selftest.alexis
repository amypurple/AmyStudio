project "AMY WIDE INTEGER SELFTEST"
memory "colecovision_legacy_sdcc"

record WideValues:
  u32 Unsigned
  i32 Signed
  u16 WordValue
  i16 SignedWord
end record

overlay TestRam
  First as WideValues
  Second as WideValues
end overlay

u32 Left32 = 4278255360
u32 Right32 = 252645135
u32 And32 = 0
u32 Or32 = 0
u32 Xor32 = 0
u32 Not32 = 0
u32 ShiftLeft32 = 0
u32 ShiftRight32 = 0
u32 VariableShift32 = 0
u32 SaturatedShift32 = 1
i32 SignedShift32 = 0
i32 SignedSaturated32 = 0
i32 SignedAnd32 = 0
i32 SignedNot32 = 0
u32 Compound32 = 0
u32 Array32[2]
u32 ArrayResult32 = 0
WideValues RecordValues
u32 RecordResult32 = 0
u32 OverlayResult32 = 0
u16 Compound16 = 0
i16 SignedCompound16 = 0
u16 VariableShift16 = 0
i16 SignedVariableShift16 = 0
u16 SaturatedShift16 = 1
u8 ShiftCount = 8
u8 LargeShiftCount = 40
u8 Passed = 0

And32 = Left32 & Right32
Or32 = Left32 | Right32
Xor32 = Left32 ^ Right32
Not32 = ~Left32
ShiftLeft32 = 65281 << 12
ShiftRight32 = 4026532096 >> 8
VariableShift32 = 305419896 << ShiftCount
SaturatedShift32 = Left32 >> LargeShiftCount
SignedShift32 = -16 >> 2
SignedSaturated32 = -16 >> LargeShiftCount
SignedAnd32 = -1 & 252645135
SignedNot32 = ~-252645136

Compound32 = Left32
Compound32 &= Right32
Compound32 |= 16711680
Compound32 ^= 65535
Compound32 <<= 4
Compound32 >>= 4

Array32[0] = 4294901760
Array32[0] >>= 12
Array32[1] = 305419896
Array32[1] &= 16711935
ArrayResult32 = Array32[0] | Array32[1]

RecordValues.Unsigned = 2147516415
RecordValues.Unsigned ^= 16711935
RecordValues.Unsigned <<= 1
RecordResult32 = RecordValues.Unsigned
RecordValues.Signed = -1
RecordValues.Signed &= 16711935
RecordValues.Signed ^= 255

TestRam.First.Unsigned = 4042322160
TestRam.First.Unsigned &= 16711935
TestRam.First.Unsigned >>= 4
OverlayResult32 = TestRam.Second.Unsigned

Compound16 = 65295
Compound16 &= 3855
Compound16 |= 61440
Compound16 ^= 255
SignedCompound16 = -1
SignedCompound16 &= 4095
SignedCompound16 ^= 255
VariableShift16 = 4660 << ShiftCount
SignedVariableShift16 = -16 >> ShiftCount
SaturatedShift16 = 4660 >> LargeShiftCount

if And32 = 251662080 then Passed += 1
if Or32 = 4279238415 then Passed += 1
if Xor32 = 4027576335 then Passed += 1
if Not32 = 16711935 then Passed += 1
if ShiftLeft32 = 267390976 then Passed += 1
if ShiftRight32 = 15728641 then Passed += 1
if VariableShift32 = 878082048 then Passed += 1
if SaturatedShift32 = 0 then Passed += 1
if SignedShift32 = -4 then Passed += 1
if SignedSaturated32 = -1 then Passed += 1
if SignedAnd32 = 252645135 then Passed += 1
if SignedNot32 = 252645135 then Passed += 1
if Compound32 = 268431615 then Passed += 1
if ArrayResult32 = 4194296 then Passed += 1
if RecordResult32 = 33488384 then Passed += 1
if RecordValues.Signed = 16711680 then Passed += 1
if OverlayResult32 = 983055 then Passed += 1
if Compound16 = 65520 then Passed += 1
if SignedCompound16 = 3840 then Passed += 1
if VariableShift16 = 13312 then Passed += 1
if SignedVariableShift16 = -1 then Passed += 1
if SaturatedShift16 = 0 then Passed += 1

text screen
if Passed = 22 then
  print centered at 10, "WIDE INTEGER PASS"
else
  print centered at 10, "WIDE INTEGER FAIL"
end if
screen on
loop forever
