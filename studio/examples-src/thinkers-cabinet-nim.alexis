    db $C0,$5A,$F0,$48,$C0,$72,$F0,$24,$C0,$66,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$98,$F0,$24,$C0,$88,$F0,$48,$C0,$98,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$88,$F0,$24,$C0,$66,$F0,$24,$C0,$72,$F0,$24,$C0,$66,$F0,$24
    db $C0,$5A,$F0,$48,$D8
SfxClick:
    db $00,$00,$15,$01,$02,$36,$02,$23,$11,$10
SfxTock:
    db $82,$55,$20,$02,$23,$11,$90
SfxLift:
    db $41,$2C,$31,$06,$11,$E2,$50
SfxMove:
    db $80,$39,$40,$02,$90
SfxRefuse:
    db $42,$57,$23,$05,$24,$11,$50
SfxAgain:
    db $42,$AA,$00,$08,$14,$22,$42,$8F,$00,$08,$14,$22,$42,$71,$00,$08
    db $14,$22,$42,$55,$00,$10,$14,$32,$50
SfxStart:
    db $42,$AA,$00,$0A,$14,$22,$42,$8F,$00,$0A,$14,$22,$42,$71,$00,$0A
    db $14,$22,$42,$55,$00,$1E,$14,$32,$50
SfxWin:
    db $42,$AA,$00,$0C,$14,$22,$42,$8F,$00,$0C,$14,$22,$42,$71,$00,$0C
    db $14,$22,$42,$55,$00,$0C,$14,$22,$66,$42,$71,$00,$0C,$14,$22,$42
    db $55,$00,$30,$14,$32,$50
SfxLose:
    db $42,$71,$00,$18,$14,$32,$42,$8F,$00,$18,$14,$32,$42,$AA,$00,$18
    db $14,$32,$42,$E2,$00,$18,$14,$32,$42,$53,$01,$40,$14,$32,$50
SfxDraw:
    db $42,$AA,$00,$12,$14,$32,$42,$E2,$00,$12,$14,$32,$42,$AA,$00,$12
    db $14,$32,$42,$71,$00,$30,$14,$32,$50
SfxSlide:
    db $02,$36,$03,$14,$21,$10
SfxSolved:
    db $42,$7F,$00,$0A,$14,$22,$42,$6B,$00,$0A,$14,$22,$42,$55,$00,$0A
    db $14,$22,$42,$40,$00,$0A,$14,$22,$65,$42,$55,$00,$0A,$14,$22,$42
    db $40,$00,$28,$14,$32,$50
SfxFlip:
    db $00,$00,$25,$01,$02,$44,$02,$23,$11,$10
  }
end sub

' ShellForce (called only when Keep[15] = 77, which never happens): uses what the games use from Amy's runtime
' (number printing, 8 and 16-bit division, the sprite flicker switch), so
' the runtime part of the fixed bank is the same in every compile
sub ShellForce:
  print Wt at 2,2 width 3
  print Wf at 2,2 width 5
  Wt = Tx / 6
  Wt = Tx % 6
  Wf = Wf / Rs
  sprites flicker off
  return
end sub

' the end of the fixed bank (its ret is at $BFFF): the games start at $C000
sub ShellEnd:
  return
  asm {
    ds $BFFF-$,$FF
  }
end sub

' ---- the gate: the first bytes of the bank ($C000), the shell calls it
sub GameGate:
  asm {
    jp AMY_UPROC_NimMain
  }
end sub

' ---------------------------------------------------------------------------
' games/nim.alexis - SQUARE NIM (module of THE THINKER'S CABINET), the game
' 10 of "Games to Play on Your Oric-1" by Czes Kosniowski (Shiva, 1983),
' ColecoVision version by Amy & Claude 2026 (transcription in
' ../../transcriptions/10-square-nim). Entry: NimMain (its card: START /
' LEVEL < 1-5 > / HOW TO PLAY / BACK).
'
' THE GAME (as in the book): ten rows, in each row a piece A (left) and a
' piece B (right). In turn, a player picks a row and moves his own piece
' left or right, as far as he likes, without jumping over the other one
' (going back is allowed). The game ends when the two pieces of every row
' touch; the player who makes it so wins. The start: A at 0-4, B somewhere
' to its right (the book's lines 1060-1070). Arrows move the flashing piece,
' up/down change row only while nothing has moved yet, Y confirms.
'
' LIBERTIES (listed for Amy):
' - One player (A, cyan) against the computer (B, red): the book is for two.
'   Game 1: you start (the book: A first); then the loser starts.
' - Joystick: up/down choose the row (lit) while your stone has not moved,
'   left/right slide it one square, the button confirms (only after a move).
' - The computer plays Northcott's game as Nim: the gaps between the stones
'   are Nim heaps; it moves to make their XOR zero, and when it cannot (a
'   losing position) it closes a gap by one. A share of its moves is random,
'   by level: LV 1 100 %, LV 2 85 %, LV 3 60 %, LV 4 30 %, LV 5 0 % (perfect);
'   at LV 1-2 its random moves are one square (a timid player). It never
'   moves back. (model/nim.py and tests/nmbot.mjs measure it.)
' - No soft-lock: going back could last forever, so 100 moves end the game
'   as a draw (the book has no limit).
' - The stones slide square by square (4 pixels a frame); the row is lit.
' ---------------------------------------------------------------------------

const NmX0 = 6           ' square c of row r at col 6 + 2c, row 2 + 2r
const NmY0 = 2

u8 NA[10]                ' your stones (0-9)
u8 NB[10]                ' the computer's stones
u8 NRow = 0              ' the lit row
u8 NTurn = 0             ' 0 you, 1 CPU
u8 NFirst = 0            ' who starts the next game (2 = you, the first game)
u8 NLv = 0
u8 NMenu = 0
u8 NMoves = 0
u8 NMoved = 0            ' your stone's way this turn (+ right, 128 + left)
u8 NStart = 0
u8 Ni = 0
u8 Nj = 0
u8 Nk = 0
u8 Nc = 0
u8 Ng = 0
u8 Nx = 0
u8 Nd = 0
u8 Nw = 0
u8 NWin = 0
u8 NDemo = 0
u8 NDemoT = 0
u8 Nt = 0
u8 NTo = 0

data NRnd bytes 100,85,60,30,0

sub NimMain:
  ' kept in the shell's Keep[12..13]
  NLv = Keep[12]
  NFirst = Keep[13]
  if NLv = 0 then
    NLv = 1
    NFirst = 0
  end if
nm_card:
  NimCard
  if NMenu = 3 then
    Keep[12] = NLv
    Keep[13] = NFirst
    return
  end if
  if NMenu = 2 then
    NmHelpScreen
    goto nm_card
  end if
  NmPlay
  goto nm_card
end sub

sub NmTiles:
  fill mode 2 text color with $F0
  copy NmPat count NmBytes to vram.pattern + 1024
  copy NmPat count NmBytes to vram.pattern + 3072
  copy NmPat count NmBytes to vram.pattern + 5120
  copy NmCol count NmBytes to vram.color + 1024
  copy NmCol count NmBytes to vram.color + 3072
  copy NmCol count NmBytes to vram.color + 5120
  backdrop 12
  cls
  return
end sub

' row Ni of the board (lit if it is NRow)
sub NmRowDraw:
  Nt = NmSlot00
  if Ni = NRow then Nt = NmLit00
  Y = Ni << 1
  Y += NmY0
  for Nc = 0 to 9
    X = Nc << 1
    X += NmX0
    put char Nt at X,Y
    V = Nt + 1
    J = X + 1
    put char V at J,Y
    V = Nt + 2
    N = Y + 1
    put char V at X,N
    V = Nt + 3
    put char V at J,N
  next
  return
end sub

' the two stones of row Ni (sprites 2 Ni and 2 Ni + 1)
sub NmStones:
  Y = Ni << 4
  Y += 15
  X = NA[Ni]
  X = X << 4
  X += 48
  V = Ni << 1
  set sprite V to Y,X,SpNa,7
  X = NB[Ni]
  X = X << 4
  X += 48
  inc V
  set sprite V to Y,X,SpNb,8
  return
end sub

sub NmHud:
  put char NmHa at 3,1
  print at 4,1, "YOU"
  print at 12,1, "LV"
  print NLv at 14,1 width 1
  print NMoves at 17,1 width 3
  put char NmHb at 25,1
  print at 26,1, "CPU"
  return
end sub

sub NmSay:
  fill 32 count 26 at 3,22
  return
end sub

' the deal (the book's lines 1060-1070), never already finished
sub NmDeal:
nd_again:
  Nw = 0
  for Ni = 0 to 9
    Rnd
    V = R2 % 5
    NA[Ni] = V
    J = 9 - V
    Rnd
    N = R2 % J
    N += V
    inc N
    NB[Ni] = N
    J = N - V
    if J > 1 then Nw = 1
  next
  if Nw = 0 then goto nd_again
  return
end sub

' Ng = the gap of row Ni; Nw = 1 if every gap is zero
sub NmAllShut:
  Nw = 1
  for Ni = 0 to 9
    Ng = NB[Ni] - NA[Ni]
    if Ng > 1 then Nw = 0
  next
  return
end sub

' slide stone Nk (0 = A, 1 = B) of row Ni from square Nc to square Nd, a
' square at a time (4 frames a square, 4 pixels a frame)
sub NmSlide:
  while Nc <> Nd
    play sound SndSlide
    for Nj = 1 to 4
      Frame1
      Phase = 1
      Y = Ni << 4
      Y += 15
      X = Nc << 4
      X += 48
      V = Nj << 2
      if Nd > Nc then
        X += V
      else
        X -= V
      end if
      V = Ni << 1
      V += Nk
      if Nk = 0 then
        set sprite V to Y,X,SpNa,7
      else
        set sprite V to Y,X,SpNb,8
      end if
      update sprites
    next
    if Nd > Nc then
      inc Nc
    else
      dec Nc
    end if
  end while
  return
end sub

sub NmPlay:
  BlankScreen
  NmTiles
  set sprite count 20
  sprites flicker off
  NRow = 0
  NmDeal
  for Ni = 0 to 9
    NmRowDraw
    NmStones
  next
  update sprites
  NMoves = 0
  NmHud
  ShowScreen
  nmi off
  play sound SndStart
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  NTurn = NFirst
  if NTurn = 2 then NTurn = 0
nm_turn:
  Frame1
  Phase = 1
  NmSay
  if NTurn = 0 then
    print at 11,22, "YOUR MOVE"
    NmYourMove
  else
    print at 12,22, "MY MOVE"
    NmCpuMove
  end if
  inc NMoves
  print NMoves at 17,1 width 3
  NmAllShut
  if Nw = 1 then
    NWin = NTurn
    goto nm_end
  end if
  if NMoves >= 100 then
    NWin = 2
    goto nm_end
  end if
  NTurn = NTurn ^ 1
  goto nm_turn
nm_end:
  Phase = 0
  StopMusic
  NmSay
  if NWin = 0 then
    print at 11,22, "YOU WIN!"
    NFirst = 1
    play sound SndWin
  end if
  if NWin = 1 then
    print at 12,22, "I WIN!"
    NFirst = 0
    play sound SndLose
  end if
  if NWin = 2 then
    print at 6,22, "100 MOVES: A DRAW"
    play sound SndDraw
  end if
  for Wt = 1 to 90
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

' change the lit row
sub NmLight:
  Nx = NRow
  NRow = Nd
  Ni = Nx
  NmRowDraw
  Frame1
  Phase = 1
  Ni = NRow
  NmRowDraw
  return
end sub

' your move: up/down pick a row (before moving), left/right slide A, button
sub NmYourMove:
  NStart = NA[NRow]
  WaitIn = 1
ny_loop:
  Frame1
  Phase = 1
  ReadPad
  if StickHit = 1 then
    Ni = NRow
    Nc = NA[Ni]
    if NStart = Nc then
      if Up1 = 1 then
        if NRow > 0 then
          Nd = NRow - 1
          NmLight
          NStart = NA[NRow]
          play sound SndMove
        end if
      end if
      if Dn1 = 1 then
        if NRow < 9 then
          Nd = NRow + 1
          NmLight
          NStart = NA[NRow]
          play sound SndMove
        end if
      end if
    end if
    Ni = NRow
    Nc = NA[Ni]
    Nd = Nc
    if Lf1 = 1 then
      if Nc > 0 then Nd = Nc - 1
    end if
    if Rt1 = 1 then
      V = NB[Ni] - 1
      if Nc < V then Nd = Nc + 1
    end if
    if Nd <> Nc then
      Nk = 0
      NmSlide
      NA[Ni] = Nd
    else
      if Lf1 = 1 then play sound SndRefuse
      if Rt1 = 1 then play sound SndRefuse
    end if
  end if
  if Press = 0 then goto ny_loop
  ' the button: only after a move
  Nc = NA[NRow]
  if Nc = NStart then
    play sound SndRefuse
    goto ny_loop
  end if
  WaitIn = 0
  return
end sub

' the computer: Nim (XOR of the gaps), with a share of random moves
sub NmCpuMove:
  for Wt = 1 to 20
    Frame1
    Phase = 1
  next
  ' Nx = the XOR of the gaps
  Nx = 0
  for Ni = 0 to 9
    Ng = NB[Ni] - NA[Ni]
    dec Ng
    Nx = Nx ^ Ng
  next
  V = NLv - 1
  Nw = NRnd[V]
  Rnd
  V = R2 % 100
  Nd = 99
  if V >= Nw then
    if Nx <> 0 then
      ' the row where gap XOR x is smaller: shut it down to that
      for Ni = 0 to 9
        if Nd = 99 then
          Ng = NB[Ni] - NA[Ni]
          dec Ng
          V = Ng ^ Nx
          if V < Ng then
            Nk = Ni
            Nd = NB[Ni] - Ng
            Nd += V
          end if
        end if
      next
    end if
  end if
  if Nd = 99 then
    ' random (or a losing position): a row with a gap, from a random place
    Rnd
    Ni = R2 % 10
    for Nj = 1 to 10
      inc Ni
      if Ni >= 10 then Ni = 0
      Ng = NB[Ni] - NA[Ni]
      dec Ng
      if Ng > 0 then
        if Nd = 99 then
          Nk = Ni
          Nd = 1
          V = Nw
          if Nx = 0 then V = 0
          ' LV 1-2: a timid computer, one square at a time
          if NLv <= 2 then V = 0
          Rnd
          N = R2 % 100
          if N < V then
            Rnd
            Nd = R2 % Ng
            inc Nd
          end if
          Nd = NB[Ni] - Nd
        end if
      end if
    next
  end if
  ' the lit row walks to row Nk, then B slides to square Nd
  NTo = Nd
  while NRow <> Nk
    if NRow < Nk then
      Nd = NRow + 1
    else
      Nd = NRow - 1
    end if
    NmLight
    play sound SndMove
    for Wt = 1 to 5
      Frame1
      Phase = 1
    next
  end while
  Nd = NTo
  Ni = Nk
  Nc = NB[Ni]
  Nk = 1
  NmSlide
  NB[Ni] = Nd
  for Wt = 1 to 15
    Frame1
    Phase = 1
  next
  return
end sub

' ------------------------------------------------------------ the card
sub NimCard:
  BlankScreen
  NmTiles
  print at 10,2, "SQUARE NIM"
  print at 7,4, "ORIGINAL GAME BY"
  print at 8,5, "CZES KOSNIOWSKI"
  ' a row of the board, stones sliding (row 3 of the board = screen rows 8-9)
  NRow = 99
  Ni = 3
  NmRowDraw
  NA[3] = 1
  NB[3] = 7
  NmStones
  print at 11,13, "START"
  print at 11,15, "LEVEL"
  print at 11,17, "HOW TO PLAY"
  print at 11,19, "BACK"
  print at 8,21, "AMY & CLAUDE 2026"
  NmShowLv
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  NMenu = 0
  NDemo = 0
  NDemoT = 0
  Phase = 7
  Rearm
  wait no fire
  WasBtn = 0
  nmi off
nc_loop:
  Frame1
  ReadPad
  Rnd
  V = NMenu << 4
  V += 100
  set sprite 4 to V,70,SpCu0,SpCuC0
  set sprite 5 to V,70,SpCu1,SpCuC1
  ' the demo: A walks right to B and back, a square every 16 frames
  inc NDemoT
  if NDemoT >= 16 then
    NDemoT = 0
    if NDemo = 0 then
      NA[3] = NA[3] + 1
      if NA[3] >= 6 then NDemo = 1
    else
      NA[3] = NA[3] - 1
      if NA[3] <= 1 then NDemo = 0
    end if
  end if
  Ni = 3
  NmStones
  update sprites
  if StickHit = 1 then
    if Up1 = 1 then
      if NMenu = 0 then
        NMenu = 3
      else
        dec NMenu
      end if
      play sound SndMove
    end if
    if Dn1 = 1 then
      inc NMenu
      if NMenu > 3 then NMenu = 0
      play sound SndMove
    end if
    if NMenu = 1 then
      if Lf1 = 1 then
        if NLv > 1 then dec NLv
      end if
      if Rt1 = 1 then
        if NLv < 5 then inc NLv
      end if
      NmShowLv
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto nc_loop
  if NMenu = 1 then goto nc_loop
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub NmShowLv:
  print at 18,15, "< >"
  put char NLv + 48 at 19,15
  return
end sub

sub NmHelpScreen:
  BlankScreen
  NmTiles
  PageNmHelp
  put char NmHa at 3,3
  put char NmHb at 4,4
  put char NmHupdn at 3,13
  put char NmHstick at 3,14
  put char NmHbtn at 3,15
  WaitPage
  return
end sub

' the end of this game's code in its bank (build.py: the literal pool after it
' starts at the same address in every bank, the shell's strings first)
sub NmEnd:
  return
  asm {
    ds $DC00-$,$FF
  }
end sub

u8 RamPadNim[119]   ' build.py: same RAM end in every bank

' text pages (generated by _common/tools/textpages.py)
sub PageNmHelp:
  print at 4,1, "SQUARE NIM  HOW TO PLAY"
  print at 2,3, "TEN ROWS, IN EACH ROW YOUR"
  print at 2,4, "STONE A (LEFT) AND MY STONE"
  print at 2,5, "B (RIGHT). IN YOUR TURN,"
  print at 2,6, "MOVE YOUR STONE IN ONE ROW,"
  print at 2,7, "LEFT OR RIGHT, AS FAR AS YOU"
  print at 2,8, "LIKE, BUT NEVER OVER MINE."
  print at 2,10, "WHO MAKES THE STONES OF ALL"
  print at 2,11, "TEN ROWS TOUCH WINS."
  print at 5,13, "UP/DOWN: CHOOSE A ROW"
  print at 5,14, "LEFT/RIGHT: SLIDE YOUR A"
  print at 5,15, "BUTTON: DONE"
  print at 2,17, "YOU CAN STILL CHANGE ROWS"
  print at 2,18, "UNTIL YOUR STONE HAS MOVED."
  print at 2,19, "100 MOVES: A DRAW."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

data NmPat bytes
  $00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$01,$01,$01,$01,$01,$01
  $80,$80,$80,$80,$80,$80,$00,$00,$01,$01,$01,$01,$01,$01,$00,$00
  $00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$01,$01,$01,$01,$01,$01
  $80,$80,$80,$80,$80,$80,$00,$00,$01,$01,$01,$01,$01,$01,$00,$00
  $C3,$99,$C3,$C3,$00,$C3,$C3,$00,$03,$C6,$C6,$03,$C6,$C6,$03,$00
  $18,$C3,$18,$18,$18,$81,$00,$81,$00,$C3,$81,$81,$81,$81,$C3,$00
  $10,$38,$83,$10,$10,$83,$38,$10
end data

data NmCol bytes
  $0A,$06,$A1,$A1,$A1,$A1,$A1,$A1,$0A,$06,$A1,$A1,$A1,$A1,$A1,$A1
  $A1,$A1,$A1,$A1,$A1,$A1,$0B,$0A,$A1,$A1,$A1,$A1,$A1,$A1,$0B,$0A
  $0B,$08,$B4,$B4,$B4,$B4,$B4,$B4,$0B,$08,$B4,$B4,$B4,$B4,$B4,$B4
  $B4,$B4,$B4,$B4,$B4,$B4,$0F,$0B,$B4,$B4,$B4,$B4,$B4,$B4,$0F,$0B
  $07,$07,$70,$70,$07,$70,$70,$00,$08,$80,$80,$08,$80,$80,$08,$00
  $E0,$0E,$E0,$E0,$E0,$0E,$0E,$0E,$00,$08,$08,$08,$08,$08,$08,$00
  $F0,$F0,$0F,$F0,$F0,$0F,$F0,$F0
end data
