' FP5 convert lab: inspect raw 5-byte fp5 encodings from integer sources.
u16 UZero = 0
u16 UOne = 1
u16 UTen = 10
u16 UHundred = 100
i16 SNegOne = -1
i16 SNegTen = -10
fp5 FZero = 0
fp5 FOne = 0
fp5 FTen = 0
fp5 FHundred = 0
fp5 FNegOne = 0
fp5 FNegTen = 0
u8 BZero[5] = 0
u8 BOne[5] = 0
u8 BTen[5] = 0
u8 BHundred[5] = 0
u8 BNegOne[5] = 0
u8 BNegTen[5] = 0

  text screen
  print at 8,0, "FP5 CONVERT LAB"
  print at 1,1, "RAW BYTES      B4  B3  B2  B1  B0"

  FZero = UZero
  FOne = UOne
  FTen = UTen
  FHundred = UHundred
  FNegOne = SNegOne
  FNegTen = SNegTen

  copy bytes of FZero to BZero
  copy bytes of FOne to BOne
  copy bytes of FTen to BTen
  copy bytes of FHundred to BHundred
  copy bytes of FNegOne to BNegOne
  copy bytes of FNegTen to BNegTen

  print at 1,4,  "0"
  print BZero[4] at 11,4 digits 3
  print BZero[3] at 15,4 digits 3
  print BZero[2] at 19,4 digits 3
  print BZero[1] at 23,4 digits 3
  print BZero[0] at 27,4 digits 3

  print at 1,6,  "1"
  print BOne[4] at 11,6 digits 3
  print BOne[3] at 15,6 digits 3
  print BOne[2] at 19,6 digits 3
  print BOne[1] at 23,6 digits 3
  print BOne[0] at 27,6 digits 3

  print at 1,8,  "10"
  print BTen[4] at 11,8 digits 3
  print BTen[3] at 15,8 digits 3
  print BTen[2] at 19,8 digits 3
  print BTen[1] at 23,8 digits 3
  print BTen[0] at 27,8 digits 3

  print at 1,10, "100"
  print BHundred[4] at 11,10 digits 3
  print BHundred[3] at 15,10 digits 3
  print BHundred[2] at 19,10 digits 3
  print BHundred[1] at 23,10 digits 3
  print BHundred[0] at 27,10 digits 3

  print at 1,12, "-1"
  print BNegOne[4] at 11,12 digits 3
  print BNegOne[3] at 15,12 digits 3
  print BNegOne[2] at 19,12 digits 3
  print BNegOne[1] at 23,12 digits 3
  print BNegOne[0] at 27,12 digits 3

  print at 1,14, "-10"
  print BNegTen[4] at 11,14 digits 3
  print BNegTen[3] at 15,14 digits 3
  print BNegTen[2] at 19,14 digits 3
  print BNegTen[1] at 23,14 digits 3
  print BNegTen[0] at 27,14 digits 3

  print at 1,17, "EXPECT"
  print at 1,18, "1   = 129 000 000 000 000"
  print at 1,19, "10  = 132 032 000 000 000"
  print at 1,20, "100 = 135 072 000 000 000"
  print at 1,21, "-1  = 129 128 000 000 000"
  print at 1,22, "-10 = 132 160 000 000 000"
  screen on