' ---------------------------------------------------------------- constants
const FX0 = 3           ' the field inside the border
const FX1 = 28
const FY0 = 3
const FY1 = 21
const MaxLives = 5

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u8 RabX = 15            ' the rabbit's cell
u8 RabY = 21
u8 OldX = 15
u8 OldY = 21
u8 TgX = 15
u8 TgY = 21
u8 SpX = 0              ' the rabbit's cell box in pixels (top-left)
u8 SpY = 0
u8 Lift = 0             ' hop height
u8 HopT = 0
u8 HoldT = 0
u8 NeedRel = 0
u8 StunT = 0
u8 Face = 3             ' 0 right, 1 left, 2 down (front), 3 up (back), 4 hurt
u8 Dir = 0
u8 CurC = 0             ' the detector's reading here
u8 Cnt = 0
u8 Level = 1
u8 StartLv = 1
u8 Lives = 3
u8 NTraps = 30
u8 Placed = 0
u8 CarX = 15
u8 StX = 15
u8 Won = 0
u8 Caught = 0
u16 Moves = 0
u16 Score = 0
u16 Bonus = 0
u8 Tx = 0
u8 Ty = 0
u8 Cc = 0
u8 K = 0
u8 I = 0
u8 Ax = 0
u8 Ay = 0
u8 Nx = 0
u8 Ny = 0
u8 Bx = 0
u8 By = 0
u8 Hit = 0
u8 AnF = 0
u8 SparkF = 0
u8 LeafF = 0
u8 FlakeA = 0
u8 FlakeB = 0
u8 Menu = 0
u8 Tf = 0
u8 TitX = 0
u8 TitT = 0
u8 Wt = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 Season = 0
u8 ParB = 0
u8 PSlot = 3
u8 ParX[2]
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title

' traps per level (1-10, then the last value), in a 26 x 17 = 442-cell zone
data TrapT bytes 30,45,66,86,102,114,124,132,138,144
' the hop's height, frame by frame (HopT 7..0)
data Arc bytes 0,2,4,5,5,4,2,0
' particles: sideways sway (0-8, 4 = straight)
data Wob bytes 4,5,6,7,8,7,6,5,4,3,2,1,0,1,2,3

' ================================================================== program
  tile screen
  ' mode 2 screen: three pattern and colour thirds (the snow is shaded
  ' differently in each third; the logo lives in the top third only)
  mode 2 screen
  set sound table CcSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $C4A7
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Lives = 3
  Score = 0

new_field:
  Season = Level - 1
  Season = Season >> 1
  if Season > 3 then Season = 3
  SeasonCard
  NewField
  play sound SndStart
  StartMusic

play_loop:
  Frame1
  Phase = 1
  ReadPad
  if HopT > 0 then
    HopStep
  else
    if StunT > 0 then
      StunStep
    else
      TryMove
    end if
  end if
  Animate
  DrawRabbit
  Particles
  if Won = 1 then goto cleared
  if Lives = 0 then
    if StunT = 0 then goto game_over
  end if
  goto play_loop

' ------------------------------------------------------------ the carrot
cleared:
  Phase = 0
  StopMusic
  Face = 2
  DrawRabbit
  play sound SndCrunch
  for Wt = 1 to 70
    Frame1
    Animate
    if Wt = 20 then put char CcBite1 at CarX,FY0
    if Wt = 40 then put char CcBite2 at CarX,FY0
    if Wt = 60 then put char CcFp0 at CarX,FY0
  next
  play sound SndClear
  ' bonus: 10 per level, and the hops saved under 150 (the book's ESSAIS)
  Bonus = Level * 10
  if Moves < 150 then
    Bonus += 150
    Bonus -= Moves
  end if
  Score += Bonus
  fill 32 count 28 at 2,1
  put char CcHcar at 2,1
  print at 4,1, "CARROT!  BONUS"
  print Bonus at 19,1 width 4
  RevealAll
  for Wt = 1 to 120
    Frame1
    Animate
  next
  HideSprites
  if Level < 99 then inc Level
  ' a rabbit back every three fields (4, 7, 10...)
  V = Level % 3
  if V = 1 then
    if Lives < MaxLives then inc Lives
  end if
  goto new_field

' ------------------------------------------------------------ no rabbit left
game_over:
  Phase = 0
  StopMusic
  RevealAll
  for Wt = 1 to 40
    Frame1
    Animate
  next
  HideSprites
  GameOver
  goto title

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ tiles
' the same patterns in the three thirds, the snow shaded per third
sub LoadTiles:
  fill mode 2 text color with $F0
  copy CcPat count CcBytes to vram.pattern + 1024
  copy CcPat count CcBytes to vram.pattern + 3072
  copy CcPat count CcBytes to vram.pattern + 5120
  if Season = 0 then
    copy CcCol00 count CcBytes to vram.color + 1024
    copy CcCol01 count CcBytes to vram.color + 3072
    copy CcCol02 count CcBytes to vram.color + 5120
  end if
  if Season = 1 then
    copy CcCol10 count CcBytes to vram.color + 1024
    copy CcCol11 count CcBytes to vram.color + 3072
    copy CcCol12 count CcBytes to vram.color + 5120
  end if
  if Season = 2 then
    copy CcCol20 count CcBytes to vram.color + 1024
    copy CcCol21 count CcBytes to vram.color + 3072
    copy CcCol22 count CcBytes to vram.color + 5120
  end if
  if Season = 3 then
    copy CcCol30 count CcBytes to vram.color + 1024
    copy CcCol31 count CcBytes to vram.color + 3072
    copy CcCol32 count CcBytes to vram.color + 5120
  end if
  backdrop 4
  cls
  return
end sub

' the snow tile of cell Tx,Ty (a fixed 16 x 8 map) in Cc
sub SnowAt:
  V = Ty & 7
  V = V << 4
  J = Tx & 15
  V += J
  Cc = SnowMap[V]
  Cc += CcSnow0
  return
end sub

' ------------------------------------------------------------ a new field
sub NewField:
  BlankScreen
  sprites flicker off
  LoadTiles
  K = Level
  if K > 10 then K = 10
  dec K
  NTraps = TrapT[K]
  CarX = 15
  StX = 15
  if Level > 1 then
    Rnd
    V = R2 % 20
    CarX = V + 6
    Rnd
    V = R2 % 20
    StX = V + 6
  end if
  ' the border of visible traps (the book's lines 300-340)
  for Tx = 2 to 29
    put char CcBord at Tx,2
    put char CcBord at Tx,22
  next
  for Ty = FY0 to FY1
    put char CcBord at 2,Ty
    put char CcBord at 29,Ty
  next
  put char CcBordc at 2,2
  put char CcBordc at 29,2
  put char CcBordc at 2,22
  put char CcBordc at 29,22
  ' the snow
  for Ty = FY0 to FY1
    for Tx = FX0 to FX1
      SnowAt
      put char Cc at Tx,Ty
    next
  next
  ' a safe path from the start to the carrot, kept free while the traps
  ' are hidden (a random walk, half of its steps upwards)
  Ax = StX
  Ay = FY1
  put char CcRes at Ax,Ay
  while Ay > FY0
    Rnd
    V = R2 & 3
    if V < 2 then
      dec Ay
    else
      if V = 2 then
        if Ax > FX0 then dec Ax
      else
        if Ax < FX1 then inc Ax
      end if
    end if
    put char CcRes at Ax,Ay
  end while
  while Ax <> CarX
    if Ax < CarX then
      inc Ax
    else
      dec Ax
    end if
    put char CcRes at Ax,Ay
  end while
  ' the hidden traps (the book's lines 200-250: code 100, invisible)
  Placed = 0
  while Placed < NTraps
    Rnd
    V = R2 % 26
    Tx = V + FX0
    Rnd
    V = R2 % 17
    Ty = V + 4
    Cc = get char at Tx,Ty
    if Cc <= CcSnow3 then
      put char Cc + 4 at Tx,Ty
      inc Placed
    end if
  end while
  ' the path goes back to snow
  for Ty = FY0 to FY1
    for Tx = FX0 to FX1
      Cc = get char at Tx,Ty
      if Cc = CcRes then
        SnowAt
        put char Cc at Tx,Ty
      end if
    next
  next
  put char CcCar0 at CarX,FY0
  ' the rabbit (the book's line 360)
  RabX = StX
  RabY = FY1
  SpX = RabX * 8
  SpY = RabY * 8
  Lift = 0
  Face = 3
  HopT = 0
  StunT = 0
  HoldT = 0
  NeedRel = 1
  Won = 0
  Caught = 0
  Moves = 0
  PSlot = 3
  ParX[0] = 70
  ParX[1] = 170
  Ax = RabX
  Ay = RabY
  CountAt
  CurC = Cnt
  DrawHud
  ShowScreen
  DrawRabbit
  return
end sub

' ------------------------------------------------------------ the detector
' Cnt = traps on the 4 cells next to Ax,Ay (hidden, sprung, shown, border)
sub CountAt:
  Cnt = 0
  Nx = Ax + 1
  Ny = Ay
  TrapAt
  Nx = Ax - 1
  TrapAt
  Nx = Ax
  Ny = Ay + 1
  TrapAt
  Ny = Ay - 1
  TrapAt
  return
end sub

sub TrapAt:
  Cc = get char at Nx,Ny
  if Cc >= CcHid0 then
    if Cc <= CcBordc then inc Cnt
  end if
  return
end sub

' ------------------------------------------------------------ HUD (row 1)
' LV n, rabbits, the detector's lamps, hops
sub DrawHud:
  fill 32 count 28 at 2,1
  print at 2,1, "LV"
  print Level at 4,1 width 2
  DrawLives
  put char CcHdet at 13,1
  ShowLamps
  put char CcHpaw at 20,1
  ShowMoves
  return
end sub

sub DrawLives:
  HudIcons(CcHrab, 32, Lives, MaxLives, 7, 1)
  return
end sub

sub ShowLamps:
  for Bx = 1 to 4
    K = CcLamp0
    if Bx <= CurC then K = CcLamp0 + CurC
    By = Bx + 13
    put char K at By,1
  next
  return
end sub

sub ShowMoves:
  if Moves < 1000 then print Moves at 21,1 width 3
  return
end sub

' ------------------------------------------------------------ the rabbit
sub TryMove:
  if HoldT > 0 then dec HoldT
  if Stick = 0 then
    NeedRel = 0
    return
  end if
  if NeedRel = 1 then return
  if HoldT > 0 then return
  Dir = 9
  if Rt1 = 1 then Dir = 0
  if Lf1 = 1 then Dir = 1
  if Dn1 = 1 then Dir = 2
  if Up1 = 1 then Dir = 3
  if Dir = 9 then return
  Face = Dir
  Nx = RabX
  Ny = RabY
  if Dir = 0 then inc Nx
  if Dir = 1 then dec Nx
  if Dir = 2 then inc Ny
  if Dir = 3 then dec Ny
  Cc = get char at Nx,Ny
  ' a trap it can see (sprung, shown or the border): it will not go
  if Cc >= CcTrapr then
    if Cc <= CcBordc then
      play sound SndThud
      NeedRel = 1
      return
    end if
  end if
  ' its footprint keeps the detector's reading (the book: a black square)
  put char CcFp0 + CurC at RabX,RabY
  OldX = RabX
  OldY = RabY
  TgX = Nx
  TgY = Ny
  HopT = 8
  HoldT = 8
  inc Moves
  ShowMoves
  play sound SndHop
  return
end sub

sub HopStep:
  if HoldT > 0 then dec HoldT
  dec HopT
  K = 8 - HopT
  SpX = OldX * 8
  SpY = OldY * 8
  if Dir = 0 then SpX += K
  if Dir = 1 then SpX -= K
  if Dir = 2 then SpY += K
  if Dir = 3 then SpY -= K
  Lift = Arc[HopT]
  if HopT = 0 then Land
  return
end sub

sub Land:
  Lift = 0
  Cc = get char at TgX,TgY
  if Cc >= CcHid0 then
    if Cc <= CcHid3 then
      ' caught (the book's SHOOT): the trap springs, a rabbit is lost
      put char CcTrapr at TgX,TgY
      play sound SndSnap
      play sound SndOuch
      dec Lives
      DrawLives
      inc Caught
      Face = 4
      StunT = 70
      NeedRel = 1
      return
    end if
  end if
  RabX = TgX
  RabY = TgY
  if Cc = CcCar0 then Won = 1
  if Cc = CcCar1 then Won = 1
  if Won = 1 then return
  Ax = RabX
  Ay = RabY
  CountAt
  CurC = Cnt
  ShowLamps
  if CurC > 0 then
    NeedRel = 1
    if CurC = 1 then play sound SndDet1
    if CurC = 2 then play sound SndDet2
    if CurC = 3 then play sound SndDet3
    if CurC = 4 then play sound SndDet4
  end if
  return
end sub

' caught: it sits in the trap, then hops back to where it came from
sub StunStep:
  dec StunT
  if StunT > 0 then return
  if Lives = 0 then return
  Dir = Dir ^ 1
  Face = Dir
  Bx = OldX
  By = OldY
  OldX = TgX
  OldY = TgY
  TgX = Bx
  TgY = By
  HopT = 8
  play sound SndHop
  return
end sub

sub DrawRabbit:
  Bx = SpX - 4
  By = SpY - 9
  By -= Lift
  K = SpRd0
  if Face = 0 then
    K = SpRr0
    if HopT > 0 then K = SpRh0
  end if
  if Face = 1 then
    K = SpLr0
    if HopT > 0 then K = SpLh0
  end if
  if Face = 3 then K = SpRu0
  if Face = 4 then K = SpRx0
  set sprite 0 to By,Bx,K,10
  K += 4
  ' autumn: a white outline stands off the ochre ground
  N = 1
  if Season = 2 then N = 15
  set sprite 1 to By,Bx,K,N
  K += 4
  set sprite 2 to By,Bx,K,9
  update sprites
  return
end sub

' ------------------------------------------------------------ the reveal
' every hidden trap is shown, row by row (the book's lines 800-830)
sub RevealAll:
  for Ty = 4 to 20
    Hit = 0
    for Tx = FX0 to FX1
      Cc = get char at Tx,Ty
      if Cc >= CcHid0 then
        if Cc <= CcHid3 then
          put char CcTrapk at Tx,Ty
          Hit = 1
        end if
      end if
    next
    if Hit = 1 then play sound SndClick
    Frame1
    Animate
    Frame1
    Animate
  next
  return
end sub

' ------------------------------------------------------------ animation
' the snow sparkles (every 32 frames), the carrot's leaves stir
sub Animate:
  inc AnF
  V = AnF & 31
  if V = 0 then
    SparkF = SparkF ^ 8
    J = SparkF
    K = J + 8
    copy SparkTex + J count 8 to vram.pattern + VSnow2
    copy SparkTex + J count 8 to vram.pattern + 2048 + VSnow2
    copy SparkTex + J count 8 to vram.pattern + 4096 + VSnow2
    copy SparkTex + J count 8 to vram.pattern + VHid2
    copy SparkTex + J count 8 to vram.pattern + 2048 + VHid2
    copy SparkTex + J count 8 to vram.pattern + 4096 + VHid2
    copy SparkTex + K count 8 to vram.pattern + VSnow3
    copy SparkTex + K count 8 to vram.pattern + 2048 + VSnow3
    copy SparkTex + K count 8 to vram.pattern + 4096 + VSnow3
    copy SparkTex + K count 8 to vram.pattern + VHid3
    copy SparkTex + K count 8 to vram.pattern + 2048 + VHid3
    copy SparkTex + K count 8 to vram.pattern + 4096 + VHid3
  end if
  if Phase <> 1 then Particles
  if V = 16 then
    if Phase = 1 then
      LeafF = LeafF ^ 1
      put char CcCar0 + LeafF at CarX,FY0
    end if
  end if
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  ' a panel framed by the border's trap rope, cols 7-23, rows 8-14
  for Tx = 7 to 23
    put char CcBord at Tx,8
    put char CcBord at Tx,14
  next
  for Ty = 9 to 13
    put char CcBord at 7,Ty
    put char CcBord at 23,Ty
    fill 32 count 15 at 8,Ty
  next
  put char CcBordc at 7,8
  put char CcBordc at 23,8
  put char CcBordc at 7,14
  put char CcBordc at 23,14
  print at 11,10, "GAME OVER"
  print at 10,12, "LV"
  print Level at 12,12 width 2
  print Score at 15,12 width 5
  play sound SndOver
  for Wt = 1 to 150
    Frame1
    Animate
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  LoadTiles
  return
end sub

' a strip of the field on rows 18-20 with its border (for the pages)
sub FieldStrip:
  for Ty = 18 to 20
    for Tx = 2 to 29
      SnowAt
      put char Cc at Tx,Ty
    next
  next
  fill CcBord count 28 at 2,21
  return
end sub

' the rabbit sprite at cell Ax,Ay, facing Face
sub PageRabbit:
  SpX = Ax * 8
  SpY = Ay * 8
  Lift = 0
  HopT = 0
  DrawRabbit
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  FieldStrip
  put char CcCar0 at 24,18
  put char CcFp0 at 6,20
  put char CcFp1 at 7,20
  put char CcFp0 at 7,19
  put char CcHouse00 at 26,17
  put char CcHouse01 at 27,17
  put char CcHouse10 at 26,18
  put char CcHouse11 at 27,18
  Ax = 8
  Ay = 19
  Face = 0
  ShowScreen
  PageRabbit
  WaitPage
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  FieldStrip
  put char CcCar0 at 22,18
  put char CcTrapk at 14,19
  put char CcTrapk at 19,18
  put char CcFp0 at 8,20
  put char CcFp0 at 9,20
  put char CcFp1 at 10,20
  put char CcFp2 at 10,19
  Ax = 11
  Ay = 19
  Face = 0
  ShowScreen
  PageRabbit
  WaitPage
  TextScreen
  PageHelp2
  put char CcHstick at 3,3
  put char CcHdet at 2,5
  put char CcLamp2 at 3,5
  put char CcLamp2 at 4,5
  for Tx = 0 to 4
    V = Tx << 1
    V += 17
    put char CcFp0 + Tx at V,8
  next
  put char CcTrapr at 3,10
  put char CcHrab at 4,11
  put char CcCar0 at 3,13
  put char CcHpaw at 3,15
  WaitPage
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  Season = 0
  LoadTiles
  ' the logo's tiles, top third only
  copy LgPat count LgBytes to vram.pattern + VLg
  copy LgCol count LgBytes to vram.color + VLg
  ' falling snow over the sky (rows 0-9)
  for Ty = 0 to 9
    for Tx = 0 to 31
      V = Tx * 7
      J = Ty * 13
      V += J
      V = V & 15
      if V < 3 then put char CcFl0 + V at Tx,Ty
    next
  next
  for Y = 0 to Logo1H - 1
    V = Y * Logo1W
    J = Y + 1
    put Logo1 + V count Logo1W at 8,J
  next
  for Y = 0 to Logo2H - 1
    V = Y * Logo2W
    J = Y + 4
    put Logo2 + V count Logo2W at 8,J
  next
  put char CcMoon at 27,1
  ' the village and the snowy field (rows 9-14)
  for Tx = 0 to 31
    V = Tx % 3
    put char CcHill0 + V at Tx,10
  next
  put char CcPine0 at 3,8
  put char CcPine1 at 3,9
  put char CcPine0 at 5,8
  put char CcPine1 at 5,9
  put char CcPine0 at 28,8
  put char CcPine1 at 28,9
  put char CcHouse00 at 23,8
  put char CcHouse01 at 24,8
  put char CcHouse10 at 23,9
  put char CcHouse11 at 24,9
  for Ty = 11 to 13
    for Tx = 0 to 31
      SnowAt
      put char Cc at Tx,Ty
    next
  next
  fill CcBord count 32 at 0,14
  put char CcCar0 at 26,12
  put char CcCar1 at 6,11
  put char CcTrapk at 17,11
  ' menu (rows 16-22)
  print at 11,16, "START"
  print at 11,18, "LEVEL"
  print at 11,20, "HOW TO PLAY"
  print at 11,22, "CREDITS"
  ShowLevelChoice
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Tf = 0
  ParX[0] = 40
  ParX[1] = 200
  PSlot = 5
  TitX = 8
  TitT = 0
  Face = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  Animate
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLv > 1 then dec StartLv
      end if
      if Rt1 = 1 then
        if StartLv < 5 then inc StartLv
      end if
      ShowLevelChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLevelChoice:
  print at 18,18, "< >"
  put char StartLv + 48 at 19,18
  return
end sub

' title: the snow falls (flake patterns scroll down), Master Rabbit hops
' along the field (sprites 0-2), the carrot cursor (sprites 3-4)
sub TitleAnim:
  V = Menu << 4
  V += 123
  set sprite 3 to V,68,SpCursor,8
  set sprite 4 to V,68,SpCurleaf,3
  V = AnF % 3
  if V = 0 then
    FlakeA = FlakeA - 1
    FlakeA = FlakeA & 15
    FlakeB = FlakeB - 2
    FlakeB = FlakeB & 15
    J = FlakeA
    copy FlakeTex0 + J count 8 to vram.pattern + VFl0
    copy FlakeTex0 + J count 8 to vram.pattern + 2048 + VFl0
    copy FlakeTex1 + J count 8 to vram.pattern + VFl1
    copy FlakeTex1 + J count 8 to vram.pattern + 2048 + VFl1
    J = FlakeB
    copy FlakeTex2 + J count 8 to vram.pattern + VFl2
    copy FlakeTex2 + J count 8 to vram.pattern + 2048 + VFl2
  end if
  ' a hop of 8 pixels every 20 frames, turning at the ends
  inc TitT
  if TitT >= 20 then TitT = 0
  HopT = 0
  Lift = 0
  if TitT < 8 then
    HopT = 8 - TitT
    Lift = Arc[TitT]
    if Tf = 0 then
      inc TitX
    else
      dec TitX
    end if
    if TitT = 7 then
      if TitX >= 232 then Tf = 1
      if TitX <= 16 then Tf = 0
    end if
  end if
  Face = Tf
  SpX = TitX
  SpY = 104
  DrawRabbit
  return
end sub

' the season's particles: 2 sprites (PSlot, PSlot + 1) kept 96 lines apart
' (a petal, a butterfly, a leaf, a snowflake) drifting over the screen
sub Particles:
  V = AnF & 1
  if Season = 0 then V = AnF % 3
  if V = 0 then
    if Season = 1 then
      if ParB = 0 then ParB = 192
      dec ParB
    else
      inc ParB
      if ParB >= 192 then ParB = 0
    end if
  end if
  V = AnF & 3
  if V = 0 then
    if Season = 2 then
      ParX[0] = ParX[0] + 1
      ParX[1] = ParX[1] + 1
    end if
    if Season = 1 then
      ParX[0] = ParX[0] - 1
      ParX[1] = ParX[1] + 1
    end if
  end if
  K = SpPetal
  N = 9
  if Season = 1 then
    K = SpBfly0
    V = AnF & 8
    if V <> 0 then K = SpBfly1
    N = 11
  end if
  if Season = 2 then
    K = SpLeaf
    N = 8
  end if
  if Season = 3 then
    K = SpFlake
    N = 15
  end if
  for I = 0 to 1
    Y = ParB
    if I = 1 then
      if Y >= 96 then
        Y -= 96
      else
        Y += 96
      end if
    end if
    J = I * 40
    J += AnF
    J = J >> 3
    J = J & 15
    X = ParX[I] + Wob[J]
    if Season = 1 then
      J = J + 4
      J = J & 15
      Y += Wob[J]
    end if
    J = PSlot + I
    set sprite J to Y,X,K,N
  next
  update sprites
  return
end sub

' a short card before each field: the season's name over its ground
sub SeasonCard:
  TextScreen
  Ty = 12
  for Ty = 11 to 14
    for Tx = 2 to 29
      SnowAt
      put char Cc at Tx,Ty
    next
  next
  fill CcBord count 28 at 2,15
  put char CcCar0 at 22,13
  if Season = 0 then print at 13,7, "SPRING"
  if Season = 1 then print at 13,7, "SUMMER"
  if Season = 2 then print at 13,7, "AUTUMN"
  if Season = 3 then print at 13,7, "WINTER"
  print at 12,18, "FIELD"
  print Level at 18,18 width 2
  ParX[0] = 60
  ParX[1] = 180
  PSlot = 3
  Ax = 9
  Ay = 13
  Face = 0
  ShowScreen
  PageRabbit
  Phase = 3
  for Wt = 1 to 100
    Frame1
    ReadPad
    Animate
    if Press = 1 then Wt = 100
  next
  Phase = 0
  HideSprites
  return
end sub

