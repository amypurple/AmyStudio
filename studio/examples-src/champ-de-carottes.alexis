sub PageCredits:
  print at 7,2, "CHAMP DE CAROTTES"
  print at 7,3, "(THE CARROT FIELD)"
  print at 8,5, "ORIGINAL GAME BY"
  print at 6,6, "JEAN-FRANCOIS SEHAN"
  print at 7,8, "L'ORIC A L'AFFICHE"
  print at 3,9, "(EDITIONS DU P.S.I., 1984)"
  print at 6,12, "COLECOVISION VERSION"
  print at 7,14, "AMY & CLAUDE 2026"
  print at 2,16, "MADE IN AMY WITH AMY STUDIO"
