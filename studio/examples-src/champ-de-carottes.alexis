end sub

sub PageHelp1:
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "SEASON AFTER SEASON, MASTER"
  print at 2,4, "RABBIT SEES ONE LAST CARROT"
  print at 2,5, "AT THE FAR END OF THE FIELD."
  print at 2,7, "THE VILLAGERS HID TRAPS"
  print at 2,8, "IN THE GROUND, AND THE"
  print at 2,9, "FIELD IS RINGED WITH TRAPS."
  print at 2,11, "HIS FAITHFUL DETECTOR COUNTS"
  print at 2,12, "THE TRAPS JUST NEXT TO HIM:"
  print at 2,13, "LEFT, RIGHT, UP AND DOWN"
  print at 2,14, "(THE BORDER COUNTS TOO)."
  print at 2,16, "THINK, HOP TO THE CARROT!"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp2:
  print at 8,1, "HOW TO PLAY  2/2"
  print at 6,3, "JOYSTICK: HOP"
  print at 6,5, "TRAPS NEXT TO YOU"
  print at 6,7, "EVERY STEP REMEMBERS"
  print at 6,8, "ITS COUNT:"
  print at 6,10, "A TRAP CATCHES YOU:"
  print at 6,11, "ONE RABBIT LOST"
  print at 6,13, "THE CARROT: NEXT FIELD"
  print at 6,15, "FEWER HOPS = MORE POINTS"
  print at 2,17, "THE RABBIT STOPS WHEN THE"
  print at 2,18, "DETECTOR BEEPS: LET GO OF"
  print at 2,19, "THE STICK, THEN HOP AGAIN."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

asm {
; generated by kit/os7music.py from title.txt, game.txt - do not edit by hand
; use: set sound table CcSoundTable areas 7
; songs share the music areas: stop one song before starting another
; merged 2 scores: table 2893 bytes (21 entries, 7 areas)
;   Snow On The Furrows: loop 1024 frames
;   Tiptoe In The Snow: loop 576 frames
;   SndMtLead        MtLead           $702B music    409 bytes   1024 frames
;   SndMtTwo         MtTwo            $7035 music    769 bytes   1024 frames
;   SndMtNoise       MtNoise          $703F music    527 bytes   1024 frames
;   SndMtPitch       MtPitch          $7049 music     61 bytes   1024 frames
;   SndMgLead        MgLead           $702B music    206 bytes    576 frames
;   SndMgTwo         MgTwo            $7035 music    385 bytes    576 frames
;   SndMgNoise       MgNoise          $703F music    196 bytes    576 frames
;   SndMgPitch       MgPitch          $7049 music     33 bytes    576 frames
;   SndHop           SfxHop           $705D effect     7 bytes      4 frames
;   SndDet1          SfxDet1          $7067 effect     7 bytes      4 frames
;   SndDet2          SfxDet2          $7067 effect    12 bytes     10 frames
;   SndDet3          SfxDet3          $7067 effect    17 bytes     16 frames
;   SndDet4          SfxDet4          $7067 effect    22 bytes     19 frames
;   SndThud          SfxThud          $705D effect     7 bytes      5 frames
;   SndSnap          SfxSnap          $7053 effect    11 bytes     14 frames
;   SndOuch          SfxOuch          $705D effect    15 bytes     29 frames
;   SndCrunch        SfxCrunch        $7053 effect    16 bytes     19 frames
;   SndClear         SfxClear         $705D effect    38 bytes    144 frames
;   SndClick         SfxClick         $7067 effect     5 bytes      2 frames
;   SndStart         SfxStart         $705D effect    25 bytes     60 frames
;   SndOver          SfxOver          $705D effect    39 bytes    160 frames
CcSoundTable:
    dw MtLead,$702B
    dw MtTwo,$7035
    dw MtNoise,$703F
    dw MtPitch,$7049
    dw MgLead,$702B
    dw MgTwo,$7035
    dw MgNoise,$703F
    dw MgPitch,$7049
    dw SfxHop,$705D
    dw SfxDet1,$7067
    dw SfxDet2,$7067
    dw SfxDet3,$7067
    dw SfxDet4,$7067
    dw SfxThud,$705D
    dw SfxSnap,$7053
    dw SfxOuch,$705D
    dw SfxCrunch,$7053
    dw SfxClear,$705D
    dw SfxClick,$7067
    dw SfxStart,$705D
    dw SfxOver,$705D
    dw 0
MtLead:
    db $42,$FE,$30,$10,$14,$32,$42,$D6,$30,$10,$14,$32,$42,$AA,$30,$10
    db $14,$32,$42,$7F,$30,$10,$14,$32,$42,$8F,$30,$18,$14,$32,$42,$AA
    db $30,$08,$14,$22,$42,$BE,$30,$10,$14,$32,$42,$D6,$30,$10,$14,$32
    db $42,$BE,$30,$10,$14,$32,$42,$AA,$30,$10,$14,$32,$42,$A0,$30,$10
