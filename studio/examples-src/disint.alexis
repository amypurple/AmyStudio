  $99,$9A,$9D,$9E,$A1,$A2,$9D,$9E,$A5,$A6,$A9,$AA,$AD,$AE,$B1,$B2,$B5,$B6,$B9,$BA,$A9,$AA,$BD,$BE,$B5,$B6
