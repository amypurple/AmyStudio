record Shot:
  u8 Live
  u8 Col
  u8 Y
end record

Shot Ms
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Spd = 0
u16 EYf = 0
bcd digits 5 Score = 0
bcd digits 5 Hi = 0
u8 EY = 0
u8 Col = 0
u8 PrevCol = 0
u8 Phase = 0
u8 PT = 0
u8 Lv = 0
u8 Lives = 0
u8 Hits = 0
u8 Sel = 0
u8 CurX = 0
u8 RepT = 0
u8 WasDir = 0
u8 Over = 0
u8 Landed = 0
u8 Shots = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
' loop counters (never shared with the helpers)
u8 Si = 0
u8 Li = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DiSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  print at 7,9, "                  "
  if Over = 2 then
    print at 7,10, " ALL SILOS SAVED! "
    play sound SndWin
  else
    print at 7,10, "    GAME  OVER    "
    play sound SndOver
  end if
  print at 7,11, "                  "
  print at 7,12, "   SCORE ", Score, "   "
  print at 7,13, "   BEST  ", Hi, "   "
  print at 7,14, "                  "
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  if Phase <> 3 then MoveSel
  if Press = 1 then
    if Phase = 0 then
      if Ms.Live = 0 then Launch
    end if
  end if
  if Ms.Live = 1 then MoveMissile
  select case Phase
    case 0
      Fall
    case 1
      dec PT
      if PT = 0 then
        if Hits >= PerLevel then
          LevelDone
        else
          Spawn
        end if
      end if
    case 2
      dec PT
      if PT = 44 then backdrop black
      if PT = 0 then
        if Lives = 0 then
          Over = 1
        else
          Spawn
        end if
      end if
    case 3
      dec PT
      if PT = 0 then
        copy GameMap + 320 count 32 to vram.name + 320
        if Lv >= LastLevel then
          Over = 2
        else
          NextLevel
          Spawn
        end if
      end if
  end select
  return
end sub

' the stick steps the chosen silo; held, it repeats every 3 frames after 7; the
' marker slides 8 pixels a frame to it
sub MoveSel:
  K = J1 & 12
  if K = 0 then
    WasDir = 0
  else
    if WasDir = 0 then
      StepSel(K)
      RepT = 7
      WasDir = 1
    else
      dec RepT
      if RepT = 0 then
        StepSel(K)
        RepT = 3
      end if
    end if
  end if
  X = SiloX(Sel)
  if CurX < X then
    CurX = CurX + CurSpd
    if CurX > X then CurX = X
  end if
  if CurX > X then
    CurX = CurX - CurSpd
    if CurX < X then CurX = X
  end if
  return
end sub

sub StepSel(u8 Dir)
  if Dir = 4 then
    if Sel > 0 then dec Sel
  end if
  if Dir = 8 then
    if Sel < NSilo - 1 then inc Sel
  end if
  return
end sub

function SiloX(u8 N) as u8
  return N * 24 + 40

' a missile leaves the chosen silo (its hatch opens)
sub Launch:
  Ms.Live = 1
  Ms.Col = Sel
  Ms.Y = MisTop
  inc Shots
  SiloTiles(Sel, TSiloe00)
  play sound SndLaunch
  return
end sub

sub MoveMissile:
  if Ms.Y < 12 then
    EndMissile
  else
    Ms.Y = Ms.Y - MisSpd
  end if
  return
end sub

sub EndMissile:
  Ms.Live = 0
  SiloTiles(Ms.Col, TSilo00)
  return
end sub

' the pod falls; a missile in its column that reaches it destroys it; at
' the silo row it touches down
sub Fall:
  EYf = EYf + Spd
  EY = EYf >> 8
  if Ms.Live = 1 then
    if Ms.Col = Col then
      V = EY + 13
      if Ms.Y <= V then
        Hit
        return
      end if
    end if
  end if
  if EY >= PodLand then
    EY = PodLand
    Phase = 2
    PT = 60
    dec Lives
    inc Landed
    if Ms.Live = 1 then EndMissile
    play sound SndRumble
    backdrop dark red
    ShowLives
  end if
  return
end sub

sub Hit:
  EndMissile
  Phase = 1
  PT = 24
  Score += 10
  if Score > Hi then Hi = Score
  inc Hits
  play sound SndBlast
  ShowScore
  ShowPips
  return
end sub

sub LevelDone:
  Phase = 3
  PT = 150
  print at 8,10, "LEVEL COMPLETE"
  play sound SndLevel
  return
end sub

sub NextLevel:
  inc Lv
  Spd = SpdT[Lv - 1]
  Hits = 0
  ShowLevel
  ShowPips
  return
end sub

' a new pod above a random silo, never the last one's
sub Spawn:
  Col = PickCol(PrevCol)
  PrevCol = Col
  EYf = PodTop * 256
  EY = PodTop
  Phase = 0
  play sound SndWarn
  return
end sub

function PickCol(u8 Last) as u8
  Rand
  W16 = Rs >> 4
  W16 = W16 % 7
  K = W16
  K = Last + 1 + K
  return K & 7

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' silo N's four tiles from the given first code (full or empty)
sub SiloTiles(u8 N, u8 T0)
  u8 Cx = 0
  Cx = N * 3 + 4
  put char T0 at Cx,17
  put char T0 + 1 at Cx + 1,17
  put char T0 + 2 at Cx,18
  put char T0 + 3 at Cx + 1,18
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 the marker, 1-2 the missile and its flame, 3-4 the pod
' (eyes, shell), 5 a blast
sub DrawSprites:
  set sprite 0 to 151,CurX - 8,SMark,11
  if Ms.Live = 1 then
    X = SiloX(Ms.Col) - 8
    Y = Ms.Y - 1
    set sprite 1 to Y,X,SMis,15
    set sprite 2 to Y,X,SFlame,10
  else
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end if
  inc Anim
  if Anim >= 24 then Anim = 0
  X = SiloX(Col) - 8
  Y = EY - 1
  if Phase = 0 then
    K = SPod0y
    if Anim >= 12 then K = SPod1y
    set sprite 3 to Y,X,K,11
    set sprite 4 to Y,X,K + 4,13
    set sprite 5 to 192,0,0,0
  else
    set sprite 3 to 192,0,0,0
    set sprite 4 to 192,0,0,0
    if PT >= 36 then
      Blast(X, Y)
    else
      if Phase = 1 then
        Blast(X, Y)
      else
        set sprite 5 to 192,0,0,0
      end if
    end if
  end if
  if Phase = 3 then set sprite 5 to 192,0,0,0
  update sprites
  return
end sub

sub Blast(u8 Bx, u8 By)
  u8 Pat = 0
  u8 Cl = 0
  Pat = SEx0
  Cl = 11
  if PT < 12 then
    Pat = SEx1
    Cl = 9
  end if
  if Phase = 2 then
    if PT < 48 then
      Pat = SEx1
      Cl = 9
    end if
  end if
  set sprite 5 to By,Bx,Pat,Cl
  return
end sub

sub ShowScore:
  print at 17,1, Score
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 8,1, digits$(NumU, 1)
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 29,1, digits$(NumU, 1)
  return
end sub

' the 15 markers: pods still to come, then crossed-out ones
sub ShowPips:
  for Li = 0 to PerLevel - 1
    X = Li + 8
    if Li < Hits then
      put char TPipx at X,22
    else
      put char TPip at X,22
    end if
  next
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 2,1, "LEVEL"
  print at 11,1, "SCORE"
  print at 23,1, "LIVES"
  Score = 0
  Lv = 0
  Lives = 3
  Ms.Live = 0
  Ms.Col = 0
  Ms.Y = 0
  Sel = 3
  CurX = SiloX(Sel)
  WasDir = 0
  RepT = 0
  Over = 0
  Landed = 0
  Shots = 0
  Anim = 0
  PrevCol = Rs & 7
  NextLevel
  ShowScore
  ShowLives
  Spawn
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the silos and the night sky, DISINTEGRATOR appearing letter
' by letter (as on the C64), START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  copy GameMap + 512 count 256 to vram.name + 512
  print at 7,2, "AHOY! AUGUST 1985"
  print at 6,8, "BY BARBARA SCHULAK"
  print at 13,11, "START"
  print at 13,12, "CREDITS"
  if Hi > 0 then
    print at 10,14, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  ' the letters, one every 8 frames
  for Li = 0 to 12
    for Si = 0 to 7
      Frame1
    next
    X = Li * 2 + 3
    K = Li * 2
    put char TitleW0[K] at X,4
    put char TitleW0[K + 1] at X + 1,4
    put char TitleW1[K] at X,5
    put char TitleW1[K + 1] at X + 1,5
    play sound SndLetter
  next
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Anim = 0
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' a pod drifts slowly down over the silos and starts again
sub TitleAnim:
  V = Tick & 3
  if V = 0 then
    inc Anim
    if Anim > 50 then Anim = 0
  end if
  Y = Anim + 75
  K = SPod0y
  V = Tick & 16
  if V > 0 then K = SPod1y
  set sprite 3 to Y,208,K,11
  set sprite 4 to Y,208,K + 4,13
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,11
  put char 32 at 11,12
  J = Menu + 11
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "DISINTEGRATOR"
  print at 2,5, "BASED ON DISINTEGRATOR BY"
  print at 2,6, "BARBARA SCHULAK, AHOY!"
  print at 2,7, "AUGUST 1985 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SILO WATCH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

