cartridge "AARDVARK ATTACK/TODD HEIMARCK/1983"

' AARDVARK ATTACK
' A ColecoVision game based on "Aardvark Attack" by Todd Heimarck,
' COMPUTE!'s Gazette, October 1983 (VIC-20, BASIC with a small machine
' language routine; the Commodore 64 version followed in November 1983).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from both
' listings, orig/), the game is built for the ColecoVision: smooth 16 x 16
' sprites, tiled cities, a radar, sound effects and an original title tune.
'
' The game: Andromedan aardvarks attack ten cities with 26 kinds of bombs.
' Their mothership glides over the cities and drops a bomb. Your radar
' shows the bomb's kind: a letter, drawn large in quarter blocks. First
' name the bomb (pick its letter A-Z), then save the city (fire the gun
' under the bomb's column). The sooner both are done, the more it scores.
' A bomb that lands knocks one block off its city if it was named, two if
' not. A bomb that falls on a city already flattened ends the game.
'
' From the original (orig/aard-vic.bas, orig/aard-64.bas): ten cities
' (columns 1-9 and 0), four blocks high; 26 bombs shown as a 4 x 4 quarter
' block picture of the letter; a bomb falls 18 rows in the bomb's column,
' leaving a trail; the letter must be named before the city; the score of
' a saved city, INT((500 - 5 * FH - 2 * SH) / SQR(HF)), FH and SH the rows
' (1-18) where the letter and the city were found, HF = 2.5 ^ (9 - level)
' the level's delay; a landed bomb removes the top block of its city, and
' the one under it too when the letter was not named (but never the last
' one, C64 line 540); a bomb on an empty city loses the game; nine levels.
' The levels are numbered as on the C64 (1 novice, 9 expert; the VIC-20
' listing numbers them the other way round).
'
' Liberties: keyboard letters and digits become a joystick letter picker
' and a gun moved under the cities. In the original a wrong key was
' ignored, so typing every key in turn could not lose; here a wrong letter
' or a shot at the wrong city drops the bomb one row at once (25 wrong
' guesses are more than the 18 rows). The VIC's "flashing" of random
' columns before a drop is a mothership that glides to a random column
' and then to the bomb's column. The fall time is set per level (12.8 s
' at level 1 to 3.4 s at level 9) instead of a BASIC delay loop, and it
' grows a little shorter every 10 bombs saved (at most 12 steps), so a game
' cannot last for ever. The VIC listing's POKE 7680,L (line 90) wrote the
' answer's letter in the top-left corner of the screen; it is not in the
' C64 version and is left out (see README.md). The screen flash of a lost
' game is a message. A high score is kept.
'
' Controls: either controller. Before the bomb is named the stick moves the
' box over the letters and a button names the bomb; then left and right
' move the gun and a button fires. On the title, up and down choose,
' left and right set the level, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TQ0 = 128
const TQ1 = 129
const TQ2 = 130
const TQ3 = 131
const TQ4 = 132
const TQ5 = 133
const TQ6 = 134
const TQ7 = 135
const TQ8 = 136
const TQ9 = 137
const TQ10 = 138
const TQ11 = 139
const TQ12 = 140
const TQ13 = 141
const TQ14 = 142
const TQ15 = 143
const TRfh = 144
const TRfb = 145
const TRfl = 146
const TRfr = 147
const TRtl = 148
const TRtr = 149
const TRbl = 150
const TRbr = 151
const TStar = 152
const TTrl = 153
const TTrr = 154
const TWall = 155
const TRoofl = 156
const TRoofr = 157
const TBldl = 158
const TBldr = 159
const TRubl = 160
const TRubr = 161
const TGround = 162
const SBomb = 0
const SBombhi = 4
const SShip = 8
const SShipe = 12
const SBoom0 = 16
const SBoom1 = 20
const SGun = 24
const SBeam = 28
const SBox = 32
const NTiles8 = 280
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndBlip = 3
const SndDrop = 4
const SndRight = 5
const SndWrong = 6
const SndZap = 7
const SndBoom = 8
const SndCrash = 9
const SndStart = 10
const SndOver = 11
const NSpr = 16
const PosMax = 3072
const RowLen = 171
const BlastN = 36
const CrashN = 50
const BeamN = 8

' fall speed (1/32 pixel a frame) and the score divisor x 100 (SQR(HF)),
' by level 1-9 (index 0 unused)
data SpdT bytes
  4, 4, 5, 6, 7, 8, 9, 11, 13, 15
end data
data DivT words
  100, 3906, 2470, 1563, 988, 625, 395, 250, 158, 100
end data
' the digit under each city (cities 1-9 then 0, as on the keyboard)
data DigT bytes
  49, 50, 51, 52, 53, 54, 55, 56, 57, 48
end data

record Bomb
  u8 Col
  u8 Let
  u16 Pos
  u8 Named
  u8 Fh
  u8 Sh
end record

Bomb Bm
u8 Hgt[10]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u16 Pts = 0
u8 Lv = 5
u8 Saved = 0
u8 Boost = 0
u8 Over = 0
u8 InPlay = 0
' phase: 0 the ship goes to the column, 1 the bomb falls, 2 blast,
' 3 crash on a city
u8 Ph = 0
u8 PhT = 0
u8 Sx = 96
u8 Tx = 96
u8 Leg = 0
u8 Lc = 14
u8 Gc = 4
u8 BeamT = 0
u8 BeamC = 0
u8 BeamY = 0
u8 BlastY = 0
u8 LastRow = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Dir = 0
u8 OldDir = 0
u8 Rep = 0
u8 Move = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Ri = 0
u8 Si = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  InPlay = 0
  if Sc > Hi then Hi = Sc
  mute all
  print at 2,9, "                    "
  print at 2,10, " THE AARDVARKS WIN! "
  print at 2,11, "                    "
  print at 2,12, " SCORE              "
  print Sc at 10,12
  print at 2,13, "                    "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if BeamT > 0 then dec BeamT
  select case Ph
  case 0
    ShipStep
    Stick
  case 1
    FallStep
  case 2
    dec PhT
    if PhT = 0 then NextBomb
  case else
    dec PhT
    if PhT = 0 then
      if Over = 0 then NextBomb
    end if
  end select
  return
end sub

' the mothership: to a random column first, then to the bomb's column
sub ShipStep:
  if Sx < Tx then
    Sx = Sx + 2
  elseif Sx > Tx then
    Sx = Sx - 2
  else
    if Leg = 0 then
      Leg = 1
      Tx = ColX(Bm.Col)
    else
      Drop
    end if
    return
  end if
  V = Sx & 15
  if V = 0 then play sound SndBlip
  return
end sub

' the bomb leaves the ship: the radar shows it
sub Drop:
  Ph = 1
  Bm.Pos = 0
  LastRow = 255
  DrawRadar(Bm.Let)
  ShowPrompt
  play sound SndDrop
  return
end sub

sub FallStep:
  Stick
  if Ph <> 1 then return
  V = SpdT[Lv] + Boost
  Bm.Pos = Bm.Pos + V
  Trail
  if Bm.Pos >= PosMax then Land
  return
end sub

' the trail behind the bomb, a dot a tile row
sub Trail:
  Y = BombY()
  R = Y >> 3
  if R = LastRow then return
  LastRow = R
  if R < 3 then return
  C = Bm.Col << 1
  C = C + 2
  put char TTrl at C,R
  inc C
  put char TTrr at C,R
  return
end sub

' the stick and the button: the letter box, or the gun once named
sub Stick:
  Move = 0
  Dir = J1 | J2
  Dir = Dir & 15
  if Dir <> 0 then
    if Dir <> OldDir then
      Move = Dir
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Move = Dir
        Rep = 6
      end if
    end if
  end if
  OldDir = Dir
  if Bm.Named = 0 then
    PickLetter
  else
    PickCity
  end if
  return
end sub

sub PickLetter:
  K = Lc
  if Move & 1 then
    if K >= 6 then K = K - 6
  elseif Move & 2 then
    K = K + 6
    if K > 25 then
      if Lc < 24 then
        K = 25
      else
        K = Lc
      end if
    end if
  elseif Move & 4 then
    V = K % 6
    if V > 0 then dec K
  elseif Move & 8 then
    V = K % 6
    if V < 5 then
      if K < 25 then inc K
    end if
  end if
  Lc = K
  if Press = 0 then return
  if Ph <> 1 then return
  if Lc = Bm.Let then
    Bm.Named = 1
    Bm.Fh = RowNow()
    ShowPrompt
    play sound SndRight
  else
    Penalty
  end if
  return
end sub

sub PickCity:
  if Move & 4 then
    if Gc > 0 then dec Gc
  end if
  if Move & 8 then
    if Gc < 9 then inc Gc
  end if
  if Press = 0 then return
  BeamT = BeamN
  BeamC = Gc
  if Gc = Bm.Col then
    BeamY = BombY() + 16
    Bm.Sh = RowNow()
    Pts = Points(Bm.Fh, Bm.Sh)
    AddScore
    ShowScore
    inc Saved
    V = Saved / 10
    if V > 12 then V = 12
    Boost = V
    BlastY = BombY()
    Ph = 2
    PhT = BlastN
    play sound SndBoom
  else
    BeamY = 16
    Penalty
  end if
  play sound SndZap
  return
end sub

' a wrong guess: the bomb drops a row at once
sub Penalty:
  Bm.Pos = Bm.Pos + RowLen
  play sound SndWrong
  return
end sub

' the bomb hits its city
sub Land:
  C = Bm.Col
  N = Hgt[C]
  BlastY = 120
  Ph = 3
  PhT = CrashN
  play sound SndCrash
  if N = 0 then
    Over = 1
    return
  end if
  dec N
  if Bm.Named = 0 then
    if N > 0 then dec N
  end if
  Hgt[C] = N
  DrawCity(C)
  return
end sub

' the points of a saved city: INT((500 - 5 * FH - 2 * SH) / SQR(HF))
function Points(u8 Fh, u8 Sh) as u16
  u16 P
  u16 D
  P = 500 - Fh * 5
  P = P - Sh * 2
  P = P * 100
  D = DivT[Lv]
  return P / D

' the bomb's row of 18 (1 at the top)
function RowNow as u8
  u8 Rw
  Rw = Bm.Pos / RowLen
  Rw = Rw + 1
  if Rw > 18 then Rw = 18
  return Rw

function BombY as u8
  return Bm.Pos / 32 + 24

function ColX(u8 Cc) as u8
  return Cc * 16 + 16

' BCD score += a u16, in steps a u8 can hold
sub AddScore:
  while Pts >= 200
    Sc += 200
    Pts = Pts - 200
  end while
  V = Pts
  Sc += V
  return
end sub

sub NextBomb:
  ClearTrail
  Rand
  V = Rs % 10
  Bm.Col = V
  Rand
  V = Rs % 26
  Bm.Let = V
  Bm.Pos = 0
  Bm.Named = 0
  Bm.Fh = 0
  Bm.Sh = 0
  Rand
  V = Rs % 10
  Tx = ColX(V)
  Leg = 0
  Ph = 0
  DrawRadar(26)
  ShowPrompt
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites: 0 letter box, 1 gun, 2-3 bomb and its light, 4-5 the ship,
' 6 the blast, 7-15 the beam
sub DrawSprites:
  if InPlay = 0 then return
  ' the letter box over letter Lc
  V = Lc % 6
  X = V + 23
  X = X << 3
  X = X - 3
  V = Lc / 6
  Y = V << 4
  Y = Y + 66
  if Bm.Named = 0 then
    set sprite 0 to Y,X,SBox,3
  else
    set sprite 0 to Y,X,SBox,12
  end if
  X = ColX(Gc)
  set sprite 1 to 159,X,SGun,7
  X = ColX(Bm.Col)
  if Ph = 1 then
    Y = BombY() - 1
    if Bm.Named = 1 then
      set sprite 2 to Y,X,SBombhi,15
      set sprite 3 to Y,X,SBomb,11
    else
      set sprite 2 to 192,0,0,0
      set sprite 3 to Y,X,SBomb,6
    end if
  else
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  end if
  set sprite 4 to 7,Sx,SShipe,15
  set sprite 5 to 7,Sx,SShip,13
  if Ph >= 2 then
    Y = BlastY - 1
    if PhT > 18 then
      set sprite 6 to Y,X,SBoom0,10
    else
      set sprite 6 to Y,X,SBoom1,9
    end if
  else
    set sprite 6 to 192,0,0,0
  end if
  ' the beam from the gun up to the bomb (or the top)
  X = ColX(BeamC)
  Y = 152
  for Si = 7 to 15
    if BeamT > 0 then
      if Y >= BeamY then
        V = Y - 1
        set sprite Si to V,X,SBeam,11
      else
        set sprite Si to 192,0,0,0
      end if
      if Y >= 16 then Y = Y - 16
    else
      set sprite Si to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' the radar: a bomb's letter in quarter blocks, or empty (26)
sub DrawRadar(u8 Lt):
  u16 Base
  u8 Q
  u8 I
  u8 Jj
  Base = Lt * 16
  for I = 0 to 3
    for Jj = 0 to 3
      if Lt < 26 then
        Q = RadarT[Base]
      else
        Q = TQ0
      end if
      put char Q at Jj + 24, I + 3
      Base = Base + 1
    next
  next
  return
end sub

sub ShowPrompt:
  if Ph <> 1 then
    print at 23,19, "      "
    print at 23,20, "RADAR "
  elseif Bm.Named = 0 then
    print at 23,19, "NAME  "
    print at 23,20, "BOMB! "
  else
    print at 23,19, "SAVE  "
    print at 23,20, "CITY! "
  end if
  return
end sub

' the sky in the bomb's column, without its trail
sub ClearTrail:
  C = Bm.Col << 1
  C = C + 2
  for Ri = 3 to 16
    T = SkyAt(C, Ri)
    put char T at C,Ri
    K = C + 1
    T = SkyAt(K, Ri)
    put char T at K,Ri
  next
  return
end sub

' a few fixed stars
function SkyAt(u8 Cx, u8 Ry) as u8
  u8 H
  H = Cx * 7 + Ry * 13
  H = H & 31
  if H = 5 then
    H = TStar
  else
    H = 32
  end if
  return H

' city Cn: Hgt blocks under a roof, rubble when flattened
sub DrawCity(u8 Cn):
  u8 Cx
  u8 Hh
  u8 Top
  u8 Rr
  Cx = Cn * 2 + 2
  Hh = Hgt[Cn]
  Top = 21 - Hh
  for Rr = 17 to 20
    if Rr < Top then
      put char 32 at Cx,Rr
      put char 32 at Cx + 1,Rr
    elseif Rr = Top then
      put char TRoofl at Cx,Rr
      put char TRoofr at Cx + 1,Rr
    else
      put char TBldl at Cx,Rr
      put char TBldr at Cx + 1,Rr
    end if
  next
  if Hh = 0 then
    put char TRubl at Cx,20
    put char TRubr at Cx + 1,20
  end if
  return
end sub

sub DrawField:
  for Ri = 2 to 20
    for Ci = 2 to 21
      T = SkyAt(Ci, Ri)
      put char T at Ci,Ri
    next
    put char TWall at 22,Ri
  next
  fill TGround count 20 at 2,21
  put char TWall at 22,21
  for Ci = 0 to 9
    DrawCity(Ci)
    X = Ci * 2 + 3
    V = DigT[Ci]
    put char V at X,22
  next
  ' the radar frame
  put char TRtl at 23,2
  fill TRfh count 4 at 24,2
  put char TRtr at 28,2
  for Ri = 3 to 6
    put char TRfl at 23,Ri
    put char TRfr at 28,Ri
  next
  put char TRbl at 23,7
  fill TRfb count 4 at 24,7
  put char TRbr at 28,7
  ' the letters, six a row
  for Ci = 0 to 25
    V = Ci % 6
    X = V + 23
    V = Ci / 6
    Y = V * 2 + 9
    V = Ci + 65
    put char V at X,Y
  next
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 15,1, "LEVEL"
  NumU = Lv
  print at 21,1, digits$(NumU, 1)
  return
end sub

sub ShowScore:
  print Sc at 8,1
  return
end sub

sub NewGame:
  Sc = 0
  Saved = 0
  Boost = 0
  Over = 0
  for Ci = 0 to 9
    Hgt[Ci] = 4
  next
  Gc = 4
  Lc = 14
  BeamT = 0
  Sx = 96
  NewScreen
  DrawField
  ShowHud
  Bm.Col = 4
  NextBomb
  InPlay = 1
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 15
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the story, START / LEVEL / CREDITS, the tune once
sub TitlePage:
  InPlay = 0
  Menu = 0
  NewScreen
  for Ci = 0 to 9
    Hgt[Ci] = 4
    DrawCity(Ci)
  next
  fill TGround count 20 at 2,21
  for Ci = 22 to 29
    for Ri = 17 to 21
      put char 32 at Ci,Ri
    next
  next
  print at 8,2, "AARDVARK  ATTACK"
  print at 7,3, "BY TODD HEIMARCK"
  print at 3,5, "ANDROMEDAN AARDVARKS ARE"
  print at 3,6, "BOMBING TEN CITIES. YOUR"
  print at 3,7, "RADAR SHOWS EACH BOMB'S"
  print at 3,8, "LETTER: FIRST NAME THE"
  print at 3,9, "BOMB, THEN SAVE THE CITY."
  print at 10,11, "START GAME"
  print at 10,12, "LEVEL"
  print at 10,13, "CREDITS"
  print at 3,15, "(1 NOVICE, 9 EXPERT)"
  print at 3,22, "HI"
  print Hi at 6,22
  print at 15,22, "GAZETTE 1983"
  ShowLevel
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  Dir = J1 | J2
  Dir = Dir & 15
  if Dir <> OldDir then
    select case Dir
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 2 then inc Menu
    case 4
      if Lv > 1 then dec Lv
      Menu = 1
    case 8
      if Lv < 9 then inc Lv
      Menu = 1
    end select
    ShowLevel
    ShowMenu
  end if
  OldDir = Dir
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 16,12, "< ", digits$(NumU, 1), " >"
  return
end sub

sub ShowMenu:
  for Ri = 11 to 13
    put char 32 at 8,Ri
  next
  J = Menu + 11
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "AARDVARK  ATTACK"
  print at 2,5, "BASED ON AARDVARK ATTACK"
  print at 2,6, "BY TODD HEIMARCK, COMPUTE!'S"
  print at 2,7, "GAZETTE, OCTOBER 1983"
  print at 2,8, "(VIC-20; COMMODORE 64"
  print at 2,9, "VERSION NOVEMBER 1983)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: RADAR WATCH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
