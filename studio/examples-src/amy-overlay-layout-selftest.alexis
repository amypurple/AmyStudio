project "AMY OVERLAY LAYOUT SELFTEST"
memory "colecovision_legacy_sdcc"

' Phase-A RAM overlay test. Menu and Game are mutually exclusive layouts.
record MenuMemory:
  u8 Selection
  u8 Blink
end record

record ProbeActor:
  u8 X
  u16 Score
  i8 DX
  u8 Flags[3]
end record

record GameMemory:
  u8 PlayerX
  u8 PlayerY
  u8 EnemyX[8]
  u16 Scores[3]
  ProbeActor Actors[3]
  u8 AfterActors
  u8 LoopCounter
  u8 LoopSum
  u8 Buffer[4]
  bcd digits 3 Score
  bcd digits 3 Best
end record

overlay SceneRam
  Menu as MenuMemory
  Game as GameMemory
end overlay

u8 Passed = 0
u8 ActorIndex = 1
u8 FlagIndex = 1

text screen
backdrop dark blue
print centered at 8, "RAM OVERLAY SELFTEST"

' These two qualified names deliberately alias the same physical byte.
SceneRam.Menu.Selection = 17
with SceneRam.Game as Game
  if Game.PlayerX = 17 then Passed += 1
  Game.EnemyX[3] = 42
  if Game.EnemyX[3] = 42 then Passed += 1
  Game.Scores[2] = 1234
  if Game.Scores[2] = 1234 then Passed += 1
  Game.Actors[0].Score = 1000
  if Game.Actors[0].Score = 1000 then Passed += 1
  Game.Actors[ActorIndex].X = 29
  if Game.Actors[ActorIndex].X = 29 then Passed += 1
  Game.Actors[2].DX = -3
  if Game.Actors[2].DX = -3 then Passed += 1
  Game.AfterActors = 99
  if Game.AfterActors = 99 then Passed += 1
end with

' Two dynamic indexes contribute independent record-stride and field-element offsets.
SceneRam.Game.Actors[ActorIndex].Flags[0] = 11
SceneRam.Game.Actors[ActorIndex].Flags[FlagIndex] = 77
if SceneRam.Game.Actors[ActorIndex].Flags[FlagIndex] = 77 then Passed += 1
if SceneRam.Game.Actors[ActorIndex].Flags[0] = 11 then Passed += 1
SceneRam.Game.Actors[ActorIndex + 1].Flags[FlagIndex + 1] = 88
if SceneRam.Game.Actors[2].Flags[2] = 88 then Passed += 1

' Verb-style mutations use the same qualified lvalue resolver as assignments.
SceneRam.Game.Actors[ActorIndex].X = 10
inc SceneRam.Game.Actors[ActorIndex].X
if SceneRam.Game.Actors[ActorIndex].X = 11 then Passed += 1
add SceneRam.Game.Actors[ActorIndex].X by 5
if SceneRam.Game.Actors[ActorIndex].X = 16 then Passed += 1
subtract 2 from SceneRam.Game.Actors[ActorIndex].X
if SceneRam.Game.Actors[ActorIndex].X = 14 then Passed += 1
xor SceneRam.Game.Actors[ActorIndex].X with 1
if SceneRam.Game.Actors[ActorIndex].X = 15 then Passed += 1
and SceneRam.Game.Actors[ActorIndex].X with 7
if SceneRam.Game.Actors[ActorIndex].X = 7 then Passed += 1
negate SceneRam.Game.Actors[2].DX
if SceneRam.Game.Actors[2].DX = 3 then Passed += 1
not SceneRam.Game.Actors[ActorIndex].X
if SceneRam.Game.Actors[ActorIndex].X = 248 then Passed += 1
toggle SceneRam.Game.Actors[ActorIndex].X
if SceneRam.Game.Actors[ActorIndex].X = 0 then Passed += 1

' A qualified field can own the loop counter; no separate permanent byte is needed.
SceneRam.Game.LoopSum = 0
for SceneRam.Game.LoopCounter = 1 to 3
  SceneRam.Game.LoopSum += SceneRam.Game.LoopCounter
next SceneRam.Game.LoopCounter
if SceneRam.Game.LoopSum = 6 then Passed += 1
if SceneRam.Game.LoopCounter = 4 then Passed += 1

SceneRam.Game.LoopSum = 0
for SceneRam.Game.LoopCounter = 3 downto 1
  SceneRam.Game.LoopSum += SceneRam.Game.LoopCounter
next SceneRam.Game.LoopCounter
if SceneRam.Game.LoopSum = 6 then Passed += 1
if SceneRam.Game.LoopCounter = 0 then Passed += 1

' for each lowers to a counted qualified loop without allocating an alias pointer.
SceneRam.Game.Actors[0].X = 2
SceneRam.Game.Actors[1].X = 4
SceneRam.Game.Actors[2].X = 6
SceneRam.Game.LoopSum = 0
for each Actor, ActorIndex in SceneRam.Game.Actors
  Actor.X += ActorIndex
  SceneRam.Game.LoopSum += Actor.X
next Actor
if SceneRam.Game.LoopSum = 15 then Passed += 1
if ActorIndex = 3 then Passed += 1

' Qualified primitive array fields can serve directly as VRAM buffers.
put char 65 at 0,0
SceneRam.Game.Buffer = get count 4 at 0,0
if SceneRam.Game.Buffer[0] = 65 then Passed += 1
if SceneRam.Game.Buffer[3] = 32 then Passed += 1

' Packed BCD fields retain their digit count while sharing overlay RAM.
SceneRam.Game.Score = 123
if SceneRam.Game.Score = 123 then Passed += 1
inc SceneRam.Game.Score
if SceneRam.Game.Score = 124 then Passed += 1
SceneRam.Game.Score += 5
if SceneRam.Game.Score = 129 then Passed += 1
SceneRam.Game.Best = SceneRam.Game.Score
if SceneRam.Game.Best = 129 then Passed += 1
clear SceneRam.Game.Score
if SceneRam.Game.Score = 0 then Passed += 1

if Passed = 31 then
  print centered at 12, "PASS"
else
  print centered at 12, "FAIL"
end if
screen on
loop forever
