project "AMY OVERLAY LAYOUT SELFTEST"
memory "colecovision_legacy_sdcc"

' Phase-A RAM overlay test. Menu and Game are mutually exclusive layouts.
record MenuMemory:
  u8 Selection
  u8 Blink
end record

record ProbeActor:
  u8 X
  u16 Score
  i8 DX
  u8 Flags[3]
end record

record GameMemory:
  u8 PlayerX
  u8 PlayerY
  u8 EnemyX[8]
  u16 Scores[3]
  ProbeActor Actors[3]
  u8 AfterActors
end record

overlay SceneRam
  Menu as MenuMemory
  Game as GameMemory
end overlay

u8 Passed = 0
u8 ActorIndex = 1

text screen
backdrop dark blue
print centered at 8, "RAM OVERLAY SELFTEST"

' These two qualified names deliberately alias the same physical byte.
SceneRam.Menu.Selection = 17
if SceneRam.Game.PlayerX = 17 then Passed += 1
SceneRam.Game.EnemyX[3] = 42
if SceneRam.Game.EnemyX[3] = 42 then Passed += 1
SceneRam.Game.Scores[2] = 1234
if SceneRam.Game.Scores[2] = 1234 then Passed += 1
SceneRam.Game.Actors[0].Score = 1000
if SceneRam.Game.Actors[0].Score = 1000 then Passed += 1
SceneRam.Game.Actors[ActorIndex].X = 29
if SceneRam.Game.Actors[ActorIndex].X = 29 then Passed += 1
SceneRam.Game.Actors[2].DX = -3
if SceneRam.Game.Actors[2].DX = -3 then Passed += 1
SceneRam.Game.AfterActors = 99
if SceneRam.Game.AfterActors = 99 then Passed += 1

if Passed = 7 then
  print centered at 12, "PASS"
else
  print centered at 12, "FAIL"
end if
screen on
loop forever
