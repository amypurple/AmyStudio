project "Delta Remix Music Box"
cartridge "DELTA REMIX/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

text screen
print centered at 3, "DELTA REMIX"
print centered at 5, "UNFINISHED MUSIC SAMPLE"
print at 3,9, "MUSIC LOOPS AUTOMATICALLY"
print at 3,12, "BUTTON1 = SHOOT SFX"
print at 3,14, "BUTTON2 = CATCH SFX"
print at 3,18, "PRESS * TO RESTART SONG"
print at 3,20, "PRESS # TO STOP ALL"
set sound table DeltaRemixSoundTable areas 5
screen on
wait 2 frames
play song DeltaRemixSong

MainLoop:
  if joypad(1).button1 then
    play sound 15
    goto WaitButtonRelease
  elseif joypad(1).button2 then
    play sound 16
    goto WaitButtonRelease
  elseif keypad(1) = 10 then
    play song DeltaRemixSong
    goto WaitButtonRelease
  elseif keypad(1) = 15 then
    stop all
    goto WaitButtonRelease
  end if
  wait
  goto MainLoop

WaitButtonRelease:
  wait
  if joypad(1).button1 then goto WaitButtonRelease
  if joypad(1).button2 then goto WaitButtonRelease
  if keypad(1) = 10 then goto WaitButtonRelease
  if keypad(1) = 15 then goto WaitButtonRelease
  goto MainLoop

include "@project/delta-remix-music.asm"