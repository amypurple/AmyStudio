cartridge "IMPROVISOR/DONALD EDDINGTON, GAZETTE/1987"

' IMPROVISOR
' Based on "Improvisor" by Donald Eddington, COMPUTE!'s Gazette April 1987
' (page 46, listing pages 106-107): a music toy for the Commodore 64 in
' BASIC. Made for the ColecoVision in Amy (the language by Amy Bienvenu)
' by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision toy on the listing's rules and
' data (orig/ has the scans and the transcription). Kept: the four modes
' (RANDOM: a random note 0-9 each beat; COMPOSE: the listing's "A.I.",
' lines 230-320, each beat either the note at the same place of one of the
' memorized improvs (16 chances in 23) or one of 0 2 3 5 7 8 0; PLAY
' ALONG: you play; SHORT-TUNES: the sixteen 32-note improvs of lines
' 720-870); the ten keys 0-9 (0 a rest, 1-9 the notes F G A C D F G A C:
' no fourth and no seventh, so nothing sounds wrong); the two-voice
' accompaniment of lines 140-210, an oom-pah of 32 beats under each improv;
' beats 31 and 32 of every phrase end on F and a rest; sixteen improvs and
' "THAT'S ALL THE GRAND IMPROVISOR WILL PLAY FOR NOW."; the C64's colours
' and note names under the keys (R F G A C D F G A C).
' Made for this machine: a xylophone of ten bars, each in its key's
' colour; a mallet (sprite) strikes the bar played, the computer's notes
' too, and the bar lights up; notes dance up from the bars; the sound chip
' driven directly: the melody on tone 1, the accompaniment on tones 2 and
' 3, and its bass notes below the tone channels' range (65-87 Hz, 49-62
' Hz) on the periodic noise, which plays tone 3's frequency divided by 15;
' a tempo control; an original title tune, "Ten Bars".
'
' Controls (either joystick): on the menu, up and down choose, the button
' selects (left, right or the button change the tempo). Playing along:
' left and right move the mallet along the bars, the button strikes the
' bar (hold it and the note rings on; let go and it fades). The right
' button goes back to the menu; choosing a mode there carries on where
' the music was, as the C64's function keys did.
'
' Liberties: the menu and the stick replace the F keys and the number
' keys; in PLAY ALONG the note sounds at once when you strike (the C64 read
' one key a beat, and with no key pressed it played key 5, D, every beat),
' and beats 31-32 do not overrule your notes; the one accompaniment note
' below the tone range that is not a bass note (G2, 98 Hz) is played an
' octave up; after the sixteenth improv the menu comes back (the C64
' program stopped). Beat lengths: 15 frames (NORMAL), 21 (SLOW), 11 (FAST),
' an eighth shorter while composing (the C64's delay loop: 131 for 150).
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TB0lt = 128
const TB0rt = 129
const TB0lm = 130
const TB0rm = 131
const TB0lb = 132
const TB0rb = 133
const TB1lt = 134
const TB1rt = 135
const TB1lm = 136
const TB1rm = 137
const TB1lb = 138
const TB1rb = 139
const TB2lt = 140
const TB2rt = 141
const TB2lm = 142
const TB2rm = 143
const TB2lb = 144
const TB2rb = 145
const TB3lt = 146
const TB3rt = 147
const TB3lm = 148
const TB3rm = 149
const TB3lb = 150
const TB3rb = 151
const TB4lt = 152
const TB4rt = 153
const TB4lm = 154
const TB4rm = 155
const TB4lb = 156
const TB4rb = 157
const TB5lt = 158
const TB5rt = 159
const TB5lm = 160
const TB5rm = 161
const TB5lb = 162
const TB5rb = 163
const TB6lt = 164
const TB6rt = 165
const TB6lm = 166
const TB6rm = 167
const TB6lb = 168
const TB6rb = 169
const TB7lt = 170
const TB7rt = 171
const TB7lm = 172
const TB7rm = 173
const TB7lb = 174
const TB7rb = 175
const TB8lt = 176
const TB8rt = 177
const TB8lm = 178
const TB8rm = 179
const TB8lb = 180
const TB8rb = 181
const TB9lt = 182
const TB9rt = 183
const TB9lm = 184
const TB9rm = 185
const TB9lb = 186
const TB9rb = 187
const TLitlt = 188
const TLitrt = 189
const TLitlm = 190
const TLitrm = 191
const TLitlb = 192
const TLitrb = 193
const TD0 = 194
const TD1 = 195
const TD2 = 196
const TD3 = 197
const TD4 = 198
const TD5 = 199
const TD6 = 200
const TD7 = 201
const TD8 = 202
const TD9 = 203
const TN0 = 204
const TN1 = 205
const TN2 = 206
const TN3 = 207
const TN4 = 208
const TN5 = 209
const TN6 = 210
const TN7 = 211
const TN8 = 212
const TN9 = 213
const TRail = 214
const SMhead = 0
const SMstick = 4
const SNote1 = 8
const SNote2 = 12
const NTiles8 = 696
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndPick = 3
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the music: Mode 0 RANDOM, 1 COMPOSE, 2 PLAY ALONG, 3 SHORT-TUNES; P the
' beat of the phrase (1-32), Q the improv (1-16), NT the beats played
' (the listing's NT: the place in the tunes); R the note (0-9); Fin 1
' after the sixteenth improv
u8 Mode = 3
u8 P = 1
u8 Q = 1
u16 NT = 0
u8 R = 0
u8 Ai = 0
u8 Fin = 0
u8 Tsel = 1
u8 Blen = 15
u8 Bf = 0
' for the tests: Beats counts the beats; for the last one BeatP, BeatNT,
' LastR (255 when you play), Rs0 (the random state before it), MelLast
' and AccLast (the periods struck); PlayR and Plays your strikes
u16 Beats = 0
u8 BeatP = 0
u16 BeatNT = 0
u8 LastR = 0
u16 Rs0 = 0
u16 MelLast = 0
u16 AccLast = 0
u8 PlayR = 0
u16 Plays = 0
u16 Rs = $1D3B
u16 Rt = 0

' the sound chip (ImTone: channel Pc, period Pp; ImVols writes the four
' volumes): Ea0 the melody's attenuation, Ea1 voice 2's, Ea2 voice 1's
' (on tone 3 or, V1N 1, on the periodic noise); Hold 1 while your note
' rings; EnvT counts frames
u16 Pp = 0
u8 Pc = 0
u8 Ea0 = 15
u8 Ea1 = 15
u8 Ea2 = 15
u8 V1N = 0
u8 Hold = 0
u8 EnvT = 0
u8 Dmy = 0

' the picture: Cur the bar under your mallet, Tb the bar the mallet goes
' to, Mx its x, St the strike's frames; Lb the lit bar (255 none), Lt its
' frames; two dancing notes (Na age, 0 off)
u8 Cur = 5
u8 Tb = 5
u8 Mx = 131
u8 My = 0
u8 St = 0
u8 Lb = 255
u8 Lt = 0
u8 Na1 = 0
u8 Nx1 = 0
u8 Ny1 = 0
u8 Nc1 = 0
u8 Np1 = 0
u8 Na2 = 0
u8 Nx2 = 0
u8 Ny2 = 0
u8 Nc2 = 0
u8 Np2 = 0
u8 Nslot = 0

u8 Sel = 3
u8 First = 1
u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Btn2 = 0
u8 WasBtn2 = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
u8 Tm = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Idle = 0

  tile screen
  set sound table ImSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

menu_top:
  MenuPage
  PlayPage
  goto menu_top

' Beat: one beat of the listing's loop (lines 510-680)
sub Beat:
  Rs0 = Rs
  BeatP = P
  inc NT
  BeatNT = NT
  R = 0
  if Mode = 0 then
    ' line 580: R = INT(RND(1)*10)
    Rnd
    V = Rs >> 8
    W16 = V * 10
    R = W16 >> 8
  end if
  if Mode = 1 then
    ' lines 230-320: AI = INT(RND(0)*23)+1; R = TU(AI*16+P) up to 16
    Rnd
    V = Rs >> 8
    W16 = V * 23
    Ai = W16 >> 8
    inc Ai
    if Ai <= 16 then
      W16 = Ai
      W16 = W16 << 4
      W16 = W16 + P
      dec W16
      R = Tunes[W16]
    else
      V = Ai - 17
      R = AiTab[V]
    end if
  end if
  if Mode = 3 then
    ' line 590: R = TUNES(NT)
    W16 = NT
    dec W16
    R = Tunes[W16]
  end if
  if Mode <> 2 then
    ' lines 620-630
    if P = 31 then R = 1
    if P = 32 then R = 0
    LastR = R
  else
    LastR = 255
  end if
  ' line 610: the accompaniment's two voices
  W16 = V2Per[P]
  AccLast = W16
  if W16 <> 0 then
    Pc = 1
    Pp = W16
    call asm ImTone
    Ea1 = 4
    W16 = V1Per[P]
    V1N = V1Noise[P]
    Pc = 2
    Pp = W16
    call asm ImTone
    if V1N = 1 then
      Ea2 = 1
    else
      Ea2 = 5
    end if
  end if
  if Mode <> 2 then Strike(R)
  inc Beats
  inc P
  if P = 33 then
    P = 1
    inc Q
    if Q = 17 then
      Fin = 1
    else
      ShowQ
    end if
  end if
  Dmy = 0
  return
end sub

' Strike(B): bar B struck: its note on the melody voice (0 is a rest: the
' last note rings out), the bar lit, the mallet down, a note dancing up
sub Strike(u8 B):
  Tb = B
  St = 5
  if B > 0 then
    W16 = MelPer[B]
    MelLast = W16
    Pc = 0
    Pp = W16
    call asm ImTone
    Ea0 = 0
    SpawnNote(B)
  end if
  LightBar(B)
  Dmy = 0
  return
end sub

' LightBar(B): the lit bar's colours over bar B (the last one put back)
sub LightBar(u8 B):
  if Lb <> 255 then
    W16 = Lb
    W16 = W16 * 48
    A16 = W16 + 1024
    copy TileCol + W16 count 48 to vram.color + A16
  end if
  W16 = B
  W16 = W16 * 48
  A16 = W16 + 1024
  copy TileCol + 480 count 48 to vram.color + A16
  Lb = B
  Lt = 9
  return
end sub

sub Unlight:
  if Lb = 255 then return
  W16 = Lb
  W16 = W16 * 48
  A16 = W16 + 1024
  copy TileCol + W16 count 48 to vram.color + A16
  Lb = 255
  return
end sub

' SpawnNote(B): a note rises from bar B, in its colour
sub SpawnNote(u8 B):
  X = B << 4
  X = X + 51
  Y = BarTop[B]
  Y = Y << 3
  Y = Y - 30
  V = LabCol[B]
  if Nslot = 0 then
    Na1 = 1
    Nx1 = X
    Ny1 = Y
    Nc1 = V
    Np1 = SNote1
    if B > 5 then Np1 = SNote2
    Nslot = 1
  else
    Na2 = 1
    Nx2 = X
    Ny2 = Y
    Nc2 = V
    Np2 = SNote2
    if B > 5 then Np2 = SNote1
    Nslot = 0
  end if
  return
end sub

' Env: the volumes, once a frame: a strike starts loud and fades (the
' melody holds while you hold the button); the accompaniment plucks
sub Env:
  inc EnvT
  V = EnvT & 3
  if V = 0 then
    if Hold = 1 then
      if Ea0 < 4 then inc Ea0
    else
      if Ea0 < 15 then inc Ea0
    end if
  end if
  if V = 2 then
    if Ea1 < 15 then inc Ea1
    if Ea2 < 15 then inc Ea2
  end if
  call asm ImVols
  Dmy = 0
  return
end sub

sub Silence:
  Ea0 = 15
  Ea1 = 15
  Ea2 = 15
  Hold = 0
  call asm ImVols
  Dmy = 0
  return
end sub

' Rnd: a 16-bit xorshift (7, 9, 8)
sub Rnd:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

' DrawSpr: the mallet glides to its bar and strikes; the notes rise and sway
sub DrawSpr:
  X = Tb << 4
  X = X + 51
  if Mx < X then
    V = X - Mx
    if V > 6 then V = 6
    Mx = Mx + V
  end if
  if Mx > X then
    V = Mx - X
    if V > 6 then V = 6
    Mx = Mx - V
  end if
  Y = BarTop[Tb]
  Y = Y << 3
  if St > 0 then
    My = Y - 14
    dec St
  else
    My = Y - 20
  end if
  set sprite 0 to My,Mx,SMhead,8
  set sprite 1 to My,Mx,SMstick,10
  if Na1 > 0 then
    inc Na1
    dec Ny1
    V = Na1 >> 2
    V = V & 7
    V = Sway[V]
    X = Nx1 + V
    set sprite 2 to Ny1,X,Np1,Nc1
    if Na1 > 44 then Na1 = 0
  else
    set sprite 2 to 192,0,0,0
  end if
  if Na2 > 0 then
    inc Na2
    dec Ny2
    V = Na2 >> 2
    V = V & 7
    V = Sway[V]
    X = Nx2 - V
    set sprite 3 to Ny2,X,Np2,Nc2
    if Na2 > 44 then Na2 = 0
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

' PlayPage: the xylophone, the music, until the right button
sub PlayPage:
  NewScreen
  DrawBars
  print at 6,1, "THE GRAND IMPROVISOR"
  print at 13,6, "RIGHT BUTTON: MENU"
  ShowMode
  ShowQ
  Fin = 0
  Na1 = 0
  Na2 = 0
  Lb = 255
  Tb = Cur
  X = Cur << 4
  Mx = X + 51
  V = Tsel
  Blen = BlenTab[V]
  if Mode = 1 then
    V = Blen >> 3
    Blen = Blen - V
  end if
  Bf = Blen
  DrawSpr
  ShowScreen
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  ' the BIOS sound manager let go of the chip (it would overwrite the
  ' volumes every frame): the next menu click turns it on again
  call asm ImBiosOff
  call asm ImNoise
  Silence
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  WasStick = 1
pp_loop:
  Frame1
  ReadPad
  if Press2 = 1 then
    Silence
    Unlight
    return
  end if
  if Mode = 2 then PlayInput
  inc Bf
  if Bf >= Blen then
    Bf = 0
    Beat
  end if
  Env
  if Lt > 0 then
    dec Lt
    if Lt = 0 then Unlight
  end if
  DrawSpr
  if Fin = 1 then
    Finale
    return
  end if
  goto pp_loop
end sub

' PlayInput: left and right move the mallet (a step, then every 6 frames
' while held), the button strikes, holding it rings the note on
sub PlayInput:
  V = Lf1 | Rt1
  if V = 1 then
    W = 0
    if WasStick = 0 then
      W = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        W = 1
        Rep = 6
      end if
    end if
    if W = 1 then
      if Lf1 = 1 then
        if Cur > 0 then dec Cur
      end if
      if Rt1 = 1 then
        if Cur < 9 then inc Cur
      end if
      Tb = Cur
    end if
  end if
  WasStick = V
  if Press = 1 then
    PlayR = Cur
    inc Plays
    if Cur > 0 then
      Strike(Cur)
      Hold = 1
    else
      Strike(0)
      Hold = 0
      Ea0 = 15
    end if
  end if
  if Btn = 0 then Hold = 0
  return
end sub

' Finale: line 930-940, then back to the menu with a new session
sub Finale:
  Silence
  Unlight
  for Y = 3 to 5
    print at 2,Y, "                            "
  next
  print at 4,3, "THAT'S ALL THE GRAND"
  print at 4,4, "IMPROVISOR WILL PLAY"
  print at 4,5, "FOR NOW."
  for Tm = 1 to 240
    Frame1
    ReadPad
    if Press = 1 then Tm = 240
    if Press2 = 1 then Tm = 240
  next
  NewSession
  return
end sub

sub NewSession:
  P = 1
  Q = 1
  NT = 0
  return
end sub

sub ShowMode:
  if Mode = 0 then
    print at 3,3, "COMPUTER RANDOM"
    print at 3,4, "NOTE SEQUENCES USING"
    print at 3,5, "A RANDOM FUNCTION."
  end if
  if Mode = 1 then
    print at 3,3, "COMPUTER COMPOSES"
    print at 3,4, "THE COMPUTER'S A.I. IN"
    print at 3,5, "MUSIC COMPOSITION."
  end if
  if Mode = 2 then
    print at 3,3, "NOW YOU PLAY"
    print at 3,4, "STICK: MOVE THE MALLET"
    print at 3,5, "BUTTON: STRIKE, HOLD: RING"
  end if
  if Mode = 3 then
    print at 3,3, "SHORT-TUNES"
    print at 3,4, "THESE ARE THE TUNES"
    print at 3,5, "WHICH I MEMORIZED."
  end if
  return
end sub

' ShowQ: the improv playing (row 2, as the listing's line 500)
sub ShowQ:
  print at 4,2, "NOW PLAYING IMPROV."
  NumU = Q
  print at 24,2, digits$(NumU, 2)
  return
end sub

' DrawBars: ten bars, each 2 tiles wide, from rows BarTop to BarTop + BarH
' - 1; the rail under them, the key and note name under each
sub DrawBars:
  for K = 0 to 9
    X = K << 1
    X = X + 6
    Y = BarTop[K]
    N = BarH[K]
    V = K * 6
    V = V + TB0lt
    W = V + 1
    put char V at X,Y
    put char W at X+1,Y
    inc Y
    V = V + 2
    W = V + 1
    N = N - 2
db_mid:
    if N > 0 then
      put char V at X,Y
      put char W at X+1,Y
      inc Y
      dec N
      goto db_mid
    end if
    V = V + 2
    W = V + 1
    put char V at X,Y
    put char W at X+1,Y
    V = TD0 + K
    put char V at X,22
    V = TN0 + K
    put char V at X+1,22
  next
  for X = 5 to 26
    put char TRail at X,21
  next
  return
end sub

' MenuPage: the title, the modes, the tempo, start over, credits
sub MenuPage:
mp_top:
  NewScreen
  print at 6,2, "THE GRAND IMPROVISOR"
  print at 4,4, "A XYLOPHONE THAT PLAYS"
  print at 4,5, "ALONG, COMPOSES, AND YOU"
  print at 4,6, "CAN PLAY IT TOO!"
  print at 6,8, "COMPUTER GOES RANDOM"
  print at 6,9, "COMPUTER COMPOSES"
  print at 6,10, "YOU PLAY ALONG"
  print at 6,11, "SHORT-TUNES"
  print at 6,12, "TEMPO:"
  print at 6,13, "START OVER"
  print at 6,14, "CREDITS"
  print at 4,16, "NEXT: IMPROV. NO."
  print at 4,18, "UP, DOWN: CHOOSE"
  print at 4,19, "BUTTON: SELECT"
  print at 4,20, "PLAYING: RIGHT BUTTON"
  print at 4,21, "COMES BACK HERE"
  ShowTempo
  ShowNext
  ShowSel
  ShowScreen
  if First = 1 then
    play sound SndTuneA
    play sound SndTuneB
    TzLeft = 448
    TzOn = 1
    First = 0
  end if
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  WasStick = 1
mp_loop:
  Frame1
  ReadPad
  ' the time spent here stirs the random numbers
  Rt = Tick
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $1D3B
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      else
        if Sel < 6 then inc Sel
      end if
      play sound SndPick
      ShowSel
    end if
  end if
  W = Lf1 | Rt1
  if W = 1 then
    if WasStick = 0 then
      if Sel = 4 then
        if Lf1 = 1 then
          if Tsel > 0 then dec Tsel
        else
          if Tsel < 2 then inc Tsel
        end if
        play sound SndPick
        ShowTempo
      end if
    end if
  end if
  WasStick = V | W
  if Press = 0 then goto mp_loop
  if Sel < 4 then
    Mode = Sel
    return
  end if
  if Sel = 4 then
    inc Tsel
    if Tsel > 2 then Tsel = 0
    play sound SndPick
    ShowTempo
    goto mp_loop
  end if
  if Sel = 5 then
    NewSession
    play sound SndPick
    ShowNext
    goto mp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  CreditsPage
  goto mp_top
end sub

sub ShowSel:
  for J = 8 to 14
    put char 32 at 4,J
  next
  V = Sel + 8
  put char 62 at 4,V
  return
end sub

sub ShowTempo:
  if Tsel = 0 then print at 13,12, "SLOW  "
  if Tsel = 1 then print at 13,12, "NORMAL"
  if Tsel = 2 then print at 13,12, "FAST  "
  return
end sub

sub ShowNext:
  NumU = Q
  print at 22,16, digits$(NumU, 2)
  return
end sub

sub CreditsPage:
  NewScreen
  print at 6,2, "THE GRAND IMPROVISOR"
  print at 3,4, "BASED ON IMPROVISOR BY"
  print at 3,5, "DONALD EDDINGTON, COMPUTE!'S"
  print at 3,6, "GAZETTE APRIL 1987 (C64)."
  print at 3,8, "THE SIXTEEN IMPROVS, THE"
  print at 3,9, "ACCOMPANIMENT AND THE A.I."
  print at 3,10, "ARE THE LISTING'S."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY BIENVENU."
  print at 3,17, "TITLE MUSIC: TEN BARS"
  print at 8,20, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).button1 then Btn = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

