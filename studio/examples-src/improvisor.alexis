asm {
ImPick:
    db $40,$35,$40,$01,$50

ImSoundTable:
    dw ImTuneMel,$702B
    dw ImTuneBass,$7035
    dw ImPick,$7049
; Ten Bars (original)
; Tiny Sound, 7 frames per step
ImTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$24,$01,$28,$01,$2B,$01,$28,$01,$26,$01,$24,$01
    db $21,$01,$01,$01,$1F,$01,$21,$01,$24,$01,$26,$01,$28,$01,$01,$01
    db $00,$01,$01,$01,$2B,$01,$28,$01,$26,$01,$28,$01,$24,$01,$21,$01
    db $1F,$01,$01,$01,$21,$01,$24,$01,$26,$01,$28,$01,$24,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
ImTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0C,$01,$13,$01,$0C,$01,$13,$01,$05,$01,$0C,$01
    db $05,$01,$0C,$01,$0C,$01,$13,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$01,$01,$10,$01,$0C,$01,$05,$01,$0C,$01,$09,$01,$10,$01
    db $07,$01,$0E,$01,$05,$01,$0C,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$01,$01
    db $FF
; ImTone: tone channel AMY_UVAR_Pc (0-2) to period AMY_UVAR_Pp (10 bits)
ImTone:
  ld a,(AMY_UVAR_Pc)
  add a,a
  add a,a
  add a,a
  add a,a
  add a,a
  or $80
  ld b,a
  ld hl,(AMY_UVAR_Pp)
  ld a,l
  and $0F
  or b
  out ($FF),a
  ld a,l
  rrca
  rrca
  rrca
  rrca
  and $0F
  ld b,a
  ld a,h
  add a,a
  add a,a
  add a,a
  add a,a
  or b
  and $3F
  out ($FF),a
  ret
; ImVols: the melody (tone 1), voice 2 (tone 2), voice 1 (tone 3 or the
; noise, AMY_UVAR_V1N 1) volumes from Ea0, Ea1, Ea2
ImVols:
  ld a,(AMY_UVAR_Ea0)
  and $0F
  or $90
  out ($FF),a
  ld a,(AMY_UVAR_Ea1)
  and $0F
  or $B0
  out ($FF),a
  ld a,(AMY_UVAR_V1N)
  or a
  jr nz,ImVolsN
  ld a,(AMY_UVAR_Ea2)
  and $0F
  or $D0
  out ($FF),a
  ld a,$FF
  out ($FF),a
  ret
ImVolsN:
  ld a,$DF
  out ($FF),a
  ld a,(AMY_UVAR_Ea2)
  and $0F
  or $F0
  out ($FF),a
  ret
; ImBiosOff: no BIOS sound processing in the NMI while the xylophone plays
ImBiosOff:
  xor a
  ld (AMY_SOUND_ENABLED),a
  ret
; ImNoise: periodic noise at tone 3's frequency (divided by 15)
ImNoise:
  ld a,$E3
  out ($FF),a
  ret
}
