' Fixed32 selftest: basic add/sub/multiply/sqrt plus decimal output.
fixed32 Sum = 1.5
fixed32 MulWhole = 1.5
fixed32 MulFrac = 0.5
fixed32 NegAdd = 1.5
fixed32 NegSub = 1.5
fixed32 RootIn = 9.0
fixed32 RootOut = 0.0
u8 AddPass = 0, MulWholePass = 0, SubPass = 0, MulFracPass = 0, NegAddPass = 0, NegSubPass = 0, SqrtPass = 0, AllPass = 0

' Amy Fixed32 Selftest
  text screen
  run_demo
  screen on

sub run_demo:
  print at 7,0, "FIXED32 SELFTEST"
  print at 1,4, "1.50 + 2.25"
  Sum += 2.25
  print Sum at 18,4
  if Sum = raw $0003C000 then
    AddPass = 1
  end if

  print at 1,6, "1.50 * 2.00"
  MulWhole *= 2
  print MulWhole at 18,6
  if MulWhole = raw $00030000 then
    MulWholePass = 1
  end if

  print at 1,8, "3.75 - 0.50"
  Sum -= 0.5
  print Sum at 18,8
  if Sum = raw $00034000 then
    SubPass = 1
  end if

  print at 1,10, "0.50 * 0.50"
  MulFrac *= 0.5
  print MulFrac at 18,10
  if MulFrac = raw $00004000 then
    MulFracPass = 1
  end if

  print at 1,12, "1.50 + -2.25"
  NegAdd += -2.25
  print NegAdd at 18,12
  if NegAdd = raw $FFFF4000 then
    NegAddPass = 1
  end if

  print at 1,14, "1.50 - 2.25"
  NegSub -= 2.25
  print NegSub at 18,14
  if NegSub = raw $FFFF4000 then
    NegSubPass = 1
  end if

  print at 1,16, "SQRT 9.00"
  RootOut = sqrt(RootIn)
  print RootOut at 18,16
  if RootOut = raw $00030000 then
    SqrtPass = 1
  end if

  if AddPass and MulWholePass and SubPass and MulFracPass and NegAddPass and NegSubPass and SqrtPass then
    AllPass = 1
  end if

  print at 1,20, "ADD"
  if AddPass then print at 10,20, "PASS" else print at 10,20, "FAIL"
  print at 16,20, "MUL"
  if MulWholePass then print at 26,20, "PASS" else print at 26,20, "FAIL"
  print at 1,21, "SUB"
  if SubPass then print at 10,21, "PASS" else print at 10,21, "FAIL"
  print at 16,21, "FMUL"
  if MulFracPass then print at 26,21, "PASS" else print at 26,21, "FAIL"
  print at 1,22, "NEG ADD"
  if NegAddPass then print at 10,22, "PASS" else print at 10,22, "FAIL"
  print at 16,22, "NEG SUB"
  if NegSubPass then print at 26,22, "PASS" else print at 26,22, "FAIL"
  print at 1,23, "SQRT"
  if SqrtPass then print at 10,23, "PASS" else print at 10,23, "FAIL"
  if AllPass then print at 19,23, "OVERALL PASS" else print at 19,23, "OVERALL FAIL"
  return