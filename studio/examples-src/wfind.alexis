u8 Y = 0
u8 Cx = 0
u8 Cy = 0
u8 Ok = 0
u16 NumU = 0

  tile screen
  set sound table WfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu > 0 then goto title
  SetupPage
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Mode = 2 then goto play_loop

  HideSprites
  mute all
  EndScreen
  Rearm
  wait 60 frames
  nmi off
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the words

' letter Lk (0-25) of hidden word Hw
function WLetter(u8 Hw, u8 Lk) as u8
  u16 P = 0
  P = Theme * 24 + WList[Hw].Num
  P = P * 8 + Lk + 1
  return WordData[P]

' word Hw's length and letters (0-25) into WBuf
sub LoadWord(u8 Hw):
  u16 P = 0
  P = Theme * 24 + WList[Hw].Num
  P = P * 8
  copy WordData + P count 8 to WBuf
  return
end sub

' the letter (0-25) of grid tile code Tc
function LetterOf(u8 Tc) as u8
  return (Tc - LNorm) mod 26

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rb = highbyte Rs
  return
end sub

' NW different random words of the theme, then longest first (as the C64)
sub ChooseWords:
  fill array Used with 0
  V = NW - 1
  for Wi = 0 to V
    Ok = 0
    while Ok = 0
      Rnd
      K = Rb mod 24
      if Used[K] = 0 then Ok = 1
    end while
    Used[K] = 1
    WList[Wi].Num = K
    W = Theme * 24 + K
    NumU = W
    NumU = NumU * 8
    WList[Wi].Len = WordData[NumU]
    WList[Wi].Found = 0
  next
  ' bubble sort by length, longest first
  Bad = 1
  while Bad = 1
    Bad = 0
    V = NW - 2
    for Wi = 0 to V
      Qi = Wi + 1
      if WList[Wi].Len < WList[Qi].Len then
        SwapW = WList[Wi]
        WList[Wi] = WList[Qi]
        WList[Qi] = SwapW
        Bad = 1
      end if
    next
  end while
  return
end sub

' try to put word Wi somewhere: Ok = 1 when it went in
sub PlaceOne:
  Ok = 0
  Tries = 0
  L = WList[Wi].Len
  while Ok = 0 and Tries < 250
    inc Tries
    Rnd
    X = Rb mod 20
    Rnd
    Y = Rb mod 20
    Rnd
    K = Rb & 7
    ' the far end must be inside the grid (u8: off the left/top wraps high)
    W = L - 1
    Cx = X + W * DirX[K]
    Cy = Y + W * DirY[K]
    if Cx < 20 and Cy < 20 then
      Ok = 1
      Cx = X
      Cy = Y
      W = L - 1
      for Ti = 0 to W
        C = get char at Cx + 2, Cy + 1
        if C <> 32 then
          if LetterOf(C) <> WLetter(Wi, Ti) then Ok = 0
        end if
        Cx += DirX[K]
        Cy += DirY[K]
      next
    end if
  end while
  if Ok = 1 then
    WList[Wi].X = X
    WList[Wi].Y = Y
    WList[Wi].D = K
    Cx = X
    Cy = Y
    for Ti = 0 to W
      C = LNorm + WLetter(Wi, Ti)
      put char C at Cx + 2, Cy + 1
      Cx += DirX[K]
      Cy += DirY[K]
    next
  end if
  return
end sub

sub MakeGrid:
mg_again:
  for Ri = 1 to 20
    fill 32 count 20 at 2,Ri
  next
  Bad = 0
  V = NW - 1
  for Wi = 0 to V
    if Bad = 0 then
      PlaceOne
      if Ok = 0 then Bad = 1
    end if
  next
  if Bad = 1 then goto mg_again
  ' random letters everywhere else
  for Ri = 1 to 20
    for Si = 2 to 21
      C = get char at Si, Ri
      if C = 32 then
        Rnd
        C = Rb mod 26
        put char LNorm + C at Si, Ri
      end if
    next
  next
  return
end sub

' word Wi in the list beside the grid (found: green letter tiles)
sub ListWord:
  LoadWord(Wi)
  L = WBuf[0]
  Y = Wi + 1
  W = L - 1
  for Ti = 0 to W
    C = WBuf[Ti + 1]
    if WList[Wi].Found = 1 then
      C = C + LFound
    else
      C = C + 65
    end if
    X = 23 + Ti
    put char C at X, Y
  next
  return
end sub

sub NewGame:
  NewScreen
  print at 2,22, "HIDING THE WORDS..."
  ShowScreen
  ChooseWords
  Rearm
  wait
  nmi off
  display off
  MakeGrid
  fill 32 count 28 at 2,22
  for Ri = 1 to 20
    put char TVbar at 22, Ri
  next
  V = NW - 1
  for Wi = 0 to V
    ListWord
  next
  CurX = 10
  CurY = 10
  Sel = 0
  SpanN = 0
  Lock = 0
  NFound = 0
  FoundB = 0
  Secs = 0
  SecF = 0
  Rep = 0
  Limit = TMin
  Limit = Limit * 60
  ShowHud
  ShowTheme
  Mode = 2
  DrawCursor
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  return
end sub

' ---------------------------------------------------------------------------
' play

sub PlayStep:
  Clock
  if Mode <> 2 then return
  if Lock > 0 then
    dec Lock
    if Lock = 0 then
      RestoreSpan
      Sel = 0
      ShowTheme
    end if
    return
  end if
  StickMove
  if Press2 = 1 and Sel = 1 then
    RestoreSpan
    Sel = 0
    play sound SndDrop
  elseif Press1 = 1 then
    MarkEnd
  end if
  return
end sub

sub Clock:
  inc SecF
  if SecF < 60 then return
  SecF = 0
  if Secs < 5999 then inc Secs
  if Limit > 0 then
    if Secs >= Limit then Mode = 5
    if Secs + 10 >= Limit then play sound SndTick
  end if
  ShowClock
  return
end sub

' the stick: a step on a new push (diagonals too), then repeats after 16
' frames, every 6
sub StickMove:
  V = Jy & 15
  if V = 0 then
    Rep = 0
    return
  end if
  Go = 0
  if Rep = 0 then
    Go = 1
    Rep = 16
  else
    dec Rep
    if Rep = 0 then
      Go = 1
      Rep = 6
    end if
  end if
  if Go = 0 then return
  X = CurX
  Y = CurY
  if V & 1 then
    if CurY > 0 then dec CurY
  elseif V & 2 then
    if CurY < 19 then inc CurY
  end if
  if V & 4 then
    if CurX > 0 then dec CurX
  elseif V & 8 then
    if CurX < 19 then inc CurX
  end if
  if CurX <> X or CurY <> Y then
    play sound SndStep
    if Sel = 1 then ShowSpan
  end if
  return
end sub

' the left button: the first letter, or the last letter of a try
sub MarkEnd:
  if Sel = 0 then
    Sel = 1
    SelX = CurX
    SelY = CurY
    SpanN = 0
    ShowSpan
    play sound SndMark
  elseif CurX = SelX and CurY = SelY then
    RestoreSpan
    Sel = 0
    play sound SndDrop
  else
    TryWord
  end if
  return
end sub

' put back what the marked line covered
sub RestoreSpan:
  if SpanN > 0 then
    Cx = SelX
    Cy = SelY
    V = SpanN - 1
    for Si = 0 to V
      put char SpanSave[Si] at Cx + 2, Cy + 1
      Cx += StX
      Cy += StY
    next
  end if
  SpanN = 0
  return
end sub

' the marked line from the first letter to the box, in yellow; only the
' first letter when the box is not on one of its eight lines
sub ShowSpan:
  RestoreSpan
  DdX = CurX - SelX
  DdY = CurY - SelY
  StX = 0
  StY = 0
  AdX = 0
  AdY = 0
  if DdX > 0 then
    StX = 1
    AdX = DdX
  elseif DdX < 0 then
    StX = 255
    AdX = 0 - DdX
  end if
  if DdY > 0 then
    StY = 1
    AdY = DdY
  elseif DdY < 0 then
    StY = 255
    AdY = 0 - DdY
  end if
  if AdX = 0 or AdY = 0 or AdX = AdY then
    SpanN = AdX
    if AdY > SpanN then SpanN = AdY
    inc SpanN
  else
    SpanN = 1
    StX = 0
    StY = 0
  end if
  Cx = SelX
  Cy = SelY
  V = SpanN - 1
  for Si = 0 to V
    C = get char at Cx + 2, Cy + 1
    SpanSave[Si] = C
    SpanLet[Si] = LetterOf(C)
    K = LSel + SpanLet[Si]
    put char K at Cx + 2, Cy + 1
    Cx += StX
    Cy += StY
  next
  return
end sub

' 1 when the marked line spells word Wi (forward or backward)
function SpansWord as u8
  Ok = 0
  Hit = 0
  if WList[Wi].Len = SpanN then
    LoadWord(Wi)
    Ok = 1
    Hit = 1
    V = SpanN - 1
    for Si = 0 to V
      K = SpanLet[Si]
      if K <> WBuf[Si + 1] then Ok = 0
      J = SpanN - Si
      if K <> WBuf[J] then Hit = 0
    next
  end if
  return Ok | Hit

sub TryWord:
  W = 255
  if SpanN >= 3 then
    V = NW - 1
    for Qi = 0 to V
      Wi = Qi
      if W = 255 then
        if SpansWord = 1 then W = Qi
      end if
    next
  end if
  if W = 255 then
    TryFailed(0)
  elseif WList[W].Found = 1 then
    TryFailed(1)
  else
    Wi = W
    WList[Wi].Found = 1
    inc NFound
    FoundB += 1
    ' the line turns green and stays
    Cx = SelX
    Cy = SelY
    V = SpanN - 1
    for Si = 0 to V
      K = LFound + SpanLet[Si]
      put char K at Cx + 2, Cy + 1
      Cx += StX
      Cy += StY
    next
    SpanN = 0
    Sel = 0
    ListWord
    ShowHud
    play sound SndFound
    if NFound = NW then Mode = 4
  end if
  return
end sub

sub TryFailed(u8 Why):
  Lock = LockN
  fill 32 count 28 at 2,22
  select case Why
  case 0
    print at 2,22, "WRONG"
    play sound SndWrong
  case else
    print at 2,22, "THAT'S FOUND"
    play sound SndBuzz
  end select
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0: the box on cell CurX, CurY
sub DrawCursor:
  if Mode <> 2 then
    set sprite 0 to 192,0,0,0
  else
    X = CurX + 2
    X = X * 8
    Y = CurY + 1
    Y = Y * 8 - 1
    set sprite 0 to Y,X,SCur,13
  end if
  update sprites
  return
end sub

sub ShowClock:
  if Limit > 0 then
    NumU = Limit - Secs
  else
    NumU = Secs
  end if
  W = NumU / 60
  K = NumU mod 60
  NumU = W
  print at 24,21, digits$(NumU, 2)
  print at 26,21, ":"
  NumU = K
  print at 27,21, digits$(NumU, 2)
  return
end sub

sub ShowHud:
  fill 32 count 28 at 2,21
  print at 2,21, "FOUND"
  print FoundB at 8,21
  print at 10,21, "/"
  NumU = NW
  print at 11,21, digits$(NumU, 2)
  if Limit > 0 then
    print at 18,21, "LEFT"
  else
    print at 18,21, "TIME"
  end if
  ShowClock
  return
end sub

sub ShowTheme:
  fill 32 count 28 at 2,22
  print at 2,22, "LIST:"
  PrintTheme(8, 22)
  return
end sub

sub PrintTheme(u8 Px, u8 Py):
  select case Theme
  case 0
    print at Px,Py, "ANIMALS "
  case 1
    print at Px,Py, "FOOD    "
  case 2
    print at Px,Py, "SPORTS  "
  case 3
    print at Px,Py, "SPACE   "
  case else
    print at Px,Py, "COMPUTER"
  end select
  return
end sub

' won (Mode 4) or out of time (Mode 5)
sub EndScreen:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  if Mode = 4 then
    play sound SndDone
    print at 2,21, "YOU DID IT!!  TIME"
    NumU = Secs
    W = NumU / 60
    K = NumU mod 60
    NumU = W
    print at 21,21, digits$(NumU, 2)
    print at 23,21, ":"
    NumU = K
    print at 24,21, digits$(NumU, 2)
    if Limit > 0 then
      print at 2,22, "IN TIME! PRESS A BUTTON"
    else
      print at 2,22, "PRESS A BUTTON"
    end if
  else
    play sound SndTimeUp
    RestoreSpan
    ' every word not found, in red
    V = NW - 1
    for Wi = 0 to V
      if WList[Wi].Found = 0 then
        Cx = WList[Wi].X
        Cy = WList[Wi].Y
        K = WList[Wi].D
        W = WList[Wi].Len - 1
        for Ti = 0 to W
          ' a letter shared with a found word stays green
          C = get char at Cx + 2, Cy + 1
          if C < LFound or C >= LSel then
            C = LMiss + WLetter(Wi, Ti)
            put char C at Cx + 2, Cy + 1
          end if
          Cx += DirX[K]
          Cy += DirY[K]
        next
      end if
    next
    print at 2,21, "YOU DIDN'T FINISH IN TIME."
    print at 2,22, "FOUND"
    print FoundB at 8,22
    print at 10,22, "/"
    NumU = NW
    print at 11,22, digits$(NumU, 2)
    print at 14,22, "PRESS A BUTTON"
  end if
  return
end sub

' ---------------------------------------------------------------------------
' screens

' a little grid from Tab (letter + 26 x look), Gw wide, at Gx, Gy
sub DrawMini(u8 Gx, u8 Gy, u8 Gw, u8 Gh, u8 Which):
  K = 0
  for Ri = 1 to Gh
    for Si = 1 to Gw
      select case Which
      case 0
        C = TitleGrid[K]
      case 1
        C = HowGrid1[K]
      case else
        C = HowGrid2[K]
      end select
      C = C + LNorm
      X = Gx + Si - 1
      Y = Gy + Ri - 1
      put char C at X, Y
      inc K
    next
  next
  return
end sub

' the setup: up/down choose a line, left/right change it, a button starts
sub SetupPage:
  Menu = 0
  NewScreen
  print at 10,2, "WORD FIND"
  print at 4,5, "LIST"
  print at 4,7, "WORDS"
  print at 4,9, "TIME LIMIT"
  print at 4,13, "START"
  print at 3,16, "WORDS RUN IN 8 DIRECTIONS"
  print at 3,17, "IN A 20 X 20 GRID."
  ShowSetup
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  WasStick = 15
  Rep = 0
su_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 15
  Go = 0
  if V = 0 then
    Rep = 0
  elseif WasStick <> V then
    Go = 1
    Rep = 20
  else
    dec Rep
    if Rep = 0 then
      Go = 1
      Rep = 5
    end if
  end if
  WasStick = V
  if Go = 1 then
    if V & 1 then
      if Menu > 0 then dec Menu
    elseif V & 2 then
      if Menu < 3 then inc Menu
    elseif Menu = 0 then
      if V & 4 then
        Theme = Theme + NThemes - 1
      else
        inc Theme
      end if
      Theme = Theme mod NThemes
    elseif Menu = 1 then
      if V & 4 then
        if NW > 5 then dec NW
      else
        if NW < MaxW then inc NW
      end if
    elseif Menu = 2 then
      if V & 4 then
        if TMin > 0 then dec TMin
      else
        if TMin < 59 then inc TMin
      end if
    end if
    play sound SndStep
    ShowSetup
  end if
  if Press1 = 0 and Press2 = 0 then goto su_loop
  if Menu < 3 then
    Menu = 3
    ShowSetup
    goto su_loop
  end if
  play sound SndMark
  return
end sub

sub ShowSetup:
  put char 32 at 2,5
  put char 32 at 2,7
  put char 32 at 2,9
  put char 32 at 2,13
  J = Menu * 2 + 5
  if Menu = 3 then J = 13
  put char 62 at 2,J
  print at 15,5, "<"
  PrintTheme(17, 5)
  print at 26,5, ">"
  print at 15,7, "<"
  NumU = NW
  print at 17,7, digits$(NumU, 2)
  print at 20,7, ">"
  print at 15,9, "<"
  if TMin = 0 then
    print at 17,9, "OFF   "
  else
    NumU = TMin
    print at 17,9, digits$(NumU, 2)
    print at 19,9, " MIN"
  end if
  print at 24,9, ">"
  return
end sub

' the title: a little word search spelling the name, the menu, the tune once
sub TitlePage:
  Menu = 0
  TitleOn = 1
  Mode = 0
  NewScreen
  DrawMini(10, 3, 12, 5, 0)
  print at 11,10, "WORD FIND"
  print at 7,12, "COMPUTE!S GAZETTE"
  print at 9,13, "DECEMBER 1987"
  print at 11,16, "START GAME"
  print at 11,17, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
tp_loop:
  Frame1
  ReadPad
  Rnd
  V = Jy & 3
  if V > 0 then
    if WasStick = 0 then
      if V & 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press1 = 0 and Press2 = 0 then goto tp_loop
  mute all
  TzOn = 0
  TitleOn = 0
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,16
  put char 32 at 9,17
  put char 32 at 9,18
  J = Menu + 16
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: two pages with a little grid; a button turns the page, 30 s
' idle goes back
u8 HPg = 0
u16 HWt = 0
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "WORDS ARE HIDDEN IN A GRID"
    print at 2,4, "OF LETTERS. THEY RUN ACROSS,"
    print at 2,5, "DOWN OR DIAGONALLY, FORWARD"
    print at 2,6, "OR BACKWARD. THE LIST OF"
    print at 2,7, "WORDS IS BESIDE THE GRID."
    print at 2,9, "FIND THEM ALL TO WIN. FOUND"
    print at 2,10, "WORDS TURN GREEN."
    DrawMini(6, 13, 7, 5, 1)
    print at 15,13, "OWL"
    print at 15,14, "LION"
    print at 15,15, "BEAR"
    put char LFound + 14 at 15,13
    put char LFound + 22 at 16,13
    put char LFound + 11 at 17,13
    put char LFound + 11 at 15,14
    put char LFound + 8 at 16,14
    put char LFound + 14 at 17,14
    put char LFound + 13 at 18,14
  else
    print at 2,3, "STICK: MOVE THE BOX."
    print at 2,4, "LEFT BUTTON ON THE FIRST"
    print at 2,5, "LETTER, THEN ON THE LAST."
    print at 2,6, "RIGHT BUTTON: LET GO."
    print at 2,7, "A WRONG TRY STOPS YOU FOR"
    print at 2,8, "A SECOND. TIME LIMIT (1-59"
    print at 2,9, "MINUTES) OR NONE: CHOOSE IT"
    print at 2,10, "BEFORE THE GAME."
    print at 2,11, "TIP: LOOK FOR RARE LETTERS."
    DrawMini(6, 13, 7, 5, 2)
    print at 15,15, "BEAR"
    ' the box on the R of BEAR (cell 6, 3: column 12, row 16)
    set sprite 0 to 127,96,SCur,13
  end if
  print at 8,21, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  HWt = 0
ht_loop:
  Frame1
  ReadPad
  inc HWt
  if HWt >= 1800 then
    HideSprites
    return
  end if
  if Press1 = 0 and Press2 = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B4
  backdrop dark blue
  print at 10,2, "WORD FIND"
  print at 2,5, "BASED ON WORD FIND,"
  print at 2,6, "COMPUTE!S GAZETTE,"
  print at 2,7, "DECEMBER 1987"
  print at 2,8, "(COMMODORE 64 AND 128,"
  print at 2,9, "BASIC)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND WORD LISTS BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: LETTER HUNT"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      mute all
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Jy = J1 | J2
  Press1 = 0
  Press2 = 0
  V = Jy & 16
  if V > 0 and WasB1 = 0 then Press1 = 1
  WasB1 = V
  V = Jy & 32
  if V > 0 and WasB2 = 0 then Press2 = 1
  WasB2 = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  backdrop black
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  copy TileCol count NTiles8 to vram.color + 3072
  copy TileCol count NTiles8 to vram.color + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

