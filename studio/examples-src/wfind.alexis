' the eight directions (C64 DATA order); 255 is one step back (u8 wraps)
data DirX bytes = 0,1,1,1,0,255,255,255
data DirY bytes = 255,255,0,1,1,1,0,255

record Hidden:
  u8 Num
  u8 Len
  u8 X
  u8 Y
  u8 D
  u8 Found
end record

Hidden WList[20]
Hidden SwapW
u8 Used[24]
u8 SpanSave[20]
u8 SpanLet[20]
u8 WBuf[8]
' setup
u8 Theme = 0
u8 NW = 15
u8 TMin = 0
' play
u8 CurX = 10
u8 CurY = 10
u8 Sel = 0
u8 SelX = 0
u8 SelY = 0
u8 SpanN = 0
u8 StX = 0
u8 StY = 0
i8 DdX = 0
i8 DdY = 0
u8 AdX = 0
u8 AdY = 0
u8 Lock = 0
u8 Mode = 0
u8 NFound = 0
