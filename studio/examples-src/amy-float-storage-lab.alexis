' FP5 storage lab: zero-init and fp5-to-fp5 copy before arithmetic exists.
fp5 A = 0
fp5 B = 0
u8 ABytes[5] = 0
u8 BBytes[5] = 0

  text screen
  print at 7,0, "FP5 STORAGE LAB"
  print at 1,1, "RAW BYTES      B4  B3  B2  B1  B0"

  B = A
  copy bytes of A to ABytes
  copy bytes of B to BBytes

  print at 1,4, "A = 0"
  print ABytes[4] at 11,4 digits 3
  print ABytes[3] at 15,4 digits 3
  print ABytes[2] at 19,4 digits 3
  print ABytes[1] at 23,4 digits 3
  print ABytes[0] at 27,4 digits 3

  print at 1,7, "B = A"
  print BBytes[4] at 11,7 digits 3
  print BBytes[3] at 15,7 digits 3
  print BBytes[2] at 19,7 digits 3
  print BBytes[1] at 23,7 digits 3
  print BBytes[0] at 27,7 digits 3

  print at 1,10, "EXPECT ALL ZERO"
  screen on