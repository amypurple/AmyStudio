asm {
StepNoise:    ; SOUND(10,-3,2) periodic noise
    db $00,$00,$12,$01,$10
StepToneSfx:  ; SOUND(10,200,2)
    db $40,$2F,$12,$01,$50
CrashNoise:   ; SOUND(-50,-7,2) white noise
    db $00,$00,$16,$03,$10
WhistleLong:  ; SOUND(80,5000-T*40,2), T = 1 onward
    db $40,$17,$10,$05,$40,$17,$10,$05,$40,$17,$10,$05,$40,$17,$10,$05,$40,$17,$10,$05,$40,$18,$10,$05
    db $40,$18,$10,$05,$40,$18,$10,$05,$40,$18,$10,$05,$40,$18,$10,$05,$40,$19,$10,$05,$40,$19,$10,$05
