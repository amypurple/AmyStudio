cartridge "CRAZY CLIMBER/PRESENTS TED REYNOLDS'/1983"

' CRAZY CLIMBER
' Original VIC game by Ted Reynolds, COMPUTE! magazine, Issue 42 (Vol. 5,
' No. 11), November 1983, page 80, where it was the cover story ("Climber:
' A Fast-paced Game For VIC-20, TI-99/4A, And Commodore 64"); the cover
' shows the climber clinging to a brick wall while a hand pushes a
' flowerpot off a window ledge. Also a 64 version by Ted Reynolds. This port
' follows "Program 4: Crazy Climber For The TI-99/4A", Extended BASIC
' version by Pat Parrish, Programming Supervisor.
' All game design credit belongs to Ted Reynolds and Pat Parrish.
'
' Historical context (summary of the TI-99/4A version notes):
' You scramble up the face of a building while a relentless, sinister
' fellow appears briefly at the windows and hurls a piano, an iron, a broom,
' a safe or barbells down at you; nobody knows why, it is a quirk. He strikes
' more often as the game goes on. Crossing the top of the screen earns 100
' points, crossing the bottom costs 100, and each object thrown is worth 10.
' You may climb over windows, but if the villain appears while you are in
' one, he pushes you out. Luckily the climber carries a parachute. The TI
' version said "UH OH" through the TI Speech Synthesizer.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: joystick (replaces the E, S, D and X keys).
' XB sprite motion (velocity v = v/16 pixel per frame) is reproduced in 8.8
' fixed point; CALL COINC(ALL) becomes the VDP coincidence flag.
' Speech: "uh-oh" was made with a small formant synthesizer (two vowels,
' glottal stop, falling pitch) and encoded as Amy VoxPCM, so every
' ColecoVision says it, with or without a voice module.
' Adaptation liberties: wall and window tiles moved off the ASCII range;
' the climber stays in columns 3-25 (the TI let him reach column 1, inside
' the CRT overscan); falling objects tumble; the parachute sways; the
' villain stays at the window for 8 frames; two editorial pages at power-on.
' TI rows/columns are 1-based. Tiles: Amy X = col - 1, Y = row - 1.
' Sprites: TI dot-row R, dot-column C become Y = R - 2, X = C - 1.

const BrickA = 144            ' TI char 120 "x"
const BrickB = 145            ' TI char 121 "y"
const WindowTile = 152        ' TI char 100
const ObjSlot = 0             ' TI #1
const ClimbSlot = 1           ' TI #2
const ChuteSlot = 2           ' TI #3
const ManSlot = 3             ' TI #4
const ManPat = 0
const ChutePat = 4
const FallPat = 8
const ClimbPatA = 12
const ClimbPatB = 16
const ObjPatBase = 20
const TickFrames = 6          ' about one XB main-loop pass

' Sound table slots
const SndStepNoise = 1
const SndStepTone = 2
const SndCrash = 3
const SndWhistle = 4
const SndWhistleShort = 5

u8 Row = 13                   ' ROW
u8 Col = 15                   ' COL
u8 ClimbPat = ClimbPatA       ' B
bool StepTone = false         ' Z
i16 Score = 0                 ' SC
i16 HighScore = 0             ' HS
u8 Chance = 10                ' U, in percent per pass
bool ObjOn = false            ' Q
u8 ManTimer = 0               ' R
u8 Win = 0                    ' V
u8 ObjKind = 0
u8 ObjColor = 0
u8 ObjX = 0
u16 ObjY16 = 0
u8 Tumble = 0
u8 TumbleTick = 0
u8 Tick = 0
bool Demo = false             ' TP
u16 ClimbY16 = 0
u16 ChuteY16 = 0
u8 Sway = 0
u8 SwayTick = 0
u8 X = 0
u8 Y = 0
u8 N = 0
u8 I = 0
u8 Choice = 0
i16 Mag = 0
u16 MagU = 0
u16 Tmp16 = 0

  text screen
  nmi off
  set sound table ClimberSoundTable areas 2
  sprites 16x16
  sprites double
  copy SpritePatterns count 800 to vram.spr_pat
  copy BrickPatterns count 16 to vram.pattern + 1152
  fill 0 count 8 to vram.pattern + 1216
  set text colors black count 32
  HideAll
  screen on
  EditorialPage
  ' --- Line 160 ---
  TitlePage

new_game:
  ' --- Lines 170-190 ---
  DrawWall
  Chance = 10
  ObjOn = false
  ManTimer = 0
  Score = 0
  ClimbPat = ClimbPatA
  StepTone = false
  Row = 13
  Col = 15
  Tick = 0
  DrawClimber

main_loop:
  ' --- Lines 200-310 ---
  wait
  if ObjOn then MoveObject
  if ManTimer > 0 then
    dec ManTimer
    ' Line 200: the villain throws and leaves; 10 points per object
    if ManTimer = 0 then ThrowObject
  end if
  inc Tick
  if Tick >= TickFrames then
    Tick = 0
    ' Line 210: the villain appears at a random window
    if not ObjOn then
      if ManTimer = 0 then
        N = random(0, 99)
        if N < Chance then ShowVillain
      end if
    end if
    ' Lines 220-280
    ReadStick
  end if
  update sprites
  ' Line 290: CALL COINC(ALL)
  if any collision goto knocked_off
  goto main_loop

knocked_off:
  ' --- Lines 320-400 ---
  Demo = false
  FallWithParachute
  ' --- Lines 410-470 ---
  HideAll
  wait 30 frames
  cls
  backdrop 13
  if Score > HighScore then HighScore = Score
  print at 6,9, "YOUR SCORE : "
  Mag = Score
  X = 19
  Y = 9
  PutScore
  print at 6,12, "HIGH SCORE : "
  Mag = HighScore
  Y = 12
  PutScore
  print at 6,15, "PLAY AGAIN ?"
  print at 6,17, "FIRE OR 1 = YES  2 = NO"
  wait no fire
again_wait:
  wait
  if joypad(1).fire then goto new_game
  Choice = keypad(1)
  if Choice = 1 then goto new_game
  if Choice <> 2 then goto again_wait
  cls
  print at 8,11, "THANKS FOR PLAYING"
  loop forever

' ---------------------------------------------------------------------------

' Lines 220-280: one step per pass while the stick is held
sub ReadStick:
  if joypad(1).up then
    if Row = 0 then
      Row = 23
      Score += 100
      if Chance < 100 then Chance += 5
    else
      dec Row
    end if
    goto stepped
  end if
  if joypad(1).left then
    if Col > 3 then Col -= 2
    goto stepped
  end if
  if joypad(1).right then
    if Col < 25 then Col += 2
    goto stepped
  end if
  if joypad(1).down then
    if Row = 23 then
      Row = 0
      Score -= 100
    else
      inc Row
    end if
    goto stepped
  end if
  return
stepped:
  ' Line 280: alternate the two climbing frames and the two step sounds
  if ClimbPat = ClimbPatA then
    ClimbPat = ClimbPatB
  else
    ClimbPat = ClimbPatA
  end if
  toggle StepTone
  if StepTone then
    play sound SndStepTone
  else
    play sound SndStepNoise
  end if
  DrawClimber
  return
end sub

sub DrawClimber:
  Y = Row << 3
  dec Y
  X = Col << 3
  set sprite ClimbSlot to Y,X,ClimbPat,1
  return
end sub

' Line 130
sub ShowVillain:
  Win = random(0, 7)
  Y = WinRow[Win]
  Y <<= 3
  dec Y
  X = WinCol[Win]
  X <<= 3
  set sprite ManSlot to Y,X,ManPat,1
  ManTimer = 8
  return
end sub

' Line 200: a random object, a random color, motion 15 down
sub ThrowObject:
  hide sprite ManSlot
  ObjKind = random(0, 4)
  ObjColor = random(2, 15)
  Y = WinRow[Win] + 4
  Y <<= 3
  inc Y
  ObjY16 = Y
  ObjY16 <<= 8
  ObjX = WinCol[Win]
  ObjX <<= 3
  Tumble = 0
  TumbleTick = 0
  ObjOn = true
  Score += 10
  DrawObject
  return
end sub

' Lines 300-310, plus the tumbling (adaptation)
sub MoveObject:
  ObjY16 += 240
  inc TumbleTick
  if TumbleTick >= 6 then
    TumbleTick = 0
    inc Tumble
    if Tumble = 4 then Tumble = 0
  end if
  Tmp16 = ObjY16 >> 8
  Y = Tmp16
  if Y >= 180 then
    hide sprite ObjSlot
    ObjOn = false
    return
  end if
  DrawObject
  return
end sub

sub DrawObject:
  Tmp16 = ObjY16 >> 8
  Y = Tmp16
  Y -= 2
  N = ObjKind << 4
  I = Tumble << 2
  N += I
  N += ObjPatBase
  set sprite ObjSlot to Y,ObjX,N,ObjColor
  return
end sub

' Lines 320-390: "UH OH", the fall, the parachute, the whistle
sub FallWithParachute:
  hide sprite ObjSlot
  hide sprite ManSlot
  update sprites
  play voxpcm UhOhVoice
  ' Line 340: motion 25 down, then 10
  ClimbY16 = Row << 3
  inc ClimbY16
  ClimbY16 <<= 8
  for I = 1 to 24
    ClimbY16 += 400
    DrawFalling
    wait
    update sprites
  next
  ' Line 350: the parachute opens two rows below where he was
  play sound SndCrash
  ChuteY16 = Row + 2
  ChuteY16 <<= 3
  inc ChuteY16
  ChuteY16 <<= 8
  if Demo then
    play sound SndWhistleShort
  else
    play sound SndWhistle
  end if
  Sway = 0
  SwayTick = 0
chute_loop:
  ClimbY16 += 160
  ChuteY16 += 160
  inc SwayTick
  if SwayTick >= 16 then
    SwayTick = 0
    toggle Sway
  end if
  DrawFalling
  Tmp16 = ChuteY16 >> 8
  Y = Tmp16
  if Y > 165 then goto landed
  Y -= 2
  X = Col << 3
  X += Sway
  set sprite ChuteSlot to Y,X,ChutePat,15
  wait
  update sprites
  goto chute_loop
landed:
  mute all
  hide sprite ClimbSlot
  hide sprite ChuteSlot
  update sprites
  return
end sub

sub DrawFalling:
  Tmp16 = ClimbY16 >> 8
  Y = Tmp16
  if Y >= 196 then
    hide sprite ClimbSlot
    return
  end if
  Y -= 2
  X = Col << 3
  X += Sway
  set sprite ClimbSlot to Y,X,FallPat,1
  return
end sub

' Lines 670-780: the wall appears all at once
sub DrawWall:
  HideAll
  set text colors transparent at 18 count 1
  set text colors transparent at 19 count 1
  cls
  backdrop black
  for Y = 0 to 23
    N = Y & 1
    if N = 0 then
      put BrickRowA count 28 at 2,Y
    else
      put BrickRowB count 28 at 2,Y
    end if
  next
  for Y = 2 to 5
    WindowRow
  next
  for Y = 18 to 21
    WindowRow
  next
  for Y = 10 to 13
    fill WindowTile count 4 at 9,Y
    fill WindowTile count 4 at 19,Y
  next
  set text colors gray on dark red at 18 count 1
  set text colors transparent on dark yellow at 19 count 1
  return
end sub

' Windows at columns 5, 15 and 25 (Amy X 4, 14, 24) on row Y
sub WindowRow:
  fill WindowTile count 4 at 4,Y
  fill WindowTile count 4 at 14,Y
  fill WindowTile count 4 at 24,Y
  return
end sub

' Lines 790-930: title, demo climb and fall, instructions
sub TitlePage:
  HideAll
  cls
  backdrop gray
  set text colors gray on gray at 18 count 1
  for Y = 6 to 23
    N = Y & 1
    if N = 0 then
      put BrickRowA count 12 at 2,Y
    else
      put BrickRowB count 12 at 2,Y
    end if
  next
  set text colors gray on dark red at 18 count 1
  print at 20,5, "T H E"
  print at 18,7, "C R A Z Y"
  print at 16,9, "C L I M B E R"
  wait 20 frames
  ClimbPat = ClimbPatB
  StepTone = true
  Row = 19
  Col = 6
title_climb:
  DrawClimber
  update sprites
  if StepTone then
    play sound SndStepTone
  else
    play sound SndStepNoise
  end if
  if ClimbPat = ClimbPatA then
    ClimbPat = ClimbPatB
  else
    ClimbPat = ClimbPatA
  end if
  toggle StepTone
  dec Row
  wait 9 frames
  if Row > 1 then goto title_climb
  ' Line 900: the demo fall
  Demo = true
  FallWithParachute
  Demo = false
  print at 14,15, "USE THE JOYSTICK"
  print at 14,16, "TO AVOID FALLING"
  print at 14,17, "OBJECTS."
  print at 17,19, "GOOD LUCK!"
  wait 180 frames
  HideAll
  return
end sub

sub HideAll:
  clear sprites
  set sprite count 4
  update sprites
  return
end sub

' Prints Mag with a sign and five digits at X,Y (the score can go negative)
sub PutScore:
  if Mag < 0 then
    Mag = 0 - Mag
    MagU = Mag
    print at X,Y, "-" + digits$(MagU, 5)
  else
    MagU = Mag
    print at X,Y, " " + digits$(MagU, 5)
  end if
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  backdrop white
  cls
  print at 9,1, "CRAZY CLIMBER"
  print at 8,3, "BY TED REYNOLDS"
  print at 4,4, "COMPUTE! NOVEMBER 1983"
  print at 2,6, "A VIC GAME, WITH VERSIONS"
  print at 2,7, "FOR THE 64 AND TI-99/4A."
  print at 2,9, "ON THE TI, PAT PARRISH ADDED"
  print at 2,10, "A SINISTER FELLOW WHO HURLS"
  print at 2,11, "A PIANO, AN IRON, A BROOM, A"
  print at 2,12, "SAFE OR BARBELLS FROM THE"
  print at 2,13, "WINDOWS. NO ONE KNOWS WHY;"
  print at 2,14, "IT'S A QUIRK."
  print at 2,16, "THE TI SAID UH OH WITH ITS"
  print at 2,17, "SPEECH SYNTHESIZER. HERE IT"
  print at 2,18, "IS SYNTHESIZED SPEECH PLAYED"
  print at 2,19, "BY THE SOUND CHIP ITSELF."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  cls
  print at 7,1, "THE COVER STORY"
  print at 4,3, "COMPUTE! ISSUE 42"
  print at 4,4, "VOL. 5, NO. 11, $2.50"
  print at 2,7, "CLIMBER WAS THE COVER GAME:"
  print at 2,8, "A FAST-PACED GAME FOR THE"
  print at 2,9, "VIC-20, TI-99/4A AND 64."
  print at 2,11, "THE COVER ART SHOWS THE"
  print at 2,12, "CLIMBER HANGING FROM A BRICK"
  print at 2,13, "WALL WHILE A HAND PUSHES A"
  print at 2,14, "FLOWERPOT OFF A LEDGE."
  print at 2,16, "ON THE VIC, FLOWERPOTS FALL"
  print at 2,17, "AND BIRDS ATTACK. THE TI"
  print at 2,18, "TRADED THEM FOR A VILLAIN"
  print at 2,19, "AT THE WINDOWS."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  return
end sub

' Lines 760-770: window rows D(V) and columns E(V)
