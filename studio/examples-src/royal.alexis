record Obj:
  u8 T
  u16 X
  u16 Y
  i16 Dx
  i16 Dy
  u8 X0
  u8 X1
  u8 Y0
  u8 Y1
  u8 W
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Score = 0
u16 NumU = 0
u16 Off = 0
u16 Va = 0
u8 Lives = 6
u8 Keys = 0
u8 Room = 9
u8 GState = 0
' the hero: Pxf/Pyf are 8.8 pixels (Px = left of the sprite, Py = the row
' of pixels under the feet), Mode 0 standing, 1 climbing, 2 in the air,
' 3 dying, 4 found the heir
u16 Pxf = 0
u16 Pyf = 0
i16 Vy = 0
i8 Hv = 0
u8 Px = 0
u8 Py = 0
u8 Mode = 0
u8 Face = 0
u8 Stride = 0
u8 StrideC = 0
u8 BeltC = 0
u8 BeltF = 0
u8 DeadT = 0
u8 BumpT = 0
u8 EnPx = 0
u8 EnPy = 0
u8 EnMode = 0
u8 FireT = 0
u8 AnimT = 0
u8 Moved = 0
u8 Gone[16]
Obj Ob[7]
u8 ObjBuf[70]
' input
u8 J = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Oi = 0
u8 Ri = 0
u8 Li = 0
u8 Ti = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cc = 0
u8 Cr = 0

  tile screen
  set sound table RrSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 1
  sprites flicker on
  set sprite count 10
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  GState = 1
  CreditsPage

title:
  TitlePage
  NewGame
  EnterRoom
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Mode < 3 then goto play_loop
  if Mode = 3 then
    DeathAnim
    if Lives = 0 then goto game_over
    Respawn
    goto play_loop
  end if

  ' found the heir
  GState = 4
  play sound SndWin
  print at 2,9, "                            "
  print at 2,10, "      CONGRATULATIONS!      "
  print at 2,11, "  YOU FOUND THE ROYAL HEIR  "
  print at 2,12, "                            "
  EndWait
  goto title

game_over:
  GState = 4
  HideSprites
  print at 2,10, "                            "
  print at 2,11, "         GAME  OVER         "
  print at 2,12, "                            "
  play sound SndOver
  EndWait
  goto title


sub EndWait:
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

sub NewGame:
  Score = 0
  Lives = 6
  Keys = 0
  Room = 9
  fill array Gone with 255
  Pxf = 67 * 256
  Pyf = 176 * 256
  Mode = 0
  Face = 0
  Vy = 0
  Hv = 0
  FireT = 0
  GState = 3
  return
end sub

' ---- rooms ----

sub EnterRoom:
  Px = highbyte Pxf
  Py = highbyte Pyf
  EnPx = Px
  EnPy = Py
  EnMode = Mode
  if EnMode = 2 then EnMode = 0
  DrawRoom
  LoadObjs
  DrawDoors
  ShowStatus
  DrawSprites
  ShowScreen
  return
end sub

sub Respawn:
  Pxf = EnPx * 256
  Pyf = EnPy * 256
  Mode = EnMode
  Vy = 0
  Hv = 0
  BeltC = 0
  Px = EnPx
  Py = EnPy
  NewScreen
  DrawRoom
  LoadObjs
  DrawDoors
  ShowStatus
  DrawSprites
  ShowScreen
  return
end sub

sub DrawRoom:
  NewScreen
  Off = Room * 588
  for Ri = 2 to 22
    Va = Ri * 32 + 2
    copy RoomMap + Off count 28 to vram.name + Va
    Off = Off + 28
  next
  return
end sub

sub LoadObjs:
  Off = Room * 70
  copy ObjTab + Off count 70 to ObjBuf
  for Oi = 0 to NObj - 1
    K = Oi * 10
    T = ObjBuf[K]
    V = 1 << Oi
    if (Gone[Room] & V) = 0 then T = 0
    Ob[Oi].T = T
    Ob[Oi].X = ObjBuf[K + 1] * 256
    Ob[Oi].Y = ObjBuf[K + 2] * 256
    Ob[Oi].Dx = SignOf(ObjBuf[K + 3]) * 8
    Ob[Oi].Dy = SignOf(ObjBuf[K + 4]) * 8
    Ob[Oi].X0 = ObjBuf[K + 5]
    Ob[Oi].X1 = ObjBuf[K + 6]
    Ob[Oi].Y0 = ObjBuf[K + 7]
    Ob[Oi].Y1 = ObjBuf[K + 8]
    Ob[Oi].W = ObjBuf[K + 9]
  next
  return
end sub

function SignOf(u8 B) as i16
  i16 R = 0
  R = B
  if B > 127 then R = R - 256
  return R

sub DrawDoors:
  for Oi = 0 to NObj - 1
    if Ob[Oi].T = 5 then
      X = highbyte Ob[Oi].X
      Y = highbyte Ob[Oi].Y
      N = Ob[Oi].Y1
      for Li = 1 to N
        put char TGate at X,Y
        inc Y
      next
    end if
  next
  return
end sub

' ---- the map ----

function CellAt(u8 Col, u8 Row) as u8
  u8 R = 0
  R = Row
  if R < 2 then return 32
  ' below the screen: the bottom row goes on (a ladder leads to the room below)
  if R > 22 then R = 22
  if Col < 2 then return 32
  if Col > 29 then return 32
  return get char at Col,R

' brick, belts and gates stop you and hold you up
function IsSolid(u8 Ch) as u8
  if Ch >= TBrick then
    if Ch <= TGate then return 1
  end if
  return 0

function IsLadder(u8 Ch) as u8
  if Ch >= TLad then
    if Ch <= TWider then return 1
  end if
  return 0

' you can stand on bricks, belts, gates and narrow ladders
function CanStand(u8 Ch) as u8
  if Ch >= TBrick then
    if Ch <= TLad then return 1
  end if
  return 0

' ---- one pass of play ----

sub PlayStep:
  inc FireT
  if FireT >= FireHalf * 2 then FireT = 0
  inc AnimT
  if BumpT > 0 then dec BumpT
  Moved = 0
  select case Mode
  case 0
    StepGround
  case 1
    StepClimb
  case 2
    StepAir
  end select
  if Mode < 3 then
    if Moved = 1 then
      inc StrideC
      if StrideC >= 8 then
        StrideC = 0
        Stride = Stride ^ 1
      end if
    end if
    MoveObjs
  end if
  return
end sub

sub StepGround:
  Px = highbyte Pxf
  Py = highbyte Pyf
  Cc = (Px + 8) >> 3
  Cr = Py >> 3
  C = CellAt(Cc, Cr)
  if C = 32 then
    ' walked off a ledge: straight down
    Mode = 2
    Vy = FallV
    Hv = 0
    play sound SndFall
    return
  end if
  if (J & 16) <> 0 then
    Mode = 2
    Vy = -JumpV
    Hv = 0
    if (J & 4) <> 0 then Hv = -1
    if (J & 8) <> 0 then Hv = 1
    play sound SndJump
    return
  end if
  if (J & 1) <> 0 then
    if TryClimb(Cr - 1) = 1 then return
  end if
  if (J & 2) <> 0 then
    if TryClimb(Cr) = 1 then return
  end if
  if (J & 4) <> 0 then
    Face = 1
    WalkBy(-WalkV)
  end if
  if (J & 8) <> 0 then
    Face = 0
    WalkBy(WalkV)
  end if
  ' belts carry you a pixel every third frame
  inc BeltC
  if BeltC >= 3 then
    BeltC = 0
    Px = highbyte Pxf
    Py = highbyte Pyf
    Cc = (Px + 8) >> 3
    Cr = Py >> 3
    C = CellAt(Cc, Cr)
    if C = TBeltl then WalkBy(-256)
    if C = TBeltr then WalkBy(256)
  end if
  Px = highbyte Pxf
  if Px < 16 then
    if (Room & 3) <> 0 then
      dec Room
      Pxf = 223 * 256
      EnterRoom
    else
      Pxf = 16 * 256
    end if
    return
  end if
  if Px > 224 then
    if (Room & 3) <> 3 then
      inc Room
      Pxf = 17 * 256
      EnterRoom
    else
      Pxf = 224 * 256
    end if
  end if
  return
end sub

' start climbing if the cell at the hero's middle on row R is a ladder
function TryClimb(u8 R) as u8
  Px = highbyte Pxf
  Cc = (Px + 8) >> 3
  C = CellAt(Cc, R)
  if IsLadder(C) = 0 then return 0
  Mode = 1
  ' centre on the ladder's column
  Px = Cc * 8 - 4
  Pxf = Px * 256
  return 1

' move sideways by D (8.8 pixels) unless a wall or a gate is in the way
sub WalkBy(i16 D):
  u16 Nx = 0
  u8 Lead = 0
  Nx = Pxf + D
  Lead = highbyte Nx
  if D < 0 then
    Lead = Lead + 3
  else
    Lead = Lead + 12
  end if
  Cc = Lead >> 3
  Py = highbyte Pyf
  Cr = (Py - 1) >> 3
  C = CellAt(Cc, Cr)
  if C = TGate then
    TryGate(Cc)
    return
  end if
  if IsSolid(C) = 1 then return
  Pxf = Nx
  Moved = 1
  return
end sub

sub TryGate(u8 Col):
  for Oi = 0 to NObj - 1
    if Ob[Oi].T = 5 then
      X = highbyte Ob[Oi].X
      if X = Col then
        if Keys > 0 then
          dec Keys
          Score += 100
          Ob[Oi].T = 0
          V = 1 << Oi
          Gone[Room] = Gone[Room] & (V ^ 255)
          Y = highbyte Ob[Oi].Y
          N = Ob[Oi].Y1
          for Li = 1 to N
            put char 32 at X,Y
            inc Y
          next
          play sound SndGate
          ShowStatus
        else
          if BumpT = 0 then
            play sound SndLocked
            BumpT = 20
          end if
        end if
      end if
    end if
  next
  return
end sub

sub StepClimb:
  Px = highbyte Pxf
  Cc = (Px + 8) >> 3
  if (J & 1) <> 0 then
    Pyf = Pyf - ClimbV
    Moved = 1
    Py = highbyte Pyf
    if Py < 28 then
      if Room < 12 then
        Room = Room + 4
        Pyf = 182 * 256
        EnterRoom
        return
      end if
      Pyf = 28 * 256
    end if
    Cr = (Py - 1) >> 3
    C = CellAt(Cc, Cr)
    if IsLadder(C) = 0 then
      ' off the top of the ladder
      Mode = 0
      Py = (Cr + 1) * 8
      Pyf = Py * 256
    end if
    return
  end if
  if (J & 2) <> 0 then
    Pyf = Pyf + ClimbV
    Moved = 1
    Py = highbyte Pyf
    if Py > 184 then
      if Room >= 4 then
        Room = Room - 4
        Pyf = 30 * 256
        EnterRoom
        return
      end if
      Pyf = 184 * 256
    end if
    Cr = Py >> 3
    C = CellAt(Cc, Cr)
    if IsLadder(C) = 0 then
      Mode = 0
      Py = Cr * 8
      Pyf = Py * 256
    end if
  end if
  return
end sub

sub StepAir:
  Vy = Vy + Grav
  Pyf = Pyf + Vy
  if Hv < 0 then WalkBy(-AirV)
  if Hv > 0 then WalkBy(AirV)
  Px = highbyte Pxf
  if Px < 16 then Pxf = 16 * 256
  if Px > 224 then Pxf = 224 * 256
  Py = highbyte Pyf
  if Py < 24 then
    Pyf = 24 * 256
    Py = 24
  end if
  if Py > 184 then
    ' fell out of the room
    Kill
    return
  end if
  if Vy > 0 then
    Px = highbyte Pxf
    Cc = (Px + 8) >> 3
    Cr = Py >> 3
    C = CellAt(Cc, Cr)
    if CanStand(C) = 1 then
      if Vy >= DeadV then
        Py = Cr * 8
        Pyf = Py * 256
        Kill
        return
      end if
      Mode = 0
      Vy = 0
      Py = Cr * 8
      Pyf = Py * 256
      play sound SndLand
    end if
  end if
  return
end sub

sub Kill:
  Mode = 3
  DeadT = 0
  play sound SndDie
  return
end sub

' ---- objects ----

sub MoveObjs:
  u16 P = 0
  u16 Lim = 0
  i16 D = 0
  u8 Ox = 0
  u8 Oy = 0
  for Oi = 0 to NObj - 1
    T = Ob[Oi].T
    if T > 0 and T <> 5 then
      if Ob[Oi].W = 1 then
        Walker(Oi)
      else
        D = Ob[Oi].Dx
        if D <> 0 then
          P = Ob[Oi].X + D
          Lim = Ob[Oi].X1 * 256
          if P > Lim then
            P = Lim
            Ob[Oi].Dx = -D
          end if
          Lim = Ob[Oi].X0 * 256
          if P < Lim then
            P = Lim
            Ob[Oi].Dx = -D
          end if
          Ob[Oi].X = P
        end if
        D = Ob[Oi].Dy
        if D <> 0 then
          P = Ob[Oi].Y + D
          Lim = Ob[Oi].Y1 * 256
          if P > Lim then
            P = Lim
            Ob[Oi].Dy = -D
          end if
          Lim = Ob[Oi].Y0 * 256
          if P < Lim then
            P = Lim
            Ob[Oi].Dy = -D
          end if
          Ob[Oi].Y = P
        end if
      end if
      Ox = highbyte Ob[Oi].X
      Oy = highbyte Ob[Oi].Y
      if Touch(Ox, Oy) = 1 then
        Effect(Oi)
        if Mode >= 3 then return
      end if
    end if
  next
  return
end sub

' a walker steps along its floor and turns at walls and edges
sub Walker(u8 I):
  u16 P = 0
  u8 Wx = 0
  u8 Wy = 0
  u8 Ahead = 0
  P = Ob[I].X + Ob[I].Dx
  Wx = highbyte P
  Wy = highbyte Ob[I].Y
  if Ob[I].Dx > 0 then
    Ahead = (Wx + 13) >> 3
  else
    Ahead = (Wx + 2) >> 3
  end if
  Cr = (Wy + 15) >> 3
  C = CellAt(Ahead, Cr)
  K = CellAt(Ahead, Cr + 1)
  if IsSolid(C) = 1 or CanStand(K) = 0 or Wx < 16 or Wx > 224 then
    Ob[I].Dx = -Ob[I].Dx
    return
  end if
  Ob[I].X = P
  return
end sub

' does the hero's box (x+4..x+11, feet-14..feet-1) meet the object at X,Y
' (box x+3..x+12, y+3..y+15)?
function Touch(u8 Ox, u8 Oy) as u8
  u8 Hx = 0
  u8 Hy = 0
  Hx = highbyte Pxf
  Hy = highbyte Pyf
  if Hx + 11 < Ox + 3 then return 0
  if Ox + 12 < Hx + 4 then return 0
  if Hy - 1 < Oy + 3 then return 0
  if Oy + 15 < Hy - 14 then return 0
  return 1

sub Effect(u8 I):
  select case Ob[I].T
  case 2
    Mode = 4
  case 4
    if FireT < FireHalf then Kill
  case 6
    if Keys < 9 then inc Keys
    Score += 50
    Collect(I)
    play sound SndKey
  case 7
    if Lives < 9 then inc Lives
    Score += 20
    Collect(I)
    play sound SndLife
  case 8
    Score += 5
    Collect(I)
    play sound SndFruit
  case 9
    Score += 10
    Collect(I)
    play sound SndFruit
  case 10
    Collect(I)
    Kill
  case 11
    Kill
  end select
  return
end sub

sub Collect(u8 I):
  Ob[I].T = 0
  V = 1 << I
  Gone[Room] = Gone[Room] & (V ^ 255)
  ShowStatus
  return
end sub

' ---- drawing ----

sub DrawSprites:
  u8 Sp = 0
  u8 Sc = 0
  u8 Sy = 0
  u8 Sx = 0
  Px = highbyte Pxf
  Py = highbyte Pyf
  Sy = Py - 17
  if Mode = 1 then
    Sp = SHeroC1T
    if ((Py >> 2) & 1) = 1 then Sp = SHeroC2T
  else
    Sp = SHeroR1T
    if Face = 1 then Sp = SHeroL1T
    if Stride = 1 then Sp = Sp + 8
    if Mode = 2 then Sp = Sp + 8
  end if
  if Mode = 3 then
    Sp = SSpark1
    if ((DeadT >> 3) & 1) = 1 then Sp = SSpark2
    set sprite 0 to Sy,Px,Sp,11
    set sprite 1 to 207,0,0,0
  else
    set sprite 0 to Sy,Px,Sp,9
    Sp = Sp + 4
    set sprite 1 to Sy,Px,Sp,4
  end if
  set sprite 9 to 207,0,0,0
  for Oi = 0 to NObj - 1
    N = Oi + 2
    T = Ob[Oi].T
    if T = 0 or T = 5 then
      set sprite N to 207,0,0,0
    else
      Sx = highbyte Ob[Oi].X
      Sy = highbyte Ob[Oi].Y
      Sy = Sy - 1
      Sp = OSpr[T]
      Sc = OCol[T]
      if T = 1 then
        if ((AnimT >> 5) & 1) = 1 then Sp = SDragon2
      end if
      if T = 4 then
        if FireT >= FireHalf then
          Sp = SFireLo
          Sc = 10
        end if
      end if
      set sprite N to Sy,Sx,Sp,Sc
      if T = 2 then set sprite 9 to Sy,Sx,SHeirT,11
    end if
  next
  update sprites
  return
end sub

sub DeathAnim:
  for Ti = 1 to 70
    DeadT = Ti
    Frame1
    DrawSprites
  next
  dec Lives
  ShowStatus
  return
end sub

sub ShowStatus:
  ' the C64 kept the score in tens and printed a fixed 0 after it
  print at 2,1, "SCORE " + digits$(Score, 4) + "0"
  NumU = Lives
  print at 14,1, "LIVES " + digits$(NumU, 1)
  NumU = Keys
  print at 23,1, "KEYS " + digits$(NumU, 1)
  return
end sub

sub ReadPad:
  J = 0
  if joypad(1).up or joypad(2).up then J = J | 1
  if joypad(1).down or joypad(2).down then J = J | 2
  if joypad(1).left or joypad(2).left then J = J | 4
  if joypad(1).right or joypad(2).right then J = J | 8
  if joypad(1).fire or joypad(2).fire then J = J | 16
  return
end sub

' ---- frame and screens ----

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  if (Tick & 3) = 0 then AnimBelts
  return
end sub

sub AnimBelts:
  inc BeltF
  BeltF = BeltF & 3
  Va = BeltF * 8
  copy BeltAnim + Va count 8 to vram.pattern + 1032
  copy BeltAnim + Va count 8 to vram.pattern + 3080
  copy BeltAnim + Va count 8 to vram.pattern + 5128
  Va = Va + 32
  copy BeltAnim + Va count 8 to vram.pattern + 1040
  copy BeltAnim + Va count 8 to vram.pattern + 3088
  copy BeltAnim + Va count 8 to vram.pattern + 5136
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 10
  for K = 0 to 9
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  GState = 2
  NewScreen
  for Ri = 0 to 10
    Off = Ri * 28
    Va = Ri * 32 + 66
    copy TitleMap + Off count 28 to vram.name + Va
  next
  print at 5,15, "FIND THE ROYAL HEIR,"
  print at 3,16, "LOST IN THE CASTLE OF 16"
  print at 4,17, "ROOMS. KEYS OPEN GATES."
  print at 3,18, "BEWARE THE MARSHMALLOWS!"
  print at 5,20, "PRESS THE BUTTON"
  set sprite 2 to 103,120,SHeirB,13
  set sprite 3 to 103,120,SHeirT,11
  set sprite 0 to 103,96,SHeroR1T,9
  set sprite 1 to 103,96,SHeroR1B,4
  put char TBrick at 11,14
  fill TBrick count 8 at 11,14
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  if (J & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Rearm
  wait no fire
  nmi off
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "ROYAL  RESCUE"
  print at 2,4, "BASED ON ROYAL RESCUE BY"
  print at 2,5, "LIGIA LATINO, COMPUTE!'S"
  print at 2,6, "GAZETTE, JANUARY 1990"
  print at 2,7, "(COMMODORE 64, MACHINE"
  print at 2,8, "LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: THE HEIR'S MARCH"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
RrJump:
    db $40,$1D,$31,$02,$40,$D6,$30,$02,$40,$AA,$40,$02,$40,$8F,$50,$02,$50
RrLand:
    db $00,$00,$55,$02,$00,$00,$86,$02,$10
RrFall:
    db $40,$8F,$40,$03,$40,$A0,$50,$03,$40,$B4,$50,$03,$40,$CA,$60,$03,$50
RrKey:
    db $40,$6B,$20,$03,$40,$55,$20,$03,$40,$47,$20,$03,$40,$35,$30,$06,$50
RrFruit:
    db $40,$55,$30,$02,$40,$40,$30,$03,$50
RrLife:
    db $40,$D6,$20,$04,$40,$AA,$20,$04,$40,$8F,$20,$04,$40,$6B,$20,$04,$40,$55,$30,$08,$50
RrGate:
    db $00,$00,$24,$04,$00,$00,$35,$04,$00,$00,$56,$06,$00,$00,$87,$06,$10
RrLocked:
    db $40,$FC,$31,$03,$40,$3B,$42,$04,$50
RrDie:
    db $40,$7F,$20,$04,$40,$AA,$20,$04,$40,$D6,$30,$04,$40,$FE,$30,$04,$40,$53,$41,$06,$40,$FC,$51,$0A
    db $50
RrWin:
    db $40,$D6,$20,$08,$40,$AA,$20,$08,$40,$8F,$20,$08,$40,$6B,$20,$10,$40,$8F,$20,$08,$40,$6B,$20,$18
    db $50
RrOver:
    db $40,$1D,$21,$0A,$40,$2E,$21,$0A,$40,$41,$21,$0A,$40,$AB,$31,$1E,$50

RrSoundTable:
    dw RrTuneMel,$702B
    dw RrTuneBass,$7035
    dw RrJump,$7049
    dw RrLand,$703F
    dw RrFall,$7049
    dw RrKey,$7049
    dw RrFruit,$7049
    dw RrLife,$7049
    dw RrGate,$703F
    dw RrLocked,$7049
    dw RrDie,$7049
    dw RrWin,$7049
    dw RrOver,$7049
; The Heir's March (original)
; Tiny Sound, 9 frames per step
RrTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$21,$01,$01,$1C,$21,$01,$24,$01,$23,$01,$21,$01
    db $20,$01,$1C,$01,$1D,$01,$01,$21,$26,$01,$24,$01,$23,$01,$1F,$01
    db $24,$01,$01,$01,$28,$01,$01,$24,$2B,$01,$28,$01,$26,$01,$23,$01
    db $1F,$01,$23,$01,$24,$01,$23,$01,$21,$01,$20,$01,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
RrTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$15,$01,$1C,$01,$15,$01,$1C,$01,$10,$01,$17,$01
    db $10,$01,$17,$01,$0E,$01,$15,$01,$0E,$01,$15,$01,$13,$01,$1A,$01
    db $18,$01,$13,$01,$18,$01,$13,$01,$18,$01,$13,$01,$13,$01,$1A,$01
    db $13,$01,$1A,$01,$11,$01,$18,$01,$10,$01,$17,$01,$15,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
