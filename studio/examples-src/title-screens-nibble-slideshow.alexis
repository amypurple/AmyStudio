cartridge "TITLE CODEC NIBBLE/AMY STUDIO/2026"

' Four ColecoVision homebrew title screens shown with one codec.
' Timing uses frame before/after upload picture ... with nmi.
' Wait one VBlank before timing; second upload is clean with NMI off.

u16 StartFrame = 0
u16 EndFrame = 0
u16 MazeFrames = 0
u16 JeepersFrames = 0
u16 SmurfFrames = 0
u16 StripFrames = 0

on vblank TitleCodecFrame

picture TitleMazeManiacNibble:
  pattern from "@project/maze-maniac.pattern.nibble" codec nibble
  color from "@project/maze-maniac.color.nibble" codec nibble
end picture

picture TitleJeepersCreepersNibble:
  pattern from "@project/jeepers-creepers.pattern.nibble" codec nibble
  color from "@project/jeepers-creepers.color.nibble" codec nibble
  name from "@project/jeepers-creepers.name.nibble" codec nibble
end picture

picture TitleSmurfChallengeNibble:
  pattern from "@project/smurf-challenge.pattern.nibble" codec nibble
  color from "@project/smurf-challenge.color.nibble" codec nibble
end picture

picture TitleStripPokerNibble:
  pattern from "@project/strip-poker.pattern.nibble" codec nibble
  color from "@project/strip-poker.color.nibble" codec nibble
end picture

  bitmap screen
  nmi on
  wait

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleMazeManiacNibble with nmi
  EndFrame = frame
  MazeFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleMazeManiacNibble
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleJeepersCreepersNibble with nmi
  EndFrame = frame
  JeepersFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleJeepersCreepersNibble
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleSmurfChallengeNibble with nmi
  EndFrame = frame
  SmurfFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleSmurfChallengeNibble
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleStripPokerNibble with nmi
  EndFrame = frame
  StripFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleStripPokerNibble
  nmi on
  screen on
  wait 120 frames

  text screen
  print centered at 2, "TITLE CODEC RESULTS"
  print centered at 4, "NIBBLE"
  print at 1,6, "IMG"
  print at 10,6, "FR"
  print at 15,6, "PAT"
  print at 23,6, "COL"
  print at 1,8, "MAZE"
  print MazeFrames at 10,8 digits 3
  print at 15,8, "2031"
  print at 23,8, "2004"
  print at 1,10, "JEEPERS"
  print JeepersFrames at 10,10 digits 3
  print at 15,10, "2783"
  print at 23,10, "734"
  print at 1,12, "SMURF"
  print SmurfFrames at 10,12 digits 3
  print at 15,12, "928"
  print at 23,12, "716"
  print at 1,14, "STRIP"
  print StripFrames at 10,14 digits 3
  print at 15,14, "3534"
  print at 23,14, "624"
  print centered at 17, "PAT/COL COMPRESSED BYTES"
  print centered at 20, "TIMED THEN CLEAN UPLOAD"
  print centered at 22, "DONE"
  screen on
done:
  goto done

sub TitleCodecFrame:
  return