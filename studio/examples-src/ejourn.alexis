' the sword (0 true, 1-3 false), its screen
u8 SwRm = 0
u8 SwA[4]
u8 SwB[4]
' the transporter
u8 WRm = 0
u8 WA = 0
u8 WB = 0
' monsters: fluffer screens and the four fluffers, brick monster, eyes,
' bobcat, thief, zombies, the screen of the yellow disease
u8 ERm[3]
u8 FA[4]
u8 FB[4]
u8 BRm = 0
u8 BX = 0
u8 BY = 0
u8 CRm = 0
u8 CX = 0
u8 CY = 0
u8 DRm = 0
u8 DX = 0
u8 DY = 0
u8 TRm = 0
u8 TX = 0
u8 TY = 0
u8 ZA[13]
u8 ZB[13]
u8 CuRm = 0
u8 Line[22]
u8 RBits[66]
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 InPlay = 0
' loop counters
u8 Ri = 0
u8 Ci = 0
u8 Mi = 0
' scratch
u8 A = 0
u8 B = 0
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Qa = 0
u8 Qb = 0
u8 Got = 0

  tile screen
  set sound table EjSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  InPlay = 0
  for Ci = 0 to 9
    Have[Ci] = 0
  next
title_menu:
  TitlePage
  if Menu = 3 then
    HowTo
    goto title_menu
  end if
  if Menu = 4 then
    CreditsPage
    goto title_menu
  end if
  if Menu = 2 then
    ItemsPage
    goto title_menu
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawHero
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  Rearm
  wait 30 frames
  nmi off
  for Ri = 7 to 15
    fill 32 count 22 at 3,Ri
  next
  if Over = 2 then
    print at 5,8, "CONGRATULATIONS!"
    print at 5,10, "YOU FOUND THE SWORD."
    print at 5,12, "THE KING'S WIZARD"
    print at 5,13, "THANKS YOU, BRAVE"
    print at 5,14, "KNIGHT."
    play sound SndWin
  else
    print at 5,8, "YOUR QUEST IS OVER."
    print at 5,10, "YOU HAVE FAILED TO"
    print at 5,11, "FIND THE SWORD."
    play sound SndOver
  end if
  print at 5,15, "PRESS A BUTTON"
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' helpers

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a random number 0 .. Lim-1
function Rn(u8 Lim) as u8
  u16 Q = 0
  Rand
  Q = Rs & 255
  Q = Q * Lim
  return highbyte Q

' a random screen that can be reached from the forest without treasures
function RandOpen as u8
  u8 Rr = 0
  u8 Fl = 0
  Fl = 0
  while Fl = 0
    Rr = Rn(40)
    Fl = RoomFl[Rr] & 16
  end while
  return Rr + 1

function CellAt(u8 Ca, u8 Cb) as u8
  return get char at Ca + 3, Cb + 1

sub PutCell(u8 Ca, u8 Cb, u8 Ct):
  put char Ct at Ca + 3, Cb + 1
  return
end sub

' the underlay: the room's background (terrain, doors, treasures, no
' actors) at $1C00 + 22 * row + column in spare VRAM; a cell an actor
' leaves gets its background back from there
function BgAddr(u8 Ca, u8 Cb) as u16
  u16 Ad = 0
  Ad = Cb
  Ad = Ad * 22
  Ad = Ad + Ca
  return Ad + $0400

sub SetBg(u8 Ca, u8 Cb, u8 Ct):
  u16 Ad = 0
  Ad = BgAddr(Ca, Cb)
  vpoke vram.name + Ad, Ct
  put char Ct at Ca + 3, Cb + 1
  return
end sub

sub BgBack(u8 Ca, u8 Cb):
  u16 Ad = 0
  u8 Ct = 0
  Ad = BgAddr(Ca, Cb)
  vpeek vram.name + Ad into Ct
  put char Ct at Ca + 3, Cb + 1
  return
end sub

sub SaveBg:
  u8 Sa = 0
  u8 Sb = 0
  u8 St = 0
  u16 Ad = 0
  for Sb = 0 to 21
    for Sa = 0 to 21
      St = get char at Sa + 3, Sb + 1
      Ad = BgAddr(Sa, Sb)
      vpoke vram.name + Ad, St
    next
  next
  return
end sub

' one step of a chaser towards the hero
function Near(u8 F, u8 Tg) as u8
  if F < Tg then return F + 1
  if F > Tg then return F - 1
  return F

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc MigT
  if MigT > 60000 then MigT = 60000
  ' the button: the cross freezes the monsters; held 1 s, the quest ends
  if Btn > 0 then
    if FireT < 255 then inc FireT
  else
    FireT = 0
  end if
  if Press = 1 then
    if Have[3] = 1 then
      FreezeAll
    end if
  end if
  if FireT >= 60 then
    if Have[3] = 0 then
      Over = 1
      return
    end if
  end if
  if Ph > 0 then
    select case Pd
    case 0
      dec Py
    case 1
      inc Px
    case 2
      inc Py
    case else
      dec Px
    end select
    dec Ph
  end if
  if Ph = 0 then TryMove
  if Over > 0 then return
  if SafeT > 0 then dec SafeT
  inc MonT
  if SafeT > 0 then MonT = 0
  if MonT >= MonN then
    MonT = 0
    if Frz = 0 then MoveMonsters
  end if
  if Over > 0 then return
  Shake
  return
end sub

sub FreezeAll:
  Have[3] = 0
  Frz = 1
  BRm = 200
  CRm = 200
  DRm = 200
  for Ci = 0 to 2
    ERm[Ci] = 200
  next
  ShowPanel
  play sound SndFreeze
  return
end sub

' the stick: one direction only (diagonals do nothing)
sub TryMove:
  K = J1 | J2
  K = K & 15
  Got = 255
  select case K
  case 1
    Got = 0
  case 2
    Got = 2
  case 4
    Got = 3
  case 8
    Got = 1
  end select
  if Got = 255 then return
  if Rev = 1 then Got = Got ^ 2
  Pd = Got
  Qa = Pa
  Qb = Pb
  select case Pd
  case 0
    if Qb = 0 then
      Qb = 21
      ' up: screen + 8, past 40 to screen 35
      V = Rm + 8
      if V > 40 then V = 35
      ChangeRoom
      return
    end if
    dec Qb
  case 1
    if Qa = 21 then
      Qa = 0
      V = Rm + 1
      if V = 41 then V = 1
      ChangeRoom
      return
    end if
    inc Qa
  case 2
    if Qb = 21 then
      Qb = 0
      V = 34
      if Rm > 8 then V = Rm - 8
      ChangeRoom
      return
    end if
    inc Qb
  case else
    if Qa = 0 then
      Qa = 21
      V = Rm - 1
      select case V
      case 0, 8, 16, 24, 32
        V = 33
      end select
      ChangeRoom
      return
    end if
    dec Qa
  end select
  EnterCell
  return
end sub

' the hero tries cell Qa, Qb of this screen
sub EnterCell:
  C = CellAt(Qa, Qb)
  Got = 1
  select case C
  case TBrick
    Got = Have[0]
  case TTree
    Got = Have[7]
    if Got = 1 then play sound SndChop
  case TTomb, TCross, TCrossl
    if IsCross = 0 then
      if Have[3] = 0 then
        Cause = 1
        Kill
        return
      end if
    end if
  case TQuest, TSword
    Got = 0
    if Qa = SwA[0] then
      if Qb = SwB[0] then Got = 1
    end if
    if Got = 1 then
      Over = 2
    else
      Cause = 2
      Kill
    end if
    return
  case TFluff, TBrickm, TPhant, TCatl, TCatr, TZomb
    if Frz = 0 then
      Cause = 3
      Kill
      return
    end if
  case TThief
    Steal
  case TTrans
    V = RandOpen
    play sound SndTele
    Qa = Pa
    Qb = Pb
    ChangeRoom
    return
  case TPort
    if Lk = 0 then
      Lk = 1
      V = Rn(10)
      Have[V] = 1
      play sound SndTele
      Qa = Pa
      Qb = Pb
      V = RandOpen
      ChangeRoom
      return
    end if
  end select
  if Got = 0 then
    play sound SndBump
    return
  end if
  Pa = Qa
  Pb = Qb
  Ph = StepN
  inc Moves
  select case C
  case TBrick, TTree, TTomb
    SetBg(Pa, Pb, 32)
  case TThief
    BgBack(Pa, Pb)
  end select
  play sound SndStep
  PickUp
  return
end sub

' 1 when Qa, Qb holds the cross itself
function IsCross as u8
  if Have[3] = 1 then return 0
  if IRm[3] <> Rm then return 0
  if IA[3] <> Qa then return 0
  if IB[3] <> Qb then return 0
  return 1

' treasures lie at a cell of a screen; stepping there takes them
sub PickUp:
  for Ci = 0 to 9
    if IRm[Ci] = Rm then
      if IA[Ci] = Pa then
        if IB[Ci] = Pb then
          Have[Ci] = 1
          IRm[Ci] = 0
          SetBg(Pa, Pb, 32)
          play sound SndPick
          ShowPanel
        end if
      end if
    end if
  next
  if WRm = Rm then
    if WA = Pa then
      if WB = Pb then
        V = RandOpen
        Qa = Pa
        Qb = Pb
        play sound SndTele
        ChangeRoom
      end if
    end if
  end if
  return
end sub

sub Steal:
  V = Rn(10)
  Have[V] = 0
  TRm = 0
  play sound SndSteal
  ShowPanel
  return
end sub

' leave for screen V at cell Qa, Qb (wandering monsters drift after 200
' frames); a wall there throws the hero to the forest (screen 33)
sub ChangeRoom:
  Rm2 = V
  if MigT >= 200 then
    MigT = 0
    Migrate
  end if
  Rm = Rm2
  Pa = Qa
  Pb = Qb
  Frz = 0
  DrawRoom
  if InWall = 1 then
    Rm = 33
    if Pb = 0 then Pb = 1
    DrawRoom
  end if
  PlaceHero
  SafeT = SafeN
  MonT = 0
  PickUp
  Globe
  return
end sub

function InWall as u8
  u8 Cw = 0
  Cw = CellAt(Pa, Pb)
  if Cw = TBrick then return 1
  return 0

sub Migrate:
  for Mi = 0 to 2
    V = ERm[Mi]
    if V < 100 then
      if V < Rm then inc V
      if V > Rm then dec V
      ERm[Mi] = V
    end if
  next
  if CRm < 100 then
    if CRm < Rm then
      CRm = CRm + 8
    elseif CRm > Rm then
      CRm = CRm - 8
    end if
  end if
  if BRm < 100 then
    if BRm > Rm then
      BRm = BRm - 7
    elseif BRm < Rm then
      BRm = BRm + 7
    end if
  end if
  if DRm < 100 then
    if DRm > Rm then
      DRm = DRm - 9
    elseif DRm < Rm then
      DRm = DRm + 9
    end if
  end if
  return
end sub

' the singing globe: highest on the sword's screen, high next to it,
' middle diagonally, low elsewhere; the globe of lies the other way round
sub Globe:
  if Have[2] = 0 then
    if Have[9] = 0 then return
  end if
  U = 3
  if Rm = SwRm then U = 0
  V = Rm - SwRm
  if SwRm > Rm then V = SwRm - Rm
  if V = 1 then U = 1
  if V = 8 then U = 1
  if V = 7 then U = 2
  if V = 9 then U = 2
  if Have[2] = 0 then
    if U > 0 then U = 4 - U
  end if
  select case U
  case 0
    play sound SndGlTop
  case 1
    play sound SndGlHi
  case 2
    play sound SndGlMid
  case else
    play sound SndGlLo
  end select
  return
end sub

sub Kill:
  Busy = 1
  Died = 1
  play sound SndDie
  inc Deaths
  ' the hero stays, red, for a second
  Px = Pa * 8
  Px = Px + 24
  Py = Pb * 8
  Py = Py + 7
  set sprite 0 to Py,Px,SKnight0,8
  update sprites
  for Mi = 1 to 60
    Frame1
  next
  dec Lives
  if Lives = 0 then
    Over = 1
    ShowPanel
    Busy = 0
    return
  end if
  ' a new dream: the big monsters wander off, the disease is cured
  BRm = Rn(40) + 1
  CRm = Rn(40) + 1
  DRm = Rn(40) + 1
  Rev = 0
  NewScreen
  print at 8,10, "DREAMS LEFT"
  NumU = Lives
  print at 20,10, digits$(NumU, 1)
  ShowScreen
  for Mi = 1 to 90
    Frame1
  next
  V = RandOpen
  Qa = Pa
  Qb = Pb
  MigT = 0
  ChangeRoom
  Busy = 0
  return
end sub

' ---------------------------------------------------------------------------
' monsters (tiles, one cell a step)

sub MoveMonsters:
  Died = 0
  ' fluffers: one of the four steps
  for Mi = 0 to 2
    if ERm[Mi] = Rm then
      Ci = Rn(4)
      A = FA[Ci]
      B = FB[Ci]
      BgBack(A, B)
      A = Near(A, Pa)
      B = Near(B, Pb)
      FA[Ci] = A
      FB[Ci] = B
      PutCell(A, B, TFluff)
      Cause = 4
      HitAt
      if Died = 1 then return
    end if
  next
  if BRm = Rm then MoveBrickM
  if Died = 1 then return
  if CRm = Rm then MoveEyes
  if Died = 1 then return
  if DRm = Rm then MoveCat
  if Died = 1 then return
  if TRm = Rm then MoveThief
  T = RoomFl[Rm - 1] & 2
  if T > 0 then
    if Have[3] = 0 then MoveZombie
  end if
  return
end sub

' a monster now on A, B: the hero there dies
sub HitAt:
  if A = Pa then
    if B = Pb then
      Kill
    end if
  end if
  return
end sub

' the brick monster: across first, then up or down; trees and tombstones
' stop it; it leaves brick where it was
sub MoveBrickM:
  A = BX
  B = BY
  SetBg(A, B, TBrick)
  if A <> Pa then
    A = Near(A, Pa)
  else
    B = Near(B, Pb)
  end if
  C = CellAt(A, B)
  if C = TTree then
    A = BX
    B = BY
  end if
  if C = TTomb then
    A = BX
    B = BY
  end if
  BX = A
  BY = B
  PutCell(A, B, TBrickm)
  Cause = 5
  HitAt
  return
end sub

' the creeping eyes: diagonal steps, brick stops them, they eat the rest
sub MoveEyes:
  BgBack(CX, CY)
  A = Near(CX, Pa)
  B = Near(CY, Pb)
  C = CellAt(A, B)
  if C = TBrick then
    A = CX
    B = CY
  end if
  CX = A
  CY = B
  PutCell(A, B, TPhant)
  Cause = 6
  HitAt
  return
end sub

' the bobcat: two cells wide, always diagonal, passes everything
sub MoveCat:
  BgBack(DX, DY)
  T = DX - 1
  BgBack(T, DY)
  if DX < Pa then
    inc DX
  else
    dec DX
  end if
  if DY < Pb then
    inc DY
  else
    dec DY
  end if
  if DX < 1 then DX = 1
  if DX > 21 then DX = 21
  if DY > 21 then DY = 21
  A = DX
  B = DY
  PutCell(A, B, TCatr)
  T = A - 1
  PutCell(T, B, TCatl)
  Cause = 7
  HitAt
  if Died = 1 then return
  A = T
  Cause = 7
  HitAt
  return
end sub

' the blue thief: brick, trees and tombstones stop him; he steals one
' treasure and is gone
sub MoveThief:
  BgBack(TX, TY)
  A = Near(TX, Pa)
  B = Near(TY, Pb)
  C = CellAt(A, B)
  select case C
  case TBrick, TTree, TTomb
    A = TX
    B = TY
  end select
  TX = A
  TY = B
  if A = Pa then
    if B = Pb then
      Steal
      return
    end if
  end if
  PutCell(A, B, TThief)
  return
end sub

sub MoveZombie:
  Ci = Rn(13)
  A = ZA[Ci]
  B = ZB[Ci]
  BgBack(A, B)
  A = Near(A, Pa)
  B = Near(B, Pb)
  ZA[Ci] = A
  ZB[Ci] = B
  PutCell(A, B, TZomb)
  Cause = 8
  HitAt
  return
end sub

' the shaking rooms: a crack, then a brick falls there
sub Shake:
  T = RoomFl[Rm - 1] & 8
  if T = 0 then return
  inc ShkT
  if ShkT < ShkN then return
  ShkT = 0
  if ShA < 22 then
    SetBg(ShA, ShB, TBrick)
    play sound SndThud
    if ShA = Pa then
      if ShB = Pb then
        ShA = 255
        Cause = 9
        Kill
        return
      end if
    end if
  end if
  ShA = Rn(22)
  ShB = Rn(22)
  C = CellAt(ShA, ShB)
  if C = TDoor then
    ShA = 255
    return
  end if
  SetBg(ShA, ShB, TCrack)
  play sound SndRumble
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub PlaceHero:
  Px = Pa * 8
  Px = Px + 24
  Py = Pb * 8
  Py = Py + 7
  Ph = 0
  return
end sub

sub DrawHero:
  K = SKnight0
  V = Px + Py
  V = V & 4
  if V > 0 then K = SKnight1
  T = 15
  if Rev = 1 then T = 11
  set sprite 0 to Py,Px,K,T
  update sprites
  return
end sub

' a whole screen: walls, doors, trees, tombstones, treasures, monsters
sub DrawRoom:
  NewScreen
  ShA = 255
  ShkT = 0
  RmF = RoomFl[Rm - 1]
  Dark = RmF & 4
  if Have[8] = 1 then Dark = 0
  if Dark > 0 then
    backdrop black
  else
    U = RmF & 1
    if U > 0 then
      backdrop dark green
    else
      backdrop gray
    end if
  end if
  W16 = Rm - 1
  W16 = W16 * 66
  copy RoomBits + W16 count 66 to RBits
  for Ri = 0 to 21
    DrawWallRow
  next
  DrawDoors
  if Rm = 16 then
    if Lk = 0 then PutCell(21, 17, TPort)
  end if
  U = RmF & 1
  if U > 0 then
    N = Rn(30) + 30
    Scatter(N, TTree)
  end if
  U = RmF & 2
  if U > 0 then
    N = Rn(15) + 15
    Scatter(N, TTomb)
  end if
  DrawThings
  for Ri = 1 to 22
    put char TPillar at 25,Ri
  next
  ShowPanel
  ' darkness and the yellow disease colour every tile of the screen
  if Dark > 0 then
    fill $11 count 256 to vram.color + 1024
  end if
  if Rm = CuRm then
    Rev = 1
    fill $B0 count 256 to vram.color + 1024
    ShowPanel
  end if
  DrawHero
  ShowScreen
  return
end sub

sub DrawWallRow:
  V = Ri * 3
  for Ci = 0 to 21
    Line[Ci] = 32
  next
  for Mi = 0 to 2
    T = RBits[V]
    inc V
    U = Mi << 3
    for Ci = 0 to 7
      X = T & 1
      if X > 0 then
        X = U + Ci
        if X < 22 then Line[X] = TBrick
      end if
      T = T >> 1
    next
  next
  Y = Ri + 1
  put Line count 22 at 3,Y
  return
end sub

sub DrawDoors:
  V = Rm - 1
  V = V << 2
  for Mi = 0 to 3
    T = RoomDoor[V]
    inc V
    select case Mi
    case 0
      A = 10
      B = 0
    case 1
      A = 10
      B = 21
    case 2
      A = 0
      B = 10
    case else
      A = 21
      B = 10
    end select
    select case T
    case 1
      PutCell(A, B, TDoor)
    case 2
      if Have[1] = 1 then PutCell(A, B, TSecret)
    case 3
      if Have[5] = 1 then PutCell(A, B, THolep)
    case 4
      if Have[6] = 1 then PutCell(A, B, THoleb)
    end select
  next
  return
end sub

' N things of tile Tt on free floor cells (not the hero's)
sub Scatter(u8 Nn, u8 Tt):
  u8 Si = 0
  u8 Sa = 0
  u8 Sb = 0
  u8 Sc = 0
  for Si = 1 to Nn
    Sa = Rn(22)
    Sb = Rn(22)
    Sc = CellAt(Sa, Sb)
    if Sc = 32 then
      Sc = 1
      if Sa = Pa then
        if Sb = Pb then Sc = 0
      end if
      if Sc = 1 then PutCell(Sa, Sb, Tt)
    end if
  next
  return
end sub

sub DrawThings:
  ' treasures (lit by the wand of the way)
  for Ci = 0 to 9
    if IRm[Ci] = Rm then
      T = ItemT[Ci]
      if Have[4] = 1 then T = ItemLit[Ci]
      PutCell(IA[Ci], IB[Ci], T)
    end if
  next
  ' illusions, unless the wand of the way stops them
  if Have[4] = 0 then
    for Ci = 0 to 2
      if LRm[Ci] = Rm then
        T = IllT[Ci]
        PutCell(LA[Ci], LB[Ci], T)
      end if
    next
  end if
  if WRm = Rm then PutCell(WA, WB, TTrans)
  if SwRm = Rm then
    for Ci = 0 to 3
      T = TQuest
      if Ci = 0 then
        if Have[4] = 1 then T = TSword
      end if
      PutCell(SwA[Ci], SwB[Ci], T)
    next
  end if
  SaveBg
  ' monsters
  for Mi = 0 to 2
    if ERm[Mi] = Rm then
      for Ci = 0 to 3
        PutCell(FA[Ci], FB[Ci], TFluff)
      next
    end if
  next
  if BRm = Rm then PutCell(BX, BY, TBrickm)
  if CRm = Rm then PutCell(CX, CY, TPhant)
  if DRm = Rm then
    PutCell(DX, DY, TCatr)
    T = DX - 1
    PutCell(T, DY, TCatl)
  end if
  if TRm = Rm then PutCell(TX, TY, TThief)
  T = RoomFl[Rm - 1] & 2
  if T > 0 then
    for Ci = 0 to 12
      PutCell(ZA[Ci], ZB[Ci], TZomb)
    next
  end if
  return
end sub

' the panel: lives, the treasures carried, the disease, the dark
sub ShowPanel:
  print at 26,1, "LIFE"
  fill 32 count 4 at 26,2
  if Lives > 0 then fill THeart count Lives at 26,2
  print at 26,4, "HAVE"
  for Ci = 0 to 9
    X = Ci & 1
    X = X << 1
    X = X + 26
    Y = Ci >> 1
    Y = Y << 1
    Y = Y + 6
    T = 32
    if Have[Ci] = 1 then T = ItemT[Ci]
    put char T at X,Y
  next
  if Rev = 1 then
    print at 26,17, "SICK"
  else
    print at 26,17, "    "
  end if
  if Dark > 0 then
    print at 26,19, "DARK"
  else
    print at 26,19, "    "
  end if
  return
end sub

' ---------------------------------------------------------------------------
' a new quest

sub NewGame:
  Lives = 4
  Over = 0
  Rev = 0
  Lk = 0
  Frz = 0
  Deaths = 0
  MigT = 0
  ' treasures in screens reachable from the forest, cells 1-20
  for Ci = 0 to 9
    IRm[Ci] = RandOpen
    IA[Ci] = Rn(20) + 1
    IB[Ci] = Rn(20) + 1
    if Have[Ci] = 1 then IRm[Ci] = 0
  next
  for Ci = 0 to 2
    LRm[Ci] = Rn(40) + 1
    LA[Ci] = Rn(20) + 1
    LB[Ci] = Rn(20) + 1
    ERm[Ci] = Rn(40) + 1
  next
  SwRm = RandOpen
  for Ci = 0 to 3
    SwA[Ci] = Rn(20) + 1
    SwB[Ci] = Rn(20) + 1
    FA[Ci] = Rn(20) + 1
    FB[Ci] = FA[Ci]
  next
  WRm = Rn(40) + 1
  WA = Rn(20) + 1
  WB = Rn(20) + 1
  BRm = Rn(40) + 1
  BX = Rn(20) + 1
  BY = BX
  CRm = Rn(40) + 1
  CX = Rn(20) + 1
  CY = CX
  DRm = Rn(40) + 1
  DX = Rn(20) + 1
  DY = DX
  TRm = Rn(40) + 1
  TX = Rn(20) + 1
  TY = TX
  CuRm = Rn(40) + 1
  if CuRm = 33 then CuRm = 34
  for Ci = 0 to 12
    ZA[Ci] = Rn(20) + 1
    ZB[Ci] = ZA[Ci]
  next
  Pa = 9
  Pb = 9
  if Menu = 1 then
    V = RandOpen
  else
    V = 33
  end if
  InPlay = 1
  play sound SndStart
  Qa = Pa
  Qb = Pb
  ChangeRoom
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a menu: the stick moves the arrow (column 4) over rows Mtop.., a press
' chooses; returns the line
function MenuPick(u8 Mtop, u8 Mn, u8 Mstart) as u8
  u8 Ms = 0
  u8 Mr = 0
  Ms = Mstart
  Mr = Mtop + Ms
  put char 62 at 4,Mr
  Rearm
  wait no fire
  nmi off
  Press = 0
  while Press = 0
    Frame1
    inc Rs
    ReadPad
    V = J1 | J2
    V = V & 3
    if V > 0 then
      if WasStick = 0 then
        Mr = Mtop + Ms
        put char 32 at 4,Mr
        if V = 1 then
          if Ms > 0 then dec Ms
        else
          if Ms < Mn - 1 then inc Ms
        end if
        Mr = Mtop + Ms
        put char 62 at 4,Mr
      end if
    end if
    WasStick = V
  end while
  return Ms

sub TitlePage:
  NewScreen
  backdrop dark green
  for Ri = 1 to 22
    put char TTree at 2,Ri
    put char TTree at 29,Ri
  next
  fill TBrick count 26 at 3,1
  fill TBrick count 26 at 3,22
  put char TDoor at 15,22
  print at 5,3, "THE ENCHANTED JOURNEY"
  print at 7,5, "BY BRENT LACKIE"
  print at 6,6, "COMPUTE!'S GAZETTE"
  print at 10,7, "MAY 1985"
  print at 6,10, "START IN THE FOREST"
  print at 6,11, "START IN A ROOM"
  print at 6,12, "CHOOSE TREASURES"
  print at 6,13, "HOW TO PLAY"
  print at 6,14, "CREDITS"
  print at 5,16, "TREASURES CARRIED:"
  for Ci = 0 to 9
    T = 32
    if Have[Ci] = 1 then T = ItemT[Ci]
    X = Ci << 1
    X = X + 6
    put char T at X,18
  next
  ShowScreen
  if InPlay = 0 then
    if TzOn = 0 then
      play sound SndTuneA
      play sound SndTuneB
      TzLeft = 520
      TzOn = 1
    end if
  end if
  InPlay = 2
  Menu = MenuPick(10, 5, 0)
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' the treasure menu: 0 = a random one, 1-9 the treasures, then BACK
sub ItemsPage:
  NewScreen
  backdrop dark blue
  print at 9,1, "TREASURES"
  print at 6,3, "0 RANDOM"
  print at 6,4, "1 BOOTS"
  print at 6,5, "2 WAND OF SECRETS"
  print at 6,6, "3 SINGING GLOBE"
  print at 6,7, "4 HOLY CROSS"
  print at 6,8, "5 WAND OF THE WAY"
  print at 6,9, "6 PURPLE KEY"
  print at 6,10, "7 BLUE KEY"
  print at 6,11, "8 AXE"
  print at 6,12, "9 TORCH"
  print at 6,14, "BACK"
  print at 3,17, "A BUTTON TAKES ONE (OR"
  print at 3,18, "DROPS IT). TAKE AS MANY"
  print at 3,19, "AS YOU LIKE."
  ShowScreen
  Mi = 0
items_again:
  for Ci = 0 to 8
    T = 32
    if Have[Ci] = 1 then T = ItemT[Ci]
    Y = Ci + 4
    put char T at 25,Y
  next
  Mi = MenuPick(3, 12, Mi)
  if Mi = 11 then return
  if Mi = 10 then goto items_again
  if Mi = 0 then
    V = Rn(9)
    Have[V] = 1
    goto items_again
  end if
  V = Mi - 1
  T = Have[V] ^ 1
  Have[V] = T
  goto items_again
end sub

' HOW TO PLAY: three pages; a button turns the page, 30 s alone goes back
sub HowTo:
  NewScreen
  backdrop dark green
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "A THIEF HAS STOLEN THE"
  print at 2,4, "KING'S MAGIC SWORD AND HID"
  print at 2,5, "IT IN THE LAND OF DREAMS."
  print at 2,6, "FIND THE REAL SWORD!"
  put char TQuest at 8,8
  put char TQuest at 11,8
  put char TSword at 14,8
  put char TQuest at 17,8
  print at 2,10, "IT HIDES AMONG 3 FALSE"
  print at 2,11, "SWORDS (?). A FALSE ONE"
  print at 2,12, "KILLS YOU."
  print at 2,14, "STICK: WALK ONE SQUARE. NO"
  print at 2,15, "DIAGONALS. WALK OFF THE"
  print at 2,16, "EDGE TO THE NEXT SCREEN."
  fill TBrick count 5 at 8,18
  put char TDoor at 13,18
  fill TBrick count 5 at 14,18
  print at 2,19, "ENTER THE CASTLE BY DOORS."
  print at 2,21, "4 DREAMS (LIVES)."
  ShowScreen
  if HowWait = 1 then return
  NewScreen
  backdrop dark blue
  print at 4,1, "MAGIC ITEMS (MENU)"
  print at 2,2, "PICK THEM BEFORE YOU GO:"
  for Ci = 0 to 8
    Y = Ci << 1
    Y = Y + 4
    T = ItemT[Ci]
    put char T at 2,Y
  next
  print at 4,4, "BOOTS: WALK THROUGH BRICK"
  print at 4,6, "SECRETS: SHOW * DOORS"
  print at 4,8, "GLOBE: SINGS HIGHER NEAR"
  print at 4,10, "CROSS: PASS TOMBSTONES"
  print at 4,12, "WAND OF THE WAY: SHOWS"
  print at 4,13, "THE REAL SWORD"
  print at 4,14, "PURPLE KEY: PURPLE DOORS"
  print at 4,16, "BLUE KEY: BLUE DOORS"
  print at 4,18, "AXE: CHOP TREES"
  print at 4,20, "TORCH: LIGHT DARK ROOMS"
  ShowScreen
  if HowWait = 1 then return
  NewScreen
  backdrop black
  print at 10,1, "DANGERS"
  put char TFluff at 3,3
  put char TBrickm at 5,3
  put char TPhant at 7,3
  put char TCatl at 9,3
  put char TCatr at 10,3
  put char TZomb at 12,3
  put char TThief at 14,3
  print at 2,5, "MONSTERS CHASE YOU. ONE"
  print at 2,6, "TOUCH COSTS A DREAM. THE"
  print at 2,7, "BLUE THIEF STEALS AN ITEM."
  put char TTomb at 3,9
  put char TCrack at 5,9
  print at 2,11, "TOMBSTONES KILL (NOT WITH"
  print at 2,12, "THE CROSS). RUN FROM"
  print at 2,13, "CRACKS: BRICKS FALL THERE."
  print at 2,14, "YELLOW: STICK REVERSED!"
  print at 2,16, "BUTTON: CROSS FREEZES ALL"
  print at 2,17, "MONSTERS (ONCE). HOLD 1 S"
  print at 2,18, "TO GIVE UP."
  print at 2,20, "TIP: TAKE THE WAND OF THE"
  print at 2,21, "WAY AND THE TORCH. MAP IT!"
  ShowScreen
  if HowWait = 1 then return
  return
end sub

' wait for a press (0) or 30 seconds (1)
function HowWait as u8
  u16 Hw = 0
  Rearm
  wait no fire
  nmi off
  Press = 0
  Hw = 0
  while Press = 0
    Frame1
    ReadPad
    inc Hw
    if Hw > 1800 then return 1
  end while
  return 0

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 5,2, "THE ENCHANTED JOURNEY"
  print at 2,5, "BASED ON THE ENCHANTED"
  print at 2,6, "JOURNEY BY BRENT LACKIE,"
  print at 2,7, "COMPUTE!'S GAZETTE MAY 1985"
  print at 2,8, "(VIC-20 WITH 8K)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: DREAM ROAD"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

