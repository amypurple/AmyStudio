' Vector Cube Demo adapted from Matthew Eggleston's CVBasic version.
' Amy uses native bitmap lines and precomputed frames instead of manual XOR VPEEK/VPOKE.

u8 FrameNo = 0
u8 Segment = 0
u8 X1 = 0, Y1 = 0, X2 = 0, Y2 = 0

  text screen
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "VECTOR CUBE"
  print centered at 9, "BITMAP LINE DEMO"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  bitmap screen
  screen on

main_loop:
  cls
  select case FrameNo
  case 0
    restore CubeFrame0
  case 1
    restore CubeFrame1
  case 2
    restore CubeFrame2
  case 3
    restore CubeFrame3
  case 4
    restore CubeFrame4
  case 5
    restore CubeFrame5
  case 6
    restore CubeFrame6
  case else
    restore CubeFrame7
  end select
  for Segment = 1 to 12
    read X1,Y1,X2,Y2
    line X1,Y1 to X2,Y2
  next
  wait 4 frames
  FrameNo += 1
  if FrameNo = 8 then FrameNo = 0
  goto main_loop

data CubeFrame0 bytes
  96,64,144,64, 144,64,144,112, 144,112,96,112, 96,112,96,64
  108,52,156,52, 156,52,156,100, 156,100,108,100, 108,100,108,52
  96,64,108,52, 144,64,156,52, 144,112,156,100, 96,112,108,100
end data

