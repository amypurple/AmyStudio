cartridge "VECTOR CUBE/AMY STUDIO/2026"

u8 FrameNo = 0
u8 Segment = 0
u8 X1 = 0, Y1 = 0, X2 = 0, Y2 = 0

' Vector cube demo adapted from Matthew Eggleston's CVBasic version.
' Amy uses native bitmap lines and precomputed frames for compact clarity.
  text screen
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "VECTOR CUBE"
  print centered at 9, "BITMAP LINE DEMO"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  bitmap screen
  screen on

main_loop:
  wait 4 frames
  nmi off
  cls
  select case FrameNo
  case 0
    restore CubeFrame0
  case 1
    restore CubeFrame1
  case 2
    restore CubeFrame2
  case 3
    restore CubeFrame3
  case 4
    restore CubeFrame4
  case 5
    restore CubeFrame5
  case 6
    restore CubeFrame6
  case else
    restore CubeFrame7
  end select
  for Segment = 1 to 12
    read X1,Y1,X2,Y2
    line X1,Y1 to X2,Y2
  next
  nmi on
  FrameNo += 1
  if FrameNo = 8 then FrameNo = 0
  goto main_loop

