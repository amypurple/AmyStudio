' FujiNet app keys: keep a best score on the FujiNet's SD card.
' Use a creator id of your own: every program sharing an id shares its keys.
' Build for a ColecoVision cartridge with target.hardware ["fujinet"].
appkey creator $A3A5 app 1

u8 S = 0
u16 Got = 0
u16 Best = 0
u8 Key[2]

text screen
backdrop dark red
screen on
print at 0,0, "FUJINET APP KEY SCORE"

' A key that was never written reads as 0 bytes.
Got = appkey read 0 into Key status S
if S <> 0 then
  print at 0,2, "NO FUJINET OR SD CARD"
else
  if Got = 2 then
    Best = Key[1]
    Best = Best * 256 + Key[0]
  end if
  print at 0,2, "LAST BEST"
  print Best at 12,2 digits 5
  Best = Best + 10
  Key[0] = lowbyte Best
  Key[1] = highbyte Best
  appkey write 0 from Key count 2 status S
  print at 0,4, "SAVED"
  print Best at 12,4 digits 5
end if
loop forever
