' Historical 120C image shown with two dual-purpose 6 KB VRAM banks.
' Each VBlank swaps which bank is interpreted as PATTERN and COLOR data.
asset MickeyBankA from "@project/mickey-120c-bank-a.zx0" codec zx0
asset MickeyName from "@project/mickey-120c-name.zx0" codec zx0
asset MickeyBankB from "@project/mickey-120c-bank-b.zx0" codec zx0

  screen off
  picture screen
  decompress zx0 MickeyBankA to vram $0000
  decompress zx0 MickeyName to vram $1800
  decompress zx0 MickeyBankB to vram $2000
  120 colors on
  screen on

forever:
  wait
  goto forever
