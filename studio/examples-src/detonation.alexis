u8 PY = 150
u8 Half = 0
u8 Walk = 0
u8 WalkN = 0
u8 Phase = 0
u8 PDir = 1
u8 SFrac = 0
u8 CurlAnim = 0
u8 FIdx = 0
u8 FBurn = 0
u8 HitT = 0
u8 Touch = 0
u8 Stung = 0
u8 Got = 0
u8 Carry = 0
u8 Lv = 1
u8 Over = 0
u8 Mode = 0
u8 Bumps = 0
u8 Stings = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 SparkT = 0
u8 Spark = 0
' title spark
u8 TsX = 24
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Bi = 0
u8 Ms = 0
u8 Ec = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 NX = 0
u8 NY = 0

  tile screen
  set sound table DtSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  if Over = 1 then
    Blast
  else
    Victory2
  end if
  if Score > Best then Best = Score
  HideSprites
  print at 9,9, "              "
  if Over = 1 then
    print at 9,10, "  GAME  OVER  "
  else
    print at 9,10, " ALL  DEFUSED "
  end if
  print at 9,11, "              "
  print at 9,12, " SCORE  ", Score, " "
  print at 9,13, "              "
  Mode = 2
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  MoveMan
  MoveCurls
  ' contacts: a curl touched burns a cell, then one more every StingGap
  ' frames while it lasts; a wall walked into, one every HitGap frames
  Touch = Bumps
  Stung = 0
  if CurlHit() > 0 then
    Touch = 1
    Stung = 1
    inc Stings
  end if
  if Touch > 0 then
    if HitT = 0 then
      ' a curl keeps burning while it touches; a wall only now and then
      if Stung = 1 then
        HitT = StingGap
      else
        HitT = HitGap
      end if
      play sound SndFizz
      Burn
      if Over > 0 then return
    end if
  end if
  if HitT > 0 then dec HitT
  ' the cord burns on
  inc FBurn
  if FBurn >= FStep then
    FBurn = 0
    play sound SndTick
    Burn
    if Over > 0 then return
  end if
  TakeBombs
  if Carry = 3 then
    X = PX + 8
    Y = PY + 8
    if InBox(X, Y, CrX0, CrY0, CrX1, CrY1) = 1 then RoundDone
  end if
  return
end sub

' one cell of cord turns to ash; the last one blows up the crate
sub Burn:
  X = FX[FIdx]
  Y = FY[FIdx]
  put char FA[FIdx] at X,Y
  inc FIdx
  if FIdx >= NFuse then Over = 1
  return
end sub

' 1.5 pixels a frame: one pixel, and a second one every other frame; each
' axis on its own so the man slides along walls; a wall stops him, and
' when he is stopped dead it counts as a contact (Bumps)
sub MoveMan:
  Bumps = 0
  X = PX
  Y = PY
  Half = Half ^ 1
  K = Half + 1
  for Ms = 1 to K
    StepAxis
  next
  ' sliding along a wall is free: only a man stopped dead bumps
  if PX <> X then Bumps = 0
  if PY <> Y then Bumps = 0
  return
end sub

sub StepAxis:
  NX = PX
  NY = PY
  V = J1 & 12
  select case V
    case 4
      if NX > PMinX then dec NX
    case 8
      if NX < PMaxX then inc NX
  end select
  if NX <> PX then
    if WallHit(NX, PY) = 0 then
      PX = NX
      inc WalkN
    else
      Bumps = 1
    end if
  end if
  V = J1 & 3
  select case V
    case 1
      if NY > PMinY then dec NY
    case 2
      if NY < PMaxY then inc NY
  end select
  if NY <> PY then
    if WallHit(PX, NY) = 0 then
      PY = NY
      inc WalkN
    else
      Bumps = 1
    end if
  end if
  if WalkN >= 8 then
    WalkN = 0
    Walk = Walk ^ 1
  end if
  return
end sub

' 1 when the man's body (sprite corner Ax, Ay) overlaps a wall
function WallHit(u8 Ax, u8 Ay) as u8
  u8 Wi = 0
  u8 L = 0
  u8 R = 0
  u8 T = 0
  u8 B = 0
  L = Ax + 3
  R = Ax + 12
  T = Ay + 1
  B = Ay + 14
  for Wi = 0 to NWalls - 1
    if R >= WX0[Wi] then
      if L <= WX1[Wi] then
        if B >= WY0[Wi] then
          if T <= WY1[Wi] then return 1
        end if
      end if
    end if
  next
  return 0

' 1 when the point (Qx, Qy) lies in the box
function InBox(u8 Qx, u8 Qy, u8 X0, u8 Y0, u8 X1, u8 Y1) as u8
  if Qx < X0 then return 0
  if Qx > X1 then return 0
  if Qy < Y0 then return 0
  if Qy > Y1 then return 0
  return 1

' the curls: one sweep 0..CurlMax and back, at the round's speed
sub MoveCurls:
  W16 = SFrac + Spd
  SFrac = W16 & 255
  K = W16 >> 8
  while K > 0
    if PDir = 1 then
      inc Phase
      if Phase >= CurlMax then PDir = 0
    else
      dec Phase
      if Phase = 0 then PDir = 1
    end if
    dec K
  end while
  for Ci = 0 to 2
    select case Ci
      case 0
        Curls[Ci].X = 72
        Curls[Ci].Y = 80 + Phase
      case 1
        Curls[Ci].X = 168
        Curls[Ci].Y = 144 - Phase
      case else
        Curls[Ci].X = 88 + Phase
        Curls[Ci].Y = 84
    end select
  next
  return
end sub

' how many curls touch the man
function CurlHit as u8
  u8 N = 0
  u8 Ch = 0
  u8 Dx = 0
  u8 Dy = 0
  for Ch = 0 to 2
    ' the boxes (man 3..12 x 1..14, curl 3..12 x 3..12) overlap when the
    ' corners are less than 10 apart across and the rows fit
    if PX >= Curls[Ch].X then
      Dx = PX - Curls[Ch].X
    else
      Dx = Curls[Ch].X - PX
    end if
    if Dx < 10 then
      W16 = PY + 14
      if W16 >= Curls[Ch].Y + 3 then
        W16 = Curls[Ch].Y + 12
        Dy = PY + 1
        if Dy <= W16 then inc N
      end if
    end if
  next
  return N

' a bomb touched is taken
sub TakeBombs:
  for Bi = 0 to 2
    V = 1 << Bi
    K = Got & V
    if K = 0 then
      X = BombC[Bi] * 8
      Y = BombR[Bi] * 8
      if PX + 12 >= X + 2 then
        if PX + 3 <= X + 13 then
          if PY + 14 >= Y + 4 then
            if PY + 1 <= Y + 14 then
              Got = Got | V
              inc Carry
              Score += 10
              X = BombC[Bi]
              Y = BombR[Bi]
              fill 32 count 2 at X,Y
              fill 32 count 2 at X,Y + 1
              play sound SndGrab
              ShowHud
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' the three bombs in the crate: the next round, the curls faster
sub RoundDone:
  Score += 50
  if Lv >= LastLv then
    Over = 2
    return
  end if
  inc Lv
  Spd = SpdT[Lv - 1]
  Got = 0
  Carry = 0
  PutBombs
  ShowHud
  play sound SndLevel
  return
end sub

sub PutBombs:
  for Bi = 0 to 2
    X = BombC[Bi]
    Y = BombR[Bi]
    put char TBomb00 at X,Y
    put char TBomb01 at X + 1,Y
    put char TBomb10 at X,Y + 1
    put char TBomb11 at X + 1,Y + 1
  next
  return
end sub

' ---------------------------------------------------------------------------
' the endings
sub Blast:
  mute all
  play sound SndBoom
  for Ec = 0 to 71
    Frame1
    K = Ec / 12
    K = K & 1
    if K = 0 then
      backdrop dark red
    else
      backdrop dark yellow
    end if
    K = Ec >> 3
    K = K & 1
    K = K * 4 + SBl0
    set sprite 7 to 147,120,K,11
    set sprite 8 to 143,124,K,8
    update sprites
  next
  backdrop black
  FuseBonus
  return
end sub

sub Victory2:
  mute all
  play sound SndWin
  Rearm
  wait 60 frames
  nmi off
  FuseBonus
  return
end sub

' 10 points for every cell of cord left, counted up
sub FuseBonus:
  u8 Keep = 0
  Keep = Over
  print at 9,15, "FUSE LEFT     "
  while FIdx < NFuse
    Frame1
    Burn
    Score += 10
    ShowHud
    NumU = NFuse - FIdx
    print at 19,15, digits$(NumU, 2)
    play sound SndCount
  end while
  print at 9,15, "              "
  Over = Keep
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprites 0-1 the man (visor and boots, suit), 2-3 the spark,
' 4-6 the curls, 7-8 the blast
sub DrawSprites:
  K = Walk * 8 + SMan0d
  set sprite 0 to PY - 1,PX,K,15
  set sprite 1 to PY - 1,PX,K + 4,3
  inc SparkT
  if SparkT >= 10 then
    SparkT = 0
    Spark = Spark ^ 1
    inc CurlAnim
  end if
  SparkXY
  K = Spark * 8 + SSp0w
  set sprite 2 to Y,X,K,15
  set sprite 3 to Y,X,K + 4,11
  for Ci = 0 to 2
    K = CurlAnim + Ci
    K = K & 3
    K = K * 4 + SCu0
    set sprite Ci + 4 to Curls[Ci].Y - 1,Curls[Ci].X,K,10
  next
  update sprites
  return
end sub

' the spark: between this cell and the next by how far the cell has burnt
sub SparkXY:
  C = FIdx
  if C >= NFuse then C = NFuse - 1
  X = FX[C] * 8 - 4
  Y = FY[C] * 8 - 5
  NumU = FBurn * 8
  NumU = NumU / FStep
  V = NumU
  if C < NFuse - 1 then
    NX = FX[C + 1]
    NY = FY[C + 1]
  else
    NX = FX[C] + 1
    NY = FY[C]
  end if
  if NX > FX[C] then X = X + V
  if NX < FX[C] then X = X - V
  if NY > FY[C] then Y = Y + V
  if NY < FY[C] then Y = Y - V
  return
end sub

sub ShowHud:
  NumU = Lv
  print at 2,1, "ROUND ", digits$(NumU, 2)
  for Bi = 0 to 2
    V = 1 << Bi
    K = Got & V
    if K = 0 then
      put char TIe at Bi + 12,1
    else
      put char TIb at Bi + 12,1
    end if
  next
  print at 17,1, "SCORE ", Score
  return
end sub

sub NewGame:
  NewScreen
  copy ArenaMap count 768 to vram.name
  Score = 0
  Lv = 1
  Spd = SpdT[0]
  PX = 120
  PY = 150
  Half = 0
  Walk = 0
  WalkN = 0
  Phase = 0
  PDir = 1
  SFrac = 0
  CurlAnim = 0
  FIdx = 0
  FBurn = 0
  HitT = 0
  Got = 0
  Carry = 0
  Over = 0
  Stings = 0
  ShowHud
  MoveCurls
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  Mode = 1
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the name over a burning cord with a bomb at its end, START /
' CREDITS, the best score, the tune once
sub TitlePage:
  Mode = 0
  NewScreen
  print at 6,2, "AHOY! NOVEMBER 1986"
  print at 10,5, "DETONATION"
  print at 8,7, "BY BOB BLACKMER"
  fill TFh count 22 at 4,11
  put char TFend at 3,11
  put char TBomb00 at 26,10
  put char TBomb01 at 27,10
  put char TBomb10 at 26,11
  put char TBomb11 at 27,11
  print at 4,14, "FETCH THE THREE BOMBS"
  print at 4,15, "BEFORE THE FUSE BURNS"
  print at 4,16, "DOWN TO THE CRATE."
  print at 13,19, "START"
  print at 13,20, "CREDITS"
  if Best > 0 then
    print at 9,22, "BEST ", Best
  end if
  ShowMenu
  TsX = 20
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 496
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the spark crawls along the title's cord, a pixel every fourth frame,
' and starts again at the left when it nears the bomb
sub TitleAnim:
  V = Tick & 3
  if V = 0 then
    inc TsX
    if TsX >= 196 then TsX = 20
  end if
  inc SparkT
  if SparkT >= 10 then
    SparkT = 0
    Spark = Spark ^ 1
  end if
  K = Spark * 8 + SSp0w
  set sprite 2 to 83,TsX,K,15
  set sprite 3 to 83,TsX,K + 4,11
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 19
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  Mode = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "DETONATION"
  print at 2,5, "BASED ON DETONATION BY"
  print at 2,6, "BOB BLACKMER, AHOY!"
  print at 2,7, "NOVEMBER 1986 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SLOW BURN"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

