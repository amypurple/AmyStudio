' Fixed32 multiply lab: strategic cases for debugging the multiply path.
fixed32 ByZero = 1.5
fixed32 ByOne = 1.5
fixed32 ByTwo = 1.5
fixed32 ByHalf = 1.5
fixed32 ByNegOne = 1.5
fixed32 ByNegThree = 1.5
fixed32 NegByTwo = -1.5
fixed32 NegByNegTwo = -1.5

' Amy Fixed32 Multiply Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 4,0, "FIXED32 MULTIPLY LAB"

  ByZero *= 0
  print at 1,3,  "1.50 * 0.00"
  print ByZero at 20,3

  ByOne *= 1
  print at 1,5,  "1.50 * 1.00"
  print ByOne at 20,5

  ByTwo *= 2
  print at 1,7,  "1.50 * 2.00"
  print ByTwo at 20,7

  ByHalf *= 0.5
  print at 1,9,  "1.50 * 0.50"
  print ByHalf at 20,9

  ByNegOne *= -1
  print at 1,11, "1.50 * -1.00"
  print ByNegOne at 20,11

  ByNegThree *= -3
  print at 1,13, "1.50 * -3.00"
  print ByNegThree at 20,13

  NegByTwo *= 2
  print at 1,15, "-1.50 * 2.00"
  print NegByTwo at 20,15

  NegByNegTwo *= -2
  print at 1,17, "-1.50 * -2.00"
  print NegByNegTwo at 20,17

  print at 1,20, "EXPECTED"
  print at 10,20, "0 1.5 3 .75"
  print at 1,21, "        -1.5 -4.5 -3 3"
  return