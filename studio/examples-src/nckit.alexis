cartridge "NUMBER CONSTRUCTION KIT/COMPUTE'S GAZETTE/1986"

' NUMBER CONSTRUCTION KIT
' A ColecoVision game based on "Number Construction Kit", COMPUTE!'s
' Gazette, March 1986 (Commodore 64, BASIC; the listing names no author).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: every turn the site office hands you a PROJECT (a number from
' 100 to 999) and a few MATERIALS (different digits from 1 to 9). Build the
' project with the TOOLS + - x / : a chain of up to eight materials, each
' used as often as you like, joined by tools. x and / work before + and -.
' The running total shows as you build. Press BUILD (the green tick) and
' the crane raises a building as tall as you came close; score =
' (200 - miss) x level x seconds left in the bonus time / 10.
'
' From the original (orig/nckit.bas, the BASIC listing at $3401): one or
' two players taking turns, five rounds; levels BEGINNER, INTERMEDIATE,
' ADVANCED with 5, 4 and 3 materials, a clock of 3, 4 and 5 minutes and a
' bonus time of 3, 2 and 1 minutes; materials are different digits 1-9,
' the project 100-999; up to eight numbers and seven tools in a chain,
' x and / before + and -; a running total that must stay within 0-9999
' ("TOTAL TOO LARGE" / "NEGATIVE TOTAL - PLEASE CORRECT"); the miss is
' capped at 200; score INT((200 - miss) x level x bonus seconds left / 10)
' added to the player's total; GOOD GAME at the end.
'
' Liberties: joystick editing replaces the keyboard (left/right moves the
' cursor along the chain, up/down turns a slot through the materials or
' the tools, the button steps right or presses BUILD). A number slot can be
' emptied only at the end of the chain (the original's DEL). / is whole-
' number division (the remainder is dropped) and a product above 9999 is
' "TOO LARGE" too (the original kept fractions inside a term). The project
' and materials stay covered until the player presses the button and the
' clock starts (the original showed them before "PRESS ANY KEY", so you
' could think for free). Bonus seconds never go below 0 (the original
' could score negative at INTERMEDIATE and ADVANCED). When the clock runs
' out a broken chain counts as 0. BUILD is refused while the chain is
' broken. The building, crane, sounds and title tune are new; the
' original's screen layout and colours are not copied.
'
' Controls: either controller; stick and side buttons only. Title: up/down
' choose a line, left/right change players and level, button on START
' (or on HOW TO PLAY: three pages, or CREDITS).
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; frame
' loop protected from the NMI; screens drawn with NMI off and display off.
' Music first in the sound table; the title tune plays once.

const TD000 = 128
const TD001 = 129
const TD010 = 130
const TD011 = 131
const TD100 = 132
const TD101 = 133
const TD110 = 134
const TD111 = 135
const TD200 = 136
const TD201 = 137
const TD210 = 138
const TD211 = 139
const TD300 = 140
const TD301 = 141
const TD310 = 142
const TD311 = 143
const TD400 = 144
const TD401 = 145
const TD410 = 146
const TD411 = 147
const TD500 = 148
const TD501 = 149
const TD510 = 150
const TD511 = 151
const TD600 = 152
const TD601 = 153
const TD610 = 154
const TD611 = 155
const TD700 = 156
const TD701 = 157
const TD710 = 158
const TD711 = 159
const TD800 = 160
const TD801 = 161
const TD810 = 162
const TD811 = 163
const TD900 = 164
const TD901 = 165
const TD910 = 166
const TD911 = 167
const TLN00 = 168
const TLN01 = 169
const TLN10 = 170
const TLN11 = 171
const TLU00 = 172
const TLU01 = 173
const TLU10 = 174
const TLU11 = 175
const TLM00 = 176
const TLM01 = 177
const TLM10 = 178
const TLM11 = 179
const TLB00 = 180
const TLB01 = 181
const TLB10 = 182
const TLB11 = 183
const TLE00 = 184
const TLE01 = 185
const TLE10 = 186
const TLE11 = 187
const TLR00 = 188
const TLR01 = 189
const TLR10 = 190
const TLR11 = 191
const TLC00 = 192
const TLC01 = 193
const TLC10 = 194
const TLC11 = 195
const TLO00 = 196
const TLO01 = 197
const TLO10 = 198
const TLO11 = 199
const TLS00 = 200
const TLS01 = 201
const TLS10 = 202
const TLS11 = 203
const TLT00 = 204
const TLT01 = 205
const TLT10 = 206
const TLT11 = 207
const TLI00 = 208
const TLI01 = 209
const TLI10 = 210
const TLI11 = 211
const TLK00 = 212
const TLK01 = 213
const TLK10 = 214
const TLK11 = 215
const TSk00 = 216
const TSk01 = 217
const TSk10 = 218
const TSk11 = 219
const TOplus0 = 220
const TOplus1 = 221
const TOminus0 = 222
const TOminus1 = 223
const TOtimes0 = 224
const TOtimes1 = 225
const TOdivide0 = 226
const TOdivide1 = 227
const TBt00 = 228
const TBt01 = 229
const TBt10 = 230
const TBt11 = 231
const TPaper = 232
const TGrid = 233
const TDirt = 234
const TGirder = 235
const TFlag = 236
const TDim = 237
const TDiml = 238
const TDimr = 239
const SArrow = 0
const SHook = 4
const SBeam = 8
const NTiles8 = 896
const SprBytes = 96
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndMove = 4
const SndRefuse = 5
const SndBegin = 6
const SndClank = 7
const SndExact = 8
const SndNear = 9
const SndBell = 10
const SndOver = 11
const NSpr = 6
const Rounds = 5
const ExpRow = 10
const TotRow = 13
const MatRow = 7
const BuildSlot = 15
const MaxV = 9999
const MissCap = 200
const SiteCol = 3
const GroundRow = 21
const TuneLen = 544

' the title letters: N U M B E R C O S T I K in glyph order
data LogoA bytes
  0, 1, 2, 3, 4, 5
end data
data LogoB bytes
  6, 7, 0, 8, 9, 5, 1, 6, 9, 10, 7, 0
end data
data LogoC bytes
  11, 10, 9
end data

record Hook:
  u8 Y
  u8 Ty
  u8 Live
end record

Hook Hk

' settings and players
u8 NPl = 1
u8 Lev = 1
u8 Pl = 0
u8 Rnd = 1
u16 Score[2]
u8 Menu = 0
u8 TitleOn = 0
' the turn: materials, project, chain
u8 NMat = 5
u8 Mat[5]
u16 Target = 0
u8 Num[8]
u8 Ops[7]
u8 Len = 0
u8 Cur = 0
u8 CurMax = 0
u16 Total = 0
u8 Err = 0
' clock (seconds)
u16 TLimit = 180
u16 Bonus = 180
u16 Elapsed = 0
u8 Fr60 = 0
' result
u16 Miss = 0
u16 Gain = 0
u8 Floors = 0
u8 Built = 0
u8 GameOver = 0
' play phases: 0 covered, 1 building, 2 crane, 3 result
u8 St = 0
u8 Wt = 0
' random numbers, title tune
u16 Rs = 1
u16 W16 = 0
u16 TzLeft = 0
u8 TzOn = 0
' input
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 RepT = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Ci = 0
u8 Ki = 0
u8 Li = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table NkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then
    if Menu = 3 then
      HowToPage
    else
      CreditsPage
    end if
    Menu = 0
    goto title
  end if
  NewGame

turn_start:
  NewTurn
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if St < 4 then goto play_loop
  ' St 4: the turn is over; the next player, the next round or the end
  NextTurn
  if GameOver = 0 then goto turn_start

  EndPage
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a number from 1 to N
function Roll(u16 Nr) as u16
  u16 Res = 0
  Rand
  Res = Rs % Nr
  Res = Res + 1
  return Res

' is digit D already a material?
function HasMat(u8 Dm) as u8
  u8 Hm = 0
  u8 Fm = 0
  for Hm = 0 to 4
    if Hm < NMat then
      if Mat[Hm] = Dm then Fm = 1
    end if
  next
  return Fm

' the slot's place in the material list: 0 empty, 1..NMat
function MatPos(u8 Dv) as u8
  u8 Pm = 0
  u8 Rm = 0
  for Pm = 0 to 4
    if Pm < NMat then
      if Mat[Pm] = Dv then Rm = Pm + 1
    end if
  next
  return Rm

' the chain's value, as lines 360-440: x and / inside a term, then the
' terms added left to right; Err 1 too large, 2 negative (the first one
' found counts). Sets Total; returns Err.
function Evaluate as u8
  u16 Sum = 0
  u16 Term = 0
  u16 Lim = 0
  u8 Neg = 0
  u8 Ex = 0
  u8 Ie = 0
  u8 Dv = 0
  u8 Oe = 0
  Sum = 0
  Ex = 0
  if Len > 0 then
    Term = Num[0]
    Neg = 0
    for Ie = 1 to 7
      if Ie < Len then
        Dv = Num[Ie]
        Oe = Ops[Ie - 1]
        select case Oe
        case 2
          Lim = MaxV / Dv
          if Term > Lim then
            if Ex = 0 then Ex = 1
          else
            Term = Term * Dv
          end if
        case 3
          Term = Term / Dv
        case else
          AddTerm(Sum, Term, Neg, Ex)
          Term = Dv
          Neg = 0
          if Oe = 1 then Neg = 1
        end select
      end if
    next
    AddTerm(Sum, Term, Neg, Ex)
  end if
  Total = Sum
  return Ex

' Sum +/- Term, with the original's range checks (lines 390-400)
sub AddTerm(ref u16 Sm, u16 Tm, u8 An, ref u8 Ae):
  if An = 1 then
    if Tm > Sm then
      if Ae = 0 then Ae = 2
    else
      Sm = Sm - Tm
    end if
  else
    Sm = Sm + Tm
    if Sm > MaxV then
      if Ae = 0 then Ae = 1
    end if
  end if
  return
end sub

' a new turn: materials, project, an empty chain, the clock
sub DealTurn:
  for Ci = 0 to 4
    Mat[Ci] = 0
  next
  Ci = 0
  while Ci < NMat
    W16 = Roll(9)
    V = W16
    if HasMat(V) = 0 then
      Mat[Ci] = V
      inc Ci
    end if
  end while
  W16 = Roll(900)
  Target = W16 + 99
  for Ci = 0 to 7
    Num[Ci] = 0
  next
  for Ci = 0 to 6
    Ops[Ci] = 0
  next
  Len = 0
  Cur = 0
  Total = 0
  Err = 0
  Elapsed = 0
  Fr60 = 0
  return
end sub

' the score for the finished chain (lines 620-640)
sub Score1:
  u16 Got = 0
  u16 Tr = 0
  Got = Total
  if Err > 0 then Got = 0
  if Got > Target then
    Miss = Got - Target
  else
    Miss = Target - Got
  end if
  if Miss > MissCap then Miss = MissCap
  Tr = 0
  if Bonus > Elapsed then Tr = Bonus - Elapsed
  Gain = MissCap - Miss
  Gain = Gain * Lev
  Gain = Gain * Tr
  Gain = Gain / 10
  Score[Pl] = Score[Pl] + Gain
  W16 = MissCap - Miss
  Floors = W16 / 40
  return
end sub

' ---------------------------------------------------------------------------
' play

sub PlayStep:
  select case St
  case 0
    if Press = 1 then StartBuilding
  case 1
    Edit
    if St = 1 then Clock
  case 2
    Crane
  case 3
    if Wt > 0 then dec Wt
    if Wt = 0 then
      if Press = 1 then St = 4
    end if
  end select
  return
end sub

sub StartBuilding:
  Rearm
  wait
  nmi off
  for Ci = 16 to 20
    fill 32 count 18 at 11,Ci
  next
  DrawMaterials
  PutBig3(Target, 11, 3)
  ShowChain
  ShowTotal
  ShowClock
  print at 2,13, "TOTAL"
  play sound SndBegin
  St = 1
  return
end sub

' the stick and the button while building
sub Edit:
  if Edge & 4 then
    if Cur = BuildSlot then
      Cur = CurMax
    else
      if Cur > 0 then dec Cur
    end if
    play sound SndMove
  end if
  if Edge & 8 then StepRight
  K = Jk & 3
  if K = 0 then
    RepT = 0
  else
    inc RepT
    if RepT = 1 then Turn
    if RepT >= 24 then
      RepT = 14
      Turn
    end if
  end if
  if Press = 1 then
    if Cur = BuildSlot then
      if Err = 0 then
        FinishTurn
      else
        play sound SndRefuse
      end if
    else
      StepRight
    end if
  end if
  return
end sub

sub StepRight:
  if Cur = BuildSlot then return
  if Cur >= CurMax then
    Cur = BuildSlot
  else
    inc Cur
  end if
  play sound SndMove
  return
end sub

' up/down: turn the slot under the cursor
sub Turn:
  u8 Sn = 0
  u8 Pv = 0
  u8 Lo = 0
  if Cur = BuildSlot then return
  Sn = Cur >> 1
  if Cur & 1 then
    Pv = Ops[Sn]
    if Jk & 1 then
      Pv = (Pv + 1) & 3
    else
      Pv = (Pv + 3) & 3
    end if
    Ops[Sn] = Pv
  else
    ' empty is allowed only at the end of the chain
    Lo = 1
    if Sn + 1 >= Len then Lo = 0
    Pv = MatPos(Num[Sn])
    if Jk & 1 then
      inc Pv
      if Pv > NMat then Pv = Lo
    else
      if Pv <= Lo then
        Pv = NMat
      else
        dec Pv
      end if
    end if
    if Pv = 0 then
      Num[Sn] = 0
      Len = Sn
    else
      Num[Sn] = Mat[Pv - 1]
      if Sn >= Len then Len = Sn + 1
    end if
  end if
  Err = Evaluate
  play sound SndClick
  Rearm
  wait
  nmi off
  ShowChain
  ShowTotal
  return
end sub

' one second of the clock; time out builds what is there
sub Clock:
  inc Fr60
  if Fr60 < 60 then return
  Fr60 = 0
  inc Elapsed
  ShowClock
  if Elapsed >= TLimit then
    play sound SndBell
    FinishTurn
  end if
  return
end sub

sub FinishTurn:
  Score1
  Cur = BuildSlot
  Built = 0
  Hk.Live = 0
  St = 2
  Wt = 20
  ShowScores
  return
end sub

' the crane lowers one girder floor per trip (Floors of them), then a flag
' for an exact build
sub Crane:
  u8 Hy = 0
  u8 Fy = 0
  if Wt > 0 then
    dec Wt
    return
  end if
  if Hk.Live = 0 then
    if Built >= Floors then
      ShowResult
      return
    end if
    Hk.Live = 1
    Hk.Y = 8
    Fy = GroundRow - 1
    Fy = Fy - Built
    Fy = Fy << 3
    Hk.Ty = Fy - 16
    return
  end if
  Hy = Hk.Y + 2
  Hk.Y = Hy
  if Hy >= Hk.Ty then
    Fy = GroundRow - 1
    Fy = Fy - Built
    fill TGirder count 6 at SiteCol,Fy
    inc Built
    Hk.Live = 0
    Wt = 8
    play sound SndClank
  end if
  return
end sub

sub ShowResult:
  u8 Fy = 0
  if Miss = 0 then
    Fy = GroundRow - 1
    Fy = Fy - Floors
    put char TFlag at 5,Fy
    print at 11,16, "EXACT! TOPPED OUT"
    play sound SndExact
  else
    print at 11,16, "OFF BY"
    W16 = Miss
    print W16 at 18,16 width 3
    if Miss < 40 then
      play sound SndNear
    else
      play sound SndRefuse
    end if
  end if
  print at 11,17, "SCORE  +"
  print Gain at 19,17 width 5
  print at 11,19, "PRESS THE BUTTON"
  St = 3
  Wt = 30
  return
end sub

sub NextTurn:
  inc Pl
  if Pl >= NPl then
    Pl = 0
    inc Rnd
    if Rnd > Rounds then GameOver = 1
  end if
  return
end sub

sub NewGame:
  Score[0] = 0
  Score[1] = 0
  Pl = 0
  Rnd = 1
  GameOver = 0
  TitleOn = 0
  ' 5, 4, 3 materials for levels 1, 2, 3
  NMat = 6 - Lev
  TLimit = Lev + 2
  TLimit = TLimit * 60
  W16 = 4 - Lev
  Bonus = W16 * 60
  return
end sub

sub NewTurn:
  DealTurn
  St = 0
  NewScreen
  DrawSite
  print at 2,1, "ROUND"
  put char 48 + Rnd at 8,1
  print at 10,1, "OF 5"
  print at 20,1, "PLAYER"
  put char 49 + Pl at 27,1
  print at 2,3, "PROJECT"
  print at 2,MatRow, "MATERIALS"
  print at 22,3, "TIME"
  ShowClock
  ShowScores
  ' covered until the button
  print at 11,16, "PLAYER"
  put char 49 + Pl at 18,16
  print at 11,18, "PRESS THE BUTTON"
  print at 11,19, "TO BEGIN"
  print at 11,20, "CONSTRUCTION!"
  ShowScreen
  play sound SndBell
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a steel plate digit at Gc, Gr
sub PutPlate(u8 Gn, u8 Gc, u8 Gr):
  u8 Tg = 0
  u8 Cg = 0
  u8 Rg = 0
  Tg = Gn << 2
  Tg = Tg + TD000
  Cg = Gc + 1
  Rg = Gr + 1
  put char Tg at Gc,Gr
  put char Tg + 1 at Cg,Gr
  put char Tg + 2 at Gc,Rg
  put char Tg + 3 at Cg,Rg
  return
end sub

' a 2 x 2 group of 4 consecutive tiles from Tb
sub Put4(u8 Tb, u8 Gc, u8 Gr):
  u8 Cg = 0
  u8 Rg = 0
  Cg = Gc + 1
  Rg = Gr + 1
  put char Tb at Gc,Gr
  put char Tb + 1 at Cg,Gr
  put char Tb + 2 at Gc,Rg
  put char Tb + 3 at Cg,Rg
  return
end sub

sub Blank2(u8 Gc, u8 Gr):
  u8 Rg = 0
  Rg = Gr + 1
  fill TPaper count 2 at Gc,Gr
  fill TPaper count 2 at Gc,Rg
  return
end sub

' a three-digit number in plates
sub PutBig3(u16 Vn, u8 Gc, u8 Gr):
  u8 Dg = 0
  u16 Qn = 0
  Qn = Vn / 100
  Dg = Qn
  PutPlate(Dg, Gc, Gr)
  Vn = Vn - Qn * 100
  Qn = Vn / 10
  Dg = Qn
  PutPlate(Dg, Gc + 2, Gr)
  Vn = Vn - Qn * 10
  Dg = Vn
  PutPlate(Dg, Gc + 4, Gr)
  return
end sub

' the total: up to four plates, right-aligned at column 17, no leading zeros
sub ShowTotal:
  u16 Tv = 0
  u16 Qt = 0
  u8 Ct = 17
  u8 Dt = 0
  u8 Nt = 0
  Ct = 17
  if Err > 0 then
    for Nt = 0 to 3
      Blank2(Ct, TotRow)
      Ct = Ct - 2
    next
    if Err = 1 then
      print at 2,15, "TOO LARGE - PLEASE CORRECT "
    else
      print at 2,15, "NEGATIVE - PLEASE CORRECT  "
    end if
    return
  end if
  print at 2,15, "                           "
  Tv = Total
  for Nt = 0 to 3
    if Nt > 0 then
      if Tv = 0 then
        Blank2(Ct, TotRow)
      else
        Qt = Tv / 10
        Dt = Tv - Qt * 10
        PutPlate(Dt, Ct, TotRow)
        Tv = Qt
      end if
    else
      Qt = Tv / 10
      Dt = Tv - Qt * 10
      PutPlate(Dt, Ct, TotRow)
      Tv = Qt
    end if
    Ct = Ct - 2
  next
  return
end sub

sub DrawMaterials:
  u8 Mc = 0
  for Ci = 0 to 4
    if Ci < NMat then
      Mc = Ci * 3
      Mc = Mc + 12
      PutPlate(Mat[Ci], Mc, MatRow)
    end if
  next
  return
end sub

' the chain: plates, the socket for the next number, the tools between
sub ShowChain:
  u8 Nc = 0
  u8 Tt = 0
  u8 Rr = 0
  Rr = ExpRow + 1
  for Li = 0 to 7
    Nc = Li * 3
    Nc = Nc + 3
    if Li < Len then
      PutPlate(Num[Li], Nc, ExpRow)
    else
      if Li = Len then
        Put4(TSk00, Nc, ExpRow)
      else
        Blank2(Nc, ExpRow)
      end if
    end if
    if Li < 7 then
      Nc = Nc + 2
      if Li < Len then
        Tt = Ops[Li] << 1
        Tt = Tt + TOplus0
        put char Tt at Nc,ExpRow
        put char Tt + 1 at Nc,Rr
      else
        put char TPaper at Nc,ExpRow
        put char TPaper at Nc,Rr
      end if
    end if
  next
  ' the cursor can reach the socket (or the last tool) and BUILD
  CurMax = Len << 1
  if CurMax > 14 then CurMax = 14
  if Cur <> BuildSlot then
    if Cur > CurMax then Cur = CurMax
  end if
  return
end sub

sub ShowClock:
  u16 Secs = 0
  u16 Mn = 0
  Secs = TLimit - Elapsed
  Mn = Secs / 60
  Secs = Secs - Mn * 60
  V = Mn
  put char 48 + V at 23,4
  put char 58 at 24,4
  Mn = Secs / 10
  V = Mn
  put char 48 + V at 25,4
  Secs = Secs - Mn * 10
  V = Secs
  put char 48 + V at 26,4
  return
end sub

sub ShowScores:
  print at 2,22, "P1"
  print Score[0] at 5,22 width 5
  if NPl = 2 then
    print at 18,22, "P2"
    print Score[1] at 21,22 width 5
  end if
  return
end sub

' the building site: paper, dot grid on the left, ground
sub DrawSite:
  for Ci = 16 to 20
    fill TGrid count 8 at 2,Ci
  next
  fill TDirt count 32 at 0,GroundRow
  return
end sub

' sprites: 0 cursor, 1 hook, 2 beam
sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Sp = 0
  Sy = 192
  Sp = SArrow
  if St = 1 then
    if Cur = BuildSlot then
      Sx = 27 << 3
    else
      Sx = Cur >> 1
      Sx = Sx * 3
      Sx = Sx + 3
      Sx = Sx << 3
      if Cur & 1 then Sx = Sx + 12
    end if
    Sy = ExpRow + 2
    Sy = Sy << 3
    Sy = Sy - 1
    if Tick & 16 then Sy = Sy + 1
  end if
  set sprite 0 to Sy,Sx,Sp,11
  Sy = 192
  if Hk.Live = 1 then Sy = Hk.Y
  Sx = SiteCol << 3
  Sx = Sx + 16
  set sprite 1 to Sy,Sx,SHook,14
  set sprite 2 to Sy,Sx,SBeam,8
  update sprites
  return
end sub

sub EndPage:
  u8 Wn = 0
  Rearm
  wait
  nmi off
  HideSprites
  for Ci = 15 to 20
    fill 32 count 19 at 11,Ci
  next
  print at 2,15, "                           "
  print at 11,16, "GOOD GAME!"
  if NPl = 2 then
    Wn = 0
    if Score[1] > Score[0] then Wn = 2
    if Score[0] > Score[1] then Wn = 1
    if Wn = 0 then
      print at 11,18, "A TIE!"
    else
      print at 11,18, "PLAYER   WINS"
      put char 48 + Wn at 18,18
    end if
  else
    print at 11,18, "TOTAL"
    print Score[0] at 17,18 width 5
  end if
  ShowScores
  play sound SndOver
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  u8 Jr = 0
  Jr = 0
  if joypad(1).up then Jr = Jr | 1
  if joypad(1).down then Jr = Jr | 2
  if joypad(1).left then Jr = Jr | 4
  if joypad(1).right then Jr = Jr | 8
  if joypad(1).fire then Jr = Jr | 16
  if joypad(2).up then Jr = Jr | 1
  if joypad(2).down then Jr = Jr | 2
  if joypad(2).left then Jr = Jr | 4
  if joypad(2).right then Jr = Jr | 8
  if joypad(2).fire then Jr = Jr | 16
  Jk = Jr & 15
  Edge = Jk & (WasJ ^ 15)
  WasJ = Jk
  Btn = Jr & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' big title letters from a glyph list
sub Logo(u8 Lc, u8 Lr, u8 Ln, u8 Lw):
  u8 Tl = 0
  u8 Cl = 0
  Cl = Lc
  for Ki = 0 to 11
    if Ki < Lw then
      select case Ln
      case 0
        Tl = LogoA[Ki]
      case 1
        Tl = LogoB[Ki]
      case else
        Tl = LogoC[Ki]
      end select
      Tl = Tl << 2
      Tl = Tl + TLN00
      Put4(Tl, Cl, Lr)
      Cl = Cl + 2
    end if
  next
  return
end sub

sub TitlePage:
  TitleOn = 1
  NewScreen
  for Ci = 1 to 21
    fill TGrid count 28 at 2,Ci
  next
  Logo(10, 2, 0, 6)
  Logo(4, 5, 1, 12)
  Logo(13, 8, 2, 3)
  fill TPaper count 24 at 4,11
  print at 4,11, "COMPUTE!'S GAZETTE 1986"
  for Ci = 13 to 20
    fill TPaper count 24 at 4,Ci
  next
  print at 6,14, "PLAYERS"
  print at 6,15, "LEVEL"
  print at 6,17, "START"
  print at 6,18, "HOW TO PLAY"
  print at 6,19, "CREDITS"
  fill TDirt count 32 at 0,GroundRow
  fill TGirder count 6 at 23,20
  fill TGirder count 6 at 23,19
  put char TFlag at 25,18
  print at 2,22, "+ - X / BUILD THE NUMBER"
  ShowChoices
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if Edge & 1 then
    if Menu > 0 then dec Menu
    ShowMenu
  end if
  if Edge & 2 then
    if Menu < 4 then inc Menu
    ShowMenu
  end if
  if Edge & 12 then ChangeChoice
  if Press = 0 then goto tp_loop
  if Menu < 2 then
    Menu = 2
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ (W16 << 8)
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ChangeChoice:
  K = Edge & 8
  if Menu = 0 then NPl = 3 - NPl
  if Menu = 1 then
    if K > 0 then
      if Lev < 3 then inc Lev
    else
      if Lev > 1 then dec Lev
    end if
  end if
  play sound SndMove
  ShowChoices
  return
end sub

sub ShowChoices:
  put char 48 + NPl at 15,14
  select case Lev
  case 1
    print at 15,15, "BEGINNER    "
  case 2
    print at 15,15, "INTERMEDIATE"
  case else
    print at 15,15, "ADVANCED    "
  end select
  return
end sub

' the title menu rows
data MenuRow bytes
  14, 15, 17, 18, 19
end data

sub ShowMenu:
  for Ki = 0 to 4
    C = MenuRow[Ki]
    put char 32 at 4,C
  next
  C = MenuRow[Menu]
  put char 62 at 4,C
  return
end sub

' a tool (0 + 1 - 2 x 3 /) at Gc, Gr: one column, two rows
sub PutTool(u8 Tn, u8 Gc, u8 Gr):
  u8 Tt = 0
  u8 Rg = 0
  Tt = Tn << 1
  Tt = Tt + TOplus0
  Rg = Gr + 1
  put char Tt at Gc,Gr
  put char Tt + 1 at Gc,Rg
  return
end sub

' HOW TO PLAY: 3 pages; a button turns the page; after the last page,
' or 30 seconds untouched, back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Hw = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "THE SITE OFFICE GIVES YOU A"
    print at 2,4, "PROJECT: A NUMBER FROM 100"
    print at 2,5, "TO 999, AND A FEW MATERIALS:"
    print at 2,6, "DIGITS FROM 1 TO 9."
    print at 2,8, "PROJECT"
    PutBig3(456, 13, 8)
    print at 2,11, "MATERIALS"
    PutPlate(7, 13, 11)
    PutPlate(8, 16, 11)
    PutPlate(9, 19, 11)
    print at 2,14, "JOIN MATERIALS WITH + - X /"
    print at 2,15, "TO MAKE THE PROJECT. EACH"
    print at 2,16, "MATERIAL CAN BE USED AGAIN."
    PutPlate(8, 2, 18)
    PutTool(2, 4, 18)
    PutPlate(7, 5, 18)
    PutTool(2, 7, 18)
    PutPlate(8, 8, 18)
    PutTool(0, 10, 18)
    PutPlate(8, 11, 18)
    print at 14,18, "="
    PutBig3(456, 16, 18)
    print at 2,21, "X AND / GO BEFORE + AND -."
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "PRESS THE BUTTON TO SEE THE"
    print at 2,4, "PROJECT. THE CLOCK STARTS!"
    print at 2,6, "LEFT/RIGHT: MOVE ALONG THE"
    print at 2,7, "CHAIN."
    print at 2,8, "UP/DOWN: CHANGE THE NUMBER"
    print at 2,9, "OR TOOL OVER THE ARROW."
    print at 2,10, "BUTTON: GO TO THE NEXT SPOT."
    print at 2,12, "THE TOTAL SO FAR SHOWS AS"
    print at 2,13, "YOU BUILD."
    print at 2,15, "READY? GO TO THE GREEN TICK"
    print at 2,16, "AND PRESS THE BUTTON TO"
    print at 2,17, "BUILD."
    PutPlate(8, 6, 19)
    PutTool(2, 8, 19)
    Put4(TSk00, 9, 19)
    Put4(TBt00, 21, 19)
    set sprite 0 to 167,72,SArrow,11
  case else
    print at 2,1, "SCORE AND THE END       3/3"
    print at 2,3, "THE CRANE BUILDS A TOWER AS"
    print at 2,4, "TALL AS YOU CAME CLOSE."
    print at 2,6, "THE CLOSER AND THE FASTER,"
    print at 2,7, "THE MORE POINTS. HARDER"
    print at 2,8, "LEVELS SCORE MORE."
    print at 2,10, "IF THE CLOCK RUNS OUT, A"
    print at 2,11, "BROKEN CHAIN SCORES 0."
    print at 2,13, "FIVE ROUNDS, THEN THE GAME"
    print at 2,14, "IS OVER. TWO PLAYERS TAKE"
    print at 2,15, "TURNS; HIGHER TOTAL WINS."
    print at 2,16, "TIP: MULTIPLY FIRST TO GET"
    print at 2,17, "NEAR, THEN ADD OR TAKE AWAY."
    for Ci = 19 to 20
      fill TGirder count 6 at 20,Ci
    next
    put char TFlag at 22,18
    fill TDirt count 28 at 2,21
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Hw = 0
ht_wait:
  Frame1
  ReadPad
  Hw = Hw + 1
  if Hw >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  print at 4,2, "NUMBER CONSTRUCTION KIT"
  print at 2,5, "BASED ON NUMBER CONSTRUCTION"
  print at 2,6, "KIT, COMPUTE!'S GAZETTE,"
  print at 2,7, "MARCH 1986 (COMMODORE 64)."
  print at 2,8, "NO AUTHOR IS NAMED IN THE"
  print at 2,9, "LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: STEEL ON THE"
  print at 2,19, "BLUEPRINT (ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

