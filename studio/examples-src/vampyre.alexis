  $00,$00,$00,$00,$00,$00,$30,$F0,$E0,$C0,$80,$00,$00,$00,$00,$00
  $00,$00,$80,$C0,$71,$7D,$3F,$1E,$0C,$00,$00,$00,$00,$00,$00,$00
