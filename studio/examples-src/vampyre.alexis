asm {
VhHush:
    db $00,$00,$F4,$01,$10
VhTick:
    db $40,$47,$60,$01,$50
VhMore:
    db $40,$55,$30,$02,$40,$55,$F0,$01,$40,$40,$30,$02,$40,$40,$F0,$01,$40,$55,$30,$02,$40,$55,$F0,$01
    db $40,$40,$30,$05,$40,$40,$F0,$01,$50
VhOk:
    db $40,$7F,$30,$02,$40,$5F,$40,$02,$50
VhBack:
    db $40,$5F,$40,$02,$40,$7F,$50,$02,$50
VhStep:
    db $40,$FC,$51,$01,$40,$3B,$72,$01,$50
VhBump:
    db $40,$F9,$33,$02,$40,$FF,$53,$02,$50
VhStairs:
    db $40,$D6,$30,$02,$40,$D6,$F0,$01,$40,$FE,$30,$02,$40,$FE,$F0,$01,$40,$1D,$31,$02,$40,$1D,$F1,$01
    db $40,$53,$31,$04,$40,$53,$F1,$01,$50
VhFall:
    db $40,$7F,$20,$03,$40,$AA,$30,$03,$40,$E2,$30,$03,$40,$2E,$41,$03,$40,$94,$41,$03,$40,$1A,$52,$06
    db $50
VhBite:
    db $40,$40,$30,$01,$40,$50,$40,$01,$40,$5F,$50,$02,$50
VhBell:
    db $40,$8F,$30,$07,$40,$8F,$F0,$01,$40,$D6,$30,$0D,$40,$D6,$F0,$01,$50
VhDie:
    db $40,$1D,$21,$0B,$40,$1D,$F1,$01,$40,$2E,$21,$0B,$40,$2E,$F1,$01,$40,$41,$21,$0B,$40,$41,$F1,$01
    db $40,$AB,$21,$1D,$40,$AB,$F1,$01,$50
VhWin:
    db $40,$FE,$20,$05,$40,$FE,$F0,$01,$40,$D6,$20,$05,$40,$D6,$F0,$01,$40,$AA,$20,$05,$40,$AA,$F0,$01
    db $40,$7F,$20,$07,$40,$7F,$F0,$01,$40,$AA,$20,$05,$40,$AA,$F0,$01,$40,$7F,$20,$05,$40,$7F,$F0,$01
    db $40,$6B,$20,$1D,$40,$6B,$F0,$01,$50
VhScream:
    db $40,$40,$10,$03,$40,$47,$20,$03,$40,$50,$20,$03,$40,$5F,$30,$04,$40,$71,$40,$05,$40,$8F,$60,$08
    db $50

VhSoundTable:
    dw VhHush,$702B
    dw VhTick,$7035
    dw VhMore,$7035
    dw VhOk,$7035
    dw VhBack,$7035
    dw VhStep,$7035
    dw VhBump,$7035
    dw VhStairs,$7035
    dw VhFall,$7035
    dw VhBite,$7035
    dw VhBell,$7035
    dw VhDie,$7035
    dw VhWin,$7035
    dw VhScream,$7035
    dw VhTuneMel,$703F
    dw VhTuneBass,$7049
; Hunter's Dusk, D minor (original for this game)
; Tiny Sound, 14 frames per step
VhTuneMel:
    db $44
    dw sndtiny_1
    db 14
    db $02,$70,$F1,$22,$15,$00,$18,$1C,$00,$1A,$18,$00,$17,$15,$00,$00
    db $14,$00,$17,$1C,$00,$1A,$17,$00,$14,$10,$00,$00,$15,$00,$18,$1C
    db $00,$21,$1F,$00,$1D,$1C,$00,$1A,$18,$00,$17,$14,$00,$17,$15,$00
    db $00,$00,$00,$00
    db $FF
VhTuneBass:
    db $84
    dw sndtiny_2
    db 14
    db $02,$80,$18,$32,$09,$10,$15,$09,$10,$15,$04,$0B,$10,$04,$0B,$10
    db $04,$0B,$10,$04,$0B,$10,$09,$10,$15,$09,$10,$15,$09,$10,$15,$11
    db $18,$1D,$0E,$15,$1A,$04,$0B,$10,$04,$0B,$10,$04,$08,$0B,$09,$10
    db $15,$09,$01,$01
    db $FF
; engine.asm: the adventure engine (Z80), from The Hermit's (by way of
; Grim Oak Manor), for Vampyre Hunter: ten exits a room (six used), dark
; at night or in the castle without the lit lantern, the listing's carry
; limit by weight (50), word lists per verb kind, entry points for Amy to
; print messages and numbers.
; - text: packed messages (advc.py), word wrap and scrolling in the text
;   window (rows 9-18, columns 2-29), a MORE pause read straight from the
;   controller ports;
; - world: object locations, containers, exits, darkness, score;
; - rules: runs the bytecode lists made by advc.py (conditions, actions);
; - menus: builds the noun list for the verb picked and draws the picker.
; Call every entry point with the NMI off.
; Locations: 0 nowhere, 1-56 rooms, 100 carried, 102-112 inside a
; container (index = code - 101), 113 out of reach (the vine).

V_Rm      equ AMY_UVAR_Rm
V_Verb    equ AMY_UVAR_Verb
V_Noun    equ AMY_UVAR_Noun
V_Noun2   equ AMY_UVAR_Noun2
V_Score   equ AMY_UVAR_Score
V_Scene   equ AMY_UVAR_Scene
V_Dark    equ AMY_UVAR_Dark
V_Moves   equ AMY_UVAR_Moves
V_NCount  equ AMY_UVAR_NCount
V_Need    equ AMY_UVAR_NeedNoun
V_PkV     equ AMY_UVAR_PkV
V_PkN     equ AMY_UVAR_PkN
V_PkCol   equ AMY_UVAR_PkCol
V_PkMode  equ AMY_UVAR_PkMode
V_InMore  equ AMY_UVAR_InMore
V_OL      equ AMY_UVAR_OL
V_Fl      equ AMY_UVAR_Fl
V_Opn     equ AMY_UVAR_Opn
V_Pt      equ AMY_UVAR_Pt
V_NL      equ AMY_UVAR_NL
V_WBuf    equ AMY_UVAR_WBuf
V_RowBuf  equ AMY_UVAR_RowBuf
V_TxStk   equ AMY_UVAR_TxStk
V_TxPtr   equ AMY_UVAR_TxPtr
V_TxDepth equ AMY_UVAR_TxDepth
V_TCol    equ AMY_UVAR_TCol
V_TPend   equ AMY_UVAR_TPend
V_TWLen   equ AMY_UVAR_TWLen
V_TAlt    equ AMY_UVAR_TAlt
V_TLines  equ AMY_UVAR_TLines
V_StopF   equ AMY_UVAR_StopF
V_ContF   equ AMY_UVAR_ContF
V_Neg     equ AMY_UVAR_Neg
V_RootOp  equ AMY_UVAR_RootOp
V_T1      equ AMY_UVAR_T1
V_T2      equ AMY_UVAR_T2
V_T3      equ AMY_UVAR_T3
V_T4      equ AMY_UVAR_T4
V_NStart  equ AMY_UVAR_NStart
V_SaveN   equ AMY_UVAR_SaveN

HE_NAME   equ $1800
HE_PAT    equ $0000
HE_COL    equ $2000
HE_CARRIED equ 100
HE_LANTERN equ 6
HE_MAXWEIGHT equ 50
HE_CASTLE equ 68
HE_DIVIDER equ 96
HE_DARKSCENE equ 255

; ---------------------------------------------------------------------------
; Small helpers

; OLAddr: A = object -> HL = its location byte
OLAddr:
    ld e,a
    ld d,0
    ld hl,V_OL
    add hl,de
    ret

; FlAddr: A = flag -> HL
FlAddr:
    ld e,a
    ld d,0
    ld hl,V_Fl
    add hl,de
    ret

; ObjEnt: A = object or word -> HL = its 6-byte entry
ObjEnt:
    ld l,a
    ld h,0
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,de
    ld de,HeObjs
    add hl,de
    ret

; ResObj: operand 255 = the noun, 254 = the second noun
ResObj:
    cp 255
    jr nz,RoTwo
    ld a,(V_Noun)
    ret
RoTwo:
    cp 254
    ret nz
    ld a,(V_Noun2)
    ret

; ResLoc: operand 250 = the player's room
ResLoc:
    cp 250
    ret nz
    ld a,(V_Rm)
    ret

; Root: A = object -> A = room it is in, 100 when carried, 0 when nowhere
; or out of sight. V_RootOp = 1: a closed container hides what is inside.
Root:
    call OLAddr
    ld a,(hl)
    ret

; Visible: A = object -> A = 1 when the player can see it
Visible:
    ld (V_T1),a
    ld a,1
    ld (V_RootOp),a
    ld a,(V_T1)
    call Root
    cp HE_CARRIED
    jr z,VsYes
    ld c,a
    ld a,(V_Dark)
    or a
    jr nz,VsNo
    ld a,(V_Rm)
    cp c
    jr z,VsYes
    ld hl,HeScenery
VsSc:
    ld a,(hl)
    or a
    jr z,VsNo
    ld c,a
    inc hl
    ld b,(hl)
    inc hl
    ld a,(V_T1)
    cp c
    jr nz,VsSc
    ld a,(V_Rm)
    cp b
    jr nz,VsSc
VsYes:
    ld a,1
    ret
VsNo:
    xor a
    ret

; Have: A = object -> A = 1 when carried (even inside a closed container)
Have:
    ld c,a
    xor a
    ld (V_RootOp),a
    ld a,c
    call Root
    cp HE_CARRIED
    ld a,1
    ret z
    xor a
    ret

; Reach: A = object -> A = 1 when in hand or in an open container in hand
Reach:
    ld c,a
    ld a,1
    ld (V_RootOp),a
    ld a,c
    call Root
    cp HE_CARRIED
    ld a,1
    ret z
    xor a
    ret

; HasLight: A = 1 when the lit lantern is carried
HasLight:
    ld a,HF_LT
    call FlAddr
    ld a,(hl)
    or a
    ret z
    ld a,HE_LANTERN
    call OLAddr
    ld a,(V_Rm)
    cp (hl)
    ld a,1
    ret z
    ld a,HE_LANTERN
    jp Have

; UpdDark: dark at night (line 1880) and always in the castle (line 1180)
; without the lit lantern
UpdDark:
    xor a
    ld (V_Dark),a
    ld a,(V_Rm)
    cp HE_CASTLE
    jr z,UdChk
    ld a,HF_NIGHT
    call FlAddr
    ld a,(hl)
    or a
    ret z
UdChk:
    call HasLight
    or a
    ret nz
    ld a,1
    ld (V_Dark),a
    ret

; RoomEnt: HL = the entry (9 bytes: N S E W U D, description, picture)
; of the player's room
RoomEnt:
    ld a,(V_Rm)
    ld l,a
    ld h,0
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de
    ld de,HeRooms
    add hl,de
    ret

; GetExit: A = direction 0-9 -> A = room it leads to (0 = none); only
; N S E W (0-3) and U D (8, 9) are used
GetExit:
    cp 4
    jr c,GxSlot
    cp 8
    jr c,GxNone
    sub 4
GxSlot:
    ld (V_T2),a
    call RoomEnt
    ld a,(V_T2)
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    ret
GxNone:
    xor a
    ret

; CalcScore: Score = points earned
CalcScore:
    ld a,HF_SC
    call FlAddr
    ld a,(hl)
    ld (V_Score),a
    ret

; SetScene: the picture for the room (255 = darkness)
SetScene:
    ld a,(V_Dark)
    or a
    ld a,HE_DARKSCENE
    jr nz,SsSet
    call RoomEnt
    ld de,8
    add hl,de
    ld a,(hl)
    ld (V_Scene),a
    ret
SsSet:
    ld (V_Scene),a
    ret

; ---------------------------------------------------------------------------
; VDP

; VSetW / VSetR: HL = VRAM address to write / read
VSetW:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    or $40
    out ($BF),a
    ret
VSetR:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    ret

; RowCol: D = row, E = column -> HL = name table address
RowCol:
    ld l,d
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    add a,l
    ld l,a
    ld a,h
    adc a,HE_NAME/256
    ld h,a
    ret

; AltMap: A = character -> A = code in the current font (TAlt 0 white,
; 1 yellow, 2 black on yellow). Keeps BC, DE, HL.
AltMap:
    push bc
    ld c,a
    ld a,(V_TAlt)
    or a
    jr z,AmPlain
    dec a
    jr nz,AmInv
    ld a,c
    add a,128
    pop bc
    ret
AmInv:
    ld a,c
    cp 64
    jr nc,AmInvHi
    add a,96
    pop bc
    ret
AmInvHi:
    add a,160
    pop bc
    ret
AmPlain:
    ld a,c
    pop bc
    ret

; ---------------------------------------------------------------------------
; Text

; MsgStart: HL = message number
MsgStart:
    add hl,hl
    ld de,HeMsgTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld (V_TxPtr),hl
    xor a
    ld (V_TxDepth),a
    ret

; NextCh: A = next character of the message, 0 at its end
NextCh:
    ld hl,(V_TxPtr)
NcLp:
    ld a,(hl)
    inc hl
    or a
    jr z,NcEnd
    cp 32
    jr c,NcDict
    cp 96
    jr nc,NcHi
    ld (V_TxPtr),hl
    ret
NcHi:
    sub 65
    jr NcIdx
NcDict:
    dec a
NcIdx:
    ld c,a
    ex de,hl
    ld a,(V_TxDepth)
    ld l,a
    inc a
    ld (V_TxDepth),a
    ld h,0
    add hl,hl
    push bc
    ld bc,V_TxStk
    add hl,bc
    pop bc
    ld (hl),e
    inc hl
    ld (hl),d
    ld l,c
    ld h,0
    add hl,hl
    ld de,HeDict
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jr NcLp
NcEnd:
    ld a,(V_TxDepth)
    or a
    jr z,NcDone
    dec a
    ld (V_TxDepth),a
    ld l,a
    ld h,0
    add hl,hl
    ld de,V_TxStk
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jr NcLp
NcDone:
    ld (V_TxPtr),hl
    xor a
    ret

; PrintMsg: HL = message number, added to the text at the cursor
PrintMsg:
    call MsgStart
PmLp:
    call NextCh
    or a
    ret z
    call PutCh
    jr PmLp

; Say: HL = message number, as a new paragraph
Say:
    push hl
    call Para
    pop hl
    jr PrintMsg

; PutCh: A = character into the word buffer (a space ends the word)
PutCh:
    cp 32
    jr nz,PcWord
    call FlushWord
    ld a,(V_TCol)
    or a
    ret z
    ld a,1
    ld (V_TPend),a
    ret
PcWord:
    ld c,a
    ld a,(V_TWLen)
    cp 28
    jr c,PcAdd
    push bc
    call FlushWord
    pop bc
    ld a,(V_TWLen)
PcAdd:
    ld e,a
    ld d,0
    ld hl,V_WBuf
    add hl,de
    ld (hl),c
    inc a
    ld (V_TWLen),a
    ret

; FlushWord: write the buffered word on the bottom line, wrapping first
FlushWord:
    ld a,(V_TWLen)
    or a
    ret z
    ld b,a
    ld a,(V_TPend)
    add a,b
    ld b,a
    ld a,(V_TCol)
    add a,b
    cp 29
    jr c,FwFits
    call NewLine
FwFits:
    ld d,18
    ld a,(V_TCol)
    add a,2
    ld e,a
    call RowCol
    call VSetW
    ld a,(V_TPend)
    or a
    jr z,FwWord
    ld a,32
    out ($BE),a
    ld hl,V_TCol
    inc (hl)
FwWord:
    xor a
    ld (V_TPend),a
    ld a,(V_TWLen)
    ld b,a
    ld hl,V_WBuf
FwLp:
    ld a,(hl)
    call AltMap
    out ($BE),a
    inc hl
    djnz FwLp
    ld a,(V_TWLen)
    ld b,a
    ld a,(V_TCol)
    add a,b
    ld (V_TCol),a
    xor a
    ld (V_TWLen),a
    ret

; Para: start a new paragraph on a fresh line
Para:
    call FlushWord
    xor a
    ld (V_TPend),a
    ld a,(V_TCol)
    or a
    ret z
    ; fall into NewLine

; NewLine: scroll the window up one line (pausing when it is full)
NewLine:
    ld a,(V_TLines)
    cp 10
    call nc,SaveTop
    call ScrollUp
    xor a
    ld (V_TCol),a
    ld (V_TPend),a
    ld hl,V_TLines
    inc (hl)
    ret

; ScrollUp: rows 10-18 move to 9-17; row 18 is cleared
ScrollUp:
    ld d,10
SuLp:
    push de
    ld e,2
    call RowCol
    call VSetR
    ld hl,V_RowBuf
    ld b,28
SuRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz SuRd
    pop de
    push de
    dec d
    ld e,2
    call RowCol
    call VSetW
    ld hl,V_RowBuf
    ld b,28
SuWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz SuWr
    pop de
    inc d
    ld a,d
    cp 19
    jr c,SuLp
    ld d,18
    ld e,2
    call RowCol
    call VSetW
    ld b,28
SuClr:
    ld a,32
    out ($BE),a
    nop
    djnz SuClr
    ret

; ClearRows: D = first row, B = number of rows (columns 2-29)
ClearRows:
    push bc
    push de
    ld e,2
    call RowCol
    call VSetW
    ld b,28
CrLp:
    ld a,32
    out ($BE),a
    nop
    djnz CrLp
    pop de
    pop bc
    inc d
    djnz ClearRows
    ret

; More: the window is full; show MORE and wait for a side button
; SaveTop: the window is full: the top line goes to the history in VRAM
; ($3A80, 28 bytes a line) before it scrolls away. After the turn, Amy
; pages through it (MORE) when the turn wrote more than the window holds.
HE_HIST equ $3A80
HE_HISTMAX equ 40
SaveTop:
    ld a,(AMY_UVAR_HistN)
    cp HE_HISTMAX
    ret nc
    ld d,9
    jp HistPut

; HistPut: row D of the window -> history line HistN, HistN + 1
HistPut:
    ld e,2
    call RowCol
    call VSetR
    ld hl,V_RowBuf
    ld b,28
HpRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HpRd
    ld a,(AMY_UVAR_HistN)
    call HistAddr
    call VSetW
    ld hl,V_RowBuf
    ld b,28
HpWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HpWr
    ld hl,AMY_UVAR_HistN
    inc (hl)
    ret

; HistAddr: A = history line -> HL = its VRAM address
HistAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    add hl,hl
    or a
    sbc hl,de
    ld de,HE_HIST
    add hl,de
    ret

; HeHistFinish: add the ten lines of the window to the history
HeHistFinish:
    ld d,9
HhfLp:
    push de
    call HistPut
    pop de
    inc d
    ld a,d
    cp 19
    jr c,HhfLp
    ret

; HeHistShow: history lines Pg .. Pg + 9 into the window
HeHistShow:
    ld d,9
HhsLp:
    push de
    ld a,d
    sub 9
    ld hl,AMY_UVAR_Pg
    add a,(hl)
    call HistAddr
    call VSetR
    ld hl,V_RowBuf
    ld b,28
HhsRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HhsRd
    pop de
    push de
    ld e,2
    call RowCol
    call VSetW
    ld hl,V_RowBuf
    ld b,28
HhsWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HhsWr
    pop de
    inc d
    ld a,d
    cp 19
    jr c,HhsLp
    ret

; HeMoreMark: " - MORE - " on row 19
HeMoreMark:
    ld d,19
    ld e,11
    call RowCol
    call VSetW
    ld hl,HeMoreTxt
    ld b,10
MoLp:
    ld a,(hl)
    add a,128
    out ($BE),a
    inc hl
    djnz MoLp
    ret
HeMoreTxt:
    db " - MORE - "

; DrawDivider: the line on row 19
HeDrawDivider:
DrawDivider:
    ld d,19
    ld e,2
    call RowCol
    call VSetW
    ld b,28
DdLp:
    ld a,HE_DIVIDER
    out ($BE),a
    nop
    djnz DdLp
    ret

; PrintNum: HL = number (0-9999), into the text
PrintNum:
    xor a
    ld (V_NStart),a
    ld de,1000
    call PnDig
    ld de,100
    call PnDig
    ld de,10
    call PnDig
    ld a,l
    add a,48
    jp PutCh
PnDig:
    ld a,47
PnSub:
    inc a
    or a
    sbc hl,de
    jr nc,PnSub
    add hl,de
    cp 48
    jr nz,PnOut
    ld c,a
    ld a,(V_NStart)
    or a
    ret z
    ld a,c
PnOut:
    ld c,a
    ld a,1
    ld (V_NStart),a
    ld a,c
    push hl
    call PutCh
    pop hl
    ret

; PrintObj: A = object -> its menu name; PrintFull: its full name;
; PrintArt: "A ", "AN " or "SOME " and its full name
PrintObj:
    call ObjEnt
    jr PoMsg
PrintFull:
    call ObjEnt
    inc hl
    inc hl
PoMsg:
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jp PrintMsg
PrintArt:
    push af
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    rrca
    rrca
    rrca
    and 3
    ld l,a
    ld h,0
    ld de,SysA
    add hl,de
    call PrintMsg
    pop af
    jr PrintFull

; ---------------------------------------------------------------------------
; Rules

; RunList: HL = rule list, A = 1 to run every rule that matches.
; Returns A = 1 when a rule ran.
RunList:
    ld c,a
    ld b,0
RlRule:
    ld a,(hl)
    or a
    jr z,RlEnd
    push bc
    ld e,a
    ld d,0
    inc hl
    push hl
    add hl,de
    ex (sp),hl
    call EvalConds
    or a
    jr z,RlSkip
    pop de
    push de
    xor a
    ld (V_ContF),a
    call ExecActs
    pop hl
    pop bc
    ld b,1
    ld a,(V_StopF)
    or a
    jr nz,RlEnd
    ld a,c
    or a
    jr nz,RlRule
    ld a,(V_ContF)
    or a
    jr nz,RlRule
RlEnd:
    ld a,b
    ret
RlSkip:
    pop hl
    pop bc
    jr RlRule

; EvalConds: HL = conditions -> A = 1 when all hold (HL = first action)
EvalConds:
    xor a
    ld (V_Neg),a
EcLp:
    ld a,(hl)
    cp $40
    jr nc,EcPass
    inc hl
    cp $0B
    jr nz,EcGo
    ld a,1
    ld (V_Neg),a
    jr EcLp
EcGo:
    dec a
    add a,a
    push hl
    ld l,a
    ld h,0
    ld de,EcTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ex (sp),hl
    ret
EcRes:
    ld c,a
    ld a,(V_Neg)
    xor c
    ld c,a
    xor a
    ld (V_Neg),a
    ld a,c
    or a
    jr nz,EcLp
    ret
EcPass:
    ld a,1
    ret

EcTab:
    dw CNoun, CNoun2, CRoom, CRoomIn, CHere, CHave, CAt, CFlag
    dw CFlagGe, EcPass, EcPass, CLight, EcPass, EcPass, CNounIn

CmpRes:
    ld a,1
    jp z,EcRes
    xor a
    jp EcRes

CNoun:
    ld a,(V_Noun)
    cp (hl)
    inc hl
    jr CmpRes
CNoun2:
    ld a,(V_Noun2)
    cp (hl)
    inc hl
    jr CmpRes
CRoom:
    ld a,(V_Rm)
    cp (hl)
    inc hl
    jr CmpRes
CRoomIn:
    ld a,(V_Rm)
    ld c,a
    ld a,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld e,0
    cp c
    jr z,CriLo
    jr nc,CriNo
CriLo:
    ld a,b
    cp c
    jr c,CriNo
    ld e,1
CriNo:
    ld a,e
    jp EcRes
CHere:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call Visible
    pop hl
    jp EcRes
CHave:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call Have
    pop hl
    jp EcRes
CAt:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    push bc
    call ResObj
    call OLAddr
    pop bc
    ld a,c
    push hl
    call ResLoc
    pop hl
    cp (hl)
    pop hl
    jr CmpRes
CFlag:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    pop hl
    cp c
    jr CmpRes
CFlagGe:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    pop hl
    cp c
    ld a,0
    jp c,EcRes
    inc a
    jp EcRes
CLight:
    push hl
    call UpdDark
    pop hl
    ld a,(V_Dark)
    xor 1
    jp EcRes
CNounIn:
    ld b,(hl)
    inc hl
    ld e,0
    ld a,(V_Noun)
CniLp:
    cp (hl)
    inc hl
    jr nz,CniNext
    ld e,1
CniNext:
    djnz CniLp
    ld a,e
    jp EcRes

; IsOpen: A = object -> A = 1 when it is an open container
ExecActs:
    ld a,l
    cp e
    jr nz,EaGo
    ld a,h
    cp d
    ret z
EaGo:
    push de
    ld a,(hl)
    inc hl
    sub $40
    add a,a
    push hl
    ld l,a
    ld h,0
    ld de,EaTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ex (sp),hl
    ret
EaNext:
    pop de
    ld a,(V_StopF)
    or a
    ret nz
    jr ExecActs

EaTab:
    dw AMsg, ASetL, ASetF, AAddF, AGoto, AStop, AStop, ADie
    dw AWin, ALook, ACont, ABuiltin, AStop, AStop, ASetNoun

AMsg:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ex de,hl
    call Say
    pop hl
    jp EaNext
ASetL:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    push bc
    call ResObj
    call OLAddr
    pop bc
    ld a,c
    push hl
    call ResLoc
    pop hl
    ld (hl),a
    pop hl
    jp EaNext
ASetF:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld (hl),c
    pop hl
    jp EaNext
AAddF:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    add a,c
    ld (hl),a
    pop hl
    jp EaNext
AGoto:
    ld a,(hl)
    inc hl
    push hl
    ld (V_Rm),a
    call EnterRoom
    call DoLook
    pop hl
    jp EaNext
ADie:
    ld a,HF_DEAD
    jr AStop
AWin:
    ld a,HF_WIN
AStop:
    push hl
    call FlAddr
    ld (hl),1
    ld a,1
    ld (V_StopF),a
    pop hl
    jp EaNext
ALook:
    push hl
    call DoLook
    pop hl
    jp EaNext
ACont:
    ld a,1
    ld (V_ContF),a
    jp EaNext
ABuiltin:
    ld a,(hl)
    inc hl
    push hl
    add a,a
    ld l,a
    ld h,0
    ld de,BiTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,AbRet
    push de
    jp (hl)
AbRet:
    pop hl
    jp EaNext
ASetNoun:
    ld a,(hl)
    inc hl
    ld (V_Noun),a
    jp EaNext

BiTab:
    dw BGo, BInv, BGo, BTake, BDrop, BExam, BGo, BGo, BGo

; ---------------------------------------------------------------------------
; Built-in verbs

; EnterRoom: darkness changes with the room
EnterRoom:
    jp UpdDark

BGo:
    ld a,(V_Noun)
    sub 70
    call GetExit
    or a
    jr nz,BgMove
    ld hl,SysNoWay
    jp Say
BgMove:
    ld (V_Rm),a
    call EnterRoom
    jp DoLook

BInv:
    ld hl,SysCarrying
    call Say
    xor a
    ld (V_T3),a
    ld c,1
BiLp:
    push bc
    ld a,c
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BiNext
    call Para
    pop bc
    push bc
    ld a,c
    call PrintFull
    ld a,1
    ld (V_T3),a
BiNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,BiLp
    ld a,(V_T3)
    or a
    ret nz
    ld hl,SysNothing
    jp Say

BTake:
    ld a,(V_Noun)
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BtNotYet
    ld hl,SysHaveIt
    jp Say
BtNotYet:
    ld a,(V_Noun)
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    and 3
    jr nz,BtSolid
    ld hl,SysFlows
    jp Say
BtSolid:
    cp 2
    jr nz,BtOk
    ld hl,SysStays
    jp Say
BtOk:
    ; the listing (line 1385): the load may weigh 50 at most
    ld a,(V_Noun)
    call WeightOf
    ld c,a
    ld hl,V_OL+1
    ld b,1
BtCnt:
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BtCn2
    push hl
    push bc
    ld a,b
    call WeightOf
    pop bc
    add a,c
    ld c,a
    pop hl
BtCn2:
    inc hl
    inc b
    ld a,b
    cp HE_NOBJ+1
    jr c,BtCnt
    ld a,c
    cp HE_MAXWEIGHT+1
    jr c,BtRoom
    ld hl,SysHeavy
    jp Say
; WeightOf: A = object -> A = its weight
WeightOf:
    ld e,a
    ld d,0
    ld hl,HeWeight
    add hl,de
    ld a,(hl)
    ret
BtRoom:
    ld a,(V_Noun)
    call OLAddr
    ld (hl),HE_CARRIED
    ld hl,SysTaken
    jp Say

BDrop:
    ld a,(V_Noun)
    call Have
    or a
    jr nz,BdOk
    ld hl,SysNoHave
    jp Say
BdOk:
    ld a,(V_Noun)
    call OLAddr
    ld a,(V_Rm)
    ld (hl),a
    ld hl,SysDropped
    jp Say

BExam:
    ld hl,SysNothingSpecial
    jp Say

; DoLook: describe the room
DoLook:
    call UpdDark
    ld a,(V_Dark)
    or a
    jr z,LkLit
    ld hl,SysDark
    call Say
    jp LkExits
LkLit:
    ld hl,SysYouAre
    call Say
    call RoomEnt
    ld de,6
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call PrintMsg
LkRules:
    ld hl,HeR_LOOKX
    ld a,1
    call RunList
    ld c,1
LkObj:
    push bc
    ld a,c
    call OLAddr
    ld a,(V_Rm)
    cp (hl)
    jr nz,LkON
    ; things that stay put are part of the description (LOOKX)
    pop bc
    push bc
    ld a,c
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    and 3
    cp 2
    jr z,LkON
    ld hl,SysThereIs
    call Say
    pop bc
    push bc
    ld a,c
    call PrintArt
    ld hl,SysHere
    call PrintMsg
LkON:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,LkObj
LkExits:
    ld a,(V_Rm)
    cp HE_CASTLE
    ret z
    ld hl,SysExits
    call Say
    ld a,(V_Dark)
    or a
    jr z,LkEx2
    ld hl,SysWhoKnows
    jp PrintMsg
LkEx2:
    xor a
    ld (V_T3),a
    ld c,0
LkE:
    push bc
    ld a,c
    call GetExit
    or a
    jr z,LkEN
    ld a,32
    call PutCh
    pop bc
    push bc
    ld l,c
    ld h,0
    ld de,SysDir0
    add hl,de
    call PrintMsg
    ld a,1
    ld (V_T3),a
LkEN:
    pop bc
    inc c
    ld a,c
    cp 10
    jr c,LkE
    ld a,(V_T3)
    or a
    jr nz,LkDot
    ld hl,SysNoExits
    jp PrintMsg
LkDot:
    ld a,46
    jp PutCh

; ---------------------------------------------------------------------------
; Entry points (called from Amy)

; HeStart: a new game
HeStart:
    ld hl,HeObjStart
    ld de,V_OL
    ld bc,HE_NOBJ+1
    ldir
    ld hl,HeFlagStart
    ld de,V_Fl
    ld bc,HE_NFLAGS
    ldir
    ld hl,HeContOpen
    ld de,V_Opn
    ld bc,HE_NCONT+1
    ldir
    xor a
    ld (V_StopF),a
    ld (V_TCol),a
    ld (V_TPend),a
    ld (V_TWLen),a
    ld (V_TAlt),a
    ld (V_TLines),a
    ld (V_InMore),a
    ld hl,0
    ld (V_Moves),hl
    ld a,1
    ld (V_Rm),a
    ld d,9
    ld b,10
    call ClearRows
    call DrawDivider
    call DoLook
    call FlushWord
    call UpdDark
    call CalcScore
    jp SetScene

; HeTurn: run Verb / Noun / Noun2
HeTurn:
    xor a
    ld (AMY_UVAR_HistN),a
    ld (V_StopF),a
    ld (V_TLines),a
    call Echo
    ld hl,(V_Moves)
    inc hl
    ld (V_Moves),hl
    call UpdDark
    ld a,(V_Verb)
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbRules
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    call RunList
    ld a,(V_StopF)
    or a
    jr nz,HtEnd
    call UpdDark
    ld hl,HeR_EVERY
    ld a,1
    call RunList
HtEnd:
    call FlushWord
    call UpdDark
    call CalcScore
    jp SetScene

; HeSay: HL = message number as a paragraph (for Amy), then flush
HeSay:
    call Say
    jp FlushWord
; For Amy: AMY_UVAR_MsgId as a paragraph / added to the line; AMY_UVAR_NumU
; as a number added to the line; HeEnd ends the text (flushes the word)
HeSayV:
    ld hl,(AMY_UVAR_MsgId)
    call Say
    jp FlushWord
HeMsgV:
    ld hl,(AMY_UVAR_MsgId)
    call PrintMsg
    jp FlushWord
HeNumV:
    ld hl,(AMY_UVAR_NumU)
    call PrintNum
    jp FlushWord
HeLookV:
    call DoLook
    call FlushWord
    call UpdDark
    jp SetScene
HeDarkV:
    call UpdDark
    jp SetScene
; HeClearWin: an empty text window (for the HOW TO PLAY and credits pages)
HeClearWin:
    ld d,9
    ld b,10
    call ClearRows
    xor a
    ld (V_TCol),a
    ld (V_TPend),a
    ld (V_TWLen),a
    ld (V_TLines),a
    ld (V_TAlt),a
    ld (AMY_UVAR_HistN),a
    ret
; HeExitV: AMY_UVAR_RQ = room, AMY_UVAR_RK = slot 0-5 (N S E W U D) ->
; AMY_UVAR_IV = the room that way (0 = none)
HeExitV:
    ld a,(V_Rm)
    push af
    ld a,(AMY_UVAR_RQ)
    ld (V_Rm),a
    call RoomEnt
    pop af
    ld (V_Rm),a
    ld a,(AMY_UVAR_RK)
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_IV),a
    ret
; HePad: both controllers -> Up1 Dn1 Lf1 Rt1 Btn Btn2 (0/1)
HePad:
    ld a,(JOYPAD_1)
    ld b,a
    ld a,(JOYPAD_2)
    or b
    ld b,a
    and 1
    ld (AMY_UVAR_Up1),a
    ld a,b
    rrca
    and 1
    ld (AMY_UVAR_Rt1),a
    ld a,b
    rrca
    rrca
    and 1
    ld (AMY_UVAR_Dn1),a
    ld a,b
    rrca
    rrca
    rrca
    and 1
    ld (AMY_UVAR_Lf1),a
    ld a,b
    rlca
    and 1
    ld (AMY_UVAR_Btn),a
    ld a,b
    rlca
    rlca
    and 1
    ld (AMY_UVAR_Btn2),a
    ret
; HeBegin: a castle step starts a fresh page of text (as HeTurn does)
HeBegin:
    xor a
    ld (AMY_UVAR_HistN),a
    ld (V_StopF),a
    ld (V_TLines),a
    ret

; Echo: "> VERB NOUN [IN NOUN2]" in yellow
Echo:
    call Para
    ld a,1
    ld (V_TAlt),a
    ld hl,SysPrompt
    call PrintMsg
    ld a,(V_Verb)
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbMsg
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call PrintMsg
    ld a,(V_Noun)
    or a
    jr z,EchoEnd
    ld a,32
    call PutCh
    ld a,(V_Noun)
    call PrintObj
    ld a,(V_Noun2)
    or a
    jr z,EchoEnd
    ld hl,SysIn
    call PrintMsg
    ld a,(V_Noun2)
    call PrintObj
EchoEnd:
    call FlushWord
    xor a
    ld (V_TAlt),a
    ret

; HeNouns: the noun list for Verb (NL, NCount, NeedNoun)
HeNouns:
    call UpdDark
    xor a
    ld (V_NCount),a
    ld a,(V_Verb)
    ld e,a
    ld d,0
    ld hl,HeVerbKind
    add hl,de
    ld a,(hl)
    ld (V_Need),a
    ld (V_T3),a
    or a
    ret z
    cp 1
    jr z,HnDir
    cp 5
    jr nc,HnSay
    ld c,1
HnLp:
    push bc
    ld a,c
    ld (V_T4),a
    ld a,(V_T3)
    cp 4
    jr z,HnHeld
    ld a,(V_T4)
    call Visible
    or a
    jr z,HnNext
    ld a,(V_T3)
    cp 3
    jr nz,HnAdd
    ld a,(V_T4)
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr z,HnNext
    jr HnAdd
HnHeld:
    ld a,(V_T4)
    call Reach
    or a
    jr z,HnNext
HnAdd:
    ld a,(V_T4)
    call AddNoun
HnNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,HnLp
    ret
; GO lists the ways out (all ten in the dark: who knows?)
HnDir:
    ld c,0
HndLp:
    push bc
    ld a,(V_Dark)
    or a
    jr nz,HndAdd
    ld a,c
    call GetExit
    or a
    jr z,HndNx
HndAdd:
    pop bc
    push bc
    ld a,c
    add a,70
    call AddNoun
HndNx:
    pop bc
    inc c
    ld a,c
    cp 10
    jr c,HndLp
    ret
; SAY and CRACK: word, flag pairs (255 = always; else once the flag is set)
HnSay:
HnDial:
    ; kind 5 and up: word list kind - 5
    ld a,(V_T3)
    sub 5
    add a,a
    ld e,a
    ld d,0
    ld hl,HeWordLists
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
HnWords:
    ld a,(hl)
    or a
    ret z
    ld b,a
    inc hl
    ld a,(hl)
    inc hl
    cp 255
    jr z,HnwAdd
    push hl
    push bc
    call FlAddr
    ld a,(hl)
    pop bc
    pop hl
    or a
    jr z,HnWords
HnwAdd:
    push hl
    ld a,b
    call AddNoun
    pop hl
    jr HnWords
AddNoun:
    ld hl,V_NCount
    ld e,(hl)
    inc (hl)
    ld d,0
    ld hl,V_NL
    add hl,de
    ld (hl),a
    ret

; PrintFixed: HL = message, D = row, E = column, B = width (no wrap,
; padded with spaces in the current font)
PrintFixed:
    push bc
    push de
    call MsgStart
    pop de
    call RowCol
    call VSetW
    pop bc
PfLp:
    push bc
    call NextCh
    pop bc
    or a
    jr z,PfPad
    call AltMap
    out ($BE),a
    djnz PfLp
    ret
PfPad:
    ld a,32
    call AltMap
    out ($BE),a
    nop
    djnz PfPad
    ret

; PutAt: A = character at D,E
PutAt:
    push af
    call RowCol
    call VSetW
    pop af
    out ($BE),a
    ret

; HeDrawPick: the verb and noun picker on rows 20-22
HeDrawPick:
    ld d,20
    ld b,3
    call ClearRows
    ; verbs: the one before, the current one, the one after
    ld c,0
DpV:
    push bc
    ld a,(V_PkMode)
    or a
    jr z,DpVShow
    ld a,c
    cp 1
    jr nz,DpVNext
DpVShow:
    ld a,(V_PkV)
    add a,c
    dec a
    jp p,DpVPos
    add a,HE_NVERBS
DpVPos:
    cp HE_NVERBS
    jr c,DpVOk
    sub HE_NVERBS
DpVOk:
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbMsg
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    ld (V_TAlt),a
    ld a,c
    cp 1
    jr nz,DpVDraw
    ld a,(V_PkCol)
    or a
    jr nz,DpVDraw
    ld a,2
    ld (V_TAlt),a
DpVDraw:
    ld a,20
    add a,c
    ld d,a
    ld e,3
    ld b,9
    call PrintFixed
DpVNext:
    pop bc
    inc c
    ld a,c
    cp 3
    jr c,DpV
    xor a
    ld (V_TAlt),a
    ; nouns
    ld a,(V_Need)
    or a
    jr z,DpMarks
    ld a,(V_NCount)
    or a
    jr nz,DpNList
    ld hl,SysNone
    ld d,21
    ld e,14
    ld b,16
    call PrintFixed
    jr DpMarks
DpNList:
    ld c,0
DpN:
    push bc
    ld a,(V_PkN)
    add a,c
    dec a
    jp m,DpNNext
    ld hl,V_NCount
    cp (hl)
    jr nc,DpNNext
    ld e,a
    ld d,0
    ld hl,V_NL
    add hl,de
    ld a,(hl)
    call ObjEnt
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    ld (V_TAlt),a
    ld a,c
    cp 1
    jr nz,DpNDraw
    ld a,(V_PkCol)
    or a
    jr z,DpNDraw
    ld a,2
    ld (V_TAlt),a
DpNDraw:
    ld a,20
    add a,c
    ld d,a
    ld e,14
    ld b,16
    call PrintFixed
DpNNext:
    pop bc
    inc c
    ld a,c
    cp 3
    jr c,DpN
    xor a
    ld (V_TAlt),a
DpMarks:
    ld a,(V_PkCol)
    or a
    ld a,62
    jr z,DpM1
    ld a,32
DpM1:
    ld d,21
    ld e,2
    call PutAt
    ld a,(V_PkCol)
    or a
    ld a,32
    jr z,DpM2
    ld a,62
DpM2:
    ld d,21
    ld e,13
    call PutAt
    ; row 19: the divider, with "IN WHAT?" while choosing where to put
    call DrawDivider
    ld a,(V_PkMode)
    or a
    ret z
    ld a,1
    ld (V_TAlt),a
    ld hl,SysInWhat
    ld d,19
    ld e,14
    ld b,8
    call PrintFixed
    xor a
    ld (V_TAlt),a
    ret

; HeFonts: the fonts: yellow font (codes 160-223) in the middle and bottom thirds,
; black-on-yellow font (codes 128-159, 224-255) and the divider (96) in
; the bottom third
HeFonts:
    ld bc,$03FF         ; R3: three colour tables, one per screen third
    call WRITE_REGISTER
    ld a,1
    call HfThird
    ld a,2
    call HfThird
    ; divider
    ld hl,HE_PAT+$1000+HE_DIVIDER*8
    call VSetW
    ld hl,HeDivPat
    ld b,8
HfDp:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HfDp
    ld hl,HE_COL+$1000+HE_DIVIDER*8
    call VSetW
    ld b,8
HfDc:
    ld a,$40
    out ($BE),a
    nop
    djnz HfDc
    ret
HeDivPat:
    db $00,$00,$00,$AA,$55,$00,$00,$00

; HfThird: A = third (1 or 2)
HfThird:
    add a,a
    add a,a
    add a,a
    ld (V_T3),a         ; high byte of the third's offset ($0800 or $1000)
    ld c,32
HfCh:
    push bc
    ; read the glyph
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(V_T3)
    add a,h
    ld h,a
    call VSetR
    ld hl,V_RowBuf
    ld b,8
HfRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HfRd
    pop bc
    push bc
    ; yellow copy at code + 128
    ld a,c
    add a,128
    ld (V_T4),a
    ld a,$B0
    call HfPut
    ; black on yellow copy (bottom third only)
    ld a,(V_T3)
    cp $10
    jr nz,HfNext
    pop bc
    push bc
    ld a,c
    cp 64
    jr nc,HfHi
    add a,96
    jr HfInv
HfHi:
    add a,160
HfInv:
    ld (V_T4),a
    ld a,$1B
    call HfPut
HfNext:
    pop bc
    inc c
    ld a,c
    cp 96
    jr c,HfCh
    ret

; HfPut: glyph in RowBuf -> code T4 of third T3, colour A
HfPut:
    push af
    ld a,(V_T4)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(V_T3)
    add a,h
    ld h,a
    push hl
    call VSetW
    ld hl,V_RowBuf
    ld b,8
HpP:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HpP
    pop hl
    ld de,HE_COL
    add hl,de
    call VSetW
    pop af
    ld b,8
HpC:
    out ($BE),a
    nop
    djnz HpC
    ret

; HeDisplayOn: display on, NMI left off (R1 bit 6 on, bit 5 off)
HeDisplayOn:
    ld a,(VDP_R1_SHADOW)
    or $40
    and $DF
    ld (VDP_R1_SHADOW),a
    ld c,a
    ld b,1
    jp WRITE_REGISTER
