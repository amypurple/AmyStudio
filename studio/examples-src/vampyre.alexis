data SceneFam bytes 0,2,4,3,3,4,2,1,4,0,3,1
data FamPatTab words = @HeFamPat0, @HeFamPat1, @HeFamPat2, @HeFamPat3, @HeFamPat4
data FamColTab words = @HeFamCol0, @HeFamCol1, @HeFamCol2, @HeFamCol3, @HeFamCol4
data SceneMapTab words
  @HeMap0, @HeMap1, @HeMap2, @HeMap3, @HeMap4, @HeMap5, @HeMap6, @HeMap7,
  @HeMap8, @HeMap9, @HeMap10, @HeMap11
end data

' ShowScene: the picture of Scene on rows 1-7 (255 = darkness). The tile
' set of its family is unpacked only when the family changes.
sub ShowScene:
  Shown = Scene
  if Scene = 255 then
    for Y = 1 to 7
      fill 32 count 28 at 2,Y
    next
    print at 7,4, "IT IS PITCH DARK."
    return
  end if
  Fam = SceneFam[Scene]
  if Fam <> FamShown then
    decompress zx0 FamPatTab[Fam] to vram.pattern + 1024
    decompress zx0 FamColTab[Fam] to vram.color + 1024
    FamShown = Fam
  end if
  decompress zx0 SceneMapTab[Scene] to vram.name + 32
  return
end sub

' ShowCreatures: the vampire stands in the picture when he is here; a bat
' flits over the outdoor places at night
sub ShowCreatures:
  sprites 16x16
  sprites simple
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  Spooky = 0
  if Dark = 0 then
    if OL.OVampire = Rm then
      Creature(6, 96, SVampireDL, 13, 15)
    else
      SetNight
      if Fl.FNight = 1 then
        select case Scene
        case 2 to 6
          Spooky = 0
        case else
          Spooky = 2
        end select
      end if
    end if
  end if
  Animate
  return
end sub

' Animate: once a frame; the bat over the picture, the castle's creatures
sub Animate:
  inc Anim
  if InCastle = 1 then
    V = Anim & 31
    if V = 0 then
      if MenuOpen = 0 then DrawCastleCrit
    end if
    return
  end if
  if Spooky = 0 then return
  V = Anim & 1
  if V = 0 then
    inc BatX
    V = BatX & 63
    if V < 32 then
      BatY = 6 + V / 4
    else
      V = 63 - V
      BatY = 6 + V / 4
    end if
  end if
  J = SBatA
  V = Anim & 16
  if V > 0 then J = SBatB
  set sprite 0 to BatY, BatX, J, 14
  update sprites
  return
end sub

' DrawCastleCrit: the creatures change frames (every 32 frames)
sub DrawCastleCrit:
  if Fl.FLt = 0 then return
  T4 = Anim & 32
  for J = 0 to 15
    if CrK[J] > 0 then
      if CrL[J] = CLv then
        V = CrY[J]
        if V >= ViewTop then
          if V < ViewTop + 7 then
            T1 = V - ViewTop
            T1 = T1 + 1
            T2 = CrX[J] + 2
            if CrK[J] = 1 then
              T3 = TRatA
              if T4 > 0 then T3 = TRatB
            else
              T3 = TBatA
              if T4 > 0 then T3 = TBatB
            end if
            put char T3 at T2,T1
          end if
        end if
      end if
    end if
  next
  return
end sub

' Creature: four sprites (details first, so they are drawn on top)
sub Creature(u8 CYp, u8 CXp, u8 CP, u8 CBody, u8 CDet):
  V = CXp + 16
  J = CP + 4
  set sprite 0 to CYp, CXp, CP, CDet
  set sprite 1 to CYp, V, J, CDet
  J = CP + 8
  set sprite 2 to CYp, CXp, J, CBody
  J = CP + 12
  set sprite 3 to CYp, V, J, CBody
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub EditorialPage:
  PageStart
  Scene = TitleScene
  ShowScene
  print at 8,8, "VAMPYRE HUNTER"
  SayMsg(MxCredit1)
  SayMsg(MxCredit2)
  print at 8,20, "BY MARC SUGIYAMA"
  print at 3,21, "COMPUTE!'S GAZETTE MAY 1986"
  print at 8,22, "PRESS A BUTTON"
  screen on
  nmi off
  WaitPress
  return
end sub

' PageStart: a blank page with the fonts and an empty text window
sub PageStart:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  call asm HeClearWin
  FamShown = 255
  Shown = 255
  InCastle = 0
  return
end sub

sub WaitPress:
  WasBtn = 1
  WasBtn2 = 1
  Press = 0
  Press2 = 0
  while Press = 0 and Press2 = 0
    Frame1
    ReadPad
  end while
  return
end sub

sub TitlePage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  Scene = TitleScene
  Shown = 255
  FamShown = 255
  ShowScene
  print at 8,10, "VAMPYRE HUNTER"
  print at 3,12, "HUNT THE VAMPYRE DOWN!"
  print at 12,16, "PLAY"
  print at 12,18, "HOW TO PLAY"
  print at 12,20, "CREDITS"
  print at 2,22, "1986 MARC SUGIYAMA    2026"
  Menu = 0
  Spooky = 2
  InCastle = 0
  BatX = 200
  screen on
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 672
  TzOn = 1
  WasBtn = 1
  WasBtn2 = 1
title_loop:
  Frame1
  Animate
  ReadPad
  ' stir the random numbers while the player looks at the title
  inc Seed
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTick
  end if
  print at 10,16, " "
  print at 10,18, " "
  print at 10,20, " "
  Y = Menu * 2
  Y = Y + 16
  print at 10,Y, ">"
  if Press = 1 then goto title_done
  goto title_loop
title_done:
  mute all
  TzOn = 0
  Spooky = 0
  play sound SndOk
  return
end sub

' HOW TO PLAY: three pages with pictures from the game; a button turns
' the page; the last page or 30 seconds alone go back to the title
sub HelpPages:
  for Pg = 0 to 2
    PageStart
    if Pg = 0 then
      Scene = 0
      ShowScene
      print at 8,8, "HOW TO PLAY 1/3"
      SayMsg(MxHelp1)
      SayMsg(MxHelp1b)
    end if
    if Pg = 1 then
      ' a corner of the castle's second floor, lit
      copy TilePat count NTiles8 to vram.pattern + 1024
      copy TileCol count NTiles8 to vram.color + 1024
      NewWorld
      CLv = 1
      CX = 3
      CY = 17
      Fl.FLt = 1
      DrawCastle
      print at 8,8, "HOW TO PLAY 2/3"
      SayMsg(MxHelp2)
    end if
    if Pg = 2 then
      Creature(6, 104, SVampireDL, 13, 15)
      print at 8,8, "HOW TO PLAY 3/3"
      SayMsg(MxHelp3)
      SayMsg(MxHelp3b)
    end if
    print at 8,22, "PRESS A BUTTON"
    screen on
    nmi off
    WasBtn = 1
    WasBtn2 = 1
    Press = 0
    Press2 = 0
    W16 = 0
    while Press = 0 and Press2 = 0
      Frame1
      ReadPad
      inc W16
      if W16 = 1800 then
        Press = 1
        Pg = 2
      end if
    end while
    play sound SndTick
  next
  HideSprites
  return
end sub

