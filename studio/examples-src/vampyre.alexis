  tile screen
  set sound table VhSoundTable areas 4
  sprites 16x16
  set sprite count 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  EditorialPage

title:
  TitlePage
  if Menu = 1 then
    HelpPages
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if

new_game:
  NewWorld
  GameScreen
  call asm HeStart
  NewPicture
  ShowCreatures
  ShowStatus
  PkV = 0
  NewVerb

play_loop:
  Frame1
  Animate
  ReadPad
  Dirty = 0
  if InCastle = 1 then
    if MenuOpen = 0 then
      CastleInput
    else
      MenuInput
    end if
  else
    MenuInput
  end if
  if Ended > 0 then goto game_end
  if Dirty = 1 then
    call asm HeDrawPick
  end if
  goto play_loop

game_end:
  mute all
  TzOn = 0
  if Ended = 1 then play sound SndDie
  if Ended = 2 then play sound SndScream
  EndPicker
  Rearm
  wait 90 frames
  if Ended = 2 then play sound SndWin
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' A new game: the listing's starting values (DATA 2785-2815)

sub NewWorld:
  TT = 1100
  Day = 1
  S0 = 0
  S1 = 0
  S2 = 1
  Night = 0
  HV = 0
  NU = 8000
  Fuel = 1020
  Portions = 10
  VLoc = 68
  VF = 0
  WolfFed = 0
  InCastle = 0
  MenuOpen = 0
  CLv = 0
  VCL = 255
  WarnHung = 0
  WarnRest = 0
  FuelWarn = 99
  for J = 0 to 15
    CrK[J] = CritK0[J]
    CrL[J] = CritL0[J]
    CrX[J] = CritX0[J]
    CrY[J] = CritY0[J]
  next
  return
end sub

' ---------------------------------------------------------------------------
' Random numbers: a 16-bit xorshift, stirred every frame on the title

function Rnd(u8 N) as u8
  RW = Seed << 7
  Seed = Seed xor RW
  RW = Seed >> 9
  Seed = Seed xor RW
  RW = Seed << 8
  Seed = Seed xor RW
  RS = highbyte(Seed) xor lowbyte(Seed)
  return RS % N

' Chance: 1 with a probability of P in 100
function Chance(u8 P) as u8
  if Rnd(100) < P then return 1
  return 0

' ---------------------------------------------------------------------------
' The menu

sub NewVerb:
  Verb = PkV
  PkN = 0
  PkCol = 0
  PkMode = 0
  SetFlags
  call asm HeNouns
  call asm HeDrawPick
  return
end sub

sub MenuInput:
  if Stick = 1 then MoveStick
  if Press = 1 then FireLeft
  if Press2 = 1 then FireRight
  return
end sub

sub MoveStick:
  if Up1 = 1 then
    if PkCol = 0 then
      if PkV = 0 then
        PkV = NVerbs - 1
      else
        dec PkV
      end if
      NewVerb
      play sound SndTick
    else
      if PkN > 0 then
        dec PkN
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Dn1 = 1 then
    if PkCol = 0 then
      inc PkV
      if PkV = NVerbs then PkV = 0
      NewVerb
      play sound SndTick
    else
      V = PkN + 1
      if V < NCount then
        PkN = V
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Rt1 = 1 then
    if PkCol = 0 then
      if NeedNoun > 0 then
        if NCount > 0 then
          PkCol = 1
          Dirty = 1
          play sound SndTick
        end if
      end if
    end if
  end if
  if Lf1 = 1 then
    if PkCol = 1 then
      PkCol = 0
      Dirty = 1
      play sound SndTick
    end if
  end if
  return
end sub

sub FireLeft:
  if PkCol = 0 then
    if NeedNoun = 0 then
      Noun = 0
      Noun2 = 0
      RunTurn
      return
    end if
    if NCount > 0 then
      PkCol = 1
      Dirty = 1
      play sound SndTick
    end if
    return
  end if
  if NCount = 0 then return
  Noun = NL[PkN]
  Noun2 = 0
  RunTurn
  return
end sub

sub FireRight:
  if PkCol = 1 then
    PkCol = 0
    Dirty = 1
    play sound SndBack
    return
  end if
  ' in the castle the right button on the verbs closes the menu
  if InCastle = 1 then
    MenuOpen = 0
    play sound SndBack
    WalkHint
  end if
  return
end sub

' SetFlags: what the rules need to know (Amy keeps these values)
sub SetFlags:
  Fl.FNight = Night
  Fl.FTired = 0
  if HV > 500 then Fl.FTired = 1
  Fl.FFullup = 0
  if NU > 17000 then Fl.FFullup = 1
  Fl.FNofuel = 0
  if Fuel <= 0 then Fl.FNofuel = 1
  Fl.FMuchfuel = 0
  if Fuel > 500 then Fl.FMuchfuel = 1
  Fl.FHasstk = 0
  if OL.OStakes = 100 then Fl.FHasstk = 1
  Fl.FSleepok = 0
  for J = 0 to NSleepRooms - 1
    if SleepRooms[J] = Rm then Fl.FSleepok = 1
  next
  ' the best weapon carried (DATA 4015)
  V = 0
  if OL.OLantern = 100 then V = 1
  if OL.ORope = 100 then V = 2
  if OL.OMallet = 100 then V = 3
  if OL.OPales = 100 then V = 4
  if OL.OStakes = 100 then V = 5
  if OL.OKnife = 100 then V = 6
  if OL.OAxe = 100 then V = 7
  Fl.FWpn = V
  Fl.FAct = 0
  Fl.FXt = 0
  Fl.FNuadd = 0
  ' who is here: the vampire outside at night; in the castle the creatures
  ' next to the hunter
  OL.OVampire = 0
  OL.ORats = 0
  OL.OBats = 0
  Fl.FVnear = 0
  Fl.FCoffin = 0
  if InCastle = 0 then
    if VLoc = Rm then
      if Fl.FNight = 1 then OL.OVampire = Rm
      if VF > 0 then OL.OVampire = Rm
    end if
  else
    CastleFlags
  end if
  return
end sub

' RunTurn: the engine plays the command (the NMI is off: Frame1 ended)
sub RunTurn:
  play sound SndOk
  SetFlags
  OldRm = Rm
  call asm HeTurn
  AfterTurn
  if InCastle = 1 then
    MenuOpen = 0
  end if
  Refresh
  if HistN > 0 then Pager
  if Fl.FDead = 1 then
    Ended = 1
    return
  end if
  if Fl.FWin = 1 then
    Ended = 2
    return
  end if
  if Fl.FQuit = 1 then
    Ended = 3
    return
  end if
  if InCastle = 1 then
    WalkHint
  else
    NewVerb
  end if
  return
end sub

' Refresh: the picture (or the castle), the creatures, the status line
sub Refresh:
  if InCastle = 1 then
    DrawCastle
  else
    if Scene <> Shown then NewPicture
    ShowCreatures
  end if
  ShowStatus
  return
end sub

' AfterTurn: what the rules asked for (ACT), then the time it took
sub AfterTurn:
  Act = Fl.FAct
  Mins = VerbTime[Verb] + Fl.FXt
  if Fl.FWin = 1 then
    WinText
    return
  end if
  if Rm <> OldRm then
    ' the minutes of the exit taken (line 1095)
    Dir = Noun - 70
    if Dir > 7 then Dir = Dir - 4
    W16 = OldRm * 3
    T1 = Dir >> 1
    W16 = W16 + T1
    T1 = ExitTime[W16]
    V = Dir & 1
    if V = 0 then
      T1 = T1 >> 4
    else
      T1 = T1 & 15
    end if
    T1 = TimeVal[T1]
    W16 = HV / 20
    Mins = Mins + T1
    Mins = Mins + lowbyte(W16)
    W16 = T1 * 5
    W16 = W16 / 2
    HV = HV + W16
    Followers
  end if
  W16 = Fl.FNuadd
  W16 = W16 * 100
  NU = NU + W16
  select case Act
  case AcTime
    SayTime
  case AcEatfood
    EatPortion
  case AcFeeddog
    LosePortion
  case AcFeedwolf
    LosePortion
    WolfFed = 1
  case AcFoodleft
    FoodLeft
  case AcFuelleft
    MsgId = MxFuelLeft
    NumU = 0
    if Fuel > 0 then NumU = Fuel
    call asm HeNumV
    call asm HeMsgV
  case AcRefuel
    Fuel = Fuel + 600
  case AcLunge
    VF = Rnd(5) + 5
    VampBite
  case AcBataway
    VF = 0
    VLoc = 68
    VCL = 255
    if InCastle = 0 then
      ' line 915: he flies off to a place next to this one
      VLoc = RandomExit(Rm, 0)
    end if
  case AcWolfrun
    OL.OWolves = RandomExit(Rm, 1)
    if OL.OWolves = Rm then OL.OWolves = 86
  case AcDogrun
    Fl.FDogf = 0
    OL.ODog = 61
  case AcZaprat
    ZapNear(1)
  case AcZapbat
    ZapNear(2)
  case AcWait
    WaitLoop(5)
    return
  case AcSleep
    WaitLoop(20)
    SayMsg(MxWake)
    return
  end select
  Pass
  if Rm = 68 then
    if InCastle = 0 then EnterCastle
  end if
  return
end sub

' WaitLoop: WAIT (steps of 5 minutes, line 2735) and SLEEP (steps of 20,
' line 2700); the world goes on at every step
sub WaitLoop(u8 StepM):
  WLeft = 10
  if Noun = WdHour1 then WLeft = 60
  if Noun = WdHour3 then WLeft = 180
  if Noun = WdHour10 then WLeft = 600
  while WLeft > 0
    Mins = StepM
    if StepM = 20 then
      if HV > 13 then
        HV = HV - 13
      else
        HV = 0
      end if
    else
      if HV > 2 then
        HV = HV - 2
      else
        HV = 0
      end if
    end if
    Pass
    if WLeft > StepM then
      WLeft = WLeft - StepM
    else
      WLeft = 0
    end if
    if Fl.FDead = 1 then WLeft = 0
    if Fl.FWin = 1 then WLeft = 0
  end while
  return
end sub

' Followers: the dog follows (line 1110) and so do the wolves (line 1100)
sub Followers:
  if Dir > 3 then return
  if Fl.FDogf = 1 then
    if OL.ODog = OldRm then
      OL.ODog = Rm
      SayMsg(MxDogFollows)
    end if
  end if
  if OL.OWolves = OldRm then
    if IsWolfRoom(Rm) = 1 then
      OL.OWolves = Rm
      SayMsg(MxWolvesFollow)
    end if
  end if
  return
end sub

function IsWolfRoom(u8 R) as u8
  for WK = 0 to NWolfRooms - 1
    if WolfRooms[WK] = R then return 1
  next
  return 0

' RandomExit: a room next to R (NoUD = 1: not up or down); R if none
function RandomExit(u8 R, u8 NoUD) as u8
  RQ = R
  RC = 0
  for RK = 0 to 5
    call asm HeExitV
    if IV > 0 then
      if NoUD = 0 then
        inc RC
      else
        if RK < 4 then inc RC
      end if
    end if
  next
  if RC = 0 then return R
  RT = Rnd(RC)
  RC = 0
  RR = R
  for RK = 0 to 5
    call asm HeExitV
    if IV > 0 then
      if NoUD = 0 then
        if RC = RT then RR = IV
        inc RC
      else
        if RK < 4 then
          if RC = RT then RR = IV
          inc RC
        end if
      end if
    end if
  next
  return RR

sub SayMsg(u16 M):
  MsgId = M
  call asm HeSayV
  return
end sub

' ---------------------------------------------------------------------------
' Pass: one turn of the world (lines 800-1000), Mins minutes long

sub Pass:
  TT = TT + Mins
  if TT >= 1440 then
    TT = TT - 1440
    inc Day
    S0 = 0
    S1 = 0
    S2 = 0
  end if
  ' the sun (850-865)
  V = 0
  if S1 = 0 then
    if TT > 1260 then
      SayMsg(MxSunset)
      S1 = 1
      Night = 1
      V = 1
      play sound SndBell
    end if
  end if
  if V = 0 then
    if S0 = 0 then
      if TT > 1220 then
        SayMsg(MxSetting)
        S0 = 1
        V = 1
      end if
    end if
  end if
  if V = 0 then
    if S2 = 0 then
      if TT > 300 then
        SayMsg(MxSunrise)
        S2 = 1
        Night = 0
        play sound SndBell
      end if
    end if
  end if
  SetNight
  if InCastle = 0 then
    WolvesMove
    WolvesBite
  end if
  VampMove
  VampAttack
  if InCastle = 1 then CritBite
  LampBurn
  ' line 805: rest a little every turn
  if HV > 10 then
    HV = HV - 10
  else
    HV = 0
  end if
  ' line 815: hunger
  W16 = Mins
  W16 = W16 * 6
  NU = NU - W16
  ' line 310: out of his coffin when the sun is up
  if VF > 0 then
    if VLoc <> 68 then
      if Fl.FNight = 0 then
        SayMsg(MxMelts)
        Fl.FWin = 1
        WinText
        return
      end if
    end if
  end if
  Warnings
  return
end sub

sub SetNight:
  Fl.FNight = Night
  return
end sub

' Warnings and the two ways to die (lines 235-250)
sub Warnings:
  if HV > 900 then
    SayMsg(MxExhaust)
    TimeWords
    Fl.FDead = 1
    return
  end if
  if NU < -1000 then
    SayMsg(MxStarved)
    NumU = Day
    call asm HeNumV
    MsgId = MxDot
    call asm HeMsgV
    Fl.FDead = 1
    return
  end if
  if HV > 500 then
    if WarnRest = 0 then SayMsg(MxRest)
    inc WarnRest
    if WarnRest = 12 then WarnRest = 0
  else
    WarnRest = 0
  end if
  if NU < 3000 then
    if WarnHung = 0 then SayMsg(MxHungry)
    inc WarnHung
    if WarnHung = 12 then WarnHung = 0
  else
    WarnHung = 0
  end if
  return
end sub

' the wolves wander among their places (880-900)
sub WolvesMove:
  if WolfFed = 1 then
    WolfFed = 0
    return
  end if
  if OL.OWolves = 0 then return
  if Chance(40) = 0 then return
  V = RandomExit(OL.OWolves, 1)
  if IsWolfRoom(V) = 1 then OL.OWolves = V
  return
end sub

' the wolves attack (925-935)
sub WolvesBite:
  if OL.OWolves <> Rm then return
  if Chance(60) = 0 then return
  SayMsg(MxWolvesAtk)
  play sound SndBite
  if Fl.FDogf = 1 then
    if OL.ODog = Rm then
      SayMsg(MxDogDefends)
      return
    end if
  end if
  ' HV = HV + 2 - NU / 170
  W16 = 200
  if NU > 0 then
    W16 = NU / 170
    if W16 > 200 then W16 = 200
    W16 = 200 - W16
  end if
  HV = HV + W16
  return
end sub

' the vampire: in his coffin by day, out at night (905-920)
sub VampMove:
  if VF = 0 then
    if Fl.FNight = 0 then
      VLoc = 68
      VCL = 255
      return
    end if
  end if
  if VF > 0 then
    dec VF
    if VF > 0 then
      VLoc = Rm
      return
    end if
  end if
  if VLoc = 68 then
    if InCastle = 1 then
      ' in the castle he hunts the hunter (CastleVamp)
      CastleVamp
      return
    end if
  end if
  VLoc = RandomExit(VLoc, 0)
  if VLoc <> 68 then VCL = 255
  return
end sub

sub VampAttack:
  if Fl.FNight = 0 then
    if VF = 0 then return
  end if
  if VLoc <> Rm then return
  if InCastle = 1 then
    if VampNext = 0 then return
  end if
  if Chance(40) = 0 then return
  VampBite
  return
end sub

' line 975: garlic or the crucifix in hand soften the bite
sub VampBite:
  SayMsg(MxVampAtk)
  play sound SndBite
  W16 = 300
  if OL.OCrucifix = 100 then W16 = 200
  if OL.OGarlic = 100 then W16 = 200
  HV = HV + W16
  return
end sub

' the lantern burns (940-965); it goes out when left behind
sub LampBurn:
  if Fl.FLt = 0 then return
  if OL.OLantern <> 100 then
    if OL.OLantern <> Rm then
      Fl.FLt = 0
      return
    end if
  end if
  Fuel = Fuel - Mins
  if Fuel > 60 then
    FuelWarn = 99
    return
  end if
  if Fuel <= 0 then
    Fuel = 0
    Fl.FLt = 0
    SayMsg(MxLampOut)
    return
  end if
  V = lowbyte(Fuel) / 15
  if V <> FuelWarn then
    FuelWarn = V
    SayMsg(MxOnly)
    MsgId = MxMoreFuel
    NumU = Fuel
    call asm HeNumV
    call asm HeMsgV
  end if
  return
end sub

' food (2550-2640): one portion is a day's food
sub EatPortion:
  if Portions = 0 then return
  SayMsg(MxEatFood)
  NU = NU + 10000
  LosePortion
  return
end sub

sub LosePortion:
  if Portions > 0 then dec Portions
  if Portions = 0 then
    OL.OFood = 0
    SayMsg(MxNoMoreFood)
    return
  end if
  if Portions < 3 then
    SayMsg(MxOnly)
    MsgId = MxFoodLeft
  else
    SayMsg(MxFood)
    MsgId = MxFoodLeft
  end if
  NumU = Portions
  call asm HeNumV
  call asm HeMsgV
  return
end sub

sub FoodLeft:
  SayMsg(MxFood)
  MsgId = MxFoodLeft
  NumU = Portions
  call asm HeNumV
  call asm HeMsgV
  return
end sub

' the time (575-595): "IT'S 9:40 PM OF DAY 1."
sub SayTime:
  SayMsg(MxIts)
  TimeWords
  MsgId = MxOfDay
  call asm HeMsgV
  NumU = Day
  call asm HeNumV
  MsgId = MxDot
  call asm HeMsgV
  return
end sub

sub ClockParts:
  W16 = TT / 60
  Hour = lowbyte(W16)
  W16 = W16 * 60
  W16 = TT - W16
  Minute = lowbyte(W16)
  return
end sub

sub TimeWords:
  ClockParts
  V = Hour
  if V >= 12 then V = V - 12
  if V = 0 then V = 12
  NumU = V
  call asm HeNumV
  MsgId = MxColon
  call asm HeMsgV
  if Minute < 10 then
    MsgId = MxZero
    call asm HeMsgV
  end if
  NumU = Minute
  call asm HeNumV
  MsgId = MxAm
  if Hour >= 12 then MsgId = MxPm
  call asm HeMsgV
  return
end sub

' the end (505-510)
sub WinText:
  SayMsg(MxKilled)
  NumU = Day
  call asm HeNumV
  MsgId = MxAt
  call asm HeMsgV
  TimeWords
  MsgId = MxChamp
  call asm HeMsgV
  return
end sub

' ShowStatus: row 8, the day and the time (and the floor in the castle)
sub ShowStatus:
  fill 32 count 28 at 2,8
  ClockParts
  print at 2,8, "DAY"
  NumU = Day
  print at 6,8, digits$(NumU, 1)
  V = Hour
  if V >= 12 then V = V - 12
  if V = 0 then V = 12
  NumU = V
  if V < 10 then
    print at 10,8, digits$(NumU, 1)
  else
    print at 9,8, digits$(NumU, 2)
  end if
  print at 11,8, ":"
  NumU = Minute
  print at 12,8, digits$(NumU, 2)
  if Hour >= 12 then
    print at 15,8, "PM"
  else
    print at 15,8, "AM"
  end if
  if InCastle = 1 then
    print at 21,8, "FLOOR"
    NumU = 4 - CLv
    print at 27,8, digits$(NumU, 1)
  end if
  return
end sub

' ---------------------------------------------------------------------------
' The castle

' the castle tests work on the hunter's floor at (QX, QY)
function WallAt as u8
  if QX > 27 then return 1
  if QY > 20 then return 1
  IW = CLv * 84
  IW = IW + QY * 4
  IV = QX >> 3
  IW = IW + IV
  IV = QX & 7
  IT = 128 >> IV
  IV = CastleWall[IW] & IT
  if IV > 0 then return 1
  return 0

' FeatAt: the feature kind at (QX, QY), 0 when none
function FeatAt as u8
  for FK = 0 to NFeat - 1
    if FeatL[FK] = CLv then
      if FeatX[FK] = QX then
        if FeatY[FK] = QY then return FeatK[FK]
      end if
    end if
  next
  return 0

' CritAt: the index + 1 of a rat or bat at (QX, QY), 0 when none
function CritAt as u8
  for CK = 0 to 15
    if CrK[CK] > 0 then
      if CrL[CK] = CLv then
        if CrX[CK] = QX then
          if CrY[CK] = QY then return CK + 1
        end if
      end if
    end if
  next
  return 0

' Near: 1 when (QX, QY) is the hunter's cell or next to it
function Near as u8
  NV = 0
  if QX = CX then
    if QY = CY then NV = 1
    if QY + 1 = CY then NV = 1
    if QY = CY + 1 then NV = 1
  end if
  if QY = CY then
    if QX + 1 = CX then NV = 1
    if QX = CX + 1 then NV = 1
  end if
  return NV

function VampNext as u8
  if VCL <> CLv then return 0
  QX = VCX
  QY = VCY
  return Near

sub CastleFlags:
  for J = 0 to 15
    if CrK[J] > 0 then
      if CrL[J] = CLv then
        QX = CrX[J]
        QY = CrY[J]
        if Near = 1 then
          if CrK[J] = 1 then OL.ORats = 68
          if CrK[J] = 2 then OL.OBats = 68
        end if
      end if
    end if
  next
  if Fl.FNight = 1 then
    if VLoc = 68 then
      if VampNext = 1 then
        OL.OVampire = 68
        Fl.FVnear = 1
      end if
    end if
  end if
  QX = CX
  QY = CY
  if FeatAt = 6 then
    Fl.FCoffin = 1
    if Fl.FNight = 0 then OL.OVampire = 68
  end if
  return
end sub

' ZapNear: KILL RATS / BATS clears those next to the hunter (line 2390)
sub ZapNear(u8 Kind):
  for J = 0 to 15
    if CrK[J] = Kind then
      if CrL[J] = CLv then
        QX = CrX[J]
        QY = CrY[J]
        if Near = 1 then CrK[J] = 0
      end if
    end if
  next
  return
end sub

sub EnterCastle:
  InCastle = 1
  MenuOpen = 0
  CLv = 0
  CX = 13
  CY = 1
  if OldRm = 52 then CY = 19
  ViewTop = 0
  SayMsg(MxEnterCastle)
  Rearm
  wait
  nmi off
  display off
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  FamShown = 255
  Shown = 255
  call asm HeDisplayOn
  return
end sub

sub LeaveCastle:
  InCastle = 0
  MenuOpen = 0
  VCL = 255
  OldRm = Rm
  Rm = 81
  if CY > 10 then Rm = 52
  SayMsg(MxLeave)
  call asm HeLookV
  HideCast
  NewPicture
  ShowCreatures
  ShowStatus
  if HistN > 0 then Pager
  NewVerb
  return
end sub

' CastleInput: walking (the stick) or opening the menu (the left button)
sub CastleInput:
  if Press = 1 then
    MenuOpen = 1
    play sound SndTick
    NewVerb
    return
  end if
  if Stick = 0 then return
  NX = CX
  NY = CY
  if Up1 = 1 then
    if NY = 0 then
      NY = 255
    else
      dec NY
    end if
  else
    if Dn1 = 1 then
      inc NY
    else
      if Lf1 = 1 then dec NX
      if Rt1 = 1 then inc NX
    end if
  end if
  CastleStep
  return
end sub

' CastleStep: one step is one turn (lines 1190-1280)
sub CastleStep:
  ' out through a door of the top floor
  if CLv = 0 then
    if NY > 20 then
      call asm HeBegin
      Mins = 5
      Pass
      LeaveCastle
      return
    end if
  end if
  QX = NX
  QY = NY
  if WallAt = 1 then
    play sound SndBump
    return
  end if
  call asm HeBegin
  CX = NX
  CY = NY
  play sound SndStep
  ' line 1205: two minutes a step, more when weary
  W16 = HV / 50
  Mins = 2 + lowbyte(W16)
  QX = CX
  QY = CY
  CellK = FeatAt
  if CellK = 3 then
    inc CLv
    play sound SndStairs
    SayMsg(MxStairsDown)
  end if
  if CellK = 4 then
    dec CLv
    play sound SndStairs
    SayMsg(MxStairsUp)
  end if
  if CellK = 5 then
    ' line 1250: four times in five the trapdoor gives way
    if Chance(80) = 1 then
      play sound SndFall
      SayMsg(MxTrap)
      inc CLv
      ' line 1260: unconscious for 10 to 19 minutes
      Mins = Mins + 10 + Rnd(10)
    end if
  end if
  if CellK = 6 then
    SayMsg(MxCoffin)
    SetNight
    if Fl.FNight = 0 then
      SayMsg(MxVampAsleep)
    else
      SayMsg(MxCoffinEmpty)
    end if
  end if
  CritMove
  Pass
  QX = CX
  QY = CY
  V = CritAt
  if V > 0 then
    dec V
    if CrK[V] = 1 then SayMsg(MxRatsHere)
    if CrK[V] = 2 then SayMsg(MxBatsHere)
  end if
  if Fl.FLt = 0 then
    if Fl.FDead = 0 then SayMsg(MxTooDark)
  end if
  DrawCastle
  ShowStatus
  if HistN > 0 then Pager
  if Fl.FDead = 1 then Ended = 1
  if Fl.FWin = 1 then Ended = 2
  return
end sub

' CritMove: rats and bats on the hunter's floor take a step, toward him
' when he is near (within 5 cells), else at random
sub CritMove:
  for J = 0 to 15
    if CrK[J] > 0 then
      if CrL[J] = CLv then
        if Chance(50) = 1 then CritStep
      end if
    end if
  next
  return
end sub

sub CritStep:
  X = CrX[J]
  Y = CrY[J]
  NX = X
  NY = Y
  V = Rnd(4)
  if Chance(60) = 1 then
    ' toward the hunter
    if X < CX then
      V = 1
    else
      if X > CX then V = 0
    end if
    if Y < CY then
      if Rnd(2) = 0 then V = 3
    else
      if Y > CY then
        if Rnd(2) = 0 then V = 2
      end if
    end if
  end if
  select case V
  case 0
    dec NX
  case 1
    inc NX
  case 2
    dec NY
  case else
    inc NY
  end select
  if NX = CX then
    if NY = CY then return
  end if
  QX = NX
  QY = NY
  if WallAt = 1 then return
  if FeatAt > 0 then return
  if CritAt > 0 then return
  CrX[J] = NX
  CrY[J] = NY
  return
end sub

' CritBite: rats and bats next to the hunter bite (line 990)
sub CritBite:
  T1 = 0
  T2 = 0
  for J = 0 to 15
    if CrK[J] > 0 then
      if CrL[J] = CLv then
        QX = CrX[J]
        QY = CrY[J]
        if Near = 1 then
          if CrK[J] = 1 then T1 = 1
          if CrK[J] = 2 then T2 = 1
        end if
      end if
    end if
  next
  ' they bite one turn in two (the listing: while on the hunter's cell)
  if Chance(50) = 0 then return
  if T1 = 1 then
    SayMsg(MxRatsAtk)
    HV = HV + 30
    play sound SndBite
  end if
  if T2 = 1 then
    SayMsg(MxBatsAtk)
    HV = HV + 20
    play sound SndBite
  end if
  return
end sub

' CastleVamp: at night the vampire walks the hunter's floor toward him
sub CastleVamp:
  if VCL <> CLv then
    ' he comes up from the far side of the floor
    VCL = CLv
    VCX = 1
    if CX < 14 then VCX = 25
    VCY = 1
    if CY < 10 then VCY = 19
    return
  end if
  if VampNext = 1 then return
  NX = VCX
  NY = VCY
  if Rnd(2) = 0 then
    if VCX < CX then inc NX
    if VCX > CX then dec NX
  else
    if VCY < CY then inc NY
    if VCY > CY then dec NY
  end if
  QX = NX
  QY = NY
  if WallAt = 0 then
    VCX = NX
    VCY = NY
    return
  end if
  ' blocked: a step to the side
  NX = VCX
  NY = VCY
  V = Rnd(4)
  if V = 0 then dec NX
  if V = 1 then inc NX
  if V = 2 then dec NY
  if V = 3 then inc NY
  QX = NX
  QY = NY
  if WallAt = 0 then
    VCX = NX
    VCY = NY
  end if
  return
end sub

' DrawCastle: rows 1-7 show the floor round the hunter; black without light
sub DrawCastle:
  ViewTop = 0
  if CY > 3 then ViewTop = CY - 3
  if ViewTop > 14 then ViewTop = 14
  if Fl.FLt = 0 then
    for Y = 1 to 7
      fill TCfloor count 28 at 2,Y
    next
    CastSprites
    return
  end if
  for Y = 0 to 6
    V = ViewTop + Y
    W16 = CLv * 84
    W16 = W16 + V * 4
    for X = 0 to 27
      T3 = X >> 3
      T4 = X & 7
      T2 = 128 >> T4
      T4 = CastleWall[W16 + T3] & T2
      if T4 > 0 then
        RowB[X] = TCwall
      else
        RowB[X] = TCfloor
      end if
    next
    T1 = Y + 1
    put RowB count 28 at 2,T1
  next
  ' the features (the trapdoors stay hidden)
  for K = 0 to NFeat - 1
    if FeatL[K] = CLv then
      V = FeatY[K]
      if V >= ViewTop then
        if V < ViewTop + 7 then
          T1 = V - ViewTop
          T1 = T1 + 1
          T2 = FeatX[K] + 2
          T3 = FeatK[K]
          if T3 < 3 then put char TCdoor at T2,T1
          if T3 = 3 then put char TCdown at T2,T1
          if T3 = 4 then put char TCup at T2,T1
          if T3 = 6 then put char TCcoffin at T2,T1
        end if
      end if
    end if
  next
  ' rats and bats (two frames a second)
  DrawCastleCrit
  CastSprites
  return
end sub

' CastSprites: the hunter (sprite 0) and the vampire (sprite 1)
sub CastSprites:
  T1 = CY - ViewTop
  T1 = T1 + 1
  T1 = T1 * 8
  dec T1
  T2 = CX + 2
  T2 = T2 * 8
  V = SHunter
  T4 = Anim & 16
  if T4 > 0 then V = SHunter2
  set sprite 0 to T1, T2, V, 15
  T3 = 192
  if VCL = CLv then
    if VLoc = 68 then
      if VCY >= ViewTop then
        if VCY < ViewTop + 7 then
          T3 = VCY - ViewTop
          T3 = T3 + 1
          T3 = T3 * 8
          dec T3
        end if
      end if
    end if
  end if
  T2 = VCX + 2
  T2 = T2 * 8
  if Fl.FLt = 0 then
    if VampNext = 0 then T3 = 192
  end if
  set sprite 1 to T3, T2, SVamp, 13
  set sprite 2 to 192, 0, 0, 0
  set sprite 3 to 192, 0, 0, 0
  update sprites
  return
end sub

sub HideCast:
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub WalkHint:
  for Y = 19 to 22
    fill 32 count 28 at 2,Y
  next
  call asm HeDrawDivider
  print at 3,20, "STICK: WALK THE CASTLE"
  print at 3,21, "LEFT BUTTON: COMMANDS"
  return
end sub

' Pager: when a turn wrote more than the window holds, the engine kept the
' lines that scrolled away (VRAM history). Show them ten at a time from
' the start, MORE between pages, ending on the window as it was.
sub Pager:
  call asm HeHistFinish
  Pg = 0
  V = HistN - 10
  while Pg < V
    call asm HeHistShow
    InMore = 1
    play sound SndMore
    Blink = 0
    Press = 0
    Press2 = 0
    while Press = 0 and Press2 = 0
      if Blink = 0 then
        call asm HeMoreMark
      end if
      if Blink = 20 then
        call asm HeDrawDivider
      end if
      Frame1
      ReadPad
      inc Blink
      if Blink = 32 then Blink = 0
    end while
    play sound SndTick
    InMore = 0
    Pg = Pg + 10
    if Pg > V then Pg = V
  end while
  call asm HeHistShow
  call asm HeDrawDivider
  HistN = 0
  return
end sub

' NewPicture: the screen goes blank for a moment while a picture unpacks
sub NewPicture:
  display off
  ShowScene
  call asm HeDisplayOn
  return
end sub

sub EndPicker:
  for Y = 20 to 22
    fill 32 count 28 at 2,Y
  next
  if Ended = 1 then print at 9,20, "YOU HAVE DIED."
  if Ended = 2 then print at 4,20, "THE VILLAGE IS SAVED!"
  if Ended = 3 then print at 10,20, "GAME OVER"
  print at 8,22, "PRESS A BUTTON"
  return
end sub

' ---------------------------------------------------------------------------
' Frame and controls

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  call asm HePad
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 18
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 8
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub GameScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  FamShown = 255
  Shown = 255
  Ended = 0
  WasBtn = 1
  WasBtn2 = 1
  screen on
  nmi off
  return
end sub

