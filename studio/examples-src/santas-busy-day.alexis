record Walker:
  u8 Cx
  u8 Cy
  u8 Dir
  u8 Want
  u8 Pix
  u8 Face
end record

Walker Sa
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Ci = 0
u16 Ni = 0
u16 NumU = 0
u8 Maze[312]
u8 RowBuf[28]
u8 Gifts = 0
u8 Best = 0
u8 Easy = 0
u8 TimeL = 0
u8 TimeF = 0
u8 Ouch = 0
u8 BlockD = 255
u8 Over = 0
u8 Bumps = 0
u8 Hearts = 0
u8 Cx0 = 0
u8 Cy0 = 0
u8 Pans = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Ready = 0
' title Santa
u8 TbX = 40
u8 TbD = 1
' loop counters (never shared with the helpers)
u8 Gr = 0
u8 Gc = 0
u8 Lk = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 D = 0

  tile screen
  set sound table SaSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Ready = 1
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSanta
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  HideSprites
  if Gifts > Best then Best = Gifts
  print at 6,8, "                  "
  if Over = 1 then
    print at 6,9, "  SANTA'S SACK    "
    print at 6,10, "    IS FULL!      "
    play sound SndWin
  else
    print at 6,9, "   OUT OF TIME!   "
    print at 6,10, "                  "
    play sound SndOver
  end if
  print at 6,11, "                  "
  NumU = Gifts
  print at 6,12, "    GIFTS ", digits$(NumU, 3), "     "
  print at 6,13, "                  "
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' xorshift16
function Rnd as u16
  Rs = random(65535)
  return Rs

' the cell next to (Cx, Cy) in direction Dr is reachable: 1, else 0
function IsOpen(u8 Px, u8 Py, u8 Dr) as u8
  u16 Ix = 0
  Ix = Py * MW
  Ix = Ix + Px
  select case Dr
    case 0
      if Px >= MW - 1 then return 0
      if (Maze[Ix] & OpE) > 0 then return 1
    case 1
      if Py = 0 then return 0
      Ix = Ix - MW
      if (Maze[Ix] & OpS) > 0 then return 1
    case 2
      if Px = 0 then return 0
      Ix = Ix - 1
      if (Maze[Ix] & OpE) > 0 then return 1
    case 3
      if Py >= MH - 1 then return 0
      if (Maze[Ix] & OpS) > 0 then return 1
  end select
  return 0

' ---------------------------------------------------------------------------
' the maze: a random depth-first walk from a random cell; each new cell
' keeps the direction back (bits 4-5), as in the C64 program
sub MakeMaze:
  u8 Mx = 0
  u8 My = 0
  u8 Tries = 0
  u8 D0 = 0
  u8 Nx = 0
  u8 Ny = 0
  u16 Start = 0
  fill array Maze with 0
  W16 = Rnd
  Mx = W16 & 7
  W16 = Rnd
  My = W16 & 15
  Ci = My * MW
  Ci = Ci + Mx
  Start = Ci
  Maze[Ci] = Seen
mm_walk:
  W16 = Rnd
  D0 = W16 & 3
  Tries = 0
  while Tries < 4
    D = (D0 + Tries) & 3
    Nx = Mx + DxT[D]
    Ny = My + DyT[D]
    if Nx < MW then
      if Ny < MH then
        Ni = Ny * MW
        Ni = Ni + Nx
        V = Maze[Ni] & Seen
        if V = 0 then
          ' carve: the wall between the two cells goes
          select case D
            case 0
              Maze[Ci] = Maze[Ci] | OpE
            case 1
              Maze[Ni] = Maze[Ni] | OpS
            case 2
              Maze[Ni] = Maze[Ni] | OpE
            case 3
              Maze[Ci] = Maze[Ci] | OpS
          end select
          K = D ^ 2
          K = K << 4
          Maze[Ni] = Maze[Ni] | Seen | K
          Mx = Nx
          My = Ny
          Ci = Ni
          goto mm_walk
        end if
      end if
    end if
    inc Tries
  end while
  ' dead end: back the way we came, until the start
  if Ci = Start then goto mm_done
  K = Maze[Ci] >> 4
  K = K & 3
  Mx = Mx + DxT[K]
  My = My + DyT[K]
  Ci = My * MW
  Ci = Ci + Mx
  goto mm_walk
mm_done:
  ' keep only the open walls
  for Ci = 0 to NCell - 1
    Maze[Ci] = Maze[Ci] & 3
  next
  return
end sub

' the gifts and hearts on random free cells (never Santa's first cell)
sub DropItems:
  u8 Left = 0
  Left = NGift
  while Left > 0
    W16 = Rnd
    W16 = W16 & 511
    if W16 < NCell then
      if W16 > 0 then
        V = Maze[W16]
        if V < HasGift then
          Maze[W16] = V | HasGift
          dec Left
        end if
      end if
    end if
  end while
  Left = NHeart
  while Left > 0
    W16 = Rnd
    W16 = W16 & 511
    ' hearts away from the start: the lower half
    if W16 < NCell then
      if W16 >= 120 then
        V = Maze[W16]
        if V < HasGift then
          Maze[W16] = V | HasHeart
          dec Left
        end if
      end if
    end if
  end while
  return
end sub

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  StickDir
  ' after a bump the stick still held into the wall is ignored until it moves
  if D = BlockD then
    D = DNone
  else
    BlockD = DNone
  end if
  if Easy = 1 then
    Sa.Want = D
  else
    if D <> DNone then Sa.Want = D
  end if
  if Sa.Pix = 0 then
    AtCentre
  else
    ' turning round is allowed anywhere
    if Sa.Want <> DNone then
      K = Sa.Dir ^ 2
      if Sa.Want = K then
        Sa.Cx = Sa.Cx + DxT[Sa.Dir]
        Sa.Cy = Sa.Cy + DyT[Sa.Dir]
        Sa.Pix = CellH - Sa.Pix
        Sa.Dir = K
      end if
    end if
  end if
  if Sa.Dir <> DNone then
    if Sa.Dir = 0 then Sa.Face = 0
    if Sa.Dir = 2 then Sa.Face = 1
    Sa.Pix = Sa.Pix + Spd
    if Sa.Pix >= CellH then
      Sa.Pix = 0
      Sa.Cx = Sa.Cx + DxT[Sa.Dir]
      Sa.Cy = Sa.Cy + DyT[Sa.Dir]
      Arrive
    end if
  end if
  Clock
  if Ouch > 0 then
    dec Ouch
    if Ouch = 0 then print at 13,21, "     "
  end if
  if Gifts >= Need then Over = 1
  return
end sub

' the stick as one direction (D), up and down first
sub StickDir:
  D = DNone
  if (J1 & 8) > 0 then D = 0
  if (J1 & 4) > 0 then D = 2
  if (J1 & 2) > 0 then D = 3
  if (J1 & 1) > 0 then D = 1
  return
end sub

' at a cell centre: take the remembered turn if it is open, else keep
' going; a wall ahead is a bump (REGULAR) or a stop (EASY)
sub AtCentre:
  if Sa.Want <> DNone then
    if IsOpen(Sa.Cx, Sa.Cy, Sa.Want) = 1 then
      Sa.Dir = Sa.Want
      return
    end if
  end if
  if Sa.Dir = DNone then return
  if IsOpen(Sa.Cx, Sa.Cy, Sa.Dir) = 1 then
    if Easy = 1 then
      if Sa.Want = DNone then Sa.Dir = DNone
    end if
    return
  end if
  if Easy = 1 then
    Sa.Dir = DNone
    return
  end if
  ' OUCH: time lost, turned round
  play sound SndBump
  inc Bumps
  Ouch = 40
  print at 13,21, "OUCH!"
  if TimeL > Pen then
    TimeL = TimeL - Pen
  else
    TimeL = 0
  end if
  DrawBar
  BlockD = Sa.Dir
  Sa.Dir = Sa.Dir ^ 2
  Sa.Want = Sa.Dir
  return
end sub

' Santa reaches a new cell: what is there, and the window
sub Arrive:
  Ci = Sa.Cy * MW
  Ci = Ci + Sa.Cx
  V = Maze[Ci]
  if (V & HasGift) > 0 then
    Maze[Ci] = V & 3
    inc Gifts
    play sound SndGift
    ClearCell
    ShowGifts
  end if
  if (V & HasHeart) > 0 then
    Maze[Ci] = V & 3
    inc Hearts
    TimeL = TMax
    TimeF = 0
    play sound SndHeart
    ClearCell
    DrawBar
  end if
  Camera
  return
end sub

' the floor where Santa's cell's gift or heart was
sub ClearCell:
  X = Sa.Cx - Cx0
  X = X * 3 + 3
  Y = Sa.Cy - Cy0
  Y = Y * 3 + 3
  fill TFloor count 2 at X,Y
  Y = Y + 1
  fill TFloor count 2 at X,Y
  return
end sub

' the window jumps three cells when Santa nears its edge
sub Camera:
  u8 Nx = 0
  u8 Ny = 0
  Nx = Cx0
  Ny = Cy0
  K = Sa.Cx - Cx0
  if K <= 1 then
    if Sa.Cx >= 7 then
      Nx = Sa.Cx - 7
    else
      Nx = 0
    end if
  end if
  if K >= 7 then
    Nx = Sa.Cx - 1
    if Nx > MW - 9 then Nx = MW - 9
  end if
  K = Sa.Cy - Cy0
  if K <= 1 then
    if Sa.Cy >= 4 then
      Ny = Sa.Cy - 4
    else
      Ny = 0
    end if
  end if
  if K >= 4 then
    Ny = Sa.Cy - 1
    if Ny > MH - 6 then Ny = MH - 6
  end if
  if Nx <> Cx0 or Ny <> Cy0 then
    Cx0 = Nx
    Cy0 = Ny
    inc Pans
    DrawView
  end if
  return
end sub

' the time bar: one slice every TPer frames
sub Clock:
  inc TimeF
  if TimeF < TPer then return
  TimeF = 0
  if TimeL > 0 then dec TimeL
  if TimeL = TLow then play sound SndLow
  DrawBar
  if TimeL = 0 then Over = 2
  return
end sub

' ---------------------------------------------------------------------------
' drawing
' the window: 9 x 6 cells, 28 x 19 tiles from column 2, row 2
sub DrawView:
  u8 Wy = 0
  u8 Sy = 0
  u8 My = 0
  u8 Bx = 0
  u8 Cv = 0
  u16 Rw = 0
  My = Cy0
  Sy = 0
  for Wy = 0 to 18
    Rw = My * MW
    Rw = Rw + Cx0
    if Sy = 0 then
      ' a wall row: the pillars, and the wall above each cell
      for Gc = 0 to 8
        Bx = Gc * 3
        RowBuf[Bx] = TWall
        Cv = TWall
        if My > 0 then
          Ni = Rw - MW
          Ni = Ni + Gc
          if (Maze[Ni] & OpS) > 0 then Cv = TFloor
        end if
        RowBuf[Bx + 1] = Cv
        RowBuf[Bx + 2] = Cv
      next
      RowBuf[27] = TWall
    else
      ' a corridor row: the wall left of each cell, then its inside
      for Gc = 0 to 8
        Bx = Gc * 3
        Ni = Rw + Gc
        Cv = TWall
        if Cx0 + Gc > 0 then
          Ci = Ni - 1
          if (Maze[Ci] & OpE) > 0 then Cv = TFloor
        end if
        RowBuf[Bx] = Cv
        C = Maze[Ni]
        Cv = TFloor
        if (C & HasGift) > 0 then
          K = Cx0 + Gc + My
          Cv = GiftT[Mod3[K]]
          if Sy = 2 then Cv = Cv + 2
        end if
        if (C & HasHeart) > 0 then
          Cv = THeart00
          if Sy = 2 then Cv = Cv + 2
        end if
        if Cv = TFloor then
          RowBuf[Bx + 1] = TFloor + (Wy & 1)
          RowBuf[Bx + 2] = TFloor
        else
          RowBuf[Bx + 1] = Cv
          RowBuf[Bx + 2] = Cv + 1
        end if
      next
      Cv = TWall
      if (C & OpE) > 0 then Cv = TFloor
      RowBuf[27] = Cv
    end if
    W16 = Wy + 2
    W16 = W16 << 5
    W16 = W16 + 2
    copy RowBuf count 28 to vram.name + W16
    inc Sy
    if Sy = 3 then
      Sy = 0
      inc My
    end if
  next
  return
end sub

' the time bar: 22 tiles from column 7, row 22, 8 slices a tile
sub DrawBar:
  u8 Full = 0
  u8 Part = 0
  u8 Base = 0
  Full = TimeL >> 3
  Part = TimeL & 7
  Base = TBar0
  if TimeL <= TLow then Base = TRbar0
  for Lk = 0 to 21
    if Lk < Full then
      RowBuf[Lk] = Base + 8
    else
      if Lk = Full then
        RowBuf[Lk] = Base + Part
      else
        RowBuf[Lk] = Base
      end if
    end if
  next
  copy RowBuf count 22 to vram.name + 711
  return
end sub

sub ShowGifts:
  NumU = Gifts
  print at 10,1, digits$(NumU, 3)
  return
end sub

' Santa: four layers, the stride changes every 6 pixels; the star above
' his head while OUCH shows
sub DrawSanta:
  u8 Fr = 0
  X = Sa.Cx - Cx0
  X = X * 24 + 24
  Y = Sa.Cy - Cy0
  Y = Y * 24 + 23
  K = Sa.Pix >> 1
  select case Sa.Dir
    case 0
      X = X + K
    case 1
      Y = Y - K
    case 2
      X = X - K
    case 3
      Y = Y + K
  end select
  Fr = 0
  if Sa.Dir <> DNone then
    if Sa.Pix >= 24 then Fr = 32
  end if
  Fr = Fr + Sa.Face * 16
  set sprite 0 to Y,X,Fr,1
  set sprite 1 to Y,X,Fr + 4,9
  set sprite 2 to Y,X,Fr + 8,15
  set sprite 3 to Y,X,Fr + 12,8
  if Ouch > 0 then
    set sprite 4 to Y - 16,X,SOuch,6
  else
    set sprite 4 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  MakeMaze
  DropItems
  print at 2,1, "GIFTS"
  put char TIcon at 8,1
  print at 14,1, "OF 100"
  if Easy = 1 then print at 23,1, "EASY"
  put char TClock at 5,22
  print at 2,22, "TIME"
  Sa.Cx = 0
  Sa.Cy = 0
  Sa.Dir = DNone
  Sa.Want = DNone
  Sa.Pix = 0
  Sa.Face = 0
  Cx0 = 0
  Cy0 = 0
  Gifts = 0
  TimeL = TMax
  TimeF = 0
  Ouch = 0
  BlockD = DNone
  Over = 0
  Bumps = 0
  Hearts = 0
  Pans = 0
  DrawView
  DrawBar
  ShowGifts
  DrawSanta
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: candy-cane letters, Santa walking under them, the menu, the
' carol once
sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 64
  print at 6,15, "AHOY! DECEMBER 1985"
  print at 7,16, "BY GEORGE TREPAL"
  print at 12,18, "REGULAR"
  print at 12,19, "EASY"
  print at 12,20, "CREDITS"
  if Best > 0 then
    NumU = Best
    print at 10,22, "BEST ", digits$(NumU, 3)
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 1024
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Easy = 0
  if Menu = 1 then Easy = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

' Santa walks to and fro under the title, a pixel a frame
sub TitleAnim:
  u8 Tf = 0
  if TbD = 1 then
    inc TbX
    if TbX >= 224 then TbD = 2
  else
    dec TbX
    if TbX <= 16 then TbD = 1
  end if
  Tf = TbX >> 3
  Tf = (Tf & 1) * 32
  if TbD = 2 then Tf = Tf + 16
  set sprite 0 to 103,TbX,Tf,1
  set sprite 1 to 103,TbX,Tf + 4,9
  set sprite 2 to 103,TbX,Tf + 8,15
  set sprite 3 to 103,TbX,Tf + 12,8
  update sprites
  return
end sub

sub ShowMenu:
  for Lk = 18 to 20
    put char 32 at 10,Lk
  next
  J = Menu + 18
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "SANTA'S BUSY DAY"
  print at 2,5, "BASED ON SANTA'S BUSY DAY"
  print at 2,6, "BY GEORGE TREPAL, AHOY!"
  print at 2,7, "DECEMBER 1985 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME AND"
  print at 2,12, "PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: DECK THE HALLS"
  print at 2,19, "(TRADITIONAL CAROL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
SaGift:
    db $40,$55,$20,$02,$40,$47,$20,$02,$40,$35,$30,$04,$40,$35,$50,$04,$50
SaBump:
    db $00,$00,$06,$03,$00,$00,$27,$05,$00,$00,$57,$06,$10
SaHeart:
    db $40,$D6,$20,$04,$40,$AA,$20,$04,$40,$8F,$20,$04,$40,$6B,$20,$04,$40,$8F,$20,$04,$40,$6B,$30,$0C
    db $50
SaStart:
