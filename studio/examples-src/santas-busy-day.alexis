    db $1A,$01,$01,$01,$1C,$01,$01,$1E,$1F,$01,$1C,$01,$1E,$01,$01,$1F
    db $21,$01,$1C,$01,$1E,$20,$21,$01,$23,$25,$26,$01,$25,$01,$23,$01
    db $21,$01,$01,$01,$21,$01,$01,$1F,$1E,$01,$1C,$01,$1A,$01,$1C,$01
    db $1E,$01,$1A,$01,$1C,$1E,$1F,$1C,$1E,$01,$01,$1C,$1A,$01,$19,$01
    db $1A,$01,$01,$01
