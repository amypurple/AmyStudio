cartridge "30TH ANNIVERSARY/AMY/2026"

' 1996-2026 ColecoVision anniversary demo.
' The original 10 years anniversary cake demo was first published in 2006,
' when the devkit already had mature VisualBASIC-era graphics and sound tools.
picture CakePicture:
  pattern from "@project/cake.pattern.zx0" codec zx0
  color from "@project/cake.color.zx0" codec zx0
end picture

intro:
  text screen
  backdrop sky blue
  print centered at 4, "30 YEARS COLECOVISION"
  print centered at 6, "1996 - 2026"
  print centered at 9, "THIS DEMO HONORS"
  print centered at 10, "THE DEVKIT, TOOLS,"
  print centered at 11, "DOCS, MUSIC, AND HELP"
  print centered at 13, "THAT BECAME AMY STUDIO"
  print centered at 18, "PRESS FIRE"
  screen on
  pause until press
  wait no fire

again:
  show picture CakePicture
  set sound table HappyBirthdaySoundTable
  wait 5 frames
  play sound 1
  play sound 2
  wait 800 frames or press
  wipe bitmap up
  goto again

asm {
