const NSpr = 6
const RowT = 4
const Cap = 18
const MsgRow = 22
const NoCol = 255

' face-down pattern of rows 1-8 (bit 6 = column 1 ... bit 0 = column 7,
' 1 = face up), the original's table at $0874 read the same way
data UpPat bytes
  $41,$63,$77,$7F,$41,$63,$77,$7F
end data

record Pile:
  u8 Rank
  u8 X
end record

Pile Home[4]

' the cards 1-52: suit (0 spades, 1 hearts, 2 diamonds, 3 clubs), rank
u8 Su[53]
u8 Rk[53]
' the columns as linked lists: the card under / over each card
u8 Below[53]
u8 Above[53]
u8 Up[53]
u8 ColOf[53]
u8 Head[7]
u8 Tail[7]
u8 Len[7]
u8 Top[7]
u8 Deck[52]
u8 NHome = 0
bcd digits 4 Moves = 0
u16 Seed = 1
u16 Rs = 1
u16 Tick16 = 0
u16 Wins = 0
u16 Losses = 0
u8 Dealt = 0
u8 CurC = 0
u8 CurK = 0
u8 Over = 0
u8 Won = 0
' Ph: 1 waiting for a move, 3 the GIVE UP question, 0 busy (for the bot)
u8 Ph = 0
u8 Ask = 0
u8 TitleOn = 0
u8 Menu = 0
u8 RepT = 0
u8 GlK = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 P1 = 0
u8 P2 = 0
u8 Tick = 0
u8 Idle = 0
u8 Li = 0
u8 Lw = 0
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ScSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  InitCards
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowToPage
    goto title
  end if
  if Menu = 3 then
    CreditsPage
    goto title
  end if
  if Menu = 0 then NewSeed
  if Dealt = 0 then NewSeed
  Deal

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  Ph = 0
  HideSprites
  fill 32 count 28 at 2,MsgRow
  if Won = 1 then
    inc Wins
    print at 4,MsgRow, "ALL CARDS HOME: YOU WIN!"
    play sound SndWin
  else
    inc Losses
    if Over = 2 then
      print at 2,MsgRow, "YOU GAVE UP:"
    else
      print at 2,MsgRow, "NO MOVES LEFT:"
    end if
    print NHome at 17,MsgRow width 2
    print at 20,MsgRow, "CARDS HOME"
    play sound SndOver
  end if
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ask = 0
  goto title

' ---------------------------------------------------------------------------
' the deck

sub InitCards:
  u8 Ic = 0
  u8 Q = 0
  for Ic = 1 to 52
    Q = Ic - 1
    Su[Ic] = Q / 13
    Rk[Ic] = Q % 13 + 1
  next
  for Ic = 0 to 3
    Home[Ic].Rank = 0
    Home[Ic].X = Ic * 4 + 14
  next
  return
end sub

' xorshift (7, 9, 8): the next 16-bit number
function Rnd as u16
  u16 R = 0
  R = Rs << 7
  Rs = Rs ^ R
  R = Rs >> 9
  Rs = Rs ^ R
  R = Rs << 8
  Rs = Rs ^ R
  return Rs

sub NewSeed:
  Seed = Tick16 * 251
  Seed = Seed + Wins
  Seed = Seed + Losses
  Seed = Seed & 32767
  if Seed = 0 then Seed = 1
  Dealt = 1
  return
end sub

' shuffle deal Seed and lay it out: rows 1-7 over the seven columns, row
' 8 under columns 3-5; a card is face down where UpPat says so
sub Deal:
  u8 Di = 0
  u8 Dj = 0
  u8 Dr = 0
  u8 Dc = 0
  u8 Dk = 0
  u8 Pat = 0
  u16 R = 0
  for Di = 0 to 51
    Deck[Di] = Di + 1
  next
  Rs = Seed
  for Di = 51 to 1 step -1
    R = Rnd
    V = Di + 1
    Dj = R % V
    T = Deck[Di]
    Deck[Di] = Deck[Dj]
    Deck[Dj] = T
  next
  for Di = 1 to 52
    Below[Di] = 0
    Above[Di] = 0
    Up[Di] = 0
    ColOf[Di] = NoCol
  next
  for Dc = 0 to 6
    Head[Dc] = 0
    Tail[Dc] = 0
    Len[Dc] = 0
    Top[Dc] = 1
  next
  for Di = 0 to 3
    Home[Di].Rank = 0
  next
  Dk = 0
  for Dr = 0 to 7
    Pat = UpPat[Dr]
    for Dc = 0 to 6
      if Dr < 7 or (Dc >= 2 and Dc <= 4) then
        T = Deck[Dk]
        inc Dk
        V = 64 >> Dc
        V = Pat & V
        if V > 0 then Up[T] = 1
        Attach(T, Dc)
      end if
    next
  next
  NHome = 0
  Moves = 0
  Over = 0
  Won = 0
  CurC = 0
  CurK = Tail[0]
  DrawPlay
  return
end sub

' put card Ak under column Ac's last card (Ak alone)
sub Attach(u8 Ak, u8 Ac):
  u8 Lt = 0
  Lt = Tail[Ac]
  if Lt = 0 then
    Head[Ac] = Ak
  else
    Below[Lt] = Ak
  end if
  Above[Ak] = Lt
  Below[Ak] = 0
  Tail[Ac] = Ak
  ColOf[Ak] = Ac
  inc Len[Ac]
  return
end sub

' the place of card Ik in its column (1 = first)
function IndexOf(u8 Ik) as u8
  u8 N = 0
  u8 Q = 0
  Q = Ik
  while Q <> 0
    inc N
    Q = Above[Q]
  end while
  return N

' ---------------------------------------------------------------------------
' rules

' the column that card Tk would go onto, or NoCol
function TargetOf(u8 Tk) as u8
  u8 Tc = 0
  u8 Tt = 0
  u8 Ts = 0
  u8 Tr = 0
  u8 Mc = 0
  Mc = ColOf[Tk]
  Ts = Su[Tk]
  Tr = Rk[Tk] + 1
  for Tc = 0 to 6
    if Tc <> Mc then
      Tt = Tail[Tc]
      if Tt = 0 then
        if Tr = 14 and Above[Tk] <> 0 then return Tc
      else
        if Su[Tt] = Ts and Rk[Tt] = Tr then return Tc
      end if
    end if
  next
  return NoCol

' 1 if card Hk can go home now (last in its column, next of its suit)
function CanHome(u8 Hk) as u8
  u8 Hs = 0
  u8 Hr = 0
  if Below[Hk] <> 0 then return 0
  Hs = Su[Hk]
  Hr = Home[Hs].Rank + 1
  if Rk[Hk] = Hr then return 1
  return 0

' any move left? (the original's check at $1250)
function AnyMove as u8
  u8 Ak = 0
  u8 Ok = 0
  for Ak = 1 to 52
    if ColOf[Ak] <> NoCol and Up[Ak] = 1 then
      Ok = CanHome(Ak)
      if Ok = 1 then return 1
      Ok = TargetOf(Ak)
      if Ok <> NoCol then return 1
    end if
  next
  return 0

' the left button on card Pk
sub Pick(u8 Pk):
  u8 Pc = 0
  u8 Pd = 0
  u8 Ok = 0
  u8 Ps = 0
  u8 Pn = 0
  Ph = 0
  if Pk = 0 then
    Refuse
    return
  end if
  if Up[Pk] = 0 then
    Refuse
    return
  end if
  Pc = ColOf[Pk]
  Ok = CanHome(Pk)
  if Ok = 1 then
    Ps = Su[Pk]
    GoHome(Pk)
    ' the next cards of the same suit follow while face up
    Pn = Tail[Pc]
    while Pn <> 0
      if Up[Pn] = 0 or Su[Pn] <> Ps then exit while
      Ok = CanHome(Pn)
      if Ok = 0 then exit while
      GoHome(Pn)
      Pn = Tail[Pc]
    end while
    Moves += 1
    AfterMove(Pc)
    return
  end if
  Pd = TargetOf(Pk)
  if Pd = NoCol then
    Refuse
    return
  end if
  MoveTail(Pk, Pd)
  Moves += 1
  AfterMove(Pc)
  return
end sub

' card Gk (last of its column) to its home pile
sub GoHome(u8 Gk):
  u8 Gc = 0
  u8 Gs = 0
  u8 Ga = 0
  u8 Fx = 0
  u8 Fy = 0
  Gc = ColOf[Gk]
  Gs = Su[Gk]
  Ga = Above[Gk]
  Fx = 2 + Gc * 4
  Fy = CardRow(Gk)
  Detach(Gk)
  DrawCol(Gc)
  T = Home[Gs].X
  Glide(Gk, Fx, Fy, T, 2)
  Home[Gs].Rank = Rk[Gk]
  ColOf[Gk] = NoCol
  inc NHome
  DrawHome(Gs)
  ShowCount
  play sound SndHome
  return
end sub

' take Dk and the cards under it off their column
sub Detach(u8 Dk):
  u8 Dc = 0
  u8 Da = 0
  u8 Dn = 0
  u8 Q = 0
  Dc = ColOf[Dk]
  Da = Above[Dk]
  if Da = 0 then
    Head[Dc] = 0
  else
    Below[Da] = 0
  end if
  Q = Dk
  while Q <> 0
    inc Dn
    Q = Below[Q]
  end while
  Tail[Dc] = Da
  Len[Dc] = Len[Dc] - Dn
  Above[Dk] = 0
  FixTop(Dc, 0)
  return
end sub

' card Mk and its tail onto column Md
sub MoveTail(u8 Mk, u8 Md):
  u8 Mc = 0
  u8 Me = 0
  u8 Lt = 0
  u8 Q = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Ex = 0
  u8 Ey = 0
  Mc = ColOf[Mk]
  Sx = 2 + Mc * 4
  Sy = CardRow(Mk)
  Me = Tail[Mc]
  Detach(Mk)
  DrawCol(Mc)
  Lt = Tail[Md]
  if Lt = 0 then
    Head[Md] = Mk
  else
    Below[Lt] = Mk
  end if
  Above[Mk] = Lt
  Tail[Md] = Me
  Q = Mk
  while Q <> 0
    ColOf[Q] = Md
    inc Len[Md]
    Q = Below[Q]
  end while
  ' the view shows the moved card
  Top[Md] = 200
  T = IndexOf(Mk)
  FixTop(Md, T)
  Ex = 2 + Md * 4
  Ey = CardRow(Mk)
  Glide(Mk, Sx, Sy, Ex, Ey)
  DrawCol(Md)
  return
end sub

' turn up column Ac's new last card, put the cursor there, check the end
sub AfterMove(u8 Ac):
  u8 Lt = 0
  u8 Ok = 0
  Lt = Tail[Ac]
  if Lt <> 0 then
    if Up[Lt] = 0 then
      Up[Lt] = 1
      DrawCol(Ac)
      play sound SndFlip
    end if
  end if
  CurC = Ac
  CurK = Lt
  FixTop(Ac, 255)
  DrawCol(Ac)
  ShowMoves
  DrawCursor
  Ok = AnyMove
  if Ok = 0 then
    Over = 1
    if NHome = 52 then Won = 1
  end if
  return
end sub

sub Refuse:
  play sound SndBad
  fill 32 count 28 at 2,MsgRow
  print at 7,MsgRow, "NO PLACE FOR IT"
  Pause(40)
  ShowPrompt
  return
end sub

' ---------------------------------------------------------------------------
' the cursor

sub PlayStep:
  Ph = 1
  K = 0
  if Edge > 0 then
    K = Jk
    RepT = 16
  else
    if Jk > 0 then
      dec RepT
      if RepT = 0 then
        K = Jk
        RepT = 8
      end if
    end if
  end if
  if K > 0 then MoveCursor(K)
  if P1 = 1 then
    Pick(CurK)
  else
    if P2 = 1 then GiveUp
  end if
  return
end sub

sub MoveCursor(u8 Mk):
  u8 Q = 0
  u8 Nc = 0
  u8 Wi = 0
  Nc = CurC
  select case Mk
  case 1
    if CurK = 0 then return
    Q = Above[CurK]
    while Q <> 0
      if Up[Q] = 1 then exit while
      Q = Above[Q]
    end while
    if Q = 0 then return
    CurK = Q
  case 2
    if CurK = 0 then return
    Q = Below[CurK]
    while Q <> 0
      if Up[Q] = 1 then exit while
      Q = Below[Q]
    end while
    if Q = 0 then return
    CurK = Q
  case 4
    if CurC = 0 then return
    Nc = CurC - 1
  case 8
    if CurC = 6 then return
    Nc = CurC + 1
  case else
    return
  end select
  if Nc <> CurC then
    Wi = 1
    if CurK <> 0 then Wi = CardRow(CurK)
    CurC = Nc
    CurK = Nearest(Nc, Wi)
  end if
  T = 0
  if CurK <> 0 then T = IndexOf(CurK)
  V = Top[CurC]
  FixTop(CurC, T)
  if Top[CurC] <> V then DrawCol(CurC)
  play sound SndMove
  DrawCursor
  return
end sub

' the face-up card of column Nc whose screen row is nearest row Wr
function Nearest(u8 Nc, u8 Wr) as u8
  u8 Q = 0
  u8 Best = 0
  u8 Bd = 255
  u8 D = 0
  u8 Rr = 0
  Q = Head[Nc]
  while Q <> 0
    if Up[Q] = 1 then
      Rr = CardRow(Q)
      if Rr >= Wr then
        D = Rr - Wr
      else
        D = Wr - Rr
      end if
      if D <= Bd then
        Bd = D
        Best = Q
      end if
    end if
    Q = Below[Q]
  end while
  return Best

' the screen row of card Ck (its column's view); 0 when not shown
function CardRow(u8 Ck) as u8
  u8 Ci = 0
  u8 Cc = 0
  u8 Tp = 0
  Cc = ColOf[Ck]
  Ci = IndexOf(Ck)
  Tp = Top[Cc]
  if Ci < Tp then return RowT
  Ci = Ci - Tp
  if Ci >= Cap then return RowT + Cap - 1
  return Ci + RowT

' keep card index Fi (0 none, 255 the last) inside column Fc's view
sub FixTop(u8 Fc, u8 Fi):
  u8 Ln = 0
  u8 Mx = 0
  u8 Lo = 0
  u8 Hi = 0
  Ln = Len[Fc]
  if Ln <= Cap then
    Top[Fc] = 1
    return
  end if
  Mx = Ln - Cap + 1
  if Fi = 255 then Fi = Ln
  if Top[Fc] > Mx then Top[Fc] = Mx
  if Top[Fc] < 1 then Top[Fc] = 1
  if Fi = 0 then return
  ' visible: Lo to Hi (a row is lost to an arrow at either end)
  Lo = Top[Fc]
  if Lo > 1 then inc Lo
  Hi = Top[Fc] + Cap - 1
  if Hi < Ln then dec Hi
  while Fi < Lo
    dec Top[Fc]
    Lo = Top[Fc]
    if Lo > 1 then inc Lo
  end while
  Hi = Top[Fc] + Cap - 1
  if Hi < Ln then dec Hi
  while Fi > Hi
    inc Top[Fc]
    Hi = Top[Fc] + Cap - 1
    if Hi < Ln then dec Hi
  end while
  return
end sub

' the right button: give up?
sub GiveUp:
  Ph = 0
  fill 32 count 28 at 2,MsgRow
  print at 2,MsgRow, "GIVE UP? LEFT YES, RIGHT NO"
  Ph = 3
gu_loop:
  Frame1
  ReadPad
  if P1 = 1 then
    Ph = 0
    Over = 2
    return
  end if
  if P2 = 0 then goto gu_loop
  Ph = 0
  ShowPrompt
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' one card strip (face up or down) at column X, row Y
sub DrawCard(u8 Dk, u8 Dx, u8 Dy):
  u8 Ct = 0
  if Up[Dk] = 0 then
    fill TBack count 3 at Dx,Dy
    return
  end if
  Ct = Su[Dk]
  if Ct = 1 or Ct = 2 then
    T = TR11
  else
    T = TR01
  end if
  T = T + Rk[Dk]
  T = T - 1
  put char T at Dx,Dy
  inc Dx
  T = TS0 + Ct
  put char T at Dx,Dy
  inc Dx
  put char TBody at Dx,Dy
  return
end sub

sub DrawCol(u8 Dc):
  u8 Q = 0
  u8 Ci = 0
  u8 Rr = 0
  u8 Dx = 0
  u8 Tp = 0
  u8 Ln = 0
  Dx = Dc * 4
  Dx = Dx + 2
  Tp = Top[Dc]
  Ln = Len[Dc]
  for Rr = RowT to 21
    fill 32 count 3 at Dx,Rr
  next
  if Ln = 0 then
    put char TSlotl at Dx,RowT
    T = Dx + 1
    put char TSlotm at T,RowT
    inc T
    put char TSlotr at T,RowT
    return
  end if
  Q = Head[Dc]
  Ci = 1
  while Q <> 0
    if Ci >= Tp then
      Rr = Ci - Tp
      Rr = Rr + RowT
      if Rr > 21 then exit while
      if Rr = RowT and Tp > 1 then
        fill TMup count 3 at Dx,Rr
      else
        if Rr = 21 and Below[Q] <> 0 then
          fill TMdn count 3 at Dx,Rr
        else
          DrawCard(Q, Dx, Rr)
        end if
      end if
    end if
    inc Ci
    Q = Below[Q]
  end while
  return
end sub

sub DrawHome(u8 Hs):
  u8 Hx = 0
  u8 Hr = 0
  Hx = Home[Hs].X
  Hr = Home[Hs].Rank
  if Hr = 0 then
    put char TSlotl at Hx,2
    T = THs0 + Hs
    inc Hx
    put char T at Hx,2
    inc Hx
    put char TSlotr at Hx,2
    return
  end if
  if Hs = 1 or Hs = 2 then
    T = TR11
  else
    T = TR01
  end if
  T = T + Hr - 1
  put char T at Hx,2
  inc Hx
  T = TS0 + Hs
  put char T at Hx,2
  inc Hx
  put char TBody at Hx,2
  return
end sub

sub ShowCount:
  print NHome at 7,2 width 2
  return
end sub

sub ShowMoves:
  print Moves at 9,1
  return
end sub

sub ShowPrompt:
  fill 32 count 28 at 2,MsgRow
  print at 2,MsgRow, "PICK A CARD   RIGHT=GIVE UP"
  return
end sub

' the cursor: a yellow frame round the card strip (or the empty place)
sub DrawCursor:
  u8 Cx = 0
  u8 Cy = 0
  u8 Ex = 0
  u8 Rr = 0
  Rr = RowT
  if CurK <> 0 then Rr = CardRow(CurK)
  Cx = CurC * 32
  Cx = Cx + 16
  Cy = Rr * 8
  Cy = Cy - 2
  Ex = Cx + 9
  set sprite 4 to Cy,Cx,SCurl,11
  set sprite 5 to Cy,Ex,SCurr,11
  update sprites
  return
end sub

' card Gk glides as sprites from tile (Ax, Ay) to tile (Bx, By)
sub Glide(u8 Gk, u8 Ax, u8 Ay, u8 Bx, u8 By):
  i16 X0 = 0
  i16 Y0 = 0
  i16 Dx = 0
  i16 Dy = 0
  i16 Px = 0
  i16 Py = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 S2 = 0
  u8 Gc = 0
  u8 Gp = 0
  u8 Gs = 0
  u8 Gl = 0
  GlK = Gk
  X0 = Ax * 8
  Y0 = Ay * 8
  Y0 = Y0 - 1
  Dx = Bx * 8
  Dx = Dx - X0
  Dy = By * 8
  Dy = Dy - 1
  Dy = Dy - Y0
  Gc = 1
  if Su[Gk] = 1 or Su[Gk] = 2 then Gc = 8
  Gp = Rk[Gk] - 1
  Gp = Gp << 2
  Gp = Gp + SSr1
  Gs = Su[Gk] << 2
  Gs = Gs + SSs0
  set sprite 4 to 192,0,0,0
  set sprite 5 to 192,0,0,0
  play sound SndSlide
  for Gl = 1 to 12
    Px = Dx * Gl
    Px = Px / 12
    Px = Px + X0
    Py = Dy * Gl
    Py = Py / 12
    Py = Py + Y0
    Sx = Px
    Sy = Py
    S2 = Sx + 8
    set sprite 0 to Sy,Sx,Gp,Gc
    set sprite 1 to Sy,S2,Gs,Gc
    set sprite 2 to Sy,Sx,SCbody,15
    S2 = Sx + 8
    set sprite 3 to Sy,S2,SCbody,15
    update sprites
    Frame1
  next
  for Gl = 0 to 3
    set sprite Gl to 192,0,0,0
  next
  update sprites
  GlK = 0
  return
end sub

sub DrawPlay:
  u8 Dc = 0
  NewScreen
  print at 2,1, "MOVES"
  print at 17,1, "DEAL"
  NumU = Seed
  print at 22,1, digits$(NumU, 5)
  print at 2,2, "HOME"
  for Dc = 0 to 3
    DrawHome(Dc)
  next
  for Dc = 0 to 6
    DrawCol(Dc)
  next
  ShowCount
  ShowMoves
  ShowPrompt
  ShowScreen
  DrawCursor
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Pf):
  for Lw = 1 to Pf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  Tick16 += 1
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  B1 = V & 16
  B2 = V & 32
  P1 = 0
  P2 = 0
  if B1 > 0 then
    if WasB1 = 0 then P1 = 1
  end if
  if B2 > 0 then
    if WasB2 = 0 then P2 = 1
  end if
  WasB1 = B1
  WasB2 = B2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TitlePage:
  u16 Tq = 0
  u16 Tv = 0
  u8 Tr = 0
  Ask = 0
  TitleOn = 1
  Menu = 0
  NewScreen
  for Tr = 0 to 1
    Tq = Tr * TitleW
    Tv = Tr + 3
    Tv = Tv * 32
    Tv = Tv + TitleX
    copy TitleMap + Tq count TitleW to vram.name + Tv
  next
  ' the tail: hearts fanned under the title
  for Tr = 0 to 3
    T = Tr * 3
    T = T + 9
    V = Tr + 6
    X = TR11 + 12
    X = X - Tr
    put char X at T,V
    inc T
    put char TS1 at T,V
    inc T
    put char TBody at T,V
  next
  print at 3,10, "ALL 52 CARDS ARE DEALT."
  print at 3,11, "PICK A CARD: IT JUMPS WITH"
  print at 3,12, "ITS TAIL ONTO THE CARD ONE"
  print at 3,13, "HIGHER OF ITS SUIT. ACES"
  print at 3,14, "AND THEIR SUITS GO HOME."
  print at 3,15, "GET ALL 52 CARDS HOME!"
  print at 11,17, "NEW DEAL"
  print at 11,18, "SAME DEAL"
  print at 11,19, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 4,21, "WON"
  NumU = Wins
  print at 8,21, digits$(NumU, 3)
  print at 14,21, "LOST"
  NumU = Losses
  print at 19,21, digits$(NumU, 3)
  print at 4,22, "COMPUTE!'S GAZETTE 1988"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 440
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  K = Edge & 3
  if K = 1 then
    if Menu = 0 then
      Menu = 3
    else
      dec Menu
    end if
    play sound SndMove
    ShowMenu
  end if
  if K = 2 then
    inc Menu
    if Menu = 4 then Menu = 0
    play sound SndMove
    ShowMenu
  end if
  V = P1 | P2
  if V = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  return
end sub

sub ShowMenu:
  for Li = 17 to 20
    put char 32 at 9,Li
  next
  C = Menu + 17
  put char 62 at 9,C
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "A CARD GAME FOR ONE. ALL 52"
    print at 2,4, "CARDS ARE DEALT IN SEVEN"
    print at 2,5, "COLUMNS. GET EVERY CARD TO"
    print at 2,6, "ITS SUIT'S HOME PILE, FROM"
    print at 2,7, "THE ACE UP TO THE KING."
    print at 2,9, "PICK A CARD AND IT MOVES BY"
    print at 2,10, "ITSELF, IF IT CAN."
    ' a home pile: the ace and two of hearts home, the three on its way
    put char TR11 + 1 at 6,13
    put char TS1 at 7,13
    put char TBody at 8,13
    put char TSlotl at 11,13
    put char THs0 at 12,13
    put char TSlotr at 13,13
    put char TR11 + 2 at 18,16
    put char TS1 at 19,16
    put char TBody at 20,16
    put char TR01 + 6 at 18,17
    put char TS3 at 19,17
    put char TBody at 20,17
    fill TBack count 3 at 18,15
    print at 5,15, "HOME PILES"
  case 2
    print at 2,1, "MOVES                   2/3"
    print at 2,3, "A PICKED CARD JUMPS, WITH"
    print at 2,4, "ALL CARDS BELOW IT (ITS"
    print at 2,5, "TAIL), ONTO THE CARD ONE"
    print at 2,6, "HIGHER OF THE SAME SUIT."
    print at 2,7, "A KING CAN GO TO AN EMPTY"
    print at 2,8, "COLUMN. A LAST CARD THAT"
    print at 2,9, "FITS ITS HOME GOES HOME."
    print at 2,10, "HIDDEN CARDS TURN UP WHEN"
    print at 2,11, "THEY ARE LAST."
    ' the 9 of spades with its tail joins the 10 of spades
    put char TR01 + 8 at 8,14
    put char TS0 at 9,14
    put char TBody at 10,14
    put char TR11 + 3 at 8,15
    put char TS2 at 9,15
    put char TBody at 10,15
    fill TBack count 3 at 18,14
    put char TR01 + 9 at 18,15
    put char TS0 at 19,15
    put char TBody at 20,15
    print at 12,14, "-->"
  case 3
    print at 2,1, "CONTROLS                3/3"
    print at 2,3, "JOYSTICK: MOVE THE YELLOW"
    print at 2,4, "FRAME FROM CARD TO CARD."
    print at 2,5, "LEFT BUTTON: PICK THE CARD."
    print at 2,6, "RIGHT BUTTON: GIVE UP."
    print at 2,8, "NO MOVES LEFT ENDS THE GAME."
    print at 2,9, "YOU WIN WITH ALL 52 HOME."
    print at 2,10, "SAME DEAL ON THE TITLE"
    print at 2,11, "REPLAYS THE SAME CARDS."
    print at 2,13, "TIP: FREE THE HIDDEN CARDS"
    print at 2,14, "EARLY, AND KEEP KINGS FOR"
    print at 2,15, "EMPTY COLUMNS."
    put char TR01 + 12 at 13,18
    put char TS3 at 14,18
    put char TBody at 15,18
  end select
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  V = P1 | P2
  Wt = Wt + 1
  if Wt >= 1800 then return
  if V = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,2, "SCORPION II"
  print at 2,5, "BASED ON SCORPION II BY"
  print at 2,6, "DARRELL G. ROSE, COMPUTE!'S"
  print at 2,7, "GAZETTE, OCTOBER 1988"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: STING IN THE TAIL"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Ask = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Ask = 0
  return
end sub

