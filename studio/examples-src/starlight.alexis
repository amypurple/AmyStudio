  $01,$41,$41,$41,$41,$14,$41,$41
  $41,$41,$41,$41,$41,$41,$41,$01
  $41,$41,$41,$41,$41,$41,$41,$01
  $01,$B1,$B1,$B1,$B1,$0B,$1B,$1B
  $01,$B1,$B1,$B1,$B1,$0B,$1B,$1B
  $1B,$1B,$1B,$1B,$B1,$B1,$B1,$01
  $1B,$B1,$B1,$1B,$B1,$B1,$B1,$01
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$01,$01,$07
  $07,$01,$01,$01,$01,$01,$01,$01
  $71,$71,$71,$71,$71,$71,$71,$71
  $71,$71,$71,$71,$71,$71,$71,$71
  $71,$71,$71,$71,$71,$71,$71,$71
  $71,$71,$71,$71,$71,$71,$71,$71
  $01,$01,$01,$F1,$01,$01,$01,$01
  $01,$01,$01,$01,$E1,$01,$01,$01
end data
data SpritePat bytes
  $E0,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$80,$E0
  $07,$01,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$01,$07
  $00,$01,$01,$00,$40,$00,$00,$20,$00,$00,$04,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$04,$00,$00,$08,$00,$00,$20,$00,$00,$00,$00,$00
end data

asm {
SlHush:
    db $00,$00,$F4,$01,$10
SlTick:
    db $40,$47,$70,$01,$40,$47,$C0,$01,$50
SlWake:
    db $40,$55,$30,$02,$40,$40,$40,$02,$40,$35,$60,$03,$40,$35,$B0,$04,$50
SlSleep:
    db $40,$7F,$50,$02,$40,$AA,$80,$03,$40,$AA,$D0,$03,$50
SlDone:
    db $40,$6B,$20,$06,$40,$55,$20,$06,$40,$47,$20,$06,$40,$35,$20,$0A,$40,$35,$80,$14,$50

SlSoundTable:
    dw SlHush,$702B
    dw SlTick,$7035
    dw SlWake,$7035
    dw SlSleep,$7035
    dw SlDone,$7035
    dw SlTuneMel,$703F
    dw SlTuneBass,$7049
; Counting Stars at Dusk (original for this game)
; Tiny Sound, 8 frames per step
SlTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$40,$F1,$22,$23,$00,$28,$00,$2B,$00,$2A,$00,$28,$00,$23,$00
    db $26,$00,$24,$00,$23,$00,$00,$00,$21,$00,$00,$00,$1F,$00,$23,$00
    db $28,$00,$26,$00,$24,$00,$21,$00,$23,$00,$00,$00,$00,$00,$00,$00
    db $00,$00,$00,$00,$23,$00,$26,$00,$2B,$00,$2D,$00,$2F,$00,$00,$00
    db $2D,$00,$2B,$00,$2A,$00,$26,$00,$28,$00,$00,$00,$26,$00,$23,$00
    db $1F,$00,$21,$00,$23,$00,$26,$00,$2B,$00,$00,$00,$00,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
SlTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$70,$F1,$22,$04,$00,$0B,$00,$10,$00,$04,$00,$0B,$00,$10,$00
    db $0C,$00,$13,$00,$18,$00,$0B,$00,$12,$00,$17,$00,$04,$00,$0B,$00
    db $10,$00,$0C,$00,$13,$00,$18,$00,$0B,$00,$12,$00,$17,$00,$0B,$00
    db $12,$00,$17,$00,$07,$00,$0E,$00,$13,$00,$07,$00,$0E,$00,$13,$00
    db $0E,$00,$15,$00,$1A,$00,$0E,$00,$15,$00,$1A,$00,$0C,$00,$13,$00
    db $18,$00,$0E,$00,$15,$00,$1A,$00,$07,$00,$0E,$00,$13,$00,$07,$00
    db $0E,$00,$13,$00
    db $FF
}
