u8 K = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u16 NumU = 0
u16 Off16 = 0
u16 L0 = 0
u16 L1 = 0
u16 Li = 0
u8 LB[3]
u8 PicB[25]

  tile screen
  set sound table SlSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  Intro

title:
  TitlePage
  if Menu > 0 then goto title
  Night = 1

night_start:
  MakeNight
  DrawBoard

play_loop:
  Frame1
  ReadPad
  Twinkle
  ' the stick: one star a push
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      if Lf1 = 1 then
        if Cx > 0 then dec Cx
      end if
      if Rt1 = 1 then
        if Cx < 4 then inc Cx
      end if
      if Up1 = 1 then
        if Cy > 0 then dec Cy
      end if
      if Dn1 = 1 then
        if Cy < 4 then inc Cy
      end if
      play sound SndTick
    end if
  end if
  WasStick = V
  PlaceCursor
  if Press2 = 1 then
    ' the night again, as it began
    ResetNight
    DrawBoard
    goto play_loop
  end if
  if Press = 0 then goto play_loop
  C = Cy * 5
  C = C + Cx
  Toggle
  if Lit[C] = 1 then
    play sound SndWake
  else
    play sound SndSleep
  end if
  inc Moves
  Hud
  CheckSky
  if Solved = 0 then goto play_loop

  ' every star awake: the sky draws its picture
  NightDone
  inc Night
  if Night <= 10 then goto night_start
  Ending
  goto title

' ---------------------------------------------------------------------------
' The nights

' MakeNight: a fully awake sky, then Night + 2 different stars pressed
sub MakeNight:
  N = Night + 2
make_again:
  NScr = 0
  while NScr < N
    V = random(0, 24)
    V += Mix
    while V > 24
      V -= 25
    end while
    ' a star pressed twice would undo itself: take another
    W = 0
    for K = 0 to 11
      if K < NScr then
        if Scr[K] = V then W = 1
      end if
    next
    if W = 0 then
      Scr[NScr] = V
      inc NScr
    end if
    inc Mix
  end while
  ResetNight
  ' (a rare set of presses leaves the sky awake: then choose again)
  CheckSky
  if Solved = 1 then goto make_again
  return
end sub

' ResetNight: the night as it began (from Scr), no moves yet
sub ResetNight:
  for K = 0 to 24
    Lit[K] = 1
  next
  for J = 0 to 11
    if J < NScr then
      C = Scr[J]
      ToggleQuiet
    end if
  next
  Moves = 0
  Solved = 0
  return
end sub

' Toggle: the star C and its neighbours change, and are drawn
sub Toggle:
  ToggleQuiet
  Kx = C % 5
  Ky = C / 5
  Kc = C
  DrawStar
  if Kx > 0 then
    C = Kc - 1
    DrawStar
  end if
  if Kx < 4 then
    C = Kc + 1
    DrawStar
  end if
  if Ky > 0 then
    C = Kc - 5
    DrawStar
  end if
  if Ky < 4 then
    C = Kc + 5
    DrawStar
  end if
  C = Kc
  return
end sub

' ToggleQuiet: the same, in RAM only (C is kept)
sub ToggleQuiet:
  X = C % 5
  Y = C / 5
  Lit[C] = 1 - Lit[C]
  if X > 0 then
    V = C - 1
    Lit[V] = 1 - Lit[V]
  end if
  if X < 4 then
    V = C + 1
    Lit[V] = 1 - Lit[V]
  end if
  if Y > 0 then
    V = C - 5
    Lit[V] = 1 - Lit[V]
  end if
  if Y < 4 then
    V = C + 5
    Lit[V] = 1 - Lit[V]
  end if
  return
end sub

sub CheckSky:
  Solved = 1
  for K = 0 to 24
    if Lit[K] = 0 then Solved = 0
  next
  return
end sub

' NightDone: the picture's name, the moves, sparks over the stars
sub NightDone:
  play sound SndDone
  HideCursor
  DrawPicture
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  Off16 = Night - 1
  Off16 = Off16 * 28
  copy CName + Off16 count 28 to vram.name + 674
  print at 2,20, "IN"
  NumU = Moves
  print at 5,20, width$(NumU, 3)
  print at 9,20, "MOVES, FEWEST"
  NumU = NScr
  print at 23,20, width$(NumU, 2)
  for J = 1 to 150
    Frame1
    Twinkle
    V = Tick & 7
    if V = 0 then
      ' a spark over a random star
      K = random(0, 3)
      K += 1
      W = random(0, 24)
      X = W % 5
      Y = W / 5
      X = X * 24
      X = X + 64
      Y = Y * 24
      Y = Y + 31
      set sprite K to Y, X, SSpark, 15
      update sprites
    end if
  next
  HideSprites
  if Night < 10 then
    print at 2,22, "PRESS A BUTTON: NEXT NIGHT"
  else
    print at 2,22, "PRESS A BUTTON"
  end if
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' DrawPicture: the sky draws tonight's picture between the stars, a line at
' a time
sub DrawPicture:
  ' the stars outside the picture fade, so the picture stands out
  Off16 = Night - 1
  Off16 = Off16 * 25
  copy PicStars + Off16 count 25 to PicB
  for C = 0 to 24
    if PicB[C] = 0 then
      Lit[C] = 0
      DrawStar
      Lit[C] = 1
    end if
  next
  Frame1
  V = Night - 1
  L0 = LineOff[V]
  V = Night
  L1 = LineOff[V]
  Li = L0
  while Li < L1
    Off16 = Li * 3
    copy LineData + Off16 count 3 to LB
    put char LB[2] at LB[0],LB[1]
    inc Li
    V = Li & 1
    if V = 0 then
      Frame1
      Frame1
      Twinkle
    end if
  end while
  return
end sub

' DrawStar: star C, asleep or awake, at its place (2 x 2 tiles)
sub DrawStar:
  X = C % 5
  Y = C / 5
  X = X * 3
  X = X + 8
  Y = Y * 3
  Y = Y + 4
  W = TDim00
  if Lit[C] = 1 then W = TLit00
  put char W at X,Y
  W += 1
  X += 1
  put char W at X,Y
  W += 1
  X -= 1
  Y += 1
  put char W at X,Y
  W += 1
  X += 1
  put char W at X,Y
  return
end sub

sub DrawBoard:
  NewScreen
  ' faint stars far away, around the puzzle
  for K = 0 to 39
    X = random(2, 29)
    Y = random(3, 19)
    W = 0
    if X >= 7 then
      if X <= 23 then
        if Y >= 3 then
          if Y <= 18 then W = 1
        end if
      end if
    end if
    if W = 0 then
      V = TTwk
      N = K & 1
      if N = 1 then V = TTwk2
      put char V at X,Y
    end if
  next
  for C = 0 to 24
    DrawStar
  next
  Hud
  print at 2,21, "WAKE EVERY STAR. EACH STAR"
  print at 2,22, "WAKES ITS FOUR NEIGHBOURS."
  ShowScreen
  PlaceCursor
  return
end sub

sub Hud:
  print at 2,1, "STARLIGHT"
  print at 13,1, "NIGHT"
  NumU = Night
  print at 19,1, width$(NumU, 2)
  print at 23,1, "M"
  NumU = Moves
  print at 25,1, digits$(NumU, 3)
  return
end sub

sub PlaceCursor:
  X = Cx * 24
  X = X + 64
  Y = Cy * 24
  Y = Y + 31
  V = 7
  N = Tick & 16
  if N > 0 then V = 15
  set sprite 0 to Y, X, SCursor, V
  update sprites
  return
end sub

sub HideCursor:
  set sprite 0 to 192, 0, 0, 0
  update sprites
  return
end sub

' Twinkle: the faraway stars change colour now and then (colour table)
sub Twinkle:
  V = Tick & 31
  if V <> 0 then return
  V = Tick & 32
  Uw16
  if V = 0 then
    copy TwA count 8 to vram.color + Off16
    Off16 = Off16 + 2048
    copy TwA count 8 to vram.color + Off16
    Off16 = Off16 + 2048
    copy TwA count 8 to vram.color + Off16
  else
    copy TwB count 8 to vram.color + Off16
    Off16 = Off16 + 2048
    copy TwB count 8 to vram.color + Off16
    Off16 = Off16 + 2048
    copy TwB count 8 to vram.color + Off16
  end if
  return
end sub

sub Uw16:
  Off16 = TTwk
  Off16 = Off16 << 3
  return
end sub

' ---------------------------------------------------------------------------
' Pages

' Intro: the dusk picture in 120 colours, a few seconds or a button
sub Intro:
  Rearm
  wait
  nmi off
  screen off
  picture screen
  decompress zx0 DuskA to vram $0000
  decompress zx0 DuskN to vram $1800
  decompress zx0 DuskB to vram $2000
  120 colors on
  screen on
  WasBtn = 1
  WasBtn2 = 1
  for N = 1 to 240
    Frame1
    ReadPad
    if Press = 1 then N = 240
    if Press2 = 1 then N = 240
  next
  120 colors off
  Rearm
  wait
  nmi off
  screen off
  tile screen
  copy SpritePat count SprBytes to vram.spr_pat
  return
end sub

sub TitlePage:
  NewScreen
  for K = 0 to 4
    X = K * 5
    X = X + 5
    C = 0
    Lit[0] = K & 1
    Y = 3
    W = TDim00
    if Lit[0] = 1 then W = TLit00
    put char W at X,Y
    W += 1
    X += 1
    put char W at X,Y
    W += 1
    X -= 1
    Y += 1
    put char W at X,Y
    W += 1
    X += 1
    put char W at X,Y
  next
  print at 11,8, "STARLIGHT"
  print at 4,10, "WAKE THE STARS, ONE NIGHT"
  print at 4,11, "AT A TIME."
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 768
  TzOn = 1
  Menu = 0
  WasBtn = 1
  WasStick = 1
tp_loop:
  Frame1
  ReadPad
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Menu > 0 then dec Menu
      end if
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  mute all
  TzOn = 0
  if Menu = 1 then HowPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for K = 15 to 17
    fill 32 count 28 at 2,K
  next
  print at 11,15, "START"
  print at 11,16, "HOW TO PLAY"
  print at 11,17, "CREDITS"
  V = Menu + 15
  put char 62 at 9,V
  return
end sub

sub HowPage:
  NewScreen
  print at 10,2, "HOW TO PLAY"
  print at 2,5, "TWENTY-FIVE STARS SLEEP."
  print at 2,6, "PRESS THE BUTTON ON A STAR:"
  print at 2,7, "IT CHANGES, AND SO DO ITS"
  print at 2,8, "FOUR NEIGHBOURS (UP, DOWN,"
  print at 2,9, "LEFT, RIGHT): ASLEEP WAKES,"
  print at 2,10, "AWAKE GOES BACK TO SLEEP."
  print at 2,12, "WAKE EVERY STAR AND THE SKY"
  print at 2,13, "DRAWS A PICTURE. TEN NIGHTS."
  print at 2,15, "STICK: MOVE BETWEEN STARS"
  print at 2,16, "LEFT BUTTON: PRESS A STAR"
  print at 2,17, "RIGHT BUTTON: TRY AGAIN"
  print at 2,19, "THERE IS NO HURRY."
  PagePause
  return
end sub

sub CreditsPage:
  NewScreen
  print at 11,2, "STARLIGHT"
  print at 2,5, "AN ORIGINAL GAME BY CLAUDE"
  print at 2,6, "(AN AI MADE BY ANTHROPIC)"
  print at 2,7, "FOR AMY STUDIO, 2026."
  print at 2,9, "WRITTEN IN AMY, THE LANGUAGE"
  print at 2,10, "AND STUDIO OF AMY BIENVENU."
  print at 2,12, "THE PUZZLE IS THE CLASSIC"
  print at 2,13, "LIGHTS-OUT KIND (TIGER"
  print at 2,14, "ELECTRONICS, 1995). STARS,"
  print at 2,15, "NIGHTS, PICTURES AND MUSIC"
  print at 2,16, "ARE NEW."
  print at 2,18, "MUSIC: COUNTING STARS AT DUSK"
  PagePause
  return
end sub

sub Ending:
  NewScreen
  for C = 0 to 24
    Lit[C] = 1
    DrawStar
  next
  print at 2,1, "TEN NIGHTS, TEN PICTURES."
  print at 2,21, "THE SKY IS FULL. GOODNIGHT,"
  print at 2,22, "STARGAZER."
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 768
  TzOn = 1
  for J = 1 to 200
    Frame1
    Twinkle
  next
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  mute all
  TzOn = 0
  CreditsPage
  return
end sub

sub PagePause:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' Frame and screen helpers

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  sprites stable 0 to 0
  for J = 0 to 5
    set sprite J to 192, 0, 0, 0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

data TilePat bytes
  $00,$01,$02,$02,$04,$07,$40,$20
  $00,$80,$40,$40,$20,$E0,$02,$04
  $10,$08,$09,$12,$14,$28,$30,$00
  $08,$10,$90,$48,$28,$14,$0C,$00
  $00,$01,$03,$03,$07,$00,$80,$C0
  $00,$80,$C0,$C0,$E0,$00,$01,$03
  $E0,$F0,$F0,$E1,$1C,$38,$30,$00
  $07,$F0,$F0,$87,$38,$1C,$0C,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $01,$01,$01,$01,$01,$01,$01,$01
  $80,$80,$80,$80,$80,$80,$80,$80
  $80,$40,$20,$10,$08,$04,$02,$01
  $01,$02,$04,$08,$10,$20,$40,$80
  $00,$00,$00,$10,$00,$00,$00,$00
  $00,$00,$00,$00,$04,$00,$00,$00
