project "SPRITE FLICKER SELFTEST"
memory "colecovision_legacy_sdcc"

data FlickerSpritePatterns bytes
  $00,$24,$24,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$42,$3C,$00,$00
  $3C,$7E,$FF,$FF,$FF,$FF,$7E,$3C
  $FF,$81,$BD,$A5,$A5,$BD,$81,$FF
  $18,$3C,$7E,$FF,$7E,$3C,$18,$00
  $81,$42,$24,$18,$18,$24,$42,$81
  $AA,$55,$AA,$55,$AA,$55,$AA,$55
  $00,$18,$3C,$7E,$7E,$3C,$18,$00
end data

' Sprites 0..2 represent one layered player and must remain visually stable.
sprites stable 0 to 2

text screen
sprites 8x8
sprites simple
copy FlickerSpritePatterns to vram.spr_pat
clear sprites
set sprite count 8
set sprite 0 to 80,96,0,6
set sprite 1 to 80,96,1,9
set sprite 2 to 80,96,2,15
set sprite 3 to 80,104,3,8
set sprite 4 to 80,112,4,11
set sprite 5 to 80,120,5,13
set sprite 6 to 80,128,6,14
set sprite 7 to 80,136,7,7
sprites flicker on
print centered at 4, "SPRITE FLICKER TEST"
print centered at 6, "3 STABLE + 5 ROTATING"
print centered at 18, "ALL SHARE ONE SCANLINE"
screen on

MainLoop:
  wait
  update sprites
  goto MainLoop
