cartridge "LAWN JOB/MIKE BUHIDAR JR./1984"

' LAWN JOB
' A ColecoVision game based on "Lawn Job" by Mike Buhidar Jr., Ahoy! 1984
' (Commodore 64, BASIC; disk "ahoy1984jul-dec (unofficial)"). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/lawnjob.bas), the game is built for the ColecoVision: a
' smooth two-colour mower sprite that drives from cell to cell, tiled yard
' scenery (house, garage, fences, hedges, tree, bird bath, street), mowing
' stripes, sound effects and an original title tune.
'
' The game: you have been hired to mow a lawn. Your mower starts in the
' street with its engine off: pull the cord (press a button) until it
' catches. Drive it over every patch of tall grass; each patch earns 5
' cents. Rocks hide in the lawn: run into one and the engine dies (a repair
' bill of 50 cents) and you pull the cord again. When the lawn is done,
' drive up to the garage door and press a button: your work is looked over.
' Your pay is what you earned, less the time the job took and the repairs.
'
' From the original (orig/lawnjob.bas): moves of one cell with the stick
' (diagonals ignored); tall grass, mowed grass and the sidewalk/walk can be
' driven on, everything else blocks; 5 cents for each patch of tall grass
' mowed; the yard (a house with a garage, a sidewalk along the street, a
' walk up to the garage, fences); the mower starting in the street, unable
' to go back to it; 10 to 19 rocks at random; a rock stops the mower,
' counts a repair and needs a restart; the restart by cord pulls, each one
' catching with a chance of 1 in 6; the garage door with the button to end
' the job; "LOOKING OVER YOUR WORK", "YOU HAVE NOT FINISHED THE JOB!" and a
' restart when patches are left; the clock that runs from the start; the
' pay = earnings - time (minutes count as dollars and seconds as cents, as
' the listing's VAL(TI$)/100 did) - 50 cents a repair; "GREAT JOB, YOU
' EARNED $..", the highest earning, and "YOUR EXPENSES OUTWEIGHED YOUR
' EARNING! FIND ANOTHER WAY TO EARN MONEY!".
'
' Liberties: the yard is redrawn for 28 columns (a tree and a bird bath
' added as obstacles; 335 patches instead of the C64's 431). Rocks never
' touch a wall, a fence or another rock (the listing kept them apart only
' sideways and diagonally), so no patch can be shut in. The mower glides a
' cell in 8 frames (about 7 cells a second) instead of jumping. When the
' job is not finished, the message also says how many patches are left.
' The end screen shows the bill line by line. A cord pull rewinds for a
' sixth of a second before the next one counts.
'
' Controls: either controller. The stick drives the mower one cell at a
' time (hold to keep going). A button pulls the cord; at the garage door,
' hold the stick toward the door and press a button. On the title, up and
' down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes.

const TGrass = 128
const TCuth = 129
const TCutv = 130
const TWalk = 131
const TRock = 132
const TGdoor = 133
const TGtop = 134
const TStreet = 135
const TStline = 136
const TCurb = 137
const TFencev = 138
const TFencevr = 139
const TFenceh = 140
const THedge = 141
const TRooft = 142
const TRoofe = 143
const TWall = 144
const TWin = 145
const TDoor = 146
const TGwall = 147
const TFlower = 148
const TTree00 = 149
const TTree01 = 150
const TTree10 = 151
const TTree11 = 152
const TBath00 = 153
const TBath01 = 154
const TBath10 = 155
const TBath11 = 156
const SDetu0 = 0
const SDetr0 = 4
const SDetd0 = 8
const SDetl0 = 12
const SDetu1 = 16
const SDetr1 = 20
const SDetd1 = 24
const SDetl1 = 28
const SBodyu = 32
const SBodyr = 36
const SBodyd = 40
const SBodyl = 44
const SPuff0 = 48
const SPuff1 = 52
const NTiles8 = 232
const SprBytes = 448
const GrassN = 335
const SndTuneA = 1
const SndTuneB = 2
const SndPutt = 3
const SndPull = 4
const SndStart = 5
const SndCrash = 6
const SndCut = 7
const SndLook = 8
const SndDone = 9
const SndBroke = 10
const HopN = 8
const NSpr = 4
const StartC = 15
const StartR = 21
const MsgRow = 22
' cell kinds (CellKind)
const KBlock = 0
const KGrass = 1
const KCut = 2
const KRock = 3
const KDoor = 4

record Mower:
  u8 Cx
  u8 Cy
  u8 Px
  u8 Py
  u8 Dir
  u8 Ph
end record

Mower Mw

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
' the job: cents earned (also in BCD for the display), tall patches left,
' repairs, the clock
u16 EarnC = 0
bcd digits 4 Earn = 0
u8 EarnTx[4]
u16 Left = 0
u8 RN = 0
u8 Fr = 0
u8 Sec = 0
u8 Min = 0
i16 Final = 0
i16 Hi = 0
' rocks
u8 NR = 0
u8 RkC[20]
u8 RkR[20]
' state: engine (0 off, 1 running), lock frames, a pending look at the
' work, cut on arrival, stalled by a rock, the game over
u8 Eng = 0
u8 Lock = 0
u8 Chk = 0
u8 Cutting = 0
u8 Stall = 0
u8 Over = 0
u8 Wt = 0
u8 TitleOn = 0
u8 TitleDx = 1
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ki = 0
u8 Tries = 0
' scratch
u8 J = 0
u8 K = 0
u8 R = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Qc = 0
u8 Qr = 0

  tile screen
  set sound table LjSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  EndPage
  Wt = 4
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  TickClock
  if Lock > 0 then
    dec Lock
    if Lock = 0 then
      if Chk = 1 then Verdict
    end if
    return
  end if
  if Eng = 0 then
    if Press = 1 then PullCord
    return
  end if
  if Mw.Ph > 0 then
    Glide
    return
  end if
  TryMove
  return
end sub

' the clock: minutes and seconds since the start, to 99:59
sub TickClock:
  inc Fr
  if Fr < 60 then return
  Fr = 0
  inc Sec
  if Sec >= 60 then
    Sec = 0
    if Min < 99 then inc Min
  end if
  ShowTime
  return
end sub

' one pixel of the step under way; on arrival the patch is cut
sub Glide:
  select case Mw.Dir
  case 0
    dec Mw.Py
  case 1
    inc Mw.Px
  case 2
    inc Mw.Py
  case else
    dec Mw.Px
  end select
  dec Mw.Ph
  if Mw.Ph > 0 then return
  T = get char at Mw.Cx,Mw.Cy
  Cutting = 0
  if T = TWalk then return
  if T < TGrass then return
  if T > TCutv then return
  ' the stripes follow the way the mower went
  V = Mw.Dir & 1
  if V = 1 then
    put char TCuth at Mw.Cx,Mw.Cy
  else
    put char TCutv at Mw.Cx,Mw.Cy
  end if
  return
end sub

' the stick: one of the four directions only (the original ignored
' diagonals); what lies there decides
sub TryMove:
  u8 Dn = 0
  K = J1 | J2
  K = K & 15
  select case K
  case 1
    Dn = 0
  case 2
    Dn = 2
  case 4
    Dn = 3
  case 8
    Dn = 1
  case else
    return
  end select
  Qc = Mw.Cx
  Qr = Mw.Cy
  if Dn = 0 then dec Qr
  if Dn = 1 then inc Qc
  if Dn = 2 then inc Qr
  if Dn = 3 then dec Qc
  T = KindAt(Qc, Qr)
  select case T
  case KGrass
    Cutting = 1
    EarnC = EarnC + 5
    Earn += 5
    dec Left
    ShowEarn
    play sound SndCut
    StartStep(Dn)
  case KCut
    StartStep(Dn)
  case KRock
    Mw.Dir = Dn
    Crash
  case KDoor
    if Btn > 0 then
      Mw.Dir = Dn
      Look
    end if
  end select
  return
end sub

sub StartStep(u8 D):
  Mw.Dir = D
  Mw.Cx = Qc
  Mw.Cy = Qr
  Mw.Ph = HopN
  if Cutting = 0 then play sound SndPutt
  return
end sub

' what a cell is: tall grass, drivable (cut grass, the walks), a rock, the
' garage door, or a block
function KindAt(u8 Cc, u8 Cr) as u8
  u8 Tc = 0
  u8 Kd = KBlock
  Tc = get char at Cc,Cr
  select case Tc
  case TGrass
    Kd = KGrass
  case TCuth to TWalk
    Kd = KCut
  case TRock
    Kd = KRock
  case TGdoor
    Kd = KDoor
  end select
  return Kd

sub Crash:
  Eng = 0
  Stall = 1
  inc RN
  ShowHits
  play sound SndCrash
  Say(1)
  Lock = 30
  return
end sub

' a pull of the cord: the engine catches one time in six
sub PullCord:
  if Catches() = 1 then
    Eng = 1
    Stall = 0
    play sound SndStart
    ClearMsg
  else
    play sound SndPull
  end if
  Lock = 10
  return
end sub

function Catches as u8
  u16 Q = 0
  Rand
  Q = Rs % 6
  if Q = 0 then return 1
  return 0

' at the garage door with the button: the work is looked over
sub Look:
  Say(2)
  play sound SndLook
  Chk = 1
  Lock = 90
  return
end sub

sub Verdict:
  Chk = 0
  if Left = 0 then
    Over = 1
    return
  end if
  ' not finished: the engine stops and must be pulled again
  Say(3)
  NumU = Left
  print at 17,MsgRow, digits$(NumU, 3)
  Eng = 0
  Lock = 60
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' messages on the street row

sub Say(u8 M):
  ClearMsg
  select case M
  case 0
    print at 3,MsgRow, "PULL THE CORD: PRESS BUTTON"
  case 1
    print at 3,MsgRow, "A ROCK! PULL THE CORD AGAIN"
  case 2
    print at 4,MsgRow, "LOOKING OVER YOUR WORK..."
  case 3
    print at 3,MsgRow, "NOT FINISHED!"
    print at 21,MsgRow, "TO MOW"
  end select
  return
end sub

sub ClearMsg:
  copy YardMap + 640 count 32 to vram.name + 704
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  u8 Pat = 0
  Y = Mw.Py - 1
  X = Mw.Px
  Pat = Mw.Dir << 2
  if Eng = 1 then
    V = Tick >> 4
    V = V & 1
    if V = 1 then Pat = Pat + 16
  end if
  set sprite 0 to Y,X,Pat,1
  Pat = Mw.Dir << 2
  Pat = Pat + SBodyu
  set sprite 1 to Y,X,Pat,8
  if Stall = 1 then
    Y = Y - 10
    V = Tick >> 5
    V = V & 1
    Pat = SPuff0
    if V = 1 then Pat = SPuff1
    set sprite 2 to Y,X,Pat,14
  else
    set sprite 2 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "$"
  print at 11,1, "TIME"
  print at 22,1, "HITS"
  ShowEarn
  ShowTime
  ShowHits
  return
end sub

sub ShowEarn:
  format Earn into EarnTx
  put char EarnTx[0] at 3,1
  put char EarnTx[1] at 4,1
  put char 46 at 5,1
  put char EarnTx[2] at 6,1
  put char EarnTx[3] at 7,1
  return
end sub

sub ShowTime:
  NumU = Min
  print at 16,1, digits$(NumU, 2)
  put char 58 at 18,1
  NumU = Sec
  print at 19,1, digits$(NumU, 2)
  return
end sub

sub ShowHits:
  NumU = RN
  print at 27,1, digits$(NumU, 2)
  return
end sub

' an amount of money as $DD.CC, a minus sign before it when below zero
sub PutMoney(i16 Amt, u8 Col, u8 Row):
  u16 Mag = 0
  u8 Cc = 0
  Cc = Col
  if Amt < 0 then
    put char 45 at Cc,Row
    Mag = 0 - Amt
  else
    put char 32 at Cc,Row
    Mag = Amt
  end if
  inc Cc
  put char 36 at Cc,Row
  inc Cc
  NumU = Mag / 100
  print at Cc,Row, digits$(NumU, 2)
  Cc = Cc + 2
  put char 46 at Cc,Row
  inc Cc
  NumU = Mag % 100
  print at Cc,Row, digits$(NumU, 2)
  return
end sub

' the yard from the map (rows 2-23), then the rocks
sub DrawYard:
  for Ri = 2 to 23
    W16 = Ri - 2
    W16 = W16 << 5
    A16 = Ri
    A16 = A16 << 5
    copy YardMap + W16 count 32 to vram.name + A16
  next
  return
end sub

' 10 to 19 rocks on tall grass, each with tall grass all round it
sub PlaceRocks:
  Rand
  NR = Rs % 10
  NR = NR + 10
  for Ki = 1 to NR
    Tries = 0
    do
      Rand
      Qc = Rs % 26
      Qc = Qc + 3
      Rand
      Qr = Rs % 17
      Qr = Qr + 3
      inc Tries
    loop until RoomFor(Qc, Qr) = 1 or Tries > 200
    J = Ki - 1
    if Tries <= 200 then
      put char TRock at Qc,Qr
      RkC[J] = Qc
      RkR[J] = Qr
    else
      RkC[J] = 0
    end if
  next
  ' count what is left to mow
  Left = GrassN - NR
  return
end sub

' 1 when the 3 x 3 cells round Rc, Rr are all tall grass
function RoomFor(u8 Rc, u8 Rr) as u8
  u8 Dc = 0
  u8 Dr = 0
  u8 Ok = 1
  for Dr = 0 to 2
    for Dc = 0 to 2
      if KindAt(Rc + Dc - 1, Rr + Dr - 1) <> KGrass then Ok = 0
    next
  next
  return Ok

sub NewGame:
  NewScreen
  DrawYard
  PlaceRocks
  EarnC = 0
  Earn = 0
  RN = 0
  Fr = 0
  Sec = 0
  Min = 0
  ShowHud
  Mw.Cx = StartC
  Mw.Cy = StartR
  Mw.Dir = 0
  Mw.Ph = 0
  Mw.Px = StartC * 8 - 4
  Mw.Py = StartR * 8 - 4
  Eng = 0
  Lock = 0
  Chk = 0
  Stall = 0
  Cutting = 0
  Over = 0
  TitleOn = 0
  Say(0)
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Wt = 3
  return
end sub

' the end: the bill, the pay and the highest earning
sub EndPage:
  i16 Tcost = 0
  i16 Rcost = 0
  mute all
  HideSprites
  ClearMsg
  Tcost = Min * 100 + Sec
  Rcost = RN * 50
  Final = EarnC - Tcost - Rcost
  if Final > Hi then Hi = Final
  for Ri = 7 to 17
    fill 32 count 26 at 3,Ri
  next
  print at 6,8, "EARNED"
  PutMoney(EarnC, 16, 8)
  print at 6,9, "TIME"
  PutMoney(0 - Tcost, 16, 9)
  print at 6,10, "REPAIRS"
  PutMoney(0 - Rcost, 16, 10)
  print at 6,11, "PAY"
  PutMoney(Final, 16, 11)
  if Final < 0 then
    print at 5,13, "YOUR EXPENSES OUTWEIGHED"
    print at 5,14, "YOUR EARNING! FIND"
    print at 3,15, "ANOTHER WAY TO EARN MONEY!"
    play sound SndBroke
  else
    print at 5,13, "GREAT JOB, YOU EARNED"
    PutMoney(Final, 9, 14)
    print at 5,16, "HIGHEST EARNING"
    PutMoney(Hi, 20, 16)
    play sound SndDone
  end if
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the yard, the mower going along the sidewalk, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawYard
  for Ri = 9 to 17
    fill 32 count 24 at 4,Ri
  next
  print at 12,10, "LAWN JOB"
  print at 7,12, "BY MIKE BUHIDAR JR."
  print at 12,14, "START GAME"
  print at 12,15, "CREDITS"
  print at 2,1, "HIGHEST EARNING"
  PutMoney(Hi, 18, 1)
  print at 9,22, "AHOY! JUL-DEC 1984"
  ShowMenu
  TitleOn = 1
  Eng = 1
  Stall = 0
  Mw.Dir = 1
  Mw.Px = 20
  Mw.Py = 156
  TitleDx = 1
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Wt = 2
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the mower drives along the sidewalk and back
  if TitleDx = 1 then
    inc Mw.Px
    if Mw.Px >= 220 then
      TitleDx = 0
      Mw.Dir = 3
    end if
  else
    dec Mw.Px
    if Mw.Px <= 20 then
      TitleDx = 1
      Mw.Dir = 1
    end if
  end if
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,14
  put char 32 at 10,15
  J = Menu + 14
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "LAWN JOB"
  print at 2,5, "BASED ON LAWN JOB BY"
  print at 2,6, "MIKE BUHIDAR JR., AHOY! 1984"
  print at 2,7, "(COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: SATURDAY MORNING"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Wt = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $44,$AA,$92,$24,$49,$AA,$52,$14
  $00,$00,$00,$00,$00,$00,$00,$00
  $11,$11,$11,$11,$11,$11,$11,$11
  $01,$01,$01,$01,$01,$01,$01,$00
  $44,$C3,$60,$40,$03,$07,$81,$24
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$04,$00,$40,$00,$01,$00,$00
  $00,$00,$00,$07,$07,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $70,$70,$81,$70,$70,$70,$81,$70
  $0E,$0E,$81,$0E,$0E,$0E,$81,$0E
  $22,$88,$00,$88,$88,$00,$88,$00
  $89,$22,$44,$91,$12,$40,$08,$A4
  $00,$00,$11,$11,$00,$44,$44,$00
  $11,$11,$00,$44,$44,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$91,$91,$00,$91,$91,$00
  $00,$81,$81,$00,$81,$83,$81,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $42,$18,$42,$24,$88,$00,$00,$00
  $07,$E0,$C0,$80,$80,$10,$00,$30
  $E0,$07,$23,$61,$09,$00,$80,$04
  $00,$00,$88,$81,$C0,$E1,$07,$00
  $10,$30,$81,$81,$03,$07,$E0,$00
  $00,$C0,$80,$E0,$C0,$C0,$C0,$C0
  $00,$03,$01,$07,$03,$03,$03,$03
  $C0,$C0,$C0,$E0,$80,$C0,$00,$00
  $03,$03,$03,$07,$01,$03,$00,$00
end data
data TileCol bytes
  $2C,$C2,$2C,$2C,$2C,$2C,$2C,$2C
  $03,$03,$03,$02,$03,$03,$03,$02
