' a step of the walk: block offset and map index of the target block
record Way:
  i8 Dx
  i8 Dy
  u8 Target
end record
data WaysRom records Way
  0,-1,22
  0,1,40
  -1,0,30
  1,0,32
end data

Way Ways[4]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 DX = 0
u16 DY = 0
u16 Purse = 0
u16 ArD = 0
u16 DfAddr = 0
u16 RBase = 6144
