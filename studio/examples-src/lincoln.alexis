u8 FX = 0
u8 FY = 0
u8 Nicks = 0
u8 Over = 0
' the walk: Mv 1 while scrolling, the way (0 up 1 down 2 left 3 right),
' frames to the next scroll step, steps left, the view's cell offsets
u8 Mv = 0
u8 MvW = 0
u8 MvT = 0
u8 MvN = 0
u8 ScX = 4
u8 ScY = 4
i8 Wdx = 0
i8 Wdy = 0
