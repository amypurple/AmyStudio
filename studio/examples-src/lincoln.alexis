' arrows: volley kind (8 = choose a new one), visible mask, speed, pause
u8 ArSt = 8
u8 ArMask = 0
u8 ArSpd = 1
u8 Pause = 0
u8 HurtT = 0
u8 Walk = 0
u8 Hits = 0
u8 Moves = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
' the HOW TO PLAY pages (globals: subs here share the IX frame with call asm)
u8 Pg = 0
u16 HtWt = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Rr = 0
u8 Bk = 0
u8 Ai = 0
u8 Mr = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 T0 = 0
u8 Bi = 0
u8 Mi = 0
u8 Sb = 0
u8 Wy = 0
' rendering: view, rows, which name table is shown (0 $1800, 1 $1C00)
u8 RX = 4
u8 RY = 4
u8 RFrom = 0
u8 RTo = 19
u8 Front = 0

  copy WaysRom to Ways
  tile screen
  set sound table LgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message (in table 0), then back to the title on a press
  if Front = 1 then
    Front = 0
    DrawField
    call asm LgShowBack
  end if
  ' the outlaw stays in sight above the message
  set sprite 0 to PCY - 41,PCX - 8,SSkin,9
  V = 12
  if Over = 3 then V = 6
  set sprite 1 to PCY - 41,PCX - 8,SHero0,V
  for J = 2 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  print at 4,9, "                        "
  select case Over
    case 1
      print at 4,10, " YOU REACHED SANCTUARY! "
      play sound SndWin
    case 2
      print at 4,10, "  YOUR PURSE IS EMPTY   "
      play sound SndOver
    case else
      print at 4,10, "  NINE NICKS: CAUGHT!   "
      play sound SndOver
  end select
  print at 4,11, "                        "
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the walk (or a push into a tree), then the arrows
sub PlayStep:
  if Mv = 1 then
    WalkStep
  else
    TryWalk
  end if
  Arrows
  if HurtT > 0 then dec HurtT
  return
end sub

' the stick: one straight direction starts a step if that block is clear
sub TryWalk:
  Blocked = 0
  select case J1 & 15
    case 1
      MvW = 0
    case 2
      MvW = 1
    case 4
      MvW = 2
    case 8
      MvW = 3
    case else
      BumpT = 0
      return
  end select
  Mi = Ways[MvW].Target
  if Map[Mi] > 0 then
    Bump
    if Over > 0 then return
    if BumpT < PushT then return
    ' pushed long enough: the outlaw forces his way through the thicket
    Map[Mi] = 0
  end if
  BumpT = 0
  Wdx = Ways[MvW].Dx
  Wdy = Ways[MvW].Dy
  ShiftMap
  Mv = 1
  MvT = 0
  MvN = 4
  inc Moves
  play sound SndStep
  return
end sub

' pushing into a tree: 1 from the purse every other frame
sub Bump:
  Blocked = 1
  inc BumpT
  V = BumpT & 15
  if V = 1 then play sound SndRustle
  V = BumpT & 1
  if V = 1 then
    if Purse > 0 then dec Purse
    ShowPurse
    MirrorHud
    if Purse = 0 then Over = 2
  end if
  return
end sub

' the map moves one block against the walk; a new row or column of blocks
' (a tree 3 times in 8) comes in at the far edge, out of sight
sub ShiftMap:
  select case MvW
    case 0
      for Mr = 6 to 1 step -1
        Mi = Mr * 9
        for Bk = 0 to 8
          Map[Mi] = Map[Mi - 9]
          inc Mi
        next
      next
      for Bk = 0 to 8
        Map[Bk] = NewBlock()
      next
      ScY = 8
    case 1
      copy Map + 9 count 54 to Map
      for Bk = 54 to 62
        Map[Bk] = NewBlock()
      next
      ScY = 0
    case 2
      for Mr = 0 to 6
        Mi = Mr * 9 + 8
        for Bk = 1 to 8
          Map[Mi] = Map[Mi - 1]
          dec Mi
        next
        Map[Mi] = NewBlock()
      next
      ScX = 8
    case 3
      for Mr = 0 to 6
        Mi = Mr * 9
        for Bk = 1 to 8
          Map[Mi] = Map[Mi + 1]
          inc Mi
        next
        Map[Mi] = NewBlock()
      next
      ScX = 0
  end select
  return
end sub

function NewBlock() as u8
  Rand
  K = lowbyte Rs
  K = K & 7
  if K < Trees then return 1
  return 0

' every third frame the view scrolls one cell and the arrows move 8 pixels
' with the forest; after four the step is done and a distance changes
sub WalkStep:
  inc MvT
  if MvT = 1 then
    DrawBack(0)
    return
  end if
  if MvT = 2 then
    DrawBack(1)
    return
  end if
  MvT = 0
  ScX = ScX + Wdx
  ScY = ScY + Wdy
  Front = Front ^ 1
  call asm LgShowBack
  for Ai = 0 to 3
    Ti = Wdx * 8
    AX[Ai] = AX[Ai] - Ti
    Ti = Wdy * 8
    AY[Ai] = AY[Ai] - Ti
  next
  inc Walk
  dec MvN
  if MvN > 0 then return
  Mv = 0
  Distances
  ShowDist
  MirrorHud
  if DX = 0 then
    if DY = 0 then Over = 1
  end if
  return
end sub

' the C64's rule: towards the sanctuary takes 10, away adds 10; below 0
' stays 0 and flips that axis's direction
sub Distances:
  select case MvW
    case 0
      if FY = 1 then
        DY = Closer(DY)
      else
        DY = Farther(DY)
      end if
    case 1
      if FY = 1 then
        DY = Farther(DY)
      else
        DY = Closer(DY)
      end if
    case 2
      if FX = 1 then
        DX = Farther(DX)
      else
        DX = Closer(DX)
      end if
    case 3
      if FX = 1 then
        DX = Closer(DX)
      else
        DX = Farther(DX)
      end if
  end select
  return
end sub

function Closer(u16 D) as u16
  if D < 10 then
    if MvW < 2 then
      FY = FY ^ 1
    else
      FX = FX ^ 1
    end if
    return 0
  end if
  return D - 10

function Farther(u16 D) as u16
  if D >= DistMax then return DistMax
  return D + 10

' ---------------------------------------------------------------------------
' the arrows: a new volley, its flight, hits
sub Arrows:
  ' speed and the real arrows from how near the sanctuary is
  V = highbyte DX
  K = highbyte DY
  V = V + K
  if V > 10 then V = 10
  ArSpd = 1
  if V < 4 then ArSpd = 2
  if Pause > 0 then
    dec Pause
    if Pause = 0 then ArSt = 8
    ArMask = 0
    return
  end if
  if ArSt = 8 then NewVolley
  K = ArSt & 3
  K = K + V
  ArMask = MaskT[K] >> 1
  for Ai = 0 to 3
    MoveArrow(Ai)
  next
  ArD = ArD + ArSpd
  if ArD >= VolleyLen then ArSt = 8
  for Ai = 0 to 3
    V = ArMask >> Ai
    V = V & 1
    if V = 1 then
      if HitTest(Ai) = 1 then
        Nick
        return
      end if
    end if
  next
  return
end sub

sub NewVolley:
  Rand
  ArSt = lowbyte Rs
  ArSt = ArSt & 7
  K = 0
  if ArSt >= 4 then K = 4
  for Ai = 0 to 3
    J = K + Ai
    AX[Ai] = StX[J]
    AY[Ai] = StY[J]
  next
  ArD = 0
  play sound SndWhoosh
  return
end sub

sub MoveArrow(u8 N)
  J = N
  if ArSt >= 4 then J = J + 4
  V = VxT[J]
  select case V
    case 0
      AX[N] = AX[N] - ArSpd
    case 2
      AX[N] = AX[N] + ArSpd
  end select
  V = VyT[J]
  select case V
    case 0
      AY[N] = AY[N] - ArSpd
    case 2
      AY[N] = AY[N] + ArSpd
  end select
  return
end sub

function InBand(u8 N) as u8
  if AX[N] < BandL then return 0
  if AX[N] > BandR then return 0
  if AY[N] < BandT then return 0
  if AY[N] > BandB then return 0
  return 1

function HitTest(u8 N) as u8
  if InBand(N) = 0 then return 0
  Ti = AX[N] - PCX
  if abs(Ti) > 5 then return 0
  Ti = AY[N] - PCY
  if abs(Ti) > 6 then return 0
  return 1

sub Nick:
  inc Nicks
  inc Hits
  play sound SndNick
  Pause = 45
  HurtT = 45
  ArMask = 0
  ShowNicks
  MirrorHud
  if Nicks >= 9 then Over = 3
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: the forest, 20 rows of 28 cells from the block map and the view
' offsets, one row at a time through RowBuf
sub DrawField:
  RX = ScX
  RY = ScY
  RFrom = 0
  RTo = 19
  RBase = 6144
  if Front = 1 then RBase = 7168
  call asm LgDrawField
  return
end sub

' half of the next view into the hidden name table (Part 0 rows 0-9,
' 1 rows 10-19)
sub DrawBack(u8 Part)
  RX = ScX + Wdx
  RY = ScY + Wdy
  RFrom = Part * 10
  RTo = RFrom + 9
  RBase = 7168
  if Front = 1 then RBase = 6144
  call asm LgDrawField
  return
end sub

' the HUD rows 21-22 printed in table 0, copied to table 1
sub MirrorHud:
  copy vram.name + 672 count 32 to vram $1EA0
  copy vram.name + 704 count 32 to vram $1EC0
  return
end sub

' sprites: 0 the outlaw's face and hands, 1 his body, 2-5 the arrows
sub DrawSprites:
  K = Walk & 1
  K = K * 4 + SHero0
  V = 12
  if HurtT > 0 then V = 6
  set sprite 0 to PCY - 9,PCX - 8,SSkin,9
  set sprite 1 to PCY - 9,PCX - 8,K,V
  K = SArE
  if ArSt >= 4 then K = SArW
  if ArSt = 8 then ArMask = 0
  for Ai = 0 to 3
    J = Ai + 2
    V = ArMask >> Ai
    V = V & 1
    if V = 1 then
      if InBand(Ai) = 1 then
        X = AX[Ai] - 8
        Y = AY[Ai] - 9
        set sprite J to Y,X,K,15
      else
        set sprite J to 192,0,0,0
      end if
    else
      set sprite J to 192,0,0,0
    end if
    K = K + 4
  next
  update sprites
  return
end sub

sub ShowNicks:
  NumU = Nicks
  print at 8,21, digits$(NumU, 1)
  return
end sub

sub ShowPurse:
  print at 23,21, digits$(Purse, 3)
  return
end sub

sub ShowDist:
  print at 6,22, digits$(DX, 4)
  print at 24,22, digits$(DY, 4)
  return
end sub

sub NewGame:
  NewScreen
  backdrop black
  ' the C64 started in an open glade: the blocks in view are clear, the
  ' hidden edge blocks already chosen
  for Bk = 0 to 62
    Map[Bk] = NewBlock()
  next
  for Mr = 1 to 5
    Mi = Mr * 9 + 1
    for Bk = 1 to 7
      Map[Mi] = 0
      inc Mi
    next
  next
  ScX = 4
  ScY = 4
  Front = 0
  call asm LgClear2
  DrawField
  print at 2,21, "NICKS"
  print at 15,21, "PURSE"
  put char TPound at 22,21
  print at 2,22, "E-W"
  print at 20,22, "N-S"
  DX = StartDist
  DY = StartDist
  Rand
  FX = lowbyte Rs
  FX = FX & 1
  Rand
  FY = lowbyte Rs
  FY = FY & 1
  Purse = 600
  Nicks = 0
  Over = 0
  Mv = 0
  MvT = 0
  MvN = 0
  Walk = 0
  Hits = 0
  Moves = 0
  BumpT = 0
  Blocked = 0
  HurtT = 0
  Pause = 60
  ArSt = 8
  ArMask = 0
  ShowNicks
  ShowPurse
  ShowDist
  MirrorHud
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  Front = 0
  call asm LgShowBack
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: LINCOLN GREEN in leafy letters, a row of oaks, START /
' CREDITS, the tune once
sub TitlePage:
  NewScreen
  print at 5,1, "COMPUTE!'S GAZETTE 1988"
  DrawLogo(0)
  DrawLogo(1)
  for Bk = 0 to 6
    X = Bk * 4 + 2
    for Mr = 0 to 3
      Y = Mr + 11
      K = Mr * 4 + TTree00
      put char K at X,Y
      put char K + 1 at X + 1,Y
      put char K + 2 at X + 2,Y
      put char K + 3 at X + 3,Y
    next
  next
  print at 8,16, "BY ROBERT BIXBY"
  print at 13,18, "START"
  print at 13,19, "HOW TO PLAY"
  print at 13,20, "CREDITS"
  print at 3,21, "FIND SANCTUARY. DODGE THE"
  print at 2,22, "ARROWS. PUSH TO PASS TREES."
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 552
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

' one word of the logo: 3 rows of leaf tiles
sub DrawLogo(u8 Wd)
  for Mr = 0 to 2
    for Bk = 0 to 16
      if Wd = 0 then
        J = Mr * LogoLW + Bk
        K = LogoLINCOLN[J]
        X = LogoLCol + Bk
        Y = Mr + 3
      else
        K = 0
        X = LogoGCol + Bk
        Y = Mr + 7
        if Bk < LogoGW then
          J = Mr * LogoGW + Bk
          K = LogoGREEN[J]
        end if
      end if
      if Bk < LogoGW then
        put char TLeaf0 + K at X,Y
      else
        if Wd = 0 then put char TLeaf0 + K at X,Y
      end if
    next
  next
  return
end sub

sub ShowMenu:
  put char 32 at 11,18
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 18
  put char 62 at 11,J
  return
end sub

' a 4 x 4 block for the HOW TO PLAY picture: K = TTree00 or TGlade00 at
' X, Y
sub HtBlock:
  for Mr = 0 to 3
    J = Mr * 4 + K
    V = Y + Mr
    put char J at X,V
    put char J + 1 at X + 1,V
    put char J + 2 at X + 2,V
    put char J + 3 at X + 3,V
  next
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "YOU ARE AN OUTLAW LOST IN"
    print at 2,4, "THE FOREST, WITH ARCHERS"
    print at 2,5, "AFTER YOU. FIND THE SAFE"
    print at 2,6, "PLACE: THE SANCTUARY!"
    print at 2,8, "PUSH THE JOYSTICK UP, DOWN,"
    print at 2,9, "LEFT OR RIGHT TO WALK."
    print at 2,11, "WALKING INTO A TREE COSTS"
    print at 2,12, "MONEY. KEEP PUSHING AND YOU"
    print at 2,13, "GET THROUGH IT."
    for Bk = 0 to 5
      X = Bk * 4 + 4
      K = TGlade00
      if Bk = 1 then K = TTree00
      if Bk = 4 then K = TTree00
      Y = 14
      HtBlock
      K = TGlade00
      if Bk = 3 then K = TTree00
      Y = 18
      HtBlock
    next
    set sprite 0 to 119,104,SSkin,9
    set sprite 1 to 119,104,SHero0,12
    set sprite 2 to 123,168,SArW,15
  else
    print at 2,1, "THE NUMBERS            2/2"
    print at 2,3, "E-W AND N-S AT THE BOTTOM"
    print at 2,4, "SAY HOW FAR THE SANCTUARY"
    print at 2,5, "IS, BUT NOT WHICH WAY. WALK"
    print at 2,6, "AND WATCH THEM: GET BOTH"
    print at 2,7, "TO 0 AND YOU ARE SAFE!"
    print at 2,9, "ARROWS FLY AT YOU. EACH HIT"
    print at 2,10, "IS A NICK. 9 NICKS AND YOU"
    print at 2,11, "ARE CAUGHT. AN EMPTY PURSE"
    print at 2,12, "ENDS THE GAME TOO."
    print at 2,14, "TIP: IF A NUMBER GOES UP,"
    print at 2,15, "TURN AROUND AND WALK THE"
    print at 2,16, "OTHER WAY."
    print at 2,18, "NICKS 0        PURSE"
    put char TPound at 22,18
    print at 23,18, "600"
    print at 2,19, "E-W 1100          N-S 1100"
    set sprite 2 to 159,40,SArE,15
    set sprite 3 to 159,200,SArW,15
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  HtWt = HtWt + 1
  if HtWt >= 1800 then goto ht_out
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_out:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F0
  backdrop dark green
  print at 9,2, "LINCOLN GREEN"
  print at 2,5, "BASED ON LINCOLN GREEN BY"
  print at 2,6, "ROBERT BIXBY, COMPUTE!'S"
  print at 2,7, "GAZETTE SEPTEMBER 1988"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: GREENWOOD AIR"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; LgDrawField: the 20 field rows (screen rows 1-20, columns 2-29) from Map,
; the view RX, RY (cell offsets), rows RFrom..RTo, into the name table
; at RBase, written straight to the VDP (NMI off): per row, the tiles
; of the first block from phase ScX & 3, six whole blocks, then the last
; block's first ScX & 3 tiles; at least 31 cycles between VDP writes.
; A block's tiles are TTree00 or TGlade00 + 4 x (row in block) + column.
; Uses AF BC DE HL.
LgDrawField:
    ld a,(AMY_UVAR_RFrom)
    ld (AMY_UVAR_Rr),a
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(AMY_UVAR_RBase)
    add hl,de
    ld de,34
    add hl,de
    ld (AMY_UVAR_DfAddr),hl
LgDfRow:
    ld hl,(AMY_UVAR_DfAddr)
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld de,32
    add hl,de
    ld (AMY_UVAR_DfAddr),hl
    ld a,(AMY_UVAR_RY)
    ld b,a
    ld a,(AMY_UVAR_Rr)
    add a,b
    ld b,a
    and 3
    add a,a
    add a,a
    add a,AMY_UCONST_TGlade00
    ld c,a
    ld a,b
    srl a
    srl a
    ld b,a
    add a,a
    add a,a
    add a,a
    add a,b
    ld b,a
    ld a,(AMY_UVAR_RX)
    ld d,a
    srl a
    srl a
    add a,b
    ld e,a
    ld a,d
    and 3
    ld d,a
    push de
    ld d,0
    ld hl,AMY_UVAR_Map
    add hl,de
    pop de
    ; first block: tiles d..3
    call LgBase
    add a,d
    ld e,a
    ld a,4
    sub d
    ld b,a
    ld a,e
LgDfFirst:
    out ($BE),a
    inc a
    dec b
    jr nz,LgDfFirst
    ld b,6
LgDfMid:
    call LgBase
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    out ($BE),a
    inc a
    nop
    nop
    nop
    nop
    djnz LgDfMid
    ld a,d
    or a
    jr z,LgDfNext
    ld b,d
    call LgBase
LgDfLast:
    out ($BE),a
    inc a
    dec b
    jr nz,LgDfLast
LgDfNext:
    ld a,(AMY_UVAR_Rr)
    inc a
    ld (AMY_UVAR_Rr),a
    ld b,a
    ld a,(AMY_UVAR_RTo)
    cp b
    jp nc,LgDfRow
    ret
; LgShowBack: the VDP shows name table 1 ($1C00) when Front is 1, else 0
; ($1800) (register 2 = 7 or 6)
LgShowBack:
    ld a,(AMY_UVAR_Front)
    add a,6
    out ($BF),a
    ld a,$82
    out ($BF),a
    ret
; LgClear2: name table 1 blank (NMI off)
LgClear2:
    ld a,$00
    out ($BF),a
    ld a,$5C
    out ($BF),a
    ld bc,768
LgCl2:
    ld a,32
    out ($BE),a
    dec bc
    ld a,b
    or c
    jr nz,LgCl2
    ret
; a = the first tile of block (hl), hl moves on (c = TGlade00 + row x 4)
LgBase:
    ld a,(hl)
    inc hl
    or a
    ld a,c
    ret z
    sub AMY_UCONST_TGlade00 - AMY_UCONST_TTree00
    ret
LgWhoosh:
    db $00,$00,$35,$02,$00,$00,$46,$02,$00,$00,$45,$02,$00,$00,$56,$02,$00,$00,$55,$02,$00,$00,$66,$02
    db $00,$00,$65,$02,$00,$00,$76,$02,$00,$00,$75,$02,$00,$00,$86,$02,$10
LgNick:
    db $40,$53,$11,$03,$40,$AB,$21,$03,$40,$3B,$22,$04,$40,$F9,$42,$06,$50
LgRustle:
    db $00,$00,$44,$02,$00,$00,$65,$03,$10
LgStep:
    db $40,$F9,$53,$01,$40,$FF,$73,$01,$50
LgStart:
    db $40,$1D,$21,$06,$40,$E2,$20,$06,$40,$BF,$20,$06,$40,$8F,$20,$0E,$50
LgWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$8F,$20,$08,$40,$6B,$20,$18
    db $50
LgOver:
    db $40,$1D,$11,$0A,$40,$2E,$21,$0A,$40,$53,$21,$0A,$40,$7C,$21,$0A,$40,$FC,$31,$1E,$50

LgSoundTable:
    dw LgTuneMel,$702B
    dw LgTuneBass,$7035
    dw LgWhoosh,$703F
    dw LgNick,$7049
    dw LgRustle,$703F
    dw LgStep,$7049
    dw LgStart,$7049
    dw LgWin,$7049
    dw LgOver,$7049
; Greenwood Air (original)
; Tiny Sound, 8 frames per step
LgTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$23,$01,$26,$01,$28,$01,$2A,$01,$01,$01,$28,$01
    db $26,$01,$23,$01,$21,$01,$23,$01,$01,$01,$26,$01,$28,$01,$2A,$01
    db $2D,$01,$01,$01,$2A,$01,$28,$01,$26,$01,$28,$01,$2A,$01,$01,$01
    db $2D,$01,$2A,$01,$28,$01,$26,$01,$01,$01,$23,$01,$26,$01,$28,$01
    db $21,$01,$23,$01,$01,$01,$00,$01
    db $FF
LgTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$0B,$01,$12,$01,$0B,$01,$12,$01,$09,$01,$10,$01
    db $0B,$01,$12,$01,$0B,$01,$12,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$15,$01,$09,$01,$10,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$10,$01,$17,$01,$09,$01,$10,$01
    db $0B,$01,$12,$01,$00,$01,$01,$01
    db $FF
}
