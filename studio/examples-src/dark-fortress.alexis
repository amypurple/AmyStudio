cartridge "DARK FORTRESS/CLEVE BLAKEMORE/1987"

' DARK FORTRESS
' A ColecoVision game based on "Dark Fortress" by Cleve Blakemore (C. M.
' Blakemore), Ahoy! January 1987 (Commodore 128 BASIC 7.0, "a double
' screen game" for two players on the 40 and 80 column monitors). Made for
' Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy
' Bienvenu. The listing and its sequel (Ahoy! February 1988) are in orig/.
'
' Two adventurers race through Shadowthorn Woods, the hedge maze, the Dark
' Fortress and the caverns beneath it for three gems - a diamond, an
' emerald and a pearl - and the first to lay all three in the trophy case
' under the lounge wins. One player may also go alone.
'
' Controls (joystick only): the stick moves the flame over the words, a
' button chooses. In a list the right button says "nothing". With two
' players each uses his own controller and the turns alternate.
'
' From the listing (line numbers of DARK FORTRESS): the map, the objects
' and the monsters (DATA 2070-2750); a turn: life +.2, look, a choice,
' the monsters (240-440); fights: your blow lands when RND < .2 + life/10
' and adds sword 1 + staff 4 + life/5 to the damage done in this room; a
' monster dies when the damage passes its strength (its bit: spider 1 ..
' rabbit 256), the other player's damage counts when he is here; a kill
' gives life and RND(kind x 50) gold; a monster strikes when RND < .2 +
' kind/10 (-.2 with the shield) for kind points; the bagwoman snatches
' all you carry (290-370, 840-880); death sends you to Hades (380); the
' darkness of rooms 6-19 without a lantern (670); take, drop and the win
' (890-1070); incant and the ring (1080-1140); the eight spells (1150-
' 1270); speak, locks, use, drink, trade, read (1280-2060).
'
' The changes for the ColecoVision: one screen, turns handed over with the
' controllers; a picture of each kind of place, the monsters, props and
' the players as sprites; the menu of 18 words with the ways you cannot
' go dimmed; prices shown at the trading post; the bagwoman gives back
' all she took; you cannot buy a thing you already have.
'
' House rules: tiles from code 128 (the scene pictures use the top third
' only); screens drawn with the NMI off; music first in the sound table
' ($702B, $7035) and quieter than the effects; nothing flashes.
'
' Workarounds for Amy bugs 37 (u16-small-literal-compare) removed 2026-11-01.

const SCursor = 0
const SHero = 4
const SGhost = 12
const SEyes = 20
const SMon = 24
const SProp = 168
const SprBytes = 2048
const ScHades = 0
const ScWoods = 1
const ScMaze = 2
const ScChasm = 3
const ScHall = 4
const ScCavern = 5
const ScLounge = 6
const ScTitle = 7
const PFountain = 1
const PTome = 2
const PSlab = 3
const PCoffin = 4
const PRope = 5
const PGrate = 6
const PMirror = 7
const POyster = 8
const PCase = 9
const PMachine = 10
const PBooth = 11
const SndTuneA = 1
const SndTuneB = 2
const SndNightA = 3
const SndNightB = 4
const SndTick = 5
const SndPick = 6
const SndStep = 7
const SndBump = 8
const SndSlash = 9
const SndHit = 10
const SndKill = 11
const SndOuch = 12
const SndTake = 13
const SndDrop = 14
const SndCoin = 15
const SndUnlock = 16
const SndSpell = 17
const SndFizz = 18
const SndBoom = 19
const SndDrink = 20
const SndTalk = 21
const SndTurn = 22
const SndDie = 23
const SndWin = 24
const TitleLen = 576
const TItem = 0
const TMon = 14
const TSpell = 23
const TRoom = 31
const TVerb = 55
const TMisc = 73
const TDesc = 78
u16 TzLeft = 0
u8 TzOn = 0

' the players (index 1 and 2): room, things carried (bits 0-13), spells
' (bits 0-7), gold, life in tenths, damage done in this room in tenths,
' the things the bagwoman holds
u8 Cp[3]
u16 Lp[3]
u8 Sp[3]
u16 Gp[3]
i16 Hp[3]
u16 Tp[3]
u16 Bp[3]
' the player whose turn it is
u8 Np = 1
u8 Z = 1
u8 Oz = 2
u8 Cl = 21
u8 Cl0 = 21
u16 Lb = 0
u8 Sb = 0
u16 Gd = 0
i16 Hh = 0
u16 Th = 0
' the world: exits (room * 6 + way), objects and monsters of each room
u8 Dx[180]
u16 Ob[30]
u16 Mo[30]
u8 Won = 0
u8 Winner = 0
u16 Turns = 0
u16 Rs = 1
u16 Seed = 1
' for the test bot: Idle 1 main menu, 2 a list, 3 hand over, 4 a long text,
' 5 the title
u8 Idle = 0
u8 Busy = 0
' the menu
u8 Sel = 0
u8 MN = 0
u8 MRows = 5
u8 MX0 = 2
u8 MXs = 8
u8 MY0 = 18
u8 MKind = 0
u8 OptT[14]
u8 OptI[14]
u8 MsgY = 16
' the picture
u8 Scene = 255
u8 MonY = 0
u8 PropK = 0
u8 Anim = 0
u8 MonF = 0
u8 HeroF = 0
u8 ShowMon = 0
u8 ShowOth = 0
u8 GhostOn = 0
u8 EyesOn = 0
' input
u8 Pz = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB = 0
u8 P1 = 0
u8 P2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
' scratch
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u16 P = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Px = 0
u8 Rb = 0
u8 Ri = 0
u8 It = 0
u8 Dk = 0
u8 Chc = 0

  ' the font, then three colour thirds of their own (R3 $FF)
  tile screen
  call asm DfR3
  set sound table DfSoundTable areas 6
  sprites 16x16
  nmi off
  decompress zx0 SpritePat to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Np = 0 then goto title

new_game:
  NewGame
  GameScreen
  play sound SndNightA
  play sound SndNightB

turn_loop:
  if Np = 2 then HandOver
  LoadPlayer
  Hh = Hh + 2
  Cl0 = Cl
  DrawRoom
  DrawMenu
  MenuMain
  ClearMsg
  Act(Sel)
  if Won = 1 then goto game_won
  DrawRoom
  MonPhase
  DeathCheck
  if Cl <> Cl0 then Th = 0
  SavePlayer
  inc Turns
  if Np = 2 then
    Oz = Z
    Z = 3 - Z
  end if
  goto turn_loop

game_won:
  Idle = 0
  SavePlayer
  mute all
  play sound SndWin
  EndPage
  goto title

' ---------------------------------------------------------------------------
' the players

sub LoadPlayer:
  Cl = Cp[Z]
  Lb = Lp[Z]
  Sb = Sp[Z]
  Gd = Gp[Z]
  Hh = Hp[Z]
  Th = Tp[Z]
  return
end sub

sub SavePlayer:
  Cp[Z] = Cl
  Lp[Z] = Lb
  Sp[Z] = Sb
  Gp[Z] = Gd
  Hp[Z] = Hh
  Tp[Z] = Th
  return
end sub

' Rnd(n): 0 to n-1 from the high byte of (random byte) x n
function Rnd(u8 Rn) as u8
  call asm DfRnd
  Rb = Rs
  W16 = Rb * Rn
  W16 = W16 >> 8
  Rb = W16
  return Rb

' the highest monster in the room (1 spider .. 9 rabbit), 0 none
function MonIn(u8 Mr) as u8
  W16 = Mo[Mr] & 511
  Ri = 0
  for J = 0 to 8
    A16 = W16 & BitW[J]
    if A16 > 0 then Ri = J + 1
  next
  return Ri

' 1 when the room is too dark to see (line 670)
function IsDark(u8 Dr) as u8
  if Dr < 6 then return 0
  if Dr > 19 then return 0
  A16 = Lb & 128
  if A16 > 0 then return 0
  if Np = 2 then
    if Cp[Oz] = Dr then
      A16 = Lp[Oz] & 128
      if A16 > 0 then return 0
    end if
  end if
  return 1

' the number of things carried
function Carried as u8
  Ri = 0
  for J = 0 to 13
    A16 = Lb & BitW[J]
    if A16 > 0 then inc Ri
  next
  return Ri

function Has(u8 Hi) as u8
  A16 = Lb & BitW[Hi]
  if A16 > 0 then return 1
  return 0

' the other player is here
function OthHere as u8
  if Np = 1 then return 0
  if Cp[Oz] = Cl then return 1
  return 0

' ---------------------------------------------------------------------------
' a turn: the word chosen (0-5 the ways, then the listing's commands 7-18)

sub Act(u8 Av):
  if Av < 6 then
    GoWay(Av)
    return
  end if
  if Av = 6 then DoItems
  if Av = 7 then DoAttack
  if Av = 8 then DoTake
  if Av = 9 then DoDrop
  if Av = 10 then DoIncant
  if Av = 11 then DoCast
  if Av = 12 then DoSpeak
  if Av = 13 then DoLock
  if Av = 14 then DoUse
  if Av = 15 then DoDrink
  if Av = 16 then DoTrade
  if Av = 17 then DoRead
  return
end sub

' line 640
sub GoWay(u8 Gw):
  V = Cl * 6
  V = V + Gw
  W = Dx[V]
  if W = 0 then
    play sound SndBump
    Say(102)
    return
  end if
  Cl = W
  Th = 0
  play sound SndStep
  return
end sub

' line 810
sub DoItems:
  LongBegin
  print at 1,9, "YOU CARRY:"
  Y = 10
  X = 1
  N = 0
  for It = 0 to 13
    if Has(It) = 1 then
      PutStr(0, It, X, Y, 0)
      inc N
      if X = 1 then
        X = 16
      else
        X = 1
        inc Y
      end if
    end if
  next
  if N = 0 then print at 1,10, "NOTHING"
  print at 1,13, "GOLD"
  NumU = Gd
  print NumU at 6,13 width 5
  print at 13,13, "LIFE"
  NumU = 0
  if Hh > 0 then
    W16 = Hh
    NumU = W16 / 10
  end if
  print NumU at 18,13 width 3
  print at 1,14, "SPELLS:"
  Y = 15
  X = 1
  N = 0
  for It = 0 to 7
    V = Sb & BitT[It]
    if V > 0 then
      PutStr(2, It, X, Y, 0)
      inc N
      if X = 1 then
        X = 16
      else
        X = 1
        inc Y
      end if
    end if
  next
  if N = 0 then print at 1,15, "NONE"
  LongEnd
  return
end sub

' line 840
sub DoAttack:
  if MonIn(Cl) = 0 then
    Say(103)
    return
  end if
  A16 = Lb & 7
  if A16 = 0 then
    Say(104)
    return
  end if
  play sound SndSlash
  Say(105)
  V = 20
  if Hh > 0 then
    if Hh > 80 then
      V = 100
    else
      W16 = Hh
      V = W16 + 20
    end if
  end if
  if Rnd(100) < V then
    A16 = Lb & 5
    A16 = A16 * 10
    Th = Th + A16
    if Hh > 0 then
      W16 = Hh
      W16 = W16 / 5
      Th = Th + W16
    end if
    play sound SndHit
    Say(106)
  end if
  return
end sub

' the room's objects as a list (for take)
sub ListRoom:
  MN = 0
  for It = 0 to 13
    A16 = Ob[Cl] & BitW[It]
    if A16 > 0 then
      if MN < 13 then
        OptT[MN] = 0
        OptI[MN] = It
        inc MN
      end if
    end if
  next
  OptT[MN] = 5
  OptI[MN] = 0
  inc MN
  return
end sub

' the things carried as a list (drop, use)
sub ListMine:
  MN = 0
  for It = 0 to 13
    if Has(It) = 1 then
      OptT[MN] = 0
      OptI[MN] = It
      inc MN
    end if
  next
  OptT[MN] = 5
  OptI[MN] = 0
  inc MN
  return
end sub

' line 890
sub DoTake:
  if Ob[Cl] = 0 then
    Say(107)
    return
  end if
  if Carried >= 4 then
    Say(108)
    return
  end if
  ListRoom
  MenuList(1)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  if Has(It) = 1 then
    Say(109)
    return
  end if
  Lb = Lb | BitW[It]
  Ob[Cl] = Ob[Cl] - BitW[It]
  play sound SndTake
  NextLine
  print at 1,MsgY, "TAKEN:"
  PutStr(0, It, 8, MsgY, 0)
  return
end sub

' line 960 and the win (1010)
sub DoDrop:
  if Lb = 0 then
    Say(110)
    return
  end if
  ListMine
  MenuList(2)
  if OptT[Sel] <> 5 then
    It = OptI[Sel]
    A16 = Ob[Cl] & BitW[It]
    if A16 > 0 then
      Say(111)
      return
    end if
    Lb = Lb - BitW[It]
    Ob[Cl] = Ob[Cl] | BitW[It]
    play sound SndDrop
    NextLine
    print at 1,MsgY, "DROPPED:"
    PutStr(0, It, 10, MsgY, 0)
  end if
  if Cl <> 20 then return
  A16 = Mo[20] & 16384
  if A16 > 0 then return
  A16 = Ob[20] & 56
  if A16 <> 56 then return
  Won = 1
  Winner = Z
  return
end sub

' line 1080
sub DoIncant:
  if Cl <> 0 then
    if Cl <> 15 then
      Say(112)
      return
    end if
  end if
  if Cl = 0 then
    if Rnd(20) = 0 then
      play sound SndSpell
      Say(113)
      Cl = 21
      Hh = 100
      return
    end if
  end if
  if Has(12) = 0 then
    play sound SndFizz
    Say(114)
    return
  end if
  Lb = Lb - 4096
  V = Rnd(7)
  V = V + 23
  Ob[V] = Ob[V] | 4096
  if Cl = 15 then
    Hh = Hh + 250
    if Np = 2 then
      if Cp[Oz] = 0 then Cp[Oz] = 15
    end if
  else
    Cl = 15
    Hh = 100
    Dx[4] = 15
  end if
  play sound SndSpell
  Say(115)
  return
end sub

' line 1150
sub DoCast:
  if Sb = 0 then
    Say(116)
    return
  end if
  MN = 0
  for It = 0 to 7
    V = Sb & BitT[It]
    if V > 0 then
      OptT[MN] = 2
      OptI[MN] = It
      inc MN
    end if
  next
  OptT[MN] = 6
  OptI[MN] = 0
  inc MN
  MenuList(3)
  if OptT[Sel] = 6 then return
  It = OptI[Sel]
  Sb = Sb - BitT[It]
  if It = 0 then
    V = Rnd(10)
    if Mo[Cl] <> 0 then
      if V = 9 then
        W16 = Mo[Cl] & 511
        Mo[Cl] = Mo[Cl] - W16
        play sound SndSpell
        Say(117)
        return
      end if
    end if
    play sound SndFizz
    Say(118)
    return
  end if
  if It = 1 then
    Hh = Hh + 100
    play sound SndSpell
    Say(119)
    return
  end if
  if It = 2 then
    Th = Th + 1000
    play sound SndBoom
    Say(120)
    return
  end if
  if It = 3 then
    Th = Th + 5000
    play sound SndBoom
    Say(121)
    return
  end if
  if It = 4 then
    if OthHere = 0 then
      play sound SndFizz
      Say(122)
      return
    end if
    V = 10
    while V = 10 or V = 14 or V = 19
      V = Rnd(22)
      V = V + 1
    end while
    Cp[Oz] = V
    Tp[Oz] = 0
    play sound SndSpell
    Say(123)
    return
  end if
  if It = 5 then
    if Np = 1 then
      play sound SndFizz
      Say(124)
      return
    end if
    play sound SndSpell
    Seer
    return
  end if
  if It = 6 then
    if Cl = 12 then
      Gd = Gd + 1000
      play sound SndCoin
      Say(125)
      return
    end if
    play sound SndFizz
    Say(126)
    return
  end if
  if Cl = 0 then
    Cl = 21
    Hh = 100
    play sound SndSpell
    Say(127)
    return
  end if
  play sound SndFizz
  Say(126)
  return
end sub

' clairvoyance (line 1250): the other player's room for a moment
sub Seer:
  V = Cl
  Cl = Cp[Oz]
  Lb = Lb | 128
  DrawRoom
  Cl = V
  Lb = Lp[Z]
  Say(128)
  Idle = 4
  WaitPress
  Idle = 0
  return
end sub

' line 1280
sub DoSpeak:
  play sound SndTalk
  V = 0
  if Cl > 5 then
    if Cl < 19 then
      if Has(7) = 0 then V = 1
    end if
  end if
  if V = 1 then
    Say(129)
  elseif Cl = 13 then
    Say(130)
  elseif Cl = 0 then
    Say(131)
  else
    Say(132)
  end if
  A16 = Mo[Cl] & 2
  if A16 > 0 then
    Say(133)
  end if
  A16 = Mo[Cl] & 32
  if A16 > 0 then
    Say(134)
  end if
  A16 = Mo[Cl] & 64
  if A16 > 0 then
    Say(135)
  end if
  A16 = Mo[Cl] & 128
  if A16 > 0 then
    LongText(136)
  end if
  A16 = Mo[Cl] & 256
  if A16 > 0 then
    LongText(137)
  end if
  return
end sub

' a door that a key opens and shuts: room, way, the room behind
sub Toggle(u8 Tr, u8 Tw, u8 Tn):
  V = Tr * 6
  V = V + Tw
  W = Dx[V]
  W = W ^ Tn
  Dx[V] = W
  play sound SndUnlock
  return
end sub

' line 1390
sub DoLock:
  if Cl = 9 then
    if Has(9) = 1 then
      Toggle(9, 0, 10)
      Say(138)
      return
    end if
  end if
  if Cl = 18 then
    if Has(10) = 1 then
      Toggle(18, 2, 19)
      Say(139)
      return
    end if
  end if
  if Cl = 2 then
    if Has(10) = 1 then
      Toggle(2, 5, 14)
      Say(139)
      return
    end if
  end if
  if Cl = 3 then
    if Has(10) = 1 then
      Toggle(3, 1, 6)
      Say(139)
      return
    end if
  end if
  if Cl = 21 then
    A16 = Mo[21] & 8192
    if A16 = 0 then
      Say(140)
      return
    end if
    if Has(11) = 1 then
      Ob[21] = Ob[21] | 16
      Mo[21] = Mo[21] & 511
      play sound SndUnlock
      Say(141)
      return
    end if
  end if
  if Cl = 20 then
    if Has(11) = 1 then
      Mo[20] = Mo[20] ^ 16384
      play sound SndUnlock
      Say(142)
      A16 = Mo[20] & 16384
      if A16 > 0 then
        Say(143)
      else
        Say(144)
      end if
      return
    end if
  end if
  V = 0
  if Cl = 9 then V = 1
  if Cl = 18 then V = 1
  if Cl = 2 then V = 1
  if Cl = 3 then V = 1
  if Cl = 20 then V = 1
  if Cl = 21 then V = 1
  if V = 1 then
    Say(145)
  else
    Say(146)
  end if
  return
end sub

' line 1520
sub DoUse:
  if Lb = 0 then
    Say(147)
    return
  end if
  ListMine
  MenuList(4)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  if Cl = 13 then
    if It = 2 then
      A16 = Mo[13] & 4096
      if A16 > 0 then
        Gd = Gd + 1500
        Mo[13] = Mo[13] - 4096
        play sound SndCoin
        Say(148)
      else
        Say(149)
      end if
      return
    end if
  end if
  if Cl = 12 then
    if It = 13 then
      A16 = Mo[12] & 8192
      if A16 > 0 then
        Mo[12] = Mo[12] & 52735
        Ob[12] = Ob[12] | 512
        Gd = Gd + 500
        play sound SndCoin
        Say(150)
        return
      end if
    end if
  end if
  if Cl = 11 then
    if It = 6 then
      Cl = 12
      Th = 0
      play sound SndStep
      Say(151)
      return
    end if
  end if
  if Cl = 14 then
    if It = 3 then
      A16 = Mo[14] & 8192
      if A16 > 0 then
        Ob[14] = Ob[14] | 2048
        Mo[14] = Mo[14] & 52735
        Gd = Gd + 1500
        play sound SndCoin
        Say(152)
      else
        Say(153)
      end if
      return
    end if
  end if
  if Cl = 17 then
    if It = 8 then
      A16 = Mo[17] & 4096
      if A16 > 0 then
        Mo[17] = Mo[17] & 52735
        Ob[17] = Ob[17] | 32
        Gd = Gd + 1500
        play sound SndCoin
        Say(154)
      else
        Say(155)
      end if
      return
    end if
    if It = 0 then
      Say(156)
      return
    end if
  end if
  NextLine
  print at 1,MsgY, "NO USE FOR"
  PutStr(0, It, 12, MsgY, 0)
  print at Px,MsgY, " HERE!"
  return
end sub

' line 1670
sub DoDrink:
  if Cl = 21 then
    Hh = Hh + 2
    play sound SndDrink
    Say(157)
    return
  end if
  if Cl = 7 then
    Hh = Hh + 5
    play sound SndDrink
    Say(158)
    return
  end if
  if Cl = 17 then
    Hh = Hh - 50
    play sound SndOuch
    Say(159)
    return
  end if
  Say(160)
  return
end sub

' line 1730: prices by place in the list, 200 a step for things, 100 for
' spells
sub DoTrade:
  if Cl <> 22 then
    Say(161)
    return
  end if
  MN = 3
  for J = 0 to 2
    OptT[J] = 7
    OptI[J] = J
  next
  MenuList(5)
  if Sel = 2 then return
  if Sel = 0 then
    if Carried >= 4 then
      Say(108)
      return
    end if
    MN = 6
    for J = 0 to 4
      OptT[J] = 0
      OptI[J] = ShopIt[J]
    next
    OptT[5] = 5
    OptI[5] = 0
    MenuList(6)
    if Sel = 5 then return
    It = OptI[Sel]
    W16 = Sel + 1
    W16 = W16 * 200
    if Has(It) = 1 then
      Say(162)
      return
    end if
    if Gd < W16 then
      Say(163)
      return
    end if
    Gd = Gd - W16
    Lb = Lb | BitW[It]
    play sound SndCoin
    NextLine
    print at 1,MsgY, "BOUGHT:"
    PutStr(0, It, 9, MsgY, 0)
    return
  end if
  MN = 9
  for J = 0 to 7
    OptT[J] = 2
    OptI[J] = J
  next
  OptT[8] = 5
  OptI[8] = 0
  MenuList(7)
  if Sel = 8 then return
  It = Sel
  W16 = Sel + 1
  W16 = W16 * 100
  V = Sb & BitT[It]
  if V > 0 then
    Say(164)
    return
  end if
  if Gd < W16 then
    Say(163)
    return
  end if
  Gd = Gd - W16
  Sb = Sb | BitT[It]
  play sound SndCoin
  NextLine
  print at 1,MsgY, "LEARNED:"
  PutStr(2, It, 10, MsgY, 0)
  return
end sub

' line 1850
sub DoRead:
  if Cl = 21 then
    LongText(165)
    LongText(166)
    LongText(167)
    return
  end if
  if Cl = 9 then
    Say(168)
    return
  end if
  if Cl = 0 then
    Say(169)
    return
  end if
  if Cl = 19 then
    Say(170)
    return
  end if
  if Cl = 14 then
    Say(171)
    return
  end if
  if Cl = 3 then
    Say(172)
    return
  end if
  if Cl = 8 then
    Say(173)
    return
  end if
  if Cl = 20 then
    Say(174)
    return
  end if
  if Cl = 22 then
    Say(175)
    return
  end if
  if Cl = 15 then
    Say(176)
    return
  end if
  Say(177)
  return
end sub

' the monsters (lines 290-370)
sub MonPhase:
  Y = MonIn(Cl)
  if Y = 0 then return
  W16 = Mo[Cl] & 511
  W16 = W16 * 10
  A16 = Th
  if OthHere = 1 then A16 = Th + Tp[Oz]
  if A16 > W16 then
    Mo[Cl] = Mo[Cl] & 28672
    play sound SndKill
    NextLine
    V = Y - 1
    PutStr(1, V, 1, MsgY, 0)
    print at Px,MsgY, " KILLED!"
    Th = 0
    W16 = Y * 10
    Hh = Hh + W16
    V = Y * 25
    V = Rnd(V)
    NumU = V * 2
    Gd = Gd + NumU
    NextLine
    print at 1,MsgY, "YOU FOUND"
    print NumU at 11,MsgY width 3
    print at 15,MsgY, "GOLD PIECES!"
    if Y = 7 then
      if Np = 2 then
        Ob[Cl] = Ob[Cl] | Bp[Oz]
        Bp[Oz] = 0
      end if
      Lb = Lb | Bp[Z]
      Bp[Z] = 0
      Say(178)
    end if
    DrawRoom
    return
  end if
  if Y >= 8 then return
  V = Y * 10
  V = V + 20
  if Has(1) = 1 then V = V - 20
  if Rnd(100) < V then
    play sound SndOuch
    NextLine
    print at 1,MsgY, "CRUNCH!!"
    V = Y - 1
    PutStr(1, V, 10, MsgY, 0)
    print at Px,MsgY, " STRIKES"
    W16 = Y * 10
    Hh = Hh - W16
    if Y = 7 then
      A16 = Lb & Bp[Z]
      if A16 = 0 then
        if Lb <> 0 then
          Bp[Z] = Bp[Z] | Lb
          Lb = 0
          Say(179)
        end if
      end if
    end if
    DrawStat
  end if
  return
end sub

' line 380
sub DeathCheck:
  if Hh > 0 then return
  if Cl = 0 then return
  play sound SndDie
  Say(180)
  Y = MonIn(Cl)
  if Y > 0 then
    if Y < 8 then
      NextLine
      print at 1,MsgY, "SLAIN BY THE"
      V = Y - 1
      PutStr(1, V, 14, MsgY, 0)
    end if
  end if
  Cl = 0
  DrawRoom
  return
end sub

' ---------------------------------------------------------------------------
' the screen

' the address of text n of the table
function TxtAddr(u8 Tn) as u16
  if Tn < 128 then
    P = TxtA[Tn]
  else
    V = Tn - 128
    P = TxtB[V]
  end if
  return P

' a name (0 things, 1 monsters, 2 spells, 3 rooms, 4 words of the menu,
' 5 NOTHING, 6 NO SPELL, 7 the trading choices) with Ad added to each
' letter (128: the heading or dim letters); Px ends after it
sub PutStr(u8 Tb, u8 Ix, u8 Sx, u8 Sy, u8 Ad):
  V = TbBase[Tb]
  if Tb = 3 then
    if Ix > 23 then Ix = 23
  end if
  if Tb < 5 then V = V + Ix
  if Tb = 7 then V = V + Ix
  PutTxt(V, Sx, Sy, Ad)
  return
end sub

' text n at Sx,Sy (byte 1: the next row)
sub PutTxt(u8 Tn, u8 Sx, u8 Sy, u8 Ad):
  P = TxtAddr(Tn)
  Px = Sx
  Chc = peek(P)
  while Chc <> 0
    if Chc = 1 then
      Px = Sx
      inc Sy
    else
      Chc = Chc + Ad
      put char Chc at Px,Sy
      inc Px
    end if
    inc P
    Chc = peek(P)
  end while
  return
end sub

' a message in the message lines
sub Say(u8 Tn):
  P = TxtAddr(Tn)
  NextLine
  Px = 1
  Chc = peek(P)
  while Chc <> 0
    if Chc = 1 then
      NextLine
      Px = 1
    else
      put char Chc at Px,MsgY
      inc Px
    end if
    inc P
    Chc = peek(P)
  end while
  return
end sub

' a long text: pages of up to 9 lines in rows 9-17
sub LongText(u8 Tn):
  P = TxtAddr(Tn)
  LongBegin
  Px = 1
  Y = 9
  Chc = peek(P)
  while Chc <> 0
    if Chc = 1 then
      Px = 1
      inc Y
    elseif Chc = 2 then
      A16 = P
      LongWait
      LongBegin
      P = A16
      Px = 1
      Y = 9
    else
      put char Chc at Px,Y
      inc Px
    end if
    inc P
    Chc = peek(P)
  end while
  LongEnd
  return
end sub

' a number in the heading letters
sub PutNumH(u16 Nv, u8 Nx):
  Px = Nx
  A16 = 10000
  V = 0
  while A16 > 0
    W = 0
    while Nv >= A16
      Nv = Nv - A16
      inc W
    end while
    if W > 0 then V = 1
    if A16 = 1 then V = 1
    if V = 1 then
      W = W + 176
      put char W at Px,8
      inc Px
    end if
    A16 = A16 / 10
  end while
  return
end sub

' the heading bar: the room's name, life and gold
sub DrawStat:
  fill 160 count 32 at 0,8
  PutStr(3, Cl, 1, 8, 128)
  put char 200 at 21,8
  NumU = 0
  if Hh > 0 then
    W16 = Hh
    NumU = W16 / 10
  end if
  PutNumH(NumU, 22)
  put char 199 at 26,8
  PutNumH(Gd, 27)
  return
end sub

' the room (line 670): picture, heading, text, exits, things, creatures
sub DrawRoom:
  Dk = IsDark(Cl)
  V = SceneOf[Cl]
  if Dk = 1 then V = 254
  if V <> Scene then
    Scene = V
    Rearm
    wait
    nmi off
    if Dk = 1 then
      fill $11 count 2048 to vram.color
    else
      decompress zx0 ScenePat[V] to vram.pattern
      decompress zx0 SceneCol[V] to vram.color
    end if
  end if
  DrawStat
  for J = 9 to 15
    fill 32 count 30 at 1,J
  next
  if Dk = 1 then
    print at 1,9, "YOU CAN'T SEE A THING IN THIS"
    print at 1,10, "DARKNESS!"
  else
    V = Cl
    if V > 23 then V = 23
    V = V + TDesc
    PutTxt(V, 1, 9, 0)
    print at 1,13, "EXITS:"
    Px = 8
    for J = 0 to 5
      V = Cl * 6
      V = V + J
      if Dx[V] <> 0 then
        V = J + 6
        PutStr(4, J, Px, 13, 0)
        inc Px
      end if
    next
    ' the things here
    Px = 1
    for It = 0 to 13
      A16 = Ob[Cl] & BitW[It]
      if A16 > 0 then
        if Px < 20 then
          if Px > 1 then
            put char 44 at Px,14
            inc Px
          end if
          PutStr(0, It, Px, 14, 0)
        else
          print at Px,14, ",.."
          Px = 31
        end if
      end if
    next
    Y = MonIn(Cl)
    if Y > 0 then
      V = Y - 1
      PutStr(1, V, 1, 15, 0)
      print at Px,15, "!"
    end if
    if OthHere = 1 then
      if Oz = 1 then
        print at 18,15, "PLAYER 1 HERE"
      else
        print at 18,15, "PLAYER 2 HERE"
      end if
    end if
  end if
  PlaceSprites
  return
end sub

' the sprites of the room: monster (or eyes in the dark), the players, a
' prop, the spirits of Hades
sub PlaceSprites:
  MonY = MonIn(Cl)
  ShowMon = 0
  EyesOn = 0
  if MonY > 0 then
    if Dk = 1 then
      EyesOn = 1
    else
      ShowMon = 1
    end if
  end if
  PropK = 0
  if Dk = 0 then PropK = PropOf[Cl]
  ShowOth = OthHere
  GhostOn = 0
  if Cl = 0 then GhostOn = 1
  AnimSprites
  return
end sub

sub AnimSprites:
  if ShowMon = 1 then
    V = MonY - 1
    V = V << 4
    W = MonF << 3
    V = V + W
    V = V + SMon
    W = MonColA[MonY]
    set sprite 1 to 39,176,V,W
    V = V + 4
    W = MonColB[MonY]
    set sprite 2 to 39,176,V,W
  else
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end if
  V = HeroF << 2
  V = V + SHero
  W = 5
  if Z = 2 then W = 9
  set sprite 3 to 43,56,V,W
  if ShowOth = 1 then
    W = 9
    if Z = 2 then W = 5
    set sprite 4 to 43,84,SHero,W
  else
    set sprite 4 to 192,0,0,0
  end if
  if PropK > 0 then
    V = PropK - 1
    V = V << 3
    V = V + SProp
    W = PropColA[PropK]
    set sprite 5 to 20,120,V,W
    V = V + 4
    W = PropColB[PropK]
    set sprite 6 to 20,120,V,W
  else
    set sprite 5 to 192,0,0,0
    set sprite 6 to 192,0,0,0
  end if
  if GhostOn = 1 then
    V = Anim >> 1
    V = V & 63
    if V > 31 then V = 63 - V
    X = V + 24
    W = MonF << 2
    W = W + SGhost
    set sprite 7 to 6,X,W,14
    X = 200 - V
    set sprite 8 to 14,X,W,14
  elseif EyesOn = 1 then
    set sprite 7 to 30,176,SEyes,8
    set sprite 8 to 192,0,0,0
  else
    set sprite 7 to 192,0,0,0
    set sprite 8 to 192,0,0,0
  end if
  update sprites
  return
end sub

' a frame of the slow animation: monsters bob every 24 frames, the hero
' shifts his feet every 40, the spirits drift
sub AnimTick:
  inc Anim
  V = Anim % 24
  if V = 0 then MonF = MonF ^ 1
  V = Anim % 40
  if V = 0 then HeroF = HeroF ^ 1
  AnimSprites
  return
end sub

sub ClearMsg:
  fill 32 count 30 at 1,16
  fill 32 count 30 at 1,17
  MsgY = 15
  return
end sub

' the next message line (scrolls the two lines up when full)
sub NextLine:
  if MsgY < 17 then
    inc MsgY
    return
  end if
  copy vram.name + 545 count 30 to vram.name + 513
  fill 32 count 30 at 1,17
  return
end sub

' a long text in rows 9-17: begin and end (the button, then the room)
sub LongBegin:
  for J = 9 to 17
    fill 32 count 30 at 1,J
  next
  return
end sub

sub LongWait:
  for J = 18 to 22
    fill 32 count 31 at 1,J
  next
  set sprite 0 to 192,0,0,0
  print at 8,20, "PRESS THE BUTTON"
  Idle = 4
  WaitPress
  Idle = 0
  return
end sub

sub LongEnd:
  LongWait
  ClearMsg
  DrawRoom
  DrawMenu
  return
end sub

' waits for a button of the player whose turn it is
sub WaitPress:
  WasB = 1
wp_loop:
  Frame1
  AnimTick
  ReadPad
  V = P1 | P2
  if V = 0 then goto wp_loop
  return
end sub

' the 18 words, the ways you cannot go dimmed
sub DrawMenu:
  for J = 16 to 22
    fill 32 count 31 at 1,J
  next
  for K = 0 to 17
    X = K / 5
    Y = K % 5
    X = X << 3
    X = X + 2
    Y = Y + 18
    W = 0
    if K < 6 then
      if Dk = 0 then
        V = Cl * 6
        V = V + K
        if Dx[V] = 0 then W = 128
      end if
    end if
    PutStr(4, K, X, Y, W)
  next
  return
end sub

' the flame beside the choice
sub PutCursor:
  X = Sel / MRows
  Y = Sel % MRows
  X = X * MXs
  X = X + MX0
  X = X - 1
  X = X << 3
  Y = Y + MY0
  Y = Y << 3
  Y = Y - 4
  W = 5
  if Z = 2 then W = 9
  if Np = 0 then W = 8
  set sprite 0 to Y,X,SCursor,W
  update sprites
  return
end sub

' the main menu: 18 words in 4 columns of 5
sub MenuMain:
  MN = 18
  MRows = 5
  MX0 = 2
  MXs = 8
  MY0 = 18
  MKind = 0
  Sel = 0
  Idle = 1
  Pick
  Idle = 0
  return
end sub

' a list in rows 17-22 (two columns of 6) under a question in row 16;
' Lk: 1 take 2 drop 3 cast 4 use 5 trade 6 buy 7 magic
sub MenuList(u8 Lk):
  for J = 16 to 22
    fill 32 count 31 at 1,J
  next
  if Lk = 1 then print at 1,16, "TAKE WHICH?"
  if Lk = 2 then print at 1,16, "DROP WHICH?"
  if Lk = 3 then print at 1,16, "CAST WHICH SPELL?"
  if Lk = 4 then print at 1,16, "USE WHICH?"
  if Lk = 5 then print at 1,16, "THE TRADING POST:"
  if Lk = 6 then print at 1,16, "BUY WHICH?"
  if Lk = 7 then print at 1,16, "LEARN WHICH?"
  for K = 0 to MN - 1
    X = K / 6
    Y = K % 6
    X = X * 15
    X = X + 2
    Y = Y + 17
    PutStr(OptT[K], OptI[K], X, Y, 0)
  next
  MRows = 6
  MX0 = 2
  MXs = 15
  MY0 = 17
  MKind = Lk
  Sel = 0
  Idle = 2
  Pick
  Idle = 0
  ClearMsg
  DrawMenu
  return
end sub

' the price shown at the trading post
sub ShowPrice:
  if MKind < 6 then return
  fill 32 count 12 at 19,16
  V = Sel + 1
  if MKind = 6 then
    if Sel = 5 then return
    NumU = V * 200
  else
    if Sel = 8 then return
    NumU = V * 100
  end if
  print NumU at 19,16 width 4
  print at 24,16, "GOLD"
  return
end sub

' moves the flame with the stick until a button: Sel the choice (the right
' button in a list takes the last choice, "nothing")
sub Pick:
  PutCursor
  ShowPrice
  WasB = 1
  WasStk = 1
pk_loop:
  Frame1
  AnimTick
  ReadPad
  if P2 = 1 then
    if MKind > 0 then
      Sel = MN - 1
      play sound SndPick
      return
    end if
  end if
  if P1 = 1 then
    play sound SndPick
    return
  end if
  if P2 = 1 then
    play sound SndPick
    return
  end if
  if Stk = 0 then goto pk_loop
  if WasStk = 1 then
    inc Rep
    if Rep < 16 then goto pk_loop
    Rep = 8
  end if
  WasStk = 1
  X = Sel / MRows
  Y = Sel % MRows
  if Up1 = 1 then
    if Y > 0 then dec Y
  elseif Dn1 = 1 then
    V = Y + 1
    W = X * MRows
    W = W + V
    if V < MRows then
      if W < MN then Y = V
    end if
  elseif Lf1 = 1 then
    if X > 0 then dec X
  elseif Rt1 = 1 then
    V = X + 1
    W = V * MRows
    if W < MN then
      X = V
      W = W + Y
      if W >= MN then
        Y = MN - 1
        V = X * MRows
        Y = Y - V
      end if
    end if
  end if
  V = X * MRows
  V = V + Y
  if V <> Sel then
    Sel = V
    play sound SndTick
    PutCursor
    ShowPrice
  end if
  goto pk_loop
end sub

' two players: the controllers change hands
sub HandOver:
  for J = 18 to 22
    fill 32 count 31 at 1,J
  next
  set sprite 0 to 192,0,0,0
  update sprites
  play sound SndTurn
  if Z = 1 then
    print at 4,19, "PLAYER 1, YOUR TURN."
    print at 4,21, "PRESS A BUTTON ON"
    print at 4,22, "CONTROLLER 1."
  else
    print at 4,19, "PLAYER 2, YOUR TURN."
    print at 4,21, "PRESS A BUTTON ON"
    print at 4,22, "CONTROLLER 2."
  end if
  Idle = 3
  WaitPress
  Idle = 0
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub NewGame:
  for J = 0 to 179
    Dx[J] = ExitInit[J]
  next
  for J = 0 to 29
    Ob[J] = ObInit[J]
    Mo[J] = MoInit[J]
  next
  for J = 1 to 2
    Cp[J] = 21
    Lp[J] = 0
    Sp[J] = 128
    Gp[J] = 200
    Hp[J] = 100
    Tp[J] = 0
    Bp[J] = 0
  next
  if Np = 1 then Cp[2] = 255
  Z = 1
  Oz = 2
  Won = 0
  Winner = 0
  Turns = 0
  Rs = Seed
  return
end sub

sub GameScreen:
  NewScreen
  fill vram.name with sequence $00..$FF repeat 1
  fill $11 count 2048 to vram.color
  Scene = 255
  ClearMsg
  ShowScreen
  return
end sub

sub EndPage:
  NewScreen
  FontTop
  print at 2,3, "ADVENTURER, YOU HAVE"
  print at 2,4, "CONQUERED THE DARK FORTRESS!"
  if Winner = 1 then print at 9,7, "PLAYER 1 WINS !!!"
  if Winner = 2 then print at 9,7, "PLAYER 2 WINS !!!"
  print at 8,10, "CONGRATULATIONS!!!!"
  print at 3,13, "THE THREE GEMS ARE IN THE"
  print at 3,14, "TROPHY CASE."
  print at 3,16, "I HOPE YOU HAVE ENJOYED"
  print at 3,17, "YOUR QUEST ..."
  print at 13,19, "GOODBYE."
  print at 6,21, "TURNS"
  NumU = Turns
  print NumU at 12,21 width 5
  ShowScreen
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' the title: the tune once, ONE PLAYER / TWO PLAYERS / CREDITS; the time
' spent here seeds the random numbers. Np: 1 or 2, 0 credits
sub TitlePage:
  NewScreen
  fill vram.name with sequence $00..$FF repeat 1
  decompress zx0 ScenePat[ScTitle] to vram.pattern
  decompress zx0 SceneCol[ScTitle] to vram.color
  Scene = 255
  print at 7,9, "BY CLEVE BLAKEMORE"
  print at 2,11, "THREE GEMS LIE HIDDEN IN THE"
  print at 2,12, "FORTRESS. LAY THEM IN THE"
  print at 2,13, "TROPHY CASE BEFORE YOUR RIVAL."
  print at 11,16, "ONE PLAYER"
  print at 11,17, "TWO PLAYERS"
  print at 11,18, "CREDITS"
  print at 5,21, "STICK AND BUTTON TO CHOOSE"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TitleLen
  TzOn = 1
  MN = 3
  MRows = 3
  MX0 = 11
  MXs = 8
  MY0 = 16
  MKind = 0
  Np = 0
  Sel = 0
  Pz = 0
  W16 = 0
  PutCursor
  WasB = 1
  WasStk = 1
  Idle = 5
tp_loop:
  Frame1
  inc W16
  ReadPad
  if Stk = 1 then
    if WasStk = 0 then
      WasStk = 1
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      play sound SndTick
      PutCursor
    end if
  end if
  V = P1 | P2
  if V = 0 then goto tp_loop
  Idle = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Seed = W16 * 251
  Seed = Seed ^ $5A3C
  if Seed = 0 then Seed = 1
  if Sel = 2 then
    CreditsPage
    Np = 0
  else
    Np = Sel + 1
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  FontTop
  print at 8,2, "DARK FORTRESS"
  print at 2,5, "BASED ON DARK FORTRESS BY"
  print at 2,6, "CLEVE BLAKEMORE, AHOY!"
  print at 2,7, "JANUARY 1987 (COMMODORE 128)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: THE FORTRESS WAITS,"
  print at 2,17, "SHADOWTHORN NIGHT"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' the stick and buttons of the player whose turn it is (either controller
' with one player or on the title)
sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  B1 = 0
  B2 = 0
  Pz = 0
  if Np = 2 then Pz = Z
  if Pz <> 2 then
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).button1 then B1 = 1
    if joypad(1).button2 then B2 = 1
  end if
  if Pz <> 1 then
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).button1 then B1 = 1
    if joypad(2).button2 then B2 = 1
  end if
  P1 = 0
  P2 = 0
  V = B1 | B2
  if V = 1 then
    if WasB = 0 then
      P1 = B1
      P2 = B2
    end if
  end if
  WasB = V
  Stk = Up1 | Dn1
  Stk = Stk | Lf1
  Stk = Stk | Rt1
  if Stk = 0 then
    WasStk = 0
    Rep = 0
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' a blank screen (display off): the font in the lower two thirds, the
' heading letters (yellow on dark red) in the middle third and the dim
' letters (dark blue) in the bottom third, both at codes 160-223
sub NewScreen:
  Busy = 1
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill full mode 2 text color with $F0
  for J = 0 to 15
    W16 = J
    W16 = W16 << 5
    A16 = W16 + 2304
    P = W16 + 3328
