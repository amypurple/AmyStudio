cartridge "ATOM SHOOT/COMPUTE'S GAZETTE/1985"

' ATOM SHOOT
' A ColecoVision game based on "Atom Shoot", COMPUTE!'s Gazette, October
' 1985 (VIC-20 BASIC, disk 1985-10; no author is named in the listing or
' on the disk's contents files). Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the VIC-20 listing's (orig/),
' the game is built for the ColecoVision: drawn cells, atoms and ports,
' a gliding cursor sprite, a spark at the port where a beam comes out,
' sound effects and a title tune.
'
' The game: five atoms hide in an 8 x 8 box. Shoot beams into the box
' from the 32 ports round its edge and watch what comes out:
'   H  the beam hit an atom head on and was absorbed;
'   R  the beam was turned back out of the port it went in by;
'   a letter: the beam was bent and came out at the other port with the
'      same letter.
' A beam passing an atom diagonally ahead of it turns away from it; two
' atoms either side of its path send it back; an atom diagonally next to
' a port reflects a beam fired from that port. Mark the five cells you
' think hold the atoms (the button on a cell; again to take the mark
' off). On the fifth mark the box opens: all five right and you win.
' Fewer beams is better; the lowest winning count is kept as BEST.
'
' From the VIC-20 listing: the 8 x 8 box with a 32-port ring (cursor over
' a 10 x 10 grid, corners dead), five atoms at random cells, the beam
' rules (hit ahead; one atom diagonally ahead turns the beam away, two
' reflect; one diagonally ahead at the very first step reflects), H /
' R / lettered pairs at the ports, a used port cannot be fired again,
' marks toggled on the core cells, the game judged on the fifth mark,
' the beam counter, the LOW (best) count kept on a win, the box opened
' after a miss.
'
' Liberties: the VIC moved a deflected beam one cell sideways without
' looking at that cell, so it could pass straight through an atom (and
' skip the next diagonal test); here a turned beam looks ahead again
' from where it is, as Black Box beams do, so the clues never lie. A
' beam that comes out of its own port after turns is shown as R (the VIC
' wrote a lone letter over it). At the end, marks are shown right
' (yellow) or wrong (grey cross) beside the missed atoms (red); the VIC
' showed the atoms only. A spark marks the port where a beam came out.
' The pair letters are A-Q without H and R (at most 16 detours), so they
' never look like the H and R clues. Joystick cursor glides
' and repeats when held. No play-again prompt: the title comes back.
' The C-64 listing on the same disk is a different game (25 mirrors in a
' 15 x 10 grid, keyboard guesses); it is not ported here.
'
' Controls: either controller; the stick moves the cursor, either button
' fires a beam from a port or marks / unmarks a core cell. On the title,
' up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop protected from the NMI; screens drawn with the NMI off and
' the display off. Music first in the sound table, the title tune played
' once. `set sprite count` always given. Own xorshift random numbers.
' Nothing flashes.

const TCore00 = 128
const TCore01 = 129
const TCore10 = 130
const TCore11 = 131
const TMark00 = 132
const TMark01 = 133
const TMark10 = 134
const TMark11 = 135
const TReal00 = 136
const TReal01 = 137
const TReal10 = 138
const TReal11 = 139
const TGood00 = 140
const TGood01 = 141
const TGood10 = 142
const TGood11 = 143
const TWrong00 = 144
const TWrong01 = 145
const TWrong10 = 146
const TWrong11 = 147
const TPort00 = 148
const TPort01 = 149
const TPort10 = 150
const TPort11 = 151
const THit00 = 152
const THit01 = 153
const THit10 = 154
const THit11 = 155
const TRefl00 = 156
const TRefl01 = 157
const TRefl10 = 158
const TRefl11 = 159
const TPa00 = 160
const TPa01 = 161
const TPa10 = 162
const TPa11 = 163
const TPb00 = 164
const TPb01 = 165
const TPb10 = 166
const TPb11 = 167
const TPc00 = 168
const TPc01 = 169
const TPc10 = 170
const TPc11 = 171
const TPd00 = 172
const TPd01 = 173
const TPd10 = 174
const TPd11 = 175
const TPe00 = 176
const TPe01 = 177
const TPe10 = 178
const TPe11 = 179
const TPf00 = 180
const TPf01 = 181
const TPf10 = 182
const TPf11 = 183
const TPg00 = 184
const TPg01 = 185
const TPg10 = 186
const TPg11 = 187
const TPi00 = 188
const TPi01 = 189
const TPi10 = 190
const TPi11 = 191
const TPj00 = 192
const TPj01 = 193
const TPj10 = 194
const TPj11 = 195
const TPk00 = 196
const TPk01 = 197
const TPk10 = 198
const TPk11 = 199
const TPl00 = 200
const TPl01 = 201
const TPl10 = 202
const TPl11 = 203
const TPm00 = 204
const TPm01 = 205
const TPm10 = 206
const TPm11 = 207
const TPn00 = 208
const TPn01 = 209
const TPn10 = 210
const TPn11 = 211
const TPo00 = 212
const TPo01 = 213
const TPo10 = 214
const TPo11 = 215
const TPp00 = 216
const TPp01 = 217
const TPp10 = 218
const TPp11 = 219
const TPq00 = 220
const TPq01 = 221
const TPq10 = 222
const TPq11 = 223
const TCorner00 = 224
const TCorner01 = 225
const TCorner10 = 226
const TCorner11 = 227
const SCur = 0
const SSpark = 4
const NTiles8 = 800
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndFire = 4
const SndHit = 5
const SndRefl = 6
const SndExit = 7
const SndMark = 8
const SndUnmark = 9
const SndBump = 10
const SndWon = 11
const SndLost = 12
const NSpr = 2
const TuneLen = 576
const NAtoms = 5
' cell kinds (the tile of kind K is 128 + 4 K, four codes)
const KCore = 0
const KMark = 1
const KReal = 2
const KGood = 3
const KWrong = 4
const KPort = 5
const KHit = 6
const KRefl = 7
const KPair = 8
const KCorner = 24
' what Trace returns besides an exit cell
const BHit = 200
const BRefl = 201

record Cursor:
  u8 Row
  u8 Col
  u8 X
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the rules' numbers
u8 Beams = 0
u8 Best = 0
u8 Marks = 0
u8 Right = 0
u8 NPair = 0
u8 Lr = 0
u8 LastEnt = 0
' Atm[R * 10 + C] = 1 where an atom hides; Bd[] = the kind shown there
u8 Atm[100]
u8 Bd[100]
Cursor Cur
' game state: 0 title, 2 playing, 4 over; Res 1 won, 2 missed
u8 Gs = 0
u8 Res = 0
u8 Rpt = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 SparkT = 0
u8 SparkX = 0
u8 SparkY = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AtSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayInput
  MoveCursor
  if Gs <> 4 then goto play_loop

  ' the end: open the box, a message, then back to the title on a press
  HideSprites
  OpenBox
  if Res = 1 then
    if Best = 0 then
      Best = Beams
    elseif Beams < Best then
      Best = Beams
    end if
    ShowHud
    print at 2,22, "  YOU GOT IT! ALL FIVE.    "
    play sound SndWon
  else
    NumU = Right
    print at 2,22, "  YOU MISSED IT. ", digits$(NumU, 1), " OF 5 RIGHT"
    play sound SndLost
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the box

function IsPort(u8 R, u8 C) as u8
  u8 Edge = 0
  if R = 0 then inc Edge
  if R = 9 then inc Edge
  if C = 0 then inc Edge
  if C = 9 then inc Edge
  ' one edge: a port; two: a corner; none: the core
  if Edge = 1 then return 1
  return 0

' 1 when an atom is in core cell R, C (anything outside the core is empty;
' a row or column of 255 is -1 wrapped)
function AtomAt(u8 R, u8 C) as u8
  if R < 1 then return 0
  if R > 8 then return 0
  if C < 1 then return 0
  if C > 8 then return 0
  return Atm[R * 10 + C]

' follow a beam fired from port Ent: BHit, BRefl or the exit port's cell
function Trace(u8 Ent) as u8
  u8 Pr = 0
  u8 Pc = 0
  u8 Dr = 0
  u8 Dc = 0
  u8 Rr = 0
  u8 Cc = 0
  u8 M = 0
  u8 N = 0
  u8 A1 = 0
  u8 A2 = 0
  u8 First = 1
  u8 Guard = 0
  u8 Ex = 0
  Pr = Ent / 10
  Pc = Ent % 10
  if Pr = 0 then Dr = 1
  if Pr = 9 then Dr = 255
  if Pc = 0 then Dc = 1
  if Pc = 9 then Dc = 255
  while Guard < 250
    inc Guard
    Rr = Pr + Dr
    Cc = Pc + Dc
    if AtomAt(Rr, Cc) = 1 then return BHit
    ' the two cells diagonally ahead: Rr, Cc plus and minus the side step
    if Dr <> 0 then
      M = 0
      N = 1
    else
      M = 1
      N = 0
    end if
    A1 = AtomAt(Rr + M, Cc + N)
    A2 = AtomAt(Rr - M, Cc - N)
    select case A1 + A2
    case 2
      return BRefl
    case 1
      if First = 1 then return BRefl
      ' turn away from the atom, then look again from here
      if A1 = 1 then
        Dr = 0 - M
        Dc = 0 - N
      else
        Dr = M
        Dc = N
      end if
    case else
      Pr = Rr
      Pc = Cc
      First = 0
      if IsPort(Pr, Pc) = 1 then
        Ex = Pr * 10 + Pc
        if Ex = Ent then return BRefl
        return Ex
      end if
    end select
  end while
  return BRefl

' one cell's 2 x 2 tiles
sub DrawCell(u8 Ce):
  u8 T = 0
  u8 Px = 0
  u8 Py = 0
  T = Bd[Ce] * 4 + 128
  Px = Ce % 10
  Px = Px * 2 + 2
  Py = Ce / 10
  Py = Py * 2 + 2
  put char T at Px,Py
  put char T + 1 at Px + 1,Py
  put char T + 2 at Px,Py + 1
  put char T + 3 at Px + 1,Py + 1
  return

sub DrawBox:
  u8 Ce = 0
  for Ce = 0 to 99
    DrawCell(Ce)
  next
  return

' a new box: five atoms at random core cells (the listing's lines 40-70)
sub NewBox:
  u8 R = 0
  u8 C = 0
  u8 Ce = 0
  u8 Placed = 0
  fill array Atm with 0
  for R = 0 to 9
    for C = 0 to 9
      Ce = R * 10 + C
      if IsPort(R, C) = 1 then
        Bd[Ce] = KPort
      elseif R = 0 or R = 9 then
        Bd[Ce] = KCorner
      elseif C = 0 or C = 9 then
        Bd[Ce] = KCorner
      else
        Bd[Ce] = KCore
      end if
    next
  next
  while Placed < NAtoms
    W16 = Rand
    R = W16 & 7
    C = (W16 >> 3) & 7
    Ce = (R + 1) * 10 + C + 1
    if Atm[Ce] = 0 then
      Atm[Ce] = 1
      inc Placed
    end if
  end while
  return

' ---------------------------------------------------------------------------
' play

sub SetSpark(u8 Ce):
  SparkX = Ce % 10
  SparkX = SparkX * 16 + 16
  SparkY = Ce / 10
  SparkY = SparkY * 16 + 16
  SparkT = 45
  return

' a beam from port Ce (the listing's lines 470-630)
sub FireBeam(u8 Ce):
  u8 Ex = 0
  inc Beams
  play sound SndFire
  LastEnt = Ce
  Ex = Trace(Ce)
  Lr = Ex
  select case Ex
  case BHit
    Bd[Ce] = KHit
    play sound SndHit
    SetSpark(Ce)
  case BRefl
    Bd[Ce] = KRefl
    play sound SndRefl
    SetSpark(Ce)
  case else
    Bd[Ce] = KPair + NPair
    Bd[Ex] = KPair + NPair
    inc NPair
    DrawCell(Ex)
    play sound SndExit
    SetSpark(Ex)
  end select
  DrawCell(Ce)
  ShowHud
  return

' the button on the cursor's cell
sub Act:
  u8 Ce = 0
  u8 Kd = 0
  Ce = Cur.Row * 10 + Cur.Col
  Kd = Bd[Ce]
  select case Kd
  case KPort
    FireBeam(Ce)
  case KCore
    Bd[Ce] = KMark
    inc Marks
    play sound SndMark
    DrawCell(Ce)
    ShowHud
    if Marks = NAtoms then Judge
  case KMark
    Bd[Ce] = KCore
    dec Marks
    play sound SndUnmark
    DrawCell(Ce)
    ShowHud
  case else
    play sound SndBump
  end select
  return

' five marks down: count the right ones (lines 380-400)
sub Judge:
  u8 Ce = 0
  Right = 0
  for Ce = 11 to 88
    if Bd[Ce] = KMark then
      if Atm[Ce] = 1 then inc Right
    end if
  next
  Res = 2
  if Right = NAtoms then Res = 1
  Gs = 4
  return

' open the box: right marks yellow, wrong marks crossed, missed atoms red
sub OpenBox:
  u8 Ce = 0
  for Ce = 11 to 88
    if Bd[Ce] = KMark then
      if Atm[Ce] = 1 then
        Bd[Ce] = KGood
      else
        Bd[Ce] = KWrong
      end if
      DrawCell(Ce)
    elseif Bd[Ce] = KCore then
      if Atm[Ce] = 1 then
        Bd[Ce] = KReal
        DrawCell(Ce)
      end if
    end if
  next
  return

sub PlayInput:
  u8 St = 0
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
  elseif Rpt > 0 then
    dec Rpt
  else
    if WasStick = 0 then
      Rpt = 14
    else
      Rpt = 7
    end if
    MoveBy(St)
  end if
  WasStick = St
  if Press = 1 then Act
  return

' one cell in the stick's direction (the first of up, down, right, left)
sub MoveBy(u8 St):
  if (St & 1) > 0 then
    if Cur.Row > 0 then
      dec Cur.Row
      play sound SndStep
    end if
    return
  end if
  if (St & 2) > 0 then
    if Cur.Row < 9 then
      inc Cur.Row
      play sound SndStep
    end if
    return
  end if
  if (St & 8) > 0 then
    if Cur.Col < 9 then
      inc Cur.Col
      play sound SndStep
    end if
    return
  end if
  if (St & 4) > 0 then
    if Cur.Col > 0 then
      dec Cur.Col
      play sound SndStep
    end if
  end if
  return

' the cursor frame glides 4 pixels a frame toward its cell
sub MoveCursor:
  u8 Tx = 0
  u8 Ty = 0
  Tx = Cur.Col * 16 + 16
  Ty = Cur.Row * 16 + 16
  if Cur.X < Tx then Cur.X += 4
  if Cur.X > Tx then Cur.X -= 4
  if Cur.Y < Ty then Cur.Y += 4
  if Cur.Y > Ty then Cur.Y -= 4
  Y = Cur.Y - 1
  set sprite 0 to Y,Cur.X,SCur,15
  Y = 192
  if SparkT > 0 then
    dec SparkT
    Y = SparkY - 1
  end if
  set sprite 1 to Y,SparkX,SSpark,11
  update sprites
  return

sub ShowHud:
  print at 23,2, "BEAMS"
  NumU = Beams
  print at 24,3, digits$(NumU, 2)
  print at 23,5, "BEST"
  if Best = 0 then
    print at 24,6, "--"
  else
    NumU = Best
    print at 24,6, digits$(NumU, 2)
  end if
  print at 23,8, "MARKS"
  NumU = Marks
  print at 24,9, digits$(NumU, 1), " OF 5"
  return

' the key: one cell of each clue kind with its word
sub ShowKey:
  u8 T = 0
  for Ri = 0 to 2
    T = KHit + Ri
    if Ri = 2 then T = KPair
    T = T * 4 + 128
    Y = Ri * 3 + 12
    put char T at 23,Y
    put char T + 1 at 24,Y
    put char T + 2 at 23,Y + 1
    put char T + 3 at 24,Y + 1
  next
  print at 26,12, "HIT"
  print at 26,15, "BACK"
  print at 26,18, "PAIR"
  print at 2,22, "  FIRE AT PORTS. MARK FIVE. "
  return

' ---------------------------------------------------------------------------
' rounds

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

sub NewGame:
  Beams = 0
  Marks = 0
  NPair = 0
  Res = 0
  Lr = 0
  SparkT = 0
  NewScreen
  NewBox
  DrawBox
  ShowHud
  ShowKey
  Cur.Row = 0
  Cur.Col = 4
  Cur.X = 4 * 16 + 16
  Cur.Y = 16
  MoveCursor
  ShowScreen
  Gs = 2
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a cell picture of kind Kd at character Px, Py
sub Pic(u8 Kd, u8 Px, u8 Py):
  u8 T = 0
  T = Kd * 4 + 128
  put char T at Px,Py
  put char T + 1 at Px + 1,Py
  put char T + 2 at Px,Py + 1
  put char T + 3 at Px + 1,Py + 1
  return

' the title: ATOM SHOOT between rows of atoms, the tune once, PLAY / CREDITS
sub TitlePage:
  Gs = 0
  NewScreen
  for Ci = 0 to 6
    X = Ci * 4 + 2
    Pic(KReal, X, 2)
    Pic(KPort, X + 2, 2)
    Pic(KMark, X, 7)
    Pic(KPort, X + 2, 7)
  next
  print at 11,5, "ATOM SHOOT"
  print at 4,10, "COMPUTE!'S GAZETTE 1985"
  print at 3,12, "FIVE ATOMS HIDE IN A BOX."
  print at 3,13, "SHOOT BEAMS IN FROM THE"
  print at 3,14, "EDGE, WATCH WHERE THEY"
  print at 3,15, "COME OUT, MARK THE FIVE."
  print at 12,17, "PLAY"
  print at 12,18, "CREDITS"
  if Best > 0 then
    print at 9,21, "BEST:"
    NumU = Best
    print at 15,21, digits$(NumU, 2), " BEAMS"
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      play sound SndStep
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 10,17
  put char 32 at 10,18
  J = Menu + 17
  put char 62 at 10,J
  return

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "ATOM SHOOT"
  print at 2,4, "BASED ON ATOM SHOOT,"
  print at 2,5, "COMPUTE!'S GAZETTE, OCTOBER"
  print at 2,6, "1985 (VIC-20 VERSION)."
  print at 2,7, "NO AUTHOR NAMED."
  print at 2,9, "BEAMS: H ABSORBED, R SENT"
  print at 2,10, "BACK, LETTERS COME OUT IN"
  print at 2,11, "PAIRS. A BEAM TURNS AWAY"
  print at 2,12, "FROM AN ATOM AHEAD ON ITS"
  print at 2,13, "DIAGONAL."
  print at 2,15, "COLECOVISION GAME, MUSIC"
  print at 2,16, "AND PICTURES BY CLAUDE"
  print at 2,17, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,18, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,20, "MUSIC: CLOUD CHAMBER"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$01
  $01,$01,$01,$01,$01,$01,$01,$81
  $01,$00,$00,$00,$00,$00,$00,$00
  $81,$01,$01,$01,$01,$01,$01,$00
  $00,$00,$01,$07,$F0,$E0,$E0,$C0
  $00,$00,$80,$E0,$F0,$07,$07,$03
  $C0,$E0,$E0,$F0,$07,$01,$00,$00
  $03,$07,$07,$F0,$E0,$80,$00,$00
  $00,$00,$01,$07,$F0,$E0,$E0,$C0
  $00,$00,$80,$E0,$F0,$07,$07,$03
  $C0,$E0,$E0,$F0,$07,$01,$00,$00
  $03,$07,$07,$F0,$E0,$80,$00,$00
  $00,$00,$01,$07,$F0,$E0,$E0,$C0
