cartridge "HAUNTED CASTLE/AHOY! JANUARY 1986/1986"

' THE HAUNTED CASTLE
' A ColecoVision game based on "Haunted Castle", Ahoy! January 1986
' (Commodore 64, BASIC with machine-language sprite movers). The author's
' name is not on the disk (no REM line, no title credit). Made for Amy
' Studio by Claude (an AI made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The rules are the listing's: a castle of 11 levels of 10 x 10 rooms.
' Three treasures are hidden, at most one on a level. Every time you walk
' into a room its doors are dealt again: one to three of the open sides
' close (a brown door), never all four, and the castle's outer sides are
' solid walls. The door you came in by can slam shut behind you. Stairs
' join each level to the next. A ghost waits in one room out of four
' (never in a treasure room, never in the first room); it is slower than
' you. Caught with no treasure: the game is over. Caught with treasures:
' the ghost takes one and hides it again on a level that has none. Bring
' all three treasures back to room 00 of level 0 to win.
'
' Improvements: painted rooms whose stones change colour with the level,
' torches that flicker slowly, cobwebs, a castle map of the rooms you have
' seen (right button), walking and floating animation, sounds for every
' event and a quiet loop under play, a slightly faster ghost deep down.
' In the listing the stairs between levels 9 and 10 always sit in room 00
' (S(10) is never dealt); here they are dealt like the others.
'
' Controls (either joystick): the stick walks; the right button shows the
' castle map of this level; the left button starts. On the title, left
' and right choose START or CREDITS.
'
' House rules: tiles from code 128, text in columns 2-29, NMI off while
' drawing, music first in the sound table, `set sprite count` always
' given, nothing changes faster than 3 times a second.

const TWall = 128
const TFloor = 129
const TDoorh = 130
const TDoorhk = 131
const TDoorv = 132
const TDoorvk = 133
const TTorchA = 134
const TTorchB = 135
const TWebl = 136
const TWebr = 137
const TUp00 = 138
const TUp01 = 139
const TUp02 = 140
const TUp10 = 141
const TUp11 = 142
const TUp12 = 143
const TUp20 = 144
const TUp21 = 145
const TUp22 = 146
const TDn00 = 147
const TDn01 = 148
const TDn02 = 149
const TDn10 = 150
const TDn11 = 151
const TDn12 = 152
const TDn20 = 153
const TDn21 = 154
const TDn22 = 155
const TChest = 156
const TNochest = 157
const TMdark = 158
const TMseen = 159
const TMyou = 160
const TMup = 161
const TMdn = 162
const TMtr = 163
const TPic0 = 164
const TPic1 = 165
const TPic2 = 166
const TPic3 = 167
const TPic4 = 168
const TPic5 = 169
const TPic6 = 170
const TPic7 = 171
const TPic8 = 172
const TPic9 = 173
const TPic10 = 174
const TPic11 = 175
const TPic12 = 176
const TPic13 = 177
const TPic14 = 178
const TPic15 = 179
const TPic16 = 180
const TPic17 = 181
const TPic18 = 182
const TPic19 = 183
const TPic20 = 184
const TPic21 = 185
const TPic22 = 186
const TPic23 = 187
const TPic24 = 188
const TPic25 = 189
const TPic26 = 190
const TPic27 = 191
const TPic28 = 192
const TPic29 = 193
const TPic30 = 194
const TPic31 = 195
const TPic32 = 196
const TPic33 = 197
const TPic34 = 198
const TPic35 = 199
const TPic36 = 200
const TPic37 = 201
const TPic38 = 202
const TPic39 = 203
const TPic40 = 204
const TPic41 = 205
const TPic42 = 206
const TPic43 = 207
const TPic44 = 208
const TPic45 = 209
const TPic46 = 210
const TPic47 = 211
const TPic48 = 212
const TPic49 = 213
const TPic50 = 214
const TPic51 = 215
const TPic52 = 216
const TPic53 = 217
const TPic54 = 218
const TPic55 = 219
const TPic56 = 220
const TPic57 = 221
const TPic58 = 222
const TPic59 = 223
const TPic60 = 224
const TPic61 = 225
const TPic62 = 226
const TPic63 = 227
const TPic64 = 228
const TPic65 = 229
const TPic66 = 230
const TPic67 = 231
const TPic68 = 232
const TPic69 = 233
const TPic70 = 234
const TPic71 = 235
const TPic72 = 236
const TPic73 = 237
const TPic74 = 238
const TPic75 = 239
const TPic76 = 240
const TPic77 = 241
const TPic78 = 242
const TPic79 = 243
const TPic80 = 244
const TPic81 = 245
const TPic82 = 246
const TPic83 = 247
const TPic84 = 248
const SManAr = 0
const SManAl = 4
const SManBr = 8
const SManBl = 12
const SManCr = 16
const SManCl = 20
const SSkinr = 24
const SSkinl = 28
const SGhostA = 32
const SGhostB = 36
const SEyes = 40
const SChest = 44
const SBand = 48
const SBand2 = 52
const SBatA = 56
const SBatB = 60
const NTiles8 = 968
const SprBytes = 512
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndStep = 5
const SndSlam = 6
const SndCreak = 7
const SndWail = 8
const SndChime = 9
const SndSteal = 10
const SndShriek = 11
const SndWin = 12
const SndBump = 13
u16 TzLeft = 0
u8 TzOn = 0

u16 NumU = 0
u16 W16 = 0
u16 A16 = 0
u16 Rs = 1
u16 Rooms = 0
' the castle: the room you are in
u8 Rx = 0
u8 Ry = 0
u8 Rz = 0
' doors of this room: 0 top, 1 right, 2 bottom, 3 left; 0 closed, 1 open,
' 2 the castle's outer wall
u8 Dr[4]
' stairs: room of the stairs from level Z-1 to Z (Z 1 to 10)
u8 Sx[11]
u8 Sy[11]
' treasures: room on each level, 10 = none
u8 Tx[11]
u8 Ty[11]
u8 Tc = 0
' rooms seen: columns 0-7 in VisA, 8-9 packed four rooms a byte in VisB
u8 VisA[110]
u8 VisB[28]
u8 HasUp = 0
u8 HasDn = 0
u8 HasTr = 0
u8 Came = 0
' you (top-left of the 16 x 16 sprite), facing 0 right 1 left
u8 Px = 120
u8 Py = 100
u8 Face = 0
u8 Moving = 0
u8 Bumped = 0
' the ghost
u8 Gon = 0
u8 Gx = 0
u8 Gy = 0
u8 Gc = 0
' frames before the ghost starts to drift
u8 Gd = 0
u8 Ghosts = 0
u8 MsgT = 0
u8 Over = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Map1 = 0
u8 WasMap = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' scratch
u8 Rv = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 T = 0
u8 X = 0
u8 Y = 0
u8 A = 0
u8 B = 0
u8 D = 0
u8 Ok = 0

  tile screen
  set sound table HcSoundTable areas 6
  sprites 16x16
  set sprite count 6
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewCastle
  Rx = 0
  Ry = 0
  Rz = 0
  Tc = 0
  Rooms = 0
  Ghosts = 0
  Over = 0
  Px = 120
  Py = 100
  Face = 0
  Came = 9
  EnterRoom
  Gon = 0
  DrawRoom
  ShowScreen
  play sound SndRunA
  play sound SndRunB

play_loop:
  Frame1
  ReadPad
  if Map1 = 1 then
    if WasMap = 0 then ShowMap
  end if
  WasMap = Map1
  MoveMan
  if Over = 0 then MoveGhost
  if Over = 0 then CheckThings
  Animate
  DrawSprites
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then print at 2,22, "                            "
  end if
  if Over = 0 then goto play_loop

  stop sound SndRunA
  stop sound SndRunB
  print at 2,22, "                            "
  if Over = 1 then
    play sound SndWin
    print at 5,9, "                      "
    print at 5,10, "   CONGRATULATIONS!   "
    print at 5,11, "  YOU HAVE FOUND ALL  "
    print at 5,12, "   THE TREASURES!     "
    print at 5,13, "                      "
  else
    play sound SndShriek
    print at 5,10, "                      "
    print at 5,11, " THE GHOST GOT YOU!   "
    print at 5,12, "                      "
  end if
  print at 5,15, " ROOMS SEEN           "
  NumU = Rooms
  print at 18,15, digits$(NumU, 4)
  print at 5,16, " GHOSTS MET           "
  NumU = Ghosts
  print at 18,16, digits$(NumU, 4)
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, the screen sleeps after
  ' 30 seconds and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the castle

' xorshift16; Rv gets the low byte
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  W16 = Rs & 255
  Rv = W16
  return
end sub

' Rv 0-9
sub Rand10:
r10_again:
  Rand
  Rv = Rv & 15
  if Rv >= 10 then goto r10_again
  return
end sub

' Rv 0-10
sub Rand11:
r11_again:
  Rand
  Rv = Rv & 15
  if Rv >= 11 then goto r11_again
  return
end sub

' deal the treasures and the stairs, forget the rooms seen
sub NewCastle:
  for I = 0 to 10
    Tx[I] = 10
    Ty[I] = 10
    Sx[I] = 10
    Sy[I] = 10
  next
  for I = 0 to 109
    VisA[I] = 0
  next
  for I = 0 to 27
    VisB[I] = 0
  next
  for J = 0 to 2
nc_tr:
    Rand11
    D = Rv
    V = Tx[D]
    if V <> 10 then goto nc_tr
    Rand10
    A = Rv
    Rand10
    B = Rv
    if D = 0 then
      V = A | B
      if V = 0 then goto nc_tr
    end if
    Tx[D] = A
    Ty[D] = B
  next
  for D = 1 to 10
nc_st:
    Rand10
    A = Rv
    Rand10
    B = Rv
    ' not in a treasure room on either level, not on the stairs below
    Ok = 1
    if A = Tx[D] then
      if B = Ty[D] then Ok = 0
    end if
    K = D - 1
    if A = Tx[K] then
      if B = Ty[K] then Ok = 0
    end if
    if A = Sx[K] then
      if B = Sy[K] then Ok = 0
    end if
    if Ok = 0 then goto nc_st
    Sx[D] = A
    Sy[D] = B
  next
  return
end sub

' the ghost hides a treasure again: a level with none, not a stairs room
sub Rehide:
rh_again:
  Rand11
  D = Rv
  V = Tx[D]
  if V <> 10 then goto rh_again
  Rand10
  A = Rv
  Rand10
  B = Rv
  if A = Sx[D] then
    if B = Sy[D] then goto rh_again
  end if
  if D < 10 then
    K = D + 1
    if A = Sx[K] then
      if B = Sy[K] then goto rh_again
    end if
  end if
  if D = 0 then
    V = A | B
    if V = 0 then goto rh_again
  end if
  if D = Rz then
    if A = Rx then
      if B = Ry then goto rh_again
    end if
  end if
  Tx[D] = A
  Ty[D] = B
  return
end sub

' A = the room's row index (Z*10+Y); Ok = 1 when (Rx,Ry,Rz) was seen
sub SeenNow:
  W16 = Rz * 10
  A16 = Ry
  W16 = W16 + A16
  A = W16
  Ok = 0
  if Rx < 8 then
    K = Rx
    V = Bit[K]
    T = VisA[A]
    T = T & V
    if T > 0 then Ok = 1
  else
    B = A >> 2
    K = A & 3
    K = K << 1
    T = Rx - 8
    K = K + T
    V = Bit[K]
    T = VisB[B]
    T = T & V
    if T > 0 then Ok = 1
  end if
  return
end sub

sub MarkSeen:
  SeenNow
  if Ok = 1 then return
  inc Rooms
  if Rx < 8 then
    T = VisA[A]
    T = T | V
    VisA[A] = T
  else
    T = VisB[B]
    T = T | V
    VisB[B] = T
  end if
  return
end sub

' walking into a room (Came: the side you came in by, 9 = none): deal the
' doors, find the stairs and the treasure, maybe a ghost
sub EnterRoom:
  MarkSeen
  for I = 0 to 3
    Dr[I] = 1
  next
  N = 0
  if Ry = 0 then
    Dr[0] = 2
    inc N
  end if
  if Rx = 9 then
    Dr[1] = 2
    inc N
  end if
  if Ry = 9 then
    Dr[2] = 2
    inc N
  end if
  if Rx = 0 then
    Dr[3] = 2
    inc N
  end if
  ' C = 0-2; close C+1 open sides, stopping at three shut
  if N < 3 then
er_c:
    Rand
    J = Rv & 3
    if J = 3 then goto er_c
    for I = 0 to J
      if N < 3 then
er_side:
        Rand
        K = Rv & 3
        V = Dr[K]
        if V <> 1 then goto er_side
        Dr[K] = 0
        inc N
      end if
    next
  end if
  HasUp = 0
  HasDn = 0
  if Rz < 10 then
    K = Rz + 1
    if Rx = Sx[K] then
      if Ry = Sy[K] then HasUp = 1
    end if
  end if
  if Rz > 0 then
    if Rx = Sx[Rz] then
      if Ry = Sy[Rz] then HasDn = 1
    end if
  end if
  HasTr = 0
  if Rx = Tx[Rz] then
    if Ry = Ty[Rz] then HasTr = 1
  end if
  ' the ghost: one room in four, not with a treasure, not in room 000
  Gon = 0
  if HasTr = 0 then
    V = Rx | Ry
    V = V | Rz
    if V > 0 then
      Rand
      V = Rv & 3
      if V = 0 then
        Gon = 1
        inc Ghosts
        Gc = 0
        Gd = 60
        Gx = 24
        if Px < 120 then Gx = 216
        Gy = 40
        if Py < 96 then Gy = 152
      end if
    end if
  end if
  ' home with all three
  if Tc = 3 then
    V = Rx | Ry
    V = V | Rz
    if V = 0 then Over = 1
  end if
  return
end sub

' the room after walking in: the slam, the ghost's wail
sub AfterEnter:
  MsgT = 0
  print at 2,22, "                            "
  if Came < 4 then
    V = Dr[Came]
    if V = 0 then
      play sound SndSlam
      print at 5,22, "A DOOR SLAMS SHUT!"
      MsgT = 120
    end if
  end if
  if Gon = 1 then
    play sound SndWail
    print at 2,22, "A GHOST!"
    MsgT = 120
  end if
  return
end sub

' ---------------------------------------------------------------------------
' moving

sub MoveMan:
  Moving = 0
  V = 0
  if Lf1 = 1 then
    Face = 1
    Moving = 1
    if Px > 24 then
      dec Px
    else
      if Py >= 88 then
        if Py <= 104 then
          V = Dr[3]
          if V = 1 then
            dec Rx
            Px = 214
            Came = 1
            GoRoom
            return
          end if
          if V = 0 then Bump
        end if
      end if
    end if
  end if
  if Rt1 = 1 then
    Face = 0
    Moving = 1
    if Px < 216 then
      inc Px
    else
      if Py >= 88 then
        if Py <= 104 then
          V = Dr[1]
          if V = 1 then
            inc Rx
            Px = 26
            Came = 3
            GoRoom
            return
          end if
          if V = 0 then Bump
        end if
      end if
    end if
  end if
  if Up1 = 1 then
    Moving = 1
    if Py > 40 then
      dec Py
    else
      if Px >= 112 then
        if Px <= 128 then
          V = Dr[0]
          if V = 1 then
            dec Ry
            Py = 150
            Came = 2
            GoRoom
            return
          end if
          if V = 0 then Bump
        end if
      end if
    end if
  end if
  if Dn1 = 1 then
    Moving = 1
    if Py < 152 then
      inc Py
    else
      if Px >= 112 then
        if Px <= 128 then
          V = Dr[2]
          if V = 1 then
            inc Ry
            Py = 42
            Came = 0
            GoRoom
            return
          end if
          if V = 0 then Bump
        end if
      end if
    end if
  end if
  if Moving = 0 then Bumped = 0
  return
end sub

sub Bump:
  if Bumped = 0 then play sound SndBump
  Bumped = 1
  return
end sub

sub GoRoom:
  EnterRoom
  DrawRoom
  ShowScreen
  AfterEnter
  return
end sub

' the ghost drifts toward you, about half your speed (a little more deep
' down); one touch
sub MoveGhost:
  if Gon = 0 then return
  if Gd > 0 then
    dec Gd
    return
  end if
  T = GSp[Rz]
  Gc = Gc + T
  if Gc < 16 then return
  Gc = Gc - 16
  if Gx < Px then inc Gx
  if Gx > Px then dec Gx
  if Gy < Py then inc Gy
  if Gy > Py then dec Gy
  if Gx > Px then
    A = Gx - Px
  else
    A = Px - Gx
  end if
  if Gy > Py then
    B = Gy - Py
  else
    B = Py - Gy
  end if
  if A >= 10 then return
  if B >= 10 then return
  Gon = 0
  if Tc = 0 then
    Over = 2
    return
  end if
  dec Tc
  Rehide
  play sound SndSteal
  ShowHud
  print at 2,22, "THE GHOST TOOK A TREASURE!"
  MsgT = 150
  return
end sub

' the treasure and the stairs
sub CheckThings:
  A = Px + 8
  B = Py + 8
  if HasTr = 1 then
    if A >= 116 then
      if A <= 140 then
        if B >= 92 then
          if B <= 116 then
            HasTr = 0
            Tx[Rz] = 10
            Ty[Rz] = 10
            inc Tc
            play sound SndChime
            ShowHud
            print at 2,22, "YOU FOUND A TREASURE!"
            MsgT = 120
          end if
        end if
      end if
    end if
  end if
  if HasUp = 1 then
    if A < 48 then
      if B < 64 then
        inc Rz
        Px = 176
        Py = 136
        Came = 9
        play sound SndCreak
        GoRoom
        return
      end if
    end if
  end if
  if HasDn = 1 then
    if A >= 208 then
      if B >= 144 then
        dec Rz
        Px = 56
        Py = 48
        Came = 9
        play sound SndCreak
        GoRoom
        return
      end if
    end if
  end if
  return
end sub

' the torches, slowly (one change every 32 frames)
sub Animate:
  V = Tick & 31
  if V <> 0 then return
  K = TTorchA
  V = Tick & 32
  if V > 0 then K = TTorchB
  put char K at 8,4
  put char K at 23,4
  return
end sub

sub DrawSprites:
  if Face = 0 then
    K = SManAr
    N = SSkinr
  else
    K = SManAl
    N = SSkinl
  end if
  if Moving = 1 then
    V = Tick & 8
    if V > 0 then
      K = K + 8
    else
      K = K + 16
    end if
  end if
  Y = Py - 1
  set sprite 0 to Y,Px,N,9
  set sprite 1 to Y,Px,K,6
  if Gon = 1 then
    K = SGhostA
    V = Tick & 16
    if V > 0 then K = SGhostB
    Y = Gy - 1
    set sprite 2 to Y,Gx,SEyes,8
    set sprite 3 to Y,Gx,K,15
  else
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  end if
  if HasTr = 1 then
    K = SBand
    V = Tick & 32
    if V > 0 then K = SBand2
    set sprite 4 to 95,120,K,11
    set sprite 5 to 95,120,SChest,10
  else
    set sprite 4 to 192,0,0,0
    set sprite 5 to 192,0,0,0
  end if
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawRoom:
  NewScreen
  for J = 0 to 17
    W16 = J * 32
    A16 = J + 4
    A16 = A16 << 5
    copy RoomMap + W16 count 32 to vram.name + A16
  next
  ' this level's stone and floor
  W16 = Rz * 8
  copy WallCols + W16 count 8 to vram.color + 1024
  copy FloorCols + W16 count 8 to vram.color + 1032
  copy WallCols + W16 count 8 to vram.color + 3072
  copy FloorCols + W16 count 8 to vram.color + 3080
  copy WallCols + W16 count 8 to vram.color + 5120
  copy FloorCols + W16 count 8 to vram.color + 5128
  ' the four sides
  for I = 0 to 3
    V = Dr[I]
    K = TWall
    N = TWall
    if I = 0 then
      if V = 0 then
        K = TDoorh
        N = TDoorhk
      end if
      if V = 1 then
        K = TFloor
        N = TFloor
      end if
      put char K at 14,4
      put char K at 15,4
      put char N at 16,4
      put char K at 17,4
    end if
    if I = 2 then
      if V = 0 then
        K = TDoorh
        N = TDoorhk
      end if
      if V = 1 then
        K = TFloor
        N = TFloor
      end if
      put char K at 14,21
      put char N at 15,21
      put char K at 16,21
      put char K at 17,21
    end if
    if I = 1 then
      if V = 0 then
        K = TDoorv
        N = TDoorvk
      end if
      if V = 1 then
        K = TFloor
        N = TFloor
      end if
      put char K at 29,11
      put char N at 29,12
      put char K at 29,13
      put char K at 29,14
    end if
    if I = 3 then
      if V = 0 then
        K = TDoorv
        N = TDoorvk
      end if
      if V = 1 then
        K = TFloor
        N = TFloor
      end if
      put char K at 2,11
      put char K at 2,12
      put char N at 2,13
      put char K at 2,14
    end if
  next
  if HasUp = 1 then
    N = TUp00
    for J = 0 to 2
      Y = J + 5
      for I = 0 to 2
        X = I + 3
        put char N at X,Y
        inc N
      next
    next
  end if
  if HasDn = 1 then
    N = TDn00
    for J = 0 to 2
      Y = J + 18
      for I = 0 to 2
        X = I + 26
        put char N at X,Y
        inc N
      next
    next
  end if
  ShowHud
  DrawSprites
  return
end sub

' rows 1-3, as in the listing: treasures, room and level, where the
' treasure and the stairs of this level are
sub ShowHud:
  print at 2,1, "TREASURES"
  NumU = Tc
  print at 12,1, digits$(NumU, 1)
  print at 15,1, "ROOM"
  NumU = Ry
  print at 20,1, digits$(NumU, 1)
  NumU = Rx
  print at 21,1, digits$(NumU, 1)
  print at 23,1, "LEVEL"
  NumU = Rz
  if Rz < 10 then
    print at 29,1, digits$(NumU, 1)
  else
    print at 28,1, digits$(NumU, 2)
  end if
  V = Tx[Rz]
  if V = 10 then
    print at 2,2, "NO TREASURE ON THIS LEVEL   "
  else
    print at 2,2, "TREASURE IN ROOM            "
    NumU = Ty[Rz]
    print at 19,2, digits$(NumU, 1)
    NumU = V
    print at 20,2, digits$(NumU, 1)
  end if
  print at 2,3, "STAIRS UP    DOWN           "
  if Rz < 10 then
    K = Rz + 1
    NumU = Sy[K]
    print at 12,3, digits$(NumU, 1)
    NumU = Sx[K]
    print at 13,3, digits$(NumU, 1)
  else
    print at 12,3, "--"
  end if
  if Rz > 0 then
    NumU = Sy[Rz]
    print at 20,3, digits$(NumU, 1)
    NumU = Sx[Rz]
    print at 21,3, digits$(NumU, 1)
  else
    print at 20,3, "--"
  end if
  return
end sub

' the right button: the rooms of this level you have seen, the stairs, the
' treasure, where you are; any button closes it
sub ShowMap:
  HideSprites
  for J = 6 to 17
    for I = 5 to 26
      put char 32 at I,J
    next
  next
  print at 9,6, "LEVEL"
  NumU = Rz
  print at 15,6, digits$(NumU, 2)
  X = Rx
  Y = Ry
  for J = 0 to 9
    for I = 0 to 9
      Rx = I
      Ry = J
      SeenNow
      K = TMdark
      if Ok = 1 then K = TMseen
      N = K
      if Rz > 0 then
        if I = Sx[Rz] then
          if J = Sy[Rz] then
            if Ok = 1 then N = TMdn
          end if
        end if
      end if
      if Rz < 10 then
        T = Rz + 1
        if I = Sx[T] then
          if J = Sy[T] then
            if Ok = 1 then N = TMup
          end if
        end if
      end if
      if I = Tx[Rz] then
        if J = Ty[Rz] then N = TMtr
      end if
      if I = X then
        if J = Y then
          K = TMyou
          N = TMyou
        end if
      end if
      A = I << 1
      A = A + 6
      B = J + 7
      put char K at A,B
      inc A
      put char N at A,B
    next
  next
  Rx = X
  Ry = Y
  Rearm
  wait 10 frames
sm_wait:
  Frame1
  ReadPad
  V = Press | Map1
  if WasMap = 1 then
    V = Press
    if Map1 = 0 then WasMap = 0
  end if
  if V = 0 then goto sm_wait
  WasMap = 1
  DrawRoom
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Map1 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Map1 = 1
  if joypad(2).button2 then Map1 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the castle on its crag, two bats, the tune once
sub TitlePage:
  NewScreen
  for J = 0 to 10
    W16 = J * 24
    A16 = J + 1
    A16 = A16 << 5
    A16 = A16 + 4
    copy TitleMap + W16 count 24 to vram.name + A16
  next
  print at 8,13, "THE HAUNTED CASTLE"
  print at 3,15, "FIND THE THREE TREASURES"
  print at 3,16, "IN ELEVEN LEVELS AND BRING"
  print at 3,17, "THEM BACK TO ROOM 00."
  print at 3,18, "BEWARE THE GHOSTS."
  print at 3,20, "RIGHT BUTTON: CASTLE MAP"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Menu = 0
  X = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Lf1 | Rt1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  ' two bats cross the sky
  inc X
  K = SBatA
  V = Tick & 16
  if V > 0 then K = SBatB
  Y = 20
  V = Tick & 32
  if V > 0 then Y = 22
  set sprite 0 to Y,X,K,13
  A = X + 96
  B = Y + 18
  set sprite 1 to B,A,K,13
  update sprites
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  print at 8,22, " START   CREDITS"
  if Menu = 0 then
    put char 62 at 8,22
  else
    put char 62 at 16,22
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop dark blue
  print at 7,2, "THE HAUNTED CASTLE"
  print at 2,5, "BASED ON HAUNTED CASTLE,"
  print at 2,6, "AHOY! JANUARY 1986"
  print at 2,7, "(COMMODORE 64). THE AUTHOR"
  print at 2,8, "IS NOT NAMED ON THE DISK."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: CASTLE GATE,"
  print at 2,19, "CANDLE HALL"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

