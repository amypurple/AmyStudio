cartridge "ACROBAT/PETER RIZZUTO, COMPUTE!/1985"

' ACROBAT
' A ColecoVision game made from "Acrobat" by Peter Rizzuto, COMPUTE!
' February 1985 (pages 56-71: Atari, Commodore 64 and VIC-20 versions),
' in Amy by Amy Bienvenu. Built by Claude (an AI made by Anthropic) for
' Amy Studio, 2026. Not a copy of any of the three listings: their rules,
' rebuilt for this machine.
'
' The game: your acrobat runs and cannot be stopped, through mountains,
' jungles, underground caves and a night run. Push the stick up to jump,
' down to slide, the button to flip. Touch anything and you fall in a
' heap: push the stick (or the button) to go on with the next man.
' After a while the level ends: a bonus for every man left, then a new
' setting, faster. Speed 1, 2 or 3 chosen on the title.
'
' Scoring (the Atari version's): a jump 20, a slide 10, a flip 10, every
' stride forward 2. From the 64 version: the chicken (from level 5) is
' worth 10 when it has flown past you. A free man at 2000 points, then
' every 1000.
'
' What fits each obstacle: a rock or log, jump (or flip); a bird at head
' height, slide (or flip over it); a fire, flip - a jump is too short.
'
' Made for the ColecoVision:
' - the whole width, two scenery bands scrolling smoothly at two speeds
'   (the far one at a quarter): their tiles' patterns are rewritten every
'   frame from 8 pre-shifted copies (band.py, acband.asm), the name table
'   never moves;
' - the acrobat is two sprites (suit and skin) with run, jump, a
'   four-way turning flip, slide, fall and heap; obstacles are sprites;
' - music while running (quieter, on tones 2 and 3) under the effects
'   (tone 1 and noise): music first in the sound table.
' - the night run (from the 64 version's night mode): the obstacles show
'   only in your lamp's reach.
'
' House rules kept: joystick only; text in columns 2-29; tiles from code
' 128; an original title tune played once; a credits page; screens drawn
' with the NMI off after a wait.

const TSky = 128
const TBlack = 129
const TSun00 = 130
const TSun01 = 131
const TSun10 = 132
const TSun11 = 133
const TMoon00 = 134
const TMoon01 = 135
const TMoon10 = 136
const TMoon11 = 137
const TStar = 138
const TStar2 = 139
const SRun1m = 0
const SRun1y = 4
const SRun2m = 8
const SRun2y = 12
const SRun3m = 16
const SRun3y = 20
const SJumpm = 24
const SJumpy = 28
const SFlip0m = 32
const SFlip0y = 36
const SFlip1m = 40
const SFlip1y = 44
const SFlip2m = 48
const SFlip2y = 52
const SFlip3m = 56
const SFlip3y = 60
const SSlidem = 64
const SSlidey = 68
const SFallm = 72
const SFally = 76
const SHeapm = 80
const SHeapy = 84
const SBoulder = 88
const SLog = 92
const SRocks = 96
const SBird1 = 100
const SBird2 = 104
const SFire1 = 108
const SFire2 = 112
const SHen1 = 116
const SHen2 = 120
const NTiles8 = 96
const SprBytes = 992
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndOverA = 5
const SndOverB = 6
const SndJump = 7
const SndFlip = 8
const SndSlide = 9
const SndCrash = 10
const SndFall = 11
const SndTick = 12
const SndExtra = 13
const SndCluck = 14
const SndDodge = 15
const BandF = 192
const BandG = 240

u16 NumU = 0
u16 ScHi = 0
u16 ScLo = 0
u16 HiHi = 0
u16 HiLo = 0
u16 NextMan = 2
u16 LevT = 0
u16 Pos = 0
u16 Pts = 0
u16 W16 = 0
' Set: the setting (0 mountains, 1 jungle, 2 caves, 3 night); Bd its sky
u8 Set = 0
u8 Bd = 5
u8 Level = 1
u8 Diff = 1
u8 Men = 3
' Spd: quarter pixels a frame; Frac the quarters left over; Mv this frame's move
u8 Spd = 4
u8 Frac = 0
u8 Mv = 0
' St: 0 run, 1 jump, 2 flip, 3 slide, 4 down; Prog how far into it (px)
u8 St = 0
u8 Prog = 0
u8 H = 0
u8 AnimD = 0
u8 Ct = 0
u8 Gap = 100
u8 Stride = 0
u8 Hud = 0
' the obstacles: kind (0 none, 1 low, 2 high, 3 fire) and x
u8 Ok[3]
u8 Ox[3]
' the chicken: on (0 no, 1 coming, 2 past you), x, its own move
u8 Hon = 0
u8 Hx = 0
u8 Hmv = 0
' the acrobat's box this frame
u8 Ax0 = 0
u8 Ax1 = 0
u8 Ay0 = 0
u8 Ay1 = 0
u8 Hit = 0
u8 Menu = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
' Mode (for the tests): 0 title, 1 running, 2 down, 3 between levels, 4 game over
u8 Mode = 0
u8 Demo = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 C = 0
u8 P = 0
' for acband.asm
u16 BSrc = 0
u16 RowB = 0
u8 BOff = 0
u8 BW = 0
u8 BMask = 0
u8 BCol = 0
u8 BTc = 0
u8 BRc = 0

' the jump (48 px) and flip (80 px) heights, by distance run
data JumpH bytes
  0,2,3,5,6,7,9,10,11,12,13,14,15,16,17,17
  18,18,19,19,19,20,20,20,20,20,20,20,19,19,19,18
  18,17,17,16,15,14,13,12,11,10,9,7,6,5,3,2
end data
data FlipH bytes
  0,2,3,5,6,8,9,11,12,14,15,16,17,19,20,21
  22,23,24,25,26,26,27,28,29,29,30,30,31,31,32,32
  33,33,33,33,34,34,34,34,34,34,34,34,34,33,33,33
  33,32,32,31,31,30,30,29,29,28,27,26,26,25,24,23
  22,21,20,19,17,16,15,14,12,11,9,8,6,5,3,2
end data
' per setting: the low obstacle's pattern and colour, the bird's colour
data LowPat bytes
  SBoulder,SLog,SRocks,SBoulder
end data
data LowCol bytes
  14,10,9,14
end data
data BirdCol bytes
  4,8,13,15
end data
data SkyCol bytes
  5,7,1,4
end data
data RunPat bytes
  SRun1m,SRun2m,SRun3m,SRun2m
end data
data FlipPat bytes
  SFlip0m,SFlip1m,SFlip2m,SFlip3m
end data

  tile screen
  nmi off
  set sound table AcSoundTable areas 6
  sprites 16x16
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  nmi off
  CreditsPage

title:
  TitlePage
  NewGame

play_loop:
  Frame1
  call asm AcBands
  ReadPad
  if St = 4 then goto play_down
  Mode = 1
  ' the scroll: Spd quarter pixels a frame
  Frac = Frac + Spd
  Mv = Frac >> 2
  Frac = Frac & 3
  Pos = Pos + Mv
  AnimD = AnimD + Mv
  ' a new move only from running
  if St = 0 then
    if Up1 = 1 then
      StartAct(1)
    elseif Dn1 = 1 then
      StartAct(3)
    elseif Press = 1 then
      StartAct(2)
    end if
  end if
  Moves
  ' a stride: 2 points every 16 pixels
  Stride = Stride + Mv
  if Stride >= 16 then
    Stride = Stride - 16
    Pts = 2
    AddPts
  end if
  ManBox
  Obstacles
  Chicken
  DrawMan
  DrawObs
  update sprites
  if Hud = 1 then ShowHud
  if Hit = 1 then
    Down
    goto play_loop
  end if
  dec LevT
  if LevT = 0 then
    LevelEnd
  end if
  goto play_loop

' fallen: the heap, then the stick (or the button) to go on
play_down:
  Mode = 2
  inc Ct
  ' a fall from the air comes down first
  if H > 1 then
    H = H - 2
  else
    H = 0
  end if
  DrawMan
  update sprites
  if Ct < 60 then goto play_loop
  if Ct = 60 then print at 4,21, "PUSH THE STICK TO GO ON"
  if Ct > 60 then Ct = 61
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  V = V | Press
  if V = 0 then
    WasStick = 0
    goto play_loop
  end if
  if WasStick = 1 then goto play_loop
  fill 32 count 28 at 2,21
  dec Men
  Hud = 1
  if Men = 0 then goto game_over
  ClearObs
  St = 0
  H = 0
  play song AcRunSong
  WasStick = 1
  goto play_loop

game_over:
  Mode = 4
  ShowHud
  print at 10,21, "GAME OVER"
  if ScHi > HiHi then
    HiHi = ScHi
    HiLo = ScLo
  elseif ScHi = HiHi then
    if ScLo > HiLo then HiLo = ScLo
  end if
  ShowHud
  stop song
  play song AcOverSong once
  for J = 1 to 200
    Frame1
  next
  Rearm
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' StartAct: 1 jump (20), 2 flip (10), 3 slide (10)
sub StartAct(u8 A):
  St = A
  Prog = 0
  if A = 1 then
    Pts = 20
    play sound SndJump
  elseif A = 2 then
    Pts = 10
    play sound SndFlip
  else
    Pts = 10
    play sound SndSlide
  end if
  AddPts
  return
end sub

' Moves: how high the acrobat is, by how far into the move he is
sub Moves:
  if St = 0 then return
  Prog = Prog + Mv
  if St = 1 then
    if Prog >= 48 then
      St = 0
      H = 0
    else
      H = JumpH[Prog]
    end if
  elseif St = 2 then
    if Prog >= 80 then
      St = 0
      H = 0
    else
      H = FlipH[Prog]
    end if
  elseif St = 3 then
    H = 0
    if Prog >= 56 then St = 0
  end if
  return
end sub

' ManBox: the acrobat's box (screen pixels; he is drawn at x 56, y 120 - H)
sub ManBox:
  if St = 3 then
    Ax0 = 56
    Ax1 = 71
    Ay0 = 130
    Ay1 = 134
  elseif St = 2 then
    Ax0 = 59
    Ax1 = 68
    Ay0 = 122 - H
    Ay1 = 132 - H
  elseif St = 1 then
    Ax0 = 59
    Ax1 = 68
    Ay0 = 121 - H
    Ay1 = 133 - H
  else
    Ax0 = 60
    Ax1 = 67
    Ay0 = 121
    Ay1 = 135
  end if
  return
end sub

' Touch(x0, x1, y0, y1): sets Hit when the box meets the acrobat's
sub Touch(u8 Q0, u8 Q1, u8 R0, u8 R1):
  if Q1 < Ax0 then return
  if Q0 > Ax1 then return
  if R1 < Ay0 then return
  if R0 > Ay1 then return
  Hit = 1
  return
end sub

sub Obstacles:
  ' move them with the ground; gone at the left edge
  for I = 0 to 2
    if Ok[I] > 0 then
      V = Ox[I]
      if V <= Mv then
        Ok[I] = 0
      else
        V = V - Mv
        Ox[I] = V
        if V < 80 then
          X = V + 2
          Y = V + 13
          K = Ok[I]
          if K = 1 then
            Touch(X, Y, 127, 135)
          elseif K = 2 then
            Touch(X, Y, 116, 123)
          else
            X = V + 1
            Y = V + 30
            Touch(X, Y, 125, 135)
          end if
        end if
      end if
    end if
  next
  ' a new one when the gap has been run
  if Gap > Mv then
    Gap = Gap - Mv
    return
  end if
  for I = 0 to 2
    if Ok[I] = 0 then
      Spawn
      return
    end if
  next
  return
end sub

' Spawn: obstacle I at the right edge, and the gap to the next one
sub Spawn:
  Ox[I] = 248
  V = random(0, 9)
  if Level = 1 then
    K = 1
    if V > 6 then K = 2
  else
    K = 1
    if V > 5 then K = 2
    if V > 7 then K = 3
  end if
  Ok[I] = K
  ' the gap shrinks with the level (110 down to 70), plus up to 80
  V = Level * 5
  if V > 40 then V = 40
  C = 110 - V
  V = random(0, 80)
  Gap = C + V
  if K = 3 then Gap = Gap + 24
  return
end sub

sub ClearObs:
  for I = 0 to 2
    Ok[I] = 0
  next
  Hon = 0
  Gap = 120
  return
end sub

' the chicken (level 5 on): flies faster than the ground, at head height
sub Chicken:
  if Level < 5 then return
  if Hon = 0 then
    V = random(0, 199)
    if V = 0 then
      Hon = 1
      Hx = 248
      play sound SndCluck
    end if
    return
  end if
  C = Mv + 1
  if Hx <= C then
    Hon = 0
    return
  end if
  Hx = Hx - C
  if Hon = 1 then
    if Hx < 44 then
      Hon = 2
      Pts = 10
      AddPts
      play sound SndDodge
    elseif Hx < 80 then
      X = Hx + 1
      Y = Hx + 12
      Touch(X, Y, 113, 122)
    end if
  end if
  return
end sub

' AddPts: Pts more; the score is kept as thousands and units
sub AddPts:
  ScLo = ScLo + Pts
  while ScLo >= 1000
    ScLo = ScLo - 1000
    inc ScHi
  end while
  Hud = 1
  if ScHi >= NextMan then
    inc NextMan
    if Men < 9 then inc Men
    play sound SndExtra
  end if
  return
end sub

sub Down:
  Hit = 0
  St = 4
  Ct = 0
  stop song
  play sound SndCrash
  play sound SndFall
  WasStick = 1
  return
end sub

' DrawMan: the two sprites of the acrobat
sub DrawMan:
  Y = 119 - H
  if St = 0 then
    V = AnimD >> 3
    V = V & 3
    P = RunPat[V]
  elseif St = 1 then
    P = SJumpm
  elseif St = 2 then
    V = Prog >> 4
    V = V & 3
    P = FlipPat[V]
  elseif St = 3 then
    P = SSlidem
  else
    P = SHeapm
    if Ct < 16 then P = SFallm
  end if
  set sprite 0 to Y,56,P,13
  P = P + 4
  set sprite 1 to Y,56,P,11
  return
end sub

sub DrawObs:
  for I = 0 to 2
    J = I * 2
    J = J + 2
    K = J + 1
    C = Ok[I]
    X = Ox[I]
    if C = 0 then
      set sprite J to 192,0,0,0
      set sprite K to 192,0,0,0
    elseif C = 1 then
      P = LowPat[Set]
      V = LowCol[Set]
      if Set = 3 then
        if X > 150 then V = 0
      end if
      set sprite J to 119,X,P,V
      set sprite K to 192,0,0,0
    elseif C = 2 then
      P = SBird1
      V = Tick & 8
      if V > 0 then P = SBird2
      V = BirdCol[Set]
      if Set = 3 then
        if X > 150 then V = 0
      end if
      set sprite J to 111,X,P,V
      set sprite K to 192,0,0,0
    else
      P = SFire1
      V = Tick & 4
      if V > 0 then P = SFire2
      V = 8
      if Set = 3 then
        if X > 150 then V = 0
      end if
      set sprite J to 119,X,P,V
      if X <= 239 then
        Y = X + 16
        set sprite K to 119,Y,P,V
      else
        set sprite K to 192,0,0,0
      end if
    end if
  next
  if Hon = 0 then
    set sprite 8 to 192,0,0,0
  else
    P = SHen1
    V = Tick & 4
    if V > 0 then P = SHen2
    set sprite 8 to 109,Hx,P,15
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub ShowHud:
  Hud = 0
  print at 2,22, "SCORE"
  NumU = ScHi
  print at 8,22, digits$(NumU, 3)
  NumU = ScLo
  print at 11,22, digits$(NumU, 3)
  print at 15,22, "HI"
  NumU = HiHi
  print at 18,22, digits$(NumU, 3)
  NumU = HiLo
  print at 21,22, digits$(NumU, 3)
  print at 25,22, "MEN"
  NumU = Men
  print at 29,22, digits$(NumU, 1)
  return
end sub

sub NewGame:
  ScHi = 0
  ScLo = 0
  NextMan = 2
  Men = 3
  Level = 1
  Demo = 0
  StartLevel
  return
end sub

' StartLevel: the level's setting drawn, the speed and time set
sub StartLevel:
  Mode = 3
  V = Level - 1
  Set = V & 3
  V = Diff * 2
  V = V + 2
  V = V + Level
  Spd = V - 1
  if Spd > 14 then Spd = 14
  W16 = Level * 120
  LevT = 1680 + W16
  if LevT > 3000 then LevT = 3000
  Scene
  ClearObs
  St = 0
  H = 0
  Frac = 0
  Stride = 0
  ShowHud
  print at 9,21, "LEVEL"
  NumU = Level
  print at 15,21, digits$(NumU, 2)
  ShowScreen
  for J = 1 to 90
    Frame1
    call asm AcBands
    DrawMan
    update sprites
  next
  fill 32 count 28 at 2,21
  play song AcRunSong
  return
end sub

' LevelEnd: a bonus of 250 for every man left, then the next level
sub LevelEnd:
  Mode = 3
  stop song
  HideSprites
  print at 6,21, "LEVEL"
  NumU = Level
  print at 12,21, digits$(NumU, 2)
  print at 15,21, "COMPLETE"
  for J = 1 to 60
    Frame1
  next
  for K = 1 to 5
    if K <= Men then
      for I = 1 to 5
        Pts = 50
        AddPts
        ShowHud
        play sound SndTick
        for J = 1 to 6
          Frame1
        next
      next
    end if
  next
  for J = 1 to 60
    Frame1
  next
  Rearm
  wait no fire
  nmi off
  inc Level
  if Level > 99 then Level = 99
  StartLevel
  return
end sub

' Scene: the setting's sky, scenery bands, ground and the bottom rows
sub Scene:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  if Set = 0 then
    copy FarCol0 count 384 to vram.color + 1536
    copy GrdCol0 count 128 to vram.color + 1920
  elseif Set = 1 then
    copy FarCol1 count 384 to vram.color + 1536
    copy GrdCol1 count 128 to vram.color + 1920
  elseif Set = 2 then
    copy FarCol2 count 384 to vram.color + 1536
    copy GrdCol2 count 128 to vram.color + 1920
  else
    copy FarCol3 count 384 to vram.color + 1536
    copy GrdCol3 count 128 to vram.color + 1920
  end if
  Bd = SkyCol[Set]
  if Demo = 1 then Bd = 1
  call asm AcBackdrop
  for Y = 0 to 16
    fill TSky count 32 at 0,Y
  next
  for Y = 21 to 23
    fill TBlack count 32 at 0,Y
  next
  for Y = 0 to 5
    V = Y * 8
    V = V + BandF
    K = Y + 8
    for X = 0 to 31
      C = X & 7
      C = C + V
      put char C at X,K
    next
  next
  for Y = 0 to 3
    V = Y * 4
    V = V + BandG
    K = Y + 17
    for X = 0 to 31
      C = X & 3
      C = C + V
      put char C at X,K
    next
  next
  ' the sky's own things: the sun, or the moon and stars
  if Set < 2 then
    put char TSun00 at 23,3
    put char TSun01 at 24,3
    put char TSun10 at 23,4
    put char TSun11 at 24,4
  elseif Set = 3 then
    put char TMoon00 at 24,3
    put char TMoon01 at 25,3
    put char TMoon10 at 24,4
    put char TMoon11 at 25,4
    put char TStar at 3,6
    put char TStar2 at 12,7
    put char TStar at 17,3
    put char TStar2 at 21,6
    put char TStar at 28,6
    put char TStar2 at 29,1
    put char TStar at 9,4
    put char TStar2 at 5,3
    put char TStar at 14,15
    put char TStar2 at 27,14
  end if
  call asm AcBands
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' TitlePage: the night scenery running by, the acrobat flipping now and
' then; up and down choose, left and right the speed, the button
sub TitlePage:
tp_start:
  Mode = 0
  stop song
  Demo = 1
  Set = 3
  Scene
  print at 9,1, "A C R O B A T"
  print at 3,2, "BY PETER RIZZUTO, COMPUTE!"
  print at 2,21, "UP:JUMP DOWN:SLIDE FIRE:FLIP"
  ShowMenu
  ShowHud
  ShowScreen
  play song AcTitleSong once
  Menu = 0
  St = 0
  H = 0
  Prog = 0
  Pos = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  call asm AcBands
  ReadPad
  Pos = Pos + 1
  AnimD = AnimD + 1
  Mv = 1
  V = Tick & 127
  if V = 0 then
    if St = 0 then
      St = 2
      Prog = 0
    end if
  end if
  Moves
  DrawMan
  update sprites
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  if Lf1 = 1 then
    if WasStick = 0 then
      if Diff > 1 then dec Diff
      ShowMenu
    end if
  end if
  if Rt1 = 1 then
    if WasStick = 0 then
      if Diff < 3 then inc Diff
      ShowMenu
    end if
  end if
  V = V | Lf1
  V = V | Rt1
  WasStick = V
  if Press = 0 then goto tp_loop
  stop song
  mute all
  if Menu = 1 then
    CreditsPage
    goto tp_start
  end if
  Demo = 0
  return
end sub

sub ShowMenu:
  print at 5,4, "START"
  print at 5,5, "CREDITS"
  print at 3,4, " "
  print at 3,5, " "
  V = Menu + 4
  print at 3,V, ">"
  print at 15,4, "SPEED 1 2 3"
  print at 20,5, "       "
  V = Diff * 2
  V = V + 19
  print at V,5, "^"
  return
end sub

sub CreditsPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  Bd = 1
  call asm AcBackdrop
  cls
  print at 9,2, "A C R O B A T"
  print at 2,5, "BASED ON ACROBAT BY"
  print at 2,6, "PETER RIZZUTO, COMPUTE!"
  print at 2,7, "FEBRUARY 1985 (ATARI, C64"
  print at 2,8, "AND VIC-20 VERSIONS)."
  print at 2,11, "REBUILT FOR COLECOVISION BY"
  print at 2,12, "CLAUDE (AN AI MADE BY"
  print at 2,13, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "2026, IN AMY BY AMY BIENVENU."
  print at 2,16, "MUSIC: BIG TOP, UNSTOPPABLE"
  print at 2,17, "AND DOWN AGAIN (ORIGINAL)."
  print at 7,21, "PRESS THE BUTTON"
  screen on
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; ACROBAT's scrolling bands (see band.py). Each frame, with the NMI off:
; the far band's 48 tiles (third 1, codes 192-239) from the copy shifted
; (Pos / 4) & 7 pixels, starting each tile (Pos / 32) & 7 bytes along its
; picture; then the ground's 16 tiles (third 2, codes 224-239) the same
; way from Pos & 31. One byte every 42 cycles: safe for the VDP while it
; draws (the far band is done before the beam reaches its rows).
AcBands:
    ld hl,(AMY_UVAR_Pos)
    srl h
    rr l
    srl h
    rr l
    ld a,l
    and 63
    ld c,a                  ; c = far shift 0-63
    ld hl,AcFarTab
    call AcPick             ; de = the setting's picture
    ld a,c
    and 7
    ld h,a
    ld l,0
    add hl,de               ; + fine shift * 256
    srl a
    ld d,a
    ld a,0
    rra
    ld e,a                  ; de = fine shift * 128
    add hl,de               ; + fine shift * 128: a copy is 384 bytes
    ld (AMY_UVAR_BSrc),hl
    ld a,c
    rrca
    rrca
    rrca
    and 7
    ld (AMY_UVAR_BOff),a
    ld a,8
    ld (AMY_UVAR_BW),a
    ld a,7
    ld (AMY_UVAR_BMask),a
    ld a,6
    ld (AMY_UVAR_BRc),a
    ld hl,VRAM_PATTERN + $0800 + 192*8
    call AcGather
    ; the ground
    ld a,(AMY_UVAR_Pos)
    and 31
    ld c,a
    ld hl,AcGrdTab
    call AcPick
    ld a,c
    and 7
    ld h,a
    ld l,0
    srl h
    rr l                    ; hl = fine shift * 128
    add hl,de
    ld (AMY_UVAR_BSrc),hl
    ld a,c
    rrca
    rrca
    rrca
    and 3
    ld (AMY_UVAR_BOff),a
    ld a,4
    ld (AMY_UVAR_BW),a
    ld a,3
    ld (AMY_UVAR_BMask),a
    ld a,4
    ld (AMY_UVAR_BRc),a
    ld hl,VRAM_PATTERN + $1000 + 240*8
    jp AcGather

; AcPick: de = the word at hl + Set * 2
AcPick:
    ld a,(AMY_UVAR_Set)
    and 3
    add a,a
    ld e,a
    ld d,0
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ret

; AcGather: BRc tile rows of BW tiles to VRAM hl, from BSrc (rows of BW
; bytes), each tile starting BOff + its number (mod BW) bytes along
AcGather:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,(AMY_UVAR_BSrc)
    ld (AMY_UVAR_RowB),hl
AcGR:
    ld a,(AMY_UVAR_BOff)
    ld (AMY_UVAR_BCol),a
    ld a,(AMY_UVAR_BW)
    ld (AMY_UVAR_BTc),a
AcGT:
    ld hl,(AMY_UVAR_RowB)
    ld a,(AMY_UVAR_BCol)
    ld e,a
    ld d,0
    add hl,de
    ld a,(AMY_UVAR_BW)
    ld e,a
    ld b,8
AcGP:
    ld a,(hl)
    out ($BE),a
    add hl,de
    djnz AcGP
    ld a,(AMY_UVAR_BCol)
    inc a
    ld b,a
    ld a,(AMY_UVAR_BMask)
    and b
    ld (AMY_UVAR_BCol),a
    ld a,(AMY_UVAR_BTc)
    dec a
    ld (AMY_UVAR_BTc),a
    jr nz,AcGT
    ld hl,(AMY_UVAR_RowB)
    ld a,(AMY_UVAR_BW)
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    add hl,de
    ld (AMY_UVAR_RowB),hl
    ld a,(AMY_UVAR_BRc)
    dec a
    ld (AMY_UVAR_BRc),a
    jr nz,AcGR
    ret

; AcBackdrop: the backdrop colour (VDP register 7) from Bd
AcBackdrop:
    ld a,(AMY_UVAR_Bd)
    out ($BF),a
    ld a,$87
    out ($BF),a
    ret

AcFarTab:
    dw AMY_UDATA_FarMtn, AMY_UDATA_FarTree, AMY_UDATA_FarCave, AMY_UDATA_FarMtn
AcGrdTab:
    dw AMY_UDATA_GrdGrass, AMY_UDATA_GrdMud, AMY_UDATA_GrdRock, AMY_UDATA_GrdGrass
AcJump:
    db $40,$D6,$20,$02,$40,$AA,$20,$02,$40,$8F,$30,$02,$40,$6B,$30,$03,$40,$55,$50,$04,$50
AcFlip:
    db $40,$7F,$20,$02,$40,$5F,$20,$02,$40,$7F,$30,$02,$40,$50,$30,$02,$40,$6B,$30,$02,$40,$40,$40,$03
    db $40,$35,$50,$04,$50
AcSlide:
    db $00,$00,$36,$03,$00,$00,$56,$06,$00,$00,$76,$06,$00,$00,$96,$06,$10
AcCrash:
    db $00,$00,$07,$03,$00,$00,$27,$06,$00,$00,$47,$0A,$00,$00,$67,$0E,$00,$00,$97,$10,$10
AcFall:
    db $40,$AA,$20,$04,$40,$BF,$30,$04,$40,$D6,$30,$04,$40,$FE,$40,$04,$40,$53,$51,$06,$40,$AB,$71,$08
    db $50
AcTick:
    db $40,$47,$20,$02,$40,$35,$40,$03,$50
AcExtra:
    db $40,$8F,$20,$04,$40,$71,$20,$04,$40,$5F,$20,$04,$40,$47,$20,$04,$40,$39,$30,$0A,$50
AcCluck:
    db $40,$66,$30,$02,$40,$FF,$F3,$02,$40,$56,$30,$02,$40,$7C,$50,$03,$50
AcDodge:
    db $40,$55,$30,$02,$40,$40,$40,$04,$50

AcSoundTable:
    dw AcTuneMel,$702B
    dw AcTuneBass,$7035
    dw AcRunMel,$702B
    dw AcRunBass,$7035
    dw AcOverMel,$702B
    dw AcOverBass,$7035
    dw AcJump,$7049
    dw AcFlip,$7049
    dw AcSlide,$703F
    dw AcCrash,$703F
    dw AcFall,$7049
    dw AcTick,$7049
    dw AcExtra,$7049
    dw AcCluck,$7049
    dw AcDodge,$7049
; Big Top (original)
; Tiny Sound, 7 frames per step
AcTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$31,$88,$1F,$01,$1C,$01,$1F,$01,$24,$01,$23,$01,$21,$01
    db $1F,$01,$01,$01,$1D,$01,$1A,$01,$1D,$01,$23,$01,$21,$01,$1F,$01
    db $1D,$01,$01,$01,$1C,$01,$1F,$01,$24,$01,$28,$01,$26,$01,$24,$01
    db $23,$01,$21,$01,$1F,$01,$23,$01,$26,$01,$23,$01,$24,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
AcTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0C,$01,$13,$01,$0C,$01,$13,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$07,$01,$0E,$01
    db $07,$01,$0E,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$05,$01,$0C,$01
    db $05,$01,$0C,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$01,$01
    db $FF

; Unstoppable (original)
; Tiny Sound, 6 frames per step
AcRunMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$60,$1A,$21,$21,$01,$24,$01,$28,$01,$01,$01,$26,$01,$24,$01
    db $23,$01,$01,$01,$21,$01,$24,$01,$28,$01,$2D,$01,$2B,$01,$28,$01
    db $26,$01,$01,$01,$1D,$01,$21,$01,$24,$01,$01,$01,$23,$01,$21,$01
    db $1F,$01,$01,$01,$1C,$01,$20,$01,$23,$01,$26,$01,$24,$01,$23,$01
    db $21,$01,$01,$01
    db $FF
AcRunBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$80,$18,$32,$09,$15,$01,$15,$09,$15,$01,$15,$07,$13,$01,$13
    db $07,$13,$01,$13,$09,$15,$01,$15,$09,$15,$01,$15,$0C,$18,$01,$18
    db $07,$13,$01,$13,$05,$11,$01,$11,$05,$11,$01,$11,$0C,$18,$01,$18
    db $07,$13,$01,$13,$04,$10,$01,$10,$04,$10,$01,$10,$09,$15,$01,$15
    db $04,$10,$01,$10
    db $FF

; Down Again (original)
; Tiny Sound, 8 frames per step
AcOverMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1C,$01,$1A,$01,$18,$01,$17,$01,$15,$01,$01,$01
    db $14,$01,$15,$01,$01,$01,$01,$01,$00,$01,$01,$01,$01,$01
    db $FF
AcOverBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$09,$01,$01,$01,$04,$01,$01,$01,$05,$01,$01,$01
    db $04,$01,$09,$01,$01,$01,$01,$01,$00,$01,$01,$01,$01,$01
    db $FF
AcTitleSong:
    dw $0001
    db $40+1,2
    dw $0000
AcRunSong:
    dw $0001
    db $40+3,4
    dw $0000
AcOverSong:
    dw $0001
    db $40+5,6
    dw $0000
}

