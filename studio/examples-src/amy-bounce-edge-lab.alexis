cartridge "BOUNCE EDGE LAB/AMY/2026"

i8 Pos = 0
i8 Delta = 0
u8 PassCount = 0

  text screen
  print at 6,0, "BOUNCE EDGE LAB"
  run_tests
  screen on
  goto done

sub mark_result:
  if Pos = 15 then
    if Delta = -3 then
      PassCount += 1
      print at 1,3, "HIGH SKIP PASS"
    else
      print at 1,3, "HIGH SKIP FAIL"
    end if
  else
    print at 1,3, "HIGH SKIP FAIL"
  end if
  return

sub run_tests:
  Pos = 14
  Delta = 3
  bounce Pos by Delta between 0 and 15
  mark_result

  Pos = 1
  Delta = -3
  bounce Pos by Delta between 0 and 15
  if Pos = 0 then
    if Delta = 3 then
      PassCount += 1
      print at 1,5, "LOW SKIP PASS"
    else
      print at 1,5, "LOW SKIP FAIL"
    end if
  else
    print at 1,5, "LOW SKIP FAIL"
  end if

  Pos = 12
  Delta = 3
  bounce Pos by Delta between 0 and 15
  if Pos = 15 then
    if Delta = 3 then
      PassCount += 1
      print at 1,7, "HIGH EXACT PASS"
    else
      print at 1,7, "HIGH EXACT FAIL"
    end if
  else
    print at 1,7, "HIGH EXACT FAIL"
  end if

  Pos = 3
  Delta = -3
  bounce Pos by Delta between 0 and 15
  if Pos = 0 then
    if Delta = -3 then
      PassCount += 1
      print at 1,9, "LOW EXACT PASS"
    else
      print at 1,9, "LOW EXACT FAIL"
    end if
  else
    print at 1,9, "LOW EXACT FAIL"
  end if

  print at 1,12, "PASS COUNT"
  print PassCount at 12,12 digits 1
  return

done:
  goto done