bool Flag = true
u8 U8Value = 7
i8 I8Value = -7
u16 U16Value = 12345
i16 I16Value = -1234
u32 U32Value = 100000
i32 I32Value = -123456
fixed FxValue = -1.5
ufixed UfxValue = 12.75
fixed32 Fx32Value = -1.25
fp5 Fp5Value = 0
bcd digits 6 BcdValue

  text screen
  Fp5Value = 10
  clear BcdValue
  BcdValue += 123456

  print centered at 0, "NUMERIC STR$ LAB"
  print at 1,2, "BOOL " + str$(Flag)
  print at 1,3, "U8   " + str$(U8Value)
  print at 1,4, "I8   " + str$(I8Value)
  print at 1,5, "U16  " + str$(U16Value)
  print at 1,6, "I16  " + str$(I16Value)
  print at 1,7, "U32  " + str$(U32Value)
  print at 1,8, "I32  " + str$(I32Value)
  print at 1,9, "FIX  " + str$(FxValue)
  print at 1,10, "UFIX " + str$(UfxValue)
  print at 1,11, "F32  " + str$(Fx32Value)
  print at 1,12, "FP5  " + str$(Fp5Value)
  print at 1,13, "BCD  " + str$(BcdValue)
  print at 1,15, "D5   " + str$(U8Value, digits 5)
  print at 1,16, "W5   " + str$(U8Value, width 5)
  print at 1,17, "ALIAS" + digits$(U8Value, 5) + width$(U8Value, 5)
  print at 1,18, "PASS IF ALL ROWS DISPLAY"
  screen on