record Actor:
  u8 X
  u8 Y
  u8 Ac
  u8 Live
  u8 Dx
  u8 Dy
  u8 Tm
  u8 Poof
end record

record Rock:
  u8 X
  u8 Y
  u8 St
  u8 T
  u8 Ac
end record

' a timer for the title tune (kit/tuneonce.py)
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 Scr = 1
u8 TSpd = 72
Actor Act[4]
Rock Rk[3]
' Phase: 0 intro, 1 play, 2 caught, 3 screen clear, 4 out of boulders
u8 Phase = 0
u8 PDir = 0
u8 Face = 0
u8 Paused = 0
u8 Anim = 0
u8 Menu = 0
u8 HPg = 0
u16 HWt = 0
u8 Digs = 0
u8 Kills = 0
u8 Squash = 0
' input: J (1 up, 2 down, 4 left, 8 right, 16 left button, 32 right
' button), OldJ last pass's
u8 J = 0
u8 OldJ = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Pass = 0
u8 Late = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ai = 0
u8 Ri = 0
u8 Ti = 0
u8 Si = 0
u8 Hi2 = 0
' scratch
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DgSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 2
  sprites flicker on
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  NewGame

screen_loop:
  RunScreen
  if Phase = 3 then
    NextScreen
    goto screen_loop
  end if

  ' the end: the message, GAME OVER, back to the title on a press
  if Score > Hi then Hi = Score
  ShowStatus
  if Phase = 2 then
    print at 7,12, " CAUGHT BY A TROLL "
  else
    print at 7,12, " OUT OF  BOULDERS  "
  end if
  print at 7,13, "     GAME OVER     "
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  HideSprites
  goto title

' ---------------------------------------------------------------------------
' one screen: the field drawn, SCREEN n, then play until the digger is
' caught (2), the trolls are gone (3) or the boulders are (4)

sub RunScreen:
  DrawField
  SetScreen
  ShowStatus
  print at 10,12, " SCREEN " + digits$(Scr, 2) + " "
  DrawSprites
  ShowScreen
  play sound SndStart
  for Ti = 1 to 90
    Frame1
  next
  RedrawRow12
  Phase = 1
  OldJ = 63
rs_loop:
  Pass2
  GetInput
  PlayStep
  DrawSprites
  if Phase = 1 then goto rs_loop
  if Phase = 2 then
    CaughtAnim
  else
    if Phase = 3 then
      ClearAnim
    else
      for Ti = 1 to 60
        Frame1
        DrawSprites
      next
    end if
  end if
  return
end sub

sub SetScreen:
  for Ai = 0 to 3
    Act[Ai].X = StartX[Ai]
    Act[Ai].Y = StartY[Ai]
    Act[Ai].Ac = 0
    Act[Ai].Live = 1
    Act[Ai].Dx = 0
    Act[Ai].Dy = 0
    ' trolls wake up after two seconds (a liberty: on the C64 they came at once)
    Act[Ai].Tm = Ai * 4 + 60
    Act[Ai].Poof = 0
    Dig(StartX[Ai], StartY[Ai])
  next
  for Ri = 0 to 2
    Rk[Ri].X = RockX[Ri]
    Rk[Ri].Y = RockY[Ri]
    Rk[Ri].St = 0
    Rk[Ri].T = 0
    Rk[Ri].Ac = 0
  next
  ' trolls a little faster every screen (a liberty)
  V = Scr - 1
  if V > 10 then V = 10
  TSpd = TSpd0 + V * 8
  PDir = 0
  Face = 0
  Paused = 0
  Kills = 0
  Phase = 0
  return
end sub

' one pass of play
sub PlayStep:
  if (J & 32) <> 0 then
    if (OldJ & 32) = 0 then
      Paused = Paused ^ 1
      play sound SndPick
      if Paused = 1 then
        print at 17,2, "PAUSED   "
      else
        ShowStatus
      end if
    end if
  end if
  OldJ = J
  if Paused = 1 then return
  inc Anim
  MoveDigger
  MoveTrolls
  MoveRocks
  if Phase <> 1 then return
  if TouchTroll() = 1 then
    Phase = 2
    return
  end if
  if Kills = 3 then
    Phase = 3
    return
  end if
  if RocksLeft() = 0 then Phase = 4
  return
end sub

' the digger: the stick sets the direction, which stays; the left button
' stops; a boulder at rest is in the way
sub MoveDigger:
  u8 Nx = 0
  u8 Ny = 0
  u16 Sum = 0
  select case J & 15
  case 1
    PDir = 1
  case 2
    PDir = 2
  case 4
    PDir = 3
    Face = 1
  case 8
    PDir = 4
    Face = 0
  end select
  if (J & 16) <> 0 then PDir = 0
  if PDir = 0 then return
  Sum = Act[0].Ac + PSpd
  Act[0].Ac = Sum & 255
  if Sum < 256 then return
  Nx = Act[0].X
  Ny = Act[0].Y
  select case PDir
  case 1
    if Ny > FY0 then dec Ny
  case 2
    if Ny < FY1 then inc Ny
  case 3
    if Nx > FX0 then dec Nx
  case else
    if Nx < FX1 then inc Nx
  end select
  if Blocked(Nx, Ny) = 1 then return
  X = Act[0].X
  Y = Act[0].Y
  Act[0].X = Nx
  Act[0].Y = Ny
  DigMove(X, Y, Nx, Ny)
  if Digs > 0 then
    if (Anim & 7) = 0 then play sound SndDig
  end if
  return
end sub

function Blocked(u8 Bx, u8 By) as u8
  for Ri = 0 to 2
    if Rk[Ri].St <> 2 then
      if Near(Bx, By, Rk[Ri].X, Rk[Ri].Y, 12) = 1 then return 1
    end if
  next
  return 0

' 1 when two 16 x 16 things are closer than R on both axes
function Near(u8 Ax, u8 Ay, u8 Bx, u8 By, u8 R) as u8
  u8 Ddx = 0
  u8 Ddy = 0
  if Ax > Bx then Ddx = Ax - Bx else Ddx = Bx - Ax
  if Ay > By then Ddy = Ay - By else Ddy = By - Ay
  if Ddx < R and Ddy < R then return 1
  return 0

' trolls: head for the digger along x and y, looking again after a random
' 2-33 of their own moves (8-132 frames here); they dig as they go
sub MoveTrolls:
  for Ai = 1 to 3
    if Act[Ai].Live = 1 then
      TrollStep(Ai)
    else
      if Act[Ai].Poof > 0 then dec Act[Ai].Poof
    end if
  next
  return
end sub

sub TrollStep(u8 I):
  u8 Tx = 0
  u8 Ty = 0
  u16 Sum = 0
  Tx = Act[I].X
  Ty = Act[I].Y
  if Act[I].Tm = 0 then
    Rand
    Act[I].Tm = ((Rs & 31) + 2) * 2
    X = Act[0].X
    Y = Act[0].Y
    if X > Tx then
      Act[I].Dx = 2
    else
      if X < Tx then Act[I].Dx = 1 else Act[I].Dx = 0
    end if
    if Y > Ty then
      Act[I].Dy = 2
    else
      if Y < Ty then Act[I].Dy = 1 else Act[I].Dy = 0
    end if
  end if
  dec Act[I].Tm
  if Act[I].Dx = 0 and Act[I].Dy = 0 then return
  Sum = Act[I].Ac + TSpd
  Act[I].Ac = Sum & 255
  if Sum >= 256 then
    select case Act[I].Dx
    case 1
      if Tx > FX0 then dec Tx
    case 2
      if Tx < FX1 then inc Tx
    end select
    select case Act[I].Dy
    case 1
      if Ty > FY0 then dec Ty
    case 2
      if Ty < FY1 then inc Ty
    end select
    X = Act[I].X
    Y = Act[I].Y
    Act[I].X = Tx
    Act[I].Y = Ty
    DigMove(X, Y, Tx, Ty)
  end if
  return
end sub

' boulders: 0 at rest, 1 rumbling, 2 falling
sub MoveRocks:
  for Ri = 0 to 2
    RockStep(Ri)
  next
  return
end sub

sub RockStep(u8 I):
  select case Rk[I].St
  case 0
    ' a boulder at rest looks under itself every fourth frame, in turn
    V = Pass & 3
    if V = I and Unsupported(I) = 1 then
      Rk[I].St = 1
      Rk[I].T = RWait
      play sound SndRumble
    end if
  case 1
    dec Rk[I].T
    if Rk[I].T = 0 then
      Rk[I].St = 2
      Rk[I].Ac = 0
    end if
  case else
    ' a pixel a pass
    inc Rk[I].Y
    RockHits(I)
    V = Rk[I].Y + 14
    if (V & 3) = 0 then
      if Unsupported(I) = 0 then
        Rk[I].St = 0
        play sound SndThud
      end if
    end if
  end select
  return
end sub

' 1 when the cells under the boulder's whole width are dug (and it is not
' on the bottom)
function Unsupported(u8 I) as u8
  u8 Ux = 0
  u8 Uy = 0
  u8 Cy = 0
  u8 Cx = 0
  u8 Ck = 0
  Ux = Rk[I].X
  Uy = Rk[I].Y
  if Uy >= RFloor then return 0
  Cy = (Uy + 14) >> 2
  Cx = (Ux + 2) >> 2
  for Ck = 0 to 2
    if CellDirt(Cx + Ck, Cy) = 1 then return 0
  next
  return 1

function CellDirt(u8 Cx, u8 Cy) as u8
  u8 Tc = 0
  u8 Bit = 0
  Tc = get char at Cx >> 1, Cy >> 1
  if Tc < TDirt0 or Tc > TDirt15 then return 0
  Bit = 1 << ((Cx & 1) + ((Cy & 1) << 1))
  if ((Tc - TDirt0) & Bit) <> 0 then return 1
  return 0

' a falling boulder squashes the trolls it touches and the digger
sub RockHits(u8 I):
  X = Rk[I].X
  Y = Rk[I].Y
  for Hi2 = 1 to 3
    if Act[Hi2].Live = 1 then
      if Near(X, Y, Act[Hi2].X, Act[Hi2].Y, 12) = 1 then
        Act[Hi2].Live = 0
        Act[Hi2].Poof = 30
        inc Kills
        Score += 10
        play sound SndSquash
        ShowStatus
      end if
    end if
  next
  if Near(X, Y, Act[0].X, Act[0].Y, 12) = 1 then Phase = 2
  return
end sub

function TouchTroll as u8
  for Ai = 1 to 3
    if Act[Ai].Live = 1 then
      if Near(Act[0].X, Act[0].Y, Act[Ai].X, Act[Ai].Y, 11) = 1 then return 1
    end if
  next
  return 0

' boulders that can still fall: not on the bottom
function RocksLeft as u8
  N = 0
  for Ri = 0 to 2
    if Rk[Ri].Y < RFloor then inc N
  next
  return N

' erase the earth cells under a creature's 12 x 12 body (x+2..x+13), a
' tile at a time; Digs counts the tiles changed
sub Dig(u8 Px, u8 Py):
  u8 Cx0 = 0
  u8 Cx1 = 0
  u8 Cy0 = 0
  u8 Cy1 = 0
  u8 C0 = 0
  u8 C1 = 0
  u8 R0 = 0
  u8 R1 = 0
  u8 Col = 0
  u8 Row = 0
  u8 Tc = 0
  u8 Hm = 0
  u8 Vm = 0
  u8 Cut = 0
  Digs = 0
  Cx0 = (Px + 2) >> 2
  Cx1 = (Px + 13) >> 2
  Cy0 = (Py + 2) >> 2
  Cy1 = (Py + 13) >> 2
  C0 = Cx0 >> 1
  C1 = Cx1 >> 1
  R0 = Cy0 >> 1
  R1 = Cy1 >> 1
  for Row = R0 to R1
    ' the cell rows of this tile row under the body: 3 top, 12 bottom
    Vm = 0
    if Row * 2 >= Cy0 then Vm = 3
    if Row * 2 + 1 <= Cy1 then Vm = Vm | 12
    for Col = C0 to C1
      Hm = 0
      if Col * 2 >= Cx0 then Hm = 5
      if Col * 2 + 1 <= Cx1 then Hm = Hm | 10
      Cut = Hm & Vm
      Tc = get char at Col, Row
      if Tc >= TDirt0 and Tc <= TDirt15 then
        Tc = Tc - TDirt0
        if (Tc & Cut) <> 0 then
          Tc = Tc & (Cut ^ 15)
          put char TDirt0 + Tc at Col, Row
          inc Digs
        end if
      end if
    next
  next
  return
end sub

' dig only when the body's cell box changed (a cell is 4 pixels)
sub DigMove(u8 Ox, u8 Oy, u8 Nx, u8 Ny):
  Digs = 0
  if ((Ox + 2) >> 2) <> ((Nx + 2) >> 2) or ((Ox + 13) >> 2) <> ((Nx + 13) >> 2) or ((Oy + 2) >> 2) <> ((Ny + 2) >> 2) or ((Oy + 13) >> 2) <> ((Ny + 13) >> 2) then
    Dig(Nx, Ny)
  end if
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  Score = 0
  Scr = 1
  return
end sub

sub NextScreen:
  Score += 100
  if Scr < 99 then inc Scr
  return
end sub

' ---------------------------------------------------------------------------
' input: both controllers together

sub GetInput:
  ReadPads
  J = Pads
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).button1 then T = T | 16
  if joypad(P).button2 then T = T | 32
  return T

' ---------------------------------------------------------------------------
' the end of a screen

' the digger blinks twice a second, then lies still
sub CaughtAnim:
  play sound SndCaught
  for Ti = 0 to 119
    Frame1
    V = Ti % 30
    if V < 15 or Ti >= 90 then
      DrawSprites
    else
      for Si = 0 to 2
        set sprite Si to 207,0,0,0
      next
      update sprites
    end if
  next
  return
end sub

sub ClearAnim:
  play sound SndClear
  print at 8,12, " SCREEN CLEARED "
  print at 8,13, "   100 POINTS   "
  ShowStatus
  for Ti = 1 to 60
    Pass2
    inc Anim
    MoveTrolls
    DrawSprites
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' rows 1-2 status, row 3 grass, rows 4-21 earth, a bedrock frame
sub DrawField:
  NewScreen
  fill TGrass count 28 at 2,3
  for Si = 4 to 21
    fill TDirt15 count 28 at 2,Si
    put char TBed at 0,Si
    put char TBed at 1,Si
    put char TBed at 30,Si
    put char TBed at 31,Si
  next
  fill TBed count 32 at 0,22
  fill TBed count 32 at 0,23
  return
end sub

' put earth rows 12-13 back after the SCREEN message (only the creatures'
' starting places are dug then)
sub RedrawRow12:
  for Si = 12 to 13
    for Ti = 2 to 29
      put char TDirt15 at Ti,Si
    next
  next
  ' and dig out again what the creatures and their tunnels need
  for Ti = 0 to 3
    if Act[Ti].Live = 1 then Dig(Act[Ti].X, Act[Ti].Y)
  next
  return
end sub

sub DrawSprites:
  u8 Fr = 0
  u8 Pb = 0
  u8 Sy = 0
  u8 Cc = 0
  Fr = (Anim >> 2) & 1
  Sy = Act[0].Y - 1
  if Face = 0 then
    Pb = SBody1 + Fr * 4
    set sprite 0 to Sy,Act[0].X,SHat,11
    set sprite 1 to Sy,Act[0].X,SFace,9
    set sprite 2 to Sy,Act[0].X,Pb,5
  else
    Pb = SBody1l + Fr * 4
    set sprite 0 to Sy,Act[0].X,SHatl,11
    set sprite 1 to Sy,Act[0].X,SFacel,9
    set sprite 2 to Sy,Act[0].X,Pb,5
  end if
  for Si = 1 to 3
    K = Si + 2
    if Act[Si].Live = 1 then
      Pb = STroll1 + Fr * 4
      Cc = TrollCol[Si - 1]
      Sy = Act[Si].Y - 1
      set sprite K to Sy,Act[Si].X,Pb,Cc
    else
      if Act[Si].Poof > 0 then
        Sy = Act[Si].Y - 1
        set sprite K to Sy,Act[Si].X,SPoof,15
      else
        set sprite K to 207,0,0,0
      end if
    end if
  next
  for Si = 0 to 2
    K = Si + 6
    Sy = Rk[Si].Y - 1
    if Rk[Si].St = 1 and (Anim & 2) <> 0 then
      set sprite K to Sy,Rk[Si].X,SShake,14
    else
      set sprite K to Sy,Rk[Si].X,SBoulder,14
    end if
  next
  update sprites
  return
end sub

' rows 1 and 2: score, trolls left, high score, screen
sub ShowStatus:
  print at 2,1, "SCORE"
  print Score at 8,1
  print at 17,1, "TROLLS"
  for Si = 1 to 3
    if Act[Si].Live = 1 then
      put char TThead at 23 + Si,1
    else
      put char 32 at 23 + Si,1
    end if
  next
  print at 2,2, "HI"
  print Hi at 8,2
  print at 17,2, "SCREEN " + digits$(Scr, 2)
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one pass of play every two frames (30 a second): when the pass ran into
' a new frame already, one wait is enough
sub Pass2:
  call asm DgLate
  if Late = 0 then Frame1
  Frame1
  inc Pass
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for K = 0 to NSpr - 1
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy DirtCol1 count 128 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy DirtCol2 count 128 to vram.color + 5120
  backdrop black
  ' each screen third its own colour table (the earth strata)
  call asm SetR3
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: DIGGER in boulder bricks, a miner and a troll in a tunnel, the
' high score, the tune once

sub TitlePage:
tp_top:
  Menu = 0
  NewScreen
  copy TitleMap count 224 to vram.name + 64
  fill TGrass count 28 at 2,12
  for Si = 13 to 16
    fill TDirt15 count 28 at 2,Si
  next
  fill TDirt0 count 24 at 4,14
  fill TDirt0 count 24 at 4,15
  print at 2,18, "DROP BOULDERS ON THE TROLLS"
  print at 11,19, "START"
  print at 11,20, "HOW TO PLAY"
  print at 11,21, "CREDITS"
  ShowMenu
  print at 9,22, "HI "
  print Hi at 12,22
  Act[0].X = 40
  Act[0].Y = 111
  Act[1].X = 200
  Act[1].Y = 111
  Face = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 576
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 63
tp_loop:
  Frame1
  inc Rs
  inc Anim
  ReadPads
  TitleDemo
  N = Pads & (Pads ^ OldPads)
  if (N & 3) > 0 then
    if (N & 1) > 0 then
      if Menu > 0 then dec Menu
    else
      if Menu < 2 then inc Menu
    end if
    ShowMenu
  end if
  if (N & 48) = 0 then goto tp_loop
  if Menu > 0 then
    stop sound SndTuneA
    stop sound SndTuneB
    mute all
    TzOn = 0
    HideSprites
    if Menu = 1 then HowToPage
    if Menu = 2 then CreditsPage
    goto tp_top
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

' the miner walks the tunnel to the right, the troll after him to the left
' and back
sub TitleDemo:
  u8 Fr = 0
  u8 Pb = 0
  Fr = (Anim >> 3) & 1
  if (Anim & 1) = 0 then
    if Face = 0 then
      inc Act[0].X
      dec Act[1].X
      if Act[0].X >= 150 then Face = 1
    else
      dec Act[0].X
      inc Act[1].X
      if Act[0].X <= 40 then Face = 0
    end if
  end if
  if Face = 0 then
    Pb = SBody1 + Fr * 4
    set sprite 0 to 110,Act[0].X,SHat,11
    set sprite 1 to 110,Act[0].X,SFace,9
    set sprite 2 to 110,Act[0].X,Pb,5
  else
    Pb = SBody1l + Fr * 4
    set sprite 0 to 110,Act[0].X,SHatl,11
    set sprite 1 to 110,Act[0].X,SFacel,9
    set sprite 2 to 110,Act[0].X,Pb,5
  end if
  Pb = STroll1 + Fr * 4
  set sprite 3 to 110,Act[1].X,Pb,2
  update sprites
  return
end sub

sub ShowMenu:
  for K = 19 to 21
    put char 32 at 9,K
  next
  K = Menu + 19
  put char 62 at 9,K
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back.
' Globals only here (this program has call asm subs).
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "DIG TUNNELS UNDER THE HILL."
    print at 2,4, "THREE TROLLS DIG AFTER YOU."
    print at 2,6, "STICK: THE WAY TO DIG (YOU"
    print at 2,7, "KEEP GOING THAT WAY)."
    print at 2,8, "LEFT BUTTON: STOP."
    print at 2,9, "RIGHT BUTTON: PAUSE."
    print at 2,11, "DIG AWAY THE EARTH UNDER A"
    print at 2,12, "BOULDER: IT SHAKES, THEN"
    print at 2,13, "FALLS AND SQUASHES ANY TROLL"
    print at 2,14, "IT MEETS."
    fill TGrass count 20 at 6,16
    for Si = 17 to 21
      fill TDirt15 count 20 at 6,Si
    next
    fill TDirt0 count 16 at 8,19
    fill TDirt0 count 16 at 8,20
    fill TDirt0 count 2 at 18,17
    fill TDirt0 count 2 at 18,18
    set sprite 0 to 151,72,SHat,11
    set sprite 1 to 151,72,SFace,9
    set sprite 2 to 151,72,SBody1,5
    set sprite 3 to 151,148,STroll1,2
    set sprite 4 to 135,144,SBoulder,14
  else
    print at 2,3, "A SQUASHED TROLL: 10 POINTS."
    print at 2,4, "ALL THREE GONE: 100 POINTS"
    print at 2,5, "AND THE NEXT SCREEN."
    print at 2,7, "THE GAME ENDS IF A TROLL"
    print at 2,8, "TOUCHES YOU, IF A BOULDER"
    print at 2,9, "FALLS ON YOU, OR IF EVERY"
    print at 2,10, "BOULDER IS ON THE BOTTOM."
    print at 2,12, "TIP: DIG UP TO JUST UNDER A"
    print at 2,13, "BOULDER AND WAIT. WHEN A"
    print at 2,14, "TROLL COMES, DIG THE LAST"
    print at 2,15, "BIT AND RUN AWAY: IT FOLLOWS"
    print at 2,16, "YOU RIGHT UNDER THE ROCK!"
    put char TThead at 13,19
    put char TThead at 15,19
    put char TThead at 17,19
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 63
  HWt = 0
ht_loop:
  Frame1
  ReadPads
  inc HWt
  if HWt >= 1800 then goto ht_done
  N = Pads & (Pads ^ OldPads)
  if (N & 48) = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
ht_done:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "DIGGER"
  print at 2,5, "BASED ON DIGGER, COMPUTE!'S"
  print at 2,6, "GAZETTE, MARCH 1985 (C64"
  print at 2,7, "AND VIC-20 MACHINE CODE;"
  print at 2,8, "NO AUTHOR NAMED ON THE"
  print at 2,9, "DISK)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: UNDER THE HILL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; DgLate: Late = 1 when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
DgLate:
  in a,($BF)
  rlca
  and 1
  ld (AMY_UVAR_Late),a
  ret
SetR3:
  ld bc,$03FF
  call WRITE_REGISTER
  ret
DgDig:
    db $00,$00,$A6,$01,$00,$00,$D7,$01,$10
DgRumble:
    db $00,$00,$57,$04,$00,$00,$76,$04,$00,$00,$57,$04,$00,$00,$76,$04,$00,$00,$67,$04,$10
DgThud:
    db $00,$00,$14,$02,$00,$00,$35,$03,$00,$00,$56,$04,$00,$00,$87,$06,$10
DgSquash:
    db $40,$7F,$20,$03,$40,$A9,$20,$03,$40,$FE,$30,$03,$40,$FC,$31,$06,$50
DgCaught:
    db $40,$D6,$10,$06,$40,$E2,$20,$06,$40,$F0,$20,$06,$40,$FE,$20,$06,$40,$0E,$31,$06,$40,$1D,$31,$14
    db $50
DgClear:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$20,$05,$40,$8F,$20,$04,$40,$6B,$20,$10
    db $50
DgStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$0C,$50
DgPick:
    db $40,$55,$40,$02,$50

DgSoundTable:
    dw DgTuneMel,$702B
    dw DgTuneBass,$7035
    dw DgDig,$703F
    dw DgRumble,$703F
    dw DgThud,$703F
    dw DgSquash,$7049
    dw DgCaught,$7049
    dw DgClear,$7049
    dw DgStart,$7049
    dw DgPick,$7049
; Under the Hill (original)
; Tiny Sound, 9 frames per step
DgTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$1C,$01,$1F,$01,$23,$01,$01,$01,$21,$01,$1F,$01
    db $1E,$01,$01,$01,$1C,$01,$1E,$01,$1F,$01,$21,$01,$23,$01,$01,$01
    db $01,$01,$26,$01,$24,$01,$23,$01,$21,$01,$1F,$01,$01,$01,$23,$01
    db $21,$01,$1E,$01,$1A,$01,$1C,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
DgTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$10,$01,$17,$01,$10,$01,$17,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$0B,$01,$12,$01
    db $0B,$01,$12,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$0C,$01,$13,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$10,$01,$17,$01,$10,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
