    db $C0,$5A,$F0,$48,$C0,$72,$F0,$24,$C0,$66,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$98,$F0,$24,$C0,$88,$F0,$48,$C0,$98,$F0,$24,$C0,$5A,$F0,$24
    db $C0,$88,$F0,$24,$C0,$66,$F0,$24,$C0,$72,$F0,$24,$C0,$66,$F0,$24
    db $C0,$5A,$F0,$48,$D8
SfxClick:
    db $00,$00,$15,$01,$02,$36,$02,$23,$11,$10
SfxTock:
    db $82,$55,$20,$02,$23,$11,$90
SfxLift:
    db $41,$2C,$31,$06,$11,$E2,$50
SfxMove:
    db $80,$39,$40,$02,$90
SfxRefuse:
    db $42,$57,$23,$05,$24,$11,$50
SfxAgain:
    db $42,$AA,$00,$08,$14,$22,$42,$8F,$00,$08,$14,$22,$42,$71,$00,$08
    db $14,$22,$42,$55,$00,$10,$14,$32,$50
SfxStart:
    db $42,$AA,$00,$0A,$14,$22,$42,$8F,$00,$0A,$14,$22,$42,$71,$00,$0A
    db $14,$22,$42,$55,$00,$1E,$14,$32,$50
SfxWin:
    db $42,$AA,$00,$0C,$14,$22,$42,$8F,$00,$0C,$14,$22,$42,$71,$00,$0C
    db $14,$22,$42,$55,$00,$0C,$14,$22,$66,$42,$71,$00,$0C,$14,$22,$42
    db $55,$00,$30,$14,$32,$50
SfxLose:
    db $42,$71,$00,$18,$14,$32,$42,$8F,$00,$18,$14,$32,$42,$AA,$00,$18
    db $14,$32,$42,$E2,$00,$18,$14,$32,$42,$53,$01,$40,$14,$32,$50
SfxDraw:
    db $42,$AA,$00,$12,$14,$32,$42,$E2,$00,$12,$14,$32,$42,$AA,$00,$12
    db $14,$32,$42,$71,$00,$30,$14,$32,$50
SfxSlide:
    db $02,$36,$03,$14,$21,$10
SfxSolved:
    db $42,$7F,$00,$0A,$14,$22,$42,$6B,$00,$0A,$14,$22,$42,$55,$00,$0A
    db $14,$22,$42,$40,$00,$0A,$14,$22,$65,$42,$55,$00,$0A,$14,$22,$42
    db $40,$00,$28,$14,$32,$50
SfxFlip:
    db $00,$00,$25,$01,$02,$44,$02,$23,$11,$10
  }
end sub

' ShellForce (called only when Keep[15] = 77, which never happens): uses what the games use from Amy's runtime
' (number printing, 8 and 16-bit division, the sprite flicker switch), so
' the runtime part of the fixed bank is the same in every compile
sub ShellForce:
  print Wt at 2,2 width 3
  print Wf at 2,2 width 5
  Wt = Tx / 6
  Wt = Tx % 6
  Wf = Wf / Rs
  sprites flicker off
  return
end sub

' the end of the fixed bank (its ret is at $BFFF): the games start at $C000
sub ShellEnd:
  return
  asm {
    ds $BFFF-$,$FF
  }
end sub

' ---- the gate: the first bytes of the bank ($C000), the shell calls it
sub GameGate:
  asm {
    jp AMY_UPROC_AwariMain
  }
end sub

' ---------------------------------------------------------------------------
' games/awari.alexis - AWARI, the African sowing game (module of THE
' THINKER'S CABINET). ColecoVision version of the Oric game by Jean-Francois
' Sehan ("L'Oric a l'affiche", Editions du P.S.I., 1984), Amy & Claude 2026.
' Entry: AwariMain (its card: START / LEVEL / HOW TO PLAY / BACK), returns
' to the cabinet's menu.
'
' THE GAME (as in the book): 14 cells. 1-6 are yours (bottom row, left to
' right), 7 your store (right), 8-13 the computer's (top row, right to
' left), 14 its store (left). Three seeds in every pit. A move takes all the
' seeds of one of your pits and sows them one by one in the next cells,
' counter-clockwise, through BOTH stores (a seed in a store belongs to that
' store's owner). Last seed in your own store: play again. No captures. The
' game ends when all six pits of either side are empty (checked before each
' move); the seeds left stay; the fuller store wins. The first game's
' starter is drawn; then the loser starts (a tie: drawn again). The wins of
' each side and the game number stay on screen.
'
' THE COMPUTER (the book's lines 890-1570, see transcription/awari/NOTES.md):
'   LV 1: the book's move, but half of its moves are drawn at random
'   LV 2: the book's move, a quarter drawn at random
'   LV 3: the book's move, 15 % drawn at random (v2: a smoother step)
'   LV 4: the book's move, 8 % drawn at random (v2.1)
'   LV 5: looks four moves ahead (minimax, a replay is a move too; the
'         leaf counts seeds in stores x3 plus replays set up for each side)
'         and keeps the book's move unless a move it sees is better by three
'         seeds or more. The search runs 3 positions a frame (no frame lost)
'         while the CPU's pointer "thinks".
'
' VARIANTS (listed for Amy):
' - The book replays the ORIC when its last seed lands in the PLAYER's store
'   too (line 550 tests A=7 for both sides); the text only speaks of your
'   own store. Here: your own store only, for both sides.
' - When the book's rules 5-6 find no move, its listing sows from a stale
'   cell (an empty pit, even the player's store); here: its first non-empty
'   pit from 13 down (the order the book scans in).
' - The listing's typos E/F (lines 560, 1770) read as E (see NOTES.md).
' - No name to type: "YOU" and "CPU". Joystick + button instead of keys 1-6.
' - A session tally (games won, game number) kept while the cartridge runs;
'   game over = a result panel, one press back to AWARI's card.
' - Soft-locks: none possible (every move sends seeds forward; a sowing that
'   does not reach a store lowers the seeds' total distance to the stores),
'   and a 250-move cap ends a game by the rules anyway.
' ---------------------------------------------------------------------------

' (the search's boards live in the shell's shared Scr[0..79])
' cells -> screen. Pits are 2 x 3 tiles, stores 2 x 8.
const AwRowCpu = 5       ' CPU pits rows 5-7
const AwRowYou = 12      ' your pits rows 12-14
const AwRowSt = 6        ' stores rows 6-13
const AwColL = 4         ' CPU store cols 4-5
const AwColR = 25        ' your store cols 25-26

u8 Bd[16]               ' the board, cells 1-14
u8 Tb[16]               ' scratch board (the book's G() + one sowing)
u8 AwH[16]              ' the book's H(): landing cell of each CPU move
u8 AwK[16]              ' the book's K(): replays it would set up
u8 SSide[5]
u8 SMv[5]
u8 SCur[5]
u8 SBest[5]
u8 RootV[16]
u8 Dp = 0
const DMax = 4
u8 SDone = 0
u8 BestMv = 0
u8 Lv = 0
u8 Turn = 0              ' 0 you, 1 CPU (the book's E)
u8 FirstT = 0            ' who starts the next game (2 = draw it)
u8 Sel = 0               ' your pointer: cell 1-6
u8 CSel = 0              ' the CPU's pointer: cell 8-13
u8 Cell = 0
u8 Land = 0
u8 Seeds = 0
u8 Again = 0
u8 WinsC = 0
u8 WinsY = 0
u8 GameN = 0
u8 MovesN = 0
u8 AwMenu = 0
u8 Ci = 0
u8 Cj = 0
u8 Ck = 0
u8 Cn = 0
u8 Cx = 0
u8 Cy = 0
u8 Pos = 0
u8 Left = 0
u8 Px = 0
u8 Py = 0
u8 Qx = 0
u8 Qy = 0
u8 Fx = 0
u8 Fy = 0
u8 Ft = 0
u8 Ix = 0
u8 Iy = 0
u8 Bs = 0
u8 Bn = 0
u8 Sd = 0
u8 Mv = 0
u8 Lo = 0
u8 Va = 0
u8 Kc = 0
u8 Kp = 0
u8 Ov = 0
u8 Bk = 0
u8 Zb = 0
u8 Ab = 0
u8 BkSave = 0
u16 Ev = 0
u8 DemoC = 0
u8 DemoT = 0
u8 Result = 0           ' 0 tie, 1 CPU, 2 you
const SowSpd = 8
u8 OnCard = 0
u8 Hand = 0
u8 Cap = 0
const SPF = 3           ' search positions a frame (LV 5)

' the hop of a seed in flight (8 frames)
data AwArc bytes 0,5,8,10,10,8,5,0

' ================================================================ entry
sub AwariMain:
  ' what survives a visit lives in the shell's Keep[0..4]
  Lv = Keep[0]
  FirstT = Keep[1]
  WinsC = Keep[2]
  WinsY = Keep[3]
  GameN = Keep[4]
  if Lv = 0 then
    Lv = 1
    FirstT = 2
    GameN = 1
  end if
aw_card:
  AwariCard
  if AwMenu = 3 then
    Keep[0] = Lv
    Keep[1] = FirstT
    Keep[2] = WinsC
    Keep[3] = WinsY
    Keep[4] = GameN
    return
  end if
  if AwMenu = 2 then
    AwHelp
    goto aw_card
  end if
  AwPlay
  goto aw_card
end sub

' ------------------------------------------------------------ tiles
sub AwTiles:
  fill mode 2 text color with $F0
  copy AwPat count AwBytes to vram.pattern + 1024
  copy AwPat count AwBytes to vram.pattern + 3072
  copy AwPat count AwBytes to vram.pattern + 5120
  copy AwCol count AwBytes to vram.color + 1024
  copy AwCol count AwBytes to vram.color + 3072
  copy AwCol count AwBytes to vram.color + 5120
  backdrop 12
  cls
  return
end sub

' the wood of cell Tx,Ty (a fixed 16 x 8 grain map) -> Cn
sub WoodAt:
  V = Ty & 7
  V = V << 4
  J = Tx & 15
  V += J
  Cn = WoodMap[V]
  Cn += AwWood0
  return
end sub

' the carved board: rows Cy..Ix (edges included), cols 2-28
sub DrawBoard:
  for Ty = Cy to Ix
    for Tx = 3 to 27
      WoodAt
      put char Cn at Tx,Ty
    next
    put char AwEl at 2,Ty
    put char AwEr at 28,Ty
  next
  fill AwEt count 25 at 3,Cy
  fill AwEb count 25 at 3,Ix
  put char AwEtl at 2,Cy
  put char AwEtr at 28,Cy
  put char AwEbl at 2,Ix
  put char AwEbr at 28,Ix
  ' brass fittings in the inner corners
  V = Cy + 1
  put char AwBrtl at 3,V
  put char AwBrtr at 27,V
  V = Ix - 1
  put char AwBrbl at 3,V
  put char AwBrbr at 27,V
  return
end sub

' ------------------------------------------------------------ cells
' Cell -> Cx,Cy (top-left tile) and Px,Py (the sprite position over it)
sub CellPlace:
  if Cell <= 6 then
    Cx = Cell * 3
    Cx += 4
    Cy = AwRowYou
    if OnCard = 1 then Cy = 9
  end if
  if Cell = 7 then
    Cx = AwColR
    Cy = AwRowSt
  end if
  if Cell >= 8 then
    if Cell <= 13 then
      Cx = 13 - Cell
      Cx = Cx * 3
      Cx += 7
      Cy = AwRowCpu
    end if
  end if
  if Cell = 14 then
    Cx = AwColL
    Cy = AwRowSt
  end if
  Px = Cx * 8
  Py = Cy * 8
  Py += 2
  if Cell = 7 then Py += 22
  if Cell = 14 then Py += 22
  return
end sub

' redraw Cell's stones and its count
sub DrawCell:
  CellPlace
  Seeds = Bd[Cell]
  Left = Seeds
  Cn = 3
  if Cell = 7 then Cn = 8
  if Cell = 14 then Cn = 8
  ' tile rows bottom-up, left then right (a pit shows 8 at most, a store
  ' 28: the printed count is the truth)
  Iy = Cy + Cn
  for Ci = 1 to Cn
    dec Iy
    Pos = 2
    if Ci = 1 then Pos = 4
    if Ci = Cn then Pos = 0
    for Cj = 0 to 1
      ' 2 pebbles a tile, 1 under the top rim or on the bottom lip
      Ck = Left
      Cap = 2
      if Pos <> 2 then Cap = 1
      if Ck > Cap then Ck = Cap
      Left -= Ck
      V = Pos + Cj
      V = V * 3
      V += Ck
      Ix = Cx + Cj
      put char AwP0n0 + V at Ix,Iy
    next
  next
  ' the count: above the CPU's pits and store, below yours
  if OnCard = 1 then return
  Iy = 16
  if Cell >= 8 then Iy = 3
  if Cell = 7 then Iy = 16
  print Seeds at Cx,Iy width 2
  return
end sub

sub DrawAll:
  for Cell = 1 to 14
    DrawCell
  next
  return
end sub

' ------------------------------------------------------------ HUD
'' row 20: the wins (trophies + counts); row 22: LV n, GAME n
' (row 1 stays free for the CPU's pointer)
sub AwHud:
  print at 2,22, "LV"
  print Lv at 4,22 width 1
  print at 21,22, "GAME"
  print GameN at 26,22 width 3
  put char AwHcpu at 2,20
  put char AwHtro at 3,20
  print WinsC at 4,20 width 3
  put char AwHyou at 23,20
  put char AwHtro at 24,20
  print WinsY at 25,20 width 3
  return
end sub

sub Say1:
  fill 32 count 24 at 4,18
  return
end sub

' ------------------------------------------------------------ the rules
sub NewBoard:
  for Ci = 1 to 13
    Bd[Ci] = 3
  next
  Bd[7] = 0
  Bd[14] = 0
  Bd[0] = 0
  Bd[15] = 0
  return
end sub

' Ov = 1 when all six pits of one side of board Scr[Bs..] are empty
sub OverAt:
  Ov = 0
  Va = 0
  for Ci = 1 to 6
    Ix = Bs + Ci
    Va += Scr[Ix]
  next
  if Va = 0 then Ov = 1
  Va = 0
  for Ci = 8 to 13
    Ix = Bs + Ci
    Va += Scr[Ix]
  next
  if Va = 0 then Ov = 1
  return
end sub

' sow cell Mv of board Scr[Bs..] -> Land
sub SowAt:
  Ix = Bs + Mv
  Bn = Scr[Ix]
  Scr[Ix] = 0
  Land = Mv
  while Bn > 0
    inc Land
    if Land = 15 then Land = 1
    Ix = Bs + Land
    Scr[Ix] = Scr[Ix] + 1
    dec Bn
  end while
  return
end sub

' one pass over board Scr[Bs..]: Ov = 1 when all six pits of one side are
' empty; Va = its leaf value: 128 + 3 x (CPU store - your store), plus the
' replays set up for the CPU, minus those set up for you (not at the end)
sub LeafAt:
  Va = 0
  Kp = 0
  Ix = Bs
  for Ci = 1 to 6
    inc Ix
    Cn = Scr[Ix]
    if Cn > 0 then
      Va = 1
      Cn += Ci
      if Cn = 7 then inc Kp
    end if
  next
  Ov = 0
  if Va = 0 then Ov = 1
  Va = 0
  Kc = 0
  inc Ix
  for Ci = 8 to 13
    inc Ix
    Cn = Scr[Ix]
    if Cn > 0 then
      Va = 1
      Cn += Ci
      if Cn = 14 then inc Kc
    end if
  next
  if Va = 0 then Ov = 1
  inc Ix
  Ev = Scr[Ix]
  Ev = Ev * 3
  Ev += 128
  Ix = Bs + 7
  Cn = Scr[Ix]
  Ev -= Cn
  Ev -= Cn
  Ev -= Cn
  if Ov = 0 then
    Ev += Kc
    Ev -= Kp
  end if
  Va = lowbyte Ev
  return
end sub

' ------------------------------------------------------------ the book's move
' (lines 900-1570) -> Bk. Tb is the book's G() and the sowing copy.
sub TbSow:
  for Ci = 0 to 15
    Tb[Ci] = Bd[Ci]
  next
  Bn = Tb[Mv]
  Tb[Mv] = 0
  Land = Mv
  while Bn > 0
    inc Land
    if Land = 15 then Land = 1
    Tb[Land] = Tb[Land] + 1
    dec Bn
  end while
  return
end sub

sub BookStart:
  Bk = 0
  if Bd[13] = 1 then Bk = 13
  if Bd[13] >= 3 then Bk = 13
  if Bk > 0 then return
  if Bd[12] >= 3 then
    Bk = 12
    return
  end if
  if Bd[11] >= 4 then
    Bk = 11
    return
  end if
  for Ci = 8 to 13
    AwH[Ci] = 0
    AwK[Ci] = 0
  next
  return
end sub

' one move Mv of the book's scan (13 down to 8; one a frame): straight into
' the store wins at once, else its landing cell and the replays it sets up
sub BookOne:
  if Bd[Mv] = 0 then return
  TbSow
  if Land = 14 then
    Bk = Mv
    return
  end if
  AwH[Mv] = Land
  for Cj = 9 to 13
    Va = Tb[Cj] + Cj
    if Va = 14 then AwK[Mv] = AwK[Mv] + 1
  next
  return
end sub

' the book's move, spread over frames: BookStart, BookOne x 6, BookEnd
sub BookThink:
  BookStart
  Mv = 13
  while Mv >= 8
    CpuFrame
    if Bk = 0 then BookOne
    dec Mv
  end while
  CpuFrame
  if Bk = 0 then BookEnd
  return
end sub

sub CpuFrame:
  Frame1
  Phase = 1
  CpuWander
  return
end sub

sub BookEnd:
  if Bd[12] >= 5 then
    Bk = 12
    return
  end if
  if Bd[8] = 1 then
    Bk = 8
    return
  end if
  if Bd[9] = 1 then
    Bk = 9
    return
  end if
  ' the move that sets up the most replays
  Zb = 0
  for Cj = 8 to 13
    if AwK[Cj] > Zb then
      Zb = AwK[Cj]
      Bk = Cj
    end if
  next
  if Bk > 0 then return
  ' the move whose last seed stays highest on its own side
  Zb = 8
  for Cj = 8 to 12
    Va = AwH[Cj]
    if Va > Zb then
      Zb = Va
      Bk = Cj
    end if
  next
  if Bk > 0 then return
  ' the move whose last seed lands lowest on your side
  Zb = 7
  for Cj = 8 to 13
    Va = AwH[Cj]
    if Va > 0 then
      if Va < Zb then
        Zb = Va
        Bk = Cj
      end if
    end if
  next
  if Bk > 0 then return
  ' (the listing sows a stale cell here) the first non-empty pit, 13 down
  Mv = 13
  while Mv >= 8
    if Bd[Mv] > 0 then
      if Bk = 0 then Bk = Mv
    end if
    dec Mv
  end while
  return
end sub

' a random non-empty CPU pit -> Bk
sub RandMove:
  Rnd
  Mv = R2 % 6
  Mv += 8
  while Bd[Mv] = 0
    inc Mv
    if Mv = 14 then Mv = 8
  end while
  Bk = Mv
  return
end sub

' ------------------------------------------------------------ LV 4: search
sub SearchInit:
  for Ci = 0 to 15
    Scr[Ci] = Bd[Ci]
    RootV[Ci] = 0
  next
  Dp = 0
  SSide[0] = 1
  SMv[0] = 13
  SBest[0] = 0
  BestMv = 0
  SDone = 0
  return
end sub

' a value Va for depth Ab's move SCur[Ab]
sub Incorp:
  if Ab = 0 then
    Ix = SCur[0]
    RootV[Ix] = Va
  end if
  if SSide[Ab] = 1 then
    if Va > SBest[Ab] then
      SBest[Ab] = Va
      if Ab = 0 then BestMv = SCur[0]
    end if
  else
    if Va < SBest[Ab] then SBest[Ab] = Va
  end if
  return
end sub

' one position of the search (a move tried, or a node finished)
sub SearchStep:
  Bs = Dp << 4
  Sd = SSide[Dp]
  Lo = 1
  if Sd = 1 then Lo = 8
  Mv = SMv[Dp]
  while Mv >= Lo
    Ix = Bs + Mv
    if Scr[Ix] > 0 then goto ss_found
    dec Mv
  end while
  ' no move left: this node is done
  Va = SBest[Dp]
  if Dp = 0 then
    SDone = 1
    return
  end if
  dec Dp
  Ab = Dp
  Incorp
  return
ss_found:
  Va = Mv - 1
  SMv[Dp] = Va
  SCur[Dp] = Mv
  ' copy the board one depth down, then sow there
  Iy = Bs + 16
  for Ci = 0 to 15
    Ix = Bs + Ci
    Va = Scr[Ix]
    Ix = Iy + Ci
    Scr[Ix] = Va
  next
  Bs = Iy
  SowAt
  Again = 0
  if Sd = 1 then
    if Land = 14 then Again = 1
  else
    if Land = 7 then Again = 1
  end if
  if Again = 0 then Sd = Sd ^ 1
  LeafAt
  Cn = Dp + 1
  if Cn >= DMax then Ov = 1
  if Ov = 1 then
    Ab = Dp
    Incorp
    return
  end if
  inc Dp
  SSide[Dp] = Sd
  if Sd = 1 then
    SMv[Dp] = 13
    SBest[Dp] = 0
  else
    SMv[Dp] = 6
    SBest[Dp] = 255
  end if
  return
end sub

' ------------------------------------------------------------ sprites
sub ShowPointers:
  ' yours below your pit (only on your turn), the CPU's above its pit
  if Turn = 0 then
    Cell = Sel
    CellPlace
    set sprite 0 to 135,Px,SpPu0,SpPuC0
  else
    set sprite 0 to 209,0,0,0
  end if
  if Turn = 1 then
    Cell = CSel
    CellPlace
    set sprite 1 to 6,Px,SpPd0,SpPdC0
  else
    set sprite 1 to 209,0,0,0
  end if
  return
end sub

sub NoFlyer:
  set sprite 2 to 209,0,0,0
  set sprite 3 to 209,0,0,0
  return
end sub

' ------------------------------------------------------------ sowing
' sow Cell for the side Turn, one seed at a time; Land = the last cell
sub SowAnim:
  Mv = Cell
  Hand = Bd[Cell]
  Bd[Cell] = 0
  Frame1
  Phase = 1
  DrawCell
  play sound SndLift
  ' the handful rises from the pit
  Qx = Px
  Qy = Py
  for Ft = 1 to 10
    Frame1
    Phase = 1
    V = Qy - Ft
    set sprite 2 to V,Qx,SpHd0,SpHdC0
    set sprite 3 to V,Qx,SpHd1,SpHdC1
    update sprites
  next
  Qy -= 10
  Land = Mv
  while Hand > 0
    inc Land
    if Land = 15 then Land = 1
    Cell = Land
    CellPlace
    ' fly from Qx,Qy to Px,Py in SowSpd frames, a hop on the way
    for Ft = 1 to SowSpd
      Frame1
      Phase = 1
      Ev = Ft
      if Px >= Qx then
        Ev = Px - Qx
        Ev = Ev * Ft
        Ev = Ev >> 3
        V = lowbyte Ev
        Fx = Qx + V
      else
        Ev = Qx - Px
        Ev = Ev * Ft
        Ev = Ev >> 3
        V = lowbyte Ev
        Fx = Qx - V
      end if
      if Py >= Qy then
        Ev = Py - Qy
        Ev = Ev * Ft
        Ev = Ev >> 3
        V = lowbyte Ev
        Fy = Qy + V
      else
        Ev = Qy - Py
        Ev = Ev * Ft
        Ev = Ev >> 3
        V = lowbyte Ev
        Fy = Qy - V
      end if
      V = Ft - 1
      Fy -= AwArc[V]
      set sprite 2 to Fy,Fx,SpSt0,SpStC0
      set sprite 3 to Fy,Fx,SpSt1,SpStC1
      update sprites
    next
    Frame1
    Phase = 1
    Bd[Land] = Bd[Land] + 1
    DrawCell
    play sound SndClick
    play sound SndTock
    Qx = Px
    Qy = Py
    dec Hand
  end while
  NoFlyer
  update sprites
  Cell = Land
  return
end sub

' ------------------------------------------------------------ a game
sub AwNewScreen:
  BlankScreen
  AwTiles
  Cy = 4
  Ix = 15
  DrawBoard
  ' the carved line between the two rows (the book's bar, char 97)
  fill AwMid count 17 at 7,9
  fill AwMid count 17 at 7,10
  DrawAll
  AwHud
  ShowScreen
  return
end sub

sub AwPlay:
  NewBoard
  AwNewScreen
  if FirstT = 2 then
    Rnd
    FirstT = R2 & 1
  end if
  Turn = FirstT
  Sel = 1
  CSel = 13
  MovesN = 0
  play sound SndStart
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
aw_turn:
  Frame1
  Phase = 1
  ' the end (the book's lines 400-470): one side has no seed left
  Bs = 0
  for Ci = 0 to 15
    Scr[Ci] = Bd[Ci]
  next
  OverAt
  if Ov = 1 then goto aw_end
  if MovesN >= 250 then goto aw_end
  inc MovesN
  if Turn = 0 then
    YourMove
  else
    CpuMove
  end if
  SowAnim
  Again = 0
  if Turn = 0 then
    if Land = 7 then Again = 1
  else
    if Land = 14 then Again = 1
  end if
  if Again = 1 then
    play sound SndAgain
    Say1
    if Turn = 0 then
      print at 9,18, "PLAY AGAIN!"
    else
      print at 9,18, "I PLAY AGAIN"
    end if
    for Wt = 1 to 40
      Frame1
      Phase = 1
    next
  else
    Turn = Turn ^ 1
  end if
  goto aw_turn
aw_end:
  Phase = 0
  StopMusic
  set sprite 0 to 209,0,0,0
  set sprite 1 to 209,0,0,0
  update sprites
  ' the book's lines 1700-1890
  Say1
  if Bd[14] > Bd[7] then
    Result = 1
    inc WinsC
    FirstT = 0
    print at 10,18, "I WIN!"
    play sound SndLose
  end if
  if Bd[14] < Bd[7] then
    Result = 2
    inc WinsY
    FirstT = 1
    print at 10,18, "YOU WIN!"
    play sound SndWin
  end if
  if Bd[14] = Bd[7] then
    Result = 0
    FirstT = 2
    print at 10,18, "A DRAW"
    play sound SndDraw
  end if
  ' the stores: CPU TO YOU
  print Bd[14] at 18,18 width 2
  print at 21,18, "TO"
  print Bd[7] at 24,18 width 2
  inc GameN
  AwHud
  for Wt = 1 to 90
    Frame1
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

' your move: left/right to a pit with seeds, a button to sow it
sub YourMove:
  Say1
  print at 11,18, "YOUR MOVE"
  if Bd[Sel] = 0 then
    Sel = 1
    while Bd[Sel] = 0
      inc Sel
    end while
  end if
  WaitIn = 1
ym_loop:
  Frame1
  Phase = 1
  ReadPad
  if StickHit = 1 then
    if Rt1 = 1 then
      Mv = Sel
      while Mv < 6
        inc Mv
        if Bd[Mv] > 0 then
          Sel = Mv
          Mv = 6
        end if
      end while
      play sound SndMove
    end if
    if Lf1 = 1 then
      Mv = Sel
      while Mv > 1
        dec Mv
        if Bd[Mv] > 0 then
          Sel = Mv
          Mv = 1
        end if
      end while
      play sound SndMove
    end if
  end if
  ShowPointers
  update sprites
  if Press = 0 then goto ym_loop
  WaitIn = 0
  Cell = Sel
  Say1
  return
end sub

' the CPU's move: think (the pointer wanders), then point and sow
sub CpuMove:
  Say1
  print at 12,18, "I THINK"
  BookThink
  if Lv = 5 then
    BkSave = Bk
    SearchInit
    while SDone = 0
      CpuFrame
      for Ck = 1 to SPF
        if SDone = 0 then SearchStep
      next
    end while
    Bk = BkSave
    Ix = BkSave
    Va = RootV[Ix] + 9
    if Va <= SBest[0] then Bk = BestMv
  else
    if Lv < 5 then
      Rnd
      V = R2 % 100
      Va = 50
      if Lv = 2 then Va = 25
      if Lv = 3 then Va = 15
      if Lv = 4 then Va = 8
      if V < Va then RandMove
    end if
    for Wt = 1 to 30
      CpuFrame
    next
  end if
  ' the pointer walks to the chosen pit
  while CSel <> Bk
    if CSel < Bk then
      inc CSel
    else
      dec CSel
    end if
    play sound SndMove
    for Wt = 1 to 8
      Frame1
      Phase = 1
      ShowPointers
      update sprites
    next
  end while
  Say1
  print at 10,18, "I PLAY"
  V = 14 - Bk
  print V at 17,18 width 1
  for Wt = 1 to 30
    Frame1
    Phase = 1
  next
  Cell = Bk
  Say1
  return
end sub

sub CpuWander:
  inc AnF
  V = AnF & 15
  if V = 0 then
    inc CSel
    if CSel > 13 then CSel = 8
  end if
  ShowPointers
  update sprites
  return
end sub

' ------------------------------------------------------------ AWARI's card
' logo, credit, a strip of six pits where a stone keeps being sown (the
' attract), the menu START / LEVEL < n > / HOW TO PLAY / BACK
sub AwariCard:
  BlankScreen
  AwTiles
  for Y = 0 to Logo3H - 1
    V = Y * Logo3W
    J = Y + 2
    put Logo3 + V count Logo3W at 11,J
  next
  print at 7,5, "ORIGINAL GAME BY"
  print at 6,6, "JEAN-FRANCOIS SEHAN"
  Cy = 8
  Ix = 12
  DrawBoard
  OnCard = 1
  for Cell = 1 to 6
    Bd[Cell] = 3
    DrawCell
  next
  print at 11,14, "START"
  print at 11,16, "LEVEL"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "BACK"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowLv
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  nmi off
  AwMenu = 0
  DemoT = 0
  DemoC = 1
  Phase = 3
  Rearm
  wait no fire
  WasBtn = 0
  nmi off
ac_loop:
  Frame1
  ReadPad
  Rnd
  inc AnF
  CardAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if AwMenu = 0 then
        AwMenu = 3
      else
        dec AwMenu
      end if
      play sound SndMove
    end if
    if Dn1 = 1 then
      inc AwMenu
      if AwMenu > 3 then AwMenu = 0
      play sound SndMove
    end if
    if AwMenu = 1 then
      if Lf1 = 1 then
        if Lv > 1 then dec Lv
      end if
      if Rt1 = 1 then
        if Lv < 5 then inc Lv
      end if
      ShowLv
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto ac_loop
  if AwMenu = 1 then goto ac_loop
  OnCard = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLv:
  print at 18,16, "< >"
  put char Lv + 48 at 19,16
  return
end sub

' the cursor; a stone hops from pit to pit along the strip (16 frames a hop)
sub CardAnim:
  V = AwMenu << 4
  V += 108
  set sprite 0 to V,70,SpCu0,SpCuC0
  set sprite 1 to V,70,SpCu1,SpCuC1
  inc DemoT
  if DemoT = 1 then
    if Bd[DemoC] = 0 then
      DemoT = 0
      inc DemoC
      if DemoC = 7 then DemoC = 1
      return
    end if
    Cell = DemoC
    Bd[Cell] = Bd[Cell] - 1
    DrawCell
    Qx = Px
    Qy = Py
  end if
  Cell = DemoC + 1
  if Cell = 7 then Cell = 1
  CellPlace
  Ft = DemoT >> 1
  Ev = Px
  if Px >= Qx then
    Ev = Px - Qx
    Ev = Ev * Ft
    Ev = Ev >> 3
    V = lowbyte Ev
    Fx = Qx + V
  else
    Ev = Qx - Px
    Ev = Ev * Ft
    Ev = Ev >> 3
    V = lowbyte Ev
    Fx = Qx - V
  end if
  V = Ft & 7
  Fy = Qy - AwArc[V]
  Fy -= 4
  set sprite 2 to Fy,Fx,SpSt0,SpStC0
  set sprite 3 to Fy,Fx,SpSt1,SpStC1
  update sprites
  if DemoT >= 16 then
    Bd[Cell] = Bd[Cell] + 1
    DrawCell
    DemoT = 0
    DemoC = Cell
    play sound SndTock
  end if
  return
end sub

sub AwHelp:
  BlankScreen
  AwTiles
  PageAwHelp1
  WaitPage
  BlankScreen
  AwTiles
  PageAwHelp2
  put char AwHstick at 3,9
  put char AwHbtn at 3,11
  put char AwHarr at 3,13
  put char AwHcpu at 2,15
  put char AwHyou at 3,15
  WaitPage
  return
end sub

' the end of this game's code in its bank (build.py: the literal pool after it
' starts at the same address in every bank, the shell's strings first)
sub AwEnd:
  return
  asm {
    ds $DC00-$,$FF
  }
end sub

u8 RamPadAwari[1]   ' build.py: same RAM end in every bank

' text pages (generated by _common/tools/textpages.py)
sub PageAwHelp1:
  print at 4,1, "AWARI  HOW TO PLAY  1/2"
  print at 2,3, "THE AFRICAN SOWING GAME."
  print at 2,4, "SIX PITS EACH, THREE SEEDS"
  print at 2,5, "IN EVERY PIT. MINE ARE ON"
  print at 2,6, "TOP, YOURS AT THE BOTTOM."
  print at 2,8, "TAKE ALL THE SEEDS OF ONE"
  print at 2,9, "OF YOUR PITS: THEY ARE SOWN"
  print at 2,10, "ONE BY ONE, COUNTER-"
  print at 2,11, "CLOCKWISE, THROUGH BOTH"
  print at 2,12, "STORES. A SEED IN A STORE"
  print at 2,13, "BELONGS TO THAT STORE."
  print at 2,15, "LAST SEED IN YOUR OWN"
  print at 2,16, "STORE: PLAY AGAIN!"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageAwHelp2:
  print at 4,1, "AWARI  HOW TO PLAY  2/2"
  print at 2,3, "WHEN ALL SIX PITS OF ONE"
  print at 2,4, "SIDE ARE EMPTY, THE GAME"
  print at 2,5, "ENDS. THE FULLER STORE"
  print at 2,6, "WINS. THE LOSER STARTS"
  print at 2,7, "THE NEXT GAME."
  print at 5,9, "JOYSTICK: CHOOSE A PIT"
  print at 5,11, "BUTTON: SOW ITS SEEDS"
  print at 5,13, "YOUR STORE: ON THE RIGHT"
  print at 5,15, "GAMES WON, CPU AND YOU"
  print at 2,17, "LV 1-4 PLAY LIKE THE BOOK"
  print at 2,18, "WITH LESS AND LESS CHANCE,"
  print at 2,19, "LV 5 THINKS MOVES AHEAD."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

