  print at 2,12, "MEMORY CARDS, SQUARE NIM:"
  print at 7,13, "ORIGINAL GAMES BY"
  print at 8,14, "CZES KOSNIOWSKI"
  print at 3,15, "(GAMES TO PLAY ON ORIC-1)"
  print at 6,17, "COLECOVISION VERSION"
  print at 7,18, "AMY & CLAUDE 2026"
  print at 2,19, "MADE IN AMY WITH AMY STUDIO"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

