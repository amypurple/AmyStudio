project "ADAM MULTIFILE ADVENTURE LAB"
cartridge "ADAM ADVENTURE LAB/AMY STUDIO/2026"

' Each embedded Amy file owns one subsystem. Open FILES to edit them independently.
include amy "@project/src/player.amy"
include amy "@project/src/scenes.amy"
include amy "@project/src/devices.amy"
ifdef ROM_TEST_CHECKPOINTS
  include amy "@project/src/tests.amy"
end ifdef

u8 LabChoice = 0

ifdef ROM_TEST_CHECKPOINTS
  Lab_RunSelfTests()
end ifdef

main_menu:
  text screen
  cls
  print centered at 1, "ADAM MULTIFILE LAB"
  print centered at 3, "ONE PROJECT - FOUR SOURCES"
  print at 4,7, "1  SPACE NAVIGATION"
  print at 4,10, "2  RESCUE ENCOUNTER"
  print at 4,13, "3  DEVICE CONSOLE"
  ifdef ROM_TEST_CHECKPOINTS
    if LabTestsPassed = 4 then
      print centered at 16, "SELF TESTS 4/4"
    else
      print centered at 16, "SELF TEST FAILURE"
    end if
  end ifdef
  print centered at 18, "SELECT 1-3"
  screen on
  choose keypad 1 to 3 into LabChoice
  wait key release

  select case LabChoice
  case 1
    Pilot_Run()
  case 2
    Scene_Run()
  case else
    Devices_Run()
  end select

  pause until press
  goto main_menu
