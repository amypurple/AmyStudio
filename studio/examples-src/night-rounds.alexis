' --- the thief -------------------------------------------------------------
' Tx, Ty his place (8.8 cells); TMode 0 to a gallery, 1 to a painting,
' 2 cutting it out, 3 back to the gallery's middle, 4 running away; TNode
' the node he walks to, TGoal the gallery of TSlot (his painting); TTimer
' the cutting time; TFlee the running time left; TSpd/TRun his speeds
u16 Tx = 0
u16 Ty = 0
u8 TMode = 0
u8 TNode = 0
u8 TGoal = 0
u8 TPrev = 0
u8 Fd = 0
u8 TSlot = 0
u8 TTimer = 0
u8 TFlee = 0
u8 TSpd = 0
u8 TRun = 0
u8 TSteal = 0
u8 TNear = 0
u8 TStartle = 0
u8 Heard = 0
u8 TgX = 0
u8 TgY = 0
u8 Arr = 0
u8 StepT = 0
u8 StepVol = 0
u8 Pose = 0
u8 PoseT = 0
u8 NN = 0
u8 NSl = 0
u8 Ks = 0
' what the view shows of him: ThOn drawn, ThLit in the torch's light,
' Visible on screen and not behind a wall, Noticed he saw you
u8 ThOn = 0
u8 ThLit = 0
u8 Visible = 0
u8 Noticed = 0
u8 ThY = 0
u8 ThX = 0
u8 ThC1 = 0
u8 ThC2 = 0
u8 Caught = 0
i16 Zf = 0
i16 Xl = 0
i16 Cs = 0
i16 Sn = 0
i16 Lp = 0
u8 FrPass = 0

' --- the game --------------------------------------------------------------
u16 Score = 0
u8 Lives = 0
u16 NightT = 0
u8 Survived = 0
u16 ShownScore = 0
u16 Bat = 0
u8 Spare = 0
u8 Night = 0
u8 Loot = 0
u8 LootMax = 0
u8 HoldT = 0
u8 Held = 0
u8 MsgT = 0
u8 BarShown = 0
u8 Tick = 0
u8 Idle = 0
u8 Menu = 0
u8 Page = 0
u8 TimedOut = 0
u16 Waited = 0

i16 Dx = 0
i16 Dy = 0
i16 Cx = 0
u16 Nx = 0
u16 Ny = 0
u16 NumU = 0
u16 V16 = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Rw = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Edge = 0
u8 WasJ = 0
u8 Jk = 0

  mode 2 screen
  sprites 16x16
  sprites double
  set sound table NrSoundTable areas 8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  ' a new game
  Score = 0
  Night = 1
  Lives = 3

night_loop:
  NightIntro
  NewNight
  State = StPlay
  GameTune
  Frame1
  call asm StPoll
  VbMiss = 0
  FrPass = 0

walk:
  ReadPad
  ' the button: a tap switches the torch, a hold shows the plan
  if Btn > 0 then
    inc HoldT
    if HoldT >= 8 then
      Held = 1
      HoldT = 0
      ShowPlan
      State = StPlay
    end if
  else
    if HoldT > 0 then
      if Held = 0 then ToggleTorch
    end if
    HoldT = 0
    Held = 0
  end if
  if Lf1 = 1 then Ang = Ang - 3
  if Rt1 = 1 then Ang = Ang + 3
  if Up1 = 1 then Advance(22, 0)
  if Dn1 = 1 then Advance(14, 1)
  ' the thief
  Prof = 6
  Thief
  Battery
  ' the rules of this pass are done (the bots read the state here)
  inc Tick
  ' the view
  Prof = 1
  call asm StRays
  Prof = 7
  Project
  Prof = 2
  call asm StDraw
  Prof = 3
  DrawThief
  Prof = 5
  Hud
  Prof = 0
  PassEnd
  if Caught = 1 then goto night_won
  if Loot >= LootMax then goto got_away
  inc NightT
  if NightT >= DawnPasses then goto dawn
  goto walk

dawn:
  ' dawn: the thief slips away with what he has; the night is survived
  State = StNext
  StopGameTune
  play sound SndSwap
  print at 12,1, "DAWN"
  Hold(60)
  V = LootMax - Loot
  NumU = V
  NumU = NumU * 100
  NumU = NumU + 300
  Score = Score + NumU
  TextScreen
  print at 11,5, "NIGHT"
  NumU = Night
  print at 17,5, digits$(NumU, 1)
  print at 5,8, "DAWN. HE SLIPPED AWAY,"
  print at 5,10, "BUT THE NIGHT IS SAFE."
  print at 4,13, "BONUS:"
  NumU = V
  NumU = NumU * 100
  NumU = NumU + 300
  print at 21,13, digits$(NumU, 4)
  print at 4,15, "SCORE:"
  NumU = Score
  print at 20,15, digits$(NumU, 5)
  print at 8,19, "PRESS THE BUTTON"
  Survived = 1
  State = StDawn
  PageWait
  inc Night
  if Night > 9 then Night = 9
  goto night_loop

night_won:
  ' you walked into him: the night is safe
  State = StCaught
  StopGameTune
  play sound SndCaught
  print at 12,1, "GOTCHA!"
  Hold(90)
  V = LootMax - Loot
  NumU = V
  NumU = NumU * 250
  NumU = NumU + 1000
  Score = Score + NumU
  State = StNext
  TextScreen
  print at 11,5, "NIGHT"
  NumU = Night
  print at 17,5, digits$(NumU, 1)
  print at 6,8, "YOU CAUGHT THE THIEF!"
  print at 4,11, "PAINTINGS SAVED:"
  V = MNSlots[MapNo]
  V = V - Loot
  NumU = V
  print at 21,11, digits$(NumU, 2)
  print at 4,13, "BONUS:"
  V = LootMax - Loot
  NumU = V
  NumU = NumU * 250
  NumU = NumU + 1000
  print at 21,13, digits$(NumU, 4)
  print at 4,15, "SCORE:"
  NumU = Score
  print at 20,15, digits$(NumU, 5)
  print at 8,19, "PRESS THE BUTTON"
  State = StCaught
  PageWait
  inc Night
  if Night > 9 then Night = 9
  goto night_loop

got_away:
  ' he got away with the night's limit
  State = StNext
  StopGameTune
  play sound SndOver
  print at 12,1, "HE GOT AWAY"
  Hold(90)
  dec Lives
  if Lives > 0 then
    ' a night lost, not the game: one cap less
    TextScreen
    print at 11,5, "NIGHT"
    NumU = Night
    print at 17,5, digits$(NumU, 1)
    print at 4,8, "THE THIEF GOT AWAY WITH"
    print at 4,10, "4 PAINTINGS."
    print at 4,12, "NIGHTS LEFT:"
    NumU = Lives
    print at 17,12, digits$(NumU, 1)
    print at 8,19, "PRESS THE BUTTON"
    Survived = 0
    State = StDawn
    PageWait
    inc Night
    if Night > 9 then Night = 9
    goto night_loop
  end if
  TextScreen
  print at 10,6, "GAME OVER"
  print at 3,9, "THE THIEF GOT AWAY WITH"
  NumU = Loot
  print at 3,11, digits$(NumU, 1)
  print at 5,11, "PAINTINGS ON NIGHT"
  NumU = Night
  print at 24,11, digits$(NumU, 1)
  print at 4,15, "SCORE:"
  NumU = Score
  print at 20,15, digits$(NumU, 5)
  print at 8,19, "PRESS THE BUTTON"
  ShowScreen
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' Advance(speed, back): forward (or back) along Ang, one axis at a time, so
' walls are slid along, not stuck to
sub Advance(u8 Sv, u8 Back):
  V = CosT[Ang]
  Dx = V
  if V > 127 then Dx = Dx - 256
  K = Ang - 64
  V = CosT[K]
  Dy = V
  if V > 127 then Dy = Dy - 256
  V16 = Sv
  Cx = V16
  Dx = Dx * Cx
  Dx = Dx >> 6
  Dy = Dy * Cx
  Dy = Dy >> 6
  if Back = 1 then
    Dx = 0 - Dx
    Dy = 0 - Dy
  end if
  ' x, with a margin of 3/16 of a cell
  Nx = Px + Dx
  Cx = 48
  if Dx < 0 then Cx = -48
  V16 = Nx + Cx
  Solid(V16, Py)
  if K = 0 then Px = Nx
  Ny = Py + Dy
  Cx = 48
  if Dy < 0 then Cx = -48
  V16 = Ny + Cx
  Solid(Px, V16)
  if K = 0 then Py = Ny
  return
end sub

' Solid(x, y): K = 1 if the cell of (x, y) is a wall
sub Solid(u16 Qx, u16 Qy):
  V = highbyte Qy
  Qc = V
  Qc = Qc << 5
  V = highbyte Qx
  Qc = Qc + V
  call asm StPeekMap
  K = 0
  if Pk <> 0 then K = 1
  return
end sub

' the torch: on or off (it needs charge)
sub ToggleTorch:
  if Torch = 1 then
    Torch = 0
    play sound SndTorchOff
  else
    if Bat > 0 then
      Torch = 1
      play sound SndTorchOn
    else
      play sound SndEmpty
    end if
  end if
  return
end sub

' the battery: one charge a view while the torch is on; an empty one is
' swapped for a spare, if any
sub Battery:
  if Torch = 1 then
    if Bat > 0 then dec Bat
    if Bat = 0 then
      if Spare > 0 then
        dec Spare
        Bat = BatFull
        play sound SndSwap
      else
        Torch = 0
        play sound SndEmpty
      end if
    end if
  end if
  return
end sub


' ---------------------------------------------------------------------------
' the thief

' NodeXY(n): TgX, TgY = the cell of node n
sub NodeXY(u8 Nd):
  Qc = 1344 + Nd
  call asm StPeekMap
  TgX = Pk
  Qc = 1376 + Nd
  call asm StPeekMap
  TgY = Pk
  return
end sub

' ChooseSlot: a painting still on its wall, at random; his goal is its
' gallery (TMode 0), or its place if he is in that gallery already
sub ChooseSlot:
  for J = 0 to 23
    Rnd16
    V16 = lowbyte Rw
    V16 = V16 * NSl
    Ks = highbyte V16
    IsStolen(Ks)
    if V = 0 then
      TSlot = Ks
      J = 23
    end if
  next
  Qc = 1280 + TSlot
  call asm StPeekMap
  TGoal = Pk
  call asm StBfs
  TMode = 0
  if TNode = TGoal then
    TMode = 1
  else
    NextHop
  end if
  return
end sub

' IsStolen(slot): V = 1 if that painting was cut out
sub IsStolen(u8 Sl):
  V = Sl >> 3
  K = Stolen[V]
  V = Sl & 7
  V = Bits[V]
  V = V & K
  if V <> 0 then V = 1
  return
end sub

' NextHop: TNode = the next node from TNode toward TGoal
sub NextHop:
  ' the neighbour one hop nearer his goal (BDist, from StBfs)
  V = BDist[TNode]
  V = V - 1
  Ks = TNode
  for J = 0 to 3
    Qc = Ks
    Qc = Qc << 2
    Qc = Qc + 1408
    Qc = Qc + J
    call asm StPeekMap
    K = Pk
    if K <> 255 then
      if BDist[K] = V then TNode = K
    end if
  next
  TPrev = Ks
  return
end sub

' Thief: one pass of his rules
sub Thief:
  ' his target point: a node, or the place in front of his painting
  if TMode = 1 then
    Qc = 1152 + TSlot
    call asm StPeekMap
    TgX = Pk
    Qc = 1216 + TSlot
    call asm StPeekMap
    TgY = Pk
  else
    NodeXY(TNode)
  end if
  Heard = 0
  if TMode = 5 then
    ' startled: a moment frozen, then he runs
    dec TTimer
    if TTimer = 0 then
      TMode = 4
      TFlee = 60
    end if
  end if
  if TMode = 2 then
    ' cutting the painting out (a faint sound of it every 8 passes)
    inc StepT
    if StepT >= 8 then
      StepT = 0
      Loudness
      if StepVol = 1 then play sound SndCut1
      if StepVol = 2 then play sound SndCut2
      if StepVol = 3 then play sound SndCut3
      if StepVol = 4 then play sound SndCut4
      Heard = StepVol
    end if
    dec TTimer
    if TTimer = 0 then
      V = TSlot >> 3
      K = TSlot & 7
      K = Bits[K]
      K = K | Stolen[V]
      Stolen[V] = K
      inc Loot
      BarShown = 255
      play sound SndStolen
      MsgT = 40
      print at 12,1, "STOLEN!"
      TMode = 3
      TNode = TGoal
    end if
  end if
  if TMode < 2 then GoOn
  if TMode = 3 then GoOn
  if TMode = 4 then GoOn
  if TMode = 4 then
    dec TFlee
    if TFlee = 0 then TMode = 0
  end if
  ' caught? (within 7/16 of a cell on both axes)
  Dx = Tx - Px
  Dy = Ty - Py
  Cx = abs(Dx)
  Lp = abs(Dy)
  if Cx < 112 then
    if Lp < 112 then Caught = 1
  end if
  ' he hears or sees you close by, whichever way you face (TNear in 1/16
  ' cells, Chebyshev)
  if Lp > Cx then Cx = Lp
  Cx = Cx >> 4
  Lp = TNear
  if Cx < Lp then Startle
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then print at 12,1, "            "
  end if
  return
end sub

' Startle: he noticed you: startled for a moment, then he runs (running
' already: he keeps running)
sub Startle:
  if TMode < 4 then
    play sound SndSeen
    ' away from you: his gallery's middle or the node he walks to,
    ' whichever is farther from you
    FarNode(TNode)
    K = Fd
    if TMode <> 0 then
      FarNode(TGoal)
      if Fd > K then TNode = TGoal
    else
      ' on a corridor: back to the node he came from if that is farther
      FarNode(TPrev)
      if Fd > K then
        K = TNode
        TNode = TPrev
        TPrev = K
      end if
    end if
    TMode = 5
    TTimer = TStartle
  end if
  if TMode = 4 then TFlee = 60
  return
end sub

' FarNode(n): Fd = the Chebyshev distance in cells from you to node n
sub FarNode(u8 Fn):
  NodeXY(Fn)
  V16 = Px >> 8
  X = lowbyte V16
  V16 = Py >> 8
  Y = lowbyte V16
  if TgX > X then
    V = TgX - X
  else
    V = X - TgX
  end if
  if TgY > Y then
    J = TgY - Y
  else
    J = Y - TgY
  end if
  if J > V then V = J
  Fd = V
  return
end sub

' GoOn: a step toward his target point, its footstep, the arrival
sub GoOn:
  V = TSpd
  if TMode = 4 then V = TRun
  MoveTo(V)
  Steps
  if Arr = 1 then Arrive
  return
end sub

' Loudness: StepVol = how loud he is from where you are: 1 (under 3
' cells, Chebyshev), 2 (under 6), 3 (under 10), 4 (under 24), 0 (silent)
sub Loudness:
  Dx = Tx - Px
  Dy = Ty - Py
  Cx = abs(Dx)
  Lp = abs(Dy)
  if Lp > Cx then Cx = Lp
  V16 = Cx
  V = highbyte V16
  StepVol = 0
  if V < 24 then StepVol = 4
  if V < 10 then StepVol = 3
  if V < 6 then StepVol = 2
  if V < 3 then StepVol = 1
  return
end sub

' Arrive: he reached his target point
sub Arrive:
  if TMode = 0 then
    if TNode = TGoal then
      TMode = 1
    else
      NextHop
    end if
  else
    if TMode = 1 then
      TMode = 2
      TTimer = TSteal
    else
      if TMode = 3 then
        ChooseSlot
      else
        ' running: the next node farthest from you
        Flee
      end if
    end if
  end if
  return
end sub

' Flee: TNode = the neighbour of TNode farthest from you (Chebyshev)
sub Flee:
  V16 = Px >> 8
  X = lowbyte V16
  V16 = Py >> 8
  Y = lowbyte V16
  ThX = 0
  ThY = TNode
  for I = 0 to 3
    Qc = TNode
    Qc = Qc << 2
    Qc = Qc + 1408
    Qc = Qc + I
    call asm StPeekMap
    K = Pk
    if K <> 255 then
      NodeXY(K)
      if TgX > X then
        V = TgX - X
      else
        V = X - TgX
      end if
      if TgY > Y then
        J = TgY - Y
      else
        J = Y - TgY
      end if
      if J > V then V = J
      if V >= ThX then
        ThX = V
        ThY = K
      end if
    end if
  next
  TPrev = TNode
  TNode = ThY
  return
end sub

' MoveTo(speed): toward (TgX, TgY)'s centre, each axis by up to the speed
' (diagonal first, then straight: never through a wall in a gallery);
' Arr = 1 when there
sub MoveTo(u8 Mv):
  Arr = 0
  V16 = TgX
  V16 = V16 << 8
  V16 = V16 + 128
  Dx = V16 - Tx
  Lp = Mv
  if Dx > Lp then
    Tx = Tx + Mv
  else
    Lp = 0 - Lp
    if Dx < Lp then
      Tx = Tx - Mv
    else
      Tx = V16
    end if
  end if
  V16 = TgY
  V16 = V16 << 8
  V16 = V16 + 128
  Dy = V16 - Ty
  Lp = Mv
  if Dy > Lp then
    Ty = Ty + Mv
  else
    Lp = 0 - Lp
    if Dy < Lp then
      Ty = Ty - Mv
    else
      Ty = V16
    end if
  end if
  if Ty = V16 then
    V16 = TgX
    V16 = V16 << 8
    V16 = V16 + 128
    if Tx = V16 then Arr = 1
  end if
  return
end sub

' Steps: his footsteps, louder the nearer he is (Chebyshev distance in
' cells: under 3, 6, 10, 16), every 6 passes sneaking, every 3 running
sub Steps:
  if StepT > 0 then dec StepT
  if StepT = 0 then
    StepT = 6
    if TMode = 4 then StepT = 3
    Loudness
    Heard = StepVol
    if TMode = 4 then
      if StepVol = 1 then play sound SndStepR1
      if StepVol = 2 then play sound SndStepR2
      if StepVol = 3 then play sound SndStepR3
      if StepVol = 4 then play sound SndStepR4
    else
      if StepVol = 1 then play sound SndStepN1
      if StepVol = 2 then play sound SndStepN2
      if StepVol = 3 then play sound SndStepN3
      if StepVol = 4 then play sound SndStepN4
    end if
  end if
  return
end sub

' Project: where the view shows him: depth Zf and side Xl (1/16 cells),
' his screen column, size and light; ThOn = 0 when not drawn
sub Project:
  ThOn = 0
  ThLit = 0
  Dx = Tx - Px
  Dy = Ty - Py
  Cx = abs(Dx)
  Lp = abs(Dy)
  if Cx < 2032 then
    if Lp < 2032 then ThOn = 1
  end if
  if ThOn = 1 then
    Dx = Dx >> 4
    Dy = Dy >> 4
    V = CosT[Ang]
    Cs = V
    if V > 127 then Cs = Cs - 256
    K = Ang - 64
    V = CosT[K]
    Sn = V
    if V > 127 then Sn = Sn - 256
    Zf = Dx * Cs
    Lp = Dy * Sn
    Zf = Zf + Lp
    Zf = Zf >> 6
    Xl = Dy * Cs
    Lp = Dx * Sn
    Xl = Xl - Lp
    Xl = Xl >> 6
    if Zf < 6 then ThOn = 0
  end if
  if ThOn = 1 then
    ' x on the view = 112 + Xl * 194 / Zf; the sprite (32 wide) starts 16
    ' to the left, on a whole tile column
    Lp = abs(Xl)
    Lp = Lp * 194
    Lp = Lp / Zf
    if Xl < 0 then Lp = 0 - Lp
    Lp = Lp + 100
    if Lp < 0 then ThOn = 0
    if Lp > 223 then ThOn = 0
  end if
  if ThOn = 1 then
    V16 = Lp
    V = lowbyte V16
    V = V >> 3
    ThCol = V + 2
    V16 = Zf
    if Zf > 255 then V16 = 255
    ThZ = lowbyte V16
    call asm StHgt
    V = ThH
    ThY = V + 95
    K = ThVar[V]
    ' his two bands (64-byte blocks of ThiefPat, art.py)
    V = Pose * 9
    V = V + K
    K = ThTop[V]
    V16 = K
    V16 = V16 << 6
    ThSrc = address of ThiefPat
    ThSrc = ThSrc + V16
    K = ThBot[V]
    V16 = K
    V16 = V16 << 6
    ThSrcB = address of ThiefPat
    ThSrcB = ThSrcB + V16
    ' lit by the torch (in its cone, within 7 cells), or a dim shape
    ' within 3 cells, else not seen
    ' (the sprite's middle is view column ThCol)
    V = ThCol
    if Torch = 1 then
      if ThZ < 112 then
        K = ConeT[V]
        if K > 0 then ThLit = 1
      end if
    end if
    if ThLit = 0 then
      if ThZ >= 48 then ThOn = 0
    end if
  end if
  return
end sub

' DrawThief: his patterns cut by the walls nearer than him (StThief), his
' four sprites; Visible when any column shows, Noticed when he sees you
sub DrawThief:
  Visible = 0
  Noticed = 0
  if ThOn = 1 then
    ThBuf = ThBuf ^ 1
    call asm StThief
    if ThVis > 0 then Visible = 1
  end if
  if Visible = 1 then
    ThC1 = 14
    ThC2 = 1
    if ThLit = 1 then ThC1 = 15
    V = ThCol << 3
    Y = ThY - 64
    ThP = ThBuf << 4
    set sprite 0 to Y,V,ThP,ThC1
    ThP = ThP + 4
    set sprite 1 to Y,V,ThP,ThC2
    Y = ThY - 32
    ThP = ThP + 4
    set sprite 2 to Y,V,ThP,ThC1
    ThP = ThP + 4
    set sprite 3 to Y,V,ThP,ThC2
    if ThLit = 1 then Noticed = 1
    if ThZ < TNear then Noticed = 1
  else
    for K = 0 to 3
      set sprite K to HideY,0,0,0
    next
  end if
  update sprites
  if Noticed = 1 then Startle
  ' his walk: the legs every 4 passes while he moves
  if TMode <> 2 then
    if TMode = 5 then PoseT = 0
    inc PoseT
    if PoseT >= 4 then
      PoseT = 0
      Pose = Pose ^ 1
    end if
  end if
  return
end sub

data Bits bytes 1, 2, 4, 8, 16, 32, 64, 128

' ---------------------------------------------------------------------------
' screens

' the night's museum: map, start, paintings all on their walls, batteries
sub NewNight:
  V = Night - 1
  if V > 2 then V = 2
  MapNo = V
  K = MStart[MapNo]
  Qc = 1344 + K
  call asm StPeekMap
  Px = Pk
  Px = Px << 8
  Px = Px + 128
  Qc = 1376 + K
  call asm StPeekMap
  Py = Pk
  Py = Py << 8
  Py = Py + 128
  Ang = 192
  for I = 0 to 7
    Stolen[I] = 0
  next
  Loot = 0
  LootMax = 4
  Torch = 0
  Bat = BatFull
  Spare = 4 - Night
  if Night > 3 then Spare = 1
  HoldT = 0
  Held = 0
  Caught = 0
  NightT = 0
  NN = MNNodes[MapNo]
  NSl = MNSlots[MapNo]
  ' the thief: quicker each night, quicker at cutting
  V = Night - 1
  if V > 6 then V = 6
  TSpd = V + 10
  TRun = V + 20
  TNear = V << 1
  TNear = TNear + 20
  TStartle = 14 - V
  TSteal = V << 3
  TSteal = 60 - TSteal
  if TSteal < 28 then TSteal = 28
  K = MThief[MapNo]
  TNode = K
  TPrev = K
  NodeXY(K)
  Tx = TgX
  Tx = Tx << 8
  Tx = Tx + 128
  Ty = TgY
  Ty = Ty << 8
  Ty = Ty + 128
  TFlee = 0
  StepT = 0
  StepVol = 0
  ChooseSlot
  PlayScreen
  return
end sub

' the play screen: the font, the shared tiles, the painting tiles in the
' middle third, the HUD
sub PlayScreen:
  TextScreen
  decompress zx0 PaintPatZ to vram.pattern + 2176
  decompress zx0 PaintColZ to vram.color + 2176
  for J = 8 to 15
    put char TBlank at 0,J
    put char TBlank at 1,J
    put char TBlank at 30,J
    put char TBlank at 31,J
  next
  BarShown = 255
  ShownScore = 65535
  HudAll
  call asm StRays
  call asm StDraw
  ShowScreen
  return
end sub

sub HudAll:
  print at 2,1, "NT"
  NumU = Night
  print at 5,1, digits$(NumU, 1)
  for K = 0 to 2
    X = K + 8
    V = TBlank
    if K < Lives then V = TCap
    put char V at X,1
  next
  Hud
  return
end sub

' the HUD: score, the battery bar (8 cells), spares, the stolen paintings
sub Hud:
  if Score <> ShownScore then
    ShownScore = Score
    NumU = Score
    print at 25,1, digits$(NumU, 5)
  end if
  V16 = Bat >> 6
  V = lowbyte V16
  if Bat > 0 then
    if V = 0 then V = 1
  end if
  if V <> BarShown then
    BarShown = V
    for K = 0 to 7
      X = K + 2
      if K < V then
        put char TBarfull at X,21
      else
        put char TBarempty at X,21
      end if
    next
    put char TBatcap at 10,21
    for K = 0 to 2
      X = K + 12
      if K < Spare then
        put char TSpare at X,21
      else
        put char TBlank at X,21
      end if
    next
    for K = 0 to 4
      X = K << 1
      X = X + 20
      if K < LootMax then
        if K < Loot then
          put char TLoot at X,21
        else
          put char TSafe at X,21
        end if
      end if
    next
  end if
  return
end sub

' the plan: the museum's walls, 2 x 2 cells a tile, and you (a sprite),
' while the button is held
sub ShowPlan:
  State = StPlan
  Frame1
  for J = 4 to 19
    fill TBlank count 28 at 2,J
  next
  for J = 0 to 15
    for I = 0 to 15
      ' the four cells of tile (I, J)
      V = 0
      X = I << 1
      Y = J << 1
      Qc = Y
      Qc = Qc << 5
      Qc = Qc + X
      call asm StPeekMap
      if Pk <> 0 then V = V | 1
      Qc = Qc + 1
      call asm StPeekMap
      if Pk <> 0 then V = V | 2
      Qc = Qc + 31
      call asm StPeekMap
      if Pk <> 0 then V = V | 4
      Qc = Qc + 1
      call asm StPeekMap
      if Pk <> 0 then V = V | 8
      V = V + TPl0
      X = I + 8
      Y = J + 4
      put char V at X,Y
    next
  next
  print at 12,1, "THE PLAN    "
  V16 = Px >> 6
  X = lowbyte V16
  X = X + 60
  V16 = Py >> 6
  Y = lowbyte V16
  Y = Y + 27
  set sprite 4 to Y,X,SYou,11
  update sprites
sp_hold:
  Frame1
  ReadPad
  if Btn > 0 then goto sp_hold
  set sprite 4 to HideY,0,0,0
  update sprites
  print at 12,1, "            "
  return
end sub

' the night's first page
sub NightIntro:
  State = StNext
  TextScreen
  print at 11,8, "NIGHT"
  NumU = Night
  print at 17,8, digits$(NumU, 1)
  print at 4,12, "THE THIEF IS INSIDE."
  print at 4,14, "LISTEN FOR HIS STEPS."
  print at 8,19, "PRESS THE BUTTON"
  State = StIntro
  PageWait
  return
end sub

' the title: name, menu (cursor back on START)
sub TitlePage:
  State = StNext
  ' the title picture (title.py: a Mode 2 bitmap with the menu drawn in
  ' it, ZX0-packed); the cursor is a sprite
  Rearm
  wait
  nmi off
  display off
  HideSprites
  picture screen
  sprites 16x16
  sprites double
  decompress zx0 TitleP to vram $0000
  decompress zx0 TitleC to vram $2000
  call asm StIdName
  backdrop black
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  if TuneOnce = 0 then
    ' the title tune, once (Rearm stops it after TuneFrames)
    play sound SndTuneA
    play sound SndTuneB
    play sound SndTuneC
    play sound SndTuneD
    TzLeft = TuneFrames
    TzOn = 1
  end if
  TuneOnce = 1
  WasBtn = 1
tp_loop:
  Frame1
  Rnd16
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu = 0 then
    StopTune
    mute all
    TuneOnce = 0
  end if
  V16 = Tick
  Rs = Rs ^ V16
  if Rs = 0 then Rs = $5A3C
  return
end sub

sub ShowMenu:
  V = Menu << 3
  V = V + 158
  set sprite 4 to V,82,SCursor,11
  update sprites
  return
end sub

sub CreditsPage:
  State = StNext
  TextScreen
  print at 9,2, "NIGHT ROUNDS"
  print at 2,5, "AN ORIGINAL GAME BY CLAUDE"
  print at 2,7, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,9, "2026."
  print at 2,12, "AMY LANGUAGE AND STUDIO BY"
  print at 2,14, "AMY BIENVENU."
  print at 2,17, "MUSIC: ORIGINAL TUNES."
  print at 8,21, "PRESS THE BUTTON"
  State = StCredits
  PageWait
  return
end sub

sub HowTo:
  State = StNext
  Page = 1
  TextScreen
  ' the picture, in the middle third: a painting of the game's own tiles
  ' and the thief's own sprites (StThief, nothing in front of him)
  decompress zx0 PaintPatZ to vram.pattern + 2176
  decompress zx0 PaintColZ to vram.color + 2176
  for J = 8 to 15
    fill TBlank count 32 at 0,J
  next
  fill TFt count 6 at 7,9
  fill TFb count 6 at 7,14
  for J = 0 to 3
    Y = J + 10
    put char TFs at 7,Y
    put char TFs at 12,Y
    for I = 0 to 3
      X = I + 8
      V = J << 2
      V = V + I
      V = V + PaintBase
      put char V at X,Y
    next
  next
  for J = 8 to 15
    fill TW2s count 8 at 16,J
  next
  ThCol = 18
  ThZ = 0
  ThBuf = 0
  for K = 0 to 27
    Zc[K] = 255
  next
  V = ThTop[1]
  V16 = V
  V16 = V16 << 6
  ThSrc = address of ThiefPat
  ThSrc = ThSrc + V16
  V = ThBot[1]
  V16 = V
  V16 = V16 << 6
  ThSrcB = address of ThiefPat
  ThSrcB = ThSrcB + V16
  call asm StThief
  set sprite 0 to 63,144,STh0,15
  set sprite 1 to 63,144,STh1,1
  set sprite 2 to 95,144,STh2,15
  set sprite 3 to 95,144,STh3,1
  update sprites
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "A THIEF IS CUTTING PICTURES"
  print at 2,5, "FROM THEIR FRAMES. CATCH HIM"
  print at 2,7, "BY WALKING INTO HIM."
  print at 2,17, "STICK: WALK AND TURN."
  print at 2,19, "TAP THE BUTTON: THE TORCH."
  print at 2,21, "HOLD IT: THE PLAN."
  ' (a state of its own: its picture uses painting tiles, codes 16-120)
  State = StHowPic
  PageWait
  if TimedOut = 0 then
    Page = 2
    State = StNext
    TextScreen
    print at 8,1, "HOW TO PLAY  2/2"
    print at 2,3, "HIS STEPS ARE LOUDER NEAR,"
    print at 2,5, "QUICKER WHEN HE RUNS. HE"
    print at 2,7, "SEES YOUR TORCH AND RUNS."
    for K = 0 to 7
      X = K + 2
      V = TBarfull
      if K > 5 then V = TBarempty
      put char V at X,10
    next
    put char TBatcap at 10,10
    put char TSpare at 12,10
    put char TSpare at 13,10
    print at 16,10, "BATTERIES"
    put char TLoot at 2,13
    put char TSafe at 4,13
    put char TSafe at 6,13
    put char TSafe at 8,13
    print at 12,13, "STOLEN: 1/4"
    print at 2,16, "IN THE DARK HE SEES YOU ONLY"
    print at 2,18, "CLOSE BY. HOLD ON TILL DAWN."
    print at 2,20, "3 LOST NIGHTS: GAME OVER."
    print at 8,22, "PRESS THE BUTTON"
    State = StHow
    PageWait
  end if
  HideSprites
  return
end sub

' a page: shown, then the button (a new press) or 30 s alone ends it
sub PageWait:
  ShowScreen
  WasBtn = 1
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub HideSprites:
  clear sprites
  set sprite count 5
  sprites flicker off
  for K = 0 to 4
    set sprite K to HideY,0,0,0
  next
  update sprites
  return
end sub

' every screen starts here: the font in all three thirds, the shared tiles
sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  mode 2 screen
  sprites 16x16
  sprites double
  load default ascii
  duplicate mode 2 patterns
  ' each third has its own colours: white text on black for codes 0-127
  fill $F1 count 1024 to vram.color
  fill $F1 count 1024 to vram.color + 2048
  fill $F1 count 1024 to vram.color + 4096
  ' the shared tiles (codes 128 and up), packed with ZX0 (pack.mjs)
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TileColZ to vram.color + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TileColZ to vram.color + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  decompress zx0 TileColZ to vram.color + 5120
  backdrop black
  fill 32 count 768 to vram.name
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub StopTune:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  TzOn = 0
  return
end sub

sub GameTune:
  play sound SndGameA
  play sound SndGameB
  return
end sub

sub StopGameTune:
  stop sound SndGameA
  stop sound SndGameB
  return
end sub

sub Rearm:
  ' a tune plays once: stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      StopTune
    end if
  end if
  nmi off
  nmi on
  return
end sub

' the end of a play pass: the NMI's work for each vblank the pass ran
' through (polled), then wait so that a pass lasts at least 3 frames; a
' longer pass does not wait for the next vblank (20 views a second at most)
sub PassEnd:
  call asm StPoll
  FrPass = FrPass + VbMiss
pe_soft:
  if VbMiss > 0 then
    call asm StSoftNmi
    dec VbMiss
    goto pe_soft
  end if
pe_wait:
  if FrPass < 3 then
    Rearm
    Idle = 1
    wait
    Idle = 0
    nmi off
    inc FrPass
    goto pe_wait
  end if
  FrPass = 0
  VbMiss = 0
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  ' one read of each controller (bits: 1 up, 2 right, 4 down, 8 left,
  ' 64 and 128 the buttons)
  V = joypad(1)
  K = joypad(2)
  V = V | K
  Up1 = V & 1
  K = V >> 1
  Rt1 = K & 1
  K = V >> 2
  Dn1 = K & 1
  K = V >> 3
  Lf1 = K & 1
  Btn = 0
  K = V & 192
  if K <> 0 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = Dn1 << 1
  Jk = Up1 | V
  K = WasJ ^ 3
  Edge = Jk & K
  WasJ = Jk
  return
end sub

' Rnd16: a 16-bit xorshift (7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

data SpritePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
