const StOver = 9
const StDawn = 10
const StHowPic = 12
const DawnPasses = 3000

u16 TzLeft = 0
u8 TzOn = 0
u8 TuneOnce = 0
u8 State = 0

' --- the ray caster (ray.asm) ----------------------------------------------
u16 Px = 0
u16 Py = 0
u8 Ang = 0
u8 Rcol = 0
u8 Ra = 0
u16 RdX = 0
u16 RdY = 0
u8 RstX = 0
u8 RstY = 0
