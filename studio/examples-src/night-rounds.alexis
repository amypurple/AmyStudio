    db $02,$60,$1A,$21,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $22,$00,$00,$00,$00,$00,$01,$01,$01,$01,$01,$01,$21,$00,$00,$00
    db $00,$00,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$1A,$00,$00,$00,$00,$00,$01,$01,$1E,$00,$00,$00
    db $00,$00,$00,$01
    db $FF
MwGameBass:
    db $84
    dw sndtiny_2
    db 10
    db $02,$70,$F1,$22,$07,$01,$01,$01,$01,$01,$01,$01,$07,$01,$01,$01
    db $01,$01,$01,$01,$07,$01,$01,$01,$01,$01,$01,$01,$07,$01,$01,$01
    db $01,$01,$01,$01,$05,$01,$01,$01,$01,$01,$01,$01,$05,$01,$01,$01
    db $01,$01,$01,$01,$06,$01,$01,$01,$01,$01,$01,$01,$06,$01,$01,$01
    db $06,$01,$01,$01
    db $FF

; StRays: Hc[0..27], Sc[0..27], Zc[0..27] (distance in 1/16 cells, at most
; 255) for the player at Px, Py (8.8 cells) facing Ang
StRays:
    ; the library's map
    ld a,(AMY_UVAR_MapNo)
    add a,a
    ld e,a
    ld d,0
    ld hl,StMapTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_MapBase),de
    xor a
    ld (AMY_UVAR_Rcol),a
StRayLoop:
    call StPoll
    ld a,(AMY_UVAR_Rcol)
    ld e,a
    ld d,0
    ld hl,StColOff
    add hl,de
    ld a,(AMY_UVAR_Ang)
    add a,(hl)
    ld (AMY_UVAR_Ra),a
    ; dX = Delta[a], dY = Delta[a - 64]
    ld l,a
    ld h,0
    add hl,hl
    ld de,StDelta
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_RdX),de
    ld a,(AMY_UVAR_Ra)
    sub 64
    ld l,a
    ld h,0
    add hl,hl
    ld de,StDelta
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_RdY),de
    ; x: cos < 0 for angles 65..191
    ld a,(AMY_UVAR_Ra)
    sub 65
    cp 127
    jr nc,StXPos
    ld a,$FF
    ld (AMY_UVAR_RstX),a
    ld a,(AMY_UVAR_Px)
    ld de,(AMY_UVAR_RdX)
    call StMulFD
    ld (AMY_UVAR_RsdX),hl
    jr StYDir
StXPos:
    ld a,1
    ld (AMY_UVAR_RstX),a
    ld a,(AMY_UVAR_Px)
    neg
    jr z,StXFull
    ld de,(AMY_UVAR_RdX)
    call StMulFD
    ld (AMY_UVAR_RsdX),hl
    jr StYDir
StXFull:
    ld hl,(AMY_UVAR_RdX)
    ld (AMY_UVAR_RsdX),hl
StYDir:
    ; y: sin < 0 for angles 129..255
    ld a,(AMY_UVAR_Ra)
    sub 129
    cp 127
    jr nc,StYPos
    ld a,$FF
    ld (AMY_UVAR_RstY),a
    ld a,(AMY_UVAR_Py)
    ld de,(AMY_UVAR_RdY)
    call StMulFD
    ld (AMY_UVAR_RsdY),hl
    jr StStart
StYPos:
    ld a,1
    ld (AMY_UVAR_RstY),a
    ld a,(AMY_UVAR_Py)
    neg
    jr z,StYFull
    ld de,(AMY_UVAR_RdY)
    call StMulFD
    ld (AMY_UVAR_RsdY),hl
    jr StStart
StYFull:
    ld hl,(AMY_UVAR_RdY)
    ld (AMY_UVAR_RsdY),hl
StStart:
    ; the DDA in registers: HL the map cell, DE the x step (+-1), BC the
    ; y step (+-16); in the other set HL' sdx, DE' sdy, BC' dX (dY in RAM)
    ld hl,(AMY_UVAR_RsdX)
    ld de,(AMY_UVAR_RsdY)
    ld bc,(AMY_UVAR_RdX)
    exx
    ld a,(AMY_UVAR_Py+1)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Px+1)
    ld e,a
    ld d,0
    add hl,de
    ld de,(AMY_UVAR_MapBase)
    add hl,de
    ld de,1
    ld a,(AMY_UVAR_RstX)
    or a
    jp p,StSxP
    ld de,-1
StSxP:
    ld bc,32
    ld a,(AMY_UVAR_RstY)
    or a
    jp p,StDda
    ld bc,-32
StDda:
    exx
    ld a,l
    sub e
    ld a,h
    sbc a,d
    jr nc,StStepY
    add hl,bc
    exx
    add hl,de
    ld a,(hl)
    or a
    jr z,StDda
    ld (AMY_UVAR_Rcell),hl
    ; an x side: the distance is sdx before its last step
    exx
    or a
    sbc hl,bc
    push hl
    exx
    pop hl
    xor a
    jr StHit
StStepY:
    push hl
    ld hl,(AMY_UVAR_RdY)
    add hl,de
    ex de,hl
    pop hl
    exx
    add hl,bc
    ld a,(hl)
    or a
    jr z,StDda
    ld (AMY_UVAR_Rcell),hl
    ; a y side
    exx
    ex de,hl
    ld de,(AMY_UVAR_RdY)
    or a
    sbc hl,de
    push hl
    exx
    pop hl
    ld a,1
StHit:
    ld (AMY_UVAR_Rside),a
    ; a painting here? (Rpc: 0 none, 1 its frame side, 2-5 its column u)
    push hl
    call StPaintHit
    pop hl
    ; the fish-eye: the distance in 1/8 cells (at most 255) times the
    ; column's cosine: one 8 x 8 product
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,h
    or a
    jr z,StFeOk
    ld l,255
StFeOk:
    ld a,(AMY_UVAR_Rcol)
    ld c,a
    ld b,0
    push hl
    ld hl,StCosOff
    add hl,bc
    ld e,(hl)
    pop hl
    ld h,l
    call StMul8
    ; HL = dist8 * cos: >> 7 gives the distance in 1/16 cells (at most 511)
    add hl,hl
    ld l,h
    ld h,0
    rl h
    ld a,h
    cp 2
    jr c,StIdxOk
    ld hl,511
StIdxOk:
    ; Zc[col] = min(255, it)
    ld a,(AMY_UVAR_Rcol)
    ld c,a
    ld b,0
    push hl
    ld a,h
    or a
    ld a,l
    jr z,StZOk
    ld a,255
StZOk:
    ld hl,AMY_UVAR_Zc
    add hl,bc
    ld (hl),a
    pop hl
    ; Hc[col] = Height[it]
    push hl
    ld de,StHeight
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Hc
    add hl,bc
    ld (hl),a
    pop hl
    ; Sc[col]: the level from the distance in 1/4 cells (at most 127)
    srl h
    rr l
    srl h
    rr l
    ld a,l
    cp 128
    jr c,StShOk
    ld a,127
StShOk:
    ld e,a
    ld d,0
    ; table (cone strength * 2 + side): cone 0 when the torch is off
    xor a
    ld hl,AMY_UVAR_Torch
    or (hl)
    jr z,StNoCone
    ld hl,StConeTab
    add hl,bc
    ld a,(hl)
StNoCone:
    add a,a
    push de
    ld e,a
    ld hl,StShadeTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    pop de
    add hl,de
    ld a,(hl)
    ; y-facing walls: one level darker (16 tiles a level), at most the last
    ld e,a
    ld a,(AMY_UVAR_Rside)
    or a
    ld a,e
    jr z,StShNs
    add a,16
    cp 177
    jr c,StShNs
    ld a,176
StShNs:
    ld hl,AMY_UVAR_Sc
    add hl,bc
    ld (hl),a
    ; the painting tile of this column (Pc, 0: none): bright under the
    ; torch's two nearest levels, dim beyond; a cut-out canvas if stolen
    ld e,a
    ld a,(AMY_UVAR_Rpc)
    or a
    jr z,StPcSet
    ld d,a
    ld a,e
    cp 160
    ld a,d
    jr nc,StPcDim
    dec a
    jr nz,StPcBu
    ld a,114
    jr StPcSet
StPcBu:
    call StIsStolen
    jr z,StPcPic
    ld a,119
    jr StPcSet
StPcPic:
    dec a
    ld e,a
    ld a,(AMY_UVAR_Rpic)
    add a,a
    add a,a
    add a,a
    add a,a
    add a,16
    add a,e
    jr StPcSet
StPcDim:
    dec a
    jr nz,StPcDu
    ld a,117
    jr StPcSet
StPcDu:
    call StIsStolen
    ld a,118
    jr z,StPcSet
    ld a,120
StPcSet:
    ld hl,AMY_UVAR_Pc
    add hl,bc
    ld (hl),a
    ; the next column
    ld a,(AMY_UVAR_Rcol)
    inc a
    ld (AMY_UVAR_Rcol),a
    cp 28
    jp nz,StRayLoop
    ret

; StPaintHit: Rpc = the painting code of the ray's hit (0 none): the wall
; cell carries painting slot v - 2 (v >= 2) on face SlotFace; the ray meets
; that face at a position along it (1/16 cells, mod 16) whose code comes
; from StFracN (or StFracR, mirrored, for the faces seen going -x or +y,
; so the painting's left is on the viewer's left). HL = the ray's length.
StPaintHit:
    xor a
    ld (AMY_UVAR_Rpc),a
    ld (AMY_UVAR_Rdist),hl
    ld hl,(AMY_UVAR_Rcell)
    ld a,(hl)
    sub 2
    ret c
    ld (AMY_UVAR_Rslot),a
    ; its face and picture: tables after the map grid (+1024, +1088)
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_MapBase)
    add hl,de
    ld de,1088
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Rpic),a
    ld de,-64
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Rface),a
    ld c,a
    ; the face the ray meets: side * 2, + 1 when it goes the negative way
    ld a,(AMY_UVAR_Rside)
    or a
    ld a,(AMY_UVAR_RstX)
    jr z,StPhX
    ld a,(AMY_UVAR_RstY)
StPhX:
    rlca
    and 1
    ld b,a
    ld a,(AMY_UVAR_Rside)
    add a,a
    add a,b
    cp c
    ret nz
StPhFound:
    ; where on the face: the position along it, in 1/16 cells, mod 16:
    ; (pos >> 4) +- (length >> 4) * |trig| >> 8 (sin for an x side,
    ; cos for a y side)
    ld hl,(AMY_UVAR_Rdist)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,h
    or a
    jr z,StPhD
    ld l,255
StPhD:
    ld a,(AMY_UVAR_Ra)
    ld c,a
    ld a,(AMY_UVAR_Rside)
    or a
    jr nz,StPhCos
    ; an x side: |sin|, the y position, + when 1 <= a <= 127
    ld a,c
    sub 64
    ld c,a
StPhCos:
    ; |cos(c)| from the table, its sign: + for c in 192..63
    push bc
    ld b,0
    ld h,l
    push hl
    ld hl,StAbsCos
    add hl,bc
    ld e,(hl)
    pop hl
    call StMul8
    pop bc
    ld e,h
    ; the position (>> 4, low byte)
    ld a,(AMY_UVAR_Rside)
    or a
    ld hl,(AMY_UVAR_Py)
    jr z,StPhPos
    ld hl,(AMY_UVAR_Px)
StPhPos:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ; the sign of the trig: cos(c) >= 0 when c + 64 < 128
    ld a,c
    add a,64
    cp 128
    ld a,l
    jr nc,StPhMinus
    add a,e
    jr StPhFrac
StPhMinus:
    sub e
StPhFrac:
    and 15
    ld e,a
    ld d,0
    ld a,(AMY_UVAR_Rface)
    dec a
    cp 2
    ld hl,StFracN
    jr nc,StPhNrm
    ld hl,StFracR
StPhNrm:
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Rpc),a
    ret

; StIsStolen: Z when painting Rslot is still on its wall (Stolen bit clear);
; keeps A, BC
StIsStolen:
    push bc
    push af
    ld a,(AMY_UVAR_Rslot)
    ld c,a
    rrca
    rrca
    rrca
    and 31
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_Stolen
    add hl,de
    ld b,(hl)
    ld a,c
    and 7
    ld e,a
    ld hl,StBits
    add hl,de
    ld a,(hl)
    and b
    ld e,a
    pop bc
    ld a,b
    pop bc
    inc e
    dec e
    ret

; StPeekMap: Pk = the cell Qc (0-1023) of library MapNo
StPeekMap:
    ld a,(AMY_UVAR_MapNo)
    add a,a
    ld e,a
    ld d,0
    ld hl,StMapTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld hl,(AMY_UVAR_Qc)
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Pk),a
    ret

; StMulFD: HL = A * DE >> 8 (A and DE unsigned, DE < $8000), with one 8 x 8
; product: DE >> 4 when it is below 16 cells (1/16 cell steps), else DE >> 8
StMulFD:
    ld h,a
    ld a,d
    cp 16
    jr nc,StMulBig
    ; (DE >> 4) * A >> 4
    ld a,e
    srl d
    rra
    srl d
    rra
    srl d
    rra
    srl d
    rra
    ld e,a
    call StMul8
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ret
StMulBig:
    ; (DE >> 8) * A
    ld e,d
    jp StMul8

; StMul8: HL = H * E, by quarter squares: (a+b)^2/4 - (a-b)^2/4
StMul8:
    ld a,h
    ld c,e
    ld l,a
    ld h,0
    ld d,0
    add hl,de
    add hl,hl
    ld de,StSq
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    push de
    sub c
    jr nc,StMulPos
    neg
StMulPos:
    ld l,a
    ld h,0
    add hl,hl
    ld de,StSq
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    pop hl
    or a
    sbc hl,de
    ret

; StDraw: the 16 view rows (screen rows 4-19, columns 2-29). First the
; top half of each column into Tb (8 rows of 28): ceiling down to the
; shelf's edge tile, then solid; then the 16 rows are sent from Tb, the
; bottom half through StMirror (ceiling -> floor, a top edge -> the bottom
; edge of the same depth, solid -> solid) read from the bottom up.
StDraw:
    push ix
    ld de,AMY_UVAR_Sc
    ld ix,AMY_UVAR_Tb+112
    ld hl,AMY_UVAR_Hc
    ld (AMY_UVAR_Rptr),hl
    ld hl,AMY_UVAR_Pc
    ld (AMY_UVAR_Rpptr),hl
    ld b,192
    ld a,28
    ld (AMY_UVAR_Rrow),a
StColLoop:
    ; HL = StColTab + 8 * h: the 8 tiles' offsets from the level's base
    ; (255: the ceiling)
    ld hl,(AMY_UVAR_Rptr)
    ld l,(hl)
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push de
    ld de,StColTab
    add hl,de
    pop de
    ld a,(de)
    ld c,a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix-112),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix-84),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix-56),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix-28),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix+0),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix+28),a
    ld a,(hl)
    inc hl
    add a,c
    ld (ix+56),a
    ld a,(hl)
    add a,c
    ld (ix+84),a
    ; a painting: K rows (StPaintK by the height) up from the horizon:
    ; K=1 frame; 2 v1, frame; 3 v1, v0, frame; 4 v1, v1, v0, frame (the
    ; rows below the horizon come out of StMirror: v1 -> v2, v0 -> v3,
    ; the top frame -> the bottom frame)
    push de
    ld hl,(AMY_UVAR_Rpptr)
    ld a,(hl)
    or a
    jr z,StPpNone
    push bc
    ld c,a
    ld hl,(AMY_UVAR_Rptr)
    ld l,(hl)
    ld h,0
    ld de,StPaintK
    add hl,de
    ld a,(hl)
    or a
    jr z,StPpDone
    ld b,a
    ld e,c
    ld d,0
    ld hl,StFrOf
    add hl,de
    ld a,(hl)
    ld hl,StV1Of
    add hl,de
    ld e,(hl)
    djnz StPk2
    ld (ix+84),a
    jr StPpDone
StPk2:
    djnz StPk3
    ld (ix+84),e
    ld (ix+56),a
    jr StPpDone
StPk3:
    djnz StPk4
    ld (ix+84),e
    ld (ix+56),c
    ld (ix+28),a
    jr StPpDone
StPk4:
    ld (ix+84),e
    ld (ix+56),e
    ld (ix+28),c
    ld (ix+0),a
StPpDone:
    pop bc
StPpNone:
    pop de
    ld hl,(AMY_UVAR_Rpptr)
    inc hl
    ld (AMY_UVAR_Rpptr),hl
    inc ix
    ld hl,(AMY_UVAR_Rptr)
    inc hl
    ld (AMY_UVAR_Rptr),hl
    inc de
    ld a,(AMY_UVAR_Rrow)
    dec a
    ld (AMY_UVAR_Rrow),a
    jp nz,StColLoop
    ; the 8 top rows
    xor a
    ld (AMY_UVAR_Rrow),a
    ld hl,AMY_UVAR_Tb
StTopRows:
    call StPoll
    push hl
    ld a,(AMY_UVAR_Rrow)
    call StRowAddr
    pop hl
    ld b,28
StTopOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz StTopOut
    ld a,(AMY_UVAR_Rrow)
    inc a
    ld (AMY_UVAR_Rrow),a
    cp 8
    jr nz,StTopRows
    ; the 8 bottom rows: Tb rows 7 down to 0, mirrored
    ld hl,AMY_UVAR_Tb+196
StBotRows:
    call StPoll
    push hl
    ld a,(AMY_UVAR_Rrow)
    call StRowAddr
    pop hl
    ld b,28
    ld d,StMirror/256
StBotOut:
    ld e,(hl)
    ld a,(de)
    out ($BE),a
    inc hl
    djnz StBotOut
    ld de,-56
    add hl,de
    ld a,(AMY_UVAR_Rrow)
    inc a
    ld (AMY_UVAR_Rrow),a
    cp 16
    jr nz,StBotRows
    pop ix
    ret

; StRowAddr: the VDP write address of view row A (screen row A + 4, column 2)
StRowAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,130
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ret

; StThief: the thief's 4 sprite patterns (64 bytes from ThSrc: top light,
; top dark; 64 from ThSrcB: bottom light, bottom dark) to VRAM patterns 0-12, each 8-pixel
; screen column (4 magnified pattern pixels: a nibble) kept only where the
; wall at that column is farther than the thief (Zc >= ThZ) and inside the
; view (screen columns 2-29). ThCol = the screen column of the sprite's
; left edge; ThVis = how many of its 4 columns show.
StThief:
    call StPoll
    ld a,(AMY_UVAR_ThCol)
    ld c,a
    ld b,4
    ld d,0
    ld e,0
StThCol:
    sla d
    ld a,c
    sub 2
    cp 28
    jr nc,StThHid
    ld hl,AMY_UVAR_Zc
    add a,l
    ld l,a
    jr nc,StThNc
    inc h
StThNc:
    ld a,(AMY_UVAR_ThZ)
    cp (hl)
    jr z,StThVis
    jr nc,StThHid
StThVis:
    inc d
    inc e
StThHid:
    inc c
    djnz StThCol
    ld a,e
    ld (AMY_UVAR_ThVis),a
    ; d: bit 3 = column 0 .. bit 0 = column 3 -> masks d (left), e (right)
    ld a,d
    ld e,0
    bit 1,a
    jr z,StThM1
    ld e,$F0
StThM1:
    bit 0,a
    jr z,StThM2
    set 0,e
    set 1,e
    set 2,e
    set 3,e
StThM2:
    ld d,0
    bit 3,a
    jr z,StThM3
    ld d,$F0
StThM3:
    bit 2,a
    jr z,StThM4
    set 0,d
    set 1,d
    set 2,d
    set 3,d
StThM4:
    ; the set not on screen: patterns 0-12 or 16-28 ($3800 or $3880)
    ld a,(AMY_UVAR_ThBuf)
    rrca
    and $80
    out ($BF),a
    ld a,$78
    out ($BF),a
    ld hl,(AMY_UVAR_ThSrc)
    call StThTwo
    ld hl,(AMY_UVAR_ThSrcB)
StThTwo:
    ld c,2
StThPat:
    ld b,16
StThL:
    ld a,(hl)
    and d
    out ($BE),a
    inc hl
    djnz StThL
    ld b,16
StThR:
    ld a,(hl)
    and e
    out ($BE),a
    inc hl
    djnz StThR
    dec c
    jr nz,StThPat
    ret

; StPoll: a vblank since the last look (the VDP status frame flag; the
; interrupt is off during a pass) -> VbMiss + 1. Keeps BC, DE, HL.
StPoll:
    in a,($BF)
    rlca
    ret nc
    ld a,(AMY_UVAR_VbMiss)
    inc a
    ld (AMY_UVAR_VbMiss),a
    ret

; StSoftNmi: one frame's NMI work done now (controllers, the frame
; counter, the sound), through Amy's own NMI body, for a vblank the pass
; ran through with the interrupt off: sound keeps its tempo and the pass
; need not wait for the next vblank.
StSoftNmi:
    push af
    jp AMY_NMI_CONTINUE

; StHgt: ThH = the wall's half height (StHeight) at depth ThZ
StHgt:
    ld a,(AMY_UVAR_ThZ)
    ld l,a
    ld h,0
    ld de,StHeight
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_ThH),a
    ret

; StIdName: the name table 0-255 three times (a Mode 2 picture); the
; display is off
StIdName:
    xor a
    out ($BF),a
    ld a,$58
    out ($BF),a
    ld c,3
StIdN1:
    ld b,0
    xor a
StIdN2:
    out ($BE),a
    inc a
    djnz StIdN2
    dec c
    jr nz,StIdN1
    ret

; StBfs: BDist[n] = hops from node n to TGoal over the museum's graph (Adj
; at +1408, 4 a node, 255 none), breadth first; the queue is Tb (free
; outside StDraw), its head and tail in Rpptr and Rptr. Replaces a next-hop
; table (N x N bytes a museum). Called when the thief picks a painting.
StBfs:
    ld a,(AMY_UVAR_MapNo)
    add a,a
    ld e,a
    ld d,0
    ld hl,StMapTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_MapBase),de
    ld hl,AMY_UVAR_BDist
    ld b,32
StBf0:
    ld (hl),255
    inc hl
    djnz StBf0
    ld a,(AMY_UVAR_TGoal)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_BDist
    add hl,de
    ld (hl),0
    ld hl,AMY_UVAR_Tb
    ld (hl),a
    ld (AMY_UVAR_Rpptr),hl
    inc hl
    ld (AMY_UVAR_Rptr),hl
StBfLoop:
    ld hl,(AMY_UVAR_Rpptr)
    ld de,(AMY_UVAR_Rptr)
    or a
    sbc hl,de
    ret z
    ld hl,(AMY_UVAR_Rpptr)
    ld a,(hl)
    inc hl
    ld (AMY_UVAR_Rpptr),hl
    ld c,a
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_BDist
    add hl,de
    ld a,(hl)
    inc a
    ld b,a
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    ld de,1408
    add hl,de
    ld de,(AMY_UVAR_MapBase)
    add hl,de
    ld c,4
StBfAdj:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StBfNx
    push hl
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_BDist
    add hl,de
    ld a,(hl)
    cp 255
    jr nz,StBfSeen
    ld (hl),b
    ld hl,(AMY_UVAR_Rptr)
    ld (hl),e
    inc hl
    ld (AMY_UVAR_Rptr),hl
StBfSeen:
    pop hl
StBfNx:
    dec c
    jr nz,StBfAdj
    jr StBfLoop

