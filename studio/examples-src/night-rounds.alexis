  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $C0,$F0,$F0,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $C0,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $60,$F0,$F0,$60,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data
data ThiefPat bytes
  $00,$00,$00,$00,$0F,$00,$06,$00,$0F,$07,$00,$00,$3F,$00,$7F,$00,$00,$00,$00,$00,$F0,$00,$60,$00,$F0,$E0,$00,$00,$FC,$00,$FE,$00
  $00,$07,$0F,$0F,$00,$0F,$09,$0F,$00,$00,$03,$1F,$00,$3F,$00,$7F,$00,$E0,$F0,$F0,$00,$F0,$90,$F0,$00,$00,$C0,$F8,$00,$FC,$00,$FE
  $6F,$00,$6F,$00,$60,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$F6,$00,$F6,$00,$06,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$6F,$00,$6F,$0F,$0F,$0F,$0E,$0E,$0E,$0E,$0E,$0E,$1E,$1E,$00,$00,$F6,$00,$F6,$F0,$F0,$F0,$70,$70,$70,$70,$70,$70,$78,$78,$00
