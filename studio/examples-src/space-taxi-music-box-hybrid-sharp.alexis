' Space Taxi music box with fragmented speech and music placeholders.
' Areas 1-4 are reserved for music. Areas 5-8 carry one spoken word.
' Gameplay table: music 1-6, selective stops, then spoken words.
' Presentation table: four-channel title/end music 7-8.
' Replace Music1Channel1 through Music8Channel4 with finished music data.
' Mute before switching tables so no old area retains a stale stream.

sub start:
  set sound table SpaceTaxiSoundTable areas 8
  text screen
  print centered at 4, "SPACE TAXI MUSIC BOX"
  print centered at 6, "HYBRID SHARP"
  print centered at 8, "1-9  PAD NUMBER PLEASE"
  print centered at 10, "UP   UP PLEASE"
  print centered at 12, "FIRE  HEY TAXI"
  print centered at 14, "FIRE 2  THANKS"
  print centered at 16, "* OR #  HEY"
  screen on

music_box:
  wait
  if joypad(1).button1.pressed then goto say_hey_taxi
  if joypad(1).button2.pressed then goto say_thanks
  if joypad(1).up.pressed then goto say_up_please
  if keypad(1) = 1 then goto say_pad_one
  if keypad(1) = 2 then goto say_pad_two
  if keypad(1) = 3 then goto say_pad_three
  if keypad(1) = 4 then goto say_pad_four
  if keypad(1) = 5 then goto say_pad_five
  if keypad(1) = 6 then goto say_pad_six
  if keypad(1) = 7 then goto say_pad_seven
  if keypad(1) = 8 then goto say_pad_eight
  if keypad(1) = 9 then goto say_pad_nine
  if keypad(1) = 10 then goto say_hey
  if keypad(1) = 11 then goto say_hey
  goto music_box

say_hey_taxi:
  play sounds 18,19,20
  wait 20 frames
  play sounds 21,22,23
  wait 52 frames
  goto wait_key_release

say_up_please:
  play sounds 54,55,56
  wait 20 frames
  goto say_please

say_thanks:
  play sounds 60,61,62
  wait 54 frames
  goto wait_key_release

say_hey:
  play sounds 18,19,20
  wait 20 frames
  goto wait_key_release

say_pad_one:
  play sounds 24,25,26
  wait 25 frames
  play sounds 27,28,29
  wait 26 frames
  goto say_please

say_pad_two:
  play sounds 24,25,26
  wait 25 frames
  play sounds 30,31,32
  wait 21 frames
  goto say_please

say_pad_three:
  play sounds 24,25,26
  wait 25 frames
  play sounds 33,34,35
  wait 26 frames
  goto say_please

say_pad_four:
  play sounds 24,25,26
  wait 25 frames
  play sounds 36,37,38
  wait 25 frames
  goto say_please

say_pad_five:
  play sounds 24,25,26
  wait 25 frames
  play sounds 39,40,41
  wait 27 frames
  goto say_please

say_pad_six:
  play sounds 24,25,26
  wait 25 frames
  play sounds 42,43,44
  wait 36 frames
  goto say_please

say_pad_seven:
  play sounds 24,25,26
  wait 25 frames
  play sounds 45,46,47
  wait 33 frames
  goto say_please

say_pad_eight:
  play sounds 24,25,26
  wait 25 frames
  play sounds 48,49,50
  wait 17 frames
  goto say_please

say_pad_nine:
  play sounds 24,25,26
  wait 25 frames
  play sounds 51,52,53
  wait 31 frames
  goto say_please

say_please:
  play sounds 57,58,59
  wait 49 frames

wait_key_release:
  wait
  if keypad(1) <> 255 then goto wait_key_release
  goto music_box
end sub

