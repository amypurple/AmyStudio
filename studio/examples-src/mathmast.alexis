cartridge "MATH MASTER/BOB LLORET/1984"

' MATH MASTER
' A ColecoVision game based on "Math Master" by Bob Lloret, Ahoy! May 1984
' (Commodore 64 BASIC, program page 65; disk ahoy1984-jan-jun, orig/).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: give your first name, pick a subject (addition, subtraction,
' multiplication or division) and a player level (ages 6 to 9, 10 to 14,
' 15 to adult), then answer ten problems against the clock, chalked on a
' blackboard. Each answer is right, wrong or too late; the game keeps the
' tally ("YOU NOW HAVE n CORRECT ANSWERS") and ends with the results: the
' score out of ten, the mark in per cent and the teacher's comment.
'
' From the original (orig/mathmast.bas): the name, the four subjects and
' the three levels; the numbers of each level (V = 10, 50, 100 and DIG = 1,
' 10, 25: addends and factors DIG..DIG+V-1; subtraction X = DIG+V..DIG+2V-1
' minus 1..V; division W x Y divided by Y, Y 1..10, answer W); the time
' limits (15, 12, 10 seconds); ten problems of one subject; CORRECT / SORRY,
' BUT THE ANSWER IS / time up with the name; the results page with the
' mark (C x 10 %) and the three comments (60 % or less: COME ON; up to 90 %:
' NOT BAD; 100 %: CONGRATULATIONS ... A PERFECT SCORE).
'
' Liberties:
' - The C64 typed answers; here the stick enters them on a row of digit
'   slots (up/down change the digit, left/right move, a button answers).
'   The number of slots is the most digits the subject and level can need
'   (2 to 5), and every slot starts at 0, so it tells nothing about this
'   problem. The original read three keys at most, so 4- and 5-digit
'   products could not be answered: now they can.
' - Entering with the stick is slower than typing: the time limit is the
'   original's plus 2 seconds a slot (for example 15 + 6 = 21 s).
' - Points as well as the tally: a right answer scores 10 x level plus the
'   seconds left; the best points of the session are kept on the title.
'   The original never reset its tally on TRY AGAIN (C kept growing): each
'   game starts from 0 here.
' - The first name is spelled with the stick (8 letters). No TRY AGAIN
'   question: the end message, a press, then the title (house rule).
' - The C64 border flashes and the CONGRATULATIONS flicker become a tick or
'   cross sprite, a star, jingles and a 1.5 Hz blink of the line.
'
' Controls: either controller. Menus: up/down choose, a button selects.
' Name and answers: up/down change the letter or digit (hold to repeat),
' left/right move between slots, a button enters.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes faster than 1.5 Hz.

const TGly0000 = 128
const TGly0001 = 129
const TGly0010 = 130
const TGly0011 = 131
const TGly0100 = 132
const TGly0101 = 133
const TGly0110 = 134
const TGly0111 = 135
const TGly0200 = 136
const TGly0201 = 137
const TGly0210 = 138
const TGly0211 = 139
const TGly0300 = 140
const TGly0301 = 141
const TGly0310 = 142
const TGly0311 = 143
const TGly0400 = 144
const TGly0401 = 145
const TGly0410 = 146
const TGly0411 = 147
const TGly0500 = 148
const TGly0501 = 149
const TGly0510 = 150
const TGly0511 = 151
const TGly0600 = 152
const TGly0601 = 153
const TGly0610 = 154
const TGly0611 = 155
const TGly0700 = 156
const TGly0701 = 157
const TGly0710 = 158
const TGly0711 = 159
const TGly0800 = 160
const TGly0801 = 161
const TGly0810 = 162
const TGly0811 = 163
const TGly0900 = 164
const TGly0901 = 165
const TGly0910 = 166
const TGly0911 = 167
const TGly1000 = 168
const TGly1001 = 169
const TGly1010 = 170
const TGly1011 = 171
const TGly1100 = 172
const TGly1101 = 173
const TGly1110 = 174
const TGly1111 = 175
const TGly1200 = 176
const TGly1201 = 177
const TGly1210 = 178
const TGly1211 = 179
const TGly1300 = 180
const TGly1301 = 181
const TGly1310 = 182
const TGly1311 = 183
const TGly1400 = 184
const TGly1401 = 185
const TGly1410 = 186
const TGly1411 = 187
const TGly1500 = 188
const TGly1501 = 189
const TGly1510 = 190
const TGly1511 = 191
const TBoard = 192
const TDust = 193
const TFh = 194
const TFv = 195
const TFtl = 196
const TFtr = 197
const TFbl = 198
const TFbr = 199
const TTray = 200
const TTrayc = 201
const TTrayd = 202
const TUline = 203
const TBarg = 204
const TBarr = 205
const TBare = 206
const TStar = 207
const TStare = 208
const TApple00 = 209
const TApple01 = 210
const TApple10 = 211
const TApple11 = 212
const TBooks00 = 213
const TBooks01 = 214
const TBooks10 = 215
const TBooks11 = 216
const SUp = 0
const SDown = 4
const SUpn = 8
const SDownn = 12
const SStar = 16
const SCheck = 20
const SCross = 24
const NTiles8 = 712
const SprBytes = 224
const TGly = 128
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndMove = 4
const SndTick = 5
const SndRight = 6
const SndWrong = 7
const SndTimeUp = 8
const SndStart = 9
const SndGood = 10
const SndPerfect = 11
const SndLow = 12
const NSpr = 4
const NProb = 10
const RepD = 18
const RepN = 7
const FbN = 150
const FbSkip = 40
const GlBlank = 16

' by level (index 0-2): V, DIG, seconds
data LvV bytes
  10, 50, 100
end data
data LvDig bytes
  1, 10, 25
end data
data LvT bytes
  15, 12, 10
end data
' answer slots by subject (0 +, 1 -, 2 x, 3 /) x 3 + level - 1
data SlotT bytes
  2, 3, 3,  2, 3, 3,  3, 4, 5,  2, 2, 3
end data
' glyph of each subject's sign
data OpGly bytes
  10, 11, 12, 13
end data

record Problem
  u16 X
  u16 Y
  u16 Ans
  u8 Op
end record

Problem Pb
' copies of the problem for the test bots (record fields have no symbol)
u16 PbX = 0
u16 PbY = 0
u16 PbAns = 0

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Given = 0
bcd digits 5 Pts
bcd digits 5 Best
' game: subject, level (1-3), problem number, right answers, outcome of
' the last problem (1 right, 2 wrong, 3 time up), the state for the bots
u8 Op = 0
u8 Lv = 1
u8 Pn = 0
u8 Right = 0
u8 Outc = 0
u8 GState = 0
' the name: letters (ASCII, 32 = space), its length
u8 Nm[8]
u8 NmLen = 0
' the entry row: slot values, slots, cursor, mode (0 digits, 1 letters),
' first column, done, repeat timer and the stick last frame
u8 Ent[8]
u8 NSl = 3
u8 Cur = 0
u8 EMode = 0
u8 ECol = 0
u8 ERow = 0
u8 EDone = 0
u8 RepT = 0
u8 LastDir = 0
' the clock: seconds left, frames left of this second, the limit
u8 Secs = 0
u8 Fr = 60
u8 TMax = 15
u8 Bonus = 0
' glyph row buffer
u8 Gl[12]
u8 Gn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Si = 0
u8 Li = 0
u8 Bk = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Pts = 0
  Best = 0
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NamePage
  ChooseSubject
  ChooseLevel
  PlayGame
  Results

  ' the end: back to the title on a press; left alone, Amy's sleep blanks
  ' the screen after 30 seconds to spare the TV, and a press wakes it
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the game

sub PlayGame:
  Pts = 0
  Right = 0
  Pn = 0
  K = Lv - 1
  V = Op * 3
  V = V + K
  NSl = SlotT[V]
  V = NSl << 1
  TMax = LvT[K] + V
  NewScreen
  DrawBoard
  ShowHud
  ShowScreen
  play sound SndStart
  for Pi = 1 to NProb
    Pn = Pi
    PlayProblem
  next
  return
end sub

' one problem: draw it, run the entry and the clock, judge, show the
' outcome for a while
sub PlayProblem:
  NewProblem
  Rearm
  wait
  nmi off
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  ClearBoard
  DrawProblem
  ShowHud
  EMode = 0
  for Si = 0 to 7
    Ent[Si] = 0
  next
  Cur = NSl - 1
  V = NSl
  ECol = 16 - V
  ERow = 11
  EDone = 0
  RepT = 0
  LastDir = 15
  DrawEntry
  for Si = 0 to 7
    J = NSl - 1
    if Si <= J then
      V = Si << 1
      V = V + ECol
      put char TUline at V,13
      inc V
      put char TUline at V,13
    end if
  next
  Secs = TMax
  Fr = 60
  DrawClock
  Outc = 0
  GState = 3
pp_loop:
  Frame1
  ReadPad
  EntryStep
  if EDone = 1 then
    Given = EntValue
    if Given = Pb.Ans then
      Outc = 1
    else
      Outc = 2
    end if
  else
    dec Fr
    if Fr = 0 then
      Fr = 60
      dec Secs
      DrawClock
      if Secs = 0 then
        Outc = 3
      elseif Secs <= 3 then
        play sound SndTick
      end if
    end if
  end if
  DrawCursor
  if Outc = 0 then goto pp_loop
  GState = 4
  Judge
  ' the outcome stays FbN frames; a press after FbSkip moves on
  for Si = 1 to FbN
    Frame1
    ReadPad
    if Si > FbSkip then
      if Press = 1 then Si = FbN
    end if
  next
  return
end sub

' the outcome of the problem: tally, points, message, sprite
sub Judge:
  HideCursor
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  select case Outc
  case 1
    inc Right
    Bonus = Lv * 10
    Bonus = Bonus + Secs
    Pts += Bonus
    V = NmLen + 9
    X = 32 - V
    X = X >> 1
    print at X,21, "CORRECT "
    V = X + 8
    PrintName(V, 21)
    V = V + NmLen
    print at V,21, "!"
    print at 4,22, "YOU NOW HAVE"
    NumU = Right
    print at 17,22, width$(NumU, 2)
    print at 20,22, "CORRECT"
    set sprite 0 to 63,208,SCheck,3
    set sprite 1 to 63,32,SStar,11
    play sound SndRight
  case 2
    V = NmLen + 7
    X = 32 - V
    X = X >> 1
    print at X,21, "SORRY "
    V = X + 6
    PrintName(V, 21)
    V = V + NmLen
    print at V,21, ","
    ShowAnswer
    set sprite 0 to 63,208,SCross,8
    play sound SndWrong
  case else
    V = NmLen + 13
    X = 32 - V
    X = X >> 1
    print at X,21, "TIME IS UP, "
    V = X + 12
    PrintName(V, 21)
    V = V + NmLen
    print at V,21, "!"
    ShowAnswer
    set sprite 0 to 63,208,SCross,8
    play sound SndTimeUp
  end select
  update sprites
  ShowHud
  return
end sub

sub ShowAnswer:
  K = NumDigits(Pb.Ans)
  V = 14 + K
  X = 32 - V
  X = X >> 1
  NumU = Pb.Ans
  print at X,22, "THE ANSWER IS " + str$(NumU)
  return
end sub

' the next problem from the original's formulas
sub NewProblem:
  K = Lv - 1
  V = LvV[K]
  C = LvDig[K]
  Pb.Op = Op
  select case Op
  case 0
    Pb.X = Rnd(V) + C
    Pb.Y = Rnd(V) + C
    Pb.Ans = Pb.X + Pb.Y
  case 1
    Pb.X = Rnd(V) + C + V
    Pb.Y = Rnd(V) + 1
    Pb.Ans = Pb.X - Pb.Y
  case 2
    Pb.X = Rnd(V) + C
    Pb.Y = Rnd(V) + C
    Pb.Ans = Pb.X * Pb.Y
  case else
    Pb.Ans = Rnd(V) + C
    Pb.Y = Rnd(10) + 1
    Pb.X = Pb.Ans * Pb.Y
  end select
  PbX = Pb.X
  PbY = Pb.Y
  PbAns = Pb.Ans
  return
end sub

' a random number 0..N-1 (16-bit xorshift)
function Rnd(u8 N) as u8
  u16 Q = 0
  Rand
  Q = Rs % N
  return Q

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function NumDigits(u16 Nv) as u8
  u8 D = 1
  while Nv >= 10
    Nv = Nv / 10
    inc D
  end while
  return D

' the number the slots spell
function EntValue as u16
  u16 Acc = 0
  u8 I = 0
  for I = 0 to 7
    if I < NSl then
      Acc = Acc * 10
      Acc = Acc + Ent[I]
    end if
  next
  return Acc

' ---------------------------------------------------------------------------
' the entry row (digits on the board or letters of the name)

sub EntryStep:
  V = J1 | J2
  V = V & 15
  K = 0
  if V = 0 then
    LastDir = 0
  elseif V <> LastDir then
    K = V
    RepT = RepD
    LastDir = V
  else
    dec RepT
    if RepT = 0 then
      K = V
      RepT = RepN
    end if
  end if
  if K > 0 then EntryMove(K)
  if Press = 1 then
    if EMode = 0 then
      EDone = 1
    elseif NmLenNow > 0 then
      EDone = 1
    end if
  end if
  return
end sub

' one move of the stick (1 up, 2 down, 4 left, 8 right; up/down first)
sub EntryMove(u8 Dir):
  u8 E = 0
  E = Ent[Cur]
  if Dir & 1 then
    if EMode = 0 then
      if E >= 9 then
        E = 0
      else
        inc E
      end if
    else
      select case E
      case 32
        E = 65
      case 90
        E = 32
      case else
        inc E
      end select
    end if
    Ent[Cur] = E
    DrawSlot(Cur)
    play sound SndClick
  elseif Dir & 2 then
    if EMode = 0 then
      if E = 0 then
        E = 9
      else
        dec E
      end if
    else
      select case E
      case 32
        E = 90
      case 65
        E = 32
      case else
        dec E
      end select
    end if
    Ent[Cur] = E
    DrawSlot(Cur)
    play sound SndClick
  elseif Dir & 4 then
    if Cur > 0 then
      dec Cur
      play sound SndMove
    end if
  elseif Dir & 8 then
    E = NSl - 1
    if Cur < E then
      inc Cur
      play sound SndMove
    end if
  end if
  return
end sub

' letters in the name up to the last non-space
function NmLenNow as u8
  u8 L = 0
  u8 I = 0
  for I = 0 to 7
    if Ent[I] <> 32 then L = I + 1
  next
  return L

sub DrawSlot(u8 S):
  u8 Cx = 0
  if EMode = 0 then
    Cx = S << 1
    Cx = Cx + ECol
    DrawGlyph(Ent[S], Cx, ERow)
  else
    Cx = ECol + S
    put char Ent[S] at Cx,ERow
  end if
  return
end sub

sub DrawEntry:
  for Li = 0 to 7
    if Li < NSl then DrawSlot(Li)
  next
  return
end sub

' the arrows above and below the slot being changed
sub DrawCursor:
  if EMode = 0 then
    X = Cur << 4
    V = ECol << 3
    X = X + V
    set sprite 2 to 77,X,SUp,11
    set sprite 3 to 104,X,SDown,11
  else
    X = ECol + Cur
    X = X << 3
    V = ERow << 3
    Y = V - 6
    set sprite 2 to Y,X,SUpn,11
    Y = V + 12
    set sprite 3 to Y,X,SDownn,11
  end if
  update sprites
  return
end sub

sub HideCursor:
  set sprite 2 to 192,0,0,0
  set sprite 3 to 192,0,0,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawGlyph(u8 G, u8 Cx, u8 Ry):
  u8 T = 0
  u8 Cr = 0
  Cr = Ry + 1
  if G = GlBlank then
    fill TBoard count 2 at Cx,Ry
    fill TBoard count 2 at Cx,Cr
  else
    T = G << 2
    T = T + TGly
    put char T at Cx,Ry
    inc T
    Cx = Cx + 1
    put char T at Cx,Ry
    inc T
    Cx = Cx - 1
    put char T at Cx,Cr
    inc T
    Cx = Cx + 1
    put char T at Cx,Cr
  end if
  return
end sub

' the glyphs of a number at the end of the row buffer
sub PushNum(u16 Nv):
  u8 Dg[5]
  u8 N = 0
  u8 I = 0
  N = 0
  while Nv >= 10
    W16 = Nv % 10
    Dg[N] = W16
    Nv = Nv / 10
    inc N
  end while
  Dg[N] = Nv
  for I = 0 to 4
    if I <= N then
      J = N - I
      Gl[Gn] = Dg[J]
      inc Gn
    end if
  next
  return
end sub

' the problem in big chalk, centred: X sign Y =
sub DrawProblem:
  Gn = 0
  PushNum(Pb.X)
  Gl[Gn] = OpGly[Pb.Op]
  inc Gn
  PushNum(Pb.Y)
  Gl[Gn] = 14
  inc Gn
  V = 16 - Gn
  for Li = 0 to 11
    if Li < Gn then
      K = Li << 1
      K = K + V
      DrawGlyph(Gl[Li], K, 7)
    end if
  next
  return
end sub

sub DrawClock:
  u8 Full = 0
  u8 T = TBarg
  print at 4,16, "TIME"
  NumU = Secs
  print at 9,16, width$(NumU, 2)
  W16 = Secs
  W16 = W16 << 4
  Full = W16 / TMax
  if Secs <= 3 then T = TBarr
  for Li = 0 to 15
    K = Li + 12
    if Li < Full then
      put char T at K,16
    else
      put char TBare at K,16
    end if
  next
  return
end sub

sub ShowHud:
  PrintName(2, 1)
  print at 21,1, "LEVEL"
  NumU = Lv
  print at 27,1, width$(NumU, 1)
  print at 2,2, "SCORE ", Pts
  print at 18,2, "RIGHT"
  NumU = Right
  print at 24,2, width$(NumU, 2)
  if Pn > 0 then
    select case Op
    case 0
      print at 4,5, "ADDITION      "
    case 1
      print at 4,5, "SUBTRACTION   "
    case 2
      print at 4,5, "MULTIPLICATION"
    case else
      print at 4,5, "DIVISION      "
    end select
    print at 20,5, "NO."
    NumU = Pn
    print at 24,5, width$(NumU, 2)
  end if
  return
end sub

sub PrintName(u8 Cx, u8 Ry):
  for Li = 0 to 7
    if Li < NmLen then
      put char Nm[Li] at Cx,Ry
      inc Cx
    end if
  next
  return
end sub

' the wooden frame (rows 3-19, columns 2-29) and the chalk tray
sub DrawBoard:
  put char TFtl at 2,3
  fill TFh count 26 at 3,3
  put char TFtr at 29,3
  for Li = 4 to 18
    put char TFv at 2,Li
    put char TFv at 29,Li
  next
  put char TFbl at 2,19
  fill TFh count 26 at 3,19
  put char TFbr at 29,19
  fill TTray count 22 at 4,20
  put char TTrayc at 8,20
  put char TTrayd at 22,20
  ClearBoard
  return
end sub

sub ClearBoard:
  for Li = 4 to 18
    fill TBoard count 26 at 3,Li
  next
  put char TDust at 6,14
  put char TDust at 23,9
  put char TDust at 17,17
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

' ---------------------------------------------------------------------------
' the pages before the game

sub NamePage:
  GState = 1
  NewScreen
  DrawBoard
  print at 9,5, "MATH  MASTER"
  print at 5,7, "WHAT IS YOUR FIRST NAME?"
  print at 6,14, "UP/DOWN:    LETTER"
  print at 6,15, "LEFT/RIGHT: MOVE"
  print at 6,16, "BUTTON:     DONE"
  EMode = 1
  NSl = 8
  ' start from the last name, or "A"
  for Si = 0 to 7
    if Si < NmLen then
      Ent[Si] = Nm[Si]
    else
      Ent[Si] = 32
    end if
  next
  if NmLen = 0 then Ent[0] = 65
  Cur = 0
  ECol = 12
  ERow = 10
  fill TUline count 8 at 12,11
  DrawEntry
  EDone = 0
  LastDir = 15
  DrawCursor
  ShowScreen
  Rearm
  wait no fire
  nmi off
np_loop:
  Frame1
  ReadPad
  EntryStep
  DrawCursor
  if EDone = 0 then goto np_loop
  NmLen = NmLenNow
  for Si = 0 to 7
    Nm[Si] = Ent[Si]
  next
  play sound SndStart
  HideSprites
  return
end sub

' a menu of N lines from row R0, two rows apart: returns 0..N-1
function MenuPick(u8 R0, u8 N) as u8
  u8 Sel = 0
  u8 Last = 0
  u8 Done = 0
  u8 Ry = 0
  while Done = 0
    Ry = Sel << 1
    Ry = Ry + R0
    Ry = Ry << 3
    Ry = Ry - 5
    set sprite 0 to Ry,40,SStar,11
    update sprites
    Frame1
    ReadPad
    V = J1 | J2
    V = V & 3
    if V <> WasStick then
      if V = 1 then
        if Sel > 0 then
          dec Sel
          play sound SndMove
        end if
      elseif V = 2 then
        Last = N - 1
        if Sel < Last then
          inc Sel
          play sound SndMove
        end if
      end if
    end if
    WasStick = V
    if Press = 1 then Done = 1
  end while
  play sound SndClick
  return Sel

sub ChooseSubject:
  GState = 2
  NewScreen
  DrawBoard
  PrintName(2, 1)
  print at 8,5, "CHOOSE A SUBJECT"
  print at 9,8, "ADDITION"
  print at 9,10, "SUBTRACTION"
  print at 9,12, "MULTIPLICATION"
  print at 9,14, "DIVISION"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Op = MenuPick(8, 4)
  HideSprites
  return
end sub

sub ChooseLevel:
  GState = 2
  NewScreen
  DrawBoard
  PrintName(2, 1)
  print at 10,5, "PLAYER LEVEL"
  print at 9,8, "AGES 6 TO 9"
  print at 9,10, "AGES 10 TO 14"
  print at 9,12, "AGES 15 TO ADULT"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  K = MenuPick(8, 3)
  Lv = K + 1
  HideSprites
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

' ---------------------------------------------------------------------------
' the results

sub Results:
  u8 P = 0
  GState = 5
  HideSprites
  NewScreen
  DrawBoard
  PrintName(2, 1)
  print at 2,2, "SCORE ", Pts
  print at 9,5, "R E S U L T S"
  print at 6,7, "YOU SCORED"
  NumU = Right
  print at 17,7, width$(NumU, 2)
  print at 20,7, "OUT OF"
  print at 11,8, "10 CORRECT"
  for Li = 0 to 9
    K = Li << 1
    K = K + 6
    if Li < Right then
      put char TStar at K,10
    else
      put char TStare at K,10
    end if
  next
  P = Right * 10
  NumU = P
  print at 5,12, "FOR A MARK OF"
  print at 19,12, width$(NumU, 3), "%"
  if P <= 60 then
    print at 6,15, "COME ON,"
    PrintName(15, 15)
    print at 6,16, "I KNOW YOU CAN DO"
    print at 6,17, "BETTER THAN THAT."
  elseif P <= 90 then
    print at 6,15, "NOT BAD,"
    PrintName(15, 15)
    print at 6,16, "I THINK YOU SHOULD"
    print at 6,17, "TRY A LITTLE HARDER."
  else
    print at 6,16, "YOU GOT A PERFECT"
    print at 6,17, "SCORE !!!"
  end if
  if Pts > Best then
    Best = Pts
    print at 8,22, "NEW BEST SCORE!"
  end if
  ShowScreen
  if P <= 60 then
    play sound SndLow
  elseif P <= 90 then
    play sound SndGood
  else
    ' the original's flickering CONGRATULATIONS: seven blinks at 1.5 Hz
    play sound SndPerfect
    for Bk = 1 to 14
      V = Bk & 1
      if V = 1 then
        print at 3,14, "CONGRATULATIONS"
        PrintName(19, 14)
      else
        fill 32 count 27 at 3,14
      end if
      Rearm
      wait 20 frames
      nmi off
    next
    print at 3,14, "CONGRATULATIONS"
    PrintName(19, 14)
  end if
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $FC
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the board, a sum in chalk, the tune once, START GAME / CREDITS
sub TitlePage:
  GState = 0
  Pn = 0
  NewScreen
  DrawBoard
  print at 9,5, "MATH  MASTER"
  print at 9,6, "------------"
  print at 9,18, "BY BOB LLORET"
  Gn = 0
  Gl[0] = 7
  Gl[1] = 12
  Gl[2] = 8
  Gl[3] = 14
  Gl[4] = 15
  Gn = 5
  for Li = 0 to 4
    K = Li << 1
    K = K + 11
    DrawGlyph(Gl[Li], K, 8)
  next
  print at 11,12, "START GAME"
  print at 11,14, "CREDITS"
  print at 9,16, "BEST"
  print at 14,16, Best
  print at 2,22, "AHOY! MAY 1984"
  put char TApple00 at 4,9
  put char TApple01 at 5,9
  put char TApple10 at 4,10
  put char TApple11 at 5,10
  put char TBooks00 at 25,9
  put char TBooks01 at 26,9
  put char TBooks10 at 25,10
  put char TBooks11 at 26,10
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
      play sound SndMove
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,12
  put char 32 at 9,14
  J = Menu << 1
  J = J + 12
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  GState = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "MATH  MASTER"
  print at 2,5, "BASED ON MATH MASTER"
  print at 2,6, "BY BOB LLORET, AHOY!"
  print at 2,7, "MAY 1984 (COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: TIMES TABLES RAG"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

