cartridge "BALLOON BLITZ/MICHAEL T. BOHN/1984"

' BALLOON BLITZ
' A ColecoVision game based on "Balloon Blitz", COMPUTE!'s Gazette
' August 1984 (Commodore 64 BASIC, and a VIC-20 version for +8K), by
' Michael T. Bohn (the name is not on the listing; credited by LaunchBox).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the C64
' listing, orig/bblitz64.bas), the game is built for the ColecoVision:
' smooth 16 x 16 sprites, tiled scenery, sound effects and an original
' title tune.
'
' The game: patrol the fields in a hot air balloon and bomb the enemy tank
' that drives along the ground below. Twenty bombs, one in the air at a
' time; each falls for about 0.7 seconds, so lead the tank. After every
' bomb the tank changes speed (and sometimes direction) at random and
' patrols a new stretch of the field, and the wind changes; the
' level (1-6, chosen on the title) sets how fast it can go. When the
' twenty bombs are gone your hits give your rank: PRIVATE (0-4),
' CORPORAL (5-9), SERGEANT (10-14), CAPTAIN (15-16), MAJOR (17-18),
' GENERAL (19-20).
'
' From the original: 20 bombs, one at a time, a bomb hits the tank or is a
' miss, the HITS / MISS / BOMBS LEFT counters, the balloon steered left
' and right at a chosen speed 1-9, the tank's speed drawn again after every
' bomb from INT(RND * DS) - SUB with the level's DS and SUB (level 1:
' 2, -1; 2: 3, 0; 3: 3, 1; 4: 4, 2; 5: 6, 3; 6: 7, 4), the tank moving
' 1.5 x that many pixels a pass (positive to the left), the bomb's fall of
' 12 passes, everything frozen while a hit tank explodes, the clouds
' drifting back and forth, the rank table (hits / 20 >= .95, .85, .75,
' .5, .25), the level menu 1-6.
'
' Liberties: the C64's BASIC passes (about 16 a second, estimated from
' the listing) are turned into smooth movement at 60 frames a second:
' tank 0.375 pixel a frame per speed step, bomb 2.5 pixels a frame,
' balloon speed / 7 pixels a frame. The speed is chosen with the stick
' (up faster, down slower) instead of the number keys, and starts at 5
' instead of 1. The balloon stops at the edges and the tank turns round
' there, instead of both wrapping round the screen (that would take them
' out of the TV-safe area). The level is chosen on the title (left and
' right) instead of by a key, and the best hits of the session are kept.
' The rank is shown steadily (the C64 flashed it). No "ANOTHER GAME?":
' a press goes back to the title, as every Amy game does.
' Against camping (in the original, and in a first version here, a
' balloon waiting in one place won: the tank kept coming back under it;
' a camping bot scored 17-19 of 20): after every bomb the tank patrols an
' 80-pixel stretch of field round where it is, a destroyed tank is
' replaced by a new one somewhere else on the field, and a wind (shown on
' the HUD, -1/4, 0 or +1/4 pixel a frame, new after every bomb) drifts
' the balloon.
'
' Controls: either controller; stick left / right steers, up / down sets
' the speed, a button drops a bomb. On the title: up / down choose, left /
' right set the level, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes faster than 3 Hz.

const THillul = 128
const THillur = 129
const THill = 130
const TPeakl = 131
const TPeakr = 132
const TTreet = 133
const TTreeb = 134
const TPlain = 135
const TGrass = 136
const TSoil = 137
const TCrater = 138
const SEnvelope = 0
const SStripe = 4
const SBasket = 8
const SBomb = 12
const STankl = 16
const STankr = 20
const STread0 = 24
const STread1 = 28
const SBoom0 = 32
const SBoom1 = 36
const SPuff = 40
const SCloudl = 44
const SCloudr = 48
const NTiles8 = 88
const SprBytes = 416
const SndTuneA = 1
const SndTuneB = 2
const SndDrop = 3
const SndBoom = 4
const SndThud = 5
const SndSpeed = 6
const SndStart = 7
const SndOver = 8
const NSpr = 9
const NBombs = 20
const BalY = 40
const BombY0 = 52
const BombFall = 40
const GroundY = 159
const TankY = 151
const TankMin = 256
const TankMax = 3584
const SegW = 1280
const BalMin = 256
const BalMax = 3584
const BoomN = 60
const PuffN = 24
const TzLen = 540

' the level's DS and SUB (index 1-6)
data DsT bytes
  0, 2, 3, 3, 4, 6, 7
end data
' SUB + 1 (level 1's SUB is -1)
data SubP1 bytes
  0, 0, 1, 2, 3, 4, 5
end data
' balloon speed in 1/16 pixel a frame (speed 1-9): speed / 7 pixel
data SpdT bytes
  0, 2, 5, 7, 9, 11, 14, 16, 18, 21
end data
data RankTxt chars
  "  PRIVATE  "
  " CORPORAL  "
  " SERGEANT  "
  "  CAPTAIN  "
  "   MAJOR   "
  "**GENERAL**"
end data

record Tank:
  i16 X
  i16 V
  u8 Face
  u8 Anim
end record

record Bomb:
  u8 Live
  u8 X
  u16 Y
end record

Tank Tk
Bomb Bm

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the balloon: x in 1/16 pixel, speed 1-9
u16 Bx = 1920
u8 Spd = 5
u8 Lv = 1
u8 Left = 20
u8 HitN = 0
bcd digits 2 Hits
bcd digits 2 Miss
bcd digits 2 Best
u8 D = 0
i8 Wind = 0
u8 Off = 0
i16 SegLo = 256
i16 SegHi = 3584
u8 BoomT = 0
u8 PuffT = 0
u8 PuffX = 0
u8 Cx = 60
i8 Cd = 1
u8 Over = 0
u8 TitleOn = 0
u8 Menu = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Ri = 0

  tile screen
  set sound table BzSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the rank, then back to the title on a press
  mute all
  if Hits > Best then Best = Hits
  ShowHud
  print at 9,8, "            "
  print at 9,9, " GAME  OVER "
  print at 9,10, "            "
  print at 6,12, "                   "
  print at 6,13, " RANK:             "
  K = RankOf(HitN)
  W16 = K * 11
  put RankTxt + W16 count 11 at 13,13
  print at 6,14, "                   "
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveBalloon
  if BoomT > 0 then
    dec BoomT
    if BoomT = 0 then
      ' the next tank comes on somewhere else on the field
      Off = RandBelow(209)
      Tk.X = Off * 16 + TankMin
      NewTankSpeed
    end if
    return
  end if
  MoveTank
  MoveClouds
  if PuffT > 0 then dec PuffT
  if Bm.Live = 1 then
    FallBomb
  else
    if Left = 0 then
      if PuffT = 0 then Over = 1
    elseif Press = 1 then
      DropBomb
    end if
  end if
  return
end sub

' the stick: left / right steer, up / down change the speed once a push
sub MoveBalloon:
  u16 Dx = 0
  K = J1 | J2
  Dx = SpdT[Spd]
  ' the wind drifts the balloon
  Bx = Bx + Wind
  if Bx < BalMin then Bx = BalMin
  if Bx > BalMax then Bx = BalMax
  V = K & 4
  if V > 0 then
    if Bx < BalMin + Dx then
      Bx = BalMin
    else
      Bx = Bx - Dx
    end if
  end if
  V = K & 8
  if V > 0 then
    Bx = Bx + Dx
    if Bx > BalMax then Bx = BalMax
  end if
  V = K & 3
  if V <> WasStick then
    if V = 1 then
      if Spd < 9 then
        inc Spd
        ShowSpeed
        play sound SndSpeed
      end if
    end if
    if V = 2 then
      if Spd > 1 then
        dec Spd
        ShowSpeed
        play sound SndSpeed
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub MoveTank:
  Tk.X = Tk.X + Tk.V
  if Tk.X < SegLo then
    Tk.X = SegLo
    Tk.V = 0 - Tk.V
  end if
  if Tk.X > SegHi then
    Tk.X = SegHi
    Tk.V = 0 - Tk.V
  end if
  if Tk.V < 0 then Tk.Face = 0
  if Tk.V > 0 then Tk.Face = 1
  if Tk.V <> 0 then inc Tk.Anim
  return
end sub

sub MoveClouds:
  V = Tick & 7
  if V = 0 then
    bounce Cx by Cd between 16 and 196
  end if
  return
end sub

sub DropBomb:
  dec Left
  Bm.Live = 1
  W16 = Bx >> 4
  Bm.X = W16
  Bm.Y = BombY0 << 4
  ShowHud
  play sound SndDrop
  return
end sub

' the bomb falls; it hits the tank's body or lands
sub FallBomb:
  u8 By = 0
  u8 Tx = 0
  Bm.Y += BombFall
  W16 = Bm.Y >> 4
  By = W16
  W16 = Tk.X >> 4
  Tx = W16
  if TankHit(Bm.X, By, Tx) = 1 then
    Bm.Live = 0
    inc Hits
    inc HitN
    BoomT = BoomN
    ShowHud
    play sound SndBoom
  elseif By >= GroundY then
    Bm.Live = 0
    inc Miss
    PuffT = PuffN
    PuffX = Bm.X
    ShowHud
    NewTankSpeed
    play sound SndThud
  end if
  return
end sub

' 1 when the bomb (pixels x+4..x+9, y..y+8) touches the tank's body
' (pixels x+1..x+14, rows 7..15 of its sprite)
function TankHit(u8 Bxp, u8 Byp, u8 Txp) as u8
  u8 R = 0
  if Byp + 8 >= TankY + 8 then
    if Bxp + 9 >= Txp + 1 then
      if Bxp + 4 <= Txp + 14 then R = 1
    end if
  end if
  return R

' the tank's new speed: D = INT(RND * DS) - SUB, 1.5 pixels a pass to the
' left for each step of D (6/16 pixel a frame here)
sub NewTankSpeed:
  i16 Dv = 0
  D = RandBelow(DsT[Lv])
  Dv = D + 1 - SubP1[Lv]
  ' (Dv * -6 in an expression is refused: bugs/bblitz-i16-mul-negative.alexis)
  Dv *= -6
  Tk.V = Dv
  ' its patrol: 80 pixels of the field round where it is
  Off = RandBelow(81)
  SegLo = Tk.X - Off * 16
  if SegLo < TankMin then SegLo = TankMin
  if SegLo > TankMax - SegW then SegLo = TankMax - SegW
  SegHi = SegLo + SegW
  ' and a new wind: -4, 0 or 4 sixteenths of a pixel a frame
  Wind = RandBelow(3) * 4 - 4
  ShowWind
  return
end sub

function RankOf(u8 H) as u8
  u8 R = 0
  select case H
  case 19 to 20
    R = 5
  case 17 to 18
    R = 4
  case 15 to 16
    R = 3
  case 10 to 14
    R = 2
  case 5 to 9
    R = 1
  case else
    R = 0
  end select
  return R

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandBelow(u8 N) as u8
  u8 R = 0
  Rand
  R = Rs & 255
  return R % N

' ---------------------------------------------------------------------------
' drawing

' 0-2 the balloon (stripes, envelope, basket), 3 the bomb, 4 explosion or
' puff, 5-6 the tank, 7-8 the cloud
sub DrawSprites:
  u8 Px = 0
  u8 Tx = 0
  u8 Pat = 0
  W16 = Bx >> 4
  Px = W16
  set sprite 0 to BalY,Px,SStripe,11
  set sprite 1 to BalY,Px,SEnvelope,8
  set sprite 2 to BalY,Px,SBasket,10
  if Bm.Live = 1 then
    W16 = Bm.Y >> 4
    Y = W16
    set sprite 3 to Y,Bm.X,SBomb,1
  else
    set sprite 3 to 192,0,0,0
  end if
  W16 = Tk.X >> 4
  Tx = W16
  if BoomT > 0 then
    ' the explosion changes every 10 frames (3 Hz)
    V = BoomT / 10
    V = V & 1
    if V = 0 then
      set sprite 4 to TankY,Tx,SBoom0,11
    else
      set sprite 4 to TankY,Tx,SBoom1,9
    end if
  elseif PuffT > 0 then
    Y = GroundY - 6
    set sprite 4 to Y,PuffX,SPuff,10
  else
    set sprite 4 to 192,0,0,0
  end if
  if TitleOn = 1 then
    set sprite 5 to 192,0,0,0
    set sprite 6 to 192,0,0,0
  else
    Pat = STankl
    if Tk.Face = 1 then Pat = STankr
    set sprite 5 to TankY,Tx,Pat,14
    V = Tk.Anim >> 2
    V = V & 1
    Pat = STread0
    if V = 1 then Pat = STread1
    set sprite 6 to TankY,Tx,Pat,1
  end if
  X = Cx + 13
  set sprite 7 to 22,Cx,SCloudl,15
  set sprite 8 to 22,X,SCloudr,15
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "BOMBS"
  NumU = Left
  print at 8,1, digits$(NumU, 2)
  print at 12,1, "HITS"
  print Hits at 17,1
  print at 21,1, "MISS"
  print Miss at 26,1
  ShowSpeed
  ShowWind
  return
end sub

sub ShowWind:
  print at 11,2, "WIND"
  select case Wind
  case 4
    print at 16,2, ">>"
  case 0
    print at 16,2, "--"
  case else
    print at 16,2, "<<"
  end select
  return
end sub

sub ShowSpeed:
  print at 2,2, "SPEED"
  NumU = Spd
  print at 8,2, digits$(NumU, 1)
  print at 21,2, "LEVEL"
  NumU = Lv
  print at 27,2, digits$(NumU, 1)
  return
end sub

' the scenery: hills and trees (rows 12-20), the field (21), soil (22-23)
sub DrawScene(u8 From):
  for Ri = From to 8
    W16 = Ri * 32
    Y = Ri + 12
    put SceneMap + W16 count 32 at 0,Y
  next
  fill TGrass count 32 at 0,21
  fill TSoil count 64 at 0,22
  return
end sub

sub NewGame:
  Left = NBombs
  Hits = 0
  Miss = 0
  HitN = 0
  Bx = 1920
  Spd = 5
  Bm.Live = 0
  BoomT = 0
  PuffT = 0
  Over = 0
  TitleOn = 0
  Tk.X = 2400
  Tk.Anim = 0
  Tk.Face = 0
  NewTankSpeed
  Wind = 0
  NewScreen
  DrawScene(0)
  ShowHud
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F5
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop light blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the scene, the balloon drifting, the tune once; START GAME,
' LEVEL n (left / right), CREDITS
sub TitlePage:
  NewScreen
  DrawScene(5)
  print at 9,8, "BALLOON BLITZ"
  print at 7,9, "BY MICHAEL T. BOHN"
  print at 4,10, "COMPUTE!'S GAZETTE 1984"
  print at 10,12, "START GAME"
  print at 10,13, "LEVEL"
  print at 10,14, "CREDITS"
  print at 10,16, "BEST HITS"
  print Best at 20,16
  ShowMenu
  TitleOn = 1
  Bm.Live = 0
  BoomT = 0
  PuffT = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TzLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  MoveClouds
  ' the balloon drifts with the cloud on the title
  W16 = Cx
  Bx = W16 << 4
  Bx = Bx + 640
  DrawSprites
  V = J1 | J2
  V = V & 15
  if V <> WasStick then
    K = V & 1
    if K > 0 then
      if Menu > 0 then dec Menu
    end if
    K = V & 2
    if K > 0 then
      if Menu < 2 then inc Menu
    end if
    if Menu = 1 then
      K = V & 4
      if K > 0 then
        if Lv > 1 then dec Lv
      end if
      K = V & 8
      if K > 0 then
        if Lv < 6 then inc Lv
      end if
    end if
    ShowMenu
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  WasStick = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 8,12
  put char 32 at 8,13
  put char 32 at 8,14
  J = Menu + 12
  put char 62 at 8,J
  print at 16,13, "< "
  NumU = Lv
  print at 18,13, digits$(NumU, 1)
  print at 19,13, " >"
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "BALLOON BLITZ"
  print at 2,5, "BASED ON BALLOON BLITZ BY"
  print at 2,6, "MICHAEL T. BOHN, COMPUTE!'S"
  print at 2,7, "GAZETTE AUGUST 1984"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: UP, UP AND OVER"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $00,$20,$02,$00,$40,$08,$00,$01
  $01,$03,$07,$F0,$E0,$C0,$80,$00
  $80,$C0,$E0,$F0,$07,$03,$01,$00
  $18,$C3,$81,$81,$00,$00,$81,$C3
  $18,$18,$18,$18,$C3,$00,$00,$00
  $00,$00,$40,$02,$00,$10,$00,$80
  $44,$22,$00,$00,$20,$02,$00,$40
  $08,$00,$41,$00,$00,$10,$80,$02
  $C3,$81,$00,$81,$00,$10,$80,$02
end data
data TileCol bytes
  $C5,$C5,$C5,$5C,$5C,$5C,$5C,$0C
  $C5,$C5,$C5,$C5,$5C,$5C,$5C,$0C
  $0C,$2C,$2C,$0C,$2C,$2C,$0C,$2C
  $F5,$F5,$F5,$5F,$5C,$5C,$5C,$0C
  $F5,$F5,$F5,$F5,$5C,$5C,$5C,$0C
  $2C,$C2,$C2,$C2,$02,$02,$C2,$C2
  $AC,$AC,$AC,$AC,$CA,$0C,$0C,$0C
  $0C,$0C,$2C,$2C,$0C,$2C,$0C,$2C
  $23,$32,$02,$02,$32,$32,$02,$32
  $6A,$0A,$6A,$0A,$0A,$6A,$6A,$6A
  $A1,$A1,$01,$A1,$0A,$6A,$6A,$6A
end data
data SpritePat bytes
  $07,$1D,$39,$73,$73,$E7,$E7,$E7,$77,$73,$3B,$1D,$0F,$07,$00,$00
  $E0,$B8,$9C,$CE,$CE,$E7,$E7,$E7,$EE,$CE,$DC,$B8,$F0,$E0,$00,$00
  $00,$02,$06,$0C,$0C,$18,$18,$18,$08,$0C,$04,$02,$00,$00,$00,$00
  $00,$40,$60,$30,$30,$18,$18,$18,$10,$30,$20,$40,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$08,$07,$07
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$10,$E0,$E0
  $03,$07,$03,$07,$0F,$0F,$0F,$07,$03,$00,$00,$00,$00,$00,$00,$00
  $00,$80,$00,$80,$C0,$C0,$C0,$80,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$03,$FF,$07,$3F,$7F,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$C0,$B0,$F0,$FC,$FE,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$03,$0D,$0F,$3F,$7F,$00,$00,$00,$00
