cartridge "AMY CONDITIONAL LAB/AMY STUDIO/2026"

define DEBUG_BUILD

u8 Result = 0
u8 Expected = 42

  text screen
  screen on
  SelectBuild
  SameNameDebugHook
  print centered at 6, "CONDITIONAL COMPILE"
  print at 8,9, "RESULT:"
  print Result at 16,9 digits 3
  if Result = Expected then
    print centered at 12, "PASS DEBUG BRANCH"
  else
    print centered at 12, "FAIL WRONG BRANCH"
  end if
  loop forever

ifdef DEBUG_BUILD
sub SelectBuild:
  Result = 42
  return
end ifdef

ifndef DEBUG_BUILD
sub SelectBuild:
  Result = 99
  print centered at 18, "INACTIVE RELEASE CODE"
  return
end ifndef

' Same-name duplicate sub in mutually exclusive conditional blocks.
ifdef DEBUG_BUILD
sub SameNameDebugHook:
  return
end ifdef

ifndef DEBUG_BUILD
sub SameNameDebugHook:
  print centered at 20, "INACTIVE HOOK"
  return
end ifndef