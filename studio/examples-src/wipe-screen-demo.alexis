' Alternate two screens with the built-in wipe effects.
  text screen
  screen on
  goto show_a

sub show_a:
  print at 4,2, "--- WIPE SCREEN DEMO ---"
  print at 10,10, "  SCREEN A  "
  print at 2,18, "(wipes upward in ~24 frames)"
  wait 120 frames
  wipe screen up
  goto show_b

sub show_b:
  print at 4,2, "--- WIPE SCREEN DEMO ---"
  print at 10,10, "  SCREEN B  "
  print at 1,18, "(wipes downward in ~24 frames)"
  wait 120 frames
  wipe screen down
  goto show_a
end sub