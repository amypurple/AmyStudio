project "AMY SCENE POISON SELF-TEST"
memory "colecovision_legacy_sdcc"

define AMY_DEBUG_SCENE_POISON

u8 GuardBefore = 0

record MenuMemory:
  u8 Initialized
  u8 Untouched
end record

record GameMemory:
  u8 Initialized
  u8 Untouched
end record

overlay SceneRam
  Menu as MenuMemory
  Game as GameMemory
end overlay

u8 GuardAfter = 0

scene Menu uses SceneRam.Menu
  on enter MenuEnter
  on frame MenuFrame
end scene

scene Game uses SceneRam.Game
  on enter GameEnter
  on frame GameFrame
end scene

GuardBefore = $5A
GuardAfter = $A5
enter Menu
screen on
loop forever

sub MenuEnter:
  SceneRam.Menu.Initialized = $42
  ' Untouched intentionally remains $CD in a poison-enabled debug build.
  return
end sub

sub MenuFrame:
  return
end sub

sub GameEnter:
  SceneRam.Game.Initialized = $24
  return
end sub

sub GameFrame:
  return
end sub
