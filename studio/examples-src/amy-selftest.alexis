project "Amy Selftest"
memory "colecovision_legacy_sdcc"

bool Flag = false

u8 ByteValue = 3
u8 DescI = 0
u8 LoopI = 0
u16 WordValue = 64
u8 OptCount = 0

u8 Pattern[4]
u8 Board[8]
u8 Backup[8]

  text screen

  print at 9,0, "AMY SELFTEST"
  print at 1,2, "LOOPS"
  print at 1,4, "DOWNTO"
  print at 1,5, "SHIFT"
  print at 1,8, "ARRAY"
  screen on
  print at 1,20, "BASE OK"

  put char $41 at 10,2
  put char $42 at 11,2
  put char $43 at 12,2
  print at 15,2, "PUT OK"
  wait 20 frames

  for LoopI = 0 to 7
    put char LoopI + $30 at LoopI,3
  next
  print at 12,3, "FOR OK"
  wait 20 frames

  for LoopI = 0 to 3
    put char LoopI + $31 at LoopI,6
  next LoopI
  print at 12,6, "FROM OK"
  wait 20 frames

  for DescI = 7 to 0 step -1
    put char DescI + $30 at DescI,4
  next
  print at 12,4, "DOWN OK"
  wait 20 frames

  ByteValue <<= 3
  WordValue >>= 2
  print ByteValue at 8,5 digits 2
  print WordValue at 16,5 digits 2

  Pattern[0] = $41
  Pattern[1] = $42
  Pattern[2] = $43
  Pattern[3] = $44
  fill array Board repeating Pattern count 8
  copy Board count 8 to Backup
  reverse array Backup from 0 count 8
  put Board count 8 at 8,8
  put Backup count 8 at 8,9

  toggle Flag
  if Flag then
    print at 1,12, "BOOL PASS"
  else
    print at 1,12, "BOOL FAIL"
  end if

  opt_chain
  if OptCount = 6 then
    print at 1,14, "OPT PASS"
  else
    print at 1,14, "OPT FAIL"
  end if


sub opt_chain:
  OptCount = 0
  opt_a
  return

sub opt_a:
  OptCount += 1
  opt_b
  return

sub opt_b:
  OptCount += 1
  opt_c
  return

sub opt_c:
  OptCount += 1
  opt_d
  return

sub opt_d:
  OptCount += 1
  opt_e
  return

sub opt_e:
  OptCount += 1
  opt_f
  return

sub opt_f:
  OptCount += 1
  return