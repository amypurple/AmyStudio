data TileCol bytes
  $E1,$E1,$E1,$E1,$E1,$E1,$E1,$E1
  $0E,$01,$01,$01,$01,$01,$01,$0E
  $0E,$E1,$E1,$E1,$E1,$E1,$E1,$E1
  $E1,$E1,$E1,$E1,$E1,$E1,$71,$71
  $0E,$01,$01,$01,$01,$01,$01,$0E
  $B1,$B1,$B1,$B1,$1B,$B1,$B1,$B1
  $B1,$B1,$B1,$1B,$1B,$B1,$B1,$B1
  $B1,$B1,$B1,$B1,$1B,$B1,$B1,$B1
  $B1,$B1,$B1,$1B,$1B,$B1,$B1,$B1
  $0E,$0F,$0E,$0E,$01,$01,$01,$01
  $01,$01,$41,$01,$01,$41,$01,$01
  $81,$18,$18,$18,$18,$18,$98,$98
  $81,$81,$18,$18,$18,$18,$08,$08
  $98,$08,$18,$18,$18,$18,$18,$81
