data SpritePat bytes
  $00,$78,$FC,$BC,$DC,$FC,$78,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$C0,$C0,$E0,$60,$70,$30,$3F,$1F,$00,$00
  $00,$00,$00,$00,$00,$00,$03,$03,$07,$06,$0E,$0C,$FC,$F8,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$24,$91,$41,$A5,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

asm {
MbHush:
    db $00,$00,$F4,$01,$10
MbDrop:
    db $40,$47,$50,$01,$40,$55,$60,$01,$40,$6B,$70,$01,$50
MbFlip:
    db $00,$00,$41,$01,$00,$00,$72,$02,$10
MbClack:
    db $40,$35,$50,$01,$50
MbCatch:
    db $40,$6B,$20,$02,$40,$6B,$F0,$01,$40,$55,$20,$02,$40,$55,$F0,$01,$40,$47,$20,$04,$40,$47,$F0,$01
    db $50
MbMiss:
    db $00,$00,$25,$03,$00,$00,$56,$05,$00,$00,$97,$06,$10
MbWrong:
    db $40,$68,$31,$04,$40,$E0,$41,$06,$50
MbLevel:
    db $40,$D6,$20,$05,$40,$D6,$F0,$01,$40,$AA,$20,$05,$40,$AA,$F0,$01,$40,$8F,$20,$05,$40,$8F,$F0,$01
    db $40,$6B,$20,$05,$40,$6B,$F0,$01,$40,$55,$20,$11,$40,$55,$F0,$01,$50
MbOver:
    db $40,$1D,$21,$09,$40,$1D,$F1,$01,$40,$2E,$21,$09,$40,$2E,$F1,$01,$40,$41,$21,$09,$40,$41,$F1,$01
    db $40,$53,$21,$1B,$40,$53,$F1,$01,$50

MbSoundTable:
    dw MbHush,$702B
    dw MbDrop,$7035
    dw MbFlip,$702B
    dw MbClack,$7035
    dw MbCatch,$7035
    dw MbMiss,$702B
    dw MbWrong,$7035
    dw MbLevel,$7035
    dw MbOver,$7035
    dw MbTuneMel,$703F
    dw MbTuneBass,$7049
; Rolling Down, C major (original for this game)
; Tiny Sound, 7 frames per step
MbTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$2B,$01,$26,$01,$23,$01,$26,$01,$2B,$01,$2D,$01
    db $2F,$01,$01,$01,$2D,$01,$2A,$01,$26,$01,$2A,$01,$2D,$01,$2F,$01
    db $30,$01,$01,$01,$2F,$01,$2B,$01,$28,$01,$2B,$01,$30,$01,$2F,$01
    db $2D,$01,$2B,$01,$2A,$01,$26,$01,$28,$01,$2A,$01,$2B,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
MbTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$07,$01,$0E,$01,$07,$01,$0E,$01,$07,$01,$0E,$01
