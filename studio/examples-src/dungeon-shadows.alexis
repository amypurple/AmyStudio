; ---------------------------------------------------------------------------
; Lanterns in Z80 (called with the NMI off).
; The name table is the light map: a lit tile is its kind + 32 per lantern.
; A cone lives in a 6 x 6 box in front of the guard. LtTab, precomputed,
; lists for each facing the cone's cells in order (depth by depth, inner
; lanes first) with their lane and their VRAM offset from the box's first
; cell, so lighting is a walk down the table. GC keeps, per guard, the
; tiles his lantern lit, so LtOff only touches those.
; Box geometry: run i is a screen row, element j a column.
;   facing down: row Ry0+2+i, columns Cx0-2.. (run = depth, element = lane)
;   facing up:   row Ry0-1-i, columns Cx0-2..
;   facing right: row Ry0-2+i, columns Cx0+2.. (run = lane, element = depth)
;   facing left:  row Ry0-2+i, columns Cx0-6.. (depth counted from the right)
; ---------------------------------------------------------------------------

; The box for Cx0, Ry0, D: LtRows, LtRunOK, LtElOK, LtCol
LtGeom:
    ld a,(AMY_UVAR_D)
    ld b,a
    ld a,(AMY_UVAR_Cx0)
    sub 2
    ld c,a                      ; up, down: Cx0 - 2
    ld a,b
    cp 3
    jr nz,lg_notr
    ld a,c
    add a,4
    ld c,a                      ; right: Cx0 + 2
lg_notr:
    ld a,b
    cp 2
    jr nz,lg_notl
    ld a,c
    sub 4
    ld c,a                      ; left: Cx0 - 6
lg_notl:
    ld a,c
    ld (AMY_UVAR_LtCol),a
    ld hl,AMY_UVAR_LtElOK
    ld e,6
lg_el:
    ld a,c
    sub 2
    cp 28                       ; 2..29 -> 0..27
    ld a,0
    adc a,0                     ; carry set: inside
    ld (hl),a
    inc hl
    inc c
    dec e
    jr nz,lg_el
    ; rows
    ld a,(AMY_UVAR_Ry0)
    ld c,a
    ld d,1                      ; step +1
    ld a,b
    or a
    jr nz,lg_n0
    ld a,c
    add a,2
    ld c,a
    jr lg_rows
lg_n0:
    cp 1
    jr nz,lg_n1
    dec c
    ld d,255                    ; step -1
    jr lg_rows
lg_n1:
    dec c
    dec c
lg_rows:
    push ix
    ld hl,AMY_UVAR_LtRows
    ld ix,AMY_UVAR_LtRunOK
    ld e,6
lg_r:
    ld (hl),c
    ld a,c
    sub 2
    cp 20                       ; 2..21 -> 0..19
    ld a,0
    adc a,0
    ld (ix+0),a
    inc hl
    inc ix
    ld a,c
    add a,d
    ld c,a
    dec e
    jr nz,lg_r
    pop ix
    ret

; HL = $1800 + row(run B) x 32 + LtCol (LtCol is signed)
LtAddr:
    ld hl,AMY_UVAR_LtRows
    ld e,b
    ld d,0
    add hl,de
    ld l,(hl)
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_LtCol)
    ld e,a
    ld d,0
    bit 7,a
    jr z,la_pos
    dec d
la_pos:
    add hl,de
    ld de,$1800
    add hl,de
    ret

LtVRd:                          ; A = VRAM byte at HL
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    nop
    nop
    in a,($BE)
    ret
LtVWr:                          ; write A to VRAM at HL
    push af
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop af
    out ($BE),a
    ret
LtList:                         ; HL = GC + G x 48
    ld a,(AMY_UVAR_G)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,de
    ld de,AMY_UVAR_GC
    add hl,de
    ret
LtLoad:
    ld a,(AMY_UVAR_G)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_GCX
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Cx0),a
    ld hl,AMY_UVAR_GCY
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Ry0),a
    ld hl,AMY_UVAR_GCD
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_D),a
    ret

; Take guard G's light back: only the tiles it lit, listed in GC
LtOff:
    ld a,(AMY_UVAR_G)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_GCN
    add hl,de
    ld b,(hl)
    ld (hl),0
    ld a,b
    or a
    ret z
    call LtList
lo_loop:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ex de,hl
    call LtVRd
    sub 32
    call LtVWr
    pop hl
    djnz lo_loop
    ret

; HL += A
LtAddA:
    add a,l
    ld l,a
    ret nc
    inc h
    ret

; Light guard G's cone. LtTab lists, for each facing, the cone's cells in
; order (depth by depth, inner lanes first), precomputed: box cell, run,
; element, lane, and the lane inside it. 18 cells for a 5-deep lantern,
; 24 for 6.
LtOn:
    call LtLoad
    call LtGeom
    ld b,0
    call LtAddr                 ; VRAM address of the box's first cell
    ld (AMY_UVAR_LtBase),hl
    call LtList
    ld (AMY_UVAR_Dst16),hl
    xor a
    ld (AMY_UVAR_N),a
    ld hl,AMY_UVAR_Stp
    ld b,6
lt_clr:
    ld (hl),a
    inc hl
    djnz lt_clr
    ld a,(AMY_UVAR_D)           ; table: LtTab + D x 144
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,de                   ; x 144
    ld de,LtTab
    add hl,de
    ld b,18
    ld a,(AMY_UVAR_CLen)
    cp 6
    jr c,le_loop
    ld b,24
le_loop:
    push bc
    ld d,(hl)                   ; run
    inc hl
    ld e,(hl)                   ; element
    inc hl
    ld c,(hl)                   ; lane
    inc hl
    ld b,(hl)                   ; lane inside (255: none)
    inc hl
    ld a,(hl)                   ; VRAM offset from the box's first cell
    inc hl
    ld (AMY_UVAR_LtOfs),a
    ld a,(hl)
    inc hl
    ld (AMY_UVAR_LtOfs+1),a
    push hl
    ld a,c
    ld hl,AMY_UVAR_Stp
    call LtAddA
    ld a,(hl)
    or a
    jr nz,le_next               ; this lane already hit a wall
    ld a,b
    cp 6
    jr nc,le_noin
    push hl
    ld hl,AMY_UVAR_Stp
    call LtAddA
    ld a,(hl)
    pop hl
    or a
    jr nz,le_stop               ; the lane inside is blocked: so is this one
le_noin:
    push hl
    ld a,d
    ld hl,AMY_UVAR_LtRunOK
    call LtAddA
    ld a,(hl)
    or a
    jr z,le_stop1               ; off the play area
    ld a,e
    ld hl,AMY_UVAR_LtElOK
    call LtAddA
    ld a,(hl)
    or a
    jr z,le_stop1
    ld hl,(AMY_UVAR_LtBase)
    ld de,(AMY_UVAR_LtOfs)
    add hl,de
    call LtVRd
    cp 128
    jr c,le_stop1               ; text: a wall
    ld b,a
    and 31
    cp 12
    jr nc,le_stop1              ; walls, torches, crates, doors
    ld a,b
    and 96
    cp 96
    jr z,le_pop                 ; three lanterns already
    ld a,b
    add a,32
    call LtVWr
    ex de,hl
    ld hl,(AMY_UVAR_Dst16)
    ld (hl),e
    inc hl
    ld (hl),d
    inc hl
    ld (AMY_UVAR_Dst16),hl
    ld hl,AMY_UVAR_N
    inc (hl)
le_pop:
    pop hl
    jr le_next
le_stop1:
    pop hl
le_stop:
    ld (hl),1
le_next:
    pop hl
    pop bc
    dec b
    jp nz,le_loop
    ld a,(AMY_UVAR_G)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_GCN
    add hl,de
    ld a,(AMY_UVAR_N)
    ld (hl),a
    ret
LtTab:
    db 0,2,2,255,2,0,0,3,3,255,3,0,1,2,2,255,34,0
    db 1,3,3,255,35,0,2,2,2,255,66,0,2,3,3,255,67,0
    db 2,1,1,2,65,0,2,4,4,3,68,0,3,2,2,255,98,0
    db 3,3,3,255,99,0,3,1,1,2,97,0,3,4,4,3,100,0
    db 4,2,2,255,130,0,4,3,3,255,131,0,4,1,1,2,129,0
    db 4,4,4,3,132,0,4,0,0,1,128,0,4,5,5,4,133,0
    db 5,2,2,255,162,0,5,3,3,255,163,0,5,1,1,2,161,0
    db 5,4,4,3,164,0,5,0,0,1,160,0,5,5,5,4,165,0
    db 0,2,2,255,2,0,0,3,3,255,3,0,1,2,2,255,226,255
    db 1,3,3,255,227,255,2,2,2,255,194,255,2,3,3,255,195,255
    db 2,1,1,2,193,255,2,4,4,3,196,255,3,2,2,255,162,255
    db 3,3,3,255,163,255,3,1,1,2,161,255,3,4,4,3,164,255
    db 4,2,2,255,130,255,4,3,3,255,131,255,4,1,1,2,129,255
    db 4,4,4,3,132,255,4,0,0,1,128,255,4,5,5,4,133,255
    db 5,2,2,255,98,255,5,3,3,255,99,255,5,1,1,2,97,255
    db 5,4,4,3,100,255,5,0,0,1,96,255,5,5,5,4,101,255
    db 2,5,2,255,69,0,3,5,3,255,101,0,2,4,2,255,68,0
    db 3,4,3,255,100,0,2,3,2,255,67,0,3,3,3,255,99,0
    db 1,3,1,2,35,0,4,3,4,3,131,0,2,2,2,255,66,0
    db 3,2,3,255,98,0,1,2,1,2,34,0,4,2,4,3,130,0
    db 2,1,2,255,65,0,3,1,3,255,97,0,1,1,1,2,33,0
    db 4,1,4,3,129,0,0,1,0,1,1,0,5,1,5,4,161,0
    db 2,0,2,255,64,0,3,0,3,255,96,0,1,0,1,2,32,0
    db 4,0,4,3,128,0,0,0,0,1,0,0,5,0,5,4,160,0
    db 2,0,2,255,64,0,3,0,3,255,96,0,2,1,2,255,65,0
    db 3,1,3,255,97,0,2,2,2,255,66,0,3,2,3,255,98,0
    db 1,2,1,2,34,0,4,2,4,3,130,0,2,3,2,255,67,0
    db 3,3,3,255,99,0,1,3,1,2,35,0,4,3,4,3,131,0
    db 2,4,2,255,68,0,3,4,3,255,100,0,1,4,1,2,36,0
    db 4,4,4,3,132,0,0,4,0,1,4,0,5,4,5,4,164,0
    db 2,5,2,255,69,0,3,5,3,255,101,0,1,5,1,2,37,0
    db 4,5,4,3,133,0,0,5,0,1,5,0,5,5,5,4,165,0
; Guard voices: formant-synthesized (voices.py), VoxPCM encoded
SayHey:
  dw VoxHey1
  db 17,9
  dw VoxHey2
  db 22,15
  dw VoxHey3
  db 27,21
  dw 0,0
VoxHey1:
  db 29,2,224,0,1,2,0,1,2,64,1,2,32,1,2,224,224,2,1,32,1,2,32,1
  db 2,1,34,33,3,1,32,1,2,0,2,1,32,2,4,0,4,3,2,3,6,2,32,2
  db 4,2,1,2,1,3,65,0,34,1,0,3,6,5,0,33,2,0,1,32,3,0,4,32
  db 2,33,5,4,2,0,33,3,64,1,0,1,3,2,4,0,2,32,3,4,1,34,64,1
  db 2,1,66,10,2,0,2,4,1,5,0,1,4,3,1,3,0,33,0,3,32,2,0,1
  db 4,34,0,2,1,6,0,8,13,2,6,3,0,2,4,3,0,6,3,2,4,32,5,4
  db 2,8,3,2,1,0,3,32,1,4,5,2,33,0,1,3,2,6,0,5,4,0,4,5
  db 33,2,4,34,0,3,4,0,1,2,5,6,4,2,1,5,1,3,1,2,36,35,6,1
  db 3,128,34,36,32,5,1,4,0,7,1,4,1,3,33,5,2,4,32,4,0,3,0,3
  db 10,5,0,2,1,4,3,2,4,5,1,4,0,5,33,4,34,32,1,64,1,0,3,1
