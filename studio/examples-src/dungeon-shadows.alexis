    dw sndtiny_1
    db 6
    db $02,$40,$1A,$21,$1B,$01,$1E,$01,$22,$01,$21,$22,$01,$01,$25,$01
    db $22,$01,$01,$01,$23,$01,$22,$01,$20,$01,$1E,$01,$1D,$01,$01,$01
    db $1A,$01,$01,$01,$02,$30,$1A,$21,$1B,$01,$1E,$01,$22,$01,$21,$22
    db $01,$01,$27,$01,$25,$01,$01,$01,$23,$01,$20,$01,$1D,$01,$1A,$01
    db $1B,$01,$01,$01,$01,$01,$01,$01
    db $FF
DsTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$60,$18,$32,$0F,$01,$0A,$01,$0F,$01,$0A,$01,$0F,$01,$0A,$01
    db $12,$01,$11,$01,$08,$01,$0F,$01,$08,$01,$0F,$01,$0A,$01,$11,$01
    db $0A,$01,$0E,$01,$02,$60,$18,$32,$0F,$01,$0A,$01,$0F,$01,$0A,$01
    db $0B,$01,$12,$01,$0B,$01,$12,$01,$08,$01,$0F,$01,$0A,$01,$0E,$01
    db $0F,$01,$0A,$01,$0F,$01,$01,$01
