cartridge "DUNGEON SHADOWS/AN ORIGINAL TIMELOST GAME/2026"

' DUNGEON SHADOWS
' An original stealth game for the Timelost series, imagined from
' "Timelost: A Computer Adventure" by Kris Austen Andrews, Arlan Keith
' Andrews Sr. and Joseph C. Giarratano (Que, 1983). The book's chapter
' "The Dungeon of the Lord-Wizard" locks the heroes in the Warlord's
' prison; its game, Escape, begins at the river. This game tells the part
' the book skips: getting from the cells to the river without being seen.
' The story and the characters belong to the authors.
'
' The idea: every Timelost game is meant to bring something new. This one
' brings stealth, rare in 8-bit games: no weapon, no shooting. Guards walk
' their rounds with lanterns, and the light of each lantern is drawn on
' the floor as it sweeps. Stay in the dark, hide in the straw, listen to
' your heartbeat, and get out.
'
' ColecoVision game in Amy by Amy Bienvenu, 2026.
' Controls (either joystick):
'   stick       sneak (silent)
'   left fire   hold to run: faster, but the guards hear you
'   right fire  throw a pebble: the guards go to look where it lands
' Rules: find the key to unlock the stairs of each room. If a guard's
' lantern or a torch shows you to a guard, the eye fills: at the first
' mark the guard says "HEY?" and comes to look; when it is full: "HALT!".
' Walking into a guard is also the end. Straw hides you completely, even
' in the light. Puddles splash and draw the guards. In the guard room and
' the armory, pull the lever to open Erin's and Jacque's cells; freed, they
' follow in your steps, and a guard can see them too. Six rooms lead to
' the water gate and the River of Death; after the river, the next night
' begins, harder.
' Points: gem 50, friend freed 500, room 1000, room without being
' spotted 1000 more.
'
' How it works:
' - Every floor tile has three lit copies at +32, +64 and +96. A lantern
'   adds 32 to each tile of its cone and takes it back when the guard
'   moves or turns, so overlapping lanterns add up without any light map
'   in RAM: the name table itself is the light map.
' - A cone is up to 6 tiles deep and widens from 2 to 6 tiles; each lane
'   stops at the first wall, and an outer lane stops when the lane inside
'   it is blocked, so light does not leak around corners. Bars and water
'   let the light through.
' - The two lantern routines (take the light back, light the new cone)
'   are Z80 code (lights.asm, inside the asm block), driven by a
'   precomputed table: for each facing, the cone's cells in order with
'   their lane and their VRAM offset from the corner of the 6 x 6 box in
'   front of the guard. Only the tiles really lit are read and written,
'   and each guard's list of them is all LtOff needs. Only one lantern is
'   relit per frame.
'   The game holds 60 frames a second with three guards.
' - Torchlit tiles are lit all the time; there a guard sees you only if he
'   faces you, within 7 tiles, with nothing in the way between.
' - Guards follow their rounds, stop and look both ways at the marked
'   corners, go to investigate a noise or a glimpse, look around, and walk
'   back along the steps they remember.
' - Friends replay John's steps from a history of his positions. When a
'   cell opens and John comes near, the action stops while the friend walks
'   out to his or her place in the line.
' - Voices: "HEY?", "HALT!" and "SHH..." are synthesized formant speech,
'   played as VoxPCM samples on the standard sound chip.
' Everything stays in columns 2-29, inside the TV overscan. Sprites: John
' 0 and the guards 1-3 never flicker (at most four on a line); the freed
' friends and the pebble come after them and take turns (flicker) only
' when a line holds more than four.
' The frame loop is protected from the NMI.

const KFloor = 0
const KTorch = 1
const KStraw = 2
const KKey = 3
const KGem = 4
const KLever = 5
const KLeverOn = 6
const KExit = 7
const KPuddle = 8
const KBars = 10
const TFlame = 145
const THeart = 149
const TPeb = 150
const TBarOff = 151
const TBarOn = 152
const TBarHot = 153
const TEye = 154
const TKeyIcon = 131
const TitleRoom = 6

const SndBeat = 1
const SndStepN = 2
const SndSplash = 3
const SndThrow = 4
const SndClack = 5
const SndKeyUp = 6
const SndGem = 7
const SndLeverN = 8
const SndLeverT = 9
const SndJoin = 10
const SndSting = 11
const SndCaught = 12
const SndClearA = 13
const SndClearB = 14
const SndEndA = 15
const SndEndB = 16
const SndOver = 17
const SndGood = 18
const SndPick = 19
const SndTuneA = 20
const SndTuneB = 21

u16 Score = 0
u16 RoomScore = 0
u16 HighScore = 3000
u8 HighName[3]
u8 Lives = 3
u8 Room = 0
u8 Night = 1
u8 Skill = 0
u8 Hard = 0
u8 Relit = 0
u8 CLen = 5
u8 Tick = 0
u8 Caught = 0
u8 RoomDone = 0
u8 Unseen = 1
u8 HasK = 0
u8 HasE = 0
u8 HasJ = 0
u8 Peb = 3
' John
u8 JX = 0
u8 JY = 0
u8 JMv = 255
u8 JDir = 0
u8 JAnim = 0
u8 JHid = 0
u8 Spd = 1
u8 NoiseT = 0
u8 LastTX = 0
u8 LastTY = 0
' His steps, for the friends who follow
u8 HX[48]
u8 HY[48]
u8 HD[48]
u8 HP = 0
u8 FolN = 0
u8 Fol[2]
u8 FPX = 0
u8 FPY = 0
u8 FPD = 0
' A friend still in a cell
u8 CgWho = 255
u8 CgX = 0
u8 CgY = 0
u8 CgOpen = 0
u8 CgDir = 0
u8 CgWalk = 0
u8 FwX = 0
u8 FwY = 0
u8 ExC = 0
u8 ExR = 0
' Guards
u8 NG = 0
u8 NGm = 0
u8 FolM = 0
u8 GX[3]
u8 GY[3]
u8 GDir[3]
u8 GSt[3]
u8 GWp[3]
u8 GT[3]
u8 GLB[3]
u8 GTX[3]
u8 GTY[3]
u8 GSp[3]
u8 GBase[3]
u8 GCnt[3]
u8 GStk[48]
u16 GC[72]
u16 LtBase = 0
u16 LtOfs = 0
u8 LtRows[6]
u8 LtRunOK[6]
u8 LtElOK[6]
u8 LtCol = 0
u8 GCN[3]
u8 GCX[3]
u8 GCY[3]
u8 GCD[3]
u8 Stp[6]
' The pebble
u8 PbOn = 0
u8 PbX = 0
u8 PbY = 0
u8 PbD = 0
u8 PbT = 0
' Being seen
u8 Alert = 0
u8 Spot = 0
u8 Bars = 255
u8 NearD = 99
u8 NearG = 0
u8 HeartT = 0
u8 SLit = 0
u8 STorch = 0
u8 SHid = 0
u8 SeeOK = 0
u8 SX = 0
u8 SY = 0
u8 E = 0
' Input
u8 Want = 255
u8 WantH = 255
u8 WantV = 255
u8 Bt1 = 0
u8 Bt2 = 0
u8 Bt2Was = 0
u8 AnyFire = 0
u8 Up = 0
u8 Dn = 0
' Scratch
u8 TX = 0
u8 TY = 0
u8 TT = 0
u8 TK = 0
u8 TL = 0
u8 NK = 0
u8 BX = 0
u8 BY = 0
u8 OK = 0
u8 G = 0
u8 H = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 P = 0
u8 Q = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 D = 0
u8 Cx0 = 0
u8 Ry0 = 0
u8 CI = 0
u8 Dp = 0
u8 Ln = 0
u8 LoI = 0
u8 HiI = 0
u8 CBase = 0
u8 WX = 0
u8 WY = 0
u8 Ga = 0
u8 Gb = 0
u8 DXa = 0
u8 DYa = 0
u8 SXp = 0
u8 SYp = 0
u8 NX = 0
u8 NY = 0
u8 NR = 0
u8 Tm = 0
u8 Choice = 1
u16 Dst16 = 0
u16 W16 = 0
u16 NumU = 0

  tile screen
  set sound table DsSoundTable areas 4
  sprites 16x16
  sprites stable 0 to 3
  sprites flicker on
  copy SpritePat count 1056 to vram.spr_pat
  HideSprites
  LoadTiles
  HighName[0] = 65
  HighName[1] = 77
  HighName[2] = 89
  screen on
  EditorialPage
  HowToPage

title:
  TitlePage

new_game:
  Score = 0
  Lives = 3
  Room = 0
  Night = 1
  HasE = 0
  HasJ = 0

room_start:
  ' Shadow skill and every night after the first make the watch sharper
  Hard = Skill
  if Night >= 2 then inc Hard
  if Hard > 2 then Hard = 2
  CLen = 5
  if Hard > 0 then CLen = 6
  RoomScore = Score
  DrawRoom
  RoomCard

main_loop:
  nmi on
  wait
  nmi off
  inc Tick
  ReadPad
  MoveJohn
  Pickups
  MovePebble
  MoveGuards
  Detect
  Ambience
  DrawSprites
  if Caught = 1 then goto got_caught
  if RoomDone = 1 then goto room_clear
  goto main_loop

  ' --- HALT! ---
got_caught:
  play voxpcm SayHalt
  nmi off
  play sound SndCaught
  ShowBarsNow
  fill 32 count 28 at 2,22
  print at 11,22, "CAUGHT!"
  for Tm = 1 to 90
    N = Tm & 4
    K = 7
    if N = 0 then K = 15
    Y = JY - 1
    P = JDir * 8
    set sprite 0 to Y,JX,P,K
    update sprites
    Rearm
    wait
    nmi off
  next
  dec Lives
  Score = RoomScore
  if Lives = 0 then goto game_over
  goto room_start

  ' --- Down the stairs ---
room_clear:
  play sound SndClearA
  play sound SndClearB
  HideSprites
  for I = 0 to 1
    if I < FolN then
      if Fol[I] = 0 then HasE = 1
      if Fol[I] = 1 then HasJ = 1
    end if
  next
  fill 32 count 28 at 2,22
  W16 = Score
  Score += 1000
  if Unseen = 1 then Score += 1000
  if Score < W16 then Score = 65535
  ShowStatus
  print at 2,22, "ROOM CLEAR  +1000"
  if Unseen = 1 then print at 20,22, "UNSEEN!"
  Rearm
  wait 150 frames
  nmi off
  inc Room
  if Room < 6 then goto room_start
  Ending
  inc Night
  if Night > 9 then Night = 9
  Room = 0
  if Lives < 5 then inc Lives
  goto room_start

game_over:
  ShowStatus
  HideSprites
  fill 32 count 28 at 2,22
  print at 5,22, "THE DUNGEON KEEPS YOU..."
  play sound SndOver
  Rearm
  wait 150 frames
  nmi off
  if Score > HighScore then
    HighScore = Score
    MsgBox
    print at 8,10, "NEW HIGH SCORE!"
    play sound SndGood
    Rearm
    wait 60 frames
    nmi off
    EnterName
  end if
  MsgBox
  print at 9,10, "TRY AGAIN"
  print at 9,11, "TITLE PAGE"
  Choice = 1
  Rearm
  wait no fire
  choose menu 1 to 2 into Choice cursor $3E at 7,10 step 1
  wait no fire
  nmi off
  if Choice = 1 then goto new_game
  goto title

' ---------------------------------------------------------------------------
' The map in VRAM: TileAt reads the tile at TX,TY into TT, its kind (0-31)
' into TK and its light (0, 32, 64 or 96) into TL; text and blank tiles
' count as wall. W16 keeps its name-table offset.

sub TileAt:
  W16 = TY
  W16 <<= 5
  W16 += TX
  vpeek vram.name + W16 into TT
  if TT < 128 then
    TK = 16
    TL = 0
    return
  end if
  TK = TT & 31
  TL = TT & 96
  return
end sub

' Change the kind of TX,TY to NK, keeping its light
sub SetKind:
  TileAt
  TT = TL + 128
  TT += NK
  vpoke vram.name + W16, TT
  return
end sub

' Can a 2x2 figure stand with its top-left tile at BX,BY?
sub BlockFree:
  OK = 0
  TX = BX
  TY = BY
  TileAt
  if TK > 9 then return
  inc TX
  TileAt
  if TK > 9 then return
  inc TY
  TileAt
  if TK > 9 then return
  dec TX
  TileAt
  if TK > 9 then return
  OK = 1
  return
end sub

' --- Lanterns ---------------------------------------------------------------

' Take guard G's light back, and light his new cone: Z80 routines in
' lights.asm (the same rules, about ten times faster)
sub ConeOff:
  call asm LtOff
  return
end sub

sub ConeOn:
  call asm LtOn
  return
end sub

' --- Guards -----------------------------------------------------------------

sub InitGuards:
  V = Room * 8
  V += 7
  NG = RoomInfo[V]
  NGm = NG - 1
  for G = 0 to 2
    GCN[G] = 0
    GCX[G] = 255
    V = Room * 3
    V += G
    GBase[G] = GStart[V]
    GCnt[G] = GLen[V]
    if G < NG then
      V = GBase[G] * 2
      X = Route[V]
      inc V
      Y = Route[V]
      Y &= 127
      X <<= 3
      Y <<= 3
      GX[G] = X
      GY[G] = Y
      GWp[G] = 1
      GSt[G] = 0
      GSp[G] = 0
      GDir[G] = 3
    end if
  next
  return
end sub

sub MoveGuards:
  NearD = 99
  ' Novice guards rest one frame in four
  if Hard = 0 then
    N = Tick & 3
    if N = 0 then goto guards_light
  end if
  for G = 0 to NGm
    V = GSt[G]
    if V = 0 then
      GuardPatrol
    elseif V = 1 then
      GuardLook
    elseif V = 2 then
      GuardGo
    elseif V = 3 then
      GuardSearch
    else
      GuardBack
    end if
  next
guards_light:
  ' Only one lantern is relit per frame: the others wait their turn
  Relit = 0
  for G = 0 to NGm
    ' His tile, rounded, and where he faces: relight if either changed
    X = GX[G] + 4
    X >>= 3
    Y = GY[G] + 4
    Y >>= 3
    D = GDir[G]
    Q = 0
    if X <> GCX[G] then Q = 1
    if Y <> GCY[G] then Q = 1
    if D <> GCD[G] then Q = 1
    if Relit = 1 then Q = 0
    if Q = 1 then
      Relit = 1
      ConeOff
      GCX[G] = X
      GCY[G] = Y
      GCD[G] = D
      ConeOn
    end if
    ' How near is he? (in tiles)
    Ga = GX[G]
    Gb = GY[G]
    if Ga > JX then
      DXa = Ga - JX
    else
      DXa = JX - Ga
    end if
    if Gb > JY then
      DYa = Gb - JY
    else
      DYa = JY - Gb
    end if
    if DYa > DXa then DXa = DYa
    DXa >>= 3
    if DXa < NearD then
      NearD = DXa
      NearG = G
    end if
  next
  return
end sub

sub StepG:
  X = GX[G]
  Y = GY[G]
  D = GDir[G]
  if D = 0 then
    inc Y
  elseif D = 1 then
    dec Y
  elseif D = 2 then
    dec X
  else
    inc X
  end if
  GX[G] = X
  GY[G] = Y
  return
end sub

sub GuardPatrol:
  V = GBase[G] + GWp[G]
  V *= 2
  WX = Route[V]
  inc V
  WY = Route[V]
  Q = WY & 128
  WY &= 127
  WX <<= 3
  WY <<= 3
  X = GX[G]
  Y = GY[G]
  if X <> WX then
    if X < WX then
      GDir[G] = 3
    else
      GDir[G] = 2
    end if
    StepG
    return
  end if
  if Y <> WY then
    if Y < WY then
      GDir[G] = 0
    else
      GDir[G] = 1
    end if
    StepG
    return
  end if
  ' At the corner: on to the next one, after a look around if marked
  V = GWp[G] + 1
  if V >= GCnt[G] then V = 0
  GWp[G] = V
  if Q > 0 then
    GSt[G] = 1
    GT[G] = 90
    GLB[G] = GDir[G]
  end if
  return
end sub

sub GuardLook:
  V = GT[G]
  K = GLB[G]
  if V = 89 then GDir[G] = PerpA[K]
  if V = 59 then GDir[G] = PerpB[K]
  if V = 29 then GDir[G] = RevD[K]
  dec V
  GT[G] = V
  if V = 0 then GSt[G] = 0
  return
end sub

sub GuardSearch:
  V = GT[G]
  N = V & 31
  if N = 0 then
    K = GDir[G]
    GDir[G] = PerpA[K]
  end if
  dec V
  GT[G] = V
  if V = 0 then GSt[G] = 4
  return
end sub

' To the noise or the glimpse, one tile at a time, remembering the way
sub GuardGo:
  X = GX[G]
  Y = GY[G]
  N = X | Y
  N &= 7
  if N <> 0 then
    StepG
    return
  end if
  WX = GTX[G]
  WY = GTY[G]
  if WX > X then
    DXa = WX - X
    SXp = 3
  else
    DXa = X - WX
    SXp = 2
  end if
  if WY > Y then
    DYa = WY - Y
    SYp = 0
  else
    DYa = Y - WY
    SYp = 1
  end if
  Q = 0
  if DXa < 8 then
    if DYa < 8 then Q = 1
  end if
  if GSp[G] >= 16 then Q = 1
  if Q = 1 then
    GSt[G] = 3
    GT[G] = 120
    return
  end if
  ' Try the longer way first, then the other
  if DXa >= DYa then
    D = SXp
    K = SYp
    P = DYa
  else
    D = SYp
    K = SXp
    P = DXa
  end if
  TryDir
  if OK = 0 then
    if P >= 8 then
      D = K
      TryDir
    end if
  end if
  if OK = 0 then
    GSt[G] = 3
    GT[G] = 120
    return
  end if
  V = G * 16
  V += GSp[G]
  GStk[V] = D
  inc GSp[G]
  GDir[G] = D
  StepG
  return
end sub

' Is the block one tile away from guard G, in direction D, free?
sub TryDir:
  BX = GX[G]
  BX >>= 3
  BX += DDX[D]
  BY = GY[G]
  BY >>= 3
  BY += DDY[D]
  BlockFree
  return
end sub

sub GuardBack:
  X = GX[G]
  Y = GY[G]
  N = X | Y
  N &= 7
  if N <> 0 then
    StepG
    return
  end if
  if GSp[G] = 0 then
    GSt[G] = 0
    return
  end if
  dec GSp[G]
  V = G * 16
  V += GSp[G]
  K = GStk[V]
  GDir[G] = RevD[K]
  StepG
  return
end sub

' A noise at NX,NY: guards within NR tiles go and look
sub MakeNoise:
  for H = 0 to NGm
    Ga = GX[H]
    Gb = GY[H]
    if Ga > NX then
      DXa = Ga - NX
    else
      DXa = NX - Ga
    end if
    if Gb > NY then
      DYa = Gb - NY
    else
      DYa = NY - Gb
    end if
    if DYa > DXa then DXa = DYa
    DXa >>= 3
    if DXa <= NR then
      X = NX + 4
      X &= $F8
      Y = NY + 4
      Y &= $F8
      GTX[H] = X
      GTY[H] = Y
      GSt[H] = 2
    end if
  next
  return
end sub

' --- John -------------------------------------------------------------------

sub ReadPad:
  WantH = 255
  WantV = 255
  Up = 0
  Dn = 0
  if joypad(1).left then WantH = 2
  if joypad(2).left then WantH = 2
  if joypad(1).right then WantH = 3
  if joypad(2).right then WantH = 3
  if joypad(1).up then WantV = 1
  if joypad(2).up then WantV = 1
  if joypad(1).down then WantV = 0
  if joypad(2).down then WantV = 0
  if WantV = 1 then Up = 1
  if WantV = 0 then Dn = 1
  Bt1 = 0
  Bt2 = 0
  if joypad(1).button1 then Bt1 = 1
  if joypad(2).button1 then Bt1 = 1
  if joypad(1).button2 then Bt2 = 1
  if joypad(2).button2 then Bt2 = 1
  AnyFire = Bt1 | Bt2
  ' Both axes held: take the turn
  Want = WantH
  if WantV <> 255 then
    if WantH = 255 then
      Want = WantV
    else
      if JMv >= 2 then Want = WantV
    end if
  end if
  return
end sub

sub MoveJohn:
  Spd = 1
  if Bt1 = 1 then Spd = 2
  N = JX | JY
  N &= 7
  if N = 0 then
    ' On the grid: choose the way
    if Want = 255 then
      JMv = 255
    else
      D = Want
      JTry
      if OK = 1 then
        JMv = Want
      else
        if JMv <> 255 then
          D = JMv
          JTry
          if OK = 0 then JMv = 255
        end if
      end if
      JDir = Want
    end if
  else
    ' Between tiles: only turning back is allowed
    if Want <> 255 then
      if JMv <> 255 then
        V = RevD[JMv]
        if Want = V then JMv = Want
      end if
    end if
  end if
  if JMv = 255 then return
  JDir = JMv
  ' Never step past the next tile line
  if Spd = 2 then
    N = JX | JY
    N &= 1
    if N = 1 then Spd = 1
  end if
  for I = 1 to Spd
    if JMv = 0 then
      inc JY
    elseif JMv = 1 then
      dec JY
    elseif JMv = 2 then
      dec JX
    else
      inc JX
    end if
    ' Remember the step for the friends behind
    inc HP
    if HP >= 48 then HP = 0
    HX[HP] = JX
    HY[HP] = JY
    HD[HP] = JMv
  next
  inc JAnim
  ' Running is heard
  if Spd = 2 then
    inc NoiseT
    if NoiseT >= 10 then
      NoiseT = 0
      NX = JX
      NY = JY
      NR = 4
      MakeNoise
    end if
  end if
  return
end sub

sub JTry:
  BX = JX
  BX >>= 3
  BX += DDX[D]
  BY = JY
  BY >>= 3
  BY += DDY[D]
  BlockFree
  return
end sub

' What John is standing on
sub Pickups:
  for K = 0 to 3
    TX = JX + SmpX[K]
    TX >>= 3
    TY = JY + SmpY[K]
    TY >>= 3
    TileAt
    if TK = KKey then
      NK = KFloor
      SetKind
      HasK = 1
      TX = ExC
      TY = ExR
      NK = KExit
      SetKind
      inc TX
      SetKind
      play sound SndKeyUp
      ShowStatus
      fill 32 count 28 at 2,22
      print at 2,22, "THE STAIRS ARE OPEN!"
    elseif TK = KGem then
      NK = KFloor
      SetKind
      Score += 50
      play sound SndGem
      ShowStatus
    elseif TK = KLever then
      NK = KLeverOn
      SetKind
      OpenBars
    elseif TK = KExit then
      RoomDone = 1
    elseif TK = KPuddle then
      ' A splash, once per tile
      X = JX + 4
      X >>= 3
      Y = JY + 4
      Y >>= 3
      Q = 0
      if X <> LastTX then Q = 1
      if Y <> LastTY then Q = 1
      if Q = 1 then
        LastTX = X
        LastTY = Y
        play sound SndSplash
        NX = JX
        NY = JY
        NR = 6
        MakeNoise
      end if
    end if
  next
  ' A friend in an open cell joins when John comes near
  if CgWho = 255 then return
  if CgOpen = 0 then return
  if CgX > JX then
    DXa = CgX - JX
  else
    DXa = JX - CgX
  end if
  if CgY > JY then
    DYa = CgY - JY
  else
    DYa = JY - CgY
  end if
  if DXa < 26 then
    if DYa < 26 then
      Score += 500
      play sound SndJoin
      ShowStatus
      fill 32 count 28 at 2,22
      print at 2,22, "FREED! STAY TOGETHER."
      FriendWalks
      Fol[FolN] = CgWho
      inc FolN
      CgWho = 255
    end if
  end if
  return
end sub

' The action stops while the freed friend walks out of the cell to take
' her or his place in the line behind John: down or up first (through the
' opened bars), then across
sub FriendWalks:
  I = FolN
  FolPos
  FwX = FPX
  FwY = FPY
  CgWalk = 1
fw_loop:
  if CgY <> FwY then
    if CgY < FwY then
      inc CgY
      CgDir = 0
    else
      dec CgY
      CgDir = 1
    end if
  elseif CgX <> FwX then
    if CgX < FwX then
      inc CgX
      CgDir = 3
    else
      dec CgX
      CgDir = 2
    end if
  else
    goto fw_done
  end if
  inc Tick
  DrawSprites
  Rearm
  wait
  nmi off
  goto fw_loop
fw_done:
  CgWalk = 0
  CgDir = 0
  return
end sub

sub OpenBars:
  play sound SndLeverN
  play sound SndLeverT
  for TY = 2 to 21
    for TX = 2 to 29
      TileAt
      if TK = KBars then
        TT -= KBars
        vpoke vram.name + W16, TT
      end if
    next
  next
  CgOpen = 1
  return
end sub

' --- The pebble -------------------------------------------------------------

sub MovePebble:
  if Bt2 = 1 then
    if Bt2Was = 0 then
      if PbOn = 0 then
        if Peb > 0 then
          dec Peb
          PbOn = 1
          PbX = JX
          PbY = JY
          PbD = JDir
          PbT = 0
          play sound SndThrow
          ShowStatus
        end if
      end if
    end if
  end if
  Bt2Was = Bt2
  if PbOn = 0 then return
  if PbOn >= 2 then
    ' It lies there a moment
    inc PbOn
    if PbOn > 40 then PbOn = 0
    return
  end if
  inc PbT
  X = PbX
  Y = PbY
  if PbD = 0 then
    Y += 3
  elseif PbD = 1 then
    Y -= 3
  elseif PbD = 2 then
    X -= 3
  else
    X += 3
  end if
  TX = X + 7
  TX >>= 3
  TY = Y + 8
  TY >>= 3
  TileAt
  Q = 0
  if TK > 11 then
    Q = 1
  else
    PbX = X
    PbY = Y
  end if
  if PbT >= 18 then Q = 1
  if Q = 0 then return
  ' Landed: clatter, or a splash in water
  PbOn = 2
  if TK = 11 then
    play sound SndSplash
  else
    play sound SndClack
  end if
  NX = PbX
  NY = PbY
  NR = 7
  MakeNoise
  return
end sub

' --- Friends ------------------------------------------------------------------

' Where follower I stands: FPX, FPY, facing FPD
sub FolPos:
  V = I + 1
  V *= 16
  if HP >= V then
    N = HP - V
  else
    N = HP + 48
    N -= V
  end if
  FPX = HX[N]
  FPY = HY[N]
  FPD = HD[N]
  return
end sub

' --- Being seen -------------------------------------------------------------

' Is SX,SY in a lantern (SLit), in torchlight (STorch), in straw (SHid)?
sub SampleBody:
  SLit = 0
  STorch = 0
  SHid = 0
  for K = 0 to 3
    TX = SX + SmpX[K]
    TX >>= 3
    TY = SY + SmpY[K]
    TY >>= 3
    TileAt
    if TL > 0 then SLit = 1
    if TK = KTorch then STorch = 1
    if K >= 2 then
      if TK = KStraw then inc SHid
    end if
  next
  if SHid = 2 then
    SHid = 1
  else
    SHid = 0
  end if
  return
end sub

' Does guard G see SX,SY? (facing it, 7 tiles at most, nothing between)
sub Sees:
  SeeOK = 0
  Ga = GX[G] + 8
  Ga >>= 3
  NX = GY[G] + 8
  NX >>= 3
  Gb = SX + 8
  Gb >>= 3
  NY = SY + 8
  NY >>= 3
  if Gb >= Ga then
    DXa = Gb - Ga
    SXp = 1
  else
    DXa = Ga - Gb
    SXp = 0
  end if
  if NY >= NX then
    DYa = NY - NX
    SYp = 1
  else
    DYa = NX - NY
    SYp = 0
  end if
  if DXa > 7 then return
  if DYa > 7 then return
  D = GDir[G]
  if D < 2 then
    if DYa = 0 then return
    if DYa < DXa then return
    if D = 0 then
      if SYp = 0 then return
    else
      if SYp = 1 then return
    end if
  else
    if DXa = 0 then return
    if DXa < DYa then return
    if D = 3 then
      if SXp = 0 then return
    else
      if SXp = 1 then return
    end if
  end if
  ' Walk the line between them
  N = DXa
  if DYa > N then N = DYa
  if N > 1 then
    Q = N - 1
    for CI = 1 to Q
      V = DXa * CI
      V /= N
      if SXp = 1 then
        TX = Ga + V
      else
        TX = Ga - V
      end if
      V = DYa * CI
      V /= N
      if SYp = 1 then
        TY = NX + V
      else
        TY = NX - V
      end if
      TileAt
      if TK > 11 then return
    next
  end if
  SeeOK = 1
  return
end sub

' How exposed are John and his friends this frame?
sub Exposure:
  SampleBody
  if SHid = 1 then return
  if SLit = 1 then
    if E < 2 then E = 2
    return
  end if
  if STorch = 0 then return
  for G = 0 to NGm
    Sees
    if SeeOK = 1 then
      if E < 1 then E = 1
    end if
  next
  return
end sub

sub Detect:
  E = 0
  SX = JX
  SY = JY
  Exposure
  JHid = SHid
  if FolN > 0 then
    FolM = FolN - 1
    for I = 0 to FolM
      FolPos
      SX = FPX
      SY = FPY
      Exposure
    next
  end if
  ' Too close: bumped into, or nearly
  for G = 0 to NGm
    Ga = GX[G]
    Gb = GY[G]
    if Ga > JX then
      DXa = Ga - JX
    else
      DXa = JX - Ga
    end if
    if Gb > JY then
      DYa = Gb - JY
    else
      DYa = JY - Gb
    end if
    if DXa < 11 then
      if DYa < 11 then Caught = 1
    end if
    if JHid = 0 then
      if DXa < 22 then
        if DYa < 22 then E = 4
      end if
    end if
  next
  if E > 0 then
    ' Half steps: lantern 1 a frame, torchlight 1 every other frame,
    ' a guard at arm's length 2; one half step more for a Shadow
    E += Hard
    N = Tick & 1
    V = E & 1
    E >>= 1
    if V = 1 then
      if N = 1 then inc E
    end if
    V = Alert + E
    if V > 64 then V = 64
    Alert = V
  else
    N = Tick & 3
    if N = 0 then
      if Alert > 0 then dec Alert
    end if
  end if
  if Alert >= 64 then Caught = 1
  if Alert = 0 then Spot = 0
  if Alert >= 24 then
    if Spot = 0 then
      ' "HEY?" The nearest guard comes to look
      Spot = 1
      Unseen = 0
      play sound SndSting
      ShowBarsNow
      play voxpcm SayHey
      nmi off
      NX = JX
      NY = JY
      NR = 99
      H = NearG
      X = NX + 4
      X &= $F8
      Y = NY + 4
      Y &= $F8
      GTX[H] = X
      GTY[H] = Y
      GSt[H] = 2
    end if
  end if
  ShowBars
  return
end sub

' Heartbeat, footsteps, torch flames
sub Ambience:
  ' The heart beats faster as the guards come near and the eye fills
  Q = 0
  if NearD <= 9 then Q = 1
  if Alert > 0 then Q = 1
  if Q = 1 then
    V = NearD
    if V > 9 then V = 9
    V *= 4
    V += 14
    N = Alert >> 2
    if V > N then
      V -= N
    else
      V = 0
    end if
    if V < 9 then V = 9
    inc HeartT
    if HeartT >= V then
      HeartT = 0
      play sound SndBeat
    end if
  end if
  ' The nearest guard's boots
  if NearD <= 6 then
    G = NearG
    if GSt[G] <> 1 then
      if GSt[G] <> 3 then
        N = GX[G] | GY[G]
        N &= 7
        if N = 0 then play sound SndStepN
      end if
    end if
  end if
  ' Flickering torches
  N = Tick & 7
  if N = 0 then
    W16 = Tick & 8
    Dst16 = TFlame * 8
    for I = 0 to 2
      copy Flames + W16 count 8 to vram.pattern + Dst16
      Dst16 += 2048
    next
  end if
  return
end sub

' --- Drawing ------------------------------------------------------------------

sub DrawSprites:
  ' John: blinks in the straw so you can find him
  P = JDir * 8
  N = JAnim & 8
  if N > 0 then P += 4
  K = 7
  if JHid = 1 then
    N = Tick & 16
    if N = 0 then K = 4
  end if
  Y = JY - 1
  set sprite 0 to Y,JX,P,K
  ' Friends behind him, or a friend in a cell
  for I = 0 to 1
    J = I + 4
    if I < FolN then
      FolPos
      P = FPD * 8
      if FPD = 255 then P = 0
      N = JAnim & 8
      if N > 0 then P += 4
      if Fol[I] = 0 then
        P += 32
        K = 9
      else
        P += 64
        K = 13
      end if
      Y = FPY - 1
      set sprite J to Y,FPX,P,K
    else
      Q = FolN
      if CgWho <> 255 then
        if I = Q then
          P = 32
          K = 9
          if CgWho = 1 then
            P = 64
            K = 13
          end if
          V = CgDir * 8
          P += V
          N = Tick & 32
          if CgWalk = 1 then N = Tick & 8
          if N > 0 then P += 4
          Y = CgY - 1
          set sprite J to Y,CgX,P,K
        else
          set sprite J to 192,0,0,0
        end if
      else
        set sprite J to 192,0,0,0
      end if
    end if
  next
  for G = 0 to 2
    J = G + 1
    if G < NG then
      P = GDir[G] * 8
      P += 96
      ' A step every 4 pixels: the sum of X and Y changes whichever way he walks
      N = GX[G] + GY[G]
      N &= 4
      if GSt[G] = 1 then N = 0
      if GSt[G] = 3 then N = 0
      if N > 0 then P += 4
      K = 12
      V = GSt[G]
      if V >= 2 then
        if V <= 3 then
          N = Tick & 4
          K = 15
          if N = 0 then K = 8
        end if
      end if
      Y = GY[G] - 1
      X = GX[G]
      set sprite J to Y,X,P,K
    else
      set sprite J to 192,0,0,0
    end if
  next
  if PbOn > 0 then
    Y = PbY - 1
    if PbOn = 1 then
      N = Arc[PbT]
      Y -= N
    end if
    set sprite 6 to Y,PbX,128,14
  else
    set sprite 6 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub DrawRoom:
  nmi off
  HideSprites
  cls
  fill mode 2 text color with $F1
  backdrop black
  LoadTiles
  ' The room, row by row
  W16 = Room
  W16 *= 560
  Dst16 = 66
  for I = 0 to 19
    copy RoomMap + W16 count 28 to vram.name + Dst16
    W16 += 28
    Dst16 += 32
  next
  V = Room * 8
  JX = RoomInfo[V] * 8
  inc V
  JY = RoomInfo[V] * 8
  inc V
  CgWho = RoomInfo[V]
  inc V
  CgX = RoomInfo[V] * 8
  inc V
  CgY = RoomInfo[V] * 8
  inc V
  ExC = RoomInfo[V]
  inc V
  ExR = RoomInfo[V]
  ' Friends already freed come along; their cells stay empty
  FolN = 0
  if HasE = 1 then
    Fol[FolN] = 0
    inc FolN
  end if
  if HasJ = 1 then
    Fol[FolN] = 1
    inc FolN
  end if
  if CgWho = 0 then
    if HasE = 1 then CgWho = 255
  end if
  if CgWho = 1 then
    if HasJ = 1 then CgWho = 255
  end if
  for I = 0 to 47
    HX[I] = JX
    HY[I] = JY
    HD[I] = 0
  next
  HP = 0
  JMv = 255
  JDir = 0
  JAnim = 0
  CgOpen = 0
  HasK = 0
  Peb = 3
  PbOn = 0
  Alert = 0
  Spot = 0
  Bars = 255
  Caught = 0
  RoomDone = 0
  Unseen = 1
  LastTX = 0
  InitGuards
  if Room = TitleRoom then return
  ShowStatus
  RoomName
  return
end sub

sub RoomCard:
  MoveGuards
  DrawSprites
  fill 32 count 28 at 2,22
  RoomHint
  Rearm
  wait 30 frames
  wait no fire
  nmi off
  for Tm = 1 to 200
    Rearm
    wait
    nmi off
    if joypad(1).fire then Tm = 200
    if joypad(2).fire then Tm = 200
  next
  Rearm
  wait no fire
  nmi off
  return
end sub

sub RoomName:
  fill 32 count 28 at 2,1
  NumU = Room + 1
  print at 2,1, digits$(NumU, 1)
  if Room = 0 then
    print at 4,1, "THE CELL BLOCK"
  elseif Room = 1 then
    print at 4,1, "THE GUARD ROOM"
  elseif Room = 2 then
    print at 4,1, "THE CRYPT"
  elseif Room = 3 then
    print at 4,1, "THE ARMORY"
  elseif Room = 4 then
    print at 4,1, "THE GREAT HALL"
  else
    print at 4,1, "THE WATER GATE"
  end if
  return
end sub

sub RoomHint:
  if Room = 0 then
    print at 2,22, "FIND THE KEY. AVOID LIGHT."
  elseif Room = 1 then
    print at 2,22, "PULL THE LEVER: FREE ERIN."
  elseif Room = 2 then
    print at 2,22, "PUDDLES SPLASH LOUDLY."
  elseif Room = 3 then
    print at 2,22, "FREE JACQUE. USE THE CRATES."
  elseif Room = 4 then
    print at 2,22, "TORCHLIGHT GIVES YOU AWAY."
  else
    print at 2,22, "BEYOND: THE RIVER OF DEATH."
  end if
  return
end sub

sub ShowStatus:
  print at 2,0, "SCORE"
  NumU = Score
  print at 8,0, digits$(NumU, 5)
  print at 14,0, "NIGHT"
  NumU = Night
  print at 20,0, digits$(NumU, 1)
  print at 22,0, "HI"
  NumU = HighScore
  print at 25,0, digits$(NumU, 5)
  for I = 0 to 4
    X = I + 2
    N = 32
    if I < Lives then N = THeart
    put char N at X,23
  next
  for I = 0 to 2
    X = I + 8
    N = 32
    if I < Peb then N = TPeb
    put char N at X,23
  next
  N = 32
  if HasK = 1 then N = TKeyIcon
  put char N at 12,23
  put char TEye at 20,23
  Bars = 255
  ShowBars
  return
end sub

' The eye meter: 8 bars, red from the "HEY?" mark
sub ShowBars:
  N = Alert >> 3
  if N = Bars then return
  ShowBarsNow
  return
end sub

sub ShowBarsNow:
  N = Alert >> 3
  Bars = N
  for I = 0 to 7
    X = I + 22
    V = TBarOff
    if I < Bars then
      V = TBarOn
      if Alert >= 24 then V = TBarHot
    end if
    put char V at X,23
  next
  return
end sub

sub MsgBox:
  for Y = 8 to 13
    fill 32 count 22 at 5,Y
  next
  return
end sub

sub EnterName:
  MsgBox
  print at 6,9, "YOUR INITIALS:"
  print at 6,12, "UP/DOWN, FIRE"
  for I = 0 to 2
    HighName[I] = 65
  next
  I = 0
name_loop:
  for J = 0 to 2
    X = J + 21
    N = HighName[J]
    put char N at X,9
  next
  X = I + 21
  fill 32 count 3 at 21,10
  put char 45 at X,10
  Rearm
  wait 8 frames
  nmi off
  ReadPad
  if AnyFire = 1 then
    play sound SndPick
    Rearm
    wait no fire
    nmi off
    inc I
    if I = 3 then return
    goto name_loop
  end if
  N = HighName[I]
  if Up = 1 then
    inc N
    if N > 90 then N = 65
  end if
  if Dn = 1 then
    dec N
    if N < 65 then N = 90
  end if
  HighName[I] = N
  goto name_loop
end sub

' Re-arm the VDP interrupt before waiting: "nmi on" reads the VDP status,
' so a frame interrupt lost to the guard race cannot freeze the wait
sub Rearm:
  nmi off
  nmi on
  return
end sub

sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 1024 to vram.pattern + Dst16
    copy TileCol count 1024 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 7
  for J = 0 to 6
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' --- Pages ------------------------------------------------------------------

sub TitlePage:
  nmi off
  Room = TitleRoom
  CLen = 5
  Hard = 0
  DrawRoom
  JX = 0
  JY = 200
  for Y = 18 to 21
    fill 32 count 28 at 2,Y
  next
  print at 7,18, "HIGH"
  NumU = HighScore
  print at 12,18, digits$(NumU, 5)
  for J = 0 to 2
    X = J + 18
    N = HighName[J]
    put char N at X,18
  next
  print at 9,19, "NOVICE"
  print at 9,20, "SHADOW (HARD)"
  print at 5,21, "STICK, THEN FIRE TO GO"
  Choice = 0
  play voxpcm SayShh
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait no fire
  nmi off
title_loop:
  inc Tick
  MoveGuards
  Ambience
  DrawSprites
  set sprite 0 to 192,0,0,0
  update sprites
  V = Choice + 19
  put char 62 at 7,V
  ' (the other line's cursor is cleared)
  V = 20 - Choice
  put char 32 at 7,V
  Rearm
  wait
  nmi off
  ReadPad
  if Up = 1 then Choice = 0
  if Dn = 1 then Choice = 1
  if AnyFire = 1 then goto title_go
  goto title_loop
title_go:
  play sound SndPick
  Skill = Choice
  Rearm
  wait no fire
  nmi off
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  HideSprites
  return
end sub

sub EditorialPage:
  nmi off
  HideSprites
  fill mode 2 text color with $10
  backdrop white
  cls
  print at 8,1, "DUNGEON SHADOWS"
  print at 2,3, "AN ORIGINAL GAME FOR THE"
  print at 2,4, "TIMELOST SERIES BY KRIS"
  print at 2,5, "AUSTEN ANDREWS, ARLAN KEITH"
  print at 2,6, "ANDREWS SR. AND JOSEPH C."
  print at 2,7, "GIARRATANO (QUE, 1983)."
  print at 2,9, "THE BOOK'S GAME ESCAPE"
  print at 2,10, "STARTS AT THE RIVER OF"
  print at 2,11, "DEATH. HOW DID THE HEROES"
  print at 2,12, "GET OUT OF THE LORD-"
  print at 2,13, "WIZARD'S DUNGEON? QUIETLY."
  print at 2,15, "A STEALTH GAME: NO WEAPON,"
  print at 2,16, "ONLY SHADOWS AND STRAW."
  print at 2,18, "BY AMY BIENVENU, 2026."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub HowToPage:
  cls
  print at 9,1, "HOW TO SNEAK"
  print at 2,3, "STICK: WALK, SILENT"
  print at 2,4, "LEFT FIRE: RUN, NOISY"
  print at 2,5, "RIGHT FIRE: THROW A PEBBLE"
  print at 4,6, "THE GUARDS GO TO LOOK."
  print at 2,8, "STAY OUT OF THE LANTERNS."
  print at 2,9, "IN TORCHLIGHT, A GUARD WHO"
  print at 2,10, "FACES YOU SEES YOU."
  print at 2,11, "STRAW HIDES YOU, EVEN LIT."
  print at 2,13, "THE EYE FILLS AS YOU ARE"
  print at 2,14, "SEEN. 'HEY?': RUN AND HIDE."
  print at 2,15, "FULL: 'HALT!'"
  print at 2,17, "TAKE THE KEY TO OPEN THE"
  print at 2,18, "STAIRS. FREE ERIN AND"
  print at 2,19, "JACQUE ON THE WAY."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

sub Ending:
  nmi off
  HideSprites
  cls
  print at 5,3, "THE WATER GATE CREAKS."
  print at 3,5, "BELOW, THE RIVER OF DEATH"
  print at 3,6, "ROARS IN THE DARK."
  print at 3,8, "A HUNDRED PRISONERS STILL"
  print at 3,9, "WAIT IN THE CELLS..."
  print at 3,11, "THE ESCAPE GOES ON IN"
  print at 3,12, "ESCAPE, THE BOOK'S GAME."
  print at 3,15, "BUT FIRST, THE LORD-WIZARD"
  print at 3,16, "DOUBLES THE WATCH."
  NumU = Night + 1
  print at 9,19, "NIGHT"
  print at 15,19, digits$(NumU, 1)
  play sound SndEndA
  play sound SndEndB
  Rearm
  wait 120 frames
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

data LaneOrd bytes = 2, 3, 1, 4, 0, 5
data LaneIn bytes = 1, 2, 255, 255, 3, 4
data PerpA bytes = 2, 3, 1, 0
data PerpB bytes = 3, 2, 0, 1
data RevD bytes = 1, 0, 3, 2
data DDX bytes = 0, 0, 255, 1
data DDY bytes = 1, 255, 0, 0
data SmpX bytes = 3, 12, 3, 12
data SmpY bytes = 3, 3, 12, 12
data Arc bytes = 0, 2, 4, 6, 7, 8, 9, 10, 10, 10, 10, 9, 8, 7, 6, 4, 2, 0, 0

data TilePat bytes
  $00,$20,$00,$04,$00,$80,$02,$00,$88,$22,$88,$22,$88,$22,$88,$22
  $92,$49,$24,$92,$4A,$24,$91,$48,$00,$60,$9F,$95,$60,$00,$00,$00
  $00,$10,$38,$7C,$38,$10,$00,$00,$00,$40,$20,$10,$08,$3C,$3C,$00
  $00,$02,$04,$08,$10,$3C,$3C,$00,$FF,$00,$7F,$00,$3F,$00,$1F,$00
  $00,$38,$7E,$FF,$7C,$18,$00,$00,$00,$82,$44,$28,$10,$28,$46,$C0
  $49,$49,$49,$49,$49,$49,$49,$49,$00,$60,$93,$0C,$00,$0C,$D2,$20
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
