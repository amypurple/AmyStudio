data TileCol bytes
  $06,$16,$16,$16,$16,$16,$16,$06
  $86,$06,$16,$16,$06,$16,$86,$06
  $86,$18,$18,$18,$18,$81,$81,$81
  $86,$18,$18,$18,$81,$81,$81,$81
  $81,$81,$81,$81,$18,$18,$18,$86
  $81,$81,$81,$18,$18,$18,$18,$86
  $0E,$01,$01,$01,$01,$01,$01,$0E
  $0E,$B1,$B1,$B1,$B1,$B1,$B1,$0E
  $0E,$B1,$B1,$B1,$B1,$B1,$B1,$0E
  $0E,$1B,$1B,$1B,$1B,$1B,$1B,$0E
  $0E,$0B,$0B,$0B,$0B,$0B,$0B,$0E
  $0E,$01,$01,$01,$01,$01,$01,$0E
  $0E,$81,$81,$81,$81,$81,$81,$0E
  $0E,$81,$81,$81,$81,$81,$81,$0E
  $0E,$18,$18,$18,$18,$18,$18,$0E
