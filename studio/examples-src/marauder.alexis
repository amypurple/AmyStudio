data SpritePat bytes
  $00,$00,$00,$01,$07,$09,$11,$11,$0F,$07,$02,$1F,$00,$00,$00,$00
  $00,$00,$00,$80,$E0,$F1,$FF,$F1,$F0,$E0,$40,$F8,$00,$00,$00,$00
  $00,$00,$3F,$00,$00,$06,$0E,$0E,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$FC,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$07,$00,$00,$06,$0E,$0E,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$E0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$7F,$FF,$7F,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$26,$FA,$FE,$FA,$26,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$FC,$FC,$FC,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$02,$01,$05,$0F,$05,$01,$02,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$40,$80,$A0,$F0,$A0,$80,$40,$00,$00,$00,$00,$00
  $00,$10,$09,$05,$23,$1F,$0F,$BF,$0F,$1F,$23,$05,$09,$10,$00,$00
