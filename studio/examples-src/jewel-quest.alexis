cartridge "JEWEL QUEST/BOB BLACKMER/1985"

' JEWEL QUEST
' A ColecoVision game based on "Jewel Quest" by Bob Blackmer, Ahoy!
' December 1985 (Commodore 64, BASIC with a small machine-language core).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/jewelquest.bas, including the machine code in its DATA
' lines), the game is built for the ColecoVision: smooth 16 x 16 sprites
' (a two-colour gyrocopter with a turning rotor, walking robot guards, a
' gem that changes colour), tiled velvet ledges, sound effects and an
' original title tune.
'
' The game: fly a gyrocopter in the jewel room and gather the ten jewels
' of each of nine levels. One jewel at a time sits on a velvet ledge; touch
' it to take it and the next one appears. The copter sinks unless you
' lift it. Touching the velvet (the ledges and the floor) or a robot
' guard saps your energy; at zero the game is over. Finish level 9 and
' you are congratulated.
'
' From the original: the room (two ledges, a long ledge, two ledges, a
' small ledge, the velvet floor; four guard lanes, the top one and one
' under each row of ledges, the first and third going right, the second
' and fourth left, all guards in step, as the listing's machine code at
' $C059 moves them); the ten jewel places and their order (DATA 740-750);
' energy 99, one point a hit (the routine at $C0C4), the game over at 0;
' ten jewels a level, nine levels, the congratulation; sinking at half the
' speed of lifting (1 and 2 pixels a pass), sideways four times the
' sinking speed (4 pixels a pass); the guards at double speed from level 8.
'
' Liberties: the speeds are per frame (sinking 6/16, lifting 12/16 and
' sideways 1 pixel); the guards glide smoothly instead of jumping a
' character at a time, and they speed up a little every level (the
' original only from level 8); they leave by a hatch at the end of their
' lane and come back out of the one at the start, instead of wrapping
' round the screen edge. The C64 took a point of energy every pass in
' contact (a pass had a delay loop); here a point every 5 frames of
' contact (12 a second). The copter stops at the side walls (the C64 sent
' it back to the left edge). Stick up lifts as well as the buttons. A
' level banner between levels. The F1 pause and the Y/N play-again
' question are gone (house rules: no keypad; the title follows).
'
' Controls: either controller; stick left/right flies sideways, a button
' or stick up lifts the copter. On the title, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given (bug
' 25). Nothing flashes faster than 3 Hz (the gem changes colour every 24
' frames, the rotor turns every 10).

const TWall = 128
const TRail = 129
const THatchl = 130
const THatchr = 131
const TVell = 132
const TVelm = 133
const TVelr = 134
const SCopr0b = 0
const SCopr0r = 4
const SCopr1b = 8
const SCopr1r = 12
const SCopl0b = 16
const SCopl0r = 20
const SCopl1b = 24
const SCopl1r = 28
const SGem = 32
const SRob0 = 36
const SRob1 = 40
const NTiles8 = 56
const SprBytes = 352
const SndTuneA = 1
const SndTuneB = 2
const SndThrust = 3
const SndHit = 4
const SndGem = 5
const SndLevel = 6
const SndStart = 7
const SndOver = 8
const SndWin = 9
const NSpr = 7
const NPlat = 7
const XMin = 256
const XMax = 3328
const YMin = 208
const YMax = 2688
const Sink = 6
const Lift = 12
const Side = 16
const GLoop = 3456
const GShow = 193
const HitN = 5
const MsgN = 120

record Plat:
  u8 Row
  u8 C1
  u8 C2
end record

record Craft:
  u16 X16
  u16 Y16
  u8 Face
  u8 Hurt
end record

' the velvet: two ledges, the long ledge, two ledges, the small ledge, the
' floor
data PlatT records Plat
  6,5,11
  6,20,26
  11,9,22
  16,5,11
  16,20,26
  20,14,17
  22,2,29
end data
' the ten jewels in the original's order: gem centre (pixels), ledge row
data JCx bytes
  68, 188, 128, 52, 204, 128, 92, 164, 84, 172
end data
data JRow bytes
  6, 6, 11, 16, 16, 20, 11, 11, 16, 16
end data
' guard lanes (rows); the guards' speed by level in 1/16 pixel a frame
data LaneRow bytes
  2, 7, 12, 18
end data
data LaneCol bytes
  3, 7, 13, 5
end data
data GSpdT bytes
  0, 16, 17, 18, 19, 20, 21, 22, 34, 36
end data
data GemColT bytes
  7, 13, 11, 15, 3, 9
end data

Plat Plats[NPlat]
Craft Cop
bcd digits 2 Energy = 99
u16 TzLeft = 0
u8 TzOn = 0
u16 Gpos = 0
u16 W16 = 0
u16 NumU = 0
u8 Gp = 0
u8 Lv = 1
u8 Jn = 0
u8 Over = 0
u8 Phase = 0
u8 HitT = 0
u8 ThrT = 0
u8 MsgT = 0
u8 AnimT = 0
u8 RotF = 0
u8 GemT = 0
u8 GemI = 0
u8 Px = 0
u8 Py = 0
' the copter's box and the other box for BoxHit
u8 CL = 0
u8 CR = 0
u8 CT = 0
u8 CB = 0
u8 OL = 0
u8 OR2 = 0
u8 OT = 0
u8 OB = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Li = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table JqSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  copy PlatT to Plats
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  Phase = 3
  mute all
  if Over = 2 then
    print at 6,9, "                    "
    print at 6,10, "  CONGRATULATIONS!  "
    print at 6,11, " ALL NINETY JEWELS! "
    print at 6,12, "                    "
    play sound SndWin
  else
    print at 9,9, "              "
    print at 9,10, "  GAME  OVER  "
    print at 9,11, "              "
    play sound SndOver
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveGuards
  if HitT > 0 then dec HitT
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then
      print at 10,9, "          "
    end if
    return
  end if
  MoveCopter
  Touch
  if Over > 0 then return
  if JewelHit() = 1 then Collect
  return
end sub

' all guards in step: one position along the lane, 0-192 in sight, then
' a short time behind the hatches
sub MoveGuards:
  W16 = GSpdT[Lv]
  Gpos = Gpos + W16
  if Gpos >= GLoop then Gpos = Gpos - GLoop
  W16 = Gpos >> 4
  Gp = W16
  return
end sub

' guard X for lane L: lanes 0 and 2 go right, 1 and 3 left
function GuardX(u8 L) as u8
  select case L
  case 0, 2
    return Gp + 16
  case else
    return 208 - Gp
  end select
  return 0

' the copter: sink unless lifted, sideways at a steady speed, walls round
' the room
sub MoveCopter:
  V = J1 | J2
  K = V & 17
  if Btn > 0 then K = 1
  if K > 0 then
    if Cop.Y16 < YMin + Lift then
      Cop.Y16 = YMin
    else
      Cop.Y16 = Cop.Y16 - Lift
    end if
    if ThrT = 0 then
      play sound SndThrust
      ThrT = 6
    end if
  else
    Cop.Y16 = Cop.Y16 + Sink
    if Cop.Y16 > YMax then Cop.Y16 = YMax
  end if
  if ThrT > 0 then dec ThrT
  K = V & 4
  if K > 0 then
    Cop.Face = 1
    if Cop.X16 < XMin + Side then
      Cop.X16 = XMin
    else
      Cop.X16 = Cop.X16 - Side
    end if
  end if
  K = V & 8
  if K > 0 then
    Cop.Face = 0
    Cop.X16 = Cop.X16 + Side
    if Cop.X16 > XMax then Cop.X16 = XMax
  end if
  CopBox
  return
end sub

' pixel position and the copter's box (the body and pods, not the tail)
sub CopBox:
  W16 = Cop.X16 >> 4
  Px = W16
  W16 = Cop.Y16 >> 4
  Py = W16
  CL = Px + 2
  CR = Px + 13
  CT = Py + 3
  CB = Py + 14
  return
end sub

function BoxHit as u8
  if CR < OL then return 0
  if OR2 < CL then return 0
  if CB < OT then return 0
  if OB < CT then return 0
  return 1

' 1 when the copter touches any velvet
function VelvetHit as u8
  for Pi = 0 to NPlat - 1
    OT = Plats[Pi].Row << 3
    OB = OT + 7
    OL = Plats[Pi].C1 << 3
    V = Plats[Pi].C2 << 3
    OR2 = V + 7
    if BoxHit() = 1 then return 1
  next
  return 0

' 1 when the copter touches a guard in sight
function GuardHit as u8
  if Gp >= GShow then return 0
  for Li = 0 to 3
    X = GuardX(Li)
    OL = X + 2
    OR2 = X + 13
    OT = LaneRow[Li] << 3
    OB = OT + 7
    if BoxHit() = 1 then return 1
  next
  return 0

function JewelHit as u8
  C = JCx[Jn]
  OL = C - 4
  OR2 = C + 3
  V = JRow[Jn] << 3
  OT = V - 6
  OB = V - 1
  return BoxHit()

' velvet or a guard: a point of energy, then one every HitN frames
sub Touch:
  Cop.Hurt = 0
  K = VelvetHit()
  K = K | GuardHit()
  if K = 0 then return
  Cop.Hurt = 1
  if HitT > 0 then return
  HitT = HitN
  dec Energy
  play sound SndHit
  ShowEnergy
  if Energy = 0 then Over = 1
  return
end sub

sub Collect:
  inc Jn
  if Jn < 10 then
    play sound SndGem
    ShowJewels
    return
  end if
  Jn = 0
  inc Lv
  if Lv > 9 then
    Lv = 9
    Over = 2
    return
  end if
  ShowHud
  print at 10,9, " LEVEL "
  NumU = Lv
  print at 17,9, digits$(NumU, 1)
  print at 18,9, "  "
  MsgT = MsgN
  play sound SndLevel
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the rotor, pods and window, 1 the body, 2-5 the guards, 6 the
' jewel
sub DrawSprites:
  inc AnimT
  if AnimT >= 10 then
    AnimT = 0
    RotF = RotF ^ 1
  end if
  inc GemT
  if GemT >= 24 then
    GemT = 0
    inc GemI
    if GemI >= 6 then GemI = 0
  end if
  Y = Py - 1
  K = Cop.Face << 4
  V = RotF << 3
  K = K + V
  C = 11
  if Cop.Hurt = 1 then C = 6
  if Phase = 2 then
    J = K + 4
    set sprite 0 to Y,Px,J,15
    set sprite 1 to Y,Px,K,C
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  end if
  V = Tick >> 3
  V = V & 1
  K = V << 2
  K = K + SRob0
  for Ri = 0 to 3
    J = Ri + 2
    if Gp < GShow then
      X = GuardX(Ri)
      Y = LaneRow[Ri] << 3
      Y = Y - 1
      C = LaneCol[Ri]
      set sprite J to Y,X,K,C
    else
      set sprite J to 192,0,0,0
    end if
  next
  if MsgT > 0 then
    set sprite 6 to 192,0,0,0
  else
    X = JCx[Jn] - 8
    Y = JRow[Jn] << 3
    Y = Y - 17
    C = GemColT[GemI]
    set sprite 6 to Y,X,SGem,C
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "ENERGY"
  print at 12,1, "JEWELS"
  print at 23,1, "LEVEL"
  ShowEnergy
  ShowJewels
  NumU = Lv
  print at 29,1, digits$(NumU, 1)
  return
end sub

sub ShowEnergy:
  print at 9,1, Energy
  return
end sub

sub ShowJewels:
  NumU = Jn
  print at 19,1, digits$(NumU, 2)
  return
end sub

' one ledge (Pi): its ends and the middle (a FOR with variable limits)
sub DrawPlat:
  Y = Plats[Pi].Row
  X = Plats[Pi].C1
  J = Plats[Pi].C2
  put char TVell at X,Y
  put char TVelr at J,Y
  X = X + 1
  J = J - 1
  for C = X to J
    put char TVelm at C,Y
  next
  return
end sub

sub DrawField:
  for Ri = 2 to 23
    fill TWall count 32 at 0,Ri
  next
  for Li = 0 to 3
    Y = LaneRow[Li]
    fill TRail count 26 at 3,Y
    put char THatchl at 2,Y
    put char THatchr at 29,Y
  next
  for Pi = 0 to NPlat - 1
    DrawPlat
  next
  fill TVelm count 2 at 0,22
  fill TVelm count 2 at 30,22
  return
end sub

sub NewGame:
  Energy = 99
  Lv = 1
  Jn = 0
  Gpos = 0
  Gp = 0
  NewScreen
  DrawField
  ShowHud
  ' the copter starts over the middle, under the top lane
  Cop.X16 = 1792
  Cop.Y16 = 480
  Cop.Face = 0
  Cop.Hurt = 0
  CopBox
  HitT = 0
  ThrT = 0
  MsgT = 0
  Over = 0
  Phase = 2
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the room with its guards and a jewel, the tune once
sub TitlePage:
  Phase = 1
  Lv = 1
  Jn = 0
  NewScreen
  DrawField
  print at 10,3, "JEWEL QUEST"
  print at 8,4, "BY BOB BLACKMER"
  print at 6,8, "GATHER TEN JEWELS"
  print at 6,9, "ON EACH OF NINE LEVELS"
  print at 5,13, "DON'T TOUCH THE VELVET"
  print at 5,14, "OR THE ROBOT GUARDS"
  print at 8,21, "PRESS THE BUTTON"
  print at 2,1, "AHOY! DECEMBER 1985"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  MoveGuards
  DrawSprites
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub CreditsPage:
  Phase = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "JEWEL QUEST"
  print at 2,5, "BASED ON JEWEL QUEST BY"
  print at 2,6, "BOB BLACKMER, AHOY!"
  print at 2,7, "DECEMBER 1985 (C64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: VELVET VAULT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

