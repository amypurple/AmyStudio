  $00,$00,$10,$00,$00,$00,$42,$00
  $00,$00,$00,$00,$00,$00,$00,$44
  $03,$84,$87,$87,$84,$84,$00,$44
  $C0,$21,$E1,$E1,$21,$21,$00,$44
  $C0,$C0,$80,$00,$80,$80,$92,$24
  $00,$00,$00,$00,$00,$00,$24,$49
  $03,$03,$01,$00,$01,$01,$23,$48
end data
