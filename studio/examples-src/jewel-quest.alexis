asm {
JqThrust:
    db $00,$00,$96,$02,$00,$00,$C6,$03,$10
JqHit:
    db $00,$00,$14,$02,$00,$00,$35,$03,$10
JqGem:
    db $40,$47,$10,$03,$40,$35,$10,$03,$40,$2A,$20,$08,$50
JqLevel:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$8F,$20,$06,$40,$6B,$20,$14
    db $50
JqStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0E,$50
JqOver:
    db $40,$D6,$10,$0C,$40,$F0,$20,$0C,$40,$1D,$21,$0C,$40,$AB,$21,$1E,$50
JqWin:
    db $40,$D6,$10,$08,$40,$AA,$10,$08,$40,$8F,$10,$08,$40,$6B,$10,$08,$40,$55,$10,$08,$40,$47,$20,$1E
    db $50

JqSoundTable:
    dw JqTuneMel,$702B
    dw JqTuneBass,$7035
    dw JqThrust,$703F
    dw JqHit,$703F
    dw JqGem,$7049
    dw JqLevel,$7049
    dw JqStart,$7049
    dw JqOver,$7049
    dw JqWin,$7049
; Velvet Vault (original)
; Tiny Sound, 8 frames per step
JqTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$24,$01,$28,$01,$01,$26,$24,$01,$23,$01
    db $21,$01,$01,$01,$1F,$01,$23,$01,$26,$01,$01,$24,$23,$01,$21,$01
    db $1F,$01,$01,$01,$1C,$01,$21,$01,$24,$01,$28,$01,$2B,$01,$28,$01
    db $26,$01,$23,$01,$24,$01,$21,$01,$23,$01,$20,$01,$21,$01,$01,$01
    db $00,$01,$01
    db $FF
JqTuneBass:
    db $84
    dw sndtiny_2
    db 8
