' RURAL PURSUITS helpers

sub RuStats:
  print at 2,1, "RURAL PURSUITS"
  print at 21,1, "YEAR"
  NumU = Yr
  print at 26,1, width$(NumU, 2)
  print at 2,9, "MONEY $"
  Qx = Mo
  X = 10
  Y = 9
  PrintQ
  Qs = 100
  Bc = TBy0
  Bar
  print at 2,10, "WORKERS"
  Qx = La
  X = 10
  Y = 10
  PrintQ
  Qs = 14
  Bc = TBg0
  Bar
  print at 2,11, "ACRES"
  Qx = Ac
  X = 10
  Y = 11
  PrintQ
  print at 17,11, "COST/ACRE"
  Qx = Cs
  X = 27
  Y = 11
  PrintQ3
  print at 2,12, "CORN"
  Qx = Cn
  X = 10
  Y = 12
  PrintQ
  Qs = 10
  Bc = TBy0
  Bar
  print at 2,13, "BARLEY"
  Qx = Ba
  X = 10
  Y = 13
  PrintQ
  Bc = TBg0
  Bar
  print at 2,14, "WHEAT"
  Qx = Wh
  X = 10
  Y = 14
  PrintQ
  Bc = TBr0
  Bar
  return
end sub

' ScaleDiv: Qr = INT(Qn * Kc / Qs), without overflow:
' (Qn / Qs) * Kc + ((Qn mod Qs) * Kc) / Qs
sub ScaleDiv:
  Qb = Kc
  Qc = Qn / Qs
  Qr = Qc * Qb
  Qc = Qn % Qs
  Qc = Qc * Qb
  Qc = Qc / Qs
  Qr = Qr + Qc
  return
end sub

' ---------------------------------------------------------------------------
' CHAIRMAN helpers

' ChReport: the shop floor report; Cend 1 bankrupt, 2 retired
sub ChReport:
  ChStats
  ' the book adds stock (a count) to capital (in dollars)
  Qa = St * 100
  Ti = Qa
  Tj = Ca + Ti
  if Tj < 100 then
    Say
    print at 2,16, "YOU'RE BANKRUPT!!"
    print at 2,17, "OH THE SHAME OF IT!!"
    print at 2,18, "STILL, YOU KEPT THE BUSINESS"
    print at 2,19, "GOING FOR"
    NumU = We
    print at 12,19, width$(NumU, 4)
    print at 17,19, "WEEKS"
    play sound SndLose
    Cend = 1
    return
  end if
  if Tj > 999900 then
    Say
    print at 2,16, "YOU'VE MADE $10,000 AND"
    print at 2,17, "CAN NOW RETIRE..."
    play sound SndWin
    Celebrate
    Cend = 2
  end if
  return
end sub

sub ChStats:
  print at 2,1, "THE BOARD"
  print at 18,1, "WEEK"
  NumU = We
  print at 23,1, width$(NumU, 4)
  print at 2,9, "CAPITAL"
  fill 32 count 18 at 11,9
  Tj = Ca
  if Ca < 0 then
    print at 11,9, "-"
    Tj = 0 - Ca
  end if
  Qx = Tj
  X = 12
  Y = 9
  PrintMoney
  print at 2,10, "STOCK"
  Qx = St
  X = 11
  Y = 10
  PrintQ
  Ka = ProdStart[Prod]
  Kc = ProdLen[Prod]
  X = 18
  fill 32 count 12 at 18,10
  for J = 1 to Kc
    V = ProdText[Ka]
    put char V at X,10
    inc X
    inc Ka
  next
  print at 2,11, "SELL AT"
  Qx = Sp
  X = 11
  Y = 11
  PrintMoney
  print at 2,12, "COST"
  Qx = Co
  X = 11
  Y = 12
  PrintMoney
  print at 2,13, "WORKERS"
  Qx = Wo
  X = 11
  Y = 13
  PrintQ
  print at 18,13, "MAKE"
  Qa = Pr * Wo
  Qx = Qa
  X = 23
  Y = 13
  PrintQ
  print at 2,14, "WAGES"
  Qx = Wa
  X = 11
  Y = 14
  PrintMoney
  print at 18,14, "EACH"
  return
end sub

' ---------------------------------------------------------------------------
' Numbers and screens

' GameScreen: the picture of game Ka (1-3) in rows 2-7
sub GameScreen:
  NewScreen
  backdrop black
  if Ka = 1 then
    copy PlanetPat count PlanetN to vram.pattern + PicBase8
    copy PlanetCol count PlanetN to vram.color + PicBase8
  end if
  if Ka = 2 then
    copy FarmPat count FarmN to vram.pattern + PicBase8
    copy FarmCol count FarmN to vram.color + PicBase8
  end if
  if Ka = 3 then
    copy FactoryPat count FactoryN to vram.pattern + PicBase8
    copy FactoryCol count FactoryN to vram.color + PicBase8
  end if
  Kc = 0
  for Y = 2 to 7
    for X = 8 to 23
      if Ka = 1 then V = PlanetMap[Kc]
      if Ka = 2 then V = FarmMap[Kc]
      if Ka = 3 then V = FactoryMap[Kc]
      put char V at X,Y
      inc Kc
    next
  next
  ShowScreen
  return
end sub

' Say: the message rows cleared
sub Say:
  for Y = 16 to 21
    fill 32 count 28 at 2,Y
  next
  return
end sub

' PrintQ: Qx at X, Y (9 places cleared first)
sub PrintQ:
  fill 32 count 9 at X,Y
  Qp = Qx
  Qt = Qx
  Kc = 0
pq_split:
  Qx = Qt % 10
  Low8
  Pd[Kc] = Lb
  inc Kc
  Qt = Qt / 10
  if Qt > 0 then goto pq_split
  ' the digits, most significant first; X ends after the last
pq_put:
  if Kc > 0 then
    dec Kc
    V = Pd[Kc] + 48
    put char V at X,Y
    inc X
    goto pq_put
  end if
  Qx = Qp
  return
end sub

sub PrintQ3:
  fill 32 count 3 at X,Y
  Kc = 3
  Qp = Qx
  Qt = Qx
  Kc = 0
  goto pq_split
end sub

sub PrintQ17:
  X = 16
  Y = 17
  PrintQ
  return
end sub

' PrintMoney: Qx cents as $D.CC at X, Y
sub PrintMoney:
  fill 32 count 12 at X,Y
  print at X,Y, "$"
  inc X
  Qn = Qx
  Qx = Qn / 100
  W = Y
  PrintQ
  print at X,Y, "."
  inc X
  Qx = Qn % 100
  Low8
  NumU = Lb / 10
  print at X,Y, width$(NumU, 1)
  inc X
  NumU = Lb % 10
  print at X,Y, width$(NumU, 1)
  return
end sub

' Bar: Qx / Qs pixels (no more than 80) at columns 20-29 of row Y, colour
' tiles from Bc
sub Bar:
  Qa = Qx / Qs
  if Qa > 80 then Qa = 80
  Qx = Qa
  Low8
  for J = 0 to 9
    V = J << 3
    W = 0
    if Lb > V then W = Lb - V
    if W > 8 then W = 8
    W = W + Bc
    X = J + 20
    put char W at X,Y
  next
  return
end sub

' Low8: Lb = the low byte of Qx
sub Low8:
  call asm SmLow8
  return
end sub

' DigitsIn: a number of Nd digits on row 21 (from Qv); Res 1 to leave
sub DigitsIn:
  Qa = Qv
  for K = 1 to 6
    Dg[K] = 0
  next
  K = Nd
di_split:
  if K > 0 then
    Qb = Qa % 10
    Qx = Qb
    Low8
    Dg[K] = Lb
    Qa = Qa / 10
    dec K
    goto di_split
  end if
  Pos = Nd
  Inp = 1
  print at 2,22, "BUTTON: OK     2ND: MENU"
  WasBtn = 1
  WasBtn2 = 1
  Res = 1
di_loop:
  if Res = 1 then
    fill 32 count 16 at 12,21
    for K = 1 to Nd
      X = K << 1
      X = X + 12
      NumU = Dg[K]
      print at X,21, width$(NumU, 1)
      if K = Pos then
        dec X
        print at X,21, ">"
      end if
    next
    Res = 0
  end if
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then
      if Pos > 1 then dec Pos
    end if
    if Rt1 = 1 then
      if Pos < Nd then inc Pos
    end if
    if Up1 = 1 then
      V = Dg[Pos] + 1
      if V > 9 then V = 0
      Dg[Pos] = V
    end if
    if Dn1 = 1 then
      V = Dg[Pos]
      if V = 0 then
        V = 9
      else
        dec V
      end if
      Dg[Pos] = V
    end if
    play sound SndClick
    Res = 1
  end if
  if Press2 = 1 then
    Inp = 0
    Res = 1
    return
  end if
  if Press = 0 then goto di_loop
  Inp = 0
  Qv = 0
  for K = 1 to Nd
    Qv = Qv * 10
    V = Dg[K]
    Qa = V
    Qv = Qv + Qa
  next
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  Res = 0
  return
end sub

' RndOf: Qr = INT(RND * Qn), RND a 16-bit fraction (Rw / 65536)
sub RndOf:
  Rnd
  Rw = Rs
  Qb = Rw
  Qa = Qn >> 16
  Qr = Qa * Qb
  Qa = Qn & 65535
  Qa = Qa * Qb
  Qa = Qa >> 16
  Qr = Qr + Qa
  return
end sub

' Celebrate: three bursts of sparks
sub Celebrate:
  clear sprites
  set sprite count 8
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 64
      if CbN = 2 then
        CbX[CbK] = 168
        CbY[CbK] = 44
      end if
      if CbN = 3 then
        CbX[CbK] = 120
        CbY[CbK] = 88
      end if
    next
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        set sprite CbK to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  HideSprites
  return
end sub

' ---------------------------------------------------------------------------
' Common

' EndWait: Res 0 for the button (again), 1 for the second (menu)
sub EndWait:
  print at 2,22, "BUTTON: AGAIN  2ND: MENU"
  for J = 1 to 40
    Frame1
  next
  WasBtn = 1
  WasBtn2 = 1
ew_loop:
  Frame1
  Rnd
  ReadPad
  if Press2 = 1 then
    HideSprites
    Res = 1
    return
  end if
  if Press = 0 then goto ew_loop
  HideSprites
  Res = 0
  return
end sub

sub Pause:
  for J = 1 to 60
    Frame1
  next
  return
end sub

' RndN: V from 0 to Nr - 1
sub RndN:
  Rnd
  Uw = Rb
  Ub = 0
  for J = 1 to Nr
    Ub = Ub + Uw
  next
  Ub = Ub >> 8
  V = Ub
  return
end sub

sub Rnd:
  Rt16 = Rs << 7
  Rs ^= Rt16
  Rt16 = Rs >> 9
  Rs ^= Rt16
  Rt16 = Rs << 8
  Rs ^= Rt16
  Rt16 = Rs >> 8
  Rb = Rt16
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 3
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  sprites stable 0 to 0
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  Ka = 1
  GameScreen
  backdrop dark blue
  print at 9,1, "SIMULATIONS"
  print at 7,10, "MISTRESS OF XENOPHOBIA"
  print at 7,11, "RURAL PURSUITS"
  print at 7,12, "CHAIRMAN OF THE BOARD"
  print at 7,14, "HOW TO PLAY"
  print at 7,15, "CREDITS"
  print at 3,20, "FROM TIM HARTNELL'S GIANT"
  print at 3,21, "BOOK OF COMPUTER GAMES"
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  WasBtn = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 4 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 10 to 15
    print at 5,I, " "
  next
  Y = Menu + 10
  if Menu >= 3 then inc Y
  print at 5,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  TzOn = 0
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "XENOPHOBIA: RULE 20 YEARS."
  print at 2,4, "EACH YEAR BUY LAND TO FARM"
  print at 2,5, "AND FOOD ($10 EACH). FEED"
  print at 2,6, "THE PEASANTS OR THEY REVOLT."
  print at 2,8, "RURAL PURSUITS: FARM FOR 10"
  print at 2,9, "YEARS: ACRES, PAY, AND THE"
  print at 2,10, "SHARES OF CORN AND WHEAT."
  print at 2,11, "POOR PAY: WORKERS LEAVE."
  print at 2,13, "CHAIRMAN: RUN A FACTORY TILL"
  print at 2,14, "CAPITAL AND STOCK PASS"
  print at 2,15, "$10,000. HIRE, FIRE, MAKE,"
  print at 2,16, "RAISE PRICES (SALES DROP)."
  print at 2,18, "NUMBERS: LEFT/RIGHT A DIGIT,"
  print at 2,19, "UP/DOWN: CHANGE. BUTTON: OK."
  print at 2,20, "2ND BUTTON: BACK TO MENU."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,1, "SIMULATIONS"
  print at 2,3, "MISTRESS OF XENOPHOBIA"
  print at 2,4, "(AFTER ALASTAIR GOURLAY),"
  print at 2,5, "RURAL PURSUITS (AFTER"
  print at 2,6, "STEPHEN GLEN) AND CHAIRMAN"
  print at 2,7, "OF THE BOARD FROM TIM"
  print at 2,8, "HARTNELL'S GIANT BOOK OF"
  print at 2,9, "COMPUTER GAMES (BALLANTINE"
  print at 2,10, "BOOKS, 1984; INTERFACE"
  print at 2,11, "PUBLICATIONS, 1983)."
  print at 2,13, "MUSIC: AFFAIRS OF STATE"
  print at 2,14, "(ORIGINAL)."
  print at 2,16, "COLECOVISION VERSION BY"
  print at 2,17, "AMY BIENVENU, 2026."
  PageWait
  return
end sub

