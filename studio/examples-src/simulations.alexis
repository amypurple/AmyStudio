  tile screen
  set sound table SmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then goto rural
  if Menu = 2 then goto chairman
  if Menu = 3 then
    RulesPage
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' MISTRESS OF XENOPHOBIA

xeno:
  ' the book: P = 200 + INT(RND*300), U = 700 + INT(RND*500), L = 70 + INT(RND*50)
  Qn = 300
  RndOf
  Xp = Qr + 200
  Qn = 500
  RndOf
  Xu = Qr + 700
  Qn = 50
  RndOf
  Xl = Qr + 70
  Xy = 1
  Xend = 0
  Ka = 1
  GameScreen
xe_year:
  XeStats
  play sound SndReport
  Say
  print at 2,16, "A REPORT FROM THE OFFICE OF"
  print at 2,17, "INFORMATION, MISTRESS..."
  print at 2,18, "TIME TO ISSUE A DECREE..."
  print at 2,19, "HOW MUCH LAND IS TO BE"
  print at 2,20, "FARMED THIS YEAR?"
  Qv = 0
  Nd = 6
  DigitsIn
  if Res = 1 then goto title
  Xw = Qv
  ' the book: U = U - W*10, bankrupt below 1
  Qa = Xw * 10
  if Qa >= Xu then goto xe_broke
  Xu = Xu - Qa
  Xl = Xl + Xw
  XeStats
  play sound SndCoin
  Say
  print at 2,16, "AND HOW MUCH WILL YOU"
  print at 2,17, "SPEND ON FOOD FOR THE"
  print at 2,18, "PEASANTS?"
  Qv = 0
  Nd = 6
  DigitsIn
  if Res = 1 then goto title
  Xf = Qv
  Qa = Xf * 10
  if Qa >= Xu then goto xe_broke
  Xu = Xu - Qa
  XeStats
  play sound SndCoin
  ' R = INT(RND*10) + 1; the food feeds W*R*5
  Nr = 10
  RndN
  Xr = V + 1
  Qt = Xf * 5
  Qa = Xr
  Qt = Qt * Qa
  Say
  ' not enough food when P - W*R*5 > P/4, that is 4(P - T) > P
  if Xp > Qt then
    Qa = Xp - Qt
    Qa = Qa * 4
    if Qa > Xp then
      print at 2,16, "OH DEAR!! THERE'S NOT"
      print at 2,17, "ENOUGH FOOD FOR EVERYONE..."
      Pause
      Say
      print at 2,16, "HORRORS, YOUR XENONESS"
      print at 2,17, "THERE'S BEEN A REBELLION!!!"
      print at 2,18, "THE PEASANTS ARE REVOLTING"
      print at 2,19, "(I HAD TO GET THAT LINE IN!)"
      play sound SndRiot
      Riot
      Pause
      Rnd
      if Rb < 51 then
        print at 2,20, "AND YOUR COPS COULDN'T"
        print at 2,21, "STOP THEM"
        play sound SndLose
        goto xe_over
      end if
      print at 2,20, "BUT YOUR RUTHLESS POLICE"
      print at 2,21, "HAVE PUT A STOP TO THAT"
      Pause
      Say
    end if
  end if
  ' P = P + RND*(T - P), up or down
  if Qt >= Xp then
    Qn = Qt - Xp
    RndOf
    Xp = Xp + Qr
  else
    Qn = Xp - Qt
    RndOf
    Xp = Xp - Qr
  end if
  if Xp > 999999999 then Xp = 999999999
  XeStats
  if Xp <= 149 then
    print at 2,16, "THE POPULATION OF XENOPHOBIA"
    print at 2,17, "IS NOW DOWN TO"
    Qx = Xp
    PrintQ17
    print at 2,18, "AND THAT JUST AIN'T ENOUGH,"
    print at 2,19, "YOUR XENONESS"
    play sound SndLose
    goto xe_over
  end if
  ' U = U + INT(P*L)/93 (capped)
  Qa = 4000000000 / Xp
  if Xl > Qa then
    Xu = 999999999
  else
    Qa = Xp * Xl
    Qa = Qa / 93
    Xu = Xu + Qa
    if Xu > 999999999 then Xu = 999999999
  end if
  XeStats
  play sound SndGood
  print at 2,16, "THE HARVEST IS IN, AND THE"
  print at 2,17, "TAXES WITH IT."
  Pause
  if Xy < 20 then
    inc Xy
    goto xe_year
  end if
  Say
  print at 2,16, "WELL, XENOPHOBIC, THAT'S"
  print at 2,17, "THE END OF YOUR 20 YEAR"
  print at 2,18, "DOMINATION. YOU MANAGED TO"
  print at 2,19, "ACCUMULATE $"
  Qx = Xu
  X = 14
  Y = 19
  PrintQ
  print at 2,20, "WHICH AIN'T TOO BAD..."
  play sound SndWin
  Celebrate
  goto xe_over
xe_broke:
  Say
  print at 2,16, "WELL, XENO, THAT'S A FINE"
  print at 2,17, "MESS YOU'VE GOT YOURSELF,"
  print at 2,18, "AND OUR LITTLE PLANET INTO."
  print at 2,19, "THE TREASURY IS BANKRUPT!!"
  print at 2,20, "GUESS WHO BLEW IT?????????"
  play sound SndLose
xe_over:
  Xend = 1
  EndWait
  if Res = 0 then goto xeno
  goto title

' ---------------------------------------------------------------------------
' RURAL PURSUITS

rural:
  ' the book's start: MO 7000-7999, LA 100-1099, AC 300-499, CS 8-12
  Qn = 1000
  RndOf
  Mo = Qr + 7000
  Qn = 1000
  RndOf
  La = Qr + 100
  Qn = 200
  RndOf
  Ac = Qr + 300
  Nr = 5
  RndN
  Cs = V
  Cs = Cs + 8
  Cx = Cs
  Yr = 1
  Ka = 2
  GameScreen
ru_year:
  Ba = 0
  Cn = 0
  Wh = 0
  RuStats
  play sound SndReport
  ' MAX = INT(MO/CS), no more than AC
  Mx = Mo / Cs
  if Mx > Ac then Mx = Ac
  Say
  print at 2,16, "IT WILL BE $"
  Qx = Cs
  X = 14
  Y = 16
  PrintQ
  print at 18,16, "AN ACRE TO"
  print at 2,17, "WORK. THE MOST YOU CAN WORK"
  print at 2,18, "THIS YEAR IS"
  Qx = Mx
  X = 15
  Y = 18
  PrintQ
  print at 20,18, "ACRES."
  print at 2,19, "HOW MUCH LAND DO YOU WANT"
  print at 2,20, "TO HARVEST?"
ru_land:
  Qv = 0
  Nd = 4
  DigitsIn
  if Res = 1 then goto title
  if Qv > Mx then
    play sound SndBad
    goto ru_land
  end if
  Lw2 = Qv
  Qa = Lw2 * Cs
  Mo = Mo - Qa
  RuStats
  play sound SndCoin
  Say
  print at 2,16, "HOW MUCH WILL YOU PAY EACH"
  print at 2,17, "WORKER (UP TO $255)?"
ru_pay:
  Qv = 0
  Nd = 3
  DigitsIn
  if Res = 1 then goto title
  Qa = Qv * La
  if Qv > 255 then
    play sound SndBad
    goto ru_pay
  end if
  if Qa > Mo then
    play sound SndBad
    print at 2,19, "YOU CAN'T AFFORD THAT"
    goto ru_pay
  end if
  Wg = Qv
  Mo = Mo - Qa
  RuStats
  play sound SndCoin
  Say
  print at 2,16, "WHAT PROPORTION (OUT OF TEN)"
  print at 2,17, "DO YOU WISH TO CONCENTRATE"
  print at 2,18, "ON CORN?"
ru_corn:
  Qv = 0
  Nd = 2
  DigitsIn
  if Res = 1 then goto title
  if Qv > 10 then
    play sound SndBad
    goto ru_corn
  end if
  Qx = Qv
  Low8
  Cp = Lb
  Pp = 10 - Cp
  Say
  print at 2,16, "OF THE REMAINING"
  NumU = Pp
  print at 19,16, width$(NumU, 2)
  print at 2,17, "(OUT OF 10), HOW MUCH WHEAT"
  print at 2,18, "WILL YOU PLANT?"
ru_wheat:
  Qv = 0
  Nd = 2
  DigitsIn
  if Res = 1 then goto title
  Qa = Pp
  if Qv > Qa then
    play sound SndBad
    goto ru_wheat
  end if
  Qx = Qv
  Low8
  Wp = Lb
  Pp = Pp - Wp
  Say
  print at 2,16, "STAND BY FOR A YEAR..."
  Pause
  ' the crops: Y = share x L x LA x W, then the book's factors
  Qa = Lw2 * La
  Qa = Qa * Wg
  Qb = Pp
  Qn = Qa * Qb
  Qs = 100000
  Kc = 3
  ScaleDiv
  Ba = Qr
  Qb = Cp
  Qn = Qa * Qb
  Qs = 170000
  Kc = 27
  ScaleDiv
  Cn = Qr
  Qb = Wp
  Qn = Qa * Qb
  Qs = 93000
  Kc = 14
  ScaleDiv
  Wh = Qr
  Tt = Ba + Cn
  Tt = Tt + Wh
  ' RT = INT((.5 + 8.7 BA + 5.94 CO + 2.2 WH)(CS - CX + 1))
  Qa = Ba * 870
  Qb = Cn * 594
  Qa = Qa + Qb
  Qb = Wh * 220
  Qa = Qa + Qb
  Qa = Qa + 50
  Qb = Cs - Cx
  Qb = Qb + 1
  Qa = Qa * Qb
  Rt = Qa / 100
  if Tt = 0 then Rt = 0
  Mo = Mo + Rt
  if Mo > 999999999 then Mo = 999999999
  RuStats
  Say
  Qx = Tt
  X = 2
  Y = 16
  PrintQ
  print at 12,16, "TONS HARVESTED"
  print at 2,17, "AND YOUR TOTAL RETURN WAS $"
  Qx = Rt
  X = 2
  Y = 18
  PrintQ
  play sound SndCoin
  Pause
  ' LA = INT(LA - LA/(W + .01)): LA*100/(100W + 1) leave (rounded up)
  Qa = La * 100
  Qb = Wg * 100
  Qb = Qb + 1
  Qc = Qa / Qb
  Qt = Qc * Qb
  if Qt < Qa then inc Qc
  if Qc >= La then
    La = 0
  else
    La = La - Qc
  end if
  RuStats
  Pause
  if Yr = 10 then
    Say
    print at 2,16, "YOU HAVE SURVIVED FOR 10"
    print at 2,17, "YEARS. CONGRATULATIONS!"
    play sound SndWin
    Celebrate
    goto ru_over
  end if
  if Mo < 1 then
    Say
    print at 2,16, "YOU HAVE GONE BROKE!"
    play sound SndLose
    goto ru_over
  end if
  if La < 1 then
    Say
    print at 2,16, "YOU HAVE NO WORKERS, AND"
    print at 2,17, "HAVE BEEN FORCED TO SELL"
    print at 2,18, "YOUR FARM"
    play sound SndLose
    goto ru_over
  end if
  inc Yr
  ' general costs rise 12.5% a year: CS = CS + INT(12.5 CS / 100)
  Qa = Cs * 125
  Qa = Qa / 1000
  Cs = Cs + Qa
  goto ru_year
ru_over:
  EndWait
  if Res = 0 then goto rural
  goto title

' ---------------------------------------------------------------------------
' CHAIRMAN OF THE BOARD

chairman:
  ' the book's start (in cents)
  Nr = 8
  RndN
  Prod = V
  Qn = 500
  RndOf
  Qa = Qr + 500
  Ti = Qa
  Ca = Ti * 100
  Qn = 500
  RndOf
  St = Qr + 100
  Nr = 5
  RndN
  Qa = V
  Qa = Qa + 10
  Sp = Qa * 100
ch_co:
  Nr = 5
  RndN
  Qa = V
  Qa = Qa + 7
  Co = Qa * 100
  if Co > Sp then goto ch_co
  Nr = 10
  RndN
  Wo = V
  Wo = Wo + 7
  ' WA = 12 + INT(RND*SP)
  Qn = Sp / 100
  RndOf
  Qa = Qr + 12
  Wa = Qa * 100
  Nr = 6
  RndN
  Pr = V
  Pr = Pr + 5
  Nr = 20
  RndN
  Qa = V
  Qa = Qa + 100
  Rc = Qa * 100
  We = 0
  Re = 1
  Ma = 0
  Cend = 0
  Ka = 3
  GameScreen
ch_week:
  inc We
  ChReport
  if Cend > 0 then goto ch_over
  ' staff: hire; if nobody, maybe fire
  Say
  print at 2,16, "HOW MANY PEOPLE DO YOU"
  print at 2,17, "WANT TO HIRE?"
  Qv = 0
  Nd = 3
  DigitsIn
  if Res = 1 then goto title
  Wo = Wo + Qv
  if Qv = 0 then
    ChReport
    if Cend > 0 then goto ch_over
    Say
    print at 2,16, "HOW MANY PEOPLE DO YOU"
    print at 2,17, "WISH TO FIRE?"
ch_fire:
    Qv = 0
    Nd = 3
    DigitsIn
    if Res = 1 then goto title
    if Qv > Wo then
      play sound SndBad
      goto ch_fire
    end if
    if Qv > 0 then
      ' A = INT(RND*A + 1)
      Qn = Qv
      RndOf
      Qa = Qr + 1
      Say
      print at 2,16, "THE UNIONS WILL ALLOW YOU"
      print at 2,17, "TO GET RID OF"
      Qx = Qa
      PrintQ17
      Wo = Wo - Qa
      play sound SndBad
      Pause
    end if
  end if
  ChReport
  if Cend > 0 then goto ch_over
  ' production
  Say
  print at 2,16, "HOW MANY DO YOU WISH TO"
  print at 2,17, "PRODUCE?"
  Ma = 0
ch_make:
  Qv = 0
  Nd = 4
  DigitsIn
  if Res = 1 then goto title
  Ma = Qv
  if Ma > 0 then
    Qa = Ma * Co
    Ti = Qa
    if Ti > Ca then
      print at 2,19, "YOU DO NOT HAVE ENOUGH MONEY"
      play sound SndBad
      goto ch_make
    end if
    Qa = Pr * Wo
    if Ma > Qa then
      print at 2,19, "NOT ENOUGH PEOPLE         "
      play sound SndBad
      goto ch_make
    end if
    ' MA = INT(MA - RND*MA/5)
    Qn = Ma
    RndOf
    Qb = Qr / 5
    Ma = Ma - Qb
    St = St + Ma
    Qa = Co * Ma
    Ti = Qa
    Ca = Ca - Ti
    Say
    print at 2,16, "THE NUMBER ACTUALLY MADE"
    print at 2,17, "THIS WEEK WAS"
    Qx = Ma
    PrintQ17
    play sound SndCoin
    Pause
  end if
  ChReport
  if Cend > 0 then goto ch_over
  ' sales: A = INT(RND*ST/(RE/1000)) + 1, no more than the stock
  Ha = 0
  if St > 0 then
    Qn = St * 1000
    Qn = Qn / Re
    if Qn > St then Qn = St
    RndOf
    Ha = Qr + 1
    if Ha > St then Ha = St
  end if
  St = St - Ha
  Qa = Ha * Sp
  Ti = Qa
  Ca = Ca + Ti
  Say
  print at 2,16, "THE TOTAL NUMBER SOLD IS"
  Qx = Ha
  X = 2
  Y = 17
  PrintQ
  print at 2,18, "THE INCOME FROM THAT SALE"
  print at 2,19, "WAS"
  Qx = Qa
  X = 6
  Y = 19
  PrintMoney
  play sound SndCoin
  ChStats
  Pause
  ' problems: the unions (45% none)
  Un = 0
  Fl = 0
  Su = 0
  Pc = 0
  Rnd
  Rw = Rs
  if Rw >= 29491 then
    Nr = 7
    RndN
    Un = V + 1
    Qb = V
  Qb = Qb + 1
    Qa = Qb + 100
    Wa = Wa * Qa
    Wa = Wa / 100
    Say
    print at 2,16, "THE UNIONS ARE DEMANDING A"
    print at 2,17, "PAY RISE OF"
    NumU = V + 1
    print at 14,17, width$(NumU, 1)
    print at 16,17, "%"
    print at 2,18, "PAY PER EMPLOYEE IS NOW"
    Qx = Wa
    X = 2
    Y = 19
    PrintMoney
    play sound SndBad
    ChStats
    Pause
  end if
  ' a fire (19%)
  Rnd
  Rw = Rs
  if Rw >= 53084 then
    if St > 0 then
      Qn = St / 2
      RndOf
      Qa = Qr + 1
      if Qa > St then Qa = St
      Fl = Qa
      St = St - Qa
      Say
      print at 2,16, "A FIRE IN YOUR WAREHOUSE"
      print at 2,17, "HAS DESTROYED"
      Qx = Qa
      X = 16
      Y = 17
      PrintQ
      print at 2,18, "WORTH"
      Qa = Qa * Sp
      Qx = Qa
      X = 8
      Y = 18
      PrintMoney
      print at 20,18, "RETAIL"
      play sound SndFire
      Riot
      ChStats
      Pause
    end if
  end if
  ' the supplier (30%)
  Rnd
  Rw = Rs
  if Rw < 19661 then
ch_sup:
    ' A = INT(RND*100*CO/7)/100 dollars: RND*CO/7 cents, at least 1
    Qn = Co / 7
    RndOf
    if Qr < 1 then goto ch_sup
    Su = Qr
    Co = Co + Qr
    Say
    print at 2,16, "YOUR MAIN SUPPLIER HAS"
    print at 2,17, "ANNOUNCED A PRICE RISE OF"
    Qx = Qr
    X = 2
    Y = 18
    PrintMoney
    print at 14,18, "EACH"
    play sound SndBad
    ChStats
    Pause
  end if
  ' the price: IF RND < .65 AND MA < SP THEN no chance to raise it
  Rnd
  Rw = Rs
  Res = 0
  if Rw < 42598 then
    Qa = Sp / 100
    if Ma < Qa then Res = 1
  end if
  if Res = 0 then
    Say
    print at 2,16, "YOU HAVE A CHANCE TO RAISE"
    print at 2,17, "YOUR PRICE. WHAT PERCENTAGE"
    print at 2,18, "INCREASE WOULD YOU LIKE?"
    Qv = 0
    Nd = 2
    DigitsIn
    if Res = 1 then goto title
    Qx = Qv
    Low8
    Pc = Lb
    Re = Re + Qv
    Qa = Qv + 100
    Sp = Sp * Qa
    Sp = Sp / 100
    ChStats
  end if
  ' the week's bills: CA = CA - WA*WO - RC
  Qa = Wa * Wo
  Qa = Qa + Rc
  Ti = Qa
  Ca = Ca - Ti
  goto ch_week
ch_over:
  EndWait
  if Res = 0 then goto chairman
  goto title

' ---------------------------------------------------------------------------
' XENOPHOBIA helpers

sub XeStats:
  print at 2,1, "XENOPHOBIA"
  print at 16,1, "YEAR"
  NumU = Xy + 1994
  print at 21,1, width$(NumU, 4)
  print at 2,9, "PEASANTS"
  Qx = Xp
  X = 11
  Y = 9
  PrintQ
  Qs = 25
  Bc = TBg0
  Bar
  print at 2,11, "ACRES"
  Qx = Xl
  X = 11
  Y = 11
  PrintQ
  Qs = 10
  Bc = TBy0
  Bar
  print at 2,13, "TREASURY $"
  Qx = Xu
  X = 13
  Y = 13
  PrintQ
  Qs = 100
  Bc = TBr0
  Bar
  return
end sub

' Riot: the screen shakes in red a moment
sub Riot:
  for J = 1 to 10
    V = J & 1
    if V = 0 then
      backdrop dark red
    else
      backdrop black
    end if
    Frame1
    Frame1
  next
  backdrop black
  return
end sub

