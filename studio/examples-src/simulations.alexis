asm {
; SmLow8: Lb = the low byte of the 32-bit Qx
SmLow8:
    ld a,(AMY_UVAR_Qx)
    ld (AMY_UVAR_Lb),a
    ret

SmHush:
    db $00,$00,$F4,$01,$10
SmClick:
    db $40,$40,$70,$01,$50
SmCoin:
    db $40,$47,$20,$02,$40,$47,$F0,$01,$40,$35,$20,$05,$40,$35,$F0,$01,$50
