cartridge "WORD MATCH/Andy Van Duyne/1983"

' WORD MATCH
' Ported from "Word Match", COMPUTE!'s Gazette, October 1983 (Commodore
' 64 and VIC-20 BASIC; disk 1983-10, files "word match.64" and "word
' match.vic", in orig/). No author is named in the listings. Made for the
' ColecoVision in Amy (the language by Amy Bienvenu) by Claude (an AI
' made by Anthropic) for Amy Studio, 2026.
'
' The original's rules, kept: 12 numbered squares (3 across, 4 down,
' numbered 1-12 left to right) hide 6 pairs of three-letter words, 6
' words drawn at random from the listing's 28 (CAR CAT BOY HAT HIT TOP
' ATE EAT PIT PAT GOT HIM HER WHY HOW TIN ILL WHO RUN YOU ACE BED INK
' AIM ART TOT TIE END) and dealt at random. On a turn the player opens
' square A, then square B (not A, not a square already matched). Same
' word: MATCH, one point, both squares filled with the player's colour
' (red player 1, green player 2), and the SAME player goes again. Not the
' same: NO MATCH, the squares close and the other player goes. After the
' 6th pair, THE GAME IS OVER and the most pairs wins (or IT'S A TIE).
' The original's computer player (name "64" or "VIC") picked both
' squares at random with no memory.
'
' Made for this machine / liberties:
' - Joystick instead of typing square numbers: a cursor of four corners
'   (the player's colour) slides between squares, a button opens one.
'   The keypad is not used. Matched or already-open squares buzz.
' - No names typed: PLAYER 1 / PLAYER 2, or PLAYER 1 / COMPUTER chosen
'   on the title (the original's '64' as player two).
' - The computer has an imperfect memory (new, the original's computer
'   remembered nothing): every square it sees opened, by either player,
'   it remembers one time in two. It takes a pair it remembers, else
'   opens a square it does not remember, then that word's remembered
'   partner if it has one, else another unknown square. Its cursor moves
'   at a visible pace, a square every 8 frames.
' - Pauses: NO MATCH 2 s (the original about 2.5 s), MATCH 1.5 s (the
'   original about 3 s), a computer square about 0.5 s plus moving.
' - Matched squares keep their player's colour (as the C64) with the
'   word gone; open squares are yellow with big letters.
' - Scores of both players always shown on top; the original showed
'   them only through the final WINS line.
' - No WANT ANOTHER? question: the game ends with its message, then a
'   button (or 30 s) goes back to the title.
' - New tiles, sounds after the original's (rising chirp, three-note
'   match, low NO MATCH buzz, falling sweeps at the end) and an original
'   title tune ("Turn It Over").
'
' Controls: either joystick moves the cursor, either button opens a
' square; on the title the stick chooses and a button starts (or opens
' HOW TO PLAY, two pages, or CREDITS).
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const THfill = 128
const THtl = 129
const THtr = 130
const THbl = 131
const THbr = 132
const TSfill = 133
const TStl = 134
const TStr = 135
const TSbl = 136
const TSbr = 137
const TPfill = 138
const TPtl = 139
const TPtr = 140
const TPbl = 141
const TPbr = 142
const TQfill = 143
const TQtl = 144
const TQtr = 145
const TQbl = 146
const TQbr = 147
const TD0t = 148
const TD0b = 149
const TD1t = 150
const TD1b = 151
const TD2t = 152
const TD2b = 153
const TD3t = 154
const TD3b = 155
const TD4t = 156
const TD4b = 157
const TD5t = 158
const TD5b = 159
const TD6t = 160
const TD6b = 161
const TD7t = 162
const TD7b = 163
const TD8t = 164
const TD8b = 165
const TD9t = 166
const TD9b = 167
const TLA00 = 168
const TLA01 = 169
const TLA10 = 170
const TLA11 = 171
const TLB00 = 172
const TLB01 = 173
const TLB10 = 174
const TLB11 = 175
const TLC00 = 176
const TLC01 = 177
const TLC10 = 178
const TLC11 = 179
const TLD00 = 180
const TLD01 = 181
const TLD10 = 182
const TLD11 = 183
const TLE00 = 184
const TLE01 = 185
const TLE10 = 186
const TLE11 = 187
const TLG00 = 188
const TLG01 = 189
const TLG10 = 190
const TLG11 = 191
const TLH00 = 192
const TLH01 = 193
const TLH10 = 194
const TLH11 = 195
const TLI00 = 196
const TLI01 = 197
const TLI10 = 198
const TLI11 = 199
const TLK00 = 200
const TLK01 = 201
const TLK10 = 202
const TLK11 = 203
const TLL00 = 204
const TLL01 = 205
const TLL10 = 206
const TLL11 = 207
const TLM00 = 208
const TLM01 = 209
const TLM10 = 210
const TLM11 = 211
const TLN00 = 212
const TLN01 = 213
const TLN10 = 214
const TLN11 = 215
const TLO00 = 216
const TLO01 = 217
const TLO10 = 218
const TLO11 = 219
const TLP00 = 220
const TLP01 = 221
const TLP10 = 222
const TLP11 = 223
const TLR00 = 224
const TLR01 = 225
const TLR10 = 226
const TLR11 = 227
const TLT00 = 228
const TLT01 = 229
const TLT10 = 230
const TLT11 = 231
const TLU00 = 232
const TLU01 = 233
const TLU10 = 234
const TLU11 = 235
const TLW00 = 236
const TLW01 = 237
const TLW10 = 238
const TLW11 = 239
const TLY00 = 240
const TLY01 = 241
const TLY10 = 242
const TLY11 = 243
const THline = 244
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const NTiles8 = 936
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndNoMatch = 3
const SndPick = 4
const SndMatch = 5
const SndOver = 6
const SndBad = 7
const SndMove = 8

const NSq = 12
const NPairs = 6
const HoldMiss = 120
const HoldMatch = 90
const RepFirst = 14
const RepNext = 8
const CMove = 8
const CThink = 24
const CAfter = 20
const NoGoal = 255

' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' Word[s]: the word (0-27) under square s; Own[s]: 0 in play, 1 or 2
' the player who matched it; Open[s]: 1 while shown this turn;
' CMem[s]: the word the computer remembers there, NoGoal if none
u8 Word[12]
u8 Own[12]
u8 Open[12]
u8 CMem[12]
u8 Score[2]
' Mode 1 one player (against the computer), 2 two players
' Ph 0 square A, 1 square B, 2 showing the pair; Turn 0 or 1
u8 Mode = 1
u8 Ph = 0
u8 Turn = 0
u8 PA = 0
u8 PB = 0
u8 Good = 0
u8 Hold = 0
u8 Left = NPairs
u8 Cur = 0
u8 Rep = 0
u8 LastDir = 0
u8 CGoal = NoGoal
u8 CWait = 0
u8 GameOn = 0
' the cursor's top left corner in pixels, sliding to the square
u8 CurX = 20
u8 CurY = 20
u16 Rs = $5A3D
u16 T16 = 0
u16 NumU = 0
u8 Menu = 0
u8 Tick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Lj = 0
u8 Ca = 0
u8 Cb = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' each square's tile column and row (top left), and its grid place
data SqX bytes 3,12,21,3,12,21,3,12,21,3,12,21
data SqY bytes 3,3,3,8,8,8,13,13,13,18,18,18
data SqCol bytes 0,1,2,0,1,2,0,1,2,0,1,2
data SqRow bytes 0,0,0,1,1,1,2,2,2,3,3,3
data WordTile bytes
  176,168,224,176,168,228,172,216,240,192,168,228
  192,196,228,228,216,220,168,228,184,184,168,228
  220,196,228,220,168,228,188,216,228,192,196,208
  192,184,224,236,192,240,192,216,236,228,196,212
  196,204,204,236,192,216,224,232,212,240,216,232
  168,176,184,172,184,180,196,212,200,168,196,208
  168,224,228,228,216,228,228,196,184,184,212,180
data WordName chars
  "CAR"
  "CAT"
  "BOY"
  "HAT"
  "HIT"
  "TOP"
  "ATE"
  "EAT"
  "PIT"
  "PAT"
  "GOT"
  "HIM"
  "HER"
  "WHY"
  "HOW"
  "TIN"
  "ILL"
  "WHO"
  "RUN"
  "YOU"
  "ACE"
  "BED"
  "INK"
  "AIM"
  "ART"
  "TOT"
  "TIE"
  "END"
end data

  tile screen
  set sound table WmSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title
  Mode = Menu + 1

new_game:
  Deal
  Ph = 0
  Turn = 0
  Left = NPairs
  Score[0] = 0
  Score[1] = 0
  Cur = 0
  Rep = 0
  LastDir = 0
  CGoal = NoGoal
  CWait = CThink
  CurX = 20
  CurY = 20
  DrawBoard
  ShowHud
  ShowMsg
  DrawCursor
  ShowScreen
  GameOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1

play_loop:
  Frame1
  ReadPad
  if Ph = 2 then
    dec Hold
    if Hold = 0 then
      EndPair
      if Left = 0 then goto game_over
    end if
  elseif IsComputer() = 1 then
    CompStep
  else
    MoveCursor
    if Press = 1 then PickSquare(Cur)
  end if
  DrawCursor
  goto play_loop

game_over:
  GameOn = 0
  Frame1
  HideSprites
  fill 32 count 28 at 2,22
  print at 7,22, "THE GAME IS OVER-"
  play sound SndOver
  Rearm
  wait 150 frames
  nmi off
  fill 32 count 28 at 2,22
  if Score[0] = Score[1] then
    print at 8,22, "IT'S A TIE!!!"
  else
    J = 0
    if Score[1] > Score[0] then J = 1
    PrintName(J, 6, 22)
    print at 15,22, "WINS!!!"
  end if
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' IsComputer: 1 when the computer has the turn
function IsComputer as u8
  if Mode = 1 then
    if Turn = 1 then return 1
  end if
  return 0

' Deal: 6 different words of the 28, each under two of the 12 squares
' (a partial Fisher-Yates for the words, a full one for the squares)
sub Deal:
  u8 Pool[28]
  for J = 0 to 27
    Pool[J] = J
  next
  for J = 0 to 5
    K = RndBelow(28 - J) + J
    swap Pool[J] with Pool[K]
  next
  for J = 0 to 11
    V = J >> 1
    Word[J] = Pool[V]
    Own[J] = 0
    Open[J] = 0
    CMem[J] = NoGoal
  next
  for J = 11 downto 1
    K = RndBelow(J + 1)
    swap Word[J] with Word[K]
  next
  return
end sub

' RndBelow(N): a number 0 .. N-1
function RndBelow(u8 Lim) as u8
  Rnd16
  T16 = Rs & 255
  T16 = T16 * Lim
  return T16 >> 8

sub Rnd16:
  T16 = Rs << 7
  Rs = Rs ^ T16
  T16 = Rs >> 9
  Rs = Rs ^ T16
  T16 = Rs << 8
  Rs = Rs ^ T16
  return
end sub

' MoveCursor: the stick moves at once, then repeats while held
sub MoveCursor:
  if Stick = 0 then
    LastDir = 0
    return
  end if
  if Stick = LastDir then
    dec Rep
    if Rep > 0 then return
    Rep = RepNext
  else
    Rep = RepFirst
    LastDir = Stick
  end if
  V = Cur
  select case Stick
  case 1
    if Cur >= 3 then Cur -= 3
  case 2
    if Cur < 9 then Cur += 3
  case 3
    if SqCol[Cur] > 0 then dec Cur
  case 4
    if SqCol[Cur] < 2 then inc Cur
  end select
  if Cur <> V then play sound SndMove
  return
end sub

' PickSquare(S): open square S as square A or B; judge a pair
sub PickSquare(u8 S):
  if Own[S] <> 0 then
    play sound SndBad
    return
  end if
  if Open[S] = 1 then
    play sound SndBad
    return
  end if
  Open[S] = 1
  DrawSquare(S)
  Remember(S)
  if Ph = 0 then
    PA = S
    Ph = 1
    play sound SndPick
    ShowMsg
    return
  end if
  PB = S
  Good = 0
  if Word[PA] = Word[PB] then Good = 1
  if Good = 1 then
    Hold = HoldMatch
    play sound SndMatch
  else
    Hold = HoldMiss
    play sound SndNoMatch
  end if
  Ph = 2
  ShowMsg
  return
end sub

' Remember(S): the computer keeps what it saw one time in two
sub Remember(u8 S):
  Rnd16
  if (Rs & 1) = 1 then CMem[S] = Word[S]
  return
end sub

' EndPair: a match takes the squares (same player again); otherwise
' they close and the turn passes
sub EndPair:
  Open[PA] = 0
  Open[PB] = 0
  if Good = 1 then
    V = Turn + 1
    Own[PA] = V
    Own[PB] = V
    Score[Turn] += 1
    dec Left
  else
    Turn = Turn ^ 1
  end if
  DrawSquare(PA)
  DrawSquare(PB)
  Ph = 0
  CGoal = NoGoal
  CWait = CThink
  ShowHud
  ShowMsg
  return
end sub

' CompStep: the computer thinks, moves its cursor a square at a time,
' then opens the square
sub CompStep:
  if CWait > 0 then
    dec CWait
    return
  end if
  if CGoal = NoGoal then
    CGoal = CompChoose()
    CWait = CThink
    return
  end if
  if Cur = CGoal then
    PickSquare(Cur)
    CGoal = NoGoal
    CWait = CAfter
    return
  end if
  if SqRow[Cur] < SqRow[CGoal] then
    Cur += 3
  elseif SqRow[Cur] > SqRow[CGoal] then
    Cur -= 3
  elseif SqCol[Cur] < SqCol[CGoal] then
    inc Cur
  else
    dec Cur
  end if
  play sound SndMove
  CWait = CMove
  return
end sub

' CompChoose: the computer's next square from what it remembers
function CompChoose as u8
  if Ph = 0 then
    for Ca = 0 to 10
      if Own[Ca] = 0 then
        if CMem[Ca] <> NoGoal then
          for Cb = Ca + 1 to 11
            if Own[Cb] = 0 then
              if CMem[Cb] = CMem[Ca] then return Ca
            end if
          next
        end if
      end if
    next
    V = RandomSq(NoGoal, 1)
    if V = NoGoal then V = RandomSq(NoGoal, 0)
    return V
  end if
  ' square B: the partner of A's word if remembered
  K = Word[PA]
  for Ca = 0 to 11
    if Ca <> PA then
      if Own[Ca] = 0 then
        if CMem[Ca] = K then return Ca
      end if
    end if
  next
  V = RandomSq(PA, 1)
  if V = NoGoal then V = RandomSq(PA, 0)
  return V

' Cand(S, Ex, Unk): 1 when the computer may open S (in play, not Ex,
' not remembered when Unk is 1)
function Cand(u8 S, u8 Ex, u8 Unk) as u8
  if Own[S] <> 0 then return 0
  if S = Ex then return 0
  if Unk = 1 then
    if CMem[S] <> NoGoal then return 0
  end if
  return 1

' RandomSq(Ex, Unk): one of the squares Cand allows, at random
function RandomSq(u8 Ex, u8 Unk) as u8
  N = 0
  for Ca = 0 to 11
    if Cand(Ca, Ex, Unk) = 1 then inc N
  next
  if N = 0 then return NoGoal
  K = RndBelow(N)
  for Ca = 0 to 11
    if Cand(Ca, Ex, Unk) = 1 then
      if K = 0 then return Ca
      dec K
    end if
  next
  return NoGoal

' DrawSquare(S): square S as it is now
sub DrawSquare(u8 S):
  if Own[S] <> 0 then
    SquareAt(SqX[S], SqY[S], Own[S] + 1, 0)
  elseif Open[S] = 1 then
    SquareAt(SqX[S], SqY[S], 1, Word[S])
  else
    SquareAt(SqX[S], SqY[S], 0, S + 1)
  end if
  return
end sub

' SquareAt(X, Y, Kind, Val): a square at tile X,Y; Kind 0 hidden (Val
' its number), 1 open (Val the word), 2 red, 3 green
sub SquareAt(u8 Sx, u8 Sy, u8 Kind, u8 Val):
  u8 B = 0
  u8 L = 0
  u8 I = 0
  B = Kind * 5 + THfill
  put char B + 1 at Sx, Sy
  fill B count 6 at Sx + 1, Sy
  put char B + 2 at Sx + 7, Sy
  fill B count 8 at Sx, Sy + 1
  fill B count 8 at Sx, Sy + 2
  put char B + 3 at Sx, Sy + 3
  fill B count 6 at Sx + 1, Sy + 3
  put char B + 4 at Sx + 7, Sy + 3
  if Kind = 0 then
    if Val < 10 then
      L = Val * 2 + TD0t
      put char L at Sx + 3, Sy + 1
      put char L + 1 at Sx + 3, Sy + 2
    else
      put char TD1t at Sx + 3, Sy + 1
      put char TD1b at Sx + 3, Sy + 2
      L = (Val - 10) * 2 + TD0t
      put char L at Sx + 4, Sy + 1
      put char L + 1 at Sx + 4, Sy + 2
    end if
  end if
  if Kind = 1 then
    for I = 0 to 2
      L = WordTile[Val * 3 + I]
      put char L at Sx + 1 + I * 2, Sy + 1
      put char L + 1 at Sx + 2 + I * 2, Sy + 1
      put char L + 2 at Sx + 1 + I * 2, Sy + 2
      put char L + 3 at Sx + 2 + I * 2, Sy + 2
    next
  end if
  return
end sub

' BigWord: the title in big letters (codes from WordTile's letters)
sub BigLetter(u8 L, u8 Bx, u8 By):
  put char L at Bx, By
  put char L + 1 at Bx + 1, By
  put char L + 2 at Bx, By + 1
  put char L + 3 at Bx + 1, By + 1
  return
end sub

' DrawCursor: the four corners slide to the square under the cursor
sub DrawCursor:
  X = SqX[Cur] * 8 - 4
  Y = SqY[Cur] * 8 - 4
  if CurX < X then CurX = min(CurX + 6, X)
  if CurX > X then CurX = max(CurX - 6, X)
  if CurY < Y then CurY = min(CurY + 6, Y)
  if CurY > Y then CurY = max(CurY - 6, Y)
  V = 9
  if Turn = 1 then V = 3
  Y = CurY - 1
  set sprite 0 to Y, CurX, SCtl, V
  set sprite 1 to Y, CurX + 56, SCtr, V
  Y = CurY + 23
  set sprite 2 to Y, CurX, SCbl, V
  set sprite 3 to Y, CurX + 56, SCbr, V
  update sprites
  return
end sub

' PrintName(P, X, Y): player P's name (8 letters)
sub PrintName(u8 P, u8 Px, u8 Py):
  if P = 0 then
    print at Px,Py, "PLAYER 1"
  elseif Mode = 1 then
    print at Px,Py, "COMPUTER"
  else
    print at Px,Py, "PLAYER 2"
  end if
  return
end sub

' ShowHud: both players, their colours and pairs; > marks the turn
sub ShowHud:
  put char TPfill at 2,1
  PrintName(0, 5, 1)
  NumU = Score[0]
  print at 14,1, digits$(NumU, 1)
  put char TQfill at 17,1
  PrintName(1, 20, 1)
  NumU = Score[1]
  print at 29,1, digits$(NumU, 1)
  put char 32 at 3,1
  put char 32 at 18,1
  if Turn = 0 then
    put char 62 at 3,1
  else
    put char 62 at 18,1
  end if
  return
end sub

' ShowMsg: the line under the board
sub ShowMsg:
  fill 32 count 28 at 2,22
  if Ph = 2 then
    if Good = 1 then
      print at 2,22, "MATCH!!!!"
      PrintName(Turn, 12, 22)
      print at 21,22, "AGAIN"
    else
      print at 10,22, "NO MATCH-"
    end if
    return
  end if
  PrintName(Turn, 4, 22)
  if Ph = 0 then
    print at 13,22, "SQUARE A?"
  else
    print at 13,22, "SQUARE B?"
  end if
  return
end sub

sub DrawBoard:
  NewScreen
  fill THline count 28 at 2,2
  for Lj = 0 to 11
    DrawSquare(Lj)
  next
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' ReadPad: either joystick; Stick 1 up, 2 down, 3 left, 4 right
sub ReadPad:
  Btn = 0
  Stick = 0
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn = 1
  if joypad(2).button2 then Btn = 1
  if joypad(1).up or joypad(2).up then Stick = 1
  if joypad(1).down or joypad(2).down then Stick = 2
  if joypad(1).left or joypad(2).left then Stick = 3
  if joypad(1).right or joypad(2).right then Stick = 4
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  sprites flicker off
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title in big letters on yellow squares
sub BigTitle(u8 Ty):
  BigLetter(TLW00, 6, Ty)
  BigLetter(TLO00, 8, Ty)
  BigLetter(TLR00, 10, Ty)
  BigLetter(TLD00, 12, Ty)
  BigLetter(TLM00, 16, Ty)
  BigLetter(TLA00, 18, Ty)
  BigLetter(TLT00, 20, Ty)
  BigLetter(TLC00, 22, Ty)
  BigLetter(TLH00, 24, Ty)
  return
end sub

' the title: big name, three sample squares, a joystick menu
sub TitlePage:
  NewScreen
  BigTitle(2)
  SquareAt(3, 5, 0, 7)
  SquareAt(12, 5, 1, 1)
  SquareAt(21, 5, 2, 0)
  print at 3,10, "FIND THE PAIRS OF WORDS"
  print at 3,11, "HIDDEN UNDER 12 SQUARES."
  print at 8,13, "1 PLAYER VS COMPUTER"
  print at 8,15, "2 PLAYERS"
  print at 8,17, "HOW TO PLAY"
  print at 8,19, "CREDITS"
  print at 3,22, "STICK MOVES, BUTTON PICKS"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  Rnd16
  ReadPad
  if Stick = 1 then
    if WasStick = 0 then
      if Menu > 0 then dec Menu
      ShowMenu
    end if
  end if
  if Stick = 2 then
    if WasStick = 0 then
      if Menu < 3 then inc Menu
      ShowMenu
    end if
  end if
  WasStick = Stick
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 0 to 3
    V = J * 2 + 13
    put char 32 at 6,V
  next
  V = Menu * 2 + 13
  put char 62 at 6,V
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  fill THline count 28 at 2,2
  if Pg = 0 then
    print at 2,3, "12 SQUARES HIDE 6 PAIRS OF"
    print at 2,4, "WORDS. MOVE THE CURSOR WITH"
    print at 2,5, "THE STICK, PRESS A BUTTON TO"
    print at 2,6, "OPEN SQUARE A, THEN B."
    print at 2,8, "SAME WORD: A MATCH! 1 POINT,"
    print at 2,9, "THE SQUARES TAKE YOUR COLOUR"
    print at 2,10, "AND YOU GO AGAIN."
    print at 2,11, "NOT THE SAME: THEY CLOSE AND"
    print at 2,12, "IT IS THE OTHER PLAYER'S GO."
    SquareAt(5, 15, 1, 1)
    SquareAt(17, 15, 1, 1)
    print at 12,20, "MATCH!"
    Turn = 0
    Cur = 0
    set sprite 0 to 115, 36, SCtl, 9
    set sprite 1 to 115, 92, SCtr, 9
    set sprite 2 to 139, 36, SCbl, 9
    set sprite 3 to 139, 92, SCbr, 9
  else
    print at 2,3, "THE GAME ENDS WHEN ALL 6"
    print at 2,4, "PAIRS ARE FOUND. MOST PAIRS"
    print at 2,5, "WINS."
    print at 2,7, "1 PLAYER: THE COMPUTER IS"
    print at 2,8, "PLAYER 2. IT FORGETS SOME OF"
    print at 2,9, "WHAT IT SEES."
    print at 2,11, "TIP: OPEN A NEW SQUARE FIRST"
    print at 2,12, "IF ITS WORD WAS SEEN BEFORE,"
    print at 2,13, "PICK ITS PARTNER."
    SquareAt(3, 15, 2, 0)
    SquareAt(12, 15, 0, 12)
    SquareAt(21, 15, 3, 0)
    print at 3,20, "PLAYER 1"
    print at 21,20, "PLAYER 2"
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Wt = 0
ht_loop:
  Frame1
  Rnd16
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  BigTitle(2)
  print at 3,5, "FROM WORD MATCH IN"
  print at 3,6, "COMPUTE!'S GAZETTE,"
  print at 3,7, "OCTOBER 1983 (COMMODORE 64"
  print at 3,8, "AND VIC-20 BASIC)."
  print at 3,10, "WORDS, BOARD, TURNS AND"
  print at 3,11, "SCORING FROM THE LISTING."
  print at 3,13, "MADE FOR THE COLECOVISION"
  print at 3,14, "BY CLAUDE (AN AI MADE BY"
  print at 3,15, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,16, "2026, IN AMY BY AMY"
  print at 3,17, "BIENVENU."
  print at 3,19, "NEW TITLE MUSIC:"
  print at 3,20, "TURN IT OVER"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

