i8 NegFive = -5
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0

' Amy Numeric Local 32 Demo
  text screen
  run_demo
  screen on

sub run_demo:
  u32 LocalU32 = 100001
  u32 CopyU32 = 0
  i32 LocalI32 = -123456
  i32 CastI32 = 0

  print at 8,0, "LOCAL 32 TEST"
  print at 1,3, "U32"
  print LocalU32 at 5,3
  print at 1,5, "I32"
  print LocalI32 at 5,5 digits 11

  CopyU32 = LocalU32
  CopyU32 += 1
  print at 1,7, "INC"
  print CopyU32 at 5,7

  CastI32 = NegFive
  print at 1,9, "CAST"
  print CastI32 at 5,9 digits 11

  if unsigned LocalU32 = 100001 then
    T1 = 1
  end if
  if signed LocalI32 < 0 then
    T2 = 1
  end if
  if unsigned CopyU32 = 100002 then
    T3 = 1
  end if
  if signed CastI32 = -5 then
    T4 = 1
  end if

  print at 1,13, "u32 local"
  print at 1,14, "i32 local"
  print at 1,15, "u32 ops"
  print at 1,16, "cast i8"

  if T1 then
    print at 22,13, "PASS"
  else
    print at 22,13, "FAIL"
  end if
  if T2 then
    print at 22,14, "PASS"
  else
    print at 22,14, "FAIL"
  end if
  if T3 then
    print at 22,15, "PASS"
  else
    print at 22,15, "FAIL"
  end if
  if T4 then
    print at 22,16, "PASS"
  else
    print at 22,16, "FAIL"
  end if
  return