cartridge "WHIRLYBIRD/PHILIP I. NELSON, GAZETTE/1985"

' WHIRLYBIRD
' Based on "Whirlybird" by Philip I. Nelson, COMPUTE!'s Gazette, December
' 1985 (Commodore 64, machine language, SYS 49152).
' Made for the ColecoVision by Claude (an AI made by Anthropic) for Amy
' Studio, 2026, in Amy by Amy Bienvenu. Built from the article's rules
' (orig/whirly-1985-12-p1.png, -p2.png); not a code copy.
'
' The game: a Breakout variant. The Whirlybird flies back and forth across
' the top of the screen, spinning all the time. Bounce its eggs down into
' the layers of coloured bricks at the bottom. Sparkling sidebeams stand at
' each edge. The game ends when every brick is gone or the eggs run out.
'
' Controls: joystick 1 or 2. Left/right is a gas pedal: hold it and the
' bird speeds up, let go and it slows to a stop; a sidebeam reverses it at
' once. A button releases each egg and works the menus. No keypad.
'
' Rules kept from the article:
'   eggs left shown at the upper right (default 10, 1-255 set on the title)
'   the button releases each egg (a random place and way)
'   1 point a brick, 10 points an egg bounced back down by the bird
'   an egg flying past the bird into space costs 10 points (not when the
'     score is under ten); the sidebeams then sparkle until the button
'     releases the next egg
'   round bricks: no points, the bird swoops down to put a new sidebeam
'     above the bricks and you get a free egg; those sidebeams bounce eggs
'     sideways and may or may not disappear when struck (one in two)
'   50-point bonus for clearing every brick; the high score is kept
'   normal and expert levels (expert: the bird is half size)
'   the egg's rebound depends on the stick at the moment of impact: none =
'     as off a wall, left = to the left, right = to the right
'   hitting with the feet is safe; a wing hit may juggle the egg (10 more
'     points, the angle changes, sometimes it pops up and out); juggles are
'     less frequent at expert; a bird seen side-on is slim and may miss
'
' Liberties (made for this machine):
'   a title menu (START NORMAL / START EXPERT / EGGS / HOW TO PLAY /
'     CREDITS) instead of F1/F3 and the stick's forward/back for the eggs:
'     on the EGGS line left/right sets 1-255
'   a playfield of 26 x 20 cells in columns 2-29 and rows 1-22: five rows of
'     13 two-cell bricks (65), five round ones placed at random each game
'   the egg flies straight at 1.25 pixels a frame (1.5 at expert); the bird
'     accelerates 2/16 pixel a frame per frame to 2.5 pixels a frame and
'     slows by 1/16 when let go (numbers chosen for a human, not measured:
'     the original didn't run its game loop in the headless emulator)
'   the bird spins through eight poses of 6 frames (1.25 turns a second);
'     reach: 7, 5, 2 pixels either side of its middle (expert 4, 3, 1)
'   play freezes for the 0.8 s swoop that puts down a new sidebeam (six at
'     most; a seventh replaces the oldest)
'   juggles: a wing hit juggles one time in four (expert one in eight); a
'     juggle pops the egg up and away one time in four
'   no ring-modulated hum or filter sweep (no SID); a boing and effects
'   game end: a message, a press, then the title (no play-again choices)
'
' House rules kept: text in columns 2-29, tiles from 128, the frame loop
' is protected from the NMI and every screen is drawn with the NMI off.

const TBeam1 = 128
const TBeam2 = 129
const TBeam3 = 130
const TPost1 = 131
const TPost2 = 132
const TGround = 133
const TBrk0a = 134
const TBrk0b = 135
const TBrk1a = 136
const TBrk1b = 137
const TBrk2a = 138
const TBrk2b = 139
const TBrk3a = 140
const TBrk3b = 141
const TBrk4a = 142
const TBrk4b = 143
const TRnda = 144
const TRndb = 145
const TEggi = 146
const SBwide = 0
const SBqtr = 4
const SBside = 8
const SBqtr2 = 12
const SHwide = 16
const SHqtr = 20
const SHside = 24
const SHqtr2 = 28
const SEgg = 32
const NTiles8 = 152
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndBoing = 3
const SndBrick = 4
const SndJuggle = 5
const SndLost = 6
const SndBeam = 7
const SndWall = 8
const SndDrop = 9
const SndClear = 10
const SndTick = 11

const NSpr = 4
const NBr = 65
const NBm = 6
' egg sprite x/y limits in 1/16 pixel (the sprite's top-left corner)
const EXmin = 384
const EXmax = 3616
const EYmax = 2704
const EYlost = 192
const BirdTop = 16

' bricks: Br[(row - 15) * 13 + (col - 3) / 2], 0 gone, 1 brick, 2 round
u8 Br[65]
' the extra sidebeams: column, top row, 1 when standing
u8 BmC[6]
u8 BmR[6]
u8 BmOn[6]

' the bird: Bx its middle in 1/16 pixel, Bv its speed
u16 Bx = 2048
i16 Bv = 0
u8 Pose = 0
u8 PoseT = 0
' the egg: Ex, Ey its sprite corner in 1/16 pixel, Vx, Vy its speed
u16 Ex = 0
u16 Ey = 0
i8 Vx = 0
i8 Vy = 0
u8 EggOn = 0
u8 NoHit = 0
u8 Eggs = 10
u8 EggSet = 10
u8 Expert = 0
u8 Left = 65
u8 Sw = 0
u8 SwC = 0
u8 SwR = 0
u8 SwS = 0
u8 BmNext = 0
u8 Spk = 0
u8 SpkT = 0
u16 Score = 0
u16 High = 0
u8 Bounces = 0
u8 Juggles = 0
u8 Ev = 0
' Ph: 0 menus, 2 playing, 5 game over
u8 Ph = 0
u8 Jd = 0
u8 Cx = 0
u8 Cy = 0

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Rw = 0
u16 NumU = 0
u16 W16 = 0
u8 Menu = 0
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 1
u8 Press = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
u8 PassT = 0
u8 Fc = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 C = 0

data Mod3 bytes
  0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2,0,1,2
end data
' the bird's reach either side of its middle for each pose, normal / expert
data Reach bytes
  7,5,2,5,7,5,2,5
end data
data ReachX bytes
  4,3,1,3,4,3,1,3
end data
data PoseSpr bytes
  0,4,8,12,0,4,8,12
end data
' a new egg's sideways speed (1/16 pixel a frame)
data NewVx bytes
  240,244,248,8,12,16,244,12
end data

  tile screen
  set sound table WbSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  Ph = 0
  TitlePage
  if Menu = 3 then
    HowTo
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  Expert = Menu

new_game:
  Score = 0
  Eggs = EggSet
  Bounces = 0
  Juggles = 0
  NewScreen
  DrawField
  SetupGame
  ShowHud
  DrawSprites
  ShowScreen
  Ph = 2
  Rearm
  wait no fire
  nmi off
  WasBtn = 1

play_loop:
  Frame1
  ReadPad
  PlayPass
  DrawSprites
  PassT = Tick
  if Ev = 2 then goto cleared
  if Ev = 3 then goto out_eggs
  goto play_loop

cleared:
  Score = Score + 50
  ShowHud
  play sound SndClear
  print at 6,11, "ALL BRICKS CLEARED"
  print at 9,12, "BONUS 50"
  goto over

out_eggs:
  print at 10,11, "NO EGGS LEFT"

over:
  Ph = 5
  set sprite 1 to 192,0,0,0
  update sprites
  if Score > High then High = Score
  ShowHud
  print at 10,13, "GAME OVER"
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---- setup ----
sub SetupGame:
  u8 Q = 0
  u8 Nr = 0
  Bx = 2048
  Bv = 0
  Pose = 0
  PoseT = 0
  EggOn = 0
  NoHit = 0
  Sw = 0
  BmNext = 0
  Spk = 0
  SpkT = 0
  Ev = 0
  Left = NBr
  for Q = 0 to 5
    BmOn[Q] = 0
  next
  fill array Br with 1
  ' five round bricks at random (rows 15-18, so they can be reached)
  Nr = 0
  while Nr < 5
    Rnd16
    Q = lowbyte(Rw) & 63
    if Q < 52 then
      if Br[Q] = 1 then
        Br[Q] = 2
        inc Nr
      end if
    end if
  end while
  DrawBricks
  return
end sub

' ---- one pass of play (model.mjs follows these rules) ----
sub PlayPass:
  Ev = 0
  ' the spin goes on all the time
  inc PoseT
  if PoseT >= 6 then
    PoseT = 0
    Pose = Pose + 1
    Pose = Pose & 7
  end if
  if Sw > 0 then
    Swoop
    return
  end if
  MoveBird
  if EggOn = 1 then
    MoveEgg
    return
  end if
  ' waiting: the sidebeams sparkle; the button releases the next egg
  inc SpkT
  if SpkT >= 20 then
    SpkT = 0
    inc Spk
    if Spk >= 3 then Spk = 0
    DrawBeams
  end if
  if Eggs = 0 then
    Ev = 3
    return
  end if
  if Press = 1 then NewEgg
  return
end sub

sub MoveBird:
  i16 Sp = 0
  u16 Lo = 512
  u16 Hi = 3568
  if Expert = 1 then
    Lo = 448
    Hi = 3632
  end if
  Sp = Bv
  select case Jd
  case 1
    Sp = Sp - 2
    if Sp < -40 then Sp = -40
  case 2
    Sp = Sp + 2
    if Sp > 40 then Sp = 40
  case else
    if Sp > 0 then
      dec Sp
    elseif Sp < 0 then
      inc Sp
    end if
  end select
  Bx = Bx + Sp
  ' a sidebeam reverses the bird at once
  if Bx < Lo then
    Bx = Lo
    Sp = 0 - Sp
  end if
  if Bx > Hi then
    Bx = Hi
    Sp = 0 - Sp
  end if
  Bv = Sp
  return
end sub

function CellX as u8
  u16 T = 0
  T = Ex >> 4
  T = T + 3
  return lowbyte(T) >> 3

function CellY as u8
  u16 T = 0
  T = Ey >> 4
  T = T + 3
  return lowbyte(T) >> 3

sub MoveEgg:
  u16 Old = 0
  u8 Q = 0
  u8 Bi = 0
  u8 Ecx = 0
  u8 Bcx = 0
  u8 Dx = 0
  u8 Rch = 0
  u8 Ft = 3
  ' sideways, off the edge sidebeams
  Old = Ex
  Ex = Ex + Vx
  if Ex < EXmin then
    Ex = EXmin
    Vx = 0 - Vx
    play sound SndWall
  end if
  if Ex > EXmax then
    Ex = EXmax
    Vx = 0 - Vx
    play sound SndWall
  end if
  ' a standing sidebeam bounces the egg sideways
  Cx = CellX()
  Cy = CellY()
  for Q = 0 to NBm - 1
    if BmOn[Q] = 1 then
      if Cx = BmC[Q] then
        V = Cy - BmR[Q]
        if V < 2 then
          Vx = 0 - Vx
          Ex = Old
          play sound SndWall
          Rnd16
          V = lowbyte(Rw) & 1
          if V = 1 then
            BmOn[Q] = 0
            put char 32 at BmC[Q],BmR[Q]
            Y = BmR[Q] + 1
            put char 32 at BmC[Q],Y
          end if
        end if
      end if
    end if
  next
  ' up and down, off the ground
  Ey = Ey + Vy
  if Ey > EYmax then
    Ey = EYmax
    Vy = 0 - Vy
    play sound SndWall
  end if
  ' a brick: knocked out, the egg turns back
  Cx = CellX()
  Cy = CellY()
  if Cy >= 15 then
    if Cy <= 19 then
      if Cx >= 3 then
        if Cx <= 28 then
          Bi = Cy - 15
          Bi = Bi * 13
          V = Cx - 3
          V = V >> 1
          Bi = Bi + V
          if Br[Bi] > 0 then HitBrick(Bi)
        end if
      end if
    end if
  end if
  if Ev = 2 then return
  ' the bird (only an egg on its way up)
  if NoHit > 0 then dec NoHit
  Ecx = Ex >> 4
  Ecx = Ecx + 3
  Y = Ey >> 4
  Y = Y + 3
  if Vy < 0 then
    if NoHit = 0 then
      if Y >= 18 then
        if Y <= 32 then
          Bcx = Bx >> 4
          Dx = absdiff(Ecx, Bcx)
          if Expert = 1 then
            Rch = ReachX[Pose]
            Ft = 2
          else
            Rch = Reach[Pose]
          end if
          Rch = Rch + 3
          if Dx <= Rch then BirdHit(Dx, Ft)
        end if
      end if
    end if
  end if
  ' into space
  if Ey < EYlost then
    EggOn = 0
    if Score >= 10 then Score = Score - 10
    play sound SndLost
    ShowHud
    Ev = 1
  end if
  return
end sub

' BirdHit: the egg meets the bird Hd pixels from its middle; the feet (Hf
' pixels) are safe, a wing may juggle it
sub BirdHit(u8 Hd, u8 Hf)
  i8 Ax = 0
  u8 Jm = 3
  Ax = abs(Vx)
  Vy = abs(Vy)
  if Jd = 1 then
    Ax = Ax + 4
    if Ax > 28 then Ax = 28
    Vx = 0 - Ax
  end if
  if Jd = 2 then
    Ax = Ax + 4
    if Ax > 28 then Ax = 28
    Vx = Ax
  end if
  Score = Score + 10
  inc Bounces
  NoHit = 8
  play sound SndBoing
  if Hd > Hf then
    if Expert = 1 then Jm = 7
    Rnd16
    V = lowbyte(Rw) & Jm
    if V = 0 then
      ' a juggle: more points, a new angle, sometimes up and away
      Score = Score + 10
      inc Juggles
      play sound SndJuggle
      V = highbyte(Rw) & 1
      if V = 0 then
        Vx = Vx + 4
      else
        Vx = Vx - 4
      end if
      if Vx = 0 then Vx = 4
      V = highbyte(Rw) & 12
      if V = 0 then
        Vy = 0 - Vy
        NoHit = 40
      end if
    end if
  end if
  ShowHud
  return
end sub

sub HitBrick(u8 Hb)
  u8 Kind = 0
  u8 Col = 0
  u8 Row = 0
  Kind = Br[Hb]
  Br[Hb] = 0
  dec Left
  Vy = 0 - Vy
  Row = Hb / 13
  Col = Hb % 13
  Col = Col << 1
  Col = Col + 3
  Row = Row + 15
  put char 32 at Col,Row
  inc Col
  put char 32 at Col,Row
  if Kind = 1 then
    inc Score
    play sound SndBrick
  else
    ' a round brick: a free egg and a new sidebeam, put down by the bird
    if Eggs < 255 then inc Eggs
    Rnd16
    SwC = lowbyte(Rw) & 15
    SwC = SwC + 6
    V = highbyte(Rw) & 3
    SwR = V + 7
    SwS = Bx >> 4
    Sw = 48
    play sound SndBeam
  end if
  ShowHud
  if Left = 0 then Ev = 2
  return
end sub

' Swoop: 48 frames; at the bottom (24 left) the new sidebeam stands
sub Swoop:
  u8 Q = 0
  dec Sw
  if Sw = 24 then
    Q = BmNext
    if BmOn[Q] = 1 then
      put char 32 at BmC[Q],BmR[Q]
      Y = BmR[Q] + 1
      put char 32 at BmC[Q],Y
    end if
    BmC[Q] = SwC
    BmR[Q] = SwR
    BmOn[Q] = 1
    put char TPost1 at SwC,SwR
    Y = SwR + 1
    put char TPost2 at SwC,Y
    inc BmNext
    if BmNext >= NBm then BmNext = 0
    play sound SndDrop
  end if
  return
end sub

sub NewEgg:
  u16 T = 0
  dec Eggs
  Rnd16
  T = lowbyte(Rw)
  T = T * 12
  T = T + 640
  Ex = T
  Ey = 768
  V = highbyte(Rw) & 7
  Vx = NewVx[V]
  Vy = 20
  if Expert = 1 then
    Vy = 24
  end if
  EggOn = 1
  NoHit = 0
  play sound SndDrop
  ShowHud
  return
end sub

' ---- drawing ----
sub DrawBeams:
  u8 Rr = 0
  u8 Tb = 0
  for Rr = 2 to 21
    Tb = Rr + Spk
    Tb = Mod3[Tb]
    Tb = Tb + TBeam1
    put char Tb at 2,Rr
    put char Tb at 29,Rr
  next
  return
end sub

sub DrawBricks:
  u8 Bi = 0
  u8 Rr = 0
  u8 Cc = 0
  u8 Ta = 0
  for Rr = 0 to 4
    for Cc = 0 to 12
      Bi = Rr * 13
      Bi = Bi + Cc
      Ta = Rr << 1
      Ta = Ta + TBrk0a
      if Br[Bi] = 2 then Ta = TRnda
      X = Cc << 1
      X = X + 3
      Y = Rr + 15
      put char Ta at X,Y
      inc X
      inc Ta
      put char Ta at X,Y
    next
  next
  return
end sub

sub DrawField:
  DrawBeams
  fill TGround count 28 at 2,22
  return
end sub

sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Sp = 0
  u8 Dd = 0
  i16 Lx = 0
  i16 Ly = 0
  Sp = PoseSpr[Pose]
  if Expert = 1 then Sp = Sp + SHwide
  W16 = Bx >> 4
  Sx = lowbyte(W16) - 8
  Sy = BirdTop - 1
  if Sw > 0 then
    ' the swoop: down to the new sidebeam and back
    Dd = Sw
    if Dd > 24 then Dd = 48 - Sw
    Lx = SwC * 8
    Lx = Lx - 4
    Lx = Lx - SwS
    Lx = Lx * Dd
    Lx = Lx / 24
    Lx = Lx + SwS
    Sx = lowbyte(Lx) - 8
    Ly = SwR * 8
    Ly = Ly - 30
    Ly = Ly * Dd
    Ly = Ly / 24
    Ly = Ly + 15
    Sy = lowbyte(Ly)
  end if
  set sprite 0 to Sy,Sx,Sp,15
  if EggOn = 1 then
    W16 = Ex >> 4
    Sx = lowbyte(W16)
    W16 = Ey >> 4
    Sy = lowbyte(W16) - 1
    set sprite 1 to Sy,Sx,SEgg,11
  else
    set sprite 1 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  NumU = Score
  print at 8,1, digits$(NumU, 5)
  print at 14,1, "HI"
  NumU = High
  print at 17,1, digits$(NumU, 5)
  put char TEggi at 24,1
  NumU = Eggs
  print at 26,1, digits$(NumU, 3)
  return
end sub

' ---- system ----
' Rnd16: a 16-bit xorshift (7 9 8), Rw the new value
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' ReadPad: both sticks and buttons; Jd 1 left, 2 right, 0 neither; Press a
' new button press
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 16
  V = J1 | J2
  Jd = 0
  C = V & 8
  if C > 0 then Jd = 2
  C = V & 4
  if C > 0 then Jd = 1
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the name over a row of bricks, the bird spinning across, the
' tune once; START NORMAL / START EXPERT / EGGS / HOW TO PLAY / CREDITS
sub TitlePage:
  u8 Tx = 0
  u8 Ts = 0
  NewScreen
  print at 10,3, "WHIRLYBIRD"
  for I = 0 to 12
    X = I << 1
    X = X + 3
    K = I % 5
    K = K << 1
    K = K + TBrk0a
    put char K at X,5
    inc X
    inc K
    put char K at X,5
  next
  print at 4,8, "PHILIP I. NELSON"
  print at 4,9, "COMPUTE!'S GAZETTE"
  print at 4,10, "DECEMBER 1985"
  print at 9,13, "START NORMAL"
  print at 9,15, "START EXPERT"
  print at 9,17, "EGGS"
  print at 9,19, "HOW TO PLAY"
  print at 9,21, "CREDITS"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Tx = 24
  Rep = 0
tp_loop:
  Frame1
  Rnd16
  inc Tx
  if Tx > 215 then Tx = 24
  V = Tick >> 3
  V = V & 7
  Ts = PoseSpr[V]
  set sprite 0 to 47,Tx,Ts,15
  update sprites
  ReadPad
  V = J1 | J2
  K = V & 3
  if K > 0 then
    if WasStick = 0 then
      C = K & 1
      if C > 0 then
        if Menu > 0 then dec Menu
      end if
      C = K & 2
      if C > 0 then
        if Menu < 4 then inc Menu
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = K
  ' EGGS: left/right, held down it repeats
  C = V & 12
  if Menu = 2 then
    if C > 0 then
      inc Rep
      if Rep = 1 then EggStep(C)
      if Rep >= 20 then
        EggStep(C)
        Rep = 16
      end if
    else
      Rep = 0
    end if
  end if
  if Press = 0 then goto tp_loop
  if Menu = 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub EggStep(u8 Way)
  if Way = 4 then
    if EggSet > 1 then dec EggSet
  else
    if EggSet < 255 then inc EggSet
  end if
  ShowMenu
  return
end sub

sub ShowMenu:
  for I = 0 to 4
    J = I << 1
    J = J + 13
    put char 32 at 7,J
  next
  J = Menu << 1
  J = J + 13
  put char 62 at 7,J
  NumU = EggSet
  print at 15,17, "< "
  print at 17,17, digits$(NumU, 3)
  print at 21,17, ">"
  return
end sub

' HOW TO PLAY: two pages with the game's tiles and sprites; the button
' turns the page; after the last one (or 30 s without a press) the title
sub HowTo:
  u8 Pg = 0
  u16 Wt = 0
  for Pg = 1 to 2
    NewScreen
    print at 10,1, "HOW TO PLAY"
    HowPage(Pg)
    print at 9,22, "BUTTON: NEXT"
    ShowScreen
    Rearm
    wait no fire
    nmi off
    WasBtn = 1
    Wt = 0
hw_loop:
    Frame1
    ReadPad
    if Press = 1 then goto hw_next
    inc Wt
    if Wt < 1800 then goto hw_loop
    Pg = 2
hw_next:
    play sound SndTick
  next
  HideSprites
  return
end sub

sub HowPage(u8 P)
  select case P
  case 1
    print at 2,3, "BOUNCE THE WHIRLYBIRD'S EGGS"
    print at 2,4, "DOWN INTO THE BRICKS. CLEAR"
    print at 2,5, "THEM ALL TO WIN."
    set sprite 0 to 55,56,SBwide,15
    set sprite 1 to 71,61,SEgg,11
    for I = 0 to 3
      X = I << 1
      X = X + 4
      put char TBrk1a at X,11
      inc X
      put char TBrk1b at X,11
    next
    put char TRnda at 8,11
    put char TRndb at 9,11
    print at 15,8, "STICK LEFT/"
    print at 15,9, "RIGHT: FLY."
    print at 15,10, "IT SPEEDS UP"
    print at 15,11, "AND COASTS."
    print at 2,14, "BUTTON: RELEASE AN EGG."
    print at 2,15, "MEET IT ON ITS WAY UP: THE"
    print at 2,16, "STICK THEN SENDS IT LEFT,"
    print at 2,17, "RIGHT OR STRAIGHT BACK DOWN."
    print at 2,18, "FEET ARE SAFEST; A WING MAY"
    print at 2,19, "JUGGLE IT. SIDE-ON IS SLIM."
  case else
    print at 2,3, "BRICK 1  EGG BOUNCED BACK 10"
    print at 2,4, "EGG LOST INTO SPACE -10"
    print at 2,5, "ALL BRICKS CLEARED +50"
    put char TRnda at 2,7
    put char TRndb at 3,7
    print at 5,7, "ROUND BRICK: A FREE EGG"
    print at 5,8, "AND A NEW SIDEBEAM"
    put char TPost1 at 3,10
    put char TPost2 at 3,11
    print at 5,10, "SIDEBEAMS KNOCK EGGS"
    print at 5,11, "SIDEWAYS, MAYBE BREAK"
    put char TEggi at 2,13
    print at 4,13, "EGGS LEFT: UPPER RIGHT."
    print at 2,14, "NONE LEFT: GAME OVER."
    print at 2,16, "EXPERT: A HALF-SIZE BIRD."
    print at 2,18, "TIP: SHORT TAPS STEER BEST."
    print at 2,19, "THE BIRD KEEPS GOING."
  end select
  update sprites
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,1, "WHIRLYBIRD"
  print at 2,3, "BASED ON WHIRLYBIRD BY"
  print at 2,4, "PHILIP I. NELSON, COMPUTE!'S"
  print at 2,5, "GAZETTE, DECEMBER 1985"
  print at 2,6, "(COMMODORE 64)."
  print at 2,8, "COLECOVISION GAME, MUSIC AND"
  print at 2,9, "PICTURES BY CLAUDE"
  print at 2,10, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,11, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,12, "MUSIC: EGG OVER EASY"
  print at 2,14, "STICK: FLY LEFT AND RIGHT"
  print at 2,15, "BUTTON: RELEASE AN EGG"
  print at 2,17, "A BREAKOUT GAME WITH A"
  print at 2,18, "SPINNING BIRD FOR A PADDLE."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
cr_loop:
  Frame1
  ReadPad
  if Press = 0 then goto cr_loop
  return
end sub

