data LvInfo bytes
  6,6,165,1
  8,6,150,1
  8,7,140,2
  10,7,130,3
  10,8,120,2
  12,8,110,2
  12,9,105,2
  14,9,95,3
end data
data LvNames bytes
  70,73,82,83,84,32,80,79,73,78,84,83,32,32
  84,72,82,69,69,32,87,65,89,83,32,32,32,32
  84,87,79,32,84,85,78,78,69,76,83,32,32,32
  67,82,79,83,83,32,84,79,87,78,32,32,32,32
