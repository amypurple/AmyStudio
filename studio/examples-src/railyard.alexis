asm {
; RAILYARD: the yard lives in the name table ($1800), one tile a cell.

; RyAddr: HL = the name table address of column Tx, row Ty
RyAddr:
    ld a,(AMY_UVAR_Ty)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Tx)
    or l
    ld l,a
    ld de,$1800
    add hl,de
    ret

; RyGet: Tt = the tile at Tx, Ty
RyGet:
    call RyAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Tt),a
    ret

; RyPut: the tile Tt at Tx, Ty
RyPut:
    call RyAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Tt)
    out ($BE),a
    ret

; RyDraw: the yard at LvMap + MapP on to rows 2-20, columns 2-29
RyDraw:
    ld hl,(AMY_UVAR_MapP)
    ld de,AMY_UDATA_LvMap
    add hl,de
    ld de,$1800+64+2
    ld c,19
RyDr1:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld b,28
RyDr2:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz RyDr2
    ex de,hl
    ld a,c
    ld bc,32
    add hl,bc
    ld c,a
    ex de,hl
    dec c
    jr nz,RyDr1
    ret

RyHush:
    db $00,$00,$F4,$01,$10
RyTick:
    db $40,$40,$50,$01,$50
RyClick:
    db $00,$00,$23,$01,$00,$00,$55,$02,$10
RyNo:
    db $40,$F9,$22,$04,$40,$F9,$33,$06,$50
RyToot:
    db $40,$BF,$30,$06,$40,$FF,$83,$03,$40,$BF,$30,$08,$50
RyDing:
    db $80,$55,$20,$03,$80,$6B,$30,$03,$80,$55,$40,$08,$90
RyCrash:
    db $C0,$F9,$13,$04,$C0,$FF,$23,$06,$C0,$FF,$53,$0A,$D0
RyWin:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$30,$10,$50
RyLose:
    db $40,$1D,$21,$08,$40,$53,$31,$08,$40,$AB,$41,$08,$40,$3B,$52,$14,$50

RySoundTable:
    dw RyHush,$702B
    dw RyTick,$7035
    dw RyClick,$702B
    dw RyNo,$7035
    dw RyToot,$7035
    dw RyDing,$703F
    dw RyCrash,$7049
    dw RyWin,$7035
    dw RyLose,$7035
    dw RyTuneMel,$703F
    dw RyTuneBass,$7049
; Down the Line, A major (original for this game)
; Tiny Sound, 7 frames per step
RyTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$1C,$00,$20,$23,$28,$00,$23,$20,$1E,$00,$21,$25
    db $2A,$00,$25,$21,$23,$00,$27,$2A,$2F,$00,$2A,$27,$28,$00,$25,$21
    db $20,$23,$28,$20,$1E,$21,$27,$1E,$1C,$20,$23,$28,$AF,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
RyTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$10,$17,$10,$17,$10,$17,$10,$17,$12,$19,$12,$19
    db $12,$19,$12,$19,$17,$12,$17,$12,$17,$12,$17,$12,$15,$10,$15,$10
    db $10,$17,$10,$17,$17,$12,$17,$12,$10,$17,$10,$17,$10,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
; the title song: both voices of Down the Line at once
RySong:
    dw $0001
    db $40+10,11
    dw $0000
}
