cartridge "NUMBER QUEST/COMPUTE'S GAZETTE/1985"

' NUMBER QUEST
' A ColecoVision game based on "Number Quest", COMPUTE!'s Gazette,
' April 1985 (Commodore 64 and VIC-20, BASIC; the listing and the disk
' name no author). Made for Amy Studio by Claude (an AI made by
' Anthropic), 2026, in Amy by Amy Bienvenu.
'
' The game: the computer thinks of a number from 10 to 99. You have five
' turns to guess it. After a wrong guess it says TOO HIGH or TOO LOW, and
' when the guess is off by a factor of two or more it says how many TIMES
' too high or too low (INT(guess / number) or INT(number / guess)). A
' fifth wrong guess loses and shows the number.
'
' From the original (orig/nquest64.bas, primary; orig/questvic.bas): the
' secret INT(RND * 90 + 10), five turns, the TIMES clue and its rounding,
' "TOO HIGH" / "TOO LOW" when the factor is 1, no clue after the fifth
' miss, the screens' words (YOU HAVE 5 TURNS TO GUESS A NUMBER FROM 10 TO
' 100, GUESS THE NUMBER, TURN, SORRY YOU MISSED, THE NUMBER WAS,
' CONGRATULATIONS YOU GUESSED IT), the little man going down the cliff
' to the water when you lose.
'
' Liberties:
' - Numeric entry is a joystick dial (a carved tablet): left/right -1/+1,
'   up/down +10/-10, held directions repeat, a button guesses.
' - The dial runs from 10 to 100, the range the original's own
'   instructions print. The original accepted 3 to 100 (1 and 2 were
'   "TOO EASY"), and with the TIMES clue a first guess of 3 gives the
'   number to within three, so every game was won in three turns by a
'   trick. From 10 up, sound play (first 10, which gives the tens, then
'   halving) still wins every game in five turns, and plain halving
'   without the TIMES clue wins only about a third: the clue matters.
' - The man walks down one step of the cliff after each wrong guess (the
'   original drew him only at the end); a log keeps every guess and clue
'   on screen (the original erased each clue after a pause).
' - A win shows a treasure chest rising from the sea; the end screens
'   wait for a button instead of a delay; the title counts quests won.
' - The art, the sounds and the title tune ("Down to the Sea") are new.
'
' Controls: either controller; stick and side buttons only.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' frame loop protected from the NMI; screens drawn with the NMI off and
' the display off. Music first in the sound table, the title tune once.

const TSky = 128
const TStar = 129
const TStar2 = 130
const TMoon = 131
const TWave = 132
const TWave2 = 133
const TSea = 134
const TDeep = 135
const TTop = 136
const TRock = 137
const TTopr = 138
const TTbl = 139
const TTblt = 140
const TTblb = 141
const TTbll = 142
const TTblr = 143
const TTbltl = 144
const TTbltr = 145
const TTblbl = 146
const TTblbr = 147
const TArl = 148
const TArr = 149
const TAru = 150
const TArd = 151
const TRule = 152
const TDig000 = 153
const TDig001 = 154
const TDig010 = 155
const TDig011 = 156
const TDig100 = 157
const TDig101 = 158
const TDig110 = 159
const TDig111 = 160
const TDig200 = 161
const TDig201 = 162
const TDig210 = 163
const TDig211 = 164
const TDig300 = 165
const TDig301 = 166
const TDig310 = 167
const TDig311 = 168
const TDig400 = 169
const TDig401 = 170
const TDig410 = 171
const TDig411 = 172
const TDig500 = 173
const TDig501 = 174
const TDig510 = 175
const TDig511 = 176
const TDig600 = 177
const TDig601 = 178
const TDig610 = 179
const TDig611 = 180
const TDig700 = 181
const TDig701 = 182
const TDig710 = 183
const TDig711 = 184
const TDig800 = 185
const TDig801 = 186
const TDig810 = 187
const TDig811 = 188
const TDig900 = 189
const TDig901 = 190
const TDig910 = 191
const TDig911 = 192
const TLN00 = 193
const TLN01 = 194
const TLN10 = 195
const TLN11 = 196
const TLU00 = 197
const TLU01 = 198
const TLU10 = 199
const TLU11 = 200
const TLM00 = 201
const TLM01 = 202
const TLM10 = 203
const TLM11 = 204
const TLB00 = 205
const TLB01 = 206
const TLB10 = 207
const TLB11 = 208
const TLE00 = 209
const TLE01 = 210
const TLE10 = 211
const TLE11 = 212
const TLR00 = 213
const TLR01 = 214
const TLR10 = 215
const TLR11 = 216
const TLQ00 = 217
const TLQ01 = 218
const TLQ10 = 219
const TLQ11 = 220
const TLS00 = 221
const TLS01 = 222
const TLS10 = 223
const TLS11 = 224
const TLT00 = 225
const TLT01 = 226
const TLT10 = 227
const TLT11 = 228
const SMan = 0
const SHat = 4
const SMan2 = 8
const SHat2 = 12
const SSplash = 16
const SChest = 20
const SBand = 24
const SGlint = 28
const NTiles8 = 808
const SprBytes = 256
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndBump = 4
const SndGuess = 5
const SndHigh = 6
const SndLow = 7
const SndStep = 8
const SndSplash = 9
const SndFall = 10
const SndWin = 11
const NSpr = 6
const MaxTurns = 5
const DialLo = 10
const DialHi = 100
const LogRow = 17
const SeaRow = 13

record LogE:
  u8 G
  u8 D
  u8 H
end record

' each step of the cliff: its left column and its top row
data StepC bytes
  2, 5, 8, 11, 14
end data
data StepR bytes
  4, 6, 8, 10, 12
end data
' stars on the night sky: column, row
data StarCR bytes
  3, 2, 7, 1, 10, 3, 15, 2, 17, 5, 13, 7, 16, 9, 27, 10, 21, 11, 8, 2
end data
' the title's letters
data TitleGl bytes
  TLN00, TLU00, TLM00, TLB00, TLE00, TLR00, TLQ00, TLU00, TLE00, TLS00, TLT00
end data

LogE Lg[5]
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Played = 0
u16 WonN = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Secret = 0
u8 Dial = 50
u8 Turn = 1
u8 Ask = 0
u8 Over = 0
u8 Won = 0
u8 ClH = 0
u8 ClD = 0
u8 Gi = 0
u8 Hx = 0
u8 Hy = 0
u8 HFr = 0
u8 ChY = 0
u8 WaveF = 0
u8 Menu = 0
u8 TitleOn = 0
u8 RepT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Lj = 0
u8 Lw = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table NqSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  Ask = 0
  if Won = 1 then
    WinShow
  else
    LoseShow
  end if
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' rules

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' the original's R = INT(RND(1) * 90 + 10): 10 to 99
function NewSecret as u8
  u8 Sv = 0
  Rand
  W16 = Rs % 90
  Sv = W16
  return Sv + DialLo

' the clue: sets ClH (1 too high, 2 too low) and returns the factor
' INT(S / R) or INT(R / S); 1 means a plain TOO HIGH / TOO LOW
function ClueOf(u8 Sg, u8 Rv) as u8
  u8 Dq = 0
  if Sg > Rv then
    ClH = 1
    Dq = Sg / Rv
  else
    ClH = 2
    Dq = Rv / Sg
  end if
  return Dq

' the dial after a move up or down by Amt, kept inside 10 to 100
function DialAdd(u8 Dv, u8 Amt, u8 Up) as u8
  u8 Nv = 0
  if Up = 1 then
    Nv = Dv + Amt
    if Nv > DialHi then Nv = DialHi
  else
    Nv = DialLo
    if Dv >= Amt + DialLo then Nv = Dv - Amt
  end if
  return Nv

sub NewGame:
  Secret = NewSecret
  inc Played
  Turn = 1
  Over = 0
  Won = 0
  Dial = 50
  for Li = 0 to 4
    Lg[Li].G = 0
    Lg[Li].D = 0
    Lg[Li].H = 0
  next
  DrawPlay
  Hx = StepC[0]
  Hx = Hx << 3
  Hx = Hx + 4
  Hy = StepR[0]
  Hy = Hy << 3
  Hy = Hy - 15
  HFr = 0
  DrawMan
  return
end sub

sub PlayStep:
  Ask = 1
  ' the waves roll slowly
  V = Tick & 31
  if V = 0 then
    WaveF = WaveF ^ 1
    DrawWaves
  end if
  ' the dial: a new direction moves at once, a held one repeats
  K = 0
  if Edge > 0 then
    K = Edge
    RepT = 15
  else
    if Jk > 0 then
      dec RepT
      if RepT = 0 then
        K = Jk
        RepT = 4
      end if
    end if
  end if
  if K > 0 then MoveDial(K)
  if Press = 1 then MakeGuess
  return
end sub

sub MoveDial(u8 Mk):
  u8 Old = 0
  Old = Dial
  select case Mk
  case 1
    Dial = DialAdd(Dial, 10, 1)
  case 2
    Dial = DialAdd(Dial, 10, 0)
  case 4
    Dial = DialAdd(Dial, 1, 0)
  case 8
    Dial = DialAdd(Dial, 1, 1)
  case else
    Old = Dial
  end select
  if Dial = Old then
    play sound SndBump
  else
    play sound SndClick
    DrawDial(Dial)
  end if
  return
end sub

sub MakeGuess:
  Ask = 0
  play sound SndGuess
  Gi = Turn - 1
  Lg[Gi].G = Dial
  if Dial = Secret then
    Lg[Gi].H = 0
    Lg[Gi].D = 0
    Won = 1
    Over = 1
    DrawLog(Gi)
  else
    ClD = ClueOf(Dial, Secret)
    Lg[Gi].D = ClD
    Lg[Gi].H = ClH
    inc Turn
    if Turn > MaxTurns then
      ' the original gives no clue after the fifth miss
      Lg[Gi].H = 3
      Over = 1
      DrawLog(Gi)
    else
      DrawLog(Gi)
      if ClH = 1 then
        play sound SndHigh
      else
        play sound SndLow
      end if
      Pause(20)
      WalkDown(Gi)
      ShowTurn
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the man on the cliff

sub DrawMan:
  T = SMan
  K = SHat
  if HFr = 1 then
    T = SMan2
    K = SHat2
  end if
  Y = Hy
  set sprite 0 to Y,Hx,K,11
  set sprite 1 to Y,Hx,T,8
  update sprites
  return
end sub

' from step Sa to the next: 24 frames right, dropping two rows in the middle
sub WalkDown(u8 Sa):
  play sound SndStep
  for Lw = 0 to 23
    Frame1
    inc Hx
    if Lw >= 8 then
      if Lw < 16 then Hy += 2
    end if
    V = Lw & 4
    HFr = 0
    if V > 0 then HFr = 1
    DrawMan
  next
  HFr = 0
  DrawMan
  return
end sub

sub Pause(u8 Pf):
  for Lw = 1 to Pf
    Frame1
  next
  return
end sub

' the fifth miss: he walks off the last step into the sea
sub LoseShow:
  play sound SndFall
  for Lj = 0 to 19
    Frame1
    inc Hx
    V = Lj & 4
    HFr = 0
    if V > 0 then HFr = 1
    DrawMan
  next
  V = 1
  while Hy < 98
    Frame1
    Hy += V
    if V < 4 then inc V
    DrawMan
  end while
  play sound SndSplash
  Y = 99
  X = Hx
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  set sprite 4 to Y,X,SSplash,15
  update sprites
  Pause(40)
  Frame1
  set sprite 4 to 192,0,0,0
  update sprites
  ' the number, on the tablet
  print at 19,2, "THE NUMBER"
  DrawDial(Secret)
  fill 32 count 28 at 2,22
  print at 2,22, "SORRY, YOU MISSED"
  print at 18,9, "PRESS BUTTON"
  return
end sub

' a win: the man hops, a chest rises from the sea
sub WinShow:
  play sound SndWin
  ChY = 106
  for Lj = 0 to 47
    Frame1
    V = Lj & 15
    if V < 4 then
      Hy -= 2
    else
      if V < 8 then Hy += 2
    end if
    DrawMan
    if Lj >= 12 then
      V = Lj % 3
      if V = 0 then
        if ChY > 94 then dec ChY
      end if
      set sprite 2 to ChY,184,SBand,6
      set sprite 3 to ChY,184,SChest,10
      update sprites
    end if
  next
  Y = ChY - 2
  set sprite 4 to Y,194,SGlint,15
  update sprites
  print at 19,2, "THE NUMBER"
  fill 32 count 28 at 2,22
  print at 2,22, "CONGRATULATIONS! FOUND IT"
  print at 18,9, "PRESS BUTTON"
  inc WonN
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub PutBig(u8 Tb, u8 Bc, u8 Br):
  u8 Cb = 0
  u8 Rb = 0
  Cb = Bc + 1
  Rb = Br + 1
  put char Tb at Bc,Br
  inc Tb
  put char Tb at Cb,Br
  inc Tb
  put char Tb at Bc,Rb
  inc Tb
  put char Tb at Cb,Rb
  return
end sub

' the dial's number in big digits on the tablet (no leading zero)
sub DrawDial(u8 Dn):
  u8 Hd = 0
  u8 Td = 0
  u8 Od = 0
  Hd = Dn / 100
  Td = Dn % 100
  Td = Td / 10
  Od = Dn % 10
  if Hd = 0 then
    fill TTbl count 2 at 21,5
    fill TTbl count 2 at 21,6
  else
    PutBig(TDig000 + Hd * 4, 21, 5)
  end if
  PutBig(TDig000 + Td * 4, 23, 5)
  PutBig(TDig000 + Od * 4, 25, 5)
  return
end sub

sub DrawTablet:
  put char TTbltl at 19,3
  fill TTblt count 8 at 20,3
  put char TTbltr at 28,3
  for Lj = 4 to 7
    put char TTbll at 19,Lj
    fill TTbl count 8 at 20,Lj
    put char TTblr at 28,Lj
  next
  put char TTblbl at 19,8
  fill TTblb count 8 at 20,8
  put char TTblbr at 28,8
  return
end sub

sub DrawWaves:
  T = TWave
  if WaveF = 1 then T = TWave2
  fill T count 13 at 17,SeaRow
  return
end sub

sub ShowTurn:
  print at 19,11, "TURN"
  NumU = Turn
  print at 24,11, digits$(NumU, 1)
  print at 26,11, "OF 5"
  return
end sub

' one line of the log: turn, guess, clue
sub DrawLog(u8 Ln):
  u8 Rl = 0
  u8 Gv = 0
  u8 Dv = 0
  u8 Hv = 0
  Rl = LogRow + Ln
  Gv = Lg[Ln].G
  Dv = Lg[Ln].D
  Hv = Lg[Ln].H
  NumU = Ln + 1
  print at 3,Rl, digits$(NumU, 1)
  print Gv at 8,Rl width 3
  select case Hv
  case 0
    print at 13,Rl, "FOUND IT!"
  case 3
    print at 13,Rl, "NO MORE TURNS"
  case else
    if Dv > 1 then
      print Dv at 13,Rl width 2
      print at 15,Rl, " TIMES TOO"
      C = 26
    else
      print at 13,Rl, "TOO"
      C = 17
    end if
    if Hv = 1 then
      print at C,Rl, "HIGH"
    else
      print at C,Rl, "LOW"
    end if
  end select
  return
end sub

sub DrawStars:
  for Lj = 0 to 9
    K = Lj << 1
    C = StarCR[K]
    inc K
    Y = StarCR[K]
    T = TStar
    V = Lj & 1
    if V = 1 then T = TStar2
    put char T at C,Y
  next
  return
end sub

sub DrawPlay:
  NewScreen
  DrawStars
  put char TMoon at 12,2
  print at 2,1, "GUESS THE NUMBER"
  ShowTurn
  ' the cliff: five steps down to the sea
  for Li = 0 to 4
    C = StepC[Li]
    Y = StepR[Li]
    fill TTop count 3 at C,Y
    inc Y
    for Lj = Y to 14
      fill TRock count 3 at C,Lj
    next
  next
  put char TTopr at 16,12
  WaveF = 0
  DrawWaves
  fill TSea count 13 at 17,14
  ' the tablet and its help line
  print at 19,2, "YOUR GUESS"
  DrawTablet
  DrawDial(Dial)
  put char TArl at 19,9
  put char TArr at 20,9
  print at 21,9, "1"
  put char TAru at 24,9
  put char TArd at 25,9
  print at 26,9, "10"
  ' the log
  fill TRule count 28 at 2,15
  print at 2,16, "TURN"
  print at 7,16, "GUESS"
  print at 13,16, "CLUE"
  print at 4,22, "PUSH A BUTTON TO GUESS"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: NUMBER QUEST in gold over the night sea, the tune once
sub TitlePage:
  Ask = 0
  TitleOn = 1
  NewScreen
  DrawStars
  put char TMoon at 25,2
  for Li = 0 to 5
    T = TitleGl[Li]
    C = Li << 1
    C = C + 10
    PutBig(T, C, 3)
  next
  for Li = 6 to 10
    T = TitleGl[Li]
    C = Li << 1
    C = C - 1
    PutBig(T, C, 6)
  next
  print at 8,9, "YOU HAVE 5 TURNS"
  print at 7,10, "TO GUESS A NUMBER"
  print at 9,11, "FROM 10 TO 100"
  print at 13,13, "START"
  print at 13,15, "CREDITS"
  ' a rock and the sea
  fill TTop count 4 at 3,17
  fill TRock count 4 at 3,18
  fill TRock count 4 at 3,19
  fill TWave count 21 at 7,18
  fill TSea count 21 at 7,19
  fill TSea count 25 at 3,20
  print at 5,22, "COMPUTE!'S GAZETTE 1985"
  print at 13,21, "WON"
  NumU = WonN
  print at 17,21, digits$(NumU, 3)
  print at 21,21, "OF"
  NumU = Played
  print at 24,21, digits$(NumU, 3)
  ShowMenu
  ShowScreen
  Hx = 28
  Hy = 120
  HFr = 0
  DrawMan
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Tick & 31
  if V = 0 then
    WaveF = WaveF ^ 1
    T = TWave
    if WaveF = 1 then T = TWave2
    fill T count 21 at 7,18
  end if
  K = Edge & 3
  if K > 0 then
    Menu = Menu ^ 1
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  TitleOn = 0
  HideSprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,13
  put char 32 at 11,15
  C = Menu << 1
  C = C + 13
  put char 62 at 11,C
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $B4
  print at 9,2, "NUMBER QUEST"
  print at 2,5, "BASED ON NUMBER QUEST,"
  print at 2,6, "COMPUTE!'S GAZETTE, APRIL"
  print at 2,7, "1985 (COMMODORE 64 AND"
  print at 2,8, "VIC-20). NO AUTHOR IS NAMED"
  print at 2,9, "IN THE LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: DOWN TO THE SEA"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$08,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$20,$00,$00
  $00,$1C,$38,$70,$70,$70,$38,$1C
  $00,$00,$00,$61,$61,$00,$10,$00
  $00,$00,$00,$0C,$0C,$00,$02,$00
  $00,$20,$00,$04,$00,$80,$00,$08
  $00,$20,$00,$04,$00,$80,$00,$08
  $00,$A5,$22,$00,$40,$04,$00,$80
  $00,$10,$02,$00,$80,$08,$00,$20
