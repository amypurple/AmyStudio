const NSpr = 2
const RepFirst = 15
const RepNext = 6
const NoReg = 255
const BX = 7
const BY = 3
const NReg = 70
const NShape = 18
const ThinkDelay = 30
const CpuPace = 4
const CpuLinger = 24
const FlipGap = 8

record Plr:
  u8 Score
  u8 Colr
end record

Plr Pl[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
u16 Seed = 12345
u16 CpuSeed = 0
u8 Own[70]
u8 Drawn[70]
u8 Hand[36]
u8 Legal[70]
u8 Deck[70]
u8 NLegal = 0
u8 BestV = 0
u8 Cx = 0
u8 Cy = 0
u8 Hover = 255
u8 Sx = 0
u8 Sy = 0
u8 Turn = 0
u8 Tu = 0
u8 Over = 0
u8 Winner = 0
u8 Flips = 0
u8 LastReg = 255
u8 GiveMode = 0
u8 NPlay = 1
u8 CpuSide = 1
u8 Level = 0
u8 CpuGoal = 255
u8 CpuWait = 0
u8 InMove = 0
u8 RepT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Stick = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 InPlay = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Cc = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table GtSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 5 then goto title

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Over = 0 then goto play_loop

  EndGame
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the game

sub NewGame:
  Pl[0].Colr = 7
  Pl[1].Colr = 13
  Pl[0].Score = 0
  Pl[1].Score = 0
  Turn = 0
  Tu = 0
  Over = 0
  Winner = 0
  LastReg = NoReg
  CpuGoal = NoReg
  Cx = 8
  Cy = 6
  Deal
  BoardPage
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 0
  return
end sub

' a 16-bit xorshift; the title advances it every frame
sub Mix:
  Seed ^= Seed << 7
  Seed ^= Seed >> 9
  Seed ^= Seed << 8
  return
end sub

function RndBelow(u8 Lim) as u8
  u8 Lo = 0
  Mix
  Lo = Seed >> 4
  return Lo % Lim

' the deal (lines 720-740): the 70 pieces shuffled, 35 to each player
sub Deal:
  u8 Ix = 0
  u8 Jx = 0
  u8 Tmp = 0
  u16 Hi = 0
  for Ix = 0 to 35
    Hand[Ix] = 0
  next
  for Ix = 0 to 69
    Deck[Ix] = Ix
    Own[Ix] = 2
    Drawn[Ix] = 255
  next
  for Ix = 69 downto 1
    Jx = RndBelow(Ix + 1)
    Tmp = Deck[Ix]
    Deck[Ix] = Deck[Jx]
    Deck[Jx] = Tmp
  next
  for Ix = 0 to 69
    Tmp = Deck[Ix]
    Hi = 0
    if Ix >= 35 then Hi = NShape
    ' (inc Hand[Hi + RegShape[Tmp]] is refused: bugs/givetake-inc-index-of-index.alexis)
    Hi = Hi + RegShape[Tmp]
    inc Hand[Hi]
  next
  return
end sub

' the region under board cell (Ax, Ay)
function RegAt(u8 Ax, u8 Ay) as u8
  u16 Ix = 0
  Ix = Ay * BoardW + Ax
  return Grid[Ix]

' how many of the side to move's pieces fit region R
function Held(u8 P, u8 R) as u8
  u8 Ix = 0
  Ix = P * NShape + RegShape[R]
  return Hand[Ix]

function CanPlay(u8 P, u8 R) as u8
  if Own[R] <> 2 then return 0
  if Held(P, R) = 0 then return 0
  return 1

' how many neighbours of R player P's opponent holds
function OppNb(u8 R, u8 P) as u8
  u8 Ix = 0
  u8 Q = 0
  u8 N = 0
  u16 Bs = 0
  Bs = R * 7
  for Ix = 0 to 6
    Q = Nb[Bs + Ix]
    if Q <> NoReg then
      if Own[Q] = (P ^ 1) then inc N
    end if
  next
  return N

' one frame of play
sub PlayStep:
  if NPlay = 1 then
    if Turn = CpuSide then
      CpuStep
      return
    end if
  end if
  MoveCursor
  if Press = 1 then TryPlace
  return
end sub

sub MoveCursor:
  if Stick = 0 then
    RepT = 0
    WasStick = 0
    return
  end if
  if WasStick = Stick then
    inc RepT
    if RepT < RepFirst then return
    RepT = RepFirst - RepNext
  else
    RepT = 0
  end if
  WasStick = Stick
  StepDir(Stick)
  return
end sub

' the cursor in direction S (1 up, 2 down, 4 left, 8 right) to the first
' cell of another region; it stays put at the edge of the board
sub StepDir(u8 S):
  i8 Dx = 0
  i8 Dy = 0
  i8 Nx = 0
  i8 Ny = 0
  u8 R0 = 0
  u8 Ok = 0
  select case S
  case 1
    Dy = -1
  case 2
    Dy = 1
  case 4
    Dx = -1
  case 8
    Dx = 1
  end select
  R0 = RegAt(Cx, Cy)
  Nx = Cx
  Ny = Cy
  while Ok = 0
    Nx = Nx + Dx
    Ny = Ny + Dy
    if Nx < 0 or Ny < 0 or Nx >= BoardW or Ny >= BoardH then
      Ok = 2
    elseif RegAt(Nx, Ny) <> R0 then
      Ok = 1
    end if
  end while
  if Ok = 2 then return
  Cx = Nx
  Cy = Ny
  play sound SndStep
  SetHover
  return
end sub

' the lit region follows the cursor
sub SetHover:
  u8 Old = 0
  u8 Nw = 0
  Nw = RegAt(Cx, Cy)
  if Nw = Hover then return
  Old = Hover
  Hover = Nw
  if Old <> NoReg then DrawReg(Old)
  DrawReg(Hover)
  ShowInfo
  return
end sub

' the look of region R: 0 free, 1 free and playable, 2/3 a player's, 4 lit
function RegState(u8 R) as u8
  if R = Hover then return 4
  if Own[R] < 2 then return Own[R] + 2
  return CanPlay(Turn, R)

sub DrawReg(u8 R):
  u8 St = 0
  u8 Ix = 0
  u8 Last = 0
  u8 Base = 0
  St = RegState(R)
  Drawn[R] = St
  Base = TQ0x0 + St * 15
  Ix = RegFirst[R]
  Last = RegFirst[R + 1]
  while Ix < Last
    put char Base + CellG[Ix] at BX + CellX[Ix],BY + CellY[Ix]
    inc Ix
  end while
  return
end sub

' redraws every region whose look changed
sub RefreshBoard:
  u8 R = 0
  for R = 0 to NReg - 1
    if RegState(R) <> Drawn[R] then DrawReg(R)
  next
  return
end sub

' the button on the lit region
sub TryPlace:
  if Own[Hover] <> 2 then
    play sound SndBad
    Message(1)
    return
  end if
  if Held(Turn, Hover) = 0 then
    play sound SndBad
    Message(2)
    return
  end if
  Message(0)
  DoMove(Hover)
  return
end sub

' a real move (lines 910-960): the piece, then each opponent's neighbour
' turns, one by one
sub DoMove(u8 R):
  u8 Ix = 0
  u8 Q = 0
  u8 Opp = 0
  u16 Bs = 0
  InMove = 1
  LastReg = R
  Opp = Turn ^ 1
  Ix = Turn * NShape + RegShape[R]
  dec Hand[Ix]
  Own[R] = Turn
  inc Pl[Turn].Score
  inc Tu
  DrawReg(R)
  DrawHand(Turn)
  ShowScores
  play sound SndPlace
  Flips = 0
  Bs = R * 7
  for Ix = 0 to 6
    Q = Nb[Bs + Ix]
    if Q <> NoReg then
      if Own[Q] = Opp then
        FrameN(FlipGap)
        Own[Q] = Turn
        inc Pl[Turn].Score
        dec Pl[Opp].Score
        DrawReg(Q)
        ShowScores
        play sound SndFlip
        inc Flips
      end if
    end if
  next
  if Flips > 0 then Message(3)
  if Tu >= NReg then
    FindWinner
    Over = 1
    InMove = 0
    return
  end if
  Turn = Opp
  CpuGoal = NoReg
  ShowTurn
  RefreshBoard
  ShowInfo
  InMove = 0
  return
end sub

' line 980-1010: the most regions wins TAKE, the fewest GIVE
sub FindWinner:
  u8 W = 1
  if Pl[0].Score = Pl[1].Score then
    Winner = 3
    return
  end if
  if Pl[0].Score > Pl[1].Score then W = 0
  if GiveMode = 1 then W = W ^ 1
  Winner = W + 1
  return
end sub

' ---------------------------------------------------------------------------
' the computer (lines 1590-1660): every legal region in board order, one
' picked at random; GREEDY keeps only the ones that turn the most (TAKE)
' or the fewest (GIVE) of your regions

function MoveValue(u8 R) as u8
  u8 F = 0
  if Level = 0 then return 0
  F = OppNb(R, Turn)
  if GiveMode = 1 then return 7 - F
  return F

sub CpuThink:
  u8 R = 0
  u8 Vv = 0
  u8 Pk = 0
  NLegal = 0
  BestV = 0
  for R = 0 to NReg - 1
    if CanPlay(Turn, R) = 1 then
      Vv = MoveValue(R)
      if Vv > BestV then
        BestV = Vv
        NLegal = 0
      end if
      if Vv = BestV then
        Legal[NLegal] = R
        inc NLegal
      end if
    end if
  next
  CpuSeed = Seed
  Pk = RndBelow(NLegal)
  CpuGoal = Legal[Pk]
  return
end sub

' the computer's frame: think once, then walk the cursor to the region's
' first cell at a human pace, then place
sub CpuStep:
  u8 Gx = 0
  u8 Gy = 0
  u8 Fc = 0
  if CpuGoal = NoReg then
    Message(4)
    CpuThink
    CpuWait = ThinkDelay
    return
  end if
  if CpuWait > 0 then
    dec CpuWait
    return
  end if
  Fc = RegFirst[CpuGoal]
  Gx = CellX[Fc]
  Gy = CellY[Fc]
  CpuWait = CpuPace
  if Cx = Gx and Cy = Gy then
    if Hover = CpuGoal then
      Message(0)
      DoMove(CpuGoal)
      return
    end if
  end if
  if Cx < Gx then
    inc Cx
  elseif Cx > Gx then
    dec Cx
  elseif Cy < Gy then
    inc Cy
  elseif Cy > Gy then
    dec Cy
  end if
  SetHover
  if Hover = CpuGoal then CpuWait = CpuLinger
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the cursor frame glides to its cell
sub DrawCursor:
  if InPlay = 0 then return
  X = (Cx + BX) * 8 - 3
  Y = (Cy + BY) * 8 - 4
  Sx = Glide(Sx, X)
  Sy = Glide(Sy, Y)
  set sprite 0 to Sy,Sx,SCur,15
  set sprite 1 to Sy,Sx,SCurk,1
  update sprites
  return
end sub

function Glide(u8 Now, u8 Goal) as u8
  u8 Nx = Goal
  if Now + 4 < Goal then Nx = Now + 4
  if Now > Goal + 4 then Nx = Now - 4
  return Nx

sub BoardPage:
  u8 R = 0
  NewScreen
  backdrop black
  Hover = RegAt(Cx, Cy)
  for R = 0 to NReg - 1
    DrawReg(R)
  next
  put char TPa at 2,3
  put char TPb at 26,3
  if NPlay = 1 then
    if CpuSide = 0 then
      print at 3,3, "CPU"
      print at 27,3, "YOU"
    else
      print at 3,3, "YOU"
      print at 27,3, "CPU"
    end if
  else
    print at 3,3, "P1"
    print at 27,3, "P2"
  end if
  DrawHand(0)
  DrawHand(1)
  if GiveMode = 1 then
    print at 13,1, "GIVE"
  else
    print at 13,1, "TAKE"
  end if
  ShowScores
  ShowTurn
  ShowInfo
  Message(0)
  X = (Cx + BX) * 8 - 3
  Y = (Cy + BY) * 8 - 4
  Sx = X
  Sy = Y
  InPlay = 1
  ShowScreen
  return
end sub

' a hand (lines 1070-1180): each shape small, with how many are left
sub DrawHand(u8 P):
  u8 Kk = 0
  u8 Hx = 0
  u8 Hy = 0
  u8 Nn = 0
  for Kk = 0 to NShape - 1
    Hx = (Kk & 1) * 2 + 2 + P * 24
    Hy = (Kk >> 1) + 5
    Nn = Hand[P * NShape + Kk]
    if Nn > 0 then
      put char TH1 + Kk at Hx,Hy
    else
      put char TE1 + Kk at Hx,Hy
    end if
    put char 48 + Nn at Hx + 1,Hy
  next
  return
end sub

sub ShowScores:
  NumU = Pl[0].Score
  print at 2,1, digits$(NumU, 2)
  NumU = Pl[1].Score
  print at 28,1, digits$(NumU, 2)
  return
end sub

function SideName(u8 P) as u8
  if NPlay = 2 then return P
  if P = CpuSide then return 2
  return 3

sub ShowTurn:
  fill 32 count 28 at 2,18
  if Turn = 0 then
    put char TPa at 2,18
  else
    put char TPb at 2,18
  end if
  select case SideName(Turn)
  case 0
    print at 4,18, "PLAYER 1 TO MOVE"
  case 1
    print at 4,18, "PLAYER 2 TO MOVE"
  case 2
    print at 4,18, "THE COMPUTER MOVES"
  case else
    print at 4,18, "YOUR MOVE"
  end select
  return
end sub

' the lit region: its shape, owner, and the side to move's pieces of it
sub ShowInfo:
  u8 Sh = 0
  u8 Ow = 0
  fill 32 count 28 at 2,20
  if Hover = NoReg then return
  Sh = RegShape[Hover]
  put char TH1 + Sh at 2,20
  Ow = Own[Hover]
  if Ow < 2 then
    select case SideName(Ow)
    case 0
      print at 4,20, "HELD BY PLAYER 1"
    case 1
      print at 4,20, "HELD BY PLAYER 2"
    case 2
      print at 4,20, "HELD BY THE COMPUTER"
    case else
      print at 4,20, "HELD BY YOU"
    end select
    return
  end if
  NumU = Held(Turn, Hover)
  if NumU = 0 then
    print at 4,20, "FREE, NO PIECE TO FIT"
  else
    print at 4,20, "FREE, PIECES TO FIT: ", digits$(NumU, 1)
  end if
  return
end sub

sub Message(u8 M):
  fill 32 count 28 at 2,22
  select case M
  case 0
    if GiveMode = 1 then
      print at 2,22, "THE FEWEST REGIONS WINS"
    else
      print at 2,22, "THE MOST REGIONS WINS"
    end if
  case 1
    print at 2,22, "THAT REGION IS TAKEN"
  case 2
    print at 2,22, "NO PIECE OF THAT SHAPE"
  case 3
    NumU = Flips
    if Flips = 1 then
      print at 2,22, "1 REGION TURNED"
    else
      print at 2,22, digits$(NumU, 1), " REGIONS TURNED"
    end if
  case 4
    print at 2,22, "THINKING..."
  case 5
    print at 2,22, "IT'S A TIE"
  case 6
    select case SideName(Winner - 1)
    case 0
      print at 2,22, "PLAYER 1 IS THE WINNER"
    case 1
      print at 2,22, "PLAYER 2 IS THE WINNER"
    case 2
      print at 2,22, "THE COMPUTER IS THE WINNER"
    case else
      print at 2,22, "YOU ARE THE WINNER"
    end select
  end select
  return
end sub

sub EndGame:
  u8 Old = 0
  InPlay = 0
  FrameN(30)
  HideSprites
  Old = Hover
  Hover = NoReg
  DrawReg(Old)
  fill 32 count 28 at 2,18
  fill 32 count 28 at 2,20
  print at 2,18, "GAME OVER: ALL 70 PLACED"
  if Winner = 3 then
    play sound SndTie
    Message(5)
    return
  end if
  Message(6)
  play sound SndWin
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub FrameN(u8 Nf):
  u8 Fi = 0
  for Fi = 1 to Nf
    Frame1
  next
  return
end sub

' the sticks (1 up, 2 down, 4 left, 8 right) and a button press, either
' controller
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  K = V & 15
  Stick = 0
  if K & 8 then Stick = 8
  if K & 4 then Stick = 4
  if K & 2 then Stick = 2
  if K & 1 then Stick = 1
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: START GAME and the options, the tune once
sub TitlePage:
  u8 R = 0
  Menu = 0
  NewScreen
  backdrop black
  print at 8,2, "GIVE 'N' TAKE"
  ' a strip of the board as decoration
  Hover = NoReg
  Turn = 0
  for R = 0 to 9
    Own[R] = R % 3
    Hand[RegShape[R]] = 0
  next
  for R = 0 to 9
    DrawReg(R)
  next
  print at 2,9, "PLACE A PIECE ON A FREE"
  print at 2,10, "REGION OF ITS SHAPE: YOUR"
  print at 2,11, "RIVAL'S NEIGHBOURS TURN."
  print at 4,13, "START GAME"
  print at 4,14, "GAME"
  print at 4,15, "PLAYERS"
  print at 4,16, "COMPUTER"
  print at 4,17, "LEVEL"
  print at 4,18, "HOW TO PLAY"
  print at 4,19, "CREDITS"
  print at 2,21, "COMPUTE'S GAZETTE 8/87"
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 400
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 0
tp_loop:
  Frame1
  Mix
  ReadPad
  if Stick <> WasStick then
    select case Stick
    case 1
      if Menu > 0 then dec Menu
      if Menu = 4 and NPlay = 2 then Menu = 2
      if Menu = 3 and NPlay = 2 then Menu = 2
    case 2
      if Menu < 6 then inc Menu
      if Menu = 3 and NPlay = 2 then Menu = 5
    case 4, 8
      Toggle
    end select
    ShowMenu
  end if
  WasStick = Stick
  if Press = 0 then goto tp_loop
  if Menu > 0 and Menu < 5 then
    Toggle
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  if Menu = 5 then HowToPage
  if Menu = 6 then CreditsPage
  return
end sub

sub Toggle:
  select case Menu
  case 1
    GiveMode = GiveMode ^ 1
  case 2
    NPlay = 3 - NPlay
  case 3
    CpuSide = CpuSide ^ 1
  case 4
    Level = Level ^ 1
  end select
  return
end sub

sub ShowMenu:
  for Ci = 13 to 19
    put char 32 at 2,Ci
  next
  J = Menu + 13
  put char 62 at 2,J
  if GiveMode = 1 then
    print at 14,14, "GIVE: FEWEST"
  else
    print at 14,14, "TAKE: MOST  "
  end if
  if NPlay = 1 then
    print at 14,15, "1 VS COMPUTER"
  else
    print at 14,15, "2            "
  end if
  if NPlay = 2 then
    print at 14,16, "        "
    print at 14,17, "        "
    return
  end if
  if CpuSide = 1 then
    print at 14,16, "SECOND"
  else
    print at 14,16, "FIRST "
  end if
  if Level = 1 then
    print at 14,17, "GREEDY"
  else
    print at 14,17, "RANDOM"
  end if
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, 30 s idle goes back.
sub HowToPage:
  u8 Pg = 0
  u8 R = 0
  u16 Wt = 0
ht_page:
  NewScreen
  backdrop black
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    Hover = NoReg
    Turn = 0
    for R = 0 to 9
      Own[R] = R % 3
      Hand[RegShape[R]] = 0
    next
    for R = 0 to 9
      DrawReg(R)
    next
    print at 2,9, "THE BOARD IS A JIGSAW OF 70"
    print at 2,10, "PIECES. EACH PLAYER GETS 35"
    print at 2,11, "PIECES. YOU TAKE TURNS."
    print at 2,13, "ON YOUR TURN, PUT ONE OF"
    print at 2,14, "YOUR PIECES ON A FREE SPOT"
    print at 2,15, "OF THE SAME SHAPE. EVERY"
    print at 2,16, "RIVAL SPOT TOUCHING IT TURNS"
    print at 2,17, "TO YOUR COLOUR!"
    print at 2,19, "STICK: MOVE THE CURSOR."
    print at 2,20, "BUTTON: PUT THE PIECE DOWN."
  else
    print at 2,3, "WHITE SPOTS ARE FREE ONES"
    print at 2,4, "YOU CAN PLAY NOW. GREY ONES"
    print at 2,5, "YOU CANNOT. THE LINE UNDER"
    print at 2,6, "THE BOARD NAMES THE SHAPE"
    print at 2,7, "AND HOW MANY YOU HAVE."
    print at 2,9, "AFTER ALL 70 PIECES ARE"
    print at 2,10, "PLACED THE GAME ENDS."
    print at 2,11, "TAKE: MOST SPOTS WINS."
    print at 2,12, "GIVE: FEWEST SPOTS WINS."
    print at 2,14, "ON THE TITLE PICK THE GAME,"
    print at 2,15, "1 OR 2 PLAYERS, WHO GOES"
    print at 2,16, "FIRST AND THE COMPUTER."
    print at 2,18, "TIP: IN TAKE, PLAY NEXT TO"
    print at 2,19, "MANY RIVAL SPOTS."
    set sprite 0 to 159,120,SCur,15
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_loop:
  Frame1
  ReadPad
  inc Wt
  if Wt >= 1800 then goto ht_done
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
ht_done:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  backdrop black
  print at 8,2, "GIVE 'N' TAKE"
  print at 2,5, "BASED ON GIVE 'N' TAKE,"
  print at 2,6, "COMPUTE'S GAZETTE DISK,"
  print at 2,7, "AUGUST 1987 (COMMODORE 64,"
  print at 2,8, "BASIC). NO AUTHOR NAMED."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: BACK AND FORTH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

