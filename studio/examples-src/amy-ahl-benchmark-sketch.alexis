' Creative Computing / Ahl benchmark rewritten for current AMY fixed32.
fixed32 A = 0.0, R = 0.0, S = 0.0
fixed32 Accuracy = 0.0, Randomness = 0.0
fixed32 Work = 0.0, RndStep = 0.0
u16 N = 0, I = 0

  text screen
  print at 6,0, "AHL BENCHMARK"

  for N = 1 to 100
    A = N
    for I = 1 to 10
      A = sqrt(A)
      RndStep = random()
      R += RndStep
    next
    for I = 1 to 10
      A ^= 2
      RndStep = random()
      R += RndStep
    next
    S += A
  next

  Work = S
  Work /= 5
  Accuracy = 1010.0
  Accuracy -= Work
  Accuracy = abs(Accuracy)

  Randomness = 1000.0
  Randomness -= R
  Randomness = abs(Randomness)

  print at 1,4,  "ACCURACY"
  print Accuracy at 12,4
  print at 1,7,  "RANDOM"
  print Randomness at 12,7
  print at 1,10, "SUM S"
  print S at 12,10
  print at 1,13, "R TOTAL"
  print R at 12,13
  screen on