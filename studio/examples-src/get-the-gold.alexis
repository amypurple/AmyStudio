' Adaptation: editorial pages at power-on
sub EditorialPages:
  backdrop black
  cls
  print at 9,1, "GET THE GOLD"
  print at 7,3, "BY FRANK ELSESSER"
  print at 4,4, "COMPUTE! DECEMBER 1983"
  print at 2,7, "A TI-99 DUNGEON ADVENTURE:"
  print at 2,8, "TWO LEVELS, 128 CHAMBERS,"
  print at 2,9, "PERFIDIOUS MONSTERS, CUNNING"
  print at 2,10, "THIEVES, TRAP DOORS AND SOME"
  print at 2,11, "PRETTY EERIE SOUND EFFECTS."
  print at 2,13, "THE GAME WAS SO LONG THAT IT"
  print at 2,14, "CAME IN TWO PROGRAMS SAVED"
  print at 2,15, "ONE AFTER THE OTHER ON TAPE:"
  print at 2,16, "THE INSTRUCTIONS, THEN THE"
  print at 2,17, "GAME. HERE THEY ARE ONE."
  WaitPage
  cls
  print at 9,1, "THIS EDITION"
if defined AMY_HAS_EOS
  print at 5,3, "COLECO ADAM VERSION"
else defined
  print at 4,3, "COLECOVISION VERSION"
end defined
  print at 6,4, "AMY BIENVENU, 2026"
  print at 2,7, "NEW: A MAP OF THE CHAMBERS"
  print at 2,8, "YOU HAVE SEEN, BESIDE YOUR"
  print at 2,9, "GOLD AND YOUR MOVES."
  print at 2,11, "KEPT FROM 1983: ONE MONSTER"
  print at 2,12, "LISTENS TO YOUR NAME, NOT TO"
  print at 2,13, "YOUR ANSWER, SO ONLY ONE"
  print at 2,14, "REPLY PLEASES HIM; AND THE"
  print at 2,15, "SUPER KEY OPENS EVERY"
  print at 2,16, "STAIRWAY, WITH OR WITHOUT"
  print at 2,17, "THE KEY. THE CODE SAID SO."
  WaitPage
  return
end sub

sub LoadTiles:
  copy MapTiles count 16 to vram.pattern + 1024
  copy RoomPatterns count 64 to vram.pattern + 1088
  copy DangerPatterns count 24 to vram.pattern + 1152
  copy StairsPattern count 8 to vram.pattern + 1216
  copy PlayerPattern count 8 to vram.pattern + 1280
  ' Map colors: frame light blue, rooms gray, danger light red,
  ' stairs dark yellow, the player white
  set text colors light blue at 16 count 1
  set text colors gray at 17 count 1
  set text colors light red at 18 count 1
  set text colors dark yellow at 19 count 1
  set text colors white at 20 count 1
  return
end sub

' Map tiles: 128 frame, 129 separator line
data MapTiles bytes $FF,$81,$BD,$A5,$A5,$BD,$81,$FF,$00,$00,$00,$FF,$FF,$00,$00,$00
' 136 unknown, 137 empty, 138 smokey, 139 N-S tunnel, 140 E-W tunnel
data RoomPatterns bytes
  $00,$00,$00,$18,$18,$00,$00,$00
  $00,$7E,$42,$42,$42,$42,$7E,$00
  $00,$7E,$4A,$52,$4A,$52,$7E,$00
  $24,$24,$24,$24,$24,$24,$24,$24
  $00,$00,$FF,$00,$00,$FF,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
' 144 monster, 145 thief, 146 trap door
data DangerPatterns bytes
  $3C,$7E,$5A,$7E,$7E,$3C,$24,$00
  $00,$3C,$7E,$DB,$7E,$3C,$18,$00
  $00,$7E,$66,$5A,$5A,$66,$7E,$00
end data
' 152 stairway, 160 the player
data StairsPattern bytes $03,$03,$0F,$0F,$3F,$3F,$FF,$FF
data PlayerPattern bytes $18,$3C,$18,$7E,$18,$24,$42,$00

' Room type -> map tile (index 0 unused)
data RoomTiles bytes 136,137,138,144,144,145,139,140,146,152
' Line 3110: M4 -> 1 DRA, 2 BUS, 3 LUM, 4 BEWARE
data MonsterOf bytes 0,1,2,3,4,1,3,2,2,1,4
' Line 3370: ZZZ -> 1 dead man ... 10 wizard
data FindOf bytes 0,1,6,2,3,4,5,6,6,7,1,8,9,10,6

if not defined AMY_HAS_EOS
data NameLens bytes 0,6,7,6,9
data NameChars bytes 65,82,84,72,85,82,32,32,32,32,77,79,82,71,65,78,65,32,32,32,77,69,82,76,73,78,32,32,32,32,71,85,73,78,69,86,69,82,69,32
end defined

