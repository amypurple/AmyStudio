end defined
  WaitPage
  ' Lines 680-750
  InstructPage
  print at 2,1, "GAME RATING"
  print at 2,2, "---- ------"
  print at 2,4, "AFTER YOU COMPLETE THE GAME,"
  print at 2,5, "A GAME RATING IS DISPLAYED,"
