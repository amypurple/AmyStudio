  WaitPage
  ' Lines 460-530
  InstructPage
  print at 2,1, "THE QUESTION"
  print at 2,2, "--- --------"
  print at 2,4, "THE MONSTERS WILL ASK YOU"
  print at 2,6, "ONE SPECIAL QUESTION AS YOU"
  print at 2,8, "TRAVEL THROUGH THE DUNGEON:"
  print at 2,11, "WHERE IS THE GOLD?"
  print at 2,14, "HINT: WHERE WOULD YOU PUT"
  print at 2,16, "1,000 GOLD PIECES IF YOU"
