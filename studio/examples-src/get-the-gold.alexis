  print at 2,16, "1- (N)ORTH     2- (E)AST"
  print at 2,17, "3- (S)OUTH     4- (W)EST"
  print at 2,18, "5- (Q)UIT [ENDS GAME]"
  print at 2,19, "6- (G)OLD [GIVES GOLD COUNT]"
  print at 2,20, "7- (U)P [USED AT STAIRWAYS]"
else defined
  print at 2,12, "PUSH THE JOYSTICK TO MOVE"
  print at 2,13, "NORTH, EAST, SOUTH OR WEST."
  print at 2,15, "FIRE: GO UP A STAIRWAY"
  print at 2,16, "KEYPAD 1: GOLD COUNT"
  print at 2,17, "KEYPAD *: QUIT (ENDS GAME)"
