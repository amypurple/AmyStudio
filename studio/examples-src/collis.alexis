cartridge "COLLISION COURSE/GAZETTE/1987"

' COLLISION COURSE
' A ColecoVision game based on "Collision Course", COMPUTE!'s Gazette
' February 1987 (Commodore 64: BASIC with a machine-language core poked
' from DATA; the listing and its title screen name no author).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: your car (yellow) drives clockwise round four nested lanes;
' the computer's car (red) drives the other way and tries to hit you head
' on. Drive over every dot to clear the level. In the middle of each side
' the lane walls open: a car passing a crossover moves to the lane chosen
' on its lane meter. Push the stick left to choose a lane further in,
' right to choose one further out (the LANE meter in the middle: inner
' lane on the left). The computer's car takes YOUR chosen lane whenever it
' passes a crossover. Hold a button to brake the computer's car to half
' speed (the BRK bar on top empties while you hold it and refills slowly).
' A collision costs a car; the dots you ate stay eaten. Three cars, a
' bonus car on reaching levels 3 and 6, faster every level.
'
' From the original (orig/collision-course.bas and its machine code,
' disassembled in orig/ml.dis): four nested rectangular lanes with
' crossovers in the middle of all four sides, dots on every other cell;
' your car clockwise, the computer's counter-clockwise, both starting on
' the outer lane at the bottom crossover, going apart; the lane selector
' (stick left/right, $0340) used by BOTH cars when they pass a crossover
' (the computer's "chase"); the button halves the computer car's speed
' (it moves every other pass, $0342); one point a dot; from level 4 a dot
' must be driven over twice (it turns into a small dot first, $033E >= 4);
' level bonus (level - 1) x 100; bonus car when reaching levels 3 and 6
' (as the listing meant: its CA/CAR variables are mixed up); three cars;
' after a crash both cars start again, eaten dots stay; faster each level
' (the delay POKE 171 + 2 a level); a high score.
'
' Liberties: the C64 jumps a car to the chosen lane in one step; here it
' slides across the crossover. The brake is limited by a meter (on the C64
' holding the button for ever halved the computer for ever). The lane
' selector stops at the inner and outer lanes instead of wrapping round.
' Speeds 1 to 2 pixels a frame (about the C64's at level 1, but it rises
' more gently: the C64 ends far too fast for a human). Collisions are
' boxes, not sprite pixels. No engine hum; effects for dots, lane change,
' crash, level, bonus car. Own track drawing on a 28-column screen.
'
' Controls: either controller; stick left/right chooses the lane (hold to
' repeat), either button brakes the computer's car. Any button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.

const TRoad = 128
const TDot = 129
const TDot2 = 130
const TWh = 131
const TWv = 132
const TWtl = 133
const TWtr = 134
const TWbl = 135
const TWbr = 136
const TWhe = 137
const TWhw = 138
const TWvs = 139
const TWvn = 140
const TCross = 141
const TLmoff = 142
const TLmon = 143
const TBfull = 144
const TBempty = 145
const TLife = 146
const SDet0 = 0
const SDet1 = 4
const SDet2 = 8
const SDet3 = 12
const SBody0 = 16
const SBody1 = 20
const SBody2 = 24
const SBody3 = 28
const SCrash = 32
const NTiles8 = 152
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndDot = 3
const SndLane = 4
const SndCrash = 5
const SndLevel = 6
const SndBonus = 7
const SndStart = 8
const SndOver = 9
const NSpr = 4
const GapX = 128
const GapY = 100
const BrakeMax = 120
const CrashN = 70
const ReadyN = 50
const MsgN = 120
const RepN = 12

record Car:
  u8 X
  u8 Y
  u8 Dir
  u8 Ln
  u8 Tgt
  u8 Fr
  u8 Sh
  u8 Sd
  i8 Dl
end record

Car Cars[2]

u16 TzLeft = 0
u8 TzOn = 0
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u16 Left = 0
u16 NumU = 0
u8 Lv = 1
u8 Lives = 3
u8 Spd = 16
u8 PTgt = 0
u8 Brake = BrakeMax
u8 BrkOn = 0
u8 BrkT = 0
u8 CrashT = 0
u8 MsgT = 0
u8 Over = 0
u8 Demo = 0
u8 RepT = 0
u8 OldLR = 0
u8 TitleT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' the car being moved (copied from Cars[Ci])
u8 Ci = 0
u8 Cx = 0
u8 Cy = 0
u8 Cd = 0
u8 Cl = 0
u8 Ct = 0
u8 Csh = 0
u8 Csd = 0
i8 Cdl = 0
u8 Steps = 0
u8 Sk = 0
' loop counters
u8 Rj = 0
u8 Lk = 0
u8 Cc = 0
u8 Rr = 0
' scratch
u8 C0 = 0
u8 C1 = 0
u8 R0 = 0
u8 R1 = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 P = 0
u8 Q = 0

  tile screen
  set sound table CcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Sc > Hi then Hi = Sc
  ShowHud
  HideSprites
  mute all
  play sound SndOver
  print at 11,11, "          "
  print at 11,12, "GAME  OVER"
  print at 11,13, "          "
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' lane geometry: car centres on lane L (0 outer .. 3 inner)

function LaneLo(u8 L) as u8
  u8 W = L << 4
  return W + 28

function LaneHiX(u8 L) as u8
  u8 W = L << 4
  return 228 - W

function LaneHiY(u8 L) as u8
  u8 W = L << 4
  return 172 - W

' 1 when the two cars' boxes touch
function Touching as u8
  u8 Dx = absdiff(Cars[0].X, Cars[1].X)
  u8 Dy = absdiff(Cars[0].Y, Cars[1].Y)
  u8 R = 0
  if Dx < 12 then
    if Dy < 12 then R = 1
  end if
  return R

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if CrashT > 0 then
    dec CrashT
    if CrashT = 0 then
      dec Lives
      if Lives = 0 then
        Over = 1
      else
        ResetCars
        ShowLives
        MsgT = ReadyN
      end if
    end if
    return
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowLives
    return
  end if
  LaneInput
  BrakeInput
  ' your car, then the computer's (half speed while braked)
  Ci = 0
  MoveCar
  Ci = 1
  MoveCar
  if Touching() = 1 then
    CrashT = CrashN
    play sound SndCrash
    return
  end if
  if Left = 0 then LevelDone
  return
end sub

' stick left: a lane further in; right: further out; held: repeat
sub LaneInput:
  V = J1 | J2
  V = V & 12
  K = 0
  if V = 0 then
    RepT = 0
  elseif V <> OldLR then
    K = 1
    RepT = RepN
  else
    dec RepT
    if RepT = 0 then
      K = 1
      RepT = RepN
    end if
  end if
  OldLR = V
  if K = 1 then
    T = PTgt
    select case V
    case 4
      if PTgt < 3 then inc PTgt
    case 8
      if PTgt > 0 then dec PTgt
    end select
    if T <> PTgt then
      play sound SndLane
      ShowMeter
    end if
  end if
  return
end sub

sub BrakeInput:
  BrkOn = 0
  if Btn > 0 then
    if Brake > 0 then
      BrkOn = 1
      dec Brake
      BrkT = 0
    end if
  else
    inc BrkT
    if BrkT >= 4 then
      BrkT = 0
      if Brake < BrakeMax then inc Brake
    end if
  end if
  ShowBrake
  return
end sub

' car Ci: add its speed in 1/16 pixels, then one pixel per whole step
sub MoveCar:
  Cx = Cars[Ci].X
  Cy = Cars[Ci].Y
  Cd = Cars[Ci].Dir
  Cl = Cars[Ci].Ln
  Ct = Cars[Ci].Tgt
  Csh = Cars[Ci].Sh
  Csd = Cars[Ci].Sd
  Cdl = Cars[Ci].Dl
  V = Spd
  if Ci = 1 then
    if BrkOn = 1 then V = Spd >> 1
  end if
  V = V + Cars[Ci].Fr
  Steps = V >> 4
  Cars[Ci].Fr = V & 15
  for Sk = 1 to Steps
    StepCar
  next
  Cars[Ci].X = Cx
  Cars[Ci].Y = Cy
  Cars[Ci].Dir = Cd
  Cars[Ci].Ln = Cl
  Cars[Ci].Tgt = Ct
  Cars[Ci].Sh = Csh
  Cars[Ci].Sd = Csd
  Cars[Ci].Dl = Cdl
  return
end sub

sub MoveDir(u8 D):
  select case D
  case 0
    dec Cy
  case 1
    inc Cx
  case 2
    inc Cy
  case else
    dec Cx
  end select
end sub

' one pixel: across a crossover, or along the lane (turning at corners)
sub StepCar:
  if Ci = 0 then Ct = PTgt
  if Csh > 0 then
    MoveDir(Csd)
    dec Csh
    if Csh = 0 then
      Cl = Cl + Cdl
      if Ct <> Cl then StartShift
    end if
    return
  end if
  MoveDir(Cd)
  P = LaneLo(Cl)
  select case Cd
  case 0
    if Cy = P then Turn
  case 1
    if Cx = LaneHiX(Cl) then Turn
  case 2
    if Cy = LaneHiY(Cl) then Turn
  case 3
    if Cx = P then Turn
  end select
  Q = 0
  V = Cd & 1
  if V = 1 then
    if Cx = GapX then Q = 1
  else
    if Cy = GapY then Q = 1
  end if
  if Q = 1 then
    ' the computer takes the lane you have chosen
    if Ci = 1 then Ct = PTgt
    if Ct <> Cl then StartShift
  end if
  if Ci = 0 then
    if Demo = 0 then
      V = Cx & 7
      K = Cy & 7
      if V = 4 then
        if K = 4 then Eat
      end if
    end if
  end if
  return
end sub

' your car turns clockwise, the computer's counter-clockwise
sub Turn:
  if Ci = 0 then
    Cd = Cd + 1
  else
    Cd = Cd + 3
  end if
  Cd = Cd & 3
  return
end sub

' start sliding one lane towards Ct (inward: towards the middle)
sub StartShift:
  Csh = 16
  V = Cd & 1
  if V = 1 then
    if Cy < GapY then
      Csd = 2
    else
      Csd = 0
    end if
  else
    if Cx < GapX then
      Csd = 1
    else
      Csd = 3
    end if
  end if
  Cdl = 1
  if Ct < Cl then
    Cdl = -1
    Csd = Csd + 2
    Csd = Csd & 3
  end if
  return
end sub

sub Eat:
  X = Cx >> 3
  Y = Cy >> 3
  T = get char at X,Y
  select case T
  case TDot
    if Lv >= 4 then
      put char TDot2 at X,Y
    else
      put char TRoad at X,Y
    end if
  case TDot2
    put char TRoad at X,Y
  case else
    T = 0
  end select
  if T > 0 then
    Sc += 1
    dec Left
    ShowScore
    play sound SndDot
  end if
  return
end sub

' every dot eaten: bonus (level - 1) x 100 for the new level, a bonus car
' at levels 3 and 6, the dots back, faster
sub LevelDone:
  inc Lv
  for Rj = 2 to Lv
    Sc += 100
  next
  SetSpeed
  DrawLanes
  ResetCars
  ShowHud
  print at 11,12, "BONUS     "
  NumU = Lv - 1
  NumU = NumU * 100
  print at 17,12, digits$(NumU, 4)
  MsgT = MsgN
  play sound SndLevel
  if Lv = 3 then BonusCar
  if Lv = 6 then BonusCar
  return
end sub

sub BonusCar:
  inc Lives
  print at 11,13, "BONUS  CAR"
  play sound SndBonus
  return
end sub

sub SetSpeed:
  V = Lv << 1
  V = V + 14
  if V > 32 then V = 32
  Spd = V
  return
end sub

' both cars at the bottom crossover of the outer lane, going apart
sub ResetCars:
  Cars[0].X = 120
  Cars[0].Y = 172
  Cars[0].Dir = 3
  Cars[1].X = 136
  Cars[1].Y = 172
  Cars[1].Dir = 1
  for Rj = 0 to 1
    Cars[Rj].Ln = 0
    Cars[Rj].Tgt = 0
    Cars[Rj].Fr = 0
    Cars[Rj].Sh = 0
    Cars[Rj].Sd = 0
    Cars[Rj].Dl = 0
  next
  PTgt = 0
  Brake = BrakeMax
  BrkOn = 0
  BrkT = 0
  ShowMeter
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites 0-1 your car (detail, body), 2-3 the computer's
sub DrawSprites:
  for Rj = 0 to 1
    X = Cars[Rj].X - 8
    Y = Cars[Rj].Y - 9
    K = Cars[Rj].Dir << 2
    J = Rj << 1
    T = J + 1
    if Rj = 0 then
      V = 11
    else
      V = 8
    end if
    if CrashT > 0 then
      if Rj = 0 then
        ' the crash: white and red, changing every 10 frames (3 Hz)
        P = CrashT / 10
        P = P & 1
        Q = 15
        if P = 1 then Q = 9
        set sprite J to Y,X,SCrash,Q
        set sprite T to 192,0,0,0
      else
        set sprite J to 192,0,0,0
        set sprite T to 192,0,0,0
      end if
    else
      P = K + SBody0
      set sprite J to Y,X,K,1
      set sprite T to Y,X,P,V
    end if
  next
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SC"
  print at 12,1, "HI"
  print at 22,1, "BRK"
  ShowScore
  print at 15,1, Hi
  print at 12,11, "LEVEL "
  NumU = Lv
  print at 18,11, digits$(NumU, 2)
  ShowLives
  print at 12,13, "LANE"
  ShowMeter
  ShowBrake
  return
end sub

sub ShowScore:
  print at 5,1, Sc
  return
end sub

sub ShowLives:
  fill 32 count 10 at 11,12
  fill 32 count 10 at 11,13
  print at 12,13, "LANE"
  ShowMeter
  V = Lives - 1
  if V > 8 then V = 8
  if V > 0 then fill TLife count V at 12,12
  return
end sub

' four boxes, the inner lane on the left
sub ShowMeter:
  for Rj = 0 to 3
    V = 3 - Rj
    T = TLmoff
    if V = PTgt then T = TLmon
    K = Rj + 16
    put char T at K,13
  next
  return
end sub

sub ShowBrake:
  V = Brake
  for Rr = 0 to 4
    T = TBempty
    if V >= 24 then T = TBfull
    if V >= 24 then
      V = V - 24
    else
      V = 0
    end if
    K = Rr + 25
    put char T at K,1
  next
  return
end sub

' wall ring Rj (0 outer .. 4 around the middle box)
sub DrawRing:
  K = Rj << 1
  C0 = 2 + K
  C1 = 29 - K
  R0 = 2 + K
  R1 = 22 - K
  V = C0 + 1
  T = C1 - 1
  fill TWh count 26 - K - K at V,R0
  fill TWh count 26 - K - K at V,R1
  for Rr = R0 + 1 to R1 - 1
    put char TWv at C0,Rr
    put char TWv at C1,Rr
  next
  put char TWtl at C0,R0
  put char TWtr at C1,R0
  put char TWbl at C0,R1
  put char TWbr at C1,R1
  if Rj >= 1 then
    if Rj <= 3 then
      ' the crossovers: top and bottom (columns 15-16), sides (rows 11-13)
      put char TWhe at 14,R0
      put char TWhe at 14,R1
      put char TCross at 15,R0
      put char TCross at 16,R0
      put char TCross at 15,R1
      put char TCross at 16,R1
      put char TWhw at 17,R0
      put char TWhw at 17,R1
      put char TWvs at C0,10
      put char TWvs at C1,10
      for Rr = 11 to 13
        put char TCross at C0,Rr
        put char TCross at C1,Rr
      next
      put char TWvn at C0,14
      put char TWvn at C1,14
    end if
  end if
  return
end sub

' the four lanes with their dots (every other cell); counts Left
sub DrawLanes:
  Left = 0
  for Lk = 0 to 3
    K = Lk << 1
    C0 = 3 + K
    C1 = 28 - K
    R0 = 3 + K
    R1 = 21 - K
    for Cc = C0 to C1
      Rr = R0
      LaneCell
      Rr = R1
      LaneCell
    next
    for Rr = R0 + 1 to R1 - 1
      Cc = C0
      LaneCell
      Cc = C1
      LaneCell
    next
  next
  if Lv >= 4 then Left = Left << 1
  return
end sub

sub LaneCell:
  V = Cc + Rr
  V = V & 1
  if V = 0 then
    put char TDot at Cc,Rr
    inc Left
  else
    put char TRoad at Cc,Rr
  end if
  return
end sub

sub DrawField:
  for Rj = 0 to 4
    DrawRing
  next
  DrawLanes
  return
end sub

sub NewGame:
  Sc = 0
  Lv = 1
  Lives = 3
  SetSpeed
  NewScreen
  DrawField
  ResetCars
  ShowHud
  CrashT = 0
  MsgT = ReadyN
  Over = 0
  Demo = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the track, the two cars driving round (the computer's car
' following the demo car's lane choices), the tune once
sub TitlePage:
  Lv = 1
  SetSpeed
  NewScreen
  DrawField
  print at 2,1, "HI"
  print at 5,1, Hi
  print at 14,1, "GAZETTE 1987"
  ResetCars
  print at 11,11, "COLLISION "
  print at 11,12, "  COURSE  "
  print at 11,13, "PRESS FIRE"
  Demo = 1
  CrashT = 0
  TitleT = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 540
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  ' the demo car changes its lane choice every two seconds
  inc TitleT
  if TitleT >= 120 then
    TitleT = 0
    V = Tick & 3
    PTgt = V
  end if
  Ci = 0
  MoveCar
  Ci = 1
  MoveCar
  DrawSprites
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Demo = 0
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 7,2, "COLLISION COURSE"
  print at 2,5, "BASED ON COLLISION COURSE,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "FEBRUARY 1987 (COMMODORE 64)"
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: NIGHT CIRCUIT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$18,$C3,$C3,$18,$00,$00
  $00,$00,$00,$18,$18,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $C3,$C3,$C3,$C3,$C3,$C3,$C3,$C3
  $00,$00,$C0,$C0,$C0,$C0,$C3,$C3
  $00,$00,$03,$03,$03,$03,$C3,$C3
  $C3,$C3,$C0,$C0,$C0,$C0,$00,$00
  $C3,$C3,$03,$03,$03,$03,$00,$00
  $00,$00,$07,$07,$07,$07,$00,$00
  $00,$00,$E0,$E0,$E0,$E0,$00,$00
  $C3,$C3,$C3,$C3,$C3,$00,$00,$00
  $00,$00,$00,$C3,$C3,$C3,$C3,$C3
  $00,$00,$00,$18,$18,$00,$00,$00
  $00,$81,$81,$81,$81,$81,$81,$00
  $00,$81,$81,$81,$81,$81,$81,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$80,$80,$80,$80,$00,$00
  $00,$83,$21,$20,$20,$21,$83,$00
end data
data TileCol bytes
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$B1,$1B,$1B,$B1,$01,$01
  $01,$01,$01,$A1,$A1,$01,$01,$01
  $01,$01,$04,$05,$05,$04,$01,$01
  $15,$15,$15,$15,$15,$15,$15,$15
