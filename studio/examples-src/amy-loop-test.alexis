project "Amy Loop Test"
memory "colecovision_legacy_sdcc"

u8 LoopI = 0
u8 DescI = 0

  text screen
  print at 11,0, "LOOP TEST"
  print at 1,3, "PUT:"
  put char $41 at 11,3
  put char $42 at 12,3
  put char $43 at 13,3
  print at 1,6, "FOR:"
  print at 1,9, "DOWNTO:"
  print at 1,11, "DOWN STEP:"
  screen on

  for LoopI = 0 to 7
    put char LoopI + $30 at LoopI + 11,6
  next

  for DescI = 7 to 0 step -1
    put char DescI + $30 at 18 - DescI,9
  next

  for DescI = 8 to 0 step -2
    put char DescI + $30 at DescI + 11,11
  next

  print at 1,14, "DONE"