data PicPatTab words = @ShPicP0, @ShPicP1, @ShPicP2, @ShPicP3, @ShPicP4, @ShPicP5, @ShPicP6, @ShPicP7, @ShPicP8, @ShPicP9, @ShPicP10, @ShPicP11, @ShPicP12, @ShPicP13, @ShPicP14, @ShPicP15
data PicColTab words = @ShPicC0, @ShPicC1, @ShPicC2, @ShPicC3, @ShPicC4, @ShPicC5, @ShPicC6, @ShPicC7, @ShPicC8, @ShPicC9, @ShPicC10, @ShPicC11, @ShPicC12, @ShPicC13, @ShPicC14, @ShPicC15

' ShowPic: picture Pic in the top screen third (display off: the ZX0
' decoder reads VRAM back). Called with the NMI off.
sub ShowPic:
  display off
  decompress zx0 PicPatTab[Pic] to vram.pattern
  decompress zx0 PicColTab[Pic] to vram.color
  Shown = Pic
  return
end sub

