' Fixed32 formatter debug: inspect generated ASCII byte codes before PUT_AT.
fixed32 HalfValue = 0.5
u8 Digits[11] = 0

  text screen
  print at 3,0, "FIXED32 FORMAT BYTES"
  print at 1,2, "HALF VALUE"
  format HalfValue into Digits digits 11
  put Digits count 11 at 12,2
  print at 1,4, "ASCII CODES B0..B10"
  print Digits[0] at 1,6 digits 3
  print Digits[1] at 4,6 digits 3
  print Digits[2] at 8,6 digits 3
  print Digits[3] at 12,6 digits 3
  print Digits[4] at 16,6 digits 3
  print Digits[5] at 20,6 digits 3
  print Digits[6] at 24,6 digits 3
  print Digits[7] at 28,6 digits 3
  print Digits[8] at 1,8 digits 3
  print Digits[9] at 4,8 digits 3
  print Digits[10] at 8,8 digits 3
  print at 1,10, "EXPECT ASCII"
  print at 1,11, "032 048 048 048 048 048"
  print at 1,12, "046 053 048 048 048"
  screen on