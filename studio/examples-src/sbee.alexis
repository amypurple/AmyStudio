cartridge "SPELLING BEE/Daniel Bonachea/1983"

' SPELLING BEE
' A ColecoVision game based on "Spelling Bee", COMPUTE!'s Gazette,
' December 1983 (Commodore 64 and VIC-20, BASIC; disk 1983-12). No author
' is named in the listings or on the disk (the disk copy is dated
' 1-25-89 by its typist).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: choose easy, medium or hard words (25 of each, in the
' listing's order). Each word is shown on a card, then hidden; spell it
' back by picking letters with the stick and the button, then pick the
' return arrow. The red X wipes what you have picked so you can start the
' word again with no penalty. A wrong spelling costs a point (you start at
' 75) and shows the word again; after three wrong spellings the correct
' spelling is shown letter by letter and the next word comes. After the
' 25th word: WASN'T THAT FUN? and your score.
'
' From the original (orig/spelling bee.64.bas, lines in brackets): three
' lists of 25 words (230-300) chosen 1/2/3 (990-1090); the word shown
' about 2.2 s (1180), then WORD NUMBER and SCORE (1185); the alphabet, a
' return arrow and a red X picked with a joystick pointer and the fire
' button (1390-1620), already joystick-driven in 1983; red X = the same
' word again, no penalty (1600); return checks the word (1210-1250); 3
' chances (1170), the word re-shown before each (1180); 75 - mistakes
' (1185, 1280, 920-930); after the third miss THAT IS INCORRECT, THE
' CORRECT SPELLING IS: letter by letter (150-210), HERE, TRY ANOTHER
' (1260); CORRECT! NOW TRY ANOTHER (1300); the low buzz and the bright
' ping (1800-1870); WASN'T THAT FUN? (360), YOUR SCORE WAS (1785).
'
' Liberties:
' - The listing reflashes the correct spelling 20 times in reverse video
'   (about 15 Hz); here it is typed out letter by letter, then held
'   steadily on the card (nothing flashes faster than 3 Hz).
' - The picker is a 7 x 4 grid (A-Z, red X, return) moved with the stick
'   in four directions instead of a 28-cell line moved left/right; it is
'   still the original's pick-then-return, so sweeping the letters spells
'   nonsense and costs a try (no partial credit, no hint which letter is
'   wrong; at most 12 letters).
' - No name entry (it needed the keyboard): NOW SPELL IT! without a name.
'   No Y/N instructions question: HOW TO PLAY is on the title menu. No
'   typed END/Q words to skip a list or quit; no Q/SPACE double check at
'   the end (house rule: a press goes back to the title).
' - The listing does not take a point for the third miss of a word (line
'   1260 leaves the loop before 1280); its instructions say every
'   misspelling costs one, and here every one does (score 25-75).
' - The listing ends the list at once if the last word of any list is
'   spelled (lines 1240-1242: spelling SEE on word 1 finished the easy
'   list): not kept. Picking return with nothing picked is ignored (the
'   listing counted it as a mistake).
' - WATERBED (hard list) is now BLANKET: a dated 1983 furnishing. Nothing
'   else in the lists is offensive or dated (STEREO and TELEVISION kept).
' - Big two-tile letters on a word card, honeycomb frame, a bee that
'   hovers by the chosen letter, a title tune, a credits page.
'
' Controls: either controller; the stick moves, either button picks.
' Keypad not used.
'
' House rules: text and sprites in columns 2-29, rows 1-22 (the honeycomb
' frame is decoration); tiles from 128; screens drawn with the NMI off
' after a wait, display off; music first in the sound table, the title
' tune plays once; `set sprite count` always given.

const THoney = 128
const TCard = 129
const TSlot = 130
const TXx = 131
const TRet = 132
const TRule = 133
const TBa00 = 134
const TBa01 = 135
const TBa10 = 136
const TBa11 = 137
const TBb00 = 138
const TBb01 = 139
const TBb10 = 140
const TBb11 = 141
const TBc00 = 142
const TBc01 = 143
const TBc10 = 144
const TBc11 = 145
const TBd00 = 146
const TBd01 = 147
const TBd10 = 148
const TBd11 = 149
const TBe00 = 150
const TBe01 = 151
const TBe10 = 152
const TBe11 = 153
const TBf00 = 154
const TBf01 = 155
const TBf10 = 156
const TBf11 = 157
const TBg00 = 158
const TBg01 = 159
const TBg10 = 160
const TBg11 = 161
const TBh00 = 162
const TBh01 = 163
const TBh10 = 164
const TBh11 = 165
const TBi00 = 166
const TBi01 = 167
const TBi10 = 168
const TBi11 = 169
const TBj00 = 170
const TBj01 = 171
const TBj10 = 172
const TBj11 = 173
const TBk00 = 174
const TBk01 = 175
const TBk10 = 176
const TBk11 = 177
const TBl00 = 178
const TBl01 = 179
const TBl10 = 180
const TBl11 = 181
const TBm00 = 182
const TBm01 = 183
const TBm10 = 184
const TBm11 = 185
const TBn00 = 186
const TBn01 = 187
const TBn10 = 188
const TBn11 = 189
const TBo00 = 190
const TBo01 = 191
const TBo10 = 192
const TBo11 = 193
const TBp00 = 194
const TBp01 = 195
const TBp10 = 196
const TBp11 = 197
const TBq00 = 198
const TBq01 = 199
const TBq10 = 200
const TBq11 = 201
const TBr00 = 202
const TBr01 = 203
const TBr10 = 204
const TBr11 = 205
const TBs00 = 206
const TBs01 = 207
const TBs10 = 208
const TBs11 = 209
const TBt00 = 210
const TBt01 = 211
const TBt10 = 212
const TBt11 = 213
const TBu00 = 214
const TBu01 = 215
const TBu10 = 216
const TBu11 = 217
const TBv00 = 218
const TBv01 = 219
const TBv10 = 220
const TBv11 = 221
const TBw00 = 222
const TBw01 = 223
const TBw10 = 224
const TBw11 = 225
const TBx00 = 226
const TBx01 = 227
const TBx10 = 228
const TBx11 = 229
const TBy00 = 230
const TBy01 = 231
const TBy10 = 232
const TBy11 = 233
const TBz00 = 234
const TBz01 = 235
const TBz10 = 236
const TBz11 = 237
const SBox = 0
const SBody = 4
const SWing1 = 8
const SWing2 = 12
const NTiles8 = 880
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndWrong = 3
const SndRight = 4
const SndMove = 5
const SndPick = 6
const SndClear = 7
const SndShow = 8
const SndLetter = 9
const SndOver = 10
const ShowN = 132
const MsgN = 130
const MaxAns = 12
const NSpr = 4
const CardY = 5
const AnsY = 12
const AnsX = 4
const GridY = 15
const CellX = 4
const KeyX = 26
const KeyRet = 27
const MaxTries = 3
const NWords = 25

record Round:
  u8 Wi
  u8 Miss
  u8 Right
  u8 Tries
end record

Round Pg
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the word (ASCII, 0-padded) and the picked letters
u8 Wd[10]
u8 Wl = 0
u8 Ans[12]
u8 Tn = 0
u8 Lv = 0
u8 Cur = 0
u8 Ph = 0
u8 Done = 0
u8 Menu = 0
u8 Over = 0
u8 TitleOn = 0
u8 BeeOn = 0
u8 BeeX = 120
u8 BeeY = 60
u8 WingT = 0
u8 WordVis = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 Rep = 0
u8 Held = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Li = 0
u8 Hi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then
    HowToPlay
    goto title
  end if
  Lv = Menu
  Pg.Wi = 0
  Pg.Miss = 0
  Pg.Right = 0
  Over = 0
  NewPlayScreen

' 1170-1310: each word, three chances
play_word:
  LoadWord
  Pg.Tries = 1
try_again:
  ShowHud
  ShowTheWord
  SpellIt
  if Match() = 1 then
    ' 1300: CORRECT! NOW TRY ANOTHER
    Pg.Right += 1
    ShowHud
    Message(1)
    play sound SndRight
    Hold(MsgN)
    goto next_word
  end if
  ' 1270-1280: a misspelling costs a point
  Pg.Miss += 1
  ShowHud
  if Pg.Tries >= MaxTries then
    Reveal
    goto next_word
  end if
  inc Pg.Tries
  Message(2)
  play sound SndWrong
  Hold(MsgN)
  goto try_again

next_word:
  inc Pg.Wi
  if Pg.Wi < NWords then goto play_word

  ' 360, 1780-1790: the end
  Over = 1
  Ph = 9
  EndScreen
  play sound SndOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the word: copy word Pg.Wi of the chosen list into Wd

sub LoadWord:
  u8 Base = 0
  Base = Pg.Wi * 10
  Wl = 0
  for Li = 0 to 9
    select case Lv
    case 0
      C = WEasy[Base + Li]
    case 1
      C = WMedium[Base + Li]
    case else
      C = WHard[Base + Li]
    end select
    Wd[Li] = C
    if C > 0 then inc Wl
  next
  return
end sub

' 1180: the word on the card for about 2.2 seconds, then hidden
sub ShowTheWord:
  Ph = 0
  BeeOn = 0
  DrawSprites
  ClearCard
  ClearAnswer
  X = 16 - Wl
  for Li = 0 to 9
    C = Wd[Li]
    if C > 0 then
      BigAt(C, X, CardY)
      X = X + 2
    end if
  next
  Message(3)
  play sound SndShow
  WordVis = 1
  Hold(ShowN)
  ClearCard
  WordVis = 0
  return
end sub

' 1190-1620: pick letters until the return arrow
sub SpellIt:
  Message(4)
  Tn = 0
  Done = 0
  Cur = 0
  Rep = 0
  Held = 1
  Ph = 1
  BeeOn = 1
  ClearAnswer
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
sp_loop:
  Frame1
  ReadPad
  MoveCursor
  if Press = 1 then PickCell
  DrawSprites
  if Done = 0 then goto sp_loop
  Ph = 2
  BeeOn = 0
  DrawSprites
  return
end sub

sub PickCell:
  if Cur < KeyX then
    if Tn >= MaxAns then
      play sound SndClear
      return
    end if
    C = Cur + 65
    Ans[Tn] = C
    X = Tn * 2
    X = X + AnsX
    BigAt(C, X, AnsY)
    inc Tn
    play sound SndPick
    return
  end if
  if Cur = KeyX then
    ' 1600: the red X, the same word again with no penalty
    ClearAnswer
    Tn = 0
    play sound SndClear
    return
  end if
  ' the return arrow: an empty word is ignored
  if Tn = 0 then
    play sound SndClear
    return
  end if
  Done = 1
  return
end sub

' 1240-1250: the picked letters against the word (all 12 places compared)
function Match() as u8
  u8 Ok = 1
  u8 A = 0
  u8 B = 0
  for Li = 0 to MaxAns - 1
    A = Ans[Li]
    B = 0
    if Li < 10 then B = Wd[Li]
    if A <> B then Ok = 0
  next
  return Ok

' the stick moves the picker round its 7 x 4 grid (held: repeats)
sub MoveCursor:
  V = Stick & 15
  if V = 0 then
    Rep = 0
    Held = 0
    return
  end if
  if Rep > 0 then
    dec Rep
    return
  end if
  K = Cur
  select case V
  case 1
    if Cur >= 7 then Cur = Cur - 7
  case 2
    if Cur < 21 then Cur = Cur + 7
  case 4
    J = Cur % 7
    if J > 0 then dec Cur
  case 8
    J = Cur % 7
    if J < 6 then inc Cur
  case else
    return
  end select
  if Cur <> K then play sound SndMove
  Rep = 7
  if Held = 0 then Rep = 14
  Held = 1
  return
end sub

' the third miss (150-210): the correct spelling, letter by letter, held
sub Reveal:
  Message(5)
  play sound SndWrong
  Hold(60)
  X = 16 - Wl
  for Li = 0 to 9
    C = Wd[Li]
    if C > 0 then
      BigAt(C, X, CardY)
      X = X + 2
      play sound SndLetter
      Hold(30)
    end if
  next
  Hold(90)
  Message(6)
  Hold(MsgN)
  ClearCard
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a big letter (ASCII C, 0 for the card's blank) at column X, row Y
sub BigAt(u8 Ch, u8 Bx, u8 By):
  u8 T = 0
  if Ch = 0 then
    fill TCard count 2 at Bx,By
    K = By + 1
    fill TCard count 2 at Bx,K
    return
  end if
  T = BigTile(Ch)
  put char T at Bx,By
  inc T
  K = Bx + 1
  put char T at K,By
  inc T
  K = By + 1
  put char T at Bx,K
  inc T
  J = Bx + 1
  put char T at J,K
  return
end sub

function BigTile(u8 Ch) as u8
  u8 Q = 0
  Q = Ch - 65
  Q = Q << 2
  return Q + TBa00

sub ClearCard:
  for Ri = 3 to 8
    fill TCard count 26 at 3,Ri
  next
  return
end sub

sub ClearAnswer:
  for Li = 0 to 11
    Ans[Li] = 0
  next
  fill TCard count 26 at 3,AnsY
  K = AnsY + 1
  fill TSlot count 26 at 3,K
  fill TCard count 2 at 3,K
  fill TCard count 2 at 28,K
  return
end sub

' the message band (rows 10-11): the listing's lines
sub Message(u8 Mn):
  fill 32 count 28 at 2,10
  fill 32 count 28 at 2,11
  select case Mn
  case 1
    print at 12,10, "CORRECT!"
    print at 8,11, "NOW TRY ANOTHER"
  case 2
    print at 7,10, "THAT IS INCORRECT."
    print at 11,11, "TRY AGAIN."
  case 3
    print at 7,10, "LOOK AT THIS WORD!"
  case 4
    print at 9,10, "NOW SPELL IT!"
  case 5
    print at 7,10, "THAT IS INCORRECT."
    print at 4,11, "THE CORRECT SPELLING IS:"
  case 6
    print at 7,10, "HERE, TRY ANOTHER."
  end select
  return
end sub

' 1185: WORD NUMBER, SCORE, the list and the try
sub ShowHud:
  print at 2,1, "WORD"
  NumU = Pg.Wi + 1
  print at 7,1, width$(NumU, 2)
  print at 10,1, "OF 25"
  print at 19,1, "SCORE"
  K = 75 - Pg.Miss
  NumU = K
  print at 25,1, width$(NumU, 2)
  select case Lv
  case 0
    print at 2,2, "EASY  "
  case 1
    print at 2,2, "MEDIUM"
  case else
    print at 2,2, "HARD  "
  end select
  print at 19,2, "TRY"
  NumU = Pg.Tries
  print at 23,2, digits$(NumU, 1)
  print at 25,2, "OF 3"
  return
end sub

' the picker: A-Z, the red X, the return arrow
sub DrawGrid:
  for Li = 0 to 27
    GridCell(Li)
    if Li < KeyX then
      C = Li + 65
    else
      C = TXx
      if Li = KeyRet then C = TRet
    end if
    put char C at X,Y
  next
  return
end sub

' cell N of the grid at column X, row Y
sub GridCell(u8 N):
  J = N % 7
  K = N / 7
  X = J << 2
  X = X + CellX
  Y = K << 1
  Y = Y + GridY
  return
end sub

sub NewPlayScreen:
  NewScreen
  Honeycomb
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  ClearCard
  fill 32 count 28 at 2,10
  fill 32 count 28 at 2,11
  ClearAnswer
  for Ri = 15 to 21
    fill 32 count 28 at 2,Ri
  next
  DrawGrid
  ShowHud
  DrawSprites
  ShowScreen
  return
end sub

sub Honeycomb:
  for Ri = 0 to 23
    fill THoney count 32 at 0,Ri
  next
  return
end sub

' sprite 0 the picker's frame, 1-2 the bee, 3 spare (hidden)
sub DrawSprites:
  inc WingT
  if WingT >= 24 then WingT = 0
  if BeeOn = 0 then
    if TitleOn = 0 then
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
      set sprite 2 to 192,0,0,0
      set sprite 3 to 192,0,0,0
      update sprites
      return
    end if
  end if
  if TitleOn = 0 then
    GridCell(Cur)
    W16 = X * 8
    X = lowbyte(W16) - 4
    W16 = Y * 8
    Y = lowbyte(W16) - 5
    set sprite 0 to Y,X,SBox,11
    ' the bee rests on the frame's top-left corner
    BeeX = X - 8
    BeeY = Y - 9
  else
    set sprite 0 to 192,0,0,0
  end if
  K = SWing1
  if WingT >= 12 then K = SWing2
  set sprite 1 to BeeY,BeeX,K,15
  set sprite 2 to BeeY,BeeX,SBody,11
  set sprite 3 to 192,0,0,0
  update sprites
  return
end sub

' the end (360, 1780-1790)
sub EndScreen:
  NewScreen
  Honeycomb
  for Ri = 3 to 20
    fill 32 count 26 at 3,Ri
  next
  print at 8,5, "WASN'T THAT FUN?"
  print at 6,8, "YOUR SCORE WAS"
  K = 75 - Pg.Miss
  NumU = K
  print at 21,8, width$(NumU, 2)
  print at 6,10, "WORDS RIGHT"
  NumU = Pg.Right
  print at 18,10, width$(NumU, 2)
  print at 21,10, "OF 25"
  print at 7,14, "SEE YOU NEXT TIME!"
  print at 8,18, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

' N frames of waiting (the listing's FOR loops), sprites kept moving
sub Hold(u8 Nf):
  for Hi = 1 to Nf
    Frame1
    DrawSprites
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Stick = J1 | J2
  Btn = Stick & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SPELLING BEE on the card, the tune once, the three lists
sub TitlePage:
  NewScreen
  Honeycomb
  ClearCard
  X = 8
  for Li = 0 to 7
    C = TitleA[Li]
    BigAt(C, X, 3)
    X = X + 2
  next
  X = 13
  for Li = 0 to 2
    C = TitleB[Li]
    BigAt(C, X, 6)
    X = X + 2
  next
  for Ri = 9 to 21
    fill 32 count 28 at 2,Ri
  next
  print at 7,10, "COMPUTE!'S GAZETTE"
  print at 9,11, "DECEMBER 1983"
  print at 10,14, "EASY WORDS"
  print at 10,15, "MEDIUM WORDS"
  print at 10,16, "HARD WORDS"
  print at 10,17, "HOW TO PLAY"
  print at 4,20, "PICK WITH THE STICK, THEN"
  print at 4,21, "PRESS THE BUTTON TO START"
  ShowMenu
  TitleOn = 1
  BeeOn = 1
  BeeX = 40
  BeeY = 104
  Ph = 5
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 500
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Held = 1
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the bee wanders along the menu side
  V = Tick & 3
  if V = 0 then
    if BeeX < 200 then
      BeeX = BeeX + 1
    else
      BeeX = 40
    end if
  end if
  DrawSprites
  V = Stick & 15
  if V > 0 then
    if Held = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      end if
      if V = 2 then
        if Menu < 3 then inc Menu
      end if
      ShowMenu
      play sound SndMove
    end if
    Held = 1
  else
    Held = 0
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  BeeOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  HideSprites
  return
end sub

data TitleA bytes 83,80,69,76,76,73,78,71
data TitleB bytes 66,69,69

sub ShowMenu:
  for Ri = 14 to 17
    put char 32 at 8,Ri
  next
  J = Menu + 14
  put char 62 at 8,J
  return
end sub

sub HowToPlay:
  NewScreen
  print at 9,1, "SPELLING BEE"
  print at 2,3, "A WORD IS SHOWN ON THE CARD"
  print at 2,4, "FOR A MOMENT. THEN SPELL IT:"
  print at 2,6, "MOVE THE FRAME WITH THE"
  print at 2,7, "STICK AND PRESS THE BUTTON"
  print at 2,8, "ON EACH LETTER IN TURN."
  print at 2,10, "PICK   WHEN YOU ARE DONE."
  put char TRet at 7,10
  print at 2,11, "PICK   TO START THE WORD"
  put char TXx at 7,11
  print at 2,12, "AGAIN WITH NO PENALTY."
  print at 2,14, "YOU HAVE 3 CHANCES A WORD."
  print at 2,15, "THEN I WILL SHOW YOU THE"
  print at 2,16, "CORRECT SPELLING."
  print at 2,18, "YOU START WITH 75 POINTS:"
  print at 2,19, "1 IS TAKEN OFF FOR EACH"
  print at 2,20, "MISSPELLING. EASY, HUH?"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "SPELLING BEE"
  print at 2,5, "BASED ON THE TYPE-IN GAME"
  print at 2,6, "SPELLING BEE, COMPUTE!'S"
  print at 2,7, "GAZETTE, DECEMBER 1983"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,9, "NO AUTHOR NAMED."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: BUSY BEE WALTZ"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  Ph = 7
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

