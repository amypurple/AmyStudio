' input
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press1 = 0
u8 Press2 = 0
' scratch (never kept across a sub call)
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Li = 0
u8 Img = 0

data VBase bytes 0,50,100

  bitmap screen
  set sound table GcmSoundTable areas 6
  sprites 16x16
  nmi off
  display off
  LoadFont
  copy SprPat count SprBytes to vram.spr_pat
  HideSprites

title:
  TitlePage
  if MSel = 3 then
    HowTo
    goto title
  end if
  if MSel = 4 then
    CreditsPage
    goto title
  end if
  if MSel = 0 then PickCase
  if HaveCase = 0 then PickCase
  NewGame
  Briefing

hub:
  HubScreen
  if MSel = 255 then goto hub
  HubSel = MSel
  if MSel < 3 then
    Investigate
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 3 then
    if Leg < 3 then
      MapScreen
    else
      Verify
    end if
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 4 then
    Dossier
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 5 then
    Atlas
    goto hub
  end if
  Outcome = OcEnded

ending:
  EndScreen
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift, stepped every title frame
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new case, never the one just played
sub PickCase:
  Rand
  W16 = Rs % NCases
  K = W16
  if HaveCase = 1 then
    W16 = Rs % 31
    K = W16
    if K >= CaseNo then inc K
  end if
  CaseNo = K
  HaveCase = 1
  return
end sub

sub NewGame:
  W = CaseNo * CaseLen
  for Li = 0 to 22
    CaseBuf[Li] = Cases[W]
    W += 1
  next
  Deadline = CaseBuf[CsDead]
  Leg = 0
  City = CaseBuf[CsRoute]
  Hours = 0
  Clues = 0
  Leads = 0
  Alert = 0
  Outcome = OcNone
  WrongTrips = 0
  HubSel = 0
  AtSel = 0
  DosSel = 0
  Score = 0
  fill array VisMask with 0
  return
end sub

sub AddHours:
  Hours += T
  if Hours > Deadline then Outcome = OcDeadline
  return
end sub

function IdCount() as u8
  u8 Ic = 0
  Ic = Clues & 1
  if Clues >= 2 then inc Ic
  return Ic

' a venue: the first visit costs 2 hours and gives its clues
sub Investigate:
  T = 1 << HubSel
  NewClue = 0
  V = VisMask[Leg] & T
  if V = 0 then
    VisMask[Leg] = VisMask[Leg] | T
    VenueClues
    ' v2 rule: a witness with a hint (lead or ID clue) +2 h, without +1 h
    AskCost = 1
    if IsLead = 1 then AskCost = 2
    if J > 0 then AskCost = 2
    if Hard = 1 then AskCost = 2
    T = AskCost
    AddHours
    if Outcome <> OcNone then return
    NewClue += 2
  end if
  WitnessScreen
  return
end sub

' what venue HubSel of this leg gives: lead (IsLead) and ID clue bits (J)
sub VenueInfo:
  IsLead = 0
  J = 0
  if Leg < 3 then
    K = CsLeadV + Leg
    if CaseBuf[K] = HubSel then IsLead = 1
  end if
  K = Leg << 2
  K += HubSel
  if CaseBuf[CsIdAt] = K then J = 1
  if CaseBuf[CsIdAt + 1] = K then J = J | 2
  if Leg = 3 then
    if HubSel = 0 then J = 3
  end if
  return
end sub

sub VenueClues:
  VenueInfo
  if IsLead = 1 then
    T = 1 << Leg
    V = Leads & T
    if V = 0 then NewClue = 1
    Leads = Leads | T
  end if
  V = Clues | J
  if V <> Clues then NewClue = 1
  Clues = V
  return
end sub

sub Verify:
  T = CaseBuf[CsCulprit] + 1
  if Alert = T then
    Outcome = OcWin
    return
  end if
  if Alert > 0 then
    Outcome = OcWrongAlert
    return
  end if
  T = Deadline - 2
  if Hours > T then
    Outcome = OcNoAlert
    return
  end if
  State = StNoAlert
  ClearBox
  TId = TxNoAlertBox
  DrawText
  play sound SndWrong
  WaitButton
  Dossier
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub HubScreen:
  State = StHub
  T = CityScene[City]
  Img = ImgSceneQC + T
  BeginFrame
  TId = TxCity0 + City * Stride
  Dx = 2
  Dy = 11
  Ovr = 0
  DrawText
  Ovr = 255
  Dx = 0
  Dy = 0
  if Leg = 3 then
    TId = TxHubTitleF
    DrawText
    TId = TxHubBoxF
  else
    TId = TxHubTitle
    DrawText
    TId = TxHubBox + Hard
  end if
  DrawText
  K = City * Stride
  K += TxCity0 + 5
  for Li = 0 to 6
    MIt[Li] = K + Li
    MXx[Li] = 16
    MYy[Li] = Li + 4
  next
  MIt[3] = TxItemTravel
  if Leg = 3 then MIt[3] = TxItemVerify
  MIt[4] = TxItemDossier
  MIt[5] = TxItemAtlas
  MIt[6] = TxItemEnd
  MN = 7
  MSel = HubSel
  MKind = 0
  MPad = 14
  ShowScreen
  RunMenu
  return
end sub

' text page TId of city C (Stride pages each) at Dx,Dy
sub CityPage:
  T = C * Stride
  TId = TId + T
  DrawText
  return
end sub

sub WitnessScreen:
  State = StWit
  K = City * 3
  K += HubSel
  T = VenuePortrait[K]
  Img = ImgWit0 + T
  BeginFrame
  VenueInfo
  ' the role
  C = City
  TId = TxCity0 + 8 + HubSel
  Dx = 13
  Dy = 2
  CityPage
  Dy = 4
  T = 13
  if IsLead = 1 then
    ' the lead names the next city
    K = CsRoute + 1 + Leg
    C = CaseBuf[K]
    TId = TxCity0 + 2
    CityPage
    Dx = 2
    Dy = 13
    TId = TxCity0 + 3
    CityPage
    Dy = 8
    T = 17
  end if
  if J > 0 then
    NumY = Dy
    NumX = T
    V = J & 1
    if V > 0 then
      K = CaseBuf[CsTrait]
      ShowTrait
    end if
    V = J & 2
    if V > 0 then
      K = CaseBuf[CsTrait + 1]
      ShowTrait
    end if
  end if
  if IsLead = 0 then
    if J = 0 then
      Dx = 13
      Dy = 4
      if Leg = 3 then
        if HubSel = 2 then
          TId = TxItemQuote
          DrawText
          T = CaseBuf[CsInc] * 3
          TId = TxInc0Item + T
          Dy = 8
          DrawText
          Dx = 0
          Dy = 0
          TId = TxItemBox
          DrawText
          goto ws_cost
        end if
      end if
      C = City
      TId = TxCity0 + 11 + HubSel
      CityPage
      Dx = 0
      Dy = 0
      TId = TxNoLeadBox
      DrawText
    end if
  end if
ws_cost:
  Dx = 13
  Dy = 11
  TId = TxCostOld
  if NewClue >= 2 then
    TId = TxCostNew
    if AskCost = 1 then TId = TxCostNew1
  end if
  DrawText
  Dx = 0
  Dy = 0
  ShowScreen
  if NewClue = 3 then
    play sound SndEvidence
  else
    play sound SndClick
  end if
  WaitButton
  return
end sub

' trait K: the quote in the panel at row NumY, "ID: ..." in the box at
' row NumX; then the next ones go 4 / 2 rows lower
sub ShowTrait:
  T = K << 1
  TId = TxTrait0Q + T
  Dx = 13
  Dy = NumY
  DrawText
  inc TId
  Dx = 6
  Dy = NumX
  DrawText
  TId = TxIdLabel
  Dx = 2
  DrawText
  NumY += 4
  NumX += 2
  return
end sub

sub MapScreen:
  State = StMap
  Img = ImgMap
  BeginFrame
  TId = TxMapTitle
  DrawText
  T = 1 << Leg
  T = Leads & T
  if T > 0 then
    K = CsRoute + 1 + Leg
    C = CaseBuf[K]
    TId = TxCity0 + 3
    Dx = 2
    Dy = 13
    CityPage
    Dx = 0
    Dy = 0
  else
    TId = TxMapNoLead
    DrawText
  end if
  TId = TxMapCost + Hard
  DrawText
  ' the three choices: name (menu item) and province below
  for Li = 0 to 2
    K = Leg * 3
    K += CsChoice + Li
    C = CaseBuf[K]
    T = C * Stride
    MIt[Li] = TxCity0 + T
    MXx[Li] = 16
    T = Li * 3
    MYy[Li] = T + 4
    TId = MIt[Li] + 1
    Dx = 17
    Dy = T + 5
    DrawText
  next
  Dx = 0
  Dy = 0
  MN = 3
  MSel = 0
  MKind = 1
  MPad = 14
  MLead = 0
  MapMarks
  ShowScreen
  RunMenu
  MLead = 1
  if MSel = 255 then
    HideSprites
    return
  end if
  K = Leg * 3
  K += CsChoice + MSel
  Dest = CaseBuf[K]
  TravelScreen
  K = CsRoute + 1 + Leg
  if CaseBuf[K] = Dest then
    T = 3
    AddHours
    if Outcome <> OcNone then return
    inc Leg
    City = Dest
    HubSel = 0
    return
  end if
  inc WrongTrips
  ' a wrong destination, round trip included: NORMAL +4 h, HARD +5 h
  T = 4 + Hard
  AddHours
  WrongScreen
  return
end sub

sub MapMarks:
  T = CitySY[City]
  V = CitySX[City]
  set sprite 0 to T,V,SMark,8
  for Li = 0 to 2
    K = Leg * 3
    K += CsChoice + Li
    J = CaseBuf[K]
    T = CitySY[J]
    V = CitySX[J]
    C = 1
    if Li = MSel then C = 15
    K = SNum1 + Li * 4
    J = Li + 1
    set sprite J to T,V,K,C
  next
  update sprites
  return
end sub

sub TravelScreen:
  State = StTravel
  Img = ImgTravel
  BeginFrame
  TId = TxTravelPanel
  DrawText
  Ovr = 0
  Dx = 5
  Dy = 5
  C = City
  TId = TxCity0
  CityPage
  Dy = 9
  C = Dest
  TId = TxCity0
  CityPage
  Dx = 0
  Dy = 0
  Ovr = 255
  TId = TxTravelBox
  DrawText
  ShowScreen
  play sound SndTravel
  play sound SndTravelTone
  V = 32
tr_loop:
  set sprite 0 to 74,V,SPlane,15
  update sprites
  Frame1
  V += 2
  if V < 210 then goto tr_loop
  HideSprites
  return
end sub

sub WrongScreen:
  State = StWrongTrip
  Img = ImgRed
  BeginFrame
  TId = TxWrongPanel
  DrawText
  Ovr = 0
  Dx = 5
  Dy = 7
  C = Dest
  TId = TxCity0
  CityPage
  Ovr = 255
  Dx = 0
  Dy = 0
  TId = TxRound4 + Hard
  DrawText
  TId = TxWrongBox
  DrawText
  ShowScreen
  play sound SndWrong
  WaitButton
  return
end sub

sub Dossier:
  MSel = DosSel
ds_draw:
  State = StDos
  Img = ImgPanel
  BeginFrame
  TId = TxDosPanel
  DrawText
  Dx = 3
  Ovr = 1
  for Li = 0 to 1
    Dy = Li + 3
    TId = TxTraitNo
    T = 1 << Li
    V = Clues & T
    if V > 0 then
      K = CsTrait + Li
      T = CaseBuf[K] << 1
      TId = TxTrait0Q + 1 + T
    end if
    DrawText
  next
  Ovr = 255
  ' persons and whether they match the clues found
  Dx = 22
  for Li = 0 to 5
    MIt[Li] = TxPerson0 + Li
    MXx[Li] = 3
    MYy[Li] = Li + 6
    Dy = Li + 6
    TId = TxStUnk
    if Clues > 0 then
      PersonMatch
      TId = TxStX
      if V = 1 then TId = TxStMatch
    end if
    DrawText
  next
  Dx = 0
  Dy = 0
  DosBox
  MN = 6
  MKind = 2
  MPad = 15
  ShowScreen
ds_menu:
  RunMenu
  if MSel = 255 then return
  DosSel = MSel
  T = IdCount()
  if T < 2 then
    ClearBox
    TId = TxNeedClues
    DrawText
    play sound SndWrong
    MSel = DosSel
    goto ds_menu
  end if
  AlertScreen
  if Outcome <> OcNone then return
  MSel = DosSel
  goto ds_draw
end sub

' does person Li have every trait found? V = 1 yes
sub PersonMatch:
  V = 1
  for J = 0 to 1
    T = 1 << J
    T = Clues & T
    if T > 0 then
      K = CsTrait + J
      C = CaseBuf[K]
      K = Li * 3
      T = 0
      if PersonTraits[K] = C then T = 1
      inc K
      if PersonTraits[K] = C then T = 1
      inc K
      if PersonTraits[K] = C then T = 1
      if T = 0 then V = 0
    end if
  next
  return
end sub

' the box describes the person under the cursor: three traits
sub DosBox:
  ClearBox
  K = MSel * 3
  Dx = 2
  Ovr = 0
  for J = 13 to 17 step 2
    Dy = J
    T = PersonTraits[K] << 1
    TId = TxTrait0Q + 1 + T
    DrawText
    inc K
  next
  Ovr = 255
  Dx = 0
  Dy = 0
  return
end sub

sub AlertScreen:
  State = StAlertScr
  Img = ImgAlert
  BeginFrame
  TId = TxAlertPanel
  DrawText
  TId = TxPerson0 + DosSel
  Dx = 7
  Dy = 5
  DrawText
  Dx = 0
  Dy = 0
  TId = TxAlertBox
  DrawText
  MIt[0] = TxItemYes
  MIt[1] = TxItemNo
  MXx[0] = 6
  MXx[1] = 14
  MYy[0] = 9
  MYy[1] = 9
  MN = 2
  MSel = 0
  MKind = 0
  MPad = 5
  ShowScreen
  RunMenu
  if MSel = 0 then
    Alert = DosSel + 1
    play sound SndAlert
    T = 2
    AddHours
  end if
  return
end sub

' the atlas: 11 places in two columns, each a page; free
sub Atlas:
at_draw:
  State = StAtlas
  Img = ImgPaper
  BeginFrame
  TId = TxAtlasTitle
  DrawText
  TId = TxAtlasBox
  DrawText
  for Li = 0 to 10
    T = Li * Stride
    MIt[Li] = TxCity0 + T
    if Li < 6 then
      MXx[Li] = 2
      MYy[Li] = Li + 4
    else
      MXx[Li] = 16
      MYy[Li] = Li - 2
    end if
  next
  MN = NCity
  MSel = AtSel
  MKind = 0
  MHi = 1
  MNorm = 2
  MPad = 14
  MLead = 0
  ShowScreen
  RunMenu
  MLead = 1
  MHi = 2
  MNorm = 255
  if MSel = 255 then return
  AtSel = MSel
  State = StAtlasPage
  Img = ImgPaper
  BeginFrame
  C = AtSel
  TId = TxCity0 + 4
  CityPage
  TId = TxAtlasBox
  DrawText
  ShowScreen
  play sound SndClick
  WaitButton
  goto at_draw
end sub

sub EndScreen:
  HideSprites
  if Outcome = OcWin then
    Img = ImgGreen
  else
    Img = ImgRed
  end if
  BeginFrame
  if Outcome = OcWin then
    TId = TxWinPanel
    DrawText
    T = CaseBuf[CsInc] * 3
    TId = TxInc0Item + T
    Dx = 4
    Dy = 6
    DrawText
    Dx = 0
    Dy = 0
    NumV = Deadline - Hours
    NumX = 16
    NumY = 8
    Tb = 50
    PutNum2
    Score = NumV * 25
    Score += 1000
    Num16 = Score
    NumX = 17
    NumY = 10
    PutNum4
    TId = TxWinBox
  end if
  if Outcome = OcDeadline then
    TId = TxLossDeadline
    DrawText
    NumV = Hours
    NumX = 11
    NumY = 8
    Tb = 0
    PutNum2
    Tc = 44
    put char Tc at 13,8
    NumV = Deadline
    NumX = 14
    PutNum2
    TId = TxLossDeadlineBox
  end if
  if Outcome = OcWrongAlert then
    TId = TxLossWrong
    DrawText
    T = Alert - 1
    TId = TxPerson0 + T
    Dx = 4
    Dy = 9
    Ovr = 0
    DrawText
    Ovr = 255
    Dx = 0
    Dy = 0
    TId = TxLossWrongBox
  end if
  if Outcome = OcNoAlert then
    TId = TxLossNoAlert
    DrawText
    TId = TxLossNoAlertBox
  end if
  if Outcome = OcEnded then
    TId = TxLossEnded
    DrawText
    TId = TxLossEndedBox
  end if
  DrawText
  ShowScreen
  if Outcome = OcWin then
    play sound SndWinLead
    play sound SndWinPad
    play sound SndWinBassPitch
    play sound SndWinBassVol
  else
    play sound SndLoseLead
    play sound SndLosePad
    play sound SndLoseBassPitch
    play sound SndLoseBassVol
  end if
  return
end sub

sub Briefing:
  State = StBrief
  Img = ImgBrief
  BeginFrame
  TId = TxBriefTop
  DrawText
  T = CaseBuf[CsInc] * 3
  TId = TxInc0Title + T
  Dx = 16
  Dy = 4
  DrawText
  inc TId
  inc TId
  Dx = 2
  Dy = 13
  DrawText
  C = City
  TId = TxCity0
  Dx = 15
  Dy = 17
  Ovr = 0
  CityPage
  Ovr = 255
  Dx = 0
  Dy = 0
  TId = TxBriefLast
  DrawText
  TId = TxLvlBriefN + Hard
  DrawText
  NumV = Deadline
  NumX = 16
  NumY = 8
  Tb = 50
  PutNum2
  ShowScreen
  play sound SndAlert
  WaitButton
  return
end sub

' ---------------------------------------------------------------------------
' title, HOW TO PLAY, credits

sub TitlePage:
  State = StTitle
  Img = ImgTitle
  NewScreen
  ShowImage
  TId = TxTitleFoot
  DrawText
  for Li = 0 to 4
    MIt[Li] = TxTitleNew + Li
    MXx[Li] = 9
    MYy[Li] = Li + 16
  next
  MIt[2] = TxTitleDiffN + Hard
  MIt[3] = TxTitleHow
  MIt[4] = TxTitleCredits
  MN = 5
  MSel = 0
  MKind = 3
  MBack = 0
  MPad = 15
  ShowScreen
  mute all
  play sound SndMusLead
  play sound SndMusPad
  play sound SndMusBassPitch
  play sound SndMusBassVol
  RunMenu
  MBack = 1
  stop sound SndMusLead
  stop sound SndMusPad
  stop sound SndMusBassPitch
  stop sound SndMusBassVol
  mute all
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub TitleAnim:
  Rand
  V = Tick & 31
  if V <> 0 then return
  V = Tick & 32
  if V = 0 then
    fill $B4 count 8 to vram.color + TBulbA * 8
    fill $A4 count 8 to vram.color + TBulbB * 8
    T = 119
  else
    fill $A4 count 8 to vram.color + TBulbA * 8
    fill $B4 count 8 to vram.color + TBulbB * 8
    T = 121
  end if
  set sprite 0 to T,24,SLeaf,8
  set sprite 1 to T,216,SLeaf,8
  update sprites
  return
end sub

sub HowTo:
  State = StHow
  Page = 1
  Img = ImgSceneQC
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  TId = TxHow1
  DrawText
  TId = TxHow1Box
  DrawText
  PageWait
  if TimedOut = 1 then return
  Page = 2
  Img = ImgMap
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  TId = TxHow2
  DrawText
  TId = TxHow2Box
  DrawText
  PageWait
  if TimedOut = 1 then return
  Page = 3
  Img = ImgPanel
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  TId = TxHow3
  DrawText
  TId = TxHow3Box
  DrawText
  PageWait
  return
end sub

sub CreditsPage:
  State = StCredits
  Img = ImgPanel
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  TId = TxCredits
  DrawText
  TId = TxCreditsBox
  DrawText
  PageWait
  return
end sub

' ---------------------------------------------------------------------------
' the menu engine: MN items; item k is page MIt[k] drawn at MXx[k],MYy[k]
' padded to MPad cells; the cursor's item in variant MHi, the others in
' MNorm (255 = the page's own). Stick up/down moves, button 1 returns MSel,
' button 2 returns 255 (when MBack = 1). MKind: 0 plain, 1 map (markers),
' 2 dossier (the box describes the person), 3 title (lights, random seed)

sub RunMenu:
  for Li = 0 to 11
    if Li < MN then DrawItem
  next
  WasBtn = 48
rm_loop:
  Frame1
  ReadPad
  if MKind = 3 then TitleAnim
  K = Edge & 3
  if K > 0 then
    MOld = MSel
    if K = 1 then
      if MSel = 0 then
        MSel = MN - 1
      else
        dec MSel
      end if
    else
      inc MSel
      if MSel >= MN then MSel = 0
    end if
    Li = MOld
    DrawItem
    Li = MSel
    DrawItem
    if MKind = 1 then MapMarks
    if MKind = 2 then DosBox
    play sound SndClick
  end if
  if MKind = 3 then
    if MSel = 2 then
      ' the level: stick left/right or button 1 toggles NORMAL / HARD
      K = Edge & 12
      if K > 0 then Press1 = 1
      if Press1 = 1 then
        Hard = Hard ^ 1
        MIt[2] = TxTitleDiffN + Hard
        Li = 2
        DrawItem
        play sound SndClick
        Press1 = 0
      end if
    end if
  end if
  if Press1 = 1 then return
  if Press2 = 1 then
    if MBack = 1 then
      MSel = 255
      return
    end if
  end if
  goto rm_loop
end sub

sub DrawItem:
  TId = MIt[Li]
  Dx = MXx[Li]
  Dy = MYy[Li]
  Ovr = MNorm
  if Li = MSel then Ovr = MHi
  PadW = MPad
  PadLead = MLead
  DrawText
  PadW = 0
  PadLead = 1
  Ovr = 255
  Dx = 0
  Dy = 0
  return
end sub

' ---------------------------------------------------------------------------
' text: page TId = lines of [x + 32 * variant] [y] words... 255; 255 ends
' the page. A word is a dictionary index (1 byte, or 240+hi, lo). Dx/Dy
' shift the page, Ovr (not 255) replaces the variant, PadW (not 0) pads
' each line to PadW cells with a leading space (menu highlight bars).

sub DrawText:
  ' pages 0-255 in TxtTab, 256 and up in TxtTab2 (word tables take a byte index)
  if TId >= 256 then
    W16 = TId - 256
    Tq = W16
    P = TxtTab2[Tq]
  else
    Tq = TId
    P = TxtTab[Tq]
  end if
dt_line:
  Tx = peek(P)
  if Tx = 255 then return
  Tv = Tx >> 5
  Tx = Tx & 31
  Tx += Dx
  Ty = peek(P + 1)
  Ty += Dy
  P += 2
  if Ovr <> 255 then Tv = Ovr
  Tb = VBase[Tv]
  Tn = 0
  Tf = 1
  if PadLead > 0 then
    if PadW > 0 then put char Tb at Tx,Ty
  end if
  if PadW > 0 then
    if PadLead = 0 then goto dt_word
    inc Tx
    inc Tn
  end if
dt_word:
  Tc = peek(P)
  P += 1
  if Tc = 255 then goto dt_pad
  W = Tc
  if Tc >= 240 then
    W = Tc - 240
    W = W << 8
    Tl = peek(P)
    W += Tl
    P += 1
  end if
  if Tf = 0 then
    put char Tb at Tx,Ty
    inc Tx
    inc Tn
  end if
  Tf = 0
  ' find word W: one pointer per 16 words, then skip
  T = W >> 4
  Q = DictGrp[T]
  T = W & 15
dt_skip:
  if T > 0 then
    Tl = peek(Q)
    Q += Tl
    Q += 1
    dec T
    goto dt_skip
  end if
  Tl = peek(Q)
  Q += 1
dt_ch:
  if Tl = 0 then goto dt_word
  Tc = peek(Q)
  Tc += Tb
  put char Tc at Tx,Ty
  inc Tx
  inc Tn
  Q += 1
  dec Tl
  goto dt_ch
dt_pad:
  if Tn < PadW then
    put char Tb at Tx,Ty
    inc Tx
    inc Tn
    goto dt_pad
  end if
  goto dt_line
end sub

' NumV as 2 digits at NumX,NumY in the variant whose base is Tb
sub PutNum2:
  T = NumV / 10
  V = NumV % 10
  Tc = Tb + 27
  Tc += T
  put char Tc at NumX,NumY
  Tc = Tb + 27
  Tc += V
  inc NumX
  put char Tc at NumX,NumY
  return
end sub

' Num16 (0-9999) as 4 digits, variant 1
sub PutNum4:
  W16 = Num16 / 1000
  T = W16
  Tc = 77 + T
  put char Tc at NumX,NumY
  W16 = Num16 % 1000
  NumV = W16 / 10
  Tb = 50
  inc NumX
  PutNum2
  W16 = Num16 % 10
  T = W16
  Tc = 77 + T
  inc NumX
  put char Tc at NumX,NumY
  return
end sub

sub ClearBox:
  for Li = 13 to 17
    fill 0 count 28 at 2,Li
  next
  return
end sub

' header (case number) and HUD: city, hours/deadline (row 19); ID clues,
' alert (row 21)
sub DrawHud:
  TId = TxCaseLbl
  DrawText
  NumV = CaseNo + 1
  NumX = 20
  NumY = 1
  Tb = 50
  PutNum2
  put char 77 at 19,1
  TId = TxHud
  DrawText
  if Hard = 1 then
    TId = TxLvlTag
    DrawText
  end if
  C = City
  TId = TxCity0
  Dx = 2
  Dy = 19
  CityPage
  Dx = 15
  Dy = 21
  TId = TxNoneName
  if Alert > 0 then
    T = Alert - 1
    TId = TxPerson0 + T
  end if
  DrawText
  Dx = 0
  Dy = 0
  Tb = 50
  NumV = Hours
  NumX = 22
  NumY = 19
  PutNum2
  put char 94 at 24,19
  NumV = Deadline
  NumX = 25
  PutNum2
  put char 58 at 27,19
  T = IdCount()
  Tc = 77 + T
  put char Tc at 5,21
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Jk = 0
  Btn = 0
  if joypad(1).up then Jk = Jk | 1
  if joypad(1).down then Jk = Jk | 2
  if joypad(2).up then Jk = Jk | 1
  if joypad(2).down then Jk = Jk | 2
  if joypad(1).left then Jk = Jk | 4
  if joypad(1).right then Jk = Jk | 8
  if joypad(2).left then Jk = Jk | 4
  if joypad(2).right then Jk = Jk | 8
  if joypad(1).button1 then Btn = Btn | 16
  if joypad(1).button2 then Btn = Btn | 32
  if joypad(2).button1 then Btn = Btn | 16
  if joypad(2).button2 then Btn = Btn | 32
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  K = WasBtn ^ 48
  K = Btn & K
  Press1 = 0
  Press2 = 0
  V = K & 16
  if V > 0 then Press1 = 1
  V = K & 32
  if V > 0 then Press2 = 1
  WasBtn = Btn
  return
end sub

sub WaitButton:
  WasBtn = 48
wb_loop:
  Frame1
  ReadPad
  if Press1 = 1 then return
  if Press2 = 1 then return
  goto wb_loop
end sub

sub PageWait:
  ShowScreen
  WasBtn = 48
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    return
  end if
  if Press1 = 1 then return
  if Press2 = 1 then return
  goto pw_loop
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub LoadFont:
  copy FontPat count 400 to vram.pattern
  copy FontPat count 400 to vram.pattern + 400
  copy FontPat count 400 to vram.pattern + 800
  copy FontPat count 400 to vram.pattern + 2048
  copy FontPat count 400 to vram.pattern + 2448
  copy FontPat count 400 to vram.pattern + 2848
  copy FontPat count 400 to vram.pattern + 4096
  copy FontPat count 400 to vram.pattern + 4496
  copy FontPat count 400 to vram.pattern + 4896
  fill $F1 count 400 to vram.color
  fill $B4 count 400 to vram.color + 400
  fill $1B count 400 to vram.color + 800
  fill $F1 count 400 to vram.color + 2048
  fill $B4 count 400 to vram.color + 2448
  fill $1B count 400 to vram.color + 2848
  fill $F1 count 400 to vram.color + 4096
  fill $B4 count 400 to vram.color + 4496
  fill $1B count 400 to vram.color + 4896
  return
end sub

sub ShowImage:
  decompress zx0 ImN[Img] to vram.name
  decompress zx0 ImP0[Img] to vram.pattern + 1200
  decompress zx0 ImC0[Img] to vram.color + 1200
  decompress zx0 ImP1[Img] to vram.pattern + 3248
  decompress zx0 ImC1[Img] to vram.color + 3248
  decompress zx0 ImP2[Img] to vram.pattern + 5296
  decompress zx0 ImC2[Img] to vram.color + 5296
  return
end sub

sub BeginFrame:
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  DrawHud
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

