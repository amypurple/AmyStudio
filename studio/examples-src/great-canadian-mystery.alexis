  bitmap screen
  set sound table GcmSoundTable areas 6
  sprites 16x16
  nmi off
  display off
  LoadFont
  copy SprPat count SprBytes to vram.spr_pat
  HideSprites

title:
  TitlePage
  if MSel = 3 then
    HowTo
    goto title
  end if
  if MSel = 4 then
    CreditsPage
    goto title
  end if
  if MSel = 0 then PickCase
  if HaveCase = 0 then PickCase
  NewGame
  Briefing

hub:
  HubScreen
  if MSel = 255 then goto hub
  HubSel = MSel
  if MSel < 3 then
    Investigate
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 3 then
    if Leg < 3 then
      MapScreen
    else
      Verify
    end if
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 4 then
    Dossier
    if Outcome <> OcNone then goto ending
    goto hub
  end if
  if MSel = 5 then
    Atlas
    goto hub
  end if
  Outcome = OcEnded

ending:
  EndScreen
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' 16-bit xorshift, stepped every title frame
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new case, never the one just played
sub PickCase:
  Rand
  W16 = Rs % NCases
  K = W16
  if HaveCase = 1 then
    W16 = Rs % 31
    K = W16
    if K >= CaseNo then inc K
  end if
  CaseNo = K
  HaveCase = 1
  return
end sub

sub NewGame:
  W = CaseNo * CaseLen
  for Li = 0 to 24
    CaseBuf[Li] = Cases[W]
    W += 1
  next
  Deadline = CaseBuf[CsDead]
  Leg = 0
  City = CaseBuf[CsRoute]
  Hours = 0
  Clues = 0
  Leads = 0
  LeadFr = 0
  ClueFr = 0
  Alert = 0
  Outcome = OcNone
  WrongTrips = 0
  HubSel = 0
  AtSel = 0
  DosSel = 0
  Score = 0
  fill array VisMask with 0
  return
end sub

sub AddHours:
  Hours += T
  if Hours > Deadline then Outcome = OcDeadline
  return
end sub

function IdCount() as u8
  u8 Ic = 0
  Ic = Clues & 1
  if Clues >= 2 then inc Ic
  return Ic

' a venue: the first visit costs 2 hours and gives its clues
sub Investigate:
  T = 1 << HubSel
  NewClue = 0
  V = VisMask[Leg] & T
  if V = 0 then
    VisMask[Leg] = VisMask[Leg] | T
    VenueClues
    ' v2 rule: a witness with a hint (lead or ID clue) +2 h, without +1 h
    AskCost = 1
    if IsLead = 1 then AskCost = 2
    if J > 0 then AskCost = 2
    if Hard = 1 then AskCost = 2
    T = AskCost
    AddHours
    if Outcome <> OcNone then return
    NewClue += 2
  end if
  WitnessScreen
  return
end sub

' what venue HubSel of this leg gives: lead (IsLead) and ID clue bits (J)
sub VenueInfo:
  ' v2.2: one clue per witness. IsLead, J (ID clue bit), IsFr (French witness)
  IsLead = 0
  J = 0
  IsFr = 0
  K = Leg << 2
  K += HubSel
  if CaseBuf[CsFr] = K then IsFr = 1
  if Leg < 3 then
    T = CsLeadV + Leg
    if CaseBuf[T] = HubSel then IsLead = 1
  end if
  if CaseBuf[CsIdAt] = K then J = 1
  if CaseBuf[CsIdAt + 1] = K then J = 2
  if Leg = 3 then
    if HubSel = 0 then J = 1 << CaseBuf[CsFinal]
  end if
  return
end sub

sub VenueClues:
  VenueInfo
  if IsLead = 1 then
    T = 1 << Leg
    V = Leads & T
    if V = 0 then
      NewClue = 1
      if IsFr = 1 then LeadFr = LeadFr | T
    end if
    Leads = Leads | T
  end if
  V = Clues & J
  if V <> J then
    NewClue = 1
    if IsFr = 1 then ClueFr = ClueFr | J
  end if
  Clues = Clues | J
  return
end sub

sub Verify:
  T = CaseBuf[CsCulprit] + 1
  if Alert = T then
    Outcome = OcWin
    return
  end if
  if Alert > 0 then
    Outcome = OcWrongAlert
    return
  end if
  T = Deadline - 2
  if Hours > T then
    Outcome = OcNoAlert
    return
  end if
  State = StNoAlert
  ClearBox
  TId = TxNoAlertBox
  DrawText
  play sound SndWrong
  WaitButton
  Dossier
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub HubScreen:
  State = StHub
  T = CityScene[City]
  Img = ImgSceneQC + T
  BeginFrame
  if Leg = 3 then
    TId = TxHubTitleF
    DrawText
    TId = TxHubBoxF
  else
    TId = TxHubTitle
    DrawText
    TId = TxHubBox + Hard
  end if
  DrawText
  K = City * Stride
  K += TxCity0 + 7
  for Li = 0 to 6
    MIt[Li] = K + Li
    MXx[Li] = 17
    MYy[Li] = Li + 4
  next
  MIt[3] = TxItemTravel
  if Leg = 3 then MIt[3] = TxItemVerify
  MIt[4] = TxItemDossier
  MIt[5] = TxItemAtlas
  MIt[6] = TxItemEnd
  MN = 7
  MSel = HubSel
  MKind = 0
  MPad = 12
  ShowScreen
  RunMenu
  return
end sub

' text page TId of city C (Stride pages each) at Dx,Dy
sub CityPage:
  T = C * Stride
  TId = TId + T
  DrawText
  return
end sub

sub WitnessScreen:
  ' v2.2: role (row 3), what the witness says on rows 5/7/9 (one clue at
  ' most), the cost and a note in the box (rows 13/15/17)
  State = StWit
  K = City * 3
  K += HubSel
  T = VenuePortrait[K]
  Img = ImgWit0 + T
  BeginFrame
  VenueInfo
  C = City
  TId = TxCity0 + 10 + HubSel
  Dx = 13
  Dy = 3
  CityPage
  Dy = 5
  if IsLead = 1 then
    K = CsRoute + 1 + Leg
    C = CaseBuf[K]
    TId = TxCity0 + 2 + Hard
    if IsFr = 1 then TId = TxCity0 + 4
    CityPage
    Dx = 0
    Dy = 0
    TId = TxLeadBox + IsFr
    DrawText
    goto ws_cost
  end if
  if J > 0 then
    K = CaseBuf[CsTrait]
    if J = 2 then K = CaseBuf[CsTrait + 1]
    K = K << 2
    T = IsFr << 1
    K += T
    TId = TxTrait0Q + K
    DrawText
    inc TId
    Dx = 7
    Dy = 15
    DrawText
    TId = TxIdLabel
    Dx = 3
    DrawText
    goto ws_fr
  end if
  if Leg = 3 then
    if HubSel = 2 then
      TId = TxItemQuote
      DrawText
      T = CaseBuf[CsInc] * 3
      TId = TxInc0Item + T
      Dy = 7
      DrawText
      Dx = 0
      Dy = 0
      TId = TxItemBox
      DrawText
      goto ws_cost
    end if
  end if
  if IsFr = 1 then
    TId = TxFrTalk0 + HubSel
    DrawText
  else
    C = City
    TId = TxCity0 + 13 + HubSel
    CityPage
  end if
  Dx = 0
  Dy = 0
  TId = TxNoLeadBox
  DrawText
ws_fr:
  Dx = 0
  Dy = 0
  if IsFr = 1 then
    TId = TxFrNote
    DrawText
  end if
ws_cost:
  Dx = 3
  Dy = 13
  Ovr = 0
  TId = TxCostOld
  if NewClue >= 2 then
    TId = TxCostNew
    if AskCost = 1 then TId = TxCostNew1
  end if
  DrawText
  Ovr = 255
  Dx = 0
  Dy = 0
  ShowScreen
  if NewClue = 3 then
    play sound SndEvidence
  else
    play sound SndClick
  end if
  WaitButton
  return
end sub

sub MapScreen:
  State = StMap
  Img = ImgMap
  BeginFrame
  T = 1 << Leg
  T = Leads & T
  if T > 0 then
    ' the lead as it was heard (NORMAL / HARD wording, or French), rows 13/15/17
    K = CsRoute + 1 + Leg
    C = CaseBuf[K]
    TId = TxCity0 + 2 + Hard
    V = LeadFr & T
    if V > 0 then TId = TxCity0 + 4
    Dx = 3
    Dy = 13
    Ovr = 0
    CityPage
    Ovr = 255
    Dx = 0
    Dy = 0
  else
    TId = TxMapNoLead
    DrawText
    TId = TxMapCost + Hard
    DrawText
  end if
  ' the three choices: name (menu item) and province below
  for Li = 0 to 2
    K = Leg * 3
    K += CsChoice + Li
    C = CaseBuf[K]
    T = C * Stride
    MIt[Li] = TxCity0 + T
    MXx[Li] = 15
    T = Li * 3
    MYy[Li] = T + 3
    TId = MIt[Li] + 1
    Dx = 15
    Dy = T + 4
    DrawText
  next
  Dx = 0
  Dy = 0
  MN = 3
  MSel = 0
  MKind = 1
  MPad = 14
  MLead = 0
  MapMarks
  ShowScreen
  RunMenu
  MLead = 1
  if MSel = 255 then
    HideSprites
    return
  end if
  K = Leg * 3
  K += CsChoice + MSel
  Dest = CaseBuf[K]
  TravelScreen
  K = CsRoute + 1 + Leg
  if CaseBuf[K] = Dest then
    T = 3
    AddHours
    if Outcome <> OcNone then return
    inc Leg
    City = Dest
    HubSel = 0
    return
  end if
  inc WrongTrips
  ' a wrong destination, round trip included: NORMAL +4 h, HARD +5 h
  T = 4 + Hard
  AddHours
  WrongScreen
  return
end sub

sub MapMarks:
  T = CitySY[City]
  V = CitySX[City]
  set sprite 0 to T,V,SMark,8
  for Li = 0 to 2
    K = Leg * 3
    K += CsChoice + Li
    J = CaseBuf[K]
    T = CitySY[J]
    V = CitySX[J]
    C = 1
    if Li = MSel then C = 15
    K = SNum1 + Li * 4
    J = Li + 1
    set sprite J to T,V,K,C
  next
  update sprites
  return
end sub

sub TravelScreen:
  State = StTravel
  Img = ImgTravel
  BeginFrame
  TId = TxTravelPanel
  DrawText
  Ovr = 0
  Dx = 5
  Dy = 5
  C = City
  TId = TxCity0
  CityPage
  Dy = 8
  C = Dest
  TId = TxCity0
  CityPage
  Dx = 0
  Dy = 0
  Ovr = 255
  TId = TxTravelBox
  DrawText
  ShowScreen
  play sound SndTravel
  play sound SndTravelTone
  V = 32
tr_loop:
  set sprite 0 to 74,V,SPlane,15
  update sprites
  Frame1
  V += 2
  if V < 210 then goto tr_loop
  HideSprites
  return
end sub

sub WrongScreen:
  State = StWrongTrip
  Img = ImgRed
  BeginFrame
  TId = TxWrongPanel
  DrawText
  Ovr = 0
  Dx = 5
  Dy = 7
  C = Dest
  TId = TxCity0
  CityPage
  Ovr = 255
  Dx = 0
  Dy = 0
  TId = TxRound4 + Hard
  DrawText
  TId = TxWrongBox
  DrawText
  ShowScreen
  play sound SndWrong
  WaitButton
  return
end sub

sub Dossier:
  MSel = DosSel
ds_draw:
  State = StDos
  Img = ImgPanel
  BeginFrame
  ' 2 x 3 list of first names (rows 3, 5, 7; columns 4 and 14), a mark
  ' before each: + matches the clues found, X does not, ? no clue yet
  for Li = 0 to 5
    T = TxPersonF0 + Li
    MIt[Li] = T
    K = Li
    MXx[Li] = 5
    if Li >= 3 then
      MXx[Li] = 14
      K = Li - 3
    end if
    MYy[Li] = K + 3
    ' the marks in the panel colours: ?, X, +
    Tc = GQ1
    if Clues > 0 then
      PersonMatch
      Tc = GX1
      if V = 1 then Tc = GPl1
    end if
    T = MXx[Li] - 2
    K = MYy[Li]
    put char Tc at T,K
  next
  DosBox
  MN = 6
  MKind = 2
  MPad = 5
  MLead = 0
  Img = MSel
  ShowCul
  ShowScreen
ds_menu:
  RunMenu
  MLead = 1
  if MSel = 255 then return
  DosSel = MSel
  T = IdCount()
  if T < 2 then
    ClearBox
    TId = TxNeedClues
    DrawText
    play sound SndWrong
    MSel = DosSel
    MLead = 0
    goto ds_menu
  end if
  AlertScreen
  if Outcome <> OcNone then return
  MSel = DosSel
  goto ds_draw
end sub

' does person Li have every trait found? V = 1 yes
sub PersonMatch:
  V = 1
  for J = 0 to 1
    T = 1 << J
    T = Clues & T
    if T > 0 then
      K = CsTrait + J
      C = CaseBuf[K]
      K = Li * 3
      T = 0
      if PersonTraits[K] = C then T = 1
      inc K
      if PersonTraits[K] = C then T = 1
      inc K
      if PersonTraits[K] = C then T = 1
      if T = 0 then V = 0
    end if
  next
  return
end sub

' the person under the cursor: traits in the panel (rows 7, 9, 11), the
' verdict and the clues found in the box (rows 13, 15, 17)
sub DosBox:
  ClearBox
  fill Sp1 count 18 at 3,7
  fill Sp1 count 18 at 3,8
  fill Sp1 count 18 at 3,9
  TId = TxPersonT0 + MSel
  Dx = 3
  Dy = 7
  DrawText
  Ovr = 255
  Li = MSel
  TId = TxStUnk
  if Clues > 0 then
    PersonMatch
    TId = TxStX
    if V = 1 then TId = TxStMatch
  end if
  Dy = 13
  DrawText
  TId = TxPerson0 + MSel
  Dx = 17
  Ovr = 0
  DrawText
  Ovr = 255
  for J = 0 to 1
    Dx = 3
    Dy = J << 1
    Dy += 15
    TId = TxIdLabel
    DrawText
    Dx = 7
    TId = TxTraitNo
    T = 1 << J
    V = Clues & T
    if V > 0 then
      K = CsTrait + J
      T = CaseBuf[K] << 2
      TId = TxTrait0Q + 1 + T
      V = ClueFr >> J
      V = V & 1
      if V = 1 then TId += 2
    end if
    DrawText
  next
  Dx = 0
  Dy = 0
  return
end sub

sub AlertScreen:
  State = StAlertScr
  Img = ImgAlert
  BeginFrame
  TId = TxAlertPanel
  DrawText
  TId = TxPerson0 + DosSel
  Dx = 7
  Dy = 5
  DrawText
  Dx = 0
  Dy = 0
  TId = TxAlertBox
  DrawText
  MIt[0] = TxItemYes
  MIt[1] = TxItemNo
  MXx[0] = 6
  MXx[1] = 14
  MYy[0] = 9
  MYy[1] = 9
  MN = 2
  MSel = 0
  MKind = 0
  MPad = 5
  ShowScreen
  RunMenu
  if MSel = 0 then
    Alert = DosSel + 1
    play sound SndAlert
    T = 2
    AddHours
  end if
  return
end sub

' the atlas: 11 places in two columns, each a page; free
sub Atlas:
  ' 11 places and the FR-EN word list; an entry has 1-6 pages (3-4 lines on
  ' alternate rows): button 1 turns the page, button 2 goes back to the list
at_draw:
  State = StAtlas
  Img = ImgPaper
  BeginFrame
  TId = TxAtlasTitle
  DrawText
  TId = TxAtlasBox
  DrawText
  for Li = 0 to 11
    MIt[Li] = TxItemWords
    if Li < NCity then
      T = AtlasCity[Li] * Stride
      MIt[Li] = TxCity0 + T
    end if
    if Li < 6 then
      MXx[Li] = 3
      MYy[Li] = Li + 5
    else
      MXx[Li] = 18
      MYy[Li] = Li - 1
    end if
  next
  MN = NAtlas
  MSel = AtSel
  MKind = 0
  MHi = 1
  MNorm = 2
  MPad = 11
  MLead = 0
  ShowScreen
  RunMenu
  MLead = 1
  MHi = 2
  MNorm = 255
  if MSel = 255 then return
  AtSel = MSel
  AtPg = AtlasPg[AtSel]
  Page = AtlasN[AtSel]
at_page:
  State = StAtlasPage
  Img = ImgPaper
  BeginFrame
  TId = AtPg
  DrawText
  TId = TxAtlasBox
  if AtSel = NCity then TId = TxWordsBox
  DrawText
  ShowScreen
  play sound SndClick
  WaitButton
  if Press2 = 1 then goto at_draw
  AtPg += 1
  dec Page
  if Page > 0 then goto at_page
  goto at_draw
end sub

sub EndScreen:
  HideSprites
  if Outcome = OcWin then
    Img = ImgGreen
  else
    Img = ImgRed
  end if
  BeginFrame
  if Outcome = OcWin then
    TId = TxWinPanel
    DrawText
    ' the culprit, caught: name (row 5), "IS CAUGHT WITH" (row 7), the
    ' item (row 9), the portrait (columns 22-27); hours and score in the box
    T = CaseBuf[CsCulprit]
    TId = TxPerson0 + T
    Dx = 4
    Dy = 6
    DrawText
    T = CaseBuf[CsInc] * 3
    TId = TxInc0Item + T
    Dy = 9
    DrawText
    Dx = 0
    Dy = 0
    NumV = Deadline - Hours
    NumX = 15
    NumY = 13
    Tb = 0
    PutNum2
    Score = NumV * 25
    Score += 1000
    Num16 = Score
    NumX = 25
    Tb = 0
    PutNum4
    TId = TxWinBox
  end if
  if Outcome = OcDeadline then
    TId = TxLossDeadline
    DrawText
    NumV = Hours
    NumX = 11
    NumY = 7
    Tb = 0
    PutNum2
    Tc = GSl0
    put char Tc at 13,7
    NumV = Deadline
    NumX = 14
    PutNum2
    TId = TxLossDeadlineBox
  end if
  if Outcome = OcWrongAlert then
    TId = TxLossWrong
    DrawText
    T = Alert - 1
    TId = TxPerson0 + T
    Dx = 4
    Dy = 6
    Ovr = 0
    DrawText
    Ovr = 255
    Dx = 0
    Dy = 0
    TId = TxLossWrongBox
  end if
  if Outcome = OcNoAlert then
    TId = TxLossNoAlert
    DrawText
    TId = TxLossNoAlertBox
  end if
  if Outcome = OcEnded then
    TId = TxLossEnded
    DrawText
    TId = TxLossEndedBox
  end if
  DrawText
  ' the end picture: the culprit on a win, the escaping silhouette otherwise
  Img = 6
  if Outcome = OcWin then
    Img = CaseBuf[CsCulprit]
  else
    TId = TxGotAway
    DrawText
  end if
  ShowCul
  ShowScreen
  if Outcome = OcWin then
    play sound SndWinLead
    play sound SndWinPad
    play sound SndWinBassPitch
    play sound SndWinBassVol
  else
    play sound SndLoseLead
    play sound SndLosePad
    play sound SndLoseBassPitch
    play sound SndLoseBassVol
  end if
  return
end sub

sub Briefing:
  State = StBrief
  Img = ImgBrief
  BeginFrame
  TId = TxBriefTop
  DrawText
  T = CaseBuf[CsInc] * 3
  TId = TxInc0Title + T
  Dx = 16
  Dy = 5
  DrawText
  inc TId
  inc TId
  Dx = 3
  Dy = 13
  DrawText
  C = City
  TId = TxCity0
  Dx = 14
  Dy = 17
  Ovr = 0
  CityPage
  Ovr = 255
  Dx = 0
  Dy = 0
  TId = TxBriefLast
  DrawText
  NumV = Deadline
  NumX = 16
  NumY = 9
  Tb = NG
  PutNum2
  ShowScreen
  play sound SndAlert
  WaitButton
  return
end sub

' ---------------------------------------------------------------------------
' title, HOW TO PLAY, credits

sub TitlePage:
  State = StTitle
  Img = ImgTitle
  NewScreen
  ShowImage
  TId = TxTitleFoot
  DrawText
  for Li = 0 to 4
    MIt[Li] = TxTitleNew + Li
    MXx[Li] = 9
    MYy[Li] = Li + 16
  next
  MIt[2] = TxTitleDiffN + Hard
  MIt[3] = TxTitleHow
  MIt[4] = TxTitleCredits
  MN = 5
  MSel = 0
  MKind = 3
  MBack = 0
  MPad = 15
  ShowScreen
  mute all
  play sound SndMusLead
  play sound SndMusPad
  play sound SndMusBassPitch
  play sound SndMusBassVol
  RunMenu
  MBack = 1
  stop sound SndMusLead
  stop sound SndMusPad
  stop sound SndMusBassPitch
  stop sound SndMusBassVol
  mute all
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub TitleAnim:
  Rand
  V = Tick & 31
  if V <> 0 then return
  V = Tick & 32
  if V = 0 then
    fill $B4 count 8 to vram.color + TBulbA * 8
    fill $A4 count 8 to vram.color + TBulbB * 8
    T = 119
  else
    fill $A4 count 8 to vram.color + TBulbA * 8
    fill $B4 count 8 to vram.color + TBulbB * 8
    T = 121
  end if
  set sprite 0 to T,24,SLeaf,8
  set sprite 1 to T,216,SLeaf,8
  update sprites
  return
end sub

sub HowTo:
  ' 5 pages: picture, panel (alternate rows), box; button or 30 s
  State = StHow
  Page = 1
hw_page:
  Img = ImgPanel
  if Page = 1 then Img = ImgSceneQC
  if Page = 2 then Img = ImgMap
  if Page = 3 then Img = ImgMap
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  T = Page - 1
  T = T << 1
  TId = TxHow0 + T
  DrawText
  inc TId
  DrawText
  PageWait
  if TimedOut = 1 then return
  inc Page
  if Page <= 5 then goto hw_page
  return
end sub

sub CreditsPage:
  State = StCredits
  Img = ImgPanel
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  TId = TxCredits
  DrawText
  TId = TxCreditsBox
  DrawText
  PageWait
  return
end sub

' ---------------------------------------------------------------------------
' the menu engine: MN items; item k is page MIt[k] drawn at MXx[k],MYy[k]
' padded to MPad cells; the cursor's item in variant MHi, the others in
' MNorm (255 = the page's own). Stick up/down moves, button 1 returns MSel,
' button 2 returns 255 (when MBack = 1). MKind: 0 plain, 1 map (markers),
' 2 dossier (the box describes the person), 3 title (lights, random seed)

sub RunMenu:
  for Li = 0 to 11
    if Li < MN then DrawItem
  next
  WasBtn = 48
rm_loop:
  Frame1
  ReadPad
  if MKind = 3 then TitleAnim
  K = Edge & 3
  if K > 0 then
    MOld = MSel
    if K = 1 then
      if MSel = 0 then
        MSel = MN - 1
      else
        dec MSel
      end if
    else
      inc MSel
      if MSel >= MN then MSel = 0
    end if
    Li = MOld
    DrawItem
    Li = MSel
    DrawItem
    if MKind = 1 then MapMarks
    if MKind = 2 then
      DosBox
      ' the portrait of the person under the cursor: the area is blanked,
      ' the new tiles loaded, then the names written (about 0.1 s)
      for Li = 2 to 11
        fill Sp1 count 6 at 22,Li
      next
      Img = MSel
      ShowCul
    end if
    play sound SndClick
  end if
  if MKind = 3 then
    if MSel = 2 then
      ' the level: stick left/right or button 1 toggles NORMAL / HARD
      K = Edge & 12
      if K > 0 then Press1 = 1
      if Press1 = 1 then
        Hard = Hard ^ 1
        MIt[2] = TxTitleDiffN + Hard
        Li = 2
        DrawItem
        play sound SndClick
        Press1 = 0
      end if
    end if
  end if
  if Press1 = 1 then return
  if Press2 = 1 then
    if MBack = 1 then
      MSel = 255
      return
    end if
  end if
  goto rm_loop
end sub

sub DrawItem:
  TId = MIt[Li]
  Dx = MXx[Li]
  Dy = MYy[Li]
  Ovr = MNorm
  if Li = MSel then Ovr = MHi
  PadW = MPad
  PadLead = MLead
  DrawText
  PadW = 0
  PadLead = 1
  Ovr = 255
  Dx = 0
  Dy = 0
  return
end sub

' ---------------------------------------------------------------------------
' text: page TId = lines of [x + 32 * variant] [y] words... 255; 255 ends
' the page. A word is a dictionary index (1 byte, or 240+hi, lo). Dx/Dy
' shift the page, Ovr (not 255) replaces the variant, PadW (not 0) pads
' each line to PadW cells with a leading space (menu highlight bars).

sub DrawText:
  ' pages 0-255 in TxtTab, 256 and up in TxtTab2 (word tables take a byte index)
  if TId >= 256 then
    W16 = TId - 256
    Tq = W16
    P = TxtTab2[Tq]
  else
    Tq = TId
    P = TxtTab[Tq]
  end if
dt_line:
  Tx = peek(P)
  if Tx = 255 then return
  Tv = Tx >> 5
  Tx = Tx & 31
  Tx += Dx
  Ty = peek(P + 1)
  Ty += Dy
  P += 2
  if Ovr <> 255 then Tv = Ovr
  Tb = VBase[Tv]
  Tn = 0
  Tf = 1
  if PadLead > 0 then
    if PadW > 0 then put char Tb at Tx,Ty
  end if
  if PadW > 0 then
    if PadLead = 0 then goto dt_word
    inc Tx
    inc Tn
  end if
dt_word:
  Tc = peek(P)
  P += 1
  if Tc = 255 then goto dt_pad
  W = Tc
  if Tc >= 240 then
    W = Tc - 240
    W = W << 8
    Tl = peek(P)
    W += Tl
    P += 1
  end if
  if Tf = 0 then
    put char Tb at Tx,Ty
    inc Tx
    inc Tn
  end if
  Tf = 0
  ' find word W: one pointer per 16 words, then skip
  T = W >> 4
  Q = DictGrp[T]
  T = W & 15
dt_skip:
  if T > 0 then
    Tl = peek(Q)
    Q += Tl
    Q += 1
    dec T
    goto dt_skip
  end if
  Tl = peek(Q)
  Q += 1
dt_ch:
  if Tl = 0 then goto dt_word
  Tc = peek(Q)
  Tc += Tb
  put char Tc at Tx,Ty
  inc Tx
  inc Tn
  Q += 1
  dec Tl
  goto dt_ch
dt_pad:
  if Tn < PadW then
    put char Tb at Tx,Ty
    inc Tx
    inc Tn
    goto dt_pad
  end if
  goto dt_line
end sub

' NumV as 2 digits at NumX,NumY in the variant whose base is Tb
sub PutNum2:
  T = NumV / 10
  V = NumV % 10
  Tc = Tb + 27
  Tc += T
  put char Tc at NumX,NumY
  Tc = Tb + 27
  Tc += V
  inc NumX
  put char Tc at NumX,NumY
  return
end sub

' Num16 (0-9999) as 4 digits in the variant whose base is Tb
sub PutNum4:
  W16 = Num16 / 1000
  T = W16
  Tc = Tb + 27
  Tc += T
  put char Tc at NumX,NumY
  W16 = Num16 % 1000
  NumV = W16 / 10
  inc NumX
  PutNum2
  W16 = Num16 % 10
  T = W16
  Tc = Tb + 27
  Tc += T
  inc NumX
  put char Tc at NumX,NumY
  return
end sub

sub ClearBox:
  for Li = 13 to 17
    fill 0 count 28 at 2,Li
  next
  return
end sub

' header (case number) and HUD: city, hours/deadline (row 19); ID clues,
' alert (row 21)
sub DrawHud:
  TId = TxCaseLbl
  DrawText
  NumV = CaseNo + 1
  NumX = 21
  NumY = 1
  Tb = NG
  PutNum2
  put char GZ1 at 20,1
  TId = TxHud
  DrawText
  if Hard = 1 then
    TId = TxLvlTag
    DrawText
  end if
  C = City
  TId = TxCity0
  Dx = 3
  Dy = 19
  CityPage
  Dx = 16
  Dy = 21
  TId = TxNoneName
  if Alert > 0 then
    T = Alert - 1
    TId = TxPerson0 + T
  end if
  DrawText
  Dx = 0
  Dy = 0
  Tb = NG
  NumV = Hours
  NumX = 23
  NumY = 19
  PutNum2
  put char GSl1 at 25,19
  NumV = Deadline
  NumX = 26
  PutNum2
  put char GH1 at 28,19
  T = IdCount()
  Tc = GZ1 + T
  put char Tc at 6,21
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Jk = 0
  Btn = 0
  if joypad(1).up then Jk = Jk | 1
  if joypad(1).down then Jk = Jk | 2
  if joypad(2).up then Jk = Jk | 1
  if joypad(2).down then Jk = Jk | 2
  if joypad(1).left then Jk = Jk | 4
  if joypad(1).right then Jk = Jk | 8
  if joypad(2).left then Jk = Jk | 4
  if joypad(2).right then Jk = Jk | 8
  if joypad(1).button1 then Btn = Btn | 16
  if joypad(1).button2 then Btn = Btn | 32
  if joypad(2).button1 then Btn = Btn | 16
  if joypad(2).button2 then Btn = Btn | 32
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  K = WasBtn ^ 48
  K = Btn & K
  Press1 = 0
  Press2 = 0
  V = K & 16
  if V > 0 then Press1 = 1
  V = K & 32
  if V > 0 then Press2 = 1
  WasBtn = Btn
  return
end sub

sub WaitButton:
  WasBtn = 48
wb_loop:
  Frame1
  ReadPad
  if Press1 = 1 then return
  if Press2 = 1 then return
  goto wb_loop
end sub

sub PageWait:
  ShowScreen
  WasBtn = 48
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    return
  end if
  if Press1 = 1 then return
  if Press2 = 1 then return
  goto pw_loop
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub LoadFont:
  ' the font in its three colours, in each screen third
  Va = 0
  for J = 0 to 2
    Vb = Va
    copy FontPat count FontBytes to vram.pattern + Vb
    fill $F1 count FontBytes to vram.color + Vb
    Vb += FontBytes
    copy FontPat count FontBytes to vram.pattern + Vb
    fill $B4 count FontBytes to vram.color + Vb
    Vb += FontBytes
    copy FontPat count FontBytes to vram.pattern + Vb
    fill $1B count FontBytes to vram.color + Vb
    Va += 2048
  next
  return
end sub

sub ShowImage:
  decompress zx0 ImN[Img] to vram.name
  decompress zx0 ImP0[Img] to vram.pattern + ArtOff
  decompress zx0 ImC0[Img] to vram.color + ArtOff
  decompress zx0 ImP1[Img] to vram.pattern + 2048 + ArtOff
  decompress zx0 ImC1[Img] to vram.color + 2048 + ArtOff
  decompress zx0 ImP2[Img] to vram.pattern + 4096 + ArtOff
  decompress zx0 ImC2[Img] to vram.color + 4096 + ArtOff
  return
end sub

' end / dossier picture Img (0-5 a person, 6 the silhouette): one ZX0
' stream unpacked to free VRAM at $1B80 (after the sprite table), then copied:
' 60 names (rows 2-11, columns 22-27), and each third's tiles at code 160
sub ShowCul:
  decompress zx0 CulTab[Img] to vram.spr_attr + 128
  ' third 0, then third 1: n tiles, patterns, colours (after the 60 names)
  Va = 60
  Vc = CulOff
  for J = 0 to 1
    vpeek vram.spr_attr + 128 + Va into Nt
    Va += 1
    Vb = Nt * 8
    Vd = Va + Vb
    for Li = 1 to Nt
      copy vram.spr_attr + 128 + Va count 8 to vram.pattern + Vc
      copy vram.spr_attr + 128 + Vd count 8 to vram.color + Vc
      Va += 8
      Vd += 8
      Vc += 8
    next
    Va = Vd
    Vc = 2048 + CulOff
  next
  ' the names last, so the new picture appears in one go
  Va = 0
  Vb = 86
  for Li = 0 to 9
    copy vram.spr_attr + 128 + Va count 6 to vram.name + Vb
    Va += 6
    Vb += 32
  next
  return
end sub

sub BeginFrame:
  NewScreen
  ShowImage
  TId = TxHeader
  DrawText
  DrawHud
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

data FontPat bytes
  $00,$00,$00,$00,$00,$00,$00,$00,$78,$CC,$CC,$FC,$CC,$CC,$CC,$00,$F8,$CC,$CC,$F8,$CC,$CC,$F8,$00
  $78,$CC,$C0,$C0,$C0,$CC,$78,$00,$F0,$D8,$CC,$CC,$CC,$D8,$F0,$00,$FC,$C0,$C0,$F8,$C0,$C0,$FC,$00
  $FC,$C0,$C0,$F8,$C0,$C0,$C0,$00,$78,$CC,$C0,$DC,$CC,$CC,$7C,$00,$CC,$CC,$CC,$FC,$CC,$CC,$CC,$00
  $78,$30,$30,$30,$30,$30,$78,$00,$1C,$0C,$0C,$0C,$CC,$CC,$78,$00,$CC,$D8,$F0,$E0,$F0,$D8,$CC,$00
  $C0,$C0,$C0,$C0,$C0,$C0,$FC,$00,$C4,$EC,$FC,$D4,$C4,$C4,$C4,$00,$CC,$EC,$FC,$DC,$CC,$CC,$CC,$00
  $78,$CC,$CC,$CC,$CC,$CC,$78,$00,$F8,$CC,$CC,$F8,$C0,$C0,$C0,$00,$78,$CC,$CC,$CC,$DC,$C8,$74,$00
  $F8,$CC,$CC,$F8,$F0,$D8,$CC,$00,$78,$CC,$C0,$78,$0C,$CC,$78,$00,$FC,$30,$30,$30,$30,$30,$30,$00
  $CC,$CC,$CC,$CC,$CC,$CC,$78,$00,$CC,$CC,$CC,$CC,$CC,$78,$30,$00,$C4,$C4,$C4,$D4,$FC,$EC,$C4,$00
  $CC,$CC,$78,$30,$78,$CC,$CC,$00,$CC,$CC,$CC,$78,$30,$30,$30,$00,$FC,$0C,$18,$30,$60,$C0,$FC,$00
  $78,$CC,$DC,$FC,$EC,$CC,$78,$00,$30,$70,$30,$30,$30,$30,$78,$00,$78,$CC,$0C,$18,$30,$60,$FC,$00
  $78,$CC,$0C,$38,$0C,$CC,$78,$00,$18,$38,$78,$D8,$FC,$18,$18,$00,$FC,$C0,$F8,$0C,$0C,$CC,$78,$00
  $78,$C0,$C0,$F8,$CC,$CC,$78,$00,$FC,$0C,$18,$30,$30,$30,$30,$00,$78,$CC,$CC,$78,$CC,$CC,$78,$00
  $78,$CC,$CC,$7C,$0C,$0C,$78,$00,$00,$00,$00,$00,$00,$30,$30,$00,$00,$00,$00,$00,$30,$30,$60,$00
  $00,$30,$30,$00,$30,$30,$00,$00,$30,$30,$60,$00,$00,$00,$00,$00,$30,$30,$30,$30,$30,$00,$30,$00
