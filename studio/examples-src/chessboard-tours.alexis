cartridge "CHESSBOARD TOURS/DANIEL L. MILLER, AHOY!/1986"

' QUEEN'S AND BISHOP'S TOURS
' Based on "Queen's and Bishop's Tours" by Daniel L. Miller, Ahoy! June
' 1986 (Commodore 128, BASIC 7.0; orig/ has the article, the listing and
' a transcription). Made for the ColecoVision in Amy (the language by Amy
' Bienvenu) by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the listing's rules.
' - Two chessboard puzzles. The queen moves along a row, a column or a
'   diagonal, any number of squares, and may cross squares already
'   covered; she must cover all 64 squares (the article: in 14 moves,
'   ending where she began). The bishop starts on a white square, moves
'   diagonally and may not land on a covered square; he must visit all 32
'   white squares (the article: in 17 moves).
' - As the listing (lines 550-700): every square the piece leaves or
'   crosses is covered (RC()=3); the square it stands on is not covered
'   yet. The queen wins when all 64 are covered (her last square must
'   already be covered, so she ends where she has been, best where she
'   began); the bishop wins when 31 white squares are covered and he
'   stands on the 32nd (the listing's sums 192 and 158).
' - The computer solves either puzzle with the listing's own tours (DATA
'   lines 1190 and 1220: the queen from 1A, the bishop from 8H), the
'   piece gliding square by square.
' - Rows are numbered 1-8 from the top and the columns lettered A-H, as
'   the listing draws them; its white squares are where row + column is
'   even (1A is white).
' Changed (noted): the listing's queen check (line 420) accepted some
' moves that are not queen moves (1H to 2A: the "difference" 3 counted as
' a row move); here only rows, columns and diagonals are allowed. The
' move count is shown against the target; the listing did not stop you at
' 14 or 17 either.
'
' Made for this machine: a wooden board, the covered squares marked with a
' cyan gem (the queen's starting square, once left, with a red ring: her
' home), the queen and the bishop as sprites gliding square by square, a
' cursor in place of typed coordinates, a menu (SOLVE, END, BACK) on the
' right button in place of F1, sounds, the soft loop "Long Diagonal" under
' play (music first in the sound table) and an original title tune, "Grand
' Tour".
'
' Controls (either joystick): the stick moves the cursor; the left button
' places the piece (first) and then moves it to the cursor's square; the
' right button opens the menu (up and down choose, a button picks).
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; every screen drawn with the NMI off after a wait; at the end a
' press goes back to the title, and the screen sleeps after 30 seconds.

const TLt00 = 128
const TLt01 = 129
const TLt10 = 130
const TLt11 = 131
const TDk00 = 132
const TDk01 = 133
const TDk10 = 134
const TDk11 = 135
const TLtc00 = 136
const TLtc01 = 137
const TLtc10 = 138
const TLtc11 = 139
const TDkc00 = 140
const TDkc01 = 141
const TDkc10 = 142
const TDkc11 = 143
const TLth00 = 144
const TLth01 = 145
const TLth10 = 146
const TLth11 = 147
const TDkh00 = 148
const TDkh01 = 149
const TDkh10 = 150
const TDkh11 = 151
const TFh = 152
const TFv = 153
const TFc = 154
const SCursor = 0
const SQueenl = 4
const SQueen = 8
const SBishopl = 12
const SBishop = 16
const NTiles8 = 216
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndStep = 5
const SndLand = 6
const SndTick = 7
const SndPick = 8
const SndBuzz = 9
const SndWin = 10
const SndEnd = 11
' the tune now playing once: frames left (counted in Rearm)
u16 TzLeft = 0
u8 TzOn = 0

' the board: Rc(row * 9 + column), rows and columns 1-8: 1 a white square
' not covered, 2 a black one, 3 covered (the listing's RC())
u8 Rc[81]
' Ch 1 the queen, 2 the bishop; R1, C1 where it stands; Sr, Sc where it
' began; Mv the moves made; Tg the target (14 or 17)
u8 Ch = 1
u8 R1 = 0
u8 C1 = 0
u8 Sr = 0
u8 Sc = 0
u8 Mv = 0
u8 Tg = 14
' Kr, Kc the cursor; Er the last refusal (0 none, 1 invalid move, 2 space
' occupied, 3 invalid location); Won 1 when the tour is complete; Auto 1
' while the computer plays
u8 Kr = 4
u8 Kc = 4
u8 Er = 0
u8 Won = 0
u8 Auto = 0
' Ph: 1 placing the piece, 2 waiting for a move, 3 a move gliding, 4 the
' menu, 5 the end, 0 elsewhere (for the bot); Idle 1 inside the frame wait
u8 Ph = 0
u8 Idle = 0
' Mode 0 the board, 1 the menu (Mi the item: 0 SOLVE, 1 END, 2 BACK)
u8 Mode = 0
u8 Mi = 0
u8 Ended = 0
' Placed 1 once the piece is on the board
u8 Placed = 0
' work
u8 Qr = 0
u8 Qc = 0
u8 R2 = 0
u8 C2 = 0
u8 Dr = 0
u8 Dc = 0
u8 Gx = 0
u8 Gy = 0
u8 Fr = 0
u8 Si = 0
u8 Ok = 0
u16 Sum = 0
u16 A16 = 0
u16 NumU = 0
u8 Menu = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TrSoundTable areas 6
  sprites 16x16
  set sprite count 3
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title
  if Menu = 2 then
    RulesPage
    goto title
  end if
  Ch = Menu + 1
  Auto = 0

new_puzzle:
  Tg = 14
  if Ch = 2 then Tg = 17
  NewScreen
  ResetBoard
  DrawBoard
  DrawPanel
  ShowScreen
  play sound SndRunA
  play sound SndRunB
  Mode = 0
  Won = 0
  Ended = 0
  Er = 0
  Kr = 4
  Kc = 4
  Placed = 0
  ' first: the starting square
  print at 2,22, "PICK THE STARTING SQUARE   "
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
place_loop:
  Ph = 1
  Frame1
  ReadPad
  MoveCursor
  Cursor
  if Press2 = 1 then
    Mode = 1
    Mi = 0
    HideCursor
    ShowMenu
    play sound SndTick
    goto move_loop
  end if
  if Press = 0 then goto place_loop
  Er = 0
  if Ch = 2 then
    if Rc[Kr * 9 + Kc] <> 1 then
      Er = 3
      print at 2,22, "INVALID LOCATION: A WHITE  "
      play sound SndBuzz
      goto place_loop
    end if
  end if
  R1 = Kr
  C1 = Kc
  Sr = Kr
  Sc = Kc
  Placed = 1
  play sound SndPick
  PieceAt
  ShowFrom
  print at 2,22, "MOVE TO THE CURSOR: FIRE   "

move_loop:
  Ph = 2
  if Mode = 1 then Ph = 4
  Frame1
  ReadPad
  if Mode = 1 then
    MenuStep
    if Ended = 1 then goto puzzle_end
    if Auto = 1 then goto auto_play
    if Mode = 0 then
      if Placed = 0 then goto place_loop
    end if
    goto move_loop
  end if
  MoveCursor
  Cursor
  if Press2 = 1 then
    Mode = 1
    Mi = 0
    HideCursor
    ShowMenu
    play sound SndTick
    goto move_loop
  end if
  if Press = 0 then goto move_loop
  R2 = Kr
  C2 = Kc
  CheckMove
  if Er <> 0 then
    if Er = 1 then print at 2,22, "INVALID MOVE               "
    if Er = 2 then print at 2,22, "SPACE OCCUPIED             "
    play sound SndBuzz
    goto move_loop
  end if
  print at 2,22, "                           "
  Ph = 3
  HideCursor
  Glide
  CheckWin
  if Won = 1 then goto puzzle_won
  goto move_loop

' the computer's tour: from the listing's start, its moves one by one
auto_play:
  Mode = 0
  ClearMenu
  HideCursor
  ResetBoard
  DrawBoard
  Won = 0
  Mv = 0
  ShowMoves
  if Ch = 1 then
    R1 = 1
    C1 = 1
  else
    R1 = 8
    C1 = 8
  end if
  Sr = R1
  Sc = C1
  PieceAt
  ShowFrom
  print at 2,22, "THE COMPUTER'S TOUR        "
  for Si = 0 to 16
    if Won = 0 then
      Ph = 3
      for Fr = 1 to 30
        Frame1
        ReadPad
      next
      I = Si << 1
      if Ch = 1 then
        R2 = QSol[I]
        inc I
        C2 = QSol[I]
      else
        R2 = BSol[I]
        inc I
        C2 = BSol[I]
      end if
      Glide
      CheckWin
    end if
  next
  for Fr = 1 to 30
    Frame1
  next
  print at 2,21, "THE COMPUTER'S TOUR:       "
  print at 2,22, "                           "
  NumU = Mv
  print at 2,22, digits$(NumU, 2)
  print at 5,22, "MOVES, ALL COVERED"
  play sound SndWin
  goto puzzle_end

puzzle_won:
  play sound SndWin
  stop sound SndRunA
  stop sound SndRunB
  print at 2,21, "CONGRATULATIONS!!          "
  print at 2,22, "                           "
  NumU = Mv
  print at 2,22, "IN "
  print at 5,22, digits$(NumU, 2)
  if Mv <= Tg then
    print at 8,22, "MOVES: A MASTER'S TOUR "
  else
    print at 8,22, "MOVES (TARGET "
    NumU = Tg
    print at 22,22, digits$(NumU, 2)
    print at 24,22, ")   "
  end if

' the end: a press goes back to the title; left alone the screen sleeps
puzzle_end:
  Ph = 5
  stop sound SndRunA
  stop sound SndRunB
  HideCursor
  for Fr = 1 to 60
    Frame1
  next
  print at 22,19, "PRESS A"
  print at 22,20, "BUTTON "
  Rearm
  pause until press and release sleep after 30 seconds
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  goto title

' ---------------------------------------------------------------------
' the rules

' ResetBoard: every square white (1) or black (2), nothing covered (the
' listing's B$ and lines 1080-1090)
sub ResetBoard:
  for I = 0 to 80
    Rc[I] = 0
  next
  for Qr = 1 to 8
    for Qc = 1 to 8
      V = Qr + Qc
      V = V & 1
      W = Qr * 9
      W = W + Qc
      Rc[W] = V + 1
    next
  next
  Mv = 0
  return
end sub

' CheckMove: Er 0 if the piece may go from R1, C1 to R2, C2 (lines 400-450,
' the queen's check made exact)
sub CheckMove:
  Er = 1
  if R2 = R1 then
    if C2 = C1 then return
  end if
  if R2 >= R1 then
    Dr = R2 - R1
  else
    Dr = R1 - R2
  end if
  if C2 >= C1 then
    Dc = C2 - C1
  else
    Dc = C1 - C2
  end if
  Ok = 0
  if Dr = Dc then Ok = 1
  if Ch = 1 then
    if Dr = 0 then Ok = 1
    if Dc = 0 then Ok = 1
  end if
  if Ok = 0 then return
  if Ch = 2 then
    W = R2 * 9
    W = W + C2
    if Rc[W] = 3 then
      Er = 2
      return
    end if
  end if
  Er = 0
  return
end sub

' Glide: the piece goes to R2, C2 a square at a time; each square it
' leaves is covered (lines 550-680), then the move is counted (line 690)
sub Glide:
  play sound SndStep
glide_next:
  if R1 = R2 then
    if C1 = C2 then goto glide_done
  end if
  W = R1 * 9
  W = W + C1
  Rc[W] = 3
  Qr = R1
  Qc = C1
  DrawSq
  Gx = C1 - 1
  Gx = Gx << 4
  Gx = Gx + 32
  Gy = R1 - 1
  Gy = Gy << 4
  Gy = Gy + 31
  if R2 > R1 then inc R1
  if R2 < R1 then dec R1
  if C2 > C1 then inc C1
  if C2 < C1 then dec C1
  for Fr = 1 to 8
    Frame1
    ' (the pad read while gliding, so a press after it counts as new)
    ReadPad
    V = C1 - 1
    V = V << 4
    V = V + 32
    if V > Gx then Gx = Gx + 2
    if V < Gx then Gx = Gx - 2
    V = R1 - 1
    V = V << 4
    V = V + 31
    if V > Gy then Gy = Gy + 2
    if V < Gy then Gy = Gy - 2
    PieceXY
  next
  goto glide_next
glide_done:
  inc Mv
  ShowMoves
  ShowFrom
  play sound SndLand
  return
end sub

' CheckWin: the listing's sum (line 700): 192 the queen, 158 the bishop
sub CheckWin:
  Sum = 0
  for Qr = 1 to 8
    for Qc = 1 to 8
      W = Qr * 9
      W = W + Qc
      Sum = Sum + Rc[W]
    next
  next
  Won = 0
  if Ch = 1 then
    if Sum = 192 then Won = 1
  else
    if Sum = 158 then Won = 1
  end if
  return
end sub

' ---------------------------------------------------------------------
' the controls

' StickDir: Stk 1 when the stick is pushed; Rep 1 on a new push, then
' again every 6 frames after a pause of 14
sub StickDir:
  Stk = Up1 | Dn1
  Stk = Stk | Lf1
  Stk = Stk | Rt1
  Rep = 0
  if Stk = 0 then
    WasStk = 0
    return
  end if
  if WasStk = 0 then
    Rep = 1
    WasStk = 14
    return
  end if
  dec WasStk
  if WasStk = 0 then
    Rep = 1
    WasStk = 6
  end if
  return
end sub

sub MoveCursor:
  StickDir
  if Rep = 0 then return
  if Up1 = 1 then
    if Kr > 1 then dec Kr
  end if
  if Dn1 = 1 then
    if Kr < 8 then inc Kr
  end if
  if Lf1 = 1 then
    if Kc > 1 then dec Kc
  end if
  if Rt1 = 1 then
    if Kc < 8 then inc Kc
  end if
  play sound SndTick
  return
end sub

' MenuStep: up and down choose, a button picks (the right button: BACK)
sub MenuStep:
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Mi > 0 then dec Mi
    end if
    if Dn1 = 1 then
      if Mi < 2 then inc Mi
    end if
    ShowMenu
    play sound SndTick
  end if
  if Press2 = 1 then Mi = 2
  V = Press | Press2
  if V = 0 then return
  play sound SndPick
  if Mi = 0 then
    Auto = 1
    return
  end if
  if Mi = 1 then
    print at 2,22, "THANKS FOR PLAYING         "
    Ended = 1
    return
  end if
  Mode = 0
  ClearMenu
  return
end sub

' ---------------------------------------------------------------------
' drawing

' DrawSq: the square Qr, Qc (its wood, and a gem if covered; the queen's
' covered start a ring)
sub DrawSq:
  W = Qr * 9
  W = W + Qc
  V = TLt00
  if Rc[W] = 2 then V = TDk00
  K = Qr + Qc
  K = K & 1
  if K = 1 then V = TDk00
  if Rc[W] = 3 then
    V = V + 8
    if Ch = 1 then
      if Qr = Sr then
        if Qc = Sc then V = V + 8
      end if
    end if
  end if
  X = Qc - 1
  X = X << 1
  X = X + 4
  Y = Qr - 1
  Y = Y << 1
  Y = Y + 4
  put char V at X,Y
  inc V
  inc X
  put char V at X,Y
  inc V
  dec X
  inc Y
  put char V at X,Y
  inc V
  inc X
  put char V at X,Y
  return
end sub

' DrawBoard: the frame (columns 3-20, rows 3-20), the letters and numbers,
' the 64 squares
sub DrawBoard:
  put char TFc at 3,3
  put char TFc at 20,3
  put char TFc at 3,20
  put char TFc at 20,20
  for I = 4 to 19
    put char TFh at I,3
    put char TFh at I,20
    put char TFv at 3,I
    put char TFv at 20,I
  next
  for I = 1 to 8
    V = I - 1
    V = V << 1
    V = V + 4
    W = I + 64
    put char W at V,2
    W = I + 48
    put char W at 2,V
  next
  for Qr = 1 to 8
    for Qc = 1 to 8
      DrawSq
    next
  next
  return
end sub

sub DrawPanel:
  if Ch = 1 then
    print at 22,3, "QUEEN'S"
  else
    print at 22,3, "BISHOP'S"
  end if
  print at 22,4, "TOUR"
  print at 22,6, "MOVES"
  ShowMoves
  print at 22,9, "AT"
  print at 22,14, "FIRE:"
  print at 22,15, " MOVE"
  print at 22,16, "RIGHT:"
  print at 22,17, " MENU"
  print at 4,1, "CHESSBOARD TOURS"
  return
end sub

sub ShowMoves:
  NumU = Mv
  print at 22,7, digits$(NumU, 2)
  print at 24,7, "/"
  NumU = Tg
  print at 25,7, digits$(NumU, 2)
  return
end sub

' ShowFrom: the square the piece stands on (as the listing's FROM:)
sub ShowFrom:
  V = R1 + 48
  put char V at 25,9
  V = C1 + 64
  put char V at 26,9
  return
end sub

sub ShowMenu:
  print at 22,11, " SOLVE "
  print at 22,12, " END   "
  print at 22,13, " BACK  "
  V = Mi + 11
  put char 62 at 22,V
  return
end sub

sub ClearMenu:
  print at 22,11, "       "
  print at 22,12, "       "
  print at 22,13, "       "
  return
end sub

' PieceAt: the piece on R1, C1
sub PieceAt:
  Gx = C1 - 1
  Gx = Gx << 4
  Gx = Gx + 32
  Gy = R1 - 1
  Gy = Gy << 4
  Gy = Gy + 31
  PieceXY
  return
end sub

sub PieceXY:
  if Ch = 1 then
    set sprite 1 to Gy,Gx,SQueenl,1
    set sprite 2 to Gy,Gx,SQueen,15
  else
    set sprite 1 to Gy,Gx,SBishopl,1
    set sprite 2 to Gy,Gx,SBishop,15
  end if
  update sprites
  return
end sub

sub Cursor:
  X = Kc - 1
  X = X << 4
  X = X + 32
  Y = Kr - 1
  Y = Y << 4
  Y = Y + 31
  V = Tick & 16
  W = 4
  if V = 0 then W = 13
  set sprite 0 to Y,X,SCursor,W
  update sprites
  return
end sub

sub HideCursor:
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

' ---------------------------------------------------------------------
' screens and the frame

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 3
  for J = 0 to 2
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a little board along a row (the title and credits): 8 squares at row Y
sub BoardRow:
  for I = 0 to 7
    V = I & 1
    V = V << 2
    V = V + TLt00
    X = I << 1
    X = X + 8
    put char V at X,Y
    inc V
    inc X
    put char V at X,Y
    inc V
    dec X
    W = Y + 1
    put char V at X,W
    inc V
    inc X
    put char V at X,W
  next
  return
end sub

sub TitlePage:
  Ph = 0
  NewScreen
  print at 8,2, "CHESSBOARD TOURS"
  Y = 4
  BoardRow
  print at 3,7, "LEAD THE QUEEN OR THE"
  print at 3,8, "BISHOP ON A TOUR OF THE"
  print at 3,9, "CHESSBOARD."
  print at 10,13, "QUEEN'S TOUR"
  print at 10,14, "BISHOP'S TOUR"
  print at 10,15, "HOW TO PLAY"
  print at 10,16, "CREDITS"
  Menu = 0
  ShowTitleMenu
  set sprite 1 to 103,200,SQueenl,1
  set sprite 2 to 103,200,SQueen,15
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStk = 1
tp_loop:
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 3 then inc Menu
    end if
    ShowTitleMenu
    play sound SndTick
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowTitleMenu:
  for K = 13 to 16
    put char 32 at 8,K
  next
  V = Menu + 13
  put char 62 at 8,V
  return
end sub

' RulesPage: the listing's introduction (lines 900-950)
sub RulesPage:
  Ph = 0
  NewScreen
  print at 8,1, "CHESSBOARD TOURS"
  print at 2,3, "THE QUEEN MAY MOVE PARALLEL"
  print at 2,4, "TO THE SIDES OF THE BOARD OR"
  print at 2,5, "DIAGONALLY FOR ANY NUMBER OF"
  print at 2,6, "SQUARES. SHE MUST FINISH ON"
  print at 2,7, "THE SQUARE WHERE SHE STARTED."
  print at 2,8, "VISIT ALL SQUARES: 14 MOVES."
  print at 2,10, "THE BISHOP MUST VISIT ALL THE"
  print at 2,11, "WHITE SQUARES IN 17 MOVES. HE"
  print at 2,12, "MOVES DIAGONALLY AND MAY"
  print at 2,13, "BEGIN AND END ON DIFFERENT"
  print at 2,14, "SQUARES, NEVER ON A COVERED"
  print at 2,15, "ONE."
  print at 2,17, "FIRE: PLACE, THEN MOVE TO THE"
  print at 2,18, "CURSOR. RIGHT BUTTON: SOLVE,"
  print at 2,19, "END OR BACK."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen
  Y = 1
  BoardRow
  print at 3,4, "BASED ON QUEEN'S AND"
  print at 3,5, "BISHOP'S TOURS BY DANIEL L."
  print at 3,6, "MILLER, AHOY! JUNE 1986"
  print at 3,7, "(COMMODORE 128)."
  print at 3,9, "MADE FOR THE COLECOVISION"
  print at 3,10, "BY CLAUDE (AN AI MADE BY"
  print at 3,11, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,12, "2026, IN AMY BY AMY"
  print at 3,13, "BIENVENU."
  print at 3,15, "MUSIC: GRAND TOUR,"
  print at 3,16, "LONG DIAGONAL"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  return
end sub

