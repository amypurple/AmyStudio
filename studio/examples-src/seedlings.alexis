data LvInfo bytes
  8,6,3,0,0,5,6
  10,7,0,2,0,16,13
  10,8,0,0,2,5,14
  10,7,0,1,2,5,14
  10,8,3,0,0,5,5
  10,7,2,1,0,16,10
  10,7,0,0,3,5,15
  12,8,2,1,2,11,6
end data
data LvNames bytes
  68,79,87,78,32,87,69,32,71,79,32,32,32,32
  72,79,76,68,32,84,72,69,32,76,73,78,69,32
  83,84,69,80,32,85,80,32,32,32,32,32,32,32
  87,69,84,32,70,69,69,84,32,32,32,32,32,32
  68,73,71,32,68,69,69,80,32,32,32,32,32,32
  84,87,79,32,87,65,89,83,32,32,32,32,32,32
  85,80,83,84,65,73,82,83,32,32,32,32,32,32
  71,82,65,78,68,32,84,79,85,82,32,32,32,32
end data
const NLevels = 8
data TitleXY bytes
  8,2,9,2,10,2,8,3,8,4,9,4,10,4,10,5,8,6,9,6,10,6,12,2,13,2,14,2,12,3,12,4,13,4,12,5,12,6,13,6,14,6,16,2,17,2,18,2,16,3,16,4,17,4,16,5,16,6,17,6,18,6,20,2,21,2,20,3,22,3,20,4,22,4,20,5,22,5,20,6,21,6,6,8,6,9,6,10,6,11,6,12,7,12,8,12,10,8,11,8,12,8,11,9,11,10,11,11,10,12,11,12,12,12,14,8,16,8,14,9,15,9,16,9,14,10,15,10,16,10,14,11,15,11,16,11,14,12,16,12,18,8,19,8,20,8,18,9,18,10,20,10,18,11,20,11,18,12,19,12,20,12,22,8,23,8,24,8,22,9,22,10,23,10,24,10,24,11,22,12,23,12,24,12,255
end data

' the seedlings (WS 0 = a free place, 1 walk, 2 fall, 3 dig, 4 stop,
' 5 step, 6 home, 7 gone)
u8 WX[12]
u8 WY[12]
u8 WD[12]
u8 WS[12]
u8 WT[12]
u8 WF[12]
u8 WN[12]
u8 WC[12]
u8 WP[12]

' the garden cell seed.asm reads or writes
u8 Tx = 0
u8 Ty = 0
u8 Tt = 0
u16 MapP = 0

u8 Lv = 0
u8 Reached = 0
u8 NLeft = 0
u8 NOut = 0
u8 NHome = 0
u8 Need = 0
u8 Cnt[3]
u8 Sel = 0
u8 SpT = 0
u8 Hx = 0
u8 Hy = 0
u8 TimeS = 0
u8 TimeF = 0
u8 HudOn = 0
u8 Active = 0
u8 Redo = 0
u8 CurX = 0
u8 CurY = 0
u8 MoveT = 0
u8 Over = 0
u8 WasStick = 0

u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Busy = 0

' scratch: never kept across a sub call
u16 W16 = 0
u8 I = 0
u8 J = 0
u8 C = 0
u8 K = 0
u8 S = 0
u8 T = 0
u8 V = 0
u8 V2 = 0
u8 N = 0
u8 X = 0
u8 Y = 0
u8 D = 0
u8 Col = 0
u8 Row = 0
u8 Gx = 0
u8 Gy = 0
u8 Sd = 0
u8 Hit = 0
u8 Ok = 0
u8 Sp = 0
u8 Par = 0
u8 Rot = 0
u8 Na = 0
u8 Q = 0
u8 Ord[12]

  tile screen
  set sound table SdSoundTable areas 4
  sprites 8x8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage
  Reached = 0

title:
  TitlePage
  if Sel = 1 then
    HowToPage
    goto title
  end if
  if Sel = 2 then
    CreditsPage
    goto title
  end if

lv_start:
  IntroPage
  StartLevel

play_loop:
  Frame1
  Busy = 1
  ReadPad
  Controls
  if Redo = 2 then goto lv_over
  if Redo = 1 then
    play sound SndNo
    goto lv_start
  end if
  Spawn
  Par = Tick & 1
  for I = 0 to 11
    V = I & 1
    if V = Par then Step1
  next
  ShowSprites
  inc TimeF
  if TimeF >= 60 then
    TimeF = 0
    dec TimeS
    HudOn = 1
  end if
  if HudOn = 1 then
    HudOn = 0
    ShowHud
  end if
  Busy = 0
  if TimeS = 0 then goto lv_over
  if NLeft > 0 then goto play_loop
  if Active > 0 then goto play_loop

lv_over:
  HideSprites
  fill 32 count 28 at 2,21
  if NHome >= Need then
    play sound SndWin
    print at 6,21, "WELL DONE, GARDENER!"
    ShowHud
    Hold(150)
    inc Lv
    if Lv > Reached then Reached = Lv
    if Lv < NLevels then goto lv_start
    Lv = NLevels - 1
    EndPage
    goto title
  end if
  play sound SndLose
  if TimeS = 0 then
    print at 9,21, "OUT OF TIME!"
  else
    print at 5,21, "NOT ENOUGH GOT HOME!"
  end if
  Hold(150)
  goto lv_start

' ---------------------------------------------------------------------------
' the garden

sub StartLevel:
  NewScreen
  backdrop dark blue
  W16 = Lv * 532
  MapP = W16
  asm {
    call LmDraw
  }
  V = Lv * 7
  NLeft = LvInfo[V]
  Need = LvInfo[V + 1]
  Cnt[0] = LvInfo[V + 2]
  Cnt[1] = LvInfo[V + 3]
  Cnt[2] = LvInfo[V + 4]
  Hx = LvInfo[V + 5]
  Hy = LvInfo[V + 6]
  NOut = 0
  NHome = 0
  Sel = 0
  SpT = 60
  TimeS = 180
  TimeF = 0
  Redo = 0
  Active = 0
  MoveT = 0
  CurX = 120
  CurY = 96
  for I = 0 to 11
    WS[I] = 0
  next
  ShowHud
  ShowBar
  ShowScreen
  WaitStick
  return
end sub

' GetT: the tile at Tx, Ty (Tt); PutT: Tt there
sub GetT:
  asm {
    call LmGet
  }
  return
end sub

sub PutT:
  asm {
    call LmPut
  }
  return
end sub

' Solid: does Tt hold a seedling up? (Sd)
sub Solid:
  Sd = 0
  if Tt >= TDirt then
    if Tt <= TRock then Sd = 1
  end if
  return
end sub

' BlockAt: is a stopper standing on cell Gx, Gy? (Hit)
sub BlockAt:
  Hit = 0
  for J = 0 to 11
    if WS[J] = 4 then
      V = WX[J] >> 3
      if V = Gx then
        V = WY[J] >> 3
        if V = Gy then Hit = 1
      end if
    end if
  next
  return
end sub

sub Spawn:
  if NLeft = 0 then return
  if SpT > 0 then
    dec SpT
    return
  end if
  N = 255
  for J = 0 to 11
    if N = 255 then
      if WS[J] = 0 then N = J
    end if
  next
  if N = 255 then
    SpT = 10
    return
  end if
  WS[N] = 2
  WX[N] = Hx * 8
  WY[N] = Hy * 8
  WD[N] = 0
  WF[N] = 0
  WT[N] = 0
  WC[N] = 0
  WP[N] = 0
  dec NLeft
  inc NOut
  HudOn = 1
  SpT = 75
  play sound SndPop
  return
end sub

' ---------------------------------------------------------------------------
' the seedlings: Step1 moves seedling I on (every second frame)

sub Step1:
  S = WS[I]
  if S = 0 then return
  if S >= 6 then
    T = WT[I] + 1
    WT[I] = T
    if T >= 16 then WS[I] = 0
    return
  end if
  X = WX[I]
  Y = WY[I]
  D = WD[I]
  if S = 2 then
    Y = Y + 4
    WY[I] = Y
    if WF[I] < 200 then WF[I] = WF[I] + 4
    V = Y & 7
    if V <> 0 then return
    Col = X >> 3
    Row = Y >> 3
    if Row >= 21 then
      Gone
      return
    end if
    Tx = Col
    Ty = Row
    GetT
    if Tt >= TWater then
      if Tt <= TWaterd then
        Gone
        return
      end if
    end if
    Ty = Row + 1
    GetT
    Solid
    if Sd = 0 then return
    if WF[I] > 48 then
      Gone
      return
    end if
    WS[I] = 1
    return
  end if
  if S = 4 then
    if WP[I] = 0 then return
    S = 1
    WS[I] = 1
  end if
  V = X & 7
  if V <> 0 then
    Move
    return
  end if
  WC[I] = 0
  Col = X >> 3
  Row = Y >> 3
  ' inside a brick laid on top of it: up on to it
  Tx = Col
  Ty = Row
  GetT
  Solid
  if Sd = 1 then
    WY[I] = Y - 8
    return
  end if
  ' home?
  if Tt >= TDoor00 then
    if Tt <= TDoor11 then
      WS[I] = 6
      WT[I] = 0
      inc NHome
      HudOn = 1
      play sound SndHome
      return
    end if
  end if
  ' nothing underfoot: down it goes
  Ty = Row + 1
  GetT
  Solid
  if Sd = 0 then
    WS[I] = 2
    WF[I] = 0
    return
  end if
  ' a new job, given on the way, starts on a whole cell
  V = WP[I]
  if V > 0 then
    WP[I] = 0
    S = V + 2
    if V = 2 then S = 4
    if V = 1 then S = 3
    if V = 3 then
      S = 5
      WN[I] = 5
    end if
    WS[I] = S
    WT[I] = 0
    if S = 4 then return
  end if
  if S = 3 then
    ' dig: a cell every 12 steps, earth and bricks but not rock
    T = WT[I] + 1
    WT[I] = T
    if T < 12 then return
    WT[I] = 0
    if Tt <= TBrick then
      Tt = 32
      PutT
      WY[I] = Y + 8
      play sound SndDig
    else
      WS[I] = 1
    end if
    return
  end if
  Gx = Col + 1
  if D = 1 then Gx = Col - 1
  Gy = Row
  if S = 5 then
    ' step: a brick ahead at the feet, then up on to it
    if WT[I] > 0 then
      T = WT[I] - 1
      WT[I] = T
      return
    end if
    Ok = 0
    if WN[I] > 0 then
      Tx = Gx
      Ty = Row
      GetT
      if Tt = 32 then
        Ty = Row - 1
        GetT
        Solid
        if Sd = 0 then
          Tx = Col
          GetT
          Solid
          if Sd = 0 then
            BlockAt
            if Hit = 0 then Ok = 1
          end if
        end if
      end if
    end if
    if Ok = 1 then
      Tx = Gx
      Ty = Row
      Tt = TBrick
      PutT
      T = WN[I] - 1
      WN[I] = T
      WC[I] = 1
      WT[I] = 6
      play sound SndBrick
      Move
      return
    end if
    WS[I] = 1
  end if
  ' walk: turn at a stopper or a wall, climb a single step
  BlockAt
  if Hit = 1 then
    Turn
    return
  end if
  Tx = Gx
  Ty = Row
  GetT
  Solid
  if Sd = 1 then
    Ty = Row - 1
    GetT
    Solid
    if Sd = 0 then
      Tx = Col
      GetT
      Solid
      if Sd = 0 then
        WC[I] = 1
        Move
        return
      end if
    end if
    Turn
    return
  end if
  Move
  return
end sub

sub Move:
  if D = 0 then
    inc X
  else
    dec X
  end if
  WX[I] = X
  if WC[I] = 1 then
    dec Y
    WY[I] = Y
  end if
  return
end sub

sub Turn:
  if D = 0 then
    WD[I] = 1
  else
    WD[I] = 0
  end if
  return
end sub

sub Gone:
  WS[I] = 7
  WT[I] = 0
  play sound SndSplat
  return
end sub

' ---------------------------------------------------------------------------
' the player

sub Controls:
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 0 then
    MoveT = 0
  else
    if MoveT < 40 then inc MoveT
    Sp = 1
    if MoveT > 10 then Sp = 2
    if MoveT > 30 then Sp = 3
    if Lf1 = 1 then
      if CurX >= Sp then
        CurX = CurX - Sp
      else
        CurX = 0
      end if
    end if
    if Rt1 = 1 then
      CurX = CurX + Sp
      if CurX > 244 then CurX = 244
    end if
    if Up1 = 1 then
      V = Sp + 8
      if CurY >= V then
        CurY = CurY - Sp
      else
        CurY = 8
      end if
    end if
    if Dn1 = 1 then
      CurY = CurY + Sp
      if CurY > 176 then CurY = 176
    end if
  end if
  FindOver
  if Press = 0 then return
  if CurY >= 170 then
    ' the jobs row
    Gx = CurX + 3
    Gx = Gx >> 3
    V = 3
    if Gx < 24 then V = 2
    if Gx < 17 then V = 1
    if Gx < 9 then V = 0
    if V = 3 then
      Redo = 1
      if NLeft = 0 then
        if NHome >= Need then Redo = 2
      end if
      return
    end if
    Sel = V
    ShowBar
    play sound SndTick
    return
  end if
  if Over = 255 then return
  K = Sel
  if Cnt[K] = 0 then
    play sound SndNo
    return
  end if
  S = WS[Over]
  Ok = 0
  if WP[Over] = 0 then
    if K = 0 then
      if S = 1 then Ok = 1
      if S = 4 then Ok = 1
      if S = 5 then Ok = 1
    end if
    if K = 1 then
      if S = 1 then Ok = 1
      if S = 3 then Ok = 1
      if S = 5 then Ok = 1
    end if
    if K = 2 then
      if S = 1 then Ok = 1
      if S = 3 then Ok = 1
      if S = 4 then Ok = 1
    end if
  end if
  if Ok = 0 then
    play sound SndNo
    return
  end if
  WP[Over] = K + 1
  V = Cnt[K] - 1
  Cnt[K] = V
  ShowBar
  play sound SndPick
  return
end sub

' FindOver: the seedling under the pointer that can take a job (Over,
' 255 for none)
sub FindOver:
  Over = 255
  for J = 0 to 11
    S = WS[J]
    if S <> 0 then
      if S <> 2 then
        if S < 6 then
          V = WX[J] - CurX
          V = V + 5
          if V < 11 then
            V = WY[J] - CurY
            V = V + 5
            if V < 11 then Over = J
          end if
        end if
      end if
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the screen

sub ShowSprites:
  ' the pointer: yellow over a seedling it can reach
  V = 15
  if Over <> 255 then V = 11
  Y = CurY - 1
  set sprite 0 to Y,CurX,SCursor,V
  ' the seedlings take turns at the sprite places, a step each frame: when
  ' more than four share a line, each is hidden only now and then
  Na = 0
  Active = 0
  for C = 0 to 11
    S = WS[C]
    if S <> 0 then
      Ord[Na] = C
      inc Na
      if S <> 4 then inc Active
    end if
  next
  inc Rot
  if Rot >= Na then Rot = 0
  for Q = 0 to 11
    N = Q + 1
    if Q >= Na then
      set sprite N to 192,0,0,0
    else
      C = Q + Rot
      if C >= Na then C = C - Na
      C = Ord[C]
      S = WS[C]
      V2 = 3
      if WP[C] > 0 then V2 = 11
      if S = 1 then
        V = SWalkR1
        if WD[C] = 1 then V = SWalkL1
        T = WX[C] & 4
        if T > 0 then V = V + 4
      end if
      if S = 2 then V = SFall
      if S = 3 then
        V = SDig1
        T = WT[C] & 4
        if T > 0 then V = SDig2
      end if
      if S = 4 then
        V = SBlock1
        T = Tick & 16
        if T > 0 then V = SBlock2
        V2 = 9
      end if
      if S = 5 then
        V = SBuildR
        if WD[C] = 1 then V = SBuildL
        V2 = 9
      end if
      if S = 6 then
        V = SHome1
        T = WT[C] & 4
        if T > 0 then V = SHome2
        V2 = 11
      end if
      if S = 7 then
        V = SPuff
        V2 = 15
      end if
      Y = WY[C] - 1
      X = WX[C]
      set sprite N to Y,X,V,V2
    end if
  next
  update sprites
  return
end sub

' ShowRedo: REDO, or DONE once enough are home and none are left to come
sub ShowRedo:
  V = 0
  if NLeft = 0 then
    if NHome >= Need then V = 1
  end if
  if V = 0 then
    print at 25,22, "REDO"
  else
    print at 25,22, "DONE"
  end if
  return
end sub

sub ShowHud:
  ShowRedo
  print at 2,1, "OUT"
  print at 6,1, digits$(NOut, 2)
  print at 9,1, "HOME"
  print at 14,1, digits$(NHome, 2)
  print at 17,1, "NEED"
  print at 22,1, digits$(Need, 2)
  V = TimeS / 60
  print at 25,1, digits$(V, 1)
  put char 58 at 26,1
  V2 = V * 60
  V = TimeS - V2
  print at 27,1, digits$(V, 2)
  return
end sub

sub ShowBar:
  fill 32 count 28 at 2,22
  print at 3,22, "DIG"
  print at 7,22, digits$(Cnt[0], 1)
  print at 10,22, "STOP"
  print at 15,22, digits$(Cnt[1], 1)
  print at 18,22, "STEP"
  print at 23,22, digits$(Cnt[2], 1)
  ShowRedo
  V = 2
  if Sel = 1 then V = 9
  if Sel = 2 then V = 17
  put char 62 at V,22
  return
end sub

' ---------------------------------------------------------------------------
' the pages

sub TitlePage:
  NewScreen
  backdrop dark blue
  I = 0
tp_xy:
  X = TitleXY[I]
  if X <> 255 then
    Y = TitleXY[I + 1]
    put char TLeaf at X,Y
    I = I + 2
    goto tp_xy
  end if
  print at 4,16, "BRING THE SEEDLINGS HOME"
  ' a strip of garden
  for X = 2 to 29
    put char TGrass at X,14
  next
  put char TDoor00 at 25,12
  put char TDoor01 at 26,12
  put char TDoor10 at 25,13
  put char TDoor11 at 26,13
  Sel = 0
  if Reached > 0 then Lv = Reached
  if Reached = 0 then Lv = 0
  ShowTitleMenu
  print at 5,22, "AN ORIGINAL GAME, 2026"
  ShowScreen
  play song SdSong once
  WaitStick
  X = 8
tp_loop:
  Frame1
  ReadPad
  ' a seedling walks to the door
  inc X
  if X > 196 then X = 8
  V = SWalkR1
  T = X & 4
  if T > 0 then V = SWalkR2
  set sprite 1 to 103,X,V,3
  update sprites
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      if Sel = 0 then
        if Lf1 = 1 then
          if Lv > 0 then dec Lv
        end if
        if Rt1 = 1 then
          if Lv < Reached then inc Lv
        end if
      end if
      play sound SndTick
      ShowTitleMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop song
  mute all
  play sound SndPick
  return
end sub

sub ShowTitleMenu:
  fill 32 count 20 at 8,18
  print at 10,18, "PLAY GARDEN"
  V = Lv + 1
  print at 22,18, digits$(V, 1)
  if Reached > 0 then
    if Lv > 0 then put char 60 at 21,18
    if Lv < Reached then put char 62 at 23,18
  end if
  print at 10,19, "HOW TO PLAY"
  print at 10,20, "CREDITS"
  for Y = 18 to 20
    put char 32 at 8,Y
  next
  Y = Sel + 18
  put char 62 at 8,Y
  return
end sub

sub IntroPage:
  TextPage
  V = Lv + 1
  print at 10,4, "GARDEN"
  print at 17,4, digits$(V, 1)
  print at 19,4, "OF 8"
  W16 = Lv * 14
  for V = 0 to 13
    V2 = LvNames[W16]
    X = V + 9
    put char V2 at X,7
    inc W16
  next
  V = Lv * 7
  print at 5,10, "SEEDLINGS"
  print at 21,10, digits$(LvInfo[V], 2)
  print at 5,11, "BRING HOME"
  print at 21,11, digits$(LvInfo[V + 1], 2)
  print at 5,14, "DIG"
  print at 10,14, digits$(LvInfo[V + 2], 1)
  print at 13,14, "STOP"
  print at 18,14, digits$(LvInfo[V + 3], 1)
  print at 21,14, "STEP"
  print at 26,14, digits$(LvInfo[V + 4], 1)
  print at 8,20, "PRESS THE BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub HowToPage:
  TextPage
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "SEEDLINGS WALK STRAIGHT ON."
  print at 2,4, "THEY TURN AT WALLS, CLIMB A"
  print at 2,5, "SINGLE STEP, AND FALL DOWN"
  print at 2,6, "HOLES. WATER AND BIG FALLS"
  print at 2,7, "ARE THE END OF THEM."
  print at 2,9, "BRING ENOUGH TO THE DOOR!"
  print at 2,11, "STICK: MOVE THE POINTER."
  print at 2,12, "BUTTON ON A JOB BELOW: PICK"
  print at 2,13, "IT. BUTTON ON A SEEDLING:"
  print at 2,14, "GIVE IT THE JOB."
  print at 2,16, "DIG: DIGS DOWN, NOT IN ROCK."
  print at 2,17, "STOP: STANDS, TURNS OTHERS."
  print at 2,18, "STEP: LAYS 5 BRICK STAIRS."
  print at 2,19, "A STOPPER CAN DIG OR STEP."
  print at 2,21, "REDO: TRY THE GARDEN AGAIN."
  ShowScreen
  WaitPress
  return
end sub

sub CreditsPage:
  TextPage
  print at 11,2, "SEEDLINGS"
  print at 2,4, "AN ORIGINAL GAME FOR THE"
  print at 2,5, "COLECOVISION."
  print at 2,7, "DESIGN, PROGRAM, GRAPHICS,"
  print at 2,8, "SOUNDS AND THE TUNE"
  print at 2,9, "SPROUT SONG:"
  print at 2,10, "CLAUDE (AN AI BY ANTHROPIC)"
  print at 2,13, "MADE WITH AMY STUDIO"
  print at 2,14, "BY AMY BIENVENU"
  print at 2,17, "(C) 2026"
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

sub EndPage:
  TextPage
  print at 4,6, "EVERY GARDEN IS GREEN!"
  print at 3,9, "THE SEEDLINGS GREW INTO"
  print at 3,10, "A MEADOW OF FLOWERS."
  print at 3,13, "THANK YOU, GARDENER."
  print at 7,21, "PRESS A BUTTON"
  ShowScreen
  Hold(60)
  WaitPress
  return
end sub

sub TextPage:
  NewScreen
  fill mode 2 text color with $10
  backdrop white
  cls
  return
end sub

' ---------------------------------------------------------------------------
' the machine

sub Rearm:
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Hold(u8 Frames):
  for C = 1 to Frames
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' WaitStick: until the button is let go (so a press is a new one)
sub WaitStick:
  WasBtn = 1
  WasStick = 1
  return
end sub

sub WaitPress:
  WaitStick
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  play sound SndTick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 13
  sprites flicker off
  for C = 0 to 12
    set sprite C to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

