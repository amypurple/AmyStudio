asm {
; SEEDLINGS: the garden lives in the name table ($1800): each cell's tile
; is read and written there, so the map needs no RAM.

; LmAddr: HL = the name table address of column Tx, row Ty
LmAddr:
    ld a,(AMY_UVAR_Ty)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Tx)
    or l
    ld l,a
    ld de,$1800
    add hl,de
    ret

; LmGet: Tt = the tile at Tx, Ty
LmGet:
    call LmAddr
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    nop
    nop
    in a,($BE)
    ld (AMY_UVAR_Tt),a
    ret

; LmPut: the tile Tt at Tx, Ty
LmPut:
    call LmAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Tt)
    out ($BE),a
    ret

; LmDraw: the garden at LvMap + MapP (28 x 19 tiles) on to rows 2-20,
; columns 2-29
LmDraw:
    ld hl,(AMY_UVAR_MapP)
    ld de,AMY_UDATA_LvMap
    add hl,de
    ld de,$1800+64+2
    ld c,19
LmDr1:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld b,28
LmDr2:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz LmDr2
    ex de,hl
    ld a,c
    ld bc,32
    add hl,bc
    ld c,a
    ex de,hl
    dec c
    jr nz,LmDr1
    ret

SdHush:
    db $00,$00,$F4,$01,$10
SdTick:
    db $40,$40,$50,$01,$50
SdPick:
    db $40,$55,$20,$02,$40,$40,$30,$03,$50
SdNo:
    db $40,$F9,$22,$04,$40,$F9,$33,$06,$50
SdPop:
    db $80,$7F,$40,$02,$80,$5F,$50,$02,$90
SdDig:
    db $00,$00,$25,$02,$00,$00,$46,$03,$10
SdBrick:
    db $80,$D6,$20,$02,$80,$1D,$41,$03,$90
SdHome:
    db $40,$6B,$20,$03,$40,$55,$20,$03,$40,$47,$30,$06,$50
SdSplat:
    db $C0,$FC,$21,$04,$C0,$F9,$32,$06,$C0,$F9,$53,$06,$D0
SdWin:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$30,$10,$50
SdLose:
    db $40,$1D,$21,$08,$40,$53,$31,$08,$40,$AB,$41,$08,$40,$3B,$52,$14,$50

SdSoundTable:
    dw SdHush,$702B
    dw SdTick,$7035
    dw SdPick,$7035
    dw SdNo,$7035
    dw SdPop,$703F
    dw SdDig,$702B
    dw SdBrick,$703F
    dw SdHome,$7035
    dw SdSplat,$7049
    dw SdWin,$7035
    dw SdLose,$7035
    dw SdTuneMel,$703F
    dw SdTuneBass,$7049
; Sprout Song, G major (original for this game)
; Tiny Sound, 8 frames per step
SdTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1A,$1E,$21,$00,$1E,$21,$26,$00,$25,$23,$21,$00
    db $1F,$23,$26,$00,$23,$1F,$1E,$00,$1C,$1E,$1F,$00,$21,$23,$25,$00
    db $26,$28,$2A,$00,$28,$26,$25,$23,$21,$1E,$1C,$19,$9A,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
SdTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$60,$18,$32,$0E,$00,$15,$00,$0E,$00,$15,$00,$0E,$00,$12,$00
    db $13,$00,$0E,$00,$13,$00,$0E,$00,$15,$00,$19,$00,$12,$00,$15,$00
    db $17,$00,$0E,$00,$13,$00,$10,$00,$15,$00,$15,$00,$0E,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
; the title song: both voices of Sprout Song at once
SdSong:
    dw $0001
    db $40+12,13
    dw $0000
}
