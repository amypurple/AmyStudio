  131,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,131,32,32,32,32,32,131
  131,32,32,32,32,32,32,32,32,32,32,32,32,32,131,32,32,32,138,139,32,131,32,32,32,32,32,131
