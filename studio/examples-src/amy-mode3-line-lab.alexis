cartridge "M3 LINE BOX LAB/AMY/2026"

' Self-checking line and box lab for Mode 3 multicolor.
' All pget readbacks happen before the mode switch so they compile in multicolor context.
' T1: dy=0 line routes to hline — verify start, mid, end of span.
' T2: degenerate x1=x2 — single pixel pset.
' T3: 45-degree line — both endpoints.
' T4: steep line — start and end.
' T5: off-screen endpoint — on-screen start and last on-screen pixel.
' T6: box fill — near corner, interior, far corner.

u8 T1a = 0, T1b = 0, T1c = 0
u8 T2 = 0
u8 T3a = 0, T3b = 0
u8 T4a = 0, T4b = 0
u8 T5a = 0, T5b = 0
u8 T6a = 0, T6b = 0, T6c = 0

  multicolor screen
  cls

  ' T1: horizontal line — dy=0 dispatches to hline
  line 10,8 to 20,8 color $A
  ' T2: degenerate single-pixel',
  line 25,15 to 25,15 color $B
  ' T3: 45-degree diagonal
  line 0,0 to 7,7 color $C
  ' T4: steep line (dy > dx)
  line 4,5 to 6,15 color $3
  ' T5: off-screen right endpoint — on-screen pixels still drawn.
  ' x=64..75 are clipped by AMY_MODE3_PSET; visible segment is x=55..63.',
  line 55,20 to 75,25 color $2
  ' T6: filled box
  box 40,30 to 50,40 color $5

  ' Read back all results while still in multicolor mode
  T1a = pget 10,8
  T1b = pget 15,8
  T1c = pget 20,8
  T2 = pget 25,15
  T3a = pget 0,0
  T3b = pget 7,7
  T4a = pget 4,5
  T4b = pget 6,15
  T5a = pget 55,20
  T5b = pget 63,22
  T6a = pget 40,30
  T6b = pget 45,35
  T6c = pget 50,40

  text screen
  print at 1,0, "MODE3 LINE/BOX LAB"

  if T1a = $A then
    print at 1,2, "T1a dy=0 start  PASS"
  else
    print at 1,2, "T1a dy=0 start  FAIL"
  end if
  if T1b = $A then
    print at 1,3, "T1b dy=0 mid    PASS"
  else
    print at 1,3, "T1b dy=0 mid    FAIL"
  end if
  if T1c = $A then
    print at 1,4, "T1c dy=0 end    PASS"
  else
    print at 1,4, "T1c dy=0 end    FAIL"
  end if
  if T2 = $B then
    print at 1,5, "T2 x1=x2 pset  PASS"
  else
    print at 1,5, "T2 x1=x2 pset  FAIL"
  end if
  if T3a = $C then
    print at 1,6, "T3a 45deg (0,0) PASS"
  else
    print at 1,6, "T3a 45deg (0,0) FAIL"
  end if
  if T3b = $C then
    print at 1,7, "T3b 45deg (7,7) PASS"
  else
    print at 1,7, "T3b 45deg (7,7) FAIL"
  end if
  if T4a = $3 then
    print at 1,8, "T4a steep start PASS"
  else
    print at 1,8, "T4a steep start FAIL"
  end if
  if T4b = $3 then
    print at 1,9, "T4b steep end   PASS"
  else
    print at 1,9, "T4b steep end   FAIL"
  end if
  if T5a = $2 then
    print at 1,10, "T5a offscr on   PASS"
  else
    print at 1,10, "T5a offscr on   FAIL"
  end if
  if T5b = $2 then
    print at 1,11, "T5b offscr edge PASS"
  else
    print at 1,11, "T5b offscr edge FAIL"
  end if
  if T6a = $5 then
    print at 1,12, "T6a box corner  PASS"
  else
    print at 1,12, "T6a box corner  FAIL"
  end if
  if T6b = $5 then
    print at 1,13, "T6b box interior PASS"
  else
    print at 1,13, "T6b box interior FAIL"
  end if
  if T6c = $5 then
    print at 1,14, "T6c box far cor PASS"
  else
    print at 1,14, "T6c box far cor FAIL"
  end if
  screen on
main:
  goto main