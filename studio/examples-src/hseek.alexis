  $80,$80,$80,$80,$80,$80,$80,$80,$90,$80,$90,$81,$90,$80,$80,$80,$90,$80,$90,$80,$80,$90,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$80,$80,$80,$90,$80,$90,$80,$90,$90,$90,$80,$90,$80,$90,$80,$80,$90,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$81,$80,$80,$80,$80,$80,$80,$80,$81,$80,$80,$80,$80,$80,$80,$80,$82,$80,$80,$80,$80,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$90,$90,$90,$80,$90,$90,$90,$80,$90,$90,$90,$80,$90,$80,$90,$80,$90,$90,$90,$80,$90,$90,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$90,$80,$82,$80,$90,$80,$80,$80,$90,$80,$80,$80,$90,$80,$90,$81,$90,$80,$80,$80,$90,$80,$90,$80,$80,$81,$80,$80
  $80,$80,$80,$80,$90,$90,$90,$80,$90,$90,$80,$80,$90,$90,$80,$80,$90,$90,$80,$80,$90,$90,$80,$80,$90,$90,$80,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$80,$81,$90,$80,$90,$80,$80,$80,$90,$80,$80,$80,$90,$80,$90,$80,$90,$80,$80,$82,$90,$80,$90,$80,$80,$80,$80,$80
  $80,$80,$80,$80,$90,$90,$90,$80,$90,$90,$90,$80,$90,$90,$90,$80,$90,$80,$90,$80,$90,$90,$90,$80,$90,$80,$90,$80,$80,$80,$80,$80
end data

data PadCol bytes 2,4,8,10,14,16,20,22,26,28

record Obj:
  u16 X
  u16 Y
  i16 Vx
  i16 Vy
  u8 Act
  u8 Life
end record

' 0 the jet, 1 the missile, 2-7 the shots
Obj O[8]
u8 Pads[10]
u16 Sc[2]
u8 Ships[2]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 PA = 0
u16 MA = 0
u16 PTurn = 0
u16 MTurn = 0
u16 MTurnMax = 0
u16 Steps = 0
u16 Surv = 0
u16 Flight = 0
u16 Fuel = 0
u16 FuelT = 0
u8 Slow = 0
u8 SlowT = 0
u8 Fizz = 0
u16 NumU = 0
u16 W16 = 0
i16 Dx = 0
i16 Dy = 0
i16 Cr = 0
u8 PSpd = 0
u8 MSpd = 0
u8 Skill = 0
u8 NPl = 1
u8 Cur = 0
u8 MState = 0
u8 Cool = 0
u8 Crash = 0
u8 Freeze = 0
u8 Cleared = 0
u8 Over = 0
u8 BoomT = 0
u8 BoomX = 0
u8 BoomY = 0
u8 PadsLeft = 0
u8 Shots = 0
u8 Kills = 0
u8 Lures = 0
u8 Clears = 0
u16 Lived = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Wt = 0
' loop counters (never shared with the helpers)
u8 Ob = 0
u8 Pk = 0
u8 Ds = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table HsSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame
  Wt = 2

round_loop:
  RoundStart
  if Over = 1 then goto game_over

play_loop:
  Frame1
  ReadPad
  DoStep
  DrawSprites
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then goto round_end
  end if
  goto play_loop

round_end:
  ' the base cleared: 1000 points and the ship back
  if Cleared = 1 then inc Ships[Cur]
  goto round_loop

game_over:
  Wt = 3
  print at 9,9,  "            "
  print at 9,10, " GAME  OVER "
  print at 9,11, "            "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a new round: the next player with ships left, full pads, the jet at the
' upper left heading right, the missile counting to its launch
sub RoundStart:
  if NPl = 2 then Cur = 1 - Cur
  if Ships[Cur] = 0 then
    Cur = 1 - Cur
    if Ships[Cur] = 0 then
      Over = 1
      return
    end if
  end if
  dec Ships[Cur]
  fill array Pads with 1
  PadsLeft = 10
  for Ob = 0 to 7
    O[Ob].Act = 0
    O[Ob].Life = 0
    O[Ob].Vx = 0
    O[Ob].Vy = 0
  next
  O[0].Act = 1
  O[0].X = 40 * 256
  O[0].Y = 40 * 256
  PA = 0
  SetVel(0, 0, PSpd)
  MState = 0
  Slow = 0
  Cool = CoolT
  Crash = 0
  Freeze = 0
  Cleared = 0
  BoomT = 0
  DrawPads
  ShowHud
  NumU = Cur + 1
  print at 9,9, "PLAYER ", digits$(NumU, 1)
  print at 9,10, "GET READY"
  DrawSprites
  play sound SndStart
  Wt = 1
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  Wt = 2
  print at 9,9, "         "
  print at 9,10, "         "
  return
end sub

' the velocity of object N for heading A (0-255, 0 = right, clockwise):
' the C64's vector of length 85 times the speed factor F (in quarters:
' the game runs at 3/4 of the C64's step speed, see Liberties)
sub SetVel(u8 N, u8 A, u8 F):
  i8 Cs = 0
  i8 Sn = 0
  u8 A2 = 0
  i16 T = 0
  u16 U = 0
  Cs = CosT[A]
  A2 = A - 64
  Sn = CosT[A2]
  ' divided by 4 rounding down, by a shift of the value lifted by 8192
  ' (a signed divide is slow)
  T = Cs * F
  U = T + 8192
  U = U >> 2
  T = U
  O[N].Vx = T - 2048
  T = Sn * F
  U = T + 8192
  U = U >> 2
  T = U
  O[N].Vy = T - 2048
  return
end sub

' one physics step
sub DoStep:
  if Freeze > 0 then
    MoveShots
    return
  end if
  ' the stick turns the jet: right or up clockwise, left or down anticlockwise
  K = J1 & 9
  V = J1 & 6
  if K > 0 then
    if V = 0 then PA = PA + PTurn
  end if
  if V > 0 then
    if K = 0 then PA = PA - PTurn
  end if
  X = highbyte(PA)
  SetVel(0, X, PSpd)
  if MState = MsFly then Seek
  MoveObj(0)
  if MState = MsFly then MoveObj(1)
  MoveShots
  ' fire: a shot every 28 steps while the button is held
  if Cool < CoolT then inc Cool
  if Btn > 0 then
    if Cool >= CoolT then NewShot
  end if
  Hits
  ' the missile's countdown and launch
  ' (novice counts every other step, intermediate two steps in three)
  if MState < LaunchT then
    inc Slow
    if Slow >= SlowT then
      Slow = 0
    else
      inc MState
      if MState = LaunchT then Launch
    end if
  end if
  ' 10 points every 341 steps (256 C64 steps)
  inc Steps
  inc Surv
  if Surv >= SurvT then
    Surv = 0
    AddScore(1)
  end if
  if MState = MsNone then
    if PadsLeft = 0 then
      if Crash = 0 then
        Cleared = 1
        inc Clears
        AddScore(100)
        play sound SndBonus
        Freeze = 90
      end if
    end if
  end if
  return
end sub

' the missile turns toward the jet (through the wrap, as on the C64)
sub Seek:
  i8 Cs = 0
  i8 Sn = 0
  u8 A = 0
  u8 A2 = 0
  X = highbyte(O[0].X)
  Y = highbyte(O[1].X)
  Dx = X
  Dx = Dx - Y
  if Dx > 104 then Dx = Dx - XSpan
  if Dx < -104 then Dx = Dx + XSpan
  X = highbyte(O[0].Y)
  Y = highbyte(O[1].Y)
  Dy = X
  Dy = Dy - Y
  A = highbyte(MA)
  Cs = CosT[A]
  A2 = A - 64
  Sn = CosT[A2]
  Cr = Cs * Dy - Sn * Dx
  if Cr > 0 then
    MA = MA + MTurn
  else
    if Cr < 0 then
      MA = MA - MTurn
    else
      ' straight ahead or straight behind: behind turns
      if Cs * Dx + Sn * Dy < 0 then MA = MA + MTurn
    end if
  end if
  inc Fuel
  if FuelT > 0 then
    if Fuel >= FuelT then
      ' out of fuel: it blows up harmlessly, 10 points
      Boom(1)
      MState = 0
      inc Fizz
      AddScore(1)
      play sound SndPop
    end if
  end if
  inc Flight
  if Flight >= 341 then
    Flight = 0
    if MTurn < MTurnMax then MTurn = MTurn + 31
  end if
  A = highbyte(MA)
  SetVel(1, A, MSpd)
  return
end sub

' move one flyer: wrap left-right, stop at the top and the floor
sub MoveObj(u8 N):
  u16 Px = 0
  u16 Py = 0
  Px = O[N].X + O[N].Vx
  Py = O[N].Y + O[N].Vy
  if highbyte(Px) < XMin then Px = Px + XSpan * 256
  if highbyte(Px) >= XMax then Px = Px - XSpan * 256
  if Py < YMin * 256 then Py = YMin * 256
  if Py > YMax * 256 then Py = YMax * 256
  O[N].X = Px
  O[N].Y = Py
  return
end sub

' the shots fly for 127 steps; a burning pad (Act 2) stays where it is
sub MoveShots:
  u16 Px = 0
  u16 Py = 0
  u8 Lf = 0
  for Ob = 2 to 7
    if O[Ob].Act > 0 then
      Lf = O[Ob].Life + 1
      O[Ob].Life = Lf
      if Lf >= LifeT then
        O[Ob].Act = 0
      else
        if O[Ob].Act = 1 then
          Px = O[Ob].X + O[Ob].Vx
          Py = O[Ob].Y + O[Ob].Vy
          V = highbyte(Px)
          if V < XMin then Px = Px + XSpan * 256
          if V >= XMax then Px = Px - XSpan * 256
          O[Ob].X = Px
          O[Ob].Y = Py
          V = highbyte(Py)
          if V < YMin then O[Ob].Act = 0
          if V > 168 then O[Ob].Act = 0
        end if
      end if
    end if
  next
  return
end sub

sub NewShot:
  for Ob = 2 to 7
    if O[Ob].Act = 0 then
      O[Ob].Act = 1
      O[Ob].Life = 0
      O[Ob].X = O[0].X
      O[Ob].Y = O[0].Y
      X = highbyte(PA)
      SetVel(Ob, X, 33)
      Cool = 0
      inc Shots
      play sound SndZap
      return
    end if
  next
  return
end sub

' which full pad (0-9) is under pixel (Px, Py), or 255
function PadAt(u8 Px, u8 Py) as u8
  u8 Pi = 0
  if Py < PadY then return 255
  if Py >= 176 then return 255
  Pi = ColPad[Px >> 3]
  if Pi > 9 then return 255
  if Pads[Pi] = 0 then return 255
  return Pi

sub Hits:
  u8 P = 0
  u16 Sx = 0
  u16 Sy = 0
  ' shots on full pads: 50 points, the shot burns on the pad
  for Ob = 2 to 7
    if O[Ob].Act = 1 then
      Sx = O[Ob].X
      Sy = O[Ob].Y
      X = highbyte(Sx) + 8
      Y = highbyte(Sy) + 8
      P = PadAt(X, Y)
      if P < 10 then
        KillPad(P)
        AddScore(5)
        inc Kills
        play sound SndPop
        O[Ob].Act = 2
        O[Ob].Life = LifeT - 84
        O[Ob].X = PadCol[P] * 8 * 256
        O[Ob].Y = (PadY - 2) * 256
      end if
    end if
  next
  ' the missile on a full pad: 100 points, the pad stays
  if MState = MsFly then
    X = highbyte(O[1].X) + 8
    Y = highbyte(O[1].Y) + 12
    P = PadAt(X, Y)
    if P < 10 then
      AddScore(10)
      inc Lures
      play sound SndSplash
      Boom(1)
      MState = 0
    end if
  end if
  ' the jet on a full pad
  X = highbyte(O[0].X) + 8
  Y = highbyte(O[0].Y) + 12
  P = PadAt(X, Y)
  if P < 10 then
    Crashed
    return
  end if
  ' the missile on the jet: centres within 12 pixels
  if MState = MsFly then
    X = highbyte(O[0].X)
    Y = highbyte(O[1].X)
    Dx = X
    Dx = Dx - Y
    X = highbyte(O[0].Y)
    Y = highbyte(O[1].Y)
    Dy = X
    Dy = Dy - Y
    if Dx > -10 then
      if Dx < 10 then
        if Dy > -10 then
          if Dy < 10 then Crashed
        end if
      end if
    end if
  end if
  return
end sub

sub Crashed:
  Crash = 1
  Boom(0)
  O[0].Act = 0
  MState = MsNone
  play sound SndCrash
  Freeze = 64
  return
end sub

sub Boom(u8 N):
  BoomX = highbyte(O[N].X)
  BoomY = highbyte(O[N].Y)
  BoomT = 40
  return
end sub

' the right-most full pad launches its missile, straight up
sub Launch:
  u8 P = 0
  u8 Found = 0
  P = 10
  while P > 0
    dec P
    if Pads[P] = 1 then
      Found = 1
      exit while
    end if
  end while
  if Found = 0 then
    MState = MsNone
    return
  end if
  KillPad(P)
  O[1].X = PadCol[P] * 8 * 256
  O[1].Y = (PadY - 4) * 256
  MA = 192 * 256
  ' the C64's 9/10/11 (x 3/4 = 275/305/336); novice 7, intermediate 8
  select case Skill
    case 0
      MTurn = 214
    case 1
      MTurn = 244
    case else
      MTurn = 336
  end select
  Flight = 0
  Fuel = 0
  SetVel(1, 192, MSpd)
  MState = MsFly
  play sound SndLaunch
  return
end sub

sub KillPad(u8 P):
  Pads[P] = 0
  dec PadsLeft
  X = PadCol[P]
  put char TPad00 at X,20
  put char TPad01 at X + 1,20
  put char TPad10 at X,21
  put char TPad11 at X + 1,21
  return
end sub

sub AddScore(u8 N):
  if Sc[Cur] < 65000 then Sc[Cur] = Sc[Cur] + N
  ShowHud
  return
end sub

sub DrawPads:
  for Pk = 0 to 9
    X = PadCol[Pk]
    put char TMs00 at X,20
    put char TMs01 at X + 1,20
    put char TMs10 at X,21
    put char TMs11 at X + 1,21
  next
  return
end sub

sub ShowHud:
  NumU = Sc[0]
  print at 2,1, "P1 ", digits$(NumU, 5), "0"
  NumU = Ships[Cur]
  print at 12,1, "SHIPS ", digits$(NumU, 1)
  if NPl = 2 then
    NumU = Sc[1]
    print at 20,1, "P2 ", digits$(NumU, 5), "0"
  end if
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 the jet, 1 the missile, 2-7 the shots, 8 an explosion
sub DrawSprites:
  u8 Pat = 0
  if O[0].Act = 1 then
    X = highbyte(O[0].X)
    Y = highbyte(O[0].Y)
    Pat = highbyte(PA) + 8
    Pat = (Pat / 16) * 4 + SJet0
    set sprite 0 to Y - 1,X,Pat,15
  else
    set sprite 0 to 192,0,0,0
  end if
  if MState = MsFly then
    X = highbyte(O[1].X)
    Y = highbyte(O[1].Y)
    Pat = highbyte(MA) + 8
    Pat = (Pat / 16) * 4 + SMsl0
    set sprite 1 to Y - 1,X,Pat,9
  else
    set sprite 1 to 192,0,0,0
  end if
  for Ds = 2 to 7
    select case O[Ds].Act
      case 1
        X = highbyte(O[Ds].X)
        Y = highbyte(O[Ds].Y)
        set sprite Ds to Y - 1,X,SShot,11
      case 2
        X = highbyte(O[Ds].X)
        Y = highbyte(O[Ds].Y)
        Pat = O[Ds].Life & 8
        if Pat = 0 then
          set sprite Ds to Y - 1,X,SBoom0,9
        else
          set sprite Ds to Y - 1,X,SBoom1,10
        end if
      case else
        set sprite Ds to 192,0,0,0
    end select
  next
  if BoomT > 0 then
    dec BoomT
    if BoomT > 20 then
      set sprite 8 to BoomY - 1,BoomX,SBoom0,11
    else
      set sprite 8 to BoomY - 1,BoomX,SBoom1,8
    end if
  else
    set sprite 8 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  ' speeds in quarters at 3/4 time: (C64 factor) x 3
  PSpd = Skill + 4
  PSpd = PSpd * 3
  ' the missile: the C64's 6/7/8; novice and intermediate get 5/6 here
  MSpd = Skill + 5
  if Skill = 2 then MSpd = 8
  MSpd = MSpd * 3
  ' turn rates in 1/256 of the 256-step circle: K/256 radian = K x 40.74,
  ' times 3/4
  PTurn = 305 + Skill * 31
  if Skill = 2 then PTurn = PTurn + 30
  MTurnMax = PTurn
  Sc[0] = 0
  Sc[1] = 0
  Ships[0] = 8
  Ships[1] = 0
  if NPl = 2 then Ships[1] = 8
  Cur = 1
  if NPl = 1 then Cur = 0
  Over = 0
  Shots = 0
  Kills = 0
  Lures = 0
  Clears = 0
  Fizz = 0
  ' easing (see Liberties): launch delay x2 / x1.5 and fuel 4 s / 6 s on
  ' novice / intermediate; expert as the C64
  select case Skill
    case 0
      SlowT = 2
      FuelT = 240
    case 1
      SlowT = 3
      FuelT = 360
    case else
      SlowT = 255
      FuelT = 0
  end select
  Steps = 0
  Surv = 0
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 9
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: HEAT SEEKER in glowing blocks, a jet looping round, the menu
sub TitlePage:
  u8 Ta = 0
  i8 Tc = 0
  i16 Tx = 0
  i16 Ty = 0
  Wt = 0
  NewScreen
  copy TitleMap count 352 to vram.name + 64
  print at 2,13, "COMPUTE! GAZETTE, MARCH 1985"
  print at 8,14, "BY JEFF WOLVERTON"
  print at 8,16, "SKILL"
  print at 8,17, "PLAYERS"
  print at 8,18, "START"
  print at 8,19, "CREDITS"
  Menu = 2
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Wt = 4
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the jet loops round the title
  Ta = Tick
  X = Ta + 64
  Tc = CosT[Ta]
  Tx = Tc + 112
  Tc = CosT[X]
  Tc = Tc / 32
  Ty = Tc + 161
  X = Tx
  Y = Ty
  K = Ta + 72
  K = (K / 16) * 4 + SJet0
  set sprite 0 to Y,X,K,15
  update sprites
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then
      K = V & 3
      if K = 1 then
        if Menu > 0 then dec Menu
      end if
      if K = 2 then
        if Menu < 3 then inc Menu
      end if
      K = V & 12
      if K > 0 then
        if Menu = 0 then
          if K = 8 then
            if Skill < 2 then inc Skill
          else
            if Skill > 0 then dec Skill
          end if
        end if
        if Menu = 1 then NPl = 3 - NPl
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu < 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 16 to 19
    put char 32 at 6,J
  next
  J = Menu + 16
  put char 62 at 6,J
  select case Skill
    case 0
      print at 16,16, "NOVICE      "
    case 1
      print at 16,16, "INTERMEDIATE"
    case else
      print at 16,16, "EXPERT      "
  end select
  NumU = NPl
  print at 16,17, digits$(NumU, 1)
  return
end sub

sub CreditsPage:
  Wt = 5
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "HEAT SEEKER"
  print at 2,5, "BASED ON HEAT SEEKER BY"
  print at 2,6, "JEFF WOLVERTON, COMPUTE!"
  print at 2,7, "GAZETTE, MARCH 1985"
  print at 2,8, "(COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE; ALSO FOR VIC-20)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: AFTERBURNER NIGHT"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

