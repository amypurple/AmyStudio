' the title tune: frames left
u16 TzLeft = 0
u8 TzOn = 0
' --- the night ---------------------------------------------------------------
' Mn the clock in minutes from midnight of the 31st (1420 = 11:40 PM),
' Mf the frames into the minute; Vk the victim (0-2; 3 the last signal),
' Dl the minute the name is read; Revealed 1 once the signal was heard;
' St[k] 0 waiting, 1 saved, 2 lost; VFreq the signal's place on the dial
u16 Mn = 1420
u8 Mf = 0
u8 Vk = 0
u16 Dl = 0
u8 Revealed = 0
u8 St[3]
u8 Saved = 0
u8 Lost = 0
u8 VFreq = 0
u8 Over = 0
' the dial: Fq the needle (0-255), Clar how clear (0-3)
u8 Fq = 128
u8 Clar = 0
u8 OldClar = 9
' Scene 0 the station, 1 the town, 2 a house; Hs the house
u8 Scene = 0
u8 Hs = 0
' the town's memory: the doors left open (a bit a house), the footprints
u8 Opened = 0
u8 FpX[16]
u8 FpY[16]
u8 Fpn = 0
u8 TrX[8]
u8 TrY[8]
u8 Tri = 0
u8 Walked = 0
' the car (Cx Cy pixels, Cd 0 up 1 right 2 down 3 left), you in a house
u8 Cx = 0
u8 Cy = 0
u8 Cd = 0
u8 Px = 0
u8 Py = 0
u8 Gait = 0
' the light: the cell lit round, and SgLight's inputs
u8 Lcx = 0
u8 Lcy = 0
u8 Lmode = 0
u8 Lnn = 0
u8 Pcx = 0
u8 Pcy = 0
' the thing: where its shadow shows, for how long; the tape
u8 Thx = 0
u8 Thy = 0
u8 Tht = 0
u8 Scared = 0
u8 Tx = 0
u8 Ty = 0
u8 HasTape = 0
' the silences: Quiet frames of silence left, Qn frames to the next
u8 Quiet = 0
u16 Qn = 1500
u8 Danger = 0
' input
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u16 Rs = 4321
' scratch
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 H = 0
u8 Mm = 0
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0

  tile screen
  set sound table SgSoundTable areas 6
  sprites 16x16
  set sprite count 8
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title
  IntroPage

new_night:
  Mn = 1420
  Mf = 0
  Vk = 0
  Saved = 0
  Lost = 0
  Over = 0
  Opened = 0
  Fpn = 0
  Walked = 0
  Scared = 0
  for I = 0 to 2
    St[I] = 0
  next
  Fq = 128
  NewVictim
  Qn = 1500
  Quiet = 0
  Scene = 0

scene_loop:
  if Scene = 0 then StationScene
  if Over = 0 then
    if Scene = 1 then TownScene
  end if
  if Over = 0 then
    if Scene = 2 then HouseScene
  end if
  if Over = 0 then goto scene_loop
  if Over = 1 then GoodEnd
  if Over = 2 then BadEnd
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the clock, the deadline, the silences: once a frame in every scene

sub Clock:
  inc Mf
  if Mf >= 150 then
    Mf = 0
    inc Mn
    if Scene <> 0 then ShowHudTime
    if Scene = 0 then ShowStTime
  end if
  ' danger: how near the name is
  Danger = 0
  if Vk < 3 then
    if Mn + 10 >= Dl then Danger = 1
    if Mn + 4 >= Dl then Danger = 2
    if Mn >= Dl then ReadName
  end if
  ' the silences
  if Quiet > 0 then
    dec Quiet
    if Quiet = 0 then Music
  else
    dec Qn
    if Qn = 0 then
      Rand
      W16 = Rs & 1023
      Qn = W16 + 1200
      Rand
      V = Rs & 63
      Quiet = V + 120
      stop sound SndDroneA
      stop sound SndDroneB
      mute all
    end if
  end if
  return
end sub

sub Music:
  if Quiet > 0 then return
  play sound SndDroneA
  play sound SndDroneB
  return
end sub

' Fx(K): a sound effect, unless it is one of the silences
sub Fx(u8 K):
  if Quiet > 0 then return
  if K = 1 then play sound SndStatic
  if K = 2 then play sound SndHiss
  if K = 3 then play sound SndClick
  if K = 4 then play sound SndHum
  if K = 5 then play sound SndNear1
  if K = 6 then play sound SndNear2
  if K = 7 then play sound SndNear3
  if K = 8 then play sound SndDoor
  if K = 9 then play sound SndChime
  if K = 10 then play sound SndCrunch
  if K = 11 then play sound SndEngine
  if K = 12 then play sound SndSting
  return
end sub

' the thing's breath: the noise channel, more often as the name nears
sub Breath:
  if Danger = 0 then return
  V = Tick & 63
  if Danger = 1 then
    if V = 0 then Fx(5)
  else
    V = Tick & 31
    if V = 0 then Fx(7)
  end if
  return
end sub

' NewVictim: the next name on the voice's list (or, after three, the last)
sub NewVictim:
  Revealed = 0
  Rand
  V = Rs & 127
  V = V + 64
  ' far enough from where the needle is
  W = V - Fq
  if Fq > V then W = Fq - V
  if W < 40 then V = V ^ 128
  if V < 16 then V = V + 16
  if V > 240 then V = V - 16
  VFreq = V
  Dl = Mn + 24
  return
end sub

' ReadName: the deadline came; the voice reads the name, the person is gone
sub ReadName:
  HideSprites
  stop sound SndDroneA
  stop sound SndDroneB
  mute all
  play sound SndToll
  Rearm
  wait 50 frames
  nmi off
  Message(1)
  Rearm
  wait 20 frames
  nmi off
  mute all
  Voice(Vk + 2)
  St[Vk] = 2
  inc Lost
  if Scene = 1 then DarkHouse(Vk)
  Rearm
  wait 40 frames
  nmi off
  if Lost >= 3 then
    Over = 2
    return
  end if
  inc Vk
  NewVictim
  Message(0)
  Music
  return
end sub

' Voice(K): a line of the voice (0 the signal, 1 you're next, 2-4 the
' names, 5 the operator); blocking, every other sound stopped
sub Voice(u8 K):
  stop sound SndDroneA
  stop sound SndDroneB
  mute all
  N = K
  play voxpcm SgVoice[N]
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' THE STATION

sub StationScene:
  DrawStation
  Music
  OldClar = 9
  Message(2)
  if Vk >= 3 then Message(3)
  if Revealed = 1 then Message(4)
st_loop:
  Frame1
  ReadPad
  Clock
  if Over > 0 then return
  if Scene <> 0 then return
  ' the dial
  if Lf1 = 1 then
    if Fq > 0 then dec Fq
    V = Tick & 3
    if V = 0 then Fx(3)
  end if
  if Rt1 = 1 then
    if Fq < 255 then inc Fq
    V = Tick & 3
    if V = 0 then Fx(3)
  end if
  ' how clear
  W = VFreq - Fq
  if Fq > VFreq then W = Fq - VFreq
  Clar = 0
  if W < 34 then Clar = 1
  if W < 14 then Clar = 2
  if W < 4 then Clar = 3
  ' the radio's own sounds
  V = Tick & 15
  if V = 0 then
    if Clar = 0 then Fx(1)
    if Clar = 1 then Fx(2)
    if Clar >= 2 then Fx(4)
  end if
  Breath
  ' the scope, the VU meters, the needle
  V = Tick & 3
  if V = 0 then
    V = Tick >> 2
    V = V & 3
    W16 = Clar * 4
    W16 = W16 + V
    W16 = W16 * 128
    A16 = TStScope0 * 8
    A16 = A16 + 4096
    copy ScopeFrames + W16 count 128 to vram.pattern + A16
  end if
  V = Tick & 7
  if V = 4 then Meters
  Needle
  ' snow in the window
  V = Tick & 7
  if V = 0 then SnowFall
  ' listen
  if Press = 1 then
    if Clar = 3 then
      if Vk >= 3 then
        Over = 1
        return
      end if
      if Revealed = 0 then
        HideSprites
        Voice(0)
        Revealed = 1
        LogBook
        Message(4)
        Music
      end if
    else
      Message(5)
    end if
  end if
  ' out to the car
  if Press2 = 1 then
    if Vk < 3 then
      Scene = 1
      Cx = StDoorX + 2
      Cx = Cx << 3
      Cy = StDoorY + 1
      Cy = Cy << 3
      Cd = 2
      Fx(8)
      return
    end if
  end if
  goto st_loop
end sub

' the needle on the dial (x 24-231)
sub Needle:
  W16 = Fq * 13
  W16 = W16 >> 4
  X = W16
  X = X + 24
  set sprite 7 to 95,X,SNeedle,8
  call asm PcSpr
  return
end sub

' the VU meters: the signal (row 18) and the noise (row 20), ten cells each
sub Meters:
  Rand
  V = Rs & 1
  N = Clar * 3
  N = N + V
  K = 3 - Clar
  K = K * 3
  Rand
  V = Rs & 1
  K = K + V
  for I = 0 to 9
    V = TStVuOff
    if I < N then
      V = TStVuG
      if I >= 6 then V = TStVuY
      if I >= 8 then V = TStVuR
    end if
    X = I + 16
    put char V at X,18
    V = TStVuOff
    if I < K then
      V = TStVuG
      if I >= 6 then V = TStVuY
      if I >= 8 then V = TStVuR
    end if
    put char V at X,20
  next
  return
end sub

' the snow tile in the window falls a row
sub SnowFall:
  W16 = TStSnowSky * 8
  asm {
      ld hl,(AMY_UVAR_W16)
      ld de,VRAM_PATTERN+7
      add hl,de
      call PcVpk           ; paced vpeek (vdp-safe pass)
      ld (AMY_UVAR_V),a
  }
  for I = 7 to 1 step -1
    J = I - 1
    asm {
        ld hl,(AMY_UVAR_W16)
        ld a,(AMY_UVAR_J)
        ld e,a
        ld d,0
        add hl,de
        ld de,VRAM_PATTERN
        add hl,de
        call PcVpk           ; paced vpeek (vdp-safe pass)
        ld (AMY_UVAR_W),a
    }
    vpoke vram.pattern + W16 + I, W
  next
  vpoke vram.pattern + W16, V
  return
end sub

sub DrawStation:
  NewScreen(0)
  for J = 0 to 21
    W16 = J * 28
    A16 = J + 1
    A16 = A16 << 5
    A16 = A16 + 2
    copy StationMap + W16 count 28 to vram.name + A16
  next
  print at 3,12, "54  70  90  110 130  160"
  print at 16,17, "SIGNAL"
  print at 16,19, "NOISE"
  print at 15,1, " LOGBOOK "
  ShowStTime
  LogBook
  ShowScreen
  return
end sub

' the station's clock (row 9)
sub ShowStTime:
  print at 2,9, "WKBS"
  TimeAt(7, 9)
  return
end sub

' TimeAt(X, Y): the clock as 11:52PM
sub TimeAt(u8 Xa, u8 Ya):
  W16 = Mn / 60
  H = W16
  W16 = W16 * 60
  W16 = Mn - W16
  Mm = W16
  if H >= 24 then H = H - 24
  W = 0
  if H >= 12 then W = 1
  if H >= 12 then H = H - 12
  if H = 0 then H = 12
  NumU = H
  if H < 10 then
    print at Xa,Ya, " "
    X = Xa + 1
    print at X,Ya, digits$(NumU, 1)
  else
    print at Xa,Ya, digits$(NumU, 2)
  end if
  X = Xa + 2
  print at X,Ya, ":"
  X = X + 1
  NumU = Mm
  print at X,Ya, digits$(NumU, 2)
  X = X + 2
  if W = 0 then
    print at X,Ya, "AM"
  else
    print at X,Ya, "PM"
  end if
  return
end sub

' the logbook (rows 2-7, columns 17-27): one line a name
sub LogBook:
  if Scene <> 0 then return
  for K = 0 to 2
    Y = K + 2
    if K < Vk then
      NameAt(K, 17, Y)
      if St[K] = 1 then print at 23,Y, " SAFE"
      if St[K] = 2 then print at 23,Y, " GONE"
    end if
    if K = Vk then
      if Revealed = 1 then
        print at 17,Y, "SIGNAL:"
        AddrAt(K, 17, Y + 1)
      end if
    end if
  next
  return
end sub

' NameAt(K, X, Y): a victim's name
sub NameAt(u8 Kn, u8 Xa, u8 Ya):
  if Kn = 0 then print at Xa,Ya, "ADA M."
  if Kn = 1 then print at Xa,Ya, "ELI C."
  if Kn = 2 then print at Xa,Ya, "RUTH L."
  return
end sub

' AddrAt(K, X, Y): where the signal points for victim K
sub AddrAt(u8 Kn, u8 Xa, u8 Ya):
  V = VicHouse[Kn]
  if V = 0 then print at Xa,Ya, "4 ELM ST "
  if V = 1 then print at Xa,Ya, "9 ELM ST "
  if V = 2 then print at Xa,Ya, "2 OAK AVE"
  if V = 3 then print at Xa,Ya, "7 OAK AVE"
  if V = 4 then print at Xa,Ya, "1 FIR RD "
  if V = 5 then print at Xa,Ya, "6 FIR RD "
  return
end sub

' Message(K): a line of text where the scene shows its messages
sub Message(u8 Km):
  Y = 22
  X = 2
  if Scene = 0 then
    Y = 9
    X = 15
    print at X,Y, "               "
  else
    print at 2,22, "                            "
    X = 2
  end if
  if Km = 0 then print at X,Y, "A NEW SIGNAL..."
  if Km = 1 then print at X,Y, "IT READS A NAME"
  if Km = 2 then print at X,Y, "TUNE THE DIAL"
  if Km = 3 then print at X,Y, "ONE MORE SIGNAL"
  if Km = 4 then
    print at X,Y, ">"
    X = X + 1
    AddrAt(Vk, X, Y)
    X = X + 10
    print at X,Y, "GO!"
  end if
  if Km = 5 then print at X,Y, "ONLY STATIC"
  if Km = 6 then print at X,Y, "BUTTON: GO IN"
  if Km = 7 then print at X,Y, "NOBODY HOME."
  if Km = 8 then print at X,Y, "THE TAPE! SHE IS SAFE"
  if Km = 9 then print at X,Y, "COLD. THE PHONE IS OFF."
  if Km = 10 then print at X,Y, "FIND THE TAPE"
  if Km = 11 then print at X,Y, "BUTTON: THE STATION"
  if Km = 12 then print at X,Y, "THE TAPE! HE IS SAFE"
  return
end sub

' ---------------------------------------------------------------------------
' THE TOWN

sub TownScene:
  DrawTown
  Music
  Pcx = 0
  LightCar
  Message(0)
  if Revealed = 1 then Message(4)
tw_loop:
  Frame1
  ReadPad
  Clock
  if Over > 0 then return
  ' drive
  X = Cx
  Y = Cy
  V = 0
  if Up1 = 1 then
    Y = Y - 1
    Cd = 0
    V = 1
  else
    if Dn1 = 1 then
      Y = Y + 1
      Cd = 2
      V = 1
    else
      if Lf1 = 1 then
        X = X - 1
        Cd = 3
        V = 1
      else
        if Rt1 = 1 then
          X = X + 1
          Cd = 1
          V = 1
        end if
      end if
    end if
  end if
  if V = 1 then
    if CanGo(X, Y) = 1 then
      Cx = X
      Cy = Y
      inc Walked
      V = Tick & 15
      if V = 0 then Fx(11)
    end if
  end if
  LightCar
  Footsteps
  Breath
  ShadowTown
  DrawCar
  ' a door under the car?
  X = Cx + 8
  X = X >> 3
  Y = Cy + 8
  Y = Y >> 3
  K = 255
  for I = 0 to 5
    V = HouseX[I] + 2
    W = HouseY[I] + 2
    if Y = W then
      if X + 1 >= V then
        if X <= V + 1 then K = I
      end if
    end if
  next
  if Press = 1 then
    if K < 255 then
      Hs = K
      Scene = 2
      Fx(8)
      return
    end if
    V = StDoorX + 2
    W = StDoorY + 1
    if Y = W then
      if X + 1 >= V then
        if X <= V + 1 then
          Scene = 0
          Fx(8)
          return
        end if
      end if
    end if
  end if
  goto tw_loop
end sub

' CanGo(X, Y): 1 if the car (16 x 16 at X, Y) fits on road and snow
function CanGo(u8 Xc, u8 Yc) as u8
  if Xc < 16 then return 0
  if Xc > 224 then return 0
  if Yc < 8 then return 0
  if Yc > 152 then return 0
  W = Xc + 4
  N = Yc + 4
  if Walk(W, N) = 0 then return 0
  W = Xc + 11
  if Walk(W, N) = 0 then return 0
  N = Yc + 11
  if Walk(W, N) = 0 then return 0
  W = Xc + 4
  if Walk(W, N) = 0 then return 0
  return 1

' Walk(X, Y): 1 if the cell under the pixel can be walked on (the scene's
' tile set: town or house)
function Walk(u8 Xw, u8 Yw) as u8
  A16 = Yw >> 3
  A16 = A16 << 5
  V = Xw >> 3
  A16 = A16 + V
  asm {
      ld hl,(AMY_UVAR_A16)
      ld de,VRAM_NAME
      add hl,de
      call PcVpk           ; paced vpeek (vdp-safe pass)
      ld (AMY_UVAR_V),a
  }
  if V < 128 then return 0
  V = V - 128
  if Scene = 1 then
    if V >= NTown then V = V - NTown
    if V < NTownWalk then return 1
  else
    if V >= NRoom then V = V - NRoom
    if V < NRoomWalk then return 1
  end if
  return 0

' LightCar: the light follows the car's cell (or yours in a house)
sub LightCar:
  if Scene = 1 then
    X = Cx + 8
    Y = Cy + 8
    Lnn = NTown
  else
    X = Px + 8
    Y = Py + 8
    Lnn = NRoom
  end if
  X = X >> 3
  Y = Y >> 3
  if X = Pcx then
    if Y = Pcy then return
  end if
  if Pcx > 0 then
    Lcx = Pcx
    Lcy = Pcy
    Lmode = 0
    call asm SgLight
  end if
  Lcx = X
  Lcy = Y
  Lmode = 1
  call asm SgLight
  Pcx = X
  Pcy = Y
  Lmode = 0
  return
end sub

' the car: body, glass and headlamps (sprites 0-2), turned its way
sub DrawCar:
  V = Cd << 4
  W = V + 4
  K = V + 8
  Y = Cy - 1
  set sprite 0 to Y,Cx,W,5
  set sprite 1 to Y,Cx,V,8
  set sprite 2 to Y,Cx,K,11
  call asm PcSpr
  return
end sub

' footprints: after the first house, something walks behind the car
sub Footsteps:
  if Opened = 0 then return
  V = Walked & 7
  if V <> 0 then return
  if Walked = 0 then return
  Walked = Walked + 1
  ' remember where the car was
  X = Cx + 8
  X = X >> 3
  Y = Cy + 8
  Y = Y >> 3
  TrX[Tri] = X
  TrY[Tri] = Y
  Tri = Tri + 1
  Tri = Tri & 7
  ' six places back, a print in the snow next to the track
  V = Tri + 1
  V = V & 7
  X = TrX[V]
  Y = TrY[V]
  if X = 0 then return
  X = X + 1
  A16 = Y
  A16 = A16 << 5
  A16 = A16 + X
  asm {
      ld hl,(AMY_UVAR_A16)
      ld de,VRAM_NAME
      add hl,de
      call PcVpk           ; paced vpeek (vdp-safe pass)
      ld (AMY_UVAR_V),a
  }
  W = V - 128
  if V < 128 then return
  if W >= NTown then W = W - NTown
  if W <> 1 then return
  V = V + 1
  vpoke vram.name + A16, V
  if Fpn < 16 then
    FpX[Fpn] = X
    FpY[Fpn] = Y
    inc Fpn
    Fx(10)
  end if
  return
end sub

' the shadow at the edge of the headlights (town)
sub ShadowTown:
  if Tht > 0 then
    dec Tht
    if Tht = 0 then
      set sprite 3 to 192,0,0,0
      set sprite 4 to 192,0,0,0
    end if
    return
  end if
  if Danger = 0 then return
  V = Tick & 127
  if V <> 64 then return
  Rand
  V = Rs & 3
  if V <> 0 then return
  ShowShadow(Cx, Cy)
  return
end sub

' ShowShadow(X, Y): the shadow for half a second, 28 pixels off the light's
' middle, in a random direction
sub ShowShadow(u8 Xs, u8 Ys):
  Rand
  V = Rs & 3
  X = Xs
  Y = Ys
  if V = 0 then X = X + 26
  if V = 1 then X = X - 26
  if V = 2 then Y = Y + 22
  if V = 3 then Y = Y - 26
  if X < 16 then X = 16
  if X > 224 then X = 224
  if Y < 8 then Y = 8
  if Y > 136 then Y = 136
  Thx = X
  Thy = Y - 9
  W = Thy + 16
  set sprite 3 to Thy,Thx,SThingT,1
  set sprite 4 to W,Thx,SThingB,1
  call asm PcSpr
  Tht = 30
  Fx(12)
  return
end sub

sub DrawTown:
  NewScreen(1)
  for J = 0 to 19
    W16 = J * 28
    A16 = J + 1
    A16 = A16 << 5
    A16 = A16 + 2
    copy TownMap + W16 count 28 to vram.name + A16
  next
  ' doors left open, houses gone dark, footprints
  for I = 0 to 5
    V = Bit[I]
    W = Opened & V
    if W <> 0 then
      X = HouseX[I] + 2
      Y = HouseY[I] + 1
      put char TDkDoorOpen at X,Y
    end if
  next
  for K = 0 to 2
    if St[K] = 2 then DarkHouse(K)
  next
  if Fpn > 0 then
    J = Fpn - 1
    for I = 0 to J
      X = FpX[I]
      Y = FpY[I]
      put char TDkFoot at X,Y
    next
  end if
  ShowHudTime
  ShowScreen
  return
end sub

' DarkHouse(K): the windows of victim K's house go dark
sub DarkHouse(u8 Kd):
  V = VicHouse[Kd]
  X = HouseX[V] + 1
  Y = HouseY[V] + 1
  put char TDkWinOut at X,Y
  return
end sub

' the time on row 21 (town and house)
sub ShowHudTime:
  TimeAt(22, 21)
  return
end sub

' ---------------------------------------------------------------------------
' A HOUSE

sub HouseScene:
  DrawHouse
  Music
  Px = 116
  Py = 140
  Pcx = 0
  Scared = 0
  Tht = 0
  HasTape = 0
  if Vk < 3 then
    if VicHouse[Vk] = Hs then
      if St[Vk] = 0 then
        HasTape = 1
        Tx = TapeX[Hs]
        Ty = TapeY[Hs]
      end if
    end if
  end if
  if HasTape = 1 then
    Message(10)
  else
    if HouseGone(Hs) = 1 then
      Message(9)
    else
      Message(7)
    end if
  end if
  LightCar
hs_loop:
  Frame1
  ReadPad
  Clock
  if Over > 0 then return
  X = Px
  Y = Py
  V = 0
  if Up1 = 1 then
    Y = Y - 1
    V = 1
  end if
  if Dn1 = 1 then
    Y = Y + 1
    V = 1
  end if
  if Lf1 = 1 then
    X = X - 1
    V = 1
  end if
  if Rt1 = 1 then
    X = X + 1
    V = 1
  end if
  ' out of the door (the exit cells, rows 20)
  if Py >= 146 then
    if Dn1 = 1 then
      V = Bit[Hs]
      Opened = Opened | V
      Scene = 1
      Cx = HouseX[Hs] + 2
      Cx = Cx << 3
      Cy = HouseY[Hs] + 2
      Cy = Cy << 3
      Cd = 2
      Fx(8)
      return
    end if
  end if
  if V = 1 then
    if CanWalk(X, Y) = 1 then
      Px = X
      Py = Y
      inc Gait
      V = Gait & 15
      if V = 0 then Fx(10)
    end if
  end if
  LightCar
  TvSnow
  Breath
  DrawYou
  ' the tape
  if HasTape = 1 then
    W = Dist(Px, Tx)
    N = Dist(Py, Ty)
    if W < 30 then
      if N < 30 then
        set sprite 5 to Ty,Tx,SReels,1
        set sprite 6 to Ty,Tx,STape,15
      else
        HideTape
      end if
    else
      HideTape
    end if
    if Press = 1 then
      if W < 12 then
        if N < 12 then
          HasTape = 0
          HideTape
          St[Vk] = 1
          inc Saved
          Fx(9)
          if Vk = 1 then
            Message(12)
          else
            Message(8)
          end if
          inc Vk
          NewVictim
          Scared = 1
          Tht = 0
          ShowShadow(Px, Py)
        end if
      end if
    end if
  end if
  ' a scare once a visit, a while after you come in
  if Scared = 0 then
    if Gait = 90 then
      Scared = 1
      ShowShadow(Px, Py)
    end if
  end if
  if Tht > 0 then
    dec Tht
    if Tht = 0 then
      set sprite 3 to 192,0,0,0
      set sprite 4 to 192,0,0,0
    end if
  end if
  call asm PcSpr
  goto hs_loop
end sub

function Dist(u8 A, u8 B) as u8
  if A >= B then return A - B
  return B - A

' HouseGone(H): 1 if the house's person was taken
function HouseGone(u8 Hg) as u8
  for K = 0 to 2
    if St[K] = 2 then
      if VicHouse[K] = Hg then return 1
    end if
  next
  return 0

function CanWalk(u8 Xc, u8 Yc) as u8
  if Xc < 16 then return 0
  if Xc > 224 then return 0
  if Yc < 32 then return 0
  if Yc > 148 then return 0
  W = Xc + 4
  N = Yc + 10
  if Walk(W, N) = 0 then return 0
  W = Xc + 11
  if Walk(W, N) = 0 then return 0
  N = Yc + 14
  if Walk(W, N) = 0 then return 0
  W = Xc + 4
  if Walk(W, N) = 0 then return 0
  return 1

sub HideTape:
  set sprite 5 to 192,0,0,0
  set sprite 6 to 192,0,0,0
  return
end sub

' you: hat and coat, two steps
sub DrawYou:
  V = Gait & 8
  W = SCoat1
  if V <> 0 then W = SCoat2
  Y = Py - 1
  set sprite 0 to Y,Px,SHat,9
  set sprite 1 to Y,Px,W,15
  return
end sub

' the TV's snow: its screen tiles take 8 random bytes (from the scope's
' pictures) every 6 frames
sub TvSnow:
  V = Tick & 7
  if V <> 0 then return
  Rand
  W16 = Rs & 1015
  A16 = TDkTvS * 8
  copy ScopeFrames + W16 count 8 to vram.pattern + A16
  A16 = TLtTvS * 8
  copy ScopeFrames + W16 count 8 to vram.pattern + A16
  return
end sub

sub DrawHouse:
  NewScreen(2)
  for J = 0 to 19
    W16 = J * 28
    A16 = J + 1
    A16 = A16 << 5
    A16 = A16 + 2
    copy RoomMap + W16 count 28 to vram.name + A16
  next
  ShowHudTime
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' THE ENDINGS

sub GoodEnd:
  HideSprites
  Voice(5)
  Rearm
  wait 30 frames
  nmi off
  Voice(1)
  ' the last line of the logbook, in your own hand, dated tomorrow
  print at 17,6, "NOV 1 1983"
  print at 17,7, "OPERATOR"
  print at 15,9, "               "
  print at 15,9, "MY OWN HAND"
  Rearm
  wait 240 frames
  nmi off
  NewScreen(0)
  print at 7,10, "TO BE CONTINUED..."
  NumU = Saved
  print at 7,14, "SAVED TONIGHT:"
  print at 22,14, digits$(NumU, 1)
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  Rearm
  wait 60 frames
  nmi off
  return
end sub

sub BadEnd:
  HideSprites
  Rearm
  wait 60 frames
  nmi off
  NewScreen(0)
  print at 6,9, "THE TOWN IS SILENT."
  print at 6,11, "NOBODY WAS SAVED."
  print at 6,13, "THE SIGNAL IS STILL"
  print at 6,14, "ON THE AIR."
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  play sound SndToll
  Rearm
  wait 60 frames
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' screens and pages

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  call asm PcSpr
  Tht = 0
  return
end sub

' NewScreen(S): the tile set of the station (0), the town (1) or a house (2)
sub NewScreen(u8 Sn):
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  if Sn = 0 then
    copy StPat count NSt8 to vram.pattern + 1024
    copy StPat count NSt8 to vram.pattern + 3072
    copy StPat count NSt8 to vram.pattern + 5120
    copy StCol count NSt8 to vram.color + 1024
  end if
  if Sn = 1 then
    copy TwPat count NTw8 to vram.pattern + 1024
    copy TwPat count NTw8 to vram.pattern + 3072
    copy TwPat count NTw8 to vram.pattern + 5120
    copy TwCol count NTw8 to vram.color + 1024
  end if
  if Sn = 2 then
    copy RmPat count NRm8 to vram.pattern + 1024
    copy RmPat count NRm8 to vram.pattern + 3072
    copy RmPat count NRm8 to vram.pattern + 5120
    copy RmCol count NRm8 to vram.color + 1024
  end if
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the tower on its hill, its light blinking once a second
sub TitlePage:
  NewScreen(0)
  for J = 0 to 11
    W16 = J * 28
    A16 = J + 2
    A16 = A16 << 5
    A16 = A16 + 2
    copy TitleMap + W16 count 28 to vram.name + A16
  next
  print at 10,15, "THE  SIGNAL"
  print at 4,17, "ONE NIGHT AT WKBS 1340 AM"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 612
  TzOn = 1
  Menu = 0
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the tower's light: on half a second, off half a second
  V = Tick & 63
  if V = 0 then put char TStTowOn at 15,3
  if V = 32 then put char TStTowOff at 15,3
  V = Lf1 | Rt1
  if V = 1 then
    if WasStick = 0 then
      Menu = Menu ^ 1
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  print at 8,21, " START   CREDITS"
  if Menu = 0 then
    put char 62 at 8,21
  else
    put char 62 at 16,21
  end if
  return
end sub

sub IntroPage:
  NewScreen(0)
  print at 2,2, "OCTOBER 31, 1983. 11:40 PM."
  print at 2,4, "YOU RUN THE NIGHT SHIFT AT"
  print at 2,5, "WKBS 1340 AM. FOR A WEEK A"
  print at 2,6, "VOICE HAS CUT IN ON THE"
  print at 2,7, "DIAL, READING NAMES. NOBODY"
  print at 2,8, "IT NAMES IS SEEN AGAIN."
  print at 2,10, "TUNE IN THE SIGNAL: IT SAYS"
  print at 2,11, "WHERE IT WILL STRIKE. DRIVE"
  print at 2,12, "THERE AND FIND THE TAPE IT"
  print at 2,13, "LEFT BEFORE IT READS THE"
  print at 2,14, "NAME."
  print at 2,16, "STICK: TUNE, DRIVE, WALK"
  print at 2,17, "LEFT BUTTON: LISTEN, GO IN,"
  print at 2,18, "PICK UP"
  print at 2,19, "RIGHT BUTTON: OUT TO THE CAR"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  pause until press and release
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen(0)
  backdrop dark blue
  print at 10,2, "THE SIGNAL"
  print at 5,5, "A GAME BY AMY & CLAUDE"
  print at 8,7, "AMY STUDIO 2026"
  print at 6,10, "MADE IN AMY FOR THE"
  print at 10,12, "COLECOVISION"
  print at 2,15, "MUSIC: DEAD AIR AND"
  print at 2,17, "NIGHT SHIFT HUM"
  print at 2,19, "A PROTOTYPE: ONE NIGHT."
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

