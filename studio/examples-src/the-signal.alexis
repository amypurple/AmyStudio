' the victims' houses (indices into HouseX/HouseY), and where each house
' hides its tape (pixels)
data Bit bytes
  1, 2, 4, 8, 16, 32, 64, 128
end data
data VicHouse bytes
  3, 0, 5
end data
data TapeX bytes
  40, 200, 60, 200, 30, 210
end data
data TapeY bytes
  120, 60, 130, 100, 60, 130
end data

asm {
; ---------------------------------------------------------------------------
; THE SIGNAL: the light. The town and the house are drawn in dark tiles
; (codes 128..127+N); a lit copy of each sits N codes higher. SgLight turns
; the cells round (Lcx, Lcy) lit (Lmode 1) or back to dark (Lmode 0), in
; screen columns 2-29 and rows 1-20, within a radius of about 3 cells
; (SgRing). Lnn is N. Call with the NMI off.
; ---------------------------------------------------------------------------
SgLight:
    ld hl,SgRing
sgl_next:
    ld a,(hl)
    cp $80
    ret z
    ld b,a                      ; dx
    inc hl
    ld c,(hl)                   ; dy
    inc hl
    ld a,(AMY_UVAR_Lcx)
    add a,b
    cp 2
    jr c,sgl_next
    cp 30
    jr nc,sgl_next
    ld e,a                      ; x
    ld a,(AMY_UVAR_Lcy)
    add a,c
    cp 1
    jr c,sgl_next
    cp 21
    jr nc,sgl_next
    ; address = $1800 + y*32 + x
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,0
    add hl,de
    ld de,$1800
    add hl,de
    ; read the cell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    nop                         ; paced: >= 29 T from the address set-up to
    nop                         ; the IN (mid-screen the read-ahead waits up
    nop                         ; to 26 T for an access slot; vdp-safe pass)
    nop
    in a,($BE)
    ld b,a
    ld a,(AMY_UVAR_Lnn)
    ld c,a
    ld a,(AMY_UVAR_Lmode)
    or a
    jr z,sgl_dark
    ; lit: a dark code (128..127+N) goes up by N
    ld a,b
    sub 128
    jr c,sgl_skip
    cp c
    jr nc,sgl_skip
    ld a,b
    add a,c
    jr sgl_put
sgl_dark:
    ; dark: a lit code (128+N..127+2N) goes down by N
    ld a,b
    sub 128
    jr c,sgl_skip
    sub c
    jr c,sgl_skip
    cp c
    jr nc,sgl_skip
    ld a,b
    sub c
sgl_put:
    ld b,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,b
    out ($BE),a
sgl_skip:
    pop hl
    jr sgl_next

; the cells lit round the light: dx, dy pairs (a disc of radius ~3.2)
SgRing:
    db -1,-3, 0,-3, 1,-3
    db -2,-2,-1,-2, 0,-2, 1,-2, 2,-2
    db -3,-1,-2,-1,-1,-1, 0,-1, 1,-1, 2,-1, 3,-1
    db -3,0,-2,0,-1,0, 0,0, 1,0, 2,0, 3,0
    db -3,1,-2,1,-1,1, 0,1, 1,1, 2,1, 3,1
    db -2,2,-1,2, 0,2, 1,2, 2,2
    db -1,3, 0,3, 1,3
    db $80

; PcSpr: Amy's "update sprites" (AMY_UPDATE_SPRITES, sprite flicker off),
; paced: >= 29 T between VRAM writes (TMS9928A mid-screen access slots; the
; runtime's loop writes 18 T apart). (vdp-safe pass, 2026-11-15)
PcSpr:
    ld a,(AMY_SPRITE_COUNT)
    ld e,a
    xor a
    out ($BF),a
    ld a,$5B
    out ($BF),a
    ld a,e
    or a
    jr z,PcSpr2
    push bc
    ld c,$BE
    ld hl,AMY_SPRITE_TABLE
PcSpr1:
    outi
    nop
    nop
    nop
    outi
    nop
    nop
    nop
    outi
    ld a,(hl)
    and $8F
    out (c),a
    inc hl
    dec e
    jr nz,PcSpr1
    pop bc
PcSpr2:
    ld a,$D0
    out ($BE),a
    ret

; PcVpk: Amy's vpeek (AMY_VPEEK), HL = VRAM address -> A, paced: >= 29 T
; from the address set-up to the IN (mid-screen the read-ahead waits up to
; 26 T for an access slot). AMY_VPEEK has an ex (sp),hl pair there, but the
; r11 optimizer deletes it; plain NOPs are kept. (vdp-safe pass, 2026-11-15)
PcVpk:
    ld a,$A5
    ld ($701F),a
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    nop
    nop
    nop
    nop
    in a,($BE)
    push af
    call AMY_RELEASE_VDP_GUARD
    pop af
    ret
