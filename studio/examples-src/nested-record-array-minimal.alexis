' Nested record smoke test: parent+child field offsets inside an array.
record Pos:
  u8 X
  u8 Y
end record

record Piece:
  Pos P
  u8 Tile
  u8 Flags
end record

Piece Pieces[2]
u8 I = 0

  text screen
  set Pieces[0].P.X = 2
  set Pieces[0].P.Y = 4
  set Pieces[0].Tile = 67
  set Pieces[1].P.X = 8
  set Pieces[1].P.Y = 7
  set Pieces[1].Tile = 68
  for I = 0 to 1
    put char Pieces[I].Tile at Pieces[I].P.X,Pieces[I].P.Y
  next I
  screen on