asm {
CwHush:
    db $00,$00,$F4,$01,$10
CwFling:
    db $00,$00,$55,$02,$00,$00,$35,$02,$00,$00,$65,$03,$00,$00,$A5,$03,$00,$00,$F5,$01,$10
CwGlass:
    db $40,$24,$20,$02,$40,$2A,$40,$02,$40,$20,$60,$03,$40,$26,$90,$04,$40,$FE,$F0,$01,$50
CwWood:
    db $00,$00,$26,$02,$00,$00,$76,$03,$00,$00,$F6,$01,$10
CwStone:
    db $40,$FC,$11,$02,$40,$3B,$52,$03,$40,$FE,$F0,$01,$50
CwCaw:
    db $40,$AA,$20,$04,$40,$B4,$40,$03,$40,$BF,$30,$05,$40,$CA,$70,$03,$40,$FE,$F0,$01,$50
CwTumble:
    db $00,$00,$67,$02,$00,$00,$F7,$01,$10
CwThud:
    db $00,$00,$46,$03,$00,$00,$96,$03,$00,$00,$F6,$01,$10
CwClear:
    db $40,$D6,$20,$05,$40,$AA,$20,$05,$40,$8F,$20,$05,$40,$6B,$30,$0C,$40,$FE,$F0,$01,$50
CwFail:
    db $40,$1D,$31,$08,$40,$2E,$41,$08,$40,$41,$51,$10,$40,$FE,$F0,$01,$50
CwStar:
    db $40,$47,$10,$03,$40,$39,$10,$03,$40,$30,$10,$03,$40,$24,$20,$03,$40,$1C,$40,$06,$40,$FE,$F0,$01
    db $50
CwSplat:
    db $00,$00,$07,$02,$00,$00,$16,$04,$00,$00,$46,$06,$00,$00,$86,$0A,$00,$00,$F6,$01,$10
CwTick:
    db $40,$40,$50,$01,$50

CwSoundTable:
    dw CwHush,$702B
    dw CwFling,$702B
    dw CwGlass,$7035
    dw CwWood,$702B
    dw CwStone,$7035
    dw CwCaw,$7035
    dw CwTumble,$702B
    dw CwThud,$702B
    dw CwClear,$7035
    dw CwFail,$7035
    dw CwStar,$7035
    dw CwSplat,$702B
    dw CwTick,$7035
    dw CwTuneMel,$703F
    dw CwTuneBass,$7049
; Harvest Moon Jig, E minor (original for this game)
; Tiny Sound, 6 frames per step
CwTuneMel:
    db $44
    dw sndtiny_1
    db 6
    db $02,$30,$31,$88,$23,$26,$2A,$26,$23,$26,$25,$22,$1E,$22,$25,$22
    db $A3,$00,$00,$00,$26,$2A,$2B,$2A,$26,$23,$25,$26,$28,$26,$25,$22
    db $A3,$00,$00,$00,$2A,$28,$26,$28,$2A,$26,$23,$26,$28,$26,$25,$26
    db $28,$25,$22,$25,$26,$25,$23,$25,$26,$23,$1E,$22,$A3,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
CwTuneBass:
    db $84
    dw sndtiny_2
    db 6
    db $02,$70,$F1,$22,$0B,$00,$12,$00,$0B,$00,$12,$00,$06,$00,$0D,$00
    db $0B,$00,$12,$00,$0B,$00,$12,$00,$07,$00,$0E,$00,$06,$00,$0D,$00
    db $0B,$00,$12,$00,$0B,$00,$12,$00,$0B,$00,$12,$00,$0D,$00,$13,$00
    db $06,$00,$0D,$00,$0B,$00,$12,$00,$04,$00,$06,$00,$0B,$00,$12,$00
    db $0B,$00,$00,$00
    db $FF
CwSong:
    dw $0001
    db $40+14,15
    dw $0000
; CROW'S NEST's camera: CwDraw redraws screen rows 2-22 from the world,
; columns CamX to CamX + 31, with the crows' ground (world columns 56-75,
; rows 2-17: a 10 x 8 grid of big cells, Grid) drawn over it.
CwDraw:
    xor a
    ld (AMY_UVAR_DrRow),a
CwRow:
    ; the screen address of row DrRow + 2
    ld a,(AMY_UVAR_DrRow)
    add a,2
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ; the world's row: CwWorld + DrRow * 80 + CamX
    ld a,(AMY_UVAR_DrRow)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld d,h
    ld e,l
    add hl,hl
    add hl,hl
    add hl,de
    ld de,CwWorld
    add hl,de
    ld a,(AMY_UVAR_CamX)
    ld e,a
    ld d,0
    add hl,de
    ; the row inside the grid? (world rows 2-17)
    ld a,(AMY_UVAR_DrRow)
    sub 2
    cp 16
    jr nc,CwPlain
    ; yes: row in the grid (0-15), its big row and half
    ld (AMY_UVAR_DrGy),a
    ld a,(AMY_UVAR_CamX)
    ld (AMY_UVAR_DrWx),a
    ld b,32
CwCell:
    ld c,(hl)
    inc hl
    ld a,(AMY_UVAR_DrWx)
    sub 56
    cp 20
    jr nc,CwOut
    ; grid column (0-19) -> big cell and half
    push hl
    ld e,a
    srl a
    ld d,a
    ld a,(AMY_UVAR_DrGy)
    srl a
    ; big row * 10 + big column
    ld l,a
    add a,a
    add a,a
    add a,l
    add a,a
    add a,d
    ld l,a
    ld h,0
    push de
    ld de,AMY_UVAR_Grid
    add hl,de
    pop de
    ld a,(hl)
    or a
    jr z,CwSky
    ; the block's tile: BlkTile + kind * 4 + (row half) * 2 + (column half)
    add a,a
    add a,a
    ld l,a
    ld a,(AMY_UVAR_DrGy)
    and 1
    add a,a
    add a,l
    ld l,a
    ld a,e
    and 1
    add a,l
    ld l,a
    ld h,0
    ld de,AMY_UDATA_BlkTile
    add hl,de
    ld c,(hl)
    pop hl
    jr CwOut
CwSky:
    pop hl
CwOut:
    ld a,c
    out ($BE),a
    ld a,(AMY_UVAR_DrWx)
    inc a
    ld (AMY_UVAR_DrWx),a
    djnz CwCell
    jr CwNext
CwPlain:
    ld b,32
CwPl:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    djnz CwPl
CwNext:
    ld a,(AMY_UVAR_DrRow)
    inc a
    ld (AMY_UVAR_DrRow),a
    cp 21
    jp c,CwRow
    ret
CwWorld:
    db 129,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,131,129,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,128,129,128,128,128,128,128
    db 128,128,128,128,130,128,128,128,128,128,128,128,128,128,128,128,128,128,128,131,128,128,128,141,142,143,144,128,128,128,128,128,128,128,128,128,131,128,128,128
    db 128,128,128,128,128,128,128,128,128,128,129,128,128,128,128,128,128,128,132,133,134,129,128,128,128,130,128,128,130,128,128,128,128,128,128,128,128,128,128,128
