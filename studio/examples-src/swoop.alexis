record Bat:
  u16 X
  u8 Y
  i8 DY
  i8 DX
  u8 Alive
end record

Bat Bats[NBat]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 Acc = 0
u16 PX = 176
u16 ShX = 0
u16 BmX = 0
u16 ToLife = 1000
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 Lv = 1
u8 Lives = 3
u8 Phase = 0
u8 Timer = 0
u8 ShY = 0
u8 ShN = 0
u8 BmY = 0
u8 Anim = 0
u8 PuffT = 0
u8 PuffX = 0
u8 PuffY = 0
u8 Pts = 0
u8 Dead = 0
u8 Hits = 0
u8 Kills = 0
u8 Drops = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Bi = 0
u8 Di = 0
u8 Wi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Cv = 0

  tile screen
  set sound table SwSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  GameStep
  DrawAll
  if Phase <> 5 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  if Score > Hi then Hi = Score
  print at 8,9, "                "
  print at 8,10, "   GAME  OVER   "
  print at 8,11, "                "
  print at 8,12, "  SCORE ", Score, "  "
  print at 8,13, "  BEST  ", Hi, "  "
  print at 8,14, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of the game (model.mjs step)
sub GameStep:
  inc Anim
  if PuffT > 0 then dec PuffT
  select case Phase
  case 1
    ' the cannon blinks, everything waits
    dec Timer
    if Timer = 0 then
      Phase = 2
      Timer = 55
    end if
  case 4
    ' the blast: everything waits
    dec Timer
    if Timer = 0 then LoseLife
  case 5
    Timer = 0
  case else
    PlayFrame
  end select
  return
end sub

sub LoseLife:
  dec Lives
  ShowLives
  if Lives = 0 then
    Phase = 5
  else
    PX = 176
    NewWave
  end if
  return
end sub

' the stick, the shot, the bats' passes, then what touched what
sub PlayFrame:
  K = J1 & 12
  if K = 4 then
    if PX >= 30 then PX = PX - 2
  end if
  if K = 8 then
    if PX < 318 then PX = PX + 2
  end if
  if ShN > 0 then
    inc ShN
    ShY = ShY - 8
    if ShN >= 20 then ShN = 0
  end if
  if Phase = 2 then
    Descend
  else
    K = J1 & 16
    if K > 0 then
      if ShN = 0 then
        if Phase = 0 then
          ShN = 1
          ShY = 202
          ShX = PX + 12
          play sound SndShot
        end if
      end if
    end if
    Acc = Acc + RateT[Lv - 1]
    while Acc >= 256
      Acc = Acc - 256
      if Phase = 0 then DoPass
    end while
    if ShN > 1 then ShotHits
    if Phase = 0 then
      Touches
    else
      dec Timer
      if Timer = 0 then
        if Lv < 13 then inc Lv
        ShowLevel
        NewWave
      end if
    end if
  end if
  return
end sub

' the bats come down to their heights
sub Descend:
  for Di = 0 to 5
    V = HomeY[Di]
    if Bats[Di].Y < V then Bats[Di].Y += 1
  next
  dec Timer
  if Timer = 0 then Phase = 0
  return
end sub

' one pass of the C64's main loop: every bat a step, then the ember
sub DoPass:
  i16 Ny = 0
  i16 Nx = 0
  Bi = NBat
  while Bi > 0
    dec Bi
    if Bats[Bi].Alive = 1 then
      Ny = Bats[Bi].Y
      Ny = Ny + Bats[Bi].DY
      if Ny >= BatLow or Ny < 52 then
        NewHeading(Bi)
      else
        Bats[Bi].Y = Ny
        Nx = Bats[Bi].X
        Nx = Nx + Bats[Bi].DX
        if Nx < 28 or Nx >= 320 then
          NewHeading(Bi)
        else
          V = Rand8() & 63
          if V = 0 then
            NewHeading(Bi)
          else
            Bats[Bi].X = Nx
          end if
        end if
      end if
    end if
  end while
  if BmY > 0 then
    BmY = BmY + 4
    if BmY >= 203 then BmY = 0
  else
    TryDrop
  end if
  return
end sub

' the first bat (sixth down) right above the cannon lets an ember fall
' if it is alive and high enough
sub TryDrop:
  Wi = NBat
  while Wi > 0
    dec Wi
    if Bats[Wi].X = PX then
      if Bats[Wi].Alive = 0 then return
      if Bats[Wi].Y >= DropTop then return
      BmY = Bats[Wi].Y
      BmX = PX
      inc Drops
      return
    end if
  end while
  return
end sub

sub NewHeading(u8 Nb)
  V = Rand8() & 7
  Bats[Nb].DY = TurnT[V]
  V = Rand8() & 7
  Bats[Nb].DX = TurnT[V]
  return
end sub

' the shot (this row and the one it left) against every bat
sub ShotHits:
  u16 Bx = 0
  u8 By = 0
  Hits = 0
  for Di = 0 to 5
    if Bats[Di].Alive = 1 then
      Bx = Bats[Di].X
      By = Bats[Di].Y
      if ShX >= Bx and ShX <= Bx + 22 then
        if ShY + 15 >= By + 4 and ShY <= By + 13 then
          Bats[Di].Alive = 0
          inc Hits
          inc Kills
          PuffT = 12
          PuffX = CvX(Bx)
          PuffY = CvY(By)
          AddPoints
        end if
      end if
    end if
  next
  if Hits > 0 then
    ShN = 0
    play sound SndPop
  end if
  return
end sub

sub AddPoints:
  Pts = Lv * 10
  if Score > ScoreCap then
    Score = ScoreMax
  else
    Score += Pts
  end if
  if Pts >= ToLife then
    ToLife = ToLife + 1000
    ToLife = ToLife - Pts
    if Lives < 9 then
      inc Lives
      ShowLives
      play sound SndLife
    end if
  else
    ToLife = ToLife - Pts
  end if
  ShowScore
  return
end sub

' a bat or the ember on the cannon; or a cleared sky
sub Touches:
  Dead = 0
  for Di = 0 to 5
    if Bats[Di].Alive = 1 then
      W16 = Bats[Di].X
      V = Bats[Di].Y
      if HitsGun(W16 + 1, W16 + 22, V + 4, V + 13) = 1 then Dead = 1
    end if
  next
  if BmY > 0 then
    if HitsGun(BmX + 8, BmX + 15, BmY + 12, BmY + 20) = 1 then Dead = 1
  end if
  if Dead = 1 then
    Phase = 4
    Timer = 103
    ShN = 0
    play sound SndBoom
  else
    K = 0
    for Di = 0 to 5
      K = K + Bats[Di].Alive
    next
    if K = 0 and BmY = 0 then
      Phase = 3
      Timer = 100
      play sound SndLevel
    end if
  end if
  return
end sub

' 1 when the box X0-X1, Y0-Y1 touches the cannon's barrel or carriage
function HitsGun(u16 X0, u16 X1, u8 Y0, u8 Y1) as u8
  u8 Res = 0
  if X1 >= PX + 9 and X0 <= PX + 14 then
    if Y1 >= 202 and Y0 <= 211 then Res = 1
  end if
  if X1 >= PX + 2 and X0 <= PX + 21 then
    if Y1 >= 212 and Y0 <= 221 then Res = 1
  end if
  return Res

function Rand8 as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs & 255

' a new wave: the bats back to the top (alive), the cannon blinks
sub NewWave:
  for Di = 0 to 5
    Bats[Di].Alive = 1
    Bats[Di].Y = HomeY[Di] - 55
  next
  Phase = 1
  Timer = 70
  BmY = 0
  ShN = 0
  Acc = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing: C64 sprite pixels to the screen (X 5/7, Y 7/8)
function CvX(u16 Px) as u8
  Px = Px - 28
  Px = Px * 183
  Px = Px >> 8
  Cv = Px
  return Cv + 16

function CvY(u8 Py) as u8
  W16 = Py + 40
  W16 = W16 * 7
  W16 = W16 >> 3
  Cv = W16
  return Cv - 64

' sprites 0-1 the cannon (detail, body), 2 the shot, 3 the ember,
' 4-9 the bats, 10 the puff
sub DrawAll:
  X = CvX(PX)
  V = 1
  if Phase = 1 then
    K = Timer / 10
    V = K & 1
  end if
  if Phase = 4 then
    K = Anim & 8
    C = 11
    if K > 0 then C = 9
    set sprite 0 to 145,X,SBlast,C
    set sprite 1 to 192,0,0,0
  else
    if V = 1 then
      set sprite 0 to 145,X,SGunD,11
      set sprite 1 to 145,X,SGunB,14
    else
      set sprite 0 to 192,0,0,0
      set sprite 1 to 192,0,0,0
    end if
  end if
  if ShN > 1 then
    X = CvX(ShX)
    Y = CvY(ShY)
    set sprite 2 to Y - 1,X - 6,SShot,15
  else
    set sprite 2 to 192,0,0,0
  end if
  if BmY > 0 then
    X = CvX(BmX)
    Y = CvY(BmY)
    K = Anim / 10
    K = K & 1
    K = K * 4 + SEmber0
    set sprite 3 to Y - 1,X,K,9
  else
    set sprite 3 to 192,0,0,0
  end if
  K = Anim >> 3
  K = K & 3
  C = BeatT[K]
  for Di = 0 to 5
    J = Di + 4
    if Bats[Di].Alive = 1 then
      X = CvX(Bats[Di].X)
      Y = CvY(Bats[Di].Y)
      set sprite J to Y - 1,X,C,BatCol[Di]
    else
      set sprite J to 192,0,0,0
    end if
  next
  if PuffT > 0 then
    K = SPuff0
    if PuffT < 6 then K = SPuff1
    set sprite 10 to PuffY - 1,PuffX,K,15
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, Score
  print at 23,1, Hi
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 8,22, digits$(NumU, 2)
  return
end sub

sub ShowLives:
  fill TField count 9 at 20,22
  if Lives > 0 then
    fill TLife count Lives at 20,22
  end if
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 2,1, "SCORE"
  print at 20,1, "HI"
  print at 2,22, "LEVEL"
  print at 14,22, "LIVES"
  for Di = 0 to 5
    Bats[Di].X = StartX[Di]
    Bats[Di].DY = StartDy[Di]
    Bats[Di].DX = StartDx[Di]
  next
  Score = 0
  Lv = 1
  Lives = 3
  ToLife = 1000
  PX = 176
  Anim = 0
  PuffT = 0
  Kills = 0
  Drops = 0
  NewWave
  ShowScore
  ShowLevel
  ShowLives
  DrawAll
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SWOOP in moonlit stone, bats flapping past, START / CREDITS,
' the best score, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 256 to vram.name + 32
  print at 8,11, "AHOY! JUNE 1986"
  print at 13,15, "START"
  print at 13,16, "CREDITS"
  if Hi > 0 then
    print at 9,19, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  ' Rs has counted the title frames: the seed
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' three bats glide across under the title
sub TitleAnim:
  K = Tick >> 3
  K = K & 3
  C = BeatT[K]
  for Di = 0 to 2
    X = Tick + Di * 80
    V = X >> 4
    V = V & 7
    Y = 72 + V
    if X > 228 then Y = 192
    if X < 16 then Y = 192
    set sprite Di + 4 to Y,X,C,BatCol[Di]
  next
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,15
  put char 32 at 11,16
  J = Menu + 15
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "SWOOP"
  print at 2,5, "BASED ON SWOOP, AHOY!"
  print at 2,6, "JUNE 1986 (COMMODORE 64"
  print at 2,7, "MACHINE LANGUAGE)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: NIGHT FLIGHT"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

