' define DACMAN_DEBUG_SKIP_TITLE
' define DACMAN_DEBUG_NO_LIFE_LOSS
' define DACMAN_DEBUG_START_LAST_LEVEL
'define DACMAN_DEBUG_TRIGGER_END_SCENE

project "DacMan 2 Records Revision A"
' cartridge "DACMAN 2/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' DacMan 2 puzzle engine based on NewColeco's Dacman and the 2020 level editor.
' Original source: old-projects-sdcc-z80/sdcctest/dacman/
' Goal: native Amy logic, with legacy BIOS sound data kept as data labels until
' Amy gains a first-class syntax for BIOS sound tables.

picture DacmanTitlePicture:
  pattern from "@project/dacman2-title.pattern.zx0" codec zx0
  color from "@project/dacman2-title.color.zx0" codec zx0
end picture

asset DacmanGameColorRle from "@project/dacman-game.color.zx0" codec zx0
asset DacmanTileset from "@project/dacman2-tileset.pattern.bin" codec raw
asset DacmanNumbers from "@project/dacman-numbers.bin" codec raw
asset DacmanFont from "@project/dacman-font.bin" codec raw
asset DacmanDieze from "@project/dacman-dieze.bin" codec raw
asset DacmanEtoile from "@project/dacman-etoile.bin" codec raw
asset DacmanEmptyBoard from "@project/dacman2-empty-board.name.zx0" codec zx0
asset DacmanAgainBoard from "@project/dacman2-again.name.zx0" codec zx0
asset Dacman2Level1 from "@project/dacman2-level1.name.zx0" codec zx0
asset Dacman2Level2 from "@project/dacman2-level2.name.zx0" codec zx0
asset Dacman2Level3 from "@project/dacman2-level3.name.zx0" codec zx0
asset Dacman2Level4 from "@project/dacman2-level4.name.zx0" codec zx0
asset Dacman2Level5 from "@project/dacman2-level5.name.zx0" codec zx0
asset Dacman2Level6 from "@project/dacman2-level6.name.zx0" codec zx0
asset Dacman2Level7 from "@project/dacman2-level7.name.zx0" codec zx0
asset Dacman2Level8 from "@project/dacman2-level8.name.zx0" codec zx0
asset Dacman2Level9 from "@project/dacman2-level9.name.zx0" codec zx0
asset Dacman2Level10 from "@project/dacman2-level10.name.zx0" codec zx0
asset Dacman2Level11 from "@project/dacman2-level11.name.zx0" codec zx0
asset Dacman2Level12 from "@project/dacman2-level12.name.zx0" codec zx0

const BoardLeft = 6
const BoardTop = 2
const BoardWidth = 19
const BoardHeight = 21
const PlayableLevelCount = 12
const EmptyScreenIndex = 15
const AgainScreenIndex = 16
const WallMask = $80
const DotTile = $A0
const PowerDotTile = $A1
const PacRightTile = $A2
const PacDownTile = $A3
const PacLeftTile = $A4
const PacUpTile = $A5
const PacClosedTile = $A6
const FirstGhostTile = $AB
const GhostCount = 5
const LastGhostTile = $AF
const BlueGhostTile = $74
const BarrierTile = $70
const LockTile = $71
const TeleporterTile = $72
const KeyTile = $73
const FruitMapMarkerTile = $00
const FruitMarkerMask = $B0
const FirstLevelFruitTile = $B0
const LastLevelFruitTile = $BB
const ImmuneGhostTile = $75
const DecorFlowerTile = $76
const DecorHerbTile = $77
const DecorHeartTile = $78
const DecorDiamondTile = $79
const DecorClubTile = $7A
const DecorSpadeTile = $7B
const DecorSmileyTile = $7C
const DecorAnimalTile = $7D
const MaxTeleporters = 16
const GhostAlive = 0
const GhostEyesTravel = 1
const GhostEyesWaiting = 2
const GhostInactive = 3
const BluePhaseNormal = 0
const BluePhaseVulnerable = 1
const BluePhaseFlashing = 2
const BlueFlashDuration = 36
const NoGhost = GhostCount
const GhostEyesPattern = 0
const MissSprite = 5
const SecondMissSprite = 6
const MissColor = $08

record GhostActor:
  u8 Direction
  u8 X
  u8 Y
  u8 HomeX
  u8 HomeY
  u8 HiddenTile
  u8 Vulnerable
  u8 MoveTimer
  u8 Immune
  u8 State
  u8 EyeX
  u8 EyeY
  u8 EyeTimer
end record

GhostActor Ghosts[5]

' A typed ROM template replaces thirteen field assignments per ghost at level load.
data InitialGhosts records GhostActor
  0,0,0,0,0,32,0,255,0,GhostInactive,0,207,0
  0,0,0,0,0,32,0,255,0,GhostInactive,0,207,0
  0,0,0,0,0,32,0,255,0,GhostInactive,0,207,0
  0,0,0,0,0,32,0,255,0,GhostInactive,0,207,0
  0,0,0,0,0,32,0,255,0,GhostInactive,0,207,0
end data
u16 Score = 0
u16 Hiscore = 0
u16 Dots = 0
u16 NextLife = 1000
u8 PacLifes = 6
u8 Level = 0
u8 Playing = 0
u8 Flashing = 0
u8 EasyMode = 0
u8 EasyCodeStep = 0
u8 TitleKey = 255
u8 TitleLastKey = 255
u8 BonusGame = 0
u8 Difficulty = 2
u8 BaseMoveDelay = 9
u8 BlueDuration = 210
u8 BluePhase = BluePhaseNormal
u8 BluePhaseTimer = 0
u8 VulnerableGhostCount = 0
u8 BlueTickPhase = 0
u8 BlueFlashCounter = 0
u8 BlueFlashWhite = 0
u8 BlueMusicPlaying = 0
u8 PacMoveTimer = 1
u8 PacAteDot = 0
u8 PacUnderTile = 32
u8 Keys = 0
u8 TeleporterCount = 0
u8 TeleporterX[16]
u8 TeleporterY[16]
u8 TeleporterIndex = 0
u8 FruitHistory[PlayableLevelCount]
u8 MenuPad = 0
u8 MenuLastPad = 0
u8 NoLevel = 0
u8 NbpacLifes = 6
u16 Bonus = 20
u8 ScreenDataIndex = 0
u16 BoardSourceOffset = 128
u16 BoardTargetOffset = 0

u8 PacX = 0
u8 PacY = 0

u8 X = 0
u8 Y = 0
u8 I = 0
u8 G = 0
u8 C = 0
u8 Tmp = 0
u8 Tmp2 = 0
u8 Wall = 0
u8 Nd = 0
u8 Number = 0
u8 Ok = NoGhost
u8 Cpac = 0
u8 PacLookPattern = 1
u8 Ncpac = 0
u8 Px = 0
u8 Py = 0
u8 Opx = 0
u8 Opy = 0
u8 Dpx = 0
u8 Dpy = 0
u8 Ndpx = 0
u8 Ndpy = 0
u16 DataPtr = 0
u16 RowPtr = 0
u16 WaitCount = 0
u8 RowIndex = 0
u8 LifeIndex = 0


data DacmanBlueDurations bytes = 240,210,180,150
data DacmanEasyCodeKeys bytes = 10,3,2,7,9,11
data DacmanDirectionBits bytes = 1,2,4,8
data DacmanLookPatterns bytes = 3,7,1,5

data DacmanGOffset bytes = 0,16,32,0,48,0,0,0,64

data DacmanGhostDirections bytes
  $00,$01,$02,$FD,$04,$FB,$FA,$F9,$08,$F7,$F6,$F5,$F4,$F3,$F2,$F1
  $00,$01,$02,$01,$04,$01,$02,$FD,$08,$01,$F6,$01,$08,$F7,$F6,$F5
  $00,$01,$02,$02,$04,$FB,$02,$02,$08,$01,$02,$FD,$04,$FB,$FA,$F9
  $00,$01,$02,$02,$04,$04,$04,$FA,$08,$08,$F6,$F6,$04,$F4,$04,$F2
  $00,$01,$02,$01,$04,$FB,$04,$FB,$08,$08,$08,$F7,$08,$08,$F4,$F3
end data

data DacmanDx bytes
  $00,$01,$00,$00,$FF,$00,$00,$00,$00
end data

data DacmanDy bytes
  $00,$00,$01,$00,$00,$00,$00,$00,$FF
end data

data DacmanSpritePatterns bytes
  $00,$00,$24,$5A,$5A,$24,$00,$00 ' independent white ghost eyes sprite$AF
  $06,$05,$03,$80,$80,$00,$00,$00 ' Miss DacMan closed left
  $06,$05,$43,$00,$00,$40,$00,$00 ' Miss DacMan open left
  $60,$A0,$C0,$01,$01,$00,$00,$00 ' closed right
  $60,$A0,$C2,$00,$00,$02,$00,$00 ' open right
  $18,$00,$00,$00,$00,$03,$05,$06 ' closed up
  $00,$24,$00,$00,$00,$03,$05,$06 ' open up
  $60,$A0,$C0,$00,$00,$00,$00,$18 ' closed down
  $60,$A0,$C0,$00,$00,$00,$24,$00 ' open down
end data

' Twelve playable levels currently use ten unique maps; reserved slots keep the special screens at indices 15 and 16.
data DacmanScreenData words
  @Dacman2Level1,@Dacman2Level2,@Dacman2Level3,@Dacman2Level4,
  @Dacman2Level5,@Dacman2Level6,@Dacman2Level7,@Dacman2Level8,
  @Dacman2Level9,@Dacman2Level10,@Dacman2Level11,@Dacman2Level12,
  @Dacman2Level1,@Dacman2Level2,@Dacman2Level3,
  @DacmanEmptyBoard,@DacmanAgainBoard
end data


sub start:
  mode 2 screen
  set sound table DacmanSoundTable areas 4
  DacmanInitGraphics
DacmanMainMenu:
ifdef DACMAN_DEBUG_SKIP_TITLE
else ifdef
  DacmanShowTitle
  DacmanSelectDifficulty
end ifdef
  DacmanGame
  goto DacmanMainMenu
end sub

sub DacmanInitGraphics:
  screen off
  mode 2 screen
  sprites 8x8
  sprites simple
  cls
  fill 0 count 8 to vram.pattern + FruitMapMarkerTile * 8
  copy DacmanNumbers count 80 to vram.pattern + 48 * 8
  copy DacmanFont count 224 to vram.pattern + 65 * 8
  copy DacmanDieze count 8 to vram.pattern + 35 * 8
  copy DacmanEtoile count 8 to vram.pattern + 42 * 8
  copy DacmanTileset count 800 to vram.pattern + BarrierTile * 8
  duplicate mode 2 patterns
  decompress DacmanGameColorRle to vram.color
  copy DacmanSpritePatterns count 72 to vram.spr_pat
  backdrop black
  screen on
  return


sub DacmanShowTitle:
  EasyCodeStep = 0
  TitleLastKey = 255
DacmanTitleCycle:
  show picture DacmanTitlePicture
  play sound 10
  WaitCount = 700
DacmanTitleWait:
  if joypad(1).button1 then goto DacmanTitleDone
  TitleKey = keypad(1)
  if TitleKey = 255 then
    TitleLastKey = 255
  elseif TitleLastKey = 255 then
    DacmanCheckEasyCode
    TitleLastKey = TitleKey
  end if
  if WaitCount = 0 then goto DacmanTitleCycle
  wait
  WaitCount -= 1
  goto DacmanTitleWait

DacmanTitleDone:
  mute all
  wait no fire
  DacmanInitGraphics
  return

sub DacmanCheckEasyCode:
  if TitleKey = DacmanEasyCodeKeys[EasyCodeStep] then
    EasyCodeStep += 1
    if EasyCodeStep = 6 then
      EasyMode = 1
      play sound 9
      EasyCodeStep = 0
    end if
  else
    EasyCodeStep = 0
  end if
  return

sub DacmanSelectDifficulty:
  nmi off
  Difficulty = 2
  MenuLastPad = 0
  cls
  print centered at 3, "SELECT SKILL"
  print at 11,8, "1 EASY"
  print at 11,11, "2 NORMAL"
  print at 11,14, "3 HARD"
  print at 11,17, "4 EXPERT"
  print centered at 21, "UP/DOWN AND FIRE"
  DacmanDrawDifficulty
  nmi on
DacmanDifficultyLoop:
  wait
  MenuPad = joypad(1)
  if joypad(1).up then
    if MenuLastPad = 0 then
      if Difficulty > 1 then Difficulty -= 1
      MenuLastPad = 1
      DacmanDrawDifficulty
    end if
  elseif joypad(1).down then
    if MenuLastPad = 0 then
      if Difficulty < 4 then Difficulty += 1
      MenuLastPad = 1
      DacmanDrawDifficulty
    end if
  elseif joypad(1).fire then
    BaseMoveDelay = 11 - Difficulty
    BlueDuration = DacmanBlueDurations[Difficulty - 1]
    wait no fire
    nmi off
    return
  end if
  if MenuPad = 0 then MenuLastPad = 0 else MenuLastPad = 1
  goto DacmanDifficultyLoop

sub DacmanDrawDifficulty:
  for I = 1 to 4
    if I = Difficulty then
      put char $2A at 9,5 + I * 3
    else
      put char $20 at 9,5 + I * 3
    end if
  next
  return

sub DacmanGame:
DacmanRestartGame:
  cls
  Score = 0
  Level = NoLevel
ifdef DACMAN_DEBUG_START_LAST_LEVEL
  Level = PlayableLevelCount - 1
end ifdef
  if EasyMode != 0 then
    PacLifes = 99
  else
    PacLifes = NbpacLifes
  end if
  NextLife = 1000
  fill array FruitHistory with 0 count PlayableLevelCount
  print centered at 0, "HIGH SCORE"
  print at 1,22, "SCORE"
  DacmanPutHiscore
  DacmanAddScore0
  DacmanPutLives
ifdef DACMAN_DEBUG_TRIGGER_END_SCENE
  DacmanTheEnd
  return
end ifdef
DacmanNewBoard:
  DacmanPutBoard
  DacmanInitLevel
  DacmanDrawStatus
  DacmanCountDots
DacmanContinueLevel:
  play sound 1
  play sound 2
  WaitCount = 318
  DacmanWaitGameplayFrames
  DacmanPacmanPlay
  stop sound 3
  stop sound 4
  if Ok = 15 then goto DacmanLevelClear
  DacmanPacmanDead
ifdef DACMAN_DEBUG_NO_LIFE_LOSS
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
else ifdef
  if PacLifes = 0 then goto DacmanGameOver
  PacLifes -= 1
  DacmanPutLives
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
end ifdef
DacmanLevelClear:
  DacmanFlashBoardClear
  if Level = PlayableLevelCount - 1 then
    DacmanTheEnd
    return
  end if
  Level += 1
  goto DacmanNewBoard
DacmanGameOver:
  mute all
  Playing = 1
  print at 11,11, "GAME OVER"
  Score = 0
  WaitCount = 0
DacmanGameOverWait:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  if WaitCount = 450 then goto DacmanGameOverAgainBoard
  wait
  DacmanVblank
  WaitCount += 1
  goto DacmanGameOverWait
DacmanGameOverAgainBoard:
  clear sprites
  update sprites
  DacmanDrawBoardAgain
  WaitCount = 0
DacmanAgainLoop:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  WaitCount += 1
  if WaitCount = 12 then
    put char PacClosedTile at 9,16
  end if
  if WaitCount = 24 then
    put char PacRightTile at 9,16
    WaitCount = 0
  end if
  wait
  DacmanVblank
  wait
  DacmanVblank
  goto DacmanAgainLoop
end sub

sub DacmanDrawStatus:
  Tmp = Level + 1
  print at 26,7, "LEVEL"
  print Tmp at 28,8 digits 2
  print at 26,10, "KEYS"
  print Keys at 28,11 digits 2
  DacmanDrawFruitHistory
  return

sub DacmanDrawFruitHistory:
  fill 32 count 16 to vram.name + 23 * 32 + 8
  Tmp = Level
  if Tmp > PlayableLevelCount - 1 then Tmp = PlayableLevelCount - 1
  for I = 0 to Tmp
    if FruitHistory[I] != 0 then
      put char FirstLevelFruitTile + I at 23 - I,23
    end if
  next
  return

sub DacmanPutHiscore:
  print Hiscore at 13,1 digits 5
  put char 48 at 18,1
  return

sub DacmanAddScore0:
  DacmanAddScore
  return

sub DacmanAddScore:
  Score += Tmp
  print Score at 1,23 digits 5
  put char 48 at 6,23
  if Hiscore < Score then
    Hiscore = Score
    DacmanPutHiscore
  end if
  if NextLife > 0 then
    if Score >= NextLife then
      PacLifes += 1
      play sound 9
      DacmanPutLives
      if NextLife > 8000 then NextLife = 0 else NextLife = NextLife * 2
    end if
  end if
  Tmp = 0
  return

sub DacmanPutLives:
  Tmp = PacLifes
  if Tmp > 6 then Tmp = 6
  fill 32 count 6 to vram.name + 23 * 32 + 25
  if Tmp = 0 then return
  for LifeIndex = 0 to Tmp - 1
    put char PacLeftTile at 25 + LifeIndex,23
  next
  return

sub DacmanPutBoard:
  ScreenDataIndex = Level
  DacmanLoadScreenData
  return

sub DacmanDrawBoardVide:
  ScreenDataIndex = EmptyScreenIndex
  DacmanLoadScreenData
  return

sub DacmanDrawBoardAgain:
  ScreenDataIndex = AgainScreenIndex
  DacmanLoadScreenData
  return

sub DacmanLoadScreenData:
  decompress zx0 DacmanScreenData[ScreenDataIndex] to vram.spr_attr + 128
  BoardSourceOffset = 128
  BoardTargetOffset = BoardTop * 32 + BoardLeft
  for I = 0 to BoardHeight - 1
    copy vram.spr_attr + BoardSourceOffset count 19 to vram.name + BoardTargetOffset
    BoardSourceOffset += BoardWidth
    BoardTargetOffset += 32
  next
  return

sub DacmanInitLevel:
  Playing = 0
  Keys = 0
  TeleporterCount = 0
  PacUnderTile = 32
  DacmanResetBlueState
  clear sprites
  set sprite count 7
  copy InitialGhosts to Ghosts
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = FruitMapMarkerTile then
        C = FirstLevelFruitTile + (Level & 15)
        put char C at X,Y
      end if
      if C = TeleporterTile then
        if TeleporterCount < MaxTeleporters then
          TeleporterX[TeleporterCount] = X
          TeleporterY[TeleporterCount] = Y
          TeleporterCount += 1
        end if
      end if
      if C >= FirstGhostTile then
        if C <= LastGhostTile then
          G = C - FirstGhostTile
          Ghosts[G].X = X
          Ghosts[G].Y = Y
          Ghosts[G].HomeX = X
          Ghosts[G].HomeY = Y
          Ghosts[G].MoveTimer = 1
          Ghosts[G].State = GhostAlive
        end if
      end if
      if C >= PacRightTile then
        if C <= PacClosedTile then
          PacX = X
          PacY = Y
        end if
      end if
    next
  next
  for G = 0 to GhostCount - 1
    set sprite G to 207,0,GhostEyesPattern,15
  next
  update sprites
  set sprite MissSprite to 207,0,1,MissColor
  set sprite SecondMissSprite to 207,0,1,MissColor
  update sprites
  Playing = 1
  return

sub DacmanCountDots:
  Playing = 0
  nmi off
  Dots = 0
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = DotTile then Dots += 1
      if C = PowerDotTile then Dots += 1
    next
  next
  nmi on
  Playing = 1
  return


sub DacmanWaitGameplayFrames:
DacmanWaitGameplayLoop:
  if WaitCount = 0 then return
  wait
  DacmanVblank
  WaitCount -= 1
  goto DacmanWaitGameplayLoop
end sub
sub DacmanRestartActorsAfterDeath:
  WaitCount = 16
  DacmanWaitGameplayFrames
  for each Ghost, G in Ghosts
    if Ghost.State = GhostAlive then
      put char Ghost.HiddenTile at Ghost.X,Ghost.Y
    end if
    Ghost.X = Ghost.HomeX
    Ghost.Y = Ghost.HomeY
    Ghost.HiddenTile = 32
    Ghost.Vulnerable = 0
    if Ghost.HomeX = 0 then Ghost.State = GhostInactive else Ghost.State = GhostAlive
    Ghost.EyeTimer = 0
    set sprite G to 207,0,GhostEyesPattern,15
  next
  update sprites
  for each Ghost, G in Ghosts
    if Ghost.State = GhostAlive then
      put char FirstGhostTile + G at Ghost.X,Ghost.Y
    end if
  next
  PacUnderTile = 32
  put char PacLeftTile at PacX,PacY
  return

sub DacmanPacmanPlay:
  Px = PacX
  Py = PacY
  Cpac = PacLeftTile
  PacLookPattern = 1
  Dpx = 2
  Dpy = 0
  DacmanUpdateLook
  update sprites
  play sound 3
  DacmanResetBlueState
  PacMoveTimer = 1
  fill record array Ghosts field MoveTimer with 1
  Ok = NoGhost
  if Dots = 0 then Ok = 15
DacmanPlayLoop:
  wait
  DacmanVblank
  if Ok != NoGhost then return
  if Dots = 0 then Ok = 15
  if Ok != NoGhost then return
  if keypad(1) = 10 then
    goto DacmanPauseLoop
  end if
  if keypad(1) = 5 then
    goto DacmanBuyLife
  end if
  C = joypad(1) & $0F
  Ndpx = 0
  Ndpy = 0
  if C & $01 then Ndpy = 2
  if C & $04 then Ndpy = 1
  if C & $02 then Ndpx = 1
  if C & $08 then Ndpx = 2
  if PacMoveTimer > 0 then PacMoveTimer -= 1
  if PacMoveTimer = 0 then
    DacmanChoosePacDirection
    put char Cpac at Px,Py
    DacmanMovePac
    if Ok != NoGhost then return
    PacMoveTimer = BaseMoveDelay - 2
    if PacAteDot != 0 then PacMoveTimer = BaseMoveDelay
  end if
  DacmanUpdateGhosts
  if Dots = 0 then Ok = 15
  goto DacmanPlayLoop
DacmanPauseLoop:
  wait no fire
DacmanPauseWait:
  if keypad(1) = 10 then goto DacmanPlayLoop
  wait
  goto DacmanPauseWait
DacmanBuyLife:
  if Score >= 2000 then
    Score -= 2000
    Tmp = 0
    DacmanAddScore
    PacLifes += 1
    play sound 9
    DacmanPutLives
  end if
  goto DacmanPlayLoop
end sub

sub DacmanChoosePacDirection:
  if Ndpx = 0 then
    if Ndpy = 0 then return
  end if
  Opx = Px
  Opy = Py
  if Ndpx = 1 then Opx += 1
  if Ndpx = 2 then Opx -= 1
  if Ndpx != 0 then
    DacmanWrapOpx
    C = get char at Opx,Opy
    if (C & $F0) = WallMask or C = BarrierTile then Ndpx = 0
    if C = LockTile then
      if Keys = 0 then Ndpx = 0
    end if
  end if
  Opx = Px
  Opy = Py
  if Ndpy = 1 then Opy += 1
  if Ndpy = 2 then Opy -= 1
  if Ndpy != 0 then
    DacmanWrapOpy
    C = get char at Opx,Opy
    if (C & $F0) = WallMask or C = BarrierTile then Ndpy = 0
    if C = LockTile then
      if Keys = 0 then Ndpy = 0
    end if
  end if
  if Ndpx = 0 then
    if Ndpy != 0 then
      Dpx = 0
      Dpy = Ndpy
      return
    end if
  end if
  if Ndpy = 0 then
    if Ndpx != 0 then
      Dpx = Ndpx
      Dpy = 0
      return
    end if
  end if
  if Ndpx = Dpx then
    Dpx = 0
    Dpy = Ndpy
    return
  end if
  if Ndpy = Dpy then
    Dpx = Ndpx
    Dpy = 0
    return
  end if
  if Dpx = 0 then
    if Dpy = 0 then
      Number = random(0,1)
      if Number = 0 then
        Dpx = Ndpx
        Dpy = 0
      else
        Dpy = Ndpy
        Dpx = 0
      end if
      return
    end if
  end if
  if Dpx != 0 then Dpx = 3 - Dpx
  if Dpy != 0 then Dpy = 3 - Dpy
  return

sub DacmanMovePac:
  PacAteDot = 0
  Ncpac = PacClosedTile
  Opx = Px
  if Dpx = 1 then
    Opx += 1
    Ncpac = PacRightTile
  end if
  if Dpx = 2 then
    Opx -= 1
    Ncpac = PacLeftTile
  end if
  DacmanWrapOpx
  Opy = Py
  if Dpy = 1 then
    Opy += 1
    Ncpac = PacDownTile
  end if
  if Dpy = 2 then
    Opy -= 1
    Ncpac = PacUpTile
  end if
  DacmanWrapOpy
  C = get char at Opx,Opy
  if (C & $F0) = WallMask or C = BarrierTile then
    Dpx = 0
    Dpy = 0
    return
  end if
  if C = LockTile then
    if Keys = 0 then return
  end if
  if Dpx = 0 then
    if Dpy = 0 then return
  end if
  if Ncpac >= PacRightTile then
    if Ncpac <= PacUpTile then PacLookPattern = DacmanLookPatterns[Ncpac - PacRightTile]
  end if
  put char PacUnderTile at Px,Py
  Px = Opx
  Py = Opy
  if Cpac = Ncpac then Cpac = PacClosedTile else Cpac = Ncpac
  Tmp2 = 0
  if C > FirstGhostTile - 1 then
    if C <= LastGhostTile then
      Ok = C - FirstGhostTile
      return
    end if
  end if
  if C = BlueGhostTile then
    DacmanWhichGhost
    Tmp2 = G + 1
    Number = Ghosts[G].HiddenTile
    DacmanStartGhostEyes
    C = Number
  end if
  if C = ImmuneGhostTile then
    DacmanWhichGhost
    Ok = G
    return
  end if
  if C = DotTile then
    Tmp = 1
    DacmanGobDot
    DacmanConsumeHiddenTile
    C = 32
  end if
  if C = PowerDotTile then
    Tmp = 5
    DacmanGobDot
    DacmanConsumeHiddenTile
    C = 32
    DacmanStartBluePhase
    Bonus = 20
  end if
  if C = KeyTile then
    Keys += 1
    play sound 15
    DacmanDrawStatus
    DacmanConsumeHiddenTile
    C = 32
  end if
  if C = LockTile then
    Keys -= 1
    play sound 14
    DacmanDrawStatus
    C = 32
  end if
  if (C & $F0) = FruitMarkerMask then
    FruitHistory[Level & 15] = 1
    Tmp = Level + 1
    Tmp *= 10
    DacmanAddScore
    DacmanConsumeHiddenTile
    DacmanDrawFruitHistory
    C = 32
    play sound 7
  end if
  if C = TeleporterTile then DacmanUseTeleporter
  PacUnderTile = C
  put char Cpac at Px,Py
  return


sub DacmanUseTeleporter:
  if TeleporterCount < 2 then return
  TeleporterIndex = 0
DacmanFindTeleporter:
  if TeleporterX[TeleporterIndex] = Px then
    if TeleporterY[TeleporterIndex] = Py then goto DacmanTeleportFound
  end if
  TeleporterIndex += 1
  if TeleporterIndex < TeleporterCount then goto DacmanFindTeleporter
  return
DacmanTeleportFound:
  if Dpx = 1 then goto DacmanTeleportNext
  if Dpy = 1 then goto DacmanTeleportNext
  if TeleporterIndex = 0 then TeleporterIndex = TeleporterCount - 1 else TeleporterIndex -= 1
  goto DacmanTeleportMove
DacmanTeleportNext:
  TeleporterIndex += 1
  if TeleporterIndex >= TeleporterCount then TeleporterIndex = 0
DacmanTeleportMove:
  play sound 16
  Px = TeleporterX[TeleporterIndex]
  Py = TeleporterY[TeleporterIndex]
  C = TeleporterTile
  return

sub DacmanConsumeHiddenTile:
  if Tmp2 = 0 then return
  I = Tmp2 - 1
  with Ghosts[I] as Ghost
  Ghost.HiddenTile = 32
  return

  end with
sub DacmanResetBlueState:
  BluePhase = BluePhaseNormal
  BluePhaseTimer = 0
  VulnerableGhostCount = 0
  BlueTickPhase = 0
  BlueFlashCounter = 0
  BlueFlashWhite = 0
  BlueMusicPlaying = 0
  return

sub DacmanStartBluePhase:
  VulnerableGhostCount = 0
  for each Ghost, G in Ghosts
    Ghost.Vulnerable = 0
    if Ghost.State = GhostAlive then
      if Ghost.Immune = 0 then
        Ghost.Vulnerable = 1
        VulnerableGhostCount += 1
      end if
    end if
  next
  if VulnerableGhostCount = 0 then
    DacmanEndBluePhase
    return
  end if
  stop sound 3
  stop sound 4
  play sound 4
  BlueMusicPlaying = 1
  BluePhase = BluePhaseVulnerable
  BluePhaseTimer = BlueDuration - BlueFlashDuration
  BlueTickPhase = 0
  BlueFlashCounter = 0
  BlueFlashWhite = 0
  return

sub DacmanUpdateBluePhase:
  if BluePhase = BluePhaseNormal then return
  if VulnerableGhostCount = 0 then
    DacmanEndBluePhase
    return
  end if
  if BlueTickPhase = 0 then BlueTickPhase = 1 else BlueTickPhase = 0
  if BlueTickPhase != 0 then return
  if BluePhaseTimer > 0 then BluePhaseTimer -= 1
  if BluePhaseTimer > 0 then return
  if BluePhase = BluePhaseVulnerable then
    BluePhase = BluePhaseFlashing
    BluePhaseTimer = BlueFlashDuration
    BlueFlashCounter = 0
    BlueFlashWhite = 0
    return
  end if
  DacmanEndBluePhase
  return

sub DacmanEndBluePhase:
  fill record array Ghosts field Vulnerable with 0
  fill mode 2 color thirds at BlueGhostTile count 1 with $41
  if BlueMusicPlaying != 0 then
    stop sound 4
    stop sound 3
    play sound 3
  end if
  DacmanResetBlueState
  return

sub DacmanUpdateGhosts:
  DacmanUpdateGhostEyes
  DacmanUpdateBluePhase
  for each Ghost, G in Ghosts
    if Ghost.State = GhostAlive then
      if Ghost.MoveTimer > 0 then Ghost.MoveTimer -= 1
      if Ghost.MoveTimer = 0 then
        DacmanMoveOneGhost
        DacmanReloadGhostTimer
      end if
    end if
  next
  return
sub DacmanReloadGhostTimer:
  with Ghosts[G] as Ghost
  if Ghost.Immune != 0 then
    Ghost.MoveTimer = BaseMoveDelay - 2
  else
    if Ghost.Vulnerable > 0 then
      Ghost.MoveTimer = BaseMoveDelay + 1
    else
      Ghost.MoveTimer = BaseMoveDelay - 1
    end if
  end if
  return

  end with
sub DacmanMoveOneGhost:
  with Ghosts[G] as Ghost
    Wall = $0F
    X = Ghost.X + 1
    Y = Ghost.Y
    if X > 24 then X = 6
    C = get char at X,Y
    if (C & $F0) = WallMask or (C & $F8) = $A8 or C = BlueGhostTile or C = ImmuneGhostTile or C = LockTile or C = TeleporterTile then Wall -= 1
    X = Ghost.X
    Y = Ghost.Y + 1
    if Y > 22 then Y = 2
    C = get char at X,Y
    if (C & $F0) = WallMask or (C & $F8) = $A8 or C = BlueGhostTile or C = ImmuneGhostTile or C = LockTile or C = TeleporterTile then Wall -= 2
    X = Ghost.X - 1
    Y = Ghost.Y
    if X < 6 then X = 24
    C = get char at X,Y
    if (C & $F0) = WallMask or (C & $F8) = $A8 or C = BlueGhostTile or C = ImmuneGhostTile or C = LockTile or C = TeleporterTile then Wall -= 4
    X = Ghost.X
    Y = Ghost.Y - 1
    if Y < 2 then Y = 22
    C = get char at X,Y
    if (C & $F0) = WallMask or (C & $F8) = $A8 or C = BlueGhostTile or C = ImmuneGhostTile or C = LockTile or C = TeleporterTile then Wall -= 8
    DacmanChooseGhostDirection
    put char Ghost.HiddenTile at Ghost.X,Ghost.Y
    Tmp = DacmanDx[Nd]
    if Tmp = 255 then Ghost.X -= 1 else Ghost.X += Tmp
    if Ghost.X < 6 then Ghost.X = 24
    if Ghost.X > 24 then Ghost.X = 6
    Tmp = DacmanDy[Nd]
    if Tmp = 255 then Ghost.Y -= 1 else Ghost.Y += Tmp
    if Ghost.Y < 2 then Ghost.Y = 22
    if Ghost.Y > 22 then Ghost.Y = 2
    C = get char at Ghost.X,Ghost.Y
    if C > PacRightTile - 1 then
      if C < PacClosedTile + 1 then
        if Ghost.Vulnerable > 0 then
          C = PacUnderTile
          Ghost.HiddenTile = 32
          DacmanStartGhostEyes
          put char Cpac at Px,Py
          return
        else
          C = PacUnderTile
          Ok = G
        end if
      end if
    end if

    if (C & $F0) = FruitMarkerMask then
      C = 32
      if Ghost.Vulnerable > 0 then
        if VulnerableGhostCount > 0 then VulnerableGhostCount -= 1
      end if
      Ghost.Vulnerable = 0
      Ghost.Immune = 1
      if VulnerableGhostCount = 0 then
        if BluePhase != BluePhaseNormal then DacmanEndBluePhase
      end if
    end if
    Ghost.HiddenTile = C
    Ghost.Direction = Nd
    if Ghost.Vulnerable > 0 then
      put char BlueGhostTile at Ghost.X,Ghost.Y
    else
      if Ghost.Immune != 0 then
        put char ImmuneGhostTile at Ghost.X,Ghost.Y
      else
        put char FirstGhostTile + G at Ghost.X,Ghost.Y
      end if
    end if
  return

  end with
sub DacmanChooseGhostDirection:
  with Ghosts[G] as Ghost
  Tmp = DacmanGOffset[Ghost.Direction]
  Number = Tmp + Wall
  Nd = DacmanGhostDirections[Number]
DacmanGhostChoiceLoop:
  if Nd <= 8 then return
  Wall = 0 - Nd
  Number = random(0,3)
  Tmp = Wall & DacmanDirectionBits[Number]
  if Tmp != 0 then Nd = Tmp
  goto DacmanGhostChoiceLoop
  end with
end sub
sub DacmanWhichGhost:
  G = 0
DacmanWhichGhostLoop:
  if Ghosts[G].X = Opx then
    if Ghosts[G].Y = Opy then return
  end if
  if G = GhostCount - 1 then return
  G += 1
  goto DacmanWhichGhostLoop
end sub

sub DacmanStartGhostEyes:
  with Ghosts[G] as Ghost
  Tmp = Bonus
  DacmanAddScore
  play sound 8
  Bonus = Bonus * 2
  Ghost.State = GhostEyesTravel
  Ghost.EyeX = Ghost.X * 8
  Ghost.EyeY = Ghost.Y * 8 - 1
  Ghost.EyeTimer = 2
  if Ghost.Vulnerable > 0 then
    if VulnerableGhostCount > 0 then VulnerableGhostCount -= 1
  end if
  Ghost.Vulnerable = 0
  Ghost.Immune = 0
  set sprite G to Ghost.EyeY,Ghost.EyeX,GhostEyesPattern,15
  update sprites
  if VulnerableGhostCount = 0 then
    if BluePhase != BluePhaseNormal then DacmanEndBluePhase
  end if
  return

  end with
sub DacmanUpdateGhostEyes:
  for each Ghost, G in Ghosts
    if Ghost.State = GhostEyesTravel then
      if Ghost.EyeTimer > 0 then Ghost.EyeTimer -= 1
      if Ghost.EyeTimer = 0 then
        Ghost.EyeTimer = 2
        X = Ghost.HomeX * 8
        Y = Ghost.HomeY * 8 - 1
        if Ghost.EyeX < X then Ghost.EyeX += 2
        if Ghost.EyeX > X then Ghost.EyeX -= 2
        if Ghost.EyeY < Y then Ghost.EyeY += 2
        if Ghost.EyeY > Y then Ghost.EyeY -= 2
        if Ghost.EyeX = X then
          if Ghost.EyeY = Y then Ghost.State = GhostEyesWaiting
        end if
      end if
    end if
    if Ghost.State = GhostEyesWaiting then
      Tmp = 0
      if Px = Ghost.HomeX then
        if Py = Ghost.HomeY then Tmp = 1
      end if
      for each OtherGhost, I in Ghosts
        if I != G then
          if OtherGhost.State = GhostAlive then
            if OtherGhost.X = Ghost.HomeX then
              if OtherGhost.Y = Ghost.HomeY then Tmp = 1
            end if
          end if
        end if
      next
      if Tmp = 0 then
        Ghost.X = Ghost.HomeX
        Ghost.Y = Ghost.HomeY
        C = get char at Ghost.X,Ghost.Y
        Ghost.HiddenTile = C
        Ghost.Vulnerable = 0
        Ghost.Immune = 0
        Ghost.MoveTimer = 1
        Ghost.State = GhostAlive
        put char FirstGhostTile + G at Ghost.X,Ghost.Y
        set sprite G to 207,0,GhostEyesPattern,15
      end if
    end if
    if Ghost.State != GhostAlive then
      set sprite G to Ghost.EyeY,Ghost.EyeX,GhostEyesPattern,15
    end if
  next
  DacmanUpdateLook
  update sprites
  return

sub DacmanUpdateLook:
  ' Movement may stop at a wall; PacLookPattern keeps the last valid orientation.
  Number = PacLookPattern
  if Cpac != PacClosedTile then Number += 1
  X = Px * 8
  Y = Py * 8 - 1
  set sprite MissSprite to Y,X,Number,MissColor
  return


sub DacmanGobDot:
  PacAteDot = 1
  DacmanAddScore
  stop sound 6
  play sound 6
  Dots = Dots - 1
  return

sub DacmanWrapOpx:
  if Opx < 6 then Opx = 24
  if Opx > 24 then Opx = 6
  return

sub DacmanWrapOpy:
  if Opy < 2 then Opy = 22
  if Opy > 22 then Opy = 2
  return

sub DacmanPacmanDead:
  with Ghosts[Ok] as Ghost
  set sprite MissSprite to 207,0,1,MissColor
  set sprite SecondMissSprite to 207,0,1,MissColor
  update sprites
  mute all
  play sound 5
  for C = $C0 to $D0
    put char C at Ghost.X,Ghost.Y
    wait 2 frames
  next
  for Tmp = 0 to 1
    for C = $D1 to $D3
      put char C at Ghost.X,Ghost.Y
      wait 3 frames
    next
  next
  wait 20 frames
  put char FirstGhostTile + Ok at Ghost.X,Ghost.Y
  return

  end with
sub DacmanFlashBoardClear:
  define chars DacmanTileset + 256 at 128 count 16
  wait 24 frames
  define chars DacmanTileset + 128 at 128 count 16
  wait 24 frames
  define chars DacmanTileset + 256 at 128 count 16
  wait 24 frames
  define chars DacmanTileset + 128 at 128 count 16
  return

sub DacmanTheEnd:
  mute all
  Playing = 0
  DacmanDrawBoardVide
  set sprite count 7
  for G = 0 to GhostCount - 1
    set sprite G to 207,0,GhostEyesPattern,15
  next
  DacmanInitLevel
  nmi on
  play sound 3
  for I = 0 to 11
    Tmp = I & 1
    DacmanPutMiss
    put char 32 at PacX,PacY
    PacX += 1
    put char PacClosedTile - Tmp * 4 at PacX,PacY
    wait 12 frames
  next

  Tmp = 0
  DacmanPutMiss
  put char PacClosedTile at PacX,PacY
  put char $A7 at PacX,PacY - 1
  put char $A8 at PacX + 1,PacY - 1

  play sound 11
  play sound 12
  play sound 13
  wait 2000 frames
  play sound 3

  for G = 2 downto 0
    for I = 6 to 7 + G
      put char 32 at I - 1,PacY
      put char FirstGhostTile + G at I,PacY
      wait 5 frames
    next
  next

  put char 32 at PacX,PacY - 1
  put char 32 at PacX + 1,PacY - 1

  Tmp = 1
  DacmanPutMiss
  put char $A9 at PacX + 1,PacY - 1

  for I = 10 to 16
    put char 32 at I - 3,PacY
    put char FirstGhostTile at I - 2,PacY
    put char $AC at I - 1,PacY
    put char $AD at I,PacY
    if I = 11 then
      put char PacLeftTile at PacX,PacY
    end if
    wait 20 frames
  next

  put char 32 at PacX + 1,PacY - 1
  print at 7,PacY, "     THE END     "
  set sprite MissSprite to 207,0,1,MissColor
  set sprite SecondMissSprite to 207,0,1,MissColor
  update sprites
  put char $8A at 6,PacY - 1
  put char $8A at 6,PacY
  put char $8A at 6,PacY + 1
  wait 300 frames
  mute all
  wait 300 frames or press
  return

sub DacmanPutMiss:
  Number = 1 + Tmp
  set sprite MissSprite to 12 * 8 - 1,19 * 8,Number,MissColor
  set sprite SecondMissSprite to 12 * 8 - 1,21 * 8,Number,MissColor
  put char PacClosedTile - 2 * Tmp at 19,12
  put char PacClosedTile - 2 * Tmp at 21,12
  update sprites
  return
sub DacmanVblank:
  if Playing = 0 then return
  Flashing += 1
  if Flashing = 12 then
    fill $F1 count 8 to vram.color + (128 + 33) * 8
    fill $F1 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $F1 count 8 to vram.color + (512 + 128 + 33) * 8
  end if
  if Flashing = 24 then
    fill $11 count 8 to vram.color + (128 + 33) * 8
    fill $11 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $11 count 8 to vram.color + (512 + 128 + 33) * 8
    Flashing = 0
  end if
  if BluePhase != BluePhaseFlashing then goto DacmanGhostBlueColor
  BlueFlashCounter += 1
  if BlueFlashCounter >= 6 then
    BlueFlashCounter = 0
    if BlueFlashWhite = 0 then BlueFlashWhite = 1 else BlueFlashWhite = 0
  end if
  if BlueFlashWhite != 0 then goto DacmanGhostWhiteColor
  goto DacmanGhostApplyBlueColor
DacmanGhostBlueColor:
  BlueFlashCounter = 0
  BlueFlashWhite = 0
DacmanGhostApplyBlueColor:
  fill mode 2 color thirds at BlueGhostTile count 1 with $41
  return
DacmanGhostWhiteColor:
  fill mode 2 color thirds at BlueGhostTile count 1 with $F1
  return
