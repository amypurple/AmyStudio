cartridge "SHEERLUCK/FRED KARG/1990"

' SHEERLUCK
' A ColecoVision game based on "Sheerluck", COMPUTE!'s Gazette May 1990
' (Commodore 64 BASIC, disk 1990-05; no author named on the listing).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from the
' C64 listing, orig/sheerluck.bas), rebuilt for the ColecoVision: eight
' suspects of our own design in tile graphics against a line-up wall, a
' sliding cursor sprite, a truth meter of bars, sound effects and an
' original title tune ("Footprints in the Fog").
'
' The game: a line-up of 2 to 8 places, each under a name (JIM, BOB, ABE,
' ROB, BUD, SAM, TOM, DAN). Each place holds one of eight suspects, all
' different. Put a suspect in every place and accuse: the TRUTH METER shows
' how many are the right suspect in the right place (red, 100%) and how
' many are a right suspect in the wrong place (green, 50%). Each
' accusation costs a point of the case's score; line them all up right to
' solve the case.
'
' From the original: the eight names and eight suspects; the line-up of
' level + 1 places, starting at 2; every place starts on the first suspect;
' up/down change the suspect in the place under the cursor, left/right move
' the cursor (wrapping round), the button accuses; the meter's counting
' (an exact match first, then each guessed suspect matched once against an
' unused place, so a suspect guessed twice counts once); the case score
' INT(99 / (8 - level)) (14, 16, 19, 24, 33, 49, 99), one point off for
' every accusation, the right one included, never below 0; the rating
' 9 - INT(99 / (score + 10)), at least 1, shown with the score; the nine
' ranks (the last renamed, see below); the next case one level up when the
' remaining score is more than a third of the case score (the same level
' otherwise), up to 8 places; a short jingle for a solved case.
'
' Liberties: a career of 8 cases with an end (the C64 went on for ever and
' the score just stopped at 0): a case whose score reaches 0 is lost (the
' line-up is shown), and the final rank is the average of the 8 cases'
' ratings (a lost case rates 1, UNEMPLOYED). The secret line-up is a full
' shuffle of the eight suspects (the C64 swapped only level + 1 random
' pairs of an ordered list, so suspect 1 stood in place 1 far more often
' than chance and lucky guesses paid). A casebook of the last six
' accusations with their meter readings (the C64 showed only the last
' reading; players kept notes on paper). The ninth rank, the name of a
' famous fictional detective on the C64, is GRAND SLEUTH. The names are on
' two rows, the place numbers dropped (28 columns). A cursor arrow instead
' of the C64's moving block. Original suspects, wall, logo and sounds.
' No "another game?" question: the end message, then the title.
'
' Controls: either controller. Title: up/down choose START, HOW TO PLAY or CREDITS, a
' button chooses. Play: left/right move the cursor, up/down change the
' suspect, either button accuses. After a case, a button goes on.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given.
' Own xorshift random numbers. Nothing flashes.

const TS000 = 128
const TS001 = 129
const TS010 = 130
const TS011 = 131
const TS020 = 132
const TS021 = 133
const TS100 = 134
const TS101 = 135
const TS110 = 136
const TS111 = 137
const TS120 = 138
const TS121 = 139
const TS200 = 140
const TS201 = 141
const TS210 = 142
const TS211 = 143
const TS220 = 144
const TS221 = 145
const TS300 = 146
const TS301 = 147
const TS310 = 148
const TS311 = 149
const TS320 = 150
const TS321 = 151
const TS400 = 152
const TS401 = 153
const TS410 = 154
const TS411 = 155
const TS420 = 156
const TS421 = 157
const TS500 = 158
const TS501 = 159
const TS510 = 160
const TS511 = 161
const TS520 = 162
const TS521 = 163
const TS600 = 164
const TS601 = 165
const TS610 = 166
const TS611 = 167
const TS620 = 168
const TS621 = 169
const TS700 = 170
const TS701 = 171
const TS710 = 172
const TS711 = 173
const TS720 = 174
const TS721 = 175
const TI0 = 176
const TI1 = 177
const TI2 = 178
const TI3 = 179
const TI4 = 180
const TI5 = 181
const TI6 = 182
const TI7 = 183
const TWall = 184
const TWline = 185
const TFloor = 186
const TBred = 187
const TBgrn = 188
const TBnone = 189
const TDfull = 190
const TDhalf = 191
const TMag00 = 192
const TMag01 = 193
const TMag10 = 194
const TMag11 = 195
const TLS00 = 196
const TLS01 = 197
const TLS10 = 198
const TLS11 = 199
const TLH00 = 200
const TLH01 = 201
const TLH10 = 202
const TLH11 = 203
const TLE00 = 204
const TLE01 = 205
const TLE10 = 206
const TLE11 = 207
const TLR00 = 208
const TLR01 = 209
const TLR10 = 210
const TLR11 = 211
const TLL00 = 212
const TLL01 = 213
const TLL10 = 214
const TLL11 = 215
const TLU00 = 216
const TLU01 = 217
const TLU10 = 218
const TLU11 = 219
const TLC00 = 220
const TLC01 = 221
const TLC10 = 222
const TLC11 = 223
const TLK00 = 224
const TLK01 = 225
const TLK10 = 226
const TLK11 = 227
const SArrow = 0
const NTiles8 = 800
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndMove = 4
const SndGavel = 5
const SndMeter = 6
const SndHalf = 7
const SndSolved = 8
const SndLost = 9
const NSpr = 1
const NCases = 8
const NHist = 5
const MaxLv = 7
const ArrowY = 24

data LogoT bytes 196, 200, 204, 204, 208, 212, 216, 220, 224

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' the case
u8 Lv = 1
u8 NS = 2
u8 X0 = 13
u8 CaseNo = 0
u8 Sc = 14
u8 Sc0 = 14
u8 Rk = 1
u8 RkSum = 0
u8 Solved = 0
u8 Acc = 0
u8 Sec[8]
u8 Gs[8]
u8 Pool[8]
u8 Used[8]
u8 Cur = 0
u8 ArX = 0
u8 Rr = 0
u8 Ww = 0
u8 Outcome = 0
' the casebook: up to six accusations, 8 suspects each
u8 HN = 0
u8 HF[48]
u8 HR[6]
u8 HW[6]
u8 HA[6]
' the game
u8 St = 0
u8 StT = 0
u8 Over = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 RepT = 0
u8 Menu = 0
u8 Pg = 0
u16 Wt = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
' loop counters (never shared with the helpers)
u8 Gc = 0
u8 Gk = 0
u8 Ri = 0
u8 Si = 0
u8 Hi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SlSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu <> 0 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawCursor
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  EndScreen
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  select case St
  case 0
    Stick
    if Press = 1 then Accuse
  case else
    ' a case is over: wait a moment, then a press goes on
    if StT > 0 then
      dec StT
    elseif Press = 1 then
      if CaseNo >= NCases then
        Over = 1
      else
        NextCase
      end if
    end if
  end select
  return
end sub

sub Stick:
  V = J1 | J2
  V = V & 15
  if V = 0 then
    RepT = 0
  else
    if WasStick = 0 then
      StickAct(V)
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickAct(V)
        RepT = 8
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub StickAct(u8 Sv):
  u8 F = 0
  F = Gs[Cur]
  if Sv & 1 then
    F = F + 1
    F = F & 7
    Gs[Cur] = F
    DrawFace(Cur, F)
    play sound SndClick
  elseif Sv & 2 then
    F = F + 7
    F = F & 7
    Gs[Cur] = F
    DrawFace(Cur, F)
    play sound SndClick
  elseif Sv & 8 then
    inc Cur
    if Cur >= NS then Cur = 0
    play sound SndMove
  elseif Sv & 4 then
    if Cur = 0 then
      Cur = NS - 1
    else
      dec Cur
    end if
    play sound SndMove
  end if
  return
end sub

' the C64's lines 330-370: exact matches first, then each guessed suspect
' against one unused place
sub Measure:
  u8 Lg = 0
  u8 Hit = 0
  Rr = 0
  Ww = 0
  fill array Used with 0
  for Gc = 0 to NS - 1
    if Gs[Gc] = Sec[Gc] then
      inc Rr
      Used[Gc] = 1
    end if
  next
  for Gc = 0 to NS - 1
    Lg = Gs[Gc]
    Hit = 0
    for Gk = 0 to NS - 1
      if Hit = 0 then
        if Sec[Gk] = Lg then
          if Used[Gk] = 0 then
            inc Ww
            Used[Gk] = 1
            Hit = 1
          end if
        end if
      end if
    next
  next
  return
end sub

' rating: 9 - INT(99 / (score + 10)), at least 1
function Rating(u8 Sv) as u8
  u8 Q = 0
  u8 Dv = 0
  Dv = Sv + 10
  Q = 99 / Dv
  Q = 9 - Q
  if Q < 1 then Q = 1
  return Q

sub Accuse:
  u16 Lim = 0
  inc Acc
  if Sc > 0 then dec Sc
  Measure
  Rk = Rating(Sc)
  AddHistory
  fill 32 count 28 at 2,10
  play sound SndGavel
  ShowHud
  ShowMeter
  DrawHistory
  if Rr = NS then
    ' solved: a third of the case score left moves up a level
    Outcome = 1
    inc Solved
    RkSum = RkSum + Rk
    Lim = Sc * 3
    T = 8 - Lv
    Lim = Lim * T
    if Lim > 99 then
      if Lv < MaxLv then inc Lv
    end if
    play sound SndSolved
    ShowMsg(1)
    St = 1
    StT = 60
  elseif Sc = 0 then
    Outcome = 2
    Rk = 1
    RkSum = RkSum + 1
    play sound SndLost
    for Si = 0 to NS - 1
      DrawFace(Si, Sec[Si])
    next
    ShowMsg(2)
    St = 1
    StT = 60
  end if
  return
end sub

sub AddHistory:
  u8 Ix = 0
  u8 Jx = 0
  if HN >= NHist then
    ' drop the oldest line
    for Hi = 0 to NHist - 2
      Ix = Hi << 3
      Jx = Ix + 8
      for Gk = 0 to 7
        HF[Ix] = HF[Jx]
        inc Ix
        inc Jx
      next
      Jx = Hi + 1
      HR[Hi] = HR[Jx]
      HW[Hi] = HW[Jx]
      HA[Hi] = HA[Jx]
    next
    HN = NHist - 1
  end if
  Ix = HN << 3
  for Gk = 0 to 7
    HF[Ix] = Gs[Gk]
    inc Ix
  next
  HR[HN] = Rr
  HW[HN] = Ww
  HA[HN] = Acc
  inc HN
  return
end sub

' ---------------------------------------------------------------------------
' random numbers and the secret line-up

function RandBelow(u8 M) as u8
  u8 L = 0
  Rand
  L = Rs & 255
  L = L mod M
  return L

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a full shuffle of the eight suspects; the first NS stand in the line-up
sub MakeSecret:
  u8 Pk = 0
  u8 Tm = 0
  u8 Top = 0
  for Gc = 0 to 7
    Pool[Gc] = Gc
  next
  Gc = 8
  do while Gc > 1
    Top = Gc
    dec Gc
    Pk = RandBelow(Top)
    Tm = Pool[Gc]
    Pool[Gc] = Pool[Pk]
    Pool[Pk] = Tm
  loop
  fill array Sec with 0
  for Gc = 0 to NS - 1
    Sec[Gc] = Pool[Gc]
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawFace(u8 Sl, u8 F):
  u8 Px = 0
  u8 Tt = 0
  u8 Px1 = 0
  Px = Sl * 3
  Px = Px + X0
  Px1 = Px + 1
  Tt = F * 6
  Tt = Tt + TS000
  put char Tt at Px,4
  inc Tt
  put char Tt at Px1,4
  inc Tt
  put char Tt at Px,5
  inc Tt
  put char Tt at Px1,5
  inc Tt
  put char Tt at Px,6
  inc Tt
  put char Tt at Px1,6
  return
end sub

sub PutName(u8 Sl, u8 Px, u8 Rw):
  select case Sl
  case 0
    print at Px,Rw, "JIM"
  case 1
    print at Px,Rw, "BOB"
  case 2
    print at Px,Rw, "ABE"
  case 3
    print at Px,Rw, "ROB"
  case 4
    print at Px,Rw, "BUD"
  case 5
    print at Px,Rw, "SAM"
  case 6
    print at Px,Rw, "TOM"
  case else
    print at Px,Rw, "DAN"
  end select
  return
end sub

sub PrintRank(u8 Rv, u8 Px, u8 Rw):
  select case Rv
  case 1
    print at Px,Rw, "UNEMPLOYED     "
  case 2
    print at Px,Rw, "ROOKIE         "
  case 3
    print at Px,Rw, "SHEERLUCK      "
  case 4
    print at Px,Rw, "PRIVATE EYE    "
  case 5
    print at Px,Rw, "DETECTIVE      "
  case 6
    print at Px,Rw, "INSPECTOR      "
  case 7
    print at Px,Rw, "MASTERMIND     "
  case 8
    print at Px,Rw, "CHIEF INSPECTOR"
  case else
    print at Px,Rw, "GRAND SLEUTH   "
  end select
  return
end sub

sub DrawLineup:
  u8 Px = 0
  u8 Rw = 0
  fill TWline count 28 at 2,3
  fill TWall count 28 at 2,4
  fill TWall count 28 at 2,5
  fill TWall count 28 at 2,6
  fill TFloor count 28 at 2,7
  fill 32 count 28 at 2,8
  fill 32 count 28 at 2,9
  for Si = 0 to NS - 1
    DrawFace(Si, Gs[Si])
    Px = Si * 3
    Px = Px + X0
    Rw = Si & 1
    Rw = Rw + 8
    PutName(Si, Px, Rw)
  next
  return
end sub

sub ShowHud:
  print at 2,1, "CASE"
  NumU = CaseNo
  print at 7,1, digits$(NumU, 1)
  print at 9,1, "OF"
  NumU = NCases
  print at 12,1, digits$(NumU, 1)
  print at 19,1, "SCORE"
  NumU = Sc
  print at 25,1, digits$(NumU, 2)
  print at 2,2, "RANK"
  PrintRank(Rk, 7, 2)
  return
end sub

sub Bars(u8 Nb, u8 Tb, u8 Rw):
  u8 Px = 0
  for Gk = 0 to 7
    Px = Gk + 7
    if Gk < Nb then
      put char Tb at Px,Rw
    else
      put char TBnone at Px,Rw
    end if
  next
  NumU = Nb
  print at 16,Rw, digits$(NumU, 1)
  return
end sub

sub ShowMeter:
  print at 9,12, "TRUTH METER"
  print at 2,13, "100%"
  Bars(Rr, TBred, 13)
  print at 18,13, "RIGHT PLACE"
  print at 2,14, " 50%"
  Bars(Ww, TBgrn, 14)
  print at 18,14, "WRONG PLACE"
  return
end sub

sub DrawHistory:
  u8 Rw = 0
  u8 Ix = 0
  u8 Px = 0
  u8 Ic = 0
  for Hi = 0 to NHist - 1
    Rw = Hi + 17
    fill 32 count 28 at 2,Rw
    if Hi < HN then
      NumU = HA[Hi]
      print at 2,Rw, digits$(NumU, 2)
      Ix = Hi << 3
      for Gk = 0 to NS - 1
        Px = Gk << 1
        Px = Px + 6
        Ic = HF[Ix] + TI0
        put char Ic at Px,Rw
        inc Ix
      next
      put char TDfull at 23,Rw
      NumU = HR[Hi]
      print at 24,Rw, digits$(NumU, 1)
      put char TDhalf at 26,Rw
      NumU = HW[Hi]
      print at 27,Rw, digits$(NumU, 1)
    end if
  next
  return
end sub

' message line (row 10): 0 a new case, 1 solved, 2 lost
sub ShowMsg(u8 Mk):
  fill 32 count 28 at 2,10
  select case Mk
  case 0
    print at 4,10, "NEW CASE:"
    NumU = NS
    print at 14,10, digits$(NumU, 1)
    print at 16,10, "SUSPECTS"
  case 1
    print at 3,10, "SOLVED!"
    PrintRank(Rk, 11, 10)
  case else
    print at 3,10, "THEY GOT AWAY! UNEMPLOYED"
  end select
  return
end sub

sub DrawCursor:
  u8 Tx = 0
  Tx = Cur * 3
  Tx = Tx + X0
  Tx = Tx << 3
  if ArX < Tx then
    ArX = ArX + 4
    if ArX > Tx then ArX = Tx
  elseif ArX > Tx then
    ArX = ArX - 4
    if ArX < Tx then ArX = Tx
  end if
  if St = 0 then
    set sprite 0 to ArrowY,ArX,SArrow,15
  else
    set sprite 0 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub NextCase:
  inc CaseNo
  NS = Lv + 1
  T = 8 - Lv
  Sc0 = 99 / T
  Sc = Sc0
  Rk = Rating(Sc)
  T = NS * 3
  X0 = 33 - T
  X0 = X0 >> 1
  Cur = 0
  ArX = X0 << 3
  Acc = 0
  HN = 0
  Rr = 0
  Ww = 0
  St = 0
  StT = 0
  Outcome = 0
  fill array Gs with 0
  MakeSecret
  Rearm
  wait
  nmi off
  DrawLineup
  ShowHud
  ShowMeter
  DrawHistory
  ShowMsg(0)
  print at 2,16, "CASEBOOK"
  return
end sub

sub NewGame:
  Over = 0
  TitleOn = 0
  Lv = 1
  CaseNo = 0
  RkSum = 0
  Solved = 0
  NewScreen
  print at 2,22, "STICK:PICK  BUTTON:ACCUSE"
  NextCase
  DrawCursor
  ShowScreen
  Rearm
  wait no fire
  nmi off
  return
end sub

sub EndScreen:
  u8 Fr = 0
  Rearm
  wait
  nmi off
  set sprite 0 to 192,0,0,0
  update sprites
  for Ri = 10 to 21
    fill 32 count 28 at 2,Ri
  next
  Fr = RkSum + 4
  Fr = Fr >> 3
  if Fr < 1 then Fr = 1
  Rk = Fr
  print at 9,12, "CAREER OVER"
  print at 5,14, "CASES SOLVED"
  NumU = Solved
  print at 18,14, digits$(NumU, 1)
  print at 20,14, "OF"
  NumU = NCases
  print at 23,14, digits$(NumU, 1)
  print at 9,16, "FINAL RANK"
  PrintRank(Fr, 8, 18)
  if Fr >= 5 then
    play sound SndSolved
  else
    play sound SndLost
  end if
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, the tune once, START / CREDITS
sub TitlePage:
  u8 Px = 0
  u8 Lt = 0
  u8 Px1 = 0
  TitleOn = 1
  NewScreen
  for Si = 0 to 8
    Px = Si * 3
    Px = Px + 2
    Px1 = Px + 1
    Lt = LogoT[Si]
    put char Lt at Px,3
    inc Lt
    put char Lt at Px1,3
    inc Lt
    put char Lt at Px,4
    inc Lt
    put char Lt at Px1,4
  next
  print at 2,6, "COMPUTE!'S GAZETTE MAY 1990"
  put char TMag00 at 24,19
  put char TMag01 at 25,19
  put char TMag10 at 24,20
  put char TMag11 at 25,20
  print at 2,8, "PUT THE RIGHT SUSPECT"
  print at 2,9, "UNDER EACH NAME AND ACCUSE."
  print at 2,10, "EACH ACCUSATION COSTS A"
  print at 2,11, "POINT. THE TRUTH METER:"
  put char TBred at 2,13
  print at 4,13, "RIGHT SUSPECT, RIGHT PLACE"
  put char TBgrn at 2,14
  print at 4,14, "RIGHT SUSPECT, WRONG PLACE"
  print at 2,16, "8 CASES. FROM UNEMPLOYED"
  print at 2,17, "TO GRAND SLEUTH."
  print at 10,19, "START"
  print at 10,20, "HOW TO PLAY"
  print at 10,21, "CREDITS"
  print at 2,22, "STICK: CHOOSE  BUTTON: GO"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 528
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndMove
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 1 then HowToPage
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 8,19
  put char 32 at 8,20
  put char 32 at 8,21
  J = Menu + 19
  put char 62 at 8,J
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    NS = 4
    X0 = 10
    Gs[0] = 2
    Gs[1] = 5
    Gs[2] = 0
    Gs[3] = 7
    DrawLineup
    set sprite 0 to ArrowY,80,SArrow,15
    print at 2,11, "THERE ARE EIGHT SUSPECTS."
    print at 2,12, "EACH NAME IS A PLACE."
    print at 2,13, "EACH PLACE HAS ONE SECRET"
    print at 2,14, "SUSPECT. FIND OUT WHO GOES"
    print at 2,15, "IN EVERY PLACE!"
    print at 2,17, "PUT A SUSPECT IN EACH PLACE"
    print at 2,18, "AND ACCUSE. THE TRUTH METER"
    print at 2,19, "TELLS YOU HOW CLOSE YOU ARE."
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK LEFT/RIGHT: MOVE THE"
    print at 2,4, "ARROW TO A PLACE."
    print at 2,5, "STICK UP/DOWN: CHANGE THE"
    print at 2,6, "SUSPECT IN THAT PLACE."
    print at 2,7, "BUTTON: ACCUSE."
    Rr = 1
    Ww = 2
    ShowMeter
    print at 2,16, "RED BARS: RIGHT SUSPECT IN"
    print at 2,17, "THE RIGHT PLACE. GREEN BARS:"
    print at 2,18, "RIGHT SUSPECT, WRONG PLACE."
    print at 2,20, "THE CASEBOOK LISTS YOUR"
    print at 2,21, "LAST ACCUSATIONS."
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "EACH ACCUSATION COSTS ONE"
    print at 2,4, "POINT OF THE CASE SCORE."
    print at 2,5, "ALL RED BARS SOLVES IT. AT"
    print at 2,6, "0 POINTS THE CASE IS LOST."
    print at 2,8, "SOLVE FAST AND THE NEXT CASE"
    print at 2,9, "HAS MORE PLACES. AFTER 8"
    print at 2,10, "CASES YOU GET YOUR RANK,"
    print at 2,11, "FROM UNEMPLOYED TO GRAND"
    print at 2,12, "SLEUTH."
    print at 2,14, "TIP: CHANGE ONE PLACE AT A"
    print at 2,15, "TIME AND WATCH HOW THE BARS"
    print at 2,16, "CHANGE."
    put char TMag00 at 15,18
    put char TMag01 at 16,18
    put char TMag10 at 15,19
    put char TMag11 at 16,19
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  print at 11,2, "SHEERLUCK"
  print at 2,5, "BASED ON SHEERLUCK,"
  print at 2,6, "COMPUTE!'S GAZETTE, MAY 1990"
  print at 2,7, "(COMMODORE 64 BASIC)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: FOOTPRINTS IN THE FOG"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

