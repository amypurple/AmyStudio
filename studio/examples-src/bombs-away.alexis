play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  print at 8,10, "                "
  print at 8,11, "   GAME  OVER   "
  print at 8,12, "                "
  print at 8,13, "  SCORE ", Score, "  "
  print at 8,14, "  BEST  ", Hi, "  "
  print at 8,15, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the catcher (it moves during a blast too), then the
' blast's wait or as many steps as the level's speed gives
sub PlayStep:
  MoveCatcher
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then
      dec Baskets
      if Baskets = 0 then Over = 1
    end if
    return
  end if
  W16 = Frac
  W16 = W16 + Spd
  Steps = W16 >> 8
  Frac = W16 & 255
  while Steps > 0
    DoStep
    dec Steps
    if Freeze > 0 then Steps = 0
  end while
  return
end sub

' 2 pixels a frame (more from level 6), stopped at X 28 and 255
sub MoveCatcher:
  K = J1 & 12
  if K = 4 then
    W16 = CMin + CSpd
    if CXf < W16 then
      CXf = CMin
    else
      CXf = CXf - CSpd
    end if
  end if
  if K = 8 then
    W16 = CMax - CSpd
    if CXf > W16 then
      CXf = CMax
    else
      CXf = CXf + CSpd
    end if
  end if
  CX = CXf >> 8
  return
end sub

' one step of the C64's loop: every bomb a pixel down (caught or missed),
' the bomber a pixel along, and every 41 steps a turn and a new bomb
sub DoStep:
  for Sl = 0 to 4
    BY[Sl] = BY[Sl] + 1
    if BX[Sl] > 0 then
      if BY[Sl] > 188 then
        HitTest
        if Hit = 1 then
          BX[Sl] = 0
          Catch
        end if
      end if
    end if
    if BX[Sl] > 0 then
      if BY[Sl] = 230 then Miss
    end if
  next
  select case BmD
    case 1
      if BmX < 242 then inc BmX
    case 2
      if BmX > 28 then dec BmX
  end select
  if Cnt = 0 then
    Cnt = 40
    Rand
    V = Rs & 128
    if V > 0 then
      BmD = 1
    else
      BmD = 2
    end if
    inc Ring
    if Ring = 5 then Ring = 0
    BY[Ring] = 76
    BX[Ring] = BmX + 12
    play sound SndDrop
  else
    dec Cnt
  end if
  return
end sub

' Hit = 1 when bomb Sl touches the baskets that are left
sub HitTest:
  Hit = 0
  A0 = BX[Sl] + KindL[Kind]
  A1 = BX[Sl] + KindR[Kind]
  W16 = CX + 23
  if A1 < CX then return
  if A0 > W16 then return
  Bot = BY[Sl] + KindBot[Kind]
  Top = (3 - Baskets) * 14 + 212
  if Bot >= Top then Hit = 1
  return
end sub

sub Catch:
  ' the six digits stop at 999999 (packed BCD would wrap round)
  if Score > ScoreCap then
    Score = ScoreMax
  else
    Score += Pts
  end if
  if Score > Hi then Hi = Score
  inc Caught
  play sound SndCatch
  ShowScore
  dec Left
  if Left = 0 then
    NextLevel
    play sound SndLevel
  end if
  return
end sub

' a bomb on the street: the blast, 26 frames of stillness, a basket lost
sub Miss:
  ExX = BX[Sl]
  BX[Sl] = 0
  Freeze = 26
  inc Missed
  play sound SndBoom
  return
end sub

' the next level: speed, points, 100 more to catch, the bombs' kind
sub NextLevel:
  inc Lv
  K = Lv
  if K > 16 then K = 16
  Spd = SpdT[K - 1]
  W16 = Spd >> 3
  W16 = W16 + Spd
  if W16 < 512 then W16 = 512
  CSpd = W16
  if Lv < 25 then
    Pts = Lv * 10 + 5
  else
    Pts = 255
  end if
  Left = 100
  Kind = (Lv >> 2) & 1
  ShowLevel
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: C64 pixels to the screen, 7/8 of the size
function CvX(u16 Px) as u8
  Px = Px - 24
  Px = Px * 7
  Px = Px >> 3
  Cv = Px
  return Cv + 12

function CvY(u8 Py) as u8
  W16 = Py - 52
  W16 = W16 * 7
  W16 = W16 >> 3
  Cv = W16
  return Cv + 16

' sprites 0-3 the baskets, 4-7 the firebug (detail, body; top, bottom),
' 8-17 the bombs (spark, body), 18-19 the blast
sub DrawSprites:
  X = CvX(CX)
  V = (3 - Baskets) * 14 + 212
  Y = CvY(V)
  set sprite 0 to Y - 1,X,SCaTL,11
  set sprite 1 to Y - 1,X + 16,SCaTR,11
  set sprite 2 to Y + 15,X,SCaBL,11
  set sprite 3 to Y + 15,X + 16,SCaBR,11
  W16 = BmX + 24
  X = CvX(W16) - 8
  K = BmX >> 2
  K = K & 1
  K = K * 16 + SBm00d
  set sprite 4 to 25,X,K,11
  set sprite 5 to 25,X,K + 4,14
  set sprite 6 to 41,X,K + 8,11
  set sprite 7 to 41,X,K + 12,14
  inc SparkT
  if SparkT >= 10 then
    SparkT = 0
    Spark = Spark ^ 1
  end if
  for Ds = 0 to 4
    J = Ds * 2 + 8
    if BX[Ds] > 0 then
      W16 = BX[Ds] + KindDx[Kind]
      X = CvX(W16) - 8
      V = BY[Ds] + KindDy[Kind]
      Y = CvY(V) - 10
      K = Kind * 12 + SBk0b
      set sprite J + 1 to Y - 1,X,K,KindCol[Kind]
      K = K + 4 + Spark * 4
      set sprite J to Y - 1,X,K,11
    else
      set sprite J to 192,0,0,0
      set sprite J + 1 to 192,0,0,0
    end if
  next
  if Freeze > 0 then
    W16 = ExX + KindDx[Kind]
    X = CvX(W16) - 8
    K = SEx0i
    if Freeze < 18 then K = SEx1i
    set sprite 18 to 163,X,K,15
    set sprite 19 to 163,X,K + 4,10
  else
    set sprite 18 to 192,0,0,0
    set sprite 19 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, Score
  print at 24,1, Hi
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 18,1, digits$(NumU, 2)
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 2,1, "SCORE"
  print at 15,1, "LV"
  print at 21,1, "HI"
  for Sl = 0 to 4
    BX[Sl] = 0
    BY[Sl] = 0
  next
  Score = 0
  Lv = 0
  NextLevel
  CXf = 32 * 256
  CX = 32
  BmX = 28
  BmD = 0
  Cnt = 0
  Ring = 0
  Frac = 0
  Baskets = 3
  Freeze = 0
  Over = 0
  Caught = 0
  Missed = 0
  ShowScore
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  sprites flicker on
  for J = 0 to 19
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BOMBS AWAY! in fiery bricks over the night sky, the firebug
' pacing a wall, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  print at 7,1, "AHOY! OCTOBER 1988"
  copy TitleMap count 384 to vram.name + 64
  fill TCap count 32 at 0,15
  for J = 16 to 17
    for K = 0 to 31
      V = K + J
      V = V & 3
      put char TBr0 + V at K,J
    next
  next
  print at 8,18, "BY JOHN FRALEIGH"
  print at 13,20, "START"
  print at 13,21, "CREDITS"
  if Hi > 0 then
    print at 9,22, "BEST ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the firebug paces the title's wall, a pixel every other frame
sub TitleAnim:
  V = Tick & 1
  if V = 0 then
    if TbD = 1 then
      inc TbX
      if TbX >= 224 then TbD = 2
    else
      dec TbX
      if TbX <= 16 then TbD = 1
    end if
  end if
  K = TbX >> 2
  K = K & 1
  K = K * 16 + SBm00d
  set sprite 4 to 89,TbX,K,11
  set sprite 5 to 89,TbX,K + 4,14
  set sprite 6 to 105,TbX,K + 8,11
  set sprite 7 to 105,TbX,K + 12,14
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,20
  put char 32 at 11,21
  J = Menu + 20
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "BOMBS AWAY!"
  print at 2,5, "BASED ON BOMBS AWAY! BY"
  print at 2,6, "JOHN FRALEIGH, AHOY!"
  print at 2,7, "OCTOBER 1988 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SHORT FUSE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
BaDrop:
    db $80,$33,$40,$02,$80,$37,$40,$02,$80,$3B,$40,$02,$80,$3F,$40,$02,$80,$44,$50,$02,$80,$49,$50,$02
    db $80,$4F,$50,$02,$80,$54,$50,$02,$80,$5B,$50,$02,$80,$62,$50,$02,$80,$69,$50,$02,$80,$71,$50,$02
    db $80,$79,$60,$02,$80,$83,$60,$02,$90
BaCatch:
    db $40,$D6,$20,$02,$40,$8F,$30,$02,$40,$6B,$40,$03,$50
BaFizz:
    db $00,$00,$54,$03,$00,$00,$75,$04,$10
BaBoom:
    db $00,$00,$06,$04,$00,$00,$16,$06,$00,$00,$27,$08,$00,$00,$47,$0A,$00,$00,$77,$0C,$10
BaLevel:
    db $C0,$8F,$20,$05,$C0,$71,$20,$05,$C0,$5F,$20,$05,$C0,$47,$20,$05,$C0,$39,$20,$0E,$D0
BaStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0E,$50
BaOver:
    db $40,$D6,$10,$0A,$40,$F0,$20,$0A,$40,$1D,$21,$0A,$40,$53,$21,$0A,$40,$AB,$31,$1E,$50

BaSoundTable:
    dw BaTuneMel,$702B
    dw BaTuneBass,$7035
    dw BaDrop,$7053
    dw BaCatch,$7049
    dw BaFizz,$703F
    dw BaBoom,$703F
    dw BaLevel,$705D
    dw BaStart,$7049
    dw BaOver,$7049
; Short Fuse (original)
; Tiny Sound, 8 frames per step
BaTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$21,$01,$24,$01,$28,$01,$01,$26,$01,$24,$01,$23
    db $01,$21,$01,$01,$1F,$01,$21,$01,$23,$01,$24,$01,$01,$01,$23,$01
    db $1F,$01,$1C,$01,$21,$01,$24,$01,$28,$01,$01,$2B,$01,$28,$01,$26
    db $01,$24,$01,$23,$01,$1F,$01,$23,$01,$21,$01,$01,$01,$28,$01,$2D
    db $01,$01,$00,$01
    db $FF
BaTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$10,$01,$0B,$01
    db $10,$01,$0B,$01,$09,$01,$10,$01,$09,$01,$10,$01,$0C,$01,$07,$01
    db $0C,$01,$07,$01,$0E,$01,$09,$01,$10,$01,$0B,$01,$09,$01,$01,$01
    db $10,$01,$00,$01
    db $FF
}
