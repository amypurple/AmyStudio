cartridge "SOLITAIRE 64/ERIC W. SINK, AHOY!/1985"

' SOLITAIRE 64
' Based on "Solitaire 64" by Eric W. Sink, Ahoy! October 1985 (Commodore
' 64 BASIC, disk ahoy1985-10; author from the listing's REMs and its title
' screen). Made for the ColecoVision in Amy (the language by Amy Bienvenu)
' by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the listing's rules
' (orig/solitaire.bas). The rules, as the listing plays them (Klondike):
' - 28 cards in seven piles: the left pile has seven, the right one; the
'   last card of each is face up (lines 20-24). 24 cards stay in the deck.
' - REGULAR: the deck turns three cards at a time and can be gone through
'   again and again (line 249: an empty deck turns over and deals three).
'   LAS VEGAS: one card at a time, one pass only; touching the empty deck
'   ends the game. The deck "costs" $50 and each card put at the top pays
'   $5 (lines 374-380), so the four aces' piles show a profit or a loss.
' - On the piles, a card goes on one a rank higher of the other colour; a
'   face-up card takes the whole run below it along; only a king (and its
'   run) goes on an empty pile. A pile's new last card turns face up.
' - At the top, four piles in suit (spades, hearts, diamonds, clubs; the
'   listing keeps them in fixed places) build ace to king. Only a pile's
'   last card or the deck's card can go up; nothing comes back down.
' - When the deck is used up and every card on the piles is face up, the
'   game finishes itself: YOU WON (lines 37-44). CONCEDE ends a game.
'
' Made for this machine: cards of 3 x 3 tiles on green felt, a pile's
' face-down cards shown as one blue strip with their count (so the piles
' fit the screen), a cursor that glides from place to place (a frame of
' two sprites) and a second frame round the cards in hand, the moves
' counted (BCD) in REGULAR, the money shown as you play in LAS VEGAS, the
' cards flying home one by one at the end, card sounds, an original title
' tune, "Kitchen Table", played once.
'
' Liberties: the cursor jumps between cards instead of the listing's free
' joystick pointer; the right button sends the card under the cursor (or
' the card in hand) to its ace pile in one go (the listing needed two
' clicks); both buttons together concede (the listing's CONCEDE box).
' The piles' order (big pile on the left) and the fixed suit places are
' the listing's.
'
' Controls (either joystick): the stick moves the cursor (up from the
' piles reaches the deck and the ace piles); the left button turns the
' deck, takes a card or run, and puts it down where the cursor is (on the
' same place it puts it back); the right button sends a card up to its
' ace pile, or puts back the cards in hand; both buttons concede.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TRk00 = 128
const TRk01 = 129
const TRk02 = 130
const TRk03 = 131
const TRk04 = 132
const TRk05 = 133
const TRk06 = 134
const TRk07 = 135
const TRk08 = 136
const TRk09 = 137
const TRk10 = 138
const TRk11 = 139
const TRk12 = 140
const TRR00 = 141
const TRR01 = 142
const TRR02 = 143
const TRR03 = 144
const TRR04 = 145
const TRR05 = 146
const TRR06 = 147
const TRR07 = 148
const TRR08 = 149
const TRR09 = 150
const TRR10 = 151
const TRR11 = 152
const TRR12 = 153
const TSS = 154
const TSH = 155
const TSD = 156
const TSC = 157
const TBS = 158
const TBH = 159
const TBD = 160
const TBC = 161
const TCtr = 162
const TCml = 163
const TCbl = 164
const TCbm = 165
const TCbr = 166
const TKtl = 167
const TKtm = 168
const TKtr = 169
const TKd1 = 170
const TKd2 = 171
const TKd3 = 172
const TKd4 = 173
const TKd5 = 174
const TKd6 = 175
const TKml = 176
const TKmm = 177
const TKmr = 178
const TKbl = 179
const TKbm = 180
const TKbr = 181
const TOtl = 182
const TOtm = 183
const TOtr = 184
const TOml = 185
const TOmm = 186
const TOmr = 187
const TObl = 188
const TObm = 189
const TObr = 190
const TFS = 191
const TFH = 192
const TFD = 193
const TFC = 194
const TOk = 195
const TOrc = 196
const SCurl = 0
const SCurr = 4
const NTiles8 = 552
const SprBytes = 64
const SndTuneA = 1
const SndTuneB = 2
const SndFlick = 3
const SndDraw = 4
const SndLay = 5
const SndBuzz = 6
const SndPick = 7
const SndFlip = 8
const SndHome = 9
const SndTick = 10
const SndWin = 11
const SndLose = 12

' the tune now playing once: frames left (counted in Rearm)
u16 TzLeft = 0
u8 TzOn = 0

' a pile of the table: N cards, the first Down of them face down.
' A card is suit * 13 + rank: suits spades, hearts, diamonds, clubs; rank
' 0 the ace ... 12 the king.
record Pile:
  u8 N
  u8 Down
  u8 C[19]
end record
Pile Pl[7]
' the deck: Dk[0..Dp-1] still face down, Dk[Dp..Dn-1] turned up (the top
' one, Dk[Dp], can be played), as the listing's DK%, DP and DN
u8 Dk[24]
u8 Dn = 0
u8 Dp = 0
' Fd[suit]: the cards on that ace pile (the next rank it takes)
u8 Fd[4]
u8 Up = 0
' Lv 1 for LAS VEGAS; Cg the cards turned at a time
u8 Lv = 0
u8 Cg = 3
u8 Mode = 0
bcd digits 4 Moves
' Ph: 1 waiting for you, 2 finishing, 5 the game over, 0 elsewhere (bot)
u8 Ph = 0
u8 Idle = 0
u8 Done = 0
' the cursor: Cr 0 the top row, 1 the piles; Cc the place 0-6; Ci the
' card in the pile
u8 Cr = 0
u8 Cc = 0
u8 Ci = 0
' in hand: Hs 0 nothing, 1 the deck's card, 2 a run from pile Hp, card Hi
u8 Hs = 0
u8 Hp = 0
u8 Hi = 0
u8 Ok = 0
' the cursor's place in pixels (gliding) and its target
u8 Px = 0
u8 Py = 0
u8 Tx = 0
u8 Ty = 0
u8 Gx = 0
u8 Gy = 0
' drawing
u8 Cx = 0
u8 Cy = 0
u8 Cv = 0
u8 Rk = 0
u8 Su = 0
u8 Pn = 0
u16 Rs = 4321
u16 NumU = 0
i16 Money = 0
u8 Menu = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
u8 Tm = 0
u8 Lp = 0
u8 Aq = 0
u8 Hc = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table SoSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title
  Lv = Menu
  Cg = 3
  if Lv = 1 then Cg = 1

  NewScreen
  print at 9,11, "SHUFFLING..."
  ShowScreen
  Shuffle
  Rearm
  wait
  nmi off
  display off
  cls
  DrawAll
  ShowScreen
  Cr = 1
  Cc = 6
  AimPile
  Px = Tx
  Py = Ty
  Hint
  WasBtn = 1
  WasBtn2 = 1

gp_loop:
  Ph = 1
  Frame1
  ReadPad
  Glide
  V = Btn & Btn2
  if V = 1 then goto give_up
  if Press = 1 then
    LeftButton
    CheckEnd
    if Done = 1 then goto finish
    if Done = 2 then goto vegas_end
  end if
  if Press2 = 1 then
    RightButton
    CheckEnd
    if Done = 1 then goto finish
  end if
  ' the stick: a step at once, then repeating while held
  Stk = Lf1 | Rt1
  Stk = Stk | Up1
  Stk = Stk | Dn1
  if Stk = 0 then
    WasStk = 0
    goto gp_loop
  end if
  if WasStk = 0 then
    Rep = 14
    WasStk = 1
    MoveCursor
    goto gp_loop
  end if
  dec Rep
  if Rep = 0 then
    Rep = 6
    MoveCursor
  end if
  goto gp_loop

' every card face up and the deck used up: the cards fly home
finish:
  Ph = 2
  HideCursor
  Clear1
  print at 8,22, "FINISHING..."
  AutoFinish
  Ph = 5
  play sound SndWin
  Clear1
  if Lv = 1 then
    MoneyNote
  else
    print at 10,22, "YOU WON!!!"
  end if
  goto game_end

vegas_end:
  Ph = 5
  HideCursor
  play sound SndLose
  Clear1
  MoneyNote
  goto game_end

give_up:
  Ph = 5
  HideCursor
  play sound SndLose
  Clear1
  if Lv = 1 then
    MoneyNote
  else
    print at 2,22, "CONCEDED:"
    NumU = Up
    print at 12,22, digits$(NumU, 2)
    print at 15,22, "CARDS UP"
  end if

game_end:
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ph = 0
  goto title

' ---------------------------------------------------------------------
' the cards

function RankOf(u8 C) as u8
  return C % 13

function SuitOf(u8 C) as u8
  return C / 13

' 1 for hearts and diamonds
function RedOf(u8 C) as u8
  u8 S = 0
  S = C / 13
  select case S
  case 1, 2
    return 1
  case else
    return 0
  end select
  return 0

' Fits: card Mv can go on card Onto (one rank lower, the other colour)
function Fits(u8 Mv, u8 Onto) as u8
  u8 A = 0
  u8 B = 0
  A = RankOf(Mv) + 1
  B = RankOf(Onto)
  if A <> B then return 0
  A = RedOf(Mv)
  B = RedOf(Onto)
  if A = B then return 0
  return 1

' CanGoHome: card C is the next on its ace pile
function CanGoHome(u8 C) as u8
  u8 S = 0
  S = SuitOf(C)
  if Fd[S] = RankOf(C) then return 1
  return 0

' Rnd16: a 16-bit xorshift (seeded by the time spent on the title)
function Rnd16 as u16
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  return Rs

' Shuffle and deal: the deck (Fisher-Yates), then 28 cards to the piles
' the listing's way: across the piles that still take cards, the last of
' each row face up, so the left pile gets seven
sub Shuffle:
  u8 Deck[52]
  u8 R = 0
  u8 T = 0
  u16 Q = 0
  for R = 0 to 51
    Deck[R] = R
  next
  for R = 51 to 1 step -1
    Q = Rnd16()
    T = Q % (R + 1)
    Q = Deck[R]
    Deck[R] = Deck[T]
    Deck[T] = Q
  next
  ' piles: pile P gets 7 - P cards
  for R = 0 to 6
    Pl[R].N = 0
    Pl[R].Down = 6 - R
  next
  T = 0
  for R = 0 to 6
    for Q = 0 to 6 - R
      Pl[Q].C[R] = Deck[T]
      inc T
    next
  next
  for R = 0 to 6
    Pl[R].N = 7 - R
  next
  for R = 0 to 23
    Dk[R] = Deck[T]
    inc T
  next
  Dn = 24
  Dp = 24
  for R = 0 to 3
    Fd[R] = 0
  next
  Up = 0
  Moves = 0
  Hs = 0
  Done = 0
  return
end sub

' ---------------------------------------------------------------------
' the buttons

sub LeftButton:
  if Cr = 0 then
    TopPress
  else
    PilePress
  end if
  return
end sub

' the top row: the deck, its turned card, the ace piles
sub TopPress:
  if Cc = 0 then
    if Hs <> 0 then
      PutBack
    else
      TurnDeck
    end if
  end if
  if Cc = 1 then
    if Hs = 1 then
      PutBack
    else
      if Hs = 0 then
        if Dp < Dn then
          Hs = 1
          play sound SndPick
          ShowHand
        else
          play sound SndBuzz
        end if
      else
        play sound SndBuzz
      end if
    end if
  end if
  if Cc >= 3 then
    if Hs = 0 then
      play sound SndBuzz
    else
      HandHome
    end if
  end if
  return
end sub

' TurnDeck: three cards (one in LAS VEGAS); an empty deck turns over and
' deals again (REGULAR) or ends the game (LAS VEGAS, Done 2)
sub TurnDeck:
  if Dp > 0 then
    if Dp > Cg then
      Dp = Dp - Cg
    else
      Dp = 0
    end if
    play sound SndDraw
  else
    if Dn = 0 then
      play sound SndBuzz
    else
      if Lv = 1 then
        Done = 2
      else
        if Dn > 3 then
          Dp = Dn - 3
        else
          Dp = 0
        end if
        play sound SndDraw
      end if
    end if
  end if
  DrawTop
  ShowHud
  return
end sub

' a press on a pile: take the run from the card under the cursor, or put
' the cards in hand on this pile
sub PilePress:
  N = Pl[Cc].N
  if Hs = 0 then
    if N = 0 then
      play sound SndBuzz
    else
      Hs = 2
      Hp = Cc
      Hi = Ci
      play sound SndPick
      ShowHand
    end if
  else
    if Hs = 2 then
      if Hp = Cc then
        PutBack
      else
        RunToPile
      end if
    else
      CardToPile
    end if
  end if
  return
end sub

sub RightButton:
  if Hs <> 0 then
    HandHome
  else
    ' the card under the cursor: a pile's last card or the deck's card
    if Cr = 1 then
      N = Pl[Cc].N
      if N > 0 then
        dec N
        if Ci = N then
          Hs = 2
          Hp = Cc
          Hi = Ci
          HandHome
        else
          play sound SndBuzz
        end if
      else
        play sound SndBuzz
      end if
    else
      if Cc = 1 then
        if Dp < Dn then
          Hs = 1
          HandHome
        else
          play sound SndBuzz
        end if
      else
        play sound SndBuzz
      end if
    end if
  end if
  return
end sub

sub PutBack:
  Hs = 0
  ShowHand
  play sound SndFlick
  return
end sub

' HandHome: the card in hand to its ace pile (a run only by its last card)
sub HandHome:
  Ok = 0
  if Hs = 1 then
    Hc = Dk[Dp]
    if CanGoHome(Hc) = 1 then
      TakeWaste
      Ok = 1
    end if
  else
    N = Pl[Hp].N - 1
    if Hi = N then
      Hc = Pl[Hp].C[N]
      if CanGoHome(Hc) = 1 then
        Pl[Hp].N = N
        Pn = Hp
        TurnLast
        DrawPile
        Ok = 1
      end if
    end if
  end if
  if Ok = 1 then
    Su = SuitOf(Hc)
    inc Fd[Su]
    inc Up
    inc Moves
    DrawFound
    play sound SndHome
    ShowHud
    FixCursor
  else
    play sound SndBuzz
  end if
  Hs = 0
  ShowHand
  return
end sub

' CardToPile: the deck's card onto pile Cc
sub CardToPile:
  Cv = Dk[Dp]
  Ok = PileTakes(Cc, Cv)
  if Ok = 1 then
    N = Pl[Cc].N
    Pl[Cc].C[N] = Cv
    Pl[Cc].N = N + 1
    TakeWaste
    Pn = Cc
    DrawPile
    inc Moves
    ShowHud
    play sound SndLay
    Ci = N
  else
    play sound SndBuzz
  end if
  Hs = 0
  ShowHand
  return
end sub

' RunToPile: the run from card Hi of pile Hp onto pile Cc
sub RunToPile:
  Cv = Pl[Hp].C[Hi]
  Ok = PileTakes(Cc, Cv)
  if Ok = 1 then
    MoveRun
    inc Moves
    ShowHud
    play sound SndLay
  else
    play sound SndBuzz
  end if
  Hs = 0
  ShowHand
  return
end sub

sub MoveRun:
  u8 Src = 0
  u8 Dst = 0
  u8 A = 0
  u8 B = 0
  u8 E = 0
  Src = Hp
  Dst = Cc
  B = Pl[Dst].N
  E = Pl[Src].N
  Ci = B
  for A = Hi to E - 1
    Pl[Dst].C[B] = Pl[Src].C[A]
    inc B
  next
  Pl[Dst].N = B
  Pl[Src].N = Hi
  Pn = Src
  TurnLast
  DrawPile
  Pn = Dst
  DrawPile
  return
end sub

' PileTakes: 1 when pile P can take card C (a king on an empty pile)
function PileTakes(u8 P, u8 C) as u8
  u8 M = 0
  u8 T = 0
  M = Pl[P].N
  if M = 0 then
    if RankOf(C) = 12 then return 1
    return 0
  end if
  T = Pl[P].C[M - 1]
  return Fits(C, T)

' TakeWaste: the deck's turned card leaves (the listing's line 366)
sub TakeWaste:
  u8 A = 0
  u8 E = 0
  E = Dn - 1
  for A = Dp to E
    Dk[A] = Dk[A + 1]
  next
  Dn = E
  DrawTop
  ShowHud
  return
end sub

' TurnLast: pile Pn's new last card turns face up
sub TurnLast:
  N = Pl[Pn].N
  V = Pl[Pn].Down
  if V >= N then
    if N > 0 then
      Pl[Pn].Down = N - 1
      play sound SndFlip
    else
      Pl[Pn].Down = 0
    end if
  end if
  return
end sub

' CheckEnd: Done 1 when the deck is used up and every card is face up
sub CheckEnd:
  if Done <> 0 then return
  if Dn <> 0 then return
  for Lp = 0 to 6
    V = Pl[Lp].Down
    if V <> 0 then return
  next
  Done = 1
  return
end sub

' AutoFinish: the lowest card that can go home flies there, again and again
sub AutoFinish:
af_again:
  if Up = 52 then return
  for Aq = 0 to 6
    N = Pl[Aq].N
    if N > 0 then
      dec N
      Cv = Pl[Aq].C[N]
      if CanGoHome(Cv) = 1 then
        Pl[Aq].N = N
        Su = SuitOf(Cv)
        inc Fd[Su]
        inc Up
        Pn = Aq
        DrawPile
        DrawFound
        ShowHud
        play sound SndTick
        for Tm = 1 to 5
          Frame1
        next
        goto af_again
      end if
    end if
  next
  ' nothing could go (cannot happen with every card face up)
  return
end sub

' ---------------------------------------------------------------------
' the cursor

sub MoveCursor:
  if Lf1 = 1 then
    if Cc > 0 then
      dec Cc
      if Cr = 0 then
        if Cc = 2 then Cc = 1
      end if
    end if
  end if
  if Rt1 = 1 then
    if Cc < 6 then
      inc Cc
      if Cr = 0 then
        if Cc = 2 then Cc = 3
      end if
    end if
  end if
  if Lf1 | Rt1 then
    if Cr = 1 then TopCard
  end if
  if Up1 = 1 then
    if Cr = 1 then
      V = Pl[Cc].Down
      if Ci > V then
        dec Ci
      else
        Cr = 0
        if Cc = 2 then Cc = 1
      end if
    end if
  end if
  if Dn1 = 1 then
    if Cr = 0 then
      Cr = 1
      TopCard
    else
      N = Pl[Cc].N
      V = Ci + 1
      if V < N then Ci = V
    end if
  end if
  play sound SndFlick
  AimPile
  return
end sub

' TopCard: the cursor on pile Cc's last card
sub TopCard:
  N = Pl[Cc].N
  Ci = 0
  if N > 0 then Ci = N - 1
  return
end sub

' FixCursor: after a pile shrank, the cursor stays on a real card
sub FixCursor:
  if Cr = 1 then
    N = Pl[Cc].N
    if Ci >= N then TopCard
    V = Pl[Cc].Down
    if Ci < V then Ci = V
  end if
  AimPile
  return
end sub

' PileRow: the screen row of card I of pile P
function PileRow(u8 P, u8 I) as u8
  u8 D = 0
  u8 R = 6
  D = Pl[P].Down
  if D > 0 then
    R = 7
  end if
  if I > D then R = R + I - D
  return R

' AimPile: Tx, Ty the cursor's target (pixels)
sub AimPile:
  X = Cc << 2
  X = X + 2
  Tx = X << 3
  Tx = Tx - 1
  if Cr = 0 then
    Ty = 15
  else
    Y = PileRow(Cc, Ci)
    Ty = Y << 3
    Ty = Ty - 1
  end if
  return
end sub

' Glide: the cursor moves half the way each frame; blinks at 1.9 Hz
sub Glide:
  i16 D = 0
  D = Tx - Px
  if D > 1 then D = D / 2
  if D < -1 then D = D / 2
  Px = Px + D
  D = Ty - Py
  if D > 1 then D = D / 2
  if D < -1 then D = D / 2
  Py = Py + D
  V = Tick & 16
  W = 8
  if V = 0 then W = 9
  Gx = Px + 10
  set sprite 0 to Py,Px,SCurl,W
  set sprite 1 to Py,Gx,SCurr,W
  update sprites
  return
end sub

' ShowHand: a cyan frame round the cards in hand
sub ShowHand:
  if Hs = 0 then
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  else
    if Hs = 1 then
      Gx = 47
      Gy = 15
    else
      X = Hp << 2
      X = X + 2
      Gx = X << 3
      Gx = Gx - 1
      Y = PileRow(Hp, Hi)
      Gy = Y << 3
      Gy = Gy - 1
    end if
    X = Gx + 10
    set sprite 2 to Gy,Gx,SCurl,4
    set sprite 3 to Gy,X,SCurr,4
  end if
  update sprites
  return
end sub

sub HideCursor:
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------
' drawing

sub DrawAll:
  ShowHud
  DrawTop
  for Su = 0 to 3
    DrawFound
  next
  for Pn = 0 to 6
    DrawPile
  next
  Hint
  return
end sub

sub ShowHud:
  print at 2,1, "DECK"
  NumU = Dp
  print at 7,1, digits$(NumU, 2)
  if Lv = 1 then
    print at 14,1, "VEGAS"
    Money = Up * 5
    Money = Money - 50
    if Money < 0 then
      print at 22,1, "-$"
      NumU = -Money
    else
      print at 22,1, "+$"
      NumU = Money
    end if
    print at 24,1, digits$(NumU, 3)
  else
    print at 12,1, "MOVES"
    print at 18,1, Moves
    print at 24,1, "UP"
    NumU = Up
    print at 27,1, digits$(NumU, 2)
  end if
  return
end sub

sub Hint:
  Clear1
  print at 2,22, "FIRE: TAKE/PUT  RIGHT: UP"
  return
end sub

sub Clear1:
  print at 2,22, "                            "
  return
end sub

' DrawTop: the deck and its turned card
sub DrawTop:
  Cx = 2
  Cy = 2
  if Dp > 0 then
    DrawBack
  else
    if Dn > 0 then
      if Lv = 0 then
        DrawEmpty(TOrc)
      else
        DrawEmpty(TOmm)
      end if
    else
      DrawEmpty(TOmm)
    end if
  end if
  Cx = 6
  if Dp < Dn then
    Cv = Dk[Dp]
    DrawFace
  else
    DrawEmpty(TOmm)
  end if
  return
end sub

' DrawFound: the ace pile of suit Su
sub DrawFound:
  u8 F = 0
  Cx = Su << 2
  Cx = Cx + 14
  Cy = 2
  F = Fd[Su]
  if F = 0 then
    DrawEmpty(TFS + Su)
  else
    Cv = Su * 13
    Cv = Cv + F - 1
    DrawFace
  end if
  return
end sub

' DrawPile: pile Pn from row 6 down (the face-down cards as one strip)
sub DrawPile:
  u8 M = 0
  u8 D = 0
  u8 R = 6
  u8 A = 0
  M = Pl[Pn].N
  D = Pl[Pn].Down
  Cx = Pn << 2
  Cx = Cx + 2
  if M = 0 then
    Cy = 6
    DrawEmpty(TOk)
    R = 9
  else
    if D > 0 then
      X = Cx + 1
      W = Cx + 2
      put char TKtl at Cx,6
      V = TKd1 + D - 1
      put char V at X,6
      put char TKtr at W,6
      R = 7
    end if
    for A = D to M - 1
      Cy = R
      Cv = Pl[Pn].C[A]
      DrawCardTop
      inc R
    next
    ' the last card shows whole
    Cy = R - 1
    DrawCardRest
    R = R + 2
  end if
  while R < 22
    fill 32 count 3 at Cx,R
    inc R
  end while
  return
end sub

' DrawFace: card Cv whole at Cx, Cy
sub DrawFace:
  DrawCardTop
  DrawCardRest
  return
end sub

sub DrawCardTop:
  Rk = RankOf(Cv)
  Su = SuitOf(Cv)
  V = TRk00
  if RedOf(Cv) = 1 then V = TRR00
  V = V + Rk
  put char V at Cx,Cy
  X = Cx + 1
  V = TSS + Su
  put char V at X,Cy
  inc X
  put char TCtr at X,Cy
  return
end sub

' DrawCardRest: the body and bottom of card Cv whose top row is Cy
sub DrawCardRest:
  Su = SuitOf(Cv)
  X = Cx + 1
  W = Cx + 2
  Y = Cy + 1
  put char TCml at Cx,Y
  V = TBS + Su
  put char V at X,Y
  put char TCml at W,Y
  inc Y
  put char TCbl at Cx,Y
  put char TCbm at X,Y
  put char TCbr at W,Y
  return
end sub

sub DrawBack:
  X = Cx + 1
  W = Cx + 2
  Y = Cy
  put char TKtl at Cx,Y
  put char TKtm at X,Y
  put char TKtr at W,Y
  inc Y
  put char TKml at Cx,Y
  put char TKmm at X,Y
  put char TKmr at W,Y
  inc Y
  put char TKbl at Cx,Y
  put char TKbm at X,Y
  put char TKbr at W,Y
  return
end sub

' DrawEmpty: an empty place at Cx, Cy with tile Mid in its middle
sub DrawEmpty(u8 Mid):
  X = Cx + 1
  W = Cx + 2
  Y = Cy
  put char TOtl at Cx,Y
  put char TOtm at X,Y
  put char TOtr at W,Y
  inc Y
  put char TOml at Cx,Y
  put char Mid at X,Y
  put char TOmr at W,Y
  inc Y
  put char TObl at Cx,Y
  put char TObm at X,Y
  put char TObr at W,Y
  return
end sub

' MoneyNote: the listing's LAS VEGAS reckoning
sub MoneyNote:
  Clear1
  print at 2,20, "                            "
  print at 2,21, "                            "
  print at 2,20, "CARDS UP"
  NumU = Up
  print at 11,20, digits$(NumU, 2)
  print at 14,20, "PAY $"
  NumU = Up * 5
  print at 19,20, digits$(NumU, 3)
  Money = Up * 5
  Money = Money - 50
  if Money >= 0 then
    print at 2,21, "NET PROFIT OF $"
    NumU = Money
    print at 17,21, digits$(NumU, 3)
  else
    print at 2,21, "NET LOSS OF $"
    NumU = -Money
    print at 15,21, digits$(NumU, 3)
  end if
  if Up = 52 then print at 10,22, "YOU WON!!!"
  return
end sub

' ---------------------------------------------------------------------
' screens and the frame

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop dark green
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: four aces, the rules, a joystick menu
sub TitlePage:
  Ph = 0
  NewScreen
  print at 5,1, "S O L I T A I R E  6 4"
  Cy = 4
  for K = 0 to 3
    Cx = K << 2
    Cx = Cx + 8
    Cv = K * 13
    DrawFace
  next
  print at 3,9, "BUILD FOUR PILES ACE TO"
  print at 3,10, "KING IN SUIT. ON THE TABLE"
  print at 3,11, "STACK DOWN IN RED, BLACK."
  print at 9,14, "REGULAR (TURN 3)"
  print at 9,15, "LAS VEGAS (TURN 1)"
  print at 9,16, "CREDITS"
  print at 3,19, "STICK: MOVE  FIRE: TAKE/PUT"
  print at 3,20, "RIGHT: TO ACES"
  print at 3,21, "BOTH BUTTONS: CONCEDE"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadPad
  Rs = Rs + 257
  Rs = Rs + Tick
  V = Up1 | Dn1
  if V = 1 then
    if WasStk = 0 then
      if Up1 = 1 then
        if Menu = 0 then
          Menu = 2
        else
          dec Menu
        end if
      else
        inc Menu
        if Menu = 3 then Menu = 0
      end if
      ShowMenu
      play sound SndFlick
    end if
  end if
  WasStk = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for K = 0 to 2
    V = K + 14
    put char 32 at 7,V
  next
  V = Menu + 14
  put char 62 at 7,V
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen
  Cy = 2
  for K = 0 to 3
    Cx = K << 2
    Cx = Cx + 8
    Cv = K * 13
    Cv = Cv + 12
    DrawFace
  next
  print at 3,7, "BASED ON SOLITAIRE 64 BY"
  print at 3,8, "ERIC W. SINK, AHOY!"
  print at 3,9, "OCTOBER 1985 (COMMODORE 64"
  print at 3,10, "BASIC). KLONDIKE RULES."
  print at 3,12, "MADE FOR THE COLECOVISION"
  print at 3,13, "BY CLAUDE (AN AI MADE BY"
  print at 3,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,15, "2026, IN AMY BY AMY"
  print at 3,16, "BIENVENU."
  print at 3,18, "MUSIC: KITCHEN TABLE"
  print at 8,21, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
  Menu = 0
  return
end sub

