cartridge "SP0256 VOICE DEMO/AMY STUDIO/2026"

' Modern Amy support for Lundy and EVE SS-CC SP0256 voice modules.
' Module values are 0=None, 1=Lundy, and 2=EVE.

u8 VoiceModule = 0
u8 Speaking = 0

text screen
cls
print centered at 5, "SP0256 VOICE MODULE"
print centered at 8, "DETECTING HARDWARE..."
screen on

voice detect into VoiceModule
if VoiceModule = 0 then
  print centered at 11, "MODULE NOT DETECTED"
else
  print centered at 11, "MODULE DETECTED"
  print centered at 14, "SPEAKING LASER STRIKE"
  voice start PhraseLaserStrike using VoiceModule
  do
    voice speaking into Speaking
    wait
  loop while Speaking
  print centered at 16, "PHRASE COMPLETE"
end if

loop forever

' Exact allophones captured from Laser Strike's publisher phrase.
data PhraseLaserStrike bytes
  $2D,$14,$2B,$33,$02,$37,$02,$11,$27,$06,$02,$29,$02,$3F,$06
  $02,$21,$0C,$0E,$18,$01,$29,$35,$23,$0C,$26,$0F,$0B,$03,$FF
end data
