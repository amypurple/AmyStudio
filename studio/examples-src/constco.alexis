  tile screen
  set sound table CcSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  Stage = 1
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

day_loop:
  Morning
  if Over > 0 then goto game_end
  if Arrested = 1 then goto day_loop
  OfficePage
  WorkDay
  if Over > 0 then goto game_end
  goto day_loop

game_end:
  EndPage
  Stage = 6
  Pause(60)
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

sub NewGame:
  Cash = 35000
  Loan = 39200
  LoanDue = 30
  Day = 0
  HouseNo = 1
  StageI = 0
  Prog = 0
  Shown = 0
  Over = 0
  Wo = 5
  for Mi = 0 to 10
    Stock[Mi] = 0
  next
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' the day's prices: base + a random part of the mark-up range (cents)
sub NewPrices:
  u16 Rg = 0
  for Mi = 0 to 10
    Rand
    Rg = MatRange[Mi]
    Price[Mi] = MatBase[Mi] + Rs % Rg
  next
  return
end sub

' 1 when the material is on sale (under half the mark-up)
function OnSale(u8 Ma) as u8
  u16 Hf = 0
  Hf = MatRange[Ma] / 2
  if Price[Ma] < MatBase[Ma] + Hf then return 1
  return 0

' what the rest of this house needs of each material, beyond the stock
sub CalcNeed:
  u16 Rem16 = 0
  u8 Ma = 0
  for Mi = 0 to 10
    Need[Mi] = 0
  next
  for Si = StageI to 11
    Rem16 = StUnits[Si]
    if Si = StageI then Rem16 = Rem16 - Prog
    Ma = StMatA[Si]
    if StOnce[Si] = 1 then
      if Rem16 > 0 then Need[Ma] = Need[Ma] + 1
      if Si = StageI then
        if Prog > 0 then Need[Ma] = Need[Ma] - 1
      end if
    else
      Need[Ma] = Need[Ma] + Rem16 * StQA[Si]
    end if
    Ma = StMatB[Si]
    if Ma < 11 then Need[Ma] = Need[Ma] + Rem16 * StQB[Si]
  next
  for Mi = 0 to 10
    if Need[Mi] > Stock[Mi] then
      Need[Mi] = Need[Mi] - Stock[Mi]
    else
      Need[Mi] = 0
    end if
  next
  return
end sub

' the morning: day, events, loan due, bankruptcy, prices
sub Morning:
  inc Day
  Arrested = 0
  Ev = 0
  Rand
  W16 = Rs % 250
  if W16 = 249 then Ev = 2
  if W16 = 248 then
    if Day > 1 then Ev = 1
  end if
  if Ev = 2 then
    Arrested = 1
    ArrestPage
  else
    if Ev = 1 then
      for Mi = 0 to 10
        Stock[Mi] = 0
      next
    end if
    Ev = Ev * 2
    if Loan > 0 then
      if Day >= LoanDue then
        Cash = Cash - Loan
        Loan = 0
        Ev = Ev + 1
      end if
    end if
    if Cash <= 0 then Over = 2
    NewPrices
  end if
  return
end sub

' the bank's loan: 1-3 times $15,000, 12% interest, due in 30 days
sub TakeLoan:
  MV = 15000
  if LoanPick = 2 then MV = 30000
  if LoanPick = 3 then MV = 45000
  Cash = Cash + MV
  Loan = MV * 112
  Loan = Loan / 100
  LoanDue = Day + 30
  return
end sub

' cents to dollars, rounded up: C32 = Qty x Price[Cur]
sub CostOf:
  C32 = Qty
  W16 = Price[Cur]
  T32 = W16
  C32 = C32 * T32
  C32 = C32 + 99
  C32 = C32 / 100
  return
end sub

' one unit of the stage's work. Res: 0 done, 1 out of a material (OutMat),
' 2 the stage is finished
sub DoUnit:
  u8 Use = 1
  u16 Tgt = 0
  Res = 0
  if CuOnce = 1 then
    if Prog > 0 then Use = 0
  end if
  if Use = 1 then
    if Stock[CuMa] < CuQa then
      Res = 1
      OutMat = CuMa
    end if
    if CuMb < 11 then
      if Stock[CuMb] < CuQb then
        Res = 1
        OutMat = CuMb
      end if
    end if
  end if
  if Res = 0 then
    if Use = 1 then
      Stock[CuMa] = Stock[CuMa] - CuQa
      if CuMb < 11 then Stock[CuMb] = Stock[CuMb] - CuQb
    end if
    inc Prog
    Hr = Hr + CuHrs
    ' cells to show: Prog * Kmul / 256, kept as a running fraction
    Frac = Frac + CuKmul
    while Frac >= 256
      Frac = Frac - 256
      inc RevTgt
    end while
    Tgt = RevTgt
    if Prog >= CuUnits then
      Tgt = CuCells
      Res = 2
    end if
    while Shown < Tgt
      PutCell(CuCell0 + Shown)
      inc Shown
    end while
  end if
  return
end sub

' the current stage's numbers, copied once from the tables
sub LoadStage:
  CuMa = StMatA[StageI]
  CuMb = StMatB[StageI]
  CuQa = StQA[StageI]
  CuQb = StQB[StageI]
  CuOnce = StOnce[StageI]
  CuHrs = StHrs[StageI]
  CuUnits = StUnits[StageI]
  CuKmul = StKmul[StageI]
  CuCell0 = StCell0[StageI]
  CuCells = StCell0[StageI + 1] - CuCell0
  Frac = Prog * CuKmul
  RevTgt = Frac >> 8
  Frac = Frac & 255
  return
end sub

sub PutCell(u16 Ci):
  X = CellX[Ci]
  Y = CellY[Ci]
  put char CellT[Ci] at X,Y
  WkGoal = X * 8 - 8
  if Hammer = 0 then
    play sound SndHammer
    Hammer = 6
  end if
  return
end sub

' the crew's day on the site
sub WorkDay:
  u16 Budget = 0
  u16 Acc = 0
  SitePage
  Hr = 0
  Qt = Wo * 800
  DayOver = 0
  HouseDone = 0
  Stage = 5
wd_loop:
  Frame1
  inc Rs
  ReadPad
  Budget = 25
  Speed = 0
  if J1 & 48 then
    Budget = 100
    Speed = 1
  end if
  Acc = 0
  while Acc < Budget and DayOver = 0
    DoUnit
    if Res = 1 then
      DayOver = 1
    else
      Acc = Acc + CuHrs
      if Res = 2 then
        StageDone
      else
        if Hr >= Qt then DayOver = 2
      end if
    end if
  end while
  ShowHours
  MoveWorkers
  if Hammer > 0 then dec Hammer
  if DayOver = 0 then goto wd_loop
  ' the end of the day: the crew is paid
  MV = Wo
  MV = MV * 70
  Cash = Cash - MV
  ShowCash
  select case DayOver
  case 1
    MsgClear
    print at 2,20, "YOU RAN OUT OF"
    put MatName + OutMat * 7 count 7 at 17,20
    print at 2,21, "CREW PAID AND SENT HOME"
    play sound SndBad
  case 3
    MsgClear
    print at 2,20, "HOUSE FINISHED!!"
    print at 2,21, "SOLD FOR $50000. CREW PAID."
    play sound SndHouse
  case else
    if Res = 2 then
      print at 2,22, "THAT ENDS THE DAY; CREW PAID"
    else
      MsgClear
      print at 2,21, "WORK FINISHED FOR TODAY."
      print at 2,22, "CREW PAID."
    end if
    play sound SndPaid
  end select
  WaitButton
  if DayOver = 3 then HouseSold
  return
end sub

sub StageDone:
  u8 Ends = 0
  Ends = StEnd[StageI]
  MsgClear
  put StName + StageI * 12 count 12 at 2,21
  print at 15,21, "FINISHED!"
  play sound SndStage
  inc StageI
  Prog = 0
  Shown = 0
  if StageI = NStages then
    DayOver = 3
  else
    LoadStage
    ShowStage
    if Ends = 1 then DayOver = 2
  end if
  return
end sub

sub HouseSold:
  Cash = Cash + HousePay
  inc HouseNo
  StageI = 0
  Prog = 0
  Shown = 0
  if HouseNo > NHouses then Over = 1
  return
end sub

' ---------------------------------------------------------------------------
' numbers

' MV as money at Mx,My: "$123", "-$45"; Nw columns cleared first
sub PutMoney(u8 Mx, u8 My, u8 Nw):
  u8 Nd = 0
  u8 Px = 0
  fill 32 count Nw at Mx,My
  Px = Mx
  if MV < 0 then
    put char 45 at Px,My
    inc Px
    MV = 0 - MV
  end if
  put char 36 at Px,My
  inc Px
  Mu = MV
  Nd = 0
  do
    T32 = Mu % 10
    W16 = lowword T32
    Dg[Nd] = W16
    Mu = Mu / 10
    inc Nd
  loop until Mu = 0
  while Nd > 0
    dec Nd
    put char Dg[Nd] + 48 at Px,My
    inc Px
  end while
  return
end sub

' a price in cents as $D.CC (7 columns, right-aligned)
sub PutPrice(u16 Pc, u8 Px, u8 Py):
  u16 Dl = 0
  u16 Ce = 0
  Dl = Pc / 100
  Ce = Pc % 100
  fill 32 count 7 at Px,Py
  if Dl >= 100 then
    put char 36 at Px,Py
    print Dl at Px + 1,Py digits 3
  else
    if Dl >= 10 then
      put char 36 at Px + 1,Py
      print Dl at Px + 2,Py digits 2
    else
      put char 36 at Px + 2,Py
      print Dl at Px + 3,Py digits 1
    end if
  end if
  put char 46 at Px + 4,Py
  print Ce at Px + 5,Py digits 2
  return
end sub

sub PutNum(u16 Nv, u8 Nx, u8 Ny):
  print Nv at Nx,Ny width 5
  return
end sub

' ---------------------------------------------------------------------------
' the morning office

sub ArrestPage:
  NewScreen
  OfficeHead
  print at 2,9, "YOU WERE ARRESTED FOR"
  print at 2,10, "BRIBING A BUILDING"
  print at 2,11, "INSPECTOR. NO WORK TODAY!"
  ShowScreen
  Stage = 3
  play sound SndArrest
  WaitButton
  return
end sub

sub OfficeHead:
  print at 2,1, "CONSTRUCTION CO."
  print at 21,1, "DAY"
  print Day at 25,1 digits 3
  fill TRule count 28 at 2,2
  print at 2,3, "HOUSE"
  put char HouseNo + 48 at 8,3
  print at 10,3, "OF"
  put char NHouses + 48 at 13,3
  return
end sub

sub ShowOfficeMoney:
  print at 2,6, "CASH"
  MV = Cash
  PutMoney(8, 6, 9)
  fill 32 count 28 at 2,7
  if Loan > 0 then
    print at 2,7, "LOAN"
    MV = Loan
    PutMoney(8, 7, 7)
    print at 16,7, "DUE DAY"
    print LoanDue at 24,7 digits 3
  else
    print at 2,7, "NO LOAN"
  end if
  return
end sub

sub ShowCrew:
  put char Wo + 48 at 18,13
  MV = Wo
  MV = MV * 70
  PutMoney(22, 13, 4)
  return
end sub

sub ShowLoanRow:
  fill 32 count 26 at 4,14
  LoanOk = 0
  if Loan = 0 then
    if Cash < 5000 then LoanOk = 1
  end if
  if LoanOk = 1 then
    print at 4,14, "BANK LOAN"
    print at 16,14, "<"
    MV = LoanPick
    MV = MV * 15000
    PutMoney(18, 14, 6)
    print at 25,14, ">"
  else
    print at 4,14, "(NO LOAN OFFERED)"
  end if
  return
end sub

sub ShowOfficeMenu:
  for Li = 13 to 16
    put char 32 at 2,Li
  next
  put char 62 at 2,Menu + 13
  return
end sub

sub OfficePage:
  DrawOffice
  Menu = 3
  ShowOfficeMenu
  ShowScreen
  Stage = 3
  if Ev > 1 then play sound SndTheft
  if Ev = 1 then play sound SndPaid
  ReadPad
  LastDir = 0
  OfficeLoop
  return
end sub

sub DrawOffice:
  NewScreen
  OfficeHead
  print at 2,4, "STAGE"
  put StName + StageI * 12 count 12 at 8,4
  ShowBar(2, 5)
  ShowOfficeMoney
  select case Ev
  case 1
    print at 2,9, "YOUR LOAN WAS DUE TODAY."
    print at 2,10, "THE BANK HAS BEEN PAID."
  case 2
    print at 2,9, "YOUR MATERIALS WERE STOLEN"
    print at 2,10, "OVERNIGHT!!"
  case 3
    print at 2,9, "YOUR MATERIALS WERE STOLEN"
    print at 2,10, "OVERNIGHT!! AND YOUR LOAN"
    print at 2,11, "WAS DUE: THE BANK IS PAID."
  end select
  print at 4,13, "WORKERS"
  print at 16,13, "<"
  print at 20,13, ">"
  print at 26,13, "/DAY"
  ShowCrew
  ShowLoanRow
  print at 4,15, "BUY MATERIALS"
  print at 4,16, "START WORK"
  print at 2,19, "EACH WORKER: 8 HOURS, $70."
  print at 2,20, "A STAGE FINISHED ENDS THE"
  print at 2,21, "DAY. A HOUSE SELLS: $50000."
  return
end sub

sub OfficeLoop:
op_loop:
  Asking = 1
  Frame1
  inc Rs
  ReadPad
  StickRep
  if Held & 3 then
    if Held & 1 then
      if Menu > 0 then dec Menu
      if Menu = 1 then
        if LoanOk = 0 then Menu = 0
      end if
    else
      if Menu < 3 then inc Menu
      if Menu = 1 then
        if LoanOk = 0 then Menu = 2
      end if
    end if
    play sound SndTick
    ShowOfficeMenu
  end if
  if Held & 12 then
    if Menu = 0 then
      if Held & 8 then
        if Wo < 9 then inc Wo
      else
        if Wo > 1 then dec Wo
      end if
      play sound SndTick
      ShowCrew
    end if
    if Menu = 1 then
      if Held & 8 then
        if LoanPick < 3 then inc LoanPick
      else
        if LoanPick > 1 then dec LoanPick
      end if
      play sound SndTick
      ShowLoanRow
    end if
  end if
  if Press = 0 then goto op_loop
  if Menu = 1 then
    TakeLoan
    play sound SndPaid
    ShowOfficeMoney
    ShowLoanRow
    Menu = 2
    ShowOfficeMenu
    goto op_loop
  end if
  if Menu = 2 then
    Asking = 0
    MarketPage
    DrawOffice
    ShowOfficeMenu
    ShowScreen
    Stage = 3
    ReadPad
    goto op_loop
  end if
  if Menu = 0 then goto op_loop
  Asking = 0
  play sound SndPick
  return
end sub

' the stage's progress bar: 10 cells at Bx,By
sub ShowBar(u8 Bx, u8 By):
  u16 Fl = 0
  Fl = Prog * 10
  Fl = Fl / StUnits[StageI]
  for Li = 0 to 9
    if Li < Fl then
      put char TBarf at Bx + Li,By
    else
      put char TBare at Bx + Li,By
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the supply yard

sub MarketRow(u8 Ma):
  Y = Ma + 4
  put MatName + Ma * 7 count 7 at 3,Y
  put char 32 at 10,Y
  if OnSale(Ma) = 1 then put char TSale at 10,Y
  PutPrice(Price[Ma], 11, Y)
  PutNum(Stock[Ma], 19, Y)
  PutNum(Need[Ma], 25, Y)
  return
end sub

sub ShowBuy:
  fill 32 count 28 at 2,17
  fill 32 count 28 at 2,18
  if Cur < NMat then
    print at 2,17, "BUY"
    PutNum(Qty, 6, 17)
    put MatName + Cur * 7 count 7 at 12,17
    print at 20,17, "COST"
    CostOf
    MV = C32
    PutMoney(24, 17, 6)
    print at 2,18, "PRICE"
    PutPrice(Price[Cur], 7, 18)
    put MatUnit + Cur * 6 count 6 at 15,18
  end if
  print at 2,19, "CASH"
  MV = Cash
  PutMoney(7, 19, 9)
  return
end sub

sub ShowMarketCursor:
  for Li = 4 to 15
    put char 32 at 2,Li
  next
  put char 62 at 2,Cur + 4
  return
end sub

function MaxQty() as u16
  return MaxStock - Stock[Cur]

' the amount changes by 1, then 10, 100, 1000 as the stick is held
sub ChangeQty(u8 More):
  u16 Stp = 1
  u16 Top = 0
  if HoldN >= 6 then Stp = 10
  if HoldN >= 14 then Stp = 100
  if HoldN >= 24 then Stp = 1000
  Top = MaxQty()
  if More = 1 then
    if Qty + Stp > Top then
      Qty = Top
    else
      Qty = Qty + Stp
    end if
  else
    if Qty < Stp then
      Qty = 0
    else
      Qty = Qty - Stp
    end if
  end if
  return
end sub

sub MarketPage:
  NewScreen
  print at 2,1, "BUILDING SUPPLY"
  print at 21,1, "DAY"
  print Day at 25,1 digits 3
  fill TRule count 28 at 2,2
  print at 3,3, "ITEM    PRICE   HAVE  NEED"
  CalcNeed
  for Mi = 0 to 10
    MarketRow(Mi)
  next
  print at 3,15, "DONE"
  put char TSale at 2,21
  print at 3,21, "ON SALE  R.BUTTON: NEED"
  Cur = 0
  Qty = 0
  ShowMarketCursor
  ShowBuy
  ShowScreen
  Stage = 4
  InYard = 1
  ReadPad
  LastDir = 0
mk_loop:
  Asking = 1
  Frame1
  inc Rs
  ReadPad
  StickRep
  if Held & 3 then
    if Held & 1 then
      if Cur > 0 then dec Cur
    else
      if Cur < NMat then inc Cur
    end if
    Qty = 0
    play sound SndTick
    ShowMarketCursor
    ShowBuy
  end if
  if Held & 12 then
    if Cur < NMat then
      if Held & 8 then
        ChangeQty(1)
      else
        ChangeQty(0)
      end if
      ShowBuy
    end if
  end if
  if Press2 = 1 then
    if Cur < NMat then
      Qty = Need[Cur]
      if Qty > MaxQty() then Qty = MaxQty()
      play sound SndTick
      ShowBuy
    end if
  end if
  if Press = 0 then goto mk_loop
  if Cur = NMat then
    Asking = 0
    InYard = 0
    play sound SndPick
    return
  end if
  if Qty > 0 then
    CostOf
    MV = C32
    if MV > Cash then
      print at 2,20, "YOU CAN'T AFFORD THAT!"
      play sound SndBad
      Pause(50)
      fill 32 count 28 at 2,20
    else
      Cash = Cash - MV
      Stock[Cur] = Stock[Cur] + Qty
      Qty = 0
      CalcNeed
      for Mi = 0 to 10
        PutNum(Need[Mi], 25, Mi + 4)
      next
      PutNum(Stock[Cur], 19, Cur + 4)
      play sound SndBuy
      ShowBuy
    end if
  end if
  goto mk_loop
end sub

' ---------------------------------------------------------------------------
' the building site

sub DrawSite:
  u16 Ci = 0
  u16 Ce = 0
  for Li = 2 to 17
    fill TSky count 19 at 2,Li
  next
  fill TDirt count 19 at 2,17
  fill TGrass count 19 at 2,18
  ' the finished stages, then the current one's cells so far
  Ce = StCell0[StageI] + Shown
  Ci = 0
  while Ci < Ce
    put char CellT[Ci] at CellX[Ci],CellY[Ci]
    inc Ci
  end while
  return
end sub

sub ShowHours:
  W16 = Hr / Wo
  W16 = W16 / 100
  print W16 at 23,6 digits 1
  ShowBar(19, 20)
  return
end sub

sub ShowCash:
  MV = Cash
  PutMoney(22, 9, 8)
  return
end sub

sub ShowStage:
  fill 32 count 16 at 2,20
  put StName + StageI * 12 count 12 at 2,20
  ShowBar(19, 20)
  return
end sub

sub MsgClear:
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub SitePage:
  LoadStage
  NewScreen
  DrawSite
  print at 22,2, "DAY"
  print Day at 22,3 digits 3
  print at 22,5, "HOURS"
  print at 22,8, "CASH"
  print at 22,11, "CREW"
  put char Wo + 48 at 22,12
  print at 22,14, "HOUSE"
  put char HouseNo + 48 at 22,15
  print at 23,15, "/"
  put char NHouses + 48 at 24,15
  ShowCash
  ShowStage
  print at 2,21, "WORK IN PROGRESS."
  print at 2,22, "HOLD A BUTTON: FASTER"
  ShowHours
  for Li = 0 to 2
    WkX[Li] = Li * 16 + 40
  next
  MoveWorkers
  ShowScreen
  return
end sub

' up to three workers walk to where the work is and hammer
sub MoveWorkers:
  u8 Gx = 0
  u8 Fr = 0
  u8 Nw = 0
  Nw = Wo
  if Nw > 3 then Nw = 3
  for Li = 0 to 2
    if Li < Nw then
      Gx = WkGoal + Li * 14
      if Gx > 148 then Gx = 148 - Li * 14
      if Gx < 16 then Gx = 16 + Li * 14
      if WkX[Li] < Gx then inc WkX[Li]
      if WkX[Li] > Gx then dec WkX[Li]
      Fr = SWork0
      if DayOver = 0 then
        if (Tick + Li * 3) & 8 then Fr = SWork1
      end if
      set sprite Li to 135,WkX[Li],Fr,9
    else
      set sprite Li to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' the end

sub EndPage:
  u8 Won = 0
  NewScreen
  Profit = Cash - Loan
  if Over = 2 then
    print at 2,3, "YOU ARE BANKRUPT!!!!"
  else
    print at 2,3, "YOU FINISHED THE CONTRACT!!"
  end if
  print at 2,5, "HOUSES BUILT"
  put char HouseNo + 47 at 15,5
  print at 2,6, "DAYS"
  print Day at 15,6 digits 3
  if Profit >= 0 then
    Won = 1
    print at 2,9, "AFTER PAYING YOUR DEBTS"
    print at 2,10, "YOU MADE:"
    MV = Profit
    PutMoney(12, 10, 9)
    print at 2,12, "CONGRATULATIONS!!!"
    play sound SndWin
  else
    print at 2,9, "TOO BAD YOU OWE THE BANK:"
    MV = Profit
    PutMoney(2, 10, 10)
    print at 2,12, "AND HAD TO RETIRE IN"
    print at 2,13, "DISGRACE."
    play sound SndLose
  end if
  if Won = 1 then
    if HasBest = 0 or Profit > Best then
      Best = Profit
      HasBest = 1
      print at 2,15, "A NEW BEST PROFIT!"
    end if
  end if
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

sub WaitButton:
  ReadPad
  Asking = 2
wb_loop:
  Frame1
  inc Rs
  ReadPad
  if Press = 0 then goto wb_loop
  Asking = 0
  play sound SndTick
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Nf):
  u8 Pk = 0
  for Pk = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up or joypad(2).up then J1 = J1 | 1
  if joypad(1).down or joypad(2).down then J1 = J1 | 2
  if joypad(1).left or joypad(2).left then J1 = J1 | 4
  if joypad(1).right or joypad(2).right then J1 = J1 | 8
  if joypad(1).button1 or joypad(2).button1 then J1 = J1 | 16
  if joypad(1).button2 or joypad(2).button2 then J1 = J1 | 32
  Pj = J1
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if J1 & 32 then
    if WasB2 = 0 then Press2 = 1
    WasB2 = 1
  else
    WasB2 = 0
  end if
  ' the right button acts like the left one, except in the supply yard
  if InYard = 0 then
    if Press2 = 1 then Press = 1
  end if
  return
end sub

' the stick: Held = the direction (bit 1 up, 2 down, 4 left, 8 right)
' when it acts this frame (at once, then repeated); HoldN counts repeats
sub StickRep:
  D = Pj & 15
  Held = 0
  if D = 0 then
    LastDir = 0
  else
    if D <> LastDir then
      Held = D
      Rep = 16
      HoldN = 0
    else
      dec Rep
      if Rep = 0 then
        Held = D
        Rep = 4
        if HoldN < 250 then inc HoldN
      end if
    end if
    LastDir = D
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub ShowHouses:
  put char NHouses + 48 at 23,19
  return
end sub

sub ShowMenu:
  for J = 19 to 21
    put char 32 at 4,J
  next
  J = Menu + 19
  put char 62 at 4,J
  return
end sub

' the title: the finished house, the tune once, the menu
sub TitlePage:
  u16 Ci = 0
  NewScreen
  print at 8,1, "CONSTRUCTION CO."
  print at 2,2, "BY B.W. BEHLING, AHOY! 1984"
  for Li = 3 to 16
    fill TSky count 19 at 6,Li
  next
  fill TGrass count 28 at 2,18
  Ci = 0
  while Ci < NCells
    Y = CellY[Ci]
    if Y >= 3 then put char CellT[Ci] at CellX[Ci] + 4,Y
    inc Ci
  end while
  print at 6,19, "HOUSES TO BUILD"
  print at 6,20, "START BUILDING"
  print at 6,21, "CREDITS"
  print at 22,19, "<"
  print at 24,19, ">"
  Menu = 1
  ShowHouses
  ShowMenu
  if HasBest = 1 then
    print at 6,22, "BEST"
    MV = Best
    PutMoney(11, 22, 9)
  end if
  ShowScreen
  Stage = 2
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  ReadPad
  LastDir = 0
tp_loop:
  Asking = 1
  Frame1
  inc Rs
  ReadPad
  StickRep
  if Held & 3 then
    if Held & 1 then
      if Menu > 0 then dec Menu
    else
      if Menu < 2 then inc Menu
    end if
    ShowMenu
    play sound SndTick
  end if
  if Held & 12 then
    if Menu = 0 then
      if Held & 4 then
        if NHouses > 1 then dec NHouses
      else
        if NHouses < 5 then inc NHouses
      end if
      ShowHouses
      play sound SndTick
    end if
  end if
  if Press = 0 then goto tp_loop
  if Menu = 0 then goto tp_loop
  Asking = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  if Menu = 2 then
    Stage = 1
    CreditsPage
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 7,1, "CONSTRUCTION CO."
  print at 2,3, "BASED ON CONSTRUCTION CO."
  print at 2,4, "BY B.W. BEHLING, AHOY! 1984"
  print at 2,5, "(COMMODORE 64)."
  print at 2,7, "BUILD ONE TO FIVE HOUSES ON"
  print at 2,8, "A BANK LOAN: HIRE A CREW,"
  print at 2,9, "BUY MATERIALS ON SALE DAYS,"
  print at 2,10, "WATCH OUT FOR THIEVES AND"
  print at 2,11, "PAY THE BANK WHEN IT IS DUE."
  print at 2,13, "COLECOVISION GAME, MUSIC"
  print at 2,14, "AND PICTURES BY CLAUDE"
  print at 2,15, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,16, "IN AMY BY AMY BIENVENU,"
  print at 2,17, "2026."
  print at 2,19, "MUSIC: HARD HATS ON"
  print at 2,20, "(ORIGINAL)"
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub


