    dw sndtiny_1
    db 8
    db $02,$30,$1A,$21,$1A,$01,$1C,$1E,$01,$1F,$21,$01,$01,$1A,$01,$01
    db $1E,$1F,$21,$23,$01,$25,$26,$01,$01,$01,$01,$01,$26,$01,$01,$21
