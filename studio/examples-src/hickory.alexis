; ---------------------------------------------------------------------------
; HdDraw: both hands at HdHp (the hour hand's position, 0-59) and HdM (the
; minute, 0-59), dots set (HdPc 1) or cleared (HdPc 0); then the hub when
; setting. The hour hand 3 dots thick (x, x+1, y+1), the minute hand 2.
; NMI off.
; ---------------------------------------------------------------------------
HdDraw:
    ld a,(AMY_UVAR_HdHp)
    ld hl,HdHr
    ld de,20*2
    call hd_index
    ld b,20
hd_hr:
    push bc
    ld a,(hl)
    add a,88
    ld (AMY_UVAR_HdX),a
    inc hl
    ld a,(hl)
    add a,84
    ld (AMY_UVAR_HdY),a
    inc hl
    push hl
    call HdPix
    ld hl,AMY_UVAR_HdX
    inc (hl)
    call HdPix
    ld hl,AMY_UVAR_HdY
    inc (hl)
    call HdPix
    pop hl
    pop bc
    djnz hd_hr
    ld a,(AMY_UVAR_HdM)
    ld hl,HdMin
    ld de,32*2
    call hd_index
    ld b,32
hd_mn:
    push bc
    ld a,(hl)
    add a,88
    ld (AMY_UVAR_HdX),a
    inc hl
    ld a,(hl)
    add a,84
    ld (AMY_UVAR_HdY),a
    inc hl
    push hl
    call HdPix
    ld hl,AMY_UVAR_HdX
    inc (hl)
    call HdPix
    pop hl
    pop bc
    djnz hd_mn
    ld a,(AMY_UVAR_HdPc)
    or a
    ret z
    ; the hub: 4 x 4 round the centre
    ld c,84-2
hd_hub_y:
    ld a,c
    ld (AMY_UVAR_HdY),a
    ld b,88-1
hd_hub_x:
    ld a,b
    ld (AMY_UVAR_HdX),a
    push bc
    call HdPix
    pop bc
    inc b
    ld a,b
    cp 88+3
    jr nz,hd_hub_x
    inc c
    ld a,c
    cp 84+3
    jr nz,hd_hub_y
    ret

; HL = HL + A * DE
hd_index:
    or a
    ret z
hd_ix:
    add hl,de
    dec a
    jr nz,hd_ix
    ret

; HdPix: the dot HdX,HdY set (HdPc 1) or cleared (HdPc 0) in the bitmap
HdPix:
    ld a,(AMY_UVAR_HdY)
    ld c,a
    rrca
    rrca
    rrca
    and $1F
    ld h,a
    ld a,(AMY_UVAR_HdX)
    and $F8
    ld l,a
    ld a,c
    and 7
    or l
    ld l,a
    ld a,(AMY_UVAR_HdX)
    and 7
    ld b,a
    ld a,$80
    jr z,hp_m
hp_sh:
    rrca
    djnz hp_sh
hp_m:
    ld e,a
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld d,a
    ld a,(AMY_UVAR_HdPc)
    or a
    jr z,hp_clr
    ld a,d
    or e
    jr hp_put
hp_clr:
    ld a,e
    cpl
    and d
hp_put:
    ld d,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,d
    out ($BE),a
    ret
HdSong:
    dw $0001
    db $40+1,2
    dw $0000
}
