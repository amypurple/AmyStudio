; ---------------------------------------------------------------------------
; Text on the bitmap screen (after games/hs/ztext.asm): character ZCh at
; cell ZCol,ZRow (pattern at row*256 + col*8, colour at $2000 + the same),
; colour byte ZClr; the font is HdFont (characters 32-95, art.py)
; ---------------------------------------------------------------------------
ZCellAddr:
    ld a,(AMY_UVAR_ZRow)
    ld h,a
    ld a,(AMY_UVAR_ZCol)
    add a,a
    add a,a
    add a,a
    ld l,a
    ret

; HL = 8 pattern bytes for the current cell, then its colour
ZPut8:
    push hl
    call ZCellAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop hl
    ld b,8
zp8_p:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz zp8_p
    call ZCellAddr
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_ZClr)
    ld b,8
zp8_c:
    out ($BE),a
    nop
    nop
    djnz zp8_c
    ld hl,AMY_UVAR_ZCol
    inc (hl)
    ret

ZPutCh:
    ld a,(AMY_UVAR_ZCh)
    sub 32
    jr nc,zpc_ok
    xor a
zpc_ok:
    cp 64
    jr c,zpc_in
    ld a,31
zpc_in:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,HdFont
    add hl,de
    jp ZPut8

; the zero-ended string at ZPtr
ZPrint:
    ld hl,(AMY_UVAR_ZPtr)
zpr_loop:
    ld a,(hl)
    or a
    ret z
    ld (AMY_UVAR_ZCh),a
    push hl
    call ZPutCh
    pop hl
    inc hl
    jr zpr_loop

