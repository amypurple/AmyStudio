project "Dacman Diagnostic"
cartridge "DACMAN DIAG/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

picture DacmanTitlePicture:
  pattern from "@project/dacman-title.pattern.zx0" codec zx0
  color from "@project/dacman-title.color.zx0" codec zx0
end picture

sub start:
  show picture DacmanTitlePicture
  loop forever
end sub
