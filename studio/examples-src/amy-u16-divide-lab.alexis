u16 X = 0
u8 Pass = 0

  text screen
  print at 4,0, "U16 DIVIDE LAB"

  print at 1,3, "65535/1"
  X = 65535
  X /= 1
  if X = 65535 then
    Pass += 1
    print at 22,3, "PASS"
  else
    print at 22,3, "FAIL"
  end if

  print at 1,5, "65535/65535"
  X = 65535
  X /= 65535
  if X = 1 then
    Pass += 1
    print at 22,5, "PASS"
  else
    print at 22,5, "FAIL"
  end if

  print at 1,7, "3/7"
  X = 3
  X /= 7
  if X = 0 then
    Pass += 1
    print at 22,7, "PASS"
  else
    print at 22,7, "FAIL"
  end if

  print at 1,9, "40000/200"
  X = 40000
  X /= 200
  if X = 200 then
    Pass += 1
    print at 22,9, "PASS"
  else
    print at 22,9, "FAIL"
  end if

  print at 1,13, "TOTAL"
  print Pass at 7,13 digits 3
  if Pass = 4 then
    print at 12,13, "PASS"
  else
    print at 12,13, "FAIL"
  end if
  screen on