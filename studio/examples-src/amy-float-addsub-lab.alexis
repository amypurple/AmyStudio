' FP5 add/sub lab: smoke + edge cases for native fp5 add/sub.
u16 UOne = 1
u16 UTwo = 2
u16 UTen = 10
u16 U989 = 989
u16 U1000 = 1000
u16 U1005 = 1005
u16 U1010 = 1010
i16 SNegOne = -1
i16 SNegTen = -10
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0
fp5 E = 0
fp5 F = 0
fp5 G = 0
fp5 H = 0
fp5 I = 0
fp5 J = 0

  text screen
  print at 8,0, "FP5 ADD/SUB LAB"

  A = UOne
  A += UTwo
  B = UTen
  B -= UOne
  C = UTen
  C += SNegOne
  D = UOne
  D -= UTwo
  E = SNegTen
  E += UOne
  F = UTen
  F -= SNegOne
  G = U1000
  G += UOne
  H = U1000
  H -= U989
  I = U1010
  I -= U1005
  J = UOne
  J -= U1000

  print at 1,4,  "1 + 2"
  print A at 12,4 digits 16
  print at 1,6,  "10 - 1"
  print B at 12,6 digits 16
  print at 1,8,  "10 + -1"
  print C at 12,8 digits 16
  print at 1,10, "1 - 2"
  print D at 12,10 digits 16
  print at 1,12, "-10 + 1"
  print E at 12,12 digits 16
  print at 1,14, "10 - -1"
  print F at 12,14 digits 16
  print at 1,16, "1000 + 1"
  print G at 12,16 digits 16
  print at 1,18, "1000 - 989"
  print H at 12,18 digits 16
  print at 1,20, "1010 - 1005"
  print I at 12,20 digits 16
  print at 1,22, "1 - 1000"
  print J at 12,22 digits 16

  screen on