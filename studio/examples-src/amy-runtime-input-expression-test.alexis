project "Amy Runtime Input Expression Test"

i8 SpinSelected = 0
i8 SpinExpression = 0
u8 Port = 1
u8 FrameLow = 0
u16 FrameWord = 0
u8 VdpByte = 0

text screen
print at 3,0, "RUNTIME INPUT EXPRESSIONS"
screen on
enable spinner

test checkpoint "input_expression_before"
wait 1 frame
Port = 1
SpinSelected = spinner(Port)
SpinExpression = spinner(3 - Port)
FrameLow = frame
FrameWord = frame
VdpByte = vdp.status
test checkpoint "input_expression_after"

print at 1,3, "SPIN 1"
print SpinSelected at 12,3 digits 4
print at 1,5, "SPIN 2"
print SpinExpression at 12,5 digits 4
print at 1,7, "FRAME8"
print FrameLow at 12,7 digits 3
print at 1,9, "FRAME16"
print FrameWord at 12,9 digits 5
print at 1,11, "VDP"
print VdpByte at 12,11 digits 3

loop forever
