data DoorX words 208,464,784,1040,1360,1648

' letters of the title: tile base codes, 0 = a space
data LogoT bytes TLP00,TLA00,TLP00,TLE00,TLR00,0,TLR00,TLO00,TLU00,TLT00,TLE00
' the paper's spin frames
data SpinT bytes SPaper0,SPaper1,SPaper2,SPaper3
' the house slot: where each of its six rows starts in an image (SlotPat,
' SlotCol) and in VRAM (patterns of codes 128 + row x 13; rows 6-7 in the
' top third, 8-11 in the middle one); where each image and shift starts.
' The slot is double-buffered: buffer 0 is codes 128 + row x 13 + column,
' buffer 1 the same codes less 128 (patterns 1024 bytes lower; those codes
' are control characters, never printed). A step copies the new shift into
' the buffer not on screen, then writes the names for it (Names subtracts
' SlSub from slot codes), so the screen never shows the new names over the
' old patterns: before, at every cell crossing (shift 3 -> 0) the names moved
' a cell left a frame before the patterns caught up and the house jumped 8
' pixels left for one frame.
data SlRowOff words 0,104,208,312,416,520
data SlRowDst words 1024,1128,3072,3176,3280,3384
data ImgOff words 0,2496,4992
data PhOff words 0,624,1248,1872
data ColOff words 0,624,1248

record Paper:
  u8 Live
  u16 Pw
end record

' a timer for the title tune (kit/tuneonce.py style)
u16 TzLeft = 0
u8 TzOn = 0
' the scroll: Wx the street's pixel (even), Acc its sub-pixels, Wc and Ph
' the column and shift drawn (Names reads them), NmEnd where Names stops
u16 Wx = 0
u16 Acc = 0
u16 Spd = 320
u16 Wc = 0
u8 Ph = 0
u8 Moved = 0
u16 NmEnd = $1AE0
u8 NmAll = 1
' VOut: VCnt bytes from VSrc to VRAM VDst
u16 VSrc = 0
u16 VDst = 0
u8 VCnt = 0
u16 SlotBase = 0
u16 ColBase = 0
u8 SlK[26]
u8 Buf = 0
u8 SlSub = 0
' the game
bcd digits 4 Blocks
u8 Bn = 1
u8 Comp = 0
u8 Left = 6
u8 Deliv = 0
u8 Over = 0
u8 Rx = 96
u8 Pedal = 0
u8 PedalC = 0
u8 Fly = 0
u8 Fx = 0
u8 Fy = 0
u8 Pose = 0
Paper Pp[6]
u8 Slot = 0
u8 MsgT = 0
u8 LastHit = 0
' input
u8 J = 0
u8 OldJ = 0
u8 Press = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Late = 0
u8 Pass = 0
u8 Sel = 0
u16 Throws = 0
u16 Hits = 0
' loop counters (never shared with the helpers)
u8 Lt = 0
u8 Ri = 0
u8 Ki = 0
u8 Kb = 0
u8 Kk = 0
u8 Pi = 0
u8 Di = 0
u8 Ti = 0
' scratch
u16 W16 = 0
u16 A16 = 0
u16 Ss = 0
u16 Se = 0
u16 Ce = 0
u16 D16 = 0
u8 K0 = 0
u16 Kf8 = 0
u8 K1 = 0
u8 Kd = 0
u8 Need = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  call asm SetR3
  set sound table PrSoundTable areas 6
  sprites 16x16
  sprites stable 1 to 3
  sprites flicker on
  set sprite count 10
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  SlotBase = address of SlotPat
  ColBase = address of SlotCol
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    CreditsPage
    goto title
  end if
  NewGame
  StreetScreen(1)
  ShowStatus
  play sound SndBell

play_loop:
  Frame2
  DrawStep
  GetInput
  PlayStep
  if Over = 0 then goto play_loop

  ' the end: the message, then back to the title on a press
  Frame1
  DrawStep
  set sprite 0 to 207,0,0,0
  update sprites
  SkyRow
  print at 5,3, "TOO MANY COMPLAINTS!"
  print at 6,4, "THE ROUTE IS OVER."
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one pass of play

sub PlayStep:
  ' the rider along the sidewalk
  if (J & 4) <> 0 then
    if Rx > MinRx then Rx = Rx - 2
  end if
  if (J & 8) <> 0 then
    if Rx < MaxRx then Rx = Rx + 2
  end if
  ' a throw: one paper in the air at a time
  if Press = 1 then
    if Fly = 0 and Left > 0 then
      Fly = 1
      Fx = Rx + 4
      dec Left
      inc Throws
      Pose = 5
      ShowPapers
      play sound SndThrow
    end if
  end if
  if Pose > 0 then dec Pose
  ' the street moves on
  Advance(Spd)
  if Wx >= WPix then BlockEnd
  ' the paper in the air
  if Fly > 0 then
    Fy = ThrowY[Fly - 1]
    if Fly >= ThrowT then
      Land
    else
      inc Fly
    end if
  end if
  ' the papers lying on the lawns go by
  for Pi = 0 to NPaper - 1
    if Pp[Pi].Live = 1 then
      if ScreenX(Pi) > 248 then Pp[Pi].Live = 0
    end if
  next
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then SkyRow
  end if
  return
end sub

' the street's pace: Sp / 256 pixels a pass (a pass is two frames), in steps of two pixels
sub Advance(u16 Sp):
  Acc = Acc + Sp
  if Acc < 512 then return
  Acc = Acc - 512
  Wx = Wx + 2
  Moved = 1
  inc PedalC
  if PedalC >= 2 then
    PedalC = 0
    Pedal = Pedal ^ 1
  end if
  return
end sub

' the paper lands: on a door's step it is delivered, anywhere else it is
' a complaint
sub Land:
  Fly = 0
  W16 = Wx + Fx
  if W16 >= WPix then W16 = W16 - WPix
  Pp[Slot].Live = 1
  Pp[Slot].Pw = W16
  Slot = (Slot + 1) % NPaper
  LastHit = OnStep(W16)
  if LastHit = 1 then
    inc Deliv
    inc Hits
    play sound SndHit
  else
    if Comp < 99 then inc Comp
    play sound SndThud
    play sound SndMiss
    ShowStatus
  end if
  return
end sub

' 1 when a paper at street pixel P lies on a door's step (its middle within
' the step's 16 pixels, a pixel of grace either side)
function OnStep(u16 P) as u8
  u16 Mid = 0
  u16 Dx = 0
  Mid = P + 3
  for Di = 0 to NLots - 1
    Dx = DoorX[Di]
    if Mid + 1 >= Dx then
      if Mid <= Dx + 16 then return 1
    end if
  next
  return 0

' a paper's place on the screen (above 248: gone by)
function ScreenX(u8 I) as u16
  D16 = Pp[I].Pw + WPix
  D16 = D16 - Wx
  if D16 >= WPix then D16 = D16 - WPix
  return D16

' the end of a block: papers not thrown are complaints; the next block is
' a little faster
sub BlockEnd:
  Wx = Wx - WPix
  N = Comp + Left
  if N > 99 then N = 99
  Comp = N
  Blocks += 1
  if Bn < 255 then inc Bn
  Spd = Bn - 1
  Spd = Spd * SpdUp
  Spd = Spd + StartSpd
  if Spd > TopSpd then Spd = TopSpd
  SkyRow
  print at 2,3, "BLOCK DONE: " + digits$(Deliv, 1) + " OF 6 DELIVERED"
  MsgT = 75
  Deliv = 0
  Left = NPaper
  ShowStatus
  play sound SndBlock
  if Comp >= MaxComp then Over = 1
  return
end sub

sub NewGame:
  Blocks = 0
  Bn = 1
  Comp = 0
  Left = NPaper
  Deliv = 0
  Over = 0
  Spd = StartSpd
  Wx = 0
  Acc = 0
  Rx = 96
  Fly = 0
  Pose = 0
  Slot = 0
  MsgT = 0
  Throws = 0
  Hits = 0
  for Pi = 0 to NPaper - 1
    Pp[Pi].Live = 0
    Pp[Pi].Pw = 0
  next
  OldJ = 31
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' after the wait: the street's names and the house slot when the street
' moved, then the sprites
sub DrawStep:
  if Moved = 1 then
    Moved = 0
    DrawStreet
  end if
  PlaceSprites
  update sprites
  return
end sub

sub DrawStreet:
  Wc = Wx >> 3
  Ph = (Wx >> 1) & 3
  Buf = Buf ^ 1
  SlotDraw
  SlSub = Buf << 7
  call asm Names
  return
end sub

' the house slot: for every house in view (two at most, never on the same
' slot columns), its visible columns at the current shift
sub SlotDraw:
  Ce = Wc + 31
  for Lt = 0 to NLots
    Ss = Lt * LotCells + SlotCell
    Se = Ss + 12
    if Ce >= Ss and Wc <= Se then
      K0 = 0
      if Wc > Ss then K0 = Wc - Ss
      K1 = 12
      if Ce < Se then K1 = Ce - Ss
      ' lot 6 is the next block's first lot
      if Lt = NLots then Kd = LotKind[0] else Kd = LotKind[Lt]
      SlotRange(Kd, K0, K1 - K0 + 1)
    end if
  next
  return
end sub

' slot columns Kf .. Kf + Nk - 1 from house image Im: patterns always,
' colours when another house had those columns
sub SlotRange(u8 Im, u8 Kf, u8 Nk):
  Need = 0
  K = Kf + Nk - 1
  Kb = Buf * SlotW
  for Ki = Kf to K
    Kk = Ki + Kb
    if SlK[Kk] <> Im then Need = 1
    SlK[Kk] = Im
  next
  VCnt = Nk * 8
  Kf8 = Kf * 8
  A16 = ImgOff[Im] + PhOff[Ph]
  A16 = A16 + SlotBase
  for Ri = 0 to 5
    W16 = SlRowOff[Ri] + Kf8
    VDst = SlRowDst[Ri] + Kf8
    if Buf = 1 then VDst = VDst - 1024
    VSrc = A16 + W16
    call asm VOut
    if Need = 1 then
      VSrc = ColOff[Im] + ColBase
      VSrc = VSrc + W16
      VDst = VDst + $2000
      call asm VOut
    end if
  next
  return
end sub

' the papers are black: they show on every wall, the sky, the lawn and
' the step
sub PlaceSprites:
  select case Pose
  case 0
    set sprite 1 to RideY,Rx,SSkin,9
    set sprite 2 to RideY,Rx,SShirt,6
  case else
    set sprite 1 to RideY,Rx,SSkint,9
    set sprite 2 to RideY,Rx,SShirtt,6
  end select
  if Pedal = 0 then
    set sprite 3 to BikeY,Rx,SBike1,4
  else
    set sprite 3 to BikeY,Rx,SBike2,4
  end if
  if Fly > 0 then
    T = (Fly >> 1) & 3
    set sprite 0 to Fy - 1,Fx,SpinT[T],1
  else
    set sprite 0 to 207,0,0,0
  end if
  for Pi = 0 to NPaper - 1
    K = Pi + 4
    if Pp[Pi].Live = 1 then
      W16 = ScreenX(Pi)
      X = W16
      set sprite K to LandY - 1,X,SFlat,1
    else
      set sprite K to 207,0,0,0
    end if
  next
  return
end sub

' rows 1 and 2: blocks, complaints, papers left
sub ShowStatus:
  print at 2,1, "BLOCK "
  print Blocks at 8,1
  print at 15,1, "COMPLAINTS " + digits$(Comp, 2)
  ShowPapers
  return
end sub

sub ShowPapers:
  print at 2,2, "PAPERS"
  for Ki = 0 to NPaper - 1
    if Ki < Left then
      put char TIcon at 9 + Ki,2
    else
      put char 32 at 9 + Ki,2
    end if
  next
  return
end sub

' row 3: the dark sky with two stars
sub SkyRow:
  fill 32 count 32 at 0,3
  put char TStar at 5,3
  put char TStar2 at 13,3
  put char TStar at 24,3
  return
end sub

' a new screen with the street (Game 1: down to the far verge; 0: the
' title, down to the curb, the rows below free for text)
sub StreetScreen(u8 Game):
  NewScreen
  put char TStar2 at 9,1
  put char TStar at 27,2
  SkyRow
  fill TDawn1 count 32 at 0,4
  fill TDawn2 count 32 at 0,5
  if Game = 1 then
    NmEnd = NmGame
  else
    NmEnd = NmTitle
  end if
  fill array SlK with 255
  NmAll = 1
  DrawStreet
  NmAll = 0
  Moved = 0
  PlaceSprites
  update sprites
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub GetInput:
  ReadPads
  J = Pads
  Press = 0
  if (J & 16) <> 0 then
    if (OldJ & 16) = 0 then Press = 1
  end if
  OldJ = J
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' a steady 30 passes a second: two frames, or one when the pass has
' already run into the next frame (Late: the VDP's frame flag; the NMI is
' off during a pass, so nothing else reads it). A street step costs about
' a frame of VRAM writes.
sub Frame2:
  call asm GetLate
  if Late = 0 then Frame1
  Frame1
  inc Pass
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 10
  for K = 0 to 9
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

' every screen: the font (white; on the dawn's dark blue in the top
' third), the static tiles and the street's three tile sets
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  fill $F4 count 1024 to vram.color
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy T0Pat count NT0 to vram.pattern + P0Code * 8
  copy T0Col count NT0 to vram.color + P0Code * 8
  copy T1Pat count NT1 to vram.pattern + 2048 + P1Code * 8
  copy T1Col count NT1 to vram.color + 2048 + P1Code * 8
  copy T2Pat count NT2 to vram.pattern + 4096 + P2Code * 8
  copy T2Col count NT2 to vram.color + 4096 + P2Code * 8
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: PAPER ROUTE over the street going by, the rider pedalling,
' START / CREDITS, the tune once

sub TitlePage:
  Wx = 0
  Acc = 0
  Rx = 104
  Fly = 0
  Pose = 0
  for Pi = 0 to NPaper - 1
    Pp[Pi].Live = 0
  next
  StreetScreen(0)
  for Ti = 0 to 10
    T = LogoT[Ti]
    if T > 0 then
      X = Ti * 2 + 5
      put char T at X,1
      put char T + 1 at X + 1,1
      put char T + 2 at X,2
      put char T + 3 at X + 1,2
    end if
  next
  print at 4,21, "AFTER BOB BLACKMER, 1987"
  Sel = 0
  ShowMenu
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 700
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame2
  DrawStep
  ReadPads
  Advance(384)
  if Wx >= WPix then Wx = Wx - WPix
  N = Pads & (Pads ^ OldPads)
  if (N & 3) <> 0 then
    Sel = Sel ^ 1
    play sound SndPick
    ShowMenu
  end if
  if (N & 16) = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,18
  put char 32 at 11,19
  put char 62 at 11,18 + Sel
  print at 13,18, "START"
  print at 13,19, "CREDITS"
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "PAPER  ROUTE"
  print at 2,5, "BASED ON PAPER ROUTE BY"
  print at 2,6, "BOB BLACKMER, AHOY!"
  print at 2,7, "NOVEMBER 1987 (COMMODORE"
  print at 2,8, "64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: EARLY EDITION"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
GetLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret

SetR3:
    ld bc,$03FF
    call WRITE_REGISTER
    ret

; VOut: VCnt bytes from VSrc to VRAM VDst, 32 cycles a byte (safe with the
; display on); NMI off
VOut:
    ld a,(AMY_UVAR_VCnt)
    or a
    ret z
    ld b,a
    ld hl,(AMY_UVAR_VDst)
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,(AMY_UVAR_VSrc)
    ld c,$BE
VOut1:
    outi
    nop
    jr nz,VOut1
    ret

; Names: the street's names from row 6 down to NmEnd, for column Wc and
; shift Ph: WorldMap[row][Wc + x] (+ Ph unless it is a slot code, below
; RowT[row]). Rows marked in RowS never change and are skipped unless
; NmAll is set. About 55 cycles a name; NMI off.
Names:
    ld hl,AMY_UDATA_WorldMap
    ld de,(AMY_UVAR_Wc)
    add hl,de
    ld de,AMY_UDATA_RowT
    ld bc,$18C0
NmRow:
    push bc
    push hl
    push de
    ld a,(AMY_UVAR_NmAll)
    or a
    jr nz,NmDo
    push hl
    ld hl,AMY_UDATA_RowS - AMY_UDATA_RowT
    add hl,de
    ld a,(hl)
    pop hl
    or a
    jr nz,NmNext
NmDo:
    ld a,c
    out ($BF),a
    ld a,b
    or $40
    out ($BF),a
    ld a,(de)
    ld c,a
    ld a,(AMY_UVAR_Ph)
    ld e,a
    ld a,(AMY_UVAR_SlSub)
    ld d,a
    ld b,32
    inc c
    dec c
    jr nz,NmCol
NmFast:
    ld a,(hl)
    add a,e
    out ($BE),a
    inc hl
    djnz NmFast
    jr NmNext
NmCol:
    ld a,(hl)
    cp c
    jr c,NmNo
    add a,e
NmOut:
    out ($BE),a
    inc hl
    djnz NmCol
    jr NmNext
NmNo:
    sub d
    jr NmOut
NmNext:
    pop de
    pop hl
    pop bc
    inc de
    push de
    ld de,MapRow
    add hl,de
    pop de
    push hl
    ld hl,32
    add hl,bc
    ld b,h
    ld c,l
    ld hl,(AMY_UVAR_NmEnd)
    or a
    sbc hl,bc
    pop hl
    jr nz,NmRow
    ret

PrThrow:
    db $00,$00,$55,$02,$00,$00,$64,$02,$00,$00,$85,$03,$00,$00,$B6,$03,$10
PrHit:
    db $40,$3B,$22,$02,$40,$F9,$42,$02,$40,$47,$30,$04,$40,$55,$40,$0A,$50
PrThud:
    db $00,$00,$36,$02,$00,$00,$67,$04,$10
PrMiss:
    db $40,$E0,$31,$06,$40,$FC,$31,$06,$40,$1A,$42,$0A,$50
PrBlock:
    db $40,$8F,$20,$05,$40,$71,$20,$05,$40,$5F,$20,$05,$40,$47,$20,$0C,$50
PrBell:
    db $40,$35,$30,$03,$40,$40,$40,$03,$40,$35,$30,$03,$40,$40,$50,$08,$50
PrOver:
    db $40,$D6,$20,$0C,$40,$E2,$20,$0C,$40,$FE,$20,$0C,$40,$41,$31,$1E,$50
PrPick:
    db $40,$55,$40,$02,$50

PrSoundTable:
    dw PrTuneMel,$702B
    dw PrTuneBass,$7035
    dw PrThrow,$703F
    dw PrHit,$7049
    dw PrThud,$703F
    dw PrMiss,$7049
    dw PrBlock,$7049
    dw PrBell,$7049
    dw PrOver,$7049
    dw PrPick,$7049
; Early Edition (original)
; Tiny Sound, 7 frames per step
PrTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$1A,$21,$1A,$01,$1E,$01,$21,$01,$01,$01,$1E,$01,$21,$01
    db $26,$01,$01,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01,$01,$01
    db $00,$01,$19,$01,$1C,$01,$1F,$01,$01,$01,$1C,$01,$1F,$01,$25,$01
    db $01,$01,$23,$01,$21,$01,$1F,$01,$1C,$01,$1E,$01,$01,$01,$00,$01
    db $1A,$01,$1E,$01,$21,$01,$01,$01,$26,$01,$25,$01,$23,$01,$21,$01
    db $1F,$01,$23,$01,$1C,$01,$1F,$01,$1E,$01,$1C,$01,$1A,$01,$01,$01
    db $00,$01,$01,$01,$01,$01,$01,$01
    db $FF
PrTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0E,$01,$09,$01,$0E,$01,$09,$01,$0E,$01,$09,$01
    db $0E,$01,$09,$01,$07,$01,$0E,$01,$07,$01,$0E,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$10,$01,$09,$01,$10,$01
    db $09,$01,$10,$01,$07,$01,$0E,$01,$09,$01,$10,$01,$0E,$01,$09,$01
    db $0E,$01,$09,$01,$0E,$01,$09,$01,$0E,$01,$09,$01,$0B,$01,$12,$01
    db $0B,$01,$12,$01,$10,$01,$0B,$01,$09,$01,$10,$01,$0E,$01,$09,$01
    db $0E,$01,$01,$01,$00,$01,$01,$01
    db $FF
}
