' FP5 sqrt precision regression: repeated roots then repeated self-squares.
fp5 A = 65535
fp5 B
fp5 C
fp5 D
fp5 E
fp5 F
fp5 G
u8 BValue[16]

  B = sqrt(A)
  C = sqrt(B)
  D = sqrt(C)
  E = sqrt(D)
  F = sqrt(E)
  G = sqrt(F)
  G *= G
  G *= G
  G *= G
  G *= G
  G *= G
  G *= G
  F *= F
  F *= F
  F *= F
  F *= F
  F *= F
  E *= E
  E *= E
  E *= E
  E *= E
  D *= D
  D *= D
  D *= D
  C *= C
  C *= C
  B *= B

  text screen
  screen on no nmi
  print_at(A,5)
  print_at(B,7)
  print_at(C,9)
  print_at(D,11)
  print_at(E,13)
  print_at(F,15)
  print_at(G,17)

sub print_at(fp5 value, u8 Y)
  BValue = str$(value)
  put BValue count 16 at 5,Y
end sub