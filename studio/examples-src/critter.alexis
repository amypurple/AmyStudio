cartridge "SPELLING CRITTER/COMPUTE!'S GAZETTE/1984"

' SPELLING CRITTER
' A ColecoVision game based on "Spelling Critter", COMPUTE!'s Gazette,
' June 1984 (Commodore 64 and VIC-20, BASIC; disk 1984-06). No author is
' named in the listings (the article was not reachable).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: Critter, a little creature that writes as it crawls, shows you
' a word for a moment, then asks HOW DO YOU SPELL THAT WORD? Turn the
' letter wheel with the stick and press the button to pick each letter,
' then pick the check mark. Right: THAT IS RIGHT, VERY GOOD! Wrong: I'M
' SORRY, THAT IS WRONG and the correct answer. Push up to see the word
' again (it wipes what you picked), down to erase the last letter. After
' the last word: THE GAME IS OVER, RIGHT and WRONG, and BYE! BYE! BYE!
'
' From the original (orig/spell critter_64.bas, lines in brackets): the
' title spelled out letter by letter (50-100); how many words (720-725);
' each word shown about 1.1 s then cleared (290-300); HOW DO YOU SPELL THAT
' WORD (320, 1060); ? to see the word again, wiping the answer (350,
' 870); THAT WORD typed back = VERY FUNNY, WISEGUY and the word again
' (340, 1100); right = THAT IS RIGHT, VERY GOOD, a rising warble, HIT ANY
' KEY (360-370, 400-430, 560); wrong = I'M SORRY, THAT IS WRONG, THE
' CORRECT ANSWER IS: and the word, then straight on (380-395); one try a
' word; THE GAME IS OVER with RIGHT and WRONG (610-630); IT HAS BEEN VERY
' NICE SPELLING WITH YOU, BYE! BYE! BYE! (670-690); the worm that crawls
' along each line writing it, ticking for each letter (440-550, 110).
'
' Liberties:
' - The original has no word list: a grown-up typed in 1-50 words (up to
'   10 letters) before each game. With no keyboard, 48 everyday words are
'   built in, in three bands of 16 (short, medium, long); a game of 8 or 16
'   words (title menu) draws them at random, never twice, easier first.
' - Typed answers become a letter wheel: the stick turns it one letter at
'   a time (A-Z, then a check mark = done), the button picks the letter in
'   the lens. Sweeping the wheel spells nonsense: one try a word, no hint
'   which letter is wrong, so neither sweeping nor guessing scores.
'   Down erases the last letter (the keyboard's DEL); up = the ? key.
' - The wiseguy joke answers T-H-A-T-W-O-R-D (no space on the wheel).
' - No name entry: Critter's lines are said without your name.
' - No PLAY AGAIN (Y/N) question: a press goes back to the title (house
'   rule). The word is shown 75 frames (1.25 s; the listing's FOR T=1 TO
'   1000 is about 1.1 s on a C64).
' - Critter is a new design (a purple fuzzball with antennae and two
'   following segments) made of sprites that crawl smoothly; leafy panels,
'   a letter wheel, a title tune and a credits page are additions.
' - Differences from SPELLING BEE (games/sbee): a turning one-row wheel
'   with a fixed lens instead of a 7 x 4 grid with a moving frame; plain
'   letters in leafy panels on a night-blue field instead of big letters
'   on a card in a honeycomb; one try a word instead of three; a right /
'   wrong count instead of 75 points.
'
' Controls: either controller; stick and either button. Keypad not used.
'
' House rules: text and sprites in columns 2-29, rows 1-22 (the grass on
' row 23 is decoration); tiles from 128; screens drawn with the NMI off,
' display off; music first in the sound table, the title tune plays once;
' `set sprite count` always given; nothing flashes.

const TBtl = 128
const TBtr = 129
const TBbl = 130
const TBbr = 131
const TBh1 = 132
const TBh2 = 133
const TBv1 = 134
const TBv2 = 135
const TSlot = 136
const TMark = 137
const TLa = 138
const TRa = 139
const TGrass = 140
const TDot = 141
const SHead1 = 0
const SHead2 = 4
const SEyes = 8
const SSeg = 12
const SLens = 16
const NTiles8 = 112
const SprBytes = 160
const SndTuneA = 1
const SndTuneB = 2
const SndTick = 3
const SndRight = 4
const SndWrong = 5
const SndTurn = 6
const SndPick = 7
const SndErase = 8
const SndShow = 9
const SndOver = 10
const ShowN = 75
const MaxAns = 12
const NSpr = 5
const WordY = 5
const MsgY = 9
const AnsY = 13
const AnsX = 10
const WheelY = 18
const LensCol = 14
const NEntry = 27
const DoneE = 26
const BandN = 16
const LensX = 108
const LensY = 140
const RestY = 123
const RestX = 118

record Game:
  u8 Wi
  u8 Nw
  u8 Rt
  u8 Wg
end record

Game Pg
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 12345
u16 W16 = 0
u16 NumU = 0
' the word (ASCII, 0-padded), the picked letters, the words used
u8 Wd[10]
u8 Wl = 0
u8 WordNo = 0
u8 Ans[12]
u8 Tn = 0
u8 Used[48]
u8 Sel = 0
u8 Res = 0
u8 Ph = 0
u8 Menu = 0
u8 Over = 0
u8 TitleOn = 0
u8 WordVis = 0
u8 Reviews = 0
' Critter: head position, on/off, feet frame, hop
u8 CrOn = 0
u8 CrX = 60
u8 CrY = 60
u8 CrFeet = 0
u8 LensOn = 0
i16 HopY = 0
i16 HopV = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Li = 0
u8 Hi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table ScSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    HowToPlay
    goto title
  end if
  Pg.Nw = 8
  if Menu = 1 then Pg.Nw = 16
  Pg.Wi = 0
  Pg.Rt = 0
  Pg.Wg = 0
  Over = 0
  fill array Used with 0
  NewPlayScreen

' 280-590: each word, one try
play_word:
  ChooseWord
  LoadWord
  Reviews = 0
show_word:
  ShowHud
  ShowTheWord
  SpellIt
  if Res = 2 then
    ' 350: ? shows the word again (the answer is wiped)
    inc Reviews
    goto show_word
  end if
  if Wiseguy() = 1 then
    ' 340: THAT WORD
    Say(6, MsgY)
    Hold(60)
    goto show_word
  end if
  if Match() = 1 then
    ' 360-370, 560: right, HIT ANY KEY
    Pg.Rt += 1
    ShowHud
    play sound SndRight
    Say(3, MsgY)
    Say(9, MsgY)
    Ph = 3
    CrOn = 0
    DrawSprites
    Rearm
    wait no fire
    pause until press and release sleep after 30 seconds
    nmi off
    goto next_word
  end if
  ' 380-395: wrong, the correct answer, straight on
  Pg.Wg += 1
  ShowHud
  play sound SndWrong
  Say(4, MsgY)
  Hold(40)
  Say(5, MsgY)
  PrintWord
  play sound SndShow
  WordVis = 2
  Hold(150)
  WordVis = 0

next_word:
  inc Pg.Wi
  if Pg.Wi < Pg.Nw then goto play_word

  ' 600-690: the end
  Ph = 9
  EndScreen
  play sound SndOver
  Over = 1
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the words

' a 16-bit xorshift
function Rnd() as u8
  u8 Lo = 0
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  Lo = lowbyte(Rs)
  return Lo

' an unused word from the band for this point of the game (easier first)
sub ChooseWord:
  u8 Band = 0
  u8 R = 0
  u8 N = 0
  u16 T = 0
  T = Pg.Wi * 3
  Band = lowbyte(T) / Pg.Nw
  R = Rnd() & 15
  N = Band * BandN
  N = N + R
  while Used[N] <> 0
    R = R + 1
    R = R & 15
    N = Band * BandN
    N = N + R
  end while
  Used[N] = 1
  WordNo = N
  return
end sub

sub LoadWord:
  u16 Base = 0
  Base = WordNo * 10
  Wl = 0
  for Li = 0 to 9
    C = WordTab[Base + Li]
    Wd[Li] = C
    if C > 0 then inc Wl
  next
  return
end sub

' 290-300: the word in the top panel for a moment, then cleared
sub ShowTheWord:
  Ph = 0
  LensOn = 0
  ClearAnswer
  ClearWord
  Say(1, MsgY)
  PrintWord
  play sound SndShow
  WordVis = 1
  Hold(ShowN)
  ClearWord
  WordVis = 0
  return
end sub

sub PrintWord:
  X = 16 - Wl
  for Li = 0 to 9
    C = Wd[Li]
    if C > 0 then
      put char C at X,WordY
      X = X + 2
    end if
  next
  return
end sub

' 850-950: pick letters on the wheel until the check mark (Res 1) or up (Res 2)
sub SpellIt:
  Say(2, MsgY)
  Tn = 0
  Res = 0
  Sel = 0
  Rep = 0
  DrawWheel
  CrX = RestX
  CrY = RestY
  CrOn = 1
  LensOn = 1
  Ph = 1
  ClearAnswer
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 15
sp_loop:
  Frame1
  ReadPad
  WheelInput
  if Press = 1 then PickEntry
  Hop
  DrawSprites
  if Res = 0 then goto sp_loop
  Ph = 2
  LensOn = 0
  HopY = 0
  DrawSprites
  return
end sub

sub PickEntry:
  if Sel < DoneE then
    if Tn >= MaxAns then
      play sound SndErase
    else
      C = Sel + 65
      Ans[Tn] = C
      X = AnsX + Tn
      put char C at X,AnsY
      inc Tn
      play sound SndPick
      HopV = -3
    end if
  else
    ' the check mark: an empty answer is ignored (890)
    if Tn = 0 then
      play sound SndErase
    else
      Res = 1
    end if
  end if
  return
end sub

' the stick: left/right turn the wheel (held: repeats), down erases, up = ?
sub WheelInput:
  V = Stick & 15
  K = WasStick
  WasStick = V
  if V = 0 then
    Rep = 0
    return
  end if
  select case V
  case 1
    if K = 0 then Res = 2
  case 2
    if K = 0 then
      if Tn > 0 then
        dec Tn
        Ans[Tn] = 0
        X = AnsX + Tn
        put char TSlot at X,AnsY
        play sound SndErase
      end if
    end if
  case 4, 8
    if K <> V then Rep = 0
    if Rep > 0 then
      dec Rep
    else
      if V = 8 then
        inc Sel
        if Sel >= NEntry then Sel = 0
      else
        if Sel = 0 then Sel = NEntry
        dec Sel
      end if
      DrawWheel
      play sound SndTurn
      CrFeet = CrFeet ^ 1
      if K = V then
        Rep = 7
      else
        Rep = 15
      end if
    end if
  end select
  return
end sub

' a little hop when a letter is picked (i16 velocity, gravity 1)
sub Hop:
  if HopV = 0 then
    if HopY = 0 then return
  end if
  HopY = HopY + HopV
  HopV = HopV + 1
  if HopY >= 0 then
    HopY = 0
    HopV = 0
  end if
  return
end sub

function Match() as u8
  u8 Ok = 1
  u8 A = 0
  u8 B = 0
  for Li = 0 to MaxAns - 1
    A = Ans[Li]
    B = 0
    if Li < 10 then B = Wd[Li]
    if A <> B then Ok = 0
  next
  return Ok

' THATWORD typed back
function Wiseguy() as u8
  u8 Ok = 1
  if Tn <> 8 then Ok = 0
  for Li = 0 to 7
    if Ans[Li] <> Joke[Li] then Ok = 0
  next
  return Ok

data Joke bytes 84,72,65,84,87,79,82,68

' ---------------------------------------------------------------------------
' Critter writes a line: two rows of message Mn, crawling along each row

sub Say(u8 Mn, u8 Row):
  u16 Base = 0
  u8 Ln = 0
  u8 F = 0
  u8 La = 0
  u8 Nc = 0
  u8 Ex = 0
  u8 Ry = 0
  fill 32 count 26 at 3,Row
  Ry = Row + 1
  fill 32 count 26 at 3,Ry
  for Ln = 0 to 1
    Base = Mn * 52
    Base = Base + Ln * 26
    F = 255
    La = 0
    for Ri = 0 to 25
      C = MsgTab[Base + Ri]
      if C <> 32 then
        if F = 255 then F = Ri
        La = Ri
      end if
    next
    if F <> 255 then
      Ry = Row + Ln
      W16 = Ry * 8
      CrY = lowbyte(W16) - 6
      X = F + 3
      W16 = X * 8
      CrX = lowbyte(W16)
      if CrX < 38 then CrX = 38
      X = La + 4
      W16 = X * 8
      Ex = lowbyte(W16) + 8
      if Ex > 224 then Ex = 224
      Nc = F
      CrOn = 1
      Crawl(Base, Nc, La, Ry, Ex)
    end if
  next
  CrOn = 0
  DrawSprites
  return
end sub

' the crawl itself: 2 pixels a frame, a letter as the head passes it
sub Crawl(u16 Mb, u8 Nc, u8 La, u8 Ry, u8 Ex):
  u8 Cx = 0
  u16 P = 0
cr_loop:
  Frame1
  CrX = CrX + 2
  V = Tick & 7
  if V = 0 then CrFeet = CrFeet ^ 1
  if Nc <= La then
    Cx = Nc + 3
    W16 = Cx * 8
    if lowbyte(W16) <= CrX + 4 then
      P = Mb + Nc
      C = MsgTab[P]
      put char C at Cx,Ry
      if C <> 32 then play sound SndTick
      inc Nc
    end if
  end if
  DrawSprites
  if CrX < Ex then goto cr_loop
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the wheel: seven entries round Sel, the lens on the middle one
sub DrawWheel:
  u8 E = 0
  for Li = 0 to 6
    E = Sel + NEntry
    E = E + Li
    E = E - 3
    E = E % NEntry
    X = Li * 3
    X = X + 5
    if E = DoneE then
      C = TMark
    else
      C = E + 65
    end if
    put char C at X,WheelY
  next
  return
end sub

sub ClearWord:
  fill 32 count 26 at 3,WordY
  return
end sub

sub ClearAnswer:
  fill array Ans with 0
  fill TSlot count MaxAns at AnsX,AnsY
  return
end sub

' WORD n OF n, RIGHT, WRONG (630)
sub ShowHud:
  print at 2,1, "WORD"
  NumU = Pg.Wi + 1
  print at 7,1, width$(NumU, 2)
  print at 10,1, "OF"
  NumU = Pg.Nw
  print at 13,1, width$(NumU, 2)
  print at 20,1, "RIGHT"
  NumU = Pg.Rt
  print at 27,1, width$(NumU, 2)
  print at 20,2, "WRONG"
  NumU = Pg.Wg
  print at 27,2, width$(NumU, 2)
  return
end sub

' a leafy panel: corners, vine edges, black inside
sub Panel(u8 X0, u8 Y0, u8 W, u8 H):
  u8 X1 = 0
  u8 Y1 = 0
  u8 Iw = 0
  u8 Ry = 0
  X1 = X0 + W
  X1 = X1 - 1
  Y1 = Y0 + H
  Y1 = Y1 - 1
  Iw = W - 2
  put char TBtl at X0,Y0
  put char TBtr at X1,Y0
  put char TBbl at X0,Y1
  put char TBbr at X1,Y1
  K = X0 + 1
  for J = 0 to Iw - 1
    C = TBh1
    V = J & 1
    if V = 1 then C = TBh2
    X = K + J
    put char C at X,Y0
    put char C at X,Y1
  next
  Ry = Y0 + 1
  while Ry < Y1
    put char TBv1 at X0,Ry
    put char TBv2 at X1,Ry
    fill 32 count Iw at K,Ry
    inc Ry
  end while
  return
end sub

sub Grass:
  fill TGrass count 32 at 0,23
  return
end sub

sub NewPlayScreen:
  NewScreen
  Grass
  Panel(2, 3, 28, 5)
  Panel(2, 8, 28, 4)
  Panel(8, 12, 16, 3)
  Panel(2, 17, 28, 3)
  ClearAnswer
  put char TLa at 3,WheelY
  put char TRa at 28,WheelY
  DrawWheel
  print at 3,20, "LEFT/RIGHT: TURN THE WHEEL"
  print at 3,21, "BUTTON: PICK  DOWN: ERASE"
  print at 3,22, "UP: LOOK AGAIN    = DONE"
  put char TMark at 20,22
  ShowHud
  ShowScreen
  return
end sub

' sprite 0 the lens, 1 eyes, 2 head, 3-4 Critter's segments
sub DrawSprites:
  i16 Yy = 0
  u8 Sy = 0
  u8 Hp = 0
  u8 Bob = 0
  u8 Sx = 0
  if LensOn = 1 then
    set sprite 0 to LensY,LensX,SLens,11
  else
    set sprite 0 to 192,0,0,0
  end if
  if CrOn = 0 then
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
    set sprite 4 to 192,0,0,0
    update sprites
    return
  end if
  Yy = CrY + HopY
  Sy = lowbyte(Yy)
  Hp = SHead1
  if CrFeet = 1 then Hp = SHead2
  set sprite 1 to Sy,CrX,SEyes,15
  set sprite 2 to Sy,CrX,Hp,13
  Bob = CrFeet
  Sy = CrY + Bob
  Sx = CrX - 11
  set sprite 3 to Sy,Sx,SSeg,13
  Bob = 1 - CrFeet
  Sy = CrY + Bob
  Sx = CrX - 22
  set sprite 4 to Sy,Sx,SSeg,5
  update sprites
  return
end sub

' 610-690: the end
sub EndScreen:
  NewScreen
  Grass
  Panel(2, 2, 28, 20)
  print at 8,4, "THE GAME IS OVER"
  print at 6,7, "RIGHT"
  NumU = Pg.Rt
  print at 12,7, width$(NumU, 2)
  print at 17,7, "WRONG"
  NumU = Pg.Wg
  print at 23,7, width$(NumU, 2)
  print at 5,10, "IT HAS BEEN VERY NICE"
  print at 5,11, "SPELLING WITH YOU."
  print at 5,13, "PLEASE COME BACK TO"
  print at 5,14, "PLAY AGAIN."
  ShowScreen
  Say(7, 16)
  print at 8,20, "PRESS THE BUTTON"
  return
end sub

' ---------------------------------------------------------------------------
' frames, input, screens

sub Hold(u8 Nf):
  for Hi = 1 to Nf
    Frame1
    DrawSprites
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Stick = J1 | J2
  Btn = Stick & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  CrOn = 0
  LensOn = 0
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SPELLING CRITTER spelled out (50-100), Critter says hello,
' the tune once, the menu
sub TitlePage:
  NewScreen
  Grass
  Panel(5, 2, 22, 7)
  for Ri = 0 to 7
    C = TitleA[Ri]
    X = Ri * 2
    X = X + 8
    put char C at X,4
  next
  for Ri = 0 to 6
    C = TitleA[Ri + 8]
    X = Ri * 2
    X = X + 9
    put char C at X,6
  next
  print at 7,10, "COMPUTE!'S GAZETTE"
  print at 10,11, "JUNE 1984"
  print at 10,16, "8 WORDS"
  print at 10,17, "16 WORDS"
  print at 10,18, "HOW TO PLAY"
  print at 3,22, "STICK: CHOOSE  BUTTON: GO"
  ShowMenu
  TitleOn = 1
  Ph = 5
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Say(8, 13)
  ' Critter strolls under the menu while you choose
  CrY = 151
  CrX = 38
  CrOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  WasStick = 15
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = Tick & 1
  if V = 0 then
    if CrX < 224 then
      CrX = CrX + 1
    else
      CrX = 38
    end if
    V = Tick & 15
    if V = 0 then CrFeet = CrFeet ^ 1
  end if
  DrawSprites
  V = Stick & 15
  K = WasStick
  WasStick = V
  if V > 0 then
    if K = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      end if
      if V = 2 then
        if Menu < 2 then inc Menu
      end if
      ShowMenu
      play sound SndTurn
    end if
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  CrOn = 0
  return
end sub

data TitleA bytes 83,80,69,76,76,73,78,71,67,82,73,84,84,69,82

sub ShowMenu:
  for Ri = 16 to 18
    put char 32 at 8,Ri
  next
  J = Menu + 16
  put char 62 at 8,J
  return
end sub

sub HowToPlay:
  NewScreen
  Grass
  print at 8,1, "SPELLING CRITTER"
  print at 2,3, "CRITTER SHOWS YOU A WORD"
  print at 2,4, "FOR A MOMENT. THEN SPELL IT"
  print at 2,5, "ON THE LETTER WHEEL:"
  print at 2,7, "LEFT/RIGHT TURNS THE WHEEL."
  print at 2,8, "THE BUTTON PICKS THE LETTER"
  print at 2,9, "IN THE RING."
  print at 2,10, "DOWN ERASES THE LAST ONE."
  print at 2,11, "PICK   WHEN YOU ARE DONE."
  put char TMark at 7,11
  print at 2,13, "FORGOT THE WORD? PUSH UP TO"
  print at 2,14, "SEE IT AGAIN (YOU START THE"
  print at 2,15, "WORD OVER)."
  print at 2,17, "ONE TRY A WORD. CRITTER"
  print at 2,18, "COUNTS RIGHT AND WRONG."
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,2, "SPELLING CRITTER"
  print at 2,5, "BASED ON THE TYPE-IN GAME"
  print at 2,6, "SPELLING CRITTER, COMPUTE!'S"
  print at 2,7, "GAZETTE, JUNE 1984"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CRITTER CRAWL"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  Ph = 7
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

