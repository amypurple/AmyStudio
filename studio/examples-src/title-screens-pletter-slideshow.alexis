cartridge "TITLE CODEC PLETTER/AMY STUDIO/2026"

' Four ColecoVision homebrew title screens shown with one codec.
' Timing uses frame before/after upload picture ... with nmi.
' Wait one VBlank before timing; second upload is clean with NMI off.

u16 StartFrame = 0
u16 EndFrame = 0
u16 MazeFrames = 0
u16 JeepersFrames = 0
u16 SmurfFrames = 0
u16 StripFrames = 0

on vblank TitleCodecFrame

picture TitleMazeManiacPletter:
  pattern from "@project/maze-maniac.pattern.plet5" codec pletter
  color from "@project/maze-maniac.color.plet5" codec pletter
end picture

picture TitleJeepersCreepersPletter:
  pattern from "@project/jeepers-creepers.pattern.plet5" codec pletter
  color from "@project/jeepers-creepers.color.plet5" codec pletter
  name from "@project/jeepers-creepers.name.plet5" codec pletter
end picture

picture TitleSmurfChallengePletter:
  pattern from "@project/smurf-challenge.pattern.plet5" codec pletter
  color from "@project/smurf-challenge.color.plet5" codec pletter
end picture

picture TitleStripPokerPletter:
  pattern from "@project/strip-poker.pattern.plet5" codec pletter
  color from "@project/strip-poker.color.plet5" codec pletter
end picture

  bitmap screen
  nmi on
  wait

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleMazeManiacPletter with nmi
  EndFrame = frame
  MazeFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleMazeManiacPletter
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleJeepersCreepersPletter with nmi
  EndFrame = frame
  JeepersFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleJeepersCreepersPletter
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleSmurfChallengePletter with nmi
  EndFrame = frame
  SmurfFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleSmurfChallengePletter
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleStripPokerPletter with nmi
  EndFrame = frame
  StripFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleStripPokerPletter
  nmi on
  screen on
  wait 120 frames

  text screen
  print centered at 2, "TITLE CODEC RESULTS"
  print centered at 4, "PLETTER"
  print at 1,6, "IMG"
  print at 10,6, "FR"
  print at 15,6, "PAT"
  print at 23,6, "COL"
  print at 1,8, "MAZE"
  print MazeFrames at 10,8 digits 3
  print at 15,8, "1601"
  print at 23,8, "1285"
  print at 1,10, "JEEPERS"
  print JeepersFrames at 10,10 digits 3
  print at 15,10, "2387"
  print at 23,10, "618"
  print at 1,12, "SMURF"
  print SmurfFrames at 10,12 digits 3
  print at 15,12, "842"
  print at 23,12, "538"
  print at 1,14, "STRIP"
  print StripFrames at 10,14 digits 3
  print at 15,14, "2985"
  print at 23,14, "568"
  print centered at 17, "PAT/COL COMPRESSED BYTES"
  print centered at 20, "TIMED THEN CLEAN UPLOAD"
  print centered at 22, "DONE"
  screen on
done:
  goto done

sub TitleCodecFrame:
  return