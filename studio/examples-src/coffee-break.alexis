cartridge "COFFEE BREAK!/DAN KOMAROMI/1988"

' COFFEE BREAK!
' A ColecoVision game based on "Coffee Break!" by Dan Komaromi (1987),
' modified for the Commodore 128 by Cleveland M. Blakemore, Ahoy!
' February 1988 (C-128 BASIC 7.0, orig/coffee.bas).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's, the game is
' rebuilt for the ColecoVision: a smooth cup sprite that fills as you
' pour, falling drops, an animated belt, tiled dispensers, sound effects
' and an original title tune.
'
' The game: it is 7:00 A.M. and the coffee rush is here. Six dispensers
' hang over a conveyor belt: MILK, SUGAR, CREAM, NON-DAIRY, COFFEE and
' DECAF. A customer's order is on the right ("HURRY WITH MY / STRONG
' COFFEE / WITH SUGAR / AND CREAM"). Run the belt back and forth, stop the
' cup under a dispenser and pour. Send the cup off the right end of the
' belt: if it holds exactly what was ordered, the customer is served;
' otherwise it comes back empty ("DO IT RIGHT!"). Serve the day's two
' customers before the clock runs out; each new day has 3 seconds less.
' When the time runs out, the customers leave the shop: game over.
'
' From the original (orig/coffee.bas): the six dispensers in that order;
' the belt panel RV / STP / FW where a push toward the other way stops a
' moving cup (lines 540-610); pouring only while the belt is stopped,
' one drop at a time, nothing else moving while it falls; the drop must
' land in the cup (BUMP) to count; the belt stops by itself at the left
' end, and the cup is checked when it runs off the right end; the check
' (lines 990-1040): coffee XOR decaf as ordered (DECAF. and NO CAF. are
' decaf), milk or sugar as ordered, cream, non-dairy or neither as
' ordered, nothing else; a wrong cup goes back empty with DO IT RIGHT! in
' place of the closing words, and the clock keeps running; 2 customers a
' day, 60 seconds on day 1 and 3 fewer each day; the orders' words and
' their odds (6 openings, decaf half the time, 8 coffee words, milk or
' sugar, cream / non-dairy / nothing one third each, 5 closings); the
' score: 5 for a drop in the cup, 50 a customer, 100 a day.
'
' Liberties: a drop scores 5 only for an ingredient not yet in the cup
' (in the original, pouring the same drop again and again scored without
' limit). The original's fourth order line was never cleared, so after
' the first customer every order asked for cream or non-dairy (the 1 in 3
' "neither" kept the old line); here "neither" really happens. Decaf
' stayed in the cup after a served customer (V(6) was not cleared); here
' every cup starts empty. The stick acts on a new push (the BASIC loop
' read a held stick again, which could stop and restart the belt); up and
' down repeat when held. The cup steams for a moment when served (the
' clock waits). Days shorter than 9 seconds stay at 9 (the original
' reached 0). A high score. The game over page shows the day and score
' as the original did, then the title.
'
' Controls: either controller. Stick left / right: run the belt (RV and
' FW; a push the other way stops it). Stick up / down: choose the
' dispenser. Button: pour (belt stopped). On the title, up and down
' choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects
' after; the title tune is played once. `set sprite count` is always
' given (bug 25). Own xorshift random numbers (bug 36). Nothing flashes.

const TMitl = 128
const TMitm = 129
const TMitr = 130
const TMibl = 131
const TMibm = 132
const TMibr = 133
const TMifl = 134
const TMifm = 135
const TMifr = 136
const TMiz = 137
const TSutl = 138
const TSutm = 139
const TSutr = 140
const TSubl = 141
const TSubm = 142
const TSubr = 143
const TSufl = 144
const TSufm = 145
const TSufr = 146
const TSuz = 147
const TCrtl = 148
const TCrtm = 149
const TCrtr = 150
const TCrbl = 151
const TCrbm = 152
const TCrbr = 153
const TCrfl = 154
const TCrfm = 155
const TCrfr = 156
const TCrz = 157
const TNdtl = 158
const TNdtm = 159
const TNdtr = 160
const TNdbl = 161
const TNdbm = 162
const TNdbr = 163
const TNdfl = 164
const TNdfm = 165
const TNdfr = 166
const TNdz = 167
const TCotl = 168
const TCotm = 169
const TCotr = 170
const TCobl = 171
const TCobm = 172
const TCobr = 173
const TCofl = 174
const TCofm = 175
const TCofr = 176
const TCoz = 177
const TDetl = 178
const TDetm = 179
const TDetr = 180
const TDebl = 181
const TDebm = 182
const TDebr = 183
const TDefl = 184
const TDefm = 185
const TDefr = 186
const TDez = 187
const TBelt0 = 188
const TBelt1 = 189
const TBelt2 = 190
const TBelt3 = 191
const TBelt = 192
const TRoll = 193
const TBeltl = 194
const TBeltr = 195
const TLeg = 196
const TWall = 197
const TFh = 198
const TFv = 199
const TFtl = 200
const TFtr = 201
const TFbl = 202
const TFbr = 203
const TLampo = 204
const TLampg = 205
const TLampr = 206
const TArrow = 207
const TCust = 208
const TServed = 209
const SCup = 0
const SFill1 = 4
const SFill2 = 8
const SFill3 = 12
const SFill4 = 16
const SDrop = 20
const SSplash = 24
const SSteam0 = 28
const SSteam1 = 32
const NTiles8 = 656
const SprBytes = 288
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndBelt = 4
const SndStop = 5
const SndDrip = 6
const SndPlop = 7
const SndMiss = 8
const SndGood = 9
const SndWrong = 10
const SndDay = 11
const SndTock = 12
const SndOver = 13
const NSpr = 4
const CupY = 95
const CxMin = 16
const CxMax = 224
const DropY0 = 63
const DropHit = 89
const DropEnd = 101
const NCus = 2
const ServeN = 50
const WrongN = 40
const SplashN = 12
const WordW = 13

' dispenser nozzle centres (pixels), their first tile, the drop colours
data NozX bytes
  44, 76, 108, 140, 172, 204
end data
data DispT bytes
  TMitl, TSutl, TCrtl, TNdtl, TCotl, TDetl
end data
data DropC bytes
  15, 11, 9, 13, 6, 10
end data
data TagT chars
  "MLKSUGCRMNDCCOFDEC"
end data
' the listing's words (DATA lines 1080-1110), 13 characters each
data WordT chars
  "I NEED       "
  "GET ME       "
  "I WANT       "
  "PLEASE GET   "
  "HURRY WITH MY"
  "HURRY MY     "
  "DECAF.       "
  "NO CAF.      "
  "STRONG       "
  "BLACK        "
  "FINE         "
  "FRESH        "
  "GOOD         "
  "CUP OF       "
  "MILK         "
  "SUGAR        "
  "CREAM        "
  "NONDAIRY     "
  "THANK YOU    "
  "PLEASE HURRY "
  "THANKS       "
  "GOOD LUCK!   "
  "BE QUICK     "
end data
data WordL bytes
  6, 6, 6, 10, 13, 8, 6, 7, 6, 5, 4, 5, 4, 6, 4, 5, 5, 8, 9, 12, 6, 10, 8
end data

record Order:
  u8 Gr
  u8 Cw
  u8 Wm
  u8 Ad
  u8 Cl
  u8 Req
end record

Order Ord
bcd digits 5 Score = 0
bcd digits 5 Hi = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
' game state: Mode 1 waiting for the day, 2 playing, 3 served, 4 wrong
' cup, 9 over
u8 Mode = 0
u8 Day = 1
u8 DayTime = 60
u8 TimeS = 60
u8 TimeF = 0
u8 MiLeft = 2
u8 Cx = 16
u8 Zz = 0
u8 Sel = 0
u8 Cnt = 0
u8 DropOn = 0
u8 Dx = 0
u8 Dy = 0
u8 Dk = 0
u8 SplashT = 0
u8 SplX = 0
u8 PauseT = 0
u8 BeltPh = 0
u8 RepT = 0
u8 TitleOn = 0
' input
u8 Now = 0
u8 Prev = 0
u8 Edge = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Di = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table CbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  if Mode = 1 then
    DayWait
  else
    PlayStep
  end if
  DrawSprites
  if Mode <> 9 then goto play_loop

  ' the end: the original's message, then back to the title on a press
  mute all
  play sound SndOver
  if Score > Hi then Hi = Score
  HideSprites
  NewScreen
  print at 9,4, "G A M E  O V E R"
  print at 3,8, "YOU RAN OUT OF TIME.  THE"
  print at 3,9, "CUSTOMERS LEFT THE SHOP."
  print at 3,12, "YOUR FINAL STATUS:"
  print at 5,14, "SCORE:"
  print Score at 12,14
  print at 5,15, "DAY:"
  NumU = Day
  print at 12,15, digits$(NumU, 2)
  print at 5,17, "BEST:"
  print Hi at 12,17
  ShowScreen
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules

' waiting for the button before the day starts
sub DayWait:
  V = Edge & 16
  if V = 0 then return
  TimeS = DayTime
  TimeF = 0
  NewOrder
  Mode = 2
  ShowHud
  play sound SndBelt
  return
end sub

' one frame of play (modes 2 to 4)
sub PlayStep:
  if Mode = 3 then
    dec PauseT
    if PauseT = 0 then AfterServe
    return
  end if
  ' the clock
  inc TimeF
  if TimeF >= 60 then
    TimeF = 0
    dec TimeS
    ShowTime
    if TimeS = 0 then
      Mode = 9
      return
    end if
    if TimeS <= 5 then play sound SndTock
  end if
  if SplashT > 0 then dec SplashT
  if Mode = 4 then
    dec PauseT
    if PauseT = 0 then
      Mode = 2
      ShowOrder
    end if
    return
  end if
  if DropOn = 1 then
    MoveDrop
    return
  end if
  PickDisp
  V = Edge & 8
  K = Edge & 4
  if V > 0 then
    select case Zz
    case 2
      Zz = 0
      play sound SndStop
    case 0
      Zz = 1
      play sound SndBelt
    end select
    ShowLamps
  elseif K > 0 then
    select case Zz
    case 1
      Zz = 0
      play sound SndStop
    case 0
      Zz = 2
      play sound SndBelt
    end select
    ShowLamps
  end if
  V = Edge & 16
  if V > 0 then
    if Zz = 0 then
      Dk = Sel
      Dx = NozX[Sel] - 7
      Dy = DropY0
      DropOn = 1
      play sound SndDrip
    end if
  end if
  if Zz = 1 then
    inc Cx
    BeltPh = BeltPh + 1
    BeltPh = BeltPh & 3
    ShowBelt
    if Cx >= CxMax then Judge
  elseif Zz = 2 then
    dec Cx
    BeltPh = BeltPh + 3
    BeltPh = BeltPh & 3
    ShowBelt
    if Cx <= CxMin then
      Zz = 0
      ShowLamps
    end if
  end if
  return
end sub

' up and down choose the dispenser (a new push, then a repeat when held)
sub PickDisp:
  V = Now & 3
  if V = 0 then
    RepT = 0
    return
  end if
  K = Edge & 3
  if K = 0 then
    dec RepT
    if RepT > 0 then return
    RepT = 6
  else
    RepT = 16
  end if
  K = V & 1
  if K > 0 then
    if Sel = 0 then
      Sel = 5
    else
      dec Sel
    end if
  else
    inc Sel
    if Sel > 5 then Sel = 0
  end if
  ShowSel
  play sound SndClick
  return
end sub

' the drop falls 2 pixels a frame; at the cup's rim it is in or out
sub MoveDrop:
  Dy = Dy + 2
  if Dy = DropHit then
    X = NozX[Dk]
    V = Cx + 2
    N = Cx + 11
    if X >= V then
      if X <= N then
        DropOn = 0
        V = 1 << Dk
        K = Cnt & V
        if K = 0 then
          Score += 5
          ShowScore
        end if
        Cnt = Cnt | V
        play sound SndPlop
        return
      end if
    end if
  end if
  if Dy >= DropEnd then
    DropOn = 0
    SplashT = SplashN
    SplX = Dx
    play sound SndMiss
  end if
  return
end sub

' the cup ran off the right end: the listing's check, lines 990-1040
sub Judge:
  Zz = 0
  ShowLamps
  if Errors(Cnt, Ord.Req) > 0 then
    Cnt = 0
    Cx = CxMin
    Mode = 4
    PauseT = WrongN
    fill 32 count 16 at 13,21
    print at 13,21, "DO IT RIGHT!"
    play sound SndWrong
    return
  end if
  Score += 50
  ShowScore
  dec MiLeft
  ShowCups
  Mode = 3
  PauseT = ServeN
  play sound SndGood
  return
end sub

' after the steam: the next customer, or the next day
sub AfterServe:
  Cnt = 0
  Cx = CxMin
  if MiLeft > 0 then
    NewOrder
    Mode = 2
    return
  end if
  Score += 100
  inc Day
  if DayTime >= 12 then
    DayTime = DayTime - 3
  else
    DayTime = 9
  end if
  MiLeft = NCus
  Mode = 1
  ShowHud
  ShowCups
  ShowRush
  play sound SndDay
  return
end sub

' the number of dispensers that are wrong (the listing's YT)
function Errors(u8 Have, u8 Want) as u8
  return Popcount(Have ^ Want)

function Popcount(u8 M) as u8
  u8 Bits = 0
  u8 Lim = 6
  u8 Bi = 0
  for Bi = 1 to Lim
    if M & 1 then inc Bits
    M = M >> 1
  next
  return Bits

' a random number 0 .. N-1 from the high byte of the xorshift
function RndN(u8 Range) as u8
  u16 Hv = 0
  u8 Rv = 0
  Rand
  Hv = Rs >> 8
  Hv = Hv * Range
  Hv = Hv >> 8
  Rv = Hv
  return Rv

' a new order by the listing's odds (lines 880-950)
sub NewOrder:
  Ord.Gr = RndN(6)
  if RndN(2) = 0 then
    Ord.Cw = RndN(2) + 6
    V = 32
  else
    Ord.Cw = RndN(6) + 8
    V = 16
  end if
  K = RndN(2)
  Ord.Wm = K + 14
  K = 1 << K
  V = V | K
  K = RndN(3)
  if K = 2 then
    Ord.Ad = 255
  else
    Ord.Ad = K + 16
    K = 4 << K
    V = V | K
  end if
  Ord.Cl = RndN(5) + 18
  Ord.Req = V
  ShowOrder
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' one of the listing's words at X,Y; returns the column after it
function PutWord(u8 Wd, u8 Px, u8 Py) as u8
  u16 Off = 0
  Off = Wd
  Off = Off * WordW
  put WordT + Off count WordW at Px,Py
  return Px + WordL[Wd]

sub ShowOrder:
  for Ri = 17 to 21
    fill 32 count 16 at 13,Ri
  next
  X = PutWord(Ord.Gr, 13, 17)
  X = PutWord(Ord.Cw, 13, 18)
  print at X,18, " COFFEE"
  print at 13,19, "WITH"
  X = PutWord(Ord.Wm, 18, 19)
  if Ord.Ad < 255 then
    print at 13,20, "AND"
    X = PutWord(Ord.Ad, 17, 20)
  end if
  X = PutWord(Ord.Cl, 13, 21)
  return
end sub

sub ShowRush:
  for Ri = 17 to 21
    fill 32 count 16 at 13,Ri
  next
  print at 13,17, "IT'S 7:00 A.M."
  print at 13,18, "THE COFFEE RUSH"
  print at 13,19, "IS HERE!"
  print at 13,20, "PRESS BUTTON TO"
  print at 13,21, "START DAY"
  NumU = Day
  print at 23,21, digits$(NumU, 2)
  return
end sub

' sprite 0 the cup, 1 what is in it, 2 the drop or a splash, 3 steam
sub DrawSprites:
  if TitleOn = 1 then
    V = 192
  else
    V = CupY
  end if
  set sprite 0 to V,Cx,SCup,15
  K = Popcount(Cnt)
  if K > 4 then K = 4
  if K = 0 then
    set sprite 1 to 192,0,0,0
  else
    K = K - 1
    K = K << 2
    K = K + SFill1
    C = FillColour(Cnt)
    set sprite 1 to V,Cx,K,C
  end if
  if DropOn = 1 then
    C = DropC[Dk]
    set sprite 2 to Dy,Dx,SDrop,C
  elseif SplashT > 0 then
    set sprite 2 to CupY,SplX,SSplash,14
  else
    set sprite 2 to 192,0,0,0
  end if
  if Mode = 3 then
    V = Tick >> 3
    V = V & 1
    K = V << 2
    K = K + SSteam0
    V = CupY - 9
    set sprite 3 to V,Cx,K,14
  else
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

' brown coffee, light with milk or cream, white milk alone, grey sugar
function FillColour(u8 Have) as u8
  u8 Fc = 14
  u8 Lt = 0
  Lt = Have & 13
  select case Have & 48
  case 0
    if Lt > 0 then Fc = 15
  case else
    Fc = 6
    if Lt > 0 then Fc = 10
  end select
  return Fc

' the belt's cleats move with the cup: one of four frames into the belt tile
sub ShowBelt:
  W16 = TBelt0 - 128 + BeltPh
  W16 = W16 << 3
  copy TilePat + W16 count 8 to vram.pattern + 2048 + TBelt * 8
  return
end sub

sub ShowLamps:
  T = TLampo
  if Zz = 2 then T = TLampg
  put char T at 3,19
  T = TLampo
  if Zz = 0 then T = TLampr
  put char T at 6,19
  T = TLampo
  if Zz = 1 then T = TLampg
  put char T at 9,19
  return
end sub

sub ShowSel:
  for Di = 0 to 5
    X = Di << 2
    X = X + 5
    T = 32
    if Di = Sel then T = TArrow
    put char T at X,2
  next
  return
end sub

sub ShowCups:
  N = NCus - MiLeft
  for Di = 1 to NCus
    X = Di + 2
    T = TCust
    if Di <= N then T = TServed
    put char T at X,21
  next
  return
end sub

sub ShowHud:
  print at 2,1, "DAY"
  NumU = Day
  print at 6,1, digits$(NumU, 2)
  print at 10,1, "SCORE"
  ShowScore
  print at 23,1, "TIME"
  ShowTime
  return
end sub

sub ShowScore:
  print Score at 16,1
  return
end sub

sub ShowTime:
  NumU = TimeS
  print at 28,1, digits$(NumU, 2)
  return
end sub

' dispenser Di at columns 4 + 4 Di: tag, top, two body rows, funnel, nozzle
sub DrawDispenser:
  X = Di << 2
  X = X + 4
  W16 = Di * 3
  put TagT + W16 count 3 at X,3
  T = DispT[Di]
  for Ri = 4 to 7
    put char T at X,Ri
    V = T + 1
    put char V at X + 1,Ri
    V = T + 2
    put char V at X + 2,Ri
    if Ri <> 5 then T = T + 3
  next
  put char T at X + 1,8
  return
end sub

sub DrawShop:
  for Di = 0 to 5
    DrawDispenser
  next
  for Ri = 9 to 13
    fill TWall count 32 at 0,Ri
  next
  put char TBeltl at 1,14
  fill TBelt count 28 at 2,14
  put char TBeltr at 30,14
  fill TRoll count 28 at 2,15
  put char TLeg at 3,16
  put char TLeg at 28,16
  return
end sub

sub DrawPanels:
  ' the belt panel
  put char TFtl at 2,16
  fill TFh count 8 at 3,16
  put char TFtr at 11,16
  for Ri = 17 to 21
    put char TFv at 2,Ri
    put char TFv at 11,Ri
  next
  put char TFbl at 2,22
  fill TFh count 8 at 3,22
  put char TFbr at 11,22
  print at 3,17, "BELT"
  print at 3,18, "RV ST FW"
  print at 3,20, "CUPS"
  ' the order
  put char TFtl at 12,16
  fill TFh count 16 at 13,16
  put char TFtr at 29,16
  for Ri = 17 to 21
    put char TFv at 12,Ri
    put char TFv at 29,Ri
  next
  put char TFbl at 12,22
  fill TFh count 16 at 13,22
  put char TFbr at 29,22
  print at 15,16, " ORDER "
  return
end sub

sub NewGame:
  Score = 0
  Day = 1
  DayTime = 60
  TimeS = 60
  TimeF = 0
  MiLeft = NCus
  Cx = CxMin
  Zz = 0
  Sel = 0
  Cnt = 0
  DropOn = 0
  SplashT = 0
  BeltPh = 0
  RepT = 0
  TitleOn = 0
  NewScreen
  DrawShop
  DrawPanels
  ShowHud
  ShowLamps
  ShowSel
  ShowCups
  ShowRush
  Mode = 1
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Prev = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' Now: the two sticks and buttons ORed (1 up, 2 down, 4 left, 8 right,
' 16 button); Edge: what was pressed since the last frame
sub ReadPad:
  Now = 0
  if joypad(1).up then Now = Now | 1
  if joypad(1).down then Now = Now | 2
  if joypad(1).left then Now = Now | 4
  if joypad(1).right then Now = Now | 8
  if joypad(1).fire then Now = Now | 16
  if joypad(2).up then Now = Now | 1
  if joypad(2).down then Now = Now | 2
  if joypad(2).left then Now = Now | 4
  if joypad(2).right then Now = Now | 8
  if joypad(2).fire then Now = Now | 16
  V = Prev ^ 255
  Edge = Now & V
  Prev = Now
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the shop, a cup riding the belt, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawShop
  print at 9,17, "COFFEE  BREAK!"
  print at 8,18, "BY DAN KOMAROMI"
  print at 11,20, "START GAME"
  print at 11,21, "CREDITS"
  print at 9,22, "AHOY! FEB 1988"
  print at 2,1, "BEST"
  print Hi at 7,1
  Sel = 9
  ShowSel
  ShowMenu
  TitleOn = 0
  Mode = 0
  Cx = CxMin
  Cnt = 0
  DropOn = 0
  SplashT = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 550
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Prev = 16
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the cup rides the belt and fills on its way
  inc Cx
  BeltPh = BeltPh + 1
  BeltPh = BeltPh & 3
  ShowBelt
  if Cx >= CxMax then
    Cx = CxMin
    Cnt = 0
  end if
  for Di = 0 to 5
    V = NozX[Di] - 7
    if Cx = V then Cnt = Cnt | Bit6(Di)
  next
  DrawSprites
  V = Now & 3
  K = Edge & 3
  if K > 0 then
    K = V & 1
    if K > 0 then
      Menu = 0
    else
      Menu = 1
    end if
    ShowMenu
  end if
  V = Edge & 16
  if V = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' coffee (bit 4) and milk (bit 0) only on the title cup
function Bit6(u8 Dn) as u8
  select case Dn
  case 0
    return 1
  case 4
    return 16
  case else
    return 0
  end select
  return 0

sub ShowMenu:
  put char 32 at 9,20
  put char 32 at 9,21
  J = Menu + 20
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "COFFEE  BREAK!"
  print at 2,5, "BASED ON COFFEE BREAK! BY"
  print at 2,6, "DAN KOMAROMI (1987),"
  print at 2,7, "MODIFIED FOR THE C-128 BY"
  print at 2,8, "CLEVELAND M. BLAKEMORE,"
  print at 2,9, "AHOY! FEBRUARY 1988."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: SEVEN A.M."
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

