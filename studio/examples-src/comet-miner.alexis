u16 NumU = 0
' scratch (never kept across a sub call)
u8 T = 0
u8 U = 0
u8 K = 0
u8 J = 0
u8 H = 0
u8 V = 0
u8 D = 0
u16 W = 0
i16 Si = 0
i16 Sj = 0

  tile screen
  call asm CmSetR3
  set sound table CmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SprPat count SprBytes to vram.spr_pat
  HideSpr
  screen on

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if State = StPlay then goto play_loop

  ' game over: one press (after 1 s) returns to the title
  print at 11,18, "GAME OVER"
  Waited = 0
go_wait:
  Frame1
  ReadPad
  PlayIdle
  inc Waited
  if Waited < 60 then Press = 0
  if Waited >= 1800 then Press = 1
  if Press = 0 then goto go_wait
  InPlay = 0
  goto title

' ===========================================================================
' game flow

sub NewGame:
  Score = 0
  Lives = 3
  Lvl = 1
  Chain = 0
  Mined = 0
  Shots = 0
  Misses = 0
  Deaths = 0
  Launches = 0
  Jets = 0
  Gusts = 0
  Clears = 0
  Reversals = 0
  PlayScreen
  NewLevel
  State = StPlay
  return
end sub

' parameters of comet Lvl (tables from gen.py, levels 1..10, then 10 again)
sub NewLevel:
  LvI = Lvl - 1
  if LvI > 9 then LvI = 9
  Need = LvNeed[LvI]
  JetIdle = LvJet[LvI]
  DbEvery = LvDeb[LvI]
  DbSp = LvDbSp[LvI]
  WdF = LvWind[LvI]
  NVent = LvVent[LvI]
  RvOn = LvRev[LvI]
  SpinT = LvSpin[LvI]
  AirFull = LvAir[LvI]
  AirCell = LvCell[LvI]
  T = Lvl & 1
  if T = 0 then SpinT = 0 - SpinT
  SpinV = SpinT
  RvT = 900
  Got = 0
  for K = 0 to 2
    CrS[K] = 0
    T = K << 4
    CrT[K] = T + 20
  next
  Respawn
  HGot = 255
  HAir = 255
  HLvl = 255
  return
end sub

' the ship back at the top, the hazards gone, a grace period
sub Respawn:
  Th = $C000
  Om = 0
  AltF = AltStart << 8
  AltV = 0
  Facing = 0
  BmT = 0
  BmCD = 0
  Grace = 120
  AirT = AirFull
  AirSub = AirCell
  AirC = 9
  HAir = 255
  for K = 0 to 1
    HzK[K] = 0
  next
  for K = 0 to 2
    VtS[K] = 0
    T = K * 50
    VtT[K] = JetIdle - T
  next
  DbT = DbEvery
  WdS = 0
  WdT = 600
  WdOff = 0
  HWind = 255
  StarPh = 0
  Ph = PhPlay
  return
end sub

sub PlayStep:
  AngF += SpinV
  if Ph = PhPlay then
    PlayLive
  else
    if Ph = PhDead then
      DeadStep
    else
      ClearStep
    end if
  end if
  BuildSat
  Hud
  return
end sub

' game over screen: the comet keeps turning
sub PlayIdle:
  AngF += SpinV
  Sat[0] = 192
  Sat[4] = 192
  Sat[8] = 192
  Sat[12] = 192
  return
end sub

sub PlayLive:
  ShipCtl
  WindStep
  ShipMove
  BeamStep
  CrystalStep
  VentStep
  DebrisStep
  SpinStep
  if Grace > 0 then dec Grace
  if MsgOn = 1 then
    if Grace < 60 then
      fill 32 count 11 at 10,18
      MsgOn = 0
    end if
  end if
  dec AirT
  dec AirSub
  if AirSub = 0 then
    AirSub = AirCell
    dec AirC
  end if
  if AirT = 0 then
    DieWhy = 4
    Kill
  end if
  return
end sub

' DieWhy (for the tests): 1 debris, 2 ice jet, 3 crashed into the comet, 4 air
sub Kill:
  if Ph <> PhPlay then return
  Ph = PhDead
  PhT = 110
  dec Lives
  inc Deaths
  Chain = 0
  BmT = 0
  for K = 0 to 1
    HzK[K] = 0
  next
  for K = 0 to 2
    VtS[K] = 0
    VtT[K] = 90
  next
  if WdS > 0 then
    WdS = 0
    WdT = 400
  end if
  StarPh = 0
  play sound SndBoom
  if DieWhy = 4 then
    print at 10,18, "OUT OF AIR"
    MsgOn = 1
  end if
  return
end sub

sub DeadStep:
  dec PhT
  if PhT = 0 then
    if MsgOn = 1 then
      fill 32 count 11 at 10,18
      MsgOn = 0
    end if
    if Lives = 0 then
      State = StOver
      return
    end if
    Respawn
    print at 11,18, "GET READY"
    MsgOn = 1
  end if
  return
end sub

sub LevelClear:
  Ph = PhClear
  PhT = 150
  inc Clears
  BmT = 0
  for K = 0 to 1
    HzK[K] = 0
  next
  for K = 0 to 2
    VtS[K] = 0
  next
  WdS = 0
  StarPh = 0
  print at 10,18, "COMET CLEAR"
  ' bonus: 10 points a second of air left (score is kept in tens)
  W = AirT / 64
  Score += W
  play sound SndClear
  return
end sub

sub ClearStep:
  dec PhT
  if PhT = 0 then
    fill 32 count 11 at 10,18
    inc Lvl
    T = Lvl % 3
    if T = 1 then
      if Lives < 5 then inc Lives
    end if
    NewLevel
    print at 11,18, "GET READY"
    MsgOn = 1
  end if
  return
end sub

' ===========================================================================
' the ship

sub ShipCtl:
  Thr = 0
  if BmT = 0 then
    T = Jk & 8
    if T > 0 then
      Om += OmAcc
      Facing = 0
      Thr = 1
    end if
    T = Jk & 4
    if T > 0 then
      Om -= OmAcc
      Facing = 1
      Thr = 1
    end if
  else
    ' drilling: the ship holds over the comet
    Si = Om >> 3
    Om -= Si
  end if
  if Thr = 0 then
    Si = Om >> 5
    Om -= Si
    if Om < 24 then
      if Om > -24 then Om = 0
    end if
  end if
  if Om > OmMax then Om = OmMax
  if Om < -OmMax then Om = -OmMax
  T = Jk & 1
  U = Jk & 2
  if T > 0 then
    AltV += 24
    if AltV > 192 then AltV = 192
  else
    if U > 0 then
      AltV -= 24
      if AltV < -192 then AltV = -192
    else
      Si = AltV >> 2
      AltV -= Si
      if AltV < 8 then
        if AltV > -8 then AltV = 0
      end if
    end if
  end if
  if Press = 1 then
    if BmT = 0 then
      if BmCD = 0 then
        BmT = BeamLen
        BmHit = 0
        inc Shots
        play sound SndBeam
      end if
    end if
  end if
  return
end sub

sub ShipMove:
  Th += Om
  AltF += AltV
  if AltF > AltMax * 256 then
    AltF = AltMax * 256
    if AltV > 0 then AltV = 0
  end if
  if AltF < AltMin * 256 then
    AltF = AltMin * 256
    if AltV < 0 then AltV = 0
  end if
  ' the wind's offset (WdOff, set by WindStep) can push below AltMin: a crash
  Si = AltF + WdOff
  if Si < CrashAlt * 256 then
    DieWhy = 3
    Kill
    Si = CrashAlt * 256
  end if
  if Si > AltMax * 256 + 2048 then Si = AltMax * 256 + 2048
  A8 = highbyte Th
  Alt = highbyte Si
  PR = Alt
  PA = A8
  Polar
  SX = PX
  SY = PY
  return
end sub

' the beam: a crystal whose centre is within MineW angle units of the ship
' and within BeamReach of its altitude is mined
sub BeamStep:
  if BmCD > 0 then dec BmCD
  if BmT = 0 then return
  dec BmT
  if BmHit = 0 then
    for K = 0 to 2
      if CrS[K] = 1 then
        J = CrJ[K]
        T = CsA[J]
        T += ShownA
        D = A8 - T
        if D >= 128 then D = 0 - D
        if D <= MineW then
          T = CsR[J]
          T += BeamReach
          if Alt <= T then
            CrS[K] = 2
            CrT[K] = 20
            BmHit = 1
            if Chain < 5 then inc Chain
            T = Chain * 10
            Score += T
            inc Got
            inc Mined
            play sound SndMine
          end if
        end if
      end if
    next
  end if
  if BmT = 0 then
    if BmHit = 0 then
      Chain = 0
      BmCD = MissCD
      inc Misses
      play sound SndMiss
      ' a miss costs 3 s of air
      if AirT > MissAir then
        AirT -= MissAir
        if AirSub > MissAir then
          AirSub -= MissAir
        else
          AirSub += AirCell
          AirSub -= MissAir
          if AirC > 0 then dec AirC
        end if
      else
        AirT = 1
      end if
    else
      BmCD = HitCD
      if Got >= Need then LevelClear
    end if
  end if
  return
end sub

' ===========================================================================
' crystals, vents, debris, wind, spin

sub CrystalStep:
  ' how many there or bursting
  U = 0
  for K = 0 to 2
    if CrS[K] > 0 then inc U
  next
  for K = 0 to 2
    if CrS[K] = 2 then
      dec CrT[K]
      if CrT[K] = 0 then
        CrS[K] = 0
        CrT[K] = 50
      end if
    else
      if CrS[K] = 0 then
        if CrT[K] > 0 then
          dec CrT[K]
        else
          T = Got + U
          if T < Need then
            NewCrystal
            if CrS[K] = 1 then inc U
          end if
        end if
      end if
    end if
  next
  return
end sub

' crystal K on a free rim slot, not right under the ship (tries 4 slots)
sub NewCrystal:
  for H = 1 to 4
    Rnd
    J = RndV & 15
    if J < NCSlot then
      V = 1
      for D = 0 to 2
        if CrS[D] > 0 then
          if CrJ[D] = J then V = 0
        end if
      next
      T = CsA[J]
      T += ShownA
      T = T - A8
      T += 32
      if T < 64 then V = 0
      if V = 1 then
        CrJ[K] = J
        CrS[K] = 1
        return
      end if
    end if
  next
  CrT[K] = 8
  return
end sub

' a free hazard slot -> H (2 = none)
sub FreeSlot:
  H = 2
  if HzK[1] = 0 then H = 1
  if HzK[0] = 0 then H = 0
  return
end sub

sub VentStep:
  for V = 0 to 2
    if V < NVent then
      VentOne
    end if
  next
  return
end sub

sub VentOne:
  T = VtS[V]
  if T = 0 then
    if VtT[V] > 0 then
      dec VtT[V]
      return
    end if
    if Grace > 0 then return
    FreeSlot
    if H = 2 then
      VtT[V] = 20
      return
    end if
    HzK[H] = 4
    VtH[V] = H
    VtS[V] = 1
    VtT[V] = VtTellT
    play sound SndHiss
    return
  end if
  H = VtH[V]
  dec VtT[V]
  if T = 1 then
    if VtT[V] = 0 then
      VtS[V] = 2
      VtT[V] = JetT
      HzK[H] = 3
      inc Jets
      play sound SndJet
    end if
  else
    if VtT[V] = 0 then
      VtS[V] = 0
      Rnd
      T = RndV & 63
      VtT[V] = JetIdle + T
      HzK[H] = 0
      return
    end if
  end if
  if VtS[V] = 2 then
    ' the jet (also on the frame it starts): centred 11 px out from the vent, along the vent's angle
    D = VtA[V]
    D += ShownA
    T = VtR[V]
    PR = T + 10
    PA = D
    Polar
    HzSX[H] = PX
    HzSY[H] = PY
    T = D + 8
    T = T >> 4
    T = T & 7
    T = T << 2
    U = Tick & 8
    U = U << 2
    T += U
    HzP[H] = T + SJet0_0
    HzC[H] = 7
    ' the hit: the ship's angle within 7 units, its altitude within reach
    if Grace = 0 then
      U = A8 - D
      if U >= 128 then U = 0 - U
      if U <= 6 then
        T = VtR[V]
        T += 21
        if Alt <= T then
          DieWhy = 2
          Kill
        end if
      end if
    end if
  end if
  return
end sub

sub DebrisStep:
  if DbT > 0 then
    dec DbT
  else
    FreeSlot
    if H < 2 then
      if Grace = 0 then
        Rnd
        J = RndV & 15
        ' not within 24 angle units of the ship
        T = VxA[J]
        T += ShownA
        T = T - A8
        T += 24
        if T >= 48 then
          HzK[H] = 1
          HzT[H] = DbTellT
          HzJ[H] = J
          Rnd
          T = RndV & 127
          DbT = DbEvery + T
        end if
      end if
    end if
  end if
  for H = 0 to 1
    T = HzK[H]
    if T = 1 then DebLoose
    if T = 2 then DebFly
  next
  return
end sub

' loose on the rim: turns with the comet, wobbles, then flies
sub DebLoose:
  J = HzJ[H]
  D = VxA[J]
  D += ShownA
  T = VxR[J]
  PR = T + 2
  PA = D
  Polar
  HzSX[H] = PX
  HzSY[H] = PY
  T = HzT[H] >> 3
  T = T & 1
  T = T << 2
  HzP[H] = SDeb0 + T
  HzC[H] = 10
  dec HzT[H]
  if HzT[H] > 0 then return
  ' launch: from the rim point, along the spin (52 units off the radius:
' mostly along the rim)
  Si = PX
  Si -= 128
  HzX[H] = Si << 8
  Si = PY
  Si -= 96
  HzY[H] = Si << 8
  if SpinV >= 0 then
    D += 52
  else
    D -= 52
  end if
  PR = DbSp
  PA = D
  Polar
  Si = PX
  Si -= 128
  HzVX[H] = Si << 3
  Si = PY
  Si -= 96
  HzVY[H] = Si << 3
  HzK[H] = 2
  inc Launches
  play sound SndLaunch
  return
end sub

sub DebFly:
  Si = HzX[H] + HzVX[H]
  HzX[H] = Si
  Sj = HzY[H] + HzVY[H]
  HzY[H] = Sj
  Si = Si >> 8
  Sj = Sj >> 8
  if Si > 104 then
    HzK[H] = 0
    return
  end if
  if Si < -104 then
    HzK[H] = 0
    return
  end if
  if Sj > 70 then
    HzK[H] = 0
    return
  end if
  if Sj < -70 then
    HzK[H] = 0
    return
  end if
  Si += 128
  Sj += 96
  T = lowbyte Si
  U = lowbyte Sj
  HzSX[H] = T
  HzSY[H] = U
  D = Tick >> 2
  D = D & 3
  D = D << 2
  HzP[H] = SDeb0 + D
  HzC[H] = 10
  if Grace > 0 then return
  ' hit box: 6 px each way (ship and rock both about 7 px wide)
  D = T - SX
  if D >= 128 then D = 0 - D
  if D < 6 then
    D = U - SY
    if D >= 128 then D = 0 - D
    if D < 6 then
      DieWhy = 1
      Kill
    end if
  end if
  return
end sub

sub WindStep:
  ' the wind's altitude offset relaxes (1/32 a frame)
  Si = WdOff >> 5
  WdOff -= Si
  if WdOff < 32 then
    if WdOff > -32 then WdOff = 0
  end if
  if WdF = 0 then return
  if WdS = 0 then
    if WdT > 0 then
      dec WdT
      return
    end if
    if Grace > 0 then return
    WdS = 1
    WdT = WdTellT
    Rnd
    WdDir = RndV & 1
    play sound SndWarn
    return
  end if
  dec WdT
  if WdS = 1 then
    if WdT = 0 then
      WdS = 2
      WdT = GustT
      inc Gusts
      play sound SndGust
    end if
    return
  end if
  ' the gust: a push along screen x, split into radial (altitude) and
  ' tangential (orbit) parts from the ship's angle (RsTab row WdF)
  PR = WdF
  PA = A8
  Polar
  Si = PX
  Si -= 128
  Sj = PY
  Sj -= 96
  if WdDir = 1 then
    Si = 0 - Si
    Sj = 0 - Sj
  end if
  Si = Si << 3
  WdOff += Si
  Sj = Sj >> 1
  Om -= Sj
  if WdT = 0 then
    WdS = 0
    Rnd
    WdT = RndV
    WdT += 540
    StarPh = 0
  end if
  return
end sub

sub SpinStep:
  if SpinV < SpinT then
    SpinV += 2
  else
    if SpinV > SpinT then SpinV -= 2
  end if
  if RvOn = 0 then return
  dec RvT
  if RvT = 0 then
    SpinT = 0 - SpinT
    Rnd
    RvT = RndV
    RvT += 720
    inc Reversals
  end if
  if RvT = RvTellT then play sound SndGroan
  return
end sub

' 16-bit xorshift (7, 9, 8) -> RndV
sub Rnd:
  asm {
    ld hl,(Seed)
    ld a,h
    rra
    ld a,l
    rra
    xor h
    ld h,a
    ld a,l
    rra
    ld a,h
    rra
    xor l
    ld l,a
    xor h
    ld h,a
    ld (Seed),hl
    ld (RndV),a
    ret
  }
end sub

' ===========================================================================
' sprites and HUD

sub BuildSat:
  ' slot 0: the ship (blinks at 1.9 Hz during the grace period) or the blast
  if Ph = PhDead then
    if PhT > 86 then
      T = 110 - PhT
      T = T / 6
      T = T << 2
      Sat[0] = SY - 9
      Sat[1] = SX - 8
      Sat[2] = SExp0 + T
      ' light yellow, then light red (one change, no flashing)
      Sat[3] = 11
      if PhT < 98 then Sat[3] = 9
    else
      Sat[0] = 192
    end if
    Sat[4] = 192
  else
    if Facing = 0 then
      T = A8 + 72
    else
      T = A8 + 200
    end if
    T = T >> 4
    T = T << 2
    Sat[0] = SY - 9
    Sat[1] = SX - 8
    Sat[2] = T
    Sat[3] = 15
    if Grace > 0 then
      T = Grace & 16
      if T > 0 then Sat[0] = 192
    end if
    ' slot 1: the beam (centred 10 px under the ship) or the flame
    Sat[4] = 192
    if BmT > 0 then
      PR = Alt - 10
      PA = A8
      Polar
      Sat[4] = PY - 9
      Sat[5] = PX - 8
      T = A8 + 8
      T = T >> 4
      T = T & 7
      T = T << 2
      U = Tick & 8
      U = U << 2
      T += U
      Sat[6] = SBeam0_0 + T
      Sat[7] = 11
    else
      if Thr = 1 then
        if Ph = PhPlay then
          PR = Alt
          T = 7
          if Alt > 48 then T = 5
          if Facing = 0 then
            PA = A8 - T
          else
            PA = A8 + T
          end if
          Polar
          Sat[4] = PY - 9
          Sat[5] = PX - 8
          T = Tick & 8
          T = T >> 1
          Sat[6] = SFlameA + T
          Sat[7] = 9
        end if
      end if
    end if
  end if
  ' slots 2-3: the hazards that have a sprite
  for H = 0 to 1
    T = H << 2
    T += 8
    U = HzK[H]
    if U > 0 then
      if U < 4 then
        Sat[T] = HzSY[H] - 9
        inc T
        Sat[T] = HzSX[H] - 8
        inc T
        Sat[T] = HzP[H]
        inc T
        Sat[T] = HzC[H]
      else
        Sat[T] = 192
      end if
    else
      Sat[T] = 192
    end if
  next
  return
end sub

' the HUD: one item a frame, only what changed (row 1: ships, level, score,
' chain, wind, spin; row 22: crystals to mine, air). Tiles go straight to
' the name table (CmPutAt: PcT at column PcC, row PcR).
sub Hud:
  inc HudN
  if HudN >= 6 then HudN = 0
  PcR = 1
  if HudN = 0 then
    if Lives <> HLives then
      HLives = Lives
      for K = 0 to 4
        PcC = K + 2
        PcT = 32
        if K < Lives then PcT = TShip
        call asm CmPutAt
      next
    end if
    return
  end if
  if HudN = 1 then
    if Lvl <> HLvl then
      HLvl = Lvl
      PcC = 8
      PcT = 76
      call asm CmPutAt
      PcC = 9
      PcT = 86
      call asm CmPutAt
      NumU = Lvl
      PcC = 10
      call asm CmNum2
    end if
    return
  end if
  if HudN = 2 then
    if Score <> HScore then
      HScore = Score
      call asm CmScore
    end if
    return
  end if
  if HudN = 3 then
    HudFlags
    return
  end if
  if HudN = 4 then
    if Got <> HGot then
      PcR = 22
      if HGot = 255 then
        for K = 0 to 11
          PcC = K + 3
          PcT = 32
          if K < Need then
            PcT = TGemoff
            if K < Got then PcT = TGem
          end if
          call asm CmPutAt
        next
      else
        if Got > 0 then
          PcC = Got + 2
          PcT = TGem
          call asm CmPutAt
        end if
      end if
      HGot = Got
    end if
    return
  end if
  T = AirC
  if T <> HAir then
    PcR = 22
    for K = 0 to 8
      PcC = K + 19
      PcT = TBare
      if K < T then
        PcT = TBarf
        if T < 3 then PcT = TBarl
      end if
      call asm CmPutAt
    next
    HAir = T
  end if
  return
end sub

' chain, wind arrow (blinks during the warning, steady in the gust), spin
' arrow (blinks before a reversal)
sub HudFlags:
  if Chain <> HChain then
    HChain = Chain
    PcC = 21
    PcT = 32
    if Chain > 1 then PcT = TLink
    call asm CmPutAt
    PcC = 22
    if Chain > 1 then PcT = Chain + 48
    call asm CmPutAt
  end if
  T = 0
  if WdS = 1 then
    U = WdT & 16
    if U > 0 then T = 1
  end if
  if WdS = 2 then T = 1
  if T = 1 then T = WdDir + 1
  if T <> HWind then
    HWind = T
    PcC = 25
    PcT = 32
    if T = 1 then PcT = TWindr
    if T = 2 then PcT = TWindl
    call asm CmPutAt
  end if
  T = 1
  if SpinT < 0 then T = 2
  if RvOn = 1 then
    if RvT < RvTellT then
      U = RvT & 16
      if U > 0 then T = 0
    end if
  end if
  if T <> HSpin then
    HSpin = T
    PcC = 28
    PcT = 32
    if T = 1 then PcT = TSpincw
    if T = 2 then PcT = TSpinccw
    call asm CmPutAt
  end if
  return
end sub

' HUD writers: a tile, a 2-digit number (NumU < 100, leading blank), the
' score (Score in tens: 5 digits and a 0)
sub CmHudS:
  asm {
CmPutAt:
    ld a,(PcR)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(PcC)
    or l
    ld l,a
    ld a,h
    add a,$18
    ld h,a
    call CmWa
    ld a,(PcT)
    out (VDP_DATA_PORT),a
    ret
CmNum2:
    ld a,(NumU)
    ld b,0
CmNm1:
    cp 10
    jr c,CmNm2
    sub 10
    inc b
    jr CmNm1
CmNm2:
    add a,48
    ld c,a
    ld a,b
    or a
    ld a,32
    jr z,CmNm3
    ld a,b
    add a,48
CmNm3:
    ld (PcT),a
    push bc
    call CmPutAt
    pop bc
    ld a,c
    ld (PcT),a
    ld hl,PcC
    inc (hl)
    jp CmPutAt
CmScore:
    ld hl,$1800 + 32 + 14
    call CmWa
    ld hl,(Score)
    ld de,Pow10
    ld b,5
CmSc1:
    push bc
    ; (r11 drops a second "ld a,(de)" after "inc de": read through hl)
    ex de,hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ex de,hl
    ld a,47
CmSc2:
    inc a
    or a
    sbc hl,bc
    jr nc,CmSc2
    add hl,bc
    out (VDP_DATA_PORT),a
    pop bc
    djnz CmSc1
    ld a,48
    out (VDP_DATA_PORT),a
    ret
  }
end sub

' ===========================================================================
' screens

sub PlayScreen:
  InPlay = 0
  NewScreen
  call asm CmStarsNames
  call asm CmPlayVram
  put char TGem at 2,22
  put char TO2 at 18,22
  HLives = 255
  HLvl = 255
  HScore = 65535
  HChain = 255
  HGot = 255
  HAir = 255
  HWind = 255
  HSpin = 255
  MsgOn = 0
  RbPh = 0
  RbBuf = 1
  RbBase = $0E
  RbCBase = $2E
  PgN[0] = 0
  PgN[1] = 0
  StarNow = 255
  for K = 0 to 16
    Sat[K] = 192
  next
  Sat[16] = 208
  InPlay = 1
  ShowScreen
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      TuneOff
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  if InPlay = 1 then call asm CmBlit
  return
end sub

sub ReadPad:
  T = 0
  if joypad(1).up then T = T | 1
  if joypad(1).down then T = T | 2
  if joypad(1).left then T = T | 4
  if joypad(1).right then T = T | 8
  if joypad(1).fire then T = T | 16
  if joypad(2).up then T = T | 1
  if joypad(2).down then T = T | 2
  if joypad(2).left then T = T | 4
  if joypad(2).right then T = T | 8
  if joypad(2).fire then T = T | 16
  Jk = T & 15
  U = WasJ ^ 15
  Edge = Jk & U
  WasJ = Jk
  Btn = T & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSpr:
  for K = 0 to 4
    T = K << 2
    Sat[T] = 208
  next
  call asm CmSatOut
  return
end sub

' every screen: wait, NMI off, display off, font + icons + stars, blank names
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSpr
  fill mode 2 text color with $F1
  call asm CmIcons
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub TuneOff:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  TzOn = 0
  return
end sub

sub TitlePage:
  InPlay = 0
  State = 12
  NewScreen
  if TzOn = 1 then TuneOff
  play sound SndTuneA
  play sound SndTuneB
  play sound SndTuneC
  play sound SndTuneD
  TzOn = 1
  TzLeft = TuneFrames
  call asm CmStarsNames
  call asm CmLogo
  TtStart
  print at 12,16, "START"
  print at 12,18, "HOW TO PLAY"
  print at 12,20, "CREDITS"
  Menu = 0
  ShowMenu
  ShowScreen
  State = StTitle
  WasBtn = 16
tp_loop:
  Frame1
  ReadPad
  Rnd
  TtScene
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    ShowMenu
    if TzOn = 0 then play sound SndClick
  end if
  if Press = 0 then goto tp_loop
  if TzOn = 1 then TuneOff
  State = 12
  HideSpr
  return
end sub

' ===========================================================================
' the title scene: the ship orbits the logo on an ellipse (x = 120 + 100 cos a,
' y = 60 + 52 sin a, from the RsTab quarter-wave rows 50 and 52), facing its
' way (TtHd: frame by angle) with its flame 10 px behind (TtFx/TtFy); every
' 6 s a comet (two colour layers: white core, cyan coma and tail) crosses
' the logo from the left edge (the early-clock bit carries it in from
' x = -32) down to the right. The VDP collision flag (the NMI's status read)
' turns the ship yellow for 2/3 s when the comet brushes it.
' Sprites: 0 ship, 1 flame, 2 comet core, 3 coma: 4 in all, never flicker.
const TtRowX = 3250
const TtRowY = 3380

sub TtStart:
  TtA = 0
  TtC = 0
  TtW = 90
  TtF = 0
  set sprite count 4
  TtScene
  return
end sub

' Tq (angle) -> Si = r sin(Tq) for the RsTab row starting at W
sub TtSin:
  T = TtP & 63
  if TtP & 64 then T = 64 - T
  W += T
  Si = RsTab[W]
  if TtP & 128 then Si = 0 - Si
  return
end sub

sub TtScene:
  ' the ship: 0.75 angle steps a frame (one orbit in 5.7 s)
  TtA += 192
  TtP = highbyte TtA
  TtP += 64
  W = TtRowX
  TtSin
  Si = Si << 1
  Si += 120
  TtX = Si
  TtP = highbyte TtA
  W = TtRowY
  TtSin
  Si += 60
  TtY = Si
  T = TtP >> 2
  K = TtHd[T]
  U = 15
  if TtF > 0 then
    dec TtF
    U = 11
  end if
  set sprite 0 to TtY - 1,TtX,K,U
  ' the flame: 10 px behind the nose, two shapes 3 times a second
  J = K >> 2
  H = TtY + TtFy[J]
  H -= 17
  V = TtX + TtFx[J]
  V -= 16
  T = Tick & 16
  T = T >> 2
  set sprite 1 to H,V,SFlameA + T,9
  ' the comet: TtC = screen x + 32 (0 = waiting)
  if TtC = 0 then
    dec TtW
    if TtW = 0 then TtC = 1
  end if
  if TtC > 0 then
    TtC += 2
    W = TtC >> 2
    H = W
    H += 15
    if TtC < 32 then
      V = TtC
      D = 128
    else
      W = TtC - 32
      V = W
      D = 0
    end if
    T = Tick & 16
    T = T >> 2
    set sprite 2 to H,V,SCmCore,15 + D
    set sprite 3 to H,V,SCmComa0 + T,7 + D
    if TtC >= 286 then
      TtC = 0
      TtW = 216
    end if
  else
    set sprite 2 to 207,0,SCmCore,0
    set sprite 3 to 207,0,SCmCore,0
  end if
  call asm PcSpr
  if any collision then
    TtF = 40
    inc TtHits
  end if
  return
end sub

sub ShowMenu:
  put char 32 at 10,16
  put char 32 at 10,18
  put char 32 at 10,20
  T = Menu << 1
  T += 16
  put char 62 at 10,T
  return
end sub

sub PageWait:
  ShowScreen
  State = PgState
  WasBtn = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  State = 12
  return
end sub

sub CreditsPage:
  State = 12
  NewScreen
  print at 10,3, "COMET MINER"
  print at 8,5, "AN ORIGINAL GAME"
  print at 4,9, "A GAME BY AMY & CLAUDE"
  print at 7,11, "AMY STUDIO 2026"
  print at 4,15, "MADE IN AMY FOR THE"
  print at 4,17, "COLECOVISION"
  print at 8,21, "PRESS THE BUTTON"
  PgState = StCredits
  PageWait
  return
end sub

sub HowTo:
  State = StHow
  PgState = StHow
  NewScreen
  print at 8,1, "HOW TO PLAY  1/2"
  print at 3,3, "MINE THE PINK CRYSTALS"
  print at 3,4, "ON THE SPINNING COMET."
  print at 3,6, "LEFT/RIGHT: FLY AROUND"
  print at 3,7, "UP/DOWN: CLIMB OR DIVE"
  print at 3,9, "BUTTON: DRILL BEAM DOWN."
  print at 3,10, "FLY LOW, DRILL A CRYSTAL"
  print at 3,11, "AS IT PASSES UNDER YOU."
  print at 3,13, "A MISS BREAKS THE CHAIN"
  print at 3,14, "AND COSTS AIR."
  put char TGem at 3,16
  put char TGem at 4,16
  put char TGemoff at 5,16
  print at 7,16, "MINE THEM ALL TO CLEAR"
  print at 7,17, "THE COMET."
  put char TO2 at 3,19
  put char TBarf at 4,19
  put char TBarf at 5,19
  put char TBare at 6,19
  print at 8,19, "BEFORE THE AIR ENDS"
  print at 8,21, "PRESS THE BUTTON"
  ' the ship drilling a crystal
  Sat[0] = 22
  Sat[1] = 208
  Sat[2] = SShip12
  Sat[3] = 15
  Sat[4] = 37
  Sat[5] = 208
  Sat[6] = SBeam0_4
  Sat[7] = 11
  Sat[8] = 50
  Sat[9] = 208
  Sat[10] = SGem
  Sat[11] = 13
  Sat[12] = 208
  call asm CmSatOut
  PageWait
  if TimedOut = 0 then
    NewScreen
    print at 8,1, "HOW TO PLAY  2/2"
    put char TDeb at 3,3
    print at 5,3, "ROCKS WOBBLE, THEN FLY"
    print at 5,4, "OFF THE SPINNING RIM."
    put char TVent at 3,6
    print at 5,6, "VENTS BLINK, THEN JET"
    print at 5,7, "ICE STRAIGHT OUT."
    put char TWindr at 3,9
    print at 5,9, "SOLAR WIND (COMET 2+)"
    print at 5,10, "PUSHES YOU: DONT CRASH."
    put char TSpincw at 3,12
    print at 5,12, "THE SPIN CAN REVERSE"
    print at 5,13, "(COMET 3+) - WATCH IT."
    put char TLink at 3,15
    print at 5,15, "CHAIN: CRYSTALS IN A"
    print at 5,16, "ROW SCORE 100 TO 500."
    put char TShip at 3,18
    put char TShip at 4,18
    print at 6,18, "SHIPS: +1 EVERY 3RD"
    print at 6,19, "COMET CLEARED"
    print at 8,21, "PRESS THE BUTTON"
    PageWait
  end if
  HideSpr
  return
end sub

' ===========================================================================
' Z80: polar lookup, comet drawing, VRAM blit

' PR (radius 0..71), PA (angle) -> PX = 128 + PR cos PA, PY = 96 + PR sin PA
sub Polar:
  asm {
    ld a,(PR)
    ld c,a
    ld a,(PA)
    call CmPol
    ld a,d
    add a,128
    ld (PX),a
    ld a,e
    add a,96
    ld (PY),a
    ret
; a = angle, c = radius -> d = r cos a, e = r sin a (signed bytes)
CmPol:
    ld b,a
    ld a,c
    add a,a
    ld l,a
    ld h,0
    ld de,RsRow
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld a,b
    add a,64
    call CmSinD
    push af
    ld a,b
    call CmSinD
    ld e,a
    pop af
    ld d,a
    ret
; a = angle, de = RsTab row -> a = r sin(angle) (quarter wave; c, hl used)
CmSinD:
    ld c,a
    and 63
    bit 6,c
    jr z,CmSd1
    neg
    add a,64
CmSd1:
    ld l,a
    ld h,0
    add hl,de
    ld a,(hl)
    bit 7,c
    ret z
    neg
    ret
  }
end sub

' R3 = $FF: three separate colour thirds
sub CmR3:
  asm {
CmSetR3:
    ld bc,$03FF
    jp WRITE_REGISTER
  }
end sub

' the frame's VRAM work: sprite table, then one step of the comet drawing
sub CmBlitS:
  asm {
CmBlit:
    push ix
    push iy
    call CmSatOut
    call CmStars
    call CmRb
    pop iy
    pop ix
    ret
; the sprite table (17 bytes)
CmSatOut:
    ld hl,$1B00
    call CmWa
    ld hl,Sat
    ld b,17
CmSo1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    djnz CmSo1
    ret
; hl = VRAM address to write
CmWa:
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ret
; star patterns (codes 1-4 of the three thirds): dots, or wind streaks that
; move every 4 frames during a gust
CmStars:
    ld a,(WdS)
    cp 2
    ld a,0
    jr nz,CmSt1
    ld a,(Tick)
    rrca
    rrca
    and 3
    inc a
CmSt1:
    ld hl,StarNow
    cp (hl)
    ret z
    ld (hl),a
    ld hl,StarPat
    or a
    jr z,CmSt2
    dec a
    add a,a
    add a,a
    add a,a
    add a,a
    add a,a
    ld e,a
    ld d,0
    ld hl,StreakPat
    add hl,de
CmSt2:
    ld de,8
    call CmCp32
    ld de,$0808
    call CmCp32
    ld de,$1008
    jp CmCp32
; 32 bytes from hl to VRAM de (hl kept)
CmCp32:
    push hl
    ex de,hl
    call CmWa
    pop hl
    push hl
    ld b,32
CmCp1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    djnz CmCp1
    pop hl
    ret
; ---- the comet: one phase a frame, 7 phases (a new picture every 7 frames) ----
; 0: flip (show the buffer just drawn), clear the other's patterns
; 1: the 16 vertices (angle DrawA), restore the painted colours
; 2, 3: edges 0-5, 6-11; 4: edges 12-15, crater 0; 5: craters 1-2, vents;
; 6: crystals
CmRb:
    ld a,(RbPh)
    inc a
    cp 7
    jr c,CmRb0
    xor a
CmRb0:
    ld (RbPh),a
    or a
    jr z,CmP0
    dec a
    jr z,CmP1
    dec a
    jr z,CmP2
    dec a
    jr z,CmP2
    dec a
    jr z,CmP4
    dec a
    jp nz,CmGems
    ld hl,CrRec + 3
    ld b,2
    call CmCratersB
    jp CmVents
CmP0:
    call CmFlip
    ld a,(RbBase)
    ld h,a
    ld l,0
    ld e,0
    jp CmFill512
CmP1:
    ld hl,(AngF)
    ld a,h
    ld (DrawA),a
    call CmVerts
    xor a
    ld (CmK),a
    jp CmUnpaint
CmP2:
    ld b,6
    jp CmEdgesB
CmP4:
    ld b,4
    call CmEdgesB
    ld hl,CrRec
    ld b,1
    jp CmCratersB
; names of the comet block (columns 12-19, rows 8-15) -> the hidden buffer,
; then it becomes the shown one
CmFlip:
    ld a,(RbBuf)
    rrca
    rrca
    or 128
    ld e,a
    ld hl,$1800 + 8 * 32 + 12
    ld d,8
CmFl1:
    call CmWa
    ld b,8
CmFl2:
    ld a,e
    out (VDP_DATA_PORT),a
    inc e
    djnz CmFl2
    ld bc,32
    add hl,bc
    dec d
    jr nz,CmFl1
    ld a,(DrawA)
    ld (ShownA),a
    ld a,(RbBuf)
    xor 1
    ld (RbBuf),a
    add a,a
    add a,$0C
    ld (RbBase),a
    add a,$20
    ld (RbCBase),a
    ret
; 512 bytes of e at VRAM hl (32 cycles a byte: safe with the display on)
CmFill512:
    call CmWa
    ld d,2
    ld b,0
CmFi1:
    ld a,e
    out (VDP_DATA_PORT),a
    nop
    djnz CmFi1
    dec d
    jr nz,CmFi1
    ret
; the 16 vertices: VxX/VxY = 32 + r (cos, sin)(DrawA + VxA[k])
CmVerts:
    ld b,16
    ld hl,0
CmVx1:
    push bc
    push hl
    ld bc,VxR
    add hl,bc
    ld c,(hl)
    pop hl
    push hl
    ld de,VxA
    add hl,de
    ld a,(DrawA)
    add a,(hl)
    call CmPol
    pop hl
    push hl
    ld bc,VxX
    add hl,bc
    ld a,d
    add a,32
    ld (hl),a
    pop hl
    push hl
    ld bc,VxY
    add hl,bc
    ld a,e
    add a,32
    ld (hl),a
    pop hl
    inc hl
    pop bc
    djnz CmVx1
    ret
; 8 edges from CmK: vertex k to vertex k + 1 (mod 16)
CmEdgesB:
CmEd1:
    push bc
    ld a,(CmK)
    ld c,a
    ld b,0
    ld hl,VxX
    add hl,bc
    ld a,(hl)
    ld (LnX0),a
    ld hl,VxY
    add hl,bc
    ld a,(hl)
    ld (LnY0),a
    ld a,c
    inc a
    and 15
    ld (CmK),a
    ld c,a
    ld hl,VxX
    add hl,bc
    ld a,(hl)
    ld (LnX1),a
    ld hl,VxY
    add hl,bc
    ld a,(hl)
    ld (LnY1),a
    call CmLine
    pop bc
    djnz CmEd1
    ret
; Bresenham line (LnX0, LnY0) -> (LnX1, LnY1) in the hidden buffer.
; hl = the byte under the pen, b = the pen's bit, c = bits of that byte
; drawn so far; a byte is written (read-modify-write) when the pen leaves it.
CmLine:
    ld a,(LnX0)
    ld d,a
    ld a,(LnY0)
    ld e,a
    call CmAddr
    ld a,(RbBase)
    add a,h
    ld h,a
    ld a,e
    and 7
    ld (LnYb),a
    ld a,d
    and 7
    push hl
    ld c,a
    ld b,0
    ld hl,BitT
    add hl,bc
    ld b,(hl)
    pop hl
    ld c,0
    ld a,2
    ld (LnFirst),a
    ld a,(LnX1)
    sub d
    ld d,1
    jr nc,CmLn1
    neg
    ld d,255
CmLn1:
    ld (LnDx),a
    neg
    ld (LnNDx),a
    ld a,d
    ld (LnSx),a
    ld a,(LnY1)
    sub e
    ld e,1
    jr nc,CmLn2
    neg
    ld e,255
CmLn2:
    ld (LnDy),a
    neg
    ld (LnNDy),a
    ld a,e
    ld (LnSy),a
    ld a,(LnDy)
    ld e,a
    ld a,(LnDx)
    cp e
    jp c,CmLnY
    ; x-major: e = pixels left, d = (256 - dx) + dx / 2 + dy per step; a
    ; carry is a y step (then + 256 - dx)
    ld e,a
    srl a
    ld d,a
    ld a,(LnNDx)
    add a,d
    ld d,a
    ld a,(LnSx)
    dec a
    jr nz,CmLxL
CmLxR:
    ld a,c
    or b
    ld c,a
    ld a,e
    or a
    jp z,CmWr
    dec e
    rrc b
    jr nc,CmLxR1
    call CmWrQ
    ld a,l
    add a,8
    ld l,a
    jr nc,CmLxR1
    inc h
CmLxR1:
    ld a,(LnDy)
    add a,d
    jr nc,CmLxR2
    ld d,a
    ld a,(LnNDx)
    add a,d
    ld d,a
    call CmYStep
    jr CmLxR
CmLxR2:
    ld d,a
    jr CmLxR
CmLxL:
    ld a,c
    or b
    ld c,a
    ld a,e
    or a
    jp z,CmWr
    dec e
    rlc b
    jr nc,CmLxL1
    call CmWrQ
    ld a,l
    sub 8
    ld l,a
    jr nc,CmLxL1
    dec h
CmLxL1:
    ld a,(LnDy)
    add a,d
    jr nc,CmLxL2
    ld d,a
    ld a,(LnNDx)
    add a,d
    ld d,a
    call CmYStep
    jr CmLxL
CmLxL2:
    ld d,a
    jr CmLxL
    ; y-major: e = pixels left, d = error; every step writes the byte
CmLnY:
    ld a,e
    srl a
    ld d,a
    ld a,(LnNDy)
    add a,d
    ld d,a
CmLy1:
    ld a,c
    or b
    ld c,a
    ld a,e
    or a
    jp z,CmWr
    dec e
    call CmYStep
    ld a,(LnDx)
    add a,d
    jr nc,CmLy2
    ld d,a
    ld a,(LnNDy)
    add a,d
    ld d,a
    ; x step: the byte was just written (c = 0), so only move
    ld a,(LnSx)
    dec a
    jr nz,CmLy3
    rrc b
    jr nc,CmLy1
    ld a,l
    add a,8
    ld l,a
    jr nc,CmLy1
    inc h
    jr CmLy1
CmLy3:
    rlc b
    jr nc,CmLy1
    ld a,l
    sub 8
    ld l,a
    jr nc,CmLy1
    dec h
    jr CmLy1
CmLy2:
    ld d,a
    jr CmLy1
; one pixel along y: write the byte, move +-1 in a tile, +-57 across tiles
; (y & 7 = the address's low 3 bits: the buffers are 8-aligned)
CmYStep:
    call CmWrQ
    ld a,(LnSy)
    dec a
    ld a,l
    jr nz,CmYs2
    and 7
    cp 7
    jr z,CmYs1
    inc hl
    ret
CmYs1:
    ld a,l
    add a,57
    ld l,a
    ret nc
    inc h
    ret
CmYs2:
    and 7
    jr z,CmYs3
    dec hl
    ret
CmYs3:
    ld a,l
    sub 57
    ld l,a
    ret nc
    dec h
    ret
; write c at hl: a plain write in the middle of a line (only the first two
; and the last two writes of a line can share a byte with another line: those
; read-modify-write)
CmWrQ:
    ld a,(LnFirst)
    or a
    jr nz,CmWq1
    ld a,e
    cp 2
    jr c,CmWr
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld a,c
    out (VDP_DATA_PORT),a
    ld c,0
    ret
CmWq1:
    dec a
    ld (LnFirst),a
    jr CmWr
; OR c into the VRAM byte at hl (read-modify-write), c = 0
CmWr:
    ld a,c
    or a
    ret z
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    out (VDP_CTRL_PORT),a
    nop                 ; paced: >= 29 T from the address set-up to the IN
    nop                 ; (mid-screen the read-ahead waits up to 26 T for a
    nop                 ; slot); was ex (sp),hl x2, which the r11 optimizer
    nop                 ; deletes: plain NOPs are kept
    in a,(VDP_DATA_PORT)
    or c
    ld c,a
    ld a,l
    out (VDP_CTRL_PORT),a
    ld a,h
    or $40
    out (VDP_CTRL_PORT),a
    ld a,c
    out (VDP_DATA_PORT),a
    ld c,0
    ret
; b craters from record hl: r, angle, ring (0 small, 1 big)
CmCratersB:
CmCr1:
    push bc
    ld c,(hl)
    inc hl
    ld a,(DrawA)
    add a,(hl)
    inc hl
    ld e,(hl)
    inc hl
    push hl
    push de
    call CmPolXY
    pop de
    ld a,e
    add a,a
    ld e,a
    ld d,0
    ld hl,ShRing
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ex de,hl
    call CmBlot
    pop hl
    pop bc
    djnz CmCr1
    ret
; shape hl (x origin, y origin, rows, row masks) at (CmX, CmY): each row is
; shifted to the pixel and ORed into one or two bytes (address stepped)
CmBlot:
    ld a,(CmX)
    sub (hl)
    ld d,a
    inc hl
    ld a,(CmY)
    sub (hl)
    ld e,a
    inc hl
    ld a,(hl)
    ld (CmRows),a
    inc hl
    push hl
    call CmAddr
    ld a,(RbBase)
    add a,h
    ld h,a
    ld a,e
    and 7
    ld (LnYb),a
    ld a,d
    and 7
    ld (CmSh),a
    ld a,1
    ld (LnSy),a
    pop de
CmBl1:
    ld a,(de)
    inc de
    push de
    ld c,0
    ld d,a
    ld a,(CmSh)
    or a
    jr z,CmBl3
    ld b,a
    ld a,d
CmBl2:
    srl a
    rr c
    djnz CmBl2
    ld d,a
CmBl3:
    ld e,c
    ld c,d
    call CmWr
    ld a,e
    or a
    jr z,CmBl4
    ld c,a
    ld de,8
    add hl,de
    call CmWr
    ld de,-8
    add hl,de
CmBl4:
    ld a,(LnYb)
    inc a
    and 7
    ld (LnYb),a
    jr z,CmBl5
    inc hl
    jr CmBl6
CmBl5:
    ld de,57
    add hl,de
CmBl6:
    pop de
    ld a,(CmRows)
    dec a
    ld (CmRows),a
    jr nz,CmBl1
    ret
; the vents (NVent): a ring, light blue; white while blinking (1.9 Hz) or
; jetting
CmVents:
    ld a,(NVent)
    ld b,a
    ld c,0
CmVe1:
    push bc
    ld b,0
    ld hl,VtS
    add hl,bc
    ld a,(hl)
    ld e,$51
    cp 2
    jr z,CmVe3
    cp 1
    jr nz,CmVe2
    ld a,(Tick)
    and 16
    jr z,CmVe2
CmVe3:
    ld e,$F1
CmVe2:
    ld a,e
    ld (CmCol),a
    ld hl,VtA
    add hl,bc
    ld a,(DrawA)
    add a,(hl)
    ld hl,VtR
    add hl,bc
    ld c,(hl)
    call CmPolXY
    ld hl,ShVent
    call CmBlot
    call CmPaint
    pop bc
    inc c
    djnz CmVe1
    ret
; a = angle, c = radius -> CmX, CmY (local)
CmPolXY:
    call CmPol
    ld a,d
    add a,32
    ld (CmX),a
    ld a,e
    add a,32
    ld (CmY),a
    ret
; the crystals: a diamond (a cross 16 frames in 32: 1.9 Hz sparkle, each
; crystal on its own phase), a star while mined; pink ($D1)
CmGems:
    ld c,0
CmGe1:
    ld b,0
    ld hl,CrS
    add hl,bc
    ld a,(hl)
    or a
    jr z,CmGe9
    push bc
    ld de,ShBurst
    cp 1
    jr nz,CmGe2
    ld de,ShGem
    ld a,c
    add a,a
    add a,a
    add a,c
    add a,a
    add a,a
    ld b,a
    ld a,(Tick)
    add a,a
    add a,a
    add a,b
    and 64
    jr z,CmGe2
    ld de,ShSpk
CmGe2:
    push de
    ld b,0
    ld hl,CrJ
    add hl,bc
    ld c,(hl)
    ld hl,CsA
    add hl,bc
    ld a,(DrawA)
    add a,(hl)
    ld hl,CsR
    add hl,bc
    ld c,(hl)
    call CmPolXY
    pop hl
    call CmBlot
    ld a,$D1
    ld (CmCol),a
    call CmPaint
    pop bc
CmGe9:
    inc c
    ld a,c
    cp 3
    jr nz,CmGe1
    ret
; colour CmCol on the 5 x 5 around (CmX, CmY) (rows y-2..y+2, the tile
; columns of x-2 and x+2); logged for CmUnpaint (6 entries a buffer)
CmPaint:
    ld a,(RbBuf)
    ld c,a
    ld b,0
    ld hl,PgN
    add hl,bc
    ld a,(hl)
    cp 6
    jr nc,CmPaintNL
    inc (hl)
    add a,a
    ld e,a
    ld a,c
    add a,a
    add a,a
    add a,c
    add a,c
    add a,a
    add a,e
    ld e,a
    ld d,0
    ld hl,PgLog
    add hl,de
    ld a,(CmX)
    ld (hl),a
    inc hl
    ld a,(CmY)
    ld (hl),a
; the same without the log: 5 rows, the tile columns of x - 2 and x + 2
CmPaintNL:
    ld a,(CmX)
    sub 2
    ld d,a
    ld a,(CmY)
    sub 2
    ld e,a
    call CmAddr
    ld a,(RbCBase)
    add a,h
    ld h,a
    ld a,e
    and 7
    ld (LnYb),a
    ld a,(CmX)
    add a,2
    xor d
    and $38
    ld (CmSh),a
    ld b,5
CmPn1:
    call CmWa
    ld a,(CmCol)
    out (VDP_DATA_PORT),a
    ld a,(CmSh)
    or a
    jr z,CmPn2
    push hl
    ld de,8
    add hl,de
    call CmWa
    ld a,(CmCol)
    out (VDP_DATA_PORT),a
    pop hl
CmPn2:
    ld a,(LnYb)
    inc a
    and 7
    ld (LnYb),a
    jr z,CmPn3
    inc hl
    jr CmPn4
CmPn3:
    ld de,57
    add hl,de
CmPn4:
    djnz CmPn1
    ret
; the hidden buffer's logged spans back to grey ($E1)
CmUnpaint:
    ld a,(RbBuf)
    ld c,a
    ld b,0
    ld hl,PgN
    add hl,bc
    ld a,(hl)
    ld (hl),0
    or a
    ret z
    ld b,a
    ld a,c
    add a,a
    add a,a
    add a,c
    add a,c
    add a,a
    ld e,a
    ld d,0
    ld hl,PgLog
    add hl,de
    ld a,$E1
    ld (CmCol),a
CmUp1:
    push bc
    ld a,(hl)
    ld (CmX),a
    inc hl
    ld a,(hl)
    ld (CmY),a
    inc hl
    push hl
    call CmPaintNL
    pop hl
    pop bc
    djnz CmUp1
    ret
; pixel (d, e) 0..63 -> hl = offset in a buffer ((y & 56) * 8 + (x & 56) + (y & 7))
CmAddr:
    ld a,e
    and $38
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    and 7
    ld c,a
    ld a,d
    and $38
    or c
    or l
    ld l,a
    ret
  }
end sub

' screens: icons and star patterns in every third, star names, the logo
sub CmScreenS:
  asm {
CmIcons:
    ld de,IcVram
    call CmIc1
    ld de,IcVram + $0800
    call CmIc1
    ld de,IcVram + $1000
CmIc1:
    push de
    ld hl,IconPat
    ld bc,IconBytes
    call CmCopyV
    pop de
    push de
    ld hl,$2000
    add hl,de
    ex de,hl
    ld hl,IconCol
    ld bc,IconBytes
    call CmCopyV
    pop de
    ; star colours at codes 1-4 of the same third
    ld hl,$2000 + 8 - IcVram
    add hl,de
    ex de,hl
    ld hl,StarCol
    ld bc,32
    call CmCopyV
    ret
; bc bytes from hl to VRAM de (display off or blank: no spacing needed,
; but spaced anyway)
CmCopyV:
    push hl
    ex de,hl
    call CmWa
    pop hl
CmCv1:
    ld a,(hl)
    out (VDP_DATA_PORT),a
    inc hl
    dec bc
    ld a,b
    or c
    jr nz,CmCv1
    ret
; star names from StarPos (NStars words, then NStars codes)
CmStarsNames:
    ld a,255
    ld (StarNow),a
    ld hl,StarPos
    ld de,StarCode
    ld b,NStars
CmSn1:
    push bc
    ld c,(hl)
    inc hl
    ld a,(hl)
    inc hl
    push hl
    add a,$18
    ld h,a
    ld l,c
    call CmWa
    ld a,(de)
    out (VDP_DATA_PORT),a
    inc de
    pop hl
    pop bc
    djnz CmSn1
    ld hl,StarPat
    ld de,8
    call CmCp32
    ld de,$0808
    call CmCp32
    ld de,$1008
    jp CmCp32
; play screen VRAM: both comet buffers cleared (patterns 0, colours $E1),
; the comet block names on buffer A
CmPlayVram:
    ld hl,$0C00
    ld e,0
    call CmFill512
    ld hl,$0E00
    ld e,0
    call CmFill512
    ld hl,$2C00
    ld e,$E1
    call CmFill512
    ld hl,$2E00
    ld e,$E1
    call CmFill512
    xor a
    ld (RbBuf),a
    jp CmFlip
; the logo: LogoRec (col, row, kind) records, 255 ends
CmLogo:
    ld hl,LogoRec
CmLg1:
    ld a,(hl)
    cp 255
    ret z
    ld e,a
    inc hl
    ld a,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ; name address $1800 + row * 32 + col
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    or e
    ld l,a
    ld a,h
    add a,$18
    ld h,a
    call CmWa
    ld a,d
    add a,TBlock
    out (VDP_DATA_PORT),a
    pop hl
    jr CmLg1
  }
end sub

asm {
; PcSpr: Amy's "update sprites" (AMY_UPDATE_SPRITES, sprite flicker off),
; paced: >= 29 T between VRAM writes (TMS9928A mid-screen access slots; the
; runtime's loop writes 18 T apart). (vdp-safe pass, 2026-11-15)
PcSpr:
    ld a,(AMY_SPRITE_COUNT)
    ld e,a
    xor a
    out ($BF),a
    ld a,$5B
    out ($BF),a
    ld a,e
    or a
    jr z,PcSpr2
    push bc
    ld c,$BE
    ld hl,AMY_SPRITE_TABLE
PcSpr1:
    outi
    nop
    nop
    nop
    outi
    nop
    nop
    nop
    outi
    ld a,(hl)
    and $8F
    out (c),a
    inc hl
    dec e
    jr nz,PcSpr1
    pop bc
PcSpr2:
    ld a,$D0
    out ($BE),a
    ret
CmBoom:
    db $00,$00,$04,$03,$00,$00,$15,$04,$00,$00,$26,$06,$00,$00,$46,$08,$00,$00,$56,$0A,$00,$00,$76,$0A
    db $10
CmLaunch:
    db $00,$00,$15,$01,$00,$00,$36,$02,$00,$00,$56,$03,$10
CmJet:
    db $00,$00,$37,$04,$00,$00,$47,$08,$00,$00,$57,$0A,$00,$00,$77,$0A,$10
CmGust:
    db $00,$00,$77,$06,$00,$00,$67,$0A,$00,$00,$57,$0E,$00,$00,$67,$0E,$00,$00,$87,$0C,$10
CmBeam:
    db $40,$BA,$30,$01,$40,$8C,$30,$01,$40,$70,$30,$01,$40,$59,$30,$01,$40,$4B,$40,$01,$40,$3E,$40,$01
    db $40,$35,$60,$02,$50
CmMiss:
    db $40,$53,$31,$03,$40,$AE,$41,$03,$40,$2F,$52,$04,$40,$BB,$62,$04,$50
CmGroan:
    db $40,$FF,$33,$0A,$40,$FF,$43,$0A,$40,$FF,$53,$0C,$40,$FF,$63,$0A,$50
CmClear:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$04,$40,$6B,$30,$0E,$40,$6B,$50,$08
    db $50
CmClick:
    db $40,$40,$30,$01,$50
CmMine:
    db $80,$47,$20,$02,$80,$35,$20,$02,$80,$2A,$20,$03,$80,$24,$30,$06,$80,$24,$60,$08,$90
CmHiss:
    db $80,$30,$50,$03,$80,$30,$F0,$04,$80,$30,$50,$03,$80,$30,$F0,$04,$80,$30,$50,$03,$90
CmWarn:
    db $80,$FE,$40,$08,$80,$CA,$40,$08,$80,$FE,$50,$08,$80,$CA,$50,$08,$90

CmSoundTable:
    dw CmTuneMel,$702B
    dw CmTuneHarm,$7035
    dw CmTuneBassVol,$703F
    dw CmTuneBassPitch,$7049
    dw CmBoom,$702B
    dw CmLaunch,$702B
    dw CmJet,$702B
    dw CmGust,$702B
    dw CmBeam,$7035
    dw CmMiss,$7035
    dw CmGroan,$7035
    dw CmClear,$7035
    dw CmClick,$7035
    dw CmMine,$703F
    dw CmHiss,$703F
    dw CmWarn,$703F
; Perigee (COMET MINER, original) - Tiny Sound tone 1/2 + OS7 noise bass/drums (kit/music/tinybass.py)
CmTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$1A,$21,$1C,$01,$1F,$01,$23,$01,$28,$01,$26,$01,$23,$01
    db $21,$01,$23,$01,$1F,$01,$21,$01,$23,$01,$26,$01,$24,$01,$23,$01
    db $21,$01,$01,$01,$1C,$01,$1F,$01,$23,$01,$28,$01,$2A,$01,$2B,$01
    db $2A,$01,$26,$01,$28,$01,$26,$01,$23,$01,$21,$01,$23,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
CmTuneHarm:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$1A,$21,$17,$01,$01,$01,$13,$01,$01,$01,$12,$01,$01,$01
    db $1A,$01,$01,$01,$10,$01,$01,$01,$13,$01,$01,$01,$15,$01,$01,$01
    db $12,$01,$01,$01,$13,$01,$01,$01,$17,$01,$01,$01,$1A,$01,$01,$01
    db $15,$01,$01,$01,$17,$01,$01,$01,$13,$01,$01,$01,$12,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
CmTuneBassVol:
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$22,$02,$45,$05,$13,$11,$02,$33,$15,$14,$66,$22
    db $02,$36,$04,$13,$11,$02,$33,$16,$14,$66,$3E
    db $10
CmTuneBassPitch:
    db $C0,$88,$F0,$3C,$C0,$98,$F0,$1D,$C0,$B5,$F0,$1B,$C0,$AB,$F0,$1D,$C0,$88,$F0,$1B,$C0,$98,$F0,$38
    db $C0,$88,$F0,$1D,$C0,$72,$F0,$1B,$C0,$5A,$F0,$1D,$C0,$98,$F0,$1B,$C0,$AB,$F0,$1D,$C0,$CB,$F0,$1B
    db $C0,$B5,$F0,$16,$FE
    db $D0
}
