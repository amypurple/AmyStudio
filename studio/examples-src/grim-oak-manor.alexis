    db $40,$55,$20,$03,$40,$6B,$20,$03,$40,$55,$20,$03,$40,$6B,$20,$03,$40,$55,$20,$03,$40,$6B,$20,$03
    db $40,$55,$F0,$14,$50
GoScream:
    db $40,$40,$10,$03,$40,$47,$20,$03,$40,$50,$20,$03,$40,$5F,$30,$04,$40,$71,$40,$05,$40,$8F,$60,$08
    db $50

GoSoundTable:
    dw GoHush,$702B
    dw GoTick,$7035
    dw GoMore,$7035
    dw GoOk,$7035
    dw GoBack,$7035
    dw GoTreasure,$7035
    dw GoDie,$7035
    dw GoWin,$7035
    dw GoRing,$7035
    dw GoScream,$7035
    dw GoTuneMel,$703F
    dw GoTuneBass,$7049
; Grim Oak Waltz, A minor (original for this game)
; Tiny Sound, 14 frames per step
GoTuneMel:
    db $44
    dw sndtiny_1
    db 14
    db $02,$70,$F1,$22,$1C,$00,$1F,$23,$00,$21,$1F,$00,$1E,$1C,$00,$00
    db $1B,$00,$1E,$23,$00,$21,$1E,$00,$1B,$17,$00,$00,$1C,$00,$1F,$23
    db $00,$28,$26,$00,$24,$23,$00,$21,$1F,$00,$1E,$1B,$00,$1E,$1C,$00
    db $00,$00,$00,$00
    db $FF
GoTuneBass:
    db $84
    dw sndtiny_2
    db 14
    db $02,$80,$18,$32,$10,$17,$1C,$10,$17,$1C,$0B,$12,$17,$0B,$12,$17
    db $0B,$12,$17,$0B,$12,$17,$10,$17,$1C,$10,$17,$1C,$10,$17,$1C,$0C
    db $13,$18,$09,$10,$15,$06,$0C,$12,$0B,$12,$17,$0B,$0F,$12,$10,$17
    db $1C,$10,$01,$01
    db $FF
; engine.asm: the adventure engine (Z80), from The Hermit's, for Grim Oak
; Manor: ten exits a room, a dark-room table, a carry limit of five.
; - text: packed messages (advc.py), word wrap and scrolling in the text
;   window (rows 9-18, columns 2-29), a MORE pause read straight from the
;   controller ports;
; - world: object locations, containers, exits, darkness, score;
; - rules: runs the bytecode lists made by advc.py (conditions, actions);
; - menus: builds the noun list for the verb picked and draws the picker.
; Call every entry point with the NMI off.
; Locations: 0 nowhere, 1-56 rooms, 100 carried, 102-112 inside a
; container (index = code - 101), 113 out of reach (the vine).

V_Rm      equ AMY_UVAR_Rm
V_Verb    equ AMY_UVAR_Verb
V_Noun    equ AMY_UVAR_Noun
V_Noun2   equ AMY_UVAR_Noun2
V_Score   equ AMY_UVAR_Score
V_Scene   equ AMY_UVAR_Scene
V_Dark    equ AMY_UVAR_Dark
V_Moves   equ AMY_UVAR_Moves
V_NCount  equ AMY_UVAR_NCount
V_Need    equ AMY_UVAR_NeedNoun
V_PkV     equ AMY_UVAR_PkV
V_PkN     equ AMY_UVAR_PkN
V_PkCol   equ AMY_UVAR_PkCol
V_PkMode  equ AMY_UVAR_PkMode
V_InMore  equ AMY_UVAR_InMore
V_OL      equ AMY_UVAR_OL
V_Fl      equ AMY_UVAR_Fl
V_Opn     equ AMY_UVAR_Opn
V_Pt      equ AMY_UVAR_Pt
V_NL      equ AMY_UVAR_NL
V_WBuf    equ AMY_UVAR_WBuf
V_RowBuf  equ AMY_UVAR_RowBuf
V_TxStk   equ AMY_UVAR_TxStk
V_TxPtr   equ AMY_UVAR_TxPtr
V_TxDepth equ AMY_UVAR_TxDepth
V_TCol    equ AMY_UVAR_TCol
V_TPend   equ AMY_UVAR_TPend
V_TWLen   equ AMY_UVAR_TWLen
V_TAlt    equ AMY_UVAR_TAlt
V_TLines  equ AMY_UVAR_TLines
V_StopF   equ AMY_UVAR_StopF
V_ContF   equ AMY_UVAR_ContF
V_Neg     equ AMY_UVAR_Neg
V_RootOp  equ AMY_UVAR_RootOp
V_T1      equ AMY_UVAR_T1
V_T2      equ AMY_UVAR_T2
V_T3      equ AMY_UVAR_T3
V_T4      equ AMY_UVAR_T4
V_NStart  equ AMY_UVAR_NStart
V_SaveN   equ AMY_UVAR_SaveN

HE_NAME   equ $1800
HE_PAT    equ $0000
HE_COL    equ $2000
HE_CARRIED equ 100
HE_LANTERN equ 1
HE_MAXCARRY equ 5
HE_DIVIDER equ 96
HE_DARKSCENE equ 255

; ---------------------------------------------------------------------------
; Small helpers

; OLAddr: A = object -> HL = its location byte
OLAddr:
    ld e,a
    ld d,0
    ld hl,V_OL
    add hl,de
    ret

; FlAddr: A = flag -> HL
FlAddr:
    ld e,a
    ld d,0
    ld hl,V_Fl
    add hl,de
    ret

; ObjEnt: A = object or word -> HL = its 6-byte entry
ObjEnt:
    ld l,a
    ld h,0
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,de
    ld de,HeObjs
    add hl,de
    ret

; ContIdx: A = object -> A = container index (0 = not a container)
ContIdx:
    cp HE_NOBJ+1
    jr nc,CiNone
    call ObjEnt
    ld de,5
    add hl,de
    ld a,(hl)
    ret
CiNone:
    xor a
    ret

; ResObj: operand 255 = the noun, 254 = the second noun
ResObj:
    cp 255
    jr nz,RoTwo
    ld a,(V_Noun)
    ret
RoTwo:
    cp 254
    ret nz
    ld a,(V_Noun2)
    ret

; ResLoc: operand 250 = the player's room
ResLoc:
    cp 250
    ret nz
    ld a,(V_Rm)
    ret

; Root: A = object -> A = room it is in, 100 when carried, 0 when nowhere
; or out of sight. V_RootOp = 1: a closed container hides what is inside.
Root:
    ld b,8
RtLp:
    call OLAddr
    ld a,(hl)
    cp 101
    ret c
    cp 113
    jr nc,RtNone
    sub 101
    ld c,a
    ld a,(V_RootOp)
    or a
    jr z,RtGo
    ld e,c
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld a,(hl)
    or a
    jr z,RtNone
RtGo:
    ld e,c
    ld d,0
    ld hl,HeContObj
    add hl,de
    ld a,(hl)
    djnz RtLp
RtNone:
    xor a
    ret

; Visible: A = object -> A = 1 when the player can see it
Visible:
    ld (V_T1),a
    ld a,1
    ld (V_RootOp),a
    ld a,(V_T1)
    call Root
    cp HE_CARRIED
    jr z,VsYes
    ld c,a
    ld a,(V_Dark)
    or a
    jr nz,VsNo
    ld a,(V_Rm)
    cp c
    jr z,VsYes
    ld hl,HeScenery
VsSc:
    ld a,(hl)
    or a
    jr z,VsNo
    ld c,a
    inc hl
    ld b,(hl)
    inc hl
    ld a,(V_T1)
    cp c
    jr nz,VsSc
    ld a,(V_Rm)
    cp b
    jr nz,VsSc
VsYes:
    ld a,1
    ret
VsNo:
    xor a
    ret

; Have: A = object -> A = 1 when carried (even inside a closed container)
Have:
    ld c,a
    xor a
    ld (V_RootOp),a
    ld a,c
    call Root
    cp HE_CARRIED
    ld a,1
    ret z
    xor a
    ret

; Reach: A = object -> A = 1 when in hand or in an open container in hand
Reach:
    ld c,a
    ld a,1
    ld (V_RootOp),a
    ld a,c
    call Root
    cp HE_CARRIED
    ld a,1
    ret z
    xor a
    ret

; HasLight: A = 1 when the lit lantern is carried
HasLight:
    ld a,HF_LT
    call FlAddr
    ld a,(hl)
    or a
    ret z
    ld a,HE_LANTERN
    jp Have

; UpdDark: the rooms of HeDarkRooms are dark without the flashlight on
UpdDark:
    xor a
    ld (V_Dark),a
    ld hl,HeDarkRooms
UdLp:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld c,a
    ld a,(V_Rm)
    cp c
    jr nz,UdLp
UdChk:
    call HasLight
    or a
    ret nz
    ld a,1
    ld (V_Dark),a
    ret

; RoomEnt: HL = the entry (13 bytes) of the player's room
RoomEnt:
    ld a,(V_Rm)
    ld l,a
    ld h,0
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    push hl
    add hl,hl
    pop bc
    add hl,bc
    add hl,de
    ld de,HeRooms
    add hl,de
    ret

; GetExit: A = direction 0-9 -> A = room it leads to (0 = none)
GetExit:
    ld (V_T2),a
    ld hl,HePatchWhere
    ld b,HE_NPATCH
    ld c,0
GxLp:
    ld a,(V_Rm)
    cp (hl)
    inc hl
    jr nz,GxNext
    ld a,(V_T2)
    cp (hl)
    jr nz,GxNext
    ld e,c
    ld d,0
    ld hl,V_Pt
    add hl,de
    ld a,(hl)
    ret
GxNext:
    inc hl
    inc c
    djnz GxLp
    call RoomEnt
    ld a,(V_T2)
    ld e,a
    ld d,0
    add hl,de
    ld a,(hl)
    ret

; CalcScore: Score = points earned
CalcScore:
    ld a,HF_SC
    call FlAddr
    ld a,(hl)
    ld (V_Score),a
    ret

; SetScene: the picture for the room (255 = darkness)
SetScene:
    ld a,(V_Dark)
    or a
    ld a,HE_DARKSCENE
    jr nz,SsSet
    call RoomEnt
    ld de,12
    add hl,de
    ld a,(hl)
    ld (V_Scene),a
    ld hl,HeSceneIf
SsIf:
    ld a,(hl)
    or a
    ret z
    ld b,a
    inc hl
    ld a,(V_Rm)
    cp b
    jr nz,SsSkip3
    ld a,(hl)
    inc hl
    push hl
    call OLAddr
    ld a,(hl)
    pop hl
    cp (hl)
    inc hl
    jr nz,SsSkip1
    ld a,(hl)
SsSet:
    ld (V_Scene),a
    ret
SsSkip3:
    inc hl
SsSkip2:
    inc hl
SsSkip1:
    inc hl
    jr SsIf

; ---------------------------------------------------------------------------
; VDP

; VSetW / VSetR: HL = VRAM address to write / read
VSetW:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    or $40
    out ($BF),a
    ret
VSetR:
    ld a,l
    out ($BF),a
    ld a,h
    and $3F
    out ($BF),a
    ret

; RowCol: D = row, E = column -> HL = name table address
RowCol:
    ld l,d
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    add a,l
    ld l,a
    ld a,h
    adc a,HE_NAME/256
    ld h,a
    ret

; AltMap: A = character -> A = code in the current font (TAlt 0 white,
; 1 yellow, 2 black on yellow). Keeps BC, DE, HL.
AltMap:
    push bc
    ld c,a
    ld a,(V_TAlt)
    or a
    jr z,AmPlain
    dec a
    jr nz,AmInv
    ld a,c
    add a,128
    pop bc
    ret
AmInv:
    ld a,c
    cp 64
    jr nc,AmInvHi
    add a,96
    pop bc
    ret
AmInvHi:
    add a,160
    pop bc
    ret
AmPlain:
    ld a,c
    pop bc
    ret

; ---------------------------------------------------------------------------
; Text

; MsgStart: HL = message number
MsgStart:
    add hl,hl
    ld de,HeMsgTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld (V_TxPtr),hl
    xor a
    ld (V_TxDepth),a
    ret

; NextCh: A = next character of the message, 0 at its end
NextCh:
    ld hl,(V_TxPtr)
NcLp:
    ld a,(hl)
    inc hl
    or a
    jr z,NcEnd
    cp 32
    jr c,NcDict
    cp 96
    jr nc,NcHi
    ld (V_TxPtr),hl
    ret
NcHi:
    sub 65
    jr NcIdx
NcDict:
    dec a
NcIdx:
    ld c,a
    ex de,hl
    ld a,(V_TxDepth)
    ld l,a
    inc a
    ld (V_TxDepth),a
    ld h,0
    add hl,hl
    push bc
    ld bc,V_TxStk
    add hl,bc
    pop bc
    ld (hl),e
    inc hl
    ld (hl),d
    ld l,c
    ld h,0
    add hl,hl
    ld de,HeDict
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jr NcLp
NcEnd:
    ld a,(V_TxDepth)
    or a
    jr z,NcDone
    dec a
    ld (V_TxDepth),a
    ld l,a
    ld h,0
    add hl,hl
    ld de,V_TxStk
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jr NcLp
NcDone:
    ld (V_TxPtr),hl
    xor a
    ret

; PrintMsg: HL = message number, added to the text at the cursor
PrintMsg:
    call MsgStart
PmLp:
    call NextCh
    or a
    ret z
    call PutCh
    jr PmLp

; Say: HL = message number, as a new paragraph
Say:
    push hl
    call Para
    pop hl
    jr PrintMsg

; PutCh: A = character into the word buffer (a space ends the word)
PutCh:
    cp 32
    jr nz,PcWord
    call FlushWord
    ld a,(V_TCol)
    or a
    ret z
    ld a,1
    ld (V_TPend),a
    ret
PcWord:
    ld c,a
    ld a,(V_TWLen)
    cp 28
    jr c,PcAdd
    push bc
    call FlushWord
    pop bc
    ld a,(V_TWLen)
PcAdd:
    ld e,a
    ld d,0
    ld hl,V_WBuf
    add hl,de
    ld (hl),c
    inc a
    ld (V_TWLen),a
    ret

; FlushWord: write the buffered word on the bottom line, wrapping first
FlushWord:
    ld a,(V_TWLen)
    or a
    ret z
    ld b,a
    ld a,(V_TPend)
    add a,b
    ld b,a
    ld a,(V_TCol)
    add a,b
    cp 29
    jr c,FwFits
    call NewLine
FwFits:
    ld d,18
    ld a,(V_TCol)
    add a,2
    ld e,a
    call RowCol
    call VSetW
    ld a,(V_TPend)
    or a
    jr z,FwWord
    ld a,32
    out ($BE),a
    ld hl,V_TCol
    inc (hl)
FwWord:
    xor a
    ld (V_TPend),a
    ld a,(V_TWLen)
    ld b,a
    ld hl,V_WBuf
FwLp:
    ld a,(hl)
    call AltMap
    out ($BE),a
    inc hl
    djnz FwLp
    ld a,(V_TWLen)
    ld b,a
    ld a,(V_TCol)
    add a,b
    ld (V_TCol),a
    xor a
    ld (V_TWLen),a
    ret

; Para: start a new paragraph on a fresh line
Para:
    call FlushWord
    xor a
    ld (V_TPend),a
    ld a,(V_TCol)
    or a
    ret z
    ; fall into NewLine

; NewLine: scroll the window up one line (pausing when it is full)
NewLine:
    ld a,(V_TLines)
    cp 10
    call nc,SaveTop
    call ScrollUp
    xor a
    ld (V_TCol),a
    ld (V_TPend),a
    ld hl,V_TLines
    inc (hl)
    ret

; ScrollUp: rows 10-18 move to 9-17; row 18 is cleared
ScrollUp:
    ld d,10
SuLp:
    push de
    ld e,2
    call RowCol
    call VSetR
    ld hl,V_RowBuf
    ld b,28
SuRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz SuRd
    pop de
    push de
    dec d
    ld e,2
    call RowCol
    call VSetW
    ld hl,V_RowBuf
    ld b,28
SuWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz SuWr
    pop de
    inc d
    ld a,d
    cp 19
    jr c,SuLp
    ld d,18
    ld e,2
    call RowCol
    call VSetW
    ld b,28
SuClr:
    ld a,32
    out ($BE),a
    nop
    djnz SuClr
    ret

; ClearRows: D = first row, B = number of rows (columns 2-29)
ClearRows:
    push bc
    push de
    ld e,2
    call RowCol
    call VSetW
    ld b,28
CrLp:
    ld a,32
    out ($BE),a
    nop
    djnz CrLp
    pop de
    pop bc
    inc d
    djnz ClearRows
    ret

; More: the window is full; show MORE and wait for a side button
; SaveTop: the window is full: the top line goes to the history in VRAM
; ($3A80, 28 bytes a line) before it scrolls away. After the turn, Amy
; pages through it (MORE) when the turn wrote more than the window holds.
HE_HIST equ $3A80
HE_HISTMAX equ 40
SaveTop:
    ld a,(AMY_UVAR_HistN)
    cp HE_HISTMAX
    ret nc
    ld d,9
    jp HistPut

; HistPut: row D of the window -> history line HistN, HistN + 1
HistPut:
    ld e,2
    call RowCol
    call VSetR
    ld hl,V_RowBuf
    ld b,28
HpRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HpRd
    ld a,(AMY_UVAR_HistN)
    call HistAddr
    call VSetW
    ld hl,V_RowBuf
    ld b,28
HpWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HpWr
    ld hl,AMY_UVAR_HistN
    inc (hl)
    ret

; HistAddr: A = history line -> HL = its VRAM address
HistAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    ld e,l
    ld d,h
    add hl,hl
    add hl,hl
    add hl,hl
    or a
    sbc hl,de
    ld de,HE_HIST
    add hl,de
    ret

; HeHistFinish: add the ten lines of the window to the history
HeHistFinish:
    ld d,9
HhfLp:
    push de
    call HistPut
    pop de
    inc d
    ld a,d
    cp 19
    jr c,HhfLp
    ret

; HeHistShow: history lines Pg .. Pg + 9 into the window
HeHistShow:
    ld d,9
HhsLp:
    push de
    ld a,d
    sub 9
    ld hl,AMY_UVAR_Pg
    add a,(hl)
    call HistAddr
    call VSetR
    ld hl,V_RowBuf
    ld b,28
HhsRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HhsRd
    pop de
    push de
    ld e,2
    call RowCol
    call VSetW
    ld hl,V_RowBuf
    ld b,28
HhsWr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HhsWr
    pop de
    inc d
    ld a,d
    cp 19
    jr c,HhsLp
    ret

; HeMoreMark: " - MORE - " on row 19
HeMoreMark:
    ld d,19
    ld e,11
    call RowCol
    call VSetW
    ld hl,HeMoreTxt
    ld b,10
MoLp:
    ld a,(hl)
    add a,128
    out ($BE),a
    inc hl
    djnz MoLp
    ret
HeMoreTxt:
    db " - MORE - "

; DrawDivider: the line on row 19
HeDrawDivider:
DrawDivider:
    ld d,19
    ld e,2
    call RowCol
    call VSetW
    ld b,28
DdLp:
    ld a,HE_DIVIDER
    out ($BE),a
    nop
    djnz DdLp
    ret

; PrintNum: HL = number (0-9999), into the text
PrintNum:
    xor a
    ld (V_NStart),a
    ld de,1000
    call PnDig
    ld de,100
    call PnDig
    ld de,10
    call PnDig
    ld a,l
    add a,48
    jp PutCh
PnDig:
    ld a,47
PnSub:
    inc a
    or a
    sbc hl,de
    jr nc,PnSub
    add hl,de
    cp 48
    jr nz,PnOut
    ld c,a
    ld a,(V_NStart)
    or a
    ret z
    ld a,c
PnOut:
    ld c,a
    ld a,1
    ld (V_NStart),a
    ld a,c
    push hl
    call PutCh
    pop hl
    ret

; PrintObj: A = object -> its menu name; PrintFull: its full name;
; PrintArt: "A ", "AN " or "SOME " and its full name
PrintObj:
    call ObjEnt
    jr PoMsg
PrintFull:
    call ObjEnt
    inc hl
    inc hl
PoMsg:
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    jp PrintMsg
PrintArt:
    push af
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    rrca
    rrca
    rrca
    and 3
    ld l,a
    ld h,0
    ld de,SysA
    add hl,de
    call PrintMsg
    pop af
    jr PrintFull

; ---------------------------------------------------------------------------
; Rules

; RunList: HL = rule list, A = 1 to run every rule that matches.
; Returns A = 1 when a rule ran.
RunList:
    ld c,a
    ld b,0
RlRule:
    ld a,(hl)
    or a
    jr z,RlEnd
    push bc
    ld e,a
    ld d,0
    inc hl
    push hl
    add hl,de
    ex (sp),hl
    call EvalConds
    or a
    jr z,RlSkip
    pop de
    push de
    xor a
    ld (V_ContF),a
    call ExecActs
    pop hl
    pop bc
    ld b,1
    ld a,(V_StopF)
    or a
    jr nz,RlEnd
    ld a,c
    or a
    jr nz,RlRule
    ld a,(V_ContF)
    or a
    jr nz,RlRule
RlEnd:
    ld a,b
    ret
RlSkip:
    pop hl
    pop bc
    jr RlRule

; EvalConds: HL = conditions -> A = 1 when all hold (HL = first action)
EvalConds:
    xor a
    ld (V_Neg),a
EcLp:
    ld a,(hl)
    cp $40
    jr nc,EcPass
    inc hl
    cp $0B
    jr nz,EcGo
    ld a,1
    ld (V_Neg),a
    jr EcLp
EcGo:
    dec a
    add a,a
    push hl
    ld l,a
    ld h,0
    ld de,EcTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ex (sp),hl
    ret
EcRes:
    ld c,a
    ld a,(V_Neg)
    xor c
    ld c,a
    xor a
    ld (V_Neg),a
    ld a,c
    or a
    jr nz,EcLp
    ret
EcPass:
    ld a,1
    ret

EcTab:
    dw CNoun, CNoun2, CRoom, CRoomIn, CHere, CHave, CAt, CFlag
    dw CFlagGe, COpen, EcPass, CLight, CScoreGe, EcPass, CNounIn

CmpRes:
    ld a,1
    jp z,EcRes
    xor a
    jp EcRes

CNoun:
    ld a,(V_Noun)
    cp (hl)
    inc hl
    jr CmpRes
CNoun2:
    ld a,(V_Noun2)
    cp (hl)
    inc hl
    jr CmpRes
CRoom:
    ld a,(V_Rm)
    cp (hl)
    inc hl
    jr CmpRes
CRoomIn:
    ld a,(V_Rm)
    ld c,a
    ld a,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld e,0
    cp c
    jr z,CriLo
    jr nc,CriNo
CriLo:
    ld a,b
    cp c
    jr c,CriNo
    ld e,1
CriNo:
    ld a,e
    jp EcRes
CHere:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call Visible
    pop hl
    jp EcRes
CHave:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call Have
    pop hl
    jp EcRes
CAt:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    push bc
    call ResObj
    call OLAddr
    pop bc
    ld a,c
    push hl
    call ResLoc
    pop hl
    cp (hl)
    pop hl
    jr CmpRes
CFlag:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    pop hl
    cp c
    jr CmpRes
CFlagGe:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    pop hl
    cp c
    ld a,0
    jp c,EcRes
    inc a
    jp EcRes
COpen:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call IsOpen
    pop hl
    jp EcRes
CLight:
    push hl
    call HasLight
    pop hl
    jp EcRes
CScoreGe:
    ld c,(hl)
    inc hl
    push hl
    push bc
    call CalcScore
    pop bc
    pop hl
    ld a,(V_Score)
    cp c
    ld a,0
    jp c,EcRes
    inc a
    jp EcRes
CNounIn:
    ld b,(hl)
    inc hl
    ld e,0
    ld a,(V_Noun)
CniLp:
    cp (hl)
    inc hl
    jr nz,CniNext
    ld e,1
CniNext:
    djnz CniLp
    ld a,e
    jp EcRes

; IsOpen: A = object -> A = 1 when it is an open container
IsOpen:
    call ContIdx
    or a
    ret z
    ld e,a
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld a,(hl)
    ret

; ExecActs: HL = first action, DE = end of the rule
ExecActs:
    ld a,l
    cp e
    jr nz,EaGo
    ld a,h
    cp d
    ret z
EaGo:
    push de
    ld a,(hl)
    inc hl
    sub $40
    add a,a
    push hl
    ld l,a
    ld h,0
    ld de,EaTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ex (sp),hl
    ret
EaNext:
    pop de
    ld a,(V_StopF)
    or a
    ret nz
    jr ExecActs

EaTab:
    dw AMsg, ASetL, ASetF, AAddF, AGoto, APatch, ASetOpen, ADie
    dw AWin, ALook, ACont, ABuiltin, AScore, AList, ASetNoun

AMsg:
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    push hl
    ex de,hl
    call Say
    pop hl
    jp EaNext
ASetL:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    push bc
    call ResObj
    call OLAddr
    pop bc
    ld a,c
    push hl
    call ResLoc
    pop hl
    ld (hl),a
    pop hl
    jp EaNext
ASetF:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld (hl),c
    pop hl
    jp EaNext
AAddF:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    call FlAddr
    ld a,(hl)
    add a,c
    ld (hl),a
    pop hl
    jp EaNext
AGoto:
    ld a,(hl)
    inc hl
    push hl
    ld (V_Rm),a
    call EnterRoom
    call DoLook
    pop hl
    jp EaNext
APatch:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    ld e,a
    ld d,0
    ld hl,V_Pt
    add hl,de
    ld (hl),c
    pop hl
    jp EaNext
ASetOpen:
    ld a,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    push bc
    call ResObj
    call ContIdx
    pop bc
    or a
    jr z,AsoDone
    ld e,a
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld (hl),c
AsoDone:
    pop hl
    jp EaNext
ADie:
    ld a,HF_DEAD
    jr AStop
AWin:
    ld a,HF_WIN
AStop:
    push hl
    call FlAddr
    ld (hl),1
    ld a,1
    ld (V_StopF),a
    pop hl
    jp EaNext
ALook:
    push hl
    call DoLook
    pop hl
    jp EaNext
ACont:
    ld a,1
    ld (V_ContF),a
    jp EaNext
ABuiltin:
    ld a,(hl)
    inc hl
    push hl
    add a,a
    ld l,a
    ld h,0
    ld de,BiTab
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,AbRet
    push de
    jp (hl)
AbRet:
    pop hl
    jp EaNext
AScore:
    ld c,(hl)
    inc hl
    push hl
    ld a,HF_SC
    call FlAddr
    ld a,(hl)
    add a,c
    ld (hl),a
    pop hl
    jp EaNext
AList:
    ld a,(hl)
    inc hl
    push hl
    call ResObj
    call ListIn
    pop hl
    jp EaNext
ASetNoun:
    ld a,(hl)
    inc hl
    ld (V_Noun),a
    jp EaNext

BiTab:
    dw BGo, BInv, BScore, BTake, BDrop, BExam, BOpen, BClose, BPut

; ---------------------------------------------------------------------------
; Built-in verbs

; EnterRoom: darkness changes with the room
EnterRoom:
    jp UpdDark

BGo:
    ld a,(V_Noun)
    sub 70
    call GetExit
    or a
    jr nz,BgMove
    ld hl,SysNoWay
    jp Say
BgMove:
    ld (V_Rm),a
    call EnterRoom
    jp DoLook

BInv:
    ld hl,SysCarrying
    call Say
    xor a
    ld (V_T3),a
    ld c,1
BiLp:
    push bc
    ld a,c
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BiNext
    call Para
    pop bc
    push bc
    ld a,c
    call PrintFull
    ld a,1
    ld (V_T3),a
BiNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,BiLp
    ; what is inside the open containers carried
    ld c,1
BiCl:
    push bc
    ld a,c
    ld (V_T4),a
    call Reach
    or a
    jr z,BiCn
    ld a,(V_T4)
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr z,BiCn
    call Para
    ld a,(V_T4)
    call PrintFull
    ld hl,SysInThe
    call PrintMsg
    ld a,(V_T4)
    call OLAddr
    ld a,(hl)
    sub 101
    ld e,a
    ld d,0
    ld hl,HeContObj
    add hl,de
    ld a,(hl)
    call PrintObj
    ld a,1
    ld (V_T3),a
BiCn:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,BiCl
    ld a,(V_T3)
    or a
    ret nz
    ld hl,SysNothing
    jp Say

BScore:
    call CalcScore
    ld hl,SysScore1
    call Say
    ld a,(V_Score)
    ld l,a
    ld h,0
    call PrintNum
    ld hl,SysScore2
    call PrintMsg
    ld hl,(V_Moves)
    call PrintNum
    ld hl,SysScore3
    call PrintMsg
    ld a,(V_Score)
    ld hl,SysRank0
    cp 10
    jr c,BsRank
    inc hl
    cp 30
    jr c,BsRank
    inc hl
    cp 55
    jr c,BsRank
    inc hl
    cp 80
    jr c,BsRank
    inc hl
    cp 100
    jr c,BsRank
    inc hl
BsRank:
    call PrintMsg
    ld hl,SysScore4
    jp PrintMsg

BTake:
    ld a,(V_Noun)
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BtNotYet
    ld hl,SysHaveIt
    jp Say
BtNotYet:
    ld a,(V_Noun)
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    and 3
    jr nz,BtSolid
    ld hl,SysFlows
    jp Say
BtSolid:
    cp 2
    jr nz,BtOk
    ld hl,SysStays
    jp Say
BtOk:
    ; the listing (line 800): five things at most in hand
    ld hl,V_OL+1
    ld b,HE_NOBJ
    ld c,0
BtCnt:
    ld a,(hl)
    cp HE_CARRIED
    jr nz,BtCn2
    inc c
BtCn2:
    inc hl
    djnz BtCnt
    ld a,c
    cp HE_MAXCARRY
    jr c,BtRoom
    ld hl,SysHeavy
    jp Say
BtRoom:
    ld a,(V_Noun)
    call OLAddr
    ld (hl),HE_CARRIED
    ld hl,SysTaken
    jp Say

BDrop:
    ld a,(V_Noun)
    call Have
    or a
    jr nz,BdOk
    ld hl,SysNoHave
    jp Say
BdOk:
    ld a,(V_Noun)
    call OLAddr
    ld a,(V_Rm)
    ld (hl),a
    ld hl,SysDropped
    jp Say

BExam:
    ld a,(V_Noun)
    call ContIdx
    or a
    jr nz,BeCont
    ld hl,SysNothingSpecial
    jp Say
BeCont:
    ld a,(V_Noun)
    call IsOpen
    or a
    jr nz,BeOpen
    ld hl,SysIsClosed
    jp Say
BeOpen:
    ld hl,SysIsOpen
    call Say
    ld a,(V_Noun)
    jp ListIn

BOpen:
    ld a,(V_Noun)
    call ContIdx
    or a
    jr nz,BoCont
    ld hl,SysCantOpen
    jp Say
BoCont:
    ld e,a
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld a,(hl)
    or a
    jr z,BoDo
    ld hl,SysAlreadyOpen
    jp Say
BoDo:
    ld (hl),1
    ld hl,SysOk
    call Say
    ld a,(V_Noun)
    jp ListIn

BClose:
    ld a,(V_Noun)
    call ContIdx
    or a
    jr nz,BcCont
    ld hl,SysCantClose
    jp Say
BcCont:
    ld e,a
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld a,(hl)
    or a
    jr nz,BcDo
    ld hl,SysAlreadyClosed
    jp Say
BcDo:
    ld (hl),0
    ld hl,SysOk
    jp Say

BPut:
    ld a,(V_Noun2)
    call ContIdx
    or a
    jr nz,BpCont
BpNo:
    ld hl,SysCantPut
    jp Say
BpCont:
    ld (V_T3),a
    ld a,(V_Noun)
    ld c,a
    ld a,(V_Noun2)
    cp c
    jr z,BpNo
    ld a,(V_Noun2)
    call IsOpen
    or a
    jr nz,BpOpen
    ld hl,SysClosed
    jp Say
BpOpen:
    ld a,(V_Noun)
    call Have
    or a
    jr nz,BpHave
    ld hl,SysNoHave
    jp Say
BpHave:
    ; a container may not go inside what it holds
    ld a,(V_Noun2)
    ld (V_T4),a
BpLoop:
    ld a,(V_T4)
    call OLAddr
    ld a,(hl)
    cp 102
    jr c,BpRoom
    cp 113
    jr nc,BpRoom
    sub 101
    ld e,a
    ld d,0
    ld hl,HeContObj
    add hl,de
    ld a,(hl)
    ld (V_T4),a
    ld c,a
    ld a,(V_Noun)
    cp c
    jr z,BpNo
    jr BpLoop
BpRoom:
    ; room left inside?
    ld a,(V_T3)
    ld e,a
    ld d,0
    ld hl,HeContCode
    add hl,de
    ld a,(hl)
    ld (V_T4),a
    ld hl,HeContCap
    add hl,de
    ld a,(hl)
    ld b,a
    ld c,1
BpCount:
    push bc
    ld a,c
    call OLAddr
    ld a,(V_T4)
    cp (hl)
    pop bc
    jr nz,BpCn
    dec b
    jr z,BpFull
BpCn:
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,BpCount
    ld a,(V_Noun)
    call OLAddr
    ld a,(V_T4)
    ld (hl),a
    ld hl,SysOk
    jp Say
BpFull:
    ld hl,SysFull
    jp Say

; ListIn: A = container -> "THERE IS A x IN THE y." for what it holds
ListIn:
    ld (V_T4),a
    call ContIdx
    or a
    ret z
    ld e,a
    ld d,0
    ld hl,V_Opn
    add hl,de
    ld a,(hl)
    or a
    ret z
    ld hl,HeContCode
    add hl,de
    ld a,(hl)
    ld (V_T3),a
    ld c,1
LiLp:
    push bc
    ld a,c
    call OLAddr
    ld a,(V_T3)
    cp (hl)
    jr nz,LiNext
    ld hl,SysThereIs
    call Say
    pop bc
    push bc
    ld a,c
    call PrintArt
    ld hl,SysInThe
    call PrintMsg
    ld a,(V_T4)
    call PrintObj
    ld a,46
    call PutCh
LiNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,LiLp
    ret

; DoLook: describe the room
DoLook:
    call UpdDark
    ld a,(V_Dark)
    or a
    jr z,LkLit
    ld hl,SysDark
    call Say
    jp LkExits
LkLit:
    ld hl,SysYouAre
    call Say
    call RoomEnt
    ld de,10
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call PrintMsg
LkRules:
    ld hl,HeR_LOOKX
    ld a,1
    call RunList
    ld c,1
LkObj:
    push bc
    ld a,c
    call OLAddr
    ld a,(V_Rm)
    cp (hl)
    jr nz,LkON
    ; things that stay put are part of the description (LOOKX)
    pop bc
    push bc
    ld a,c
    call ObjEnt
    ld de,4
    add hl,de
    ld a,(hl)
    and 3
    cp 2
    jr z,LkON
    ld hl,SysThereIs
    call Say
    pop bc
    push bc
    ld a,c
    call PrintArt
    ld hl,SysHere
    call PrintMsg
LkON:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,LkObj
    ld c,1
LkCont:
    push bc
    ld e,c
    ld d,0
    ld hl,HeContObj
    add hl,de
    ld a,(hl)
    ld (V_T2),a
    ld a,1
    ld (V_RootOp),a
    ld a,(V_T2)
    call Root
    ld hl,V_Rm
    cp (hl)
    jr nz,LkCN
    ld a,(V_T2)
    call ListIn
LkCN:
    pop bc
    inc c
    ld a,c
    cp HE_NCONT+1
    jr c,LkCont
LkExits:
    ld hl,SysExits
    call Say
    ld a,(V_Dark)
    or a
    jr z,LkEx2
    ld hl,SysWhoKnows
    jp PrintMsg
LkEx2:
    xor a
    ld (V_T3),a
    ld c,0
LkE:
    push bc
    ld a,c
    call GetExit
    or a
    jr z,LkEN
    ld a,32
    call PutCh
    pop bc
    push bc
    ld l,c
    ld h,0
    ld de,SysDir0
    add hl,de
    call PrintMsg
    ld a,1
    ld (V_T3),a
LkEN:
    pop bc
    inc c
    ld a,c
    cp 10
    jr c,LkE
    ld a,(V_T3)
    or a
    jr nz,LkDot
    ld hl,SysNoExits
    jp PrintMsg
LkDot:
    ld a,46
    jp PutCh

; ---------------------------------------------------------------------------
; Entry points (called from Amy)

; HeStart: a new game
HeStart:
    ld hl,HeObjStart
    ld de,V_OL
    ld bc,HE_NOBJ+1
    ldir
    ld hl,HeFlagStart
    ld de,V_Fl
    ld bc,HE_NFLAGS
    ldir
    ld hl,HeContOpen
    ld de,V_Opn
    ld bc,HE_NCONT+1
    ldir
    ld hl,V_Pt
    ld b,HE_NPATCH
    xor a
HsPt:
    ld (hl),a
    inc hl
    djnz HsPt
    ld (V_StopF),a
    ld (V_TCol),a
    ld (V_TPend),a
    ld (V_TWLen),a
    ld (V_TAlt),a
    ld (V_TLines),a
    ld (V_InMore),a
    ld hl,0
    ld (V_Moves),hl
    ld a,1
    ld (V_Rm),a
    ld d,9
    ld b,10
    call ClearRows
    call DrawDivider
    call DoLook
    call FlushWord
    call UpdDark
    call CalcScore
    jp SetScene

; HeTurn: run Verb / Noun / Noun2
HeTurn:
    xor a
    ld (AMY_UVAR_HistN),a
    ld (V_StopF),a
    ld (V_TLines),a
    call Echo
    ld hl,(V_Moves)
    inc hl
    ld (V_Moves),hl
    call UpdDark
    ld a,(V_Verb)
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbRules
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    call RunList
    ld a,(V_StopF)
    or a
    jr nz,HtEnd
    call UpdDark
    ld hl,HeR_EVERY
    ld a,1
    call RunList
HtEnd:
    call FlushWord
    call UpdDark
    call CalcScore
    jp SetScene

; HeSay: HL = message number as a paragraph (for Amy), then flush
HeSay:
    call Say
    jp FlushWord

; Echo: "> VERB NOUN [IN NOUN2]" in yellow
Echo:
    call Para
    ld a,1
    ld (V_TAlt),a
    ld hl,SysPrompt
    call PrintMsg
    ld a,(V_Verb)
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbMsg
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    call PrintMsg
    ld a,(V_Noun)
    or a
    jr z,EchoEnd
    ld a,32
    call PutCh
    ld a,(V_Noun)
    call PrintObj
    ld a,(V_Noun2)
    or a
    jr z,EchoEnd
    ld hl,SysIn
    call PrintMsg
    ld a,(V_Noun2)
    call PrintObj
EchoEnd:
    call FlushWord
    xor a
    ld (V_TAlt),a
    ret

; HeNouns: the noun list for Verb (NL, NCount, NeedNoun)
HeNouns:
    call UpdDark
    xor a
    ld (V_NCount),a
    ld a,(V_Verb)
    ld e,a
    ld d,0
    ld hl,HeVerbKind
    add hl,de
    ld a,(hl)
    ld (V_Need),a
    ld (V_T3),a
    or a
    ret z
    cp 1
    jr z,HnDir
    cp 5
    jr z,HnSay
    cp 6
    jr z,HnDial
    ld c,1
HnLp:
    push bc
    ld a,c
    ld (V_T4),a
    ld a,(V_T3)
    cp 4
    jr z,HnHeld
    ld a,(V_T4)
    call Visible
    or a
    jr z,HnNext
    ld a,(V_T3)
    cp 3
    jr nz,HnAdd
    ld a,(V_T4)
    call OLAddr
    ld a,(hl)
    cp HE_CARRIED
    jr z,HnNext
    jr HnAdd
HnHeld:
    ld a,(V_T4)
    call Reach
    or a
    jr z,HnNext
HnAdd:
    ld a,(V_T4)
    call AddNoun
HnNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,HnLp
    ret
; GO lists the ways out (all ten in the dark: who knows?)
HnDir:
    ld c,0
HndLp:
    push bc
    ld a,(V_Dark)
    or a
    jr nz,HndAdd
    ld a,c
    call GetExit
    or a
    jr z,HndNx
HndAdd:
    pop bc
    push bc
    ld a,c
    add a,70
    call AddNoun
HndNx:
    pop bc
    inc c
    ld a,c
    cp 10
    jr c,HndLp
    ret
; SAY and CRACK: word, flag pairs (255 = always; else once the flag is set)
HnSay:
    ld hl,HeSayWords
    jr HnWords
HnDial:
    ld hl,HeDialWords
HnWords:
    ld a,(hl)
    or a
    ret z
    ld b,a
    inc hl
    ld a,(hl)
    inc hl
    cp 255
    jr z,HnwAdd
    push hl
    push bc
    call FlAddr
    ld a,(hl)
    pop bc
    pop hl
    or a
    jr z,HnWords
HnwAdd:
    push hl
    ld a,b
    call AddNoun
    pop hl
    jr HnWords
AddNoun:
    ld hl,V_NCount
    ld e,(hl)
    inc (hl)
    ld d,0
    ld hl,V_NL
    add hl,de
    ld (hl),a
    ret

; HeTargets: where PUT can put Noun (open or closed containers in sight)
HeTargets:
    call UpdDark
    xor a
    ld (V_NCount),a
    ld a,1
    ld (V_Need),a
    ld c,1
HtgLp:
    push bc
    ld a,c
    ld (V_T4),a
    ld a,(V_Noun)
    cp c
    jr z,HtgNext
    ld a,c
    call ContIdx
    or a
    jr z,HtgNext
    ld a,(V_T4)
    call Visible
    or a
    jr z,HtgNext
    ld a,(V_T4)
    call AddNoun
HtgNext:
    pop bc
    inc c
    ld a,c
    cp HE_NOBJ+1
    jr c,HtgLp
    ret

; PrintFixed: HL = message, D = row, E = column, B = width (no wrap,
; padded with spaces in the current font)
PrintFixed:
    push bc
    push de
    call MsgStart
    pop de
    call RowCol
    call VSetW
    pop bc
PfLp:
    push bc
    call NextCh
    pop bc
    or a
    jr z,PfPad
    call AltMap
    out ($BE),a
    djnz PfLp
    ret
PfPad:
    ld a,32
    call AltMap
    out ($BE),a
    nop
    djnz PfPad
    ret

; PutAt: A = character at D,E
PutAt:
    push af
    call RowCol
    call VSetW
    pop af
    out ($BE),a
    ret

; HeDrawPick: the verb and noun picker on rows 20-22
HeDrawPick:
    ld d,20
    ld b,3
    call ClearRows
    ; verbs: the one before, the current one, the one after
    ld c,0
DpV:
    push bc
    ld a,(V_PkMode)
    or a
    jr z,DpVShow
    ld a,c
    cp 1
    jr nz,DpVNext
DpVShow:
    ld a,(V_PkV)
    add a,c
    dec a
    jp p,DpVPos
    add a,HE_NVERBS
DpVPos:
    cp HE_NVERBS
    jr c,DpVOk
    sub HE_NVERBS
DpVOk:
    add a,a
    ld e,a
    ld d,0
    ld hl,HeVerbMsg
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    ld (V_TAlt),a
    ld a,c
    cp 1
    jr nz,DpVDraw
    ld a,(V_PkCol)
    or a
    jr nz,DpVDraw
    ld a,2
    ld (V_TAlt),a
DpVDraw:
    ld a,20
    add a,c
    ld d,a
    ld e,3
    ld b,9
    call PrintFixed
DpVNext:
    pop bc
    inc c
    ld a,c
    cp 3
    jr c,DpV
    xor a
    ld (V_TAlt),a
    ; nouns
    ld a,(V_Need)
    or a
    jr z,DpMarks
    ld a,(V_NCount)
    or a
    jr nz,DpNList
    ld hl,SysNone
    ld d,21
    ld e,14
    ld b,16
    call PrintFixed
    jr DpMarks
DpNList:
    ld c,0
DpN:
    push bc
    ld a,(V_PkN)
    add a,c
    dec a
    jp m,DpNNext
    ld hl,V_NCount
    cp (hl)
    jr nc,DpNNext
    ld e,a
    ld d,0
    ld hl,V_NL
    add hl,de
    ld a,(hl)
    call ObjEnt
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    xor a
    ld (V_TAlt),a
    ld a,c
    cp 1
    jr nz,DpNDraw
    ld a,(V_PkCol)
    or a
    jr z,DpNDraw
    ld a,2
    ld (V_TAlt),a
DpNDraw:
    ld a,20
    add a,c
    ld d,a
    ld e,14
    ld b,16
    call PrintFixed
DpNNext:
    pop bc
    inc c
    ld a,c
    cp 3
    jr c,DpN
    xor a
    ld (V_TAlt),a
DpMarks:
    ld a,(V_PkCol)
    or a
    ld a,62
    jr z,DpM1
    ld a,32
DpM1:
    ld d,21
    ld e,2
    call PutAt
    ld a,(V_PkCol)
    or a
    ld a,32
    jr z,DpM2
    ld a,62
DpM2:
    ld d,21
    ld e,13
    call PutAt
    ; row 19: the divider, with "IN WHAT?" while choosing where to put
    call DrawDivider
    ld a,(V_PkMode)
    or a
    ret z
    ld a,1
    ld (V_TAlt),a
    ld hl,SysInWhat
    ld d,19
    ld e,14
    ld b,8
    call PrintFixed
    xor a
    ld (V_TAlt),a
    ret

; HeStatus: row 8, "SCORE 15  MOVES 23" in yellow
HeStatus:
    ld d,8
    ld b,1
    call ClearRows
    ld a,1
    ld (V_TAlt),a
    ld hl,SysScoreW
    ld d,8
    ld e,2
    ld b,6
    call PrintFixed
    ld a,(V_Score)
    ld l,a
    ld h,0
    ld de,8*256+8
    call WrNum
    ld hl,SysMovesW
    ld d,8
    ld e,18
    ld b,6
    call PrintFixed
    ld hl,(V_Moves)
    ld de,8*256+24
    call WrNum
    xor a
    ld (V_TAlt),a
    ret

; WrNum: HL = number, D,E = place: digits without leading zeros
WrNum:
    push hl
    call RowCol
    call VSetW
    pop hl
    xor a
    ld (V_NStart),a
    ld de,1000
    call WnDig
    ld de,100
    call WnDig
    ld de,10
    call WnDig
    ld a,l
    add a,48
    call AltMap
    out ($BE),a
    ret
WnDig:
    ld a,47
WnSub:
    inc a
    or a
    sbc hl,de
    jr nc,WnSub
    add hl,de
    cp 48
    jr nz,WnOut
    ld c,a
    ld a,(V_NStart)
    or a
    ret z
    ld a,c
WnOut:
    ld c,a
    ld a,1
    ld (V_NStart),a
    ld a,c
    call AltMap
    out ($BE),a
    ret

; HeFonts: yellow font (codes 160-223) in the middle and bottom thirds,
; black-on-yellow font (codes 128-159, 224-255) and the divider (96) in
; the bottom third
HeFonts:
    ld bc,$03FF         ; R3: three colour tables, one per screen third
    call WRITE_REGISTER
    ld a,1
    call HfThird
    ld a,2
    call HfThird
    ; divider
    ld hl,HE_PAT+$1000+HE_DIVIDER*8
    call VSetW
    ld hl,HeDivPat
    ld b,8
HfDp:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HfDp
    ld hl,HE_COL+$1000+HE_DIVIDER*8
    call VSetW
    ld b,8
HfDc:
    ld a,$40
    out ($BE),a
    nop
    djnz HfDc
    ret
HeDivPat:
    db $00,$00,$00,$AA,$55,$00,$00,$00

; HfThird: A = third (1 or 2)
HfThird:
    add a,a
    add a,a
    add a,a
    ld (V_T3),a         ; high byte of the third's offset ($0800 or $1000)
    ld c,32
HfCh:
    push bc
    ; read the glyph
    ld l,c
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(V_T3)
    add a,h
    ld h,a
    call VSetR
    ld hl,V_RowBuf
    ld b,8
HfRd:
    in a,($BE)
    ld (hl),a
    inc hl
    djnz HfRd
    pop bc
    push bc
    ; yellow copy at code + 128
    ld a,c
    add a,128
    ld (V_T4),a
    ld a,$B0
    call HfPut
    ; black on yellow copy (bottom third only)
    ld a,(V_T3)
    cp $10
    jr nz,HfNext
    pop bc
    push bc
    ld a,c
    cp 64
    jr nc,HfHi
    add a,96
    jr HfInv
HfHi:
    add a,160
HfInv:
    ld (V_T4),a
    ld a,$1B
    call HfPut
HfNext:
    pop bc
    inc c
    ld a,c
    cp 96
    jr c,HfCh
    ret

; HfPut: glyph in RowBuf -> code T4 of third T3, colour A
HfPut:
    push af
    ld a,(V_T4)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(V_T3)
    add a,h
    ld h,a
    push hl
    call VSetW
    ld hl,V_RowBuf
    ld b,8
HpP:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz HpP
    pop hl
    ld de,HE_COL
    add hl,de
    call VSetW
    pop af
    ld b,8
HpC:
    out ($BE),a
    nop
    djnz HpC
    ret

; HeOverlay: draw what changed in the picture (open trapdoor, rope...).
; Pass 0 puts back the plain tiles of every change to this picture that
; does not hold here, pass 1 draws every change that holds here.
HeOverlay:
    ld a,(V_Dark)
    or a
    ret nz
    xor a
    call OvPass
    ld a,1
OvPass:
    ld (V_T3),a
    ld hl,HeOverlays
OvLp:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld b,a              ; room
    ld a,(hl)           ; scene
    inc hl
    ld c,a
    ld a,(V_Scene)
    cp c
    jr nz,OvSkip        ; another picture: leave it alone
    ld a,(V_Rm)
    cp b
    ld a,0
    jr nz,OvHave        ; same picture, another room: put the plain tiles back
    push hl
    call OvCond
    pop hl
OvHave:
    ld b,a
    ld a,(V_T3)
    cp b
    jr nz,OvSkip
    ; draw the runs: base codes in pass 0, new codes in pass 1
    inc hl
    inc hl
    inc hl
    ld b,(hl)
    inc hl
OvRun:
    push bc
    ld e,(hl)
    inc hl
    ld c,(hl)
    inc hl
    push hl
    ld d,0
    ld hl,HE_NAME+32
    add hl,de
    call VSetW
    pop hl
    ld a,(V_T3)
    or a
    jr z,OvBase
    ld e,c
    ld d,0
    add hl,de
OvBase:
    ld b,c
OvW:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz OvW
    ld a,(V_T3)
    or a
    jr nz,OvRn
    ld e,c
    ld d,0
    add hl,de
OvRn:
    pop bc
    djnz OvRun
    jr OvLp
OvSkip:
    ; skip the condition and the runs
    inc hl
    inc hl
    inc hl
    ld b,(hl)
    inc hl
OvSk:
    inc hl
    ld a,(hl)
    inc hl
    add a,a
    ld e,a
    ld d,0
    add hl,de
    djnz OvSk
    jr OvLp

; OvCond: HL = condition -> A = 1 when it holds
OvCond:
    ld a,(hl)
    ld (V_T4),a
    inc hl
    ld c,(hl)
    inc hl
    ld b,(hl)
    ld a,(V_T4)
    and 127
    cp 1
    jr nz,OcFlag
    ld a,c
    call OLAddr
    ld a,(hl)
    jr OcCmp
OcFlag:
    cp 2
    jr nz,OcPatch
    ld a,c
    call FlAddr
    ld a,(hl)
    jr OcCmp
OcPatch:
    cp 3
    jr nz,OcOpen
    ld e,c
    ld d,0
    ld hl,V_Pt
    add hl,de
    ld a,(hl)
    jr OcCmp
OcOpen:
    push bc
    ld a,c
    call IsOpen
    pop bc
OcCmp:
    cp b
    ld a,1
    jr z,OcNeg
    xor a
OcNeg:
    ld b,a
    ld a,(V_T4)
    rlca
    and 1
    xor b
    ret

; HeDisplayOn: display on, NMI left off (R1 bit 6 on, bit 5 off)
HeDisplayOn:
    ld a,(VDP_R1_SHADOW)
    or $40
    and $DF
    ld (VDP_R1_SHADOW),a
    ld c,a
    ld b,1
    jp WRITE_REGISTER
