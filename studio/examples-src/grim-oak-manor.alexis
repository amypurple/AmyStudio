data SceneFam bytes 10,3,10,3,0,7,5,2,4,2,6,8,7,0,6,9,4,1,1,5
data FamPatTab words = @HeFamPat0, @HeFamPat1, @HeFamPat2, @HeFamPat3, @HeFamPat4, @HeFamPat5, @HeFamPat6, @HeFamPat7, @HeFamPat8, @HeFamPat9, @HeFamPat10
data FamColTab words = @HeFamCol0, @HeFamCol1, @HeFamCol2, @HeFamCol3, @HeFamCol4, @HeFamCol5, @HeFamCol6, @HeFamCol7, @HeFamCol8, @HeFamCol9, @HeFamCol10
data SceneMapTab words
  @HeMap0, @HeMap1, @HeMap2, @HeMap3, @HeMap4, @HeMap5, @HeMap6, @HeMap7,
  @HeMap8, @HeMap9, @HeMap10, @HeMap11, @HeMap12, @HeMap13, @HeMap14, @HeMap15,
  @HeMap16, @HeMap17, @HeMap18, @HeMap19
end data

' ShowScene: the picture of Scene on rows 1-7 (255 = darkness). The tile
' set of its family is unpacked only when the family changes.
sub ShowScene:
  Shown = Scene
  if Scene = 255 then
    for Y = 1 to 7
      fill 32 count 28 at 2,Y
    next
    print at 7,4, "IT IS PITCH DARK."
    return
  end if
  Fam = SceneFam[Scene]
  if Fam <> FamShown then
    decompress zx0 FamPatTab[Fam] to vram.pattern + 1024
    decompress zx0 FamColTab[Fam] to vram.color + 1024
    FamShown = Fam
  end if
  decompress zx0 SceneMapTab[Scene] to vram.name + 32
  return
end sub

' ShowCreatures: the vampire (object 36) and the Indian (37) stand in the
' picture while they are in the room; the goldfish swim in the tank (room
' 7); a bat flits over the grounds (rooms 4 and 5)
sub ShowCreatures:
  Mag = 0
  sprites 16x16
  sprites simple
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  Spooky = 0
  if Dark = 0 then
    if OL[36] = Rm then
      Creature(6, 96, SVampireDL, 13, 15)
    end if
    if OL[37] = Rm then
      Creature(32, 56, SIndianDL, 9, 4)
    end if
    if Rm = 7 then Spooky = 1
    if Rm = 4 then Spooky = 2
    if Rm = 5 then Spooky = 2
  end if
  Animate
  return
end sub

' Animate: once a frame; moves the fish or the bat (frames change at 2 Hz)
sub Animate:
  inc Anim
  if Spooky = 0 then return
  if Spooky = 1 then
    V = Anim & 3
    if V = 0 then
      if FishD = 0 then
        inc FishX
        dec Fish2X
        if FishX > 150 then FishD = 1
      else
        dec FishX
        inc Fish2X
        if FishX < 60 then FishD = 0
      end if
    end if
    J = SFishA
    V = Anim & 32
    if V > 0 then J = SFishB
    set sprite 0 to 16, FishX, J, 10
    set sprite 1 to 30, Fish2X, J, 9
  else
    V = Anim & 1
    if V = 0 then
      inc BatX
      V = BatX & 63
      if V < 32 then
        BatY = 6 + V / 4
      else
        V = 63 - V
        BatY = 6 + V / 4
      end if
    end if
    J = SBatA
    V = Anim & 16
    if V > 0 then J = SBatB
    set sprite 0 to BatY, BatX, J, 14
  end if
  update sprites
  return
end sub

' Creature: four sprites (details first, so they are drawn on top)
sub Creature(u8 CY, u8 CX, u8 CP, u8 CBody, u8 CDet):
  ' the leopard and the demon are magnified (64 x 32 pixels)
  V = CX + 16
  if Mag = 1 then
    V = CX + 32
    sprites double
  else
    sprites simple
  end if
  J = CP + 4
  set sprite 0 to CY, CX, CP, CDet
  set sprite 1 to CY, V, J, CDet
  J = CP + 8
  set sprite 2 to CY, CX, J, CBody
  J = CP + 12
  set sprite 3 to CY, V, J, CBody
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Pages

sub EditorialPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  print at 8,1, "GRIM OAK MANOR"
  print at 2,4, "BASED ON GRIM OAK MANOR BY"
  print at 2,5, "CLEVELAND M. BLAKEMORE,"
  print at 2,6, "AHOY! APRIL 1988"
  print at 2,7, "(COMMODORE 128)."
  print at 2,9, "EVERY ROOM AND PUZZLE OF"
  print at 2,10, "THE LISTING, WITH A JOYSTICK"
  print at 2,11, "MENU AND A PICTURE OF EACH"
  print at 2,12, "ROOM."
  print at 2,14, "COLECOVISION GAME, MUSIC"
  print at 2,15, "AND PICTURES BY CLAUDE"
  print at 2,16, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,17, "IN AMY BY AMY BIENVENU, 2026."
  print at 2,19, "MUSIC: GRIM OAK WALTZ"
  print at 8,22, "PRESS A BUTTON"
  screen on
  nmi off
  WaitPress
  return
end sub

' WaitPress: a fresh press of either button (the NMI stays protected)
sub WaitPress:
  WasBtn = 1
  WasBtn2 = 1
  Press = 0
  Press2 = 0
  while Press = 0 and Press2 = 0
    Frame1
    ReadPad
  end while
  return
end sub

sub TitlePage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  Scene = TitleScene
  Shown = 255
  FamShown = 255
  ShowScene
  print at 8,10, "GRIM OAK MANOR"
  print at 4,12, "FIND UNCLE NIGEL'S WILL!"
  print at 12,16, "PLAY"
  print at 12,18, "HOW TO PLAY"
  print at 12,20, "CREDITS"
  print at 3,22, "1988 C.M. BLAKEMORE  2026"
  Menu = 0
  Spooky = 2
  BatX = 200
  screen on
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 672
  TzOn = 1
  WasBtn = 1
  WasBtn2 = 1
title_loop:
  Frame1
  Animate
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTick
  end if
  print at 10,16, " "
  print at 10,18, " "
  print at 10,20, " "
  Y = Menu * 2
  Y = Y + 16
  print at 10,Y, ">"

  if Press = 1 then goto title_done
  goto title_loop
title_done:
  mute all
  TzOn = 0
  Spooky = 0
  play sound SndOk
  return
end sub

sub HelpPages:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  cls
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "UNCLE NIGEL IS DEAD AND THE"
  print at 2,4, "BANK WANTS GRIM OAK MANOR."
  print at 2,5, "FIND HIS LAST WILL, THEN"
  print at 2,6, "CALL THE BANK TO SAVE IT."
  print at 2,8, "THE HOUSE IS DARK: A LIGHT"
  print at 2,9, "HELPS. YOU CAN CARRY FIVE"
  print at 2,10, "THINGS."
  print at 2,12, "STICK UP/DOWN: CHOOSE A"
  print at 2,13, "VERB, THEN STICK RIGHT OR"
  print at 2,14, "LEFT BUTTON: CHOOSE WHAT."
  print at 2,15, "LEFT BUTTON: DO IT."
  print at 2,16, "RIGHT BUTTON: BACK."
  print at 2,18, "WHEN THE STORY FILLS THE"
  print at 2,19, "SCREEN, MORE WAITS FOR A"
  print at 2,20, "BUTTON."
  print at 8,22, "PRESS A BUTTON"
  screen on
  nmi off
  WaitPress
  return
end sub

