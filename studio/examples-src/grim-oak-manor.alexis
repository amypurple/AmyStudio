cartridge "GRIM OAK MANOR/CLEVELAND M. BLAKEMORE/1988"
' GRIM OAK MANOR
' Based on the text adventure by Cleveland M. Blakemore, Ahoy! April 1988
' (Commodore 128, BASIC 7.0), for the ColecoVision in Amy by Amy Bienvenu;
' this version by Claude (Anthropic).
'
' Uncle Nigel is dead and the bank wants Grim Oak Manor. Somewhere in the
' house is his last will: find it and call the bank.
'
' Screen: a picture of the place on rows 1-7 (the vampire, the Indian, the
' goldfish and a bat are sprites), the score and moves on row 8, the story
' on rows 9-18 (it scrolls; MORE waits for a button when a long text fills
' it), a menu on rows 20-22.
'
' Controls (either joystick): up/down choose a verb (left column) or a
' noun (right column); right or the left button moves to the nouns; the
' left button carries out the command; the right button goes back. Keypad
' not used.
'
' Inside: the adventure lives in data (adv.py: every room, object and rule
' of the listing), compiled by advc.py to bytecode and packed text for
' engine.asm (The Hermit's engine, given ten exits a room, a dark-room
' table and the listing's five-item load). Pictures from scenes.py.
'
' Liberties taken:
' - A verb and noun menu instead of typing; synonyms are merged (FEED is
'   GIVE, FLATTEN is STOMP, SLIDE and PUSH are MOVE, SOAK and DEVELOP are
'   DIP, SQUIRT is OIL, BANG is STRIKE, DOUSE is EXTINGUISH). GO lists only
'   the ways out (all ten in the dark: "who knows?"). SAY offers UMGALAH
'   once the paper strip is read; CRACK offers combinations, the right one
'   once the Indian has spoken (the listing asked for typed digits).
' - Saving to disk is gone (no disk).
' - A score (100) and ranks, pictures for every room showing what the
'   player changed, sprites, a title waltz and sound effects.
'
' House rules: tiles 128+, the tune once, NMI off when drawing,
' `set sprite count`, nothing flashes faster than 3 Hz (the bat flaps at
' 2 Hz, the fish swim slowly).

const SndHush = 1
const SndTick = 2
const SndMore = 3
const SndOk = 4
const SndBack = 5
const SndTreasure = 6
const SndDie = 7
const SndWin = 8
const SndRing = 9
const SndScream = 10
const SndTuneA = 11
const SndTuneB = 12
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0
const FgLt = 0
const FgBopen = 1
const FgCapflat = 2
const FgCigopen = 3
const FgBkopen = 4
const FgWj = 5
const FgWs = 6
const FgCombed = 7
const FgMag = 8
const FgSilv = 9
const FgDev = 10
const FgFull = 11
const FgF2 = 12
const FgF4 = 13
const FgF5 = 14
const FgF6 = 15
const FgGrate = 16
const FgF7 = 17
const FgF8 = 18
const FgDoor9 = 19
const FgF12 = 20
const FgF13 = 21
const FgF15 = 22
const FgF16 = 23
const FgF18 = 24
const FgKnow = 25
const FgWord = 26
const FgShot = 27
const FgFog = 28
const FgSc = 29
const FgDead = 30
const FgWin = 31
const FgQuit = 32
const VbGo = 0
const VbLook = 1
const VbExamine = 2
const VbTake = 3
const VbDrop = 4
const VbInventory = 5
const VbOpen = 6
const VbClose = 7
const VbUnlock = 8
const VbLock = 9
const VbEnter = 10
const VbTurnOn = 11
const VbTurnOff = 12
const VbRead = 13
const VbWear = 14
const VbComb = 15
const VbGive = 16
const VbEat = 17
const VbDrink = 18
const VbShake = 19
const VbStomp = 20
const VbInsert = 21
const VbUse = 22
const VbFill = 23
const VbPour = 24
const VbExtinguish = 25
const VbDip = 26
const VbStrike = 27
const VbShoot = 28
const VbMove = 29
const VbDig = 30
const VbOil = 31
const VbTie = 32
const VbThrow = 33
const VbTrade = 34
const VbSay = 35
const VbCrack = 36
const VbBreak = 37
const VbKill = 38
const VbScore = 39
const VbQuit = 40
const NVerbs = 41
const TitleScene = 19
const SVampireDL = 0
const SVampireDR = 4
const SVampireBL = 8
const SVampireBR = 12
const SIndianDL = 16
const SIndianDR = 20
const SIndianBL = 24
const SIndianBR = 28
const SFishA = 32
const SFishB = 36
const SBatA = 40
const SBatB = 44
const NTiles8 = 0
const SprBytes = 384

' world (engine.asm)
u8 OL[60]
u8 Fl[34]
u8 Opn[4]
u8 Pt[4]
u8 NL[70]
u8 WBuf[30]
u8 RowBuf[28]
u8 TxStk[16]
u16 TxPtr = 0
u16 Moves = 0
u8 Rm = 1
u8 Verb = 0
u8 Noun = 0
u8 Noun2 = 0
u8 Score = 0
u8 Scene = 0
u8 Dark = 0
u8 NCount = 0
u8 NeedNoun = 0
u8 PkV = 0
u8 PkN = 0
u8 PkCol = 0
u8 PkMode = 0
u8 InMore = 0
u8 TxDepth = 0
u8 TCol = 0
u8 TPend = 0
u8 TWLen = 0
u8 TAlt = 0
u8 TLines = 0
u8 StopF = 0
u8 ContF = 0
u8 Neg = 0
u8 RootOp = 0
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0
u8 NStart = 0
u8 SaveN = 0
' the cartridge
u16 NumU = 0
u8 Shown = 255
u8 FamShown = 255
u8 Fam = 0
u8 OldScore = 0
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 Dirty = 0
u8 Mag = 0
u8 HistN = 0
u8 Pg = 0
u8 Blink = 0
u8 Ended = 0
u8 J = 0
u8 V = 0
u8 Y = 0
u8 FishX = 70
u8 Fish2X = 140
u8 FishD = 0
u8 BatX = 0
u8 BatY = 10
u8 Anim = 0
u8 Spooky = 0

  tile screen
  set sound table GoSoundTable areas 4
  sprites 16x16
  set sprite count 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  EditorialPage

title:
  TitlePage
  if Menu = 1 then
    HelpPages
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if

new_game:
  GameScreen
  call asm HeStart
  NewPicture
  ShowCreatures
  call asm HeOverlay
  call asm HeStatus
  PkV = 0
  NewVerb

play_loop:
  Frame1
  Animate
  ReadPad
  Dirty = 0
  if Stick = 1 then MoveStick
  if Press = 1 then FireLeft
  if Press2 = 1 then FireRight
  if Ended > 0 then goto game_end
  if Dirty = 1 then
    call asm HeDrawPick
  end if
  goto play_loop

game_end:
  mute all
  TzOn = 0
  if Ended = 1 then play sound SndDie
  if Ended = 2 then play sound SndRing
  EndPicker
  Rearm
  wait 90 frames
  if Ended = 2 then play sound SndWin
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' The menu

sub NewVerb:
  Verb = PkV
  PkN = 0
  PkCol = 0
  PkMode = 0
  call asm HeNouns
  call asm HeDrawPick
  return
end sub

sub MoveStick:
  if Up1 = 1 then
    if PkCol = 0 then
      if PkMode = 0 then
        if PkV = 0 then
          PkV = NVerbs - 1
        else
          dec PkV
        end if
        NewVerb
        play sound SndTick
      end if
    else
      if PkN > 0 then
        dec PkN
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Dn1 = 1 then
    if PkCol = 0 then
      if PkMode = 0 then
        inc PkV
        if PkV = NVerbs then PkV = 0
        NewVerb
        play sound SndTick
      end if
    else
      V = PkN + 1
      if V < NCount then
        PkN = V
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  if Rt1 = 1 then
    if PkCol = 0 then
      if NeedNoun > 0 then
        if NCount > 0 then
          PkCol = 1
          Dirty = 1
          play sound SndTick
        end if
      end if
    end if
  end if
  if Lf1 = 1 then
    if PkMode = 0 then
      if PkCol = 1 then
        PkCol = 0
        Dirty = 1
        play sound SndTick
      end if
    end if
  end if
  return
end sub

sub FireLeft:
  if PkCol = 0 then
    if NeedNoun = 0 then
      Noun = 0
      Noun2 = 0
      RunTurn
      return
    end if
    if NCount > 0 then
      PkCol = 1
      Dirty = 1
      play sound SndTick
    end if
    return
  end if
  if NCount = 0 then return
  if PkMode = 0 then
    Noun = NL[PkN]
    Noun2 = 0
    RunTurn
    return
  end if
  Noun2 = NL[PkN]
  Noun = SaveN
  RunTurn
  return
end sub

sub FireRight:
  if PkMode = 1 then
    NewVerb
    PkCol = 1
    Dirty = 1
    play sound SndBack
    return
  end if
  if PkCol = 1 then
    PkCol = 0
    Dirty = 1
    play sound SndBack
  end if
  return
end sub

' RunTurn: the engine plays the command (the NMI is off: Frame1 ended)
sub RunTurn:
  play sound SndOk
  OldScore = Score
  call asm HeTurn
  if Scene <> Shown then NewPicture
  ShowCreatures
  call asm HeOverlay
  call asm HeStatus
  if HistN > 0 then Pager
  if Fl[FgDead] = 1 then
    Ended = 1
    return
  end if
  if Fl[FgWin] = 1 then
    Ended = 2
    return
  end if
  if Fl[FgQuit] = 1 then
    Ended = 3
    return
  end if
  if Score > OldScore then
    play sound SndTreasure
    if Fl[FgF15] = 2 then
      if Rm = 15 then play sound SndScream
    end if
  end if
  NewVerb
  return
end sub

' Pager: when a turn wrote more than the window holds, the engine kept the
' lines that scrolled away (VRAM history). Show them ten at a time from
' the start, MORE between pages, ending on the window as it was.
sub Pager:
  call asm HeHistFinish
  Pg = 0
  V = HistN - 10
  while Pg < V
    call asm HeHistShow
    ' MORE blinks and has its own chime until a button is pressed
    InMore = 1
    play sound SndMore
    Blink = 0
    Press = 0
    Press2 = 0
    while Press = 0 and Press2 = 0
      if Blink = 0 then
        call asm HeMoreMark
      end if
      if Blink = 20 then
        call asm HeDrawDivider
      end if
      Frame1
      ReadPad
      inc Blink
      if Blink = 32 then Blink = 0
    end while
    play sound SndTick
    InMore = 0
    Pg = Pg + 10
    if Pg > V then Pg = V
  end while
  call asm HeHistShow
  call asm HeDrawDivider
  return
end sub

' NewPicture: unpacking with the display on can garble VRAM reads, so the
' screen goes blank for a moment; it comes back with the NMI still off
' (this can run in the middle of a turn)
sub NewPicture:
  display off
  ShowScene
  call asm HeDisplayOn
  return
end sub

' EndPicker: the menu area says how the game ended
sub EndPicker:
  for Y = 20 to 22
    fill 32 count 28 at 2,Y
  next
  if Ended = 1 then print at 9,20, "YOU HAVE DIED."
  if Ended = 2 then print at 3,20, "GRIM OAK MANOR IS SAVED!"
  if Ended = 3 then print at 10,20, "GAME OVER"
  print at 7,22, "PRESS A BUTTON"
  return
end sub

' ---------------------------------------------------------------------------
' Frame and controls

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  ' the stick: one step when pushed, then a repeat while held
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 18
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  ' clear sprites sets the count to 0: give it again
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' GameScreen: fonts, divider, empty picture
sub GameScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  backdrop black
  cls
  call asm HeFonts
  FamShown = 255
  Shown = 255
  Ended = 0
  WasBtn = 1
  WasBtn2 = 1
  screen on
  nmi off
  return
end sub

