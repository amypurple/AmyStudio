' Native EOS non-blocking serial smoke test.
u8 Readable = 0
u8 Present = 0
u8 Writable = 0
u8 Received = 0
u8 Connected = 0
u8 Continued = 0

Present = serial present
if Present then
  Readable = serial readable
  Writable = serial writable
  Received = serial read
  Connected = serial carrier
  serial write $42
end if
Continued = 1

loop forever
