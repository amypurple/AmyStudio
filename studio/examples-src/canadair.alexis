' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
u8 Fl[32]               ' flame height of each column (cells, 0 = out)
u16 PxF = 0             ' the plane's x, 8.8 fixed point
u16 Tq = 0
u16 Sp = 0
u16 SpdB = 0
u16 Score = 0
u8 Px = 0               ' the plane's x (pixels)
u8 Pr = 3               ' the plane's row
u8 Ys = 0               ' the plane's sprite y (glides to its row)
u8 Dir = 0              ' 0 = flying right, 1 = left
u8 PropF = 0
u8 Tank = 6
u8 Lives = 3
u8 Level = 1
u8 StartLv = 1
u8 Crash = 0
u8 LvDone = 0           ' 1 = bottom reached, 2 = every flame out
u8 Nburn = 0            ' burning columns
u8 DropT = 0            ' 0 none, 1 falling, 2.. puff
u8 Dx = 0
u8 Dy = 0
u8 Dv = 0
u8 DvT = 0
u8 Dc = 0
u8 Tp = 0
u8 PuffC = 0
u8 PuffT = 0
u8 PuffX = 0
u8 PuffY = 0
u8 Gc = 0               ' DrawCol column
u8 Gr = 0
u8 Gt = 0
u8 Go = 0
u8 Gs = 0
u8 Ge = 0
u8 Ho = 0
u8 Drew = 0
u8 GrowC = 0
u8 GrowT = 0
u8 Hmax = 0
u8 MsgT = 0
u8 AnF = 0
u8 TipF = 0
u8 BodyF = 0
u8 SmokeF = 0
u8 HotO = 0
u8 LakeF = 0
u8 K = 0
u8 Cnt = 0
u8 Menu = 0
u8 Hits = 0
u8 Tx = 0
u8 Ty = 0
u8 Tf = 0
u8 Gx2 = 0
u8 Gy2 = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title

' per level (1-16, then the last value): tallest starting flame, fast speed,
' frames between two growths (0 = no growth)
data HmaxT bytes 4,6,8,10,11,12,13,14,14,14,14,14,14,14,14,14
data SpdT bytes 96,104,112,120,128,136,144,152,160,168,172,176,180,184,188,192
data GrowTT bytes 0,240,190,150,125,105,90,75,65,55,48,42,36,31,27,24
' sky stars: col,row pairs (rows 2-4: the fire's smoke can reach row 5)
data Stars bytes 3,2, 9,3, 14,2, 19,4, 6,4, 22,2, 12,4, 17,3, 29,4, 29,2, 1,4, 30,3

' ================================================================== program
  tile screen
  set sound table CaSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $ACE1
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = StartLv
  Lives = 3
  Score = 0

new_fire:
  NewFire
  play sound SndStart
  StartMusic

play_loop:
  Frame1
  Phase = 1
  Drew = 0
  ReadPad
  MovePlane
  DropStep
  Animate
  GrowStep
  DrawPlane
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then Soil
  end if
  if Crash = 1 then goto crashed
  if LvDone > 0 then goto cleared
  goto play_loop

' ------------------------------------------------------------ crash
crashed:
  Phase = 0
  StopMusic
  play sound SndZap
  play sound SndBoom
  hide sprite 3
  EndPuff
  ' the plane noses down and falls in flames to the tree tops (book: ZAP, EXPLODE)
  K = SpPdr0
  if Dir = 1 then K = SpPdl0
  Cnt = 0
  while Ys < 150
    Frame1
    Animate
    inc Cnt
    if Cnt >= 20 then Ys += 2
    V = K + 4
    set sprite 0 to Ys,Px,K,SpPdrC0
    set sprite 1 to Ys,Px,V,SpPdrC1
    hide sprite 2
    V = Cnt & 16
    J = SpBoom0
    if V = 0 then J = SpBoom1
    set sprite 3 to Ys,Px,J,9
    update sprites
  end while
  play sound SndBoom
  for Cnt = 1 to 60
    Frame1
    Animate
    V = Cnt & 16
    J = SpBoom0
    if V = 0 then J = SpBoom1
    set sprite 3 to Ys,Px,J,9
    update sprites
  next
  HideSprites
  dec Lives
  DrawHud
  if Lives > 0 then goto new_fire
  GameOver
  goto title

' ------------------------------------------------------------ forest saved
cleared:
  Phase = 0
  StopMusic
  play sound SndClear
  hide sprite 3
  EndPuff
  ' bonus: water left in the tank, and the rows not flown when every flame is out
  V = Tank * 5
  Score += V
  if LvDone = 2 then
    V = RowLast + 1
    V -= Pr
    V = V * 10
    Score += V
  end if
  DrawHud
  fill 32 count 28 at 2,22
  print at 8,22, "FOREST SAVED!"
  for Cnt = 1 to 150
    Frame1
    Animate
    ' the plane flies on, out of the forest
    if Dir = 0 then
      if Px < 236 then Px += 2
    else
      if Px > 4 then Px -= 2
    end if
    DrawPlaneAt
  next
  HideSprites
  if Level < 99 then inc Level
  goto new_fire

' ==================================================================== subs

' ------------------------------------------------------------ random
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ the scenery
sub LoadTiles:
  fill mode 2 text color with $F0
  copy CaPat count CaBytes to vram.pattern + 1024
  copy CaCol count CaBytes to vram.color + 1024
  copy CaPat count CaBytes to vram.pattern + 3072
  copy CaCol count CaBytes to vram.color + 3072
  copy CaPat count CaBytes to vram.pattern + 5120
  copy CaCol count CaBytes to vram.color + 5120
  backdrop dark blue
  cls
  return
end sub

sub SkyStars:
  for K = 0 to 11
    J = K << 1
    X = Stars[J]
    inc J
    Y = Stars[J]
    V = K % 3
    V += CaStar0
    put char V at X,Y
  next
  return
end sub

' the forest floor (row 21), soil (row 22), lake (columns 0-4)
sub Ground:
  for X = 0 to 31
    V = X & 1
    V += CaFloor0
    put char V at X,21
  next
  Soil
  for X = 0 to 4
    put char CaLakesurf at X,20
    put char CaLake at X,21
  next
  ' unburnt woods on the right of the fire
  put char CaPine at 29,20
  put char CaPine2 at 30,20
  put char CaPine at 31,20
  return
end sub

sub Soil:
  fill CaSoil0 count 32 at 0,22
  fill CaLake count 5 at 0,22
  return
end sub

' redraw column Gc after its height changed from Ho to Fl[Gc]: tip, warm
' cell, hot body (even/odd rows: the texture rises without seams), burning
' trunks on row 20; two cells of smoke above; a saved tree when the column
' is out. Only the rows that change are written (both tops - 2 to the lower
' top + 1), so a hit costs about 7 cells, not 16: a hit, a growth and the
' fire animation can share one frame (tests/bot.mjs --trace found 3 lost
' frames at level 11-13 with the full 16-row redraw).
sub DrawCol:
  Drew = 1
  Gt = Fl[Gc]
  Gt = 21 - Gt          ' the top flame row (21 = no flame)
  Go = 21 - Ho          ' the old top
  Gs = Gt
  if Go < Gs then Gs = Go
  Ge = Gt
  if Go > Ge then Ge = Go
  inc Ge
  if Ge > 20 then Ge = 20
  if Gs < 7 then
    Gs = 5
  else
    Gs -= 2
  end if
  for Gr = Gs to Ge
    V = 32
    if Gr >= Gt then
      if Gr = Gt then
        V = CaTip
      else
        K = Gt + 1
        if Gr = K then
          V = CaWarm
        else
          V = Gr & 1
          V += CaHota
        end if
        if Gr = 20 then V = CaBase
      end if
    else
      if Gr = 20 then V = CaPine
      if Gt < 21 then
        K = Gt - 1
        if Gr = K then V = CaSmokel
        dec K
        if Gr = K then V = CaSmokeu
      end if
    end if
    put char V at Gc,Gr
  next
  return
end sub

' ------------------------------------------------------------ a new fire
sub NewFire:
  BlankScreen
  LoadTiles
  SkyStars
  PutRun(CaMoon00, 3, 25, 2)
  PutRun(CaMoon10, 3, 25, 3)
  PutRun(CaMoon20, 3, 25, 4)
  Ground
  ' the book: height = INT(RND * N * 4) + tip; here a table per level
  K = Level
  if K > 16 then K = 16
  dec K
  Hmax = HmaxT[K]
  V = SpdT[K]
  SpdB = V
  SpdB = SpdB << 2       ' 96 -> 384 = 1.5 pixels a frame
  GrowT = GrowTT[K]
  for Gc = 0 to 31
    Fl[Gc] = 0
  next
  for Gc = FC0 to FC1
    Rnd
    V = R2 % Hmax
    inc V
    Fl[Gc] = V
    Ho = 0
    DrawCol
  next
  Nburn = FC1 - FC0
  inc Nburn
  Pr = RowTop
  Ys = Pr * 8
  Ys -= 5
  PxF = XL * 256
  Px = XL
  Dir = 0
  Tank = TankMax
  DropT = 0
  PuffT = 0
  Crash = 0
  LvDone = 0
  GrowC = 0
  Hits = 0
  DrawHud
  fill 32 count 28 at 2,22
  print at 6,22, "FOREST    ON FIRE!"
  print Level at 13,22 width 2
  MsgT = 150
  ShowScreen
  DrawPlane
  return
end sub

sub DrawHud:
  print at 2,1, "LV"
  print Level at 4,1 width 2
  ShowTank
  HudIcons(CaHlife, 32, Lives, 3, 14, 1)
  print Score at 24,1 width 5
  return
end sub

sub ShowTank:
  HudIcons(CaHdrop, CaHempty, Tank, TankMax, 7, 1)
  return
end sub

' ------------------------------------------------------------ the plane
sub MovePlane:
  ' speed: slow for the first rows (the book's half step), then the level's
  Sp = 256
  if Pr >= 6 then Sp = SpdB
  if Dir = 0 then
    if Rt1 = 1 then Sp += 128
    if Lf1 = 1 then Sp -= 128
  else
    if Lf1 = 1 then Sp += 128
    if Rt1 = 1 then Sp -= 128
  end if
  if Dir = 0 then
    PxF += Sp
    Tq = XR * 256
    if PxF >= Tq then
      PxF = Tq
      Dir = 1
    end if
  else
    Tq = XL * 256
    Tq += Sp
    if PxF < Tq then
      ' the left turn: one row lower, the lake fills the tank
      PxF = XL * 256
      Dir = 0
      if Pr >= RowLast then
        LvDone = 1
      else
        inc Pr
      end if
      if Tank < TankMax then
        Tank = TankMax
        ShowTank
        play sound SndFill
      end if
    else
      PxF -= Sp
    end if
  end if
  Px = highbyte PxF
  ' glide down to the row
  V = Pr * 8
  V -= 5
  if Ys < V then inc Ys
  ' a flame under the plane's hull? (columns of pixels 3 and 12)
  Gt = 21 - Pr
  X = Px + 3
  X = X >> 3
  V = Fl[X]
  if V >= Gt then Crash = 1
  X = Px + 12
  X = X >> 3
  V = Fl[X]
  if V >= Gt then Crash = 1
  return
end sub

sub DrawPlane:
  inc PropF
  if PropF >= 9 then PropF = 0
  DrawPlaneAt
  return
end sub

sub DrawPlaneAt:
  V = PropF / 3
  V = V << 3
  if Dir = 0 then
    set sprite 0 to Ys,Px,SpPlr0,SpPlrC0
    set sprite 1 to Ys,Px,SpPlr1,SpPlrC1
    V += SpPrr0
  else
    set sprite 0 to Ys,Px,SpPll0,SpPllC0
    set sprite 1 to Ys,Px,SpPll1,SpPllC1
    V += SpPrl0
  end if
  set sprite 2 to Ys,Px,V,15
  update sprites
  return
end sub

' ------------------------------------------------------------ the water
sub DropStep:
  PuffStep
  if DropT = 0 then
    if Press = 0 then return
    if LvDone > 0 then return
    if Tank = 0 then
      play sound SndDry
      return
    end if
    dec Tank
    ShowTank
    play sound SndDrop
    DropT = 1
    Dx = Px
    Dy = Ys + 4
    Dv = 1
    DvT = 0
    X = Dx + 8
    Dc = X >> 3
    ' a puff that reaches the plane's lines ends now (4 sprites a line at most)
    if PuffT > 0 then
      V = Ys + 12
      if PuffY < V then EndPuff
    end if
    set sprite 3 to Dy,Dx,SpWater0,7
    return
  end if
  Dy += Dv
  inc DvT
  if DvT >= 5 then
    DvT = 0
    if Dv < 4 then inc Dv
  end if
  ' where it lands: the flame's top cell, or the tree tops / lake
  V = Fl[Dc]
  Tp = 164
  if V > 0 then
    Tp = 21 - V
    Tp = Tp * 8
    Tp += 2
  end if
  V = Dy + 8
  if V >= Tp then
    V = Fl[Dc]
    if V > 0 then
      ' a hit: three cells of fire go out (the book's lines 580-640)
      if V > 3 then
        V -= 3
      else
        V = 0
        dec Nburn
      end if
      Ho = Fl[Dc]
      Fl[Dc] = V
      Gc = Dc
      DrawCol
      Score += 10
      inc Hits
      print Score at 24,1 width 5
      play sound SndHiss
      PuffC = 15
      if Nburn = 0 then LvDone = 2
    else
      play sound SndSplash
      PuffC = 7
    end if
    DropT = 0
    hide sprite 3
    PuffT = 18
    PuffX = Dx
    PuffY = Tp - 16
  else
    V = Tick & 8
    K = SpWater0
    if V = 0 then K = SpWater1
    set sprite 3 to Dy,Dx,K,7
  end if
  return
end sub

' the puff (steam on a flame, a splash elsewhere): 3 sizes, sprite 4;
' it does not hold the next load back
sub PuffStep:
  if PuffT = 0 then return
  dec PuffT
  if PuffT = 0 then
    EndPuff
    return
  end if
  V = 17 - PuffT
  V = V / 6
  V = V << 2
  V += SpPuff0
  set sprite 4 to PuffY,PuffX,V,PuffC
  return
end sub

sub EndPuff:
  PuffT = 0
  hide sprite 4
  return
end sub

' ------------------------------------------------------------ the fire grows back
sub GrowStep:
  if GrowT = 0 then return
  if GrowC < GrowT then inc GrowC
  if GrowC < GrowT then return
  ' one column redraw a frame: a hit this frame puts the growth off by one
  if Drew = 1 then return
  GrowC = 0
  Rnd
  V = R2 % 24
  V += FC0
  Gc = V
  V = Fl[Gc]
  if V = 0 then
    ' level 4 on: a put-out column catches again from a big neighbour
    if Level < 4 then return
    X = Gc - 1
    Y = Gc + 1
    K = Fl[X]
    J = Fl[Y]
    if J > K then K = J
    if K < 4 then return
    inc Nburn
  end if
  if V >= HTop then return
  ' never within three rows of the plane
  if Pr >= 17 then return
  K = 17 - Pr
  if V >= K then return
  Ho = V
  inc V
  Fl[Gc] = V
  DrawCol
  return
end sub

' ------------------------------------------------------------ animation
' the fire rises (hot body and warm cell every 4 frames), smoke drifts up
' (every 8), tongues change (every 16), trunks and lake every 32: at most
' 48 bytes of patterns a frame, in all three thirds
sub Animate:
  inc AnF
  V = AnF & 3
  if V = 0 then
    inc HotO
    HotO = HotO & 15
    J = HotO
    copy FireTex + J count 8 to vram.pattern + VHota
    copy FireTex + J count 8 to vram.pattern + 2048 + VHota
    copy FireTex + J count 8 to vram.pattern + 4096 + VHota
    J += 8
    copy FireTex + J count 8 to vram.pattern + VHotb
    copy FireTex + J count 8 to vram.pattern + 2048 + VHotb
    copy FireTex + J count 8 to vram.pattern + 4096 + VHotb
    return
  end if
  if V = 1 then
    J = HotO + 5
    J = J & 15
    copy FireTex + J count 8 to vram.pattern + VWarm
    copy FireTex + J count 8 to vram.pattern + 2048 + VWarm
    copy FireTex + J count 8 to vram.pattern + 4096 + VWarm
    return
  end if
  if V = 3 then return
  V = AnF & 7
  if V = 2 then
    inc SmokeF
    if SmokeF >= 24 then SmokeF = 0
    J = SmokeF + TexSmoke
    copy FireTex + J count 8 to vram.pattern + VSmokeu
    copy FireTex + J count 8 to vram.pattern + 2048 + VSmokeu
    copy FireTex + J count 8 to vram.pattern + 4096 + VSmokeu
    J += 8
    copy FireTex + J count 8 to vram.pattern + VSmokel
    copy FireTex + J count 8 to vram.pattern + 2048 + VSmokel
    copy FireTex + J count 8 to vram.pattern + 4096 + VSmokel
    return
  end if
  ' V = 6: tongues, trunks or lake, in turn
  V = AnF >> 3
  V = V & 3
  if V = 1 then
    BodyF = BodyF ^ 8
    J = BodyF + TexBase
    copy FireTex + J count 8 to vram.pattern + 4096 + VBase
    return
  end if
  if V = 3 then
    LakeF = LakeF ^ 8
    copy CaPat + SrcLake + LakeF count 8 to vram.pattern + 4096 + VLake
    return
  end if
  inc TipF
  if TipF >= 3 then TipF = 0
  J = TipF << 3
  J += TexTip
  copy FireTex + J count 8 to vram.pattern + VTip
  copy FireTex + J count 8 to vram.pattern + 2048 + VTip
  copy FireTex + J count 8 to vram.pattern + 4096 + VTip
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  ' a panel framed by fire, cols 7-23, rows 8-14
  for Gx2 = 7 to 23
    put char CaHota at Gx2,8
    put char CaHota at Gx2,14
  next
  for Gy2 = 9 to 13
    put char CaHota at 7,Gy2
    put char CaHota at 23,Gy2
    fill 32 count 15 at 8,Gy2
  next
  print at 11,10, "GAME OVER"
  print at 10,12, "LV"
  print Level at 12,12 width 2
  print Score at 15,12 width 5
  play sound SndOver
  for Cnt = 1 to 150
    Frame1
    Animate
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  LoadTiles
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

' a strip of fire and trees on row Ty (for the pages)
sub FireStrip:
  for X = 2 to 29
    V = X % 5
    K = CaBase
    if V = 0 then K = CaPine
    if V = 3 then K = CaPine2
    put char K at X,Ty
  next
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  Ty = 19
  FireStrip
  for X = 2 to 29
    V = X % 5
    if V = 1 then put char CaTip at X,18
    if V = 2 then put char CaTip at X,18
    if V = 4 then put char CaSmokel at X,17
  next
  fill CaFloor0 count 28 at 2,20
  ShowScreen
  set sprite 0 to 80,116,SpPlr0,SpPlrC0
  set sprite 1 to 80,116,SpPlr1,SpPlrC1
  set sprite 2 to 80,116,SpPrr1,15
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  ' a little scene: flames, smoke, a saved tree, the plane and its water
  Ty = 20
  FireStrip
  put char CaTip at 9,19
  put char CaHota at 10,19
  put char CaTip at 10,18
  put char CaSmokel at 10,17
  put char CaTip at 15,19
  put char CaSmokel at 15,18
  put char CaTip at 21,19
  put char CaTip at 25,19
  put char CaSmokel at 25,18
  fill CaFloor0 count 28 at 2,21
  ShowScreen
  set sprite 0 to 138,100,SpPlr0,SpPlrC0
  set sprite 1 to 138,100,SpPlr1,SpPlrC1
  set sprite 2 to 138,100,SpPrr0,15
  set sprite 3 to 146,100,SpWater0,7
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  HideSprites
  TextScreen
  PageHelp2
  put char CaHbtn at 3,3
  put char CaHleft at 2,5
  put char CaHright at 4,5
  put char CaHright at 2,6
  put char CaHleft at 4,6
  put char CaHdrop at 3,8
  put char CaHdrop at 4,8
  put char CaHlife at 3,12
  put char CaHlife at 4,12
  put char CaTip at 3,14
  put char CaHota at 3,15
  put char CaSmokel at 3,16
  WaitPage
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  LoadTiles
  SkyStars
  for Y = 0 to LogoH - 1
    V = Y * LogoW
    J = Y + 2
    put Logo + V count LogoW at 4,J
  next
  ' a burning forest under the logo (rows 8-12), the moon, the lake
  PutRun(CaMoon00, 3, 27, 5)
  PutRun(CaMoon10, 3, 27, 6)
  PutRun(CaMoon20, 3, 27, 7)
  for X = 0 to 31
    V = X % 7
    K = CaBase
    if V = 0 then K = CaPine
    if V = 4 then K = CaPine2
    put char K at X,11
    V = X % 3
    if V = 0 then put char CaTip at X,10
    if V = 1 then
      put char CaHota at X,10
      put char CaTip at X,9
      put char CaSmokel at X,8
    end if
    if V = 2 then put char CaSmokel at X,9
    V = X & 1
    V += CaFloor0
    put char V at X,12
  next
  ' menu (rows 14-20)
  print at 11,14, "START"
  print at 11,16, "LEVEL"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowLevelChoice
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Tx = 0
  Tf = 0
  DropT = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  Animate
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartLv > 1 then dec StartLv
      end if
      if Rt1 = 1 then
        if StartLv < 5 then inc StartLv
      end if
      ShowLevelChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowLevelChoice:
  print at 18,16, "< >"
  put char StartLv + 48 at 19,16
  return
end sub

' title sprites: the drop cursor (4), the plane over the fire (0-2) and
' its water (3), dropped every 48 frames
sub TitleAnim:
  inc Cnt
  V = Menu << 4
  V += 107
  set sprite 4 to V,68,SpCursor,7
  ' the plane: right then left, at row 6
  if Tf = 0 then
    Tx += 1
    if Tx >= 232 then Tf = 1
  else
    Tx -= 1
    if Tx <= 8 then Tf = 0
  end if
  inc PropF
  if PropF >= 9 then PropF = 0
  V = PropF / 3
  V = V << 3
  if Tf = 0 then
    set sprite 0 to 42,Tx,SpPlr0,SpPlrC0
    set sprite 1 to 42,Tx,SpPlr1,SpPlrC1
    V += SpPrr0
  else
    set sprite 0 to 42,Tx,SpPll0,SpPllC0
    set sprite 1 to 42,Tx,SpPll1,SpPllC1
    V += SpPrl0
  end if
  set sprite 2 to 42,Tx,V,15
  ' water now and then, a puff of steam on the fire
  V = Cnt & 63
  if V = 0 then
    if DropT = 0 then
      DropT = 1
      Dx = Tx
      Dy = 48
    end if
  end if
  if DropT = 1 then
    Dy += 2
    set sprite 3 to Dy,Dx,SpWater0,7
    if Dy >= 62 then DropT = 2
  end if
  if DropT >= 2 then
    V = DropT - 2
    V = V / 6
    V = V << 2
    V += SpPuff0
    set sprite 3 to 60,Dx,V,15
    inc DropT
    if DropT >= 20 then
      DropT = 0
      hide sprite 3
    end if
  end if
  update sprites
  return
end sub

' text pages (generated by _common/tools/textpages.py)
sub PageCredits:
  print at 12,2, "CANADAIR"
  print at 8,5, "ORIGINAL GAME BY"
  print at 6,6, "JEAN-FRANCOIS SEHAN"
  print at 7,8, "L'ORIC A L'AFFICHE"
  print at 3,9, "(EDITIONS DU P.S.I., 1984)"
  print at 6,12, "COLECOVISION VERSION"
  print at 7,14, "AMY & CLAUDE 2026"
  print at 2,16, "MADE IN AMY WITH AMY STUDIO"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp1:
  print at 8,1, "HOW TO PLAY  1/2"
  print at 2,3, "THE FOREST IS ON FIRE!"
  print at 2,4, "FLY YOUR CANADAIR OVER IT"
  print at 2,5, "AND DROP WATER ON FLAMES."
  print at 2,7, "THE PLANE FLIES BY ITSELF"
  print at 2,8, "AND GOES ONE ROW LOWER AT"
  print at 2,9, "EACH TURN ON THE LEFT."
  print at 2,10, "DO NOT HIT A FLAME!"
  print at 2,12, "EACH SPLASH PUTS OUT THREE"
  print at 2,13, "ROWS OF FIRE. PUT OUT EVERY"
  print at 2,14, "FLAME, OR FLY DOWN TO THE"
  print at 2,15, "TREES, TO SAVE THE FOREST."
  print at 2,16, "TIP: TALLEST FLAMES FIRST!"
  print at 9,22, "PRESS A BUTTON"
  return
end sub

sub PageHelp2:
  print at 8,1, "HOW TO PLAY  2/2"
  print at 6,3, "BUTTON: DROP WATER"
  print at 6,5, "PUSH AHEAD: FASTER"
  print at 6,6, "PUSH BACK: SLOWER"
  print at 6,8, "WATER IN THE TANK. THE"
  print at 6,9, "LAKE ON THE LEFT FILLS"
  print at 6,10, "IT AT EACH TURN."
  print at 6,12, "PLANES LEFT"
  print at 6,14, "FLAMES: DO NOT TOUCH"
  print at 6,16, "SMOKE: HARMLESS"
  print at 2,18, "LATER FORESTS: TALLER"
  print at 2,19, "FLAMES THAT GROW BACK,"
  print at 2,20, "AND A FASTER PLANE."
  print at 9,22, "PRESS A BUTTON"
  return
end sub

