u8 X = 96
u8 DX = 1

data DotSprite bytes
  $18,$3C,$7E,$FF,$FF,$7E,$3C,$18
end data

' Move one sprite through another and watch the VDP collision bit.
  text screen
  sprites 8x8
  sprites simple
  copy DotSprite to vram.spr_pat
  clear sprites
  set sprite count 2
  print at 8,3, "COLLISION TEST"
  print at 14,15, "NO "
  set sprite 0 to 95,120,0,15
  set sprite 1 to 95,X,0,6
  update sprites
  screen on
MainLoop:
  wait
  bounce X by DX between 96 and 144
  set sprite 1 to 95,X,0,6
  update sprites
  if any collision then
    print at 14,15, "HIT"
  else
    print at 14,15, "NO "
  end if
  goto MainLoop