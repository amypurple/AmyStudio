cartridge "THE NUMBER GAME/PRESENTS LOU TYLEE'S/1984"

' THE NUMBER GAME (LEARN THE NUMBERS)
' By Lou Tylee, COMPUTE! magazine, October 1984: Program 1, "TI Number
' Game", for TI BASIC or Extended BASIC. All credit belongs to Lou Tylee.
'
' Historical context (summary of the article):
' The TI-99/4A's own digits are too small to catch a small child's eye,
' so the article defines digits three times taller and wider, each made
' of nine characters in a 3 x 3 block, shaped like the digits on the TI
' keyboard so a young child can match them by pattern; a digital-watch
' style would suit older children. Only 54 of the 90 characters are
' different, and the article shows how to redefine characters on the fly
' so a program needs only nine codes per digit on screen. The sample
' program is a preschool game: the computer shows a large digit and the
' child finds that key on the keyboard. A right answer wins a snappy tune
' and as many blocks as the number; a wrong one gets an "uh-oh" and
' another try. The space bar ends the game.
'
' ColecoVision port in Amy by Amy Bienvenu, 2026.
' Controls: the keypad of either controller: press the digit shown;
' * ends the game (the TI's space bar).
' The rules follow the listing: a random digit 0-9, never the same twice
' in a row (lines 810-830), shown large at the centre with "PRESS THIS
' NUMBER .." (lines 840-920); the key pressed is shown beside it (line
' 1020); a right answer prints "K BLOCKS:" ("1 BLOCK:") and draws K blocks
' with a tone each, then plays the tune (lines 1040-1250); a wrong one
' plays two falling tones and waits for another try (lines 1260-1300);
' the tune and tones of lines 970, 1170, 1270-1280 and 1320-1410.
' Adaptation liberties: the computer says each number aloud when it
' appears, counts the blocks aloud as they are drawn, and says "uh-oh"
' on a wrong key; the voice is a formant synthesizer written for this
' port (`tools/synthesize-number-game-voices.py`, in the robotic style of
' 1984 speech chips),
' converted with Amy Studio's VoxPCM encoder. The big digits are drawn
' fresh (24 x 24 from a bold font, each digit its own color) rather than
' read from the scan's 54 character definitions; Graphics II has room
' for all ninety tiles at once, so the dynamic redefinition is not needed.
' An editorial page. The keypad replaces the keyboard, which suits small
' hands.
' Screen: title row 3; the digit on columns 14-16, rows 7-9; messages
' rows 12-15; blocks on rows 17-18.

const BlockTile = 218

' Sound table slots (ng/s.mjs)
const SndTuneA = 1
const SndTuneB = 2
const SndTuneC = 3
const SndKey = 4
const SndBlock = 5
const SndWrong = 6

u8 K = 0                       ' the number shown
u8 TM = 255                    ' the previous one
u8 Key = 255
u8 NB = 0
u8 BC = 0
u8 I = 0
u8 J = 0
u8 N = 0
u8 X = 0
u8 Y = 0
u16 Dst16 = 0

  tile screen
  set sound table NumberSoundTable areas 3
  LoadTiles
  screen on
  EditorialPage

title:
  ' --- Lines 520-720: the title and how to play ---
  TitlePage

new_number:
  ' --- Lines 750-920: a new number ---
  DrawScreen
  K = random(0, 9)
  if K = TM then goto new_number
  TM = K
  DrawDigit
  print at 6,12, "PRESS THIS NUMBER .."
  play voxpcm SayTable[K]

ask:
  ' --- Lines 940-1020: the answer ---
  Key = 255
  wait no fire
read_key:
  wait
  Key = keypad(1)
  if Key = 255 then Key = keypad(2)
  if Key = 255 then goto read_key
  if Key = 11 then goto read_key
  play sound SndKey
  if Key = 10 then goto title
  N = Key + 48
  put char N at 26,12
  ' Wait for the key to be let go
release:
  wait
  N = keypad(1)
  if N <> 255 then goto release
  N = keypad(2)
  if N <> 255 then goto release
  if Key <> K then goto wrong

  ' --- Lines 1040-1250: right! K blocks and the tune ---
  if K = 1 then
    print at 6,14, "1 BLOCK:"
  else
    N = K + 48
    put char N at 6,14
    print at 8,14, "BLOCKS:"
  end if
  play voxpcm SayTable[K]
  BC = 4
  if K > 0 then
    for NB = 1 to K
      put char BlockTile at BC,17
      X = BC + 1
      put char BlockTile at X,17
      put char BlockTile at BC,18
      put char BlockTile at X,18
      play sound SndBlock
      ' Adaptation: the blocks are counted aloud
      play voxpcm SayTable[NB]
      wait 6 frames
      BC += 3
    next
  end if
  play sounds SndTuneA, SndTuneB, SndTuneC
  wait 160 frames
  goto new_number

  ' --- Lines 1260-1300: wrong, try again ---
wrong:
  play sound SndWrong
  wait 14 frames
  play voxpcm SayUhoh
  wait 20 frames
  put char 32 at 26,12
  goto ask

' ---------------------------------------------------------------------------

' Lines 1500-1590: digit K at rows 7-9, columns 14-16
sub DrawDigit:
  N = K * 9
  N += 128
  for Y = 7 to 9
    for X = 14 to 16
      put char N at X,Y
      inc N
    next
  next
  return
end sub

sub DrawScreen:
  nmi on
  fill mode 2 text color with $10
  LoadTiles
  cls
  backdrop white
  print at 8,3, "LEARN THE NUMBERS"
  print at 5,22, "PRESS * TO STOP THE GAME"
  return
end sub

' Graphics II: tiles 128-218 with their row colors, in all three thirds
sub LoadTiles:
  Dst16 = 1024
  for J = 0 to 2
    copy TilePat count 728 to vram.pattern + Dst16
    copy TileCol count 728 to vram.color + Dst16
    Dst16 += 2048
  next
  return
end sub

' Lines 540-720
sub TitlePage:
  nmi on
  fill mode 2 text color with $10
  LoadTiles
  cls
  backdrop light yellow
  print at 7,1, "LEARN THE NUMBERS"
  print at 2,3, "THIS IS A PRE-SCHOOL NUMBER"
  print at 2,4, "RECOGNITION GAME. THE"
  print at 2,5, "COMPUTER SHOWS A NUMBER AND"
  print at 2,6, "YOU MUST FIND AND PRESS THAT"
  print at 2,7, "KEY ON YOUR KEYPAD."
  print at 2,9, "IF CORRECT, THAT NUMBER OF"
  print at 2,10, "BLOCKS IS DRAWN AND YOU ARE"
  print at 2,11, "GIVEN ANOTHER NUMBER. IF NOT"
  print at 2,12, "CORRECT, THE COMPUTER WILL"
  print at 2,13, "ASK YOU FOR ANOTHER ANSWER."
  print at 2,15, "TO STOP THE GAME, PRESS *"
  print at 2,16, "WHEN ASKED FOR AN ANSWER."
  print at 3,21, "PRESS ANY KEY OR FIRE"
  play sounds SndTuneA, SndTuneB, SndTuneC
  wait no fire
wait_start:
  wait
  if joypad(1).fire then goto start_go
  if joypad(2).fire then goto start_go
  N = keypad(1)
  if N <> 255 then goto start_go
  N = keypad(2)
  if N <> 255 then goto start_go
  goto wait_start
start_go:
  play sound SndKey
release_start:
  wait
  N = keypad(1)
  if N <> 255 then goto release_start
  wait no fire
  return
end sub

' Adaptation: an editorial page at power-on
sub EditorialPage:
  fill mode 2 text color with $10
  LoadTiles
  backdrop white
  cls
  print at 8,1, "THE NUMBER GAME"
  print at 9,3, "BY LOU TYLEE"
  print at 5,4, "COMPUTE! OCTOBER 1984"
  print at 2,6, "BIG DIGITS FOR SMALL"
  print at 2,7, "CHILDREN: THREE TIMES"
  print at 2,8, "TALLER AND WIDER THAN THE"
  print at 2,9, "TI-99/4A'S OWN, IN A GAME"
  print at 2,10, "THAT TEACHES THE NUMBERS."
  print at 2,12, "HERE THE COMPUTER ALSO SAYS"
  print at 2,13, "EACH NUMBER, AND COUNTS THE"
  print at 2,14, "BLOCKS OUT LOUD."
  print at 4,22, "PRESS FIRE TO CONTINUE"
  pause until press
  wait no fire
  return
end sub

