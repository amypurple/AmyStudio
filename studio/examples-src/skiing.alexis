data SlopeP bytes
  $01,$0A,$12,$17,$19,$17,$12,$0A,$00,$F6,$EE,$E9,$E7,$E9,$EE,$F6
  $FF,$00,$00,$01,$0A,$10,$10,$0A,$00,$F6,$F0,$F0,$F6,$FF,$00,$00
end data

data StageAv bytes 16, 18, 21
data StageW bytes 100, 84, 70
data StageGap bytes 30, 24, 20
data StageCurve bytes 24, 36, 48
data KindPat bytes 0, STree0, SRock0, SFlag0, SFlag0, SChalet0, SSkier0
data FwCols bytes 8, 11, 7, 13, 3, 15, 9, 10
data KindCol bytes 0, 12, 1, 8, 8, 6, 4

' the world
i16 Px = 0
i16 Cq = 0
i16 CqTo = 0
i16 Wd = 100
i16 Gap = 0
i16 Hs = 0
i16 Hw = 0
i16 Dl = 0
i16 Dr = 0
i16 Co = 0
i16 Iv = 0
i16 Xw = 0
i16 Tw = 0
i16 Drift = 0
i16 Mx = 0
i16 My = 0
i16 Mz = 0
u16 Pos = 0
' the hills: this phase's tables (addresses in LineD, RowI, RowK, ObjY)
u16 PhL = 0
u16 PhI = 0
u16 PhK = 0
u16 PhY = 0
u8 Ph = 255
u16 Off16 = 0
u8 Slope = 0
u16 Spd = 0
u16 Tgt = 0
u16 Dist = 0
u16 DSub = 0
u16 StLen = 0
u16 SpawnAcc = 0
u16 CurveAcc = 0
u16 Score = 0
u16 Best = 0
u16 Gates = 0
u16 Missed = 0
u16 GatesAt = 0
u16 Fn = 0
' the fireworks: state (0 idle, 1 rising, 100+ bursting), place, top, colour
u8 FwT[4]
u8 FwX[4]
u8 FwY[4]
u8 FwTop[4]
u8 FwC[4]
u8 FwWait = 0
u8 FwBusy = 0
u8 Flash = 0
u8 Why = 0
u8 V2 = 0
u16 Dz = 0
u16 Ma = 0
u16 Mb = 0
u16 OffW = 0
u16 Addr = 0
u16 Uw = 0
u16 NumU = 0
u16 Rs = $2C51
u16 Rt = 0
u8 Rb = 0
u8 Stage = 0
u8 AvS = 0
u8 Cr = 0
u8 Pose = 0
u8 OldPose = 0
u8 Whoosh = 0
u8 Air = 0
u8 AirT = 0
u8 OldPh = 0
u8 Lift = 0
' the trick: frames the skis were held crossed in this jump
u8 Trick = 0
' the airborne hum is sounding
u8 Hum = 0
' the trick's reward: frames left of the sparkles flying to the scoreboard
u8 Pf = 0
u8 Ys = 167
' the game: 0 Avalanche Run (the story), 1 Ski Trails, 2 Slalom
u8 Game = 0
u16 Tm = 0
u8 TmF = 0
u16 BestT = 0
u16 BestS = 0
u8 ODx[4]
i16 Vx = 0
i16 Sl = 0
u8 Spray = 0
u8 Forest = 0
u8 ChaletOut = 0
u8 Done = 0
u8 Rumble = 0
u8 RumbleT = 0
u8 Mo = 255
u8 HudT = 0
u8 Late = 0
u8 Passes = 0
u8 Gcol = 0
u8 Oslot = 0

' the four objects: kind, depth x16, lateral place
u8 OKind[4]
u8 OCol[4]
' their sprites: row, column, pattern, colour
u8 SprY[4]
u8 SprX[4]
u8 SprP[4]
u8 SprC[4]
u16 OZ[4]
i16 OX[4]
' each ground row's edges last drawn, in half tiles
u8 LhOld[16]
u8 RhOld[16]
' one ground row's colours, four tiles of eight lines
u8 Lb[32]
' the colours last sent for each ground row's eight lines
u8 Cache[128]
u8 StN = 0
u8 StAll = 0
u8 StOdd = 0
u8 StD = 0
u16 StC = 0
' the piste's half width on each ground row, in pixels
u8 WdR[16]
i16 EC1 = 0
u8 EOl = 0
u8 EOr = 0
u8 ELc = 0
u8 ELh = 0
u8 ERc = 0
u8 ERh = 0
u8 EGs = 0
u16 ENam = 0
i16 EPx = 0
i16 ECq = 0
i16 EBase = 0

' scratch, kept to their own subs
u8 Rk = 0
u8 Rw = 0
u8 Ln = 0
u8 Lj = 0
u8 J0 = 0
u8 Cc = 0
u8 Hl = 0
u8 Hr = 0
u8 Lc = 0
u8 Lh = 0
u8 Rc = 0
u8 Rh = 0
u8 Gs = 0
u8 Gf = 0
u8 Gl = 0
u8 Gr = 0
u8 Cb = 0
u8 Nn = 0
u8 Oi = 0
u8 Ok = 0
u8 Zb = 0
u8 Sv = 0
u8 Yv = 0
u8 Sp = 0
u8 Pt = 0
u8 Pc = 0
u8 Xb = 0
u8 Free = 0
u8 Sk = 0
u8 Ty = 0
u16 Oz0 = 0
u16 Oz1 = 0

' input and menus
u8 Menu = 0
' the title menu: its level (0 PLAY/CREDITS, 1 the games, 2 START/HOW TO
' PLAY/BACK for the game chosen), and what was asked (1 start, 2 how to
' play, 3 credits)
u8 Lv = 0
u8 Act = 0
u8 Mode = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  ' each third of the screen gets its own colour table (the ground rows
  ' need their own colours)
  call asm ArThirds
  set sound table ArSoundTable areas 4
  sprites 16x16
  sprites double
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Act = 2 then
    RulesPage
    goto title
  end if
  if Act = 3 then
    CreditsPage
    goto title
  end if

  ' a new game
  Stage = 0
  Score = 0
  Gates = 0

stage_start:
  NewStage
  SlopeScreen
  StageIntro
  Mode = 1

run:
  ' a steady 30 passes a second: never sooner than two frames
  ' (ArLate: has the screen started a new frame while this pass worked?)
  call asm ArLate
  if Late = 0 then Frame1
  Frame1
  inc Passes
  update sprites
  HillPhase
  Stripes
  Edges
  Mountains
  ' the HUD, one line a pass, every few passes
  inc HudT
  if HudT = 3 then HudTop
  if HudT >= 6 then
    HudT = 0
    HudLow
  end if
  ReadPad
  Ride
  Objects
  if Game = 0 then
    Avalanche
  else
    Clock
  end if
  Skis
  if Done = 1 then goto stage_clear
  if Done = 2 then goto buried
  goto run

stage_clear:
  Mode = 0
  mute all
  TzOn = 0
  Rumble = 0
  play sound SndVillage
  if Game > 0 then goto run_done
  ' the bonus: what is left of the avalanche's gap
  Uw = Gap
  Uw = Uw >> 4
  Score = Score + Uw
  Hud
  ClearSky
  ' a firework for every gate skied on this stage (five more at the end)
  Fn = Gates - GatesAt
  if Stage = 2 then Fn = Fn + 5
  if Fn > 20 then Fn = 20
  Fireworks
  inc Stage
  if Stage = 3 then goto won
  print at 3,3, "VILLAGE WARNED!  BONUS"
  NumU = Uw
  print at 25,3, width$(NumU, 4)
  print at 3,4, "ON TO THE NEXT ONE..."
  Pause
  Pause
  goto stage_start

won:
  print at 3,3, "THE LAST VILLAGE IS SAFE:"
  print at 3,4, "ALL ARE SHELTERED IN TIME!"
  Pause
  Pause
  goto final

buried:
  Mode = 0
  mute all
  TzOn = 0
  Rumble = 0
  play sound SndBuried
  Whiteout
  fill $1F count 1024 to vram.color + 2048
  print at 7,10, "BURIED BY THE"
  print at 7,11, "AVALANCHE!"
  Pause
  Pause
  goto final

' the end of a timed run (Ski Trails, Slalom): the time, the best
run_done:
  fill 32 count 32 at 0,1
  fill 32 count 32 at 0,2
  ClearSky
  if Game = 1 then print at 4,1, "SKI TRAILS: AT THE BOTTOM!"
  if Game = 2 then
    print at 4,1, "SLALOM DONE. GATES MISSED"
    NumU = Missed
    print at 30,1, digits$(NumU, 1)
  end if
  print at 4,3, "TIME"
  TimeAt
  print at 4,4, "BEST"
  Uw = BestT
  if Game = 2 then Uw = BestS
  if Uw = 0 then Uw = Tm
  if Tm < Uw then Uw = Tm
  if Game = 1 then BestT = Uw
  if Game = 2 then BestS = Uw
  Tw = Tm
  Tm = Uw
  X = 9
  Y = 4
  ShowTime
  Tm = Tw
  Pause
  Pause
  goto title

final:
  if Score > Best then Best = Score
  ' the results: in the sky, or on the snow that buried you
  if Done = 2 then
    Y = 13
  else
    ClearSky
    Y = 3
  end if
  print at 4,Y, "SCORE"
  NumU = Score
  print at 10,Y, width$(NumU, 5)
  print at 17,Y, "BEST"
  NumU = Best
  print at 22,Y, width$(NumU, 5)
  inc Y
  print at 4,Y, "PRESS A BUTTON"
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
end_wait:
  Frame1
  ReadPad
  if Press = 0 then goto end_wait
  goto title

' ---------------------------------------------------------------------------
' The run

sub NewStage:
  Pf = 0
  GatesAt = Gates
  AvS = StageAv[Stage]
  V = StageW[Stage]
  Wd = V
  WidthRows
  Px = 0
  Cq = 0
  CqTo = 0
  Hs = 0
  Spd = 6
  Gap = 2400
  Dist = 0
  DSub = 0
  SpawnAcc = 0
  CurveAcc = 0
  ChaletOut = 0
  Done = 0
  Cr = 0
  Pose = 0
  Forest = 0
  Rumble = 0
  StLen = 2400
  if Stage = 1 then StLen = 2800
  if Stage = 2 then StLen = 3200
  Tm = 0
  TmF = 0
  Vx = 0
  Air = 0
  if Game = 1 then
    StLen = 2600
    Wd = 110
    WidthRows
  end if
  if Game = 2 then
    StLen = 2200
    Wd = 96
    WidthRows
  end if
  for Oi = 0 to 3
    OKind[Oi] = 0
  next
  return
end sub

' Ride: the player's speed, steering, the curve's pull and the distance
sub Ride:
  Pose = 0
  if Cr > 0 then
    ' fallen: up again after a while
    dec Cr
    Spd = 0
    Pose = 3
    if Cr = 0 then Spd = 4
    goto ride_move
  end if
  Tgt = 18
  if Up1 = 1 then Tgt = 26
  if Dn1 = 1 then Tgt = 6
  ' in the forest: deep snow, and the trees are close
  Forest = 0
  Tw = Px
  if Tw < 0 then Tw = 0 - Tw
  if Tw > Wd then
    Forest = 1
    if Tgt > 8 then Tgt = 8
    Rnd
    if Rb < 4 then
      if Spd > 4 then
        Why = 2
        Fall
        return
      end if
    end if
  end if
  ' the hills: downhill pulls you faster, uphill holds you back
  Sl = Slope
  if Slope > 127 then Sl = Sl - 256
  Tw = Sl / 2
  Tw = Tgt - Tw
  if Tw < 2 then Tw = 2
  Tgt = Tw
  if Spd < Tgt then
    V = Passes & 1
    if V = 0 then inc Spd
  else
    if Spd > Tgt then
      dec Spd
    end if
  end if
  ' a crest taken fast throws you into the air: no steering up there, the
  ' skis keep the slide they had; you land where it takes you
  if Air > 0 then
    dec Air
    Pose = 0
    Spray = 0
    Tw = Vx / 16
    Px = Px + Tw
    ' fire held in the air crosses the skis; let go before landing
    if Btn = 1 then
      if Trick < 99 then inc Trick
    end if
    if Air = 0 then
      if Btn = 1 then
        if Trick > 0 then
          ' landed with the skis crossed
          Trick = 0
          Fall
          goto air_done
        end if
      end if
      play sound SndLand
      Whoosh = 10
      if Trick >= 8 then
        Score = Score + 50
        ' in the timed runs a clean trick takes a second off the clock
        if Game > 0 then
          if Tm >= 10 then Tm = Tm - 10
        end if
        ' the reward: a bright arpeggio, the words, and two sparkles that
        ' fly from the skis up to the scoreboard
        play sound SndTrick
        if Game = 0 then
          print at 3,3, "TRICK! +50 "
        else
          print at 3,3, "TRICK! -1 SECOND"
        end if
        Pf = 14
      end if
      Trick = 0
    end if
    goto air_done
  end if
  if Ph = 9 then
    if OldPh = 8 then
      if Spd > 18 then
        Air = Spd - 12
        Air = Air * 3
        if Air > 42 then Air = 42
        AirT = Air
        Trick = 0
        play sound SndLift
        Whoosh = 20
        Rumble = 0
      end if
    end if
  end if
  ' the small crest: a short hop when taken fast (at top speed the big
  ' jump usually carries you right over it)
  if Ph = 25 then
    if OldPh = 24 then
      if Spd > 20 then
        Air = Spd - 18
        Air = Air * 3
        if Air > 18 then Air = 18
        AirT = Air
        Trick = 0
        play sound SndLift
        Whoosh = 12
        Rumble = 0
      end if
    end if
  end if
  ' steering: the skis push sideways, but the faster you go the less they
  ' bite, so at speed a turn takes a while and you drift (Vx in 1/16 px)
  Tw = Spd >> 1
  Tw = 26 - Tw
  if Tw < 3 then Tw = 3
  if Lf1 = 1 then
    Vx = Vx - Tw
    Pose = 1
  end if
  if Rt1 = 1 then
    Vx = Vx + Tw
    Pose = 2
  end if
  ' the snow slows the sideways slide: quickly when slow, little when fast
  Tw = Vx / 4
  if Spd > 16 then Tw = Vx / 12
  if Pose = 0 then Tw = Vx / 6
  Vx = Vx - Tw
  if Vx > 72 then Vx = 72
  if Vx < -72 then Vx = -72
  Tw = Vx / 16
  Px = Px + Tw
  ' a hard turn at speed throws up snow
  Spray = 0
  if Spd > 18 then
    if Pose > 0 then
      Tw = Vx
      if Tw < 0 then Tw = 0 - Tw
      if Tw > 30 then Spray = Pose
    end if
  end if
air_done:
  OldPh = Ph
  ' the skis bite as a turn begins
  if Pose > 0 then
    if Pose <> OldPose then
      ' a whoosh of snow (on the noise channel: the rumble waits)
      play sound SndSwish
      Whoosh = 12
      Rumble = 0
    end if
  end if
  OldPose = Pose
  ' the curve pulls you to its outside
  Drift = Spd
  Mx = Drift
  My = Cq
  call asm ArMul
  Drift = Mz
  Drift = Drift / 512
  Px = Px - Drift
  Tw = Wd + 60
  if Px > Tw then
    Px = Tw
  else
    Tw = 0 - Tw
    if Px < Tw then Px = Tw
  end if
ride_move:
  Pos = Pos + Spd
  DSub = DSub + Spd
  Uw = DSub >> 4
  DSub = DSub & 15
  Dist = Dist + Uw
  SpawnAcc = SpawnAcc + Uw
  CurveAcc = CurveAcc + Uw
  ' the horizon turns with the curve
  Tw = Spd
  Mx = Tw
  My = Cq
  call asm ArMul
  Tw = Mz
  Tw = Tw / 32
  Hs = Hs + Tw
  ' a new bend every 200 metres; the piste eases into it
  if CurveAcc >= 200 then
    CurveAcc = 0
    Rnd
    V = StageCurve[Stage]
    Uw = Rb
    W = V << 1
    Mx = Uw
    My = W
    call asm ArMul
    Uw = Mz
    Uw = Uw >> 8
    CqTo = Uw
    Tw = V
    CqTo = CqTo - Tw
    Rnd
    if Rb < 70 then CqTo = 0
  end if
  V = Passes & 1
  if V = 0 then
    if Cq < CqTo then
      inc Cq
    else
      if Cq > CqTo then dec Cq
    end if
  end if
  return
end sub

sub Fall:
  play sound SndCrash
  Vx = 0
  Spray = 0
  Rumble = 0
  Cr = 60
  Spd = 0
  return
end sub

' Avalanche: it runs at its own steady speed; the gap is what you keep
sub Avalanche:
  Tw = Spd
  Gap = Gap + Tw
  Tw = AvS
  Gap = Gap - Tw
  if Gap > 3200 then Gap = 3200
  if Gap <= 0 then
    Gap = 0
    Done = 2
    return
  end if
  if Whoosh > 0 then
    dec Whoosh
    return
  end if
  ' one long rumble, louder as it comes
  W = 1
  if Gap < 2000 then W = 2
  if Gap < 900 then W = 3
  if W <> Rumble then
    Rumble = W
    RumbleT = 0
    if W = 1 then play sound SndRumbleFar
    if W = 2 then play sound SndRumbleNear
    if W = 3 then play sound SndRumbleHere
    return
  end if
  inc RumbleT
  if RumbleT >= 110 then
    RumbleT = 0
    if W = 1 then play sound SndRumbleFar
    if W = 2 then play sound SndRumbleNear
    if W = 3 then play sound SndRumbleHere
  end if
  return
end sub

' Objects: move them toward the player, test what is passed, place the
' sprites, and bring new ones over the brow
sub Objects:
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok > 0 then
      Oz0 = OZ[Oi]
      if Oz0 > Spd then
        Oz1 = Oz0 - Spd
      else
        Oz1 = 0
      end if
      OZ[Oi] = Oz1
      if Ok = KSkier then
        Tw = ODx[Oi]
        if Tw > 127 then Tw = Tw - 256
        Tw = Tw + OX[Oi]
        OX[Oi] = Tw
      end if
      ' passing the ski tips (depth 7)
      if Oz0 >= 112 then
        if Oz1 < 112 then Pass
      end if
      if Oz1 < 80 then
        OKind[Oi] = 0
        Ok = 0
      end if
    end if
  next
  ProjectAll
  ' a new object every so often
  V = StageGap[Stage]
  Uw = V
  if SpawnAcc >= Uw then
    SpawnAcc = 0
    Spawn
  end if
  return
end sub

' Pass: object Oi reaches the skis
sub Pass:
  Tw = OX[Oi]
  Tw = Tw - Px
  if Ok = KFlagL then
    ' the gate: between this flag and its pair, 40 to the right
    if Tw < 0 then
      Tw = 0 - Tw
      if Tw < 40 then
        play sound SndGate
        inc Gates
        Score = Score + 100
        Spd = Spd + 4
        return
      end if
    end if
    play sound SndMiss
    inc Missed
    if Game = 2 then Tm = Tm + 50
    return
  end if
  if Ok = KFlagR then return
  ' the village: the end of the stage
  if Ok = KChalet then
    Done = 1
    return
  end if
  if Cr > 0 then return
  ' in the air, you fly over it
  if Air > 0 then return
  if Tw < 0 then Tw = 0 - Tw
  if Ok = KSkier then
    if Tw < 16 then
      Why = 3
      Fall
    end if
    return
  end if
  if Tw < 10 then
    Why = 1
    Fall
  end if
  return
end sub

' ProjectAll: the four objects' sprites (2-5), placed by ArProject from
' their depth and place, the player's place and the curve
sub ProjectAll:
  call asm ArProject
  for Oi = 0 to 3
    Sp = Oi + 2
    Yv = SprY[Oi]
    Xb = SprX[Oi]
    Pt = SprP[Oi]
    Pc = SprC[Oi]
    set sprite Sp to Yv, Xb, Pt, Pc
  next
  return
end sub

' Spawn: something new at depth 80, as far as the eye can see
sub Spawn:
  ' how many free places
  Free = 0
  Oslot = 255
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok = 0 then
      inc Free
      Oslot = Oi
    end if
  next
  if Free = 0 then return
  Oi = Oslot
  ' near the end, only the village's chalet comes
  Uw = StLen - 60
  if Dist >= Uw then
    ' the village
    if ChaletOut = 0 then
      ChaletOut = 1
      OKind[Oi] = KChalet
      OCol[Oi] = 6
      OZ[Oi] = 1280
      OX[Oi] = 0
    end if
    return
  end if
  ChaletOut = 0
  Rnd
  Ty = Rb & 15
  ' Slalom: gates, gates, and a pine at the side now and then
  if Game = 2 then
    if Ty < 12 then
      if Free >= 2 then goto sp_gate
    end if
    Ty = 0
  end if
  ' Ski Trails: no gates; other skiers cut across
  if Game = 1 then
    if Ty >= 12 then goto sp_skier
    if Ty >= 10 then Ty = 0
  end if
  if Ty >= 10 then
    if Free >= 2 then goto sp_gate
    Ty = 0
  end if
  if Ty <= 3 then
    ' a pine just off the piste
    Rnd
    Tw = Rb & 31
    Tw = Tw + Wd
    Tw = Tw + 6
    V = Rb & 128
    if V > 0 then Tw = 0 - Tw
    OKind[Oi] = KTree
    OCol[Oi] = 12
    OZ[Oi] = 1280
    OX[Oi] = Tw
    return
  end if
  ' a pine or a rock on the piste
  Ok = KTree
  if Ty >= 7 then Ok = KRock
  Lateral
  OKind[Oi] = Ok
  V = KindCol[Ok]
  OCol[Oi] = V
  OZ[Oi] = 1280
  OX[Oi] = Tw
  return
sp_skier:
  ' another skier, coming in from one side across the piste
  Rnd
  Tw = Wd + 30
  V = Rb & 1
  W = 2
  V2 = Rb & 64
  if V2 > 0 then W = 3
  if V = 1 then
    Tw = 0 - Tw
  else
    W = 0 - W
  end if
  OKind[Oi] = KSkier
  OCol[Oi] = 4
  OZ[Oi] = 1280
  OX[Oi] = Tw
  ODx[Oi] = W
  return
sp_gate:
  ' a gate: two flags 40 apart, the pair inside the piste
  Lateral
  if Tw > 0 then Tw = Tw - 30
  Tw = Tw / 2
  Gcol = Gcol ^ 1
  Pc = 8
  if Gcol = 1 then Pc = 4
  OKind[Oi] = KFlagL
  OCol[Oi] = Pc
  OZ[Oi] = 1280
  OX[Oi] = Tw
  for Oi = 0 to 3
    Ok = OKind[Oi]
    if Ok = 0 then
      OKind[Oi] = KFlagR
      OCol[Oi] = Pc
      OZ[Oi] = 1280
      Tw = Tw + 40
      OX[Oi] = Tw
      return
    end if
  next
  return
end sub

' Lateral: Tw = a random place on the piste, 10 in from either edge
sub Lateral:
  Rnd
  Tw = Wd << 1
  Tw = Tw - 20
  Uw = Tw
  NumU = Rb
  Mx = Uw
  My = NumU
  call asm ArMul
  Uw = Mz
  Uw = Uw >> 8
  Tw = Uw
  Tw = Tw - Wd
  Tw = Tw + 10
  return
end sub

' Fireworks: Fn rockets over the village, up to four in the air at once;
' each rises with a whistle and bursts in its own colour with a crackle,
' lighting up the sky
sub Fireworks:
  for Oi = 0 to 3
    FwT[Oi] = 0
    Sp = Oi + 2
    set sprite Sp to 192, 0, 0, 0
  next
  FwWait = 0
fw_frame:
  Frame1
  ' a new rocket every 14 frames
  if FwWait > 0 then dec FwWait
  if Fn > 0 then
    if FwWait = 0 then
      for Oi = 0 to 3
        V = FwT[Oi]
        if V = 0 then
          if FwWait = 0 then
            FwT[Oi] = 1
            Rnd
            V = Rb >> 1
            V = V + 48
            FwX[Oi] = V
            FwY[Oi] = 150
            Rnd
            V = Rb & 15
            V = V + 36
            FwTop[Oi] = V
            V = Rb & 7
            W = FwCols[V]
            FwC[Oi] = W
            play sound SndLaunch
            FwWait = 14
            dec Fn
          end if
        end if
      next
    end if
  end if
  FwBusy = 0
  for Oi = 0 to 3
    Sp = Oi + 2
    V = FwT[Oi]
    if V > 0 then
      FwBusy = 1
      if V < 100 then
        ' rising
        Y = FwY[Oi]
        Y = Y - 5
        FwY[Oi] = Y
        W = FwTop[Oi]
        if Y <= W then
          FwT[Oi] = 100
          play sound SndPop
          ' the sky lights up
          Flash = 3
          V = FwC[Oi]
          call asm ArBackdrop
        end if
        X = FwX[Oi]
        set sprite Sp to Y, X, SRocket, 11
      else
        ' bursting: four sizes, five frames each, then gone
        inc V
        FwT[Oi] = V
        W = V - 100
        W = W / 5
        if W >= 4 then
          FwT[Oi] = 0
          set sprite Sp to 192, 0, 0, 0
        else
          Pt = W << 2
          Pt = Pt + SBurst0
          Y = FwY[Oi]
          Y = Y - 16
          X = FwX[Oi]
          X = X - 16
          Pc = FwC[Oi]
          ' the last sparks twinkle
          if W = 3 then
            K = V & 2
            if K = 0 then Pc = 15
          end if
          set sprite Sp to Y, X, Pt, Pc
        end if
      end if
    end if
  next
  if Flash > 0 then
    dec Flash
    if Flash = 0 then backdrop light blue
  end if
  update sprites
  if Fn > 0 then goto fw_frame
  if FwBusy = 1 then goto fw_frame
  return
end sub

' Skis: the two ski tips at the bottom of the screen
sub Skis:
  ' the jump: up and down along a parabola, AirT frames long
  Lift = 0
  if Air > 0 then
    V = AirT - Air
    W = Air
    Mx = V
    My = W
    call asm ArMul
    Uw = Mz
    Uw = Uw >> 3
    Lift = Uw
    if Lift > 52 then Lift = 52
    ' a soft hum that rises with the skis and falls as they come down
    Uw = Lift
    Uw = Uw * 4
    Uw = 360 - Uw
    V = 11
    call asm ArAirTone
    Hum = 1
  else
    if Hum = 1 then
      Uw = 360
      V = 15
      call asm ArAirTone
      Hum = 0
    end if
  end if
  Ys = 167 - Lift
  Sk = SSkia
  if Pose = 1 then Sk = SSkila
  if Pose = 2 then Sk = SSkira
  if Pose = 3 then Sk = SSkixa
  V = Sk + 4
  if Pose = 3 then
    set sprite 0 to 167, 112, Sk, 8
    set sprite 1 to 167, 112, V, 8
  else
    set sprite 0 to Ys, 96, Sk, 8
    set sprite 1 to Ys, 128, V, 8
  end if
  ' in the air each ski is two magnified sprites (front, and back 32 lines
  ' lower: 48 lines in all) with its boot, a dark sprite, on top
  if Lift > 2 then
    Ys = 142 - Lift
    W = Ys + 32
    if Btn = 1 then
      ' the trick: the skis crossed in an X
      set sprite 0 to Ys, 112, STrkla, 8
      set sprite 1 to Ys, 112, STrkra, 8
      set sprite 7 to W, 112, STrklb, 8
      set sprite 8 to W, 112, STrkrb, 8
      set sprite 9 to Ys, 112, SBootal, 1
      set sprite 10 to Ys, 112, SBootar, 1
    else
      set sprite 0 to Ys, 96, SAirla, 8
      set sprite 1 to Ys, 128, SAirra, 8
      set sprite 7 to W, 96, SAirlb, 8
      set sprite 8 to W, 128, SAirrb, 8
      set sprite 9 to Ys, 96, SBootal, 1
      set sprite 10 to Ys, 128, SBootar, 1
    end if
  else
    set sprite 7 to 192, 0, SAirlb, 0
    set sprite 8 to 192, 0, SAirrb, 0
    ' on the snow, sprite 7 carries a trick's sparkle
    if Pf > 0 then
      dec Pf
      ' (14 steps of the run's own pace, which is a few frames each)
      V = 14 - Pf
      W = V * 11
      Y = 160 - W
      ' one gold sparkle, straight up from between the skis
      set sprite 7 to Y, 112, SBurst0, 10
      if Pf = 0 then print at 3,3, "                "
    end if
    set sprite 9 to 192, 0, SBootal, 0
    set sprite 10 to 192, 0, SBootar, 0
  end if
  ' the spray, thrown out on the outside of the turn
  if Spray = 1 then
    set sprite 6 to 158, 136, SSpray, 7
  else
    if Spray = 2 then
      set sprite 6 to 158, 88, SSpray, 7
    else
      set sprite 6 to 192, 0, SSpray, 0
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' The picture

' Stripes, Edges: the ground, drawn by the Z80 routines at the end (see
' the header); Amy's version of them took several frames
sub Stripes:
  call asm ArStripes
  return
end sub

' StripesAll: every row again (a new screen)
sub StripesAll:
  fill array Cache with 0
  StAll = 1
  call asm ArStripes
  StAll = 0
  return
end sub

sub Edges:
  ' nothing moved, nothing to draw
  if Px = EPx then
    if Cq = ECq then return
  end if
  EPx = Px
  ECq = Cq
  call asm ArEdges
  return
end sub

' WidthRows: the piste's half width in pixels on each ground row
sub WidthRows:
  for Rk = 0 to 15
    Off16 = PhI + Rk
    V = peek(Off16)
    Mx = Wd
    My = V
    call asm ArMul
    Xw = Mz / 64
    V = Xw
    WdR[Rk] = V
  next
  return
end sub

' HillPhase: where on the hills Pos is (32 phases a period of 2048);
' a new phase brings its perspective tables and redraws the edges
sub HillPhase:
  Uw = Pos >> 6
  Uw = Uw & 31
  V = Uw
  if V = Ph then return
  Ph = V
  Off16 = Uw << 7
  PhL = address of LineD
  PhL = PhL + Off16
  PhY = address of ObjY
  PhY = PhY + Off16
  Off16 = Uw << 4
  PhI = address of RowI
  PhI = PhI + Off16
  PhK = address of RowK
  PhK = PhK + Off16
  Slope = SlopeP[V]
  WidthRows
  EPx = 9999
  return
end sub

' Mountains: the range on the horizon, turned with the curves and your turns
sub Mountains:
  ' the bends turn you (Hs), and so does your own slide across the slope
  ' (Vx): the far range swings the other way, a tile at a time
  Tw = Hs >> 8
  Hw = Vx >> 5
  Tw = Tw + Hw
  Tw = Tw & 15
  V = Tw
  if V = Mo then return
  Mo = V
  copy MtnRow0 + Mo count 32 to vram.name + 160
  copy MtnRow1 + Mo count 32 to vram.name + 192
  copy MtnRow2 + Mo count 32 to vram.name + 224
  return
end sub

' Clock: a tenth of a second every three passes (30 passes a second)
sub Clock:
  inc TmF
  if TmF >= 3 then
    TmF = 0
    inc Tm
  end if
  return
end sub

' TimeAt: the time on the HUD (row 2, or the result line)
sub TimeAt:
  X = 18
  Y = 2
  if Mode = 0 then
    X = 9
    Y = 3
  end if
  ShowTime
  return
end sub

' ShowTime: Tm (tenths) as 000.0 at X,Y
sub ShowTime:
  Uw = Tm / 10
  NumU = Uw
  print at X,Y, width$(NumU, 3)
  Uw = Uw * 10
  Uw = Tm - Uw
  V = Uw + 48
  W = X + 3
  put char 46 at W,Y
  W = W + 1
  put char V at W,Y
  return
end sub

sub Hud:
  HudTop
  HudLow
  return
end sub

sub HudTop:
  if Game = 1 then
    print at 2,1, "TRAILS "
  else
    if Game = 2 then
      print at 2,1, "SLALOM "
    else
      print at 2,1, "STAGE"
      V = Stage + 1
      NumU = V
      print at 8,1, digits$(NumU, 1)
    end if
  end if
  print at 11,1, "GATES"
  NumU = Gates
  print at 17,1, width$(NumU, 3)
  put char THouse at 21,1
  Uw = 0
  if StLen > Dist then Uw = StLen - Dist
  NumU = Uw
  print at 22,1, width$(NumU, 4)
  print at 26,1, "M"
  return
end sub

sub HudLow:
  print at 2,2, "SPEED"
  Uw = Spd << 2
  NumU = Uw
  print at 8,2, width$(NumU, 3)
  if Game > 0 then
    print at 13,2, "TIME"
    TimeAt
    return
  end if
  print at 13,2, "AVALANCHE"
  ' eight boxes: how far behind it is
  Tw = Gap / 400
  V = Tw
  for X = 0 to 7
    W = TBarnone
    if X < V then
      W = TBarfull
      if V <= 2 then W = TBarhot
    end if
    Y = X + 22
    put char W at Y,2
  next
  return
end sub

' Whiteout: the snow comes down over everything
sub Whiteout:
  HideSprites
  for Y = 1 to 22
    fill TWhite count 32 at 0,Y
    Frame1
    Frame1
  next
  return
end sub

sub ClearSky:
  for Y = 3 to 4
    fill 32 count 32 at 0,Y
  next
  return
end sub

sub Clouds:
  put char TCloud00 at 3,4
  put char TCloud01 at 4,4
  put char TCloud02 at 5,4
  put char TCloud00 at 23,3
  put char TCloud01 at 24,3
  put char TCloud02 at 25,3
  return
end sub

' SlopeScreen: the sky, the range, the piste, the HUD
sub SlopeScreen:
  NewScreen
  ClearSky
  Clouds
  Mo = 255
  ' row 8: the brow of the slope
  fill TBrow count 32 at 0,8
  for Rk = 0 to 15
    LhOld[Rk] = 255
    RhOld[Rk] = 255
  next
  EPx = 9999
  Mountains
  Ph = 255
  HillPhase
  StripesAll
  Edges
  Hud
  Skis
  ProjectAll
  update sprites
  ShowScreen
  return
end sub

sub StageIntro:
  ClearSky
  ' the timed runs: their own name, no avalanche
  if Game > 0 then
    if Game = 1 then print at 3,3, "SKI TRAILS"
    if Game = 2 then print at 3,3, "SLALOM"
    print at 3,4, "READY...                  "
    Pause
    print at 3,4, "GO!                       "
    Pause
    ClearSky
    Clouds
    Rumble = 0
    return
  end if
  print at 3,3, "STAGE"
  V = Stage + 1
  NumU = V
  print at 9,3, digits$(NumU, 1)
  if Stage = 0 then print at 11,3, "PINE RIDGE"
  if Stage = 1 then print at 11,3, "DEVIL'S GULLY"
  if Stage = 2 then print at 11,3, "THE GLACIER"
  print at 3,4, "THE SNOW BREAKS ABOVE YOU!"
  play sound SndRumbleNear
  Pause
  print at 3,4, "         GO!              "
  Pause
  ClearSky
  Clouds
  Rumble = 0
  return
end sub

' ---------------------------------------------------------------------------
' Helpers

' Rnd: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub Pause:
  for J = 1 to 60
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 11
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  copy Gnd1Pat count 256 to vram.pattern + 3712
  copy Gnd2Pat count 256 to vram.pattern + 5760
  backdrop light blue
  cls
  return
end sub

' PageScreen: a page of text, white on dark blue
sub PageScreen:
  NewScreen
  backdrop dark blue
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  NewStage
  Px = 0
  Cq = 0
  SlopeScreen
  fill 32 count 32 at 0,1
  fill 32 count 32 at 0,2
  ClearSky
  ' the tune plays once, when the menu opens on its first page
  if Lv = 0 then
    play sound SndTuneA
    play sound SndTuneB
    TzLeft = 384
    TzOn = 1
  end if
  MenuText
  WasBtn = 1
title_loop:
  Frame1
  ' the snow slides by, and the piste sways
  Pos = Pos + 10
  Stripes
  V = Tick & 127
  Tw = V
  if Tw > 63 then Tw = 127 - Tw
  Tw = Tw - 32
  Cq = Tw
  Edges
  ' the ski tips lean into the sway
  Pose = 0
  if Cq < -12 then
    Pose = 1
  else
    if Cq > 12 then Pose = 2
  end if
  Skis
  update sprites
  Rnd
  ReadPad
  ' up and down go through the page's items
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      V = Items[Lv] - 1
      if Menu < V then inc Menu
    end if
    play sound SndClick
    MenuCursor
  end if
  if Press = 0 then goto title_loop
  ' a choice: go to another page of the menu, or leave it
  Act = 0
  if Lv = 0 then
    if Menu = 0 then
      Lv = 1
      Menu = Game
    else
      Act = 3
    end if
  else
    if Lv = 1 then
      if Menu < 3 then
        Game = Menu
        Lv = 2
        Menu = 0
      else
        Lv = 0
        Menu = 0
      end if
    else
      if Menu = 0 then Act = 1
      if Menu = 1 then Act = 2
      if Menu = 2 then
        Lv = 1
        Menu = Game
      end if
    end if
  end if
  if Act = 0 then
    play sound SndGate
    MenuText
    goto title_loop
  end if
  mute all
  TzOn = 0
  return
end sub

' the title menu's pages, in the sky (rows 1-4)
data Items bytes 2, 4, 3
data MenuTop bytes 3, 1, 2
sub MenuText:
  for Y = 1 to 4
    fill 32 count 32 at 0,Y
  next
  if Lv = 0 then
    print at 13,1, "SKIING"
    print at 4,3, "PLAY"
    print at 4,4, "CREDITS"
  end if
  if Lv = 1 then
    print at 4,1, "AVALANCHE RUN"
    print at 4,2, "SKI TRAILS"
    print at 4,3, "SLALOM"
    print at 4,4, "BACK"
  end if
  if Lv = 2 then
    if Game = 0 then print at 4,1, "AVALANCHE RUN"
    if Game = 1 then print at 4,1, "SKI TRAILS"
    if Game = 2 then print at 4,1, "SLALOM"
    print at 6,2, "START"
    print at 6,3, "HOW TO PLAY"
    print at 6,4, "BACK"
  end if
  MenuCursor
  return
end sub

sub MenuCursor:
  ' the cursor: column 2, or 4 under a game's name
  X = 2
  if Lv = 2 then X = 4
  ' blank the cursor column beside this page's items only (a game's name
  ' above them starts in that column)
  Y = MenuTop[Lv]
  V = Items[Lv]
  for I = 1 to V
    print at X,Y, " "
    inc Y
  next
  Y = MenuTop[Lv] + Menu
  print at X,Y, ">"
  return
end sub

sub RulesPage:
  PageScreen
  print at 10,1, "HOW TO PLAY"
  print at 2,3, "LEFT, RIGHT: STEER. AT SPEED"
  print at 2,4, "THE SKIS BITE LESS: YOU"
  print at 2,5, "DRIFT WIDE IN A SPRAY."
  print at 2,6, "UP: TUCK. DOWN: SNOWPLOUGH."
  print at 2,7, "FAST OVER A CREST: YOU FLY!"
  print at 2,8, "FIRE IN THE AIR: CROSS YOUR"
  print at 2,9, "SKIS. LET GO BEFORE LANDING!"
  if Game = 0 then
    print at 2,11, "AVALANCHE RUN: SKI AHEAD OF"
    print at 2,12, "THE AVALANCHE, WARN THREE"
    print at 2,13, "VILLAGES. FLAGS: 100 POINTS."
    print at 2,14, "A FALL LETS IT CATCH UP."
  end if
  if Game = 1 then
    print at 2,11, "SKI TRAILS: ONE LONG RUN."
    print at 2,12, "MIND THE TREES, THE ROCKS"
    print at 2,13, "AND THE SKIERS CUTTING"
    print at 2,14, "ACROSS. A CLEAN TRICK TAKES"
    print at 2,15, "A SECOND OFF YOUR TIME."
  end if
  if Game = 2 then
    print at 2,11, "SLALOM: PASS BETWEEN EVERY"
    print at 2,12, "PAIR OF FLAGS. A MISSED GATE"
    print at 2,13, "COSTS FIVE SECONDS. A CLEAN"
    print at 2,14, "TRICK TAKES ONE SECOND OFF."
  end if
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  PageScreen
  print at 13,1, "SKIING"
  print at 2,3, "THE SKI GAME COLECO'S"
  print at 2,4, "CATALOG PROMISED: SKI TRAILS"
  print at 2,5, "AND SLALOM, ON A 3-D SLOPE"
  print at 2,6, "THAT RISES AND FALLS."
  print at 2,8, "BY CLAUDE (AN AI MADE BY"
  print at 2,9, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,10, "2026, IN AMY, THE LANGUAGE"
  print at 2,11, "BY AMY BIENVENU."
  print at 2,13, "WITH AVALANCHE RUN, INSPIRED"
  print at 2,14, "BY AVALANCHE IN TIM"
  print at 2,15, "HARTNELL'S GIANT BOOK OF"
  print at 2,16, "COMPUTER GAMES (BALLANTINE"
  print at 2,17, "BOOKS, 1984)."
  print at 2,19, "MUSIC: FRESH TRACKS"
  print at 2,20, "(ORIGINAL)."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

