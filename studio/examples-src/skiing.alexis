  $00,$00,$00,$80,$C0,$00,$80,$C0,$E0,$80,$C0,$E0,$F0,$F8,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$03
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$07,$07
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$E0,$E0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$07,$0F,$0F,$0F
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$E0,$F0,$F0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$07,$0F,$0F,$1F,$1F
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$E0,$F0,$F8,$F8
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$07,$0F,$0F,$1F,$1F,$3F,$3F
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$E0,$F0,$F8,$F8,$FC,$FE,$FE
  $00,$00,$00,$00,$00,$00,$00,$03,$0F,$1F,$3F,$7F,$7F,$FF,$FF,$FF
  $00,$00,$00,$00,$00,$00,$00,$C0,$E0,$F0,$F8,$FC,$FE,$FF,$FF,$FF
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$02,$02,$02
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$03,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$C0,$80,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$07,$07,$07,$04,$04,$04,$04,$04
  $00,$00,$00,$00,$00,$00,$00,$00,$E0,$C0,$80,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$0F,$0F,$0F,$0F,$08,$08,$08,$08,$08,$08
  $00,$00,$00,$00,$00,$00,$F0,$E0,$C0,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$0F,$0F,$0F,$0F,$0F,$08,$08,$08,$08,$08,$08,$08,$08
  $00,$00,$00,$FC,$F8,$F0,$E0,$C0,$00,$00,$00,$00,$00,$00,$00,$00
  $3F,$3F,$3F,$3F,$3F,$3F,$30,$30,$30,$30,$30,$30,$30,$30,$30,$30
  $FE,$FC,$F8,$F0,$E0,$C0,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$40
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$02,$03
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$80
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$03,$03,$03,$03,$03
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$C0,$C0,$C0
  $00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$07,$0F,$07,$05,$06,$06
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$E0,$E0,$60,$E0,$E0
  $00,$00,$00,$00,$00,$00,$00,$01,$07,$07,$0F,$1F,$0D,$0F,$0E,$0E
  $00,$00,$00,$00,$00,$00,$00,$80,$C0,$E0,$F0,$F8,$B0,$F0,$70,$70
  $00,$00,$00,$00,$00,$03,$07,$0F,$0F,$3F,$0F,$0C,$0C,$0F,$0F,$0F
  $00,$00,$00,$00,$80,$E0,$F0,$F8,$F8,$FE,$F8,$98,$98,$F8,$78,$78
  $00,$01,$03,$07,$0F,$1F,$3F,$7F,$FF,$3F,$39,$39,$3F,$3E,$3E,$3E
  $00,$80,$C0,$E0,$F0,$F8,$FC,$FE,$FF,$FC,$9C,$9C,$FC,$7C,$7C,$7C
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$C0
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$01,$00,$02,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$00,$80,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$01,$03,$07,$03,$02,$00,$0F,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$80,$F0,$00
  $00,$00,$00,$00,$00,$00,$00,$01,$07,$03,$03,$02,$06,$04,$1F,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$80,$C0,$80,$80,$80,$40,$F8,$00
  $00,$00,$00,$00,$01,$03,$07,$0B,$03,$02,$02,$06,$04,$0C,$00,$00
  $00,$00,$00,$00,$00,$80,$C0,$A0,$90,$80,$80,$C0,$40,$60,$00,$00
  $00,$03,$03,$07,$0F,$17,$27,$07,$04,$04,$0C,$08,$18,$FF,$00,$00
  $00,$00,$00,$80,$C0,$A0,$90,$80,$80,$80,$C0,$40,$60,$FF,$00,$00
  $00,$08,$25,$49,$2A,$15,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$90,$24,$48,$A8,$50,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$01,$01,$03,$01,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$01,$03,$07,$03,$0F,$07,$02,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$40,$E0,$C0,$E0,$A0,$C0,$00,$00,$00,$00,$00
  $00,$00,$01,$05,$07,$1B,$0E,$02,$3E,$0E,$1A,$06,$04,$00,$00,$00
  $00,$00,$00,$20,$60,$58,$F0,$00,$78,$B0,$D8,$E0,$A0,$00,$00,$00
  $01,$09,$09,$05,$65,$38,$08,$00,$F8,$00,$38,$66,$04,$0C,$08,$00
  $00,$10,$30,$20,$26,$18,$00,$00,$0E,$00,$1C,$26,$A0,$B0,$90,$00
  $01,$09,$09,$05,$64,$18,$00,$00,$F0,$00,$18,$64,$04,$08,$08,$00
  $00,$10,$10,$20,$26,$18,$00,$00,$0F,$00,$18,$26,$A0,$90,$90,$80
end data

asm {
; ArMul: Mz = Mx * My (the low 16 bits, right for signed and unsigned),
; by shift and add: about 700 cycles whatever the numbers
ArMul:
    ld de,(AMY_UVAR_Mx)
    ld bc,(AMY_UVAR_My)
    ld hl,0
    ld a,16
ArMulLoop:
    add hl,hl
    sla c
    rl b
    jr nc,ArMulSkip
    add hl,de
ArMulSkip:
    dec a
    jr nz,ArMulLoop
    ld (AMY_UVAR_Mz),hl
    ret

; ---------------------------------------------------------------------------
; ArStripes: the colours of ground rows 8-23 for the distance Pos. Each
; pixel line adds its depth to Pos and is grey when its band bits are both
; set (kind 0 never, 1 bits 7 and 6, 2 bits 8 and 7, 3 bits 6 and 5);
; LineTab holds depth
; and kind, three bytes a line. A row's eight colours are kept in Cache:
; only rows whose colours changed go to VRAM, to the colours of the row's
; four tiles, writes spaced at 30 cycles or more (safe with the display on).
ArStripes:
    ; the far rows (8-15) on every other call, unless StAll is set
    ld a,(AMY_UVAR_StAll)
    or a
    jr nz,ArStFrom8
    ld a,(AMY_UVAR_StOdd)
    xor 1
    ld (AMY_UVAR_StOdd),a
    jr nz,ArStFrom8
    ld a,16
    ld hl,(AMY_UVAR_PhL)
    ld de,64
    add hl,de
    exx
    ld hl,AMY_UVAR_Cache+64
    exx
    jr ArStGo
ArStFrom8:
    ld a,9
    ld hl,(AMY_UVAR_PhL)
    ld de,8
    add hl,de
    exx
    ld hl,AMY_UVAR_Cache+8
    exx
ArStGo:
    ld (AMY_UVAR_Rw),a
    ld bc,(AMY_UVAR_Pos)
ArStRow:
    ld de,AMY_UVAR_Lb
    exx
    ld (AMY_UVAR_StC),hl
    exx
    ld a,8
    ld (AMY_UVAR_StN),a
ArStLine:
    ; the line's depth x2 (255: the snow beyond a crest), the bands from
    ; Pos + depth x16, tested as in Avalanche Run by distance
    ld a,(hl)
    inc hl
    ex de,hl
    cp 140
    jr nc,ArStWhite
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,bc
    cp 24
    jr c,ArStK3
    cp 48
    jr c,ArStK1
    add hl,hl
    ld a,h
    and 3
    cp 3
    jr ArStTest
ArStK3:
    ld a,l
    and $60
    cp $60
    jr ArStTest
ArStK1:
    ld a,l
    and $C0
    cp $C0
ArStTest:
    ld a,$CF
    jr nz,ArStPut
    ld a,$2E
    jr ArStPut
ArStWhite:
    ld a,$CF
ArStPut:
    ex de,hl
    exx
    cp (hl)
    jr z,ArStSame
    ld (hl),a
    ld a,1
    ld (AMY_UVAR_StD),a
ArStSame:
    inc hl
    exx
    ld a,(AMY_UVAR_StN)
    dec a
    ld (AMY_UVAR_StN),a
    jr nz,ArStLine
    ld a,(AMY_UVAR_StD)
    or a
    jr z,ArStNext
    xor a
    ld (AMY_UVAR_StD),a
    push hl
    push bc
    ; the colour address: $2000 + third * $800 + 208 * 8 + (row & 7) * 32
    ld a,(AMY_UVAR_Rw)
    ld c,a
    and 7
    rrca
    rrca
    rrca
    ld l,a
    ld a,c
    srl a
    srl a
    srl a
    add a,a
    add a,a
    add a,a
    add a,$26
    ld h,a
    ld de,$0080
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld c,4
ArStRep:
    ld hl,(AMY_UVAR_StC)
    ld b,8
ArStOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ArStOut
    dec c
    jr nz,ArStRep
    pop bc
    pop hl
ArStNext:
    ld a,(AMY_UVAR_Rw)
    inc a
    ld (AMY_UVAR_Rw),a
    cp 24
    jp nz,ArStRow
    ret

; ArLate: Late = 1 when the VDP has begun a frame since its status was
; last read (the NMI is off during a pass, so nothing else reads it)
ArLate:
    in a,($BF)
    rlca
    and 1
    ld (AMY_UVAR_Late),a
    ret

; ArBackdrop: the backdrop (VDP register 7) to colour V, for a flash
ArBackdrop:
    ld a,(AMY_UVAR_V)
    ld c,a
    ld b,7
    jp WRITE_REGISTER

; ArAirTone: the airborne hum on the third tone channel (free during a
; run: only the title tune uses it). Uw = the tone's period (10 bits), V =
; its attenuation (15 = silent). Called with the NMI held off, so no
; driver write can split the two-byte frequency write.
ArAirTone:
    ld hl,(AMY_UVAR_Uw)
    ld a,l
    and $0F
    or $C0
    out ($FF),a
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,l
    and $3F
    out ($FF),a
    ld a,(AMY_UVAR_V)
    and $0F
    or $D0
    out ($FF),a
    ret

; ArThirds: VDP register 3 = $FF, three colour tables (Amy's tile screen
; shares one between the thirds)
ArThirds:
    ld b,3
    ld c,$FF
    jp WRITE_REGISTER

; ArMul8: HL = DE * A (DE signed, A unsigned; the low 16 bits)
ArMul8:
    ld hl,0
    ld b,8
ArM8Loop:
    add hl,hl
    add a,a
    jr nc,ArM8Skip
    add hl,de
ArM8Skip:
    djnz ArM8Loop
    ret

; ArClamp: A = HL kept within 0-256, in half tiles (0-64)
ArClamp:
    bit 7,h
    jr nz,ArClZero
    ld a,h
    or a
    jr z,ArClOk
    ld a,64
    ret
ArClOk:
    ld a,l
    srl a
    srl a
    ret
ArClZero:
    xor a
    ret

; ArEdges: each ground row's forest edges. The middle of the piste on row
; k is 128 + (Cq * KRow[k]) / 128 - (Px * InvRow[k]) / 64 pixels, its edges
; WdR[k] either side. Rows whose edges moved are drawn again (ArDrawRow).
ArEdges:
    ld a,1
    ld (AMY_UVAR_Rk),a
ArEdRow:
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_PhK)
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_Cq)
    call ArMul8
    add hl,hl
    ld l,h
    ld a,h
    rla
    sbc a,a
    ld h,a
    ld (AMY_UVAR_EC1),hl
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,(AMY_UVAR_PhI)
    add hl,de
    ld a,(hl)
    ld de,(AMY_UVAR_Px)
    call ArMul8
    ld b,6
ArEdShift:
    sra h
    rr l
    djnz ArEdShift
    ex de,hl
    ld hl,(AMY_UVAR_EC1)
    or a
    sbc hl,de
    ld de,128
    add hl,de
    ld (AMY_UVAR_EBase),hl
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_WdR
    add hl,de
    ld e,(hl)
    ld d,0
    ld hl,(AMY_UVAR_EBase)
    or a
    sbc hl,de
    push de
    call ArClamp
    ld (AMY_UVAR_Hl),a
    pop de
    ld hl,(AMY_UVAR_EBase)
    add hl,de
    call ArClamp
    ld b,a
    ld a,(AMY_UVAR_Hl)
    cp b
    jr c,ArEdOk
    ld b,a
ArEdOk:
    ld a,b
    ld (AMY_UVAR_Hr),a
    ld a,(AMY_UVAR_Rk)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_LhOld
    add hl,de
    ld a,(AMY_UVAR_Hl)
    cp (hl)
    jr nz,ArEdNew
    ld hl,AMY_UVAR_RhOld
    add hl,de
    ld a,(AMY_UVAR_Hr)
    cp (hl)
    jr z,ArEdNext
ArEdNew:
    ld hl,AMY_UVAR_LhOld
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_EOl),a
    ld a,(AMY_UVAR_Hl)
    ld (hl),a
    ld hl,AMY_UVAR_RhOld
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_EOr),a
    ld a,(AMY_UVAR_Hr)
    ld (hl),a
    ld a,(AMY_UVAR_EOl)
    cp 255
    jr nz,ArEdSpans
    call ArDrawRow
    jr ArEdNext
ArEdSpans:
    ; only the tiles round each edge's old and new places
    call ArRowSetup
    ld a,(AMY_UVAR_EOl)
    ld b,a
    ld a,(AMY_UVAR_Hl)
    call ArSpan
    ld a,(AMY_UVAR_EOr)
    ld b,a
    ld a,(AMY_UVAR_Hr)
    call ArSpan
ArEdNext:
    ld a,(AMY_UVAR_Rk)
    inc a
    ld (AMY_UVAR_Rk),a
    cp 16
    jp nz,ArEdRow
    ret

; ArRowSetup: for row Rk+8, the edge columns (ELc, ERc), their halves
; (ELh, ERh), the row's first tile code (EGs) and name address (ENam)
ArRowSetup:
    ld a,(AMY_UVAR_Hl)
    ld b,a
    srl a
    ld (AMY_UVAR_ELc),a
    ld a,b
    and 1
    ld (AMY_UVAR_ELh),a
    ld a,(AMY_UVAR_Hr)
    ld b,a
    srl a
    ld (AMY_UVAR_ERc),a
    ld a,b
    and 1
    ld (AMY_UVAR_ERh),a
    ld a,(AMY_UVAR_Rk)
    add a,8
    ld l,a
    and 7
    add a,a
    add a,a
    add a,208
    ld (AMY_UVAR_EGs),a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1800
    add hl,de
    ld (AMY_UVAR_ENam),hl
    ret

; ArSpan: the tiles from column min(A,B)/2 to max(A,B)/2 (A and B in half
; tiles) of the row set up by ArRowSetup
ArSpan:
    cp b
    jr c,ArSpOrd
    ld c,a
    ld a,b
    ld b,c
ArSpOrd:
    ; A = the smaller, B = the larger
    srl a
    srl b
    cp 32
    ret nc
    ld c,a
    ld a,b
    cp 32
    jr c,ArSpEnd
    ld b,31
ArSpEnd:
    ld a,b
    sub c
    inc a
    ld b,a
    ld hl,(AMY_UVAR_ENam)
    ld e,c
    ld d,0
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_EGs)
    ld d,a
ArSpCell:
    ; the tile at column C: forest, left half edge, snow, right half edge
    ld a,(AMY_UVAR_ELc)
    ld e,a
    ld a,c
    cp e
    jr c,ArSpForest
    jr nz,ArSpMid
    ld a,(AMY_UVAR_ELh)
    or a
    jr z,ArSpMid
    ld a,d
    add a,2
    jr ArSpOut
ArSpMid:
    ld a,(AMY_UVAR_ERc)
    ld e,a
    ld a,c
    cp e
    jr c,ArSpSnow
    jr nz,ArSpForest
    ld a,(AMY_UVAR_ERh)
    or a
    jr z,ArSpForest
    ld a,d
    add a,3
    jr ArSpOut
ArSpSnow:
    ld a,d
    jr ArSpOut
ArSpForest:
    ld a,d
    inc a
ArSpOut:
    out ($BE),a
    inc c
    djnz ArSpCell
    ret

; ArDrawRow: ground row Rk+8 from its edges Hl and Hr (half tiles): forest,
; a left half edge, snow, a right half edge, forest
ArDrawRow:
    ld a,(AMY_UVAR_Rk)
    add a,8
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$1800
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Rk)
    add a,8
    and 7
    add a,a
    add a,a
    add a,208
    ld d,a
    ld e,0
    ld a,(AMY_UVAR_Hl)
    srl a
    jr z,ArDrL0
    ld b,a
    ld e,a
    ld a,d
    inc a
ArDrL:
    out ($BE),a
    nop
    nop
    djnz ArDrL
ArDrL0:
    ld a,(AMY_UVAR_Hl)
    and 1
    jr z,ArDrS
    ld a,e
    cp 32
    jr nc,ArDrS
    ld a,d
    add a,2
    out ($BE),a
    inc e
ArDrS:
    ld a,(AMY_UVAR_Hr)
    srl a
    sub e
    jr c,ArDrR
    jr z,ArDrR
    ld b,a
    add a,e
    ld e,a
    ld a,d
ArDrSl:
    out ($BE),a
    nop
    nop
    djnz ArDrSl
ArDrR:
    ld a,e
    cp 32
    ret nc
    ld a,(AMY_UVAR_Hr)
    and 1
    jr z,ArDrF
    ld a,(AMY_UVAR_Hr)
    srl a
    cp e
    jr nz,ArDrF
    ld a,d
    add a,3
    out ($BE),a
    inc e
ArDrF:
    ld a,32
    sub e
    ret z
    ret c
    ld b,a
    ld a,d
    inc a
ArDrFl:
    out ($BE),a
    nop
    nop
    djnz ArDrFl
    ret

; ArProject: for the four objects, SprY/SprX/SprP/SprC from the depth
; (OZ / 16, the tables YofZ, SizeOfZ, CurveZ, InvZ), the place OX, the
; player's place Px and the curve Cq. Hidden: row 192.
ArProject:
    xor a
    ld (AMY_UVAR_Oi),a
ArPrLoop:
    ld a,(AMY_UVAR_Oi)
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_OKind
