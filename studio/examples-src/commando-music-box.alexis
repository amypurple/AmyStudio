asset CommandoTitlePattern from "@project/commando-title.pattern.dan2" codec dan2
asset CommandoTitleColor from "@project/commando-title.color.dan2" codec dan2

u8 Key1 = $FF

picture screen
decompress CommandoTitlePattern to vram.pattern
decompress CommandoTitleColor to vram.color
fill vram.name with sequence $00..$ff repeat 3
screen on
WaitTitleFire:
  if joypad(1).button1 then
    goto EnterMusicBox
  end if
  wait
  goto WaitTitleFire

EnterMusicBox:
WaitTitleRelease:
  if joypad(1).button1 then
    goto WaitTitleRelease
  end if
text screen
print at 7,0, "COMMANDO MUSIC BOX"
fill $2D count 32 at 0,1
print at 1,2, "KEY1:INTRO"
print at 17,2, "KEY2:INGAME"
print at 1,3, "KEY3:END LVL"
print at 17,3, "KEY4:HI-SCORE"
print at 1,5, "KEY5:DEATH"
print at 17,5, "KEY6:GRENADE"
print at 1,6, "KEY7:LIFE"
print at 17,6, "KEY8:HS SHOOT"
print at 1,7, "KEY9:SUPPLY"
print at 17,7, "KEY0:MOTOR"
print at 1,8, "KEY*:FREECAPTIVE"
print at 10,14, "BTN2:STOP ALL"
fill $2D count 32 at 0,19
print at 1,20, "NOW PLAYING:"
set sound table _snd_table areas 8
screen on
wait 2 frames
play song ingame_music
print at 2,21, "INGAME MUSIC"
MainLoop:
  ' Stage keypad input because one read drives many branches.
  Key1 = keypad(1)
  if Key1 = 1 then
    goto PlayIntro
  elseif Key1 = 2 then
    goto PlayIngame
  elseif Key1 = 3 then
    goto PlayEndLevel
  elseif Key1 = 4 then
    goto PlayHighScore
  elseif Key1 = 5 then
    goto PlaySfxPair1
  elseif Key1 = 6 then
    goto PlaySfxPair2
  elseif Key1 = 7 then
    goto PlaySfxPair3
  elseif Key1 = 8 then
    goto PlaySfxPair4
  elseif Key1 = 9 then
    goto PlaySfxPair5
  elseif Key1 = 0 then
    goto PlaySfx36
  elseif Key1 = 10 then
    goto PlaySfx37
  elseif joypad(1).button2 then
    goto StopAll
  end if
  wait
  goto MainLoop

PlayIntro:
  fill $20 count 32 at 0,21
  print at 2,21, "INTRO MUSIC"
  play song intro_music
  goto WaitKeyRelease

PlayIngame:
  fill $20 count 32 at 0,21
  print at 2,21, "INGAME MUSIC"
  play song ingame_music
  goto WaitKeyRelease

PlayEndLevel:
  fill $20 count 32 at 0,21
  print at 2,21, "END LEVEL MUSIC"
  play song end_level_music
  goto WaitKeyRelease

PlayHighScore:
  fill $20 count 32 at 0,21
  print at 2,21, "HIGH SCORE MUSIC"
  play song high_score_music
  goto WaitKeyRelease

PlaySfxPair1:
  fill $20 count 32 at 0,21
  print at 2,21, "DEATH"
  play sound $2B
  play sound $2C
  goto WaitKeyRelease

PlaySfxPair2:
  fill $20 count 32 at 0,21
  print at 2,21, "GRENADE"
  play sound $2D
  play sound $2E
  goto WaitKeyRelease

PlaySfxPair3:
  fill $20 count 32 at 0,21
  print at 2,21, "LIFE"
  play sound $2F
  play sound $30
  goto WaitKeyRelease

PlaySfxPair4:
  fill $20 count 32 at 0,21
  print at 2,21, "HS SHOOT"
  play sound $31
  play sound $32
  play sound $33
  goto WaitKeyRelease

PlaySfxPair5:
  fill $20 count 32 at 0,21
  print at 2,21, "SUPPLY"
  play sound $34
  play sound $35
  goto WaitKeyRelease

PlaySfx36:
  fill $20 count 32 at 0,21
  print at 2,21, "MOTOR"
  play sound $36
  goto WaitKeyRelease

PlaySfx37:
  fill $20 count 32 at 0,21
  print at 2,21, "FREECAPTIVE"
  play sound $37
  goto WaitKeyRelease

WaitKeyRelease:
  ' Wait for keypad release so one press triggers one action.
  Key1 = keypad(1)
  if Key1 != $FF then
    goto WaitKeyRelease
  end if
  goto MainLoop

StopAll:
  stop all
  fill $20 count 32 at 0,21
  print at 2,21, "STOPPED"
WaitStopRelease:
  if joypad(1).button2 then
    goto WaitStopRelease
  end if
  goto MainLoop

include "@project/commando-music-data.asm"