cartridge "BASKETBALL SAM & ED/ANDERSON AND HENSLEY/1987"

' BASKETBALL SAM & ED
' Based on "Basketball Sam & Ed" by Rhett Anderson and David Hensley,
' Jr., COMPUTE!'s Gazette July 1987 (pages 53-54, Commodore 64). Made for
' the ColecoVision in Amy (the language by Amy Bienvenu) by Claude (an AI
' made by Anthropic) for Amy Studio, 2026.
'
' Not a port: the Gazette listing is machine code typed in with MLX, so
' this game is built on the article's rules (orig/ has the scans).
' Kept from the article: Sam (orange) and Ed (blue) are basketballs with
' arms, legs and faces, playing one-on-one; the stick runs left and
' right, the button jumps (left, right or straight up by the stick at the
' press) and in the air there is no control; you score by going through
' a hoop yourself, which you can only reach by bouncing off your
' opponent, the floor or a backboard; three goals, two points each; four
' periods of 10 game minutes (about 2:40); at the end of a period the
' players lose control, but a goal before they stop bouncing counts;
' overtime periods on a tie; the game begins with both bouncing wildly;
' a scrolling message board, a scoreboard, a pause; one player (the
' computer plays Ed) or two.
' Made for this machine: the gym drawn in tiles inside the overscan; Sam
' and Ed two sprites each (body, face and limbs), squashing on landings;
' bounce physics in 1/16 pixel steps at 60 frames a second (gravity,
' floor bounces losing a quarter, walls, ceiling, rim ends, the centre
' backboard, and springy bumps between the two players); an original
' title tune ("Full Court") and an original period-end riff ("Swing
' Break": the C64 played "Sweet Georgia Brown", still under copyright).
'
' Controls: one player: either joystick plays Sam. Two players: Sam on
' joystick 1, Ed on joystick 2 (the C64 had Ed in port 1 and Sam in port
' 2; on the ColecoVision the first player takes the first joystick).
' Left button jumps, right button pauses.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TWall = 128
const TWall2 = 129
const TFrame = 130
const TLine = 131
const TPlank = 132
const TBoard = 133
const TBoardt = 134
const TBoardb = 135
const TRim = 136
const TNet = 137
const TDark = 138
const SBody = 0
const SSquash = 4
const SFacer = 8
const SFacel = 12
const SAir = 16
const SSqf = 20
const NTiles8 = 88
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndRiffA = 3
const SndRiffB = 4
const SndThud = 5
const SndCrowd = 6
const SndJump = 7
const SndBump = 8
const SndScore = 9
const SndRim = 10
const SndBoard = 11
const SndWhistle = 12
const SndBuzz = 13
const MWelcome = 0
const MTip = 1
const MSam = 2
const MEd = 3
const MEnd = 4
const MOver = 5
const MSamW = 6
const MEdW = 7
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the two players (0 Sam, 1 Ed): Xp Yp the centre in 1/16 pixels, Vx Vy
' the speed (1/16 pixel a frame), Gnd 1 standing on the floor, Sq the
' squash frames left, Look 0 right / 1 left, Oy the centre row before
' the move (pixels); Dir 0 none / 1 left / 2 right and Jp the jump press,
' from the stick or the computer
i16 Xp[2]
i16 Yp[2]
i16 Vx[2]
i16 Vy[2]
u8 Gnd[2]
u8 Sq[2]
u8 Look[2]
u8 Oy[2]
u8 Dir[2]
u8 Jp[2]
u8 WasB[2]
u8 Sc[2]
' Ph: 1 tip-off (wild bouncing), 2 play, 3 time up (bouncing out),
' 4 between periods, 5 game over; Ctl 1 while the players have control,
' Scoring 1 while goals count; Np 1 or 2 players
u8 Ph = 0
u8 Ctl = 0
u8 Scoring = 0
u8 Np = 1
u8 Period = 1
u16 Gsec = 600
u8 Gfr = 0
u16 Wt = 0
u8 Paused = 0
u16 Rs = $5A3C
u16 T16 = 0
' the message board: Mo the window's place in MsgText, Mc steps left,
' Mq the message waiting (255 none), Mt the frames to the next step
u16 Mo = 0
u8 Mc = 0
u8 Mq = 255
u8 Mt = 0

' work
u8 Pi = 0
u8 Po = 0
u8 Cx = 0
u8 Cy = 0
u8 Bx = 0
u8 By = 0
u8 Dx = 0
u8 Dy = 0
u8 Sx = 0
u8 Sy = 0
u8 Tp = 0
u8 Bt = 0
i16 T = 0
i16 T2 = 0
i16 Rel = 0
i16 Adx = 0
i16 Ady = 0
u16 W16 = 0
u16 NumU = 0
u8 Menu = 0
u8 Idle = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Btn2 = 0
u8 WasBtn2 = 0
u8 Press2 = 0
u8 WasStick = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table BbSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title
  Np = Menu + 1

new_game:
  Sc[0] = 0
  Sc[1] = 0
  Period = 1
  DrawCourt
  ShowHud
  ShowScreen
  Say(MWelcome)

new_period:
  ' the tip-off: both bounce wildly from the middle; the clock starts
  ' when both stand on the floor
  Gsec = 600
  Gfr = 0
  ShowClock
  ShowPeriod
  TipOff
  Ph = 1
  Ctl = 0
  Scoring = 0
  play sound SndWhistle

play_loop:
  Frame1
  if Paused = 0 then Scroll
  ReadPad
  if Paused = 1 then
    if Press2 = 1 then
      Paused = 0
      Mt = 0
    end if
    goto play_loop
  end if
  if Press2 = 1 then
    if Ph < 4 then
      Paused = 1
      print at 2,1, "           PAUSED           "
      goto play_loop
    end if
  end if
  Players
  DrawPlayers
  if Ph = 1 then
    V = Gnd[0] & Gnd[1]
    if V = 1 then
      Ph = 2
      Ctl = 1
      Scoring = 1
      Say(MTip)
      play sound SndWhistle
    end if
    goto play_loop
  end if
  if Ph = 2 then
    inc Gfr
    if Gfr >= 16 then
      Gfr = 0
      dec Gsec
      ShowClock
      if Gsec = 0 then
        ' time: the players lose control, goals still count until both
        ' stop bouncing
        Ph = 3
        Ctl = 0
        play sound SndBuzz
      end if
    end if
    goto play_loop
  end if
  if Ph = 3 then
    V = Gnd[0] & Gnd[1]
    if V = 1 then
      Ph = 4
      Scoring = 0
      Say(MEnd)
      play sound SndRiffA
      play sound SndRiffB
      TzLeft = 320
      TzOn = 1
      Wt = 330
    end if
    goto play_loop
  end if
  if Ph = 4 then
    dec Wt
    if Wt > 0 then goto play_loop
    V = 0
    if Sc[0] <> Sc[1] then V = 1
    if Period >= 4 then
      if V = 1 then goto game_over
    end if
    inc Period
    if Period > 4 then Say(MOver)
    goto new_period
  end if
  goto play_loop

game_over:
  Ph = 5
  if Sc[0] > Sc[1] then
    Say(MSamW)
  else
    Say(MEdW)
  end if
  play sound SndCrowd
  Wt = 900
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
over_loop:
  Frame1
  Scroll
  ReadPad
  if Press = 1 then goto title
  dec Wt
  if Wt > 0 then goto over_loop
  goto title

' Say(M): show message M on the board now (the one scrolling is cut)
sub Say(u8 Msg):
  Mo = MsgOff[Msg]
  Mc = MsgLen[Msg]
  Mt = 0
  return
end sub

' Scroll: the board moves one letter every 5 frames; when a message has
' gone by, the welcome comes round again
sub Scroll:
  if Mt > 0 then
    dec Mt
    return
  end if
  Mt = 5
  if Mc = 0 then
    Mo = MsgOff[MWelcome]
    Mc = MsgLen[MWelcome]
  end if
  copy MsgText + Mo count 28 to vram.name + 34
  inc Mo
  dec Mc
  return
end sub

' TipOff: both in the middle, thrown up and sideways at random
sub TipOff:
  Xp[0] = 1536
  Xp[1] = 2560
  for Pi = 0 to 1
    Yp[Pi] = 1920
    Rnd16
    V = Rs & 63
    T = V
    T = 0 - T
    T = T - 48
    Vy[Pi] = T
    Rnd16
    V = Rs & 63
    T = V
    T = T - 32
    Vx[Pi] = T
    Gnd[Pi] = 0
    Sq[Pi] = 0
  next
  Look[0] = 0
  Look[1] = 1
  return
end sub

' Players: the stick (or the computer), then each player's move, then
' the bump between them
sub Players:
  for Pi = 0 to 1
    if Sq[Pi] > 0 then Sq[Pi] = Sq[Pi] - 1
    Dir[Pi] = 0
    Jp[Pi] = 0
  next
  ReadSticks
  if Np = 1 then
    if Gnd[1] = 1 then
      if Ctl = 1 then Brain
    end if
  end if
  for Pi = 0 to 1
    if Gnd[Pi] = 1 then Control
    Phys
  next
  Collide
  return
end sub

' ReadSticks: Sam on joystick 1 (either joystick with one player), Ed on
' joystick 2; a jump is a new press of the left button
sub ReadSticks:
  for Pi = 0 to 1
    V = 0
    Bt = 0
    if Pi = 0 then
      if joypad(1).left then V = 1
      if joypad(1).right then V = 2
      if joypad(1).button1 then Bt = 1
      if Np = 1 then
        if joypad(2).left then V = 1
        if joypad(2).right then V = 2
        if joypad(2).button1 then Bt = 1
      end if
    else
      if joypad(2).left then V = 1
      if joypad(2).right then V = 2
      if joypad(2).button1 then Bt = 1
    end if
    if Np = 1 then
      if Pi = 1 then
        V = 0
        Bt = 0
      end if
    end if
    Dir[Pi] = V
    W = 0
    if Bt = 1 then
      if WasB[Pi] = 0 then W = 1
    end if
    WasB[Pi] = Bt
    Jp[Pi] = W
  next
  return
end sub

' Brain: the computer's Ed, a little better than a beginner: it runs at
' Sam and tries to hop onto him, and keeps out from under a falling Sam
sub Brain:
  Rnd16
  V = Rs & 255
  Centre(0)
  Bx = Cx
  By = Cy
  Centre(1)
  ' Tp the way to Sam, Bt the way away
  if Bx < Cx then
    Dx = Cx - Bx
    Tp = 1
    Bt = 2
  else
    Dx = Bx - Cx
    Tp = 2
    Bt = 1
  end if
  W = Cy - 20
  if Gnd[0] = 0 then
    if By < W then
      if Dx < 14 then
        Dir[1] = Bt
        return
      end if
    end if
  end if
  if Dx < 16 then
    W = V & 3
    if W = 0 then
      Jp[1] = 1
    else
      Dir[1] = Bt
    end if
    return
  end if
  Dir[1] = Tp
  if Dx < 45 then
    W = V & 7
    if W = 0 then Jp[1] = 1
  end if
  return
end sub

' Control: a player standing on the floor runs with the stick and jumps
' with the button (the stick at the press gives the way); without
' control (tip-off, time up) the player just stands
sub Control:
  if Ctl = 0 then
    Vx[Pi] = 0
    return
  end if
  V = Dir[Pi]
  T = 0
  if V = 1 then
    T = 0 - 32
    Look[Pi] = 1
  end if
  if V = 2 then
    T = 32
    Look[Pi] = 0
  end if
  Vx[Pi] = T
  if Jp[Pi] = 1 then
    T = 0 - 64
    Vy[Pi] = T
    Gnd[Pi] = 0
    play sound SndJump
  end if
  return
end sub

' Centre(P): Cx, Cy the centre of player P in pixels
sub Centre(u8 P):
  W16 = Xp[P]
  W16 = W16 >> 4
  Cx = W16
  W16 = Yp[P]
  W16 = W16 >> 4
  Cy = W16
  return
end sub

' Phys: one frame of player Pi's flight: gravity, the move, the walls,
' the ceiling, the floor, the rim ends, the centre backboard, the hoops
sub Phys:
  Centre(Pi)
  Oy[Pi] = Cy
  if Gnd[Pi] = 0 then Vy[Pi] = Vy[Pi] + 3
  Xp[Pi] = Xp[Pi] + Vx[Pi]
  Yp[Pi] = Yp[Pi] + Vy[Pi]
  Walls
  T = Yp[Pi]
  if T < 624 then
    Yp[Pi] = 624
    T = Vy[Pi]
    if T < 0 then Vy[Pi] = 0 - T
  end if
  T = Yp[Pi]
  if T >= 2688 then
    Yp[Pi] = 2688
    T = Vy[Pi]
    if T > 40 then
      ' a bounce loses a quarter of the speed
      T2 = T >> 2
      T2 = T2 - T
      Vy[Pi] = T2
      Sq[Pi] = 6
      play sound SndThud
    else
      Vy[Pi] = 0
      if Gnd[Pi] = 0 then
        Gnd[Pi] = 1
        Vx[Pi] = 0
      end if
    end if
  end if
  Centre(Pi)
  ' the rim ends: the front of each side rim, both ends of the centre rim
  Bx = 46
  By = 104
  Bumper
  Bx = 209
  Bumper
  Bx = 113
  By = 64
  Bumper
  Bx = 142
  Bumper
  Board
  ' through a hoop, going down: two points
  if Scoring = 1 then
    V = Oy[Pi]
    if V < 104 then
      if Cy >= 104 then
        if Cx < 38 then Goal
        if Cx >= 217 then Goal
      end if
    end if
    if V < 64 then
      if Cy >= 64 then
        if Cx >= 121 then
          if Cx <= 134 then Goal
        end if
      end if
    end if
  end if
  return
end sub

' Walls: the side walls bounce a player back
sub Walls:
  T = Xp[Pi]
  if T < 496 then
    Xp[Pi] = 496
    T = Vx[Pi]
    if T < 0 then Vx[Pi] = 0 - T
  end if
  T = Xp[Pi]
  if T > 3584 then
    Xp[Pi] = 3584
    T = Vx[Pi]
    if T > 0 then Vx[Pi] = 0 - T
  end if
  return
end sub

' Bumper: a rim end at Bx, By pushes the player out (within 8 pixels),
' along the side it came from
sub Bumper:
  if Cx >= Bx then
    Dx = Cx - Bx
    Sx = 0
  else
    Dx = Bx - Cx
    Sx = 1
  end if
  if Dx >= 8 then return
  if Cy >= By then
    Dy = Cy - By
    Sy = 0
  else
    Dy = By - Cy
    Sy = 1
  end if
  if Dy >= 8 then return
  if Dx >= Dy then
    if Sx = 0 then
      W16 = Bx + 8
      W16 = W16 << 4
      Xp[Pi] = W16
      T = Vx[Pi]
      if T < 0 then Vx[Pi] = 0 - T
    else
      W16 = Bx - 8
      W16 = W16 << 4
      Xp[Pi] = W16
      T = Vx[Pi]
      if T > 0 then Vx[Pi] = 0 - T
    end if
  else
    if Sy = 0 then
      W16 = By + 8
      W16 = W16 << 4
      Yp[Pi] = W16
      T = Vy[Pi]
      if T < 0 then Vy[Pi] = 0 - T
    else
      W16 = By - 8
      W16 = W16 << 4
      Yp[Pi] = W16
      T = Vy[Pi]
      if T > 0 then Vy[Pi] = 0 - T
    end if
  end if
  Gnd[Pi] = 0
  play sound SndRim
  Centre(Pi)
  return
end sub

' Board: the centre backboard (x 112-143, y 32-39): a ball centre within
' 7 pixels of it bounces off the side it came from, and is put just
' outside its reach (a ball left on the edge was pushed back every frame)
sub Board:
  if Cx < 105 then return
  if Cx > 150 then return
  if Cy < 25 then return
  if Cy > 46 then return
  V = Oy[Pi]
  if V >= 46 then
    Yp[Pi] = 752
    T = Vy[Pi]
    if T < 0 then Vy[Pi] = 0 - T
  else
    if Cx < 128 then
      Xp[Pi] = 1664
      T = Vx[Pi]
      if T > 0 then Vx[Pi] = 0 - T
    else
      Xp[Pi] = 2416
      T = Vx[Pi]
      if T < 0 then Vx[Pi] = 0 - T
    end if
  end if
  play sound SndBoard
  Centre(Pi)
  return
end sub

' Goal: two points for player Pi
sub Goal:
  Sc[Pi] = Sc[Pi] + 2
  ShowScores
  if Pi = 0 then
    Say(MSam)
  else
    Say(MEd)
  end if
  play sound SndScore
  play sound SndCrowd
  return
end sub

' Collide: when the two players meet. Mostly one above the other: the
' top one springs up (64 plus half the closing speed, at most 112; in
' play only, otherwise just half) and the
' bottom one is pushed down by half of it; side by side: they swap their
' sideways speeds and spring apart
sub Collide:
  T = Xp[1] - Xp[0]
  Adx = T
  if T < 0 then Adx = 0 - T
  T2 = Yp[1] - Yp[0]
  Ady = T2
  if T2 < 0 then Ady = 0 - T2
  if Adx >= 224 then return
  if Ady >= 224 then return
  T = Adx + Ady
  if T >= 288 then return
  if Ady >= Adx then
    ' Pi the top, Po the bottom
    Pi = 0
    Po = 1
    T = Yp[1]
    T2 = Yp[0]
    if T < T2 then
      Pi = 1
      Po = 0
    end if
    Rel = Vy[Pi] - Vy[Po]
    if Rel > 0 then
      T = Rel >> 1
      ' the spring only works in play: without control (tip-off, time up)
      ' a bump just shares the speed, so the players settle
      T2 = T
      if Ctl = 1 then T2 = T + 64
      if T2 > 112 then T2 = 112
      Vy[Pi] = 0 - T2
      Vy[Po] = Vy[Po] + T
      Gnd[Pi] = 0
      Gnd[Po] = 0
      ' the top one rolls off the other's head (no balancing up there)
      T = Vx[Pi]
      if T > -16 then
        if T < 16 then
          T = Xp[Pi]
          T2 = Xp[Po]
          if T < T2 then
            Vx[Pi] = 0 - 16
          else
            if T > T2 then
              Vx[Pi] = 16
            else
              if T < 2040 then
                Vx[Pi] = 16
              else
                Vx[Pi] = 0 - 16
              end if
            end if
          end if
        end if
      end if
      Sq[0] = 4
      Sq[1] = 4
      play sound SndBump
    end if
    T = Yp[Po] - 224
    if T < 624 then T = 624
    Yp[Pi] = T
    return
  end if
  ' side by side: Pi the left one, Po the right one
  Pi = 0
  Po = 1
  T = Xp[1]
  T2 = Xp[0]
  if T < T2 then
    Pi = 1
    Po = 0
  end if
  Rel = Vx[Pi] - Vx[Po]
  if Rel > 0 then
    T = Vx[Pi]
    Vx[Pi] = Vx[Po]
    Vx[Po] = T
    T = Vx[Pi]
    if T > -16 then Vx[Pi] = 0 - 16
    T = Vx[Po]
    if T < 16 then Vx[Po] = 16
    play sound SndBump
  end if
  T = Xp[Pi] + Xp[Po]
  T = T >> 1
  T2 = T - 112
  Xp[Pi] = T2
  T2 = T + 112
  Xp[Po] = T2
  Walls
  Pi = Po
  Walls
  return
end sub

' Rnd16: a 16-bit xorshift (7, 9, 8)
sub Rnd16:
  T16 = Rs << 7
  Rs = Rs ^ T16
  T16 = Rs >> 9
  Rs = Rs ^ T16
  T16 = Rs << 8
  Rs = Rs ^ T16
  return
end sub

' DrawPlayers: each player is two sprites, the face and limbs (black, in
' front) and the body (Sam light red, Ed light blue)
sub DrawPlayers:
  for Pi = 0 to 1
    Centre(Pi)
    V = Cy - 9
    W = Cx - 8
    if Sq[Pi] > 0 then
      N = SSqf
      K = SSquash
    else
      K = SBody
      if Gnd[Pi] = 0 then
        N = SAir
      else
        N = SFacer
        if Look[Pi] = 1 then N = SFacel
      end if
    end if
    X = Pi * 2
    Y = X + 1
    J = 9
    if Pi = 1 then J = 5
    set sprite X to V,W,N,1
    set sprite Y to V,W,K,J
  next
  update sprites
  return
end sub

' the court: frame, back wall panels, floor, the three hoops
sub DrawCourt:
  NewScreen
  fill TDark count 32 at 0,1
  fill TDark count 32 at 0,2
  fill TFrame count 28 at 2,3
  for Y = 4 to 21
    put char TFrame at 2,Y
    put char TFrame at 29,Y
    for X = 3 to 28
      V = X & 1
      V = V + TWall
      put char V at X,Y
    next
  next
  fill TLine count 28 at 2,22
  fill TPlank count 28 at 2,23
  ' the side hoops: backboards on the walls, rims, nets
  for Y = 10 to 12
    put char TBoard at 3,Y
    put char TBoard at 28,Y
  next
  fill TRim count 3 at 3,13
  fill TRim count 3 at 26,13
  fill TNet count 3 at 3,14
  fill TNet count 3 at 26,14
  ' the centre hoop: its backboard hangs from the ceiling
  fill TBoardt count 4 at 14,4
  fill TRim count 4 at 14,8
  fill TNet count 4 at 14,9
  return
end sub

sub ShowHud:
  print at 2,2, "SAM"
  print at 13,2, "P"
  print at 22,2, "ED"
  ShowScores
  ShowPeriod
  ShowClock
  return
end sub

sub ShowScores:
  NumU = Sc[0]
  print at 6,2, digits$(NumU, 3)
  NumU = Sc[1]
  print at 25,2, digits$(NumU, 3)
  return
end sub

sub ShowPeriod:
  if Period > 4 then
    print at 13,2, "OT"
  else
    print at 13,2, "P"
    NumU = Period
    print at 14,2, digits$(NumU, 1)
  end if
  return
end sub

sub ShowClock:
  W16 = Gsec / 60
  NumU = W16
  print at 16,2, digits$(NumU, 2)
  print at 18,2, ":"
  W16 = W16 * 60
  NumU = Gsec - W16
  print at 19,2, digits$(NumU, 2)
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      stop sound SndRiffA
      stop sound SndRiffB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: the menus' reading (either joystick)
sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: Sam and Ed bounce on the floor, a joystick menu
sub TitlePage:
  NewScreen
  fill TLine count 28 at 2,22
  fill TPlank count 28 at 2,23
  print at 7,3, "B A S K E T B A L L"
  print at 9,5, "SAM  AND  ED"
  print at 5,8, "ONE-ON-ONE BOUNCING FUN"
  print at 10,12, "ONE PLAYER"
  print at 10,13, "TWO PLAYERS"
  print at 10,14, "CREDITS"
  print at 4,17, "LEFT BUTTON JUMPS, RIGHT"
  print at 4,18, "BUTTON PAUSES"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 384
  TzOn = 1
  Menu = 0
  ' Sam and Ed bounce on the title (wild, no control)
  Np = 2
  Ctl = 0
  Scoring = 0
  TipOff
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadPad
  for Pi = 0 to 1
    Phys
    if Gnd[Pi] = 1 then
      ' bounce again
      Rnd16
      V = Rs & 31
      T = V
      T = 0 - T
      T = T - 56
      Vy[Pi] = T
      Gnd[Pi] = 0
    end if
  next
  Collide
  DrawPlayers
  if Up1 = 1 then
    if WasStick = 0 then
      if Menu > 0 then dec Menu
      ShowMenu
    end if
  end if
  if Dn1 = 1 then
    if WasStick = 0 then
      if Menu < 2 then inc Menu
      ShowMenu
    end if
  end if
  WasStick = Up1 | Dn1
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 12 to 14
    put char 32 at 8,J
  next
  V = Menu + 12
  put char 62 at 8,V
  return
end sub

sub CreditsPage:
  NewScreen
  print at 4,2, "BASKETBALL SAM AND ED"
  print at 4,4, "BASED ON BASKETBALL SAM"
  print at 4,5, "AND ED BY RHETT ANDERSON"
  print at 4,6, "AND DAVID HENSLEY, JR.,"
  print at 4,7, "COMPUTE!'S GAZETTE"
  print at 4,8, "JULY 1987 (COMMODORE 64)."
  print at 4,10, "MADE FOR THE COLECOVISION"
  print at 4,11, "BY CLAUDE (AN AI MADE BY"
  print at 4,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 4,13, "2026, IN AMY BY AMY"
  print at 4,14, "BIENVENU."
  print at 4,16, "MUSIC (ORIGINAL):"
  print at 4,17, "FULL COURT, SWING BREAK"
  print at 9,20, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  WasBtn = 1
  return
end sub

