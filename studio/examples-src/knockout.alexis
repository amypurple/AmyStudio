record Boxer:
  u8 X
  u8 Y
  u8 Face
  u8 Pose
  u8 Punch
  u8 Hand
  u8 Done
  u8 Knock
  u8 KDir
  u8 Dazed
  u8 Stam
  u8 Pts
end record

' a timer for the title tune (kit/tuneonce.py pattern)
u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
Boxer Bx[2]
bcd digits 3 Shown[2]
u8 Pad[2]
u8 NPl = 1
u8 Cpu = 1
u8 Level = 0
u8 Phase = 0
u8 Winner = 0
u8 ByKo = 0
u8 Sel = 0
u8 Secs = 0
u8 Fr = 0
u16 Passes = 0
' the computer
u8 AiSee = 0
u8 AiSide = 0
u8 AiStep = 0
' passes with nobody landing a punch: a bored computer steps in
u16 AiBored = 0
u16 Seed = 1
' input
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Ri = 0
u8 Bl = 0
' scratch
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table KoSoundTable areas 7
  sprites 16x16
  sprites double
  sprites stable 0 to 1
  sprites flicker on
  set sprite count 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 3 then goto title

  RunRound

  ' the end: the result, then back to the title on a press
  ClearBand
  if ByKo = 1 then
    print at 11,MsgRow - 1, "KNOCKOUT!"
  else
    print at 12,MsgRow - 1, "TIME!"
  end if
  select case Winner
  case 0
    print at 6,MsgRow + 1, "BLUE CORNER WINS"
  case 1
    print at 6,MsgRow + 1, "RED CORNER WINS!"
  case else
    print at 8,MsgRow + 1, "IT IS A DRAW"
  end select
  Rearm
  wait 60 frames
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Phase = 0
  goto title

' ---------------------------------------------------------------------------
' the round

sub RunRound:
  DrawRing
  for Ri = 0 to 1
    Bx[Ri].X = StartX[Ri]
    Bx[Ri].Y = StartY[Ri]
    Bx[Ri].Pose = 0
    Bx[Ri].Punch = 0
    Bx[Ri].Hand = Ri
    Bx[Ri].Done = 0
    Bx[Ri].Knock = 0
    Bx[Ri].KDir = 0
    Bx[Ri].Dazed = 0
    Bx[Ri].Stam = StamMax
    Bx[Ri].Pts = 0
    Shown[Ri] = 0
  next
  Secs = RoundSecs
  Fr = 0
  Passes = 0
  AiSee = 0
  AiStep = 0
  AiBored = 0
  Winner = 2
  ByKo = 0
  Turn(0)
  Turn(1)
  ShowHud
  DrawSprites
  ShowScreen
  play sound SndBell
  Phase = 1
rr_loop:
  Frame1
  PlayStep
  if Phase = 1 then goto rr_loop
  ' the bell
  mute all
  play sound SndBell
  for Bl = 0 to 40
    Frame1
    DrawSprites
  next
  return
end sub

' one pass of play
sub PlayStep:
  inc Passes
  ReadPads
  if Cpu = 1 then AiThink
  for Pi = 0 to 1
    MoveBoxer(Pi)
  next
  Turn(0)
  Turn(1)
  for Pi = 0 to 1
    PunchStep(Pi)
  next
  for Pi = 0 to 1
    TryHit(Pi)
  next
  Clinch
  ' stamina back: a pip in 20 frames
  if (Tick & 1) = 0 then
    for Pi = 0 to 1
      if Bx[Pi].Stam < StamMax then inc Bx[Pi].Stam
    next
  end if
  ' the clock
  inc Fr
  if Fr >= 60 then
    Fr = 0
    dec Secs
    ShowClock
    if Secs = 0 then EndOnPoints
  end if
  ShowStam
  DrawSprites
  return
end sub

sub EndOnPoints:
  if Phase <> 1 then return
  Phase = 2
  if Bx[0].Pts > Bx[1].Pts then Winner = 0
  if Bx[1].Pts > Bx[0].Pts then Winner = 1
  return
end sub

' the stick: 1 up, 2 down, 4 left, 8 right, 16 a button
function StickOf(u8 C) as u8
  u8 S = 0
  if joypad(C).up then S = S | 1
  if joypad(C).down then S = S | 2
  if joypad(C).left then S = S | 4
  if joypad(C).right then S = S | 8
  if joypad(C).fire then S = S | 16
  return S

sub ReadPads:
  K = StickOf(1)
  N = StickOf(2)
  OldPads = Pads
  Pads = K | N
  if Cpu = 1 then
    Pad[0] = Pads
  else
    Pad[0] = K
    Pad[1] = N
  end if
  return
end sub

' a pixel a frame in the stick's direction (or pushed back while knocked),
' inside the ropes
sub MoveBoxer(u8 P):
  u8 D = Pad[P]
  if Bx[P].Knock > 0 then
    dec Bx[P].Knock
    D = Bx[P].KDir
  end if
  if Bx[P].Dazed > 0 then dec Bx[P].Dazed
  u8 Mx = Bx[P].X
  u8 My = Bx[P].Y
  if (D & 1) <> 0 then
    if My > MinY then dec My
  elseif (D & 2) <> 0 then
    if My < MaxY then inc My
  end if
  if (D & 4) <> 0 then
    if Mx > MinX then dec Mx
  elseif (D & 8) <> 0 then
    if Mx < MaxX then inc Mx
  end if
  Bx[P].X = Mx
  Bx[P].Y = My
  return
end sub

' the direction bits from boxer A towards boxer B (2 pixels of dead zone)
function DirTo(u8 A, u8 B) as u8
  u8 D = 0
  if Bx[B].Y + 2 < Bx[A].Y then D = 1
  if Bx[B].Y > Bx[A].Y + 2 then D = 2
  if Bx[B].X + 2 < Bx[A].X then D = D | 4
  if Bx[B].X > Bx[A].X + 2 then D = D | 8
  return D

' the facing (0 east, then clockwise in eighths) of P towards the other
sub Turn(u8 P):
  u8 Q = P ^ 1
  i16 Dx = Bx[Q].X
  i16 Dy = Bx[Q].Y
  Dx -= Bx[P].X
  Dy -= Bx[P].Y
  i16 Ax = abs(Dx)
  i16 Ay = abs(Dy)
  u8 Hz = 0
  ' mostly across, mostly up/down, or a diagonal
  if Ax > Ay * 2 then
    Hz = 1
  elseif Ay > Ax * 2 then
    Hz = 2
  end if
  select case Hz
  case 1
    if Dx >= 0 then
      Bx[P].Face = 0
    else
      Bx[P].Face = 4
    end if
  case 2
    if Dy >= 0 then
      Bx[P].Face = 2
    else
      Bx[P].Face = 6
    end if
  case else
    if Dx >= 0 then
      if Dy >= 0 then
        Bx[P].Face = 1
      else
        Bx[P].Face = 7
      end if
    else
      if Dy >= 0 then
        Bx[P].Face = 3
      else
        Bx[P].Face = 5
      end if
    end if
  end select
  return
end sub

' throw a punch while the button is held (stamina allowing); the glove is
' out at full stretch for 8 of its 14 frames
sub PunchStep(u8 P):
  if Bx[P].Punch > 0 then
    dec Bx[P].Punch
  else
    if (Pad[P] & 16) <> 0 then
      if Bx[P].Dazed = 0 then
        if Bx[P].Stam >= StamCost then
          Bx[P].Stam -= StamCost
          Bx[P].Punch = PunchLen
          Bx[P].Hand = Bx[P].Hand ^ 1
          Bx[P].Done = 0
          play sound SndSwish
        end if
      end if
    end if
  end if
  V = Bx[P].Punch
  if V >= 4 and V <= 11 then
    Bx[P].Pose = Bx[P].Hand + 1
  else
    Bx[P].Pose = 0
  end if
  return
end sub

' 1 when boxer P's glove for hand H (0 left, 1 right), out at full
' stretch, is on the other boxer's head
function Reaches(u8 P, u8 H) as u8
  u8 Q = P ^ 1
  u8 I = Bx[P].Face * 2 + H
  u8 Gx = Bx[P].X + JabX[I]
  u8 Gy = Bx[P].Y + JabY[I]
  u8 Cx = Bx[Q].X + 16
  u8 Cy = Bx[Q].Y + 16
  if absdiff(Gx, Cx) > HitReach then return 0
  if absdiff(Gy, Cy) > HitReach then return 0
  return 1

' a punch at full stretch on the head: a point, the other boxer knocked
' back and dazed, his punch cut short
sub TryHit(u8 P):
  u8 Q = P ^ 1
  if Bx[P].Pose = 0 then return
  if Bx[P].Done = 1 then return
  if Reaches(P, Bx[P].Hand) = 0 then return
  Bx[P].Done = 1
  inc Bx[P].Pts
  inc Shown[P]
  Bx[Q].Knock = KnockHit
  Bx[Q].KDir = DirTo(P, Q)
  if Bx[Q].KDir = 0 then Bx[Q].KDir = 2
  Bx[Q].Dazed = KnockHit
  Bx[Q].Punch = 0
  Bx[Q].Pose = 0
  play sound SndThump
  AiBored = 0
  ShowPts
  if Bx[P].Pts >= KoPts then
    if Phase = 1 then
      Phase = 2
      Winner = P
      ByKo = 1
    end if
  end if
  return
end sub

' the boxers bump: both pushed apart for 6 frames
sub Clinch:
  u8 Ddx = absdiff(Bx[0].X, Bx[1].X)
  u8 Ddy = absdiff(Bx[0].Y, Bx[1].Y)
  if Ddx >= NearBox then return
  if Ddy >= NearBox then return
  if Bx[0].Knock < KnockBump then
    if Bx[1].Knock < KnockBump then play sound SndBump
  end if
  for Ri = 0 to 1
    if Bx[Ri].Knock < KnockBump then
      Bx[Ri].Knock = KnockBump
      Bx[Ri].KDir = DirTo(Ri ^ 1, Ri)
    end if
  next
  return
end sub

' ---------------------------------------------------------------------------
' the computer boxes red: walks in to its range (sidestepping now and
' then), backs off when out of stamina, and punches when a glove would land
' after it has seen the chance for a set time

function Rnd as u8
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  u8 R = Seed & 255
  return R

sub AiThink:
  u8 S = 0
  u8 Ddx = absdiff(Bx[0].X, Bx[1].X)
  u8 Ddy = absdiff(Bx[0].Y, Bx[1].Y)
  u8 Far = Ddx
  if Ddy > Far then Far = Ddy
  u8 Lim = AiStopT[Level]
  inc AiBored
  if AiBored > 150 then Lim = NearBox + 1
  u8 Nx = Bx[1].Hand ^ 1
  ' a sidestep now and then: a new choice every 64 passes
  if AiStep = 0 then
    AiStep = 64
    V = Rnd
    AiSide = 0
    if V < 70 then AiSide = 1
    if V > 185 then AiSide = 2
  end if
  dec AiStep
  if Bx[1].Stam < StamCost then
    ' out of breath: keep away
    S = DirTo(0, 1)
  elseif Far > Lim then
    S = DirTo(1, 0)
  elseif Far < NearBox + 2 then
    S = DirTo(0, 1)
  end if
  if AiSide <> 0 then
    if Ddx > Ddy then
      if AiSide = 1 then
        S = (S & 12) | 1
      else
        S = (S & 12) | 2
      end if
    else
      if AiSide = 1 then
        S = (S & 3) | 4
      else
        S = (S & 3) | 8
      end if
    end if
  end if
  ' a punch: the next glove would land
  if Bx[1].Punch = 0 and Reaches(1, Nx) = 1 then
    inc AiSee
  else
    if AiSee > 0 then dec AiSee
  end if
  if AiSee >= AiReactT[Level] then
    if Bx[1].Stam >= StamCost then
      S = S | 16
      AiSee = 0
    end if
  end if
  Pad[1] = S
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub DrawRing:
  NewScreen
  ' the crowd all round, then the ring
  for Ri = 0 to 23
    for K = 0 to 30 step 2
      put char TCrowd1 at K,Ri
      put char TCrowd2 at K + 1,Ri
    next
  next
  fill TRopeh count 26 at 3,3
  fill TRopeb count 26 at 3,22
  for Ri = 4 to 21
    put char TRopel at 2,Ri
    fill TCanvas count 26 at 3,Ri
    put char TRoper at 29,Ri
  next
  put char TPostb at 2,3
  put char TPostw at 29,3
  put char TPostw at 2,22
  put char TPostr at 29,22
  put char TMark00 at 15,12
  put char TMark01 at 16,12
  put char TMark10 at 15,13
  put char TMark11 at 16,13
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  return
end sub

sub ClearBand:
  fill 32 count 28 at 2,MsgRow - 1
  fill 32 count 28 at 2,MsgRow
  fill 32 count 28 at 2,MsgRow + 1
  return
end sub

sub ShowHud:
  print at 2,1, "BLUE"
  print at 23,1, "RED"
  ShowPts
  ShowClock
  ShowStam
  return
end sub

sub ShowPts:
  print Shown[0] at 7,1
  print Shown[1] at 27,1
  return
end sub

sub ShowClock:
  u8 M = Secs / 60
  u8 S = Secs % 60
  NumU = M
  print at 14,1, digits$(NumU, 1)
  print at 15,1, ":"
  NumU = S
  print at 16,1, digits$(NumU, 2)
  return
end sub

' four pips each: blue on the left, red on the right of row 2
sub ShowStam:
  u8 L = 0
  u8 T = 0
  u8 C0 = 2
  for Ri = 0 to 1
    L = Bx[Ri].Stam / StamCost
    C0 = 2 + Ri * 24
    for K = 1 to 4
      T = TPipe
      if K <= L then T = TPip
      put char T at C0 + K - 1,2
    next
  next
  return
end sub

sub DrawSprites:
  u8 I = 0
  u8 C = 0
  for Ri = 0 to 1
    I = (Bx[Ri].Face * 3 + Bx[Ri].Pose) * 4
    Y = Bx[Ri].Y - 1
    X = Bx[Ri].X
    set sprite Ri to Y,X,SG00 + I,GearCol[Ri]
    C = BodyCol[Ri]
    if Bx[Ri].Dazed > 0 then C = 15
    set sprite Ri + 2 to Y,X,SB00 + I,C
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for K = 0 to 3
    set sprite K to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: KNOCKOUT in blocks, two boxers squaring up, the menu, the tune
' once

sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 32
  Sel = 0
  ShowMenu
  ' the two boxers face to face under the title
  Bx[0].X = 84
  Bx[0].Y = 92
  Bx[1].X = 140
  Bx[1].Y = 92
  for Ri = 0 to 1
    Bx[Ri].Pose = 0
    Bx[Ri].Dazed = 0
  next
  Turn(0)
  Turn(1)
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Seed
  if Seed = 0 then Seed = 1
  K = StickOf(1)
  N = StickOf(2)
  OldPads = Pads
  Pads = K | N
  N = Pads & (Pads ^ OldPads)
  ' the boxers bob: a jab each in turn
  V = Tick & 63
  Bx[0].Pose = 0
  Bx[1].Pose = 0
  if V < 8 then Bx[0].Pose = 2
  if V >= 32 and V < 40 then Bx[1].Pose = 1
  DrawSprites
  if (N & 1) <> 0 then
    if Sel > 0 then dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 then
    if Sel < 3 then inc Sel
    play sound SndPick
    ShowMenu
  end if
  select case Sel
  case 1
    if (N & 28) <> 0 then
      NPl = 3 - NPl
      play sound SndPick
      ShowMenu
    end if
  case 2
    if (N & 28) <> 0 then
      Level = Level ^ 1
      play sound SndPick
      ShowMenu
    end if
  case else
    if (N & 16) <> 0 then goto tp_done
  end select
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Cpu = 0
  if NPl = 1 then Cpu = 1
  if Sel = 3 then
    CreditsPage
  end if
  return
end sub

sub ShowMenu:
  for K = 0 to 3
    put char 32 at 7,K + 17
  next
  put char 62 at 7,Sel + 17
  print at 9,17, "START"
  if NPl = 1 then
    print at 9,18, "ONE VS COMPUTER"
  else
    print at 9,18, "TWO PLAYERS    "
  end if
  NumU = Level + 1
  print at 9,19, "LEVEL ", digits$(NumU, 1)
  if Level = 0 then
    print at 17,19, "(EASY)"
  else
    print at 17,19, "(HARD)"
  end if
  print at 9,20, "CREDITS"
  return
end sub

sub CreditsPage:
  NewScreen
  print at 12,2, "KNOCKOUT"
  print at 2,5, "BASED ON KNOCKOUT, AHOY!"
  print at 2,6, "JANUARY 1986 (COMMODORE 64,"
  print at 2,7, "NO AUTHOR NAMED)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,15, "MUSIC: RINGSIDE (ORIGINAL)"
  print at 2,17, "LAND 100 PUNCHES FOR A KO,"
  print at 2,18, "OR LEAD ON POINTS AT 0:00."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
KoSwish:
    db $00,$00,$57,$02,$00,$00,$66,$02,$00,$00,$75,$02,$10
KoThump:
    db $00,$00,$14,$02,$00,$00,$25,$03,$00,$00,$36,$04,$00,$00,$56,$04,$10
KoBump:
    db $40,$3B,$32,$03,$40,$F9,$42,$03,$50
KoBell:
    db $40,$47,$10,$06,$40,$47,$20,$06,$40,$47,$30,$06,$40,$47,$40,$08,$40,$47,$50,$0A,$50
KoPick:
    db $40,$55,$40,$02,$50

KoSoundTable:
    dw KoTuneMel,$702B
    dw KoTuneBass,$7035
    dw KoSwish,$703F
    dw KoThump,$703F
    dw KoBump,$7049
    dw KoBell,$7049
    dw KoPick,$7049
; Ringside (original)
; Tiny Sound, 8 frames per step
KoTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$23,$01,$01,$23,$28,$01,$26,$01,$23,$01,$21,$01
    db $23,$01,$01,$01,$1F,$01,$21,$01,$23,$01,$26,$01,$28,$01,$26,$01
    db $23,$01,$01,$01,$23,$01,$01,$23,$28,$01,$2A,$01,$2B,$01,$2A,$01
    db $28,$01,$26,$01,$23,$01,$26,$01,$28,$01,$01,$01,$28,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
KoTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$10,$01,$17,$01,$10,$01,$17,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$0C,$01,$13,$01,$0C,$01,$13,$01,$0B,$01,$12,$01
    db $0B,$01,$12,$01,$10,$01,$17,$01,$10,$01,$17,$01,$0C,$01,$13,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$0B,$01,$0F,$01,$10,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
