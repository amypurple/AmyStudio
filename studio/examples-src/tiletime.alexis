cartridge "TILE TIME/MURDOCK & BLACKBURN/1985"

' TILE TIME
' A ColecoVision game based on "Tile Time" (the listing calls it "The Tile
' Game") by Murdock & Blackburn, Ahoy! May 1985 (Commodore 64 BASIC with
' a small machine-language scroller). Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/tiletime.bas), the game is built for the ColecoVision:
' bevelled tiles with big letters, tiles that glide into place, a cursor
' frame that moves smoothly, sound effects and an original title tune.
'
' The game: a 5 x 5 tray holds 24 lettered tiles, A to X, and one gap.
' Move the cursor frame onto a tile in the same row or column as the gap
' and press the left button: that tile and every tile between it and the
' gap slide one place toward the gap (a whole line at once, one move).
' Put the letters back in order, A to X, the gap at the bottom right.
'
' From the original: the 5 x 5 tray with 24 letters A-X and the gap at
' the bottom right; the letters coloured by their home row; the cursor
' moved one cell at a time; a press slides the whole line between the
' cursor and the gap, counted as one move; the cursor then follows the
' tile it pushed; a buzzer for a tile out of line with the gap; the mix:
' 20 rounds of a random slide along the gap's row (1-4 places, a random
' side, drawn again when off the tray) and then along its column; the
' move counter, cleared after the mix; the unmixed choice (MIX Y/N).
'
' Liberties: joystick only (the original also took the keyboard). The
' original never notices a finished puzzle (CLR/HOME starts again); here
' a solved tray ends the game with the moves and the time, and the best
' move count is kept. A clock counts the seconds. A LIGHT MIX (5 rounds)
' is offered for beginners, and the unmixed tray became that choice: a
' tray without a mix has nothing to solve. A mix that leaves fewer than
' 10 (FULL) or 4 (LIGHT) tiles away from home goes on with more rounds.
' The cursor frame is yellow on a tile that can slide and red on one that
' cannot (cyan on the gap). Holding the right button for two seconds
' gives up (the original's CLR/HOME). Tiles slide in four smooth steps
' instead of the C64's character scroll.
'
' Controls: either controller; the stick moves the cursor (hold to
' repeat), the left button slides, the right button held gives up. On
' the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects
' after; the title tune is played once. `set sprite count` is always
' given. Own xorshift random numbers. Nothing flashes.

const TTl = 128
const TT = 129
const TTr = 130
const TL = 131
const TR = 132
const TBl = 133
const TB = 134
const TBr = 135
const TFelt = 136
const TFtl = 137
const TFt = 138
const TFtr = 139
const TFl = 140
const TFr = 141
const TFbl = 142
const TFb = 143
const TFbr = 144
const TGa00 = 145
const TGa01 = 146
const TGa10 = 147
const TGa11 = 148
const TGb00 = 149
const TGb01 = 150
const TGb10 = 151
const TGb11 = 152
const TGc00 = 153
const TGc01 = 154
const TGc10 = 155
const TGc11 = 156
const TGd00 = 157
const TGd01 = 158
const TGd10 = 159
const TGd11 = 160
const TGe00 = 161
const TGe01 = 162
const TGe10 = 163
const TGe11 = 164
const TGf00 = 165
const TGf01 = 166
const TGf10 = 167
const TGf11 = 168
const TGg00 = 169
const TGg01 = 170
const TGg10 = 171
const TGg11 = 172
const TGh00 = 173
const TGh01 = 174
const TGh10 = 175
const TGh11 = 176
const TGi00 = 177
const TGi01 = 178
const TGi10 = 179
const TGi11 = 180
const TGj00 = 181
const TGj01 = 182
const TGj10 = 183
const TGj11 = 184
const TGk00 = 185
const TGk01 = 186
const TGk10 = 187
const TGk11 = 188
const TGl00 = 189
const TGl01 = 190
const TGl10 = 191
const TGl11 = 192
const TGm00 = 193
const TGm01 = 194
const TGm10 = 195
const TGm11 = 196
const TGn00 = 197
const TGn01 = 198
const TGn10 = 199
const TGn11 = 200
const TGo00 = 201
const TGo01 = 202
const TGo10 = 203
const TGo11 = 204
const TGp00 = 205
const TGp01 = 206
const TGp10 = 207
const TGp11 = 208
const TGq00 = 209
const TGq01 = 210
const TGq10 = 211
const TGq11 = 212
const TGr00 = 213
const TGr01 = 214
const TGr10 = 215
const TGr11 = 216
const TGs00 = 217
const TGs01 = 218
const TGs10 = 219
const TGs11 = 220
const TGt00 = 221
const TGt01 = 222
const TGt10 = 223
const TGt11 = 224
const TGu00 = 225
const TGu01 = 226
const TGu10 = 227
const TGu11 = 228
const TGv00 = 229
const TGv01 = 230
const TGv10 = 231
const TGv11 = 232
const TGw00 = 233
const TGw01 = 234
const TGw10 = 235
const TGw11 = 236
const TGx00 = 237
const TGx01 = 238
const TGx10 = 239
const TGx11 = 240
const SCtl = 0
const SCtr = 4
const SCbl = 8
const SCbr = 12
const NTiles8 = 904
const SprBytes = 128
const SndTuneA = 1
const SndTuneB = 2
const SndSlide = 3
const SndBuzz = 4
const SndTick = 5
const SndMix = 6
const SndStart = 7
const SndWin = 8
const SndQuit = 9
const NSpr = 4
const TuneLen = 540
const QuitN = 120
const BoardX = 3
const BoardY = 2

record Cursor:
  u8 Row
  u8 Col
  u8 X
  u8 Y
end record

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Mv = 0
u16 Best = 0
bcd digits 4 Secs = 0
u8 SecT = 0
' the tray: Bd[cell] = 0 for the gap, 1-24 for A-X; Mm marks the tiles
' sliding now; the gap's cell
u8 Bd[25]
u8 Mm[25]
u8 Buf[20]
u8 Gap = 24
Cursor Cur
' game state: 0 title, 1 mixing, 2 playing, 3 sliding, 4 over
u8 Gs = 0
u8 Won = 0
' the slide: direction of the tiles (0 left, 1 right, 2 up, 3 down, 255
' none) and its step (0-4 characters)
u8 AD = 255
u8 As = 0
u8 Fast = 0
u8 QuitT = 0
u8 Rpt = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Light = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Btn2 = 0
u8 WasStick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Si = 0
u8 MixI = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TtSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 3
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  Clock
  PlayInput
  MoveCursor
  if Gs <> 4 then goto play_loop

  ' the end: a message, then back to the title on a press
  mute all
  HideSprites
  if Won = 1 then
    if Best = 0 then Best = Mv
    if Mv < Best then Best = Mv
    ShowHud
    print at 5,8, "                "
    print at 5,9, "   SOLVED IN    "
    print at 5,10, "                "
    NumU = Mv
    print at 9,10, digits$(NumU, 5)
    print at 15,10, "MOVES"
    print at 5,11, "                "
    print at 5,12, "  TIME      SEC "
    print Secs at 12,12
    print at 5,13, "                "
    play sound SndWin
  else
    print at 5,9, "                "
    print at 5,10, "    GIVEN UP    "
    print at 5,11, "                "
    play sound SndQuit
  end if
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the tray

' the cell (0-24) under board character X, Y (0-19)
function CellOf(u8 Px, u8 Py) as u8
  return (Py >> 2) * 5 + (Px >> 2)

' the character of tile T (1-24) at its local position Lx, Ly (0-3)
function TileChar(u8 T, u8 Lx, u8 Ly) as u8
  u8 Res = 0
  select case (Lx, Ly)
  case (0, 0)
    Res = TTl
  case (3, 0)
    Res = TTr
  case (1 to 2, 0)
    Res = TT
  case (0, 3)
    Res = TBl
  case (3, 3)
    Res = TBr
  case (1 to 2, 3)
    Res = TB
  case (0, 1 to 2)
    Res = TL
  case (3, 1 to 2)
    Res = TR
  case else
    Res = TGa00 + ((T - 1) << 2) + ((Ly - 1) << 1) + Lx - 1
  end select
  return Res

' what board character X, Y shows now, with the sliding tiles AS
' characters along their way
function CharAt(u8 Qx, u8 Qy) as u8
  u8 Sx = 0
  u8 Sy = 0
  u8 Ce = 0
  Sx = Qx
  Sy = Qy
  select case AD
  case 0
    Sx = Qx + As
  case 1
    Sx = Qx - As
  case 2
    Sy = Qy + As
  case 3
    Sy = Qy - As
  end select
  if Sx < 20 then
    if Sy < 20 then
      Ce = CellOf(Sx, Sy)
      if Mm[Ce] = 1 then return TileChar(Bd[Ce], Sx & 3, Sy & 3)
    end if
  end if
  Ce = CellOf(Qx, Qy)
  if Mm[Ce] = 1 then return TFelt
  if Bd[Ce] = 0 then return TFelt
  return TileChar(Bd[Ce], Qx & 3, Qy & 3)

' draw board characters X0.. (W wide), rows Y0.. (H high) through Buf
sub DrawStrip(u8 X0, u8 Y0, u8 W, u8 H):
  u8 Yy = 0
  u8 Xx = 0
  u8 Ye = 0
  u8 Xe = 0
  u16 Va = 0
  Ye = Y0 + H - 1
  Xe = W - 1
  for Yy = Y0 to Ye
    for Xx = 0 to Xe
      Buf[Xx] = CharAt(X0 + Xx, Yy)
    next
    Va = Yy + BoardY
    Va = Va * 32 + X0 + BoardX
    copy Buf count W to vram.name + Va
  next
  return

sub DrawBoard:
  AD = 255
  DrawStrip(0, 0, 20, 20)
  return

sub DrawFrame:
  put char TFtl at 2,1
  put char TFtr at 23,1
  put char TFbl at 2,22
  put char TFbr at 23,22
  fill TFt count 20 at 3,1
  fill TFb count 20 at 3,22
  for Ri = 2 to 21
    put char TFl at 2,Ri
    put char TFr at 23,Ri
  next
  return

' 1 when the tray is in order (A-X, the gap last)
function Solved as u8
  for Si = 0 to 23
    if Bd[Si] <> Si + 1 then return 0
  next
  return 1

' tiles away from their home cell
function Misplaced as u8
  u8 Cnt = 0
  for Si = 0 to 23
    if Bd[Si] <> Si + 1 then inc Cnt
  next
  return Cnt

' 0 when the cursor's tile can't slide, 1 when it can, 2 on the gap
function CanSlide as u8
  u8 Gr = 0
  u8 Gc = 0
  Gr = Gap / 5
  Gc = Gap - Gr * 5
  if Cur.Row = Gr then
    if Cur.Col = Gc then return 2
    return 1
  end if
  if Cur.Col = Gc then return 1
  return 0

' slide the cursor's line toward the gap (CanSlide must be 1), animated;
' the cursor follows the tile it pushed
sub DoSlide:
  u8 Gr = 0
  u8 Gc = 0
  u8 A = 0
  u8 B = 0
  u8 I = 0
  u8 Ce = 0
  Gr = Gap / 5
  Gc = Gap - Gr * 5
  if Cur.Row = Gr then
    if Cur.Col < Gc then
      AD = 1
      A = Cur.Col
      B = Gc - 1
    else
      AD = 0
      A = Gc + 1
      B = Cur.Col
    end if
    for I = A to B
      Ce = Gr * 5 + I
      Mm[Ce] = 1
    next
    A = min(Cur.Col, Gc)
    B = max(Cur.Col, Gc)
    Animate(A << 2, Gr << 2, (B - A + 1) << 2, 4)
    ' move the values: the gap goes to the cursor's cell
    if AD = 1 then
      for I = Gc downto Cur.Col + 1
        Ce = Gr * 5 + I
        Bd[Ce] = Bd[Ce - 1]
      next
      inc Cur.Col
    else
      for I = Gc to Cur.Col - 1
        Ce = Gr * 5 + I
        Bd[Ce] = Bd[Ce + 1]
      next
      dec Cur.Col
    end if
    Gap = Gr * 5 + Cur.Col
    if AD = 1 then
      dec Gap
    else
      inc Gap
    end if
  else
    if Cur.Row < Gr then
      AD = 3
      A = Cur.Row
      B = Gr - 1
    else
      AD = 2
      A = Gr + 1
      B = Cur.Row
    end if
    for I = A to B
      Ce = I * 5 + Gc
      Mm[Ce] = 1
    next
    A = min(Cur.Row, Gr)
    B = max(Cur.Row, Gr)
    Animate(Gc << 2, A << 2, 4, (B - A + 1) << 2)
    if AD = 3 then
      for I = Gr downto Cur.Row + 1
        Ce = I * 5 + Gc
        Bd[Ce] = Bd[Ce - 5]
      next
      inc Cur.Row
      Gap = (Cur.Row - 1) * 5 + Gc
    else
      for I = Gr to Cur.Row - 1
        Ce = I * 5 + Gc
        Bd[Ce] = Bd[Ce + 5]
      next
      dec Cur.Row
      Gap = (Cur.Row + 1) * 5 + Gc
    end if
  end if
  Bd[Gap] = 0
  fill array Mm with 0
  AD = 255
  As = 0
  return

' the slide's four steps over the strip X0, Y0, W x H (board characters;
' the strip covers the sliding tiles and the gap)
sub Animate(u8 X0, u8 Y0, u8 W, u8 H):
  for As = 1 to 4
    if Fast = 0 then
      Frame1
      ReadPad
      Clock
      MoveCursor
    end if
    Frame1
    if Fast = 0 then Clock
    DrawStrip(X0, Y0, W, H)
  next
  As = 0
  return

' ---------------------------------------------------------------------------
' play

sub PlayInput:
  u8 S = 0
  u8 St = 0
  if Btn2 > 0 then
    inc QuitT
    if QuitT >= QuitN then
      Won = 0
      Gs = 4
      return
    end if
  else
    QuitT = 0
  end if
  St = J1 | J2
  St = St & 15
  if St = 0 then
    Rpt = 0
  elseif Rpt > 0 then
    dec Rpt
  else
    if WasStick = 0 then
      Rpt = 14
    else
      Rpt = 6
    end if
    MoveBy(St)
  end if
  WasStick = St
  if Press = 0 then return
  S = CanSlide
  select case S
  case 1
    Gs = 3
    play sound SndSlide
    DoSlide
    inc Mv
    ShowMoves
    Gs = 2
    if Solved = 1 then
      Won = 1
      Gs = 4
    end if
  case 0
    play sound SndBuzz
  end select
  return

' one cell in the stick's direction (the first of up, down, right, left)
sub MoveBy(u8 St):
  if (St & 1) > 0 then
    if Cur.Row > 0 then
      dec Cur.Row
      play sound SndTick
    end if
    return
  end if
  if (St & 2) > 0 then
    if Cur.Row < 4 then
      inc Cur.Row
      play sound SndTick
    end if
    return
  end if
  if (St & 8) > 0 then
    if Cur.Col < 4 then
      inc Cur.Col
      play sound SndTick
    end if
    return
  end if
  if (St & 4) > 0 then
    if Cur.Col > 0 then
      dec Cur.Col
      play sound SndTick
    end if
  end if
  return

' the cursor frame glides 4 pixels a frame toward its cell
sub MoveCursor:
  u8 Tx = 0
  u8 Ty = 0
  u8 Co = 0
  Tx = Cur.Col * 32 + BoardX * 8
  Ty = Cur.Row * 32 + BoardY * 8
  if Cur.X < Tx then Cur.X += 4
  if Cur.X > Tx then Cur.X -= 4
  if Cur.Y < Ty then Cur.Y += 4
  if Cur.Y > Ty then Cur.Y -= 4
  select case CanSlide
  case 0
    Co = 9
  case 1
    Co = 11
  case else
    Co = 7
  end select
  Y = Cur.Y - 1
  set sprite 0 to Y,Cur.X,SCtl,Co
  X = Cur.X + 16
  set sprite 1 to Y,X,SCtr,Co
  Y = Y + 16
  set sprite 2 to Y,Cur.X,SCbl,Co
  set sprite 3 to Y,X,SCbr,Co
  update sprites
  return

sub Clock:
  if Gs = 4 then return
  inc SecT
  if SecT < 60 then return
  SecT = 0
  if Secs < 9999 then inc Secs
  print Secs at 26,12
  return

sub ShowMoves:
  NumU = Mv
  print at 25,8, digits$(NumU, 5)
  return

sub ShowHud:
  print at 25,3, "TILE"
  print at 25,4, "TIME"
  print at 25,7, "MOVES"
  ShowMoves
  print at 25,11, "TIME"
  print Secs at 26,12
  print at 25,15, "BEST"
  if Best = 0 then
    print at 25,16, "-----"
  else
    NumU = Best
    print at 25,16, digits$(NumU, 5)
  end if
  print at 25,19, "HOLD"
  print at 25,20, "RIGHT"
  print at 25,21, "=QUIT"
  return

' ---------------------------------------------------------------------------
' the mix

function Rand as u16
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs

' a number 1-4 and a side (0, 1), as the listing's lines 4180-4190
sub Draw4:
  W16 = Rand
  K = W16 & 3
  inc K
  W16 = W16 >> 4
  J = W16 & 1
  return

' the listing's mix: a slide along the gap's row, then along its column
sub MixBoard(u8 Rounds):
  u8 Gr = 0
  u8 Gc = 0
  u8 T = 0
  for MixI = 1 to Rounds
    Gr = Gap / 5
    Gc = Gap - Gr * 5
    do
      Draw4
      if J = 1 then
        T = Gc - K
      else
        T = Gc + K
      end if
    loop until T < 5
    Cur.Row = Gr
    Cur.Col = T
    play sound SndMix
    DoSlide
    Gr = Gap / 5
    Gc = Gap - Gr * 5
    do
      Draw4
      if J = 1 then
        T = Gr - K
      else
        T = Gr + K
      end if
    loop until T < 5
    Cur.Row = T
    Cur.Col = Gc
    play sound SndMix
    DoSlide
  next
  return

sub NewGame:
  u8 MinM = 10
  NewScreen
  DrawFrame
  for Si = 0 to 23
    Bd[Si] = Si + 1
  next
  Bd[24] = 0
  Gap = 24
  fill array Mm with 0
  DrawBoard
  Mv = 0
  Secs = 0
  SecT = 0
  QuitT = 0
  Won = 0
  ShowHud
  print at 25,12, "     "
  Cur.Row = 4
  Cur.Col = 4
  Cur.X = 4 * 32 + BoardX * 8
  Cur.Y = 4 * 32 + BoardY * 8
  ShowScreen
  Gs = 1
  Fast = 1
  if Light = 1 then
    MinM = 4
    MixBoard(5)
  else
    MixBoard(20)
  end if
  while Misplaced < MinM
    MixBoard(2)
  end while
  Fast = 0
  Mv = 0
  ShowMoves
  Secs = 0
  print Secs at 26,12
  Cur.X = Cur.Col * 32 + BoardX * 8
  Cur.Y = Cur.Row * 32 + BoardY * 8
  MoveCursor
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Gs = 2
  return

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 16
  Btn2 = V & 32
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a whole tile T with its corner at screen character X, Y
sub PutTile(u8 T, u8 Px, u8 Py):
  u8 Lx = 0
  u8 Ly = 0
  u8 Ch = 0
  u8 Sx = 0
  u8 Sy = 0
  for Ly = 0 to 3
    for Lx = 0 to 3
      Ch = TileChar(T, Lx, Ly)
      Sx = Px + Lx
      Sy = Py + Ly
      put char Ch at Sx,Sy
    next
  next
  return

data TitleW bytes
  20, 9, 12, 5, 20, 9, 13, 5
end data

' the title: TILE TIME in tiles, the tune once, FULL MIX / LIGHT MIX /
' CREDITS
sub TitlePage:
  Gs = 0
  NewScreen
  for Ci = 0 to 3
    X = Ci * 4 + 8
    PutTile(TitleW[Ci], X, 2)
    V = Ci + 4
    PutTile(TitleW[V], X, 6)
  next
  print at 4,11, "BY MURDOCK & BLACKBURN"
  print at 6,12, "AHOY! MAY 1985 (C64)"
  print at 11,15, "FULL MIX"
  print at 11,16, "LIGHT MIX"
  print at 11,17, "CREDITS"
  print at 3,20, "PUT THE LETTERS IN ORDER"
  if Best > 0 then
    print at 10,22, "BEST"
    NumU = Best
    print at 15,22, digits$(NumU, 5)
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneLen
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if (V & 1) > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 2 then inc Menu
      end if
      play sound SndTick
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  Light = 0
  if Menu = 1 then Light = 1
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowMenu:
  for Ri = 15 to 17
    put char 32 at 9,Ri
  next
  J = Menu + 15
  put char 62 at 9,J
  return

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "TILE TIME"
  print at 2,4, "BASED ON THE TILE GAME BY"
  print at 2,5, "MURDOCK & BLACKBURN, AHOY!"
  print at 2,6, "MAY 1985 (COMMODORE 64)."
  print at 2,8, "SLIDE THE 24 LETTERS BACK"
  print at 2,9, "INTO ORDER, A TO X. A PRESS"
  print at 2,10, "MOVES THE WHOLE LINE FROM"
  print at 2,11, "THE CURSOR TO THE GAP."
  print at 2,14, "COLECOVISION GAME, MUSIC"
  print at 2,15, "AND PICTURES BY CLAUDE"
  print at 2,16, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,17, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,19, "MUSIC: SLIDING SQUARES"
  print at 2,20, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

