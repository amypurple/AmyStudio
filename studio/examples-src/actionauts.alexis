u8 V = 0
u8 X = 0
u8 Y = 0
u16 W16 = 0

  tile screen
  set sound table AnSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  nmi off
  CreditsPage

title:
  TitlePage
  if MenuI = 2 then
    CreditsPage
    goto title
  end if
  if MenuI = 0 then
    Mode = 1
    Pz = 0
    Passed = 0
    TotRuns = 0
    LoadPuzzle
  else
    Mode = 2
    LoadToy
  end if
  Quit = 0
  DrawWork

work_loop:
  Wt = 3
  Frame1
  ReadPad
  WorkInput
  DrawFigs
  if Quit = 1 then goto quit_work
  if Quit = 2 then goto game_end
  goto work_loop

quit_work:
  ' leaving the toybox goes straight back to the title; leaving the tests
  ' ends the game with a message
  if Mode = 2 then goto title

game_end:
  EndPage
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV; a press goes back to the title
  Wt = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the rules: one run frame for every figure (model.mjs is the same in JS)

function CellAt(u8 Cc, u8 Rr) as u8
  if Cc >= 10 then return 1
  if Rr >= 8 then return 1
  return Live[Rr * 10 + Cc]

function FloorLike(u8 Cc, u8 Rr) as u8
  if CellAt(Cc, Rr) = 1 then return 0
  return 1

function Occupied(u8 Me, u8 Cc, u8 Rr) as u8
  u8 Oi = 0
  ' cheapest tests first: a figure elsewhere fails on its column
  for Oi = 0 to 4
    if Figs[Oi].Col = Cc then
      if Figs[Oi].Row = Rr then
        if Taken(Oi, Me) = 1 then return 1
      end if
    end if
    if Figs[Oi].TCol = Cc then
      if Figs[Oi].TRow = Rr then
        if Figs[Oi].Mov = 1 then
          if Taken(Oi, Me) = 1 then return 1
        end if
      end if
    end if
  next
  return 0

' figure Oi counts as being somewhere: on the grid, not falling, not me
function Taken(u8 Oi, u8 Me) as u8
  if Oi = Me then return 0
  if Figs[Oi].Here = 0 then return 0
  if Figs[Oi].St >= FFall then return 0
  return 1

sub StartStep(u8 F):
  u8 Tc = 0
  u8 Tr = 0
  u8 D = 0
  D = Figs[F].Dir
  Tc = Figs[F].Col + DcT[D]
  Tr = Figs[F].Row + DrT[D]
  if Occupied(F, Tc, Tr) = 1 then
    Figs[F].Togo = 0
    Figs[F].Busy = 8
    play sound SndBump
    return
  end if
  Figs[F].Mov = 1
  Figs[F].T = 0
  Figs[F].TCol = Tc
  Figs[F].TRow = Tr
  SndQ = SndQ | 1
  return
end sub

sub CallFig(u8 P):
  if P >= NF then return
  if Figs[P].Here = 0 then return
  if Figs[P].St = FRun then return
  if Figs[P].St >= FFall then return
  Figs[P].St = FRun
  Figs[P].Pc = 0
  Figs[P].Busy = 0
  Figs[P].Togo = 0
  play sound SndCall
  return
end sub

sub Arrive(u8 F):
  u8 Ak = 0
  Figs[F].T = 0
  Figs[F].Mov = 0
  Figs[F].Col = Figs[F].TCol
  Figs[F].Row = Figs[F].TRow
  SetBase(F)
  Ak = CellAt(Figs[F].Col, Figs[F].Row)
  if Ak = 1 then
    Figs[F].St = FFall
    Figs[F].Fall = 0
    Figs[F].Togo = 0
    play sound SndFall
    return
  end if
  if Ak = 2 then TakeStar(F)
  dec Figs[F].Togo
  if Figs[F].Togo > 0 then StartStep(F)
  return
end sub

sub FigFrame(u8 F):
  u8 Sp = 0
  u8 Op = 0
  u8 Cm = 0
  u16 Pi = 0
  if Figs[F].St = FFall then
    inc Figs[F].Fall
    if Figs[F].Fall >= 24 then Figs[F].St = FOut
    return
  end if
  if Figs[F].St <> FRun then return
  if Figs[F].Mov = 1 then
    ' the glide: T in 1/256 of a cell; arriving when T + speed reaches 256
    Sp = SpdT[F]
    if Figs[F].T >= 256 - Sp then
      Arrive(F)
    else
      Figs[F].T = Figs[F].T + Sp
    end if
    return
  end if
  if Figs[F].Busy > 0 then
    dec Figs[F].Busy
    return
  end if
  if F = Manual then
    ManStep(F)
    return
  end if
  if Figs[F].Pc >= NL then
    Figs[F].St = FDone
    return
  end if
  Pi = F * 16 + Figs[F].Pc
  Op = Prog[Pi]
  if Op = 255 then
    Figs[F].St = FDone
    return
  end if
  Cm = Op & 15
  inc Figs[F].Pc
  select case Cm
    case 0, 1, 2
      Figs[F].Togo = 1 << Cm
      StartStep(F)
    case 3
      Figs[F].Dir = (Figs[F].Dir + 3) & 3
      Figs[F].Busy = 8
      SndQ = SndQ | 2
    case 4
      Figs[F].Dir = (Figs[F].Dir + 1) & 3
      Figs[F].Busy = 8
      SndQ = SndQ | 2
    case 5
      Figs[F].Pc = Op >> 4
      Figs[F].Busy = 4
    case 6
      Figs[F].Busy = 16
    case 7
      CallFig(Op >> 4)
      Figs[F].Busy = 4
  end select
  return
end sub

' MANUAL: the stick instead of the program (up steps, left/right turn)
sub ManStep(u8 F):
  V = Stick & 1
  if V > 0 then
    Figs[F].Togo = 1
    StartStep(F)
    return
  end if
  V = Stick & 4
  if V > 0 then
    Figs[F].Dir = (Figs[F].Dir + 3) & 3
    Figs[F].Busy = 8
    play sound SndTurn
    return
  end if
  V = Stick & 8
  if V > 0 then
    Figs[F].Dir = (Figs[F].Dir + 1) & 3
    Figs[F].Busy = 8
    play sound SndTurn
  end if
  return
end sub

sub RunFrame:
  SndQ = 0
  for Fi = 0 to 4
    FigFrame(Fi)
  next
  inc RunT
  ' one step or turn sound a frame, however many figures start one
  if SndQ = 1 then play sound SndStep
  if SndQ >= 2 then play sound SndTurn
  return
end sub

function Active as u8
  u8 Ai = 0
  for Ai = 0 to 4
    if Figs[Ai].Here = 1 then
      if Figs[Ai].St = FRun then return 1
      if Figs[Ai].St = FFall then return 1
    end if
  next
  return 0

sub TakeStar(u8 F):
  u8 Sc = 0
  u8 Sr = 0
  Sc = Figs[F].Col
  Sr = Figs[F].Row
  Live[Sr * 10 + Sc] = 0
  if Stars > 0 then dec Stars
  DrawCell(Sc, Sr)
  SparkT = 20
  SparkX = CellX(Sc, Sr)
  SparkY = Sr * 16 - 2
  play sound SndStar
  ShowInfo
  return
end sub

' every figure back to its set-up, the grid as designed
sub ResetFigs:
  u16 Ix = 0
  for Fi = 0 to 4
    Figs[Fi].Col = Figs[Fi].SCol
    Figs[Fi].Row = Figs[Fi].SRow
    Figs[Fi].Dir = Figs[Fi].SDir
    Figs[Fi].St = FIdle
    Figs[Fi].Pc = 0
    Figs[Fi].Togo = 0
    Figs[Fi].Busy = 0
    Figs[Fi].Mov = 0
    Figs[Fi].T = 0
    Figs[Fi].Fall = 0
    SetBase(Fi)
  next
  for Ix = 0 to 79
    if Live[Ix] <> Design[Ix] then
      Live[Ix] = Design[Ix]
      Gr = Ix / 10
      Gc = Ix - Gr * 10
      DrawCell(Gc, Gr)
    end if
  next
  Stars = CountStars
  SparkT = 0
  RunT = 0
  return
end sub

function CountStars as u8
  u8 Sn = 0
  u8 Si = 0
  for Si = 0 to 79
    if Live[Si] = 2 then inc Sn
  next
  return Sn

' ---------------------------------------------------------------------------
' loading a test or the toybox

sub LoadPuzzle:
  u16 Base = 0
  u8 Ii = 0
  Base = Pz * 80
  for Ii = 0 to 79
    Design[Ii] = PzGrid[Base + Ii]
    Live[Ii] = Design[Ii]
  next
  Base = Pz * 22
  LoadInfo(Base, 0)
  fill array Prog with 255
  Runs = 0
  return
end sub

sub LoadToy:
  u8 Ii = 0
  for Ii = 0 to 79
    Design[Ii] = ToyGrid[Ii]
    Live[Ii] = Design[Ii]
    Prog[Ii] = ToyProg[Ii]
  next
  LoadInfo(0, 1)
  Runs = 0
  return
end sub

' the limit, the starters and the five figures (here, col, row, facing)
sub LoadInfo(u16 Base, u8 Toy):
  u16 P = 0
  u8 Fj = 0
  P = Base
  if Toy = 1 then
    Limit = ToyInfo[0]
    StartMask = ToyInfo[1]
  else
    Limit = PzInfo[P]
    StartMask = PzInfo[P + 1]
  end if
  P = P + 2
  for Fj = 0 to 4
    if Toy = 1 then
      Figs[Fj].Here = ToyInfo[P]
      Figs[Fj].SCol = ToyInfo[P + 1]
      Figs[Fj].SRow = ToyInfo[P + 2]
      Figs[Fj].SDir = ToyInfo[P + 3]
    else
      Figs[Fj].Here = PzInfo[P]
      Figs[Fj].SCol = PzInfo[P + 1]
      Figs[Fj].SRow = PzInfo[P + 2]
      Figs[Fj].SDir = PzInfo[P + 3]
    end if
    P = P + 4
  next
  ResetFigs
  Sel = 0
  MenuI = 0
  return
end sub

' ---------------------------------------------------------------------------
' the grid in tiles

' x of a figure sprite standing on a cell; col or row 255 (-1, off the
' grid) works by the byte arithmetic wrapping round (255 * 16 = -16)
function CellX(u8 Cc, u8 Rr) as u8
  return 76 + Cc * 16 - Rr * 8

sub DrawCell(u8 Cc, u8 Rr):
  u8 B = 0
  u8 Lf = 0
  u8 Me = 0
  u8 Rt = 0
  u8 Kd = 0
  u8 Ty = 0
  u8 H = 0
  B = 9 - Rr + Cc * 2
  Lf = FloorLike(Cc - 1, Rr)
  Me = FloorLike(Cc, Rr)
  Rt = FloorLike(Cc + 1, Rr)
  Kd = Live[Rr * 10 + Cc]
  for H = 0 to 1
    Ty = Rr * 2 + 1 + H
    put char TSh000 + H * 4 + Lf * 2 + Me at B,Ty
    put char TIn00 + H * 3 + Kd at B + 1,Ty
    put char TSh000 + H * 4 + Me * 2 + Rt at B + 2,Ty
  next
  return
end sub

sub DrawGrid:
  for Gr = 0 to 7
    for Gc = 0 to 9
      DrawCell(Gc, Gr)
    next
  next
  return
end sub

' ---------------------------------------------------------------------------
' sprites: nearer figures (lower on the screen) in front

sub DrawFigs:
  u8 Oi = 0
  u8 Oj = 0
  u8 Ot = 0
  u8 Sp = 0
  u8 Pt = 0
  inc Anim
  for Oi = 0 to 4
    Ord[Oi] = Oi
    FigPos(Oi)
    Xs[Oi] = X
    Ys[Oi] = Y
    Dp[Oi] = YDepth(Y)
  next
  ' insertion sort by depth: the largest y first (drawn in front)
  for Oi = 1 to 4
    Oj = Oi
    while Oj > 0
      Ot = Ord[Oj - 1]
      Pt = Ord[Oj]
      if Dp[Ot] >= Dp[Pt] then exit while
      Ord[Oj - 1] = Pt
      Ord[Oj] = Ot
      dec Oj
    end while
  next
  for Oi = 0 to 4
    Ot = Ord[Oi]
    Sp = Oi * 2
    if Ys[Ot] = 208 then
      set sprite Sp to 192,0,0,0
      set sprite Sp + 1 to 192,0,0,0
    else
      Pt = (Ot * 4 + Figs[Ot].Dir) * 8 + SprFig
      set sprite Sp to Ys[Ot],Xs[Ot],Pt + 4,ColB[Ot]
      set sprite Sp + 1 to Ys[Ot],Xs[Ot],Pt,ColA[Ot]
    end if
  next
  if SparkT > 0 then
    dec SparkT
    set sprite 11 to SparkY,SparkX,SSpark,11
  else
    set sprite 11 to 192,0,0,0
  end if
  update sprites
  return
end sub

' a sprite y (243 above the top means negative) as a depth to sort by
function YDepth(u8 Yv) as u8
  if Yv >= 224 then return 0
  return Yv + 16

' X, Y of a figure's sprites; Y = 208 when hidden
sub FigPos(u8 F):
  u8 Tt = 0
  u8 Of = 0
  u8 Ofh = 0
  u8 D = 0
  if Figs[F].Here = 0 then
    Y = 208
    return
  end if
  if Figs[F].St = FOut then
    Y = 208
    return
  end if
  X = BaseX[F]
  Y = BaseY[F]
  if Figs[F].Mov = 1 then
    Tt = Figs[F].T
    Of = Tt >> 4
    Ofh = Tt >> 5
    D = Figs[F].Dir
    select case D
      case 0
        X = X + Ofh
        Y = Y - Of
      case 1
        X = X + Of
      case 2
        X = X - Ofh
        Y = Y + Of
      case 3
        X = X - Of
    end select
    if F = 4 then
      Y = Y - HopT[Of]
    else
      Of = Tt >> 6
      Y = Y - (Of & 1)
    end if
  end if
  if Figs[F].St = FFall then Y = Y + Figs[F].Fall
  return
end sub

sub SetBase(u8 F):
  u8 Rb = 0
  Rb = Figs[F].Row
  BaseX[F] = CellX(Figs[F].Col, Rb)
  BaseY[F] = Rb * 16 + 3
  return
end sub

' ---------------------------------------------------------------------------
' the workspace: grid, panel, menu

sub DrawWork:
  NewScreen
  DrawGrid
  DrawPanel
  DrawFigs
  ShowScreen
  return
end sub

sub DrawPanel:
  fill 32 count 28 at 2,17
  ShowTitleLine
  ShowFig
  ShowInfo
  print at 13,19, "ACTION"
  print at 13,20, "TEST"
  print at 13,21, "MANUAL"
  print at 22,19, "EDITOR"
  if Mode = 1 then
    print at 22,20, "GOAL"
  else
    print at 22,20, "DESIGN"
  end if
  print at 22,21, "QUIT"
  ShowHint
  ShowMenu
  return
end sub

sub ShowHint:
  fill 32 count 18 at 12,22
  print at 12,22, "L/R FIG  U/D MENU"
  return
end sub

sub ShowTitleLine:
  fill 32 count 28 at 2,17
  if Mode = 1 then
    print at 2,17, "TEST"
    NumU = Pz + 1
    print at 7,17, digits$(NumU, 1)
    for Li = 0 to 17
      W16 = Pz * 18 + Li
      C = PzName[W16]
      put char C at Li + 10,17
    next
  else
    print at 2,17, "TOYBOX  -  CREATE YOUR OWN"
  end if
  return
end sub

sub ShowFig:
  fill 32 count 9 at 2,18
  put char 60 at 2,18
  PrintName(Sel, 3, 18)
  put char 62 at 10,18
  K = (Sel * 4 + 2) * 8 + SprFig
  set sprite 12 to 150,28,K + 4,ColB[Sel]
  set sprite 13 to 150,28,K,ColA[Sel]
  ShowLines
  return
end sub

sub ShowLines:
  print at 2,21, "LINES"
  NumU = ProgLen(Sel)
  print at 8,21, digits$(NumU, 2)
  fill 32 count 9 at 2,22
  if Mode = 1 then
    print at 2,22, "LIMIT"
    NumU = Limit
    print at 8,22, digits$(NumU, 2)
  end if
  return
end sub

sub ShowInfo:
  if Mode = 0 then return
  fill 32 count 18 at 12,18
  print at 12,18, "STARS"
  NumU = Stars
  print at 18,18, digits$(NumU, 2)
  if Mode = 1 then
    print at 22,18, "RUNS"
    NumU = Runs
    print at 27,18, digits$(NumU, 2)
  end if
  return
end sub

sub ShowMenu:
  put char 32 at 12,19
  put char 32 at 12,20
  put char 32 at 12,21
  put char 32 at 21,19
  put char 32 at 21,20
  put char 32 at 21,21
  if MenuI < 3 then
    put char 62 at 12,MenuI + 19
  else
    put char 62 at 21,MenuI + 16
  end if
  return
end sub

sub PrintName(u8 F, u8 Px, u8 Py):
  select case F
    case 0
      print at Px,Py, "ROBOT  "
    case 1
      print at Px,Py, "MOBOT  "
    case 2
      print at Px,Py, "DROID  "
    case 3
      print at Px,Py, "ACROBOT"
    case else
      print at Px,Py, "RABBIT "
  end select
  return
end sub

function ProgLen(u8 F) as u8
  u8 Pn = 0
  u8 Pb = 0
  Pb = F * 16
  while Pn < NL
    if Prog[Pb + Pn] = 255 then return Pn
    inc Pn
  end while
  return NL

' next figure on the grid to the left (-1) or right (+1)
function NextFig(u8 From, u8 Dl) as u8
  u8 Nx = 0
  u8 Tries = 0
  Nx = From
  for Tries = 1 to 5
    Nx = Nx + Dl
    if Nx = 255 then Nx = 4
    if Nx >= 5 then Nx = 0
    if Figs[Nx].Here = 1 then return Nx
    if Mode = 2 then return Nx
  next
  return From

sub WorkInput:
  V = Edge & 4
  if V > 0 then
    Sel = NextFig(Sel, 255)
    play sound SndClick
    ShowFig
  end if
  V = Edge & 8
  if V > 0 then
    Sel = NextFig(Sel, 1)
    play sound SndClick
    ShowFig
  end if
  V = Edge & 1
  if V > 0 then
    if MenuI = 0 then
      MenuI = 5
    else
      dec MenuI
    end if
    play sound SndClick
    ShowMenu
  end if
  V = Edge & 2
  if V > 0 then
    inc MenuI
    if MenuI > 5 then MenuI = 0
    play sound SndClick
    ShowMenu
  end if
  if Press = 0 then return
  select case MenuI
    case 0
      DoRun(StartMask)
    case 1
      if Figs[Sel].Here = 1 then
        DoRun(1 << Sel)
      else
        play sound SndNo
      end if
    case 2
      if Figs[Sel].Here = 1 then
        Manual = Sel
        DoRun(1 << Sel)
        Manual = 255
      else
        play sound SndNo
      end if
    case 3
      EditorPage
      DrawWork
    case 4
      if Mode = 1 then
        ShowGoal
      else
        DoDesign
      end if
    case 5
      Quit = 1
  end select
  return
end sub

' a message on the title line until a press
sub WaitMsg:
  Wt = 8
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  do
    Frame1
    ReadPad
    DrawFigs
  loop until Press = 1
  ShowTitleLine
  return
end sub

sub ShowGoal:
  fill 32 count 28 at 2,17
  print at 2,17, "GET EVERY STAR. LINES"
  NumU = Limit
  print at 24,17, digits$(NumU, 2)
  WaitMsg
  return
end sub

' ---------------------------------------------------------------------------
' a run: ACTION, TEST or MANUAL

sub DoRun(u8 Mask):
  u8 Rf = 0
  ResetFigs
  for Rf = 0 to 4
    V = Mask >> Rf
    V = V & 1
    if V = 1 then
      if Figs[Rf].Here = 1 then Figs[Rf].St = FRun
    end if
  next
  fill 32 count 28 at 2,17
  if Manual < 255 then
    print at 2,17, "UP STEPS, L/R TURN, BUTTON"
  else
    print at 2,17, "RUNNING  -  BUTTON STOPS"
    if Mode = 1 then
      inc Runs
      inc TotRuns
    end if
  end if
  ShowInfo
  play sound SndGo
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  Result = 0
  Wt = 7
  while Result = 0
    Frame1
    ReadPad
    RunFrame
    DrawFigs
    if Mode = 1 then
      if Manual = 255 then
        if Stars = 0 then Result = 1
      end if
    end if
    if Result = 0 then
      if Active = 0 then Result = 2
      if Press = 1 then Result = 3
    end if
  end while
  fill 32 count 28 at 2,17
  if Result = 1 then
    play sound SndSolved
    print at 2,17, "SOLVED IN"
    NumU = Runs
    print at 12,17, digits$(NumU, 2)
    print at 15,17, "RUNS!"
    WaitMsgKeep
    inc Passed
    inc Pz
    if Pz >= PzCount then
      Quit = 2
      return
    end if
    LoadPuzzle
    DrawWork
    return
  end if
  if Result = 2 then
    play sound SndOver
    if Mode = 1 then
      print at 2,17, "STARS LEFT. TRY AGAIN!"
    else
      print at 2,17, "ALL STOPPED."
    end if
  else
    print at 2,17, "STOPPED."
  end if
  WaitMsg
  ResetFigs
  ShowInfo
  return
end sub

sub WaitMsgKeep:
  Wt = 8
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  do
    Frame1
    ReadPad
    DrawFigs
  loop until Press = 1
  return
end sub

' ---------------------------------------------------------------------------
' DESIGN (toybox): the original's TOYBOX and GRID with one stamper

function FigAt(u8 Cc, u8 Rr) as u8
  u8 Fa = 0
  for Fa = 0 to 4
    if Figs[Fa].Here = 1 then
      if Figs[Fa].SCol = Cc then
        if Figs[Fa].SRow = Rr then return Fa
      end if
    end if
  next
  return 255

sub DoDesign:
  u8 Fd = 0
  u8 Ix = 0
  ResetFigs
  fill 32 count 28 at 2,17
  print at 2,17, "LEFT STAMPS, RIGHT PUTS"
  fill 32 count 18 at 12,22
  print at 12,22, "DOWN OFF = DONE"
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  Wt = 6
  do
    Frame1
    ReadPad
    V = Edge & 1
    if V > 0 then
      if CurR > 0 then dec CurR
    end if
    V = Edge & 2
    if V > 0 then
      if CurR >= 7 then exit do
      inc CurR
    end if
    V = Edge & 4
    if V > 0 then
      if CurC > 0 then dec CurC
    end if
    V = Edge & 8
    if V > 0 then
      if CurC < 9 then inc CurC
    end if
    Ix = CurR * 10 + CurC
    if Press1 = 1 then
      Fd = FigAt(CurC, CurR)
      if Fd < 255 then
        Figs[Fd].SDir = (Figs[Fd].SDir + 1) & 3
        Figs[Fd].Dir = Figs[Fd].SDir
        play sound SndTurn
      else
        V = Design[Ix] + 1
        if V > 2 then V = 0
        Design[Ix] = V
        Live[Ix] = V
        DrawCell(CurC, CurR)
        if CurC > 0 then DrawCell(CurC - 1, CurR)
        if CurC < 9 then DrawCell(CurC + 1, CurR)
        Stars = CountStars
        ShowInfo
        play sound SndStamp
      end if
    end if
    if Press2 = 1 then
      Fd = FigAt(CurC, CurR)
      if Fd = Sel then
        Figs[Sel].Here = 0
        play sound SndThud
      elseif Fd < 255 then
        play sound SndNo
      elseif Design[Ix] = 1 then
        play sound SndNo
      else
        Figs[Sel].Here = 1
        Figs[Sel].SCol = CurC
        Figs[Sel].SRow = CurR
        Figs[Sel].Col = CurC
        Figs[Sel].Row = CurR
        Figs[Sel].Dir = Figs[Sel].SDir
        SetBase(Sel)
        play sound SndStamp
      end if
    end if
    DrawFigs
    X = CellX(CurC, CurR)
    Y = CurR * 16 - 7
    V = Tick & 16
    K = 15
    if V > 0 then K = 11
    set sprite 10 to Y,X,SStamp,K
    update sprites
  loop
  set sprite 10 to 192,0,0,0
  update sprites
  CurR = 7
  ResetFigs
  ShowTitleLine
  ShowHint
  ShowFig
  return
end sub

' ---------------------------------------------------------------------------
' the program editor (a page of its own)

sub EditorPage:
  u8 En = 0
  u8 Eb = 0
  u8 Op = 0
  u8 Cm = 0
  u8 Pa = 0
  u8 Lm = 0
  NewScreen
  print at 2,1, "PROGRAM FOR"
  PrintName(Sel, 14, 1)
  if Mode = 1 then
    print at 2,2, "LIMIT"
    NumU = Limit
    print at 8,2, digits$(NumU, 2)
    print at 11,2, "LINES"
  end if
  print at 2,20, "L/R: CHANGE THE COMMAND"
  print at 2,21, "HOLD LEFT BUTTON: NUMBER"
  print at 2,22, "RIGHT BUTTON: MENU"
  K = (Sel * 4 + 2) * 8 + SprFig
  set sprite 12 to 0,216,K + 4,ColB[Sel]
  set sprite 13 to 0,216,K,ColA[Sel]
  Lm = Limit
  Eb = Sel * 16
  EdLn = 0
  for Li = 0 to Lm - 1
    EdLine(Li)
  next
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  do
    Wt = 4
    Frame1
    ReadPad
    En = ProgLen(Sel)
    V = Edge & 1
    if V > 0 then
      if EdLn > 0 then
        dec EdLn
        play sound SndClick
      end if
    end if
    V = Edge & 2
    if V > 0 then
      if EdLn < En then
        if EdLn < Lm - 1 then
          inc EdLn
          play sound SndClick
        end if
      end if
    end if
    V = Edge & 12
    if V > 0 then
      if EdLn < En then
        Op = Prog[Eb + EdLn]
        Cm = Op & 15
        Pa = Op >> 4
        if B1 > 0 then
          ' the number: GOTO a line within the limit, CALL a figure
          if Cm = 5 then
            Pa = Bump(Pa, V, Lm)
          elseif Cm = 7 then
            Pa = Bump(Pa, V, NF)
          else
            play sound SndNo
          end if
        else
          Cm = Bump(Cm, V, 8)
          if Cm = 5 then
            if Pa >= Lm then Pa = 0
          end if
          if Cm = 7 then
            if Pa >= NF then Pa = 0
          end if
        end if
        Prog[Eb + EdLn] = Cm | (Pa << 4)
        play sound SndEdit
        EdLine(EdLn)
      elseif EdLn < Lm then
        ' on the END line: a new command
        Prog[Eb + EdLn] = 0
        play sound SndEdit
        EdLine(EdLn)
        if EdLn + 1 < Lm then EdLine(EdLn + 1)
      end if
    end if
    if Press2 = 1 then
      EdMenu
      if EdMi = 3 then exit do
    end if
    set sprite 10 to EdLn * 8 + 31,16,SPoint,11
    update sprites
  loop
  set sprite 10 to 192,0,0,0
  update sprites
  return
end sub

' a value moved one up (stick right) or down (stick left), wrapping in 0..Count-1
function Bump(u8 Vb, u8 Dirs, u8 Count) as u8
  u8 Bd = 0
  Bd = Dirs & 8
  if Bd > 0 then
    if Vb + 1 >= Count then return 0
    return Vb + 1
  end if
  if Vb = 0 then return Count - 1
  return Vb - 1

' one line of the listing: its number, its command or END
sub EdLine(u8 Ln):
  u8 Ro = 0
  u8 Lo = 0
  u8 Ec = 0
  u8 Ep = 0
  u8 Len = 0
  Ro = Ln + 4
  fill 32 count 22 at 4,Ro
  NumU = Ln + 1
  print at 4,Ro, digits$(NumU, 2)
  Len = ProgLen(Sel)
  if Ln > Len then return
  if Ln = Len then
    print at 7,Ro, "- END -"
    return
  end if
  Lo = Prog[Sel * 16 + Ln]
  Ec = Lo & 15
  Ep = Lo >> 4
  select case Ec
    case 0
      print at 7,Ro, "ADVANCE 1 STEP"
    case 1
      print at 7,Ro, "ADVANCE 2 STEPS"
    case 2
      print at 7,Ro, "ADVANCE 4 STEPS"
    case 3
      print at 7,Ro, "TURN LEFT"
    case 4
      print at 7,Ro, "TURN RIGHT"
    case 5
      print at 7,Ro, "GOTO LINE"
      NumU = Ep + 1
      print at 17,Ro, digits$(NumU, 2)
    case 6
      print at 7,Ro, "PAUSE"
    case else
      print at 7,Ro, "CALL"
      PrintName(Ep, 12, Ro)
  end select
  return
end sub

sub EdMenu:
  u8 Mb = 0
  u8 Mn = 0
  u8 Ms = 0
  u8 Mlim = 0
  Mb = Sel * 16
  Mlim = Limit
  for Ei = 0 to 3
    fill 32 count 8 at 21,Ei + 4
  next
  print at 22,4, "INSERT"
  print at 22,5, "DELETE"
  print at 22,6, "CLEAR"
  print at 22,7, "DONE"
  EdMi = 0
  Wt = 5
  do
    put char 32 at 21,4
    put char 32 at 21,5
    put char 32 at 21,6
    put char 32 at 21,7
    put char 62 at 21,EdMi + 4
    Frame1
    ReadPad
    V = Edge & 1
    if V > 0 then
      if EdMi > 0 then dec EdMi
      play sound SndClick
    end if
    V = Edge & 2
    if V > 0 then
      if EdMi < 3 then inc EdMi
      play sound SndClick
    end if
    if Press2 = 1 then
      EdMi = 255
      exit do
    end if
    if Press1 = 1 then exit do
  loop
  for Ei = 0 to 3
    fill 32 count 8 at 21,Ei + 4
  next
  if EdMi = 255 then return
  Mn = ProgLen(Sel)
  select case EdMi
    case 0
      if Mn >= Mlim then
        play sound SndNo
        return
      end if
      Ms = Mn
      while Ms > EdLn
        Prog[Mb + Ms] = Prog[Mb + Ms - 1]
        dec Ms
      end while
      Prog[Mb + EdLn] = 0
    case 1
      if EdLn >= Mn then
        play sound SndNo
        return
      end if
      Ms = EdLn
      while Ms < NL - 1
        Prog[Mb + Ms] = Prog[Mb + Ms + 1]
        inc Ms
      end while
      Prog[Mb + NL - 1] = 255
    case 2
      for Ms = 0 to NL - 1
        Prog[Mb + Ms] = 255
      next
      EdLn = 0
    case else
      return
  end select
  play sound SndEdit
  for Ei = 0 to Mlim - 1
    EdLine(Ei)
  next
  return
end sub

' ---------------------------------------------------------------------------
' pages

sub TitlePage:
  Mode = 0
  LoadToy
  NewScreen
  DrawGrid
  for Gi = 0 to 9
    put char TLogo00 + Gi at Gi + 11,17
    put char TLogo10 + Gi at Gi + 11,18
  next
  print at 13,19, "TESTS"
  print at 13,20, "TOYBOX"
  print at 13,21, "CREDITS"
  print at 8,22, "AHOY! APRIL 1986"
  MenuI = 0
  TitleMenu
  DrawFigs
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  ' the toybox demo runs behind the title, again whenever all stop
  DoStart
  Wt = 2
  do
    Frame1
    ReadPad
    RunFrame
    DrawFigs
    if Active = 0 then
      ResetFigs
      DoStart
    end if
    V = Edge & 1
    if V > 0 then
      if MenuI > 0 then dec MenuI
      TitleMenu
    end if
    V = Edge & 2
    if V > 0 then
      if MenuI < 2 then inc MenuI
      TitleMenu
    end if
  loop until Press = 1
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub DoStart:
  for Gi = 0 to 4
    if Figs[Gi].Here = 1 then Figs[Gi].St = FRun
  next
  return
end sub

sub TitleMenu:
  put char 32 at 12,19
  put char 32 at 12,20
  put char 32 at 12,21
  put char 62 at 12,MenuI + 19
  return
end sub

sub CreditsPage:
  NewScreen
  print at 9,1, "A C T I O N A U T S"
  print at 2,3, "BASED ON ACTIONAUTS BY"
  print at 2,4, "ROB FULOP (PROGRAM DESIGN)"
  print at 2,5, "AND LON RICHTER (GRAPHICS"
  print at 2,6, "AND ANIMATION), ADVANCED"
  print at 2,7, "PROGRAM TECHNOLOGY 1985,"
  print at 2,8, "AHOY! APRIL 1986 (C64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: LITTLE MACHINES"
  print at 2,17, "(ORIGINAL)"
  print at 7,22, "PRESS THE BUTTON"
  for Gi = 0 to 4
    K = (Gi * 4 + 2) * 8 + SprFig
    X = Gi * 32 + 56
    Y = Band[Gi] + 116
    set sprite Gi * 2 to Y,X,K + 4,ColB[Gi]
    set sprite Gi * 2 + 1 to Y,X,K,ColA[Gi]
  next
  update sprites
  ShowScreen
  WaitPress(1)
  HideSprites
  return
end sub

sub WaitPress(u8 Wv):
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 16
  Wt = Wv
  do
    Frame1
    ReadPad
  loop until Press = 1
  return
end sub

sub EndPage:
  NewScreen
  NumU = Passed
  if Passed >= PzCount then
    print at 6,5, "ALL EIGHT TESTS PASSED!"
    print at 6,8, "RUNS IN ALL:"
    NumU = TotRuns
    print at 19,8, digits$(NumU, 3)
    print at 6,11, "THE ACTIONAUTS SALUTE"
    print at 6,12, "A MASTER PROGRAMMER."
  else
    print at 6,5, "TESTS PASSED:"
    print at 20,5, digits$(NumU, 1)
    print at 22,5, "OF 8"
    print at 6,8, "RUNS IN ALL:"
    NumU = TotRuns
    print at 19,8, digits$(NumU, 3)
    print at 6,11, "COME BACK AND FINISH"
    print at 6,12, "THE TESTS SOON!"
  end if
  for Gi = 0 to 4
    K = (Gi * 4 + 2) * 8 + SprFig
    X = Gi * 32 + 56
    Y = Band[Gi] + 112
    set sprite Gi * 2 to Y,X,K + 4,ColB[Gi]
    set sprite Gi * 2 + 1 to Y,X,K,ColA[Gi]
  next
  update sprites
  ShowScreen
  play sound SndSolved
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' the stick with auto-repeat (Edge: first push, then every 6 frames after
' 18), the two buttons and their presses
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  Pad = J1 | J2
  Stick = Pad & 15
  Edge = 0
  if Stick <> LastStick then
    Edge = Stick
    RepT = 18
  elseif Stick <> 0 then
    dec RepT
    if RepT = 0 then
      Edge = Stick
      RepT = 6
    end if
  end if
  LastStick = Stick
  B1 = Pad & 16
  B2 = Pad & 32
  Press1 = 0
  Press2 = 0
  if B1 > 0 then
    if WasB1 = 0 then Press1 = 1
  end if
  if B2 > 0 then
    if WasB2 = 0 then Press2 = 1
  end if
  WasB1 = B1
  WasB2 = B2
  Press = Press1 | Press2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for Gi = 0 to NSpr - 1
    set sprite Gi to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

