project "Amy Word Table Test"
memory "colecovision_legacy_sdcc"

' Indexable ROM word table: pick a ROM block by runtime index,
' the Amy equivalent of C's `const byte* frames[]`.
data FrameA bytes $41,$42,$43,$44
data FrameB bytes $45,$46,$47,$48
data FrameC bytes $49,$4A,$4B,$4C

data Frames words
  @FrameA, @FrameB, @FrameC
end data

u8 I = 0

text screen
print at 7,6, "WORD TABLE FRAMES"
' Constant index folds to the FrameA label directly.
put Frames[0] frame size 2,2 at 8,10
screen on

main_loop:
wait 30 frames
I += 1
if I == 3 then
  I = 0
end if
' Variable index walks the dw table at runtime.
put Frames[I] frame size 2,2 at 15,10
goto main_loop