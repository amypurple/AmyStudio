' ---------------------------------------------------------------------------
' main flow
' ---------------------------------------------------------------------------
  tile screen
  call asm ZShare
  set sound table MbSoundTable areas 4
  sprites 16x16
  nmi off
  HideSprites
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    CreditsPage
    goto title
  end if
  StoryPage
  SetSpecies
  Score = 0
  Lives = 3
  NextLife = 3000
  Stage = DbgStage
  StDone = 0

stage_start:
  StageCard
  LoadStage
  Wave = DbgWave
  WasStick = 0

play_loop:
  Frame1
  DrawAll
  ReadPad
  MusicTick
  UpdatePlayer
  UpdateEnemies
  UpdateProj
  UpdateItem
  UpdateWave
  if DbgAuto > 0 then
    ScrollWorld(DbgAuto)
    Dist = 0
  end if
  if DbgBusy > 0 then
    call asm Busy with b = DbgBusy
  end if
  if HudDirty = 1 then DrawHud
  if PDead = 2 then goto game_over
  if StDone = 1 then goto stage_end
  goto play_loop

stage_end:
  StDone = 0
  inc Stage
  if Stage >= NStages then
    EndingPage
    goto title
  end if
  goto stage_start

game_over:
  GameOverPage
  goto title

' ---------------------------------------------------------------------------
' system helpers
' ---------------------------------------------------------------------------
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one frame: the NMI runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn1 = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn1 = 1
  if joypad(2).button1 then Btn1 = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press1 = 0
  Press2 = 0
  if Btn1 = 1 then
    if Was1 = 0 then Press1 = 1
  end if
  if Btn2 = 1 then
    if Was2 = 0 then Press2 = 1
  end if
  Was1 = Btn1
  Was2 = Btn2
  Press = Press1 | Press2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' every new screen starts here: wait, NMI off, display off, tiles, cls
sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' wait n frames (NMI protected)
sub Pause(u16 Frames):
  Rearm
  wait Frames frames
  nmi off
  return
end sub

' wait for a fresh button press (either button)
sub WaitPress:
  Rearm
  wait no fire
  nmi off
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

' Tiny Sound has no loop: play it again when it ends
sub StartMusic(u8 Which):
  if DbgNoMus = 1 then return
  mute all
  MusOn = Which
  MusT = 0
  MusLen = 0
  select case Which
    case 1
      play sound SndTitleA
      play sound SndTitleB
      MusLen = 256
    case 2
      play sound SndS1A
      play sound SndS1B
      MusLen = 192
    case 3
      play sound SndS2A
      play sound SndS2B
      MusLen = 192
    case 4
      play sound SndS3A
      play sound SndS3B
      MusLen = 160
    case 5
      play sound SndBossA
      play sound SndBossB
      MusLen = 160
    case 6
      play sound SndEndA
      play sound SndEndB
      MusLen = 256
  end select
  return
end sub

sub StopMusic:
  MusOn = 0
  mute all
  return
end sub

' called once a frame
sub MusicTick:
  if MusOn = 0 then return
  inc MusT
  if MusT >= MusLen then StartMusic(MusOn)
  return
end sub

' ---------------------------------------------------------------------------
' screens: credits, title, story, stage card, game over, ending
' ---------------------------------------------------------------------------
sub CreditsPage:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $10
  backdrop white
  cls
  print centered at 2, "MUTANT BREAKOUT"
  print at 3,5, "A BEAT 'EM UP FOR THE"
  print at 3,6, "COLECOVISION, WRITTEN IN"
  print at 3,7, "AMY. THREE MUTANTS, THREE"
  print at 3,8, "STAGES, THREE BOSSES."
  print at 3,10, "GAME: FUNKNFLOW5200"
  print at 3,11, "BUILT WITH AMY TOOLBOX"
  print at 3,12, "(ANTHROPIC), 2026."
  print at 3,14, "INSPIRED BY THE ARCADE"
  print at 3,15, "BEAT 'EM UPS OF THE LATE"
  print at 3,16, "80S. THE FLOOR AND WALL"
  print at 3,17, "SCROLL BY ROTATING TILE"
  print at 3,18, "PATTERNS EVERY FRAME."
  print centered at 21, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  return
end sub

' the three mutants on the title screen (sprites 0-5)
sub TitleSprites:
  u8 K = 0
  u8 Base = 0
  u8 C1 = 0
  u8 C2 = 0
  u8 SX = 0
  u8 SY = 0
  for K = 0 to 2
    Base = K * 80
    C1 = 14
    C2 = 14
    SY = 69
    if K = Spec then
      C1 = TCol1[K]
      C2 = TCol2[K]
      if (Mix & 16) <> 0 then Base += 8
      if (Mix & 8) <> 0 then SY = 68
    end if
    SX = K * 64
    SX += 48
    J = K * 2
    set sprite J to SY,SX,Base,C1
    J += 1
    Base += 4
    if K = Spec then
      set sprite J to SY,SX,Base,C2
    else
      set sprite J to 192,0,0,0
    end if
  next
  return
end sub

sub TitleStats:
  u8 Q = 0
  fill 32 count 5 at 15,16
  fill 32 count 5 at 15,17
  fill 32 count 5 at 15,18
  Q = TSpd[Spec]
  fill 42 count Q at 15,16
  Q = TPow[Spec]
  fill 42 count Q at 15,17
  Q = TLifeStar[Spec]
  fill 42 count Q at 15,18
  return
end sub

sub TitlePage:
  u8 Mv = 0
  u8 Old = 0
  u8 Redraw = 1
  NewScreen
  copy Spr_scales count SpeciesBytes to vram.spr_pat
  copy Spr_tusk count SpeciesBytes to vram.spr_pat + 640
  copy Spr_flutter count SpeciesBytes to vram.spr_pat + 1280
  fill TBar count 28 at 2,7
  fill TBar count 28 at 2,12
  print centered at 3, "M U T A N T"
  print centered at 5, "B R E A K O U T"
  print at 4,13, "SCALES"
  print at 13,13, "TUSK"
  print at 20,13, "FLUTTER"
  print at 8,16, "SPEED"
  print at 8,17, "POWER"
  print at 8,18, "LIFE"
  print at 14,20, "START"
  print at 14,21, "CREDITS"
  print at 3,23, "STICK: PICK  BUTTON: GO"
  Menu = 0
  StartMusic(1)
  ShowScreen
  WaitNoBtn
title_loop:
  Frame1
  TitleSprites
  update sprites
  MusicTick
  ReadPad
  Mv = 0
  if Lf1 = 1 then Mv = 1
  if Rt1 = 1 then Mv = 2
  if Up1 = 1 then Mv = 3
  if Dn1 = 1 then Mv = 4
  if Mv <> 0 then
    if WasStick = 0 then
      if Mv = 1 then
        if Spec > 0 then dec Spec
        Redraw = 1
        play sound SndSelect
      end if
      if Mv = 2 then
        if Spec < 2 then inc Spec
        Redraw = 1
        play sound SndSelect
      end if
      if Mv = 3 then
        Menu = 0
        Redraw = 1
        play sound SndSelect
      end if
      if Mv = 4 then
        Menu = 1
        Redraw = 1
        play sound SndSelect
      end if
    end if
  end if
  WasStick = Mv
  if Redraw = 1 then
    Redraw = 0
    TitleStats
    put char 32 at 12,20
    put char 32 at 12,21
    if Menu = 0 then put char 62 at 12,20
    if Menu = 1 then put char 62 at 12,21
    fill 32 count 28 at 2,14
    Old = Spec
  end if
  if Press1 = 1 then goto title_done
  if Press2 = 1 then goto title_done
  goto title_loop
title_done:
  StopMusic
  return
end sub

sub WaitNoBtn:
  Rearm
  wait no fire
  nmi off
  Was1 = 1
  Was2 = 1
  return
end sub

sub StoryPage:
  NewScreen
  print centered at 4, "FACILITY 7. MIDNIGHT."
  print centered at 7, "THE LAB HAS SPLICED"
  print centered at 8, "ANIMALS INTO SOMETHING"
  print centered at 9, "NEW. THE CELL DOORS"
  print centered at 10, "JUST CLICKED OPEN."
  print centered at 13, "FIGHT THROUGH THE"
  print centered at 14, "CELL BLOCK, THE SEWERS"
  print centered at 15, "AND THE PERIMETER."
  print centered at 18, "BREAK OUT!"
  ShowScreen
  WaitPress
  return
end sub

sub StageCard:
  u8 SN = 0
  NewScreen
  SN = Stage + 1
  print centered at 8, "STAGE"
  print SN at 21,8 digits 1
  select case Stage
    case 0
      print centered at 11, "CELL BLOCK"
    case 1
      print centered at 11, "THE SEWERS"
    case 2
      print centered at 11, "THE PERIMETER"
  end select
  print centered at 15, "GET READY"
  ShowScreen
  Pause(110)
  return
end sub

sub GameOverPage:
  StopMusic
  play sound SndOver
  print centered at 9, "GAME OVER"
  print at 9,12, "SCORE"
  print Score at 15,12 digits 5
  Pause(200)
  return
end sub

sub EndingPage:
  NewScreen
  StartMusic(6)
  print centered at 4, "FREEDOM"
  print centered at 8, "THE FENCE FALLS AND THE"
  print centered at 9, "NIGHT AIR SMELLS OF RAIN."
  print centered at 10, "NO MORE CAGES."
  print centered at 14, "FINAL SCORE"
  print Score at 14,16 digits 5
  print centered at 20, "THE END"
  ShowScreen
  Pause(400)
  WaitPress
  StopMusic
  return
end sub

' ---------------------------------------------------------------------------
' tables
' ---------------------------------------------------------------------------
data TCol1 bytes
  3,9,13
end data
data TCol2 bytes
  11,15,15
end data
data TSpd bytes
  3,2,5
end data
data TPow bytes
  3,5,2
end data
data TLifeStar bytes
  4,5,3
end data
' quarter pixels per frame
data TSpSpeed bytes
  6,4,8
end data
data TSpDmg bytes
  1,2,1
end data
data TSpHp bytes
  8,10,6
end data
data TSpJump bytes
  5,4,6
end data
data TSpAtk bytes
  14,19,11
end data
data TSpReach bytes
  24,26,22
end data
' enemy types 1-3
data TyHpT bytes
  0,4,3,3
end data
data TyPts bytes
  0,10,15,12
end data
data BossHpT bytes
  28,36,44
end data
data NWaves bytes
  4,5,5
end data
' scroll pixels before each wave (stage * 5 + wave)
data WGoal bytes
  70,170,190,190,0
  90,160,180,180,180
  90,160,170,180,190
end data
' spawn lists (type | 16 = from the left), 6 per wave
data Waves bytes
  1,17,0,0,0,0
  1,2,17,0,0,0
  3,19,1,0,0,0
  1,2,17,3,0,0
  0,0,0,0,0,0
  3,19,1,0,0,0
  2,18,1,0,0,0
  1,17,3,19,0,0
  2,1,19,17,0,0
  1,2,3,18,19,0
  1,2,19,0,0,0
  3,19,3,18,0,0
  1,17,2,18,0,0
  2,3,17,19,1,0
  1,18,3,19,2,17
end data

' ---------------------------------------------------------------------------
' stage loading, scrolling and waves
' ---------------------------------------------------------------------------
sub LoadStage:
  NewScreen
  call asm ZShare
  select case Stage
    case 0
      copy StageCol1 count StageColBytes1 to vram.color + StripBaseOff
      FarAddr = address of FarTab1
      NearAddr = address of NearTab1
      StatAddr = address of StatTab1
      NFar = NFar1
      NNear = NNear1
      NStat = NStat1
    case 1
      copy StageCol2 count StageColBytes2 to vram.color + StripBaseOff
      FarAddr = address of FarTab2
      NearAddr = address of NearTab2
      StatAddr = address of StatTab2
      NFar = NFar2
      NNear = NNear2
      NStat = NStat2
    case 2
      copy StageCol3 count StageColBytes3 to vram.color + StripBaseOff
      FarAddr = address of FarTab3
      NearAddr = address of NearTab3
      StatAddr = address of StatTab3
      NFar = NFar3
      NNear = NNear3
      NStat = NStat3
  end select
  ShNear = 0
  ShFar = 0
  FarAcc = 0
  call asm ScrollStrips with hl = FarAddr, b = NFar, c = 0
  call asm ScrollStrips with hl = NearAddr, b = NNear, c = 0
  call asm ScrollStrips with hl = StatAddr, b = NStat, c = 0
  select case Stage
    case 0
      call asm BuildScene with hl = address of Scene1
    case 1
      call asm BuildScene with hl = address of Scene2
    case 2
      call asm BuildScene with hl = address of Scene3
  end select
  select case Spec
    case 0
      copy Spr_scales count SpeciesBytes to vram.spr_pat
    case 1
      copy Spr_tusk count SpeciesBytes to vram.spr_pat
    case 2
      copy Spr_flutter count SpeciesBytes to vram.spr_pat
  end select
  copy Spr_shared count SharedBytes to vram.spr_pat + SharedOff
  select case Stage
    case 0
      copy Spr_boss1 count BossBytes to vram.spr_pat + BossOff
    case 1
      copy Spr_boss2 count BossBytes to vram.spr_pat + BossOff
    case 2
      copy Spr_boss3 count BossBytes to vram.spr_pat + BossOff
  end select
  ' state for a new stage
  PX = 32
  PY = 148
  PZ = 0
  PSt = PsIdle
  PDir = 0
  PInv = 60
  PHp = SpHpMax
  PCombo = 0
  PComboT = 0
  PDead = 0
  Phase = PhScroll
  Wave = 0
  Dist = 0
  Alive = 0
  QLeft = 0
  Token = 0
  BossAct = 0
  GoT = 240
  StT = 0
  ItOn = 0
  SpkT = 0
  for J = 0 to 2
    ESt[J] = EsOff
  next
  for J = 0 to 1
    PjOn[J] = 0
  next
  HudDirty = 1
  DrawHud
  StartMusic(Stage + 2)
  ShowScreen
  return
end sub

' the world moves D pixels left (the player is walking right)
sub ScrollWorld(u8 D):
  ShNear += D
  ShNear &= 31
  FarAcc += D
  if FarAcc >= 2 then
    FarAcc -= 2
    inc ShFar
    ShFar &= 31
    FarFlag = 1
  end if
  NearFlag = 1
  Dist += D
  if ItOn = 1 then
    if ItX > D then
      ItX -= D
    else
      ItOn = 0
    end if
  end if
  return
end sub

sub SpawnNext:
  u8 I = 0
  u8 Idx = 0
  u8 Code = 0
  u8 Ty = 0
  u8 Pick = 0
  Pick = 9
  for I = 0 to 2
    if ESt[I] = EsOff then Pick = I
  next
  if Pick = 9 then return
  Idx = Stage * 5
  Idx += Wave
  Idx *= WaveSz
  Idx += QIdx
  Code = Waves[Idx]
  inc QIdx
  dec QLeft
  Ty = Code & 15
  ETy[Pick] = Ty
  ESt[Pick] = EsWalk
  EHp[Pick] = TyHpT[Ty]
  if Stage > 0 then
    if Ty = TyGrunt then inc EHp[Pick]
  end if
  EY[Pick] = random(LaneTop + 10, LaneBot - 6)
  if (Code & 16) <> 0 then
    EX[Pick] = 4
    EDir[Pick] = 0
  else
    EX[Pick] = 236
    EDir[Pick] = 1
  end if
  ECool[Pick] = 50
  ETm[Pick] = 0
  EFl[Pick] = 0
  EAt[Pick] = 0
  EAn[Pick] = 0
  inc Alive
  QDelay = 45
  return
end sub

sub UpdateWave:
  u8 Idx = 0
  u8 Goal = 0
  u8 MaxAct = 0
  u8 NW = 0
  if GoT > 0 then dec GoT
  if StT > 0 then
    dec StT
    if StT = 0 then fill 32 count 28 at 2,22
  end if
  select case Phase
    case PhScroll
      NW = NWaves[Stage]
      if Wave < NW then
        Idx = Stage * 5
        Idx += Wave
        Goal = WGoal[Idx]
        NumU = Dist
        if NumU >= Goal then
          Phase = PhFight
          Idx *= WaveSz
          QIdx = 0
          QLeft = 0
          for J = 0 to 5
            V = Idx + J
            if Waves[V] <> 0 then inc QLeft
          next
          QDelay = 30
          GoT = 0
        end if
      else
        NumU = Dist
        if NumU >= 150 then
          Phase = PhBoss
          SpawnBoss
        end if
      end if
    case PhFight
      MaxAct = 2
      if Stage > 0 then MaxAct = 3
      if QDelay > 0 then dec QDelay
      if QLeft > 0 then
        if QDelay = 0 then
          if Alive < MaxAct then SpawnNext
        end if
      end if
      if QLeft = 0 then
        if Alive = 0 then
          inc Wave
          Dist = 0
          Phase = PhScroll
          GoT = 240
          play sound SndGo
        end if
      end if
    case PhBoss
      if BossAct = 2 then
        if Alive = 0 then
          Phase = PhClear
          GoT = 240
          Score += 1000
          HudDirty = 1
          play sound SndClear
          StartMusic(Stage + 2)
          print centered at 22, "STAGE CLEAR"
          StT = 150
        end if
      end if
    case PhClear
      if PX >= 230 then StDone = 1
  end select
  return
end sub

' ---------------------------------------------------------------------------
' the player
' ---------------------------------------------------------------------------
sub SetSpecies:
  SpSpeed = TSpSpeed[Spec]
  SpDmg = TSpDmg[Spec]
  SpHpMax = TSpHp[Spec]
  SpJump = TSpJump[Spec]
  SpAtk = TSpAtk[Spec]
  SpReach = TSpReach[Spec]
  SpCol1 = TCol1[Spec]
  SpCol2 = TCol2[Spec]
  return
end sub

' walking: left/right (scrolling the world when allowed) and up/down in the lane
sub MovePlayer:
  u8 Stp = 0
  u8 StpY = 0
  u8 Lim = 0
  u8 Top = 0
  PMoved = 0
  Lim = XMax
  if Phase = PhClear then Lim = 244
  if Lf1 = 1 then PMoved = 1
  if Rt1 = 1 then PMoved = 1
  if Up1 = 1 then PMoved = 1
  if Dn1 = 1 then PMoved = 1
  if PMoved = 0 then
    PMove = 0
    return
  end if
  PMove += SpSpeed
  Stp = PMove / 4
  PMove &= 3
  if Rt1 = 1 then
    if Lf1 = 0 then
      PDir = 0
      if Phase = PhScroll then
        if PX >= ScrollX then
          if Stp > 0 then ScrollWorld(Stp)
        else
          PX += Stp
        end if
      else
        PX += Stp
        if PX > Lim then PX = Lim
      end if
    end if
  end if
  if Lf1 = 1 then
    if Rt1 = 0 then
      PDir = 1
      Top = XMin + Stp
      if PX > Top then
        PX -= Stp
      else
        PX = XMin
      end if
    end if
  end if
  StpY = Stp / 2
  if StpY = 0 then
    if (PAn & 1) = 0 then StpY = 1
  end if
  if Up1 = 1 then
    if Dn1 = 0 then
      Top = LaneTop + StpY
      if PY > Top then
        PY -= StpY
      else
        PY = LaneTop
      end if
    end if
  end if
  if Dn1 = 1 then
    if Up1 = 0 then
      PY += StpY
      if PY > LaneBot then PY = LaneBot
    end if
  end if
  return
end sub

' is enemy I within Reach pixels in front of the player? result in Rch
sub InFront(u8 I, u8 Reach, u8 DyMax):
  i16 D = 0
  i16 Dy = 0
  i16 R = 0
  Rch = 0
  D = EX[I]
  if ETy[I] >= TyBoss then D += 8
  D -= PX
  if PDir = 1 then D = 0 - D
  R = Reach
  if ETy[I] >= TyBoss then R += 8
  if D < -6 then return
  if D > R then return
  Dy = EY[I]
  Dy -= PY
  if Dy < 0 then Dy = 0 - Dy
  R = DyMax
  if Dy > R then return
  Rch = 1
  return
end sub

sub AddScore(u8 Pts):
  NumU = Pts
  NumU *= 10
  Score += NumU
  if Score >= NextLife then
    NextLife += 3000
    if Lives < 9 then inc Lives
    play sound SndPick
  end if
  HudDirty = 1
  return
end sub

sub HitEnemy(u8 I, u8 Dmg, u8 Kn):
  if EHp[I] > Dmg then
    EHp[I] -= Dmg
  else
    EHp[I] = 0
  end if
  EFl[I] = 8
  SpkT = 8
  SpkX = EX[I]
  SpkY = EY[I]
  if ETy[I] >= TyBoss then
    SpkX += 8
    SpkY -= 8
    HudDirty = 1
    if EHp[I] = 0 then
      ESt[I] = EsDie
      ETm[I] = 60
      AddScore(0)
      play sound SndBig
    else
      play sound SndHit
      if Kn = 1 then
        if ESt[I] <> EsStrike then
          ESt[I] = EsHurt
          ETm[I] = 16
          EKb[I] = 0
          if Token = 1 then Token = 0
        end if
      end if
    end if
    return
  end if
  if Token = I + 1 then Token = 0
  EKb[I] = 3
  ETm[I] = 14
  if Kn = 1 then
    EKb[I] = 6
    ETm[I] = 24
  end if
  if PDir = 0 then
    EKbD[I] = 0
  else
    EKbD[I] = 1
  end if
  ESt[I] = EsHurt
  if EHp[I] = 0 then
    ESt[I] = EsDie
    ETm[I] = 26
    N = ETy[I]
    AddScore(TyPts[N])
    play sound SndDie
    if random(100) < 28 then
      ItOn = 1
      ItX = EX[I]
      ItY = EY[I]
      ItT = 700
    end if
  else
    play sound SndHit
  end if
  return
end sub

' all enemies in the strike zone of a ground attack
sub PlayerStrike:
  u8 I = 0
  u8 Hits = 0
  u8 Dmg = 0
  u8 Kn = 0
  u8 Reach = 0
  Dmg = SpDmg
  if PCombo = 3 then
    inc Dmg
    Kn = 1
  end if
  Reach = SpReach - 6
  for I = 0 to 2
    if ESt[I] <> EsOff then
      if ESt[I] < EsDie then
        if PZ < 12 then
          InFront(I, Reach, 10)
          if Rch = 1 then
            HitEnemy(I, Dmg, Kn)
            inc Hits
          end if
        end if
      end if
    end if
  next
  if Hits = 0 then
    play sound SndWhiff
  else
    PHit = 1
  end if
  return
end sub

sub KickStrike:
  u8 I = 0
  u8 Dmg = 0
  u8 Reach = 0
  Dmg = SpDmg + 1
  Reach = SpReach - 4
  for I = 0 to 2
    if ESt[I] <> EsOff then
      if ESt[I] < EsDie then
        if KickHit[I] = 0 then
          InFront(I, Reach, 12)
          if Rch = 1 then
            KickHit[I] = 1
            HitEnemy(I, Dmg, 1)
          end if
        end if
      end if
    end if
  next
  return
end sub

sub HurtPlayer(u8 Dmg, u8 FromX):
  if DbgGod = 1 then return
  if PInv > 0 then return
  if PSt = PsDead then return
  if PHp > Dmg then
    PHp -= Dmg
  else
    PHp = 0
  end if
  HudDirty = 1
  PInv = 80
  PTm = 0
  PKb = 6
  if FromX > PX then
    PKbDir = 1
  else
    PKbDir = 0
  end if
  if PHp = 0 then
    PSt = PsDead
    play sound SndDie
  else
    PSt = PsHurt
    play sound SndHurt
  end if
  return
end sub

sub PlayerLand:
  PZ = 0
  PSt = PsIdle
  PCombo = 0
  play sound SndLand
  return
end sub

sub UpdatePlayer:
  if PInv > 0 then dec PInv
  if PComboT > 0 then dec PComboT
  inc PAn
  select case PSt
    case PsIdle
      MovePlayer
      if Press2 = 1 then
        PSt = PsJump
        PUp = 1
        PVs = SpJump
        play sound SndJump
      else
        if Press1 = 1 then
          PSt = PsAtk
          PTm = 0
          PHit = 0
          if PComboT > 0 then
            if PCombo < 3 then
              inc PCombo
            else
              PCombo = 1
            end if
          else
            PCombo = 1
          end if
        end if
      end if
    case PsAtk
      inc PTm
      if PTm = 4 then PlayerStrike
      if PTm >= SpAtk then
        PSt = PsIdle
        if PHit = 1 then
          PComboT = 20
        else
          PCombo = 0
        end if
      end if
    case PsJump
      MovePlayer
      if Press1 = 1 then
        PSt = PsKick
        KickHit[0] = 0
        KickHit[1] = 0
        KickHit[2] = 0
        play sound SndWhiff
      end if
      JumpPhysics
    case PsKick
      MovePlayer
      KickStrike
      JumpPhysics
    case PsHurt
      inc PTm
      if PKb > 0 then
        dec PKb
        if PKbDir = 1 then
          if PX > XMin + 2 then PX -= 2
        else
          if PX < XMax - 2 then PX += 2
        end if
      end if
      if PZ > 0 then
        if PZ > 3 then
          PZ -= 3
        else
          PZ = 0
        end if
      end if
      if PTm >= 18 then
        if PZ = 0 then PSt = PsIdle
      end if
    case PsDead
      inc PTm
      if PZ > 0 then
        if PZ > 3 then
          PZ -= 3
        else
          PZ = 0
        end if
      end if
      if PTm = 80 then
        if Lives > 1 then
          dec Lives
          PHp = SpHpMax
          PSt = PsIdle
          PInv = 150
          HudDirty = 1
        else
          PDead = 2
        end if
      end if
  end select
  return
end sub

sub JumpPhysics:
  if PUp = 1 then
    PZ += PVs
    if (PAn & 1) = 0 then
      dec PVs
      if PVs = 0 then
        PUp = 0
        PVs = 1
      end if
    end if
  else
    if PZ <= PVs then
      PlayerLand
    else
      PZ -= PVs
      if (PAn & 1) = 0 then
        if PVs < 6 then inc PVs
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' enemies and projectiles
' ---------------------------------------------------------------------------
sub FacePlayer(u8 I):
  if PX < EX[I] then
    EDir[I] = 1
  else
    EDir[I] = 0
  end if
  return
end sub

sub FireDart(u8 I):
  u8 K = 0
  u8 Pick = 9
  for K = 0 to 1
    if PjOn[K] = 0 then Pick = K
  next
  if Pick = 9 then return
  PjOn[Pick] = 1
  PjK[Pick] = 1
  PjY[Pick] = EY[I]
  PjD[Pick] = EDir[I]
  if EDir[I] = 0 then
    PjX[Pick] = EX[I] + 14
  else
    PjX[Pick] = EX[I]
  end if
  play sound SndDart
  return
end sub

sub UpdateEnemy(u8 I):
  u8 Ty = 0
  u8 Ad = 0
  u8 Ady = 0
  u8 Spd = 0
  u8 Rng = 0
  u8 Tgt = 0
  u8 Wnd = 0
  u8 Moved = 0
  if ESt[I] = EsOff then return
  Ty = ETy[I]
  if EFl[I] > 0 then dec EFl[I]
  inc EAn[I]
  Ad = absdiff(EX[I], PX)
  Ady = absdiff(EY[I], PY)
  select case ESt[I]
    case EsWalk
      FacePlayer(I)
      if ECool[I] > 0 then dec ECool[I]
      Tgt = PY
      if I = 1 then Tgt -= 7
      if I = 2 then Tgt += 7
      Spd = 1
      Rng = 16
      Wnd = 24
      if Ty = TyHound then
        Spd = 2
        Rng = 38
        Wnd = 16
      end if
      if Ty = TyDarter then
        Rng = 80
        Wnd = 28
      end if
      if Stage > 0 then Wnd -= 4
      if Stage > 1 then Wnd -= 3
      if Ty = TyDarter then
        ' keep a distance: back off when close, close in when far
        if Ad < 56 then
          if EX[I] > PX then
            if EX[I] < 228 then EX[I] += 1
          else
            if EX[I] > 12 then EX[I] -= 1
          end if
        else
          if Ad > 104 then
            if EX[I] > PX then
              EX[I] -= 1
            else
              EX[I] += 1
            end if
          end if
        end if
      else
        if Ad > Rng then
          if EX[I] > PX then
            if EX[I] > Spd then EX[I] -= Spd
          else
            EX[I] += Spd
            if EX[I] > 238 then EX[I] = 238
          end if
        end if
      end if
      if (EAn[I] & 1) = 0 then
        if EY[I] < Tgt then
          if EY[I] < LaneBot then inc EY[I]
        end if
        if EY[I] > Tgt then
          if EY[I] > LaneTop then dec EY[I]
        end if
      end if
      if ECool[I] = 0 then
        if Token = 0 then
          if PSt <> PsDead then
            if Ady <= 8 then
              Moved = 0
              if Ty = TyDarter then
                if Ad >= 48 then
                  if Ad <= 130 then Moved = 1
                end if
              else
                if Ad <= Rng + 4 then Moved = 1
              end if
              if Moved = 1 then
                Token = I + 1
                ESt[I] = EsWind
                ETm[I] = Wnd
              end if
            end if
          end if
        end if
      end if
    case EsWind
      if Ty <> TyHound then FacePlayer(I)
      dec ETm[I]
      if ETm[I] = 0 then
        ESt[I] = EsStrike
        EAt[I] = 0
        ETm[I] = 8
        if Ty = TyDarter then
          FireDart(I)
          ETm[I] = 6
        end if
        if Ty = TyHound then ETm[I] = 14
      end if
    case EsStrike
      if Ty = TyGrunt then
        if EAt[I] = 0 then
          EAt[I] = 1
          if Ad <= 22 then
            if Ady <= 8 then
              if PZ < 10 then HurtPlayer(1, EX[I])
            end if
          end if
        end if
      end if
      if Ty = TyHound then
        if EDir[I] = 0 then
          if EX[I] < 236 then EX[I] += 3
        else
          if EX[I] > 6 then EX[I] -= 3
        end if
        if EAt[I] = 0 then
          if Ad <= 14 then
            if Ady <= 8 then
              if PZ < 8 then
                EAt[I] = 1
                HurtPlayer(1, EX[I])
              end if
            end if
          end if
        end if
      end if
      dec ETm[I]
      if ETm[I] = 0 then
        ESt[I] = EsRecov
        ETm[I] = 22
        if Ty = TyHound then ETm[I] = 30
        if Token = I + 1 then Token = 0
      end if
    case EsRecov
      dec ETm[I]
      if ETm[I] = 0 then
        ESt[I] = EsWalk
        ECool[I] = random(30, 70)
        if Stage > 0 then ECool[I] -= 10
      end if
    case EsHurt
      if EKb[I] > 0 then
        dec EKb[I]
        if EKbD[I] = 0 then
          if EX[I] < 236 then EX[I] += 2
        else
          if EX[I] > 6 then EX[I] -= 2
        end if
      end if
      dec ETm[I]
      if ETm[I] = 0 then
        ESt[I] = EsWalk
        ECool[I] = 20
      end if
    case EsDie
      if EKb[I] > 0 then
        dec EKb[I]
        if EKbD[I] = 0 then
          if EX[I] < 236 then EX[I] += 2
        else
          if EX[I] > 6 then EX[I] -= 2
        end if
      end if
      dec ETm[I]
      if ETm[I] = 0 then
        ESt[I] = EsOff
        if Alive > 0 then dec Alive
        if ETy[I] >= TyBoss then BossAct = 2
      end if
  end select
  return
end sub

sub UpdateEnemies:
  for J = 0 to 2
    if ESt[J] <> EsOff then
      if ETy[J] >= TyBoss then
        UpdateBoss
      else
        UpdateEnemy(J)
      end if
    end if
  next
  return
end sub

sub UpdateProj:
  u8 K = 0
  u8 Ax = 0
  u8 Ay = 0
  for K = 0 to 1
    if PjOn[K] = 1 then
      if PjD[K] = 0 then
        PjX[K] += 3
        if PjK[K] = 2 then PjX[K] -= 1
        if PjX[K] > 244 then PjOn[K] = 0
      else
        if PjK[K] = 2 then PjX[K] += 1
        if PjX[K] < 5 then
          PjOn[K] = 0
        else
          PjX[K] -= 3
        end if
      end if
      if PjOn[K] = 1 then
        Ax = absdiff(PjX[K], PX)
        Ay = absdiff(PjY[K], PY)
        if Ax <= 10 then
          if Ay <= 8 then
            if PZ < 12 then
              HurtPlayer(1, PjX[K])
              PjOn[K] = 0
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub UpdateItem:
  u8 Ax = 0
  u8 Ay = 0
  if ItOn = 0 then return
  if ItT > 0 then dec ItT
  if ItT = 0 then
    ItOn = 0
    return
  end if
  Ax = absdiff(ItX, PX)
  Ay = absdiff(ItY, PY)
  if Ax <= 12 then
    if Ay <= 9 then
      if PZ < 10 then
        ItOn = 0
        PHp += 3
        if PHp > SpHpMax then PHp = SpHpMax
        AddScore(5)
        HudDirty = 1
        play sound SndPick
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' bosses (slot 0). 4 = the Warden (slam, charge), 5 = the Brute (slam,
' slime balls), 6 = the Director (syringe volleys, blinks across the room)
' ---------------------------------------------------------------------------
sub SpawnBoss:
  ETy[0] = TyBoss + Stage
  ESt[0] = EsWalk
  BossMax = BossHpT[Stage]
  EHp[0] = BossMax
  EX[0] = 216
  EY[0] = 148
  EDir[0] = 1
  ECool[0] = 70
  ETm[0] = 0
  EFl[0] = 0
  EAn[0] = 0
  Alive = 1
  BossAct = 1
  BossHide = 0
  QLeft = 0
  HudDirty = 1
  Token = 0
  play sound SndRoar
  StartMusic(5)
  print centered at 22, "WARNING"
  StT = 100
  return
end sub

' a slime ball / syringe from the boss
sub FireOrb(u8 Dy):
  u8 K = 0
  u8 Pick = 9
  for K = 0 to 1
    if PjOn[K] = 0 then Pick = K
  next
  if Pick = 9 then return
  PjOn[Pick] = 1
  PjK[Pick] = 2
  PjY[Pick] = EY[0] + Dy
  PjD[Pick] = EDir[0]
  if EDir[0] = 0 then
    PjX[Pick] = EX[0] + 26
  else
    PjX[Pick] = EX[0]
  end if
  play sound SndDart
  return
end sub

sub UpdateBoss:
  u8 Ad = 0
  u8 Ady = 0
  u8 Cx = 0
  u8 Pcx = 0
  u8 Wnd = 0
  if EFl[0] > 0 then dec EFl[0]
  inc EAn[0]
  Cx = EX[0] + 16
  Pcx = PX + 8
  Ad = absdiff(Cx, Pcx)
  Ady = absdiff(EY[0], PY)
  select case ESt[0]
    case EsWalk
      if PX < EX[0] then
        EDir[0] = 1
      else
        EDir[0] = 0
      end if
      if ECool[0] > 0 then dec ECool[0]
      if (EAn[0] & 1) = 0 then
        if ETy[0] = 6 then
          ' the Director keeps away
          if Ad < 70 then
            if Cx > Pcx then
              if EX[0] < 216 then inc EX[0]
            else
              if EX[0] > 10 then dec EX[0]
            end if
          end if
        else
          if Ad > 26 then
            if Cx > Pcx then
              dec EX[0]
            else
              inc EX[0]
            end if
          end if
        end if
        if EY[0] < PY then
          if EY[0] < LaneBot then inc EY[0]
        end if
        if EY[0] > PY then
          if EY[0] > LaneTop then dec EY[0]
        end if
      end if
      if ECool[0] = 0 then
        if PSt <> PsDead then
          Wnd = 26 - Stage * 3
          select case ETy[0]
            case 4
              if Ad <= 36 then
                BAtk = 1
              else
                BAtk = 2
                Wnd = 20
              end if
            case 5
              if Ad <= 36 then
                BAtk = 1
              else
                BAtk = 3
              end if
            case 6
              if Ad < 44 then
                BAtk = 4
                Wnd = 14
              else
                BAtk = 3
              end if
          end select
          ESt[0] = EsWind
          ETm[0] = Wnd
        end if
      end if
    case EsWind
      if PX < EX[0] then
        EDir[0] = 1
      else
        EDir[0] = 0
      end if
      dec ETm[0]
      if ETm[0] = 0 then
        ESt[0] = EsStrike
        EAt[0] = 0
        ETm[0] = 10
        if BAtk = 2 then ETm[0] = 28
        if BAtk = 3 then
          FireOrb(0)
          if ETy[0] = 6 then
            FireOrb(10)
            ETm[0] = 16
          end if
        end if
        if BAtk = 4 then
          BossHide = 1
          ETm[0] = 28
        end if
      end if
    case EsStrike
      if BAtk = 1 then
        if EAt[0] = 0 then
          EAt[0] = 1
          if Ad <= 38 then
            if Ady <= 14 then
              if PZ < 14 then HurtPlayer(2, Cx)
            end if
          end if
        end if
      end if
      if BAtk = 2 then
        if EDir[0] = 0 then
          if EX[0] < 214 then EX[0] += 3
        else
          if EX[0] > 10 then EX[0] -= 3
        end if
        if EAt[0] = 0 then
          if Ad <= 24 then
            if Ady <= 12 then
              if PZ < 12 then
                EAt[0] = 1
                HurtPlayer(2, Cx)
              end if
            end if
          end if
        end if
      end if
      dec ETm[0]
      if BAtk = 4 then
        if ETm[0] = 14 then
          ' reappear on the other side of the player
          if PX < 120 then
            EX[0] = 206
          else
            EX[0] = 20
          end if
        end if
        if ETm[0] = 0 then BossHide = 0
      end if
      if ETm[0] = 0 then
        ESt[0] = EsRecov
        ETm[0] = 34 - Stage * 4
      end if
    case EsRecov
      dec ETm[0]
      if ETm[0] = 0 then
        ESt[0] = EsWalk
        ECool[0] = random(30, 66)
        if Stage > 0 then ECool[0] -= 10
        if Stage > 1 then ECool[0] -= 10
      end if
    case EsHurt
      dec ETm[0]
      if ETm[0] = 0 then
        ESt[0] = EsWalk
        ECool[0] = 14
      end if
    case EsDie
      BossHide = 0
      dec ETm[0]
      if ETm[0] = 0 then
        ESt[0] = EsOff
        Alive = 0
        BossAct = 2
        HudDirty = 1
      end if
  end select
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprites 0-11, then the scroll rotation (right after the wait)
' sprites: 0 body, 1 accent, 2 shadow, 3-5 enemies (3-6 a boss), 7-8 shots,
' 9 food, 10 spark, 11 GO arrow
' ---------------------------------------------------------------------------
sub DrawPlayer:
  u8 Pose = 0
  u8 Pat = 0
  u8 SY = 0
  u8 C1 = 0
  u8 C2 = 0
  select case PSt
    case PsAtk
      if PTm >= 2 then Pose = 2
      if PTm + 3 >= SpAtk then Pose = 0
    case PsJump
      Pose = 3
    case PsKick
      Pose = 2
    case PsHurt
      Pose = 4
    case PsDead
      Pose = 4
    case else
      if PMoved = 1 then
        if (PAn & 8) <> 0 then Pose = 1
      end if
  end select
  Pat = PDir * 40
  Pat += Pose * 8
  SY = PY - 17
  SY -= PZ
  C1 = SpCol1
  C2 = SpCol2
  if PInv > 0 then
    if (PAn & 2) <> 0 then
      SY = 192
    end if
  end if
  if PSt = PsDead then
    if PTm > 40 then
      if (PTm & 2) <> 0 then SY = 192
    end if
  end if
  set sprite 0 to SY,PX,Pat,C1
  Pat += 4
  set sprite 1 to SY,PX,Pat,C2
  if PZ > 0 then
    SY = PY - 17
    set sprite 2 to SY,PX,SShadow,1
  else
    set sprite 2 to 192,0,0,0
  end if
  return
end sub

sub DrawEnemy(u8 I):
  u8 Pose = 0
  u8 Pat = 0
  u8 SY = 0
  u8 Col = 0
  u8 S = 0
  S = I + 3
  if ESt[I] = EsOff then
    set sprite S to 192,0,0,0
    return
  end if
  Pose = 0
  if ETy[I] = TyHound then
    if (EAn[I] & 4) <> 0 then Pose = 1
    if ESt[I] = EsStrike then Pose = 1
    if ESt[I] = EsWind then Pose = 0
    Pat = EnHound + EDir[I] * 8
    Pat += Pose * 4
    Col = 10
  else
    if (EAn[I] & 8) <> 0 then Pose = 1
    if ESt[I] = EsStrike then Pose = 2
    if ESt[I] = EsWind then
      if ETm[I] < 10 then Pose = 2
    end if
    if ESt[I] = EsHurt then Pose = 0
    if ETy[I] = TyGrunt then
      Pat = EnGrunt
      Col = 5
    else
      Pat = EnDarter
      Col = 15
    end if
    Pat += EDir[I] * 12
    Pat += Pose * 4
  end if
  if EFl[I] > 0 then
    Col = 15
    if ETy[I] = TyDarter then Col = 8
  end if
  SY = EY[I] - 17
  if ESt[I] = EsDie then
    if (EAn[I] & 2) <> 0 then SY = 192
  end if
  set sprite S to SY,EX[I],Pat,Col
  return
end sub

sub DrawBoss:
  u8 Fr = 0
  u8 SY = 0
  u8 SX = 0
  u8 SY2 = 0
  u8 SX2 = 0
  u8 Col = 0
  u8 Pat = 0
  Fr = 0
  if (EAn[0] & 16) <> 0 then Fr = 1
  if ESt[0] = EsWind then Fr = 2
  if ESt[0] = EsStrike then Fr = 2
  Pat = SBoss + Fr * 16
  SY = EY[0] - 33
  SX = EX[0]
  SY2 = SY + 16
  SX2 = SX + 16
  Col = 8
  if ETy[0] = 5 then Col = 12
  if ETy[0] = 6 then Col = 15
  if EFl[0] > 0 then
    Col = 11
    if ETy[0] = 6 then Col = 8
  end if
  if BossHide = 1 then SY = 192
  if BossHide = 1 then SY2 = 192
  if ESt[0] = EsDie then
    if (EAn[0] & 2) <> 0 then
      SY = 192
      SY2 = 192
    end if
  end if
  set sprite 3 to SY,SX,Pat,Col
  Pat += 4
  set sprite 4 to SY,SX2,Pat,Col
  Pat += 4
  set sprite 5 to SY2,SX,Pat,Col
  Pat += 4
  set sprite 6 to SY2,SX2,Pat,Col
  return
end sub

sub DrawMisc:
  u8 K = 0
  u8 SY = 0
  u8 Pat = 0
  u8 Col = 0
  for K = 0 to 1
    J = 7 + K
    if PjOn[K] = 1 then
      SY = PjY[K] - 17
      if PjK[K] = 1 then
        Pat = SDartR
        if PjD[K] = 1 then Pat = SDartL
        set sprite J to SY,PjX[K],Pat,15
      else
        Col = 7
        if Stage = 1 then Col = 12
        SY -= 6
        set sprite J to SY,PjX[K],SOrb,Col
      end if
    else
      set sprite J to 192,0,0,0
    end if
  next
  if ItOn = 1 then
    SY = ItY - 17
    if (Mix & 16) <> 0 then dec SY
    Col = 10
    if ItT < 150 then
      if (Mix & 4) <> 0 then Col = 0
    end if
    set sprite 9 to SY,ItX,SFood,Col
  else
    set sprite 9 to 192,0,0,0
  end if
  if SpkT > 0 then
    dec SpkT
    SY = SpkY - 25
    set sprite 10 to SY,SpkX,SSpark,15
  else
    set sprite 10 to 192,0,0,0
  end if
  set sprite 11 to 192,0,0,0
  if GoT > 0 then
    if (Mix & 16) <> 0 then
      SY = 70
      K = Mix & 7
      K += 216
      set sprite 11 to SY,K,SArrow,11
    end if
  end if
  if Phase = PhClear then
    if (Mix & 16) <> 0 then
      K = Mix & 7
      K += 216
      set sprite 11 to 70,K,SArrow,11
    end if
  end if
  return
end sub

sub DrawAll:
  DrawPlayer
  if BossAct = 1 then
    DrawBoss
  else
    DrawEnemy(0)
    DrawEnemy(1)
    DrawEnemy(2)
    set sprite 6 to 192,0,0,0
  end if
  DrawMisc
  update sprites
  if NearFlag = 1 then
    NearFlag = 0
    call asm ScrollStrips with hl = NearAddr, b = NNear, c = ShNear
  end if
  if FarFlag = 1 then
    if (Tick & 1) = 0 then
      FarFlag = 0
      call asm ScrollStrips with hl = FarAddr, b = NFar, c = ShFar
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' HUD: score, hi score, lives (row 1); health pips and boss bar (row 2)
' ---------------------------------------------------------------------------
sub DrawHud:
  u8 K = 0
  u8 NFill = 0
  HudDirty = 0
  print at 2,1, "SCORE"
  print Score at 8,1 digits 5
  if Score > HiScore then HiScore = Score
  print at 15,1, "HI"
  print HiScore at 18,1 digits 5
  put char TLife at 25,1
  print Lives at 27,1 digits 1
  for K = 0 to 9
    if K < SpHpMax then
      if K < PHp then
        put char THpf at 2 + K,2
      else
        put char THpe at 2 + K,2
      end if
    else
      put char 32 at 2 + K,2
    end if
  next
  if BossAct = 1 then
    NumU = EHp[0]
    NumU *= 14
    NFill = 0
    while NumU > 0
      if NumU >= BossMax then
        NumU -= BossMax
        inc NFill
      else
        NumU = 0
        inc NFill
      end if
    end while
    if NFill > 14 then NFill = 14
    for K = 0 to 13
      if K < NFill then
        put char TBsf at 14 + K,2
      else
        put char TBse at 14 + K,2
      end if
    next
  else
    fill 32 count 14 at 14,2
  end if
  return
end sub

