asm {
; ---------------------------------------------------------------------------
; Smooth horizontal scrolling by rewriting the patterns of "strip" tiles.
; The name table never changes: each screen row is a periodic texture (a
; strip of 1, 2 or 4 tiles that repeats along the row). Shifting the texture
; one pixel left is a bit rotation of the strip's pattern rows. The build
; (stripkit.py) pre-computes every shift, so a frame only copies n*8 bytes
; per strip into the pattern table. All three screen thirds share one
; pattern table (ZShare), so every strip is written once. Each VDP data write
; is spaced by 37 T-states (>= 8 us): safe in the blanking or the display.
;
; Strip record in ROM:
;   db code            ; first tile code
;   db lg              ; log2 of the bytes per shift (3, 4 or 5 = 1, 2 or 4 tiles)
;   db mask            ; shifts - 1 (7, 15, 31), or 0 for a static strip
;   dw stride          ; bytes in the whole record
;   <shifts> blocks of n*8 pattern bytes
; ScrollStrips: HL = table of records, B = count, C = shift in pixels (0-31)
; ---------------------------------------------------------------------------
ScrollStrips:
    ld a,b
    or a
    ret z
    ld (AMY_UVAR_ScCnt),a
    ld a,c
    and $1F
    ld (AMY_UVAR_ScSh),a
ss_next:
    ld e,(hl)               ; tile code
    inc hl
    ld a,(hl)               ; lg
    inc hl
    ld (AMY_UVAR_ScN),a
    ld a,(hl)               ; mask
    inc hl
    ld b,a
    ld a,(AMY_UVAR_ScSh)
    and b
    ld (AMY_UVAR_ScOff),a   ; shift within this strip's period
    ld c,(hl)               ; stride
    inc hl
    ld b,(hl)
    inc hl                  ; HL = first data block
    push hl
    add hl,bc
    ld bc,-5
    add hl,bc
    ld (AMY_UVAR_ScPtr),hl  ; the next record
    pop hl
    ld a,(AMY_UVAR_ScOff)
    ld c,a
    ld b,0
    ld a,(AMY_UVAR_ScN)
    ld d,a
ss_off:
    sla c                   ; offset = shift * 2^lg
    rl b
    dec d
    jr nz,ss_off
    add hl,bc               ; HL = this shift's block
    push hl
    ld l,e                  ; VRAM address = code * 8
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    pop hl
    ld a,(AMY_UVAR_ScN)
    ld b,1
ss_cnt:
    sla b                   ; bytes = 2^lg
    dec a
    jr nz,ss_cnt
ss_wr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz ss_wr
    ld hl,(AMY_UVAR_ScPtr)
    ld a,(AMY_UVAR_ScCnt)
    dec a
    ld (AMY_UVAR_ScCnt),a
    jr nz,ss_next
    ret

; ---------------------------------------------------------------------------
; ZShare: all three screen thirds use the first pattern and colour tables.
; ---------------------------------------------------------------------------
ZShare:
    xor a
    out ($BF),a
    ld a,$84
    out ($BF),a
    ld a,$9F
    out ($BF),a
    ld a,$83
    out ($BF),a
    ret

; ---------------------------------------------------------------------------
; BuildScene: the name table, 24 rows of 32. HL = 19 records (code, n) for
; rows 3-21; every other row is blank (tile 32). The caller has the display
; off and the NMI off.
; ---------------------------------------------------------------------------
BuildScene:
    push hl
    ld a,0
    out ($BF),a
    ld a,$18 | $40
    out ($BF),a
    ; rows 0-2: blank
    ld c,32*3
    ld a,32
bs_top:
    out ($BE),a
    nop
    nop
    dec c
    jr nz,bs_top
    pop hl
    ld b,19
bs_row:
    ld e,(hl)               ; code
    inc hl
    ld a,(hl)               ; n
    inc hl
    dec a                   ; mask 0,1,3
    ld d,a
    ld c,0                  ; column
bs_col:
    ld a,c
    and d
    add a,e
    out ($BE),a
    nop
    nop
    inc c
    ld a,c
    cp 32
    jr nz,bs_col
    djnz bs_row
    ; rows 22-23: blank
    ld c,64
    ld a,32
bs_bot:
    out ($BE),a
    nop
    nop
    dec c
    jr nz,bs_bot
    ret

; debug: burn about 1.2k T-states per unit in B (used to measure CPU headroom)
Busy:
    ld a,b
    or a
    ret z
bz1:
    ld c,76
bz2:
    dec c
    jr nz,bz2
    djnz bz1
    ret
}
