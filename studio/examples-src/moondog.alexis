cartridge "MOONDOG/J.C. HILTY/1987"

' MOONDOG
' A ColecoVision game based on "Moondog" by J.C. Hilty, Ahoy! May 1987
' (Commodore 64, BASIC with machine-language sprite and scroll routines;
' author from the listing's REM "MOONDOG-BY JC HILTY-8/86" and the title
' picture MOONTITLE). Made for Amy Studio by Claude (an AI made by
' Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' listing, orig/moondog.bas), the game is built for the ColecoVision:
' smooth 16 x 16 sprites, a tiled star field and a scrolling lunar plain,
' sound effects and an original title tune.
'
' The game: a laser cannon guards the plain of the moon. Far up in the sky
' the Moondog, an alien craft, wanders inside a box of its own and comes
' closer: a dot, then a small craft, then a big one (with a warning tone),
' and when it arrives it destroys the cannon. Move the cannon left and
' right and fire the laser, a beam up the whole sky in the cannon's
' column; hit the Moondog and score 100 less the time it took, so far-off
' (small) Moondogs are worth the most. Four moons fall across the sky all
' the time: one that lands on the cannon destroys it too. Four ships;
' after a lost ship a new round starts with a new Moondog.
'
' From the original: the playing screen (a frame, score and ships on top,
' coloured rows of plain under the cannon that scroll), the Moondog's box
' (a random top 70-134 and bottom 106-170, right 148-231 and left 64-147
' in C64 sprite coordinates, here moved to the CV screen) and its random
' start directions, bouncing at the box edges, one pixel a frame; its
' timer LP (pictures at 85 and the attack at 100), the score 100 - LP a
' hit, a new Moondog after a hit; the laser as a column of characters in
' the cannon's column, hitting only the Moondog; the four moons with the
' original's speeds (-2/+1, 0/+1, +2/+1, 0/+2 pixels a step) and start
' places; a sprite collision of the cannon ends the ship; 4 ships; the
' siren and the frozen sprites when the cannon is hit; GAME OVER with the
' score and the high score.
'
' Liberties: the original's timer counted BASIC loops (about 15 a second);
' here LP steps every 5 frames (8.3 seconds a Moondog), every 4 frames
' after 8 hits and every 3 after 16, so the game gets harder. The cannon
' moves while the stick is held (1.5 pixels a frame) instead of drifting
' on in its last direction, and stays inside the frame. A laser shot lasts
' 8 frames and recharges in 12 (the C64 drew it again on every loop while
' the button was held, so holding the button and sweeping won). The moons
' bounce off the frame's sides instead of wrapping, and a moon that
' reaches the plain comes back at the top at a random place, growing from
' a dot for its first 16 frames (harmless then); on the C64 they wrapped
' in the same columns, so a still cannon in a safe column was never hit.
' The moons take a step every other frame (the C64 moved them every
' frame: with a human's reaction time a ship lasted about 7 seconds).
' The Moondog has four pictures (dot, small, medium, large) instead of
' three and explodes for 24 frames before the next one comes. The
' original's static sprites 6-7 at the left edge are left out.
'
' Controls: either controller; the stick left and right moves the cannon,
' either button fires. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers. Nothing flashes.

const TSky = 128
const TStar1 = 129
const TStar2 = 130
const TStar3 = 131
const TFrl = 132
const TFrt = 133
const TFrtl = 134
const TFrtr = 135
const TBeam = 136
const TBeamtop = 137
const TGr00 = 138
const TGr01 = 139
const TGr10 = 140
const TGr11 = 141
const TGr20 = 142
const TGr21 = 143
const TGr30 = 144
const TGr31 = 145
const TLg0 = 146
const TLg1 = 147
const TLg2 = 148
const TLg3 = 149
const TLg4 = 150
const TLg5 = 151
const TLg6 = 152
const TLg7 = 153
const TLg8 = 154
const TLg9 = 155
const TLg10 = 156
const TLg11 = 157
const TLg12 = 158
const TLg13 = 159
const TLg14 = 160
const TLg15 = 161
const TLg16 = 162
const TLg17 = 163
const TLg18 = 164
const TLg19 = 165
const TLg20 = 166
const TLg21 = 167
const TLg22 = 168
const TLg23 = 169
const TLg24 = 170
const TLg25 = 171
const TLg26 = 172
const TLg27 = 173
const SCanl = 0
const SCan = 4
const SAle0 = 8
const SAlb0 = 12
const SAle1 = 16
const SAlb1 = 20
const SAle2 = 24
const SAlb2 = 28
const SAle3 = 32
const SAlb3 = 36
const SBoom0 = 40
const SBoom1 = 44
const SMoon0 = 48
const SMoon1 = 52
const SMoon2 = 56
const NTiles8 = 368
const SprBytes = 480
const SndTuneA = 1
const SndTuneB = 2
const SndZap = 3
const SndBoom = 4
const SndGrow = 5
const SndHit = 6
const SndCrash = 7
const SndStart = 8
const SndOver = 9
const NSpr = 8
const PlY = 136
const PwMin = 96
const PwMax = 864
const PSpd = 6
const BeamN = 8
const CoolN = 12
const DeadN = 90
const BoomN = 24
const MoonTop = 24
const MoonBot = 144
const MoonL = 24
const MoonR = 216
const BeamRow = 3
const BeamLow = 16

' the Moondog's half width by picture (dot, small, medium, large)
data AlHw bytes
  2, 3, 5, 7
end data
' the moons: start X, the original's speeds, colours
data MStartX bytes
  40, 80, 176, 160
end data
data MStartY bytes
  24, 64, 44, 84
end data
data MDy bytes
  1, 1, 1, 2
end data
data MDx bytes
  254, 0, 2, 0
end data
data MCol bytes
  14, 11, 10, 15
end data
' frames per LP step by wave (0-2)
data LpRate bytes
  5, 4, 3
end data

record Moon:
  u8 X
  u8 Y
  u8 Age
  u8 Dy
  i8 Dx
end record

Moon Mn[4]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u8 Sh = 4
u8 Over = 0
u8 Kills = 0
u8 LpN = 5
' the cannon: position in quarter pixels, pixel X
u16 Pw = 432
u8 Px = 108
' the Moondog: position, directions (1 or 255), box, timer
u8 Ax = 93
u8 Ay = 70
u8 Adx = 1
u8 Ady = 1
u8 Bt = 24
u8 Bb = 56
u8 Bl = 32
u8 Br = 100
u8 Lp = 0
u8 LpT = 0
u8 BoomT = 0
' the laser: frames left, recharge, column
u8 BeamT = 0
u8 Cool = 0
u8 Bc = 0
' the end of a ship: frames left, why (1 the Moondog, 2 a moon)
u8 DeadT = 0
u8 Why = 0
u8 GPh[4]
' the moons move on every other frame
u8 MPh = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Mi = 0
u8 Ri = 0
u8 Gi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Got = 0

  tile screen
  set sound table MdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  ScrollGround
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  if Sc > Hi then Hi = Sc
  mute all
  HideSprites
  print at 6,8, "                  "
  print at 6,9, "  G A M E  O V E R "
  print at 6,10, "                  "
  print at 6,11, "  SCORE           "
  print at 6,12, "  HIGH SCORE      "
  print at 6,13, "                  "
  print at 19,11, Sc
  print at 19,12, Hi
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if DeadT > 0 then
    dec DeadT
    if DeadT = 0 then
      dec Sh
      ShowHud
      if Sh = 0 then
        Over = 1
        return
      end if
      NewRound
    end if
    return
  end if
  MoveMoons
  MovePlayer
  if BoomT > 0 then
    dec BoomT
    if BoomT = 0 then NewAlien
  else
    MoveAlien
    inc LpT
    if LpT >= LpN then
      LpT = 0
      inc Lp
      if Lp = 85 then play sound SndGrow
      if Lp >= 100 then
        Why = 1
        Doom
        return
      end if
    end if
  end if
  BeamStep
  if BeamT > 0 then
    if BoomT = 0 then CheckHit
  end if
  if MoonHits(Px) > 0 then
    Why = 2
    Doom
  end if
  return
end sub

' the cannon is destroyed: everything stops for DeadN frames
sub Doom:
  DeadT = DeadN
  if BeamT > 0 then
    BeamT = 0
    EraseBeam
  end if
  Cool = 0
  if Why = 1 then
    play sound SndHit
  else
    play sound SndCrash
  end if
  return
end sub

' the stick: left and right, 1.5 pixels a frame, inside the frame
sub MovePlayer:
  K = J1 | J2
  V = K & 4
  if V > 0 then
    if Pw > PwMin + PSpd then
      Pw = Pw - PSpd
    else
      Pw = PwMin
    end if
  end if
  V = K & 8
  if V > 0 then
    Pw = Pw + PSpd
    if Pw > PwMax then Pw = PwMax
  end if
  W16 = Pw >> 2
  Px = W16
  return
end sub

' the Moondog bounces inside its box, one pixel a frame each way
sub MoveAlien:
  if Ay < Bt then Ady = 1
  if Ay > Bb then Ady = 255
  if Ax > Br then Adx = 255
  if Ax < Bl then Adx = 1
  Ax = Ax + Adx
  Ay = Ay + Ady
  return
end sub

' the Moondog's picture: 0 dot, 1 small, 2 medium, 3 large
function AlSize as u8
  if Lp >= 100 then return 3
  if Lp >= 85 then return 2
  if Lp >= 40 then return 1
  return 0

' the laser: a shot of BeamN frames, then CoolN frames to recharge
sub BeamStep:
  if BeamT > 0 then
    dec BeamT
    if BeamT = 0 then
      EraseBeam
      Cool = CoolN
    end if
    return
  end if
  if Cool > 0 then
    dec Cool
    return
  end if
  K = J1 | J2
  V = K & 16
  if V = 0 then return
  BeamT = BeamN
  V = Px + 8
  Bc = V >> 3
  DrawBeam
  play sound SndZap
  return
end sub

' the beam (pixels Bc * 8 + 3 and + 4) against the Moondog's picture
sub CheckHit:
  i16 Mid = 0
  i16 Lo = 0
  i16 Hi16 = 0
  u8 Hw = 0
  Hw = AlHw[AlSize]
  Mid = Ax + 8
  Lo = Bc << 3
  Lo = Lo + 3
  Hi16 = Lo + 1
  if Mid - Hw > Hi16 then return
  if Mid + Hw < Lo then return
  V = 100 - Lp
  Sc += V
  ShowScore
  BoomT = BoomN
  inc Kills
  select case Kills
  case 0 to 7
    LpN = LpRate[0]
  case 8 to 15
    LpN = LpRate[1]
  case else
    LpN = LpRate[2]
  end select
  play sound SndBoom
  return
end sub

' the moons fall; a full-grown moon over the cannon (pixel X Cx) counts
sub MoveMoons:
  i16 Nx = 0
  MPh = MPh ^ 1
  for Mi = 0 to 3
    if Mn[Mi].Age < 16 then inc Mn[Mi].Age
    if MPh = 1 then continue for
    Mn[Mi].Y = Mn[Mi].Y + Mn[Mi].Dy
    Nx = Mn[Mi].X
    Nx = Nx + Mn[Mi].Dx
    if Nx < MoonL then
      Nx = MoonL
      Mn[Mi].Dx = 0 - Mn[Mi].Dx
    end if
    if Nx > MoonR then
      Nx = MoonR
      Mn[Mi].Dx = 0 - Mn[Mi].Dx
    end if
    Mn[Mi].X = Nx
    if Mn[Mi].Y >= MoonBot then Respawn(Mi)
  next
  return
end sub

sub Respawn(u8 Which):
  Rand
  W16 = Rs & 127
  V = W16
  W16 = Rs >> 7
  W16 = W16 & 63
  V = V + W16
  Mn[Which].X = V + MoonL
  Mn[Which].Y = MoonTop
  Mn[Which].Age = 0
  return
end sub

function MoonHits(u8 Cx) as u8
  u8 Hits = 0
  u8 Q = 0
  for Q = 0 to 3
    if Mn[Q].Age >= 16 then
      if Mn[Q].X + 2 < Cx + 15 then
        if Cx < Mn[Q].X + 13 then
          if Mn[Q].Y + 14 >= PlY + 6 then
            if Mn[Q].Y + 1 <= PlY + 13 then inc Hits
          end if
        end if
      end if
    end if
  next
  return Hits

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new Moondog: random directions and box, at the start place, LP 0
sub NewAlien:
  Rand
  V = Rs & 1
  if V = 0 then
    Adx = 1
  else
    Adx = 255
  end if
  Rand
  V = Rs & 1
  if V = 0 then
    Ady = 1
  else
    Ady = 255
  end if
  Rand
  V = Rs & 63
  Bt = V + 20
  Rand
  V = Rs & 63
  Bb = V + 56
  Rand
  V = Rs & 63
  Br = V + 100
  Rand
  V = Rs & 63
  Bl = V + 32
  Ax = 93
  Ay = 70
  Lp = 0
  LpT = 0
  return
end sub

sub ResetMoons:
  for Mi = 0 to 3
    Mn[Mi].X = MStartX[Mi]
    Mn[Mi].Y = MStartY[Mi]
    Mn[Mi].Age = 0
    Mn[Mi].Dy = MDy[Mi]
    Mn[Mi].Dx = MDx[Mi]
  next
  return
end sub

sub NewRound:
  NewAlien
  ResetMoons
  Pw = 432
  Px = 108
  BoomT = 0
  BeamT = 0
  Cool = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the star field: which tile at column C, row R
function StarAt(u8 Col, u8 Row) as u8
  u8 H = 0
  H = Col * 7
  H = H + Row * 13
  H = H + Col * Row
  H = H & 31
  select case H
  case 0
    return TStar3
  case 1, 2
    return TStar1
  case 3
    return TStar2
  case else
    return TSky
  end select
  return TSky

sub DrawBeam:
  put char TBeamtop at Bc,BeamRow
  N = BeamRow + 1
  for Ri = N to BeamLow
    put char TBeam at Bc,Ri
  next
  return
end sub

sub EraseBeam:
  for Ri = BeamRow to BeamLow
    T = StarAt(Bc, Ri)
    put char T at Bc,Ri
  next
  return
end sub

' the four rows of plain scroll at their own speeds (front rows faster)
sub ScrollGround:
  for Gi = 0 to 3
    V = 3 - Gi
    U = Tick & V
    if U = 0 then
      V = GPh[Gi] + 1
      V = V & 15
      GPh[Gi] = V
      W16 = Gi << 4
      W16 = W16 + V
      W16 = W16 << 4
      A16 = Gi << 1
      A16 = A16 + TGr00
      A16 = A16 << 3
      copy GroundPat + W16 count 16 to vram.pattern + 4096 + A16
    end if
  next
  return
end sub

' sprites 0-1 the cannon, 2-3 the Moondog, 4-7 the moons
sub DrawSprites:
  Y = PlY - 1
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  elseif DeadT > 0 then
    V = DeadT >> 3
    V = V & 1
    K = V << 2
    K = K + SBoom0
    set sprite 0 to Y,Px,K,11
    set sprite 1 to Y,Px,SCan,6
  else
    set sprite 0 to Y,Px,SCanl,11
    set sprite 1 to Y,Px,SCan,5
  end if
  Y = Ay - 1
  if TitleOn = 1 then
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  elseif BoomT > 0 then
    V = BoomT >> 3
    V = V & 1
    K = V << 2
    K = K + SBoom0
    set sprite 2 to Y,Ax,K,11
    set sprite 3 to 192,0,0,0
  else
    N = AlSize
    K = N << 3
    J = K + SAle0
    K = K + SAlb0
    set sprite 2 to Y,Ax,J,11
    set sprite 3 to Y,Ax,K,3
  end if
  for Mi = 0 to 3
    J = Mi + 4
    V = Mn[Mi].Age
    if V < 8 then
      K = SMoon0
    elseif V < 16 then
      K = SMoon1
    else
      K = SMoon2
    end if
    Y = Mn[Mi].Y - 1
    X = Mn[Mi].X
    C = MCol[Mi]
    set sprite J to Y,X,K,C
  next
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print at 21,1, "SHIPS"
  ShowScore
  NumU = Sh
  print at 27,1, digits$(NumU, 1)
  return
end sub

sub ShowScore:
  print at 8,1, Sc
  return
end sub

' the frame, the stars and the plain
sub DrawField:
  put char TFrtl at 2,2
  fill TFrt count 26 at 3,2
  put char TFrtr at 29,2
  for Ri = 3 to 18
    put char TFrl at 2,Ri
    put char TFrl at 29,Ri
    for J = 3 to 28
      T = StarAt(J, Ri)
      put char T at J,Ri
    next
  next
  for Ri = 19 to 22
    V = Ri - 19
    T = V << 1
    T = T + TGr00
    for J = 0 to 31
      V = J & 1
      U = T + V
      put char U at J,Ri
    next
  next
  return
end sub

sub NewGame:
  Sc = 0
  Sh = 4
  Kills = 0
  LpN = LpRate[0]
  NewScreen
  DrawField
  ShowHud
  NewRound
  DeadT = 0
  Over = 0
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  for Gi = 0 to 3
    GPh[Gi] = 0
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the big MOONDOG letters (three tiles by four each) at row 4
sub DrawLogo:
  u16 Ix = 0
  u8 L = 0
  u8 Ly = 0
  u8 Lx = 0
  u8 Col = 0
  for L = 0 to 6
    Col = L * 3
    Col = Col + 5
    for Ly = 0 to 3
      for Lx = 0 to 2
        Ix = L * 12
        Ix = Ix + Ly * 3
        Ix = Ix + Lx
        T = LogoT[Ix]
        X = Col + Lx
        Y = Ly + 4
        put char T at X,Y
      next
    next
  next
  return
end sub

' the title: the logo, falling moons, the tune once, START GAME / CREDITS
sub TitlePage:
  NewScreen
  DrawField
  for Ri = 3 to 18
    fill 32 count 26 at 3,Ri
  next
  DrawLogo
  print at 9,10, "BY J.C. HILTY"
  print at 10,13, "START GAME"
  print at 10,14, "CREDITS"
  print at 8,17, "AHOY! MAY 1987"
  print at 2,1, "HIGH SCORE"
  print at 13,1, Hi
  ShowMenu
  ResetMoons
  ' on the title the moons fall beside the text
  Mn[0].X = 28
  Mn[1].X = 216
  Mn[2].X = 216
  Mn[3].X = 28
  TitleOn = 1
  DeadT = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ScrollGround
  for Mi = 0 to 3
    Mn[Mi].Y = Mn[Mi].Y + 1
    if Mn[Mi].Y >= MoonBot then Mn[Mi].Y = MoonTop
    if Mn[Mi].Age < 16 then inc Mn[Mi].Age
  next
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 8,13
  put char 32 at 8,14
  J = Menu + 13
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "MOONDOG"
  print at 2,5, "BASED ON MOONDOG BY"
  print at 2,6, "J.C. HILTY, AHOY! MAY 1987"
  print at 2,7, "(COMMODORE 64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: LUNAR PATROL"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

