asm {
; DfR3: three colour thirds of their own (`mode 2 screen` keeps R3 at
; $9F, Amy bug #38)
DfR3:
  ld bc,$03FF
  jp WRITE_REGISTER

; DfRnd: 16-bit xorshift (7, 9, 8) on Rs
DfRnd:
  ld hl,(AMY_UVAR_Rs)
  ld a,h
  rra
  ld a,l
  rra
  xor h
  ld h,a
  ld a,l
  rra
  ld a,h
  rra
  xor l
  ld l,a
  xor h
  ld h,a
  ld (AMY_UVAR_Rs),hl
  ret
