cartridge "DARK FORTRESS II/CLEVE BLAKEMORE/1987"

' DARK FORTRESS II - BEYOND THE COPPER MINES
' A ColecoVision game based on "Dark Fortress ][" (version 2.3) by Cleve
' Blakemore, Ahoy! February 1988 (Commodore 128 BASIC 7.0, "a double
' screen game" for two players on the 40 and 80 column monitors), the
' sequel of Dark Fortress (games/dfort, whose engine, look and pictures
' this game reuses). Made for Amy Studio by Claude (an AI made by
' Anthropic), 2026, in Amy by Amy Bienvenu. The listing is in orig/.
'
' Two adventurers race to find the second three gems - the topaz, the
' ruby and the sapphire - and to rescue the brave Sir Gomar, kidnapped by
' the necromancer Sumogoratra and held in the Fortress of Forgotten Dreams
' deep in the copper mines. Whoever lays the three gems and Sir Gomar in
' the unlocked trophy case wins. One player may also go alone.
'
' Controls (joystick only): the stick moves the flame over the words, a
' button chooses. In a list the right button says "nothing". With two
' players each uses his own controller and the turns alternate.
'
' From the listing (line numbers of DARK FORTRESS ][): the map, objects
' and monsters (DATA 2750-3450); start in the trophy room with 20 life,
' 1000 gold, a load of 5 and the resurrection spell (110-120); a turn:
' life +.2, look, a choice, the monsters (230-500); your blow lands when
' RND < .2 + life/10 and adds sword 1 + life/5 to the damage done in the
' room (920-950); a monster dies when the damage passes its strength (its
' bit: dwarf 1 .. dragon 256), the other player's damage counting when he
' is here; a kill gives life and RND(kind x 50) gold; the thief drops his
' loot, Sumogoratra the topaz, the dragon the ruby (320-410); a monster
' strikes when RND < .2 + kind/10 (-.2 with the fishing rod) for kind
' points, the thief snatching all you carry (420); death sends you to
' Hades (440); rooms 6-19 dark without a lantern (740); the river of fire
' without the asbestos suit (700); take, drop, the win, the rowboat lost
' at sea (970-1110); swipe (1200-1280); the nine spells (1300-1480);
' speak (1500-1620); the copper key's gate and trophy case (1640-1680);
' use (1700-1870): ladder, rod, shovel, rope, mining car, wirecutters;
' push (1890-2020): the trophy case, the rowboat, the panel, the boulder,
' the instructions and the four buttons of Hades (south and east on:
' a door opens); examine and the trading post (2040-2400); quit when both
' players choose it (310, 2420).
'
' The changes for the ColecoVision (liberties):
' - one screen, turns handed over with the controllers; one player can
'   play alone (then QUIT ends the game at once);
' - no save and load to disk: QUIT chosen by both players in turn ends the
'   game (the listing then saved a file);
' - pictures of each kind of place, monsters, props and players as
'   sprites; prices shown at the trading post;
' - fixes: the thief, when killed, gives back all he took (the listing
'   never cleared his hoard); the other player's damage counts when he is
'   in the same room (the listing compared the room with his number); you
'   cannot buy a thing or spell you already have (the listing took the
'   gold); "you don't have the key" at the mine gate (the listing named
'   the tower); examining the den without the dragon finds the 50 gold
'   once, not every turn (that was a free purse for standing still); the
'   dragon's ruby is no longer described after it is gone; the strength
'   spell says what it did; the other player's lantern lights a dark room
'   (the listing lit it whenever he was there).
'
' House rules: tiles from code 128 (the scene pictures use the top third
' only); screens drawn with the NMI off; music first in the sound table
' ($702B, $7035) and quieter than the effects; nothing flashes.

const SCursor = 0
const SHero = 4
const SGhost = 12
const SEyes = 20
const SMon = 24
const SProp = 168
const SprBytes = 2048
const ScHades = 0
const ScSea = 1
const ScMine = 2
const ScHall = 3
const ScCavern = 4
const ScLounge = 5
const ScTitle = 6
const PTome = 1
const PPanel = 2
const PBoulder = 3
const PGate = 4
const PRailcar = 5
const PMachine = 6
const PHoard = 7
const PCase = 8
const PBooth = 9
const PBoat = 10
const PButtons = 11
const SndTuneA = 1
const SndTuneB = 2
const SndNightA = 3
const SndNightB = 4
const SndTick = 5
const SndPick = 6
const SndStep = 7
const SndBump = 8
const SndSlash = 9
const SndHit = 10
const SndKill = 11
const SndOuch = 12
const SndTake = 13
const SndDrop = 14
const SndCoin = 15
const SndUnlock = 16
const SndSpell = 17
const SndFizz = 18
const SndBoom = 19
const SndDrink = 20
const SndTalk = 21
const SndTurn = 22
const SndDie = 23
const SndWin = 24
const TitleLen = 576
const TItem = 0
const TMon = 15
const TSpell = 24
const TRoom = 33
const TVerb = 58
const TMisc = 76
const TDesc = 82
' u16/i16 compared with a variable, not a small literal (from games/dfort)
i16 I0w = 0
i16 I80w = 80
u16 U0w = 0
u16 U1w = 1
u16 GemsW = 2076
u16 TzLeft = 0
u8 TzOn = 0

' the players (index 1 and 2): room, things carried (bits 0-14), spells
' (bits 0-8), gold, life in tenths, damage done in this room in tenths,
' the things the thief holds, the load (5 to 14), the last word chosen
u8 Cp[3]
u16 Lp[3]
u16 Sp[3]
u16 Gp[3]
i16 Hp[3]
u16 Tp[3]
u16 Bp[3]
u8 Wp[3]
u8 Qp[3]
' the player whose turn it is
u8 Np = 1
u8 Z = 1
u8 Oz = 2
u8 Cl = 20
u8 Cl0 = 20
u16 Lb = 0
u16 Sb = 0
u16 Gd = 0
i16 Hh = 0
u16 Th = 0
u8 Cs = 5
' the world: exits (room * 6 + way), objects and monsters of each room,
' the trading post's goods
u8 Dx[186]
u16 Ob[31]
u16 Mo[31]
u16 Tr = 0
' Won: 1 a win, 2 both quit
u8 Won = 0
u8 Winner = 0
u16 Turns = 0
u16 Rs = 1
u16 Seed = 1
' for the test bot: Idle 1 main menu, 2 a list, 3 hand over, 4 a long text,
' 5 the title
u8 Idle = 0
u8 Busy = 0
' the menu
u8 Sel = 0
u8 MN = 0
u8 MRows = 5
u8 MX0 = 2
u8 MXs = 8
u8 MY0 = 18
u8 MKind = 0
u8 OptT[16]
u8 OptI[16]
u8 MsgY = 16
' the picture
u8 Scene = 255
u8 MonY = 0
u8 PropK = 0
u8 Anim = 0
u8 MonF = 0
u8 HeroF = 0
u8 ShowMon = 0
u8 ShowOth = 0
u8 GhostOn = 0
u8 EyesOn = 0
' input
u8 Pz = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB = 0
u8 P1 = 0
u8 P2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
' scratch
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u16 P = 0
u16 Qw = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Px = 0
u8 Rb = 0
u8 Ri = 0
u8 It = 0
u8 Dk = 0
u8 Chc = 0
u8 Dir = 0

  ' the font, then three colour thirds of their own (R3 $FF)
  tile screen
  call asm DfR3
  set sound table DfSoundTable areas 6
  sprites 16x16
  nmi off
  decompress zx0 SpritePat to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Np = 0 then goto title

new_game:
  NewGame
  GameScreen
  play sound SndNightA
  play sound SndNightB

turn_loop:
  if Np = 2 then HandOver
  LoadPlayer
  Hh = Hh + 2
  Cl0 = Cl
  DrawRoom
  DrawMenu
  MenuMain
  Qp[Z] = Sel
  ClearMsg
  Act(Sel)
  if Won > 0 then goto game_over
  DrawRoom
  MonPhase
  DeathCheck
  if Cl <> Cl0 then Th = U0w
  SavePlayer
  inc Turns
  if Np = 2 then
    Oz = Z
    Z = 3 - Z
  end if
  goto turn_loop

game_over:
  Idle = 0
  SavePlayer
  mute all
  if Won = 1 then play sound SndWin
  EndPage
  goto title

' ---------------------------------------------------------------------------
' the players

sub LoadPlayer:
  Cl = Cp[Z]
  Lb = Lp[Z]
  Sb = Sp[Z]
  Gd = Gp[Z]
  Hh = Hp[Z]
  Th = Tp[Z]
  Cs = Wp[Z]
  return
end sub

sub SavePlayer:
  Cp[Z] = Cl
  Lp[Z] = Lb
  Sp[Z] = Sb
  Gp[Z] = Gd
  Hp[Z] = Hh
  Tp[Z] = Th
  Wp[Z] = Cs
  return
end sub

' Rnd(n): 0 to n-1 from the high byte of (random byte) x n
function Rnd(u8 Rn) as u8
  call asm DfRnd
  Rb = Rs
  W16 = Rb * Rn
  W16 = W16 >> 8
  Rb = W16
  return Rb

' the highest monster in the room (1 dwarf .. 9 dragon), 0 none
function MonIn(u8 Mr) as u8
  W16 = Mo[Mr] & 511
  Ri = 0
  for J = 0 to 8
    A16 = W16 & BitW[J]
    if A16 > U0w then Ri = J + 1
  next
  return Ri

' 1 when the room is too dark to see (line 740)
function IsDark(u8 Dr) as u8
  if Dr < 6 then return 0
  if Dr > 19 then return 0
  A16 = Lb & 128
  if A16 > U0w then return 0
  if Np = 2 then
    if Cp[Oz] = Dr then
      A16 = Lp[Oz] & 128
      if A16 > U0w then return 0
    end if
  end if
  return 1

' the number of things carried
function Carried as u8
  Ri = 0
  for J = 0 to 14
    A16 = Lb & BitW[J]
    if A16 > U0w then inc Ri
  next
  return Ri

function Has(u8 Hi) as u8
  A16 = Lb & BitW[Hi]
  if A16 > U0w then return 1
  return 0

function KnowsSpell(u8 Ks) as u8
  A16 = Sb & BitW[Ks]
  if A16 > U0w then return 1
  return 0

' the other player is here
function OthHere as u8
  if Np = 1 then return 0
  if Cp[Oz] = Cl then return 1
  return 0

' a flag (bits 9-14) of the room is set
function Flag(u8 Fr, u8 Fb) as u8
  A16 = Mo[Fr] & BitW[Fb]
  if A16 > U0w then return 1
  return 0

' ---------------------------------------------------------------------------
' a turn: the word chosen (0-5 the ways, then the listing's commands 7-18)

sub Act(u8 Av):
  if Av < 6 then
    GoWay(Av)
    return
  end if
  select case Av
    case 6
      DoItems
    case 7
      DoAttack
    case 8
      DoTake
    case 9
      DoDrop
    case 10
      DoSwipe
    case 11
      DoCast
    case 12
      DoSpeak
    case 13
      DoLock
    case 14
      DoUse
    case 15
      DoPush
    case 16
      DoExamine
    case 17
      DoQuit
  end select
  return
end sub

' line 700
sub GoWay(u8 Gw):
  if Cl = 9 then
    if Gw = 1 then
      if Has(9) = 0 then
        play sound SndDie
        LongText(107)
        Hh = 0
        return
      end if
    end if
  end if
  V = Cl * 6
  V = V + Gw
  W = Dx[V]
  if W = 0 then
    play sound SndBump
    Say(108)
    return
  end if
  Cl = W
  Th = 0
  play sound SndStep
  return
end sub

' line 890: two pages, the things (and gold, life, load), then the spells
sub DoItems:
  LongBegin
  print at 2,9, "YOU CARRY:"
  Y = 10
  X = 2
  N = 0
  for It = 0 to 14
    if Has(It) = 1 then
      PutStr(0, It, X, Y, 0)
      inc N
      if X = 1 then
        X = 16
      else
        X = 2
        inc Y
      end if
    end if
  next
  if N = 0 then print at 2,10, "NOTHING"
  print at 2,17, "GOLD"
  NumU = Gd
  print NumU at 6,17 width 5
  print at 12,17, "LIFE"
  NumU = 0
  if Hh > I0w then
    W16 = Hh
    NumU = W16 / 10
  end if
  print NumU at 17,17 width 3
  print at 21,17, "LOAD"
  NumU = N
  print NumU at 26,17 width 2
  NumU = Cs
  print at 28,17, "/"
  print NumU at 29,17 width 2
  LongWait
  LongBegin
  print at 2,9, "YOUR SPELLS:"
  Y = 10
  X = 2
  N = 0
  for It = 0 to 8
    if KnowsSpell(It) = 1 then
      PutStr(2, It, X, Y, 0)
      inc N
      if X = 1 then
        X = 16
      else
        X = 2
        inc Y
      end if
    end if
  next
  if N = 0 then print at 2,10, "NONE"
  LongEnd
  return
end sub

' line 920
sub DoAttack:
  if MonIn(Cl) = 0 then
    Say(109)
    return
  end if
  A16 = Lb & 7
  if A16 = U0w then
    Say(110)
    return
  end if
  play sound SndSlash
  Say(111)
  V = 20
  if Hh > I0w then
    if Hh > I80w then
      V = 100
    else
      W16 = Hh
      V = W16 + 20
    end if
  end if
  if Rnd(100) < V then
    A16 = Lb & 1
    A16 = A16 * 10
    Th = Th + A16
    if Hh > I0w then
      W16 = Hh
      W16 = W16 / 5
      Th = Th + W16
    end if
    play sound SndHit
    Say(112)
  end if
  return
end sub

' the end of a list: NOTHING (5), NO SPELL (6), NO DIRECTION (8)
sub ListEnd(u8 Le):
  OptT[MN] = Le
  OptI[MN] = 0
  inc MN
  return
end sub

' the things of a set of bits as a list (Ls: the room, mine, the other's)
sub ListBits(u16 Ls):
  MN = 0
  for It = 0 to 14
    A16 = Ls & BitW[It]
    if A16 > U0w then
      if MN < 11 then
        OptT[MN] = 0
        OptI[MN] = It
        inc MN
      end if
    end if
  next
  ListEnd(5)
  return
end sub

' the four ways as a list (push, the mining car)
function AskWay as u8
  MN = 0
  for J = 0 to 3
    OptT[J] = 4
    OptI[J] = J
  next
  MN = 4
  ListEnd(8)
  MenuList(9)
  if Sel = 4 then return 255
  return Sel

' line 970
sub DoTake:
  if Ob[Cl] = U0w then
    Say(113)
    return
  end if
  if Carried >= Cs then
    Say(114)
    return
  end if
  ListBits(Ob[Cl])
  MenuList(1)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  if Has(It) = 1 then
    Say(115)
    return
  end if
  Lb = Lb | BitW[It]
  Ob[Cl] = Ob[Cl] - BitW[It]
  play sound SndTake
  NextLine
  print at 2,MsgY, "TAKEN:"
  PutStr(0, It, 9, MsgY, 0)
  return
end sub

' line 1040, the win (1080) and the rowboat given away at sea (1090)
sub DoDrop:
  if Lb = U0w then
    Say(116)
    return
  end if
  ListBits(Lb)
  MenuList(2)
  if OptT[Sel] <> 5 then
    It = OptI[Sel]
    A16 = Ob[Cl] & BitW[It]
    if A16 > U0w then
      Say(117)
      return
    end if
    Lb = Lb - BitW[It]
    Ob[Cl] = Ob[Cl] | BitW[It]
    play sound SndDrop
    NextLine
    print at 2,MsgY, "DROPPED:"
    PutStr(0, It, 11, MsgY, 0)
  end if
  if Cl = 4 then
    A16 = Ob[4] & 4096
    if A16 > U0w then
      play sound SndDie
      LongText(118)
      Hh = 0
    end if
    return
  end if
  if Cl <> 20 then return
  if Flag(20, 9) = 1 then return
  A16 = Ob[20] & GemsW
  if A16 <> GemsW then return
  Won = 1
  Winner = Z
  return
end sub

' line 1200
sub DoSwipe:
  if OthHere = 0 then
    Say(119)
    return
  end if
  if Lp[Oz] = U0w then
    Say(120)
    return
  end if
  if Carried >= Cs then
    Say(114)
    return
  end if
  Say(121)
  ListBits(Lp[Oz])
  MenuList(8)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  V = 0
  if Hh > Hp[Oz] then
    if Has(It) = 0 then V = 1
  end if
  if V = 0 then
    play sound SndBump
    Say(122)
    return
  end if
  Lp[Oz] = Lp[Oz] - BitW[It]
  Lb = Lb | BitW[It]
  play sound SndTake
  NextLine
  print at 2,MsgY, "SWIPED:"
  PutStr(0, It, 10, MsgY, 0)
  return
end sub

' line 1300
sub DoCast:
  if Sb = U0w then
    Say(123)
    return
  end if
  MN = 0
  for It = 0 to 8
    if KnowsSpell(It) = 1 then
      OptT[MN] = 2
      OptI[MN] = It
      inc MN
    end if
  next
  ListEnd(6)
  MenuList(3)
  if OptT[Sel] = 6 then return
  It = OptI[Sel]
  Sb = Sb - BitW[It]
  select case It
    case 0
      CastTranslate
    case 1
      Hh = Hh + 200
      play sound SndSpell
      Say(124)
    case 2
      Th = Th + 1000
      play sound SndBoom
      Say(125)
    case 3
      Th = Th + 2000
      play sound SndBoom
      Say(126)
    case 4
      CastTeleport
    case 5
      if Np = 1 then
        play sound SndFizz
        Say(127)
      else
        play sound SndSpell
        Seer
      end if
    case 6
      if Cs < 14 then inc Cs
      play sound SndSpell
      Say(128)
    case 7
      CastFumble
    case 8
      if Cl = 0 then
        Cl = 21
        Hh = 100
        play sound SndSpell
        Say(129)
      else
        play sound SndFizz
        Say(130)
      end if
  end select
  return
end sub

' line 1340
sub CastTranslate:
  play sound SndSpell
  if Cl = 7 then
    LongText(131)
  elseif Cl = 10 then
    LongText(132)
  elseif Cl = 1 then
    Say(133)
  else
    Say(134)
  end if
  return
end sub

' line 1410: the other player to a room 1-22, not the sea, the tower or
' the den
sub CastTeleport:
  if OthHere = 0 then
    play sound SndFizz
    Say(135)
    return
  end if
  W = 1
  while W = 1
    V = Rnd(22)
    V = V + 1
    W = 0
    if V = 19 then W = 1
    if V > 3 then
      if V < 8 then W = 1
    end if
  end while
  Cp[Oz] = V
  Tp[Oz] = 0
  play sound SndSpell
  Say(136)
  return
end sub

' line 1450
sub CastFumble:
  V = Rnd(2)
  if OthHere = 1 then
    if V = 1 then
      if Ob[Cl] = U0w then
        if Cl <> 4 then
          Ob[Cl] = Lp[Oz]
          Lp[Oz] = 0
          play sound SndDrop
          Say(137)
          return
        end if
      end if
    end if
  end if
  if Cl = 19 then
    A16 = Mo[19] & 768
    if A16 = 768 then
      Ob[19] = Ob[19] | 8
      Mo[19] = Mo[19] - 512
      play sound SndSpell
      Say(138)
      return
    end if
  end if
  play sound SndFizz
  Say(130)
  return
end sub

' clairvoyance (line 1430): the other player's room for a moment
sub Seer:
  V = Cl
  Cl = Cp[Oz]
  Lb = Lb | 128
  DrawRoom
  Cl = V
  Lb = Lp[Z]
  Say(139)
  Idle = 4
  WaitPress
  Idle = 0
  return
end sub

' line 1500
sub DoSpeak:
  play sound SndTalk
  if Cl = 22 then
    Shop
    return
  end if
  V = 0
  if Cl > 11 then
    if Cl < 20 then V = 1
  end if
  if Cl > 22 then V = 1
  if Has(7) = 1 then V = 0
  if V = 1 then
    Say(140)
  elseif Cl = 0 then
    Say(141)
  else
    Say(142)
  end if
  Y = MonIn(Cl)
  select case Y
    case 1
      Say(143)
    case 2
      Say(144)
    case 5
      Say(145)
    case 7
      Say(146)
    case 8
      Say(147)
    case 9
      Say(148)
      return
  end select
  if Cl = 0 then
    if Rnd(20) = 0 then
      play sound SndSpell
      Say(149)
      Cl = 21
      Hh = 100
    end if
    return
  end if
  if Cl = 7 then
    play sound SndSpell
    Say(150)
    Cl = 21
  end if
  return
end sub

' line 1640: the copper key opens the mine gate and the trophy case
sub DoLock:
  if Has(8) = 1 then
    if Cl = 12 then
      W = Dx[77] ^ 13
      Dx[77] = W
      play sound SndUnlock
      if W = 0 then
        Say(151)
      else
        Say(152)
      end if
      return
    end if
    if Cl = 20 then
      Mo[20] = Mo[20] ^ 512
      play sound SndUnlock
      if Flag(20, 9) = 1 then
        Say(153)
      else
        Say(154)
      end if
      return
    end if
  end if
  if Cl = 12 or Cl = 20 then
    Say(155)
  else
    Say(156)
  end if
  return
end sub

' line 1700
sub DoUse:
  if Lb = U0w then
    Say(157)
    return
  end if
  ListBits(Lb)
  MenuList(4)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  if UseIt(It) = 0 then
    NextLine
    print at 2,MsgY, "NO USE FOR"
    PutStr(0, It, 13, MsgY, 0)
    if Px < 25 then print at Px,MsgY, " HERE!"
  end if
  return
end sub

' a thing used here: 1 when it did something
function UseIt(u8 Ui) as u8
  if Ui = 5 then
    if Cl = 1 then
      Ob[1] = Ob[1] | 32
      Lb = Lb - 32
      Cl = 20
      play sound SndStep
      Say(158)
      return 1
    end if
  end if
  if Ui = 1 then
    if Cl = 4 then
      if Flag(4, 9) = 1 then
        Ob[4] = Ob[4] | 16
        Mo[4] = Mo[4] - 512
        play sound SndCoin
        LongText(159)
        return 1
      end if
    end if
    if Cl = 2 then
      if Flag(2, 9) = 1 then
        Gd = Gd + 500
        Mo[2] = Mo[2] - 512
        play sound SndCoin
        Say(160)
        return 1
      end if
    end if
  end if
  if Ui = 13 then
    if Cl = 3 then
      if Flag(3, 9) = 1 then
        Mo[3] = Mo[3] - 512
        Gd = Gd + 1000
        play sound SndCoin
        Say(161)
        return 1
      end if
    end if
    if Cl = 10 then
      if Flag(10, 10) = 1 then
        Say(162)
        return 1
      end if
      if Flag(10, 9) = 1 then
        Mo[10] = Mo[10] - 512
        Gd = Gd + 1500
        play sound SndCoin
        Say(163)
        return 1
      end if
    end if
  end if
  if Ui = 6 then
    if Cl = 8 then
      Cl = 9
      play sound SndStep
      Say(164)
      return 1
    end if
  end if
  if Ui = 14 then
    if Cl > 13 then
      if Cl < 19 then
        Say(165)
        Dir = AskWay
        if Dir < 4 then
          play sound SndStep
          Say(166)
          V = Cl + Dir
          V = V + 1
          if V > 18 then V = V - 4
          Cl = V
        end if
        return 1
      end if
    end if
  end if
  if Ui = 10 then
    if Cl = 15 then
      if Flag(15, 9) = 0 then
        Say(167)
        return 1
      end if
      Gd = Gd + 800
      Mo[15] = Mo[15] - 512
      play sound SndCoin
      Say(168)
      return 1
    end if
  end if
  return 0

' line 1890
sub DoPush:
  Say(169)
  Dir = AskWay
  if Dir > 3 then return
  if Cl = 0 then
    PushButton
    return
  end if
  if PushIt = 0 then
    Say(170)
  end if
  return
end sub

' a push that did something: 1
function PushIt as u8
  if Cl = 20 then
    if Dir = 0 then
      Dx[125] = 1
      play sound SndUnlock
      Say(171)
      return 1
    end if
  end if
  if Has(12) = 1 then
    V = 0
    if Cl = 3 then
      if Dir = 2 then V = 1
    end if
    if Cl = 5 then
      if Dir = 3 then V = 1
    end if
    if V = 1 then
      Cl = 4
      play sound SndStep
      Say(172)
      return 1
    end if
    if Cl = 2 then
      if Dir = 2 then
        Hh = 0
        play sound SndDie
        Say(173)
        return 1
      end if
    end if
  end if
  if Cl = 6 then
    if Dir = 1 then
      if Flag(6, 9) = 1 then
        Mo[6] = Mo[6] - 512
        Gd = Gd + 2000
        play sound SndCoin
        Say(174)
      else
        Say(175)
      end if
      return 1
    end if
  end if
  if Cl = 10 then
    if Dir = 3 then
      if Flag(10, 10) = 1 then
        Mo[10] = Mo[10] - 1024
        play sound SndBoom
        LongText(176)
        return 1
      end if
    end if
  end if
  if Cl = 21 then
    if Dir = 2 then
      if Flag(21, 9) = 1 then
        Mo[21] = Mo[21] - 512
        Ob[21] = Ob[21] | 256
        play sound SndDrop
        Say(177)
        return 1
      end if
    end if
  end if
  return 0

' line 1990: the four buttons of Hades (bits 11-14: north, south, east,
' west); south and east on, north and west off, opens the way up
sub PushButton:
  V = Dir + 11
  Mo[0] = Mo[0] ^ BitW[V]
  play sound SndTick
  if Flag(0, V) = 1 then
    Say(178)
  else
    Say(179)
  end if
  A16 = Mo[0] & 30720
  if A16 = 12288 then
    Dx[4] = 21
    play sound SndSpell
    Say(180)
  end if
  return
end sub

' line 2040
sub DoExamine:
  if Cl = 22 then
    Shop
    return
  end if
  if IsDark(Cl) = 1 then
    Say(181)
    return
  end if
  if Cl = 21 then
    LongText(182)
    LongText(183)
    return
  end if
  select case Cl
    case 6
      Say(184)
      return
    case 0
      LongText(185)
      return
    case 1
      Say(186)
      return
    case 2
      LongText(187)
      return
    case 3
      LongText(188)
      return
    case 14
      Say(189)
      return
    case 15
      Say(190)
      return
  end select
  A16 = Mo[Cl] & 256
  if A16 > U0w then
    if Flag(Cl, 9) = 1 then
      Say(191)
      return
    end if
  end if
  select case Cl
    case 5
      Say(192)
    case 12
      Say(193)
    case 9
      LongText(194)
    case 19
      ExamDen
    case 20
      if Flag(20, 9) = 1 then
        Say(195)
      else
        Say(196)
      end if
    case 7
      Say(197)
    case else
      Say(198)
  end select
  return
end sub

' line 2370: the 50 gold of the den, once (bit 14 of the den)
sub ExamDen:
  if MonIn(19) = 0 then
    if Flag(19, 14) = 1 then
      Mo[19] = Mo[19] - 16384
      Gd = Gd + 50
      play sound SndCoin
      Say(199)
      return
    end if
  end if
  Say(200)
  return
end sub

' line 2050: the trading post; prices by place in the list, 200 a step
' for things (each sold once, but swords and lanterns always), 100 for
' spells
sub Shop:
  MN = 3
  for J = 0 to 2
    OptT[J] = 7
    OptI[J] = J
  next
  MenuList(5)
  if Sel = 2 then return
  if Sel = 0 then
    BuyThing
  else
    BuyMagic
  end if
  return
end sub

sub BuyThing:
  if Carried >= Cs then
    Say(114)
    return
  end if
  ListBits(Tr)
  MenuList(6)
  if OptT[Sel] = 5 then return
  It = OptI[Sel]
  W16 = Sel + 1
  W16 = W16 * 200
  if Has(It) = 1 then
    Say(201)
    return
  end if
  if Gd < W16 then
    Say(202)
    return
  end if
  Gd = Gd - W16
  Lb = Lb | BitW[It]
  Tr = Tr - BitW[It]
  Tr = Tr | 129
  play sound SndCoin
  NextLine
  print at 2,MsgY, "BOUGHT:"
  PutStr(0, It, 10, MsgY, 0)
  return
end sub

sub BuyMagic:
  MN = 9
  for J = 0 to 8
    OptT[J] = 2
    OptI[J] = J
  next
  ListEnd(5)
  MenuList(7)
  if Sel = 9 then return
  It = Sel
  W16 = Sel + 1
  W16 = W16 * 100
  if KnowsSpell(It) = 1 then
    Say(203)
    return
  end if
  if Gd < W16 then
    Say(202)
    return
  end if
  Gd = Gd - W16
  Sb = Sb | BitW[It]
  play sound SndCoin
  NextLine
  print at 2,MsgY, "LEARNED:"
  PutStr(2, It, 11, MsgY, 0)
  return
end sub

' line 2420: the game ends when both choose QUIT in turn (one player: at
' once)
sub DoQuit:
  if Np = 1 then
    Won = 2
    return
  end if
  if Qp[Oz] = 17 then
    Won = 2
    return
  end if
  LongText(204)
  return
end sub

' the monsters (lines 320-430)
sub MonPhase:
  Y = MonIn(Cl)
  if Y = 0 then return
  W16 = Mo[Cl] & 511
  W16 = W16 * 10
  A16 = Th
  if OthHere = 1 then A16 = Th + Tp[Oz]
  if A16 > W16 then
    Mo[Cl] = Mo[Cl] & 32256
    play sound SndKill
    NextLine
    V = Y - 1
    PutStr(1, V, 2, MsgY, 0)
    print at Px,MsgY, " KILLED!"
    Th = 0
    W16 = Y * 10
    Hh = Hh + W16
    V = Y * 25
    V = Rnd(V)
    NumU = V * 2
    Gd = Gd + NumU
    NextLine
    print at 2,MsgY, "YOU FOUND"
    print NumU at 12,MsgY width 3
    print at 16,MsgY, "GOLD PIECES!"
    MonLoot(Y)
    DrawRoom
    return
  end if
  V = Y * 10
  V = V + 20
  if Has(1) = 1 then V = V - 20
  if Rnd(100) < V then
    play sound SndOuch
    NextLine
    print at 2,MsgY, "CRUNCH!! STRUCK BY THE"
    NextLine
    V = Y - 1
    PutStr(1, V, 2, MsgY, 0)
    W16 = Y * 10
    Hh = Hh - W16
    if Y = 7 then
      if Bp[Z] = U0w then
        if Lb <> U0w then
          Bp[Z] = Lb
          Lb = 0
          Say(205)
        end if
      end if
    end if
    DrawStat
  end if
  return
end sub

' what a slain monster leaves (lines 360-390)
sub MonLoot(u8 Ml):
  if Ml = 7 then
    if Np = 2 then
      Ob[Cl] = Ob[Cl] | Bp[Oz]
      Bp[Oz] = 0
    end if
    Lb = Lb | Bp[Z]
    Bp[Z] = 0
    LongText(206)
  end if
  if Ml = 8 then
    Ob[Cl] = Ob[Cl] | 4
    Say(207)
  end if
  if Ml = 9 then
    Say(208)
    if Flag(Cl, 9) = 1 then
      Ob[Cl] = Ob[Cl] | 8
      Mo[Cl] = Mo[Cl] - 512
    end if
  end if
  return
end sub

' line 440
sub DeathCheck:
  if Hh > I0w then return
  if Cl = 0 then return
  play sound SndDie
  Say(209)
  Y = MonIn(Cl)
  if Y > 0 then
    NextLine
    print at 2,MsgY, "SLAIN BY THE"
    V = Y - 1
    PutStr(1, V, 15, MsgY, 0)
  end if
  Cl = 0
  DrawRoom
  return
end sub

' ---------------------------------------------------------------------------
' the screen

' the address of text n of the table
function TxtAddr(u8 Tn) as u16
  if Tn < 128 then
    P = TxtA[Tn]
  else
    V = Tn - 128
    P = TxtB[V]
  end if
  return P

' a name (0 things, 1 monsters, 2 spells, 3 rooms, 4 words of the menu,
' 5 NOTHING, 6 NO SPELL, 7 the trading choices) with Ad added to each
' letter (128: the heading or dim letters); Px ends after it
sub PutStr(u8 Tb, u8 Ix, u8 Sx, u8 Sy, u8 Ad):
  V = TbBase[Tb]
  if Tb = 3 then Ix = NameOf[Ix]
  if Tb < 5 then V = V + Ix
  if Tb = 7 then V = V + Ix
  PutTxt(V, Sx, Sy, Ad)
  return
end sub

' the next letter of the text at P (bytes 128-255: a word of WordT)
function GetCh as u8
  if Qw <> U0w then
    Chc = peek(Qw)
    inc Qw
    if Chc <> 0 then return Chc
    Qw = 0
  end if
  Chc = peek(P)
  inc P
  if Chc >= 128 then
    V = Chc - 128
    Qw = WordT[V]
    Chc = peek(Qw)
    inc Qw
  end if
  return Chc

' text n at Sx,Sy (byte 1: the next row)
sub PutTxt(u8 Tn, u8 Sx, u8 Sy, u8 Ad):
  P = TxtAddr(Tn)
  Px = Sx
  Qw = 0
  Chc = GetCh
  while Chc <> 0
    if Chc = 1 then
      Px = Sx
      inc Sy
    else
      Chc = Chc + Ad
      put char Chc at Px,Sy
      inc Px
    end if
    Chc = GetCh
  end while
  return
end sub

' a message in the message lines
sub Say(u8 Tn):
  P = TxtAddr(Tn)
  NextLine
  Px = 2
  Qw = 0
  Chc = GetCh
  while Chc <> 0
    if Chc = 1 then
      NextLine
      Px = 2
    else
      put char Chc at Px,MsgY
      inc Px
    end if
    Chc = GetCh
  end while
  return
end sub

' a long text: pages of up to 9 lines in rows 9-17
sub LongText(u8 Tn):
  P = TxtAddr(Tn)
  LongBegin
  Px = 2
  Y = 9
  Qw = 0
  Chc = GetCh
  while Chc <> 0
    if Chc = 1 then
      Px = 2
      inc Y
    elseif Chc = 2 then
      A16 = P
      LongWait
      LongBegin
      P = A16
      Px = 2
      Y = 9
    else
      put char Chc at Px,Y
      inc Px
    end if
    Chc = GetCh
  end while
  LongEnd
  return
end sub

' a number in the heading letters
sub PutNumH(u16 Nv, u8 Nx):
  Px = Nx
  A16 = 10000
  V = 0
  while A16 > U0w
    W = 0
    while Nv >= A16
      Nv = Nv - A16
      inc W
    end while
    if W > 0 then V = 1
    if A16 = U1w then V = 1
    if V = 1 then
      W = W + 176
      put char W at Px,8
      inc Px
    end if
    A16 = A16 / 10
  end while
  return
end sub

' the heading bar: the room's name, life and gold
sub DrawStat:
  fill 160 count 32 at 0,8
  PutStr(3, Cl, 2, 8, 128)
  put char 200 at 19,8
  NumU = 0
  if Hh > I0w then
    W16 = Hh
    NumU = W16 / 10
  end if
  PutNumH(NumU, 20)
  put char 199 at 24,8
  PutNumH(Gd, 25)
  return
end sub

' the room (line 670): picture, heading, text, exits, things, creatures
sub DrawRoom:
  Dk = IsDark(Cl)
  V = SceneOf[Cl]
  if Dk = 1 then V = 254
  if V <> Scene then
    Scene = V
    Rearm
    wait
    nmi off
    if Dk = 1 then
      fill $11 count 2048 to vram.color
    else
      decompress zx0 ScenePat[V] to vram.pattern
      decompress zx0 SceneCol[V] to vram.color
    end if
  end if
  DrawStat
  for J = 9 to 15
    fill 32 count 30 at 1,J
  next
  if Dk = 1 then
    print at 2,9, "YOU CAN'T SEE A THING IN"
    print at 2,10, "THIS DARKNESS!"
  else
    V = NameOf[Cl]
    V = V + TDesc
    PutTxt(V, 2, 9, 0)
    print at 2,13, "EXITS:"
    Px = 8
    for J = 0 to 5
      V = Cl * 6
      V = V + J
      if Dx[V] <> 0 then
        V = WayCh[J]
        put char V at Px,13
        Px = Px + 2
      end if
    next
    ' the things here
    Px = 2
    for It = 0 to 14
      A16 = Ob[Cl] & BitW[It]
      if A16 > U0w then
        if Px < 16 then
          if Px > 2 then
            put char 44 at Px,14
            inc Px
          end if
          PutStr(0, It, Px, 14, 0)
        else
          if Px < 28 then print at Px,14, ",.."
          Px = 31
        end if
      end if
    next
    Y = MonIn(Cl)
    if Y > 0 then
      V = Y - 1
      PutStr(1, V, 2, 15, 0)
      print at Px,15, "!"
    end if
    if OthHere = 1 then
      if Oz = 1 then
        print at 17,15, "PLAYER 1 HERE"
      else
        print at 17,15, "PLAYER 2 HERE"
      end if
    end if
  end if
  PlaceSprites
  return
end sub

' the sprites of the room: monster (or eyes in the dark), the players, a
' prop, the spirits of Hades
sub PlaceSprites:
  MonY = MonIn(Cl)
  ShowMon = 0
  EyesOn = 0
  if MonY > 0 then
    if Dk = 1 then
      EyesOn = 1
    else
      ShowMon = 1
    end if
  end if
  PropK = 0
  if Dk = 0 then PropK = PropOf[Cl]
  ShowOth = OthHere
  GhostOn = 0
  if Cl = 0 then GhostOn = 1
  AnimSprites
  return
end sub

sub AnimSprites:
  if ShowMon = 1 then
    V = MonY - 1
    V = V << 4
    W = MonF << 3
    V = V + W
    V = V + SMon
    W = MonColA[MonY]
    set sprite 1 to 39,176,V,W
    V = V + 4
    W = MonColB[MonY]
    set sprite 2 to 39,176,V,W
  else
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end if
  V = HeroF << 2
  V = V + SHero
  W = 5
  if Z = 2 then W = 9
  set sprite 3 to 43,56,V,W
  if ShowOth = 1 then
    W = 9
    if Z = 2 then W = 5
    set sprite 4 to 43,84,SHero,W
  else
    set sprite 4 to 192,0,0,0
  end if
  if PropK > 0 then
    V = PropK - 1
    V = V << 3
    V = V + SProp
    W = PropColA[PropK]
    set sprite 5 to 20,120,V,W
    V = V + 4
    W = PropColB[PropK]
    set sprite 6 to 20,120,V,W
  else
    set sprite 5 to 192,0,0,0
    set sprite 6 to 192,0,0,0
  end if
  if GhostOn = 1 then
    V = Anim >> 1
    V = V & 63
    if V > 31 then V = 63 - V
    X = V + 24
    W = MonF << 2
    W = W + SGhost
    set sprite 7 to 6,X,W,14
    X = 200 - V
    set sprite 8 to 14,X,W,14
  elseif EyesOn = 1 then
    set sprite 7 to 30,176,SEyes,8
    set sprite 8 to 192,0,0,0
  else
    set sprite 7 to 192,0,0,0
    set sprite 8 to 192,0,0,0
  end if
  update sprites
  return
end sub

' a frame of the slow animation: monsters bob every 24 frames, the hero
' shifts his feet every 40, the spirits drift
sub AnimTick:
  inc Anim
  V = Anim % 24
  if V = 0 then MonF = MonF ^ 1
  V = Anim % 40
  if V = 0 then HeroF = HeroF ^ 1
  AnimSprites
  return
end sub

sub ClearMsg:
  fill 32 count 30 at 1,16
  fill 32 count 30 at 1,17
  MsgY = 15
  return
end sub

' the next message line (scrolls the two lines up when full)
sub NextLine:
  if MsgY < 17 then
    inc MsgY
    return
  end if
  copy vram.name + 545 count 30 to vram.name + 513
  fill 32 count 30 at 1,17
  return
end sub

' a long text in rows 9-17: begin and end (the button, then the room)
sub LongBegin:
  for J = 9 to 17
    fill 32 count 30 at 1,J
  next
  return
end sub

sub LongWait:
  for J = 18 to 22
    fill 32 count 31 at 1,J
  next
  set sprite 0 to 192,0,0,0
  print at 8,20, "PRESS THE BUTTON"
  Idle = 4
  WaitPress
  Idle = 0
  return
end sub

sub LongEnd:
  LongWait
  ClearMsg
  DrawRoom
  DrawMenu
  return
end sub

' waits for a button of the player whose turn it is
sub WaitPress:
  WasB = 1
wp_loop:
  Frame1
  AnimTick
  ReadPad
  V = P1 | P2
  if V = 0 then goto wp_loop
  return
end sub

' the 18 words, the ways you cannot go dimmed
sub DrawMenu:
  for J = 16 to 22
    fill 32 count 31 at 1,J
  next
  for K = 0 to 17
    X = K / 5
    Y = K % 5
    X = X * 7
    X = X + 2
    Y = Y + 18
    W = 0
    if K < 6 then
      if Dk = 0 then
        V = Cl * 6
        V = V + K
        if Dx[V] = 0 then W = 128
      end if
    end if
    PutStr(4, K, X, Y, W)
  next
  return
end sub

' the flame beside the choice
sub PutCursor:
  X = Sel / MRows
  Y = Sel % MRows
  X = X * MXs
  X = X + MX0
  X = X - 1
  X = X << 3
  Y = Y + MY0
  Y = Y << 3
  Y = Y - 4
  W = 5
  if Z = 2 then W = 9
  if Np = 0 then W = 8
  set sprite 0 to Y,X,SCursor,W
  update sprites
  return
end sub

' the main menu: 18 words in 4 columns of 5
sub MenuMain:
  MN = 18
  MRows = 5
  MX0 = 2
  MXs = 7
  MY0 = 18
  MKind = 0
  Sel = 0
  Idle = 1
  Pick
  Idle = 0
  return
end sub

' a list in rows 17-22 (two columns of 6, a third if needed) under a
' question in row 16; Lk: 1 take 2 drop 3 cast 4 use 5 trade 6 buy
' 7 magic 8 swipe 9 a way
sub MenuList(u8 Lk):
  for J = 16 to 22
    fill 32 count 31 at 1,J
  next
  if Lk = 1 then print at 2,16, "TAKE WHICH?"
  if Lk = 2 then print at 2,16, "DROP WHICH?"
  if Lk = 3 then print at 2,16, "CAST WHICH SPELL?"
  if Lk = 4 then print at 2,16, "USE WHICH?"
  if Lk = 5 then print at 2,16, "THE TRADING POST:"
  if Lk = 6 then print at 2,16, "BUY WHICH?"
  if Lk = 7 then print at 2,16, "LEARN WHICH?"
  if Lk = 8 then print at 2,16, "SWIPE WHICH?"
  if Lk = 9 then print at 2,16, "WHICH WAY?"
  for K = 0 to MN - 1
    X = K / 6
    Y = K % 6
    X = X * 15
    X = X + 2
    Y = Y + 17
    PutStr(OptT[K], OptI[K], X, Y, 0)
  next
  MRows = 6
  MX0 = 2
  MXs = 15
  MY0 = 17
  MKind = Lk
  Sel = 0
  Idle = 2
  Pick
  Idle = 0
  ClearMsg
  DrawMenu
  return
end sub

' the price shown at the trading post
sub ShowPrice:
  if MKind < 6 then return
  fill 32 count 12 at 19,16
  V = Sel + 1
  if MKind > 7 then return
  W = MN - 1
  if Sel = W then return
  if MKind = 6 then
    NumU = V * 200
  else
    NumU = V * 100
  end if
  print NumU at 19,16 width 4
  print at 24,16, "GOLD"
  return
end sub

' moves the flame with the stick until a button: Sel the choice (the right
' button in a list takes the last choice, "nothing")
sub Pick:
  PutCursor
  ShowPrice
  WasB = 1
  WasStk = 1
pk_loop:
  Frame1
  AnimTick
  ReadPad
  if P2 = 1 then
    if MKind > 0 then
      Sel = MN - 1
      play sound SndPick
      return
    end if
  end if
  if P1 = 1 then
    play sound SndPick
    return
  end if
  if P2 = 1 then
    play sound SndPick
    return
  end if
  if Stk = 0 then goto pk_loop
  if WasStk = 1 then
    inc Rep
    if Rep < 16 then goto pk_loop
    Rep = 8
  end if
  WasStk = 1
  X = Sel / MRows
  Y = Sel % MRows
  if Up1 = 1 then
    if Y > 0 then dec Y
  elseif Dn1 = 1 then
    V = Y + 1
    W = X * MRows
    W = W + V
    if V < MRows then
      if W < MN then Y = V
    end if
  elseif Lf1 = 1 then
    if X > 0 then dec X
  elseif Rt1 = 1 then
    V = X + 1
    W = V * MRows
    if W < MN then
      X = V
      W = W + Y
      if W >= MN then
        Y = MN - 1
        V = X * MRows
        Y = Y - V
      end if
    end if
  end if
  V = X * MRows
  V = V + Y
  if V <> Sel then
    Sel = V
    play sound SndTick
    PutCursor
    ShowPrice
  end if
  goto pk_loop
end sub

' two players: the controllers change hands
sub HandOver:
  for J = 18 to 22
    fill 32 count 31 at 1,J
  next
  set sprite 0 to 192,0,0,0
  update sprites
  play sound SndTurn
  if Z = 1 then
    print at 4,19, "PLAYER 1, YOUR TURN."
    print at 4,21, "PRESS A BUTTON ON"
    print at 4,22, "CONTROLLER 1."
  else
    print at 4,19, "PLAYER 2, YOUR TURN."
    print at 4,21, "PRESS A BUTTON ON"
    print at 4,22, "CONTROLLER 2."
  end if
  Idle = 3
  WaitPress
  Idle = 0
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub NewGame:
  for J = 0 to 185
    Dx[J] = ExitInit[J]
  next
  for J = 0 to 30
    Ob[J] = ObInit[J]
    Mo[J] = MoInit[J]
  next
  for J = 1 to 2
    Cp[J] = 20
    Lp[J] = 0
    Sp[J] = 256
    Gp[J] = 1000
    Hp[J] = 200
    Tp[J] = 0
    Bp[J] = 0
    Wp[J] = 5
    Qp[J] = 0
  next
  if Np = 1 then Cp[2] = 255
  Tr = 13795
  Z = 1
  Oz = 2
  Won = 0
  Winner = 0
  Turns = 0
  Rs = Seed
  return
end sub

sub GameScreen:
  NewScreen
  fill vram.name with sequence $00..$FF repeat 1
  fill $11 count 2048 to vram.color
  Scene = 255
  ClearMsg
  ShowScreen
  return
end sub

sub EndPage:
  NewScreen
  FontTop
  if Won = 2 then
    print at 2,4, "THE ADVENTURE IS ABANDONED."
    print at 2,7, "SIR GOMAR WAITS IN THE"
    print at 2,8, "FORTRESS OF FORGOTTEN DREAMS"
    print at 4,11, "PLEASE RETURN AGAIN TO"
    print at 4,12, "PLAY DARK FORTRESS II!"
  else
    if Winner = 1 then print at 8,2, "PLAYER 1 WINS !!!"
    if Winner = 2 then print at 8,2, "PLAYER 2 WINS !!!"
    print at 8,4, "CONGRATULATIONS!!!!"
    print at 2,7, "SIR GOMAR HAS BEEN RESCUED"
    print at 2,8, "FROM HIS KIDNAPPERS, AND THE"
    print at 2,9, "CROWN JEWELS HAVE BEEN"
    print at 2,10, "RETURNED!"
    print at 2,12, "YOU WERE KNIGHTED IN THE"
    print at 2,13, "NEW KING'S CHAMBERS,"
    if Np = 2 then
      if Winner = 1 then print at 2,14, "PLAYER 2 IS YOUR SQUIRE!!"
      if Winner = 2 then print at 2,14, "PLAYER 1 IS YOUR SQUIRE!!"
    end if
    print at 2,16, "PREPARE YOURSELF FOR THE"
    print at 2,17, "SEQUEL, DARK FORTRESS III..."
  end if
  print at 6,20, "TURNS"
  NumU = Turns
  print NumU at 12,20 width 5
  ShowScreen
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

sub TitlePage:
  NewScreen
  fill vram.name with sequence $00..$FF repeat 1
  decompress zx0 ScenePat[ScTitle] to vram.pattern
  decompress zx0 SceneCol[ScTitle] to vram.color
  Scene = 255
  print at 4,9, "BEYOND THE COPPER MINES"
  print at 2,11, "FIND THE TOPAZ, RUBY AND"
  print at 2,12, "SAPPHIRE, RESCUE SIR GOMAR"
  print at 2,13, "AND LAY THEM ALL IN THE"
  print at 2,14, "TROPHY CASE TO WIN."
  print at 11,16, "ONE PLAYER"
  print at 11,17, "TWO PLAYERS"
  print at 11,18, "CREDITS"
  print at 4,21, "STICK AND BUTTON TO CHOOSE"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TitleLen
  TzOn = 1
  MN = 3
  MRows = 3
  MX0 = 11
  MXs = 8
  MY0 = 16
  MKind = 0
  Np = 0
  Sel = 0
  Pz = 0
  W16 = 0
  PutCursor
  WasB = 1
  WasStk = 1
  Idle = 5
tp_loop:
  Frame1
  inc W16
  ReadPad
  if Stk = 1 then
    if WasStk = 0 then
      WasStk = 1
      if Up1 = 1 then
        if Sel > 0 then dec Sel
      end if
      if Dn1 = 1 then
        if Sel < 2 then inc Sel
      end if
      play sound SndTick
      PutCursor
    end if
  end if
  V = P1 | P2
  if V = 0 then goto tp_loop
  Idle = 0
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  Seed = W16 * 251
  Seed = Seed ^ $5A3C
  if Seed = 0 then Seed = 1
  if Sel = 2 then
    CreditsPage
    Np = 0
  else
    Np = Sel + 1
  end if
  return
end sub

sub CreditsPage:
  NewScreen
  FontTop
  print at 7,2, "DARK FORTRESS II"
  print at 4,3, "BEYOND THE COPPER MINES"
  print at 2,5, "BASED ON DARK FORTRESS II BY"
  print at 2,6, "CLEVE BLAKEMORE, AHOY!"
  print at 2,7, "FEBRUARY 1988 (C-128 BASIC)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "MUSIC: BEYOND THE MINES,"
  print at 2,17, "UNDERWORLD TIDE"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

' the stick and buttons of the player whose turn it is (either controller
' with one player or on the title)
sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  B1 = 0
  B2 = 0
  Pz = 0
  if Np = 2 then Pz = Z
  if Pz <> 2 then
    if joypad(1).up then Up1 = 1
    if joypad(1).down then Dn1 = 1
    if joypad(1).left then Lf1 = 1
    if joypad(1).right then Rt1 = 1
    if joypad(1).button1 then B1 = 1
    if joypad(1).button2 then B2 = 1
  end if
  if Pz <> 1 then
    if joypad(2).up then Up1 = 1
    if joypad(2).down then Dn1 = 1
    if joypad(2).left then Lf1 = 1
    if joypad(2).right then Rt1 = 1
    if joypad(2).button1 then B1 = 1
    if joypad(2).button2 then B2 = 1
  end if
  P1 = 0
  P2 = 0
  V = B1 | B2
  if V = 1 then
    if WasB = 0 then
      P1 = B1
      P2 = B2
    end if
  end if
  WasB = V
  Stk = Up1 | Dn1
  Stk = Stk | Lf1
  Stk = Stk | Rt1
  if Stk = 0 then
    WasStk = 0
    Rep = 0
  end if
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' a blank screen (display off): the font in the lower two thirds, the
' heading letters (yellow on dark red) in the middle third and the dim
' letters (dark blue) in the bottom third, both at codes 160-223
sub NewScreen:
  Busy = 1
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill full mode 2 text color with $F0
  for J = 0 to 15
    W16 = J
    W16 = W16 << 5
    A16 = W16 + 2304
    P = W16 + 3328
    copy vram.pattern + A16 count 32 to vram.pattern + P
    A16 = W16 + 4352
    P = W16 + 5376
    copy vram.pattern + A16 count 32 to vram.pattern + P
  next
  fill $B6 count 512 to vram.color + 3328
  fill $41 count 512 to vram.color + 5376
  cls
  return
end sub

' the font back in the top third (after a scene picture)
sub FontTop:
  for J = 0 to 63
    W16 = J
    W16 = W16 << 5
    A16 = W16 + 2048
    copy vram.pattern + A16 count 32 to vram.pattern + W16
  next
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Busy = 0
  return
end sub

