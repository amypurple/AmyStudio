record Actor:
  u16 Xf
  u16 Yf
  i16 Vx
  i16 Vy
  u8 St
  u16 Tm
  u8 HMode
  u8 VMode
  u8 Tgt
  u8 Face
  u8 Gnd
  u8 Thr
  u8 PX
  u8 PY
  u8 Dir
end record

Actor Act[MaxAct]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
i16 EnHi = 12
i16 EnLo = -12
i16 EnHiY = 14
i16 EnLoY = -14
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
bcd digits 6 NextLife = 5000
' the actor being moved: position in pixels, old position, speeds
u8 Px = 0
u8 Py = 0
u8 Ox = 0
u8 Oy = 0
u16 CeilF = 256
u16 Ax = 0
u16 Ay = 0
i16 Avx = 0
i16 Avy = 0
u8 AGnd = 0
u8 NAct = 2
u8 Wave = 0
u8 Left = 0
u8 Lives = 2
u8 Over = 0
u8 Phase = 0
u16 PhT = 0
u8 EnMax = 12
u8 EnMaxY = 14
' a height plan above this random number makes a genie go for the player
u8 SeekAt = 216
u8 Bottled = 0
u8 Grabbed = 0
u8 Deaths = 0
u8 Bumps = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' title animation
u8 TgX = 40
' loop counters (never shared with helpers)
u8 Ai = 0
u8 Bi = 0
u8 Ds = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 R8 = 0
u8 Hit = 0
u8 Sb = 0
u8 St = 0
u8 Pat = 0

  tile screen
  set sound table BgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  print at 9,9, "             "
  print at 9,10, "  GAME OVER  "
  print at 9,11, "             "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift, one byte out
function Rnd as u8
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return Rs & 255

' the absolute difference of two pixel positions
function Dist(u8 A, u8 B) as u8
  u8 D = 0
  if A > B then
    D = A - B
  else
    D = B - A
  end if
  return D

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  select case Phase
    case 0
      ' "WAVE n" on screen; the genies appear when it goes
      dec PhT
      if PhT = 0 then StartWave
    case 1
      MovePlayer
      for Ai = 1 to MaxAct - 1
        if Ai < NAct then MoveEnemy
      next
      Contacts
      if Left = 0 then
        Phase = 2
        PhT = 90
      end if
    case 2
      MovePlayer
      dec PhT
      if PhT = 0 then NextWave
  end select
  return
end sub

' ---------------------------------------------------------------------------
' the player: fly, wait to come back, or the puff after a loss
sub MovePlayer:
  select case Act[0].St
    case StFly
      LoadActor(0)
      if Btn > 0 then
        Avy = Avy - Flap
        Act[0].Thr = 1
      else
        Avy = Avy + Grav
        Act[0].Thr = 0
      end if
      K = J1 & 12
      if K = 4 then
        Avx = Avx - 1
        Act[0].Face = 1
      end if
      if K = 8 then
        Avx = Avx + 1
        Act[0].Face = 0
      end if
      if K = 0 then Friction
      CeilF = YMin * 16
      clamp Avx between -PMaxX and PMaxX
      clamp Avy between -PMaxY and PMaxY
      Physics
      SaveActor(0)
    case StWait
      dec Act[0].Tm
      V = J1 & 28
      if V > 0 then Act[0].Tm = 0
      if Act[0].Tm = 0 then Act[0].St = StFly
    case StPuff
      dec Act[0].Tm
      if Act[0].Tm = 0 then AfterLoss
  end select
  return
end sub

sub AfterLoss:
  if Lives = 0 then
    Over = 1
  else
    dec Lives
    ShowLives
    PlacePlayer
  end if
  return
end sub

' the player waits at the bottom middle, safe, until a press (or 100 frames)
sub PlacePlayer:
  Act[0].Xf = 120 * 16
  Act[0].Yf = YMax * 16
  Act[0].PX = 120
  Act[0].PY = YMax
  Act[0].Vx = 0
  Act[0].Vy = 0
  Act[0].St = StWait
  Act[0].Tm = 100
  Act[0].Face = 0
  Act[0].Gnd = 1
  Act[0].Thr = 0
  return
end sub

' slows a rug standing on something when the stick is let go
sub Friction:
  if AGnd = 0 then return
  if Avx > 0 then
    dec Avx
  else
    if Avx < 0 then inc Avx
  end if
  return
end sub

' ---------------------------------------------------------------------------
' a bad genie: its plan, then the same flying as the player
sub MoveEnemy:
  with Act[Ai] as E
    select case E.St
      case StFly
        ' each genie thinks every fourth frame
        V = Ai + Tick
        V = V & 3
        if V = 0 then Think
        Ax = E.Xf
        Ay = E.Yf
        Ox = E.PX
        Oy = E.PY
        Avx = E.Vx
        Avy = E.Vy
        if E.Thr = 1 then
          Avy = Avy - Flap
        else
          Avy = Avy + Grav
        end if
        V = Tick & 1
        if V = 0 then
          if E.HMode <> 3 then
            if E.Dir = 1 then
              Avx = Avx - 1
            else
              Avx = Avx + 1
            end if
          end if
        end if
        if Avx > EnHi then Avx = EnHi
        if Avx < EnLo then Avx = EnLo
        if Avy > EnHiY then Avy = EnHiY
        if Avy < EnLoY then Avy = EnLoY
        CeilF = ECeil * 16
        Physics
        E.Xf = Ax
        E.Yf = Ay
        E.Vx = Avx
        E.Vy = Avy
        E.PX = Px
        E.PY = Py
        if Avx < 0 then
          E.Face = 1
        else
          if Avx > 0 then E.Face = 0
        end if
      case StBottle
        BottleFall
        dec E.Tm
        if E.Tm = 0 then
          E.St = StSmoke
          E.Tm = 100
          play sound SndFree
        end if
      case StSmoke
        BottleFall
        dec E.Tm
        if E.Tm = 0 then GetFree
    end select
  end with
  return
end sub

' a bottle falls until it lands
sub BottleFall:
  LoadActor(Ai)
  CeilF = ECeil * 16
  Avx = 0
  Avy = Avy + Grav
  if Avy > PMaxY then Avy = PMaxY
  Physics
  SaveActor(Ai)
  return
end sub

' the genie gets out of its bottle and flies off
sub GetFree:
  with Act[Ai] as E
    E.St = StFly
    E.Vy = -20
    R8 = Rnd()
    V = R8 & 1
    E.Face = V
    E.Dir = V
    if V = 1 then
      E.Vx = -8
    else
      E.Vx = 8
    end if
    E.HMode = 0
    E.VMode = 0
    E.Tgt = 40
  end with
  return
end sub

' a bad genie's plan: every 32 frames left/right, every 128 the height
sub Think:
  with Act[Ai] as E
    X = E.PX
    Y = E.PY
    Px = Act[0].PX
    Py = Act[0].PY
    V = Tick >> 2
    V = V + Ai * 2
    K = V & 7
    if K = 0 then
      R8 = Rnd()
      E.HMode = R8 & 3
      select case E.HMode
        case 1
          ' chase
          if Px < X then
            E.Dir = 1
          else
            E.Dir = 0
          end if
        case 2
          ' flee
          if Px < X then
            E.Dir = 0
          else
            E.Dir = 1
          end if
      end select
    end if
    K = V & 31
    if K = 0 then
      R8 = Rnd()
      if R8 >= SeekAt then
        E.VMode = 1
      else
        E.VMode = 0
        E.Tgt = (R8 & 127) + 40
        if E.Tgt > 150 then E.Tgt = 150
      end if
    end if
    ' below the player and close: turn away from it
    if Act[0].St = StFly then
      if Y > Py then
        if Dist(X, Px) < 40 then
          V = Y - Py
          if V < 32 then
            if Px < X then
              E.Dir = 0
            else
              E.Dir = 1
            end if
            if E.HMode = 3 then E.HMode = 2
          end if
        end if
      end if
    end if
    ' height: get above the player, or hover near a chosen height
    ' (the player's height is looked at only every 32 frames)
    K = V & 7
    if K = 0 then
      if E.VMode = 1 then
        W16 = Py
        if W16 < 28 then W16 = 28
        if Act[0].St <> StFly then W16 = 72
        E.Tgt = W16 - 12
      end if
    end if
    E.Thr = 0
    if Y > E.Tgt then E.Thr = 1
    if Y > 150 then E.Thr = 1
  end with
  return
end sub

' ---------------------------------------------------------------------------
' moving: actor I's fields to the scratch and back
sub LoadActor(u8 I):
  with Act[I] as A
    Ax = A.Xf
    Ay = A.Yf
    Ox = A.PX
    Oy = A.PY
    Avx = A.Vx
    Avy = A.Vy
    AGnd = A.Gnd
  end with
  return
end sub

sub SaveActor(u8 I):
  with Act[I] as A
    A.Xf = Ax
    A.Yf = Ay
    A.PX = Px
    A.PY = Py
    A.Vx = Avx
    A.Vy = Avy
    A.Gnd = AGnd
    if Avx < 0 then A.Face = 1
    if Avx > 0 then A.Face = 0
  end with
  return
end sub

' one step: speed added, walls, ceiling, street, arcades (Ox, Oy: where
' the actor was, in pixels)
sub Physics:
  Ax = Ax + Avx
  Ay = Ay + Avy
  Px = Ax >> 4
  Py = Ay >> 4
  AGnd = 0
  Hit = 0
  ' the sides: bounce
  if Ax < XMin * 16 then
    Ax = XMin * 16
    Avx = -Avx
    Hit = 1
  end if
  if Ax > XMax * 16 then
    Ax = XMax * 16
    Avx = -Avx
    Hit = 1
  end if
  ' the ceiling pushes down, the street holds
  if Ay < CeilF then
    Ay = CeilF
    Avy = 8
    Hit = 1
  end if
  if Ay >= YMax * 16 then
    Ay = YMax * 16
    if Avy > 0 then Avy = 0
    AGnd = 1
    Hit = 1
  end if
  if Hit = 1 then
    Px = Ax >> 4
    Py = Ay >> 4
  end if
  ' only the arcades at this height (tops 56, 96, 136)
  select case Py
    case 41 to 63
      Ledge(56, 16, 71)
      Ledge(56, 184, 239)
    case 81 to 103
      Ledge(96, 88, 167)
    case 121 to 143
      Ledge(136, 16, 71)
      Ledge(136, 184, 239)
  end select
  return
end sub

' the arcade L against the moved actor
sub Ledge(u8 T, u8 Lx, u8 Rx):
  if Px + 13 >= Lx then
    if Px + 2 <= Rx then
      if Py + 15 >= T then
        if Py <= T + 7 then
          if Oy + 15 < T then
            ' from above: land on it
            Py = T - 16
            Ay = Py * 16
            if Avy > 0 then Avy = 0
            AGnd = 1
          else
            if Oy > T + 7 then
              ' from below: bump the head, fall back
              Py = T + 8
              Ay = Py * 16
              if Avy < 0 then Avy = -Avy
              Avy = Avy >> 1
            else
              ' from the side: bounce back
              Px = Ox
              Ax = Px * 16
              Avx = -Avx
            end if
          end if
        end if
      end if
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' touching: the player against every genie and bottle
sub Contacts:
  if Act[0].St <> StFly then return
  Px = Act[0].PX
  Py = Act[0].PY
  for Ai = 1 to MaxAct - 1
    if Ai < NAct then Touch
  next
  return
end sub

sub Touch:
  with Act[Ai] as T
    X = T.PX
    Y = T.PY
    if X + 12 <= Px then return
    if Px + 12 <= X then return
    if Y + 12 <= Py then return
    if Py + 12 <= Y then return
    select case T.St
      case StFly
        Joust
      case StBottle, StSmoke
        ' a bottle still dropping from the rug can't be caught yet
        W16 = BotTime[Ai] - 15
        if T.Tm > W16 then return
        T.St = StGone
        dec Left
        inc Grabbed
        AddScore
        play sound SndGrab
    end select
  end with
  return
end sub

' the higher genie wins; nearly level, both bounce apart
sub Joust:
  if Py + 3 <= Y then
    Act[Ai].St = StBottle
    Act[Ai].Tm = BotTime[Ai]
    Act[Ai].Vx = 0
    Act[Ai].Vy = 0
    Act[0].Vy = -10
    inc Bottled
    play sound SndBottle
    return
  end if
  if Y + 3 <= Py then
    Act[0].St = StPuff
    Act[0].Tm = 60
    inc Deaths
    play sound SndHit
    return
  end if
  ' a bump: push apart sideways
  inc Bumps
  if X < Px then
    Act[Ai].Vx = -16
    Act[0].Vx = 16
  else
    Act[Ai].Vx = 16
    Act[0].Vx = -16
  end if
  play sound SndBump
  return
end sub

sub AddScore:
  Score += 250
  if Score > Hi then Hi = Score
  if Score >= NextLife then
    NextLife += 5000
    if Lives < 7 then
      inc Lives
      ShowLives
      play sound SndLife
    end if
  end if
  ShowScore
  return
end sub

' ---------------------------------------------------------------------------
' waves
sub NextWave:
  inc Wave
  W16 = Wave + 3
  W16 = W16 >> 1
  if W16 > MaxAct then W16 = MaxAct
  NAct = W16
  Left = NAct - 1
  V = Wave * 2
  V = V + 10
  if V > 24 then V = 24
  EnMax = V
  V = Wave + 10
  if V > 22 then V = 22
  EnMaxY = V
  V = Wave * 8
  if V > 96 then V = 96
  SeekAt = 224 - V
  EnHi = EnMax
  EnLo = -EnHi
  EnHiY = EnMaxY
  EnLoY = -EnHiY
  for Ds = 1 to MaxAct - 1
    Act[Ds].St = StOff
  next
  ShowWave
  print at 12,4, "WAVE "
  NumU = Wave
  print at 17,4, digits$(NumU, 2)
  play sound SndWave
  Phase = 0
  PhT = 100
  return
end sub

sub StartWave:
  copy GameMap + 128 count 32 to vram.name + 128
  for Ds = 1 to MaxAct - 1
    if Ds < NAct then Spawn(Ds)
  next
  Phase = 1
  return
end sub

' a new genie at one of the five places, not on top of another one
sub Spawn(u8 I):
  u8 Tries = 0
  u8 P = 0
  Tries = 0
  Hit = 1
  while Hit = 1
    R8 = Rnd()
    P = R8 & 7
    if P < 4 then
      P = 0
    else
      P = P - 3
    end if
    X = SpX[P]
    Y = SpY[P]
    Hit = 0
    for Bi = 0 to MaxAct - 1
      if Bi <> I then
        if Act[Bi].St = StFly then
          C = Act[Bi].PX
          if Dist(C, X) < 20 then
            C = Act[Bi].PY
            if Dist(C, Y) < 20 then Hit = 1
          end if
        end if
      end if
    next
    inc Tries
    if Tries >= 8 then Hit = 0
  end while
  Act[I].Xf = X * 16
  Act[I].Yf = Y * 16
  Act[I].PX = X
  Act[I].PY = Y
  Act[I].St = StFly
  Act[I].Vy = 4
  R8 = Rnd()
  if R8 >= 128 then
    Act[I].Vx = -8
    Act[I].Face = 1
    Act[I].Dir = 1
  else
    Act[I].Vx = 8
    Act[I].Face = 0
    Act[I].Dir = 0
  end if
  Act[I].HMode = 0
  Act[I].VMode = 0
  Act[I].Tgt = Y
  Act[I].Gnd = 0
  Act[I].Thr = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprites 0-1 the player (body, rug), 2k and 2k+1 genie k
sub DrawSprites:
  for Ds = 0 to MaxAct - 1
    DrawActor
  next
  update sprites
  return
end sub

sub DrawActor:
  with Act[Ds] as A
    Sb = Ds * 2
    St = A.St
    X = A.PX
    Y = A.PY
    Y = Y - 1
    if Ds >= NAct then St = StOff
    if St = StWait then
      ' blinking while waiting: 3 times a second
      V = Tick & 16
      if V > 0 then St = StOff
    end if
    select case St
      case StFly, StWait
        Pat = A.Face * 8
        Pat = Pat + SGr0
        if A.Thr = 1 then
          V = Tick & 8
          if V > 0 then Pat = Pat + 4
        end if
        set sprite Sb to Y,X,Pat,BodyCol[Ds]
        V = Tick >> 3
        V = V + Ds
        V = V & 1
        Pat = V * 4
        Pat = Pat + SRug0
        set sprite Sb + 1 to Y,X,Pat,RugCol[Ds]
      case StBottle, StSmoke
        Pat = SBot0
        if St = StSmoke then
          V = Tick & 16
          if V > 0 then Pat = SBot1
        end if
        set sprite Sb to Y,X,Pat,15
        set sprite Sb + 1 to Y,X,SCork,6
      case StPuff
        set sprite Sb to Y,X,SPuff,15
        set sprite Sb + 1 to 192,0,0,0
      case else
        set sprite Sb to 192,0,0,0
        set sprite Sb + 1 to 192,0,0,0
    end select
  end with
  return
end sub

sub ShowScore:
  print at 2,1, Score
  print at 21,1, "HI"
  print at 24,1, Hi
  return
end sub

sub ShowLives:
  fill 32 count 7 at 9,1
  if Lives = 0 then return
  for Ds = 1 to Lives
    put char TLife at Ds + 8,1
  next
  return
end sub

sub ShowWave:
  NumU = Wave
  print at 17,1, "W", digits$(NumU, 2)
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  Score = 0
  NextLife = 5000
  Lives = 2
  Wave = 0
  Over = 0
  Bottled = 0
  Grabbed = 0
  Deaths = 0
  Bumps = 0
  for Ds = 0 to MaxAct - 1
    Act[Ds].St = StOff
  next
  PlacePlayer
  ShowScore
  ShowLives
  NextWave
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BAGDAD in gold over the night sky, an arcade, a genie flying
' to and fro, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  print at 4,1, "COMPUTE!'S GAZETTE 11/84"
  copy TitleMap count 224 to vram.name + 64
  fill TArc count 16 at 8,12
  put char TArcL at 8,12
  put char TArcR at 23,12
  print at 7,15, "BY KEVIN MARTIN"
  print at 8,16, "AND BRYAN FILES"
  print at 13,19, "START"
  print at 13,20, "CREDITS"
  if Hi > 0 then
    print at 9,22, "HI ", Hi
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the good genie flies over the title's arcade
sub TitleAnim:
  V = Tick & 1
  if V = 0 then inc TgX
  if TgX > 232 then TgX = 8
  V = Tick >> 3
  V = V & 1
  K = V * 4
  set sprite 0 to 79,TgX,SGr0 + K,3
  set sprite 1 to 79,TgX,SRug0 + K,13
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,19
  put char 32 at 11,20
  J = Menu + 19
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "BAGDAD"
  print at 2,5, "BASED ON BAGDAD BY KEVIN"
  print at 2,6, "MARTIN AND BRYAN FILES,"
  print at 2,7, "COMPUTE!'S GAZETTE NOVEMBER"
  print at 2,8, "1984 (COMMODORE 64 MACHINE"
  print at 2,9, "LANGUAGE AND VIC-20)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: NIGHT FLIGHT"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

