' kick spans: first and last pixel of each row (ball 7 rows, men 16)
data BallL bytes 2,1,0,0,0,1,3
data BallR bytes 7,10,11,11,11,10,8
data RedL bytes 4,4,4,5,5,0,0,1,1,2,4,4,3,3,3,4
data RedR bytes 9,9,9,8,8,13,13,12,12,11,9,9,10,10,10,9
data BluL bytes 4,3,3,3,4,4,2,1,1,0,0,5,5,4,4,4
data BluR bytes 9,10,10,10,9,9,11,12,12,13,13,8,8,9,9,9

record Side:
  u8 Sel
  u8 Tmr
  u8 Vis
  u8 Sc
  u8 J
  u8 Shown
end record
Side Sd[2]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W = 0
u16 A0 = 0
u16 A1 = 0
u16 NumU = 0
' the ball: position, fractions, speeds, directions (DY 1 down, DX 1 right),
' friction counters
u8 BY = 143
u8 BX = 183
u8 FY = 0
u8 FX = 0
u8 SY = 0
u8 SX = 0
u8 DY = 0
u8 DX = 0
u8 FrY = 0
u8 FrX = 0
u8 TickC = 20
u8 Mask = $3F
u8 RodP[6]
u8 Dirty = 0
u8 GoalT = 0
u8 Scorer = 0
u8 Over = 0
u8 Players = 1
u8 SpdSel = 1
' the computer's skill: 0 EASY, 1 NORMAL, 2 HARD
u8 Skill = 1
u8 CpuN = 0
' EASY: 1 when the computer skips its swings until its next look
u8 CSkip = 0
u8 Kicks = 0
u8 Bounces = 0
' the computer's view of the ball (late)
u8 CpuT = 0
u8 CBX = 183
u8 CBY = 143
u8 CRd = 2
u8 CWant = 3
u8 CBest = 255
u8 CErr = 255
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Lp = 0
u8 Pl = 0
u8 Dr = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 R = 0
u8 Hit = 0
u8 ManX = 0
u8 ManY = 0

  tile screen
  set sound table KkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 4 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  StepFrame
  DrawAll
  if Over = 0 then goto play_loop

  ' the end: who won, GAME OVER, then back to the title on a press
  print at 9,10, "             "
  if Sd[0].Sc >= Win then
    print at 9,11, "  BLUE WINS  "
  else
    print at 9,11, "  RED WINS   "
  end if
  print at 9,12, "  GAME OVER  "
  print at 9,13, "             "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame: the goal's pause, or LPF passes of the C64's loop and a kick test
sub StepFrame:
  if GoalT > 0 then
    dec GoalT
    if GoalT = 0 then EndGoal
    return
  end if
  Lp = 0
  while Lp < LPF
    Pass
    inc Lp
    if GoalT > 0 then Lp = LPF
  end while
  if GoalT = 0 then Collide
  return
end sub

' one pass of the C64's main loop
sub Pass:
  W = FY + SY
  FY = W & 255
  if W > 255 then MoveY
  if GoalT > 0 then return
  W = FX + SX
  FX = W & 255
  if W > 255 then MoveX
  if SY >= 2 then
    if FrY = 0 then dec SY
    dec FrY
  end if
  if SX >= 2 then
    if FrX = 0 then dec SX
    dec FrX
  end if
  dec TickC
  if TickC = 0 then
    TickC = TickN
    for Pl = 0 to 1
      ReadSide(Pl)
    next
  end if
  return
end sub

function Halve(u8 S) as u8
  S = S >> 1
  return S | 1

sub MoveY:
  if DY = 1 then
    if BY = YBot then
      play sound SndWall
      if BX >= GoalL then
        if BX <= GoalR then
          Goal(0)
          return
        end if
      end if
      DY = 0
      SY = Halve(SY)
      inc Bounces
      dec BY
    else
      inc BY
    end if
  else
    if BY = YTop then
      play sound SndWall
      if BX >= GoalL then
        if BX <= GoalR then
          Goal(1)
          return
        end if
      end if
      DY = 1
      SY = Halve(SY)
      inc Bounces
      inc BY
    else
      dec BY
    end if
  end if
  return
end sub

sub MoveX:
  select case (DX, BX)
  case (1, XRight)
    DX = 0
    SX = Halve(SX)
    play sound SndWall
    dec BX
  case (1, 0 to 254)
    inc BX
  case (0, XLeft)
    DX = 1
    SX = Halve(SX)
    play sound SndWall
    inc BX
  case else
    dec BX
  end select
  return
end sub

sub Goal(u8 P):
  Sd[P].Sc = Sd[P].Sc + 1
  Scorer = P
  GoalT = GoalFr
  play sound SndGoal
  ShowScore
  return
end sub

sub EndGoal:
  if Sd[Scorer].Sc >= Win then
    Over = 1
  else
    BY = RestY
    BX = RestX
    SY = 0
    SX = 0
  end if
  return
end sub

' the stick of one side, read every 20 passes (C64 $0B04-$0BBA)
sub ReadSide(u8 P):
  J = Sd[P].J
  K = J & 16
  if K > 0 then
    Sd[P].Vis = 1
    if Sd[P].Tmr > 0 then Sd[P].Tmr = Sd[P].Tmr - 1
  else
    Sd[P].Tmr = 4
    Sd[P].Vis = 0
  end if
  R = 2
  K = J & 1
  if K > 0 then
    R = 0
  else
    K = J & 2
    if K > 0 then R = 4
  end if
  R = R + P
  Sd[P].Sel = R
  V = RodP[R]
  K = J & 4
  if K > 0 then
    if V > 0 then dec V
  else
    K = J & 8
    if K > 0 then
      if V < 6 then inc V
    end if
  end if
  if V <> RodP[R] then
    RodP[R] = V
    Dirty = Dirty | Bit[R]
  end if
  return
end sub

' the kick test: the swinging men of each side against the ball
sub Collide:
  Hit = 0
  if Sd[0].Vis = 1 then
    if RodHit(Sd[0].Sel, 0) = 1 then Hit = 1
  end if
  if Hit = 0 then
    if Sd[1].Vis = 1 then
      if RodHit(Sd[1].Sel, 1) = 1 then Hit = 2
    end if
  end if
  if Hit = 1 then
    if Sd[0].Tmr > 0 then Kick(1)
  end if
  if Hit = 2 then
    if Sd[1].Tmr > 0 then Kick(0)
  end if
  return
end sub

' 1 when a man of rod Rd (side P) touches the ball
function RodHit(u8 Rd, u8 P) as u8
  u8 M = 0
  u8 Got = 0
  ManY = RodY[Rd]
  if P = 0 then ManY = ManY + 4
  for M = 0 to 2
    ManX = RodP[Rd] * 8 + 117 + M * 40
    if ManHit(P) = 1 then Got = 1
  next
  return Got

' the ball's rows against the man at ManX, ManY (side P), row by row; Off
' is the man's X less the ball's, plus 16, so every test stays in bytes
function ManHit(u8 P) as u8
  u8 Lo = 0
  u8 Hi = 0
  u8 Rw = 0
  u8 Br = 0
  u8 Mr = 0
  u8 Res = 0
  u8 Off = 0
  u16 BxW = 0
  u16 MxW = 0
  BxW = BX
  MxW = ManX
  Lo = BY
  if ManY > Lo then Lo = ManY
  Hi = BY + 6
  if ManY + 15 < Hi then Hi = ManY + 15
  if BxW + 11 < MxW then Lo = 255
  if MxW + 13 < BxW then Lo = 255
  if Lo <= Hi then
    MxW = MxW + 16
    MxW = MxW - BxW
    Off = MxW
    for Rw = Lo to Hi
      Br = Rw - BY
      Mr = Rw - ManY
      if P = 0 then
        if BallL[Br] + 16 <= Off + BluR[Mr] then
          if Off + BluL[Mr] <= BallR[Br] + 16 then Res = 1
        end if
      else
        if BallL[Br] + 16 <= Off + RedR[Mr] then
          if Off + RedL[Mr] <= BallR[Br] + 16 then Res = 1
        end if
      end if
    next
  end if
  return Res

sub Kick(u8 Dn):
  SY = Mask
  Rand
  SX = Rs & Mask
  DY = Dn
  Rand
  DX = Rs & 1
  inc Kicks
  play sound SndKick
  return
end sub

sub Rand:
  W = Rs << 7
  Rs = Rs ^ W
  W = Rs >> 9
  Rs = Rs ^ W
  W = Rs << 8
  Rs = Rs ^ W
  return
end sub

' ---------------------------------------------------------------------------
' the computer plays blue: the rod nearest the ball (as it last saw it: SkLag frames
' ago), the slide that brings a man under it, a swing when it is close
sub CpuThink:
  inc CpuT
  if CpuT >= SkLag[Skill] then
    CpuT = 0
    CBX = BX
    CBY = BY
    CpuAim
    CSkip = 0
    if Skill = 0 then
      V = Tick & 3
      if V = 0 then CSkip = 1
    end if
  end if
  J = 0
  if CRd = 0 then J = 1
  if CRd = 4 then J = 2
  if CWant < RodP[CRd] then J = J | 4
  if CWant > RodP[CRd] then J = J | 8
  if CBest < SkNear[Skill] then
    if CErr < SkAim[Skill] then
      K = 1
      if Sd[0].Vis = 1 then
        if Sd[0].Tmr = 0 then K = 0
      end if
      if CSkip = 1 then K = 0
      if K = 1 then J = J | 16
    end if
  end if
  Sd[0].J = J
  return
end sub

' what the computer aims at (every SkLag frames): its rod nearest the ball and
' the slide that puts a man's middle nearest the ball's middle
sub CpuAim:
  u8 Q = 0
  u8 D = 0
  u8 Ps = 0
  u8 Cy = 0
  u8 Cx = 0
  u8 Mc = 0
  u8 Base = 0
  CBest = 255
  CErr = 255
  CRd = 2
  CWant = 3
  Cy = CBY + 3
  for Q = 0 to 4 step 2
    C = RodY[Q] + 12
    if C > Cy then
      D = C - Cy
    else
      D = Cy - C
    end if
    if D < CBest then
      CBest = D
      CRd = Q
    end if
  next
  if Skill = 0 then
    inc CpuN
    if CpuN >= 4 then
      CpuN = 0
      if CRd = 4 then
        CRd = 2
      else
        CRd = CRd + 2
      end if
    end if
  end if
  Cx = CBX + 6
  Base = 124
  for Ps = 0 to 6
    Mc = Base
    for Q = 0 to 2
      if Mc > Cx then
        D = Mc - Cx
      else
        D = Cx - Mc
      end if
      if D < CErr then
        CErr = D
        CWant = Ps
      end if
      Mc = Mc + 40
    next
    Base = Base + 8
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing: C64 pixels to the screen (X - 64, Y - 50; rows are the C64's)
sub DrawAll:
  if Dirty > 0 then
    for Dr = 0 to 5
      K = Dirty & Bit[Dr]
      if K > 0 then DrawRod(Dr)
    next
    Dirty = 0
  end if
  for Pl = 0 to 1
    if Sd[Pl].Sel <> Sd[Pl].Shown then
      ShowMarker(Pl)
    end if
  next
  if GoalT > 0 then
    set sprite 0 to 192,0,0,0
    V = GoalT / 10
    V = V & 1
    LightNet(V)
  else
    Y = BY - 51
    X = BX - 64
    set sprite 0 to Y,X,SBall,11
  end if
  for Pl = 0 to 1
    DrawMen(Pl)
  next
  update sprites
  return
end sub

sub DrawMen(u8 P):
  u8 Rd = 0
  u8 Sp = 0
  u8 M = 0
  u8 Pat = 0
  u8 Col = 0
  Sp = P * 3 + 1
  Rd = Sd[P].Sel
  if Sd[P].Vis = 1 then
    Y = RodY[Rd] - 51
    if P = 0 then
      Y = Y + 4
      Pat = SManB
      Col = 5
    else
      Pat = SManR
      Col = 8
    end if
    for M = 0 to 2
      X = RodP[Rd] * 8 + 53 + M * 40
      set sprite Sp + M to Y,X,Pat,Col
    next
  else
    for M = 0 to 2
      set sprite Sp + M to 192,0,0,0
    next
  end if
  return
end sub

sub DrawRod(u8 Rd):
  Y = RodRow[Rd]
  fill TRod count 19 at 6,Y
  C = TManB
  K = Rd & 1
  if K = 1 then C = TManR
  X = RodP[Rd] + 7
  put char C at X,Y
  put char C at X + 5,Y
  put char C at X + 10,Y
  return
end sub

sub ShowMarker(u8 P):
  X = 4
  C = TArB
  if P = 1 then
    X = 26
    C = TArR
  end if
  Y = RodRow[Sd[P].Shown]
  put char 32 at X,Y
  Y = RodRow[Sd[P].Sel]
  put char C at X,Y
  Sd[P].Shown = Sd[P].Sel
  return
end sub

' the scorer's net: lit (L = 1) or dark
sub LightNet(u8 L):
  if Scorer = 0 then
    C = TNB
    if L = 1 then C = TNBlit
    fill C count 4 at 14,22
  else
    C = TNT
    if L = 1 then C = TNTlit
    fill C count 4 at 14,1
  end if
  return
end sub

sub ShowScore:
  NumU = Sd[0].Sc
  print at 3,4, digits$(NumU, 1)
  NumU = Sd[1].Sc
  print at 28,4, digits$(NumU, 1)
  return
end sub

sub NewGame:
  NewScreen
  copy FieldMap count 768 to vram.name
  print at 2,2, "BLU"
  print at 27,2, "RED"
  if Players = 1 then
    print at 2,6, "CPU"
    print at 27,6, "YOU"
  else
    print at 2,6, "P1"
    print at 27,6, "P2"
  end if
  Mask = MaskT[SpdSel]
  for Pl = 0 to 5
    RodP[Pl] = 3
  next
  for Pl = 0 to 1
    Sd[Pl].Sc = 0
    Sd[Pl].Tmr = 4
    Sd[Pl].Vis = 0
    Sd[Pl].J = 0
    Sd[Pl].Sel = Pl + 2
    Sd[Pl].Shown = Pl
  next
  BY = RestY
  BX = RestX
  SY = 0
  SX = 0
  FY = 0
  FX = 0
  FrY = 0
  FrX = 0
  DY = 0
  DX = 0
  TickC = TickN
  GoalT = 0
  Over = 0
  Kicks = 0
  Bounces = 0
  CpuT = 30
  CpuN = 0
  Dirty = 63
  ShowScore
  DrawAll
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

function PadBits(u8 N) as u8
  u8 B = 0
  if joypad(N).up then B = B | 1
  if joypad(N).down then B = B | 2
  if joypad(N).left then B = B | 4
  if joypad(N).right then B = B | 8
  if joypad(N).fire then B = B | 16
  return B

' controllers to sides: two players 1 = blue, 2 = red; one player 1 = red
sub ReadPad:
  J1 = PadBits(1)
  J2 = PadBits(2)
  if Players = 2 then
    Sd[0].J = J1
    Sd[1].J = J2
  else
    Sd[1].J = J1
    CpuThink
  end if
  K = J1 | J2
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: KICKER in green blocks, players, speed, START, CREDITS
sub TitlePage:
  NewScreen
  copy TitleMap count 160 to vram.name + 96
  print at 6,1, "COMPUTE!'S GAZETTE 1986"
  print at 4,10, "BY JOHN KRAUSE AND"
  print at 4,11, "MARK TUTTLE"
  Menu = 0
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  J1 = PadBits(1)
  J2 = PadBits(2)
  K = J1 | J2
  Btn = K & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = K & 15
  if V > 0 then
    if WasStick = 0 then MenuMove(V)
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W = Tick
  Rs = Rs ^ W
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 4 then CreditsPage
  return
end sub

' lines: 0 players, 1 speed, 2 computer skill, 3 start, 4 credits
sub MenuMove(u8 S):
  select case S
  case 1
    if Menu > 0 then dec Menu
  case 2
    if Menu < 4 then inc Menu
  case 4, 8
    if Menu = 0 then Players = 3 - Players
    if Menu = 1 then
      if S = 4 then
        if SpdSel > 0 then dec SpdSel
      else
        if SpdSel < 2 then inc SpdSel
      end if
    end if
    if Menu = 2 then
      if S = 4 then
        if Skill > 0 then dec Skill
      else
        if Skill < 2 then inc Skill
      end if
    end if
  end select
  ShowMenu
  return
end sub

sub ShowMenu:
  for J = 13 to 21 step 2
    put char 32 at 7,J
  next
  if Players = 1 then
    print at 9,13, "1 PLAYER  "
  else
    print at 9,13, "2 PLAYERS "
  end if
  select case SpdSel
  case 0
    print at 9,15, "SPEED SLOW  "
  case 1
    print at 9,15, "SPEED MEDIUM"
  case else
    print at 9,15, "SPEED FAST  "
  end select
  select case Skill
  case 0
    print at 9,17, "CPU EASY  "
  case 1
    print at 9,17, "CPU NORMAL"
  case else
    print at 9,17, "CPU HARD  "
  end select
  print at 9,19, "START"
  print at 9,21, "CREDITS"
  J = Menu * 2 + 13
  put char 62 at 7,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "KICKER"
  print at 2,5, "BASED ON KICKER BY JOHN"
  print at 2,6, "KRAUSE AND MARK TUTTLE,"
  print at 2,7, "COMPUTE!'S GAZETTE"
  print at 2,8, "FEBRUARY 1986 (COMMODORE 64"
  print at 2,9, "MACHINE LANGUAGE)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: ROD RALLY"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
KkKick:
    db $00,$00,$04,$02,$00,$00,$35,$03,$10
KkWall:
    db $00,$00,$35,$02,$00,$00,$65,$02,$10
KkGoal:
    db $40,$8F,$10,$05,$40,$FF,$F3,$05,$40,$8F,$10,$05,$40,$FF,$F3,$05,$40,$6B,$10,$0C,$50
KkStart:
    db $40,$D6,$20,$06,$40,$AA,$20,$06,$40,$8F,$20,$0C,$50
KkOver:
    db $40,$8F,$10,$0A,$40,$AA,$20,$0A,$40,$D6,$20,$0A,$40,$1D,$31,$1E,$50

KkSoundTable:
    dw KkTuneMel,$702B
    dw KkTuneBass,$7035
    dw KkKick,$703F
    dw KkWall,$703F
    dw KkGoal,$7049
    dw KkStart,$7049
    dw KkOver,$7049
; Rod Rally (original)
; Tiny Sound, 8 frames per step
KkTuneMel:
    db $44
    dw sndtiny_1
    db 8
    db $02,$60,$F1,$22,$1A,$01,$1E,$01,$21,$01,$1E,$01,$1A,$01,$1E,$01
    db $21,$01,$01,$1C,$01,$1F,$01,$23,$01,$1F,$01,$1C,$01,$21,$01,$25
    db $01,$01,$26,$01,$25,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01
    db $01,$1E,$01,$21,$01,$1C,$01,$19,$01,$1A,$01,$01,$01,$21,$01,$26
    db $01,$01,$00,$01
    db $FF
KkTuneBass:
    db $84
    dw sndtiny_2
    db 8
    db $02,$80,$18,$32,$0E,$01,$15,$01,$0E,$01,$15,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$10,$01,$17,$01,$10,$01,$17,$01,$15,$01,$10,$01
    db $15,$01,$10,$01,$13,$01,$1A,$01,$13,$01,$0E,$01,$0E,$15,$01,$17
    db $12,$01,$15,$01,$10,$01,$15,$01,$10,$01,$0E,$01,$01,$01,$15,$01
    db $0E,$01,$00,$01
    db $FF
}
