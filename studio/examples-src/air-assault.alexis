  $01,$01,$01,$0E,$02,$2B,$2B,$02
  $91,$E1,$E1,$E1,$02,$2B,$2B,$02
  $01,$12,$12,$12,$02,$2B,$2B,$02
  $01,$01,$01,$01,$61,$E1,$6E,$6E
  $0C,$2C,$0E,$01,$1B,$01,$0E,$2C
end data
data SpritePat bytes
  $00,$01,$01,$07,$09,$10,$10,$79,$10,$10,$09,$07,$01,$01,$00,$00
  $00,$00,$00,$C0,$20,$10,$10,$3C,$10,$10,$20,$C0,$00,$00,$00,$00
  $01,$03,$03,$03,$03,$03,$03,$01,$02,$06,$07,$00,$00,$00,$00,$00
  $80,$C0,$C0,$C0,$C0,$C0,$C0,$80,$40,$60,$E0,$00,$00,$00,$00,$00
  $00,$00,$30,$38,$3C,$3F,$7F,$3F,$07,$03,$01,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$FF,$FF,$FE,$E0,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$01,$09,$05,$03,$3F,$03,$05,$09,$01,$00,$00,$00,$00
