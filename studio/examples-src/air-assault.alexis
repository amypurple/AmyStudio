cartridge "AIR ASSAULT/BOB LLORET/1984"

' AIR ASSAULT
' A ColecoVision game based on "Air Assault" by Bob Lloret, Ahoy! May 1984
' (Commodore 64, BASIC; listing in orig/).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's, the game is built
' for the ColecoVision: smooth 16 x 16 sprites, a bomber that carries each
' bomb in, a tiled night city with lit windows, flak bursts, explosions,
' sound effects and an original title tune.
'
' The game: the enemy drops 40 bombs on your city, one at a time, from a
' random place at a random speed. Steer the gun sight over the sky above
' the city and fire: a flak burst that catches the bomb destroys it in the
' air. A bomb that gets through flattens three blocks of the city. After
' the 40th bomb (or when nothing is left standing) the results of the
' assault are shown: bombs dropped, deflected, direct hits, the damage
' (8 hits or more is total devastation), your score and the high score.
'
' From the original (orig/airasl.bas): 40 bombs, one at a time; a random
' column (X = 20..254 of the C64's sprite field, here the whole city) and a
' random speed of five (SP = 6..10 pixels a pass); the sight kept to the
' lower sky (Y 100..190, above the city); a bomb that is hit counts as
' deflected; a bomb that lands wrecks the three blocks round its column
' (both rows of the C64 city, here the whole building); the game ends
' after 40 bombs or when the city's last row is empty; the results screen
' with its two damage messages (8 direct hits or more); the high score.
'
' Liberties: the speeds are the C64's in pixels a second (about 10 BASIC
' passes a second, so 1 to 1.7 pixels a frame); the sight moves 2 pixels a
' frame (the C64's 7 a pass was too slow to reach most bombs). On the C64
' holding the button over a bomb was enough; here a press fires a flak
' burst that lasts 10 frames, then the gun reloads for 28 frames, so aiming
' matters. The listing's points by height (75 high, 30 middle, 10 low)
' never worked (Y was reset before the test, so every hit gave 30); here
' they do, by the height of the burst. A bomber flies in and releases each
' bomb (the C64 bomb just appeared at the top). The city is 28 buildings of
' 2 to 5 floors in five colours with random roofs instead of two rows of
' characters. The raid speeds up: every 8 bombs the five speeds move up a
' step, so the last 8 bombs fall up to 1.5 times faster (on the C64 the
' speed never changed). The screen flashes became explosions and sounds.
'
' Controls: either controller; the stick moves the sight, either button
' fires. On the title, up and down choose, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given (bug
' 25). Own xorshift random numbers (bug 36). Nothing flashes.

const TStar = 128
const TStar2 = 129
const TWall0 = 130
const TRoof0 = 131
const TAnt0 = 132
const TStep0 = 133
const TWall1 = 134
const TRoof1 = 135
const TAnt1 = 136
const TStep1 = 137
const TWall2 = 138
const TRoof2 = 139
const TAnt2 = 140
const TStep2 = 141
const TWall3 = 142
const TRoof3 = 143
const TAnt3 = 144
const TStep3 = 145
const TWall4 = 146
const TRoof4 = 147
const TAnt4 = 148
const TStep4 = 149
const TRubble = 150
const TGround = 151
const SSight = 0
const SBomb = 4
const SPlane = 8
const SFlak0 = 12
const SFlak1 = 16
const SBoom0 = 20
const SBoom1 = 24
const NTiles8 = 192
const SprBytes = 224
const SndTuneA = 1
const SndTuneB = 2
const SndDrop = 3
const SndFlak = 4
const SndPop = 5
const SndCrash = 6
const SndStart = 7
const SndOver = 8
const NBombs = 40
const NSpr = 5
const FlN = 10
const FcN = 28
const GapN = 40
const BoomN = 36
const CxMin = 8
const CxMax = 232
const CyMin = 48
const CyMax = 124
const DropY = 26
const PlaneY = 18

' bomb speeds in 1/16 pixel a frame (the listing's SP = 6..10 a pass,
' then four faster ones: every 8 bombs the five speeds move up one)
data SpdT bytes
  16, 19, 21, 24, 27, 30, 33, 36, 40
end data

' the bomb in play: state (0 gap, 1 bomber flying in, 2 falling, 3 burst
' in the air, 4 landed), column X (sprite corner), Y in 1/16 pixel, speed,
' a timer
record Raid:
  u8 St
  u8 X
  u16 Yf
  u8 Sp
  u8 Tm
end record
Raid Bm

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Sc = 0
u16 Hs = 0
bcd digits 5 Score = 0
bcd digits 5 Hi = 0
' the city: height (floors) and look of each column 2..29
u8 Ht[32]
u8 Cl[32]
u8 Rk[32]
' bombs dropped, deflected, direct hits
u8 Nb = 0
u8 Nt = 0
u8 Nh = 0
u8 Over = 0
' the sight, the flak burst (corner, frames left, reload), the bomber
u8 Cx = 120
u8 Cy = 90
u8 Fx = 0
u8 Fy = 0
u8 Fl = 0
u8 Fc = 0
u8 Pl = 0
u8 PlOn = 0
u8 Ex = 0
u8 Ey = 0
u8 By = 0
u8 TitleOn = 0
u8 Pg = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Ci = 0
u8 Ri = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 R = 0
u8 S = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table AaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the results of the assault, then back to the title
  mute all
  play sound SndOver
  Rearm
  wait 60 frames
  nmi off
  Results
  Pg = 3
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Pg = 0
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  MoveSight
  if Fc > 0 then dec Fc
  if Fl > 0 then dec Fl
  if Press = 1 then
    if Fc = 0 then
      Fl = FlN
      Fc = FcN
      Fx = Cx
      Fy = Cy
      play sound SndFlak
    end if
  end if
  if PlOn = 1 then
    Pl = Pl + 2
    if Pl >= 240 then PlOn = 0
  end if
  select case Bm.St
  case 0
    dec Bm.Tm
    if Bm.Tm = 0 then NextBomb
  case 1
    if Pl >= Bm.X then
      Bm.St = 2
      W16 = DropY
      Bm.Yf = W16 << 4
      play sound SndDrop
    end if
  case 2
    Fall
  case else
    dec Bm.Tm
    if Bm.Tm = 0 then
      Bm.St = 0
      Bm.Tm = GapN
      if Standing() = 0 then Over = 1
    end if
  end select
  return
end sub

sub MoveSight:
  K = J1 | J2
  V = K & 1
  if V > 0 then
    if Cy > CyMin then Cy = Cy - 2
  end if
  V = K & 2
  if V > 0 then
    if Cy < CyMax then Cy = Cy + 2
  end if
  V = K & 4
  if V > 0 then
    if Cx > CxMin then Cx = Cx - 2
  end if
  V = K & 8
  if V > 0 then
    if Cx < CxMax then Cx = Cx + 2
  end if
  return
end sub

' the next bomb (or the end after the 40th): a column and a speed
sub NextBomb:
  if Nb >= NBombs then
    Over = 1
    return
  end if
  inc Nb
  V = Roll(224)
  Bm.X = V + 8
  V = Nb - 1
  V = V >> 3
  Bm.Sp = Roll(5) + V
  Bm.St = 1
  Pl = 0
  PlOn = 1
  ShowHud
  return
end sub

' the bomb falls; a burst catches it, or it lands on the city
sub Fall:
  S = SpdT[Bm.Sp]
  W16 = S
  Bm.Yf = Bm.Yf + W16
  W16 = Bm.Yf >> 4
  By = W16
  if Fl > 0 then
    if Caught() = 1 then
      Bm.St = 3
      Bm.Tm = BoomN
      Ex = Bm.X
      Ey = By - 2
      inc Nt
      AddPoints(Fy)
      play sound SndPop
      return
    end if
  end if
  C = Bm.X + 8
  C = C >> 3
  V = 22 - Ht[C]
  V = V << 3
  U = By + 11
  if U >= V then Land
  return
end sub

' 1 when the flak burst covers the bomb
function Caught as u8
  u8 Ok = 0
  u8 Lx = Bm.X + 5
  u8 Rx = Bm.X + 10
  u8 Bot = By + 10
  if Fx + 2 <= Rx then
    if Lx <= Fx + 13 then
      if Fy + 2 <= Bot then
        if By <= Fy + 13 then Ok = 1
      end if
    end if
  end if
  return Ok

' points by the height of the burst (the listing's 75, 30, 10)
sub AddPoints(u8 Hy):
  select case Hy
  case 0 to 71
    Score += 75
    Sc = Sc + 75
  case 72 to 99
    Score += 30
    Sc = Sc + 30
  case else
    Score += 10
    Sc = Sc + 10
  end select
  ShowScore
  return
end sub

' a direct hit: the three blocks round the column fall
sub Land:
  Bm.St = 4
  Bm.Tm = BoomN
  inc Nh
  Ex = Bm.X
  V = 22 - Ht[C]
  V = V << 3
  Ey = V - 14
  K = C - 1
  if K < 2 then K = 2
  T = C + 1
  if T > 29 then T = 29
  for Ci = K to T
    Ht[Ci] = 0
    DrawCol(Ci)
  next
  play sound SndCrash
  return
end sub

' buildings still standing
function Standing as u8
  u8 Cnt = 0
  u8 Q
  for Q = 2 to 29
    if Ht[Q] > 0 then inc Cnt
  next
  return Cnt

' a random number 0..N-1
function Roll(u8 N) as u8
  Rand
  W16 = Rs & 255
  u8 Lo = W16
  return Lo % N

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprite 0 the sight, 1 the flak burst, 2 the bomb, 3 the bomber, 4 the
' explosion
sub DrawSprites:
  if TitleOn = 1 then
    set sprite 0 to 192,0,0,0
  else
    Y = Cy - 1
    set sprite 0 to Y,Cx,SSight,11
  end if
  if Fl > 0 then
    Y = Fy - 1
    K = SFlak1
    if Fl > 6 then K = SFlak0
    set sprite 1 to Y,Fx,K,15
  else
    set sprite 1 to 192,0,0,0
  end if
  if Bm.St = 2 then
    Y = By - 1
    set sprite 2 to Y,Bm.X,SBomb,14
  else
    set sprite 2 to 192,0,0,0
  end if
  if PlOn = 1 then
    set sprite 3 to PlaneY,Pl,SPlane,14
  else
    set sprite 3 to 192,0,0,0
  end if
  if Bm.St >= 3 then
    Y = Ey - 1
    K = SBoom1
    V = 9
    if Bm.Tm > 30 then
      K = SBoom0
      V = 11
    end if
    if Bm.Tm < 12 then V = 6
    set sprite 4 to Y,Ex,K,V
  else
    set sprite 4 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "BOMB"
  NumU = Nb
  print at 7,1, digits$(NumU, 2)
  print at 9,1, "/40"
  print at 16,1, "SCORE"
  ShowScore
  return
end sub

sub ShowScore:
  print at 22,1, Score
  return
end sub

' one column of the city, sky above
sub DrawCol(u8 Cc):
  u8 Hh = Ht[Cc]
  u8 Top = 22 - Hh
  u8 Rr
  u8 Tl
  for Rr = 15 to 21
    put char 32 at Cc,Rr
  next
  if Hh = 0 then
    put char TRubble at Cc,21
  else
    Tl = Cl[Cc] << 2
    Tl = Tl + TWall0
    Rr = Tl + Rk[Cc]
    put char Rr at Cc,Top
    Top = Top + 1
    for Rr = Top to 21
      put char Tl at Cc,Rr
    next
  end if
  return
end sub

' a new city: 28 buildings of 2..5 floors, five colours, three roofs
sub BuildCity:
  for Ci = 0 to 31
    Ht[Ci] = 0
  next
  for Ci = 2 to 29
    Ht[Ci] = Roll(4) + 2
    Cl[Ci] = Roll(5)
    Rk[Ci] = Roll(3) + 1
  next
  return
end sub

sub DrawField:
  for Ri = 3 to 14
    for Ci = 2 to 29
      V = Ci * 5
      J = Ri * 11
      V = V + J
      V = V & 31
      if V = 0 then put char TStar at Ci,Ri
      if V = 17 then put char TStar2 at Ci,Ri
    next
  next
  for Ci = 2 to 29
    DrawCol(Ci)
  next
  fill TGround count 32 at 0,22
  fill TGround count 32 at 0,23
  return
end sub

sub NewGame:
  Sc = 0
  Score = 0
  Nb = 0
  Nt = 0
  Nh = 0
  Over = 0
  Fl = 0
  Fc = 0
  PlOn = 0
  Cx = 120
  Cy = 90
  Bm.St = 0
  Bm.Tm = 60
  NewScreen
  BuildCity
  DrawField
  ShowHud
  TitleOn = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' the results of the enemy assault (the listing's lines 1200-1300)
sub Results:
  if Score > Hi then
    Hi = Score
    Hs = Sc
  end if
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 4,3, "THE FOLLOWING ARE THE"
  print at 4,4, "RESULTS OF THE ENEMY"
  print at 4,5, "ASSAULT...."
  print at 3,8, "BOMBS DROPPED.........."
  NumU = Nb
  print at 26,8, digits$(NumU, 2)
  print at 3,10, "BOMBS DEFLECTED........"
  NumU = Nt
  print at 26,10, digits$(NumU, 2)
  print at 3,12, "DIRECT HITS............"
  NumU = Nh
  print at 26,12, digits$(NumU, 2)
  print at 3,14, "STRUCTURE DAMAGE:"
  print at 3,16, "POPULATION:"
  if Nh >= 8 then
    print at 7,15, "TOTAL DEVASTATION"
    print at 7,17, "TOTAL ANNIHILATION"
  else
    print at 7,15, "PARTIAL DESTRUCTION"
    print at 7,17, "FEW CASUALTIES"
  end if
  print at 3,19, "YOUR SCORE..........."
  print at 24,19, Score
  print at 3,20, "HIGH SCORE..........."
  print at 24,20, Hi
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the city at night, the bomber passing, the tune once,
' START GAME / CREDITS
sub TitlePage:
  NewScreen
  BuildCity
  DrawField
  print at 10,5, "AIR ASSAULT"
  print at 7,7, "BY BOB LLORET"
  print at 7,8, "AHOY! MAY 1984"
  print at 11,11, "START GAME"
  print at 11,12, "CREDITS"
  print at 2,1, "HIGH SCORE"
  print at 13,1, Hi
  ShowMenu
  TitleOn = 1
  PlOn = 1
  Pl = 0
  Fl = 0
  Bm.St = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  Pl = Pl + 1
  DrawSprites
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 9,11
  put char 32 at 9,12
  J = Menu + 11
  put char 62 at 9,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "AIR ASSAULT"
  print at 2,5, "BASED ON AIR ASSAULT,"
  print at 2,6, "DESIGNED BY BOB LLORET,"
  print at 2,7, "AHOY! MAY 1984"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SEARCHLIGHTS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Pg = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Pg = 0
  return
end sub

data TilePat bytes
  $00,$00,$00,$10,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$02,$00,$00
  $00,$99,$99,$00,$00,$99,$99,$00
  $00,$00,$00,$00,$00,$99,$99,$00
  $10,$10,$10,$38,$00,$99,$99,$00
  $00,$C3,$C3,$C3,$00,$99,$99,$00
  $00,$99,$99,$00,$00,$99,$99,$00
  $00,$00,$00,$00,$00,$99,$99,$00
  $10,$10,$10,$38,$00,$99,$99,$00
  $00,$C3,$C3,$C3,$00,$99,$99,$00
  $00,$99,$99,$00,$00,$99,$99,$00
  $00,$00,$00,$00,$00,$99,$99,$00
  $10,$10,$10,$38,$00,$99,$99,$00
  $00,$C3,$C3,$C3,$00,$99,$99,$00
  $00,$99,$99,$00,$00,$99,$99,$00
  $00,$00,$00,$00,$00,$99,$99,$00
