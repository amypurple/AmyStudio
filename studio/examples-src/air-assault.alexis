  $00,$C3,$C3,$C3,$00,$99,$99,$00
  $00,$99,$99,$00,$00,$99,$99,$00
  $00,$00,$00,$00,$00,$99,$99,$00
  $10,$10,$10,$38,$00,$99,$99,$00
  $00,$C3,$C3,$C3,$00,$99,$99,$00
  $00,$00,$00,$00,$10,$62,$26,$44
  $00,$44,$00,$00,$99,$00,$00,$21
end data
data TileCol bytes
  $01,$01,$01,$F1,$01,$01,$01,$01
  $01,$01,$01,$01,$01,$51,$01,$01
  $0E,$EB,$EB,$0E,$0E,$E1,$E1,$0E
  $01,$01,$01,$0E,$0E,$EB,$EB,$0E
  $91,$E1,$E1,$E1,$0E,$EB,$EB,$0E
  $01,$1E,$1E,$1E,$0E,$EB,$EB,$0E
  $07,$7B,$7B,$07,$07,$71,$71,$07
  $01,$01,$01,$0E,$07,$7B,$7B,$07
  $91,$E1,$E1,$E1,$07,$7B,$7B,$07
  $01,$17,$17,$17,$07,$7B,$7B,$07
  $08,$8B,$8B,$08,$08,$81,$81,$08
  $01,$01,$01,$0E,$08,$8B,$8B,$08
  $91,$E1,$E1,$E1,$08,$8B,$8B,$08
  $01,$18,$18,$18,$08,$8B,$8B,$08
  $0D,$DB,$DB,$0D,$0D,$D1,$D1,$0D
