' DrawBoard's place in Board (CrRow moves it on by 8 a row)
u8 Dix = 0

  tile screen
  set sound table CrSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadStick
  PlayStep
  DrawRunner
  if Won = 1 then LevelDone
  if Over = 0 then goto play_loop

  ' the end: the message, then back to the title on a press
  InPlay = 0
  mute all
  TzOn = 0
  if Score > Best then Best = Score
  print at 26,16, Best
  print at 4,10, "                    "
  if Over = 1 then
    print at 4,11, "   OUT OF TIME!     "
    play sound SndOver
  else
    print at 4,11, " GOOD WORK! ALL 40  "
    play sound SndWin
  end if
  print at 4,12, "                    "
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the clock, the field's change, the runner
sub PlayStep:
  Pure = 0
  if Stk = 1 then Pure = 1
  if Pure = 0 then UpHeld = 0
  if Half = 1 then
    DrawRows(5, 9)
    Half = 0
  end if
  dec Sub60
  if Sub60 = 0 then
    Sub60 = 60
    dec Secs
    dec TimeB
    ShowTime
    if Secs = 0 then
      Over = 1
      return
    end if
  end if
  dec ShufT
  if ShufT = Warn then
    NextOff = PickOff()
    Crumb = 1
    DrawRows(0, 4)
    Half = 1
  end if
  if ShufT = 0 then
    Off = NextOff
    LoadBoard
    Crumb = 0
    DrawRows(0, 4)
    Half = 1
    ShufT = Per
    inc Shuffles
    if Secs <= 10 then
      play sound SndWarn
    else
      play sound SndShuffle
    end if
  end if
  if Gt > 0 then dec Gt
  if Gt > 0 then return
  if Pr = 0 then
    Won = 1
    return
  end if
  V = Solid(Pc, Pr)
  if V = 0 then
    MoveTo(Pc, Pr + 1, FallT)
    inc Falls
    play sound SndFall
    return
  end if
  TryMove
  return
end sub

' a move tried with the stick (Stk: 1 up, 2 down, 4 left, 8 right)
sub TryMove:
  select case Stk
    case 1
      inc UpHeld
      if UpHeld = UpMax then
        ResetRunner
        return
      end if
      K = Pr - 1
      V = Solid(Pc, K)
      if V = 1 then
        MoveTo(Pc, K, StepT)
      else
        Gt = StepT
      end if
    case 2
      if Pr = 11 then return
      K = Pr + 1
      V = Solid(Pc, K)
      if V = 1 then
        MoveTo(Pc, K, StepT)
      else
        Gt = StepT
      end if
    case 4 to 6
      if Pc = 0 then return
      K = Pc - 1
      V = Solid(K, Pr)
      if V = 1 then
        MoveTo(K, Pr, StepT)
      else
        Gt = StepT
      end if
    case 8 to 10
      if Pc = 7 then return
      K = Pc + 1
      V = Solid(K, Pr)
      if V = 1 then
        MoveTo(K, Pr, StepT)
      else
        Gt = StepT
      end if
  end select
  return
end sub

' 1 when place (C, R) can be stood on: the bars always, a cell when there
function Solid(u8 C, u8 R) as u8
  u8 Res = 1
  u8 Ix = 0
  if R >= 1 then
    if R <= 10 then
      Ix = R - 1
      Ix = Ix * 8 + C
      if Board[Ix] = 1 then Res = 0
    end if
  end if
  return Res

' start a glide to (C, R) lasting N frames
sub MoveTo(u8 C, u8 R, u8 N):
  From.X = PlaceX(Pc)
  From.Y = PixY[Pr]
  Pc = C
  Pr = R
  Gt = N
  GLen = N
  if N = StepT then
    inc Moves
    play sound SndStep
  end if
  return
end sub

function PlaceX(u8 C) as u8
  return C * 24 + 20

sub ResetRunner:
  Pc = 3
  Pr = 11
  Gt = 0
  UpHeld = 0
  inc Resets
  play sound SndReset
  return
end sub

' a new field offset 0-87, never the current one
function PickOff as u8
  u8 R = 0
  R = random(0, 255)
  R = R + Mix
  R = R % 88
  if R = Off then
    inc R
    if R = 88 then R = 0
  end if
  return R

sub LoadBoard:
  copy CellPat + Off count 80 to Board
  return
end sub

' the field: 10 rows of 8 hexagons, 3 x 2 tiles each; with Crumb set, the
' cells missing in the next field crumble. CrRow (Z80, below) builds one
' row's two tile lines: the same work in Amy took 100,000 cycles a field,
' more than a frame.
sub DrawBoard:
  DrawRows(0, 9)
  return
end sub

' rows R0 to R1 of the field (in play: the top half in the frame of the
' change, the bottom half in the next, to stay inside one frame)
sub DrawRows(u8 R0, u8 R1):
  Dix = R0 * 8
  W16 = R0 * 64
  W16 = W16 + 66
  for Rr = R0 to R1
    call asm CrRow
    copy BufT count 24 to vram.name + W16
    W16 = W16 + 32
    copy BufB count 24 to vram.name + W16
    W16 = W16 + 32
  next
  return
end sub

sub DrawRunner:
  i16 D = 0
  u8 Pat = 0
  Here.X = PlaceX(Pc)
  Here.Y = PixY[Pr]
  if Gt > 0 then
    D = From.X
    D = D - Here.X
    D = D * Gt
    D = D / GLen
    Here.X = Here.X + D
    D = From.Y
    D = D - Here.Y
    D = D * Gt
    D = D / GLen
    Here.Y = Here.Y + D
  end if
  Pat = SRun1
  V = Tick & 8
  if Gt > 0 then
    if V > 0 then Pat = SRun2
  end if
  K = Pat + 8
  set sprite 0 to Here.Y - 1,Here.X,Pat,8
  set sprite 1 to Here.Y - 1,Here.X,K,1
  update sprites
  return
end sub

sub ShowTime:
  print Secs at 26,8 digits 2
  return
end sub

sub ShowStatus:
  print at 26,3, "LEV"
  print Level at 26,4 digits 2
  print at 26,7, "TIME"
  ShowTime
  print at 26,11, "PTS"
  print at 26,12, Score
  print at 26,15, "BEST"
  print at 26,16, Best
  return
end sub

' the level's start: colour, speed, clock, the runner on the start bar
sub StartLevel:
  Col = Level - 1
  Col = Col % 5
  Per = 122 - Level * 2
  ShufT = Per
  Secs = 30
  TimeB = 30
  Sub60 = 60
  Crumb = 0
  Half = 0
  Pc = 3
  Pr = 11
  Gt = 0
  UpHeld = 0
  return
end sub

' the goal bar reached: seconds left + 10, then the next level (or the end)
sub LevelDone:
  Score += TimeB
  Score += Ten
  print at 26,12, Score
  play sound SndGoal
  for Ws = 1 to 50
    Frame1
    DrawRunner
  next
  if Level = NLevels then
    Over = 2
    return
  end if
  inc Level
  StartLevel
  print Level at 26,4 digits 2
  ShowTime
  DrawBoard
  Frame1
  Won = 0
  return
end sub

sub DrawBars:
  fill TBar count 24 at 2,22
  for J = 0 to 7
    K = J * 3 + 2
    put char TBar at K,1
    put char TGoal at K + 1,1
    put char TBar at K + 2,1
  next
  return
end sub

sub NewGame:
  NewScreen
  DrawBars
  Level = 1
  Score = 0
  Over = 0
  Won = 0
  Moves = 0
  Falls = 0
  Resets = 0
  Shuffles = 0
  Off = PickOff()
  LoadBoard
  StartLevel
  DrawBoard
  ShowStatus
  DrawRunner
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  InPlay = 1
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

function PadBits as u8
  u8 B = 0
  if joypad(1).up then B = B | 1
  if joypad(1).down then B = B | 2
  if joypad(1).left then B = B | 4
  if joypad(1).right then B = B | 8
  if joypad(1).fire then B = B | 16
  if joypad(2).up then B = B | 1
  if joypad(2).down then B = B | 2
  if joypad(2).left then B = B | 4
  if joypad(2).right then B = B | 8
  if joypad(2).fire then B = B | 16
  return B

' the stick (Stk, directions only) and a fresh button (Press)
sub ReadStick:
  V = PadBits()
  Stk = V & 15
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  for J = 0 to 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: CELL RUNNER in block letters, a runner going to and fro,
' PLAY / CREDITS, the tune once
sub TitlePage:
  NewScreen
  print at 3,1, "COMPUTE!'S GAZETTE 9/1986"
  copy TitleMap count 352 to vram.name + 64
  print at 4,14, "RUN UP TO THE GOAL BAR"
  print at 4,15, "ON THE CELLS THAT ARE"
  print at 4,16, "THERE. THEY CHANGE!"
  print at 12,18, "PLAY"
  print at 12,19, "CREDITS"
  print at 10,20, "BEST"
  print at 15,20, Best
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 455
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadStick
  TitleAnim
  V = Stk & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' a runner goes to and fro under the letters
sub TitleAnim:
  u8 Px = 0
  u8 Pat = 0
  Px = Tick
  if Px >= 128 then Px = 255 - Px
  Px = Px + 60
  Pat = SRun1
  V = Tick & 8
  if V > 0 then Pat = SRun2
  K = Pat + 8
  set sprite 0 to 167,Px,Pat,8
  set sprite 1 to 167,Px,K,15
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 10,18
  put char 32 at 10,19
  J = Menu + 18
  put char 62 at 10,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "CELL RUNNER"
  print at 2,5, "BASED ON CELL RUNNER BY"
  print at 2,6, "JOHN KRUTCH, FROM THE"
  print at 2,7, "COMPUTE!'S GAZETTE DISK OF"
  print at 2,8, "SEPTEMBER 1986 (COMMODORE"
  print at 2,9, "64 MACHINE LANGUAGE)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: HONEYCOMB DASH"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
; CrRow: one board row (8 cells from Board[Dix]) into BufT / BufB.
; State 0 missing, Col + 1 there, Col + 6 there but missing in the next
; field (CellPat[NextOff + index]) while Crumb = 1; tiles from StateTile.
CrRow:
    exx
    ld hl,AMY_UVAR_BufT
    ld bc,AMY_UVAR_BufB
    exx
    ld a,(AMY_UVAR_Dix)
    ld c,a
    ld b,8
CrRowCell:
    ld hl,AMY_UVAR_Board
    ld e,c
    ld d,0
    add hl,de
    ld a,(hl)
    or a
    ld a,0
    jr nz,CrRowSet
    ld a,(AMY_UVAR_Col)
    inc a
    ld e,a
    ld a,(AMY_UVAR_Crumb)
    or a
    jr z,CrRowSetE
    ld a,(AMY_UVAR_NextOff)
    add a,c
    push de
    ld e,a
    ld hl,AMY_UDATA_CellPat
    add hl,de
    pop de
    ld a,(hl)
    or a
    ld a,e
    jr z,CrRowSet
    add a,5
    jr CrRowSet
CrRowSetE:
    ld a,e
CrRowSet:
    ld hl,AMY_UDATA_StateTile
    ld e,a
    add hl,de
    ld a,(hl)
    exx
    ld (hl),a
    inc hl
    add a,3
    ld (bc),a
    inc bc
    sub 2
    ld (hl),a
    inc hl
    add a,3
    ld (bc),a
    inc bc
    sub 2
    ld (hl),a
    inc hl
    add a,3
    ld (bc),a
    inc bc
    exx
    inc c
    djnz CrRowCell
    ld a,c
    ld (AMY_UVAR_Dix),a
    ret
CrStep:
    db $40,$47,$60,$01,$40,$55,$80,$01,$50
CrBump:
    db $40,$F9,$52,$02,$50
CrFall:
    db $40,$7F,$30,$02,$40,$A0,$40,$02,$40,$D6,$50,$02,$50
CrShuffle:
    db $00,$00,$76,$02,$00,$00,$A6,$02,$10
CrWarn:
    db $40,$40,$20,$03,$40,$40,$F0,$03,$50
CrReset:
    db $40,$1D,$21,$04,$40,$AB,$31,$04,$40,$3B,$42,$08,$50
CrGoal:
    db $40,$D6,$20,$03,$40,$8F,$20,$03,$40,$6B,$20,$03,$40,$AA,$20,$03,$40,$71,$20,$03,$40,$55,$20,$03
    db $40,$8F,$20,$03,$40,$5F,$20,$03,$40,$47,$10,$0C,$50
CrStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$30,$0C,$50
CrOver:
    db $40,$AA,$20,$0A,$40,$D6,$20,$0A,$40,$FE,$20,$0A,$40,$1D,$21,$0A,$40,$53,$31,$1E,$50
CrWin:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$08,$40,$8F,$20,$06,$40,$6B,$10,$14
    db $50

CrSoundTable:
    dw CrTuneMel,$702B
    dw CrTuneBass,$7035
    dw CrStep,$7049
    dw CrBump,$7049
    dw CrFall,$7049
    dw CrShuffle,$703F
    dw CrWarn,$7049
    dw CrReset,$7049
    dw CrGoal,$7049
    dw CrStart,$7049
    dw CrOver,$7049
    dw CrWin,$7049
; Honeycomb Dash (original)
; Tiny Sound, 7 frames per step
CrTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$23,$26,$2A,$01,$28,$26,$25,$01,$23,$25,$26,$28
    db $2A,$01,$01,$01,$2B,$2A,$28,$01,$26,$28,$2A,$01,$28,$26,$25,$21
    db $23,$01,$01,$01,$23,$26,$2A,$2F,$2D,$2A,$26,$01,$28,$2B,$2A,$28
    db $26,$25,$26,$01,$25,$01,$21,$01,$25,$28,$26,$25,$23,$01,$01,$01
    db $01,$01,$00,$01
    db $FF
CrTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$0B,$01,$12,$01,$0B,$01,$12,$01,$0B,$01,$12,$01
    db $0E,$01,$12,$01,$04,$01,$0B,$01,$07,$01,$0E,$01,$09,$01,$10,$01
    db $0B,$01,$12,$01,$0B,$01,$12,$01,$0E,$01,$09,$01,$04,$01,$0B,$01
    db $07,$01,$0E,$01,$09,$01,$10,$01,$06,$01,$0D,$01,$0B,$01,$12,$01
    db $0B,$01,$00,$01
    db $FF
}
