u8 Mix = 0
bcd digits 4 TimeB = 30
bcd digits 4 Score = 0
bcd digits 4 Best = 0
bcd digits 4 Ten = 10
' counts for the bots
u8 Moves = 0
u8 Falls = 0
u8 Resets = 0
u8 Shuffles = 0
u8 InPlay = 0
' input and menus
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
