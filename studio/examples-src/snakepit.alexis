  u8 PR
  u8 Dead
  u8 Len
end record

Snk Sn[2]
' the mice in plain arrays (cell, direction, alive, the last cell): a
' record array's field costs an address computation on every read, and
' MouseAt runs many times a step
u8 MsC[4]
u8 MsR[4]
u8 MsD[4]
u8 MsA[4]
u8 MsPC[4]
u8 MsPR[4]
' where each mouse's sprite is gliding to (the mice take their step a frame
' before the snakes, see PlayFrame; the sprites move with the snakes)
u8 MsVC[4]
u8 MsVR[4]
u8 Ri = 0
u8 Rk = 0
u16 W16 = 0
u16 NumU = 0
u16 TimeS = 300
bcd digits 6 Sc1 = 0
bcd digits 6 Sc2 = 0
' points earned, kept in binary too (the tests compare them)
u16 Pts1 = 0
u16 Pts2 = 0
u16 TzLeft = 0
u8 TzOn = 0
' play state: phase (0 waiting for the stick, 1 running, 2 crashed),
' frame of the step, the glide in pixels, steps, the clock's frames
u8 Ph = 0
u8 Ft = 0
u8 GlideV = 0
u8 StepF = 5
u8 Ticks = 0
u8 Sec60 = 0
u8 CrashT = 0
u8 Pushed = 0
u8 Over = 0
u8 Rounds = 0
u8 Eaten = 0
u8 Dirty = 0
u8 Players = 1
u8 Speed = 3
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Pg = 0
u8 Hx0 = 0
u8 Hy0 = 0
u16 Wt = 0
u8 Tick = 0
u8 Idle = 0
' loop counters
u8 Pi = 0
u8 Mi = 0
u8 Ry = 0
u8 Pz = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 M = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 RndB = 0

  tile screen
  set sound table SpSoundTable areas 6
  sprites 16x16
  set sprite count 6
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: time is up, then back to the title on a press
  print at 9,10, "            "
  print at 9,11, "  TIME UP!  "
  print at 9,12, "            "
  if Players = 2 then
    if Sc1 > Sc2 then
      print at 8,13, " PLAYER 1 WINS "
    else
      if Sc2 > Sc1 then
        print at 8,13, " PLAYER 2 WINS "
      else
        print at 8,13, "  A DRAW GAME  "
      end if
    end if
    print at 8,14, "               "
  end if
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayFrame:
  ' a score changed in the last step is shown now (a step with two snakes,
  ' a mouse eaten and the print ran over the frame)
  if Dirty = 1 then
    ShowScores
    Dirty = 0
  end if
  inc Sec60
  if Sec60 >= 60 then
    Sec60 = 0
    dec TimeS
    ShowTime
    if TimeS = 0 then Over = 1
  end if
  select case Ph
    case 0
      Latch
      if Players = 1 then
        V = J1 & 15
        if V > 0 then Begin
      else
        V = J1 & 15
        if V > 0 then Pushed = Pushed | 1
        V = J2 & 15
        if V > 0 then Pushed = Pushed | 2
        if Pushed = 3 then Begin
      end if
    case 1
      Latch
      inc Ft
      ' the mice first, then the snakes: the mice take their step in the
      ' frame before the snakes' (nothing moves in between) so that no
      ' frame has to do both
      K = StepF - 1
      if Ft = K then MiceStep
      if Ft >= StepF then
        Ft = 0
        GameTick
      end if
    case 2
      dec CrashT
      ' the next round is prepared over four passes (one pass for all of it
      ' ran over a frame with two snakes)
      if CrashT = 3 then Sweep(3, 12)
      if CrashT = 2 then Sweep(13, 21)
      if CrashT = 1 then copy SnCol count 256 to vram.color + TSnA0 * 8
      if CrashT = 0 then NewRound
  end select
  return
end sub

sub Begin:
  Ph = 1
  Ft = 0
  play sound SndGo
  return
end sub

' the stick of each player, remembered until the next step: up first,
' then right, down, left (as the C64 read it)
function StickDir(u8 Js) as u8
  if Js & 1 then return 0
  if Js & 8 then return 1
  if Js & 2 then return 2
  if Js & 4 then return 3
  return 255

sub Latch:
  V = StickDir(J1)
  if V < 4 then Sn[0].Want = V
  if Players = 2 then
    V = StickDir(J2)
    if V < 4 then Sn[1].Want = V
  end if
  return
end sub

sub MiceStep:
  for Mi = 0 to 3
    MouseStep(Mi)
  next
  return
end sub

' a step: the mice have moved (MiceStep, the frame before); their sprites
' set off now with the snakes (player 2 before player 1)
sub GameTick:
  inc Ticks
  for Mi = 0 to 3
    MsPC[Mi] = MsVC[Mi]
    MsPR[Mi] = MsVR[Mi]
    MsVC[Mi] = MsC[Mi]
    MsVR[Mi] = MsR[Mi]
  next
  if Players = 2 then SnakeStep(1)
  SnakeStep(0)
  V = Sn[0].Dead | Sn[1].Dead
  if V > 0 then
    Ph = 2
    CrashT = 60
  end if
  return
end sub

' the number of the live mouse in cell (Qc, Qr), 255 if none
function MouseAt(u8 Qc, u8 Qr) as u8
  for K = 0 to 3
    if MsA[K] = 1 then
      if MsC[K] = Qc and MsR[K] = Qr then return K
    end if
  next
  return 255

sub MouseStep(u8 I)
  u8 Mc
  u8 Mr
  u8 Md
  u8 Nd
  u8 Nc
  u8 Nr
  Mc = MsC[I]
  Mr = MsR[I]
  Md = MsD[I]
  if MsA[I] = 0 then
    ' out of a random hole, if the cell in front of it is free
    Nd = Rand6()
    Nc = HoleC[Nd]
    Nr = HoleR[Nd]
    V = get char at Nc,Nr
    if V = TFloor then
      if MouseAt(Nc, Nr) = 255 then
        MsC[I] = Nc
        MsR[I] = Nr
        MsPC[I] = Nc
        MsPR[I] = Nr
        MsVC[I] = Nc
        MsVR[I] = Nr
        MsD[I] = HoleD[Nd]
        MsA[I] = 1
      end if
    end if
  else
    Nd = Rand4()
    if Nd <> (Md ^ 2) then
      Nc = Mc + DCol[Nd]
      Nr = Mr + DRow[Nd]
      V = get char at Nc,Nr
      if V = TFloor then
        if MouseAt(Nc, Nr) = 255 then
          MsC[I] = Nc
          MsR[I] = Nr
          MsD[I] = Nd
        end if
      end if
    end if
  end if
  return
end sub

sub SnakeStep(u8 P)
  u8 Sc
  u8 Sr
  u8 Od
  u8 Nd
  u8 Nc
  u8 Nr
  u8 Base
  u8 Hit
  Sc = Sn[P].C
  Sr = Sn[P].R
  Od = Sn[P].Dir
  Nd = Od
  Base = P * 16 + TSnA0
  Sn[P].PC = Sc
  Sn[P].PR = Sr
  if Sn[P].Want < 4 then
    if Sn[P].Want <> (Od ^ 2) then Nd = Sn[P].Want
  end if
  Nc = Sc + DCol[Nd]
  Nr = Sr + DRow[Nd]
  V = get char at Nc,Nr
  if V <> TFloor then
    Crash(P)
  else
    Hit = MouseAt(Nc, Nr)
    M = Bit[Od ^ 2] | Bit[Nd]
    put char Base + M at Sc,Sr
    put char TClaimA + P at Nc,Nr
    Sn[P].C = Nc
    Sn[P].R = Nr
    Sn[P].Dir = Nd
    if Hit < 4 then
      MsA[Hit] = 0
      inc Eaten
      if Sn[P].Len < 250 then inc Sn[P].Len
      AddPts(P, 30)
      play sound SndEat
    else
      TailStep(P)
    end if
  end if
  return
end sub

' the tail follows its only joint; the next piece loses the joint behind
sub TailStep(u8 P)
  u8 Tc
  u8 Tr
  u8 Base
  u8 Td
  u8 Tv
  Base = P * 16 + TSnA0
  Tc = Sn[P].TC
  Tr = Sn[P].TR
  Tv = get char at Tc,Tr
  M = Tv - Base
  Td = M2D[M]
  put char TFloor at Tc,Tr
  Tc = Tc + DCol[Td]
  Tr = Tr + DRow[Td]
  Tv = get char at Tc,Tr
  if Tv >= Base and Tv < Base + 16 then
    M = Tv - Base
    K = Td ^ 2
    M = M & (15 ^ Bit[K])
    put char Base + M at Tc,Tr
  end if
  Sn[P].TC = Tc
  Sn[P].TR = Tr
  return
end sub

' a crash: the snake turns white, the other player scores 20
sub Crash(u8 P)
  Sn[P].Dead = 1
  W16 = P * 16 + TSnA0
  W16 = W16 * 8
  copy SnCol + 256 count 128 to vram.color + W16
  if Players = 2 then
    K = 1 - P
    AddPts(K, 20)
  end if
  play sound SndCrash
  return
end sub

sub AddPts(u8 P, u8 N)
  if P = 0 then
    Sc1 += N
    Pts1 = Pts1 + N
  else
    Sc2 += N
    Pts2 = Pts2 + N
  end if
  Dirty = 1
  return
end sub

' random numbers: a shuffled table of 0-255 (art.py) read in turn, a salt
' added that changes every lap and is seeded on the title (a 16-bit
' xorshift with a modulo cost more than the frame's spare time with two
' snakes and four mice; the modulo was the slow part)
function RandByte() as u8
  RndB = Shuffle[Ri] + Rk
  inc Ri
  if Ri = 0 then Rk = Rk + 37
  return RndB

' 0-3, a direction
function Rand4() as u8
  RndB = RandByte()
  RndB = RndB & 3
  return RndB

' 0-5, a hole: (byte x 6) / 256 from a table, as the C64's five
' thresholds split its random byte in six
function Rand6() as u8
  RndB = RandByte()
  RndB = Sixth[RndB]
  return RndB

' ---------------------------------------------------------------------------
' sprites: heads 0-1, mice 2-5, gliding from the last cell toward the new

' the pixel position along one axis, A the old cell, B the new
function Px(u8 A, u8 B) as u8
  T = A * 8 - 4
  if B > A then T = T + GlideV
  if B < A then T = T - GlideV
  return T

sub DrawSprites:
  GlideV = 0
  if Ph = 1 then
    K = Ft << 3
    GlideV = K / StepF
  end if
  for Pi = 0 to 1
    DrawHead(Pi)
  next
  ' the mice inline (a sub call per mouse cost too much of the frame)
  V = Tick & 16
  M = V >> 2
  for Mi = 0 to 3
    C = MsVC[Mi]
    D = MsPC[Mi]
    X = D << 3
    X = X - 4
    if C > D then X = X + GlideV
    if C < D then X = X - GlideV
    C = MsVR[Mi]
    D = MsPR[Mi]
    Y = D << 3
    Y = Y - 4
    if C > D then Y = Y + GlideV
    if C < D then Y = Y - GlideV
    T = MsD[Mi] << 3
    T = T + SMs00 + M
    if MsA[Mi] = 0 then Y = 193
    set sprite Mi + 2 to Y - 1,X,T,14
  next
  update sprites
  return
end sub

sub DrawHead(u8 P)
  u8 Hx
  u8 Hy
  u8 Pat
  u8 Col
  Hx = Px(Sn[P].PC, Sn[P].C)
  Hy = Px(Sn[P].PR, Sn[P].R)
  if Sn[P].Dead = 1 then
    Pat = SHx
    Col = 15
  else
    Pat = Sn[P].Dir << 3
    Pat = Pat + SHd00
    V = Tick & 16
    if V > 0 then Pat = Pat + 4
    Col = HeadCol[P]
  end if
  if P >= Players then Hy = 193
  set sprite P to Hy - 1,Hx,Pat,Col
  return
end sub


' ---------------------------------------------------------------------------
' the game, the rounds

sub NewGame:
  Sc1 = 0
  Sc2 = 0
  Pts1 = 0
  Pts2 = 0
  TimeS = RoundSec
  Sec60 = 0
  Over = 0
  Rounds = 0
  Eaten = 0
  Dirty = 0
  Ticks = 0
  StepF = StepTab[Speed - 1]
  NewScreen
  DrawPit
  Sweep(3, 12)
  Sweep(13, 21)
  copy SnCol count 256 to vram.color + TSnA0 * 8
  ShowScores
  ShowTime
  SetRound
  DrawSprites
  ShowScreen
  return
end sub

' the walls and the six holes
sub DrawPit:
  for X = 2 to 29
    put char TWall at X,2
    put char TWall at X,22
  next
  for Y = 3 to 21
    put char TWall at 2,Y
    put char TWall at 29,Y
  next
  put char THoleL at 2,9
  put char THoleL at 2,15
  put char THoleR at 29,9
  put char THoleR at 29,15
  put char THoleB at 11,22
  put char THoleB at 20,22
  return
end sub

' the snakes and the mice at their starts (the floor swept and the
' colours back before)
sub SetRound:
  inc Rounds
  if Players = 1 then
    PlaceSnake(0, 8, 12, 1)
    Sn[1].Dead = 0
    Sn[1].C = 0
    Sn[1].PC = 0
  else
    PlaceSnake(0, 13, 9, 1)
    PlaceSnake(1, 20, 15, 3)
  end if
  for Mi = 0 to 3
    K = Mi
    if Mi >= 2 then K = Mi + 2
    PlaceMouse(Mi, K)
  next
  Ph = 0
  Ft = 0
  Pushed = 0
  return
end sub

sub NewRound:
  SetRound
  return
end sub

' floor over rows Ra to Rb of the pit
sub Sweep(u8 Ra, u8 Rb)
  for Ry = Ra to Rb
    W16 = Ry * 32 + 3
    copy FloorRow count 26 to vram.name + W16
  next
  return
end sub

' a snake 8 long from its tail (Tc, Tr) toward direction Dd
sub PlaceSnake(u8 P, u8 Tc, u8 Tr, u8 Dd)
  u8 Base
  u8 Cx
  Base = P * 16 + TSnA0
  Cx = Tc
  Sn[P].TC = Tc
  Sn[P].TR = Tr
  put char Base + Bit[Dd] at Cx,Tr
  for J = 1 to 6
    Cx = Cx + DCol[Dd]
    M = Bit[Dd] | Bit[Dd ^ 2]
    put char Base + M at Cx,Tr
  next
  Cx = Cx + DCol[Dd]
  put char TClaimA + P at Cx,Tr
  Sn[P].C = Cx
  Sn[P].R = Tr
  Sn[P].PC = Cx
  Sn[P].PR = Tr
  Sn[P].Dir = Dd
  Sn[P].Want = 255
  Sn[P].Dead = 0
  Sn[P].Len = 8
  return
end sub

sub PlaceMouse(u8 I, u8 H)
  MsC[I] = HoleC[H]
  MsR[I] = HoleR[H]
  MsPC[I] = HoleC[H]
  MsPR[I] = HoleR[H]
  MsVC[I] = HoleC[H]
  MsVR[I] = HoleR[H]
  MsD[I] = HoleD[H]
  MsA[I] = 1
  return
end sub

sub ShowScores:
  print at 2,1, Sc1
  put char TSnA0 + 10 at 9,1
  if Players = 2 then
    print at 24,1, Sc2
    put char TSnB0 + 10 at 22,1
  end if
  return
end sub

sub ShowTime:
  NumU = TimeS / 60
  print at 14,1, digits$(NumU, 1)
  print at 15,1, ":"
  W16 = NumU * 60
  NumU = TimeS - W16
  print at 16,1, digits$(NumU, 2)
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Nf)
  for Pz = 1 to Nf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' controller 1 for player 1, controller 2 for player 2; with one player
' either controller steers
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  if Players = 1 then J1 = J1 | J2
  Btn = (J1 | J2) & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 6
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: SNAKE / PIT in snake pieces in a little pit, the choices
sub TitlePage:
  NewScreen
  copy SnCol count 256 to vram.color + TSnA0 * 8
  copy TitleMap count 208 to vram.name + 64
  copy TitleMap + 208 count 208 to vram.name + 272
  print at 3,1, "COMPUTE!'S GAZETTE DEC 1987"
  print at 2,15, "EAT THE MICE, MISS THE WALLS"
  print at 2,16, "AND THE SNAKES. 5 MINUTES."
  print at 6,18, "PLAYERS"
  print at 16,18, "1  2"
  print at 6,19, "SPEED"
  print at 16,19, "1 2 3 4 5"
  print at 6,20, "START"
  print at 6,21, "HOW TO PLAY"
  print at 6,22, "CREDITS"
  Menu = 2
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 580
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  V = (J1 | J2) & 15
  if V > 0 then
    if WasStick = 0 then
      select case V
        case 1
          if Menu > 0 then dec Menu
        case 2
          if Menu < 4 then inc Menu
        case 4
          if Menu = 0 then Players = 1
          if Menu = 1 then
            if Speed > 1 then dec Speed
          end if
        case 8
          if Menu = 0 then Players = 2
          if Menu = 1 then
            if Speed < 5 then inc Speed
          end if
      end select
      if TzOn = 0 then play sound SndBlip
      ShowMenu
    end if
  end if
  WasStick = V
  inc Ri
  if Ri = 0 then inc Rk
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 3 then HowToPage
  if Menu = 4 then CreditsPage
  return
end sub

sub ShowMenu:
  for J = 18 to 22
    put char 32 at 4,J
  next
  J = Menu + 18
  put char 62 at 4,J
  for J = 15 to 25
    put char 32 at J,18
    put char 32 at J,19
  next
  print at 16,18, "1  2"
  print at 16,19, "1 2 3 4 5"
  X = Players * 3 + 12
  put char 91 at X,18
  put char 93 at X + 2,18
  X = Speed * 2 + 13
  put char 91 at X,19
  put char 93 at X + 2,19
  return
end sub

' a little pit: walls round rows 12-18, columns 7-24, the floor inside
sub HtPit:
  for Hy0 = 12 to 18
    for Hx0 = 7 to 24
      put char TFloor at Hx0,Hy0
    next
    put char TWall at 7,Hy0
    put char TWall at 24,Hy0
  next
  fill TWall count 18 at 7,12
  fill TWall count 18 at 7,18
  put char THoleL at 7,15
  put char THoleR at 24,15
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  copy SnCol count 256 to vram.color + TSnA0 * 8
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "STEER YOUR SNAKE ONTO THE"
    print at 2,4, "MICE THAT RUN OUT OF THE"
    print at 2,5, "HOLES IN THE WALLS."
    print at 2,7, "EACH MOUSE IS 30 POINTS AND"
    print at 2,8, "MAKES YOUR SNAKE LONGER."
    print at 2,9, "THE GAME LASTS 5 MINUTES."
    HtPit
    put char TSnA2 at 9,15
    fill TSnA10 count 5 at 10,15
    set sprite 0 to 115,116,SHd10,1
    set sprite 2 to 115,156,SMs30,14
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: TURN YOUR SNAKE. IT"
    print at 2,4, "NEVER STOPS. IT CAN NOT"
    print at 2,5, "TURN STRAIGHT BACK."
    print at 2,7, "PLAYER 1: CONTROLLER 1."
    print at 2,8, "PLAYER 2: CONTROLLER 2."
    print at 2,9, "PUSH THE STICK TO START."
    HtPit
    put char TSnA2 at 9,14
    fill TSnA10 count 4 at 10,14
    put char TSnB8 at 22,16
    fill TSnB10 count 4 at 18,16
    set sprite 0 to 107,108,SHd10,1
    set sprite 1 to 123,132,SHd30,12
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "DON'T RUN INTO A WALL OR A"
    print at 2,4, "SNAKE - YOUR OWN TOO! THEN"
    print at 2,5, "THE PIT STARTS OVER, BUT"
    print at 2,6, "THE CLOCK KEEPS RUNNING."
    print at 2,8, "WITH 2 PLAYERS, A CRASH"
    print at 2,9, "GIVES THE OTHER ONE 20."
    print at 2,10, "THE BEST SCORE AT TIME UP"
    print at 2,11, "WINS."
    HtPit
    fill TSnA10 count 5 at 9,15
    put char TSnA8 at 14,15
    set sprite 0 to 115,60,SHx,15
    print at 2,20, "TIP: STAY AWAY FROM WALLS"
    print at 2,21, "AND TURN EARLY."
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "SNAKE PIT"
  print at 2,5, "BASED ON SNAKE PIT,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "DECEMBER 1987 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE; THE"
  print at 2,9, "PROGRAM NAMES NO AUTHOR)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: DEN OF COILS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

