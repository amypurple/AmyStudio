' FP5 exp lab: exact zero anchor plus log/exp round-trip smoke checks.
u16 UZero = 0
u16 UOne = 1
u16 UTwo = 2
u16 UFour = 4
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0

  text screen
  print at 7,0, "FP5 EXP LAB"

  A = UZero
  A = exp(A)
  B = UOne
  B = exp(B)
  C = UTwo
  C = log(C)
  C = exp(C)
  D = UFour
  D = log(D)
  D = exp(D)

  print at 1,4,  "exp 0"
  print A at 14,4 digits 16
  print at 1,6,  "exp 1"
  print B at 14,6 digits 16
  print at 1,8,  "exp log 2"
  print C at 14,8 digits 16
  print at 1,10, "exp log 4"
  print D at 14,10 digits 16

  print at 1,13, "CURRENT"
  print at 1,14, "safe first-pass polynomial path"
  print at 1,15, "exp improvement remains backlogged"
  screen on