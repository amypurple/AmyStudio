project "Amy Feature Test"
memory "colecovision_legacy_sdcc"

bool Flag = false

u8 ByteValue = 3
u8 OptCount = 0
u8 RouteGosub = 2
u8 RouteGoto = 3
u8 DataA = 0
u8 DataB = 0

u16 WordValue = 64
u16 DataC = 0

u8 Pattern[4]
u8 Board[8]
u8 Backup[8]

data FeatureData bytes 5,6,$0123

  text screen
  print at 9,0, "FEATURE TEST"
  screen on

  ByteValue <<= 3
  WordValue >>= 2
  print at 1,3, "B:"
  print ByteValue at 3,3 digits 2
  print at 10,3, "W:"
  print WordValue at 13,3 digits 2

  Pattern[0] = $41
  Pattern[1] = $42
  Pattern[2] = $43
  Pattern[3] = $44
  fill array Board repeating Pattern count 8
  copy Board count 8 to Backup
  reverse array Backup from 0 count 8
  put Board count 8 at 8,6
  put Backup count 8 at 8,7

  toggle Flag
  if Flag then
    print at 1,10, "BOOL PASS"
  else
    print at 1,10, "BOOL FAIL"
  end if

  restore FeatureData
  read DataA, DataB, DataC
  print DataA at 1,12 digits 1
  print DataB at 3,12 digits 1
  print DataC at 6,12 digits 4

  DrawMarker(22, 10, $5A)
  opt_chain
  if OptCount = 6 then
    print at 1,15, "CHAIN PASS"
  else
    print at 1,15, "CHAIN FAIL"
  end if
  ' compatibility check: indexed gosub remains supported for state-style dispatch
  on RouteGosub gosub add_one, add_two, add_three
  if OptCount = 8 then
    print at 1,16, "GOSUB PASS"
  else
    print at 1,16, "GOSUB FAIL"
  end if
  on RouteGoto goto route_done, route_fail, route_done
route_fail:
  print at 1,18, "ROUTE FAIL"
route_done:
  if RouteGoto = 3 then
    print at 1,17, "GOTO PASS"
  else
    print at 1,17, "GOTO FAIL"
  end if
  print OptCount at 10,18 digits 2


sub DrawMarker(u8 X, u8 Y, u8 Tile):
  put char Tile at X,Y
  return

sub opt_chain:
  OptCount = 0
  opt_a
  return

sub opt_a:
  OptCount += 1
  opt_b
  return

sub opt_b:
  OptCount += 1
  opt_c
  return

sub opt_c:
  OptCount += 1
  opt_d
  return

sub opt_d:
  OptCount += 1
  opt_e
  return

sub opt_e:
  OptCount += 1
  opt_f
  return

sub opt_f:
  OptCount += 1
  return

sub add_one:
  OptCount += 1
  return

sub add_two:
  OptCount += 2
  return

sub add_three:
  OptCount += 3
  return