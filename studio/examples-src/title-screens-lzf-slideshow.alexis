cartridge "TITLE CODEC LZF/AMY STUDIO/2026"

' Four ColecoVision homebrew title screens shown with one codec.
' Timing uses frame before/after upload picture ... with nmi.
' Wait one VBlank before timing; second upload is clean with NMI off.

u16 StartFrame = 0
u16 EndFrame = 0
u16 MazeFrames = 0
u16 JeepersFrames = 0
u16 SmurfFrames = 0
u16 StripFrames = 0

on vblank TitleCodecFrame

picture TitleMazeManiacLzf:
  pattern from "@project/maze-maniac.pattern.lzf" codec lzf
  color from "@project/maze-maniac.color.lzf" codec lzf
end picture

picture TitleJeepersCreepersLzf:
  pattern from "@project/jeepers-creepers.pattern.lzf" codec lzf
  color from "@project/jeepers-creepers.color.lzf" codec lzf
  name from "@project/jeepers-creepers.name.lzf" codec lzf
end picture

picture TitleSmurfChallengeLzf:
  pattern from "@project/smurf-challenge.pattern.lzf" codec lzf
  color from "@project/smurf-challenge.color.lzf" codec lzf
end picture

picture TitleStripPokerLzf:
  pattern from "@project/strip-poker.pattern.lzf" codec lzf
  color from "@project/strip-poker.color.lzf" codec lzf
end picture

  bitmap screen
  nmi on
  wait

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleMazeManiacLzf with nmi
  EndFrame = frame
  MazeFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleMazeManiacLzf
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleJeepersCreepersLzf with nmi
  EndFrame = frame
  JeepersFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleJeepersCreepersLzf
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleSmurfChallengeLzf with nmi
  EndFrame = frame
  SmurfFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleSmurfChallengeLzf
  nmi on
  screen on
  wait 120 frames

  screen off
  nmi on
  wait
  StartFrame = frame
  upload picture TitleStripPokerLzf with nmi
  EndFrame = frame
  StripFrames = EndFrame - StartFrame
  wait 2 frames
  nmi off
  upload picture TitleStripPokerLzf
  nmi on
  screen on
  wait 120 frames

  text screen
  print centered at 2, "TITLE CODEC RESULTS"
  print centered at 4, "LZF"
  print at 1,6, "IMG"
  print at 10,6, "FR"
  print at 15,6, "PAT"
  print at 23,6, "COL"
  print at 1,8, "MAZE"
  print MazeFrames at 10,8 digits 3
  print at 15,8, "1880"
  print at 23,8, "1535"
  print at 1,10, "JEEPERS"
  print JeepersFrames at 10,10 digits 3
  print at 15,10, "2672"
  print at 23,10, "754"
  print at 1,12, "SMURF"
  print SmurfFrames at 10,12 digits 3
  print at 15,12, "940"
  print at 23,12, "618"
  print at 1,14, "STRIP"
  print StripFrames at 10,14 digits 3
  print at 15,14, "3239"
  print at 23,14, "664"
  print centered at 17, "PAT/COL COMPRESSED BYTES"
  print centered at 20, "TIMED THEN CLEAN UPLOAD"
  print centered at 22, "DONE"
  screen on
done:
  goto done

sub TitleCodecFrame:
  return