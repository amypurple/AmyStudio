end data
data TileCol bytes
  $01,$17,$17,$17,$17,$17,$17,$17
  $01,$07,$07,$07,$07,$07,$07,$07
  $01,$07,$07,$07,$07,$F7,$F7,$07
  $01,$07,$07,$07,$07,$07,$07,$07
  $17,$17,$17,$17,$17,$17,$17,$17
  $07,$07,$F7,$07,$07,$F7,$07,$07
  $07,$07,$07,$07,$07,$07,$07,$07
  $07,$07,$07,$F7,$F7,$07,$07,$07
  $01,$1A,$1A,$1A,$1A,$1A,$1A,$1A
  $01,$0A,$0A,$BA,$0A,$0A,$0A,$0A
  $01,$0A,$0A,$0A,$0A,$BA,$0A,$0A
  $01,$0A,$0A,$0A,$0A,$0A,$0A,$0A
