record Fly:
  u8 Cx
  u8 Cy
  u8 Ox
  u8 Oy
end record

Fly Fs[16]
u8 Got[29]
u16 Seed = 12345
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u8 TzOn = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 Lives = 5
u8 Level = 1
u8 Skill = 1
u8 HLeft = 29
u8 Fr = 10
u8 PFr = 8
u8 BT = 10
u8 Grp = 0
u8 OffG[4]
u8 Over = 0
' the raider: state, cell, cell it came from, frames left of the glide
u8 St = StPlay
u8 Pc = StartC
u8 Pr = StartR
u8 Poc = StartC
u8 Por = StartR
u8 PT = 0
u8 Steps = 0
u8 Wing = 0
u8 DieT = 0
u8 ClrT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Pad = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Tick = 0
u8 Idle = 0
u8 Anim = 0
u8 Phase = 0
' loop counters (never shared with the helpers)
u8 Fi = 0
u8 Hi8 = 0
u8 Hr = 0
u8 Hc = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table RdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage

new_game:
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 1 then goto game_over
  if St = StClear then
    if ClrT >= ClearF then NextLevel
  end if
  goto play_loop

game_over:
  Phase = 4
  if Score > Hi then Hi = Score
  print at 10,12, " GAME OVER "
  mute all
  play sound SndOver
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the field (the name table holds the walls, the hearts and the gate)

' a 16-bit xorshift: the butterflies' ways
function Rnd as u8
  u8 Lo = 0
  Seed = Seed ^ (Seed << 7)
  Seed = Seed ^ (Seed >> 9)
  Seed = Seed ^ (Seed << 8)
  Lo = Seed & 255
  return Lo

' the tile in field cell Cc, Cr
function CellAt(u8 Cc, u8 Cr) as u8
  u8 T = 0
  T = get char at Cc + 2, Cr + 2
  return T

' frames per butterfly step on level L: 14, a frame less every two
' levels, 6 from level 17
function SpeedFor(u8 L) as u8
  u8 S = 0
  if L >= 17 then return 6
  S = L - 1
  S = 14 - S / 2
  return S

' pixels still to glide: T frames left of F
function Glide(u8 T, u8 F) as u8
  return (T * 8) / F

sub DrawField:
  for Hr = 0 to FH - 1
    W16 = Hr * FW
    for Hc = 0 to FW - 1
      V = FieldT[W16 + Hc]
      put char V at Hc + 2, Hr + 2
    next
  next
  ' hearts taken before a death stay taken
  HLeft = NHeart
  for Hi8 = 0 to NHeart - 1
    if Got[Hi8] = 1 then
      put char 32 at HeartC[Hi8] + 2, HeartR[Hi8] + 2
      dec HLeft
    end if
  next
  if HLeft = 0 then put char TOpen at 29, 12
  return
end sub

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  inc Anim
  select case St
  case StDie
    inc DieT
    if PT > 0 then dec PT
    if DieT >= DieF then LoseLife
    return
  case StClear
    inc ClrT
    if PT > 0 then dec PT
    return
  end select
  MovePlayer
  if St <> StPlay then return
  MoveFlies
  return
end sub

' the raider: a cell every PFr frames while the stick is held
sub MovePlayer:
  u8 Dc = 0
  u8 Dr = 0
  u8 Nc = 0
  u8 Nr = 0
  if PT > 0 then
    dec PT
    if PT > 0 then return
  end if
  V = Pad & 1
  if V > 0 then Dr = 255
  V = Pad & 2
  if V > 0 then Dr = 1
  V = Pad & 4
  if V > 0 then Dc = 255
  V = Pad & 8
  if V > 0 then Dc = 1
  V = Dc | Dr
  if V = 0 then return
  Nc = Pc + Dc
  Nr = Pr + Dr
  if TryMove(Nc, Nr, 1) = 1 then return
  if Dc = 0 then return
  if Dr = 0 then return
  ' a diagonal into a wall slides: up or down first, then sideways
  if TryMove(Pc, Nr, 0) = 1 then return
  V = TryMove(Nc, Pr, 0)
  return
end sub

' the raider steps into Nc, Nr if he can: 1 when something happened.
' Prim = 1 for the stick's own way (a butterfly there is death); the
' slides go only into a heart or an empty cell
function TryMove(u8 Nc, u8 Nr, u8 Prim) as u8
  u8 T = 0
  T = CellAt(Nc, Nr)
  select case T
  case TMark
    if Prim = 0 then return 0
    Caught
    return 1
  case THeart
    TakeHeart(Nc, Nr)
  case 32
  case else
    return 0
  end select
  Poc = Pc
  Por = Pr
  Pc = Nc
  Pr = Nr
  PT = PFr
  inc Steps
  if HLeft = 0 then
    if Pc = ExitC then
      if Pr = ExitR then
        St = StClear
        ClrT = 0
        Score += 500
        ShowScore
        play sound SndExit
      end if
    end if
  end if
  return 1

sub TakeHeart(u8 Tc, u8 Tr):
  u8 Q = 0
  put char 32 at Tc + 2, Tr + 2
  for Q = 0 to NHeart - 1
    if HeartC[Q] = Tc then
      if HeartR[Q] = Tr then Got[Q] = 1
    end if
  next
  dec HLeft
  Score += 10
  if HLeft = 0 then
    Score += 100
    put char TOpen at 29, 12
    play sound SndLast
  else
    play sound SndHeart
  end if
  ShowScore
  ShowLeft
  return
end sub

sub Caught:
  St = StDie
  DieT = 0
  play sound SndCrash
  play sound SndOuch
  return
end sub

' every Fr frames all the butterflies step, the last one first, four of
' them a frame (sixteen in one frame took more than two)
sub MoveFlies:
  u8 Top = 0
  u8 Bot = 0
  dec BT
  if BT = 0 then
    BT = Fr
    inc Wing
  end if
  Grp = Fr - BT
  if Grp >= 4 then return
  Top = 15 - Grp * 4
  Bot = Top - 3
  for Fi = Top to Bot step -1
    Fs[Fi].Ox = Fs[Fi].Cx
    Fs[Fi].Oy = Fs[Fi].Cy
    if St = StPlay then FStep(Fi)
  next
  return
end sub

' one butterfly: the raider next to it (up, left, right or down) and it
' pounces; else one random way, into an empty cell only
sub FStep(u8 B):
  u8 C = 0
  u8 R = 0
  u8 D = 0
  u8 Nc = 0
  u8 Nr = 0
  C = Fs[B].Cx
  R = Fs[B].Cy
  D = 9
  if C = Pc then
    V = R - Pr
    if V = 1 then D = 0
    if V = 255 then D = 3
  elseif R = Pr then
    V = C - Pc
    if V = 1 then D = 1
    if V = 255 then D = 2
  end if
  if D = 9 then
    D = Rnd() & 3
    Nc = C + DcT[D]
    Nr = R + DrT[D]
    if CellAt(Nc, Nr) <> 32 then return
    MoveFly(B, C, R, Nc, Nr)
    return
  end if
  MoveFly(B, C, R, Pc, Pr)
  Caught
  return
end sub

' butterfly B from cell C, R to cell Nc, Nr, its mark with it
sub MoveFly(u8 B, u8 C, u8 R, u8 Nc, u8 Nr):
  put char 32 at C + 2, R + 2
  Fs[B].Cx = Nc
  Fs[B].Cy = Nr
  put char TMark at Nc + 2, Nr + 2
  return
end sub

sub LoseLife:
  dec Lives
  ShowLives
  for Fi = 0 to NFly - 1
    put char 32 at Fs[Fi].Cx + 2, Fs[Fi].Cy + 2
  next
  if Lives = 0 then
    Over = 1
    return
  end if
  ResetRound
  DrawSprites
  Ready
  return
end sub

' the raider in the start pocket, the butterflies in their places
sub ResetRound:
  St = StPlay
  Pc = StartC
  Pr = StartR
  Poc = Pc
  Por = Pr
  PT = 0
  DieT = 0
  BT = Fr
  for Fi = 0 to NFly - 1
    Fs[Fi].Cx = FlyC[Fi]
    Fs[Fi].Cy = FlyR[Fi]
    Fs[Fi].Ox = FlyC[Fi]
    Fs[Fi].Oy = FlyR[Fi]
    put char TMark at FlyC[Fi] + 2, FlyR[Fi] + 2
  next
  return
end sub

sub Ready:
  Phase = 3
  print at 24,1, "READY"
  play sound SndStart
  Rearm
  wait 45 frames
  nmi off
  fill 32 count 5 at 24,1
  Phase = 1
  return
end sub

' ---------------------------------------------------------------------------
' levels and games

sub StartLevel:
  Phase = 2
  Fr = SpeedFor(Level)
  PFr = 5
  if Fr > 11 then PFr = Fr - 6
  NewScreen
  DrawField
  ShowHud
  ResetRound
  DrawSprites
  ShowScreen
  Ready
  return
end sub

sub ClearGot:
  for Hi8 = 0 to NHeart - 1
    Got[Hi8] = 0
  next
  return
end sub

sub NextLevel:
  if Level < 99 then inc Level
  ClearGot
  StartLevel
  return
end sub

sub NewGame:
  Score = 0
  Lives = 5
  Level = Skill
  Over = 0
  ClearGot
  StartLevel
  return
end sub

sub ShowHud:
  print at 9,1, "LV"
  put char THeart at 15,1
  put char TLife at 20,1
  ShowScore
  ShowLevel
  ShowLeft
  ShowLives
  return
end sub

sub ShowScore:
  print at 2,1, Score
  return
end sub

sub ShowLevel:
  NumU = Level
  print at 11,1, digits$(NumU, 2)
  return
end sub

sub ShowLeft:
  NumU = HLeft
  print at 16,1, digits$(NumU, 2)
  return
end sub

sub ShowLives:
  NumU = Lives
  print at 21,1, digits$(NumU, 1)
  return
end sub

' sprite 0 the raider, 1-16 the butterflies
sub DrawSprites:
  u8 C = 0
  u8 R = 0
  u8 Oc = 0
  u8 Orr = 0
  u8 Off = 0
  u8 Pat = 0
  u8 Col = 0
  Off = Glide(PT, PFr)
  X = Pc * 8 + 12
  Y = Pr * 8 + 11
  if Pc > Poc then
    X = X - Off
  elseif Pc < Poc then
    X = X + Off
  end if
  if Pr > Por then
    Y = Y - Off
  elseif Pr < Por then
    Y = Y + Off
  end if
  if St = StDie then
    V = DieT / 12
    V = V & 1
    Col = 11
    if V = 1 then Col = 8
    if DieT >= 72 then
      set sprite 0 to 192,0,0,0
    else
      set sprite 0 to Y,X,SBoom,Col
    end if
  else
    V = Steps & 1
    Pat = SRaid0 + V * 4
    set sprite 0 to Y,X,Pat,15
  end if
  ' the glide of each group of four (group K steps K frames after the first)
  for K = 0 to 3
    V = BT + K
    if V > Fr then V = V - Fr
    OffG[K] = Glide(V, Fr)
  next
  for Fi = 0 to NFly - 1
    C = Fs[Fi].Cx
    R = Fs[Fi].Cy
    Oc = Fs[Fi].Ox
    Orr = Fs[Fi].Oy
    X = C * 8 + 12
    Y = R * 8 + 11
    V = 15 - Fi
    Off = OffG[V >> 2]
    if C > Oc then
      X = X - Off
    elseif C < Oc then
      X = X + Off
    end if
    if R > Orr then
      Y = Y - Off
    elseif R < Orr then
      Y = Y + Off
    end if
    V = Wing + Fi
    V = V & 1
    Pat = SFly0 + V * 4
    Col = FlyCol[Fi & 3]
    set sprite Fi + 1 to Y,X,Pat,Col
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  Pad = J1 | J2
  Btn = Pad & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the name in big letters, the rules, the skill, the tune once
sub TitlePage:
  Phase = 5
  NewScreen
  for Hc = 0 to 7
    V = TTtl00 + Hc
    put char V at Hc + 12, 3
    V = TTtl10 + Hc
    put char V at Hc + 12, 4
  next
  print at 9,6, "AHOY! MAY 1985"
  print at 8,7, "AFTER LARRY COATS"
  print at 3,9, "TAKE ALL THE HEARTS, DODGE"
  print at 2,10, "THE BUTTERFLIES, THEN LEAVE"
  print at 2,11, "BY THE GATE ON THE RIGHT."
  put char THeart at 6,13
  print at 8,13, "10  LAST ONE +100"
  put char TOpen at 6,15
  print at 8,15, "EXIT 500"
  print at 9,17, "SKILL"
  print at 9,19, "HIGH ", Hi
  print at 8,21, "PRESS THE BUTTON"
  ShowSkill
  for Fi = 0 to 3
    X = TitleX[Fi]
    K = FlyCol[Fi]
    set sprite Fi + 1 to 23,X,SFly0,K
  next
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Phase = 6
tp_loop:
  Frame1
  ReadPad
  inc Anim
  V = Rnd()
  V = Pad & 12
  if V > 0 then
    if WasStick = 0 then
      if V = 4 then
        if Skill > 1 then dec Skill
      else
        if Skill < 9 then inc Skill
      end if
      ShowSkill
      play sound SndTick
    end if
  end if
  WasStick = V
  V = Anim & 15
  if V = 0 then
    for Fi = 0 to 3
      J = Anim >> 4
      J = J + Fi
      J = J & 1
      K = SFly0 + J * 4
      X = TitleX[Fi]
      set sprite Fi + 1 to 23,X,K,FlyCol[Fi]
    next
    update sprites
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub ShowSkill:
  NumU = Skill
  print at 15,17, "< ", digits$(NumU, 1), " >"
  return
end sub

sub CreditsPage:
  Phase = 7
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 13,2, "RAID"
  print at 2,4, "BASED ON RAID BY LARRY"
  print at 2,5, "COATS, AHOY! MAY 1985"
  print at 2,6, "(COMMODORE 64)."
  print at 2,8, "COLECOVISION GAME, MUSIC"
  print at 2,9, "AND PICTURES BY CLAUDE"
  print at 2,10, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,11, "IN AMY BY AMY BIENVENU,"
  print at 2,12, "2026."
  print at 2,14, "MUSIC: WINGS OVER THE MAZE"
  print at 2,15, "(ORIGINAL)"
  print at 2,17, "TAKE EVERY HEART, KEEP AWAY"
  print at 2,18, "FROM THE BUTTERFLIES AND"
  print at 2,19, "GET OUT ON THE RIGHT!"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Phase = 8
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

