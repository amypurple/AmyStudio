asm {
KlFlick:
    db $00,$00,$23,$01,$00,$00,$54,$01,$10
KlDeal:
    db $00,$00,$14,$02,$00,$00,$35,$02,$00,$00,$66,$03,$10
KlLay:
    db $40,$71,$20,$02,$40,$5A,$40,$04,$50
KlBuzz:
    db $40,$FF,$13,$08,$40,$FF,$33,$08,$50
KlPick:
    db $80,$8F,$20,$02,$80,$6B,$40,$03,$90
KlFlip:
    db $80,$50,$30,$02,$80,$3C,$50,$03,$90
KlHome:
