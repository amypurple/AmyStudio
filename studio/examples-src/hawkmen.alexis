data VicCol bytes 1,15,8,7,13,2,4,11

asm {
HkThrum:
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01,$00,$00,$15,$01,$00,$00,$16,$01
    db $00,$00,$15,$01,$00,$00,$16,$01,$10
HkDive:
    db $80,$71,$23,$02,$90
HkClimb:
    db $80,$42,$21,$02,$90
HkStone:
    db $40,$7B,$10,$01,$40,$61,$10,$01,$40,$4C,$10,$01,$40,$38,$10,$01,$50
HkTongue:
    db $C0,$54,$20,$01,$C0,$46,$20,$01,$C0,$38,$20,$01,$D0
HkGulp:
    db $40,$D5,$10,$04,$50
HkCrash:
    db $C0,$E0,$10,$01,$C0,$1F,$11,$01,$C0,$75,$11,$01,$C0,$F8,$11,$01,$D0

HkSoundTable:
    dw HkThrum,$702B
    dw HkDive,$703F
    dw HkClimb,$703F
    dw HkStone,$7035
    dw HkTongue,$7049
    dw HkGulp,$7035
    dw HkCrash,$7049
    dw HkTuneMel,$703F
    dw HkTuneBass,$7049
; Wings over Dindrin, E minor (original for this game)
; Tiny Sound, 7 frames per step
HkTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$30,$1A,$21,$17,$01,$01,$01,$1A,$01,$1E,$01,$23,$01,$01,$01
    db $21,$01,$1E,$01,$1F,$01,$01,$01,$1E,$01,$1C,$01,$1A,$01,$01,$01
    db $00,$01,$01,$01,$1C,$01,$01,$01,$1F,$01,$23,$01,$26,$01,$01,$01
    db $25,$01,$23,$01,$21,$01,$01,$01,$1E,$01,$01,$01,$00,$01,$01,$01
    db $01,$01,$01,$01,$23,$01,$01,$01,$21,$01,$1E,$01,$26,$01,$01,$01
    db $25,$01,$23,$01,$21,$01,$1F,$01,$1E,$01,$1C,$01,$1E,$01,$01,$01
    db $00,$01,$01,$01,$1F,$01,$01,$01,$1E,$01,$1C,$01,$1A,$01,$01,$01
    db $19,$01,$1A,$01,$17,$01,$01,$01,$01,$01,$01,$01,$00,$01,$01,$01
    db $01,$01,$01,$01
    db $FF
HkTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$60,$18,$32,$0B,$01,$01,$01,$06,$01,$01,$01,$0B,$01,$01,$01
    db $06,$01,$01,$01,$04,$01,$01,$01,$0B,$01,$01,$01,$07,$01,$01,$01
    db $0E,$01,$01,$01,$04,$01,$01,$01,$0B,$01,$01,$01,$07,$01,$01,$01
    db $0E,$01,$01,$01,$06,$01,$01,$01,$0D,$01,$01,$01,$06,$01,$01,$01
    db $09,$01,$01,$01,$07,$01,$01,$01,$0E,$01,$01,$01,$0B,$01,$01,$01
    db $06,$01,$01,$01,$09,$01,$01,$01,$04,$01,$01,$01,$0E,$01,$01,$01
    db $09,$01,$01,$01,$04,$01,$01,$01,$0B,$01,$01,$01,$06,$01,$01,$01
    db $0A,$01,$01,$01,$0B,$01,$01,$01,$06,$01,$01,$01,$0B,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
; the title song: both voices of the tune at once
HkSong:
    dw $0001
    db $40+8,9
    dw $0000

; HkLatch: read the VDP status (resets the address latch)
HkLatch:
    in a,($BF)
    ret

; HkBack: the backdrop (VDP register 7) to the colour V
HkBack:
    ld a,(AMY_UVAR_V)
    out ($BF),a
    ld a,$87
    out ($BF),a
    ret

; HkCell: HL = the name table address of the VIC screen offset B (22
; columns): row B/22 + 1, column B%22 + 5
HkCell:
    ld hl,(AMY_UVAR_B)
    ld de,22
    ld b,0
HkCellDiv:
    or a
    sbc hl,de
    jr c,HkCellRem
    inc b
    jr HkCellDiv
HkCellRem:
    add hl,de
    ld a,l
    add a,5
    ld c,a
    inc b
    ld l,b
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld e,c
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ret

; HkGet: Tp the tile at B, Kd Kc the VIC character and colour it stands for
HkGet:
    call HkCell
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld (AMY_UVAR_Tp),a
    cp 128
    jr nc,HkGetT
    ld a,32
    ld (AMY_UVAR_Kd),a
    xor a
    ld (AMY_UVAR_Kc),a
    ret
HkGetT:
    sub 128
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_KindT
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Kd),a
    ld hl,AMY_UDATA_ColT
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Kc),a
    ret

; HkEnc: Tl the tile of the VIC character Ch in the colour Cl
HkEnc:
    ld a,(AMY_UVAR_Ch)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Cl)
    and 7
    ld e,a
    ld d,0
    add hl,de
    ld de,AMY_UDATA_Enc
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Tl),a
    ret

; HkPut: the VIC character Ch in the colour Cl at B (POKE B and its colour)
HkPut:
    call HkEnc
    call HkCell
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_Tl)
    out ($BE),a
    ret

; HkColRange: the colour byte V for the Tcn tiles from Tcf (colour table)
HkColRange:
    ld a,(AMY_UVAR_Tcf)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,$2000
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,(AMY_UVAR_Tcn)
    add a,a
    add a,a
    add a,a
    ld b,a
    ld a,(AMY_UVAR_V)
HkCrLoop:
    out ($BE),a
    nop
    nop
    nop
    djnz HkCrLoop
    ret

; HkFlip: the floaters', lizards' (and the hawkman's blank cell's) view Av
; into their tiles 136-152, in the three thirds (just after the wait)
HkFlip:
    ld a,(AMY_UVAR_Av)
    or a
    ld hl,AMY_UDATA_FlipA
    jr z,HkFl1
    ld hl,AMY_UDATA_FlipB
HkFl1:
    ld de,$0440
    call HkFlW
    ld de,$0C40
    call HkFlW
    ld de,$1440
HkFlW:
    push hl
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld b,136
    ld c,$BE
HkFlB:
    outi
    nop
    nop
    jr nz,HkFlB
    pop hl
    ret

; FontTilesG / FontTilesP: each font character of the bank's table (third
; 0 of the pattern table) copied into its tile, in the three thirds
FontTilesG:
    ld hl,FontTabG
    jr FtNext
FontTilesP:
    ld hl,FontTabP
FtNext:
    ld a,(hl)
    or a
    ret z
    inc hl
    ld e,a
    ld a,(hl)
    inc hl
    push hl
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push hl
    ld l,e
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ex de,hl
    pop hl
    ld b,8
FtByte:
    ld a,e
    out ($BF),a
    ld a,d
    out ($BF),a
    nop
    nop
    nop
    in a,($BE)
    ld c,a
    push hl
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    ld a,h
    add a,8
    ld h,a
    call FtPut
    pop hl
    inc hl
    inc de
    djnz FtByte
    pop hl
    jr FtNext
FtPut:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    nop
    nop
    ld a,c
    out ($BE),a
    ret
FontTabG:
