u32 U32Min = 0
u32 U32Max = 4294967295
i32 S32Min = -2147483648
i32 S32Max = 2147483647
u16 U16Min = 0
u16 U16Max = 65535
i16 S16Min = -32768
i16 S16Max = 32767
u8 U8Min = 0
u8 U8Max = 255
i8 S8Min = -128
i8 S8Max = 127
fixed FxMin = raw $FF80
ufixed FxMax = raw $FF80
bcd digits 6 BcdMin
bcd digits 6 BcdMax
i16 CastI16 = 0
i32 CastI32 = 0
u8 T1 = 0
u8 T2 = 0
u8 T3 = 0
u8 T4 = 0
u8 T5 = 0
u8 T6 = 0
u8 T7 = 0
u8 T8 = 0

' Amy Numeric Edge Cases Demo
  text screen
  seed_values
  run_demo
  screen on

sub seed_values:
  clear BcdMin
  clear BcdMax
  BcdMax += 999999
  return

sub run_demo:
  print at 5,0, "NUMERIC EDGE CASES"
  print at 1,2, "U8L"
  print U8Min at 5,2 digits 3
  print at 11,2, "U8H"
  print U8Max at 16,2 digits 3
  print at 1,3, "S8L"
  print S8Min at 5,3 digits 4
  print at 11,3, "S8H"
  print S8Max at 16,3 digits 4
  print at 1,4, "U16L"
  print U16Min at 5,4 digits 5
  print at 11,4, "U16H"
  print U16Max at 16,4 digits 5
  print at 1,5, "S16L"
  print S16Min at 5,5 digits 6
  print at 11,5, "S16H"
  print S16Max at 17,5 digits 6
  print at 1,6, "U32L"
  print U32Min at 6,6
  print at 1,7, "U32H"
  print U32Max at 6,7
  print at 1,8, "S32L"
  print S32Min at 6,8 digits 11
  print at 1,9, "S32H"
  print S32Max at 6,9 digits 11
  print at 1,10, "BCD"
  print BcdMin at 5,10
  print BcdMax at 12,10
  print at 1,11, "FX / UFX"
  print FxMin at 5,11
  print FxMax at 12,11

  CastI16 = S8Min
  CastI32 = S16Min
  if U8Min < U8Max then
    T1 = 1
  end if
  if signed S8Min < S8Max then
    T2 = 1
  end if
  if U16Min < U16Max then
    T3 = 1
  end if
  if signed S16Min < S16Max then
    T4 = 1
  end if
  if U32Min < U32Max then
    T5 = 1
  end if
  if signed S32Min < S32Max then
    T6 = 1
  end if
  if signed CastI16 = -128 then
    T7 = 1
  end if
  if signed CastI32 = -32768 then
    T8 = 1
  end if

  print at 1,13, "CHECKS"
  print at 1,14, "u8 0<255"
  print at 1,15, "s8 lo<hi"
  print at 1,16, "u16 0<mx"
  print at 1,17, "s16 lo<hi"
  print at 1,18, "u32 0<mx"
  print at 1,19, "s32 lo<hi"
  print at 1,20, "i8->i16"
  print CastI16 at 9,20 digits 6
  print at 1,21, "i16->i32"
  print CastI32 at 9,21 digits 11

  if T1 then
    print at 24,14, "PASS"
  else
    print at 24,14, "FAIL"
  end if
  if T2 then
    print at 24,15, "PASS"
  else
    print at 24,15, "FAIL"
  end if
  if T3 then
    print at 24,16, "PASS"
  else
    print at 24,16, "FAIL"
  end if
  if T4 then
    print at 24,17, "PASS"
  else
    print at 24,17, "FAIL"
  end if
  if T5 then
    print at 24,18, "PASS"
  else
    print at 24,18, "FAIL"
  end if
  if T6 then
    print at 24,19, "PASS"
  else
    print at 24,19, "FAIL"
  end if
  if T7 then
    print at 24,20, "PASS"
  else
    print at 24,20, "FAIL"
  end if
  if T8 then
    print at 24,21, "PASS"
  else
    print at 24,21, "FAIL"
  end if
  return