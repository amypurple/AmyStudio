record Car:
  u8 Y
  u8 X
  u8 Lane
  u8 Spd
  u8 Ay
  u8 Kind
end record

' a timer for the title tune
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Va = 0
u16 Score = 0
u16 Hi = 0
u16 LapRows = 0
u8 Phase = 0
u8 Over = 0
' the player's car
u8 Spd = 58
u8 PX = 104
u8 PY = 132
u8 Drift = 32
u8 DriftA = 0
u16 Acc = 0
u8 Crashes = 0
' the clock
u8 TimeU = 71
u8 TimeC = 0
u8 TUnit = 150
u8 Lap = 1
u8 Stage = 0
u8 Sty = 0
' the road: one entry a screen row (rows 1-22), Head is the top row
u8 RRx[22]
u8 RTy[22]
u8 RDc[22]
u8 RDt[22]
u8 Head = 0
u8 RowN = 0
u8 Bend = 0
u8 Dir = 1
u8 CurRX = 54
u8 FinPend = 0
u8 FinOn = 0
u8 FinR = 0
u8 Dirty = 0
u8 HudD = 0
u8 PRow = 0
u8 PRx = 0
Car Cr[4]
' engine sound bytes (EngOut)
u8 EngLo = $C0
u8 EngHi = 0
u8 EngVol = $DF
' input: J the stick (1 up, 2 down, 4 left, 8 right, 16 a button)
u8 J = 0
u8 Pads = 0
u8 OldPads = 0
u8 Tick = 0
u8 Idle = 0
u8 Sel = 0
' the HOW TO PLAY page and its idle timer (globals: this program has
' `call asm`, so no locals in the subs that draw screens)
u8 HtPg = 0
u16 HtWt = 0
u8 HtX = 0
u8 HtY = 0
u8 HtT = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Cj = 0
u8 Ti = 0
u8 Bi = 0
' scratch
u8 C = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Lx = 0
u8 Tx = 0
u8 NewS = 0

  tile screen
  set sound table RaSoundTable areas 6
  sprites 16x16
  sprites stable 0 to 0
  sprites flicker on
  set sprite count 5
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 1 then
    HowToPage
    goto title
  end if
  if Sel = 2 then
    CreditsPage
    goto title
  end if
  RunGame
  ' the end: GAME OVER over the road, then back to the title on a press
  EngMute
  HideSprites
  print at 5,MsgRow, "                "
  print at 5,MsgRow + 1, "   TIME IS UP   "
  print at 5,MsgRow + 2, "                "
  print at 5,MsgRow + 3, "   GAME  OVER   "
  print at 5,MsgRow + 4, "                "
  if Score > Hi then
    Hi = Score
    print at 5,MsgRow + 5, " NEW HIGH SCORE "
    print at 5,MsgRow + 6, "                "
  end if
  DrawHud
  mute all
  play sound SndOver
  Phase = 4
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' a game: laps until the clock runs out

sub RunGame:
  Score = 0
  Lap = 1
  TUnit = 150
  TimeU = FullT
  TimeC = 0
  Crashes = 0
  Over = 0
  NewRoad
  DrawPlay
  print at 7,MsgRow, " GET READY "
  ShowScreen
  for Ti = 1 to 60
    Frame1
  next
  play sound SndGo
  for Ti = 1 to 50
    Frame1
  next
  Dirty = 1
  Phase = 1
rg_loop:
  Frame1
  ReadPads
  J = Pads
  PlayStep
  DrawAll
  if Phase = 2 then CrashSeq
  if Phase = 3 then Checkpoint
  if Over = 0 then goto rg_loop
  return
end sub

' a straight road in the middle, the car at 58 MPH, no traffic, day
sub NewRoad:
  CurRX = 60
  Bend = 8
  Dir = 1
  RowN = 0
  Head = 0
  for Ri = 0 to 21
    RRx[Ri] = CurRX
    V = Ri & 2
    if V = 0 then
      RTy[Ri] = 0
    else
      RTy[Ri] = 1
    end if
    RDc[Ri] = 0
    RDt[Ri] = 0
  next
  for Ci = 0 to NCar - 1
    Cr[Ci].Y = 0
  next
  LapRows = 0
  Stage = 0
  Sty = 0
  FinPend = 0
  FinOn = 0
  Spd = StartS
  PX = CurRX + 36
  Drift = 32
  DriftA = 0
  Acc = 0
  SetPY
  return
end sub

sub SetPY:
  V = 120 - Spd
  PY = 116 + (V >> 2)
  return
end sub

' one pass of play
sub PlayStep:
  ' speed: up +1, down -1, a button -3 MPH a frame
  if (J & 1) <> 0 then
    if Spd < MaxS then inc Spd
  end if
  if (J & 2) <> 0 then
    if Spd > MinS then dec Spd
  end if
  if (J & 16) <> 0 then
    if Spd >= MinS + 3 then
      Spd = Spd - 3
    else
      Spd = MinS
    end if
  end if
  Steer
  SetPY
  ' the road: MPH / 240 rows a frame
  Acc = Acc + Spd
  if Acc >= 240 then
    Acc = Acc - 240
    ScrollRow
  end if
  KerbCheck
  if Phase <> 1 then return
  MoveCars
  if Phase <> 1 then return
  SpawnCar
  ' the clock
  inc TimeC
  if TimeC >= TUnit then
    TimeC = 0
    TakeTime
  end if
  ' the checkpoint line under the car
  if FinOn = 1 then
    if FinR >= PRow then Phase = 3
  end if
  EngSet
  return
end sub

sub TakeTime:
  if TimeU > 0 then dec TimeU
  HudD = HudD | 2
  if TimeU < 9 then play sound SndLow
  if TimeU = 0 then Over = 1
  return
end sub

' left/right a pixel a frame; on ice a slide (Drift 32 = straight, 14..50)
sub Steer:
  if Sty = 3 then
    if (J & 4) <> 0 then
      if Drift > 14 then dec Drift
    end if
    if (J & 8) <> 0 then
      if Drift < 50 then inc Drift
    end if
    V = J & 12
    if V = 0 then
      V = Tick & 3
      if V = 0 then
        if Drift < 32 then inc Drift
        if Drift > 32 then dec Drift
      end if
    end if
    if Drift >= 32 then
      V = Drift - 32
    else
      V = 32 - Drift
    end if
    DriftA = DriftA + V
    if DriftA >= 12 then
      DriftA = DriftA - 12
      if Drift > 32 then
        if PX < 176 then inc PX
      else
        if PX > 16 then dec PX
      end if
    end if
  else
    Drift = 32
    if (J & 4) <> 0 then
      if PX > 16 then dec PX
    end if
    if (J & 8) <> 0 then
      if PX < 176 then inc PX
    end if
  end if
  return
end sub

' the ring row under screen row R (0-21)
function RingOf(u8 R) as u8
  T = Head + R
  if T >= 22 then T = T - 22
  return T

' the kerb: the body (PX+2..PX+13) on the kerb is slowed (2 MPH a frame);
' 6 pixels into it or more is a crash
sub KerbCheck:
  V = PY + 8
  PRow = (V >> 3) - 1
  K = RingOf(PRow)
  PRx = RRx[K]
  Lx = PX + 2
  Tx = PX + 13
  V = PRx + 2
  if Lx < V then
    Phase = 2
    return
  end if
  V = PRx + 85
  if Tx > V then
    Phase = 2
    return
  end if
  V = PRx + 8
  if Lx < V then KerbSlow
  V = PRx + 79
  if Tx > V then KerbSlow
  return
end sub

sub KerbSlow:
  if Spd >= MinS + 2 then
    Spd = Spd - 2
  else
    Spd = MinS
  end if
  Drift = 32
  V = Tick & 7
  if V = 0 then play sound SndRumble
  return
end sub

' a new row at the top: the road bends, dashes, roadside things, the
' checkpoint line; the cars move down with the road
sub ScrollRow:
  if Head = 0 then
    Head = 21
  else
    dec Head
  end if
  inc LapRows
  V = LapRows & 3
  if V = 0 then
    inc Score
    HudD = HudD | 1
  end if
  if LapRows = LapLen then FinPend = 1
  V = LapRows & 511
  if V = 0 then
    if LapRows < LapLen then NextStage
  end if
  ' the bend
  if Bend = 0 then
    Rand
    Dir = Rs % 3
    Rand
    V = Rs & 31
    Bend = V + 4
  end if
  dec Bend
  if Dir = 0 then
    if CurRX > RXMin then
      dec CurRX
    else
      Dir = 2
    end if
  end if
  if Dir = 2 then
    if CurRX < RXMax then
      inc CurRX
    else
      Dir = 0
    end if
  end if
  RRx[Head] = CurRX
  RDc[Head] = 0
  inc RowN
  if FinPend = 1 then
    FinPend = 0
    FinOn = 1
    FinR = 0
    RTy[Head] = 2
  else
    if FinOn = 1 then inc FinR
    V = RowN & 2
    if V = 0 then
      RTy[Head] = 0
    else
      RTy[Head] = 1
    end if
    Decor
  end if
  Dirty = 1
  return
end sub

' the cars move down with the road (done with the drawing, a frame after
' the scroll, so that the cars and the road move together)
sub CarsDown:
  for Ci = 0 to NCar - 1
    if Cr[Ci].Y > 0 then
      V = Cr[Ci].Y + 8
      if V > 168 then
        Cr[Ci].Y = 0
      else
        Cr[Ci].Y = V
      end if
    end if
  next
  return
end sub

' one roadside thing in about one row of eight, on the grass
sub Decor:
  Rand
  V = Rs & 7
  if V <> 0 then return
  RDt[Head] = TTree + ((Rs >> 3) & 1)
  V = Rs >> 8
  if (V & 1) = 0 then
    ' left: columns 2 .. RX / 8 - 1
    N = (CurRX >> 3) - 2
    C = (V >> 1) % N
    RDc[Head] = 2 + C
  else
    ' right: columns (RX + 95) / 8 .. 23
    W16 = CurRX + 95
    T = W16 >> 3
    N = 24 - T
    C = (V >> 1) % N
    RDc[Head] = T + C
  end if
  return
end sub

sub NextStage:
  Stage = LapRows >> 9
  Sty = StTab[Stage]
  ApplyStyle
  play sound SndStage
  HudD = HudD | 4
  return
end sub

' the stretch's colours (road tiles) and roadside things
sub ApplyStyle:
  Va = Sty * NRoad8
  copy StageCol + Va count NRoad8 to vram.color + 1024
  W16 = Sty * 16
  copy DecorPat + W16 count 16 to vram.pattern + TTree * 8
  copy DecorPat + W16 count 16 to vram.pattern + 2048 + TTree * 8
  copy DecorPat + W16 count 16 to vram.pattern + 4096 + TTree * 8
  copy DecorCol + W16 count 16 to vram.color + TTree * 8
  if Sty = 2 then
    backdrop black
  else
    backdrop black
  end if
  return
end sub

' ---------------------------------------------------------------------------
' the other cars

sub MoveCars:
  for Ci = 0 to NCar - 1
    Y = Cr[Ci].Y
    if Y > 0 then
      ' their own speed up the road: Spd / 30 pixels a frame
      V = Cr[Ci].Ay + Cr[Ci].Spd
      while V >= 30
        V = V - 30
        dec Y
      end while
      Cr[Ci].Ay = V
      if Y < 8 then
        Cr[Ci].Y = 0
      else
        Cr[Ci].Y = Y
        CarSteer(Ci)
        Follow(Ci)
        HitCheck(Ci)
      end if
    end if
  next
  return
end sub

' along the road in its lane (a pixel a frame), sometimes another lane
sub CarSteer(u8 I):
  Y = Cr[I].Y
  V = Y + 8
  T = (V >> 3) - 1
  if T > 21 then T = 21
  K = RingOf(T)
  Tx = RRx[K] + 12 + Cr[I].Lane * 24
  X = Cr[I].X
  if X < Tx then inc X
  if X > Tx then dec X
  Cr[I].X = X
  Rand
  V = Rs & 255
  if V = 0 then
    N = Cr[I].Lane
    if (Rs & 256) = 0 then
      if N > 0 then dec N
    else
      if N < 2 then inc N
    end if
    if LaneFree(N, Y, I) = 1 then Cr[I].Lane = N
  end if
  return
end sub

' 1 when no other car in lane L is within 32 pixels of Y
function LaneFree(u8 L, u8 Yy, u8 Me) as u8
  K = 1
  for Cj = 0 to NCar - 1
    if Cj <> Me then
      if Cr[Cj].Y > 0 then
        if Cr[Cj].Lane = L then
          if Cr[Cj].Y >= Yy then
            V = Cr[Cj].Y - Yy
          else
            V = Yy - Cr[Cj].Y
          end if
          if V < 32 then K = 0
        end if
      end if
    end if
  next
  return K

' a car close behind another in its lane takes its speed
sub Follow(u8 I):
  Y = Cr[I].Y
  for Cj = 0 to NCar - 1
    if Cj <> I then
      T = Cr[Cj].Y
      if T > 0 then
        if Cr[Cj].Lane = Cr[I].Lane then
          if T < Y then
            V = Y - T
            if V < 24 then
              if Cr[Cj].Spd < Cr[I].Spd then Cr[I].Spd = Cr[Cj].Spd
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub HitCheck(u8 I):
  X = Cr[I].X
  Y = Cr[I].Y
  if X >= PX then
    V = X - PX
  else
    V = PX - X
  end if
  if V >= 12 then return
  if Y >= PY then
    V = Y - PY
  else
    V = PY - Y
  end if
  if V < 14 then Phase = 2
  return
end sub

' about one try in 64 frames for a new car in a free slot: faster than
' the player enters at the bottom (never under the player), slower at the top
sub SpawnCar:
  Rand
  V = Rs & 63
  if V <> 0 then return
  Bi = 255
  for Ci = 0 to NCar - 1
    if Cr[Ci].Y = 0 then Bi = Ci
  next
  if Bi = 255 then return
  V = Rs >> 6
  N = V % 3
  Rand
  V = Rs & 63
  NewS = V % 36 + 35
  V = NewS + 4
  if Spd >= V then
    Y = 8
  else
    V = Spd + 4
    if NewS < V then return
    Y = 168
  end if
  if LaneFree(N, Y, 255) = 0 then return
  V = Y + 8
  C = (V >> 3) - 1
  K = RingOf(C)
  Tx = RRx[K] + 12 + N * 24
  if Y = 168 then
    if Tx >= PX then
      V = Tx - PX
    else
      V = PX - Tx
    end if
    if V < 24 then return
  end if
  Cr[Bi].Y = Y
  Cr[Bi].X = Tx
  Cr[Bi].Lane = N
  Cr[Bi].Spd = NewS
  Cr[Bi].Ay = 0
  Cr[Bi].Kind = (Rs >> 8) & 3
  return
end sub

' ---------------------------------------------------------------------------
' a crash: the car spins (a quarter turn every 4 frames), the clock loses a
' piece, the car goes back to the middle at 58 MPH, the other cars vanish

sub CrashSeq:
  inc Crashes
  EngMute
  play sound SndCrash
  play sound SndSpin
  for Ti = 0 to 63
    V = (Ti >> 2) & 3
    T = SCar + V * 4
    set sprite 0 to PY,PX,T,15
    update sprites
    Frame1
  next
  TakeTime
  Spd = StartS
  Drift = 32
  DriftA = 0
  SetPY
  V = PY + 8
  PRow = (V >> 3) - 1
  K = RingOf(PRow)
  PX = RRx[K] + 36
  for Ci = 0 to NCar - 1
    Cr[Ci].Y = 0
  next
  if Over = 0 then Phase = 1
  DrawSprites
  return
end sub

' the checkpoint: 100 points for every piece of time left, the bar refilled,
' the next lap's pieces 20 frames shorter
sub Checkpoint:
  FinOn = 0
  EngMute
  play sound SndCheck
  print at 6,MsgRow, "  CHECKPOINT  "
  NumU = Lap
  print at 6,MsgRow + 1, "  LAP " + digits$(NumU, 2) + " DONE  "
  for Ti = 1 to 40
    Frame1
  next
  while TimeU > 0
    dec TimeU
    Score = Score + 100
    play sound SndTick
    DrawHud
    Frame1
    Frame1
  end while
  for Ti = 1 to 40
    Frame1
  next
  TimeU = FullT
  TimeC = 0
  if TUnit >= 70 then TUnit = TUnit - 20
  inc Lap
  LapRows = 0
  Stage = 0
  Sty = 0
  ApplyStyle
  Phase = 1
  Dirty = 1
  DrawHud
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a scroll is drawn in the next pass (a scroll and its drawing in one pass
' took longer than a frame; at 117 MPH there is never a scroll two frames
' in a row); the status is updated in the other passes
sub DrawAll:
  if Dirty = 1 then
    Dirty = 0
    DrawRoad
    CarsDown
    DrawSprites
    return
  end if
  DrawSprites
  if HudD <> 0 then
    if (HudD & 1) <> 0 then ShowScore
    if (HudD & 2) <> 0 then ShowTime
    if (HudD & 4) <> 0 then DrawHud
    HudD = 0
  else
    ' the speed every frame it changes is too much: every fourth frame
    V = Tick & 3
    if V = 0 then ShowMph
  end if
  return
end sub

' 22 rows, each a 22-byte template from ROM, plus its roadside thing
' (RaRoad, below: the Amy loop with a copy a row took longer than a frame)
sub DrawRoad:
  call asm RaRoad
  return
end sub

sub DrawSprites:
  set sprite 0 to PY,PX,SCar,15
  for Ci = 0 to NCar - 1
    Y = Cr[Ci].Y
    N = Ci + 1
    if Y = 0 then
      set sprite N to 207,0,0,0
    else
      K = Cr[Ci].Kind
      if Sty = 2 then
        T = SLights
        C = 8
      else
        T = SCar
        if K = 3 then T = SVan
        C = CarDayCol[K]
        if Sty = 1 then C = CarCol[K]
      end if
      X = Cr[Ci].X
      set sprite N to Y,X,T,C
    end if
  next
  update sprites
  return
end sub

sub ShowMph:
  NumU = Spd
  print at 25,9, digits$(NumU, 3)
  return
end sub

sub ShowScore:
  print at 24,6, digits$(Score, 5)
  return
end sub

sub DrawHud:
  print at 24,3, digits$(Hi, 5)
  ShowScore
  ShowMph
  ShowTime
  NumU = Lap
  print at 25,15, digits$(NumU, 2)
  select case Sty
  case 0
    print at 24,17, " DAY  "
  case 1
    print at 24,17, "DESERT"
  case 2
    print at 24,17, "NIGHT "
  case else
    print at 24,17, " ICE  "
  end select
  return
end sub

' the time bar: 71 pieces on 48 pixels
sub ShowTime:
  W16 = TimeU * 2
  V = W16 / 3
  for Bi = 0 to 5
    if V >= 8 then
      T = TBar8
      V = V - 8
    else
      T = TBar0 + V
      V = 0
    end if
    put char T at 24 + Bi,12
  next
  return
end sub

sub DrawPlay:
  NewScreen
  ApplyStyle
  print at 24,2, "HI"
  print at 24,5, "SCORE"
  print at 24,8, "MPH"
  print at 24,11, "TIME"
  print at 24,14, "LAP"
  print at 24,20, "RACE"
  print at 26,21, "ACE"
  DrawRoad
  DrawHud
  DrawSprites
  return
end sub

' ---------------------------------------------------------------------------
' the engine: tone channel 3, higher with the speed

sub EngSet:
  W16 = Spd * 7
  W16 = 1000 - W16
  V = W16 & 15
  EngLo = V | $C0
  W16 = W16 >> 4
  EngHi = W16
  EngVol = $D9
  call asm RaEngOut
  return
end sub

sub EngMute:
  EngVol = $DF
  call asm RaEngOut
  return
end sub

' ---------------------------------------------------------------------------

' xorshift: Rs ^= Rs << 7, Rs ^= Rs >> 9, Rs ^= Rs << 8 (RaRand)
sub Rand:
  call asm RaRand
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' a catch-up wait (from games/eagles and games/xroads2): the NMI flag is
' cleared before re-arming, so that a pass that ends a little after the
' frame began (a scroll's drawing at full speed, now and then) still gets
' that frame; Amy's wait clears it after re-arming and lost the frame
sub Frame1:
  call asm RaClr
  Rearm
  Idle = 1
  call asm RaPoll
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 5
  for K = 0 to 4
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: RACE ACE in red and chequered blocks, START / CREDITS, the
' tune once

sub TitlePage:
  Phase = 0
  EngMute
  NewScreen
  copy LogoMap count 512 to vram.name + 64
  NumU = Hi
  print at 9,18, "HIGH " + digits$(NumU, 5)
  Sel = 0
  ShowMenu
  set sprite 0 to 150,40,SCar,15
  set sprite 1 to 150,200,SVan,4
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 455
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Rs
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 then
    if Sel > 0 then
      dec Sel
      play sound SndPick
      ShowMenu
    end if
  end if
  if (N & 2) <> 0 then
    if Sel < 2 then
      inc Sel
      play sound SndPick
      ShowMenu
    end if
  end if
  if (N & 16) <> 0 then goto tp_done
  goto tp_loop
tp_done:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowMenu:
  for Ti = 0 to 2
    put char 32 at 10,Ti + 20
  next
  put char 62 at 10,Sel + 20
  print at 12,20, "START"
  print at 12,21, "HOW TO PLAY"
  print at 12,22, "CREDITS"
  return
end sub

' a stretch of road for the HOW TO PLAY pages: six rows from HtY, bending
' right (the road templates as the game draws them, HtX = the road's left
' edge; HtT = 1: the checkpoint line on the third row)
sub HtRoad:
  Y = HtY + 5
  for Ri = HtY to Y
    V = Ri & 2
    T = 0
    if V <> 0 then T = 1
    if HtT = 1 then
      V = HtY + 2
      if Ri = V then T = 2
    end if
    W16 = T * 73
    W16 = W16 + HtX
    W16 = W16 - 24
    W16 = W16 * 22
    Va = Ri * 32
    Va = Va + 2
    copy RoadTpl + W16 count 22 to vram.name + Va
    dec HtX
  next
  return
end sub

' HOW TO PLAY: three pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  HtPg = 1
ht_page:
  NewScreen
  if HtPg = 1 then
    print at 2,1, "HOW TO PLAY            1/3"
    print at 2,3, "RACE UP A WINDING ROAD"
    print at 2,4, "AGAINST THE CLOCK!"
    print at 2,6, "PASS THE OTHER CARS, STAY"
    print at 2,7, "ON THE ROAD AND REACH THE"
    print at 2,8, "CHECKPOINT LINE AT THE END"
    print at 2,9, "OF EACH LAP."
    HtX = 68
    HtY = 14
    HtT = 0
    HtRoad
    set sprite 0 to 135,92,SCar,15
    set sprite 1 to 111,108,SVan,4
  elseif HtPg = 2 then
    print at 2,1, "CONTROLS               2/3"
    print at 2,3, "STICK UP: GO FASTER."
    print at 2,4, "STICK DOWN: SLOW DOWN."
    print at 2,5, "LEFT/RIGHT: STEER."
    print at 2,6, "BUTTON: BRAKE HARD."
    print at 2,8, "THE RED KERB SLOWS YOU."
    print at 2,9, "OFF THE ROAD OR INTO A CAR"
    print at 2,10, "IS A CRASH: IT COSTS TIME."
    HtX = 60
    HtY = 14
    HtT = 0
    HtRoad
    set sprite 0 to 127,72,SCar,15
    set sprite 1 to 143,108,SCar,10
  else
    print at 2,1, "THE CLOCK              3/3"
    print at 2,3, "THE TIME BAR RUNS DOWN. AT"
    print at 2,4, "THE CHECKPOINT EVERY PIECE"
    print at 2,5, "LEFT IS WORTH 100 POINTS"
    print at 2,6, "AND THE BAR FILLS AGAIN."
    print at 2,8, "WHEN THE BAR IS EMPTY, THE"
    print at 2,9, "GAME IS OVER."
    print at 2,11, "TIP: WATCH OUT AT NIGHT AND"
    print at 2,12, "ON THE ICE: YOUR CAR SLIDES!"
    print at 2,14, "TIME"
    for Bi = 0 to 4
      put char TBar8 at 7 + Bi,14
    next
    put char TBar3 at 12,14
    put char TBar0 at 13,14
    HtX = 56
    HtY = 16
    HtT = 1
    HtRoad
    set sprite 0 to 156,82,SCar,15
  end if
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 31
  HtWt = 0
ht_wait:
  Frame1
  ReadPads
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  N = Pads & (Pads ^ OldPads)
  if (N & 16) = 0 then goto ht_wait
  inc HtPg
  if HtPg <= 3 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  Phase = 0
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "RACE  ACE"
  print at 2,5, "BASED ON RACE ACE BY"
  print at 2,6, "MIKE SEDORE, COMPUTE!'S"
  print at 2,7, "GAZETTE, MAY 1990"
  print at 2,8, "(COMMODORE 64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: GREEN LIGHT GO"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
;RaClr / RaPoll: clear the NMI flag; wait until an NMI has set it
RaClr:
    xor a
    ld (NMI_FLAG),a
    ret
RaPoll:
    ld a,(NMI_FLAG)
    or a
    jr z,RaPoll
    ret
;RaRand: 16-bit xorshift on AMY_UVAR_Rs (7, 9, 8)
RaRand:
    ld hl,(AMY_UVAR_Rs)
    ld d,h
    ld e,l
    ld b,7
RaRandA:
    sla e
    rl d
    djnz RaRandA
    ld a,l
    xor e
    ld l,a
    ld a,h
    xor d
    ld h,a
    ld a,h
    srl a
    xor l
    ld l,a
    ld a,l
    xor h
    ld h,a
    ld (AMY_UVAR_Rs),hl
    ret
;RaRoad: the 22 road rows (screen rows 1-22, columns 2-23) from the ring
;(RRx, RTy, RDc, RDt from Head), straight to the VDP with the NMI off
RaRoad:
    ld de,$1800 + 34
    ld c,0
RaRoadRow:
    ld a,(AMY_UVAR_Head)
    add a,c
    cp 22
    jr c,RaRoadK
    sub 22
RaRoadK:
    push bc
    ld c,a
    ld b,0
    push bc
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_RTy
    add hl,bc
    ld a,(hl)
    ld b,a
    xor a
    inc b
RaRoadT:
    dec b
    jr z,RaRoadT2
    add a,73
    jr RaRoadT
RaRoadT2:
    ld hl,AMY_UVAR_RRx
    add hl,bc
    add a,(hl)
    sub 24
    ld l,a
    ld h,0
    add hl,hl
    push hl
    add hl,hl
    push hl
    add hl,hl
    add hl,hl
    pop bc
    add hl,bc
    pop bc
    add hl,bc
    ld bc,AMY_UDATA_RoadTpl
    add hl,bc
    ld b,22
RaRoadOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz RaRoadOut
    pop bc
    ld hl,AMY_UVAR_RDc
    add hl,bc
    ld a,(hl)
    or a
    jr z,RaRoadNoD
    sub 2
    ld l,a
    ld h,0
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_RDt
    add hl,bc
    ld a,(hl)
    out ($BE),a
RaRoadNoD:
    pop bc
    ld hl,32
    add hl,de
    ex de,hl
    inc c
    ld a,c
    cp 22
    jr nz,RaRoadRow
    ret
RaEngOut:
    ld a,(AMY_UVAR_EngLo)
    out ($FF),a
    ld a,(AMY_UVAR_EngHi)
    out ($FF),a
    ld a,(AMY_UVAR_EngVol)
    out ($FF),a
    ret
RaCrash:
    db $00,$00,$04,$03,$00,$00,$15,$04,$00,$00,$26,$06,$00,$00,$47,$08,$00,$00,$77,$0A,$00,$00,$A7,$08
    db $10
RaRumble:
    db $00,$00,$56,$02,$00,$00,$F6,$01,$10
RaSpin:
    db $40,$7F,$20,$03,$40,$97,$30,$03,$40,$B4,$30,$03,$40,$D6,$40,$03,$40,$FE,$40,$04,$40,$53,$51,$06
    db $50
RaCheck:
    db $40,$D6,$10,$05,$40,$AA,$10,$05,$40,$8F,$10,$05,$40,$6B,$10,$0A,$40,$8F,$20,$05,$40,$6B,$20,$10
    db $50
RaStage:
    db $40,$8F,$30,$04,$40,$71,$30,$04,$40,$5F,$30,$08,$50
RaTick:
    db $40,$47,$30,$01,$40,$47,$F0,$01,$50
RaLow:
    db $40,$FE,$20,$04,$40,$FE,$F0,$04,$50
RaGo:
    db $40,$D6,$20,$08,$40,$04,$F0,$08,$40,$D6,$20,$08,$40,$04,$F0,$08,$40,$6B,$10,$10,$50
RaOver:
    db $40,$AA,$10,$0A,$40,$BF,$20,$0A,$40,$D6,$20,$0A,$40,$E2,$20,$0A,$40,$1D,$31,$1E,$50
RaPick:
    db $40,$55,$40,$02,$50

RaSoundTable:
    dw RaTuneMel,$702B
    dw RaTuneBass,$7035
    dw RaCrash,$703F
    dw RaRumble,$703F
    dw RaSpin,$7049
    dw RaCheck,$7049
    dw RaStage,$7049
    dw RaTick,$7049
    dw RaLow,$7049
    dw RaGo,$7049
    dw RaOver,$7049
    dw RaPick,$7049
; Green Light Go (original)
; Tiny Sound, 7 frames per step
RaTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$60,$F1,$22,$21,$01,$25,$28,$01,$25,$23,$01,$21,$01,$1E,$01
    db $21,$01,$01,$01,$23,$01,$26,$2A,$01,$26,$25,$01,$23,$01,$20,$01
    db $23,$01,$01,$01,$25,$01,$28,$2D,$01,$28,$26,$25,$23,$01,$26,$25
    db $23,$01,$21,$01,$20,$01,$23,$01,$1C,$01,$20,$01,$21,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
RaTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$80,$18,$32,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$15,$01
    db $0E,$01,$15,$01,$0B,$01,$12,$01,$0B,$01,$12,$01,$10,$01,$17,$01
    db $10,$01,$17,$01,$09,$01,$10,$01,$09,$01,$10,$01,$0E,$01,$12,$01
    db $0E,$01,$12,$01,$10,$01,$17,$01,$04,$01,$08,$01,$09,$01,$01,$01
    db $00,$01,$01,$01
    db $FF
}
