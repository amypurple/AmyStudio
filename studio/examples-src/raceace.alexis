  128,128,128,128,128,128,128,128,128,158,208,197,197,197,197,197,197,197,197,209,162,128
  128,128,128,128,128,128,128,128,128,163,210,197,197,197,197,197,197,197,197,211,167,128
  128,128,128,128,128,128,128,128,128,128,130,197,197,197,197,197,197,197,197,197,130,128
end data
data LogoMap bytes
  32,32,32,32,224,224,224,224,32,32,32,224,224,224,32,32,32,224,224,224,224,32,224,224,224,224,224,32,32,32,32,32
  32,32,32,32,224,32,32,32,224,32,224,32,32,32,224,32,224,32,32,32,32,32,224,32,32,32,32,32,32,32,32,32
  32,32,32,32,224,32,32,32,224,32,224,32,32,32,224,32,224,32,32,32,32,32,224,32,32,32,32,32,32,32,32,32
  32,32,32,32,224,224,224,224,32,32,224,224,224,224,224,32,224,32,32,32,32,32,224,224,224,224,32,32,32,32,32,32
  32,32,32,32,224,32,224,32,32,32,224,32,32,32,224,32,224,32,32,32,32,32,224,32,32,32,32,32,32,32,32,32
  32,32,32,32,224,32,32,224,32,32,224,32,32,32,224,32,224,32,32,32,32,32,224,32,32,32,32,32,32,32,32,32
  32,32,32,32,224,32,32,32,224,32,224,32,32,32,224,32,32,224,224,224,224,32,224,224,224,224,224,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,32,223,223,223,32,32,32,223,223,223,223,32,223,223,223,223,223,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,32,32,32,223,32,223,32,32,32,32,32,223,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,32,32,32,223,32,223,32,32,32,32,32,223,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,223,223,223,223,32,223,32,32,32,32,32,223,223,223,223,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,32,32,32,223,32,223,32,32,32,32,32,223,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,32,32,32,223,32,223,32,32,32,32,32,223,32,32,32,32,32,32,32,32,32,32,32,32
  32,32,32,32,32,32,32,223,32,32,32,223,32,32,223,223,223,223,32,223,223,223,223,223,32,32,32,32,32,32,32,32
