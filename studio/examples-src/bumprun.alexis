u16 TzLeft = 0
u8 TzOn = 0
Obj O[3]
' per axis (object x 2 + 0 for Y, + 1 for X): speed, its size, counter
i8 Vel[6]
u8 Ab[6]
u8 Cnt[6]
' the sticks (1 up, 2 down, 4 left, 8 right, 16 button) and last frame's
u8 Pj[2]
u8 Pold[2]
bcd digits 2 ScoreP = 0
bcd digits 2 ScoreY = 0
u8 Holder = 0
u8 Mask = 7
u8 BumpOn = 0
u8 Bits = 0
u8 Goal = 0
u8 Mode = 1
u8 Over = 0
u8 Sq = 0
u8 CpuJ = 0
u8 Winner = 0
u8 Moved = 0
u8 RunUp = 0
' input and menus
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 Shots = 0
u8 Bumps = 0
u8 Catches = 0
' loop counters (never shared with the helpers)
u8 It = 0
u8 Ai = 0
u8 Hs = 0
' scratch
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u16 W16 = 0

  tile screen
  set sound table BrSoundTable areas 9
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title
  Mode = Menu + 1

  NewGame

play_loop:
  Frame1
  ReadPads
  PlayStep
  DrawSprites
  if Goal > 0 then Scored
  if Over = 0 then goto play_loop

  ' the end: who won, GAME OVER, then back to the title on a press
  print at 9,9, "             "
  if Winner = 1 then
    print at 9,10, " PURPLE WINS "
  else
    print at 9,10, " YELLOW WINS "
  end if
  print at 9,11, "  GAME OVER  "
  print at 9,12, "             "
  mute all
  TzOn = 0
  play sound SndOver
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame: the collision snapshot (the C64's interrupt), the bump push,
' the bump / take checks, a shot, then NIter passes of the move loop
sub PlayStep:
  if Mode = 1 then CpuThink
  Bits = Touches
  V = Bits & 3
  if V = 3 then
    PushApart
    if BumpOn = 0 then
      BumpSwap
      BumpOn = 1
    end if
  else
    BumpOn = 0
    if Holder = 0 then
      K = Bits & Mask
      select case K
        case 5
          Holder = 1
          inc Catches
          play sound SndCatch
        case 6
          Holder = 2
          inc Catches
          play sound SndCatch
      end select
    end if
  end if
  for Hs = 0 to 1
    TryShoot(Hs)
  next
  Pold[0] = Pj[0]
  Pold[1] = Pj[1]
  RunPasses
  if Sq > 0 then dec Sq
  return
end sub

' which things touch: bit 0 PURPLE touches something, bit 1 YELLOW, bit 2
' the ball (as the C64's collision register: sprites 0, 1, 2)
function Touches as u8
  u8 R = 0
  u8 Cc = 0
  Cc = Near(0, 1, 17)
  if Cc = 1 then R = 3
  if Holder = 0 then
    Cc = Near(0, 2, 10)
    if Cc = 1 then R = R | 5
    Cc = Near(1, 2, 10)
    if Cc = 1 then R = R | 6
  end if
  return R

' 1 when objects A and B are closer than D (squared distance test)
function Near(u8 A, u8 B, u8 D) as u8
  u16 Dx = 0
  u16 Dy = 0
  u16 Lim = 0
  u8 Res = 0
  Dx = O[A].X
  if Dx >= O[B].X then
    Dx = Dx - O[B].X
  else
    Dx = O[B].X - Dx
  end if
  Dy = O[A].Y
  if Dy >= O[B].Y then
    Dy = Dy - O[B].Y
  else
    Dy = O[B].Y - Dy
  end if
  if Dx <= D then
    if Dy <= D then
      Lim = D * D
      Dx = Dx * Dx + Dy * Dy
      if Dx <= Lim then Res = 1
    end if
  end if
  return Res

' while the cars touch: one pixel apart on each axis (kept off the rails)
sub PushApart:
  u16 X0 = 0
  u16 X1 = 0
  u8 Y0 = 0
  u8 Y1 = 0
  X0 = O[0].X
  X1 = O[1].X
  Y0 = O[0].Y
  Y1 = O[1].Y
  if X0 < X1 then
    if X0 > 43 then dec X0
    if X1 < 301 then inc X1
  end if
  if X0 > X1 then
    if X0 < 301 then inc X0
    if X1 > 43 then dec X1
  end if
  if Y0 < Y1 then
    if Y0 > 78 then dec Y0
    if Y1 < 210 then inc Y1
  end if
  if Y0 > Y1 then
    if Y0 < 210 then inc Y0
    if Y1 > 78 then dec Y1
  end if
  O[0].X = X0
  O[1].X = X1
  O[0].Y = Y0
  O[1].Y = Y1
  return
end sub

' the first touch of a bump: the cars swap speeds, the ball changes hands
sub BumpSwap:
  i8 T = 0
  T = Vel[0]
  Vel[0] = Vel[2]
  Vel[2] = T
  T = Vel[1]
  Vel[1] = Vel[3]
  Vel[3] = T
  for J = 0 to 3
    Cnt[J] = Ab[J]
  next
  if Holder > 0 then Holder = 3 - Holder
  Sq = 6
  inc Bumps
  play sound SndBump
  return
end sub

' car H shoots the ball it holds: the ball takes the car's speed, the car
' stops; the shooter can't take it back before it bounces
sub TryShoot(u8 H):
  u8 Fresh = 0
  u8 Ax = 0
  if Holder = H + 1 then
    Fresh = Pj[H] & 16
    V = Pold[H] & 16
    if V > 0 then Fresh = 0
  end if
  if Fresh > 0 then
    O[2].X = O[H].X
    O[2].Y = O[H].Y
    Ax = H * 2
    Vel[4] = Vel[Ax]
    Vel[5] = Vel[Ax + 1]
    Ab[4] = Ab[Ax]
    Ab[5] = Ab[Ax + 1]
    Cnt[4] = Ab[4]
    Cnt[5] = Ab[5]
    Vel[Ax] = 0
    Vel[Ax + 1] = 0
    Ab[Ax] = 0
    Ab[Ax + 1] = 0
    Holder = 0
    Mask = 6
    if H = 1 then Mask = 5
    inc Shots
    play sound SndShoot
  end if
  return
end sub

' NIter passes of the C64's main loop, worked out axis by axis: each
' counter counts down to its speed's size, then the axis moves and the
' counter starts again at 90 (a held ball doesn't move)
sub RunPasses:
  u8 Na = 0
  u8 Bud = 0
  u8 Dc = 0
  Na = 5
  if Holder > 0 then Na = 3
  for Ai = 0 to Na
    Bud = NIter
    while Bud > 0
      Dc = Cnt[Ai] - Ab[Ai]
      if Dc >= Bud then
        Cnt[Ai] = Cnt[Ai] - Bud
        Bud = 0
      else
        Bud = Bud - Dc - 1
        TickAxis(Ai)
        if Goal > 0 then Bud = 0
      end if
    end while
  next
  return
end sub

' one axis's turn: the stick (cars), one pixel or a bounce, the speed cap
sub TickAxis(u8 A):
  u8 Ob = 0
  u8 Ax = 0
  u8 Kd = 0
  u8 Jb = 0
  u8 Bnc = 0
  u8 Yv = 0
  u16 Xv = 0
  i8 Vv = 0
  i8 Dv = 0
  Cnt[A] = Period
  Ob = A >> 1
  Ax = A & 1
  Vv = Vel[A]
  if Ob < 2 then
    Kd = 0
    if Vv < 0 then Kd = 1
    if Vv > 0 then Kd = 2
    Jb = Pj[Ob]
    if Ax = 1 then Jb = Jb >> 2
    Jb = Jb & 3
    select case (Jb, Kd)
      case (0, 0)
        Dv = 0
      case (0, 1)
        Dv = 1
      case (0, 2)
        Dv = -1
      case (1, 0 to 1)
        Dv = -1
      case (1, 2)
        Dv = -2
      case (2 to 3, 0)
        Dv = 1
      case (2 to 3, 1)
        Dv = 2
      case (2 to 3, 2)
        Dv = 1
    end select
    Vv = Vv + Dv
  end if
  if Ax = 0 then
    Yv = O[Ob].Y
    if Vv < 0 then
      if Ob = 2 then
        if Yv < 72 then Bnc = 1
      else
        if Yv < 79 then Bnc = 1
      end if
      if Bnc = 0 then dec Yv
    end if
    if Vv > 0 then
      if Ob = 2 then
        if Yv >= 217 then Bnc = 1
      else
        if Yv >= 210 then Bnc = 1
      end if
      if Bnc = 0 then inc Yv
    end if
    O[Ob].Y = Yv
  else
    Xv = O[Ob].X
    if Vv < 0 then
      if Ob = 2 then
        BallLeft(Xv)
        Bnc = Moved
      else
        if Xv < 44 then
          Bnc = 1
        else
          dec Xv
        end if
      end if
    end if
    if Vv > 0 then
      if Ob = 2 then
        BallRight(Xv)
        Bnc = Moved
      else
        if Xv >= 301 then
          Bnc = 1
        else
          inc Xv
        end if
      end if
    end if
    if Ob < 2 then O[Ob].X = Xv
  end if
  if Bnc = 1 then
    Vv = -Vv
    if Ob = 2 then
      Mask = 7
      play sound SndWall
    end if
  end if
  if Vv >= 0 then
    if Vv > VMax then Vv = VMax
    Ab[A] = Vv
  else
    if Vv < -VMax then Vv = -VMax
    Ab[A] = -Vv
  end if
  Vel[A] = Vv
  return
end sub

' the ball going left: the rail, the goal mouth, the goal line
sub BallLeft(u16 Bx):
  Moved = 0
  if Bx >= 37 then
    O[2].X = Bx - 1
  else
    if Bx < 32 then
      Goal = 2
    else
      if Bx < 36 then
        O[2].X = Bx - 1
      else
        Moved = InMouth
        Moved = Moved ^ 1
        if Moved = 0 then O[2].X = Bx - 1
      end if
    end if
  end if
  return
end sub

sub BallRight(u16 Bx):
  Moved = 0
  if Bx < 308 then
    O[2].X = Bx + 1
  else
    if Bx >= 312 then
      Goal = 1
    else
      if Bx >= 310 then
        O[2].X = Bx + 1
      else
        Moved = InMouth
        Moved = Moved ^ 1
        if Moved = 0 then O[2].X = Bx + 1
      end if
    end if
  end if
  return
end sub

function InMouth as u8
  u8 Inm = 0
  if O[2].Y >= 123 then
    if O[2].Y <= 165 then Inm = 1
  end if
  return Inm

' ---------------------------------------------------------------------------
' the computer's YELLOW (1 PLAYER): every 6 frames it looks again; it chases
' the free ball, rams PURPLE when PURPLE has it, and drives at the left net
' with it, shooting when it is lined up and moving left fast enough
sub CpuThink:
  i16 Tx = 0
  i16 Ty = 0
  i16 D = 0
  i16 Want = 0
  i16 Vx = 0
  u8 Jn = 0
  V = Tick % 6
  if V = 0 then
    select case Holder
      case 0
        Tx = O[2].X
        Ty = O[2].Y
      case 1
        Tx = O[0].X
        Ty = O[0].Y
      case else
        ' a run-up from the right, then at the left net; with PURPLE in
        ' the way, first out to a lane above or below it
        if O[1].X < 110 then RunUp = 1
        if O[1].X > 260 then RunUp = 0
        Tx = 40
        Ty = 144
        if RunUp = 1 then Tx = 290
        ' PURPLE guarding the mouth: out to a lane above or below it,
        ' then a slow cut back in (the shot waits for a clear line)
        if RunUp = 0 then
          if O[0].X < O[1].X then
            D = O[0].Y
            D = D - 144
            if D < 0 then D = -D
            Vx = O[1].X - O[0].X
            if D < 30 then
              if Vx > 170 then
                Ty = 96
                if O[0].Y < 144 then Ty = 192
              else
                Ty = 172
                if O[0].Y < 144 then Ty = 116
              end if
            end if
          end if
        end if
    end select
    ' X
    D = Tx - O[1].X
    Want = D / 2
    if Want > CpuMax then Want = CpuMax
    if Want < -CpuMax then Want = -CpuMax
    Vx = Vel[3]
    if Vx < Want - 4 then Jn = Jn | 8
    if Vx > Want + 4 then Jn = Jn | 4
    ' Y
    D = Ty - O[1].Y
    Want = D / 2
    if Want > CpuMax then Want = CpuMax
    if Want < -CpuMax then Want = -CpuMax
    Vx = Vel[2]
    if Vx < Want - 4 then Jn = Jn | 2
    if Vx > Want + 4 then Jn = Jn | 1
    ' the shot: when the ball would reach the mouth and pass PURPLE
    if Holder = 2 then
      Vx = Vel[3]
      if Vx <= -20 then
        if O[1].X < 250 then
          D = AimY(34)
          if D >= 126 then
            if D <= 162 then
              Jn = Jn | 16
              if O[0].X < O[1].X then
                D = AimY(O[0].X)
                D = D - O[0].Y
                if D < 0 then D = -D
                if D < 15 then Jn = Jn & 15
              end if
            end if
          end if
        end if
      end if
    end if
    ' a fresh press each time
    V = CpuJ & 16
    if V > 0 then Jn = Jn & 15
    CpuJ = Jn
  end if
  return
end sub

' where a ball shot now by YELLOW (going left) would cross X Gx: its Y
' (folded once off a rail)
function AimY(u16 Gx) as i16
  i16 Ay = 0
  i16 Vy = 0
  i16 Vxn = 0
  Ay = O[1].X - Gx
  Vy = Vel[2]
  Vxn = Vel[3]
  Vxn = -Vxn
  Ay = Ay * Vy
  Ay = Ay / Vxn
  Ay = Ay + O[1].Y
  ' one bounce off the top or bottom rail (a bank shot)
  if Ay < 72 then Ay = 144 - Ay
  if Ay > 217 then Ay = 434 - Ay
  return Ay

' ---------------------------------------------------------------------------
' a goal: the score, the cheer, then the start places (or the end)
sub Scored:
  if Goal = 1 then
    inc ScoreP
    print at 9,21, "PURPLE SCORES!"
  else
    ScoreY += 1
    print at 9,21, "YELLOW SCORES!"
  end if
  ShowScore
  play sound SndGoal
  for Hs = 1 to 75
    Frame1
  next
  fill 32 count 28 at 2,21
  if ScoreP = 15 then
    Over = 1
    Winner = 1
  end if
  if ScoreY = 15 then
    Over = 1
    Winner = 2
  end if
  if Over = 0 then
    StartPlaces
    DrawSprites
  end if
  return
end sub

sub StartPlaces:
  O[0].X = 74
  O[1].X = 271
  O[2].X = 172
  for J = 0 to 2
    O[J].Y = 144
  next
  for J = 0 to 5
    Vel[J] = 0
    Ab[J] = 0
    Cnt[J] = Period
  next
  Holder = 0
  Mask = 7
  BumpOn = 0
  Goal = 0
  Sq = 0
  return
end sub

' ---------------------------------------------------------------------------
' drawing: C64 sprite pixels to the screen, 49/64 of the size
function CvX(u16 Px) as u8
  u8 Res = 0
  Px = Px + 28
  Px = Px * 49
  Px = Px >> 6
  Res = Px - 25
  return Res

function CvY(u8 Py) as u8
  u16 Q = 0
  u8 Res = 0
  Q = Py - 56
  Q = Q * 49
  Q = Q >> 6
  Res = Q
  return Res + 29

' sprite 0 the ball (on top), 1 PURPLE, 2 YELLOW
sub DrawSprites:
  u8 Pat = 0
  Pat = SCar
  if Sq > 0 then Pat = SCarsq
  for J = 0 to 2
    X = CvX(O[J].X)
    Y = CvY(O[J].Y)
    if J < 2 then
      K = J + 1
      V = 13
      if J = 1 then V = 11
      set sprite K to Y - 9,X - 8,Pat,V
    end if
  next
  if Holder = 0 then
    X = CvX(O[2].X)
    Y = CvY(O[2].Y)
  else
    K = Holder - 1
    X = CvX(O[K].X)
    Y = CvY(O[K].Y)
  end if
  set sprite 0 to Y - 9,X - 8,SBall,15
  update sprites
  return
end sub

sub ShowScore:
  print at 11,1, ScoreP
  print at 19,1, ScoreY
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 4,1, "PURPLE"
  print at 22,1, "YELLOW"
  print at 10,2, "BUMP 'N RUN"
  if Mode = 1 then
    print at 6,22, "YOU: PURPLE  ME: YELLOW"
  else
    print at 6,22, "PURPLE: 1   YELLOW: 2"
  end if
  ScoreP = 0
  ScoreY = 0
  Over = 0
  Winner = 0
  Shots = 0
  Bumps = 0
  Catches = 0
  CpuJ = 0
  StartPlaces
  ShowScore
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  Pold[0] = 0
  Pold[1] = 0
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

function PadBits(u8 P) as u8
  u8 B = 0
  if P = 1 then
    if joypad(1).up then B = B | 1
    if joypad(1).down then B = B | 2
    if joypad(1).left then B = B | 4
    if joypad(1).right then B = B | 8
    if joypad(1).fire then B = B | 16
  else
    if joypad(2).up then B = B | 1
    if joypad(2).down then B = B | 2
    if joypad(2).left then B = B | 4
    if joypad(2).right then B = B | 8
    if joypad(2).fire then B = B | 16
  end if
  return B

' the two cars' sticks (1 PLAYER: either controller drives PURPLE and the
' computer drives YELLOW); Press is a fresh button on either
sub ReadPads:
  Pj[0] = PadBits(1)
  Pj[1] = PadBits(2)
  V = Pj[0] | Pj[1]
  if Mode = 1 then
    Pj[0] = V
    Pj[1] = CpuJ
  end if
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 3
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: BUMP 'N RUN in big letters, the two cars circling below,
' 1 PLAYER / 2 PLAYERS / CREDITS, the tune once
sub TitlePage:
  Menu = 0
  NewScreen
  print at 3,1, "COMPUTE!'S GAZETTE 11/1986"
  copy TitleMap count 384 to vram.name + 96
  print at 11,18, "1 PLAYER"
  print at 11,19, "2 PLAYERS"
  print at 11,20, "HOW TO PLAY"
  print at 11,21, "CREDITS"
  print at 3,22, "STICK DRIVES, BUTTON SHOOTS"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 455
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPadsMenu
  TitleAnim
  V = Pj[0] & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        if Menu > 0 then dec Menu
      else
        if Menu < 3 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub ReadPadsMenu:
  Pj[0] = PadBits(1) | PadBits(2)
  Btn = Pj[0] & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' the two cars chase round a ring under the letters (and bump)
sub TitleAnim:
  i8 Sy = 0
  i16 Sx = 0
  for J = 0 to 1
    K = Tick + J * 128
    Sy = Sine(K)
    Sx = Sine(K + 64)
    Sx = Sx * 6 + 120
    Sy = Sy / 4
    Y = 117 + Sy
    X = Sx
    ' (colour in a variable: bugs/bumprun-set-sprite-colour-sub.alexis)
    V = 13 - J * 2
    set sprite J + 1 to Y,X,SCar,V
  next
  update sprites
  return
end sub

' a small "sine": 0..16..0..-16 as a triangle, 256 steps a turn
function Sine(u8 A) as i8
  i8 S = 0
  u8 Q = 0
  Q = A & 63
  Q = Q >> 2
  select case A
    case 0 to 63
      S = Q
    case 64 to 127
      S = 16 - Q
    case 128 to 191
      S = -Q
    case else
      S = Q - 16
  end select
  return S

sub ShowMenu:
  for J = 18 to 21
    put char 32 at 9,J
  next
  J = Menu + 18
  put char 62 at 9,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
u8 HPg = 0
u16 HWt = 0
sub HowToPage:
  HPg = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if HPg = 0 then
    print at 2,3, "TWO BUMPER CARS, ONE BALL."
    print at 2,4, "SHOOT THE BALL INTO THE"
    print at 2,5, "OTHER SIDE'S NET TO SCORE."
    print at 2,6, "PURPLE SHOOTS RIGHT, YELLOW"
    print at 2,7, "SHOOTS LEFT. FIRST TO 15"
    print at 2,8, "GOALS WINS THE GAME."
    print at 2,10, "STICK: SPEED UP THAT WAY."
    print at 2,11, "LET GO TO SLOW DOWN."
    print at 2,12, "DRIVE OVER THE BALL TO TAKE"
    print at 2,13, "IT. BUTTON: SHOOT IT."
    put char TCnr at 5,15
    fill THw count 20 at 6,15
    put char TCnr at 26,15
    for J = 16 to 19
      put char TVw at 5,J
      fill TFl0 count 20 at 6,J
      put char TVw at 26,J
    next
    put char TNet at 5,17
    put char TNet at 5,18
    put char TNet at 26,17
    put char TNet at 26,18
    put char TCnr at 5,20
    fill THw count 20 at 6,20
    put char TCnr at 26,20
    set sprite 0 to 135,72,SCar,13
    set sprite 1 to 135,96,SBall,15
    set sprite 2 to 135,168,SCar,11
  else
    print at 2,3, "THE BALL NEVER SLOWS DOWN."
    print at 2,4, "IT BOUNCES OFF THE WALLS."
    print at 2,5, "WHEN YOU SHOOT, YOUR CAR"
    print at 2,6, "STOPS DEAD."
    print at 2,8, "BUMP THE OTHER CAR: YOU SWAP"
    print at 2,9, "SPEEDS, AND THE BALL JUMPS"
    print at 2,10, "TO THE OTHER CAR!"
    print at 2,12, "1 PLAYER: YOU ARE PURPLE."
    print at 2,13, "2 PLAYERS: CONTROLLER 2 IS"
    print at 2,14, "YELLOW."
    print at 2,16, "TIP: SHOOT WHILE DRIVING"
    print at 2,17, "TOWARD THE NET."
    put char TIcp at 13,19
    put char TIcy at 18,19
  end if
  print at 8,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HWt = 0
ht_loop:
  Frame1
  ReadPadsMenu
  inc HWt
  if HWt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc HPg
  if HPg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "BUMP 'N RUN"
  print at 2,5, "BASED ON BUMP 'N RUN FROM"
  print at 2,6, "THE COMPUTE!'S GAZETTE DISK"
  print at 2,7, "OF NOVEMBER 1986 (COMMODORE"
  print at 2,8, "64 MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: RINK RIDE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

