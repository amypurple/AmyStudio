record Rock:
  u8 X
  u8 Y
  i8 VX
  i8 VY
  u8 Kind
  u8 Life
end record

Rock Rocks[NRock]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Hund = 0
u16 Best = 0
u16 LvT = 0
' the rocket
u8 SX = 76
u8 SY = 80
u8 Dir = 2
u8 Moving = 0
u8 Half = 0
' the shot
u8 BOn = 0
u8 BX = 0
u8 BY = 0
u8 BDX = 0
u8 BDY = 0
' the game
u8 MAcc = 0
u8 Lv = 1
u8 Ships = 5
u8 Freeze = 0
u8 FrKind = 0
u8 Over = 0
u16 Hits = 0
u16 Shots = 0
u8 AimNext = 0
u8 LSide = 0
u8 Lost = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' title animation
u8 TmX = 0
u8 TmY = 100
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MsSoundTable areas 4
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, then back to the title on a press
  Rearm
  wait
  nmi off
  HideSprites
  print at 7,10, "           "
  print at 7,11, " GAME OVER "
  print at 7,12, "           "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then EndFreeze
    return
  end if
  MoveShip
  MoveShot
  W16 = MAcc + RateT[Lv - 1]
  MAcc = W16 & 255
  if W16 > 255 then
    for Ri = 0 to NRock - 1
      RockStep(Ri)
    next
  end if
  Collide
  if Freeze > 0 then return
  if Lv < 9 then
    inc LvT
    if LvT >= LvFrames then LevelDone
  end if
  return
end sub

' the stick: 1 then 2 pixels (1.5 a frame), kept inside the field
sub MoveShip:
  K = J1 & 15
  V = DirOf[K]
  Moving = 0
  if V = 255 then return
  Moving = 1
  Dir = V
  Half = Half ^ 1
  C = Half + 1
  SX = Clamp8(SX, DXT[V], C, FMaxX)
  SY = Clamp8(SY, DYT[V], C, FMaxY)
  return
end sub

' P moved by D (1 or 255 = -1, or 0) times N, kept in 0..Hi
function Clamp8(u8 P, u8 D, u8 N, u8 Hi) as u8
  i16 T
  T = P
  select case D
    case 1
      T = T + N
    case 255
      T = T - N
  end select
  if T < 0 then T = 0
  if T > Hi then T = Hi
  return T

' the shot moves 4 pixels a frame and ends at the field's edge; a new one
' leaves from the rocket's middle while the button is held
sub MoveShot:
  if BOn = 1 then
    BX = BX + BDX
    BY = BY + BDY
    if BX > FMaxX then BOn = 0
    if BY > FMaxY then BOn = 0
  end if
  if BOn = 0 then
    if Btn > 0 then
      BOn = 1
      BX = SX
      BY = SY
      BDX = DXT[Dir] << 2
      BDY = DYT[Dir] << 2
      inc Shots
      play sound SndZap
    end if
  end if
  return
end sub

' one step of meteor N: fly, or burn out and be replaced
sub RockStep(u8 N):
  u8 Renew
  Renew = 0
  with Rocks[N] as R
    if R.Kind = 2 then
      dec R.Life
      if R.Life = 0 then Renew = 1
    else
      R.X = R.X + R.VX
      R.Y = R.Y + R.VY
      ' half way round the unseen part of the space a meteor is replaced
      ' (the C64 re-launched one whose X or Y passed through 0)
      if R.VX <> 0 then
        if R.X >= HidMid then
          if R.X < HidMid + 3 then Renew = 1
        end if
      end if
      if R.VY <> 0 then
        if R.Y >= HidMid then
          if R.Y < HidMid + 3 then Renew = 1
        end if
      end if
    end if
  end with
  if Renew = 1 then
    Launch(N)
    ' every other meteor coming back is aimed at the rocket
    AimNext = AimNext ^ 1
    if AimNext = 1 then Aim(N, LSide)
  end if
  return
end sub

' Rnd7: -3..3 from four random bits (0 a little more often)
function Rnd7 as i8
  Rand
  V = Rs & 15
  return Speed7[V]

' a place 0..Hi along an edge from the random low byte (fast: no divide)
function EdgePos(u8 Hi) as u8
  u8 P
  P = Rs & 255
  if P > Hi then P = P - 103
  return P

' a new meteor at an edge, flying in
sub Launch(u8 N):
  i8 Vx
  i8 Vy
  u8 Side
  Vx = Rnd7
  Vy = Rnd7
  if Vx = 0 then
    if Vy = 0 then Vy = 1
  end if
  Rand
  Side = Rs & 1
  if Vx = 0 then Side = 1
  if Vy = 0 then Side = 0
  with Rocks[N] as R
    R.VX = Vx
    R.VY = Vy
    R.Kind = highbyte(Rs) & 1
    if Side = 0 then
      if Vx > 0 then
        R.X = 240
      else
        R.X = FMaxX + 16
      end if
      R.Y = EdgePos(FMaxY)
    else
      if Vy > 0 then
        R.Y = 240
      else
        R.Y = FMaxY + 16
      end if
      R.X = EdgePos(FMaxX)
    end if
  end with
  LSide = Side
  return
end sub

' put meteor N's entry point on the line that meets the rocket: the steps
' it needs to reach the rocket along its main axis, then the other axis
' moved back by as many steps (all modulo 256, as the space wraps)
sub Aim(u8 N, u8 Side):
  i8 Va
  i8 Vb
  u8 Dist
  u8 Steps
  i16 T
  if Side = 0 then
    Va = Rocks[N].VX
    Vb = Rocks[N].VY
    Dist = SX - Rocks[N].X
  else
    Va = Rocks[N].VY
    Vb = Rocks[N].VX
    Dist = SY - Rocks[N].Y
  end if
  if Va < 0 then
    Dist = 0 - Dist
    Va = 0 - Va
  end if
  Steps = Dist / Va
  if Side = 0 then
    T = SY - Vb * Steps
    Rocks[N].Y = T & 255
  else
    T = SX - Vb * Steps
    Rocks[N].X = T & 255
  end if
  return
end sub

' Seen(N) = 1 when meteor N is wholly inside the field
function Seen(u8 N) as u8
  if Rocks[N].X > FMaxX then return 0
  if Rocks[N].Y > FMaxY then return 0
  return 1

' the shot and the rocket against every meteor in sight
sub Collide:
  u8 Kd
  u8 Mx
  u8 My
  for Ri = 0 to NRock - 1
    Kd = Rocks[Ri].Kind
    if Kd < 2 then
      if Seen(Ri) = 1 then
        Mx = Rocks[Ri].X
        My = Rocks[Ri].Y
        if BOn = 1 then
          X = BX + 7
          Y = BY + 7
          if InBox(X, Y, Mx, My, Kd) = 1 then
            BOn = 0
            Burst(Ri)
            AddPoints(Kd + 1)
            inc Hits
            play sound SndRock
          end if
        end if
      end if
    end if
  next
  for Ri = 0 to NRock - 1
    Kd = Rocks[Ri].Kind
    if Kd < 2 then
      if Seen(Ri) = 1 then
        Mx = Rocks[Ri].X
        My = Rocks[Ri].Y
        if ShipHit(Mx, My, Kd) = 1 then
          ShipLost
          return
        end if
      end if
    end if
  next
  return
end sub

function InBox(u8 Px, u8 Py, u8 Mx, u8 My, u8 Kd) as u8
  if Px < Mx + BoxL[Kd] then return 0
  if Px > Mx + BoxR[Kd] then return 0
  if Py < My + BoxT[Kd] then return 0
  if Py > My + BoxB[Kd] then return 0
  return 1

' the rocket's box is 4..11 each way
function ShipHit(u8 Mx, u8 My, u8 Kd) as u8
  if SX + 11 < Mx + BoxL[Kd] then return 0
  if SX + 4 > Mx + BoxR[Kd] then return 0
  if SY + 11 < My + BoxT[Kd] then return 0
  if SY + 4 > My + BoxB[Kd] then return 0
  return 1

sub Burst(u8 N):
  Rocks[N].Kind = 2
  Rocks[N].Life = 5
  return
end sub

sub AddPoints(u8 P):
  Hund = Hund + P
  if Hund > ScoreCap then Hund = ScoreCap
  if Hund > Best then Best = Hund
  ShowScore
  return
end sub

sub ShipLost:
  dec Ships
  inc Lost
  ShowShips
  BOn = 0
  Moving = 0
  Freeze = 50
  FrKind = 1
  mute all
  play sound SndCrash
  return
end sub

' LEVEL COMPLETE: every meteor still flying bursts and scores
sub LevelDone:
  u8 Kd
  for Ri = 0 to NRock - 1
    Kd = Rocks[Ri].Kind
    if Kd < 2 then
      Burst(Ri)
      AddPoints(Kd + 1)
    end if
  next
  BOn = 0
  Freeze = 75
  FrKind = 2
  print at 5,11, " LEVEL COMPLETE "
  play sound SndLevel
  return
end sub

sub EndFreeze:
  if FrKind = 1 then
    if Ships = 0 then
      Over = 1
      return
    end if
    SX = 76
    SY = 80
    for Ri = 0 to NRock - 1
      Launch(Ri)
    next
  else
    copy GameMap + 357 count 16 to vram.name + 357
    if Lv = 8 then
      if Ships < 99 then inc Ships
      ShowShips
      play sound SndBonus
    end if
    inc Lv
    LvT = 0
    ShowLevel
  end if
  FrKind = 0
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites: 0 the rocket, 1 its flame, 2 the shot, 3-8 the meteors
sub DrawSprites:
  X = SX + 16
  Y = SY + 7
  if FrKind = 1 then
    K = Freeze & 8
    if K > 0 then
      K = SBoom1
    else
      K = SBoom0
    end if
    set sprite 0 to Y,X,K,9
    set sprite 1 to 192,0,0,0
  else
    K = Dir << 2
    set sprite 0 to Y,X,K,15
    if Moving = 1 then
      K = K + SFlame0
      set sprite 1 to Y,X,K,8
    else
      set sprite 1 to 192,0,0,0
    end if
  end if
  if BOn = 1 then
    X = BX + 16
    Y = BY + 7
    set sprite 2 to Y,X,SShot,11
  else
    set sprite 2 to 192,0,0,0
  end if
  for Di = 0 to NRock - 1
    DrawRock(Di)
  next
  update sprites
  return
end sub

sub DrawRock(u8 N):
  u8 Kd
  u8 Sp
  u8 Col
  u8 Pat
  Sp = N + 3
  if Seen(N) = 0 then
    set sprite Sp to 192,0,0,0
    return
  end if
  Kd = Rocks[N].Kind
  if Kd = 2 then
    Pat = SBoom0
    if Rocks[N].Life < 3 then Pat = SBoom1
    Col = BurstCol[Rocks[N].Life]
  else
    Pat = RockPat[Kd]
    Col = RockCol[Kd]
  end if
  X = Rocks[N].X + 16
  Y = Rocks[N].Y + 7
  set sprite Sp to Y,X,Pat,Col
  return
end sub

sub ShowScore:
  print at 24,3, digits$(Hund, 4), "00"
  return
end sub

sub ShowLevel:
  NumU = Lv
  print at 24,7, "  ", digits$(NumU, 2), "  "
  return
end sub

sub ShowShips:
  NumU = Ships
  print at 24,19, "  ", digits$(NumU, 2), "  "
  return
end sub

sub NewGame:
  NewScreen
  copy GameMap count 768 to vram.name
  print at 24,2, "SCORE:"
  print at 24,6, "LEVEL:"
  print at 24,11, "METEOR"
  print at 24,12, "STRIKE"
  print at 24,18, "SHIPS:"
  Hund = 0
  Lv = 1
  LvT = 0
  Ships = 5
  SX = 76
  SY = 80
  Dir = 2
  Moving = 0
  Half = 0
  BOn = 0
  MAcc = 0
  Freeze = 0
  FrKind = 0
  Over = 0
  Hits = 0
  Shots = 0
  Lost = 0
  AimNext = 0
  for Ri = 0 to NRock - 1
    Launch(Ri)
  next
  ShowScore
  ShowLevel
  ShowShips
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: METEOR STRIKE in rock letters over the stars, a meteor
' drifting by, START / CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 352 to vram.name + 32
  print at 2,13, "COMPUTE!'S GAZETTE JULY 1986"
  print at 13,16, "START"
  print at 13,17, "CREDITS"
  if Best > 0 then
    print at 9,20, "BEST ", digits$(Best, 4), "00"
  end if
  print at 2,22, "STICK MOVES   BUTTON FIRES"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' a big meteor drifts across rows 14-19, a pixel every other frame
sub TitleAnim:
  V = Tick & 1
  if V = 0 then
    inc TmX
    if TmX > 160 then TmX = 0
  end if
  X = TmX + 40
  set sprite 3 to 112,X,SBig,14
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,16
  put char 32 at 11,17
  J = Menu + 16
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "METEOR STRIKE"
  print at 2,5, "BASED ON METEOR STRIKE,"
  print at 2,6, "COMPUTE!'S GAZETTE, JULY"
  print at 2,7, "1986 (COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE; AUTHOR NOT NAMED"
  print at 2,9, "ON THE DISK)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: FALLING STARS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

