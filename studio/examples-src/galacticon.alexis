' GALACTICON
' The arcade game by Bill Chin and George Miller from COMPUTE! magazine,
' April 1988 (Commodore 64, Atari ST, Apple II), for the ColecoVision in
' Amy by Amy Bienvenu.
'
' Aliens have put a device in the sun that throws fireballs at the
' planets. Steer the crosshair and shoot each fireball before it reaches
' its planet; a planet takes three hits, then it is gone. Blue flares do
' no harm. Shooting heats the blaster: the energy bar shows what is left,
' and the crosshair turns red when it is too hot to fire. Destroy enough
' fireballs and the next level is faster. The game ends when the last
' planet is destroyed.
'
' Controls (either joystick): the stick moves the crosshair; a side
' button fires. Keypad not used.
'
' Liberties taken:
' - Four planets on four orbits (drawn as dotted rings, like the ST
'   version); the fireballs steer toward their planet.
' - Each planet takes three hits (the 64 version: "several"); its colour
'   darkens with each one.
' - Scoring: 10 points a fireball times the level, 50 a planet left at the
'   end of a level. The high score is kept until power off.
' - New music (Solar Wind) and sound effects.
'
' House rules kept: columns 2-29, rows 1-22; the crosshair is a stable
' sprite; planets, fireballs and the explosion share the others and take
' turns (flicker) only when more than four meet on a line; the frame
' loop is protected from the NMI and every screen is drawn with the NMI
' off after a wait.

const TSun000 = 128
const TSun001 = 129
const TSun002 = 130
const TSun003 = 131
const TSun010 = 132
const TSun011 = 133
const TSun012 = 134
const TSun013 = 135
const TSun020 = 136
const TSun021 = 137
const TSun022 = 138
const TSun023 = 139
const TSun030 = 140
const TSun031 = 141
const TSun032 = 142
const TSun033 = 143
const TSun100 = 144
const TSun101 = 145
const TSun102 = 146
const TSun103 = 147
const TSun110 = 148
const TSun111 = 149
const TSun112 = 150
const TSun113 = 151
const TSun120 = 152
const TSun121 = 153
const TSun122 = 154
const TSun123 = 155
const TSun130 = 156
const TSun131 = 157
const TSun132 = 158
const TSun133 = 159
const TDot00 = 160
const TDot01 = 161
const TDot10 = 162
const TDot11 = 163
const TStar00 = 164
const TStar01 = 165
const TStar10 = 166
const TStar11 = 167
const TBstar00 = 168
const TBstar01 = 169
const TBstar10 = 170
const TBstar11 = 171
const TBarE = 172
const TBarF = 173
const TBarH = 174
const SCross = 0
const SPlanet0 = 4
const SPlanet1 = 8
const SPlanet2 = 12
const SPlanet3 = 16
const SFire0 = 20
const SFire1 = 24
const SBoom0 = 28
const SBoom1 = 32
const NTiles8 = 376
const SprBytes = 288
const SndTick = 1
const SndZap = 2
const SndHot = 3
const SndBoom = 4
const SndHit = 5
const SndLaunch = 6
const SndLevel = 7
const SndClear = 8
const SndOver = 9
const SndTuneA = 10
const SndTuneB = 11

u8 PA[4]
u8 PHp[4]
u8 PX[4]
u8 PY[4]
u8 FAct[3]
u16 FX[3]
u16 FY[3]
u8 FVX[3]
u8 FVY[3]
u8 FSX[3]
u8 FSY[3]
u8 FTg[3]
u8 FTy[3]
u8 FAge[3]
u16 Score = 0
u16 High = 0
u16 NumU = 0
u16 P = 0
u16 Q = 0
u8 Level = 1
u8 Kills = 0
u8 Need = 8
u8 Spd = 10
u8 SpawnT = 60
u8 MaxF = 1
u8 Energy = 100
u8 Shown = 255
u8 CXp = 120
u8 CYp = 120
u8 BX = 0
u8 BY = 0
u8 BT = 0
u8 Alive = 4
u8 SunF = 0
u8 Fi = 0
u8 Pi = 0
u8 Ax = 0
u8 Ay = 0
u8 M = 0
u8 Menu = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Hold = 0
u8 Lk = 0
u8 Tick = 0
u8 Mix = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table GaSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  High = 0

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    EditorialPage
    goto title
  end if
  Score = 0
  Level = 1
  for J = 0 to 3
    PHp[J] = 3
    PA[J] = J * 64
  next
  Alive = 4
  PlayScreen

new_level:
  for J = 0 to 2
    FAct[J] = 0
  next
  BT = 0
  Kills = 0
  Need = Level * 2
  Need = Need + 6
  Spd = Level * 3
  Spd = Spd + 9
  if Spd > 40 then Spd = 40
  MaxF = Level + 1
  MaxF = MaxF >> 1
  if MaxF > 3 then MaxF = 3
  SpawnT = 90
  Energy = 100
  Shown = 255
  ShowHud
  Message
  print at 9,22, "LEVEL"
  NumU = Level
  print at 15,22, digits$(NumU, 2)
  print at 18,22, "READY"
  play sound SndLevel
  for Lk = 1 to 90
    Frame1
    MovePlanets
    DrawSprites
  next
  Message

play_loop:
  Frame1
  ReadPad
  MoveCross
  MovePlanets
  Spawn
  MoveFire
  if Press = 1 then Shoot
  ' the blaster cools down
  V = Tick & 1
  if V = 0 then
    if Energy < 100 then inc Energy
  end if
  ShowEnergy
  AnimateSun
  DrawSprites
  if Alive = 0 then goto game_over
  if Kills >= Need then goto level_done
  goto play_loop

level_done:
  for J = 1 to Alive
    Score = Score + 50
  next
  ShowHud
  Message
  print at 8,22, "LEVEL CLEARED!"
  play sound SndClear
  for J = 0 to 2
    FAct[J] = 0
  next
  for Lk = 1 to 100
    Frame1
    MovePlanets
    DrawSprites
  next
  inc Level
  goto new_level

game_over:
  for J = 0 to 2
    FAct[J] = 0
  next
  DrawSprites
  if Score > High then High = Score
  ShowHud
  Message
  print at 3,22, "THE PLANETS ARE DESTROYED"
  play sound SndOver
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------
' The planets

sub MovePlanets:
  ' inner orbits turn faster
  inc PA[0]
  V = Tick & 1
  if V = 0 then inc PA[1]
  V = Tick & 3
  if V = 0 then inc PA[2]
  V = Tick & 7
  if V = 0 then inc PA[3]
  for Pi = 0 to 3
    V = PA[Pi] >> 2
    P = OrbXT[Pi]
    PX[Pi] = peek(P + V)
    P = OrbYT[Pi]
    PY[Pi] = peek(P + V)
  next
  return
end sub

' ---------------------------------------------------------------------------
' Fireballs

sub Spawn:
  if SpawnT > 0 then
    dec SpawnT
    return
  end if
  ' a free slot, within this level's number
  Fi = 255
  K = MaxF - 1
  for J = 0 to K
    if FAct[J] = 0 then
      if Fi = 255 then Fi = J
    end if
  next
  if Fi = 255 then return
  V = 30
  if Level < 12 then
    W = Level * 5
    V = 90 - W
  end if
  W = V + 30
  SpawnT = random(V, W)
  ' a living planet to aim at
  V = random(0, 3)
  for J = 0 to 3
    if PHp[V] = 0 then
      inc V
      V = V & 3
    end if
  next
  FTg[Fi] = V
  FAct[Fi] = 1
  FAge[Fi] = 0
  FX[Fi] = 2048
  FY[Fi] = 1536
  FTy[Fi] = 0
  V = random(0, 3)
  if V = 0 then
    ' a harmless flare: straight out in a random direction
    FTy[Fi] = 1
    FVX[Fi] = random(4, 14)
    FVY[Fi] = random(4, 14)
    FSX[Fi] = random(0, 1)
    FSY[Fi] = random(0, 1)
  else
    Steer
  end if
  play sound SndLaunch
  return
end sub

' Steer: fireball Fi heads for its planet (speed Spd, in 1/16 pixels)
sub Steer:
  K = FTg[Fi]
  if PHp[K] = 0 then
    ' its planet is gone: pick another
    for J = 0 to 3
      if PHp[K] = 0 then
        inc K
        K = K & 3
      end if
    next
    FTg[Fi] = K
  end if
  P = FX[Fi] >> 4
  X = P
  P = FY[Fi] >> 4
  Y = P
  V = PX[K] + 8
  W = PY[K] + 9
  FSX[Fi] = 0
  if V >= X then
    Ax = V - X
  else
    Ax = X - V
    FSX[Fi] = 1
  end if
  FSY[Fi] = 0
  if W >= Y then
    Ay = W - Y
  else
    Ay = Y - W
    FSY[Fi] = 1
  end if
  M = Ax
  if Ay > M then M = Ay
  if M = 0 then M = 1
  Q = Ax * Spd
  Q = Q / M
  FVX[Fi] = Q
  Q = Ay * Spd
  Q = Q / M
  FVY[Fi] = Q
  return
end sub

sub MoveFire:
  for Fi = 0 to 2
    if FAct[Fi] = 1 then
      inc FAge[Fi]
      if FTy[Fi] = 0 then
        V = FAge[Fi] & 3
        if V = 0 then Steer
      end if
      if FSX[Fi] = 0 then
        FX[Fi] = FX[Fi] + FVX[Fi]
      else
        FX[Fi] = FX[Fi] - FVX[Fi]
      end if
      if FSY[Fi] = 0 then
        FY[Fi] = FY[Fi] + FVY[Fi]
      else
        FY[Fi] = FY[Fi] - FVY[Fi]
      end if
      P = FX[Fi] >> 4
      X = P
      P = FY[Fi] >> 4
      Y = P
      ' off the play area or an old flare: gone
      if X < 20 then FAct[Fi] = 0
      if X > 236 then FAct[Fi] = 0
      if Y < 20 then FAct[Fi] = 0
      if Y > 170 then FAct[Fi] = 0
      if FTy[Fi] = 1 then
        if FAge[Fi] > 90 then FAct[Fi] = 0
      else
        ' has it reached its planet?
        K = FTg[Fi]
        V = PX[K] + 8
        W = PY[K] + 9
        Ax = X - V
        if X < V then Ax = V - X
        Ay = Y - W
        if Y < W then Ay = W - Y
        if Ax < 6 then
          if Ay < 6 then
            FAct[Fi] = 0
            dec PHp[K]
            BX = PX[K]
            BY = PY[K]
            BT = 16
            play sound SndHit
            if PHp[K] = 0 then dec Alive
          end if
        end if
      end if
    end if
  next
  return
end sub

' Shoot: the blaster at the crosshair's centre
sub Shoot:
  if Energy < 15 then
    play sound SndHot
    return
  end if
  Energy = Energy - 15
  play sound SndZap
  X = CXp + 8
  Y = CYp + 8
  for Fi = 0 to 2
    if FAct[Fi] = 1 then
      P = FX[Fi] >> 4
      V = P
      P = FY[Fi] >> 4
      W = P
      Ax = X - V
      if X < V then Ax = V - X
      Ay = Y - W
      if Y < W then Ay = W - Y
      if Ax < 10 then
        if Ay < 10 then
          FAct[Fi] = 0
          BX = V - 8
          BY = W - 9
          BT = 16
          play sound SndBoom
          if FTy[Fi] = 0 then
            inc Kills
            for J = 1 to Level
              Score = Score + 10
            next
            ShowHud
          end if
        end if
      end if
    end if
  next
  return
end sub

sub MoveCross:
  ' faster while the stick is held
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 0 then
    Hold = 0
    return
  end if
  if Hold < 30 then inc Hold
  W = 1
  if Hold > 8 then W = 2
  if Hold > 20 then W = 3
  if Lf1 = 1 then
    V = 16 + W
    if CXp > V then CXp = CXp - W
  end if
  if Rt1 = 1 then
    V = 224 - W
    if CXp < V then CXp = CXp + W
  end if
  if Up1 = 1 then
    V = 12 + W
    if CYp > V then CYp = CYp - W
  end if
  if Dn1 = 1 then
    V = 158 - W
    if CYp < V then CYp = CYp + W
  end if
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

sub DrawSprites:
  V = 15
  if Energy < 15 then V = 8
  set sprite 0 to CYp, CXp, SCross, V
  for Pi = 0 to 3
    J = Pi + 1
    if PHp[Pi] = 0 then
      set sprite J to 192, 0, 0, 0
    else
      ' colours: blue, green, cyan, light red; darker when hit
      V = PlanetCol[Pi]
      if PHp[Pi] = 2 then V = PlanetCol2[Pi]
      if PHp[Pi] = 1 then V = 14
      K = Pi * 4
      K = K + SPlanet0
      set sprite J to PY[Pi], PX[Pi], K, V
    end if
  next
  for Fi = 0 to 2
    J = Fi + 5
    if FAct[Fi] = 1 then
      P = FX[Fi] >> 4
      X = P
      P = FY[Fi] >> 4
      Y = P
      X = X - 8
      Y = Y - 9
      K = SFire0
      V = Tick & 4
      if V > 0 then K = SFire1
      V = 11
      if FTy[Fi] = 1 then V = 5
      set sprite J to Y, X, K, V
    else
      set sprite J to 192, 0, 0, 0
    end if
  next
  if BT > 0 then
    dec BT
    K = SBoom0
    if BT < 8 then K = SBoom1
    V = 11
    if BT < 8 then V = 8
    set sprite 8 to BY, BX, K, V
  else
    set sprite 8 to 192, 0, 0, 0
  end if
  update sprites
  return
end sub

data PlanetCol bytes 5, 3, 7, 9
data PlanetCol2 bytes 4, 12, 4, 6

sub AnimateSun:
  V = Tick & 15
  if V <> 0 then return
  SunF = 1 - SunF
  K = TSun000
  if SunF = 1 then K = TSun100
  for J = 0 to 3
    Y = J + 10
    for W = 0 to 3
      X = W + 14
      put char K at X,Y
      inc K
    next
  next
  return
end sub

sub ShowEnergy:
  V = Energy / 5
  if V = Shown then return
  Shown = V
  for J = 0 to 19
    X = J + 9
    K = TBarE
    if J < V then
      K = TBarF
      if Energy < 15 then K = TBarH
    end if
    put char K at X,21
  next
  return
end sub

sub ShowHud:
  print at 2,1, "LEVEL"
  NumU = Level
  print at 8,1, digits$(NumU, 2)
  print at 11,1, "SCORE"
  NumU = Score
  print at 17,1, digits$(NumU, 5)
  print at 23,1, "HI"
  NumU = High
  print at 25,1, digits$(NumU, 5)
  return
end sub

sub Message:
  fill 32 count 28 at 2,22
  return
end sub

sub PlayScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  copy BgMap count 640 to vram.name + 64
  print at 2,21, "ENERGY"
  Shown = 255
  ShowHud
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  if V = 1 then
    if WasStick = 0 then Stick = 1
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub TitlePage:
  NewScreen
  copy BgMap count 640 to vram.name + 64
  print at 10,3, "GALACTICON"
  print at 11,16, "PLAY"
  print at 11,17, "HOW TO PLAY"
  print at 11,18, "CREDITS"
  print at 10,20, "HIGH"
  NumU = High
  print at 15,20, digits$(NumU, 5)
  print at 4,22, "1988 BILL CHIN, G. MILLER"
  screen on
  nmi off
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
  for J = 0 to 3
    PHp[J] = 3
  next
title_loop:
  Frame1
  ReadPad
  MovePlanets
  AnimateSun
  for Pi = 0 to 3
    J = Pi + 1
    V = PlanetCol[Pi]
    K = Pi * 4
    K = K + SPlanet0
    set sprite J to PY[Pi], PX[Pi], K, V
  next
  update sprites
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndTick
  end if
  print at 9,16, " "
  print at 9,17, " "
  print at 9,18, " "
  Y = Menu + 16
  print at 9,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "A DEVICE IN THE SUN THROWS"
  print at 2,4, "FIREBALLS AT THE PLANETS."
  print at 2,6, "STICK: MOVE THE CROSSHAIR."
  print at 2,7, "BUTTON: FIRE."
  print at 2,9, "SHOOT THE YELLOW FIREBALLS"
  print at 2,10, "BEFORE THEY REACH A PLANET."
  print at 2,11, "BLUE FLARES ARE HARMLESS."
  print at 2,13, "EACH SHOT HEATS THE BLASTER:"
  print at 2,14, "WATCH THE ENERGY BAR. RED"
  print at 2,15, "CROSSHAIR: LET IT COOL."
  print at 2,17, "A PLANET TAKES THREE HITS."
  print at 2,18, "LOSE THEM ALL: GAME OVER."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  NewScreen
  print at 10,1, "GALACTICON"
  print at 2,3, "BY BILL CHIN AND GEORGE"
  print at 2,4, "MILLER, FROM COMPUTE!"
  print at 2,5, "MAGAZINE, APRIL 1988, FOR"
  print at 2,6, "THE COMMODORE 64, ATARI ST"
  print at 2,7, "AND APPLE II."
  print at 2,9, "NEW MUSIC: SOLAR WIND."
  print at 2,11, "COLECOVISION VERSION BY"
  print at 2,12, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  screen on
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

