sub AwNewGame:
  for I = 1 to 12
    Pits[I] = 3
  next
  HomeMe = 0
  HomeYou = 0
  Sel = 12
  return
end sub

' Sides: Cw, Hw = the seeds on the computer's and on your side
sub Sides:
  Cw = 0
  Hw = 0
  for I = 1 to 6
    Cw = Cw + Pits[I]
  next
  for I = 7 to 12
    Hw = Hw + Pits[I]
  next
  return
end sub

' Sow: the seeds of pit C, one to each next pit (C itself skipped);
' Gain = the seeds taken from the pit opposite the last one, when it was
' empty. With Anim = 1 every seed is drawn as it falls.
sub Sow:
  N = Pits[C]
  Pits[C] = 0
  if Anim = 1 then
    P = C
    DrawPit
  end if
  P = C
  for J = 1 to N
sw_next:
    inc P
    if P > 12 then P = 1
    if P = C then goto sw_next
    inc Pits[P]
    if Anim = 1 then
      Hand
      DrawPit
      play sound SndDrop
      for K = 1 to 8
        AwFrame1
      next
    end if
  next
  Last = P
  Gain = 0
  if Pits[Last] <> 1 then return
  O = 13 - Last
  Gain = Pits[O]
  if Gain = 0 then return
  Pits[O] = 0
  if Anim = 1 then
    P = O
    DrawPit
  end if
  return
end sub

' ChooseMove: C = the computer's pit
sub AwChooseMove:
  copy Pits to AwSv
  AwBestS = 0
  BestC = 0
  for Mc = 1 to 6
    if AwSv[Mc] > 0 then
      C = Mc
      Sow
      AwScore = Gain
      if Level = 1 then
        ' the best capture you could make in reply
        copy Pits to Sw
        MaxR = 0
        for Hc = 7 to 12
          if Sw[Hc] > 0 then
            C = Hc
            Sow
            if Gain > MaxR then MaxR = Gain
            copy Sw to Pits
          end if
        next
        AwScore = AwScore + 100
        AwScore = AwScore - MaxR
      end if
      V = 0
      if AwScore > AwBestS then V = 1
      if AwScore = AwBestS then
        if Level = 1 then
          Rnd
          if Rb < 100 then V = 1
        end if
      end if
      if V = 1 then
        AwBestS = AwScore
        BestC = Mc
      end if
      copy AwSv to Pits
    end if
  next
  C = BestC
  if Level = 1 then return
  if AwBestS > 0 then return
  ' no capture: a pit picked at random, as the book did
cm_try:
  Rnd
  V = Rb & 7
  if V = 0 then goto cm_try
  if V > 6 then goto cm_try
  if Pits[V] = 0 then goto cm_try
  C = V
  return
end sub

' Rnd: Rb = a random byte (16-bit xorshift)
sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' PitXY: X, Y = the top-left tile of pit P
sub PitXY:
  if P <= 6 then
    X = P - 1
    X = X * 3
    X = X + 7
    Y = 7
  else
    X = 12 - P
    X = X * 3
    X = X + 7
    Y = 11
  end if
  return
end sub

sub DrawPit:
  PitXY
  ' the picture with the seeds: none to nine, or a heap
  V = Pits[P]
  if V > 10 then V = 10
  W = V * 9
  W = W + TPit0_00
  Quad3
  W = X + 1
  ' the count, above the top pits and below the bottom ones
  I = Y - 1
  if P > 6 then I = Y + 3
  print at X,I, "   "
  NumU = Pits[P]
  if NumU < 10 then
    print at W,I, digits$(NumU, 1)
  else
    print at W,I, digits$(NumU, 2)
  end if
  return
end sub

' Quad3: the 3 x 3 tiles from W at X, Y
sub Quad3:
  for I = 0 to 2
    V = Y + I
    put char W at X,V
    inc W
    inc X
    put char W at X,V
    inc W
    inc X
    put char W at X,V
    inc W
    X = X - 2
  next
  return
end sub

sub Hand:
  PitXY
  V = Y * 8
  V = V + 3
  W = X * 8
  W = W + 4
  set sprite 0 to V, W, SHand, 11
  update sprites
  return
end sub

sub ShowHomes:
  NumU = HomeYou
  print at 4,10, digits$(NumU, 2)
  NumU = HomeMe
  print at 27,10, digits$(NumU, 2)
  return
end sub

sub AwDrawBoard:
  for Y = 7 to 13
    fill TWood count 28 at 2,Y
  next
  ' the homes
  W = THome00
  for Y = 7 to 13
    put char W at 3,Y
    inc W
    put char W at 4,Y
    inc W
    put char W at 5,Y
    inc W
  next
  W = THome00
  for Y = 7 to 13
    put char W at 26,Y
    inc W
    put char W at 27,Y
    inc W
    put char W at 28,Y
    inc W
  next
  for P = 1 to 12
    DrawPit
  next
  print at 8,5, "A  B  C  D  E  F"
  print at 8,15, "L  K  J  I  H  G"
  print at 3,15, "YOU"
  print at 26,15, "ME"
  ShowHomes
  return
end sub

sub AwMessage:
  for I = 18 to 22
    fill 32 count 28 at 2,I
  next
  return
end sub

sub AwBoardScreen:
  AwNewScreen
  print at 13,2, "AWARI"
  AwDrawBoard
  AwShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub AwRearm:
  nmi off
  nmi on
  return
end sub

sub AwFrame1:
  AwRearm
  wait
  nmi off
  inc Tick
  return
end sub

sub AwPause:
  for J = 1 to 40
    AwFrame1
  next
  return
end sub

sub AwPause20:
  for J = 1 to 20
    AwFrame1
  next
  return
end sub

sub AwReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub AwHideSprites:
  clear sprites
  set sprite count 2
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub AwNewScreen:
  AwRearm
  wait
  nmi off
  display off
  AwHideSprites
  fill mode 2 text color with $F0
  copy AwTilePat count AwNTiles8 to vram.pattern + 1024
  copy AwTileCol count AwNTiles8 to vram.color + 1024
  copy AwTilePat count AwNTiles8 to vram.pattern + 3072
  copy AwTileCol count AwNTiles8 to vram.color + 3072
  copy AwTilePat count AwNTiles8 to vram.pattern + 5120
  copy AwTileCol count AwNTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub AwShowScreen:
  screen on
  nmi off
  return
end sub

sub AwTitlePage:
  AwNewScreen
  print at 13,2, "AWARI"
  ' a strip of the board
  for Y = 4 to 6
    fill TWood count 20 at 6,Y
  next
  for K = 1 to 6
    Pits[K] = K
    P = K
    PitXY
    Y = 4
    W = K * 9
    W = W + TPit0_00
    Quad3
  next
  print at 6,10, "PLAY: YOU GO FIRST"
  print at 6,11, "PLAY: I GO FIRST"
  print at 6,12, "LEVEL:"
  print at 6,13, "HOW TO PLAY"
  print at 6,14, "CREDITS"
  print at 6,15, "OTHER GAME"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  AwShowScreen
  Menu = 0
  play sound AwSndTuneA
  play sound AwSndTuneB
  WasBtn = 1
aw_title_loop:
  AwFrame1
  Rnd
  AwReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 5 then inc Menu
    end if
    play sound AwSndMove
  end if
  for I = 10 to 15
    print at 4,I, " "
  next
  Y = Menu + 10
  print at 4,Y, ">"
  if Level = 0 then print at 13,12, "BOOK  "
  if Level = 1 then print at 13,12, "MASTER"
  if Press = 0 then goto aw_title_loop
  if Menu = 2 then
    Level = 1 - Level
    play sound SndDrop
    goto aw_title_loop
  end if
  mute all
  return
end sub

sub AwRulesPage:
  AwNewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "YOUR PITS ARE L TO G, MINE"
  print at 2,4, "A TO F. PICK ONE OF YOURS:"
  print at 2,5, "ITS SEEDS ARE SOWN ONE BY"
  print at 2,6, "ONE INTO THE NEXT PITS,"
  print at 2,7, "CLOCKWISE. HOMES GET NONE."
  print at 2,9, "IF THE LAST SEED FALLS IN AN"
  print at 2,10, "EMPTY PIT, THE SEEDS OF THE"
  print at 2,11, "PIT OPPOSITE GO TO YOUR HOME"
  print at 2,12, "(YOURS LEFT, MINE RIGHT)."
  print at 2,14, "WHEN ONE SIDE IS EMPTY THE"
  print at 2,15, "GAME ENDS: THE FULLER HOME"
  print at 2,16, "WINS."
  print at 2,18, "STICK: PICK A PIT."
  print at 2,19, "BUTTON: SOW IT."
  print at 8,22, "PRESS A BUTTON"
  AwShowScreen
  AwRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub AwEditorialPage:
  AwNewScreen
  print at 13,1, "AWARI"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983)."
  print at 2,9, "AWARI IS ONE OF THE MANCALA"
  print at 2,10, "GAMES, PLAYED FROM AFRICA"
  print at 2,11, "TO THE PHILIPPINES."
  print at 2,13, "NEW MUSIC: SEED SONG."
  print at 2,15, "COLECOVISION VERSION BY"
  print at 2,16, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  AwShowScreen
  AwRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

