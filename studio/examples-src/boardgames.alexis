  tile screen
  sprites 16x16
  nmi off
  Level = 0
  set sound table RvSoundTable areas 4
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

cart:
  CartPage
  if Menu = 0 then goto ck_title
  if Menu = 2 then goto aw_title
  goto title

title:
  set sound table RvSoundTable areas 4
  sprites simple
  copy SpritePat count SprBytes to vram.spr_pat
  TitlePage
  if Menu = 5 then goto cart
  if Menu = 3 then
    RulesPage
    goto title
  end if
  if Menu = 4 then
    EditorialPage
    goto title
  end if
  if Menu = 2 then goto title
  First = Menu
  Mode = 0
  NewGame
  BoardScreen
  Passes = 0
  if First = 1 then goto computer_turn

player_turn:
  ' can the player move at all?
  Side = You
  Opp = Me
  CountMoves
  if Moves = 0 then
    inc Passes
    if Passes >= 2 then goto game_end
    Message
    print at 2,22, "YOU CANNOT MOVE: YOU PASS"
    play sound SndPass
    Pause
    goto computer_turn
  end if
  Passes = 0
  ShowHints
  Message
  print at 2,22, "YOUR MOVE"
  Mode = 1
player_loop:
  Frame1
  ReadPad
  MoveCursor
  DrawCursor
  if Press = 0 then goto player_loop
  Sq = Cur
  Side = You
  Opp = Me
  CountFlips
  if Q = 0 then
    play sound SndBad
    goto player_loop
  end if
  HideSprites
  ClearHints
  PlayMove
  V = Mine + Yours
  if V = 64 then goto game_end

computer_turn:
  Side = Me
  Opp = You
  Message
  print at 2,22, "MY MOVE..."
  ChooseMove
  if Best = 0 then
    inc Passes
    if Passes >= 2 then goto game_end
    Message
    print at 2,22, "I CANNOT MOVE: I PASS"
    play sound SndPass
    Pause
    goto player_turn
  end if
  Passes = 0
  Pause
  Sq = Best
  Side = Me
  Opp = You
  CountFlips
  PlayMove
  V = Mine + Yours
  if V = 64 then goto game_end
  goto player_turn

game_end:
  HideSprites
  ClearHints
  Message
  if Mine > Yours then
    print at 2,22, "I'M THE CHAMPION!"
    play sound SndLose
  end if
  if Yours > Mine then
    print at 2,22, "YOU'RE THE CHAMPION!"
    play sound SndWin
  end if
  if Yours = Mine then print at 2,22, "IT'S A DRAW!"
  Mode = 2
  Rearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  goto title

' ---------------------------------------------------------------------------
' The board: B[r * 10 + c], rows and columns 1-8 inside a border (3);
' 0 empty, 1 the computer (black), 2 you (white)


ck_title:
  set sound table CkSoundTable areas 4
  sprites simple
  copy CkSpritePat count CkSprBytes to vram.spr_pat
  CkTitlePage
  if Menu = 3 then goto cart
  if Menu = 1 then
    CkRulesPage
    goto ck_title
  end if
  if Menu = 2 then
    CkEditorialPage
    goto ck_title
  end if
  CkNewGame
  CkBoardScreen

ck_computer_turn:
  CkMessage
  print at 2,22, "MY MOVE..."
  Pause20
  ComputerMove
  if Ok = 0 then
    CkMessage
    print at 2,22, "I CONCEDE THE GAME"
    play sound CkSndWin
    goto ck_game_end
  end if
  Crown
  CkShowPanel
  if Co = 12 then goto i_won
  ' can the player move?
  Kind = 3
  AnyMove
  if Moves = 0 then goto i_won

ck_player_turn:
  CkMessage
  print at 2,22, "YOUR MOVE"
  Sel = 0
  Chain = 0
  Mode = 1
ck_player_loop:
  CkFrame1
  CkReadPad
  CkMoveCursor
  CkDrawCursor
  if Press2 = 1 then
    if Chain = 1 then goto player_done
    if Sel <> 0 then
      ClearDots
      Sel = 0
      play sound SndBack
      goto ck_player_loop
    end if
    ConcedeMenu
    if Menu = 1 then
      CkMessage
      print at 2,22, "YOU CONCEDE"
      play sound CkSndLose
      goto ck_game_end
    end if
    CkMessage
    print at 2,22, "YOUR MOVE"
    goto ck_player_loop
  end if
  if Press = 0 then goto ck_player_loop
  ' a white piece: pick it (not in the middle of a jump)
  V = CkQ[Cur]
  if V >= 3 then
    if Chain = 1 then goto ck_player_loop
    A = Cur
    PieceMoves
    if Ns = 0 then
      play sound CkSndBad
      goto ck_player_loop
    end if
    ClearDots
    Sel = Cur
    ShowDots
    play sound SndPick
    goto ck_player_loop
  end if
  if Sel = 0 then
    play sound CkSndBad
    goto ck_player_loop
  end if
  ' a square for the picked piece
  A = Sel
  PieceMoves
  Found = 255
  for I = 1 to Ns
    J = I - 1
    if Sd[J] = Cur then Found = J
  next
  if Found = 255 then
    play sound CkSndBad
    goto ck_player_loop
  end if
  ClearDots
  CkHideSprites
  M = Cur
  V = Sel
  W = M
  MovePiece
  ' a jump: the piece in between is taken
  V = Sel - M
  if M > Sel then V = M - Sel
  if V > 11 then
    V = Sel + M
    V = V >> 1
    CkQ[V] = 0
    Cell = V
    CkDrawSquare
    inc Hu
    CkShowPanel
    play sound SndTake
    V = random(0, 9)
    if V < 3 then
      CkMessage
      print at 2,22, "GOOD MOVE"
    end if
    if V > 6 then
      CkMessage
      print at 2,22, "GOT ME!"
    end if
    if Hu = 12 then goto you_won
    ' crowned: the turn ends
    Kind = CkQ[M]
    Crown
    if CkQ[M] <> Kind then goto player_done
    ' another jump?
    Sel = M
    A = M
    PieceMoves
    V = 0
    for I = 1 to Ns
      J = I - 1
      if Sl[J] = 1 then V = 1
    next
    if V = 1 then
      Chain = 1
      ShowDots
      CkMessage
      print at 2,21, "JUMP AGAIN, OR RIGHT BUTTON"
      print at 2,22, "TO END YOUR TURN"
      goto ck_player_loop
    end if
  end if
player_done:
  Mode = 0
  ClearDots
  CkHideSprites
  CkMessage
  Crown
  CkShowPanel
  if Hu = 12 then goto you_won
  Kind = 1
  AnyMove
  if Moves = 0 then goto you_won
  goto ck_computer_turn

you_won:
  CkMessage
  print at 2,22, "YOU HAVE WON"
  play sound CkSndWin
  goto ck_game_end
i_won:
  CkMessage
  print at 2,22, "I HAVE WON"
  play sound CkSndLose
ck_game_end:
  Mode = 2
  CkHideSprites
  print at 2,21, "THANKS FOR THE GAME"
  CkRearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  Mode = 0
  goto ck_title

' ---------------------------------------------------------------------------
' Rules


aw_title:
  set sound table AwSoundTable areas 4
  sprites double
  copy AwSpritePat count AwSprBytes to vram.spr_pat
  AwTitlePage
  if Menu = 5 then goto cart
  if Menu = 3 then
    AwRulesPage
    goto aw_title
  end if
  if Menu = 4 then
    AwEditorialPage
    goto aw_title
  end if
  First = Menu
  AwNewGame
  AwBoardScreen
  if First = 1 then goto aw_computer_turn

aw_player_turn:
  Sides
  if Hw = 0 then goto aw_game_end
  if Cw = 0 then goto aw_game_end
  AwMessage
  print at 2,18, "YOUR MOVE: PICK A PIT"
  if Pits[Sel] = 0 then
    ' start on a pit with seeds
    for I = 7 to 12
      if Pits[I] > 0 then Sel = I
    next
  end if
  Mode = 1
aw_player_loop:
  AwFrame1
  AwReadPad
  if Stick = 1 then
    ' L (12) is on the left, G (7) on the right
    if Lf1 = 1 then
      if Sel < 12 then inc Sel
    end if
    if Rt1 = 1 then
      if Sel > 7 then dec Sel
    end if
    play sound AwSndMove
  end if
  P = Sel
  PitXY
  V = Y * 8
  V = V - 1
  W = X * 8
  set sprite 1 to V, W, SFrame, 15
  update sprites
  if Press = 0 then goto aw_player_loop
  if Pits[Sel] = 0 then
    play sound AwSndBad
    goto aw_player_loop
  end if
  Mode = 0
  AwMessage
  print at 2,18, "YOU SOW FROM"
  V = 64 + Sel
  put char V at 15,18
  C = Sel
  Anim = 1
  Sow
  Anim = 0
  AwHideSprites
  if Gain > 0 then
    HomeYou = HomeYou + Gain
    ShowHomes
    play sound AwSndTake
    print at 2,19, "YOU TAKE"
    NumU = Gain
    print at 11,19, digits$(NumU, 2)
    AwPause
  end if
  Sides
  if Hw = 0 then goto aw_game_end
  if Cw = 0 then goto aw_game_end

aw_computer_turn:
  AwMessage
  print at 2,18, "LET ME THINK..."
  AwPause20
  AwChooseMove
  AwMessage
  print at 2,18, "I'LL MOVE FROM"
  V = 64 + C
  put char V at 17,18
  P = C
  PitXY
  V = Y * 8
  V = V - 1
  W = X * 8
  set sprite 1 to V, W, SFrame, 9
  update sprites
  AwPause
  Anim = 1
  Sow
  Anim = 0
  AwHideSprites
  if Gain > 0 then
    HomeMe = HomeMe + Gain
    ShowHomes
    play sound AwSndTake
    print at 2,19, "I TAKE"
    NumU = Gain
    print at 9,19, digits$(NumU, 2)
    AwPause
  end if
  goto aw_player_turn

aw_game_end:
  Mode = 2
  AwHideSprites
  AwMessage
  print at 2,18, "THAT'S THE END OF THE GAME"
  if HomeYou > HomeMe then
    print at 2,19, "YOU'RE THE WINNER!"
    play sound AwSndWin
  end if
  if HomeYou < HomeMe then
    print at 2,19, "AND I'M THE WINNER!"
    play sound AwSndLose
  end if
  if HomeYou = HomeMe then print at 2,19, "IT LOOKS LIKE A DRAW!"
  print at 2,21, "MY SCORE WAS"
  NumU = HomeMe
  print at 15,21, digits$(NumU, 2)
  print at 2,22, "AND YOURS WAS"
  NumU = HomeYou
  print at 16,22, digits$(NumU, 2)
  AwRearm
  wait 120 frames
  pause until press
  wait no fire
  nmi off
  Mode = 0
  goto aw_title

' ---------------------------------------------------------------------------
' Rules


sub CartPage:
  set sound table RvSoundTable areas 4
  sprites simple
  NewScreen
  print at 10,3, "BOARD GAMES"
  ' a white and a black piece
  St = 2
  Cell = 37
  DrawSquare
  St = 1
  Cell = 38
  DrawSquare
  print at 11,13, "CHECKERS"
  print at 11,14, "REVERSI"
  print at 11,15, "AWARI"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  WasBtn = 1
cart_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 2 then inc Menu
    end if
    play sound SndMove
  end if
  print at 9,13, " "
  print at 9,14, " "
  print at 9,15, " "
  Y = Menu + 13
  print at 9,Y, ">"
  if Press = 0 then goto cart_loop
  play sound SndPlace
  Pause6
  return
end sub

sub NewGame:
  for I = 0 to 99
    B[I] = 3
  next
  for I = 1 to 8
    for J = 1 to 8
      V = I * 10
      V = V + J
      B[V] = 0
    next
  next
  B[44] = 1
  B[55] = 1
  B[45] = 2
  B[54] = 2
  Cur = 34
  return
end sub

' the eight directions as steps in B
data Dirs bytes 1, 9, 10, 11, 255, 247, 246, 245

' CountFlips: Q = pieces Side would turn by playing Sq (Fl, Nf list them)
sub CountFlips:
  Q = 0
  Nf = 0
  if B[Sq] <> 0 then return
  for Dir = 0 to 7
    Stp = Dirs[Dir]
    Cnt = 0
    Cell = Sq + Stp
    while B[Cell] = Opp
      inc Cnt
      Cell = Cell + Stp
    end while
    if B[Cell] = Side then
      if Cnt > 0 then
        Q = Q + Cnt
        ' remember them
        Cell = Sq + Stp
        for K = 1 to Cnt
          if Nf < 20 then
            Fl[Nf] = Cell
            inc Nf
          end if
          Cell = Cell + Stp
        next
      end if
    end if
  next
  return
end sub

' CountMoves: Moves = squares where Side can play
sub CountMoves:
  Moves = 0
  for Sq = 11 to 88
    if B[Sq] = 0 then
      QuickQ
      if Q > 0 then inc Moves
    end if
  next
  return
end sub

' QuickQ: Q = pieces Side would turn at Sq (no list)
sub QuickQ:
  Q = 0
  for Dir = 0 to 7
    Stp = Dirs[Dir]
    Cnt = 0
    Cell = Sq + Stp
    while B[Cell] = Opp
      inc Cnt
      Cell = Cell + Stp
    end while
    if B[Cell] = Side then Q = Q + Cnt
  next
  return
end sub

' Weigh: the book's value of Q at Sq, times four: edges x2, the ring
' inside x1/2, beside a corner on the edge x1/2 again
sub Weigh:
  Rq = Sq / 10
  Mq = Rq * 10
  Mq = Sq - Mq
  Score = Q * 4
  V = 0
  if Rq = 1 then V = 1
  if Rq = 8 then V = 1
  if Mq = 1 then V = 1
  if Mq = 8 then V = 1
  if V = 1 then Score = Score + Score
  V = 0
  if Rq = 2 then V = 1
  if Rq = 7 then V = 1
  if Mq = 2 then V = 1
  if Mq = 7 then V = 1
  if V = 1 then Score = Score >> 1
  V = 0
  W = 0
  if Rq = 1 then W = 1
  if Rq = 8 then W = 1
  if Mq = 2 then V = 1
  if Mq = 7 then V = 1
  if W = 1 then
    if V = 1 then Score = Score >> 1
  end if
  V = 0
  W = 0
  if Rq = 2 then W = 1
  if Rq = 7 then W = 1
  if Mq = 1 then V = 1
  if Mq = 8 then V = 1
  if W = 1 then
    if V = 1 then Score = Score >> 1
  end if
  return
end sub

' ChooseMove: Best = the computer's square (0: it must pass)
sub ChooseMove:
  Best = 0
  BestS = 0
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Sq = Ai
      Side = Me
      Opp = You
      QuickQ
      if Q > 0 then
        Weigh
        if Level = 1 then
          ' MASTER: take away the best answer the player would have
          Sq = Ai
          CountFlips
          ReplyCost
          Sq = Ai
          QuickQ
          Weigh
          Score = Score + 64
          if Score > NumU then
            Score = Score - NumU
          else
            Score = 1
          end if
        end if
        V = 0
        if Score > BestS then V = 1
        if Score = BestS then
          W = random(0, 9)
          if W < 3 then V = 1
        end if
        if V = 1 then
          BestS = Score
          Best = Ai
        end if
      end if
    end if
  next
  Side = Me
  Opp = You
  return
end sub

' ReplyCost: NumU = the player's best weighed answer after the computer
' plays Ai (Fl lists what it would turn); the board is put back after
sub ReplyCost:
  ' play it on the board for a moment
  B[Ai] = Me
  for K = 1 to Nf
    V = K - 1
    V = Fl[V]
    B[V] = Me
  next
  NumU = 0
  Side = You
  Opp = Me
  for Sq = 11 to 88
    if B[Sq] = 0 then
      QuickQ
      if Q > 0 then
        Weigh
        if Score > NumU then NumU = Score
      end if
    end if
  next
  ' put it back
  B[Ai] = 0
  for K = 1 to Nf
    V = K - 1
    V = Fl[V]
    B[V] = You
  next
  Side = Me
  Opp = You
  return
end sub

' PlayMove: Side plays Sq; the pieces in Fl turn over, one after another
sub PlayMove:
  B[Sq] = Side
  Cell = Sq
  St = Side
  DrawSquare
  play sound SndPlace
  Pause6
  for K = 1 to Nf
    V = K - 1
    Cell = Fl[V]
    B[Cell] = Side
    ' the turn: half, edge, half, done
    St = 3
    if Side = 1 then St = 4
    DrawSquare
    Frame3
    St = 5
    DrawSquare
    Frame3
    St = 4
    if Side = 1 then St = 3
    DrawSquare
    Frame3
    St = Side
    DrawSquare
    play sound SndFlip
  next
  CountPieces
  ShowPanel
  return
end sub

sub CountPieces:
  Mine = 0
  Yours = 0
  for I = 11 to 88
    if B[I] = 1 then inc Mine
    if B[I] = 2 then inc Yours
  next
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' DrawSquare: square Cell in state St (0 empty, 1 black, 2 white, 3 black
' half, 4 white half, 5 edge, 6 hint)
sub DrawSquare:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  Bg = X + Y
  Bg = Bg & 1
  W = Bg * 7
  W = W + St
  W = W * 4
  W = W + TQ0ea
  X = X * 2
  X = X + 1
  Y = Y * 2
  Y = Y + 2
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub DrawBoard:
  ' the frame: columns 2 and 19, rows 3 and 20
  put char TFtl at 2,3
  fill TFt count 16 at 3,3
  put char TFtr at 19,3
  for Y = 4 to 19
    put char TFl at 2,Y
    put char TFr at 19,Y
  next
  put char TFbl at 2,20
  fill TFt count 16 at 3,20
  put char TFbr at 19,20
  for I = 1 to 8
    for J = 1 to 8
      Cell = I * 10
      Cell = Cell + J
      St = B[Cell]
      DrawSquare
    next
  next
  return
end sub

sub ShowHints:
  Side = You
  Opp = Me
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Sq = Ai
      QuickQ
      if Q > 0 then
        Cell = Ai
        St = 6
        DrawSquare
      end if
    end if
  next
  return
end sub

sub ClearHints:
  for Ai = 11 to 88
    if B[Ai] = 0 then
      Cell = Ai
      St = 0
      DrawSquare
    end if
  next
  return
end sub

sub ShowPanel:
  print at 21,4, "ME"
  put char TQ0ba at 21,5
  put char TQ0bb at 22,5
  put char TQ0bc at 21,6
  put char TQ0bd at 22,6
  NumU = Mine
  print at 24,6, digits$(NumU, 2)
  print at 21,9, "YOU"
  put char TQ0wa at 21,10
  put char TQ0wb at 22,10
  put char TQ0wc at 21,11
  put char TQ0wd at 22,11
  NumU = Yours
  print at 24,11, digits$(NumU, 2)
  print at 21,15, "LEVEL"
  if Level = 0 then print at 21,16, "CLASSIC"
  if Level = 1 then print at 21,16, "MASTER "
  return
end sub

sub DrawCursor:
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  X = X * 16
  X = X + 8
  Y = Y * 16
  Y = Y + 15
  V = Tick & 8
  W = 11
  if V > 0 then W = 10
  set sprite 0 to Y, X, SCursor, W
  update sprites
  return
end sub

sub MoveCursor:
  if Stick = 0 then return
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  if Lf1 = 1 then
    if X > 1 then dec Cur
  end if
  if Rt1 = 1 then
    if X < 8 then inc Cur
  end if
  if Up1 = 1 then
    if Y > 1 then Cur = Cur - 10
  end if
  if Dn1 = 1 then
    if Y < 8 then Cur = Cur + 10
  end if
  play sound SndMove
  return
end sub

sub Message:
  fill 32 count 28 at 2,22
  return
end sub

sub BoardScreen:
  NewScreen
  print at 2,1, "REVERSI"
  CountPieces
  DrawBoard
  ShowPanel
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub Frame3:
  for J = 1 to 3
    Frame1
  next
  return
end sub

sub Pause6:
  for J = 1 to 6
    Frame1
  next
  return
end sub

sub Pause:
  for J = 1 to 40
    Frame1
  next
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

' the title: a row of pieces turning over
sub TitlePage:
  NewScreen
  print at 11,2, "REVERSI"
  print at 6,13, "PLAY: YOU GO FIRST"
  print at 6,14, "PLAY: I GO FIRST"
  print at 6,15, "LEVEL:"
  print at 6,16, "HOW TO PLAY"
  print at 6,17, "CREDITS"
  print at 6,18, "OTHER GAME"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  ShowScreen
  Menu = 0
  play sound SndTuneA
  play sound SndTuneB
  WasBtn = 1
title_loop:
  Frame1
  ReadPad
  ' eight pieces in a row, turning one after another
  V = Tick >> 3
  for I = 0 to 7
    Cell = 21 + I
    W = V + I
    W = W & 7
    St = 1
    if W = 1 then St = 3
    if W = 2 then St = 5
    if W = 3 then St = 4
    if W >= 4 then St = 2
    if W = 5 then St = 4
    if W = 6 then St = 5
    if W = 7 then St = 3
    DrawSquare
  next
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 5 then inc Menu
    end if
    play sound SndMove
  end if
  for I = 13 to 18
    print at 4,I, " "
  next
  Y = Menu + 13
  print at 4,Y, ">"
  if Level = 0 then print at 13,15, "CLASSIC"
  if Level = 1 then print at 13,15, "MASTER "
  if Press = 0 then goto title_loop
  if Menu = 2 then
    Level = 1 - Level
    play sound SndPlace
    goto title_loop
  end if
  mute all
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "YOU ARE WHITE, I AM BLACK."
  print at 2,5, "PLAY A PIECE SO THAT A LINE"
  print at 2,6, "OF MY PIECES LIES BETWEEN IT"
  print at 2,7, "AND ANOTHER OF YOURS: THEY"
  print at 2,8, "ALL TURN WHITE. LINES MAY"
  print at 2,9, "RUN ACROSS, DOWN OR ON THE"
  print at 2,10, "DIAGONALS."
  print at 2,12, "THE DOTS SHOW WHERE YOU CAN"
  print at 2,13, "PLAY. NO MOVE: YOU PASS."
  print at 2,15, "THE MOST PIECES WHEN THE"
  print at 2,16, "BOARD IS FULL, OR NEITHER"
  print at 2,17, "CAN MOVE, WINS."
  print at 2,19, "STICK: CURSOR. BUTTON: PLAY."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub EditorialPage:
  NewScreen
  print at 11,1, "REVERSI"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983). THE PROGRAM IS BASED"
  print at 2,8, "ON ONE BY GRAHAM CHARLTON."
  print at 2,10, "REVERSI WAS INVENTED IN"
  print at 2,11, "LONDON IN THE 1880S."
  print at 2,13, "NEW MUSIC: QUEEN'S GAMBIT"
  print at 2,14, "RAG."
  print at 2,16, "COLECOVISION VERSION BY"
  print at 2,17, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

