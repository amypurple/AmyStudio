sub CkNewGame:
  for I = 0 to 99
    CkQ[I] = 255
  next
  for I = 1 to 8
    for J = 1 to 8
      V = I + J
      V = V & 1
      if V = 0 then
        K = I * 10
        K = K + J
        CkQ[K] = 0
        if I <= 3 then CkQ[K] = 3
        if I >= 6 then CkQ[K] = 1
      end if
    next
  next
  Co = 0
  Hu = 0
  Cur = 33
  return
end sub

' the directions: down-left, down-right (red's way), up-left, up-right
data CkDirs bytes 245, 247, 9, 11

' Range: D0, D1 = the directions piece Pc may use
sub Range:
  D0 = 0
  D1 = 3
  if Pc = 1 then D1 = 1
  if Pc = 3 then D0 = 2
  return
end sub

' Enemy: Ok = 1 when the piece V belongs to the other side of Pc
sub Enemy:
  Ok = 0
  if V = 0 then return
  if V = 255 then return
  if Pc <= 2 then
    if V >= 3 then Ok = 1
  else
    if V <= 2 then Ok = 1
  end if
  return
end sub

' PieceMoves: the moves of the piece on A: Sd = squares, Sl = 1 for a jump
sub PieceMoves:
  Ns = 0
  Pc = CkQ[A]
  Range
  for Dd = D0 to D1
    W = CkDirs[Dd]
    M = A + W
    V = CkQ[M]
    if V = 0 then
      if Chain = 0 then
        Sd[Ns] = M
        Sl[Ns] = 0
        inc Ns
      end if
    else
      Enemy
      if Ok = 1 then
        L = M + W
        if CkQ[L] = 0 then
          Sd[Ns] = L
          Sl[Ns] = 1
          inc Ns
        end if
      end if
    end if
  next
  return
end sub

' AnyMove: Moves = how many pieces of side Kind (1 red, 3 white) can move
sub AnyMove:
  Moves = 0
  Chain = 0
  for Ai = 11 to 88
    V = CkQ[Ai]
    W = 0
    if Kind = 1 then
      if V = 1 then W = 1
      if V = 2 then W = 1
    else
      if V = 3 then W = 1
      if V = 4 then W = 1
    end if
    if W = 1 then
      A = Ai
      PieceMoves
      if Ns > 0 then inc Moves
    end if
  next
  return
end sub

' Crown: men on the far rows become kings
sub Crown:
  for I = 11 to 18
    if CkQ[I] = 1 then
      CkQ[I] = 2
      Cell = I
      CkDrawSquare
      play sound SndCrown
    end if
  next
  for I = 81 to 88
    if CkQ[I] = 3 then
      CkQ[I] = 4
      Cell = I
      CkDrawSquare
      play sound SndCrown
    end if
  next
  return
end sub

' SafeAt: Safe = 1 when a red piece moved from A to M cannot be taken
sub SafeAt:
  Safe = 1
  ' look from M along each direction: a white piece next to it that
  ' could jump over it into an empty square behind (A counts as empty)
  for Dd = 0 to 3
    W = CkDirs[Dd]
    X = M + W
    V = CkQ[X]
    if V >= 3 then
      if V <= 4 then
        ' that white piece would jump the other way
        Y = M - W
        K = CkQ[Y]
        if Y = A then K = 0
        if K = 0 then
          ' a white man only jumps upward: from X to Y, Y must be higher
          if V = 4 then Safe = 0
          if V = 3 then
            if Y > X then Safe = 0
          end if
        end if
      end if
    end if
  next
  return
end sub

' ComputerMove: the book's way (Ok = 0: no move, it concedes)
sub ComputerMove:
  Ok = 1
  Chain = 0
  Ns = 0
  ' captures first, from the top of the board down
  Bi = 88
cm_scan:
  V = CkQ[Bi]
  if V = 1 then goto cm_piece
  if V = 2 then goto cm_piece
  goto cm_next
cm_piece:
  A = Bi
  Pc = CkQ[A]
  Range
  for Dd = D0 to D1
    W = CkDirs[Dd]
    M = A + W
    V = CkQ[M]
    Enemy
    if Ok = 1 then
      L = M + W
      if CkQ[L] = 0 then goto cm_jump
    end if
    Ok = 1
  next
cm_next:
  dec Bi
  if Bi >= 11 then goto cm_scan
  ' crowning: a man on the second row with an empty square ahead
  for Bi = 21 to 28
    if CkQ[Bi] = 1 then
      for Dd = 0 to 1
        W = CkDirs[Dd]
        M = Bi + W
        if CkQ[M] = 0 then
          A = Bi
          goto cm_go
        end if
      next
    end if
  next
  ' safe moves, chosen at random
  Ns = 0
  for Bi = 11 to 88
    V = CkQ[Bi]
    W = 0
    if V = 1 then W = 1
    if V = 2 then W = 1
    if W = 1 then
      A = Bi
      Pc = V
      Range
      for Dd = D0 to D1
        W = CkDirs[Dd]
        M = A + W
        if CkQ[M] = 0 then
          SafeAt
          if Safe = 1 then
            if Ns < 12 then
              Sl[Ns] = A
              Sd[Ns] = M
              inc Ns
            end if
          end if
        end if
      next
    end if
  next
  if Ns > 0 then
    V = Ns - 1
    V = random(0, V)
    A = Sl[V]
    M = Sd[V]
    goto cm_go
  end if
  ' any move at all, tried at random as the book did
  for Tries = 1 to 250
    V = random(11, 88)
    W = CkQ[V]
    K = 0
    if W = 1 then K = 1
    if W = 2 then K = 1
    if K = 1 then
      A = V
      Pc = W
      Range
      for Dd = D0 to D1
        W = CkDirs[Dd]
        M = A + W
        if CkQ[M] = 0 then goto cm_go
      next
    end if
  next
  Ok = 0
  return
cm_go:
  V = A
  W = M
  MovePiece
  return
cm_jump:
  ' jump, and keep jumping while it can
  V = A
  W = L
  MovePiece
  CkQ[M] = 0
  Cell = M
  CkDrawSquare
  inc Co
  play sound SndTake
  CkShowPanel
  if Co = 12 then return
  A = L
  Pc = CkQ[A]
  ' a man crowned by the jump stops there
  if Pc = 1 then
    if A < 19 then return
  end if
  Range
  for Dd = D0 to D1
    W = CkDirs[Dd]
    M = A + W
    V = CkQ[M]
    Enemy
    if Ok = 1 then
      L = M + W
      if CkQ[L] = 0 then goto cm_jump
    end if
    Ok = 1
  next
  return
end sub

' MovePiece: the piece on V slides to W (Q updated, both squares redrawn)
sub MovePiece:
  Fr = V
  Dest = W
  Kind = CkQ[V]
  CkQ[V] = 0
  Cell = V
  CkDrawSquare
  ' a sprite carries it across
  Cell = V
  SquareXY
  Sx = X
  Sy = Y
  Cell = Dest
  SquareXY
  Tx = X
  Ty = Y
  K = 8
  if Kind >= 3 then K = 15
  for J = 1 to 8
    if Sx < Tx then Sx = Sx + 2
    if Sx > Tx then Sx = Sx - 2
    if Sy < Ty then Sy = Sy + 2
    if Sy > Ty then Sy = Sy - 2
    set sprite 1 to Sy, Sx, SPiece, K
    update sprites
    CkFrame1
  next
  set sprite 1 to 192, 0, 0, 0
  update sprites
  CkQ[Dest] = Kind
  Cell = Dest
  CkDrawSquare
  play sound CkSndPlace
  return
end sub

' ---------------------------------------------------------------------------
' Drawing

' SquareXY: X, Y = the sprite position of square Cell
sub SquareXY:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  X = X * 16
  X = X + 8
  V = 9 - Y
  Y = V * 16
  Y = Y + 15
  return
end sub

' DrawSquare: square Cell as it is now
sub CkDrawSquare:
  Y = Cell / 10
  X = Y * 10
  X = Cell - X
  V = CkQ[Cell]
  W = TDarka
  if V = 255 then W = TLighta
  if V = 1 then W = TCmana
  if V = 2 then W = TCkinga
  if V = 3 then W = THmana
  if V = 4 then W = THkinga
  DrawQuad
  return
end sub

' DrawQuad: the 2 x 2 tiles from W for square X (column), Y (row)
sub DrawQuad:
  X = X * 2
  X = X + 1
  V = 9 - Y
  Y = V * 2
  Y = Y + 2
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  inc W
  dec X
  inc Y
  put char W at X,Y
  inc W
  inc X
  put char W at X,Y
  return
end sub

sub ShowDots:
  for I = 1 to Ns
    J = I - 1
    Cell = Sd[J]
    Y = Cell / 10
    X = Y * 10
    X = Cell - X
    W = TDota
    DrawQuad
  next
  return
end sub

sub ClearDots:
  for Ai = 11 to 88
    if CkQ[Ai] = 0 then
      Cell = Ai
      CkDrawSquare
    end if
  next
  return
end sub

sub CkDrawBoard:
  put char CkTFtl at 2,3
  fill CkTFt count 16 at 3,3
  put char CkTFtr at 19,3
  for Y = 4 to 19
    put char CkTFl at 2,Y
    put char CkTFr at 19,Y
  next
  put char CkTFbl at 2,20
  fill CkTFt count 16 at 3,20
  put char CkTFbr at 19,20
  for I = 1 to 8
    for J = 1 to 8
      Cell = I * 10
      Cell = Cell + J
      CkDrawSquare
    next
  next
  return
end sub

sub CkShowPanel:
  print at 21,4, "ME"
  ' the piece pictures
  put char TCmana at 21,5
  put char TCmanb at 22,5
  put char TCmanc at 21,6
  put char TCmand at 22,6
  print at 24,5, "TAKEN"
  NumU = Co
  print at 24,6, digits$(NumU, 2)
  print at 21,10, "YOU"
  put char THmana at 21,11
  put char THmanb at 22,11
  put char THmanc at 21,12
  put char THmand at 22,12
  print at 24,11, "TAKEN"
  NumU = Hu
  print at 24,12, digits$(NumU, 2)
  return
end sub

sub CkDrawCursor:
  Cell = Cur
  SquareXY
  V = Tick & 8
  W = 11
  if V > 0 then W = 10
  if Sel <> 0 then W = 9
  set sprite 0 to Y, X, CkSCursor, W
  update sprites
  return
end sub

' the cursor moves on the playing squares, diagonally neighbouring
sub CkMoveCursor:
  if Stick = 0 then return
  Y = Cur / 10
  X = Y * 10
  X = Cur - X
  if Lf1 = 1 then
    if X > 1 then dec X
  end if
  if Rt1 = 1 then
    if X < 8 then inc X
  end if
  if Up1 = 1 then
    if Y < 8 then inc Y
  end if
  if Dn1 = 1 then
    if Y > 1 then dec Y
  end if
  Cur = Y * 10
  Cur = Cur + X
  play sound CkSndMove
  return
end sub

sub CkMessage:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  return
end sub

sub ConcedeMenu:
  Menu = 0
cc_draw:
  CkMessage
  print at 2,21, "CONCEDE THE GAME?"
  print at 4,22, "NO"
  print at 10,22, "YES"
  V = Menu * 6
  V = V + 3
  print at V,22, ">"
cc_loop:
  CkFrame1
  CkReadPad
  if Stick = 1 then
    if Rt1 = 1 then Menu = 1
    if Lf1 = 1 then Menu = 0
    play sound CkSndMove
    goto cc_draw
  end if
  if Press = 0 then goto cc_loop
  return
end sub

sub CkBoardScreen:
  CkNewScreen
  print at 2,1, "CHECKERS"
  CkDrawBoard
  CkShowPanel
  CkShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' Frame, controls, screens

sub CkRearm:
  nmi off
  nmi on
  return
end sub

sub CkFrame1:
  CkRearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

sub Pause20:
  for J = 1 to 20
    CkFrame1
  next
  return
end sub

sub CkReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 15
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 6
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub CkHideSprites:
  clear sprites
  set sprite count 2
  sprites stable 0 to 1
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub CkNewScreen:
  CkRearm
  wait
  nmi off
  display off
  CkHideSprites
  fill mode 2 text color with $F0
  copy CkTilePat count CkNTiles8 to vram.pattern + 1024
  copy CkTileCol count CkNTiles8 to vram.color + 1024
  copy CkTilePat count CkNTiles8 to vram.pattern + 3072
  copy CkTileCol count CkNTiles8 to vram.color + 3072
  copy CkTilePat count CkNTiles8 to vram.pattern + 5120
  copy CkTileCol count CkNTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub CkShowScreen:
  screen on
  nmi off
  return
end sub

sub CkTitlePage:
  CkNewScreen
  print at 10,2, "CHECKERS"
  ' a corner of the board with a red king and a white king
  for I = 6 to 8
    for J = 3 to 6
      Cell = I * 10
      Cell = Cell + J
      V = I + J
      V = V & 1
      CkQ[Cell] = 255
      if V = 0 then CkQ[Cell] = 0
      CkDrawSquare
    next
  next
  CkQ[64] = 2
  Cell = 64
  CkDrawSquare
  CkQ[75] = 4
  Cell = 75
  CkDrawSquare
  print at 9,14, "PLAY"
  print at 9,15, "HOW TO PLAY"
  print at 9,16, "CREDITS"
  print at 9,17, "OTHER GAME"
  print at 5,21, "FROM TIM HARTNELL'S GIANT"
  print at 5,22, "BOOK OF COMPUTER GAMES"
  CkShowScreen
  Menu = 0
  play sound CkSndTuneA
  play sound CkSndTuneB
  WasBtn = 1
ck_title_loop:
  CkFrame1
  CkReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 3 then inc Menu
    end if
    play sound CkSndMove
  end if
  print at 7,14, " "
  print at 7,15, " "
  print at 7,16, " "
  print at 7,17, " "
  Y = Menu + 14
  print at 7,Y, ">"
  if Press = 0 then goto ck_title_loop
  mute all
  return
end sub

sub CkRulesPage:
  CkNewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "YOU ARE WHITE AND PLAY UP"
  print at 2,4, "THE BOARD. PIECES MOVE ONE"
  print at 2,5, "SQUARE DIAGONALLY FORWARD,"
  print at 2,6, "AND TAKE BY JUMPING OVER A"
  print at 2,7, "PIECE INTO THE EMPTY SQUARE"
  print at 2,8, "BEHIND. JUMPS MAY FOLLOW."
  print at 2,10, "ON THE FAR ROW A PIECE IS"
  print at 2,11, "CROWNED KING: IT MOVES BACK"
  print at 2,12, "AS WELL."
  print at 2,14, "TAKE ALL TWELVE, OR LEAVE"
  print at 2,15, "NO MOVE, TO WIN."
  print at 2,17, "LEFT BUTTON: PICK A PIECE,"
  print at 2,18, "THEN ITS SQUARE. RIGHT:"
  print at 2,19, "END A JUMP, OR CONCEDE."
  print at 8,22, "PRESS A BUTTON"
  CkShowScreen
  CkRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CkEditorialPage:
  CkNewScreen
  print at 10,1, "CHECKERS"
  print at 2,3, "FROM TIM HARTNELL'S GIANT"
  print at 2,4, "BOOK OF COMPUTER GAMES"
  print at 2,5, "(BALLANTINE BOOKS, 1984;"
  print at 2,6, "INTERFACE PUBLICATIONS,"
  print at 2,7, "1983)."
  print at 2,9, "THE COMPUTER PLAYS AS THE"
  print at 2,10, "BOOK'S PROGRAM DOES."
  print at 2,12, "NEW MUSIC: KINGS ROW."
  print at 2,14, "COLECOVISION VERSION BY"
  print at 2,15, "AMY BIENVENU, 2026."
  print at 8,22, "PRESS A BUTTON"
  CkShowScreen
  CkRearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

