  12,10,14,8,12,16,6,10,14,18,4,8,12,16,20
end data
data PosR bytes
  3,7,7,11,11,11,15,15,15,15,19,19,19,19,19
end data
data Nav bytes
  255,255,255,2,1,1,255,255
  0,0,2,4,3,3,255,255
  0,255,255,5,4,4,1,0
  1,1,4,7,6,6,255,255
  1,2,5,8,7,7,3,1
  2,255,255,9,8,8,4,2
  3,3,7,11,10,10,255,255
  3,4,8,12,11,11,6,3
  4,5,9,13,12,12,7,4
  5,255,255,14,13,13,8,5
  6,6,11,11,255,255,255,255
  6,7,12,12,255,10,10,6
  7,8,13,13,255,11,11,7
  8,9,14,14,255,12,12,8
  9,255,255,255,255,13,13,9
end data
const NSpr = 6
const NPos = 15
const NLine = 18
const WinScore = 13
const MsgRow = 22
const PanelC = 24

' the listing's 18 lines of three (DATA ABD, ACF, ...): from, over, to;
' moves 18-35 are the same lines the other way
data LnA bytes
  0,0,1,1,2,2,3,3,3,4,4,5,5,6,7,10,11,12
end data
data LnB bytes
  1,2,3,4,4,5,4,6,7,7,8,8,9,7,8,11,12,13
end data
data LnC bytes
  3,5,6,8,7,9,5,10,12,11,13,12,14,8,9,12,13,14
end data
' joystick bits (1 up, 2 down, 4 left, 8 right) -> Nav direction
data DirOf bytes
  255,0,4,255,6,7,5,255,2,1,3,255,255,255,255,255
end data
' the eight tiles round a place: column and row offsets
data RingX bytes
  0,1,2,0,2,0,1,2
end data
data RingY bytes
  0,0,0,1,1,2,2,2
end data

' the board: Tc(place) 1 a peg, 0 a hole (the listing's TC(T, 1-15))
u8 Tc[15]
' the jumps made, in order: the move (0-35) of each (backup undoes them)
u8 Hm[14]
u8 S = 0
u16 Best = 0
u8 Cur = 4
u8 Sel = 255
u8 Over = 0
u8 Won = 0
u8 Quit = 0
' Ph: 1 waiting for a move, 2 the GAME OVER prompt, 0 busy (for the bot)
u8 Ph = 0
u8 Ask = 0
u8 TitleOn = 0
u8 Menu = 0
u8 RepT = 0
u8 Mf = 0
u8 Mj = 0
u8 Mt = 0
u8 Found = 0
u16 TzLeft = 0
u8 TzOn = 0
u16 NumU = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 P1 = 0
u8 P2 = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Li = 0
u8 Lj = 0
u8 Lw = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table PgSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  ' 380-450: the game is over (or won): back up or end
  EndPrompt
  if Quit = 0 then goto play_loop

  Ph = 0
  HideSprites
  NumU = S
  if NumU > Best then Best = NumU
  fill 32 count 28 at 2,MsgRow
  print at 2,MsgRow, "FINAL SCORE"
  print S at 14,MsgRow width 2
  print at 17,MsgRow, "PRESS BUTTON"
  Ask = 9
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ask = 0
  goto title

' ---------------------------------------------------------------------------
' rules

' the move from place Fp to place Tp: 0-35, or 255 if no line joins them
function MoveOf(u8 Fp, u8 Tp) as u8
  u8 Mi = 0
  u8 Rm = 255
  for Mi = 0 to 17
    if LnA[Mi] = Fp then
      if LnC[Mi] = Tp then Rm = Mi
    end if
    if LnC[Mi] = Fp then
      if LnA[Mi] = Tp then Rm = Mi + NLine
    end if
  next
  return Rm

' a move's three places into Mf, Mj, Mt
sub Unpack(u8 Um):
  if Um >= NLine then
    Um = Um - NLine
    Mf = LnC[Um]
    Mt = LnA[Um]
  else
    Mf = LnA[Um]
    Mt = LnC[Um]
  end if
  Mj = LnB[Um]
  return
end sub

' 1 if move Lm can be made now (a peg, a peg to jump, a hole)
function CanMove(u8 Lm) as u8
  Unpack(Lm)
  if Tc[Mf] = 0 then return 0
  if Tc[Mj] = 0 then return 0
  if Tc[Mt] = 1 then return 0
  return 1

' 260-290: is any jump left?
function AnyMove as u8
  u8 Am = 0
  u8 Ok = 0
  for Am = 0 to 35
    Ok = CanMove(Am)
    if Ok = 1 then return 1
  next
  return 0

sub NewGame:
  ' 130: every hole filled but A
  for Li = 0 to 14
    Tc[Li] = 1
  next
  Tc[0] = 0
  S = 0
  Cur = 4
  Sel = 255
  Over = 0
  Won = 0
  Quit = 0
  DrawPlay
  return
end sub

sub PlayStep:
  Ph = 1
  ' the stick: a new direction moves at once, a held one repeats
  K = 0
  if Edge > 0 then
    K = Jk
    RepT = 14
  else
    if Jk > 0 then
      dec RepT
      if RepT = 0 then
        K = Jk
        RepT = 8
      end if
    end if
  end if
  if K > 0 then MoveCursor(K)
  if P1 = 1 then
    LeftButton
  else
    if P2 = 1 then Backup
  end if
  return
end sub

sub MoveCursor(u8 Mk):
  u8 Dn = 0
  u8 Np = 0
  Dn = DirOf[Mk]
  if Dn = 255 then return
  K = Cur << 3
  K = K + Dn
  Np = Nav[K]
  if Np = 255 then return
  Cur = Np
  play sound SndMove
  DrawCursor
  return
end sub

sub LeftButton:
  u8 Lm = 0
  if Sel = 255 then
    if Tc[Cur] = 1 then
      Sel = Cur
      play sound SndPick
      DrawPlace(Sel)
      DrawCursor
    else
      Illegal
    end if
    return
  end if
  if Cur = Sel then
    Sel = 255
    play sound SndDrop
    DrawPlace(Cur)
    DrawCursor
    return
  end if
  if Tc[Cur] = 1 then
    ' another peg: it becomes the picked one
    T = Sel
    Sel = Cur
    DrawPlace(T)
    DrawPlace(Sel)
    play sound SndPick
    DrawCursor
    return
  end if
  ' 170-200: is it a move, and can it be made?
  Lm = MoveOf(Sel, Cur)
  if Lm = 255 then
    Illegal
    return
  end if
  V = CanMove(Lm)
  if V = 0 then
    Illegal
    return
  end if
  DoMove(Lm)
  return
end sub

' 210-300: the jump
sub DoMove(u8 Dm):
  Ph = 0
  Unpack(Dm)
  Hm[S] = Dm
  Sel = 255
  Tc[Mf] = 0
  DrawPlace(Mf)
  Hop
  Tc[Mj] = 0
  Tc[Mt] = 1
  DrawPlace(Mt)
  inc S
  ShowScore
  Cur = Mt
  DrawCursor
  CheckEnd
  return
end sub

' 250-290: thirteen wins; no jump left ends the game
sub CheckEnd:
  u8 Am = 0
  Over = 0
  Won = 0
  if S = WinScore then
    Over = 1
    Won = 1
    return
  end if
  Am = AnyMove
  if Am = 0 then Over = 1
  return
end sub

' 340-370: take back the last jump
sub Backup:
  u8 Bm = 0
  if S = 0 then
    play sound SndBad
    return
  end if
  Ph = 0
  dec S
  Bm = Hm[S]
  Unpack(Bm)
  Tc[Mf] = 1
  Tc[Mj] = 1
  Tc[Mt] = 0
  if Sel <> 255 then
    T = Sel
    Sel = 255
    DrawPlace(T)
  end if
  DrawPlace(Mf)
  DrawPlace(Mj)
  DrawPlace(Mt)
  play sound SndBack
  ShowScore
  Cur = Mf
  DrawCursor
  Over = 0
  Won = 0
  return
end sub

' 310-330
sub Illegal:
  Ph = 0
  play sound SndBad
  fill 32 count 28 at 2,MsgRow
  print at 10,MsgRow, "ILLEGAL MOVE"
  Pause(50)
  ShowPrompt
  return
end sub

' 380-450: the end of a game: the message, then back up (right) or end
sub EndPrompt:
  Ph = 0
  fill 32 count 28 at 2,MsgRow
  if Won = 1 then
    print at 3,MsgRow, "CONGRATULATIONS, YOU WON"
    play sound SndWin
    for Lj = 0 to 7
      select case Lj
      case 0
        backdrop dark yellow
      case 1
        backdrop magenta
      case 2
        backdrop light blue
      case 3
        backdrop dark red
      case 4
        backdrop cyan
      case 5
        backdrop dark green
      case 6
        backdrop gray
      case else
        backdrop dark blue
      end select
      Pause(20)
    next
  else
    print at 2,MsgRow, "GAME OVER - YOUR SCORE IS"
    print S at 28,MsgRow width 2
    play sound SndOver
    Pause(30)
  end if
  ' the panel: what the buttons do now
  PanelClear
  print at PanelC,10, "LEFT:"
  print at PanelC,11, "END"
  print at PanelC,13, "RIGHT:"
  print at PanelC,14, "BACK"
  print at PanelC,15, "UP"
  Ph = 2
ep_loop:
  Frame1
  ReadPad
  if P1 = 1 then
    Quit = 1
    Ph = 0
    return
  end if
  if P2 = 0 then goto ep_loop
  Backup
  PanelHelp
  ShowPrompt
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' one place: a peg (gold, or white when picked) or a hole, with its letter
sub DrawPlace(u8 Dp):
  u8 Pc = 0
  u8 Pr = 0
  u8 Rb = 0
  u8 Cb = 0
  u8 Ri = 0
  Pc = PosC[Dp]
  Pr = PosR[Dp]
  if Tc[Dp] = 0 then
    Rb = TRh0
    Cb = TChA
  else
    if Dp = Sel then
      Rb = TRw0
      Cb = TCwA
    else
      Rb = TRp0
      Cb = TCpA
    end if
  end if
  for Ri = 0 to 7
    X = Pc + RingX[Ri]
    Y = Pr + RingY[Ri]
    put char Rb + Ri at X,Y
  next
  X = Pc + 1
  Y = Pr + 1
  put char Cb + Dp at X,Y
  return
end sub

' the cursor: four corner sprites round the place's 24 x 24 block
sub DrawCursor:
  u8 Cx = 0
  u8 Cy = 0
  u8 Cc = 0
  u8 Ex = 0
  u8 Ey = 0
  Cx = PosC[Cur] << 3
  Cy = PosR[Cur] << 3
  Cx = Cx - 4
  Cy = Cy - 5
  Ex = Cx + 16
  Ey = Cy + 16
  Cc = 7
  if Sel <> 255 then Cc = 9
  set sprite 0 to Cy,Cx,SCtl,Cc
  set sprite 1 to Cy,Ex,SCtr,Cc
  set sprite 2 to Ey,Cx,SCbl,Cc
  set sprite 3 to Ey,Ex,SCbr,Cc
  update sprites
  return
end sub

sub HideCursor:
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

' the peg hops from Mf over Mj to Mt in an arc; Mj pops half way
sub Hop:
  i16 Hx0 = 0
  i16 Hy0 = 0
  i16 Hdx = 0
  i16 Hdy = 0
  i16 Hx = 0
  i16 Hy = 0
  i16 Arc = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Lp = 0
  HideCursor
  Hx0 = PosC[Mf] << 3
  Hx0 = Hx0 + 4
  Hy0 = PosR[Mf] << 3
  Hy0 = Hy0 + 3
  Hdx = PosC[Mt] << 3
  Hdx = Hdx + 4
  Hdx = Hdx - Hx0
  Hdy = PosR[Mt] << 3
  Hdy = Hdy + 3
  Hdy = Hdy - Hy0
  Lp = Mf << 2
  Lp = Lp + SLA
  play sound SndHop
  for Lw = 0 to 20
    Hx = Hdx * Lw
    Hx = Hx / 20
    Hx = Hx + Hx0
    Arc = 20 - Lw
    Arc = Arc * Lw
    Arc = Arc / 6
    Hy = Hdy * Lw
    Hy = Hy / 20
    Hy = Hy + Hy0
    Hy = Hy - Arc
    Sx = Hx
    Sy = Hy
    set sprite 4 to Sy,Sx,Lp,1
    set sprite 5 to Sy,Sx,SBall,11
    update sprites
    if Lw = 10 then
      Tc[Mj] = 0
      DrawPlace(Mj)
      play sound SndPop
    end if
    Frame1
  next
  set sprite 4 to 192,0,0,0
  set sprite 5 to 192,0,0,0
  update sprites
  return
end sub

sub ShowScore:
  print S at 9,1 width 2
  V = 14 - S
  print V at PanelC,5 width 2
  return
end sub

sub ShowPrompt:
  fill 32 count 28 at 2,MsgRow
  print at 11,MsgRow, "YOUR MOVE"
  return
end sub

sub PanelClear:
  for Lw = 9 to 16
    fill 32 count 6 at PanelC,Lw
  next
  return
end sub

sub PanelHelp:
  PanelClear
  print at PanelC,10, "LEFT:"
  print at PanelC,11, "PICK"
  print at PanelC,12, "JUMP"
  print at PanelC,14, "RIGHT:"
  print at PanelC,15, "BACKUP"
  return
end sub

sub DrawPlay:
  u8 Br = 0
  u16 Bo = 0
  u16 Vo = 0
  NewScreen
  ' the felt triangle, rows 2-21 from the map (28 columns a row)
  for Br = 0 to 19
    Bo = Br * 28
    Vo = Br + 2
    Vo = Vo * 32
    Vo = Vo + 2
    copy BoardMap + Bo count 28 to vram.name + Vo
  next
  for Li = 0 to 14
    DrawPlace(Li)
  next
  ' 90-100: the title bar and the score
  print at 2,1, "SCORE:"
  print at 14,1, "PEGS"
  print at PanelC,3, "PEGS"
  print at PanelC,4, "LEFT"
  ShowScore
  PanelHelp
  ShowPrompt
  ShowScreen
  DrawCursor
  return
end sub

' ---------------------------------------------------------------------------

sub Pause(u8 Pf):
  for Lw = 1 to Pf
    Frame1
  next
  return
end sub

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  B1 = V & 16
  B2 = V & 32
  P1 = 0
  P2 = 0
  if B1 > 0 then
    if WasB1 = 0 then P1 = 1
  end if
  if B2 > 0 then
    if WasB2 = 0 then P2 = 1
  end if
  WasB1 = B1
  WasB2 = B2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: PEGS in little gold pegs, the tune once
sub TitlePage:
  u16 Tq = 0
  u16 Tv = 0
  u8 Tr = 0
  Ask = 0
  TitleOn = 1
  Menu = 0
  NewScreen
  for Tr = 0 to 6
    Tq = Tr * TitleW
    Tv = Tr + 3
    Tv = Tv * 32
    Tv = Tv + TitleX
    copy TitleMap + Tq count TitleW to vram.name + Tv
  next
  fill TRule count 24 at 4,11
  print at 4,13, "JUMP A PEG OVER A PEG"
  print at 4,14, "INTO A HOLE. LEAVE ONE"
  print at 4,15, "PEG TO SCORE 13."
  print at 12,17, "START"
  print at 12,18, "HOW TO PLAY"
  print at 12,19, "CREDITS"
  print at 4,20, "BEST SCORE"
  NumU = Best
  print at 15,20, digits$(NumU, 2)
  print at 4,22, "COMPUTE!'S GAZETTE 1986"
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 384
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  K = Edge & 3
  if K = 1 then
    if Menu > 0 then
      dec Menu
      play sound SndMove
      ShowMenu
    end if
  end if
  if K = 2 then
    if Menu < 2 then
      inc Menu
      play sound SndMove
      ShowMenu
    end if
  end if
  V = P1 | P2
  if V = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  return
end sub

sub ShowMenu:
  put char 32 at 10,17
  put char 32 at 10,18
  put char 32 at 10,19
  C = Menu + 17
  put char 62 at 10,C
  return
end sub

' a place drawn for the HOW TO PLAY pages: Hk 0 hole, 1 peg, 2 picked
sub HtPlace(u8 Hk, u8 Hl, u8 Hc, u8 Hr):
  u8 Hb = 0
  u8 Hq = 0
  u8 Hi = 0
  Hb = TRh0
  Hq = TChA
  if Hk = 1 then
    Hb = TRp0
    Hq = TCpA
  end if
  if Hk = 2 then
    Hb = TRw0
    Hq = TCwA
  end if
  for Hi = 0 to 7
    X = Hc + RingX[Hi]
    Y = Hr + RingY[Hi]
    put char Hb + Hi at X,Y
  next
  X = Hc + 1
  Y = Hr + 1
  put char Hq + Hl at X,Y
  return
end sub

' HOW TO PLAY: two pages; the button turns the page, after the last
' page (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "THE BOARD IS A TRIANGLE OF"
    print at 2,4, "15 HOLES. ALL BUT THE TOP"
    print at 2,5, "ONE HAVE A PEG IN THEM."
    print at 2,7, "JUMP A PEG OVER ITS"
    print at 2,8, "NEIGHBOUR INTO AN EMPTY"
    print at 2,9, "HOLE, IN A STRAIGHT LINE."
    print at 2,10, "THE PEG YOU JUMP COMES OFF."
    print at 2,12, "LEAVE JUST ONE PEG TO WIN!"
    HtPlace(2, 3, 3, 15)
    HtPlace(1, 1, 6, 15)
    HtPlace(0, 0, 9, 15)
    print at 13,16, ">"
    HtPlace(0, 3, 15, 15)
    HtPlace(0, 1, 18, 15)
    HtPlace(1, 0, 21, 15)
  else
    print at 2,1, "CONTROLS               2/2"
    print at 2,3, "STICK: MOVE THE CURSOR."
    print at 2,4, "LEFT BUTTON: PICK A PEG,"
    print at 2,5, "THEN PICK THE EMPTY HOLE"
    print at 2,6, "TO JUMP INTO."
    print at 2,7, "RIGHT BUTTON: TAKE BACK A"
    print at 2,8, "JUMP (AS MANY AS YOU LIKE)."
    print at 2,10, "EVERY JUMP SCORES 1 POINT."
    print at 2,11, "WHEN NO JUMP IS LEFT THE"
    print at 2,12, "GAME IS OVER. ONE PEG LEFT"
    print at 2,13, "MEANS 13 POINTS: YOU WIN."
    print at 2,15, "TIP: KEEP THE PEGS TOGETHER"
    print at 2,16, "IN THE MIDDLE. A PEG ALONE"
    print at 2,17, "IN A CORNER IS HARD TO"
    print at 2,18, "TAKE OFF."
    HtPlace(1, 4, 13, 19)
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasB1 = 16
  WasB2 = 32
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  V = P1 | P2
  if V = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  return
end sub

sub CreditsPage:
  NewScreen
  print at 13,2, "PEGS"
  print at 2,5, "BASED ON PEGS, COMPUTE!'S"
  print at 2,6, "GAZETTE, DECEMBER 1986"
  print at 2,7, "(COMMODORE 64 AND VIC-20)."
  print at 2,8, "NO AUTHOR IS NAMED IN THE"
  print at 2,9, "LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: JUMP THE ROW"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Ask = 1
  Rearm
  pause until press
  wait no fire
  nmi off
  Ask = 0
  return
end sub

asm {
PgMove:
    db $40,$47,$40,$01,$50
PgPick:
    db $40,$7F,$20,$02,$40,$55,$30,$02,$50
PgDrop:
    db $40,$55,$30,$02,$40,$7F,$30,$02,$50
PgHop:
    db $40,$43,$10,$02,$40,$43,$30,$02,$40,$43,$60,$03,$40,$43,$80,$03,$50
PgPop:
