' Fixed32 random lab: fractional 0.0 .. <1.0 samples.
fixed32 HalfValue = 0.5
fixed32 SampleA = 0.0
fixed32 SampleB = 0.0
fixed32 SampleC = 0.0
fixed32 SampleD = 0.0

' Amy Fixed32 Random Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 5,0, "FIXED32 RANDOM LAB"
  print at 1,2, "EXPECT 0.0000..0.9999"
  print at 1,4,  "HALF"
  print HalfValue at 12,4 digits 11

  SampleA = random()
  SampleB = random()
  SampleC = random()
  SampleD = random()

  print at 1,7,  "RND A"
  print SampleA at 12,7 digits 11
  print at 1,9,  "RND B"
  print SampleB at 12,9 digits 11
  print at 1,11, "RND C"
  print SampleC at 12,11 digits 11
  print at 1,13, "RND D"
  print SampleD at 12,13 digits 11

  return