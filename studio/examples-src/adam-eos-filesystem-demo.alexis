' Native EOS filesystem example.
' Build as ADAM Native EOS on writable DSK or DDP media.
u8 CreateStatus = 255
u8 WriteStatus = 255
u8 ReadStatus = 255
u8 DeleteStatus = 255
u8 SaveData[16]
u8 VerifyData[16]

text screen
print at 5,3, "AMY NATIVE EOS FILES"
print at 3,5, "CREATE WRITE READ DELETE"
screen on no nmi

SaveData[0] = $43
SaveData[1] = $52
SaveData[2] = $45
SaveData[3] = $41
SaveData[4] = $54
SaveData[5] = $45
SaveData[6] = $44
SaveData[7] = $20
SaveData[8] = $42
SaveData[9] = $59
SaveData[10] = $20
SaveData[11] = $41
SaveData[12] = $4D
SaveData[13] = $59
SaveData[14] = $21
SaveData[15] = $20

create "AMYDEMO" 1024 status CreateStatus
write "AMYDEMO" from SaveData count 16 status WriteStatus
VerifyData = read "AMYDEMO" count 16 status ReadStatus

print at 3,8, "CREATE STATUS"
print CreateStatus at 20,8 width 1
print at 3,10, "WRITE STATUS"
print WriteStatus at 20,10 width 1
print at 3,12, "READ STATUS"
print ReadStatus at 20,12 width 1
print at 3,15, "FIRE DELETES AMYDEMO"

wait fire
delete "AMYDEMO" status DeleteStatus
print at 3,17, "DELETE STATUS"
print DeleteStatus at 20,17 width 1

loop forever
