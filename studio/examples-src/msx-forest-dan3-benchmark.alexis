cartridge "MSX FOREST DAN3/AMY STUDIO/2026"

' MSX forest by Vanja Utne aka Mermaid, February 2016.
' Measures PATTERN+COLOR upload time with an NMI-driven frame counter.
picture MsxForestDan3Picture:
  pattern from "@project/msx-forest.pattern.dan3" codec dan3
  color from "@project/msx-forest.color.dan3" codec dan3
end picture

u16 ForestTicks = 0
u8 ForestCounting = 0

on vblank ForestTick

  bitmap screen
  screen on
  nmi on
  wait
  ForestTicks = 0
  ForestCounting = 1
  upload picture MsxForestDan3Picture
  ForestCounting = 0
  wait 120 frames
  text screen
  print centered at 3, "MSX FOREST"
  print centered at 5, "DAN3 DECOMPRESS"
  print at 1,8, "PATTERN+COLOR:"
  print ForestTicks at 16,8 digits 5
  print at 22,8, "FRAMES"
  print centered at 12, "ART: MERMAID, 2016"
  screen on
done:
  goto done

sub ForestTick:
  if ForestCounting = 0 then return
  ForestTicks += 1
  return