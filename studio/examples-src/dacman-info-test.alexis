project "Dacman Diagnostic"
cartridge "DACMAN DIAG/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

picture DacmanInfoPicture:
  pattern from "@project/dacman-info.pattern.zx0" codec zx0
  color from "@project/dacman-info.color.zx0" codec zx0
end picture

sub start:
  show picture DacmanInfoPicture
  loop forever
end sub
