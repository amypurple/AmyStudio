const TV11 = 140
const TV12 = 141
const TV13 = 142
const TV14 = 143
const TV15 = 144
const TV16 = 145
const TV17 = 146
const TV18 = 147
const TV19 = 148
const TV20 = 149
const TV21 = 150
const TV22 = 151
const TV23 = 152
const TV24 = 153
const TV25 = 154
const TV26 = 155
const TV27 = 156
const TV28 = 157
const TV29 = 158
const TV30 = 159
const TV31 = 160
const TV32 = 161
const TV33 = 162
const TV34 = 163
const TV35 = 164
const TV36 = 165
const TV37 = 166
const TV38 = 167
const TV39 = 168
const TV40 = 169
const TV41 = 170
const TV42 = 171
const TV43 = 172
const TV44 = 173
const TV45 = 174
const TV46 = 175
const TV47 = 176
const TV48 = 177
const TV49 = 178
const TV50 = 179
const TV51 = 180
const TV52 = 181
const TV53 = 182
const TV54 = 183
const TV55 = 184
const TV56 = 185
const TV57 = 186
const TV58 = 187
const TV59 = 188
const TV60 = 189
const TV61 = 190
const TV62 = 191
const TV63 = 192
const TV64 = 193
const TV65 = 194
const TV66 = 195
const TV67 = 196
const TV68 = 197
const TV69 = 198
const TV70 = 199
const TV71 = 200
const TV72 = 201
const TV73 = 202
const TV74 = 203
const TV75 = 204
const TV76 = 205
const TV77 = 206
const TV78 = 207
const TV79 = 208
const TV80 = 209
const TV81 = 210
const TV82 = 211
const TV83 = 212
const TV84 = 213
const TFrame = 214
const TCunk = 215
const TCvis = 216
const TCmark = 217
const TCtrap = 218
const TIbread = 219
const TIwater = 220
const TIgold = 221
const TIsword = 222
const SHeadl = 0
const SHeadr = 4
const SJawl = 8
const SJawr = 12
const SEyes = 16
const STeeth = 20
const SSword = 24
const SPot = 28
const SCoins = 32
const SDrop = 36
const SArrow0 = 40
const SArrow1 = 44
const SArrow2 = 48
const SArrow3 = 52
const NTiles8 = 760
const SprBytes = 448
const SndTuneA = 1
const SndTuneB = 2
const SndStep = 3
const SndBump = 4
const SndCreak = 5
const SndScales = 6
const SndRoar = 7
const SndFound = 8
const SndWater = 9
const SndSlay = 10
const SndNothing = 11
const SndMark = 12
const SndMenu = 13
const SndWin = 14
const SndOver = 15
const NSpr = 5
const RunN = 90
const ItemN = 90
const RiseN = 40
const NCell = 90
const MinTraps = 34
const ExitAt = 20
const ThirstMax = 100

' chamber kinds 1-7: 1 left, 2 ahead, 4 right, 8 trap door
data KindBits bytes
  0, 7, 6, 4, 3, 10, 13, 9
end data
' a step for each facing (0 north, 1 east, 2 south, 3 west), +1 offset
data StepI bytes
  0, 1, 2, 1
end data
data StepJ bytes
  1, 2, 1, 0
end data
data FaceTxt chars
  "NORTH"
  "EAST "
  "SOUTH"
  "WEST "
end data

data MsgTxt chars
  "                            "
  "                            "
  "THE SMOKE SMELL IS STRONG   "
  "                            "
  "SOOT IS ON THE WALLS        "
  "                            "
  "YOU HEAR DRIPPING WATER!    "
  "                            "
  "BLOOD IS ON THE FLOOR       "
  "                            "
  "YOU HEAR BATS IN FLIGHT     "
  "                            "
  "NOTHING THERE               "
  "                            "
  "YOU HEAR SCALES RATTLING!   "
  "RUN!                        "
  "YOU FOUND A DRAGON AND      "
  "USED THE SWORD!             "
  "FOUND WATER,                "
  "YOU'VE MORE TIME            "
  "YOU'VE FOUND GOLD!          "
  "                            "
  "YOU'VE FOUND A ONE SHOT     "
  "MAGIC SWORD!                "
  "DEAD END - GO BACK!         "
  "                            "
  "YOU FOUND AN EXIT!          "
  "                            "
  "A BREAD MARK IS HERE        "
  "                            "
  "BREAD SLICE USED            "
  "                            "
  "THIS SPOT IS MARKED ALREADY "
  "                            "
  "THIS TRAP DOOR IS OPEN      "
  "                            "
  "EATEN BY THE DRAGON!        "
  "                            "
  "YOU STARVED TO DEATH!       "
  "                            "
  "YOU DIED OF THIRST!         "
  "                            "
  "YOU ESCAPED THE DEN         "
  "WITH    GOLD POTS!          "
  "SEARCH THE TRAP DOORS FOR   "
  "A WAY OUT. MIND THE DRAGON! "
  "NO TRAP DOOR HERE           "
  "                            "
  "THE DRAGON CLIMBS OUT...    "
  "                            "
end data

record Hero:
  u8 I
  u8 J
  u8 F
end record

Hero Pl
u8 Room[90]
u8 Clue[90]
u8 Flg[90]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Off = 0
u16 Vo = 0
u8 Bread = 20
u8 Thirst = 0
bcd digits 2 Gold
u8 GoldN = 0
u8 Sword = 0
u8 Fe = 0
u8 Op = 0
u8 Mode = 0
u8 Here = 0
u8 Searched = 0
u8 RunT = 0
u8 ItemT = 0
u8 Over = 0
u8 Ws = 0
u8 Sel = 0
u8 Msg = 0
u8 Outc = 0
u8 Traps = 0
u8 TitleOn = 0
u8 Blink = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 SPress = 0
u8 B1 = 0
u8 B2 = 0
u8 WasB1 = 0
u8 WasB2 = 0
u8 P1 = 0
u8 P2 = 0
u8 Press = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Rw = 0
u8 Ci = 0
u8 Cj = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table DdSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then
    HowToPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  ' the end: the message under the den, then back to the title on a press
  Ws = 0
  mute all
  fill 32 count 28 at 2,19
  fill 32 count 28 at 2,22
  select case Over
  case 1
    Say(18)
    play sound SndOver
  case 2
    Say(19)
    play sound SndOver
  case 3
    Say(20)
    play sound SndOver
  case else
    Say(21)
    print Gold at 7,21
    play sound SndWin
  end select
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  if ItemT > 0 then
    dec ItemT
    if ItemT = 0 then
      set sprite 0 to 192,0,0,0
      update sprites
    end if
  end if
  select case Mode
  case 1
    RunStep
  case 3
    ExitStep
  case 4
    MenuStep
  case 5
    RiseStep
  case else
    WalkStep
  end select
  return
end sub

' walking: the stick moves, the left button searches, the right the menu
sub WalkStep:
  Ws = 1
  if SPress > 0 then
    TryMove(StickDir(SPress))
    return
  end if
  if P1 = 1 then
    Search
    return
  end if
  if P2 = 1 then
    if Mode = 0 then
      Mode = 4
      Sel = 0
      Ws = 0
      DrawMenu
      play sound SndMenu
    end if
  end if
  return
end sub

' the stick bits (1 up, 2 down, 4 left, 8 right) as a move relative to the
' way you face: 0 ahead, 1 right, 2 back, 3 left; 9 for none
function StickDir(u8 S) as u8
  u8 D = 9
  if S & 1 then D = 0
  if S & 8 then D = 1
  if S & 2 then D = 2
  if S & 4 then D = 3
  return D

' 1 when move D is open from here
function CanGo(u8 D) as u8
  if D = 2 then return 1
  if D = 9 then return 0
  if Mode = 2 then return 0
  if D = 0 then return (Op >> 1) & 1
  if D = 1 then return (Op >> 2) & 1
  return Op & 1

sub TryMove(u8 D):
  if CanGo(D) = 0 then
    play sound SndBump
    return
  end if
  ' leaving a chamber marks it visited
  if Mode <> 2 then
    Flg[Here] = Flg[Here] | 1
  end if
  Pl.F = (Pl.F + D) & 3
  Pl.I = Pl.I + StepI[Pl.F] - 1
  Pl.J = Pl.J + StepJ[Pl.F] - 1
  inc Thirst
  play sound SndStep
  HideSprites
  EnterRoom
  CheckBody
  return
end sub

' after a step or a search: thirst and hunger
sub CheckBody:
  if Thirst > ThirstMax then Over = 3
  if Bread = 0 then Over = 2
  return
end sub

sub EnterRoom:
  Searched = 0
  Msg = 0
  if Pl.I > 8 then
    Mode = 2
  elseif Pl.J > 9 then
    Mode = 2
  else
    Mode = 0
  end if
  if Mode = 2 then
    Op = 0
    Msg = 12
  else
    Here = Pl.I * 10 + Pl.J
    Op = KindBits[Room[Here]]
    C = Clue[Here]
    if C < 6 then Msg = C
    if Flg[Here] & 2 then Msg = 14
  end if
  DrawView
  ShowHud
  Say(Msg)
  return
end sub

' the trap door: once, then it stays open
sub Search:
  u8 R = 0
  if Op < 8 then
    Say(23)
    play sound SndBump
    return
  end if
  if Flg[Here] & 4 then
    Say(17)
    play sound SndBump
    return
  end if
  Flg[Here] = Flg[Here] | 4
  inc Thirst
  inc Fe
  DrawTrap
  play sound SndCreak
  R = RndN(9) + 1
  if Clue[Here] = 3 then R = 7
  if Clue[Here] = 4 then R = 2
  Outc = R
  select case R
  case 1, 4
    if Fe >= ExitAt then
      FoundExit
    else
      Say(6)
    end if
  case 5
    if Fe >= ExitAt then
      FoundExit
    else
      Scales
    end if
  case 7
    Thirst = 0
    Say(9)
    ShowItem(SDrop, 5)
    play sound SndWater
  case 9
    if Sword = 1 then
      Gold += 1
      inc GoldN
      Say(10)
      ShowItem(SPot, 10)
    else
      Sword = 1
      Say(11)
      ShowItem(SSword, 15)
    end if
    play sound SndFound
  case else
    Scales
  end select
  ShowHud
  CheckBody
  return
end sub

sub ShowItem(u8 P, u8 Col):
  set sprite 0 to 95,120,P,Col
  update sprites
  ItemT = ItemN
  return
end sub

sub Scales:
  Mode = 1
  RunT = RunN
  Say(7)
  set sprite 1 to 107,120,SEyes,8
  update sprites
  play sound SndScales
  return
end sub

' the run: any open way (or back) in time, else the dragon climbs out
sub RunStep:
  Ws = 2
  if SPress > 0 then
    K = StickDir(SPress)
    if CanGo(K) = 1 then
      Mode = 0
      TryMove(K)
      return
    end if
  end if
  dec RunT
  if RunT = 0 then
    Mode = 5
    RunT = RiseN
    Ws = 0
    Say(24)
    play sound SndRoar
  end if
  return
end sub

' the dragon rises from the trap door; the sword or the end
sub RiseStep:
  Ws = 0
  Y = 86 + RunT
  set sprite 1 to Y,120,SEyes,8
  if RunT < 20 then
    set sprite 2 to Y,120,STeeth,15
    set sprite 3 to Y,104,SJawl,12
    set sprite 4 to Y,120,SJawr,12
  else
    set sprite 3 to Y,104,SHeadl,12
    set sprite 4 to Y,120,SHeadr,12
  end if
  update sprites
  dec RunT
  if RunT > 0 then return
  if Sword = 1 then
    Sword = 0
    Mode = 0
    HideSprites
    ShowItem(SSword, 15)
    Say(8)
    ShowHud
    play sound SndSlay
  else
    Over = 1
  end if
  return
end sub

sub FoundExit:
  Mode = 3
  Sel = 0
  Say(13)
  DrawExitMenu
  play sound SndFound
  return
end sub

' ESCAPE or HUNT ON: left and right choose, a button confirms
sub ExitStep:
  Ws = 3
  if SPress & 4 then Sel = 0
  if SPress & 8 then Sel = 1
  if SPress > 0 then
    DrawExitMenu
    play sound SndMenu
  end if
  if Press = 0 then return
  if Sel = 0 then
    Over = 4
  else
    Fe = 5
    Mode = 0
    Say(0)
    ShowHud
  end if
  return
end sub

sub DrawExitMenu:
  print at 2,21, "  ESCAPE      HUNT ON       "
  K = Sel * 12 + 3
  put char 62 at K,21
  return
end sub

' the menu: CHART, MARK, CANCEL
sub MenuStep:
  Ws = 4
  if SPress & 4 then
    if Sel > 0 then dec Sel
  end if
  if SPress & 8 then
    if Sel < 2 then inc Sel
  end if
  if SPress > 0 then
    DrawMenu
    play sound SndMenu
  end if
  if Press = 0 then return
  Mode = 0
  select case Sel
  case 0
    ChartPage
  case 1
    MarkHere
  case else
    Say(Msg)
  end select
  ShowHud
  return
end sub

sub DrawMenu:
  fill 32 count 28 at 2,20
  print at 2,21, "  CHART    MARK    CANCEL   "
  K = Sel * 9 + 3
  put char 62 at K,21
  return
end sub

sub MarkHere:
  if Flg[Here] & 2 then
    Say(16)
    return
  end if
  Flg[Here] = Flg[Here] | 2
  dec Bread
  Msg = 14
  Say(15)
  play sound SndMark
  CheckBody
  return
end sub

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RndN(u8 N) as u8
  u16 Q = 0
  Rand
  Q = Rs % N
  return Q

' a new den: kinds and clues at random, at least MinTraps trap doors
sub MakeDen:
  u8 K2 = 0
  Traps = 0
  while Traps < MinTraps
    Traps = 0
    for K2 = 0 to 89
      Room[K2] = RndN(7) + 1
      Clue[K2] = RndN(8) + 1
      Flg[K2] = 0
      if Room[K2] >= 5 then inc Traps
    next
  end while
  return
end sub

sub NewGame:
  MakeDen
  Pl.I = RndN(8)
  Pl.J = RndN(9)
  Pl.F = 0
  Bread = 20
  Thirst = 0
  Gold = 0
  GoldN = 0
  Sword = 0
  Fe = 0
  Over = 0
  ItemT = 0
  TitleOn = 0
  NewScreen
  DrawFrame
  EnterRoom
  Say(22)
  ShowScreen
  play sound SndStep
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub Say(u8 M):
  Off = M
  Off = Off * 56
  put MsgTxt + Off count 28 at 2,20
  Off = Off + 28
  put MsgTxt + Off count 28 at 2,21
  return
end sub

' the view: three column bands, then the trap door
sub DrawView:
  for Rw = 0 to 15
    Vo = Rw + 2
    Vo = Vo * 32
    Off = Rw * 6
    if Op & 1 then
      copy MapL1 + Off count 6 to vram.name + Vo + 6
    else
      copy MapL0 + Off count 6 to vram.name + Vo + 6
    end if
    if Op & 4 then
      copy MapR1 + Off count 6 to vram.name + Vo + 20
    else
      copy MapR0 + Off count 6 to vram.name + Vo + 20
    end if
    Off = Rw * 8
    if Op & 2 then
      copy MapC1 + Off count 8 to vram.name + Vo + 12
    else
      copy MapC0 + Off count 8 to vram.name + Vo + 12
    end if
  next
  if Op & 8 then DrawTrap
  return
end sub

sub DrawTrap:
  for Rw = 0 to 2
    Vo = Rw + 14
    Vo = Vo * 32
    Off = Rw * 6
    if Flg[Here] & 4 then
      copy MapT1 + Off count 6 to vram.name + Vo + 13
    else
      copy MapT0 + Off count 6 to vram.name + Vo + 13
    end if
  next
  return
end sub

sub DrawFrame:
  for Rw = 2 to 17
    fill TFrame count 4 at 2,Rw
    fill TFrame count 4 at 26,Rw
  next
  print at 2,1, "DRAGON'S DEN"
  return
end sub

sub ShowHud:
  print at 18,1, "FACING"
  Off = Pl.F * 5
  put FaceTxt + Off count 5 at 25,1
  put char TIbread at 2,18
  NumU = Bread
  print at 3,18, digits$(NumU, 2)
  put char TIwater at 7,18
  if Thirst > ThirstMax then
    NumU = 0
  else
    NumU = ThirstMax - Thirst
  end if
  print at 8,18, digits$(NumU, 3)
  put char TIgold at 13,18
  print Gold at 14,18
  if Sword = 1 then
    put char TIsword at 18,18
  else
    put char 32 at 18,18
  end if
  print at 21,18, "TRAPS"
  NumU = Fe
  print at 27,18, digits$(NumU, 2)
  ' the ways out of this chamber
  fill 32 count 28 at 2,22
  if Mode <> 2 then
    if Op & 1 then print at 2,22, "LEFT"
    if Op & 2 then print at 7,22, "AHEAD"
    if Op & 4 then print at 13,22, "RIGHT"
  end if
  print at 19,22, "BACK"
  if Op >= 8 then
    if Flg[Here] & 4 then
      print at 24,22, "OPEN"
    else
      print at 24,22, "TRAP"
    end if
  end if
  return
end sub

' the chart: 10 x 9 chambers, visited, marked, trap doors opened, you
sub ChartPage:
  Flg[Here] = Flg[Here] | 1
  NewScreen
  print at 8,1, "CHART OF THE DEN"
  for Ci = 0 to 8
    for Cj = 0 to 9
      K = Ci * 10 + Cj
      V = Flg[K]
      T = TCunk
      if V & 1 then
        T = TCvis
        if V & 4 then T = TCtrap
      end if
      if V & 2 then T = TCmark
      X = Cj * 2 + 6
      Y = Ci * 2 + 3
      put char T at X,Y
    next
  next
  put char TCvis at 2,21
  print at 3,21, "SEEN"
  put char TCmark at 9,21
  print at 10,21, "MARK"
  put char TCtrap at 16,21
  print at 17,21, "TRAP OPENED"
  print at 7,22, "PRESS A BUTTON"
  if Mode <> 2 then
    X = Pl.J * 16 + 44
    Y = Pl.I * 16 + 19
    K = Pl.F * 4 + SArrow0
    set sprite 0 to Y,X,K,15
    update sprites
  end if
  ShowScreen
  Ws = 5
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  Ws = 0
  ReadPad
  NewScreen
  DrawFrame
  EnterRoom
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Stick = V & 15
  SPress = 0
  if WasStick = 0 then SPress = Stick
  WasStick = Stick
  B1 = V & 16
  B2 = V & 32
  P1 = 0
  P2 = 0
  if B1 > 0 then
    if WasB1 = 0 then P1 = 1
  end if
  if B2 > 0 then
    if WasB2 = 0 then P2 = 1
  end if
  WasB1 = B1
  WasB2 = B2
  Press = P1 | P2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 4
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a corridor with eyes in the dark, the tune once,
' START GAME / HOW TO PLAY / CREDITS
sub TitlePage:
  NewScreen
  DrawFrame
  fill 32 count 12 at 2,1
  Op = 10
  Here = 0
  Flg[0] = 0
  DrawView
  print at 10,1, "DRAGON'S DEN"
  print at 10,19, "START GAME"
  print at 10,20, "HOW TO PLAY"
  print at 10,21, "CREDITS"
  print at 2,22, "COMPUTE!'S GAZETTE DEC 1985"
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPad
  ' the eyes in the dark ahead blink now and then
  inc Blink
  if Blink < 200 then
    set sprite 1 to 71,120,SEyes,8
  else
    set sprite 1 to 192,0,0,0
  end if
  if Blink >= 210 then Blink = 0
  update sprites
  if SPress & 1 then
    if Menu > 0 then dec Menu
    ShowMenu
  end if
  if SPress & 2 then
    if Menu < 2 then inc Menu
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ShowMenu:
  for Rw = 19 to 21
    put char 32 at 8,Rw
  next
  K = Menu + 19
  put char 62 at 8,K
  return
end sub

sub HowToPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 8,1, "HOW TO PLAY"
  print at 2,3, "FIND THE WAY OUT OF THE DEN."
  print at 2,5, "STICK: LEFT, AHEAD (UP),"
  print at 2,6, "RIGHT, BACK (DOWN)."
  print at 2,7, "LEFT BUTTON: SEARCH THE TRAP"
  print at 2,8, "DOOR. RIGHT BUTTON: CHART,"
  print at 2,9, "MARK (1 BREAD), CANCEL."
  print at 2,11, "UNDER A TRAP DOOR: NOTHING,"
  print at 2,12, "WATER, A ONE-SHOT SWORD,"
  print at 2,13, "GOLD, OR SCALES: RUN AT ONCE"
  print at 2,14, "AFTER 20 TRAP DOORS ONE MAY"
  print at 2,15, "BE AN EXIT."
  print at 2,17, "EVERY STEP OR SEARCH COSTS"
  print at 2,18, "WATER. DRIPPING WATER MEANS"
  print at 2,19, "WATER BELOW; BLOOD, A DRAGON"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "DRAGON'S DEN"
  print at 2,5, "BASED ON DRAGON'S DEN FROM"
  print at 2,6, "THE COMPUTE!'S GAZETTE DISK"
  print at 2,7, "OF DECEMBER 1985 (C-64)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,17, "MUSIC: DOWN THE TRAP DOOR"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

