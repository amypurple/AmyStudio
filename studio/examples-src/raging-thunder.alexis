const SFoe3 = 44
const SFoe4 = 48
const SFoe5 = 52
const SFoe6 = 56
const SFoe7 = 60
const STorp = 64
const SEtorp = 68
const SCross = 72
const SJet = 76
const SHeli1 = 80
const SHeli2 = 84
const SVSubL = 88
const SVSubR = 92
const SVShipL = 96
const SVShipR = 100
const SVCarrL = 104
const SVCarrR = 108
const SVMeL = 112
const SVMeR = 116
const SBoom1 = 120
const SBoom2 = 124
const SStream = 128
const SDcharge = 132
const SMask = 136
const SSpl = 140
const NTiles8 = 744
const SprBytes = 1152
const SndTuneA = 1
const SndTuneB = 2
const SndClick = 3
const SndLaunch = 4
const SndBoom = 5
const SndPing = 6
const SndLamp = 7
const SndDc = 8
const SndWin = 9
const SndLose = 10
const TuneFrames = 512
const HideY = 192
const NSpr = 8
' field (original C64 sprite units)
const FxMin = 30
const FxEnd = 230
const FyMin = 65
const FyEnd = 195
const StartX = 115
const StartY = 124
' states read by the bots
const StBoot = 0
const StTitle = 1
const StHow = 2
const StCredits = 3
const StPlay = 4
const StScene = 5
const StOver = 9
' events
const EvDie = 1
const EvDc = 2
const EvHit = 3
const EvHeli = 4
const EvRam = 5

data DxT bytes 0,1,1,1,0,255,255,255
data DyT bytes 255,255,0,1,1,1,0,255
data LvS bytes 1,0,0,2,1,2
data LvB bytes 0,1,0,1,2,2
data LvA bytes 0,0,1,0,1,2
data LvSt bytes 3,5,4,11,17,25
data LvTh bytes 1,1,1,3,4,5
data LvSa bytes 10,10,10,15,24,30
data NeedT bytes 0,2,4,3
data FoeCol bytes 0,13,9,15

' player
u8 Px = 0
u8 Py = 0
u8 Ph = 0
u8 Spd = 0
u8 Stp = 0
u8 Depth = 0
u8 Dive = 0
u8 Radar = 0
u8 Tube = 0
u8 Ast = 0
u8 Ath = 0
u8 Asa = 0
u8 Xd = 0
u8 Dc = 0
u8 Rud = 0
u8 FireReq = 0
u8 Msg = 0
u8 Dirty = 0
' torpedo slots
u8 Wx[2]
u8 Wy[2]
u8 Wd[2]
u8 Wt[2]
u8 Wn[2]
' enemy vessel
u8 Ex = 0
u8 Ey = 0
u8 Eh = 0
u8 Ed = 0
u8 Et = 0
u8 Dmg = 0
u8 Need = 0
u8 Tx = 0
u8 Ty = 0
u8 Wait1 = 0
u8 WaitN = 0
u8 InRange = 0
u8 FleetS = 0
u8 FleetB = 0
u8 FleetA = 0
' enemy torpedo
u8 Ox = 0
u8 Oy = 0
u8 Od = 0
u8 On1 = 0
u8 OArm = 0
' aircraft: Ak 0 none, 1 jet, 2 helicopter
u8 Ak = 0
u8 Ax = 0
u8 Ay = 0
u8 Aa = 0
' timing
u8 SubC = 0
u8 MainC = 0
u8 Gs = 6
u8 Level = 1
u8 Ev = 0
u8 EvK = 0
u8 Won = 0
u8 Lost = 0
u8 Sunk = 0
u8 Kind = 0
u8 RamCool = 0
u8 RepT = 0
' menus / misc
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 TzLeft = 0
u16 Waited = 0
u8 TzOn = 0
u8 State = 0
u8 Menu = 0
u8 TimedOut = 0
u8 Tick = 0
u8 Idle = 0
u8 R8 = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 B1 = 0
u8 WasB1 = 0
u8 Press = 0
u8 B2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Key = 0
u8 WasKey = 255
u8 Kp = 255
' moving thing (Move1)
u8 Mx = 0
u8 My = 0
u8 Md = 0
' scene
u8 Sf = 0
u8 Sa = 0
u8 Sb = 0
u8 Sc = 0
' loop counters
u8 Li = 0
u8 Wi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table RtSoundTable areas 6
  sprites 16x16
  nmi off
  decompress zx0 SprPatZ to vram.spr_pat
  decompress zx0 TilePatZ to vram.pattern + 1024
  decompress zx0 TilePatZ to vram.pattern + 3072
  decompress zx0 TilePatZ to vram.pattern + 5120
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 3 then
    HowTo
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  if Won = 1 then goto game_end
  if Lost = 1 then goto game_end
  goto play_loop

game_end:
  EndPage
  State = StOver
  Rearm
  wait 30 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' R8 = a random byte
sub Rnd:
  Rand
  W16 = Rs & 255
  R8 = W16
  return
end sub

' R8 = 0 .. N-1 (from the high byte of byte * N)
sub RndN(u8 N):
  Rnd
  W16 = R8
  W16 *= N
  R8 = highbyte(W16)
  return
end sub

' ---------------------------------------------------------------------------
' a new game

sub NewGame:
  T = Level - 1
  FleetS = LvS[T]
  FleetB = LvB[T]
  FleetA = LvA[T]
  Ast = LvSt[T]
  Ath = LvTh[T]
  Asa = LvSa[T]
  Px = StartX
  Py = StartY
  Ph = 0
  Spd = 0
  Stp = 0
  Depth = 10
  Dive = 0
  Radar = 0
  Tube = 0
  Xd = 35
  Dc = 0
  Rud = 0
  FireReq = 0
  Msg = 1
  fill array Wn with 0
  On1 = 0
  Ak = 0
  Tx = StartX
  Ty = StartY
  Wait1 = 0
  InRange = 0
  Eh = 6
  Ed = 6
  SubC = 0
  MainC = 0
  Ev = 0
  Won = 0
  Lost = 0
  RepT = 0
  SpawnFoe
  DrawPlay
  State = StPlay
  return
end sub

' a new vessel of a random kind still in the fleet, somewhere at random
sub SpawnFoe:
sf_again:
  Rnd
  if R8 < 85 then
    if FleetS = 0 then goto sf_again
    dec FleetS
    Et = 1
  else
    if R8 < 170 then
      if FleetB = 0 then goto sf_again
      dec FleetB
      Et = 2
    else
      if FleetA = 0 then goto sf_again
      dec FleetA
      Et = 3
    end if
  end if
  Need = NeedT[Et]
  Dmg = 0
  RndN(200)
  Ex = R8 + FxMin
  RndN(127)
  Ey = R8 + 67
  Wait1 = 0
  return
end sub

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  HandleInput
  Ev = 0
  inc SubC
  if SubC >= 6 then
    SubC = 0
    SubTick
    inc MainC
    if MainC >= Gs then
      MainC = 0
      if Ev = 0 then MainTick
    end if
  end if
  if Ev <> 0 then DoEvent
  DrawSprites
  HudStep
  return
end sub

sub HandleInput:
  if B2 > 0 then
    RepT = 0
    V = Edge & 2
    if V > 0 then ToggleDive
    V = Edge & 1
    if V > 0 then ToggleClimb
    V = Edge & 4
    if V > 0 then
      inc Tube
      Tube = Tube & 3
      Msg = 10 + Tube
      play sound SndClick
      Dirty = 255
    end if
    V = Edge & 8
    if V > 0 then ToggleRadar
  else
    V = Edge & 4
    if V > 0 then TurnLeft
    V = Edge & 8
    if V > 0 then TurnRight
    ' held: turn again after 20 frames, then every 10
    V = Jk & 12
    if V > 0 then
      inc RepT
      if RepT >= 20 then
        RepT = 10
        V = Jk & 4
        if V > 0 then
          TurnLeft
        else
          TurnRight
        end if
      end if
    else
      RepT = 0
    end if
    V = Edge & 1
    if V > 0 then SpeedUp
    V = Edge & 2
    if V > 0 then SpeedDown
  end if
  if Press = 1 then FireReq = 1
  if Kp <> 255 then
    select case Kp
      case 1
        ToggleDive
      case 2
        ToggleClimb
      case 3
        Tube = 2
        Msg = 12
        play sound SndClick
        Dirty = 255
      case 4
        Tube = 1
        Msg = 11
        play sound SndClick
        Dirty = 255
      case 5
        Tube = 3
        Msg = 13
        play sound SndClick
        Dirty = 255
      case 0
        Tube = 0
        Msg = 10
        play sound SndClick
        Dirty = 255
      case 7
        ToggleRadar
      case 10
        if Xd < 40 then inc Xd
      case 11
        if Xd > 3 then dec Xd
    end select
  end if
  return
end sub

sub TurnLeft:
  Ph = Ph + 7
  Ph = Ph & 7
  Rud = 1
  Dirty = Dirty | 255
  return
end sub

sub TurnRight:
  inc Ph
  Ph = Ph & 7
  Rud = 2
  Dirty = Dirty | 255
  return
end sub

sub SpeedUp:
  if Spd < 5 then inc Spd
  Stp = 1
  if Spd >= 4 then Stp = 2
  Dirty = Dirty | 255
  return
end sub

sub SpeedDown:
  if Spd > 0 then dec Spd
  if Spd = 3 then Stp = 1
  if Spd = 0 then Stp = 0
  Dirty = Dirty | 255
  return
end sub

sub ToggleDive:
  if Dive = 1 then
    Dive = 0
  else
    Dive = 1
  end if
  Msg = 20 + Dive
  play sound SndClick
  Dirty = Dirty | 255
  return
end sub

sub ToggleClimb:
  if Dive = 2 then
    Dive = 0
  else
    Dive = 2
  end if
  Msg = 20 + Dive
  play sound SndClick
  Dirty = Dirty | 255
  return
end sub

sub ToggleRadar:
  Radar = Radar ^ 1
  Msg = 30 + Radar
  play sound SndLamp
  Dirty = Dirty | 255
  return
end sub

' every 6 frames: aircraft and the enemy torpedo
sub SubTick:
  if Ak = 0 then
    Rnd
    if R8 >= 230 then
      Ak = 1
      Ax = 31
      RndN(120)
      Ay = R8 + 70
    else
      if Et = 3 then
        Rnd
        if R8 < 50 then
          Ak = 2
          Ax = Ex - 2
          Ay = Ey
        end if
      end if
    end if
  else
    if Ak = 1 then
      Ax += 2
      if Ax >= FxEnd then Ak = 0
    else
      dec Ax
      if Ax < FxMin then Ak = 0
      Aa = Aa ^ 1
    end if
  end if
  if OArm > 0 then dec OArm
  if On1 > 0 then
    Mx = Ox
    My = Oy
    Md = Od
    MoveW
    Ox = Mx
    Oy = My
    if Md = 255 then
      On1 = 0
    else
      dec On1
    end if
  end if
  Collide
  return
end sub

' every Gs sub-ticks: fire, the sub, the depth, the vessel, your torpedoes
sub MainTick:
  if RamCool > 0 then dec RamCool
  if Rud <> 0 then
    Rud = 0
    Dirty = 255
  end if
  if FireReq = 1 then TryFire
  FireReq = 0
  ' the sub
  Mx = Px
  My = Py
  Md = Ph
  if Stp > 0 then Move1
  if Stp > 1 then Move1
  Px = Mx
  Py = My
  ' depth: 10 ft a tick, 0 to 600 ft
  if Dive = 1 then
    if Depth < 60 then
      inc Depth
      Dirty = 255
    end if
  end if
  if Dive = 2 then
    if Depth > 0 then
      dec Depth
      Dirty = 255
    end if
  end if
  ' naval radar range: both know where the other is
  T = absdiff(Ex, Px)
  V = absdiff(Ey, Py)
  K = 0
  if T < 35 then
    if V < 35 then K = 1
  end if
  if K <> InRange then
    InRange = K
    if K = 1 then play sound SndPing
    Dirty = Dirty | 64
  end if
  if InRange = 1 then GiveAway
  if Radar = 1 then GiveAway
  if Depth = 0 then GiveAway
  FoeMove
  ' the vessel fires when you are in range and it faces its course
  if InRange = 1 then
    if Eh = Ed then
      Rnd
      if R8 < 32 then
        if On1 = 0 then
          On1 = 38
          OArm = Gs
          Ox = Ex
          Oy = Ey
          Od = Eh
        end if
      end if
    end if
  end if
  ' your torpedoes: 2 units a tick, 40 ticks at most
  for Wi = 0 to 1
    if Wn[Wi] > 0 then
      Mx = Wx[Wi]
      My = Wy[Wi]
      Md = Wd[Wi]
      MoveW
      Wx[Wi] = Mx
      Wy[Wi] = My
      if Md = 255 then
        Wn[Wi] = 0
      else
        T = Wn[Wi]
        Wn[Wi] = T - 1
      end if
    end if
  next
  Collide
  return
end sub

sub GiveAway:
  Tx = Px
  Ty = Py
  return
end sub

' the enemy vessel: wait 50 ticks at its target, then pick a new one; else
' turn one step toward the target's direction or move one unit along it
sub FoeMove:
  if Ex = Tx then
    if Ey = Ty then
      if Wait1 = 0 then
        Wait1 = 1
        WaitN = 50
      end if
      dec WaitN
      if WaitN > 0 then return
      Wait1 = 0
      RndN(200)
      Tx = R8 + FxMin
      RndN(130)
      Ty = R8 + FyMin
    end if
  end if
  ' the wanted heading 0-7 (N, NE, E, SE, S, SW, W, NW)
  if Tx = Ex then
    Ed = 0
    if Ty > Ey then Ed = 4
  else
    if Tx > Ex then
      Ed = 2
      if Ty < Ey then Ed = 1
      if Ty > Ey then Ed = 3
    else
      Ed = 6
      if Ty < Ey then Ed = 7
      if Ty > Ey then Ed = 5
    end if
  end if
  if Eh = Ed then
    Mx = Ex
    My = Ey
    Md = Eh
    Move1
    Ex = Mx
    Ey = My
  else
    ' the shorter way round
    T = Ed - Eh
    T = T & 7
    if T < 4 then
      inc Eh
    else
      dec Eh
    end if
    Eh = Eh & 7
  end if
  return
end sub

' one unit along Md, wrapping round the field
sub Move1:
  T = DxT[Md]
  Mx += T
  T = DyT[Md]
  My += T
  if Mx >= FxEnd then Mx = 31
  if Mx < FxMin then Mx = 229
  if My >= FyEnd then My = 66
  if My < FyMin then My = 194
  return
end sub

' two units along Md for a torpedo; Md = 255 when it leaves the field
sub MoveW:
  T = DxT[Md]
  T = T << 1
  Mx += T
  T = DyT[Md]
  T = T << 1
  My += T
  if Mx >= FxEnd then Md = 255
  if Mx < FxMin then Md = 255
  if My >= FyEnd then Md = 255
  if My < FyMin then Md = 255
  return
end sub

sub TryFire:
  if Tube = 0 then
    Msg = 40
    Dirty = 255
    return
  end if
  if Depth >= 40 then
    Msg = 41
    Dirty = 255
    return
  end if
  K = 255
  if Wn[1] = 0 then K = 1
  if Wn[0] = 0 then K = 0
  if K = 255 then return
  if Tube = 1 then
    if Ast = 0 then goto tf_none
    dec Ast
  end if
  if Tube = 2 then
    if Ath = 0 then goto tf_none
    dec Ath
  end if
  if Tube = 3 then
    if Asa = 0 then goto tf_none
    dec Asa
  end if
  Wn[K] = 40
  Wx[K] = Px
  Wy[K] = Py
  Wd[K] = Ph
  Wt[K] = Tube
  Tube = 0
  Msg = 42
  play sound SndLaunch
  Dirty = Dirty | 255
  Dirty = Dirty | 128
  return
tf_none:
  Msg = 43
  Dirty = Dirty | 255
  return
end sub

' collisions, first one wins (boxes from the C64 traces: sprite pixels
' overlapped at up to 9-10 units across): enemy torpedo, ramming (1 hull
' point, then 13 ticks before another counts), a depth charge (radar
' on, above 400 ft), your torpedoes on the vessel (seen only in range), a
' SAM on the helicopter (seen only with the radar on)
sub Collide:
  ' the enemy torpedo is armed once a game tick has passed since launch, and
  ' does not count while the vessel itself touches you (the C64 needed an
  ' exact collision set: torpedo + launcher + you was ignored; traces)
  K = 0
  if absdiff(Ex, Px) <= 10 then
    if absdiff(Ey, Py) <= 7 then K = InRange
  end if
  if On1 > 0 then
    if OArm = 0 then
      if K = 0 then
        if absdiff(Ox, Px) <= 3 then
          if absdiff(Oy, Py) <= 3 then
            Ev = EvDie
            return
          end if
        end if
      end if
    end if
  end if
  if RamCool = 0 then
    if InRange = 1 then
      if Depth < 40 then
        if absdiff(Ex, Px) <= 10 then
          if absdiff(Ey, Py) <= 7 then
            Ev = EvRam
            return
          end if
        end if
      end if
    end if
  end if
  if Ak > 0 then
    if Radar = 1 then
      if Depth < 40 then
        if absdiff(Ax, Px) <= 8 then
          if absdiff(Ay, Py) <= 6 then
            Ev = EvDc
            return
          end if
        end if
      end if
    end if
  end if
  for Li = 0 to 1
    if Wn[Li] > 0 then
      if Wt[Li] <> 3 then
        if InRange = 1 then
          if absdiff(Wx[Li], Ex) <= 8 then
            if absdiff(Wy[Li], Ey) <= 6 then
              Ev = EvHit
              EvK = Li
              return
            end if
          end if
        end if
      else
        if Ak = 2 then
          if Radar = 1 then
            if absdiff(Wx[Li], Ax) <= 8 then
              if absdiff(Wy[Li], Ay) <= 6 then
                Ev = EvHeli
                EvK = Li
                return
              end if
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

sub DoEvent:
  State = StScene
  if Ev = EvHit then
    K = EvK
    Wn[K] = 0
    T = Wt[K]
    Dmg += T
    Sunk = 0
    if Dmg >= Need then Sunk = 1
    Scene1
    if Sunk = 1 then
      T = FleetS + FleetB
      T += FleetA
      if T = 0 then
        Won = 1
      else
        SpawnFoe
      end if
    end if
  end if
  if Ev = EvHeli then
    K = EvK
    Wn[K] = 0
    Ak = 0
    Scene2
  end if
  if Ev = EvDc then
    Ak = 0
    inc Dc
    Sunk = 0
    if Dc >= 2 then Sunk = 1
    Scene4
    if Sunk = 1 then Lost = 1
  end if
  if Ev = EvDie then
    Sunk = 1
    Kind = 1
    Scene3
    Lost = 1
  end if
  if Ev = EvRam then
    ' a collision: 1 point of hull damage, like a depth charge (the C64
    ' trace: the same counter, the vessel sails on; next ram 13 ticks later)
    inc Dc
    Sunk = 0
    if Dc >= 2 then Sunk = 1
    Kind = 2
    RamCool = 13
    Scene3
    if Sunk = 1 then Lost = 1
  end if
  Ev = 0
  if Won = 0 then
    if Lost = 0 then
      DrawPlay
      State = StPlay
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' battle scenes (side view in the tactical box)

sub SceneBack:
  HideSprites
  for Li = 3 to 9
    fill TSky count 19 at 3,Li
  next
  put char TSky2 at 6,4
  put char TSky2 at 14,3
  put char TSky2 at 19,6
  fill TWave count 19 at 3,10
  for Li = 11 to 16
    fill TDeep count 19 at 3,Li
  next
  return
end sub

' a vessel hit; it sinks when Sunk = 1
sub Scene1:
  SceneBack
  Sc = FoeCol[Et]
  Sa = SVSubL
  if Et = 2 then Sa = SVShipL
  if Et = 3 then Sa = SVCarrL
  Sy = 73
  for Sf = 0 to 179
    Frame1
    if Sf < 64 then
      ' the torpedo's wake runs in from the left
      Sx = Sf + 24
      set sprite 4 to 88,Sx,SStream,15
    else
      set sprite 4 to HideY,0,SStream,0
    end if
    if Sf = 64 then play sound SndBoom
    if Sf >= 64 then
      if Sf < 112 then
        V = SBoom1
        if Sf >= 84 then V = SBoom2
        set sprite 5 to 64,84,V,11
      else
        set sprite 5 to HideY,0,SBoom1,0
      end if
    end if
    if Sunk = 1 then
      if Sf >= 112 then
        V = Sf & 3
        if V = 0 then
          if Sy < 88 then inc Sy
        end if
        set sprite 0 to 87,80,SMask,4
        set sprite 1 to 87,96,SMask,4
      end if
    end if
    T = Sa + 4
    set sprite 2 to Sy,80,Sa,Sc
    set sprite 3 to Sy,96,T,Sc
    update sprites
  next
  if Sunk = 1 then
    print at 6,13, "VESSEL SUNK!"
  else
    print at 7,13, "A HIT!"
  end if
  wait 40 frames
  return
end sub

' a helicopter shot down by a SAM
sub Scene2:
  SceneBack
  Sy = 40
  for Sf = 0 to 159
    Frame1
    if Sf < 48 then
      V = 88 - Sf
      set sprite 4 to V,96,SEtorp,15
    else
      set sprite 4 to HideY,0,SEtorp,0
    end if
    if Sf = 48 then play sound SndBoom
    V = SHeli1
    T = Sf & 16
    if T > 0 then V = SHeli2
    if Sf >= 48 then
      if Sf < 96 then
        T = SBoom1
        if Sf >= 68 then T = SBoom2
        set sprite 5 to 30,96,T,11
      else
        set sprite 5 to HideY,0,SBoom1,0
        if Sy < 76 then inc Sy
      end if
    end if
    set sprite 2 to Sy,96,V,7
    update sprites
  next
  print at 4,13, "HELICOPTER DOWN!"
  wait 40 frames
  return
end sub

' your sub torpedoed or rammed: it sinks
sub Scene3:
  SceneBack
  Sy = 73
  for Sf = 0 to 179
    Frame1
    if Sf < 64 then
      V = 170 - Sf
      if Kind = 2 then
        V = 176 - Sf
        set sprite 4 to 74,V,SFoe6,9
      else
        set sprite 4 to 88,V,SStream,8
      end if
    else
      set sprite 4 to HideY,0,SStream,0
    end if
    if Sf = 64 then play sound SndBoom
    if Sf >= 64 then
      if Sf < 112 then
        V = SBoom1
        if Sf >= 84 then V = SBoom2
        set sprite 5 to 64,92,V,11
      else
        set sprite 5 to HideY,0,SBoom1,0
        if Sunk = 1 then
          V = Sf & 3
          if V = 0 then
            if Sy < 88 then inc Sy
          end if
          set sprite 0 to 87,80,SMask,4
          set sprite 1 to 87,96,SMask,4
        end if
      end if
    end if
    set sprite 2 to Sy,80,SVMeL,11
    set sprite 3 to Sy,96,SVMeR,11
    update sprites
  next
  if Sunk = 1 then
    print at 6,13, "YOU ARE SUNK!"
  else
    print at 4,13, "COLLISION! HULL HIT"
    print at 4,14, "ONE MORE SINKS YOU"
  end if
  wait 40 frames
  return
end sub

' a depth charge from an aircraft
sub Scene4:
  SceneBack
  Sy = 100
  Sb = 46
  for Sf = 0 to 179
    Frame1
    if Sf < 140 then
      V = Sf + 16
      set sprite 5 to 30,V,SJet,14
    else
      set sprite 5 to HideY,0,SJet,0
    end if
    if Sf >= 50 then
      if Sf < 100 then
        Sb = Sf - 4
        set sprite 4 to Sb,88,SDcharge,14
      else
        set sprite 4 to HideY,0,SDcharge,0
      end if
    end if
    if Sf = 100 then play sound SndDc
    if Sf >= 100 then
      if Sf < 140 then
        V = SBoom1
        if Sf >= 120 then V = SBoom2
        set sprite 1 to 92,88,V,11
      else
        set sprite 1 to HideY,0,SBoom1,0
        if Sunk = 1 then
          V = Sf & 3
          if V = 0 then
            if Sy < 112 then inc Sy
          end if
        end if
      end if
    end if
    set sprite 2 to Sy,80,SVMeL,11
    set sprite 3 to Sy,96,SVMeR,11
    update sprites
  next
  if Sunk = 1 then
    print at 6,4, "THE SECOND CHARGE"
    print at 6,5, "SINKS YOU!"
  else
    print at 6,4, "DEPTH CHARGE HIT!"
    print at 6,5, "ONE MORE SINKS YOU"
  end if
  wait 40 frames
  return
end sub

' ---------------------------------------------------------------------------
' drawing the play screen

' field units -> sprite pixels: Sx = 16 + (Mx - 30) * 3/4, Sy likewise
sub ToScr:
  W16 = Mx - FxMin
  W16 *= 3
  W16 = W16 >> 2
  Sx = W16
  Sx += 16
  W16 = My - FyMin
  W16 *= 3
  W16 = W16 >> 2
  Sy = W16
  Sy += 15
  return
end sub

sub DrawSprites:
  Mx = Px
  My = Py
  ToScr
  T = Ph << 2
  set sprite 0 to Sy,Sx,T,11
  ' the vessel, seen only in range
  if InRange = 1 then
    Mx = Ex
    My = Ey
    ToScr
    T = Eh << 2
    T += SFoe0
    V = FoeCol[Et]
    set sprite 1 to Sy,Sx,T,V
  else
    set sprite 1 to HideY,0,SFoe0,0
  end if
  if On1 > 0 then
    Mx = Ox
    My = Oy
    ToScr
    set sprite 2 to Sy,Sx,SEtorp,8
  else
    set sprite 2 to HideY,0,SEtorp,0
  end if
  for Li = 0 to 1
    C = Li + 3
    if Wn[Li] > 0 then
      Mx = Wx[Li]
      My = Wy[Li]
      ToScr
      V = 15
      if Wt[Li] = 2 then V = 9
      set sprite C to Sy,Sx,STorp,V
    else
      set sprite C to HideY,0,STorp,0
    end if
  next
  ' aircraft: on the radar only
  K = 0
  if Ak > 0 then
    if Radar = 1 then K = 1
  end if
  if K = 1 then
    Mx = Ax
    My = Ay
    ToScr
    if Ak = 1 then
      set sprite 5 to Sy,Sx,SJet,14
    else
      V = SHeli1
      if Aa = 1 then V = SHeli2
      set sprite 5 to Sy,Sx,V,7
    end if
  else
    set sprite 5 to HideY,0,SJet,0
  end if
  ' the crosshair, Xd units ahead, when a tube is loaded
  K = 0
  if Tube > 0 then
    T = DxT[Ph]
    W16 = Px
    if T = 1 then W16 += Xd
    if T = 255 then W16 -= Xd
    if W16 >= FxMin then
      if W16 < FxEnd then
        Mx = W16
        T = DyT[Ph]
        W16 = Py
        if T = 1 then W16 += Xd
        if T = 255 then W16 -= Xd
        if W16 >= FyMin then
          if W16 < FyEnd then
            My = W16
            K = 1
          end if
        end if
      end if
    end if
  end if
  if K = 1 then
    ToScr
    set sprite 6 to Sy,Sx,SCross,7
  else
    set sprite 6 to HideY,0,SCross,0
  end if
  update sprites
  return
end sub

sub DrawBox:
  put char TFTL at 2,2
  fill TFT count 19 at 3,2
  put char TFTR at 22,2
  for Li = 3 to 16
    put char TFL at 2,Li
    fill TSea count 19 at 3,Li
    put char TFR at 22,Li
  next
  put char TSea2 at 6,5
  put char TSea2 at 17,8
  put char TSea2 at 9,12
  put char TSea2 at 19,14
  put char TSea2 at 13,4
  put char TFBL at 2,17
  fill TFB count 19 at 3,17
  put char TFBR at 22,17
  return
end sub

sub DrawPlay:
  NewScreen
  DrawBox
  print at 23,2, "DEPTH"
  print at 23,5, "HEADING"
  print at 23,8, "SPEED"
  print at 23,11, "RUDDER"
  print at 23,14, "TUBE 1"
  print at 23,17, "RADAR"
  print at 23,18, "U V D"
  print at 23,19, "TURBO"
  put char TIcSt at 2,19
  put char TIcTh at 9,19
  put char TIcSa at 15,19
  print at 3,19, "ST"
  print at 10,19, "TH"
  print at 16,19, "SA"
  print at 2,20, "FLEET  A   B   S"
  DrawHud
  DrawAmmo
  DrawLamps
  ShowScreen
  DrawSprites
  return
end sub

sub DrawAmmo:
  NumU = Ast
  print at 5,19, digits$(NumU, 2)
  NumU = Ath
  print at 12,19, digits$(NumU, 1)
  NumU = Asa
  print at 18,19, digits$(NumU, 2)
  NumU = FleetA
  print at 9,20, digits$(NumU, 1)
  NumU = FleetB
  print at 13,20, digits$(NumU, 1)
  NumU = FleetS
  print at 17,20, digits$(NumU, 1)
  return
end sub

sub DrawLamps:
  T = TLampOff
  if Radar = 1 then T = TLampRed
  put char T at 29,17
  T = TLampOff
  if InRange = 1 then T = TLampRed
  put char T at 29,18
  T = TLampOff
  if Stp = 2 then T = TLampYel
  put char T at 29,19
  return
end sub

sub DrawHud:
  for Li = 0 to 4
    Dirty = 1 << Li
    HudPart
  next
  DrawLamps
  DrawMsg
  Dirty = 0
  return
end sub

' one HUD part a frame (Dirty: 1 depth, 2 heading, 4 speed, 8 rudder,
' 16 tube, 32 message, 64 lamps, 128 ammunition), so no pass overruns
sub HudStep:
  if Dirty = 0 then return
  T = Dirty
  V = 1
  while (T & 1) = 0
    T = T >> 1
    V = V << 1
  end while
  K = Dirty
  Dirty = V
  if V = 32 then
    DrawMsg
  else
    if V = 64 then
      DrawLamps
    else
      if V = 128 then
        DrawAmmo
      else
        HudPart
      end if
    end if
  end if
  V = V ^ 255
  Dirty = K & V
  return
end sub

sub HudPart:
  if Dirty = 1 then
    NumU = Depth
    NumU *= 10
    print at 23,3, digits$(NumU, 3)
    print at 26,3, " FT"
  end if
  if Dirty = 2 then
    NumU = Ph
    NumU *= 45
    print at 23,6, digits$(NumU, 3)
    print at 26,6, " DG"
  end if
  if Dirty = 4 then
    NumU = Spd
    NumU *= 10
    print at 23,9, digits$(NumU, 2)
    print at 25,9, " KN"
  end if
  if Dirty = 8 then
    select case Rud
      case 0
        print at 23,12, "AHEAD  "
      case 1
        print at 23,12, "LEFT   "
      case 2
        print at 23,12, "RIGHT  "
    end select
  end if
  if Dirty = 16 then
    select case Tube
      case 0
        print at 23,15, "EMPTY  "
      case 1
        print at 23,15, "STINGER"
      case 2
        print at 23,15, "THNDR-5"
      case 3
        print at 23,15, "SAM    "
    end select
  end if
  return
end sub

sub DrawMsg:
  select case Msg
    case 1
      print at 2,21, "NIGHT WOLF IS OUT THERE...  "
    case 10
      print at 2,21, "TUBE EMPTY                  "
    case 11
      print at 2,21, "STINGER LOADED (1 DAMAGE)   "
    case 12
      print at 2,21, "THUNDR-5 LOADED (2 DAMAGE)  "
    case 13
      print at 2,21, "SAM LOADED (HELICOPTERS)    "
    case 20
      print at 2,21, "DEPTH HELD                  "
    case 21
      print at 2,21, "DIVING (MAX 600 FT)         "
    case 22
      print at 2,21, "CLIMBING                    "
    case 30
      print at 2,21, "RADAR OFF                   "
    case 31
      print at 2,21, "RADAR ON: THEY CAN HEAR YOU "
    case 40
      print at 2,21, "LOAD A TUBE FIRST (BUTTON 2)"
    case 41
      print at 2,21, "TOO DEEP TO FIRE (400 FT+)  "
    case 42
      print at 2,21, "TORPEDO AWAY!               "
    case 43
      print at 2,21, "NONE OF THAT WEAPON LEFT    "
  end select
  return
end sub

' ---------------------------------------------------------------------------
' frame, input, screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' Jk = directions held (1 up, 2 down, 4 left, 8 right), Edge = new ones,
' Press = button 1 newly pressed (either button in menus: Btn), B2 = button
' 2 held, Kp = keypad key newly pressed (255 none)
sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  B1 = V & 16
  B2 = V & 32
  Press = 0
  if B1 > 0 then
    if WasB1 = 0 then Press = 1
  end if
  WasB1 = B1
  Btn = V & 48
  Key = keypad(1)
  if Key = 255 then Key = keypad(2)
  Kp = 255
  if Key <> WasKey then Kp = Key
  WasKey = Key
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  for J = 0 to 7
    set sprite J to HideY,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  decompress zx0 TileColZ to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub DrawLogo:
  ' RAGING (rows 2-3) and THUNDER (rows 4-5), 2 x 2 tile letters
  C = 10
  for Li = 0 to 5
    select case Li
      case 0
        T = TLR00
      case 1
        T = TLA00
      case 2
        T = TLG00
      case 3
        T = TLI00
      case 4
        T = TLN00
      case 5
        T = TLG00
    end select
    BigAt
    C += 2
  next
  C = 9
  for Li = 0 to 6
    select case Li
      case 0
        T = TLT00
      case 1
        T = TLH00
      case 2
        T = TLU00
      case 3
        T = TLN00
      case 4
        T = TLD00
      case 5
        T = TLE00
      case 6
        T = TLR00
    end select
    V = 4
    BigAt4
    C += 2
  next
  return
end sub

' a 2 x 2 letter whose first tile is T at column C, rows 2-3
sub BigAt:
  put char T at C,2
  inc T
  J = C + 1
  put char T at J,2
  inc T
  put char T at C,3
  inc T
  put char T at J,3
  return
end sub

sub BigAt4:
  put char T at C,4
  inc T
  J = C + 1
  put char T at J,4
  inc T
  put char T at C,5
  inc T
  put char T at J,5
  return
end sub

' the 8 x 4 periscope picture at columns 12-19, rows 7-10
sub DrawPic:
  T = TP00
  for Li = 7 to 10
    for J = 12 to 19
      put char T at J,Li
      inc T
    next
  next
  return
end sub

sub TitlePage:
  State = StTitle
  NewScreen
  DrawLogo
  DrawPic
  print at 11,12, "START"
  print at 11,15, "HOW TO PLAY"
  print at 11,16, "CREDITS"
  print at 5,19, "BY CRAIG M. BUCK"
  print at 5,20, "RUN MAGAZINE, RERUN 1992"
  Menu = 0
  ShowOpts
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = TuneFrames
  TzOn = 1
  WasB1 = 16
tp_loop:
  Frame1
  Rand
  ReadPad
  K = Edge & 3
  if K > 0 then
    if K = 1 then
      if Menu = 0 then
        Menu = 4
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 4 then Menu = 0
    end if
    play sound SndClick
    ShowMenu
  end if
  K = Edge & 12
  if K > 0 then
    if Menu = 1 then
      if K = 8 then
        inc Level
        if Level > 6 then Level = 1
      else
        dec Level
        if Level = 0 then Level = 6
      end if
      play sound SndClick
      ShowOpts
    end if
    if Menu = 2 then
      if K = 8 then
        inc Gs
        if Gs > 6 then Gs = 1
      else
        dec Gs
        if Gs = 0 then Gs = 6
      end if
      play sound SndClick
      ShowOpts
    end if
  end if
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  if Menu = 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub ShowOpts:
  print at 11,13, "LEVEL"
  NumU = Level
  print at 17,13, digits$(NumU, 1)
  T = Level - 1
  print at 19,13, "A"
  NumU = LvA[T]
  print at 20,13, digits$(NumU, 1)
  print at 22,13, "B"
  NumU = LvB[T]
  print at 23,13, digits$(NumU, 1)
  print at 25,13, "S"
  NumU = LvS[T]
  print at 26,13, digits$(NumU, 1)
  print at 11,14, "SPEED"
  NumU = Gs
  print at 17,14, digits$(NumU, 1)
  if Gs = 4 then
    print at 19,14, "(BEST)"
  else
    print at 19,14, "      "
  end if
  return
end sub

sub ShowMenu:
  for J = 12 to 16
    put char 32 at 9,J
  next
  C = Menu + 12
  put char 62 at 9,C
  return
end sub

sub PageWait:
  ShowScreen
  WasB1 = 16
  Waited = 0
  TimedOut = 0
pw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited >= 1800 then
    TimedOut = 1
    Press = 1
  end if
  if Press = 0 then goto pw_loop
  return
end sub

sub CreditsPage:
  State = StCredits
  NewScreen
  DrawLogo
  print at 2,7, "ORIGINAL GAME (COMMODORE 64)"
  print at 2,8, "BY CRAIG M. BUCK"
  print at 2,9, "RUN MAGAZINE, RERUN DISK"
  print at 2,10, "MARCH/APRIL 1992"
  print at 2,13, "COLECOVISION VERSION"
  print at 2,14, "BY CLAUDE (ANTHROPIC)"
  print at 2,15, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,17, "MUSIC: SILENT RUNNING"
  print at 2,18, "(ORIGINAL)"
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  return
end sub

sub HowTo:
  State = StHow
  NewScreen
  print at 8,1, "HOW TO PLAY  1/3"
  print at 2,3, "SINK THE NIGHT WOLF FLEET."
  print at 2,4, "YOU SEE A VESSEL ONLY WHEN"
  print at 2,5, "IT IS NEAR: THEN IT SEES"
  print at 2,6, "YOU TOO, AND HUNTS YOU."
  fill TSea count 10 at 11,8
  fill TSea count 10 at 11,9
  fill TSea count 10 at 11,10
  set sprite 0 to 63,96,SMe2,11
  set sprite 1 to 63,136,SFoe6,9
  set sprite 2 to 63,116,STorp,15
  update sprites
  print at 2,12, "STICK LEFT/RIGHT: TURN"
  print at 2,13, "STICK UP/DOWN: SPEED"
  print at 2,14, "BUTTON 1: FIRE THE TUBE"
  print at 2,15, "BUTTON 2 + STICK:"
  print at 3,16, "DOWN DIVE, UP CLIMB,"
  print at 3,17, "LEFT LOAD, RIGHT RADAR"
  print at 2,19, "KEYPAD: 1 DIVE  2 CLIMB"
  print at 2,20, "7 RADAR  3/4/5 LOAD  0 EMPTY"
  PageWait
  if TimedOut = 1 then goto ht_end
  NewScreen
  print at 8,1, "HOW TO PLAY  2/3"
  put char TIcSt at 2,3
  print at 4,3, "STINGER: 1 DAMAGE"
  put char TIcTh at 2,4
  print at 4,4, "THUNDR-5: 2 DAMAGE"
  put char TIcSa at 2,5
  print at 4,5, "SAM: HELICOPTERS ONLY"
  print at 2,7, "SUB 2, CARRIER 3, BATTLE-"
  print at 2,8, "SHIP 4 POINTS TO SINK."
  print at 2,9, "A TORPEDO GOES WHERE YOU"
  print at 2,10, "HEAD. NO FIRING BELOW 400FT."
  set sprite 0 to 95,64,SVShipL,9
  set sprite 1 to 95,80,SVShipR,9
  set sprite 2 to 95,128,SVCarrL,15
  set sprite 3 to 95,144,SVCarrR,15
  update sprites
  print at 2,15, "CARRIERS SEND HELICOPTERS."
  print at 2,16, "ALL SHIPS FIRE THUNDR-5S:"
  print at 2,17, "ONE HIT SINKS YOU."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
  if TimedOut = 1 then goto ht_end
  NewScreen
  print at 8,1, "HOW TO PLAY  3/3"
  print at 2,3, "THEY FIND YOU WHEN YOU ARE"
  print at 2,4, "NEAR, ON THE SURFACE, OR"
  print at 2,5, "WITH THE RADAR ON."
  put char TLampRed at 2,7
  print at 4,7, "RADAR: SHOWS AIRCRAFT, BUT"
  print at 4,8, "THEY CAN HIT YOU (ABOVE"
  print at 4,9, "400 FT). 2 CHARGES SINK."
  put char TLampRed at 2,11
  print at 4,11, "U V D: A VESSEL IN RANGE"
  put char TLampYel at 2,13
  print at 4,13, "TURBO: 40 KNOTS AND UP"
  set sprite 0 to 119,96,SJet,14
  set sprite 1 to 119,136,SHeli1,7
  update sprites
  print at 2,18, "TIP: DIVE DEEP TO DODGE"
  print at 2,19, "AIRCRAFT, CLIMB TO SHOOT."
  print at 8,21, "PRESS THE BUTTON"
  PageWait
ht_end:
  HideSprites
  return
end sub

' the end: Night Wolf's last word, as in the original
sub EndPage:
  NewScreen
  DrawLogo
  if Won = 1 then
    print at 4,8, "THE NIGHT WOLF FLEET"
    print at 4,9, "IS DESTROYED. YOU WIN!"
    print at 4,12, "NIGHT WOLF SIGNALS:"
    print at 4,14, "THERE WILL BE ANOTHER"
    print at 4,15, "TIME AND WE WILL BE"
    print at 4,16, "VICTORIOUS."
    play sound SndWin
  else
    print at 4,8, "YOUR SUBMARINE IS LOST."
    print at 4,12, "NIGHT WOLF SIGNALS:"
    print at 4,14, "YOU HAVE LOST AND NOW"
    print at 4,15, "THE WORLD IS OURS"
    print at 4,16, "TO RULE FOREVER."
    play sound SndLose
  end if
  print at 8,20, "PRESS THE BUTTON"
  ShowScreen
  return
end sub

