const TIcSa = 148
const TLR00 = 149
const TLR01 = 150
const TLR10 = 151
const TLR11 = 152
const TLA00 = 153
const TLA01 = 154
const TLA10 = 155
const TLA11 = 156
const TLG00 = 157
const TLG01 = 158
const TLG10 = 159
const TLG11 = 160
const TLI00 = 161
const TLI01 = 162
const TLI10 = 163
const TLI11 = 164
const TLN00 = 165
const TLN01 = 166
const TLN10 = 167
const TLN11 = 168
const TLT00 = 169
const TLT01 = 170
const TLT10 = 171
const TLT11 = 172
const TLH00 = 173
const TLH01 = 174
const TLH10 = 175
const TLH11 = 176
const TLU00 = 177
const TLU01 = 178
const TLU10 = 179
const TLU11 = 180
const TLD00 = 181
const TLD01 = 182
const TLD10 = 183
const TLD11 = 184
const TLE00 = 185
const TLE01 = 186
const TLE10 = 187
const TLE11 = 188
const TP00 = 189
