record Obj:
  u16 X
  u16 Y
end record

Obj Ob[7]
u8 Wall[112]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 PX = 0
u16 BuY = 0
u16 SpPl = 0
u16 SpBu = 0
u16 SpBo = 0
u16 SpBi = 0
u16 SpAl = 0
u16 SpSm = 0
u16 SpSh = 0
u16 NumU = 0
bcd digits 6 Score = 0
bcd digits 6 Hi = 0
u8 BuOn = 0
u8 BuBomb = 0
u8 BuX = 0
u8 Lv = 0
u8 Rr = 16
u8 Lives = 0
u8 Freeze = 0
u8 Won = 0
u8 Over = 0
u8 SmartOn = 0
u8 NLast = 5
u8 BoomX = 0
u8 BoomY = 0
u8 Waves = 0
u8 Deaths = 0
u8 Shots = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Oi = 0
u8 Ds = 0
u8 Wr = 0
u8 Wc = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Hit = 0

  tile screen
  set sound table AaSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  print at 8,10, "                "
  print at 8,11, "   GAME  OVER   "
  print at 8,12, "                "
  print at 8,13, " SCORE ", Score, "0  "
  print at 8,14, " BEST  ", Hi, "0  "
  print at 8,15, "                "
  mute all
  play sound SndOver
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play
sub PlayStep:
  if Freeze > 0 then
    dec Freeze
    if Freeze = 0 then
      if Won = 1 then
        NewWave
      else
        if Lives = 0 then Over = 1
      end if
    end if
    return
  end if
  MovePlayer
  V = J1 & 16
  if BuOn = 0 then
    if V > 0 then
      BuOn = 1
      W16 = PX >> 5
      BuX = W16
      BuY = BuStart
      BuBomb = 0
      inc Shots
      play sound SndZap
    end if
  end if
  if BuOn = 1 then
    BuY = BuY - SpBu
    BulletHits
  end if
  if SmartOn = 0 then
    if Score >= 1000 then
      SmartOn = 1
      NLast = 6
      Ob[6].X = RandX()
      Ob[6].Y = YTop
    end if
  end if
  MoveAll
  return
end sub

sub MovePlayer:
  K = J1 & 12
  select case K
    case 4
      W16 = XMin + SpPl
      if PX < W16 then
        PX = XMin
      else
        PX = PX - SpPl
      end if
    case 8
      W16 = XMax - SpPl
      if PX > W16 then
        PX = XMax
      else
        PX = PX + SpPl
      end if
  end select
  return
end sub

' a random column for a new bird, alien or smartbomb (pixels 30-206)
function RandX as u16
  Rand
  W16 = Rs % 177
  W16 = W16 + 30
  return W16 << 5

' the base speed B at this level
function Scale(u8 B) as u16
  W16 = B
  W16 = W16 * Rr
  return W16 >> 4

' 1 when two sprites' left edges (1/32 pixels) are less than D pixels apart
function Near(u16 A, u16 B, u8 D) as u8
  A = A >> 5
  B = B >> 5
  if A > B then
    A = A - B
  else
    A = B - A
  end if
  Hit = 0
  if A < D then Hit = 1
  return Hit

' the laser against the falling things, the droids and the mothership
sub BulletHits:
  u16 Tip = 0
  u16 Bx32 = 0
  u16 Oy = 0
  Tip = BuY >> 5
  Bx32 = BuX
  Bx32 = Bx32 << 5
  for Oi = 0 to NLast
    if BuOn = 1 then
      Oy = Ob[Oi].Y >> 5
      if Oy >= 72 then
        if Tip >= Oy then
          W16 = Oy + 10
          if Tip < W16 then
            if Near(Ob[Oi].X, Bx32, 6) = 1 then ShotObj
          end if
        end if
      end if
    end if
  next
  if BuOn = 1 then
    if Tip < 72 then
      if Tip >= 40 then
        HitWall(Tip)
      end if
    end if
  end if
  if BuOn = 1 then
    if Tip < 32 then
      BuOn = 0
      C = BuX + 8
      C = C >> 3
      if C >= 14 then
        if C <= 17 then WinWave
      end if
    end if
  end if
  return
end sub

' the laser at height Tip in the wall's rows: a droid there takes a hit
sub HitWall(u16 Tip):
  Wr = Tip - 40
  Wr = Wr >> 3
  Wc = BuX + 8
  Wc = Wc >> 3
  Wc = Wc - 2
  J = Wr * 28 + Wc
  if Wall[J] > 0 then
    dec Wall[J]
    BuOn = 0
    Score += 5
    DrawCell
    play sound SndDent
    ShowScore
  end if
  return
end sub

' the droid at row Wr, column Wc (state Wall[J])
sub DrawCell:
  V = Wall[J]
  X = Wc + 2
  Y = Wr + 5
  if V = 0 then
    put char 32 at X,Y
  else
    put char 142 - V at X,Y
  end if
  return
end sub

' the laser hits falling thing Oi
sub ShotObj:
  select case Oi
    case 0
      ' 10 points once a shot; the laser passes over the bomb, which
      ' falls on (as on the C64)
      if BuBomb = 0 then
        Score += 1
        BuBomb = 1
        play sound SndBird
      end if
    case 1
      Score += 10
      BuOn = 0
      Respawn
      play sound SndBird
    case 2 to 5
      Score += 5
      BuOn = 0
      Respawn
      play sound SndDent
    case else
      BuOn = 0
  end select
  ShowScore
  return
end sub

sub Respawn:
  Ob[Oi].X = RandX()
  Ob[Oi].Y = YTop
  return
end sub

' the mothership is hit: 5000 points, a new wave after a pause
sub WinWave:
  for Ds = 1 to 5
    Score += 90
  next
  Score += 50
  ShowScore
  inc Waves
  Won = 1
  Freeze = 90
  BoomX = 120
  BoomY = 16
  fill 32 count 4 at 14,2
  fill 32 count 4 at 14,3
  play sound SndMs
  return
end sub

' everything that falls: bomb, bird, four aliens (and the smartbomb)
sub MoveAll:
  u16 Sp = 0
  u16 Oy = 0
  u16 Ox = 0
  for Oi = 0 to NLast
    Oy = Ob[Oi].Y
    Ox = Ob[Oi].X
    select case Oi
      case 0
        Sp = SpBo
      case 1
        Sp = SpBi
      case 6
        Sp = SpSm
      case else
        Sp = SpAl
    end select
    Oy = Oy + Sp
    if Oi >= 2 then
      if Oy >= YTop then
        ' home in on the ship (the smartbomb at 3/4 of the ship's speed)
        if Oi = 6 then Sp = SpSh
        if Ox < PX then
          Ox = Ox + Sp
          if Ox > PX then Ox = PX
        else
          if Ox > PX then
            W16 = Ox - PX
            if W16 < Sp then
              Ox = PX
            else
              Ox = Ox - Sp
            end if
          end if
        end if
      end if
    end if
    Ob[Oi].Y = Oy
    Ob[Oi].X = Ox
    if Oy >= YLand then Landed
  next
  return
end sub

' thing Oi reaches the ship's row: on the ship it costs a ship
sub Landed:
  if Freeze = 0 then
    if Near(Ob[Oi].X, PX, 8) = 1 then
      dec Lives
      inc Deaths
      Freeze = 45
      W16 = PX >> 5
      BoomX = W16
      BoomY = 151
      BuOn = 0
      play sound SndHit
      ShowLives
    end if
  end if
  if Oi = 0 then
    Ob[0].X = PX
    Ob[0].Y = YTop
    play sound SndWhistle
  else
    Respawn
  end if
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' sprites 0-1 the ship, 2 the laser, 3 the bomb, 4 the bird, 5-8 the
' aliens, 9 the smartbomb, 10 a blast
sub DrawSprites:
  u16 Oy = 0
  W16 = PX >> 5
  X = W16
  set sprite 0 to 151,X,SShipd,15
  set sprite 1 to 151,X,SShipb,7
  if BuOn = 1 then
    W16 = BuY >> 5
    Y = W16
    set sprite 2 to Y - 1,BuX,SShot,11
  else
    set sprite 2 to 192,0,0,0
  end if
  V = Tick >> 4
  V = V & 1
  for Ds = 0 to 6
    K = Ds + 3
    Oy = Ob[Ds].Y >> 5
    if Ds > NLast then Oy = 0
    if Oy >= 72 then
      Y = Oy
      W16 = Ob[Ds].X >> 5
      X = W16
      select case Ds
        case 0
          C = SBomb
        case 1
          C = SBird0 + V * 4
        case 6
          C = SSm0 + V * 4
        case else
          C = SAl0 + V * 4
      end select
      set sprite K to Y - 1,X,C,ObCol[Ds]
    else
      set sprite K to 192,0,0,0
    end if
  next
  if Freeze > 0 then
    K = Freeze >> 3
    K = K & 1
    K = K * 4 + SBoom0
    set sprite 10 to BoomY,BoomX,K,11
  else
    set sprite 10 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowScore:
  if Score > Hi then Hi = Score
  print at 8,1, Score
  print at 22,1, Hi
  return
end sub

' the ships in reserve, bottom left
sub ShowLives:
  fill 32 count 6 at 2,22
  if Lives > 1 then
    V = Lives - 1
    fill TLife count V at 2,22
  end if
  return
end sub

' a new wave: the mothership, the full wall, everything at the top, the
' ship at the left (as the C64 did)
sub NewWave:
  Rearm
  wait
  nmi off
  for Wr = 0 to 1
    for Wc = 0 to 3
      put char TMs00 + Wr * 4 + Wc at Wc + 14,Wr + 2
    next
  next
  fill array Wall with 3
  for Wr = 0 to 3
    Y = Wr + 5
    fill TDr3 count 28 at 2,Y
  next
  for Oi = 0 to 6
    Ob[Oi].X = RandX()
    Ob[Oi].Y = YTop
  next
  Ob[3].Y = YTop - 640
  Ob[4].Y = YTop - 1280
  Ob[5].Y = YTop - 1920
  PX = XMin
  BuOn = 0
  Won = 0
  return
end sub

sub NewGame:
  NewScreen
  for Wr = 0 to 10
    Y = Wr + 9
    W16 = Wr * 28
    copy StarMap + W16 count 28 to vram.name + Y * 32 + 2
  next
  fill TGnd count 32 at 0,21
  print at 2,1, "SCORE"
  print at 14,1, "0"
  print at 19,1, "HI"
  print at 28,1, "0"
  Rr = LvR[Lv]
  SpPl = Scale(BaseSp[0])
  SpBu = Scale(BaseSp[1])
  SpBo = Scale(BaseSp[2])
  SpBi = Scale(BaseSp[3])
  SpAl = Scale(BaseSp[4])
  SpSm = Scale(BaseSp[5])
  SpSh = Scale(BaseSp[6])
  if Lv < 5 then
    Lives = 5
  else
    Lives = 3
  end if
  NumU = Lv
  print at 21,22, "LEVEL ", digits$(NumU, 1)
  Score = 0
  SmartOn = 0
  NLast = 5
  Freeze = 0
  Over = 0
  Waves = 0
  Deaths = 0
  Shots = 0
  ShowScore
  ShowLives
  NewWave
  DrawSprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 10
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: ALIEN ARMADA in big letters over the stars, START / LEVEL /
' CREDITS, the best score, the tune once
sub TitlePage:
  NewScreen
  copy TitleMap count 448 to vram.name + 32
  print at 2,15, "COMPUTE!'S GAZETTE MAY 1985"
  print at 9,16, "BY JOHN MATIAS"
  print at 12,18, "START"
  print at 12,19, "LEVEL"
  print at 12,20, "HOW TO PLAY"
  print at 12,21, "CREDITS"
  ShowLevelChoice
  if Hi > 0 then
    print at 9,22, "BEST ", Hi, "0"
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then TitleStick
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then HowToPage
  if Menu = 3 then CreditsPage
  return
end sub

sub TitleStick:
  select case V
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 3 then inc Menu
    case 4
      if Lv > 0 then dec Lv
    case 8
      if Lv < 9 then inc Lv
  end select
  ShowMenu
  ShowLevelChoice
  return
end sub

sub ShowLevelChoice:
  NumU = Lv
  print at 18,19, digits$(NumU, 1)
  return
end sub

sub ShowMenu:
  for J = 18 to 21
    put char 32 at 10,J
  next
  J = Menu + 18
  put char 62 at 10,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    ' the mothership over a wall with a hole dug under it
    for Wr = 0 to 1
      for Wc = 0 to 3
        put char TMs00 + Wr * 4 + Wc at Wc + 14,Wr + 3
      next
    next
    fill TDr3 count 20 at 6,5
    fill TDr3 count 20 at 6,6
    put char TDr1 at 15,5
    put char TDr2 at 16,5
    put char 32 at 15,6
    put char TDr1 at 16,6
    set sprite 0 to 71,112,SShipd,15
    set sprite 1 to 71,112,SShipb,7
    set sprite 2 to 54,119,SShot,11
    print at 2,11, "SHOOT A HOLE IN THE WALL OF"
    print at 2,12, "DROIDS UNDER THE MOTHERSHIP,"
    print at 2,13, "THEN HIT THE MOTHERSHIP TO"
    print at 2,14, "WIN THE WAVE. EACH DROID"
    print at 2,15, "TAKES 3 HITS."
    print at 2,17, "STICK LEFT/RIGHT: MOVE."
    print at 2,18, "BUTTON: FIRE (HOLD IT DOWN"
    print at 2,19, "TO KEEP FIRING)."
  else
    set sprite 3 to 19,24,SBomb,9
    set sprite 4 to 35,24,SBird0,15
    set sprite 5 to 51,24,SAl0,3
    set sprite 6 to 67,24,SSm0,8
    print at 6,3, "BOMB          10"
    print at 6,5, "BIRD         100"
    print at 6,7, "ALIEN         50"
    print at 6,9, "SMARTBOMB: SHOTS"
    print at 6,10, "CAN'T STOP IT. RUN!"
    put char TDr3 at 3,12
    print at 6,12, "DROID HIT     50"
    print at 6,13, "MOTHERSHIP  5000"
    print at 2,15, "IF ANYTHING LANDS ON YOUR"
    print at 2,16, "SHIP, YOU LOSE A SHIP. NO"
    print at 2,17, "SHIPS LEFT: GAME OVER."
    print at 2,19, "TIP: BOMBS DROP WHERE YOU"
    print at 2,20, "STAND. KEEP MOVING!"
  end if
  print at 9,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_loop:
  Frame1
  inc Rs
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 9,2, "ALIEN ARMADA"
  print at 2,5, "BASED ON ALIEN ARMADA BY"
  print at 2,6, "JOHN MATIAS, COMPUTE!'S"
  print at 2,7, "GAZETTE MAY 1985 (C64 AND"
  print at 2,8, "VIC-20 MACHINE LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: GORG FLEET"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

