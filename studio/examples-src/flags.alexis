' random numbers: a 16-bit xorshift, stirred on the title every frame

sub MixSeed:
  Seed ^= Seed << 7
  Seed ^= Seed >> 9
  Seed ^= Seed << 8
  return
end sub

function RndBelow(u8 Lim) as u8
  u8 Lo = 0
  MixSeed
  Lo = highbyte(Seed)
  return Lo % Lim

' a flag not asked since the last reset (AA() in the listing)
function PickFlag as u8
  u8 Left = 0
  u8 Pk = 0
  u8 Fi = 0
  for Fi = 0 to 40
    if Used[Fi] = 0 then inc Left
  next
  if Left = 0 then
    fill array Used with 0
    Left = NFlags
  end if
  Pk = RndBelow(Left)
  for Fi = 0 to 40
    if Used[Fi] = 0 then
      if Pk = 0 then
        Used[Fi] = 1
        Lf = Fi
      end if
      dec Pk
    end if
  next
  return Lf

