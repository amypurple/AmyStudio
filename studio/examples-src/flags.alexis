asm {
FgStep:
    db $40,$71,$30,$02,$50
FgTick:
    db $40,$FE,$40,$02,$50
FgRight:
    db $40,$D6,$10,$03,$40,$AA,$10,$03,$40,$8F,$10,$03,$40,$6B,$10,$03,$40,$55,$10,$0A,$50
FgWrong:
    db $40,$8D,$13,$0E,$40,$F9,$23,$0E,$50
FgEnd:
    db $40,$8F,$10,$08,$40,$71,$10,$08,$40,$5F,$10,$08,$40,$47,$10,$18,$50

FgSoundTable:
    dw FgTuneMel,$702B
    dw FgTuneBass,$7035
    dw FgStep,$7049
    dw FgTick,$7049
    dw FgRight,$7049
    dw FgWrong,$7049
    dw FgEnd,$7049
; Many Banners (original)
; Tiny Sound, 9 frames per step
FgTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$60,$F1,$22,$1F,$01,$24,$01,$28,$01,$26,$24,$23,$01,$26,$01
    db $1F,$01,$01,$01,$21,$01,$26,$01,$29,$01,$28,$26,$24,$01,$28,$01
    db $26,$01,$01,$01,$28,$01,$2B,$01,$28,$24,$26,$28,$29,$01,$26,$01
    db $23,$01,$1F,$01,$24,$01,$23,$26,$24,$01,$1F,$01,$24,$01,$01,$01
    db $00,$01
    db $FF
FgTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$18,$32,$0C,$01,$13,$01,$0C,$01,$13,$01,$07,$01,$0E,$01
    db $13,$01,$0E,$01,$05,$01,$0C,$01,$11,$01,$0C,$01,$07,$01,$0E,$01
    db $13,$01,$0E,$01,$0C,$01,$13,$01,$09,$01,$10,$01,$05,$01,$0C,$01
