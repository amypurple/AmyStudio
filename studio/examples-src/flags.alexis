  FrameN(90)
  if Mode = 1 then
    if Round < Rounds1P then goto pg_next
  else
    if Pl[0].Score <= WinScore then
      if Pl[1].Score <= WinScore then goto pg_next
    end if
  end if
  GameEnd
  return
end sub

' one flag: draw, three names, wait for an answer or the end of the count
sub AskOne:
  u8 A1 = 0
  u8 A2 = 0
  u8 Sw = 0
  Q = PickFlag
  A1 = Q
  while A1 = Q
    A1 = RndBelow(NFlags)
  end while
  A2 = Q
  while A2 = Q or A2 = A1
    A2 = RndBelow(NFlags)
  end while
  Ans[0] = Q
  Ans[1] = A1
  Ans[2] = A2
  ' the listing's three random swaps (lines 440-460)
  for Sw = 0 to 2
    if RndBelow(2) = 1 then
      J = Sw
      K = (Sw + 1) % 3
      V = Ans[J]
      Ans[J] = Ans[K]
      Ans[K] = V
    end if
  next
  Rearm
  wait
  nmi off
  HideSprites
  for Ci = 16 to 22
    fill 32 count 28 at 2,Ci
  next
  DrawFlag(Q)
  for Ci = 0 to 2
    PrintName(Ans[Ci], ChoiceCol, ChoiceRow + Ci)
  next
  if Mode = 1 then
    print at 8,22, "QUESTION ", RoundB, " OF 10"
  else
    print at 7,22, "FIRST PAST 5000 WINS"
  end if
  T = 15
  Sub60 = 0
  Who = 255
  Pl[0].Cur = 0
  Pl[1].Cur = 0
  Pl[0].Ay = ChoiceRow * 8 - 1
  Pl[1].Ay = ChoiceRow * 8 - 1
  ShowTimer
  GState = 2
ask_loop:
  Frame1
  ReadPads
  for Pi = 0 to 1
    MovePlayer(Pi)
  next
  DrawArrows
  if Who < 2 then goto ask_done
  inc Sub60
  if Sub60 >= SecFrames then
    Sub60 = 0
    if T = 0 then goto ask_late
    dec T
    play sound SndTick
    ShowTimer
  end if
  goto ask_loop
ask_late:
  GState = 3
  Got = 2
  play sound SndWrong
  print at 2,17, "TIME UP! IT WAS"
  PrintName(Q, 18, 17)
  return
ask_done:
  GState = 3
  Judge
  return
end sub

' one player's stick and button; Who = the first player to press
sub MovePlayer(u8 P):
  u8 S = 0
  u8 B = 0
  u8 Moved = 0
  if P = 0 then
    S = J1 & 3
    B = J1 & 16
    if Mode = 1 then
      S = (J1 | J2) & 3
      B = (J1 | J2) & 16
    end if
  else
    if Mode = 1 then return
    S = J2 & 3
    B = J2 & 16
  end if
  if B > 0 then
    if Pl[P].WasB = 0 then
      if Who = 255 then Who = P
    end if
  end if
  Pl[P].WasB = B
  if S = 0 then
    Pl[P].Rep = 0
    Pl[P].WasS = 0
    return
  end if
  if S = Pl[P].WasS then
    inc Pl[P].Rep
    if Pl[P].Rep >= RepFirst then
      Pl[P].Rep = RepFirst - RepNext
      Moved = 1
    end if
  else
    Pl[P].Rep = 0
    Moved = 1
  end if
  Pl[P].WasS = S
  if Moved = 0 then return
  ' up and down wrap round, as in the listing (lines 620-650)
  if S = 1 then
    if Pl[P].Cur = 0 then
      Pl[P].Cur = 2
    else
      dec Pl[P].Cur
    end if
  else
    inc Pl[P].Cur
    if Pl[P].Cur > 2 then Pl[P].Cur = 0
  end if
  play sound SndStep
  return
end sub

' arrows glide to their rows
sub DrawArrows:
  u8 Goal = 0
  u8 Ny = 0
  for Ci = 0 to 1
    Goal = (ChoiceRow + Pl[Ci].Cur) * 8 - 5
    Ny = Pl[Ci].Ay
    if Ny < Goal then Ny = Ny + 2
    if Ny > Goal then Ny = Ny - 2
    Pl[Ci].Ay = Ny
  next
  set sprite 0 to Pl[0].Ay, 56, SAr1, 11
  if Mode = 2 then
    set sprite 1 to Pl[1].Ay, 176, SAr2, 7
  else
    set sprite 1 to 192, 0, 0, 0
  end if
  update sprites
  return
end sub

' the answer of player Who (lines 720-850)
sub Judge:
  u8 Pick = 0
  u16 Sc = 0
  Pick = Ans[Pl[Who].Cur]
  K = ChoiceRow + Pl[Who].Cur
  print at 9,K, "*"
  print at 22,K, "*"
  Sc = Pl[Who].Score
  if Pick = Q then
    Got = 1
    Gain = T * 50
    Sc = Sc + Gain
    play sound SndRight
    if Mode = 1 then
      print at 11,17, "CORRECT!"
    else
      NumU = Who + 1
      print at 5,17, "PLAYER ", digits$(NumU, 1), " IS CORRECT!"
    end if
  else
    Got = 0
    Gain = T * 30
    if Gain > Sc then
      Sc = 0
    else
      Sc = Sc - Gain
    end if
    play sound SndWrong
    print at 2,17, "WRONG! IT WAS"
    PrintName(Q, 16, 17)
  end if
  Pl[Who].Score = Sc
  return
end sub

sub ShowTimer:
  NumU = T
  print at 15,1, digits$(NumU, 2)
  return
end sub

sub ShowScores:
  NumU = Pl[0].Score
  print at 5,1, digits$(NumU, 4)
  if Mode = 2 then
    NumU = Pl[1].Score
    print at 26,1, digits$(NumU, 4)
  end if
  return
end sub

sub GameEnd:
  GState = 4
  HideSprites
  Rearm
  wait
  nmi off
  for Ci = 16 to 22
    fill 32 count 28 at 2,Ci
  next
  play sound SndEnd
  print at 11,18, "GAME OVER!"
  if Mode = 1 then
    NumU = Pl[0].Score
    print at 8,20, "YOUR SCORE ", digits$(NumU, 4)
  elseif Pl[0].Score > Pl[1].Score then
    print at 8,20, "PLAYER 1 WINS!"
  elseif Pl[1].Score > Pl[0].Score then
    print at 8,20, "PLAYER 2 WINS!"
  else
    print at 11,20, "A TIE!"
  end if
  return
end sub

sub QuizPage:
  NewScreen
  print at 2,1, "P1"
  print at 12,1, "T"
  if Mode = 2 then print at 23,1, "P2"
  ShowScores
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------------
' learn mode (lines 900-1040)

sub LearnMode:
  u8 Lstick = 0
  GState = 5
  NewScreen
  print at 9,1, "LEARN FLAGS"
  print at 2,20, "LEFT/RIGHT: ANOTHER FLAG"
  print at 2,21, "BUTTON: BACK TO THE MENU"
  Q = 0
  LearnShow
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasStick = 0
lm_loop:
  Frame1
  ReadPads
  Lstick = (J1 | J2) & 12
  if Lstick <> WasStick then
    if Lstick = 8 then
      inc Q
      if Q >= NFlags then Q = 0
      LearnShow
    elseif Lstick = 4 then
      if Q = 0 then
        Q = NFlags - 1
      else
        dec Q
      end if
      LearnShow
    end if
  end if
  WasStick = Lstick
  if AnyPress = 0 then goto lm_loop
  return
end sub

sub LearnShow:
  play sound SndStep
  DrawFlag(Q)
  fill 32 count 28 at 2,17
  PrintName(Q, 10, 17)
  NumU = Q + 1
  print at 13,18, digits$(NumU, 2), "/41"
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' name of flag F, 12 characters, at C,R
sub PrintName(u8 F, u8 C, u8 R):
  u16 No = 0
  u16 Va = 0
  No = F
  No = No * 12
  Va = R
  Va = Va * 32 + C
  copy FlagName + No count 12 to vram.name + Va
  return
end sub

' flag F inside its frame, rows 3-14, centred on columns 6-25
sub DrawFlag(u8 F):
  u8 Fw = 0
  u8 X0 = 0
  u8 Fr = 0
  u16 Mo = 0
  u16 So = 0
  u8 Cnt = 0
  u16 Va = 0
  Fw = FlagW[F]
  X0 = 6 + (20 - Fw) / 2
  for Fr = 2 to 15
    fill 32 count 22 at 5,Fr
  next
  ' this flag's own tiles to codes SpecBase.. (pattern thirds 0 and 1)
  So = FlagSpecOfs[F]
  ' a u8 count: a u16 count variable copies from the wrong place
  ' (bugs/flags-copy-vram-u16-count.alexis)
  Cnt = FlagNSpec[F] * 8
  if Cnt > 0 then
    copy SpecPat + So count Cnt to vram.pattern + SpecBase * 8
    copy SpecPat + So count Cnt to vram.pattern + 2048 + SpecBase * 8
    copy SpecCol + So count Cnt to vram.color + SpecBase * 8
  end if
  Mo = FlagOfs[F]
  for Fr = 0 to 11
    Va = Fr + 3
    Va = Va * 32 + X0
    copy FlagMap + Mo count Fw to vram.name + Va
    Mo = Mo + Fw
  next
  put char TFtl at X0 - 1,2
  fill TFrh count Fw at X0,2
  put char TFtr at X0 + Fw,2
  for Fr = 3 to 14
    put char TFrl at X0 - 1,Fr
    put char TFrr at X0 + Fw,Fr
  next
  put char TFbl at X0 - 1,15
  fill TFrb count Fw at X0,15
  put char TFbr at X0 + Fw,15
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndTuneA
    stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub FrameN(u8 Nf):
  u8 Fi = 0
  for Fi = 1 to Nf
    Frame1
  next
  return
end sub

' J1/J2: 1 up, 2 down, 4 left, 8 right, 16 button; AnyPress: a new press
' on either controller
sub ReadPads:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = (J1 | J2) & 16
  AnyPress = 0
  if V > 0 then
    if WasAny = 0 then AnyPress = 1
  end if
  WasAny = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  set sprite 0 to 192,0,0,0
  set sprite 1 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  backdrop black
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a flag, the menu, the tune once
sub TitlePage:
  GState = 1
  NewScreen
  print at 11,1, "F L A G S"
  inc Mix8
  Q = (Seed + Mix8) % NFlags
  DrawFlag(Q)
  print at 9,17, "LEARN FLAGS"
  print at 9,18, "ONE PLAYER"
  print at 9,19, "TWO PLAYERS"
  print at 9,20, "CREDITS"
  print at 4,22, "COMPUTE'S GAZETTE 1/90"
  ShowMenu
  TitleOn = 1
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 558
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 0
tp_loop:
  Frame1
  MixSeed
  ReadPads
  K = (J1 | J2) & 3
  if K <> WasStick then
    if K = 1 then
      if Menu > 0 then dec Menu
    end if
    if K = 2 then
      if Menu < 3 then inc Menu
    end if
    ShowMenu
  end if
  WasStick = K
  if AnyPress = 0 then goto tp_loop
  mute all
  TzOn = 0
  TitleOn = 0
  Mode = 1
  if Menu = 2 then Mode = 2
  return
end sub

sub ShowMenu:
  for Ci = 17 to 20
    put char 32 at 7,Ci
  next
  J = Menu + 17
  put char 62 at 7,J
  return
end sub

sub CreditsPage:
  GState = 6
  NewScreen
  print at 11,2, "F L A G S"
  print at 2,5, "BASED ON FLAGS, COMPUTE'S"
  print at 2,6, "GAZETTE DISK, JANUARY 1990"
  print at 2,7, "(COMMODORE 64, BASIC)."
  print at 2,10, "COLECOVISION GAME, MUSIC"
  print at 2,11, "AND PICTURES BY CLAUDE"
  print at 2,12, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,13, "IN AMY BY AMY BIENVENU,"
  print at 2,14, "2026."
  print at 2,16, "FLAGS AS FLOWN IN 1990."
  print at 2,18, "MUSIC: MANY BANNERS"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

