cartridge "BEE TRAP/ROBERT L. LYKINS, COMPUTE!/1983"

' BEE TRAP
' The game by Robert L. Lykins from COMPUTE!, June 1983 (pages 102-110,
' for the VIC-20, the Atari and the TRS-80 Color Computer), for the
' ColecoVision in Amy by Amy Bienvenu. Ported by Claude (an AI made by
' Anthropic) for Amy Studio, 2026.
'
' Source: Program 1, the VIC-20 version, transcribed in
' orig/beetrap-vic.bas from the scan beside it (p106.png). The Atari and
' Color Computer listings (p108.png, p110.png) were read for the intent
' only (their GOOD LUCK!!! settles the scan's "GOOD LUCK!?!").
'
' The game: you are a guide bee. Lost bees come up one at a time from
' below the field; touch one (or let it find you) and carry it up to the
' flower bed along the top for one credit. Entering the flowers with no
' bee costs a credit. Venus Bee Traps (the clubs) bloom at random; a bee
' that touches one, lost or guide, is zapped and counts as lost. Every
' bee caught makes the next ones livelier and the buzz lower. When 50
' bees are lost the game ends with your final credit.
'
' Controls (either joystick): the stick moves the guide bee (held, a step
' every pass; the button held with a direction stops it, as on the VIC);
' the button alone starts, and replays after the final credit; the stick
' down there stops (the VIC's S key). Keypad not used.
'
' The VIC-20's screen (22 x 23) is kept cell for cell, at columns 5-26 and
' rows 1-23. The game keeps its positions as the listing's screen offsets
' (K1+D1 for the guide bee, K-D2 for the lost bee: 7680 is offset 0) and
' reads its screen back as the listing PEEKs (Peek); a lost bee below the
' screen (offsets 506 and up, K = 8248 is three rows down) is drawn
' nowhere and PEEKs a space. Labels such as l305 are the listing's line
' numbers. Each VIC character and colour is a tile (art.py); the tiles
' are transparent and the backdrop is the VIC's screen colour (POKE Q).
'
' Fixed (clear bugs of the listing; each fix is marked where it is):
' - the lost bee on screen was left behind as a picture when a credit was
'   paid or the guide bee was zapped (D2=0 without erasing it), and that
'   picture still PEEKed as a bee that could be caught again: it is now
'   erased;
' - lines 345 and 1100 put the screen's normal colour back even after
'   line 1075's warning colour (more than 40 bees lost): the warning now
'   stays;
' - the credit line was printed over the last one, its number followed
'   by a cursor-right, so a shorter line kept letters of the longer one
'   ("FINAL CREDIT 3EBEES"): the line is wiped first.
' Kept as the listing has them:
' - the credit line is printed over the field (row 2), and the guide bee
'   starts on its digit and wipes it at its first move;
' - the guide bee caught by a trap goes on from there (and wipes the
'   trap); being caught yourself only loses one bee, as the code does
'   (the article says it ends your commission);
' - traps can bloom on a bee or on the credit line.
'
' Liberties taken:
' - Timing: a pass of the main loop (lines 305-600) is 3 frames; the
'   empty FOR loops are 15 passes a frame (10999 is 733 frames, 2000 is
'   133); the zap and the end sweep 36 frames, the credit sound 25.
' - The VIC's border and screen colours are one backdrop (the screen's);
'   the multicolour bees' border-coloured dots take the border's colour.
' - The buzz is one voice, its pitch from H raised by octaves into the
'   PSG's range (s.mjs); the alto's 70-85 Hz hum is not kept.
' - The instructions' {DOWN}s are laid out as meant: a line, an empty
'   row; "PLUG IN JOYSTICK" is kept.
' - The final page's "HIT S TO STOP, PRESS FIREBUTTON TO REPLAY" names
'   the button and the stick down.
' - A credits page with an original tune (Flower Bed) played once.
'
' House rules kept: text in columns 2-29; tiles from 128; no sprites; the
' frame loop is protected from the NMI and every screen is drawn with the
' NMI off after a wait. (The VIC's field reaches row 23, its last row.)

const TFl0 = 128
const TFl1 = 129
const TFl2 = 130
const TFl3 = 131
const TFl4 = 132
const TFl5 = 133
const TFl6 = 134
const TFl7 = 135
const TGd = 136
const TLs = 137
const TTr = 138
const TT0 = 139
const TT1 = 140
const TT2 = 141
const TT3 = 142
const TT4 = 143
const TT5 = 144
const TT6 = 145
const TT7 = 146
const TT8 = 147
const TT9 = 148
const TT10 = 149
const TT11 = 150
const TT12 = 151
const TT13 = 152
const TT14 = 153
const TT15 = 154
const TT16 = 155
const TT17 = 156
const TT18 = 157
const TT19 = 158
const TT20 = 159
const TT21 = 160
const TT22 = 161
const TT23 = 162
const TT24 = 163
const TT25 = 164
const TT26 = 165
const TT27 = 166
const TT28 = 167
const TT29 = 168
const TT30 = 169
const TT31 = 170
const TT32 = 171
const TT33 = 172
const TT34 = 173
const TT35 = 174
const TT36 = 175
const TT37 = 176
const TT38 = 177
const TT39 = 178
const TT40 = 179
const TT41 = 180
const TT42 = 181
const TT43 = 182
const TT44 = 183
const TT45 = 184
const TT46 = 185
const TT47 = 186
const TT48 = 187
const TT49 = 188
const TT50 = 189
const TT51 = 190
const TT52 = 191
const TT53 = 192
const TT54 = 193
const TT55 = 194
const TT56 = 195
const TT57 = 196
const TT58 = 197
const TT59 = 198
const TT60 = 199
const TT61 = 200
const TT62 = 201
const TT63 = 202
const TT64 = 203
const NTiles8 = 608
const SprBytes = 0
const SndHush = 1
const SndBuzz0 = 2
const SndBuzz1 = 3
const SndBuzz2 = 4
const SndBuzz3 = 5
const SndBuzz4 = 6
const SndBuzz5 = 7
const SndBuzz6 = 8
const SndBuzz7 = 9
const SndBuzz8 = 10
const SndBuzz9 = 11
const SndBuzz10 = 12
const SndBuzz11 = 13
const SndZap = 14
const SndGain = 15
const SndOver = 16
const SndTuneA = 17
const SndTuneB = 18

' --- the listing's variables ----------------------------------------------
' D1 the guide bee's offset from K1 (55), D2 the lost bee's back from K
' (568), S bees carried, SC the credit, H the buzz (and the lost bees'
' pace), X the lost bee's last draw, R bees lost, Qc the screen colour
' (POKE 36879)
i16 D1 = 0
i16 D2 = 0
u8 S = 0
i16 SC = 0
u8 H = 240
u8 X = 0
u8 R = 0
u8 Qc = 0
' for the test bot: Ph 0 credits, 1 title pages, 2 play, 3 final page;
' Pass counts the passes of line 305; Js the stick read (0 none, 1 right,
' 2 up, 3 down, 4 left); Gm the games; Rs0 X0 the generator and X when
' the game began; Ev the last event (1 credit, 2 empty, 3 zap)
u8 Ph = 0
u16 Pass = 0
u8 Js = 0
' Jp the stick read by the last pass of the main loop
u8 Jp = 0
u8 Gm = 0
u16 Rs0 = 0
u8 X0 = 0
u8 Ev = 0
' Ip 1 while the pass is done and the next one waits its frames
u8 Ip = 0

i16 Ao = 0
i16 Gp = 0
i16 Lp = 0
u16 Ad = 0
u16 Uo = 0
u16 Ur = 0
u16 Uw = 0
u8 Pk = 0
u8 Bd = 0
u8 V = 0
u8 W = 0
u8 J8 = 0
u8 Up = 0
u8 Dn = 0
u8 Lf = 0
u8 Rt8 = 0
u8 Fr = 0
u8 Any = 0
u8 Tick = 0
u16 Ti = 0
u16 Tp = 0
u16 W16 = 0
u16 Nn = 0
i16 Ns = 0
u32 Uq = 0
u32 Uq2 = 0
u16 Rs = $3A61
u16 Rt = 0
u16 Rw = 0
u16 Rv = 0

  tile screen
  set sound table BtSoundTable areas 4
  nmi off
  screen on

credits:
  CreditsPage

l20:
  ' 20-40: "PLUG IN JOYSTICK", white on blue (POKE Q,110)
  Ph = 1
  NewScreen($F0)
  SetQ(110)
  print at 7,7, "PLUG IN JOYSTICK"
  print at 7,10, "PRESS FIRE BUTTON"
  ShowScreen
  WaitFire

l50:
  ' 50-60: the title three times down the screen, on green, yellow, red
  NewScreen($F0)
  SetQ(93)
  print at 10,4, "B E E   T R A P"
  print at 8,7, "B E E   T R A P"
  print at 6,10, "B E E   T R A P"
  ShowScreen
  SetQ(127)
  Delay(733)
  SetQ(42)
  Delay(133)

l80:
  ' 80-130: the instructions, black on red
  NewScreen($10)
  print at 5,1, "YOU ARE A GUIDE BEE"
  print at 5,3, "COMMISSIONED BY THE"
  print at 5,5, "QUEEN BEE TO TAKE LOST"
  print at 5,7, "BEES SAFELY TO THE"
  print at 5,9, "FLOWER BED. YOU WILL"
  print at 5,11, "GET CREDIT FOR ONLY 1"
  print at 5,13, "BEE AT A TIME. BEWARE"
  print at 5,15, "THE LOVELY VENUS BEE"
  print at 5,17, "TRAPS WHICH BLOOM PRO-"
  print at 5,19, "FUSELY ACROSS THE"
  print at 5,21, "FIELD."
  copy GLuck count 12 to vram.name + 684
  ShowScreen
  Delay(13)
  copy WPress count 17 to vram.name + 710
  WaitFire

l150:
  ' 150-225: a new game; the flowers in random colours
  Rs0 = Rs
  X0 = X
  inc Gm
  H = 240
  SC = 0
  S = 0
  D1 = 0
  D2 = 0
  R = 0
  Ev = 0
  NewScreen($F0)
  SetQ(191)
  for J8 = 0 to 43
    RndK(8)
    Ao = J8
    V = lowbyte Rv
    V = V + TFl0
    Poke(V)
  next
  ShowScreen
  Ph = 2
  Tp = Ti

l305:
  ' one pass of the main loop: 3 frames
  ' (at least a frame between passes, even after a long event)
  Ip = 1
  Frame1
pace:
  W16 = Ti - Tp
  if W16 < 3 then
    Frame1
    goto pace
  end if
  Ip = 0
  Tp = Ti
  inc Pass
  ' 305: erase the guide bee; 312-330: the stick
  Ao = 55 + D1
  Poke(32)
  ReadStick
  Jp = Js
  if Js = 1 then D1 = D1 + 1
  if Js = 2 then D1 = D1 - 22
  if Js = 3 then D1 = D1 + 22
  if Js = 4 then D1 = D1 - 1
  Gp = 55 + D1
  ' 335: kept on the screen
  if Gp > 505 then
    D1 = 450
    Gp = 505
  end if
  ' 340-345: into the flowers, with a bee or without
  if Gp < 44 then
    if S > 0 then goto l2000
    D1 = 0
    Gp = 55
    Ev = 2
    SetQ(110)
    Delay(133)
    SC = SC - 1
    Normal
  end if
  ' 350: a trap blooms
  if D2 < 50 then
    if X < 2 then
      RndK(351)
      Ao = Rv
      Ao = Ao + 99
      Poke(TTr)
    end if
  end if
  ' 360-380: the guide bee meets a lost bee, or a trap, or moves on
  Ao = Gp
  Peek
  if Pk >= TFl0 then
    if Pk <= TLs then
      D2 = 0
      inc S
      H = H - 10
    end if
  end if
  if Pk = TTr then
    ' (fixed: the listing leaves the lost bee's picture behind)
    Ao = 568 - D2
    Poke(32)
    goto l1000
  end if
  Ao = Gp
  Poke(TGd)
  ' 430-450: the buzz
  if H < 130 then H = 240
  Buzz
  ' 505-590: the lost bee
  Ao = 568 - D2
  Poke(32)
  V = H / 5
  V = V - 22
  RndK(V)
  X = lowbyte Rv
  if X < 3 then D2 = D2 + 22
  if X = 3 then D2 = D2 + 1
  if X = 4 then D2 = D2 + 1
  if X = 5 then D2 = D2 - 1
  Lp = 568 - D2
  if Lp < 44 then D2 = 0
  Ao = 568 - D2
  Peek
  if D2 > 62 then
    if Pk >= TFl0 then
      if Pk <= TLs then
        D2 = 0
        inc S
        H = H - 10
      end if
    end if
  end if
  Ao = 568 - D2
  Peek
  if Pk = TTr then goto l1000
  Ao = 568 - D2
  Poke(TLs)
  goto l305

l1000:
  ' 1000-1100: a bee zapped (yours or the lost one)
  Ev = 3
  SetQ(42)
  play sound SndZap
  Delay(36)
  D2 = 0
  inc R
  if R = 50 then goto l3000
  Normal
  goto l305

l2000:
  ' 2000-2300: a bee brought to the flowers: one credit
  Ev = 1
  SetQ(127)
  SC = SC + 1
  ' (fixed: the lost bee on screen is erased, the old credit line wiped)
  Ao = 568 - D2
  Poke(32)
  Ao = 48
  Blank(17)
  Ao = 48
  PrintCredit(0)
  play sound SndGain
  Delay(25)
  S = 0
  D1 = 0
  D2 = 0
  Normal
  goto l305

l3000:
  ' 3000-3420: 50 bees lost: the final credit
  SetQ(10)
  play sound SndOver
  Delay(36)
  play sound SndHush
  Ip = 0
  Ph = 3
  Ao = 45
  Blank(20)
  Ao = 45
  PrintCredit(1)
  print at 5,5, " FIRE: PLAY AGAIN"
  print at 5,6, " STICK DOWN: STOP"
  WaitLetGo
l3403:
  Frame1
  ReadStick
  if Dn = 1 then goto credits
  if Fr = 1 then
    if Any = 0 then goto l150
  end if
  goto l3403

' PrintCredit: "CREDIT" (Fin 0, red, at offset Ao) or "FINAL CREDIT"
' (Fin 1, cyan), SC as BASIC prints a number (a space or "-", the digits,
' then a cursor-right that leaves its cell alone), then BEE or BEES
sub PrintCredit(u8 Fin):
  if Fin = 0 then
    for J8 = 0 to 5
      V = RCredit[J8]
      Poke(V)
      inc Ao
    next
  else
    for J8 = 0 to 11
      V = CFinal[J8]
      Poke(V)
      inc Ao
    next
  end if
  W = 0
  if SC < 0 then W = 1
  if Fin = 0 then
    V = RSp[W]
  else
    V = CSp[W]
  end if
  Poke(V)
  inc Ao
  Ns = SC
  if Ns < 0 then Ns = 0 - Ns
  Nn = Ns
  ' the digits, most significant first
  W16 = 10000
  W = 0
  for J8 = 0 to 4
    V = 0
    while Nn >= W16
      Nn = Nn - W16
      inc V
    end while
    if V > 0 then W = 1
    if J8 = 4 then W = 1
    if W = 1 then
      if Fin = 0 then
        V = V + TRd0
      else
        V = V + TCd0
      end if
      Poke(V)
      inc Ao
    end if
    W16 = W16 / 10
  next
  ' the cursor-right
  inc Ao
  V = 3
  if SC <> 1 then V = 4
  for J8 = 1 to V
    W = J8 - 1
    if Fin = 0 then
      W = RBee[W]
    else
      W = CBee[W]
    end if
    Poke(W)
    inc Ao
  next
  return
end sub

' Normal: the screen's colour after an event: the warning colour (249)
' once more than 40 bees are lost (fixed: lines 345 and 1100 put 191
' back even then, so the warning only showed between a zap and the next
' credit)
sub Normal:
  if R > 40 then
    SetQ(249)
  else
    SetQ(191)
  end if
  return
end sub

' Blank: Bn spaces from offset Ao
sub Blank(u8 Bn):
  for J8 = 1 to Bn
    Poke(32)
    inc Ao
  next
  return
end sub

' Buzz: the bass at H (Buzz0 is 240 ... Buzz11 is 130)
sub Buzz:
  V = 240 - H
  V = V / 10
  V = V + SndBuzz0
  play sound V
  return
end sub

' VAddr: Ad the name table address of VIC offset Ao (0 off the screen)
sub VAddr:
  Ad = 0
  if Ao < 0 then return
  if Ao > 505 then return
  Uo = Ao
  Ur = Uo / 22
  Uw = Ur * 22
  Uo = Uo - Uw
  Ad = Ur * 32
  Ad = Ad + Uo
  Ad = Ad + 37
  return
end sub

' Peek: Pk the tile at offset Ao (a space off the screen)
sub Peek:
  VAddr
  Pk = 32
  if Ad = 0 then return
  vpeek vram.name + Ad into Pk
  return
end sub

' Poke: tile Tv at offset Ao (nothing off the screen)
sub Poke(u8 Tv):
  VAddr
  if Ad = 0 then return
  vpoke vram.name + Ad, Tv
  return
end sub

' SetQ: POKE 36879,Qv: the backdrop is the screen colour (high nibble),
' and the bees' and the trap's border-coloured dots (colour 14 in their
' data) take the border's (the low three bits)
sub SetQ(u8 Qv):
  Qc = Qv
  V = Qv >> 4
  V = VicTms[V]
  call asm BtBack
  V = Qv & 7
  Bd = VicTms[V]
  W16 = TGd - 128
  W16 = W16 << 3
  for J8 = 0 to 23
    V = TileCol[W16]
    W = V >> 4
    if W = 14 then W = Bd
    V = V & 15
    if V = 14 then V = Bd
    W = W << 4
    V = V | W
    vpoke vram.color + 1024 + W16, V
    inc W16
  next
  return
end sub

' ReadStick: Js as the listing's lines 312-330 read it: right first
' (PEEK(37152) = 119), else up, down or left alone (J1 = 4, 8 or 16; the
' button or a diagonal with them is no move); Fr the button, Dn the stick
' down, Any a direction
sub ReadStick:
  Js = 0
  Up = joypad(1).up | joypad(2).up
  Dn = joypad(1).down | joypad(2).down
  Lf = joypad(1).left | joypad(2).left
  Rt8 = joypad(1).right | joypad(2).right
  Fr = joypad(1).fire | joypad(2).fire
  Any = Up | Dn
  Any = Any | Lf
  Any = Any | Rt8
  if Rt8 = 1 then
    Js = 1
    return
  end if
  if Fr = 1 then return
  V = Up + Dn
  V = V + Lf
  if V <> 1 then return
  if Up = 1 then Js = 2
  if Dn = 1 then Js = 3
  if Lf = 1 then Js = 4
  return
end sub

' WaitFire: GOSUB 5 until J1 = 32 (the button alone), once let go
sub WaitFire:
  WaitLetGo
wf_loop:
  Frame1
  ReadStick
  if Fr = 0 then goto wf_loop
  if Any = 1 then goto wf_loop
  return
end sub

sub WaitLetGo:
wl_loop:
  Frame1
  ReadStick
  V = Any | Fr
  if V > 0 then goto wl_loop
  return
end sub

sub Delay(u16 Dw):
  for W16 = 1 to Dw
    Frame1
  next
  return
end sub

sub CreditsPage:
  Ph = 0
  NewScreen($F0)
  backdrop black
  print at 12,2, "BEE TRAP"
  print at 2,4, "BY ROBERT L. LYKINS, FROM"
  print at 2,5, "COMPUTE!, JUNE 1983 (VIC-20,"
  print at 2,6, "ATARI AND TRS-80 COLOR"
  print at 2,7, "COMPUTER). LEAD THE LOST"
  print at 2,8, "BEES TO THE FLOWER BED, ONE"
  print at 2,9, "AT A TIME; BEWARE THE VENUS"
  print at 2,10, "BEE TRAPS."
  print at 2,12, "FOR THE COLECOVISION BY"
  print at 2,13, "CLAUDE (AN AI MADE BY"
  print at 2,14, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "2026, IN AMY, THE LANGUAGE"
  print at 2,16, "BY AMY BIENVENU."
  print at 2,18, "MUSIC: FLOWER BED (ORIGINAL)."
  print at 8,21, "PRESS THE BUTTON"
  ShowScreen
  play song BtSong once
  WaitLetGo
cp_wait:
  Frame1
  ReadStick
  if Fr = 0 then goto cp_wait
  ' the time spent here seeds RND
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $3A61
  return
end sub

sub NewScreen(u8 Tc):
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with Tc
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

sub Rearm:
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Ti
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' RndK: Rv = INT(RND(1) * Kn)
sub RndK(u16 Kn):
  Rnd16
  Uq = Rw
  Uq2 = Kn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

' the VIC's colours 0-15 as TMS9918 colours (11 light cyan, the field,
' and 3 cyan are both cyan, as near alike as on the VIC)
data VicTms bytes 1, 15, 8, 7, 13, 2, 4, 11, 9, 9, 9, 7, 13, 3, 5, 11

data RCredit bytes 159,160,161,162,163,164
data RBee bytes 165,161,161,166
data RSp bytes 167,168
data CFinal bytes 169,170,171,172,173,174,175,176,177,178,170,179
data CBee bytes 180,177,177,181
data CSp bytes 174,182
data GLuck bytes 183,184,184,185,186,187,188,189,190,191,191,191
data WPress bytes 192,193,194,195,195,196,197,198,193,194,196,199,200,201,201,202,203
const TRd0 = 139
const TCd0 = 149
data TilePat bytes
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$99,$C3,$00,$C3,$99,$00,$00
  $00,$CC,$C3,$00,$C3,$CC,$00,$00
  $00,$CC,$C3,$00,$C3,$CC,$00,$00
  $C3,$C3,$CC,$CC,$C3,$C3,$C3,$00
  $00,$38,$44,$4C,$54,$64,$44,$38
  $00,$10,$30,$10,$10,$10,$10,$38
  $00,$38,$44,$04,$08,$10,$20,$83
  $00,$83,$08,$10,$08,$04,$44,$38
  $00,$08,$18,$28,$48,$83,$08,$08
  $00,$83,$40,$87,$04,$04,$44,$38
  $00,$18,$20,$40,$87,$44,$44,$38
  $00,$83,$04,$08,$10,$20,$20,$20
  $00,$38,$44,$44,$38,$44,$44,$38
  $00,$38,$44,$44,$C3,$04,$08,$30
  $00,$38,$44,$4C,$54,$64,$44,$38
  $00,$10,$30,$10,$10,$10,$10,$38
  $00,$38,$44,$04,$08,$10,$20,$83
  $00,$83,$08,$10,$08,$04,$44,$38
  $00,$08,$18,$28,$48,$83,$08,$08
  $00,$83,$40,$87,$04,$04,$44,$38
  $00,$18,$20,$40,$87,$44,$44,$38
