' Device boundary: cartridge demo today, keyboard/disk/network services later.
sub Devices_Run:
  cls
  print centered at 2, "DEVICE CONSOLE"
  print at 3,6, "VIDEO     READY"
  print at 3,8, "KEYBOARD  FUTURE ADAM"
  print at 3,10, "STORAGE   FUTURE ADAM"
  print at 3,12, "NETWORK   FUTURE MODULE"
  print at 3,15, "TARGET: CARTRIDGE LAB"
  print centered at 18, "PRESS FIRE"
  return
end sub
