const SndTick = 4
const SndLift = 5
const SndUp = 6
const SndDown = 7
const SndFall = 8
const SndPay = 9
const SndGlass = 10
const SndGryph = 11
const SndCat = 12
const SndKey = 13
const SndCoin = 14
const SndStart = 15
const SndWin = 16
data EvInit bytes
  1, 0, 11, 0, 11, 0, 0, 11, 0, 7, 6, 20, 0, 12, 0, 0, 0, 0
  0, 6, 10, 0, 11, 0, 11, 2, 11, 0, 0, 0, 0, 0, 7, 11, 8, 0
  1, 0, 5, 5, 2, 0, 0, 0, 6, 11, 0, 0, 9, 0, 0, 10, 0, 0
  11, 11, 7, 0, 0, 16, 0, 3, 0, 0, 0, 11, 0, 11, 0, 11, 5, 11
  1, 0, 11, 0, 3, 11, 0, 11, 10, 0, 0, 0, 5, 11, 0, 7, 0, 6
  2, 0, 0, 11, 0, 13, 11, 5, 0, 0, 0, 11, 0, 0, 21, 11, 5, 9
  1, 0, 0, 11, 6, 11, 0, 10, 0, 0, 0, 5, 11, 0, 11, 17, 0, 11
  3, 0, 5, 11, 7, 0, 6, 0, 0, 2, 13, 0, 0, 4, 12, 5, 0, 11
  1, 0, 2, 11, 5, 13, 0, 11, 0, 7, 0, 19, 0, 5, 0, 11, 12, 0
  0, 11, 0, 11, 6, 11, 10, 7, 0, 3, 0, 0, 11, 5, 0, 0, 11, 0
  1, 0, 3, 9, 0, 11, 0, 0, 0, 11, 0, 18, 0, 6, 0, 0, 0, 0
  0, 11, 10, 0, 0, 11, 0, 0, 0, 7, 0, 0, 5, 11, 0, 11, 5, 11
end data
data DoorT bytes
  20, 100, 84, 80, 48, 0, 37, 66, 21, 69, 75, 128, 54, 100, 89, 148, 84, 80
  39, 90, 133, 97, 1, 17, 54, 89, 136, 150, 84, 97, 3, 5, 68, 65, 1, 2
  36, 80, 48, 20, 84, 80, 10, 145, 7, 85, 97, 17, 4, 85, 68, 73, 150, 97
  0, 21, 100, 88, 149, 82, 20, 73, 130, 21, 81, 33, 5, 76, 196, 69, 69, 66
  20, 72, 132, 80, 16, 16, 21, 68, 84, 69, 85, 81, 41, 144, 21, 100, 81, 1
  22, 69, 89, 134, 117, 80, 37, 84, 65, 0, 27, 129, 2, 9, 128, 4, 77, 192
  20, 68, 84, 68, 92, 192, 41, 144, 17, 36, 65, 16, 18, 21, 85, 106, 156, 209
  37, 81, 41, 134, 69, 81, 22, 69, 70, 100, 100, 81, 1, 0, 12, 198, 74, 129
  20, 68, 80, 0, 52, 64, 17, 4, 85, 68, 75, 160, 21, 72, 165, 100, 68, 82
  37, 68, 90, 170, 132, 81, 22, 116, 81, 22, 84, 81, 1, 3, 5, 73, 129, 1
  36, 80, 20, 84, 84, 96, 22, 101, 85, 65, 33, 18, 25, 182, 101, 88, 154, 145
  17, 3, 34, 21, 113, 17, 21, 84, 70, 101, 87, 65, 9, 129, 0, 6, 77, 192
end data
data GhX bytes
