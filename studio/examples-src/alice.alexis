end data
data GlassOk bytes
  207, 243, 247, 187, 55, 235, 191, 191, 63, 255, 239, 253, 37, 240, 124, 255, 238, 135
  199, 215, 159, 127, 255, 255, 125, 254, 11
end data
const NSpr = 6
const WalkN = 12
const MsgN = 180

' room view: the hedge box is columns 3-20, rows 2-19
const RL = 3
const RR = 20
const RT = 2
const RB = 19

data SpdT bytes
  16, 24, 32
end data
' key colours by key (elevator, green, looking-glass, pits, gryphon, white)
data KeyCol bytes
  14, 2, 13, 8, 10, 15
end data

' a key the gryphon took: kind of key by the random number (7-12 with 11
' counted as 12, as in the listing)
data StealT bytes
  0, 1, 2, 3, 5, 5
end data

record Pos:
  u8 X
  u8 Y
end record

u8 Ev[216]
Pos Al
Pos Gr
u16 Rs = 1
u16 TzLeft = 0
u16 NumU = 0
u16 W16 = 0
bcd digits 4 Moves = 0
u8 TzOn = 0
u8 Rx = 4
u8 Ry = 5
u8 Rz = 0
u8 Rm = 0
u8 Gold = 0
u8 HaveK = 0
u8 Spd = 1
u8 Acc = 0
u8 Face = 0
u8 Anim = 0
u8 Moving = 0
u8 Won = 0
u8 Wt = 0
u8 Ans = 0
u8 Caught = 0
u8 Phase = 0
u8 Chain = 0
u8 Ghost = 0
u8 GrDir = 0
u8 MsgT = 0
u8 Bump = 0
u8 Lock = 0
u8 Oo = 1
u8 Sel = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
u8 CrA = 0
u8 CrB = 0
u8 CrCa = 0
u8 CrCb = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 NewStick = 0
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ci = 0
u8 Ki = 0
u8 Ti = 0
' scratch
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Nx = 0
u8 Ny = 0
u8 X3 = 0
u8 KeyLen = 0
u8 Y3 = 0
u8 Z3 = 0

  tile screen
  set sound table AlSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 2
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  WalkStep
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ClearMsg
  end if
  DrawSprites
  if Won = 0 then goto play_loop

  ' the end: the message, then back to the title on a press
  mute all
  play sound SndWin
  ClearMsg
  print at 2,21, "ALICE! YOU FOUND THE"
  print at 2,22, "WHITE RABBIT!  ROOMS"
  print Moves at 23,22
  Wt = 4
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' walking

' room number of a place in the maze
function RoomAt(u8 Qx, u8 Qy, u8 Qz) as u8
  return Qz * 36 + Qy * 6 + Qx

' door code (0 hedge, 1 open, 2 green, 3 white) on side Sd of this room
function DoorOf(u8 Sd) as u8
  u8 B = DoorT[Rm]
  u8 S = Sd << 1
  for Ti = 1 to S
    B = B >> 1
  next
  return B & 3

' 1 when Alice may go through side Sd (0 N, 1 E, 2 S, 3 W)
function Passable(u8 Sd) as u8
  u8 Dc = DoorOf(Sd)
  if Dc = 1 then return 1
  if Dc = 2 then
    if HaveK & 2 then return 1
  end if
  if Dc = 3 then
    if HaveK & 32 then return 1
  end if
  return 0

' 1 when Alice's feet (12 x 12 under the sprite) fit at Nx, Ny
function Fits as u8
  u8 Hl = Nx + 2
  u8 Hr = Nx + 13
  u8 Ht = Ny + 4
  u8 Hb = Ny + 15
  Lock = 255
  ' while the gryphon flies Alice stays in the room
  if Ghost = 1 then
    if Ny < 10 then return 0
    if Ny > 147 then return 0
    if Nx < 20 then return 0
    if Nx > 156 then return 0
  end if
  if Hl >= 32 then
    if Hr <= 159 then
      if Ht >= 24 then
        if Hb <= 151 then return 1
      end if
    end if
  end if
  ' the door gaps: columns 10-13 (x 80-111), rows 9-12 (y 72-103)
  if Hl >= 80 then
    if Hr <= 111 then
      if Ht < 24 then
        Lock = 0
        if Passable(0) = 1 then return 1
      end if
      if Hb > 151 then
        Lock = 2
        if Passable(2) = 1 then return 1
      end if
    end if
  end if
  if Ht >= 72 then
    if Hb <= 103 then
      if Hl < 32 then
        Lock = 3
        if Passable(3) = 1 then return 1
      end if
      if Hr > 159 then
        Lock = 1
        if Passable(1) = 1 then return 1
      end if
    end if
  end if
  return 0

' one frame of walking: the stick moves Alice; through a door into the next
' room
sub WalkStep:
  Moving = 0
  V = Acc + SpdT[Spd]
  N = V >> 4
  Acc = V & 15
  if N = 0 then return
  Nx = Al.X
  Ny = Al.Y
  K = Stick & 12
  if K = 4 then Nx = Nx - N
  if K = 8 then Nx = Nx + N
  if K > 0 then
    Moving = 1
    if Fits = 1 then
      Al.X = Nx
    else
      Nx = Al.X
      Locked
    end if
  end if
  K = Stick & 3
  if K = 1 then
    Ny = Ny - N
    Face = 1
  end if
  if K = 2 then
    Ny = Ny + N
    Face = 0
  end if
  if K > 0 then
    Moving = 1
    if Fits = 1 then
      Al.Y = Ny
    else
      Locked
    end if
  end if
  if Moving = 1 then inc Anim
  if Al.Y < 9 then
    LeaveRoom(0)
    return
  end if
  if Al.Y > 148 then
    LeaveRoom(2)
    return
  end if
  if Al.X < 19 then
    LeaveRoom(3)
    return
  end if
  if Al.X > 157 then LeaveRoom(1)
  return
end sub

' a bump into a closed gate says so (once until Alice turns away)
sub Locked:
  if Lock = 255 then return
  if Bump = Lock then return
  Bump = Lock
  C = DoorOf(Lock)
  if C = 2 then
    ClearMsg
    print at 2,21, "THE GREEN GATE IS LOCKED."
    MsgT = MsgN
    play sound SndLocked
  end if
  if C = 3 then
    ClearMsg
    print at 2,21, "THE WHITE GATE IS LOCKED."
    MsgT = MsgN
    play sound SndLocked
  end if
  return
end sub

sub LeaveRoom(u8 Sd):
  Phase = 1
  select case Sd
  case 0
    dec Ry
    Al.Y = 140
  case 1
    inc Rx
    Al.X = 22
  case 2
    inc Ry
    Al.Y = 12
  case else
    dec Rx
    Al.X = 150
  end select
  Face = 0
  if Sd = 0 then Face = 1
  inc Moves
  Rm = RoomAt(Rx, Ry, Rz)
  DrawRoom
  WalkIn(Sd)
  DoEvents
  Phase = 0
  return
end sub

' Alice walks 24 pixels into the room (input ignored), as on the C64
sub WalkIn(u8 Sd):
  for Ki = 1 to WalkN
    select case Sd
    case 0
      Al.Y -= 2
    case 1
      Al.X += 2
    case 2
      Al.Y += 2
    case else
      Al.X -= 2
    end select
    inc Anim
    DrawSprites
    Frame1
  next
  ReadPad
  return
end sub

' ---------------------------------------------------------------------------
' the things in the rooms

sub DoEvents:
  Chain = 1
  while Chain = 1
    Chain = 0
    DoEvent
  end while
  return
end sub

sub DoEvent:
  T = Ev[Rm] & 31
  if T >= 16 then
    FoundKey
    return
  end if
  select case T
  case 1
    Elevator
  case 2
    Stairs(1)
  case 3
    Stairs(0)
  case 4
    Rabbit
  case 5
    Pit
  case 6
    LookingGlass
  case 7
    Gryphon
  case 8
    ClearMsg
    print at 2,21, "A TEA TABLE, LAID FOR A"
    print at 2,22, "PARTY. NOBODY IS HOME."
    MsgT = MsgN
  case 9
    Shop
  case 10
    Cat
  case 11
    FoundCoin
  case 12
    Shop
  case 13
    Shop
  end select
  return
end sub

sub Elevator:
  if HaveK & 1 then
    ClearMsg
    print at 2,21, "USE THE ELEVATOR?"
    AskWait
    if Ans = 0 then return
    PickLevel
    Rx = 0
    Ry = 0
    Rz = Sel
    Arrive
    return
  end if
  ClearMsg
  print at 2,21, "SORRY ALICE, YOU NEED A KEY."
  MsgT = MsgN
  return
end sub

' up and down choose the level, a button goes
sub PickLevel:
  Sel = Rz
  Wt = 2
  ClearMsg
  print at 2,21, "WHAT LEVEL?"
  print at 2,22, "STICK UP/DOWN, BUTTON"
  ShowSel
  while Wt = 2
    Frame1
    ReadPad
    if NewStick & 1 then
      if Sel < 5 then inc Sel
      ShowSel
      play sound SndTick
    end if
    if NewStick & 2 then
      if Sel > 0 then dec Sel
      ShowSel
      play sound SndTick
    end if
    if Press = 1 then Wt = 0
  end while
  ClearMsg
  play sound SndLift
  for Ki = 1 to 40
    Frame1
  next
  return
end sub

sub ShowSel:
  NumU = Sel + 1
  print at 14,21, digits$(NumU, 1)
  return
end sub

sub Stairs(u8 Up):
  if Up = 1 then
    ClearMsg
    print at 2,21, "CLIMB THE STAIRS UP?"
    AskWait
  else
    ClearMsg
    print at 2,21, "GO DOWN THE STAIRS?"
    AskWait
  end if
  if Ans = 0 then return
  if Up = 1 then
    inc Rz
    play sound SndUp
  else
    dec Rz
    play sound SndDown
  end if
  for Ki = 1 to 30
    Frame1
  next
  Arrive
  return
end sub

' a new level: Alice stands in the middle of the room, below its thing
sub Arrive:
  Rm = RoomAt(Rx, Ry, Rz)
  Al.X = 88
  Al.Y = 100
  Face = 0
  inc Moves
  DrawRoom
  DrawSprites
  return
end sub

sub Pit:
  if HaveK & 8 then
    ClearMsg
    print at 2,21, "JUMP INTO THE PIT?"
    AskWait
    if Ans = 0 then return
  end if
  ClearMsg
  print at 2,21, "ALICE FALLS DOWN THE PIT!"
  MsgT = MsgN
  play sound SndFall
  ' Alice sinks into the hole
  for Ki = 1 to 40
    Frame1
    V = Ki & 3
    if V = 0 then
      if Al.Y < 140 then inc Al.Y
    end if
    DrawSprites
  next
  dec Rz
  Arrive
  Chain = 1
  if Gold = 0 then return
  Rand
  V = Rs & 255
  ' 70% (179 of 256) lose a coin
  if V < 179 then
    dec Gold
    ShowGold
    ClearMsg
    print at 2,21, "YOU LOST A GOLD COIN!"
    MsgT = MsgN
    play sound SndPay
    Pause(60)
  end if
  return
end sub

sub LookingGlass:
  if HaveK & 4 then
    ClearMsg
    print at 2,21, "A LOOKING GLASS. YOUR KEY"
    print at 2,22, "KEEPS YOU ON THIS SIDE."
    MsgT = MsgN
    return
  end if
  ClearMsg
  print at 2,21, "LOOKING GLASS ROOM!"
  MsgT = MsgN
  play sound SndGlass
  Pause(70)
  ' a random room on levels 1-5 (X and Y 0-4), again until it is one
  ' Alice can walk back from (GlassOk, made by maze.py)
  Ans = 0
  while Ans = 0
    Rand
    Rx = Rs % 5
    Rand
    Ry = Rs % 5
    Rand
    Rz = Rs % 5
    Ans = GlassFits(RoomAt(Rx, Ry, Rz))
  end while
  Arrive
  play sound SndGlass
  ClearMsg
  print at 2,21, "WHERE AM I NOW?"
  MsgT = MsgN
  Pause(40)
  Chain = 1
  return
end sub

' the gryphon swoops across at Alice's height; Alice can step aside
sub Gryphon:
  ClearMsg
  print at 2,21, "THE GRYPHON SWOOPS DOWN!"
  print at 2,22, "GET OUT OF ITS WAY!"
  MsgT = MsgN
  play sound SndGryph
  Ghost = 1
  Gr.Y = Al.Y
  if Al.X < 96 then
    GrDir = 0
    Gr.X = 152
  else
    GrDir = 1
    Gr.X = 24
  end if
  Pause(36)
  Ans = 0
  for Ci = 1 to 64
    Frame1
    ReadPad
    Stick = Stick & 15
    WalkInside
    if GrDir = 0 then
      Gr.X -= 2
    else
      Gr.X += 2
    end if
    inc Anim
    DrawSprites
    if Ans = 0 then
      ' caught when the boxes overlap
      V = Gr.X - Al.X + 11
      if V < 23 then
        V = Gr.Y - Al.Y + 11
        if V < 23 then Ans = 1
      end if
    end if
  next
  Ghost = 0
  Caught = Ans
  DrawSprites
  if Ans = 0 then
    ClearMsg
    print at 2,21, "IT MISSED YOU!"
    MsgT = MsgN
    return
  end if
  if HaveK & 16 then
    ClearMsg
    print at 2,21, "THE GRYPHON SEES YOUR KEY"
    print at 2,22, "AND FLIES OFF."
    MsgT = MsgN
    return
  end if
  Rand
  V = Rs % 6
  K = StealT[V]
  V = 1 << K
  if HaveK & V then
    HaveK = HaveK ^ V
    ' hide it in the next of the 15 places
    R = Oo - 1
    D = RoomAt(GhX[R], GhY[R], GhZ[R])
    V = Ev[D] & 128
    Ev[D] = V + 16 + K
    inc Oo
    if Oo > 15 then Oo = 1
    ShowKeys
    play sound SndPay
    ClearMsg
    print at 2,21, "THE GRYPHON STOLE YOUR"
    KeyName(2, 22)
    MsgT = MsgN
    return
  end if
  ClearMsg
  print at 2,21, "THE GRYPHON FINDS NOTHING."
  MsgT = MsgN
  return
end sub

' walking while the gryphon flies (Fits keeps Alice in the room)
sub WalkInside:
  WalkStep
  return
end sub

' the cat tells where the key of its level is
sub Cat:
  CrA = SCatw
  CrB = SCata
  CrCa = 15
  CrCb = 14
  DrawSprites
  K = Rz
  V = 1 << K
  ClearMsg
  if HaveK & V then
    print at 2,21, "'I SEE YOU HAVE THE"
    KeyName(2, 22)
    T = 2 + KeyLen
    print at T,22, "!'"
    MsgT = MsgN
    play sound SndCat
    return
  end if
  D = FindThing(16 + K)
  print at 2,21, "'THE"
  KeyName(7, 21)
  T = 7 + KeyLen
  print at T,21, " IS"
  if D = 255 then
    print at 2,22, "NOWHERE.'"
  else
    PlaceText(D, 1)
  end if
  MsgT = MsgN
  play sound SndCat
  return
end sub

' "IN THE NE PART OF LEVEL 4." for room Pl on row 22 (Qt 1: and a
' closing quote)
sub PlaceText(u8 Pl, u8 Qt):
  Z3 = Pl / 36
  V = Pl % 36
  Y3 = V / 6
  X3 = V % 6
  print at 2,22, "IN THE    PART OF LEVEL  ."
  if Y3 < 3 then
    put char 78 at 9,22
  else
    put char 83 at 9,22
  end if
  if X3 < 3 then
    put char 87 at 10,22
  else
    put char 69 at 10,22
  end if
  NumU = Z3 + 1
  print at 26,22, digits$(NumU, 1)
  if Qt = 1 then put char 39 at 28,22
  return
end sub

' 1 when the looking glass may throw Alice into room Gq
function GlassFits(u8 Gq) as u8
  u8 Gb = GlassOk[Gq >> 3]
  u8 Gm = 1 << (Gq & 7)
  if Gb & Gm then return 1
  return 0

' the first room holding thing Th, or 255
function FindThing(u8 Th) as u8
  u8 Fr = 255
  for Ri = 0 to 215
    if Fr = 255 then
      V = Ev[Ri] & 31
      if V = Th then Fr = Ri
    end if
  next
  return Fr

' the name of key K at a place on screen
sub KeyName(u8 Kx, u8 Ky):
  select case K
  case 0
    print at Kx,Ky, "ELEVATOR KEY"
    KeyLen = 12
  case 1
    print at Kx,Ky, "GREEN KEY"
    KeyLen = 9
  case 2
    print at Kx,Ky, "LOOKING-GLASS KEY"
    KeyLen = 17
  case 3
    print at Kx,Ky, "PITS KEY"
    KeyLen = 8
  case 4
    print at Kx,Ky, "GRYPHON KEY"
    KeyLen = 11
  case else
    print at Kx,Ky, "WHITE KEY"
    KeyLen = 9
  end select
  return
end sub

sub FoundKey:
  K = T - 16
  V = 1 << K
  HaveK = HaveK | V
  TakeThing
  ShowKeys
  DrawRoom
  ClearMsg
  print at 2,21, "YOU FOUND THE"
  KeyName(2, 22)
  MsgT = MsgN
  play sound SndKey
  return
end sub

' the thing is gone from this room (the visited mark stays)
sub TakeThing:
  V = Ev[Rm] & 128
  Ev[Rm] = V
  return
end sub

sub FoundCoin:
  TakeThing
  DrawRoom
  inc Gold
  ShowGold
  ClearMsg
  print at 2,21, "YOU FOUND A GOLD COIN!"
  MsgT = MsgN
  play sound SndCoin
  if Gold < 10 then return
  Pause(50)
  Gold = 0
  ShowGold
  ' the lowest key not carried
  K = 255
  for Ki = 0 to 5
    if K = 255 then
      V = 1 << Ki
      V = HaveK & V
      if V = 0 then K = Ki
    end if
  next
  ClearMsg
  if K = 255 then
    D = FindThing(4)
    print at 2,21, "ALICE! THE WHITE RABBIT IS"
    PlaceText(D, 0)
  else
    ' the key leaves its room (wherever it lies) and is yours
    D = FindThing(16 + K)
    if D < 216 then
      V = Ev[D] & 128
      Ev[D] = V
    end if
    V = 1 << K
    HaveK = HaveK | V
    ShowKeys
    print at 2,21, "TEN COINS BUY THE"
    KeyName(2, 22)
  end if
  MsgT = MsgN
  play sound SndKey
  return
end sub

' the Duchess's kitchen, the Hatter's teahouse, the Carpenter's diner:
' a coin each time
sub Shop:
  select case T
  case 9
    print at 7,5, " DUCHESS'S "
    print at 7,6, "  KITCHEN  "
  case 12
    print at 7,5, "   HATTER'S  "
    print at 7,6, "   TEAHOUSE  "
  case else
    print at 7,5, " CARPENTER'S "
    print at 7,6, "SEAFOOD DINER"
  end select
  if Gold = 0 then
    ClearMsg
    print at 2,21, "SORRY, LITTLE GIRL, BUT"
    print at 2,22, "YOU NEED GOLD."
    MsgT = MsgN
    return
  end if
  dec Gold
  ShowGold
  play sound SndPay
  select case T
  case 9
    ClearMsg
    print at 2,21, "HAVE A HAMBURGER AND"
    print at 2,22, "FRIES! (ONE GOLD COIN)"
    MsgT = MsgN
  case 12
    ClearMsg
    print at 2,21, "YOU MUST BE THIRSTY!"
    print at 2,22, "(ONE GOLD COIN)"
    MsgT = MsgN
  case else
    ClearMsg
    print at 2,21, "EAT AN OYSTER FOR DINNER!"
    print at 2,22, "(ONE GOLD COIN)"
    MsgT = MsgN
  end select
  return
end sub

sub Rabbit:
  CrA = SRabw
  CrB = SRabr
  CrCa = 15
  CrCb = 6
  DrawSprites
  Won = 1
  return
end sub

' ---------------------------------------------------------------------------
' messages and questions

sub ClearMsg:
  fill 32 count 28 at 2,21
  fill 32 count 28 at 2,22
  MsgT = 0
  return
end sub

' Say1("..."), Say2("...", "...") and Ask("...") are written out by
' build.py as prints (Amy subs take no string arguments): the message on
' rows 21-22 for MsgN frames; Ask then waits in AskWait.

' a yes/no question: a button says yes, the stick says no
sub AskWait:
  Wt = 1
  print at 2,22, "BUTTON: YES  STICK: NO"
  ' let go of the stick first
  while Stick > 0
    Frame1
    ReadPad
    DrawSprites
  end while
  Ans = 255
  while Ans = 255
    Frame1
    ReadPad
    if Press = 1 then Ans = 1
    if NewStick > 0 then Ans = 0
  end while
  Wt = 0
  ClearMsg
  return
end sub

sub Pause(u8 Pn):
  for Ki = 1 to Pn
    Frame1
    DrawSprites
  next
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawRoom:
  Rearm
  wait
  nmi off
  display off
  V = Ev[Rm] | 128
  Ev[Rm] = V
  CrA = 0
  Bump = 255
  ' floor
  for Ri = 3 to 18
    for Ci = 4 to 19
      V = Ri + Ci
      V = V & 1
      T = TFa + V
      put char T at Ci,Ri
    next
  next
  fill THedge count 18 at RL,RT
  fill THedge count 18 at RL,RB
  for Ri = 3 to 18
    put char THedge at RL,Ri
    put char THedge at RR,Ri
  next
  ' doors
  for Ki = 0 to 3
    DrawDoor
  next
  ' the thing in the middle
  T = Ev[Rm] & 31
  U = 0
  select case T
  case 1
    U = TElev00
  case 2
    U = TStup00
  case 3
    U = TStdn00
  case 5
    U = TPit00
  case 6
    U = TGlass00
  case 8
    U = TTable00
  end select
  if U > 0 then
    put char U at 11,10
    V = U + 1
    put char V at 12,10
    V = U + 2
    put char V at 11,11
    V = U + 3
    put char V at 12,11
  end if
  ' a key or a coin lying there
  if T >= 16 then
    CrA = SKey
    CrB = 0
    K = T - 16
    CrCa = KeyCol[K]
  end if
  if T = 11 then
    CrA = SCoin
    CrB = 0
    CrCa = 10
  end if
  ShowMap
  ShowLevel
  ClearMsg
  screen on
  nmi off
  return
end sub

' door Ki of the room: the gap shows the open floor or the gate
sub DrawDoor:
  C = DoorOf(Ki)
  if C = 0 then return
  D = 0
  if C = 2 then
    D = TGdh
    if HaveK & 2 then D = 0
  end if
  if C = 3 then
    D = TWdh
    if HaveK & 32 then D = 0
  end if
  for Ti = 0 to 3
    select case Ki
    case 0
      X = 10 + Ti
      Y = RT
    case 1
      X = RR
      Y = 9 + Ti
    case 2
      X = 10 + Ti
      Y = RB
    case else
      X = RL
      Y = 9 + Ti
    end select
    if D = 0 then
      V = X + Y
      V = V & 1
      T = TFa + V
    else
      T = D
      V = Ki & 1
      if V = 1 then T = D + 1
    end if
    put char T at X,Y
  next
  return
end sub

' the visited rooms of this level, and Alice's
sub ShowMap:
  print at 23,3, "MAP"
  for Ri = 0 to 5
    for Ci = 0 to 5
      V = RoomAt(Ci, Ri, Rz)
      T = TMun
      if Ev[V] & 128 then T = TMvis
      if V = Rm then T = TMhere
      X = Ci + 23
      Y = Ri + 5
      put char T at X,Y
    next
  next
  return
end sub

sub ShowLevel:
  print at 22,12, "LEVEL"
  NumU = Rz + 1
  print at 28,12, digits$(NumU, 1)
  return
end sub

sub ShowGold:
  put char TCoin at 22,14
  print at 23,14, " GOLD"
  NumU = Gold
  print at 28,14, digits$(NumU, 2)
  return
end sub

sub ShowKeys:
  print at 22,16, "KEYS"
  for Ki = 0 to 5
    V = 1 << Ki
    V = HaveK & V
    T = TKeyno
    if V > 0 then T = TKey0 + Ki
    X = 23 + Ki
    put char T at X,17
  next
  return
end sub

' sprites 0-2 Alice, 3-4 the thing (key, coin, cat, rabbit), 5 the gryphon
sub DrawSprites:
  Y = Al.Y - 1
  X = Al.X
  V = Anim >> 3
  V = V & 1
  if Moving = 0 then V = 0
  K = V * 12
  if Face = 1 then K = K + 24
  set sprite 0 to Y,X,K,10
  K = K + 4
  set sprite 1 to Y,X,K,9
  K = K + 4
  set sprite 2 to Y,X,K,6
  if CrA = 0 then
    set sprite 3 to 192,0,0,0
    set sprite 4 to 192,0,0,0
  else
    set sprite 3 to 79,88,CrA,CrCa
    if CrB = 0 then
      set sprite 4 to 192,0,0,0
    else
      set sprite 4 to 79,88,CrB,CrCb
    end if
  end if
  if Ghost = 1 then
    V = Anim >> 2
    V = V & 1
    K = V << 2
    if GrDir = 0 then
      K = K + SGl0
    else
      K = K + SGr0
    end if
    Y = Gr.Y - 1
    set sprite 5 to Y,Gr.X,K,10
  else
    set sprite 5 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

sub NewGame:
  copy EvInit count 216 to Ev
  Rx = 4
  Ry = 5
  Rz = 0
  Gold = 0
  HaveK = 0
  Won = 0
  Oo = 1
  Moves = 0
  Ghost = 0
  NewScreen
  print at 4,1, "ALICE IN ADVENTURELAND"
  for Ri = 3 to 10
    put char TMfv at 22,Ri
    put char TMfv at 29,Ri
  next
  fill TMfh count 6 at 23,4
  fill TMfh count 6 at 23,11
  ShowGold
  ShowKeys
  Rm = RoomAt(Rx, Ry, Rz)
  Al.X = 88
  Al.Y = 120
  Face = 1
  DrawRoom
  DrawSprites
  play sound SndStart
  ClearMsg
  print at 2,21, "FIND THE WHITE RABBIT!"
  MsgT = MsgN
  Wt = 0
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Stick = J1 & 15
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  V = WasStick ^ 15
  NewStick = Stick & V
  WasStick = Stick
  if Stick = 0 then Bump = 255
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 5
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: START GAME / SPEED / CREDITS, the tune once
sub TitlePage:
  NewScreen
  Wt = 3
  fill THedge count 28 at 2,2
  fill THedge count 28 at 2,19
  for Ri = 3 to 18
    put char THedge at 2,Ri
    put char THedge at 29,Ri
  next
  print at 10,5, "ALICE  IN"
  print at 7,6, "ADVENTURELAND"
  print at 9,8, "BY BOB SPIRKO"
  print at 10,12, "START GAME"
  print at 10,13, "SPEED"
  print at 10,14, "CREDITS"
  print at 8,17, "AHOY! JAN 1985"
  ShowSpeed
  Menu = 0
  ShowMenu
  ' Alice and the White Rabbit on the title
  Al.X = 72
  Al.Y = 120
  Face = 0
  Moving = 0
  Ghost = 0
  CrA = 0
  DrawSprites
  set sprite 3 to 119,160,SRabw,15
  set sprite 4 to 119,160,SRabr,6
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 580
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  if NewStick & 1 then
    if Menu > 0 then dec Menu
    ShowMenu
  end if
  if NewStick & 2 then
    if Menu < 2 then inc Menu
    ShowMenu
  end if
  if Press = 0 then goto tp_loop
  if Menu = 1 then
    inc Spd
    if Spd > 2 then Spd = 0
    ShowSpeed
    play sound SndTick
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then CreditsPage
  return
end sub

sub ShowSpeed:
  select case Spd
  case 0
    print at 16,13, "SLOW  "
  case 1
    print at 16,13, "MEDIUM"
  case else
    print at 16,13, "FAST  "
  end select
  return
end sub

sub ShowMenu:
  for Ki = 12 to 14
    put char 32 at 8,Ki
  next
  J = Menu + 12
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  Wt = 5
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 5,2, "ALICE IN ADVENTURELAND"
  print at 2,5, "BASED ON ALICE BY BOB"
  print at 2,6, "SPIRKO, AHOY! JANUARY 1985"
  print at 2,7, "(COMMODORE 64), AFTER"
  print at 2,8, "LEWIS CARROLL'S BOOKS."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: A GOLDEN AFTERNOON"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

