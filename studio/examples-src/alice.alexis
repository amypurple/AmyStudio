const TCoin = 171
const SAf0y = 0
const SAf0p = 4
const SAf0r = 8
const SAf1y = 12
const SAf1p = 16
const SAf1r = 20
const SAb0y = 24
const SAb0p = 28
const SAb0r = 32
const SAb1y = 36
const SAb1p = 40
const SAb1r = 44
const SGr0 = 48
const SGr1 = 52
const SGl0 = 56
const SGl1 = 60
const SCatw = 64
const SCata = 68
const SRabw = 72
const SRabr = 76
