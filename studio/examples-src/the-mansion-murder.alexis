cartridge "MANSION MURDER/AHOY! MAR. 1985/1985"

' THE MANSION MURDER
' Based on "Mansion" ("Solve the Mansion Murder"), Ahoy! March 1985
' (Commodore 64 BASIC: MANSION GAME and MANSION SETUP; orig/ has the
' listings and pictures of its twelve screens). The magazine's disk and
' listing name no author. Made for the ColecoVision in Amy (the language
' by Amy Bienvenu) by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' The listing is a mansion to walk through: twelve screens of floor plan
' (52 rooms, doorways, stairs, a lawn, a hot tub, secret passages, three
' different passage set-ups chosen at random), 1-6 players taking turns of
' 75 steps, the room's name shown as you enter it. Its title says "please
' find the murderer in the mansion" but the program holds no mystery: the
' players were left to make one up. Here the mystery is built in.
'
' Kept from the listing: the twelve screens cell for cell (MAP bytes are
' its DATA lines 52000-53123, the tiles its own glyphs, DATA 63000+), its
' wing table, its stairway and secret-passage rules (lines 300-390 and
' 600-750) with the random set-up SP, its start squares, its turns
' (a turn ends when the step count passes 75; stairs, passages and
' screen changes cost no step), and its room names.
' Changed (noted): the room you land in after the stairs or a passage is
' yours at once (the listing waited for your next step).
'
' Added: a murder. One of six suspects, with one of six weapons, in one
' of nine rooms, chosen at random. The eighteen other cards are clues
' hidden one to a room around the mansion; you find one by walking into
' its room, and it goes into your notebook. A suspect may be questioned in
' his or her own room (once per player, 20 steps): an innocent one tells
' you a clue you have not found; the murderer saw nothing. Accuse from
' the menu: right, and you have solved it; wrong, and you are out.
'
' Made for this machine: the dark house - every room is black until your
' lamp lights it in the listing's own brown on yellow; a view that
' follows you over the 40-column screens; the players as figures;
' portraits of the suspects; the notebook; sounds; a quiet loop under play
' ("Footsteps on the Landing") and an original title tune ("Who Turned
' the Key?").
'
' Controls (either joystick): the stick walks; the right button opens the
' menu (notebook, question, accuse, end turn, end game); in menus the stick
' chooses and the left button picks.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; every screen drawn with the NMI off after a wait; at the end a
' press goes back to the title, and the screen sleeps after 30 seconds.

const TPaper = 219
const TFh = 220
const TFb = 221
const TFl = 222
const TFr = 223
const TFtl = 224
const TFtr = 225
const TFbl = 226
const TFbr = 227
const TTick = 228
const TQm = 229
const TDot = 230
const TMoon00 = 231
const TMoon01 = 232
const TMoon10 = 233
const TMoon11 = 234
const TCand00 = 235
const TCand01 = 236
const TCand10 = 237
const TCand11 = 238
const TRoofl = 239
const TRoofr = 240
const TRoof = 241
const TWall = 242
const TWin = 243
const TWind = 244
const TDoor = 245
const SPlayer = 0
const SGhost = 4
const SArrow = 8
const SButlerd0 = 12
const SButlerd1 = 16
const SButlerd2 = 20
const SButlerd3 = 24
const SButlers0 = 28
const SButlers1 = 32
const SButlers2 = 36
const SButlers3 = 40
const SMaidd0 = 44
const SMaidd1 = 48
const SMaidd2 = 52
const SMaidd3 = 56
const SMaids0 = 60
const SMaids1 = 64
const SMaids2 = 68
const SMaids3 = 72
const SChauffeurd0 = 76
const SChauffeurd1 = 80
const SChauffeurd2 = 84
const SChauffeurd3 = 88
const SChauffeurs0 = 92
const SChauffeurs1 = 96
const SChauffeurs2 = 100
const SChauffeurs3 = 104
const SGovernessd0 = 108
const SGovernessd1 = 112
const SGovernessd2 = 116
const SGovernessd3 = 120
const SGovernesss0 = 124
const SGovernesss1 = 128
const SGovernesss2 = 132
const SGovernesss3 = 136
const SCecild0 = 140
const SCecild1 = 144
const SCecild2 = 148
const SCecild3 = 152
const SCecils0 = 156
const SCecils1 = 160
const SCecils2 = 164
const SCecils3 = 168
const SFreddyd0 = 172
const SFreddyd1 = 176
const SFreddyd2 = 180
const SFreddyd3 = 184
const SFreddys0 = 188
const SFreddys1 = 192
const SFreddys2 = 196
const SFreddys3 = 200
const NTiles8 = 944
const SprBytes = 1632
const SndTuneA = 1
const SndTuneB = 2
const SndRunA = 3
const SndRunB = 4
const SndStep = 5
const SndBump = 6
const SndCreak = 7
const SndWhoosh = 8
const SndClue = 9
const SndTick = 10
const SndNope = 11
const SndGasp = 12
const SndWin = 13
const SndLose = 14
const NClueRm = 51
u16 TzLeft = 0
u8 TzOn = 0

' the case: Ss suspect, Sw weapon, Sr murder room (0-8, MRm); Sp the
' listing's passage set-up (1-3)
u8 Ss = 0
u8 Sw = 0
u8 Sr = 0
u8 Sp = 1
' ClueAt(room) = clue item + 1 (0 none); items 0-5 suspects, 6-11
' weapons, 12-20 murder rooms. Nb(player * 21 + item) 1 when found.
' Qd(player * 6 + suspect) 1 when questioned.
u8 ClueAt[53]
u8 Nb[126]
u8 Qd[36]
' the players: screen, column, row, room (the listing's PW, H, V, PR), out
u8 Pw[6]
u8 Ph[6]
u8 Pv[6]
u8 Pr[6]
u8 Pout[6]
u8 Np = 1
u8 Cp = 0
' the player now walking (copied in and out of the arrays)
u8 Cw = 0
u8 Ch = 0
u8 Cv = 0
u8 Cr = 0
u8 T = 0
u8 MvN = 0
' the view: Cx, Cy the map cell at the window's top left; Lit the lit room
u8 Cx = 0
u8 Cy = 0
u8 Lit = 0
u8 MsgT = 0
u8 Over = 0
' Ph8: 1 walking, 2 menu, 3 notebook, 4 accuse, 5 hand-over, 6 the end,
' 7 title, 8 credits, 9 suspects page, 10 rules, 11 verdict page (bot)
u8 Pg = 0
u8 Idle = 0
' movement work
u8 Dh = 0
u8 Dv = 0
u8 Nh = 0
u8 Nv = 0
u8 Oh = 0
u8 Ov = 0
u8 Xc = 0
u8 Res = 0
u8 OldR = 0
u8 Gw = 0
u8 Gv = 0
u8 Gh = 0
u8 Tw = 0
u8 Tv = 0
u8 Th = 0
u8 Nw = 0
u8 Qn = 0
' text work: PrTab prints Ln characters of entry Xn of table Tb (0 rooms,
' 1 suspects, 2 weapons), skipping Ofs, at Px, Py
u8 Tb = 0
u8 Xn = 0
u8 Ln = 0
u8 Ofs = 0
u8 Px = 0
u8 Py = 0
' accuse picks
u8 Aa = 0
u8 Aw = 0
u8 Ar = 0
u8 Row = 0
u8 Menu = 0
u8 Mi = 0
u8 Pic = 0
u16 Rs = 1
u16 Rw = 0
u16 Rn = 0
u8 Rv = 0
u16 A16 = 0
u16 B16 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stk = 0
u8 WasStk = 0
u8 Rep = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 R = 0
u8 S = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0

data Wing bytes
  0,2,0,0,1, 1,3,1,0,1, 2,2,0,2,3, 3,3,1,2,3, 4,4,4,4,5, 5,5,5,4,5
  6,8,6,6,7, 7,7,7,6,7, 8,8,6,8,8, 9,11,9,9,10, 10,10,10,9,10, 11,11,9,11,11
end data
data StartH bytes 5,9,13,17,21,25
data PCol bytes 9,14,3,5,8,15
data MRm bytes 10,11,12,13,17,18,19,21,25
data SusRm bytes 31,30,29,48,46,45
data DkCol bytes 1,4,12,13,6,10

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  set sprite count 8
  nmi off
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 2 then
    RulesPage
    goto title
  end if
  if Menu = 3 then
    SuspectsPage
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if
  NewGame
  play sound SndRunA
  play sound SndRunB
  Cp = 0
  LoadCur
  T = 0
  if Np > 1 then HandOver
  DrawPlay
  Msg2
  print at 2,21, "SOMEONE IN THE HOUSE IS DEAD."
  print at 2,22, "FIND THE MURDERER."
  MsgT = 200

play_loop:
  Pg = 1
  Frame1
  ReadPad
  PlayStep
  if Over = 0 then goto play_loop

  ' the end: the verdict, then a press goes back to the title
  stop sound SndRunA
  stop sound SndRunB
  Reveal
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------
' the case

sub Roll:
  Rw = Rs << 7
  Rs = Rs ^ Rw
  Rw = Rs >> 9
  Rs = Rs ^ Rw
  Rw = Rs << 8
  Rs = Rs ^ Rw
  Rw = Rs >> 8
  Rw = Rw * Rn
  Rw = Rw >> 8
  Rv = Rw
  return
end sub

' IsClue: Res 1 when item Xn is not part of the solution
sub IsClue:
  Res = 1
  if Xn < 6 then
    if Xn = Ss then Res = 0
    return
  end if
  if Xn < 12 then
    V = Xn - 6
    if V = Sw then Res = 0
    return
  end if
  V = Xn - 12
  if V = Sr then Res = 0
  return
end sub

sub NewGame:
  Rn = 6
  Roll
  Ss = Rv
  Roll
  Sw = Rv
  Rn = 9
  Roll
  Sr = Rv
  Rn = 3
  Roll
  Sp = Rv + 1
  fill array ClueAt with 0
  fill array Nb with 0
  fill array Qd with 0
  fill array Pout with 0
  Rn = NClueRm
  for Xn = 0 to 20
    IsClue
    if Res = 1 then PickRoom
  next
  for I = 0 to 5
    Pw[I] = 0
    V = StartH[I]
    Ph[I] = V
    Pv[I] = 15
    Gw = 0
    Gv = 15
    Gh = V
    GetCell
    Pr[I] = Xc
  next
  Over = 0
  MsgT = 0
  return
end sub

' a free room for clue Xn
sub PickRoom:
pk_lp:
  Roll
  R = ClueRm[Rv]
  if ClueAt[R] > 0 then goto pk_lp
  ClueAt[R] = Xn + 1
  return
end sub

sub LoadCur:
  Cw = Pw[Cp]
  Ch = Ph[Cp]
  Cv = Pv[Cp]
  Cr = Pr[Cp]
  return
end sub

sub SaveCur:
  Pw[Cp] = Cw
  Ph[Cp] = Ch
  Pv[Cp] = Cv
  Pr[Cp] = Cr
  return
end sub

' ---------------------------------------------------------------------
' moving (the listing's lines 100-390, 600-750, 900-930)

sub GetCell:
  A16 = Gw
  A16 = A16 * 960
  B16 = Gv
  B16 = B16 * 40
  A16 = A16 + B16
  A16 = A16 + Gh
  Xc = Map[A16]
  Xc = Xc - 128
  return
end sub

' Res: 0 blocked, 1 a step, 2 the stairs or a new screen, 3 a passage
sub TryMove:
  Oh = Ch
  Ov = Cv
  Nh = Ch + Dh
  Nv = Cv + Dv
  Gw = Cw
  Gv = Nv
  Gh = Nh
  GetCell
  Res = 0
  if Xc > 85 then
    Secret
    if Res > 0 then Res = 3
    return
  end if
  if Xc = 62 then
    if Cr = 1 then
      Stairs
      return
    end if
  end if
  if Xc = 63 then
    if Cr = 1 then
      Stairs
      return
    end if
  end if
  if Xc > 61 then return
  if Xc = 0 then return
  if Nv = 0 then
    J = Cw * 5
    J = J + 1
    Nw = Wing[J]
    if Nw = Cw then return
    Tw = Nw
    Tv = 22
    Th = Nh
    Jump
    return
  end if
  if Nv > 22 then
    J = Cw * 5
    J = J + 2
    Nw = Wing[J]
    if Nw = Cw then return
    Tw = Nw
    Tv = 1
    Th = Nh
    Jump
    return
  end if
  if Nh = 0 then
    J = Cw * 5
    J = J + 4
    Nw = Wing[J]
    if Nw = Cw then return
    Tv = Nv
    if Cw = 4 then Tv = 6
    Tw = Nw
    Th = 38
    Jump
    return
  end if
  if Nh > 38 then
    J = Cw * 5
    J = J + 3
    Nw = Wing[J]
    if Nw = Cw then return
    Tv = Nv
    if Cw = 5 then Tv = 16
    Tw = Nw
    Th = 1
    Jump
    return
  end if
  Ch = Nh
  Cv = Nv
  Cr = Xc
  Res = 1
  return
end sub

sub Jump:
  Cw = Tw
  Cv = Tv
  Ch = Th
  Land
  Res = 2
  return
end sub

' line 915-920: off the floor, one down and one right (wrapping)
sub Land:
land_lp:
  Gw = Cw
  Gv = Cv
  Gh = Ch
  GetCell
  if Xc > 0 then
    if Xc < 62 then
      Cr = Xc
      return
    end if
  end if
  if Ch > 37 then
    Ch = Ch - 37
  else
    inc Ch
  end if
  if Cv > 21 then
    Cv = Cv - 21
  else
    inc Cv
  end if
  goto land_lp
end sub

sub Go3:
  Tw = X
  Tv = Y
  Th = W
  Jump
  return
end sub

' lines 300-390
sub Stairs:
  if Cw = 11 then
    X = 6
    Y = 7
    W = 17
    Go3
    return
  end if
  if Cw = 8 then
    if Oh > 12 then
      X = 0
      Y = 14
      W = 16
    else
      X = 2
      Y = 21
      W = 9
    end if
    Go3
    return
  end if
  if Cw = 7 then
    X = 1
    Y = 3
    W = 23
    Go3
    return
  end if
  if Cw = 6 then
    X = 11
    Y = 19
    W = 16
    Go3
    return
  end if
  if Cw = 5 then
    X = 1
    Y = 15
    W = 23
    Go3
    return
  end if
  if Cw = 4 then
    X = 2
    Y = 20
    W = 16
    Go3
    return
  end if
  if Cw = 2 then
    if Oh > 12 then
      X = 4
      Y = 10
      W = 15
    else
      X = 8
      Y = 21
      W = 7
    end if
    Go3
    return
  end if
  if Cw = 1 then
    if Ov > 9 then
      X = 5
      Y = 3
      W = 23
    else
      X = 7
      Y = 16
      W = 23
    end if
    Go3
    return
  end if
  if Cw = 0 then
    X = 8
    Y = 20
    W = 16
    Go3
  end if
  return
end sub

' lines 600-750: the fixed passages, then set-up SP
sub Secret:
  if Cw = 3 then
    X = 10
    Y = 5
    W = 14
    Go3
    return
  end if
  if Cw = 10 then
    if Nh < 18 then
      X = 3
      Y = 22
      W = 29
      Go3
      return
    end if
  end if
  if Cw = 6 then
    X = 5
    Y = 10
    W = 20
    Go3
    return
  end if
  if Cw = 5 then
    if Oh < 22 then
      X = 6
      Y = 3
      W = 14
      Go3
      return
    end if
    if Nv < 4 then
      X = 8
      Y = 7
      W = 5
      Go3
      return
    end if
  end if
  if Cw = 8 then
    if Ov = 6 then
      X = 5
      Y = 2
      W = 37
      Go3
      return
    end if
  end if
  if Sp = 1 then
    Secret1
    return
  end if
  if Sp = 2 then
    Secret2
    return
  end if
  Secret3
  return
end sub

sub Secret1:
  if Cw = 11 then
    if Cr = 52 then
      X = 8
      Y = 22
      W = 3
    else
      X = 11
      Y = Nv
      W = 21
    end if
    Go3
    return
  end if
  if Cw = 9 then
    if Cr = 4 then
      X = 4
      Y = 8
      W = 2
    else
      X = 5
      Y = 9
      W = 36
    end if
    Go3
    return
  end if
  if Cw = 10 then
    if Cr = 4 then
      X = 1
      Y = 13
      W = 28
    else
      X = 11
      Y = 6
      W = 31
    end if
    Go3
    return
  end if
  if Cw = 4 then
    X = 11
    Y = 8
    W = 3
    Go3
    return
  end if
  if Cw = 7 then
    X = 10
    Y = 6
    W = 38
    Go3
    return
  end if
  if Cw = 5 then
    if Oh > 32 then
      X = 7
      Y = 6
      W = 8
      Go3
    end if
    return
  end if
  if Cw = 1 then
    X = 9
    Y = 16
    W = 25
    Go3
    return
  end if
  if Cw = 8 then
    if Cr = 41 then
      X = 3
      Y = 5
      W = 7
      Go3
    end if
  end if
  return
end sub

sub Secret2:
  if Cw = 11 then
    if Cr = 52 then
      X = 9
      Y = 2
      W = 2
    else
      X = 11
      Y = Nv
      W = 21
    end if
    Go3
    return
  end if
  if Cw = 9 then
    if Cr = 4 then
      X = 9
      Y = 13
      W = Nh
    else
      X = 0
      Y = 5
      W = 16
    end if
    Go3
    return
  end if
  if Cw = 10 then
    if Cr = 4 then
      X = 5
      Y = 9
      W = 37
    else
      X = 8
      Y = 17
      W = 2
    end if
    Go3
    return
  end if
  if Cw = 4 then
    X = 10
    Y = 17
    W = 12
    Go3
    return
  end if
  if Cw = 7 then
    X = 1
    Y = 12
    W = 27
    Go3
    return
  end if
  if Cw = 5 then
    if Oh > 32 then
      X = 11
      Y = 22
      W = 27
      Go3
    end if
    return
  end if
  if Cw = 1 then
    X = 7
    Y = 6
    W = 12
    Go3
    return
  end if
  if Cw = 8 then
    if Cr = 41 then
      X = 7
      Y = 2
      W = 27
      Go3
    end if
  end if
  return
end sub

sub Secret3:
  if Cw = 11 then
    if Cr = 52 then
      X = 5
      Y = 9
      W = 37
    else
      X = 11
      Y = Nv
      W = 21
    end if
    Go3
    return
  end if
  if Cw = 9 then
    if Cr = 4 then
      X = 7
      Y = 6
      W = 12
    else
      X = 8
      Y = 10
      W = 15
    end if
    Go3
    return
  end if
  if Cw = 10 then
    if Cr = 4 then
      X = 10
      Y = 6
      W = Nh
    else
      X = 9
      Y = 17
      W = 2
    end if
    Go3
    return
  end if
  if Cw = 4 then
    X = 9
    Y = 2
    W = 27
    Go3
    return
  end if
  if Cw = 7 then
    X = 10
    Y = 2
    W = 12
    Go3
    return
  end if
  if Cw = 5 then
    if Oh > 32 then
      X = 8
      Y = 18
      W = 3
      Go3
    end if
    return
  end if
  if Cw = 1 then
    X = 4
    Y = 7
    W = 2
    Go3
    return
  end if
  if Cw = 8 then
    if Cr = 41 then
      X = 11
      Y = 22
      W = 21
      Go3
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------
' walking

sub PlayStep:
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then ShowHud
  end if
  if Press2 = 1 then
    MenuPage
    return
  end if
  StickDir
  if Rep = 0 then return
  Dh = 0
  Dv = 0
  if Up1 = 1 then
    Dv = 255
  else
    if Dn1 = 1 then
      Dv = 1
    else
      if Lf1 = 1 then
        Dh = 255
      else
        Dh = 1
      end if
    end if
  end if
  OldR = Cr
  TryMove
  if Res = 0 then
    play sound SndBump
    return
  end if
  inc MvN
  if Res = 1 then
    inc T
    play sound SndStep
    Fit
  else
    if Res = 3 then
      play sound SndWhoosh
    else
      play sound SndCreak
    end if
    FitNow
    DrawMap
  end if
  Arrive
  if MsgT = 0 then ShowSteps
  DoSprites
  if T > 75 then EndTurn
  return
end sub

' a new room: its name, the lamp, a clue, a suspect at home
sub Arrive:
  if Cr = OldR then return
  if MsgT = 0 then ShowName
  if Cr > 52 then return
  if Cr = 34 then return
  LampOn
  for S = 0 to 5
    if SusRm[S] = Cr then
      J = Cp * 6
      J = J + S
      if Qd[J] = 0 then
        Msg2
        Tb = 1
        Xn = S
        Ofs = 0
        Ln = 14
        Px = 2
        Py = 21
        PrTab
        print at 2,22, "IS HERE. RIGHT BUTTON: ASK."
        MsgT = 150
      end if
    end if
  next
  V = ClueAt[Cr]
  if V > 0 then
    Xn = V - 1
    J = Cp * 21
    J = J + Xn
    if Nb[J] = 0 then
      Nb[J] = 1
      Msg2
      print at 2,21, "A CLUE!"
      ShowClue
      play sound SndClue
    end if
  end if
  return
end sub

' ShowClue: item Xn on row 22
sub ShowClue:
  if Xn < 12 then
    print at 2,22, "IT WAS NOT"
    Px = 13
    Py = 22
    Ofs = 0
    if Xn < 6 then
      Tb = 1
      Ln = 14
    else
      Tb = 2
      Ln = 17
      Xn = Xn - 6
    end if
    PrTab
  else
    print at 2,22, "NOT IN THE"
    V = Xn - 12
    Xn = MRm[V]
    Tb = 0
    Ln = 17
    Ofs = 0
    Px = 13
    Py = 22
    PrTab
  end if
  MsgT = 200
  return
end sub

sub EndTurn:
  SaveCur
  if Np = 1 then
    T = 0
    Msg2
    print at 2,21, "THE HALL CLOCK STRIKES."
    print at 2,22, "A NEW TURN BEGINS."
    MsgT = 150
    return
  end if
  NextPlayer
  return
end sub

sub NextPlayer:
np_lp:
  inc Cp
  if Cp >= Np then Cp = 0
  if Pout[Cp] = 1 then goto np_lp
  LoadCur
  T = 0
  MsgT = 0
  HandOver
  DrawPlay
  return
end sub

' ---------------------------------------------------------------------
' the view

sub LampOn:
  if Lit = Cr then return
  if Lit > 0 then
    V = DimC[Lit]
    A16 = Lit
    A16 = A16 + 128
    A16 = A16 << 3
    fill V count 8 to vram.color + A16
  end if
  Lit = Cr
  V = LitC[Lit]
  A16 = Lit
  A16 = A16 + 128
  A16 = A16 << 3
  fill V count 8 to vram.color + A16
  return
end sub

' Fit: keep the walker away from the window's edges
sub Fit:
  R = 0
  V = Cx + 5
  if Ch < V then R = 1
  V = Cx + 22
  if Ch > V then R = 1
  V = Cy + 4
  if Cv < V then R = 1
  V = Cy + 15
  if Cv > V then R = 1
  if R = 0 then return
  X = Cx
  Y = Cy
  FitNow
  if X <> Cx then
    DrawMap
    return
  end if
  if Y <> Cy then DrawMap
  return
end sub

sub FitNow:
  if Ch < 14 then
    Cx = 0
  else
    Cx = Ch - 14
  end if
  if Cx > 12 then Cx = 12
  if Cv < 10 then
    Cy = 0
  else
    Cy = Cv - 10
  end if
  if Cy > 4 then Cy = 4
  return
end sub

' the window: map rows Cy to Cy + 19, columns Cx to Cx + 27, on screen
' rows 1-20, columns 2-29
sub DrawMap:
  for R = 0 to 19
    A16 = Cw
    A16 = A16 * 960
    B16 = Cy + R
    B16 = B16 * 40
    A16 = A16 + B16
    A16 = A16 + Cx
    B16 = R + 1
    B16 = B16 << 5
    B16 = B16 + 2
    copy Map + A16 count 28 to vram.name + B16
  next
  return
end sub

sub DoSprites:
  S = 1
  for I = 0 to 5
    if I = Cp then
      K = 0
      X = Ch
      Y = Cv
      W = Cw
    else
      K = S
      inc S
      X = Ph[I]
      Y = Pv[I]
      W = Pw[I]
    end if
    V = 0
    if I < Np then
      if W = Cw then V = 1
    end if
    X = X - Cx
    Y = Y - Cy
    if X > 27 then V = 0
    if Y > 19 then V = 0
    if V = 1 then
      X = X + 2
      X = X << 3
      Y = Y + 1
      Y = Y << 3
      dec Y
      W = PCol[I]
      set sprite K to Y,X,SPlayer,W
    else
      set sprite K to 192,0,0,0
    end if
  next
  set sprite 6 to 192,0,0,0
  set sprite 7 to 192,0,0,0
  update sprites
  return
end sub

sub ShowName:
  Tb = 0
  Xn = Cr
  Ofs = 0
  Ln = 20
  Px = 2
  Py = 21
  PrTab
  print at 22,21, "PLAYER"
  V = Cp + 1
  print V at 29,21 width 1
  return
end sub

sub ShowSteps:
  print at 2,22, "STEPS LEFT"
  V = 76 - T
  print V at 13,22 width 2
  print at 15,22, "  MENU: RIGHT"
  return
end sub

sub ShowHud:
  ShowName
  ShowSteps
  return
end sub

sub Msg2:
  print at 2,21, "                            "
  print at 2,22, "                            "
  return
end sub

sub PrTab:
  if Tb = 0 then
    A16 = Xn
    A16 = A16 * 20
  end if
  if Tb = 1 then
    A16 = Xn
    A16 = A16 * 14
  end if
  if Tb = 2 then
    A16 = Xn
    A16 = A16 * 18
  end if
  A16 = A16 + Ofs
  for K = 1 to Ln
    if Tb = 0 then V = RmName[A16]
    if Tb = 1 then V = SusName[A16]
    if Tb = 2 then V = WepName[A16]
    put char V at Px,Py
    inc A16
    inc Px
  next
  return
end sub

sub DrawPlay:
  NewScreen
  Lit = 0
  if Cr < 53 then
    if Cr <> 34 then LampOn
  end if
  FitNow
  DrawMap
  ShowHud
  DoSprites
  ShowScreen
  return
end sub

' ---------------------------------------------------------------------
' the menu (right button)

sub MenuPage:
  Qn = 255
  for S = 0 to 5
    if SusRm[S] = Cr then Qn = S
  next
  NewScreen
  backdrop dark blue
  print at 9,2, "WHAT NOW?"
  print at 6,5, "BACK TO THE HOUSE"
  print at 6,7, "READ THE NOTEBOOK"
  if Qn < 6 then
    print at 6,9, "QUESTION"
    Tb = 1
    Xn = Qn
    Ofs = 0
    Ln = 14
    Px = 15
    Py = 9
    PrTab
  else
    print at 6,9, "(NO ONE TO QUESTION)"
  end if
  print at 6,11, "ACCUSE SOMEONE"
  print at 6,13, "END MY TURN"
  print at 6,15, "GIVE UP THE CASE"
  print at 2,19, "STEPS LEFT"
  V = 76 - T
  print V at 13,19 width 2
  ShowScreen
  Menu = 0
  Mi = 6
  MenuCursor
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
mp_loop:
  Pg = 2
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 5 then inc Menu
    end if
    MenuCursor
    play sound SndTick
  end if
  if Press2 = 1 then
    Menu = 0
    goto mp_go
  end if
  if Press = 0 then goto mp_loop
mp_go:
  if Menu = 1 then
    NotePage
    DrawPlay
    return
  end if
  if Menu = 2 then
    if Qn > 5 then
      play sound SndNope
      goto mp_loop
    end if
    DrawPlay
    Question
    return
  end if
  if Menu = 3 then
    AccusePage
    return
  end if
  if Menu = 4 then
    EndTurnNow
    return
  end if
  if Menu = 5 then
    GiveUpPage
    return
  end if
  DrawPlay
  return
end sub

sub EndTurnNow:
  SaveCur
  if Np = 1 then
    T = 0
    DrawPlay
    Msg2
    print at 2,21, "YOU REST A WHILE."
    print at 2,22, "A NEW TURN BEGINS."
    MsgT = 150
    return
  end if
  NextPlayer
  return
end sub

' a cursor at column 4 of rows 5, 7, ... (Mi items)
sub MenuCursor:
  for K = 0 to 5
    Y = K << 1
    Y = Y + 5
    if K < Mi then put char 32 at 4,Y
  next
  Y = Menu << 1
  Y = Y + 5
  put char 62 at 4,Y
  return
end sub

sub Question:
  J = Cp * 6
  J = J + Qn
  Msg2
  Tb = 1
  Xn = Qn
  Ofs = 0
  Ln = 14
  Px = 2
  Py = 21
  PrTab
  if Qd[J] = 1 then
    print at 2,22, "HAS NOTHING MORE TO SAY."
    MsgT = 150
    play sound SndNope
    return
  end if
  Qd[J] = 1
  T = T + 20
  if Qn = Ss then
    print at 2,22, "SAW NOTHING. NOTHING AT ALL."
    MsgT = 200
    play sound SndGasp
    QEnd
    return
  end if
  ' an innocent one tells a clue you have not found, from a random start
  Rn = 21
  Roll
  W = Rv
  for K = 0 to 20
    Xn = W
    IsClue
    if Res = 1 then
      J = Cp * 21
      J = J + Xn
      if Nb[J] = 0 then
        Nb[J] = 1
        ShowClue
        play sound SndClue
        QEnd
        return
      end if
    end if
    inc W
    if W > 20 then W = 0
  next
  print at 2,22, "KNOWS NOTHING MORE."
  MsgT = 150
  QEnd
  return
end sub

sub QEnd:
  if T > 75 then
    Rearm
    wait 120 frames
    nmi off
    MsgT = 0
    EndTurn
  end if
  return
end sub

' ---------------------------------------------------------------------
' the notebook

sub NotePage:
  NewScreen
  backdrop dark blue
  print at 2,1, "NOTEBOOK OF PLAYER"
  V = Cp + 1
  print V at 21,1 width 1
  print at 3,3, "SUSPECTS"
  print at 17,3, "WEAPONS"
  print at 3,11, "ROOMS"
  for I = 0 to 20
    J = Cp * 21
    J = J + I
    V = TQm
    if Nb[J] = 1 then V = TTick
    if I < 6 then
      X = 2
      Y = I + 4
      Tb = 1
      Xn = I
      Ofs = 0
      if I < 4 then Ofs = 4
    else
      if I < 12 then
        X = 16
        Y = I - 2
        Tb = 2
        Xn = I - 6
        Ofs = 4
      else
        X = 2
        Y = I
        Tb = 0
        W = I - 12
        Xn = MRm[W]
        Ofs = 0
      end if
    end if
    put char V at X,Y
    Px = X + 1
    Py = Y
    Ln = 13
    if I < 6 then Ln = 14 - Ofs
    if Ln > 13 then Ln = 13
    PrTab
  next
  put char TTick at 16,13
  print at 18,13, "CLEARED"
  put char TQm at 16,15
  print at 18,15, "UNKNOWN"
  print at 16,18, "ONE OF EACH"
  print at 16,19, "IS GUILTY."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Pg = 3
  WaitPress
  return
end sub

' ---------------------------------------------------------------------
' accusing

' a portrait of suspect Pic, sprites 0-7, top left at tile X, Y
sub Portrait:
  for J = 0 to 5
    W = Y + J
    W = W - 1
    for K = 0 to 5
      V = TPaper
      if J = 0 then V = TFh
      if J = 5 then V = TFb
      if K = 0 then
        V = TFl
        if J = 0 then V = TFtl
        if J = 5 then V = TFbl
      end if
      if K = 5 then
        V = TFr
        if J = 0 then V = TFtr
        if J = 5 then V = TFbr
      end if
      R = X + K
      R = R - 1
      put char V at R,W
    next
  next
  PortraitSpr
  return
end sub

sub PortraitSpr:
  ' the dark layer (sprites 0-3) over the face (4-7)
  W = Pic << 5
  W = W + SButlerd0
  S = DkCol[Pic]
  for K = 0 to 3
    Px = K & 1
    Px = Px << 4
    R = X << 3
    Px = Px + R
    Py = K & 2
    Py = Py << 3
    R = Y << 3
    Py = Py + R
    dec Py
    set sprite K to Py,Px,W,S
    R = K + 4
    J = W + 16
    set sprite R to Py,Px,J,9
    W = W + 4
  next
  update sprites
  return
end sub

sub AccusePage:
  NewScreen
  backdrop dark red
  print at 4,1, "MAKE YOUR ACCUSATION"
  print at 2,4, "WHO"
  print at 2,7, "WEAPON"
  print at 2,10, "ROOM"
  print at 4,15, "ACCUSE!"
  print at 4,17, "NOT YET"
  print at 2,21, "STICK: CHOOSE. BUTTON: PICK"
  Aa = 0
  Aw = 0
  Ar = 0
  Row = 0
  ShowAccuse
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasBtn2 = 1
ap_loop:
  Pg = 4
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Row > 0 then dec Row
    end if
    if Dn1 = 1 then
      if Row < 4 then inc Row
    end if
    if Rt1 = 1 then
      if Row = 0 then
        inc Aa
        if Aa > 5 then Aa = 0
      end if
      if Row = 1 then
        inc Aw
        if Aw > 5 then Aw = 0
      end if
      if Row = 2 then
        inc Ar
        if Ar > 8 then Ar = 0
      end if
    end if
    if Lf1 = 1 then
      if Row = 0 then
        if Aa = 0 then Aa = 6
        dec Aa
      end if
      if Row = 1 then
        if Aw = 0 then Aw = 6
        dec Aw
      end if
      if Row = 2 then
        if Ar = 0 then Ar = 9
        dec Ar
      end if
    end if
    ShowAccuse
    play sound SndTick
  end if
  if Press2 = 1 then
    DrawPlay
    return
  end if
  if Press = 0 then goto ap_loop
  if Row < 3 then
    inc Row
    ShowAccuse
    play sound SndTick
    goto ap_loop
  end if
  if Row = 4 then
    DrawPlay
    return
  end if
  ' the verdict
  R = 0
  if Aa = Ss then
    if Aw = Sw then
      if Ar = Sr then R = 1
    end if
  end if
  if R = 1 then
    Over = 1
    return
  end if
  Pout[Cp] = 1
  SaveCur
  R = 0
  for I = 0 to 5
    if I < Np then
      if Pout[I] = 0 then inc R
    end if
  next
  if R = 0 then
    Over = 2
    return
  end if
  HideSprites
  NewScreen
  backdrop dark red
  print at 9,6, "W R O N G !"
  print at 4,9, "PLAYER"
  V = Cp + 1
  print V at 11,9 width 1
  print at 13,9, "IS OUT OF THE"
  print at 4,10, "GAME. THE OTHERS PLAY ON."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  play sound SndLose
  Pg = 11
  WaitPress
  NextPlayer
  return
end sub

sub ShowAccuse:
  for K = 0 to 4
    Y = K * 3
    Y = Y + 4
    if K > 2 then
      Y = K << 1
      Y = Y + 9
    end if
    V = 32
    if K = Row then V = 62
    if K < 3 then
      put char V at 1,Y
    else
      put char V at 2,Y
    end if
  next
  Tb = 1
  Xn = Aa
  Ofs = 0
  Ln = 14
  Px = 9
  Py = 4
  PrTab
  Tb = 2
  Xn = Aw
  Ln = 18
  Px = 9
  Py = 7
  PrTab
  Tb = 0
  Xn = MRm[Ar]
  Ln = 20
  Px = 9
  Py = 10
  PrTab
  Pic = Aa
  X = 22
  Y = 14
  Portrait
  return
end sub

sub GiveUpPage:
  NewScreen
  backdrop dark blue
  print at 5,5, "GIVE UP THE CASE?"
  print at 6,9, "NO, KEEP LOOKING"
  print at 6,11, "YES, TELL ME WHO"
  ShowScreen
  Menu = 0
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
gu_loop:
  Pg = 2
  put char 32 at 4,9
  put char 32 at 4,11
  Y = Menu << 1
  Y = Y + 9
  put char 62 at 4,Y
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Up1 = 1 then Menu = 0
    if Dn1 = 1 then Menu = 1
    play sound SndTick
  end if
  if Press = 0 then goto gu_loop
  if Menu = 1 then
    Over = 2
    return
  end if
  DrawPlay
  return
end sub

' the end: who, with what, where
sub Reveal:
  NewScreen
  if Over = 1 then
    backdrop dark blue
    print at 2,1, "PLAYER"
    V = Cp + 1
    print V at 9,1 width 1
    print at 11,1, "SOLVED THE CASE!"
    play sound SndWin
  else
    backdrop dark red
    print at 2,1, "THE MURDERER GOES FREE..."
    play sound SndLose
  end if
  print at 2,4, "IT WAS"
  Tb = 1
  Xn = Ss
  Ofs = 0
  Ln = 14
  Px = 2
  Py = 6
  PrTab
  print at 2,8, "WITH"
  Tb = 2
  Xn = Sw
  Ln = 18
  Px = 2
  Py = 10
  PrTab
  print at 2,12, "IN THE"
  Tb = 0
  Xn = MRm[Sr]
  Ln = 20
  Px = 2
  Py = 14
  PrTab
  print at 7,21, "PRESS THE BUTTON"
  Pic = Ss
  X = 22
  Y = 6
  Portrait
  ShowScreen
  Pg = 6
  return
end sub

' the lamp passes on
sub HandOver:
  NewScreen
  backdrop black
  print at 10,6, "PLAYER"
  V = Cp + 1
  print V at 17,6 width 1
  print at 6,9, "TAKE THE LAMP."
  print at 6,10, "YOUR TURN: 76 STEPS."
  print at 7,21, "PRESS THE BUTTON"
  V = PCol[Cp]
  set sprite 0 to 103,120,SPlayer,V
  update sprites
  ShowScreen
  Pg = 5
  WaitPress
  return
end sub

' ---------------------------------------------------------------------
' title, rules, suspects, credits

' the house on the hill: rows 3-9
sub House:
  put char TMoon00 at 24,1
  put char TMoon01 at 25,1
  put char TMoon10 at 24,2
  put char TMoon11 at 25,2
  for K = 0 to 3
    X = 9 + K
    Y = 7 - K
    put char TRoofl at X,Y
    X = 22 - K
    put char TRoofr at X,Y
  next
  for Y = 5 to 7
    X = 13
    W = 18
    if Y = 6 then
      X = 12
      W = 19
    end if
    if Y = 7 then
      X = 10
      W = 21
    end if
    for K = X to W
      put char TRoof at K,Y
    next
  next
  for Y = 8 to 11
    for X = 9 to 22
      V = TWall
      R = X & 1
      if R = 0 then
        if Y < 11 then V = TWind
      end if
      put char V at X,Y
    next
  next
  put char TWin at 12,9
  put char TDoor at 15,11
  put char TDoor at 16,11
  put char TCand00 at 4,9
  put char TCand01 at 5,9
  put char TCand10 at 4,10
  put char TCand11 at 5,10
  return
end sub

sub TitlePage:
  Pg = 7
  NewScreen
  backdrop black
  House
  print at 6,13, "THE MANSION MURDER"
  print at 8,15, "START THE CASE"
  print at 8,16, "PLAYERS:"
  print at 8,17, "HOW TO PLAY"
  print at 8,18, "THE SUSPECTS"
  print at 8,19, "CREDITS"
  print at 3,21, "LEFT AND RIGHT: PLAYERS"
  Menu = 0
  ShowTitleMenu
  X = 40
  set sprite 2 to 20,X,SGhost,15
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  WasStk = 1
tp_loop:
  Frame1
  ReadPad
  Rs = Rs + Tick
  if Rs = 0 then Rs = 1
  ' the ghost drifts across the sky, one pixel every fourth frame
  V = Tick & 3
  if V = 0 then
    inc X
    if X > 200 then X = 40
    set sprite 2 to 20,X,SGhost,15
    update sprites
  end if
  StickDir
  if Rep = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    end if
    if Dn1 = 1 then
      if Menu < 4 then inc Menu
    end if
    if Rt1 = 1 then
      if Np < 6 then inc Np
    end if
    if Lf1 = 1 then
      if Np > 1 then dec Np
    end if
    ShowTitleMenu
    play sound SndTick
  end if
  if Press = 0 then goto tp_loop
  if Menu = 1 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

sub ShowTitleMenu:
  for K = 15 to 19
    put char 32 at 6,K
  next
  V = Menu + 15
  put char 62 at 6,V
  print Np at 17,16 width 1
  return
end sub

sub RulesPage:
  Pg = 10
  NewScreen
  backdrop dark blue
  print at 6,1, "THE MANSION MURDER"
  print at 2,3, "SOMEONE KILLED THE MASTER"
  print at 2,4, "OF THE HOUSE: ONE OF SIX"
  print at 2,5, "SUSPECTS, WITH ONE OF SIX"
  print at 2,6, "WEAPONS, IN ONE OF NINE ROOMS."
  print at 2,8, "WALK THE DARK HOUSE WITH THE"
  print at 2,9, "STICK. EIGHTEEN CLUES ARE"
  print at 2,10, "HIDDEN, ONE TO A ROOM: WALK IN"
  print at 2,11, "TO FIND ONE. ASK A SUSPECT IN"
  print at 2,12, "HIS OR HER ROOM FOR A CLUE"
  print at 2,13, "(20 STEPS). A TURN IS 76 STEPS."
  print at 2,15, "STAIRS ARE TAKEN FROM THE"
  print at 2,16, "STAIRWAY. SOME WALLS HIDE"
  print at 2,17, "PASSAGES: TRY THEM."
  print at 2,19, "RIGHT BUTTON: THE MENU. ACCUSE"
  print at 2,20, "WRONGLY AND YOU ARE OUT."
  ShowScreen
  WaitPress
  return
end sub

sub SuspectsPage:
  Pic = 0
  NewScreen
  backdrop dark blue
  print at 7,1, "THE SUSPECTS"
  print at 2,21, "STICK: NEXT. BUTTON: BACK"
  ShowSuspect
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
sp_loop:
  Pg = 9
  Frame1
  ReadPad
  StickDir
  if Rep = 1 then
    if Rt1 = 1 then
      inc Pic
      if Pic > 5 then Pic = 0
    end if
    if Lf1 = 1 then
      if Pic = 0 then Pic = 6
      dec Pic
    end if
    ShowSuspect
    play sound SndTick
  end if
  if Press = 0 then goto sp_loop
  return
end sub

sub ShowSuspect:
  print at 2,12, "                            "
  print at 2,13, "                            "
  print at 2,15, "                            "
  Tb = 1
  Xn = Pic
  Ofs = 0
  Ln = 14
  Px = 9
  Py = 12
  PrTab
  print at 2,15, "LIVES IN THE"
  Tb = 0
  Xn = SusRm[Pic]
  Ln = 15
  Px = 15
  Py = 15
  PrTab
  W = Pic
  X = 14
  Y = 5
  Portrait
  return
end sub

sub CreditsPage:
  Pg = 8
  NewScreen
  backdrop dark blue
  print at 6,2, "THE MANSION MURDER"
  print at 2,5, "BASED ON MANSION (SOLVE THE"
  print at 2,6, "MANSION MURDER), AHOY! MARCH"
  print at 2,7, "1985 (COMMODORE 64). THE"
  print at 2,8, "MAGAZINE NAMES NO AUTHOR."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: WHO TURNED THE KEY?,"
  print at 2,18, "FOOTSTEPS ON THE LANDING"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
