const SSkd011 = 28
const SSkb100 = 32
const SSkd100 = 36
const SSkb101 = 40
const SSkd101 = 44
const SSkb110 = 48
const SSkd110 = 52
const SSkb111 = 56
const SSkd111 = 60
const SFallb = 64
const SFalld = 68
const SGoalie = 72
const SPuck = 76
const SShadow = 80
const NTiles8 = 1024
const SprBytes = 672
const LogoW = 25
const SndTuneA = 1
const SndTuneB = 2
const SndShot = 3
const SndWall = 4
const SndCheck = 5
const SndSave = 6
const SndPick = 7
const SndGoal = 8
const SndWhistle = 9
const SndOver = 10
const SndWin = 11
const SndTick = 12
const NSpr = 8
const HumanV = 24
const CpuV = 20
const FricN = 48
const DlyMax = 60
const StabMax = 24
const StabUp = 24
const HitCost = 6
const CoolN = 40
const NoPickN = 20
const GoalBan = 120
const ReadyN = 60

record Skater:
  i16 X
  i16 Y
  i8 VX
  i8 VY
  u8 FH
  u8 FV
  u8 St
  u8 Pow
  u8 PowT
  u8 Stab
  u8 NoPk
  u8 GY
  u8 J
  u8 Edge
  u8 WasF
  u8 Anim
  u8 Cool
end record

Skater P[2]

data GoalX bytes 30, 225
data MenuRow bytes 10, 11, 12, 13, 14

u16 TzLeft = 0
u8 TzOn = 0
' the puck (positions in 32nds of a pixel), its direction, speed delays,
' friction count, height, and who carries it (0 nobody, 1 blue, 2 red)
i16 PX = 4096
i16 PY = 3312
u8 PDX = 0
u8 PDY = 1
u8 DlyX = 4
u8 DlyY = 4
u8 PFr = FricN
u8 PH = 0
u8 PUp = 0
u8 PHt = 0
u8 Carr = 0
' the match
u8 Sc[2]
u8 GMode = 1
u8 TMin = 5
u8 GTo = 10
u16 Secs = 300
u8 ClkT = 0
u8 OT = 0
u8 Over = 0
u8 Winner = 0
u8 Scored = 0
u8 Phase = 0
u8 BanT = 0
u8 LastTo = 0
u8 StT = 0
u16 IdleF = 0
u8 NP = 1
u8 HasLast = 0
u8 LastB = 0
u8 LastR = 0
u8 Menu = 1
u8 Pg = 0
u16 Wt = 0
u8 TitleOn = 0
u8 InPlay = 0
' the computer
u8 CpuJ = 0
u8 CpuDir = 0
u8 CpuT = 1
u8 CpuHold = 0
u8 CpuCool = 0
u8 CpuShoot = 0
u8 CpuPw = 0
u8 GoT = 0
u8 CpuAy = 0
u8 CarryT = 0
u8 CpuLane = 104
u8 WasCarr = 0
u8 TgX = 128
u8 TgY = 104
u16 Seed = 12345
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 HeldT = 0
u8 Tick = 0
u8 Idle = 0
' drawn HUD state
u16 ShownSecs = 999
u8 ShownBar[2]
' scratch
u8 Pi = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 Ri = 0
u16 NumU = 0
u16 W16 = 0

  tile screen
  set sound table SlSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 3 then goto title

  NewGame
play_loop:
  Frame1
  ReadPad
  PlayFrame
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: the winner, then back to the title on a press
  InPlay = 0
  mute all
  ShowEnd
  Rearm
  wait 90 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayFrame:
  select case Phase
  case 1
    ' the goal banner
    dec BanT
    if BanT = 0 then AfterGoal
  case 2
    ' ready for the face-off
    dec BanT
    if BanT = 0 then
      Phase = 0
      DrawRinkRow(8)
      DrawRinkRow(9)
      play sound SndWhistle
    end if
  case 3
    ' the overtime banner
    dec BanT
    if BanT = 0 then
      DrawRinkRow(8)
      DrawRinkRow(9)
      Phase = 0
      play sound SndWhistle
    end if
  case else
    RunPlay
  end select
  return
end sub

sub RunPlay:
  if NP = 1 then CpuThink
  SetSticks
  for Pi = 0 to 1
    MoveGoalie(Pi)
  next
  for Pi = 0 to 1
    SkaterTurn(Pi)
  next
  if Carr <> 0 then
    CarryPuck
  else
    MovePuck
  end if
  if Scored <> 0 then
    GoalScored
    return
  end if
  for Pi = 0 to 1
    GoalieSave(Pi)
  next
  TryPickup
  Upkeep
  Clock
  return
end sub

' the sticks of this frame: blue = controller 1 (either in one-player),
' red = controller 2 or the computer; the button's press edge
sub SetSticks:
  if NP = 1 then
    P[0].J = J1 | J2
    P[1].J = CpuJ
  else
    P[0].J = J1
    P[1].J = J2
  end if
  for Pi = 0 to 1
    V = P[Pi].J & 16
    P[Pi].Edge = 0
    if V <> 0 then
      if P[Pi].WasF = 0 then P[Pi].Edge = 1
    end if
    P[Pi].WasF = V
  next
  return
end sub

' a goalie follows his stick up and down (the computer's tracks the puck)
sub MoveGoalie(u8 Who):
  u8 G = 0
  u8 B = 0
  u8 Qy = 0
  G = P[Who].GY
  B = P[Who].J
  if Who = 1 then
    if NP = 1 then
      B = 0
      Qy = PY >> 5
      if PX < 5632 then Qy = 104
      if Carr = 0 then
        if PDX = 0 then Qy = G
      end if
      inc GoT
      if GoT >= 4 then GoT = 0
      if GoT = 0 then
        if Qy > G + 1 then B = 2
        if Qy + 1 < G then B = 1
      end if
    end if
  end if
  if (B & 1) <> 0 then dec G
  if (B & 2) <> 0 then inc G
  if G < 86 then G = 86
  if G > 121 then G = 121
  P[Who].GY = G
  return
end sub

' a skater's frame: skate, start a wind-up or check, charge a shot
sub SkaterTurn(u8 Who):
  if P[Who].St = 0 then
    MoveSkater(Who)
    if P[Who].Edge = 1 then
      if Carr = Who + 1 then
        P[Who].St = 1
        P[Who].Pow = 0
        P[Who].PowT = 0
      else
        TryCheck(Who)
      end if
    end if
  end if
  if P[Who].St = 1 then Charge(Who)
  return
end sub

function Clip(i8 V, i8 Lo, i8 Hi) as i8
  if V < Lo then return Lo
  if V > Hi then return Hi
  return V

' momentum: the stick changes the speed on each axis by 2 a frame
sub MoveSkater(u8 Who):
  i16 X = 0
  i16 Y = 0
  i8 Vx = 0
  i8 Vy = 0
  i8 Vm = HumanV
  i8 Nm = 0
  u8 B = 0
  X = P[Who].X
  Y = P[Who].Y
  Vx = P[Who].VX
  Vy = P[Who].VY
  B = P[Who].J
  if Who = 1 then
    if NP = 1 then Vm = CpuV
  end if
  Nm = 0 - Vm
  if (B & 8) <> 0 then
    Vx = Clip(Vx + 2, Nm, Vm)
    P[Who].FH = 1
  elseif (B & 4) <> 0 then
    Vx = Clip(Vx - 2, Nm, Vm)
    P[Who].FH = 0
  elseif (Tick & 3) = 0 then
    if Vx > 0 then
      Vx = Vx - 1
    elseif Vx < 0 then
      Vx = Vx + 1
    end if
  end if
  if (B & 2) <> 0 then
    Vy = Clip(Vy + 2, Nm, Vm)
    P[Who].FV = 1
  elseif (B & 1) <> 0 then
    Vy = Clip(Vy - 2, Nm, Vm)
    P[Who].FV = 0
  elseif (Tick & 3) = 0 then
    if Vy > 0 then
      Vy = Vy - 1
    elseif Vy < 0 then
      Vy = Vy + 1
    end if
  end if
  X = X + Vx
  Y = Y + Vy
  if X < 1152 then
    X = 1152
    Vx = 0
  end if
  if X > 7008 then
    X = 7008
    Vx = 0
  end if
  if Y < 1152 then
    Y = 1152
    Vy = 0
  end if
  if Y > 5472 then
    Y = 5472
    Vy = 0
  end if
  P[Who].X = X
  P[Who].Y = Y
  P[Who].VX = Vx
  P[Who].VY = Vy
  P[Who].Anim = 0
  if Vx <> 0 then P[Who].Anim = (Tick >> 3) & 1
  if Vy <> 0 then P[Who].Anim = (Tick >> 3) & 1
  return
end sub

' winding up: the shot grows every 6 frames while the button is held
sub Charge(u8 Who):
  if (P[Who].J & 16) <> 0 then
    inc P[Who].PowT
    if P[Who].PowT >= 6 then
      P[Who].PowT = 0
      inc P[Who].Pow
      if P[Who].Pow >= 13 then Shoot(Who)
    end if
  else
    Shoot(Who)
  end if
  return
end sub

sub Shoot(u8 Who):
  u8 Pw = 0
  u8 Qy = 0
  Pw = P[Who].Pow
  Carr = 0
  DlyX = 15 - Pw
  if DlyX < 2 then DlyX = 2
  Qy = PY >> 5
  if Qy >= 82 and Qy <= 125 then
    DlyY = 15
  else
    DlyY = 15 - (Pw >> 1)
  end if
  PDX = P[Who].FH
  PDY = P[Who].FV
  PH = 0
  PHt = 0
  PUp = 0
  if Pw >= 11 then PUp = 1
  PFr = FricN
  P[Who].NoPk = NoPickN
  P[Who].St = 0
  play sound SndShot
  return
end sub

' how far apart two things are, in pixels, on one axis
function Apart(i16 A, i16 B) as u8
  u8 Pa = 0
  u8 Pb = 0
  Pa = A >> 5
  Pb = B >> 5
  return absdiff(Pa, Pb)

' a body check on the other skater
sub TryCheck(u8 Who):
  u8 O = 0
  O = 1 - Who
  if P[Who].Cool > 0 then exit sub
  if P[O].St = 2 then exit sub
  if Apart(P[Who].X, P[O].X) > 10 then exit sub
  if Apart(P[Who].Y, P[O].Y) > 12 then exit sub
  play sound SndCheck
  P[Who].Cool = CoolN
  if Carr = O + 1 then
    Carr = 0
    PUp = 1
    PH = 0
    PHt = 0
    PDX = P[O].FH
    PDY = P[O].FV
    DlyX = 15
    DlyY = 15
    PFr = FricN
    P[O].NoPk = NoPickN
  end if
  if P[O].St = 1 then P[O].St = 0
  if P[O].Stab < HitCost then
    P[O].Stab = 0
    P[O].St = 2
    P[O].VX = 0
    P[O].VY = 0
  else
    P[O].Stab = P[O].Stab - HitCost
  end if
  return
end sub

' the carried puck rides at the skater's facing diagonal
sub CarryPuck:
  K = Carr - 1
  PX = P[K].X - 192
  if P[K].FH = 1 then PX = P[K].X + 192
  PY = P[K].Y - 224
  if P[K].FV = 1 then PY = P[K].Y + 224
  return
end sub

' the loose puck: a diagonal move, the boards, the goals, friction, height
sub MovePuck:
  u8 Qy = 0
  u8 S = 0
  S = SpdT[DlyX]
  if PDX = 1 then
    PX = PX + S
  else
    PX = PX - S
  end if
  S = SpdT[DlyY]
  if PDY = 1 then
    PY = PY + S
  else
    PY = PY - S
  end if
  if PY < 992 then
    PY = 992
    PDY = 1
    play sound SndWall
  end if
  if PY > 5632 then
    PY = 5632
    PDY = 0
    play sound SndWall
  end if
  Qy = PY >> 5
  if PX < 864 then
    if InMouth(Qy) = 1 then
      Scored = 2
      return
    end if
    PX = 864
    PDX = 1
    play sound SndWall
  end if
  if PX > 7296 then
    if InMouth(Qy) = 1 then
      Scored = 1
      return
    end if
    PX = 7296
    PDX = 0
    play sound SndWall
  end if
  if PUp = 0 and PH = 0 then
    dec PFr
    if PFr = 0 then
      PFr = FricN
      if DlyX < DlyMax then inc DlyX
      if DlyY < DlyMax then inc DlyY
    end if
  else
    inc PHt
    if PHt >= 5 then
      PHt = 0
      if PUp = 1 then
        inc PH
        if PH >= 4 then PUp = 0
      else
        dec PH
      end if
    end if
  end if
  return
end sub

function InMouth(u8 Qy) as u8
  if Qy < 84 then return 0
  if Qy > 123 then return 0
  return 1

' a goalie stops the puck and sends it back out
sub GoalieSave(u8 Who):
  i16 Gx = 0
  u8 Gp = 0
  Gp = GoalX[Who]
  Gx = Gp
  Gx = Gx << 5
  if Apart(PX, Gx) > 6 then exit sub
  Gp = PY >> 5
  if absdiff(Gp, P[Who].GY) > 7 then exit sub
  if Who = 0 then
    PDX = 1
    PX = Gx + 224
  else
    PDX = 0
    PX = Gx - 224
  end if
  PH = 0
  PUp = 0
  PHt = 0
  if Carr <> 0 then
    K = Carr - 1
    if P[K].St = 1 then P[K].St = 0
    P[K].NoPk = NoPickN
    Carr = 0
  end if
  play sound SndSave
  return
end sub

' a skater over the loose puck on the ice takes it (blue first)
sub TryPickup:
  u8 N = 0
  if Carr <> 0 then exit sub
  if PH <> 0 then exit sub
  if PUp <> 0 then exit sub
  for N = 0 to 1
    ' blue and red take turns at being first (frame by frame)
    Pi = (Tick + N) & 1
    if Carr = 0 then
      if P[Pi].St <> 2 then
        if P[Pi].NoPk = 0 then
          if Apart(PX, P[Pi].X) <= 7 then
            if Apart(PY, P[Pi].Y) <= 9 then
              Carr = Pi + 1
              DlyX = 15
              DlyY = 15
              play sound SndPick
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' the no-pickup counts and stability
sub Upkeep:
  for Pi = 0 to 1
    if P[Pi].NoPk > 0 then dec P[Pi].NoPk
    if P[Pi].Cool > 0 then dec P[Pi].Cool
  next
  inc StT
  if StT >= StabUp then
    StT = 0
    for Pi = 0 to 1
      if P[Pi].Stab < StabMax then inc P[Pi].Stab
      if P[Pi].St = 2 then
        if P[Pi].Stab >= 8 then P[Pi].St = 0
      end if
    next
  end if
  return
end sub

' the game clock (TIME games and overtime) and the idle stop
sub Clock:
  if NP = 2 then
    if (J1 | J2) = 0 then
      inc IdleF
      if IdleF >= 7200 then Over = 1
    else
      IdleF = 0
    end if
  end if
  if GMode = 2 then
    if OT = 0 then return
  end if
  inc ClkT
  if ClkT < 60 then return
  ClkT = 0
  dec Secs
  ShowClock
  if Secs <> 0 then return
  if OT = 1 then
    Over = 1
    return
  end if
  if Sc[0] = Sc[1] then
    OT = 1
    Secs = 300
    Phase = 3
    BanT = 180
    print at 4,8, "      OVERTIME!       "
    print at 4,9, " NEXT GOAL WINS IT!   "
    print at 11,2, "OVERTIME"
    ShowClock
    play sound SndWhistle
  else
    Over = 1
  end if
  return
end sub

sub GoalScored:
  K = Scored - 1
  inc Sc[K]
  LastTo = Scored
  Scored = 0
  ShowScores
  if K = 0 then
    print at 4,8, "   GOAL! BLUE SCORES  "
  else
    print at 4,8, "   GOAL! RED SCORES   "
  end if
  play sound SndGoal
  Phase = 1
  BanT = GoalBan
  return
end sub

sub AfterGoal:
  if OT = 1 then
    Over = 1
    return
  end if
  if GMode = 2 then
    K = LastTo - 1
    if Sc[K] >= GTo then
      Over = 1
      return
    end if
  end if
  DrawRinkRow(8)
  FaceOff
  print at 4,8, "        READY         "
  Phase = 2
  BanT = ReadyN
  return
end sub

' everyone back in place; the puck heads for the side that let in the
' last goal (blue at the start)
sub FaceOff:
  PX = 4096
  PY = 3312
  PDX = 0
  if LastTo = 1 then PDX = 1
  PDY = 1
  DlyX = 4
  DlyY = 4
  PFr = FricN
  PH = 0
  PUp = 0
  PHt = 0
  Carr = 0
  for Pi = 0 to 1
    P[Pi].Y = 3328
    P[Pi].VX = 0
    P[Pi].VY = 0
    P[Pi].FV = 1
    P[Pi].St = 0
    P[Pi].Pow = 0
    P[Pi].PowT = 0
    P[Pi].NoPk = 0
    P[Pi].Cool = 0
    P[Pi].GY = 104
    P[Pi].Anim = 0
  next
  P[0].X = 3456
  P[0].FH = 1
  P[1].X = 4736
  P[1].FH = 0
  CpuT = 1
  CpuHold = 0
  CpuShoot = 0
  CpuDir = 0
  CpuJ = 0
  return
end sub

' ---------------------------------------------------------------------------
' the computer's red team

function Rnd as u8
  Seed = Seed * 75
  Seed = Seed + 74
  return highbyte Seed

function Toward(u8 Fx, u8 Fy, u8 Tx, u8 Ty) as u8
  u8 B = 0
  if Tx > Fx + 3 then B = 8
  if Tx + 3 < Fx then B = 4
  if Ty > Fy + 3 then B = B | 2
  if Ty + 3 < Fy then B = B | 1
  return B

' where a red shot of power Pw from here would cross the left goal line
' (pixels; the boards reflect it; friction is left out)
function AimY(u8 Pw) as u8
  u16 Dx = 0
  u16 T = 0
  u16 Dy = 0
  u8 Ix = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Y0 = 0
  i16 Y = 0
  Ix = 15 - Pw
  if Ix < 2 then Ix = 2
  Sx = SpdT[Ix]
  Y0 = PY >> 5
  Ix = 15 - (Pw >> 1)
  if Y0 >= 82 and Y0 <= 125 then Ix = 15
  Sy = SpdT[Ix]
  Dx = PX >> 5
  Dx = Dx - 27
  T = Dx * 32
  T = T / Sx
  Dy = T * Sy
  Dy = Dy >> 5
  Y = Y0
  if P[1].FV = 1 then
    Y = Y + Dy
  else
    Y = Y - Dy
  end if
  while Y < 31 or Y > 176
    if Y < 31 then Y = 62 - Y
    if Y > 176 then Y = 352 - Y
  end while
  return Y

' the computer's shot: the strongest of 13, 11, 9, 7, 5 that goes in
sub CpuPick:
  u8 Ay = 0
  u8 Pw = 0
  u8 Best = 0
  for Pw = 13 to 5 step -2
    if Best = 0 then
      Ay = AimY(Pw)
      if Ay >= 87 and Ay <= 120 then
        if absdiff(Ay, P[0].GY) > 12 then
          Best = Pw
          CpuAy = Ay
        end if
      end if
    end if
  next
  if Best > 0 then
    CpuShoot = 1
    CpuPw = Best
  end if
  return
end sub

sub CpuThink:
  u8 Sx = 0
  u8 Sy = 0
  u8 Bx = 0
  u8 By = 0
  u8 F = 0
  Sx = P[1].X >> 5
  Sy = P[1].Y >> 5
  Bx = P[0].X >> 5
  By = P[0].Y >> 5
  if CpuCool > 0 then dec CpuCool
  if Carr = 2 then
    if CarryT < 255 then inc CarryT
  end if
  if Carr <> WasCarr then
    WasCarr = Carr
    CarryT = 0
    CpuLane = 64 + (Rnd() & 63) + (Rnd() & 15)
  end if
  dec CpuT
  if CpuT = 0 then
    CpuT = 10
    select case Carr
    case 2
      ' carry toward a shooting spot, then shoot when a wind-up would put
      ' the puck in the mouth away from the blue goalie
      TgX = 84
      TgY = CpuLane
      F = P[1].FH
      if absdiff(Sx, TgX) < 6 then
        if absdiff(Sy, TgY) < 6 then CpuLane = 64 + (Rnd() & 63) + (Rnd() & 15)
      end if
      if F = 0 then
        if Sx < 140 then CpuPick
        if CpuShoot = 0 then
          if CarryT > 200 then
            if Sx < 150 then
              CpuShoot = 1
              CpuPw = 9
            end if
          end if
        end if
      end if
      if Sx < 170 then
        if absdiff(Sx, Bx) < 16 then
          if absdiff(Sy, By) < 16 then
            if CpuShoot = 0 then
              CpuShoot = 1
              CpuPw = 6
            end if
          end if
        end if
      end if
      if F = 1 then CpuShoot = 0
    case 1
      TgX = Bx
      TgY = By
    case else
      TgX = PX >> 5
      TgY = PY >> 5
      if PDX = 1 then
        TgX = TgX + 4
      else
        TgX = TgX - 4
      end if
    end select
    CpuDir = Toward(Sx, Sy, TgX, TgY)
  end if
  F = 0
  if P[1].St = 1 then
    if CpuHold > 0 then
      dec CpuHold
      F = 16
    end if
  elseif Carr = 2 then
    if CpuShoot = 1 then
      CpuShoot = 0
      CpuHold = CpuPw * 6 + (Rnd() & 3)
      F = 16
    end if
  elseif Carr = 1 then
    if CpuCool = 0 then
      if absdiff(Sx, Bx) <= 9 then
        if absdiff(Sy, By) <= 11 then
          CpuCool = 30
          if Rnd() < 128 then F = 16
        end if
      end if
    end if
  end if
  CpuJ = CpuDir | F
  return
end sub

' ---------------------------------------------------------------------------
' drawing

sub DrawSprites:
  u8 Sx = 0
  u8 Sy = 0
  u8 Pb = 0
  u8 Pc = 0
  u8 Cl = 0
  if TitleOn = 1 then
    set sprite 0 to 160,148,SPuck,1
    set sprite 1 to 150,110,SSkd110,1
    set sprite 2 to 150,156,SSkd100,1
    set sprite 3 to 150,110,SSkb110,5
    set sprite 4 to 150,156,SSkb100,8
    update sprites
    return
  end if
  Sx = PX >> 5
  Sy = PY >> 5
  Sx = Sx - 8
  Sy = Sy - 9
  if PH > 0 then
    set sprite 7 to Sy,Sx,SShadow,14
  else
    set sprite 7 to 192,0,0,0
  end if
  Sy = Sy - PH * 2
  set sprite 0 to Sy,Sx,SPuck,1
  for Pi = 0 to 1
    Sx = P[Pi].X >> 5
    Sy = P[Pi].Y >> 5
    Sx = Sx - 8
    Sy = Sy - 9
    if P[Pi].St = 2 then
      Pb = SFallb
      Pc = SFalld
    else
      Pb = P[Pi].FV * 2 + P[Pi].FH
      Pb = Pb * 2 + P[Pi].Anim
      Pb = SSkb000 + Pb * 8
      Pc = Pb + 4
    end if
    Cl = 5
    if Pi = 1 then Cl = 8
    set sprite Pi + 1 to Sy,Sx,Pc,1
    set sprite Pi + 3 to Sy,Sx,Pb,Cl
    Sx = GoalX[Pi] - 8
    Sy = P[Pi].GY - 9
    Cl = 4
    if Pi = 1 then Cl = 6
    set sprite Pi + 5 to Sy,Sx,SGoalie,Cl
  next
  update sprites
  return
end sub

sub DrawRinkRow(u8 R):
  W16 = R - 3
  W16 = W16 * 28
  copy RinkMap + W16 count 28 to vram.name + 2 + R * 32
  return
end sub

sub DrawRink:
  for Ri = 3 to 22
    DrawRinkRow(Ri)
  next
  return
end sub

sub ShowScores:
  print at 2,1, "BLUE"
  NumU = Sc[0]
  print at 7,1, digits$(NumU, 2)
  print at 23,1, "RED"
  NumU = Sc[1]
  print at 27,1, digits$(NumU, 2)
  return
end sub

sub ShowClock:
  u16 M = 0
  u16 S = 0
  if GMode = 2 then
    if OT = 0 then
      print at 13,1, "TO "
      NumU = GTo
      print at 16,1, digits$(NumU, 2)
      return
    end if
  end if
  M = Secs / 60
  S = Secs - M * 60
  print at 13,1, digits$(M, 2)
  print at 15,1, ":"
  print at 16,1, digits$(S, 2)
  ShownSecs = Secs
  return
end sub

' stability: three bar tiles per skater, 2 points a step
sub ShowBars:
  u8 S = 0
  u8 N = 0
  u8 Col = 0
  u8 T0 = 0
  for Pi = 0 to 1
    S = P[Pi].Stab >> 1
    if S <> ShownBar[Pi] then
      ShownBar[Pi] = S
      Col = 2
      T0 = TBarb0
      if Pi = 1 then
        Col = 27
        T0 = TBarr0
      end if
      for K = 0 to 2
        N = S
        if N > 4 then N = 4
        put char T0 + N at Col + K,2
        S = S - N
      next
    end if
  next
  return
end sub

sub ShowEnd:
  u8 B = 0
  B = Sc[0]
  LastB = B
  LastR = Sc[1]
  HasLast = 1
  DrawRinkRow(8)
  print at 4,9, "                      "
  print at 4,10, "      GAME  OVER      "
  if B > Sc[1] then
    if NP = 1 then
      print at 4,11, "      YOU WIN!        "
    else
      print at 4,11, "     BLUE WINS!       "
    end if
    play sound SndWin
  elseif B < Sc[1] then
    if NP = 1 then
      print at 4,11, "  THE COMPUTER WINS   "
      play sound SndOver
    else
      print at 4,11, "      RED WINS!       "
      play sound SndWin
    end if
  else
    print at 4,11, "        A DRAW        "
    play sound SndOver
  end if
  print at 4,12, "                      "
  return
end sub

sub NewGame:
  Sc[0] = 0
  Sc[1] = 0
  Over = 0
  OT = 0
  Scored = 0
  LastTo = 0
  IdleF = 0
  ClkT = 0
  StT = 0
  TitleOn = 0
  W16 = TMin
  Secs = W16 * 60
  for Pi = 0 to 1
    P[Pi].Stab = 11
    P[Pi].WasF = 16
    ShownBar[Pi] = 99
  next
  FaceOff
  NewScreen
  DrawRink
  ShowScores
  ShowClock
  ShowBars
  print at 4,8, "        READY         "
  Phase = 2
  BanT = ReadyN
  DrawSprites
  ShowScreen
  InPlay = 1
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  if InPlay = 1 then ShowBars
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the logo, the options, LAST GAME; the tune once
sub TitlePage:
  NewScreen
  for Ri = 0 to 2
    W16 = Ri * LogoW
    copy LogoMap + W16 count LogoW to vram.name + 3 + (Ri + 3) * 32
  next
  print at 5,7, "BY JOHN FEDOR (1989)"
  for Ri = 18 to 22
    W16 = Ri - 18
    W16 = W16 * 28
    copy RinkMap + W16 count 28 to vram.name + 2 + Ri * 32
  next
  if HasLast = 1 then
    print at 3,15, "LAST GAME  BLUE 00  RED 00"
    NumU = LastB
    print at 19,15, digits$(NumU, 2)
    NumU = LastR
    print at 27,15, digits$(NumU, 2)
  end if
  print at 3,16, "STICK: CHOOSE  BUTTON: GO"
  ' back from HOW TO PLAY or CREDITS: the cursor on TIME GAME again
  if Menu >= 3 then Menu = 1
  TitleOn = 1
  InPlay = 0
  ShowMenu
  DrawSprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 528
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  V = J1 | J2
  V = V & 15
  if V <> WasStick then
    HeldT = 0
    if V <> 0 then MenuStick(V)
  elseif V <> 0 then
    inc HeldT
    if HeldT >= 24 then
      HeldT = 18
      if (V & 12) <> 0 then MenuStick(V & 12)
    end if
  end if
  WasStick = V
  K = Rnd()
  if Press = 0 then goto tp_loop
  if Menu = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  GMode = Menu
  if Menu = 3 then HowToPage
  if Menu = 4 then CreditsPage
  return
end sub

sub MenuStick(u8 S):
  if (S & 1) <> 0 then
    if Menu > 0 then dec Menu
  end if
  if (S & 2) <> 0 then
    if Menu < 4 then inc Menu
  end if
  if (S & 12) <> 0 then
    select case Menu
    case 0
      NP = 3 - NP
    case 1
      if (S & 4) <> 0 then
        if TMin > 1 then dec TMin
      else
        if TMin < 99 then inc TMin
      end if
    case 2
      if (S & 4) <> 0 then
        if GTo > 1 then dec GTo
      else
        if GTo < 99 then inc GTo
      end if
    end select
  end if
  play sound SndTick
  ShowMenu
  return
end sub

sub ShowMenu:
  print at 7,10, "PLAYERS      "
  NumU = NP
  print at 20,10, digits$(NumU, 1)
  print at 7,11, "TIME GAME    "
  NumU = TMin
  print at 20,11, digits$(NumU, 2)
  print at 22,11, ":00"
  print at 7,12, "GOAL GAME    "
  NumU = GTo
  print at 20,12, digits$(NumU, 2)
  print at 7,13, "HOW TO PLAY"
  print at 7,14, "CREDITS"
  for Ri = 0 to 4
    put char 32 at 5,MenuRow[Ri]
  next
  put char 62 at 5,MenuRow[Menu]
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "ICE HOCKEY, ONE AGAINST ONE."
    print at 2,4, "EACH TEAM HAS A SKATER AND"
    print at 2,5, "A GOALIE."
    print at 2,7, "BLUE (CONTROLLER 1) SHOOTS"
    print at 2,8, "AT THE RIGHT GOAL. RED"
    print at 2,9, "(CONTROLLER 2 OR THE"
    print at 2,10, "COMPUTER) AT THE LEFT ONE."
    print at 2,12, "PUT THE PUCK IN THE GOAL!"
    for Ri = 15 to 19
      W16 = Ri - 15
      W16 = W16 * 28
      copy RinkMap + W16 count 28 to vram.name + 2 + Ri * 32
    next
    set sprite 0 to 143,148,SPuck,1
    set sprite 1 to 126,110,SSkd110,1
    set sprite 2 to 126,156,SSkd100,1
    set sprite 3 to 126,110,SSkb110,5
    set sprite 4 to 126,156,SSkb100,8
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK: SKATE. YOUR GOALIE"
    print at 2,4, "MOVES UP AND DOWN WITH IT."
    print at 2,6, "SKATE OVER THE PUCK TO TAKE"
    print at 2,7, "IT. HOLD THE BUTTON TO WIND"
    print at 2,8, "UP, LET GO TO SHOOT. LONGER"
    print at 2,9, "MEANS HARDER. A FULL SLAP"
    print at 2,10, "SHOT FLIES OVER THE STICKS."
    print at 2,12, "NO PUCK? THE BUTTON BODY-"
    print at 2,13, "CHECKS THE OTHER SKATER: HE"
    print at 2,14, "LOSES THE PUCK. CHECK HIM"
    print at 2,15, "OFTEN AND HE FALLS DOWN."
    for Ri = 16 to 20
      W16 = Ri - 16
      W16 = W16 * 28
      copy RinkMap + W16 count 28 to vram.name + 2 + Ri * 32
    next
    set sprite 0 to 154,126,SPuck,1
    set sprite 1 to 142,110,SSkd110,1
    set sprite 2 to 142,110,SSkb110,5
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "EACH GOAL IS ONE POINT."
    print at 2,5, "TIME GAME: THE MOST GOALS"
    print at 2,6, "WHEN THE CLOCK RUNS OUT."
    print at 2,7, "A TIE GOES TO OVERTIME: THE"
    print at 2,8, "NEXT GOAL WINS."
    print at 2,10, "GOAL GAME: THE FIRST TO THE"
    print at 2,11, "GOALS YOU SET WINS."
    print at 2,13, "THE BARS AT THE BOTTOM SHOW"
    print at 2,14, "EACH SKATER'S BALANCE."
    print at 2,16, "TIP: SHOOT FROM IN FRONT OF"
    print at 2,17, "THE GOAL - A STRAIGHT SHOT"
    print at 2,18, "IS HARDER TO STOP."
    set sprite 0 to 159,80,SGoalie,4
    set sprite 1 to 159,160,SGoalie,6
    set sprite 2 to 164,120,SPuck,15
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_wait:
  Frame1
  ReadPad
  Wt = Wt + 1
  if Wt >= 1800 then return
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "SLAP  SHOT"
  print at 2,4, "BASED ON SLAP SHOT BY JOHN"
  print at 2,5, "FEDOR, COMPUTE!'S GAZETTE,"
  print at 2,6, "OCTOBER 1989 (COMMODORE 64)."
  print at 2,9, "COLECOVISION GAME, MUSIC"
  print at 2,10, "AND PICTURES BY CLAUDE"
  print at 2,11, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "IN AMY BY AMY BIENVENU,"
  print at 2,13, "2026."
  print at 2,16, "MUSIC: BREAKAWAY"
  print at 2,17, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

