project "Dacman Diagnostic"
cartridge "DACMAN DIAG/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

asset DacmanGameColorRle from "@project/dacman-game.color.zx0" codec zx0
asset DacmanGrafx from "@project/dacman-grafx.bin" codec raw
asset DacmanNumbers from "@project/dacman-numbers.bin" codec raw
asset DacmanFont from "@project/dacman-font.bin" codec raw
asset DacmanDieze from "@project/dacman-dieze.bin" codec raw
asset DacmanEtoile from "@project/dacman-etoile.bin" codec raw
asset DacmanMedaille from "@project/dacman-medaille.bin" codec raw
asset DacmanMissSprites from "@project/dacman-mssprites.bin" codec raw
const BoardLeft = 6
const BoardTop = 2
const BoardWidth = 19
const BoardHeight = 21
const WallMask = $80
const DotTile = $A0
const PowerDotTile = $A1
const PacRightTile = $A2
const PacDownTile = $A3
const PacLeftTile = $A4
const PacUpTile = $A5
const PacClosedTile = $A6
const Ghost0Tile = $AB
const Ghost1Tile = $AC
const Ghost2Tile = $AD
const BlueGhostTile = $AE
const GhostHomeTile = $AF
sub DacmanInitGraphics:
  screen off
  nmi off
  mode 2 screen
  cls
  copy DacmanNumbers count 80 to vram.pattern + 48 * 8
  copy DacmanFont count 224 to vram.pattern + 65 * 8
  copy DacmanDieze count 8 to vram.pattern + 35 * 8
  copy DacmanEtoile count 8 to vram.pattern + 42 * 8
  copy DacmanMedaille count 96 to vram.pattern + 224 * 8
  copy DacmanGrafx count 672 to vram.pattern + 128 * 8
  duplicate mode 2 patterns
  decompress DacmanGameColorRle to vram.color
  copy DacmanMissSprites count 64 to vram.spr_pat
  backdrop black
  screen on
  nmi on
  return

sub start:
  mode 2 screen
  sprites 16x16
  sprites simple
  DacmanInitGraphics
  print at 1,1, "GRAPHICS INIT OK"
  loop forever
end sub
