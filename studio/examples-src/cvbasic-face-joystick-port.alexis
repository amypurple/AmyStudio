u8 X = 50
u8 Y = 100

u8 FaceColor = 10
u8 SpriteY = 99

data HappyAlienBugFace sprite16
  "...XX.......XX.."
  "..XX..X....X..X."
  "XX....XXXXX...XX"
  "....XXXXXXXXX..X"
  "...XX..XXX..XX.."
  "...X....X....XX."
  "..XX.XX.X.XX.XX."
  ".XXXXXXXXXXXXXXX"
  ".XXXXXXXXXXXXXXX"
  ".XXXXXXXXXXXXXXX"
  ".XXX.........XXX"
  "..XX.........XX."
  "..XXX.......XXX."
  "...XXXX...XXXX.."
  "....XXXXXXXXX..."
  ".......XXXX....."
end data

  text screen
  sprites 16x16
  sprites simple
  copy HappyAlienBugFace to vram.spr_pat
  clear sprites
  set sprite count 2
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "JOY CONTROLLED FACE"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  cls
  print at 1,1, "Alien bug face!"
  print at 1,0, "VDP.STATUS ="
  set sprite 1 to 95,128,0,14
game_loop:
  wait
  print vdp.status at 13,0 digits 3
  FaceColor = 10
  if joypad(1).up then
    if Y > 0 then Y -= 1
  end if
  if joypad(1).left then
    if X > 0 then X -= 1
  end if
  if joypad(1).right then
    if X < 240 then X += 1
  end if
  if joypad(1).down then
    if Y < 176 then Y += 1
  end if
  if joypad(1).button1 then FaceColor = 5
  if joypad(1).button2 then FaceColor = 6
  SpriteY = Y - 1
  set sprite 0 to SpriteY,X,0,FaceColor
  update sprites
  goto game_loop