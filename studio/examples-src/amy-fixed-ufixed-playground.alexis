' Fixed-point motion state.
fixed SignedPos = 12.5, Velocity = -0.25
ufixed ScreenPos = 40.75, Drift = 1.25
u16 Stretch = 9
' Derived pixel state and checks.
u8 PixelSigned = 0, PixelScreen = 0, Scale = 12
u8 Pass1 = 0, Pass2 = 0, Pass3 = 0, Pass4 = 0, Pass5 = 0, Pass6 = 0, PassFloor = 0, PassOps = 0

' Amy Fixed / UFixed Playground
  text screen
  run_demo
  screen on

sub run_demo:
  print at 7,0, "FIXED / UFIXED"
  print at 1,4, "fixed += 1.00"
  SignedPos += 1
  print SignedPos at 18,4
  print at 1,6, "fixed -= .25"
  SignedPos += Velocity
  print SignedPos at 18,6
  print at 1,8, "ufixed += 1.25"
  ScreenPos += Drift
  print ScreenPos at 18,8
  print at 1,10, "ufixed -= .75"
  ScreenPos -= 0.75
  print ScreenPos at 18,10
  PixelSigned = floor SignedPos
  PixelScreen = floor ScreenPos
  print at 1,12, "floor fixed"
  print PixelSigned at 18,12 digits 3
  print at 1,13, "floor ufixed"
  print PixelScreen at 18,13 digits 3
  print at 1,15, "u8 *= /="
  Scale *= 3
  Scale /= 4
  print Scale at 18,15 digits 3
  print at 1,17, "u16 *= 5"
  Stretch *= 5
  print Stretch at 18,17 digits 5

  if SignedPos = raw $0D40 then
    Pass1 = 1
  end if
  if ScreenPos = raw $2940 then
    Pass2 = 1
  end if
  if PixelSigned = 13 then
    Pass3 = 1
  end if
  if PixelScreen = 41 then
    Pass4 = 1
  end if
  if Scale = 9 then
    Pass5 = 1
  end if
  if Stretch = 45 then
    Pass6 = 1
  end if
  if Pass3 and Pass4 then PassFloor = 1
  if Pass5 and Pass6 then PassOps = 1

  print at 1,20, "fixed raw"
  if Pass1 then print at 18,20, "PASS" else print at 18,20, "FAIL"
  print at 1,21, "ufixed raw"
  if Pass2 then print at 18,21, "PASS" else print at 18,21, "FAIL"
  print at 1,22, "floor/int"
  if PassFloor then print at 18,22, "PASS" else print at 18,22, "FAIL"
  print at 1,23, "*= /="
  if PassOps then print at 18,23, "PASS" else print at 18,23, "FAIL"
  return