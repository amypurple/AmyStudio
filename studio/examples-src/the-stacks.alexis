asm {
StOut:
    db $00,$00,$06,$04,$00,$00,$16,$04,$00,$00,$26,$04,$00,$00,$36,$04,$00,$00,$46,$04,$00,$00,$56,$04
    db $00,$00,$66,$04,$00,$00,$76,$04,$00,$00,$86,$04,$00,$00,$96,$04,$00,$00,$A6,$04,$00,$00,$B6,$04
    db $00,$00,$C6,$04,$00,$00,$D6,$04,$00,$00,$E6,$04,$00,$00,$F6,$04,$10
StStep:
    db $00,$00,$84,$01,$00,$00,$B4,$01,$00,$00,$F4,$01,$10
StFound:
    db $40,$7F,$20,$05,$40,$65,$20,$05,$40,$55,$20,$05,$40,$40,$30,$14,$40,$FE,$F0,$01,$50
StNear:
    db $40,$40,$60,$03,$40,$35,$70,$03,$40,$FE,$F0,$01,$50
StDone:
    db $40,$AA,$20,$0A,$40,$7F,$20,$0A,$40,$6B,$20,$1E,$40,$FE,$F0,$01,$50

StSoundTable:
    dw StOut,$702B
    dw StStep,$702B
    dw StFound,$7035
    dw StNear,$7035
    dw StDone,$7035
    dw StTuneMel,$703F
    dw StTuneBass,$7049
; Candle Hours, A minor (original for this game)
; Tiny Sound, 7 frames per step
StTuneMel:
    db $44
    dw sndtiny_1
    db 7
    db $02,$40,$1A,$21,$23,$00,$00,$28,$00,$2B,$AA,$00,$00,$28,$00,$00
    db $A3,$00,$00,$00,$24,$00,$00,$28,$00,$2D,$AB,$00,$00,$2A,$00,$00
    db $A7,$00,$00,$00,$28,$00,$00,$2B,$00,$2F,$AD,$00,$00,$2B,$00,$2A
    db $A8,$00,$00,$00,$2A,$00,$00,$27,$00,$23,$A8,$00,$00,$00,$00,$00
    db $01,$01,$01,$01,$2B,$00,$00,$2A,$00,$28,$A6,$00,$00,$23,$00,$00
    db $A6,$00,$00,$00,$24,$00,$00,$23,$00,$21,$A3,$00,$00,$1F,$00,$00
    db $A1,$00,$00,$00,$23,$00,$00,$26,$00,$2B,$AA,$00,$00,$28,$00,$26
    db $A4,$00,$00,$00,$23,$00,$00,$21,$00,$1E,$A3,$00,$00,$00,$00,$00
    db $00,$00,$00,$00,$23,$00,$00,$28,$00,$2B,$AA,$00,$00,$28,$00,$00
    db $A3,$00,$00,$00,$24,$00,$00,$28,$00,$2D,$AB,$00,$00,$2A,$00,$00
    db $A7,$00,$00,$00,$28,$00,$00,$2B,$00,$2F,$AD,$00,$00,$2B,$00,$2A
    db $AB,$00,$00,$00,$2A,$00,$00,$27,$00,$2A,$A8,$00,$00,$00,$00,$00
    db $00,$00,$00,$00
    db $FF
StTuneBass:
    db $84
    dw sndtiny_2
    db 7
    db $02,$70,$F1,$22,$10,$00,$17,$00,$1C,$00,$17,$00,$10,$00,$17,$00
    db $1C,$00,$17,$00,$09,$00,$10,$00,$15,$00,$10,$00,$0B,$00,$12,$00
    db $1B,$00,$12,$00,$10,$00,$17,$00,$1C,$00,$17,$00,$0C,$00,$13,$00
    db $18,$00,$13,$00,$0B,$00,$12,$00,$1B,$00,$12,$00,$10,$00,$17,$00
    db $1C,$00,$17,$00,$07,$00,$0E,$00,$13,$00,$0E,$00,$0B,$00,$12,$00
    db $17,$00,$12,$00,$09,$00,$10,$00,$15,$00,$10,$00,$10,$00,$17,$00
    db $1C,$00,$17,$00,$07,$00,$0E,$00,$13,$00,$0E,$00,$0C,$00,$13,$00
    db $18,$00,$13,$00,$0B,$00,$12,$00,$1B,$00,$12,$00,$0B,$00,$12,$00
    db $1B,$00,$12,$00,$10,$00,$17,$00,$1C,$00,$17,$00,$10,$00,$17,$00
    db $1C,$00,$17,$00,$09,$00,$10,$00,$15,$00,$10,$00,$0B,$00,$12,$00
    db $1B,$00,$12,$00,$10,$00,$17,$00,$1C,$00,$17,$00,$0C,$00,$13,$00
    db $18,$00,$13,$00,$0B,$00,$12,$00,$1B,$00,$12,$00,$10,$00,$00,$00
    db $00,$00,$00,$00
    db $FF

; StRays: Hc[0..27], Sc[0..27], Zc[0..27] (distance in 1/16 cells, at most
; 255) for the player at Px, Py (8.8 cells) facing Ang
StRays:
    ; the library's map
    ld a,(AMY_UVAR_MapNo)
    add a,a
    ld e,a
    ld d,0
    ld hl,StMapTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_MapBase),de
    xor a
    ld (AMY_UVAR_Rcol),a
StRayLoop:
    ld a,(AMY_UVAR_Rcol)
    ld e,a
    ld d,0
    ld hl,StColOff
    add hl,de
    ld a,(AMY_UVAR_Ang)
    add a,(hl)
    ld (AMY_UVAR_Ra),a
    ; dX = Delta[a], dY = Delta[a - 64]
    ld l,a
    ld h,0
    add hl,hl
    ld de,StDelta
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_RdX),de
    ld a,(AMY_UVAR_Ra)
    sub 64
    ld l,a
    ld h,0
    add hl,hl
    ld de,StDelta
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld (AMY_UVAR_RdY),de
    ; x: cos < 0 for angles 65..191
    ld a,(AMY_UVAR_Ra)
    sub 65
    cp 127
    jr nc,StXPos
    ld a,$FF
    ld (AMY_UVAR_RstX),a
    ld a,(AMY_UVAR_Px)
    ld de,(AMY_UVAR_RdX)
    call StMulFD
    ld (AMY_UVAR_RsdX),hl
    jr StYDir
StXPos:
    ld a,1
    ld (AMY_UVAR_RstX),a
    ld a,(AMY_UVAR_Px)
    neg
    jr z,StXFull
    ld de,(AMY_UVAR_RdX)
    call StMulFD
    ld (AMY_UVAR_RsdX),hl
    jr StYDir
StXFull:
    ld hl,(AMY_UVAR_RdX)
    ld (AMY_UVAR_RsdX),hl
StYDir:
    ; y: sin < 0 for angles 129..255
    ld a,(AMY_UVAR_Ra)
    sub 129
    cp 127
    jr nc,StYPos
    ld a,$FF
    ld (AMY_UVAR_RstY),a
    ld a,(AMY_UVAR_Py)
    ld de,(AMY_UVAR_RdY)
    call StMulFD
    ld (AMY_UVAR_RsdY),hl
    jr StStart
StYPos:
    ld a,1
    ld (AMY_UVAR_RstY),a
    ld a,(AMY_UVAR_Py)
    neg
    jr z,StYFull
    ld de,(AMY_UVAR_RdY)
    call StMulFD
    ld (AMY_UVAR_RsdY),hl
    jr StStart
StYFull:
    ld hl,(AMY_UVAR_RdY)
    ld (AMY_UVAR_RsdY),hl
StStart:
    ; the DDA in registers: HL the map cell, DE the x step (+-1), BC the
    ; y step (+-16); in the other set HL' sdx, DE' sdy, BC' dX (dY in RAM)
    ld hl,(AMY_UVAR_RsdX)
    ld de,(AMY_UVAR_RsdY)
    ld bc,(AMY_UVAR_RdX)
    exx
    ld a,(AMY_UVAR_Py+1)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_Px+1)
    ld e,a
    ld d,0
    add hl,de
    ld de,(AMY_UVAR_MapBase)
    add hl,de
    ld de,1
    ld a,(AMY_UVAR_RstX)
    or a
    jp p,StSxP
    ld de,-1
StSxP:
    ld bc,32
    ld a,(AMY_UVAR_RstY)
    or a
    jp p,StDda
    ld bc,-32
StDda:
    exx
    ld a,l
    sub e
    ld a,h
    sbc a,d
    jr nc,StStepY
    add hl,bc
    exx
    add hl,de
    ld a,(hl)
    or a
    jr z,StDda
    ld (AMY_UVAR_Rcell),hl
    ; an x side: the distance is sdx before its last step
    exx
    or a
    sbc hl,bc
    push hl
    exx
    pop hl
    xor a
    jr StHit
StStepY:
    push hl
    ld hl,(AMY_UVAR_RdY)
    add hl,de
    ex de,hl
    pop hl
    exx
    add hl,bc
    ld a,(hl)
    or a
    jr z,StDda
    ld (AMY_UVAR_Rcell),hl
    ; a y side
    exx
    ex de,hl
    ld de,(AMY_UVAR_RdY)
    or a
    sbc hl,de
    push hl
    exx
    pop hl
    ld a,1
StHit:
    ld (AMY_UVAR_Rside),a
    ; a page pinned here? (Rpaper)
    push hl
    call StPageHit
    pop hl
    ; the fish-eye: the distance in 1/8 cells (at most 255) times the
    ; column's cosine: one 8 x 8 product
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,h
    or a
    jr z,StFeOk
    ld l,255
StFeOk:
    ld a,(AMY_UVAR_Rcol)
    ld c,a
    ld b,0
    push hl
    ld hl,StCosOff
    add hl,bc
    ld e,(hl)
    pop hl
    ld h,l
    call StMul8
    ; HL = dist8 * cos: >> 7 gives the distance in 1/16 cells (at most 511)
    add hl,hl
    ld l,h
    ld h,0
    rl h
    ld a,h
    cp 2
    jr c,StIdxOk
    ld hl,511
StIdxOk:
    ; Zc[col] = min(255, it)
    ld a,(AMY_UVAR_Rcol)
    ld c,a
    ld b,0
    push hl
    ld a,h
    or a
    ld a,l
    jr z,StZOk
    ld a,255
StZOk:
    ld hl,AMY_UVAR_Zc
    add hl,bc
    ld (hl),a
    pop hl
    ; Hc[col] = Height[it]
    push hl
    ld de,StHeight
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Hc
    add hl,bc
    ld (hl),a
    pop hl
    ; Sc[col]: the level from the distance in 1/4 cells (at most 127)
    srl h
    rr l
    srl h
    rr l
    ld a,l
    cp 128
    jr c,StShOk
    ld a,127
StShOk:
    ld e,a
    ld d,0
    ld hl,StShade0
    ld a,(AMY_UVAR_Rside)
    or a
    jr z,StSh0
    ld hl,StShade1
StSh0:
    add hl,de
    ld a,(hl)
    ld hl,AMY_UVAR_Sc
    add hl,bc
    ld (hl),a
    ; the paper tile of that light (Sc - TW0s) / 15 + 188
    ld e,0
    ld a,(AMY_UVAR_Rpaper)
    or a
    jr z,StNoPaper
    ld a,(hl)
    sub 128
    ld e,188
StPpLvl:
    cp 15
    jr c,StNoPaper
    sub 15
    inc e
    jr StPpLvl
StNoPaper:
    ld hl,AMY_UVAR_Pc
    add hl,bc
    ld (hl),e
    ; the next column
    ld a,(AMY_UVAR_Rcol)
    inc a
    ld (AMY_UVAR_Rcol),a
    cp 28
    jp nz,StRayLoop
    ret

; StPageHit: Rpaper = 1 if the ray's shelf cell and face carry a page
; still lost, and the ray meets the middle half of that face. HL = the
; ray's length (8.8 cells, before the fish-eye correction)
StPageHit:
    xor a
    ld (AMY_UVAR_Rpaper),a
    ld (AMY_UVAR_Rdist),hl
    ; the cell
    ld hl,(AMY_UVAR_Rcell)
    ld de,(AMY_UVAR_MapBase)
    or a
    sbc hl,de
    ex de,hl
    ; a quick look first: the low bytes of the 8 page cells (CPIR)
    ld hl,AMY_UVAR_PgLo
    ld bc,8
StPhScan:
    ld a,e
    cpir
    ret nz
    ; page 7 - C: its high byte, then its face
    push hl
    push bc
    ld a,7
    sub c
    ld c,a
    ld b,0
    ld hl,AMY_UVAR_PgWall+1
    add hl,bc
    add hl,bc
    ld a,(hl)
    cp d
    jr nz,StPhNo
    ld hl,AMY_UVAR_PgFace
    add hl,bc
    ld c,(hl)
    ; the face the ray meets: side * 2, + 1 when it goes the negative way
    ld a,(AMY_UVAR_Rside)
    or a
    ld a,(AMY_UVAR_RstX)
    jr z,StPhX
    ld a,(AMY_UVAR_RstY)
StPhX:
    rlca
    and 1
    ld b,a
    ld a,(AMY_UVAR_Rside)
    add a,a
    add a,b
    cp c
    jr nz,StPhNo
    pop bc
    pop hl
    jr StPhFound
StPhNo:
    pop bc
    pop hl
    ld a,b
    or c
    jr nz,StPhScan
    ret
StPhFound:
    ; where on the face: the position along it, in 1/16 cells, mod 16:
    ; (pos >> 4) +- (length >> 4) * |trig| >> 8 (sin for an x side,
    ; cos for a y side)
    ld hl,(AMY_UVAR_Rdist)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld a,h
    or a
    jr z,StPhD
    ld l,255
StPhD:
    ld a,(AMY_UVAR_Ra)
    ld c,a
    ld a,(AMY_UVAR_Rside)
    or a
    jr nz,StPhCos
    ; an x side: |sin|, the y position, + when 1 <= a <= 127
    ld a,c
    sub 64
    ld c,a
StPhCos:
    ; |cos(c)| from the table, its sign: + for c in 192..63
    push bc
    ld b,0
    ld h,l
    push hl
    ld hl,StAbsCos
    add hl,bc
    ld e,(hl)
    pop hl
    call StMul8
    pop bc
    ld e,h
    ; the position (>> 4, low byte)
    ld a,(AMY_UVAR_Rside)
    or a
    ld hl,(AMY_UVAR_Py)
    jr z,StPhPos
    ld hl,(AMY_UVAR_Px)
StPhPos:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ; the sign of the trig: cos(c) >= 0 when c + 64 < 128
    ld a,c
    add a,64
    cp 128
    ld a,l
    jr nc,StPhMinus
    add a,e
    jr StPhFrac
StPhMinus:
    sub e
StPhFrac:
    and 15
    cp 4
    ret c
    cp 12
    ret nc
    ld a,1
    ld (AMY_UVAR_Rpaper),a
    ret

; StPeekMap: Pk = the cell Qc (0-1023) of library MapNo
StPeekMap:
    ld a,(AMY_UVAR_MapNo)
    add a,a
    ld e,a
    ld d,0
    ld hl,StMapTab
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld hl,(AMY_UVAR_Qc)
    add hl,de
    ld a,(hl)
    ld (AMY_UVAR_Pk),a
    ret

; StMulFD: HL = A * DE >> 8 (A and DE unsigned, DE < $8000), with one 8 x 8
; product: DE >> 4 when it is below 16 cells (1/16 cell steps), else DE >> 8
StMulFD:
    ld h,a
    ld a,d
    cp 16
    jr nc,StMulBig
    ; (DE >> 4) * A >> 4
    ld a,e
    srl d
    rra
    srl d
    rra
    srl d
    rra
    srl d
    rra
    ld e,a
    call StMul8
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ret
StMulBig:
    ; (DE >> 8) * A
    ld e,d
    jp StMul8

; StMul8: HL = H * E, by quarter squares: (a+b)^2/4 - (a-b)^2/4
StMul8:
    ld a,h
    ld c,e
    ld l,a
    ld h,0
    ld d,0
    add hl,de
    add hl,hl
    ld de,StSq
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    push de
    sub c
    jr nc,StMulPos
    neg
StMulPos:
    ld l,a
    ld h,0
    add hl,hl
    ld de,StSq
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    pop hl
    or a
    sbc hl,de
    ret

; StDraw: the 16 view rows (screen rows 2-17, columns 2-29). First the
; top half of each column into Tb (8 rows of 28): ceiling down to the
; shelf's edge tile, then solid; then the 16 rows are sent from Tb, the
; bottom half through StMirror (ceiling -> floor, a top edge -> the bottom
; edge of the same depth, solid -> solid) read from the bottom up.
StDraw:
    ld de,AMY_UVAR_Sc
    ld ix,AMY_UVAR_Tb+112
    ld hl,AMY_UVAR_Hc
    ld (AMY_UVAR_Rptr),hl
    ld hl,AMY_UVAR_Pc
    ld (AMY_UVAR_Rpptr),hl
    ld b,192
    ld a,28
    ld (AMY_UVAR_Rrow),a
StColLoop:
    ; HL = StColTab + 8 * h: the 8 tiles' offsets from the level's base
    ; (255: the ceiling)
    ld hl,(AMY_UVAR_Rptr)
    ld l,(hl)
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    push de
    ld de,StColTab
    add hl,de
    pop de
    ld a,(de)
    ld c,a
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU0
    add a,c
    ld (ix-112),a
    jr StV0
StU0:
    ld (ix-112),b
StV0:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU1
    add a,c
    ld (ix-84),a
    jr StV1
StU1:
    ld (ix-84),b
StV1:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU2
    add a,c
    ld (ix-56),a
    jr StV2
StU2:
    ld (ix-56),b
StV2:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU3
    add a,c
    ld (ix-28),a
    jr StV3
StU3:
    ld (ix-28),b
StV3:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU4
    add a,c
    ld (ix+0),a
    jr StV4
StU4:
    ld (ix+0),b
StV4:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU5
    add a,c
    ld (ix+28),a
    jr StV5
StU5:
    ld (ix+28),b
StV5:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU6
    add a,c
    ld (ix+56),a
    jr StV6
StU6:
    ld (ix+56),b
StV6:
    ld a,(hl)
    inc hl
    cp 255
    jr z,StU7
    add a,c
    ld (ix+84),a
    jr StV7
StU7:
    ld (ix+84),b
StV7:
    ; a page: the rows by the horizon, as many as the shelf is tall
    push de
    ld hl,(AMY_UVAR_Rpptr)
    ld a,(hl)
    or a
    jr z,StPpNone
    push bc
    ld b,a
    ld hl,(AMY_UVAR_Rptr)
    ld l,(hl)
    ld h,0
    ld de,StPaperK
    add hl,de
    ld a,(hl)
    cp 1
    jr c,StPpDone
    ld (ix+84),b
    cp 2
    jr c,StPpDone
    ld (ix+56),b
    cp 3
    jr c,StPpDone
    ld (ix+28),b
    cp 4
    jr c,StPpDone
    ld (ix+0),b
StPpDone:
    pop bc
StPpNone:
    pop de
    ld hl,(AMY_UVAR_Rpptr)
    inc hl
    ld (AMY_UVAR_Rpptr),hl
    inc ix
    ld hl,(AMY_UVAR_Rptr)
    inc hl
    ld (AMY_UVAR_Rptr),hl
    inc de
    ld a,(AMY_UVAR_Rrow)
    dec a
    ld (AMY_UVAR_Rrow),a
    jp nz,StColLoop
    ; the 8 top rows
    xor a
    ld (AMY_UVAR_Rrow),a
    ld hl,AMY_UVAR_Tb
StTopRows:
    push hl
    ld a,(AMY_UVAR_Rrow)
    call StRowAddr
    pop hl
    ld b,28
StTopOut:
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    djnz StTopOut
    ld a,(AMY_UVAR_Rrow)
    inc a
    ld (AMY_UVAR_Rrow),a
    cp 8
    jr nz,StTopRows
    ; the 8 bottom rows: Tb rows 7 down to 0, mirrored
    ld hl,AMY_UVAR_Tb+196
StBotRows:
    push hl
    ld a,(AMY_UVAR_Rrow)
    call StRowAddr
    pop hl
    ld b,28
    ld d,StMirror/256
StBotOut:
    ld e,(hl)
    ld a,(de)
    out ($BE),a
    inc hl
    djnz StBotOut
    ld de,-56
    add hl,de
    ld a,(AMY_UVAR_Rrow)
    inc a
    ld (AMY_UVAR_Rrow),a
    cp 16
    jr nz,StBotRows
    ret

; StRowAddr: the VDP write address of view row A (screen row A + 2, column 2)
StRowAddr:
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,66
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ret

