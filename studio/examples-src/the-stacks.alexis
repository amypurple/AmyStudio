' THE STACKS
' An original game by Claude (an AI made by Anthropic) for Amy Studio,
' 2026, in Amy by Amy Bienvenu: a ray-cast library on a ColecoVision.
'
' The game: by lamplight, find the eight lost pages scattered in the
' stacks of an old magazine library before your lamp runs dry. Each page
' found holds a line of a poem, and a little oil. The lamp dims as it
' empties: the shelves go dark from far to near.
'
' Controls (either joystick): up walks, down steps back, left and right
' turn; hold the button for the map of where you have walked. Under the
' oil, the lamp tells how near the nearest lost page is. Keypad not used.
'
' The pages are pinned to the shelves at the ends of aisles: the ray caster
' draws them on the faces it meets, in the middle of the face and at the
' height of the eye (the more rows, the nearer).
'
' How it is drawn: a ray caster (gen.py, ray.asm). The view is 28 tile
' columns by 16 tile rows; a ray a column, cast by DDA through the 32 x 32
' map, gives a height and a light level, and the view is written to the
' name table from 64 prepared tiles (a shelf top or bottom k pixels into a
' tile, 4 lights, and 4 tiles of paper). No bitmap: about 450 bytes of
' name table a frame. The title is a bitmap (title.py), drawn in code.
'
' House rules kept: text in columns 2-29 and rows 1-22; the frame loop is
' protected from the NMI and every screen is drawn with the NMI off after a
' wait. An original title tune that plays once, and a credits page.

const TW0s = 128
const TW0t1 = 129
const TW0t2 = 130
const TW0t3 = 131
const TW0t4 = 132
const TW0t5 = 133
const TW0t6 = 134
const TW0t7 = 135
const TW0b1 = 136
const TW0b2 = 137
const TW0b3 = 138
const TW0b4 = 139
const TW0b5 = 140
const TW0b6 = 141
const TW0b7 = 142
const TW1s = 143
const TW1t1 = 144
const TW1t2 = 145
const TW1t3 = 146
const TW1t4 = 147
const TW1t5 = 148
const TW1t6 = 149
const TW1t7 = 150
const TW1b1 = 151
const TW1b2 = 152
const TW1b3 = 153
const TW1b4 = 154
const TW1b5 = 155
const TW1b6 = 156
const TW1b7 = 157
const TW2s = 158
const TW2t1 = 159
const TW2t2 = 160
const TW2t3 = 161
const TW2t4 = 162
const TW2t5 = 163
const TW2t6 = 164
const TW2t7 = 165
const TW2b1 = 166
const TW2b2 = 167
const TW2b3 = 168
const TW2b4 = 169
const TW2b5 = 170
const TW2b6 = 171
const TW2b7 = 172
const TW3s = 173
const TW3t1 = 174
const TW3t2 = 175
const TW3t3 = 176
const TW3t4 = 177
const TW3t5 = 178
const TW3t6 = 179
const TW3t7 = 180
const TW3b1 = 181
const TW3b2 = 182
const TW3b3 = 183
const TW3b4 = 184
const TW3b5 = 185
const TW3b6 = 186
const TW3b7 = 187
const TPp0 = 188
const TPp1 = 189
const TPp2 = 190
const TPp3 = 191
const TCeil = 192
const TFloor = 193
const TOil = 194
const TOilempty = 195
const SPage = 0
const SPagefar = 4
const NTiles8 = 544
const SprBytes = 64
const SndOut = 1
const SndStep = 2
const SndFound = 3
const SndNear = 4
const SndDone = 5
const SndTuneA = 6
const SndTuneB = 7
u16 TzLeft = 0
u8 TzOn = 0

' --- the ray caster (ray.asm) ----------------------------------------------
u16 Px = 0
u16 Py = 0
u8 Ang = 0
u8 Rcol = 0
u8 Ra = 0
u16 RdX = 0
u16 RdY = 0
u8 RstX = 0
u8 RstY = 0
u16 RsdX = 0
u16 RsdY = 0
u8 Rside = 0
u8 Rmul = 0
u8 Rlo = 0
u8 Prof = 0
u8 Rrow = 0
u8 Hc[28]
u8 Sc[28]
u8 Zc[28]
u8 Pc[28]
u16 Rcell = 0
u8 Rpaper = 0
u16 Rdist = 0
u16 Rpptr = 0
u16 PgWall[8]
u8 PgLo[8]
u8 PgFace[8]
u8 Tb[224]
u16 Rptr = 0
' --- the game --------------------------------------------------------------
' Got the pages found (a bit each), Found how many, Oil the frames of
' light left, Dimm the darkening (0-2), Last the page just read
u8 Got = 0
u8 Found = 0
u16 Oil = 0
u8 Dimm = 0
u8 Shown = 0
u16 ReadT = 0
u8 HudT = 0
u8 StepT = 0
u8 LastT = 0
u8 Seen[128]
u8 MapNo = 0
u16 MapBase = 0
u16 Qc = 0
u8 Pk = 0
u8 PageX[8]
u8 PageY[8]
u16 Used = 0
u16 Cell = 0
u8 Near = 0
u8 NearT = 0
' for the test bot: 1 walking, 7 the end, 8 title, 9 the lamp went out
u8 Ph = 0
u8 Tc = $F1

i16 Dx = 0
i16 Dy = 0
i16 Zp = 0
i16 Lp = 0
i16 Cx = 0
u16 Nx = 0
u16 Ny = 0
u16 NumU = 0
u16 V16 = 0
u16 Rs = $5A3C
u16 Rt = 0
u16 Rw = 0
u8 Spd = 0
u8 Cs = 0
u8 Sn = 0
u8 Sp = 0
u8 Nopt = 0
u8 Oy = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tick = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0
u8 Ex = 0
u8 Ey = 0

  ' no cartridge screen: the game starts on its title
  tile screen
  sprites 16x16
  set sound table StSoundTable areas 4
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  ' the title picture (a bitmap: title.py), the tune
  Ph = 8
  HideSprites
  Rearm
  wait
  nmi off
  display off
  picture screen
  decompress zx0 TitleP to vram $0000
  decompress zx0 TitleC to vram $2000
  decompress zx0 TitleN to vram $1800
  backdrop black
  screen on
  nmi off
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 1344
  TzOn = 1
  Hold(120)
  WaitPress
  ' the story, over a view of the stacks
  Rearm
  wait
  nmi off
  display off
  tile screen
  TextScreen
  backdrop black
  MapNo = 0
  Px = 1 * 256
  Px = Px + 100
  Py = 1 * 256
  Py = Py + 128
  Ang = 2
  Dimm = 0
  call asm StRays
  call asm StDraw
  print at 10,1, "THE STACKS"
  ShowScreen
  print at 2,19, "FIND THE EIGHT LOST PAGES"
  print at 2,20, "BEFORE YOUR LAMP RUNS DRY."
  print at 2,21, "STICK: WALK  BUTTON: MAP"
  print at 8,22, "PRESS A BUTTON"
  WaitPress
  Rs = Rs ^ Tick
  if Rs = 0 then Rs = $5A3C

  ' a new night in the stacks (the tune ends with the title)
  stop sound SndTuneA
  stop sound SndTuneB
  TzOn = 0
  Rnd16
  V = highbyte Rw
  MapNo = V % 3
  V = StartX[MapNo]
  Px = V
  Px = Px << 8
  Px = Px + 128
  V = StartY[MapNo]
  Py = V
  Py = Py << 8
  Py = Py + 128
  Ang = 0
  Used = 0
  for I = 0 to 7
pk_again:
    Rnd16
    V = highbyte Rw
    V = V & 15
    V16 = 1
    V16 = V16 << V
    Rt = Used & V16
    if Rt <> 0 then goto pk_again
    Used = Used | V16
    K = MapNo * 16
    K = K + V
    PageX[I] = CandX[K]
    PageY[I] = CandY[K]
    ' the shelf it is pinned to, and the face it is on
    V = CandWH[K]
    V16 = V
    V16 = V16 << 8
    V = CandWL[K]
    V16 = V16 + V
    PgWall[I] = V16
    PgLo[I] = CandWL[K]
    PgFace[I] = CandF[K]
  next
  Got = 0
  Found = 0
  for K = 0 to 127
    Seen[K] = 0
  next
  Oil = 18000
  Dimm = 0
  Shown = 0
  ReadT = 0
  TextScreen
  backdrop black
  print at 10,1, "THE STACKS"
  Hud
  ShowScreen
  LastT = Tick
  Ph = 1

walk:
  ' the stick
  ReadPad
  if Btn = 1 then
    ShowMap
    goto walk
  end if
  Spd = 22
  if Lf1 = 1 then Ang = Ang - 3
  if Rt1 = 1 then Ang = Ang + 3
  V = Up1 | Dn1
  if V = 1 then
    inc StepT
    if StepT >= 18 then
      StepT = 0
      play sound SndStep
    end if
  end if
  if Up1 = 1 then Advance(Spd, 0)
  if Dn1 = 1 then Advance(Spd, 1)
  ' this cell is seen
  V = highbyte Py
  Cell = V
  Cell = Cell << 5
  V = highbyte Px
  Cell = Cell + V
  MarkSeen
  ' the view
  Prof = 1
  call asm StRays
  Prof = 4
  if Dimm > 0 then Darken
  Prof = 0
  Frame1
  Prof = 2
  call asm StDraw
  Prof = 3
  Pages
  Prof = 5
  ' the lamp: a view takes 3 frames (20 a second), and burns 3 frames of
  ' oil (Frame1 only counts the frame it waits for)
  if Oil > 3 then
    Oil = Oil - 3
  else
    Oil = 0
  end if
  Tick2
  if Oil = 0 then goto lampout
  if Found = 8 then goto ending
  Prof = 0
  goto walk

ending:
  ' the poem, whole
  Ph = 7
  HideSprites
  play sound SndDone
  TextScreen
  backdrop black
  ShowScreen
  print at 2,2, "ALL EIGHT PAGES, IN ORDER:"
  for I = 0 to 7
    Shown = I
    Y = I * 2
    Y = Y + 4
    PoemAt(Y)
    Hold(30)
  next
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  print at 8,21, "PRESS A BUTTON"
  WaitPress
  goto title

lampout:
  ' the lamp goes out
  Ph = 9
  HideSprites
  play sound SndOut
  for Y = 2 to 17
    fill TCeil count 28 at 2,Y
    Hold(3)
  next
  TextScreen
  backdrop black
  print at 6,8, "THE LAMP GOES OUT."
  print at 2,11, "PAGES FOUND:"
  NumU = Found
  print at 15,11, digits$(NumU, 1)
  print at 2,14, "THE STACKS WILL WAIT."
  print at 8,19, "PRESS A BUTTON"
  ShowScreen
  WaitPress
  goto title

' Advance(speed, back): forward (or back) along Ang, one axis at a time, so
' the shelves are slid along, not stuck to
sub Advance(u8 Sv, u8 Back):
  V = CosT[Ang]
  Dx = V
  if V > 127 then Dx = Dx - 256
  V = SinT[Ang]
  Dy = V
  if V > 127 then Dy = Dy - 256
  ' (x 64 in the tables: speed 16 is 1/16 of a cell a frame)
  V16 = Sv
  Cx = V16
  Dx = Dx * Cx
  Dx = Dx >> 6
  Dy = Dy * Cx
  Dy = Dy >> 6
  if Back = 1 then
    Dx = 0 - Dx
    Dy = 0 - Dy
  end if
  ' x, with a margin of 3/16 of a cell
  Nx = Px + Dx
  Cx = 48
  if Dx < 0 then Cx = -48
  V16 = Nx + Cx
  Solid(V16, Py)
  if K = 0 then Px = Nx
  Ny = Py + Dy
  Cx = 48
  if Dy < 0 then Cx = -48
  V16 = Ny + Cx
  Solid(Px, V16)
  if K = 0 then Py = Ny
  return
end sub

' Solid(x, y): K = 1 if the cell of (x, y) is a shelf
sub Solid(u16 Qx, u16 Qy):
  V = highbyte Qy
  Qc = V
  Qc = Qc << 5
  V = highbyte Qx
  Qc = Qc + V
  call asm StPeekMap
  K = Pk
  return
end sub

' MarkSeen: the bit of Cell in Seen
sub MarkSeen:
  V16 = Cell >> 3
  K = lowbyte V16
  V16 = Cell & 7
  V = lowbyte V16
  V = Bits[V]
  Sn = Seen[K]
  Sn = Sn | V
  Seen[K] = Sn
  return
end sub

' IsSeen: Sn = 1 if Cell was walked
sub IsSeen:
  V16 = Cell >> 3
  K = lowbyte V16
  V16 = Cell & 7
  V = lowbyte V16
  V = Bits[V]
  Sn = Seen[K]
  Sn = Sn & V
  if Sn <> 0 then Sn = 1
  return
end sub

' Nearest: how far the nearest page still lost is (in cells, the longer of
' the two distances), shown under the oil: the lamp's glow on paper
sub Nearest:
  Near = 99
  V16 = Px >> 8
  X = lowbyte V16
  V16 = Py >> 8
  Y = lowbyte V16
  for I = 0 to 7
    V = Bits[I]
    V = V & Got
    if V = 0 then
      V = PageX[I]
      if V > X then
        K = V - X
      else
        K = X - V
      end if
      V = PageY[I]
      if V > Y then
        V = V - Y
      else
        V = Y - V
      end if
      if V > K then K = V
      if K < Near then Near = K
    end if
  next
  fill 32 count 28 at 2,22
  if Near < 3 then
    print at 2,22, "A PAGE GLOWS VERY NEAR."
    play sound SndNear
  else
    if Near < 6 then
      print at 2,22, "THE LAMP CATCHES PAPER..."
    else
      if Near < 99 then print at 2,22, "ONLY DUST HERE."
    end if
  end if
  return
end sub

' ShowMap: while the button is held, the cells walked and the shelves
' around them, 28 x 16 cells around you (you are the arrow, in the middle)
sub ShowMap:
  Frame1
  HideSprites
  V16 = Px >> 8
  Ex = lowbyte V16
  V16 = Py >> 8
  Ey = lowbyte V16
  for J = 0 to 15
    for I = 0 to 27
      Sp = TCeil
      ' the cell: (Ex - 14 + I, Ey - 8 + J), if in the library
      Cx = Ex
      Cx = Cx - 14
      Cx = Cx + I
      Lp = Ey
      Lp = Lp - 8
      Lp = Lp + J
      Cs = 0
      if Cx < 0 then Cs = 1
      if Cx > 31 then Cs = 1
      if Lp < 0 then Cs = 1
      if Lp > 31 then Cs = 1
      if Cs = 0 then
        Cell = Lp
        Cell = Cell << 5
        V16 = Cx
        Cell = Cell + V16
        IsSeen
        if Sn = 1 then
          Sp = TFloor
        else
          Qc = Cell
          call asm StPeekMap
          if Pk = 1 then
            ' a shelf beside a walked cell
            Cs = 0
            if Cx > 0 then
              Cell = Qc - 1
              IsSeen
              Cs = Cs | Sn
            end if
            if Cx < 31 then
              Cell = Qc + 1
              IsSeen
              Cs = Cs | Sn
            end if
            if Lp > 0 then
              Cell = Qc - 32
              IsSeen
              Cs = Cs | Sn
            end if
            if Lp < 31 then
              Cell = Qc + 32
              IsSeen
              Cs = Cs | Sn
            end if
            if Cs = 1 then Sp = TW1s
          end if
        end if
      end if
      X = I + 2
      Y = J + 2
      put char Sp at X,Y
    next
  next
  ' you: an arrow by the way you face
  V = Ang + 32
  V = V >> 6
  if V = 0 then print at 16,10, ">"
  if V = 1 then print at 16,10, "V"
  if V = 2 then print at 16,10, "<"
  if V = 3 then print at 16,10, "^"
  print at 2,22, "THE MAP: WHERE YOU WALKED   "
sm_hold:
  Frame1
  ReadPad
  if Btn = 1 then goto sm_hold
  fill 32 count 28 at 2,22
  return
end sub

' Darken: the lamp dims: every column Dimm levels darker (at most the last)
sub Darken:
  for K = 0 to 27
    V = Sc[K]
    V = V + 15
    if Dimm = 2 then V = V + 15
    if V > TW3s then V = TW3s
    Sc[K] = V
  next
  return
end sub

' Pages: a page is pinned to the shelf at the end of its aisle (drawn by
' the ray caster); it is found within half a cell of its aisle's end
sub Pages:
  ' a page within half a cell is found
  for I = 0 to 7
    V = Bits[I]
    V = V & Got
    if V = 0 then
      V = PageX[I]
      Dx = V
      Dx = Dx * 256
      Dx = Dx + 128
      V16 = Px
      Cx = V16
      Dx = Dx - Cx
      V = PageY[I]
      Dy = V
      Dy = Dy * 256
      Dy = Dy + 128
      V16 = Py
      Cx = V16
      Dy = Dy - Cx
      Cx = abs(Dx)
      Lp = abs(Dy)
      if Cx < 128 then
        if Lp < 128 then FoundPage
      end if
    end if
  next
  return
end sub


' FoundPage: page I is read: its line, and a little oil
sub FoundPage:
  V = Bits[I]
  Got = Got | V
  inc Found
  PgWall[I] = $FFFF
  PgLo[I] = 255
  Oil = Oil + 3000
  if Oil > 18000 then Oil = 18000
  play sound SndFound
  Shown = I
  ReadT = 100
  PoemLine
  Hud
  return
end sub

' Tick2: the HUD's lamp and the poem line's time
sub Tick2:
  inc HudT
  if HudT >= 20 then
    HudT = 0
    Hud
    Nearest
  end if
  if ReadT > 0 then
    dec ReadT
    if ReadT = 0 then
      fill 32 count 28 at 2,20
      fill 32 count 28 at 2,21
    end if
  end if
  ' the lamp dims at a third and at a sixth of its oil (steadily: no
  ' flicker, which flashed the shelves)
  Dimm = 0
  if Oil < 6000 then Dimm = 1
  if Oil < 3000 then Dimm = 2
  return
end sub

' Hud: pages found, and the oil (16 cells)
sub Hud:
  print at 2,19, "PAGES  /8"
  NumU = Found
  print at 8,19, digits$(NumU, 1)
  V16 = Oil / 1125
  V = lowbyte V16
  for K = 0 to 15
    X = K + 14
    if K < V then
      put char TOil at X,19
    else
      put char TOilempty at X,19
    end if
  next
  return
end sub

' PoemLine: page Shown's line, rows 20-21
sub PoemLine:
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  if Shown = 0 then print at 2,20, "SOMEONE TYPED THIS IN ONCE,"
  if Shown = 1 then print at 2,20, "LINE BY LINE, LATE AT NIGHT,"
  if Shown = 2 then print at 2,20, "A SMUDGE FOR EVERY DOUBT,"
  if Shown = 3 then print at 2,20, "A GUESS FOR EVERY LIGHT."
  if Shown = 4 then print at 2,20, "THE PAGES WANDERED OFF,"
  if Shown = 5 then print at 2,20, "THE SHELVES GREW TALL,"
  if Shown = 6 then print at 2,20, "BUT WHAT WE TYPE, WE KEEP:"
  if Shown = 7 then print at 2,20, "READY. THE CURSOR BLINKS."
  return
end sub

' PoemAt(row): the line of page Shown at a row of the ending
sub PoemAt(u8 Ry):
  if Shown = 0 then print at 2,Ry, "SOMEONE TYPED THIS IN ONCE,"
  if Shown = 1 then print at 2,Ry, "LINE BY LINE, LATE AT NIGHT,"
  if Shown = 2 then print at 2,Ry, "A SMUDGE FOR EVERY DOUBT,"
  if Shown = 3 then print at 2,Ry, "A GUESS FOR EVERY LIGHT."
  if Shown = 4 then print at 2,Ry, "THE PAGES WANDERED OFF,"
  if Shown = 5 then print at 2,Ry, "THE SHELVES GREW TALL,"
  if Shown = 6 then print at 2,Ry, "BUT WHAT WE TYPE, WE KEEP:"
  if Shown = 7 then print at 2,Ry, "READY. THE CURSOR BLINKS."
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 4
  for K = 0 to 3
    set sprite K to 208,0,0,0
  next
  update sprites
  return
end sub

' ShowNum X, Y: NumU, as many digits as it has
sub ShowNum(u8 Px, u8 Py):
  if NumU < 10 then
    print at Px,Py, digits$(NumU, 1)
  else
    if NumU < 100 then
      print at Px,Py, digits$(NumU, 2)
    else
      if NumU < 1000 then
        print at Px,Py, digits$(NumU, 3)
      else
        print at Px,Py, digits$(NumU, 4)
      end if
    end if
  end if
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  fill mode 2 text color with Tc
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  fill 32 count 768 to vram.name
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub Hold(u8 N):
  for J = 1 to N
    Frame1
  next
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 16
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 5
      end if
    end if
  end if
  WasStick = V
  return
end sub

' Rnd16: RND as Rw/65536 (a 16-bit xorshift, 7 9 8)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub


data Bits bytes 1, 2, 4, 8, 16, 32, 64, 128
data TilePat bytes
  $22,$22,$22,$22,$22,$22,$22,$22
  $00,$00,$00,$00,$00,$00,$00,$22
  $00,$00,$00,$00,$00,$00,$22,$22
  $00,$00,$00,$00,$00,$22,$22,$22
  $00,$00,$00,$00,$22,$22,$22,$22
  $00,$00,$00,$22,$22,$22,$22,$22
  $00,$00,$22,$22,$22,$22,$22,$22
  $00,$22,$22,$22,$22,$22,$22,$22
