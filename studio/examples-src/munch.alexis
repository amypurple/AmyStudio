cartridge "MUNCHMATH/COMPUTE'S GAZETTE/1983"

' MUNCHMATH
' A ColecoVision game based on "Munchmath", COMPUTE!'s Gazette, November
' 1983 (Commodore 64 and VIC-20, BASIC; no author named in the listing).
' Made for Amy Studio by Claude (an AI made by Anthropic), 2026, in Amy by
' Amy Bienvenu.
'
' The game: pick what to practise (addition, subtraction, division or
' multiplication) and a level from 1 to 9. A problem appears in big digits;
' dial the answer with the stick and press a button. A right answer moves
' the Numnom one crumb along the path (+10); the Minus Cloud behind it
' drifts one crumb closer after every answer, right or wrong. Reach the
' checkered flag (+100) and the next board is one level harder; let the
' cloud catch up and it zaps the Numnom (-50, one level easier).
'
' From the original (orig/munchmath.64.bas, the primary listing): the
' track (muncher starts on cell 3, the chaser on cell 0, the goal is cell
' 18), the muncher steps only on a right answer while the chaser steps on
' every answer (so three wrong answers on a board are a catch), the board
' is won before the chaser moves; the numbers 1..5 x level, B > A making
' A = A + B, division shown as A*B / B, the scores 10 / 100 / -50 (never
' below 0), level + 1 for a board, level - 1 (at least 1) for a catch, the
' wrong answer shown with the right one, the scoreboard with problems,
' right, wrong and the grade in per cent.
'
' Liberties: numbers are entered with a joystick dial (left/right picks a
' digit, up/down turns it, a button answers) instead of typing; the dial
' always has as many digits as the largest answer of the operation and
' level, so its width gives nothing away and every answer must be dialled.
' Trying answers in turn ("sweeping") costs an answer each, and the cloud
' catches up after three. The original never ended unless Q was typed:
' here the Numnom has three lives, and clearing the board of level 9 wins.
' No name is asked (no keyboard). Division is shown as "E / B" instead of
' the long-division bracket. The animations, art, sounds and the title
' tune are new; the original's character set and jingle are not used.
'
' Controls: either controller; stick and side buttons only. On the title,
' up/down choose a line, left/right change the operation and the level;
' HOW TO PLAY shows two pages of rules. The cursor starts on PRACTICE.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128;
' frame loop protected from the NMI; screens drawn with the NMI off,
' display off. Music first in the sound table, the title tune once.

const TGd000 = 128
const TGd001 = 129
const TGd010 = 130
const TGd011 = 131
const TGd100 = 132
const TGd101 = 133
const TGd110 = 134
const TGd111 = 135
const TGd200 = 136
const TGd201 = 137
const TGd210 = 138
const TGd211 = 139
const TGd300 = 140
const TGd301 = 141
const TGd310 = 142
const TGd311 = 143
const TGd400 = 144
const TGd401 = 145
const TGd410 = 146
const TGd411 = 147
const TGd500 = 148
const TGd501 = 149
const TGd510 = 150
const TGd511 = 151
const TGd600 = 152
const TGd601 = 153
const TGd610 = 154
const TGd611 = 155
const TGd700 = 156
const TGd701 = 157
const TGd710 = 158
const TGd711 = 159
const TGd800 = 160
const TGd801 = 161
const TGd810 = 162
const TGd811 = 163
const TGd900 = 164
const TGd901 = 165
const TGd910 = 166
const TGd911 = 167
const TGplus00 = 168
const TGplus01 = 169
const TGplus10 = 170
const TGplus11 = 171
const TGminus00 = 172
const TGminus01 = 173
const TGminus10 = 174
const TGminus11 = 175
const TGtimes00 = 176
const TGtimes01 = 177
const TGtimes10 = 178
const TGtimes11 = 179
const TGdivide00 = 180
const TGdivide01 = 181
const TGdivide10 = 182
const TGdivide11 = 183
const TGquery00 = 184
const TGquery01 = 185
const TGquery10 = 186
const TGquery11 = 187
const TLM00 = 188
const TLM01 = 189
const TLM10 = 190
const TLM11 = 191
const TLU00 = 192
const TLU01 = 193
const TLU10 = 194
const TLU11 = 195
const TLN00 = 196
const TLN01 = 197
const TLN10 = 198
const TLN11 = 199
const TLC00 = 200
const TLC01 = 201
const TLC10 = 202
const TLC11 = 203
const TLH00 = 204
const TLH01 = 205
const TLH10 = 206
const TLH11 = 207
const TLA00 = 208
const TLA01 = 209
const TLA10 = 210
const TLA11 = 211
const TLT00 = 212
const TLT01 = 213
const TLT10 = 214
const TLT11 = 215
const TPan = 216
const TPantl = 217
const TPant = 218
const TPantr = 219
const TPanl = 220
const TPanr = 221
const TPanbl = 222
const TPanb = 223
const TPanbr = 224
const TRule = 225
const TSky = 226
const TStar = 227
const TStar2 = 228
const TGrass = 229
const TCrumb = 230
const TPath = 231
const TGoal = 232
const TSoil = 233
const THeart = 234
const SNbody0 = 0
const SNbody1 = 4
const SNdet0 = 8
const SNdet1 = 12
const SCbody0 = 16
const SCbody1 = 20
const SCface = 24
const SCursor = 28
const SArrowu = 32
const SArrowd = 36
const SZap = 40
const NTiles8 = 856
const SprBytes = 352
const SndTuneA = 1
const SndTuneB = 2
const SndTick = 3
const SndMove = 4
const SndRight = 5
const SndWrong = 6
const SndMunch = 7
const SndCaught = 8
const SndBoard = 9
const SndStart = 10
const SndOver = 11
const SndWin = 12
const Goal = 18
const StartP = 3
const CellCol = 5
const PathRow = 19
const ActY = 135
const NSpr = 8
const MaxLv = 9
const StartLives = 3
const GPlus = 10
const GQuery = 14
const AnsRow = 12
const ShowN = 75
const MsgN = 120

' the title letters (M U N C H A T glyph order) for MUNCHMATH
data LogoT bytes
  0, 1, 2, 3, 4, 0, 5, 6, 4
end data
' stars in the sky: column, row pairs
data StarT bytes
  3, 2, 7, 5, 26, 3, 28, 8, 4, 11, 25, 12, 2, 15, 27, 16, 12, 17, 19, 18, 6, 17, 29, 1
end data

record Actor:
  u8 X
  u8 Tx
  u8 Fr
end record

Actor Mun
Actor Cld

' game state
bcd digits 6 Sc = 0
bcd digits 6 Hi = 0
u8 Op = 1
u8 StartLv = 1
u8 Lv = 1
u8 Lives = 3
u8 P = 3
u8 M = 0
u16 Pr = 0
u16 Rt = 0
u16 Wr = 0
u8 Over = 0
' the problem: two numbers, the shown top / bottom, the glyph, the answer
u8 A = 0
u8 B = 0
u16 TopV = 0
u16 BotV = 0
u8 Og = 10
u16 Ans = 0
' the dial
u8 Nd = 1
u8 Dg[4]
u8 Sel = 0
u8 RepT = 0
' play phases: 0 dialling, 1 showing the answer, 2 walking, 3 message
u8 St = 0
u8 ShowT = 0
u8 MsgT = 0
u8 Ev = 0
u8 Good = 0
u8 ZapOn = 0
' random numbers, title
u16 Rs = 1
u16 W16 = 0
u16 Qx = 0
u16 A16 = 0
u16 TzLeft = 0
u8 TzOn = 0
u8 Menu = 0
u8 TitleOn = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jk = 0
u8 WasJ = 0
u8 Edge = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Ci = 0
u8 Ki = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 T = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MmSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 4
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then
    HowToPage
    goto title
  end if
  if Menu = 4 then
    CreditsPage
    goto title
  end if

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop
  if St > 0 then goto play_loop

  ' the end: the scoreboard, then back to the title on a press
  if Sc > Hi then Hi = Sc
  Scoreboard
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' rules

' the largest answer of an operation at a level (n = 5 x level numbers;
' B > A makes A = A + B, so A reaches 2n - 1)
function MaxAns(u8 Oq, u8 Lq) as u16
  u16 Nn = 0
  u16 Rr = 0
  Nn = Lq * 5
  select case Oq
  case 1
    Rr = Nn * 3
    Rr = Rr - 1
  case 2, 3
    Rr = Nn * 2
    Rr = Rr - 1
  case else
    Rr = Nn * 2
    Rr = Rr - 1
    Rr = Rr * Nn
  end select
  return Rr

function DigitsOf(u16 Vd) as u8
  if Vd >= 1000 then return 4
  if Vd >= 100 then return 3
  if Vd >= 10 then return 2
  return 1

' a number from 1 to N
function Roll(u8 Nr) as u8
  u16 Wm = 0
  u8 Res = 0
  Rand
  Wm = Nr
  Wm = Rs % Wm
  Res = Wm
  Res = Res + 1
  return Res

function DialValue as u16
  u16 Vv = 0
  u8 Kd = 0
  for Kd = 0 to 3
    if Kd < Nd then
      Vv = Vv * 10
      Vv = Vv + Dg[Kd]
    end if
  next
  return Vv

sub NewProblem:
  C = Lv * 5
  A = Roll(C)
  B = Roll(C)
  if B > A then A = A + B
  TopV = A
  BotV = B
  select case Op
  case 1
    Ans = A + B
    Og = GPlus
  case 2
    Ans = A - B
    Og = GPlus + 1
  case 3
    TopV = A * B
    Ans = A
    Og = GPlus + 3
  case else
    Ans = A * B
    Og = GPlus + 2
  end select
  W16 = MaxAns(Op, Lv)
  Nd = DigitsOf(W16)
  for Ki = 0 to 3
    Dg[Ki] = 0
  next
  Sel = 0
  St = 0
  return
end sub

' the button: judge the dialled answer (as lines 190-240 and 700-730)
sub Submit:
  W16 = DialValue
  inc Pr
  Ev = 0
  if W16 = Ans then
    Good = 1
    inc Rt
    inc P
    Sc += 10
    play sound SndRight
    if P >= Goal then
      Ev = 1
    else
      inc M
    end if
  else
    Good = 0
    inc Wr
    inc M
    play sound SndWrong
    if M >= P then Ev = 2
  end if
  ' the consequences, all at once (the screen catches up in phases)
  if Ev = 1 then
    Sc += 100
    inc Lv
    if Lv > MaxLv then
      Lv = MaxLv
      Over = 2
    end if
  end if
  if Ev = 2 then
    Sc -= 50
    if Lv > 1 then dec Lv
    dec Lives
    if Lives = 0 then Over = 1
  end if
  Mun.Tx = CellX(P)
  Cld.Tx = CellX(M)
  if Good = 1 then
    print at 2,16, "      RIGHT!  +10         "
    St = 2
  else
    ' show the right answer in the dial for a moment
    print at 2,16, "  NOT QUITE: THE ANSWER IS"
    ShowAnswer
    ShowT = ShowN
    St = 1
  end if
  ShowHud
  return
end sub

function CellX(u8 Cell) as u8
  u8 Xc = 0
  Xc = Cell + CellCol
  Xc = Xc << 3
  Xc = Xc - 4
  return Xc

' one pass of play
sub PlayStep:
  Ki = 0
  if Over > 0 then
    if St = 0 then Ki = 1
  end if
  if Ki = 1 then return
  select case St
  case 0
    Dial
  case 1
    dec ShowT
    if ShowT = 0 then St = 2
  case 2
    Walk
  case else
    dec MsgT
    if Cld.X > 16 then
      if Ev = 1 then Cld.X = Cld.X - 2
    end if
    if MsgT = 0 then AfterMsg
  end select
  return
end sub

' the stick turns the dial
sub Dial:
  K = Jk & 3
  if K = 0 then
    RepT = 0
  else
    inc RepT
    if RepT = 1 then TurnDigit
    if RepT >= 16 then
      RepT = 10
      TurnDigit
    end if
  end if
  K = Edge & 4
  if K > 0 then
    if Sel > 0 then
      dec Sel
      play sound SndMove
    end if
  end if
  K = Edge & 8
  if K > 0 then
    V = Nd - 1
    if Sel < V then
      inc Sel
      play sound SndMove
    end if
  end if
  if Press = 1 then Submit
  return
end sub

sub TurnDigit:
  V = Dg[Sel]
  K = Jk & 1
  if K > 0 then
    V = V + 1
    if V > 9 then V = 0
  else
    if V = 0 then
      V = 9
    else
      dec V
    end if
  end if
  Dg[Sel] = V
  C = DigCol(Sel)
  PutGlyph(V, C, AnsRow)
  play sound SndTick
  return
end sub

function DigCol(u8 Kc) as u8
  u8 Cc = 0
  Cc = Nd - Kc
  Cc = Cc << 1
  Cc = 22 - Cc
  return Cc

' the Numnom steps first, then the cloud (a pixel a frame)
sub Walk:
  Ki = 0
  X = Mun.X
  if X < Mun.Tx then
    inc X
    Mun.X = X
    Mun.Fr = X >> 2
    V = X & 7
    if V = 4 then
      play sound SndMunch
      EatCrumbs
    end if
    Ki = 1
  end if
  if Ki = 0 then
    X = Cld.X
    if X < Cld.Tx then
      inc X
      Cld.X = X
      Ki = 1
    end if
  end if
  if Ki = 1 then return
  ' everybody is there
  if Ev = 0 then
    NextProblem
    return
  end if
  if Ev = 1 then
    print at 2,16, "  FLAG REACHED!  +100     "
    play sound SndBoard
  else
    print at 2,16, "     ZAPPED!  -50         "
    ZapOn = 1
    play sound SndCaught
  end if
  MsgT = MsgN
  St = 3
  return
end sub

sub AfterMsg:
  ZapOn = 0
  if Over > 0 then
    St = 0
    return
  end if
  NewBoard
  NextProblem
  return
end sub

sub NextProblem:
  NewProblem
  DrawProblem
  print at 2,16, "                          "
  return
end sub

sub NewBoard:
  P = StartP
  M = 0
  Mun.X = CellX(P)
  Mun.Tx = Mun.X
  Cld.X = CellX(M)
  Cld.Tx = Cld.X
  Ev = 0
  DrawPath
  ShowHud
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a big glyph (0-9, 10 + - x / ?) at Gc, Gr
sub PutGlyph(u8 Gn, u8 Gc, u8 Gr):
  u8 Tg = 0
  u8 Cg = 0
  Tg = Gn << 2
  Tg = Tg + TGd000
  put char Tg at Gc,Gr
  inc Tg
  Cg = Gc + 1
  put char Tg at Cg,Gr
  inc Tg
  Gr = Gr + 1
  put char Tg at Gc,Gr
  inc Tg
  put char Tg at Cg,Gr
  return
end sub

sub BlankGlyph(u8 Bc, u8 Br):
  u8 Bd = 1
  Bd = Br + 1
  fill TPan count 2 at Bc,Br
  fill TPan count 2 at Bc,Bd
  return
end sub

' a number in big digits, right-aligned to column 21, blanking to column 12
sub BigNum(u16 Vn, u8 Rn):
  u8 Cn = 20
  u8 Dn = 0
  u16 Qn = 0
  u8 Fin = 0
  while Fin = 0
    Qn = Vn / 10
    W16 = Qn * 10
    W16 = Vn - W16
    Dn = W16
    PutGlyph(Dn, Cn, Rn)
    Vn = Qn
    Cn = Cn - 2
    if Vn = 0 then Fin = 1
  end while
  while Cn >= 12
    BlankGlyph(Cn, Rn)
    Cn = Cn - 2
  end while
  return
end sub

' the problem and an empty dial
sub DrawProblem:
  Rearm
  wait
  nmi off
  BigNum(TopV, 4)
  BlankGlyph(10, 4)
  BigNum(BotV, 7)
  PutGlyph(Og, 10, 7)
  fill TRule count 12 at 10,10
  fill TPan count 12 at 10,AnsRow
  V = AnsRow + 1
  fill TPan count 12 at 10,V
  for Ki = 0 to 3
    if Ki < Nd then
      C = DigCol(Ki)
      PutGlyph(0, C, AnsRow)
    end if
  next
  return
end sub

sub ShowAnswer:
  W16 = Ans
  for Ki = 0 to 3
    Dg[Ki] = 0
  next
  Ki = Nd
  while Ki > 0
    dec Ki
    Qx = W16 / 10
    A16 = Qx * 10
    A16 = W16 - A16
    Dg[Ki] = A16
    W16 = Qx
  end while
  for Ki = 0 to 3
    if Ki < Nd then
      C = DigCol(Ki)
      V = Dg[Ki]
      PutGlyph(V, C, AnsRow)
    end if
  next
  return
end sub

' the path: eaten up to the Numnom, crumbs ahead, the flag at the goal
sub DrawPath:
  for Ki = 0 to Goal
    C = Ki + CellCol
    T = TCrumb
    if Ki <= P then T = TPath
    if Ki = Goal then T = TGoal
    put char T at C,PathRow
  next
  return
end sub

' the crumb under the Numnom's mouth is eaten
sub EatCrumbs:
  V = Mun.X + 12
  V = V >> 3
  if V < 24 then
    if V > CellCol then
      put char TPath at V,PathRow
    end if
  end if
  return
end sub

' sprites: 0 cursor, 1-2 arrows, 3-4 the Numnom, 5-6 the cloud, 7 the zap
sub DrawSprites:
  if St = 0 then
    if TitleOn = 0 then
      C = DigCol(Sel)
      X = C << 3
      set sprite 0 to 95,X,SCursor,11
      set sprite 1 to 81,X,SArrowu,11
      set sprite 2 to 111,X,SArrowd,11
    end if
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
    set sprite 2 to 192,0,0,0
  end if
  ' copy record fields to locals before set sprite (known pitfall)
  X = Mun.X
  V = Mun.Fr & 1
  K = V << 2
  T = SNbody0 + K
  K = SNdet0 + K
  set sprite 3 to ActY,X,K,15
  set sprite 4 to ActY,X,T,9
  X = Cld.X
  V = Tick >> 4
  V = V & 1
  K = V << 2
  T = SCbody0 + K
  Y = ActY - 1
  if Ev = 1 then
    if St = 3 then Y = Y - 8
  end if
  if X <= 16 then Y = 192
  set sprite 5 to Y,X,SCface,1
  set sprite 6 to Y,X,T,14
  if ZapOn = 1 then
    X = Mun.X
    Y = ActY - 10
    set sprite 7 to Y,X,SZap,11
  else
    set sprite 7 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  print Sc at 8,1
  print at 15,1, "LEVEL"
  put char 48 + Lv at 21,1
  fill TSky count 4 at 25,1
  for Ki = 1 to 3
    if Ki <= Lives then
      C = 24 + Ki
      put char THeart at C,1
    end if
  next
  return
end sub

sub OpName:
  select case Op
  case 1
    print at X,Y, "ADDITION      "
  case 2
    print at X,Y, "SUBTRACTION   "
  case 3
    print at X,Y, "DIVISION      "
  case else
    print at X,Y, "MULTIPLICATION"
  end select
  return
end sub

' the sky with its stars, the grass and the soil
sub DrawMeadow:
  for Ki = 0 to 18
    fill TSky count 32 at 0,Ki
  next
  for Ki = 0 to 11
    C = Ki << 1
    X = StarT[C]
    inc C
    Y = StarT[C]
    V = Ki & 1
    T = TStar + V
    put char T at X,Y
  next
  fill TGrass count 32 at 0,PathRow
  for Ki = 20 to 23
    fill TSoil count 32 at 0,Ki
  next
  return
end sub

sub DrawPanel:
  put char TPantl at 9,3
  fill TPant count 12 at 10,3
  put char TPantr at 22,3
  for Ki = 4 to 14
    put char TPanl at 9,Ki
    fill TPan count 12 at 10,Ki
    put char TPanr at 22,Ki
  next
  put char TPanbl at 9,15
  fill TPanb count 12 at 10,15
  put char TPanbr at 22,15
  return
end sub

sub NewGame:
  Sc = 0
  Lv = StartLv
  Lives = StartLives
  Pr = 0
  Rt = 0
  Wr = 0
  Over = 0
  ZapOn = 0
  TitleOn = 0
  NewScreen
  DrawMeadow
  DrawPanel
  X = 9
  Y = 2
  OpName
  NewBoard
  NewProblem
  DrawProblem
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' the original's scoreboard (lines 800-850)
sub Scoreboard:
  Rearm
  wait
  nmi off
  HideSprites
  for Ki = 3 to 15
    fill TSky count 28 at 2,Ki
  next
  if Over = 2 then
    print at 4,4, "ALL NINE LEVELS CLEARED!"
    play sound SndWin
  else
    print at 10,4, "GAME OVER"
    play sound SndOver
  end if
  print at 9,6, "SCOREBOARD"
  print at 7,8, "PROBLEMS"
  print Pr at 19,8 width 3
  print at 7,10, "RIGHT"
  print Rt at 19,10 width 3
  print at 7,12, "WRONG"
  print Wr at 19,12 width 3
  print at 7,14, "GRADE"
  W16 = Grade(Rt, Pr)
  print W16 at 19,14 width 3
  print at 22,14, "%"
  ShowHud
  print at 2,16, "                          "
  return
end sub

function Grade(u16 Gr, u16 Gp) as u16
  u16 Gq = 0
  if Gp = 0 then return 0
  Gq = Gr * 100
  Gq = Gq + Gp / 2
  Gq = Gq / Gp
  return Gq

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Jk = V & 15
  K = WasJ ^ 15
  Edge = Jk & K
  WasJ = Jk
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 7
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: MUNCHMATH in big letters, the chase across the meadow, the
' tune once, and the choices
sub TitlePage:
  TitleOn = 1
  Menu = 0
  NewScreen
  DrawMeadow
  for Ki = 3 to 15
    fill TSky count 28 at 2,Ki
  next
  for Ki = 0 to 8
    T = LogoT[Ki]
    T = T << 2
    T = T + TLM00
    C = Ki << 1
    C = C + 5
    put char T at C,3
    inc T
    V = C + 1
    put char T at V,3
    inc T
    put char T at C,4
    inc T
    put char T at V,4
  next
  print at 4,6, "COMPUTE!'S GAZETTE 1983"
  print at 4,9, "PRACTICE"
  print at 4,11, "LEVEL"
  print at 4,13, "START"
  print at 4,15, "HOW TO PLAY"
  print at 4,17, "CREDITS"
  print at 2,22, "HI"
  print Hi at 5,22
  ShowChoices
  ShowMenu
  P = 0
  M = 0
  Mun.X = 48
  Cld.X = 20
  Ev = 0
  St = 9
  for Ki = 0 to Goal
    C = Ki + CellCol
    put char TCrumb at C,PathRow
  next
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 480
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  ' the chase runs along the path and starts again
  V = Tick & 1
  if V = 0 then
    X = Mun.X + 1
    if X > 208 then
      X = 48
      Cld.X = 20
      for Ki = 0 to Goal
        C = Ki + CellCol
        put char TCrumb at C,PathRow
      next
    end if
    Mun.X = X
    Mun.Fr = X >> 2
    EatCrumbs
    Cld.X = Cld.X + 1
  end if
  DrawSprites
  K = Edge & 1
  if K > 0 then
    if Menu > 0 then dec Menu
    ShowMenu
  end if
  K = Edge & 2
  if K > 0 then
    if Menu < 4 then inc Menu
    ShowMenu
  end if
  K = Edge & 12
  if K > 0 then
    ChangeChoice
  end if
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  return
end sub

sub ChangeChoice:
  K = Edge & 8
  if Menu = 0 then
    if K > 0 then
      inc Op
      if Op > 4 then Op = 1
    else
      dec Op
      if Op = 0 then Op = 4
    end if
  end if
  if Menu = 1 then
    if K > 0 then
      if StartLv < MaxLv then inc StartLv
    else
      if StartLv > 1 then dec StartLv
    end if
  end if
  play sound SndMove
  ShowChoices
  return
end sub

sub ShowChoices:
  X = 14
  Y = 9
  OpName
  put char 48 + StartLv at 14,11
  return
end sub

sub ShowMenu:
  for Ki = 0 to 4
    C = Ki << 1
    C = C + 9
    put char 32 at 2,C
  next
  C = Menu << 1
  C = C + 9
  put char 62 at 2,C
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  u8 Pg = 1
  u16 HtWt = 0
  Pg = 1
ht_page:
  NewScreen
  if Pg = 1 then
    print at 2,1, "HOW TO PLAY            1/2"
    print at 2,3, "SOLVE MATH PROBLEMS TO HELP"
    print at 2,4, "THE NUMNOM EAT ITS WAY TO"
    print at 2,5, "THE FLAG. EACH RIGHT ANSWER"
    print at 2,6, "MOVES IT ONE CRUMB (+10)."
    print at 2,8, "THE MINUS CLOUD MOVES ONE"
    print at 2,9, "CRUMB AFTER EVERY ANSWER."
    print at 2,10, "THREE WRONG ANSWERS ON A"
    print at 2,11, "BOARD AND IT CATCHES YOU:"
    print at 2,12, "-50, ONE LIFE GONE, AND ONE"
    print at 2,13, "LEVEL EASIER."
    print at 2,15, "REACH THE FLAG: +100, NEXT"
    print at 2,16, "LEVEL. WIN LEVEL 9 TO WIN!"
    for Ki = 0 to 8
      C = Ki + 11
      put char TCrumb at C,19
    next
    put char TGoal at 20,19
    fill TGrass count 28 at 2,20
    set sprite 3 to 143,48,SNdet0,15
    set sprite 4 to 143,48,SNbody0,9
    set sprite 5 to 142,16,SCface,1
    set sprite 6 to 142,16,SCbody0,14
  else
    print at 2,1, "THE ANSWER DIAL        2/2"
    print at 2,3, "LEFT/RIGHT PICKS A DIGIT."
    print at 2,4, "UP/DOWN CHANGES IT."
    print at 2,5, "THE BUTTON ANSWERS."
    print at 2,7, "ON THE TITLE, PICK THE MATH"
    print at 2,8, "(PRACTICE) AND THE LEVEL"
    print at 2,9, "WITH LEFT/RIGHT, THEN START."
    print at 2,11, "YOU HAVE THREE LIVES."
    print at 2,12, "LOSE THEM ALL: GAME OVER."
    print at 2,14, "TIP: WORK IT OUT BEFORE YOU"
    print at 2,15, "ANSWER. EVERY WRONG TRY"
    print at 2,16, "BRINGS THE CLOUD CLOSER."
    print at 10,19, "7 X 3 = 2"
    put char 49 at 19,19
    set sprite 0 to 151,146,SCursor,11
    set sprite 1 to 137,146,SArrowu,11
    set sprite 2 to 167,146,SArrowd,11
    for Ki = 1 to 3
      C = 22 + Ki
      put char THeart at C,19
    next
  end if
  update sprites
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  HtWt = 0
ht_wait:
  Frame1
  ReadPad
  inc HtWt
  if HtWt >= 1800 then goto ht_end
  if Press = 0 then goto ht_wait
  inc Pg
  if Pg <= 2 then goto ht_page
ht_end:
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "MUNCHMATH"
  print at 2,5, "BASED ON MUNCHMATH,"
  print at 2,6, "COMPUTE!'S GAZETTE,"
  print at 2,7, "NOVEMBER 1983 (COMMODORE 64"
  print at 2,8, "AND VIC-20). NO AUTHOR IS"
  print at 2,9, "NAMED IN THE LISTING."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: CRUMB COUNTING"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

