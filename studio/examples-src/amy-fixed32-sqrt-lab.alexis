' Fixed32 sqrt lab: direct roots plus sqrt/sqrt/^2/^2 drift checks.
fixed32 Root100 = 100.0
fixed32 Root10 = 10.0
fixed32 Root225 = 2.25
fixed32 Root025 = 0.25
fixed32 Root050 = 0.5
fixed32 Drift100 = 100.0
fixed32 Drift10 = 10.0

' Amy Fixed32 Sqrt Lab
  text screen
  run_demo
  screen on

sub run_demo:
  print at 6,0, "FIXED32 SQRT LAB"

  Root100 = sqrt(Root100)
  print at 1,3,  "sqrt 100.0"
  print Root100 at 20,3 digits 11

  Root10 = sqrt(Root10)
  print at 1,5,  "sqrt 10.0"
  print Root10 at 20,5 digits 11

  Root225 = sqrt(Root225)
  print at 1,7,  "sqrt 2.25"
  print Root225 at 20,7 digits 11

  Root025 = sqrt(Root025)
  print at 1,9,  "sqrt 0.25"
  print Root025 at 20,9 digits 11

  Root050 = sqrt(Root050)
  print at 1,11, "sqrt 0.50"
  print Root050 at 20,11 digits 11

  Drift100 = sqrt(Drift100)
  Drift100 = sqrt(Drift100)
  Drift100 ^= 2
  Drift100 ^= 2
  print at 1,14, "100 -> ss^^"
  print Drift100 at 20,14 digits 11

  Drift10 = sqrt(Drift10)
  Drift10 = sqrt(Drift10)
  Drift10 ^= 2
  Drift10 ^= 2
  print at 1,16, "10 -> ss^^"
  print Drift10 at 20,16 digits 11

  print at 1,19, "EXPECT"
  print at 8,19, "10 3.1622 1.5 .5 .7071"
  print at 1,20, "ROUNDTRIP"
  print at 10,20, "near 100 and 10"
  return