' FP5 cancellation lab: near-equal subtraction and subtract-after-divide.
u16 U1000 = 1000
u16 U1010 = 1010
u16 U989 = 989
u16 U1005 = 1005
u16 U5000 = 5000
u16 U5 = 5
fp5 A = 0
fp5 B = 0
fp5 C = 0
fp5 D = 0

  text screen
  print at 5,0, "FP5 CANCELLATION"

  A = U1000
  A -= U989
  print at 1,4, "1000 - 989"
  print A at 16,4 digits 16

  B = U1010
  B -= U1005
  print at 1,7, "1010 - 1005"
  print B at 16,7 digits 16

  C = U5000
  C /= U5
  print at 1,10, "5000 / 5"
  print C at 16,10 digits 16

  D = U1000
  D -= C
  print at 1,13, "1000 - (5000/5)"
  print D at 16,13 digits 16

  print at 1,17, "EXPECT"
  print at 1,18, "11  5  1000  0"
  screen on