cartridge "THREE SORTS/AMY STUDIO/2026"
const LeftX = 10
const TopY = 5
const LastIndex = 11
const BlockTile = $23
const EmptyTile = $20

u8 Values[12], RowBuffer[12]
u8 IndexA = 0, J = 0, K = 0, Col = 0, Row = 0, Threshold = 0
u8 Temp = 0, Temp2 = 0, CompareA = 0, CompareB = 0
u8 SwapA = 0, SwapB = 0, StoreIndex = 0, InnerLimit = 0

data InitialValues bytes = 7,2,12,4,9,1,11,3,8,5,10,6

text screen
print centered at 1, "THREE SORT ALGORITHMS"
print centered at 3, "BUBBLE  INSERT  SELECT"
screen on
goto demo_loop

demo_loop:
  run_bubble
  wait 40 frames
  run_insertion
  wait 40 frames
  run_selection
  print centered at 22, "FIRE TO REPLAY"
wait_press:
  wait
  if joypad(1).button1 then goto wait_release
  goto wait_press
wait_release:
  wait
  if joypad(1).button1 then goto wait_release
  fill EmptyTile count 32 at 0,22
  goto demo_loop

sub load_values:
  restore InitialValues
  for IndexA = 0 to LastIndex
    read Temp
    Values[IndexA] = Temp
  next
  render_bars
  return

sub render_bars:
  nmi off
  for Threshold = 1 to 12
    fill array RowBuffer with EmptyTile
    Col = 0
    do while Col <= LastIndex
      if Values[Col] >= Threshold then
        RowBuffer[Col] = BlockTile
      end if
      Col += 1
    loop
    Row = TopY
    Row += 12
    Row -= Threshold
    put RowBuffer count 12 at LeftX,Row
  next
  nmi on
  return

sub step_delay:
  wait 6 frames
  return

sub swap_items:
  swap Values[SwapA] with Values[SwapB]
  render_bars
  step_delay
  return

sub set_item:
  Values[K] = Temp2
  render_bars
  step_delay
  return

sub run_bubble:
  load_values
  print centered at 19, "BUBBLE SORT"
  for IndexA = 0 to 10
    InnerLimit = 10
    InnerLimit -= IndexA
    for J = 0 to InnerLimit
      CompareA = Values[J]
      K = J
      K += 1
      CompareB = Values[K]
      if CompareA > CompareB then
        SwapA = J
        SwapB = K
        swap_items
      end if
    next
  next
  return

sub run_insertion:
  load_values
  print centered at 19, "INSERTION SORT"
  for IndexA = 1 to LastIndex
    Temp = Values[IndexA]
    J = IndexA
insert_scan:
    if J = 0 goto insert_place
    K = J
    K -= 1
    CompareA = Values[K]
    if CompareA <= Temp goto insert_place
    Temp2 = CompareA
    K = J
    set_item
    J -= 1
    goto insert_scan
insert_place:
    Temp2 = Temp
    K = J
    set_item
  next
  return

sub run_selection:
  load_values
  print centered at 19, "SELECTION SORT"
  for IndexA = 0 to 10
    StoreIndex = IndexA
    J = IndexA
    J += 1
select_scan:
    if J > LastIndex goto select_done_scan
    CompareA = Values[J]
    CompareB = Values[StoreIndex]
    if CompareA < CompareB then
      StoreIndex = J
    end if
    J += 1
    goto select_scan
select_done_scan:
    if StoreIndex != IndexA then
      SwapA = IndexA
      SwapB = StoreIndex
      swap_items
    end if
  next
  return
