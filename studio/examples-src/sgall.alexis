  tile screen
  set sound table SgSoundTable areas 6
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 2 then
    HowToPage
    goto title
  end if
  if Sel = 3 then
    CreditsPage
    goto title
  end if
  NewGame
  DrawField
  ShowHud
  DrawSprites
  ShowScreen

play_loop:
  Frame1
  ReadPads
  select case Phase
  case 0
    PlayStep
  case 1
    HitStep
  case 2
    ClearStep
  end select
  DrawSprites
  inc Tick
  if Phase < 3 then goto play_loop

  ' the end: GAME OVER, the score, then back to the title on a press
  mute all
  play sound SndOver
  print at 10,10, "GAME OVER"
  NewHi = 0
  if Score > HiSc then
    HiSc = Score
    NewHi = 1
    ShowHi
  end if
  Rearm
  wait 90 frames
  nmi off
  if NewHi = 1 then
    print at 8,12, "NEW HIGH SCORE!"
  end if
  print at 8,14, "PRESS THE BUTTON"
  ' left alone, Amy's sleep blanks the screen after 30 seconds to spare
  ' the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' the game

sub NewGame:
  Score = 0
  Cannons = 5
  Level = 1
  Shots = 0
  WaveN = 0
  Cx = 112
  CStep = 0
  FireT = 0
  Phase = 0
  PhT = 0
  BombF = 0
  ClearShots
  NewWave
  ' a button still held from the title must be let go first
  Pads = 16
  OldPads = 16
  return
end sub

' all four aliens back at the start point, a new random path
sub NewWave:
  Rand
  Path = R8 & 15
  PBase = PathStart[Path]
  PLen = PathLen[Path]
  for Ai = 0 to 3
    AxF[Ai] = StartX * 256
    AyF[Ai] = StartY * 256
    ASt[Ai] = 1
    AT[Ai] = 0
    AIdx[Ai] = Ai
    Aim(Ai)
  next
  SegT = SegLen
  for Bi = 0 to 2
    BOn[Bi] = 0
  next
  return
end sub

' the velocity (8.8 pixels a frame) that brings alien A to its waypoint in
' SegLen frames
sub Aim(u8 A):
  u8 Wp = 0
  i16 D = 0
  Wp = PBase + AIdx[A]
  D = PathX[Wp]
  D = D - highbyte(AxF[A])
  Vx[A] = D * 8
  D = PathY[Wp]
  D = D - highbyte(AyF[A])
  Vy[A] = D * 8
  return
end sub

' one pass (one frame) of play
sub PlayStep:
  MoveCannon
  if (Pads & 16) <> 0 then
    if (OldPads & 16) = 0 then
      Shoot
      FireT = FireRep
    else
      if FireT > 1 then
        dec FireT
      else
        Shoot
        FireT = FireRep
      end if
    end if
  end if
  MoveShots
  MoveAliens
  DropBombs
  MoveBombs
  if Phase = 0 then
    N = 0
    for Ai = 0 to 3
      N = N | ASt[Ai]
    next
    if N = 0 then
      ' the wave is clear: five waves make a level
      inc WaveN
    end if
    if N = 0 and WaveN < 5 then
      NewWave
      N = 1
    end if
    if N = 0 then
      WaveN = 0
      Phase = 2
      PhT = 180
      ClearShots
      for Bi = 0 to 2
        BOn[Bi] = 0
      next
      inc Level
      if Level = 5 then
        inc Cannons
        play sound SndExtra
      else
        play sound SndBonus
      end if
      Bonus = 60 - Shots
      NumU = Bonus * 5
      Score = Score + NumU
      Shots = 0
      ShowScore
      ShowStatus
      print at 10,9, "LEVEL "
      NumU = Level
      print at 16,9, digits$(NumU, 2)
      print at 8,11, "SHOT BONUS "
      NumU = Bonus * 5
      print at 19,11, digits$(NumU, 3)
    end if
  end if
  return
end sub

sub MoveCannon:
  inc CStep
  if CStep = 3 then CStep = 0
  V = 3
  if CStep = 2 then V = 2
  if (Pads & 4) <> 0 then
    if Cx >= CxMin + V then
      Cx = Cx - V
    else
      Cx = CxMin
    end if
  end if
  if (Pads & 8) <> 0 then
    if Cx + V <= CxMax then
      Cx = Cx + V
    else
      Cx = CxMax
    end if
  end if
  return
end sub

' a new shot over the cannon's middle, when one of the eleven is free
sub Shoot:
  u8 Free = 255
  for Si = 0 to NShot - 1
    if ShR[Si] = 0 then Free = Si
  next
  if Free = 255 then return
  ShC[Free] = (Cx + 8) >> 3
  ShR[Free] = ShotRow
  Rand
  ShK[Free] = TShot0 + (R8 & 3)
  put char ShK[Free] at ShC[Free],ShotRow
  if Shots < 60 then inc Shots
  ShowShots
  play sound SndZap
  HitTest(Free)
  return
end sub

' every shot one row up; off the top it is gone
sub MoveShots:
  u8 Sc = 0
  u8 Sr = 0
  for Si = 0 to NShot - 1
    Sr = ShR[Si]
    if Sr <> 0 then
      Sc = ShC[Si]
      put char SkyAt(Sc, Sr) at Sc,Sr
      dec Sr
      if Sr < TopRow then
        ShR[Si] = 0
      else
        ShR[Si] = Sr
        put char ShK[Si] at Sc,Sr
        HitTest(Si)
      end if
    end if
  next
  return
end sub

' shot S against every flying alien (the shot flies on)
sub HitTest(u8 S):
  u8 Px = 0
  u8 Py = 0
  u8 Hx = 0
  u8 Hy = 0
  Px = ShC[S] * 8 + 4
  Py = ShR[S] * 8
  for Ci = 0 to 3
    if ASt[Ci] = 1 then
      Hx = highbyte(AxF[Ci])
      Hy = highbyte(AyF[Ci])
      if Px + 1 >= Hx + 1 and Px <= Hx + 14 then
        if Py + 7 >= Hy + 1 and Py <= Hy + 12 then
          ASt[Ci] = 2
          AT[Ci] = 16
          Score = Score + 5
          ShowScore
          play sound SndPop
        end if
      end if
    end if
  next
  return
end sub

' the aliens fly their legs; every SegLen frames, the next waypoint
sub MoveAliens:
  dec SegT
  for Ai = 0 to 3
    AxF[Ai] = AxF[Ai] + Vx[Ai]
    AyF[Ai] = AyF[Ai] + Vy[Ai]
    if ASt[Ai] = 2 then
      dec AT[Ai]
      if AT[Ai] = 0 then ASt[Ai] = 0
    end if
  next
  if SegT = 0 then
    SegT = SegLen
    for Ai = 0 to 3
      ' land exactly on the waypoint, then aim at the next
      K = PBase + AIdx[Ai]
      AxF[Ai] = PathX[K] * 256
      AyF[Ai] = PathY[K] * 256
      N = AIdx[Ai] + 1
      if N = PLen then N = 0
      AIdx[Ai] = N
      Aim(Ai)
    next
  end if
  inc Pose
  return
end sub

' aliens 4, 3, 2 may drop a bomb into a free place (the first only when
' it is the last one left)
sub DropBombs:
  u8 Ax = 0
  u8 Dd = 0
  u8 Bf = 0
  u8 Others = 0
  Others = ASt[1] | ASt[2] | ASt[3]
  for Ai = 1 to 4
    K = 4 - Ai
    V = ASt[K]
    ' the first alien only bombs when it is the last one left
    if K = 0 and Others <> 0 then V = 0
    if V = 1 then
      Ax = highbyte(AxF[K])
      if Ax >= Cx then
        Dd = Ax - Cx
      else
        Dd = Cx - Ax
      end if
      Rand
      V = 10
      if Dd < 4 then V = 85
      if R8 < V then
        Bf = FreeBomb()
        if Bf < 3 then
          BOn[Bf] = 1
          BX[Bf] = Ax
          BY[Bf] = highbyte(AyF[K]) + 6
          play sound SndDrop
        end if
      end if
    end if
  next
  return
end sub

' the third place first (the heat seeker), then the second, the first
function FreeBomb as u8
  T = 3
  if BOn[0] = 0 then T = 0
  if BOn[1] = 0 then T = 1
  if BOn[2] = 0 then T = 2
  return T

sub MoveBombs:
  u8 Dy = 2
  u8 Byy = 0
  u8 Bxx = 0
  inc BombF
  if BombF = 3 then BombF = 0
  if BombF = 2 then Dy = 1
  for Bi = 0 to 2
    if BOn[Bi] = 1 then
      Byy = BY[Bi] + Dy
      Bxx = BX[Bi]
      if Bi = 2 and Heat = 1 and Level >= 4 then
        if Bxx < Cx then
          Bxx = Bxx + Dy
        else
          if Bxx > Cx then Bxx = Bxx - Dy
        end if
        BX[Bi] = Bxx
      end if
      BY[Bi] = Byy
      if Byy >= BombEnd then BOn[Bi] = 0
      ' the cannon's body: x Cx+2..Cx+13, y 140..150; the bomb x+5..x+10,
      ' y+3..y+10
      if Byy + 10 >= 140 then
        if Bxx + 10 >= Cx + 2 and Bxx + 5 <= Cx + 13 then
          CannonHit
        end if
      end if
    end if
  next
  return
end sub

sub CannonHit:
  Phase = 1
  PhT = 90
  play sound SndCrash
  ClearShots
  for Bi = 0 to 2
    BOn[Bi] = 0
  next
  return
end sub

' the cannon explodes; then the next cannon, or the end
sub HitStep:
  dec PhT
  if PhT = 0 then
    dec Cannons
    ShowStatus
    if Cannons = 0 then
      Phase = 3
    else
      Phase = 0
      Cx = 112
      NewWave
    end if
  end if
  return
end sub

' LEVEL and SHOT BONUS on show, then the next wave
sub ClearStep:
  dec PhT
  if PhT = 0 then
    print at 8,9, "              "
    print at 8,11, "              "
    Phase = 0
    NewWave
  end if
  return
end sub

sub ClearShots:
  u8 Sc = 0
  u8 Sr = 0
  for Si = 0 to NShot - 1
    Sr = ShR[Si]
    if Sr <> 0 then
      Sc = ShC[Si]
      put char SkyAt(Sc, Sr) at Sc,Sr
    end if
    ShR[Si] = 0
  next
  return
end sub

' the sky's tile at a place: a scatter of stars from the column and row
function SkyAt(u8 C, u8 R) as u8
  u8 H = 0
  H = C * 7 + R * 13
  H = H ^ (C * R)
  T = TSky
  if C < 2 or C > 29 then return T
  if (H & 31) = 3 then T = TStar1
  if (H & 31) = 17 then T = TStar2
  if (H & 63) = 40 then T = TStar3
  return T

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  R8 = Rs
  return
end sub

sub ReadPads:
  OldPads = Pads
  Pads = PadOf(1) | PadOf(2)
  return
end sub

function PadOf(u8 P) as u8
  T = 0
  if joypad(P).up then T = T | 1
  if joypad(P).down then T = T | 2
  if joypad(P).left then T = T | 4
  if joypad(P).right then T = T | 8
  if joypad(P).fire then T = T | 16
  return T

' ---------------------------------------------------------------------------
' drawing

sub ShowScore:
  print at 9,1, digits$(Score, 5)
  return
end sub

sub ShowHi:
  print at 23,1, digits$(HiSc, 5)
  return
end sub

sub ShowShots:
  NumU = Shots
  print at 17,MsgRow, digits$(NumU, 2)
  return
end sub

sub ShowStatus:
  NumU = Level
  print at 8,MsgRow, digits$(NumU, 2)
  ShowShots
  NumU = Cannons
  print at 28,MsgRow, digits$(NumU, 1)
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE 000000   HIGH 000000"
  ShowScore
  ShowHi
  print at 2,MsgRow, "LEVEL 00 SHOTS 00 CANNONS 0"
  ShowStatus
  return
end sub

' sprites: 0 cannon tip, 1 cannon, 2-5 aliens, 6-8 bombs
sub DrawSprites:
  u8 Sp = 0
  u8 Col = 0
  if Phase = 1 then
    if (PhT & 8) = 0 then
      Sp = SBoom1
    else
      Sp = SBoom2
    end if
    set sprite 0 to 207,0,0,0
    set sprite 1 to CanY - 1,Cx,Sp,9
  else
    set sprite 0 to CanY - 1,Cx,STip,11
    set sprite 1 to CanY - 1,Cx,SCannon,7
  end if
  Sp = SAlien1
  if (Pose & 8) <> 0 then Sp = SAlien2
  for Ci = 0 to 3
    K = Ci + 2
    select case ASt[Ci]
    case 1
      Col = 10
      if Ci = 0 then Col = 13
      set sprite K to highbyte(AyF[Ci]) - 1,highbyte(AxF[Ci]),Sp,Col
    case 2
      if AT[Ci] >= 8 then
        set sprite K to highbyte(AyF[Ci]) - 1,highbyte(AxF[Ci]),SBoom1,11
      else
        set sprite K to highbyte(AyF[Ci]) - 1,highbyte(AxF[Ci]),SBoom2,9
      end if
    case else
      set sprite K to 207,0,0,0
    end select
  next
  for Bi = 0 to 2
    K = Bi + 6
    if BOn[Bi] = 1 then
      Col = 15
      if Bi = 2 and Heat = 1 and Level >= 4 then Col = 5
      set sprite K to BY[Bi] - 1,BX[Bi],SBomb,Col
    else
      set sprite K to 207,0,0,0
    end if
  next
  update sprites
  return
end sub

sub DrawField:
  NewScreen
  for Ri = 2 to 18
    for Ci = 0 to 31
      put char SkyAt(Ci, Ri) at Ci,Ri
    next
  next
  fill TDecktop count 32 at 0,19
  fill TDeck count 32 at 0,20
  put char TRivet at 4,20
  put char TRivet at 27,20
  fill TVoid count 32 at 0,21
  for Ci = 0 to 1
    K = 5 + Ci * 20
    put char TLegtop at K,21
    put char TLegtop at K + 1,21
  next
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 9
  sprites stable 0 to 1
  sprites flicker on
  for K = 0 to 8
    set sprite K to 207,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
' the title: SPACE GALLERY, two aliens over the cannon, the menu, the tune
' once
sub TitlePage:
  NewScreen
  copy TitleMap count 160 to vram.name + 96
  print at 8,17, "HIGH SCORE"
  print at 19,17, "0"
  print at 20,17, digits$(HiSc, 5)
  Sel = 0
  ShowMenu
  print at 6,15, "SHOOT THE FRISBOIDS!"
  print at 4,20, "COMPUTE!'S GAZETTE 1985"
  set sprite 2 to 63,40,SAlien1,13
  set sprite 3 to 63,200,SAlien2,10
  update sprites
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  Pads = 31
tp_loop:
  Frame1
  inc Tick
  inc Rs
  if Rs = 0 then Rs = 1
  ReadPads
  N = Pads & (Pads ^ OldPads)
  if (N & 1) <> 0 and Sel > 0 then
    dec Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 2) <> 0 and Sel < 3 then
    inc Sel
    play sound SndPick
    ShowMenu
  end if
  if (N & 16) = 0 then goto tp_loop
  if Sel = 1 then
    Heat = Heat ^ 1
    play sound SndPick
    ShowMenu
    goto tp_loop
  end if
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  HideSprites
  return
end sub

sub ShowMenu:
  for Ri = 0 to 3
    put char 32 at 8,Ri + 11
  next
  put char 62 at 8,Sel + 11
  print at 10,11, "PLAY"
  if Heat = 1 then
    print at 10,12, "HEAT SEEKER ON "
  else
    print at 10,12, "HEAT SEEKER OFF"
  end if
  print at 10,13, "HOW TO PLAY"
  print at 10,14, "CREDITS"
  return
end sub

' HOW TO PLAY: three pages; a button turns the page, after the last page
' (or 30 seconds untouched) back to the title
sub HowToPage:
  Pg = 1
ht_page:
  NewScreen
  select case Pg
  case 1
    print at 2,1, "HOW TO PLAY             1/3"
    print at 2,3, "ALIEN FRISBOIDS FLY OVER"
    print at 2,4, "YOUR SPACE COLONY AND DROP"
    print at 2,5, "PELLETS ON YOUR CANNON."
    print at 2,7, "SHOOT ALL FOUR FRISBOIDS"
    print at 2,8, "TO CLEAR A WAVE. FIVE WAVES"
    print at 2,9, "MAKE A LEVEL."
    set sprite 2 to 95,64,SAlien1,13
    set sprite 3 to 95,104,SAlien2,10
    set sprite 4 to 95,144,SAlien1,10
    set sprite 5 to 95,184,SAlien2,10
    set sprite 6 to 127,150,SBomb,15
    set sprite 0 to 151,120,STip,11
    set sprite 1 to 151,120,SCannon,7
    put char TShot0 at 15,15
  case 2
    print at 2,1, "CONTROLS                2/3"
    print at 2,3, "STICK LEFT/RIGHT: MOVE THE"
    print at 2,4, "CANNON."
    print at 2,5, "BUTTON: FIRE. HOLD IT TO"
    print at 2,6, "KEEP FIRING."
    print at 2,8, "A PELLET ON YOUR CANNON"
    print at 2,9, "COSTS ONE OF YOUR 5 CANNONS."
    print at 2,10, "NO CANNONS LEFT: GAME OVER."
    set sprite 6 to 119,120,SBomb,15
    set sprite 0 to 135,120,STip,11
    set sprite 1 to 135,120,SCannon,7
    set sprite 2 to 135,160,SBoom1,9
  case 3
    print at 2,1, "SCORING                 3/3"
    print at 2,3, "EACH FRISBOID: 5 POINTS."
    print at 2,5, "AFTER A LEVEL: A SHOT BONUS."
    print at 2,6, "THE FEWER SHOTS YOU FIRED,"
    print at 2,7, "THE MORE POINTS YOU GET."
    print at 2,9, "AT LEVEL 5 YOU GET AN EXTRA"
    print at 2,10, "CANNON."
    print at 2,12, "HEAT SEEKER ON THE TITLE:"
    print at 2,13, "FROM LEVEL 4 A BLUE PELLET"
    print at 2,14, "CHASES YOUR CANNON!"
    print at 2,16, "TIP: AIM, DON'T JUST HOLD"
    print at 2,17, "THE BUTTON DOWN."
    set sprite 2 to 151,100,SAlien1,10
    set sprite 6 to 151,150,SBomb,5
  end select
  print at 8,22, "PRESS THE BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  Pads = 31
  Wt = 0
ht_wait:
  Frame1
  ReadPads
  N = Pads & (Pads ^ OldPads)
  Wt = Wt + 1
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if (N & 16) = 0 then goto ht_wait
  inc Pg
  if Pg <= 3 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $71
  backdrop black
  print at 9,2, "SPACE GALLERY"
  print at 2,4, "2023: GUARD THE COLONY FROM"
  print at 2,5, "THE FRISBOIDS AND PELLETS."
  print at 2,7, "BASED ON SPACE GALLERY BY"
  print at 2,8, "JEFF A. LAPKOFF, COMPUTE!'S"
  print at 2,9, "GAZETTE JULY 1985 (C64)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: GALLERY LIGHTS"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
SgZap:
    db $40,$39,$20,$01,$40,$47,$30,$01,$40,$5A,$40,$01,$40,$71,$60,$02,$50
SgPop:
    db $00,$00,$15,$03,$00,$00,$36,$04,$00,$00,$76,$06,$10
SgDrop:
    db $40,$7F,$90,$02,$40,$87,$90,$02,$40,$8F,$A0,$02,$50
SgCrash:
    db $00,$00,$04,$06,$00,$00,$25,$0A,$00,$00,$46,$0E,$00,$00,$76,$14,$00,$00,$A7,$14,$10
SgBonus:
    db $40,$AA,$20,$04,$40,$8F,$20,$04,$40,$71,$20,$04,$40,$55,$20,$04,$40,$47,$20,$0A,$50
SgExtra:
    db $40,$6B,$20,$03,$40,$55,$20,$03,$40,$47,$20,$03,$40,$35,$20,$03,$40,$47,$20,$03,$40,$35,$20,$08
    db $50
SgOver:
    db $40,$1D,$21,$0A,$40,$41,$21,$0A,$40,$68,$21,$0A,$40,$E0,$21,$1C,$50
SgPick:
    db $40,$55,$40,$02,$50

SgSoundTable:
    dw SgTuneMel,$702B
    dw SgTuneBass,$7035
    dw SgZap,$7049
    dw SgPop,$703F
    dw SgDrop,$7049
    dw SgCrash,$703F
    dw SgBonus,$7049
    dw SgExtra,$7049
    dw SgOver,$7049
    dw SgPick,$7049
; Gallery Lights (original)
; Tiny Sound, 9 frames per step
SgTuneMel:
    db $44
    dw sndtiny_1
    db 9
    db $02,$50,$F1,$22,$1C,$01,$23,$01,$28,$26,$23,$01,$24,$01,$23,$21
    db $1F,$01,$21,$23,$21,$01,$1A,$01,$1E,$21,$26,$01,$23,$01,$1F,$01
    db $1C,$01,$01,$01,$1F,$23,$26,$01,$23,$1F,$1A,$01,$1C,$1F,$24,$01
    db $23,$21,$1F,$01,$1E,$21,$26,$01,$24,$23,$21,$1E,$1F,$01,$1A,$01
    db $1F,$01,$01,$01,$00,$01
    db $FF
SgTuneBass:
    db $84
    dw sndtiny_2
    db 9
    db $02,$80,$F1,$22,$10,$01,$17,$01,$10,$01,$17,$01,$0C,$01,$13,$01
    db $0C,$01,$13,$01,$0E,$01,$15,$01,$0E,$01,$12,$01,$10,$01,$17,$01
    db $10,$13,$17,$01,$13,$01,$0E,$01,$13,$01,$0E,$01,$0C,$01,$13,$01
    db $0C,$01,$10,$01,$0E,$01,$15,$01,$0E,$01,$12,$01,$13,$01,$0E,$01
    db $13,$01,$01,$01,$00,$01
    db $FF
}
