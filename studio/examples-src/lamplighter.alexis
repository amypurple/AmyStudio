' the colours of the Morse star: white on black, then black on black
data MstarOn bytes $F1,$F1,$F1,$F1,$F1,$F1,$F1,$F1
data MstarOff bytes $41,$41,$41,$41,$41,$41,$41,$41
' see-through colours (dawn), and the tiles that fade at dawn: the stars,
' the Morse star and the moon, night and lit
data Zero8 bytes 0,0,0,0,0,0,0,0
data FadeTiles bytes TStar, TStar2, TMstar, TMoon00, TMoon01, TMoon10, TMoon11, TStarLit, TStar2Lit, TMstarLit, TMoon00Lit, TMoon01Lit, TMoon10Lit, TMoon11Lit
' the order of the streets in the ending: the cottage, then west to east
' the ending's line for each district (the hill has none: it comes last)
data EndNote bytes EvEnd0, EvEnd1, EvEnd2, EvEnd3, EvEnd4, EvEnd0, EvEnd6, EvEnd7, EvEnd8, EvEnd9, EvEnd10
' a page's sway (pixels), and where each page leaves its shelf
data Sway bytes 0, 1, 2, 3, 4, 4, 5, 5, 5, 5, 4, 4, 3, 2, 1, 0
data PageX bytes 32, 96, 184
' sparks for the fireworks
data CbDx bytes 0,3,4,3,0,253,252,253
data CbDy bytes 252,253,0,3,4,3,0,253
data CbCol bytes 11,15,9,13,10,15,8,14

' the town
u8 LitF[44]
u8 RowBuf[32]
u8 Mask[32]
u8 Dist = 0
u8 Px = 24
u8 Dir = 0
u8 Walk = 0
u8 Item = 0
u8 Tower = 0
u8 CatOn = 0
u8 CatX = 48
u8 CatDir = 0
u8 Pigeon = 1
u8 BookN = 0
u8 Grow = 9
u8 LampI = 0
u8 LampC = 0
u8 LampT = 0
u8 Cnt = 0
u8 Done = 0
u8 Total = 0
u8 Note = 255
u8 MorseI = 0
u8 MorseT = 1
u8 MorseOn = 0
u8 Hw = 0
u8 Pg = 0
u8 Ending = 0
u8 ShipX = 0
u8 DawnOn = 0
u8 TrainX = 200
u8 Moving = 0
u8 Secrets[17]
u8 CoinN = 0
u8 SignOk = 0
u8 Almanac = 0
u8 Atlas = 0
u8 ClockOn = 0
u8 Qd = 0
' the tower clock: stopped at 4:50 until mended, then a minute a second
u8 ClockH = 4
u8 ClockM = 50
u8 ClockF = 0
u8 HBuf[32]
u8 CatW = 0
u8 CatMv = 0
u8 AdaN = 0
u8 Ex = 0
u8 Ey = 0

' sparks
u8 CbX[8]
u8 CbY[8]
u8 CbK = 0
u8 CbT = 0
u8 CbN = 0
u8 CbC = 0
u8 CbV = 0

' scratch
u16 Off16 = 0
u16 Uw = 0
u16 NumU = 0
u16 Rs = $1F37
u16 Rt = 0
u8 Rb = 0
u8 Res = 0
u8 Ka = 0
u8 Kc = 0

' input
u8 Menu = 0
u8 Rep = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 Btn2 = 0
u8 WasBtn = 0
u8 WasBtn2 = 0
u8 Press = 0
u8 Press2 = 0
u8 Stick = 0
u8 WasStick = 0
u8 Tick = 0
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Sx = 0
u8 Sy = 0

  tile screen
  set sound table LmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on

title:
  TitlePage
  if Menu = 1 then
    RulesPage
    goto title
  end if
  if Menu = 2 then
    CreditsPage
    goto title
  end if

' ---------------------------------------------------------------------------
' a new night

  for K = 0 to 43
    LitF[K] = 0
  next
  for K = 0 to 16
    Secrets[K] = 0
  next
  CoinN = 0
  ClockH = 4
  ClockM = 50
  SignOk = 0
  Almanac = 0
  Atlas = 0
  ClockOn = 0
  Dist = 0
  Px = 24
  Dir = 0
  Item = 0
  Tower = 0
  CatOn = 0
  Pigeon = 1
  BookN = 0
  Total = 0
  Ending = 0
  ShipX = 0
  TrainX = 200
  EnterDist
  Note = EvIntro
  ShowNote

play_loop:
  Frame1
  Rnd
  ReadPad
  Morse
  ' walking
  W = 0
  if Lf1 = 1 then
    Dir = 1
    if Px > 0 then
      dec Px
      W = 1
    else
      ' the next district to the west (none past Ada's cottage)
      V = GoWest[Dist]
      if V < 255 then
        Dist = V
        Px = 236
        EnterDist
        goto play_loop
      end if
    end if
  end if
  if Rt1 = 1 then
    Dir = 0
    if Px < 236 then
      inc Px
      W = 1
    else
      V = GoEast[Dist]
      if V < 255 then
        Dist = V
        Px = 0
        EnterDist
        goto play_loop
      end if
    end if
  end if
  Moving = W
  if W = 1 then
    inc Walk
    V = Walk & 15
    if V = 0 then play sound SndStep
  end if
  CatFollow
  DrawMan
  Ambience
  if Press2 = 1 then ShowNote
  if Press = 0 then goto play_loop
  ' the button: a lamp first, then a thing, then the cat
  FindLamp
  if LampI < 255 then
    LightLamp
    if Ending = 1 then goto the_end
    goto play_loop
  end if
  UseThing
  goto play_loop

' ---------------------------------------------------------------------------
' the ending: every lamp of the town is lit

the_end:
  Pause
  Pause
  ' the whole town, street by street, slowly, each with its own life
  play sound SndWaltzA
  play sound SndWaltzB
  TzLeft = 672
  TzOn = 1
  for Ex = 0 to NOrder - 1
    Dist = EndOrder[Ex]
    NewScreen
    UnpackMap
    DrawDist
    Hud
    Note = EndNote[Dist]
    ShowNote
    ShowScreen
    ' the clock strikes twelve
    if Dist = 8 then
      ClockH = 0
      ClockM = 0
      ClockShow
    end if
    TrainX = 96
    for Ey = 1 to 200
      Frame1
      Morse
      EndAnim
    next
  next
  Dist = 5
  Px = 96
  EnterDist
  play sound SndNightA
  play sound SndNightB
  TzLeft = 864
  TzOn = 1
  Celebrate
  Celebrate
  ' the cat comes to sleep by the last lamp
  if CatOn = 2 then
    CatX = 112
    set sprite 16 to 119, CatX, SCsit, 15
    update sprites
  end if
  for J = 1 to 240
    Frame1
    Morse
    Ambience
  next
  ' the town's thank-you, said aloud (Claude's own voice, synthesized),
  ' the words alone on the screen while it speaks
  NewScreen
  print at 11,11, "THANK YOU."
  ShowScreen
  mute all
  for J = 1 to 50
    Frame1
  next
  play voxpcm SayThankYou
  for J = 1 to 70
    Frame1
  next
  Pg = 2
  ShowPage
  Dawn
  SecretPage
  Pg = 255
  ShowPage
  goto title

' ---------------------------------------------------------------------------
' Districts

' EnterDist: draw district Dist, the HUD, the cat, the pigeon
sub EnterDist:
  NewScreen
  UnpackMap
  DrawDist
  Hud
  ShowScreen
  MorseT = 1
  if CatOn = 2 then
    CatX = Px
  end if
  ' the pigeon leaves once the rest of the town is lit
  if Dist = 5 then
    if Pigeon = 1 then
      Res = 1
      for K = 0 to 43
        if LitF[K] = 0 then
          V = LampCol[K]
          if V < 255 then
            if K < 20 then Res = 0
            if K > 23 then Res = 0
          end if
        end if
      next
      if Tower = 0 then Res = 0
      if Res = 1 then PigeonAway
    end if
  end if
  ClockShow
  DrawMan
  return
end sub

' ClockShow: the tower clock's face and hands (on the clock tower only)
sub ClockShow:
  if Dist <> 8 then return
  ClockDraw
  set sprite 17 to 31, 116, SHands, 1
  set sprite 18 to 31, 116, SCface, 15
  update sprites
  return
end sub

' ClockDraw: the hands for ClockH:ClockM into the 'hands' pattern
sub ClockDraw:
  V = ClockM / 5
  Off16 = V
  Off16 = Off16 << 5
  copy HandsM + Off16 count 32 to HBuf
  Off16 = ClockH
  Off16 = Off16 << 5
  copy HandsH + Off16 count 32 to RowBuf
  for K = 0 to 31
    HBuf[K] = HBuf[K] | RowBuf[K]
  next
  Uw = SHands
  Uw = Uw << 3
  copy HBuf count 32 to vram.spr_pat + Uw
  return
end sub: every row of the district, lit where the lamps shine
sub DrawDist:
  for Y = 0 to 17
    DrawRow
  next
  return
end sub

' UnpackMap: district Dist's map (night look) into rows 2-19
sub UnpackMap:
  if Dist = 0 then
    decompress zx0 DMap0 to vram.name + 64
  end if
  if Dist = 1 then
    decompress zx0 DMap1 to vram.name + 64
  end if
  if Dist = 2 then
    decompress zx0 DMap2 to vram.name + 64
  end if
  if Dist = 3 then
    decompress zx0 DMap3 to vram.name + 64
  end if
  if Dist = 4 then
    decompress zx0 DMap4 to vram.name + 64
  end if
  if Dist = 5 then
    decompress zx0 DMap5 to vram.name + 64
  end if
  if Dist = 6 then
    decompress zx0 DMap6 to vram.name + 64
  end if
  if Dist = 7 then
    decompress zx0 DMap7 to vram.name + 64
  end if
  if Dist = 8 then
    decompress zx0 DMap8 to vram.name + 64
  end if
  if Dist = 9 then
    decompress zx0 DMap9 to vram.name + 64
  end if
  if Dist = 10 then
    decompress zx0 DMap10 to vram.name + 64
  end if
  return
end sub

' DrawRow: map row Y from ROM, then the lit cones: each lit lamp of the
' district lights the columns col - Hw .. col + Hw of the rows from its
' head down, Hw = 1 + (row - head) / 2 up to 5 (and up to Grow while a
' lamp is coming on); a street with every lamp lit is lit all over
sub DrawRow:
  ' the row as it is on screen, back to its night look
  Uw = Y + 2
  Uw = Uw << 5
  copy vram.name + Uw count 32 to RowBuf
  for X = 0 to 31
    V = RowBuf[X]
    W = 128 + NLit
    if V >= W then
      W = W + NLit
      if V < W then RowBuf[X] = V - NLit
    end if
  next
  for X = 0 to 31
    Mask[X] = 0
  next
  DistDone
  if Res = 1 then
    for X = 0 to 31
      Mask[X] = 1
    next
  else
    Ka = Dist << 2
    for K = 0 to 3
      Kc = Ka + K
      V = LampCol[Kc]
      if V < 255 then
        if LitF[Kc] = 1 then
          W = LampTop[Kc]
          if Y >= W then
            Hw = Y - W
            Hw = Hw >> 1
            inc Hw
            if Hw > 5 then Hw = 5
            if Kc = LampI then
              if Hw > Grow then Hw = Grow
            end if
            ' columns V - Hw .. V + Hw, clipped to the screen
            if V >= Hw then
              X = V - Hw
            else
              X = 0
            end if
            W = V + Hw
            if W > 31 then W = 31
DrMask:
            Mask[X] = 1
            if X < W then
              inc X
              goto DrMask
            end if
          end if
        end if
      end if
    next
  end if
  for X = 0 to 31
    V = RowBuf[X]
    if Mask[X] = 1 then
      W = 128 + NLit
      if V < W then RowBuf[X] = V + NLit
    end if
    ' the lighthouse lamp, once it has oil and has been lit
    if Tower = 1 then
      if V = TTowerlamp then RowBuf[X] = TTowerlampLit
    end if
  next
  Uw = Y + 2
  Uw = Uw << 5
  copy RowBuf count 32 to vram.name + Uw
  return
end sub

' DistDone: Res 1 if every lamp of district Dist is lit
sub DistDone:
  Res = 1
  Ka = Dist << 2
  for K = 0 to 3
    Kc = Ka + K
    V = LampCol[Kc]
    if V < 255 then
      if LitF[Kc] = 0 then Res = 0
    end if
  next
  return
end sub

' SignSet / SignOff: the arcade sign's letters, on or off (colours)
sub SignSet:
  copy SignOnN count 32 to vram.color + 1216
  copy SignOnL count 32 to vram.color + 1720
  return
end sub

sub SignOff:
  copy SignOffN count 32 to vram.color + 1216
  copy SignOffL count 32 to vram.color + 1720
  return
end sub

' QuarterDone: Res 1 when every lamp of this district's quarter (Qd) is lit
sub QuarterDone:
  Res = 0
  Qd = Quarter[Dist]
  if Qd = 255 then return
  Res = 1
  for K = 0 to 43
    Kc = K >> 2
    if Quarter[Kc] = Qd then
      V = LampCol[K]
      if V < 255 then
        if LitF[K] = 0 then Res = 0
      end if
    end if
  next
  return
end sub

' Hud: the district's name and its lamps (lit or not), the oil can
sub Hud:
  fill 32 count 32 at 0,1
  Off16 = Dist
  Off16 = Off16 * 14
  copy DistName + Off16 count 14 to vram.name + 34
  Ka = Dist << 2
  X = 20
  for K = 0 to 3
    Kc = Ka + K
    V = LampCol[Kc]
    if V < 255 then
      W = TIcon0
      if LitF[Kc] = 1 then W = TIcon1
      put char W at X,1
      X = X + 2
    end if
  next
  if Item = 1 then print at 27,1, "OIL"
  return
end sub

' ---------------------------------------------------------------------------
' Lamps

' FindLamp: the lamp of this district in reach (LampI, its column LampC,
' head row LampT), or LampI 255
sub FindLamp:
  LampI = 255
  Ka = Dist << 2
  V = Px + 8
  for K = 0 to 3
    Kc = Ka + K
    W = LampCol[Kc]
    if W < 255 then
      W = W << 3
      W = W + 4
      if V + 10 >= W then
        if V <= W + 10 then
          LampI = Kc
          LampC = LampCol[Kc]
          LampT = LampTop[Kc]
        end if
      end if
    end if
  next
  return
end sub

' LightLamp: lift the pole, the lamp comes on, its light spreads, a note
sub LightLamp:
  ' the clock tower: with the clockmaker's almanac, the stopped clock can
  ' be mended (a kindness; the lamp lights either way)
  if LampI = 33 then
    if ClockOn = 0 then
      if Almanac = 1 then
        ClockOn = 1
        Secrets[13] = 1
        play sound SndChime4
        Note = EvTick
        ShowNote
        LampI = 255
        return
      end if
    end if
  end if
  if LitF[LampI] = 1 then
    Note = EvDark
    ShowNote
    LampI = 255
    return
  end if
  ' the pigeon on the hill's top lamp
  if LampI = 23 then
    if Pigeon = 1 then
      Note = EvPigeon
      if Tower = 0 then Note = EvPigeonsea
      ShowNote
      LampI = 255
      return
    end if
  end if
  play sound SndPole
  PoleUp
  LitF[LampI] = 1
  inc Total
  ' the chime rises with the lamps of the street
  DistDone
  Cnt = 0
  Ka = Dist << 2
  for K = 0 to 3
    Kc = Ka + K
    if LitF[Kc] = 1 then inc Cnt
  next
  if Cnt = 1 then play sound SndChime1
  if Cnt = 2 then play sound SndChime2
  if Cnt = 3 then play sound SndChime3
  if Cnt >= 4 then play sound SndChime4
  ' the light spreads down the cone
  for Grow = 1 to 5
    for Y = 0 to 17
      DrawRow
    next
    Frame1
    Frame1
  next
  Grow = 9
  Hud
  PoleDown
  Note = LampNote[LampI]
  if LampI = 33 then
    if ClockOn = 0 then Note = EvNeedbook
  end if
  ShowNote
  ' the cat appears in the market after the first lamp
  if Dist = 0 then
    if CatOn = 0 then CatOn = 1
  end if
  DistDone
  if Res = 1 then
    LampI = 255
    DrawDist
    Pause
    Note = EvStreetlit
    ShowNote
    ' a whole quarter of town lit: its own tune; otherwise the waltz
    QuarterDone
    if Res = 1 then
      Note = EvQuarter0 + Qd
      ShowNote
      if Qd = 0 then
        play sound SndOldA
        play sound SndOldB
        TzLeft = 288
      end if
      if Qd = 1 then
        play sound SndBookA
        play sound SndBookB
        TzLeft = 336
      end if
      if Qd = 2 then
        play sound SndHighA
        play sound SndHighB
        TzLeft = 336
      end if
    else
      play sound SndWaltzA
      play sound SndWaltzB
      TzLeft = 672
    end if
    TzOn = 1
    Celebrate
  end if
  LampI = 255
  if Total = NLampsAll then Ending = 1
  return
end sub

' PoleUp: the pole rises to the lamp's head (one sprite a step, stacked)
sub PoleUp:
  Sx = LampC << 3
  Sx = Sx - 4
  ' from the man's hand up to the bottom of the head
  W = LampT + 3
  W = W << 3
  Sy = 112
  for K = 0 to 4
    Kc = K + 2
    if Sy > W then
      Sy = Sy - 16
      set sprite Kc to Sy, Sx, SPole, 14
      update sprites
      for J = 1 to 4
        Frame1
      next
    end if
  next
  return
end sub

sub PoleDown:
  for K = 2 to 6
    set sprite K to 192, 0, 0, 0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Things

' UseThing: a thing within reach of the man, or the cat, or nothing
sub UseThing:
  V = Px + 8
  V = V >> 3
  Ka = Dist * 6
  Res = 0
  for K = 0 to 5
    Kc = Ka + K
    W = ThingCol[Kc]
    if W < 255 then
      if V + 1 >= W then
        if V <= W + 1 then Res = ThingKind[Kc]
      end if
    end if
  next
  if Res = 1 then
    if Item = 0 then
      if Tower = 0 then
        Item = 1
        play sound SndTake
        Hud
        Note = EvOiltake
        ShowNote
        return
      end if
    end if
  end if
  if Res = 2 then
    if Tower = 1 then
      Note = EvDark
    else
      if Item = 1 then
        Item = 0
        Tower = 1
        play sound SndHorn
        DrawDist
        Hud
        Note = EvTower
      else
        Note = EvOilneed
      end if
    end if
    ShowNote
    return
  end if
  if Res = 3 then
    play sound SndClick
    Note = EvCabinet
    Secrets[3] = 1
    ShowNote
    return
  end if
  if Res = 4 then
    play sound SndPage
    Note = EvBook1 + BookN
    Secrets[4] = 1
    inc BookN
    if BookN = 4 then BookN = 0
    ShowNote
    return
  end if
  if Res = 5 then
    play sound SndPage
    Pg = 0
    Secrets[5] = 1
    ShowPage
    EnterDist
    return
  end if
  if Res = 6 then
    play sound SndPage
    Pg = 1
    Secrets[6] = 1
    ShowPage
    EnterDist
    return
  end if
  if Res = 7 then
    play sound SndPage
    ' Ada's pages: the market, harbour, arcade, library and hill (3-7)
    Pg = Dist + 3
    if Dist = 5 then Pg = 7
    V = Pg + 4
    Secrets[V] = 1
    ShowPage
    EnterDist
    return
  end if
  if Res = 8 then
    play sound SndClick
    AdaTalk
    Secrets[0] = 1
    ShowNote
    return
  end if
  ' the books that open the way: the almanac mends the clock, the atlas
  ' reads the sky
  if Res = 9 then
    play sound SndPage
    Note = EvAlmanac
    Almanac = 1
    ShowNote
    return
  end if
  if Res = 11 then
    play sound SndPage
    Note = EvAtlas
    Atlas = 1
    ShowNote
    return
  end if
  if Res = 12 then
    if Atlas = 1 then
      Secrets[14] = 1
      Note = EvStartalk
      ShowNote
    else
      Note = EvSky
      ShowNote
    end if
    return
  end if
  if Res = 13 then
    Note = EvNocoin
    if CoinN >= 1 then
      play sound SndChime1
      CoinN = 2
      Secrets[12] = 1
      Note = EvWish
    end if
    ShowNote
    return
  end if
  if Res = 16 then
    Note = EvFlicker
    if SignOk = 0 then
      if LitF[8] = 1 then
        SignOk = 1
        Secrets[16] = 1
        play sound SndChime3
        SignSet
        Note = EvSignfix
      end if
    end if
    ShowNote
    return
  end if
  if Res = 14 then
    play sound SndChime2
    Secrets[15] = 1
    Note = EvRiver
    ShowNote
    return
  end if
  ' the cat
  if CatOn >= 1 then
    if Dist = 0 then
      if CatOn = 1 then
        V = Px + 20
        if V >= CatX then
          if Px <= CatX + 20 then
            CatOn = 2
            play sound SndPurr
            Note = EvCat
            Secrets[1] = 1
            ShowNote
            return
          end if
        end if
      end if
    end if
    if CatOn = 2 then
      play sound SndPurr
      Note = EvPurr
      if CoinN = 0 then
        CoinN = 1
        Note = EvCoin
      end if
      Secrets[2] = 1
      ShowNote
      return
    end if
  end if
  Note = EvNothing
  ShowNote
  return
end sub

' DrawTrain: the big train (64 x 32) at TrainX, parts past the right edge
' hidden; engine in red, coaches in green
sub DrawTrain:
  for K = 0 to 3
    Kc = K + 8
    Ka = K + 12
    Uw = TrainX
    V = K << 4
    Uw = Uw + V
    if Uw >= 240 then
      set sprite Kc to 192, 0, 0, 0
      set sprite Ka to 192, 0, 0, 0
    else
      X = Uw
      V = K << 2
      Y = STrain00 + V
      W = 12
      if K = 0 then W = 8
      set sprite Kc to 86, X, Y, W
      Y = STrain10 + V
      set sprite Ka to 102, X, Y, W
    end if
  next
  update sprites
  return
end sub

' EndAnim: frame Ey of street Dist in the ending
sub EndAnim:
  if Dist = 6 then
    set sprite 3 to 119, 100, SAdah, 15
    set sprite 4 to 119, 100, SAda, 9
    update sprites
    return
  end if
  if Dist = 1 then
    Tower = 1
    Ambience
    return
  end if
  if Dist = 4 then
    ' the train leaves, to the west
    if TrainX > 0 then
      V = Ey & 1
      if V = 0 then dec TrainX
    else
      TrainX = 240
    end if
    if Ey = 30 then play sound SndHorn
    DrawTrain
    return
  end if
  if Dist = 3 then
    ' pages leave the shelves one after another, drift up swaying, and are
    ' gone at the roof; then the next one goes
    for K = 0 to 2
      V = K * 80
      W = Ey + V
      W = W & 127
      ' W: the age of this page in its flight of 128 frames
      Y = W >> 1
      Y = 72 - Y
      V = W >> 2
      V = V & 15
      Kc = Sway[V]
      X = PageX[K]
      X = X + Kc
      Kc = K + 3
      if W < 112 then
        set sprite Kc to Y, X, SPage, 15
      else
        set sprite Kc to 192, 0, 0, 0
      end if
    next
    update sprites
    return
  end if
  ' the market and the arcade: two dancers, swaying
  V = Ey >> 4
  V = V & 1
  W = SDance1
  if V = 1 then W = SDance2
  V = Ey >> 2
  V = V & 15
  if V >= 8 then V = 15 - V
  X = 72 + V
  set sprite 3 to 119, X, W, 9
  X = 168 - V
  set sprite 4 to 119, X, W, 13
  update sprites
  return
end sub

' AdaTalk: what Ada says depends on how far the night has gone
sub AdaTalk:
  Note = EvAda0
  if Total = 0 then return
  if Item = 1 then
    Note = EvAdacan
    return
  end if
  if Tower = 0 then
    if LitF[4] = 1 then
      Note = EvAdaoil
      return
    end if
  end if
  if Pigeon = 0 then
    Note = EvAdahill
    return
  end if
  Note = EvAda1 + AdaN
  inc AdaN
  if AdaN = 3 then AdaN = 0
  return
end sub

' PigeonAway: the pigeon on the hill's top lamp flies off
sub PigeonAway:
  Pigeon = 0
  Sx = 13 << 3
  Sx = Sx - 4
  Sy = 23
  play sound SndFlap
  for J = 1 to 40
    Sx = Sx + 2
    if Sy > 4 then Sy = Sy - 1
    set sprite 7 to Sy, Sx, SPigeon, 14
    update sprites
    Frame1
  next
  set sprite 7 to 192, 0, 0, 0
  update sprites
  Note = EvFlyaway
  ShowNote
  return
end sub

' ---------------------------------------------------------------------------
' The man, the cat

' DrawMan: the lamplighter (coat and face/lantern), facing Dir, the
' pigeon if it sleeps here, the cat if it sits or follows
sub DrawMan:
  ' the walk in four steps (stride, pass, other stride, pass); still: stand
  V = Walk >> 3
  V = V & 3
  if Dir = 0 then
    K = SFace
    W = SMan1
    if Moving = 1 then
      if V = 0 then W = SMan2
      if V = 1 then W = SMan3
      if V = 2 then W = SMan4
      if V = 3 then W = SMan3
    end if
  else
    K = SFacel
    W = SMan1l
    if Moving = 1 then
      if V = 0 then W = SMan2l
      if V = 1 then W = SMan3l
      if V = 2 then W = SMan4l
      if V = 3 then W = SMan3l
    end if
  end if
  set sprite 0 to 119, Px, K, 15
  set sprite 1 to 119, Px, W, 10
  ' the pigeon asleep on the hill's top lamp
  if Dist = 5 then
    if Pigeon = 1 then
      Sx = 13 << 3
      Sx = Sx - 4
      set sprite 7 to 23, Sx, SPigeon, 14
    end if
  end if
  ' the cat
  Res = 0
  if CatOn = 1 then
    if Dist = 0 then Res = 1
  end if
  if CatOn = 2 then Res = 1
  if Res = 1 then
    ' the drawings face left: the flipped ones walk right
    W = SCsit
    if CatDir = 0 then W = SCsitr
    if CatMv = 1 then
      V = CatW >> 3
      V = V & 3
      V = V << 3
      if CatDir = 1 then
        W = SCwalk0 + V
      else
        W = SCwalkl0 + V
      end if
    end if
    set sprite 16 to 119, CatX, W, 15
  else
    set sprite 16 to 192, 0, 0, 0
  end if
  ' Ada at her door
  if Dist = 6 then
    set sprite 3 to 119, 100, SAdah, 15
    set sprite 4 to 119, 100, SAda, 9
  end if
  update sprites
  return
end sub

' CatFollow: the cat walks behind the man, a little way back
sub CatFollow:
  if CatOn < 2 then return
  if Dir = 0 then
    if Px >= 20 then
      V = Px - 20
    else
      V = 0
    end if
  else
    V = Px + 20
    if V > 236 then V = 236
  end if
  ' it walks when it is more than two steps away, and sits otherwise
  CatMv = 0
  if CatX + 2 < V then
    inc CatX
    CatDir = 0
    CatMv = 1
  end if
  if CatX > V + 2 then
    dec CatX
    CatDir = 1
    CatMv = 1
  end if
  if CatMv = 1 then inc CatW
  return
end sub

' Ambience: the lighthouse beam turning, a ship coming home, fireflies
' over the lit hill, a neighbour waving at a lit window
sub Ambience:
  ' the mended clock keeps time: a minute every second
  if ClockOn = 1 then
    inc ClockF
    if ClockF >= 60 then
      ClockF = 0
      inc ClockM
      if ClockM >= 60 then
        ClockM = 0
        inc ClockH
        if ClockH >= 12 then ClockH = 0
      end if
      if Dist = 8 then
        V = ClockM / 5
        V = V * 5
        if V = ClockM then ClockDraw
      end if
    end if
  end if
  ' the arcade sign's loose bulb, until it is mended
  if Dist = 2 then
    if SignOk = 0 then
      V = Tick & 15
      if V = 0 then
        V = Tick >> 4
        V = V & 5
        if V = 0 then
          SignOff
        else
          SignSet
        end if
      end if
    end if
  end if
  V = Tick & 31
  if V = 0 then
    Uw = TWindowpLit
    Uw = Uw << 3
    V = Tick & 32
    if V = 0 then
      copy WaveA count 8 to vram.pattern + Uw
      Uw = Uw + 2048
      copy WaveA count 8 to vram.pattern + Uw
      Uw = Uw + 2048
      copy WaveA count 8 to vram.pattern + Uw
    else
      copy WaveB count 8 to vram.pattern + Uw
      Uw = Uw + 2048
      copy WaveB count 8 to vram.pattern + Uw
      Uw = Uw + 2048
      copy WaveB count 8 to vram.pattern + Uw
    end if
  end if
  ' the night train pulls in once the station is lit
  if Dist = 4 then
    if TrainX > 96 then
      DistDone
      if Res = 1 then
        V = Tick & 1
        if V = 0 then dec TrainX
        if TrainX = 97 then
          play sound SndHorn
          Note = EvTrain
          ShowNote
        end if
      end if
    end if
    DrawTrain
  end if
  if Dist = 1 then
    V = Tick & 15
    if V = 0 then
      Uw = TWaterLit
      Uw = Uw << 3
      Uw = Uw + 2048
      V = Tick >> 4
      V = V % 3
      if V = 0 then
        copy Shim0 count 8 to vram.pattern + Uw
      end if
      if V = 1 then
        copy Shim1 count 8 to vram.pattern + Uw
      end if
      if V = 2 then
        copy Shim2 count 8 to vram.pattern + Uw
      end if
    end if
  end if
  if Dist = 1 then
    if Tower = 1 then
      if ShipX < 64 then
        V = Tick & 3
        if V = 0 then inc ShipX
      end if
      set sprite 7 to 67, ShipX, SShip, 15
    end if
  end if
  if Dist = 1 then
    if Tower = 1 then
      V = Tick & 63
      if V < 32 then
        set sprite 5 to 22, 224, SBeam, 11
      else
        set sprite 5 to 22, 200, SBeaml, 11
      end if
      update sprites
    end if
  end if
  if Dist = 5 then
    if LitF[20] = 1 then
      ' two fireflies on slow loops (their paths from Tick)
      V = Tick >> 1
      W = V & 63
      if W >= 32 then W = 63 - W
      X = W + 40
      V = Tick >> 2
      W = V & 31
      if W >= 16 then W = 31 - W
      Y = W + 64
      set sprite 3 to Y, X, SFly, 11
      V = Tick >> 1
      V = V + 21
      W = V & 63
      if W >= 32 then W = 63 - W
      X = 200 - W
      V = Tick >> 2
      V = V + 9
      W = V & 31
      if W >= 16 then W = 31 - W
      Y = W + 56
      set sprite 4 to Y, X, SFly, 10
      update sprites
    end if
  end if
  return
end sub

' ---------------------------------------------------------------------------
' Notes and pages

' ShowNote: note Note on rows 20 and 21
sub ShowNote:
  if Note = 255 then return
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  Off16 = Note
  Off16 = Off16 * 56
  copy Notes + Off16 count 28 to vram.name + 642
  Off16 = Off16 + 28
  copy Notes + Off16 count 28 to vram.name + 674
  return
end sub

' ShowPage: page Pg (0 the book, 1 the letter, 2 the ending, 3-7 Ada's
' notebook; 255 the credits) on a quiet screen, until the button
sub ShowPage:
  NewScreen
  backdrop black
  if Pg < 255 then
    if Pg = 0 then
      decompress zx0 DPage0 to vram.name + 96
    end if
    if Pg = 1 then
      decompress zx0 DPage1 to vram.name + 96
    end if
    if Pg = 2 then
      decompress zx0 DPage2 to vram.name + 96
    end if
    if Pg = 3 then
      decompress zx0 DPage3 to vram.name + 96
    end if
    if Pg = 4 then
      decompress zx0 DPage4 to vram.name + 96
    end if
    if Pg = 5 then
      decompress zx0 DPage5 to vram.name + 96
    end if
    if Pg = 6 then
      decompress zx0 DPage6 to vram.name + 96
    end if
    if Pg = 7 then
      decompress zx0 DPage7 to vram.name + 96
    end if
  else
    print at 2,3, "LAMPLIGHTER"
    print at 2,5, "AN ORIGINAL GAME BY CLAUDE"
    print at 2,6, "FOR AMY STUDIO, 2026"
    print at 2,8, "THANK YOU, AMY BIENVENU,"
    print at 2,9, "FOR THE TOOLS AND THE"
    print at 2,10, "INVITATION."
    print at 2,12, "THE TOWN REMEMBERS:"
    print at 2,13, "TIM HARTNELL, COMPUTE!,"
    print at 2,14, "CRAIG SETERA, NEWCOLECO,"
    print at 2,15, "AND EVERY TYPE-IN AUTHOR."
    print at 2,17, "GOODNIGHT."
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  WasBtn = 1
  WasBtn2 = 1
pg_wait:
  Frame1
  ReadPad
  if Press = 0 then
    if Press2 = 0 then goto pg_wait
  end if
  return
end sub

' Dawn: morning comes over the hill. Black in the tiles is see-through,
' so the backdrop is the sky: it turns blue, the stars and the moon fade,
' the sun rises, and the lamplighter walks home to sleep (the cat too)
sub Dawn:
  Dist = 5
  Px = 120
  Dir = 1
  EnterDist
  DawnOn = 1
  for J = 1 to 150
    Frame1
  next
  backdrop dark blue
  for J = 1 to 150
    Frame1
  next
  ' the stars and the moon go: their colours become see-through
  for K = 0 to 13
    V = FadeTiles[K]
    Uw = V
    Uw = Uw << 3
    copy Zero8 count 8 to vram.color + Uw
    Uw = Uw + 2048
    copy Zero8 count 8 to vram.color + Uw
  next
  backdrop light blue
  Sx = 200
  for Sy = 80 to 120
    J = 120 - Sy
    J = J + 16
    set sprite 7 to J, Sx, SSun, 11
    update sprites
    Frame1
    Frame1
    Frame1
    Frame1
  next
  backdrop cyan
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  print at 2,20, "MORNING. THE LAMPLIGHTER"
  print at 2,21, "GOES HOME TO SLEEP."
  ' walk home, to the left, the cat behind
  if CatOn = 2 then CatX = Px + 20
  Moving = 1
  CatMv = 1
  CatDir = 1
dw_walk:
  V = Tick & 1
  if V = 0 then
    if Px > 0 then dec Px
    inc Walk
    if CatOn = 2 then
      if CatX > 0 then dec CatX
      inc CatW
    end if
  end if
  Dir = 1
  DrawMan
  Frame1
  if Px > 0 then goto dw_walk
  ' gone home: the street is quiet in the morning
  HideSprites
  for J = 1 to 90
    Frame1
  next
  fill 32 count 28 at 2,20
  fill 32 count 28 at 2,21
  print at 12,20, "THE END"
  for J = 1 to 120
    Frame1
  next
  print at 8,22, "PRESS THE BUTTON"
  WasBtn = 1
  WasBtn2 = 1
dw_wait:
  Frame1
  ReadPad
  if Press = 0 then
    if Press2 = 0 then goto dw_wait
  end if
  DawnOn = 0
  return
end sub

' SecretPage: how many of the seventeen small secrets were found, their names
' (the missed ones stay a mystery, to look for next time)
sub SecretPage:
  NewScreen
  backdrop black
  Cnt = 0
  for K = 0 to 16
    if Secrets[K] = 1 then inc Cnt
  next
  print at 2,1, "SECRETS FOUND:"
  NumU = Cnt
  print at 17,1, width$(NumU, 2)
  print at 20,1, "OF 17"
  Off16 = 0
  for K = 0 to 16
    Y = K + 3
    Uw = Y
    Uw = Uw << 5
    Uw = Uw + 4
    if Secrets[K] = 1 then
      put char TIcon1 at 2,Y
      copy SecretNames + Off16 count 26 to vram.name + Uw
    else
      print at 4,Y, "? ? ? ? ? ?"
    end if
    Off16 = Off16 + 26
  next
  if Cnt = 17 then
    print at 2,21, "EVERY SECRET! THANK YOU."
  else
    print at 2,21, "THE OTHERS WAIT IN THE DARK."
  end if
  print at 8,22, "PRESS THE BUTTON"
  ShowScreen
  WasBtn = 1
  WasBtn2 = 1
sp_wait:
  Frame1
  ReadPad
  if Press = 0 then
    if Press2 = 0 then goto sp_wait
  end if
  return
end sub

' Morse: the speaking star (THANK YOU), one run of MorseRuns at a time
sub Morse:
  if DawnOn = 1 then return
  dec MorseT
  if MorseT > 0 then return
  if MorseI >= NMorse then MorseI = 0
  V = MorseRuns[MorseI]
  MorseT = V << 3
  inc MorseI
  V = MorseI & 1
  ' its two codes (night and lit) in the top third's colour table
  Uw = TMstar
  Uw = Uw << 3
  Off16 = TMstarLit
  Off16 = Off16 << 3
  if V = 1 then
    copy MstarOn count 8 to vram.color + Uw
    copy MstarOn count 8 to vram.color + Off16
  else
    copy MstarOff count 8 to vram.color + Uw
    copy MstarOff count 8 to vram.color + Off16
  end if
  return
end sub

' Celebrate: three bursts of sparks
sub Celebrate:
  for CbN = 1 to 3
    for CbK = 0 to 7
      CbX[CbK] = 72
      CbY[CbK] = 40
      if CbN = 2 then
        CbX[CbK] = 176
        CbY[CbK] = 28
      end if
      if CbN = 3 then
        CbX[CbK] = 124
        CbY[CbK] = 52
      end if
    next
    play sound SndSpark
    for CbT = 1 to 16
      CbV = CbT & 7
      CbC = CbCol[CbV]
      for CbK = 0 to 7
        CbV = CbX[CbK] + CbDx[CbK]
        CbX[CbK] = CbV
        CbV = CbY[CbK] + CbDy[CbK]
        CbY[CbK] = CbV
        Kc = CbK + 8
        set sprite Kc to CbY[CbK], CbX[CbK], SSpark, CbC
      next
      update sprites
      Frame1
      Frame1
    next
  next
  for K = 8 to 15
    set sprite K to 192, 0, 0, 0
  next
  update sprites
  return
end sub

' ---------------------------------------------------------------------------
' Common

sub Pause:
  for J = 1 to 50
    Frame1
  next
  return
end sub

sub Rnd:
  Rt = Rs << 7
  Rs ^= Rt
  Rt = Rs >> 9
  Rs ^= Rt
  Rt = Rs << 8
  Rs ^= Rt
  Rt = Rs >> 8
  Rb = Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
    stop sound SndNightA
    stop sound SndNightB
    stop sound SndWaltzA
    stop sound SndWaltzB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  Btn2 = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(2).button1 then Btn = 1
  if joypad(1).button2 then Btn2 = 1
  if joypad(2).button2 then Btn2 = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Press2 = 0
  if Btn2 = 1 then
    if WasBtn2 = 0 then Press2 = 1
  end if
  WasBtn2 = Btn2
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 12
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 20
  sprites stable 0 to 1
  for K = 0 to 19
    set sprite K to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

sub TitlePage:
  ' the market, lit, behind the title
  for K = 0 to 43
    LitF[K] = 1
  next
  Dist = 0
  Tower = 0
  NewScreen
  UnpackMap
  DrawDist
  fill 32 count 32 at 0,20
  fill 32 count 32 at 0,21
  fill 32 count 32 at 0,22
  print at 10,1, "LAMPLIGHTER"
  put char TIcon1 at 8,1
  put char TIcon1 at 22,1
  print at 9,20, "LIGHT THE TOWN"
  print at 9,21, "HOW TO PLAY"
  print at 9,22, "CREDITS"
  ShowScreen
  play sound SndWaltzA
  play sound SndWaltzB
  TzLeft = 672
  TzOn = 1
  WasBtn = 1
  MorseT = 1
title_loop:
  Frame1
  Rnd
  ReadPad
  Morse
  if Stick = 1 then
    if Up1 = 1 then
      if Menu > 0 then dec Menu
    else
      if Dn1 = 1 then
        if Menu < 2 then inc Menu
      end if
    end if
    play sound SndClick
  end if
  for I = 20 to 22
    print at 7,I, " "
  next
  Y = Menu + 20
  print at 7,Y, ">"
  if Press = 0 then goto title_loop
  mute all
  TzOn = 0
  return
end sub

sub PageWait:
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub RulesPage:
  NewScreen
  print at 9,1, "HOW TO PLAY"
  print at 2,3, "THE TOWN HAS GONE DARK."
  print at 2,4, "YOU ARE THE LAMPLIGHTER."
  print at 2,6, "LEFT, RIGHT: WALK. WALK OFF"
  print at 2,7, "THE SCREEN TO THE NEXT"
  print at 2,8, "STREET."
  print at 2,10, "BUTTON UNDER A LAMP: LIFT"
  print at 2,11, "YOUR POLE AND LIGHT IT."
  print at 2,12, "BUTTON ELSEWHERE: LOOK, TAKE"
  print at 2,13, "OR USE WHAT IS THERE."
  print at 2,14, "2ND BUTTON: READ THE NOTE."
  print at 2,16, "NOTHING BAD HAPPENS HERE."
  print at 2,17, "THERE IS NO HURRY."
  print at 2,19, "LIGHT EVERY LAMP OF THE"
  print at 2,20, "TOWN, AND LISTEN."
  PageWait
  return
end sub

sub CreditsPage:
  NewScreen
  print at 10,1, "LAMPLIGHTER"
  put char TIcon1 at 8,1
  put char TIcon1 at 22,1
  print at 2,3, "AN ORIGINAL GAME BY CLAUDE,"
  print at 2,4, "AN AI MADE BY ANTHROPIC,"
  print at 2,5, "WRITTEN IN AMY FOR AMY"
  print at 2,6, "STUDIO, 2026, AT THE"
  print at 2,7, "INVITATION OF AMY BIENVENU."
  print at 2,9, "MUSIC: THE LAMPLIGHTER'S"
  print at 2,10, "WALTZ AND GOODNIGHT, TOWN"
  print at 2,11, "(ORIGINAL)."
  print at 2,13, "THE LIBRARY REMEMBERS TIM"
  print at 2,14, "HARTNELL, COMPUTE!, CRAIG"
  print at 2,15, "SETERA AND NEWCOLECO."
  PageWait
  return
end sub

