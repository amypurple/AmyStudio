cartridge "GOT A MATCH?/WALTER E. MEYERS, AHOY!/1986"

' GOT A MATCH?
' Based on "Got a Match?" by Walter E. Meyers, Ahoy! June 1986 (page 30,
' listing pages 86-90), a Commodore 64 game. Made for the ColecoVision in
' Amy (the language by Amy Bienvenu) by Claude (an AI made by Anthropic)
' for Amy Studio, 2026.
'
' Not a line-for-line port: a ColecoVision game on the listing's rules
' (orig/ has the scans). The story: Buck and Wingo, trapped in their mine
' in the Dismal Seepage Range, pass the time with Kim's game played with
' Berzerkons, jewels in four kinds and many colours. Kept from the
' listing: four kinds of Berzerkons, each kind a row of 1 to level + 3
' of them (D(1)=I+3, N=INT(RND(0)*D)+1) in one of the six colours of its
' C$ (black, white, red, purple, green, blue); a study time set by the
' level (line 470: about a minute at level 1, 15 seconds at level 9;
' here 60 - 5 x level seconds), a press ends it early ("hit any key when
' y'all're done studyin'"); then, kind by kind, HOW MANY? (a pointer over
' 1 to 12) and WHAT COLOR? (a pointer over the six colours), 10 points a
' right answer (the listing's PS*10); 1 to 4 players taking turns (the
' listing allowed 9), five rounds; the winner or winners at the end.
' The listing's kind names (a joke on a famous comedy trio) are replaced
' by four names of my own, and the Berzerkons are my own gem creatures:
' SPIKIES, ROUNDIES, BLOCKIES and TWISTIES.
' Made for this machine: the cave of the mine, the Berzerkons as 2 x 2
' tile pictures in their colours on the sand, a draining bar for the study
' time, a pick-handle pointer sprite for the answers, cowboy talk, the
' listing's tune (Clementine, traditional, read from its DATA 2000-2090)
' quietly under the game, an original title tune ("Jewel Rush").
'
' Controls (either joystick): on the title, up and down choose, left and
' right change, a button picks; in the game, a button ends the study
' time, left and right move the pointer, a button answers. With several
' players, pass the controller or each use your own: either one answers.
'
' House rules kept: text in columns 2-29 and rows 1-22; tiles from code
' 128; the frame loop is protected from the NMI and every screen is drawn
' with the NMI off after a wait.

const TB0000 = 128
const TB0001 = 129
const TB0010 = 130
const TB0011 = 131
const TB1000 = 132
const TB1001 = 133
const TB1010 = 134
const TB1011 = 135
const TB2000 = 136
const TB2001 = 137
const TB2010 = 138
const TB2011 = 139
const TB3000 = 140
const TB3001 = 141
const TB3010 = 142
const TB3011 = 143
const TB0100 = 144
const TB0101 = 145
const TB0110 = 146
const TB0111 = 147
const TB1100 = 148
const TB1101 = 149
const TB1110 = 150
const TB1111 = 151
const TB2100 = 152
const TB2101 = 153
const TB2110 = 154
const TB2111 = 155
const TB3100 = 156
const TB3101 = 157
const TB3110 = 158
const TB3111 = 159
const TB0200 = 160
const TB0201 = 161
const TB0210 = 162
const TB0211 = 163
const TB1200 = 164
const TB1201 = 165
const TB1210 = 166
const TB1211 = 167
const TB2200 = 168
const TB2201 = 169
const TB2210 = 170
const TB2211 = 171
const TB3200 = 172
const TB3201 = 173
const TB3210 = 174
const TB3211 = 175
const TB0300 = 176
const TB0301 = 177
const TB0310 = 178
const TB0311 = 179
const TB1300 = 180
const TB1301 = 181
const TB1310 = 182
const TB1311 = 183
const TB2300 = 184
const TB2301 = 185
const TB2310 = 186
const TB2311 = 187
const TB3300 = 188
const TB3301 = 189
const TB3310 = 190
const TB3311 = 191
const TB0400 = 192
const TB0401 = 193
const TB0410 = 194
const TB0411 = 195
const TB1400 = 196
const TB1401 = 197
const TB1410 = 198
const TB1411 = 199
const TB2400 = 200
const TB2401 = 201
const TB2410 = 202
const TB2411 = 203
const TB3400 = 204
const TB3401 = 205
const TB3410 = 206
const TB3411 = 207
const TB0500 = 208
const TB0501 = 209
const TB0510 = 210
const TB0511 = 211
const TB1500 = 212
const TB1501 = 213
const TB1510 = 214
const TB1511 = 215
const TB2500 = 216
const TB2501 = 217
const TB2510 = 218
const TB2511 = 219
const TB3500 = 220
const TB3501 = 221
const TB3510 = 222
const TB3511 = 223
const TB0600 = 224
const TB0601 = 225
const TB0610 = 226
const TB0611 = 227
const TB1600 = 228
const TB1601 = 229
const TB1610 = 230
const TB1611 = 231
const TB2600 = 232
const TB2601 = 233
const TB2610 = 234
const TB2611 = 235
const TB3600 = 236
const TB3601 = 237
const TB3610 = 238
const TB3611 = 239
const TSand = 240
const TRock = 241
const TRocktop = 242
const TBarf = 243
const TBare = 244
const TSw0 = 245
const TSw1 = 246
const TSw2 = 247
const TSw3 = 248
const TSw4 = 249
const TSw5 = 250
const SPtr = 0
const NTiles8 = 984
const SprBytes = 32
const SndTuneA = 1
const SndTuneB = 2
const SndPlayA = 3
const SndPlayB = 4
const SndMove = 5
const SndPick = 6
const SndRight = 7
const SndWrong = 8
const SndHide = 9
const SndOver = 10
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' the game: Pl players (1-4), Lv the level (1-9), Up the player at play
' (0-3), Rd the round (0-4), Sc[] the scores; Z[] how many of each kind,
' Zc[] its colour (0-5); Qk the kind asked, Pv the pointer's value, Ans
' the answer; Ph the phase for the tests (0 menus, 1 studying, 2 how
' many, 3 what colour, 4 the verdict, 5 game over)
u8 Pl = 1
u8 Lv = 1
u8 Up = 0
u8 Rd = 0
u16 Sc[4]
u8 Z[4]
u8 Zc[4]
u8 Qk = 0
u8 Pv = 1
u8 Pmax = 12
u8 Ans = 0
u8 Ph = 0
u8 Good = 0
' the study time: StudyF frames in all, Rmn left, Per frames a bar cell,
' Cells the cells still lit
u16 StudyF = 3300
u16 Rmn = 0
u16 Per = 0
u8 Cells = 24
u8 NC = 0
' the random numbers (xorshift), stirred while the title waits
u16 Rs = $5A3C
u16 Rt = 0

u16 NumU = 0
u16 Best = 0
u16 W16 = 0
u8 Mi = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Dn1 = 0
u8 Up1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Hold = 0
u8 Tick = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 Bk = 0
u8 Bc = 0
u8 Bx = 0
u8 By = 0
u8 Nw = 0
u8 Idle = 0

  tile screen
  set sound table GmSoundTable areas 6
  sprites 16x16
  set sprite count 1
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Mi = 3 then goto title

new_game:
  for K = 0 to 3
    Sc[K] = 0
  next
  Rd = 0
  ' the study time: 60 - 5 x level seconds, the bar's 24 cells
  V = Lv * 5
  V = 60 - V
  StudyF = V
  StudyF = StudyF * 60
  Per = StudyF / 24
  play sound SndPlayA
  play sound SndPlayB

a_round:
  Up = 0
a_turn:
  MakeMine
  DrawMine
  print at 2,21, "PLAYER "
  NumU = Up + 1
  print at 9,21, digits$(NumU, 1)
  print at 10,21, ": STUDY 'EM!"
  for X = 4 to 27
    put char TBarf at X,22
  next
  Cells = 24
  ShowHud
  ShowScreen
  Ph = 1
  Rmn = StudyF
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
study_loop:
  Frame1
  ReadAll
  if Press = 1 then goto study_done
  dec Rmn
  if Rmn = 0 then goto study_done
  ' the bar: one cell goes dark each Per frames
  W16 = Rmn / Per
  NC = W16
  if NC < Cells then
    Cells = NC
    X = Cells + 4
    put char TBare at X,22
  end if
  goto study_loop

study_done:
  ' the Berzerkons go back in the bag
  play sound SndHide
  Rearm
  wait
  nmi off
  for Y = 3 to 19
    for X = 0 to 31
      put char TSand at X,Y
    next
  next
  ClearMsg
  for Qk = 0 to 3
    AskCount
    AskColour
  next
  ' the next player, the next round
  inc Up
  if Up < Pl then goto a_turn
  inc Rd
  if Rd < 5 then goto a_round

game_over:
  Ph = 5
  stop sound SndPlayA
  stop sound SndPlayB
  play sound SndOver
  set sprite 0 to 192,0,0,0
  update sprites
  Rearm
  wait
  nmi off
  for Y = 3 to 19
    for X = 0 to 31
      put char TSand at X,Y
    next
  next
  ClearMsg
  for X = 4 to 27
    put char 32 at X,22
  next
  Best = 0
  for K = 0 to 3
    if K < Pl then
      if Sc[K] > Best then Best = Sc[K]
    end if
  next
  if Pl = 1 then
    print at 6,8, "YOU SCORED"
    NumU = Sc[0]
    print at 17,8, digits$(NumU, 3)
    print at 21,8, "OF 400"
    if Sc[0] >= 300 then
      print at 6,11, "SHARP EYES, PARDNER!"
    else
      print at 6,11, "NOT BAD FOR A GREENHORN"
    end if
  else
    for K = 0 to 3
      if K < Pl then
        Y = K * 2
        Y = Y + 6
        print at 8,Y, "PLAYER"
        NumU = K + 1
        print at 15,Y, digits$(NumU, 1)
        NumU = Sc[K]
        print at 18,Y, digits$(NumU, 3)
        if Sc[K] = Best then
          print at 22,Y, "*"
        end if
      end if
    next
    ' how many share the best?
    W = 0
    for K = 0 to 3
      if K < Pl then
        if Sc[K] = Best then inc W
      end if
    next
    if W = 1 then
      for K = 0 to 3
        if K < Pl then
          if Sc[K] = Best then V = K + 1
        end if
      next
      print at 5,16, "PLAYER"
      NumU = V
      print at 12,16, digits$(NumU, 1)
      print at 14,16, "IS THE WINNER!"
    else
      print at 5,16, "A TIE! THE STARS WIN."
    end if
  end if
  print at 2,21, "PRESS A BUTTON"
  Rearm
  wait 60 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  Ph = 0
  goto title

' ---------------------------------------------------------------------------

' MakeMine: a new bag of Berzerkons: how many of each kind (1 to level +
' 3) and its colour (one of six)
sub MakeMine:
  W = Lv + 3
  for K = 0 to 3
mm_count:
    Rnd16
    V = Rs & 15
    if V >= W then goto mm_count
    Z[K] = V + 1
mm_col:
    Rnd16
    V = Rs >> 8
    V = V & 7
    if V >= 6 then goto mm_col
    Zc[K] = V
  next
  return
end sub

' DrawMine: the cave and the four rows of Berzerkons, each row centred
sub DrawMine:
  NewScreen
  for X = 0 to 31
    put char TRocktop at X,2
    put char TRock at X,20
  next
  for Y = 3 to 19
    for X = 0 to 31
      put char TSand at X,Y
    next
  next
  for K = 0 to 3
    By = K * 4
    By = By + 4
    Bx = 16 - Z[K]
    for J = 1 to 12
      if J <= Z[K] then
        Bk = K
        Bc = Zc[K]
        PutBz
        Bx = Bx + 2
      end if
    next
  next
  return
end sub

' PutBz: Berzerkon kind Bk in colour Bc (6 grey) at Bx,By (2 x 2 tiles)
sub PutBz:
  V = Bc << 4
  W = Bk << 2
  V = V + W
  V = V + TB0000
  put char V at Bx,By
  inc V
  X = Bx + 1
  put char V at X,By
  inc V
  Y = By + 1
  put char V at Bx,Y
  inc V
  put char V at X,Y
  return
end sub

' AskCount: HOW MANY of kind Qk? the pointer over 1 to 12
sub AskCount:
  Rearm
  wait
  nmi off
  ClearAsk
  Bk = Qk
  Bc = 6
  Bx = 15
  By = 6
  PutBz
  ClearMsg
  print at 2,21, "HOW MANY"
  KindName
  for J = 1 to 12
    X = PX[J]
    NumU = J
    if J < 10 then
      print at X,14, digits$(NumU, 1)
    else
      print at X,14, digits$(NumU, 2)
    end if
  next
  Pmax = 12
  Pv = 1
  Ph = 2
  PickLoop
  Good = 0
  if Ans = Z[Qk] then Good = 1
  Verdict
  if Good = 0 then
    print at 2,22, "NOPE. THERE WERE"
    NumU = Z[Qk]
    print at 19,22, digits$(NumU, 2)
  end if
  Pause1
  return
end sub

' AskColour: WHAT COLOR was kind Qk? the pointer over the six colours
sub AskColour:
  Rearm
  wait
  nmi off
  ClearAsk
  Bk = Qk
  Bc = 6
  Bx = 15
  By = 6
  PutBz
  ClearMsg
  print at 2,21, "WHAT COLOR WERE THE"
  for J = 0 to 5
    X = J * 4
    X = X + 5
    V = TSw0 + J
    put char V at X,14
    put char V at X,15
    W = X + 1
    put char V at W,14
    put char V at W,15
  next
  Pmax = 6
  Pv = 1
  Ph = 3
  KindName2
  PickLoop
  Good = 0
  V = Zc[Qk] + 1
  if Ans = V then Good = 1
  Verdict
  if Good = 0 then
    print at 2,22, "NOPE. THEY WERE"
    V = Zc[Qk]
    ColourName
  end if
  Pause1
  return
end sub

' ClearAsk: the sand under the question (rows 5-17)
sub ClearAsk:
  for Y = 5 to 17
    for X = 0 to 31
      put char TSand at X,Y
    next
  next
  return
end sub

sub ClearMsg:
  for X = 2 to 29
    put char 32 at X,21
    put char 32 at X,22
  next
  return
end sub

' KindName: the kind's name after "HOW MANY" (row 21, column 11)
sub KindName:
  if Qk = 0 then
    print at 11,21, "SPIKIES?"
  end if
  if Qk = 1 then
    print at 11,21, "ROUNDIES?"
  end if
  if Qk = 2 then
    print at 11,21, "BLOCKIES?"
  end if
  if Qk = 3 then
    print at 11,21, "TWISTIES?"
  end if
  return
end sub

' KindName2: the kind's name on the second line, after the colour question
sub KindName2:
  if Qk = 0 then
    print at 2,22, "SPIKIES?"
  end if
  if Qk = 1 then
    print at 2,22, "ROUNDIES?"
  end if
  if Qk = 2 then
    print at 2,22, "BLOCKIES?"
  end if
  if Qk = 3 then
    print at 2,22, "TWISTIES?"
  end if
  return
end sub

' ColourName: colour V written at column 18, row 22
sub ColourName:
  if V = 0 then
    print at 18,22, "BLACK"
  end if
  if V = 1 then
    print at 18,22, "WHITE"
  end if
  if V = 2 then
    print at 18,22, "RED"
  end if
  if V = 3 then
    print at 18,22, "PURPLE"
  end if
  if V = 4 then
    print at 18,22, "GREEN"
  end if
  if V = 5 then
    print at 18,22, "BLUE"
  end if
  return
end sub

' PickLoop: left and right move the pointer (1 to Pmax), a button answers
sub PickLoop:
  DrawPtr
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
  Hold = 0
pl_loop:
  Frame1
  ReadPad
  V = Lf1 | Rt1
  if V = 0 then Hold = 0
  if V = 1 then
    if Hold = 0 then
      Hold = 14
      MovePtr
    else
      dec Hold
      if Hold = 0 then
        Hold = 6
        MovePtr
      end if
    end if
  end if
  if Press = 0 then goto pl_loop
  Ans = Pv
  play sound SndPick
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub MovePtr:
  if Lf1 = 1 then
    if Pv > 1 then dec Pv
  end if
  if Rt1 = 1 then
    if Pv < Pmax then inc Pv
  end if
  play sound SndMove
  DrawPtr
  return
end sub

' DrawPtr: the pointer over the number (row 14) or the colour (rows 14-15)
sub DrawPtr:
  if Ph = 2 then
    X = PX[Pv]
    W16 = X
    W16 = W16 * 8
    if Pv >= 10 then W16 = W16 + 4
    W16 = W16 - 4
    X = W16
  else
    X = Pv - 1
    X = X * 4
    X = X + 5
    W16 = X
    W16 = W16 * 8
    X = W16
  end if
  set sprite 0 to 94,X,SPtr,11
  update sprites
  return
end sub

' Verdict: right or wrong, the sound, the score
sub Verdict:
  Ph = 4
  ClearMsg
  if Good = 1 then
    Sc[Up] = Sc[Up] + 10
    play sound SndRight
    print at 2,21, "RIGHT AS RAIN, PARDNER!"
  else
    play sound SndWrong
    print at 2,21, "SHUCKS!"
  end if
  ShowHud
  return
end sub

sub Pause1:
  for J = 1 to 75
    Frame1
  next
  return
end sub

' ShowHud: row 1: the player, the round, the score
sub ShowHud:
  print at 2,1, "PLAYER"
  NumU = Up + 1
  print at 9,1, digits$(NumU, 1)
  print at 12,1, "ROUND"
  NumU = Rd + 1
  print at 18,1, digits$(NumU, 1)
  print at 21,1, "SCORE"
  NumU = Sc[Up]
  print at 27,1, digits$(NumU, 3)
  return
end sub

sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  return
end sub

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

' one frame: let the NMI run during the wait, then keep it off
sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' ReadPad: both controllers' sticks and left buttons
sub ReadPad:
  Lf1 = 0
  Rt1 = 0
  Up1 = 0
  Dn1 = 0
  Btn = 0
  if joypad(1).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(1).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(1).button1 then Btn = 1
  if joypad(1).button2 then Btn = 1
  if joypad(2).left then Lf1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(2).button1 then Btn = 1
  if joypad(2).button2 then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

' ReadAll: as ReadPad, a push of the stick counted once (menus)
sub ReadAll:
  ReadPad
  V = Lf1 | Rt1
  V = V | Up1
  V = V | Dn1
  if V = 1 then
    if WasStick = 1 then
      Lf1 = 0
      Rt1 = 0
      Up1 = 0
      Dn1 = 0
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 1024
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the mine, a row of Berzerkons, the options
sub TitlePage:
  Ph = 0
  NewScreen
  for X = 0 to 31
    put char TRocktop at X,2
    put char TRock at X,9
  next
  for Y = 3 to 8
    for X = 0 to 31
      put char TSand at X,Y
    next
  next
  print at 10,4, "GOT A MATCH?"
  for K = 0 to 5
    Bk = K & 3
    Bc = K
    Bx = K * 4
    Bx = Bx + 5
    By = 6
    PutBz
  next
  print at 3,11, "STUDY THE BERZERKONS, THEN"
  print at 3,12, "SAY HOW MANY AND WHAT COLOR"
  print at 9,14, "PLAYERS"
  print at 9,15, "LEVEL"
  print at 9,16, "START"
  print at 9,17, "CREDITS"
  print at 3,20, "LEFT, RIGHT: CHANGE"
  Mi = 2
  ShowOptions
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
tp_loop:
  Frame1
  ReadAll
  Rnd16
  if Up1 = 1 then
    if Mi > 0 then
      dec Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  if Dn1 = 1 then
    if Mi < 3 then
      inc Mi
      play sound SndMove
      ShowOptions
    end if
  end if
  V = Lf1 | Rt1
  if V = 1 then
    if Mi = 0 then
      if Rt1 = 1 then inc Pl
      if Lf1 = 1 then dec Pl
      if Pl = 0 then Pl = 4
      if Pl > 4 then Pl = 1
    end if
    if Mi = 1 then
      if Rt1 = 1 then inc Lv
      if Lf1 = 1 then dec Lv
      if Lv = 0 then Lv = 9
      if Lv > 9 then Lv = 1
    end if
    play sound SndMove
    ShowOptions
  end if
  if Press = 0 then goto tp_loop
  if Mi < 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  if Mi = 3 then CreditsPage
  return
end sub

sub ShowOptions:
  for J = 14 to 17
    put char 32 at 7,J
  next
  V = Mi + 14
  put char 62 at 7,V
  NumU = Pl
  print at 18,14, digits$(NumU, 1)
  NumU = Lv
  print at 18,15, digits$(NumU, 1)
  return
end sub

sub CreditsPage:
  NewScreen
  for X = 0 to 31
    put char TRock at X,2
    put char TRock at X,21
  next
  print at 10,4, "GOT A MATCH?"
  print at 3,6, "BASED ON GOT A MATCH? BY"
  print at 3,7, "WALTER E. MEYERS, AHOY!"
  print at 3,8, "JUNE 1986 (COMMODORE 64)."
  print at 3,10, "MADE FOR THE COLECOVISION"
  print at 3,11, "BY CLAUDE (AN AI MADE BY"
  print at 3,12, "ANTHROPIC) FOR AMY STUDIO,"
  print at 3,13, "2026, IN AMY BY AMY BIENVENU."
  print at 3,15, "MUSIC: JEWEL RUSH (ORIGINAL)"
  print at 3,16, "CLEMENTINE (TRADITIONAL)"
  print at 8,19, "PRESS A BUTTON"
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 448
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasBtn = 1
cr_loop:
  Frame1
  ReadAll
  if Press = 0 then goto cr_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  return
end sub

