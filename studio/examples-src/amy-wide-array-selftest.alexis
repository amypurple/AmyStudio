project "AMY WIDE ARRAY SELFTEST"

u32 Scores[4] = 100000
i32 Deltas[3] = -100
u8 Player = 1
u32 Result = 0
i32 SignedResult = 0

text screen
backdrop dark blue
print centered at 5, "U32 I32 ARRAYS"

Scores[Player] = Scores[0] + 50000
Deltas[Player + 1] = Deltas[0] - 5
Result = Scores[Player]
SignedResult = Deltas[Player + 1]

if Result = 150000 and SignedResult = -105 then
  print centered at 10, "PASS"
else
  print centered at 10, "FAIL"
end if

screen on
loop forever
