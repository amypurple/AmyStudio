record CellRec:
  u8 Door
  u8 Item
end record

CellRec Cells[9]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 NumV = 0
u16 Best = 0
u16 Total = 0
i16 Dx = 0
i16 Dy = 0
bcd digits 2 Catches = 0
' the player: X, Y, mode (0 path, 1 walking in, 2 in a cell, 3 walking
' out), frames of walk left, the cell, the walk animation counter
u8 PX = 0
u8 PY = 0
u8 PM = 0
u8 PW = 0
u8 PC = 0
u8 PAn = 0
' the guard: X, Y, the crossing he walks to (column, row, pixels), speed in
' quarter pixels a frame, the fraction
u8 GX = 0
u8 GY = 0
u8 GI = 0
u8 GJ = 0
u8 GTx = 0
u8 GTy = 0
u8 GSpd = 2
u8 GF = 0
u8 Gn = 0
u8 Ev = 0
u8 Won = 0
u8 Freeze = 0
u8 DoorT = 0
u8 TFr = 0
u8 TSec = 0
u8 TMin = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
' title animation
u8 TbX = 0
' loop counters (never shared with the helpers)
u8 Dc = 0
u8 Ds = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Ok = 0

  tile screen
  set sound table JbSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Won = 0 then goto play_loop

  ' free: the sentence, the time, the best time, then the title on a press
  mute all
  play sound SndFree
  Total = TMin * 60
  Total = Total + TSec
  if Best = 0 then Best = Total
  if Total < Best then Best = Total
  for Dc = 10 to 15
    fill 32 count 24 at 4,Dc
  next
  print at 7,10, "YOU ARE FREE!"
  print at 6,12, "TIME  "
  PrintTime(Total, 12, 12)
  print at 6,13, "BEST  "
  PrintTime(Best, 12, 13)
  print at 6,14, "CAUGHT ", Catches, " TIMES"
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play: the clock always, then (unless the capture pause runs)
' the player, the guard, the capture test and the doors
sub PlayStep:
  TickClock
  if Freeze > 0 then
    dec Freeze
    return
  end if
  MovePlayer
  if Won = 1 then return
  MoveGuard
  Collide
  Doors
  return
end sub

sub TickClock:
  inc TFr
  if TFr < 60 then return
  TFr = 0
  if TMin = 99 then
    if TSec = 59 then return
  end if
  inc TSec
  if TSec = 60 then
    TSec = 0
    inc TMin
  end if
  ShowTime
  return
end sub

' the lane index + 1 of a coordinate, 0 when it is not on a lane
function LaneAtX(u8 Pv) as u8
  u8 Li = 0
  for Li = 0 to 3
    if LaneX[Li] = Pv then return Li + 1
  next
  return 0

function LaneAtY(u8 Pv) as u8
  u8 Li = 0
  for Li = 0 to 3
    if LaneY[Li] = Pv then return Li + 1
  next
  return 0

' the door row index + 1 (cell row), 0 when not on a door row
function DoorRow(u8 Pv) as u8
  u8 Li = 0
  for Li = 0 to 2
    if LaneY[Li] + 24 = Pv then return Li + 1
  next
  return 0

' 2 pixels toward the nearest lane coordinate within 10, 0 if none
function Nudge(u8 Pv, u8 Axis) as u8
  u8 Li = 0
  u8 Lv = 0
  i16 Dd = 0
  for Li = 0 to 3
    if Axis = 0 then
      Lv = LaneX[Li]
    else
      Lv = LaneY[Li]
    end if
    Dd = Lv - Pv
    if Dd > 0 then
      if Dd <= 10 then return Pv + 2
    end if
    if Dd < 0 then
      if Dd >= -10 then return Pv - 2
    end if
  next
  return Pv

sub MovePlayer:
  u8 Lx = 0
  u8 Ly = 0
  u8 Dr = 0
  u8 Vs = 0
  u8 Hs = 0
  u8 Moved = 0
  Vs = J1 & 3
  Hs = J1 & 12
  select case PM
    case 1
      PX = PX + 2
      inc PAn
      dec PW
      if PW = 0 then
        PM = 2
        Arrive
      end if
      return
    case 3
      PX = PX - 2
      inc PAn
      dec PW
      if PW = 0 then PM = 0
      return
    case 2
      if Hs = 4 then
        if Cells[PC].Door = 1 then
          PM = 3
          PW = WalkN
        end if
      end if
      return
  end select
  ' on the paths
  Lx = LaneAtX(PX)
  Ly = LaneAtY(PY)
  if Vs > 0 then
    if Lx > 0 then
      if Vs = 1 then
        if PY > 24 then
          PY = PY - 2
          Moved = 1
        end if
      else
        if PY < 168 then
          PY = PY + 2
          Moved = 1
        end if
      end if
    end if
  end if
  if Moved = 0 then
    if Hs > 0 then
      if Ly > 0 then
        if Hs = 4 then
          if PX > 24 then
            PX = PX - 2
            Moved = 1
          end if
        else
          if PX < 216 then
            PX = PX + 2
            Moved = 1
          end if
        end if
      else
        Dr = DoorRow(PY)
        if Dr > 0 then
          if Hs = 8 then
            if Lx > 0 then
              if Lx < 4 then
                C = (Dr - 1) * 3 + Lx - 1
                if Cells[C].Door = 1 then
                  PC = C
                  PM = 1
                  PW = WalkN
                end if
              end if
            end if
          end if
        end if
      end if
    end if
  end if
  ' corner help: slide onto a lane near by
  if Moved = 0 then
    if Vs > 0 then
      if Lx = 0 then
        if Ly > 0 then
          V = Nudge(PX, 0)
          if V <> PX then
            PX = V
            Moved = 1
          end if
        end if
      end if
    end if
  end if
  if Moved = 0 then
    if Hs > 0 then
      if Ly = 0 then
        if Lx > 0 then
          if DoorRow(PY) = 0 then
            V = Nudge(PY, 1)
            if V <> PY then
              PY = V
              Moved = 1
            end if
          end if
        end if
      end if
    end if
  end if
  if Moved = 1 then inc PAn
  return
end sub

' the player has walked into cell PC
sub Arrive:
  select case Cells[PC].Item
    case 1
      Cells[PC].Item = 0
      inc Ev
      DrawItem(PC)
      ShowWord(Ev)
      ShowCount
      play sound SndFile
    case 2
      if Ev = 7 then
        Won = 1
      else
        play sound SndNope
      end if
  end select
  return
end sub

' the guard: speed in quarter pixels, a pixel at a time
sub MoveGuard:
  GF = GF + GSpd
  Gn = GF >> 2
  GF = GF & 3
  while Gn > 0
    GuardPixel
    dec Gn
  end while
  return
end sub

sub GuardPixel:
  if GX = GTx then
    if GY = GTy then PickDir
  end if
  if GX < GTx then inc GX
  if GX > GTx then dec GX
  if GY < GTy then inc GY
  if GY > GTy then dec GY
  return
end sub

' any of the four ways at random, again until it stays on the grid
sub PickDir:
  Ok = 0
  while Ok = 0
    Rand
    K = Rs & 3
    Ok = TryDir(K)
  end while
  GTx = LaneX[GI]
  GTy = LaneY[GJ]
  return
end sub

function TryDir(u8 D) as u8
  select case D
    case 0
      if GJ = 0 then return 0
      dec GJ
    case 1
      if GI = 3 then return 0
      inc GI
    case 2
      if GJ = 3 then return 0
      inc GJ
    case else
      if GI = 0 then return 0
      dec GI
  end select
  return 1

sub Collide:
  if PM = 2 then return
  Dx = PX - GX
  Dy = PY - GY
  if Dx >= 12 then return
  if Dx <= -12 then return
  if Dy >= 12 then return
  if Dy <= -12 then return
  ' caught: back to the middle cell, the guard faster, every door shut
  play sound SndSiren
  if Catches < 99 then inc Catches
  if GSpd < 8 then GSpd = GSpd + 2
  PM = 2
  PC = 4
  PX = LaneX[1] + 24
  PY = LaneY[1] + 24
  CloseAll
  Freeze = FreezeN
  return
end sub

' doors: every 256 passes 1 chance in 32 that all slam; each pass 1 in 64
' that a door (0-15, only 0-8 exist) opens
sub Doors:
  inc DoorT
  Rand
  if DoorT = 0 then
    V = Rs & 31
    if V = 0 then
      CloseAll
      return
    end if
  end if
  V = Rs & 63
  if V > 0 then return
  W16 = Rs >> 8
  K = W16 & 15
  if K < 9 then
    if Cells[K].Door = 0 then
      Cells[K].Door = 1
      DrawDoor(K)
      play sound SndOpen
    end if
  end if
  return
end sub

sub CloseAll:
  for Dc = 0 to 8
    Cells[Dc].Door = 0
    DrawDoor(Dc)
  next
  play sound SndSlam
  play sound SndClank
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing
function CellCol(u8 Cn) as u8
  return (Cn mod 3) * 8 + 5

function CellRow(u8 Cn) as u8
  return (Cn / 3) * 6 + 6

sub DrawDoor(u8 Cn):
  X = CellCol(Cn)
  Y = CellRow(Cn)
  if Cells[Cn].Door = 1 then
    put char TDoT at X,Y
    put char TDoB at X,Y + 1
  else
    put char TDcT at X,Y
    put char TDcB at X,Y + 1
  end if
  return
end sub

sub DrawItem(u8 Cn):
  X = CellCol(Cn) + 3
  Y = CellRow(Cn)
  select case Cells[Cn].Item
    case 1
      put char TFile00 at X,Y
      put char TFile01 at X + 1,Y
      put char TFile10 at X,Y + 1
      put char TFile11 at X + 1,Y + 1
    case 2
      put char TLaw00 at X,Y
      put char TLaw01 at X + 1,Y
      put char TLaw10 at X,Y + 1
      put char TLaw11 at X + 1,Y + 1
    case else
      fill TFloor count 2 at X,Y
      fill TFloor count 2 at X,Y + 1
  end select
  return
end sub

' the words of the sentence, one for each file
sub ShowWord(u8 Wn):
  select case Wn
    case 1
      print at 2,1, "YOU"
    case 2
      print at 6,1, "HAVE"
    case 3
      print at 11,1, "THE"
    case 4
      print at 15,1, "EVIDENCE"
    case 5
      print at 2,2, "TO"
    case 6
      print at 5,2, "CLEAR"
    case 7
      print at 11,2, "YOURSELF!"
  end select
  return
end sub

sub ShowCount:
  NumU = Ev
  print at 25,2, digits$(NumU, 1), "/7"
  return
end sub

sub ShowTime:
  NumU = TMin
  NumV = TSec
  print at 25,1, digits$(NumU, 2), ":", digits$(NumV, 2)
  return
end sub

' seconds as mm:ss at a place
sub PrintTime(u16 Secs, u8 Col, u8 Row):
  NumU = Secs / 60
  NumV = Secs mod 60
  print at Col,Row, digits$(NumU, 2), ":", digits$(NumV, 2)
  return
end sub

' sprites 0-1 the prisoner (stripes, suit), 2-3 the guard (face, uniform)
sub DrawSprites:
  K = PAn >> 2
  K = K & 1
  K = K * 8
  Y = PY - 1
  if Freeze > 0 then
    V = Freeze / 15
    V = V & 1
    if V = 1 then Y = 192
  end if
  set sprite 0 to Y,PX,SPd0 + K,1
  set sprite 1 to Y,PX,SPb0 + K,15
  K = GX + GY
  K = K >> 3
  K = K & 1
  K = K * 8
  set sprite 2 to GY - 1,GX,SGd0 + K,9
  set sprite 3 to GY - 1,GX,SGb0 + K,4
  update sprites
  return
end sub

sub NewGame:
  NewScreen
  copy YardMap count 768 to vram.name
  for Dc = 0 to 8
    Cells[Dc].Door = 0
    Cells[Dc].Item = 1
  next
  Cells[4].Item = 0
  Cells[4].Door = 1
  Cells[8].Item = 2
  for Dc = 0 to 8
    DrawDoor(Dc)
    DrawItem(Dc)
  next
  put char TClock at 23,1
  put char TFicon at 23,2
  Ev = 0
  TFr = 0
  TSec = 0
  TMin = 0
  ShowTime
  ShowCount
  PM = 2
  PC = 4
  PX = LaneX[1] + 24
  PY = LaneY[1] + 24
  PW = 0
  PAn = 0
  GI = 2
  GJ = 2
  GX = LaneX[2]
  GY = LaneY[2]
  GTx = GX
  GTy = GY
  GSpd = 2
  GF = 0
  Won = 0
  Freeze = 0
  DoorT = 0
  Catches = 0
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  ' up and down together, or left and right, count as neither
  V = J1 & 3
  if V = 3 then J1 = J1 & 252
  V = J1 & 12
  if V = 12 then J1 = J1 & 243
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: JAIL BREAK in brick letters behind bars, the guard chasing the
' prisoner along the bottom, START / CREDITS, the best time, the tune once
sub TitlePage:
  NewScreen
  print at 6,1, "AHOY! FEBRUARY 1987"
  copy TitleMap count 384 to vram.name + 96
  print at 8,16, "BY BOB BLACKMER"
  print at 13,18, "START"
  print at 13,19, "CREDITS"
  if Best > 0 then
    print at 10,21, "BEST"
    PrintTime(Best, 15, 21)
  end if
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  TbX = 16
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  TitleAnim
  V = J1 & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

' the prisoner runs right along the bottom, the guard 40 pixels behind
sub TitleAnim:
  V = Tick & 1
  if V = 0 then
    inc TbX
    if TbX > 230 then TbX = 16
  end if
  K = TbX >> 2
  K = K & 1
  K = K * 8
  if TbX < 200 then
    set sprite 0 to 175,TbX + 24,SPd0 + K,1
    set sprite 1 to 175,TbX + 24,SPb0 + K,15
  else
    set sprite 0 to 192,0,0,0
    set sprite 1 to 192,0,0,0
  end if
  if TbX > 16 then
    set sprite 2 to 175,TbX - 16,SGd0 + K,9
    set sprite 3 to 175,TbX - 16,SGb0 + K,4
  else
    set sprite 2 to 192,0,0,0
    set sprite 3 to 192,0,0,0
  end if
  update sprites
  return
end sub

sub ShowMenu:
  put char 32 at 11,18
  put char 32 at 11,19
  J = Menu + 18
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 11,2, "JAILBREAK"
  print at 2,5, "BASED ON JAILBREAK BY BOB"
  print at 2,6, "BLACKMER, AHOY! FEBRUARY"
  print at 2,7, "1987 (COMMODORE 64 MACHINE"
  print at 2,8, "LANGUAGE)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: LIGHTS OUT"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

