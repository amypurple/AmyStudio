' Runtime regression for the indexed arithmetic used by Horse Racing payoffs.
' Expected: odds 5,20,8,2,8; cash 2500,450,1100; direct product 2000.
u8 PlayerCount = 3
u16 Cash[3]
u8 Bet[3]
u16 Amount[3]
u16 Pool[5]
u8 Odds[5]
u8 Winner = 2
u8 I = 0
u8 J = 0
u8 Pick = 0
u16 PoolTotal = 0
u16 Temp = 0
u16 Work = 0
u16 DirectProduct = 0
u8 Done = 0

Pool[0] = 400
Pool[1] = 100
Pool[2] = 250
Pool[3] = 1000
Pool[4] = 250

for I = 0 to 4
  PoolTotal += Pool[I]
next

for I = 0 to 4
  Temp = Pool[I]
  Work = PoolTotal / Temp
  if Work > 20 then Work = 20
  if Work < 1 then Work = 1
  Odds[I] = Work
next

Cash[0] = 500
Cash[1] = 500
Cash[2] = 500
Bet[0] = 2
Amount[0] = 100
Bet[1] = 1
Amount[1] = 50
Bet[2] = 2
Amount[2] = 30

Temp = Odds[1]
Temp *= Amount[0]
DirectProduct = Temp

for J = 0 to PlayerCount - 1
  Pick = Bet[J]
  if Pick > 0 then
    if Pick = Winner then
      I = Winner - 1
      Temp = Odds[I]
      Temp *= Amount[J]
      Work = Cash[J]
      if Work < 60000 then Work += Temp
      Cash[J] = Work
    else
      Cash[J] -= Amount[J]
    end if
  end if
next

Done = 1
loop forever
