' CVBASIC controller test port
u8 CurrentKey = 255

u8 KeySpriteX = 0
u8 KeySpriteY = 0
u8 PanelX = 0
u8 PanelY = 0

data HighlightSprites bytes
  $18,$3C,$7E,$FF,$FF,$7E,$3C,$18
  $00,$3C,$7E,$FF,$FF,$7E,$3C,$00
  $FF,$81,$81,$81,$81,$81,$81,$FF
end data

  text screen
  sprites 8x8
  sprites simple
  copy HighlightSprites to vram.spr_pat
  clear sprites
  set sprite count 14
  print centered at 5, "CVBASIC PORT"
  print centered at 8, "DUAL CONTROLLERS"
  print centered at 9, "LIVE KEYPAD TEST"
  print centered at 14, "PRESS FIRE"
  screen on
  pause until press
  wait no fire
  cls
  print at 4,1, "CVBASIC CONTROLLER TEST"
  draw_panels
main_loop:
  wait

  if joypad(1).up then
    set sprite 0 to 39,40,0,9
  else
    set sprite 0 to 209,0,0,0
  end if
  if joypad(1).left then
    set sprite 1 to 47,16,0,9
  else
    set sprite 1 to 209,0,0,0
  end if
  if joypad(1).right then
    set sprite 2 to 47,64,0,9
  else
    set sprite 2 to 209,0,0,0
  end if
  if joypad(1).down then
    set sprite 3 to 55,40,0,9
  else
    set sprite 3 to 209,0,0,0
  end if
  if joypad(1).button1 then
    set sprite 4 to 63,24,1,9
  else
    set sprite 4 to 209,0,0,0
  end if
  if joypad(1).button2 then
    set sprite 5 to 63,56,1,9
  else
    set sprite 5 to 209,0,0,0
  end if
  if keypad(1) = 255 then
    set sprite 6 to 209,0,0,0
  else
    CurrentKey = keypad(1)
    PanelX = 16
    PanelY = 40
    place_key_highlight
    set sprite 6 to KeySpriteY,KeySpriteX,2,9
  end if

  if joypad(2).up then
    set sprite 7 to 39,176,0,9
  else
    set sprite 7 to 209,0,0,0
  end if
  if joypad(2).left then
    set sprite 8 to 47,152,0,9
  else
    set sprite 8 to 209,0,0,0
  end if
  if joypad(2).right then
    set sprite 9 to 47,200,0,9
  else
    set sprite 9 to 209,0,0,0
  end if
  if joypad(2).down then
    set sprite 10 to 55,176,0,9
  else
    set sprite 10 to 209,0,0,0
  end if
  if joypad(2).button1 then
    set sprite 11 to 63,160,1,9
  else
    set sprite 11 to 209,0,0,0
  end if
  if joypad(2).button2 then
    set sprite 12 to 63,192,1,9
  else
    set sprite 12 to 209,0,0,0
  end if
  if keypad(2) = 255 then
    set sprite 13 to 209,0,0,0
  else
    CurrentKey = keypad(2)
    PanelX = 152
    PanelY = 40
    place_key_highlight
    set sprite 13 to KeySpriteY,KeySpriteX,2,9
  end if

  update sprites
  goto main_loop

sub draw_panels:
  print at 4,3, "P1"
  print at 21,3, "P2"
  print at 2,5, "   ^   "
  print at 2,6, "<     >"
  print at 2,7, "   v   "
  print at 2,8, " L   R "
  print at 2,9, " 1 2 3 "
  print at 2,10, " 4 5 6 "
  print at 2,11, " 7 8 9 "
  print at 2,12, " * 0 # "
  print at 2,13, " B   P "
  print at 19,5, "   ^   "
  print at 19,6, "<     >"
  print at 19,7, "   v   "
  print at 19,8, " L   R "
  print at 19,9, " 1 2 3 "
  print at 19,10, " 4 5 6 "
  print at 19,11, " 7 8 9 "
  print at 19,12, " * 0 # "
  print at 19,13, " B   P "
  return

sub place_key_highlight:
  select case CurrentKey
  case 1
    KeySpriteX = PanelX + 8
    KeySpriteY = PanelY + 31
  case 2
    KeySpriteX = PanelX + 24
    KeySpriteY = PanelY + 31
  case 3
    KeySpriteX = PanelX + 40
    KeySpriteY = PanelY + 31
  case 4
    KeySpriteX = PanelX + 8
    KeySpriteY = PanelY + 39
  case 5
    KeySpriteX = PanelX + 24
    KeySpriteY = PanelY + 39
  case 6
    KeySpriteX = PanelX + 40
    KeySpriteY = PanelY + 39
  case 7
    KeySpriteX = PanelX + 8
    KeySpriteY = PanelY + 47
  case 8
    KeySpriteX = PanelX + 24
    KeySpriteY = PanelY + 47
  case 9
    KeySpriteX = PanelX + 40
    KeySpriteY = PanelY + 47
  case 10
    KeySpriteX = PanelX + 8
    KeySpriteY = PanelY + 55
  case 0
    KeySpriteX = PanelX + 24
    KeySpriteY = PanelY + 55
  case 11
    KeySpriteX = PanelX + 40
    KeySpriteY = PanelY + 55
  case 12
    KeySpriteX = PanelX + 8
    KeySpriteY = PanelY + 63
  case 13
    KeySpriteX = PanelX + 40
    KeySpriteY = PanelY + 63
  case else
    KeySpriteX = 0
    KeySpriteY = 209
  end select
  return