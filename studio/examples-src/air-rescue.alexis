cartridge "AIR RESCUE/AHOY! APRIL 1986/1986"

' AIR RESCUE
' A ColecoVision game based on "Air Rescue", Ahoy! April 1986 (Commodore
' 64 machine code with a one-line BASIC loader; the author is not named on
' the magazine's disk). Made for Amy Studio by Claude (an AI made by
' Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a cell-for-cell port: the rules are the original's (read from its
' machine code, orig/ar.dis), the game is built for the ColecoVision: a
' night city that scrolls a pixel a frame (city.py: every screen cell is a
' pair of city tiles, its pattern for the current shift copied each frame
' by ArCity), smooth 16 x 16 sprites, a two-sprite helicopter, sound.
'
' The game: fly the rescue helicopter over a burning city. A man waves on
' top of the tall tower each time it comes round. Settle onto him from
' above (your skids on his raised hands) to lift him off, or put out the
' fire first with a bomb, and then any touch lifts him. Five men end a
' mission. Planes come from the right: shoot them with bombs (each one
' flies straight ahead and dips as you dive); the red one always comes in
' at your height and, once in a while, fires a fast missile. The fuel runs
' down while you fly; a fuel drop drifts across the top of the sky on its
' parachute: touch it to fill up. Touching a plane, the missile, a
' building or the man in the flames costs a helicopter.
'
' From the original (orig/, its machine code): the city loop of 40
' columns scrolling a pixel a frame; the man on the tower top, flames, the
' rescue only by touching him from above (C64: exactly at Y 130) unless a
' bomb has put out the fire (75 points; the fire's colour changes); 200 a
' man, five men a mission, 500 a mission, 20 bombs again each mission and
' each helicopter; a bomb flies forward 2 pixels a frame, follows your
' dives at twice your speed and ends three quarters of the way across;
' plane A at a random height, 25 points, plane B at your height, 50; their
' speeds (mission + 2 and mission + 3 pixels a frame) and the hidden part of
' their 512-pixel round; the fuel drop moving a pixel every five frames at
' the top of the sky, a full tank on touching it (it stays); after it has
' crossed, plane B fires one missile (15 pixels a frame) as it passes
' three quarters of the screen, then a new fuel drop; fuel down one step
' every 20 frames of movement, 48 steps; three helicopters, one more on
' reaching mission 7; a high score.
'
' Liberties: diagonal flying (the C64 reads only the four straight
' directions); an empty tank makes the helicopter sink to a crash (on the
' C64 it hung in the air, frozen, until a plane hit it); a bomb on the man
' scores only while the fire burns (the C64 paid 75 for every hit); a shot
' plane B no longer fires its missile from where it would have been; the
' screen does not freeze while a plane explodes; speeds scaled to the
' smaller, faster screen (sixteenths of a pixel); plane speeds stop
' growing after mission 11; the rescue height has three rows of slack.
'
' Controls: controller 1 (or 2). The stick flies, either button fires a
' bomb (hold it to fire again as soon as the last one is gone). On the
' title, up and down choose START or CREDITS, a button chooses.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given (bug
' 25). Own xorshift random numbers (bug 36). Nothing flashes.

const TStar1 = 128
const TStar2 = 129
const TStar3 = 130
const TMoon00 = 131
const TMoon01 = 132
const TMoon10 = 133
const TMoon11 = 134
const TIhel = 135
const TIbomb = 136
const TIman = 137
const TBar = 138
const TBarb = 139
const TLga00 = 140
const TLga01 = 141
const TLga10 = 142
const TLga11 = 143
const TLgi00 = 144
const TLgi01 = 145
const TLgi10 = 146
const TLgi11 = 147
const TLgr00 = 148
const TLgr01 = 149
const TLgr10 = 150
const TLgr11 = 151
const TLge00 = 152
const TLge01 = 153
const TLge10 = 154
const TLge11 = 155
const TLgs00 = 156
const TLgs01 = 157
const TLgs10 = 158
const TLgs11 = 159
const TLgc00 = 160
const TLgc01 = 161
const TLgc10 = 162
const TLgc11 = 163
const TLgu00 = 164
const TLgu01 = 165
const TLgu10 = 166
const TLgu11 = 167
const SHl1 = 0
const SHr1 = 4
const SHl2 = 8
const SHr2 = 12
const SXl1 = 16
const SXr1 = 20
const SXl2 = 24
const SXr2 = 28
const SBomb = 32
const SPlane1 = 36
const SPlane2 = 40
const SMissile = 44
const SCanopy = 48
const SCrate = 52
const SMan1 = 56
const SMan2 = 60
const SFire1 = 64
const SFire2 = 68
const SSmoke1 = 72
const SSmoke2 = 76
const SBoom1 = 80
const SBoom2 = 84
const NTiles8 = 320
const SprBytes = 704
const NPair = 90
const NPair8 = 720
const TGauge = 218
const TowerPx = 88
const SndTuneA = 1
const SndTuneB = 2
const SndBomb = 3
const SndBoom = 4
const SndDouse = 5
const SndRescue = 6
const SndMission = 7
const SndFuel = 8
const SndMissile = 9
const SndCrash = 10
const SndLow = 11
const SndExtra = 12
const SndStart = 13
const SndEnd = 14
const HXMin = 5
const HXMax = 168
const HYMin = 26
const HYMax = 168
const BombEnd = 222
const ManTop = 117

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 A16 = 0
u16 NumU = 0
u16 Score = 0
u16 Hi = 0
u16 Sc = 0
u8 CityAll = 1
u16 W320 = 320
u16 W288 = 288
u16 W32 = 32
u16 W16b = 16
' the helicopter
u8 Hx = 0
u8 Hy = 0
u8 Fuel = 48
u8 FuelT = 0
u8 Rot = 0
u8 Ships = 3
u8 Men = 0
u8 Mission = 1
u8 Bombs = 20
u8 Dead = 0
u8 Over = 0
' the bomb
u8 BmOn = 0
u16 BmT = 0
u8 BmF = 0
u8 BmY = 0
' the planes (0 random height, 1 your height): track, sixteenths, height,
' alive, colour; speeds
u16 Pt[2]
u8 Pf[2]
u8 Py[2]
u8 Pa[2]
u8 Pc = 9
u8 Spd[2]
u16 OldB = 0
' the fuel drop and the missile: mode 0 drop, 1 waiting, 2 missile
u8 Mode = 0
u16 Ct = 0
u8 Cf = 0
u8 Cb = 0
u8 Cy = 26
u16 Mt = 0
u8 Mf = 0
u8 My = 0
' the man on the tower
u16 Wt = 0
u8 Burn = 1
u8 There = 1
' explosions of planes
u8 Bt[2]
u16 Bx[2]
u8 By[2]
' screen
u8 HudDirty = 1
u8 OldFuel = 255
u8 Banner = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Jin = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' collision boxes
u16 Ax1 = 0
u16 Ax2 = 0
u16 Bx1 = 0
u16 Bx2 = 0
u8 Ay1 = 0
u8 Ay2 = 0
u8 By1 = 0
u8 By2 = 0
u8 Hit = 0
' sprite placing
u8 Snum = 0
u16 Strk = 0
u8 Srow = 0
u8 Spat = 0
u8 Scol = 0
' loop counters (never shared with the helpers)
u8 Pi = 0
u8 Li = 0
' scratch
u8 B = 0
u8 C = 0
u8 D = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 R = 0
u8 T = 0
u8 U = 0
u8 V = 0
u8 X = 0
u8 Y = 0

data Bob bytes
  0,1,2,3,4,5,6,6,6,5,4,3,2,1,0,0
end data
data PlCol bytes
  9,11,3,7,13,5,15,10
end data

  tile screen
  call asm ArR3
  set sound table ArSoundTable areas 6
  sprites 16x16
  set sprite count 12
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 1 then goto title

new_game:
  NewGame

play_loop:
  Frame1
  call asm ArCity
  update sprites
  ReadPad
  PlayStep
  DrawSprites
  ShowHud
  if Over = 0 then goto play_loop

  ' the end: GAME OVER, the score and the best, then back to the title on
  ' a press
  Frame1
  update sprites
  HideSprites
  print at 9,6, "            "
  print at 8,7, "              "
  print at 8,8, "  GAME  OVER  "
  print at 8,9, "              "
  print at 8,10, " SCORE        "
  NumU = Score
  print at 16,10, digits$(NumU, 5)
  print at 8,11, " BEST         "
  NumU = Hi
  print at 16,11, digits$(NumU, 5)
  print at 8,12, "              "
  mute all
  play sound SndEnd
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  Jin = J1 | J2
  if Dead > 0 then
    dec Dead
    if Dead = 0 then
      dec Ships
      HudDirty = 1
      if Ships = 0 then
        Over = 1
      else
        NewLife
      end if
    end if
    return
  end if
  inc Sc
  if Sc >= W320 then Sc = 0
  inc Rot
  MoveHeli
  MoveBomb
  OldB = Pt[1]
  for Pi = 0 to 1
    MovePlane
  next
  MoveDrop
  ' the man: a new one, and the fire lit again, each time round
  W16 = TowerPx + 352
  W16 = W16 - Sc
  if W16 >= W320 then W16 = W16 - 320
  if W16 >= W320 then W16 = W16 - 320
  Wt = W16
  if Wt = 300 then
    Burn = 1
    There = 1
  end if
  for Pi = 0 to 1
    if Bt[Pi] > 0 then dec Bt[Pi]
  next
  if Banner > 0 then
    dec Banner
    if Banner = 0 then print at 9,6, "            "
  end if
  BombHits
  HeliHits
  return
end sub

' the stick moves the helicopter a pixel a frame (diagonals too); each
' frame of movement uses fuel (a step every 24); an empty tank sinks it
sub MoveHeli:
  if Fuel = 0 then
    inc Hy
    return
  end if
  K = 0
  V = Jin & 4
  if V > 0 then
    if Hx > HXMin then
      dec Hx
      K = 1
    end if
  end if
  V = Jin & 8
  if V > 0 then
    if Hx < HXMax then
      inc Hx
      K = 1
    end if
  end if
  V = Jin & 1
  if V > 0 then
    if Hy > HYMin then
      dec Hy
      K = 1
    end if
  end if
  V = Jin & 2
  if V > 0 then
    if Hy < HYMax then
      inc Hy
      K = 1
      if BmOn = 1 then
        if BmY < 174 then BmY = BmY + 2
      end if
    end if
  end if
  if K = 1 then
    inc FuelT
    if FuelT >= 24 then
      FuelT = 0
      dec Fuel
      if Fuel <= 8 then play sound SndLow
    end if
  end if
  V = Jin & 16
  if V > 0 then
    if BmOn = 0 then
      if Bombs > 0 then
        if Fuel > 0 then
          BmOn = 1
          BmT = Hx + 44
          BmF = 0
          BmY = Hy + 6
          dec Bombs
          HudDirty = 1
          play sound SndBomb
        end if
      end if
    end if
  end if
  return
end sub

' the bomb flies forward 22/16 pixel a frame and ends three quarters of the
' way across
sub MoveBomb:
  if BmOn = 0 then return
  V = BmF + 22
  N = V >> 4
  BmF = V & 15
  BmT = BmT + N
  if BmT >= BombEnd then BmOn = 0
  return
end sub

' a plane (Pi) flies left; past the left edge it starts its round again
' far to the right (hidden for a while): plane 0 at a random height and
' colour, plane 1 at the helicopter's height
sub MovePlane:
  V = Pf[Pi] + Spd[Pi]
  N = V >> 4
  Pf[Pi] = V & 15
  W16 = Pt[Pi] - N
  if W16 < W16b then
    W16 = W16 + 394
    Pa[Pi] = 1
    if Pi = 0 then
      Rand
      V = Rs & 127
      Py[0] = V + 26
      W16 = Rs >> 8
      V = W16 & 7
      Pc = PlCol[V]
      W16 = Pt[0] - N
      W16 = W16 + 394
    else
      Py[1] = Hy
    end if
  end if
  Pt[Pi] = W16
  return
end sub

' the fuel drop drifts left 2/16 pixel a frame, swaying; once it is gone,
' plane 1 fires a missile as it passes three quarters of the screen; the
' missile flies 180/16 pixels a frame; then a new drop
sub MoveDrop:
  if Mode = 0 then
    inc Cb
    V = Cf + 2
    N = V >> 4
    Cf = V & 15
    Ct = Ct - N
    V = Cb >> 3
    V = V & 15
    Cy = Bob[V] + 26
    if Ct < W16b then Mode = 1
    return
  end if
  if Mode = 1 then
    if Pa[1] = 1 then
      if OldB >= 212 then
        if Pt[1] < 212 then
          Mode = 2
          Mt = Pt[1] - 4
          Mf = 0
          My = Py[1] + 4
          play sound SndMissile
        end if
      end if
    end if
    return
  end if
  V = Mf + 180
  N = V >> 4
  Mf = V & 15
  W16 = N + 16
  if Mt < W16 then
    Mode = 0
    Ct = 409
    Cf = 0
    Cb = 0
    Cy = 26
  else
    Mt = Mt - N
  end if
  return
end sub

' Hit = 1 when box A (Ax1-Ax2, Ay1-Ay2) and box B overlap
sub Overlap:
  Hit = 0
  if Ax1 > Bx2 then return
  if Bx1 > Ax2 then return
  if Ay1 > By2 then return
  if By1 > Ay2 then return
  Hit = 1
  return
end sub

sub BombBox:
  Ax1 = BmT + 1
  Ax2 = BmT + 10
  Ay1 = BmY + 6
  Ay2 = BmY + 10
  return
end sub

sub PlaneBox:
  Bx1 = Pt[Pi]
  Bx2 = Pt[Pi] + 15
  By1 = Py[Pi] + 3
  By2 = Py[Pi] + 12
  return
end sub

sub ManBox:
  Bx1 = Wt + 1
  Bx2 = Wt + 14
  By1 = ManTop
  By2 = 127
  return
end sub

sub HeliBox:
  Ax1 = Hx + 33
  Ax2 = Hx + 62
  Ay1 = Hy + 1
  Ay2 = Hy + 14
  return
end sub

' a bomb on a plane (25 or 50) or on the man while the fire burns (75)
sub BombHits:
  for Pi = 0 to 1
    if BmOn = 1 then
      if Pa[Pi] = 1 then
        BombBox
        PlaneBox
        Overlap
        if Hit = 1 then
          BmOn = 0
          Pa[Pi] = 0
          Bt[Pi] = 24
          Bx[Pi] = Pt[Pi]
          By[Pi] = Py[Pi]
          W16 = 25
          if Pi = 1 then W16 = 50
          AddScore
          play sound SndBoom
        end if
      end if
    end if
  next
  if BmOn = 0 then return
  if Burn = 0 then return
  if Wt >= W288 then return
  BombBox
  ManBox
  Overlap
  if Hit = 1 then
    BmOn = 0
    Burn = 0
    W16 = 75
    AddScore
    play sound SndDouse
  end if
  return
end sub

' the helicopter against the city, the planes, the missile, the fuel drop
' and the man
sub HeliHits:
  W16 = Hx + 4
  W16 = W16 + Sc
  if W16 >= W320 then W16 = W16 - 320
  V = Win24[W16]
  V = V + 128
  W16 = Hy + 15
  NumU = V
  if W16 >= NumU then
    Crash
    return
  end if
  HeliBox
  for Pi = 0 to 1
    if Pa[Pi] = 1 then
      PlaneBox
      Overlap
      if Hit = 1 then
        Crash
        return
      end if
    end if
  next
  if Mode = 2 then
    Bx1 = Mt
    Bx2 = Mt + 15
    By1 = My + 7
    By2 = My + 8
    Overlap
    if Hit = 1 then
      Crash
      return
    end if
  end if
  if Mode = 0 then
    Bx1 = Ct + 1
    Bx2 = Ct + 14
    By1 = Cy
    By2 = Cy + 15
    Overlap
    if Hit = 1 then
      if Fuel < 48 then
        Fuel = 48
        FuelT = 0
        play sound SndFuel
      end if
    end if
  end if
  if There = 0 then return
  if Wt >= W288 then return
  ManBox
  Overlap
  if Hit = 0 then return
  V = Hy + 14
  if Burn = 1 then
    if V > 119 then
      Crash
      return
    end if
  end if
  ' lifted aboard
  There = 0
  inc Men
  W16 = 200
  AddScore
  HudDirty = 1
  if Men < 5 then
    play sound SndRescue
    return
  end if
  Men = 0
  inc Mission
  W16 = 500
  AddScore
  Bombs = 20
  SetSpeeds
  SetCityCol
  print at 9,6, " MISSION    "
  NumU = Mission
  print at 18,6, digits$(NumU, 2)
  Banner = 120
  if Mission = 7 then
    inc Ships
    play sound SndExtra
  else
    play sound SndMission
  end if
  return
end sub

sub Crash:
  Dead = 90
  BmOn = 0
  play sound SndCrash
  return
end sub

' Score + W16, kept below 65536; the best score follows it
sub AddScore:
  A16 = 65535 - W16
  if Score > A16 then
    Score = 65535
  else
    Score = Score + W16
  end if
  if Score > Hi then Hi = Score
  HudDirty = 1
  return
end sub

' plane speeds in sixteenths of a pixel: (mission + 1) x 11 and
' (mission + 2) x 11, growing until mission 11
sub SetSpeeds:
  V = Mission
  if V > 11 then V = 11
  W16 = V + 1
  W16 = W16 * 11
  Spd[0] = W16
  W16 = V + 2
  W16 = W16 * 11
  Spd[1] = W16
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' a new helicopter: start position, full tank, 20 bombs, the planes and
' the fuel drop far away, the tower coming in from the right
sub NewLife:
  Hx = 29
  Hy = 40
  Fuel = 48
  FuelT = 0
  Bombs = 20
  BmOn = 0
  Pt[0] = 18
  Pt[1] = 409
  Pf[0] = 0
  Pf[1] = 0
  Pa[0] = 0
  Pa[1] = 0
  Py[0] = 60
  Py[1] = 60
  Mode = 0
  Ct = 409
  Cf = 0
  Cb = 0
  Cy = 26
  Sc = 148
  CityAll = 1
  Burn = 1
  There = 1
  Wt = 300
  Bt[0] = 0
  Bt[1] = 0
  Dead = 0
  HudDirty = 1
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' a sprite Snum at track position Strk (screen X + 32), row Srow, pattern Spat,
' colour Scol; the early clock bit slides it off the left edge; hidden past
' the right edge
sub PutSpr:
  if Strk >= W288 then
    set sprite Snum to 192,0,0,0
    return
  end if
  C = Scol
  if Strk >= W32 then
    W16 = Strk - 32
  else
    W16 = Strk
    C = C | 128
  end if
  X = W16
  Y = Srow - 1
  set sprite Snum to Y,X,Spat,C
  return
end sub

sub HideOne:
  set sprite Snum to 192,0,0,0
  return
end sub

' sprites 0-1 the helicopter, 2 the man, 3 the fire or smoke, 4 the bomb,
' 5-6 the planes, 7 the missile or canopy, 8 the crate, 9-10 explosions
sub DrawSprites:
  Strk = Hx + 32
  Srow = Hy
  if Dead > 0 then
    V = Dead & 8
    K = SXl1
    if V > 0 then K = SXl2
    Scol = 11
    if V > 0 then Scol = 8
  else
    V = Rot & 4
    K = SHl1
    if V > 0 then K = SHl2
    Scol = 14
  end if
  Snum = 0
  Spat = K
  PutSpr
  Strk = Hx + 48
  Snum = 1
  Spat = K + 4
  if Dead = 0 then Scol = 15
  PutSpr
  ' the man and the fire
  Strk = Wt
  Srow = 112
  Snum = 2
  if There = 1 then
    V = Tick & 16
    Spat = SMan1
    if V > 0 then Spat = SMan2
    Scol = 15
    PutSpr
  else
    HideOne
  end if
  Snum = 3
  if Burn = 1 then
    V = Tick / 10
    V = V & 1
    Spat = SFire1
    if V > 0 then Spat = SFire2
    Scol = 8
  else
    V = Tick & 32
    Spat = SSmoke1
    if V > 0 then Spat = SSmoke2
    Scol = 14
  end if
  PutSpr
  ' the bomb
  Snum = 4
  if BmOn = 1 then
    Strk = BmT
    Srow = BmY
    Spat = SBomb
    Scol = 7
    PutSpr
  else
    HideOne
  end if
  ' the planes
  V = Tick & 2
  K = SPlane1
  if V > 0 then K = SPlane2
  for Pi = 0 to 1
    Snum = Pi + 5
    if Pa[Pi] = 1 then
      Strk = Pt[Pi]
      Srow = Py[Pi]
      Spat = K
      Scol = 8
      if Pi = 0 then Scol = Pc
      PutSpr
    else
      HideOne
    end if
  next
  ' the fuel drop or the missile
  if Mode = 0 then
    Strk = Ct
    Srow = Cy
    Snum = 7
    Spat = SCanopy
    Scol = 15
    PutSpr
    Snum = 8
    Spat = SCrate
    Scol = 11
    PutSpr
  else
    Snum = 8
    HideOne
    Snum = 7
    if Mode = 2 then
      Strk = Mt
      Srow = My
      Spat = SMissile
      Scol = 15
      PutSpr
    else
      HideOne
    end if
  end if
  ' explosions
  for Pi = 0 to 1
    Snum = Pi + 9
    if Bt[Pi] > 0 then
      Strk = Bx[Pi]
      Srow = By[Pi]
      Spat = SBoom1
      Scol = 11
      if Bt[Pi] < 12 then
        Spat = SBoom2
        Scol = 8
      end if
      PutSpr
    else
      HideOne
    end if
  next
  return
end sub

' the score line, ships, bombs, men, mission and the fuel gauge, when
' something changed
sub ShowHud:
  if HudDirty = 1 then
    HudDirty = 0
    NumU = Score
    print at 8,1, digits$(NumU, 5)
    NumU = Hi
    print at 25,1, digits$(NumU, 5)
    NumU = Ships
    print at 3,2, digits$(NumU, 1)
    NumU = Bombs
    print at 7,2, digits$(NumU, 2)
    NumU = Men
    print at 12,2, digits$(NumU, 1)
    NumU = Mission
    print at 26,2, digits$(NumU, 2)
  end if
  if Fuel <> OldFuel then
    OldFuel = Fuel
    ' six gauge cells of 8 steps each, red when low
    B = TGauge
    if Fuel <= 12 then B = TGauge + 9
    R = Fuel
    for Li = 0 to 5
      if R >= 8 then
        T = B + 8
        R = R - 8
      else
        T = B + R
        R = 0
      end if
      U = Li + 14
      put char T at U,22
    next
  end if
  return
end sub

sub HudFrame:
  print at 2,1, "SCORE"
  print at 21,1, "HI"
  put char TIhel at 2,2
  put char TIbomb at 6,2
  put char TIman at 11,2
  print at 13,2, "/5"
  print at 18,2, "MISSION"
  print at 9,22, "FUEL"
  HudDirty = 1
  OldFuel = 255
  return
end sub

' the city's colours for the mission (eight palettes in turn): each code
' of a city row gets that row's line colours
sub SetCityCol:
  V = Mission - 1
  V = V & 7
  W16 = V * 48
  for Li = 0 to 5
    B = RowStart[Li]
    D = Li + 1
    D = RowStart[D]
    A16 = W16 + Li * 8
    while B < D
      NumU = B
      NumU = NumU << 3
      copy LineCol + A16 count 8 to vram.color + 4096 + NumU
      inc B
    end while
  next
  return
end sub

' stars and the moon in the sky
sub DrawSky:
  put char TStar1 at 4,4
  put char TStar2 at 13,3
  put char TStar3 at 18,5
  put char TStar1 at 27,7
  put char TStar3 at 7,9
  put char TStar1 at 21,10
  put char TStar2 at 2,12
  put char TStar3 at 15,13
  put char TStar1 at 10,14
  put char TStar3 at 29,12
  put char TStar1 at 24,4
  put char TMoon00 at 25,5
  put char TMoon01 at 26,5
  put char TMoon10 at 25,6
  put char TMoon11 at 26,6
  return
end sub

sub NewGame:
  NewScreen
  DrawSky
  HudFrame
  Score = 0
  Ships = 3
  Men = 0
  Mission = 1
  Over = 0
  Banner = 0
  SetSpeeds
  SetCityCol
  NewLife
  call asm ArCity
  ShowHud
  DrawSprites
  update sprites
  print at 9,6, " MISSION  1 "
  Banner = 120
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 12
  for J = 0 to 11
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  W16 = TGauge * 8
  copy GaugePat count 144 to vram.pattern + 4096 + W16
  copy GaugeCol count 144 to vram.color + 4096 + W16
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the city scrolling under the stars, a helicopter crossing,
' the tune once, START / CREDITS
sub TitlePage:
  NewScreen
  DrawSky
  Mission = 1
  SetCityCol
  Sc = 0
  CityAll = 1
  call asm ArCity
  for J = 6 to 13
    fill 32 count 24 at 4,J
  next
  fill TBar count 24 at 4,6
  fill TBarb count 24 at 4,13
  for J = 0 to 19
    K = J + 6
    put char Logo0[J] at K,8
    put char Logo1[J] at K,9
  next
  print at 13,11, "START"
  print at 13,12, "CREDITS"
  print at 2,1, "HI"
  NumU = Hi
  print at 5,1, digits$(NumU, 5)
  print at 14,1, "AHOY! APR 1986"
  ShowMenu
  Hx = 0
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 520
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  call asm ArCity
  update sprites
  inc Rs
  ReadPad
  inc Sc
  if Sc >= W320 then Sc = 0
  ' a helicopter crosses the sky now and then
  inc Rot
  V = Tick & 1
  if V = 0 then inc Hx
  Strk = Hx
  Srow = 28
  V = Rot & 4
  K = SHl1
  if V > 0 then K = SHl2
  Snum = 0
  Spat = K
  Scol = 14
  PutSpr
  Strk = Hx + 16
  Snum = 1
  Spat = K + 4
  Scol = 15
  PutSpr
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      K = V & 1
      if K > 0 then
        Menu = 0
      else
        Menu = 1
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 1 then CreditsPage
  return
end sub

sub ShowMenu:
  put char 32 at 11,11
  put char 32 at 11,12
  J = Menu + 11
  put char 62 at 11,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "AIR  RESCUE"
  print at 2,5, "BASED ON AIR RESCUE, AHOY!"
  print at 2,6, "APRIL 1986 (COMMODORE 64"
  print at 2,7, "MACHINE CODE). THE AUTHOR"
  print at 2,8, "IS NOT NAMED ON THE DISK."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,18, "MUSIC: SKYLINE RESCUE"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

