asm {
; ArR3: VDP register 3 = $FF, so each screen third has its own colour
; table (tile screen shares one; the city's codes need their own colours)
ArR3:
    ld bc,$03FF
    call WRITE_REGISTER
    ret
; ArCity: the city for the scroll Sc (0-319): the patterns of all 90
; pair codes for the shift Sc & 7 (ShiftPat), and when the shift is 0 (or
; CityAll is set) the names of rows 16-21 from PairMap at offset Sc / 8.
; 32 cycles a byte (outi, nop, jr), safe with the display on; NMI off.
ArCity:
    ld hl,(AMY_UVAR_Sc)
    ld a,l
    and 7
    ld b,a
    ld hl,AMY_UDATA_ShiftPat
    ld de,720
    inc b
ArC0:
    dec b
    jr z,ArC1
    add hl,de
    jr ArC0
ArC1:
    ld a,$00
    out ($BF),a
    ld a,$14 | $40
    out ($BF),a
    ld c,$BE
    ld b,208
ArC2:
    outi
    nop
    jr nz,ArC2
    ld d,2
    ld a,d
    or a
    jr z,ArC5
ArC4:
    outi
    nop
    jr nz,ArC4
    dec d
    jr nz,ArC4
ArC5:
    ld a,(AMY_UVAR_Sc)
    and 7
    jr z,ArN
    ld a,(AMY_UVAR_CityAll)
    or a
    ret z
ArN:
    xor a
    ld (AMY_UVAR_CityAll),a
    ld hl,(AMY_UVAR_Sc)
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ld de,AMY_UDATA_PairMap
    add hl,de
    ld a,$00
    out ($BF),a
    ld a,$1A | $40
    out ($BF),a
    ld e,6
ArN1:
    push hl
    ld b,32
    ld c,$BE
ArN2:
    outi
    nop
    jr nz,ArN2
    pop hl
    ld bc,72
    add hl,bc
    dec e
    jr nz,ArN1
    ret
ArBomb:
    db $40,$5D,$30,$02,$40,$76,$40,$02,$40,$93,$50,$02,$40,$BA,$60,$02,$40,$E9,$80,$02,$50
ArBoom:
    db $00,$00,$04,$04,$00,$00,$25,$06,$00,$00,$46,$08,$00,$00,$76,$0A,$10
ArDouse:
    db $00,$00,$27,$06,$00,$00,$47,$08,$00,$00,$67,$0A,$00,$00,$97,$08,$10
ArRescue:
    db $40,$8F,$10,$03,$40,$71,$10,$03,$40,$5F,$10,$03,$40,$47,$20,$08,$50
ArMission:
    db $40,$D6,$10,$06,$40,$AA,$10,$06,$40,$8F,$10,$06,$40,$6B,$10,$06,$40,$55,$20,$12,$50
ArFuel:
    db $40,$FE,$20,$03,$40,$CA,$20,$03,$40,$AA,$20,$03,$40,$7F,$30,$05,$50
ArMissile:
    db $40,$2D,$20,$01,$40,$38,$30,$01,$40,$46,$30,$01,$40,$56,$40,$01,$40,$70,$50,$02,$40,$8C,$60,$02
    db $50
ArCrash:
    db $00,$00,$04,$08,$00,$00,$15,$0A,$00,$00,$36,$0C,$00,$00,$56,$10,$00,$00,$77,$14,$10
ArLow:
    db $40,$53,$31,$04,$40,$53,$F1,$02,$50
ArExtra:
    db $40,$6B,$10,$04,$40,$55,$10,$04,$40,$6B,$10,$04,$40,$47,$20,$0A,$50
ArStart:
    db $40,$1D,$21,$06,$40,$D6,$20,$06,$40,$AA,$20,$0E,$50
ArEnd:
    db $40,$D6,$10,$0A,$40,$FE,$20,$0A,$40,$41,$21,$0A,$40,$AB,$31,$1E,$50

