asm {
ViboritasMusicTone:
    db $C0,$72,$F0,$10,$C0,$5A,$F0,$10,$C0,$4C,$F0,$10,$C0,$44,$F0,$10
    db $C0,$40,$F0,$10,$C0,$44,$F0,$10,$C0,$4C,$F0,$10,$C0,$5A,$F0,$10
    db $C0,$72,$F0,$10,$C0,$5A,$F0,$10,$C0,$4C,$F0,$10,$C0,$44,$F0,$10
    db $C0,$40,$F0,$10,$C0,$44,$F0,$10,$C0,$4C,$F0,$10,$C0,$5A,$F0,$10
    db $C0,$55,$F0,$10,$C0,$44,$F0,$10,$C0,$39,$F0,$10,$C0,$33,$F0,$10
    db $C0,$30,$F0,$10,$C0,$33,$F0,$10,$C0,$39,$F0,$10,$C0,$44,$F0,$10
    db $C0,$72,$F0,$10,$C0,$5A,$F0,$10,$C0,$4C,$F0,$10,$C0,$44,$F0,$10
    db $C0,$40,$F0,$10,$C0,$44,$F0,$10,$C0,$4C,$F0,$10,$C0,$5A,$F0,$10
    db $C0,$4C,$F0,$10,$C0,$3C,$F0,$10,$C0,$33,$F0,$10,$C0,$2D,$F0,$10
    db $C0,$55,$F0,$10,$C0,$44,$F0,$10,$C0,$39,$F0,$10,$C0,$33,$F0,$10
    db $C0,$72,$F0,$10,$C0,$5A,$F0,$10,$C0,$4C,$F0,$10,$C0,$44,$F0,$10
    db $C0,$4C,$F0,$10,$C0,$3C,$F0,$10,$C0,$33,$F0,$10,$C0,$2D,$F0,$10
    db $D8
ViboritasMusicNoise:
    db $02,$54,$03,$18,$11,$02,$33,$0D,$18,$21,$02,$54,$03,$18,$11,$02
    db $33,$09,$18,$21,$02,$54,$04,$18,$11,$02,$54,$05,$18,$11,$02,$53
    db $0B,$18,$21,$02,$54,$03,$18,$11,$02,$33,$09,$18,$21,$02,$54,$04
    db $18,$11,$18
ViboritasVictoryTone1:
    db $40,$47,$A0,$18,$40,$5F,$A0,$18,$40,$50,$A0,$18,$40,$5F,$A0,$30
    db $50
ViboritasVictoryTone2:
