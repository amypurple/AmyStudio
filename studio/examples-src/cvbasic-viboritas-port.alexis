tile screen
backdrop black
sprites 16x16
sprites simple
define chars ViboritasTiles at 128 count 21
define colors ViboritasColors at 128 count 21
copy ViboritasSprites to vram.spr_pat
clear sprites
set sprite count 4
set sound table ViboritasSoundTable areas 5
screen on
show_intro
goto restart_game

sub show_intro:
  cls
  print centered at 3, "VIBORITAS"
  print centered at 6, "CVBASIC PORT"
  print at 1,9, "Oscar Toledo created"
  print at 1,10, "the original game in"
  print at 1,11, "Z80 ASM in Oct 1990."
  print at 1,14, "CVBasic revision:"
  print at 1,15, "Feb 29 2024."
  print centered at 20, "PRESS FIRE"
  pause until press
  wait no fire
  return

sub restart_game:
  Score = 0
  Lives = 2
  Level = 1
  goto start_level

sub start_level:
  screen off no nmi
  cls
  print at 1,21, "Score:"
  print Score at 8,21
  print at 24,21, "Lives:"
  print Lives at 30,21
  print centered at 23, "nanochess 1990"
  draw_level
  XPlayer = 8
  YPlayer = 16
  PlayerFrame = 0
  XEnemy1 = random(128) + 64
  YEnemy1 = 56
  Enemy1Frame = 24
  XEnemy2 = random(128) + 80
  YEnemy2 = 96
  Enemy2Frame = 32
  XEnemy3 = random(128) + 48
  YEnemy3 = 136
  Enemy3Frame = 24
  EnemySpeed = 0
  play song ViboritasSong
  screen on
  goto game_loop

sub game_loop:
  wait
  set sprite 0 to YPlayer - 1,XPlayer,PlayerFrame,15
  set sprite 1 to YEnemy1 - 1,XEnemy1,Enemy1Frame,14
  set sprite 2 to YEnemy2 - 1,XEnemy2,Enemy2Frame,14
  set sprite 3 to YEnemy3 - 1,XEnemy3,Enemy3Frame,14
  update sprites
  move_player
  C = $50 + Level * 4
  EnemySpeed += C
  if EnemySpeed >= $40 then
    EnemySpeed -= $40
    move_enemies
  end if
  if joypad(1).button1 then
    if XPlayer > 232 then
      if XPlayer < 248 then
        if YPlayer = 136 then goto level_complete
      end if
    end if
  end if
  if abs(YPlayer + 1 - YEnemy1) < 8 then
    if abs(XPlayer + 1 - XEnemy1) < 8 then goto player_dies
  end if
  if abs(YPlayer + 1 - YEnemy2) < 8 then
    if abs(XPlayer + 1 - XEnemy2) < 8 then goto player_dies
  end if
  if abs(YPlayer + 1 - YEnemy3) < 8 then
    if abs(XPlayer + 1 - XEnemy3) < 8 then goto player_dies
  end if
  goto game_loop

sub level_complete:
  u8 bonus
  for bonus = 1 to 10
    wait
    Score += 1
    print Score at 8,21
    play sound 10
    wait 4 frames
  next
  stop song
  Level += 1
  print centered at 8, "LEVEL CLEAR"
  play song ViboritasVictorySong
  wait 180 frames
  if Level = 6 then
    Level = 1
    if Lives < 9 then
      Lives += 1
      print Lives at 30,21
      play sound 10
    end if
  end if
  stop song
  wait 50 frames
  goto start_level

sub player_dies:
  play sound 9
  PlayerFrame = 0
  for C = 0 to 30
  wait 2 frames
  if PlayerFrame = 0 then
    PlayerFrame = 8
  else
    PlayerFrame = 0
  end if
  set sprite 0 to YPlayer - 1,XPlayer,PlayerFrame,15
  update sprites
  next C
  do
  wait
  if PlayerFrame = 0 then
    PlayerFrame = 8
  else
    PlayerFrame = 0
  end if
  set sprite 0 to YPlayer - 1,XPlayer,PlayerFrame,15
  update sprites
  YPlayer += 2
  loop while YPlayer < 160
  if Lives = 0 then
    stop song
    print centered at 8, "GAME OVER"
    wait 300 frames
    goto restart_game
  end if
  Lives -= 1
  goto start_level

sub draw_level:
  BaseTile = 128 + (Level - 1) * 4
  for Offset = 0 to $027C step 4
  vpoke vram.name + Offset, BaseTile
  vpoke vram.name + Offset + 1, BaseTile
  vpoke vram.name + Offset + 2, BaseTile
  vpoke vram.name + Offset + 3, BaseTile + 1
  next Offset
  for RowOffset = $0080 to $0260 step 160
  for Offset = RowOffset to RowOffset + 31
  vpoke vram.name + Offset, BaseTile + 2
  next Offset
  next RowOffset
  Ladders = 6 - Level
  for RowOffset = $0080 to $01C0 step 160
  for D = 1 to Ladders
  E = random(24) + 4
  vpoke vram.name + RowOffset + E, BaseTile + 3
  vpoke vram.name + RowOffset + E + 32, BaseTile + 3
  vpoke vram.name + RowOffset + E + 64, BaseTile + 3
  vpoke vram.name + RowOffset + E + 96, BaseTile + 3
  vpoke vram.name + RowOffset + E + 128, BaseTile + 3
  next D
  next RowOffset
  vpoke vram.name + $025E, ExitTile
  for RowOffset = 0 to $02E0 step 32
  vpoke vram.name + RowOffset, $20
  next RowOffset
  return

sub move_player:
  YMod = YPlayer mod 40
  FrameLow = frame
  AnimBit = FrameLow mod 8
  if joypad(1).left then
    if YMod = 16 then
      if XPlayer > 8 then
        XPlayer -= 1
        play sound 7
      end if
      if AnimBit >= 4 then PlayerFrame = 8 else PlayerFrame = 12
    end if
  end if
  if joypad(1).right then
    if YMod = 16 then
      if XPlayer < 240 then
        XPlayer += 1
        play sound 7
      end if
      if AnimBit >= 4 then PlayerFrame = 0 else PlayerFrame = 4
    end if
  end if
  if joypad(1).up then
    if YMod = 16 then
      ProbeX = XPlayer + 7
      ProbeY = YPlayer + 8
      find tile ladder under box ProbeX,ProbeY size 1,1 into HitX,HitY
      if HitX != 255 then
        YPlayer -= 1
        play sound 8
      end if
    else
      if AnimBit >= 4 then PlayerFrame = 16 else PlayerFrame = 20
      YPlayer -= 1
      play sound 8
    end if
  end if
  if joypad(1).down then
    if YMod = 16 then
      ProbeX = XPlayer + 7
      ProbeY = YPlayer + 16
      find tile ladder under box ProbeX,ProbeY size 1,1 into HitX,HitY
      if HitX != 255 then
        YPlayer += 1
        play sound 8
      end if
    else
      if AnimBit >= 4 then PlayerFrame = 16 else PlayerFrame = 20
      YPlayer += 1
      play sound 8
    end if
  end if
  return

sub move_enemies:
  FrameLow = frame
  AnimBit = FrameLow mod 8
  if Enemy1Frame < 32 then
    XEnemy1 -= 1
    Enemy1Frame = 24
    if XEnemy1 = 8 then Enemy1Frame = 32
  else
    XEnemy1 += 1
    Enemy1Frame = 32
    if XEnemy1 = 240 then Enemy1Frame = 24
  end if
  if AnimBit >= 4 then Enemy1Frame += 4
  if Enemy2Frame < 32 then
    XEnemy2 -= 1
    Enemy2Frame = 24
    if XEnemy2 = 8 then Enemy2Frame = 32
  else
    XEnemy2 += 1
    Enemy2Frame = 32
    if XEnemy2 = 240 then Enemy2Frame = 24
  end if
  if AnimBit >= 4 then Enemy2Frame += 4
  if Enemy3Frame < 32 then
    XEnemy3 -= 1
    Enemy3Frame = 24
    if XEnemy3 = 8 then Enemy3Frame = 32
  else
    XEnemy3 += 1
    Enemy3Frame = 32
    if XEnemy3 = 240 then Enemy3Frame = 24
  end if
  if AnimBit >= 4 then Enemy3Frame += 4
  return
