    db $FF
ViboritasSong:
    dw $0001
    db $41,$02
    dw $0000
ViboritasVictorySong:
    dw $0001
    db $83,$04,$05
    dw $0000
ViboritasSoundTable:
    dw ViboritasMusicTone,$702B
    dw ViboritasMusicNoise,$7035
    dw ViboritasVictoryTone1,$702B
    dw ViboritasVictoryTone2,$7035
    dw ViboritasVictoryTone3,$703F
