u8 D = 0
u8 E = 0
u8 ProbeX = 0
u8 ProbeY = 0
u8 HitX = 255
u8 HitY = 255
u8 YMod = 0
u8 FrameLow = 0
u8 AnimBit = 0
u16 Offset = 0
u16 RowOffset = 0

