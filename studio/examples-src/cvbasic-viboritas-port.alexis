project "Viboritas Port"
cartridge "VIBORITAS/OSCAR TOLEDO/2024"

const ExitTile = 148

tile type ladder = $83,$87,$8B,$8F,$93

bcd digits 4 Score
bcd digits 1 Lives
u8 Level = 1
u8 BaseTile = 128
u8 Ladders = 5
u8 XPlayer = 8
u8 YPlayer = 16
u8 PlayerFrame = 0
