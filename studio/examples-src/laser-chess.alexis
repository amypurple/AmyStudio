    db $C0,$AA,$40,$03,$C0,$71,$40,$03,$D0
LcWin:
    db $40,$D6,$20,$06,$40,$D6,$F0,$01,$40,$AA,$20,$06,$40,$AA,$F0,$01,$40,$8F,$20,$06,$40,$8F,$F0,$01
    db $40,$6B,$20,$0D,$40,$6B,$F0,$01,$40,$8F,$20,$06,$40,$8F,$F0,$01,$40,$6B,$20,$06,$40,$6B,$F0,$01
    db $40,$55,$20,$27,$40,$55,$F0,$01,$50

LcSoundTable:
    dw LcTick,$702B
    dw LcPick,$7049
    dw LcMove,$702B
    dw LcRotate,$7049
    dw LcBad,$7049
    dw LcZap,$7035
    dw LcBoom,$702B
    dw LcWarp,$7035
    dw LcTurn,$7049
    dw LcWin,$7035
    dw LcTuneMel,$703F
    dw LcTuneBass,$7049
; Title tune: Photon Pulse, a fast synth arpeggio over a pulsing octave bass in A minor (original for this game)
; Tiny Sound, 5 frames per step
LcTuneMel:
    db $44
    dw sndtiny_1
    db 5
    db $02,$30,$1A,$21,$1C,$1F,$23,$28,$23,$1F,$1C,$23,$18,$1C,$1F,$24
    db $1F,$1C,$18,$1F,$1F,$23,$26,$2B,$26,$23,$1F,$26,$1A,$1E,$21,$26
    db $21,$1E,$1A,$21,$1C,$1F,$23,$28,$23,$1F,$1C,$23,$18,$1C,$1F,$24
    db $1F,$1C,$18,$1F,$1F,$23,$26,$2B,$26,$23,$1F,$26,$1A,$1E,$21,$26
    db $21,$1E,$1A,$21,$02,$10,$1A,$21,$28,$01,$01,$01,$26,$01,$23,$01
    db $24,$01,$01,$01,$23,$01,$1F,$01,$26,$01,$01,$01,$23,$01,$21,$01
    db $23,$01,$01,$01,$1E,$01,$01,$01,$28,$01,$01,$01,$2B,$01,$2A,$01
    db $28,$01,$01,$01,$26,$01,$23,$01,$24,$01,$26,$01,$23,$01,$21,$01
    db $1F,$01,$1E,$01,$1C,$01,$01,$01
    db $FF
LcTuneBass:
    db $84
    dw sndtiny_2
    db 5
    db $02,$50,$18,$32,$04,$10,$04,$10,$04,$10,$04,$10,$0C,$18,$0C,$18
    db $0C,$18,$0C,$18,$07,$13,$07,$13,$07,$13,$07,$13,$0E,$1A,$0E,$1A
    db $0E,$1A,$0E,$1A,$04,$10,$04,$10,$04,$10,$04,$10,$0C,$18,$0C,$18
    db $0C,$18,$0C,$18,$07,$13,$07,$13,$07,$13,$07,$13,$0E,$1A,$0E,$1A
    db $0E,$1A,$0E,$1A,$02,$50,$18,$32,$0C,$18,$0C,$18,$0C,$18,$0C,$18
    db $07,$13,$07,$13,$07,$13,$07,$13,$0E,$1A,$0E,$1A,$0E,$1A,$0E,$1A
    db $04,$10,$04,$10,$04,$10,$04,$10,$0C,$18,$0C,$18,$0C,$18,$0C,$18
    db $0E,$1A,$0E,$1A,$0E,$1A,$0E,$1A,$07,$13,$07,$13,$07,$13,$07,$13
    db $04,$10,$04,$10,$04,$10,$04,$10
    db $FF
; Laser Chess Z80 helpers (called with the NMI off)

; DrawSq: one board square, 2 x 2 cells at text row SqR, column SqC:
; the 32 pattern bytes at Art + ArtOff, every colour byte SqClr.
DrawSq:
    ld hl,(AMY_UVAR_ArtOff)
    ld de,AMY_UDATA_Art
    add hl,de
    ld a,(AMY_UVAR_SqR)
    ld d,a
    ld a,(AMY_UVAR_SqC)
    add a,a
    add a,a
    add a,a
    ld e,a
    call ds_cell
    ld a,e
    add a,8
    ld e,a
    call ds_cell
    inc d
    ld a,e
    sub 8
    ld e,a
    call ds_cell
    ld a,e
    add a,8
    ld e,a
    call ds_cell
    ret
; hl: 8 pattern bytes (advanced), de: VRAM address (kept)
ds_cell:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld b,8
dsc_p:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz dsc_p
    ld a,e
    out ($BF),a
    ld a,d
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_SqClr)
    ld b,8
dsc_c:
    out ($BE),a
    nop
    nop
    nop
    djnz dsc_c
    ret

; Pset: plots pixel Xc,Yy in colour Col on the bitmap screen (pattern
; table at $0000, colour table at $2000, name table in order), with the
; NMI off. The ink becomes Col; the background colour is kept.
Pset:
    ld a,(AMY_UVAR_Yy)
    ld h,a
    srl h
    srl h
    srl h                       ; h = Yy / 8 (third row of 8 pixels)
    and 7
    ld l,a
    ld a,(AMY_UVAR_Xc)
    and $F8
    or l
    ld l,a                      ; hl = (Yy/8)*256 + (Xc & $F8) + (Yy & 7)
    ld a,l
    out ($BF),a
    ld a,h
    out ($BF),a                 ; read address
    ld a,(AMY_UVAR_Xc)
    and 7
    ld b,a
    ld a,$80
    jr z,ps_bit
ps_sh:
    srl a
    djnz ps_sh
ps_bit:
    ld c,a
    nop
    nop
    in a,($BE)
    or c
    ld c,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,c
    out ($BE),a                 ; the pattern byte with the new bit
    ld a,l
    out ($BF),a
    ld a,h
    or $20                      ; $2000 + address, read
    out ($BF),a
    nop
    nop
    nop
    in a,($BE)
    and $0F
    ld c,a
    ld a,(AMY_UVAR_Col)
    add a,a
    add a,a
    add a,a
    add a,a
    or c
    ld c,a
    ld a,l
    out ($BF),a
    ld a,h
    or $60                      ; write it back with the new ink
    out ($BF),a
    ld a,c
    out ($BE),a
    ret

; BText: writes the zero-ended string at HL on the bitmap screen.
BText:
bt_lp:
    ld a,(hl)
    or a
    ret z
    inc hl
    push hl
    sub 32
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,AMY_UDATA_Font
    add hl,de                   ; glyph address in ROM
    ld de,AMY_UVAR_Glyph
    ld bc,8
    ldir
    ld a,(AMY_UVAR_TxRow)
    ld h,a
    ld a,(AMY_UVAR_TxCol)
    add a,a
    add a,a
    add a,a
    ld l,a                      ; pattern address: row*256 + col*8
    push hl
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_Glyph
    ld b,8
bt_wr:
    ld a,(hl)
    out ($BE),a
    inc hl
    djnz bt_wr
    pop hl
    ld a,l
    out ($BF),a
    ld a,h
    or $60
    out ($BF),a
    ld a,(AMY_UVAR_TxClr)
    add a,a
    add a,a
    add a,a
    add a,a
    ld b,8
bt_cl:
    out ($BE),a
    nop
    nop
    nop
    djnz bt_cl
    ld hl,AMY_UVAR_TxCol
    inc (hl)
    pop hl
    jr bt_lp
}
