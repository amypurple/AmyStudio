u32 X = 0
u8 Pass = 0

  text screen
  print at 4,0, "U32 MULTIPLY LAB"

  print at 1,3, "100000*3"
  X = 100000
  X *= 3
  if X = 300000 then
    Pass += 1
    print at 22,3, "PASS"
  else
    print at 22,3, "FAIL"
  end if

  print at 1,5, "65536*65536 WRAP"
  X = 65536
  X *= 65536
  if X = 0 then
    Pass += 1
    print at 22,5, "PASS"
  else
    print at 22,5, "FAIL"
  end if

  print at 1,7, "X*0"
  X = 123456
  X *= 0
  if X = 0 then
    Pass += 1
    print at 22,7, "PASS"
  else
    print at 22,7, "FAIL"
  end if

  print at 1,9, "X*1"
  X = 123456
  X *= 1
  if X = 123456 then
    Pass += 1
    print at 22,9, "PASS"
  else
    print at 22,9, "FAIL"
  end if

  print at 1,13, "TOTAL"
  print Pass at 7,13 digits 3
  if Pass = 4 then
    print at 12,13, "PASS"
  else
    print at 12,13, "FAIL"
  end if
  screen on