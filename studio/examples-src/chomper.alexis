cartridge "CHOMPER/COMPUTE!'S GAZETTE/1985"

' CHOMPER
' A ColecoVision game based on "Chomper", COMPUTE!'s Gazette January 1985
' (Commodore 64 machine language at $C000 with a BASIC loader; a VIC-20
' version in BASIC on the same disk). Made for Amy Studio by Claude (an AI
' made by Anthropic), 2026, in Amy by Amy Bienvenu.
'
' Not a line-by-line port: the rules are the original's (read from its
' machine code, orig/chomper.dis, and watched in jsc64), the game is built
' for the ColecoVision: a green box-headed muncher and grey robot droids
' as smooth sprites gliding from cell to cell, cut gems and sour jinx faces
' as tiles on a dark blue floor, sound effects and a title tune.
'
' The game: gems and jinxes lie scattered over an open field. Steer the
' chomper (eight directions, the field wraps round) to eat gems (150
' points) and keep off the jinxes (they cost 450, never below 0) while
' droids walk straight at you; a droid that reaches you ends the game, and
' so does the clock. A button scatters 70 more things over the field but
' costs 3 seconds of the clock. Every 3000 points the clock gains extra
' time (45, then 5 less each time, down to none). Reach 54768 points and
' you are one of the few to win at CHOMPER.
'
' From the original (orig/chomper.dis): one game step every 5 jiffies; the
' chomper moves one cell a step in any of eight directions while the stick
' is held; the clock (48 at the start) loses one every 9 steps and the game
' ends when it runs out; 70 things per scatter, half gems and half jinxes,
' put on random cells over what was there (3 off the clock: 27 step ticks;
' the first scatter too, so the clock starts at 45); 150 a gem, 450 a jinx
' (to 0 when under 450); time bonus at 3000, 6000, ... of 45, 40, 35 ...
' down to 0 and the *EX* count of bonuses; droids (1-7, chosen on the
' title) each step a cell straight or diagonally toward the chomper with a
' chance of 46 in 256 a step (EASY, threshold 210) or 96 in 256 (HARD,
' threshold 160), never into another droid, eating whatever they walk over;
' a droid stepping onto the chomper, or the chomper onto a droid, ends the
' game; the win at 54768 points ("YOU ARE ONE OF THE FEW TO WIN AT
' CHOMPER"); the high score.
'
' Liberties: the field is 28 x 20 cells (the C64's 40 x 24 screen, 960
' cells) with the same 70 things a scatter, so a field is a little more
' crowded and a scatter pays about the same; the field wraps at all four
' edges (the C64 wrapped top to bottom, and a step off a side came in on the
' next row); a step that wraps is a jump, the others glide; the scatter
' is on a button press (the C64 scattered every step the trigger was held,
' 3 off the clock each time); the droids start in the bottom eight rows at
' least five rows from the chomper on distinct cells (the C64 put them at
' random in the screen's lower middle, sometimes two rows away, sometimes
' on one cell); the gems come in three colours and the jinxes are always
' red (the C64's colour mode painted every cell at random; its black and
' white mode and the toggle are left out); the clock counts in steps of
' 0.75 seconds as on the C64 and shows three digits (the C64's byte could
' wrap past 255); the SHIFT pause and the title's QUIT are left out; the
' title menu chooses droids and speed with the stick (the C64: up for
' droids, left EASY / right HARD to start, the trigger for the colours).
'
' Controls: controller 1 (or 2): the stick moves the chomper (diagonals
' too); either button scatters more gems and jinxes. On the title, up and
' down choose a line, left and right change it, a button starts.
'
' House rules: text in columns 2-29, rows 1-22; tiles from code 128; the
' frame loop is protected from the NMI; screens drawn with the NMI off
' after a wait, display off. Music first in the sound table, effects after;
' the title tune is played once. `set sprite count` is always given. Own
' xorshift random numbers.

const TFloor = 128
const TGem0 = 129
const TGem1 = 130
const TGem2 = 131
const TJinx = 132
const TEdge = 133
const TEdgeb = 134
const TTbk = 135
const SOpenT = 0
const SOpenB = 4
const SShutT = 8
const SShutB = 12
const SDr0 = 16
const SDr1 = 20
const NTiles8 = 64
const SprBytes = 192
const SndTuneA = 1
const SndTuneB = 2
const SndGem = 3
const SndJinx = 4
const SndScatter = 5
const SndBonus = 6
const SndCrash = 7
const SndTimeUp = 8
const SndWin = 9
const SndStart = 10
const FW = 28
const FH = 20
const NCell = 560
const NSpr = 9
const MaxDroid = 7
const WinScore = 54768
const BonusStep = 3000

' the glide from one cell to the next, pixels after each of the 5 frames
data GlideT bytes 2,3,5,6,8
data GemPal bytes 129,130,131,129

data TilePat bytes
  $80,$00,$00,$00,$00,$00,$00,$00
  $00,$C3,$81,$20,$81,$C3,$18,$00
  $00,$C3,$81,$20,$81,$C3,$18,$00
  $00,$C3,$81,$20,$81,$C3,$18,$00
  $81,$00,$24,$00,$18,$24,$00,$81
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$AA,$00,$00,$AA,$00,$00
end data
data TileCol bytes
  $54,$04,$04,$04,$04,$04,$04,$04
  $04,$4B,$4B,$FB,$4B,$4B,$B4,$04
  $04,$47,$47,$F7,$47,$47,$74,$04
  $04,$4D,$4D,$FD,$4D,$4D,$D4,$04
  $48,$08,$48,$08,$48,$48,$08,$48
  $01,$0E,$0F,$0E,$04,$04,$04,$04
  $04,$04,$04,$04,$0E,$0F,$0E,$01
  $03,$03,$3F,$0F,$0F,$F3,$03,$0C
end data
data SpritePat bytes
  $00,$00,$00,$00,$00,$7F,$2A,$00,$25,$7F,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$80,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00
  $3F,$7F,$CC,$CC,$FF,$80,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00
  $00,$80,$C0,$C0,$C0,$40,$40,$40,$40,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$7F,$55,$7F,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$80,$00,$80,$00,$00,$00,$00,$00,$00,$00
  $3F,$7F,$CC,$CC,$FF,$FF,$80,$80,$80,$7F,$00,$00,$00,$00,$00,$00
  $00,$80,$C0,$C0,$C0,$C0,$40,$40,$40,$80,$00,$00,$00,$00,$00,$00
  $08,$08,$7F,$C1,$D5,$C1,$7F,$3E,$63,$C1,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$80,$80,$80,$00,$00,$00,$80,$00,$00,$00,$00,$00,$00
  $08,$08,$7F,$C1,$D5,$C1,$7F,$3E,$36,$36,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$80,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
end data

data TitleMap bytes
  $20,$20,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$87,$87,$20,$87,$87,$87,$20,$87,$87,$20,$20,$20
  $20,$20,$20,$87,$20,$20,$20,$87,$20,$87,$20,$87,$20,$87,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$20,$20,$20,$87,$20,$87,$20,$20
  $20,$20,$20,$87,$20,$20,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$87,$87,$20,$87,$87,$87,$20,$87,$87,$20,$20,$87,$87,$20,$20,$20
  $20,$20,$20,$87,$20,$20,$20,$87,$20,$87,$20,$87,$20,$87,$20,$87,$20,$87,$20,$87,$20,$20,$20,$87,$20,$20,$20,$87,$20,$87,$20,$20
  $20,$20,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$87,$87,$20,$87,$20,$87,$20,$87,$20,$20,$20,$87,$87,$87,$20,$87,$20,$87,$20,$20
end data

record Droid:
  u8 X
  u8 Y
  u8 OX
  u8 OY
end record

Droid Dr[MaxDroid]

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 R16 = 0
u16 NumU = 0
u16 Score = 0
u16 Thr = 0
u16 TimeU = 0
bcd digits 6 ScB = 0
bcd digits 6 Hi = 0
' the chomper: cell, the cell it glides from, the step's stick
u8 PX = 0
u8 PY = 0
u8 OPX = 0
u8 OPY = 0
u8 Shut = 0
u8 Phase = 0
u8 TCnt = 9
u8 Bonus = 45
u8 Ex = 0
u8 ND = 1
u8 Hard = 0
u8 SpdThr = 210
u8 Over = 0
u8 TurnN = 0
u8 LastJ = 0
u8 LastF = 0
u8 FireReq = 0
u8 Ate = 0
u8 Walk = 0
u8 Jump = 0
' input
u8 J1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with the helpers)
u8 Dn = 0
u8 Sc = 0
u8 Tt = 0
u8 Ds = 0
' scratch
u8 Cx = 0
u8 Cy = 0
u8 Tl = 0
u8 Hb = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 Tx = 0
u8 Ty = 0

  tile screen
  set sound table ChSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu = 3 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  if Press = 1 then FireReq = 1
  if Phase = 0 then
    if Over = 0 then Turn
  end if
  DrawSprites
  inc Phase
  if Phase = 5 then
    Phase = 0
    if Over > 0 then goto game_end
  end if
  goto play_loop

game_end:
  EndMessage
  Rearm
  wait 90 frames
  ' a press goes back to the title; left alone, Amy's sleep blanks the
  ' screen after 30 seconds to spare the TV, and a press wakes it
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one game step (the C64's main loop, every 5 jiffies): the chomper, the
' clock, the time bonus, the droids
sub Turn:
  inc TurnN
  LastJ = J1 & 15
  OPX = PX
  OPY = PY
  MoveChomper
  LastF = FireReq
  if FireReq = 1 then
    FireReq = 0
    Scatter
    play sound SndScatter
  end if
  Eat
  TimeTick
  CheckBonus
  if Over = 0 then MoveDroids
  ShowHud
  return
end sub

' a cell a step in the stick's direction; off an edge it comes in on the
' other side (and jumps instead of gliding)
sub MoveChomper:
  Jump = 0
  K = LastJ & 12
  select case K
    case 4
      if PX = 0 then
        PX = FW - 1
        Jump = 1
      else
        dec PX
      end if
    case 8
      if PX = FW - 1 then
        PX = 0
        Jump = 1
      else
        inc PX
      end if
  end select
  K = LastJ & 3
  select case K
    case 1
      if PY = 0 then
        PY = FH - 1
        Jump = 1
      else
        dec PY
      end if
    case 2
      if PY = FH - 1 then
        PY = 0
        Jump = 1
      else
        inc PY
      end if
  end select
  ' a jump in one direction makes the whole step a jump
  if Jump = 1 then
    OPX = PX
    OPY = PY
  end if
  return
end sub

' what the chomper finds on its new cell
sub Eat:
  Ate = 0
  if DroidAt(PX, PY) < MaxDroid then
    Over = 1
    return
  end if
  V = CellAt(PX, PY)
  select case V
    case TGem0 to TGem2
      Score = Score + 150
      ScB += 150
      Ate = 1
      play sound SndGem
      if Score >= WinScore then Over = 3
    case TJinx
      if Score < 450 then
        Score = 0
        ScB = 0
      else
        Score = Score - 450
        ScB -= 450
      end if
      play sound SndJinx
  end select
  if V <> TFloor then SetCell(PX, PY, TFloor)
  if ScB > Hi then Hi = ScB
  return
end sub

' the clock: one off every 9 step ticks; past 0 the game ends
sub TimeTick:
  dec TCnt
  if TCnt = 0 then
    TCnt = 9
    if TimeU = 0 then
      if Over = 0 then Over = 2
    else
      dec TimeU
    end if
  end if
  return
end sub

' every 3000 points: extra time (45, 40, ... 5, then none) and *EX* + 1
sub CheckBonus:
  if Score < Thr then return
  inc Ex
  Thr = Thr + BonusStep
  TimeU = TimeU + Bonus
  if Bonus > 0 then
    Bonus = Bonus - 5
    play sound SndBonus
  end if
  return
end sub

' 70 gems and jinxes on random cells, over whatever was there; 27 clock
' ticks (3 off the clock)
sub Scatter:
  for Sc = 1 to 70
    Rand
    W16 = Rs & 255
    W16 = W16 * FW
    Cx = W16 >> 8
    R16 = Rs >> 8
    R16 = R16 * FH
    Cy = R16 >> 8
    Rand
    Hb = Rs >> 8
    if Hb >= 128 then
      Tl = GemPal[Rs & 3]
    else
      Tl = TJinx
    end if
    SetCell(Cx, Cy, Tl)
  next
  for Tt = 1 to 27
    TimeTick
  next
  return
end sub

' each droid, by chance, a cell toward the chomper (straight or
' diagonal), never into another droid, eating what it walks over
sub MoveDroids:
  u8 Lim = 0
  Lim = ND - 1
  for Dn = 0 to Lim
    Tx = Dr[Dn].X
    Ty = Dr[Dn].Y
    Dr[Dn].OX = Tx
    Dr[Dn].OY = Ty
    Rand
    V = Rs & 255
    if V >= SpdThr then
      if Tx < PX then inc Tx
      if Tx > PX then dec Tx
      if Ty < PY then inc Ty
      if Ty > PY then dec Ty
      if DroidAt(Tx, Ty) = MaxDroid then
        SetCell(Dr[Dn].X, Dr[Dn].Y, TFloor)
        Dr[Dn].X = Tx
        Dr[Dn].Y = Ty
        if Tx = PX and Ty = PY then
          Over = 1
        else
          SetCell(Tx, Ty, TFloor)
        end if
      end if
    end if
  next
  return
end sub

' the droid standing on a cell, or MaxDroid for none
function DroidAt(u8 Ax, u8 Ay) as u8
  u8 I = 0
  u8 Found = MaxDroid
  while I < ND
    if Dr[I].X = Ax and Dr[I].Y = Ay then Found = I
    inc I
  end while
  return Found

function CellAt(u8 Ax, u8 Ay) as u8
  u8 Cv = 0
  Cv = get char at Ax + 2, Ay + 3
  return Cv

sub SetCell(u8 Ax, u8 Ay, u8 Tv)
  put char Tv at Ax + 2, Ay + 3
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing: sprite 0-1 the chomper (teeth, head), 2-8 the droids
function GlideX(u8 Fr, u8 Tw) as u8
  u8 Gp = 0
  Gp = Fr * 8 + 15
  if Tw > Fr then Gp = Gp + GlideT[Phase]
  if Tw < Fr then Gp = Gp - GlideT[Phase]
  return Gp

sub DrawSprites:
  X = GlideX(OPX, PX)
  Y = GlideX(OPY, PY) + 15
  K = SOpenT
  if Ate = 1 then K = SShutT
  set sprite 0 to Y,X,K,15
  set sprite 1 to Y,X,K + 4,3
  inc Walk
  if Walk >= 20 then Walk = 0
  K = SDr0
  if Walk >= 10 then K = SDr1
  for Ds = 0 to 6
    J = Ds + 2
    if Ds < ND then
      X = GlideX(Dr[Ds].OX, Dr[Ds].X)
      Y = GlideX(Dr[Ds].OY, Dr[Ds].Y) + 15
      set sprite J to Y,X,K,14
    else
      set sprite J to 192,0,0,0
    end if
  next
  update sprites
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE ", ScB
  NumU = TimeU
  print at 15,1, "TIME ", digits$(NumU, 3)
  NumU = Ex
  print at 24,1, "EX ", digits$(NumU, 2)
  return
end sub

sub NewGame:
  NewScreen
  fill TEdge count FW at 2,2
  fill TEdgeb count FW at 2,23
  for Tt = 3 to 22
    fill TFloor count FW at 2,Tt
  next
  Score = 0
  ScB = 0
  Thr = BonusStep
  TimeU = 48
  TCnt = 9
  Bonus = 45
  Ex = 0
  Over = 0
  Phase = 0
  FireReq = 0
  Ate = 0
  TurnN = 0
  PX = 13
  PY = 7
  OPX = PX
  OPY = PY
  SpdThr = 210
  if Hard = 1 then SpdThr = 160
  PlaceDroids
  Scatter
  SetCell(PX, PY, TFloor)
  ShowHud
  Phase = 4
  DrawSprites
  Phase = 0
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' the droids on distinct random cells in the bottom eight rows
sub PlaceDroids:
  for Dn = 0 to 6
    Dr[Dn].X = 255
    Dr[Dn].Y = 255
  next
  Dn = 0
  while Dn < ND
    Rand
    Cx = Rs % FW
    Hb = Rs >> 8
    Cy = Hb & 7
    Cy = Cy + 12
    if DroidAt(Cx, Cy) = MaxDroid then
      Dr[Dn].X = Cx
      Dr[Dn].Y = Cy
      Dr[Dn].OX = Cx
      Dr[Dn].OY = Cy
      inc Dn
    end if
  end while
  return
end sub

sub EndMessage:
  mute all
  select case Over
    case 1
      play sound SndCrash
    case 2
      play sound SndTimeUp
    case 3
      play sound SndWin
  end select
  print at 6,9, "                  "
  if Over = 3 then
    print at 6,10, " YOU ARE ONE OF   "
    print at 6,11, " THE FEW TO WIN   "
    print at 6,12, " AT CHOMPER!      "
  else
    print at 6,10, "                  "
    print at 6,11, "    GAME  OVER    "
    if Over = 1 then
      print at 6,12, " A DROID GOT YOU  "
    else
      print at 6,12, "  OUT OF TIME     "
    end if
  end if
  print at 6,13, "                  "
  print at 6,14, " HI SCORE ", Hi, " "
  print at 6,15, "                  "
  return
end sub

' ---------------------------------------------------------------------------
sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J1 = J1 | 1
  if joypad(2).down then J1 = J1 | 2
  if joypad(2).left then J1 = J1 | 4
  if joypad(2).right then J1 = J1 | 8
  if joypad(2).fire then J1 = J1 | 16
  Btn = J1 & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  for J = 0 to 8
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: CHOMPER in teeth blocks, a menu (droids, speed, start,
' credits), the best score, the tune once
sub TitlePage:
  NewScreen
  print at 6,2, "COMPUTE!'S GAZETTE"
  print at 10,3, "JANUARY 1985"
  copy TitleMap count 160 to vram.name + 160
  print at 5,12, "EAT THE GEMS, DODGE"
  print at 5,13, "THE JINXES AND DROIDS"
  ShowMenu
  if Hi > 0 then
    print at 9,22, "HI ", Hi
  end if
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 488
  TzOn = 1
  Menu = 2
  ShowMenu
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc Rs
  ReadPad
  V = J1 & 15
  if V > 0 then
    if WasStick = 0 then MenuKey
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  if Menu < 2 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 3 then CreditsPage
  return
end sub

' the stick on the title: up/down a line, left/right a setting
sub MenuKey:
  select case V
    case 1
      if Menu > 0 then dec Menu
    case 2
      if Menu < 3 then inc Menu
    case 4
      if Menu = 0 then
        dec ND
        if ND = 0 then ND = MaxDroid
      end if
      if Menu = 1 then Hard = Hard ^ 1
    case 8
      if Menu = 0 then
        inc ND
        if ND > MaxDroid then ND = 1
      end if
      if Menu = 1 then Hard = Hard ^ 1
  end select
  ShowMenu
  return
end sub

sub ShowMenu:
  NumU = ND
  print at 10,15, "DROIDS  ", digits$(NumU, 1)
  if Hard = 1 then
    print at 10,16, "SPEED   HARD"
  else
    print at 10,16, "SPEED   EASY"
  end if
  print at 10,17, "START"
  print at 10,18, "CREDITS"
  for J = 15 to 18
    put char 32 at 8,J
  next
  J = Menu + 15
  put char 62 at 8,J
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 12,2, "CHOMPER"
  print at 2,5, "BASED ON CHOMPER,"
  print at 2,6, "COMPUTE!'S GAZETTE"
  print at 2,7, "JANUARY 1985 (COMMODORE 64"
  print at 2,8, "MACHINE LANGUAGE, VIC-20"
  print at 2,9, "BASIC)."
  print at 2,12, "COLECOVISION GAME, MUSIC"
  print at 2,13, "AND PICTURES BY CLAUDE"
  print at 2,14, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,15, "IN AMY BY AMY BIENVENU,"
  print at 2,16, "2026."
  print at 2,18, "MUSIC: MUNCH TIME"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

asm {
ChGem:
    db $40,$55,$20,$02,$40,$40,$20,$02,$40,$35,$40,$02,$50
ChJinx:
