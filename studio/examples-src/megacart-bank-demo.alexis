' Complete fixed-bank Amy program for the MegaCart example.
bank rom 128
u8 BankBuffer[8]

text screen
print at 6,5, "AMY MEGACART DEMO"

' Every cross-bank operation names the logical bank and an explicit export.
call bank 2, Bank2Setup
copy Bank2Data from bank 2 count 8 to vram.name + 273
decompress mdkrle Bank2Compressed from bank 2 to vram.name + 305
copy Bank2Data from bank 2 count 8 to BankBuffer

print at 3,8, "BANK 2 RAW:"
print at 3,9, "BANK 2 RLE:"
print at 3,17, "ROM DATA ALSO COPIED TO RAM"
screen on
