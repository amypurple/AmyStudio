' define DACMAN_DEBUG_SKIP_TITLE
' define DACMAN_DEBUG_NO_LIFE_LOSS
' define DACMAN_DEBUG_START_LEVEL_5
' define DACMAN_DEBUG_START_MEDAL_1
'define DACMAN_DEBUG_TRIGGER_END_SCENE
' define DACMAN_DEBUG_DACPONG_DIRECT

project "DacMan 2"
cartridge "DACMAN 2/AMY STUDIO/2026"
memory "colecovision_legacy_sdcc"

' DacMan 2 puzzle engine based on NewColeco's Dacman and the 2020 level editor.
' Original source: old-projects-sdcc-z80/sdcctest/dacman/
' Goal: native Amy logic, with legacy BIOS sound data kept as data labels until
' Amy gains a first-class syntax for BIOS sound tables.

picture DacmanTitlePicture:
  pattern from "@project/dacman2-title.pattern.zx0" codec zx0
  color from "@project/dacman2-title.color.zx0" codec zx0
end picture

asset DacmanGameColorRle from "@project/dacman-game.color.zx0" codec zx0
asset DacmanTileset from "@project/dacman2-tileset.pattern.bin" codec raw
asset DacmanNumbers from "@project/dacman-numbers.bin" codec raw
asset DacmanFont from "@project/dacman-font.bin" codec raw
asset DacmanDieze from "@project/dacman-dieze.bin" codec raw
asset DacmanEtoile from "@project/dacman-etoile.bin" codec raw
asset DacmanMissSprites from "@project/dacman-mssprites.bin" codec raw
asset Dacman2Level1 from "@project/dacman2-level1.name.zx0" codec zx0
asset Dacman2Level2 from "@project/dacman2-level2.name.zx0" codec zx0
asset Dacman2Level3 from "@project/dacman2-level3.name.zx0" codec zx0
asset Dacman2Level4 from "@project/dacman2-level4.name.zx0" codec zx0

const BoardLeft = 6
const BoardTop = 2
const BoardWidth = 19
const BoardHeight = 21
const WallMask = $80
const DotTile = $A0
const PowerDotTile = $A1
const PacRightTile = $A2
const PacDownTile = $A3
const PacLeftTile = $A4
const PacUpTile = $A5
const PacClosedTile = $A6
const Ghost0Tile = $AB
const Ghost1Tile = $AC
const Ghost2Tile = $AD
const BlueGhostTile = $AE
const GhostHomeTile = $AF
const BarrierTile = $70
const LockTile = $71
const TeleporterTile = $72
const KeyTile = $73
const FruitTile = $74
const ImmuneGhostTile = $75
const MaxTeleporters = 16

u16 Score = 0
u16 Hiscore = 0
u16 Dots = 0
u16 NextLife = 1000
u8 PacLifes = 3
u8 Level = 0
u8 Playing = 0
u8 Flashing = 0
u8 EasyMode = 0
u8 BonusGame = 0
u8 Difficulty = 2
u8 BaseMoveDelay = 9
u8 BlueDuration = 210
u8 BlueTickPhase = 0
u8 BlueExpired = 0
u8 PacMoveTimer = 1
u8 PacAteDot = 0
u8 GhostMoveTimer[3]
u8 GhostImmune[3]
u8 PacUnderTile = 32
u8 Keys = 0
u8 TeleporterCount = 0
u8 TeleporterX[16]
u8 TeleporterY[16]
u8 TeleporterIndex = 0
u8 MenuPad = 0
u8 MenuLastPad = 0
u8 NoLevel = 0
u8 NbpacLifes = 2
u16 Bonus = 20

u8 Gd[3]
u8 Gx[3]
u8 Gy[3]
u8 Ogx[3]
u8 Ogy[3]
u8 Gc[3]
u8 Gt[3]
u8 PacX = 0
u8 PacY = 0

u8 X = 0
u8 Y = 0
u8 I = 0
u8 G = 0
u8 C = 0
u8 Tmp = 0
u8 Tmp2 = 0
u8 Wall = 0
u8 Nd = 0
u8 Number = 0
u8 Ok = 4
u8 Cpac = 0
u8 Ncpac = 0
u8 Px = 0
u8 Py = 0
u8 Opx = 0
u8 Opy = 0
u8 Dpx = 0
u8 Dpy = 0
u8 Ndpx = 0
u8 Ndpy = 0
u8 MaxGt = 0
u16 DataPtr = 0
u16 RowPtr = 0
u16 WaitCount = 0
u8 RowIndex = 0
u8 LifeIndex = 0


data DacmanBlueDurations bytes = 240,210,180,150

data DacmanG0 bytes
  $00,$01,$02,$FD,$04,$FB,$FA,$F9,$08,$F7,$F6,$F5,$F4,$F3,$F2,$F1
end data

data DacmanG1 bytes
  $00,$01,$02,$01,$04,$01,$02,$FD,$08,$01,$F6,$01,$08,$F7,$F6,$F5
end data

data DacmanG2 bytes
  $00,$01,$02,$02,$04,$FB,$02,$02,$08,$01,$02,$FD,$04,$FB,$FA,$F9
end data

data DacmanG4 bytes
  $00,$01,$02,$02,$04,$04,$04,$FA,$08,$08,$F6,$F6,$04,$F4,$04,$F2
end data

data DacmanG8 bytes
  $00,$01,$02,$01,$04,$FB,$04,$FB,$08,$08,$08,$F7,$08,$08,$F4,$F3
end data

data DacmanDx bytes
  $00,$01,$00,$00,$FF,$00,$00,$00,$00
end data

data DacmanDy bytes
  $00,$00,$01,$00,$00,$00,$00,$00,$FF
end data

