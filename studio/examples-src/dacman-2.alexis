data DacmanBoards words = @Dacman_board_vide,@Dacman_again

sub start:
  mode 2 screen
  sprites 16x16
  sprites simple
  set sound table DacmanSoundTable areas 4
  DacmanInitGraphics
DacmanMainMenu:
  DacmanShowTitle
  DacmanSelectDifficulty
  DacmanGame
  goto DacmanMainMenu
end sub

sub DacmanInitGraphics:
  screen off
  nmi off
  mode 2 screen
  cls
  copy DacmanNumbers count 80 to vram.pattern + 48 * 8
  copy DacmanFont count 224 to vram.pattern + 65 * 8
  copy DacmanDieze count 8 to vram.pattern + 35 * 8
  copy DacmanEtoile count 8 to vram.pattern + 42 * 8
  copy DacmanTileset count 800 to vram.pattern + BarrierTile * 8
  duplicate mode 2 patterns
  decompress DacmanGameColorRle to vram.color
  Dacman2LoadObjectColors
  copy DacmanMissSprites count 64 to vram.spr_pat
  backdrop black
  screen on
  nmi on
  return

sub Dacman2LoadObjectColors:
  for C = 0 to 2
    fill $71 count 8 to vram.color + C * $0800 + BarrierTile * 8
    fill $91 count 8 to vram.color + C * $0800 + LockTile * 8
    fill $71 count 8 to vram.color + C * $0800 + TeleporterTile * 8
    fill $A1 count 8 to vram.color + C * $0800 + KeyTile * 8
    fill $D1 count 8 to vram.color + C * $0800 + FruitTile * 8
    fill $81 count 8 to vram.color + C * $0800 + ImmuneGhostTile * 8
  next
  return

sub DacmanShowTitle:
DacmanTitleCycle:
  show picture DacmanTitlePicture
  screen on
  nmi on
  play sound 10
  WaitCount = 700
DacmanTitleWait:
  if joypad(1).button1 then goto DacmanTitleDone
  if WaitCount = 0 then goto DacmanTitleCycle
  wait
  WaitCount -= 1
  goto DacmanTitleWait

DacmanTitleDone:
  screen off
  DacmanInitGraphics
  return

sub DacmanSelectDifficulty:
  Difficulty = 2
  MenuLastPad = 0
  cls
  print centered at 3, "SELECT SKILL"
  print at 11,8, "1 EASY"
  print at 11,11, "2 NORMAL"
  print at 11,14, "3 HARD"
  print at 11,17, "4 EXPERT"
  print centered at 21, "UP/DOWN AND FIRE"
  DacmanDrawDifficulty
DacmanDifficultyLoop:
  wait
  MenuPad = joypad(1)
  if joypad(1).up then
    if MenuLastPad = 0 then
      if Difficulty > 1 then Difficulty -= 1
      MenuLastPad = 1
      DacmanDrawDifficulty
    end if
  elseif joypad(1).down then
    if MenuLastPad = 0 then
      if Difficulty < 4 then Difficulty += 1
      MenuLastPad = 1
      DacmanDrawDifficulty
    end if
  elseif joypad(1).fire then
    BaseMoveDelay = 9 - Difficulty
    BlueDuration = DacmanBlueDurations[Difficulty - 1]
    wait no fire
    return
  end if
  if MenuPad = 0 then MenuLastPad = 0 else MenuLastPad = 1
  goto DacmanDifficultyLoop

sub DacmanDrawDifficulty:
  for I = 1 to 4
    if I = Difficulty then
      put char $2A at 9,5 + I * 3
    else
      put char $20 at 9,5 + I * 3
    end if
  next
  return

sub DacmanGame:
DacmanRestartGame:
  cls
  Score = 0
  Level = NoLevel
ifdef DACMAN_DEBUG_START_LEVEL_5
  Level = 5
end ifdef
  if EasyMode != 0 then
    PacLifes = 29
  else
    PacLifes = NbpacLifes
  end if
  NextLife = 1000
  print centered at 0, "HIGH SCORE"
  print at 1,22, "SCORE"
  DacmanPutHiscore
  DacmanAddScore0
  DacmanPutLives
DacmanNewBoard:
  DacmanPutBoard
  DacmanInitLevel
  DacmanDrawStatus
DacmanContinueLevel:
  DacmanCountDots
  play sound 1
  play sound 2
  WaitCount = 318
  DacmanWaitGameplayFrames
  DacmanPacmanPlay
  stop sound 3
  stop sound 4
  if Ok = 15 then goto DacmanLevelClear
  DacmanPacmanDead
ifdef DACMAN_DEBUG_NO_LIFE_LOSS
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
else ifdef
  if PacLifes = 0 then goto DacmanGameOver
  PacLifes -= 1
  DacmanPutLives
  DacmanRestartActorsAfterDeath
  goto DacmanContinueLevel
end ifdef
DacmanLevelClear:
  DacmanFlashBoardClear
  Level += 1
  goto DacmanNewBoard
DacmanGameOver:
  mute all
  Playing = 1
  print at 11,11, "GAME OVER"
  Score = 0
  WaitCount = 0
DacmanGameOverWait:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  if WaitCount = 450 then goto DacmanGameOverAgainBoard
  wait
  DacmanVblank
  WaitCount += 1
  goto DacmanGameOverWait
DacmanGameOverAgainBoard:
  DacmanDrawBoardAgain
  WaitCount = 0
DacmanAgainLoop:
  if keypad(1) = 10 then goto DacmanRestartGame
  if keypad(1) = 11 then return
  WaitCount += 1
  if WaitCount = 12 then
    put char PacClosedTile at 9,16
  end if
  if WaitCount = 24 then
    put char PacRightTile at 9,16
    WaitCount = 0
  end if
  wait
  DacmanVblank
  wait
  DacmanVblank
  goto DacmanAgainLoop
end sub

sub DacmanDrawStatus:
  Tmp = Level + 1
  print at 19,23, "LV"
  print Tmp at 22,23 digits 2
  print at 25,23, "KEY"
  print Keys at 29,23 digits 2
  return

sub DacmanPutHiscore:
  print Hiscore at 13,1 digits 5
  put char 48 at 18,1
  return

sub DacmanAddScore0:
  DacmanAddScore
  return

sub DacmanAddScore:
  Score += Tmp
  print Score at 1,23 digits 5
  put char 48 at 6,23
  if Hiscore < Score then
    Hiscore = Score
    DacmanPutHiscore
  end if
  if NextLife > 0 then
    if Score >= NextLife then
      PacLifes += 1
      play sound 9
      DacmanPutLives
      if NextLife > 8000 then NextLife = 0 else NextLife = NextLife * 2
    end if
  end if
  Tmp = 0
  return

sub DacmanPutLives:
  Tmp = PacLifes
  if Tmp > 6 then Tmp = 6
  for LifeIndex = 0 to 6
    put char 32 at 7 + LifeIndex,23
  next
  if Tmp = 0 then return
  for LifeIndex = 0 to Tmp - 1
    put char PacLeftTile at 7 + LifeIndex,23
  next
  return

sub DacmanPutBoard:
  Tmp = Level & 3
  DacmanDrawBoard
  return


sub DacmanDrawBoard:
  select case Tmp
  case 0
    decompress zx0 Dacman2Level1 to vram.name
  case 1
    decompress zx0 Dacman2Level2 to vram.name
  case 2
    decompress zx0 Dacman2Level3 to vram.name
  case 3
    decompress zx0 Dacman2Level4 to vram.name
  case 4
    put DacmanBoards[0] frame size BoardWidth,BoardHeight at BoardLeft,BoardTop
  case else
    put DacmanBoards[1] frame size BoardWidth,BoardHeight at BoardLeft,BoardTop
  end select
  return

sub DacmanDrawBoardVide:
  Tmp = 4
  DacmanDrawBoard
  return

sub DacmanDrawBoardAgain:
  Tmp = 5
  DacmanDrawBoard
  return
sub DacmanInitLevel:
  Playing = 0
  Keys = 0
  TeleporterCount = 0
  PacUnderTile = 32
  clear sprites
  set sprite count 1
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = TeleporterTile then
        if TeleporterCount < MaxTeleporters then
          TeleporterX[TeleporterCount] = X
          TeleporterY[TeleporterCount] = Y
          TeleporterCount += 1
        end if
      end if
      if C = Ghost0Tile then
        Gd[0] = 0
        Gx[0] = X
        Gy[0] = Y
        Ogx[0] = X
        Ogy[0] = Y
        Gc[0] = 32
        Gt[0] = 0
        GhostMoveTimer[0] = 1
        GhostImmune[0] = 0
      end if
      if C = Ghost1Tile then
        Gd[1] = 0
        Gx[1] = X
        Gy[1] = Y
        Ogx[1] = X
        Ogy[1] = Y
        Gc[1] = 32
        Gt[1] = 0
        GhostMoveTimer[1] = 1
        GhostImmune[1] = 0
      end if
      if C = Ghost2Tile then
        Gd[2] = 0
        Gx[2] = X
        Gy[2] = Y
        Ogx[2] = X
        Ogy[2] = Y
        Gc[2] = 32
        Gt[2] = 0
        GhostMoveTimer[2] = 1
        GhostImmune[2] = 0
      end if
      if C >= PacRightTile then
        if C <= PacClosedTile then
          PacX = X
          PacY = Y
        end if
      end if
    next
  next
  Playing = 1
  return

sub DacmanCountDots:
  Playing = 0
  nmi off
  Dots = 0
  for X = 6 to 24
    for Y = 2 to 22
      C = get char at X,Y
      if C = DotTile then Dots += 1
      if C = PowerDotTile then Dots += 1
    next
  next
  nmi on
  Playing = 1
  return


sub DacmanWaitGameplayFrames:
DacmanWaitGameplayLoop:
  if WaitCount = 0 then return
  wait
  DacmanVblank
  WaitCount -= 1
  goto DacmanWaitGameplayLoop
end sub
sub DacmanRestartActorsAfterDeath:
  WaitCount = 16
  DacmanWaitGameplayFrames
  for G = 0 to 2
    C = Gc[G]
    if C = DotTile then
      put char C at Gx[G],Gy[G]
    else
      if C = PowerDotTile then
        put char C at Gx[G],Gy[G]
      else
        if (C & $F0) = $B0 then
          put char C at Gx[G],Gy[G]
        else
          if C = WallMask then
            put char C at Gx[G],Gy[G]
          else
            put char 32 at Gx[G],Gy[G]
          end if
        end if
      end if
    end if
    Gx[G] = Ogx[G]
    Gy[G] = Ogy[G]
    Gc[G] = 32
    Gt[G] = 0
  next
  for G = 0 to 2
    put char Ghost0Tile + G at Gx[G],Gy[G]
  next
  put char PacLeftTile at PacX,PacY
  return

sub DacmanPacmanPlay:
  Px = PacX
  Py = PacY
  Cpac = PacLeftTile
  Dpx = 2
  Dpy = 0
  play sound 3
  PacMoveTimer = 1
  GhostMoveTimer[0] = 1
  GhostMoveTimer[1] = 1
  GhostMoveTimer[2] = 1
  Ok = 4
  if Dots = 0 then Ok = 15
DacmanPlayLoop:
  wait
  DacmanVblank
  if Ok != 4 then return
  if Dots = 0 then Ok = 15
  if Ok != 4 then return
  if keypad(1) = 10 then
    goto DacmanPauseLoop
  end if
  if keypad(1) = 5 then
    goto DacmanBuyLife
  end if
  C = joypad(1) & $0F
  Ndpx = 0
  Ndpy = 0
  if C & $01 then Ndpy = 2
  if C & $04 then Ndpy = 1
  if C & $02 then Ndpx = 1
  if C & $08 then Ndpx = 2
  if PacMoveTimer > 0 then PacMoveTimer -= 1
  if PacMoveTimer = 0 then
    DacmanChoosePacDirection
    put char Cpac at Px,Py
    DacmanMovePac
    PacMoveTimer = BaseMoveDelay - 2
    if PacAteDot != 0 then PacMoveTimer = BaseMoveDelay
  end if
  DacmanUpdateGhosts
  if Dots = 0 then Ok = 15
  goto DacmanPlayLoop
DacmanPauseLoop:
  wait no fire
DacmanPauseWait:
  if keypad(1) = 10 then goto DacmanPlayLoop
  wait
  goto DacmanPauseWait
DacmanBuyLife:
  if Score >= 2000 then
    Score -= 2000
    Tmp = 0
    DacmanAddScore
    PacLifes += 1
    play sound 9
    DacmanPutLives
  end if
  goto DacmanPlayLoop
end sub

sub DacmanChoosePacDirection:
  if Ndpx = 0 then
    if Ndpy = 0 then return
  end if
  Opx = Px
  Opy = Py
  if Ndpx = 1 then Opx += 1
  if Ndpx = 2 then Opx -= 1
  if Ndpx != 0 then
    DacmanWrapOpx
    C = get char at Opx,Opy
    if (C & $F0) = WallMask then Ndpx = 0
    if C = BarrierTile then Ndpx = 0
    if C = LockTile then
      if Keys = 0 then Ndpx = 0
    end if
  end if
  Opx = Px
  Opy = Py
  if Ndpy = 1 then Opy += 1
  if Ndpy = 2 then Opy -= 1
  if Ndpy != 0 then
    DacmanWrapOpy
    C = get char at Opx,Opy
    if (C & $F0) = WallMask then Ndpy = 0
    if C = BarrierTile then Ndpy = 0
    if C = LockTile then
      if Keys = 0 then Ndpy = 0
    end if
  end if
  if Ndpx = 0 then
    if Ndpy != 0 then
      Dpx = 0
      Dpy = Ndpy
      return
    end if
  end if
  if Ndpy = 0 then
    if Ndpx != 0 then
      Dpx = Ndpx
      Dpy = 0
      return
    end if
  end if
  if Ndpx = Dpx then
    Dpx = 0
    Dpy = Ndpy
    return
  end if
  if Ndpy = Dpy then
    Dpx = Ndpx
    Dpy = 0
    return
  end if
  if Dpx = 0 then
    if Dpy = 0 then
      Number = random(0,1)
      if Number = 0 then
        Dpx = Ndpx
        Dpy = 0
      else
        Dpy = Ndpy
        Dpx = 0
      end if
      return
    end if
  end if
  if Dpx != 0 then Dpx = 3 - Dpx
  if Dpy != 0 then Dpy = 3 - Dpy
  return

sub DacmanMovePac:
  PacAteDot = 0
  Ncpac = PacClosedTile
  Opx = Px
  if Dpx = 1 then
    Opx += 1
    Ncpac = PacRightTile
  end if
  if Dpx = 2 then
    Opx -= 1
    Ncpac = PacLeftTile
  end if
  DacmanWrapOpx
  Opy = Py
  if Dpy = 1 then
    Opy += 1
    Ncpac = PacDownTile
  end if
  if Dpy = 2 then
    Opy -= 1
    Ncpac = PacUpTile
  end if
  DacmanWrapOpy
  C = get char at Opx,Opy
  if (C & $F0) = WallMask then
    Dpx = 0
    Dpy = 0
    return
  end if
  if C = BarrierTile then return
  if C = LockTile then
    if Keys = 0 then return
  end if
  if Dpx = 0 then
    if Dpy = 0 then return
  end if
  put char PacUnderTile at Px,Py
  Px = Opx
  Py = Opy
  if Cpac = Ncpac then Cpac = PacClosedTile else Cpac = Ncpac
  Tmp2 = 0
  if C > Ghost0Tile - 1 then
    if C < BlueGhostTile then
      Ok = C - Ghost0Tile
      Tmp2 = Ok + 1
      C = Gc[Ok]
    end if
  end if
  if C = BlueGhostTile then
    DacmanWhichGhost
    Tmp2 = G + 1
    Number = Gc[G]
    DacmanGhostHome
    C = Number
  end if
  if C = ImmuneGhostTile then
    DacmanWhichGhost
    Ok = G
    Tmp2 = G + 1
    C = Gc[G]
  end if
  if C = DotTile then
    Tmp = 1
    DacmanGobDot
    DacmanClearConsumedGhostUnderTile
    C = 32
  end if
  if C = PowerDotTile then
    Tmp = 5
    DacmanGobDot
    DacmanClearConsumedGhostUnderTile
    C = 32
    play sound 4
    if GhostImmune[0] = 0 then Gt[0] = BlueDuration
    if GhostImmune[1] = 0 then Gt[1] = BlueDuration
    if GhostImmune[2] = 0 then Gt[2] = BlueDuration
    Bonus = 20
  end if
  if C = KeyTile then
    Keys += 1
    DacmanDrawStatus
    C = 32
  end if
  if C = LockTile then
    Keys -= 1
    DacmanDrawStatus
    C = 32
  end if
  if C = FruitTile then
    Tmp = 10
    DacmanAddScore
    C = 32
    play sound 7
  end if
  if (C & $F0) = $B0 then
    Tmp = Level + 1
    Tmp *= 10
    DacmanAddScore
    DacmanClearConsumedGhostUnderTile
    C = 32
    play sound 7
  end if
  if C = TeleporterTile then DacmanUseTeleporter
  PacUnderTile = C
  put char Cpac at Px,Py
  return

sub DacmanUseTeleporter:
  if TeleporterCount < 2 then return
  TeleporterIndex = 0
DacmanFindTeleporter:
  if TeleporterX[TeleporterIndex] = Px then
    if TeleporterY[TeleporterIndex] = Py then goto DacmanTeleportFound
  end if
  TeleporterIndex += 1
  if TeleporterIndex < TeleporterCount then goto DacmanFindTeleporter
  return
DacmanTeleportFound:
  if Dpx = 1 then goto DacmanTeleportNext
  if Dpy = 1 then goto DacmanTeleportNext
  if TeleporterIndex = 0 then TeleporterIndex = TeleporterCount else TeleporterIndex -= 1
  goto DacmanTeleportMove
DacmanTeleportNext:
  TeleporterIndex += 1
  if TeleporterIndex >= TeleporterCount then TeleporterIndex = 0
DacmanTeleportMove:
  Px = TeleporterX[TeleporterIndex]
  Py = TeleporterY[TeleporterIndex]
  C = TeleporterTile
  return

sub DacmanClearConsumedGhostUnderTile:
  if Tmp2 = 0 then return
  I = Tmp2 - 1
  Gc[I] = 32
  return

sub DacmanUpdateGhosts:
  if BlueTickPhase = 0 then BlueTickPhase = 1 else BlueTickPhase = 0
  BlueExpired = 0
  for G = 0 to 2
    if BlueTickPhase = 0 then
      if Gt[G] > 0 then
        Gt[G] -= 1
        if Gt[G] = 0 then BlueExpired = 1
      end if
    end if
    if GhostMoveTimer[G] > 0 then GhostMoveTimer[G] -= 1
    if GhostMoveTimer[G] = 0 then
      DacmanMoveOneGhost
      DacmanReloadGhostTimer
    end if
  next
  if BlueExpired != 0 then
    if Gt[0] = 0 then
      if Gt[1] = 0 then
        if Gt[2] = 0 then
          play sound 3
        end if
      end if
    end if
  end if
  return

sub DacmanReloadGhostTimer:
  if GhostImmune[G] != 0 then
    GhostMoveTimer[G] = BaseMoveDelay - 2
  else
    if Gt[G] > 0 then
      GhostMoveTimer[G] = BaseMoveDelay + 1
    else
      GhostMoveTimer[G] = BaseMoveDelay - 1
    end if
  end if
  return

sub DacmanMoveOneGhost:
    Wall = $0F
    X = Gx[G] + 1
    Y = Gy[G]
    if X > 24 then X = 6
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 1
    if (C & $F8) = $A8 then Wall -= 1
    if C = LockTile then Wall -= 1
    if C = TeleporterTile then Wall -= 1
    X = Gx[G]
    Y = Gy[G] + 1
    if Y > 22 then Y = 2
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 2
    if (C & $F8) = $A8 then Wall -= 2
    if C = LockTile then Wall -= 2
    if C = TeleporterTile then Wall -= 2
    X = Gx[G] - 1
    Y = Gy[G]
    if X < 6 then X = 24
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 4
    if (C & $F8) = $A8 then Wall -= 4
    if C = LockTile then Wall -= 4
    if C = TeleporterTile then Wall -= 4
    X = Gx[G]
    Y = Gy[G] - 1
    if Y < 2 then Y = 22
    C = get char at X,Y
    if (C & $F0) = WallMask then Wall -= 8
    if (C & $F8) = $A8 then Wall -= 8
    if C = LockTile then Wall -= 8
    if C = TeleporterTile then Wall -= 8
    if C = $80 then Wall += 8
    DacmanChooseGhostDirection
    put char Gc[G] at Gx[G],Gy[G]
    Tmp = DacmanDx[Nd]
    if Tmp = 255 then Gx[G] -= 1 else Gx[G] += Tmp
    if Gx[G] < 6 then Gx[G] = 24
    if Gx[G] > 24 then Gx[G] = 6
    Tmp = DacmanDy[Nd]
    if Tmp = 255 then Gy[G] -= 1 else Gy[G] += Tmp
    if Gy[G] < 2 then Gy[G] = 22
    if Gy[G] > 22 then Gy[G] = 2
    C = get char at Gx[G],Gy[G]
    if C > PacRightTile - 1 then
      if C < PacClosedTile + 1 then
        if Gt[G] > 0 then
          C = 32
          DacmanGhostHome
        else
          Gc[G] = 32
          Ok = G
        end if
      end if
    end if
    if C = FruitTile then
      C = 32
      Gt[G] = 0
      GhostImmune[G] = 1
    end if
    Gc[G] = C
    Gd[G] = Nd
    if Gt[G] > 0 then
      put char BlueGhostTile at Gx[G],Gy[G]
    else
      if GhostImmune[G] != 0 then
        put char ImmuneGhostTile at Gx[G],Gy[G]
      else
        put char Ghost0Tile + G at Gx[G],Gy[G]
      end if
    end if
  return

sub DacmanChooseGhostDirection:
  if Gd[G] = 0 then Nd = DacmanG0[Wall]
  if Gd[G] = 1 then Nd = DacmanG1[Wall]
  if Gd[G] = 2 then Nd = DacmanG2[Wall]
  if Gd[G] = 4 then Nd = DacmanG4[Wall]
  if Gd[G] = 8 then Nd = DacmanG8[Wall]
DacmanGhostChoiceLoop:
  if Nd <= 8 then return
  Wall = 0 - Nd
  Number = random(0,3)
  if Number = 0 then Tmp = Wall & 1
  if Number = 1 then Tmp = Wall & 2
  if Number = 2 then Tmp = Wall & 4
  if Number = 3 then Tmp = Wall & 8
  if Tmp != 0 then Nd = Tmp
  goto DacmanGhostChoiceLoop
end sub

sub DacmanWhichGhost:
  G = 0
DacmanWhichGhostLoop:
  if Gx[G] = Opx then
    if Gy[G] = Opy then return
  end if
  if G = 2 then return
  G += 1
  goto DacmanWhichGhostLoop
end sub

sub DacmanGhostHome:
  Tmp = Bonus
  DacmanAddScore
  play sound 8
  Bonus = Bonus * 2
  put char GhostHomeTile at Gx[G],Gy[G]
  I = G
DacmanGhostHomeLoop:
  C = get char at Ogx[I],Ogy[I]
  if C = 32 then goto DacmanGhostHomeFound
  I += 1
  if I > 2 then I = 0
  goto DacmanGhostHomeLoop
DacmanGhostHomeFound:
  Gx[G] = Ogx[I]
  Gy[G] = Ogy[I]
  Gt[G] = 0
  Gc[G] = 32
  if Gt[0] = 0 then
    if Gt[1] = 0 then
      if Gt[2] = 0 then
        play sound 3
      end if
    end if
  end if
  return

sub DacmanGobDot:
  PacAteDot = 1
  DacmanAddScore
  stop sound 6
  play sound 6
  Dots = Dots - 1
  return

sub DacmanWrapOpx:
  if Opx < 6 then Opx = 24
  if Opx > 24 then Opx = 6
  return

sub DacmanWrapOpy:
  if Opy < 2 then Opy = 22
  if Opy > 22 then Opy = 2
  return

sub DacmanPacmanDead:
  mute all
  play sound 5
  for C = $C0 to $D0
    put char C at Gx[Ok],Gy[Ok]
    wait 2 frames
  next
  for Tmp = 0 to 1
    for C = $D1 to $D3
      put char C at Gx[Ok],Gy[Ok]
      wait 3 frames
    next
  next
  wait 20 frames
  put char Ghost0Tile + Ok at Gx[Ok],Gy[Ok]
  return

sub DacmanFlashBoardClear:
  copy DacmanTileset + 256 count 128 to vram.pattern + 128 * 8
  copy DacmanTileset + 256 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanTileset + 256 count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanTileset + 128 count 128 to vram.pattern + 128 * 8
  copy DacmanTileset + 128 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanTileset + 128 count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanTileset + 256 count 128 to vram.pattern + 128 * 8
  copy DacmanTileset + 256 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanTileset + 256 count 128 to vram.pattern + (512 + 128) * 8
  wait 24 frames
  copy DacmanTileset + 128 count 128 to vram.pattern + 128 * 8
  copy DacmanTileset + 128 count 128 to vram.pattern + (256 + 128) * 8
  copy DacmanTileset + 128 count 128 to vram.pattern + (512 + 128) * 8
  return

sub DacmanVblank:
  if Playing = 0 then return
  Flashing += 1
  if Flashing = 12 then
    fill $F1 count 8 to vram.color + (128 + 33) * 8
    fill $F1 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $F1 count 8 to vram.color + (512 + 128 + 33) * 8
  end if
  if Flashing = 24 then
    fill $11 count 8 to vram.color + (128 + 33) * 8
    fill $11 count 8 to vram.color + (256 + 128 + 33) * 8
    fill $11 count 8 to vram.color + (512 + 128 + 33) * 8
    Flashing = 0
  end if
  MaxGt = 0
  if Gt[0] > MaxGt then MaxGt = Gt[0]
  if Gt[1] > MaxGt then MaxGt = Gt[1]
  if Gt[2] > MaxGt then MaxGt = Gt[2]
  if MaxGt = 0 then goto DacmanGhostNormalColor
  if MaxGt > 36 then goto DacmanGhostNormalColor
  if Flashing < 12 then goto DacmanGhostNormalColor
  goto DacmanGhostFlashColor
DacmanGhostNormalColor:
  fill $41 count 8 to vram.color + (128 + 34 + 9 + 3) * 8
  fill $41 count 8 to vram.color + (256 + 128 + 34 + 9 + 3) * 8
  fill $41 count 8 to vram.color + (512 + 128 + 34 + 9 + 3) * 8
  return
DacmanGhostFlashColor:
  fill $F1 count 8 to vram.color + (128 + 34 + 9 + 3) * 8
  fill $F1 count 8 to vram.color + (256 + 128 + 34 + 9 + 3) * 8
  fill $F1 count 8 to vram.color + (512 + 128 + 34 + 9 + 3) * 8
  return

