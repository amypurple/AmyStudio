  77, 44, 32, 49, 56, 50, 48, 32, 84, 79, 32, 84, 72, 69, 32, 69, 65, 82, 76, 89, 49, 57, 56, 48
  83, 46, 32, 84, 72, 69, 32, 77, 79, 83, 84, 32, 70, 73, 82, 83, 84, 46, 72, 79, 77, 69, 76, 65
  78, 68, 83, 72, 79, 87, 32, 77, 65, 78, 89, 32, 67, 65, 77, 69, 71, 69, 82, 77, 65, 78, 89, 54
  44, 57, 57, 56, 44, 48, 53, 54, 73, 84, 65, 76, 89, 53, 44, 51, 49, 48, 44, 53, 49, 54, 52, 44
  57, 55, 56, 44, 53, 50, 52, 73, 82, 69, 76, 65, 78, 68, 52, 44, 54, 57, 50, 44, 56, 53, 54, 65
  85, 83, 84, 82, 73, 65, 52, 44, 51, 49, 56, 44, 56, 52, 53, 67, 65, 78, 65, 68, 65, 52, 44, 49
  52, 57, 44, 56, 51, 56, 85, 83, 83, 82, 51, 44, 51, 57, 52, 44, 57, 57, 57, 77, 69, 88, 73, 67
  79, 50, 44, 51, 51, 52, 44, 49, 53, 52, 79, 84, 72, 69, 82, 32, 65, 83, 73, 65, 49, 44, 57, 48
  54, 44, 51, 55, 49, 87, 69, 83, 84, 32, 73, 78, 68, 73, 69, 83, 49, 44, 57, 48, 52, 44, 52, 50
  55, 83, 87, 69, 68, 69, 78, 49, 44, 50, 55, 52, 44, 50, 56, 57, 78, 79, 82, 87, 65, 89, 56, 53
  55, 44, 54, 52, 54, 56, 50, 52, 44, 51, 54, 57, 70, 82, 65, 78, 67, 69, 55, 53, 54, 44, 57, 55
  57, 71, 82, 69, 69, 67, 69, 54, 54, 57, 44, 56, 56, 56, 67, 72, 73, 78, 65, 53, 57, 51, 44, 52
  51, 50, 80, 79, 76, 65, 78, 68, 53, 50, 56, 44, 48, 57, 56, 80, 79, 82, 84, 85, 71, 65, 76, 52
  54, 55, 44, 56, 55, 57, 74, 65, 80, 65, 78, 52, 49, 57, 44, 48, 53, 53, 84, 85, 82, 75, 69, 89
  51, 57, 49, 44, 56, 54, 48
end data
const NSpr = 4
const Art0 = 1536
const RowTop = 1
const TitleRow = 21
const FactRow = 22

' per-row colours of the yellow font (light yellow, then dark yellow)
data Grad bytes
  $B4, $B4, $B4, $B4, $B4, $A4, $A4, $A4
end data
' the title chart: tile of the top of each bar, its height
data BarTop bytes
  TTopr, TTopy, TTopg, TTopc, TTopm, TTopr, TTopy, TTopg
end data

u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 SOff = 0
u8 SLen = 0
' the module, the order of its eight lists, the list being played
u8 Mod = 0
u8 SetQ[8]
u8 Qn = 0
u8 Q = 0
' the list: entries, intro lines, index of entry 0's string
u8 NE = 0
u8 NI = 0
u8 EBase = 0
record StrRef:
  u16 Off
  u8 Len
end record
StrRef Ss[50]
' entries still to place (in screen order), how many placed, the cursor
u8 Rem[20]
u8 NR = 0
u8 NA = 0
u8 Cur = 0
' points of each placed entry (255: a wrong pick)
u8 Pts[20]
i16 TP = 0
u16 MaxTP = 0
bcd digits 4 RightN
bcd digits 4 WrongN
' the screen shown, for the test bots: 1 credits, 2 title, 3 intro card,
' 4 list, 5 review, 6 menu, 7 final page
u8 Scr = 0
u8 Act = 0
u8 Sel = 0
' the cursor sprite (pixel row and the row it goes to)
u8 CurY = 0
u8 GoY = 0
u8 MarkY = 208
u8 MarkP = 0
u8 MarkC = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn1 = 0
u8 Btn2 = 0
u8 Was1 = 0
u8 Was2 = 0
u8 Press1 = 0
u8 Press2 = 0
u8 Stick = 0
u8 Hold = 0
u8 Moved = 0
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
u8 Buf[32]
u8 FBuf[64]
' loop counters (never shared with the helpers)
u8 Ri = 0
u8 Ti = 0
u8 Fi = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table MlSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 0
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  MakeFont2
  copy TilePat count NTiles8 to vram.pattern + Art0
  copy TilePat count NTiles8 to vram.pattern + Art0 + 2048
  copy TilePat count NTiles8 to vram.pattern + Art0 + 4096
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Sel = 4 then
    CreditsPage
    goto title
  end if
  Mod = Sel

set_start:
  TP = 0
  MaxTP = 0
  RightN = 0
  WrongN = 0
  ShuffleSet
  Qn = 0

quiz_start:
  Q = Mod * 8
  Q = Q + SetQ[Qn]
  LoadQuiz
  IntroCard
  StartQuiz

quiz_loop:
  Frame1
  ReadPad
  QuizStep
  MoveCursor
  if Act = 0 then goto quiz_loop
  if Act = 2 then
    PauseMenu
    if Sel = 0 then
      DrawQuiz
      Act = 0
      goto quiz_loop
    end if
    if Sel = 1 then goto set_start
    goto title
  end if
  ' the list is done: look at the facts, then the next list
  Review
  inc Qn
  if Qn < 8 then goto quiz_start

  ' the end of the module: the score, then back to the title on a press
  FinalPage
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' random numbers: a 16-bit xorshift

sub Rnd:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

function RandBelow(u8 Lim) as u8
  Rnd
  return (Rs >> 4) % Lim

' the eight lists of the module in a random order
sub ShuffleSet:
  u8 Si = 0
  u8 Sj = 0
  u8 St = 0
  for Si = 0 to 7
    SetQ[Si] = Si
  next
  for Si = 7 to 1 step -1
    Sj = RandBelow(Si + 1)
    St = SetQ[Si]
    SetQ[Si] = SetQ[Sj]
    SetQ[Sj] = St
  next
  return
end sub

' ---------------------------------------------------------------------------
' the quiz data

' the index of list Q: NE, NI and a (offset, length) record per string
sub LoadQuiz:
  u16 Base = 0
  Base = QOff[Q]
  copy QIdx + Base count 2 to Buf
  NE = Buf[0]
  NI = Buf[1]
  EBase = NI + 3
  ' the whole record array (a record-array copy takes a constant count);
  ' the records past the list's 2 x NE + EBase strings are not read
  copy QIdx + Base + 2 count 150 to Ss
  return
end sub

' string K of the list into SOff, SLen
sub StrAt(u8 Sk):
  SOff = Ss[Sk].Off
  SLen = Ss[Sk].Len
  return
end sub

' print string K at X,Y; Hl = 1 in the yellow font
sub PutStr(u8 Sk, u8 Px, u8 Py, u8 Hl):
  u8 Pi = 0
  StrAt(Sk)
  if Hl = 0 then
    put QBlob + SOff count SLen at Px,Py
  else
    copy QBlob + SOff count SLen to Buf
    for Pi = 0 to SLen - 1
      Buf[Pi] = Buf[Pi] + 96
    next
    put Buf count SLen at Px,Py
  end if
  return
end sub

' the yellow copy of the font: characters 32-95 at codes 128-191, in the
' three screen thirds (colours: Grad, set by NewScreen)
sub MakeFont2:
  u16 Src = 0
  u16 Dst = 0
  for Fi = 0 to 7
    Src = Fi * 64
    Src = Src + 256
    copy vram.pattern + Src count 64 to FBuf
    Dst = Fi * 64
    Dst = Dst + 1024
    copy FBuf count 64 to vram.pattern + Dst
    Dst = Dst + 2048
    copy FBuf count 64 to vram.pattern + Dst
    Dst = Dst + 2048
    copy FBuf count 64 to vram.pattern + Dst
  next
  return
end sub

' ---------------------------------------------------------------------------
' a list

sub StartQuiz:
  u8 Si = 0
  u8 Sj = 0
  u8 St = 0
  NA = 0
  NR = NE
  for Si = 0 to NE - 1
    Rem[Si] = Si
    Pts[Si] = 0
  next
  for Si = NE - 1 to 1 step -1
    Sj = RandBelow(Si + 1)
    St = Rem[Si]
    Rem[Si] = Rem[Sj]
    Rem[Sj] = St
  next
  Cur = 0
  Act = 0
  Hold = 0
  ' the best score of this list: (NE - 1) + (NE - 2) + ... + 0
  W16 = NE * (NE - 1)
  W16 = W16 / 2
  MaxTP = MaxTP + W16
  DrawQuiz
  return
end sub

sub DrawQuiz:
  NewScreen
  Scr = 4
  PutStr(0, 2, TitleRow, 1)
  for Ri = 0 to 19
    DrawRow
  next
  ClearFact
  ShowScore
  CurY = Cur + NA
  CurY = CurY + RowTop
  CurY = CurY * 8
  CurY = CurY - 1
  GoY = CurY
  MarkY = 208
  DrawSprites
  ShowScreen
  return
end sub

' one row of the list (Ri): placed entries in yellow with rank and points,
' the others in white
sub DrawRow:
  u8 Ry = 0
  u8 Re = 0
  Ry = Ri + RowTop
  fill 32 count 28 at 2,Ry
  if Ri < NA then
    NumU = Ri + 1
    print at 2,Ry, width$(NumU, 2)
    Re = Ri * 2
    Re = Re + EBase
    PutStr(Re, 5, Ry, 1)
    V = Pts[Ri]
    if V = 255 then
      print at 26,Ry, " -10"
    else
      NumU = V * 10
      ' the plus sign right before the figure
      print at 27,Ry, width$(NumU, 3)
      C = 26
      if NumU < 100 then C = 27
      if NumU < 10 then C = 28
      put char 43 at C,Ry
    end if
  else
    Re = Ri - NA
    if Re < NR then
      Re = Rem[Re] * 2
      Re = Re + EBase
      PutStr(Re, 5, Ry, 0)
    end if
  end if
  return
end sub

sub ClearFact:
  fill 32 count 19 at 2,FactRow
  return
end sub

' the fact of entry Ef on the bottom line
sub ShowFact(u8 Ef):
  u8 Fs = 0
  ClearFact
  Fs = Ef * 2
  Fs = Fs + EBase
  Fs = Fs + 1
  PutStr(Fs, 2, FactRow, 0)
  return
end sub

sub ShowScore:
  i16 Shown = 0
  print at 21,FactRow, "SC"
  Shown = TP * 10
  if Shown < 0 then
    put char 45 at 23,FactRow
    Shown = 0 - Shown
  else
    put char 32 at 23,FactRow
  end if
  NumU = Shown
  print at 24,FactRow, width$(NumU, 5)
  return
end sub

' one frame of a list: the stick moves the cursor, left button picks,
' right button opens the menu
sub QuizStep:
  if Press2 = 1 then
    Act = 2
    return
  end if
  if Moved = 1 then
    if Stick = 1 then
      if Cur = 0 then
        Cur = NR - 1
      else
        dec Cur
      end if
    else
      inc Cur
      if Cur >= NR then Cur = 0
    end if
    play sound SndTick
    SetGoal
  end if
  if Press1 = 1 then Pick
  return
end sub

sub SetGoal:
  GoY = Cur + NA
  GoY = GoY + RowTop
  GoY = GoY * 8
  GoY = GoY - 1
  return
end sub

' the pick: right (Rem[Cur] is entry NA) or wrong
sub Pick:
  u8 Ci = 0
  u8 Pk = 0
  Pk = Rem[Cur]
  if Pk = NA then
    Ci = Cur
    V = NE - 1
    V = V - NA
    Pts[NA] = V
    TP = TP + V
    inc RightN
    play sound SndRight
    Mark(SCheck, 2)
    WaitFrames(30)
  else
    TP = TP - 1
    inc WrongN
    Pts[NA] = 255
    play sound SndWrong
    Mark(SCross, 8)
    ClearFact
    print at 2,FactRow, "SO SORRY..."
    ShowScore
    ' the cursor slides to the right entry
    for Ci = 0 to NR - 1
      if Rem[Ci] = NA then Pk = Ci
    next
    Ci = Pk
    Cur = Ci
    SetGoal
    WaitFrames(70)
  end if
  Place(Ci)
  return
end sub

' a sprite mark on the cursor's row (a check or a cross)
sub Mark(u8 Mp, u8 Mc):
  MarkY = GoY
  MarkP = Mp
  MarkC = Mc
  return
end sub

sub WaitFrames(u8 Nf):
  u8 Wi = 0
  for Wi = 1 to Nf
    Frame1
    MoveCursor
  next
  return
end sub

' entry Rem[Ci] goes to the end of the placed list
sub Place(u8 Ci):
  u8 Pi = 0
  Pi = Ci
  while Pi < NR - 1
    Rem[Pi] = Rem[Pi + 1]
    inc Pi
  end while
  dec NR
  inc NA
  MarkY = 208
  Rearm
  wait
  nmi off
  for Ri = NA - 1 to NE - 1
    DrawRow
  next
  ShowFact(NA - 1)
  ShowScore
  ' the last entry, alone and worth nothing, is placed by itself
  if NR = 1 then
    Pts[NA] = 0
    NR = 0
    inc NA
    Ri = NA - 1
    DrawRow
  end if
  if NR = 0 then
    Act = 1
    play sound SndDone
  end if
  Cur = 0
  SetGoal
  return
end sub

' the cursor slides 2 pixels a frame to its row; the mark stays put
sub MoveCursor:
  if CurY < GoY then
    CurY = CurY + 2
    if CurY > GoY then CurY = GoY
  end if
  if CurY > GoY then
    CurY = CurY - 2
    if CurY < GoY then CurY = GoY
  end if
  DrawSprites
  return
end sub

sub DrawSprites:
  if Act = 1 then
    set sprite 0 to 208,0,0,0
  else
    set sprite 0 to CurY,20,SArrow,11
  end if
  set sprite 1 to MarkY,200,MarkP,MarkC
  update sprites
  return
end sub

' after a list: the stick runs through the facts, a button goes on
sub Review:
  u8 Rv = 0
  Rearm
  wait
  nmi off
  fill 32 count 28 at 2,TitleRow
  print at 2,TitleRow, "LIST DONE! BUTTON: GO ON"
  Scr = 5
  Rv = NE - 1
  Cur = Rv
  ShowFact(Rv)
  CurY = Rv + RowTop
  CurY = CurY * 8
  CurY = CurY - 1
  GoY = CurY
  Act = 0
  DrawSprites
  Rearm
  wait no fire
  nmi off
rv_loop:
  Frame1
  ReadPad
  if Moved = 1 then
    if Stick = 1 then
      if Rv = 0 then
        Rv = NE - 1
      else
        dec Rv
      end if
    else
      inc Rv
      if Rv >= NE then Rv = 0
    end if
    play sound SndTick
    GoY = Rv + RowTop
    GoY = GoY * 8
    GoY = GoY - 1
    ShowFact(Rv)
  end if
  MoveCursor
  if Press1 = 0 then
    if Press2 = 0 then goto rv_loop
  end if
  HideSprites
  return
end sub

' ---------------------------------------------------------------------------
' screens

sub IntroCard:
  u8 Iy = 0
  NewScreen
  Scr = 3
  NumU = Qn + 1
  print at 2,1, "LIST " + width$(NumU, 1) + " OF 8"
  ShowScore
  fill 32 count 28 at 2,FactRow
  print at 18,1, "SC"
  ShowScoreAt1
  PutStr(0, 2, 3, 1)
  Iy = 5
  for Ti = 1 to NI
    PutStr(Ti, 3, Iy, 0)
    inc Iy
  next
  inc Iy
  print at 3,Iy, "THE LIST:"
  inc Iy
  PutStr(NI + 1, 5, Iy, 1)
  inc Iy
  print at 3,Iy, "THE FACTS:"
  inc Iy
  PutStr(NI + 2, 5, Iy, 1)
  inc Iy
  inc Iy
  put char TUp at 3,Iy
  print at 5,Iy, "THE FIRST ONE GOES ON TOP"
  inc Iy
  NumU = NE
  print at 5,Iy, width$(NumU, 2) + " ENTRIES IN ALL"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

sub ShowScoreAt1:
  i16 Shown = 0
  Shown = TP * 10
  if Shown < 0 then
    put char 45 at 21,1
    Shown = 0 - Shown
  end if
  NumU = Shown
  print at 22,1, width$(NumU, 5)
  return
end sub

sub PauseMenu:
  NewScreen
  Scr = 6
  print at 12,4, "PAUSED"
  PutStr(0, 2, 7, 1)
  print at 8,11, "RESUME THIS LIST"
  print at 8,13, "START THE MODULE OVER"
  print at 8,15, "BACK TO THE TITLE"
  print at 3,20, "STICK: CHOOSE  BUTTON: GO"
  Sel = 0
  RunMenu(3, 11)
  return
end sub

' a menu of Items rows from row Top, two rows apart (PauseMenu) or one
' (TitlePage, Top 13), with the arrow sprite; the choice in Sel
sub RunMenu(u8 Items, u8 Top):
  u8 Gap = 2
  if Items = 5 then Gap = 1
  Rearm
  wait
  nmi off
  screen on
  nmi off
  Rearm
  wait no fire
  nmi off
  Hold = 0
mn_loop:
  Frame1
  if TitleOn = 1 then inc Rs
  ReadPad
  if Moved = 1 then
    if Stick = 1 then
      if Sel = 0 then
        Sel = Items - 1
      else
        dec Sel
      end if
    else
      inc Sel
      if Sel >= Items then Sel = 0
    end if
    play sound SndTick
  end if
  CurY = Sel * Gap
  CurY = CurY + Top
  CurY = CurY * 8
  CurY = CurY - 1
  set sprite 0 to CurY,40,SArrow,11
  update sprites
  if Press1 = 0 then
    if Press2 = 0 then goto mn_loop
  end if
  HideSprites
  return
end sub

sub FinalPage:
  u16 Pct = 0
  NewScreen
  Scr = 7
  print at 5,3, "THE MOST AND THE LEAST"
  print at 2,6, "ALL EIGHT LISTS ARE DONE!"
  print at 3,9, "YOUR SCORE"
  ShowScoreAt9
  print at 3,11, "BEST POSSIBLE"
  NumU = MaxTP * 10
  print at 22,11, width$(NumU, 5)
  print at 3,13, "RIGHT PICKS"
  print RightN at 24,13
  print at 3,14, "WRONG PICKS"
  print WrongN at 24,14
  Pct = 0
  if TP > 0 then
    ' (TP * 100 would pass 65535: ten times the points over a tenth of the best)
    NumU = TP
    Pct = NumU * 10
    W16 = MaxTP / 10
    if W16 = 0 then W16 = 1
    Pct = Pct / W16
  end if
  select case Pct
  case 95 to 100
    print at 4,17, "A WALKING ALMANAC!"
  case 75 to 94
    print at 4,17, "YOU KNOW YOUR FACTS."
  case 50 to 74
    print at 4,17, "NOT BAD AT ALL."
  case else
    print at 4,17, "TRY IT AGAIN: THE FACTS"
    print at 4,18, "ARE ON THE BOTTOM LINE."
  end select
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  mute all
  play sound SndEnd
  return
end sub

sub ShowScoreAt9:
  i16 Shown = 0
  Shown = TP * 10
  if Shown < 0 then
    put char 45 at 21,9
    Shown = 0 - Shown
  end if
  NumU = Shown
  print at 22,9, width$(NumU, 5)
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

' the controllers: Stick 1 up / 2 down, Moved on a new push or a repeat
' (after 18 frames held, every 6), Press1 left button, Press2 right
sub ReadPad:
  u8 Now = 0
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Now = V & 3
  if Now = 3 then Now = 0
  Moved = 0
  if Now > 0 then
    if Now <> Stick then
      Moved = 1
      Hold = 0
    else
      inc Hold
      if Hold >= 24 then
        Moved = 1
        Hold = 18
      end if
    end if
  end if
  Stick = Now
  Btn1 = V & 16
  Btn2 = V & 32
  Press1 = 0
  Press2 = 0
  if Btn1 > 0 then
    if Was1 = 0 then Press1 = 1
  end if
  if Btn2 > 0 then
    if Was2 = 0 then Press2 = 1
  end if
  Was1 = Btn1
  Was2 = Btn2
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 3
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F4
  for J = 0 to 63
    W16 = J * 8
    W16 = W16 + 1024
    copy Grad count 8 to vram.color + W16
  next
  copy TileCol count NTiles8 to vram.color + Art0
  backdrop dark blue
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: a bar chart from the most to the least, the tune once, the
' four modules and CREDITS
sub TitlePage:
  u8 Bh = 0
  u8 Bx = 0
  NewScreen
  Scr = 2
  for Ti = 0 to 7
    Bx = Ti * 3
    Bx = Bx + 4
    Bh = 8 - Ti
    Y = 10 - Bh
    put char BarTop[Ti] at Bx,Y
    put char BarTop[Ti] at Bx + 1,Y
    for Ri = Y + 1 to 9
      C = BarTop[Ti] + 1
      put char C at Bx,Ri
      put char C at Bx + 1,Ri
    next
  next
  fill TFloor count 24 at 4,10
  print at 5,1, "THE MOST AND THE LEAST"
  print at 7,11, "BY ORSON SCOTT CARD"
  print at 8,13, "U.S. GEOGRAPHY"
  print at 8,14, "U.S. HISTORY"
  print at 8,15, "WHICH IS ..."
  print at 8,16, "WORLD GEOGRAPHY"
  print at 8,17, "CREDITS"
  print at 3,19, "PUT EACH LIST IN ORDER,"
  print at 3,20, "FROM THE MOST TO THE LEAST."
  print at 8,22, "AHOY! MARCH 1986"
  ' the title line in the yellow font
  for Ti = 5 to 26
    C = get char at Ti,1
    if C > 32 then
      C = C + 96
      put char C at Ti,1
    end if
  next
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 600
  TzOn = 1
  TitleOn = 1
  Sel = Mod
  RunMenu(5, 13)
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  return
end sub

sub CreditsPage:
  NewScreen
  Scr = 1
  print at 4,1, "THE MOST AND THE LEAST"
  print at 2,4, "BASED ON THE MOST AND THE"
  print at 2,5, "LEAST BY ORSON SCOTT CARD,"
  print at 2,6, "AHOY! MARCH 1986 (C-64),"
  print at 2,7, "WITH ITS FOUR QUIZ MODULES."
  print at 2,9, "FACTS CHECKED IN 2026: SOME"
  print at 2,10, "ERRORS FIXED, DATED FIGURES"
  print at 2,11, "MARKED AS OF 1986."
  print at 2,13, "COLECOVISION GAME AND MUSIC"
  print at 2,14, "BY CLAUDE (ANTHROPIC) FOR"
  print at 2,15, "AMY STUDIO, IN AMY BY AMY"
  print at 2,16, "BIENVENU, 2026."
  print at 2,18, "MUSIC: HIGHEST TO LOWEST"
  print at 2,19, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  wait no fire
  pause until press
  wait no fire
  nmi off
  return
end sub

