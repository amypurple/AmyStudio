const MtAreas = 6
const MtLoopFrames = 1152
const MgLoopFrames = 640

' ---------------------------------------------------------------- constants
const C0 = 3            ' first column of the play field
const R0 = 3            ' first row
const CN = 26           ' columns
const RH = 9            ' rows in each half of the map (2 halves = 18 rows)
const CMax = 28         ' last column
const RMax = 20         ' last row
const HomeC = 26        ' the cottage door
const HomeR = 5
const StartC = 5
const StartR = 18
const MaxWolves = 20
' map cell values
const MGrass = 0
const MTree = 1
const MWolf = 2
const MDoor = 3
' v3 controls (frames)
const SettleF = 4       ' a single axis is taken on its 4th frame
const RepFirst = 14     ' hold: first repeat
const RepNext = 8       ' hold: then every 8 frames
const BufMax = 20       ' a buffered input older than this is dropped
const ActWait = 16      ' Act code for "stay put"

' ---------------------------------------------------------------------------
' _common/amy/core.alexis - shared frame, input and sprite helpers for the
' Oric -> ColecoVision ports (Amy & Claude 2026). build.py pastes it in.
' Needs: nothing. Provides the variables below and the subs
'   Rearm, Frame1, ReadPad, HideSprites, ShowScreen, BlankScreen, HudIcons
' Rules kept here (see COMMON.md): the NMI only runs during the wait of
' Frame1; screens are drawn with the display off; sprites are hidden at
' Y 209 (never 208, which ends the sprite list).
' ---------------------------------------------------------------------------
u8 Tick = 0
u8 Mix = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 StickHit = 0
u8 RepT = 0
u8 J = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

' re-arm the NMI before any wait (acknowledges a pending VDP interrupt)
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  inc Mix
  return
end sub

' both controllers; Press = a button went down this frame;
' StickHit = the stick moved to a new direction, or auto-repeats
' (16 frames, then every 7) - for menus
sub ReadPad:
  Up1 = joypad(1).up | joypad(2).up
  Dn1 = joypad(1).down | joypad(2).down
  Lf1 = joypad(1).left | joypad(2).left
  Rt1 = joypad(1).right | joypad(2).right
  Btn = joypad(1).fire | joypad(2).fire
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = Up1
  if Dn1 = 1 then Stick = Stick | 2
  if Lf1 = 1 then Stick = Stick | 4
  if Rt1 = 1 then Stick = Stick | 8
  StickHit = 0
  if Stick <> 0 then
    if Stick <> WasStick then
      StickHit = 1
      RepT = 16
    else
      dec RepT
      if RepT = 0 then
        StickHit = 1
        RepT = 7
      end if
    end if
  end if
  WasStick = Stick
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 8
  sprites stable 0 to 2
  sprites flicker on
  for J = 0 to 7
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' every new screen: wait, NMI off, display off, sprites hidden
sub BlankScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' a row of icons: Full copies of IconA then (Max - Full) of IconB at X,Y
u8 HudN = 0
sub HudIcons(u8 IconA, u8 IconB, u8 Full, u8 Max, u8 Hx, u8 Hy):
  for HudN = 1 to Max
    if HudN <= Full then
      put char IconA at Hx,Hy
    else
      put char IconB at Hx,Hy
    end if
    inc Hx
  next
  return
end sub

' Pn consecutive tile codes from Pc, left to right from X,Y (big pictures)
u8 RunI = 0
sub PutRun(u8 Pc, u8 Pn, u8 Rx, u8 Ry):
  for RunI = 1 to Pn
    put char Pc at Rx,Ry
    inc Pc
    inc Rx
  next
  return
end sub

' ---------------------------------------------------------------- variables
record Wolf:
  u8 X
  u8 Y
end record
Wolf Pack[MaxWolves]
u8 MapA[RH,CN]          ' rows 3-11
u8 MapB[RH,CN]          ' rows 12-20

u8 Wolves = 3           ' wolves in this forest
u8 StartWolves = 2      ' chosen on the title (2-9)
u8 Seen = 0             ' wolves 0..Seen-1 have shown themselves
u8 Level = 1
u8 Lives = 3
u16 Homes = 0
u8 Mx = 0               ' the walker's cell
u8 My = 0
u8 Px = 0               ' the walker's sprite position (pixels)
u8 Py = 0
u8 Tx = 0               ' tween target (pixels)
u8 Ty = 0
u8 TwT = 0              ' tween frames left
u8 FaceL = 0            ' 1 = facing left
u8 WalkF = 0
u8 WolfI = 0            ' next wolf to move this turn (>= Wolves: done)
u8 AppT = 0             ' appear animation frames left
u8 AppI = 0
u8 Caught = 0
u8 AtHome = 0
u8 BumpT = 0
u8 TrotF = 0
u8 Menu = 0
u8 SmokeT = 0
u8 Gx = 0               ' scratch for cells (Cell / SetCell / DrawCell)
u8 Gy = 0
u8 Gv = 0
u8 Ax = 0               ' wolf move scratch
u8 Ay = 0
u8 Dx = 0
u8 Dy = 0
u8 Ws = 0
u8 Sx = 0
u8 Sy = 0
u8 Wt = 0
u8 Ok = 0
u8 K = 0
u8 Lw = 0
u8 Cnt = 0
u16 Rs = 0              ' xorshift random state
u8 R2 = 0
u8 SkipFrom = 0         ' wolves SkipFrom..Seen-1 showed themselves since the last move
u8 Fresh = 0            ' this move turn: wolves Fresh..Seen-1 are startled (no move)
u8 Qx = 0               ' Cheb: Ch = Chebyshev distance from Qx,Qy to Rx,Ry
u8 Qy = 0
u8 Rx = 0
u8 Ry = 0
u8 Ch = 0
u8 Pd = 0
u8 Wd = 0               ' the walker's distance to the door (WolvesTurn)
u8 Hi = 0
u8 Phase = 0            ' for the test bots: 1 = play loop, 2 = title
' v3 controls
u8 Cand = 0             ' stick bits being settled (1 up, 2 down, 4 left, 8 right)
u8 SetT = 0             ' settle frames left
u8 Dir = 0              ' settled direction (0: none)
u8 RptT = 0             ' hold-to-repeat countdown
u8 RepOk = 0            ' 1 = this hold may repeat
u8 Act = 0              ' buffered input: stick bits, ActWait, or 0
u8 ActAge = 0
u8 Ab = 0               ' DirOf: bits in, Dx Dy out
u8 BumpD = 0            ' direction of the last bump (for the nudge)
u8 IndOn = 0            ' the next-step frame is shown
u8 NeedRel = 0          ' 1 = ignore input until everything is let go

' the book's alternatives (DATA 1720-1740) as bytes: 1 = +1, 255 = -1.
' S = 0: diagonal, S = 1: same row (YY = 0), S = 2: same column (XX = 0)
data WolfU bytes 1,1,0,1,255,0,255,0,0,  1,1,1,0,0,255,255,255,0,  0,1,255,1,255,1,255,0,0
data WolfV bytes 1,0,1,255,1,255,0,0,0,  0,1,255,1,255,1,255,0,0,  1,1,1,0,0,255,255,255,0
' grass looks, mixed by position
data GrassMix bytes 0,1,3,0,1,0,2,1,3,0,1,0,0,3,1,0,1,3,0,1,2,0,1,0,3,1,0,0,1,3,0,1
data TreeMix bytes 0,1,0,2,1,0,3,1,0,1,2,0,1,0,3,1
' title stars: col,row pairs
data Stars bytes 2,1, 7,1, 13,1, 19,0, 27,7, 3,4, 22,4, 2,7, 9,0, 15,0, 21,1, 25,0, 29,3, 0,6, 31,5, 22,7

' ================================================================== program
  tile screen
  set sound table DwSoundTable areas MtAreas
  sprites 16x16
  nmi off
  copy SpPat count SpBytes to vram.spr_pat
  HideSprites
  Rs = $ACE1
  screen on
  CreditsScreen

title:
  TitleScreen
  if Menu = 2 then
    HelpScreens
    goto title
  end if
  if Menu = 3 then
    CreditsScreen
    goto title
  end if

  ' ------------------------------------------------------------ new game
  Level = 1
  Lives = 3
  Homes = 0
  Wolves = StartWolves

new_forest:
  NewForest
  play sound SndStart
  StartMusic

play_loop:
  Frame1
  Phase = 1
  ReadPad
  Controls
  Animate
  ' the walker glides to his cell, 2 pixels a frame
  if TwT > 0 then
    if Px < Tx then Px += 2
    if Px > Tx then Px -= 2
    if Py < Ty then Py += 2
    if Py > Ty then Py -= 2
    dec TwT
    if TwT = 2 then WalkF = WalkF ^ 1
  end if
  ' the wolves of this turn, three a frame (v2: four; v3's controls run
  ' every frame and four wolves plus the next-step frame missed one frame)
  Lw = 0
  while Lw < 3
    if WolfI < Wolves then
      MoveWolf
      inc WolfI
    end if
    inc Lw
  end while
  if AppT > 0 then AppearStep
  DrawWalker
  if BumpT > 0 then dec BumpT
  ' a new turn only when everything has settled
  V = TwT + AppT
  if V = 0 then
    if WolfI >= Wolves then
      if Caught = 1 then goto got_caught
      if AtHome = 1 then goto got_home
      TryTurn
    end if
  end if
  goto play_loop

' ------------------------------------------------------------ caught
got_caught:
  Phase = 0
  StopMusic
  play sound SndEek
  ' a wolf leaps, EEK!, the walker falls
  ' v3: the bubble sits just above the walker (never on his lines) and the
  ' smoke is hidden: at most 4 sprites a line
  hide sprite 5
  V = Py - 16
  set sprite 3 to V,Px,SpEek0,SpEekC0
  set sprite 4 to V,Px,SpEek1,SpEekC1
  update sprites
  for Cnt = 1 to 40
    Frame1
    V = Py - 16
    set sprite 3 to V,Px,SpEek0,SpEekC0
    set sprite 4 to V,Px,SpEek1,SpEekC1
    update sprites
  next
  set sprite 0 to Py,Px,SpManfall0,SpManfallC0
  set sprite 1 to Py,Px,SpManfall1,SpManfallC1
  set sprite 2 to Py,Px,SpManfall2,SpManfallC2
  hide sprite 3
  hide sprite 4
  update sprites
  for Cnt = 1 to 80
    Frame1
    Animate
    update sprites
  next
  dec Lives
  if Lives > 0 then goto new_forest
  GameOver
  goto title

' ------------------------------------------------------------ home
got_home:
  Phase = 0
  StopMusic
  play sound SndPing
  hide sprite 4
  IndOn = 0
  ' the door opens, the windows light up, the walker goes in
  put char FoHomelit20 at 25,5
  put char FoHomelit21 at 26,5
  put char FoHomelit22 at 27,5
  for Cnt = 1 to 24
    Frame1
    Animate
    update sprites
  next
  hide sprite 0
  hide sprite 1
  hide sprite 2
  update sprites
  play sound SndHome
  inc Homes
  for Cnt = 1 to 110
    Frame1
    Animate
    ' sparks rise from the door
    V = Cnt & 31
    Y = 30 - V
    X = Cnt & 7
    X += 204
    set sprite 3 to Y,X,SpSpark,9
    update sprites
  next
  hide sprite 3
  if Level < 99 then inc Level
  if Wolves < MaxWolves then inc Wolves
  goto new_forest

' ==================================================================== subs

' ------------------------------------------------------------ random
' 16-bit xorshift (7, 9, 8): period 65535; R2 = its high byte. Stepped on
' the title every frame, so each game gets a different forest
sub Rnd:
  Rs = Rs ^ (Rs << 7)
  Rs = Rs ^ (Rs >> 9)
  Rs = Rs ^ (Rs << 8)
  R2 = highbyte Rs
  return
end sub

' ------------------------------------------------------------ the map
' Gv = the cell at Gx,Gy (outside the field: a tree)
sub Cell:
  Gv = MTree
  if Gx < C0 then return
  if Gx > CMax then return
  if Gy < R0 then return
  if Gy > RMax then return
  X = Gx - C0
  if Gy < 12 then
    Y = Gy - R0
    Gv = MapA[Y,X]
  else
    Y = Gy - 12
    Gv = MapB[Y,X]
  end if
  return
end sub

sub SetCell:
  X = Gx - C0
  if Gy < 12 then
    Y = Gy - R0
    MapA[Y,X] = Gv
  else
    Y = Gy - 12
    MapB[Y,X] = Gv
  end if
  return
end sub

' the grass tile that belongs to Gx,Gy
sub PutGrass:
  V = Gy << 3
  V += Gx
  V = V & 31
  V = GrassMix[V]
  V += FoGrass0
  put char V at Gx,Gy
  return
end sub

' ------------------------------------------------------------ a new forest
sub NewForest:
  BlankScreen
  fill mode 2 text color with $F0
  copy FoPat count FoBytes to vram.pattern + 1024
  copy FoCol count FoBytes to vram.color + 1024
  copy FoPat count FoBytes to vram.pattern + 3072
  copy FoCol count FoBytes to vram.color + 3072
  copy FoPat count FoBytes to vram.pattern + 5120
  copy FoCol count FoBytes to vram.color + 5120
  backdrop black
  cls
  ' the frame
  for Gx = 2 to 29
    V = Gx & 1
    V += FoEdge0
    put char V at Gx,2
    put char V at Gx,21
  next
  for Gy = 3 to 20
    V = Gy & 1
    V += FoEdge0
    put char V at 2,Gy
    put char V at 29,Gy
  next
  ' trees: 25% of the cells
  for Gy = R0 to RMax
    for Gx = C0 to CMax
      Rnd
      Gv = MGrass
      if R2 < 64 then Gv = MTree
      SetCell
    next
  next
  ' the corners are cleared (5 x 5), and a trail home is kept free
  for Gy = 3 to 7
    for Gx = 24 to 28
      Gv = MGrass
      SetCell
    next
  next
  for Gy = 16 to 20
    for Gx = 3 to 7
      Gv = MGrass
      SetCell
    next
  next
  Gx = StartC
  Gy = StartR
  while Gx < HomeC
    Rnd
    V = R2 & 3
    if V = 0 then
      if Gy > 6 then dec Gy
    else
      inc Gx
      if V = 1 then
        if Gy > 6 then dec Gy
      end if
    end if
    Gv = MGrass
    SetCell
  end while
  while Gy > 6
    dec Gy
    Gv = MGrass
    SetCell
  end while
  ' the cottage (3 x 3); its door is home
  for Gy = 3 to 5
    for Gx = 25 to 27
      Gv = MTree
      SetCell
    next
  next
  Gx = HomeC
  Gy = HomeR
  Gv = MDoor
  SetCell
  ' draw the field
  for Gy = R0 to RMax
    for Gx = C0 to CMax
      Cell
      if Gv = MGrass then
        PutGrass
      else
        V = Gy << 2
        V += Gx
        V = V & 15
        V = TreeMix[V]
        V += FoOak
        put char V at Gx,Gy
      end if
    next
  next
  PutRun(FoHome00, 3, 25, 3)
  put char FoHome10 at 25,4
  put char FoHome11 at 26,4
  put char FoHome12 at 27,4
  put char FoHome20 at 25,5
  put char FoHome21 at 26,5
  put char FoHome22 at 27,5
  ' the wolves: hidden, on free cells, away from the start (row - col < 13)
  for K = 0 to Wolves - 1
    Ok = 0
    while Ok = 0
      Rnd
      Gx = R2 & 31
      Rnd
      Gy = R2 & 31
      if Gx >= C0 then
        if Gx <= CMax then
          if Gy >= R0 then
            if Gy <= RMax then
              Cell
              if Gv = MGrass then
                V = Gx + 13
                if Gy < V then Ok = 1
              end if
            end if
          end if
        end if
      end if
      if Ok = 1 then
        if K > 0 then
          for J = 0 to K - 1
            if Pack[J].X = Gx then
              if Pack[J].Y = Gy then Ok = 0
            end if
          next
        end if
      end if
    end while
    Pack[K].X = Gx
    Pack[K].Y = Gy
  next
  Seen = 0
  SkipFrom = 0
  Fresh = 0
  WolfI = Wolves
  AppT = 0
  Caught = 0
  AtHome = 0
  TwT = 0
  BumpT = 0
  Act = 0
  RepOk = 0
  NeedRel = 1
  IndOn = 0
  FaceL = 0
  WalkF = 0
  Mx = StartC
  My = StartR
  Px = Mx * 8
  Px -= 4
  Py = My * 8
  Py -= 9
  Tx = Px
  Ty = Py
  DrawHud
  print at 3,22, "THERE ARE    WOLVES AROUND"
  print Wolves at 13,22 width 2
  ShowScreen
  DrawWalker
  return
end sub

sub DrawHud:
  print at 2,1, "LV"
  print Level at 4,1 width 2
  HudIcons(FoHwolf, FoHeyes, Seen, Wolves, 8, 1)
  return
end sub

sub ShowLives:
  fill 32 count 28 at 2,22
  HudIcons(FoHlife, 32, Lives, 3, 2, 22)
  print at 15,22, "DON'T CRY WOLF"
  return
end sub

' ------------------------------------------------------------ one turn
sub TryTurn:
  ' hold to repeat: only a held, settled direction, never near a seen wolf
  if Act = 0 then
    if Dir <> 0 then
      if RepOk = 1 then
        if RptT = 0 then
          Near
          if Ch <= 2 then
            RepOk = 0
          else
            Act = Dir
            RptT = RepNext
          end if
        end if
      end if
    end if
  end if
  if Act = 0 then return
  Ab = Act
  Act = 0
  if Ab = ActWait then
    ' stay put: the turn passes
    play sound SndWait
    WolvesTurn
    return
  end if
  DirOf
  Gx = Mx + Dx
  Gy = My + Dy
  Cell
  Ok = 0
  if Gv = MGrass then Ok = 1
  if Gv = MDoor then Ok = 1
  if Ok = 0 then
    ' a bump: a thud and a nudge, no turn used, no repeat into the tree
    play sound SndBump
    BumpT = 8
    BumpD = Ab
    RepOk = 0
    return
  end if
  ' the first step clears the "there are N wolves" line
  if Mx = StartC then
    if My = StartR then ShowLives
  end if
  Mx = Gx
  My = Gy
  if Dx = 255 then FaceL = 1
  if Dx = 1 then FaceL = 0
  Tx = Mx * 8
  Tx -= 4
  Ty = My * 8
  Ty -= 9
  TwT = 4
  if Gv = MDoor then
    AtHome = 1
    return
  end if
  WolvesTurn
  return
end sub

' Dx, Dy (255 / 0 / 1) from the stick bits in Ab
sub DirOf:
  Dx = 0
  Dy = 0
  V = Ab & 4
  if V <> 0 then Dx = 255
  V = Ab & 8
  if V <> 0 then Dx = 1
  V = Ab & 1
  if V <> 0 then Dy = 255
  V = Ab & 2
  if V <> 0 then Dy = 1
  return
end sub

' Ch = distance from the walker to the nearest seen wolf (99: none)
sub Near:
  Lw = 99
  Hi = 0
  while Hi < Seen
    Qx = Pack[Hi].X
    Qy = Pack[Hi].Y
    Rx = Mx
    Ry = My
    Cheb
    if Ch < Lw then Lw = Ch
    inc Hi
  end while
  Ch = Lw
  return
end sub

' v3 controls, every frame of play: settle, buffer, next-step frame
sub Controls:
  if NeedRel = 1 then
    ' a new forest: wait until the stick and the buttons are let go
    V = Stick | Btn
    if V = 0 then NeedRel = 0
    Cand = Stick
    Dir = Stick
    SetT = 0
  else
    if Stick <> Cand then
      if Stick = 0 then
        ' let go before it settled: a quick tap still counts, unless it is
        ' the last axis of a diagonal being released (a part of Dir)
        if SetT > 0 then
          V = Cand & Dir
          if V <> Cand then
            Act = Cand
            ActAge = 0
          end if
        end if
        SetT = 0
        Dir = 0
      else
        SetT = SettleF
        V = Stick & 3
        if V <> 0 then
          V = Stick & 12
          if V <> 0 then SetT = 1
        end if
      end if
      Cand = Stick
    end if
    if SetT > 0 then
      dec SetT
      if SetT = 0 then
        if Cand <> Dir then
          ' a new settled direction: one step (now, or kept for later)
          Dir = Cand
          Act = Dir
          ActAge = 0
          RptT = RepFirst
          RepOk = 1
        end if
      end if
    else
      if Dir <> 0 then
        if RptT > 0 then dec RptT
      end if
    end if
    if Press = 1 then
      Act = ActWait
      ActAge = 0
    end if
  end if
  if Act <> 0 then
    inc ActAge
    if ActAge > BufMax then Act = 0
  end if
  ' the next-step frame: where the stick points, red if blocked
  IndOn = 0
  if AppT = 0 then
    if Cand <> 0 then
      if NeedRel = 0 then IndOn = 1
    end if
  end if
  if IndOn = 1 then
    Ab = Cand
    DirOf
    Gx = Mx + Dx
    Gy = My + Dy
    Cell
    K = 15
    if Gv = MTree then K = 8
    if Gv = MWolf then K = 8
    X = Gx * 8
    dec X
    Y = Gy * 8
    Y -= 2
    set sprite 4 to Y,X,SpAim,K
  else
    set sprite 4 to 209,0,SpAim,0
  end if
  return
end sub

' Ch = Chebyshev distance from Qx,Qy to Rx,Ry
sub Cheb:
  if Qx > Rx then
    Ch = Qx - Rx
  else
    Ch = Rx - Qx
  end if
  if Qy > Ry then
    Pd = Qy - Ry
  else
    Pd = Ry - Qy
  end if
  if Pd > Ch then Ch = Pd
  return
end sub

' the wolves' half of a turn: a new one shows itself (30%), or all move.
' Fair wolves: the first hidden wolf (from Seen on) that stands on grass,
' at least 3 cells from the walker and not more than Level-1 cells closer
' to the door than him is the one shown; it takes the slot Seen.
sub WolvesTurn:
  if Seen < Wolves then
    Rnd
    if R2 < 77 then
      Qx = Mx
      Qy = My
      Rx = HomeC
      Ry = HomeR
      Cheb
      Wd = Ch                 ' the walker's distance to the door
      Hi = Seen
      while Hi < Wolves
        Gx = Pack[Hi].X
        Gy = Pack[Hi].Y
        Cell
        if Gv = MGrass then
          Qx = Gx
          Qy = Gy
          Rx = Mx
          Ry = My
          Cheb
          if Ch >= 3 then
            Rx = HomeC
            Ry = HomeR
            Cheb
            Ch += Level
            if Ch > Wd then
              ' swap wolves Hi and Seen: the shown one takes slot Seen
              Sx = Pack[Seen].X
              Sy = Pack[Seen].Y
              Pack[Seen].X = Gx
              Pack[Seen].Y = Gy
              Pack[Hi].X = Sx
              Pack[Hi].Y = Sy
              AppI = Seen
              AppT = 40
              ' v3: input from before the eyes is dropped, holding stops
              Act = 0
              RepOk = 0
              play sound SndHowl
              return
            end if
          end if
        end if
        inc Hi
      end while
    end if
  end if
  ' a move turn: the wolves shown since the last one are startled
  Fresh = SkipFrom
  SkipFrom = Seen
  WolfI = 0
  return
end sub

' the book's MOVE (lines 800-900) and Wolf MOVE (600-680) for wolf WolfI
sub MoveWolf:
  if WolfI >= Fresh then
    if WolfI < Seen then return
  end if
  Ax = Pack[WolfI].X
  Ay = Pack[WolfI].Y
  ' XX, YY: one step towards the walker
  Dx = 0
  if Ax > Mx then Dx = 255
  if Ax < Mx then Dx = 1
  Dy = 0
  if Ay > My then Dy = 255
  if Ay < My then Dy = 1
  Ws = 0
  if Dy = 0 then
    Ws = 9
    Dy = 1
  end if
  if Dx = 0 then
    Ws = 18
    Dx = 1
  end if
  ' try up to 9 alternatives; the last one is "stay"
  Ok = 0
  Wt = 0
  while Ok = 0
    K = Ws + Wt
    V = WolfU[K]
    if Dx = 255 then V = 0 - V
    Gx = Ax + V
    V = WolfV[K]
    if Dy = 255 then V = 0 - V
    Gy = Ay + V
    Cell
    if Gv = MGrass then
      ' at least one of the two orthogonal cells must be free
      ' (Cell uses X and Y: keep the target in Sx, Sy)
      Sx = Gx
      Sy = Gy
      Gx = Ax
      Cell
      if Gv = MGrass then Ok = 1
      Gx = Sx
      if Ok = 0 then
        Gy = Ay
        Cell
        if Gv = MGrass then Ok = 1
        Gy = Sy
      end if
    end if
    inc Wt
    if Wt > 8 then
      if Ok = 0 then
        Gx = Ax
        Gy = Ay
        Ok = 1
      end if
    end if
  end while
  Pack[WolfI].X = Gx
  Pack[WolfI].Y = Gy
  if WolfI < Seen then
    ' a seen wolf: move its tile, and maybe catch the walker
    ' (PutGrass uses V: keep the new cell in Sx, Sy)
    Sx = Gx
    Sy = Gy
    Gx = Ax
    Gy = Ay
    Gv = MGrass
    SetCell
    PutGrass
    Gx = Sx
    Gy = Sy
    Gv = MWolf
    SetCell
    PutWolf
    if Gx = Mx then
      if Gy = My then Caught = 1
    end if
  end if
  return
end sub

' a wolf tile at Gx,Gy, facing the walker
sub PutWolf:
  V = FoWolfl
  if Gx < Mx then V = FoWolfr
  put char V at Gx,Gy
  return
end sub

' eyes in the dark, a blink, then the wolf (40 frames)
sub AppearStep:
  dec AppT
  Gx = Pack[AppI].X
  Gy = Pack[AppI].Y
  X = Gx * 8
  Y = Gy * 8
  dec Y
  ' one blink in the middle (no fast flashing)
  V = 0
  if AppT >= 20 then
    if AppT < 24 then V = 1
  end if
  if V = 1 then
    set sprite 3 to Y,X,SpEyes1,11
  else
    set sprite 3 to Y,X,SpEyes0,11
  end if
  if AppT = 8 then
    Gv = MWolf
    SetCell
    PutWolf
    inc Seen
    V = AppI + 8
    put char FoHwolf at V,1
  end if
  if AppT = 0 then hide sprite 3
  return
end sub

' ------------------------------------------------------------ animation
sub DrawWalker:
  V = 0
  if TwT > 0 then V = WalkF + 1
  ' 3 looks (stand, walk a, walk b) x 3 layers: pattern steps of 4
  K = V * 24
  if FaceL = 1 then K += 12
  ' v3 bump: 2 pixels towards the tree for 4 frames, then 1 back now and then
  X = Px
  Y = Py
  if BumpT > 0 then
    Ab = BumpD
    DirOf
    if BumpT > 4 then
      X += Dx
      X += Dx
      Y += Dy
      Y += Dy
    else
      V = BumpT & 1
      if V = 0 then
        X -= Dx
        Y -= Dy
      end if
    end if
  end if
  set sprite 0 to Y,X,K,SpManstandC0
  K += 4
  set sprite 1 to Y,X,K,SpManstandC1
  K += 4
  set sprite 2 to Y,X,K,SpManstandC2
  update sprites
  return
end sub

' every frame of play: the wolves trot (2.5 Hz), chimney smoke rises
sub Animate:
  V = Tick & 15
  if V = 0 then
    TrotF = TrotF ^ 16
    copy WolfFrames + TrotF count 16 to vram.pattern + 1024 + (FoWolfl - 128) * 8
    copy WolfFrames + TrotF count 16 to vram.pattern + 3072 + (FoWolfl - 128) * 8
    copy WolfFrames + TrotF count 16 to vram.pattern + 5120 + (FoWolfl - 128) * 8
  end if
  ' smoke: three puffs rising from the roof, one sprite
  inc SmokeT
  if SmokeT >= 96 then SmokeT = 0
  V = SmokeT >> 5
  V = V << 2
  V += SpPuff0
  Y = 9
  X = SmokeT >> 4
  X += 210
  ' v3: at most 4 sprites a line - near the cottage roof the smoke gives way
  ' to the next-step frame and to appearing eyes
  if My <= 4 then
    K = IndOn | AppT
    if K <> 0 then Y = 209
  end if
  set sprite 5 to Y,X,V,14
  return
end sub

' ------------------------------------------------------------ music
sub StartMusic:
  nmi off
  play sound SndMgLead
  play sound SndMgTwo
  play sound SndMgNoise
  play sound SndMgPitch
  nmi on
  nmi off
  return
end sub

sub StopMusic:
  nmi off
  stop sound SndMgLead
  stop sound SndMgTwo
  stop sound SndMgNoise
  stop sound SndMgPitch
  stop sound SndMtLead
  stop sound SndMtTwo
  stop sound SndMtNoise
  stop sound SndMtPitch
  mute all
  nmi on
  nmi off
  return
end sub

' ------------------------------------------------------------ game over
sub GameOver:
  fill 32 count 28 at 2,22
  ' a panel framed by dark forest, cols 7-23, rows 8-14: one blank row
  ' above, between and below the lines, three blank columns each side
  for Gx = 7 to 23
    V = Gx & 1
    V += FoEdge0
    put char V at Gx,8
    put char V at Gx,14
  next
  for Gy = 9 to 13
    V = Gy & 1
    V += FoEdge0
    put char V at 7,Gy
    put char V at 23,Gy
    fill 32 count 15 at 8,Gy
  next
  print at 11,10, "GAME OVER"
  print at 11,12, "LV"
  print Level at 14,12 width 2
  put char FoHhome at 17,12
  print Homes at 18,12 width 2
  ' the fallen walker stays only if he is clear of the panel
  if Py >= 48 then
    if Py < 120 then
      if Px >= 40 then
        if Px < 192 then
          HideSprites
        end if
      end if
    end if
  end if
  update sprites
  play sound SndOver
  for Cnt = 1 to 150
    Frame1
    Animate
    update sprites
  next
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  StopMusic
  return
end sub

' ------------------------------------------------------------ text screens
sub TextScreen:
  BlankScreen
  fill mode 2 text color with $F0
  copy FoPat count FoBytes to vram.pattern + 1024
  copy FoCol count FoBytes to vram.color + 1024
  copy FoPat count FoBytes to vram.pattern + 3072
  copy FoCol count FoBytes to vram.color + 3072
  copy FoPat count FoBytes to vram.pattern + 5120
  copy FoCol count FoBytes to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub WaitPage:
  ShowScreen
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  return
end sub

sub CreditsScreen:
  TextScreen
  PageCredits
  ' a wolf and the cottage under the text
  PutRun(FoHome00, 3, 14, 18)
  put char FoHome10 at 14,19
  put char FoHome11 at 15,19
  put char FoHome12 at 16,19
  put char FoWolfr at 10,19
  put char FoWolfl at 20,19
  WaitPage
  return
end sub

sub HelpScreens:
  TextScreen
  PageHelp1
  ' a little scene: walker, trees, a wolf, the cottage
  fill FoGrass0 count 28 at 2,20
  put char FoPine at 5,20
  put char FoOak at 6,20
  put char FoPine2 at 7,20
  put char FoRock at 18,20
  put char FoWolfl at 14,20
  PutRun(FoHome00, 3, 24, 18)
  PutRun(FoHome10, 3, 24, 19)
  PutRun(FoHome20, 3, 24, 20)
  ShowScreen
  set sprite 0 to 151,68,SpManstand0,SpManstandC0
  set sprite 1 to 151,68,SpManstand1,SpManstandC1
  set sprite 2 to 151,68,SpManstand2,SpManstandC2
  update sprites
  Rearm
  pause until press and release sleep after 60 seconds
  nmi off
  TextScreen
  PageHelp2
  put char FoStick at 3,3
  print at 2,6, "(A)"
  put char FoAim at 3,8
  put char FoHeyes at 3,15
  put char FoHwolf at 3,16
  put char FoHlife at 3,17
  WaitPage
  return
end sub

' ------------------------------------------------------------ title
sub TitleScreen:
  BlankScreen
  fill mode 2 text color with $F0
  copy TiPat count TiBytes to vram.pattern + 1024
  copy TiCol count TiBytes to vram.color + 1024
  copy TiPat count TiBytes to vram.pattern + 3072
  copy TiCol count TiBytes to vram.color + 3072
  backdrop black
  cls
  ' sky (rows 0-8), stars, logo, moon, rock, tree line (rows 9-10), path
  for Y = 0 to 8
    fill TiSky count 32 at 0,Y
  next
  for K = 0 to 15
    J = K << 1
    X = Stars[J]
    inc J
    Y = Stars[J]
    V = K & 1
    V += TiStar0
    put char V at X,Y
  next
  for Y = 0 to LogoH1 - 1
    V = Y * LogoW1
    J = Y + 2
    put Logo1 + V count LogoW1 at 4,J
  next
  for Y = 0 to LogoH2 - 1
    V = Y * LogoW2
    J = Y + 5
    put Logo2 + V count LogoW2 at 8,J
  next
  PutRun(TiMoon00, 4, 24, 2)
  PutRun(TiMoon10, 4, 24, 3)
  PutRun(TiMoon20, 4, 24, 4)
  PutRun(TiMoon30, 4, 24, 5)
  PutRun(TiHill00, 6, 23, 6)
  PutRun(TiHill10, 6, 23, 7)
  PutRun(TiHill20, 6, 23, 8)
  for X = 0 to 31
    V = X % 3
    V += TiTrees00
    put char V at X,9
    V += 3
    put char V at X,10
  next
  fill TiPath0 count 32 at 0,12
  ' menu (rows 14-20)
  print at 11,14, "START"
  print at 11,16, "WOLVES"
  print at 11,18, "HOW TO PLAY"
  print at 11,20, "CREDITS"
  print at 8,22, "AMY & CLAUDE 2026"
  ShowWolvesChoice
  ShowScreen
  nmi off
  play sound SndMtLead
  play sound SndMtTwo
  play sound SndMtNoise
  play sound SndMtPitch
  nmi on
  Menu = 0
  Cnt = 0
  Phase = 2
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  ReadPad
  Rnd
  TitleAnim
  if StickHit = 1 then
    if Up1 = 1 then
      if Menu = 0 then
        Menu = 3
      else
        dec Menu
      end if
    end if
    if Dn1 = 1 then
      inc Menu
      if Menu > 3 then Menu = 0
    end if
    if Menu = 1 then
      if Lf1 = 1 then
        if StartWolves > 2 then dec StartWolves
      end if
      if Rt1 = 1 then
        if StartWolves < 9 then inc StartWolves
      end if
      ShowWolvesChoice
    end if
  end if
  Rearm
  sleep after 90 seconds
  nmi off
  if Press = 0 then goto tp_loop
  if Menu = 1 then Menu = 0
  Phase = 0
  StopMusic
  HideSprites
  return
end sub

sub ShowWolvesChoice:
  print at 18,16, "< >"
  put char StartWolves + 48 at 19,16
  return
end sub

' title sprites: the paw cursor (0), the howling wolf (1), the walker
' on the path (2-4), eyes in the trees (5)
sub TitleAnim:
  inc Cnt
  ' paw beside the chosen line
  V = Menu << 4
  V += 110
  set sprite 0 to V,64,SpPaw,11
  ' the wolf on the rock: sits, then howls at the moon
  V = Cnt & 127
  K = SpSit
  if V >= 64 then K = SpHowl
  set sprite 1 to 31,198,K,1
  ' the walker crosses the path, left to right
  X = Cnt
  V = Cnt >> 3
  V = V & 1
  K = V * 24
  K += SpManwalka0
  set sprite 2 to 86,X,K,SpManstandC0
  K += 4
  set sprite 3 to 86,X,K,SpManstandC1
  K += 4
  set sprite 4 to 86,X,K,SpManstandC2
  ' eyes open in the tree line now and then
  V = Cnt & 63
  if V < 40 then
    X = Cnt >> 6
    X = X & 7
    X = X * 28
    X += 18
    K = SpEyes0
    if V > 18 then
      if V < 22 then K = SpEyes1
    end if
    set sprite 5 to 76,X,K,11
  else
    hide sprite 5
  end if
  update sprites
  ' stars twinkle (2 Hz)
  V = Cnt & 31
  if V = 0 then
    V = Cnt & 32
    if V = 0 then
      copy TiPat + 8 count 8 to vram.pattern + 1024 + 8
    else
      copy TiPat + 24 count 8 to vram.pattern + 1024 + 8
    end if
  end if
  return
end sub

