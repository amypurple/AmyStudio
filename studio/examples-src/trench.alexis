u16 NextLvl = 250
bcd digits 5 ScoreB
bcd digits 4 BonusB
bcd digits 2 WaveB
u16 Spd = 331
u8 Ships = 3
u8 Lvl = 1
u8 Skill = 1
u8 Wave = 1
u8 Spawned = 0
u8 WaveN = 15
u8 Gap = 60
u8 Active = 0
u8 Pc = 128
u8 MOn = 0
u8 MQ = 0
u8 MLn = 128
u8 Die = 0
u8 Over = 0
u8 MsgT = 0
u8 BonusN = 0
u8 Kills = 0
u8 Rocks = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 WasStick = 0
u8 Menu = 1
u8 Tick = 0
u8 Idle = 0
u8 TitleOn = 0
u8 InPlay = 0
' loop counters (never shared with the helpers)
u8 Li = 0
u8 Di = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 V = 0

  tile screen
  set sound table TfSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 4 then goto title

  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  DrawSprites
  if Over = 0 then goto play_loop

  ' the end: a message, then back to the title on a press
  InPlay = 0
  print at 10,3, "          "
  print at 10,4, " GAME OVER "
  print at 10,5, "          "
  play sound SndOver
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  mute all
  goto title

' ---------------------------------------------------------------------------
' one frame of play

sub PlayStep:
  ' the trench: a new phase every 3 frames, drawn a third a frame (top,
  ' middle, bottom) so that one frame's work fits
  select case TrPart
  case 0
    TrPh = TrPh + TrSpd3
    call asm TrPartA
    TrPart = 1
  case 1
    call asm TrPartB
    TrPart = 2
  case else
    call asm TrPartC
    TrPart = 0
  end select
  if Die > 0 then
    Dying
    return
  end if
  MoveShip
  MoveShot
  MoveDrones
  if Die > 0 then return
  if BonusN > 0 then
    dec BonusN
    AddScore(75)
    return
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then DrawSkyRow(4)
  end if
  Spawn
  return
end sub

sub MoveShip:
  K = J1 | J2
  V = K & 4
  if V > 0 then
    if Pc > LaneMin then Pc = Pc - 2
  end if
  V = K & 8
  if V > 0 then
    if Pc < LaneMax then Pc = Pc + 2
  end if
  if Press = 1 then
    if MOn = 0 then
      MOn = 1
      MQ = ShotQ0
      MLn = Pc
      play sound SndFire
    end if
  end if
  return
end sub

sub MoveShot:
  if MOn = 0 then return
  if MQ < 12 then
    MOn = 0
    return
  end if
  MQ = MQ - ShotV
  return
end sub

' the distance between two bytes
function Dist(u8 A, u8 B) as u8
  if A > B then return A - B
  return B - A

' screen x (centre) of lane Ln at progress P: 128 +/- (|Ln - 128| x
' WTab[P]) / 64, by a small Z80 multiply (TrScrX)
function ScrX(u8 Ln, u8 P) as u8
  ArgL = Ln
  ArgP = P
  call asm TrScrX
  return ArgX

sub MoveDrones:
  u8 P = 0
  u8 St = 0
  u8 Ln = 0
  u8 Dx = 0
  u8 Bt = 0
  u16 Pos = 0
  Active = 0
  for Di = 0 to NDr - 1
    St = Dr[Di].St
    if St = 3 then
      Bt = Dr[Di].Bt - 1
      Dr[Di].Bt = Bt
      if Bt = 0 then Dr[Di].St = 0
      inc Active
    end if
    if St = 1 or St = 2 then
      inc Active
      Pos = Dr[Di].Pos
      if Pos > 65535 - Spd then
        ' it went by
        Dr[Di].St = 0
      else
        Pos = Pos + Spd
        Dr[Di].Pos = Pos
        P = highbyte(Pos)
        Ln = Dr[Di].Ln
        Dx = Dr[Di].Dx
        Ln = Steer(Ln, Dx, P)
        Dr[Di].Ln = Ln
        St = 0
        if MOn = 1 then
          if Dist(P, MQ) <= ShotDepth then
            if Dist(Ln, MLn) <= ShotLane then
              Blast(Di, P)
              St = 3
            end if
          end if
        end if
        if St <> 3 then
          if P >= HitP then
            if Dist(Ln, Pc) < HitLane then
              Crash
              return
            end if
          end if
        end if
      end if
    end if
  next
  return
end sub

' a drone's new lane: drift (Dx 1 left, 2 right, bouncing off the walls)
' or, for a kamikaze (Dx 3) while it is far away, a turn toward the fighter
function Steer(u8 Ln, u8 Dx, u8 P) as u8
  u8 L = Ln
  V = Tick & 3
  if V <> 0 then return L
  if Dx = 3 then
    if P < 180 then
      if L < Pc then inc L
      if L > Pc then dec L
    end if
    return L
  end if
  select case Dx
  case 1
    if L <= DrLo then
      Dr[Di].Dx = 2
    else
      dec L
    end if
  case 2
    if L >= DrHi then
      Dr[Di].Dx = 1
    else
      inc L
    end if
  end select
  return L

' the shot hit drone D (at progress P)
sub Blast(u8 D, u8 P):
  u8 Kind = Dr[D].St
  Dr[D].Sy = YTab[P]
  Dr[D].Sx = ScrX(Dr[D].Ln, P)
  Dr[D].St = 3
  Dr[D].Bt = BoomN
  MOn = 0
  play sound SndBoom
  if Kind = 1 then
    inc Kills
    AddScore(25)
  else
    inc Rocks
    AddScore(10)
  end if
  return
end sub

sub AddScore(u8 Pts):
  Score = Score + Pts
  ScoreB += Pts
  ' a new ship every 1000 points, 7 at most
  if Score >= NextShip then
    NextShip = NextShip + 1000
    if Ships < 7 then
      inc Ships
      DrawShips
      play sound SndExtra
    end if
  end if
  ' one level up every 250 points
  if Score >= NextLvl then
    NextLvl = NextLvl + 250
    if Lvl < 10 then
      inc Lvl
      Spd = SpdTab[Lvl]
      ShowLevel
    end if
  end if
  ShowScore
  return
end sub

' the fighter is hit: a burst, then the next ship (or the end)
sub Crash:
  Die = DieN
  MOn = 0
  play sound SndCrash
  for Li = 0 to NDr - 1
    Dr[Li].St = 0
  next
  return
end sub

sub Dying:
  dec Die
  if Die > 0 then return
  dec Ships
  DrawShips
  if Ships = 0 then
    Over = 1
    return
  end if
  Pc = 128
  Gap = 60
  return
end sub

' a new drone or rock now and then; the end of a wave
sub Spawn:
  u8 Slot = 255
  if Spawned >= WaveN then
    if Active = 0 then WaveOver
    return
  end if
  if Gap > 0 then
    dec Gap
    return
  end if
  if Active >= MaxAct[Lvl] then return
  for Li = 0 to NDr - 1
    if Dr[Li].St = 0 then Slot = Li
  next
  if Slot = 255 then return
  NewDrone(Slot)
  inc Spawned
  V = RndB7 & 31
  Gap = GapTab[Lvl] + V
  return
end sub

sub NewDrone(u8 S):
  u8 R = 0
  Dr[S].Pos = 0
  Dr[S].Dx = 0
  Dr[S].Bt = 0
  R = RndB7
  if R < 28 then
    ' a rock (about 1 in 5): straight down a random lane
    Dr[S].St = 2
    Dr[S].Ln = DrLo + RndB7
    return
  end if
  Dr[S].St = 1
  V = RndB7
  R = RndB & 15
  if R < KamiTab[Lvl] then
    ' kamikaze: steers toward the fighter while far
    Dr[S].Dx = 3
    Dr[S].Ln = DrLo + RndB7
    return
  end if
  ' aimed at the fighter's lane half the time, else anywhere
  V = RndB7
  R = RndB & 1
  if R = 0 then
    V = RndB7 & 15
    Dr[S].Ln = Clip(Pc + V - 8)
  else
    Dr[S].Ln = DrLo + RndB7
  end if
  R = RndB7 & 3
  if R = 3 then R = 0
  Dr[S].Dx = R
  return
end sub

' a random byte 0..127 (RndB holds the whole byte)
function RndB7 as u8
  Rand
  RndB = lowbyte(Rs)
  return RndB & 127

function Clip(u8 L) as u8
  if L < DrLo then return DrLo
  if L > DrHi then return DrHi
  return L

sub WaveOver:
  u8 Wi = 0
  BonusB = 0
  for Wi = 1 to Wave
    BonusB += 75
  next
  ' the bonus is counted in, 75 a frame (PlayStep)
  BonusN = Wave
  print at 6,4, "WAVE    CLEARED +    "
  print at 11,4, WaveB
  print at 23,4, BonusB
  MsgT = 150
  play sound SndLevel
  if Wave < 99 then
    inc Wave
    WaveB += 1
  end if
  Spawned = 0
  WaveN = 12 + 3 * Wave
  if WaveN > 45 then WaveN = 45
  Gap = 150
  return
end sub

sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' sprites: 0 the fighter, 1 its canopy, 2 the shot, 3-8 drones, 9 spare
sub DrawSprites:
  u8 P = 0
  u8 Sz = 0
  u8 X = 0
  u8 Y = 0
  u8 Pat = 0
  u8 Col = 0
  u8 St = 0
  u8 Sn = 0
  if InPlay = 0 then
    update sprites
    return
  end if
  X = Pc - 8
  if Die > 0 then
    Pat = SBoom2
    V = Die & 8
    if V > 0 then Pat = SBoom1
    if Die < 40 then
      set sprite 0 to 192,0,0,0
    else
      set sprite 0 to ShipY - 1,X,Pat,11
    end if
    set sprite 1 to 192,0,0,0
  else
    set sprite 0 to ShipY - 1,X,SShip,15
    set sprite 1 to ShipY - 1,X,SCanopy,6
  end if
  if MOn = 1 then
    X = ScrX(MLn, MQ) - 8
    Y = YTab[MQ] - 9
    Pat = SShot2
    if MQ > 120 then Pat = SShot1
    set sprite 2 to Y,X,Pat,11
  else
    set sprite 2 to 192,0,0,0
  end if
  for Di = 0 to NDr - 1
    Sn = Di + 3
    St = Dr[Di].St
    select case St
    case 1, 2
      P = highbyte(Dr[Di].Pos)
      X = ScrX(Dr[Di].Ln, P) - 8
      Y = YTab[P] - 9
      Sz = SzTab[P] << 2
      if St = 1 then
        Pat = SDr0 + Sz
        Col = 13
        if Dr[Di].Dx = 3 then Col = 8
      else
        Pat = SRk0 + Sz
        Col = 14
      end if
      set sprite Sn to Y,X,Pat,Col
    case 3
      X = Dr[Di].Sx - 8
      Y = Dr[Di].Sy - 9
      Pat = SBoom1
      if Dr[Di].Bt < 9 then Pat = SBoom2
      set sprite Sn to Y,X,Pat,9
    case else
      set sprite Sn to 192,0,0,0
    end select
  next
  update sprites
  return
end sub

sub ShowScore:
  print at 8,1, ScoreB
  return
end sub

sub ShowLevel:
  NumU = Lvl
  print at 17,1, digits$(NumU, 2)
  return
end sub

' the ships left, as icons in columns 22-28
sub DrawShips:
  for Li = 0 to 6
    C = 32
    if Li < Ships then C = TIcon
    J = 22 + Li
    put char C at J,1
  next
  return
end sub

' one row of the starry sky (rows 2-6)
sub DrawSkyRow(u8 R):
  u8 Cc = 0
  for Cc = 0 to 31
    V = Cc * 7 + R * 13
    V = V & 31
    select case V
    case 3
      C = TStar1
    case 17
      C = TStar2
    case else
      C = TSky
    end select
    put char C at Cc,R
  next
  return
end sub

' the trench: patterns in the three thirds, the map in rows 7-22, colours
sub DrawTrench:
  copy TrPat count TrN8 to vram.pattern + 1152
  copy TrPat count TrN8 to vram.pattern + 3200
  copy TrPat count TrN8 to vram.pattern + 5248
  copy TrMap count 256 to vram.name + 224
  copy TrMap + 256 count 256 to vram.name + 480
  for Li = 2 to 6
    DrawSkyRow(Li)
  next
  call asm TrUpdate
  return
end sub

sub ShowHud:
  print at 2,1, "SCORE"
  ShowScore
  print at 14,1, "LV"
  ShowLevel
  DrawShips
  return
end sub

sub NewGame:
  Skill = Menu
  Lvl = SkillLvl[Skill]
  Spd = SpdTab[Lvl]
  Score = 0
  ScoreB = 0
  NextShip = 1000
  NextLvl = 250
  WaveB = 1
  Ships = 3
  Wave = 1
  WaveN = 15
  Spawned = 0
  Gap = 90
  Pc = 128
  MOn = 0
  Die = 0
  Over = 0
  MsgT = 0
  BonusN = 0
  Kills = 0
  Rocks = 0
  for Li = 0 to NDr - 1
    Dr[Li].St = 0
  next
  TitleOn = 0
  NewScreen
  DrawTrench
  ShowHud
  InPlay = 1
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).fire then J1 = J1 | 16
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).fire then J2 = J2 | 16
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to NSpr - 1
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F1
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: the moving trench, the four levels, HOW TO PLAY, CREDITS
sub TitlePage:
  TitleOn = 1
  InPlay = 0
  NewScreen
  DrawTrench
  print at 10,2, "TRENCHFIRE"
  print at 4,3, "COMPUTE!'S GAZETTE 1984"
  print at 8,5, "BY DON GIBSON"
  print at 8,9, " BEGINNER     "
  print at 8,10, " INTERMEDIATE "
  print at 8,11, " ADVANCED     "
  print at 8,12, " EXPERT       "
  print at 8,13, " HOW TO PLAY  "
  print at 8,14, " CREDITS      "
  print at 5,21, " STICK: CHOOSE, FIRE: GO "
  ShowMenu
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 512
  TzOn = 1
  Rearm
  wait no fire
  nmi off
  WasStick = 3
  WasBtn = 16
tp_loop:
  Frame1
  inc Rs
  TrPh = TrPh + TrSpd
  call asm TrUpdate
  ReadPad
  V = J1 | J2
  V = V & 3
  if V > 0 then
    if WasStick = 0 then
      if V = 1 then
        if Menu > 0 then dec Menu
      else
        if Menu < 5 then inc Menu
      end if
      ShowMenu
    end if
  end if
  WasStick = V
  if Press = 0 then goto tp_loop
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  W16 = Tick
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 4 then HowToPage
  if Menu = 5 then CreditsPage
  return
end sub

sub ShowMenu:
  for Li = 9 to 14
    put char 32 at 8,Li
  next
  J = Menu + 9
  put char 62 at 8,J
  return
end sub

' HOW TO PLAY: two pages; a button turns the page, 30 s idle goes back
sub HowToPage:
  u8 Pg = 0
  u16 Wt = 0
ht_page:
  NewScreen
  print at 10,1, "HOW TO PLAY"
  if Pg = 0 then
    print at 2,3, "RACE DOWN THE TRENCH TO KING"
    print at 2,4, "KRYPOS' LAIR. HIS KAMIKAZE"
    print at 2,5, "DRONES AND ROCKS COME AT YOU"
    print at 2,6, "FROM THE FAR END."
    for Li = 8 to 14
      fill TSky count 28 at 2,Li
    next
    put char TStar1 at 4,9
    put char TStar2 at 26,12
    set sprite 0 to 115,120,SShip,15
    set sprite 1 to 115,120,SCanopy,6
    set sprite 2 to 95,120,SShot1,11
    set sprite 3 to 71,116,SDr3,13
    set sprite 4 to 79,168,SRk2,14
    set sprite 5 to 69,60,SDr1,8
    print at 2,16, "STICK LEFT/RIGHT: STEER."
    print at 2,17, "BUTTON: FIRE (ONE SHOT AT"
    print at 2,18, "A TIME). SHOOT THEM BEFORE"
    print at 2,19, "THEY GET CLOSE, OR DODGE!"
  else
    print at 2,3, "DRONE 25 POINTS, ROCK 10."
    print at 2,4, "A WAVE ENDS WITH A BONUS."
    print at 2,6, "YOU HAVE 3 SHIPS:"
    for Li = 0 to 2
      J = 20 + Li
      put char TIcon at J,6
    next
    print at 2,7, "A NEW ONE EVERY 1000 POINTS"
    print at 2,8, "(7 AT MOST). A HIT COSTS A"
    print at 2,9, "SHIP; THE LAST ONE ENDS THE"
    print at 2,10, "GAME."
    print at 2,12, "EVERY 250 POINTS THE LEVEL"
    print at 2,13, "GOES UP: FASTER, MORE"
    print at 2,14, "DRONES. RED DRONES STEER"
    print at 2,15, "TOWARD YOU!"
    set sprite 3 to 127,40,SDr2,8
    set sprite 4 to 127,80,SDr2,13
    set sprite 5 to 127,120,SRk2,14
    print at 2,19, "TIP: DON'T SIT STILL. MOVE"
    print at 2,20, "UNDER A DRONE, SHOOT, MOVE."
  end if
  print at 8,22, "PRESS A BUTTON"
  update sprites
  ShowScreen
  Rearm
  wait no fire
  nmi off
  WasBtn = 16
  Wt = 0
ht_loop:
  Frame1
  inc Rs
  ReadPad
  inc Wt
  if Wt >= 1800 then
    HideSprites
    return
  end if
  if Press = 0 then goto ht_loop
  inc Pg
  if Pg < 2 then goto ht_page
  HideSprites
  return
end sub

sub CreditsPage:
  NewScreen
  fill mode 2 text color with $F4
  backdrop dark blue
  print at 10,2, "TRENCHFIRE"
  print at 2,5, "FROM TRENCHFIRE BY"
  print at 2,6, "DON GIBSON, COMPUTE!'S"
  print at 2,7, "GAZETTE, MARCH 1984"
  print at 2,8, "(COMMODORE 64 AND VIC-20)."
  print at 2,11, "COLECOVISION GAME, MUSIC"
  print at 2,12, "AND PICTURES BY CLAUDE"
  print at 2,13, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,14, "IN AMY BY AMY BIENVENU,"
  print at 2,15, "2026."
  print at 2,17, "MUSIC: FAULT LINE"
  print at 2,18, "(ORIGINAL)"
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

data TilePat bytes
  $00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$08,$00,$00,$00,$00
  $00,$40,$00,$00,$00,$00,$02,$00
  $10,$10,$38,$38,$83,$01,$92,$00
  $00,$00,$00,$00,$00,$00,$00,$00
end data
data TileCol bytes
  $01,$01,$01,$01,$01,$01,$01,$01
  $01,$01,$01,$F1,$01,$01,$01,$01
  $01,$E1,$01,$01,$01,$01,$51,$01
  $F1,$F1,$F1,$F1,$1F,$1F,$F1,$01
  $0E,$01,$01,$01,$01,$01,$01,$01
end data
data SpritePat bytes
  $01,$01,$03,$02,$02,$07,$0F,$9F,$BF,$FF,$FF,$CF,$87,$06,$04,$00
  $80,$80,$C0,$40,$40,$E0,$F0,$F9,$FD,$FF,$FF,$F3,$E1,$60,$20,$00
  $00,$00,$00,$01,$01,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$80,$80,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$01,$01,$01,$01,$01,$01,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$80,$80,$80,$80,$80,$80,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$01,$01,$01,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$02,$01,$01,$02,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$40,$80,$80,$40,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$08,$0C,$07,$03,$03,$07,$0C,$08,$00,$00,$00,$00
  $00,$00,$00,$00,$10,$30,$E0,$C0,$C0,$E0,$30,$10,$00,$00,$00,$00
  $00,$00,$20,$30,$1C,$0F,$07,$06,$06,$07,$0F,$1C,$30,$20,$00,$00
  $00,$00,$04,$0C,$38,$F0,$E0,$60,$60,$E0,$F0,$38,$0C,$04,$00,$00
  $80,$C0,$70,$3C,$1F,$0F,$0E,$0C,$0C,$0E,$0F,$1F,$3C,$70,$C0,$80
  $01,$03,$0E,$3C,$F8,$F0,$70,$30,$30,$70,$F0,$F8,$3C,$0E,$03,$01
  $00,$00,$00,$00,$00,$00,$01,$03,$03,$01,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$00,$00,$80,$C0,$C0,$80,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$00,$03,$07,$0F,$0F,$0E,$0F,$07,$01,$00,$00,$00,$00
  $00,$00,$00,$00,$80,$E0,$F0,$B0,$F0,$F0,$E0,$80,$00,$00,$00,$00
  $00,$00,$03,$0F,$1F,$3F,$3F,$3F,$3B,$33,$3F,$1F,$0F,$03,$00,$00
  $00,$00,$C0,$F0,$F8,$BC,$3C,$FC,$FC,$FC,$FC,$F8,$F0,$80,$00,$00
  $03,$1F,$3F,$7F,$FE,$FF,$FF,$F7,$E7,$FF,$FF,$7F,$7F,$3F,$1F,$03
  $C0,$F8,$FC,$7E,$7F,$FF,$FF,$FF,$FF,$FF,$EF,$CE,$FE,$FC,$F8,$C0
  $00,$00,$00,$00,$0A,$05,$03,$0F,$0F,$03,$05,$0A,$00,$00,$00,$00
  $00,$00,$00,$00,$50,$A0,$C0,$F0,$F0,$C0,$A0,$50,$00,$00,$00,$00
  $80,$44,$20,$09,$40,$0A,$10,$D0,$10,$0A,$40,$09,$20,$44,$80,$00
  $81,$92,$04,$90,$02,$50,$08,$0B,$08,$50,$02,$90,$04,$92,$81,$00
end data

asm {
; TrUpdate: rewrite the colour table of the trench codes (TrBase..) from
; the line depths, the phase TrPh and the four band colours TrPal. Every
; code of a character row gets the same 8 colour bytes. 37+ cycles between
; VDP writes. Destroys AF, BC, DE, HL.
TrUpdate:
    call TrPartA
    call TrPartB
    jp TrPartC
; TrPartA: rows 7-11 (trench rows 0-4); B: rows 12-16; C: rows 17-22
TrPartA:
    ld a,(AMY_UDATA_TrAddr)
    out ($BF),a
    ld a,(AMY_UDATA_TrAddr+1)
    out ($BF),a
    ld hl,AMY_UDATA_TrDepth
    ld de,AMY_UDATA_TrRowN
    ld a,5
    jr TrGo
TrPartB:
    ld a,(AMY_UDATA_TrAddr+2)
    out ($BF),a
    ld a,(AMY_UDATA_TrAddr+3)
    out ($BF),a
    ld hl,AMY_UDATA_TrDepth+40
    ld de,AMY_UDATA_TrRowN+5
    ld a,5
    jr TrGo
TrPartC:
    ld a,(AMY_UDATA_TrAddr+4)
    out ($BF),a
    ld a,(AMY_UDATA_TrAddr+5)
    out ($BF),a
    ld hl,AMY_UDATA_TrDepth+80
    ld de,AMY_UDATA_TrRowN+10
    ld a,6
TrGo:
    ld b,a
TrRow:
    push bc
    push de
    ; the 8 colour bytes of this row's lines into TrBuf; the shadow DE
    ; holds the band colour table (no NMI can run: the pass has it off)
    exx
    ld de,AMY_UDATA_BandCol
    exx
    ld de,AMY_UVAR_TrBuf
    ld a,(AMY_UVAR_TrPh)
    ld c,a
    ld b,8
TrLn:
    ld a,(hl)
    inc hl
    add a,c
    rlca
    rlca
    and 3
    exx
    ld l,a
    ld h,0
    add hl,de
    ld a,(hl)
    exx
    ld (de),a
    inc de
    djnz TrLn
    pop de
    ld a,(de)
    inc de
    ld c,a
TrCode:
    push hl
    ld hl,AMY_UVAR_TrBuf
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    inc hl
    nop
    nop
    ld a,(hl)
    out ($BE),a
    pop hl
    dec c
    jr nz,TrCode
    pop bc
    djnz TrRow
    ret
;
; TrScrX: ArgX = 128 +/- (|ArgL - 128| x WTab[ArgP]) >> 6
TrScrX:
    ld a,(AMY_UVAR_ArgP)
    ld e,a
    ld d,0
    ld hl,AMY_UDATA_WTab
    add hl,de
    ld e,(hl)
    ld a,(AMY_UVAR_ArgL)
    sub 128
    ld c,0
    jr nc,TrXpos
    neg
    inc c
TrXpos:
    ld hl,0
    ld d,0
    ld b,8
TrXmul:
    add hl,hl
    rla
    jr nc,TrXno
    add hl,de
TrXno:
    djnz TrXmul
    add hl,hl
    add hl,hl
    ld a,h
    dec c
    jr z,TrXneg
    add a,128
    ld (AMY_UVAR_ArgX),a
    ret
TrXneg:
    neg
    add a,128
    ld (AMY_UVAR_ArgX),a
    ret
TfFire:
    db $40,$40,$20,$02,$40,$50,$30,$02,$40,$5F,$40,$02,$40,$71,$50,$02,$40,$8F,$60,$02,$50
TfBoom:
    db $00,$00,$04,$03,$00,$00,$25,$05,$00,$00,$36,$08,$00,$00,$66,$0A,$10
TfCrash:
    db $00,$00,$05,$06,$00,$00,$16,$0A,$00,$00,$36,$0E,$00,$00,$57,$14,$00,$00,$77,$18,$10
TfExtra:
