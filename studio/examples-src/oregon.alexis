' OREGON
' MECC's OREGON (Elementary Volume 6, Apple II; the disk's version "LAST
' UPDATE: 80/8/12"), after the 1971 game by Don Rawitsch, Bill Heinemann
' and Paul Dillenberger, for the ColecoVision in Amy by Amy Bienvenu.
' Ported by Claude (an AI made by Anthropic) for Amy Studio, 2026.
'
' Sources: the disk image MECC-A725 Elementary Vol. 6 v1.2: the programs
' OREGON (the setup and the shop) and OREGONA (the trip), listed from the
' disk in orig/ (orig/applesoft.py), and the shape table OREGONMAP (the map,
' the wagon, the trees, the deer, the riders, the wolves, the bullet, the
' letters), used byte for byte (art.py). Labels such as l3000 are the
' listing's line numbers.
'
' The trip: from Independence, Missouri, to Oregon City, 2040 miles in
' 1847, one fortnight a turn, with $700 for oxen, food, bullets, clothing
' and supplies. Each turn: the map, then hunt, stop at a fort (every
' other turn) or go on; eat poorly, moderately or well; riders or one of
' sixteen events; past 1050 miles the mountains, the South Pass and the
' Blue Mountains.
'
' Controls (either joystick): up and down choose in a list, the button
' chooses; an amount is set with the stick (up/down 1, right/left 10) and
' the button; on a hunt the button shoots. Keypad not used.
'
' Kept as the listing has them (these are how the game plays):
' - The arithmetic: miles and supplies keep their fractions until the
'   status line rounds them down; the map moves the wagon INT(M/24.8)
'   steps and, as its FOR loop starts at the last step again, one more
'   each turn, so the trail ends a little before 2040 miles.
' - Past 1050 miles the mountains come every turn: line 4720 tests
'   RND(-1), which is always tiny.
' - Cold without enough clothes is followed by the hail storm (line 4530
'   cannot reach its GOTO 6300); a bad illness cannot kill; missing every
'   wolf goes on to the eating question; a "bad illness" after a blizzard
'   goes back to the mountains.
' - A rider hit ends the fight before the shot is counted (40 bullets a
'   shot, 50 back); the ace marksman gets the fewest shots.
'
' Liberties taken:
' - Choices and amounts with the stick instead of typed numbers; amounts
'   go from 0 to the money left, so the negative purchases the listing
'   accepted are not possible. "PRESS SPACE BAR" says "PRESS A BUTTON".
' - Text rewrapped for 28 columns; the status line says CLOTH.
' - RND: a 16-bit generator. RND(-1)'s reseeding (line 4720 and 4790)
'   is not reproduced (see the README).
' - After December 20 the date stays at December 20 (the listing reads
'   past its 20 dates).
' - Apple hi-res columns 0-279 are drawn on 0-255 (the letters keep their
'   width).
' - The song plays once on the intro pages (the listing loops it).
'
' House rules kept: columns 2-29, rows 1-22 on text screens (the map and
' the hunt are pictures, as on the Apple); the frame loop is protected
' from the NMI and every screen is drawn with the NMI off after a wait.

const SndHush = 1
const SndBell = 2
const SndShot = 3
const SndTick = 4
const SndTuneA = 5
const SndTuneB = 6
' the tune now playing: frames left (counted in Rearm, once a frame)
u16 TzLeft = 0
u8 TzOn = 0

' --- the trip, named after the listing's variables ---------------------
' A oxen, F food, B bullets, C clothing, T cash: whole numbers
i16 Ox = 0
i16 Fd = 0
i32 Bu = 0
i16 Cl = 0
i16 Ca = 0
' M miles and M1 misc. supplies, in 65536ths (RND is a whole number of
' 65536ths, so every expression of the listing is exact)
i32 Mi = 0
i32 Md = 0
' D9 marksman 1-5, D3 the turn (1 = March 29), X1 the fort every other turn
u8 Sk = 0
u8 Tn = 0
u8 Fx = 0
' K8 injured, S4 seriously ill, E how well you eat
u8 Inj = 0
u8 Ill = 0
' the doctor is due this turn (kept across the map)
u8 Doc = 0
u8 Eat = 0
' S5 the riders' mood, T1 tactics, B8 bandits (1) or wild animals (2)
i8 Fr = 0
u8 Tac = 0
u8 B8 = 0
' L1 a blizzard this turn, C1 not enough clothes, F1 F2 the passes, M9
u8 Bz = 0
u8 Cd1 = 0
u8 Sp1 = 0
u8 Sp2 = 0
u8 M9 = 0
' the wagon on the map (P1, Q1, P2, Q2, W4, IG)
u16 Wx = 261
u8 Wy = 99
u8 Wdx = 0
u8 Wdy = 0
u16 W4 = 0
u8 Ig = 0
' the hunt: S1 hits, T7 shots, HS, A1 A2 the animal's two drawings, PK
' its place, KP the bullet's, SH a bullet in the air
u8 Hits = 0
u8 Shots = 0
u8 Hs = 0
u8 An1 = 0
u8 An2 = 0
u16 Pk = 0
u8 Kp = 0
u8 Sh = 0
u8 Hres = 0
' a choice (X), an amount
u8 Sel = 0
u8 Nopt = 0
u8 Oy = 0
u16 Nv = 0
u16 Nmax = 0
u8 Nx = 0
u8 Ny = 0
' the last amounts typed at the fort (F7, A7, C7, M7)
u16 F7 = 0

' --- drawing (OrDraw, OrText) -------------------------------------------
u8 Sn = 0
i16 Sx = 0
i16 Sy = 0
u8 Sm = 1
u8 Su = 0
u8 Lb = 0
i16 Cx = 0
i16 Cy = 0
u16 Sq = 0
u16 Tp = 0
u8 Bmp = 0

' --- random numbers ------------------------------------------------------
u16 Rs = $ACE1
u16 Rw = 0
u16 Rt = 0
u16 Rn = 0
u16 Rv = 0

' --- scratch ---------------------------------------------------------------
i32 Q = 0
i32 Q2 = 0
i32 Q2a = 0
u32 Uq = 0
u32 Uq2 = 0
u16 NumU = 0
u16 G = 0
u16 Gend = 0
u16 V16 = 0
' a loss: K = Kc + Km*RND (LoseMi, LoseMd)
u8 Km = 0
u8 Kc = 0
u8 Ly = 8
u8 I = 0
u8 J = 0
u8 K = 0
u8 V = 0
u8 W = 0
u8 X = 0
u8 Y = 0
u8 D1 = 0
u8 Up1 = 0
u8 Dn1 = 0
u8 Lf1 = 0
u8 Rt1 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Stick = 0
u8 WasStick = 0
u8 Rep = 0
u8 Tick = 0
' for the test bot: what the game waits for (1 a button, 2 a choice, 3 an
' amount, 4 yes or no, 5 the map, 6 a hunt) and the random state a hunt
' left
u8 Ask = 0
u8 Latch = 0
u8 FireWas = 0
u8 Fv = 0
u16 HuntRs = 0
' the songs' steps and the shapes' points use the VDP between frames
u8 Wt = 0

  ' no cartridge screen: the game starts on its title
  tile screen
  set sound table OrSoundTable areas 4
  nmi off
  HideSprites
  screen on

' ---------------------------------------------------------------------------
' OREGON: the title, the story, the shop

l10:
  TextScreen
  print at 10,2, "O R E G O N"
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 2316
  TzOn = 1
  print at 2,4, "THIS PROGRAM SIMULATES A"
  print at 2,5, "TRIP OVER THE OREGON TRAIL"
  print at 2,6, "FROM INDEPENDENCE, MISSOURI"
  print at 2,7, "TO OREGON CITY, OREGON IN"
  print at 2,8, "1847."
  print at 2,10, "YOUR FAMILY OF FIVE WILL"
  print at 2,11, "COVER THE 2040 MILE TRAIL IN"
  print at 2,12, "5 OR 6 MONTHS --"
  print at 6,14, "IF YOU MAKE IT ALIVE!"
  print at 2,16, "YOU HAD SAVED $900 TO SPEND"
  print at 2,17, "FOR THE TRIP, AND YOU'VE"
  print at 2,18, "JUST PAID $200 FOR A WAGON."
  ShowScreen
  GoOn
  ' (the button press seeds the random numbers)
  Rs = Rs ^ Tick
  Rt = Tick
  Rt = Rt << 8
  Rs = Rs ^ Rt
  if Rs = 0 then Rs = $ACE1
l270:
  TextScreen
  print at 2,1, "OXEN - YOU CAN SPEND"
  print at 2,2, "  $200-$300 ON YOUR TEAM."
  print at 2,3, "  THE MORE YOU SPEND, THE"
  print at 2,4, "  FASTER YOU WILL GO,"
  print at 2,5, "  BECAUSE YOU WILL HAVE"
  print at 2,6, "  BETTER ANIMALS."
  print at 2,8, "FOOD - THE MORE YOU HAVE,"
  print at 2,9, "  THE LESS CHANCE THERE IS"
  print at 2,10, "  OF SICKNESS."
  print at 2,12, "AMMUNITION - $1 BUYS A BELT"
  print at 2,13, "  OF 50 BULLETS. (YOU'LL BE"
  print at 2,14, "  SHOOTING AT ANIMALS AND"
  print at 2,15, "  BANDITS.)"
  print at 2,17, "CLOTHING - THIS IS VERY"
  print at 2,18, "  IMPORTANT FOR THE COLD"
  print at 2,19, "  WEATHER YOU WILL ENCOUNTER"
  print at 2,20, "  CROSSING THE MOUNTAINS."
  ShowScreen
  GoOn
  TextScreen
  print at 2,1, "MISCELLANEOUS SUPPLIES -"
  print at 2,2, "  THIS INCLUDES MEDICINE AND"
  print at 2,3, "  OTHER THINGS YOU WILL"
  print at 2,4, "  NEED."
  print at 2,7, "YOU CAN SPEND ALL OF YOUR"
  print at 2,8, "MONEY BEFORE YOU START YOUR"
  print at 2,9, "TRIP, OR AT FORTS ALONG THE"
  print at 2,10, "WAY. (ITEMS COST MORE AT THE"
  print at 2,11, "FORTS.)"
  print at 2,13, "YOU CAN HUNT ON YOUR WAY TO"
  print at 2,14, "OREGON. WHEN YOU DO HUNT,"
  print at 2,15, "YOU WILL BE SHOOTING AT"
  print at 2,16, "ANIMALS AS THEY MOVE ACROSS"
  print at 2,17, "THE SCREEN BY PRESSING A"
  print at 2,18, "BUTTON."
  print at 11,19, "GOOD LUCK!"
  ShowScreen
  GoOn
l370:
  TextScreen
  print at 2,3, "HOW GOOD A SHOT ARE YOU?"
  print at 4,5, "1. ACE MARKSMAN"
  print at 4,6, "2. GOOD SHOT"
  print at 4,7, "3. FAIR TO MIDDLIN'"
  print at 4,8, "4. NEED PRACTICE"
  print at 4,9, "5. SHAKY KNEES"
  print at 2,11, "CHOOSE ONE OF THE ABOVE --"
  print at 2,12, "THE BETTER YOU CLAIM YOU"
  print at 2,13, "ARE, THE LESS TIMES YOU WILL"
  print at 2,14, "HAVE TO SHOOT AT THE ANIMAL."
  ShowScreen
  Oy = 5
  Nopt = 5
  PickOne
  Sk = Sel
  TzOn = 0
  mute all

l800:
  ' the shop: each amount, then the sum
  TextScreen
  print at 2,1, "HOW MUCH DO YOU WANT TO"
  print at 2,2, "SPEND ON-"
  print at 2,4, "OXEN"
  print at 2,6, "FOOD"
  print at 2,8, "AMMUNITION"
  print at 2,10, "CLOTHING"
  print at 2,12, "MISC. SUPPLIES"
  ShowScreen
l830:
  Nx = 17
  Ny = 4
  Nmax = 700
  Nv = 0
  AskAmt
  if Nv < 200 then goto l834
  if Nv > 300 then goto l834
  goto l836
l834:
  print at 2,17, "SPEND FROM 200 TO 300"
  print at 2,18, "DOLLARS..."
  Pause1
  goto l830
l836:
  ClrRows17
  Ox = Nv
  Ny = 6
  Nv = 0
  AskAmt
  Fd = Nv
  Ny = 8
  Nv = 0
  AskAmt
  Bu = Nv
  Ny = 10
  Nv = 0
  AskAmt
  Cl = Nv
  Ny = 12
  Nv = 0
  AskAmt
  Md = Nv
  ' the sum (lines 876-890)
  print at 17,12, "+"
  print at 17,13, "-----"
  Ca = Ox + Fd
  V16 = lowword Bu
  Ca = Ca + V16
  Ca = Ca + Cl
  V16 = lowword Md
  Ca = Ca + V16
  print at 10,14, "TOTAL="
  print at 17,14, "$"
  NumU = Ca
  print at 18,14, width$(NumU, 4)
  print at 4,15, "SAVED      $ 700"
  print at 4,16, "SPENT     -$"
  print at 16,16, width$(NumU, 4)
  print at 15,17, "-----"
  Ca = 700 - Ca
  if Ca >= 0 then
    print at 4,18, "BALANCE    $"
    NumU = Ca
  else
    print at 4,18, "BALANCE   -$"
    V16 = 0 - Ca
    NumU = V16
  end if
  print at 16,18, width$(NumU, 4)
  if Ca >= 0 then goto l900
  print at 2,19, "YOU'VE SPENT TOO MUCH MONEY!"
  print at 2,20, "YOU ONLY HAVE $700 TO SPEND."
  print at 2,21, "TRY AGAIN..."
  GoOn
  goto l800
l900:
  print at 2,20, "YOU HAVE $"
  NumU = Ca
  X = 14
  if NumU > 9 then inc X
  if NumU > 99 then inc X
  if X = 14 then print at 12,20, digits$(NumU, 1)
  if X = 15 then print at 12,20, digits$(NumU, 2)
  if X = 16 then print at 12,20, digits$(NumU, 3)
  print at X,20, "DOLLARS LEFT"
  print at 2,21, "TO SPEND ALONG THE WAY..."
  GoOn
  TextScreen
  print at 2,12, "PREPARING FOR THE JOURNEY..."
  ShowScreen
  Pause1

' ---------------------------------------------------------------------------
' OREGONA: the trip (line 110 on)

  ' B became bullets: $1 buys 50
  Bu = Bu * 50
  Q = Md
  Md = Q << 16
  Fx = 1
  Tn = 0
  Mi = 0
  Wx = 261
  Wy = 99
  W4 = 0
  Ig = 0
  Inj = 0
  Ill = 0
  Eat = 0
  Sp1 = 0
  Sp2 = 0
  M9 = 0
  B8 = 0

l190:
  inc Tn
  ' 200: the doctor, for an injury or a serious illness
  Doc = Inj | Ill
  if Doc = 1 then
    Ca = Ca - 20
    if Ca < 0 then goto l5080
  end if
  ' 201: the map
  MapScreen
  if Ig = 1 then goto l6050
  TextScreen
  if Doc = 1 then
    Inj = 0
    Ill = 0
    print at 2,7, "THE DOCTOR'S BILL IS $20."
    ShowStatus
  end if
  if Fd < 13 then
    print at 2,8, "YOU'D BETTER DO SOME HUNTING"
    print at 2,9, "OR BUY SOME FOOD AND SOON!"
  end if
  ShowStatus
  DateLine
  ShowScreen
  if Fx = 1 then
    Fx = 0
  else
    Fx = 1
  end if
l210:
  if Fx = 1 then goto l270t
  print at 2,11, "DO YOU WANT TO-"
  print at 4,13, "1. STOP AT THE NEXT FORT"
  print at 4,14, "2. HUNT"
  print at 4,15, "3. CONTINUE"
  Oy = 13
  Nopt = 3
  PickOne
  goto l290
l270t:
  print at 2,11, "DO YOU WANT TO-"
  print at 4,13, "1. HUNT"
  print at 4,14, "2. CONTINUE"
  Oy = 13
  Nopt = 2
  PickOne
  inc Sel
l290:
  if Sel = 2 then
    if Bu <= 40 then
      print at 2,20, "TOUGH-YOU NEED MORE BULLETS"
      print at 2,21, "TO HUNT!"
      GoOn
      ' (500 ends in HOME: the menu comes back alone on the screen)
      TextScreen
      ShowScreen
      goto l210
    end if
  end if
  An1 = 2
  An2 = 3
  if Sel = 1 then goto l350
  if Sel = 2 then goto l1000
  goto l3000

l350:
  ' the fort: what was paid buys two thirds as much
  ClrMsg
  ClrLow
  print at 2,7, "HOW MUCH DO YOU WANT TO"
  print at 2,8, "SPEND ON-"
  print at 2,11, "FOOD?"
  Nx = 17
  Ny = 11
  FortAmount
  Uq = F7
  Uq = Uq << 1
  Uq = Uq / 3
  V16 = lowword Uq
  Fd = Fd + V16
  ShowStatus
  ClrLow
  print at 2,11, "AMMUNITION?"
  Ny = 11
  FortAmount
  ' B = INT(B + 2/3*A7*50)
  Uq = F7
  Uq = Uq * 100
  Uq = Uq / 3
  Q = Uq
  Bu = Bu + Q
  ShowStatus
  ClrLow
  print at 2,11, "CLOTHES?"
  Ny = 11
  FortAmount
  Uq = F7
  Uq = Uq << 1
  Uq = Uq / 3
  V16 = lowword Uq
  Cl = Cl + V16
  ShowStatus
  ClrLow
  print at 2,11, "MISCELLANEOUS?"
  Ny = 11
  FortAmount
  Uq = F7
  Uq = Uq << 1
  Uq = Uq / 3
  Q = Uq
  Q = Q << 16
  Md = Md + Q
  ShowStatus
  goto l3000

l1000:
  ' a hunt: the food is S1 times 5 to 14, the bullets 8 a claimed skill
  HuntRun
  if Hres = 1 then goto l3170
l1430:
  if An1 = 5 then goto l3170
  Rn = 10
  RndK
  V = Rv + 5
  V16 = V
  V16 = V16 * Hits
  Fd = Fd + V16
  V = Sk << 3
  Q = V
  Bu = Bu - Q

l3000:
  TextScreen
  ShowStatus
  DateLine
  ShowScreen
  if Fd < 13 then goto l5060
  print at 2,10, "DO YOU WANT TO EAT-"
  print at 4,12, "1. POORLY"
  print at 4,13, "2. MODERATELY"
  print at 4,14, "3. WELL"
  Oy = 12
  Nopt = 3
  PickOne
  Eat = Sel
  ' 3020: F = F - 8 - 5*E
  V = Eat * 5
  V = V + 8
  V16 = V
  Fd = Fd - V16
  if Fd >= 0 then goto l3050
  Fd = Fd + V16
  print at 2,21, "YOU CAN'T EAT THAT WELL!"
  GoOn
  goto l3000
l3050:
  ' M = M + 200 + (A-220)/5 + INT(RND*10), then INT
  Q = Ox
  Q = Q - 220
  Q2 = Q / 5
  ' (whole division rounds toward zero; INT rounds down)
  Q = Q2 * 5
  Q2a = Ox
  Q2a = Q2a - 220
  Q = Q2a - Q
  if Q < 0 then Q2 = Q2 - 1
  Q2 = Q2 + 200
  Rn = 10
  RndK
  Q = Rv
  Q2 = Q2 + Q
  Q2 = Q2 << 16
  Mi = Mi + Q2
  Bz = 0
  Cd1 = 0
  ShowStatus
l3100:
  ' riders, most likely near 400 miles: none when RND*10 > ((M/100-4)^2
  ' +72)/((M/100-4)^2+12)-1, that is when RND*65536 > 3932160000 over
  ' (M-400)^2+120000
  Q = Mi >> 16
  Q = Q - 400
  Q = Q * Q
  Uq = Q
  Uq = Uq + 120000
  Uq2 = 3932160000
  Uq2 = Uq2 / Uq
  Rnd16
  Uq = Rw
  if Uq > Uq2 then goto l4010

l3110:
  ClrMsg
  ClrLow
  Fr = 0
  print at 2,10, "RIDERS AHEAD...THEY"
  Rnd16
  if Rw >= 52429 then
    print at 2,11, "DON'T LOOK HOSTILE."
    Fr = 1
  else
    print at 2,11, "LOOK HOSTILE."
  end if
  print at 2,13, "TACTICS -"
  print at 4,15, "1. RUN"
  print at 4,16, "2. ATTACK"
  print at 4,17, "3. CONTINUE"
  print at 4,18, "4. CIRCLE YOUR WAGONS"
  Oy = 15
  Nopt = 4
  PickOne
  Tac = Sel
  Rnd16
  if Rw >= 52429 then Fr = Fr - 1
  if Fr = 1 then goto l3300
  if Tac > 1 then goto l3150
  ' 3146: running from hostile riders
  Mi = Mi + 327680
  Bu = Bu - 150
  Ox = Ox - 40
  goto l3470
l3150:
  if Tac = 3 then goto l3200
  ' a fight: the riders cross the screen
  An1 = 5
  An2 = 6
  goto l1000
l3170:
  TextScreen
  ShowStatus
  DateLine
  ShowScreen
  if B8 = 1 then goto l3965
  if B8 = 2 then goto l4350
  ' 3174: B = B - (T7*40 - 50)
  V16 = Shots
  V16 = V16 * 40
  Q = V16
  Q = Q - 50
  Bu = Bu - Q
  if Tac = 4 then Mi = Mi - 1638400
  if Hs = 0 then
    print at 2,12, "LOUSY SHOOTING - - - YOU GOT"
    print at 2,13, "KNIFED"
    Inj = 1
    print at 2,14, "YOU'LL HAVE TO SEE 'OL DOC"
    print at 2,15, "BLANCHARD!"
    GoOn
  end if
  goto l3470
l3200:
  Rnd16
  if Rw >= 52429 then
    print at 2,20, "YOU ARE LUCKY..."
    print at 2,21, "THEY DIDN'T ATTACK."
    GoOn
    goto l190
  end if
  Bu = Bu - 150
  Km = 0
  Kc = 15
  LoseMd
  goto l3470
l3300:
  ' friendly riders
  if Tac = 1 then
    Mi = Mi + 983040
    Ox = Ox - 10
    goto l3470
  end if
  if Tac = 2 then
    Km = 0
    Kc = 5
    LoseMi
    Bu = Bu - 100
  end if
  if Tac = 4 then Mi = Mi - 1310720
l3470:
  ' (10000 and 10050 clear the rows below the status; 12000 does not come
  ' before the bullet check, so bullets can still be below zero)
  ClrMsg
  ClrLow
  if Fr = 1 then
    print at 2,12, "THE RIDERS WERE FRIENDLY,"
    print at 2,13, "BUT CHECK FOR POSSIBLE"
    print at 2,14, "LOSSES!"
    GoOn
    goto l190
  end if
  print at 2,12, "THE RIDERS WERE HOSTILE."
  print at 2,13, "CHECK FOR LOSSES!"
  if Bu >= 0 then
    GoOn
    goto l190
  end if
  print at 2,14, "YOU RAN OUT OF BULLETS,"
  print at 2,15, "AND YOU WERE MASACRED!"
  goto l5170

l4010:
  ' one of sixteen events: RND*100 against the table of line 14000
  ClrMsg
  ClrLow
  Ly = 8
  Rnd16
  D1 = 0
l4020:
  inc D1
  if D1 = 16 then goto l4670
  ' R1 > D: RND*100 > D, that is RND*6553600 > D*65536
  Uq = Rw
  Uq = Uq * 100
  V = EventAt[D1]
  Uq2 = V
  Uq2 = Uq2 << 16
  if Uq > Uq2 then goto l4020
  if D1 = 1 then goto l3660
  if D1 = 2 then goto l3700
  if D1 = 3 then goto l3740
  if D1 = 4 then goto l3790
  if D1 = 5 then goto l3820
  if D1 = 6 then goto l3850
  if D1 = 7 then goto l3880
  if D1 = 8 then goto l3960
  if D1 = 9 then goto l4130
  if D1 = 10 then goto l4190
  ' 4036: a blank line before the last six
  Nl1
  if D1 = 11 then goto l4220
  if D1 = 12 then goto l4290
  if D1 = 13 then goto l4340
  if D1 = 14 then goto l4560
  goto l4610

l3660:
  print at 2,Ly, "YOUR WAGON HAS BROKEN"
  Nl1
  print at 2,Ly, "DOWN..."
  Nl1
  print at 2,Ly, "LOSE TIME AND SUPPLIES"
  Nl1
  print at 2,Ly, "FIXING"
  Nl1
  print at 2,Ly, "IT."
  Nl1
  ' M = M - 15 - 5*RND: M1 = M1 - 8
  Km = 5
  Kc = 15
  LoseMi
  Km = 0
  Kc = 8
  LoseMd
  goto l4710
l3700:
  print at 2,Ly, "OX INJURES LEG. SLOWS YOU"
  Nl1
  print at 2,Ly, "DOWN FOR THE REST OF THE"
  Nl1
  print at 2,Ly, "TRIP"
  Nl1
  Km = 0
  Kc = 25
  LoseMi
  Ox = Ox - 20
  goto l4710
l3740:
  print at 2,Ly, "BAD LUCK. YOUR DAUGHTER"
  Nl1
  print at 2,Ly, "BROKE"
  Nl1
  print at 2,Ly, "HER ARM, YOU USED SUPPLIES"
  Nl1
  print at 2,Ly, "HELPING HER."
  Nl1
