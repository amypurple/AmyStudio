' ---------------------------------------------------------------------------
' Screens

' TextScreen: back to text (after the map or a hunt), all rows cleared
sub TextScreen:
  Rearm
  wait
  nmi off
  display off
  if Bmp = 1 then
    call asm OrFont
    Bmp = 0
  end if
  fill 32 count 768 to vram.name
  copy Dollar count 8 to vram.pattern + 288
  copy Dollar count 8 to vram.pattern + 2336
  copy Dollar count 8 to vram.pattern + 4384
  Ly = 8
  return
end sub

sub ShowScreen:
  screen on
  nmi off
  return
end sub

' BitmapScreen: the three thirds as one bitmap (Apple HGR2), cleared
sub BitmapScreen:
  Rearm
  wait
  nmi off
  display off
  Bmp = 1
  fill 0 count 6144 to vram.pattern
  copy Ident count 256 to vram.name
  copy Ident count 256 to vram.name + 256
  copy Ident count 256 to vram.name + 512
  return
end sub

' Status (lines 12000-12025): whole numbers, nothing below zero, shown
sub ShowStatus:
  if Md < 0 then
    Md = 0
  else
    Q = Md >> 16
    Md = Q << 16
  end if
  Q = Mi >> 16
  Mi = Q << 16
  if M9 = 1 then
    Mi = 62259200
    M9 = 0
  end if
  if Fd < 0 then Fd = 0
  if Bu < 0 then Bu = 0
  if Cl < 0 then Cl = 0
  fill 45 count 28 at 2,3
  print at 2,4, "FOOD BULLETS CLOTH MISC CASH"
  fill 32 count 28 at 2,5
  NumU = Fd
  print at 2,5, width$(NumU, 4)
  NumU = lowword Bu
  print at 9,5, width$(NumU, 5)
  NumU = Cl
  print at 15,5, width$(NumU, 5)
  Q = Md >> 16
  NumU = lowword Q
  print at 21,5, width$(NumU, 4)
  NumU = 0
  if Ca > 0 then NumU = Ca
  print at 26,5, width$(NumU, 4)
  fill 45 count 28 at 2,6
  return
end sub

' DateLine (12500): the day and the miles
sub DateLine:
  fill 32 count 28 at 2,1
  fill 32 count 28 at 2,2
  print at 2,1, "MONDAY- "
  X = 10
  Y = 1
  V = Tn
  if V > 20 then V = 20
  V16 = V - 1
  V16 = V16 * 13
  Tp = address of Dates
  Tp = Tp + V16
  call asm OrPut
  X = X + Rv
  print at X,1, ",1847"
  print at 17,2, "MILES="
  Q = Mi >> 16
  NumU = lowword Q
  print at 24,2, width$(NumU, 5)
  return
end sub

' ClrMsg (10050): rows 7-8; ClrLow (10000): rows 9-22
sub ClrMsg:
  fill 32 count 32 at 0,7
  fill 32 count 32 at 0,8
  return
end sub

sub ClrLow:
  for Y = 9 to 22
    fill 32 count 32 at 0,Y
  next
  return
end sub

sub ClrRows17:
  for Y = 17 to 21
    fill 32 count 32 at 0,Y
  next
  return
end sub

' NL: the next line of a message; a full screen waits for the button
sub Nl1:
  inc Ly
  if Ly > 21 then
    ' (a page break of this port's: Ask 7 for the bot)
    print at 3,22, "PRESS A BUTTON TO CONTINUE"
    Ask = 7
    WaitPress
    Ask = 0
    fill 32 count 32 at 0,22
    for Y = 7 to 21
      fill 32 count 32 at 0,Y
    next
    Ly = 7
  end if
  return
end sub

' Continue (505): PRESS A BUTTON TO CONTINUE, then the row is cleared
sub GoOn:
  print at 3,22, "PRESS A BUTTON TO CONTINUE"
  Ask = 1
  WaitPress
  Ask = 0
  fill 32 count 32 at 0,22
  return
end sub

' Choose: a list of Nopt choices at rows Oy on, column 4; Sel = 1-Nopt
sub PickOne:
  Ask = 2
  Sel = 1
  WasBtn = 1
ch_draw:
  for I = 1 to Nopt
    Y = Oy + I
    dec Y
    print at 2,Y, " "
  next
  Y = Oy + Sel
  dec Y
  print at 2,Y, ">"
ch_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Sel > 1 then dec Sel
    end if
    if Dn1 = 1 then
      if Sel < Nopt then inc Sel
    end if
    goto ch_draw
  end if
  if Press = 0 then goto ch_loop
  play sound SndTick
  Ask = 0
  return
end sub

' YesNo: YES or NO on the row after the question's (Sel 1 = YES)
sub AskYes:
  Ask = 4
  Sel = 1
  WasBtn = 1
yn_draw:
  print at 3,Oy, " YES   NO "
  X = 3
  if Sel = 2 then X = 9
  print at X,Oy, ">"
yn_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Lf1 = 1 then Sel = 1
    if Up1 = 1 then Sel = 1
    if Rt1 = 1 then Sel = 2
    if Dn1 = 1 then Sel = 2
    goto yn_draw
  end if
  if Press = 0 then goto yn_loop
  play sound SndTick
  Ask = 0
  return
end sub

' Amount: a number set with the stick at Nx, Ny ("? " then the number),
' 0 to Nmax: up and down 1, right and left 10
sub AskAmt:
  Ask = 3
  print at Nx,Ny, "?"
  WasBtn = 1
am_draw:
  X = Nx + 2
  NumU = Nv
  print at X,Ny, width$(NumU, 3)
am_loop:
  Frame1
  ReadPad
  if Stick = 1 then
    if Up1 = 1 then
      if Nv < Nmax then inc Nv
    end if
    if Dn1 = 1 then
      if Nv > 0 then dec Nv
    end if
    if Rt1 = 1 then
      Nv = Nv + 10
      if Nv > Nmax then Nv = Nmax
    end if
    if Lf1 = 1 then
      if Nv > 10 then
        Nv = Nv - 10
      else
        Nv = 0
      end if
    end if
    goto am_draw
  end if
  if Press = 0 then goto am_loop
  play sound SndTick
  print at Nx,Ny, " "
  Ask = 0
  return
end sub

' FortAmount: an amount at the fort, at most the cash left (line 400 never
' needed then); T = T - amount
sub FortAmount:
  Nmax = 0
  if Ca > 0 then Nmax = Ca
  Nv = 0
  AskAmt
  F7 = Nv
  V16 = Nv
  Ca = Ca - V16
  return
end sub

' TypeLine: a line of the telegram at row Y, a letter at a time
sub TypeLine:
  X = 2
tl_loop:
  V = peek(Tp)
  inc Tp
  if V = 0 then return
  call asm OrChar
  play sound SndTick
  Frame1
  Frame1
  Frame1
  inc X
  goto tl_loop
end sub

' MapScreen (17000-17999): the map, the date, the miles, the wagon
sub MapScreen:
  BitmapScreen
  DrawMap
  ' the date (past December 20 it stays there) and the year
  Sx = 5
  Sy = 150
  V = Tn
  if V > 20 then V = 20
  V16 = V - 1
  V16 = V16 * 13
  Tp = address of Dates
  Tp = Tp + V16
  call asm OrText
  Tp = address of Tx1847
  call asm OrText
  Sx = 150
  Sy = 150
  Tp = address of TxMiles
  call asm OrText
  Q = Mi >> 16
  NumU = lowword Q
  DrawNum
  ShowScreen
  if Mi = 0 then
    ' 17005: the wagon at the start
    Sm = 1
    DrawWagon
    W4 = 1
    goto ms_done
  end if
  ' 17006: FOR G = W4 TO INT(M/24.8) (a FOR runs at least once)
  Q = Mi * 5
  Q = Q / 8126464
  Gend = lowword Q
  G = W4
ms_step:
  if Wx = 261 then
    Wdx = 4
    Wdy = 1
  end if
  if Wx = 165 then
    Wdx = 2
    Wdy = 0
  end if
  if Wx = 113 then
    Wdx = 1
    Wdy = 2
  end if
  if Wx = 96 then
    Wdx = 2
    Wdy = 0
  end if
  if Wx <= 66 then
    Ig = 1
    goto ms_arrive
  end if
  Sm = 1
  DrawWagon
  for J = 1 to 8
    Frame1
  next
  Sm = 0
  DrawWagon
  Sm = 1
  DrawMap
  Wx = Wx - Wdx
  Wy = Wy - Wdy
  inc G
  if G <= Gend then goto ms_step
  W4 = Gend
  goto ms_done
ms_arrive:
  ' 17080: the wagon blinks, the bell rings
  Sm = 1
  DrawWagon
  for J = 1 to 30
    Frame1
  next
  for K = 1 to 15
    Sm = 0
    DrawWagon
    Frame1
    Sm = 1
    DrawWagon
    play sound SndBell
    for J = 1 to 6
      Frame1
    next
  next
ms_done:
  Sm = 1
  DrawWagon
  Sx = 49
  Sy = 181
  Tp = address of TxPress
  call asm OrText
  Ask = 5
  WaitPress
  Ask = 0
  return
end sub

sub DrawMap:
  Su = 0
  Sn = 8
  Sx = 1
  Sy = 1
  call asm OrDraw
  Sn = 9
  Sx = 1
  Sy = 1
  call asm OrDraw
  return
end sub

sub DrawWagon:
  Su = 0
  Sn = 10
  Sx = Wx
  Sy = Wy
  call asm OrDraw
  return
end sub

' DrawNum: NumU in the shape table's digits at Sx, Sy
sub DrawNum:
  Su = 1
  Sm = 1
  V16 = 10000
  W = 0
dn_loop:
  V = 0
dn_count:
  if NumU >= V16 then
    NumU = NumU - V16
    inc V
    goto dn_count
  end if
  if V > 0 then W = 1
  if V16 = 1 then W = 1
  if W = 1 then
    Sn = V + 20
    call asm OrDraw
    Sx = Sx + 7
  end if
  V16 = V16 / 10
  if V16 > 0 then goto dn_loop
  Su = 0
  return
end sub

' Hunt (1000-1435): the animal (A1, A2) runs left to right in random
' jumps; the button sends a bullet up from the middle; it hits if the
' animal is within reach when it gets there. Hres 1: a rider or a wolf
' was hit (the listing's jump to 3170).
sub HuntRun:
  Ask = 6
  BitmapScreen
  Hits = 0
  Shots = 0
  Hres = 0
  Sm = 1
  Sx = 60
  Sy = 172
  Tp = address of TxShoot
  call asm OrText
  ' 1010: seven trees, a pine or an oak, at random heights
  G = 20
hu_tree:
  Rnd16
  Sn = 1
  if Rw < 32768 then Sn = 7
  Rn = 15
  RndK
  Su = 0
  Sx = G
  Sy = Rv
  call asm OrDraw
  Sx = G + 1
  Sy = Rv
  call asm OrDraw
  G = G + 40
  if G <= 260 then goto hu_tree
  ShowScreen
  Kp = 166
  Hs = 0
  Sh = 0
  Latch = 0
  FireWas = 1
hu_1020:
  Pk = 46
hu_1030:
  HuntKey
  Rn = 25
  RndK
  Pk = Pk + Rv
  if Pk > 260 then goto hu_1020
  Sm = 1
  Sn = An1
  DrawAnimal
  if Sh = 1 then ShotStep
  if Hs > 0 then
    HitOrMiss
    if Hs = 1 then
      if An1 = 5 then
        Hres = 1
        HuntRs = Rs
        Ask = 0
        return
      end if
      if An1 = 13 then
        Hres = 1
        HuntRs = Rs
        Ask = 0
        return
      end if
    end if
    Hs = 0
    inc Shots
    if Shots > Sk then goto hu_end
  end if
  Sm = 0
  Sn = An1
  DrawAnimal
  HuntKey
  Rn = 25
  RndK
  Pk = Pk + Rv
  if Pk > 260 then goto hu_1020
  Sm = 1
  Sn = An2
  DrawAnimal
  if Sh = 1 then ShotStep
  if Hs > 0 then
    HitOrMiss
    if Hs = 1 then
      if An1 = 5 then
        Hres = 1
        HuntRs = Rs
        Ask = 0
        return
      end if
      if An1 = 13 then
        Hres = 1
        HuntRs = Rs
        Ask = 0
        return
      end if
    end if
    Hs = 0
    inc Shots
    if Shots > Sk then goto hu_end
  end if
  Sm = 0
  Sn = An2
  DrawAnimal
  goto hu_1030
hu_end:
  for J = 1 to 60
    Frame1
  next
  HuntRs = Rs
  Ask = 0
  return
end sub

' HuntKey (1030): the button fires when no bullet is in the air
sub HuntKey:
  Frame1
  if Latch = 0 then return
  if Kp <> 166 then return
  Latch = 0
  play sound SndShot
  Sh = 1
  ' 35000: the hit or miss of the last shot is wiped
  Sm = 0
  Sx = 100
  Sy = 183
  Tp = address of TxHit
  call asm OrText
  Sx = 100
  Sy = 183
  Tp = address of TxMissed
  call asm OrText
  Sm = 1
  return
end sub

sub DrawAnimal:
  Su = 0
  Sx = Pk
  Sy = 55
  call asm OrDraw
  return
end sub

' Bullet (1200): 9 lines up a step; at the top, a hit or a miss
sub ShotStep:
  Su = 0
  Sn = 4
  Sx = 130
  Sm = 0
  Sy = Kp
  call asm OrDraw
  Kp = Kp - 9
  Sm = 1
  Sy = Kp
  call asm OrDraw
  if Kp > 70 then return
  Sm = 0
  Sy = Kp
  call asm OrDraw
  Sn = An1
  DrawAnimal
  Sn = An2
  DrawAnimal
  Sh = 0
  Kp = 166
  Latch = 0
  Hs = 1
  if Pk < 125 then Hs = 2
  if Pk > 173 then Hs = 2
  return
end sub

' HitOrMiss (1400)
sub HitOrMiss:
  Sm = 1
  Sx = 100
  Sy = 183
  if Hs = 1 then
    Tp = address of TxHit
    call asm OrText
    play sound SndBell
    inc Hits
    Pk = 46
  else
    Tp = address of TxMissed
    call asm OrText
  end if
  return
end sub

sub CreditsPage:
  TextScreen
  print at 12,1, "OREGON"
  print at 2,3, "MECC'S OREGON (ELEMENTARY"
  print at 2,4, "VOLUME 6, APPLE II, 1980),"
  print at 2,5, "AFTER THE 1971 GAME BY DON"
  print at 2,6, "RAWITSCH, BILL HEINEMANN AND"
  print at 2,7, "PAUL DILLENBERGER."
  print at 2,9, "FOR THE COLECOVISION BY"
  print at 2,10, "CLAUDE (AN AI MADE BY"
  print at 2,11, "ANTHROPIC) FOR AMY STUDIO,"
  print at 2,12, "2026, IN AMY, THE LANGUAGE"
  print at 2,13, "BY AMY BIENVENU."
  print at 2,15, "MUSIC: SWEET BETSY FROM PIKE"
  print at 2,16, "(TRADITIONAL), AS MECC'S"
  print at 2,17, "PROGRAM PLAYED IT."
  print at 2,19, "PICTURES: MECC'S SHAPES."
  ShowScreen
  GoOn
  return
end sub

' ---------------------------------------------------------------------------
' Frames, pads, random numbers

sub Rearm:
  ' a tune plays once (Tiny Sound loops): stop it when its time is up
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  ' a hunt latches the button like the Apple's keyboard strobe: a press is
  ' kept until the game takes it or clears it (POKE -16368)
  if Ask = 6 then
    Fv = 0
    if joypad(1).fire then Fv = 1
    if joypad(2).fire then Fv = 1
    if Fv = 1 then
      if FireWas = 0 then Latch = 1
    end if
    FireWas = Fv
  end if
  return
end sub

sub Pause1:
  for J = 1 to 60
    Frame1
  next
  return
end sub

sub WaitPress:
  WasBtn = 1
wp_loop:
  Frame1
  ReadPad
  if Press = 0 then goto wp_loop
  return
end sub

sub ReadPad:
  Up1 = 0
  Dn1 = 0
  Lf1 = 0
  Rt1 = 0
  Btn = 0
  if joypad(1).up then Up1 = 1
  if joypad(2).up then Up1 = 1
  if joypad(1).down then Dn1 = 1
  if joypad(2).down then Dn1 = 1
  if joypad(1).left then Lf1 = 1
  if joypad(2).left then Lf1 = 1
  if joypad(1).right then Rt1 = 1
  if joypad(2).right then Rt1 = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Stick = 0
  V = Up1 | Dn1
  V = V | Lf1
  V = V | Rt1
  if V = 1 then
    if WasStick = 0 then
      Stick = 1
      Rep = 16
    else
      dec Rep
      if Rep = 0 then
        Stick = 1
        Rep = 4
      end if
    end if
  end if
  WasStick = V
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count 1
  set sprite 0 to 192,0,0,0
  update sprites
  return
end sub

' Rnd: RND(1) as Rw/65536 (a 16-bit xorshift, 7 9 8; never 0)
sub Rnd16:
  Rt = Rs << 7
  Rs = Rs ^ Rt
  Rt = Rs >> 9
  Rs = Rs ^ Rt
  Rt = Rs << 8
  Rs = Rs ^ Rt
  Rw = Rs
  return
end sub

' LoseMi, LoseMd: M (or M1) = M - Kc - Km*RND (a new RND when Km > 0)
sub LoseMi:
  if Km > 0 then Rnd16
  call asm OrLose with hl = address of Mi
  return
end sub

sub LoseMd:
  if Km > 0 then Rnd16
  call asm OrLose with hl = address of Md
  return
end sub

' RndK: Rv = INT(RND*Rn)
sub RndK:
  Rnd16
  Uq = Rw
  Uq2 = Rn
  Uq = Uq * Uq2
  Uq = Uq >> 16
  Rv = lowword Uq
  return
end sub

