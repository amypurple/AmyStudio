    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01,$01
    db $01,$01,$01,$01,$01,$01
    db $FF

; ---------------------------------------------------------------------------
; OrDraw: Applesoft DRAW of shape Sn (1-based) of ShapeTab at Sx, Sy
; (Apple hi-res coordinates), setting (Sm 1) or clearing (Sm 0) its
; points. Each byte holds vectors A (bits 0-2), B (3-5), C (6-7); a
; vector's bit 2 plots before moving (0 up, 1 right, 2 down, 3 left); C
; is skipped when 0, and B too when B and C are both 0; a 0 byte ends the
; shape. Columns 0-279 are drawn on 0-255 (XScl); with Su = 1 (letters)
; only the starting column is scaled. Called with the NMI off.
; Registers while drawing: IX the shape's bytes, DE the column, BC the line.
OrDraw:
    ld a,(AMY_UVAR_Sn)
    dec a
    add a,a
    ld l,a
    ld h,0
    ld de,AMY_UDATA_ShapeTab+2
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    ld ix,AMY_UDATA_ShapeTab
    add ix,de
    ld de,(AMY_UVAR_Sx)
    ; the letters' starting column, and the offset that turns Cx into it
    ld a,d
    or a
    jr nz,OrDrawNoBase
    ld hl,AMY_UDATA_XScl
    add hl,de
    ld a,(hl)
    sub e
    ld (AMY_UVAR_Lb),a
OrDrawNoBase:
    ld bc,(AMY_UVAR_Sy)
OrDrawByte:
    ld a,(ix+0)
    or a
    ret z
    inc ix
    push af
    and 7
    call OrVec
    pop af
    ld h,a
    and $C0
    jr nz,OrDrawBC
    ld a,h
    and $38
    jr z,OrDrawByte
    rrca
    rrca
    rrca
    call OrVec
    jr OrDrawByte
OrDrawBC:
    ld a,h
    push af
    rrca
    rrca
    rrca
    and 7
    call OrVec
    pop af
    rlca
    rlca
    and 3
    call OrVec
    jr OrDrawByte

; OrVec: the vector in A at DE, BC
OrVec:
    bit 2,a
    call nz,OrPlot
    and 3
    jr z,OrVecUp
    dec a
    jr z,OrVecRight
    dec a
    jr z,OrVecDown
    dec de
    ret
OrVecUp:
    dec bc
    ret
OrVecRight:
    inc de
    ret
OrVecDown:
    inc bc
    ret

; OrPlot: the point DE, BC when on the screen (keeps AF, BC, DE)
OrPlot:
    push af
    ld a,b
    or a
    jr nz,OrPlotOut
    ld a,c
    cp 192
    jr nc,OrPlotOut
    ld a,(AMY_UVAR_Su)
    or a
    jr nz,OrPlotLetter
    ld a,d
    or a
    jr z,OrPlotScale
    dec a
    jr nz,OrPlotOut
    ld a,e
    cp 24
    jr nc,OrPlotOut
OrPlotScale:
    ld hl,AMY_UDATA_XScl
    add hl,de
    ld a,(hl)
    jr OrPix
OrPlotLetter:
    ld a,(AMY_UVAR_Lb)
    add a,e
; OrPix: the pixel at column A, line C: VRAM (C>>3)*256 + (A&$F8) + (C&7)
OrPix:
    push de
    ld e,a
    and 7
    ld hl,OrMaskTab
    add a,l
    ld l,a
    jr nc,OrPixNoC
    inc h
OrPixNoC:
    ld d,(hl)
    ld a,c
    rrca
    rrca
    rrca
    and $1F
    ld h,a
    ld a,e
    and $F8
    ld l,a
    ld a,c
    and 7
    or l
    ld l,a
    out ($BF),a
    ld a,h
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    in a,($BE)
    ld e,a
    ld a,(AMY_UVAR_Sm)
    or a
    ld a,e
    jr z,OrPixClear
    or d
    jr OrPixWrite
OrPixClear:
    ld e,a
    ld a,d
    cpl
    and e
OrPixWrite:
    ld e,a
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld a,e
    nop
    nop
    out ($BE),a
    pop de
OrPlotOut:
    pop af
    ret

OrMaskTab:
    db $80,$40,$20,$10,$08,$04,$02,$01

; OrText: the letters of the 0-ended string at Tp drawn from Sx, Sy (Apple
; coordinates, 7 apart: DRAW ASC-28, line 30015); Sx moves on
OrText:
    ld a,1
    ld (AMY_UVAR_Su),a
OrTextLoop:
    ld hl,(AMY_UVAR_Tp)
    ld a,(hl)
    or a
    jr z,OrTextEnd
    inc hl
    ld (AMY_UVAR_Tp),hl
    cp 32
    jr z,OrTextNext
    sub 28
    ld (AMY_UVAR_Sn),a
    call OrDraw
OrTextNext:
    ld hl,(AMY_UVAR_Sx)
    ld de,7
    add hl,de
    ld (AMY_UVAR_Sx),hl
    jr OrTextLoop
OrTextEnd:
    xor a
    ld (AMY_UVAR_Su),a
    ret

; OrPut: the 0-ended string at Tp printed in the text at column X, row Y;
; Rv = its length
OrPut:
    ld a,(AMY_UVAR_Y)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_X)
    ld e,a
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,(AMY_UVAR_Tp)
    ld b,0
OrPutLoop:
    ld a,(hl)
    or a
    jr z,OrPutEnd
    out ($BE),a
    inc hl
    inc b
    ex (sp),hl
    ex (sp),hl
    jr OrPutLoop
OrPutEnd:
    ld a,b
    ld (AMY_UVAR_Rv),a
    xor a
    ld (AMY_UVAR_Rv+1),a
    ret

; OrChar: the character V at column X, row Y
OrChar:
    ld a,(AMY_UVAR_Y)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,(AMY_UVAR_X)
    ld e,a
    ld d,0
    add hl,de
    ld de,(VDP_NAME_SHADOW)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ex (sp),hl
    ex (sp),hl
    ld a,(AMY_UVAR_V)
    out ($BE),a
    ret

; OrLose: the i32 at HL less Kc*65536 + Km*Rw
OrLose:
    push hl
    ld a,(AMY_UVAR_Km)
    ld b,a
    ld de,(AMY_UVAR_Rw)
    ld hl,0
    ld c,0
    or a
    jr z,OrLoseSum
OrLoseMul:
    add hl,de
    jr nc,OrLoseNoC
    inc c
OrLoseNoC:
    djnz OrLoseMul
OrLoseSum:
    ld a,(AMY_UVAR_Kc)
    add a,c
    ld c,a
    ex de,hl
    pop hl
    ld a,(hl)
    sub e
    ld (hl),a
    inc hl
    ld a,(hl)
    sbc a,d
    ld (hl),a
    inc hl
    ld a,(hl)
    sbc a,c
    ld (hl),a
    inc hl
    ld a,(hl)
    sbc a,0
    ld (hl),a
    ret

; OrFont: the font back in the three thirds after a bitmap
OrFont:
    call LOAD_ASCII
    jp AMY_DUPLICATE_PATTERN_THIRDS
}
