u16 ThPA = 0
u8 ThColD = 0
u8 ThCset = 0
u16 ThCA = 0
u8 RainOn = 0
u16 RainA = 0
u8 NqN = 0
u16 NqA[48]
u8 NqC[48]
u8 InPlay = 0
' ---- frame, input ----
u8 Tick = 0
u8 Menu = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 BtnR = 0
u8 WasR = 0
u8 PressR = 0
u8 PadU = 0
u8 PadD = 0
u8 WasStk = 0
u8 StkE = 0
u8 State = 0
' ---- tune ----
u8 TzOn = 0
u16 TzLeft = 0
u8 TzSec = 0
' ---- balloon (1/16 px) ----
u16 Bx = 0
i16 By = 0
i16 Vx = 0
i16 Vy = 0
u8 Heat = 112
u16 Fuel = 0
u8 Sacks = 0
u8 Landed = 0
u8 Grace = 0
u8 Burn = 0
u8 Vent = 0
u8 ReloadC = 0
' ---- sack ----
u8 SkOn = 0
u16 SkX = 0
i16 SkY = 0
i16 SkVx = 0
i16 SkVy = 0
' ---- wind, day ----
i16 Wd[4]
u8 GStep = 0
u16 GustT = 0
u8 Warn = 0
u8 Day = 0
u8 Dd = 0
u16 Clk = 0
u8 NTarg = 0
u8 Targ[8]
u8 TDone = 0
u8 NDone = 0
u16 ParT[3]
' ---- game ----
u16 Score = 0
u8 Lives = 0
u8 Ph = 0
u8 PhT = 0
u16 Cam = 0
u16 Rs = 1
u16 CldP[3]
' ---- birds ----
u8 BrOn = 0
u16 BrX = 0
u8 BrY = 0
u8 BrDir = 0
u8 BrFx = 0
u8 BrWarn = 0
u16 BirdT = 0
u8 BrWc = 0
u8 BrWr = 0
' ---- thunderhead ----
u8 ThOn = 0
u8 ThL = 0
u16 ThX = 0
i16 ThFx = 0
u8 ThPh = 0
u16 ThT = 0
u8 ThFc = 0
u16 ThTimer = 0
u8 ThFlash = 0
u8 ThNC = 255
u8 ThDrC = 255
u8 ThDrR = 0
u8 ThRow = 0
u8 ThBase = 0
u8 ThSkyC = 0
u8 ThRainC = 0
u8 ThDrRn = 0
u8 ThRainD = 0
' ---- popup ----
u8 PopT = 0
u16 PopX = 0
u8 PopY = 0
u8 PopP = 0
' ---- HUD shadow ----
u8 HSk = 255
u8 HFl = 255
u16 HSc = 65535
u8 HLv = 255
u8 HDay = 255
u8 HSun = 255
u8 HLow = 255
u8 ArShow[4]
u8 ArBlink = 0
u8 Ar3C = 0
u8 PatN = 0
u16 BlitCam = 0
u8 BlitVis = 0
u8 ObjFlag[18]
u16 HillCx[3]
u8 PatC[3]
u8 SkLast[6]
u8 FlameT = 0
u8 SkHeavy = 0
u8 SkSx = 0
u8 SkSy = 0
u8 SkStC[5]
u8 SunC = 0
u16 SunT = 0
' ---- scratch (never kept across a sub call) ----
u8 I = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0
u8 C = 0
u8 L = 0
u8 Col = 0
u16 U = 0
u16 U2 = 0
u16 NumU = 0
i16 A16 = 0
i16 D16 = 0
i16 T16 = 0
u16 Ax = 0
u8 Ay = 0
u8 Bot = 0
u8 PrevB = 0
u8 Hh = 0
u8 Hc = 0
u8 Kd = 0
u8 Ob = 0
' ---- title ----
u8 TsT = 0
u8 TsBy = 0
u16 Waited = 0
u8 Pg = 0
u8 SkObW = 0
u8 V2 = 0
u8 SkSh = 0
u8 SkVm = 0
u8 SkTi = 0
u8 SkObR = 0
u8 SkObB = 0
' ---- stats (bots) ----
u16 Deliv = 0
u16 Drops = 0
u16 Crashes = 0
u8 Why = 0
u16 Parcels = 0
u16 Gusts = 0
u16 BirdHits = 0
u16 Bumps = 0

  tile screen
  call asm SkR3
  set sound table SmSoundTable areas 4
  sprites 16x16
  nmi off
  copy SprPat count SprBytes to vram.spr_pat
  HideSpr
  screen on
  Rs = 4321

title:
  TitlePage
  if Menu = 1 then
    HowTo
    goto title
  end if
  if Menu = 2 then
    Credits
    goto title
  end if
  NewGame

play_loop:
  Frame1
  ReadPad
  PlayStep
  Prep
  if State = StPlay then goto play_loop

  ' game over: a panel over the sky; one press (after 1 s) -> title
  InPlay = 0
  HideSpr
  print at 9,9, "  GAME OVER  "
  print at 9,11, " SCORE "
  NumU = Score
  print at 16,11, digits$(NumU, 5)
  print at 21,11, " "
  play sound SndOver
  Waited = 0
go_wait:
  Frame1
  ReadPad
  inc Waited
  if Waited < 60 then Press = 0
  if Press = 0 then goto go_wait
  goto title

' ===========================================================================
' the game

sub NewGame:
  Score = 0
  Lives = 3
  Day = 0
  Deliv = 0
  Drops = 0
  Crashes = 0
  Parcels = 0
  Gusts = 0
  BirdHits = 0
  Bumps = 0
  BuildPlay
  Bx = 0
  if defined DBG_DAY5
    Day = 4
  end defined
  StartDay
  ' first spawn: over the first tower
  Bx = ObjCxH[0]
  Bx = Bx << 8
  Bx += ObjCx[0]
  Bx = Bx << 4
  U = Bx >> 4
  U -= 128
  Cam = U & 1023
  Spawn
  State = StPlay
  InPlay = 1
  Hud
  return
end sub

sub StartDay:
  Dd = Day
  if Dd > 7 then Dd = 7
  N = Dd << 3
  NTarg = DTarg[Dd]
  for I = 0 to 7
    Targ[I] = TargL[N]
    inc N
  next
  TDone = 0
  NDone = 0
  fill array ObjFlag with 0
  for I = 0 to 7
    if I < NTarg then
      V = Targ[I]
      ObjFlag[V] = 1
    end if
  next
  for I = 0 to 2
    V = HillObj[I]
    U = ObjCxH[V]
    U = U << 8
    U += ObjCx[V]
    HillCx[I] = U
  next
  Sacks = 5
  Fuel = FuelMax
  GStep = 0
  GustT = 0
  Warn = 0
  Clk = DayClk
  SunC = 0
  SunT = 0
  SetWind
  ParT[0] = 0
  ParT[1] = 0
  ParT[2] = 0
  BirdT = 0
  BrOff
  ThTimer = 0
  ThOff
  Ph = 0
  SkOn = 0
  Landed = 0
  ReloadC = 0
  VilD = 1
  return
end sub

sub Spawn:
  By = 512
  Vy = 0
  Vx = 0
  Heat = 150
  Grace = 120
  if Fuel < 1500 then Fuel = 1500
  return
end sub

' the winds of this day's step (WindT bytes are i8)
sub SetWind:
  N = Dd << 5
  K = GStep << 2
  N += K
  for I = 0 to 3
    V = WindT[N]
    A16 = V
    if V >= 128 then A16 -= 256
    Wd[I] = A16
    inc N
  next
  return
end sub

sub Crash:
  dec Lives
  inc Crashes
  Ph = 1
  PhT = 60
  SkOn = 0
  play sound SndCrash
  return
end sub

sub NextRnd:
  U = Rs << 7
  Rs = Rs ^ U
  U = Rs >> 9
  Rs = Rs ^ U
  U = Rs << 8
  Rs = Rs ^ U
  return
end sub

' one play frame: the same order as model.mjs Game.frame
sub PlayStep:
  if Ph = 2 then
    dec PhT
    if PhT = 0 then
      inc Day
      ClearMsg
      StartDay
      Spawn
    end if
    return
  end if
  if Ph = 1 then
    dec PhT
    if PhT = 0 then
      if Lives = 0 then
        State = StOver
        return
      end if
      Ph = 0
      Spawn
    end if
    return
  end if
  dec Clk
  if Clk = 0 then
    Clk = DayClk
    Why = 5
    Crash
    return
  end if
  ' gusts
  inc GustT
  U = DGustH[Dd]
  U = U << 8
  U += DGust[Dd]
  U2 = U - 180
  if GustT = U2 then
    N = Dd << 3
    N += GStep & 7
    Warn = GustL[N] + 1
    play sound SndWhoosh
  end if
  if GustT >= U then
    GustT = 0
    inc GStep
    GStep = GStep & 7
    SetWind
    Warn = 0
    inc Gusts
  end if
  ' parcels come back
  for I = 0 to 2
    if ParT[I] > 0 then ParT[I] -= 1
  next
  ' the balloon: heat, lift
  Burn = 0
  Vent = 0
  if PadU = 1 then
    if Fuel > 0 then Burn = 1
  end if
  if Burn = 0 then
    if PadD = 1 then Vent = 1
  end if
  if Burn = 1 then
    FlameT = 6
  else
    if FlameT > 0 then dec FlameT
  end if
  if Burn = 1 then
    if Heat > 247 then
      Heat = 255
    else
      Heat += 8
    end if
    dec Fuel
  else
    if Vent = 1 then
      if Heat < 8 then
        Heat = 0
      else
        Heat -= 8
      end if
    else
      if Heat > 112 then
        Heat -= 2
        if Heat < 112 then Heat = 112
      else
        if Heat < 112 then
          Heat += 2
          if Heat > 112 then Heat = 112
        end if
      end if
    end if
  end if
  V = Heat >> 3
  V = LiftT[V]
  A16 = V
  A16 -= 8
  if Burn = 1 then A16 -= 1
  if Vent = 1 then A16 += 1
  ' a dark thunderhead pushes down whoever rides its layer under it
  if ThOn = 1 then
    if ThPh >= 2 then
      U = By >> 4
      V = lowbyte U
      V += 12
      LayerOf
      if L = ThL then
        U = Bx >> 4
        U -= ThX
        U -= 12
        Wrapd
        if signed D16 > -32 then
          if signed D16 < 32 then A16 += 1
        end if
      end if
    end if
  end if
  Vy += A16
  T16 = Vy >> 2
  Vy -= T16
  U = By >> 4
  PrevB = lowbyte U
  PrevB += 24
  By += Vy
  if signed By < YMin then
    By = YMin
    if signed Vy < 0 then Vy = 0
  end if
  U = By >> 4
  V = lowbyte U
  V += 12
  LayerOf
  A16 = Wd[L]
  ApproachX
  if Landed > 0 then Vx = 0
  Bx += Vx
  Bx = Bx & 16383
  ' terrain
  Ax = Bx >> 4
  U = By >> 4
  Ay = lowbyte U
  Bot = Ay + 24
  U = Ax - 4
  U = U >> 2
  Hc = lowbyte U
  Hh = Heights[Hc]
  U = Ax >> 2
  C = lowbyte U
  V = Heights[C]
  if V < Hh then
    Hh = V
    Hc = C
  end if
  U = Ax + 4
  U = U >> 2
  C = lowbyte U
  V = Heights[C]
  if V < Hh then
    Hh = V
    Hc = C
  end if
  Y = Ay + 14
  U = Ax - 7
  U = U >> 2
  C = lowbyte U
  V = Heights[C]
  if V < Y then
    Why = 1
    Crash
    return
  end if
  U = Ax + 7
  U = U >> 2
  C = lowbyte U
  V = Heights[C]
  if V < Y then
    Why = 1
    Crash
    return
  end if
  Landed = 0
  Kd = Kinds[Hc]
  if Kd = 1 then
    V = Hh - 6
    if Bot >= V then Pickup
  end if
  if Bot >= Hh then
    Y = Hh + 1
    if Kd > 0 then
      if PrevB <= Y then
        U = Hh - 24
        By = U << 4
        if signed Vy > 0 then Vy = 0
        Landed = Kd
        if Kd = 2 then TowerStop
        goto ps_sack
      end if
    end if
    if Hh = 168 then
      Why = 2
      Crash
      return
    end if
    Ob = ObjAt[Hc]
    V = 0
    if Ob > 0 then
      dec Ob
      V = ObjType[Ob]
    end if
    ' house 3, hill 5: a bump
    if Ob <> 255 then
      if V = 3 then
        Bump
        goto ps_sack
      end if
      if V = 5 then
        Bump
        goto ps_sack
      end if
    end if
    Why = 3
    Crash
    return
  end if
ps_sack:
  if PressR = 1 then
    if SkOn = 0 then
      if Sacks > 0 then
        dec Sacks
        inc Drops
        SkOn = 1
        SkX = Bx
        SkY = By + 384
        SkVx = Vx
        SkVy = Vy
        if signed SkVy < 0 then SkVy = 0
        play sound SndDrop
      end if
    end if
  end if
  if SkOn = 1 then SackStep
  if Grace > 0 then dec Grace
  ' camera: the balloon kept in screen x 116-140
  U = Ax - Cam
  U = U & 1023
  K = 0
  if U > 140 then
    if U < 600 then K = 1
  end if
  if K = 1 then
    U -= 140
    if U > 2 then U = 2
    Cam += U
  else
    K = 0
    if U < 116 then K = 1
    if U >= 600 then K = 1
    if K = 1 then
      U = 116 - U
      U = U & 1023
      if U > 2 then U = 2
      Cam -= U
    end if
  end if
  Cam = Cam & 1023
  Birds
  if Ph <> 0 then return
  Thunder
  return
end sub

sub Bump:
  U = Hh - 25
  By = U << 4
  Vy = -20
  if Fuel > 30 then
    Fuel -= 30
  else
    Fuel = 0
  end if
  inc Bumps
  play sound SndBump
  return
end sub

sub TowerStop:
  if Fuel < FuelMax then
    Fuel += 24
    if Fuel > FuelMax then Fuel = FuelMax
    if TzOn = 0 then
      V = Tick & 15
      if V = 0 then play sound SndFill
    end if
  end if
  if Sacks < 5 then
    inc ReloadC
    if ReloadC >= 20 then
      ReloadC = 0
      inc Sacks
      play sound SndParcel
    end if
  end if
  return
end sub

sub Pickup:
  Ob = ObjAt[Hc]
  dec Ob
  for J = 0 to 2
    if HillObj[J] = Ob then
      if ParT[J] = 0 then
        if Sacks < 5 then
          inc Sacks
          ParT[J] = 600
          Score += 25
          inc Parcels
          play sound SndParcel
          U = ObjCxH[Ob]
          U = U << 8
          U += ObjCx[Ob]
          PopAt
          PopP = SPop25
        end if
      end if
    end if
  next
  return
end sub

' V = a screen y -> L = its wind layer
sub LayerOf:
  L = 3
  if V < 120 then L = 2
  if V < 88 then L = 1
  if V < 56 then L = 0
  return
end sub

' D16 = U wrapped to -512..511
sub Wrapd:
  U += 512
  U = U & 1023
  D16 = U
  D16 -= 512
  return
end sub

' Vx toward A16 (at least 1 a frame), shift 4
sub ApproachX:
  D16 = A16 - Vx
  if signed D16 > 0 then
    D16 += 15
    D16 = D16 >> 4
    Vx += D16
  else
    if signed D16 < 0 then
      D16 = 15 - D16
      D16 = D16 >> 4
      Vx -= D16
    end if
  end if
  return
end sub

sub SackStep:
  SkVy += 3
  if signed SkVy > 64 then SkVy = 64
  U = SkY >> 4
  V = lowbyte U
  if U > 200 then V = 200
  LayerOf
  A16 = Wd[L]
  D16 = A16 - SkVx
  if signed D16 > 0 then
    D16 += 31
    D16 = D16 >> 5
    SkVx += D16
  else
    if signed D16 < 0 then
      D16 = 31 - D16
      D16 = D16 >> 5
      SkVx -= D16
    end if
  end if
  SkX += SkVx
  SkX = SkX & 16383
  SkY += SkVy
  U = SkX >> 6
  C = lowbyte U
  U = SkY >> 4
  V = Heights[C]
  if U < V then return
  ' it landed: a flagged roof?
  SkOn = 0
  Ob = ObjAt[C]
  if Ob = 0 then
    play sound SndThud
    return
  end if
  dec Ob
  for J = 0 to 7
    if Targ[J] = Ob then
      if J < NTarg then
        K = 1 << J
        V = TDone & K
        if V = 0 then
          TDone = TDone | K
          ObjFlag[Ob] = 0
          Deliver
          return
        end if
      end if
    end if
  next
  play sound SndThud
  return
end sub

sub Deliver:
  inc Deliv
  U = ObjCxH[Ob]
  U = U << 8
  U += ObjCx[Ob]
  NumU = U
  U = SkX >> 4
  U -= NumU
  Wrapd
  if signed D16 < 0 then D16 = 0 - D16
  if signed D16 <= 3 then
    Score += 150
    PopP = SPop150
    play sound SndPerfect
  else
    if signed D16 <= 8 then
      Score += 100
      PopP = SPop100
    else
      Score += 50
      PopP = SPop50
    end if
    play sound SndMail
  end if
  U = NumU
  PopAt
  VilD = 1
  ' every flag done: the day's bonus, a balloon, the next day
  inc NDone
  if NDone = NTarg then
    U = Day + 1
    U = U * 200
    Score += U
    U = Fuel / 30
    Score += U
    if Lives < 4 then inc Lives
    Ph = 2
    PhT = 180
    SkOn = 0
    BrOff
    ThOff
    play sound SndClear
    ClearMsgShow
  end if
  return
end sub

' a popup over world x U (px)
sub PopAt:
  PopX = U - 8
  PopY = 112
  PopT = 60
  return
end sub

' ---- birds: a flock of two crosses the screen after a warning ----
sub BrOff:
  if BrOn = 1 then
    if BrWarn > 0 then WarnTile0
  end if
  BrOn = 0
  return
end sub

sub Birds:
  inc BirdT
  if BrOn = 0 then
    U = DBirdH[Dd]
    U = U << 8
    U += DBird[Dd]
    U -= 60
    if BirdT >= U then
      NextRnd
      V = lowbyte Rs
      BrDir = V & 1
      V = V >> 1
      V = V mod 3
      BrY = BirdYT[V]
      if BrDir = 1 then
        BrX = Cam - 24
      else
        BrX = Cam + 264
      end if
      BrX = BrX & 1023
      BrWarn = 60
      BrFx = 0
      BrOn = 1
      BrWr = BrY >> 3
      inc BrWr
      BrWc = 3
      if BrDir = 0 then BrWc = 28
      play sound SndCaw
    end if
  end if
  if BrOn = 0 then return
  if BrWarn > 0 then
    dec BrWarn
    if BrWarn = 0 then
      WarnTile0
    else
      V = BrWarn & 15
      if V = 0 then WarnTile1
      if V = 8 then WarnTile0
    end if
    return
  end if
  BrFx += 24
  V = BrFx >> 4
  BrFx = BrFx & 15
  if BrDir = 1 then
    BrX += V
  else
    BrX -= V
  end if
  BrX = BrX & 1023
  ' two birds: (x, y) and (x - 14 dir, y + 16)
  for J = 0 to 1
    U = BrX + 8
    if J = 1 then
      if BrDir = 1 then
        U -= 14
      else
        U += 14
      end if
    end if
    U -= Ax
    Wrapd
    if signed D16 > -11 then
      if signed D16 < 11 then
        A16 = BrY
        if J = 1 then A16 += 16
        A16 -= Ay
        if signed A16 > -8 then
          if signed A16 < 14 then
            if Grace = 0 then BirdHit
          end if
        end if
      end if
    end if
  next
  U = BrX - Cam
  U = U & 1023
  if U > 300 then
    if U < 980 then
      BrOn = 0
      BirdT = 0
    end if
  end if
  return
end sub

sub BirdHit:
  if Sacks > 0 then dec Sacks
  Vy = 24
  if Heat > 40 then
    Heat -= 40
  else
    Heat = 0
  end if
  Grace = 90
  inc BirdHits
  play sound SndCaw
  return
end sub

' the edge warning: tile on / sky back (rows 6, 8, 10)
sub WarnTile1:
  if ThCovers = 0 then
    call asm SkNqP with a = CBIRDW1, d = BrWr, e = BrWc
  end if
  return
end sub

sub WarnTile0:
  if ThCovers = 0 then
    call asm SkNqP with a = CSKY1, d = BrWr, e = BrWc
  end if
  return
end sub

' does the thunderhead cover the warning cell? (0 = no)
function ThCovers as u8
  K = 0
  if ThVis = 1 then
    V = ThDrR + 2
    if BrWr >= ThDrR then
      if BrWr <= V then
        V = ThDrC + 4
        if BrWc >= ThDrC then
          if BrWc < V then K = 1
        end if
      end if
    end if
  end if
  return K

' ---- thunderheads (from day 3) ----
sub ThOff:
  ThNC = 255
  ThOn = 0
  ThVis = 0
  RainOn = 0
  return
end sub

sub Thunder:
  U = DThunH[Dd]
  U = U << 8
  U += DThun[Dd]
  if U = 0 then return
  inc ThTimer
  if ThOn = 0 then
    if ThTimer >= U then
      NextRnd
      V = lowbyte Rs
      ThL = V mod 3
      A16 = Wd[ThL]
      if signed A16 >= 0 then
        ThX = Cam - 40
      else
        ThX = Cam + 260
      end if
      ThX = ThX & 1023
      ThFx = 0
      ThSkyC = CSKY0
      if ThL > 0 then ThSkyC = CSKY1
      ThPh = 1
      ThT = 180
      ThOn = 1
      ThFc = 0
      ThCset = 0
      ThColD = 1
    end if
  end if
  if ThOn = 0 then return
  ThFx += Wd[ThL]
  T16 = ThFx >> 4
  ThX += T16
  ThX = ThX & 1023
  ThFx = ThFx & 15
  dec ThT
  if ThT = 0 then
    inc ThPh
    if ThPh > 4 then
      ThOff
      ThTimer = 0
      return
    end if
    ThT = ThPhT[ThPh]
    if ThPh = 2 then
      ThCset = 1
      ThColD = 1
      play sound SndRumble
    end if
    if ThPh = 3 then
      ThCset = 2
      ThColD = 1
      ThFc = 39
    end if
    if ThPh = 4 then
      ThCset = 0
      ThColD = 1
    end if
  end if
  ThFlash = 0
  if ThPh = 3 then
    if ThFc = 39 then
      ThFc = 0
    else
      inc ThFc
    end if
    if ThFc < 6 then
      ThFlash = 1
      if ThFc = 0 then
        ThCset = 3
        ThColD = 1
        play sound SndCrack
      end if
      V = ThTopT[ThL]
      U = Ax - ThX
      Wrapd
      if signed D16 > -6 then
        if signed D16 < 30 then
          Y = Ay + 16
          if Y > V then
            V += 16
            if Ay < V then
              if Grace = 0 then
                Why = 4
                Crash
                return
              end if
            end if
          end if
        end if
      end if
    else
      if ThFc = 6 then
        ThCset = 2
        ThColD = 1
      end if
    end if
  end if
  return
end sub

' ===========================================================================
' per-frame preparation for the next blit (engine parameters, sprites)

sub Prep:
  ' a pass that drew the sky prepares the village (and the HUD); a pass
  ' that drew the village (heavier) prepares the sky
  V = Tick & 1
  if V = 1 then
    PrepNear
    SetSprites
    ' a sky blit that also recoloured the storm cloud is a heavy pass: the
    ' HUD waits for the next one
    if SkHeavy = 0 then Hud
    SkHeavy = 0
  else
    PrepSky
    SetSprites
  end if
  return
end sub

sub PrepNear:
  CamD = Cam & 1022
  U = CamD >> 3
  CamQ = lowbyte U
  CamQ = CamQ & 127
  if CamQ <> OldQ then VilD = 1
  OldQ = CamQ
  if VilD = 0 then goto pn_wind
  ' the object types in view (a table by camera cell); flagged houses in
  ' view (Patches) add the flag-house type
  VisM = VisT[CamQ]
  Patches
  if PatN > 0 then VisM = VisM | 16
pn_wind:
  TgVar = 0
  A16 = Wd[3]
  if signed A16 < 0 then TgVar = 1
  return
end sub

' flagged houses in view: their rows 17-20 get the target codes (queued
' after the village rows are rewritten)
sub Patches:
  PatN = 0
  for J = 0 to 7
    if J < NTarg then
      K = 1 << J
      K = K & TDone
      if K = 0 then
        Ob = Targ[J]
        V = ObjW0[Ob] - 1
        V -= CamQ
        V = V & 127
        K = 0
        if V < 32 then K = 1
        if V > 124 then K = 1
        if K = 1 then
          if PatN < 3 then
            PatC[PatN] = V
            inc PatN
          end if
        end if
      end if
    end if
  next
  return
end sub

' is object Ob a flag still waiting? (1 = yes)
function IsTarget(u8 Oi) as u8
  return ObjFlag[Oi]

sub PrepSky:
  ' cloud streaks drift with their layer's wind
  call asm SkCld
  if InPlay = 1 then ThPrep
  return
end sub

' the thunderhead on screen: shift, names, rain
sub ThPrep:
  if ThOn = 0 then return
  U = ThX - CamD
  Wrapd
  ' visible while its footprint (x - 8 .. x + 24) touches the screen
  K = 0
  if signed D16 > -32 then
    if signed D16 < 256 then K = 1
  end if
  if K = 0 then
    ThVis = 0
    ThNC = 255
    return
  end if
  ' s = (-x) & 7, footprint starts at column (x + s) / 8 - 1
  T16 = 0 - D16
  V = lowbyte T16
  ThS = V & 7
  T16 = D16 + ThS
  T16 += 64
  T16 = T16 >> 3
  V = lowbyte T16
  V -= 9
  ' V = first column (may be "negative": 248..255)
  ThVis = 1
  ThNC = V
  N = ThL << 2
  ThRow = N + 4
  ' pattern / colour addresses of this layer's 8 codes
  if ThL = 0 then
    ThPA = CTH0 * 8
    ThCA = CTH0 * 8
    ThCA += $2000
    RainA = CRAIN0 * 8
  else
    if ThL = 1 then
      ThPA = CTH1 * 8
    else
      ThPA = CTH2 * 8
    end if
    ThPA += $0800
    ThCA = ThPA + $2000
    RainA = CRAIN1 * 8
    RainA += $0800
  end if
  RainOn = 0
  ThRainC = ThSkyC
  if ThPh = 3 then
    RainOn = 1
    ThRainC = CRAIN0
    if ThL > 0 then ThRainC = CRAIN1
  end if
  ThBase = CTH0
  if ThL = 1 then ThBase = CTH1
  if ThL = 2 then ThBase = CTH2
  return
end sub





' ---- sprites: Sat for the next blit (positions against CamD) ----
sub SetSprites:
  call asm SkSpr
  return
end sub

' ---- HUD (row 1), the sun (row 2), the wind arrows (column 2) ----
sub Hud:
  if Sacks <> HSk then
    HSk = Sacks
    for J = 0 to 4
      C = CHSACKE
      if J < Sacks then C = CHSACK
      X = J + 2
      put char C at X,1
    next
    return
  end if
  U = Fuel >> 6
  V = lowbyte U
  if V <> HFl then
    HFl = V
    put char CHFUEL at 8,1
    for J = 0 to 5
      K = J << 3
      C = 0
      if V > K then
        C = V - K
        if C > 8 then C = 8
      end if
      C += CBAR
      X = J + 9
      put char C at X,1
    next
    return
  end if
  V = 0
  if Fuel < FuelLow then V = 1
  if V <> HLow then
    HLow = V
    if V = 1 then
      copy BarR count 72 to vram.color + CBAR * 8
    else
      copy BarY count 72 to vram.color + CBAR * 8
    end if
    return
  end if
  if Score <> HSc then
    HSc = Score
    NumU = Score
    print at 16,1, digits$(NumU, 5)
    return
  end if
  if Lives <> HLv then
    HLv = Lives
    for J = 0 to 3
      C = 32
      if J < Lives then C = CHLIFE
      X = J + 22
      put char C at X,1
    next
    return
  end if
  if Day <> HDay then
    HDay = Day
    print at 27,1, "D"
    V = Day + 1
    if V > 9 then V = 9
    V += 48
    put char V at 28,1
  end if
  ' the sun crosses row 2 in 120 s (one column every 257 frames)
  if InPlay = 1 then
    if Ph = 0 then
      inc SunT
      if SunT >= 257 then
        SunT = 0
        if SunC < 27 then inc SunC
      end if
    end if
    V = SunC + 2
    if V <> HSun then
      if HSun < 32 then put char CSKY0 at HSun,2
      HSun = V
    end if
    C = CSUN
    if Clk < 1200 then C = CSUNR
    put char C at HSun,2
  end if
  ' wind arrows; a gust's layer blinks old / new (2 Hz)
  inc ArBlink
  J = ArBlink & 3
  if J < 4 then
    A16 = Wd[J]
    ArrowOf
    if Warn > 0 then
      V = Warn - 1
      if V = J then
        V = ArBlink & 8
        if V > 0 then
          N = Dd << 3
          V = GStep + 1
          V = V & 7
          N += V
          N = N << 2
          N += J
          V = WindT[N]
          A16 = V
          if V >= 128 then A16 -= 256
          ArrowOf
        end if
      end if
    end if
    if K <> ArShow[J] then
      ArShow[J] = K
      Y = ArRowT[J]
      C = CAR0 + K
      if J > 0 then C = CAR1 + K
      if J = 3 then C = CAR2 + K
      C -= 3
      if J = 3 then Ar3C = C
      put char C at 2,Y
    end if
  end if
  return
end sub

' A16 (a wind) -> K = arrow index 0..6 (3 = calm)
sub ArrowOf:
  K = 3
  if signed A16 > 0 then
    K = 4
    if signed A16 > 7 then K = 5
    if signed A16 > 15 then K = 6
  end if
  if signed A16 < 0 then
    K = 2
    if signed A16 < -7 then K = 1
    if signed A16 < -15 then K = 0
  end if
  return
end sub

sub ClearMsgShow:
  print at 8,9, " DAY   DELIVERED "
  V = Day + 1
  if V > 9 then V = 9
  V += 48
  put char V at 13,9
  return
end sub

sub ClearMsg:
  fill CSKY1 count 17 at 8,9
  return
end sub

' ===========================================================================
' screens

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      inc TzSec
      TuneSec
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  if InPlay > 0 then call asm SkBlit
  return
end sub

sub ReadPad:
  Btn = 0
  BtnR = 0
  PadU = 0
  PadD = 0
  if joypad(1).button1 then PadU = 1
  if joypad(2).button1 then PadU = 1
  if joypad(1).up then PadU = 1
  if joypad(2).up then PadU = 1
  if joypad(1).down then PadD = 1
  if joypad(2).down then PadD = 1
  if joypad(1).button2 then BtnR = 1
  if joypad(2).button2 then BtnR = 1
  if joypad(1).fire then Btn = 1
  if joypad(2).fire then Btn = 1
  Press = 0
  if Btn = 1 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  PressR = 0
  if BtnR = 1 then
    if WasR = 0 then PressR = 1
  end if
  WasR = BtnR
  ' stick edges for menus: 1 up, 2 down
  V = 0
  if joypad(1).up then V = 1
  if joypad(2).up then V = 1
  if PadD = 1 then V = 2
  StkE = 0
  if V <> WasStk then StkE = V
  WasStk = V
  return
end sub

sub HideSpr:
  fill array Sat with 200
  Sat[32] = 208
  call asm SkSat
  return
end sub

' load every tile set (thirds 0, 1, 2) with the display off
sub LoadTiles:
  fill mode 2 text color with $F1
  copy T0Pat count N0B to vram.pattern + 1024
  copy T0Col count N0B to vram.color + 1024
  copy T1Pat count N1B to vram.pattern + 3072
  copy T1Col count N1B to vram.color + 3072
  copy T2Pat count N2B to vram.pattern + 5120
  copy T2Col count N2B to vram.color + 5120
  copy ThCol count 64 to vram.color + CTH0 * 8
  copy ThCol count 64 to vram.color + CTH1 * 8 + 2048
  copy ThCol count 64 to vram.color + CTH2 * 8 + 2048
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  InPlay = 0
  HideSpr
  call asm SkR3
  LoadTiles
  backdrop black
  cls
  NqN = 0
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the bands' names: streak rows, sky, far hills, village (asm), road
sub DrawWorld:
  for Y = 2 to 14
    fill CSKY0 count 32 at 0,Y
  next
  for Y = 8 to 14
    fill CSKY1 count 32 at 0,Y
  next
  for X = 0 to 31
    V = X & 7
    C = CSTR0 + V
    put char C at X,3
    C = CSTR1 + V
    put char C at X,7
    C = CSTR2 + V
    put char C at X,11
    C = CCREST + V
    put char C at X,15
    C = CGR + V
    put char C at X,21
    C += 8
    put char C at X,22
    put char C at X,23
  next
  Cam = Cam & 1023
  CamD = Cam & 1022
  U = CamD >> 3
  CamQ = lowbyte U
  CamQ = CamQ & 127
  OldQ = CamQ
  for J = 0 to 5
    SkLast[J] = 255
  next
  fill array SkStC with 255
  ThDrC = 255
  ThNC = 255
  PatN = 0
  call asm SkVil
  for J = 0 to 3
    ArShow[J] = 255
  next
  return
end sub

sub BuildPlay:
  NewScreen
  DrawWorld
  fill 32 count 32 at 0,1
  HSk = 255
  HFl = 255
  HSc = 65535
  HLv = 255
  HDay = 255
  HSun = 255
  HLow = 255
  ShowScreen
  return
end sub

sub TuneSec:
  if TzOn = 1 then TuneOff
  V = TzSec & 3
  if V = 2 then
    play sound SndTuneE
    play sound SndTuneF
    play sound SndTuneG
    play sound SndTuneH
  else
    play sound SndTuneA
    play sound SndTuneB
    play sound SndTuneC
    play sound SndTuneD
  end if
  TzOn = 1
  TzLeft = 448
  return
end sub

sub TuneOff:
  stop sound SndTuneA
  stop sound SndTuneB
  stop sound SndTuneC
  stop sound SndTuneD
  stop sound SndTuneE
  stop sound SndTuneF
  stop sound SndTuneG
  stop sound SndTuneH
  TzOn = 0
  return
end sub

sub TitlePage:
  State = StTitle
  NewScreen
  Day = 0
  Dd = 0
  GStep = 0
  SetWind
  DrawWorld
  fill CSKY0 count 32 at 0,3
  fill CSKY1 count 32 at 0,11
  ' the logo (rows 2-6), white SKY and red MAIL blocks
  N = 0
  for Y = 2 to 6
    for X = 2 to 29
      V = Logo[N]
      if V = 1 then put char CLOGOW at X,Y
      if V = 2 then put char CLOGOR at X,Y
      inc N
    next
  next
  NTarg = 0
  TDone = 0
  Ar3C = CMEADOW
  Menu = 0
  ShowMenu
  TsT = 0
  BrOn = 0
  ThOn = 0
  ThVis = 0
  InPlay = 2
  TzSec = 0
  TuneSec
  ShowScreen
  WasBtn = 1
tp_loop:
  Frame1
  ReadPad
  if StkE > 0 then
    if StkE = 1 then
      if Menu = 0 then
        Menu = 2
      else
        dec Menu
      end if
    else
      inc Menu
      if Menu > 2 then Menu = 0
    end if
    ShowMenu
  end if
  TitleAnim
  ' the seed moves on every title frame
  NextRnd
  if Press = 0 then goto tp_loop
  if TzOn = 1 then TuneOff
  mute all
  InPlay = 0
  return
end sub

sub ShowMenu:
  print at 9,10, "  START      "
  print at 9,12, "  HOW TO PLAY"
  print at 9,14, "  CREDITS    "
  V = Menu << 1
  V += 10
  put char 62 at 10,V
  return
end sub

' the title scene: the village pans, a balloon bobs and burns now and then,
' a flock crosses the sky
sub TitleAnim:
  inc TsT
  Cam += 1
  Cam = Cam & 1023
  V = Tick & 1
  if V = 1 then
    PrepNear
  else
    PrepSky
  end if
  fill array Sat with 200
  Sat[32] = 208
  V = TsT >> 2
  V = V & 31
  if V >= 16 then V = 31 - V
  Y = 76 + V
  Sat[0] = Y
  Sat[1] = 216
  Sat[2] = SEnv1
  V = TsT & 32
  if V > 0 then Sat[2] = SEnv2
  Sat[3] = 8
  V = TsT & 64
  if V = 0 then
    Sat[4] = Y + 8
    Sat[5] = 216
    Sat[6] = SFlame1
    V = TsT & 4
    if V > 0 then Sat[6] = SFlame2
    Sat[7] = 11
  end if
  Sat[8] = Y + 16
  Sat[9] = 216
  Sat[10] = SBasket
  Sat[11] = 10
  ' birds: right to left across row 8-9 every 4.3 s
  U = TsT
  U = U << 1
  V = lowbyte U
  X = 255 - V
  Sat[24] = 55
  Sat[25] = X
  Sat[26] = SBirdl1
  V = TsT & 8
  if V > 0 then Sat[26] = SBirdl2
  Sat[27] = 1
  return
end sub

sub HowTo:
  Pg = 0
how_pg:
  NewScreen
  if Pg = 0 then
    print at 4,3, "FLY THE MAIL BY BALLOON!"
    print at 2,5, "LEFT BUTTON: BURNER (UP)"
    print at 2,7, "STICK DOWN: VENT (DOWN)"
    print at 2,9, "LET GO: IT COOLS, SINKS"
    print at 2,11, "RIGHT BUTTON: DROP A SACK"
    print at 2,13, "WIND ONLY MOVES YOU SIDEWAYS"
    print at 2,15, "AND EACH HEIGHT HAS ITS OWN."
    print at 2,17, "CLOUDS AND ARROWS SHOW IT:"
    for X = 0 to 6
      C = CAR2 + X
      C -= 3
      V = X << 1
      V += 8
      put char C at V,19
    next
    print at 8,22, "PRESS A BUTTON  1/3"
  end if
  if Pg = 1 then
    print at 2,3, "RED FLAG HOUSES WANT MAIL."
    print at 2,5, "THE SACK FALLS AND DRIFTS"
    print at 2,7, "WITH EACH WIND ON THE WAY."
    print at 2,9, "MIDDLE 150 NEAR 100 ROOF 50"
    print at 2,11, "LAND ON A TOWER: FUEL AND"
    print at 2,13, "SACKS. SKIM A HILL: PARCEL."
    print at 2,15, "ALL FLAGS DONE: NEXT DAY."
    ShowObj(1, 4, 6, 17)
    ShowObj(0, 3, 12, 18)
    ShowObj(0, 0, 18, 16)
    ShowObj(0, 5, 23, 19)
    print at 8,22, "PRESS A BUTTON  2/3"
  end if
  if Pg = 2 then
    print at 2,3, "GROUND, SPIRES, ROCKS AND"
    print at 2,5, "TOWER SIDES POP THE BALLOON."
    print at 2,7, "BIRDS KNOCK A SACK OFF."
    print at 2,9, "DARK CLOUDS RUMBLE, PUSH YOU"
    print at 2,11, "DOWN, THEN LIGHTNING HITS."
    print at 2,13, "A BLINKING ARROW: THE WIND"
    print at 2,15, "WILL CHANGE. BEAT THE SUNSET!"
    ShowObj(0, 1, 6, 16)
    ShowObj(0, 2, 12, 16)
    put char CSUN at 22,17
    put char CSUNR at 25,17
    print at 8,22, "PRESS A BUTTON  3/3"
  end if
  ' a balloon on page 1, a sack on page 2, birds on page 3
  fill array Sat with 200
  Sat[32] = 208
  if Pg = 0 then
    Sat[0] = 143
    Sat[1] = 200
    Sat[2] = SEnv1
    Sat[3] = 8
    Sat[4] = 151
    Sat[5] = 200
    Sat[6] = SFlame1
    Sat[7] = 11
    Sat[8] = 159
    Sat[9] = 200
    Sat[10] = SBasket
    Sat[11] = 10
  end if
  if Pg = 1 then
    Sat[0] = 119
    Sat[1] = 52
    Sat[2] = SSack1
    Sat[3] = 10
    Sat[4] = 119
    Sat[5] = 180
    Sat[6] = SParcel
    Sat[7] = 11
  end if
  if Pg = 2 then
    Sat[0] = 135
    Sat[1] = 140
    Sat[2] = SBirdl1
    Sat[3] = 15
    Sat[4] = 151
    Sat[5] = 154
    Sat[6] = SBirdl2
    Sat[7] = 15
  end if
  call asm SkSat
  ShowScreen
  Waited = 0
  WasBtn = 1
hw_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited > 1800 then return
  if Press = 0 then goto hw_loop
  play sound SndClick
  inc Pg
  if Pg < 3 then goto how_pg
  HideSpr
  return
end sub

' an object's footprint at shift 0 drawn at column Xc, row Yr (its codes'
' patterns copied for the page). Vr = target variant.
sub ShowObj(u8 Vr, u8 Ty, u8 Xc, u8 Yr):
  call asm SkObj0 with a = Ty, b = Vr
  N = SkObW
  inc N
  C = SkObB
  for Y = 0 to SkObR - 1
    for X = 0 to N - 1
      K = Xc + X
      V = Yr + Y
      V2 = FpMap[C]
      put char V2 at K,V
      inc C
    next
  next
  return
end sub


sub Credits:
  NewScreen
  print at 12,3, "SKY MAIL"
  print at 5,6, "A GAME BY AMY & CLAUDE"
  print at 9,8, "AMY STUDIO 2026"
  print at 6,11, "MADE IN AMY FOR THE"
  print at 10,13, "COLECOVISION"
  print at 4,16, "AN ORIGINAL GAME: NO PORT."
  print at 3,18, "TITLE MUSIC: AIR MAIL (NEW)"
  print at 8,22, "PRESS A BUTTON"
  ShowScreen
  Waited = 0
  WasBtn = 1
cr_loop:
  Frame1
  ReadPad
  inc Waited
  if Waited > 1800 then return
  if Press = 0 then goto cr_loop
  play sound SndClick
  return
end sub

' ===========================================================================
' the band engine (Z80). VRAM: patterns $0000/$0800/$1000 (thirds),
' colours $2000.., names $1800, sprites $1B00. Every write is paced at
' 30 cycles or more (safe in the active display too).
sub SkEngine:
  asm {
; each screen third gets its own colour table (R3 = $FF)
SkR3:
    ld bc,$03FF
    jp WRITE_REGISTER
; the sprite table for the next blit (slots: 0 envelope, 1 flame, 2 basket,
; 3 sack, 4 popup, 5 parcel, 6-7 birds); x = world - CamD (hidden: Y 200)
SkScr:
    ld de,(CamD)
    or a
    sbc hl,de
    ld a,h
    and 3
    ld a,l
    ret
SkHx4:
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    srl h
    rr l
    ret
SkSpr:
    ld hl,Sat
    ld b,32
SkSq0:
    ld (hl),200
    inc hl
    djnz SkSq0
    ld (hl),208
    ld hl,(Bx)
    call SkHx4
    ld de,-8
    add hl,de
    call SkScr
    jp nz,SkSq5
    ld (SkSx),a
    ld hl,(By)
    call SkHx4
    ld a,l
    dec a
    ld (SkSy),a
    ld a,(Ph)
    cp 1
    jr nz,SkSq1
    ld a,(SkSy)
    add a,60
    ld hl,PhT
    sub (hl)
    ld (Sat),a
    ld a,(SkSx)
    ld (Sat + 1),a
    ld a,(Tick)
    and 8
    ld a,SCrash1
    jr z,SkSq0b
    ld a,SCrash2
SkSq0b:
    ld (Sat + 2),a
    ld a,9
    ld (Sat + 3),a
    jr SkSq5
SkSq1:
    cp 2
    jr z,SkSq2
    ld a,(Grace)
    and 16
    jr nz,SkSq5
SkSq2:
    ld a,(SkSy)
    ld (Sat),a
    add a,16
    ld (Sat + 8),a
    ld a,(SkSx)
    ld (Sat + 1),a
    ld (Sat + 9),a
    ld a,(Tick)
    and 32
    ld a,SEnv1
    jr z,SkSq3
    ld a,SEnv2
SkSq3:
    ld (Sat + 2),a
    ld a,8
    ld (Sat + 3),a
    ld a,SBasket
    ld (Sat + 10),a
    ld a,10
    ld (Sat + 11),a
    ld a,(FlameT)
    or a
    jr z,SkSq5
    ld a,(SkSy)
    add a,8
    ld (Sat + 4),a
    ld a,(SkSx)
    ld (Sat + 5),a
    ld a,(Tick)
    and 4
    ld a,SFlame1
    jr z,SkSq4
    ld a,SFlame2
SkSq4:
    ld (Sat + 6),a
    ld a,11
    ld (Sat + 7),a
SkSq5:
    ld a,(SkOn)
    or a
    jr z,SkSq7
    ld hl,(SkX)
    call SkHx4
    ld de,-8
    add hl,de
    call SkScr
    jr nz,SkSq7
    ld (Sat + 13),a
    ld hl,(SkY)
    call SkHx4
    ld a,l
    dec a
    ld (Sat + 12),a
    ld a,(Tick)
    and 8
    ld a,SSack1
    jr z,SkSq6
    ld a,SSack2
SkSq6:
    ld (Sat + 14),a
    ld a,10
    ld (Sat + 15),a
SkSq7:
    ld a,(PopT)
    or a
    jr z,SkSq8
    dec a
    ld (PopT),a
    and 3
    jr nz,SkSq7b
    ld hl,PopY
    dec (hl)
SkSq7b:
    ld hl,(PopX)
    call SkScr
    jr nz,SkSq8
    ld (Sat + 17),a
    ld a,(PopY)
    ld (Sat + 16),a
    ld a,(PopP)
    ld (Sat + 18),a
    ld a,15
    ld (Sat + 19),a
SkSq8:
    ld b,0
SkSq9:
    ld a,b
    add a,a
    ld e,a
    ld d,0
    ld hl,ParT
    add hl,de
    ld a,(hl)
    inc hl
    or (hl)
    jr nz,SkSq10
    ld hl,HillCx
    add hl,de
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    ld de,-8
    add hl,de
    push bc
    call SkScr
    pop bc
    jr nz,SkSq10
    ld (Sat + 21),a
    ld a,145
    ld (Sat + 20),a
    ld a,SParcel
    ld (Sat + 22),a
    ld a,11
    ld (Sat + 23),a
SkSq10:
    inc b
    ld a,b
    cp 3
    jr c,SkSq9
    ld a,(BrOn)
    or a
    ret z
    ld a,(BrWarn)
    or a
    ret nz
    ld hl,(BrX)
    call SkScr
    jr nz,SkSq11
    ld (Sat + 25),a
    ld a,(BrY)
    dec a
    ld (Sat + 24),a
    ld a,1
    ld (Sat + 27),a
SkSq11:
    ld hl,(BrX)
    ld de,-14
    ld a,(BrDir)
    or a
    jr nz,SkSq12
    ld de,14
SkSq12:
    add hl,de
    call SkScr
    jr nz,SkSq13
    ld (Sat + 29),a
    ld a,(BrY)
    add a,15
    ld (Sat + 28),a
    ld a,1
    ld (Sat + 31),a
SkSq13:
    ld a,(BrDir)
    or a
    ld b,SBirdl1
    ld c,SBirdl2
    jr z,SkSq14
    ld b,SBirdr1
    ld c,SBirdr2
SkSq14:
    ld a,(Tick)
    and 8
    ld a,b
    jr z,SkSq15
    ld a,c
SkSq15:
    ld (Sat + 26),a
    ld (Sat + 30),a
    ret
SkNqP:
    ld b,a
    ld a,(NqN)
    cp NqMax
    ret nc
    ld c,a
    ld l,d
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    add a,l
    ld l,a
    ld a,h
    adc a,$18
    ld h,a
    ex de,hl
    ld l,c
    ld h,0
    add hl,hl
    push bc
    ld bc,NqA
    add hl,bc
    pop bc
    ld (hl),e
    inc hl
    ld (hl),d
    ld hl,NqC
    ld a,c
    add a,l
    ld l,a
    jr nc,SkNq9
    inc h
SkNq9:
    ld (hl),b
    inc c
    ld a,c
    ld (NqN),a
    ret
SkCld:
    ld hl,(CldP + 0)
    ld de,(Wd + 0)
    add hl,de
    ld a,h
    and $3F
    ld h,a
    ld (CldP + 0),hl
    ld a,l
    rrca
    rrca
    rrca
    rrca
    and $0F
    ld c,a
    ld a,h
    rlca
    rlca
    rlca
    rlca
    and $F0
    or c
    ld c,a
    ld a,(CamD)
    sub c
    and 63
    ld (StO + 0),a
    ld hl,(CldP + 2)
    ld de,(Wd + 2)
    add hl,de
    ld a,h
    and $3F
    ld h,a
    ld (CldP + 2),hl
    ld a,l
    rrca
    rrca
    rrca
    rrca
    and $0F
    ld c,a
    ld a,h
    rlca
    rlca
    rlca
    rlca
    and $F0
    or c
    ld c,a
    ld a,(CamD)
    sub c
    and 63
    ld (StO + 1),a
    ld hl,(CldP + 4)
    ld de,(Wd + 4)
    add hl,de
    ld a,h
    and $3F
    ld h,a
    ld (CldP + 4),hl
    ld a,l
    rrca
    rrca
    rrca
    rrca
    and $0F
    ld c,a
    ld a,h
    rlca
    rlca
    rlca
    rlca
    and $F0
    or c
    ld c,a
    ld a,(CamD)
    sub c
    and 63
    ld (StO + 2),a
    ld hl,(CamD)
    srl h
    rr l
    ld a,l
    and 63
    ld (StO + 3),a
    ret
SkVa:
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ret
; copy B bytes (0 = 256) from HL to the VRAM address already set
; (vdp-safe pass, 2026-11-15: always paced, >= 29 T a byte. The OTIR fast
; path for the first ~560 bytes of the frame ran past the vertical blank
; into the active display, where the TMS9928A drops bytes written 23 T apart)
SkCp:
    ld c,$BE
SkCp2:
    outi                ; 18 T + jp nz 11 T = 29 T a byte
    jp nz,SkCp2
    ret
SkSat:
    ld hl,$1B00
    call SkVa
    ld hl,Sat
    ld b,33
    jp SkCp
; a 64-px strip: HL = table, DE = VRAM, A = offset 0-63. Code c shows
; cell (c + q) & 7 at shift s (table + s * 64 + cell * 8)
SkStrip:
    push af
    and 7
    rrca
    rrca
    ld c,a
    and $C0
    ld b,a
    ld a,c
    and $01
    ld c,a
    ld a,b
    add a,l
    ld l,a
    ld a,h
    adc a,c
    ld h,a
    pop af
    rrca
    rrca
    rrca
    and 7
    push hl
    ex de,hl
    push af
    call SkVa
    pop af
    pop hl
    ld d,a
    ld e,8
SkSt1:
    ld a,d
    and 7
    add a,a
    add a,a
    add a,a
    push hl
    add a,l
    ld l,a
    jr nc,SkSt2
    inc h
SkSt2:
    ld b,8
    call SkCp
    pop hl
    inc d
    dec e
    jr nz,SkSt1
    ret
; the village rows 16-20 from VilNm at column CamQ (two runs a row: up to
; the wrap, then from cell 0), then the flagged houses' codes (PatC), then
; the layer-3 wind arrow (column 2, row 17)
SkVil:
    ld hl,$1800 + 16 * 32
    call SkVa
    ld de,VilNm
    ld a,5
    ld (SkTi),a
SkVl1:
    ld a,(CamQ)
    ld l,a
    ld h,0
    add hl,de
    ld a,(CamQ)
    cp 97
    jr c,SkVl3
    sub 96
    ; q > 96: 128 - q bytes, then the rest from the row start
    ld b,a
    ld a,32
    sub b
    push bc
    ld b,a
    call SkCp
    pop bc
    ld h,d
    ld l,e
    call SkCp
    jr SkVl4
SkVl3:
    ld b,32
    call SkCp
SkVl4:
    ld hl,128
    add hl,de
    ex de,hl
    ld a,(SkTi)
    dec a
    ld (SkTi),a
    jr nz,SkVl1
    ld a,(PatN)
    or a
    jr z,SkVl9
    ld b,a
    ld hl,PatC
SkVl5:
    push bc
    push hl
    ld e,(hl)
    ld c,FpTarget
    ld d,17
SkVl6:
    ; row D: 4 codes from C at columns E..E+3 (those in 0-31)
    push de
    ld b,4
SkVl7:
    ld a,e
    cp 32
    jr nc,SkVl8
    cp 2
    jr nz,SkVl10
    ld a,d
    cp 17
    jr z,SkVl8
SkVl10:
    push bc
    ld l,d
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    add a,l
    ld l,a
    ld a,h
    adc a,$18
    ld h,a
    call SkVa
    pop bc
    ld hl,FpMap
    ld a,c
    add a,l
    ld l,a
    jr nc,SkVl11
    inc h
SkVl11:
    ld a,(hl)
    out ($BE),a
SkVl8:
    inc c
    inc e
    ld a,e
    and 127
    ld e,a
    djnz SkVl7
    pop de
    inc d
    ld a,d
    cp 21
    jr c,SkVl6
    pop hl
    pop bc
    inc hl
    djnz SkVl5
SkVl9:
    ld hl,$1800 + 17 * 32 + 2
    call SkVa
    ld a,(Ar3C)
    out ($BE),a
    ret
; name queue
SkNq:
    ld a,(NqN)
    or a
    ret z
    ld b,a
    ld hl,NqA
    ld de,NqC
SkNq1:
    ld a,(hl)
    out ($BF),a
    inc hl
    ld a,(hl)
    or $40
    out ($BF),a
    inc hl
    ld a,(de)
    out ($BE),a
    inc de
    djnz SkNq1
    xor a
    ld (NqN),a
    ret
SkBlit:
    call SkSat
    ld a,(Tick)
    and 1
    jp z,SkNear
; sky frame: the road (camera, as the village shown last frame), 3
; streaks, the far hills, the thunderhead, the rain
    ld a,(CamD)
    and 62
    ld hl,SkStC + 4
    cp (hl)
    jp z,SkGr9
    ld (hl),a
    ld a,(CamD)
    and 6
    ld c,a
    and 2
    rrca
    rrca
    ld l,a
    ld a,c
    rrca
    rrca
    and 1
    ld h,a
    ld de,Ground
    add hl,de
    push hl
    ld a,(CamD)
    and $38
    ld de,CGR * 8 + $1000
    call SkStrip
    pop hl
    ld de,64
    add hl,de
    ld a,(CamD)
    and $38
    ld de,CGR * 8 + $1040
    call SkStrip
SkGr9:
    ld a,(StO)
    ld hl,SkStC + 0
    cp (hl)
    jr z,SkSc0
    ld (hl),a
    ld hl,StrA
    ld de,CSTR0 * 8
    call SkStrip
SkSc0:
    ld a,(StO + 1)
    ld hl,SkStC + 1
    cp (hl)
    jr z,SkSc1
    ld (hl),a
    ld hl,StrB
    ld de,CSTR1 * 8
    call SkStrip
SkSc1:
    ld a,(StO + 2)
    ld hl,SkStC + 2
    cp (hl)
    jr z,SkSc2
    ld (hl),a
    ld hl,StrC
    ld de,CSTR2 * 8 + $0800
    call SkStrip
SkSc2:
    ld a,(StO + 3)
    ld hl,SkStC + 3
    cp (hl)
    jr z,SkSc3
    ld (hl),a
    ld hl,Crest
    ld de,CCREST * 8 + $0800
    call SkStrip
SkSc3:
    ld a,(ThVis)
    or a
    jr z,SkSk2
    ld hl,(ThPA)
    call SkVa
    ld a,(ThS)
    rrca
    rrca
    ld c,a
    and $C0
    ld l,a
    ld a,c
    and $01
    ld h,a
    ld de,ThPat
    add hl,de
    ld b,64
    call SkCp
    ld a,(ThColD)
    or a
    jr z,SkSk1
    xor a
    ld (ThColD),a
    inc a
    ld (SkHeavy),a
    ld hl,(ThCA)
    call SkVa
    ld a,(ThCset)
    rrca
    rrca
    ld c,a
    and $C0
    ld l,a
    ld a,c
    and $03
    ld h,a
    ld de,ThCol
    add hl,de
    ld b,64
    call SkCp
SkSk1:
    ld a,(RainOn)
    or a
    jr z,SkSk2
    ld a,(Tick)
    and 6
    jr nz,SkSk2
    ld hl,(RainA)
    call SkVa
    ld a,(Tick)
    rrca
    and $18
    ld l,a
    ld h,0
    ld de,RainF
    add hl,de
    ld b,8
    call SkCp
SkSk2:
    call SkThN
    jp SkNq
; the thunderhead's names: when its column (ThNC, 255 = none) or its rain
; changed, clear the old footprint (3 rows x 4) and draw the new one
SkThN:
    ld a,(ThNC)
    ld hl,ThDrC
    cp (hl)
    jr nz,SkTn1
    ld a,(ThRainC)
    ld hl,ThDrRn
    cp (hl)
    ret z
SkTn1:
    ld a,(ThDrC)
    cp 255
    jr z,SkTn3
    ld e,a
    ld a,(ThDrR)
    ld d,a
    ld b,3
SkTn2:
    push bc
    push de
    ld b,4
SkTn2b:
    ld a,(ThSkyC)
    call SkPut
    inc e
    djnz SkTn2b
    pop de
    pop bc
    inc d
    djnz SkTn2
SkTn3:
    ld a,(ThNC)
    ld (ThDrC),a
    ld a,(ThRow)
    ld (ThDrR),a
    ld a,(ThRainC)
    ld (ThDrRn),a
    ld a,(ThNC)
    cp 255
    ret z
    ld e,a
    ld a,(ThRow)
    ld d,a
    ld a,(ThBase)
    ld c,a
    ld b,4
SkTn4:
    ld a,c
    call SkPut
    inc d
    ld a,c
    add a,4
    call SkPut
    inc d
    ld a,b
    cp 4
    jr z,SkTn5
    ld a,(ThRainC)
    call SkPut
SkTn5:
    dec d
    dec d
    inc c
    inc e
    djnz SkTn4
    ret
; A at column E, row D (columns 0-31 except 2)
SkPut:
    push af
    ld a,e
    cp 32
    jr nc,SkPu1
    cp 2
    jr z,SkPu1
    push hl
    ld l,d
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld a,e
    add a,l
    ld l,a
    ld a,h
    adc a,$18
    ld h,a
    call SkVa
    pop hl
    pop af
    out ($BE),a
    ret
SkPu1:
    pop af
    ret
; village frame: names (when it crossed a cell), road, object patterns
SkNear:
    ld hl,(CamD)
    ld (BlitCam),hl
    ld a,(VisM)
    ld (BlitVis),a
    ld a,(VilD)
    or a
    jr z,SkNr1
    xor a
    ld (VilD),a
    call SkVil
SkNr1:
; object types in view (VisM bits 0-5), shift CamD & 6 (2 bytes a shift)
    ld a,(CamD)
    and 6
    ld (SkSh),a
    ld a,(VisM)
    ld (SkVm),a
    xor a
    ld (SkTi),a
    ld hl,SkTypes
SkNr2:
    push hl
    ld hl,SkLast
    ld a,(SkTi)
    ld e,a
    ld d,0
    add hl,de
    ld a,(SkVm)
    rrca
    ld (SkVm),a
    jr c,SkNr6
    ld (hl),255
    pop hl
    jr SkNr3
SkNr6:
    ld a,(SkSh)
    cp (hl)
    ld (hl),a
    pop hl
    jr z,SkNr3
    push hl
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld b,(hl)
    inc hl
    ld a,(SkSh)
    add a,l
    ld l,a
    jr nc,SkNr5
    inc h
SkNr5:
    ld a,(SkTi)
    cp 4
    jr nz,SkNr4
    ld a,(TgVar)
    or a
    jr z,SkNr4
    ld a,8
    add a,l
    ld l,a
    jr nc,SkNr4
    inc h
SkNr4:
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    push hl
    ex de,hl
    call SkVa
    pop hl
    call SkCp
    pop hl
SkNr3:
    ld de,19
    add hl,de
    ld a,(SkTi)
    inc a
    ld (SkTi),a
    cp 6
    jr c,SkNr2
    jp SkNq

; per type (order tower, church, rock, house, target, hill): VRAM pattern
; address, bytes, 4 shifts (target: + the other flag's 4 shifts)
SkTypes:
    dw BTower * 8 + $1000
    db NTower
    dw PreTower0, PreTower0 + NTower, PreTower0 + NTower * 2, PreTower0 + NTower * 3, 0, 0, 0, 0
    dw BChurch * 8 + $1000
    db NChurch
    dw PreChurch0, PreChurch0 + NChurch, PreChurch0 + NChurch * 2, PreChurch0 + NChurch * 3, 0, 0, 0, 0
    dw BRock * 8 + $1000
    db NRock
    dw PreRock0, PreRock0 + NRock, PreRock0 + NRock * 2, PreRock0 + NRock * 3, 0, 0, 0, 0
    dw BHouse * 8 + $1000
    db NHouse
    dw PreHouse0, PreHouse0 + NHouse, PreHouse0 + NHouse * 2, PreHouse0 + NHouse * 3, 0, 0, 0, 0
    dw BTarget * 8 + $1000
    db NTarget
    dw PreTarget0, PreTarget0 + NTarget, PreTarget0 + NTarget * 2, PreTarget0 + NTarget * 3
    dw PreTarget1, PreTarget1 + NTarget, PreTarget1 + NTarget * 2, PreTarget1 + NTarget * 3
    dw BHill * 8 + $1000
    db NHill
    dw PreHill0, PreHill0 + NHill, PreHill0 + NHill * 2, PreHill0 + NHill * 3, 0, 0, 0, 0
; HOW TO PLAY pictures: type A, variant B -> its shift-0 patterns copied,
; SkObW (W), SkObR (rows), SkObB (first code)
SkObj0:
    ld c,a
    ld e,a
    ld d,0
    ld hl,SkObInfo
    add hl,de
    add hl,de
    add hl,de
    ld a,(hl)
    ld (SkObW),a
    inc hl
    ld a,(hl)
    ld (SkObR),a
    inc hl
    ld a,(hl)
    ld (SkObB),a
    ld a,c
    add a,a
    add a,a
    add a,a
    add a,a
    add a,c
    add a,c
    add a,c
    ld e,a
    ld d,0
    ld hl,SkTypes
    add hl,de
    ld e,(hl)
    inc hl
    ld d,(hl)
    inc hl
    ld c,(hl)
    inc hl
    ld a,b
    or a
    jr z,SkOb1
    ld a,8
    add a,l
    ld l,a
    jr nc,SkOb1
    inc h
SkOb1:
    ld b,c
    ld a,(hl)
    inc hl
    ld h,(hl)
    ld l,a
    push hl
    ex de,hl
    call SkVa
    pop hl
    jp SkCp
SkObInfo:
    db WTower, 5, FpTower, WChurch, 5, FpChurch, WRock, 5, FpRock, WHouse, 3, FpHouse, WTarget, 4, FpTarget, WHill, 2, FpHill
  }
end sub

