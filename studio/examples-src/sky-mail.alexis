' lift by heat / 8, stored + 8 (sink 6 .. rise 6)
data LiftT bytes 14,14,13,13,13,12,12,11,11,11,10,10,10,9,9,8,8,8,7,7,7,6,6,5,5,5,4,4,4,3,3,2
data BirdYT bytes 40,56,72
data ThTopT bytes 32,64,96
data ThPhT bytes 0,180,120,360,120
data ArRowT bytes 4,8,12,17

const StTitle = 1
const StHow = 2
const StCred = 3
const StPlay = 4
const StOver = 9
const FuelMax = 3000
const FuelLow = 900
const DayClk = 7200
const YMin = 384
const NqMax = 48

' ---- engine (read by the asm) ----
u8 Sat[33]
u8 StO[4]
u16 CamD = 0
u8 CamQ = 0
u8 OldQ = 255
u8 VilD = 0
u8 VisM = 0
u8 TgVar = 0
u8 ThVis = 0
