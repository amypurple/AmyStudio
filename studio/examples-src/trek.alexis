const NSpr = 7
const SyMin = 28
const SyMax = 134
const LowY = 122
const XStart1 = 56
const XStart2 = 24
const XEnd = 104
const OrbFrames = 30
const DroneIn = 224
const BallFuel = 300
const BallStartY = 140
const CrysFrames = 16
const ShieldsMax = 100
const HitCost = 15
const PhCost = 5
const EndN = 60

record Drone:
  u8 X
  u8 Y
  u8 F
  u8 Spd
end record

data HomeRate bytes
  0, 6, 8, 11, 14
end data

data DroneCol bytes
  5, 9, 3
end data

Drone Dr[3]
u16 TzLeft = 0
u8 TzOn = 0
u16 Rs = 1
u16 W16 = 0
u16 NumU = 0
u16 Score = 0
u16 Hi = 0
u16 SurfP = 0
u16 OldScore = 999
u8 Level = 1
u8 Sy = 120
u8 ShipX = 56
u8 GravT = 0
u8 OrbT = 0
u8 Orbit = 0
u8 BackT = 0
u8 HomeAcc = 0
u8 Shields = 100
u8 OldShields = 255
u8 Hits = 0
u8 TimeT = 0
u8 PlayT = 0
u16 PlT = 0
u8 BX = 0
u8 BY = 0
u8 BF = 0
u8 BAcc = 0
u8 PhOn = 0
u8 PhX = 0
u8 PhY = 0
u8 Kills = 0
u8 Crys = 0
u8 BeamT = 0
u8 Beaming = 0
u8 Over = 0
u8 OverKind = 0
u8 EndT = 0
u8 FlashT = 0
u8 FlashOn = 0
u8 OldCe = 255
u8 OldHint = 255
u8 OldOrbit = 255
u8 TitleOn = 0
u8 TitleX = 16
u8 AnimT = 0
' input
u8 J1 = 0
u8 J2 = 0
u8 Btn = 0
u8 WasBtn = 0
u8 Press = 0
u8 Hold2 = 0
u8 WasStick = 0
u8 Menu = 0
u8 Tick = 0
u8 Idle = 0
' loop counters (never shared with helpers)
u8 Di = 0
u8 Ri = 0
u8 Ki = 0
' scratch
u8 C = 0
u8 J = 0
u8 K = 0
u8 N = 0
u8 V = 0
u8 X = 0
u8 Y = 0

  tile screen
  set sound table TkSoundTable areas 6
  sprites 16x16
  set sprite count NSpr
  sprites stable 0 to 1
  sprites flicker on
  nmi off
  copy SpritePat count SprBytes to vram.spr_pat
  HideSprites
  screen on
  CreditsPage

title:
  TitlePage
  if Menu >= 2 then goto title

  NewGame

play_loop:
  Frame1
  DrawSurf
  DrawSprites
  ReadPad
  PlayPass
  ShowHud
  if Over = 0 then goto play_loop

  EndMessage
  Rearm
  wait 60 frames
  nmi on
  pause until press and release sleep after 30 seconds
  nmi off
  goto title

' ---------------------------------------------------------------------------
' one pass of play (one frame)

sub PlayPass:
  if EndT > 0 then
    EndAnim
    return
  end if
  V = J1 | J2
  inc SurfP
  SurfP = SurfP & 511
  if PlayT < 255 then inc PlayT
  MoveShip
  Rand
  Orbiting
  if EndT > 0 then return
  if PlT > 0 then
    MoveBall
  else
    MoveDrones
    MaybeLaunch
  end if
  if EndT > 0 then return
  Phasers
  BeamUp
  TimeScore
  return
end sub

' thrust 1 pixel a frame up or down, gravity 1 pixel every 4 frames
sub MoveShip:
  K = V & 1
  if K > 0 then
    if Sy > SyMin then dec Sy
  end if
  K = V & 2
  if K > 0 then
    if Sy < SyMax then inc Sy
  end if
  inc GravT
  if GravT >= 8 then
    GravT = 0
    if Sy < SyMax then inc Sy
  end if
  return
end sub

' the orbit: the ship drifts right one pixel every 30 frames (not while
' the plasma ball is out); at the right end the next orbit, after two the
' mission is won
sub Orbiting:
  if BackT > 0 then
    dec BackT
    ShipX = ShipX - 2
    return
  end if
  if PlT > 0 then return
  inc OrbT
  if OrbT < OrbFrames then return
  OrbT = 0
  inc ShipX
  if ShipX <= XEnd then return
  inc Orbit
  if Orbit >= 2 then
    dec ShipX
    Victory2
    return
  end if
  ' glide back to the left: 2 pixels a frame
  BackT = XEnd + 1 - XStart2
  BackT = BackT >> 1
  return
end sub

' does a box at (Ax, Ay) touch the ship? Wx/Hy: the summed half-ranges
' as offsets (see the header of model.mjs)
function Touch(u8 Ax, u8 Ay, u8 Ox, u8 Wx, u8 Oy, u8 Hy) as u8
  u8 T = 0
  T = Ax + Ox
  if T < ShipX then return 0
  T = T - ShipX
  if T > Wx then return 0
  T = Ay + Oy
  if T < Sy then return 0
  T = T - Sy
  if T > Hy then return 0
  return 1

sub MoveDrones:
  u8 Mv = 0
  u8 Dx = 0
  u8 Dy = 0
  u8 Step1 = 0
  HomeAcc = HomeAcc + HomeRate[Level]
  if HomeAcc >= 24 then
    HomeAcc = HomeAcc - 24
    Step1 = 1
  end if
  for Di = 0 to 2
    Dx = Dr[Di].X
    Dy = Dr[Di].Y
    Mv = Dr[Di].F + Dr[Di].Spd
    Dr[Di].F = Mv & 1
    Mv = Mv >> 1
    if Dx < Mv + 16 then
      Dx = DroneIn
      Dy = Sy
    else
      Dx = Dx - Mv
    end if
    if Step1 = 1 then
      if Dy < Sy then
        inc Dy
      elseif Dy > Sy then
        dec Dy
      end if
    end if
    if Touch(Dx, Dy, 10, 21, 4, 10) = 1 then
      Dx = DroneIn
      DroneHit
    end if
    Dr[Di].X = Dx
    Dr[Di].Y = Dy
    if EndT > 0 then return
  next
  return
end sub

' a drone hit: 15 shield energy, a point; no energy left: the crash
sub DroneHit:
  inc Hits
  if Score > 0 then dec Score
  play sound SndHit
  if Shields < HitCost then
    Shields = 0
    StartEnd(1)
    return
  end if
  Shields = Shields - HitCost
  return
end sub

sub StartEnd(u8 Kind)
  OverKind = Kind
  EndT = EndN
  PhOn = 0
  Beaming = 0
  if Kind < 3 then play sound SndCrash
  return
end sub

' the plasma cannon: a chance every frame (levels 1-2: 1 in 2048, 3-4: 5)
sub MaybeLaunch:
  if PlayT < 180 then return
  W16 = Rs & 2047
  K = 1
  if Level >= 3 then K = 5
  if W16 >= K then return
  PlT = BallFuel
  BX = DroneIn
  BY = BallStartY
  BF = 0
  BAcc = 0
  play sound SndPlasma
  return
end sub

' the plasma ball: 1.5 pixels a frame left, homing 12 (levels 1-2) or 16
' (3-4) steps in 24 frames; touching it ends the game; out of fuel: the
' drones come back
sub MoveBall:
  u8 Mv = 0
  dec PlT
  if PlT = 0 then
    Dr[1].X = DroneIn
    Dr[1].Y = Sy
    return
  end if
  Mv = 2
  if BX < Mv + 16 then
    BX = DroneIn
  else
    BX = BX - Mv
  end if
  K = 8
  if Level >= 3 then K = 12
  BAcc = BAcc + K
  if BAcc >= 24 then
    BAcc = BAcc - 24
    if BY < Sy then
      inc BY
    elseif BY > Sy then
      dec BY
    end if
  end if
  if Touch(BX, BY, 9, 19, 6, 12) = 1 then
    PlT = 0
    StartEnd(2)
  end if
  return
end sub

' phasers: a press fires a beam along the ship's line (5 energy, a point)
sub Phasers:
  u8 Dx = 0
  u8 T = 0
  if PhOn = 0 then
    if Press = 0 then return
    if Shields < PhCost then
      play sound SndZap
      return
    end if
    Shields = Shields - PhCost
    if Score > 0 then dec Score
    PhOn = 1
    PhX = ShipX + 14
    PhY = Sy + 3
    play sound SndPhaser
    return
  end if
  PhX = PhX + 12
  if PhX >= 224 then
    PhOn = 0
    return
  end if
  if PlT > 0 then return
  for Di = 0 to 2
    Dx = Dr[Di].X
    T = Dx + 12
    if T >= PhX then
      T = PhX + 12
      if Dx <= T then
        T = Dr[Di].Y + 4
        if PhY <= T then
          if PhY >= Dr[Di].Y then
            Dr[Di].X = DroneIn
            inc Kills
            PhOn = 0
            play sound SndZap
            return
          end if
        end if
      end if
    end if
  next
  return
end sub

' the large mountain's middle, in screen pixels from pixel 16
function MineDist as u16
  u16 D = 0
  D = BigC + 512
  D = D - SurfP
  D = D & 511
  return D

' over the large mountain (its middle within 16 pixels of the ship's) in a
' low orbit
function CanBeam as u8
  u16 D = 0
  if Sy < LowY then return 0
  D = MineDist()
  D = D + 24
  if D < ShipX then return 0
  D = D - ShipX
  if D > 32 then return 0
  return 1

' beam-up: right button held where it can work: a crystal every 16 frames
sub BeamUp:
  Beaming = 0
  if Hold2 = 0 then
    BeamT = 0
    return
  end if
  if CanBeam() = 0 then
    BeamT = 0
    return
  end if
  Beaming = 1
  inc BeamT
  if BeamT < CrysFrames then return
  BeamT = 0
  inc Crys
  Score = Score + 2
  Shields = Shields + HitCost
  if Shields > ShieldsMax then Shields = ShieldsMax
  play sound SndCrystal
  return
end sub

' a point every tenth of a second
sub TimeScore:
  inc TimeT
  if TimeT < 6 then return
  TimeT = 0
  inc Score
  return
end sub

sub Victory2:
  Over = 0
  if Score > Hi then Hi = Score
  OverKind = 3
  EndT = 1
  play sound SndWin
  return
end sub

' the end: the crashing ship falls to the ground, then the message
sub EndAnim:
  dec EndT
  if OverKind = 1 then
    if Sy < 150 then inc Sy
    if ShipX < 200 then inc ShipX
  end if
  if EndT = 0 then Over = 1
  return
end sub

' xorshift (7, 9, 8)
sub Rand:
  W16 = Rs << 7
  Rs = Rs ^ W16
  W16 = Rs >> 9
  Rs = Rs ^ W16
  W16 = Rs << 8
  Rs = Rs ^ W16
  return
end sub

' ---------------------------------------------------------------------------
' drawing

' the surface: the patterns at the shift, the names when the cell changes,
' the large range's colours while beaming (3 Hz at most)
sub DrawSurf:
  u16 Ofs = 0
  u16 Va = 0
  u8 Ce = 0
  Ofs = SurfP & 7
  Ofs = Ofs * StripBytes
  copy StripTab + Ofs count StripBytes to vram.pattern + 5120
  W16 = SurfP >> 3
  Ce = W16
  if Ce <> OldCe then
    OldCe = Ce
    Va = 18 * 32 + 2
    for Ri = 0 to 3
      Ofs = Ri * 96
      Ofs = Ofs + Ce
      copy NameTab + Ofs count 28 to vram.name + Va
      Va = Va + 32
    next
  end if
  K = 0
  if Beaming = 1 then
    inc FlashT
    if FlashT >= 20 then FlashT = 0
    if FlashT < 10 then K = 1
  else
    FlashT = 0
  end if
  if K <> FlashOn then
    FlashOn = K
    if K = 1 then
      copy ColF count BigBytes to vram.color + 5120
    else
      copy ColN count BigBytes to vram.color + 5120
    end if
  end if
  return
end sub

' sprites: 0 the ship, 1 the beam / explosion, 2 the phaser, 3-5 drones,
' 6 the plasma ball
sub DrawSprites:
  u8 Sp = 0
  Y = Sy - 5
  if EndT > 0 then
    if OverKind < 3 then
      set sprite 0 to Y,ShipX,SBoom,9
    else
      set sprite 0 to Y,ShipX,SShip,15
    end if
  else
    set sprite 0 to Y,ShipX,SShip,15
  end if
  if Beaming = 1 then
    Y = Sy + 3
    K = SBeam1
    inc AnimT
    C = AnimT & 8
    if C > 0 then K = SBeam2
    set sprite 1 to Y,ShipX,K,11
  else
    set sprite 1 to 192,0,0,0
  end if
  if PhOn = 1 then
    Y = PhY - 8
    set sprite 2 to Y,PhX,SPhaser,9
  else
    set sprite 2 to 192,0,0,0
  end if
  for Di = 0 to 2
    Sp = Di + 3
    if EndT > 0 then
      set sprite Sp to 192,0,0,0
    elseif PlT > 0 then
      set sprite Sp to 192,0,0,0
    else
      Y = Dr[Di].Y - 5
      X = Dr[Di].X
      C = DroneCol[Di]
      K = SDrone1
      J = Tick & 16
      if J > 0 then K = SDrone2
      set sprite Sp to Y,X,K,C
    end if
  next
  if PlT > 0 then
    Y = BY - 4
    K = SBall1
    C = 11
    J = Tick & 8
    if J > 0 then
      K = SBall2
      C = 15
    end if
    set sprite 6 to Y,BX,K,C
  else
    set sprite 6 to 192,0,0,0
  end if
  update sprites
  return
end sub

' score (row 1), shields (row 2), orbit and the beam-up hint (row 22)
sub ShowHud:
  u8 Halves = 0
  if Score <> OldScore then
    OldScore = Score
    NumU = Score
    print at 8,1, digits$(NumU, 5)
  end if
  if Shields <> OldShields then
    OldShields = Shields
    Halves = Shields / 5
    for Ki = 0 to 9
      K = TBar0
      if Halves >= 2 then
        K = TBar2
        Halves = Halves - 2
      elseif Halves = 1 then
        K = TBar1
        Halves = 0
      end if
      X = Ki + 10
      put char K at X,2
    next
    NumU = Shields
    print at 21,2, digits$(NumU, 3)
  end if
  if Orbit <> OldOrbit then
    OldOrbit = Orbit
    if Orbit < 2 then
      NumU = Orbit + 1
      print at 8,22, digits$(NumU, 1)
    end if
  end if
  K = 0
  if EndT = 0 then K = CanBeam()
  if K <> OldHint then
    OldHint = K
    if K = 1 then
      print at 16,22, "CRYSTALS"
    else
      print at 16,22, "        "
    end if
  end if
  return
end sub

sub EndMessage:
  HideSprites
  for Ri = 7 to 13
    fill 32 count 26 at 3,Ri
  next
  select case OverKind
  case 1
    print at 7,8, "SHIELDS COLLAPSED"
    print at 7,10, "STARSHIP DESTROYED"
  case 2
    print at 5,8, "HIT BY THE PLASMA BALL"
    print at 7,10, "STARSHIP DESTROYED"
  case else
    print at 6,8, "TWO ORBITS COMPLETE"
    print at 4,10, "CRYSTALS ABOARD: ONWARD"
  end select
  print at 9,12, "SCORE"
  NumU = Score
  print at 15,12, digits$(NumU, 5)
  NumU = Hi
  print at 23,1, digits$(NumU, 5)
  return
end sub

' the field: stars, the surface, the HUD
sub DrawField:
  for Ri = 3 to 17
    for Ki = 2 to 29
      K = BgAt(Ki, Ri)
      put char K at Ki,Ri
    next
  next
  OldCe = 255
  FlashOn = 0
  copy ColN count BigBytes to vram.color + 5120
  DrawSurf
  return
end sub

function BgAt(u8 Cc, u8 Rr) as u8
  u8 H = 0
  H = Cc * 5
  H = H + Rr * 11
  H = H & 31
  if H = 3 then return TStar1
  if H = 20 then return TStar2
  if H = 11 then return TStar3
  return 32

sub NewGame:
  NewScreen
  for Di = 0 to 2
    Dr[Di].X = 120 + Di * 52
    Dr[Di].Y = 40 + Di * 30
    Dr[Di].F = 0
    Dr[Di].Spd = Di + 2
  next
  SurfP = 0
  Sy = 120
  ShipX = XStart1
  GravT = 0
  OrbT = 0
  Orbit = 0
  BackT = 0
  HomeAcc = 0
  Shields = ShieldsMax
  Hits = 0
  TimeT = 0
  PlayT = 0
  PlT = 0
  PhOn = 0
  Kills = 0
  Crys = 0
  BeamT = 0
  Beaming = 0
  Over = 0
  OverKind = 0
  EndT = 0
  Score = 0
  OldScore = 999
  OldShields = 255
  OldOrbit = 255
  OldHint = 255
  TitleOn = 0
  DrawField
  print at 2,1, "SCORE"
  print at 20,1, "HI"
  NumU = Hi
  print at 23,1, digits$(NumU, 5)
  print at 2,2, "SHIELDS"
  print at 25,2, "L"
  NumU = Level
  print at 26,2, digits$(NumU, 1)
  print at 2,22, "ORBIT"
  print at 10,22, "OF 2"
  ShowHud
  DrawSprites
  ShowScreen
  play sound SndStart
  Rearm
  wait no fire
  nmi off
  return
end sub

' ---------------------------------------------------------------------------

sub Rearm:
  if TzOn = 1 then
    dec TzLeft
    if TzLeft = 0 then
      stop sound SndTuneA
      stop sound SndTuneB
      TzOn = 0
    end if
  end if
  nmi off
  nmi on
  return
end sub

sub Frame1:
  Rearm
  Idle = 1
  wait
  Idle = 0
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  J1 = 0
  J2 = 0
  if joypad(1).up then J1 = J1 | 1
  if joypad(1).down then J1 = J1 | 2
  if joypad(1).left then J1 = J1 | 4
  if joypad(1).right then J1 = J1 | 8
  if joypad(1).button1 then J1 = J1 | 16
  if joypad(1).button2 then J1 = J1 | 32
  if joypad(2).up then J2 = J2 | 1
  if joypad(2).down then J2 = J2 | 2
  if joypad(2).left then J2 = J2 | 4
  if joypad(2).right then J2 = J2 | 8
  if joypad(2).button1 then J2 = J2 | 16
  if joypad(2).button2 then J2 = J2 | 32
  V = J1 | J2
  Btn = V & 16
  Press = 0
  if Btn > 0 then
    if WasBtn = 0 then Press = 1
  end if
  WasBtn = Btn
  Hold2 = V & 32
  return
end sub

sub HideSprites:
  clear sprites
  set sprite count NSpr
  for J = 0 to 6
    set sprite J to 192,0,0,0
  next
  update sprites
  return
end sub

sub NewScreen:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  fill mode 2 text color with $F0
  copy TilePat count NTiles8 to vram.pattern + 1024
  copy TileCol count NTiles8 to vram.color + 1024
  copy TilePat count NTiles8 to vram.pattern + 3072
  copy TileCol count NTiles8 to vram.color + 3072
  copy TilePat count NTiles8 to vram.pattern + 5120
  copy TileCol count NTiles8 to vram.color + 5120
  backdrop black
  cls
  return
end sub

sub ShowScreen:
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' the title: stars, the TREK logo, the starship crossing; the tune once;
' START GAME / LEVEL / CREDITS
sub TitlePage:
  NewScreen
  for Ri = 1 to 22
    for Ki = 2 to 29
      K = BgAt(Ki, Ri)
      put char K at Ki,Ri
    next
  next
  DrawLogo
  print at 6,11, "BY ANDREW BEERY"
  print at 2,12, "COMPUTE!'S GAZETTE OCT 1984"
  print at 10,15, "START GAME"
  print at 10,17, "LEVEL"
  print at 10,19, "HOW TO PLAY"
  print at 10,21, "CREDITS"
  print at 3,22, "BEST"
  NumU = Hi
  print at 8,22, digits$(NumU, 5)
  ShowMenu
  TitleOn = 1
  TitleX = 16
  ShowScreen
  play sound SndTuneA
  play sound SndTuneB
  TzLeft = 530
  TzOn = 1
  Rearm
  wait no fire
  nmi off
tp_loop:
  Frame1
  inc TitleX
  if TitleX > 224 then TitleX = 16
  set sprite 0 to 98,TitleX,SShip,15
  update sprites
  inc Rs
  ReadPad
  V = J1 | J2
  K = V & 15
  if K > 0 then
    if WasStick = 0 then TitleStick
  end if
  WasStick = K
  if Btn > 0 then goto tp_go
  if Hold2 > 0 then goto tp_go
  goto tp_loop
tp_go:
  stop sound SndTuneA
  stop sound SndTuneB
  mute all
  TzOn = 0
  TitleOn = 0
  W16 = Tick
  W16 = W16 << 8
  Rs = Rs ^ W16
  if Rs = 0 then Rs = 1
  HideSprites
  if Menu = 2 then HowTo
  if Menu = 3 then CreditsPage
  return
end sub

sub TitleStick:
  C = K & 1
  if C > 0 then
    if Menu > 0 then dec Menu
  end if
  C = K & 2
  if C > 0 then
    if Menu < 3 then inc Menu
  end if
  if Menu = 1 then
    C = K & 4
    if C > 0 then
      if Level > 1 then dec Level
    end if
    C = K & 8
    if C > 0 then
      if Level < 4 then inc Level
    end if
  end if
  play sound SndTick
  ShowMenu
  return
end sub

sub ShowMenu:
  put char 32 at 8,15
  put char 32 at 8,17
  put char 32 at 8,19
  put char 32 at 8,21
  J = Menu << 1
  J = J + 15
  put char 62 at 8,J
  NumU = Level
  print at 17,17, "< ", digits$(NumU, 1), " >"
  return
end sub

' the logo: TREK in a 5 x 7 block font, LogoW wide at column LogoX, rows 2-8
sub DrawLogo:
  N = 0
  for Ri = 0 to 6
    Y = Ri + 2
    for J = 0 to LogoW - 1
      if LogoTab[N] = 1 then
        X = J + LogoX
        put char TBlk at X,Y
      end if
      inc N
    next
  next
  return
end sub

' HOW TO PLAY: three pages with the game's sprites; the button turns the
' page, after the last one (or 30 s without a press) back to the title
sub HowTo:
  u8 Pg = 0
  u16 Wt = 0
  for Pg = 1 to 3
    NewScreen
    print at 9,1, "HOW TO PLAY"
    HowPage(Pg)
    print at 5,22, "BUTTON: NEXT PAGE"
    ShowScreen
    Rearm
    wait no fire
    nmi off
    Wt = 0
hw_loop:
    Frame1
    ReadPad
    if Press = 1 then goto hw_next
    if Hold2 > 0 then goto hw_next
    inc Wt
    if Wt < 1800 then goto hw_loop
    HideSprites
    return
hw_next:
    play sound SndTick
  next
  HideSprites
  return
end sub

sub HowPage(u8 P)
  select case P
  case 1
    print at 2,3, "YOUR STARSHIP HAS LOST ITS"
    print at 2,4, "ENERGY CRYSTALS. SURVIVE"
    print at 2,5, "TWO ORBITS OF THE PLANETOID"
    print at 2,6, "TO WIN."
    print at 2,8, "PUSH THE STICK UP OR DOWN"
    print at 2,9, "TO THRUST. GRAVITY PULLS"
    print at 2,10, "YOU DOWN."
    set sprite 0 to 100,60,SShip,15
    print at 2,15, "DRONES CHASE YOU. EACH HIT"
    print at 2,16, "COSTS 15 SHIELD ENERGY."
    print at 2,17, "NO SHIELDS LEFT: YOU CRASH."
    set sprite 3 to 100,150,SDrone1,5
    set sprite 4 to 100,180,SDrone1,9
  case 2
    print at 2,3, "THE PLASMA BALL RISES FROM"
    print at 2,4, "THE GROUND. ONE TOUCH AND"
    print at 2,5, "YOUR SHIP IS DESTROYED!"
    set sprite 6 to 52,120,SBall1,11
    print at 2,10, "LEFT BUTTON: PHASERS. THEY"
    print at 2,11, "DESTROY DRONES BUT COST"
    print at 2,12, "ENERGY AND GIVE NO POINTS."
    set sprite 0 to 110,40,SShip,15
    set sprite 2 to 106,70,SPhaser,9
    set sprite 3 to 110,110,SDrone2,3
  case else
    print at 2,3, "OVER THE BIG MOUNTAIN, FLY"
    print at 2,4, "LOW AND HOLD THE RIGHT"
    print at 2,5, "BUTTON: CRYSTALS BEAM UP"
    print at 2,6, "AND YOUR SHIELDS GROW."
    set sprite 0 to 60,120,SShip,15
    set sprite 1 to 68,120,SBeam1,11
    print at 2,13, "SCORE: THE TIME YOU FLY"
    print at 2,14, "MINUS THE HITS YOU TAKE."
    print at 2,16, "TIP: USE PHASERS SPARINGLY"
    print at 2,17, "AND REFUEL AT THE MOUNTAIN."
  end select
  update sprites
  return
end sub

sub CreditsPage:
  NewScreen
  print at 14,1, "TREK"
  print at 2,3, "BASED ON TREK BY ANDREW"
  print at 2,4, "BEERY, COMPUTE!'S GAZETTE"
  print at 2,5, "OCTOBER 1984 (COMMODORE 64)."
  print at 2,7, "COLECOVISION GAME, MUSIC"
  print at 2,8, "AND PICTURES BY CLAUDE"
  print at 2,9, "(ANTHROPIC) FOR AMY STUDIO,"
  print at 2,10, "IN AMY BY AMY BIENVENU, 2026"
  print at 2,11, "MUSIC: LOW ORBIT (ORIGINAL)"
  print at 2,13, "STICK UP/DOWN: THRUST"
  print at 2,14, "LEFT BUTTON: PHASERS"
  print at 2,15, "RIGHT BUTTON: BEAM UP ENERGY"
  print at 2,16, "CRYSTALS OVER THE BIG"
  print at 2,17, "MOUNTAIN IN A LOW ORBIT."
  print at 2,18, "DODGE DRONES AND THE PLASMA"
  print at 2,19, "BALL FOR TWO ORBITS."
  print at 7,21, "PRESS THE BUTTON"
  ShowScreen
  Rearm
  pause until press
  wait no fire
  nmi off
  return
end sub

