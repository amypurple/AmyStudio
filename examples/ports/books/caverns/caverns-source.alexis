  $00,$00,$03,$07,$01,$0F,$05,$03,$02,$04,$00,$00,$00,$00,$00,$00
  $00,$00,$C0,$E0,$80,$F0,$A0,$C0,$40,$20,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$08,$05,$13,$0F,$13,$04,$08,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$10,$A0,$C8,$F0,$C8,$20,$10,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$10,$0A,$07,$1F,$07,$0A,$10,$00,$00,$00,$00,$00,$00
  $00,$00,$00,$08,$50,$E0,$F8,$E0,$50,$08,$00,$00,$00,$00,$00,$00
  $00,$00,$0B,$0F,$1B,$1F,$15,$0F,$0A,$18,$00,$00,$00,$00,$00,$00
  $00,$00,$D0,$F0,$D8,$F8,$A8,$F0,$50,$18,$00,$00,$00,$00,$00,$00
  $00,$00,$0B,$0F,$1D,$1F,$1A,$0F,$1A,$08,$00,$00,$00,$00,$00,$00
  $00,$00,$D0,$F0,$B8,$F8,$58,$F0,$58,$10,$00,$00,$00,$00,$00,$00
