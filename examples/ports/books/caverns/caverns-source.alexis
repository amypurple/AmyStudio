asm {
; ---------------------------------------------------------------------------
; Vertical software scrolling for the caverns. Each name table cell holds
; pair tile 128 + 4 x (kind of the line above) + (kind of the line below);
; the pair patterns are rewritten every frame for the scroll offset, and
; the hidden name table ($1800 or $1C00) is rebuilt for the next line
; position a few rows at a time, then shown with one register write.
; Kinds: 0 rock, 1 cavern floor, 2 trapdoor, 3 side passage.
; ---------------------------------------------------------------------------

; Kind of line A (ring index) at column C, in A (keeps BC, DE, HL)
ZType:
    push de
    push hl
    ld e,a
    ld d,0
    ld hl,AMY_UVAR_LL
    add hl,de
    ld a,c
    cp (hl)
    jr c,zt_out
    ld hl,AMY_UVAR_LR
    add hl,de
    ld a,(hl)
    cp c
    jr c,zt_out
    ld hl,AMY_UVAR_TD
    add hl,de
    ld a,(hl)
    cp c
    ld a,1
    jr nz,zt_done
    ld a,2
    jr zt_done
zt_out:
    ld hl,AMY_UVAR_PA
    add hl,de
    ld a,(hl)
    or a
    jr z,zt_rock
    ld a,c
    cp (hl)
    jr c,zt_rock
    ld hl,AMY_UVAR_PB
    add hl,de
    ld a,(hl)
    cp c
    jr c,zt_rock
    ld a,3
    jr zt_done
zt_rock:
    xor a
zt_done:
    pop hl
    pop de
    ret

; ZRes = kind of line ZLine at column ZCol (for the game code)
ZKindAt:
    ld a,(AMY_UVAR_ZCol)
    ld c,a
    ld a,(AMY_UVAR_ZLine)
    and 31
    call ZType
    ld (AMY_UVAR_ZRes),a
    ret

; Kinds of line A (ring index) for all 32 columns into the buffer at HL
ZFillKinds:
    push hl
    ld e,a
    ld d,0
    ld b,32
zf_zero:
    ld (hl),0
    inc hl
    djnz zf_zero
    pop hl
    ; side passage
    push hl
    ld ix,AMY_UVAR_PA
    add ix,de
    ld a,(ix+0)
    or a
    jr z,zf_cave
    ld c,a
    ld ix,AMY_UVAR_PB
    add ix,de
    ld a,(ix+0)
    sub c
    jr c,zf_cave
    inc a
    ld b,a
    ld a,c
    add a,l
    ld l,a
    jr nc,zf_p1
    inc h
zf_p1:
    ld (hl),3
    inc hl
    djnz zf_p1
zf_cave:
    pop hl
    push hl
    ld ix,AMY_UVAR_LL
    add ix,de
    ld c,(ix+0)
    ld ix,AMY_UVAR_LR
    add ix,de
    ld a,(ix+0)
    sub c
    jr c,zf_trap
    inc a
    ld b,a
    ld a,c
    add a,l
    ld l,a
    jr nc,zf_c1
    inc h
zf_c1:
    ld (hl),1
    inc hl
    djnz zf_c1
zf_trap:
    pop hl
    ld ix,AMY_UVAR_TD
    add ix,de
    ld a,(ix+0)
    or a
    ret z
    add a,l
    ld l,a
    jr nc,zf_t1
    inc h
zf_t1:
    ld (hl),2
    ret

; Rows ZRow to ZRowEnd - 1 of the name table at ZBase, for the line
; position HBase (row R shows lines HBase + R - 1 and HBase + R)
ZRows:
    ld a,(AMY_UVAR_ZRow)
    ld b,a
    ld a,(AMY_UVAR_ZRowEnd)
    cp b
    ret z
    ret c
    ; the first row's upper line
    ld a,(AMY_UVAR_HBase)
    add a,b
    dec a
    and 31
    ld hl,AMY_UVAR_KBot
    call ZFillKinds
zr_row:
    ld a,(AMY_UVAR_ZRow)
    ld b,a
    ld a,(AMY_UVAR_ZRowEnd)
    cp b
    ret z
    ret c
    ; last row's lower line becomes this row's upper line (x 4 + 128)
    ld hl,AMY_UVAR_KBot
    ld de,AMY_UVAR_KTop
    ld c,32
zr_up:
    ld a,(hl)
    add a,a
    add a,a
    add a,128
    ld (de),a
    inc hl
    inc de
    dec c
    jr nz,zr_up
    ld a,(AMY_UVAR_HBase)
    add a,b
    and 31
    ld hl,AMY_UVAR_KBot
    call ZFillKinds
    ld a,(AMY_UVAR_ZRow)
    ld l,a
    ld h,0
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    add hl,hl
    ld de,(AMY_UVAR_ZBase)
    add hl,de
    ld a,l
    out ($BF),a
    ld a,h
    or $40
    out ($BF),a
    ld hl,AMY_UVAR_KTop
    ld de,AMY_UVAR_KBot
    ld b,32
zr_col:
    ld a,(de)
    add a,(hl)
    out ($BE),a
    inc hl
    inc de
    djnz zr_col
    ld hl,AMY_UVAR_ZRow
    inc (hl)
    jr zr_row

; Shows name table ZShow (0: $1800, 1: $1C00) and points the text
; routines at it
ZFlip:
    ld a,(AMY_UVAR_ZShow)
ZShadowA:
    ld hl,$1800
    ld b,6
    or a
    jr z,zf_set
    ld hl,$1C00
    ld b,7
zf_set:
    ld (VDP_NAME_SHADOW),hl
    ld a,(AMY_UVAR_ZOnlyShadow)
    or a
    ret nz
    ld a,b
    out ($BF),a
    ld a,$82
    out ($BF),a
    ret

; Points the text routines at table A (0 or 1) without showing it
ZShadow:
    push af
    ld a,1
    ld (AMY_UVAR_ZOnlyShadow),a
    pop af
    call ZShadowA
    xor a
    ld (AMY_UVAR_ZOnlyShadow),a
    ret

; The pair patterns and colors for scroll offset ZOff (Scr x 128, + 1024
; with trapdoors open) into tiles 128-143 of all three screen thirds.
; outi + nop keeps the 8 microsecond gap the VDP needs during display.
ZPairs:
    ld de,$0400
zp_third:
    ld hl,(AMY_UVAR_ZOff)
    ld bc,AMY_UDATA_PairPat
    add hl,bc
    call zp_copy
    ld hl,$2000
    add hl,de
    ex de,hl
    ld hl,(AMY_UVAR_ZOff)
    ld bc,AMY_UDATA_PairCol
    add hl,bc
zp_copy:
    ld a,e
    out ($BF),a
    ld a,d
    or $40
    out ($BF),a
    ld bc,$80BE
zp_loop:
    outi
    nop
    jr nz,zp_loop
    ret

; Mode 2 with all three screen thirds sharing one pattern table and one
; color table (R4 = 0, R3 = $9F), so the pair tiles are written once
ZShare:
    xor a
    out ($BF),a
    ld a,$84
    out ($BF),a
    ld a,$9F
    out ($BF),a
    ld a,$83
    out ($BF),a
    ret
CcShot:
    db $40,$2B,$10,$01,$40,$32,$10,$01,$40,$3D,$10,$01,$40,$4D,$10,$01,$40,$68,$10,$01,$40,$A0,$10,$01
    db $50
CcHit:
    db $00,$00,$04,$03,$00,$00,$15,$03,$00,$00,$36,$04,$00,$00,$66,$04,$00,$00,$A6,$04,$10
CcClank:
    db $80,$50,$10,$02,$80,$A0,$20,$02,$80,$66,$40,$03,$80,$66,$F0,$02,$90
