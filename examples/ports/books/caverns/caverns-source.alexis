    db $80,$AA,$30,$0B,$80,$AA,$F0,$01,$80,$E2,$30,$05,$80,$E2,$F0,$01,$80,$AA,$30,$05,$80,$AA,$F0,$01
    db $80,$8F,$30,$05,$80,$8F,$F0,$01,$80,$AA,$30,$05,$80,$AA,$F0,$01,$80,$8F,$30,$05,$80,$8F,$F0,$01
