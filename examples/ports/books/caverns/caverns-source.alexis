CcCrashN:
    db $00,$00,$04,$04,$00,$00,$05,$06,$00,$00,$26,$08,$00,$00,$56,$0A,$00,$00,$96,$0C,$10
CcCrashT:
    db $40,$7C,$10,$02,$40,$85,$10,$02,$40,$8F,$10,$02,$40,$9B,$10,$02,$40,$A9,$10,$02,$40,$BA,$10,$02
    db $40,$CF,$10,$02,$40,$E9,$10,$02,$40,$0A,$11,$02,$40,$37,$11,$02,$40,$75,$11,$02,$40,$D2,$11,$02
    db $40,$6D,$12,$02,$40,$A4,$13,$02,$50
CcFall:
    db $40,$33,$20,$02,$40,$35,$20,$02,$40,$37,$20,$02,$40,$39,$20,$02,$40,$3C,$20,$02,$40,$3E,$20,$02
    db $40,$41,$20,$02,$40,$44,$20,$02,$40,$48,$20,$02,$40,$4C,$20,$02,$40,$50,$20,$02,$40,$55,$20,$02
    db $40,$5A,$20,$02,$40,$60,$20,$02,$40,$68,$20,$02,$40,$70,$20,$02,$40,$7A,$20,$02,$40,$85,$20,$02
    db $40,$93,$20,$02,$40,$A5,$20,$02,$40,$BA,$20,$02,$40,$D7,$20,$02,$40,$FE,$20,$02,$40,$37,$21,$02
    db $40,$90,$21,$02,$40,$2F,$22,$02,$50
CcTrap:
    db $C0,$FC,$31,$02,$C0,$BB,$52,$02,$C0,$A4,$F3,$02,$D0
CcSafe:
    db $80,$6B,$30,$04,$80,$55,$30,$04,$80,$47,$30,$04,$80,$35,$30,$04,$80,$35,$F0,$02,$90
