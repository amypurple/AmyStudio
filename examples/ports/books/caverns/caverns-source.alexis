    db $C0,$3B,$60,$01,$C0,$31,$80,$01,$D0
CcOver:
    db $40,$53,$21,$0A,$40,$53,$F1,$02,$40,$68,$21,$0A,$40,$68,$F1,$02,$40,$7C,$21,$0A,$40,$7C,$F1,$02
    db $40,$94,$21,$0A,$40,$94,$F1,$02,$40,$AB,$21,$0A,$40,$AB,$F1,$02,$40,$C5,$21,$0A,$40,$C5,$F1,$02
    db $40,$FC,$21,$0A,$40,$FC,$F1,$02,$40,$A6,$22,$28,$40,$A6,$F2,$02,$50
CcWinA:
    db $40,$AA,$10,$05,$40,$AA,$F0,$01,$40,$8F,$10,$05,$40,$8F,$F0,$01,$40,$71,$10,$05,$40,$71,$F0,$01
    db $40,$55,$10,$0B,$40,$55,$F0,$01,$40,$71,$10,$05,$40,$71,$F0,$01,$40,$55,$10,$05,$40,$55,$F0,$01
    db $40,$47,$10,$05,$40,$47,$F0,$01,$40,$55,$10,$05,$40,$55,$F0,$01,$40,$47,$10,$05,$40,$47,$F0,$01
