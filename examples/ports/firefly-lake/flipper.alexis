  }
  mode 2 screen
  set sound table FlSoundTable areas MtAreas
  sprites 16x16
  nmi off
  TitleScreen
attractlp:
  LoadTable
  AttractLoop
  NewGame
  PlayGame
  goto attractlp

' ==================================================================== frame
sub Rearm:
  nmi off
  nmi on
  return
end sub

' one video frame: the NMI (sound, controllers) runs during the wait only
sub Frame1:
  Rearm
  wait
  nmi off
  inc Tick
  return
end sub

sub ReadPad:
  OldPad = Pad
  Pad = 0
  if joypad(1).left then Pad = Pad | 1
  if joypad(1).right then Pad = Pad | 2
  if joypad(1).up then Pad = Pad | 4
  if joypad(1).down then Pad = Pad | 8
  Btn = 0
  ' v1.2: bit 0 = left fire (button1) -> left flipper, bit 1 = right fire
  ' (button2) -> right flipper; Super Action 3 / 4 mirror 1 / 2. (v1 used
  ' .fire = button1 OR button2 and .action = any of four: every button moved
  ' both flippers.)
  if joypad(1).button1 then Btn = 1
  if joypad(1).button3 then Btn = 1
  if joypad(1).button2 then Btn = Btn | 2
  if joypad(1).button4 then Btn = Btn | 2
  return
end sub

sub Unpack:
  call asm lt_unpack
  return
end sub

' ==================================================================== title
sub TitleScreen:
  Phase = 2
  Rearm
  wait
  nmi off
  display off
  HideSprites
  for I = 0 to 2
    DecN = PkiTPat0 + I * 3
    DecTo = I * 2048 + 768
    Unpack
    DecN = PkiTCol0 + I * 3
    DecTo = I * 2048 + 8960
    Unpack
    DecN = PkiTName0 + I * 3
    DecTo = I * 256 + 6144
    Unpack
    DecN = PkiFont
    DecTo = I * 2048 + 256
    Unpack
    ' the text: white on the black sky (thirds 0-1), on the lake (third 2)
    if I < 2 then
      fill $F1 count 512 to vram.color + I * 2048 + 256
    else
      fill $F4 count 512 to vram.color + I * 2048 + 256
    end if
    fill 0 count 8 to vram.pattern + I * 2048
    fill $11 count 8 to vram.color + I * 2048
    if I = 2 then fill $44 count 8 to vram.color + I * 2048
  next
  call asm set_page with a = 6
  ' the font: code 35 is a full-height E acute, 59 an O circumflex
  print centered at 9, "A PINBALL FOR COLECOVISION"
  print centered at 17, "LEFT BUTTON: LEFT FLIPPER"
  print centered at 18, "RIGHT BUTTON: RIGHT FLIPPER"
  print centered at 19, "STICK DOWN: PLUNGER"
  print centered at 20, "LEFT, RIGHT, UP: NUDGE"
  print centered at 22, "AMY & CLAUDE 2026"
  Tune(0)
  Rearm
  wait
  nmi off
  screen on
  nmi off
  K = 0
  do
    Frame1
    ReadPad
    inc K
    ' the fireflies over the lake
    if (Tick & 7) = 0 then
      I = random(4)
      SX = random(16, 232)
      SY = random(96, 124)
      set sprite I to SY,SX,SP_FLY,11
      update sprites
    end if
    if (Tick & 7) = 4 then
      I = random(4)
      set sprite I to 209,0,SP_FLY,11
      update sprites
    end if
    if (Tick & 31) = 0 then
      if (Tick & 32) = 0 then
        print centered at 16, "PRESS A BUTTON"
      else
        print centered at 16, "              "
      end if
    end if
    if Btn <> 0 then
      if K > 30 then exit do
    end if
  loop
  StopSong
  return
end sub


sub HideSprites:
  clear sprites
  set sprite count 4
  for J = 0 to 3
    set sprite J to 209,0,0,0
  next
  update sprites
  return
end sub

' ==================================================================== music
sub Tune(u8 Sg):
  StopSong
  K = Sg << 2
  inc K
  play sound K
  inc K
  play sound K
  inc K
  play sound K
  inc K
  play sound K
  return
end sub

sub StopSong:
  for J = 1 to 8
    stop sound J
  next
  return
end sub

sub Sfx(u8 Sn):
  play sound Sn
  return
end sub

' ==================================================================== the table
sub LoadTable:
  Rearm
  wait
  nmi off
  display off
  HideSprites
  for I = 0 to 2
    DecN = PkiPat0 + I * 2
    DecTo = I * 2048
    Unpack
    DecN = PkiCol0 + I * 2
    DecTo = I * 2048 + 8192
    Unpack
  next
  DecN = PkiName0
  DecTo = 6144
  Unpack
  DecN = PkiName1
  DecTo = 7168
  Unpack
  copy SprPat count SPRBYTES to vram $3800
  Page = 1
  call asm set_page with a = 7
  for I = 0 to NL - 1
    LampSt[I] = 0
    LampShown[I] = 255
  next
  FlVis[0] = 255
  FlVis[1] = 255
  set sprite count 4
  set sprite 0 to 209,0,SP_SHINE,15
  set sprite 1 to 209,0,SP_BALL,14
  set sprite 2 to 209,0,SP_KNOB,10
  set sprite 3 to 209,0,SP_FLY,11
  update sprites
  Rearm
  wait
  nmi off
  screen on
  nmi off
  return
end sub

' ==================================================================== attract
' the lamp show, four acts of 5 s: a chase up the table (three lamps lit),
' bands sweeping up, the two halves blinking in turn, the table filling up.
' Every lamp changes at most every 10 frames: 3 Hz at most.
sub AttractLoop:
  Phase = 3
  Attract = 1
  Tune(0)
  Msg(@MPRESS)
  ShowScore
  K = 0
  K2 = 0
  AttrT = 0
  AttrM = 0
  AttrC = 0
  Chase = 0
  Band = 0
  do
    Frame1
    ReadPad
    Flippers
    inc AttrT
    if AttrT >= 300 then
      AttrT = 0
      AttrM = (AttrM + 1) & 3
      AttrC = 0
      Chase = 0
      Band = 0
      for I = 0 to NL - 1
        LampSt[I] = 0
      next
    end if
    inc AttrC
    ' the first and last 10 frames of an act: no change (every lamp keeps
    ' each state 10 frames at least across the change of act)
    K = AttrM
    if AttrT < 10 then K = 9
    if AttrT >= 290 then K = 9
    select case K
    case 0
      ' the chase: a lamp every 4 frames, three lit (12 frames each)
      if AttrC >= 4 then
        AttrC = 0
        I = LampOrd[Chase]
        LampSt[I] = 0
        K = Chase + 3
        if K >= NL then K = K - NL
        I = LampOrd[K]
        LampSt[I] = 1
        inc Chase
        if Chase >= NL then Chase = 0
      end if
    case 1
      ' bands from the flippers to the top, 10 frames each
      if AttrC >= 10 then
        AttrC = 0
        for I = 0 to NL - 1
          K = 0
          if LampBand[I] = Band then K = 1
          LampSt[I] = K
        next
        inc Band
        if Band >= NBANDS then Band = 0
      end if
    case 2
      ' the two halves of the lamps in turn, 10 frames each (3 Hz)
      if AttrC >= 10 then
        AttrC = 0
        Band = Band ^ 1
        for I = 0 to NL - 1
          K = (I & 1) ^ Band
          LampSt[I] = K
        next
      end if
    case 3
      ' the table fills up from the bottom, a lamp every 5 frames
      if AttrC >= 5 then
        AttrC = 0
        if Chase < NL then
          I = LampOrd[Chase]
          LampSt[I] = 1
          inc Chase
        end if
      end if
    end select
    ' no physics here: every change in the same frame (no lamp is late)
    LampBud = 255
    Lamps
    ' the page shows the table top for 4 s, then the bottom
    inc K2
    if K2 = 240 then
      K2 = 0
      Page = 1 - Page
      call asm set_page with a = Page + 6
    end if
    if Btn = 0 then Q = 1
    if Btn <> 0 then
      if Q = 1 then exit do
    end if
  loop
  StopSong
  Attract = 0
  for I = 0 to NL - 1
    LampSt[I] = 0
  next
  LampBud = 255
  Lamps
  return
end sub

' ==================================================================== a game
sub NewGame:
  ScB[0] = 0
  ScB[1] = 0
  ScB[2] = 0
  Balls = 3
  Mult = 1
  Letters = 0
  Swarms = 0
  SwarmT = 0
  ExtraLit = 0
  OutSave = 0
  ShowScore
  HudBalls
  HudMult
  HudLetters
  Msg(@MBLANK)
  Tune(1)
  return
end sub

sub PlayGame:
  do
    NewBall
    do
      BallLoop
      ' a drain during the ball save or through a lit outlane: the ball comes back
      Saved = 0
      if Tilted = 0 then
        if SaveT > 0 then Saved = 1
        if SaveFlag = 1 then Saved = 1
      end if
      if Saved = 0 then exit do
      Reserve
    loop
    EndOfBall
    if Balls = 0 then exit do
  loop
  GameOver
  return
end sub

sub NewBall:
  Phase = 6
  Lanes = 0
  Banks = 0
  BonusN = 0
  TiltM = 0
  Tilted = 0
  Warned = 0
  Drops = 0
  DropT = 0
  OrbL = 0
  OrbR = 0
  SpinLit = 0
  Stand = 0
  ComboT = 0
  SaveT = 0
  SaveFlag = 0
  SaveOk = 1
  if Mult > 1 then Mult = 1
  SkLane = random(5)
  SkillT = 255
  for I = 0 to NL - 1
    LampSt[I] = 0
  next
  SetLamps
  HudMult
  HudBalls
  HudTilt
  call asm ph_serve
  StuckT = 0
  StuckN = 0
  PlayT = 0
  Msg(@MBALL)
  MsgTxt[0] = 48 + 4 - Balls
  if Balls > 3 then MsgTxt[0] = 49
  MsgRow = 21
  call asm msg_draw
  MsgT = 120
  return
end sub

' the same ball again (ball save): nothing of the ball's progress is lost
sub Reserve:
  Phase = 6
  Sfx(SndExtra)
  SaveT = 0
  SaveFlag = 0
  SkillT = 0
  LampsDirty = 1
  call asm ph_serve
  StuckT = 0
  StuckN = 0
  Msg(@MSAVED)
  MsgT = 120
  return
end sub

' the play loop: one pass a frame
sub BallLoop:
  do
    Frame1
    Phase = 1
    ' the page and the sprites first, in the vertical blank
    PageAndSprites
    ReadPad
    if Lab = 0 then Controls
    call asm ph_frame
    call asm ph_cool
    ' a heavy physics frame: the events and drawing wait for the next one
    if PhLoad < 20 then Events
    ' at most one of the VRAM-heavy jobs a frame: the flippers first
    Flippers
    SpinAnim
    Timers
    if FlDrew = 0 then
      if ScDirty = 1 then
        ShowScore
      elseif HudD <> 0 then
        HudJob
      elseif LampsDirty > Lab then
        ' (Lab, the test aid, writes the lamps itself)
        if PhLoad < 12 then SetLamps
      elseif PhLoad < 12 then
        ' (a heavy physics frame: the lamps wait a frame; seed 9 lost one
        ' frame at PhLoad 19 when they did not)
        LampBud = 24
        Lamps
      end if
    end if
    Guard
    inc PlayT
    if BMode = 3 then
      if Lab = 0 then exit do
    end if
  loop
  return
end sub

sub PageAndSprites:
  ' hysteresis: page 1 below y 186, page 0 above y 180 (both seen there)
  W16 = Y8 >> 3
  if Page = 0 then
    if W16 > 186 then
      Page = 1
      call asm set_page with a = 7
    end if
  else
    if W16 < 180 then
      Page = 0
      call asm set_page with a = 6
    end if
  end if
  ' the ball: 10 px, its centre at (4.5, 4.5) of the sprite; the VDP draws a
  ' sprite from line Y + 1. Pixel positions are rounded (X8, Y8: 1/8 px).
  W16 = Y8 + 4
  W16 = W16 >> 3
  if Page = 1 then W16 = W16 - PG1Y
  if BMode = 2 then
    K = Pull * 3
    K = K >> 2
    W16 = W16 + K
  end if
  SY = W16 - 5
  W16 = X8 + 4
  W16 = W16 >> 3
  SX = W16 + 11
  set sprite 0 to SY,SX,SP_SHINE,15
  set sprite 1 to SY,SX,SP_BALL,14
  ' the plunger knob under the ball
  if Page = 1 then
    W16 = Pull * 3
    W16 = W16 >> 2
    ' the knob's head on the plunger tip (table y 357, page row 181), under the ball
    K = 180 + W16
    set sprite 2 to K,176,SP_KNOB,10
  else
    set sprite 2 to 209,0,SP_KNOB,10
  end if
  update sprites
  return
end sub

' the controls: flippers, plunger, nudges
sub Controls:
  FlBtn = 0
  if Tilted = 0 then
    if (Btn & 1) <> 0 then FlBtn = 1
    if (Btn & 2) <> 0 then FlBtn = FlBtn | 2
  end if
  ' the coils' clack when a flipper starts up
  K = FlBtn & (FlBtn ^ HitsL)
  if K <> 0 then
    Sfx(SndClack)
    if BMode = 2 then
      ' on the plunger: the flippers move the skill-shot arrow
      if (K & 1) <> 0 then
        if SkLane > 0 then dec SkLane
      end if
      if (K & 2) <> 0 then
        if SkLane < 4 then inc SkLane
      end if
    else
      ' lane change: the lit top lanes turn with the flippers
      if (K & 1) <> 0 then Lanes = (Lanes >> 1) | ((Lanes & 1) << 4)
      if (K & 2) <> 0 then Lanes = ((Lanes << 1) | (Lanes >> 4)) & 31
    end if
    LampsDirty = 1
  end if
  HitsL = FlBtn
  if BMode = 2 then
    if (Pad & 8) <> 0 then
      if (Tick & 3) = 0 then
        if Pull < 16 then inc Pull
      end if
    else
      if Pull > 0 then
        Launch = 1
        Sfx(SndLaunch)
      end if
    end if
  end if
  ' a nudge: a new push of the stick left, right or up
  if NudgeT > 0 then dec NudgeT
  K = Pad & (Pad ^ OldPad) & 7
  if K <> 0 then
    if NudgeT = 0 then
      if BMode = 0 then
        NudgeD = 1
        if (K & 2) <> 0 then NudgeD = 2
        if (K & 4) <> 0 then NudgeD = 3
        call asm nudge
        NudgeT = 6
        TiltM = TiltM + 34
        if TiltM > 100 then
          TiltNow
        elseif TiltM > 60 then
          if Warned = 0 then
            Sfx(SndWarn)
            Msg(@MDANGER)
            MsgT = 60
          end if
          Warned = 1
        end if
        HudTilt
      end if
    end if
  end if
  return
end sub

sub TiltNow:
  if Tilted = 1 then return
  Tilted = 1
  Sfx(SndBuzz)
  Msg(@MTILT)
  MsgT = 255
  LampsDirty = 1
  return
end sub

' ==================================================================== events
' at most two events a frame (one when the physics was busy): the rest wait
sub Events:
  EvN = 2
  if PhLoad >= 12 then EvN = 1
  do
    if EvN = 0 then exit do
    dec EvN
    call asm ev_pop
    if EvC = 255 then exit do
    if Lab = 0 then
      K = EvC >> 3
      Q = EvC & 7
      Seen[K] = Seen[K] | BitTab[Q]
      if Tilted = 0 then OneEvent
    end if
  loop
  return
end sub

' points twice during the inlane combo
sub ComboPts:
  AddPts
  if ComboT > 0 then
    AddPts
    Msg(@MCOMBO)
    MsgT = 60
  end if
  return
end sub

sub OneEvent:
  LampsDirty = 1
  if EvC >= 128 then
    ' a coil fired: pop bumper or slingshot
    K = EvC - 128
    if K >= EL_BUMPER0 then
      if K <= EL_BUMPER2 then
        I = K - EL_BUMPER0
        ' the cap flashes 10 frames, then stays dark 10 frames at least (3 Hz)
        if Flash[I] = 0 then
          Flash[I] = 20
          LampSt[LP_BUMPER0 + I] = 1
        end if
        Sfx(SndBump)
        Sfx(SndBumpT)
        Pts = $0010
        if SwarmT > 0 then Pts = $0100
        AddPts
        return
      end if
    end if
    Sfx(SndSling)
    Pts = $0001
    AddPts
    return
  end if
  if EvC >= 96 then
    select case EvC
    case EV_RAMPOK
      Sfx(SndRamp)
      inc BonusN
      if SwarmT > 0 then
        ' the jackpot
        Pts = $2500
        AddPts
        Msg(@MJACK)
        MsgT = 90
      else
        Pts = $0200
        ComboPts
      end if
      if ExtraLit = 1 then
        ExtraLit = 0
        inc Balls
        Sfx(SndExtra)
        Msg(@MEXTRA)
        MsgT = 120
        HudD = HudD | 4
      else
        Award
      end if
    case EV_LAUNCH
      ' the ball save starts with the first launch of the ball (10 s)
      if SaveOk = 1 then
        SaveOk = 0
        SaveT = 75
      end if
      if SkillT = 255 then SkillT = 60
    case EV_RESCUE
      inc Rescues
    end select
    return
  end if
  if EvC >= 64 then
    K = EvC - 64
    select case K
    case SN_LANE0 to SN_LANE4
      I = K - SN_LANE0
      Pts = $0050
      AddPts
      Sfx(SndRoll)
      if SkillT > 0 then
        if I = SkLane then
          Pts = $0500
          AddPts
          Msg(@MSKILL)
          MsgT = 90
          Award
        end if
        SkillT = 0
      end if
      Lanes = Lanes | BitTab[I]
      if Lanes = 31 then
        Lanes = 0
        if Mult < 5 then inc Mult
        HudD = HudD | 2
        Sfx(SndLetter)
        Award
      end if
      Bonus1
    case SN_SPINNER
      SpinA = SpinA + (SpinV >> 1) + 2
      ' going up: a left orbit shot
      if VY[2] >= 128 then
        Pts = $0100
        ComboPts
        inc OrbL
        if OrbL >= 3 then
          OrbL = 0
          Pts = $1000
          AddPts
          Award
        end if
        Bonus1
      end if
    case SN_ORBITR
      if VY[2] >= 128 then
        Pts = $0100
        ComboPts
        inc OrbR
        if OrbR >= 3 then
          OrbR = 0
          Pts = $1000
          AddPts
          SpinLit = 160
          Msg(@MSPIN)
          MsgT = 90
        end if
        Bonus1
      end if
    case SN_INL, SN_INR
      Pts = $0050
      AddPts
      Sfx(SndRoll)
      ComboT = 30
      Bonus1
    case SN_OUTL, SN_OUTR
      Pts = $0200
      AddPts
      Sfx(SndRoll)
      if OutSave = 1 then
        OutSave = 0
        SaveFlag = 1
      end if
    case SN_RAMP
      Pts = $0010
      AddPts
    end select
    return
  end if
  ' an element hit hard enough
  select case EvC
  case EL_DROP0 to EL_DROP3
    Sfx(SndTarget)
    Pts = $0025
    AddPts
    Bonus1
    if Drops = 15 then
      if DropT = 0 then
        DropT = 60
        Pts = $0500
        AddPts
        inc Banks
        if Banks = 2 then ExtraLit = 1
        Award
      end if
    end if
  case EL_STANDS
    ' which standup: the ball's height
    I = 0
    if Y8 >= 1160 then I = 1
    if Y8 >= 1272 then I = 2
    Sfx(SndTarget)
    Pts = $0050
    AddPts
    Stand = Stand | BitTab[I]
    if Stand = 7 then
      Stand = 0
      Pts = $0500
      AddPts
      OutSave = 1
      Msg(@MSAVE)
      MsgT = 90
      Sfx(SndLetter)
    end if
  case EL_POSTDR, EL_POSTSL, EL_POSTSR
    Sfx(SndPost)
    Pts = $0001
    AddPts
  case EL_RAMPWALL, EL_RAMPLIP, EL_ORBIT, EL_ORBITR
    Sfx(SndPost)
  end select
  return
end sub

sub Bonus1:
  if BonusN < 99 then inc BonusN
  return
end sub

' the next letter of FIREFLY; all seven: the swarm
sub Award:
  if Letters < 7 then
    inc Letters
    Sfx(SndLetter)
    HudD = HudD | 1
    if Letters = 7 then
      SwarmT = 150
      inc Swarms
      Msg(@MSWARM)
      MsgT = 255
      Sfx(SndExtra)
    end if
  end if
  return
end sub

' every rule lamp from the game's state (the bumpers flash apart)
sub SetLamps:
  LampsDirty = 0
  if Tilted = 1 then
    for I = 0 to NL - 1
      LampSt[I] = 0
    next
    return
  end if
  for I = 0 to 4
    K = 0
    if SkillT > 0 then
      if I = SkLane then K = 2
    end if
    LampSt[LP_SK0 + I] = K
    K = 0
    if (Lanes & BitTab[I]) <> 0 then K = 1
    LampSt[LP_LANE0 + I] = K
  next
  for I = 0 to 2
    ' the orbits: lit up to the count, the next arrow blinks
    K = 0
    if I < OrbL then K = 1
    if I = OrbL then K = 2
    LampSt[LP_OL0 + I] = K
    K = 0
    if I < OrbR then K = 1
    if I = OrbR then K = 2
    LampSt[LP_OR0 + I] = K
    K = 0
    if (Stand & BitTab[I]) <> 0 then K = 1
    LampSt[LP_ST0 + I] = K
  next
  K = 0
  if SpinLit > 0 then K = 1
  LampSt[LP_SPIN] = K
  K = 0
  if ExtraLit = 1 then K = 2
  LampSt[LP_RAMPX] = K
  LampSt[LP_EXTRA] = K
  K = 0
  if SwarmT > 0 then K = 2
  LampSt[LP_RAMPJ] = K
  LampSt[LP_SWARM] = K
  for I = 0 to 3
    K = 0
    if (Drops & BitTab[I]) <> 0 then K = 1
    LampSt[LP_DROP0 + I] = K
    K = 0
    if I + 2 <= Mult then K = 1
    LampSt[LP_X2 + I] = K
  next
  for I = 0 to 6
    K = 0
    if I < Letters then K = 1
    if I = Letters then K = 2
    LampSt[LP_F1 + I] = K
  next
  ' the bonus ring: a lamp a firefly caught, the last one blinks past 8
  for I = 0 to 7
    K = 0
    if I < BonusN then K = 1
    LampSt[LP_B1 + I] = K
  next
  if BonusN > 8 then LampSt[LP_B8] = 2
  K = 0
  if ComboT > 0 then K = 2
  LampSt[LP_INL] = K
  LampSt[LP_INR] = K
  K = 0
  if OutSave = 1 then K = 1
  LampSt[LP_OUTL] = K
  LampSt[LP_OUTR] = K
  K = 0
  if SaveFlag = 1 then K = 1
  if SaveT > 0 then
    K = 1
    if SaveT < 16 then K = 2
  end if
  LampSt[LP_AGAIN] = K
  return
end sub

' Pts: the points / 10 in BCD ($0010 = 100 points)
sub AddPts:
  call asm sc_add
  ScDirty = 1
  return
end sub

' ==================================================================== animations
sub Flippers:
  FlDrew = 0
  ' a heavy physics frame (many contacts): the drawing waits a frame
  if PhLoad >= 20 then
    FlDrew = 1
    return
  end if
  for J = 0 to 1
    ' 5 drawn positions for the 25 angle steps
    K = FlA[J]
    K = FlPosTab[K]
    if K <> FlVis[J] then
      FlipO = FlVis[J]
      FlVis[J] = K
      FlipS = J
      FlipP = K
      call asm flip_draw
      FlDrew = 1
      if PhLoad >= 12 then return
    end if
  next
  return
end sub

sub SpinAnim:
  if SpinA = 0 then return
  ' the plate turns: one frame every 2 game frames while fast, slower after
  inc SpinLast
  K = 1
  if SpinA < 40 then K = 2
  if SpinA < 16 then K = 4
  if SpinLast >= K then
    SpinLast = 0
    SpinF = (SpinF + 1) & 3
    call asm spin_draw
    if SpinF = 0 then
      Sfx(SndTick)
      Pts = $0010
      if SpinLit > 0 then Pts = $0100
      AddPts
      inc SpinN
      if SpinN >= 20 then
        SpinN = 0
        Award
      end if
    end if
    dec SpinA
  end if
  return
end sub

sub Timers:
  ' the bumper caps flash
  for I = 0 to 2
    if Flash[I] > 0 then
      dec Flash[I]
      if Flash[I] = 10 then LampSt[LP_BUMPER0 + I] = 0
    end if
  next
  ' the drop bank comes back up
  if DropT > 0 then
    dec DropT
    ' v2: never up under the ball (a ball over a dropped target was shut
    ' inside it when the bank came back up: bot seed 2)
    if DropT = 0 then
      if Y8 >= 1480 then
        if Y8 < 1840 then
          if X8 < 840 then DropT = 1
        end if
      end if
    end if
    if DropT = 0 then
      Drops = 0
      LampsDirty = 1
      Sfx(SndTarget)
    end if
  end if
  ' the tilt meter cools down
  if (Tick & 3) = 0 then
    if TiltM > 0 then
      dec TiltM
      if TiltM = 0 then Warned = 0
      if (TiltM & 7) = 0 then HudTilt
    end if
  end if
  if (Tick & 7) = 0 then
    ' the timed rules, in frames / 8
    if BMode = 0 then
      if SkillT > 0 then
        if SkillT < 255 then
          dec SkillT
          if SkillT = 0 then LampsDirty = 1
        end if
      end if
      if SaveT > 0 then
        dec SaveT
        if SaveT = 0 then LampsDirty = 1
        if SaveT = 15 then LampsDirty = 1
      end if
    end if
    if SpinLit > 0 then
      dec SpinLit
      if SpinLit = 0 then LampsDirty = 1
    end if
    if ComboT > 0 then
      dec ComboT
      if ComboT = 0 then LampsDirty = 1
    end if
    ' the swarm
    if SwarmT > 0 then
      dec SwarmT
      if SwarmT = 0 then
        Letters = 0
        LampsDirty = 1
        HudD = HudD | 1
        Msg(@MBLANK)
      end if
    end if
  end if
  if MsgT > 0 then
    dec MsgT
    if MsgT = 0 then Msg(@MBLANK)
  end if
  return
end sub

' the lamps whose state changed (at most LampBud tiles a frame); blinking
' ones at 3 Hz (10 frames on, 10 off)
sub Lamps:
  inc BlinkC
  if BlinkC >= 20 then BlinkC = 0
  LampV = 0
  if BlinkC < 10 then LampV = 1
  call asm lamps_upd
  return
end sub

' ==================================================================== the guard
' a ball that does not move for 3 s (and is not held on a raised flipper,
' nor waiting on the plunger) gets a little kick
sub Guard:
  inc StuckT
  if StuckT < 60 then return
  StuckT = 0
  if BMode <> 0 then
    StuckN = 0
    return
  end if
  W16 = X8 - LastX8
  if signed W16 < 0 then W16 = 0 - W16
  Pts = Y8 - LastY8
  if signed Pts < 0 then Pts = $0000 - Pts
  W16 = W16 + Pts
  LastX8 = X8
  LastY8 = Y8
  if W16 > 24 then
    StuckN = 0
    return
  end if
  ' held on a flipper: the player's choice
  if FlBtn <> 0 then
    if Y8 > 2400 then return
  end if
  inc StuckN
  if StuckN >= 2 then
    StuckN = 0
    inc Unsticks
    call asm unstick
  end if
  return
end sub

' ==================================================================== the HUD
' one deferred HUD update a frame
sub HudJob:
  if (HudD & 1) <> 0 then
    HudD = HudD & 254
    HudLetters
  elseif (HudD & 2) <> 0 then
    HudD = HudD & 253
    HudMult
  else
    HudD = 0
    HudBalls
  end if
  return
end sub

sub ShowScore:
  ScDirty = 0
  call asm sc_fmt
  call asm score_draw
  return
end sub

sub HudBalls:
  for I = 0 to 2
    K = H0_BALL_OFF
    if I < Balls then K = H0_BALL_ON
    W16 = 5 * 32 + 24 + I * 2
    call asm vpoke2 with de = W16, a = K
  next
  ' more than 3: a fourth icon
  K = 0
  if Balls > 3 then K = H0_BALL_ON
  call asm vpoke2 with de = 5 * 32 + 29, a = K
  return
end sub

sub HudMult:
  for I = 0 to 3
    K = MultOff[I]
    if I + 2 <= Mult then K = MultOn[I]
    J = I & 1
    W16 = 8 * 32 + 25 + J * 3
    if I >= 2 then W16 = W16 + 32
    Q = H1_X_OFF
    if I + 2 <= Mult then Q = H1_X_ON
    call asm vpoke2 with de = W16 - 1, a = Q
    call asm vpoke2 with de = W16, a = K
  next
  return
end sub

sub HudLetters:
  for I = 0 to 6
    K = MLetOff[I]
    if I < Letters then K = MLetOn[I]
    if SwarmT > 0 then K = MLetOn[I]
    W16 = 11 * 32 + 25 + I
    if I >= 4 then W16 = 12 * 32 + 22 + I
    call asm vpoke2 with de = W16, a = K
  next
  return
end sub

' the tilt meter: 6 cells, green, yellow, red
sub HudTilt:
  for I = 0 to 5
    K = H1_BAR_OFF
    J = I * 17
    if TiltM > J then
      K = H1_BAR_G
      if I >= 3 then K = H1_BAR_Y
      if I >= 5 then K = H1_BAR_R
    end if
    W16 = 14 * 32 + 24 + I
    call asm vpoke2 with de = W16, a = K
  next
  return
end sub

' two message lines (rows 19 and 21), 6 characters each, from a 12-byte text
sub Msg(u16 Adr):
  MsgAdr = Adr
  call asm msg_set
  return
end sub

' ==================================================================== the end of a ball
sub EndOfBall:
  Phase = 4
  Sfx(SndDrain)
  set sprite 0 to 209,0,SP_SHINE,15
  set sprite 1 to 209,0,SP_BALL,14
  update sprites
  FlBtn = 0
  if Tilted = 0 then
    ' the bonus: 1000 a firefly caught, times the multiplier
    Msg(@MBONUS)
    if BonusN > 0 then
    for B1 = 1 to BonusN
      for B2 = 1 to Mult
        Pts = $0100
        AddPts
      next
      ShowScore
      Sfx(SndTick)
      for B3 = 1 to 6
        Frame1
        Flippers
      next
    next
    end if
  end if
  for B3 = 1 to 60
    Frame1
    Flippers
  next
  dec Balls
  SwarmT = 0
  if Letters = 7 then Letters = 0
  HudBalls
  HudLetters
  return
end sub

sub GameOver:
  Phase = 5
  Msg(@MGAMEOVER)
  Tune(1)
  for B3 = 1 to 240
    Frame1
    Flippers
    ReadPad
    if B3 > 60 then
      if Btn <> 0 then exit for
    end if
  next
  StopSong
  return
end sub
