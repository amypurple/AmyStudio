data SRound chars "ROUND {0}"
data SBackIn chars "BACK TO THE ROOM IN {0}"
data SNextIn chars "NEXT ROUND IN {0}"
data SRd chars "RD{0}"
data SWheel chars "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789>"
' the server without the lobby's key (build.sh's DEFSPEC, DEFURL)
data SDefSpec chars "N:TCP://FUJINET.ONLINE:9910/{0}"
data SDefUrl chars "tcp://fujinet.online:9910/?table={0}"
data SPort chars ":9910{0}"
data STestName chars "ANN{0}"
data STestTable chars "blast1{0}"
data SCanNames chars "ANN{0}{0}{0}{0}{0}BOB{0}{0}{0}{0}{0}CAT{0}{0}{0}{0}{0}DOT{0}{0}{0}{0}{0}"
data SCorner bytes 0,0,192,160,192,0,0,160
' ================================================================ the start
' main.c: the lobby's appkeys say who we are and where to play; else we ask,
' and list the rooms. At a table, the server's state says which screen to
' show: the waiting room, the arena (countdown and play), the trophies.
  asm {
        jp      asm_end                 ; (the block is data and routines: Start jumps over it)
; =============================================================================
; lib.asm - FUJIBLAST for the ColecoVision (Amy & Claude 2026): the screen's
; small helpers and the mailbox glue. Pasted into the Amy program's asm block
; (build.py), so Amy names (GlyphOf, SprY, NSeq...) are rewritten to their
; generated symbols.
;
; VDP: every VRAM data access is at least 31 T after the one before, so the
; TMS9918A never drops a byte with the display on (house rule: 29 T). The NMI
; is only enabled during Amy's `wait` (Tick), so nothing here is interrupted
; between the two address bytes.
;
; Mailbox: the primitives are Amy Studio's include/fujinet_mailbox.inc (the
; same protocol as the asm port's fujilib.inc / mail.inc); this adds the
; poll that keeps its answer for Amy. The NMI never reads $F800 and up.
; =============================================================================

; lib_vaw: HL = VRAM address, set for writing. Clobbers A.
lib_vaw:
        ld      a, l
        out     ($bf), a
        ld      a, h
        or      $40
        out     ($bf), a
        ret

; lib_nadr: HL = name table address of row D, column E. Clobbers A.
lib_nadr:
        ld      l, d
        ld      h, 0
        add     hl, hl
        add     hl, hl
        add     hl, hl
        add     hl, hl
        add     hl, hl
        ld      a, l
        add     a, e
        ld      l, a
        ld      a, h
        adc     a, $18
        ld      h, a
        ret

; lib_glyph: A = an ASCII code -> A = its cell code in style C (0: blank).
; Clobbers DE, HL... no: preserves HL by the caller. Clobbers DE.
lib_glyph:
        cp      97                      ; a..z shown as A..Z (the table ids)
        jr      c, lg_up
        cp      123
        jr      nc, lg_up
        sub     32
lg_up:  sub     32
        cp      64
        jr      c, lg_in
        xor     a
lg_in:  push    hl
        ld      e, a
        ld      d, 0
        ld      hl, GlyphOf
        add     hl, de
        ld      a, (hl)
        pop     hl
        or      a
        ret     z
        add     a, c
        ret

; lib_text: the zero-ended string HL at row D, column E, in style C (the
; style's first code; a space is code 0). Clobbers all but C.
lib_text:
        push    hl
        call    lib_nadr
        call    lib_vaw
        pop     hl
lt_l:   ld      a, (hl)
        or      a
        ret     z
        inc     hl
        call    lib_glyph
        out     ($be), a
        jr      lt_l

; lib_textn: B bytes from HL (a 0 shows as a space) at row D, column E,
; style C. Clobbers all but C.
lib_textn:
        push    hl
        call    lib_nadr
        call    lib_vaw
        pop     hl
ltn_l:  ld      a, (hl)
        inc     hl
        or      a
        jr      z, ltn_z
        call    lib_glyph
ltn_z:  out     ($be), a
        djnz    ltn_l
        ret

; lib_centre: the zero-ended string HL centred on row D (32 columns),
; style C. Clobbers all but C.
lib_centre:
        push    hl
        ld      b, 0
lc_l:   ld      a, (hl)
        or      a
        jr      z, lc_e
        inc     hl
        inc     b
        jr      lc_l
lc_e:   ld      a, 32
        sub     b
        srl     a
        ld      e, a
        pop     hl
        jp      lib_text

; lib_put: code A at row D, column E. Clobbers A, HL.
lib_put:
        push    af
        call    lib_nadr
        call    lib_vaw
        pop     af
        out     ($be), a
        ret

; lib_fillrow: row D: 32 cells of code A. Clobbers A, B, E, HL.
lib_fillrow:
        push    af
        ld      e, 0
        call    lib_nadr
        call    lib_vaw
        pop     af
        ld      b, 32
lfr_l:  out     ($be), a                ; 11
        nop                             ; 4
        nop                             ; 4
        nop                             ; 4
        djnz    lfr_l                   ; 13 -> 36 T a byte
        ret

; lib_cell2: a 2 x 2 tile, kind A (cell codes TileBase + 4 A ..), its top
; left cell at row D, column E. Clobbers A, B, HL.
lib_cell2:
        add     a, a
        add     a, a
        ld      b, a
        ld      a, (TileBase)
        add     a, b
        ld      b, a
        call    lib_nadr
        call    lib_vaw
        ld      a, b
        out     ($be), a
        inc     a                       ; 4
        nop                             ; 4
        nop
        nop
        nop                             ; 16 + 11 (out) ... 31 T
        out     ($be), a
        ld      a, l                    ; the next row
        add     a, 32
        ld      l, a
        jr      nc, lc2_n
        inc     h
lc2_n:  call    lib_vaw
        ld      a, b
        add     a, 2
        out     ($be), a
        inc     a
        nop
        nop
        nop
        nop
        out     ($be), a
        ret

; lib_tile: arena tile row D (0-10), column E (0-12), kind A. The arena's
; top left cell is row 1, column 3. Clobbers A, B, D, E, HL.
lib_tile:
        ld      b, a
        ld      a, d
        add     a, a
        inc     a
        ld      d, a
        ld      a, e
        add     a, a
        add     a, 3
        ld      e, a
        ld      a, b
        jp      lib_cell2

; lib_half: a tile drawn at half-tile cell hy = D (0-21), hx = E (0-25),
; kind A: a bomb in the air. Clobbers A, B, D, E, HL.
lib_half:
        inc     d
        inc     e
        inc     e
        inc     e
        jp      lib_cell2

; lib_sprflush: the four bombers' sprite attributes (SprY, SprX, SprP, SprC)
; and the list's end, straight to the SAT at $1B00. Clobbers A, B, DE, HL.
lib_sprflush:
        ld      hl, $1B00
        call    lib_vaw
        ld      de, 0
        ld      b, 4
lsf_l:  ld      hl, SprY
        add     hl, de
        ld      a, (hl)
        out     ($be), a
        ld      hl, SprX
        add     hl, de
        ld      a, (hl)
        out     ($be), a
        ld      hl, SprP
        add     hl, de
        ld      a, (hl)
        out     ($be), a
        ld      hl, SprC
        add     hl, de
        ld      a, (hl)
        out     ($be), a
        inc     e
        djnz    lsf_l
        ld      a, $D0
        nop
        nop
        nop
        nop
        out     ($be), a
        ret

; ---- the mailbox ---------------------------------------------------------------
; mb_post: the transaction goes: NSeq = ACKSEQ + 1 (255 wraps to 1), the
; SEQ register written (Amy Studio's FN_COMMIT_BEGIN).
mb_post:
        ld      hl, NSeq
        jp      FN_COMMIT_BEGIN

; mb_poll: MbRes = 0 still out, 1 answered and ACKed, $80+ an error or a NAK
; (FN_POLL).
mb_poll:
        ld      hl, NSeq
        call    FN_POLL
        ld      (MbRes), a
        ret

; mb_check: MbRes = 1 when a FujiNet cartridge's mailbox is there ('F','N',
; a protocol version >= 1: the cart serves flat and APPBANK images).
mb_check:
        xor     a
        ld      (MbRes), a
        call    FN_PRESENT
        ret     nz
        ld      a, (FN_PROTOVER)
        or      a
        ret     z
        ld      a, 1
        ld      (MbRes), a
        ret

; ---- loaders ---------------------------------------------------------------------
; lib_ldv: BC bytes from HL to VRAM DE (31 T a byte at least). Clobbers all.
lib_ldv:
        push    hl
        ex      de, hl
        call    lib_vaw
        pop     hl
lv_l:   ld      a, (hl)                 ; 7
        out     ($be), a                ; 11
        inc     hl                      ; 6
        dec     bc                      ; 6
        ld      a, b                    ; 4
        or      c                       ; 4
        jr      nz, lv_l                ; 12 -> 50 T a byte
        ret

; lib_fillv: BC bytes of E at VRAM HL. Clobbers all.
lib_fillv:
        call    lib_vaw
lf_l:   ld      a, e                    ; 4
        out     ($be), a                ; 11
        dec     bc                      ; 6
        ld      a, b                    ; 4
        or      c                       ; 4
        jr      nz, lf_l                ; 12 -> 41 T a byte
        ret

; ---- the arena's redraw ------------------------------------------------------------
; lib_drawmarked: up to DRAW_BUDGET tiles marked in MapD (a bit a tile)
; drawn from the map in ST (our pending bomb, PendTile, shown as a bomb),
; their marks cleared; the rest stay marked for the next pass (a big blast
; is drawn over two or three frames, never a frame lost). Clobbers all but
; IX, IY.
DRAW_BUDGET equ 8
lib_drawmarked:
        ld      a, DRAW_BUDGET
        ld      (DrawLeft), a
        ld      c, 0                    ; C: the byte's first tile
        ld      hl, MapD
        ld      b, 18
ldm_byte:
        ld      a, (hl)
        or      a
        jr      z, ldm_next
        push    bc
        push    hl
        ld      d, c                    ; D: the tile
        ld      e, 1                    ; E: its bit
ldm_bit:
        ld      a, (hl)
        and     e
        jr      z, ldm_nb
        ld      a, e
        cpl
        and     (hl)
        ld      (hl), a                 ; (its mark cleared)
        push    de
        push    hl
        call    ldm_tile
        pop     hl
        pop     de
        ld      a, (DrawLeft)
        dec     a
        ld      (DrawLeft), a
        jr      nz, ldm_nb
        pop     hl                      ; the budget spent: the rest next pass
        pop     bc
        ret
ldm_nb: inc     d
        sla     e
        jr      nz, ldm_bit
        pop     hl
        pop     bc
ldm_next:
        inc     hl
        ld      a, c
        add     a, 8
        ld      c, a
        djnz    ldm_byte
        ret
; ldm_tile: tile D drawn. Clobbers A, BC, DE, HL.
ldm_tile:
        ld      a, d
        cp      143
        ret     nc
        ld      hl, ST+88
        ld      c, d
        ld      b, 0
        add     hl, bc
        ld      b, (hl)                 ; B: its kind
        ld      a, (PendTile)
        cp      d
        jr      nz, ldm_k
        ld      b, 4                    ; (T_BOMB)
ldm_k:  ld      a, d
        ld      c, 0
ldm_dv: cp      13
        jr      c, ldm_rc
        sub     13
        inc     c
        jr      ldm_dv
ldm_rc: ld      e, a                    ; the column
        ld      d, c                    ; the row
        ld      a, b
        jp      lib_tile

; lib_marked: A = 1 when a tile is still marked (MapD not all zero)
lib_marked:
        ld      hl, MapD
        ld      b, 18
        xor     a
lmk_l:  or      (hl)
        inc     hl
        djnz    lmk_l
        or      a
        ret     z
        ld      a, 1
        ret

; lib_setmap: map tile A becomes E: marked (lib_mapmark) if it changes, then
; stored in ST (a test scene's change, or a patched map byte from the link).
; Clobbers A, BC, D, HL.
lib_setmap:
        ld      c, a
        ld      b, 0
        ld      hl, ST+88
        add     hl, bc
        ld      d, (hl)
        ld      (hl), e
        ld      a, d
        cp      e
        ret     z
        ld      a, c
        jp      lib_mapmark

; ---- speed helpers for the per-frame and per-patch work ----------------------------
; lib_mapmark: tile A changes from D to E: its bit in MapD, MF_MAP; a blast's
; centre from no flame: MF_BOOM; a bomb become a dud: MF_FIZZ (net.c's
; stage_map, play.c's boom and fizzle tests). Clobbers A, BC, HL.
lib_mapmark:
        ld      c, a
        rrca
        rrca
        rrca
        and     $1F
        ld      l, a
        ld      h, 0
        push    de
        ld      de, MapD
        add     hl, de
        pop     de
        push    hl
        ld      a, c
        and     7
        ld      c, a
        ld      b, 0
        ld      hl, BitTab
        add     hl, bc
        ld      a, (hl)
        pop     hl
        or      (hl)
        ld      (hl), a
        ld      hl, MFlags
        set     0, (hl)                 ; MF_MAP
        ld      a, e                    ; a blast's centre, from not a flame
        cp      6
        jr      nz, lmm_f
        ld      a, d
        cp      6
        jr      c, lmm_boom
        cp      13
        jr      c, lmm_f
lmm_boom:
        set     1, (hl)                 ; MF_BOOM
lmm_f:  ld      a, d                    ; a bomb become a dud
        cp      4
        ret     nz
        ld      a, e
        cp      5
        ret     nz
        set     2, (hl)                 ; MF_FIZZ
        ret

; lib_toward: play.c toward(): from B a step to C (3 units; more than a
; tile: there) -> TwR. Clobbers A, D.
lib_toward:
        ld      a, b
        sub     c
        jr      nc, ltw_p
        neg                             ; |at - to|
ltw_p:  cp      17
        jr      c, ltw_n
        ld      a, c                    ; more than a tile: there
        ld      (TwR), a
        ret
ltw_n:  cp      4
        jr      c, ltw_d
        ld      a, 3
ltw_d:  ld      d, a
        ld      a, b
        cp      c
        jr      c, ltw_up
        sub     d
        ld      (TwR), a
        ret
ltw_up: add     a, d
        ld      (TwR), a
        ret

; lib_sprat: seat Si's sprite at screen x Vi, y Wi, frame Ri, in its colour.
; Clobbers A, DE, HL.
lib_sprat:
        ld      a, (Si)
        ld      e, a
        ld      d, 0
        ld      hl, SprY
        add     hl, de
        ld      a, (Wi)
        dec     a
        ld      (hl), a
        ld      hl, SprX
        add     hl, de
        ld      a, (Vi)
        ld      (hl), a
        ld      hl, SprP
        add     hl, de
        ld      a, (Ri)
        add     a, a
        add     a, a
        ld      (hl), a
        ld      hl, SeatCol
        add     hl, de
        ld      a, (hl)
        ld      hl, SprC
        add     hl, de
        ld      (hl), a
        ret

; mb_param16: a two-byte parameter HL (size 2, then low, high). Amy Studio
; r12.12's FN_PARAM16 sends $FF as the high byte (FN_TX_BYTE sets H to $FF
; before it reads H): this keeps the high byte in B. Clobbers A, B, HL.
mb_param16:
        ld      b, h
        push    hl
        ld      a, 2
        call    FN_TX_BYTE
        pop     hl
        ld      a, l
        call    FN_TX_BYTE
        ld      a, b
        jp      FN_TX_BYTE

; ---- the link's receive path, per byte (p_net.inc DECODE, transcribed) ----------
; lib_decode: the READ's bytes from $F800 + DRPos, DecN of them at most,
; until a frame's end (a 0: DecEnd = 1, back to Amy's FrameEnd, which checks
; the sums and does what the frame says). COBS blocks (DCode, DFlag), the
; last two decoded bytes held back (DOne, DTwo: the sums at the end), the
; running Fletcher-16 (SumA, SumB, mod 255), the frame's type (FType) and
; index (FIdx); a patch's runs (QSt, QOff, QLen) written into ST as they
; come, a map byte through lib_setmap (its tile marked for the arena); a T
; frame's record into the list (in ST). Taken counts the bytes taken.
; Clobbers all but IX, IY.
lib_decode:
        xor     a
        ld      (DecEnd), a
ldc_l:  ld      a, (DecN)
        or      a
        ret     z
        dec     a
        ld      (DecN), a
        ld      a, (DRPos)
        ld      l, a
        ld      h, $F8
        ld      c, (hl)
        inc     a
        ld      (DRPos), a
        ld      hl, Taken
        inc     (hl)
        ld      a, c
        or      a
        jr      nz, ldc_nz
        inc     a                       ; a frame's end
        ld      (DecEnd), a
        ret
ldc_nz: ld      a, (DCode)
        or      a
        jr      z, ldc_code
        dec     a                       ; a data byte
        ld      (DCode), a
        ld      a, c
        call    ldc_emit
        jr      ldc_l
ldc_code:
        ld      a, c                    ; a block's code: its data bytes
        dec     a
        ld      (DCode), a
        ld      a, (DFlag)
        ld      b, a                    ; (the last block's)
        ld      a, c
        cp      255
        ld      a, 1                    ; DF_BLK
        jr      nz, ldc_f
        ld      a, 3                    ; DF_BLK | DF_255
ldc_f:  ld      (DFlag), a
        ld      a, b                    ; the zero before it, unless it is the
        cp      1                       ;  frame's first or follows a 254-byte one
        jr      nz, ldc_l
        xor     a
        call    ldc_emit
        jr      ldc_l

; ldc_emit: A = a decoded byte, into the two held back; the one pushed out
; is the frame's (E)
ldc_emit:
        ld      c, a
        ld      a, (DN)
        cp      2
        jr      nc, le_full
        inc     a
        ld      (DN), a
        ld      a, (DTwo)
        ld      (DOne), a
        ld      a, c
        ld      (DTwo), a
        ret
le_full:
        ld      a, (DOne)
        ld      e, a
        ld      a, (DTwo)
        ld      (DOne), a
        ld      a, c
        ld      (DTwo), a
        ld      a, (SumA)               ; s1 += b, s2 += s1 (mod 255)
        add     a, e
        jr      nc, le_s1
        inc     a
le_s1:  cp      255
        jr      nz, le_s1b
        xor     a
le_s1b: ld      (SumA), a
        ld      b, a
        ld      a, (SumB)
        add     a, b
        jr      nc, le_s2
        inc     a
le_s2:  cp      255
        jr      nz, le_s2b
        xor     a
le_s2b: ld      (SumB), a
        ld      a, (FIdx)
        or      a
        jr      nz, le_body
        inc     a                       ; its type
        ld      (FIdx), a
        ld      a, e
        ld      (FType), a
        xor     a
        ld      (QSt), a
        ret
le_body:
        ld      a, (FType)
        cp      81                      ; CS_PATCH
        jr      z, le_patch
        ld      a, (FIdx)               ; C, E, T: the payload's place + 1
        inc     a
        jr      z, le_o
        ld      (FIdx), a
le_o:   ld      a, (FType)
        cp      84                      ; CS_TABLE
        jr      z, le_tab
        ld      a, (FIdx)               ; C, E: the first payload byte kept
        cp      2
        ret     nz
        ld      a, e
        ld      (QOff), a
        ret
le_tab: ld      a, (FIdx)
        cp      2
        jr      nz, le_t3
        ld      a, e                    ; the index (255: out of range)
        cp      8
        jr      c, le_t2
        ld      a, 255
le_t2:  ld      (QLen), a
        ret
le_t3:  cp      3
        jr      nz, le_t4
        ld      a, e                    ; the count, at most MAX_TABLES
        cp      9
        jr      c, le_t3b
        ld      a, 8
le_t3b: ld      (QOff), a
        ret
le_t4:  sub     4                       ; a record's byte: ST + 24 index + k
        cp      24
        ret     nc
        ld      c, a
        ld      a, e
        ld      (DecB), a               ; (the byte: E is needed below)
        ld      a, (QLen)
        cp      255
        ret     z
        ld      l, a
        ld      h, 0
        add     hl, hl
        add     hl, hl
        add     hl, hl                  ; 8 index
        push    hl
        add     hl, hl                  ; 16 index
        pop     de
        add     hl, de                  ; 24 index
        ld      b, 0
        add     hl, bc
        ld      bc, ST
        add     hl, bc
        ld      a, (DecB)
        ld      (hl), a
        ret
le_patch:
        ld      a, (QSt)
        cp      2
        jr      z, lp_byte
        or      a
        jr      nz, lp_1
        ld      a, e                    ; a run's offset
        ld      (QOff), a
        ld      a, 1
        ld      (QSt), a
        ret
lp_1:   cp      1
        ret     nz                      ; (3: a bad run, ignored)
        ld      a, e                    ; its length
        ld      (QLen), a
        or      a
        jr      nz, lp_2
        ld      (QSt), a                ; (no bytes: the next run)
        ret
lp_2:   ld      d, a
        ld      a, (QOff)
        add     a, d
        jr      c, lp_bad
        cp      248                     ; past STATE_SIZE: a bad run
        jr      nc, lp_bad
        ld      a, 2
        ld      (QSt), a
        ret
lp_bad: ld      a, 3
        ld      (QSt), a
        ret
lp_byte:
        ld      a, (QOff)
        cp      88                      ; OFF_MAP
        jr      c, lp_put
        cp      231                     ; OFF_MAP + TILES: the movers
        jr      nc, lp_mov
        sub     88
        call    lib_setmap              ; a map byte: marked if it changes
        jr      lp_next
lp_mov: ld      hl, MFlags
        set     3, (hl)                 ; MF_MOVERS
lp_put: ld      a, (QOff)
        ld      c, a
        ld      b, 0
        ld      hl, ST
        add     hl, bc
        ld      (hl), e
lp_next:
        ld      hl, QOff
        inc     (hl)
        ld      hl, QLen
        dec     (hl)
        ret     nz
        xor     a
        ld      (QSt), a
        ret
snd_start:
; generated by kit/os7music.py from title.txt, round.txt, jingles.txt, win.txt, game.txt - do not edit by hand
; use: set sound table FbSoundTable areas 7
; songs share the music areas: stop one song before starting another
; merged 5 scores: table 2449 bytes (30 entries, 7 areas)
;   Fuse: loop 896 frames
;   Maze: loop 448 frames
;   Ready: loop 192 frames (plays once)
;   Round won: loop 192 frames (plays once)
;   Champion: loop 384 frames (plays once)
;   SndMtLead        MtLead           $702B music    303 bytes    896 frames
;   SndMtTwo         MtTwo            $7035 music    225 bytes    896 frames
;   SndMtNoise       MtNoise          $703F music    365 bytes    896 frames
;   SndMtPitch       MtPitch          $7049 music    109 bytes    896 frames
;   SndMrLead        MrLead           $702B music    136 bytes    448 frames
;   SndMrTwo         MrTwo            $7035 music     57 bytes    448 frames
;   SndMrNoise       MrNoise          $703F music    251 bytes    448 frames
;   SndMrPitch       MrPitch          $7049 music     49 bytes    448 frames
;   SndMcLead        McLead           $702B music     51 bytes    192 frames
;   SndMcTwo         McTwo            $7035 music     51 bytes    192 frames
;   SndMcNoise       McNoise          $703F music     48 bytes    192 frames
;   SndMcPitch       McPitch          $7049 music     13 bytes    192 frames
;   SndMwLead        MwLead           $702B music     61 bytes    192 frames
;   SndMwTwo         MwTwo            $7035 music     61 bytes    192 frames
;   SndMwNoise       MwNoise          $703F music     56 bytes    192 frames
;   SndMwPitch       MwPitch          $7049 music     13 bytes    192 frames
;   SndMgLead        MgLead           $702B music    127 bytes    384 frames
;   SndMgTwo         MgTwo            $7035 music    127 bytes    384 frames
;   SndMgNoise       MgNoise          $703F music    116 bytes    384 frames
;   SndMgPitch       MgPitch          $7049 music     17 bytes    384 frames
;   SndDrop          SfxDrop          $7067 effect     9 bytes      4 frames
;   SndBoom          SfxBoom          $7053 effect     6 bytes     24 frames
;   SndPickup        SfxPickup        $705D effect    19 bytes     15 frames
;   SndKick          SfxKick          $7053 effect     6 bytes      4 frames
;   SndThrow         SfxThrow         $7067 effect     9 bytes     12 frames
;   SndFizzle        SfxFizzle        $7053 effect     6 bytes     10 frames
;   SndDie           SfxDie           $705D effect     9 bytes     47 frames
;   SndBeep          SfxBeep          $705D effect     7 bytes      5 frames
;   SndGo            SfxGo            $705D effect    13 bytes     15 frames
;   SndSelect        SfxSelect        $705D effect     7 bytes      3 frames
FbSoundTable:
    dw MtLead,$702B
    dw MtTwo,$7035
    dw MtNoise,$703F
    dw MtPitch,$7049
    dw MrLead,$702B
    dw MrTwo,$7035
    dw MrNoise,$703F
    dw MrPitch,$7049
    dw McLead,$702B
    dw McTwo,$7035
    dw McNoise,$703F
    dw McPitch,$7049
    dw MwLead,$702B
    dw MwTwo,$7035
    dw MwNoise,$703F
    dw MwPitch,$7049
    dw MgLead,$702B
    dw MgTwo,$7035
    dw MgNoise,$703F
    dw MgPitch,$7049
    dw SfxDrop,$7067
    dw SfxBoom,$7053
    dw SfxPickup,$705D
    dw SfxKick,$7053
    dw SfxThrow,$7067
    dw SfxFizzle,$7053
    dw SfxDie,$705D
    dw SfxBeep,$705D
    dw SfxGo,$705D
    dw SfxSelect,$705D
    dw 0
MtLead:
    db $42,$FE,$20,$0E,$14,$32,$42,$D6,$20,$0E,$14,$32,$42,$AA,$20,$0E
    db $14,$32,$42,$7F,$20,$0E,$14,$32,$42,$8F,$20,$0E,$14,$32,$42,$AA
    db $20,$0E,$14,$32,$42,$D6,$20,$0E,$14,$32,$42,$AA,$20,$0E,$14,$32
    db $42,$A0,$20,$0E,$14,$32,$42,$7F,$20,$0E,$14,$32,$42,$6B,$20,$0E
    db $14,$32,$42,$7F,$20,$0E,$14,$32,$42,$8F,$20,$1C,$14,$32,$42,$AA
    db $20,$1C,$14,$32,$42,$BE,$20,$0E,$14,$32,$42,$A0,$20,$0E,$14,$32
    db $42,$7F,$20,$0E,$14,$32,$42,$5F,$20,$0E,$14,$32,$42,$6B,$20,$0E
    db $14,$32,$42,$7F,$20,$0E,$14,$32,$42,$8F,$20,$0E,$14,$32,$42,$AA
    db $20,$0E,$14,$32,$42,$AA,$20,$1C,$14,$32,$42,$87,$20,$1C,$14,$32
    db $42,$71,$20,$1C,$14,$32,$42,$55,$20,$1C,$14,$32,$42,$6B,$20,$15
    db $14,$32,$42,$71,$20,$07,$14,$22,$42,$7F,$20,$0E,$14,$32,$42,$AA
    db $20,$0E,$14,$32,$6E,$42,$AA,$20,$0E,$14,$32,$42,$7F,$20,$0E,$14
    db $32,$42,$6B,$20,$0E,$14,$32,$42,$5F,$20,$15,$14,$32,$42,$6B,$20
    db $07,$14,$22,$42,$71,$20,$0E,$14,$32,$42,$8F,$20,$0E,$14,$32,$7C
    db $42,$8F,$20,$1C,$14,$32,$42,$A0,$20,$15,$14,$32,$42,$AA,$20,$07
    db $14,$22,$42,$BE,$20,$0E,$14,$32,$42,$A0,$20,$0E,$14,$32,$42,$7F
    db $20,$0E,$14,$32,$42,$8F,$20,$0E,$14,$32,$42,$A0,$20,$0E,$14,$32
    db $42,$BE,$20,$0E,$14,$32,$42,$AA,$20,$1C,$14,$32,$42,$E2,$20,$1C
    db $14,$32,$42,$AA,$20,$1C,$14,$32,$42,$87,$20,$1C,$14,$32,$58
MtTwo:
    db $AE,$82,$53,$51,$0E,$14,$11,$AE,$82,$53,$51,$0E,$14,$11,$AE,$82
    db $53,$51,$0E,$14,$11,$AE,$82,$53,$51,$0E,$14,$11,$AE,$82,$40,$51
    db $0E,$14,$11,$AE,$82,$40,$51,$0E,$14,$11,$AE,$82,$53,$51,$0E,$14
    db $11,$AE,$82,$53,$51,$0E,$14,$11,$AE,$82,$40,$51,$0E,$14,$11,$AE
    db $82,$40,$51,$0E,$14,$11,$AE,$82,$53,$51,$0E,$14,$11,$AE,$82,$53
    db $51,$0E,$14,$11,$AE,$82,$53,$51,$0E,$14,$11,$AE,$82,$0D,$51,$0E
    db $14,$11,$AE,$82,$E2,$50,$0E,$14,$11,$AE,$82,$0D,$51,$0E,$14,$11
    db $AE,$82,$FE,$50,$0E,$14,$11,$AE,$82,$FE,$50,$0E,$14,$11,$AE,$82
    db $D6,$50,$0E,$14,$11,$AE,$82,$D6,$50,$0E,$14,$11,$AE,$82,$E2,$50
    db $0E,$14,$11,$AE,$82,$E2,$50,$0E,$14,$11,$AE,$82,$BE,$50,$0E,$14
    db $11,$AE,$82,$BE,$50,$0E,$14,$11,$AE,$82,$FE,$50,$0E,$14,$11,$AE
    db $82,$FE,$50,$0E,$14,$11,$AE,$82,$BE,$50,$0E,$14,$11,$AE,$82,$BE
    db $50,$0E,$14,$11,$AE,$82,$0D,$51,$0E,$14,$11,$AE,$82,$E2,$50,$0E
    db $14,$11,$AE,$82,$BE,$50,$0E,$14,$11,$AE,$82,$E2,$50,$0E,$14,$11
    db $98
MtNoise:
    db $02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21
    db $2B,$02,$23,$0E,$16,$21,$02,$23,$0E,$16,$21,$02,$64,$01,$33,$11
    db $2D,$02,$25,$03,$25,$21,$2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E
    db $16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21,$2B,$02,$23
    db $0E,$16,$21,$02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25
    db $03,$25,$21,$2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21,$02
    db $64,$01,$33,$11,$2D,$02,$25,$03,$25,$21,$2B,$02,$23,$0E,$16,$21
    db $02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21
    db $2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21,$02,$64,$01,$33
    db $11,$2D,$02,$25,$03,$25,$21,$2B,$02,$23,$0E,$16,$21,$02,$23,$0E
    db $16,$21,$02,$25,$03,$25,$21,$2B,$02,$25,$03,$25,$21,$2B,$02,$25
    db $03,$25,$21,$2B,$02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02
    db $25,$03,$25,$21,$2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21
    db $02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21,$2B,$02,$64,$01,$33
    db $11,$2D,$02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03
    db $25,$21,$2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21,$02,$64
    db $01,$33,$11,$2D,$02,$25,$03,$25,$21,$2B,$02,$64,$01,$33,$11,$2D
    db $02,$23,$0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21
    db $2B,$02,$64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21,$02,$64,$01,$33
    db $11,$2D,$02,$25,$03,$25,$21,$2B,$02,$64,$01,$33,$11,$2D,$02,$23
    db $0E,$16,$21,$02,$64,$01,$33,$11,$2D,$02,$25,$03,$25,$21,$2B,$02
    db $64,$01,$33,$11,$2D,$02,$23,$0E,$16,$21,$02,$25,$03,$25,$21,$2B
    db $02,$25,$03,$25,$21,$2B,$02,$25,$03,$25,$21,$2B,$18
MtPitch:
    db $C0,$88,$F0,$38,$C0,$5A,$F0,$1C,$C0,$88,$F0,$1C,$C0,$AB,$F0,$38
    db $C0,$72,$F0,$1C,$C0,$AB,$F0,$1C,$C0,$66,$F0,$38,$C0,$88,$F0,$1C
    db $C0,$66,$F0,$1C,$C0,$B5,$F0,$38,$C0,$79,$F0,$1C,$C0,$B5,$F0,$1C
    db $C0,$88,$F0,$1C,$C0,$5A,$F0,$1C,$C0,$88,$F0,$1C,$C0,$5A,$F0,$1C
    db $C0,$98,$F0,$1C,$C0,$66,$F0,$1C,$C0,$98,$F0,$1C,$C0,$66,$F0,$38
    db $C0,$88,$F0,$1C,$C0,$AB,$F0,$1C,$C0,$88,$F0,$1C,$C0,$B5,$F0,$1C
    db $C0,$79,$F0,$1C,$C0,$B5,$F0,$1C,$C0,$79,$F0,$1C,$D8
MrLead:
