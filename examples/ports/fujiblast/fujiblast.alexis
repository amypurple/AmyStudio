' ================================================================ ROM tables
data BitTab bytes 1,2,4,8,16,32,64,128
data SeatOff bytes 0,10,20,30
data RowBase bytes 0,13,26,39,52,65,78,91,104,117,130
' each seat's colour: sprites (white, light red, cyan, light yellow) and its
' text style in the menus and in the arena
data SeatCol bytes 15,9,7,11
data SeatMenuStyle bytes STY_W,STY_R,STY_C,STY_Y
data MenuStyles bytes $F4,$B4,$94,$74
data ArenaStyles bytes $F1,$91,$71,$B1
' the bombers' frames by direction (FR_UP0, FR_RIGHT0, FR_DOWN0, FR_LEFT0)
data FrBase bytes 0,3,6,9
data FrWalk bytes 0,1,0,2
' the link's frames by TXF bit: raw length + 2, and the type
data FLen bytes 23,9,9,6,5,5,5,5
data FTypes bytes 72,65,77,67,80,82,84,66
' the HUD's columns: seat 0, seat 1, (timer), seat 2, seat 3
data HudCol bytes 3,8,20,25
' the stats' fields, the shown value's offset, a mask
data StFld bytes 4,5,6,3,3
' the screens by phase
data ScrFor bytes 1,2,2,3,4
data LogoCode bytes 0

' ---- text (zero-ended) -------------------------------------------------------
data SForFn chars "FOR FUJINET{0}"
data SPress chars "PRESS FIRE{0}"
data SBlank10 chars "          {0}"
data STag chars "BOMBS AND BLASTS FOR 2-4{0}"
data SCred1 chars "FUJIBLAST: FUJINET 2026{0}"
