  }
  mode 2 screen
  sprites 16x16
  set sound table FbSoundTable areas MtAreas
  nmi off
  display off
  copy SprPat count 576 to vram $3800
  fill 0 count 768 to vram.name
  HideAll
  MySeat = NONE
  ' the rigs' offline scenes (test.c): they need no cartridge
  TestCheck
  ' the cart: 'F','N', a protocol (it may take a moment to paint its mailbox)
  for I = 1 to 120
    call asm mb_check
    if MbRes = 1 then exit for
    Frame1
  next
  if MbRes <> 1 then
    MsgA = @SNeed
    MsgB = @SCart
    Message(1)
    do
      Tick
    loop
  end if
  AkLoad
  TitleScreen
  if MyName[0] = 0 then
    NameEntry
    AkSaveName
  end if
MainLoop:
  if SrvTbl[0] = 0 then
    TableList
    if Nn = 0 then goto MainLoop
  end if
  PlayTable
  if Nn = 0 then AkClearRoom
  goto MainLoop

' play_table: play at SrvTbl. Nn = 1: come back to it (the link dropped);
' 0: we left, or it would not have us.
sub PlayTable:
  AkSaveRoom
  MsgA = @SJoin
  MsgB = address of SrvTbl
  Message(1)
  SockOpen
  if MbOk = 0 then
    NoAnswer
    Nn = 0
    return
  end if
  NetHello
  Shown = S_NONE
  ShSeq = 0
  do
    Tick
    NetStep
    if (NEvt & EV_ERROR) <> 0 then
      SndLoop(0)
      NetClose
      MsgA = @SSaidNo
      MsgB = @SNoRoom
      if NErr = ERR_VERSION then MsgB = @SUpdate
      Message(0)
      Nn = 0
      return
    end if
    if (NEvt & EV_LOST) <> 0 then
      SndLoop(0)
      HideAll
      SockClose
      MsgA = @SLost
      MsgB = @SAgain
      Message(120)
      Nn = 1
      return
    end if
    if (NEvt & EV_NOANS) <> 0 then
      NetClose
      NoAnswer
      Nn = 0
      return
    end if
    if EvKey = KEY_ESC then
      SndLoop(0)
      if (NLink & NL_JOINED) <> 0 then NetAct(ACT_LEAVE, 0, 0)
      NetClose
      HideAll
      Nn = 0
      return
    end if
    if (NLink & NL_HEARD) <> 0 then
      if (NEvt & EV_STATE) <> 0 then ScreenForState
      TableFrame
    end if
  loop
end sub

' a commit: the screen its phase wants, drawn afresh if it isn't the one
' shown (or a new round's arena), else the new state on it
sub ScreenForState:
  Vi = S_WAIT
  if ST[OFF_PHASE] <= PH_GAMEOVER then Vi = ScrFor[ST[OFF_PHASE]]
  if Vi <> Shown or (Vi = S_ARENA and ST[OFF_SEQ] <> ShSeq) then
    Shown = Vi
    ShSeq = ST[OFF_SEQ]
    if Vi = S_WAIT then
      WaitEnter
    elseif Vi = S_ARENA then
      PlayEnter
    else
      Wi = 0
      if Vi = S_GAME then Wi = 1
      ResultsEnter(Wi)
    end if
  elseif Shown = S_WAIT then
    WaitState
  elseif Shown = S_ARENA then
    PlayState
  end if
  return
end sub

sub TableFrame:
  if Shown = S_WAIT then
    WaitFrame
  elseif Shown = S_ARENA then
    PlayFrame
  elseif Shown <> S_NONE then
    ResultsFrame
  end if
  return
end sub
' ================================================================ the frame
' (screens.c tick, frame_wait, input_poll; core.inc FRAME) The NMI - the
' BIOS sound, the controllers - runs only during the `wait`: the game's VDP
' and mailbox accesses are never interrupted.
sub Frame1:
  nmi off
  nmi on
  wait
  nmi off
  inc FrameCount
  inc TickC
  return
end sub

' the stick (IN_* bits), the trigger's edge, the keypad's edge
sub ReadInput:
  Vi = 0
  if joypad(1).up or joypad(2).up then Vi = Vi | IN_UP
  if joypad(1).down or joypad(2).down then Vi = Vi | IN_DOWN
  if joypad(1).left or joypad(2).left then Vi = Vi | IN_LEFT
  if joypad(1).right or joypad(2).right then Vi = Vi | IN_RIGHT
  if TestOn = 5 then Vi = HookDir
  InDir = Vi
  Wi = 0
  if joypad(1).fire or joypad(2).fire then Wi = 1
  EvBtn = 0
  if Wi = 1 and WasBtn = 0 then EvBtn = 1
  WasBtn = Wi
  Wi = keypad(1)
  if Wi = 255 then Wi = keypad(2)
  EvKey = 255
  if Wi <> KRaw then EvKey = Wi
  KRaw = Wi
  return
end sub

' tick(): a frame, the input, # for the sound
sub Tick:
  Frame1
  ReadInput
  if EvKey = KEY_MUTE then ToggleMute
  return
end sub

' the stick pushed this frame (not held)
function Pressed(u8 Bit) as u8
  if (InDir & Bit) <> 0 and (PrevDir & Bit) = 0 then return 1
  return 0

' ================================================================ sound
' (sound.h: snd_play, snd_music, snd_loop, snd_stop, snd_toggle_mute) One OS7
' sound table built by os7music.py: five tunes of four areas each, then the
' effects. A tune is its first entry (SndMtLead...).
sub SndPlay(u8 Id):
  if Muted = 0 then play sound Id
  return
end sub

sub SndStop:
  if MusBase <> 0 then
    stop sound MusBase
    Wi = MusBase + 1
    stop sound Wi
    Wi = MusBase + 2
    stop sound Wi
    Wi = MusBase + 3
    stop sound Wi
  end if
  MusBase = 0
  LoopOn = 0
  return
end sub

sub SndMusic(u8 Base):
  SndStop
  MusBase = Base
  if Muted = 0 then
    play sound Base
    Wi = Base + 1
    play sound Wi
    Wi = Base + 2
    play sound Wi
    Wi = Base + 3
    play sound Wi
  end if
  return
end sub

' the round's loop on (1) or off (0)
sub SndLoop(u8 OnOff):
  if OnOff = 1 then
    if LoopOn = 0 then
      SndMusic(SndMrLead)
      LoopOn = 1
    end if
  else
    if LoopOn = 1 then SndStop
  end if
  return
end sub

sub ToggleMute:
  if Muted = 0 then
    Wi = MusBase
    Vi = LoopOn
    SndStop
    MusBase = Wi
    LoopOn = Vi
    Muted = 1
  else
    Muted = 0
    if LoopOn = 1 then
      LoopOn = 0
      SndLoop(1)
    end if
  end if
  return
end sub

' ================================================================ the screen
' (gfx.c / gfx.inc) Graphics II as a character map: each screen loads its own
' characters into the three pattern and colour thirds with the display off.

' a run of patterns and one colour into the three thirds: LdN codes from
' code LdAt, the patterns at LdSrc (ROM), the colour byte LdC
sub LoadRun:
  LdOff = LdAt
  LdOff = LdOff * 8
  LdCnt = LdN
  LdCnt = LdCnt * 8
  Ld2 = LdOff + $0000 + 0
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $0000 + $0800
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $0000 + $1000
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $2000 + 0
  call asm lib_fillv with hl = Ld2, bc = LdCnt, e = LdC
  Ld2 = LdOff + $2000 + $0800
  call asm lib_fillv with hl = Ld2, bc = LdCnt, e = LdC
  Ld2 = LdOff + $2000 + $1000
  call asm lib_fillv with hl = Ld2, bc = LdCnt, e = LdC
  return
end sub

' the same with their own colour bytes (at LdCol, ROM)
sub LoadRun2:
  LdOff = LdAt
  LdOff = LdOff * 8
  LdCnt = LdN
  LdCnt = LdCnt * 8
  Ld2 = LdOff + $0000 + 0
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $0000 + $0800
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $0000 + $1000
  call asm lib_ldv with hl = LdSrc, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $2000 + 0
  call asm lib_ldv with hl = LdCol, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $2000 + $0800
  call asm lib_ldv with hl = LdCol, de = Ld2, bc = LdCnt
  Ld2 = LdOff + $2000 + $1000
  call asm lib_ldv with hl = LdCol, de = Ld2, bc = LdCnt
  return
end sub

' a new screen: the display off, the name table cleared, the sprites hidden
sub GfxBegin:
  Frame1
  display off
  fill 0 count 768 to vram.name
  HideAll
  return
end sub

sub GfxShow:
  Frame1
  display on
  return
end sub

' the menus' characters: code 0 blank on blue, four text styles, the logo,
' a trophy
sub MenuSet:
  backdrop MENU_BG
  fill 0 count 8 to vram.pattern
  fill 0 count 8 to vram.pattern + $0800
  fill 0 count 8 to vram.pattern + $1000
  fill $44 count 8 to vram.color
  fill $44 count 8 to vram.color + $0800
  fill $44 count 8 to vram.color + $1000
  for Si = 0 to 3
    LdSrc = @FontPat
    LdN = NGLYPH
    LdAt = 1 + Si * NGLYPH
    LdC = MenuStyles[Si]
    LoadRun
  next
  LdSrc = @LogoPat
  LdCol = @LogoCol
  LdN = 36
  LdAt = MENU_LOGO
  LoadRun2
  LdSrc = @SmallPat + SM_CUP * 8
  LdN = 1
  LdAt = MENU_CUP
  LdC = $B4
  LoadRun
  TileBase = 0
  return
end sub

' the arena's characters: code 0 blank on black, the 18 tiles, the small
' cells (stat icons, the wall), the HUD's glyphs in the four seats' colours
sub ArenaSet:
  backdrop 1
  fill 0 count 8 to vram.pattern
  fill 0 count 8 to vram.pattern + $0800
  fill 0 count 8 to vram.pattern + $1000
  fill $11 count 8 to vram.color
  fill $11 count 8 to vram.color + $0800
  fill $11 count 8 to vram.color + $1000
  LdSrc = @TilePat
  LdCol = @TileCol
  LdN = 72
  LdAt = 1
  LoadRun2
  LdSrc = @SmallPat
  LdCol = @SmallCol
  LdN = NSMALL
  LdAt = AR_SMALL
  LoadRun2
  for Si = 0 to 3
    LdSrc = @FontPat
    LdN = NHUDGLYPH
    LdAt = AR_HUD + Si * NHUDGLYPH
    LdC = ArenaStyles[Si]
    LoadRun
  next
  TileBase = 1
  return
end sub

' ---- text: thin wrappers over lib.asm ----------------------------------------
' (the string's address in MsgA; row, column, style)
sub TextAt(u8 Row, u8 Col, u8 Sty):
  call asm lib_text with hl = MsgA, d = Row, e = Col, c = Sty
  return
end sub

sub CentreAt(u8 Row, u8 Sty):
  call asm lib_centre with hl = MsgA, d = Row, c = Sty
  return
end sub

' Nn bytes from MsgA (0: a space)
sub TextN(u8 Row, u8 Col, u8 Sty):
  call asm lib_textn with hl = MsgA, b = Nn, d = Row, e = Col, c = Sty
  return
end sub

sub ClearRow(u8 Row):
  call asm lib_fillrow with d = Row, a = 0
  return
end sub

sub PutCell(u8 Row, u8 Col, u8 Code):
  call asm lib_put with d = Row, e = Col, a = Code
  return
end sub

' a number (0-255) without leading zeros, into Buf, zero-ended
sub NumBuf(u8 Value):
  Nn = 0
  if Value >= 100 then
    Buf[0] = 48 + Value / 100
    Nn = 1
    Value = Value % 100
    Buf[1] = 48 + Value / 10
    Buf[2] = 48 + Value % 10
    Nn = 3
  elseif Value >= 10 then
    Buf[0] = 48 + Value / 10
    Buf[1] = 48 + Value % 10
    Nn = 2
  else
    Buf[0] = 48 + Value
    Nn = 1
  end if
  Buf[Nn] = 0
  return
end sub

sub NumAt(u8 Row, u8 Col, u8 Value, u8 Sty):
  NumBuf(Value)
  MsgA = address of Buf
  TextAt(Row, Col, Sty)
  return
end sub

' ---- sprites (sprites.inc, shadowed in SprY..SprC, written by lib_sprflush) --
sub HideAll:
  for Si = 0 to 3
    SprY[Si] = 209
    SprX[Si] = 0
    SprP[Si] = 0
    SprC[Si] = 0
  next
  call asm lib_sprflush
  return
end sub

' seat Si at screen pixel x Vi, y Wi, frame Ri (lib.asm lib_sprat)
sub SprAt:
  call asm lib_sprat
  return
end sub

sub SprHide:
  SprY[Si] = 209
  return
end sub
' ================================================================ the link
' net.c (the stream protocol) over the cart's mailbox, as the asm port's
' p_net.inc runs it: one step a frame that never waits. The FujiNet's TCP
' socket is driven one transaction at a time, posted in one frame and seen
' answered in a later one: a WRITE of whatever is to be sent; else, with
' bytes known waiting (NBW), a READ of them (up to RD_MAX, never more than
' is waiting); else a STATUS. Every answer replaces the reply window, so a
' READ's bytes are decoded (DCHUNK a step) before anything else is posted.
'
' What is to be sent is kept as intents (TxF) and encoded only when a WRITE
' goes: each frame built in RawBuf (type, payload, Fletcher-16), its COBS
' streamed into the transaction, then a 0. The server's frames are decoded
' as they come: COBS, a running Fletcher, the last two bytes held back (the
' sums), a patch's bytes written straight into ST. A bad frame asks for the
' whole state again (RESYNC); the screen is picked only at a commit.

' NINIT: a fresh link: nothing out, owed or half decoded
sub NetInit:
  NKind = 0
  NWait = 0
  NEvt = 0
  NErr = 0
  NBW = 0
  TxF = 0
  Taken = 0
  Credited = 0
  Quiet = 0
  QPing = 0
  QAsk = 0
  RHold = 0
  DLeft = 0
  DRPos = 0
  FrameReset
  MFlags = 0
  for I = 0 to 17
    MapD[I] = 0
  next
  TblN = 255
  TblHave = 0
  return
end sub

' NHELLO: sit at the table: the counters, ST zeroed (the state comes whole),
' HELLO due, no seat yet
sub NetHello:
  NetInit
  for I = 0 to STATE_SIZE - 1
    ST[I] = 0
  next
  NLink = (NLink & NL_LINK) | NL_JOINED
  TxF = TX_HELLO
  MySeat = NONE
  JoinT = 0
  return
end sub

sub NetLost:
  NLink = 0
  NEvt = NEvt | EV_LOST
  return
end sub

' net_act: an action, sent with the next WRITE (its own sequence number)
sub NetAct(u8 Act, u8 Arg1, u8 Arg2):
  inc ASeq
  if ASeq = 0 then ASeq = 1
  AKind = Act
  AArg1 = Arg1
  AArg2 = Arg2
  TxF = TxF | TX_ACT
  return
end sub

' net_move: where our player is
sub NetMove(u8 Xm, u8 Ym, u8 Dm):
  SentX = Xm
  SentY = Ym
  SentD = Dm
  TxF = TxF | TX_MOVE
  return
end sub

' NSTEP: one frame of the link (NEvt: what it brought)
sub NetStep:
  NEvt = 0
  if TestOn <> 0 then
    TxF = 0
    return
  end if
  if (NLink & NL_LINK) = 0 then
    NEvt = EV_LOST
    return
  end if
  NetTxn
  if NEvt <> 0 then return
  if DLeft <> 0 then
    Decode
    if (NEvt & EV_ERROR) <> 0 then return
  end if
  NetPost
  NetClock
  if (NEvt & EV_STATE) <> 0 then FindSeat
  if (NLink & (NL_JOINED | NL_HEARD)) = NL_JOINED then
    inc JoinT
    if JoinT > JOIN_WAIT then NEvt = NEvt | EV_NOANS
  end if
  return
end sub

' main.c find_seat: our seat is the one with our name (NONE: watching)
sub FindSeat:
  MySeat = NONE
  for Si = 0 to 3
    if (ST[OFF_SEATED] & BitTab[Si]) <> 0 then
      Po = OFF_NAMES + Si * 8
      Vi = 1
      for J = 0 to 7
        if ST[Po + J] <> MyName[J] then Vi = 0
      next
      if Vi = 1 then
        MySeat = Si
        return
      end if
    end if
  next
  return
end sub

' 1. the transaction out: answered? its answer taken
sub NetTxn:
  if NKind = 0 then return
  inc NWait
  if NWait = NTIMEOUT then
    NetLost
    return
  end if
  call asm mb_poll
  if MbRes = 0 then return
  K = NKind
  NKind = 0
  if MbRes <> 1 then
    NBW = 0
    return
  end if
  if K = NK_READ then
    DLeft = peek($FC04)
    DRPos = 0
    return
  end if
  if K = NK_STATUS then
    NBW = peek($F801)
    NBW = NBW * 256
    NBW = NBW + peek($F800)
    if NBW = 0 then
      if peek($F802) = 0 then NetLost
    end if
  end if
  return
end sub

' 3. the next transaction, once nothing is out and the last READ is decoded
sub NetPost:
  if NKind <> 0 then return
  if DLeft <> 0 then return
  if TxF <> 0 then
    PostWrite
    return
  end if
  if NBW <> 0 then
    if NBW > RD_MAX then
      W16 = RD_MAX
      NBW = NBW - RD_MAX
    else
      W16 = NBW
      NBW = 0
    end if
    call asm FN_BEGIN with d = DEV_NET, e = NC_READ, b = 1
    call asm mb_param16 with hl = W16
    NKind = NK_READ
  else
    call asm FN_BEGIN with d = DEV_NET, e = NC_STAT, b = 2
    call asm FN_PARAM8 with a = 0
    call asm FN_PARAM8 with a = 0
    NKind = NK_STATUS
  end if
  NWait = 0
  call asm mb_post
  return
end sub

' every frame TxF wants, in one WRITE: its length (each frame's raw length +
' 2: COBS adds one, then the 0), then the frames in bit order
sub PostWrite:
  W16 = 0
  for K = 0 to 7
    if (TxF & BitTab[K]) <> 0 then W16 = W16 + FLen[K]
  next
  call asm FN_BEGIN with d = DEV_NET, e = NC_WRITE, b = 1
  call asm mb_param16 with hl = W16
  for K = 0 to 7
    if (TxF & BitTab[K]) <> 0 then
      BuildFrame
      CobsOut
    end if
  next
  TxF = 0
  NKind = NK_WRITE
  NWait = 0
  call asm mb_post
  return
end sub

' frame K (a TxF bit's number) into RawBuf: type, payload, the two sums
sub BuildFrame:
  RawBuf[0] = FTypes[K]
  RawN = 1
  select case K
    case 0
      ' HELLO: version, flags, the table's id, our name (NUL padded)
      RawBuf[1] = PROTO_VERSION
      RawBuf[2] = 0
      for J = 0 to 7
        RawBuf[3 + J] = SrvTbl[J]
        RawBuf[11 + J] = MyName[J]
      next
      RawN = 19
    case 1
      RawBuf[1] = ASeq
      RawBuf[2] = AKind
      RawBuf[3] = AArg1
      RawBuf[4] = AArg2
      RawN = 5
    case 2
      RawBuf[1] = SentX
      RawBuf[2] = SentY
      RawBuf[3] = SentD
      RawBuf[4] = MyWarp
      RawN = 5
    case 3
      Credited = Taken
      RawBuf[1] = Taken
      RawN = 2
  end select
  ' Fletcher-16, both sums mod 255 (net.c add255: a carry is 1, 255 is 0)
  Vi = 0
  Wi = 0
  for J = 0 to RawN - 1
    Bv = RawBuf[J]
    Vi = Vi + Bv
    if Vi < Bv then inc Vi
    if Vi = 255 then Vi = 0
    Wi = Wi + Vi
    if Wi < Vi then inc Wi
    if Wi = 255 then Wi = 0
  next
  RawBuf[RawN] = Vi
  RawBuf[RawN + 1] = Wi
  RawN = RawN + 2
  return
end sub

' RawBuf's RawN bytes as COBS into the TX stream, then the frame's 0
sub CobsOut:
  Bv = 0
  for J = 0 to RawN
    Vi = 0
    if J = RawN then
      Vi = 1
    elseif RawBuf[J] = 0 then
      Vi = 1
    end if
    if Vi = 1 then
      Wi = J - Bv + 1
      call asm FN_TX_BYTE with a = Wi
      while Bv < J
        Wi = RawBuf[Bv]
        call asm FN_TX_BYTE with a = Wi
        inc Bv
      end while
      inc Bv
    end if
  next
  call asm FN_TX_BYTE with a = 0
  return
end sub

' 4. the clocks: a RESYNC owed, a credit, the keepalive, HELLO again, a
' silent link given up
sub NetClock:
  if (RHold & 127) <> 0 then
    dec RHold
  elseif (RHold & 128) <> 0 then
    RHold = RESYNC_GAP
    TxF = TxF | TX_RESYNC
  end if
  Vi = Taken - Credited
  if Vi >= 48 then TxF = TxF | TX_CREDIT
  inc Quiet
  if Quiet > DEAD_AFTER then
    NetLost
    return
  end if
  inc QPing
  if QPing = PING_EVERY then
    QPing = 0
    TxF = TxF | TX_CREDIT | TX_PING
  end if
  inc QAsk
  if QAsk >= ASK_AGAIN then
    QAsk = 0
    if (NLink & (NL_JOINED | NL_HEARD)) = NL_JOINED then TxF = TxF | TX_HELLO
  end if
  return
end sub

' ---- the decoder ---------------------------------------------------------------
' Up to DCHUNK of the READ's bytes. The per-byte work - COBS, the two bytes
' held back, the running Fletcher sums, a patch's bytes into ST, a table's
' record into the list - is lib.asm's lib_decode (the asm port's DECODE: in
' Amy it took about 2,200 T a byte; in asm about 1,000: DCHUNK is 24, the
' asm port's, about 24,000 T a frame); it comes back
' here at each frame's end, and FrameEnd does what the frame says.
sub Decode:
  DecN = DLeft
  if DecN > DCHUNK then DecN = DCHUNK
  DLeft = DLeft - DecN
  do
    call asm lib_decode
    if DecEnd = 1 then
      FrameEnd
      if (NEvt & EV_ERROR) <> 0 then
        DLeft = 0
        return
      end if
    end if
  loop while DecN <> 0
  return
end sub

' a frame's end: its sums checked, then what its type does
sub FrameEnd:
  if FIdx = 0 and DN = 0 and DFlag = 0 then
    ' (an empty frame: a lone delimiter; nothing to check)
    return
  end if
  Vi = 0
  if FIdx = 0 then Vi = 1
  if DN <> 2 then Vi = 1
  if DOne <> SumA then Vi = 1
  if DTwo <> SumB then Vi = 1
  if Vi = 1 then
    RHold = RHold | 128
    if NBad < 255 then inc NBad
    FrameReset
    return
  end if
  Quiet = 0
  QPing = 0
  QAsk = 0
  select case FType
    case CS_COMMIT
      if (NLink & NL_JOINED) <> 0 then
        NLink = NLink | NL_HEARD
        NEvt = NEvt | EV_STATE
      end if
    case CS_ERROR
      NErr = QOff
      NEvt = NEvt | EV_ERROR
    case CS_TABLE
      TblN = QOff
      if QLen < MAX_TABLES then TblHave = TblHave | BitTab[QLen]
  end select
  FrameReset
  return
end sub

sub FrameReset:
  DCode = 0
  DFlag = 0
  DN = 0
  FIdx = 0
  SumA = 0
  SumB = 0
  QSt = 0
  return
end sub

' ================================================================ blocking
' (mail.inc MIDLE, MGO) The link's transaction, if one is out, answered
' first: up to 4 s of frames.
sub MbIdle:
  if NKind = 0 then return
  for I = 1 to 240
    call asm mb_poll
    if MbRes <> 0 then exit for
    Frame1
  next
  NKind = 0
  return
end sub

' post, then wait for the answer a frame at a time (the sound running),
' about 21 s at most (an OPEN may dial for seconds). MbOk = 1: ACKed.
sub MbGo:
  call asm mb_post
  MbOk = 0
  for W16 = 1 to 1280
    call asm mb_poll
    if MbRes <> 0 then
      if MbRes = 1 then MbOk = 1
      return
    end if
    Frame1
  next
  return
end sub

' ---- the appkeys (appkey.c; p_boot.inc) ---------------------------------------
' creator 1, app 1: key 0 the player's name, key 0x10 FujiBlast's server
sub AkOpen(u8 Key, u8 Mode):
  MbIdle
  call asm FN_APPKEY_OPEN_BEGIN with b = Key, a = Mode
  MbGo
  return
end sub

sub AkClose:
  call asm FN_BEGIN with d = DEV_FUJI, e = FC_CKEY, b = 0
  MbGo
  return
end sub

' open key Key and read it: Nn = its length (0: none, closed). The data
' stays in the reply window from $F802 until the next transaction: the
' caller closes the key after.
sub AkRead(u8 Key):
  Nn = 0
  AkOpen(Key, 0)
  if MbOk = 0 then
    AkClose
    return
  end if
  call asm FN_BEGIN with d = DEV_FUJI, e = FC_RKEY, b = 0
  MbGo
  if MbOk = 0 or peek($F801) <> 0 then
    AkClose
    return
  end if
  Nn = peek($F800)
  if Nn > 64 then Nn = 64
  if Nn = 0 then AkClose
  return
end sub

' A upper-cased if a letter; 0 if not a letter or a digit
function UpAlnum(u8 Ch) as u8
  if Ch >= 97 and Ch <= 122 then return Ch - 32
  if Ch >= 65 and Ch <= 90 then return Ch
  if Ch >= 48 and Ch <= 57 then return Ch
  return 0

' appkey_load: our name from key 0, the table from key 0x10
sub AkLoad:
  for I = 0 to 8
    MyName[I] = 0
    SrvTbl[I] = 0
  next
  RoomKey = 0
  AkRead(AK_NAME)
  if Nn <> 0 then
    K = 0
    for I = 0 to Nn - 1
      W16 = $F802 + I
      Vi = UpAlnum(peek(W16))
      if Vi <> 0 and K < NAME_LEN then
        MyName[K] = Vi
        inc K
      end if
    next
    AkClose
  end if
  AkRead(AK_ROOM)
  if Nn < 5 then
    if Nn <> 0 then AkClose
    return
  end if
  ' the table: after "table=" (the '=')
  K = 255
  for I = 0 to Nn - 1
    W16 = $F802 + I
    if K = 255 and peek(W16) = 61 then K = I + 1
  next
  if K <> 255 then
    J = 0
    while K < Nn and J < TABLE_LEN
      W16 = $F802 + K
      Vi = UpAlnum(peek(W16))
      if Vi = 0 then exit while
      if Vi >= 65 then Vi = Vi + 32
      SrvTbl[J] = Vi
      inc J
      inc K
    end while
  end if
  if SrvTbl[0] <> 0 then RoomKey = 1
  AkClose
  return
end sub

' appkey_save_name: key 0 = our name
sub AkSaveName:
  AkOpen(AK_NAME, 1)
  if MbOk = 0 then return
  call asm FN_BEGIN with d = DEV_FUJI, e = FC_WKEY, b = 0
  for I = 0 to 7
    Vi = MyName[I]
    if Vi = 0 then exit for
    call asm FN_TX_BYTE with a = Vi
  next
  MbGo
  AkClose
  return
end sub

' appkey_save_room: key 0x10 = the build's server + our table, unless the
' key is ours already
sub AkSaveRoom:
  if RoomKey = 1 then return
  AkOpen(AK_ROOM, 1)
  if MbOk = 0 then return
  call asm FN_BEGIN with d = DEV_FUJI, e = FC_WKEY, b = 0
  W16 = @SDefUrl
  TxStr
  for I = 0 to 7
    Vi = SrvTbl[I]
    if Vi = 0 then exit for
    call asm FN_TX_BYTE with a = Vi
  next
  MbGo
  AkClose
  RoomKey = 1
  return
end sub

' appkey_clear_room: key 0x10 emptied, no table
sub AkClearRoom:
  AkOpen(AK_ROOM, 1)
  if MbOk = 1 then
    call asm FN_BEGIN with d = DEV_FUJI, e = FC_WKEY, b = 0
    MbGo
    AkClose
  end if
  SrvTbl[0] = 0
  RoomKey = 0
  return
end sub

' the zero-ended string at W16 into the TX stream
sub TxStr:
  Vi = peek(W16)
  while Vi <> 0
    call asm FN_TX_BYTE with a = Vi
    inc W16
    Vi = peek(W16)
  end while
  return
end sub

' ---- the socket ----------------------------------------------------------------
' SCLOSE: CLOSE (a NAK is fine: nothing was open), the link down
sub SockClose:
  MbIdle
  call asm FN_BEGIN with d = DEV_NET, e = NC_CLOSE, b = 0
  MbGo
  NLink = 0
  NKind = 0
  return
end sub

' net_close: BYE if at a table (a few frames to get it out), then CLOSE
sub NetClose:
  if (NLink & NL_LINK) <> 0 and (NLink & NL_JOINED) <> 0 then
    TxF = TxF | TX_BYE
    for Ri = 1 to 30
      Frame1
      NetStep
      if TxF = 0 and NKind = 0 then exit for
    next
  end if
  SockClose
  return
end sub

' SOPEN: CLOSE first (a reset leaves the cart's open), then OPEN
' "N:TCP://host:port/" (read and write): from key 0x10 if it is ours, else
' the build's. MbOk = 1: open (NLink).
sub SockOpen:
  SockClose
  if RoomKey = 1 then
    ' the key's URL stays in the reply window until the OPEN is posted: it
    ' is streamed from there (the key closed after, as the asm port does)
    AkRead(AK_ROOM)
    if Nn = 0 then
      MbOk = 0
      return
    end if
    OpenBegin
    SpecFromKey
    MbGo
    Vi = MbOk
    AkClose
    MbOk = Vi
  else
    OpenBegin
    W16 = @SDefSpec
    TxStr
    MbGo
  end if
  if MbOk = 1 then NLink = NL_LINK
  return
end sub

sub OpenBegin:
  call asm FN_BEGIN with d = DEV_NET, e = NC_OPEN, b = 2
  call asm FN_PARAM8 with a = $0C
  call asm FN_PARAM8 with a = 0
  return
end sub

' "N:" + the key's URL (Nn bytes in the reply from $F802) up to its "?" (a
' "/" before it dropped), upper-cased; ":9910" if it has no port; then "/"
sub SpecFromKey:
  Ri = 0
  W16 = $F802
  while Ri < Nn
    Vi = peek(W16)
    if Vi = 0 or Vi = 63 then exit while
    inc Ri
    inc W16
  end while
  if Ri <> 0 then
    W16 = $F801 + Ri
    if peek(W16) = 47 then dec Ri
  end if
  call asm FN_TX_BYTE with a = 78
  call asm FN_TX_BYTE with a = 58
  Ci = 0
  W16 = $F802
  while Ri <> 0
    Vi = peek(W16)
    if Vi = 58 then inc Ci
    if Vi >= 97 and Vi <= 122 then Vi = Vi - 32
    call asm FN_TX_BYTE with a = Vi
    inc W16
    dec Ri
  end while
  if Ci < 2 then
    W16 = @SPort
    TxStr
  end if
  call asm FN_TX_BYTE with a = 47
  return
end sub
' ================================================================ walking
' move.c: the player's own walking, exactly as the server's
' internal/game/move.go (Walker): the server checks it, the bots walk with it.
' The player is a tile-sized box at MvX, MvY (16 units a tile); one of the
' two is always on a lane (a multiple of 16). Pushing into a cross lane from
' up to LANE units off it slides onto it. Every value is a byte and wraps as
' the C's uint8_t does (a column of -1 is 255: out of the arena too).

sub MvReset(u8 Xr, u8 Yr, u8 Dr):
  MvX = Xr
  MvY = Yr
  MvDir = Dr
  MvAcc = 0
  return
end sub

function CentreTile(u8 Xc, u8 Yc) as u8
  Xc = Xc + 8
  Xc = Xc >> 4
  Yc = Yc + 8
  Yc = Yc >> 4
  if Xc >= ARENA_W then Xc = ARENA_W - 1
  if Yc >= ARENA_H then Yc = ARENA_H - 1
  return RowBase[Yc] + Xc

function Walkable(u8 Cw, u8 Rw) as u8
  if Cw >= ARENA_W then return 0
  if Rw >= ARENA_H then return 0
  Cw = RowBase[Rw] + Cw
  if Cw = PendTile then return 0
  Rw = ST[OFF_MAP + Cw]
  if Rw >= T_PILLAR and Rw <= T_DUD then return 0
  return 1

sub Bumped(u8 Cb, u8 Rb):
  if Cb >= ARENA_W then return
  if Rb >= ARENA_H then return
  Cb = RowBase[Rb] + Cb
  Rb = ST[OFF_MAP + Cb]
  if Rb = T_BOMB or Rb = T_DUD then MvBump = Cb
  return
end sub

' one unit toward Du: 1 if it moved
function UnitStep(u8 Du) as u8
  u8 Dx = 0
  u8 Off = 0
  u8 Cu = 0
  u8 Ru = 0
  if Du = DIR_LEFT or Du = DIR_RIGHT then
    Dx = 255
    if Du = DIR_RIGHT then Dx = 1
    Off = MvY & 15
    Cu = MvX >> 4
    Cu = Cu + Dx
    Ru = MvY >> 4
    if Off <> 0 then
      if Off <= LANE then
        if Walkable(Cu, Ru) = 1 then
          dec MvY
          return 1
        end if
      end if
      if Off >= UNIT - LANE then
        Ru = Ru + 1
        if Walkable(Cu, Ru) = 1 then
          inc MvY
          return 1
        end if
      end if
      return 0
    end if
    if (MvX & 15) = 0 then
      if Walkable(Cu, Ru) = 0 then
        Bumped(Cu, Ru)
        return 0
      end if
    end if
    MvX = MvX + Dx
    return 1
  end if
  Dx = 255
  if Du = DIR_DOWN then Dx = 1
  Off = MvX & 15
  Cu = MvX >> 4
  Ru = MvY >> 4
  Ru = Ru + Dx
  if Off <> 0 then
    if Off <= LANE then
      if Walkable(Cu, Ru) = 1 then
        dec MvX
        return 1
      end if
    end if
    if Off >= UNIT - LANE then
      Cu = Cu + 1
      if Walkable(Cu, Ru) = 1 then
        inc MvX
        return 1
      end if
    end if
    return 0
  end if
  if (MvY & 15) = 0 then
    if Walkable(Cu, Ru) = 0 then
      Bumped(Cu, Ru)
      return 0
    end if
  end if
  MvY = MvY + Dx
  return 1

' one jiffy toward Dm (NONE: still) at speed level Lv: 1 if it moved
function MvStep(u8 Dm, u8 Lv) as u8
  u8 Nm = 0
  u8 Mm = 0
  MvBump = NONE
  if Dm = NONE then
    MvAcc = 0
    return 0
  end if
  MvDir = Dm
  Lv = Lv << 2
  Lv = Lv + SPEED_BASE
  MvAcc = MvAcc + Lv
  Nm = MvAcc >> 4
  MvAcc = MvAcc & 15
  while Nm <> 0
    if UnitStep(Dm) = 0 then
      MvAcc = 0
      exit while
    end if
    Mm = 1
    dec Nm
  end while
  return Mm

' play.c try_dirs: the stick to a direction; on a diagonal, the turn first
' (the way we aren't going), and if that's walled, on as we were
function TryDirs(u8 Lt) as u8
  u8 Hd = 255
  u8 Vd = 255
  u8 Ad = 0
  u8 Bd = 0
  u8 Sx = 0
  u8 Sy = 0
  u8 Sa = 0
  if (InDir & IN_UP) <> 0 then
    Vd = DIR_UP
  elseif (InDir & IN_DOWN) <> 0 then
    Vd = DIR_DOWN
  end if
  if (InDir & IN_LEFT) <> 0 then
    Hd = DIR_LEFT
  elseif (InDir & IN_RIGHT) <> 0 then
    Hd = DIR_RIGHT
  end if
  if Hd = NONE then return MvStep(Vd, Lt)
  if Vd = NONE then return MvStep(Hd, Lt)
  Ad = Hd
  if MvDir = DIR_LEFT or MvDir = DIR_RIGHT then Ad = Vd
  Bd = Vd
  if Ad = Vd then Bd = Hd
  Sx = MvX
  Sy = MvY
  Sa = MvAcc
  if MvStep(Ad, Lt) = 1 then return 1
  MvX = Sx
  MvY = Sy
  MvAcc = Sa
  return MvStep(Bd, Lt)
' ================================================================ the arena
' play.c: drawing the state, walking our player, bombs. We walk our own
' player (move.amy) and tell the server where it is; the server has the
' rest. Our bomb shows the moment we drop it (PendTile) until the server's
' state has it. Other players are drawn walking toward where the server
' last said they were.
'
' The screen (arena.inc, moved for 32 columns): row 0 the HUD (each seat's
' three letters and wins in its colour, the clock in the middle); rows 1-22
' the arena, 13 x 11 tiles of 2 x 2 cells from column 3, walled at columns
' 2 and 29; row 23 our stats (icons and digits) and the round.

' the arena's tile Tt changed or must be redrawn: its bit in MapD
sub MarkTile(u8 Tt):
  Wi = Tt >> 3
  MapD[Wi] = MapD[Wi] | BitTab[Tt & 7]
  return
end sub

' a test scene's change of map tile Tt to New, marked as the link marks a
' patched one (lib.asm lib_setmap)
sub SetMap(u8 Tt, u8 New):
  call asm lib_setmap with a = Tt, e = New
  return
end sub

' the tiles a bomb drawn at half-tile Hx, Hy covers: redrawn at the next pass
sub Dirty(u8 Hx, u8 Hy):
  Ci = Hx >> 1
  Ri = Hy >> 1
  MarkTile(RowBase[Ri] + Ci)
  if (Hx & 1) <> 0 and Ci + 1 < ARENA_W then MarkTile(RowBase[Ri] + Ci + 1)
  if (Hy & 1) <> 0 and Ri + 1 < ARENA_H then
    MarkTile(RowBase[Ri + 1] + Ci)
    if (Hx & 1) <> 0 and Ci + 1 < ARENA_W then MarkTile(RowBase[Ri + 1] + Ci + 1)
  end if
  return
end sub

' the marked tiles drawn (from the map, our pending bomb over it), eight a
' pass at most: lib.asm (the rest by the next passes, PlayFrame); then the
' bombs in the air again, over them
sub DrawMarked:
  call asm lib_drawmarked
  if MovOn <> 0 then
    for I = 0 to 3
      if (MovOn & BitTab[I]) <> 0 then
        Ri = MovK[I]
        Wi = MovHY[I]
        Vi = MovHX[I]
        call asm lib_half with a = Ri, d = Wi, e = Vi
      end if
    next
  end if
  return
end sub

' the HUD (play.c hud): each seat's three letters ('-' knocked out) and its
' wins, in its colour; the clock (M:SS, or the countdown's digit)
sub Hud:
  for Si = 0 to 3
    Ci = HudCol[Si]
    Ri = AR_HUD + Si * NHUDGLYPH
    if (ST[OFF_INPLAY] & BitTab[Si]) <> 0 then
      Po = OFF_NAMES + Si * 8
      for J = 0 to 2
        Vi = ST[Po + J]
        if (ST[OFF_ALIVE] & BitTab[Si]) = 0 and ST[OFF_PHASE] = PH_PLAY then Vi = 45
        Buf[J] = Vi
      next
      Po = OFF_PLAYERS + SeatOff[Si]
      Vi = ST[Po + P_WINS]
      while Vi >= 10
        Vi = Vi - 10
      end while
      Buf[3] = 48 + Vi
      Buf[4] = 0
      MsgA = address of Buf
      Nn = 4
      TextN(0, Ci, Ri)
    else
      Buf[0] = 32
      Buf[1] = 32
      Buf[2] = 32
      Buf[3] = 32
      Buf[4] = 0
      MsgA = address of Buf
      Nn = 4
      TextN(0, Ci, Ri)
    end if
  next
  Ti = ST[OFF_TIMER]
  Buf[0] = 32
  Buf[1] = 32
  Buf[2] = 32
  Buf[3] = 32
  if ST[OFF_PHASE] = PH_COUNTDOWN then
    Buf[1] = 48 + Ti % 10
  else
    Buf[0] = 48 + Ti / 60
    Buf[1] = 58
    Ti = Ti % 60
    Buf[2] = 48 + Ti / 10
    Buf[3] = 48 + Ti % 10
  end if
  MsgA = address of Buf
  Nn = 4
  TextN(0, 14, AR_HUD)
  HudTimer = ST[OFF_TIMER]
  HudAlive = ST[OFF_ALIVE]
  for Si = 0 to 3
    Po = OFF_PLAYERS + SeatOff[Si]
    HudWins[Si] = ST[Po + P_WINS]
  next
  return
end sub

' play.c stats_draw: range, bombs, speed (a digit after each icon), kick and
' glove (their icon or a dot)
sub StatsDraw(u8 Force):
  for I = 0 to 4
    Vi = 0
    if MySeat <> NONE then
      Po = OFF_PLAYERS + SeatOff[MySeat]
      Vi = ST[Po + StFld[I]]
      if I = 2 then Vi = Vi + 1
      if I = 3 then Vi = Vi & PF_KICK
      if I = 4 then Vi = Vi & PF_GLOVE
    end if
    if Force = 1 or Vi <> Stats[I] then
      if Force = 0 and Vi > Stats[I] then SndPlay(SndPickup)
      Stats[I] = Vi
      Ci = 4 + I * 4
      if I < 3 then
        PutCell(23, Ci, AR_SMALL + I)
        if Vi > 9 then Vi = 9
        PutCell(23, Ci + 1, AR_HUD + 1 + Vi)
      else
        if Vi <> 0 then
          PutCell(23, Ci, AR_SMALL + I)
        else
          PutCell(23, Ci, AR_SMALL + SM_OFF)
        end if
      end if
    end if
  next
  return
end sub

' play_enter: the arena drawn afresh for this state
sub PlayEnter:
  GfxBegin
  ArenaSet
  for Ri = 1 to 22
    PutCell(Ri, 2, AR_SMALL + SM_WALL)
    PutCell(Ri, 29, AR_SMALL + SM_WALL)
  next
  for J = 0 to 17
    MapD[J] = 255
  next
  MovOn = 0
  for Si = 0 to 3
    DieT[Si] = 0
    Po = OFF_PLAYERS + SeatOff[Si]
    DispX[Si] = ST[Po + P_X]
    DispY[Si] = ST[Po + P_Y]
  next
  PendTile = NONE
  LoopDue = 0
  BeepTimer = ST[OFF_TIMER]
  WasAlive = ST[OFF_ALIVE]
  LastPhase = ST[OFF_PHASE]
  if MySeat <> NONE then
    Po = OFF_PLAYERS + SeatOff[MySeat]
    MyWarp = ST[Po + P_WARP]
    MvReset(ST[Po + P_X], ST[Po + P_Y], DIR_DOWN)
  end if
  StatsDraw(1)
  MFlags = MFlags | MF_MOVERS | MF_MAP
  PlayState
  ' the round
  MsgA = @SRd
  TextAt(23, 24, AR_HUD)
  NumAt(23, 27, ST[OFF_ROUND], AR_HUD)
  Hud
  HudDue = 0
  GfxShow
  if ST[OFF_PHASE] = PH_COUNTDOWN then
    SndMusic(SndMcLead)
  elseif ST[OFF_PHASE] = PH_PLAY then
    SndLoop(1)
  end if
  return
end sub

' play_state: a new state came
sub PlayState:
  ' our own position, when the server says so
  if MySeat <> NONE then
    Po = OFF_PLAYERS + SeatOff[MySeat]
    if ST[Po + P_WARP] <> MyWarp then
      MyWarp = ST[Po + P_WARP]
      MvReset(ST[Po + P_X], ST[Po + P_Y], MvDir)
    end if
  end if
  if PendTile <> NONE then
    if ST[OFF_MAP + PendTile] <> T_FLOOR then PendTile = NONE
  end if
  ' the bombs in the air last time: the tiles under them redrawn (only when
  ' the movers or the map were patched: else they stand as drawn)
  MovNow = MFlags & (MF_MOVERS | MF_MAP)
  if MovNow <> 0 and MovOn <> 0 then
    for I = 0 to 3
      if (MovOn & BitTab[I]) <> 0 then Dirty(MovHX[I], MovHY[I])
    next
    MovOn = 0
  end if
  ' (the marked tiles are drawn by the next pass without a state: a state's
  ' pass has the link's work; the bombs in the air are drawn again after)
  if (MFlags & MF_BOOM) <> 0 then SndPlay(SndBoom)
  if (MFlags & MF_FIZZ) <> 0 then SndPlay(SndFizzle)
  MFlags = 0
  ' the bombs in the air (kicked, thrown): at their half-tile cells
  if MovNow <> 0 then
  for I = 0 to 3
    Po = OFF_MOVERS + I * MOVER_SIZE
    if (ST[Po] & 3) <> 0 then
      Vi = ST[Po + 1] + 4
      Vi = Vi >> 3
      while Vi >= 26
        Vi = Vi - 26
      end while
      if Vi = 25 then Vi = 24
      Wi = ST[Po + 2] + 4
      Wi = Wi >> 3
      while Wi >= 22
        Wi = Wi - 22
      end while
      if Wi = 21 then Wi = 20
      MovHX[I] = Vi
      MovHY[I] = Wi
      Ri = T_BOMB
      if (ST[Po] & M_DUD) <> 0 then Ri = T_DUD
      MovK[I] = Ri
      call asm lib_half with a = Ri, d = Wi, e = Vi
      MovOn = MovOn | BitTab[I]
    end if
  next
  end if
  if WasAlive <> ST[OFF_ALIVE] then
  for Si = 0 to 3
    if (WasAlive & BitTab[Si]) <> 0 and (ST[OFF_ALIVE] & BitTab[Si]) = 0 and ST[OFF_PHASE] = PH_PLAY then
      DieT[Si] = 1
      SndPlay(SndDie)
    end if
  next
  end if
  if ST[OFF_PHASE] = PH_COUNTDOWN and BeepTimer <> ST[OFF_TIMER] then SndPlay(SndBeep)
  BeepTimer = ST[OFF_TIMER]
  if ST[OFF_PHASE] = PH_PLAY and LastPhase = PH_COUNTDOWN then
    SndPlay(SndGo)
    ' (the round's loop starts on the next pass without a state: four OS7
    ' music areas cost about 15,000 T)
    LoopDue = 1
  end if
  LastPhase = ST[OFF_PHASE]
  Vi = 0
  for Si = 0 to 3
    Po = OFF_PLAYERS + SeatOff[Si]
    if HudWins[Si] <> ST[Po + P_WINS] then Vi = 1
  next
  ' (the HUD is drawn by the next pass without a state: a state's pass has
  ' the map to draw)
  if HudTimer <> ST[OFF_TIMER] or HudAlive <> ST[OFF_ALIVE] or Vi = 1 then HudDue = 1
  StateNow = 1
  WasAlive = ST[OFF_ALIVE]
  StatsDraw(0)
  return
end sub

' toward(): from Fa a step to Fb (3 units a jiffy; more than a tile: there)
' (lib.asm lib_toward: it runs for every other seat, twice a jiffy)
function Toward(u8 Fa, u8 Fb) as u8
  call asm lib_toward with b = Fa, c = Fb
  return TwR

' seat Si on the arena at units Vi, Wi, frame Ri
sub SprArena:
  Vi = Vi + 24
  Wi = Wi + 8
  SprAt
  return
end sub

' play_frame: a jiffy
sub PlayFrame:
  Moved = 0
  MeOn = 0
  if MySeat <> NONE and ST[OFF_PHASE] = PH_PLAY then
    if (ST[OFF_ALIVE] & BitTab[MySeat]) <> 0 then MeOn = 1
  end if
  if MeOn = 1 then
    Po = OFF_PLAYERS + SeatOff[MySeat]
    Moved = TryDirs(ST[Po + P_SPEED])
    if MvBump <> NONE and FrameCount - BumpT >= 30 then
      if (ST[Po + P_FLAGS] & PF_KICK) <> 0 or ST[OFF_MAP + MvBump] = T_DUD then
        BumpT = FrameCount
        NetAct(ACT_BUMP, MvBump, MvDir)
        if (ST[Po + P_FLAGS] & PF_KICK) <> 0 then SndPlay(SndKick)
      end if
    end if
    if EvBtn = 1 then
      Ti = CentreTile(MvX, MvY)
      Vi = ST[OFF_MAP + Ti]
      if (ST[Po + P_FLAGS] & PF_GLOVE) <> 0 and (Vi = T_BOMB or Ti = PendTile) then
        NetAct(ACT_THROW, MvDir, 0)
        SndPlay(SndThrow)
        PendTile = NONE
      elseif Vi = T_FLOOR and Ti <> PendTile then
        Wi = ST[Po + P_OUT]
        if PendTile <> NONE then inc Wi
        if Wi < ST[Po + P_BOMBS] then
          NetAct(ACT_DROP, Ti, 0)
          PendTile = Ti
          PendLeft = 90
          MarkTile(Ti)
          DrawMarked
          SndPlay(SndDrop)
        end if
      end if
    end if
    Ri = MvDir
    if Moved = 1 then Ri = Ri | P_DIR_MOVING
    W16 = FrameCount - SentT
    Vi = 0
    if W16 >= 60 then Vi = 1
    if W16 >= MOVE_EVERY then
      if MvX <> SentX or MvY <> SentY or Ri <> SentD then Vi = 1
    end if
    if Vi = 1 then
      SentT = FrameCount
      NetMove(MvX, MvY, Ri)
    end if
  end if
  if PendTile <> NONE and PendLeft <> 0 then
    dec PendLeft
    if PendLeft = 0 then
      ' never came: off again
      MarkTile(PendTile)
      PendTile = NONE
      DrawMarked
    end if
  end if
  WalkF = FrWalk[(lowbyte FrameCount >> 3) & 3]
  for Si = 0 to 3
    if (ST[OFF_INPLAY] & BitTab[Si]) = 0 then
      SprHide
    elseif (ST[OFF_ALIVE] & BitTab[Si]) = 0 then
      if DieT[Si] <> 0 and DieT[Si] < 48 then
        Vi = DispX[Si]
        Wi = DispY[Si]
        Ri = FR_DIE0 + DieT[Si] / 12
        SprArena
        inc DieT[Si]
      else
        SprHide
      end if
    elseif Si = MySeat and MeOn = 1 then
      DispX[Si] = MvX
      DispY[Si] = MvY
      Vi = MvX
      Wi = MvY
      Ri = FrBase[MvDir & 3]
      if Moved = 1 then Ri = Ri + WalkF
      SprArena
    else
      Po = OFF_PLAYERS + SeatOff[Si]
      DispX[Si] = Toward(DispX[Si], ST[Po + P_X])
      DispY[Si] = Toward(DispY[Si], ST[Po + P_Y])
      Vi = DispX[Si]
      Wi = DispY[Si]
      Ri = FrBase[ST[Po + P_DIR] & 3]
      if (ST[Po + P_DIR] & P_DIR_MOVING) <> 0 then Ri = Ri + WalkF
      SprArena
    end if
  next
  call asm lib_sprflush
  if StateNow = 0 then
    ' a pass without a state: the rest of a big redraw, then the HUD
    call asm lib_marked with a = 0
    asm {
      ld (amy(MoreTiles)),a
    }
    if MoreTiles = 1 then
      DrawMarked
    elseif LoopDue = 1 then
      LoopDue = 0
      SndLoop(1)
    elseif HudDue = 1 then
      HudDue = 0
      Hud
    end if
  end if
  StateNow = 0
  return
end sub
' ================================================================ the menus
' menus.c: the screens before a table: the title, the name, the rooms; and
' screens.c message. Text from the C client, fitted to 32 columns and the
' safe area (columns 2-29, rows 1-22).

' message: two lines (MsgA, MsgB), then Mf frames, or FIRE (Mf = 0)
sub Message(u8 Mf):
  GfxBegin
  MenuSet
  CentreAt(10, STY_Y)
  MsgA = MsgB
  CentreAt(13, STY_W)
  if Mf = 0 then
    MsgA = @SPress
    CentreAt(18, STY_W)
  end if
  GfxShow
  do
    Tick
    if Mf <> 0 then
      dec Mf
      if Mf = 0 then return
    elseif EvBtn = 1 then
      return
    end if
  loop
end sub

' title: the logo, four bombers walking along a line, FIRE to go on
sub TitleScreen:
  u16 Tt = 0
  GfxBegin
  MenuSet
  ' FUJIBLAST: 9 big letters of 2 x 2 cells, rows 3-4, from column 7
  for I = 0 to 8
    Ci = 7 + I * 2
    Vi = MENU_LOGO + I * 4
    PutCell(3, Ci, Vi)
    PutCell(3, Ci + 1, Vi + 1)
    PutCell(4, Ci, Vi + 2)
    PutCell(4, Ci + 1, Vi + 3)
  next
  MsgA = @SForFn
  CentreAt(8, STY_Y)
  MsgA = @STag
  CentreAt(15, STY_W)
  MsgA = @SCred1
  CentreAt(20, STY_C)
  MsgA = @SCred2
  CentreAt(21, STY_C)
  GfxShow
  SndMusic(SndMtLead)
  do
    Tick
    inc Tt
    ' four bombers along one line (four sprites: the most a line shows)
    for Si = 0 to 3
      W16 = Tt >> 1
      W16 = W16 + Si * 48
      W16 = W16 % 216
      Vi = lowbyte W16 + 16
      Wi = 96
      Ri = FR_RIGHT0
      if (lowbyte Tt & 8) <> 0 then Ri = FR_RIGHT0 + (Si & 1) + 1
      SprAt
    next
    call asm lib_sprflush
    ' PRESS FIRE blinks, under 2 Hz
    if (lowbyte Tt & 31) = 0 then
      MsgA = @SPress
      CentreAt(18, STY_W)
    elseif (lowbyte Tt & 31) = 16 then
      MsgA = @SBlank10
      CentreAt(18, STY_W)
    end if
    if EvBtn = 1 then exit do
  loop
  SndStop
  HideAll
  return
end sub

' name_entry, PLAT_NAME_WHEEL: no keyboard: the stick up and down turns a
' wheel (letters, digits, then the end '>'), fire or right takes the one at
' the cursor, left backs up. (Held up or down repeats.)
sub NameEntry:
  u8 Wh = 0
  u8 Nl = 0
  GfxBegin
  MenuSet
  MsgA = @SYName
  CentreAt(6, STY_Y)
  MsgA = @SNH1
  CentreAt(14, STY_W)
  MsgA = @SNH2
  CentreAt(16, STY_W)
  MsgA = @SNH3
  CentreAt(18, STY_W)
  MsgA = @SNH4
  CentreAt(20, STY_W)
  GfxShow
  for I = 0 to 8
    MyName[I] = 0
  next
  do
    ' the name in white, the wheel's letter in yellow at the cursor
    ClearRow(10)
    MsgA = address of MyName
    Nn = 8
    TextN(10, 12, STY_W)
    if Nl < NAME_LEN then
      Buf[0] = SWheel[Wh]
      Buf[1] = 0
      MsgA = address of Buf
      TextAt(10, 12 + Nl, STY_Y)
    end if
    PrevDir = InDir
    Tick
    Vi = 0
    if Pressed(IN_UP) = 1 then Vi = 1
    if Pressed(IN_DOWN) = 1 then Vi = 2
    if (InDir & (IN_UP | IN_DOWN)) <> 0 and Vi = 0 then
      inc RepT
      if RepT >= 16 then
        RepT = 12
        if (InDir & IN_UP) <> 0 then Vi = 1
        if (InDir & IN_DOWN) <> 0 then Vi = 2
      end if
    else
      RepT = 0
    end if
    if Vi = 1 then
      if Wh = 0 then
        Wh = 36
      else
        dec Wh
      end if
    elseif Vi = 2 then
      if Wh < 36 then
        inc Wh
      else
        Wh = 0
      end if
    end if
    if Pressed(IN_LEFT) = 1 and Nl <> 0 then
      dec Nl
      MyName[Nl] = 0
    end if
    if EvBtn = 1 or Pressed(IN_RIGHT) = 1 then
      if Wh = 36 then
        if Nl >= 2 then exit do
      elseif Nl < NAME_LEN then
        MyName[Nl] = SWheel[Wh]
        inc Nl
        MyName[Nl] = 0
        SndPlay(SndSelect)
      end if
    end if
  loop
  return
end sub

' net_tables: the room list (blocking), asked again until it comes: Nn =
' the count (0: none, or no answer)
sub NetTables:
  u16 Tw = 0
  Nn = 0
  TblN = 255
  TblHave = 0
  for Tw = 0 to 599
    if TblN = 255 and Tw % ASK_AGAIN = 0 then TxF = TxF | TX_TABLES
    Frame1
    NetStep
    if (NEvt & EV_LOST) <> 0 then return
    if TblN <> 255 then
      Vi = 0
      if TblN <> 0 then
        for J = 0 to TblN - 1
          Vi = Vi | BitTab[J]
        next
      end if
      if (TblHave & Vi) = Vi then
        Nn = TblN
        return
      end if
    end if
  next
  return
end sub

' table_list: 1 (Nn) when SrvTbl was picked
sub TableList:
  u8 Tn = 0
  MsgA = @SConn
  MsgB = @SNone
  Message(1)
  SockOpen
  if MbOk = 0 then
    NoAnswer
    Nn = 0
    return
  end if
  NetInit
  NetTables
  Tn = Nn
  if Tn = 0 then
    SockClose
    NoAnswer
    Nn = 0
    return
  end if
  GfxBegin
  MenuSet
  MsgA = @SPick
  CentreAt(1, STY_Y)
  for I = 0 to Tn - 1
    ' a record: 0-7 its id, 8-19 its name, 20 seated, 21 seats, 22 phase
    Po = I * TABLE_REC
    MsgA = address of ST
    MsgA = MsgA + Po + 8
    Nn = 12
    TextN(5 + I * 2, 4, STY_W)
    Buf[0] = 48 + ST[Po + 20]
    Buf[1] = 47
    Buf[2] = 48 + ST[Po + 21]
    Buf[3] = 0
    MsgA = address of Buf
    TextAt(5 + I * 2, 17, STY_W)
    MsgA = @SWaiting
    if ST[Po + 22] <> 0 then MsgA = @SPlaying
    TextAt(5 + I * 2, 21, STY_W)
  next
  MsgA = @SChoose
  CentreAt(22, STY_W)
  GfxShow
  Sel = 0
  do
    for I = 0 to Tn - 1
      Vi = 0
      if I = Sel then Vi = 62
      Buf[0] = Vi
      MsgA = address of Buf
      Nn = 1
      TextN(5 + I * 2, 2, STY_Y)
    next
    PrevDir = InDir
    Tick
    NetStep
    if Pressed(IN_UP) = 1 and Sel <> 0 then
      dec Sel
      SndPlay(SndSelect)
    end if
    if Pressed(IN_DOWN) = 1 and Sel + 1 < Tn then
      inc Sel
      SndPlay(SndSelect)
    end if
    if EvBtn = 1 then exit do
  loop
  Po = Sel * TABLE_REC
  for I = 0 to 7
    SrvTbl[I] = ST[Po + I]
  next
  SrvTbl[8] = 0
  Nn = 1
  return
end sub

sub NoAnswer:
  MsgA = @SNoAns
  MsgB = @SFromSrv
  Message(0)
  return
end sub
' ================================================================ at a table
' screens.c: the waiting room and the trophies after a round and a game.

' ---- the waiting room ----------------------------------------------------------
' seats at rows 4, 8, 12, 16: a bomber in the seat's colour, its name in it
sub WaitEnter:
  SndLoop(0)
  GfxBegin
  MenuSet
  WsCount = 255
  WaitState
  call asm lib_sprflush
  GfxShow
  return
end sub

' a new state in the waiting room: what changed redrawn (a state that
' changes nothing here costs nothing)
sub WaitState:
  u8 Np = 0
  u8 Hs = 0
  u8 Sum = 0
  Hs = ST[OFF_HOST]
  for I = 0 to 31
    Sum = Sum + ST[OFF_NAMES + I]
  next
  if WsCount = 255 then
    ClearRow(1)
    for I = 0 to 4
      Buf[I] = peek(@SRoom + I)
    next
    for I = 0 to 7
      Buf[5 + I] = SrvTbl[I]
    next
    Buf[13] = 0
    MsgA = address of Buf
    CentreAt(1, STY_Y)
    MsgA = @SRounds
    TextAt(18, 6, STY_W)
    MsgA = @SKeys
    CentreAt(22, STY_W)
  end if
  if WsCount = 255 or WsSeated <> ST[OFF_SEATED] or WsHost <> Hs or WsNames <> Sum then
    for Si = 0 to 3
      Ri = 4 + Si * 4
      ClearRow(Ri)
      if (ST[OFF_SEATED] & BitTab[Si]) <> 0 then
        MsgA = address of ST
        MsgA = MsgA + OFF_NAMES + Si * 8
        Nn = 8
        TextN(Ri, 6, SeatMenuStyle[Si])
        if Si = Hs then
          MsgA = @SHost
          TextAt(Ri, 18, STY_Y)
        end if
        Vi = 24
        Wi = Ri * 8 - 4
        Ri = FR_DOWN0
        SprAt
      else
        MsgA = @SDashes
        TextAt(Ri, 6, STY_W)
        SprHide
      end if
    next
    call asm lib_sprflush
  end if
  for Si = 0 to 3
    if (ST[OFF_SEATED] & BitTab[Si]) <> 0 then inc Np
  next
  if WsCount = 255 or WsRounds <> ST[OFF_ROUNDS] or WsHost <> Hs or WsSeat <> MySeat then
    Buf[0] = 32
    Buf[1] = 32
    Buf[2] = 0
    MsgA = address of Buf
    TextAt(18, 14, STY_Y)
    NumAt(18, 14, ST[OFF_ROUNDS], STY_Y)
    if MySeat <> NONE and MySeat = Hs then
      MsgA = @SHintLR
    else
      MsgA = @SBlank10
    end if
    TextAt(18, 17, STY_W)
  end if
  if WsCount = 255 or WsCount <> Np or WsHost <> Hs or WsSeat <> MySeat then
    ClearRow(20)
    if MySeat = NONE then
      MsgA = @SWatch
      CentreAt(20, STY_W)
    elseif MySeat <> Hs then
      MsgA = @SWaitHost
      CentreAt(20, STY_W)
    elseif Np < 2 then
      MsgA = @SWaitPl
      CentreAt(20, STY_W)
    else
      MsgA = @SPressStart
      CentreAt(20, STY_Y)
    end if
  end if
  WsSeated = ST[OFF_SEATED]
  WsHost = Hs
  WsNames = Sum
  WsRounds = ST[OFF_ROUNDS]
  WsSeat = MySeat
  WsCount = Np
  return
end sub

sub WaitFrame:
  Vi = ST[OFF_ROUNDS]
  if MySeat <> NONE and MySeat = ST[OFF_HOST] then
    if Pressed(IN_LEFT) = 1 and Vi > 1 then NetAct(ACT_ROUNDS, Vi - 1, 0)
    if Pressed(IN_RIGHT) = 1 and Vi < MAX_ROUNDS then NetAct(ACT_ROUNDS, Vi + 1, 0)
    if EvBtn = 1 then NetAct(ACT_START, 0, 0)
  end if
  PrevDir = InDir
  return
end sub

' ---- trophies ------------------------------------------------------------------
sub ResultsEnter(u8 Final):
  u8 Kk = 0
  u8 Rr = 0
  SndLoop(0)
  ResFinal = Final
  ResSeat = ST[OFF_RESULT]
  ResTimer = NONE
  GfxBegin
  MenuSet
  ' the headline: the winner's name in its colour, or no winner, or a draw
  if ResSeat < SEATS then
    for I = 0 to 7
      Buf[I] = ST[OFF_NAMES + ResSeat * 8 + I]
    next
    J = 0
    while J < 8 and Buf[J] <> 0
      inc J
    end while
    MsgA = @SWins
    if Final = 1 then MsgA = @SWinsF
    for I = 0 to 6
      Buf[J + I] = peek(MsgA + I)
    next
    MsgA = address of Buf
    CentreAt(1, SeatMenuStyle[ResSeat])
  else
    MsgA = @SDraw
    if Final = 1 then MsgA = @SNoWinner
    CentreAt(1, STY_Y)
  end if
  if Final = 0 then
    if ST[OFF_SUDDEN] <> 0 then
      MsgA = @SSudden
      CentreAt(2, STY_W)
    else
      MsgA = @SRound
      TextAt(2, 12, STY_W)
      NumAt(2, 18, ST[OFF_ROUND], STY_W)
    end if
  end if
  for Si = 0 to 3
    ResRow[Si] = 0
    if (ST[OFF_SEATED] & BitTab[Si]) = 0 then
      SprHide
    else
      Rr = 4 + Kk * 5
      ResRow[Si] = Rr
      inc Kk
      MsgA = address of ST
      MsgA = MsgA + OFF_NAMES + Si * 8
      Nn = 8
      TextN(Rr, 6, SeatMenuStyle[Si])
      Po = OFF_PLAYERS + SeatOff[Si]
      Wi = ST[Po + P_WINS]
      NumAt(Rr, 15, Wi, STY_Y)
      if Wi > 15 then Wi = 15
      if Wi <> 0 then
        for J = 1 to Wi
          PutCell(Rr + 1, 5 + J, MENU_CUP)
        next
      end if
      Vi = 24
      Wi = Rr * 8 - 4
      Ri = FR_DOWN0
      SprAt
    end if
  next
  if Final = 1 and ResSeat < SEATS then
    Si = ResSeat
    Vi = 200
    Wi = 96
    Ri = FR_WIN0
    SprAt
  end if
  call asm lib_sprflush
  GfxShow
  if Final = 1 then
    SndMusic(SndMgLead)
  elseif ResSeat < SEATS then
    SndMusic(SndMwLead)
  end if
  return
end sub

sub ResultsFrame:
  if ResSeat < SEATS then
    Si = ResSeat
    Ri = FR_WIN0
    if (lowbyte FrameCount & 16) <> 0 then Ri = FR_WIN1
    if ResFinal = 1 then
      Vi = 200
      Wi = 96
      SprAt
    elseif ResRow[Si] <> 0 then
      Vi = 24
      Wi = ResRow[Si] * 8 - 4
      SprAt
    end if
    call asm lib_sprflush
  end if
  if ST[OFF_TIMER] <> ResTimer then
    ResTimer = ST[OFF_TIMER]
    ClearRow(22)
    MsgA = @SNextIn
    if ResFinal = 1 then MsgA = @SBackIn
    TextAt(22, 4, STY_W)
    J = 0
    while peek(MsgA + J) <> 0
      inc J
    end while
    NumAt(22, 4 + J, ResTimer, STY_Y)
  end if
  return
end sub
' ================================================================ test scenes
' test.c: offline test scenes for the emulator rigs: the screens on canned
' states, no network. At start-up we mark TestHook[1] $C3 and wait a third
' of a second for a rig to poke $5A into TestHook[0], the scene into [2] and
' its argument into [3]:
'   1  the arena, seat 0 walking (the stick), [3] its powers (b0 kick,
'      b1 glove, b4-7 speed)
'   2  the waiting room       3  a round's end       4  the game's end
'   5  four walking, for timing ([3] b0: sound always playing)
' An explosion goes off in the arena every 4 seconds (5: two rows, every
' second). A build can also bake a scene in (TEST_SCENE: define SCENE1..5).

sub TestCheck:
  TestHook[1] = $C3
if defined SCENE1
  TestHook[0] = $5A
  TestHook[2] = 1
end defined
if defined SCENE2
  TestHook[0] = $5A
  TestHook[2] = 2
end defined
if defined SCENE3
  TestHook[0] = $5A
  TestHook[2] = 3
end defined
if defined SCENE4
  TestHook[0] = $5A
  TestHook[2] = 4
end defined
if defined SCENE5
  TestHook[0] = $5A
  TestHook[2] = 5
end defined
  for I = 1 to 20
    if TestHook[0] = $5A then exit for
    Frame1
  next
  if TestHook[0] <> $5A then return
  TestHook[0] = $A5
  Canned
  for I = 0 to 3
    MyName[I] = peek(@STestName + I)
  next
  for I = 0 to 6
    SrvTbl[I] = peek(@STestTable + I)
  next
  TestOn = TestHook[2]
  NLink = NL_JOINED | NL_HEARD
  select case TestOn
    case 5
      Walkers
    case 1
      ArenaScene
    case 2
      ST[OFF_PHASE] = PH_WAIT
      MySeat = 0
      Shown = S_WAIT
      WaitEnter
    case 3
      ST[OFF_PHASE] = PH_ROUNDEND
      ST[OFF_TIMER] = 5
      Shown = S_ROUND
      ResultsEnter(0)
    case 4
      ST[OFF_PHASE] = PH_GAMEOVER
      ST[OFF_TIMER] = 5
      Shown = S_GAME
      ResultsEnter(1)
  end select
  do
    Tick
    TableFrame
  loop
end sub

' the canned state: a round in play, four seats, one of everything
sub Canned:
  for I = 0 to STATE_SIZE - 1
    ST[I] = 0
  next
  ST[OFF_PHASE] = PH_PLAY
  ST[OFF_ROUND] = 2
  ST[OFF_ROUNDS] = 5
  ST[OFF_TIMER] = 154
  ST[OFF_SEATED] = $0F
  ST[OFF_INPLAY] = $0F
  ST[OFF_ALIVE] = $07
  ST[OFF_CONN] = $0F
  ST[OFF_HOST] = 0
  ST[OFF_RESULT] = 2
  ST[OFF_SEQ] = 1
  for Si = 0 to 3
    for J = 0 to 7
      ST[OFF_NAMES + Si * 8 + J] = peek(@SCanNames + Si * 8 + J)
    next
    Po = OFF_PLAYERS + SeatOff[Si]
    ST[Po + P_X] = SCorner[Si * 2]
    ST[Po + P_Y] = SCorner[Si * 2 + 1]
    ST[Po + P_DIR] = DIR_DOWN
    ST[Po + P_RANGE] = 2
    ST[Po + P_BOMBS] = 1
    ST[Po + P_WINS] = Si
  next
  Ti = 0
  for Ri = 0 to ARENA_H - 1
    for Ci = 0 to ARENA_W - 1
      if (Ci & 1) <> 0 and (Ri & 1) <> 0 then
        ST[OFF_MAP + Ti] = T_PILLAR
      elseif Ci > 2 and Ci < 10 and (Ri = 0 or Ri = 10 or Ci = 4 or Ci = 8) then
        ST[OFF_MAP + Ti] = T_BLOCK
      end if
      inc Ti
    next
  next
  ' one of everything, in the open middle
  ST[OFF_MAP + 26] = T_BOMB
  ST[OFF_MAP + 52] = T_DUD
  ST[OFF_MAP + 38] = T_FIRE
  ST[OFF_MAP + 64] = T_BOMBUP
  ST[OFF_MAP + 90] = T_SPEED
  ST[OFF_MAP + 116] = T_KICK
  ST[OFF_MAP + 78] = T_GLOVE
  ST[OFF_MAP + 104] = T_BURN
  ST[OFF_MAP + 71] = T_FLAME_C
  ST[OFF_MAP + 70] = T_FLAME_H
  ST[OFF_MAP + 69] = T_BLOCK
  ST[OFF_MAP + 72] = T_FLAME_H
  ST[OFF_MAP + 73] = T_FLAME_R
  ST[OFF_MAP + 58] = T_FLAME_V
  ST[OFF_MAP + 45] = T_FLAME_U
  ST[OFF_MAP + 84] = T_FLAME_D
  ST[OFF_MOVERS] = M_SLIDE
  ST[OFF_MOVERS + 1] = 2 * UNIT + 8
  ST[OFF_MOVERS + 2] = 2 * UNIT
  return
end sub

' scene 1: seat 0 walks by the stick; a blast in the top lane every 4 s
sub ArenaScene:
  u8 Ta = 0
  u8 Tb = 0
  MySeat = 0
  Shown = S_ARENA
  ST[OFF_PLAYERS + P_FLAGS] = TestHook[3] & (PF_KICK | PF_GLOVE)
  ST[OFF_PLAYERS + P_SPEED] = TestHook[3] >> 4
  PlayEnter
  do
    Tick
    inc Ta
    if Ta = 240 then
      Ta = 0
      Tb = 1 - Tb
      for Ti = 2 to 10
        if Tb = 1 then
          SetMap(Ti, T_FLAME_H)
        elseif Ti = 2 or Ti = 10 then
          SetMap(Ti, T_FLOOR)
        else
          SetMap(Ti, T_BLOCK)
        end if
      next
      ST[OFF_TIMER] = ST[OFF_TIMER] - 1
      PlayState
    end if
    PlayFrame
  loop
end sub

' scene 5: seat 0 walks the left lane by itself, seats 1-3 go back and
' forth on theirs (the bottom row, the right lane, row 2), and two rows
' blow up and clear every second: a busy four-player round
sub Walkers:
  u8 Tw = 0
  u8 Pw = 0
  u8 Back = 0
  u8 OnW = 0
  u8 Sn = 0
  for I = 0 to ARENA_H - 1
    ST[OFF_MAP + RowBase[I]] = T_FLOOR
    ST[OFF_MAP + RowBase[I] + ARENA_W - 1] = T_FLOOR
  next
  for I = 0 to ARENA_W - 1
    ST[OFF_MAP + 130 + I] = T_FLOOR
    ST[OFF_MAP + 26 + I] = T_FLOOR
  next
  ST[OFF_ALIVE] = $0F
  MySeat = 0
  Shown = S_ARENA
  PlayEnter
  do
    if MvY = 0 then HookDir = IN_DOWN
    if MvY >= MAX_Y then HookDir = IN_UP
    Tick
    if Back = 0 then
      inc Pw
    else
      dec Pw
    end if
    if Pw = 160 or Pw = 0 then Back = 1 - Back
    if (TestHook[3] & 1) <> 0 and Tw % 20 = 0 then
      if Sn = 0 then
        SndPlay(SndBoom)
      elseif Sn = 1 then
        SndPlay(SndDrop)
      else
        SndPlay(SndKick)
      end if
      inc Sn
      if Sn = 3 then Sn = 0
    end if
    ' x falls, y rises, x rises
    Vi = DIR_LEFT
    if Back = 1 then Vi = (Vi + 2) & 3
    ST[OFF_PLAYERS + 10 + P_X] = MAX_X - Pw
    ST[OFF_PLAYERS + 10 + P_Y] = MAX_Y
    ST[OFF_PLAYERS + 10 + P_DIR] = Vi | P_DIR_MOVING
    Vi = DIR_DOWN
    if Back = 1 then Vi = (Vi + 2) & 3
    ST[OFF_PLAYERS + 20 + P_X] = MAX_X
    ST[OFF_PLAYERS + 20 + P_Y] = Pw
    ST[OFF_PLAYERS + 20 + P_DIR] = Vi | P_DIR_MOVING
    Vi = DIR_RIGHT
    if Back = 1 then Vi = (Vi + 2) & 3
    ST[OFF_PLAYERS + 30 + P_X] = Pw
    ST[OFF_PLAYERS + 30 + P_Y] = 2 * UNIT
    ST[OFF_PLAYERS + 30 + P_DIR] = Vi | P_DIR_MOVING
    inc Tw
    if Tw = 60 then
      Tw = 0
      OnW = 1 - OnW
      for Ti = 1 to ARENA_W - 2
        Vi = T_FLAME_H
        Wi = T_FLAME_H
        if OnW = 0 then
          Vi = T_FLOOR
          if Ti > 2 and Ti < 10 then Vi = T_BLOCK
          Wi = T_FLOOR
          if Ti = 4 or Ti = 8 then Wi = T_BLOCK
        end if
        call asm lib_setmap with a = Ti, e = Vi
        Ri = 104 + Ti
        call asm lib_setmap with a = Ri, e = Wi
      next
      PlayState
    end if
    PlayFrame
  loop
end sub

' the mailbox primitives (Amy Studio r12.12)
include "include/fujinet_mailbox.inc"

