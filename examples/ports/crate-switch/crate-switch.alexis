cartridge "CRATE SWITCH/AMY STUDIO/2026"
u8 Px = 0
u8 Py = 0
u8 Cx = 0
u8 Cy = 0
u8 Nx = 0
u8 Ny = 0
u8 Bx = 0
u8 By = 0
u8 Won = 0
text screen
load default ascii
print at 10,3, "CRATE SWITCH"
print at 7,14, "PUSH CRATE TO +"
print at 7,16, "EITHER FIRE: RESET"
ResetRoom
screen on
nmi on
while 1 = 1
  wait 1 frame
  if joypad(1).fire.pressed then ResetRoom
  if Won = 0 then
    Nx = Px
    Ny = Py
    select case 1
      case joypad(1).left.pressed
        dec Nx
      case joypad(1).right.pressed
        inc Nx
      case joypad(1).up.pressed
        dec Ny
      case joypad(1).down.pressed
        inc Ny
    end select
    if Nx <> Px or Ny <> Py then MovePlayer
  end if
end while

sub ResetRoom:
  Px = 13
  Py = 11
  Cx = 13
  Cy = 10
  Won = 0
  DrawRoom
  return
end sub

sub MovePlayer:
  if Nx < 11 or Nx > 15 or Ny < 9 or Ny > 11 then return
  if Nx = Cx and Ny = Cy then
    Bx = Cx + Nx - Px
    By = Cy + Ny - Py
    if Bx < 11 or Bx > 15 or By < 9 or By > 11 then return
    Cx = Bx
    Cy = By
  end if
  Px = Nx
  Py = Ny
  if Cx = 11 and Cy = 9 then Won = 1
  DrawRoom
  return
end sub

sub DrawRoom:
  print at 10,8, "#######"
  print at 10,9, "#+    #"
  print at 10,10, "#     #"
  print at 10,11, "#     #"
  print at 10,12, "#######"
  put char 36 at Cx,Cy
  put char 64 at Px,Py
  if Won = 1 then
    print at 10,18, "SWITCH ON!"
  else
    print at 10,18, "          "
  end if
  return
end sub
